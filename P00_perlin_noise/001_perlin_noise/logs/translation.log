+    310:     } else {
+    311:         // %f style: we need 9 significant digits total
+    312:         let decimal_places = if exp >= 0 { 9 - 1 - exp } else { 9 - 1 + (-exp) };
+    313:         let decimal_places = decimal_places.max(0) as usize;
+    314:         let s = format!("{:.prec$}", val, prec = decimal_places);
+    315:         // Strip trailing zeros after decimal point
+    316:         if s.contains('.') {
+    317:             let trimmed = s.trim_end_matches('0').trim_end_matches('.');
+    318:             trimmed.to_string()
+    319:         } else {
+    320:             s
+    321:         }
+    322:     }
+    323: }
