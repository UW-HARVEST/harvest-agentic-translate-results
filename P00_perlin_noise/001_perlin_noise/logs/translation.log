+    280: fn format_g9(val: f64) -> String {
+    281:     // %.9g: up to 9 significant digits, use exponential if exponent < -4 or >= 9
+    282:     if val.is_nan() {
+    283:         return "nan".to_string();
+    284:     }
+    285:     if val.is_infinite() {
+    286:         return if val < 0.0 { "-inf".to_string() } else { "inf".to_string() };
+    287:     }
+    288:     if val == 0.0 {
+    289:         // Distinguish -0 vs +0 for sign
+    290:         if val.is_sign_negative() {
+    291:             return "-0".to_string();
+    292:         }
+    293:         return "0".to_string();
+    294:     }
+    295: 
+    296:     let abs_val = val.abs();
+    297:     let exp = abs_val.log10().floor() as i32;
+    298: 
+    299:     // %g uses exponential notation if exponent < -4 or >= precision(9)
+    300:     if exp < -4 || exp >= 9 {
+    301:         // %e style with 8 decimal places (precision-1), then strip trailing zeros
+    302:         let s = format!("{:.8e}", val);
+    303:         // Rust formats exponent as e0, e1, e-1 etc. C uses e+00, e-01 etc.
+    304:         // We need to reformat to match C's output
