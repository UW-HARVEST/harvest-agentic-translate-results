import re

with open('c_src/src/lib.c') as f:
    content = f.read()

# Extract tables
def extract_vals(pattern):
    m = re.search(pattern, content)
    return [v.strip() for v in m.group(1).split(',') if v.strip()]

mantissa = extract_vals(r'm__mantissa\[2048\]\s*=\s*\{([^}]+)\}')
offset = extract_vals(r'm__offset\[64\]\s*=\s*\{([^}]+)\}')
exponent = extract_vals(r'm__exponent\[64\]\s*=\s*\{([^}]+)\}')

def fmt_table(vals, per_line):
    lines = []
    for i in range(0, len(vals), per_line):
        chunk = vals[i:i+per_line]
        lines.append('    ' + ', '.join(chunk) + ',')
    return '\n'.join(lines)

out = '''static M_MANTISSA: [u32; 2048] = [
''' + fmt_table(mantissa, 6) + '''
];

static M_OFFSET: [u16; 64] = [
''' + fmt_table(offset, 8) + '''
];

static M_EXPONENT: [u32; 64] = [
''' + fmt_table(exponent, 6) + '''
];

#[unsafe(no_mangle)]
pub extern \"C\" fn half2float(h: u16) -> f32 {
    let n = (h >> 10) as usize;
    let idx = ((h & 0x3ff) + M_OFFSET[n]) as usize;
    let num = M_MANTISSA[idx].wrapping_add(M_EXPONENT[n]);
    f32::from_bits(num)
}
'''

with open('src/lib.rs', 'w') as f:
    f.write(out)

print('wrote src/lib.rs')
"
