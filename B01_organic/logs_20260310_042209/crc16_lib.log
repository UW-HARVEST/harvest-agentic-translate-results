# Extract the table data from the C header and convert to Rust
python3 -c "
import re

with open('c_src/include/lib.h') as f:
    content = f.read()

# Find the table data
match = re.search(r'static const tflac_u16 tflac_crc16_tables\[8\]\[256\] = \{(.*?)\};', content, re.DOTALL)
table_block = match.group(1)

# Extract each sub-table
tables = re.findall(r'\{([^}]+)\}', table_block)

lines = ['static TFLAC_CRC16_TABLES: [[TflacU16; 256]; 8] = [']
for t in tables:
    vals = [v.strip() for v in t.split(',') if v.strip()]
    lines.append('    [')
    for i in range(0, len(vals), 8):
        chunk = ', '.join(f'{v}' for v in vals[i:i+8])
        lines.append(f'        {chunk},')
    lines.append('    ],')
lines.append('];')

with open('src/table_data.txt', 'w') as f:
    f.write('\n'.join(lines))
print(f'Extracted {len(tables)} tables')
