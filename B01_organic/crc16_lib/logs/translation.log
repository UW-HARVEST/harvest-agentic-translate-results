python3 -c "
import re

# Read the C header to extract the table
with open('c_src/include/lib.h') as f:
    content = f.read()

# Extract all hex values from the table
hex_vals = re.findall(r'0x[0-9a-fA-F]+', content)
# Skip the typedefs (first few 0x... might be in types, but actually there are none in typedefs)
# The table values start after 'tflac_crc16_tables[8][256] = {'
table_start = content.index('tflac_crc16_tables[8][256] = {')
table_end = content.index('};', table_start)
table_text = content[table_start:table_end]
hex_vals = re.findall(r'0x[0-9a-fA-F]+', table_text)

# Should be 8*256 = 2048 values
assert len(hex_vals) == 2048, f'Expected 2048 values, got {len(hex_vals)}'

# Build the Rust file
lines = []
lines.append('#![allow(clippy::identity_op)]')
lines.append('')
lines.append('static TFLAC_CRC16_TABLES: [[u16; 256]; 8] = [')
for i in range(8):
    lines.append('    [')
    for row_start in range(0, 256, 8):
        vals = hex_vals[i*256 + row_start : i*256 + row_start + 8]
        line = '        ' + ', '.join(vals) + ','
        lines.append(line)
    lines.append('    ],')
lines.append('];')
lines.append('')
lines.append('#[unsafe(no_mangle)]')
lines.append('pub extern \"C\" fn crc16(d: *const u8, len: u32, crc: u16) -> u16 {')
lines.append('    let mut crc = crc;')
lines.append('    let mut d = d;')
lines.append('    let mut len = len;')
lines.append('    unsafe {')
lines.append('        while len >= 8 {')
lines.append('            crc ^= (*d.add(0) as u16) << 8 | (*d.add(1) as u16);')
lines.append('            crc = TFLAC_CRC16_TABLES[7][(crc >> 8) as usize]')
lines.append('                ^ TFLAC_CRC16_TABLES[6][(crc & 0xFF) as usize]')
lines.append('                ^ TFLAC_CRC16_TABLES[5][*d.add(2) as usize]')
lines.append('                ^ TFLAC_CRC16_TABLES[4][*d.add(3) as usize]')
lines.append('                ^ TFLAC_CRC16_TABLES[3][*d.add(4) as usize]')
lines.append('                ^ TFLAC_CRC16_TABLES[2][*d.add(5) as usize]')
lines.append('                ^ TFLAC_CRC16_TABLES[1][*d.add(6) as usize]')
lines.append('                ^ TFLAC_CRC16_TABLES[0][*d.add(7) as usize];')
lines.append('            d = d.add(8);')
lines.append('            len -= 8;')
lines.append('        }')
lines.append('        while len > 0 {')
lines.append('            len -= 1;')
lines.append('            crc = (crc << 8) ^ TFLAC_CRC16_TABLES[0][((crc >> 8) ^ (*d as u16)) as usize];')
lines.append('            d = d.add(1);')
lines.append('        }')
lines.append('    }')
lines.append('    crc')
lines.append('}')
lines.append('')

with open('src/lib.rs', 'w') as f:
    f.write('\n'.join(lines))

print('Generated src/lib.rs successfully')
print(f'Table has {len(hex_vals)} values')
"
