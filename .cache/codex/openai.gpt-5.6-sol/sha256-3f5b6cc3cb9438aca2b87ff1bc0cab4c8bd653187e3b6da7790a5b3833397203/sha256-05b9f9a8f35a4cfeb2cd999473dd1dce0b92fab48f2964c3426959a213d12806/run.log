{"type":"item.started","item":{"id":"item_62","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes as C\nimport importlib.util\nimport random\nimport struct\nspec = importlib.util.spec_from_file_location('d', '/tmp/harvest_diff_oMSUrT.py')\nd = importlib.util.module_from_spec(spec); spec.loader.exec_module(d)\nc = C.CDLL('/tmp/harvest-c-build-oMSUrT/libharvest-work-oMSUrT.so')\nr = C.CDLL('target/release/libharvest_work_oMSUrT.so')\nd.configure(c); d.configure(r)\nrng = random.Random(0x1EEE754)\ndef bits(n): return b''.join(struct.pack('=I', rng.getrandbits(32)) for _ in range(n))\ndef obj(t, n): return t.from_buffer_copy(bits(n))\nfor i in range(100000):\n    ray, circle = obj(d.Ray, 5), obj(d.Circle, 3)\n    aabb, capsule = obj(d.Aabb, 4), obj(d.Capsule, 5)\n    d.compare_out('c2RaytoCircle/raw', c.c2RaytoCircle, r.c2RaytoCircle, (ray, circle))\n    d.compare_out('c2RaytoAABB/raw', c.c2RaytoAABB, r.c2RaytoAABB, (ray, aabb))\n    d.compare_out('c2RaytoCapsule/raw', c.c2RaytoCapsule, r.c2RaytoCapsule, (ray, capsule))\n    for type_id, shape in ((0, circle), (1, aabb), (2, capsule)):\n        co, ro = d.sentinel(), d.sentinel()\n        cs, rs = d.clone(shape), d.clone(shape)\n        cr = c.c2CastRay(ray, C.cast(C.byref(cs), C.c_void_p), type_id, C.byref(co))\n        rr = r.c2CastRay(ray, C.cast(C.byref(rs), C.c_void_p), type_id, C.byref(ro))\n        d.compare_value('c2CastRay/raw return', cr, rr)\n        d.compare_value('c2CastRay/raw output', co, ro)\nprint('raw IEEE-754 ray differential matched')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
