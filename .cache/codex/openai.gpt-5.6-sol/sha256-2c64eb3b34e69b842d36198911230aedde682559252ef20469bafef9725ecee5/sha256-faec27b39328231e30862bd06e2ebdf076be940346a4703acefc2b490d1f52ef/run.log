5\t\n    56\t    let tree = Tree::new();\n    57\t    assert_eq!(tree.len(), 0);\n    58\t    assert!(!tree.has_root);\n    59\t\n    60\t    println!(\"✓ PASS: test_tree_creation\");\n    61\t}\n    62\t\n    63\tfn test_tree_add_root() {\n    64\t    println!(\"\\n=== Testing Tree Add Root ===\");\n    65\t\n    66\t    let mut tree = Tree::new();\n    67\t    assert_eq!(tree.add_node(1, 0, Some(b\"root\")), 0);\n    68\t    assert_eq!(tree.len(), 1);\n    69\t    assert!(tree.has_root);\n    70\t    assert_eq!(tree.root_id, 1);\n    71\t\n    72\t    let root = tree.get_node(1).unwrap();\n    73\t    assert_eq!(root.id, 1);\n    74\t    assert_eq!(root.data, b\"root\");\n    75\t    assert_eq!(root.child_ids.len(), 0);\n    76\t\n    77\t    println!(\"✓ PASS: test_tree_add_root\");\n    78\t}\n    79\t\n    80\tfn test_tree_add_children() {\n    81\t    println!(\"\\n=== Testing Tree Add Children ===\");\n    82\t\n    83\t    let mut tree = Tree::new();\n    84\t    assert_eq!(tree.add_node(1, 0, Some(b\"root\")), 0);\n    85\t    assert_eq!(tree.add_node(2, 1, Some(b\"child1\")), 0);\n    86\t    assert_eq!(tree.add_node(3, 1, Some(b\"child2\")), 0);\n    87\t    assert_eq!(tree.add_node(4, 1, Some(b\"child3\")), 0);\n    88\t    assert_eq!(tree.len(), 4);\n    89\t\n    90\t    let root = tree.get_node(1).unwrap();\n    91\t    assert_eq!(root.child_ids.len(), 3);\n    92\t    assert_eq!(root.child_ids[0], 2);\n    93\t    assert_eq!(root.child_ids[1], 3);\n    94\t    assert_eq!(root.child_ids[2], 4);\n    95\t\n    96\t    println!(\"✓ PASS: test_tree_add_children\");\n    97\t}\n    98\t\n    99\tfn test_tree_deep_hierarchy() {\n   100\t    println!(\"\\n=== Testing Tree Deep Hierarchy ===\");\n   101\t\n   102\t    let mut tree = Tree::new();\n   103\t    assert_eq!(tree.add_node(1, 0, Some(b\"level0\")), 0);\n   104\t    assert_eq!(tree.add_node(2, 1, Some(b\"level1\")), 0);\n   105\t    assert_eq!(tree.add_node(3, 2, Some(b\"level2\")), 0);\n   106\t    assert_eq!(tree.add_node(4, 3, Some(b\"level3\")), 0);\n   107\t    assert_eq!(tree.add_node(5, 4, Some(b\"level4\")), 0);\n   108\t    assert_eq!(tree.len(), 5);\n   109\t\n   110\t    assert_eq!(tree.depth(1), 0);\n   111\t    assert_eq!(tree.depth(2), 1);\n   112\t    assert_eq!(tree.depth(3), 2);\n   113\t    assert_eq!(tree.depth(4), 3);\n   114\t    assert_eq!(tree.depth(5), 4);\n   115\t    assert_eq!(tree.height(1), 4);\n   116\t    assert_eq!(tree.height(2), 3);\n   117\t    assert_eq!(tree.height(5), 0);\n   118\t\n   119\t    println!(\"✓ PASS: test_tree_deep_hierarchy\");\n   120\t}\n   121\t\n   122\tfn test_tree_remove_leaf() {\n   123\t    println!(\"\\n=== Testing Tree Remove Leaf ===\");\n   124\t\n   125\t    let mut tree = Tree::new();\n   126\t    assert_eq!(tree.add_node(1, 0, Some(b\"root\")), 0);\n   127\t    assert_eq!(tree.add_node(2, 1, Some(b\"child1\")), 0);\n   128\t    assert_eq!(tree.add_node(3, 1, Some(b\"child2\")), 0);\n   129\t    assert_eq!(tree.len(), 3);\n   130\t\n   131\t    assert_eq!(tree.remove_node(3), 0);\n   132\t    assert_eq!(tree.len(), 2);\n   133\t    assert!(!tree.contains(3));\n   134\t\n   135\t    let root = tree.get_node(1).unwrap();\n   136\t    assert_eq!(root.child_ids.len(), 1);\n   137\t    assert_eq!(root.child_ids[0], 2);\n   138\t\n   139\t    println!(\"✓ PASS: test_tree_remove_leaf\");\n   140\t}\n   141\t\n   142\tfn test_tree_remove_subtree() {\n   143\t    println!(\"\\n=== Testing Tree Remove Subtree ===\");\n   144\t\n   145\t    let mut tree = Tree::new();\n   146\t    assert_eq!(tree.add_node(1, 0, Some(b\"root\")), 0);\n   147\t    assert_eq!(tree.add_node(2, 1, Some(b\"child1\")), 0);\n   148\t    assert_eq!(tree.add_node(3, 2, Some(b\"grandchild1\")), 0);\n   149\t    assert_eq!(tree.add_node(4, 2, Some(b\"grandchild2\")), 0);\n   150\t    assert_eq!(tree.add_node(5, 1, Some(b\"child2\")), 0);\n   151\t    assert_eq!(tree.len(), 5);\n   152\t\n   153\t    assert_eq!(tree.remove_node(2), 0);\n   154\t    assert_eq!(tree.len(), 2);\n   155\t    assert!(!tree.contains(2));\n   156\t    assert!(!tree.contains(3));\n   157\t    assert!(!tree.contains(4));\n   158\t    assert!(tree.contains(1));\n   159\t    assert!(tree.contains(5));\n   160\t\n   161\t    println!(\"✓ PASS: test_tree_remove_subtree\");\n   162\t}\n   163\t\n   164\tfn test_tree_remove_root() {\n   165\t    println!(\"\\n=== Testing Tree Remove Root ===\");\n   166\t\n   167\t    let mut tree = Tree::new();\n   168\t    assert_eq!(tree.add_node(1, 0, Some(b\"root\")), 0);\n   169\t    assert_eq!(tree.add_node(2, 1, Some(b\"child1\")), 0);\n   170\t    assert_eq!(tree.add_node(3, 1, Some(b\"child2\")), 0);\n   171\t    assert_eq!(tree.len(), 3);\n   172\t\n   173\t    assert_eq!(tree.remove_node(1), 0);\n   174\t    assert_eq!(tree.len(), 0);\n   175\t    assert!(!tree.has_root);\n   176\t\n   177\t    println!(\"✓ PASS: test_tree_remove_root\");\n   178\t}\n   179\t\n   180\tfn test_tree_count_descendants() {\n   181\t    println!(\"\\n=== Testing Tree Count Descendants ===\");\n   182\t\n   183\t    let mut tree = Tree::new();\n   184\t    assert_eq!(tree.add_node(1, 0, Some(b\"root\")), 0);\n   185\t    assert_eq!(tree.add_node(2, 1, Some(b\"child1\")), 0);\n   186\t    assert_eq!(tree.add_node(3, 2, Some(b\"grandchild1\")), 0);\n   187\t    assert_eq!(tree.add_node(4, 2, Some(b\"grandchild2\")), 0);\n   188\t    assert_eq!(tree.add_node(5, 1, Some(b\"child2\")), 0);\n   189\t\n   190\t    assert_eq!(tree.count_descendants(1), 4);\n   191\t    assert_eq!(tree.count_descendants(2), 2);\n   192\t    assert_eq!(tree.count_descendants(3), 0);\n   193\t    assert_eq!(tree.count_descendants(5), 0);\n   194\t\n   195\t    println!(\"✓ PASS: test_tree_count_descendants\");\n   196\t}\n   197\t\n   198\tfn test_tree_find_path() {\n   199\t    println!(\"\\n=== Testing Tree Find Path ===\");\n   200\t\n   201\t    let mut tree = Tree::new();\n   202\t    assert_eq!(tree.add_node(1, 0, Some(b\"root\")), 0);\n   203\t    assert_eq!(tree.add_node(2, 1, Some(b\"child\")), 0);\n   204\t    assert_eq!(tree.add_node(3, 2, Some(b\"grandchild\")), 0);\n   205\t\n   206\t    let mut path = [0; 10];\n   207\t    let mut length = tree.find_path(3, &mut path, 10);\n   208\t    assert_eq!(length, 3);\n   209\t    assert_eq!(path[0], 1);\n   210\t    assert_eq!(path[1], 2);\n   211\t    assert_eq!(path[2], 3);\n   212\t\n   213\t    length = tree.find_path(1, &mut path, 10);\n   214\t    assert_eq!(length, 1);\n   215\t    assert_eq!(path[0], 1);\n   216\t\n   217\t    println!(\"✓ PASS: test_tree_find_path\");\n   218\t}\n   219\t\n   220\tfn test_tree_duplicate_id() {\n   221\t    println!(\"\\n=== Testing Tree Duplicate ID ===\");\n   222\t\n   223\t    let mut tree = Tree::new();\n   224\t    assert_eq!(tree.add_node(1, 0, Some(b\"root\")), 0);\n   225\t    assert_eq!(tree.add_node(2, 1, Some(b\"child\")), 0);\n   226\t    assert_ne!(tree.add_node(2, 1, Some(b\"duplicate\")), 0);\n   227\t    assert_eq!(tree.len(), 2);\n   228\t\n   229\t    println!(\"✓ PASS: test_tree_duplicate_id\");\n   230\t}\n   231\t\n   232\tfn test_tree_max_children() {\n   233\t    println!(\"\\n=== Testing Tree Max Children ===\");\n   234\t\n   235\t    let mut tree = Tree::new();\n   236\t    assert_eq!(tree.add_node(1, 0, Some(b\"root\")), 0);\n   237\t    for i in 0..MAX_CHILDREN {\n   238\t        assert_eq!(tree.add_node((i + 2) as u64, 1, Some(b\"child\")), 0);\n   239\t    }\n   240\t    assert_ne!(\n   241\t        tree.add_node((MAX_CHILDREN + 2) as u64, 1, Some(b\"overflow\")),\n   242\t        0\n   243\t    );\n   244\t    assert_eq!(tree.len(), MAX_CHILDREN + 1);\n   245\t\n   246\t    println!(\"✓ PASS: test_tree_max_children\");\n   247\t}\n   248\t\n   249\tfn test_tree_complex_structure() {\n   250\t    println!(\"\\n=== Testing Tree Complex Structure ===\");\n   251\t\n   252\t    let mut tree = Tree::new();\n   253\t    assert_eq!(tree.add_node(1, 0, Some(b\"root\")), 0);\n   254\t    assert_eq!(tree.add_node(2, 1, Some(b\"child1\")), 0);\n   255\t    assert_eq!(tree.add_node(3, 1, Some(b\"child2\")), 0);\n   256\t    assert_eq!(tree.add_node(4, 1, Some(b\"child3\")), 0);\n   257\t    assert_eq!(tree.add_node(5, 2, Some(b\"gc1\")), 0);\n   258\t    assert_eq!(tree.add_node(6, 2, Some(b\"gc2\")), 0);\n   259\t    assert_eq!(tree.add_node(7, 3, Some(b\"gc3\")), 0);\n   260\t    assert_eq!(tree.add_node(8, 4, Some(b\"gc4\")), 0);\n   261\t    assert_eq!(tree.add_node(9, 4, Some(b\"gc5\")), 0);\n   262\t    assert_eq!(tree.add_node(10, 7, Some(b\"ggc1\")), 0);\n   263\t\n   264\t    assert_eq!(tree.len(), 10);\n   265\t    assert_eq!(tree.height(1), 3);\n   266\t    assert_eq!(tree.count_descendants(1), 9);\n   267\t    assert_eq!(tree.count_descendants(2), 2);\n   268\t    assert_eq!(tree.count_descendants(7), 1);\n   269\t    tree.print();\n   270\t\n   271\t    println!(\"✓ PASS: test_tree_complex_structure\");\n   272\t}\n   273\t\n   274\tfn main() {\n   275\t    println!(\"╔════════════════════════════════════════╗\");\n   276\t    println!(\"║  TREE WITH HASHMAP ID MAPPING TESTS   ║\");\n   277\t    println!(\"╚════════════════════════════════════════╝\");\n   278\t\n   279\t    test_hashmap_basic();\n   280\t    test_hashmap_collisions();\n   281\t    test_tree_creation();\n   282\t    test_tree_add_root();\n   283\t    test_tree_add_children();\n   284\t    test_tree_deep_hierarchy();\n   285\t    test_tree_complex_structure();\n   286\t    test_tree_remove_leaf();\n   287\t    test_tree_remove_subtree();\n   288\t    test_tree_remove_root();\n   289\t    test_tree_count_descendants();\n   290\t    test_tree_find_path();\n   291\t    test_tree_duplicate_id();\n   292\t    test_tree_max_children();\n   293\t\n   294\t    println!();\n   295\t    println!(\"========================================\");\n   296\t    println!(\"  All tests passed successfully!\");\n   297\t    println!(\"========================================\");\n   298\t}\n     1\tconst INITIAL_CAPACITY: usize = 16;\n     2\tconst LOAD_FACTOR: f64 = 0.75;\n     3\t\n     4\tstruct Entry<V> {\n     5\t    key: u64,\n     6\t    value: Option<V>,\n     7\t    occupied: bool,\n     8\t    deleted: bool,\n     9\t}\n    10\t\n    11\timpl<V> Entry<V> {\n    12\t    fn empty() -> Self {\n    13\t        Self {\n    14\t            key: 0,\n    15\t            value: None,\n    16\t            occupied: false,\n    17\t            deleted: false,\n    18\t        }\n    19\t    }\n    20\t}\n    21\t\n    22\tpub struct HashMap<V> {\n    23\t    entries: Vec<Entry<V>>,\n    24\t    size: usize,\n    25\t    deleted_count: usize,\n    26\t}\n    27\t\n    28\timpl<V> HashMap<V> {\n    29\t    pub fn new() -> Self {\n    30\t        Self {\n    31\t            entries: Self::empty_entries(INITIAL_CAPACITY),\n    32\t            size: 0,\n    33\t            deleted_count: 0,\n    34\t        }\n    35\t    }\n    36\t\n    37\t    fn empty_entries(capacity: usize) -> Vec<Entry<V>> {\n    38\t        std::iter::repeat_with(Entry::empty)\n    39\t            .take(capacity)\n    40\t            .collect()\n    41\t    }\n    42\t\n    43\t    fn hash(key: u64) -> u64 {\n    44\t        let mut hash = 14_695_981_039_346_656_037_u64;\n    45\t        for byte in key.to_ne_bytes() {\n    46\t            hash ^= u64::from(byte);\n    47\t            hash = hash.wrapping_mul(1_099_511_628_211);\n    48\t        }\n    49\t        hash\n    50\t    }\n    51\t\n    52\t    fn should_resize(&self) -> bool {\n    53\t        (self.size + self.deleted_count) as f64 / self.entries.len() as f64 > LOAD_FACTOR\n    54\t    }\n    55\t\n    56\t    fn resize(&mut self) {\n    57\t        let new_capacity = self.entries.len() * 2;\n    58\t        let old_entries = std::mem::replace(&mut self.entries, Self::empty_entries(new_capacity));\n    59\t        self.size = 0;\n    60\t        self.deleted_count = 0;\n    61\t\n    62\t        for mut entry in old_entries {\n    63\t            if entry.occupied && !entry.deleted {\n    64\t                self.put(entry.key, entry.value.take().unwrap());\n    65\t            }\n    66\t        }\n    67\t    }\n    68\t\n    69\t    pub fn put(&mut self, key: u64, value: V) -> i32 {\n    70\t        if self.should_resize() {\n    71\t            self.resize();\n    72\t        }\n    73\t\n    74\t        let capacity = self.entries.len();\n    75\t        let index = Self::hash(key) as usize % capacity;\n    76\t        let mut value = Some(value);\n    77\t\n    78\t        for probe in 0..capacity {\n    79\t            let current = (index + probe) % capacity;\n    80\t            let entry = &mut self.entries[current];\n    81\t\n    82\t            if !entry.occupied {\n    83\t                entry.key = key;\n    84\t                entry.value = value.take();\n    85\t                entry.occupied = true;\n    86\t                entry.deleted = false;\n    87\t                self.size += 1;\n    88\t                return 0;\n    89\t            } else if entry.deleted {\n    90\t                entry.key = key;\n    91\t                entry.value = value.take();\n    92\t                entry.deleted = false;\n    93\t                self.size += 1;\n    94\t                self.deleted_count -= 1;\n    95\t                return 0;\n    96\t            } else if entry.key == key {\n    97\t                entry.value = value.take();\n    98\t                return 0;\n    99\t            }\n   100\t        }\n   101\t\n   102\t        -1\n   103\t    }\n   104\t\n   105\t    pub fn get(&self, key: u64) -> Option<&V> {\n   106\t        let capacity = self.entries.len();\n   107\t        let index = Self::hash(key) as usize % capacity;\n   108\t\n   109\t        for probe in 0..capacity {\n   110\t            let entry = &self.entries[(index + probe) % capacity];\n   111\t            if !entry.occupied {\n   112\t                return None;\n   113\t            }\n   114\t            if !entry.deleted && entry.key == key {\n   115\t                return entry.value.as_ref();\n   116\t            }\n   117\t        }\n   118\t\n   119\t        None\n   120\t    }\n   121\t\n   122\t    pub fn get_mut(&mut self, key: u64) -> Option<&mut V> {\n   123\t        let capacity = self.entries.len();\n   124\t        let index = Self::hash(key) as usize % capacity;\n   125\t        let mut found = None;\n   126\t\n   127\t        for probe in 0..capacity {\n   128\t            let current = (index + probe) % capacity;\n   129\t            let entry = &self.entries[current];\n   130\t            if !entry.occupied {\n   131\t                break;\n   132\t            }\n   133\t            if !entry.deleted && entry.key == key {\n   134\t                found = Some(current);\n   135\t                break;\n   136\t            }\n   137\t        }\n   138\t\n   139\t        found.and_then(|current| self.entries[current].value.as_mut())\n   140\t    }\n   141\t\n   142\t    pub fn remove(&mut self, key: u64) -> Option<V> {\n   143\t        let capacity = self.entries.len();\n   144\t        let index = Self::hash(key) as usize % capacity;\n   145\t\n   146\t        for probe in 0..capacity {\n   147\t            let entry = &mut self.entries[(index + probe) % capacity];\n   148\t            if !entry.occupied {\n   149\t                return None;\n   150\t            }\n   151\t            if !entry.deleted && entry.key == key {\n   152\t                entry.deleted = true;\n   153\t                self.size -= 1;\n   154\t                self.deleted_count += 1;\n   155\t                return entry.value.take();\n   156\t            }\n   157\t        }\n   158\t\n   159\t        None\n   160\t    }\n   161\t\n   162\t    pub fn contains(&self, key: u64) -> bool {\n   163\t        self.get(key).is_some()\n   164\t    }\n   165\t\n   166\t    pub fn len(&self) -> usize {\n   167\t        self.size\n   168\t    }\n   169\t\n   170\t    #[allow(dead_code)]\n   171\t    pub fn clear(&mut self) {\n   172\t        for entry in &mut self.entries {\n   173\t            entry.occupied = false;\n   174\t            entry.deleted = false;\n   175\t            entry.value = None;\n   176\t        }\n   177\t        self.size = 0;\n   178\t        self.deleted_count = 0;\n   179\t    }\n   180\t}\n     1\tuse crate::hashmap::HashMap;\n     2\t\n     3\tpub const MAX_CHILDREN: usize = 32;\n     4\tconst MAX_DATA_LENGTH: usize = 256;\n     5\t\n     6\tpub struct TreeNode {\n     7\t    pub id: u64,\n     8\t    pub parent_id: u64,\n     9\t    pub child_ids: Vec<u64>,\n    10\t    pub data: Vec<u8>,\n    11\t}\n    12\t\n    13\tpub struct Tree {\n    14\t    nodes: HashMap<TreeNode>,\n    15\t    pub root_id: u64,\n    16\t    pub has_root: bool,\n    17\t    node_count: usize,\n    18\t}\n    19\t\n    20\timpl Tree {\n    21\t    pub fn new() -> Self {\n    22\t        Self {\n    23\t            nodes: HashMap::new(),\n    24\t            root_id: 0,\n    25\t            has_root: false,\n    26\t            node_count: 0,\n    27\t        }\n    28\t    }\n    29\t\n    30\t    pub fn add_node(&mut self, id: u64, parent_id: u64, data: Option<&[u8]>) -> i32 {\n    31\t        if self.contains(id) {\n    32\t            eprintln!(\"Error: Node with ID {id} already exists\");\n    33\t            return -1;\n    34\t        }\n    35\t\n    36\t        let mut node = TreeNode {\n    37\t            id,\n    38\t            parent_id,\n    39\t            child_ids: Vec::new(),\n    40\t            data: data.unwrap_or_default()\n    41\t                [..data.unwrap_or_default().len().min(MAX_DATA_LENGTH - 1)]\n    42\t                .to_vec(),\n    43\t        };\n    44\t\n    45\t        if !self.has_root {\n    46\t            self.root_id = id;\n    47\t            self.has_root = true;\n    48\t            node.parent_id = 0;\n    49\t        } else {\n    50\t            let Some(parent) = self.nodes.get_mut(parent_id) else {\n    51\t                eprintln!(\"Error: Parent node {parent_id} not found\");\n    52\t                return -1;\n    53\t            };\n    54\t\n    55\t            if parent.child_ids.len() >= MAX_CHILDREN {\n    56\t                eprintln!(\"Error: Parent has maximum children\");\n    57\t                return -1;\n    58\t            }\n    59\t\n    60\t            parent.child_ids.push(id);\n    61\t        }\n    62\t\n    63\t        if self.nodes.put(id, node) != 0 {\n    64\t            eprintln!(\"Error: Failed to add node to hashmap\");\n    65\t            return -1;\n    66\t        }\n    67\t\n    68\t        self.node_count += 1;\n    69\t        0\n    70\t    }\n    71\t\n    72\t    fn remove_subtree(&mut self, id: u64) -> i32 {\n    73\t        let Some(node) = self.nodes.get(id) else {\n    74\t            return -1;\n    75\t        };\n    76\t        let child_ids = node.child_ids.clone();\n    77\t\n    78\t        for child_id in child_ids {\n    79\t            self.remove_subtree(child_id);\n    80\t        }\n    81\t\n    82\t        if self.nodes.remove(id).is_some() {\n    83\t            self.node_count -= 1;\n    84\t        }\n    85\t        0\n    86\t    }\n    87\t\n    88\t    pub fn remove_node(&mut self, id: u64) -> i32 {\n    89\t        let Some(node) = self.nodes.get(id) else {\n    90\t            eprintln!(\"Error: Node {id} not found\");\n    91\t            return -1;\n    92\t        };\n    93\t        let parent_id = node.parent_id;\n    94\t\n    95\t        if id == self.root_id {\n    96\t            self.remove_subtree(id);\n    97\t            self.has_root = false;\n    98\t            self.root_id = 0;\n    99\t            return 0;\n   100\t        }\n   101\t\n   102\t        if let Some(parent) = self.nodes.get_mut(parent_id) {\n   103\t            if let Some(index) = parent.child_ids.iter().position(|child| *child == id) {\n   104\t                parent.child_ids.remove(index);\n   105\t            }\n   106\t        }\n   107\t\n   108\t        self.remove_subtree(id);\n   109\t        0\n   110\t    }\n   111\t\n   112\t    pub fn get_node(&self, id: u64) -> Option<&TreeNode> {\n   113\t        self.nodes.get(id)\n   114\t    }\n   115\t\n   116\t    pub fn contains(&self, id: u64) -> bool {\n   117\t        self.get_node(id).is_some()\n   118\t    }\n   119\t\n   120\t    pub fn len(&self) -> usize {\n   121\t        self.node_count\n   122\t    }\n   123\t\n   124\t    fn print_node(&self, id: u64, depth: usize) {\n   125\t        let Some(node) = self.get_node(id) else {\n   126\t            return;\n   127\t        };\n   128\t\n   129\t        let data = String::from_utf8_lossy(&node.data);\n   130\t        println!(\"{}[{}] {}\", \"  \".repeat(depth), node.id, data);\n   131\t        for child_id in &node.child_ids {\n   132\t            self.print_node(*child_id, depth + 1);\n   133\t        }\n   134\t    }\n   135\t\n   136\t    pub fn print(&self) {\n   137\t        if !self.has_root {\n   138\t            println!(\"(empty tree)\");\n   139\t            return;\n   140\t        }\n   141\t        self.print_node(self.root_id, 0);\n   142\t    }\n   143\t\n   144\t    pub fn depth(&self, id: u64) -> i32 {\n   145\t        if !self.contains(id) {\n   146\t            return -1;\n   147\t        }\n   148\t\n   149\t        let mut depth = 0;\n   150\t        let mut current_id = id;\n   151\t        while current_id != self.root_id {\n   152\t            let Some(node) = self.get_node(current_id) else {\n   153\t                return -1;\n   154\t            };\n   155\t            current_id = node.parent_id;\n   156\t            depth += 1;\n   157\t        }\n   158\t        depth\n   159\t    }\n   160\t\n   161\t    pub fn height(&self, id: u64) -> i32 {\n   162\t        let Some(node) = self.get_node(id) else {\n   163\t            return -1;\n   164\t        };\n   165\t        if node.child_ids.is_empty() {\n   166\t            return 0;\n   167\t        }\n   168\t\n   169\t        let mut max_height = 0;\n   170\t        for child_id in &node.child_ids {\n   171\t            let child_height = self.height(*child_id);\n   172\t            if child_height > max_height {\n   173\t                max_height = child_height;\n   174\t            }\n   175\t        }\n   176\t        max_height + 1\n   177\t    }\n   178\t\n   179\t    pub fn count_descendants(&self, id: u64) -> i32 {\n   180\t        let Some(node) = self.get_node(id) else {\n   181\t            return -1;\n   182\t        };\n   183\t\n   184\t        let mut count = 0;\n   185\t        for child_id in &node.child_ids {\n   186\t            count += 1;\n   187\t            count += self.count_descendants(*child_id);\n   188\t        }\n   189\t        count\n   190\t    }\n   191\t\n   192\t    pub fn find_path(&self, id: u64, path: &mut [u64], max_length: i32) -> i32 {\n   193\t        if !self.contains(id) {\n   194\t            return -1;\n   195\t        }\n   196\t\n   197\t        let mut temp_path = [0_u64; 1000];\n   198\t        let mut length = 0_usize;\n   199\t        let mut current_id = id;\n   200\t\n   201\t        while length < temp_path.len() {\n   202\t            temp_path[length] = current_id;\n   203\t            length += 1;\n   204\t\n   205\t            if current_id == self.root_id {\n   206\t                break;\n   207\t            }\n   208\t            let Some(node) = self.get_node(current_id) else {\n   209\t                return -1;\n   210\t            };\n   211\t            current_id = node.parent_id;\n   212\t        }\n   213\t\n   214\t        if length as i32 > max_length {\n   215\t            length = max_length as usize;\n   216\t        }\n   217\t        for (index, destination) in path.iter_mut().take(length).enumerate() {\n   218\t            *destination = temp_path[length - 1 - index];\n   219\t        }\n   220\t        length as