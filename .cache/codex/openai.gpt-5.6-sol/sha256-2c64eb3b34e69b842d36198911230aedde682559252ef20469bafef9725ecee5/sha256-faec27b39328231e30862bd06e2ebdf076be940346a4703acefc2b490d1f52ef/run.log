\\n\");\n    37\t    \n    38\t    hashmap_t *map = hashmap_create();\n    39\t    assert(map != NULL);\n    40\t    assert(hashmap_size(map) == 0);\n    41\t    \n    42\t    // Test put and get\n    43\t    int val1 = 42, val2 = 100, val3 = 200;\n    44\t    assert(hashmap_put(map, 1, &val1) == 0);\n    45\t    assert(hashmap_put(map, 2, &val2) == 0);\n    46\t    assert(hashmap_put(map, 3, &val3) == 0);\n    47\t    assert(hashmap_size(map) == 3);\n    48\t    \n    49\t    assert(*(int *)hashmap_get(map, 1) == 42);\n    50\t    assert(*(int *)hashmap_get(map, 2) == 100);\n    51\t    assert(*(int *)hashmap_get(map, 3) == 200);\n    52\t    \n    53\t    // Test update\n    54\t    int val4 = 500;\n    55\t    assert(hashmap_put(map, 1, &val4) == 0);\n    56\t    assert(hashmap_size(map) == 3);\n    57\t    assert(*(int *)hashmap_get(map, 1) == 500);\n    58\t    \n    59\t    // Test remove\n    60\t    void *removed = hashmap_remove(map, 2);\n    61\t    assert(removed == &val2);\n    62\t    assert(hashmap_size(map) == 2);\n    63\t    assert(hashmap_get(map, 2) == NULL);\n    64\t    \n    65\t    // Test contains\n    66\t    assert(hashmap_contains(map, 1) == 1);\n    67\t    assert(hashmap_contains(map, 2) == 0);\n    68\t    assert(hashmap_contains(map, 3) == 1);\n    69\t    \n    70\t    hashmap_destroy(map);\n    71\t    TEST_PASS;\n    72\t}\n    73\t\n    74\tvoid test_hashmap_collisions(void) {\n    75\t    printf(\"\\n=== Testing Hashmap Collisions ===\\n\");\n    76\t    \n    77\t    hashmap_t *map = hashmap_create();\n    78\t    \n    79\t    // Add many items to force collisions\n    80\t    int values[100];\n    81\t    for (int i = 0; i < 100; i++) {\n    82\t        values[i] = i * 10;\n    83\t        assert(hashmap_put(map, i, &values[i]) == 0);\n    84\t    }\n    85\t    \n    86\t    assert(hashmap_size(map) == 100);\n    87\t    \n    88\t    // Verify all values\n    89\t    for (int i = 0; i < 100; i++) {\n    90\t        int *val = (int *)hashmap_get(map, i);\n    91\t        assert(val != NULL);\n    92\t        assert(*val == i * 10);\n    93\t    }\n    94\t    \n    95\t    hashmap_destroy(map);\n    96\t    TEST_PASS;\n    97\t}\n    98\t\n    99\tvoid test_tree_creation(void) {\n   100\t    printf(\"\\n=== Testing Tree Creation ===\\n\");\n   101\t    \n   102\t    tree_t *tree = tree_create();\n   103\t    assert(tree != NULL);\n   104\t    assert(tree_size(tree) == 0);\n   105\t    assert(tree->has_root == 0);\n   106\t    \n   107\t    tree_delete(tree);\n   108\t    TEST_PASS;\n   109\t}\n   110\t\n   111\tvoid test_tree_add_root(void) {\n   112\t    printf(\"\\n=== Testing Tree Add Root ===\\n\");\n   113\t    \n   114\t    tree_t *tree = tree_create();\n   115\t    \n   116\t    // Add root node\n   117\t    assert(tree_add_node(tree, 1, 0, \"root\") == 0);\n   118\t    assert(tree_size(tree) == 1);\n   119\t    assert(tree->has_root == 1);\n   120\t    assert(tree->root_id == 1);\n   121\t    \n   122\t    tree_node_t *root = tree_get_node(tree, 1);\n   123\t    assert(root != NULL);\n   124\t    assert(root->id == 1);\n   125\t    assert(strcmp(root->data, \"root\") == 0);\n   126\t    assert(root->child_count == 0);\n   127\t    \n   128\t    tree_delete(tree);\n   129\t    TEST_PASS;\n   130\t}\n   131\t\n   132\tvoid test_tree_add_children(void) {\n   133\t    printf(\"\\n=== Testing Tree Add Children ===\\n\");\n   134\t    \n   135\t    tree_t *tree = tree_create();\n   136\t    \n   137\t    // Build tree structure\n   138\t    assert(tree_add_node(tree, 1, 0, \"root\") == 0);\n   139\t    assert(tree_add_node(tree, 2, 1, \"child1\") == 0);\n   140\t    assert(tree_add_node(tree, 3, 1, \"child2\") == 0);\n   141\t    assert(tree_add_node(tree, 4, 1, \"child3\") == 0);\n   142\t    \n   143\t    assert(tree_size(tree) == 4);\n   144\t    \n   145\t    tree_node_t *root = tree_get_node(tree, 1);\n   146\t    assert(root->child_count == 3);\n   147\t    assert(root->child_ids[0] == 2);\n   148\t    assert(root->child_ids[1] == 3);\n   149\t    assert(root->child_ids[2] == 4);\n   150\t    \n   151\t    tree_delete(tree);\n   152\t    TEST_PASS;\n   153\t}\n   154\t\n   155\tvoid test_tree_deep_hierarchy(void) {\n   156\t    printf(\"\\n=== Testing Tree Deep Hierarchy ===\\n\");\n   157\t    \n   158\t    tree_t *tree = tree_create();\n   159\t    \n   160\t    // Build deep tree\n   161\t    assert(tree_add_node(tree, 1, 0, \"level0\") == 0);\n   162\t    assert(tree_add_node(tree, 2, 1, \"level1\") == 0);\n   163\t    assert(tree_add_node(tree, 3, 2, \"level2\") == 0);\n   164\t    assert(tree_add_node(tree, 4, 3, \"level3\") == 0);\n   165\t    assert(tree_add_node(tree, 5, 4, \"level4\") == 0);\n   166\t    \n   167\t    assert(tree_size(tree) == 5);\n   168\t    \n   169\t    assert(tree_get_depth(tree, 1) == 0);\n   170\t    assert(tree_get_depth(tree, 2) == 1);\n   171\t    assert(tree_get_depth(tree, 3) == 2);\n   172\t    assert(tree_get_depth(tree, 4) == 3);\n   173\t    assert(tree_get_depth(tree, 5) == 4);\n   174\t    \n   175\t    assert(tree_get_height(tree, 1) == 4);\n   176\t    assert(tree_get_height(tree, 2) == 3);\n   177\t    assert(tree_get_height(tree, 5) == 0);\n   178\t    \n   179\t    tree_delete(tree);\n   180\t    TEST_PASS;\n   181\t}\n   182\t\n   183\tvoid test_tree_remove_leaf(void) {\n   184\t    printf(\"\\n=== Testing Tree Remove Leaf ===\\n\");\n   185\t    \n   186\t    tree_t *tree = tree_create();\n   187\t    \n   188\t    assert(tree_add_node(tree, 1, 0, \"root\") == 0);\n   189\t    assert(tree_add_node(tree, 2, 1, \"child1\") == 0);\n   190\t    assert(tree_add_node(tree, 3, 1, \"child2\") == 0);\n   191\t    \n   192\t    assert(tree_size(tree) == 3);\n   193\t    \n   194\t    // Remove leaf\n   195\t    assert(tree_remove_node(tree, 3) == 0);\n   196\t    assert(tree_size(tree) == 2);\n   197\t    assert(tree_contains(tree, 3) == 0);\n   198\t    \n   199\t    tree_node_t *root = tree_get_node(tree, 1);\n   200\t    assert(root->child_count == 1);\n   201\t    assert(root->child_ids[0] == 2);\n   202\t    \n   203\t    tree_delete(tree);\n   204\t    TEST_PASS;\n   205\t}\n   206\t\n   207\tvoid test_tree_remove_subtree(void) {\n   208\t    printf(\"\\n=== Testing Tree Remove Subtree ===\\n\");\n   209\t    \n   210\t    tree_t *tree = tree_create();\n   211\t    \n   212\t    // Build tree with subtree\n   213\t    assert(tree_add_node(tree, 1, 0, \"root\") == 0);\n   214\t    assert(tree_add_node(tree, 2, 1, \"child1\") == 0);\n   215\t    assert(tree_add_node(tree, 3, 2, \"grandchild1\") == 0);\n   216\t    assert(tree_add_node(tree, 4, 2, \"grandchild2\") == 0);\n   217\t    assert(tree_add_node(tree, 5, 1, \"child2\") == 0);\n   218\t    \n   219\t    assert(tree_size(tree) == 5);\n   220\t    \n   221\t    // Remove node 2 and its children\n   222\t    assert(tree_remove_node(tree, 2) == 0);\n   223\t    assert(tree_size(tree) == 2);\n   224\t    assert(tree_contains(tree, 2) == 0);\n   225\t    assert(tree_contains(tree, 3) == 0);\n   226\t    assert(tree_contains(tree, 4) == 0);\n   227\t    assert(tree_contains(tree, 1) == 1);\n   228\t    assert(tree_contains(tree, 5) == 1);\n   229\t    \n   230\t    tree_delete(tree);\n   231\t    TEST_PASS;\n   232\t}\n   233\t\n   234\tvoid test_tree_remove_root(void) {\n   235\t    printf(\"\\n=== Testing Tree Remove Root ===\\n\");\n   236\t    \n   237\t    tree_t *tree = tree_create();\n   238\t    \n   239\t    assert(tree_add_node(tree, 1, 0, \"root\") == 0);\n   240\t    assert(tree_add_node(tree, 2, 1, \"child1\") == 0);\n   241\t    assert(tree_add_node(tree, 3, 1, \"child2\") == 0);\n   242\t    \n   243\t    assert(tree_size(tree) == 3);\n   244\t    \n   245\t    // Remove root\n   246\t    assert(tree_remove_node(tree, 1) == 0);\n   247\t    assert(tree_size(tree) == 0);\n   248\t    assert(tree->has_root == 0);\n   249\t    \n   250\t    tree_delete(tree);\n   251\t    TEST_PASS;\n   252\t}\n   253\t\n   254\tvoid test_tree_count_descendants(void) {\n   255\t    printf(\"\\n=== Testing Tree Count Descendants ===\\n\");\n   256\t    \n   257\t    tree_t *tree = tree_create();\n   258\t    \n   259\t    /*\n   260\t     * Build tree:\n   261\t     *        1\n   262\t     *       / \\\n   263\t     *      2   5\n   264\t     *     / \\\n   265\t     *    3   4\n   266\t     */\n   267\t    assert(tree_add_node(tree, 1, 0, \"root\") == 0);\n   268\t    assert(tree_add_node(tree, 2, 1, \"child1\") == 0);\n   269\t    assert(tree_add_node(tree, 3, 2, \"grandchild1\") == 0);\n   270\t    assert(tree_add_node(tree, 4, 2, \"grandchild2\") == 0);\n   271\t    assert(tree_add_node(tree, 5, 1, \"child2\") == 0);\n   272\t    \n   273\t    assert(tree_count_descendants(tree, 1) == 4);\n   274\t    assert(tree_count_descendants(tree, 2) == 2);\n   275\t    assert(tree_count_descendants(tree, 3) == 0);\n   276\t    assert(tree_count_descendants(tree, 5) == 0);\n   277\t    \n   278\t    tree_delete(tree);\n   279\t    TEST_PASS;\n   280\t}\n   281\t\n   282\tvoid test_tree_find_path(void) {\n   283\t    printf(\"\\n=== Testing Tree Find Path ===\\n\");\n   284\t    \n   285\t    tree_t *tree = tree_create();\n   286\t    \n   287\t    assert(tree_add_node(tree, 1, 0, \"root\") == 0);\n   288\t    assert(tree_add_node(tree, 2, 1, \"child\") == 0);\n   289\t    assert(tree_add_node(tree, 3, 2, \"grandchild\") == 0);\n   290\t    \n   291\t    tree_id_t path[10];\n   292\t    int length;\n   293\t    \n   294\t    length = tree_find_path(tree, 3, path, 10);\n   295\t    assert(length == 3);\n   296\t    assert(path[0] == 1);\n   297\t    assert(path[1] == 2);\n   298\t    assert(path[2] == 3);\n   299\t    \n   300\t    length = tree_find_path(tree, 1, path, 10);\n   301\t    assert(length == 1);\n   302\t    assert(path[0] == 1);\n   303\t    \n   304\t    tree_delete(tree);\n   305\t    TEST_PASS;\n   306\t}\n   307\t\n   308\tvoid test_tree_duplicate_id(void) {\n   309\t    printf(\"\\n=== Testing Tree Duplicate ID ===\\n\");\n   310\t    \n   311\t    tree_t *tree = tree_create();\n   312\t    \n   313\t    assert(tree_add_node(tree, 1, 0, \"root\") == 0);\n   314\t    assert(tree_add_node(tree, 2, 1, \"child\") == 0);\n   315\t    \n   316\t    // Try to add duplicate\n   317\t    assert(tree_add_node(tree, 2, 1, \"duplicate\") != 0);\n   318\t    assert(tree_size(tree) == 2);\n   319\t    \n   320\t    tree_delete(tree);\n   321\t    TEST_PASS;\n   322\t}\n   323\t\n   324\tvoid test_tree_max_children(void) {\n   325\t    printf(\"\\n=== Testing Tree Max Children ===\\n\");\n   326\t    \n   327\t    tree_t *tree = tree_create();\n   328\t    \n   329\t    assert(tree_add_node(tree, 1, 0, \"root\") == 0);\n   330\t    \n   331\t    // Add MAX_CHILDREN children\n   332\t    for (int i = 0; i < MAX_CHILDREN; i++) {\n   333\t        assert(tree_add_node(tree, i + 2, 1, \"child\") == 0);\n   334\t    }\n   335\t    \n   336\t    // Try to add one more (should fail)\n   337\t    assert(tree_add_node(tree, MAX_CHILDREN + 2, 1, \"overflow\") != 0);\n   338\t    assert(tree_size(tree) == MAX_CHILDREN + 1);\n   339\t    \n   340\t    tree_delete(tree);\n   341\t    TEST_PASS;\n   342\t}\n   343\t\n   344\tvoid test_tree_complex_structure(void) {\n   345\t    printf(\"\\n=== Testing Tree Complex Structure ===\\n\");\n   346\t    \n   347\t    tree_t *tree = tree_create();\n   348\t    \n   349\t    /*\n   350\t     * Build complex tree:\n   351\t     *           1\n   352\t     *        /  |  \\\n   353\t     *       2   3   4\n   354\t     *      /|   |   |\\\n   355\t     *     5 6   7   8 9\n   356\t     *           |\n   357\t     *          10\n   358\t     */\n   359\t    assert(tree_add_node(tree, 1, 0, \"root\") == 0);\n   360\t    assert(tree_add_node(tree, 2, 1, \"child1\") == 0);\n   361\t    assert(tree_add_node(tree, 3, 1, \"child2\") == 0);\n   362\t    assert(tree_add_node(tree, 4, 1, \"child3\") == 0);\n   363\t    assert(tree_add_node(tree, 5, 2, \"gc1\") == 0);\n   364\t    assert(tree_add_node(tree, 6, 2, \"gc2\") == 0);\n   365\t    assert(tree_add_node(tree, 7, 3, \"gc3\") == 0);\n   366\t    assert(tree_add_node(tree, 8, 4, \"gc4\") == 0);\n   367\t    assert(tree_add_node(tree, 9, 4, \"gc5\") == 0);\n   368\t    assert(tree_add_node(tree, 10, 7, \"ggc1\") == 0);\n   369\t    \n   370\t    assert(tree_size(tree) == 10);\n   371\t    assert(tree_get_height(tree, 1) == 3);\n   372\t    assert(tree_count_descendants(tree, 1) == 9);\n   373\t    assert(tree_count_descendants(tree, 2) == 2);\n   374\t    assert(tree_count_descendants(tree, 7) == 1);\n   375\t    \n   376\t    tree_print(tree);\n   377\t    \n   378\t    tree_delete(tree);\n   379\t    TEST_PASS;\n   380\t}\n   381\t\n   382\tint main(void) {\n   383\t    printf(\"╔════════════════════════════════════════╗\\n\");\n   384\t    printf(\"║  TREE WITH HASHMAP ID MAPPING TESTS   ║\\n\");\n   385\t    printf(\"╚════════════════════════════════════════╝\\n\");\n   386\t    \n   387\t    // Hashmap tests\n   388\t    test_hashmap_basic();\n   389\t    test_hashmap_collisions();\n   390\t    \n   391\t    // Tree creation tests\n   392\t    test_tree_creation();\n   393\t    test_tree_add_root();\n   394\t    test_tree_add_children();\n   395\t    \n   396\t    // Tree structure tests\n   397\t    test_tree_deep_hierarchy();\n   398\t    test_tree_complex_structure();\n   399\t    \n   400\t    // Tree removal tests\n   401\t    test_tree_remove_leaf();\n   402\t    test_tree_remove_subtree();\n   403\t    test_tree_remove_root();\n   404\t    \n   405\t    // Tree query tests\n   406\t    test_tree_count_descendants();\n   407\t    test_tree_find_path();\n   408\t    \n   409\t    // Error handling tests\n   410\t    test_tree_duplicate_id();\n   411\t    test_tree_max_children();\n   412\t    \n   413\t    printf(\"\\n\");\n   414\t    printf(\"========================================\\n\");\n   415\t    printf(\"  All tests passed successfully!\\n\");\n   416\t    printf(\"========================================\\n\");\n   417\t    \n   418\t    return 0;\n   419\t}\n     1\t/*\n     2\t * Copyright 2025 MIT Lincoln Laboratory\n     3\t * Permission is hereby granted, free of charge,\n     4\t * to any person obtaining a copy of this software\n     5\t * and associated documentation files (the \"Software\"),\n     6\t * to deal in the Software without restriction,\n     7\t * including without limitation the rights to use, copy,\n     8\t * modify, merge, publish, distribute, sublicense,\n     9\t * and/or sell copies of the Software,\n    10\t * and to permit persons to whom the Software is furnished to do so,\n    11\t * subject to the following conditions:\n    12\t * \n    13\t * The above copyright notice and this permission notice\n    14\t * shall be included in all copies or substantial portions of the Software.\n    15\t * \n    16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    18\t * THE WARRANTIES OF MERCHANTABILITY,\n    19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    24\t */\n    25\t// hashmap.h\n    26\t#ifndef HASHMAP_H\n    27\t#define HASHMAP_H\n    28\t\n    29\t#include <stddef.h>\n    30\t#include <stdint.h>\n    31\t\n    32\t#define HASHMAP_INITIAL_CAPACITY 16\n    33\t#define HASHMAP_LOAD_FACTOR 0.75\n    34\t\n    35\ttypedef uint64_t tree_id_t;\n    36\t\n    37\ttypedef struct hashmap_entry {\n    38\t    tree_id_t key;\n    39\t    void *value;\n    40\t    int occupied;\n    41\t    int deleted;\n    42\t} hashmap_entry_t;\n    43\t\n    44\ttypedef struct {\n    45\t    hashmap_entry_t *entries;\n    46\t    size_t capacity;\n    47\t    size_t size;\n    48\t    size_t deleted_count;\n    49\t} hashmap_t;\n    50\t\n    51\t// Create a new hashmap\n    52\thashmap_t* hashmap_create(void);\n    53\t\n    54\t// Destroy hashmap (does not free values)\n    55\tvoid hashmap_destroy(hashmap_t *map);\n    56\t\n    57\t// Insert or update a key-value pair\n    58\tint hashmap_put(hashmap_t *map, tree_id_t key, void *value);\n    59\t\n    60\t// Get value by key (returns NULL if not found)\n    61\tvoid* hashmap_get(hashmap_t *map, tree_id_t key);\n    62\t\n    63\t// Remove a key-value pair (returns the value or NULL)\n    64\tvoid* hashmap_remove(hashmap_t *map, tree_id_t key);\n    65\t\n    66\t// Check if key exists\n    67\tint hashmap_contains(hashmap_t *map, tree_id_t key);\n    68\t\n    69\t// Get current size\n    70\tsize_t hashmap_size(hashmap_t *map);\n    71\t\n    72\t// Clear all entries\n    73\tvoid hashmap_clear(hashmap_t *map);\n    74\t\n    75\t#endif // HASHMAP_H\n     1\t/*\n     2\t * Copyright 2025 MIT Lincoln Laboratory\n     3\t * Permission is hereby granted, free of charge,\n     4\t * to any person obtaining a copy of this software\n     5\t * and associated documentation files (the \"Software\"),\n     6\t * to deal in the Software without restriction,\n     7\t * including without limitation the rights to use, copy,\n     8\t * modify, merge, publish, distribute, sublicense,\n     9\t * and/or sell copies of the Software,\n    10\t * and to permit persons to whom the Software is furnished to do so,\n    11\t * subject to the following conditions:\n    12\t * \n    13\t * The above copyright notice and this permission notice\n    14\t * shall be included in all copies or substantial portions of the Software.\n    15\t * \n    16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    18\t * THE WARRANTIES OF MERCHANTABILITY,\n    19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    24\t */\n    25\t// tree.h\n    26\t#ifndef TREE_H\n    27\t#define TREE_H\n    28\t\n    29\t#include \"hashmap.h\"\n    30\t\n    31\t#define MAX_CHILDREN 32\n    32\t#define MAX_DATA_LENGTH 256\n    33\t\n    34\ttypedef struct tree_node {\n    35\t    tree_id_t id;\n    36\t    tree_id_t parent_id;\n    37\t    tree_id_t child_ids[MAX_CHILDREN];\n    38\t    int child_count;\n    39\t    char data[MAX_DATA_LENGTH];\n    40\t} tree_node_t;\n    41\t\n    42\ttypedef struct {\n    43\t    hashmap_t *node_map;\n    44\t    tree_id_t root_id;\n    45\t    int has_root;\n    46\t    size_t node_count;\n    47\t} tree_t;\n    48\t\n    49\t// Create a new tree\n    50\ttree_t* tree_create(void);\n    51\t\n    52\t// Delete entire tree and free all nodes\n    53\tvoid tree_delete(tree_t *tree);\n    54\t\n    55\t// Add a node to the tree\n    56\tint tree_add_node(tree_t *tree, tree_id_t id, tree_id_t parent_id, const char *data);\n    57\t\n    58\t// Remove a node and all its descendants\n    59\tint tree_remove_node(tree_t *tree, tree_id_t id);\n    60\t\n    61\t// Get node by ID\n    62\ttree_node_t* tree_get_node(tree_t *tree, tree_id_t id);\n    63\t\n    64\t// Check if node exists\n    65\tint tree_contains(tree_t *tree, tree_id_t id);\n    66\t\n    67\t// Get tree size\n    68\tsize_t tree_size(tree_t *tree);\n    69\t\n    70\t// Print tree structure\n    71\tvoid tree_print(tree_t *tree);\n    72\t\n    73\t// Get depth of a node\n    74\tint tree_get_depth(tree_t *tree, tree_id_t id);\n    75\t\n    76\t// Get height of tree from a node\n    77\tint tree_get_height(tree_t *tree, tree_id_t id);\n    78\t\n    79\t// Count descendants of a node\n    80\tint tree_count_descendants(tree_t *tree, tree_id_t id);\n    81\t\n    82\t// Find path from root to node\n    83\tint tree_find_path(tree_t *tree, tree_id_t id, tree_id_t *path, int max_length);\n    84\t\n    85\t#endif // TREE_H\n","exit_code":0,"status":"completed"}}
