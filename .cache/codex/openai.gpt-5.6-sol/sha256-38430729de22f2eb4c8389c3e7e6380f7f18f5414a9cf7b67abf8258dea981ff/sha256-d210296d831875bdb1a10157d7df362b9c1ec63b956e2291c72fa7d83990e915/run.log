{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc 'git diff --no-index /dev/null translation/Cargo.toml; git diff --no-index /dev/null translation/src/main.rs'","aggregated_output":"diff --git a/translation/Cargo.toml b/translation/Cargo.toml\nnew file mode 100644\nindex 0000000..2340ab4\n--- /dev/null\n+++ b/translation/Cargo.toml\n@@ -0,0 +1,6 @@\n+[package]\n+name = \"driver\"\n+version = \"0.1.0\"\n+edition = \"2021\"\n+\n+[dependencies]\ndiff --git a/translation/src/main.rs b/translation/src/main.rs\nnew file mode 100644\nindex 0000000..01c1d8d\n--- /dev/null\n+++ b/translation/src/main.rs\n@@ -0,0 +1,91 @@\n+use std::io::{self, Read, Write};\n+use std::os::raw::c_char;\n+\n+unsafe extern \"C\" {\n+    fn strncpy(dest: *mut c_char, src: *const c_char, count: usize) -> *mut c_char;\n+}\n+\n+fn fgets_14() -> io::Result<Option<Vec<u8>>> {\n+    let stdin = io::stdin();\n+    let mut input = stdin.lock();\n+    let mut buffer = Vec::with_capacity(13);\n+    let mut byte = [0_u8; 1];\n+\n+    while buffer.len() < 13 {\n+        match input.read(&mut byte)? {\n+            0 if buffer.is_empty() => return Ok(None),\n+            0 => break,\n+            _ => {\n+                buffer.push(byte[0]);\n+                if byte[0] == b'\\n' {\n+                    break;\n+                }\n+            }\n+        }\n+    }\n+\n+    Ok(Some(buffer))\n+}\n+\n+fn atoi(input: &[u8]) -> i32 {\n+    let mut index = 0;\n+    while index < input.len() && matches!(input[index], b' ' | b'\\t'..=b'\\r') {\n+        index += 1;\n+    }\n+\n+    let negative = match input.get(index) {\n+        Some(b'-') => {\n+            index += 1;\n+            true\n+        }\n+        Some(b'+') => {\n+            index += 1;\n+            false\n+        }\n+        _ => false,\n+    };\n+\n+    let mut value = 0_i64;\n+    while let Some(&digit @ b'0'..=b'9') = input.get(index) {\n+        value = value * 10 + i64::from(digit - b'0');\n+        index += 1;\n+    }\n+\n+    if negative {\n+        (-value) as i32\n+    } else {\n+        value as i32\n+    }\n+}\n+\n+fn main() {\n+    let mut data = -1;\n+    let mut output = Vec::new();\n+\n+    match fgets_14() {\n+        Ok(Some(input)) => data = atoi(&input),\n+        Ok(None) | Err(_) => output.extend_from_slice(b\"fgets() failed.\\n\"),\n+    }\n+\n+    let mut source = [b'A'; 100];\n+    source[99] = 0;\n+    let mut dest = [0_u8; 100];\n+\n+    if data < 100 {\n+        // Preserve the C program's signed-to-size_t conversion and unchecked index.\n+        unsafe {\n+            strncpy(\n+                dest.as_mut_ptr().cast(),\n+                source.as_ptr().cast(),\n+                data as usize,\n+            );\n+            *dest.as_mut_ptr().offset(data as isize) = 0;\n+        }\n+    }\n+\n+    let length = dest.iter().position(|&byte| byte == 0).unwrap_or(dest.len());\n+    output.extend_from_slice(&dest[..length]);\n+    output.push(b'\\n');\n+\n+    io::stdout().write_all(&output).unwrap();\n+}\n","exit_code":1,"status":"failed"}}
