{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes as C\nimport math\nimport random\nimport struct\n\nclass V(C.Structure): _fields_ = [('x', C.c_float), ('y', C.c_float)]\nclass R(C.Structure): _fields_ = [('c', C.c_float), ('s', C.c_float)]\nclass X(C.Structure): _fields_ = [('p', V), ('r', R)]\nclass Circle(C.Structure): _fields_ = [('p', V), ('r', C.c_float)]\nclass AABB(C.Structure): _fields_ = [('min', V), ('max', V)]\nclass Capsule(C.Structure): _fields_ = [('a', V), ('b', V), ('r', C.c_float)]\nclass Cache(C.Structure):\n    _fields_ = [('metric', C.c_float), ('count', C.c_int), ('iA', C.c_int * 3), ('iB', C.c_int * 3), ('div', C.c_float)]\nclass Proxy(C.Structure): _fields_ = [('radius', C.c_float), ('count', C.c_int), ('verts', V * 8)]\nclass SV(C.Structure):\n    _fields_ = [('sA', V), ('sB', V), ('p', V), ('u', C.c_float), ('iA', C.c_int), ('iB', C.c_int)]\nclass Simplex(C.Structure):\n    _fields_ = [('a', SV), ('b', SV), ('c', SV), ('d', SV), ('div', C.c_float), ('count', C.c_int)]\n\nc = C.CDLL('../c_reference_build/libharvest-work-IUogR8.so')\nr = C.CDLL('target/release/libreverse_collide.so')\nlibs = (c, r)\n\ndef proto(name, args, result):\n    for lib in libs:\n        f = getattr(lib, name); f.argtypes = args; f.restype = result\n\nfor name, args, result in [\n    ('c2V', [C.c_float,C.c_float], V), ('c2Mulvs',[V,C.c_float],V),\n    ('c2Maxv',[V,V],V), ('c2Minv',[V,V],V), ('c2Clampv',[V,V,V],V),\n    ('c2Sub',[V,V],V), ('c2Dot',[V,V],C.c_float), ('c2RotIdentity',[],R),\n    ('c2xIdentity',[],X), ('c2Len',[V],C.c_float), ('c2Det2',[V,V],C.c_float),\n    ('c2Mulrv',[R,V],V), ('c2Add',[V,V],V), ('c2Mulxv',[X,V],V),\n    ('c2Neg',[V],V), ('c2Skew',[V],V), ('c2CCW90',[V],V),\n    ('c2Div',[V,C.c_float],V), ('c2Norm',[V],V), ('c2MulrvT',[R,V],V),\n    ('c2AABBtoAABB',[AABB,AABB],C.c_int), ('c2AABBtoCapsule',[AABB,Capsule],C.c_int),\n    ('c2CapsuletoCapsule',[Capsule,Capsule],C.c_int),\n    ('c2CircletoCircle',[Circle,Circle],C.c_int), ('c2CircletoAABB',[Circle,AABB],C.c_int),\n    ('c2CircletoCapsule',[Circle,Capsule],C.c_int),\n    ('reverse_collide',[C.c_float,C.c_float,C.c_float],C.c_int),\n]: proto(name,args,result)\nproto('c2BBVerts',[C.POINTER(V),C.POINTER(AABB)],None)\nproto('c2MakeProxy',[C.c_void_p,C.c_int,C.POINTER(Proxy)],None)\nproto('c2GJKSimplexMetric',[C.POINTER(Simplex)],C.c_float)\nproto('c22',[C.POINTER(Simplex)],None); proto('c23',[C.POINTER(Simplex)],None)\nproto('c2D',[C.POINTER(Simplex)],V); proto('c2Support',[C.POINTER(V),C.c_int,V],C.c_int)\nproto('c2Witness',[C.POINTER(Simplex),C.POINTER(V),C.POINTER(V)],None)\nproto('c2L',[C.POINTER(Simplex)],V)\nproto('c2Collided',[C.c_void_p,C.c_int,C.c_void_p,C.c_int],C.c_int)\nproto('c2GJK',[C.c_void_p,C.c_int,C.POINTER(X),C.c_void_p,C.c_int,C.POINTER(X),C.POINTER(V),C.POINTER(V),C.c_int,C.POINTER(C.c_int),C.POINTER(Cache)],C.c_float)\n\ndef raw(x):\n    if isinstance(x, float): return struct.pack('=f', x)\n    if isinstance(x, int): return struct.pack('=i', x)\n    return C.string_at(C.byref(x), C.sizeof(x))\ndef same(label, x, y):\n    if raw(x) \"'!= raw(y):\n        raise AssertionError(f'\"'{label}: {raw(x).hex()} \"'!= {raw(y).hex()} ({x!r}, {y!r})'\"')\ndef clone(x): return type(x).from_buffer_copy(raw(x))\ndef rv(): return V(random.uniform(-200,200), random.uniform(-200,200))\ndef rr():\n    a=random.uniform(-math.pi,math.pi); return R(math.cos(a),math.sin(a))\ndef rx(): return X(rv(),rr())\ndef rcircle(): return Circle(rv(),random.uniform(0,30))\ndef raabb():\n    a,b=rv(),rv(); return AABB(V(min(a.x,b.x),min(a.y,b.y)),V(max(a.x,b.x),max(a.y,b.y)))\ndef rcapsule(): return Capsule(rv(),rv(),random.uniform(0,30))\ndef rsv(): return SV(rv(),rv(),rv(),random.uniform(-10,10),random.randrange(3),random.randrange(3))\ndef rsimplex(count): return Simplex(rsv(),rsv(),rsv(),rsv(),random.uniform(0.1,20),count)\n\nrandom.seed(0xC2)\n# Value-returning math and identities.\nfor i in range(2000):\n    a,b,lo,hi=rv(),rv(),rv(),rv(); scale=random.uniform(-20,20) or 1.0; rot=rr(); x=rx()\n    for name,args in [\n        ('c2V',(a.x,a.y)),('c2Mulvs',(a,scale)),('c2Maxv',(a,b)),('c2Minv',(a,b)),\n        ('c2Clampv',(a,lo,hi)),('c2Sub',(a,b)),('c2Dot',(a,b)),('c2Len',(a,)),\n        ('c2Det2',(a,b)),('c2Mulrv',(rot,a)),('c2Add',(a,b)),('c2Mulxv',(x,a)),\n        ('c2Neg',(a,)),('c2Skew',(a,)),('c2CCW90',(a,)),('c2Div',(a,scale)),\n        ('c2Norm',(a,)),('c2MulrvT',(rot,a))]:\n        same(f'{name}[{i}]',getattr(c,name)(*args),getattr(r,name)(*args))\nsame('c2RotIdentity',c.c2RotIdentity(),r.c2RotIdentity()); same('c2xIdentity',c.c2xIdentity(),r.c2xIdentity())\n\n# Pointer-mutating helpers and simplex operations.\nfor i in range(1000):\n    bb=raabb(); oa=(V*4)(); ob=(V*4)(); c.c2BBVerts(oa,C.byref(bb)); r.c2BBVerts(ob,C.byref(bb)); same(f'BBVerts[{i}]',oa,ob)\n    for typ,shape in enumerate((rcircle(),raabb(),rcapsule())):\n        pa=Proxy(); pb=Proxy(); C.memset(C.byref(pa),0x5a,C.sizeof(pa)); C.memset(C.byref(pb),0x5a,C.sizeof(pb))\n        c.c2MakeProxy(C.byref(shape),typ,C.byref(pa)); r.c2MakeProxy(C.byref(shape),typ,C.byref(pb)); same(f'MakeProxy[{i},{typ}]',pa,pb)\n    for count,name in ((2,'c22'),(3,'c23')):\n        sa=rsimplex(count); sb=clone(sa); getattr(c,name)(C.byref(sa)); getattr(r,name)(C.byref(sb)); same(f'{name}[{i}]',sa,sb)\n    for count in (0,1,2,3):\n        sa=rsimplex(count); sb=clone(sa)\n        same(f'Metric[{i},{count}]',c.c2GJKSimplexMetric(C.byref(sa)),r.c2GJKSimplexMetric(C.byref(sb)))\n        same(f'D[{i},{count}]',c.c2D(C.byref(sa)),r.c2D(C.byref(sb)))\n        same(f'L[{i},{count}]',c.c2L(C.byref(sa)),r.c2L(C.byref(sb)))\n        aa,ab,ba,bbv=V(),V(),V(),V(); c.c2Witness(C.byref(sa),C.byref(aa),C.byref(ab)); r.c2Witness(C.byref(sb),C.byref(ba),C.byref(bbv)); same(f'WitnessA[{i},{count}]',aa,ba); same(f'WitnessB[{i},{count}]',ab,bbv)\n    verts=(V*8)(*[rv() for _ in range(8)]); d=rv(); same(f'Support[{i}]',c.c2Support(verts,8,d),r.c2Support(verts,8,d))\n\n# Primitive collision APIs, generic dispatch, and GJK including cache reuse.\nshape_factories=(rcircle,raabb,rcapsule)\nfor i in range(3000):\n    circle1,circle2=rcircle(),rcircle(); box1,box2=raabb(),raabb(); cap1,cap2=rcapsule(),rcapsule()\n    for name,args in [('c2CircletoCircle',(circle1,circle2)),('c2CircletoAABB',(circle1,box1)),('c2CircletoCapsule',(circle1,cap1)),('c2AABBtoAABB',(box1,box2)),('c2AABBtoCapsule',(box1,cap1)),('c2CapsuletoCapsule',(cap1,cap2))]:\n        same(f'{name}[{i}]',getattr(c,name)(*args),getattr(r,name)(*args))\n    shapes=(circle1,box1,cap1)\n    for ta in range(3):\n        for tb in range(3):\n            same(f'Collided[{i},{ta},{tb}]',c.c2Collided(C.byref(shapes[ta]),ta,C.byref(shapes[tb]),tb),r.c2Collided(C.byref(shapes[ta]),ta,C.byref(shapes[tb]),tb))\n    ta=random.randrange(3); tb=random.randrange(3); sa=shape_factories[ta](); sb=shape_factories[tb](); xa=rx(); xb=rx()\n    ca,cb=Cache(),Cache()\n    for reuse in range(2):\n        ao,bo,ro,so=V(),V(),V(),V(); ci,ri=C.c_int(),C.c_int()\n        cd=c.c2GJK(C.byref(sa),ta,C.byref(xa),C.byref(sb),tb,C.byref(xb),C.byref(ao),C.byref(bo),1,C.byref(ci),C.byref(ca))\n        rd=r.c2GJK(C.byref(sa),ta,C.byref(xa),C.byref(sb),tb,C.byref(xb),C.byref(ro),C.byref(so),1,C.byref(ri),C.byref(cb))\n        same(f'GJKdist[{i},{reuse}]',cd,rd); same(f'GJKA[{i},{reuse}]',ao,ro); same(f'GJKB[{i},{reuse}]',bo,so); same(f'GJKiter[{i},{reuse}]',ci.value,ri.value); same(f'GJKcache[{i},{reuse}]',ca,cb)\n    x,y=random.uniform(-150,20),random.uniform(-100,130); radius=random.uniform(0,40)\n    same(f'reverse[{i}]',c.reverse_collide(x,y,radius),r.reverse_collide(x,y,radius))\n\nprint('differential verification passed: 2,000 math rounds, 1,000 simplex rounds, 3,000 collision/GJK rounds')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
