\t\td0 = d1;\r\n   450\t\t\tc2v d = c2D(&s);\r\n   451\t\t\tif (c2Dot(d, d) < 1.19209289550781250000000000000000000e-7F *\r\n   452\t\t\t\t\t1.19209289550781250000000000000000000e-7F)\r\n   453\t\t\t\tbreak;\r\n   454\t\t\tint iA = c2Support(pA.verts, pA.count, c2MulrvT(ax.r, c2Neg(d)));\r\n   455\t\t\tc2v sA = c2Mulxv(ax, pA.verts[iA]);\r\n   456\t\t\tint iB = c2Support(pB.verts, pB.count, c2MulrvT(bx.r, d));\r\n   457\t\t\tc2v sB = c2Mulxv(bx, pB.verts[iB]);\r\n   458\t\t\tc2sv *v = verts + s.count;\r\n   459\t\t\tv->iA = iA;\r\n   460\t\t\tv->sA = sA;\r\n   461\t\t\tv->iB = iB;\r\n   462\t\t\tv->sB = sB;\r\n   463\t\t\tv->p = c2Sub(v->sB, v->sA);\r\n   464\t\t\tint dup = 0;\r\n   465\t\t\tfor (int i = 0; i < save_count; ++i) {\r\n   466\t\t\t\tif (iA == saveA[i] && iB == saveB[i]) {\r\n   467\t\t\t\t\tdup = 1;\r\n   468\t\t\t\t\tbreak;\r\n   469\t\t\t\t}\r\n   470\t\t\t}\r\n   471\t\t\tif (dup)\r\n   472\t\t\t\tbreak;\r\n   473\t\t\t++s.count;\r\n   474\t\t\t++iter;\r\n   475\t\t}\r\n   476\t\tc2v a, b;\r\n   477\t\tc2Witness(&s, &a, &b);\r\n   478\t\tfloat dist = c2Len(c2Sub(a, b));\r\n   479\t\tif (hit) {\r\n   480\t\t\ta = b;\r\n   481\t\t\tdist = 0;\r\n   482\t\t} else if (use_radius) {\r\n   483\t\t\tfloat rA = pA.radius;\r\n   484\t\t\tfloat rB = pB.radius;\r\n   485\t\t\tif (dist > rA + rB &&\r\n   486\t\t\t\t\tdist > 1.19209289550781250000000000000000000e-7F) {\r\n   487\t\t\t\tdist -= rA + rB;\r\n   488\t\t\t\tc2v n = c2Norm(c2Sub(b, a));\r\n   489\t\t\t\ta = c2Add(a, c2Mulvs(n, rA));\r\n   490\t\t\t\tb = c2Sub(b, c2Mulvs(n, rB));\r\n   491\t\t\t\tif (a.x == b.x && a.y == b.y)\r\n   492\t\t\t\t\tdist = 0;\r\n   493\t\t\t} else {\r\n   494\t\t\t\tc2v p = c2Mulvs(c2Add(a, b), 0.5f);\r\n   495\t\t\t\ta = p;\r\n   496\t\t\t\tb = p;\r\n   497\t\t\t\tdist = 0;\r\n   498\t\t\t}\r\n   499\t\t}\r\n   500\t\tif (cache) {\r\n   501\t\t\tcache->metric = c2GJKSimplexMetric(&s);\r\n   502\t\t\tcache->count = s.count;\r\n   503\t\t\tfor (int i = 0; i < s.count; ++i) {\r\n   504\t\t\t\tc2sv *v = verts + i;\r\n   505\t\t\t\tcache->iA[i] = v->iA;\r\n   506\t\t\t\tcache->iB[i] = v->iB;\r\n   507\t\t\t}\r\n   508\t\t\tcache->div = s.div;\r\n   509\t\t}\r\n   510\t\tif (outA)\r\n   511\t\t\t*outA = a;\r\n   512\t\tif (outB)\r\n   513\t\t\t*outB = b;\r\n   514\t\tif (iterations)\r\n   515\t\t\t*iterations = iter;\r\n   516\t\treturn dist;\r\n   517\t}\r\n   518\t\r\n   519\tint c2AABBtoAABB(c2AABB A, c2AABB B) {\r\n   520\t\tint d0 = B.max.x < A.min.x;\r\n   521\t\tint d1 = A.max.x < B.min.x;\r\n   522\t\tint d2 = B.max.y < A.min.y;\r\n   523\t\tint d3 = A.max.y < B.min.y;\r\n   524\t\treturn !(d0 | d1 | d2 | d3);\r\n   525\t}\r\n   526\t\r\n   527\tint c2AABBtoCapsule(c2AABB A, c2Capsule B) {\r\n   528\t\tif (c2GJK(&A, C2_TYPE_AABB, 0, &B, C2_TYPE_CAPSULE, 0, 0, 0, 1, 0, 0))\r\n   529\t\t\treturn 0;\r\n   530\t\treturn 1;\r\n   531\t}\r\n   532\t\r\n   533\tint c2CapsuletoCapsule(c2Capsule A, c2Capsule B) {\r\n   534\t\tif (c2GJK(&A, C2_TYPE_CAPSULE, 0, &B, C2_TYPE_CAPSULE, 0, 0, 0, 1, 0, 0))\r\n   535\t\t\treturn 0;\r\n   536\t\treturn 1;\r\n   537\t}\r\n   538\t\r\n   539\tint c2CircletoCircle(c2Circle A, c2Circle B) {\r\n   540\t\tc2v c = c2Sub(B.p, A.p);\r\n   541\t\tfloat d2 = c2Dot(c, c);\r\n   542\t\tfloat r2 = A.r + B.r;\r\n   543\t\tr2 = r2 * r2;\r\n   544\t\treturn d2 < r2;\r\n   545\t}\r\n   546\t\r\n   547\tint c2CircletoAABB(c2Circle A, c2AABB B) {\r\n   548\t\tc2v L = c2Clampv(A.p, B.min, B.max);\r\n   549\t\tc2v ab = c2Sub(A.p, L);\r\n   550\t\tfloat d2 = c2Dot(ab, ab);\r\n   551\t\tfloat r2 = A.r * A.r;\r\n   552\t\treturn d2 < r2;\r\n   553\t}\r\n   554\t\r\n   555\tint c2CircletoCapsule(c2Circle A, c2Capsule B) {\r\n   556\t\tc2v n = c2Sub(B.b, B.a);\r\n   557\t\tc2v ap = c2Sub(A.p, B.a);\r\n   558\t\tfloat da = c2Dot(ap, n);\r\n   559\t\tfloat d2;\r\n   560\t\tif (da < 0)\r\n   561\t\t\td2 = c2Dot(ap, ap);\r\n   562\t\telse {\r\n   563\t\t\tfloat db = c2Dot(c2Sub(A.p, B.b), n);\r\n   564\t\t\tif (db < 0) {\r\n   565\t\t\t\tc2v e = c2Sub(ap, c2Mulvs(n, (da / c2Dot(n, n))));\r\n   566\t\t\t\td2 = c2Dot(e, e);\r\n   567\t\t\t} else {\r\n   568\t\t\t\tc2v bp = c2Sub(A.p, B.b);\r\n   569\t\t\t\td2 = c2Dot(bp, bp);\r\n   570\t\t\t}\r\n   571\t\t}\r\n   572\t\tfloat r = A.r + B.r;\r\n   573\t\treturn d2 < r * r;\r\n   574\t}\r\n   575\t\r\n   576\tint c2Collided(const void *A, C2_TYPE typeA, const void *B, C2_TYPE typeB) {\r\n   577\t\tswitch (typeA) {\r\n   578\t\t\tcase C2_TYPE_CIRCLE:\r\n   579\t\t\t\tswitch (typeB) {\r\n   580\t\t\t\t\tcase C2_TYPE_CIRCLE:\r\n   581\t\t\t\t\t\treturn c2CircletoCircle(*(c2Circle *)A, *(c2Circle *)B);\r\n   582\t\t\t\t\tcase C2_TYPE_AABB:\r\n   583\t\t\t\t\t\treturn c2CircletoAABB(*(c2Circle *)A, *(c2AABB *)B);\r\n   584\t\t\t\t\tcase C2_TYPE_CAPSULE:\r\n   585\t\t\t\t\t\treturn c2CircletoCapsule(*(c2Circle *)A, *(c2Capsule *)B);\r\n   586\t\t\t\t\tdefault:\r\n   587\t\t\t\t\t\treturn 0;\r\n   588\t\t\t\t}\r\n   589\t\t\t\tbreak;\r\n   590\t\t\tcase C2_TYPE_AABB:\r\n   591\t\t\t\tswitch (typeB) {\r\n   592\t\t\t\t\tcase C2_TYPE_CIRCLE:\r\n   593\t\t\t\t\t\treturn c2CircletoAABB(*(c2Circle *)B, *(c2AABB *)A);\r\n   594\t\t\t\t\tcase C2_TYPE_AABB:\r\n   595\t\t\t\t\t\treturn c2AABBtoAABB(*(c2AABB *)A, *(c2AABB *)B);\r\n   596\t\t\t\t\tcase C2_TYPE_CAPSULE:\r\n   597\t\t\t\t\t\treturn c2AABBtoCapsule(*(c2AABB *)A, *(c2Capsule *)B);\r\n   598\t\t\t\t\tdefault:\r\n   599\t\t\t\t\t\treturn 0;\r\n   600\t\t\t\t}\r\n   601\t\t\t\tbreak;\r\n   602\t\t\tcase C2_TYPE_CAPSULE:\r\n   603\t\t\t\tswitch (typeB) {\r\n   604\t\t\t\t\tcase C2_TYPE_CIRCLE:\r\n   605\t\t\t\t\t\treturn c2CircletoCapsule(*(c2Circle *)B, *(c2Capsule *)A);\r\n   606\t\t\t\t\tcase C2_TYPE_AABB:\r\n   607\t\t\t\t\t\treturn c2AABBtoCapsule(*(c2AABB *)B, *(c2Capsule *)A);\r\n   608\t\t\t\t\tcase C2_TYPE_CAPSULE:\r\n   609\t\t\t\t\t\treturn c2CapsuletoCapsule(*(c2Capsule *)A, *(c2Capsule *)B);\r\n   610\t\t\t\t\tdefault:\r\n   611\t\t\t\t\t\treturn 0;\r\n   612\t\t\t\t}\r\n   613\t\t\t\tbreak;\