,other[2]),r.c2CapsuletoCapsule(shapes[2],other[2]))\n ta,tb=random.randrange(3),random.randrange(3); xa,xb=tx(),tx(); ca,cb=Cache(),Cache()\n for reuse in range(2):\n  ao,bo,ro,so=V(),V(),V(),V(); ci,ri=C.c_int(),C.c_int(); cd=c.c2GJK(C.byref(shapes[ta]),ta,C.byref(xa),C.byref(other[tb]),tb,C.byref(xb),C.byref(ao),C.byref(bo),1,C.byref(ci),C.byref(ca)); rd=r.c2GJK(C.byref(shapes[ta]),ta,C.byref(xa),C.byref(other[tb]),tb,C.byref(xb),C.byref(ro),C.byref(so),1,C.byref(ri),C.byref(cb)); eq('GJKdist',cd,rd); eq('GJKA',ao,ro); eq('GJKB',bo,so); eq('GJKiter',ci.value,ri.value); eq('GJKcache',ca,cb)\n x,y,z=random.uniform(-200,100),random.uniform(-150,150),random.uniform(0,70); eq('reverse',c.reverse_collide(x,y,z),r.reverse_collide(x,y,z))\nprint('full differential verification passed across all 38 exports')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
