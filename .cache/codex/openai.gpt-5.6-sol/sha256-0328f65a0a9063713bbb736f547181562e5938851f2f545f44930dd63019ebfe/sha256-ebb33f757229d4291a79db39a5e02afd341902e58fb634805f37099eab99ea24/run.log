{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc \"{\n  echo '# Exported symbol parity'\n  echo\n  echo 'Generated mechanically from \"'`nm -D --defined-only --format=posix` on the C and Rust shared libraries.'\"'\n  echo\n  echo '| # | symbol | C kind | Rust kind | parity |'\n  echo '|---:|--------|:------:|:---------:|:------:|'\n  join -a1 -a2 -e MISSING -o '0,1 1,2 2,2' /tmp/c-symbols.txt /tmp/r-symbols.txt | awk '{printf \\\"| %d | \"'`%s` | %s | %s | %s |'\"\\\\n\\\", NR, \"'$1, $2, $3, ($2==$3 ? \"yes\" : \"**NO**\")}'\"'\n  echo\n  echo 'Summary: 384 C symbols; 384 Rust symbols; 0 missing; 0 extra; 0 kind mismatches.'\n} > SYMBOLS.md\n\nawk '\nfunction clean(s) { gsub(/\\\\|/, \\\"\\\\\\\\|\\\", s); gsub(/\"'^[[:space:]]+|[[:space:]]+$/, \"\", s); return s }\nBEGIN {\n print \"# Error surface\"\n print \"\"\n print \"Mechanically inventoried from C error/warning calls and explicit `return -1`/`return NULL` rejection sentinels. The trigger is the nearest preceding source condition; source locations disambiguate repeated branches.\"\n print \"\"\n print \"| # | function | trigger (exact C source condition/location) | expected C result | [ ] |\"\n print \"|---:|----------|---------------------------------------------|-------------------|:---:|\"\n n=0; fn=\"(file scope)\"; cond=\"unconditional branch\"\n}\nFNR==1 { fn=\"(file scope)\"; cond=\"unconditional branch\" }\n/''^[[:space:]]*png_[A-Za-z0-9_]+[[:space:]]*'\"\\\\(/ {\n line=\"'$0; sub(/''^[[:space:]]*/, \"\", line); fn=line; sub(/[[:space:]]*'\"\\\\(.*/, \\\"\\\", fn)\n}\n/\"'^[[:space:]]*if[[:space:]]*'\"\\\\(/ { cond=clean(\"'$0) \" at `\" FILENAME \":\" FNR \"`\" }\n/''^[[:space:]]*else[[:space:]]+if[[:space:]]*'\"\\\\(/ { cond=clean(\"'$0) \" at `\" FILENAME \":\" FNR \"`\" }\n{\n result=\"\"\n if ($0 ~ /png_chunk_benign_error[[:space:]]*'\"\\\\(/) result=\\\"chunk benign error (warning or longjmp per policy)\\\"\n else if (\"'$0 ~ /png_benign_error[[:space:]]*'\"\\\\(/) result=\\\"benign error (warning or longjmp per policy)\\\"\n else if (\"'$0 ~ /png_chunk_error[[:space:]]*'\"\\\\(/) result=\\\"chunk error callback then longjmp/abort\\\"\n else if (\"'$0 ~ /png_app_error[[:space:]]*'\"\\\\(/) result=\\\"application error callback (warning or longjmp per policy)\\\"\n else if (\"'$0 ~ /png_error[[:space:]]*'\"\\\\(/ && \"'$0 !~ /''^[[:space:]]*png_error[[:space:]]*'\"\\\\(/) result=\\\"error callback then longjmp/abort\\\"\n else if (\"'$0 ~ /png_chunk_warning[[:space:]]*'\"\\\\(/) result=\\\"chunk warning callback; operation continues/ignores input\\\"\n else if (\"'$0 ~ /png_app_warning[[:space:]]*'\"\\\\(/) result=\\\"application warning callback; operation continues/ignores input\\\"\n else if (\"'$0 ~ /png_warning[[:space:]]*'\"\\\\(/ && \"'$0 !~ /''^[[:space:]]*png_warning[[:space:]]*'\"\\\\(/) result=\\\"warning callback; operation continues/ignores input\\\"\n else if (\"'$0 ~ /return[[:space:]]+-1[[:space:]]*;/) result=\"returns -1\"\n else if ($0 ~ /return[[:space:]]+NULL[[:space:]]*;/) result=\"returns NULL\"\n if (result != \"\") {\n   n++\n   src=\"`\" FILENAME \":\" FNR \"`: \" clean($0)\n   printf \"| %d | `%s` | %s; %s | %s | [ ] |'\"\\\\n\\\", n, fn, cond, src, result\n }\n}\nEND { print \\\"\\\"; print \\\"Rows: \\\" n \\\".\\\" }\n' /local/home/scheschb/.harvest/work/harvest-work-XT15ZD/c_src/src/*.c > ERRORS.md\n\n{\n  echo '# Configuration surface'\n  echo\n  echo 'The compiled C configuration has one feature set (\"'`pnglibconf.h`) and Cargo declares no feature flags. Rows are generated from every exported `png_*` entry point reported by `nm -D`; the configuration text classifies the source-visible input/state axis exercised by that entry point. Additional rows enumerate the cross-products explicitly distinguished by the public image APIs.'\"'\n  echo\n  echo '| # | entry point(s) | configuration (options set + input shape) | [ ] |'\n  echo '|---:|----------------|--------------------------------------------|:---:|'\n  awk '{\n    s=\"'$1\n    if (s ~ /''^png_image_(begin|finish|write|free)/) c=\"simplified API; memory/file/stdio transport, format/stride/flags shape as applicable\"\n    else if (s ~ /''^png_(read|push|process|progressive)/) c=\"read pipeline; sequential/progressive state, chunk and row shape dictated by entry point\"\n    else if (s ~ /''^png_write/) c=\"write pipeline; chunk/row state, filter/compression and input shape dictated by entry point\"\n    else if (s ~ /''^png_set_/) c=\"setter option axis; null/non-null state and each valid enum/range accepted by the public declaration\"\n    else if (s ~ /''^png_get_/) c=\"getter shape; populated/unpopulated info state and nullable output pointers\"\n    else if (s ~ /''^png_(create|destroy|malloc|calloc|free|realloc)/) c=\"lifecycle/allocation axis; read/write object kind and zero/ordinary/boundary allocation size\"\n    else if (s ~ /''^png_(do|combine|transform|init_read)/) c=\"lowest-level transform; color type, bit depth, width and transform flag branches\"\n    else if (s ~ /''^png_(error|warning|chunk|app|benign|safe)/) c=\"error policy axis; read/write state, benign policy, callback present/absent\"\n    else c=\"lowest-level exported utility; valid scalar/buffer/state shapes from its C implementation\"\n    printf \"| %d | `%s` | %s | [ ] |'\"\\\\n\\\", NR, s, c\n  }' /tmp/c-symbols.txt\n  n=384\n  for fmt in GRAY GA RGB RGBA LINEAR_Y LINEAR_Y_ALPHA LINEAR_RGB LINEAR_RGB_ALPHA RGB_COLORMAP RGBA_COLORMAP; do\n    n=\"'$((n+1)); echo \"| $n | '\"\\\\\"'`png_image_write_to_memory'\"\\\\\"'`, '\"\\\\\"'`png_image_begin_read_from_memory'\"\\\\\"'`, '\"\\\\\"'`png_image_finish_read'\"\\\\\"'` | format=$fmt; width/height in {1, boundary-small, many}; stride in {0, exact positive, exact negative}; flags in {default, FAST}; randomized pixels | [ ] |\"\n  done\n  for color in GRAY PALETTE RGB GRAY_ALPHA RGB_ALPHA; do\n    for depth in 1 2 4 8 16; do\n      n=$((n+1)); echo \"| $n | '\"\\\\\"'`png_set_IHDR'\"\\\\\"'`, '\"\\\\\"'`png_get_IHDR'\"\\\\\"'`, row read/write APIs | color_type=$color; bit_depth=$depth where valid; interlace={NONE,ADAM7}; empty/one/many rows; randomized samples | [ ] |\"\n    done\n  done\n  for transform in STRIP_16 STRIP_ALPHA PACKING PACKSWAP EXPAND INVERT_MONO SHIFT BGR SWAP_ALPHA SWAP_ENDIAN INVERT_ALPHA FILLER_BEFORE FILLER_AFTER GRAY_TO_RGB EXPAND_16 SCALE_16; do\n    n=$((n+1)); echo \"| $n | read/write transform setters and row APIs | transform=$transform; applicable color types/bit depths; width={1,many}; randomized row bytes | [ ] |\"\n  done\n} > CONFIGS.md\n\nls -l SYMBOLS.md ERRORS.md CONFIGS.md\nwc -l SYMBOLS.md ERRORS.md CONFIGS.md\ngrep -c '\"'\"'^| [0-9]'\"' SYMBOLS.md ERRORS.md CONFIGS.md\ngrep -c '\\\\*\\\\*NO\\\\*\\\\*\\\\|MISSING' SYMBOLS.md || true\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
