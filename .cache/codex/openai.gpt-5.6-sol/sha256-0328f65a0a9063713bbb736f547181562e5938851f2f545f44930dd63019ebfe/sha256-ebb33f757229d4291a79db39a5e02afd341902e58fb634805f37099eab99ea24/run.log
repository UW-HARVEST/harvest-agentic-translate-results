{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/zsh -lc \"awk '\nBEGIN {\n print \\\"# Exported symbol parity\\\"\n print \\\"\\\"\n print \\\"Generated mechanically from \"'`nm -D --defined-only --format=posix` on the C and Rust shared libraries.\"\n print \"\"\n print \"| # | symbol | C kind | Rust kind | parity |\"\n print \"|---:|--------|:------:|:---------:|:------:|\"\n}\nFNR==NR { c[$1]=$2; names[$1]=1; next }\n{ r[$1]=$2; names[$1]=1 }\nEND {\n n=0; miss=0; extra=0; mismatch=0\n for (s in names) order[++n]=s\n for (i=1;i<=n;i++) for (j=i+1;j<=n;j++) if (order[i] > order[j]) { t=order[i]; order[i]=order[j]; order[j]=t }\n for (i=1;i<=n;i++) {\n   s=order[i]; ck=(s in c?c[s]:\"MISSING\"); rk=(s in r?r[s]:\"MISSING\"); ok=(ck==rk)\n   if (!(s in r)) miss++; if (!(s in c)) extra++; if ((s in c)&&(s in r)&&ck!=rk) mismatch++\n   printf \"| %d | `%s` | %s | %s | %s |'\"\\\\n\\\", i, s, ck, rk, (ok?\\\"yes\\\":\\\"**NO**\\\")\n }\n print \\\"\\\"\n printf \\\"Summary: %d C symbols; %d Rust symbols; %d missing; %d extra; %d kind mismatches.\\\\n\\\", length(c), length(r), miss, extra, mismatch\n}\n' /tmp/c-symbols.txt /tmp/r-symbols.txt > SYMBOLS.md\n\nls -l SYMBOLS.md\nwc -l SYMBOLS.md\ngrep -c '\"'^| [0-9]'\"' SYMBOLS.md\ntail -n 3 SYMBOLS.md\ngrep -Ec '\\\\*\\\\*NO\\\\*\\\\*|MISSING' SYMBOLS.md || true\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
