3\t\t\t\t*b = c2V(0, 0);\r\n   334\t\t}\r\n   335\t}\r\n   336\t\r\n   337\tc2v c2Div(c2v a, float b) {\r\n   338\t\treturn c2Mulvs(a, 1.0f / b);\r\n   339\t}\r\n   340\t\r\n   341\tc2v c2Norm(c2v a) {\r\n   342\t\treturn c2Div(a, c2Len(a));\r\n   343\t}\r\n   344\t\r\n   345\tc2v c2L(c2Simplex *s) {\r\n   346\t    float den = 1.0f / s->div;\r\n   347\t    switch (s->count) {\r\n   348\t    case 1:\r\n   349\t        return s->a.p;\r\n   350\t    case 2:\r\n   351\t        return c2Add(c2Mulvs(s->a.p, (den * s->a.u)),\r\n   352\t                     c2Mulvs(s->b.p, (den * s->b.u)));\r\n   353\t    default:\r\n   354\t        return c2V(0, 0);\r\n   355\t    }\r\n   356\t}\r\n   357\t\r\n   358\tc2v c2MulrvT(c2r a, c2v b) {\r\n   359\t    return c2V(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y);\r\n   360\t}\r\n   361\t\r\n   362\tfloat c2GJK(const void *A, C2_TYPE typeA, const c2x *ax_ptr, const void *B,\r\n   363\t\t\tC2_TYPE typeB, const c2x *bx_ptr, c2v *outA, c2v *outB,\r\n   364\t\t\tint use_radius, int *iterations, c2GJKCache *cache) {\r\n   365\t\tc2x ax;\r\n   366\t\tc2x bx;\r\n   367\t\tif (!ax_ptr)\r\n   368\t\t\tax = c2xIdentity();\r\n   369\t\telse\r\n   370\t\t\tax = *ax_ptr;\r\n   371\t\tif (!bx_ptr)\r\n   372\t\t\tbx = c2xIdentity();\r\n   373\t\telse\r\n   374\t\t\tbx = *bx_ptr;\r\n   375\t\tc2Proxy pA;\r\n   376\t\tc2Proxy pB;\r\n   377\t\tc2MakeProxy(A, typeA, &pA);\r\n   378\t\tc2MakeProxy(B, typeB, &pB);\r\n   379\t\tc2Simplex s;\r\n   380\t\tc2sv *verts = &s.a;\r\n   381\t\tint cache_was_read = 0;\r\n   382\t\tif (cache) {\r\n   383\t\t\tint cache_was_good = !!cache->count;\r\n   384\t\t\tif (cache_was_good) {\r\n   385\t\t\t\tfor (int i = 0; i < cache->count; ++i) {\r\n   386\t\t\t\t\tint iA = cache->iA[i];\r\n   387\t\t\t\t\tint iB = cache->iB[i];\r\n   388\t\t\t\t\tc2v sA = c2Mulxv(ax, pA.verts[iA]);\r\n   389\t\t\t\t\tc2v sB = c2Mulxv(bx, pB.verts[iB]);\r\n   390\t\t\t\t\tc2sv *v = verts + i;\r\n   391\t\t\t\t\tv->iA = iA;\r\n   392\t\t\t\t\tv->sA = sA;\r\n   393\t\t\t\t\tv->iB = iB;\r\n   394\t\t\t\t\tv->sB = sB;\r\n   395\t\t\t\t\tv->p = c2Sub(v->sB, v->sA);\r\n   396\t\t\t\t\tv->u = 0;\r\n   397\t\t\t\t}\r\n   398\t\t\t\ts.count = cache->count;\r\n   399\t\t\t\ts.div = cache->div;\r\n   400\t\t\t\tfloat metric_old = cache->metric;\r\n   401\t\t\t\tfloat metric = c2GJKSimplexMetric(&s);\r\n   402\t\t\t\tfloat min_metric = metric < metric_old ? metric : metric_old;\r\n   403\t\t\t\tfloat max_metric = metric > metric_old ? metric : metric_old;\r\n   404\t\t\t\tif (!(min_metric < max_metric * 2.0f && metric < -1.0e8f))\r\n   405\t\t\t\t\tcache_was_read = 1;\r\n   406\t\t\t}\r\n   407\t\t}\r\n   408\t\tif (!cache_was_read) {\r\n   409\t\t\ts.a.iA = 0;\r\n   410\t\t\ts.a.iB = 0;\r\n   411\t\t\ts.a.sA = c2Mulxv(ax, pA.verts[0]);\r\n   412\t\t\ts.a.sB = c2Mulxv(bx, pB.verts[0]);\r\n   413\t\t\ts.a.p = c2Sub(s.a.sB, s.a.sA);\r\n   414\t\t\ts.a.u = 1.0f;\r\n   415\t\t\ts.div = 1.0f;\r\n   416\t\t\ts.count = 1;\r\n   417\t\t}\r\n   418\t\tint saveA[3], saveB[3];\r\n   419\t\tint save_count = 0;\r\n   420\t\tfloat d0 = 3.40282346638528859811704183484516925e+38F;\r\n   421\t\tfloat d1 = 3.40282346638528859811704183484516925e+38F;\r\n   422\t\tint iter = 0;\r\n   423\t\tint hit = 0;\r\n   424\t\twhile (iter < 20) {\r\n   425\t\t\tsave_count = s.count;\r\n   426\t\t\tfor (int i = 0; i < save_count; ++i) {\r\n   427\t\t\t\tsaveA[i] = verts[i].iA;\r\n   428\t\t\t\tsaveB[i] = verts[i].iB;\r\n   429\t\t\t}\r\n   430\t\t\tswitch (s.count) {\r\n   431\t\t\t\tcase 1:\r\n   432\t\t\t\t\tbreak;\r\n   433\t\t\t\tcase 2:\r\n   434\t\t\t\t\tc22(&s);\r\n   435\t\t\t\t\tbreak;\r\n   436\t\t\t\tcase 3:\r\n   437\t\t\t\t\tc23(&s);\r\n   438\t\t\t\t\tbreak;\r\n   439\t\t\t}\r\n   440\t\t\tif (s.count == 3) {\r\n   441\t\t\t\thit = 1;\r\n   442\t\t\t\tbreak;\r\n   443\t\t\t}\r\n   444\t\t\tc2v p = c2L(&s);\r\n   445\t\t\td1 = c2Dot(p, p);\r\n   446\t\t\tif (d1 > d0)\r\n   447\t\t\t\tbreak;\r\n   448\t\t\td0 = d1;\r\n   449\t\t\tc2