\t    iA: c_int,\n   141\t    iB: c_int,\n   142\t}\n   143\t\n   144\t#[repr(C)]\n   145\t#[derive(Clone, Copy, Default)]\n   146\tpub struct C2Simplex {\n   147\t    a: C2sv,\n   148\t    b: C2sv,\n   149\t    c: C2sv,\n   150\t    d: C2sv,\n   151\t    div: c_float,\n   152\t    count: c_int,\n   153\t}\n   154\t\n   155\t#[unsafe(no_mangle)]\n   156\tpub extern \"C\" fn c2V(x: c_float, y: c_float) -> C2v {\n   157\t    C2v { x, y }\n   158\t}\n   159\t\n   160\t#[unsafe(no_mangle)]\n   161\tpub extern \"C\" fn c2Mulvs(mut a: C2v, b: c_float) -> C2v {\n   162\t    a.x = ordered_mul(b, a.x);\n   163\t    a.y = ordered_mul(b, a.y);\n   164\t    a\n   165\t}\n   166\t\n   167\t#[unsafe(no_mangle)]\n   168\tpub extern \"C\" fn c2Maxv(a: C2v, b: C2v) -> C2v {\n   169\t    c2V(\n   170\t        if a.x > b.x { a.x } else { b.x },\n   171\t        if a.y > b.y { a.y } else { b.y },\n   172\t    )\n   173\t}\n   174\t\n   175\t#[unsafe(no_mangle)]\n   176\tpub extern \"C\" fn c2Minv(a: C2v, b: C2v) -> C2v {\n   177\t    c2V(\n   178\t        if a.x < b.x { a.x } else { b.x },\n   179\t        if a.y < b.y { a.y } else { b.y },\n   180\t    )\n   181\t}\n   182\t\n   183\t#[unsafe(no_mangle)]\n   184\tpub extern \"C\" fn c2Clampv(a: C2v, lo: C2v, hi: C2v) -> C2v {\n   185\t    c2Maxv(lo, c2Minv(a, hi))\n   186\t}\n   187\t\n   188\t#[unsafe(no_mangle)]\n   189\tpub extern \"C\" fn c2Sub(mut a: C2v, b: C2v) -> C2v {\n   190\t    a.x -= b.x;\n   191\t    a.y -= b.y;\n   192\t    a\n   193\t}\n   194\t\n   195\t#[unsafe(no_mangle)]\n   196\tpub extern \"C\" fn c2Dot(a: C2v, b: C2v) -> c_float {\n   197\t    ordered_add(ordered_mul(a.x, b.x), ordered_mul(a.y, b.y))\n   198\t}\n   199\t\n   200\t#[unsafe(no_mangle)]\n   201\tpub extern \"C\" fn c2RotIdentity() -> C2r {\n   202\t    C2r { c: 1.0, s: 0.0 }\n   203\t}\n   204\t\n   205\t#[unsafe(no_mangle)]\n   206\tpub extern \"C\" fn c2xIdentity() -> C2x {\n   207\t    C2x {\n   208\t        p: c2V(0.0, 0.0),\n   209\t        r: c2RotIdentity(),\n   210\t    }\n   211\t}\n   212\t\n   213\t#[unsafe(no_mangle)]\n   214\tpub unsafe extern \"C\" fn c2BBVerts(out: *mut C2v, bb: *mut C2Aabb) {\n   215\t    *out.add(0) = (*bb).min;\n   216\t    *out.add(1) = c2V((*bb).max.x, (*bb).min.y);\n   217\t    *out.add(2) = (*bb).max;\n   218\t    *out.add(3) = c2V((*bb).min.x, (*bb).max.y);\n   219\t}\n   220\t\n   221\t#[unsafe(no_mangle)]\n   222\tpub unsafe extern \"C\" fn c2MakeProxy(\n   223\t    shape: *const c_void,\n   224\t    shape_type: C2Type,\n   225\t    p: *mut C2Proxy,\n   226\t) {\n   227\t    match shape_type {\n   228\t        C2_TYPE_CIRCLE => {\n   229\t            let c = shape.cast::<C2Circle>();\n   230\t            (*p).radius = (*c).r;\n   231\t            (*p).count = 1;\n   232\t            (*p).verts[0] = (*c).p;\n   233\t        }\n   234\t        C2_TYPE_AABB => {\n   235\t            (*p).radius = 0.0;\n   236\t            (*p).count = 4;\n   237\t            c2BBVerts((*p).verts.as_mut_ptr(), shape.cast_mut().cast::<C2Aabb>());\n   238\t        }\n   239\t        C2_TYPE_CAPSULE => {\n   240\t            let c = shape.cast::<C2Capsule>();\n   241\t            (*p).radius = (*c).r;\n   242\t            (*p).count = 2;\n   243\t            (*p).verts[0] = (*c).a;\n   244\t            (*p).verts[1] = (*c).b;\n   245\t        }\n   246\t        _ => {}\n   247\t    }\n   248\t}\n   249\t\n   250\t#[unsafe(no_mangle)]\n   251\tpub extern \"C\" fn c2Len(a: C2v) -> c_float {\n   252\t    c2Dot(a, a).sqrt()\n   253\t}\n   254\t\n   255\t#[unsafe(no_mangle)]\n   256\tpub extern \"C\" fn c2Det2(a: C2v, b: C2v) -> c_float {\n   257\t    ordered_sub(ordered_mul(a.x, b.y), ordered_mul(a.y, b.x))\n   258\t}\n   259\t\n   260\t#[unsafe(no_mangle)]\n   261\tpub unsafe extern \"C\" fn c2GJKSimplexMetric(s: *mut C2Simplex) -> c_float {\n   262\t    match (*s).count {\n   263\t        2 => c2Len(c2Sub((*s).b.p, (*s).a.p)),\n   264\t        3 => c2Det2(c2Sub((*s).b.p, (*s).a.p), c2Sub((*s).c.p, (*s).a.p)),\n   265\t        _ => 0.0,\n   266\t    }\n   267\t}\n   268\t\n   269\t#[unsafe(no_mangle)]\n   270\tpub extern \"C\" fn c2Mulrv(a: C2r, b: C2v) -> C2v {\n   271\t    c2V(\n   272\t        ordered_sub(ordered_mul(a.c, b.x), ordered_mul(a.s, b.y)),\n   273\t        ordered_add(ordered_mul(a.c, b.y), ordered_mul(a.s, b.x)),\n   274\t    )\n   275\t}\n   276\t\n   277\t#[unsafe(no_mangle)]\n   278\tpub extern \"C\" fn c2Add(mut a: C2v, b: C2v) -> C2v {\n   279\t    a.x += b.x;\n   280\t    a.y += b.y;\n   281\t    a\n   282\t}\n   283\t\n   284\t#[unsafe(no_mangle)]\n   285\tpub extern \"C\" fn c2Mulxv(a: C2x, b: C2v) -> C2v {\n   286\t    c2Add(c2Mulrv(a.r, b), a.p)\n   287\t}\n   288\t\n   289\t#[unsafe(no_mangle)]\n   290\tpub unsafe extern \"C\" fn c22(s: *mut C2Simplex) {\n   291\t    let a = (*s).a.p;\n   292\t    let b = (*s).b.p;\n   293\t    let u = c2Dot(b, c2Sub(b, a));\n   294\t    let v = c2Dot(a, c2Sub(a, b));\n   295\t    if v <= 0.0 {\n   296\t        (*s).a.u = 1.0;\n   297\t        (*s).div = 1.0;\n   298\t        (*s).count = 1;\n   299\t    } else if u <= 0.0 {\n   300\t        (*s).a = (*s).b;\n   301\t        (*s).a.u = 1.0;\n   302\t        (*s).div = 1.0;\n   303\t        (*s).count = 1;\n   304\t    } else {\n   305\t        (*s).a.u = u;\n   306\t        (*s).b.u = v;\n   307\t        (*s).div = u + v;\n   308\t        (*s).count = 2;\n   309\t    }\n   310\t}\n   311\t\n   312\t#[unsafe(no_mangle)]\n   313\tpub unsafe extern \"C\" fn c23(s: *mut C2Simplex) {\n   314\t    let a = (*s).a.p;\n   315\t    let b = (*s).b.p;\n   316\t    let c = (*s).c.p;\n   317\t    let uAB = c2Dot(b, c2Sub(b, a));\n   318\t    let vAB = c2Dot(a, c2Sub(a, b));\n   319\t    let uBC = c2Dot(c, c2Sub(c, b));\n   320\t    let vBC = c2Dot(b, c2Sub(b, c));\n   321\t    let uCA = c2Dot(a, c2Sub(a, c));\n   322\t    let vCA = c2Dot(c, c2Sub(c, a));\n   323\t    let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n   324\t    let uABC = c2Det2(b, c) * area;\n   325\t    let vABC = c2Det2(c, a) * area;\n   326\t    let wABC = c2Det2(a, b) * area;\n   327\t    if vAB <= 0.0 && uCA <= 0.0 {\n   328\t        (*s).a.u = 1.0;\n   329\t        (*s).div = 1.0;\n   330\t        (*s).count = 1;\n   331\t    } else if uAB <= 0.0 && vBC <= 0.0 {\n   332\t        (*s).a = (*s).b;\n   333\t        (*s).a.u = 1.0;\n   334\t        (*s).div = 1.0;\n   335\t        (*s).count = 1;\n   336\t    } else if uBC <= 0.0 && vCA <= 0.0 {\n   337\t        (*s).a = (*s).c;\n   338\t        (*s).a.u = 1.0;\n   339\t        (*s).div = 1.0;\n   340\t        (*s).count = 1;\n   341\t    } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n   342\t        (*s).a.u = uAB;\n   343\t        (*s).b.u = vAB;\n   344\t        (*s).div = uAB + vAB;\n   345\t        (*s).count = 2;\n   346\t    } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n   347\t        (*s).a = (*s).b;\n   348\t        (*s).b = (*s).c;\n   349\t        (*s).a.u = uBC;\n   350\t        (*s).b.u = vBC;\n   351\t        (*s).div = uBC + vBC;\n   352\t        (*s).count = 2;\n   353\t    } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n   354\t        (*s).b = (*s).a;\n   355\t        (*s).a = (*s).c;\n   356\t        (*s).a.u = uCA;\n   357\t        (*s).b.u = vCA;\n   358\t        (*s).div = uCA + vCA;\n   359\t        (*s).count = 2;\n   360\t    } else {\n   361\t        (*s).a.u = uABC;\n   362\t        (*s).b.u = vABC;\n   363\t        (*s).c.u = wABC;\n   364\t        (*s).div = uABC + vABC + wABC;\n   365\t        (*s).count = 3;\n   366\t    }\n   367\t}\n   368\t\n   369\t#[unsafe(no_mangle)]\n   370\tpub extern \"C\" fn c2Neg(a: C2v) -> C2v {\n   371\t    c2V(-a.x, -a.y)\n   372\t}\n   373\t\n   374\t#[unsafe(no_mangle)]\n   375\tpub extern \"C\" fn c2Skew(a: C2v) -> C2v {\n   376\t    C2v { x: -a.y, y: a.x }\n   377\t}\n   378\t\n   379\t#[unsafe(no_mangle)]\n   380\tpub extern \"C\" fn c2CCW90(a: C2v) -> C2v {\n   381\t    C2v { x: a.y, y: -a.x }\n   382\t}\n   383\t\n   384\t#[unsafe(no_mangle)]\n   385\tpub unsafe extern \"C\" fn c2D(s: *mut C2Simplex) -> C2v {\n   386\t    match (*s).count {\n   387\t        1 => c2Neg((*s).a.p),\n   388\t        2 => {\n   389\t            let ab = c2Sub((*s).b.p, (*s).a.p);\n   390\t            if c2Det2(ab, c2Neg((*s).a.p)) > 0.0 {\n   391\t                c2Skew(ab)\n   392\t            } else {\n   393\t                c2CCW90(ab)\n   394\t            }\n   395\t        }\n   396\t        _ => c2V(0.0, 0.0),\n   397\t    }\n   398\t}\n   399\t\n   400\t#[unsafe(no_mangle)]\n   401\tpub unsafe extern \"C\" fn c2Support(\n   402\t    verts: *const C2v,\n   403\t    count: c_int,\n   404\t    d: C2v,\n   405\t) -> c_int {\n   406\t    let mut imax = 0;\n   407\t    let mut dmax = c2Dot(*verts, d);\n   408\t    for i in 1..count {\n   409\t        let dot = c2Dot(*verts.add(i as usize), d);\n   410\t        if dot > dmax {\n   411\t            imax = i;\n   412\t            dmax = dot;\n   413\t        }\n   414\t    }\n   415\t    imax\n   416\t}\n   417\t\n   418\t#[unsafe(no_mangle)]\n   419\tpub unsafe extern \"C\" fn c2Witness(s: *mut C2Simplex, a: *mut C2v, b: *mut C2v) {\n   420\t    let den = 1.0 / (*s).div;\n   421\t    match (*s).count {\n   422\t        1 => {\n   423\t            *a = (*s).a.sA;\n   424\t            *b = (*s).a.sB;\n   425\t        }\n   426\t        2 => {\n   427\t            *a = c2Add(\n   428\t                c2Mulvs((*s).a.sA, den * (*s).a.u),\n   429\t                c2Mulvs((*s).b.sA, den * (*s).b.u),\n   430\t            );\n   431\t            *b = c2Add(\n   432\t                c2Mulvs((*s).a.sB, den * (*s).a.u),\n   433\t                c2Mulvs((*s).b.sB, den * (*s).b.u),\n   434\t            );\n   435\t        }\n   436\t        3 => {\n   437\t            *a = c2Add(\n   438\t                c2Add(\n   439\t                    c2Mulvs((*s).a.sA, den * (*s).a.u),\n   440\t                    c2Mulvs((*s).b.sA, den * (*s).b.u),\n   441\t                ),\n   442\t                c2Mulvs((*s).c.sA, den * (*s).c.u),\n   443\t            );\n   444\t            *b = c2Add(\n   445\t                c2Add(\n   446\t                    c2Mulvs((*s).a.sB, den * (*s).a.u),\n   447\t                    c2Mulvs((*s).b.sB, den * (*s).b.u),\n   448\t                ),\n   449\t                c2Mulvs((*s).c.sB, den * (*s).c.u),\n   450\t            );\n   451\t        }\n   452\t        _ => {\n   453\t            *a = c2V(0.0, 0.0);\n   454\t            *b = c2V(0.0, 0.0);\n   455\t        }\n   456\t    }\n   457\t}\n   458\t\n   459\t#[unsafe(no_mangle)]\n   460\tpub extern \"C\" fn c2Div(a: C2v, b: c_float) -> C2v {\n   461\t    c2Mulvs(a, 1.0 / b)\n   462\t}\n   463\t\n   464\t#[unsafe(no_mangle)]\n   465\tpub extern \"C\" fn c2Norm(a: C2v) -> C2v {\n   466\t    c2Div(a, c2Len(a))\n   467\t}\n   468\t\n   469\t#[unsafe(no_mangle)]\n   470\tpub unsafe extern \"C\" fn c2L(s: *mut C2Simplex) -> C2v {\n   471\t    let den = 1.0 / (*s).div;\n   472\t    match (*s).count {\n   473\t        1 => (*s).a.p,\n   474\t        2 => c2Add(\n   475\t            c2Mulvs((*s).a.p, den * (*s).a.u),\n   476\t            c2Mulvs((*s).b.p, den * (*s).b.u),\n   477\t        ),\n   478\t        _ => c2V(0.0, 0.0),\n   479\t    }\n   480\t}\n   481\t\n   482\t#[unsafe(no_mangle)]\n   483\tpub extern \"C\" fn c2MulrvT(a: C2r, b: C2v) -> C2v {\n   484\t    c2V(\n   485\t        ordered_add(ordered_mul(a.c, b.x), ordered_mul(a.s, b.y)),\n   486\t        ordered_sub(ordered_mul(a.c, b.y), ordered_mul(a.s, b.x)),\n   487\t    )\n   488\t}\n   489\t\n   490\t#[unsafe(no_mangle)]\n   491\tpub unsafe extern \"C\" fn c2GJK(\n   492\t    A: *const c_void,\n   493\t    typeA: C2Type,\n   494\t    ax_ptr: *const C2x,\n   495\t    B: *const c_void,\n   496\t    typeB: C2Type,\n   497\t    bx_ptr: *const C2x,\n   498\t    outA: *mut C2v,\n   499\t    outB: *mut C2v,\n   500\t    use_radius: c_int,\n   501\t    iterations: *mut c_int,\n   502\t    cache: *mut C2GjkCache,\n   503\t) -> c_float {\n   504\t    let ax = if ax_ptr.is_null() {\n   505\t        c2xIdentity()\n   506\t    } else {\n   507\t        *ax_ptr\n   508\t    };\n   509\t    let bx = if bx_ptr.is_null() {\n   510\t        c2xIdentity()\n   511\t    } else {\n   512\t        *bx_ptr\n   513\t    };\n   514\t\n   515\t    let mut pA = C2Proxy::default();\n   516\t    let mut pB = C2Proxy::default();\n   517\t    c2MakeProxy(A, typeA, &mut pA);\n   518\t    c2MakeProxy(B, typeB, &mut pB);\n   519\t\n   520\t    let mut s = C2Simplex::default();\n   521\t    let verts = std::ptr::addr_of_mut!(s.a);\n   522\t    let mut cache_was_read = 0;\n   523\t    if !cache.is_null() {\n   524\t        let cache_was_good = ((*cache).count != 0) as c_int;\n   525\t        if cache_was_good != 0 {\n   526\t            for i in 0..(*cache).count {\n   527\t                let iA = (*cache).iA[i as usize];\n   528\t                let iB = (*cache).iB[i as usize];\n   529\t                let sA = c2Mulxv(ax, pA.verts[iA as usize]);\n   530\t                let sB = c2Mulxv(bx, pB.verts[iB as usize]);\n   531\t                let v = verts.add(i as usize);\n   532\t                (*v).iA = iA;\n   533\t                (*v).sA = sA;\n   534\t                (*v).iB = iB;\n   535\t                (*v).sB = sB;\n   536\t                (*v).p = c2Sub((*v).sB, (*v).sA);\n   537\t                (*v).u = 0.0;\n   538\t            }\n   539\t            s.count = (*cache).count;\n   540\t            s.div = (*cache).div;\n   541\t            let metric_old = (*cache).metric;\n   542\t            let metric = c2GJKSimplexMetric(&mut s);\n   543\t            let min_metric = if metric < metric_old {\n   544\t                metric\n   545\t            } else {\n   546\t                metric_old\n   547\t            };\n   548\t            let max_metric = if metric > metric_old {\n   549\t                metric\n   550\t            } else {\n   551\t                metric_old\n   552\t            };\n   553\t            if !(min_metric < max_metric * 2.0 && metric < -1.0e8) {\n   554\t                cache_was_read = 1;\n   555\t            }\n   556\t        }\n   557\t    }\n   558\t    if cache_was_read == 0 {\n   559\t        s.a.iA = 0;\n   560\t        s.a.iB = 0;\n   561\t        s.a.sA = c2Mulxv(ax, pA.verts[0]);\n   562\t        s.a.sB = c2Mulxv(bx, pB.verts[0]);\n   563\t        s.a.p = c2Sub(s.a.sB, s.a.sA);\n   564\t        s.a.u = 1.0;\n   565\t        s.div = 1.0;\n   566\t        s.count = 1;\n   567\t    }\n   568\t\n   569\t    let mut saveA = [0; 3];\n   570\t    let mut saveB = [0; 3];\n   571\t    let mut d0 = c_float::MAX;\n   572\t    let mut iter = 0;\n   573\t    let mut hit = 0;\n   574\t    while iter < 20 {\n   575\t        let save_count = s.count;\n   576\t        for i in 0..save_count {\n   577\t            saveA[i as usize] = (*verts.add(i as usize)).iA;\n   578\t            saveB[i as usize] = (*verts.add(i as usize)).iB;\n   579\t        }\n   580\t        match s.count {\n   581\t            1 => {}\n   582\t            2 => c22(&mut s),\n   583\t            3 => c23(&mut s),\n   584\t            _ => {}\n   585\t        }\n   586\t        if s.count == 3 {\n   587\t            hit = 1;\n   588\t            break;\n   589\t        }\n   590\t        let p = c2L(&mut s);\n   591\t        let d1 = c2Dot(p, p);\n   592\t        if d1 > d0 {\n   593\t            break;\n   594\t        }\n   595\t        d0 = d1;\n   596\t        let d = c2D(&mut s);\n   597\t        if c2Dot(d, d) < c_float::EPSILON * c_float::EPSILON {\n   598\t            break;\n   599\t        }\n   600\t        let iA = c2Support(\n   601\t            pA.verts.as_ptr(),\n   602\t            pA.count,\n   603\t            c2MulrvT(ax.r, c2Neg(d)),\n   604\t        );\n   605\t        let sA = c2Mulxv(ax, pA.verts[iA as usize]);\n   606\t        let iB = c2Support(pB.verts.as_ptr(), pB.count, c2MulrvT(bx.r, d));\n   607\t        let sB = c2Mulxv(bx, pB.verts[iB as usize]);\n   608\t        let v = verts.add(s.count as usize);\n   609\t        (*v).iA = iA;\n   610\t        (*v).sA = sA;\n   611\t        (*v).iB = iB;\n   612\t        (*v).sB = sB;\n   613\t        (*v).p = c2Sub((*v).sB, (*v).sA);\n   614\t        let mut dup = 0;\n   615\t        for i in 0..save_count {\n   616\t            if iA == saveA[i as usize] && iB == saveB[i as usize] {\n   617\t                dup = 1;\n   618\t                break;\n   619\t            }\n   620\t        }\n   621\t        if dup != 0 {\n   622\t            break;\n   623\t        }\n   624\t        s.count += 1;\n   625\t        iter += 1;\n   626\t    }\n   627\t\n   628\t    let mut a = C2v::default();\n   629\t    let mut b = C2v::default();\n   630\t    c2Witness(&mut s, &mut a, &mut b);\n   631\t    let mut dist = c2Len(c2Sub(a, b));\n   632\t    if hit != 0 {\n   633\t        a = b;\n   634\t        dist = 0.0;\n   635\t    } else if use_radius != 0 {\n   636\t        let rA = pA.radius;\n   637\t        let rB = pB.radius;\n   638\t        if dist > rA + rB && dist > c_float::EPSILON {\n   639\t            dist -= rA + rB;\n   640\t            let n = c2Norm(c2Sub(b, a));\n   641\t            a = c2Add(a, c2Mulvs(n, rA));\n   642\t            b = c2Sub(b, c2Mulvs(n, rB));\n   643\t            if a.x == b.x && a.y == b.y {\n   644\t                dist = 0.0;\n   645\t            }\n   646\t        } else {\n   647\t            let p = c2Mulvs(c2Add(a, b), 0.5);\n   648\t            a = p;\n   649\t            b = p;\n   650\t            dist = 0.0;\n   651\t        }\n   652\t    }\n   653\t    if !cache.is_null() {\n   654\t        (*cache).metric = c2GJKSimplexMetric(&mut s);\n   655\t        (*cache).count = s.count;\n   656\t        for i in 0..s.count {\n   657\t            let v = verts.add(i as usize);\n   658\t            (*cache).iA[i as usize] = (*v).iA;\n   659\t            (*cache).iB[i as usize] = (*v).iB;\n   660\t        }\n   661\t        (*cache).div = s.div;\n   662\t    }\n   663\t    if !outA.is_null() {\n   664\t        *outA = a;\n   665\t    }\n   666\t    if !outB.is_null() {\n   667\t        *outB = b;\n   668\t    }\n   669\t    if !iterations.is_null() {\n   670\t        *iterations = iter;\n   671\t    }\n   672\t    dist\n   673\t}\n   674\t\n   675\t#[unsafe(no_mangle)]\n   676\tpub extern \"C\" fn c2AABBtoAABB(A: C2Aabb, B: C2Aabb) -> c_int {\n   677\t    let d0 = (B.max.x < A.min.x) as c_int;\n   678\t    let d1 = (A.max.x < B.min.x) as c_int;\n   679\t    let d2 = (B.max.y < A.min.y) as c_int;\n   680\t    let d3 = (A.max.y < B.min.y) as c_int;\n   681\t    ((d0 | d1 | d2 | d3) == 0) as c_int\n   682\t}\n   683\t\n   684\t#[unsafe(no_mangle)]\n   685\tpub extern \"C\" fn c2AABBtoCapsule(A: C2Aabb, B: C2Capsule) -> c_int {\n   686\t    let distance = unsafe {\n   687\t        c2GJK(\n   688\t            std::ptr::addr_of!(A).cast(),\n   689\t            C2_TYPE_AABB,\n   690\t            std::ptr::null(),\n   691\t            std::ptr::addr_of!(B).cast(),\n   692\t            C2_TYPE_CAPSULE,\n   693\t            std::ptr::null(),\n   694\t            std::ptr::null_mut(),\n   695\t            std::ptr::null_mut(),\n   696\t            1,\n   697\t            std::ptr::null_mut(),\n   698\t            std::ptr::null_mut(),\n   699\t        )\n   700\t    };\n   701\t    (distance == 0.0) as c_int\n   702\t}\n   703\t\n   704\t#[unsafe(no_mangle)]\n   705\tpub extern \"C\" fn c2CapsuletoCapsule(A: C2Capsule, B: C2Capsule) -> c_int {\n   706\t    let distance = unsafe {\n   707\t        c2GJK(\n   708\t            std::ptr::addr_of!(A).cast(),\n   709\t            C2_TYPE_CAPSULE,\n   710\t            std::ptr::null(),\n   711\t            std::ptr::addr_of!(B).cast(),\n   712\t            C2_TYPE_CAPSULE,\n   713\t            std::ptr::null(),\n   714\t            std::ptr::null_mut(),\n   715\t            std::ptr::null_mut(),\n   716\t            1,\n   717\t            std::p