tf(\"Error: Variable '%s' not found\\n\", args[0]);\n   365\t}\n   366\t\n   367\tvoid cmd_unset(char args[][MAX_COMMAND], int arg_count) {\n   368\t    if (arg_count < 1) {\n   369\t        printf(\"Usage: unset <name>\\n\");\n   370\t        return;\n   371\t    }\n   372\t    \n   373\t    for (int i = 0; i < variable_count; i++) {\n   374\t        if (strcmp(variables[i].name, args[0]) == 0) {\n   375\t            for (int j = i; j < variable_count - 1; j++) {\n   376\t                variables[j] = variables[j + 1];\n   377\t            }\n   378\t            variable_count--;\n   379\t            printf(\"Variable '%s' unset\\n\", args[0]);\n   380\t            return;\n   381\t        }\n   382\t    }\n   383\t    \n   384\t    printf(\"Error: Variable '%s' not found\\n\", args[0]);\n   385\t}\n   386\t\n   387\tvoid cmd_listvars(void) {\n   388\t    if (variable_count == 0) {\n   389\t        printf(\"No variables set\\n\");\n   390\t        return;\n   391\t    }\n   392\t    \n   393\t    printf(\"Variables:\\n\");\n   394\t    for (int i = 0; i < variable_count; i++) {\n   395\t        printf(\"  %s = %s\\n\", variables[i].name, variables[i].value);\n   396\t    }\n   397\t}\n   398\t\n   399\t// String comparison commands\n   400\tvoid cmd_compare(char args[][MAX_COMMAND], int arg_count) {\n   401\t    if (arg_count < 2) {\n   402\t        printf(\"Usage: compare <string1> <string2>\\n\");\n   403\t        return;\n   404\t    }\n   405\t    \n   406\t    int result = strcmp(args[0], args[1]);\n   407\t    \n   408\t    printf(\"strcmp('%s', '%s') = %d\\n\", args[0], args[1], result);\n   409\t    \n   410\t    if (result == 0) {\n   411\t        printf(\"Strings are equal\\n\");\n   412\t    } else if (result < 0) {\n   413\t        printf(\"'%s' < '%s'\\n\", args[0], args[1]);\n   414\t    } else {\n   415\t        printf(\"'%s' > '%s'\\n\", args[0], args[1]);\n   416\t    }\n   417\t}\n   418\t\n   419\tvoid cmd_compareN(char args[][MAX_COMMAND], int arg_count) {\n   420\t    if (arg_count < 3) {\n   421\t        printf(\"Usage: compareN <string1> <string2> <n>\\n\");\n   422\t        return;\n   423\t    }\n   424\t    \n   425\t    int n = atoi(args[2]);\n   426\t    int result = strncmp(args[0], args[1], n);\n   427\t    \n   428\t    printf(\"strncmp('%s', '%s', %d) = %d\\n\", args[0], args[1], n, result);\n   429\t    \n   430\t    if (result == 0) {\n   431\t        printf(\"First %d characters are equal\\n\", n);\n   432\t    } else if (result < 0) {\n   433\t        printf(\"'%s' < '%s' (first %d chars)\\n\", args[0], args[1], n);\n   434\t    } else {\n   435\t        printf(\"'%s' > '%s' (first %d chars)\\n\", args[0], args[1], n);\n   436\t    }\n   437\t}\n   438\t\n   439\tvoid cmd_startswith(char args[][MAX_COMMAND], int arg_count) {\n   440\t    if (arg_count < 2) {\n   441\t        printf(\"Usage: startswith <string> <prefix>\\n\");\n   442\t        return;\n   443\t    }\n   444\t    \n   445\t    size_t prefix_len = strlen(args[1]);\n   446\t    \n   447\t    if (strncmp(args[0], args[1], prefix_len) == 0) {\n   448\t        printf(\"'%s' starts with '%s'\\n\", args[0], args[1]);\n   449\t    } else {\n   450\t        printf(\"'%s' does not start with '%s'\\n\", args[0], args[1]);\n   451\t    }\n   452\t}\n   453\t\n   454\tvoid cmd_match(char args[][MAX_COMMAND], int arg_count) {\n   455\t    if (arg_count < 2) {\n   456\t        printf(\"Usage: match <pattern> <string1> [string2] ...\\n\");\n   457\t        return;\n   458\t    }\n   459\t    \n   460\t    printf(\"Matching pattern '%s':\\n\", args[0]);\n   461\t    int matches = 0;\n   462\t    \n   463\t    for (int i = 1; i < arg_count; i++) {\n   464\t        if (strcmp(args[0], args[i]) == 0) {\n   465\t            printf(\"  '%s' - EXACT MATCH\\n\", args[i]);\n   466\t            matches++;\n   467\t        } else if (strstr(args[i], args[0]) != NULL) {\n   468\t            printf(\"  '%s' - contains pattern\\n\", args[i]);\n   469\t            matches++;\n   470\t        } else {\n   471\t            printf(\"  '%s' - no match\\n\", args[i]);\n   472\t        }\n   473\t    }\n   474\t    \n   475\t    printf(\"Total matches: %d\\n\", matches);\n   476\t}\n   477\t\n   478\t// System commands\n   479\tvoid cmd_help(void) {\n   480\t    printf(\"\\n=== Command Interpreter Help ===\\n\");\n   481\t    printf(\"User Management:\\n\");\n   482\t    printf(\"  adduser <user> <pass> [level] - Add new user\\n\");\n   483\t    printf(\"  login <user> <pass>            - Login as user\\n\");\n   484\t    printf(\"  logout                         - Logout current user\\n\");\n   485\t    printf(\"  whoami                         - Show current user\\n\");\n   486\t    printf(\"  listusers                      - List all users\\n\");\n   487\t    printf(\"\\nFile Management:\\n\");\n   488\t    printf(\"  createfile <name> [content]    - Create file\\n\");\n   489\t    printf(\"  readfile <name>                - Read file\\n\");\n   490\t    printf(\"  writefile <name> <content>     - Write to file\\n\");\n   491\t    printf(\"  deletefile <name>              - Delete file\\n\");\n   492\t    printf(\"  listfiles                      - List all files\\n\");\n   493\t    printf(\"\\nVariable Management:\\n\");\n   494\t    printf(\"  set <name> <value>             - Set variable\\n\");\n   495\t    printf(\"  get <name>                     - Get variable\\n\");\n   496\t    printf(\"  unset <name>                   - Unset variable\\n\");\n   497\t    printf(\"  listvars                       - List all variables\\n\");\n   498\t    printf(\"\\nString Operations:\\n\");\n   499\t    printf(\"  compare <str1> <str2>          - Compare strings\\n\");\n   500\t    printf(\"  compareN <str1> <str2> <n>     - Compare first N chars\\n\");\n   501\t    printf(\"  startswith <str> <prefix>      - Check if starts with\\n\");\n   502\t    printf(\"  match <pattern> <str> ...      - Match pattern\\n\");\n   503\t    printf(\"\\nSystem:\\n\");\n   504\t    printf(\"  debug [on|off]                 - Toggle debug mode\\n\");\n   505\t    printf(\"  verbose [on|off]               - Toggle verbose mode\\n\");\n   506\t    printf(\"  status                         - Show system status\\n\");\n   507\t    printf(\"  time                           - Show current time\\n\");\n   508\t    printf(\"  help                           - Show this help\\n\");\n   509\t    printf(\"  exit                           - Exit program\\n\");\n   510\t}\n   511\t\n   512\tvoid cmd_debug(char args[][MAX_COMMAND], int arg_count) {\n   513\t    if (arg_count < 1) {\n   514\t        printf(\"Debug mode: %s\\n\", debug_mode ? \"ON\" : \"OFF\");\n   515\t        return;\n   516\t    }\n   517\t    \n   518\t    if (strcmp(args[0], \"on\") == 0) {\n   519\t        debug_mode = 1;\n   520\t        printf(\"Debug mode enabled\\n\");\n   521\t    } else if (strcmp(args[0], \"off\") == 0) {\n   522\t        debug_mode = 0;\n   523\t        printf(\"Debug mode disabled\\n\");\n   524\t    } else {\n   525\t        printf(\"Usage: debug [on|off]\\n\");\n   526\t    }\n   527\t}\n   528\t\n   529\tvoid cmd_verbose(char args[][MAX_COMMAND], int arg_count) {\n   530\t    if (arg_count < 1) {\n   531\t        printf(\"Verbose mode: %s\\n\", verbose_mode ? \"ON\" : \"OFF\");\n   532\t        return;\n   533\t    }\n   534\t    \n   535\t    if (strcmp(args[0], \"on\") == 0) {\n   536\t        verbose_mode = 1;\n   537\t        printf(\"Verbose mode enabled\\n\");\n   538\t    } else if (strcmp(args[0], \"off\") == 0) {\n   539\t        verbose_mode = 0;\n   540\t        printf(\"Verbose mode disabled\\n\");\n   541\t    } else {\n   542\t        printf(\"Usage: verbose [on|off]\\n\");\n   543\t    }\n   544\t}\n   545\t\n   546\tvoid cmd_status(void) {\n   547\t    printf(\"\\n=== System Status ===\\n\");\n   548\t    printf(\"Users: %d/%d\\n\", user_count, MAX_USERS);\n   549\t    printf(\"Files: %d/%d\\n\", file_count, MAX_FILES);\n   550\t    printf(\"Variables: %d/%d\\n\", variable_count, MAX_VARIABLES);\n   551\t    printf(\"Current user: %s\\n\", \n   552\t           (current_user && current_user->logged_in) ? current_user->name : \"none\");\n   553\t    printf(\"Debug mode: %s\\n\", debug_mode ? \"ON\" : \"OFF\");\n   554\t    printf(\"Verbose mode: %s\\n\", verbose_mode ? \"ON\" : \"OFF\");\n   555\t}\n   556\t\n   557\tvoid cmd_time(void) {\n   558\t    time_t now = time(NULL);\n   559\t    printf(\"Current time: %s\", ctime(&now));\n   560\t}\n   561\t\n   562\t// Main command processor using extensive strcmp/strncmp\n   563\tvoid process_command(const char *input) {\n   564\t    char command[MAX_COMMAND];\n   565\t    char args[MAX_ARGS][MAX_COMMAND];\n   566\t    int arg_count = 0;\n   567\t    \n   568\t    parse_command(input, command, args, &arg_count);\n   569\t    \n   570\t    if (strlen(command) == 0) {\n   571\t        return;\n   572\t    }\n   573\t    \n   574\t    if (debug_mode) {\n   575\t        printf(\"[DEBUG] Command: '%s', Args: %d\\n\", command, arg_count);\n   576\t    }\n   577\t    \n   578\t    // Command routing using strcmp and strncmp\n   579\t    // User commands\n   580\t    if (strcmp(command, \"adduser\") == 0) {\n   581\t        cmd_adduser(args, arg_count);\n   582\t    } else if (strcmp(command, \"login\") == 0) {\n   583\t        cmd_login(args, arg_count);\n   584\t    } else if (strcmp(command, \"logout\") == 0) {\n   585\t        cmd_logout();\n   586\t    } else if (strcmp(command, \"whoami\") == 0) {\n   587\t        cmd_whoami();\n   588\t    } else if (strcmp(command, \"listusers\") == 0 || strcmp(command, \"users\") == 0) {\n   589\t        cmd_listusers();\n   590\t    }\n   591\t    // File commands\n   592\t    else if (strcmp(command, \"createfile\") == 0 || strcmp(command, \"touch\") == 0) {\n   593\t        cmd_createfile(args, arg_count);\n   594\t    } else if (strcmp(command, \"readfile\") == 0 || strcmp(command, \"cat\") == 0) {\n   595\t        cmd_readfile(args, arg_count);\n   596\t    } else if (strcmp(command, \"writefile\") == 0 || strcmp(command, \"write\") == 0) {\n   597\t        cmd_writefile(args, arg_count);\n   598\t    } else if (strcmp(command, \"deletefile\") == 0 || strcmp(command, \"rm\") == 0) {\n   599\t        cmd_deletefile(args, arg_count);\n   600\t    } else if (strcmp(command, \"listfiles\") == 0 || strcmp(command, \"ls\") == 0) {\n   601\t        cmd_listfiles();\n   602\t    }\n   603\t    // Variable commands\n   604\t    else if (strcmp(command, \"set\") == 0) {\n   605\t        cmd_set(args, arg_count);\n   606\t    } else if (strcmp(command, \"get\") == 0) {\n   607\t        cmd_get(args, arg_count);\n   608\t    } else if (strcmp(command, \"unset\") == 0) {\n   609\t        cmd_unset(args, arg_count);\n   610\t    } else if (strcmp(command, \"listvars\") == 0 || strcmp(command, \"vars\") == 0) {\n   611\t        cmd_listvars();\n   612\t    }\n   613\t    // String comparison commands\n   614\t    else if (strcmp(command, \"compare\") == 0 || strcmp(command, \"cmp\") == 0) {\n   615\t        cmd_compare(args, arg_count);\n   616\t    } else if (strcmp(command, \"compareN\") == 0 || strcmp(command, \"cmpn\") == 0) {\n   617\t        cmd_compareN(args, arg_count);\n   618\t    } else if (strcmp(command, \"startswith\") == 0) {\n   619\t        cmd_startswith(args, arg_count);\n   620\t    } else if (strcmp(command, \"match\") == 0) {\n   621\t        cmd_match(args, arg_count);\n   622\t    }\n   623\t    // System commands\n   624\t    else if (strcmp(command, \"debug\") == 0) {\n   625\t        cmd_debug(args, arg_count);\n   626\t    } else if (strcmp(command, \"verbose\") == 0) {\n   627\t        cmd_verbose(args, arg_count);\n   628\t    } else if (strcmp(command, \"status\") == 0) {\n   629\t        cmd_status();\n   630\t    } else if (strcmp(command, \"time\") == 0) {\n   631\t        cmd_time();\n   632\t    } else if (strcmp(command, \"help\") == 0 || strcmp(command, \"?\") == 0) {\n   633\t        cmd_help();\n   634\t    } else if (strcmp(command, \"exit\") == 0 || strcmp(command, \"quit\") == 0) {\n   635\t        printf(\"Goodbye!\\n\");\n   636\t        exit(0);\n   637\t    }\n   638\t    // Check for partial matches using strncmp\n   639\t    else if (strncmp(command, \"add\", 3) == 0) {\n   640\t        printf(\"Did you mean 'adduser'?\\n\");\n   641\t    } else if (strncmp(command, \"log\", 3) == 0) {\n   642\t        printf(\"Did you mean 'login' or 'logout'?\\n\");\n   643\t    } else if (strncmp(command, \"list\", 4) == 0) {\n   644\t        printf(\"Did you mean 'listusers', 'listfiles', or 'listvars'?\\n\");\n   645\t    } else if (strncmp(command, \"create\", 6) == 0) {\n   646\t        printf(\"Did you mean 'createfile'?\\n\");\n   647\t    } else if (strncmp(command, \"read\", 4) == 0) {\n   648\t        printf(\"Did you mean 'readfile'?\\n\");\n   649\t    } else if (strncmp(command, \"write\", 5) == 0) {\n   650\t        printf(\"Did you mean 'writefile'?\\n\");\n   651\t    } else if (strncmp(command, \"delete\", 6) == 0) {\n   652\t        printf(\"Did you mean 'deletefile'?\\n\");\n   653\t    } else {\n   654\t        printf(\"Unknown command: '%s'. Type 'help' for available commands.\\n\", command);\n   655\t    }\n   656\t}\n   657\t\n   658\tint main(void) {\n   659\t    printf(\"|----------------------------------------|\\n\");\n   660\t    printf(\"|   COMMAND INTERPRETER                  |\\n\");\n   661\t    printf(\"|   strcmp/strncmp demonstration         |\\n\");\n   662\t    printf(\"|----------------------------------------|\\n\");\n   663\t    printf(\"Type 'help' for available commands\\n\\n\");\n   664\t    \n   665\t    char input[MAX_INPUT];\n   666\t    \n   667\t    while (1) {\n   668\t        printf(\"> \");\n   669\t        \n   670\t        if (fgets(input, MAX_INPUT, stdin) == NULL) {\n   671\t            break;\n   672\t        }\n   673\t        \n   674\t        // Remove newline\n   675\t        input[strcspn(input, \"\\n\")] = 0;\n   676\t        \n   677\t        if (verbose_mode) {\n   678\t            printf(\"[VERBOSE] Processing: '%s'\\n\", input);\n   679\t        }\n   680\t        \n   681\t        process_command(input);\n   682\t    }\n   683\t    \n   684\t    return 0;\n   685\t}\n","exit_code":0,"status":"completed"}}
