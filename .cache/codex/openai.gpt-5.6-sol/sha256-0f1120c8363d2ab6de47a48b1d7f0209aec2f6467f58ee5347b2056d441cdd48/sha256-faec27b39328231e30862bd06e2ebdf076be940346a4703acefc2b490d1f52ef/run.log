{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/main.rs && printf '\\\\nCargo.toml:\\\\n' && nl -ba Cargo.toml\"","aggregated_output":"     1\tuse std::ffi::CStr;\n     2\tuse std::io::{self, Read, Write};\n     3\tuse std::os::raw::{c_char, c_int, c_long};\n     4\t\n     5\tconst MAX_INPUT: usize = 256;\n     6\tconst MAX_COMMAND: usize = 64;\n     7\tconst MAX_ARGS: usize = 10;\n     8\tconst MAX_FILES: usize = 20;\n     9\tconst MAX_USERS: usize = 10;\n    10\tconst MAX_VARIABLES: usize = 20;\n    11\t\n    12\tconst USER_SIZE: usize = 72;\n    13\tconst USER_PASSWORD: usize = 32;\n    14\tconst USER_PERMISSION: usize = 64;\n    15\tconst USER_LOGGED_IN: usize = 68;\n    16\t\n    17\tconst FILE_SIZE: usize = 612;\n    18\tconst FILE_CONTENT: usize = 64;\n    19\tconst FILE_OWNER: usize = 576;\n    20\tconst FILE_PERMISSIONS: usize = 608;\n    21\t\n    22\tconst VARIABLE_SIZE: usize = 160;\n    23\tconst VARIABLE_VALUE: usize = 32;\n    24\t\n    25\textern \"C\" {\n    26\t    fn atoi(value: *const c_char) -> c_int;\n    27\t    fn strcmp(left: *const c_char, right: *const c_char) -> c_int;\n    28\t    fn strncmp(left: *const c_char, right: *const c_char, count: usize) -> c_int;\n    29\t    fn time(timer: *mut c_long) -> c_long;\n    30\t    fn ctime(timer: *const c_long) -> *mut c_char;\n    31\t}\n    32\t\n    33\tfn nul_terminated(value: &[u8]) -> Vec<u8> {\n    34\t    let mut result = Vec::with_capacity(value.len() + 1);\n    35\t    result.extend_from_slice(value);\n    36\t    result.push(0);\n    37\t    result\n    38\t}\n    39\t\n    40\tfn c_atoi(value: &[u8]) -> i32 {\n    41\t    let value = nul_terminated(value);\n    42\t    unsafe { atoi(value.as_ptr().cast()) }\n    43\t}\n    44\t\n    45\tfn c_strcmp(left: &[u8], right: &[u8]) -> i32 {\n    46\t    let left = nul_terminated(left);\n    47\t    let right = nul_terminated(right);\n    48\t    unsafe { strcmp(left.as_ptr().cast(), right.as_ptr().cast()) }\n    49\t}\n    50\t\n    51\tfn c_strncmp(left: &[u8], right: &[u8], count: usize) -> i32 {\n    52\t    let left = nul_terminated(left);\n    53\t    let right = nul_terminated(right);\n    54\t    unsafe { strncmp(left.as_ptr().cast(), right.as_ptr().cast(), count) }\n    55\t}\n    56\t\n    57\tfn write_c_string(storage: &mut [u8], offset: usize, value: &[u8]) {\n    58\t    for (index, byte) in value.iter().copied().chain(std::iter::once(0)).enumerate() {\n    59\t        if let Some(slot) = storage.get_mut(offset + index) {\n    60\t            *slot = byte;\n    61\t        } else {\n    62\t            break;\n    63\t        }\n    64\t    }\n    65\t}\n    66\t\n    67\tfn read_c_string(storage: &[u8], offset: usize) -> &[u8] {\n    68\t    let tail = &storage[offset..];\n    69\t    let length = tail\n    70\t        .iter()\n    71\t        .position(|byte| *byte == 0)\n    72\t        .unwrap_or(tail.len());\n    73\t    &tail[..length]\n    74\t}\n    75\t\n    76\tfn write_i32(storage: &mut [u8], offset: usize, value: i32) {\n    77\t    if let Some(target) = storage.get_mut(offset..offset + 4) {\n    78\t        target.copy_from_slice(&value.to_ne_bytes());\n    79\t    }\n    80\t}\n    81\t\n    82\tfn read_i32(storage: &[u8], offset: usize) -> i32 {\n    83\t    let mut bytes = [0; 4];\n    84\t    bytes.copy_from_slice(&storage[offset..offset + 4]);\n    85\t    i32::from_ne_bytes(bytes)\n    86\t}\n    87\t\n    88\tfn push_dynamic(out: &mut Vec<u8>, prefix: &[u8], value: &[u8], suffix: &[u8]) {\n    89\t    out.extend_from_slice(prefix);\n    90\t    out.extend_from_slice(value);\n    91\t    out.extend_from_slice(suffix);\n    92\t}\n    93\t\n    94\tfn parse_command(input: &[u8]) -> Option<(Vec<u8>, Vec<Vec<u8>>)> {\n    95\t    let mut tokens = input\n    96\t        .split(|byte| *byte == b' ' || *byte == b'\\t')\n    97\t        .filter(|token| !token.is_empty());\n    98\t    let command = tokens\n    99\t        .next()?\n   100\t        .iter()\n   101\t        .copied()\n   102\t        .take(MAX_COMMAND - 1)\n   103\t        .collect();\n   104\t    let args = tokens\n   105\t        .take(MAX_ARGS)\n   106\t        .map(|token| token.iter().copied().take(MAX_COMMAND - 1).collect())\n   107\t        .collect();\n   108\t    Some((command, args))\n   109\t}\n   110\t\n   111\tstruct State {\n   112\t    users: Vec<u8>,\n   113\t    user_count: usize,\n   114\t    current_user: Option<usize>,\n   115\t    files: Vec<u8>,\n   116\t    file_count: usize,\n   117\t    variables: Vec<u8>,\n   118\t    variable_count: usize,\n   119\t    debug_mode: bool,\n   120\t    verbose_mode: bool,\n   121\t    previous_command: Option<Vec<u8>>,\n   122\t}\n   123\t\n   124\timpl State {\n   125\t    fn new() -> Self {\n   126\t        Self {\n   127\t            users: vec![0; USER_SIZE * MAX_USERS],\n   128\t            user_count: 0,\n   129\t            current_user: None,\n   130\t            files: vec![0; FILE_SIZE * MAX_FILES],\n   131\t            file_count: 0,\n   132\t            variables: vec![0; VARIABLE_SIZE * MAX_VARIABLES],\n   133\t            variable_count: 0,\n   134\t            debug_mode: false,\n   135\t            verbose_mode: false,\n   136\t            previous_command: None,\n   137\t        }\n   138\t    }\n   139\t\n   140\t    fn user_offset(index: usize) -> usize {\n   141\t        index * USER_SIZE\n   142\t    }\n   143\t\n   144\t    fn user_name(&self, index: usize) -> &[u8] {\n   145\t        read_c_string(&self.users, Self::user_offset(index))\n   146\t    }\n   147\t\n   148\t    fn user_password(&self, index: usize) -> &[u8] {\n   149\t        read_c_string(&self.users, Self::user_offset(index) + USER_PASSWORD)\n   150\t    }\n   151\t\n   152\t    fn user_permission(&self, index: usize) -> i32 {\n   153\t        read_i32(&self.users, Self::user_offset(index) + USER_PERMISSION)\n   154\t    }\n   155\t\n   156\t    fn user_logged_in(&self, index: usize) -> bool {\n   157\t        read_i32(&self.users, Self::user_offset(index) + USER_LOGGED_IN) != 0\n   158\t    }\n   159\t\n   160\t    fn set_user_logged_in(&mut self, index: usize, value: bool) {\n   161\t        write_i32(\n   162\t            &mut self.users,\n   163\t            Self::user_offset(index) + USER_LOGGED_IN,\n   164\t            i32::from(value),\n   165\t        );\n   166\t    }\n   167\t\n   168\t    fn file_offset(index: usize) -> usize {\n   169\t        index * FILE_SIZE\n   170\t    }\n   171\t\n   172\t    fn filename(&self, index: usize) -> &[u8] {\n   173\t        read_c_string(&self.files, Self::file_offset(index))\n   174\t    }\n   175\t\n   176\t    fn file_content(&self, index: usize) -> &[u8] {\n   177\t        read_c_string(&self.files, Self::file_offset(index) + FILE_CONTENT)\n   178\t    }\n   179\t\n   180\t    fn file_owner(&self, index: usize) -> &[u8] {\n   181\t        read_c_string(&self.files, Self::file_offset(index) + FILE_OWNER)\n   182\t    }\n   183\t\n   184\t    fn file_permissions(&self, index: usize) -> i32 {\n   185\t        read_i32(&self.files, Self::file_offset(index) + FILE_PERMISSIONS)\n   186\t    }\n   187\t\n   188\t    fn variable_offset(index: usize) -> usize {\n   189\t        index * VARIABLE_SIZE\n   190\t    }\n   191\t\n   192\t    fn variable_name(&self, index: usize) -> &[u8] {\n   193\t        read_c_string(&self.variables, Self::variable_offset(index))\n   194\t    }\n   195\t\n   196\t    fn variable_value(&self, index: usize) -> &[u8] {\n   197\t        read_c_string(\n   198\t            &self.variables,\n   199\t            Self::variable_offset(index) + VARIABLE_VALUE,\n   200\t        )\n   201\t    }\n   202\t\n   203\t    fn cmd_adduser(&mut self, args: &[Vec<u8>], out: &mut Vec<u8>) {\n   204\t        if args.len() < 2 {\n   205\t            out.extend_from_slice(b\"Usage: adduser <username> <password> [permission_level]\\n\");\n   206\t            return;\n   207\t        }\n   208\t        if self.user_count >= MAX_USERS {\n   209\t            out.extend_from_slice(b\"Error: Maximum users reached\\n\");\n   210\t            return;\n   211\t        }\n   212\t        for index in 0..self.user_count {\n   213\t            if c_strcmp(self.user_name(index), &args[0]) == 0 {\n   214\t                push_dynamic(out, b\"Error: User '\", &args[0], b\"' already exists\\n\");\n   215\t                return;\n   216\t            }\n   217\t        }\n   218\t\n   219\t        let offset = Self::user_offset(self.user_count);\n   220\t        write_c_string(&mut self.users, offset, &args[0]);\n   221\t        write_c_string(&mut self.users, offset + USER_PASSWORD, &args[1]);\n   222\t        let permission = if args.len() >= 3 { c_atoi(&args[2]) } else { 1 };\n   223\t        write_i32(&mut self.users, offset + USER_PERMISSION, permission);\n   224\t        write_i32(&mut self.users, offset + USER_LOGGED_IN, 0);\n   225\t        self.user_count += 1;\n   226\t\n   227\t        push_dynamic(out, b\"User '\", &args[0], b\"' added with permission level \");\n   228\t        writeln!(out, \"{}\", self.user_permission(self.user_count - 1)).unwrap();\n   229\t    }\n   230\t\n   231\t    fn cmd_login(&mut self, args: &[Vec<u8>], out: &mut Vec<u8>) {\n   232\t        if args.len() < 2 {\n   233\t            out.extend_from_slice(b\"Usage: login <username> <password>\\n\");\n   234\t            return;\n   235\t        }\n   236\t        if let Some(index) = self.current_user {\n   237\t            if self.user_logged_in(index) {\n   238\t                push_dynamic(\n   239\t                    out,\n   240\t                    b\"Error: User '\",\n   241\t                    self.user_name(index),\n   242\t                    b\"' already logged in. Use 'logout' first.\\n\",\n   243\t                );\n   244\t                return;\n   245\t            }\n   246\t        }\n   247\t\n   248\t        for index in 0..self.user_count {\n   249\t            if c_strcmp(self.user_name(index), &args[0]) == 0 {\n   250\t                if c_strcmp(self.user_password(index), &args[1]) == 0 {\n   251\t                    self.set_user_logged_in(index, true);\n   252\t                    self.current_user = Some(index);\n   253\t                    push_dynamic(\n   254\t                        out,\n   255\t                        b\"Login successful. Welcome, \",\n   256\t                        self.user_name(index),\n   257\t                        b\"!\\n\",\n   258\t                    );\n   259\t                } else {\n   260\t                    out.extend_from_slice(b\"Error: Incorrect password\\n\");\n   261\t                }\n   262\t                return;\n   263\t            }\n   264\t        }\n   265\t        out.extend_from_slice(b\"Error: User not found\\n\");\n   266\t    }\n   267\t\n   268\t    fn cmd_logout(&mut self, out: &mut Vec<u8>) {\n   269\t        let Some(index) = self.current_user else {\n   270\t            out.extend_from_slice(b\"Error: No user logged in\\n\");\n   271\t            return;\n   272\t        };\n   273\t        if !self.user_logged_in(index) {\n   274\t            out.extend_from_slice(b\"Error: No user logged in\\n\");\n   275\t            return;\n   276\t        }\n   277\t\n   278\t        push_dynamic(out, b\"Goodbye, \", self.user_name(index), b\"!\\n\");\n   279\t        self.set_user_logged_in(index, false);\n   280\t        self.current_user = None;\n   281\t    }\n   282\t\n   283\t    fn cmd_whoami(&self, out: &mut Vec<u8>) {\n   284\t        let Some(index) = self.current_user else {\n   285\t            out.extend_from_slice(b\"Not logged in\\n\");\n   286\t            return;\n   287\t        };\n   288\t        if !self.user_logged_in(index) {\n   289\t            out.extend_from_slice(b\"Not logged in\\n\");\n   290\t            return;\n   291\t        }\n   292\t        push_dynamic(out, b\"Current user: \", self.user_name(index), b\"\\n\");\n   293\t        writeln!(out, \"Permission level: {}\", self.user_permission(index)).unwrap();\n   294\t    }\n   295\t\n   296\t    fn cmd_listusers(&self, out: &mut Vec<u8>) {\n   297\t        if self.user_count == 0 {\n   298\t            out.extend_from_slice(b\"No users registered\\n\");\n   299\t            return;\n   300\t        }\n   301\t        out.extend_from_slice(b\"Registered users:\\n\");\n   302\t        for index in 0..self.user_count {\n   303\t            push_dynamic(out, b\"  \", self.user_name(index), b\" (level \");\n   304\t            write!(out, \"{}) \", self.user_permission(index)).unwrap();\n   305\t            if self.user_logged_in(index) {\n   306\t                out.extend_from_slice(b\"[logged in]\");\n   307\t            }\n   308\t            out.push(b'\\n');\n   309\t        }\n   310\t    }\n   311\t\n   312\t    fn logged_in_user(&self) -> Option<usize> {\n   313\t        self.current_user\n   314\t            .filter(|index| self.user_logged_in(*index))\n   315\t    }\n   316\t\n   317\t    fn cmd_createfile(&mut self, args: &[Vec<u8>], out: &mut Vec<u8>) {\n   318\t        let Some(user) = self.logged_in_user() else {\n   319\t            out.extend_from_slice(b\"Error: Must be logged in\\n\");\n   320\t            return;\n   321\t        };\n   322\t        if args.is_empty() {\n   323\t            out.extend_from_slice(b\"Usage: createfile <filename> [content]\\n\");\n   324\t            return;\n   325\t        }\n   326\t        if self.file_count >= MAX_FILES {\n   327\t            out.extend_from_slice(b\"Error: Maximum files reached\\n\");\n   328\t            return;\n   329\t        }\n   330\t        for index in 0..self.file_count {\n   331\t            if c_strcmp(self.filename(index), &args[0]) == 0 {\n   332\t                push_dynamic(out, b\"Error: File '\", &args[0], b\"' already exists\\n\");\n   333\t                return;\n   334\t            }\n   335\t        }\n   336\t\n   337\t        let offset = Self::file_offset(self.file_count);\n   338\t        let owner = self.user_name(user).to_vec();\n   339\t        write_c_string(&mut self.files, offset, &args[0]);\n   340\t        write_c_string(&mut self.files, offset + FILE_OWNER, &owner);\n   341\t        write_i32(&mut self.files, offset + FILE_PERMISSIONS, 755);\n   342\t        write_c_string(\n   343\t            &mut self.files,\n   344\t            offset + FILE_CONTENT,\n   345\t            args.get(1).map_or(&[], Vec::as_slice),\n   346\t        );\n   347\t        self.file_count += 1;\n   348\t        push_dynamic(out, b\"File '\", &args[0], b\"' created\\n\");\n   349\t    }\n   350\t\n   351\t    fn cmd_readfile(&self, args: &[Vec<u8>], out: &mut Vec<u8>) {\n   352\t        if args.is_empty() {\n   353\t            out.extend_from_slice(b\"Usage: readfile <filename>\\n\");\n   354\t            return;\n   355\t        }\n   356\t        for index in 0..self.file_count {\n   357\t            if c_strcmp(self.filename(index), &args[0]) == 0 {\n   358\t                push_dynamic(out, b\"=== \", self.filename(index), b\" ===\\n\");\n   359\t                push_dynamic(out, b\"Owner: \", self.file_owner(index), b\"\\n\");\n   360\t                writeln!(out, \"Permissions: {}\", self.file_permissions(index)).unwrap();\n   361\t                push_dynamic(out, b\"Content: \", self.file_content(index), b\"\\n\");\n   362\t                return;\n   363\t            }\n   364\t        }\n   365\t        push_dynamic(out, b\"Error: File '\", &args[0], b\"' not found\\n\");\n   366\t    }\n   367\t\n   368\t    fn cmd_writefile(&mut self, args: &[Vec<u8>], out: &mut Vec<u8>) {\n   369\t        let Some(user) = self.logged_in_user() else {\n   370\t            out.extend_from_slice(b\"Error: Must be logged in\\n\");\n   371\t            return;\n   372\t        };\n   373\t        if args.len() < 2 {\n   374\t            out.extend_from_slice(b\"Usage: writefile <filename> <content>\\n\");\n   375\t            return;\n   376\t        }\n   377\t        for index in 0..self.file_count {\n   378\t            if c_strcmp(self.filename(index), &args[0]) == 0 {\n   379\t                let owns_file = c_strcmp(self.file_owner(index), self.user_name(user)) == 0;\n   380\t                if owns_file || self.user_permission(user) >= 5 {\n   381\t                    write_c_string(\n   382\t                        &mut self.files,\n   383\t                        Self::file_offset(index) + FILE_CONTENT,\n   384\t                        &args[1],\n   385\t                    );\n   386\t                    push_dynamic(out, b\"File '\", &args[0], b\"' updated\\n\");\n   387\t                } else {\n   388\t                    out.extend_from_slice(b\"Error: Permission denied\\n\");\n   389\t                }\n   390\t                return;\n   391\t            }\n   392\t        }\n   393\t        push_dynamic(out, b\"Error: File '\", &args[0], b\"' not found\\n\");\n   394\t    }\n   395\t\n   396\t    fn cmd_deletefile(&mut self, args: &[Vec<u8>], out: &mut Vec<u8>) {\n   397\t        let Some(user) = self.logged_in_user() else {\n   398\t            out.extend_from_slice(b\"Error: Must be logged in\\n\");\n   399\t            return;\n   400\t        };\n   401\t        if args.is_empty() {\n   402\t            out.extend_from_slice(b\"Usage: deletefile <filename>\\n\");\n   403\t            return;\n   404\t        }\n   405\t        for index in 0..self.file_count {\n   406\t            if c_strcmp(self.filename(index), &args[0]) == 0 {\n   407\t                let owns_file = c_strcmp(self.file_owner(index), self.user_name(user)) == 0;\n   408\t                if owns_file || self.user_permission(user) >= 9 {\n   409\t                    let start = Self::file_offset(index);\n   410\t                    let end = Self::file_offset(self.file_count);\n   411\t                    self.files.copy_within(start + FILE_SIZE..end, start);\n   412\t                    self.file_count -= 1;\n   413\t                    push_dynamic(out, b\"File '\", &args[0], b\"' deleted\\n\");\n   414\t                } else {\n   415\t                    out.extend_from_slice(b\"Error: Permission denied\\n\");\n   416\t                }\n   417\t                return;\n   418\t            }\n   419\t        }\n   420\t        push_dynamic(out, b\"Error: File '\", &args[0], b\"' not found\\n\");\n   421\t    }\n   422\t\n   423\t    fn cmd_listfiles(&self, out: &mut Vec<u8>) {\n   424\t        if self.file_count == 0 {\n   425\t            out.extend_from_slice(b\"No files\\n\");\n   426\t            return;\n   427\t        }\n   428\t        out.extend_from_slice(b\"Files:\\n\");\n   429\t        for index in 0..self.file_count {\n   430\t            push_dynamic(out, b\"  \", self.filename(index), b\" (owner: \");\n   431\t            out.extend_from_slice(self.file_owner(index));\n   432\t            write!(out, \", perm: {})\\n\", self.file_permissions(index)).unwrap();\n   433\t        }\n   434\t    }\n   435\t\n   436\t    fn cmd_set(&mut self, args: &[Vec<u8>], out: &mut Vec<u8>) {\n   437\t        if args.len() < 2 {\n   438\t            out.extend_from_slice(b\"Usage: set <name> <value>\\n\");\n   439\t            return;\n   440\t        }\n   441\t        for index in 0..self.variable_count {\n   442\t            if c_strcmp(self.variable_name(index), &args[0]) == 0 {\n   443\t                write_c_string(\n   444\t                    &mut self.variables,\n   445\t                    Self::variable_offset(index) + VARIABLE_VALUE,\n   446\t                    &args[1],\n   447\t                );\n   448\t                push_dynamic(out, b\"Variable '\", &args[0], b\"' updated\\n\");\n   449\t                return;\n   450\t            }\n   451\t        }\n   452\t        if self.variable_count >= MAX_VARIABLES {\n   453\t            out.extend_from_slice(b\"Error: Maximum variables reached\\n\");\n   454\t            return;\n   455\t        }\n   456\t\n   457\t        let offset = Self::variable_offset(self.variable_count);\n   458\t        write_c_string(&mut self.variables, offset, &args[0]);\n   459\t        write_c_string(&mut self.variables, offset + VARIABLE_VALUE, &args[1]);\n   460\t        self.variable_count += 1;\n   461\t        push_dynamic(out, b\"Variable '\", &args[0], b\"' set\\n\");\n   462\t    }\n   463\t\n   464\t    fn cmd_get(&self, args: &[Vec<u8>], out: &mut Vec<u8>) {\n   465\t        if args.is_empty() {\n   466\t            out.extend_from_slice(b\"Usage: get <name>\\n\");\n   467\t            return;\n   468\t        }\n   469\t        for index in 0..self.variable_count {\n   470\t            if c_strcmp(self.variable_name(index), &args[0]) == 0 {\n   471\t                push_dynamic(out, b\"\", self.variable_name(index), b\" = \");\n   472\t                out.extend_from_slice(self.variable_value(index));\n   473\t                out.push(b'\\n');\n   474\t                return;\n   475\t            }\n   476\t        }\n   477\t        push_dynamic(out, b\"Error: Variable '\", &args[0], b\"' not found\\n\");\n   478\t    }\n   479\t\n   480\t    fn cmd_unset(&mut self, args: &[Vec<u8>], out: &mut Vec<u8>) {\n   481\t        if args.is_empty() {\n   482\t            out.extend_from_slice(b\"Usage: unset <name>\\n\");\n   483\t            return;\n   484\t        }\n   485\t        for index in 0..self.variable_count {\n   486\t            if c_strcmp(self.variable_name(index), &args[0]) == 0 {\n   487\t                let start = Self::variable_offset(index);\n   488\t                let end = Self::variable_offset(self.variable_count);\n   489\t                self.variables\n   490\t                    .copy_within(start + VARIABLE_SIZE..end, start);\n   491\t                self.variable_count -= 1;\n   492\t                push_dynamic(out, b\"Variable '\", &args[0], b\"' unset\\n\");\n   493\t                return;\n   494\t            }\n   495\t        }\n   496\t        push_dynamic(out, b\"Error: Variable '\", &args[0], b\"' not found\\n\");\n   497\t    }\n   498\t\n   499\t    fn cmd_listvars(&self, out: &mut Vec<u8>) {\n   500\t        if self.variable_count == 0 {\n   501\t            out.extend_from_slice(b\"No variables set\\n\");\n   502\t            return;\n   503\t        }\n   504\t        out.extend_from_slice(b\"Variables:\\n\");\n   505\t        for index in 0..self.variable_count {\n   506\t            push_dynamic(out, b\"  \", self.variable_name(index), b\" = \");\n   507\t            out.extend_from_slice(self.variable_value(index));\n   508\t            out.push(b'\\n');\n   509\t        }\n   510\t    }\n   511\t\n   512\t    fn cmd_compare(&self, args: &[Vec<u8>], out: &mut Vec<u8>) {\n   513\t        if args.len() < 2 {\n   514\t            out.extend_from_slice(b\"Usage: compare <string1> <string2>\\n\");\n   515\t            return;\n   516\t        }\n   517\t        let result = c_strcmp(&args[0], &args[1]);\n   518\t        push_dynamic(out, b\"strcmp('\", &args[0], b\"', '\");\n   519\t        out.extend_from_slice(&args[1]);\n   520\t        writeln!(out, \"') = {result}\").unwrap();\n   521\t        if result == 0 {\n   522\t            out.extend_from_slice(b\"Strings are equal\\n\");\n   523\t        } else {\n   524\t            out.push(b'\\'');\n   525\t            out.extend_from_slice(&args[0]);\n   526\t            out.extend_from_slice(if result < 0 { b\"' < '\" } else { b\"' > '\" });\n   527\t            out.extend_from_slice(&args[1]);\n   528\t            out.extend_from_slice(b\"'\\n\");\n   529\t        }\n   530\t    }\n   531\t\n   532\t    fn cmd_compare_n(&self, args: &[Vec<u8>], out: &mut Vec<u8>) {\n   533\t        if args.len() < 3 {\n   534\t            out.extend_from_slice(b\"Usage: compareN <string1> <string2> <n>\\n\");\n   535\t            return;\n   536\t        }\n   537\t        let count = c_atoi(&args[2]);\n   538\t        let result = c_strncmp(&args[0], &args[1], count as usize);\n   539\t        push_dynamic(out, b\"strncmp('\", &args[0], b\"', '\");\n   540\t        out.extend_from_slice(&args[1]);\n   541\t        write!(out, \"', {count}) = {result}\\n\").unwrap();\n   542\t        if result == 0 {\n   543\t            writeln!(out, \"First {count} characters are equal\").unwrap();\n   544\t        } else {\n   545\t            out.push(b'\\'');\n   546\t            out.extend_from_slice(&args[0]);\n   547\t            out.extend_from_slice(if result < 0 { b\"' < '\" } else { b\"' > '\" });\n   548\t            out.extend_from_slice(&args[1]);\n   549\t            writeln!(out, \"' (first {count} chars)\").unwrap();\n   550\t        }\n   551\t    }\n   552\t\n   553\t    fn cmd_startswith(&self, args: &[Vec<u8>], out: &mut Vec<u8>) {\n   554\t        if args.len() < 2 {\n   555\t            out.extend_from_slice(b\"Usage: startswith <string> <prefix>\\n\");\n   556\t            return;\n   557\t        }\n   558\t        out.push(b'\\'');\n   559\t        out.extend_from_slice(&args[0]);\n   560\t        if c_strncmp(&args[0], &args[1], args[1].len()) == 0 {\n   561\t            out.extend_from_slice(b\"' starts with '\");\n   562\t        } else {\n   563\t            out.extend_from_slice(b\"' does not start with '\");\n   564\t        }\n   565\t        out.extend_from_slice(&args[1]);\n   566\t        out.extend_from_slice(b\"'\\n\");\n   567\t    }\n   568\t\n   569\t    fn cmd_match(&self, args: &[Vec<u8>], out: &mut Vec<u8>) {\n   570\t        if args.len() < 2 {\n   571\t            out.extend_from_slice(b\"Usage: match <pattern> <string1> [string2] ...\\n\");\n   572\t            return;\n   573\t        }\n   574\t        push_dynamic(out, b\"Matching pattern '\", &args[0], b\"':\\n\");\n   575\t        let mut matches = 0;\n   576\t        for value in &args[1..] {\n   577\t            out.extend_from_slice(b\"  '\");\n   578\t            out.extend_from_slice(value);\n   579\t            if c_strcmp(&args[0], value) == 0 {\n   580\t                out.extend_from_slice(b\"' - EXACT MATCH\\n\");\n   581\t                matches += 1;\n   582\t            } else if args[0].is_empty()\n   583\t                || value\n   584\t                    .windows(args[0].len())\n   585\t                    .any(|window| window == args[0].as_slice())\n   586\t            {\n   587\t                out.extend_from_slice(b\"' - contains pattern\\n\");\n   588\t                matches += 1;\n   589\t            } else {\n   590\t                out.extend_from_slice(b\"' - no match\\n\");\n   591\t            }\n   592\t        }\n   593\t        writeln!(out, \"Total matches: {matches}\").unwrap();\n   594\t    }\n   595\t\n   596\t    fn cmd_help(&self, out: &mut Vec<u8>) {\n   597\t        out.extend_from_slice(\n   598\t            b\"\\n=== Command Interpreter Help ===\\n\"\n   599\t                .iter()\n   600\t                .chain(b\"User Management:\\n\")\n   601\t                .chain(b\"  adduser <user> <pass> [level] - Add new user\\n\")\n   602\t                .chain(b\"  login <user> <pass>            - Login as user\\n\")\n   603\t                .chain(b\"  logout                         - Logout current user\\n\")\n   604\t                .chain(b\"  whoami                         - Show current user\\n\")\n   605\t                .chain(b\"  listusers                      - List all users\\n\")\n   606\t                .chain(b\"\\nFile Management:\\n\")\n   607\t                .chain(b\"  createfile <name> [content]    - Create file\\n\")\n   608\t                .chain(b\"  readfile <name>                - Read file\\n\")\n   609\t                .chain(b\"  writefile <name> <content>     - Write to file\\n\")\n   610\t                .chain(b\"  deletefile <name>              - Delete file\\n\")\n   611\t                .chain(b\"  listfiles                      - List all files\\n\")\n   612\t                .chain(b\"\\nVariable Management:\\n\")\n   613\t                .chain(b\"  set <name> <value>             - Set variable\\n\")\n   614\t                .chain(b\"  get <name>                     - Get variable\\n\")\n   615\t                .chain(b\"  unset <name>                   - Unset variable\\n\")\n   616\t                .chain(b\"  listvars                       - List all variables\\n\")\n   617\t                .chain(b\"\\nString Operations:\\n\")\n   618\t                .chain(b\"  compare <str1> <str2>          - Compare strings\\n\")\n   619\t                .chain(b\"  compareN <str1> <str2> <n>     - Compare first N chars\\n\")\n   620\t                .chain(b\"  startswith <str> <prefix>      - Check if starts with\\n\")\n   621\t                .chain(b\"  match <pattern> <str> ...      - Match pattern\\n\")\n   622\t                .chain(b\"\\nSystem:\\n\")\n   623\t                .chain(b\"  debug [on|off]                 - Toggle debug mode\\n\")\n   624\t                .chain(b\"  verbose [on|off]               - Toggle verbose mode\\n\")\n   625\t                .chain(b\"  status                         - Show system status\\n\")\n   626\t                .chain(b\"  time                           - Show current time\\n\")\n   627\t                .chain(b\"  help                           - Show this help\\n\")\n   628\t                .chain(b\"  exit                           - Exit program\\n\")\n   629\t                .copied()\n   630\t                .collect::<Vec<_>>()\n   631\t                .as_slice(),\n   632\t        );\n   633\t    }\n   634\t\n   635\t    fn cmd_debug(&mut self, args: &[Vec<u8>], out: &mut Vec<u8>) {\n   636\t        if args.is_empty() {\n   637\t            out.extend_from_slice(if self.debug_mode {\n   638\t                b\"Debug mode: ON\\n\"\n   639\t            } else {\n   640\t                b\"Debug mode: OFF\\n\"\n   641\t            });\n   642\t        } else if args[0] == b\"on\" {\n   643\t            self.debug_mode = true;\n   644\t            out.extend_from_slice(b\"Debug mode enabled\\n\");\n   645\t        } else if args[0] == b\"off\" {\n   646\t            self.debug_mode = false;\n   647\t            out.extend_from_slice(b\"Debug mode disabled\\n\");\n   648\t        } else {\n   649\t            out.extend_from_slice(b\"Usage: debug [on|off]\\n\");\n   650\t        }\n   651\t    }\n   652\t\n   653\t    fn cmd_verbose(&mut self, args: &[Vec<u8>], out: &mut Vec<u8>) {\n   654\t        if args.is_empty() {\n   655\t            out.extend_from_slice(if self.verbose_mode {\n   656\t                b\"Verbose mode: ON\\n\"\n   657\t            } else {\n   658\t                b\"Verbose mode: OFF\\n\"\n   659\t            });\n   660\t        } else if args[0] == b\"on\" {\n   661\t            self.verbose_mode = true;\n   662\t            out.extend_from_slice(b\"Verbose mode enabled\\n\");\n   663\t        } else if args[0] == b\"off\" {\n   664\t            self.verbose_mode = false;\n   665\t            out.extend_from_slice(b\"Verbose mode disabled\\n\");\n   666\t        } else {\n   667\t            out.extend_from_slice(b\"Usage: verbose [on|off]\\n\");\n   668\t        }\n   669\t    }\n   670\t\n   671\t    fn cmd_status(&self, out: &mut Vec<u8>) {\n   672\t        out.extend_from_slice(b\"\\n=== System Status ===\\n\");\n   673\t        writeln!(out, \"Users: {}/{}\", self.user_count, MAX_USERS).unwrap();\n   674\t        writeln!(out, \"Files: {}/{}\", self.file_count, MAX_FILES).unwrap();\n   675\t        writeln!(out, \"Variables: {}/{}\", self.variable_count, MAX_VARIABLES).unwrap();\n   676\t        out.extend_from_slice(b\"Current user: \");\n   677\t        if let Some(index) = self.logged_in_user() {\n   678\t            out.extend_from_slice(self.user_name(index));\n   679\t        } else {\n   680\t            out.extend_from_slice(b\"none\");\n   681\t        }\n   682\t        out.push(b'\\n');\n   683\t        out.extend_from_slice(if self.debug_mode {\n   684\t            b\"Debug mode: ON\\n\"\n   685\t        } else {\n   686\t            b\"Debug mode: OFF\\n\"\n   687\t        });\n   688\t        out.extend_from_slice(if self.verbose_mode {\n   689\t            b\"Verbose mode: ON\\n\"\n   690\t        } else {\n   691\t            b\"Verbose mode: OFF\\n\"\n   692\t        });\n   693\t    }\n   694\t\n   695\t    fn cmd_time(&self, out: &mut Vec<u8>) {\n   696\t        let now = unsafe { time(std::ptr::null_mut()) };\n   697\t        let text = unsafe { ctime(&now) };\n   698\t        out.extend_from_slice(b\"Current time: \");\n   699\t        if !text.is_null() {\n   700\t            out.extend_from_slice(unsafe { CStr::from_ptr(text) }.to_bytes());\n   701\t        }\n   702\t    }\n   703\t\n   704\t    fn process_command(&mut self, input: &[u8], out: &mut Vec<u8>) -> bool {\n   705\t        let (command, args) = if let Some(parsed) = parse_command(input) {\n   706\t            self.previous_command = Some(parsed.0.clone());\n   707\t            parsed\n   708\t        } else {\n   709\t            let Some(command) = self.previous_command.clone() else {\n   710\t                return false;\n   711\t            };\n   712\t            (command, Vec::new())\n   713\t        };\n   714\t        if self.debug_mode {\n   715\t            push_dynamic(out, b\"[DEBUG] Command: '\", &command, b\"', Args: \");\n   716\t            writeln!(out, \"{}\", args.len()).unwrap();\n   717\t        }\n   718\t\n   719\t        match command.as_slice() {\n   720\t            b\"adduser\" => self.cmd_adduser(&args, out),\n   721\t            b\"login\" => self.cmd_login(&args, out),\n   722\t            b\"logout\" => self.cmd_logout(out),\n   723\t            b\"whoami\" => self.cmd_whoami(out),\n   724\t            b\"listusers\" | b\"users\" => self.cmd_listusers(out),\n   725\t            b\"createfile\" | b\"touch\" => self.cmd_createfile(&args, out),\n   726\t            b\"readfile\" | b\"cat\" => self.cmd_readfile(&args, out),\n   727\t            b\"writefile\" | b\"write\" => self.cmd_writefile(&args, out),\n   728\t            b\"deletefile\" | b\"rm\" => self.cmd_deletefile(&args, out),\n   729\t            b\"listfiles\" | b\"ls\" => self.cmd_listfiles(out),\n   730\t            b\"set\" => self.cmd_set(&args, out),\n   731\t            b\"get\" => self.cmd_get(&args, out),\n   732\t            b\"unset\" => self.cmd_unset(&args, out),\n   733\t            b\"listvars\" | b\"vars\" => self.cmd_listvars(out),\n   734\t            b\"compare\" | b\"cmp\" => self.cmd_compare(&args, out),\n   735\t            b\"compareN\" | b\"cmpn\" => self.cmd_compare_n(&args, out),\n   736\t            b\"startswith\" => self.cmd_startswith(&args, out),\n   737\t            b\"match\" => self.cmd_match(&args, out),\n   738\t            b\"debug\" => self.cmd_debug(&args, out),\n   739\t            b\"verbose\" => self.cmd_verbose(&args, out),\n   740\t            b\"status\" => self.cmd_status(out),\n   741\t            b\"time\" => self.cmd_time(out),\n   742\t            b\"help\" | b\"?\" => self.cmd_help(out),\n   743\t            b\"exit\" | b\"quit\" => {\n   744\t                out.extend_from_slice(b\"Goodbye!\\n\");\n   745\t                return true;\n   746\t            }\n   747\t            _ if command.starts_with(b\"add\") => out.extend_from_slice(b\"Did you mean 'adduser'?\\n\"),\n   748\t            _ if command.starts_with(b\"log\") => {\n   749\t                out.extend_from_slice(b\"Did you mean 'login' or 'logout'?\\n\")\n   750\t            }\n   751\t            _ if command.starts_with(b\"list\") => {\n   752\t                out.extend_from_slice(b\"Did you mean 'listusers', 'listfiles', or 'listvars'?\\n\")\n   753\t            }\n   754\t            _ if command.starts_with(b\"create\") => {\n   755\t                out.extend_from_slice(b\"Did you mean 'createfile'?\\n\")\n   756\t            }\n   757\t            _ if command.starts_with(b\"read\") => {\n   758\t                out.extend_from_slice(b\"Did you mean 'readfile'?\\n\")\n   759\t            }\n   760\t            _ if command.starts_with(b\"write\") => {\n   761\t                out.extend_from_slice(b\"Did you mean 'writefile'?\\n\")\n   762\t            }\n   763\t            _ if command.starts_with(b\"delete\") => {\n   764\t                out.extend_from_slice(b\"Did you mean 'deletefile'?\\n\")\n   765\t            }\n   766\t            _ => {\n   767\t                push_dynamic(\n   768\t                    out,\n   769\t                    b\"Unknown command: '\",\n   770\t                    &command,\n   771\t                    b\"'. Type 'help' for available commands.\\n\",\n   772\t                );\n   773\t            }\n   774\t        }\n   775\t        false\n   776\t    }\n   777\t}\n   778\t\n   779\tfn fgets_like<R: Read>(reader: &mut R) -> io::Result<Option<Vec<u8>>> {\n   780\t    let mut result = Vec::with_capacity(MAX_INPUT);\n   781\t    let mut byte = [0; 1];\n   782\t    while result.len() < MAX_INPUT - 1 {\n   783\t        match reader.read(&mut byte) {\n   784\t            Ok(0) => return Ok((!result.is_empty()).then_some(result)),\n   785\t            Ok(_) => {\n   786\t                result.push(byte[0]);\n   787\t                if byte[0] == b'\\n' {\n   788\t                    break;\n   789\t                }\n   790\t            }\n   791\t            Err(error) if error.kind() == io::ErrorKind::Interrupted => continue,\n   792\t            Err(error) => return Err(error),\n   793\t        }\n   794\t    }\n   795\t    Ok(Some(result))\n   796\t}\n   797\t\n   798\tfn main() {\n   799\t    let stdin = io::stdin();\n   800\t    let mut input = stdin.lock();\n   801\t    let stdout = io::stdout();\n   802\t    let mut output = stdout.lock();\n   803\t    let mut state = State::new();\n   804\t\n   805\t    output\n   806\t        .write_all(\n   807\t            b\"|----------------------------------------|\\n\\\n   808\t|   COMMAND INTERPRETER                  |\\n\\\n   809\t|   strcmp/strncmp demonstration         |\\n\\\n   810\t|----------------------------------------|\\n\\\n   811\tType 'help' for available commands\\n\\n\",\n   812\t        )\n   813\t        .ok();\n   814\t\n   815\t    loop {\n   816\t        output.write_all(b\"> \").ok();\n   817\t        output.flush().ok();\n   818\t\n   819\t        let Ok(Some(mut line)) = fgets_like(&mut input) else {\n   820\t            break;\n   821\t        };\n   822\t        let visible_end = line\n   823\t            .iter()\n   824\t            .position(|byte| *byte == 0 || *byte == b'\\n')\n   825\t            .unwrap_or(line.len());\n   826\t        line.truncate(visible_end);\n   827\t\n   828\t        let mut response = Vec::new();\n   829\t        if state.verbose_mode {\n   830\t            push_dynamic(&mut response, b\"[VERBOSE] Processing: '\", &line, b\"'\\n\");\n   831\t        }\n   832\t        let exit = state.process_command(&line, &mut response);\n   833\t        output.write_all(&response).ok();\n   834\t        if exit {\n   835\t            break;\n   836\t        }\n   837\t    }\n   838\t}\n\nCargo.toml:\n     1\t[package]\n     2\tname = \"driver\"\n     3\tversion = \"0.1.0\"\n     4\tedition = \"2021\"\n     5\t\n     6\t[dependencies]\n     7\t\n     8\t[workspace]\n     9\t\n    10\t[[bin]]\n    11\tname = \"driver\"\n    12\tpath = \"src/main.rs\"\n","exit_code":0,"status":"completed"}}
