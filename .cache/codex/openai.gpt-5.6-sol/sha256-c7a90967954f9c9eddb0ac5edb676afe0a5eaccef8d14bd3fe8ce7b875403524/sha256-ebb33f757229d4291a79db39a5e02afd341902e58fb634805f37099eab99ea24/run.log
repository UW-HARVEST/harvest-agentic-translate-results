edrooms = 0;\n        if parse_val(input, &mut extra_bedrooms) {\n            let mut house = House {\n                floors: 2,\n                bedrooms: 5,\n                bathrooms: 2.5,\n            };\n            run(&mut house, extra_bedrooms);\n            run(&mut house, extra_bedrooms);\n        } else {\n            printf(ERROR_MESSAGE.as_ptr().cast());\n        }\n    }\n}\n","exit_code":0,"status":"completed"}}
