{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport math, struct\nf=lambda x: struct.unpack('f',struct.pack('f',x))[0]\ndef lin(v):\n    x=f(v/255.0)\n    return f(math.pow((x+0.055)/1.055,2.4)) if x > 0.04045 else f(x/12.92)\ndef lum(rgb):\n    r,g,b=map(lin,rgb)\n    return f(f(f(0.2126*r)+f(0.7152*g))+f(0.0722*b))\npossible=[]\nfor mask in range(64):\n    lo=[]; hi=[]\n    for bit in range(6):\n        is_high=(mask >> (5-bit))&1\n        lo.append(11 if is_high else 0)\n        hi.append(255 if is_high else 10)\n    amin,amax=lum(lo[:3]),lum(hi[:3])\n    bmin,bmax=lum(lo[3:]),lum(hi[3:])\n    orders=[]\n    if amin < bmax: orders.append('A<B')\n    if amax >= bmin: orders.append('A>=B')\n    possible.append((mask,''.join('H' if (mask>>(5-bit))&1 else 'L' for bit in range(6)),orders,amin,amax,bmin,bmax))\nprint('masks',len(possible),'config rows',sum(len(x[2]) for x in possible))\nfor x in possible:\n    print(f'{x[0]:02d} {x[1]} {\\\",\\\".join(x[2])}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
