       inp = (ctypes.c_ubyte * (len(encoded) + 4))()\n        ctypes.memmove(ctypes.addressof(inp) + alignment, encoded, len(encoded))\n        out = (ctypes.c_ubyte * (len(expected) + 16))(*([0xA5] * (len(expected) + 16)))\n        ret = lib.cp_inflate(ctypes.addressof(inp) + alignment, len(encoded), out, len(expected))\n        observed.append((ret, bytes(out)))\n    assert observed[0] == observed[1], case_index\n    assert observed[0][1][-16:] == b'\\\\xA5' * 16, case_index\n\nerror_cases = [\n    ('unknown', bytes([0x07]), 8),\n    ('stored-complement', bytes([1, 1, 0, 0, 0, 0x42]), 8),\n    ('stored-input', bytes([1, 1, 0, 0xfe, 0xff, 0x42, 0x99]), 8),\n]\nfor label, encoded, out_len in error_cases:\n    got = []\n    for lib in libs:\n        inp = (ctypes.c_ubyte * len(encoded)).from_buffer_copy(encoded)\n        out = (ctypes.c_ubyte * out_len)()\n        ctypes.c_void_p.in_dll(lib, 'cp_error_reason').value = None\n        ret = lib.cp_inflate(inp, len(encoded), out, out_len)\n        ptr = ctypes.c_void_p.in_dll(lib, 'cp_error_reason').value\n        got.append((ret, ctypes.string_at(ptr) if ptr else None, bytes(out)))\n    assert got[0] == got[1], (label, got)\n\nfor i in range(200):\n    bpp = rng.randrange(0, 7)\n    w, h = rng.randrange(0, 20), rng.randrange(0, 12)\n    src_len = max(1, h * (1 + w * bpp))\n    src_bytes = bytes(rng.randrange(256) for _ in range(src_len))\n    got = []\n    for lib in libs:\n        src = (ctypes.c_ubyte * src_len).from_buffer_copy(src_bytes)\n        dst_len = max(4, w * h * 4 + 16)\n        dst = (ctypes.c_ubyte * dst_len)(*([0xA5] * dst_len))\n        lib.convert_pix(bpp, w, h, src, dst)\n        got.append(bytes(dst))\n    assert got[0] == got[1], i\n\nprint(f'random inflate differential: {len(cases)} passed, block types {dict(types)}')\nprint(f'validation errors: {len(error_cases)} matched')\nprint('random convert_pix differential: 200 passed')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
