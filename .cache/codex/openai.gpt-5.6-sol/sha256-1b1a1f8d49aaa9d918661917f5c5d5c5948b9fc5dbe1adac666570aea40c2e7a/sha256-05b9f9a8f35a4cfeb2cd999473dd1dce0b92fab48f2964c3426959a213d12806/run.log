{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes\nimport os\nimport random\nimport zlib\n\nC_PATH = '/tmp/harvest-ZAJUbu-cbuild/libreference.so'\nR_PATH = os.path.abspath('target/release/libcp_translation.so')\nC = ctypes.CDLL(C_PATH, mode=ctypes.RTLD_LOCAL)\nR = ctypes.CDLL(R_PATH, mode=ctypes.RTLD_LOCAL)\nfor lib in (C, R):\n    lib.cp_inflate.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_void_p, ctypes.c_int]\n    lib.cp_inflate.restype = ctypes.c_int\n    lib.convert_pix.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_void_p, ctypes.c_void_p]\n    lib.convert_pix.restype = None\n\narrays = {\n    'cp_fixed_table': (ctypes.c_uint8, 320),\n    'cp_permutation_order': (ctypes.c_uint8, 19),\n    'cp_len_extra_bits': (ctypes.c_uint8, 31),\n    'cp_len_base': (ctypes.c_uint32, 31),\n    'cp_dist_extra_bits': (ctypes.c_uint8, 32),\n    'cp_dist_base': (ctypes.c_uint32, 32),\n}\nfor name, (kind, count) in arrays.items():\n    ca = bytes((kind * count).in_dll(C, name))\n    ra = bytes((kind * count).in_dll(R, name))\n    assert ca == ra, name\n\n\ndef compress(data, level=6, strategy=zlib.Z_DEFAULT_STRATEGY):\n    co = zlib.compressobj(level, zlib.DEFLATED, -15, 8, strategy)\n    return co.compress(data) + co.flush()\n\ncases = []\nrng = random.Random(0xC0FFEE)\nfor size in [1, 2, 3, 7, 31, 257, 4096, 32768]:\n    random_data = bytes(rng.randrange(256) for _ in range(size))\n    patterned = (b'abcdef0123456789' * ((size + 15) // 16))[:size]\n    cases.extend([\n        (f'stored-random-{size}', random_data, compress(random_data, level=0)),\n        (f'fixed-pattern-{size}', patterned, compress(patterned, strategy=zlib.Z_FIXED)),\n        (f'default-random-{size}', random_data, compress(random_data)),\n        (f'default-pattern-{size}', patterned, compress(patterned)),\n    ])\n\nfor label, expected, encoded in cases:\n    for alignment in range(4):\n        results = []\n        for lib in (C, R):\n            inp = (ctypes.c_ubyte * (len(encoded) + 4))()\n            ctypes.memmove(ctypes.addressof(inp) + alignment, encoded, len(encoded))\n            out = (ctypes.c_ubyte * max(1, len(expected)))()\n            ret = lib.cp_inflate(ctypes.addressof(inp) + alignment, len(encoded), out, len(expected))\n            results.append((ret, bytes(out[:len(expected)])))\n        assert results[0] == results[1], (label, alignment, results[0][0], results[1][0])\n        assert results[0] == (1, expected), (label, alignment, results[0][0])\n\n# The same valid stream with a short output buffer must fail identically.\nexpected = b'abcd' * 1000\nencoded = compress(expected, strategy=zlib.Z_FIXED)\nerrors = []\nfor lib in (C, R):\n    inp = (ctypes.c_ubyte * len(encoded)).from_buffer_copy(encoded)\n    out = (ctypes.c_ubyte * 11)()\n    ctypes.c_void_p.in_dll(lib, 'cp_error_reason').value = None\n    ret = lib.cp_inflate(inp, len(encoded), out, len(out))\n    ptr = ctypes.c_void_p.in_dll(lib, 'cp_error_reason').value\n    errors.append((ret, ctypes.string_at(ptr) if ptr else None, bytes(out)))\nassert errors[0] == errors[1], errors\nassert errors[0][0] == 0\n\n# convert_pix: compare all supported formats, multiple rows, and unsupported bpp behavior.\nfor bpp in [0, 1, 2, 3, 4, 5]:\n    for w, h in [(0, 0), (0, 3), (1, 1), (7, 4)]:\n        stride = 1 + max(0, w * max(0, bpp))\n        src_data = bytes(rng.randrange(256) for _ in range(max(1, stride * max(1, h))))\n        outputs = []\n        for lib in (C, R):\n            src = (ctypes.c_ubyte * len(src_data)).from_buffer_copy(src_data)\n            dst = (ctypes.c_ubyte * max(4, w * h * 4))(*([0xA5] * max(4, w * h * 4)))\n            lib.convert_pix(bpp, w, h, src, dst)\n            outputs.append(bytes(dst))\n        assert outputs[0] == outputs[1], (bpp, w, h)\n\nprint(f'tables: {len(arrays)} matched')\nprint(f'inflate: {len(cases) * 4} aligned differential cases passed')\nprint(f'inflate error: matched {errors[0][1].decode()}')\nprint('convert_pix: 24 differential cases passed')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
