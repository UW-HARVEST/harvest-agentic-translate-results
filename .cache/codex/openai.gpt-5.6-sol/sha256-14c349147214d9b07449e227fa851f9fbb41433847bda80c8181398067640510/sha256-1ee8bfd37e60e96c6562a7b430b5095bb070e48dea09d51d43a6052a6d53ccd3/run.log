 [x] |\n    15\t| 5 | `decode_base64` | Exactly three retained characters (`3 mod 4`); `c4` defaults to `A` | [x] |\n    16\t| 6 | `decode_base64` | `=` in position 3 and non-`=` in position 4; second output byte suppressed, third emitted | [x] |\n    17\t| 7 | `decode_base64` | Non-`=` in position 3 and `=` in position 4; second output byte emitted, third suppressed | [x] |\n    18\t| 8 | `decode_base64` | `=` in positions 3 and 4; both conditional output bytes suppressed | [x] |\n    19\t| 9 | `decode_base64` | `=` in position 1 or 2; retained and decoded through the default value `63`, without suppressing bytes | [x] |\n    20\t| 10 | `decode_base64` | Invalid bytes mixed before, between, and after valid bytes; invalid bytes ignored | [x] |\n    21\t| 11 | `decode_base64` | Nonempty source containing no retained Base64 characters; successful empty decoded result | [x] |\n    22\t| 12 | `decode_base64` | Multiple quartets, including padding or an incomplete final quartet; loop executes many times | [x] |\n    23\t| 13 | `decode_base64` | Valid input whose decoded bytes contain embedded NUL bytes; compare produced bytes rather than C-string length | [x] |\n    24\t| 14 | `decode_base64` | Long NUL-terminated input, exercising the API's only oversized-input boundary | [x] |\n     1\tuse libloading::Library;\n     2\tuse std::ffi::{CString, c_char, c_int, c_long, c_void};\n     3\tuse std::path::{Path, PathBuf};\n     4\tuse std::process::Command;\n     5\tuse std::{env, fs, ptr, slice};\n     6\t\n     7\ttype DecodeBase64 = unsafe extern \"C\" fn(*const c_char) -> *mut c_char;\n     8\t\n     9\tunsafe extern \"C\" {\n    10\t    fn free(ptr: *mut c_void);\n    11\t}\n    12\t\n    13\tstruct Drivers {\n    14\t    c: Library,\n    15\t    rust: Library,\n    16\t}\n    17\t\n    18\timpl Drivers {\n    19\t    fn load() -> Self {\n    20\t        let root = Path::new(env!(\"CARGO_MANIFEST_DIR\"));\n    21\t        let c_path = root.join(\"../c_src/build/libdriver.so\");\n    22\t        let rust_path = root.join(\"target/release/libdriver.so\");\n    23\t\n    24\t        assert!(c_path.is_file(), \"missing C library: {}\", c_path.display());\n    25\t        assert!(\n    26\t            rust_path.is_file(),\n    27\t            \"missing Rust library: {}; run cargo build --release\",\n    28\t            rust_path.display()\n    29\t        );\n    30\t\n    31\t        unsafe {\n    32\t            Self {\n    33\t                c: Library::new(c_path).expect(\"load C driver\"),\n    34\t                rust: Library::new(rust_path).expect(\"load Rust driver\"),\n    35\t            }\n    36\t        }\n    37\t    }\n    38\t\n    39\t    unsafe fn decode_with(library: &Library, src: *const c_char) -> *mut c_char {\n    40\t        let decode = unsafe {\n    41\t            library\n    42\t                .get::<DecodeBase64>(b\"decode_base64\\0\")\n    43\t                .expect(\"load decode_base64\")\n    44\t        };\n    45\t        unsafe { decode(src) }\n    46\t    }\n    47\t\n    48\t    fn assert_matches(&self, row: usize, input: &[u8]) {\n    49\t        let input = CString::new(input).expect(\"test input must not contain NUL\");\n    50\t        let allocation_len = input.as_bytes().len() + 14;\n    51\t\n    52\t        unsafe {\n    53\t            let c_result = Self::decode_with(&self.c, input.as_ptr());\n    54\t            let rust_result = Self::decode_with(&self.rust, input.as_ptr());\n    55\t\n    56\t            assert!(!c_result.is_null(), \"CONFIGS.md row {row}: C returned NULL\");\n    57\t            assert!(\n    58\t                !rust_result.is_null(),\n    59\t                \"CONFIGS.md row {row}: Rust returned NULL\"\n    60\t            );\n    61\t\n    62\t            let c_bytes = slice::from_raw_parts(c_result.cast::<u8>(), allocation_len);\n    63\t            let rust_bytes = slice::from_raw_parts(rust_result.cast::<u8>(), allocation_len);\n    64\t            assert_eq!(