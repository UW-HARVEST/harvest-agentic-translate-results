ert!(result.is_null(), \"ERRORS.md row 4: {name} was non-NULL\");\n   412\t            assert_eq!(freed, 1, \"ERRORS.md row 4: {name} leaked destination\");\n   413\t        }\n   414\t    }\n   415\t}\n","exit_code":0,"status":"completed"}}
