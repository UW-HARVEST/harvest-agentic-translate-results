= 2 */;\napp/params/params-sphincs-sha2-192s.h #define SPX_NAMESPACE(s) SPX_##s;#define SPX_N 24;#define SPX_FULL_HEIGHT 63;#define SPX_D 7;#define SPX_FORS_HEIGHT 14;#define SPX_FORS_TREES 17;#define SPX_WOTS_W 16;#define SPX_SHA512 1  /* Use SHA-512 for H and T_l, l >= 2 */;\napp/params/params-sphincs-sha2-256f.h #define SPX_NAMESPACE(s) SPX_##s;#define SPX_N 32;#define SPX_FULL_HEIGHT 68;#define SPX_D 17;#define SPX_FORS_HEIGHT 9;#define SPX_FORS_TREES 35;#define SPX_WOTS_W 16;#define SPX_SHA512 1  /* Use SHA-512 for H and T_l, l >= 2 */;\napp/params/params-sphincs-sha2-256s.h #define SPX_NAMESPACE(s) SPX_##s;#define SPX_N 32;#define SPX_FULL_HEIGHT 64;#define SPX_D 8;#define SPX_FORS_HEIGHT 14;#define SPX_FORS_TREES 22;#define SPX_WOTS_W 16;#define SPX_SHA512 1  /* Use SHA-512 for H and T_l, l >= 2 */;\napp/params/params-sphincs-shake-128f.h #define SPX_NAMESPACE(s) SPX_##s;#define SPX_N 16;#define SPX_FULL_HEIGHT 66;#define SPX_D 22;#define SPX_FORS_HEIGHT 6;#define SPX_FORS_TREES 33;#define SPX_WOTS_W 16;\napp/params/params-sphincs-shake-128s.h #define SPX_NAMESPACE(s) SPX_##s;#define SPX_N 16;#define SPX_FULL_HEIGHT 63;#define SPX_D 7;#define SPX_FORS_HEIGHT 12;#define SPX_FORS_TREES 14;#define SPX_WOTS_W 16;\napp/params/params-sphincs-shake-192f.h #define SPX_NAMESPACE(s) SPX_##s;#define SPX_N 24;#define SPX_FULL_HEIGHT 66;#define SPX_D 22;#define SPX_FORS_HEIGHT 8;#define SPX_FORS_TREES 33;#define SPX_WOTS_W 16;\napp/params/params-sphincs-shake-192s.h #define SPX_NAMESPACE(s) SPX_##s;#define SPX_N 24;#define SPX_FULL_HEIGHT 63;#define SPX_D 7;#define SPX_FORS_HEIGHT 14;#define SPX_FORS_TREES 17;#define SPX_WOTS_W 16;\napp/params/params-sphincs-shake-256f.h #define SPX_NAMESPACE(s) SPX_##s;#define SPX_N 32;#define SPX_FULL_HEIGHT 68;#define SPX_D 17;#define SPX_FORS_HEIGHT 9;#define SPX_FORS_TREES 35;#define SPX_WOTS_W 16;\napp/params/params-sphincs-shake-256s.h #define SPX_NAMESPACE(s) SPX_##s;#define SPX_N 32;#define SPX_FULL_HEIGHT 64;#define SPX_D 8;#def