{"type":"item.completed","item":{"id":"item_78","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/address.rs | sed -n '1,180p'; nl -ba src/offsets.rs\"","aggregated_output":"     1\tuse crate::{ params::*, utils::*, offsets::* };\n     2\t\n     3\t// This could probably be better represented as an enum with associated constants \n     4\tpub const SPX_ADDR_TYPE_WOTS: u32 = 0;\n     5\tpub const SPX_ADDR_TYPE_WOTSPK: u32 = 1;\n     6\tpub const SPX_ADDR_TYPE_HASHTREE: u32 = 2;\n     7\tpub const SPX_ADDR_TYPE_FORSTREE: u32 = 3;\n     8\tpub const SPX_ADDR_TYPE_FORSPK: u32 = 4;\n     9\tpub const SPX_ADDR_TYPE_WOTSPRF: u32 = 5;\n    10\tpub const SPX_ADDR_TYPE_FORSPRF: u32 = 6;\n    11\t\n    12\t// Replaces the uint8_t addr cast in C reference implementation\n    13\tfn set_addr(addr: &mut[u32], offset: usize, value: u32) \n    14\t{\n    15\t  let mut addr_bytes = address_to_bytes(addr); \n    16\t  addr_bytes[offset] = value as u8;\n    17\t  bytes_to_address(addr, &addr_bytes);\n    18\t}\n    19\t\n    20\t/// Specify which level of Merkle tree (the \"layer\") we're working on\n    21\tpub fn set_layer_addr(addr: &mut [u32], layer: u32)\n    22\t{ \n    23\t  set_addr(addr, SPX_OFFSET_LAYER, layer);\n    24\t}\n    25\t\n    26\t/// Specify which Merkle tree within the level (the \"tree address\") we're working on\n    27\tpub fn set_tree_addr(addr: &mut [u32], tree: u64)\n    28\t{\n    29\t  let be64 = tree.to_be_bytes();\n    30\t  let mut tmp_addr = address_to_bytes(&addr);\n    31\t  tmp_addr[SPX_OFFSET_TREE..SPX_OFFSET_TREE+8].copy_from_slice(&be64);\n    32\t  bytes_to_address(addr, &tmp_addr);\n    33\t}\n    34\t\n    35\t/// Specify the reason we'll use this address structure for, that is, what\n    36\t/// hash will we compute with it.  This is used so that unrelated types of\n    37\t/// hashes don't accidentally get the same address structure.  The type will be\n    38\t/// one of the SPX_ADDR_TYPE constants\n    39\tpub fn set_type(addr: &mut [u32], addr_type: u32)\n    40\t{\n    41\t  set_addr(addr, SPX_OFFSET_TYPE, addr_type);\n    42\t}\n    43\t\n    44\t/// Copy the layer and tree fields of the address structure.  This is used\n    45\t/// when we're doing multiple types of hashes within the same Merkle tree\n    46\tpub fn copy_subtree_addr(out: &mut [u32], input: &mut [u32])\n    47\t{   \n    48\t  let buf = address_to_bytes(input);\n    49\t  let mut out_bytes = address_to_bytes(out);\n    50\t  out_bytes[..SPX_OFFSET_TREE + 8 ]\n    51\t    .copy_from_slice(&buf[..SPX_OFFSET_TREE + 8]);\n    52\t  bytes_to_address(out, &out_bytes);\n    53\t}\n    54\t\n    55\t/// OTS ADDRESS FUNCTIONS\n    56\t\n    57\t/// Specify which Merkle leaf we're working on; that is, which OTS keypair\n    58\t/// we're talking about.\n    59\tpub fn set_keypair_addr(addr: &mut [u32], keypair: u32)\n    60\t{\n    61\t  // We have > 256 OTS at the bottom of the Merkle tree; to specify \n    62\t  // which one, we'd need to express it input two bytes  \n    63\t  if SPX_FULL_HEIGHT/SPX_D > 8 {\n    64\t    set_addr(addr, SPX_OFFSET_KP_ADDR2, keypair >> 8);\n    65\t  }\n    66\t  set_addr(addr, SPX_OFFSET_KP_ADDR1, keypair);\n    67\t}\n    68\t\n    69\t/// Copy the layer, tree and keypair fields of the address structure.  This is\n    70\t/// used when we're doing multiple things within the same OTS keypair\n    71\tpub fn copy_keypair_addr(out: &mut [u32], input: &[u32])\n    72\t{ \n    73\t  let in_buf = address_to_bytes(input);\n    74\t  let mut out_buf = address_to_bytes(out);\n    75\t  out_buf[..SPX_OFFSET_TREE + 8].copy_from_slice(&in_buf[..SPX_OFFSET_TREE + 8]);\n    76\t\n    77\t  if SPX_FULL_HEIGHT / SPX_D > 8 {\n    78\t    out_buf[SPX_OFFSET_KP_ADDR2] = in_buf[SPX_OFFSET_KP_ADDR2];\n    79\t  }\n    80\t  out_buf[SPX_OFFSET_KP_ADDR1] = in_buf[SPX_OFFSET_KP_ADDR1];\n    81\t  bytes_to_address(out, &out_buf);\n    82\t}\n    83\t\n    84\t/// Specify which Merkle chain within the OTS we're working with the chain address\n    85\tpub fn set_chain_addr(addr: &mut [u32], chain: u32)\n    86\t{\n    87\t  set_addr(addr, SPX_OFFSET_CHAIN_ADDR, chain);\n    88\t}\n    89\t\n    90\t/// Specify where in the Merkle chain we are the hash address\n    91\tpub fn set_hash_addr(addr: &mut [u32], hash: u32)\n    92\t{\n    93\t  set_addr(addr, SPX_OFFSET_HASH_ADDR, hash);\n    94\t}\n    95\t\n    96\t/// These functions are used for all hash tree addresses (including FORS).\n    97\t\n    98\t/// Specify the height of the node in the Merkle/FORS tree we are in the tree height\n    99\tpub fn set_tree_height(addr: &mut [u32], tree_height: u32)\n   100\t{\n   101\t  set_addr(addr, SPX_OFFSET_TREE_HGT, tree_height);\n   102\t}\n   103\t\n   104\t///Specify the distance from the left edge of the node in the Merkle/FORS tree\n   105\tpub fn set_tree_index(addr: &mut [u32], tree_index: u32)\n   106\t{\n   107\t  let mut tmp_addr = address_to_bytes(&addr);\n   108\t  u32_to_bytes(&mut tmp_addr[SPX_OFFSET_TREE_INDEX..], tree_index);\n   109\t  bytes_to_address(addr, &tmp_addr);\n   110\t}\n     1\t#[cfg(feature = \"haraka\")]\n     2\tmod haraka; \n     3\t\n     4\t#[cfg(feature = \"sha2\")]\n     5\tmod sha2; \n     6\t\n     7\t#[cfg(feature = \"shake\")]\n     8\tmod shake;\n     9\t#[cfg(feature = \"blake\")]\n    10\tmod blake;\n    11\t\n    12\t#[cfg(feature = \"haraka\")]\n    13\tpub use haraka::*; \n    14\t\n    15\t#[cfg(feature = \"sha2\")]\n    16\tpub use sha2::*; \n    17\t\n    18\t#[cfg(feature = \"shake\")]\n    19\tpub use shake::*;\n    20\t#[cfg(feature = \"blake\")]\n    21\tpub use blake::*;\n","exit_code":0,"status":"completed"}}
