{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc 'set -u\nfail=0\ncount=0\nfor hash in haraka sha2 shake blake; do\n  for thash in robust simple; do\n    for secpar in 128f 128s 192f 192s 256f 256s; do\n      combo=\"$hash,$thash,$secpar\"\n      count=$((count + 1))\n      log=\"/tmp/sphincs-check-${hash}-${thash}-${secpar}.log\"\n      if timeout 600 cargo check --quiet --no-default-features --features \"$combo\" >\"$log\" 2>&1; then\n        printf '\"'PASS %s\\\\n' \\\"\"'$combo\"\n      else\n        status=$?\n        printf '\"'FAIL(%s) %s log=%s\\\\n' \\\"\"'$status\" \"$combo\" \"$log\"\n        sed -n '\"'1,160p' \\\"\"'$log\"\n        fail=$((fail + 1))\n      fi\n    done\n  done\ndone\nprintf '\"'SUMMARY checked=%s failed=%s\\\\n' \\\"\"'$count\" \"$fail\"\ntest \"$fail\" -eq 0'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
