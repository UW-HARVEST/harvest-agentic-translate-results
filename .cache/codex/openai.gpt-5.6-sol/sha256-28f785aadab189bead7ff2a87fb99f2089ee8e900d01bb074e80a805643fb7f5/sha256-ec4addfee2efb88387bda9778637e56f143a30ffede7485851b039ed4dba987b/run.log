84\t  S->h[0] ^= v0;\n   285\t  S->h[1] ^= v1;\n   286\t  S->h[2] ^= v2;\n   287\t  S->h[3] ^= v3;\n   288\t  S->h[4] ^= v4;\n   289\t  S->h[5] ^= v5;\n   290\t  S->h[6] ^= v6;\n   291\t  S->h[7] ^= v7;\n   292\t}\n   293\t\n   294\t\n   295\tvoid blake512_init( blakestate512 *S ) {\n   296\t  S->h[0]=0x6A09E667F3BCC908ULL;\n   297\t  S->h[1]=0xBB67AE8584CAA73BULL;\n   298\t  S->h[2]=0x3C6EF372FE94F82BULL;\n   299\t  S->h[3]=0xA54FF53A5F1D36F1ULL;\n   300\t  S->h[4]=0x510E527FADE682D1ULL;\n   301\t  S->h[5]=0x9B05688C2B3E6C1FULL;\n   302\t  S->h[6]=0x1F83D9ABFB41BD6BULL;\n   303\t  S->h[7]=0x5BE0CD19137E2179ULL;\n   304\t  S->t[0]=S->t[1]=S->buflen=S->nullt=0;\n   305\t  S->s[0]=S->s[1]=S->s[2]=S->s[3] =0;\n   306\t}\n   307\t\n   308\t\n   309\tvoid blake512_update( blakestate512 * S, const u8 * data, u64 datalen ) {\n   310\t\n   311\t  int left = (S->buflen >> 3); \n   312\t  int fill = 128 - left;\n   313\t\n   314\t  if( left && ( ((datalen >> 3) & 0x7F) >= fill ) ) {\n   315\t    memcpy( (void *) (S->buf + left), (void *) data, fill );\n   316\t    S->t[0] += 1024;\n   317\t    blake512_compress( S, S->buf );\n   318\t    data += fill;\n   319\t    datalen  -= (fill << 3);       \n   320\t    left = 0;\n   321\t  }\n   322\t\n   323\t  while( datalen >= 1024 ) {  \n   324\t    S->t[0] += 1024;\n   325\t    blake512_compress( S, data );\n   326\t    data += 128;\n   327\t    datalen  -= 1024;\n   328\t  }\n   329\t\n   330\t  if( datalen > 0 ) {\n   331\t    memcpy( (void *) (S->buf + left), (void *) data, ( datalen>>3 ) & 0x7F );\n   332\t    S->buflen = (left<<3) + datalen;\n   333\t  }\n   334\t  else S->buflen=0;\n   335\t}\n   336\t\n   337\t\n   338\tvoid blake512_final( blakestate512 * S, u8 * digest ) {\n   339\t\n   340\t  u8 msglen[16], zo=0x01,oo=0x81;\n   341\t  u64 lo=S->t[0] + S->buflen, hi = S->t[1];\n   342\t  if ( lo < S->buflen ) hi++;\n   343\t  U64TO8(  msglen + 0, hi );\n   344\t  U64TO8(  msglen + 8, lo );\n   345\t\n   346\t  if ( S->buflen == 888 ) { /* one padding byte */\n   347\t    S->t[0] -= 8; \n   348\t    blake512_update( S, &oo, 8 );\n   349\t  }\n   350\t  else {\n   351\t    if ( S->buflen < 888 ) { /* enough space to fill the block */\n   352\t      if ( S->buflen == 0 ) S->nullt=1;\n   353\t      S->t[0] -= 888 - S->buflen;\n   354\t      blake512_update( S, padding, 888 - S->buflen );\n   355\t    }\n   356\t    else { /* NOT enough space, need 2 compressions */ \n   357\t      S->t[0] -= 1024 - S->buflen; \n   358\t      blake512_update( S, padding, 1024 - S->buflen );\n   359\t      S->t[0] -= 888;\n   360\t      blake512_update( S, padding+1, 888 );\n   361\t      S->nullt = 1;\n   362\t    }\n   363\t    blake512_update( S, &zo, 8 );\n   364\t    S->t[0] -= 8;\n   365\t  }\n   366\t  S->t[0] -= 128;\n   367\t  blake512_update( S, msglen, 128 );    \n   368\t\n   369\t  U64TO8( digest + 0, S->h[0]);\n   370\t  U64TO8( digest + 8, S->h[1]);\n   371\t  U64TO8( digest +16, S->h[2]);\n   372\t  U64TO8( digest +24, S->h[3]);\n   373\t  U64TO8( digest +32, S->h[4]);\n   374\t  U64TO8( digest +40, S->h[5]);\n   375\t  U64TO8( digest +48, S->h[6]);\n   376\t  U64TO8( digest +56, S->h[7]);\n   377\t}\n   378\t\n   379\tvoid blake512_mgf1(unsigned char *out, unsigned long outlen,\n   380\t\t\t   const unsigned char *in, unsigned long inlen)\n   381\t{\n   382\t    SPX_VLA(uint8_t, inbuf, inlen+4);\n   383\t    unsigned char outbuf[SPX_BLAKE512_OUTPUT_BYTES];\n   384\t    unsigned long i;\n   385\t\n   386\t    memcpy(inbuf, in, inlen);\n   387\t\n   388\t    /* While we can fit in at least another full block of BLAKE512 output.. */\n   389\t    for (i = 0; (i+1)*SPX_BLAKE512_OUTPUT_BYTES <= outlen; i++) {\n   390\t        u32_to_bytes(inbuf + inlen, i);\n   391\t        blake512(out, inbuf, inlen + 4);\n   392\t        out += SPX_BLAKE512_OUTPUT_BYTES;\n   393\t    }\n   394\t    /* Until we cannot anymore, and we fill the remainder. */\n   395\t    if (outlen > i*SPX_BLAKE512_OUTPUT_BYTES) {\n   396\t        u32_to_bytes(inbuf + inlen, i);\n   397\t        blake512(outbuf, inbuf, inlen + 4);\n   398\t        memcpy(out, outbuf, outlen - i*SPX_BLAKE512_OUTPUT_BYTES);\n   399\t    }\n   400\t}\n   401\t\n   402\tint blake512( unsigned char *out, const unsigned char *in, unsigned long long inlen ) {\n   403\t\n   404\t  blakestate512 S;\n   405\t  blake512_init( &S );\n   406\t  blake512_update( &S, in, inlen*8 );\n   407\t  blake512_final( &S, out );\n   408\t  return 0;\n   409\t}\n","exit_code":0,"status":"completed"}}
