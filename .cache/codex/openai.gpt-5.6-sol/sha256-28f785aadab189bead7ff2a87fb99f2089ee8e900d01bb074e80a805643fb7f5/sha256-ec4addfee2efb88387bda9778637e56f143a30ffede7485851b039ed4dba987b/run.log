t    memcpy( out, in, SPX_OFFSET_TREE+8 );\n    45\t}\n    46\t\n    47\t/* These functions are used for OTS addresses. */\n    48\t\n    49\t/*\n    50\t * Specify which Merkle leaf we're working on; that is, which OTS keypair\n    51\t * we're talking about.\n    52\t */\n    53\tvoid set_keypair_addr(uint32_t addr[8], uint32_t keypair)\n    54\t{\n    55\t    u32_to_bytes(&((unsigned char *)addr)[SPX_OFFSET_KP_ADDR], keypair);\n    56\t}\n    57\t\n    58\t/*\n    59\t * Copy the layer, tree and keypair fields of the address structure.  This is\n    60\t * used when we're doing multiple things within the same OTS keypair\n    61\t */\n    62\tvoid copy_keypair_addr(uint32_t out[8], const uint32_t in[8])\n    63\t{\n    64\t    memcpy( out, in, SPX_OFFSET_TREE+8 );\n    65\t    memcpy( (unsigned char *)out + SPX_OFFSET_KP_ADDR, (unsigned char *)in + SPX_OFFSET_KP_ADDR, 4); \n    66\t}\n    67\t\n    68\t/*\n    69\t * Specify which Merkle chain within the OTS we're working with\n    70\t * (the chain address)\n    71\t */\n    72\tvoid set_chain_addr(uint32_t addr[8], uint32_t chain)\n    73\t{\n    74\t    ((unsigned char *)addr)[SPX_OFFSET_CHAIN_ADDR] = (unsigned char)chain;\n    75\t}\n    76\t\n    77\t/*\n    78\t * Specify where in the Merkle chain we are\n    79\t* (the hash address)\n    80\t */\n    81\tvoid set_hash_addr(uint32_t addr[8], uint32_t hash)\n    82\t{\n    83\t    ((unsigned char *)addr)[SPX_OFFSET_HASH_ADDR] = (unsigned char)hash;\n    84\t}\n    85\t\n    86\t/* These functions are used for all hash tree addresses (including FORS). */\n    87\t\n    88\t/*\n    89\t * Specify the height of the node in the Merkle/FORS tree we are in\n    90\t * (the tree height)\n    91\t */\n    92\tvoid set_tree_height(uint32_t addr[8], uint32_t tree_height)\n    93\t{\n    94\t    ((unsigned char *)addr)[SPX_OFFSET_TREE_HGT] = (unsigned char)tree_height;\n    95\t}\n    96\t\n    97\t/*\n    98\t * Specify the distance from the left edge of the node in the Merkle/FORS tree\n    99\t * (the tree index)\n   100\t */\n   101\tvoid set_tree_index(uint32_t addr[8], uint32_t tree_index)\n   102\t{\n   103\t    u32_to_bytes(&((unsigned char *)addr)[SPX_OFFSET_TREE_INDEX], tree_index );\n   104\t}\n\n===== app/src/sign.c =====\n     1\t#include <stddef.h>\n     2\t#include <string.h>\n     3\t#include <stdint.h>\n     4\t\n     5\t#include \"../include/address.h\"\n     6\t#include \"../include/api.h\"\n     7\t#include \"../include/fors.h\"\n     8\t#include \"../include/hash.h\"\n     9\t#include \"../include/merkle.h\"\n    10\t#include \"../include/params.h\"\n    11\t#include \"../include/randombytes.h\"\n    12\t#include \"../include/thash.h\"\n    13\t#include \"../include/utils.h\"\n    14\t#include \"../include/wots.h\"\n    15\t\n    16\t/*\n    17\t * Returns the length of a secret key, in bytes\n    18\t */\n    19\tunsigned long long crypto_sign_secretkeybytes(void)\n    20\t{\n    21\t    return CRYPTO_SECRETKEYBYTES;\n    22\t}\n    23\t\n    24\t/*\n    25\t * Returns the length of a public key, in bytes\n    26\t */\n    27\tunsigned long long crypto_sign_publickeybytes(void)\n    28\t{\n    29\t    return CRYPTO_PUBLICKEYBYTES;\n    30\t}\n    31\t\n    32\t/*\n    33\t * Returns the length of a signature, in bytes\n    34\t */\n    35\tunsigned long long crypto_sign_bytes(void)\n    36\t{\n    37\t    return CRYPTO_BYTES;\n    38\t}\n    39\t\n    40\t/*\n    41\t * Returns the length of the seed required to generate a key pair, in bytes\n    42\t */\n    43\tunsigned long long crypto_sign_seedbytes(void)\n    44\t{\n    45\t    return CRYPTO_SEEDBYTES;\n    46\t}\n    47\t\n    48\t/*\n    49\t * Generates an SPX key pair given a seed of length\n    50\t * Format sk: [SK_SEED || SK_PRF || PUB_SEED || root]\n    51\t * Format pk: [PUB_SEED || root]\n    52\t */\n    53\tint crypto_sign_seed_keypair(unsigned char *pk, unsigned char *sk,\n    54\t                             const unsigned char *seed)\n    55\t{\n    56\t    spx_ctx ctx;\n    57\t\n    58\t    /* Initialize SK_SEED, SK_PRF and PUB_SEED from seed. */\n    59\t    memcpy(sk, seed, CRYPTO_SEEDBYTES);\n    60\t\n    61\t    memcpy(pk, sk + 2*SPX_N, SPX_N);\n    62\t\n    63\t    memcpy(ctx.pub_seed, pk, SPX_N);\n    64\t    memcpy(ctx.sk_seed, sk, SPX_N);\n    65\t\n    66\t    /* This hook allows the hash function instantiation to do whatever\n    67\t       preparation or computation it needs, based on the public seed. */\n    68\t    initialize_hash_function(&ctx);\n    69\t\n    70\t    /* Compute root node of the top-most subtree. */\n    71\t    merkle_gen_root(sk + 3*SPX_N, &ctx);\n    72\t\n    73\t    memcpy(pk + SPX_N, sk + 3*SPX_N, SPX_N);\n    74\t\n    75\t    return 0;\n    76\t}\n    77\t\n    78\t/*\n    79\t * Generates an SPX key pair.\n    80\t * Format sk: [SK_SEED || SK_PRF || PUB_SEED || root]\n    81\t * Format pk: [PUB_SEED || root]\n    82\t */\n    83\tint crypto_sign_keypair(unsigned char *pk, unsigned char *sk)\n    84\t{\n    85\t  unsigned char seed[CRYPTO_SEEDBYTES];\n    86\t  randombytes(seed, CRYPTO_SEEDBYTES);\n    87\t  crypto_sign_seed_keypair(pk, sk, seed);\n    88\t\n    89\t  return 0;\n    90\t}\n    91\t\n    92\t/**\n    93\t * Returns an array containing a detached signature.\n    94\t */\n    95\tint crypto_sign_signature(uint8_t *sig, size_t *siglen,\n    96\t                          const uint8_t *m, size_t mlen, const uint8_t *sk)\n    97\t{\n    98\t    spx_ctx ctx;\n    99\t\n   100\t    const unsigned char *sk_prf = sk + SPX_N;\n   101\t    const unsigned char *pk = sk + 2*SPX_N;\n   102\t\n   103\t    unsigned char optrand[SPX_N];\n   104\t    unsigned char mhash[SPX_FORS_MSG_BYTES];\n   105\t    unsigned char root[SPX_N];\n   106\t    uint32_t i;\n   107\t    uint64_t tree;\n   108\t    uint32_t idx_leaf;\n   109\t    uint32_t wots_addr[8] = {0};\n   110\t    uint32_t tree_addr[8] = {0};\n   111\t\n   112\t    memcpy(ctx.sk_seed, sk, SPX_N);\n   113\t    memcpy(ctx.pub_seed, pk, SPX_N);\n   114\t\n   115\t    /* This hook allows the hash function instantiation to do whatever\n   116\t       preparation or computation it needs, based on the public seed. */\n   117\t    initialize_hash_function(&ctx);\n   118\t\n   119\t    set_type(wots_addr, SPX_ADDR_TYPE_WOTS);\n   120\t    set_type(tree_addr, SPX_ADDR_TYPE_HASHTREE);\n   121\t\n   122\t    /* Optionally, signing can be made non-deterministic using optrand.\n   123\t       This can help counter side-channel attacks that would benefit from\n   124\t       getting a large number of traces when the signer uses the same nodes. */\n   125\t    randombytes(optrand, SPX_N);\n   126\t    /* Compute the digest randomization value. */\n   127\t    gen_message_random(sig, sk_prf, optrand, m, mlen, &ctx);\n   128\t\n   129\t    /* Derive the message digest and leaf index from R, PK and M. */\n   130\t    hash_message(mhash, &tree, &idx_leaf, sig, pk, m, mlen, &ctx);\n   131\t    sig += SPX_N;\n   132\t\n   133\t    set_tree_addr(wots_addr, tree);\n   134\t    set_keypair_addr(wots_addr, idx_leaf);\n   135\t\n   136\t    /* Sign the message hash using FORS. */\n   137\t    fors_sign(sig, root, mhash, &ctx, wots_addr);\n   138\t    sig += SPX_FORS_BYTES;\n   139\t\n   140\t    for (i = 0; i < SPX_D; i++) {\n   141\t        set_layer_addr(tree_addr, i);\n   142\t        set_tree_addr(tree_addr, tree);\n   143\t\n   144\t        copy_subtree_addr(wots_addr, tree_addr);\n   145\t        set_keypair_addr(wots_addr, idx_leaf);\n   146\t\n   147\t        merkle_sign(sig, root, &ctx, wots_addr, tree_addr, idx_leaf);\n   148\t        sig += SPX_WOTS_BYTES + SPX_TREE_HEIGHT * SPX_N;\n   149\t\n   150\t        /* Update the indices for the next layer. */\n   151\t        idx_leaf = (tree & ((1 << SPX_TREE_HEIGHT)-1));\n   152\t        tree = tree >> SPX_TREE_HEIGHT;\n   153\t    }\n   154\t\n   155\t    *siglen = SPX_BYTES;\n   156\t\n   157\t    return 0;\n   158\t}\n   159\t\n   160\t/**\n   161\t * Verifies a detached signature and message under a given public key.\n   162\t */\n   163\tint crypto_sign_verify(const uint8_t *sig, size_t siglen,\n   164\t                       const uint8_t *m, size_t mlen, const uint8_t *pk)\n   165\t{\n   166\t    spx_ctx ctx;\n   167\t    const unsigned char *pub_root = pk + SPX_N;\n   168\t    unsigned char mhash[SPX_FORS_MSG_BYTES];\n   169\t    unsigned char wots_pk[SPX_WOTS_BYTES];\n   170\t    unsigned char root[SPX_N];\n   171\t    unsigned char leaf[SPX_N];\n   172\t    unsigned int i;\n   173\t    uint64_t tree;\n   174\t    uint32_t idx_leaf;\n   175\t    uint32_t wots_addr[8] = {0};\n   176\t    uint32_t tree_addr[8] = {0};\n   177\t    uint32_t wots_pk_addr[8] = {0};\n   178\t\n   179\t    if (siglen != SPX_BYTES) {\n   180\t        return -1;\n   181\t    }\n   182\t\n   183\t    memcpy(ctx.pub_seed, pk, SPX_N);\n   184\t\n   185\t    /* This hook allows the hash function instantiation to do whatever\n   186\t       preparation or computation it needs, based on the public seed. */\n   187\t    initialize_hash_function(&ctx);\n   188\t\n   189\t    set_type(wots_addr, SPX_ADDR_TYPE_WOTS);\n   190\t    set_type(tree_addr, SPX_ADDR_TYPE_HASHTREE);\n   191\t    set_type(wots_pk_addr, SPX_ADDR_TYPE_WOTSPK);\n   192\t\n   193\t    /* Derive the message digest and leaf index from R || PK || M. */\n   194\t    /* The additional SPX_N is a result of the hash domain separator. */\n   195\t    hash_message(mhash, &tree, &idx_leaf, sig, pk, m, mlen, &ctx);\n   196\t    sig += SPX_N;\n   197\t\n   198\t    /* Layer correctly defaults to 0, so no need to set_layer_addr */\n   199\t    set_tree_addr(wots_addr, tree);\n   200\t    set_keypair_addr(wots_addr, idx_leaf);\n   201\t\n   202\t    fors_pk_from_sig(root, sig, mhash, &ctx, wots_addr);\n   203\t    sig += SPX_FORS_BYTES;\n   204\t\n   205\t    /* For each subtree.. */\n   206\t    for (i = 0; i < SPX_D; i++) {\n   207\t        set_layer_addr(tree_addr, i);\n   208\t        set_tree_addr(tree_addr, tree);\n   209\t\n   210\t        copy_subtree_addr(wots_addr, tree_addr);\n   211\t        set_keypair_addr(wots_addr, idx_leaf);\n   212\t\n   213\t        copy_keypair_addr(wots_pk_addr, wots_addr);\n   214\t\n   215\t        /* The WOTS public key is only correct if the signature was correct. */\n   216\t        /* Initially, root is the FORS pk, but on subsequent iterations it is\n   217\t           the root of the subtree below the currently processed subtree. */\n   218\t        wots_pk_from_sig(wots_pk, sig, root, &ctx, wots_addr);\n   219\t        sig += SPX_WOTS_BYTES;\n   220\t\n   221\t        /* Compute the leaf node using the WOTS public key. */\n   222\t        thash(leaf, wots_pk, SPX_WOTS_LEN, &ctx, wots_pk_addr);\n   223\t\n   224\t        /* Compute the root node of this subtree. */\n   225\t        compute_root(root, leaf, idx_leaf, 0, sig, SPX_TREE_HEIGHT,\n   226\t                     &ctx, tree_addr);\n   227\t        sig += SPX_TREE_HEIGHT * SPX_N;\n   228\t\n   229\t        /* Update the indices for the next layer. */\n   230\t        idx_leaf = (tree & ((1 << SPX_TREE_HEIGHT)-1));\n   231\t        tree = tree >> SPX_TREE_HEIGHT;\n   232\t    }\n   233\t\n   234\t    /* Check if the root node equals the root node in the public key. */\n   235\t    if (memcmp(root, pub_root, SPX_N)) {\n   236\t        return -1;\n   237\t    }\n   238\t\n   239\t    return 0;\n   240\t}\n   241\t\n   242\t\n   243\t/**\n   244\t * Returns an array containing the signature followed by the message.\n   245\t */\n   246\tint crypto_sign(unsigned char *sm, unsigned long long *smlen,\n   247\t                const unsigned char *m, unsigned long long mlen,\n   248\t                const unsigned char *sk)\n   249\t{\n   250\t    size_t siglen;\n   251\t\n   252\t    crypto_sign_signature(sm, &siglen, m, (size_t)mlen, sk);\n   253\t\n   254\t    memmove(sm + SPX_BYTES, m, mlen);\n   255\t    *smlen = siglen + mlen;\n   256\t\n   257\t    return 0;\n   258\t}\n   259\t\n   260\t/**\n   261\t * Verifies a given signature-message pair under a given public key.\n   262\t */\n   263\tint crypto_sign_open(unsigned char *m, unsigned long long *mlen,\n   264\t                     const unsigned char *sm, unsigned long long smlen,\n   265\t                     const unsigned char *pk)\n   266\t{\n   267\t    /* The API caller does not necessarily know what size a signature should be\n   268\t       but SPHINCS+ signatures are always exactly SPX_BYTES. */\n   269\t    if (smlen < SPX_BYTES) {\n   270\t        memset(m, 0, smlen);\n   271\t        *mlen = 0;\n   272\t        return -1;\n   273\t    }\n   274\t\n   275\t    *mlen = smlen - SPX_BYTES;\n   276\t\n   277\t    if (crypto_sign_verify(sm, SPX_BYTES, sm + SPX_BYTES, (size_t)*mlen, pk)) {\n   278\t        memset(m, 0, smlen);\n   279\t        *mlen = 0;\n   280\t        return -1;\n   281\t    }\n   282\t\n   283\t    /* If verification was successful, move the message to the right place. */\n   284\t    memmove(m, sm + SPX_BYTES, *mlen);\n   285\t\n   286\t    return 0;\n   287\t}\n\n===== app/src/rng.c =====\n     1\t//\n     2\t//  rng.c\n     3\t//\n     4\t//  Created by Bassham, Lawrence E (Fed) on 8/29/17.\n     5\t//  Copyright © 2017 Bassham, Lawrence E (Fed). All rights reserved.\n     6\t//\n     7\t\n     8\t#include <string.h>\n     9\t#include <openssl/conf.h>\n    10\t#include <openssl/evp.h>\n    11\t#include <openssl/err.h>\n    12\t\n    13\t#include \"../include/rng.h\"\n    14\t\n    15\tAES256_CTR_DRBG_struct  DRBG_ctx;\n    16\t\n    17\tvoid    AES256_ECB(unsigned char *key, unsigned char *ctr, unsigned char *buffer);\n    18\t\n    19\t/*\n    20\t seedexpander_init()\n    21\t ctx            - stores the current state of an instance of the seed expander\n    22\t seed           - a 32 byte random value\n    23\t diversifier    - an 8 byte diversifier\n    24\t maxlen         - maximum number of bytes (less than 2**32) generated under this seed and diversifier\n    25\t */\n    26\tint\n    27\tseedexpander_init(AES_XOF_struct *ctx,\n    28\t                  unsigned char *seed,\n    29\t                  unsigned char *diversifier,\n    30\t                  unsigned long maxlen)\n    31\t{\n    32\t    if ( maxlen >= 0x100000000 )\n    33\t        return RNG_BAD_MAXLEN;\n    34\t    \n    35\t    ctx->length_remaining = maxlen;\n    36\t    \n    37\t    memcpy(ctx->key, seed, 32);\n    38\t    \n    39\t    memcpy(ctx->ctr, diversifier, 8);\n    40\t    ctx->ctr[11] = (unsigned char)(maxlen % 256);\n    41\t    maxlen >>= 8;\n    42\t    ctx->ctr[10] = (unsigned char)(maxlen % 256);\n    43\t    maxlen >>= 8;\n    44\t    ctx->ctr[9] = (unsigned char)(maxlen % 256);\n    45\t    maxlen >>= 8;\n    46\t    ctx->ctr[8] = (unsigned char)(maxlen % 256);\n    47\t    memset(ctx->ctr+12, 0x00, 4);\n    48\t    \n    49\t    ctx->buffer_pos = 16;\n    50\t    memset(ctx->buffer, 0x00, 16);\n    51\t    \n    52\t    return RNG_SUCCESS;\n    53\t}\n    54\t\n    55\t/*\n    56\t seedexpander()\n    57\t    ctx  - stores the current state of an instance of the seed expander\n    58\t    x    - returns the XOF data\n    59\t    xlen - number of bytes to return\n    60\t */\n    61\tint\n    62\tseedexpander(AES_XOF_struct *ctx, unsigned char *x, unsigned long xlen)\n    63\t{\n    64\t    unsigned long   offset;\n    65\t    \n    66\t    if ( x == NULL )\n    67\t        return RNG_BAD_OUTBUF;\n    68\t    if ( xlen >= ctx->length_remaining )\n    69\t        return RNG_BAD_REQ_LEN;\n    70\t    \n    71\t    ctx->length_remaining -= xlen;\n    72\t    \n    73\t    offset = 0;\n    74\t    while ( xlen > 0 ) {\n    75\t        if ( xlen <= (16-ctx->buffer_pos) ) { // buffer has what we need\n    76\t            memcpy(x+offset, ctx->buffer+ctx->buffer_pos, xlen);\n    77\t            ctx->buffer_pos += xlen;\n    78\t            \n    79\t            return RNG_SUCCESS;\n    80\t        }\n    81\t        \n    82\t        // take what's in the buffer\n    83\t        memcpy(x+offset, ctx->buffer+ctx->buffer_pos, 16-ctx->buffer_pos);\n    84\t        xlen -= 16-ctx->buffer_pos;\n    85\t        offset += 16-ctx->buffer_pos;\n    86\t        \n    87\t        AES256_ECB(ctx->key, ctx->ctr, ctx->buffer);\n    88\t        ctx->buffer_pos = 0;\n    89\t        \n    90\t        //increment the counter\n    91\t        for (int i=15; i>=12; i--) {\n    92\t            if ( ctx->ctr[i] == 0xff )\n    93\t                ctx->ctr[i] = 0x00;\n    94\t            else {\n    95\t                ctx->ctr[i]++;\n    96\t                break;\n    97\t            }\n    98\t        }\n    99\t        \n   100\t    }\n   101\t    \n   102\t    return RNG_SUCCESS;\n   103\t}\n   104\t\n   105\t\n   106\tstatic void handleErrors(void)\n   107\t{\n   108\t    ERR_print_errors_fp(stderr);\n   109\t    abort();\n   110\t}\n   111\t\n   112\t// Use whatever AES implementation you have. This uses AES from openSSL library\n   113\t//    key - 256-bit AES key\n   114\t//    ctr - a 128-bit plaintext value\n   115\t//    buffer - a 128-bit ciphertext value\n   116\tvoid\n   117\tAES256_ECB(unsigned char *key, unsigned char *ctr, unsigned char *buffer)\n   118\t{\n   119\t    EVP_CIPHER_CTX *ctx;\n   120\t    \n   121\t    int len;\n   122\t    \n   123\t    /* Create and initialise the context */\n   124\t    if(!(ctx = EVP_CIPHER_CTX_new())) handleErrors();\n   125\t    \n   126\t    if(1 != EVP_EncryptInit_ex(ctx, EVP_aes_256_ecb(), NULL, key, NULL))\n   127\t        handleErrors();\n   128\t    \n   129\t    if(1 != EVP_EncryptUpdate(ctx, buffer, &len, ctr, 16))\n   130\t        handleErrors();\n   131\t    \n   132\t    /* Clean up */\n   133\t    EVP_CIPHER_CTX_free(ctx);\n   134\t}\n   135\t\n   136\tvoid\n   137\trandombytes_init(unsigned char *entropy_input,\n   138\t                 unsigned char *personalization_string)\n   139\t{\n   140\t    unsigned char   seed_material[48];\n   141\t    \n   142\t    memcpy(seed_material, entropy_input, 48);\n   143\t    if (personalization_string)\n   144\t        for (int i=0; i<48; i++)\n   145\t            seed_material[i] ^= personalization_string[i];\n   146\t    memset(DRBG_ctx.Key, 0x00, 32);\n   147\t    memset(DRBG_ctx.V, 0x00, 16);\n   148\t    AES256_CTR_DRBG_Update(seed_material, DRBG_ctx.Key, DRBG_ctx.V);\n   149\t    DRBG_ctx.reseed_counter = 1;\n   150\t}\n   151\t\n   152\tint\n   153\trandombytes(unsigned char *x, unsigned long long xlen)\n   154\t{\n   155\t    unsigned char   block[16];\n   156\t    int             i = 0;\n   157\t    \n   158\t    while ( xlen > 0 ) {\n   159\t        //increment V\n   160\t        for (int j=15; j>=0; j--) {\n   161\t            if ( DRBG_ctx.V[j] == 0xff )\n   162\t                DRBG_ctx.V[j] = 0x00;\n   163\t            else {\n   164\t                DRBG_ctx.V[j]++;\n   165\t                break;\n   166\t            }\n   167\t        }\n   168\t        AES256_ECB(DRBG_ctx.Key, DRBG_ctx.V, block);\n   169\t        if ( xlen > 15 ) {\n   170\t            memcpy(x+i, block, 16);\n   171\t            i += 16;\n   172\t            xlen -= 16;\n   173\t        }\n   174\t        else {\n   175\t            memcpy(x+i, block, xlen);\n   176\t            xlen = 0;\n   177\t        }\n   178\t    }\n   179\t    AES256_CTR_DRBG_Update(NULL, DRBG_ctx.Key, DRBG_ctx.V);\n   180\t    DRBG_ctx.reseed_counter++;\n   181\t    \n   182\t    return RNG_SUCCESS;\n   183\t}\n   184\t\n   185\tvoid\n   186\tAES256_CTR_DRBG_Update(unsigned char *provided_data,\n   187\t                       unsigned char *Key,\n   188\t                       unsigned char *V)\n   189\t{\n   190\t    unsigned char   temp[48];\n   191\t    \n   192\t    for (int i=0; i<3; i++) {\n   193\t        //increment V\n   194\t        for (int j=15; j>=0; j--) {\n   195\t            if ( V[j] == 0xff )\n   196\t                V[j] = 0x00;\n   197\t            else {\n   198\t                V[j]++;\n   199\t                break;\n   200\t            }\n   201\t        }\n   202\t        \n   203\t        AES256_ECB(Key, V, temp+16*i);\n   204\t    }\n   205\t    if ( provided_data != NULL )\n   206\t        for (int i=0; i<48; i++)\n   207\t            temp[i] ^= provided_data[i];\n   208\t    memcpy(Key, temp, 32);\n   209\t    memcpy(V, temp+32, 16);\n   210\t}\n   211\t\n   212\t\n   213\t\n   214\t\n   215\t\n   216\t\n   217\t\n   218\t\n   219\t\n","exit_code":0,"status":"completed"}}
