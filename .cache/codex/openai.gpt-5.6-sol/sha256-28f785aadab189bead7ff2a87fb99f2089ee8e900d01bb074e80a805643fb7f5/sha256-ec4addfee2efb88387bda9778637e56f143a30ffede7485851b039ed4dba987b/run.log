{"type":"item.completed","item":{"id":"item_52","type":"command_execution","command":"/bin/zsh -lc \"nl -ba lib/shake/src/fips202.c | sed -n '330,640p'; nl -ba lib/shake/include/fips202.h\"","aggregated_output":"   330\t    state[23] = Aso;\n   331\t    state[24] = Asu;\n   332\t}\n   333\t\n   334\t/*************************************************\n   335\t * Name:        keccak_absorb\n   336\t *\n   337\t * Description: Absorb step of Keccak;\n   338\t *              non-incremental, starts by zeroeing the state.\n   339\t *\n   340\t * Arguments:   - uint64_t *s: pointer to (uninitialized) output Keccak state\n   341\t *              - uint32_t r: rate in bytes (e.g., 168 for SHAKE128)\n   342\t *              - const uint8_t *m: pointer to input to be absorbed into s\n   343\t *              - size_t mlen: length of input in bytes\n   344\t *              - uint8_t p: domain-separation byte for different\n   345\t *                                 Keccak-derived functions\n   346\t **************************************************/\n   347\tstatic void keccak_absorb(uint64_t *s, uint32_t r, const uint8_t *m,\n   348\t                          size_t mlen, uint8_t p) {\n   349\t    size_t i;\n   350\t    uint8_t t[200];\n   351\t\n   352\t    /* Zero state */\n   353\t    for (i = 0; i < 25; ++i) {\n   354\t        s[i] = 0;\n   355\t    }\n   356\t\n   357\t    while (mlen >= r) {\n   358\t        for (i = 0; i < r / 8; ++i) {\n   359\t            s[i] ^= load64(m + 8 * i);\n   360\t        }\n   361\t\n   362\t        KeccakF1600_StatePermute(s);\n   363\t        mlen -= r;\n   364\t        m += r;\n   365\t    }\n   366\t\n   367\t    for (i = 0; i < r; ++i) {\n   368\t        t[i] = 0;\n   369\t    }\n   370\t    for (i = 0; i < mlen; ++i) {\n   371\t        t[i] = m[i];\n   372\t    }\n   373\t    t[i] = p;\n   374\t    t[r - 1] |= 128;\n   375\t    for (i = 0; i < r / 8; ++i) {\n   376\t        s[i] ^= load64(t + 8 * i);\n   377\t    }\n   378\t}\n   379\t\n   380\t/*************************************************\n   381\t * Name:        keccak_squeezeblocks\n   382\t *\n   383\t * Description: Squeeze step of Keccak. Squeezes full blocks of r bytes each.\n   384\t *              Modifies the state. Can be called multiple times to keep\n   385\t *              squeezing, i.e., is incremental.\n   386\t *\n   387\t * Arguments:   - uint8_t *h: pointer to output blocks\n   388\t *              - size_t nblocks: number of blocks to be\n   389\t *                                                squeezed (written to h)\n   390\t *              - uint64_t *s: pointer to input/output Keccak state\n   391\t *              - uint32_t r: rate in bytes (e.g., 168 for SHAKE128)\n   392\t **************************************************/\n   393\tstatic void keccak_squeezeblocks(uint8_t *h, size_t nblocks,\n   394\t                                 uint64_t *s, uint32_t r) {\n   395\t    while (nblocks > 0) {\n   396\t        KeccakF1600_StatePermute(s);\n   397\t        for (size_t i = 0; i < (r >> 3); i++) {\n   398\t            store64(h + 8 * i, s[i]);\n   399\t        }\n   400\t        h += r;\n   401\t        nblocks--;\n   402\t    }\n   403\t}\n   404\t\n   405\t/*************************************************\n   406\t * Name:        keccak_inc_init\n   407\t *\n   408\t * Description: Initializes the incremental Keccak state to zero.\n   409\t *\n   410\t * Arguments:   - uint64_t *s_inc: pointer to input/output incremental state\n   411\t *                First 25 values represent Keccak state.\n   412\t *                26th value represents either the number of absorbed bytes\n   413\t *                that have not been permuted, or not-yet-squeezed bytes.\n   414\t **************************************************/\n   415\tstatic void keccak_inc_init(uint64_t *s_inc) {\n   416\t    size_t i;\n   417\t\n   418\t    for (i = 0; i < 25; ++i) {\n   419\t        s_inc[i] = 0;\n   420\t    }\n   421\t    s_inc[25] = 0;\n   422\t}\n   423\t\n   424\t/*************************************************\n   425\t * Name:        keccak_inc_absorb\n   426\t *\n   427\t * Description: Incremental keccak absorb\n   428\t *              Preceded by keccak_inc_init, succeeded by keccak_inc_finalize\n   429\t *\n   430\t * Arguments:   - uint64_t *s_inc: pointer to input/output incremental state\n   431\t *                First 25 values represent Keccak state.\n   432\t *                26th value represents either the number of absorbed bytes\n   433\t *                that have not been permuted, or not-yet-squeezed bytes.\n   434\t *              - uint32_t r: rate in bytes (e.g., 168 for SHAKE128)\n   435\t *              - const uint8_t *m: pointer to input to be absorbed into s\n   436\t *              - size_t mlen: length of input in bytes\n   437\t **************************************************/\n   438\tstatic void keccak_inc_absorb(uint64_t *s_inc, uint32_t r, const uint8_t *m,\n   439\t                              size_t mlen) {\n   440\t    size_t i;\n   441\t\n   442\t    /* Recall that s_inc[25] is the non-absorbed bytes xored into the state */\n   443\t    while (mlen + s_inc[25] >= r) {\n   444\t        for (i = 0; i < r - s_inc[25]; i++) {\n   445\t            /* Take the i'th byte from message\n   446\t               xor with the s_inc[25] + i'th byte of the state; little-endian */\n   447\t            s_inc[(s_inc[25] + i) >> 3] ^= (uint64_t)m[i] << (8 * ((s_inc[25] + i) & 0x07));\n   448\t        }\n   449\t        mlen -= (size_t)(r - s_inc[25]);\n   450\t        m += r - s_inc[25];\n   451\t        s_inc[25] = 0;\n   452\t\n   453\t        KeccakF1600_StatePermute(s_inc);\n   454\t    }\n   455\t\n   456\t    for (i = 0; i < mlen; i++) {\n   457\t        s_inc[(s_inc[25] + i) >> 3] ^= (uint64_t)m[i] << (8 * ((s_inc[25] + i) & 0x07));\n   458\t    }\n   459\t    s_inc[25] += mlen;\n   460\t}\n   461\t\n   462\t/*************************************************\n   463\t * Name:        keccak_inc_finalize\n   464\t *\n   465\t * Description: Finalizes Keccak absorb phase, prepares for squeezing\n   466\t *\n   467\t * Arguments:   - uint64_t *s_inc: pointer to input/output incremental state\n   468\t *                First 25 values represent Keccak state.\n   469\t *                26th value represents either the number of absorbed bytes\n   470\t *                that have not been permuted, or not-yet-squeezed bytes.\n   471\t *              - uint32_t r: rate in bytes (e.g., 168 for SHAKE128)\n   472\t *              - uint8_t p: domain-separation byte for different\n   473\t *                                 Keccak-derived functions\n   474\t **************************************************/\n   475\tstatic void keccak_inc_finalize(uint64_t *s_inc, uint32_t r, uint8_t p) {\n   476\t    /* After keccak_inc_absorb, we are guaranteed that s_inc[25] < r,\n   477\t       so we can always use one more byte for p in the current state. */\n   478\t    s_inc[s_inc[25] >> 3] ^= (uint64_t)p << (8 * (s_inc[25] & 0x07));\n   479\t    s_inc[(r - 1) >> 3] ^= (uint64_t)128 << (8 * ((r - 1) & 0x07));\n   480\t    s_inc[25] = 0;\n   481\t}\n   482\t\n   483\t/*************************************************\n   484\t * Name:        keccak_inc_squeeze\n   485\t *\n   486\t * Description: Incremental Keccak squeeze; can be called on byte-level\n   487\t *\n   488\t * Arguments:   - uint8_t *h: pointer to output bytes\n   489\t *              - size_t outlen: number of bytes to be squeezed\n   490\t *              - uint64_t *s_inc: pointer to input/output incremental state\n   491\t *                First 25 values represent Keccak state.\n   492\t *                26th value represents either the number of absorbed bytes\n   493\t *                that have not been permuted, or not-yet-squeezed bytes.\n   494\t *              - uint32_t r: rate in bytes (e.g., 168 for SHAKE128)\n   495\t **************************************************/\n   496\tstatic void keccak_inc_squeeze(uint8_t *h, size_t outlen,\n   497\t                               uint64_t *s_inc, uint32_t r) {\n   498\t    size_t i;\n   499\t\n   500\t    /* First consume any bytes we still have sitting around */\n   501\t    for (i = 0; i < outlen && i < s_inc[25]; i++) {\n   502\t        /* There are s_inc[25] bytes left, so r - s_inc[25] is the first\n   503\t           available byte. We consume from there, i.e., up to r. */\n   504\t        h[i] = (uint8_t)(s_inc[(r - s_inc[25] + i) >> 3] >> (8 * ((r - s_inc[25] + i) & 0x07)));\n   505\t    }\n   506\t    h += i;\n   507\t    outlen -= i;\n   508\t    s_inc[25] -= i;\n   509\t\n   510\t    /* Then squeeze the remaining necessary blocks */\n   511\t    while (outlen > 0) {\n   512\t        KeccakF1600_StatePermute(s_inc);\n   513\t\n   514\t        for (i = 0; i < outlen && i < r; i++) {\n   515\t            h[i] = (uint8_t)(s_inc[i >> 3] >> (8 * (i & 0x07)));\n   516\t        }\n   517\t        h += i;\n   518\t        outlen -= i;\n   519\t        s_inc[25] = r - i;\n   520\t    }\n   521\t}\n   522\t\n   523\tvoid shake256_inc_init(uint64_t *s_inc) {\n   524\t    keccak_inc_init(s_inc);\n   525\t}\n   526\t\n   527\tvoid shake256_inc_absorb(uint64_t *s_inc, const uint8_t *input, size_t inlen) {\n   528\t    keccak_inc_absorb(s_inc, SHAKE256_RATE, input, inlen);\n   529\t}\n   530\t\n   531\tvoid shake256_inc_finalize(uint64_t *s_inc) {\n   532\t    keccak_inc_finalize(s_inc, SHAKE256_RATE, 0x1F);\n   533\t}\n   534\t\n   535\tvoid shake256_inc_squeeze(uint8_t *output, size_t outlen, uint64_t *s_inc) {\n   536\t    keccak_inc_squeeze(output, outlen, s_inc, SHAKE256_RATE);\n   537\t}\n   538\t\n   539\t/*************************************************\n   540\t * Name:        shake256_absorb\n   541\t *\n   542\t * Description: Absorb step of the SHAKE256 XOF.\n   543\t *              non-incremental, starts by zeroeing the state.\n   544\t *\n   545\t * Arguments:   - uint64_t *s: pointer to (uninitialized) output Keccak state\n   546\t *              - const uint8_t *input: pointer to input to be absorbed\n   547\t *                                            into s\n   548\t *              - size_t inlen: length of input in bytes\n   549\t **************************************************/\n   550\tvoid shake256_absorb(uint64_t *s, const uint8_t *input, size_t inlen) {\n   551\t    keccak_absorb(s, SHAKE256_RATE, input, inlen, 0x1F);\n   552\t}\n   553\t\n   554\t/*************************************************\n   555\t * Name:        shake256_squeezeblocks\n   556\t *\n   557\t * Description: Squeeze step of SHAKE256 XOF. Squeezes full blocks of\n   558\t *              SHAKE256_RATE bytes each. Modifies the state. Can be called\n   559\t *              multiple times to keep squeezing, i.e., is incremental.\n   560\t *\n   561\t * Arguments:   - uint8_t *output: pointer to output blocks\n   562\t *              - size_t nblocks: number of blocks to be squeezed\n   563\t *                                (written to output)\n   564\t *              - uint64_t *s: pointer to input/output Keccak state\n   565\t **************************************************/\n   566\tvoid shake256_squeezeblocks(uint8_t *output, size_t nblocks, uint64_t *s) {\n   567\t    keccak_squeezeblocks(output, nblocks, s, SHAKE256_RATE);\n   568\t}\n   569\t\n   570\t/*************************************************\n   571\t * Name:        shake256\n   572\t *\n   573\t * Description: SHAKE256 XOF with non-incremental API\n   574\t *\n   575\t * Arguments:   - uint8_t *output: pointer to output\n   576\t *              - size_t outlen: requested output length in bytes\n   577\t *              - const uint8_t *input: pointer to input\n   578\t *              - size_t inlen: length of input in bytes\n   579\t **************************************************/\n   580\tvoid shake256(uint8_t *output, size_t outlen,\n   581\t              const uint8_t *input, size_t inlen) {\n   582\t    size_t nblocks = outlen / SHAKE256_RATE;\n   583\t    uint8_t t[SHAKE256_RATE];\n   584\t    uint64_t s[25];\n   585\t\n   586\t    shake256_absorb(s, input, inlen);\n   587\t    shake256_squeezeblocks(output, nblocks, s);\n   588\t\n   589\t    output += nblocks * SHAKE256_RATE;\n   590\t    outlen -= nblocks * SHAKE256_RATE;\n   591\t\n   592\t    if (outlen) {\n   593\t        shake256_squeezeblocks(t, 1, s);\n   594\t        for (size_t i = 0; i < outlen; ++i) {\n   595\t            output[i] = t[i];\n   596\t        }\n   597\t    }\n   598\t}\n     1\t#ifndef SPX_FIPS202_H\n     2\t#define SPX_FIPS202_H\n     3\t\n     4\t#include <stddef.h>\n     5\t#include <stdint.h>\n     6\t\n     7\t#define SHAKE128_RATE 168\n     8\t#define SHAKE256_RATE 136\n     9\t#define SHA3_256_RATE 136\n    10\t#define SHA3_512_RATE 72\n    11\t\n    12\tvoid shake128_absorb(uint64_t *s, const uint8_t *input, size_t inlen);\n    13\t\n    14\tvoid shake128_squeezeblocks(uint8_t *output, size_t nblocks, uint64_t *s);\n    15\t\n    16\tvoid shake128_inc_init(uint64_t *s_inc);\n    17\tvoid shake128_inc_absorb(uint64_t *s_inc, const uint8_t *input, size_t inlen);\n    18\tvoid shake128_inc_finalize(uint64_t *s_inc);\n    19\tvoid shake128_inc_squeeze(uint8_t *output, size_t outlen, uint64_t *s_inc);\n    20\t\n    21\tvoid shake256_absorb(uint64_t *s, const uint8_t *input, size_t inlen);\n    22\tvoid shake256_squeezeblocks(uint8_t *output, size_t nblocks, uint64_t *s);\n    23\t\n    24\tvoid shake256_inc_init(uint64_t *s_inc);\n    25\tvoid shake256_inc_absorb(uint64_t *s_inc, const uint8_t *input, size_t inlen);\n    26\tvoid shake256_inc_finalize(uint64_t *s_inc);\n    27\tvoid shake256_inc_squeeze(uint8_t *output, size_t outlen, uint64_t *s_inc);\n    28\t\n    29\tvoid shake128(uint8_t *output, size_t outlen,\n    30\t              const uint8_t *input, size_t inlen);\n    31\t\n    32\tvoid shake256(uint8_t *output, size_t outlen,\n    33\t              const uint8_t *input, size_t inlen);\n    34\t\n    35\tvoid sha3_256_inc_init(uint64_t *s_inc);\n    36\tvoid sha3_256_inc_absorb(uint64_t *s_inc, const uint8_t *input, size_t inlen);\n    37\tvoid sha3_256_inc_finalize(uint8_t *output, uint64_t *s_inc);\n    38\t\n    39\tvoid sha3_256(uint8_t *output, const uint8_t *input, size_t inlen);\n    40\t\n    41\tvoid sha3_512_inc_init(uint64_t *s_inc);\n    42\tvoid sha3_512_inc_absorb(uint64_t *s_inc, const uint8_t *input, size_t inlen);\n    43\tvoid sha3_512_inc_finalize(uint8_t *output, uint64_t *s_inc);\n    44\t\n    45\tvoid sha3_512(uint8_t *output, const uint8_t *input, size_t inlen);\n    46\t\n    47\t#endif\n","exit_code":0,"status":"completed"}}
