-> [u8; 32] {\n   124\t        let lo = self.t[0].wrapping_add(self.buflen as u32);\n   125\t        let hi = self.t[1].wrapping_add((lo < self.buflen as u32) as u32);\n   126\t        let mut msglen = [0u8; 8];\n   127\t        msglen[..4].copy_from_slice(&hi.to_be_bytes());\n   128\t        msglen[4..].copy_from_slice(&lo.to_be_bytes());\n   129\t        let mut padding = [0u8; 64];\n   130\t        padding[0] = 0x80;\n   131\t\n   132\t        if self.buflen == 440 {\n   133\t            self.t[0] = self.t[0].wrapping_sub(8);\n   134\t            self.update_bits(&[0x81], 8);\n   135\t        } else {\n   136\t            if self.buflen < 440 {\n   137\t                if self.buflen == 0 {\n   138\t                    self.nullt = 1;\n   139\t                }\n   140\t                let bits = (440 - self.buflen) as u64;\n   141\t                self.t[0] = self.t[0].wrapping_sub(bits as u32);\n   142\t                self.update_bits(&padding, bits);\n   143\t            } else {\n   144\t                let bits = (512 - self.buflen) as u64;\n   145\t                self.t[0] = self.t[0].wrapping_sub(bits as u32);\n   146\t                self.update_bits(&padding, bits);\n   147\t                self.t[0] = self.t[0].wrapping_sub(440);\n   148\t                self.update_bits(&padding[1..], 440);\n   149\t                self.nullt = 1;\n   150\t            }\n   151\t            self.update_bits(&[0x01], 8);\n   152\t            self.t[0] = self.t[0].wrapping_sub(8);\n   153\t        }\n   154\t        self.t[0] = self.t[0].wrapping_sub(64);\n   155\t        self.update_bits(&msglen, 64);\n   156\t        let mut out = [0u8; 32];\n   157\t        for (bytes, word) in out.chunks_exact_mut(4).zip(self.h) {\n   158\t            bytes.copy_from_slice(&word.to_be_bytes());\n   159\t        }\n   160\t        out\n   161\t    }\n   162\t}\n   163\t\n   164\tfn g32(\n   165\t    v: &mut [u32; 16], a: usize, b: usize, c: usize, d: usize,\n   166\t    e: usize, sigma: &[usize; 16], m: &[u32; 16],\n   167\t) {\n   168\t    v[a] = v[a].wrapping_add(v[b]).wrapping_add(m[sigma[2 * e]] ^ C32[sigma[2 * e + 1]]);\n   169\t    v[d] = (v[d] ^ v[a]).rotate_right(16);\n   170\t    v[c] = v[c].wrapping_add(v[d]);\n   171\t    v[b] = (v[b] ^ v[c]).rotate_right(12);\n   172\t    v[a] = v[a].wrapping_add(v[b]).wrapping_add(m[sigma[2 * e + 1]] ^ C32[sigma[2 * e]]);\n   173\t    v[d] = (v[d] ^ v[a]).rotate_right(8);\n   174\t    v[c] = v[c].wrapping_add(v[d]);\n   175\t    v[b] = (v[b] ^ v[c]).rotate_right(7);\n   176\t}\n   177\t\n   178\t#[repr(C)]\n   179\t#[derive(Clone)]\n   180\tpub struct Blake512State {\n   181\t    pub h: [u64; 8],\n   182\t    pub s: [u64; 4],\n   183\t    pub t: [u64; 2],\n   184\t    pub buflen: i32,\n   185\t    pub nullt: i32,\n   186\t    pub buf: [u8; 128],\n   187\t}\n   188\t\n   189\timpl Blake512State {\n   190\t    pub fn new() -> Self {\n   191\t        Self {\n   192\t            h: [\n   193\t                0x6a09e667f3bcc908, 0xbb67ae8584caa73b,\n   194\t                0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1,\n   195\t                0x510e527fade682d1, 0x9b05688c2b3e6c1f,\n   196\t                0x1f83d9abfb41bd6b, 0x5be0cd19137e2179,\n   197\t            ],\n   198\t            s: [0; 4],\n   199\t            t: [0; 2],\n   200\t            buflen: 0,\n   201\t            nullt: 0,\n   202\t            buf: [0; 128],\n   203\t        }\n   204\t    }\n   205\t\n   206\t    pub fn compress(&mut self, block: &[u8]) {\n   207\t        let mut m = [0u64; 16];\n   208\t        for (word, bytes) in m.iter_mut().zip(block.chunks_exact(8)) {\n   209\t            *word = u64::from_be_bytes(bytes.try_into().unwrap());\n   210\t        }\n   211\t        let mut v = [0u64; 16];\n   212\t        v[..8].copy_from_slice(&self.h);\n   213\t        for i in 0..4 {\n   214\t            v[8 + i] = self.s[i] ^ C64[i];\n   215\t        }\n   216\t        v[12..16].copy_from_slice(&C64[4..8]);\n   217\t        if sel