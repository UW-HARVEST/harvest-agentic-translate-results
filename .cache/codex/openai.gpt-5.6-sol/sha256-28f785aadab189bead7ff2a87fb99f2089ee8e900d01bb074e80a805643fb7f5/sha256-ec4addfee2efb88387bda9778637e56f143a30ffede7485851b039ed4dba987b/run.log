tructure when we use SHA2 as\n     2\t/// the Sphincs+ hash function\n     3\t\n     4\tpub const SPX_OFFSET_LAYER: usize = 0;   //The byte used to specify the Merkle tree layer\n     5\tpub const SPX_OFFSET_TREE: usize = 1;   //The start of the 8 byte field used to specify the tree\n     6\tpub const SPX_OFFSET_TYPE: usize = 9;   //The byte used to specify the hash type (reason)\n     7\tpub const SPX_OFFSET_KP_ADDR2: usize = 12;  //The high byte used to specify the key pair (which one-time signature)\n     8\tpub const SPX_OFFSET_KP_ADDR1: usize = 13;  //The low byte used to specify the key pair\n     9\tpub const SPX_OFFSET_CHAIN_ADDR: usize = 17;  //The byte used to specify the chain address (which Winternitz chain)\n    10\tpub const SPX_OFFSET_HASH_ADDR: usize = 21;  //The byte used to specify the hash address (where in the Winternitz chain)\n    11\tpub const SPX_OFFSET_TREE_HGT: usize = 17;  //The byte used to specify the height of this node in the FORS or Merkle tree\n    12\tpub const SPX_OFFSET_TREE_INDEX: usize = 18; //The start of the 4 byte field used to specify the node in the FORS or Merkle tree\n\n===== src/offsets/shake.rs =====\n     1\t///Offsets of various fields in the address structure when we use SHAKE as\n     2\t///the Sphincs+ hash function\n     3\t\n     4\t\n     5\tpub const SPX_OFFSET_LAYER: usize = 3;   // The byte used to specify the Merkle tree layer\n     6\tpub const SPX_OFFSET_TREE: usize = 8;   // The start of the 8 byte field used to specify the tree\n     7\tpub const SPX_OFFSET_TYPE: usize = 19;  // The byte used to specify the hash type (reason)\n     8\tpub const SPX_OFFSET_KP_ADDR2: usize = 22;  // The high byte used to specify the key pair (which one-time signature)\n     9\tpub const SPX_OFFSET_KP_ADDR1: usize = 23;  // The low byte used to specify the key pair\n    10\tpub const SPX_OFFSET_CHAIN_ADDR: usize = 27;  // The byte used to specify the chain address (which Winternitz chain)\n    11\tpub const SPX_OFFSET_HASH_