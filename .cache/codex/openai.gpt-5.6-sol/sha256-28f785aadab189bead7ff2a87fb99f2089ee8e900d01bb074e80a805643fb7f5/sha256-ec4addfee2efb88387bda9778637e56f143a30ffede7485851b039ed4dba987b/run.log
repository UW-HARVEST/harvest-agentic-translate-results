8,cst[11],m12,cst[0],m0,cst[12],m5,cst[2],m2,cst[5],m15,cst[13],m13,cst[15],m10,cst[14],m14,cst[10],m3,cst[6],m6,cst[3],m7,cst[1],m1,cst[7],m9,cst[4],m4,cst[9])\n   254\t  ROUND(m7,cst[9],m9,cst[7],m3,cst[1],m1,cst[3],m13,cst[12],m12,cst[13],m11,cst[14],m14,cst[11],m2,cst[6],m6,cst[2],m5,cst[10],m10,cst[5],m4,cst[0],m0,cst[4],m15,cst[8],m8,cst[15])\n   255\t\n   256\t  v0 ^= v8;\n   257\t  v1 ^= v9;\n   258\t  v2 ^= v10;\n   259\t  v3 ^= v11;\n   260\t  v4 ^= v12;\n   261\t  v5 ^= v13;\n   262\t  v6 ^= v14;\n   263\t  v7 ^= v15;\n   264\t\n   265\t  v0 ^= S->s[0];\n   266\t  v1 ^= S->s[1];\n   267\t  v2 ^= S->s[2];\n   268\t  v3 ^= S->s[3];\n   269\t  v4 ^= S->s[0];\n   270\t  v5 ^= S->s[1];\n   271\t  v6 ^= S->s[2];\n   272\t  v7 ^= S->s[3];\n   273\t\n   274\t  S->h[0] ^= v0;\n   275\t  S->h[1] ^= v1;\n   276\t  S->h[2] ^= v2;\n   277\t  S->h[3] ^= v3;\n   278\t  S->h[4] ^= v4;\n   279\t  S->h[5] ^= v5;\n   280\t  S->h[6] ^= v6;\n   281\t  S->h[7] ^= v7;\n   282\t}\n   283\t\n   284\t\n   285\tvoid blake256_init( blakestate256 *S ) {\n   286\t\n   287\t  S->h[0]=0x6A09E667;\n   288\t  S->h[1]=0xBB67AE85;\n   289\t  S->h[2]=0x3C6EF372;\n   290\t  S->h[3]=0xA54FF53A;\n   291\t  S->h[4]=0x510E527F;\n   292\t  S->h[5]=0x9B05688C;\n   293\t  S->h[6]=0x1F83D9AB;\n   294\t  S->h[7]=0x5BE0CD19;\n   295\t  S->t[0]=S->t[1]=S->buflen=S->nullt=0;\n   296\t  S->s[0]=S->s[1]=S->s[2]=S->s[3] =0;\n   297\t}\n   298\t\n   299\t\n   300\tvoid blake256_update( blakestate256 *S, const u8 *data, u64 datalen ) {\n   301\t\n   302\t  int left=S->buflen >> 3; \n   303\t  int fill=64 - left;\n   304\t   \n   305\t  if( left && ( ((datalen >> 3) & 0x3F) >= fill ) ) {\n   306\t    memcpy( (void*) (S->buf + left), (void*) data, fill );\n   307\t    S->t[0] += 512;\n   308\t    if (S->t[0] == 0) S->t[1]++;      \n   309\t    blake256_compress( S, S->buf );\n   310\t    data += fill;\n   311\t    datalen  -= (fill << 3);       \n   312\t    left = 0;\n   313\t  }\n   314\t\n   315\t  while( datalen >= 512 ) {\n   316\t    S->t[0] += 512;\n   317\t    if (S->t[0] == 0) S->t[1]++;\n   318\t    blake256_compress( S, data );\n   319\t    data += 64;\n   320\t    datalen -= 512;\n   321\t  }\n   322\t  \n   323\t  if( datalen > 0 ) {\n   324\t    memcpy( (void*) (S->buf + left), (void*) data, datalen>>3 );\n   325\t    S->buflen = (left<<3) + datalen;\n   326\t  }\n   327\t  else S->buflen=0;\n   328\t}\n   329\t\n   330\t\n   331\tvoid blake256_final( blakestate256 *S, u8 *digest ) {\n   332\t  \n   333\t  u8 msglen[8], zo=0x01, oo=0x81;\n   334\t  u32 lo=S->t[0] + S->buflen, hi=S->t[1];\n   335\t  if ( lo < S->buflen ) hi++;\n   336\t  U32TO8(  msglen + 0, hi );\n   337\t  U32TO8(  msglen + 4, lo );\n   338\t\n   339\t  if ( S->buflen == 440 ) { /* one padding byte */\n   340\t    S->t[0] -= 8;\n   341\t    blake256_update( S, &oo, 8 );\n   342\t  }\n   343\t  else {\n   344\t    if ( S->buflen < 440 ) { /* enough space to fill the block  */\n   345\t      if ( !S->buflen ) S->nullt=1;\n   346\t      S->t[0] -= 440 - S->buflen;\n   347\t      blake256_update( S, padding, 440 - S->buflen );\n   348\t    }\n   349\t    else { /* need 2 compressions */\n   350\t      S->t[0] -= 512 - S->buflen; \n   351\t      blake256_update( S, padding, 512 - S->buflen );\n   352\t      S->t[0] -= 440;\n   353\t      blake256_update( S, padding+1, 440 );\n   354\t      S->nullt = 1;\n   355\t    }\n   356\t    blake256_update( S, &zo, 8 );\n   357\t    S->t[0] -= 8;\n   358\t  }\n   359\t  S->t[0] -= 64;\n   360\t  blake256_update( S, msglen, 64 );    \n   361\t  \n   362\t  U32TO8( digest + 0, S->h[0]);\n   363\t  U32TO8( digest + 4, S->h[1]);\n   364\t  U32TO8( digest + 8, S->h[2]);\n   365\t  U32TO8( digest +12, S->h[3]);\n   366\t  U32TO8( digest +16, S->h[4]);\n   367\t  U32TO8( digest +20, S->h[5]);\n   368\t  U32TO8( digest +24, S->h[6]);\n   369\t  U32TO8( digest +28, S->h[7]);\n   370\t}\n   371\t\n   372\tvoid blake256_mgf1(unsigned char *out, unsigned long outlen,\n   373\t\t\t   const unsigned char *in, unsigned long inlen)\n   374\t{\n   375\t    SPX_VLA(uint8_t, inbuf, inlen+4);\n   376\t    unsigned char outbuf[SPX_BLAKE256_OUTPUT_BYTES];\n   377\t    unsigned long i;\n   378\t\n   379\t    memcpy(inbuf, in, inlen);\n   380\t\n   381\t    /* While we can fit in at least another full block of BLAKE256 output.. */\n   382\t    for (i = 0; (i+1)*SPX_BLAKE256_OUTPUT_BYTES <= outlen; i++) {\n   383\t        u32_to_bytes(inbuf + inlen, i);\n   384\t        blake256(out, inbuf, inlen + 4);\n   385\t        out += SPX_BLAKE256_OUTPUT_BYTES;\n   386\t    }\n   387\t    /* Until we cannot anymore, and we fill the remainder. */\n   388\t    if (outlen > i*SPX_BLAKE256_OUTPUT_BYTES) {\n   389\t        u32_to_bytes(inbuf + inlen, i);\n   390\t        blake256(outbuf, inbuf, inlen + 4);\n   391\t        memcpy(out, outbuf, outlen - i*SPX_BLAKE256_OUTPUT_BYTES);\n   392\t    }\n   393\t}\n   394\t\n   395\tint blake256( unsigned char *out, const unsigned char *in, unsigned long long inlen )\n   396\t{\n   397\t  blakestate256 S;  \n   398\t  blake256_init( &S );\n   399\t  blake256_update( &S, in, inlen*8 );\n   400\t  blake256_final( &S, out );\n   401\t  return 0;\n   402\t}\n\n===== lib/blake/src/blake512.c =====\n     1\t// supercop-20140525/crypto_hash/blake512/sandy\n     2\t\n     3\t/*\n     4\t   BLAKE reference C implementation\n     5\t\n     6\t   Copyright (c) 2012 Jean-Philippe Aumasson <jeanphilippe.aumasson@gmail.com>\n     7\t\n     8\t   To the extent possible under law, the author(s) have dedicated all copyright\n     9\t   and related and neighboring rights to this software to the public domain\n    10\t   worldwide. This software is distributed without any warranty.\n    11\t\n    12\t   You should have received a copy of the CC0 Public Domain Dedication along\n    13\t   with this software. If not, see\n    14\t   <http://creativecommons.org/publicdomain/zero/1.0/>.\n    15\t */\n    16\t\n    17\t#include <string