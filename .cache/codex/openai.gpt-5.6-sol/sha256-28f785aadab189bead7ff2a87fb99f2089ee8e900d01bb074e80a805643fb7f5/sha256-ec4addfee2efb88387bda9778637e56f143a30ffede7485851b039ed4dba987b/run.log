{"type":"item.completed","item":{"id":"item_51","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/fips202.rs | sed -n '1,340p'; printf '\\\\n===== ffi shake section =====\\\\n'; nl -ba src/ffi.rs | sed -n '1030,1140p'\"","aggregated_output":"     1\tpub const SHAKE256_RATE: usize = 136;\n     2\t\n     3\tconst RC: [u64; 24] = [\n     4\t    0x0000000000000001, 0x0000000000008082, 0x800000000000808a,\n     5\t    0x8000000080008000, 0x000000000000808b, 0x0000000080000001,\n     6\t    0x8000000080008081, 0x8000000000008009, 0x000000000000008a,\n     7\t    0x0000000000000088, 0x0000000080008009, 0x000000008000000a,\n     8\t    0x000000008000808b, 0x800000000000008b, 0x8000000000008089,\n     9\t    0x8000000000008003, 0x8000000000008002, 0x8000000000000080,\n    10\t    0x000000000000800a, 0x800000008000000a, 0x8000000080008081,\n    11\t    0x8000000000008080, 0x0000000080000001, 0x8000000080008008,\n    12\t];\n    13\t\n    14\tconst RHO: [[u32; 5]; 5] = [\n    15\t    [0, 36, 3, 41, 18],\n    16\t    [1, 44, 10, 45, 2],\n    17\t    [62, 6, 43, 15, 61],\n    18\t    [28, 55, 25, 21, 56],\n    19\t    [27, 20, 39, 8, 14],\n    20\t];\n    21\t\n    22\tpub fn keccak_f1600(state: &mut [u64]) {\n    23\t    for rc in RC {\n    24\t        let mut c = [0u64; 5];\n    25\t        for x in 0..5 {\n    26\t            c[x] = state[x] ^ state[x + 5] ^ state[x + 10]\n    27\t                ^ state[x + 15] ^ state[x + 20];\n    28\t        }\n    29\t        let mut d = [0u64; 5];\n    30\t        for x in 0..5 {\n    31\t            d[x] = c[(x + 4) % 5] ^ c[(x + 1) % 5].rotate_left(1);\n    32\t        }\n    33\t        for y in 0..5 {\n    34\t            for x in 0..5 {\n    35\t                state[x + 5 * y] ^= d[x];\n    36\t            }\n    37\t        }\n    38\t        let mut b = [0u64; 25];\n    39\t        for y in 0..5 {\n    40\t            for x in 0..5 {\n    41\t                b[y + 5 * ((2 * x + 3 * y) % 5)] =\n    42\t                    state[x + 5 * y].rotate_left(RHO[x][y]);\n    43\t            }\n    44\t        }\n    45\t        for y in 0..5 {\n    46\t            for x in 0..5 {\n    47\t                state[x + 5 * y] =\n    48\t                    b[x + 5 * y] ^ ((!b[(x + 1) % 5 + 5 * y]) & b[(x + 2) % 5 + 5 * y]);\n    49\t            }\n    50\t        }\n    51\t        state[0] ^= rc;\n    52\t    }\n    53\t}\n    54\t\n    55\tfn xor_byte(state: &mut [u64], offset: usize, byte: u8) {\n    56\t    state[offset >> 3] ^= (byte as u64) << (8 * (offset & 7));\n    57\t}\n    58\t\n    59\tfn get_byte(state: &[u64], offset: usize) -> u8 {\n    60\t    (state[offset >> 3] >> (8 * (offset & 7))) as u8\n    61\t}\n    62\t\n    63\tpub fn shake256_inc_init(state: &mut [u64; 26]) {\n    64\t    state.fill(0);\n    65\t}\n    66\t\n    67\tpub fn shake256_inc_absorb(state: &mut [u64; 26], mut input: &[u8]) {\n    68\t    while input.len() + state[25] as usize >= SHAKE256_RATE {\n    69\t        let take = SHAKE256_RATE - state[25] as usize;\n    70\t        let state_offset = state[25] as usize;\n    71\t        for (i, byte) in input[..take].iter().enumerate() {\n    72\t            xor_byte(state, state_offset + i, *byte);\n    73\t        }\n    74\t        input = &input[take..];\n    75\t        state[25] = 0;\n    76\t        keccak_f1600(state);\n    77\t    }\n    78\t    let offset = state[25] as usize;\n    79\t    for (i, byte) in input.iter().enumerate() {\n    80\t        xor_byte(state, offset + i, *byte);\n    81\t    }\n    82\t    state[25] += input.len() as u64;\n    83\t}\n    84\t\n    85\tpub fn shake256_inc_finalize(state: &mut [u64; 26]) {\n    86\t    let state_offset = state[25] as usize;\n    87\t    xor_byte(state, state_offset, 0x1f);\n    88\t    xor_byte(state, SHAKE256_RATE - 1, 0x80);\n    89\t    state[25] = 0;\n    90\t}\n    91\t\n    92\tpub fn shake256_inc_squeeze(out: &mut [u8], state: &mut [u64; 26]) {\n    93\t    let mut offset = 0;\n    94\t    while offset < out.len() && state[25] > 0 {\n    95\t        out[offset] = get_byte(state, SHAKE256_RATE - state[25] as usize);\n    96\t        state[25] -= 1;\n    97\t        offset += 1;\n    98\t    }\n    99\t    while offset < out.len() {\n   100\t        keccak_f1600(state);\n   101\t        let take = (out.len() - offset).min(SHAKE256_RATE);\n   102\t        for i in 0..take {\n   103\t            out[offset + i] = get_byte(state, i);\n   104\t        }\n   105\t        state[25] = (SHAKE256_RATE - take) as u64;\n   106\t        offset += take;\n   107\t    }\n   108\t}\n   109\t\n   110\tpub fn shake256_absorb(state: &mut [u64; 25], input: &[u8]) {\n   111\t    state.fill(0);\n   112\t    let mut offset = 0;\n   113\t    while input.len() - offset >= SHAKE256_RATE {\n   114\t        for i in 0..SHAKE256_RATE {\n   115\t            xor_byte(state, i, input[offset + i]);\n   116\t        }\n   117\t        keccak_f1600(state);\n   118\t        offset += SHAKE256_RATE;\n   119\t    }\n   120\t    for (i, byte) in input[offset..].iter().enumerate() {\n   121\t        xor_byte(state, i, *byte);\n   122\t    }\n   123\t    xor_byte(state, input.len() - offset, 0x1f);\n   124\t    xor_byte(state, SHAKE256_RATE - 1, 0x80);\n   125\t}\n   126\t\n   127\tpub fn shake256_squeezeblocks(out: &mut [u8], state: &mut [u64; 25]) {\n   128\t    for block in out.chunks_exact_mut(SHAKE256_RATE) {\n   129\t        keccak_f1600(state);\n   130\t        for (i, byte) in block.iter_mut().enumerate() {\n   131\t            *byte = get_byte(state, i);\n   132\t        }\n   133\t    }\n   134\t}\n   135\t\n   136\tpub fn shake256(out: &mut [u8], input: &[u8]) {\n   137\t    let mut state = [0u64; 25];\n   138\t    shake256_absorb(&mut state, input);\n   139\t    let full = out.len() / SHAKE256_RATE * SHAKE256_RATE;\n   140\t    shake256_squeezeblocks(&mut out[..full], &mut state);\n   141\t    if full < out.len() {\n   142\t        let mut block = [0u8; SHAKE256_RATE];\n   143\t        shake256_squeezeblocks(&mut block, &mut state);\n   144\t        let remainder = out.len() - full;\n   145\t        out[full..].copy_from_slice(&block[..remainder]);\n   146\t    }\n   147\t}\n\n===== ffi shake section =====\n  1030\t    let out = unsafe { std::slice::from_raw_parts_mut(out, outlen as usize) };\n  1031\t    let mut inbuf = input.to_vec();\n  1032\t    inbuf.extend_from_slice(&[0; 4]);\n  1033\t    for (counter, chunk) in out.chunks_mut(64).enumerate() {\n  1034\t        inbuf[inlen as usize..].copy_from_slice(&(counter as u32).to_be_bytes());\n  1035\t        let mut digest = [0u8; 64];\n  1036\t        crate::sha2::sha512(&mut digest, &inbuf, inbuf.len());\n  1037\t        chunk.copy_from_slice(&digest[..chunk.len()]);\n  1038\t    }\n  1039\t}\n  1040\t\n  1041\t#[cfg(feature = \"sha2\")]\n  1042\t#[unsafe(no_mangle)]\n  1043\tpub unsafe extern \"C\" fn SPX_seed_state(ctx: *mut SpxCtx) {\n  1044\t    crate::sha2::seed_state(unsafe { &mut *ctx });\n  1045\t}\n  1046\t\n  1047\t#[cfg(feature = \"shake\")]\n  1048\t#[unsafe(no_mangle)]\n  1049\tpub unsafe extern \"C\" fn shake256_inc_init(state: *mut u64) {\n  1050\t    crate::fips202::shake256_inc_init(unsafe { &mut *(state as *mut [u64; 26]) });\n  1051\t}\n  1052\t\n  1053\t#[cfg(feature = \"shake\")]\n  1054\t#[unsafe(no_mangle)]\n  1055\tpub unsafe extern \"C\" fn shake256_inc_absorb(\n  1056\t    state: *mut u64,\n  1057\t    input: *const u8,\n  1058\t    inlen: usize,\n  1059\t) {\n  1060\t    crate::fips202::shake256_inc_absorb(\n  1061\t        unsafe { &mut *(state as *mut [u64; 26]) },\n  1062\t        unsafe { std::slice::from_raw_parts(input, inlen) },\n  1063\t    );\n  1064\t}\n  1065\t\n  1066\t#[cfg(feature = \"shake\")]\n  1067\t#[unsafe(no_mangle)]\n  1068\tpub unsafe extern \"C\" fn shake256_inc_finalize(state: *mut u64) {\n  1069\t    crate::fips202::shake256_inc_finalize(unsafe { &mut *(state as *mut [u64; 26]) });\n  1070\t}\n  1071\t\n  1072\t#[cfg(feature = \"shake\")]\n  1073\t#[unsafe(no_mangle)]\n  1074\tpub unsafe extern \"C\" fn shake256_inc_squeeze(\n  1075\t    out: *mut u8,\n  1076\t    outlen: usize,\n  1077\t    state: *mut u64,\n  1078\t) {\n  1079\t    crate::fips202::shake256_inc_squeeze(\n  1080\t        unsafe { std::slice::from_raw_parts_mut(out, outlen) },\n  1081\t        unsafe { &mut *(state as *mut [u64; 26]) },\n  1082\t    );\n  1083\t}\n  1084\t\n  1085\t#[cfg(feature = \"shake\")]\n  1086\t#[unsafe(no_mangle)]\n  1087\tpub unsafe extern \"C\" fn shake256_absorb(\n  1088\t    state: *mut u64,\n  1089\t    input: *const u8,\n  1090\t    inlen: usize,\n  1091\t) {\n  1092\t    crate::fips202::shake256_absorb(\n  1093\t        unsafe { &mut *(state as *mut [u64; 25]) },\n  1094\t        unsafe { std::slice::from_raw_parts(input, inlen) },\n  1095\t    );\n  1096\t}\n  1097\t\n  1098\t#[cfg(feature = \"shake\")]\n  1099\t#[unsafe(no_mangle)]\n  1100\tpub unsafe extern \"C\" fn shake256_squeezeblocks(\n  1101\t    out: *mut u8,\n  1102\t    nblocks: usize,\n  1103\t    state: *mut u64,\n  1104\t) {\n  1105\t    crate::fips202::shake256_squeezeblocks(\n  1106\t        unsafe {\n  1107\t            std::slice::from_raw_parts_mut(out, nblocks * crate::fips202::SHAKE256_RATE)\n  1108\t        },\n  1109\t        unsafe { &mut *(state as *mut [u64; 25]) },\n  1110\t    );\n  1111\t}\n  1112\t\n  1113\t#[cfg(feature = \"shake\")]\n  1114\t#[unsafe(no_mangle)]\n  1115\tpub unsafe extern \"C\" fn shake256(\n  1116\t    out: *mut u8,\n  1117\t    outlen: usize,\n  1118\t    input: *const u8,\n  1119\t    inlen: usize,\n  1120\t) {\n  1121\t    crate::fips202::shake256(\n  1122\t        unsafe { std::slice::from_raw_parts_mut(out, outlen) },\n  1123\t        unsafe { std::slice::from_raw_parts(input, inlen) },\n  1124\t    );\n  1125\t}\n  1126\t\n  1127\t#[cfg(feature = \"haraka\")]\n  1128\t#[unsafe(no_mangle)]\n  1129\tpub unsafe extern \"C\" fn SPX_tweak_constants(ctx: *mut SpxCtx) {\n  1130\t    crate::haraka::tweak_constants(unsafe { &mut *ctx });\n  1131\t}\n  1132\t\n  1133\t#[cfg(feature = \"haraka\")]\n  1134\t#[unsafe(no_mangle)]\n  1135\tpub unsafe extern \"C\" fn SPX_haraka_S_inc_init(state: *mut u8) {\n  1136\t    unsafe { std::ptr::write_bytes(state, 0, 65) };\n  1137\t}\n  1138\t\n  1139\t#[cfg(feature = \"haraka\")]\n  1140\t#[unsafe(no_mangle)]\n","exit_code":0,"status":"completed"}}
