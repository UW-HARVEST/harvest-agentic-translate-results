); \\\n   202\t                v8 += v13; \\\n   203\t                v7 ^= v8; \\\n   204\t                v7 = BLAKE256_ROT( v7,12); \\\n   205\t                  v3 += m14 ^ c14; \\\n   206\t                  v3 += v4; \\\n   207\t                  v14 ^= v3; \\\n   208\t                  v14 = BLAKE256_ROT( v14,16); \\\n   209\t                  v9 += v14; \\\n   210\t                  v4 ^= v9; \\\n   211\t                  v4 = BLAKE256_ROT( v4,12); \\\n   212\t                v2 += m13 ^ c13; \\\n   213\t                v2 += v7; \\\n   214\t                v13 ^= v2; \\\n   215\t                v13 = BLAKE256_ROT( v13, 8); \\\n   216\t                v8 += v13; \\\n   217\t                v7 ^= v8; \\\n   218\t                v7 = BLAKE256_ROT( v7, 7); \\\n   219\t                  v3 += m15 ^ c15; \\\n   220\t                  v3 += v4; \\\n   221\t                  v14 ^= v3; \\\n   222\t                  v14 = BLAKE256_ROT( v14, 8); \\\n   223\t                  v9 += v14; \\\n   224\t                  v4 ^= v9; \\\n   225\t                  v4 = BLAKE256_ROT( v4, 7); \\\n   226\t              v1 += m11 ^ c11; \\\n   227\t              v1 += v6; \\\n   228\t              v12 ^= v1; \\\n   229\t              v12 = BLAKE256_ROT( v12, 8); \\\n   230\t              v11 += v12; \\\n   231\t              v6 ^= v11; \\\n   232\t              v6 = BLAKE256_ROT( v6, 7); \\\n   233\t            v0 += m9 ^ c9; \\\n   234\t            v0 += v5; \\\n   235\t            v15 ^= v0; \\\n   236\t            v15 = BLAKE256_ROT( v15, 8); \\\n   237\t            v10 += v15; \\\n   238\t            v5 ^= v10; \\\n   239\t            v5 = BLAKE256_ROT( v5, 7); \\\n   240\t\n   241\t  ROUND(m0,cst[1],m1,cst[0],m2,cst[3],m3,cst[2],m4,cst[5],m5,cst[4],m6,cst[7],m7,cst[6],m8,cst[9],m9,cst[8],m10,cst[11],m11,cst[10],m12,cst[13],m13,cst[12],m14,cst[15],m15,cst[14])\n   242\t  ROUND(m14,cst[10],m10,cst[14],m4,cst[8],m8,cst[4],m9,cst[15],m15,cst[9],m13,cst[6],m6,cst[13],m1,cst[12],m12