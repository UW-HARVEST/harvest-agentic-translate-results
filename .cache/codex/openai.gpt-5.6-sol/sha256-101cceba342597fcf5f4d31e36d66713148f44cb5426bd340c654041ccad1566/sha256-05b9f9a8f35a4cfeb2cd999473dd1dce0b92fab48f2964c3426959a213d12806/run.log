{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes as C\nimport math\nimport random\nimport struct\nimport sys\n\nclass V(C.Structure):\n    _fields_ = [('x', C.c_float), ('y', C.c_float)]\nclass Raycast(C.Structure):\n    _fields_ = [('t', C.c_float), ('n', V)]\nclass R(C.Structure):\n    _fields_ = [('c', C.c_float), ('s', C.c_float)]\nclass X(C.Structure):\n    _fields_ = [('p', V), ('r', R)]\nclass Circle(C.Structure):\n    _fields_ = [('p', V), ('r', C.c_float)]\nclass AABB(C.Structure):\n    _fields_ = [('min', V), ('max', V)]\nclass Capsule(C.Structure):\n    _fields_ = [('a', V), ('b', V), ('r', C.c_float)]\nclass Poly(C.Structure):\n    _fields_ = [('count', C.c_int), ('verts', V * 8), ('norms', V * 8)]\nclass Ray(C.Structure):\n    _fields_ = [('p', V), ('d', V), ('t', C.c_float)]\nclass M(C.Structure):\n    _fields_ = [('x', V), ('y', V)]\n\nc = C.CDLL('../reference-build/libreference.so')\nr = C.CDLL('target/release/libtranslation.so')\nlibs = (c, r)\nprotos = {\n    'c2V': ([C.c_float, C.c_float], V),\n    'c2Dot': ([V, V], C.c_float),\n    'c2Len': ([V], C.c_float),\n    'c2Add': ([V, V], V),\n    'c2Sub': ([V, V], V),\n    'c2Mulvs': ([V, C.c_float], V),\n    'c2Div': ([V, C.c_float], V),\n    'c2Norm': ([V], V),\n    'c2Minv': ([V, V], V),\n    'c2Maxv': ([V, V], V),\n    'c2Skew': ([V], V),\n    'c2Absv': ([V], V),\n    'c2RaytoCircle': ([Ray, Circle, C.POINTER(Raycast)], C.c_int),\n    'c2AABBtoAABB': ([AABB, AABB], C.c_int),\n    'c2RaytoAABB': ([Ray, AABB, C.POINTER(Raycast)], C.c_int),\n    'c2CCW90': ([V], V),\n    'c2MulmvT': ([M, V], V),\n    'c2AABBtoPoint': ([AABB, V], C.c_int),\n    'c2CircleToPoint': ([Circle, V], C.c_int),\n    'c2RaytoCapsule': ([Ray, Capsule, C.POINTER(Raycast)], C.c_int),\n    'c2RotIdentity': ([], R),\n    'c2xIdentity': ([], X),\n    'c2Mulrv': ([R, V], V),\n    'c2MulrvT': ([R, V], V),\n    'c2MulxvT': ([X, V], V),\n    'c2RaytoPoly': ([Ray, C.POINTER(Poly), C.POINTER(X), C.POINTER(Raycast)], C.c_int),\n    'c2CastRay': ([Ray, C.c_void_p, C.POINTER(X), C.c_int, C.POINTER(Raycast)], C.c_int),\n    'poly_ray': ([C.POINTER(Raycast), C.POINTER(Raycast)], C.c_int),\n}\nfor lib in libs:\n    for name, (args, result) in protos.items():\n        fn = getattr(lib, name)\n        fn.argtypes = args\n        fn.restype = result\n\ndef raw(value):\n    if isinstance(value, float):\n        return struct.pack('=f', value)\n    if isinstance(value, int):\n        return struct.pack('=i', value)\n    return C.string_at(C.byref(value), C.sizeof(value))\n\ndef check(name, args):\n    a = getattr(c, name)(*args)\n    b = getattr(r, name)(*args)\n    if raw(a) \"'!= raw(b):\n        raise AssertionError(f'\"'{name} mismatch: {raw(a).hex()} \"'!= {raw(b).hex()}'\"')\n\ndef checkout(name, args):\n    oa = Raycast(C.c_float.from_buffer_copy(bytes.fromhex('a5a5a5a5')).value, V(17.25, -33.5))\n    ob = Raycast(C.c_float.from_buffer_copy(bytes.fromhex('a5a5a5a5')).value, V(17.25, -33.5))\n    ra = getattr(c, name)(*args, C.byref(oa))\n    rb = getattr(r, name)(*args, C.byref(ob))\n    if ra \"'!= rb or raw(oa) != raw(ob):\n        raise AssertionError(f'\"'{name} mismatch: ret {ra}/{rb}, out {raw(oa).hex()}/{raw(ob).hex()}')\n\n# Confirm all C exports were bound in the differential test.\nc_names = set(open('../reference-build/c-symbols.txt').read().split())\nif c_names \"'!= set(protos):\n    raise AssertionError(f'\"'prototype coverage differs: {c_names \"'^ set(protos)}'\"')\n\nspecial = [0.0, -0.0, 1.0, -1.0, 0.5, -0.5, 1e-30, -1e-30, 1e20, -1e20,\n           float('inf'), float('-inf'), float('nan')]\nfor x in special:\n    for y in special:\n        v = V(x, y)\n        check('c2V', [x, y])\n        check('c2Len', [v])\n        check('c2Norm', [v])\n        check('c2Skew', [v])\n        check('c2Absv', [v])\n        check('c2Add', [v, V(y, x)])\n        check('c2Sub', [v, V(y, x)])\n        check('c2Mulvs', [v, y])\n        check('c2Div', [v, y])\n        check('c2Dot', [v, V(y, x)])\n        check('c2Minv', [v, V(y, x)])\n        check('c2Maxv', [v, V(y, x)])\n        check('c2CCW90', [v])\n\ncheck('c2RotIdentity', [])\ncheck('c2xIdentity', [])\n\nrng = random.Random(0xC2)\ndef f(lo=-100.0, hi=100.0):\n    return C.c_float(rng.uniform(lo, hi)).value\ndef v():\n    return V(f(), f())\ndef ordered_box():\n    x0, x1, y0, y1 = f(), f(), f(), f()\n    return AABB(V(min(x0, x1), min(y0, y1)), V(max(x0, x1), max(y0, y1)))\ndef ray():\n    return Ray(v(), v(), f(0.0, 200.0))\n\ndef rectangle():\n    p = Poly()\n    x0, x1, y0, y1 = sorted((f(), f())), sorted((f(), f()))\n    p.count = 4\n    p.verts[0], p.verts[1], p.verts[2], p.verts[3] = V(x1, y0), V(x1, y1), V(x0, y1), V(x0, y0)\n    p.norms[0], p.norms[1], p.norms[2], p.norms[3] = V(1, 0), V(0, 1), V(-1, 0), V(0, -1)\n    return p\n\nfor _ in range(20000):\n    a, b = v(), v()\n    s = f()\n    rr = R(f(-2, 2), f(-2, 2))\n    xx = X(v(), rr)\n    mm = M(v(), v())\n    box1, box2 = ordered_box(), ordered_box()\n    circ = Circle(v(), abs(f(0, 100)))\n    check('c2V', [a.x, a.y])\n    check('c2Dot', [a, b])\n    check('c2Len', [a])\n    check('c2Add', [a, b])\n    check('c2Sub', [a, b])\n    check('c2Mulvs', [a, s])\n    check('c2Div', [a, s])\n    check('c2Norm', [a])\n    check('c2Minv', [a, b])\n    check('c2Maxv', [a, b])\n    check('c2Skew', [a])\n    check('c2Absv', [a])\n    check('c2AABBtoAABB', [box1, box2])\n    check('c2CCW90', [a])\n    check('c2MulmvT', [mm, a])\n    check('c2AABBtoPoint', [box1, a])\n    check('c2CircleToPoint', [circ, a])\n    check('c2Mulrv', [rr, a])\n    check('c2MulrvT', [rr, a])\n    check('c2MulxvT', [xx, a])\n\nfor _ in range(25000):\n    rr = ray()\n    circ = Circle(v(), abs(f(0, 100)))\n    box = ordered_box()\n    a, b = v(), v()\n    if a.x == b.x and a.y == b.y:\n        b.x += 1.0\n    cap = Capsule(a, b, abs(f(0, 100)))\n    poly = rectangle()\n    angle = rng.uniform(-math.pi, math.pi)\n    xx = X(v(), R(C.c_float(math.cos(angle)).value, C.c_float(math.sin(angle)).value))\n    checkout('c2RaytoCircle', [rr, circ])\n    checkout('c2RaytoAABB', [rr, box])\n    checkout('c2RaytoCapsule', [rr, cap])\n    checkout('c2RaytoPoly', [rr, C.byref(poly), C.byref(xx)])\n    for type_b, shape in enumerate((circ, box, cap, poly)):\n        pa = C.cast(C.pointer(shape), C.c_void_p)\n        oa = Raycast(99, V(88, 77)); ob = Raycast(99, V(88, 77))\n        ra = c.c2CastRay(rr, pa, C.byref(xx), type_b, C.byref(oa))\n        rb = r.c2CastRay(rr, pa, C.byref(xx), type_b, C.byref(ob))\n        if ra \"'!= rb or raw(oa) != raw(ob):\n            raise AssertionError(f'\"'c2CastRay type {type_b} mismatch')\n\nfor type_b in (-100, -1, 4, 99):\n    dummy = Circle(V(0, 0), 1)\n    checkout('c2CastRay', [Ray(V(0, 0), V(1, 0), 2), C.cast(C.pointer(dummy), C.c_void_p), C.POINTER(X)(), type_b])\n\na1 = Raycast(12.5, V(3.25, -9.0)); a2 = Raycast(-4.5, V(7.0, 2.0))\nb1 = Raycast(12.5, V(3.25, -9.0)); b2 = Raycast(-4.5, V(7.0, 2.0))\nra = c.poly_ray(C.byref(a1), C.byref(a2)); rb = r.poly_ray(C.byref(b1), C.byref(b2))\nif ra \"'!= rb or raw(a1) != raw(b1) or raw(a2) != raw(b2):\n    raise AssertionError('\"'poly_ray mismatch')\n\nprint('differential ABI verification passed: all 28 exports; 20,000 helper vectors; 25,000 geometry vectors')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
