key.argtypes = [V, Z, V, Z, I]; lib.stbds_hmget_key.restype = V\n    lib.stbds_hmget_key_ts.argtypes = [V, Z, V, Z, ctypes.POINTER(ctypes.c_ssize_t), I]; lib.stbds_hmget_key_ts.restype = V\n    lib.stbds_hmdel_key.argtypes = [V, Z, V, Z, Z, I]; lib.stbds_hmdel_key.restype = V\n    lib.stbds_hmfree_func.argtypes = [V, Z]\n    lib.stbds_shmode_func.argtypes = [Z, I]; lib.stbds_shmode_func.restype = V\n    lib.stbds_stralloc.argtypes = [ctypes.POINTER(Arena), ctypes.c_char_p]; lib.stbds_stralloc.restype = ctypes.c_void_p\n    lib.stbds_strreset.argtypes = [ctypes.POINTER(Arena)]\n\ndef hdr(raw):\n    return Header.from_address(raw - HS)\n\ndef table_snapshot(raw):\n    h = hdr(raw)\n    if not h.hash_table:\n        return None\n    t = HashIndex.from_address(h.hash_table)\n    slots = []\n    for b in range(t.slot_count // 8):\n        bucket = t.storage[b]\n        slots.extend((int(bucket.hash[i]), int(bucket.index[i])) for i in range(8))\n    return (t.slot_count, t.used_count, t.used_count_threshold,\n            t.used_count_shrink_threshold, t.tombstone_count,\n            t.tombstone_count_threshold, t.seed, t.slot_count_log2,\n            t.string.remaining, t.string.block, t.string.mode, slots)\n\ndef run(path):\n    lib = ctypes.CDLL(path)\n    configure(lib)\n    out = {}\n\n    # Dynamic array layout, capacity policy, and byte preservation.\n    ptr = lib.stbds_arrgrowf(None, 3, 0, 1)\n    h = hdr(ptr); h.length = 3\n    ctypes.memmove(ptr, bytes(range(9)), 9)\n    states = [(h.length, h.capacity, ctypes.string_at(ptr, 9).hex())]\n    ptr = lib.stbds_arrgrowf(ptr, 3, 2, 0)\n    h = hdr(ptr); states.append((h.length, h.capacity, ctypes.string_at(ptr, 9).hex()))\n    ptr = lib.stbds_arrgrowf(ptr, 3, 0, 17)\n    h = hdr(ptr); states.append((h.length, h.capacity, ctypes.string_at(ptr, 9).hex()))\n    out['array'] = states\n    lib.stbds_arrfreef(ptr)\n\n    # Binary map with enough operations to grow, rebuild, and shrink.\n    lib.stbds_rand_seed(0x1020304050607080)\n    size = ctypes.sizeof(BinEntry)\n    m = lib.stbds_hmput_default(None, size)\n    BinEntry.from_address(m - size).value = -999\n    stages = []\n    keys = list(range(180))\n    random.Random(12345).shuffle(keys)\n    for k in keys:\n        key = ctypes.c_uint64(k * 17 + 3)\n        m = lib.stbds_hmput_key(m, size, ctypes.byref(key), 8, 0)\n        i = hdr(m - size).temp\n        e = BinEntry.from_address(m + i * size)\n        e.key, e.value = key.value, k * k - 77\n    stages.append((hdr(m-size).length, hdr(m-size).capacity, table_snapshot(m-size)))\n    for k in range(0, 180, 3):\n        key = ctypes.c_uint64(k * 17 + 3)\n        m = lib.stbds_hmput_key(m, size, ctypes.byref(key), 8, 0)\n        i = hdr(m - size).temp\n        BinEntry.from_address(m + i * size).value = -k * 101\n    get_results = []\n    for k in range(220):\n        key = ctypes.c_uint64(k * 17 + 3)\n        temp = ctypes.c_ssize_t(777)\n        m = lib.stbds_hmget_key_ts(m, size, ctypes.byref(key), 8, ctypes.byref(temp), 0)\n        value = BinEntry.from_address(m + temp.value * size).value if temp.value >= 0 else BinEntry.from_address(m-size).value\n        get_results.append((temp.value, value))\n    for k in range(0, 180, 2):\n        key = ctypes.c_uint64(k * 17 + 3)\n        m = lib.stbds_hmdel_key(m, size, ctypes.byref(key), 8, 0, 0)\n    stages.append((hdr(m-size).length, hdr(m-size).capacity, table_snapshot(m-size)))\n    for k in range(1, 160, 2):\n        key = ctypes.c_uint64(k * 17 + 3)\n        m = lib.stbds_hmdel_key(m, size, ctypes.byref(key), 8, 0, 0)\n    stages.append((hdr(m-size).length, hdr(m-size).capacity, table_snapshot(m-size)))\n    order = [(BinEntry.from_address(m+i*size).key, BinEntry.from_address(m+i*size).value)\n             for i in range(hdr(m-size).length-1)]\n    out['binary'] = (stages, get_results, order)\n    lib.stbds_hmfree_func(m-size, size)\n\n    # String maps in borrowed, strdup, and arena modes.\n    string_modes = {}\n    source_names = [f'key_{i:03d}_value'.encode() for i in range(96)]\n    for mode in (1, 2, 3):\n        lib.stbds_rand_seed(0x8877665544332211)\n        size = ctypes.sizeof(StrEntry)\n        m = lib.stbds_shmode_func(size, mode)\n        keepalive = []\n        for i, name in enumerate(source_names):\n            buf = ctypes.create_string_buffer(name)\n            keepalive.append(buf)\n            m = lib.stbds_hmput_key(m, size, ctypes.cast(buf, ctypes.c_void_p), ctypes.sizeof(ctypes.c_void_p), 1)\n            idx = hdr(m-size).temp\n            StrEntry.from_address(m + idx*size).value = i * 13 - 9\n        gets = []\n        for i in range(0, 110, 5):\n            name = f'key_{i:03d}_value'.encode()\n            buf = ctypes.create_string_buffer(name)\n            m = lib.stbds_hmget_key(m, size, ctypes.cast(buf, ctypes.c_void_p), ctypes.sizeof(ctypes.c_void_p), 1)\n            idx = hdr(m-size).temp\n            gets.append((idx, StrEntry.from_address(m + idx*size).value))\n        for i in range(1, 96, 3):\n            buf = ctypes.create_string_buffer(source_names[i])\n            m = lib.stbds_hmdel_key(m, size, ctypes.cast(buf, ctypes.c_void_p), ctypes.sizeof(ctypes.c_void_p), 0, 1)\n        entries = [(ctypes.string_at(StrEntry.from_address(m+i*size).key).decode(),\n                    StrEntry.from_address(m+i*size).value)\n                   for i in range(hdr(m-size).length-1)]\n        string_modes[str(mode)] = (hdr(m-size).length, hdr(m-size).capacity,\n                                   table_snapshot(m-size), gets, entries)\n        lib.stbds_hmfree_func(m-size, size)\n    out['strings'] = string_modes\n\n    # Direct arena, including regular and oversized blocks.\n    arena = Arena(None, 0, 0, 77)\n    arena_states = []\n    values = [b'a', b'b' * 510, b'c' * 700, b'd' * 2000, b'e' * ((1 << 20) + 17), b'z']\n    for value in values:\n        p = lib.stbds_stralloc(ctypes.byref(arena), value)\n        actual = ctypes.string_at(p)\n        arena_states.append((hashlib.sha256(actual).hexdigest(), len(actual), arena.remaining, arena.block, arena.mode))\n    lib.stbds_strreset(ctypes.byref(arena))\n    arena_states.append((arena.storage or 0, arena.remaining, arena.block, arena.mode))\n    out['arena'] = arena_states\n    return out\n\nleft = run(C_PATH)\nright = run(R_PATH)\nif left \"'!= right:\n    for key in left:\n        if left[key] != right[key]:\n            print('\"'MISMATCH', key)\n            print('C=', repr(left[key])[:4000])\n            print('R=', repr(right[key])[:4000])\n    raise SystemExit(1)\nprint('differential_state_sections=4 status=passed')\nprint('binary_final_entries=', len(left['binary'][2]))\nprint('string_modes=', ','.join(left['strings']))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
