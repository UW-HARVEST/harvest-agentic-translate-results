 92\t    let px = fastfloor(x);\n    93\t    let py = fastfloor(y);\n    94\t    let pz = fastfloor(z);\n    95\t    let x0 = ((px as u32) & x_mask) as usize;\n    96\t    let x1 = ((px.wrapping_add(1) as u32) & x_mask) as usize;\n    97\t    let y0 = ((py as u32) & y_mask) as usize;\n    98\t    let y1 = ((py.wrapping_add(1) as u32) & y_mask) as usize;\n    99\t    let z0 = ((pz as u32) & z_mask) as usize;\n   100\t    let z1 = ((pz.wrapping_add(1) as u32) & z_mask) as usize;\n   101\t\n   102\t    x -= px as f32;\n   103\t    let u = ease(x);\n   104\t    y -= py as f32;\n   105\t    let v = ease(y);\n   106\t    z -= pz as f32;\n   107\t    let w = ease(z);\n   108\t\n   109\t    let r0 = randtab(x0 + seed as usize);\n   110\t    let r1 = randtab(x1 + seed as usize);\n   111\t    let r00 = randtab(r0 + y0);\n   112\t    let r01 = randtab(r0 + y1);\n   113\t    let r10 = randtab(r1 + y0);\n   114\t    let r11 = randtab(r1 + y1);\n   115\t\n   116\t    let n000 = grad(grad_idx(r00 + z0), x, y, z);\n   117\t    let n001 = grad(grad_idx(r00 + z1), x, y, z - 1.0);\n   118\t    let n010 = grad(grad_idx(r01 + z0), x, y - 1.0, z);\n   119\t    let n011 = grad(grad_idx(r01 + z1), x, y - 1.0, z - 1.0);\n   120\t    let n100 = grad(grad_idx(r10 + z0), x - 1.0, y, z);\n   121\t    let n101 = grad(grad_idx(r10 + z1), x - 1.0, y, z - 1.0);\n   122\t    let n110 = grad(grad_idx(r11 + z0), x - 1.0, y - 1.0, z);\n   123\t    let n111 = grad(grad_idx(r11 + z1), x - 1.0, y - 1.0, z - 1.0);\n   124\t\n   125\t    let n00 = lerp(n000, n001, w);\n   126\t    let n01 = lerp(n010, n011, w);\n   127\t    let n10 = lerp(n100, n101, w);\n   128\t    let n11 = lerp(n110, n111, w);\n   129\t    let n0 = lerp(n00, n01, v);\n   130\t    let n1 = lerp(n10, n11, v);\n   131\t    lerp(n0, n1, u)\n   132\t}\n   133\t\n   134\tfn noise3(x: f32, y: f32, z: f32, x_wrap: i32, y_wrap: i32, z_wrap: i32) -> f32 {\n   135\t    noise3_internal(x, y, z, x_wrap, y_wrap, z_wrap, 0)\n   136\t}\n   137\t\n   138\tfn noise3_seed(x: f32, y: f32, z: f32, x_wrap: i32, y_wrap: i32, z_wrap: i32, seed: i32) -> f32 {\n   139\t    noise3_internal(x, y, z, x_wrap, y_wrap, z_wrap, seed as u8)\n   140\t}\n   141\t\n   142\tfn ridge_noise3(\n   143\t    x: f32,\n   144\t    y: f32,\n   145\t    z: f32,\n   146\t    lacunarity: f32,\n   147\t    gain: f32,\n   148\t    offset: f32,\n   149\t    octaves: i32,\n   150\t) -> f32 {\n   151\t    let mut frequency = 1.0f32;\n   152\t    let mut previous = 1.0f32;\n   153\t    let mut amplitude = 0.5f32;\n   154\t    let mut sum = 0.0f32;\n   155\t    for i in 0..octaves {\n   156\t        let mut r = noise3_internal(\n   157\t            x * frequency,\n   158\t            y * frequency,\n   159\t            z * frequency,\n   160\t            0,\n   161\t            0,\n   162\t            0,\n   163\t            i as u8,\n   164\t        );\n   165\t        r = offset - r.abs();\n   166\t        r *= r;\n   167\t        sum += r * amplitude * previous;\n   168\t        previous = r;\n   169\t        frequency *= lacunarity;\n   170\t        amplitude *= gain;\n   171\t    }\n   172\t    sum\n   173\t}\n   174\t\n   175\tfn fbm_noise3(x: f32, y: f32, z: f32, lacunarity: f32, gain: f32, octaves: i32) -> f32 {\n   176\t    let mut frequency = 1.0f32;\n   177\t    let mut amplitude = 1.0f32;\n   178\t    let mut sum = 0.0f32;\n   179\t    for i in 0..octaves {\n   180\t        sum += noise3_internal(\n   181\t            x * frequency,\n   182\t            y * frequency,\n   183\t            z * frequency,\n   184\t            0,\n   185\t            0,\n   186\t            0,\n   187\t            i as u8,\n   188\t        ) * amplitude;\n   189\t        frequency *= lacunarity;\n   190\t        amplitude *= gain;\n   191\t    }\n   192\t    sum\n   193\t}\n   194\t\n   195\tfn turbulence_noise3(x: f32, y: f32, z: f32, lacunarity: f32, gain: f32, octaves: i32) -> f32 {\n   196\t    let mut frequency = 1.0f32;\n   197\t    let mut amplitude = 1.0f32;\n   198\t    let mut sum = 0.0f32;\n   199\t    for i in 0..octaves {\n   200\t        let r = noise3_internal(\n   201\t            x * frequency,\n   202\t            y * frequency,\n   203\t            z * frequency,\n   204\t            0,\n   205\t            0,\n   206\t            0,\n   207\t            i as u8,\n   208\t        ) * amplitude;\n   209\t        sum += r.abs();\n   210\t        frequency *= lacunarity;\n   211\t        amplitude *= gain;\n   212\t    }\n   213\t    sum\n   214\t}\n   215\t\n   216\tfn noise3_wrap_nonpow2(\n   217\t    mut x: f32,\n   218\t    mut y: f32,\n   219\t    mut z: f32,\n   220\t    x_wrap: i32,\n   221\t    y_wrap: i32,\n   222\t    z_wrap: i32,\n   223\t    seed: u8,\n   224\t) -> f32 {\n   225\t    let px = fastfloor(x);\n   226\t    let py = fastfloor(y);\n   227\t    let pz = fastfloor(z);\n   228\t    let x_wrap2 = if x_wrap != 0 { x_wrap } else { 256 };\n   229\t    let y_wrap2 = if y_wrap != 0 { y_wrap } else { 256 };\n   230\t    let z_wrap2 = if z_wrap != 0 { z_wrap } else { 256 };\n   231\t    let mut x0 = px % x_wrap2;\n   232\t    let mut y0 = py % y_wrap2;\n   233\t    let mut z0 = pz % z_wrap2;\n   234\t    if x0 < 0 {\n   235\t        x0 += x_wrap2;\n   236\t    }\n   237\t    if y0 < 0 {\n   238\t        y0 += y_wrap2;\n   239\t    }\n   240\t    if z0 < 0 {\n   241\t        z0 += z_wrap2;\n   242\t    }\n   243\t    let x1 = (x0 + 1) % x_wrap2;\n   244\t    let y1 = (y0 + 1) % y_wrap2;\n   245\t    let z1 = (z0 + 1) % z_wrap2;\n   246\t    let x0 = x0 as usize;\n   247\t    let x1 = x1 as usize;\n   248\t    let y0 = y0 as usize;\n   249\t    let y1 = y1 as usize;\n   250\t    let z0 = z0 as usize;\n   251\t    let z1 = z1 as usize;\n   252\t\n   253\t    x -= px as f32;\n   254\t    let u = ease(x);\n   255\t    y -= py as f32;\n   256\t    let v = ease(y);\n   257\t    z -= pz as f32;\n   258\t    let w = ease(z);\n   259\t\n   260\t    let r0 = randtab(randtab(x0) + seed as usize);\n   261\t    let r1 = randtab(randtab(x1) + seed as usize);\n   262\t    let r00 = randtab(r0 + y0);\n   263\t    let r01 = randtab(r0 + y1);\n   264\t    let r10 = randtab(r1 + y0);\n   265\t    let r11 = randtab(r1 + y1);\n   266\t\n   267\t    let n000 = grad(grad_idx(r00 + z0), x, y, z);\n   268\t    let n001 = grad(grad_idx(r00 + z1), x, y, z - 1.0);\n   269\t    let n010 = grad(grad_idx(r01 + z0), x, y - 1.0, z);\n   270\t    let n011 = grad(grad_idx(r01 + z1), x, y - 1.0, z - 1.0);\n   271\t    let n100 = grad(grad_idx(r10 + z0), x - 1.0, y, z);\n   272\t    let n101 = grad(grad_idx(r10 + z1), x - 1.0, y, z - 1.0);\n   273\t    let n110 = grad(grad_idx(r11 + z0), x - 1.0, y - 1.0, z);\n   274\t    let n111 = grad(grad_idx(r11 + z1), x - 1.0, y - 1.0, z - 1.0);\n   275\t\n   276\t    let n00 = lerp(n000, n001, w);\n   277\t    let n01 = lerp(n010, n011, w);\n   278\t    let n10 = lerp(n100, n101, w);\n   279\t    let n11 = lerp(n110, n111, w);\n   280\t    let n0 = lerp(n00, n01, v);\n   281\t    let n1 = lerp(n10, n11, v);\n   282\t    lerp(n0, n1, u)\n   283\t}\n   284\t\n   285\t#[allow(clippy::too_many_arguments)]\n   286\tpub fn inner(\n   287\t    which: i32,\n   288\t    x: f32,\n   289\t    y: f32,\n   290\t    z: f32,\n   291\t    x_wrap: i32,\n   292\t    y_wrap: i32,\n   293\t    z_wrap: i32,\n   294\t    seed: i32,\n   295\t    lacunarity: f32,\n   296\t    gain: f32,\n   297\t    offset: f32,\n   298\t    octaves: i32,\n   299\t) -> f32 {\n   300\t    match which {\n   301\t        0 => noise3(x, y, z, x_wrap, y_wrap, z_wrap),\n   302\t        1 => noise3_seed(x, y, z, x_wrap, y_wrap, z_wrap, seed),\n   303\t        2 => ridge_noise3(x, y, z, lacunarity, gain, offset, octaves),\n   304\t        3 => fbm_noise3(x, y, z, lacunarity, gain, octaves),\n   305\t        4 => turbulence_noise3(x, y, z, lacunarity, gain, octaves),\n   306\t        5 => noise3_wrap_nonpow2(x, y, z, x_wrap, y_wrap, z_wrap, seed as u8),\n   307\t        _ => f32::NAN,\n   308\t    }\n   309\t}\n","exit_code":0,"status":"completed"}}
