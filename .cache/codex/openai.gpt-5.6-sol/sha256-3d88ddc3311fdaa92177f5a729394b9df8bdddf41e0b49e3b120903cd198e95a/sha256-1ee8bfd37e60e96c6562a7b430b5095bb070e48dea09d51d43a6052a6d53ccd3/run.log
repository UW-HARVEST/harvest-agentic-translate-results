x supported value is LZ4_MAX_INPUT_SIZE.\ninclude/lz4.h:214:#define LZ4_MAX_INPUT_SIZE        0x7E000000   /* 2 113 929 216 bytes */\ninclude/lz4.h:215:#define LZ4_COMPRESSBOUND(isize)  ((unsigned)(isize) > (unsigned)LZ4_MAX_INPUT_SIZE ? 0 : (isize) + ((isize)/255) + 16)\ninclude/lz4.h:222:        inputSize  : max supported value is LZ4_MAX_INPUT_SIZE\ninclude/lz4.h:233:    Values <= 0 will be replaced by LZ4_ACCELERATION_DEFAULT (currently == 1, see lz4.c).\ninclude/lz4.h:234:    Values > LZ4_ACCELERATION_MAX will be replaced by LZ4_ACCELERATION_MAX (currently == 65537, see lz4.c).\ninclude/lz4.h:491:#define LZ4_DECODER_RING_BUFFER_SIZE(maxBlockSize) (65536 + 14 + (maxBlockSize))  /* for static allocation; maxBlockSize presumed valid */\ninclude/lz4.h:592:#define LZ4_STATIC_3504398509\ninclude/lz4.h:637: * which size is >= LZ4_DECOMPRESS_INPLACE_BUFFER_SIZE(decompressedSize).\ninclude/lz4.h:644: * history preservation, requiring input data to remain unmodified up to LZ4_DISTANCE_MAX,\ninclude/lz4.h:650: * - Reduce history size, by modifying LZ4_DISTANCE_MAX.\ninclude/lz4.h:652: *   Lower values will reduce compression ratio, except when input_size < LZ4_DISTANCE_MAX,\ninclude/lz4.h:666: * LZ4_COMPRESS_INPLACE_BUFFER_SIZE() depends on both maxCompressedSize and LZ4_DISTANCE_MAX,\ninclude/lz4.h:670:#define LZ4_DECOMPRESS_INPLACE_MARGIN(compressedSize)          (((compressedSize) >> 8) + 32)\ninclude/lz4.h:671:#define LZ4_DECOMPRESS_INPLACE_BUFFER_SIZE(decompressedSize)   ((decompressedSize) + LZ4_DECOMPRESS_INPLACE_MARGIN(decompressedSize))  /**< note: presumes that compressedSize < decompressedSize. note2: margin is overestimated a bit, since it could use compressedSize instead */\ninclude/lz4.h:673:#ifndef LZ4_DISTANCE_MAX   /* history window size; can be user-defined at compile time */\ninclude/lz4.h:674:#  define LZ4_DISTANCE_MAX 65535   /* set to maximum value by default */\ninclude/lz4.h:677:#define LZ4_COMPRESS_INPLACE_MARGIN                           (LZ4_DISTANCE_MAX + 32)   /* LZ4_DISTANCE_MAX can be safely replaced by srcSize when it's smaller */\ninclude/lz4.h:678:#define LZ4_COMPRESS_INPLACE_BUFFER_SIZE(maxCompressedSize)   ((maxCompressedSize) + LZ4_COMPRESS_INPLACE_MARGIN)  /**< maxCompressedSize is generally LZ4_COMPRESSBOUND(inputSize), but can be set to any lower value, with the risk that compression can fail (return code 0(zero)) */\ninclude/lz4.h:686:#define LZ4_H_98237428734687\ninclude/lz4.h:695:#define LZ4_HASHLOG   (LZ4_MEMORY_USAGE-2)\ninclude/lz4.h:696:#define LZ4_HASHTABLESIZE (1 << LZ4_MEMORY_USAGE)\ninclude/lz4.h:697:#define LZ4_HASH_SIZE_U32 (1 << LZ4_HASHLOG)       /* required as macro for static allocation */\ninclude/lz4.h:720:    LZ4_u32 hashTable[LZ4_HASH_SIZE_U32];\ninclude/lz4.h:729:#define LZ4_STREAM_MINSIZE  ((1UL << (LZ4_MEMORY_USAGE)) + 32)  /* static size, for inter-version compatibility */\ninclude/lz4.h:731:    char minStateSize[LZ4_STREAM_MINSIZE];\ninclude/lz4.h:765:#define LZ4_STREAMDECODE_MINSIZE 32\ninclude/lz4.h:767:    char minStateSize[LZ4_STREAMDECODE_MINSIZE];\n","exit_code":0,"status":"completed"}}
