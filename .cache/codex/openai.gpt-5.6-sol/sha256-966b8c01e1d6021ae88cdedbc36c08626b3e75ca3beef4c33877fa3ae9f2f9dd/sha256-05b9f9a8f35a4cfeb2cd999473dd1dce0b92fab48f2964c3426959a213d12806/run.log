{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes\nimport random\nfrom pathlib import Path\n\nroot = Path.cwd().parent\nc_lib = ctypes.CDLL(str(root / \\\"reference-build/libSimpleList.so\\\"))\nrust_lib = ctypes.CDLL(str(Path.cwd() / \\\"target/release/libsimple_list.so\\\"))\n\nclass ListNode(ctypes.Structure):\n    pass\n\nListNode._fields_ = [(\\\"value\\\", ctypes.c_int), (\\\"next\\\", ctypes.POINTER(ListNode))]\nfor lib in (c_lib, rust_lib):\n    lib.smallestValue.argtypes = [ctypes.POINTER(ListNode)]\n    lib.smallestValue.restype = ctypes.c_int\n\ndef make_list(values):\n    if not values:\n        return None, None\n    nodes = (ListNode * len(values))()\n    for i, value in enumerate(values):\n        nodes[i].value = value\n        nodes[i].next = ctypes.pointer(nodes[i + 1]) if i + 1 < len(values) else None\n    return nodes, ctypes.pointer(nodes[0])\n\ncases = [\n    [], [0], [-1], [2**31 - 1], [-2**31],\n    [3, 2, 1], [1, 2, 3], [7, 7, 7],\n    [2**31 - 1, 0, -2**31, 42, -2**31],\n]\nrng = random.Random(0x51A1E)\nfor _ in range(10_000):\n    cases.append([rng.randint(-(2**31), 2**31 - 1) for _ in range(rng.randint(0, 128))])\n\nfor index, values in enumerate(cases):\n    nodes, head = make_list(values)\n    expected = c_lib.smallestValue(head)\n    actual = rust_lib.smallestValue(head)\n    if actual \"'!= expected:\n        raise SystemExit(f\"case {index} differs: C={expected}, Rust={actual}, values={values!r}\")\n\nprint(f\"matched {len(cases)} ABI test cases\")\nprint(f\"null result: {rust_lib.smallestValue(None)}\")\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
