n   270\t    } else {\n   271\t        let d = sub_f32(da, db);\n   272\t        if d != 0.0 { div_f32(da, d) } else { 0.0 }\n   273\t    }\n   274\t}\n   275\t\n   276\t#[unsafe(no_mangle)]\n   277\tpub unsafe extern \"C\" fn c2RaytoAABB(a: C2Ray, b: C2Aabb, out: *mut C2Raycast) -> c_int {\n   278\t    let p0 = a.p;\n   279\t    let p1 = c2Add(a.p, c2Mulvs(a.d, a.t));\n   280\t    let a_box = C2Aabb {\n   281\t        min: c2Minv(p0, p1),\n   282\t        max: c2Maxv(p0, p1),\n   283\t    };\n   284\t    if c2AABBtoAABB(a_box, b) == 0 {\n   285\t        return 0;\n   286\t    }\n   287\t    let ab = c2Sub(p1, p0);\n   288\t    let n = c2Skew(ab);\n   289\t    let abs_n = c2Absv(n);\n   290\t    let half_extents = c2Mulvs(c2Sub(b.max, b.min), 0.5);\n   291\t    let center_of_b_box = c2Mulvs(c2Add(b.min, b.max), 0.5);\n   292\t    let dot = c2Dot(n, c2Sub(p0, center_of_b_box));\n   293\t    let d = sub_f32(\n   294\t        if dot < 0.0 { -dot } else { dot },\n   295\t        c2Dot(abs_n, half_extents),\n   296\t    );\n   297\t    if d > 0.0 {\n   298\t        return 0;\n   299\t    }\n   300\t    let da0 = signed_dist_point_to_plane_one_dimensional(p0.x, -1.0, b.min.x);\n   301\t    let db0 = signed_dist_point_to_plane_one_dimensional(p1.x, -1.0, b.min.x);\n   302\t    let da1 = signed_dist_point_to_plane_one_dimensional(p0.x, 1.0, b.max.x);\n   303\t    let db1 = signed_dist_point_to_plane_one_dimensional(p1.x, 1.0, b.max.x);\n   304\t    let da2 = signed_dist_point_to_plane_one_dimensional(p0.y, -1.0, b.min.y);\n   305\t    let db2 = signed_dist_point_to_plane_one_dimensional(p1.y, -1.0, b.min.y);\n   306\t    let da3 = signed_dist_point_to_plane_one_dimensional(p0.y, 1.0, b.max.y);\n   307\t    let db3 = signed_dist_point_to_plane_one_dimensional(p1.y, 1.0, b.max.y);\n   308\t    let mut t0 = ray_to_plane_one_dimensional(da0, db0);\n   309\t    let mut t1 = ray_to_plane_one_dimensional(da1, db1);\n   310\t    let mut t2 = ray_to_plane_one_dimensional(da2, db2);\n   311\t    let mut t3 = ray_to_plane_one_dimensional(da3, db3);\n   312\t    let hit0 = t0 <= 1.0;\n   313\t    let hit1 = t1 <= 1.0;\n   314\t    let hit2 = t2 <= 1.0;\n   315\t    let hit3 = t3 <= 1.0;\n   316\t    let hit = hit0 | hit1 | hit2 | hit3;\n   317\t    if hit {\n   318\t        t0 = mul_f32((hit0 as c_int) as f32, t0);\n   319\t        t1 = mul_f32((hit1 as c_int) as f32, t1);\n   320\t        t2 = mul_f32((hit2 as c_int) as f32, t2);\n   321\t        t3 = mul_f32((hit3 as c_int) as f32, t3);\n   322\t        unsafe {\n   323\t            if t0 >= t1 && t0 >= t2 && t0 >= t3 {\n   324\t                (*out).t = mul_f32(t0, a.t);\n   325\t                (*out).n = c2V(-1.0, 0.0);\n   326\t            } else if t1 >= t0 && t1 >= t2 && t1 >= t3 {\n   327\t                (*out).t = mul_f32(t1, a.t);\n   328\t                (*out).n = c2V(1.0, 0.0);\n   329\t            } else if t2 >= t0 && t2 >= t1 && t2 >= t3 {\n   330\t                (*out).t = mul_f32(t2, a.t);\n   331\t                (*out).n = c2V(0.0, -1.0);\n   332\t            } else {\n   333\t                (*out).t = mul_f32(t3, a.t);\n   334\t                (*out).n = c2V(0.0, 1.0);\n   335\t            }\n   336\t        }\n   337\t        1\n   338\t    } else {\n   339\t        0\n   340\t    }\n   341\t}\n   342\t\n   343\t#[unsafe(no_mangle)]\n   344\tpub extern \"C\" fn c2CCW90(a: C2v) -> C2v {\n   345\t    C2v { x: a.y, y: -a.x }\n   346\t}\n   347\t\n   348\t#[unsafe(no_mangle)]\n   349\tpub extern \"C\" fn c2MulmvT(a: C2m, b: C2v) -> C2v {\n   350\t    C2v {\n   351\t        x: add_f32(mul_f32(a.x.x, b.x), mul_f32(a.x.y, b.y)),\n   352\t        y: add_f32(mul_f32(a.y.x, b.x), mul_f32(a.y.y, b.y)),\n   353\t    }\n   354\t}\n   355\t\n   356\t#[unsafe(no_mangle)]\n   357\tpub extern \"C\" fn c2AABBtoPoint(a: C2Aabb, b: C2v) -> c_int {\n   358\t    let d0 = b.x < a.min.x;\n   359\t    let d1 = b.y < a.min.y;\n   360\t    let d2 = b.x > a.max.x;\n   361\t    let d3 = b.y > a.max.y;\n   362\t    (!(d0 | d1 | d2 | d3)) as c_int\n   363\t}\n   364\t\n   365\t#[unsafe(no_mangle)]\n   366\tpub extern \"C\" fn c2CircleToPoint(a: C2Circle, b: C2v) -> c_int {\n   367\t    let n = c2Sub(a.p, b);\n   368\t    let d2 = c2Dot(n, n);\n   369\t    (d2 < mul_f32(a.r, a.r)) as c_int\n   370\t}\n   371\t\n   372\t#[unsafe(no_mangle)]\n   373\tpub unsafe extern \"C\" fn c2RaytoCapsule(a: C2Ray, b: C2Capsule, out: *mut C2Raycast) -> c_int {\n   374\t    let mut m = C2m {\n   375\t        x: c2V(0.0, 0.0),\n   376\t        y: c2Norm(c2Sub(b.b, b.a)),\n   377\t    };\n   378\t    m.x = c2CCW90(m.y);\n   379\t    let cap_n = c2Sub(b.b, b.a);\n   380\t    let y_bb = c2MulmvT(m, cap_n);\n   381\t    let y_ap = c2MulmvT(m, c2Sub(a.p, b.a));\n   382\t    let y_ad = c2MulmvT(m, a.d);\n   383\t    let y_ae = c2Add(y_ap, c2Mulvs(y_ad, a.t));\n   384\t    let capsule_bb = C2Aabb {\n   385\t        min: c2V(-b.r, 0.0),\n   386\t        max: c2V(b.r, y_bb.y),\n   387\t    };\n   388\t    unsafe {\n   389\t        (*out).n = c2Norm(cap_n);\n   390\t        (*out).t = 0.0;\n   391\t    }\n   392\t    if c2AABBtoPoint(capsule_bb, y_ap) != 0 {\n   393\t        return 1;\n   394\t    } else {\n   395\t        let capsule_a = C2Circle { p: b.a, r: b.r };\n   396\t        let capsule_b = C2Circle { p: b.b, r: b.r };\n   397\t        if c2CircleToPoint(capsule_a, a.p) != 0 {\n   398\t            return 1;\n   399\t        } else if c2CircleToPoint(capsule_b, a.p) != 0 {\n   400\t            return 1;\n   401\t        }\n   402\t    }\n   403\t    let abs_y_ae_x = if y_ae.x < 0.0 { -y_ae.x } else { y_ae.x };\n   404\t    let abs_y_ap_x = if y_ap.x < 0.0 { -y_ap.x } else { y_ap.x };\n   405\t    if mul_f32(y_ae.x, y_ap.x) < 0.0\n   406\t        || (if abs_y_ae_x < abs_y_ap_x {\n   407\t            abs_y_ae_x\n   408\t        } else {\n   409\t            abs_y_ap_x\n   410\t        }) < b.r\n   411\t    {\n   412\t        let ca = C2Circle { p: b.a, r: b.r };\n   413\t        let cb = C2Circle { p: b.b, r: b.r };\n   414\t        if abs_y_ap_x < b.r {\n   415\t            if y_ap.y < 0.0 {\n   416\t                return unsafe { c2RaytoCircle(a, ca, out) };\n   417\t            } else {\n   418\t                return unsafe { c2RaytoCircle(a, cb, out) };\n   419\t            }\n   420\t        } else {\n   421\t            let c = if y_ap.x > 0.0 { b.r } else { -b.r };\n   422\t            let d = sub_f32(y_ae.x, y_ap.x);\n   423\t            let t = div_f32(sub_f32(c, y_ap.x), d);\n   424\t            let y = add_f32(y_ap.y, mul_f32(sub_f32(y_ae.y, y_ap.y), t));\n   425\t            if y <= 0.0 {\n   426\t                return unsafe { c2RaytoCircle(a, ca, out) };\n   427\t            }\n   428\t            if y >= y_bb.y {\n   429\t                return unsafe { c2RaytoCircle(a, cb, out) };\n   430\t            } else {\n   431\t                unsafe {\n   432\t                    (*out).n = if c > 0.0 { m.x } else { c2Skew(m.y) };\n   433\t                    (*out).t = mul_f32(t, a.t);\n   434\t                }\n   435\t                return 1;\n   436\t            }\n   437\t        }\n   438\t    }\n   439\t    0\n   440\t}\n   441\t\n   442\t#[unsafe(no_mangle)]\n   443\tpub unsafe extern \"C\" fn c2CastRay(\n   444\t    a: C2Ray,\n   445\t    b: *const c_void,\n   446\t    type_b: C2Type,\n   447\t    out: *mut C2Raycast,\n   448\t) -> c_int {\n   449\t    match type_b {\n   450\t        C2Type::Circle => unsafe { c2RaytoCircle(a, *(b.cast::<C2Circle>()), out) },\n   451\t        C2Type::Aabb => unsafe { c2RaytoAABB(a, *(b.cast::<C2Aabb>()), out) },\n   452\t        C2Type::Capsule => unsafe { c2RaytoCapsule(a, *(b.cast::<C2Capsule>()), out) },\n   453\t    }\n   454\t}\n   455\t\n   456\t#[unsafe(no_mangle)]\n   457\tpub unsafe extern \"C\" fn gen_ray(\n   458\t    cast1: *mut C2Raycast,\n   459\t    cast2: *mut C2Raycast,\n   460\t    cast3: *mut C2Raycast,\n   461\t    mp_x: f32,\n   462\t    mp_y: f32,\n   463\t    r_p_x: f32,\n   464\t    r_p_y: f32,\n   465\t    c_p_x: f32,\n   466\t    c_p_y: f32,\n   467\t    c_r: f32,\n   468\t    cap_a_x: f32,\n   469\t    cap_a_y: f32,\n   470\t    cap_b_x: f32,\n   471\t    cap_b_y: f32,\n   472\t    cap_r: f32,\n   473\t    bb_min_x: f32,\n   474\t    bb_min_y: f32,\n   475\t    bb_max_x: f32,\n   476\t    bb_max_y: f32,\n   477\t) -> c_int {\n   478\t    let mp = c2V(mp_x, mp_y);\n   479\t    let ray_p = c2V(r_p_x, r_p_y);\n   480\t    let ray_d = c2Norm(c2Sub(mp, ray_p));\n   481\t    let ray = C2Ray {\n   482\t        p: ray_p,\n   483\t        d: ray_d,\n   484\t        t: sub_f32(c2Dot(mp, ray_d), c2Dot(ray_p, ray_d)),\n   485\t    };\n   486\t    let circle = C2Circle {\n   487\t        p: c2V(c_p_x, c_p_y),\n   488\t        r: c_r,\n   489\t    };\n   490\t    let mut hit = unsafe {\n   491\t        c2CastRay(\n   492\t            ray,\n   493\t            (&circle as *const C2Circle).cast(),\n   494\t            C2Type::Circle,\n   495\t            cast1,\n   496\t        )\n   497\t    };\n   498\t    let capsule = C2Capsule {\n   499\t        a: c2V(cap_a_x, cap_a_y),\n   500\t        b: c2V(cap_b_x, cap_b_y),\n   501\t        r: cap_r,\n   502\t    };\n   503\t    hit += unsafe {\n   504\t        c2CastRay(\n   505\t            ray,\n   506\t            (&capsule as *const C2Capsule).cast(),\n   507\t            C2Type::Capsule,\n   508\t            cast2,\n   509\t        )\n   510\t    } << 1;\n   511\t    let aabb = C2Aabb {\n   512\t        min: c2V(bb_min_x, bb_min_y),\n   513\t        max: c2V(bb_max_x, bb_max_y),\n   514\t    };\n   515\t    hit += unsafe { c2CastRay(ray, (&aabb as *const C2Aabb).cast(), C2Type::Aabb, cast3) } << 2;\n   516\t    hit\n   517\t}\n\nLines: 517 src/lib.rs\n","exit_code":0,"status":"completed"}}
