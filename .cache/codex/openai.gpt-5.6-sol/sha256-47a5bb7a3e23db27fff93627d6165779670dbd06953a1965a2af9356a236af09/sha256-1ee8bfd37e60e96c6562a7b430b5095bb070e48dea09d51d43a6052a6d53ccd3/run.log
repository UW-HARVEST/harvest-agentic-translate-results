};\n            let rust_result = unsafe {\n                rust_compress_cdict(\n                    ptr::null_mut(),\n                    rust_output.as_mut_ptr().cast(),\n                    capacity,\n                    input.as_ptr().cast(),\n                    input.len(),\n                    rust_cdict,\n                    &preferences,\n                )\n            };\n            assert_eq!(c_result, rust_result);\n            assert_eq!(&c_output[..c_result], &rust_output[..rust_result]);\n            unsafe {\n                c_free_cdict(c_cdict);\n","exit_code":0,"status":"completed"}}
