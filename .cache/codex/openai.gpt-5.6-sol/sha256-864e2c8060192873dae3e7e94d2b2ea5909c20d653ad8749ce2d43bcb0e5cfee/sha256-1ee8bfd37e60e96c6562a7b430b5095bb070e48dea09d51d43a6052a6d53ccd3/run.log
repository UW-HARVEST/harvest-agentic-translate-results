\"C\" fn c2Dot(a: C2v, b: C2v) -> c_float {\n    ordered_add(ordered_mul(a.x, b.x), ordered_mul(a.y, b.y))\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2RotIdentity() -> C2r {\n    C2r { c: 1.0, s: 0.0 }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2xIdentity() -> C2x {\n    C2x {\n        p: c2V(0.0, 0.0),\n        r: c2RotIdentity(),\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2BBVerts(out: *mut C2v, bb: *mut C2Aabb) {\n    *out.add(0) = (*bb).min;\n    *out.add(1) = c2V((*bb).max.x, (*bb).min.y);\n    *out.add(2) = (*bb).max;\n    *out.add(3) = c2V((*bb).min.x, (*bb).max.y);\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2MakeProxy(\n    shape: *const c_void,\n    shape_type: C2Type,\n    p: *mut C2Proxy,\n) {\n    match shape_type {\n        C2_TYPE_CIRCLE => {\n            let c = shape.cast::<C2Circle>();\n            (*p).radius = (*c).r;\n            (*p).count = 1;\n            (*p).verts[0] = (*c).p;\n        }\n        C2_TYPE_AABB => {\n            (*p).radius = 0.0;\n            (*p).count = 4;\n            c2BBVerts((*p).verts.as_mut_ptr(), shape.cast_mut().cast::<C2Aabb>());\n        }\n        C2_TYPE_CAPSULE => {\n            let c = shape.cast::<C2Capsule>();\n            (*p).radius = (*c).r;\n            (*p).count = 2;\n            (*p).verts[0] = (*c).a;\n            (*p).verts[1] = (*c).b;\n        }\n        _ => {}\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Len(a: C2v) -> c_float {\n    c2Dot(a, a).sqrt()\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Det2(a: C2v, b: C2v) -> c_float {\n    ordered_sub(ordered_mul(a.x, b.y), ordered_mul(a.y, b.x))\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2GJKSimplexMetric(s: *mut C2Simplex) -> c_float {\n    match (*s).count {\n        2 => c2Len(c2Sub((*s).b.p, (*s).a.p)),\n        3 => c2Det2(c2Sub((*s).b.p, (*s).a.p), c2Sub((*s).c.p, (*s).a.p)),\n        _ => 0.0,\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulrv(a: C2r, b: C2