ad_text(text) != 0) {\n    77\t        fprintf(stderr, \"Error: Failed to load text\\n\");\n    78\t        return result;\n    79\t    }\n    80\t    \n    81\t    // Process all tokens using function pointers\n    82\t    token_t token;\n    83\t    while ((token = tokenizer_ops.next_token()).type != TOKEN_EOF) {\n    84\t        // Update counts\n    85\t        token_type_counts[token.type]++;\n    86\t        \n    87\t        switch (token.type) {\n    88\t            case TOKEN_WORD:\n    89\t            case TOKEN_IDENTIFIER:\n    90\t                result.word_count++;\n    91\t                track_word(token.value);\n    92\t                break;\n    93\t                \n    94\t            case TOKEN_NUMBER:\n    95\t                result.number_count++;\n    96\t                break;\n    97\t                \n    98\t            case TOKEN_KEYWORD:\n    99\t                result.keyword_count++;\n   100\t                break;\n   101\t                \n   102\t            case TOKEN_OPERATOR:\n   103\t                result.operator_count++;\n   104\t                break;\n   105\t                \n   106\t            case TOKEN_COMMENT:\n   107\t                result.comment_count++;\n   108\t                break;\n   109\t                \n   110\t            case TOKEN_STRING:\n   111\t                result.string_count++;\n   112\t                break;\n   113\t                \n   114\t            case TOKEN_NEWLINE:\n   115\t                result.line_count++;\n   116\t                break;\n   117\t                \n   118\t            default:\n   119\t                break;\n   120\t        }\n   121\t    }\n   122\t    \n   123\t    // Get final statistics using function pointer\n   124\t    size_t lines, tokens, chars;\n   125\t    tokenizer_ops.get_stats(&lines, &tokens, &chars);\n   126\t    \n   127\t    result.line_count = lines;\n   128\t    result.char_count = chars;\n   129\t    \n   130\t    return result;\n   131\t}\n   132\t\n   133\tvoid print_token_distribution(void) {\n   134\t    printf(\"\\n=== Token Distribution ===\\n\");\n   135\t    \n   136\t    const char *token_names[] = {\n   137\t        \"EOF\", \"WORD\", \"NUMBER\", \"PUNCTUATION\", \"WHITESPACE\",\n   138\t        \"NEWLINE\", \"IDENTIFIER\", \"KEYWORD\", \"OPERATOR\", \n   139\t        \"STRING\", \"COMMENT\", \"ERROR\"\n   140\t    };\n   141\t    \n   142\t    for (int i = 0; i < 12; i++) {\n   143\t        if (token_type_counts[i] > 0) {\n   144\t            printf(\"%s: %d\\n\", token_names[i], token_type_counts[i]);\n   145\t        }\n   146\t    }\n   147\t    \n   148\t    printf(\"\\n=== Most Common Words ===\\n\");\n   149\t    \n   150\t    // Simple bubble sort for display\n   151\t    for (int i = 0; i < num_common_words - 1; i++) {\n   152\t        for (int j = 0; j < num_common_words - i - 1; j++) {\n   153\t            if (common_word_counts[j] < common_word_counts[j + 1]) {\n   154\t                // Swap counts\n   155\t                int temp_count = common_word_counts[j];\n   156\t                common_word_counts[j] = common_word_counts[j + 1];\n   157\t                common_word_counts[j + 1] = temp_count;\n   158\t                \n   159\t                // Swap words\n   160\t                char temp_word[MAX_TOKEN_LENGTH];\n   161\t                strcpy(temp_word, common_words[j]);\n   162\t                strcpy(common_words[j], common_words[j + 1]);\n   163\t                strcpy(common_words[j + 1], temp_word);\n   164\t            }\n   165\t        }\n   166\t    }\n   167\t    \n   168\t    // Print top 10\n   169\t    int limit = num_common_words < 10 ? num_common_words : 10;\n   170\t    for (int i = 0; i < limit; i++) {\n   171\t        printf(\"%d. %s: %d times\\n\", i + 1, common_words[i], common_word_counts[i]);\n   172\t    }\n   173\t}\n   174\t\n   175\tint calculate_complexity_score(void) {\n   176\t    int score = 0;\n   177\t    \n   178\t    // Base score on keyword density\n   179\t    score += token_type_counts[TOKEN_KEYWORD] * 2;\n   180\t    \n   181\t    // Add points for operators\n   182\t    score += token_type_counts[TOKEN_OPERATOR];\n   183\t    \n   184\t    // Nesting indicators (braces)\n   185\t    score += token_type_counts[TOKEN_PUNCTUATION] / 10;\n   186\t    \n   187\t    // Comments reduce complexity (good documentation)\n   188\t    score -= token_type_counts[TOKEN_COMMENT];\n   189\t    \n   190\t    if (score < 0) score = 0;\n   191\t    \n   192\t    return score;\n   193\t}\n   194\t\n   195\tvoid find_patterns(const char *pattern) {\n   196\t    if (!initialized || !pattern) {\n   197\t        return;\n   198\t    }\n   199\t    \n   200\t    printf(\"\\n=== Searching for pattern: '%s' ===\\n\", pattern);\n   201\t    \n   202\t    // Reset tokenizer using function pointer\n   203\t    tokenizer_ops.reset();\n   204\t    \n   205\t    int count = 0;\n   206\t    token_t token;\n   207\t    \n   208\t    while ((token = tokenizer_ops.next_token()).type != TOKEN_EOF) {\n   209\t        if (strstr(token.value, pattern) != NULL) {\n   210\t            printf(\"Line %d, Column %d: %s\\n\", \n   211\t                   token.line, token.column, token.value);\n   212\t            count++;\n   213\t        }\n   214\t    }\n   215\t    \n   216\t    printf(\"Found %d occurrences\\n\", count);\n   217\t}\n","exit_code":0,"status":"completed"}}
