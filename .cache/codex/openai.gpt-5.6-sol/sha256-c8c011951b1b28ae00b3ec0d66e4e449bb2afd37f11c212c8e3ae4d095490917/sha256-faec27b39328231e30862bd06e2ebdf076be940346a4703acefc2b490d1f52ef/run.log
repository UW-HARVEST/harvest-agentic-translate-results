, \"switch\", \"case\", \"default\", \"do\", \"goto\",\n    49\t    \"enum\", \"union\", \"signed\", \"unsigned\", \"long\", \"short\"\n    50\t};\n    51\tstatic const int num_keywords = sizeof(keywords) / sizeof(keywords[0]);\n    52\t\n    53\t// Static helper functions (internal to this file)\n    54\tstatic int is_keyword(const char *str) {\n    55\t    for (int i = 0; i < num_keywords; i++) {\n    56\t        if (strcmp(str, keywords[i]) == 0) {\n    57\t            return 1;\n    58\t        }\n    59\t    }\n    60\t    return 0;\n    61\t}\n    62\t\n    63\tstatic char peek_char(void) {\n    64\t    if (current_position >= buffer_length) {\n    65\t        return '\\0';\n    66\t    }\n    67\t    return input_buffer[current_position];\n    68\t}\n    69\t\n    70\tstatic char advance_char(void) {\n    71\t    if (current_position >= buffer_length) {\n    72\t        return '\\0';\n    73\t    }\n    74\t    \n    75\t    char c = input_buffer[current_position++];\n    76\t    total_chars_processed++;\n    77\t    \n    78\t    if (c == '\\n') {\n    79\t        current_line++;\n    80\t        current_column = 1;\n    81\t        total_lines_processed++;\n    82\t    } else {\n    83\t        current_column++;\n    84\t    }\n    85\t    \n    86\t    return c;\n    87\t}\n    88\t\n    89\tstatic void skip_whitespace(void) {\n    90\t    while (peek_char() != '\\0' && isspace(peek_char()) && peek_char() != '\\n') {\n    91\t        advance_char();\n    92\t    }\n    93\t}\n    94\t\n    95\tstatic token_t create_token(token_type_t type, const char *value, size_t length) {\n    96\t    token_t token;\n    97\t    token.type = type;\n    98\t    token.length = length < MAX_TOKEN_LENGTH ? length : MAX_TOKEN_LENGTH - 1;\n    99\t    strncpy(token.value, value, token.length);\n   100\t    token.value[token.length] = '\\0';\n   101\t    token.line = current_line;\n   102\t    token.column = current_column - token.length;\n   103\t    total_tokens_processed++;\n   104\t    return token;\n   105\t}\n   106\t\n   107\tstatic token_t scan_word(void) {\n   108\t    char buffer[MAX_TOKEN_LENGTH];\n   109\t    size_t length = 0;\n   110\t    \n   111\t    while (peek_char() != '\\0' && \n   112\t           (isalnum(peek_char()) || peek_char() == '_') && \n   113\t           length < MAX_TOKEN_LENGTH - 1) {\n   114\t        buffer[length++] = advance_char();\n   115\t    }\n   116\t    \n   117\t    buffer[length] = '\\0';\n   118\t    \n   119\t    // Check if it's a keyword\n   120\t    if (is_keyword(buffer)) {\n   121\t        return create_token(TOKEN_KEYWORD, buffer, length);\n   122\t    }\n   123\t    \n   124\t    return create_token(TOKEN_IDENTIFIER, buffer, length);\n   125\t}\n   126\t\n   127\tstatic token_t scan_number(void) {\n   128\t    char buffer[MAX_TOKEN_LENGTH];\n   129\t    size_t length = 0;\n   130\t    int has_decimal = 0;\n   131\t    \n   132\t    while (peek_char() != '\\0' && \n   133\t           (isdigit(peek_char()) || peek_char() == '.') && \n   134\t           length < MAX_TOKEN_LENGTH - 1) {\n   135\t        \n   136\t        if (peek_char() == '.') {\n   137\t            if (has_decimal) {\n   138\t                break; // Second decimal point\n   139\t            }\n   140\t            has_decimal = 1;\n   141\t        }\n   142\t        \n   143\t        buffer[length++] = advance_char();\n   144\t    }\n   145\t    \n   146\t    buffer[length] = '\\0';\n   147\t    return create_token(TOKEN_NUMBER, buffer, length);\n   148\t}\n   149\t\n   150\tstatic token_t scan_string(void) {\n   151\t    char buffer[MAX_TOKEN_LENGTH];\n   152\t    size_t length = 0;\n   153\t    char quote = advance_char(); // Consume opening quote\n   154\t    \n   155\t    buffer[length++] = quote;\n   156\t    \n   157\t    while (peek_char() != '\\0' && \n   158\t           peek_char() != quote && \n   159\t           peek_char() != '\\n' &&\n   160\t           length < MAX_TOKEN_LENGTH - 2) {\n   161\t        \n   162\t        if (peek_char() == '\\\\') {\n   163\t            buffer[length++] = advance_char(); // Escape character\n   164\t            if (peek_char() != '\\0') {\n   165\t                buffer[length++] = advance_char(); // Escaped character\n   166\t            }\n   167\t        } else {\n   168\t            buffer[length++] = advance_char();\n   169\t        }\n   170\t    }\n   171\t    \n   172\t    if (peek_char() == quote) {\n   173\t        buffer[length++] = advance_char(); // Closing quote\n   174\t    }\n   175\t    \n   176\t    buffer[length] = '\\0';\n   177\t    return create_token(TOKEN_STRING, buffer, length);\n   178\t}\n   179\t\n   180\tstatic token_t scan_comment(void) {\n   181\t    char buffer[MAX_TOKEN_LENGTH];\n   182\t    size_t length = 0;\n   183\t    \n   184\t    // Assume we've seen '/'\n   185\t    buffer[length++] = advance_char(); // First '/'\n   186\t    \n   187\t    if (peek_char() == '/') {\n   188\t        // Single-line comment\n   189\t        buffer[length++] = advance_char(); // Second '/'\n   190\t        \n   191\t        while (peek_char() != '\\0' && \n   192\t               peek_char() != '\\n' && \n   193\t               length < MAX_TOKEN_LENGTH - 1) {\n   194\t            buffer[length++] = advance_char();\n   195\t        }\n   196\t    } else if (peek_char() == '*') {\n   197\t        // Multi-line comment\n   198\t        buffer[length++] = advance_char(); // '*'\n   199\t        \n   200\t        while (peek_char() != '\\0' && length < MAX_TOKEN_LENGTH - 2) {\n   201\t            if (peek_char() == '*') {\n   202\t                buffer[length++] = advance_char();\n   203\t                if (peek_char() == '/') {\n   204\t                    buffer[length++] = advance_char();\n   205\t                    break;\n   206\t                }\n   207\t            } else {\n   208\t                buffer[length++] = advance_char();\n   209\t            }\n   210\t        }\n   211\t    }\n   212\t    \n   213\t    buffer[length] = '\\0';\n   214\t    return create_token(TOKEN_COMMENT, buffer, length);\n   215\t}\n   216\t\n   217\tstatic token_t scan_operator(void) {\n   218\t    char buffer[MAX_TOKEN_LENGTH];\n   219\t    size_t length = 0;\n   220\t    char c = peek_char();\n   221\t    \n   222\t    buffer[length++] = advance_char();\n   223\t    \n   224\t    // Check for two-character operators\n   225\t    char next = peek_char();\n   226\t    if ((c == '=' && next == '=') ||\n   227\t        (c == '!' && next == '=') ||\n   228\t        (c == '<' && next == '=') ||\n   229\t        (c == '>' && next == '=') ||\n   230\t        (c == '&' && next == '&') ||\n   231\t        (c == '|' && next == '|') ||\n   232\t        (c == '+' && next == '+') ||\n   233\t        (c == '-' && next == '-') ||\n   234\t        (c == '-' && next == '>') ||\n   235\t        (c == '<' && next == '<') ||\n   236\t        (c == '>' && next == '>')) {\n   237\t        buffer[length++] = advance_char();\n   238\t    }\n   239\t    \n   240\t    buffer[length] = '\\0';\n   241\t    return create_token(TOKEN_OPERATOR, buffer, length);\n   242\t}\n   243\t\n   244\t// Public functions that use static globals\n   245\ttoken_t tokenizer_next_token(void) {\n   246\t    // Check if we have a lookahead token\n   247\t    if (lookahead_valid) {\n   248\t        lookahead_valid = 0;\n   249\t        return lookahead_token;\n   250\t    }\n   251\t    \n   252\t    skip_whitespace();\n   253\t    \n   254\t    if (current_position >= buffer_length) {\n   255\t        return create_token(TOKEN_EOF, \"\", 0);\n   256\t    }\n   257\t    \n   258\t    char c = peek_char();\n   259\t    \n   260\t    // Newline\n   261\t    if (c == '\\n') {\n   262\t        char newline[2] = {advance_char(), '\\0'};\n   263\t        return create_token(TOKEN_NEWLINE, newline, 1);\n   264\t    }\n   265\t    \n   266\t    // Identifier or keyword\n   267\t    if (isalpha(c) || c == '_') {\n   268\t        return scan_word();\n   269\t    }\n   270\t    \n   271\t    // Number\n   272\t    if (isdigit(c)) {\n   273\t        return scan_number();\n   274\t    }\n   275\t    \n   276\t    // String\n   277\t    if (c == '\"' || c == '\\'') {\n   278\t        return scan_string();\n   279\t    }\n   280\t    \n   281\t    // Comment\n   282\t    if (c == '/' && (peek_char() == '/' || peek_char() == '*')) {\n   283\t        return scan_comment();\n   284\t    }\n   285\t    \n   286\t    // Operator\n   287\t    if (strchr(\"+-*/%=<>!&|^~?:\", c) != NULL) {\n   288\t        return scan_operator();\n   289\t    }\n   290\t    \n   291\t    // Punctuation\n   292\t    if (strchr(\"(){}[];,.\", c) != NULL) {\n   293\t        char punct[2] = {advance_char(), '\\0'};\n   294\t        return create_token(TOKEN_PUNCTUATION, punct, 1);\n   295\t    }\n   296\t    \n   297\t    // Unknown character\n   298\t    char unknown[2] = {advance_char(), '\\0'};\n   299\t    return create_token(TOKEN_ERROR, unknown, 1);\n   300\t}\n   301\t\n   302\ttoken_t tokenizer_peek_token(void) {\n   303\t    if (!lookahead_valid) {\n   304\t        lookahead_token = tokenizer_next_token();\n   305\t        lookahead_valid = 1;\n   306\t    }\n   307\t    return lookahead_token;\n   308\t}\n   309\t\n   310\tvoid tokenizer_reset(void) {\n   311\t    current_position = 0;\n   312\t    current_line = 1;\n   313\t    current_column = 1;\n   314\t    lookahead_valid = 0;\n   315\t    // Note: We don't reset total statistics\n   316\t}\n   317\t\n   318\tint tokenizer_load_text(const char *text) {\n   319\t    if (!text) {\n   320\t        return -1;\n   321\t    }\n   322\t    \n   323\t    size_t length = strlen(text);\n   324\t    if (length >= MAX_BUFFER_SIZE) {\n   325\t        fprintf(stderr, \"Error: Input text too large\\n\");\n   326\t        return -1;\n   327\t    }\n   328\t    \n   329\t    strncpy(input_buffer, text, MAX_BUFFER_SIZE - 1);\n   330\t    input_buffer[MAX_BUFFER_SIZE - 1] = '\\0';\n   331\t    buffer_length = length;\n   332\t    \n   333\t    tokenizer_reset();\n   334\t    \n   335\t    return 0;\n   336\t}\n   337\t\n   338\tvoid tokenizer_get_stats(size_t *lines, size_t *tokens, size_t *chars) {\n   339\t    if (lines) *lines = total_lines_processed;\n   340\t    if (tokens) *tokens = total_tokens_processed;\n   341\t    if (chars) *chars = total_chars_processed;\n   342\t}\n   343\t\n   344\t// Function that returns function pointers\n   345\ttokenizer_ops_t get_tokenizer_ops(void) {\n   346\t    tokenizer_ops_t ops;\n   347\t    ops.next_token = tokenizer_next_token;\n   348\t    ops.peek_token = tokenizer_peek_token;\n   349\t    ops.reset = tokenizer_reset;\n   350\t    ops.load_text = tokenizer_load_text;\n   351\t    ops.get_stats = tokenizer_get_stats;\n   352\t    return ops;\n   353\t}\n     1\t/*\n     2\t * Copyright 2025 MIT Lincoln Laboratory\n     3\t * Permission is hereby granted, free of charge,\n     4\t * to any person obtaining a copy of this software\n     5\t * and associated documentation files (the \"Software\"),\n     6\t * to deal in the Software without restriction,\n     7\t * including without limitation the rights to use, copy,\n     8\t * modify, merge, publish, distribute, sublicense,\n     9\t * and/or sell copies of the Software,\n    10\t * and to permit persons to whom the Software is furnished to do so,\n    11\t * subject to the following conditions:\n    12\t * \n    13\t * The above copyright notice and this permission notice\n    14\t * shall be included in all copies or substantial portions of the Software.\n    15\t * \n    16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    18\t * THE WARRANTIES OF MERCHANTABILITY,\n    19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    24\t */\n    25\t#include \"analyzer.h\"\n    26\t#include <stdio.h>\n    27\t#include <string.h>\n    28\t\n    29\t// Static storage for tokenizer function pointers\n    30\tstatic tokenizer_ops_t tokenizer_ops;\n    31\tstatic int initialized = 0;\n    32\t\n    33\t// Static arrays for tracking\n    34\tstatic int token_type_counts[20];\n    35\tstatic char common_words[100][MAX_TOKEN_LENGTH];\n    36\tstatic int common_word_counts[100];\n    37\tstatic int num_common_words = 0;\n    38\t\n    39\tvoid analyzer_init(tokenizer_ops_t ops) {\n    40\t    tokenizer_ops = ops;\n    41\t    initialized = 1;\n    42\t    \n    43\t    // Reset tracking arrays\n    44\t    memset(token_type_counts, 0, sizeof(token_type_counts));\n    45\t    memset(common_word_counts, 0, sizeof(common_word_counts));\n    46\t    num_common_words = 0;\n    47\t}\n    48\t\n    49\tstatic void track_word(const char *word) {\n    50\t    // Find if word already exists\n    51\t    for (int i = 0; i < num_common_words; i++) {\n    52\t        if (strcmp(common_words[i], word) == 0) {\n    53\t            common_word_counts[i]++;\n    54\t            return;\n    55\t        }\n    56\t    }\n    57\t    \n    58\t    // Add new word\n    59\t    if (num_common_words < 100) {\n    60\t        strncpy(common_words[num_common_words], word, MAX_TOKEN_LENGTH - 1);\n    61\t        common_words[num_common_words][MAX_TOKEN_LENGTH - 1] = '\\0';\n    62\t        common_word_counts[num_common_words] = 1;\n    63\t        num_common_words++;\n    64\t    }\n    65\t}\n    66\t\n    67\tanalysis_result_t analyze_text(const char *text) {\n    68\t    analysis_result_t result = {0};\n    69\t    \n    70\t    if (!initialized) {\n    71\t        fprintf(stderr, \"Error: Analyzer not initialized\\n\");\n    72\t        return result;\n    73\t    }\n    74\t    \n    75\t    // Load text using function pointer\n    76\t    if (tokenizer_ops.load_text(text) != 0) {\n    77\t        fprintf(stderr, \"Error: Failed to load text\\n\");\n    78\t        return result;\n    79\t    }\n    80\t    \n    81\t    // Process all tokens using function pointers\n    82\t    token_t token;\n    83\t    while ((token = tokenizer_ops.next_token()).type != TOKEN_EOF) {\n    84\t        // Update counts\n    85\t        token_type_counts[token.type]++;\n    86\t        \n    87\t        switch (token.type) {\n    88\t            case TOKEN_WORD:\n    89\t            case TOKEN_IDENTIFIER:\n    90\t                result.word_count++;\n    91\t                track_word(token.value);\n    92\t                break;\n    93\t                \n    94\t            case TOKEN_NUMBER:\n    95\t                result.number_count++;\n    96\t                break;\n    97\t                \n    98\t            case TOKEN_KEYWORD:\n    99\t                result.keyword_count++;\n   100\t                break;\n   101\t                \n   102\t            case TOKEN_OPERATOR:\n   103\t                result.operator_count++;\n   104\t                break;\n   105\t                \n   106\t            case TOKEN_COMMENT:\n   107\t                result.comment_count++;\n   108\t                break;\n   109\t                \n   110\t            case TOKEN_STRING:\n   111\t                result.string_count++;\n   112\t                break;\n   113\t                \n   114\t            case TOKEN_NEWLINE:\n   115\t                result.line_count++;\n   116\t                break;\n   117\t                \n   118\t            default:\n   119\t                break;\n   120\t        }\n   121\t    }\n   122\t    \n   123\t    // Get final statistics using function pointer\n   124\t    size_t lines, tokens, chars;\n   125\t    tokenizer_ops.get_stats(&lines, &tokens, &chars);\n   126\t    \n   127\t    result.line_count = lines;\n   128\t    result.char_count = chars;\n   129\t    \n   130\t    return result;\n   131\t}\n   132\t\n   133\tvoid print_token_distribution(void) {\n   134\t    printf(\"\\n=== Token Distribution ===\\n\");\n   135\t    \n   136\t    const char *token_names[] = {\n   137\t        \"EOF\", \"WORD\", \"NUMBER\", \"PUNCTUATION\", \"WHITESPACE\",\n   138\t        \"NEWLINE\", \"IDENTIFIER\", \"KEYWORD\", \"OPERATOR\", \n   139\t        \"STRING\", \"COMMENT\", \"ERROR\"\n   140\t    };\n   141\t    \n   142\t    for (int i = 0; i < 12; i++) {\n   143\t        if (token_type_counts[i] > 0) {\n   144\t            printf(\"%s: %d\\n\", token_names[i], token_type_counts[i]);\n   145\t        }\n   146\t    }\n   147\t    \n   148\t    printf(\"\\n=== Most Common Words ===\\n\");\n   149\t    \n   150\t    // Simple bubble sort for display\n   151\t    for (int i = 0; i < num_common_words - 1; i++) {\n   152\t        for (int j = 0; j < num_common_words - i - 1; j++) {\n   153\t            if (common_word_counts[j] < common_word_counts[j + 1]) {\n   154\t                // Swap counts\n   155\t                int temp_count = common_word_counts[j];\n   156\t                common_word_counts[j] = common_word_counts[j + 1];\n   157\t                common_word_counts[j + 1] = temp_count;\n   158\t                \n   159\t                // Swap words\n   160\t                char temp_word[MAX_TOKEN_LENGTH];\n   161\t                strcpy(temp_word, common_words[j]);\n   162\t                strcpy(common_words[j], common_words[j + 1]);\n   163\t                strcpy(common_words[j + 1], temp_word);\n   164\t            }\n   165\t        }\n   166\t    }\n   167\t    \n   168\t    // Print top 10\n   169\t    int limit = num_common_words < 10 ? num_common_words : 10;\n   170\t    for (int i = 0; i < limit; i++) {\n   171\t        printf(\"%d. %s: %d times\\n\", i + 1, common_words[i], common_word_counts[i]);\n   172\t    }\n   173\t}\n   174\t\n   175\tint calculate_complexity_score(void) {\n   176\t    int score = 0;\n   177\t    \n   178\t    // Base score on keyword density\n   179\t    score += token_type_counts[TOKEN_KEYWORD] * 2;\n   180\t    \n   181\t    // Add points for operators\n   182\t    score += token_type_counts[TOKEN_OPERATOR];\n   183\t    \n   184\t    // Nesting indicators (braces)\n   185\t    score += token_type_counts[TOKEN_PUNCTUATION] / 10;\n   186\t    \n   187\t    // Comments reduce complexity (good documentation)\n   188\t    score -= token_type_counts[TOKEN_COMMENT];\n   189\t    \n   190\t    if (score < 0) score = 0;\n   191\t    \n   192\t    return score;\n   193\t}\n   194\t\n   195\tvoid find_patterns(const char *pattern) {\n   196\t    if (!initialized || !pattern) {\n   197\t        return;\n   198\t    }\n   199\t    \n   200\t    printf(\"\\n=== Searching for pattern: '%s' ===\\n\", pattern);\n   201\t    \n   202\t    // Reset tokenizer using function pointer\n   203\t    tokenizer_ops.reset();\n   204\t    \n   205\t    int count = 0;\n   206\t    token_t token;\n   207\t    \n   208\t    while ((token = tokenizer_ops.next_token()).type != TOKEN_EOF) {\n   209\t        if (strstr(token.value, pattern) != NULL) {\n   210\t            printf(\"Line %d, Column %d: %s\\n\", \n   211\t                   token.line, token.column, token.value);\n   212\t            count++;\n   213\t        }\n   214\t    }\n   215\t    \n   216\t    printf(\"Found %d occurrences\\n\", count);\n   217\t}\n","exit_code":0,"status":"completed"}}
