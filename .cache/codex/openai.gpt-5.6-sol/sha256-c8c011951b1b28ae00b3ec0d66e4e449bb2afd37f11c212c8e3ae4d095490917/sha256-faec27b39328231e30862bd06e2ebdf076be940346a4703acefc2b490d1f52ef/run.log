{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc 'nl -ba translation/Cargo.toml && nl -ba translation/src/main.rs && nl -ba translation/src/tokenizer.rs && nl -ba translation/src/analyzer.rs'","aggregated_output":"     1\t[package]\n     2\tname = \"driver\"\n     3\tversion = \"0.1.0\"\n     4\tedition = \"2021\"\n     5\t\n     6\t[dependencies]\n     7\t\n     8\t[workspace]\n     9\t\n    10\t[[bin]]\n    11\tname = \"driver\"\n    12\tpath = \"src/main.rs\"\n     1\tmod analyzer;\n     2\tmod tokenizer;\n     3\t\n     4\tuse std::ffi::OsStr;\n     5\tuse std::fs::File;\n     6\tuse std::io::{self, BufRead, Read, Seek, SeekFrom, Write};\n     7\tuse std::os::unix::ffi::OsStrExt;\n     8\t\n     9\tuse analyzer::{AnalysisResult, Analyzer};\n    10\tuse tokenizer::{TokenType, MAX_BUFFER_SIZE};\n    11\t\n    12\tconst MAX_INPUT_SIZE: usize = 4096;\n    13\t\n    14\tstruct CInput<R> {\n    15\t    reader: R,\n    16\t}\n    17\t\n    18\timpl<R: BufRead> CInput<R> {\n    19\t    fn new(reader: R) -> Self {\n    20\t        Self { reader }\n    21\t    }\n    22\t\n    23\t    fn fgets(&mut self, capacity: usize) -> io::Result<Option<Vec<u8>>> {\n    24\t        let mut result = Vec::with_capacity(capacity.saturating_sub(1));\n    25\t\n    26\t        while result.len() < capacity.saturating_sub(1) {\n    27\t            let available = self.reader.fill_buf()?;\n    28\t            if available.is_empty() {\n    29\t                return if result.is_empty() {\n    30\t                    Ok(None)\n    31\t                } else {\n    32\t                    Ok(Some(result))\n    33\t                };\n    34\t            }\n    35\t\n    36\t            let room = capacity - 1 - result.len();\n    37\t            let considered = available.len().min(room);\n    38\t            let take = match available[..considered]\n    39\t                .iter()\n    40\t                .position(|byte| *byte == b'\\n')\n    41\t            {\n    42\t                Some(index) => index + 1,\n    43\t                None => considered,\n    44\t            };\n    45\t            let found_newline = available[take - 1] == b'\\n';\n    46\t            result.extend_from_slice(&available[..take]);\n    47\t            self.reader.consume(take);\n    48\t\n    49\t            if found_newline {\n    50\t                break;\n    51\t            }\n    52\t        }\n    53\t\n    54\t        Ok(Some(result))\n    55\t    }\n    56\t}\n    57\t\n    58\tfn c_string(bytes: &[u8]) -> &[u8] {\n    59\t    let length = bytes.iter().position(|byte| *byte == 0).unwrap_or(bytes.len());\n    60\t    &bytes[..length]\n    61\t}\n    62\t\n    63\tfn parse_decimal_int(bytes: &[u8]) -> Option<i32> {\n    64\t    let bytes = c_string(bytes);\n    65\t    let mut index = 0;\n    66\t    while index < bytes.len()\n    67\t        && matches!(bytes[index], b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r')\n    68\t    {\n    69\t        index += 1;\n    70\t    }\n    71\t\n    72\t    let negative = if bytes.get(index) == Some(&b'-') {\n    73\t        index += 1;\n    74\t        true\n    75\t    } else {\n    76\t        if bytes.get(index) == Some(&b'+') {\n    77\t            index += 1;\n    78\t        }\n    79\t        false\n    80\t    };\n    81\t\n    82\t    let start = index;\n    83\t    let limit = if negative {\n    84\t        (i64::MAX as u64) + 1\n    85\t    } else {\n    86\t        i64::MAX as u64\n    87\t    };\n    88\t    let mut magnitude = 0u64;\n    89\t    while index < bytes.len() && bytes[index].is_ascii_digit() {\n    90\t        magnitude = magnitude\n    91\t            .checked_mul(10)\n    92\t            .and_then(|value| value.checked_add((bytes[index] - b'0') as u64))\n    93\t            .unwrap_or(u64::MAX)\n    94\t            .min(limit);\n    95\t        index += 1;\n    96\t    }\n    97\t\n    98\t    if index == start {\n    99\t        None\n   100\t    } else {\n   101\t        let value = if negative {\n   102\t            if magnitude == (i64::MAX as u64) + 1 {\n   103\t                i64::MIN\n   104\t            } else {\n   105\t                -(magnitude as i64)\n   106\t            }\n   107\t        } else {\n   108\t            magnitude as i64\n   109\t        };\n   110\t        Some(value as i32)\n   111\t    }\n   112\t}\n   113\t\n   114\tfn print_menu<W: Write>(out: &mut W) -> io::Result<()> {\n   115\t    write!(\n   116\t        out,\n   117\t        \"\\n=== Text Analyzer ===\\n\\\n   118\t         1. Analyze text\\n\\\n   119\t         2. Load text from file\\n\\\n   120\t         3. Show token distribution\\n\\\n   121\t         4. Calculate complexity score\\n\\\n   122\t         5. Find pattern\\n\\\n   123\t         6. Interactive tokenizer\\n\\\n   124\t         7. Exit\\n\\\n   125\t         Choice: \"\n   126\t    )\n   127\t}\n   128\t\n   129\tfn print_analysis_result<W: Write>(result: &AnalysisResult, out: &mut W) -> io::Result<()> {\n   130\t    writeln!(out, \"\\n=== Analysis Results ===\")?;\n   131\t    writeln!(out, \"Words/Identifiers: {}\", result.word_count)?;\n   132\t    writeln!(out, \"Numbers: {}\", result.number_count)?;\n   133\t    writeln!(out, \"Keywords: {}\", result.keyword_count)?;\n   134\t    writeln!(out, \"Operators: {}\", result.operator_count)?;\n   135\t    writeln!(out, \"Comments: {}\", result.comment_count)?;\n   136\t    writeln!(out, \"Strings: {}\", result.string_count)?;\n   137\t    writeln!(out, \"Lines: {}\", result.line_count)?;\n   138\t    writeln!(out, \"Characters: {}\", result.char_count)\n   139\t}\n   140\t\n   141\tfn collect_text<R: BufRead>(input: &mut CInput<R>) -> io::Result<Vec<u8>> {\n   142\t    let mut text = Vec::with_capacity(MAX_INPUT_SIZE);\n   143\t\n   144\t    while let Some(line) = input.fgets(256)? {\n   145\t        if line.first() == Some(&b'\\n') {\n   146\t            break;\n   147\t        }\n   148\t\n   149\t        let source = c_string(&line);\n   150\t        let room = MAX_INPUT_SIZE - 1 - text.len();\n   151\t        text.extend_from_slice(&source[..source.len().min(room)]);\n   152\t    }\n   153\t\n   154\t    Ok(text)\n   155\t}\n   156\t\n   157\tfn interactive_tokenizer<R: BufRead, W: Write>(\n   158\t    analyzer: &mut Analyzer,\n   159\t    input: &mut CInput<R>,\n   160\t    out: &mut W,\n   161\t) -> io::Result<()> {\n   162\t    writeln!(out, \"\\nEnter text (empty line to stop):\")?;\n   163\t    out.flush()?;\n   164\t    let text = collect_text(input)?;\n   165\t\n   166\t    if analyzer.tokenizer_mut().load_text(&text) != 0 {\n   167\t        writeln!(out, \"Failed to load text\")?;\n   168\t        return Ok(());\n   169\t    }\n   170\t\n   171\t    writeln!(out, \"\\n=== Tokens ===\")?;\n   172\t    const TOKEN_TYPE_NAMES: [&str; 12] = [\n   173\t        \"EOF\", \"WORD\", \"NUMBER\", \"PUNCT\", \"SPACE\", \"NEWLINE\", \"IDENT\", \"KEYWORD\", \"OPERATOR\",\n   174\t        \"STRING\", \"COMMENT\", \"ERROR\",\n   175\t    ];\n   176\t\n   177\t    let mut count = 0i32;\n   178\t    loop {\n   179\t        let token = analyzer.tokenizer_mut().next_token();\n   180\t        if token.token_type == TokenType::Eof {\n   181\t            break;\n   182\t        }\n   183\t\n   184\t        write!(out, \"[{}] '\", TOKEN_TYPE_NAMES[token.token_type as usize])?;\n   185\t        out.write_all(&token.value)?;\n   186\t        writeln!(out, \"' (L{}:C{})\", token.line, token.column)?;\n   187\t        count = count.wrapping_add(1);\n   188\t\n   189\t        if count > 100 {\n   190\t            writeln!(out, \"... (truncated, too many tokens)\")?;\n   191\t            break;\n   192\t        }\n   193\t    }\n   194\t\n   195\t    Ok(())\n   196\t}\n   197\t\n   198\tfn read_file(filename: &[u8]) -> Option<Vec<u8>> {\n   199\t    let path = OsStr::from_bytes(filename);\n   200\t    let mut file = match File::open(path) {\n   201\t        Ok(file) => file,\n   202\t        Err(_) => {\n   203\t            let mut err = io::stderr().lock();\n   204\t            let _ = write!(err, \"Error: Could not open file '\");\n   205\t            let _ = err.write_all(filename);\n   206\t            let _ = writeln!(err, \"'\");\n   207\t            return None;\n   208\t        }\n   209\t    };\n   210\t\n   211\t    let size = match file.seek(SeekFrom::End(0)) {\n   212\t        Ok(size) => size,\n   213\t        Err(_) => return None,\n   214\t    };\n   215\t    let _ = file.seek(SeekFrom::Start(0));\n   216\t\n   217\t    if size > MAX_BUFFER_SIZE as u64 {\n   218\t        let _ = writeln!(io::stderr().lock(), \"Error: File too large\");\n   219\t        return None;\n   220\t    }\n   221\t\n   222\t    let mut content = Vec::with_capacity(size as usize);\n   223\t    let mut limited = file.take(size);\n   224\t    let _ = limited.read_to_end(&mut content);\n   225\t    Some(content)\n   226\t}\n   227\t\n   228\tfn run() -> io::Result<()> {\n   229\t    let stdin = io::stdin();\n   230\t    let stdout = io::stdout();\n   231\t    let mut input = CInput::new(stdin.lock());\n   232\t    let mut out = stdout.lock();\n   233\t    let mut analyzer = Analyzer::new();\n   234\t    analyzer.init();\n   235\t\n   236\t    writeln!(out, \"Text Analysis and Tokenization System\")?;\n   237\t    writeln!(\n   238\t        out,\n   239\t        \"This system demonstrates function pointers and static globals\"\n   240\t    )?;\n   241\t\n   242\t    loop {\n   243\t        print_menu(&mut out)?;\n   244\t        out.flush()?;\n   245\t\n   246\t        let line = match input.fgets(256)? {\n   247\t            Some(line) => line,\n   248\t            None => break,\n   249\t        };\n   250\t\n   251\t        let choice = match parse_decimal_int(&line) {\n   252\t            Some(choice) => choice,\n   253\t            None => {\n   254\t                writeln!(out, \"Invalid input\")?;\n   255\t                continue;\n   256\t            }\n   257\t        };\n   258\t\n   259\t        match choice {\n   260\t            1 => {\n   261\t                writeln!(out, \"Enter text to analyze (empty line to stop):\")?;\n   262\t                out.flush()?;\n   263\t                let text = collect_text(&mut input)?;\n   264\t                let result = analyzer.analyze_text(&text);\n   265\t                print_analysis_result(&result, &mut out)?;\n   266\t            }\n   267\t            2 => {\n   268\t                write!(out, \"Enter filename: \")?;\n   269\t                out.flush()?;\n   270\t                let Some(line) = input.fgets(256)? else {\n   271\t                    continue;\n   272\t                };\n   273\t                let filename = c_string(&line);\n   274\t                let filename = match filename.iter().position(|byte| *byte == b'\\n') {\n   275\t                    Some(index) => &filename[..index],\n   276\t                    None => filename,\n   277\t                };\n   278\t\n   279\t                if let Some(content) = read_file(filename) {\n   280\t                    let result = analyzer.analyze_text(&content);\n   281\t                    print_analysis_result(&result, &mut out)?;\n   282\t                }\n   283\t            }\n   284\t            3 => {\n   285\t                analyzer.print_token_distribution(&mut out)?;\n   286\t            }\n   287\t            4 => {\n   288\t                let score = analyzer.calculate_complexity_score();\n   289\t                writeln!(out, \"\\nComplexity Score: {}\", score)?;\n   290\t                if score < 10 {\n   291\t                    writeln!(out, \"Complexity: Low\")?;\n   292\t                } else if score < 50 {\n   293\t                    writeln!(out, \"Complexity: Medium\")?;\n   294\t                } else {\n   295\t                    writeln!(out, \"Complexity: High\")?;\n   296\t                }\n   297\t            }\n   298\t            5 => {\n   299\t                write!(out, \"Enter pattern to search: \")?;\n   300\t                out.flush()?;\n   301\t                let Some(line) = input.fgets(256)? else {\n   302\t                    continue;\n   303\t                };\n   304\t                let pattern = c_string(&line);\n   305\t                let pattern = match pattern.iter().position(|byte| *byte == b'\\n') {\n   306\t                    Some(index) => &pattern[..index],\n   307\t                    None => pattern,\n   308\t                };\n   309\t                analyzer.find_patterns(pattern, &mut out)?;\n   310\t            }\n   311\t            6 => {\n   312\t                interactive_tokenizer(&mut analyzer, &mut input, &mut out)?;\n   313\t            }\n   314\t            7 => {\n   315\t                writeln!(out, \"Goodbye!\")?;\n   316\t                return Ok(());\n   317\t            }\n   318\t            _ => {\n   319\t                writeln!(out, \"Invalid choice\")?;\n   320\t            }\n   321\t        }\n   322\t    }\n   323\t\n   324\t    Ok(())\n   325\t}\n   326\t\n   327\tfn main() {\n   328\t    let _ = run();\n   329\t}\n     1\tuse std::io::{self, Write};\n     2\t\n     3\tpub const MAX_TOKEN_LENGTH: usize = 256;\n     4\tpub const MAX_BUFFER_SIZE: usize = 8192;\n     5\t\n     6\t#[derive(Clone, Copy, Debug, Eq, PartialEq)]\n     7\t#[repr(usize)]\n     8\tpub enum TokenType {\n     9\t    Eof = 0,\n    10\t    Word,\n    11\t    Number,\n    12\t    Punctuation,\n    13\t    Whitespace,\n    14\t    Newline,\n    15\t    Identifier,\n    16\t    Keyword,\n    17\t    Operator,\n    18\t    String,\n    19\t    Comment,\n    20\t    Error,\n    21\t}\n    22\t\n    23\t#[derive(Clone, Debug)]\n    24\tpub struct Token {\n    25\t    pub token_type: TokenType,\n    26\t    pub value: Vec<u8>,\n    27\t    pub length: usize,\n    28\t    pub line: i32,\n    29\t    pub column: i32,\n    30\t}\n    31\t\n    32\tpub struct Tokenizer {\n    33\t    input_buffer: Vec<u8>,\n    34\t    buffer_length: usize,\n    35\t    current_position: usize,\n    36\t    current_line: i32,\n    37\t    current_column: i32,\n    38\t    total_tokens_processed: usize,\n    39\t    total_lines_processed: usize,\n    40\t    total_chars_processed: usize,\n    41\t    lookahead_token: Option<Token>,\n    42\t}\n    43\t\n    44\tconst KEYWORDS: [&[u8]; 32] = [\n    45\t    b\"if\",\n    46\t    b\"else\",\n    47\t    b\"while\",\n    48\t    b\"for\",\n    49\t    b\"return\",\n    50\t    b\"int\",\n    51\t    b\"char\",\n    52\t    b\"float\",\n    53\t    b\"double\",\n    54\t    b\"void\",\n    55\t    b\"struct\",\n    56\t    b\"typedef\",\n    57\t    b\"const\",\n    58\t    b\"static\",\n    59\t    b\"extern\",\n    60\t    b\"auto\",\n    61\t    b\"register\",\n    62\t    b\"sizeof\",\n    63\t    b\"break\",\n    64\t    b\"continue\",\n    65\t    b\"switch\",\n    66\t    b\"case\",\n    67\t    b\"default\",\n    68\t    b\"do\",\n    69\t    b\"goto\",\n    70\t    b\"enum\",\n    71\t    b\"union\",\n    72\t    b\"signed\",\n    73\t    b\"unsigned\",\n    74\t    b\"long\",\n    75\t    b\"short\",\n    76\t    b\"\",\n    77\t];\n    78\t\n    79\timpl Tokenizer {\n    80\t    pub fn new() -> Self {\n    81\t        Self {\n    82\t            input_buffer: Vec::new(),\n    83\t            buffer_length: 0,\n    84\t            current_position: 0,\n    85\t            current_line: 1,\n    86\t            current_column: 1,\n    87\t            total_tokens_processed: 0,\n    88\t            total_lines_processed: 0,\n    89\t            total_chars_processed: 0,\n    90\t            lookahead_token: None,\n    91\t        }\n    92\t    }\n    93\t\n    94\t    fn is_keyword(value: &[u8]) -> bool {\n    95\t        KEYWORDS[..31].iter().any(|keyword| *keyword == value)\n    96\t    }\n    97\t\n    98\t    fn peek_char(&self) -> u8 {\n    99\t        if self.current_position >= self.buffer_length {\n   100\t            0\n   101\t        } else {\n   102\t            self.input_buffer[self.current_position]\n   103\t        }\n   104\t    }\n   105\t\n   106\t    fn advance_char(&mut self) -> u8 {\n   107\t        if self.current_position >= self.buffer_length {\n   108\t            return 0;\n   109\t        }\n   110\t\n   111\t        let c = self.input_buffer[self.current_position];\n   112\t        self.current_position += 1;\n   113\t        self.total_chars_processed = self.total_chars_processed.wrapping_add(1);\n   114\t\n   115\t        if c == b'\\n' {\n   116\t            self.current_line = self.current_line.wrapping_add(1);\n   117\t            self.current_column = 1;\n   118\t            self.total_lines_processed = self.total_lines_processed.wrapping_add(1);\n   119\t        } else {\n   120\t            self.current_column = self.current_column.wrapping_add(1);\n   121\t        }\n   122\t\n   123\t        c\n   124\t    }\n   125\t\n   126\t    fn is_space(c: u8) -> bool {\n   127\t        matches!(c, b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r')\n   128\t    }\n   129\t\n   130\t    fn is_alpha(c: u8) -> bool {\n   131\t        c.is_ascii_alphabetic()\n   132\t    }\n   133\t\n   134\t    fn is_alnum(c: u8) -> bool {\n   135\t        c.is_ascii_alphanumeric()\n   136\t    }\n   137\t\n   138\t    fn skip_whitespace(&mut self) {\n   139\t        while self.peek_char() != 0\n   140\t            && Self::is_space(self.peek_char())\n   141\t            && self.peek_char() != b'\\n'\n   142\t        {\n   143\t            self.advance_char();\n   144\t        }\n   145\t    }\n   146\t\n   147\t    fn create_token(&mut self, token_type: TokenType, value: &[u8]) -> Token {\n   148\t        let length = value.len().min(MAX_TOKEN_LENGTH - 1);\n   149\t        let column = self.current_column.wrapping_sub(length as i32);\n   150\t        self.total_tokens_processed = self.total_tokens_processed.wrapping_add(1);\n   151\t\n   152\t        Token {\n   153\t            token_type,\n   154\t            value: value[..length].to_vec(),\n   155\t            length,\n   156\t            line: self.current_line,\n   157\t            column,\n   158\t        }\n   159\t    }\n   160\t\n   161\t    fn scan_word(&mut self) -> Token {\n   162\t        let mut buffer = Vec::with_capacity(MAX_TOKEN_LENGTH);\n   163\t\n   164\t        while self.peek_char() != 0\n   165\t            && (Self::is_alnum(self.peek_char()) || self.peek_char() == b'_')\n   166\t            && buffer.len() < MAX_TOKEN_LENGTH - 1\n   167\t        {\n   168\t            let c = self.advance_char();\n   169\t            buffer.push(c);\n   170\t        }\n   171\t\n   172\t        let token_type = if Self::is_keyword(&buffer) {\n   173\t            TokenType::Keyword\n   174\t        } else {\n   175\t            TokenType::Identifier\n   176\t        };\n   177\t        self.create_token(token_type, &buffer)\n   178\t    }\n   179\t\n   180\t    fn scan_number(&mut self) -> Token {\n   181\t        let mut buffer = Vec::with_capacity(MAX_TOKEN_LENGTH);\n   182\t        let mut has_decimal = false;\n   183\t\n   184\t        while self.peek_char() != 0\n   185\t            && (self.peek_char().is_ascii_digit() || self.peek_char() == b'.')\n   186\t            && buffer.len() < MAX_TOKEN_LENGTH - 1\n   187\t        {\n   188\t            if self.peek_char() == b'.' {\n   189\t                if has_decimal {\n   190\t                    break;\n   191\t                }\n   192\t                has_decimal = true;\n   193\t            }\n   194\t\n   195\t            let c = self.advance_char();\n   196\t            buffer.push(c);\n   197\t        }\n   198\t\n   199\t        self.create_token(TokenType::Number, &buffer)\n   200\t    }\n   201\t\n   202\t    fn scan_string(&mut self) -> Token {\n   203\t        let mut buffer = Vec::with_capacity(MAX_TOKEN_LENGTH + 1);\n   204\t        let quote = self.advance_char();\n   205\t        buffer.push(quote);\n   206\t\n   207\t        while self.peek_char() != 0\n   208\t            && self.peek_char() != quote\n   209\t            && self.peek_char() != b'\\n'\n   210\t            && buffer.len() < MAX_TOKEN_LENGTH - 2\n   211\t        {\n   212\t            if self.peek_char() == b'\\\\' {\n   213\t                let c = self.advance_char();\n   214\t                buffer.push(c);\n   215\t                if self.peek_char() != 0 {\n   216\t                    let escaped = self.advance_char();\n   217\t                    buffer.push(escaped);\n   218\t                }\n   219\t            } else {\n   220\t                let c = self.advance_char();\n   221\t                buffer.push(c);\n   222\t            }\n   223\t        }\n   224\t\n   225\t        if self.peek_char() == quote {\n   226\t            let c = self.advance_char();\n   227\t            buffer.push(c);\n   228\t        }\n   229\t\n   230\t        self.create_token(TokenType::String, &buffer)\n   231\t    }\n   232\t\n   233\t    fn scan_comment(&mut self) -> Token {\n   234\t        let mut buffer = Vec::with_capacity(MAX_TOKEN_LENGTH);\n   235\t        let first = self.advance_char();\n   236\t        buffer.push(first);\n   237\t\n   238\t        if self.peek_char() == b'/' {\n   239\t            let second = self.advance_char();\n   240\t            buffer.push(second);\n   241\t\n   242\t            while self.peek_char() != 0\n   243\t                && self.peek_char() != b'\\n'\n   244\t                && buffer.len() < MAX_TOKEN_LENGTH - 1\n   245\t            {\n   246\t                let c = self.advance_char();\n   247\t                buffer.push(c);\n   248\t            }\n   249\t        } else if self.peek_char() == b'*' {\n   250\t            let star = self.advance_char();\n   251\t            buffer.push(star);\n   252\t\n   253\t            while self.peek_char() != 0 && buffer.len() < MAX_TOKEN_LENGTH - 2 {\n   254\t                if self.peek_char() == b'*' {\n   255\t                    let c = self.advance_char();\n   256\t                    buffer.push(c);\n   257\t                    if self.peek_char() == b'/' {\n   258\t                        let slash = self.advance_char();\n   259\t                        buffer.push(slash);\n   260\t                        break;\n   261\t                    }\n   262\t                } else {\n   263\t                    let c = self.advance_char();\n   264\t                    buffer.push(c);\n   265\t                }\n   266\t            }\n   267\t        }\n   268\t\n   269\t        self.create_token(TokenType::Comment, &buffer)\n   270\t    }\n   271\t\n   272\t    fn scan_operator(&mut self) -> Token {\n   273\t        let mut buffer = Vec::with_capacity(2);\n   274\t        let c = self.peek_char();\n   275\t        let first = self.advance_char();\n   276\t        buffer.push(first);\n   277\t\n   278\t        let next = self.peek_char();\n   279\t        if matches!(\n   280\t            (c, next),\n   281\t            (b'=', b'=')\n   282\t                | (b'!', b'=')\n   283\t                | (b'<', b'=')\n   284\t                | (b'>', b'=')\n   285\t                | (b'&', b'&')\n   286\t                | (b'|', b'|')\n   287\t                | (b'+', b'+')\n   288\t                | (b'-', b'-')\n   289\t                | (b'-', b'>')\n   290\t                | (b'<', b'<')\n   291\t                | (b'>', b'>')\n   292\t        ) {\n   293\t            let second = self.advance_char();\n   294\t            buffer.push(second);\n   295\t        }\n   296\t\n   297\t        self.create_token(TokenType::Operator, &buffer)\n   298\t    }\n   299\t\n   300\t    pub fn next_token(&mut self) -> Token {\n   301\t        if let Some(token) = self.lookahead_token.take() {\n   302\t            return token;\n   303\t        }\n   304\t\n   305\t        self.skip_whitespace();\n   306\t\n   307\t        if self.current_position >= self.buffer_length {\n   308\t            return self.create_token(TokenType::Eof, b\"\");\n   309\t        }\n   310\t\n   311\t        let c = self.peek_char();\n   312\t\n   313\t        if c == b'\\n' {\n   314\t            let newline = [self.advance_char()];\n   315\t            return self.create_token(TokenType::Newline, &newline);\n   316\t        }\n   317\t\n   318\t        if Self::is_alpha(c) || c == b'_' {\n   319\t            return self.scan_word();\n   320\t        }\n   321\t\n   322\t        if c.is_ascii_digit() {\n   323\t            return self.scan_number();\n   324\t        }\n   325\t\n   326\t        if c == b'\"' || c == b'\\'' {\n   327\t            return self.scan_string();\n   328\t        }\n   329\t\n   330\t        // The C condition peeks at the current slash twice, so every slash\n   331\t        // enters scan_comment, including division operators.\n   332\t        if c == b'/' && (self.peek_char() == b'/' || self.peek_char() == b'*') {\n   333\t            return self.scan_comment();\n   334\t        }\n   335\t\n   336\t        if b\"+-*/%=<>!&|^~?:\".contains(&c) {\n   337\t            return self.scan_operator();\n   338\t        }\n   339\t\n   340\t        if b\"(){}[];,.\".contains(&c) {\n   341\t            let punctuation = [self.advance_char()];\n   342\t            return self.create_token(TokenType::Punctuation, &punctuation);\n   343\t        }\n   344\t\n   345\t        let unknown = [self.advance_char()];\n   346\t        self.create_token(TokenType::Error, &unknown)\n   347\t    }\n   348\t\n   349\t    #[allow(dead_code)]\n   350\t    pub fn peek_token(&mut self) -> Token {\n   351\t        if self.lookahead_token.is_none() {\n   352\t            self.lookahead_token = Some(self.next_token());\n   353\t        }\n   354\t        self.lookahead_token.clone().unwrap()\n   355\t    }\n   356\t\n   357\t    pub fn reset(&mut self) {\n   358\t        self.current_position = 0;\n   359\t        self.current_line = 1;\n   360\t        self.current_column = 1;\n   361\t        self.lookahead_token = None;\n   362\t    }\n   363\t\n   364\t    pub fn load_text(&mut self, text: &[u8]) -> i32 {\n   365\t        let c_length = text.iter().position(|byte| *byte == 0).unwrap_or(text.len());\n   366\t\n   367\t        if c_length >= MAX_BUFFER_SIZE {\n   368\t            let _ = writeln!(io::stderr().lock(), \"Error: Input text too large\");\n   369\t            return -1;\n   370\t        }\n   371\t\n   372\t        self.input_buffer.clear();\n   373\t        self.input_buffer.extend_from_slice(&text[..c_length]);\n   374\t        self.buffer_length = c_length;\n   375\t        self.reset();\n   376\t        0\n   377\t    }\n   378\t\n   379\t    pub fn get_stats(&self) -> (usize, usize, usize) {\n   380\t        (\n   381\t            self.total_lines_processed,\n   382\t            self.total_tokens_processed,\n   383\t            self.total_chars_processed,\n   384\t        )\n   385\t    }\n   386\t}\n     1\tuse std::io::{self, Write};\n     2\t\n     3\tuse crate::tokenizer::{TokenType, Tokenizer};\n     4\t\n     5\t#[derive(Default)]\n     6\tpub struct AnalysisResult {\n     7\t    pub word_count: usize,\n     8\t    pub number_count: usize,\n     9\t    pub keyword_count: usize,\n    10\t    pub operator_count: usize,\n    11\t    pub comment_count: usize,\n    12\t    pub string_count: usize,\n    13\t    pub line_count: usize,\n    14\t    pub char_count: usize,\n    15\t}\n    16\t\n    17\tpub struct Analyzer {\n    18\t    tokenizer: Tokenizer,\n    19\t    initialized: bool,\n    20\t    token_type_counts: [i32; 20],\n    21\t    common_words: Vec<(Vec<u8>, i32)>,\n    22\t}\n    23\t\n    24\timpl Analyzer {\n    25\t    pub fn new() -> Self {\n    26\t        Self {\n    27\t            tokenizer: Tokenizer::new(),\n    28\t            initialized: false,\n    29\t            token_type_counts: [0; 20],\n    30\t            common_words: Vec::new(),\n    31\t        }\n    32\t    }\n    33\t\n    34\t    pub fn init(&mut self) {\n    35\t        self.initialized = true;\n    36\t        self.token_type_counts = [0; 20];\n    37\t        self.common_words.clear();\n    38\t    }\n    39\t\n    40\t    fn track_word(&mut self, word: &[u8]) {\n    41\t        for (existing, count) in &mut self.common_words {\n    42\t            if existing == word {\n    43\t                *count = count.wrapping_add(1);\n    44\t                return;\n    45\t            }\n    46\t        }\n    47\t\n    48\t        if self.common_words.len() < 100 {\n    49\t            self.common_words.push((word[..word.len().min(255)].to_vec(), 1));\n    50\t        }\n    51\t    }\n    52\t\n    53\t    pub fn analyze_text(&mut self, text: &[u8]) -> AnalysisResult {\n    54\t        let mut result = AnalysisResult::default();\n    55\t\n    56\t        if !self.initialized {\n    57\t            let _ = writeln!(io::stderr().lock(), \"Error: Analyzer not initialized\");\n    58\t            return result;\n    59\t        }\n    60\t\n    61\t        if self.tokenizer.load_text(text) != 0 {\n    62\t            let _ = writeln!(io::stderr().lock(), \"Error: Failed to load text\");\n    63\t            return result;\n    64\t        }\n    65\t\n    66\t        loop {\n    67\t            let token = self.tokenizer.next_token();\n    68\t            if token.token_type == TokenType::Eof {\n    69\t                break;\n    70\t            }\n    71\t\n    72\t            let index = token.token_type as usize;\n    73\t            self.token_type_counts[index] = self.token_type_counts[index].wrapping_add(1);\n    74\t\n    75\t            match token.token_type {\n    76\t                TokenType::Word | TokenType::Identifier => {\n    77\t                    result.word_count = result.word_count.wrapping_add(1);\n    78\t                    self.track_word(&token.value);\n    79\t                }\n    80\t                TokenType::Number => {\n    81\t                    result.number_count = result.number_count.wrapping_add(1);\n    82\t                }\n    83\t                TokenType::Keyword => {\n    84\t                    result.keyword_count = result.keyword_count.wrapping_add(1);\n    85\t                }\n    86\t                TokenType::Operator => {\n    87\t                    result.operator_count = result.operator_count.wrapping_add(1);\n    88\t                }\n    89\t                TokenType::Comment => {\n    90\t                    result.comment_count = result.comment_count.wrapping_add(1);\n    91\t                }\n    92\t                TokenType::String => {\n    93\t                    result.string_count = result.string_count.wrapping_add(1);\n    94\t                }\n    95\t                TokenType::Newline => {\n    96\t                    result.line_count = result.line_count.wrapping_add(1);\n    97\t                }\n    98\t                _ => {}\n    99\t            }\n   100\t        }\n   101\t\n   102\t        let (lines, _tokens, chars) = self.tokenizer.get_stats();\n   103\t        result.line_count = lines;\n   104\t        result.char_count = chars;\n   105\t        result\n   106\t    }\n   107\t\n   108\t    pub fn print_token_distribution<W: Write>(&mut self, out: &mut W) -> io::Result<()> {\n   109\t        writeln!(out, \"\\n=== Token Distribution ===\")?;\n   110\t\n   111\t        const TOKEN_NAMES: [&str; 12] = [\n   112\t            \"EOF\",\n   113\t            \"WORD\",\n   114\t            \"NUMBER\",\n   115\t            \"PUNCTUATION\",\n   116\t            \"WHITESPACE\",\n   117\t            \"NEWLINE\",\n   118\t            \"IDENTIFIER\",\n   119\t            \"KEYWORD\",\n   120\t            \"OPERATOR\",\n   121\t            \"STRING\",\n   122\t            \"COMMENT\",\n   123\t            \"ERROR\",\n   124\t        ];\n   125\t\n   126\t        for (index, name) in TOKEN_NAMES.iter().enumerate() {\n   127\t            if self.token_type_counts[index] > 0 {\n   128\t                writeln!(out, \"{}: {}\", name, self.token_type_counts[index])?;\n   129\t            }\n   130\t        }\n   131\t\n   132\t        writeln!(out, \"\\n=== Most Common Words ===\")?;\n   133\t\n   134\t        let count = self.common_words.len();\n   135\t        for i in 0..count.saturating_sub(1) {\n   136\t            for j in 0..count - i - 1 {\n   137\t                if self.common_words[j].1 < self.common_words[j + 1].1 {\n   138\t                    self.common_words.swap(j, j + 1);\n   139\t                }\n   140\t            }\n   141\t        }\n   142\t\n   143\t        for (index, (word, occurrences)) in self.common_words.iter().take(10).enumerate() {\n   144\t            write!(out, \"{}. \", index + 1)?;\n   145\t            out.write_all(word)?;\n   146\t            writeln!(out, \": {} times\", occurrences)?;\n   147\t        }\n   148\t\n   149\t        Ok(())\n   150\t    }\n   151\t\n   152\t    pub fn calculate_complexity_score(&self) -> i32 {\n   153\t        let mut score = 0i32;\n   154\t        score = score.wrapping_add(\n   155\t            self.token_type_counts[TokenType::Keyword as usize].wrapping_mul(2),\n   156\t        );\n   157\t        score = score.wrapping_add(self.token_type_counts[TokenType::Operator as usize]);\n   158\t        score = score.wrapping_add(\n   159\t            self.token_type_counts[TokenType::Punctuation as usize].wrapping_div(10),\n   160\t        );\n   161\t        score = score.wrapping_sub(self.token_type_counts[TokenType::Comment as usize]);\n   162\t        score.max(0)\n   163\t    }\n   164\t\n   165\t    pub fn find_patterns<W: Write>(&mut self, pattern: &[u8], out: &mut W) -> io::Result<()> {\n   166\t        if !self.initialized {\n   167\t            return Ok(());\n   168\t        }\n   169\t\n   170\t        write!(out, \"\\n=== Searching for pattern: '\")?;\n   171\t        out.write_all(pattern)?;\n   172\t        writeln!(out, \"' ===\")?;\n   173\t\n   174\t        self.tokenizer.reset();\n   175\t        let mut count = 0i32;\n   176\t\n   177\t        loop {\n   178\t            let token = self.tokenizer.next_token();\n   179\t            if token.token_type == TokenType::Eof {\n   180\t                break;\n   181\t            }\n   182\t\n   183\t            if contains(&token.value, pattern) {\n   184\t                write!(out, \"Line {}, Column {}: \", token.line, token.column)?;\n   185\t                out.write_all(&token.value)?;\n   186\t                writeln!(out)?;\n   187\t                count = count.wrapping_add(1);\n   188\t            }\n   189\t        }\n   190\t\n   191\t        writeln!(out, \"Found {} occurrences\", count)\n   192\t    }\n   193\t\n   194\t    pub fn tokenizer_mut(&mut self) -> &mut Tokenizer {\n   195\t        &mut self.tokenizer\n   196\t    }\n   197\t}\n   198\t\n   199\tfn contains(haystack: &[u8], needle: &[u8]) -> bool {\n   200\t    needle.is_empty()\n   201\t        || (needle.len() <= haystack.len()\n   202\t            && haystack\n   203\t                .windows(needle.len())\n   204\t                .any(|window| window == needle))\n   205\t}\n","exit_code":0,"status":"completed"}}
