 = input_buffer[current_position++];\n    76\t    total_chars_processed++;\n    77\t    \n    78\t    if (c == '\\n') {\n    79\t        current_line++;\n    80\t        current_column = 1;\n    81\t        total_lines_processed++;\n    82\t    } else {\n    83\t        current_column++;\n    84\t    }\n    85\t    \n    86\t    return c;\n    87\t}\n    88\t\n    89\tstatic void skip_whitespace(void) {\n    90\t    while (peek_char() != '\\0' && isspace(peek_char()) && peek_char() != '\\n') {\n    91\t        advance_char();\n    92\t    }\n    93\t}\n    94\t\n    95\tstatic token_t create_token(token_type_t type, const char *value, size_t length) {\n    96\t    token_t token;\n    97\t    token.type = type;\n    98\t    token.length = length < MAX_TOKEN_LENGTH ? length : MAX_TOKEN_LENGTH - 1;\n    99\t    strncpy(token.value, value, token.length);\n   100\t    token.value[token.length] = '\\0';\n   101\t    token.line = current_line;\n   102\t    token.column = current_column - token.length;\n   103\t    total_tokens_processed++;\n   104\t    return token;\n   105\t}\n   106\t\n   107\tstatic token_t scan_word(void) {\n   108\t    char buffer[MAX_TOKEN_LENGTH];\n   109\t    size_t length = 0;\n   110\t    \n   111\t    while (peek_char() != '\\0' && \n   112\t           (isalnum(peek_char()) || peek_char() == '_') && \n   113\t           length < MAX_TOKEN_LENGTH - 1) {\n   114\t        buffer[length++] = advance_char();\n   115\t    }\n   116\t    \n   117\t    buffer[length] = '\\0';\n   118\t    \n   119\t    // Check if it's a keyword\n   120\t    if (is_keyword(buffer)) {\n   121\t        return create_token(TOKEN_KEYWORD, buffer, length);\n   122\t    }\n   123\t    \n   124\t    return create_token(TOKEN_IDENTIFIER, buffer, length);\n   125\t}\n   126\t\n   127\tstatic token_t scan_number(void) {\n   128\t    char buffer[MAX_TOKEN_LENGTH];\n   129\t    size_t length = 0;\n   130\t    int has_decimal = 0;\n   131\t    \n   132\t    while (peek_char() != '\\0' && \n   133\t           (isdigit(peek_char()) || peek_char() == '.') && \n   134\t           length < MAX_TOKEN_LENGTH - 1) {\n   135\t        \n   136\t        if (peek_char() == '.') {\n   137\t            if (has_decimal) {\n   138\t                break; // Second decimal point\n   139\t            }\n   140\t            has_decimal = 1;\n   141\t        }\n   142\t        \n   143\t        buffer[length++] = advance_char();\n   144\t    }\n   145\t    \n   146\t    buffer[length] = '\\0';\n   147\t    return create_token(TOKEN_NUMBER, buffer, length);\n   148\t}\n   149\t\n   150\tstatic token_t scan_string(void) {\n   151\t    char buffer[MAX_TOKEN_LENGTH];\n   152\t    size_t length = 0;\n   153\t    char quote = advance_char(); // Consume opening quote\n   154\t    \n   155\t    buffer[length++] = quote;\n   156\t    \n   157\t    while (peek_char() != '\\0' && \n   158\t           peek_char() != quote && \n   159\t           peek_char() != '\\n' &&\n   160\t           length < MAX_TOKEN_LENGTH - 2) {\n   161\t        \n   162\t        if (peek_char() == '\\\\') {\n   163\t            buffer[length++] = advance_char(); // Escape character\n   164\t            if (peek_char() != '\\0') {\n   165\t                buffer[length++] = advance_char(); // Escaped character\n   166\t            }\n   167\t        } else {\n   168\t            buffer[length++] = advance_char();\n   169\t        }\n   170\t    }\n   171\t    \n   172\t    if (peek_char() == quote) {\n   173\t        buffer[length++] = advance_char(); // Closing quote\n   174\t    }\n   175\t    \n   176\t    buffer[length] = '\\0';\n   177\t    return create_token(TOKEN_STRING, buffer, length);\n   178\t}\n   179\t\n   180\tstatic token_t scan_comment(void) {\n   181\t    char buffer[MAX_TOKEN_LENGTH];\n   182\t    size_t length = 0;\n   183\t    \n   184\t    // Assume we've seen '/'\n   185\t    buffer[length++] = advance_char(); // First '/'\n   186\t    \n   187\t    if (peek_char() == '/') {\n   188\t        // Single-line comment\n   189\t        buffer[length++] = advance_char(); // Second '/'\n   190\t        \n   191\t        while (peek_char() != '\\0' && \n   192\t               peek_char() != '\\n' && \n   193\t               length < MAX_TOKEN_LENGTH - 1) {\n   194\t            buffer[length++] = advance_char();\n   195\t        }\n   196\t    } else if (peek_char() == '*') {\n   197\t        // Multi-line comment\n   198\t        buffer[length++] = advance_char(); // '*'\n   199\t        \n   200\t        while (peek_char() != '\\0' && length < MAX_TOKEN_LENGTH - 2) {\n   201\t            if (peek_char() == '*') {\n   202\t                buffer[length++] = advance_char();\n   203\t                if (peek_char() == '/') {\n   204\t                    buffer[length++] = advance_char();\n   205\t                    break;\n   206\t                }\n   207\t            } else {\n   208\t                buffer[length++] = advance_char();\n   209\t            }\n   210\t        }\n   211\t    }\n   212\t    \n   213\t    buffer[length] = '\\0';\n   214\t    return create_token(TOKEN_COMMENT, buffer, length);\n   215\t}\n   216\t\n   217\tstatic token_t scan_operator(void) {\n   218\t    char buffer[MAX_TOKEN_LENGTH];\n   219\t    size_t length = 0;\n   220\t    char c = peek_char();\n   221\t    \n   222\t    buffer[length++] = advance_char();\n   223\t    \n   224\t    // Check for two-character operators\n   225\t    char next = peek_char();\n   226\t    if ((c == '=' && next == '=') ||\n   227\t        (c == '!' && next == '=') ||\n   228\t        (c == '<' && next == '=') ||\n   229\t        (c == '>' && next == '=') ||\n   230\t        (c == '&' && next == '&') ||\n   231\t        (c == '|' && next == '|') ||\n   232\t        (c == '+' && next == '+') ||\n   233\t        (c == '-' && next == '-') ||\n   234\t        (c == '-' && next == '>') ||\n   235\t        (c == '<' && next == '<') ||\n   236\t        (c == '>' && next == '>')) {\n   237\t        buffer[length++] = advance_char();\n   238\t    }\n   239\t    \n   240\t    buffer[length] = '\\0';\n   241\t    return create_token(TOKEN_OPERATOR, buffer, length);\n   242\t}\n   243\t\n   244\t// Public functions that use static globals\n   245\ttoken_t tokenizer_next_token(void) {\n   246\t    // Check if we have a lookahead token\n   247\t    if (lookahead_valid) {\n   248\t        lookahead_valid = 0;\n   249\t        return lookahead_token;\n   250\t    }\n   251\t    \n   252\t    skip_whitespace();\n   253\t    \n   254\t    if (current_position >= buffer_length) {\n   255\t        return create_token(TOKEN_EOF, \"\", 0);\n   256\t    }\n   257\t    \n   258\t    char c = peek_char();\n   259\t    \n   260\t    // Newline\n   261\t    if (c == '\\n') {\n   262\t        char newline[2] = {advance_char(), '\\0'};\n   263\t        return create_token(TOKEN_NEWLINE, newline, 1);\n   264\t    }\n   265\t    \n   266\t    // Identifier or keyword\n   267\t    if (isalpha(c) || c == '_') {\n   268\t        return scan_word();\n   269\t    }\n   270\t    \n   271\t    // Number\n   272\t    if (isdigit(c)) {\n   273\t        return scan_number();\n   274\t    }\n   275\t    \n   276\t    // String\n   277\t    if (c == '\"' || c == '\\'') {\n   278\t        return scan_string();\n   279\t    }\n   280\t    \n   281\t    // Comment\n   282\t    if (c == '/' && (peek_char() == '/' || peek_char() == '*')) {\n   283\t        return scan_comment();\n   284\t    }\n   285\t    \n   286\t    // Operator\n   287\t    if (strchr(\"+-*/%=<>!&|^~?:\", c) != NULL) {\n   288\t        return scan_operator();\n   289\t    }\n   290\t    \n   291\t    // Punctuation\n   292\t    if (strchr(\"(){}[];,.\", c) != NULL) {\n   293\t        char punct[2] = {advance_char(), '\\0'};\n   294\t        return create_token(TOKEN_PUNCTUATION, punct, 1);\n   295\t    }\n   296\t    \n   297\t    // Unknown character\n   298\t    char unknown[2] = {advance_char(), '\\0'};\n   299\t    return create_token(TOKEN_ERROR, unknown, 1);\n   300\t}\n   301\t\n   302\ttoken_t tokenizer_peek_token(void) {\n   303\t    if (!lookahead_valid) {\n   304\t        lookahead_token = tokenizer_next_token();\n   305\t        lookahead_valid = 1;\n   306\t    }\n   307\t    return lookahead_token;\n   308\t}\n   309\t\n   310\tvoid tokenizer_reset(void) {\n   311\t    current_position = 0;\n   312\t    current_line = 1;\n   313\t    current_column = 1;\n   314\t    lookahead_valid = 0;\n   315\t    // Note: We don't reset total statistics\n   316\t}\n   317\t\n   318\tint tokenizer_load_text(const char *text) {\n   319\t    if (!text) {\n   320\t        return -1;\n   321\t    }\n   322\t    \n   323\t    size_t length = strlen(text);\n   324\t    if (length >= MAX_BUFFER_SIZE) {\n   325\t        fprintf(stderr, \"Error: Input text too large\\n\");\n   326\t        return -1;\n   327\t    }\n   328\t    \n   329\t    strncpy(input_buffer, text, MAX_BUFFER_SIZE - 1);\n   330\t    input_buffer[MAX_BUFFER_SIZE - 1] = '\\0';\n   331\t    buffer_length = length;\n   332\t    \n   333\t    tokenizer_reset();\n   334\t    \n   335\t    return 0;\n   336\t}\n   337\t\n   338\tvoid tokenizer_get_stats(size_t *lines, size_t *tokens, size_t *chars) {\n   339\t    if (lines) *lines = total_lines_processed;\n   340\t    if (tokens) *tokens = total_tokens_processed;\n   341\t    if (chars) *chars = total_chars_processed;\n   342\t}\n   343\t\n   344\t// Function that returns function pointers\n   345\ttokenizer_ops_t get_tokenizer_ops(void) {\n   346\t    tokenizer_ops_t ops;\n   347\t    ops.next_token = tokenizer_next_token;\n   348\t    ops.peek_token = tokenizer_peek_token;\n   349\t    ops.reset = tokenizer_reset;\n   350\t    ops.load_text = tokenizer_load_text;\n   351\t    ops.get_stats = tokenizer_get_stats;\n   352\t    return ops;\n   353\t}\n","exit_code":0,"status":"completed"}}
