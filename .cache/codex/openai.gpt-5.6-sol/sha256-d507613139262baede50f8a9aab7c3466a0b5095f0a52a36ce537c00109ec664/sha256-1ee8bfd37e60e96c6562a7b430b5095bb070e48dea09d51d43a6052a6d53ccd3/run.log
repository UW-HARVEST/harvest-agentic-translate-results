              if !s.is_null() && tree_len <= 9 {\n   215\t                    let mut j = (rev16(code) >> (16 - tree_len)) as c_int;\n   216\t                    while j < (1 << 9) {\n   217\t                        (*s).lookup[j as usize] = ((tree_len << 9) | i) as u16;\n   218\t                        j += 1 << tree_len;\n   219\t                    }\n   220\t                }\n   221\t            }\n   222\t        }\n   223\t        first[15]\n   224\t    }\n   225\t}\n   226\t\n   227\tunsafe fn stored(s: *mut CpState) -> c_int {\n   228\t    unsafe {\n   229\t        read_bits(s, (*s).count & 7);\n   230\t        let len = read_bits(s, 16) as u16;\n   231\t        let nlen = read_bits(s, 16) as u16;\n   232\t        if len != !nlen {\n   233\t            set_error(\n   234\t                b\"Failed to find LEN and NLEN as complements within stored (uncompressed) stream.\\0\",\n   235\t            );\n   236\t            return 0;\n   237\t        }\n   238\t        if (*s).bits_left / 8 > len as c_int {\n   239\t            set_error(b\"Stored block extends beyond end of input stream.\\0\");\n   240\t            return 0;\n   241\t        }\n   242\t        let p = state_ptr(s);\n   243\t        memcpy((*s).out.cast(), p.cast(), len as usize);\n   244\t        (*s).out = (*s).out.add(len as usize);\n   245\t        1\n   246\t    }\n   247\t}\n   248\t\n   249\tunsafe fn fixed(s: *mut CpState) -> c_int {\n   250\t    unsafe {\n   251\t        let lens = ptr::addr_of!(cp_fixed_table).cast::<u8>();\n   252\t        (*s).nlit = build_tree(s, ptr::addr_of_mut!((*s).lit).cast::<u32>(), lens, 288) as u32;\n   253\t        (*s).ndst = build_tree(\n   254\t            ptr::null_mut(),\n   255\t            ptr::addr_of_mut!((*s).dst).cast::<u32>(),\n   256\t            lens.add(288),\n   257\t            32,\n   258\t        ) as u32;\n   259\t        1\n   260\t    }\n   261\t}\n   262\t\n   263\tunsafe fn decode(s: *mut CpState, tree: *mut u32, mut hi: c_int) -> c_