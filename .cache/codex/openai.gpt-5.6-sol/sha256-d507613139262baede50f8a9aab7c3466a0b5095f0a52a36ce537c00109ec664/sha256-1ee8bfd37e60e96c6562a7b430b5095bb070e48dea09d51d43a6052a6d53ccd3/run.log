 489\t            }\n   490\t        }\n   491\t        free(s.cast());\n   492\t        1\n   493\t    }\n   494\t}\n   495\t\n   496\tfn paeth(a: u8, b: u8, c: u8) -> u8 {\n   497\t    let p = a as c_int + b as c_int - c as c_int;\n   498\t    let pa = (p - a as c_int).abs();\n   499\t    let pb = (p - b as c_int).abs();\n   500\t    let pc = (p - c as c_int).abs();\n   501\t    if pa <= pb && pa <= pc {\n   502\t        a\n   503\t    } else if pb <= pc {\n   504\t        b\n   505\t    } else {\n   506\t        c\n   507\t    }\n   508\t}\n   509\t\n   510\t#[repr(C)]\n   511\tstruct RawPng {\n   512\t    p: *const u8,\n   513\t    end: *const u8,\n   514\t}\n   515\t\n   516\tunsafe fn make32(s: *const u8) -> u32 {\n   517\t    unsafe {\n   518\t        ((*s as u32) << 24)\n   519\t            | ((*s.add(1) as u32) << 16)\n   520\t            | ((*s.add(2) as u32) << 8)\n   521\t            | *s.add(3) as u32\n   522\t    }\n   523\t}\n   524\t\n   525\tunsafe fn chunk(png: *mut RawPng, chunk_name: *const u8, min_len: u32) -> *const u8 {\n   526\t    unsafe {\n   527\t        let len = make32((*png).p);\n   528\t        let start = (*png).p;\n   529\t        if memcmp(start.add(4).cast(), chunk_name.cast(), 4) == 0 && len >= min_len {\n   530\t            let offset = len.wrapping_add(12) as i32;\n   531\t            let next = (*png).p.wrapping_offset(offset as isize);\n   532\t            if next as usize <= (*png).end as usize {\n   533\t                (*png).p = next;\n   534\t                return start.add(8);\n   535\t            }\n   536\t        }\n   537\t        ptr::null()\n   538\t    }\n   539\t}\n   540\t\n   541\tunsafe fn find(png: *mut RawPng, chunk_name: *const u8, min_len: u32) -> *const u8 {\n   542\t    unsafe {\n   543\t        while ((*png).p as usize) < ((*png).end as usize) {\n   544\t            let len = make32((*png).p);\n   545\t            let start = (*png).p;\n   546\t            (*png).p = (*png).p.wrapping_add(len.wrapping_