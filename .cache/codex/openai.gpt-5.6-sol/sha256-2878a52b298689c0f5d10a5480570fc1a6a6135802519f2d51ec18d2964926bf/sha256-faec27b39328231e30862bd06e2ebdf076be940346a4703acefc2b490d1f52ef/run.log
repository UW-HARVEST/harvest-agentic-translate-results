{"type":"item.completed","item":{"id":"item_55","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/main.rs | sed -n '1,150p'; nl -ba tests/differential.rs | sed -n '1,130p'; wc -l src/main.rs tests/differential.rs ERRORS.md; grep -c 'Stdio::piped' tests/differential.rs\"","aggregated_output":"     1\tuse std::env;\n     2\tuse std::ffi::{c_char, c_int, c_ulong, CString, OsString};\n     3\tuse std::io::{self, Write};\n     4\tuse std::os::unix::ffi::OsStrExt;\n     5\tuse std::ptr;\n     6\tuse std::thread;\n     7\t\n     8\tconst ARRAY_SIZE: usize = 256 * 1024;\n     9\tconst ITERATIONS: usize = 2000;\n    10\t\n    11\textern \"C\" {\n    12\t    fn __errno_location() -> *mut c_int;\n    13\t    fn strtoul(nptr: *const c_char, endptr: *mut *mut c_char, base: c_int) -> c_ulong;\n    14\t    fn srand(seed: u32);\n    15\t    fn rand() -> c_int;\n    16\t}\n    17\t\n    18\tfn write_usage(program: &OsString) {\n    19\t    let mut stderr = io::stderr().lock();\n    20\t    let _ = stderr.write_all(b\"Usage: \");\n    21\t    let _ = stderr.write_all(program.as_os_str().as_bytes());\n    22\t    let _ = stderr.write_all(b\" <seed>\\n\");\n    23\t}\n    24\t\n    25\tfn write_invalid_seed(argument: &OsString) {\n    26\t    let mut stderr = io::stderr().lock();\n    27\t    let _ = stderr.write_all(b\"Invalid seed: '\");\n    28\t    let _ = stderr.write_all(argument.as_os_str().as_bytes());\n    29\t    let _ = stderr.write_all(b\"'\\n\");\n    30\t}\n    31\t\n    32\tfn parse_seed(argument: &OsString) -> Option<u32> {\n    33\t    let argument = CString::new(argument.as_os_str().as_bytes())\n    34\t        .expect(\"process arguments cannot contain NUL bytes\");\n    35\t    let mut endptr = ptr::null_mut();\n    36\t\n    37\t    let temp_seed = unsafe {\n    38\t        *__errno_location() = 0;\n    39\t        strtoul(argument.as_ptr(), &mut endptr, 10)\n    40\t    };\n    41\t\n    42\t    let has_trailing_characters = unsafe { *endptr != 0 };\n    43\t    if has_trailing_characters {\n    44\t        return None;\n    45\t    }\n    46\t\n    47\t    let errno_is_set = unsafe { *__errno_location() != 0 };\n    48\t    if errno_is_set {\n    49\t        return None;\n    50\t    }\n    51\t\n    52\t    if temp_seed > u32::MAX as c_ulong {\n    53\t        return None;\n    54\t    }\n    55\t\n    56\t    Some(temp_seed as u32)\n    57\t}\n    58\t\n    59\tfn perform_expensive_operations(array: &mut [i32]) {\n    60\t    for value in array {\n    61\t        let mut x = *value;\n    62\t        for _ in 0..100 {\n    63\t            x = x.wrapping_mul(3).wrapping_add(7);\n    64\t            x ^= x >> 3;\n    65\t            x = x.wrapping_sub(x.wrapping_shl(1));\n    66\t            x = x / 2 + x % 7;\n    67\t        }\n    68\t        *value = x;\n    69\t    }\n    70\t}\n    71\t\n    72\tfn perform_all_iterations(array: &mut [i32]) {\n    73\t    let thread_count = thread::available_parallelism()\n    74\t        .map(usize::from)\n    75\t        .unwrap_or(1)\n    76\t        .min(array.len());\n    77\t    let chunk_size = array.len().div_ceil(thread_count);\n    78\t\n    79\t    thread::scope(|scope| {\n    80\t        for chunk in array.chunks_mut(chunk_size) {\n    81\t            scope.spawn(move || {\n    82\t                for _ in 0..ITERATIONS {\n    83\t                    perform_expensive_operations(chunk);\n    84\t                }\n    85\t            });\n    86\t        }\n    87\t    });\n    88\t}\n    89\t\n    90\tfn main() {\n    91\t    let arguments: Vec<OsString> = env::args_os().collect();\n    92\t    if arguments.len() != 2 {\n    93\t        write_usage(&arguments[0]);\n    94\t        std::process::exit(1);\n    95\t    }\n    96\t\n    97\t    let Some(seed) = parse_seed(&arguments[1]) else {\n    98\t        write_invalid_seed(&arguments[1]);\n    99\t        std::process::exit(1);\n   100\t    };\n   101\t\n   102\t    unsafe {\n   103\t        srand(seed);\n   104\t    }\n   105\t\n   106\t    let mut array = vec![0_i32; ARRAY_SIZE];\n   107\t    for value in &mut array {\n   108\t        *value = unsafe { rand() };\n   109\t    }\n   110\t\n   111\t    perform_all_iterations(&mut array);\n   112\t\n   113\t    let mut xor_result = 0_i32;\n   114\t    for value in array {\n   115\t        xor_result ^= value;\n   116\t    }\n   117\t\n   118\t    let mut stdout = io::stdout().lock();\n   119\t    let _ = writeln!(stdout, \"{xor_result}\");\n   120\t}\n     1\tuse std::os::unix::process::CommandExt;\n     2\tuse std::path::{Path, PathBuf};\n     3\tuse std::process::{Child, Command, Stdio};\n     4\t\n     5\tconst COMMON_ARGV0: &str = \"driver\";\n     6\t\n     7\tfn c_binary() -> PathBuf {\n     8\t    Path::new(env!(\"CARGO_MANIFEST_DIR\"))\n     9\t        .join(\"../c_src/build/driver\")\n    10\t}\n    11\t\n    12\tfn rust_binary() -> &'static Path {\n    13\t    Path::new(env!(\"CARGO_BIN_EXE_driver\"))\n    14\t}\n    15\t\n    16\tfn spawn(binary: &Path, arguments: &[&str]) -> Child {\n    17\t    let mut command = Command::new(binary);\n    18\t    command\n    19\t        .arg0(COMMON_ARGV0)\n    20\t        .args(arguments)\n    21\t        .stdout(Stdio::piped())\n    22\t        .stderr(Stdio::piped());\n    23\t    command\n    24\t        .spawn()\n    25\t        .unwrap_or_else(|error| panic!(\"failed to run {}: {error}\", binary.display()))\n    26\t}\n    27\t\n    28\tfn assert_matches_c(case_name: &str, arguments: &[&str]) {\n    29\t    let c_process = spawn(&c_binary(), arguments);\n    30\t    let rust_process = spawn(rust_binary(), arguments);\n    31\t    let expected = c_process\n    32\t        .wait_with_output()\n    33\t        .expect(\"failed to collect C output\");\n    34\t    let actual = rust_process\n    35\t        .wait_with_output()\n    36\t        .expect(\"failed to collect Rust output\");\n    37\t\n    38\t    assert_eq!(\n    39\t        actual.stdout, expected.stdout,\n  