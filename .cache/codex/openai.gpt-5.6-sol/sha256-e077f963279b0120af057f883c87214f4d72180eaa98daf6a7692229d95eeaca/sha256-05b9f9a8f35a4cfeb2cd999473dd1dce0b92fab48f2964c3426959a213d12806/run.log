{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes, struct\npaths = [\n    '/tmp/harvest-FCSVZJ-cbuild.D4nBIO/libharvest-work-FCSVZJ.so',\n    '/local/home/scheschb/.harvest/work/harvest-work-FCSVZJ/translation/target/release/libima_caf.so',\n]\nclass Info(ctypes.Structure):\n    _fields_ = [('blocks', ctypes.c_void_p), ('size', ctypes.c_ulonglong),\n                ('sample_rate', ctypes.c_double), ('frame_count', ctypes.c_ulonglong),\n                ('channel_count', ctypes.c_uint)]\nassert ctypes.sizeof(Info) == 40\nlibs = [ctypes.CDLL(path) for path in paths]\nfor lib in libs:\n    lib.ima_parse.argtypes = [ctypes.POINTER(Info), ctypes.c_void_p]\n    lib.ima_parse.restype = ctypes.c_int\n\ndef chunk(kind, body):\n    return kind + b'PAD\"'!'\"' + struct.pack('>q', len(body)) + body\n\ndef desc(rate_bytes, channels, fmt=b'ima4'):\n    return rate_bytes + fmt + struct.pack('>IIIII', 0, 34, 64, channels, 16)\n\ndef packet(frames):\n    return struct.pack('>qqii', 8, frames, 0, 0)\n\ndef data(seed, count=1):\n    return struct.pack('>I', 3) + b''.join(struct.pack('>H', seed+i) + bytes((seed+i+j)&255 for j in range(32)) for i in range(count))\n\ndef caf(parts, magic=b'caff', version=1):\n    return magic + struct.pack('>H', version) + b'\\\\0\\\\0' + b''.join(parts)\n\ndef compare(name, payload, expected):\n    source = ctypes.create_string_buffer(payload)\n    got = []\n    for lib in libs:\n        out = Info(); ctypes.memset(ctypes.byref(out), 0xA5, ctypes.sizeof(out))\n        rc = lib.ima_parse(ctypes.byref(out), source)\n        got.append((rc, ctypes.string_at(ctypes.byref(out), ctypes.sizeof(out))))\n    assert got[0] == got[1], name\n    assert got[0][0] == expected, name\n    if expected:\n        assert got[0][1] == b'\\\\xA5' * ctypes.sizeof(Info), name\n    print(name + ': match')\n\nbe_rate = struct.pack('>d', 48000.0)\nvalid_parts = [chunk(b'desc', desc(be_rate, 2)), chunk(b'pakt', packet(12345)), chunk(b'data', data(7, 2))]\ncompare('error -1', caf([], magic=b'nope'), -1)\ncompare('error -2', caf([], version=9), -2)\ncompare('error -3', caf([chunk(b'desc', desc(be_rate, 2, b'lpcm')), chunk(b'pakt', packet(1)), chunk(b'data', data(1))]), -3)\ncompare('success with unknown chunk', caf([valid_parts[0], chunk(b'junk', b'xyz'), valid_parts[1], valid_parts[2]]), 0)\ncompare('success reordered metadata', caf([valid_parts[1], valid_parts[0], valid_parts[2]]), 0)\nfor native in (1.0, 255.75, 4294967297.75, -0.5):\n    parts = [chunk(b'desc', desc(struct.pack('<d', native), 6)), chunk(b'pakt', packet(99)), chunk(b'data', data(2))]\n    compare('sample conversion ' + str(native), caf(parts), 0)\nprint('final differential suite passed')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
