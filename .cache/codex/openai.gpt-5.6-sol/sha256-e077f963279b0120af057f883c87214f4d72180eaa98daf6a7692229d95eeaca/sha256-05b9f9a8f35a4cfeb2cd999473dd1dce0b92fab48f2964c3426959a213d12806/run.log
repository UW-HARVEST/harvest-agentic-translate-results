{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes\nimport struct\n\nC_SO = '/tmp/harvest-FCSVZJ-cbuild.D4nBIO/libharvest-work-FCSVZJ.so'\nRUST_SO = '/local/home/scheschb/.harvest/work/harvest-work-FCSVZJ/translation/target/release/libima_caf.so'\n\nclass ImaBlock(ctypes.Structure):\n    _fields_ = [('preamble', ctypes.c_ushort), ('data', ctypes.c_ubyte * 32)]\n\nclass ImaInfo(ctypes.Structure):\n    _fields_ = [\n        ('blocks', ctypes.POINTER(ImaBlock)),\n        ('size', ctypes.c_ulonglong),\n        ('sample_rate', ctypes.c_double),\n        ('frame_count', ctypes.c_ulonglong),\n        ('channel_count', ctypes.c_uint),\n    ]\n\nassert ctypes.sizeof(ImaBlock) == 34\nassert ctypes.sizeof(ImaInfo) == 40\nassert [getattr(ImaInfo, f).offset for f in ('blocks', 'size', 'sample_rate', 'frame_count', 'channel_count')] == [0, 8, 16, 24, 32]\n\nlibs = [ctypes.CDLL(C_SO), ctypes.CDLL(RUST_SO)]\nfor lib in libs:\n    lib.ima_parse.argtypes = [ctypes.POINTER(ImaInfo), ctypes.c_void_p]\n    lib.ima_parse.restype = ctypes.c_int\n\ndef chunk(kind, payload, pad=b'PAD\"'!'\"'):\n    return kind + pad + struct.pack('>q', len(payload)) + payload\n\ndef desc(sample_rate, channels, format_id=b'ima4'):\n    return struct.pack('>d', sample_rate) + format_id + struct.pack('>IIIII', 0, 34, 64, channels, 16)\n\ndef pakt(frames):\n    return struct.pack('>qqii', 17, frames, 0, 0)\n\ndef data_payload(seed, block_count=2):\n    blocks = bytearray(struct.pack('>I', 7))\n    for i in range(block_count):\n        blocks += struct.pack('>H', seed + i)\n        blocks += bytes(((seed + i + j) & 0xff) for j in range(32))\n    return bytes(blocks)\n\ndef caf(chunks, magic=b'caff', version=1):\n    return magic + struct.pack('>H', version) + b'\\\\x12\\\\x34' + b''.join(chunks)\n\ndef run_case(name, payload, expected):\n    buf = ctypes.create_string_buffer(payload)\n    observed = []\n    for lib in libs:\n        info = ImaInfo()\n        ctypes.memset(ctypes.byref(info), 0xA5, ctypes.sizeof(info))\n        rc = lib.ima_parse(ctypes.byref(info), ctypes.cast(buf, ctypes.c_void_p))\n        raw = ctypes.string_at(ctypes.byref(info), ctypes.sizeof(info))\n        observed.append((rc, raw, info))\n    assert observed[0][0] == observed[1][0] == expected, name\n    assert observed[0][1] == observed[1][1], name\n    if expected \"'!= 0:\n        assert observed[0][1] == b'\"'\\\\xA5' * ctypes.sizeof(ImaInfo), name\n    print(f'{name}: rc={expected}, info_bytes_identical=yes')\n    return observed[0][2], ctypes.addressof(buf)\n\nrun_case('bad magic', caf([], magic=b'nope'), -1)\nrun_case('bad version', caf([], version=2), -2)\nrun_case('bad format', caf([\n    chunk(b'desc', desc(44100.0, 2, b'lpcm')),\n    chunk(b'pakt', pakt(1234)),\n    chunk(b'data', data_payload(3)),\n]), -3)\n\nfirst_data = data_payload(9, 2)\nvalid_a = caf([\n    chunk(b'desc', desc(44100.0, 2)),\n    chunk(b'junk', b'abcde'),\n    chunk(b'pakt', pakt(123456789)),\n    chunk(b'data', first_data),\n])\ninfo_a, base_a = run_case('valid desc-unknown-pakt-data', valid_a, 0)\nassert info_a.size == len(first_data)\nassert info_a.sample_rate == 0.0\nassert info_a.frame_count == 123456789\nassert info_a.channel_count == 2\nassert ctypes.cast(info_a.blocks, ctypes.c_void_p).value == base_a + len(valid_a) - len(first_data) + 4\n\nsecond_data = data_payload(251, 1)\nvalid_b = caf([\n    chunk(b'pakt', pakt(0x1020304050607)),\n    chunk(b'desc', desc(192000.5, 6)),\n    chunk(b'data', second_data),\n])\ninfo_b, base_b = run_case('valid pakt-desc-data', valid_b, 0)\nassert info_b.size == len(second_data)\nassert info_b.sample_rate == 0.0\nassert info_b.frame_count == 0x1020304050607\nassert info_b.channel_count == 6\nassert ctypes.cast(info_b.blocks, ctypes.c_void_p).value == base_b + len(valid_b) - len(second_data) + 4\nprint('all differential assertions passed')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
