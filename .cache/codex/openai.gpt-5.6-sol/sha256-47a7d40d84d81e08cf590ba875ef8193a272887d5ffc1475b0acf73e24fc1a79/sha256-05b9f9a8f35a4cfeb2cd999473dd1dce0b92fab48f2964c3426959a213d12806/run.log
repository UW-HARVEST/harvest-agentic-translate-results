{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes\nimport os\nimport random\nimport zlib\nfrom pathlib import Path\n\nroot = Path.cwd().parent\npaths = [\n    root / \\\"c_reference_build/libharvest-work-PXlGkn.so\\\",\n    Path.cwd() / \\\"target/release/libpinflate.so\\\",\n]\nmode = os.RTLD_LOCAL | getattr(os, \\\"RTLD_DEEPBIND\\\", 0)\nlibs = [ctypes.CDLL(str(path), mode=mode) for path in paths]\nfor lib in libs:\n    lib.pinflate.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_void_p, ctypes.c_int]\n    lib.pinflate.restype = ctypes.c_int\n\ndef invoke(lib, compressed, out_size, offset):\n    in_buffer = ctypes.create_string_buffer(len(compressed) + offset + 4)\n    ctypes.memmove(ctypes.addressof(in_buffer) + offset, compressed, len(compressed))\n    output = ctypes.create_string_buffer(max(out_size, 1))\n    ctypes.memset(output, 0xA5, max(out_size, 1))\n    result = lib.pinflate(\n        ctypes.c_void_p(ctypes.addressof(in_buffer) + offset),\n        len(compressed),\n        output,\n        out_size,\n    )\n    reason_ptr = ctypes.c_void_p.in_dll(lib, \\\"cp_error_reason\\\").value\n    reason = ctypes.string_at(reason_ptr) if reason_ptr else None\n    return result, bytes(output.raw[:max(out_size, 1)]), reason\n\ndef raw_deflate(data, level=6, strategy=zlib.Z_DEFAULT_STRATEGY):\n    compressor = zlib.compressobj(level, zlib.DEFLATED, -15, 8, strategy)\n    return compressor.compress(data) + compressor.flush()\n\nrng = random.Random(0xC0DEC0DE)\ncases = []\nfixed_payloads = [b\\\"\\\", b\\\"a\\\", b\\\"hello world\\\" * 9, bytes(range(256)) * 3]\nfor payload in fixed_payloads:\n    cases.append((payload, raw_deflate(payload, 6, zlib.Z_FIXED), \\\"fixed\\\"))\nstored_payloads = [b\\\"\\\", b\\\"x\\\", bytes(range(251)), os.urandom(4093)]\nfor payload in stored_payloads:\n    cases.append((payload, raw_deflate(payload, 0), \\\"stored\\\"))\ndynamic_payloads = [\n    (b\\\"dynamic huffman content: \\\" + bytes(range(64))) * 100,\n    bytes((i * i + i * 17) & 0xFF for i in range(20000)),\n]\nfor payload in dynamic_payloads:\n    cases.append((payload, raw_deflate(payload, 9), \\\"dynamic\\\"))\nfor i in range(300):\n    size = rng.randrange(1, 12000)\n    kind = i % 4\n    if kind == 0:\n        payload = bytes(rng.randrange(8) + 65 for _ in range(size))\n    elif kind == 1:\n        seed = bytes(rng.randrange(256) for _ in range(rng.randrange(1, 100)))\n        payload = (seed * (size // len(seed) + 1))[:size]\n    else:\n        payload = bytes(rng.randrange(256) for _ in range(size))\n    level = [0, 1, 6, 9][kind]\n    strategy = zlib.Z_FIXED if i % 7 == 0 and level else zlib.Z_DEFAULT_STRATEGY\n    cases.append((payload, raw_deflate(payload, level, strategy), \\\"random\\\"))\n\ncomparisons = 0\nfor payload, compressed, label in cases:\n    for offset in range(4):\n        if len(compressed) <= offset:\n            continue\n        c_result = invoke(libs[0], compressed, len(payload) + 16, offset)\n        r_result = invoke(libs[1], compressed, len(payload) + 16, offset)\n        assert c_result == r_result, (label, len(payload), offset, c_result, r_result)\n        assert c_result[0] == 1, (label, len(payload), offset, c_result[2])\n        assert c_result[1][:len(payload)] == payload\n        comparisons += 1\n\n# Error behavior with initialized output bytes and fresh library-global reason values.\nerror_cases = [\n    (b\\\"\\\\x07\\\", 16, \\\"unknown block\\\"),\n    (b\\\"\\\\x01\\\\x01\\\\x00\\\\x01\\\\x00Z\\\", 16, \\\"bad stored complement\\\"),\n]\nlarge = b\\\"abcde\\\" * 100\nfixed = raw_deflate(large, 6, zlib.Z_FIXED)\nerror_cases.append((fixed, 4, \\\"short symbol output\\\"))\nerror_cases.append((fixed, 7, \\\"short string output\\\"))\nfor compressed, out_size, label in error_cases:\n    c_result = invoke(libs[0], compressed, out_size, 0)\n    r_result = invoke(libs[1], compressed, out_size, 0)\n    assert c_result