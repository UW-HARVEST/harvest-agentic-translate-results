\n   103\t    param1: c_int,\n   104\t    param2: c_int,\n   105\t    param3: c_int,\n   106\t    param4: c_int,\n   107\t) -> c_int {\n   108\t    let blocks = [\n   109\t        DataBlock {\n   110\t            id: 1,\n   111\t            name: c_name(b\"Block_Alpha\\0\"),\n   112\t            flags: 0b10101010,\n   113\t        },\n   114\t        DataBlock {\n   115\t            id: 2,\n   116\t            name: c_name(b\"Block_Beta\\0\"),\n   117\t            flags: 0b11001100,\n   118\t        },\n   119\t        DataBlock {\n   120\t            id: 3,\n   121\t            name: c_name(b\"Block_Gamma\\0\"),\n   122\t            flags: 0b11110000,\n   123\t        },\n   124\t    ];\n   125\t\n   126\t    let mut result: c_int = 0;\n   127\t    for current in &blocks {\n   128\t        let mut temp_name = [0 as c_char; 32];\n   129\t        // SAFETY: Both arrays are NUL-terminated and have the same capacity.\n   130\t        unsafe {\n   131\t            strcpy(temp_name.as_mut_ptr(), current.name.as_ptr());\n   132\t        }\n   133\t\n   134\t        let mut flag_contribution: c_int = 0;\n   135\t        if current.flags & 0b00001111 != 0 {\n   136\t            flag_contribution = flag_contribution.wrapping_add(param1);\n   137\t        }\n   138\t        if current.flags & 0b11110000 != 0 {\n   139\t            flag_contribution = flag_contribution.wrapping_add(param2);\n   140\t        }\n   141\t        if current.flags & 0b10101010 != 0 {\n   142\t            flag_contribution = flag_contribution.wrapping_add(param3);\n   143\t        }\n   144\t        if current.flags & 0b01010101 != 0 {\n   145\t            flag_contribution = flag_contribution.wrapping_add(param4);\n   146\t        }\n   147\t\n   148\t        result = result.wrapping_add(flag_contribution.wrapping_mul(current.id));\n   149\t    }\n   150\t\n   151\t    let block_size = (param1 % 10).wrapping_add(5) as usize;\n   152\t    // SAFETY: allocate_block has no additional caller requirements.\n   153\t    let mem1 = unsafe { allocate_block(block_size, param1) };\n   154\t    let mem2 = unsafe { allocate_block(block_size, param2) };\n   155\t\n   156\t    if mem1.is_null() || mem2.is_null() {\n   157\t        // SAFETY: free_block accepts null.\n   158\t        unsafe {\n   159\t            free_block(mem1);\n   160\t            free_block(mem2);\n   161\t        }\n   162\t        return -1;\n   163\t    }\n   164\t\n   165\t    // SAFETY: Both allocations were checked above.\n   166\t    let hash = unsafe { compute_hash(mem1, mem2) };\n   167\t    result = result.wrapping_add(hash);\n   168\t\n   169\t    let mut sum1: c_int = 0;\n   170\t    let mut sum2: c_int = 0;\n   171\t    // SAFETY: allocate_block initialized each data array to its recorded size.\n   172\t    unsafe {\n   173\t        for i in 0..(*mem1).size {\n   174\t            sum1 = sum1.wrapping_add(*(*mem1).data.add(i));\n   175\t        }\n   176\t        for i in 0..(*mem2).size {\n   177\t            sum2 = sum2.wrapping_add(*(*mem2).data.add(i));\n   178\t        }\n   179\t    }\n   180\t    result = result.wrapping_add(sum1.wrapping_sub(sum2) / 10);\n   181\t\n   182\t    let mut special = DataBlock {\n   183\t        id: 99,\n   184\t        name: c_name(b\"Special\\0\"),\n   185\t        flags: 0b11111111,\n   186\t    };\n   187\t    // SAFETY: \"Modified\" and its terminator fit in special.name.\n   188\t    unsafe {\n   189\t        strcpy(special.name.as_mut_ptr(), c\"Modified\".as_ptr());\n   190\t    }\n   191\t\n   192\t    // SAFETY: Both MemoryBlock pointers are valid until the final frees.\n   193\t    unsafe {\n   194\t        if (*mem1).data != (*mem2).data {\n   195\t            result = result.wrapping_add(special.id);\n   196\t        }\n   197\t\n   198\t        if (*mem1).data.addr() > 0 && (*mem2).data.addr() > 0 {\n   199\t            result = result.wrapping_add(c_int::from(special.flags));\n   200\t        }\n   201\t\n   202\t        free_block(mem1);\n 