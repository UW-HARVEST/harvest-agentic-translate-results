r\n    56\t    }\r\n    57\t\r\n    58\t    mb->size = count;\r\n    59\t\r\n    60\t    for (size_t i = 0; i < count; i++) {\r\n    61\t        mb->data[i] = init_value + i;\r\n    62\t    }\r\n    63\t\r\n    64\t    return mb;\r\n    65\t}\r\n    66\t\r\n    67\tvoid free_block(MemoryBlock *mb) {\r\n    68\t    if (mb) {\r\n    69\t        if (mb->data) free(mb->data);\r\n    70\t        free(mb);\r\n    71\t    }\r\n    72\t}\r\n    73\t\r\n    74\tint compute_hash(MemoryBlock *mb1, MemoryBlock *mb2) {\r\n    75\t    int hash = 0;\r\n    76\t\r\n    77\t    if (mb1->data < mb2->data) {\r\n    78\t        hash += 100;\r\n    79\t    } else if (mb1->data > mb2->data) {\r\n    80\t        hash += 200;\r\n    81\t    }\r\n    82\t\r\n    83\t    if (mb1 < mb2) {\r\n    84\t        hash += 10;\r\n    85\t    } else if (mb1 > mb2) {\r\n    86\t        hash += 20;\r\n    87\t    }\r\n    88\t\r\n    89\t    return hash;\r\n    90\t}\r\n    91\t\r\n    92\tint betagamma(int param1, int param2, int param3, int param4) {\r\n    93\t    int result = 0;\r\n    94\t\r\n    95\t    DataBlock blocks[] = {\r\n    96\t        {1, \"Block_Alpha\", 0b10101010},\r\n    97\t        {2, \"Block_Beta\", 0b11001100},\r\n    98\t        {3, \"Block_Gamma\", 0b11110000}\r\n    99\t    };\r\n   100\t\r\n   101\t    int num_blocks = sizeof(blocks) / sizeof(blocks[0]);\r\n   102\t\r\n   103\t    for (int i = 0; i < num_blocks; i++) {\r\n   104\t        DataBlock *current = &blocks[i];\r\n   105\t\r\n   106\t        char temp_name[32];\r\n   107\t        strcpy(temp_name, current->name);\r\n   108\t\r\n   109\t        int flag_contribution = 0;\r\n   110\t        if (current->flags & 0b00001111) {\r\n   111\t            flag_contribution += param1;\r\n   112\t        }\r\n   113\t        if (current->flags & 0b11110000) {\r\n   114\t            flag_contribution += param2;\r\n   115\t        }\r\n   116\t        if (current->flags & 0b10101010) {\r\n   117\t            flag_contribution += param3;\r\n   118\t        }\r\n   119\t        if (current->flags & 0b01010101) {\r\n   120\t            flag_contribution += param4;\r\n   121\t        }\r\n   122\t\r\n   123\t        result += flag_contribution * current->id;\r\n   124\t    }\r\n   125\t\r\n   126\t    size_t block_size = (param1 % 10) + 5;\r\n   127\t    MemoryBlock *mem1 = allocate_block(block_size, param1);\r\n   128\t    MemoryBlock *mem2 = allocate_block(block_size, param2);\r\n   129\t\r\n   130\t    if (!mem1 || !mem2) {\r\n   131\t        free_block(mem1);\r\n   132\t        free_block(mem2);\r\n   133\t        return -1;\r\n   134\t    }\r\n   135\t\r\n   136\t    int hash = compute_hash(mem1, mem2);\r\n   137\t    result += hash;\r\n   138\t\r\n   139\t    int sum1 = 0, sum2 = 0;\r\n   140\t    for (size_t i = 0; i < mem1->size; i++) {\r\n   141\t        sum1 += mem1->data[i];\r\n   142\t    }\r\n   143\t    for (size_t i = 0; i < mem2->size; i++) {\r\n   144\t        sum2 += mem2->data[i];\r\n   145\t    }\r\n   146\t\r\n   147\t    result += (sum1 - sum2) / 10;\r\n   148\t\r\n   149\t    DataBlock special = {99, \"Special\", 0b11111111};\r\n   150\t    strcpy(special.name, \"Modified\");\r\n   151\t\r\n   152\t    if (mem1->data != mem2->data) {\r\n   153\t        result += special.id;\r\n   154\t    }\r\n   155\t\r\n   156\t    if (mem1->data > NULL && mem2->data > NULL) {\r\n   157\t        result += special.flags;\r\n   158\t    }\r\n   159\t\r\n   160\t    free_block(mem1);\r\n   161\t    free_block(mem2);\r\n   162\t\r\n   163\t    return result;\r\n   164\t}\r\n","exit_code":0,"status":"completed"}}
