{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/lib.rs'","aggregated_output":"     1\tuse std::ffi::{c_char, c_int, c_void};\n     2\tuse std::mem::{MaybeUninit, size_of};\n     3\tuse std::ptr::{addr_of_mut, null_mut};\n     4\t\n     5\t#[repr(C)]\n     6\tpub struct DataBlock {\n     7\t    pub id: c_int,\n     8\t    pub name: [c_char; 32],\n     9\t    pub flags: u8,\n    10\t}\n    11\t\n    12\t#[repr(C)]\n    13\tpub struct MemoryBlock {\n    14\t    pub data: *mut c_int,\n    15\t    pub size: usize,\n    16\t}\n    17\t\n    18\tunsafe extern \"C\" {\n    19\t    fn malloc(size: usize) -> *mut c_void;\n    20\t    fn calloc(count: usize, size: usize) -> *mut c_void;\n    21\t    fn free(ptr: *mut c_void);\n    22\t    fn strcpy(dest: *mut c_char, src: *const c_char) -> *mut c_char;\n    23\t}\n    24\t\n    25\t#[unsafe(no_mangle)]\n    26\tpub unsafe extern \"C\" fn create_block(id: c_int, name: *const c_char, flags: u8) -> DataBlock {\n    27\t    let mut block = MaybeUninit::<DataBlock>::uninit();\n    28\t    let block_ptr = block.as_mut_ptr();\n    29\t\n    30\t    // SAFETY: This intentionally has the same caller requirements as the C function.\n    31\t    unsafe {\n    32\t        addr_of_mut!((*block_ptr).id).write(id);\n    33\t        strcpy(addr_of_mut!((*block_ptr).name).cast::<c_char>(), name);\n    34\t        addr_of_mut!((*block_ptr).flags).write(flags);\n    35\t        block.assume_init()\n    36\t    }\n    37\t}\n    38\t\n    39\t#[unsafe(no_mangle)]\n    40\tpub unsafe extern \"C\" fn allocate_block(count: usize, init_value: c_int) -> *mut MemoryBlock {\n    41\t    // SAFETY: The returned allocations are checked before they are dereferenced.\n    42\t    let block = unsafe { malloc(size_of::<MemoryBlock>()) }.cast::<MemoryBlock>();\n    43\t    if block.is_null() {\n    44\t        return null_mut();\n    45\t    }\n    46\t\n    47\t    // SAFETY: block points to enough