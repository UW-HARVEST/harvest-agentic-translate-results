tive {\n    48\t            negative_limit\n    49\t        } else {\n    50\t            i64::MAX as u128\n    51\t        };\n    52\t        let (magnitude, overflow) = parse_magnitude(digits, limit);\n    53\t\n    54\t        let value = if overflow {\n    55\t            if negative {\n    56\t                i64::MIN\n    57\t            } else {\n    58\t                i64::MAX\n    59\t            }\n    60\t        } else if negative {\n    61\t            if magnitude == negative_limit {\n    62\t                i64::MIN\n    63\t            } else {\n    64\t                -(magnitude as i64)\n    65\t            }\n    66\t        } else {\n    67\t            magnitude as i64\n    68\t        };\n    69\t        Some(value as i32)\n    70\t    }\n    71\t\n    72\t    fn scan_usize(&mut self) -> Option<usize> {\n    73\t        let (negative, digits) = self.decimal_parts()?;\n    74\t        let (magnitude, overflow) = parse_magnitude(digits, usize::MAX as u128);\n    75\t        if overflow {\n    76\t            Some(usize::MAX)\n    77\t        } else {\n    78\t            let value = magnitude as usize;\n    79\t            Some(if negative {\n    80\t                value.wrapping_neg()\n    81\t            } else {\n    82\t                value\n    83\t            })\n    84\t        }\n    85\t    }\n    86\t\n    87\t    fn scan_u32(&mut self) -> Option<u32> {\n    88\t        self.scan_usize().map(|value| value as u32)\n    89\t    }\n    90\t}\n    91\t\n    92\tfn parse_magnitude(digits: &[u8], limit: u128) -> (u128, bool) {\n    93\t    let mut value = 0_u128;\n    94\t    let mut overflow = false;\n    95\t\n    96\t    for &digit in digits {\n    97\t        let digit = (digit - b'0') as u128;\n    98\t        if value > (limit - digit) / 10 {\n    99\t            overflow = true;\n   100\t            value = limit;\n   101\t        } else if !overflow {\n   102\t            value = value * 10 + digit;\n   103\t        }\n   104\t    }\n   105\t\n   106\t    (value, overflow)\n   107\t}\n   108\t\n   109\tfn c_string<'a>(memory: &'a [u8], start: usize) -> &'a [u8] {\n   110\t    let tail = memory.get(start..).unwrap_or_default();\n   111\t    let end = tail\n   112\t        .iter()\n   113\t        .position(|&byte| byte == 0)\n   114\t        .unwrap_or(tail.len());\n   115\t    &tail[..end]\n   116\t}\n   117\t\n   118\tfn c_equals(memory: &[u8], start: usize, expected: &[u8]) -> bool {\n   119\t    c_string(memory, start) == expected\n   120\t}\n   121\t\n   122\tfn prefix_equals(memory: &[u8], start: usize, expected: &[u8]) -> bool {\n   123\t    memory\n   124\t        .get(start..start.saturating_add(expected.len()))\n   125\t        .is_some_and(|candidate| candidate == expected)\n   126\t}\n   127\t\n   128\tfn validate_token(memory: &[u8], reference: &[u8]) -> i32 {\n   129\t    if c_equals(memory, 0, reference) {\n   130\t        return 1;\n   131\t    }\n   132\t    if c_equals(memory, 0, b\"VALID\") || c_equals(memory, 0, b\"OK\") {\n   133\t        return 1;\n   134\t    }\n   135\t    0\n   136\t}\n   137\t\n   138\tfn parse_command(memory: &[u8], input_len: usize) -> i32 {\n   139\t    const COMMANDS: [&[u8]; 5] = [b\"START\", b\"STOP\", b\"PAUSE\", b\"RESUME\", b\"RESET\"];\n   140\t\n   141\t    for (index, command) in COMMANDS.iter().enumerate() {\n   142\t        if input_len >= command.len()\n   143\t            && prefix_equals(memory, 0, command)\n   144\t            && matches!(memory.get(command.len()), Some(0 | b' '))\n   145\t        {\n   146\t            return index as i32;\n   147\t        }\n   148\t        if c_equals(memory, 0, command) {\n   149\t            return index as i32;\n   150\t        }\n   151\t    }\n   152\t\n   153\t    if c_equals(memory, 0, b\"ADMIN\") {\n   154\t        return 99;\n   155\t    }\n   156\t    -1\n   157\t}\n   158\t\n   159\tfn compare_prefix(memory: &[u8], reference: &[u8], exact_match: bool) -> i32 {\n   160\t    if exact_match {\n   161\t        if c_equals(memory, 0, reference) {\n   162\t            return 1;\n   163\t        }\n   164\t\n   165\t        const VARIATIONS: [&[u8]; 5] = [b\"_v1\", b\"_v2\", b\"_old\", b\"_new\", b\"_tmp\"];\n   166\t        for (index, variation) in VARIATIONS.iter().enumerate() {\n   167\t            let prefix_len = reference.len().min(63);\n   168\t            let mut expected = Vec::with_capacity(63);\n   169\t            expected.extend_from_slice(&reference[..prefix_len]);\n   170\t            let remaining = 63 - expected.len();\n   171\t            expected.extend_from_slice(&variation[..variation.len().min(remaining)]);\n   172\t            if c_equals(memory, 0, &expected) {\n   173\t                return 2 + index as i32;\n   174\t            }\n   175\t        }\n   176\t        0\n   177\t    } else if prefix_equals(memory, 0, reference) {\n   178\t        1\n   179\t    } else {\n   180\t        0\n   181\t    }\n   182\t}\n   183\t\n   184\tfn find_delimiter(memory: &[u8], input_len: usize, delimiter: u8) -> i32 {\n   185\t    if input_len == 0 {\n   186\t        return -1;\n   187\t    }\n   188\t\n   189\t    for (index, &byte) in memory[..input_len].iter().enumerate() {\n   190\t        if byte == delimiter {\n   191\t            return index as i32;\n   192\t        }\n   193\t        if byte == 0 {\n   194\t            break;\n   195\t        }\n   196\t    }\n   197\t\n   198\t    if delimiter == b'|' && c_equals(memory, 0, b\"NONE\") {\n   199\t        return -2;\n   200\t    }\n   201\t    if delimiter == b':' && c_equals(memory, 0, b\"EMPTY\") {\n   202\t        return -3;\n   203\t    }\n   204\t    -1\n   205\t}\n   206\t\n   207\tfn snprintf_pattern(prefix: &[u8], pattern: &[u8], suffix: &[u8]) -> Vec<u8> {\n   208\t    let mut result = Vec::with_capacity(63);\n   209\t    for &byte in prefix.iter().chain(pattern).chain(suffix).take(63) {\n   210\t        result.push(byte);\n   211\t    }\n   212\t    result\n   213\t}\n   214\t\n   215\tfn match_pattern(memory: &[u8], pattern: &[u8], case_sensitive: bool) -> i32 {\n   216\t    let text = c_string(memory, 0);\n   217\t\n   218\t    if case_sensitive {\n   219\t        if text == pattern {\n   220\t            return 1;\n   221\t        }\n   222\t\n   223\t        let wildcard_patterns = [\n   224\t            snprintf_pattern(b\"*\", pattern, b\"*\"),\n   225\t            snprintf_pattern(b\"\", pattern, b\"*\"),\n   226\t            snprintf_pattern(b\"*\", pattern, b\"\"),\n   227\t        ];\n   228\t        for (index, wildcard) in wildcard_patterns.iter().enumerate() {\n   229\t            if text == wildcard {\n   230\t                return 2 + index as i32;\n   231\t            }\n   232\t        }\n   233\t\n   234\t        if pattern.len() <= text.len() {\n   235\t            for index in 0..=text.len() - pattern.len() {\n   236\t                if text[index..].starts_with(pattern) {\n   237\t                    return 10_i32.wrapping_add(index as i32);\n   238\t                }\n   239\t            }\n   240\t        } else {\n   241\t            // The C size_t subtraction wraps here. Model reads through the\n   242\t            // adjacent reference buffer while remaining inside known storage.\n   243\t            for index in 0..memory.len() {\n   244\t                if memory[index..].starts_with(pattern) {\n   245\t                    return 10_i32.wrapping_add(index as i32);\n   246\t                }\n   247\t            }\n   248\t        }\n   249\t    } else {\n   250\t        if text == pattern {\n   251\t            return 1;\n   252\t        }\n   253\t\n   254\t        if text.len() != pattern.len() && text.starts_with(pattern) {\n   255\t            return 5;\n   256\t        }\n   257\t\n   258\t        if text.len() == pattern.len()\n   259\t            && text\n   260\t                .iter()\n   261\t                .zip(pattern)\n   262\t                .all(|(&left, &right)| ascii_lower(left) == ascii_lower(right))\n   263\t        {\n   264\t            return 6;\n   265\t        }\n   266\t    }\n   267\t\n   268\t    0\n   269\t}\n   270\t\n   271\tfn ascii_lower(byte: u8) -> u8 {\n   272\t    if byte.is_ascii_uppercase() {\n   273\t        byte + 32\n   274\t    } else {\n   275\t        byte\n   276\t    }\n   277\t}\n   278\t\n   279\tfn process_strings(\n   280\t    memory: &[u8],\n   281\t    input_len: usize,\n   282\t    ref_len: usize,\n   283\t    operation: i32,\n   284\t    flags: u32,\n   285\t) -> i32 {\n   286\t    let reference = c_string(memory, REFERENCE_OFFSET);\n   287\t\n   288\t    match operation {\n   289\t        0 => validate_token(memory, reference),\n   290\t        1 => parse_command(memory, input_len),\n   291\t        2 => compare_prefix(memory, reference, flags & 0x01 != 0),\n   292\t        3 => {\n   293\t            let delimiter = if ref_len > 0 {\n   294\t                memory[REFERENCE_OFFSET]\n   295\t            } else {\n   296\t                b':'\n   297\t            };\n   298\t            find_delimiter(memory, input_len, delimiter)\n   299\t        }\n   300\t        4 => match_pattern(memory, reference, flags & 0x02 != 0),\n   301\t        _ => -3,\n   302\t    }\n   303\t}\n   304\t\n   305\tfn fail(message: &str) -> ! {\n   306\t    let _ = io::stderr().write_all(message.as_bytes());\n   307\t    std::process::exit(1);\n   308\t}\n   309\t\n   310\tfn main() {\n   311\t    let mut scanner = Scanner::from_stdin();\n   312\t    let operation = scanner\n   313\t        .scan_i32()\n   314\t        .unwrap_or_else(|| fail(\"Error reading operation\\n\"));\n   315\t    let flags = scanner\n   316\t        .scan_u32()\n   317\t        .unwrap_or_else(|| fail(\"Error reading flags\\n\"));\n   318\t    let input_len = scanner\n   319\t        .scan_usize()\n   320\t        .unwrap_or_else(|| fail(\"Error reading input length\\n\"));\n   321\t\n   322\t    if input_len > MAX_BUFFER_SIZE {\n   323\t        fail(&format!(\n   324\t            \"Error: input length {input_len} exceeds maximum {MAX_BUFFER_SIZE}\\n\"\n   325\t        ));\n   326\t    }\n   327\t\n   328\t    let mut memory = [0_u8; MEMORY_SIZE];\n   329\t    for index in 0..input_len {\n   330\t        memory[index] = scanner\n   331\t            .scan_u32()\n   332\t            .unwrap_or_else(|| fail(&format!(\"Error reading input byte {index}\\n\")))\n   333\t            as u8;\n   334\t    }\n   335\t\n   336\t    let ref_len = scanner\n   337\t        .scan_usize()\n   338\t        .unwrap_or_else(|| fail(\"Error reading reference length\\n\"));\n   339\t    if ref_len > MAX_BUFFER_SIZE {\n   340\t        fail(&format!(\n   341\t            \"Error: reference length {ref_len} exceeds maximum {MAX_BUFFER_SIZE}\\n\"\n   342\t        ));\n   343\t    }\n   344\t\n   345\t    for index in 0..ref_len {\n   346\t        memory[REFERENCE_OFFSET + index] = scanner\n   347\t            .scan_u32()\n   348\t            .unwrap_or_else(|| fail(&format!(\"Error reading reference byte {index}\\n\")))\n   349\t            as u8;\n   350\t    }\n   351\t\n   352\t    let result = process_strings(&memory, input_len, ref_len, operation, flags);\n   353\t    let _ = writeln!(io::stdout(), \"{result}\");\n   354\t}\n\nCargo.toml:\n     1\t[package]\n     2\tname = \"driver\"\n     3\tversion = \"0.1.0\"\n     4\tedition = \"2021\"\n     5\t\n     6\t[[bin]]\n     7\tname = \"driver\"\n     8\tpath = \"src/main.rs\"\n     9\t\n    10\t[workspace]\n\nCargo.lock lines:\n7 Cargo.lock\n","exit_code":0,"status":"completed"}}
