und */\n   219\t}\n   220\t\n   221\t/**\n   222\t * Match pattern with optional case sensitivity\n   223\t * Multiple vulnerable strcmp calls\n   224\t */\n   225\tstatic int match_pattern(const char *text, const char *pattern, int case_sensitive) {\n   226\t    \n   227\t    if (case_sensitive) {\n   228\t        /* Case-sensitive exact match - VULNERABLE */\n   229\t        if (strcmp(text, pattern) == 0) {\n   230\t            return 1;\n   231\t        }\n   232\t        \n   233\t        /* Try with wildcards - construct patterns */\n   234\t        char wildcard_patterns[3][64];\n   235\t        snprintf(wildcard_patterns[0], 64, \"*%s*\", pattern);\n   236\t        snprintf(wildcard_patterns[1], 64, \"%s*\", pattern);\n   237\t        snprintf(wildcard_patterns[2], 64, \"*%s\", pattern);\n   238\t        \n   239\t        /* VULNERABLE: strcmp on unbounded text */\n   240\t        for (int i = 0; i < 3; i++) {\n   241\t            if (strcmp(text, wildcard_patterns[i]) == 0) {\n   242\t                return 2 + i;\n   243\t            }\n   244\t        }\n   245\t        \n   246\t        /* Check if text contains pattern - uses strncmp safely */\n   247\t        size_t text_len = strlen(text);\n   248\t        size_t pattern_len = strlen(pattern);\n   249\t        \n   250\t        for (size_t i = 0; i <= text_len - pattern_len; i++) {\n   251\t            if (strncmp(&text[i], pattern, pattern_len) == 0) {\n   252\t                return 10 + i;  /* Return position + offset */\n   253\t            }\n   254\t        }\n   255\t        \n   256\t    } else {\n   257\t        /* Case-insensitive - need to check both cases */\n   258\t        /* First try exact match - VULNERABLE */\n   259\t        if (strcmp(text, pattern) == 0) {\n   260\t            return 1;\n   261\t        }\n   262\t        \n   263\t        /* Manual case-insensitive comparison */\n   264\t        size_t pattern_len = strlen(pattern);\n   265\t        size_t text_len = strlen(text)