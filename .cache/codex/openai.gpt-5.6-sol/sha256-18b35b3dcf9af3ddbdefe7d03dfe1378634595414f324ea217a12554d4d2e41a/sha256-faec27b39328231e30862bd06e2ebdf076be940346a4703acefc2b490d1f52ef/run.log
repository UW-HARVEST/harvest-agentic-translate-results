THE SOFTWARE.\n    24\t */\n    25\t#include <string.h>\n    26\t#include <stddef.h>\n    27\t#include <stdint.h>\n    28\t#include <stdio.h>\n    29\t\n    30\t/* Forward declarations */\n    31\tstatic int validate_token(const char *token, const char *expected);\n    32\tstatic int parse_command(char *buffer, size_t buf_size, const char *cmd_list[], int list_size);\n    33\tstatic int compare_prefix(const char *str, const char *prefix, int exact_match);\n    34\tstatic int find_delimiter(const char *data, size_t len, char delim);\n    35\tstatic int match_pattern(const char *text, const char *pattern, int case_sensitive);\n    36\t\n    37\t/**\n    38\t * Main entrance function - performs various string comparison operations\n    39\t * \n    40\t * @param input Input string buffer\n    41\t * @param input_len Length of input buffer\n    42\t * @param reference Reference string for comparison\n    43\t * @param ref_len Length of reference buffer\n    44\t * @param operation Operation code:\n    45\t *                  0: validate token\n    46\t *                  1: parse command\n    47\t *                  2: compare prefix\n    48\t *                  3: find delimiter\n    49\t *                  4: match pattern\n    50\t * @param flags Operation flags (case sensitivity, exact match, etc)\n    51\t * @return Operation result (match count, position, or error code)\n    52\t */\n    53\tint process_strings(char *input, size_t input_len, \n    54\t                   const char *reference, size_t ref_len,\n    55\t                   int operation, uint32_t flags) {\n    56\t    \n    57\t    if (input == NULL) {\n    58\t        return -1;\n    59\t    }\n    60\t    \n    61\t    /* Different operations based on operation code */\n    62\t    switch (operation) {\n    63\t        case 0: {\n    64\t            /* Validate token - VULNERABLE if input not null-terminated */\n    65\t            if (reference == NULL) return -2;\n    66\t            return validate_token(input, reference);\n    67\t        }\n    68\t        \n    69\t        case 1: {\n    70\t            /* Parse command from list - checks against multiple strings */\n    71\t            const char *commands[] = {\"START\", \"STOP\", \"PAUSE\", \"RESUME\", \"RESET\"};\n    72\t            return parse_command(input, input_len, commands, 5);\n    73\t        }\n    74\t        \n    75\t        case 2: {\n    76\t            /* Compare prefix - can use strcmp or strncmp based on flags */\n    77\t            if (reference == NULL) return -2;\n    78\t            int exact = (flags & 0x01);\n    79\t            return compare_prefix(input, reference, exact);\n    80\t        }\n    81\t        \n    82\t        case 3: {\n    83\t            /* Find delimiter position */\n    84\t            char delim = (reference && ref_len > 0) ? reference[0] : ':';\n    85\t            return find_delimiter(input, input_len, delim);\n    86\t        }\n    87\t        \n    88\t        case 4: {\n    89\t            /* Match pattern - VULNERABLE in certain paths */\n    90\t            if (reference == NULL) return -2;\n    91\t            int case_sens = (flags & 0x02);\n    92\t            return match_pattern(input, reference, case_sens);\n    93\t        }\n    94\t        \n    95\t        default:\n    96\t            return -3;\n    97\t    }\n    98\t}\n    99\t\n   100\t/**\n   101\t * Validate token against expected value\n   102\t * VULNERABLE: Uses strcmp without ensuring null termination\n   103\t */\n   104\tstatic int validate_token(const char *token, const char *expected) {\n   105\t    /* Direct strcmp - will overflow if token not null-terminated */\n   106\t    if (strcmp(token, expected) == 0) {\n   107\t        return 1;  /* Valid */\n   108\t    }\n   109\t    \n   110\t    /* Also check some common variations */\n   111\t    if (strcmp(token, \"VALID\") == 0 || strcmp(token, \"OK\") == 0) {\n   112\t        return 1;\n   113\t    }\n   114\t    \n   115\t    return 0;  /* Invalid */\n   116\t}\n   117\t\n   118\t/**\n   119\t * Parse command from a list of valid commands\n   120\t * Mix of safe and unsafe comparisons\n   121\t */\n   122\tstatic int parse_command(char *buffer, size_t buf_size, \n   123\t                        const char *cmd_list[], int list_size) {\n   124\t    \n   125\t    /* Iterate through command list */\n   126\t    for (int i = 0; i < list_size; i++) {\n   127\t        /* Safe comparison using strncmp first */\n   128\t        size_t cmd_len = strlen(cmd_list[i]);\n   129\t        \n   130\t        if (buf_size >= cmd_len) {\n   131\t            if (strncmp(buffer, cmd_list[i], cmd_len) == 0) {\n   132\t                /* Check if exact match - VULNERABLE if buffer not null-terminated */\n   133\t                if (buffer[cmd_len] == '\\0' || buffer[cmd_len] == ' ') {\n   134\t                    return i;  /* Return command index */\n   135\t                }\n   136\t            }\n   137\t        }\n   138\t        \n   139\t        /* Fallback: direct strcmp - VULNERABLE */\n   140\t        if (strcmp(buffer, cmd_list[i]) == 0) {\n   141\t            return i;\n   142\t        }\n   143\t    }\n   144\t    \n   145\t    /* Check for special admin command - always vulnerable strcmp */\n   146\t    if (strcmp(buffer, \"ADMIN\") == 0) {\n   147\t        return 99;\n   148\t    }\n   149\t    \n   150\t    return -1;  /* No match */\n   151\t}\n   152\t\n   153\t/**\n   154\t * Compare prefix with optional exact matching\n   155\t * Safe when exact_match=0, vulnerable when exact_match=1\n   156\t */\n   157\tstatic int compare_prefix(const char *str, const char *prefix, int exact_match) {\n   158\t    size_t prefix_len = strlen(prefix);\n   159\t    \n   160\t    if (exact_match) {\n   161\t        /* Exact match required - VULNERABLE strcmp */\n   162\t        if (strcmp(str, prefix) == 0) {\n   163\t            return 1;\n   164\t        }\n   165\t        \n   166\t        /* Try