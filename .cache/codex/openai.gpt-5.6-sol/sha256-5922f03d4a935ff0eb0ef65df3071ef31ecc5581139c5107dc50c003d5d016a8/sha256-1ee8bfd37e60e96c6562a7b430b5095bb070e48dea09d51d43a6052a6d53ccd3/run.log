{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"printf '%s\\\\n' '--- Rust ---' && nl -ba src/lib.rs\"","aggregated_output":"--- Rust ---\n     1\tuse std::ffi::{c_char, c_int, c_long, c_uint, c_void};\n     2\t\n     3\tconst VERBOSE_MASK: c_uint = 1 << 0;\n     4\tconst DEBUG_MASK: c_uint = 1 << 1;\n     5\tconst OPTIMIZE_MASK: c_uint = 1 << 2;\n     6\tconst CACHE_ENABLED_MASK: c_uint = 1 << 3;\n     7\tconst LOG_LEVEL_MASK: c_uint = 0b111 << 4;\n     8\tconst RESERVED_MASK: c_uint = 1 << 7;\n     9\tconst BUFFER_SIZE: usize = 256;\n    10\t\n    11\t#[repr(C)]\n    12\t#[derive(Clone, Copy)]\n    13\tpub struct ConfigFlags {\n    14\t    bits: c_uint,\n    15\t}\n    16\t\n    17\timpl ConfigFlags {\n    18\t    fn field(self, mask: c_uint, shift: u32) -> c_uint {\n    19\t        (self.bits & mask) >> shift\n    20\t    }\n    21\t\n    22\t    fn set_field(&mut self, mask: c_uint, shift: u32, value: c_uint) {\n    23\t        self.bits = (self.bits & !mask) | ((value << shift) & mask);\n    24\t    }\n    25\t\n    26\t    fn verbose(self) -> bool {\n    27\t        self.field(VERBOSE_MASK, 0) != 0\n    28\t    }\n    29\t\n    30\t    fn debug(self) -> bool {\n    31\t        self.field(DEBUG_MASK, 1) != 0\n    32\t    }\n    33\t\n    34\t    fn optimize(self) -> bool {\n    35\t        self.field(OPTIMIZE_MASK, 2) != 0\n    36\t    }\n    37\t\n    38\t    fn cache_enabled(self) -> bool {\n    39\t        self.field(CACHE_ENABLED_MASK, 3) != 0\n    40\t    }\n    41\t\n    42\t    fn log_level(self) -> c_uint {\n    43\t        self.field(LOG_LEVEL_MASK, 4)\n    44\t    }\n    45\t}\n    46\t\n    47\t#[repr(C)]\n    48\t#[derive(Clone, Copy)]\n    49\tstruct ProcessState {\n    50\t    flags: ConfigFlags,\n    51\t    base_value: c_int,\n    52\t    multiplier: c_int,\n    53\t    operation: c_char,\n    54\t}\n    55\t\n    56\tunsafe extern \"C\" {\n    57\t    fn getenv(name: *const c_char) -> *mut c_char;\n    58\t    fn atoi(value: *const c_char) -> c_int;\n    59\t    fn strchr(value: *const c_char, character: c_int) -> *mut c_char;\n    60\t    fn printf(format: *const c_char, ...) -> c_int;\n    61\t    fn fprintf(stream: *mut c_void, format: *const c_char, ...) -> c_int;\n    62\t    fn snprintf(buffer: *mut c_char, size: usize, format: *const c_char, ...) -> c_int;\n    63\t\n    64\t    #[link_name = \"stderr\"]\n    65\t    static mut C_STDERR: *mut c_void;\n    66\t}\n    67\t\n    68\t#[unsafe(no_mangle)]\n    69\tpub unsafe extern \"C\" fn parse_env_numeric(env_name: *const c_char, default_val: c_int) -> c_int {\n    70\t    let env_value = unsafe { getenv(env_name) };\n    71\t\n    72\t    if env_value.is_null() {\n    73\t        return default_val;\n    74\t    }\n    75\t\n    76\t    let mut invalid_char = unsafe { strchr(env_value, c_int::from(b',')) };\n    77\t    if !invalid_char.is_null() {\n    78\t        unsafe {\n    79\t            fprintf(\n    80\t                C_STDERR,\n    81\t                c\"Warning: Invalid character in %s\\n\".as_ptr(),\n    82\t                env_name,\n    83\t            );\n    84\t        }\n    85\t        return default_val;\n    86\t    }\n    87\t\n    88\t    invalid_char = unsafe { strchr(env_value, c_int::from(b';')) };\n    89\t    if !invalid_char.is_null() {\n    90\t        unsafe {\n    91\t            fprintf(\n    92\t                C_STDERR,\n    93\t                c\"Warning: Semicolon found in %s\\n\".as_ptr(),\n    94\t                env_name,\n    95\t            );\n    96\t        }\n    97\t        return default_val;\n    98\t    }\n    99\t\n   100\t    unsafe { atoi(env_value) }\n   101\t}\n   102\t\n   103\t#[unsafe(no_mangle)]\n   104\tpub unsafe extern \"C\" fn init_config_from_env(flags: *mut ConfigFlags) {\n   105\t    let verbose_env = unsafe { getenv(c\"PROG_VERBOSE\".as_ptr()) };\n   106\t    let debug_env = unsafe { getenv(c\"PROG_DEBUG\".as_ptr()) };\n   107\t    let optimize_env = unsafe { getenv(c\"PROG_OPTIMIZE\".as_ptr()) };\n   108\t\n   109\t    let verbose =\n   110\t        !verbose_env.is_null() && !unsafe { strchr(verbose_env, c_int::from(b'1')) }.is_null();\n   111\t    let debug = !debug_env.is_null() && !unsafe { strchr(debug_env, c_int::from(b'1')) }.is_null();\n   112\t\n   113\t    unsafe {\n   114\t        (*flags).set_field(VERBOSE_MASK, 0, c_uint::from(verbose));\n   115\t        (*flags).set_field(DEBUG_MASK, 1, c_uint::from(debug));\n   116\t        (*flags).set_field(OPTIMIZE_MASK, 2, c_uint::from(!optimize_env.is_null()));\n   117\t        (*flags).set_field(CACHE_ENABLED_MASK, 3, 1);\n   118\t        (*flags).set_field(LOG_LEVEL_MASK, 4, 0o3);\n   119\t        (*flags).set_field(RESERVED_MASK, 7, 0);\n   120\t    }\n   121\t}\n   122\t\n   123\t#[unsafe(no_mangle)]\n   124\tpub unsafe extern \"C\" fn perform_operation(\n   125\t    val1: c_int,\n   126\t    val2: c_int,\n   127\t    flags: *mut ConfigFlags,\n   128\t) -> c_int {\n   129\t    let flags_value = unsafe { *flags };\n   130\t    let result = if flags_value.optimize() {\n   131\t        val1.wrapping_add(val2)\n   132\t    } else {\n   133\t        val1.wrapping_mul(flags_value.log_level() as c_int)\n   134\t            .wrapping_add(val2 / 2)\n   135\t    };\n   136\t\n   137\t    if flags_value.debug() {\n   138\t        let operation_mode: c_int = 0o755;\n   139\t        unsafe {\n   140\t            printf(\n   141\t                c\"Debug: operation_mode = %o (octal)\\n\".as_ptr(),\n   142\t                operation_mode,\n   143\t            );\n   144\t            printf(c\"Debug: result before adjustment = %d\\n\".as_ptr(), result);\n   145\t        }\n   146\t    }\n   147\t\n   148\t    result\n   149\t}\n   150\t\n   151\t#[unsafe(no_mangle)]\n   152\tpub unsafe extern \"C\" fn apply_bit_operations(value: c_int, flags: *mut ConfigFlags) -> c_int {\n   153\t    let flags_value = unsafe { *flags };\n   154\t    let mut adjusted = value;\n   155\t\n   156\t    if flags_value.verbose() {\n   157\t        adjusted = adjusted.wrapping_shl(1);\n   158\t    }\n   159\t\n   160\t    if flags_value.cache_enabled() {\n   161\t        adjusted |= 0x0f;\n   162\t    }\n   163\t\n   164\t    adjusted\n   165\t}\n   166\t\n   167\t#[unsafe(no_mangle)]\n   168\tpub extern \"C\" fn envy(param1: c_int, param2: c_int, param3: c_int, param4: c_int) -> c_int {\n   169\t    unsafe {\n   170\t        let mut state = ProcessState {\n   171\t            flags: ConfigFlags { bits: 0 },\n   172\t            base_value: 0,\n   173\t            multiplier: 0,\n   174\t            operation: 0,\n   175\t        };\n   176\t        init_config_from_env(&mut state.flags);\n   177\t\n   178\t        let base_offset = parse_env_numeric(c\"PROG_BASE_OFFSET\".as_ptr(), 0o100);\n   179\t        let multiplier = parse_env_numeric(c\"PROG_MULTIPLIER\".as_ptr(), 0o12);\n   180\t\n   181\t        if state.flags.verbose() {\n   182\t            printf(c\"Verbose mode enabled\\n\".as_ptr());\n   183\t            printf(c\"Base offset: %d (from octal 0100)\\n\".as_ptr(), base_offset);\n   184\t            printf(c\"Multiplier: %d (from octal 012)\\n\".as_ptr(), multiplier);\n   185\t        }\n   186\t\n   187\t        state.base_value = param1;\n   188\t        state.multiplier = multiplier;\n   189\t        state.operation = b'+' as c_char;\n   190\t\n   191\t        let state_backup = state;\n   192\t\n   193\t        if state.flags.debug() {\n   194\t            printf(c\"Debug: Created state backup using memcpy\\n\".as_ptr());\n   195\t            printf(\n   196\t                c\"Debug: Backup base_value = %d\\n\".as_ptr(),\n   197\t                state_backup.base_value,\n   198\t            );\n   199\t        }\n   200\t\n   201\t        let mut result = perform_operation(param1, param2, &mut state.flags);\n   202\t\n   203\t        if param3 != 0 {\n   204\t            result = result.wrapping_add(param3.wrapping_mul(state.multiplier));\n   205\t        }\n   206\t\n   207\t        if param4 != 0 {\n   208\t            result = result.wrapping_add(param4 >> 2);\n   209\t        }\n   210\t\n   211\t        result = apply_bit_operations(result, &mut state.flags);\n   212\t        result = result.wrapping_add(base_offset);\n   213\t\n   214\t        let mut buffer = [0 as c_char; BUFFER_SIZE];\n   215\t        snprintf(\n   216\t            buffer.as_mut_ptr(),\n   217\t            BUFFER_SIZE,\n   218\t            c\"Result:%d:Complete\".as_ptr(),\n   219\t            result,\n   220\t        );\n   221\t\n   222\t        let colon_pos = strchr(buffer.as_ptr(), c_int::from(b':'));\n   223\t        if !colon_pos.is_null() {\n   224\t            if state.flags.verbose() {\n   225\t                printf(\n   226\t                    c\"Found colon at position: %ld\\n\".as_ptr(),\n   227\t                    colon_pos.offset_from(buffer.as_ptr()) as c_long,\n   228\t                );\n   229\t            }\n   230\t\n   231\t            let second_colon = strchr(colon_pos.add(1), c_int::from(b':'));\n   232\t            if !second_colon.is_null() && state.flags.debug() {\n   233\t                printf(c\"Debug: Result string format validated\\n\".as_ptr());\n   234\t            }\n   235\t        }\n   236\t\n   237\t        if result < 0 {\n   238\t            state = state_backup;\n   239\t            result = state.base_value;\n   240\t\n   241\t            if state.flags.verbose() {\n   242\t                printf(c\"Restored state from backup\\n\".as_ptr());\n   243\t            }\n   244\t        }\n   245\t\n   246\t        if state.flags.verbose() {\n   247\t            printf(c\"Final result: %d\\n\".as_ptr(), result);\n   248\t            printf(\n   249\t                c\"Configuration - Debug: %d, Optimize: %d, Log Level: %d\\n\".as_ptr(),\n   250\t                c_int::from(state.flags.debug()),\n   251\t                c_int::from(state.flags.optimize()),\n   252\t