\t    unsigned int cache_enabled : 1;\r\n    34\t    unsigned int log_level : 3;\r\n    35\t    unsigned int reserved : 1;\r\n    36\t};\r\n    37\t\r\n    38\tstruct ProcessState {\r\n    39\t    struct ConfigFlags flags;\r\n    40\t    int base_value;\r\n    41\t    int multiplier;\r\n    42\t    char operation;\r\n    43\t};\r\n    44\t\r\n    45\t#define BUFFER_SIZE 256\r\n    46\t\r\n    47\tint parse_env_numeric(const char* env_name, int default_val) {\r\n    48\t    char* env_value = getenv(env_name);\r\n    49\t\r\n    50\t    if (env_value == NULL) {\r\n    51\t        return default_val;\r\n    52\t    }\r\n    53\t\r\n    54\t    char* invalid_char = strchr(env_value, ',');\r\n    55\t    if (invalid_char != NULL) {\r\n    56\t        fprintf(stderr, \"Warning: Invalid character in %s\\n\", env_name);\r\n    57\t        return default_val;\r\n    58\t    }\r\n    59\t\r\n    60\t    invalid_char = strchr(env_value, ';');\r\n    61\t    if (invalid_char != NULL) {\r\n    62\t        fprintf(stderr, \"Warning: Semicolon found in %s\\n\", env_name);\r\n    63\t        return default_val;\r\n    64\t    }\r\n    65\t\r\n    66\t    return atoi(env_value);\r\n    67\t}\r\n    68\t\r\n    69\tvoid init_config_from_env(struct ConfigFlags* flags) {\r\n    70\t    char* verbose_env = getenv(\"PROG_VERBOSE\");\r\n    71\t    char* debug_env = getenv(\"PROG_DEBUG\");\r\n    72\t    char* optimize_env = getenv(\"PROG_OPTIMIZE\");\r\n    73\t\r\n    74\t    flags->verbose = (verbose_env != NULL && strchr(verbose_env, '1') != NULL) ? 1 : 0;\r\n    75\t    flags->debug = (debug_env != NULL && strchr(debug_env, '1') != NULL) ? 1 : 0;\r\n    76\t    flags->optimize = (optimize_env != NULL) ? 1 : 0;\r\n    77\t    flags->cache_enabled = 1;\r\n    78\t    flags->log_level = 03;\r\n    79\t    flags->reserved = 0;\r\n    80\t}\r\n    81\t\r\n    82\tint perform_operation(int val1, int val2, struct ConfigFlags* flags) {\r\n    83\t    int result = 0;\r\n    84\t\r\n    85\t  