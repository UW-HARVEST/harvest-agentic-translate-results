{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes as C\nimport math, os, random, struct\n\nC_SO = '/tmp/harvest-OLrn08-c-build/libharvest-work-OLrn08.so'\nR_SO = 'target/release/libharvest_work_olrn08.so'\nc = C.CDLL(C_SO, mode=os.RTLD_LOCAL)\nr = C.CDLL(R_SO, mode=os.RTLD_LOCAL)\n\nclass V(C.Structure): _fields_=[('x',C.c_float),('y',C.c_float)]\nclass Rot(C.Structure): _fields_=[('c',C.c_float),('s',C.c_float)]\nclass X(C.Structure): _fields_=[('p',V),('r',Rot)]\nclass Circle(C.Structure): _fields_=[('p',V),('r',C.c_float)]\nclass AABB(C.Structure): _fields_=[('min',V),('max',V)]\nclass Capsule(C.Structure): _fields_=[('a',V),('b',V),('r',C.c_float)]\nclass Cache(C.Structure): _fields_=[('metric',C.c_float),('count',C.c_int),('iA',C.c_int*3),('iB',C.c_int*3),('div',C.c_float)]\nclass Proxy(C.Structure): _fields_=[('radius',C.c_float),('count',C.c_int),('verts',V*8)]\nclass SV(C.Structure): _fields_=[('sA',V),('sB',V),('p',V),('u',C.c_float),('iA',C.c_int),('iB',C.c_int)]\nclass Simplex(C.Structure): _fields_=[('a',SV),('b',SV),('c',SV),('d',SV),('div',C.c_float),('count',C.c_int)]\n\nassert [C.sizeof(t) for t in (V,Rot,X,Circle,AABB,Capsule,Cache,Proxy,SV,Simplex)] == [8,8,16,12,16,20,36,72,36,152]\n\nspec = {\n'c2V':([C.c_float,C.c_float],V), 'c2Mulvs':([V,C.c_float],V),\n'c2Maxv':([V,V],V), 'c2Minv':([V,V],V), 'c2Clampv':([V,V,V],V),\n'c2Sub':([V,V],V), 'c2Dot':([V,V],C.c_float), 'c2RotIdentity':([],Rot),\n'c2xIdentity':([],X), 'c2BBVerts':([C.POINTER(V),C.POINTER(AABB)],None),\n'c2MakeProxy':([C.c_void_p,C.c_int,C.POINTER(Proxy)],None), 'c2Len':([V],C.c_float),\n'c2Det2':([V,V],C.c_float), 'c2GJKSimplexMetric':([C.POINTER(Simplex)],C.c_float),\n'c2Mulrv':([Rot,V],V), 'c2Add':([V,V],V), 'c2Mulxv':([X,V],V),\n'c22':([C.POINTER(Simplex)],None), 'c23':([C.POINTER(Simplex)],None),\n'c2Neg':([V],V), 'c2Skew':([V],V), 'c2CCW90':([V],V), 'c2D':([C.POINTER(Simplex)],V),\n'c2Support':([C.POINTER(V),C.c_int,V],C.c_int),\n'c2Witness':([C.POINTER(Simplex),C.POINTER(V),C.POINTER(V)],None),\n'c2Div':([V,C.c_float],V), 'c2Norm':([V],V), 'c2L':([C.POINTER(Simplex)],V),\n'c2MulrvT':([Rot,V],V),\n'c2GJK':([C.c_void_p,C.c_int,C.POINTER(X),C.c_void_p,C.c_int,C.POINTER(X),C.POINTER(V),C.POINTER(V),C.c_int,C.POINTER(C.c_int),C.POINTER(Cache)],C.c_float),\n'gjk_cache':([C.c_char,C.POINTER(V),C.POINTER(V)]+[C.c_float]*9,None),\n}\nfor lib in (c,r):\n    for name,(args,res) in spec.items():\n        f=getattr(lib,name); f.argtypes=args; f.restype=res\n\ndef raw(x):\n    if isinstance(x,float): return struct.pack('=f',x)\n    if isinstance(x,int): return struct.pack('=i',x)\n    return C.string_at(C.addressof(x),C.sizeof(x))\n\ndef same(name, a, b, context=''):\n    if raw(a)\"'!=raw(b):\n        raise AssertionError(f'\"'{name} mismatch {raw(a).hex()} \"'!= {raw(b).hex()} {context}'\"')\n\nrnd=random.Random(0xC2)\ndef rf(scale=1000.0): return C.c_float(rnd.uniform(-scale,scale)).value\ndef rv(scale=1000.0): return V(rf(scale),rf(scale))\ndef rrot():\n    a=rnd.uniform(-math.pi,math.pi); return Rot(C.c_float(math.cos(a)).value,C.c_float(math.sin(a)).value)\ndef rx(): return X(rv(100),rrot())\ndef rsv(): return SV(rv(),rv(),rv(),rf(),rnd.randrange(-10,11),rnd.randrange(-10,11))\ndef rsimplex(count=None):\n    return Simplex(rsv(),rsv(),rsv(),rsv(),rf() or 1.0,rnd.randrange(0,5) if count is None else count)\ndef clone(x): return type(x).from_buffer_copy(raw(x))\n\n# Pure by-value exports.\nfor i in range(10000):\n    a,b,lo,hi=rv(),rv(),rv(),rv(); s=rf()\n    for name,args in [\n        ('c2V',(a.x,a.y)),('c2Mulvs',(a,s)),('c2Maxv',(a,b)),('c2Minv',(a,b)),\n        ('c2Clampv',(a,lo,hi)),('c2Sub',(a,b)),('c2Dot',(a,b)),('c2Len',(a,)),\n        ('c2Det2',(a,b)),('c2Add',(a,b)),('c2Neg',(a,)),('c2Skew',(a,)),\n        ('c2CCW90',(a,)),('c2Div',(a,s if s \"'!= 0 else 1.0)),('\"'c2Norm',(a,))]:\n        same(name,getattr(c,name)(*args),getattr(r,name)(*args),f'iteration={i}')\n    rot=rrot(); x=X(rv(),rot)\n    for name,args in [('c2Mulrv',(rot,a)),('c2MulrvT',(rot,a)),('c2Mulxv',(x,a))]:\n        same(name,getattr(c,name)(*args),getattr(r,name)(*args),f'iteration={i}')\n\nfor name in ('c2RotIdentity','c2xIdentity'):\n    same(name,getattr(c,name)(),getattr(r,name)())\n\n# Pointer-based helper exports.\nfor i in range(5000):\n    bb=AABB(rv(),rv()); co=(V*4)(); ro=(V*4)()\n    c.c2BBVerts(co,C.byref(bb)); r.c2BBVerts(ro,C.byref(bb))\n    if bytes(co)\"'!=bytes(ro): raise AssertionError(f'\"'c2BBVerts {i}')\n    for typ,shape in [(0,Circle(rv(),abs(rf(30)))),(1,bb),(2,Capsule(rv(),rv(),abs(rf(30))))]:\n        cp=Proxy.from_buffer_copy(bytes([0xA5])*C.sizeof(Proxy)); rp=clone(cp)\n        c.c2MakeProxy(C.byref(shape),typ,C.byref(cp)); r.c2MakeProxy(C.byref(shape),typ,C.byref(rp))\n        same('c2MakeProxy',cp,rp,f'type={typ} iteration={i}')\n    for count in (1,2,3):\n        cs=rsimplex(count); rs=clone(cs)\n        same('c2GJKSimplexMetric',c.c2GJKSimplexMetric(C.byref(cs)),r.c2GJKSimplexMetric(C.byref(rs)),f'count={count} i={i}')\n        cs=rsimplex(count); rs=clone(cs); same('c2D',c.c2D(C.byref(cs)),r.c2D(C.byref(rs)),f'count={count} i={i}')\n        cs=rsimplex(count); rs=clone(cs); same('c2L',c.c2L(C.byref(cs)),r.c2L(C.byref(rs)),f'count={count} i={i}')\n        cs=rsimplex(count); rs=clone(cs); ca,cb,ra,rb=rv(),rv(),rv(),rv()\n        c.c2Witness(C.byref(cs),C.byref(ca),C.byref(cb)); r.c2Witness(C.byref(rs),C.byref(ra),C.byref(rb))\n        same('c2Witness/a',ca,ra,f'count={count} i={i}'); same('c2Witness/b',cb,rb,f'count={count} i={i}')\n    for name,count in [('c22',2),('c23',3)]:\n        cs=rsimplex(count); rs=clone(cs); getattr(c,name)(C.byref(cs)); getattr(r,name)(C.byref(rs)); same(name,cs,rs,f'i={i}')\n    n=rnd.randrange(1,9); verts=(V*n)(*[rv() for _ in range(n)]); d=rv()\n    same('c2Support',c.c2Support(verts,n,d),r.c2Support(verts,n,d),f'i={i}')\n\n# Full GJK over all shape pairings, transformed/untransformed, radius modes, and cache reuse.\ndef shape(typ):\n    if typ==0: return Circle(rv(200),abs(rf(40)))\n    if typ==1:\n        p=rv(200); w=abs(rf(50)); h=abs(rf(50)); return AABB(p,V(p.x+w,p.y+h))\n    return Capsule(rv(200),rv(200),abs(rf(40)))\n\ndef call(lib,A,ta,ax,B,tb,bx,use,cache):\n    oa=V(123.25,-991.5); ob=V(-772.75,88.125); it=C.c_int(-12345)\n    d=lib.c2GJK(C.byref(A),ta,C.byref(ax) if ax else None,C.byref(B),tb,C.byref(bx) if bx else None,C.byref(oa),C.byref(ob),use,C.byref(it),C.byref(cache))\n    return d,oa,ob,it\n\nfor i in range(20000):\n    ta=rnd.randrange(3); tb=rnd.randrange(3); A=shape(ta); B=shape(tb)\n    ax=rx() if rnd.randrange(2) else None; bx=rx() if rnd.randrange(2) else None; use=rnd.randrange(2)\n    cc=Cache(); rc=Cache()\n    co=call(c,A,ta,ax,B,tb,bx,use,cc); ro=call(r,A,ta,ax,B,tb,bx,use,rc)\n    for j,(cv,rvv) in enumerate(zip(co,ro)): same(f'c2GJK/{j}',cv,rvv,f'i={i} types={ta},{tb} use={use}')\n    same('c2GJK/cache',cc,rc,f'i={i} first')\n    co=call(c,A,ta,ax,B,tb,bx,use,cc); ro=call(r,A,ta,ax,B,tb,bx,use,rc)\n    for j,(cv,rvv) in enumerate(zip(co,ro)): same(f'c2GJK-cache/{j}',cv,rvv,f'i={i} types={ta},{tb} use={use}')\n    same('c2GJK/cache',cc,rc,f'i={i} second')\n\n# Public wrapper intentionally leaves output pointers untouched.\nfor reverse in (0,1):\n    ca=V(1.25,-2.5); cb=V(3.75,-4.0); ra=clone(ca); rb=clone(cb); vals=[rf(100) for _ in range(9)]\n    c.gjk_cache(reverse,C.byref(ca),C.byref(cb),*vals); r.gjk_cache(reverse,C.byref(ra),C.byref(rb),*vals)\n    same('gjk_cache/a',ca,ra); same('gjk_cache/b',cb,rb)\n\nprint('PASS: all 31 exports; 10,000 pure, 5,000 helper, and 20,000 double-call GJK differential cases')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
