ation files (the \"Software\"),\n     6\t * to deal in the Software without restriction,\n     7\t * including without limitation the rights to use, copy,\n     8\t * modify, merge, publish, distribute, sublicense,\n     9\t * and/or sell copies of the Software,\n    10\t * and to permit persons to whom the Software is furnished to do so,\n    11\t * subject to the following conditions:\n    12\t * \n    13\t * The above copyright notice and this permission notice\n    14\t * shall be included in all copies or substantial portions of the Software.\n    15\t * \n    16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    18\t * THE WARRANTIES OF MERCHANTABILITY,\n    19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    24\t */\n    25\t#include <stddef.h>\n    26\t#include <string.h>\n    27\t#include <stdint.h>\n    28\t\n    29\t/* Forward declarations */\n    30\tstatic size_t compact_runs(uint8_t *buf, size_t len, uint8_t threshold);\n    31\tstatic void rotate_buffer(uint8_t *buf, size_t len, int offset);\n    32\tstatic size_t remove_duplicates(uint8_t *buf, size_t len, int preserve_order);\n    33\tstatic void interleave_halves(uint8_t *buf, size_t len);\n    34\tstatic void reverse_segments(uint8_t *buf, size_t len, size_t seg_size);\n    35\t\n    36\t/**\n    37\t * Main entrance function - processes buffer based on operation flags\n    38\t * \n    39\t * @param buffer Input/output buffer\n    40\t * @param length Buffer length\n    41\t * @param flags Bit flags: \n    42\t *              bit 0: rotate buffer\n    43\t *              bit 1: compact runs\n    44\t *              bit 2: remove duplicates\n    45\t *              bit 3: interleave halves\n    46\t *              bit 4: reverse segments\n    47\t * @param param1 Operation-specific parameter (rotation offset, run threshold, segment size)\n    48\t * @param param2 Secondary parameter (preserve order flag, etc)\n    49\t * @return New buffer length after processing\n    50\t */\n    51\tsize_t process_buffer(uint8_t *buffer, size_t length, uint32_t flags, \n    52\t                     int param1, int param2) {\n    53\t    size_t new_len = length;\n    54\t    \n    55\t    if (buffer == NULL || length == 0) {\n    56\t        return 0;\n    57\t    }\n    58\t    \n    59\t    /* Branch based on multiple flags - creates diverse control flow */\n    60\t    if (flags & 0x01) {  /* Rotate */\n    61\t        int offset = param1 % (int)length;\n    62\t        if (offset != 0) {\n    63\t            rotate_buffer(buffer, length, offset);\n    64\t        }\n    65\t    }\n    66\t    \n    67\t    if (flags & 0x02) {  /* Compact runs */\n    68\t        uint8_t threshold = (param1 > 0 && param1 <= 255) ? (uint8_t)param1 : 3;\n    69\t        new_len = compact_runs(buffer, new_len, threshold);\n    70\t    }\n    71\t    \n    72\t    if (flags & 0x04) {  /* Remove duplicates */\n    73\t        int preserve = (param2 != 0);\n    74\t        new_len = remove_duplicates(buffer, new_len, preserve);\n    75\t    }\n    76\t    \n    77\t    /* Conditional chaining based on length */\n    78\t    if ((flags & 0x08) && new_len >= 2) {  /* Interleave */\n    79\t        interleave_halves(buffer, new_len);\n    80\t    }\n    81\t    \n    82\t    if ((flags & 0x10) && new_len >= 4) {  /* Reverse segments */\n    83\t        size_t seg_size = (param1 > 0) ? (size_t)param1 : 4;\n    84\t        if (seg_size <= new_len) {\n    85\t            reverse_segments(buffer, new_len, seg_size);\n    86\t        }\n    87\t    }\n    88\t    \n    89\t    return new_len;\n    90\t}\n    91\t\n    92\t/**\n    93\t * Rotate buffer by offset positions (positive = right, negative = left)\n    94\t * Uses multiple memmove operations with different patterns\n    95\t */\n    96\tstatic void rotate_buffer(uint8_t *buf, size_t len, int offset) {\n    97\t    if (len <= 1) return;\n    98\t    \n    99\t    /* Normalize offset */\n   100\t    offset = offset % (int)len;\n   101\t    if (offset < 0) offset += len;\n   102\t    if (offset == 0) return;\n   103\t    \n   104\t    /* Use reversal algorithm with memmove */\n   105\t    uint8_t temp[256];\n   106\t    size_t chunk = (offset < 256) ? offset : 256;\n   107\t    \n   108\t    if ((size_t)offset < len / 2) {\n   109\t        /* Small offset: move prefix aside, shift main part, restore prefix */\n   110\t        size_t i;\n   111\t        for (i = 0; i < (size_t)offset; i += chunk) {\n   112\t            size_t copy_len = ((size_t)offset - i < chunk) ? (size_t)offset - i : chunk;\n   113\t            memmove(temp, buf + i, copy_len);\n   114\t            memmove(buf + i, buf + offset, len - offset);\n   115\t            memmove(buf + len - offset, temp, copy_len);\n   116\t        }\n   117\t    } else {\n   118\t        /* Large offset: work from the right */\n   119\t        size_t shift = len - offset;\n   120\t        memmove(temp, buf, shift);\n   121\t        memmove(buf, buf + shift, offset);\n   122\t        memmove(buf + offset, temp, shift);\n   123\t    }\n   124\t}\n   125\t\n   126\t/**\n   127\t * Compact consecutive runs of same value if run length >= threshold\n   128\t * Complex nested loops with multiple data paths\n   129\t */\n   130\tstatic size_t compact_runs(uint8_t *buf, size_t len, uint8_t threshold) {\n   131\t    size_t read = 0, write = 0;\n   132\t    \n   133\t    while (read < len) {\n   134\t        uint8_t current = buf[read];\n   135\t        size_t run_len = 1;\n   136\t        \n   137\t        /* Count run length */\n   138\t        while (read + run_len < len && buf[read + run_len] == current) {\n   139\t            run_len++;\n   140\t        }\n   141\t        \n   142\t        if (run_len >= threshold) {\n   143\t            /* Compact to 2 elements: value, count */\n   144\t            if (run_len > 255) run_len = 255;  /* Cap at 255 */\n   145\t            \n   146\t            buf[write++] = current;\n   147\t            buf[write++] = (uint8_t)run_len;\n   148\t            \n   149\t            /* Shift remaining data if needed */\n   150\t            if (read + run_len < len) {\n   151\t                size_t remaining = len - (read + run_len);\n   152\t                memmove(buf + write, buf + read + run_len, remaining);\n   153\t            }\n   154\t            len = write + (len - (read + run_len));\n   155\t            read = write;\n   156\t        } else {\n   157\t            /* Keep run as-is, but may need to move it */\n   158\t            if (write != read) {\n   159\t                memmove(buf + write, buf + read, run_len);\n   160\t            }\n   161\t            write += run_len;\n   162\t            read += run_len;\n   163\t        }\n   164\t    }\n   165\t    \n   166\t    return len;\n   167\t}\n   168\t\n   169\t/**\n   170\t * Remove duplicate values - different paths for ordered/unordered\n   171\t */\n   172\tstatic size_t remove_duplicates(uint8_t *buf, size_t len, int preserve_order) {\n   173\t    if (len <= 1) return len;\n   174\t    \n   175\t    if (preserve_order) {\n   176\t        /* Preserve order: O(n^2) but maintains sequence */\n   177\t        size_t write = 1;\n   178\t        for (size_t i = 1; i < len; i++) {\n   179\t            size_t j;\n   180\t            for (j = 0; j < write; j++) {\n   181\t                if (buf[i] == buf[j]) break;\n   182\t            }\n   183\t            if (j == write) {\n   184\t                if (write != i) {\n   185\t                    buf[write] = buf[i];\n   186\t                }\n   187\t                write++;\n   188\t            }\n   189\t        }\n   190\t        return write;\n   191\t    } else {\n   192\t        /* Don't preserve order: sort-like approach with memmove */\n   193\t        uint8_t seen[256] = {0};\n   194\t        size_t write = 0;\n   195\t        \n   196\t        for (size_t i = 0; i < len; i++) {\n   197\t            if (!seen[buf[i]]) {\n   198\t                seen[buf[i]] = 1;\n   199\t                if (write != i) {\n   200\t                    /* Swap to front */\n   201\t                    uint8_t temp = buf[write];\n   202\t                    buf[write] = buf[i];\n   203\t                    buf[i] = temp;\n   204\t                }\n   205\t                write++;\n   206\t            }\n   207\t        }\n   208\t        return write;\n   209\t    }\n   210\t}\n   211\t\n   212\t/**\n   213\t * Interleave first and second halves of buffer\n   214\t * Complex memmove pattern with temporary storage\n   215\t */\n   216\tstatic void interleave_halves(uint8_t *buf, size_t len) {\n   217\t    if (len < 2) return;\n   218\t    \n   219\t    size_t half = len / 2;\n   220\t    size_t odd = len % 2;\n   221\t    uint8_t temp[512];\n   222\t    \n   223\t    if (half <= 256) {\n   224\t        /* Use temp buffer for small sizes */\n   225\t        memmove(temp, buf, half);\n   226\t        \n   227\t        for (size_t i = 0; i < half; i++) {\n   228\t            memmove(buf + i * 2 + 1, buf + half + i, 1);\n   229\t            buf[i * 2] = temp[i];\n   230\t        }\n   231\t        if (odd) {\n   232\t            buf[len - 1] = buf[half];\n   233\t        }\n   234\t    } else {\n   235\t        /* In-place for large buffers - more complex */\n   236\t        for (size_t i = 0; i < half; i++) {\n   237\t            size_t src = half + i;\n   238\t            size_t dst = i * 2 + 1;\n   239\t            if (dst < src) {\n   240\t                uint8_t val = buf[src];\n   241\t                memmove(buf + dst + 1, buf + dst, src - dst);\n   242\t                buf[dst] = val;\n   243\t            }\n   244\t        }\n   245\t    }\n   246\t}\n   247\t\n   248\t/**\n   249\t * Reverse buffer in fixed-size segments\n   250\t * Nested loops with conditional memmove operations\n   251\t */\n   252\tstatic void reverse_segments(uint8_t *buf, size_t len, size_t seg_size) {\n   253\t    if (seg_size <= 1 || len < seg_size) return;\n   254\t    \n   255\t    size_t num_segments = len / seg_size;\n   256\t    size_t remainder = len % seg_size;\n   257\t    \n   258\t    /* Process complete segments */\n   259\t    for (size_t seg = 0; seg < num_segments; seg++) {\n   260\t        size_t base = seg * seg_size;\n   261\t        \n   262\t        /* Reverse within segment using memmove */\n   263\t        for (size_t i = 0; i < seg_size / 2; i++) {\n   264\t            uint8_t temp;\n   265\t            size_t left = base + i;\n   266\t            size_t right = base + seg_size - 1 - i;\n   267\t            \n   268\t            temp = buf[left];\n   269\t            memmove(buf + left, buf + right, 1);\n   270\t            memmove(buf + right, &temp, 1);\n   271\t        }\n   272\t    }\n   273\t    \n   274\t    /* Handle remainder if exists and is > 1 */\n   275\t    if (remainder > 1) {\n   276\t        size_t base = num_segments * seg_size;\n   277\t        for (size_t i = 0; i < remainder / 2; i++) {\n   278\t            uint8_t temp = buf[base + i];\n   279\t            buf[base + i] = buf[base + remainder - 1 - i];\n   280\t            buf[base + remainder - 1 - i] = temp;\n   281\t        }\n   282\t    }\n   283\t}\n","exit_code":0,"status":"completed"}}
