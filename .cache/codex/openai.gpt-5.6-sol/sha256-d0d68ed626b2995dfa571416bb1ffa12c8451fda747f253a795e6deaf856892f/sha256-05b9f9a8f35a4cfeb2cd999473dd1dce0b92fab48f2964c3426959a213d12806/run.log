v == rv, ('safe_double_to_int', value, cv, rv)\n\nstrings = [b'', b'root', b'abc\\\\x7f', b'\\\\x80\\\\xffA', bytes(range(1, 256))]\nfor value in strings:\n    cb = ctypes.create_string_buffer(value)\n    rb = ctypes.create_string_buffer(value)\n    cv = c.process_string(cb)\n    rv = r.process_string(rb)\n    assert cv == rv, ('process_string', value[:20], cv, rv)\n\nvectors = [\n    (0, 0, 0, 0), (1, 2, 3, 4), (-1, -2, -1, -4),\n    (5, 5, 1, 2), (6, 6, 2, 3), (2**31 - 1, 0, 1, 1),\n    (-2**31, 0, 1, 1), (1000000, -1000000, 9999, -9999),\n]\nfor args in vectors:\n    cv, rv = c.maxnmin(*args), r.maxnmin(*args)\n    assert cv == rv, ('maxnmin vector', args, cv, rv)\n\nrng = random.Random(0xC0FFEE)\nfor index in range(100000):\n    args = tuple(rng.randint(-2**31, 2**31 - 1) for _ in range(4))\n    cv, rv = c.maxnmin(*args), r.maxnmin(*args)\n    assert cv == rv, ('maxnmin random', index, args, cv, rv)\n\n# The final random call left identical six-node trees in each library.\nfor node_id in range(-2, 10):\n    cp, rp = c.find_node_by_id(node_id), r.find_node_by_id(node_id)\n    assert bool(cp) == bool(rp), ('find presence', node_id)\n    if cp:\n        cn, rn = cp.contents, rp.contents\n        assert (cn.id, cn.parent_id, bytes(cn.name), cn.value, cn.active) == \\\\\n               (rn.id, rn.parent_id, bytes(rn.name), rn.value, rn.active), ('node', node_id)\n    assert c.get_children_count(node_id) == r.get_children_count(node_id), ('children', node_id)\n    assert same_double(c.calculate_subtree_sum(node_id), r.calculate_subtree_sum(node_id)), ('sum', node_id)\n\n# Fill both stores to capacity with long and high-bit names.\nfor index in range(94):\n    node_id = 1000 + index\n    parent_id = 1 if index % 2 == 0 else 2\n    name = bytes(((index + j) % 255) + 1 for j in range(70))\n    value = index * 0.25 - 7.0\n    cv = c.add_node(node_id, parent_id, name, value)\n    rv = r.add_node(node_id, parent_id, name, value)\n    assert cv == rv == index + 6, ('add', index, cv, rv)\n    cn = c.find_node_by_id(node_id).contents\n    rn = r.find_node_by_id(node_id).contents\n    assert (cn.id, cn.parent_id, bytes(cn.name), cn.value, cn.active) == \\\\\n           (rn.id, rn.parent_id, bytes(rn.name), rn.value, rn.active), ('added node', index)\nassert c.add_node(9999, 1, b'full', 1.0) == r.add_node(9999, 1, b'full', 1.0) == -1\n\n# Returned Node pointers are writable in the C ABI; compare behavior after mutation.\nfor lib in (c, r):\n    node = lib.find_node_by_id(2)\n    node.contents.active = 0\n    node = lib.find_node_by_id(3)\n    node.contents.value = -123.75\nfor node_id in (1, 2, 3, 1000, 1001):\n    assert bool(c.find_node_by_id(node_id)) == bool(r.find_node_by_id(node_id)), ('mutated find', node_id)\n    assert c.get_children_count(node_id) == r.get_children_count(node_id), ('mutated children', node_id)\n    assert same_double(c.calculate_subtree_sum(node_id), r.calculate_subtree_sum(node_id)), ('mutated sum', node_id)\n\nprint('differential checks passed: 14 conversions, 5 strings, 8 vectors, 100000 random calls, 94 additions, mutation checks')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
