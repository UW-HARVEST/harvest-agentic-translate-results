{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/main.rs'","aggregated_output":"     1\tuse std::env;\n     2\tuse std::ffi::OsString;\n     3\tuse std::io::{self, Read, Write};\n     4\tuse std::os::unix::ffi::OsStringExt;\n     5\tuse std::process;\n     6\t\n     7\tconst LUGGAGE_ID_LENGTH: usize = 8;\n     8\tconst FLIGHT_ID_LENGTH: usize = 6;\n     9\tconst AIRPORT_CODE_LENGTH: usize = 3;\n    10\tconst COMMENTS_LENGTH: usize = 80;\n    11\t\n    12\t#[derive(Debug)]\n    13\tstruct RoutingDirective {\n    14\t    time_stamp: u32,\n    15\t    luggage_id: Vec<u8>,\n    16\t    flight_id: Vec<u8>,\n    17\t    departure: Vec<u8>,\n    18\t    arrival: Vec<u8>,\n    19\t    comments: Vec<u8>,\n    20\t}\n    21\t\n    22\tenum Scan<T> {\n    23\t    Value(T),\n    24\t    Eof,\n    25\t    ConversionFailure,\n    26\t}\n    27\t\n    28\tstruct Scanner {\n    29\t    input: Vec<u8>,\n    30\t    position: usize,\n    31\t}\n    32\t\n    33\timpl Scanner {\n    34\t    fn new(input: Vec<u8>) -> Self {\n    35\t        Self { input, position: 0 }\n    36\t    }\n    37\t\n    38\t    fn is_eof(&self) -> bool {\n    39\t        self.position == self.input.len()\n    40\t    }\n    41\t\n    42\t    fn skip_whitespace(&mut self) {\n    43\t        while self\n    44\t            .input\n    45\t            .get(self.position)\n    46\t            .is_some_and(|byte| matches!(byte, b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r'))\n    47\t        {\n    48\t            self.position += 1;\n    49\t        }\n    50\t    }\n    51\t\n    52\t    // Mirrors scanf(\"%d \"): decimal conversion followed by a whitespace directive.\n    53\t    fn scan_time_stamp(&mut self) -> Scan<u32> {\n    54\t        self.skip_whitespace();\n    55\t        if self.is_eof() {\n    56\t            return Scan::Eof;\n    57\t        }\n    58\t\n    59\t        let negative = match self.input[self.position] {\n    60\t            b'-' => {\n    61\t                self.position += 1;\n    62\t                true\n    63\t            }\n    64\t            b'+' => {\n    65\t                self.position += 1;\n    66\t                false\n    67\t            }\n    68\t            _ => false,\n    69\t        };\n    70\t\n    71\t        let digit_start = self.position;\n    72\t        let mut magnitude = 0_u32;\n    73\t        while let Some(byte @ b'0'..=b'9') = self.input.get(self.position) {\n    74\t            magnitude = magnitude\n    75\t                .wrapping_mul(10)\n    76\t                .wrapping_add(u32::from(*byte - b'0'));\n    77\t            self.position += 1;\n    78\t        }\n    79\t\n    80\t        if self.position == digit_start {\n    81\t            return Scan::ConversionFailure;\n    82\t        }\n    83\t\n    84\t        self.skip_whitespace();\n    85\t        let value = if negative {\n    86\t            0_u32.wrapping_sub(magnitude)\n    87\t        } else {\n    88\t            magnitude\n    89\t        };\n    90\t        Scan::Value(value)\n    91\t    }\n    92\t\n    93\t    fn scan_set<F>(&mut self, width: usize, accepted: F) -> Scan<Vec<u8>>\n    94\t    where\n    95\t        F: Fn(u8) -> bool,\n    96\t    {\n    97\t        if self.is_eof() {\n    98\t            return Scan::Eof;\n    99\t        }\n   100\t\n   101\t        let start = self.position;\n   102\t        while self.position - start < width\n   103\t            && self\n   104\t                .input\n   105\t                .get(self.position)\n   106\t                .is_some_and(|byte| accepted(*byte))\n   107\t        {\n   108\t            self.position += 1;\n   109\t        }\n   110\t\n   111\t        if self.position == start {\n   112\t            Scan::ConversionFailure\n   113\t        } else {\n   114\t            Scan::Value(self.input[start..self.position].to_vec())\n   115\t        }\n   116\t    }\n   117\t\n   118\t    // Mirrors scanf(\"%8[A-Z0-9] %6[A-Z0-9] \").\n   119\t    fn scan_ids(&mut self) -> Scan<(Vec<u8>, Vec<u8>)> {\n   120\t        let luggage_id = match self.scan_set(LUGGAGE_ID_LENGTH, is_uppercase_or_digit) {\n   121\t            Scan::Value(value) => value,\n   122\t            Scan::Eof => return Scan::Eof,\n   123\t            Scan::ConversionFailure => return Scan::ConversionFailure,\n   124\t        };\n   125\t\n   126\t        self.skip_whitespace();\n   127\t        let flight_id = match self.scan_set(FLIGHT_ID_LENGTH, is_uppercase_or_digit) {\n   128\t            Scan::Value(value) => value,\n   129\t            // scanf returns one successful conversion here, not EOF. The C then\n   130\t            // reads uninitialized storage, so no deterministic behavior exists.\n   131\t            Scan::Eof | Scan::ConversionFailure => return Scan::ConversionFailure,\n   132\t        };\n   133\t        self.skip_whitespace();\n   134\t\n   135\t        Scan::Value((luggage_id, flight_id))\n   136\t    }\n   137\t\n   138\t    // Mirrors scanf(\"%3[A-Z] %3[A-Z]\").\n   139\t    fn scan_airports(&mut self) -> Scan<(Vec<u8>, Vec<u8>)> {\n   140\t        let departure = match self.scan_set(AIRPORT_CODE_LENGTH, is_uppercase) {\n   141\t            Scan::Value(value) => value,\n   142\t            Scan::Eof => return Scan::Eof,\n   143\t            Scan::ConversionFailure => return Scan::ConversionFailure,\n   144\t        };\n   145\t\n   146\t        self.skip_whitespace();\n   147\t        let arrival = match self.scan_set(AIRPORT_CODE_LENGTH, is_uppercase) {\n   148\t            Scan::Value(value) => value,\n   149\t            Scan::Eof | Scan::ConversionFailure => return Scan::ConversionFailure,\n   150\t        };\n   151\t\n   152\t        Scan::Value((departure, arrival))\n   153\t    }\n   154\t\n   155\t    // Mirrors scanf(\"%80[^\\n]\"). An immediate newline is a conversion failure,\n   156\t    // but the caller's preinitialized empty comment remains valid.\n   157\t    fn scan_comments(&mut self) -> Scan<Vec<u8>> {\n   158\t        self.scan_set(COMMENTS_LENGTH, |byte| byte != b'\\n')\n   159\t    }\n   160\t}\n   161\t\n   162\tfn is_uppercase(byte: u8) -> bool {\n   163\t    byte.is_ascii_uppercase()\n   164\t}\n   165\t\n   166\tfn is_uppercase_or_digit(byte: u8) -> bool {\n   167\t    byte.is_ascii_uppercase() || byte.is_ascii_digit()\n   168\t}\n   169\t\n   170\tfn c_string(bytes: Vec<u8>) -> Vec<u8> {\n   171\t    match bytes.iter().position(|byte| *byte == 0) {\n   172\t        Some(end) => bytes[..end].to_vec(),\n   173\t        None => bytes,\n   174\t    }\n   175\t}\n   176\t\n   177\tfn matches(expected: &[u8], actual: &[u8]) -> bool {\n   178\t    expected.first() == Some(&b'-') || expected == actual\n   179\t}\n   180\t\n   181\tfn superseded(directives: &[RoutingDirective], index: usize) -> bool {\n   182\t    let directive = &directives[index];\n   183\t    for later in &directives[index + 1..] {\n   184\t        if later.luggage_id != directive.luggage_id {\n   185\t            continue;\n   186\t        }\n   187\t        return later.departure == directive.departure;\n   188\t    }\n   189\t    false\n   190\t}\n   191\t\n   192\tfn main() {\n   193\t    let arguments: Vec<Vec<u8>> = env::args_os().map(OsString::into_vec).collect();\n   194\t    if arguments.len() != 5 {\n   195\t        let _ = io::stderr().write_all(b\"Command line error: 4 arguments expected\\n\");\n   196\t        process::exit(1);\n   197\t    }\n   198\t\n   199\t    let mut input = Vec::new();\n   200\t    io::stdin().read_to_end(&mut input).unwrap();\n   201\t    let mut scanner = Scanner::new(input);\n   202\t    let mut directives = Vec::new();\n   203\t\n   204\t    loop {\n   205\t        let time_stamp = match scanner.scan_time_stamp() {\n   206\t            Scan::Value(value) => value,\n   207\t            Scan::Eof => break,\n   208\t            Scan::ConversionFailure => break,\n   209\t        };\n   210\t        let (luggage_id, flight_id) = match scanner.scan_ids() {\n   211\t            Scan::Value(value) => value,\n   212\t            Scan::Eof => break,\n   213\t            Scan::ConversionFailure => break,\n   214\t        };\n   215\t        let (departure, arrival) = match scanner.scan_airports() {\n   216\t            Scan::Value(value) => value,\n   217\t            Scan::Eof => break,\n   218\t            Scan::ConversionFailure => break,\n   219\t        };\n   220\t        let comments = match scanner.scan_comments() {\n   221\t            Scan::Value(value) => value,\n   222\t            Scan::Eof => break,\n   223\t            Scan::ConversionFailure => Vec::new(),\n   224\t        };\n   225\t\n   226\t        let directive = RoutingDirective {\n   227\t            time_stamp,\n   228\t            luggage_id,\n   229\t            flight_id,\n   230\t            departure,\n   231\t            arrival,\n   232\t            comments: c_string(comments),\n   233\t        };\n   234\t        let insertion_index = directives\n   235\t            .iter()\n   236\t            .position(|existing: &RoutingDirective| existing.time_stamp > time_stamp)\n   237\t            .unwrap_or(directives.len());\n   238\t        directives.insert(insertion_index, directive);\n   239\t    }\n   240\t\n   241\t    let mut output = Vec::new();\n   242\t    for (index, directive) in directives.iter().enumerate() {\n   243\t        if !superseded(&directives, index)\n   244\t            && matches(&arguments[1], &directive.luggage_id)\n   245\t            && matches(&arguments[2], &directive.flight_id)\n   246\t            && matches(&arguments[3], &directive.departure)\n   247\t            && matches(&arguments[4], &directive.arrival)\n   248\t        {\n   249\t            write!(&mut output, \"{:010} \", directive.time_stamp).unwrap();\n   250\t            output.extend_from_slice(&directive.luggage_id);\n   251\t            output.push(b' ');\n   252\t            output.extend_from_slice(&directive.flight_id);\n   253\t            output.push(b' ');\n   254\t            output.extend_from_slice(&directive.departure);\n   255\t            output.push(b' ');\n   256\t            output.extend_from_slice(&directive.arrival);\n   257\t            output.push(b' ');\n   258\t            output.extend_from_slice(&directive.comments);\n   259\t            output.push(b'\\n');\n   260\t        }\n   261\t    }\n   262\t    let _ = io::stdout().write_all(&output);\n   263\t}\n","exit_code":0,"status":"completed"}}
