RT_MAIL_SZ) != 0)) {\n   141\t                continue;\n   142\t            }\n   143\t\n   144\t            p = strchr(p, '-');\n   145\t            if (p) {\n   146\t                p++;\n   147\t                /* Skip leading spaces */\n   148\t                while (*p == ' ') {\n   149\t                        p++;\n   150\t                }\n   151\t                os_free(al_data->group);\n   152\t                al_data->group = os_strdup(p);\n   153\t\n   154\t                /* Clean newline from group */\n   155\t                os_clearnl(al_data->group, p);\n   156\t                if (al_data->group != NULL && strstr(al_data->group, \"syscheck\") != NULL) {\n   157\t                    issyscheck = 1;\n   158\t                }\n   159\t            }\n   160\t\n   161\t            /* Search for active-response flag */\n   162\t            _r = 1;\n   163\t            continue;\n   164\t        }\n   165\t\n   166\t        if (_r < 1) {\n   167\t            continue;\n   168\t        }\n   169\t\n   170\t        /*** Extract information from the event ***/\n   171\t\n   172\t        /* r1 means: 2006 Apr 13 16:15:17 /var/log/auth.log */\n   173\t        if (_r == 1) {\n   174\t            /* Clear newline */\n   175\t            os_clearnl(str, p);\n   176\t\n   177\t            p = strchr(str, ':');\n   178\t            if (p) {\n   179\t                p = strchr(p, ' ');\n   180\t                if (p) {\n   181\t                    *p = '\\0';\n   182\t                    p++;\n   183\t                } else {\n   184\t                    /* If p is null it is because strchr failed */\n   185\t                    perror(\"date of location not NULL\");\n   186\t                    goto l_error;\n   187\t                }\n   188\t            }\n   189\t\n   190\t            /* If not, str is date and p is the location */\n   191\t            if (al_data->date || al_data->location || !p) {\n   192\t                perror(\"date or location not NULL or p is NULL\");\n   193\t                goto l_error;\n   194\t            }\n   195\t\n   196\t            al_data->date = os_strdup(str);\n   197\t            al_data->location = os_strdup(p);\n   198\t            _r = 2;\n   199\t            log_size = 0;\n   200\t            continue;\n   201\t        } else if (_r == 2) {\n   202\t            /* Rule begin */\n   203\t            if (strncmp(RULE_BEGIN, str, RULE_BEGIN_SZ) == 0) {\n   204\t                os_clearnl(str, p);\n   205\t\n   206\t                p = str + RULE_BEGIN_SZ;\n   207\t                al_data->rule = atoi(p);\n   208\t\n   209\t                p = strchr(p, ' ');\n   210\t                if (p) {\n   211\t                    p++;\n   212\t                    p = strchr(p, ' ');\n   213\t                    if (p) {\n   214\t                        p++;\n   215\t                    }\n   216\t                }\n   217\t\n   218\t                if (!p) {\n   219\t                    goto l_error;\n   220\t                }\n   221\t\n   222\t                al_data->level = atoi(p);\n   223\t\n   224\t                /* Get the comment */\n   225\t                p = strchr(p, '\\'');\n   226\t                if (!p) {\n   227\t                    goto l_error;\n   228\t                }\n   229\t\n   230\t                p++;\n   231\t                os_free(al_data->comment);\n   232\t                al_data->comment = os_strdup(p);\n   233\t\n   234\t                /* Must have the closing \\' */\n   235\t                p = strrchr(al_data->comment, '\\'');\n   236\t                if (p) {\n   237\t                    *p = '\\0';\n   238\t                } else {\n   239\t                    goto l_error;\n   240\t                }\n   241\t            }\n   242\t\n   243\t            /* srcip */\n   244\t            else if (strncmp(SRCIP_BEGIN, str, SRCIP_BEGIN_SZ) == 0) {\n   245\t                os_clearnl(str, p);\n   246\t\n   247\t                p = str + SRCIP_BEGIN_SZ;\n