    13\tvoid *os_calloc(size_t num, size_t size) {\n    14\t    void *out = calloc(num, size);\n    15\t    if (!out) {\n    16\t        fprintf(stderr, \"Memory allocation failed in os_calloc\");\n    17\t        exit(EXIT_FAILURE);\n    18\t    }\n    19\t    return out;\n    20\t}\n    21\t\n    22\tvoid *os_realloc(void *ptr, size_t new_size) {\n    23\t    void *out = realloc(ptr, new_size);\n    24\t    if (!out) {\n    25\t        fprintf(stderr, \"Memory allocation failed in os_realloc\");\n    26\t        exit(EXIT_FAILURE);\n    27\t    }\n    28\t    return out;\n    29\t}\n    30\t\n    31\tchar *os_strdup(const char *str) {\n    32\t    if (!str) {\n    33\t        fprintf(stderr, \"NULL string passed to os_strdup\");\n    34\t        exit(EXIT_FAILURE);\n    35\t    }\n    36\t    char *dup = strdup(str);\n    37\t    if (!dup) {\n    38\t        fprintf(stderr, \"Memory allocation failed in os_strdup\");\n    39\t        exit(EXIT_FAILURE);\n    40\t    }\n    41\t    return dup;\n    42\t}\n    43\t\n    44\t#endif\n","exit_code":0,"status":"completed"}}
