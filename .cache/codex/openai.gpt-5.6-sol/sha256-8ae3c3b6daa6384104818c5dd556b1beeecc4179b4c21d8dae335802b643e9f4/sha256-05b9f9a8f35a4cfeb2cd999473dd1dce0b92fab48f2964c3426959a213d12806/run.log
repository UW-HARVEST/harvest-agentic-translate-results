{"type":"item.started","item":{"id":"item_56","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes as C\nimport os\nimport random\n\nroot = '/local/home/scheschb/.harvest/work/harvest-work-3lZJzH'\nlibs = [C.CDLL(root + '/reference-build/liblz4.so'), C.CDLL(root + '/translation/target/release/liblz4_translation.so')]\nci = C.c_int\ncv = C.c_void_p\ncz = C.c_size_t\n\ndef sig(name, args, result):\n    for lib in libs:\n        fn = getattr(lib, name)\n        fn.argtypes = args\n        fn.restype = result\n\nsig('LZ4_versionNumber', [], ci)\nsig('LZ4_versionString', [], C.c_char_p)\nsig('LZ4_compressBound', [ci], ci)\nsig('LZ4_compress_default', [cv, cv, ci, ci], ci)\nsig('LZ4_decompress_safe', [cv, cv, ci, ci], ci)\nsig('LZ4_compress_HC', [cv, cv, ci, ci, ci], ci)\nsig('LZ4_XXH32', [cv, cz, C.c_uint], C.c_uint)\nsig('LZ4_XXH64', [cv, cz, C.c_ulonglong], C.c_ulonglong)\nsig('LZ4_createStream', [], cv)\nsig('LZ4_freeStream', [cv], ci)\nsig('LZ4_compress_fast_continue', [cv, cv, cv, ci, ci, ci], ci)\nsig('LZ4F_compressFrameBound', [cz, cv], cz)\nsig('LZ4F_compressFrame', [cv, cz, cv, cz, cv], cz)\nsig('LZ4F_createDecompressionContext', [C.POINTER(cv), C.c_uint], cz)\nsig('LZ4F_freeDecompressionContext', [cv], cz)\nsig('LZ4F_decompress', [cv, cv, C.POINTER(cz), cv, C.POINTER(cz), cv], cz)\nsig('LZ4F_writeOpen', [C.POINTER(cv), cv, cv], cz)\nsig('LZ4F_write', [cv, cv, cz], cz)\nsig('LZ4F_writeClose', [cv], cz)\nsig('LZ4F_readOpen', [C.POINTER(cv), cv], cz)\nsig('LZ4F_read', [cv, cv, cz], cz)\nsig('LZ4F_readClose', [cv], cz)\n\nassert [x.LZ4_versionNumber() for x in libs] == [11000, 11000]\nassert [x.LZ4_versionString() for x in libs] == [b'1.10.0', b'1.10.0']\n\nrng = random.Random(8675309)\ncases = [b'', b'a', b'abcd', b'a' * 70000, bytes(range(256)) * 300]\ncases += [rng.randbytes(n) for n in (3, 15, 16, 31, 255, 4096, 65535, 100000)]\nchecks = 0\nfor data in cases:\n    source = C.create_string_buffer(data)\n    bounds = [lib.LZ4_compressBound(len(data)) for lib in libs]\n    assert bounds[0] == bounds[1]\n    encoded = []\n    for lib, bound in zip(libs, bounds):\n        dst = C.create_string_buffer(max(bound, 1))\n        size = lib.LZ4_compress_default(source, dst, len(data), bound)\n        encoded.append((size, dst.raw[:max(size, 0)]))\n    assert encoded[0] == encoded[1]\n    for lib, (size, payload) in zip(libs, encoded):\n        dst = C.create_string_buffer(max(len(data), 1))\n        decoded = lib.LZ4_decompress_safe(C.create_string_buffer(payload), dst, size, len(data))\n        assert decoded == len(data) and dst.raw[:decoded] == data\n    for level in (2, 9, 10, 12):\n        hc = []\n        for lib, bound in zip(libs, bounds):\n            dst = C.create_string_buffer(max(bound, 1))\n            size = lib.LZ4_compress_HC(source, dst, len(data), bound, level)\n            hc.append((size, dst.raw[:max(size, 0)]))\n        assert hc[0] == hc[1]\n    assert [lib.LZ4_XXH32(source, len(data), 0x12345678) for lib in libs][0] == libs[1].LZ4_XXH32(source, len(data), 0x12345678)\n    assert [lib.LZ4_XXH64(source, len(data), 0x123456789abcdef0) for lib in libs][0] == libs[1].LZ4_XXH64(source, len(data), 0x123456789abcdef0)\n    frames = []\n    frame_bound = libs[0].LZ4F_compressFrameBound(len(data), None)\n    assert frame_bound == libs[1].LZ4F_compressFrameBound(len(data), None)\n    for lib in libs:\n        dst = C.create_string_buffer(max(frame_bound, 1))\n        size = lib.LZ4F_compressFrame(dst, frame_bound, source, len(data), None)\n        frames.append((size, dst.raw[:size]))\n    assert frames[0] == frames[1]\n    for lib, (frame_size, frame) in zip(libs, frames):\n        context = cv()\n        assert lib.LZ4F_createDecompressionContext(C.byref(context), 100) == 0\n        dst = C.create_string_buffer(max(len(data), 1))\n        dst_size, src_size = cz(len(data)), cz(frame_size)\n        hint = lib.LZ4F_decompress(context, dst, C.byref(dst_size), C.create_string_buffer(frame), C.byref(src_size), None)\n        assert hint == 0 and dst.raw[:dst_size.value] == data\n        assert lib.LZ4F_freeDecompressionContext(context) == 0\n    checks += 1\n\nchunks = [rng.randbytes(4096), b'prefix-' * 5000, rng.randbytes(8192)]\nstream_results = []\nfor lib in libs:\n    stream = lib.LZ4_createStream()\n    outputs = []\n    for chunk in chunks:\n        src = C.create_string_buffer(chunk)\n        cap = lib.LZ4_compressBound(len(chunk))\n        dst = C.create_string_buffer(cap)\n        size = lib.LZ4_compress_fast_continue(stream, src, dst, len(chunk), cap, 1)\n        outputs.append((size, dst.raw[:size]))\n    assert lib.LZ4_freeStream(stream) == 0\n    stream_results.append(outputs)\nassert stream_results[0] == stream_results[1]\n\nlibc = C.CDLL(None)\nlibc.tmpfile.restype = cv\nlibc.rewind.argtypes = [cv]\nlibc.fread.argtypes = [cv, cz, cz, cv]\nlibc.fread.restype = cz\nlibc.fclose.argtypes = [cv]\nfile_payload = (b'file-api-data-' * 10000) + rng.randbytes(5000)\nfile_frames = []\nfor lib in libs:\n    fp = libc.tmpfile(); assert fp\n    writer = cv()\n    assert lib.LZ4F_writeOpen(C.byref(writer), fp, None) == 0\n    src = C.create_string_buffer(file_payload)\n    split = len(file_payload) // 3\n    assert lib.LZ4F_write(writer, src, split) == split\n    assert lib.LZ4F_write(writer, C.byref(src, split), len(file_payload) - split) == len(file_payload) - split\n    assert lib.LZ4F_writeClose(writer) == 0\n    libc.rewind(fp)\n    storage = C.create_string_buffer(len(file_payload) + 4096)\n    n = libc.fread(storage, 1, len(storage), fp)\n    libc.fclose(fp)\n    file_frames.append(storage.raw[:n])\nassert file_frames[0] == file_frames[1]\n\nprint(f'differential checks passed: {checks} data cases, 4 HC levels, frames, streaming, xxHash, file API')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
