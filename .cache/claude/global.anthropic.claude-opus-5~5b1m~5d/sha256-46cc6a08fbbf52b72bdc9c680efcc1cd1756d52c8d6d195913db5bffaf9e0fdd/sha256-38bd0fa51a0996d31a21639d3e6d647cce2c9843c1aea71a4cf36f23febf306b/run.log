    printf(\"\\n\");\n    }\n\n    /* compute_with_dynamic_memory */\n    for (int i = 0; i < n; i++)\n        for (int count = -2; count <= 12; count++)\n            printf(\"cwdm(%d,%d)=%d\\n\", vals[i], count, compute_with_dynamic_memory(vals[i], count));\n    printf(\"cwdm(3,1000)=%d\\n\", compute_with_dynamic_memory(3, 1000));\n    printf(\"cwdm(-7,257)=%d\\n\", compute_with_dynamic_memory(-7, 257));\n\n    /* get_time_based_value */\n    for (int i = 0; i < n; i++)\n        printf(\"gtbv(%d)=%d\\n\", vals[i], get_time_based_value(vals[i]));\n    for (int s = -600000; s <= 600000; s += 123457)\n        printf(\"gtbv(%d)=%d\\n\", s, get_time_based_value(s));\n\n    /* manipulate_records */\n    for (int shift = 0; shift <= 6; shift++) {\n        DataRecord recs[5];\n        memset(recs, 0, sizeof(recs));\n        for (int i = 0; i < 5; i++) {\n            recs[i].id = i;\n            recs[i].value = 10 + i;\n            recs[i].timestamp = 1000 + i;\n            snprintf(recs[i].name, 32, \"R%d\", i);\n        }\n        int t = manipulate_records(recs, 5, shift);\n        printf(\"mr(shift=%d)=%d ids:\", shift, t);\n        for (int i = 0; i < 5; i++) printf(\" [%d,%d,%ld,%s]\", recs[i].id, recs[i].value, (long)recs[i].timestamp, recs[i].name);\n        printf(\"\\n\");\n    }\n\n    /* hatch - stateful, run a long sequence */\n    for (int i = 0; i < n; i++)\n        for (int j = 0; j < n; j += 2)\n            printf(\"hatch(%d,%d,%d,%d)=%d\\n\", vals[i], vals[j], vals[(i + j) % n], vals[(i * 3 + 1) % n],\n                   hatch(vals[i], vals[j], vals[(i + j) % n], vals[(i * 3 + 1) % n]));\n\n    /* interleave hatch with the other stateful functions */\n    for (int i = 0; i < 20; i++) {\n        increment_counter(i * 7 - 3, 0);\n        update_accumulator(i - 11, 0);\n        printf(\"mix %d: hatch=%d cc=%d gtbv=%d\\n\", i,\n               hatch(i, i * 2 - 5, 3 - i, i * i),\n               complex_calc(1, 2, 3), get_time_based_value(i));\n    }\n\n    dlclo