or (i = 0; i < size; i++) sum += src[i] * src[i];\n    let mut i: c_int = 0;\n    while i < size {\n        let v: f32 = unsafe { *src.offset(i as isize) };\n        sum += v * v;\n        i += 1;\n    }\n\n    if sum > 0.0f32 {\n        // sum = 1.0f / sqrtf(sum);\n        sum = 1.0f32 / sum.sqrt();\n\n        // for (i = 0; i < size; i++) dest[i] = src[i] * sum;\n        i = 0;\n        while i < size {\n            let v: f32 = unsafe { *src.offset(i as isize) };\n            unsafe { *dest.offset(i as isize) = v * sum };\n            i += 1;\n        }\n    } else if dest as *const f32 != src {\n        // memset(dest, 0, size * sizeof(float));\n        //\n        // C converts `size` (int) to size_t before multiplying, so negative\n        // sizes sign-extend and the product wraps -- mirror that here.\n        let nbytes: usize = (size as usize).wrapping_mul(size_of::<f32>());\n        unsafe { core::ptr::write_bytes(dest as *mut u8, 0u8, nbytes) };\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":275,"cache_read_input_tokens":20099,"cache_creation":{"ephemeral_5m_input_tokens":275,"ephemeral_1h_input_tokens":0},"output_tokens":17,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"8d8dd34e-7d79-4364-92b3-8c75a595b303","uuid":"b59868f0-5754-4744-8190-94754cb8696d","timestamp":"2026-08-27T00:08:44.048Z"}
