ad follows so the\n// g_scf_long[8] case stays inside our own allocation rather than being UB in\n// Rust. (Rows written shorter than their declared length are zero-filled,\n// which is what C does.)\n// ---------------------------------------------------------------------------\n\nconst OFF_MIXED: usize = 0;\nconst OFF_SHORT: usize = 320;\nconst OFF_LONG: usize = 640;\n\nstatic G_SCF_TABLES: [u8; 888] = [\n    0x06, 0x06, 0x06, 0x06, 0x06, 0x06, 0x06, 0x06, 0x06, 0x08, 0x08, 0x08, 0x0a, 0x0a, 0x0a, 0x0c,\n    0x0c, 0x0c, 0x0e, 0x0e, 0x0e, 0x12, 0x12, 0x12, 0x18, 0x18, 0x18, 0x1e, 0x1e, 0x1e, 0x28, 0x28,\n    0x28, 0x12, 0x12, 0x12, 0x00, 0x00, 0x00, 0x00, 0x0c, 0x0c, 0x0c, 0x04, 0x04, 0x04, 0x08, 0x08,\n    0x08, 0x0c, 0x0c, 0x0c, 0x10, 0x10, 0x10, 0x14, 0x14, 0x14, 0x18, 0x18, 0x18, 0x1c, 0x1c, 0x1c,\n    0x24, 0x24, 0x24, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x1a, 0x1a, 0x1a, 0x00,\n    0x06, 0x06, 0x06, 0x06, 0x06, 0x06, 0x06, 0x06, 0x06, 0x06, 0x06, 0x06, 0x08, 0x08, 0x08, 0x0a,\n    0x0a, 0x0a, 0x0e, 0x0e, 0x0e, 0x12, 0x12, 0x12, 0x1a, 0x1a, 0x1a, 0x20, 0x20, 0x20, 0x2a, 0x2a,\n    0x2a, 0x12, 0x12, 0x12, 0x00, 0x00, 0x00, 0x00, 0x06, 0x06, 0x06, 0x06, 0x06, 0x06, 0x06, 0x06,\n    0x06, 0x08, 0x08, 0x08, 0x0a, 0x0a, 0x0a, 0x0c, 0x0c, 0x0c, 0x0e, 0x0e, 0x0e, 0x12, 0x12, 0x12,\n    0x18, 0x18, 0x18, 0x20, 0x20, 0x20, 0x2c, 0x2c, 0x2c, 0x0c, 0x0c, 0x0c, 0x00, 0x00, 0x00, 0x00,\n    0x06, 0x06, 0x06, 0x06, 0x06, 0x06, 0x06, 0x06, 0x06, 0x08, 0x08, 0x08, 0x0a, 0x0a, 0x0a, 0x0c,\n    0x0c, 0x0c, 0x0e, 0x0e, 0x0e, 0x12, 0x12, 0x12, 0x18, 0x18, 0x18, 0x1e, 0x1e, 0x1e, 0x28, 0x28,\n    0x28, 0x12, 0x12, 0x12, 0x00, 0x00, 0x00, 0x00, 0x04, 0x04, 0x04, 0x04, 0x04, 0x04, 0x06, 0x06,\n    0x04, 0x04, 0x04, 0x06, 0x06, 0x06, 0x08, 0x08, 0x08, 0x0a, 0x0a, 0x0a, 0x0c, 0x0c, 0x0c, 0x0e,\n    0x0e, 0x0e, 0x12, 0x12, 0x12, 0x16, 0x16, 0x16, 0x1e, 0x1e, 0x1e, 0x38, 0x38, 0x38, 0x00, 0x00,\n    0x04, 0x04, 0x04, 0x04, 0x04, 0x04, 0x06, 0x06, 0x04, 0x04, 0x04, 0x06