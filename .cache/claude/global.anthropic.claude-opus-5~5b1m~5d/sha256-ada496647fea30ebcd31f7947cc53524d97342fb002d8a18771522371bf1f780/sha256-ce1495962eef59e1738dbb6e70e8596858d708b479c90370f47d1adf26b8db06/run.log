t\n202\t        if (hdr1 & 0x8) != 0 {\n203\t            gr_count *= 2;\n204\t            main_data_begin = get_bits(bs, 9) as c_int;\n205\t            scfsi = get_bits(bs, 7 + gr_count);\n206\t        } else {\n207\t            main_data_begin =\n208\t                get_bits(bs, 8 + gr_count).wrapping_shr(gr_count as u32) as c_int;\n209\t        }\n210\t\n211\t        let mut gr: *mut L3_gr_info_t = gr;\n212\t        loop {\n213\t            if (hdr3 & 0xC0) == 0xC0 {\n214\t                scfsi <<= 4;\n215\t            }\n216\t            (*gr).part_23_length = get_bits(bs, 12) as u16;\n217\t            part_23_sum = part_23_sum.wrapping_add((*gr).part_23_length as c_int);\n218\t            (*gr).big_values = get_bits(bs, 9) as u16;\n219\t            if (*gr).big_values > 288 {\n220\t                return -1;\n221\t            }\n222\t            (*gr).global_gain = get_bits(bs, 8) as u8;\n223\t            (*gr).scalefac_compress =\n224\t                get_bits(bs, if (hdr1 & 0x8) != 0 { 4 } else { 9 }) as u16;\n225\t            (*gr).sfbtab = tables_base.add(OFF_LONG + (sr_idx as usize) * 23);\n226\t            (*gr).n_long_sfb = 22;\n227\t            (*gr).n_short_sfb = 0;\n228\t            if get_bits(bs, 1) != 0 {\n229\t                (*gr).block_type = get_bits(bs, 2) as u8;\n230\t                if (*gr).block_type == 0 {\n231\t                    return -1;\n232\t                }\n233\t                (*gr).mixed_block_flag = get_bits(bs, 1) as u8;\n234\t                (*gr).region_count[0] = 7;\n235\t                (*gr).region_count[1] = 255;\n236\t                if (*gr).block_type == 2 {\n237\t                    scfsi &= 0x0F0F;\n238\t                    if (*gr).mixed_block_flag == 0 {\n239\t                        (*gr).region_count[0] = 8;\n240\t                        (*gr).sfbtab =\n241\t                            tables_base.add(OFF_SHORT + (sr_idx as usize) * 40);\n242\t                        (*gr).n_long_sfb = 0;\n243\t               