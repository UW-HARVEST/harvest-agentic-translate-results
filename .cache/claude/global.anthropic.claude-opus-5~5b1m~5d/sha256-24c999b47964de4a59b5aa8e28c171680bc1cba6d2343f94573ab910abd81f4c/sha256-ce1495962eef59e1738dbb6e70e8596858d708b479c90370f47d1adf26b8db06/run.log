{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_4aonwtblepn7crmqui7ju2if5wivwulatsy25c2e7hidui75lxbq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01AT4zUj3kogneRN17ae89mf","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-XWA1IC/translation/tests/probe_ub.rs","content":"//! Scratch probe (not part of the checklist): find out empirically what the C\n//! does for the two undefined-behaviour corners so that ERRORS.md rows E16/E17\n//! and E54..E57 can be written honestly.\n//!\n//! Run with `cargo test --release --test probe_ub -- --nocapture`.\n\nmod common;\nuse common::*;\n\n#[repr(C)]\n#[derive(Copy, Clone)]\nstruct PaddedCache {\n    cache: C2GJKCache,\n    pad: [u32; 12],\n}\n\n#[test]\nfn probe_invalid_type() {\n    let (c, r): (FnGJK, FnGJK) = sym(b\"c2GJK\");\n    let circle = ShapeBlob::circle(C2Circle {\n        p: C2v { x: 1.0, y: 2.0 },\n        r: 3.0,\n    });\n    for ty in [3u32, 4, 0xFFFF_FFFF, 100] {\n        for (ta, tb) in [(ty, C2_TYPE_CIRCLE), (C2_TYPE_CIRCLE, ty), (ty, ty)] {\n            let mut oa = C2v { x: -1.0, y: -1.0 };\n            let mut ob = oa;\n            let mut it = -1i32;\n            let dc = unsafe {\n                c(\n                    circle.as_ptr(),\n                    ta,\n                    std::ptr::null(),\n                    circle.as_ptr(),\n                    tb,\n                    std::ptr::null(),\n                    &mut oa,\n                    &mut ob,\n                    1,\n                    &mut it,\n                    std::ptr::null_mut(),\n                )\n            };\n            let (ca, cb, ci) = (oa, ob, it);\n            let dr = unsafe {\n                r(\n                    circle.as_ptr(),\n                    ta,\n                    std::ptr::null(),\n                    circle.as_ptr(),\n                    tb,\n                    std::ptr::null(),\n                    &mut oa,\n                    &mut ob,\n                    1,\n                    &mut it,\n                    std::ptr::null_mut(),\n                )\n            };\n            println!(\n                \"ty={ty:#x} ta={ta} tb={tb}: C dist={} a={} b={} it={ci} | Rust dist={} a={} b={} it={it}  MATCH={}\",\n                fmt_f32(dc),\n                fmt_v(ca),\n                fmt_v(cb),\n                fmt_f32(dr),\n                fmt_v(oa),\n                fmt_v(ob),\n                f32_same(dc, dr) && v_same(ca, oa) && v_same(cb, ob) && ci == it\n            );\n        }\n    }\n}\n\n#[test]\nfn probe_cache_count_out_of_range() {\n    let (c, r): (FnGJK, FnGJK) = sym(b\"c2GJK\");\n    let a = ShapeBlob::aabb(C2AABB {\n        min: C2v { x: -1.0, y: -1.0 },\n        max: C2v { x: 1.0, y: 1.0 },\n    });\n    let b = ShapeBlob::capsule(C2Capsule {\n        a: C2v { x: 5.0, y: 0.0 },\n        b: C2v { x: 8.0, y: 3.0 },\n        r: 1.0,\n    });\n    for count in [-1i32, 4, 5, 6, 7, i32::MIN] {\n        let base = PaddedCache {\n            cache: C2GJKCache {\n                metric: 1.5,\n                count,\n                iA: [0, 1, 2],\n                iB: [0, 1, 0],\n                div: 2.0,\n            },\n            pad: [0x0102_0304; 12],\n        };\n        let mut cc = base;\n        let mut rc = base;\n        let mut oa = C2v::default();\n        let mut ob = C2v::default();\n        let mut it = -1i32;\n        let dc = unsafe {\n            c(\n                a.as_ptr(),\n                C2_TYPE_AABB,\n                std::ptr::null(),\n                b.as_ptr(),\n                C2_TYPE_CAPSULE,\n                std::ptr::null(),\n                &mut oa,\n                &mut ob,\n                1,\n                &mut it,\n                &mut cc.cache,\n            )\n        };\n        let (ca, cb, ci) = (oa, ob, it);\n        let dr = unsafe {\n            r(\n                a.as_ptr(),\n                C2_TYPE_AABB,\n                std::ptr::null(),\n                b.as_ptr(),\n                C2_TYPE_CAPSULE,\n                std::ptr::null(),\n                &mut oa,\n                &mut ob,\n                1,\n                &mut it,\n                &mut rc.cache,\n            )\n        };\n        println!(\n            \"count={count}: MATCH_ret={} MATCH_a={} MATCH_b={} MATCH_it={} MATCH_cachebytes={}\\n   C dist={} cache={} pad={:x?}\\n   R dist={} cache={} pad={:x?}\",\n            f32_same(dc, dr),\n            v_same(ca, oa),\n            v_same(cb, ob),\n            ci == it,\n            raw_same(&cc, &rc),\n            fmt_f32(dc),\n            fmt_cache(&cc.cache),\n            cc.pad,\n            fmt_f32(dr),\n            fmt_cache(&rc.cache),\n            rc.pad,\n        );\n    }\n}\n\n#[test]\nfn probe_cache_index_out_of_range() {\n    let (c, r): (FnGJK, FnGJK) = sym(b\"c2GJK\");\n    let a = ShapeBlob::circle(C2Circle {\n        p: C2v { x: 0.0, y: 0.0 },\n        r: 1.0,\n    });\n    let b = ShapeBlob::capsule(C2Capsule {\n        a: C2v { x: 5.0, y: 0.0 },\n        b: C2v { x: 8.0, y: 3.0 },\n        r: 1.0,\n    });\n    for idx in [1i32, 2, 4, 7, 8, 20, -1] {\n        let base = C2GJKCache {\n            metric: 1.5,\n            count: 1,\n            iA: [idx, 0, 0],\n            iB: [idx, 0, 0],\n            div: 2.0,\n        };\n        let mut cc = base;\n        let mut rc = base;\n        let mut oa = C2v::default();\n        let mut ob = C2v::default();\n        let mut it = -1i32;\n        let dc = unsafe {\n            c(\n                a.as_ptr(),\n                C2_TYPE_CIRCLE,\n                std::ptr::null(),\n                b.as_ptr(),\n                C2_TYPE_CAPSULE,\n                std::ptr::null(),\n                &mut oa,\n                &mut ob,\n                1,\n                &mut it,\n                &mut cc,\n            )\n        };\n        let (ca, cb, ci) = (oa, ob, it);\n        let dr = unsafe {\n            r(\n                a.as_ptr(),\n                C2_TYPE_CIRCLE,\n                std::ptr::null(),\n                b.as_ptr(),\n                C2_TYPE_CAPSULE,\n                std::ptr::null(),\n                &mut oa,\n                &mut ob,\n                1,\n                &mut it,\n                &mut rc,\n            )\n        };\n        println!(\n            \"idx={idx}: MATCH_all={} C dist={} cache={} | R dist={} cache={}\",\n            f32_same(dc, dr) && v_same(ca, oa) && v_same(cb, ob) && ci == it && raw_same(&cc, &rc),\n            fmt_f32(dc),\n            fmt_cache(&cc),\n            fmt_f32(dr),\n            fmt_cache(&rc),\n        );\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":424,"cache_read_input_tokens":200945,"cache_creation":{"ephemeral_5m_input_tokens":424,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"2b1f148d-ef0b-41b5-bb8a-00c30dfd166e","uuid":"1b5bc5ae-2493-4abe-89cf-98b4307e9a3e","timestamp":"2026-08-27T09:40:32.055Z"}
