t_v(cb, ob, \"E43 probe b\");\n}\n","structuredPatch":[{"oldStart":1,"oldLines":219,"newStart":1,"newLines":171,"lines":["-//! Scratch probe (not part of the checklist): find out empirically what the C","-//! does for the two undefined-behaviour corners so that ERRORS.md rows E16/E17","-//! and E54..E57 can be written honestly.","+//! Scratch probes used while deriving ERRORS.md (kept so the findings can be","+//! re-checked).  These print information and assert only what is reproducible."," //!"," //! Run with `cargo test --release --test probe_ub -- --nocapture`."," "," mod common;"," use common::*;"," ","-#[repr(C)]","-#[derive(Copy, Clone)]","-struct PaddedCache {","-    cache: C2GJKCache,","-    pad: [u32; 12],","-}","-","+/// Search for a configuration that reaches the `iter == 20` cap in `c2GJK`","+/// (ERRORS.md E46) and for one that reaches the `a == b => dist = 0` re-check","+/// after the radius shrink (E43)."," #[test]","-fn probe_invalid_type() {","+fn probe_loop_and_radius_coverage() {","     let (c, r): (FnGJK, FnGJK) = sym(b\"c2GJK\");","-    let circle = ShapeBlob::circle(C2Circle {","-        p: C2v { x: 1.0, y: 2.0 },","-        r: 3.0,","-    });","-    for ty in [3u32, 4, 0xFFFF_FFFF, 100] {","-        for (ta, tb) in [(ty, C2_TYPE_CIRCLE), (C2_TYPE_CIRCLE, ty), (ty, ty)] {","-            let mut oa = C2v { x: -1.0, y: -1.0 };","-            let mut ob = oa;","-            let mut it = -1i32;","-            let dc = unsafe {","-                c(","-                    circle.as_ptr(),","-                    ta,","-                    std::ptr::null(),","-                    circle.as_ptr(),","-                    tb,","-                    std::ptr::null(),","-                    &mut oa,","-                    &mut ob,","-                    1,","-                    &mut it,","-                    std::ptr::null_mut(),","-                )","-            };","-            let (ca, cb, ci) = (oa, ob, it);","-            let dr = unsafe {","-  