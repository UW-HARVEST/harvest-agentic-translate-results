,"+            ));","+        }","+        if f32_same(dc, 0.0) && v_same(ca, cb) && ca.x.is_finite() {","+            forced_zero += 1;","+        }","     }","+    println!(\"max iterations found = {max_it}  ({best:?})\");","+    println!(\"dist==0 with a==b (finite): {forced_zero}\");"," }"," ","+/// ERRORS.md E43: after the radius shrink the C re-tests `a.x == b.x &&","+/// a.y == b.y` and forces `dist` to 0.  Construct that exactly: with","+/// `rA = FLT_MAX` and `rB = -FLT_MAX` the sum is `0` (so `dist > rA + rB`","+/// holds), and both witness points saturate to `FLT_MAX`."," #[test]","-fn probe_cache_index_out_of_range() {","+fn probe_forced_zero_after_shrink() {","     let (c, r): (FnGJK, FnGJK) = sym(b\"c2GJK\");","     let a = ShapeBlob::circle(C2Circle {","         p: C2v { x: 0.0, y: 0.0 },","-        r: 1.0,","+        r: FLT_MAX,","     });","-    let b = ShapeBlob::capsule(C2Capsule {","-        a: C2v { x: 5.0, y: 0.0 },","-        b: C2v { x: 8.0, y: 3.0 },","-        r: 1.0,","+    let b = ShapeBlob::circle(C2Circle {","+        p: C2v { x: 100.0, y: 0.0 },","+        r: -FLT_MAX,","     });","-    for idx in [1i32, 2, 4, 7, 8, 20, -1] {","-        let base = C2GJKCache {","-            metric: 1.5,","-            count: 1,","-            iA: [idx, 0, 0],","-            iB: [idx, 0, 0],","-            div: 2.0,","-        };","-        let mut cc = base;","-        let mut rc = base;","-        let mut oa = C2v::default();","-        let mut ob = C2v::default();","-        let mut it = -1i32;","-        let dc = unsafe {","-            c(","-                a.as_ptr(),","-                C2_TYPE_CIRCLE,","-                std::ptr::null(),","-                b.as_ptr(),","-                C2_TYPE_CAPSULE,","-                std::ptr::null(),","-                &mut oa,","-                &mut ob,","-                1,","-                &mut it,","-                &mut cc,","-            )","-        };","-        let (ca, cb, ci) = (oa, ob, it);","-        let dr = unsafe {","-            r(","-                a.as_ptr(),","-                C2_TYPE_CIRCLE,","-                std::ptr::null(),","-                b.as_ptr(),","-                C2_TYPE_CAPSULE,","-                std::ptr::null(),","-                &mut oa,","-                &mut ob,","-                1,","-                &mut it,","-                &mut rc,","-            )","-        };","-        println!(","-            \"idx={idx}: MATCH_all={} C dist={} cache={} | R dist={} cache={}\",","-            f32_same(dc, dr) && v_same(ca, oa) && v_same(cb, ob) && ci == it && raw_same(&cc, &rc),","-            fmt_f32(dc),","-            fmt_cache(&cc),","-            fmt_f32(dr),","-            fmt_cache(&rc),","-        );","-    }","+    let mut oa = C2v::default();","+    let mut ob = C2v::default();","+    let mut it = -1i32;","+    let dc = unsafe {","+        c(","+            a.as_ptr(),","+            C2_TYPE_CIRCLE,","+            std::ptr::null(),","+            b.as_ptr(),","+            C2_TYPE_CIRCLE,","+            std::ptr::null(),","+            &mut oa,","+            &mut ob,","+            1,","+            &mut it,","+            std::ptr::null_mut(),","+        )","+    };","+    let (ca, cb) = (oa, ob);","+    let dr = unsafe {","+        r(","+            a.as_ptr(),","+            C2_TYPE_CIRCLE,","+            std::ptr::null(),","+            b.as_ptr(),","+            C2_TYPE_CIRCLE,","+            std::ptr::null(),","+            &mut oa,","+            &mut ob,","+            1,","+            &mut it,","+            std::ptr::null_mut(),","+        )","+    };","+    println!(","+        \"E43 probe: C dist={} a={} b={} | Rust dist={} a={} b={}\",","+        fmt_f32(dc),","+        fmt_v(ca),","+        fmt_v(cb),","+        fmt_f32(dr),","+        fmt_v(oa),","+        fmt_v(ob)","+    );","+    assert_f32(dc, dr, \"E43 probe\");","+    assert_v(ca, oa, \"E43 probe a\");","+    assert_v(cb, ob, \"E43 probe b\");"," }"]}],"originalFile":"//! Scratch probe (not part of the checklist): find out empirically what the C\n//! does for the two undefined-behaviour corners so that ERRORS.md rows E16/E17\n//! and E54..E57 can be written honestly.\n//!\n//! Run with `cargo test --release --test probe_ub -- --nocapture`.\n\nmod common;\nuse common::*;\n\n#[repr(C)]\n#[derive(Copy, Clone)]\nstruct PaddedCache {\n    cache: C2GJKCache,\n    pad: [u32; 12],\n}\n\n#[test]\nfn probe_invalid_type() {\n    let (c, r): (FnGJK, FnGJK) = sym(b\"c2GJK\");\n    let circle = ShapeBlob::circle(C2Circle {\n        p: C2v { x: 1.0, y: 2.0 },\n        r: 3.0,\n    });\n    for ty in [3u32, 4, 0xFFFF_FFFF, 100] {\n        for (ta, tb) in [(ty, C2_TYPE_CIRCLE), (C2_TYPE_CIRCLE, ty), (ty, ty)] {\n            let mut oa = C2v { x: -1.0, y: -1.0 };\n            let mut ob = oa;\n            let mut it = -1i32;\n            let dc = unsafe {\n                c(\n                    circle.as_ptr(),\n                    ta,\n                    std::ptr::null(),\n                    circle.as_ptr(),\n                    tb,\n                    std::ptr::null(),\n                    &mut oa,\n                    &mut ob,\n                    1,\n                    &mut it,\n                    std::ptr::null_mut(),\n                )\n            };\n            let (ca, cb, ci) = (oa, ob, it);\n            let dr = unsafe {\n                r(\n                    circle.as_ptr(),\n                    ta,\n                    std::ptr::null(),\n                    circle.as_ptr(),\n                    tb,\n                    std::ptr::null(),\n                    &mut oa,\n                    &mut ob,\n                    1,\n                    &mut it,\n                    std::ptr::null_mut(),\n                )\n            };\n            println!(\n                \"ty={ty:#x} ta={ta} tb={tb}: C dist={} a={} b={} it={ci} | Rust dist={} a={} b={} it={it}  MATCH={}\",\n                fmt_f32(dc),\n                fmt_v(ca),\n                fmt_v(cb),\n                fmt_f32(dr),\n                fmt_v(oa),\n                fmt_v(ob),\n                f32_same(dc, dr) && v_same(ca, oa) && v_same(cb, ob) && ci == it\n            );\n        }\n    }\n}\n\n#[test]\nfn probe_cache_count_out_of_range() {\n    let (c, r): (FnGJK, FnGJK) = sym(b\"c2GJK\");\n    let a = ShapeBlob::aabb(C2AABB {\n        min: C2v { x: -1.0, y: -1.0 },\n        max: C2v { x: 1.0, y: 1.0 },\n    });\n    let b = ShapeBlob::capsule(C2Capsule {\n        a: C2v { x: 5.0, y: 0.0 },\n        b: C2v { x: 8.0, y: 3.0 },\n        r: 1.0,\n    });\n    // `cache->iA[3]` aliases `iB[0]`, `iB[3]` aliases `div`, `iA[4]` aliases\n    // `iB[1]`, `iB[4]` is one word PAST the struct.  Pick values so every one of\n    // those aliased reads is a small in-range vertex index, otherwise the C\n    // simply segfaults on an out-of-bounds `c2Proxy::verts[]` read.\n    for count in [-1i32, 4, 5, 6, 7, i32::MIN] {\n        let base = PaddedCache {\n            cache: C2GJKCache {\n                metric: 1.5,\n                count,\n                iA: [0, 1, 2],\n                iB: [0, 1, 0],\n                div: f32::from_bits(1),\n            },\n            pad: [1u32; 12],\n        };\n        let mut cc = base;\n        let mut rc = base;\n        let mut oa = C2v::default();\n        let mut ob = C2v::default();\n        let mut it = -1i32;\n        let dc = unsafe {\n            c(\n                a.as_ptr(),\n                C2_TYPE_AABB,\n                std::ptr::null(),\n                b.as_ptr(),\n                C2_TYPE_CAPSULE,\n                std::ptr::null(),\n                &mut oa,\n                &mut ob,\n                1,\n                &mut it,\n                &mut cc.cache,\n            )\n        };\n        let (ca, cb, ci) = (oa, ob, it);\n        let dr = unsafe {\n            r(\n                a.as_ptr(),\n                C2_TYPE_AABB,\n                std::ptr::null(),\n                b.as_ptr(),\n                C2_TYPE_CAPSULE,\n                std::ptr::null(),\n                &mut oa,\n                &mut ob,\n                1,\n                &mut it,\n                &mut rc.cache,\n            )\n        };\n        println!(\n            \"count={count}: MATCH_ret={} MATCH_a={} MATCH_b={} MATCH_it={} MATCH_cachebytes={}\\n   C dist={} cache={} pad={:x?}\\n   R dist={} cache={} pad={:x?}\",\n            f32_same(dc, dr),\n            v_same(ca, oa),\n            v_same(cb, ob),\n            ci == it,\n            raw_same(&cc, &rc),\n            fmt_f32(dc),\n            fmt_cache(&cc.cache),\n            cc.pad,\n            fmt_f32(dr),\n            fmt_cache(&rc.cache),\n            rc.pad,\n        );\n    }\n}\n\n#[test]\nfn probe_cache_index_out_of_range() {\n    let (c, r): (FnGJK, FnGJK) = sym(b\"c2GJK\");\n    let a = ShapeBlob::circle(C2Circle {\n        p: C2v { x: 0.0, y: 0.0 },\n        r: 1.0,\n    });\n    let b = ShapeBlob::capsule(C2Capsule {\n        a: C2v { x: 5.0, y: 0.0 },\n        b: C2v { x: 8.0, y: 3.0 },\n        r: 1.0,\n    });\n    for idx in [1i32, 2, 4, 7, 8, 20, -1] {\n        let base = C2GJKCache {\n            metric: 1.5,\n            count: 1,\n            iA: [idx, 0, 0],\n            iB: [idx, 0, 0],\n            div: 2.0,\n        };\n        let mut cc = base;\n        let mut rc = base;\n        let mut oa = C2v::default();\n        let mut ob = C2v::default();\n        let mut it = -1i32;\n        let dc = unsafe {\n            c(\n                a.as_ptr(),\n                C2_TYPE_CIRCLE,\n                std::ptr::null(),\n                b.as_ptr(),\n                C2_TYPE_CAPSULE,\n                std::ptr::null(),\n                &mut oa,\n                &mut ob,\n                1,\n                &mut it,\n                &mut cc,\n            )\n        };\n        let (ca, cb, ci) = (oa, ob, it);\n        let dr = unsafe {\n            r(\n                a.as_ptr(),\n                C2_TYPE_CIRCLE,\n                std::ptr::null(),\n                b.as_ptr(),\n                C2_TYPE_CAPSULE,\n                std::ptr::null(),\n                &mut oa,\n                &mut ob,\n                1,\n                &mut it,\n                &mut rc,\n            )\n        };\n        println!(\n            \"idx={idx}: MATCH_all={} C dist={} cache={} | R dist={} cache={}\",\n            f32_same(dc, dr) && v_same(ca, oa) && v_same(cb, ob) && ci == it && raw_same(&cc, &rc),\n            fmt_f32(dc),\n            fmt_cache(&cc),\n            fmt_f32(dr),\n            fmt_cache(&rc),\n        );\n    }\n}\n","userModified":false}}
