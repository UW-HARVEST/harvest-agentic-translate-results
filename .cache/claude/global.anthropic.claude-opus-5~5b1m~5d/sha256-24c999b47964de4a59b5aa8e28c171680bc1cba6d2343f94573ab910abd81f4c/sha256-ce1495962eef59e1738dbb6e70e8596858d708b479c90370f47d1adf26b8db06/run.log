he: C2GJKCache,\n    pad: [u32; 12],\n}\n\n#[test]\nfn probe_invalid_type() {\n    let (c, r): (FnGJK, FnGJK) = sym(b\"c2GJK\");\n    let circle = ShapeBlob::circle(C2Circle {\n        p: C2v { x: 1.0, y: 2.0 },\n        r: 3.0,\n    });\n    for ty in [3u32, 4, 0xFFFF_FFFF, 100] {\n        for (ta, tb) in [(ty, C2_TYPE_CIRCLE), (C2_TYPE_CIRCLE, ty), (ty, ty)] {\n            let mut oa = C2v { x: -1.0, y: -1.0 };\n            let mut ob = oa;\n            let mut it = -1i32;\n            let dc = unsafe {\n                c(\n                    circle.as_ptr(),\n                    ta,\n                    std::ptr::null(),\n                    circle.as_ptr(),\n                    tb,\n                    std::ptr::null(),\n                    &mut oa,\n                    &mut ob,\n                    1,\n                    &mut it,\n                    std::ptr::null_mut(),\n                )\n            };\n            let (ca, cb, ci) = (oa, ob, it);\n            let dr = unsafe {\n                r(\n                    circle.as_ptr(),\n                    ta,\n                    std::ptr::null(),\n                    circle.as_ptr(),\n                    tb,\n                    std::ptr::null(),\n                    &mut oa,\n                    &mut ob,\n                    1,\n                    &mut it,\n                    std::ptr::null_mut(),\n                )\n            };\n            println!(\n                \"ty={ty:#x} ta={ta} tb={tb}: C dist={} a={} b={} it={ci} | Rust dist={} a={} b={} it={it}  MATCH={}\",\n                fmt_f32(dc),\n                fmt_v(ca),\n                fmt_v(cb),\n                fmt_f32(dr),\n                fmt_v(oa),\n                fmt_v(ob),\n                f32_same(dc, dr) && v_same(ca, oa) && v_same(cb, ob) && ci == it\n            );\n        }\n    }\n}\n\n#[test]\nfn probe_cache_count_out_of_range() {\n    let (c, r): (FnGJK, FnGJK) = sym(b\"c2GJK\");\n    let a = ShapeBlob::aabb(C2AABB {\n        min: C2v { x: -1.0, y: -1.0 },\n        max: C2v { x: 1.0, y: 1.0 },\n    });\n    let b = ShapeBlob::capsule(C2Capsule {\n        a: C2v { x: 5.0, y: 0.0 },\n        b: C2v { x: 8.0, y: 3.0 },\n        r: 1.0,\n    });\n    for count in [-1i32, 4, 5, 6, 7, i32::MIN] {\n        let base = PaddedCache {\n            cache: C2GJKCache {\n                metric: 1.5,\n                count,\n                iA: [0, 1, 2],\n                iB: [0, 1, 0],\n                div: 2.0,\n            },\n            pad: [0x0102_0304; 12],\n        };\n        let mut cc = base;\n        let mut rc = base;\n        let mut oa = C2v::default();\n        let mut ob = C2v::default();\n        let mut it = -1i32;\n        let dc = unsafe {\n            c(\n                a.as_ptr(),\n                C2_TYPE_AABB,\n                std::ptr::null(),\n                b.as_ptr(),\n                C2_TYPE_CAPSULE,\n                std::ptr::null(),\n                &mut oa,\n                &mut ob,\n                1,\n                &mut it,\n                &mut cc.cache,\n            )\n        };\n        let (ca, cb, ci) = (oa, ob, it);\n        let dr = unsafe {\n            r(\n                a.as_ptr(),\n                C2_TYPE_AABB,\n                std::ptr::null(),\n                b.as_ptr(),\n                C2_TYPE_CAPSULE,\n                std::ptr::null(),\n                &mut oa,\n                &mut ob,\n                1,\n                &mut it,\n                &mut rc.cache,\n            )\n        };\n        println!(\n            \"count={count}: MATCH_ret={} MATCH_a={} MATCH_b={} MATCH_it={} MATCH_cachebytes={}\\n   C dist={} cache={} pad={:x?}\\n   R dist={} cache={} pad={:x?}\",\n            f32_same(dc, dr),\n            v_same(ca, oa),\n            v_same(cb, ob),\n            ci == it,\n            raw_same(&cc, &rc),\n            fmt_f32(dc),\n            fmt_cache(&cc.cache),\n            cc.pad,\n            fmt_f32(dr),\n            fmt_cache(&rc.cache),\n            rc.pad,\n        );\n    }\n}\n\n#[test]\nfn probe_cache_index_out_of_range() {\n    let (c, r): (FnGJK, FnGJK) = sym(b\"c2GJK\");\n    let a = ShapeBlob::circle(C2Circle {\n        p: C2v { x: 0.0, y: 0.0 },\n        r: 1.0,\n    });\n    let b = ShapeBlob::capsule(C2Capsule {\n        a: C2v { x: 5.0, y: 0.0 },\n        b: C2v { x: 8.0, y: 3.0 },\n        r: 1.0,\n    });\n    for idx in [1i32, 2, 4, 7, 8, 20, -1] {\n        let base = C2GJKCache {\n            metric: 1.5,\n            count: 1,\n            iA: [idx, 0, 0],\n            iB: [idx, 0, 0],\n            div: 2.0,\n        };\n        let mut cc = base;\n        let mut rc = base;\n        let mut oa = C2v::default();\n        let mut ob = C2v::default();\n        let mut it = -1i32;\n        let dc = unsafe {\n            c(\n                a.as_ptr(),\n                C2_TYPE_CIRCLE,\n                std::ptr::null(),\n                b.as_ptr(),\n                C2_TYPE_CAPSULE,\n                std::ptr::null(),\n                &mut oa,\n                &mut ob,\n                1,\n                &mut it,\n                &mut cc,\n            )\n        };\n        let (ca, cb, ci) = (oa, ob, it);\n        let dr = unsafe {\n            r(\n                a.as_ptr(),\n                C2_TYPE_CIRCLE,\n                std::ptr::null(),\n                b.as_ptr(),\n                C2_TYPE_CAPSULE,\n                std::ptr::null(),\n                &mut oa,\n                &mut ob,\n                1,\n                &mut it,\n                &mut rc,\n            )\n        };\n        println!(\n            \"idx={idx}: MATCH_all={} C dist={} cache={} | R dist={} cache={}\",\n            f32_same(dc, dr) && v_same(ca, oa) && v_same(cb, ob) && ci == it && raw_same(&cc, &rc),\n            fmt_f32(dc),\n            fmt_cache(&cc),\n            fmt_f32(dr),\n            fmt_cache(&rc),\n        );\n    }\n}\n","structuredPatch":[{"oldStart":83,"oldLines":6,"newStart":83,"newLines":10,"lines":["         b: C2v { x: 8.0, y: 3.0 },","         r: 1.0,","     });","+    // `cache->iA[3]` aliases `iB[0]`, `iB[3]` aliases `div`, `iA[4]` aliases","+    // `iB[1]`, `iB[4]` is one word PAST the struct.  Pick values so every one of","+    // those aliased reads is a small in-range vertex index, otherwise the C","+    // simply segfaults on an out-of-bounds `c2Proxy::verts[]` read.","     for count in [-1i32, 4, 5, 6, 7, i32::MIN] {","         let base = PaddedCache {","             cache: C2GJKCache {"]},{"oldStart":90,"oldLines":9,"newStart":94,"newLines":9,"lines":["                 count,","                 iA: [0, 1, 2],","                 iB: [0, 1, 0],","-                div: 2.0,","+                div: f32::from_bits(1),","             },","-            pad: [0x0102_0304; 12],","+            pad: [1u32; 12],","         };","         let mut cc = base;","         let mut rc = base;"]}],"userModified":false,"replaceAll":false}}
