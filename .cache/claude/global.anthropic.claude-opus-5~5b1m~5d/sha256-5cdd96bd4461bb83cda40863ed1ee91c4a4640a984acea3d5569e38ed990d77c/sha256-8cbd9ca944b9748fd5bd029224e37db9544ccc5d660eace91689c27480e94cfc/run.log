{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_017i1cEikEkYi21qCBaBFj1U","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/` (stb_ds.h based dynamic array /\n2\t//! hash map implementation plus the small `strkey` / `arr_ins` helpers).\n3\t//!\n4\t//! The translation is byte-for-byte behaviour compatible with the C original:\n5\t//!\n6\t//! * every memory block keeps the exact same layout (the public C header macros\n7\t//!   poke directly at `stbds_array_header`, so the header must stay 32 bytes with\n8\t//!   the same field order),\n9\t//! * every allocation goes through libc `realloc`/`free` so that blocks created\n10\t//!   here can be released by the C macros (`arrfree`, ...) and vice versa,\n11\t//! * all integer arithmetic reproduces the C semantics exactly, including the\n12\t//!   sign-extension quirks of `d[3] << 24` in the siphash loader, the\n13\t//!   `hash ^= hash ^ ROTR(...)` no-ops and the wrap-around behaviour.\n14\t//!\n15\t//! No bugs of the original were fixed.\n16\t\n17\t#![allow(non_camel_case_types)]\n18\t#![allow(non_upper_case_globals)]\n19\t#![allow(clippy::missing_safety_doc)]\n20\t\n21\tuse core::ffi::{c_char, c_int, c_void};\n22\tuse core::mem::size_of;\n23\tuse core::ptr;\n24\t\n25\t// ---------------------------------------------------------------------------\n26\t// libc bindings\n27\t// ---------------------------------------------------------------------------\n28\t\n29\tunsafe extern \"C\" {\n30\t    fn realloc(p: *mut c_void, size: usize) -> *mut c_void;\n31\t    fn free(p: *mut c_void);\n32\t    fn memmove(dst: *mut c_void, src: *const c_void, n: usize) -> *mut c_void;\n33\t    fn memcpy(dst: *mut c_void, src: *const c_void, n: usize) -> *mut c_void;\n34\t    fn memcmp(a: *const c_void, b: *const c_void, n: usize) -> c_int;\n35\t    fn strcmp(a: *const c_char, b: *const c_char) -> c_int;\n36\t    fn strlen(s: *const c_char) -> usize;\n37\t}\n38\t\n39\t/// `STBDS_REALLOC(c,p,s)` -> `realloc(p,s)`\n40\t#[inline(always)]\n41\tunsafe fn stbds_realloc(p: *mut c_void, s: usize) -> *mut c_void {\n42\t    unsafe { realloc(p, s) }\n43\t}\n44\t\n45\t/// `STBDS_FREE(c,p)` -> `free(p)`\n46\t#[inline(always)]\n47\tunsafe fn stbds_free(p: *mut c_void) {\n48\t    unsafe { free(p) }\n49\t}\n50\t\n51\t#[inline(always)]\n52\tunsafe fn c_memset(dst: *mut c_void, val: u8, n: usize) {\n53\t    unsafe { ptr::write_bytes(dst as *mut u8, val, n) }\n54\t}\n55\t\n56\t// ---------------------------------------------------------------------------\n57\t// Data layout (must match the C structures bit for bit)\n58\t// ---------------------------------------------------------------------------\n59\t\n60\t#[repr(C)]\n61\tstruct stbds_array_header {\n62\t    length: usize,\n63\t    capacity: usize,\n64\t    hash_table: *mut c_void,\n65\t    temp: isize,\n66\t}\n67\t\n68\t#[repr(C)]\n69\tstruct stbds_string_block {\n70\t    next: *mut stbds_string_block,\n71\t    storage: [c_char; 8],\n72\t}\n73\t\n74\t#[repr(C)]\n75\t#[derive(Clone, Copy)]\n76\tpub struct stbds_string_arena {\n77\t    storage: *mut stbds_string_block,\n78\t    remaining: usize,\n79\t    block: u8,\n80\t    mode: u8,\n81\t}\n82\t\n83\tconst STBDS_BUCKET_LENGTH: usize = 8;\n84\tconst STBDS_BUCKET_SHIFT: usize = 3;\n85\tconst STBDS_BUCKET_MASK: usize = STBDS_BUCKET_LENGTH - 1;\n86\tconst STBDS_CACHE_LINE_SIZE: usize = 64;\n87\t\n88\t#[repr(C)]\n89\tstruct stbds_hash_bucket {\n90\t    hash: [usize; STBDS_BUCKET_LENGTH],\n91\t    index: [isize; STBDS_BUCKET_LENGTH],\n92\t}\n93\t\n94\t#[repr(C)]\n95\tstruct stbds_hash_index {\n96\t    temp_key: *mut c_char,\n97\t    slot_count: usize,\n98\t    used_count: usize,\n99\t    used_count_threshold: usize,\n100\t    used_count_shrink_threshold: usize,\n101\t    tombstone_count: usize,\n102\t    tombstone_count_threshold: usize,\n103\t    seed: usize,\n104\t    slot_count_log2: usize,\n105\t    string: stbds_string_arena,\n106\t    storage: *mut stbds_hash_bucket,\n107\t}\n108\t\n109\tconst STBDS_INDEX_EMPTY: isize = -1;\n110\tconst STBDS_INDEX_DELETED: isize = -2;\n111\t\n112\tconst STBDS_HASH_EMPTY: usize = 0;\n113\tconst STBDS_HASH_DELETED: usize = 1;\n114\t\n115\t#[allow(dead_code)]\n116\tconst STBDS_HM_BINARY: c_int = 0;\n117\tconst STBDS_HM_STRING: c_int = 1;\n118\t\n119\tconst STBDS_SH_NONE: u8 = 0;\n120\tconst STBDS_SH_DEFAULT: u8 = 1;\n121\tconst STBDS_SH_STRDUP: u8 = 2;\n122\tconst STBDS_SH_ARENA: u8 = 3;\n123\t\n124\tconst STBDS_SIZE_T_BITS: u32 = (size_of::<usize>() * 8) as u32;\n125\t\n126\tconst HEADER_SIZE: usize = size_of::<stbds_array_header>();\n127\t\n128\t// Compile time layout checks mirroring the C struct sizes on LP64.\n129\tconst _: () = assert!(size_of::<stbds_array_header>() == 32);\n130\tconst _: () = assert!(size_of::<stbds_string_block>() == 16);\n131\tconst _: () = assert!(size_of::<stbds_string_arena>() == 24);\n132\tconst _: () = assert!(size_of::<stbds_hash_bucket>() == 128);\n133\tconst _: () = assert!(size_of::<stbds_hash_index>() == 104);\n134\tconst _: () = assert!(size_of::<usize>() == 8, \"siphash 2-4 requires a 64 bit build\");\n135\t\n136\t// ---------------------------------------------------------------------------\n137\t// pointer / accessor helpers (all plain address arithmetic, like the C macros)\n138\t// ---------------------------------------------------------------------------\n139\t\n140\t/// `stbds_header(t)` == `((stbds_array_header *) (t) - 1)`\n141\t#[inline(always)]\n142\tfn stbds_header(t: *const c_void) -> *mut stbds_array_header {\n143\t    (t as usize).wrapping_sub(HEADER_SIZE) as *mut stbds_array_header\n144\t}\n145\t\n146\t/// `(char *) p + n`\n147\t#[inline(always)]\n148\tfn byte_add(p: *const c_void, n: usize) -> *mut c_void {\n149\t    (p as usize).wrapping_add(n) as *mut c_void\n150\t}\n151\t\n152\t/// `(char *) p - n`\n153\t#[inline(always)]\n154\tfn byte_sub(p: *const c_void, n: usize) -> *mut c_void {\n155\t    (p as usize).wrapping_sub(n) as *mut c_void\n156\t}\n157\t\n158\t/// `STBDS_HASH_TO_ARR(x,elemsize)`\n159\t#[inline(always)]\n160\tfn stbds_hash_to_arr(x: *const c_void, elemsize: usize) -> *mut c_void {\n161\t    byte_sub(x, elemsize)\n162\t}\n163\t\n164\t/// `STBDS_ARR_TO_HASH(x,elemsize)`\n165\t#[inline(always)]\n166\tfn stbds_arr_to_hash(x: *const c_void, elemsize: usize) -> *mut c_void {\n167\t    byte_add(x, elemsize)\n168\t}\n169\t\n170\t/// `stbds_arrlen(a)`\n171\t#[inline(always)]\n172\tunsafe fn stbds_arrlen(a: *const c_void) -> isize {\n173\t    if !a.is_null() {\n174\t        unsafe { (*stbds_header(a)).length as isize }\n175\t    } else {\n176\t        0\n177\t    }\n178\t}\n179\t\n180\t/// `stbds_arrcap(a)`\n181\t#[inline(always)]\n182\tunsafe fn stbds_arrcap(a: *const c_void) -> usize {\n183\t    if !a.is_null() {\n184\t        unsafe { (*stbds_header(a)).capacity }\n185\t    } else {\n186\t        0\n187\t    }\n188\t}\n189\t\n190\t/// `stbds_temp(t) = v`\n191\t#[inline(always)]\n192\tunsafe fn set_stbds_temp(t: *const c_void, v: isize) {\n193\t    unsafe { (*stbds_header(t)).temp = v }\n194\t}\n195\t\n196\t/// `stbds_temp_key(t) = v`  (`*(char **) stbds_header(t)->hash_table`)\n197\t#[inline(always)]\n198\tunsafe fn set_stbds_temp_key(t: *const c_void, v: *mut c_char) {\n199\t    unsafe {\n200\t        let table = (*stbds_header(t)).hash_table as *mut *mut c_char;\n201\t        *table = v;\n202\t    }\n203\t}\n204\t\n205\t/// `stbds_hash_table(a)`\n206\t#[inline(always)]\n207\tunsafe fn stbds_hash_table(a: *const c_void) -> *mut stbds_hash_index {\n208\t    unsafe { (*stbds_header(a)).hash_table as *mut stbds_hash_index }\n209\t}\n210\t\n211\t/// `STBDS_ROTATE_LEFT(val, n)`\n212\t#[inline(always)]\n213\tfn rotate_left(val: usize, n: u32) -> usize {\n214\t    (val << n) | (val >> (STBDS_SIZE_T_BITS - n))\n215\t}\n216\t\n217\t/// `STBDS_ROTATE_RIGHT(val, n)`\n218\t#[inline(always)]\n219\tfn rotate_right(val: usize, n: u32) -> usize {\n220\t    (val >> n) | (val << (STBDS_SIZE_T_BITS - n))\n221\t}\n222\t\n223\t/// `STBDS_ALIGN_FWD(n,a)`\n224\t#[inline(always)]\n225\tfn align_fwd(n: usize, a: usize) -> usize {\n226\t    n.wrapping_add(a - 1) & !(a - 1)\n227\t}\n228\t\n229\t// ---------------------------------------------------------------------------\n230\t// dynamic array growth\n231\t// ---------------------------------------------------------------------------\n232\t\n233\t#[unsafe(no_mangle)]\n234\tpub unsafe extern \"C\" fn stbds_arrgrowf(\n235\t    a: *mut c_void,\n236\t    elemsize: usize,\n237\t    addlen: usize,\n238\t    min_cap: usize,\n239\t) -> *mut c_void {\n240\t    unsafe {\n241\t        let mut min_cap = min_cap;\n242\t        let min_len = (stbds_arrlen(a) as usize).wrapping_add(addlen);\n243\t\n244\t        if min_len > min_cap {\n245\t            min_cap = min_len;\n246\t        }\n247\t\n248\t        if min_cap <= stbds_arrcap(a) {\n249\t            return a;\n250\t        }\n251\t\n252\t        if min_cap < 2usize.wrapping_mul(stbds_arrcap(a)) {\n253\t            min_cap = 2usize.wrapping_mul(stbds_arrcap(a));\n254\t        } else if min_cap < 4 {\n255\t            min_cap = 4;\n256\t        }\n257\t\n258\t        let old = if !a.is_null() {\n259\t            stbds_header(a) as *mut c_void\n260\t        } else {\n261\t            ptr::null_mut()\n262\t        };\n263\t        let b = stbds_realloc(\n264\t            old,\n265\t            elemsize.wrapping_mul(min_cap).wrapping_add(HEADER_SIZE),\n266\t        );\n267\t        let b = byte_add(b, HEADER_SIZE);\n268\t        if a.is_null() {\n269\t            (*stbds_header(b)).length = 0;\n270\t            (*stbds_header(b)).hash_table = ptr::null_mut();\n271\t            (*stbds_header(b)).temp = 0;\n272\t        }\n273\t        (*stbds_header(b)).capacity = min_cap;\n274\t\n275\t        b\n276\t    }\n277\t}\n278\t\n279\t#[unsafe(no_mangle)]\n280\tpub unsafe extern \"C\" fn stbds_arrfreef(a: *mut c_void) {\n281\t    unsafe { stbds_free(stbds_header(a) as *mut c_void) }\n282\t}\n283\t\n284\t// ---------------------------------------------------------------------------\n285\t// hash index\n286\t// ---------------------------------------------------------------------------\n287\t\n288\tstatic mut stbds_hash_seed: usize = 0x31415926;\n289\t\n290\t#[unsafe(no_mangle)]\n291\tpub unsafe extern \"C\" fn stbds_rand_seed(seed: usize) {\n292\t    unsafe { stbds_hash_seed = seed }\n293\t}\n294\t\n295\tfn stbds_probe_position(hash: usize, slot_count: usize, _slot_log2: usize) -> usize {\n296\t    hash & (slot_count.wrapping_sub(1))\n297\t}\n298\t\n299\tfn stbds_log2(slot_count: usize) -> usize {\n300\t    let mut slot_count = slot_count;\n301\t    let mut n: usize = 0;\n302\t    while slot_count > 1 {\n303\t        slot_count >>= 1;\n304\t        n += 1;\n305\t    }\n306\t    n\n307\t}\n308\t\n309\t/// `stbds_load_32_or_64(var, temp, v32, v64_hi, v64_lo)`\n310\t#[inline(always)]\n311\tfn stbds_load_32_or_64(v32: usize, v64_hi: usize, v64_lo: usize) -> usize {\n312\t    let mut temp: usize;\n313\t    let mut var: usize;\n314\t    temp = v64_lo ^ v32;\n315\t    temp <<= 16;\n316\t    temp <<= 16;\n317\t    temp >>= 16;\n318\t    temp >>= 16;\n319\t    var = v64_hi;\n320\t    var <<= 16;\n321\t    var <<= 16;\n322\t    var ^= temp ^ v32;\n323\t    var\n324\t}\n325\t\n326\tunsafe fn stbds_make_hash_index(\n327\t    slot_count: usize,\n328\t    ot: *mut stbds_hash_index,\n329\t) -> *mut stbds_hash_index {\n330\t    unsafe {\n331\t        let t = stbds_realloc(\n332\t            ptr::null_mut(),\n333\t            (slot_count >> STBDS_BUCKET_SHIFT)\n334\t                .wrapping_mul(size_of::<stbds_hash_bucket>())\n335\t                .wrapping_add(size_of::<stbds_hash_index>())\n336\t                .wrapping_add(STBDS_CACHE_LINE_SIZE - 1),\n337\t        ) as *mut stbds_hash_index;\n338\t\n339\t        (*t).storage = align_fwd(\n340\t            (t as usize).wrapping_add(size_of::<stbds_hash_index>()),\n341\t            STBDS_CACHE_LINE_SIZE,\n342\t        ) as *mut stbds_hash_bucket;\n343\t        (*t).slot_count = slot_count;\n344\t        (*t).slot_count_log2 = stbds_log2(slot_count);\n345\t        (*t).tombstone_count = 0;\n346\t        (*t).used_count = 0;\n347\t\n348\t        (*t).used_count_threshold = slot_count.wrapping_sub(slot_count >> 2);\n349\t        (*t).tombstone_count_threshold = (slot_count >> 3).wrapping_add(slot_count >> 4);\n350\t        (*t).used_count_shrink_threshold = slot_count >> 2;\n351\t\n352\t        if slot_count <= STBDS_BUCKET_LENGTH {\n353\t            (*t).used_count_shrink_threshold = 0;\n354\t        }\n355\t        debug_assert!((*t).used_count_threshold + (*t).tombstone_count_threshold < (*t).slot_count);\n356\t\n357\t        if !ot.is_null() {\n358\t            (*t).string = (*ot).string;\n359\t            (*t).seed = (*ot).seed;\n360\t        } else {\n361\t            c_memset(\n362\t                &mut (*t).string as *mut stbds_string_arena as *mut c_void,\n363\t                0,\n364\t                size_of::<stbds_string_arena>(),\n365\t            );\n366\t            (*t).seed = stbds_hash_seed;\n367\t            let a = stbds_load_32_or_64(2147001325, 0x27bb2ee6, 0x87b0b0fd);\n368\t            let b = stbds_load_32_or_64(715136305, 0, 0xb504f32d);\n369\t            stbds_hash_seed = stbds_hash_seed.wrapping_mul(a).wrapping_add(b);\n370\t        }\n371\t\n372\t        {\n373\t            let mut i: usize = 0;\n374\t            while i < slot_count >> STBDS_BUCKET_SHIFT {\n375\t                let b = (*t).storage.add(i);\n376\t                for j in 0..STBDS_BUCKET_LENGTH {\n377\t                    (*b).hash[j] = STBDS_HASH_EMPTY;\n378\t                }\n379\t                for j in 0..STBDS_BUCKET_LENGTH {\n380\t                    (*b).index[j] = STBDS_INDEX_EMPTY;\n381\t                }\n382\t                i += 1;\n383\t            }\n384\t        }\n385\t\n386\t        if !ot.is_null() {\n387\t            (*t).used_count = (*ot).used_count;\n388\t            let mut i: usize = 0;\n389\t            while i < (*ot).slot_count >> STBDS_BUCKET_SHIFT {\n390\t                let ob = (*ot).storage.add(i);\n391\t                for j in 0..STBDS_BUCKET_LENGTH {\n392\t                    if (*ob).index[j] >= 0 {\n393\t                        let hash = (*ob).hash[j];\n394\t                        let mut pos =\n395\t                            stbds_probe_position(hash, (*t).slot_count, (*t).slot_count_log2);\n396\t                        let mut step = STBDS_BUCKET_LENGTH;\n397\t                        'probe: loop {\n398\t                            let bucket = (*t).storage.add(pos >> STBDS_BUCKET_SHIFT);\n399\t\n400\t                            let mut z = pos & STBDS_BUCKET_MASK;\n401\t                            while z < STBDS_BUCKET_LENGTH {\n402\t                                if (*bucket).hash[z] == 0 {\n403\t                                    (*bucket).hash[z] = hash;\n404\t                                    (*bucket).index[z] = (*ob).index[j];\n405\t                                    break 'probe;\n406\t                                }\n407\t                                z += 1;\n408\t                            }\n409\t\n410\t                            let limit = pos & STBDS_BUCKET_MASK;\n411\t                            for z in 0..limit {\n412\t                                if (*bucket).hash[z] == 0 {\n413\t                                    (*bucket).hash[z] = hash;\n414\t                                    (*bucket).index[z] = (*ob).index[j];\n415\t                                    break 'probe;\n416\t                                }\n417\t                            }\n418\t\n419\t                            pos = pos.wrapping_add(step);\n420\t                            step = step.wrapping_add(STBDS_BUCKET_LENGTH);\n421\t                            pos &= (*t).slot_count.wrapping_sub(1);\n422\t                        }\n423\t                    }\n424\t                }\n425\t                i += 1;\n426\t            }\n427\t        }\n428\t\n429\t        t\n430\t    }\n431\t}\n432\t\n433\t// ---------------------------------------------------------------------------\n434\t// hashing\n435\t// ---------------------------------------------------------------------------\n436\t\n437\t#[unsafe(no_mangle)]\n438\tpub unsafe extern \"C\" fn stbds_hash_string(str_: *mut c_char, seed: usize) -> usize {\n439\t    unsafe {\n440\t        let mut str_ = str_;\n441\t        let mut hash = seed;\n442\t        while *str_ != 0 {\n443\t            let c = *str_ as u8 as usize;\n444\t            hash = rotate_left(hash, 9).wrapping_add(c);\n445\t            str_ = str_.add(1);\n446\t        }\n447\t\n448\t        hash ^= seed;\n449\t        hash = (!hash).wrapping_add(hash << 18);\n450\t        hash ^= hash ^ rotate_right(hash, 31);\n451\t        hash = hash.wrapping_mul(21);\n452\t        hash ^= hash ^ rotate_right(hash, 11);\n453\t        hash = hash.wrapping_add(hash << 6);\n454\t        hash ^= rotate_right(hash, 22);\n455\t        hash.wrapping_add(seed)\n456\t    }\n457\t}\n458\t\n459\tconst STBDS_SIPHASH_C_ROUNDS: usize = 2;\n460\tconst STBDS_SIPHASH_D_ROUNDS: usize = 4;\n461\t\n462\t#[inline(always)]\n463\tfn siphash_round(v0: &mut usize, v1: &mut usize, v2: &mut usize, v3: &mut usize) {\n464\t    *v0 = v0.wrapping_add(*v1);\n465\t    *v1 = rotate_left(*v1, 13);\n466\t    *v1 ^= *v0;\n467\t    *v0 = rotate_left(*v0, STBDS_SIZE_T_BITS / 2);\n468\t    *v2 = v2.wrapping_add(*v3);\n469\t    *v3 = rotate_left(*v3, 16);\n470\t    *v3 ^= *v2;\n471\t    *v2 = v2.wrapping_add(*v1);\n472\t    *v1 = rotate_left(*v1, 17);\n473\t    *v1 ^= *v2;\n474\t    *v2 = rotate_left(*v2, STBDS_SIZE_T_BITS / 2);\n475\t    *v0 = v0.wrapping_add(*v3);\n476\t    *v3 = rotate_left(*v3, 21);\n477\t    *v3 ^= *v0;\n478\t}\n479\t\n480\t/// Reproduces `data = d[0] | (d[1] << 8) | (d[2] << 16) | (d[3] << 24);` where the\n481\t/// right hand side is computed in `int` and then (possibly sign-) extended to\n482\t/// `size_t` -- for `d[3] >= 0x80` the C expression is negative and therefore sets\n483\t/// every high bit of the resulting `size_t`.\n484\t#[inline(always)]\n485\tunsafe fn load_int_le32(d: *const u8) -> usize {\n486\t    unsafe {\n487\t        let v: i32 = (*d.add(0) as i32)\n488\t            | ((*d.add(1) as i32) << 8)\n489\t            | ((*d.add(2) as i32) << 16)\n490\t            | ((*d.add(3) as i32) << 24);\n491\t        v as i64 as u64 as usize\n492\t    }\n493\t}\n494\t\n495\tunsafe fn stbds_siphash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n496\t    unsafe {\n497\t        let mut d = p as *const u8;\n498\t        let mut i: usize;\n499\t        let mut data: usize;\n500\t\n501\t        let mut v0 = ((0x736f6d65usize << 16) << 16).wrapping_add(0x70736575) ^ seed;\n502\t        let mut v1 = ((0x646f7261usize << 16) << 16).wrapping_add(0x6e646f6d) ^ !seed;\n503\t        let mut v2 = ((0x6c796765usize << 16) << 16).wrapping_add(0x6e657261) ^ seed;\n504\t        let mut v3 = ((0x74656462usize << 16) << 16).wrapping_add(0x79746573) ^ !seed;\n505\t\n506\t        v0 ^= 0x0706050403020100u64 as usize ^ seed;\n507\t        v1 ^= 0x0f0e0d0c0b0a0908u64 as usize ^ !seed;\n508\t        v2 ^= 0x0706050403020100u64 as usize ^ seed;\n509\t        v3 ^= 0x0f0e0d0c0b0a0908u64 as usize ^ !seed;\n510\t\n511\t        i = 0;\n512\t        while i.wrapping_add(size_of::<usize>()) <= len {\n513\t            data = load_int_le32(d);\n514\t            // discarded if size_t == 4\n515\t            data |= (load_int_le32(d.add(4)) << 16) << 16;\n516\t\n517\t            v3 ^= data;\n518\t            for _ in 0..STBDS_SIPHASH_C_ROUNDS {\n519\t                siphash_round(&mut v0, &mut v1, &mut v2, &mut v3);\n520\t            }\n521\t            v0 ^= data;\n522\t\n523\t            i = i.wrapping_add(size_of::<usize>());\n524\t            d = d.add(size_of::<usize>());\n525\t        }\n526\t\n527\t        data = len << (STBDS_SIZE_T_BITS - 8);\n528\t        // C switch with fall-through: case k performs the work of cases k..1.\n529\t        let rem = len.wrapping_sub(i);\n530\t        if rem >= 7 {\n531\t            data |= ((*d.add(6) as usize) << 24) << 24;\n532\t        }\n533\t        if rem >= 6 {\n534\t            data |= ((*d.add(5) as usize) << 20) << 20;\n535\t        }\n536\t        if rem >= 5 {\n537\t            data |= ((*d.add(4) as usize) << 16) << 16;\n538\t        }\n539\t        if rem >= 4 {\n540\t            // int expression -> sign extended when d[3] >= 0x80\n541\t            data |= (((*d.add(3) as i32) << 24) as i64 as u64) as usize;\n542\t        }\n543\t        if rem >= 3 {\n544\t            data |= ((*d.add(2) as i32) << 16) as usize;\n545\t        }\n546\t        if rem >= 2 {\n547\t            data |= ((*d.add(1) as i32) << 8) as usize;\n548\t        }\n549\t        if rem >= 1 {\n550\t            data |= *d.add(0) as usize;\n551\t        }\n552\t\n553\t        v3 ^= data;\n554\t        for _ in 0..STBDS_SIPHASH_C_ROUNDS {\n555\t            siphash_round(&mut v0, &mut v1, &mut v2, &mut v3);\n556\t        }\n557\t        v0 ^= data;\n558\t        v2 ^= 0xff;\n559\t        for _ in 0..STBDS_SIPHASH_D_ROUNDS {\n560\t            siphash_round(&mut v0, &mut v1, &mut v2, &mut v3);\n561\t        }\n562\t\n563\t        v0 ^ v1 ^ v2 ^ v3\n564\t    }\n565\t}\n566\t\n567\t#[unsafe(no_mangle)]\n568\tpub unsafe extern \"C\" fn stbds_hash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n569\t    unsafe { stbds_siphash_bytes(p, len, seed) }\n570\t}\n571\t\n572\t// ---------------------------------------------------------------------------\n573\t// hash map\n574\t// ---------------------------------------------------------------------------\n575\t\n576\tunsafe fn stbds_is_key_equal(\n577\t    a: *mut c_void,\n578\t    elemsize: usize,\n579\t    key: *mut c_void,\n580\t    keysize: usize,\n581\t    keyoffset: usize,\n582\t    mode: c_int,\n583\t    i: usize,\n584\t) -> c_int {\n585\t    unsafe {\n586\t        let slot = byte_add(a, elemsize.wrapping_mul(i).wrapping_add(keyoffset));\n587\t        if mode >= STBDS_HM_STRING {\n588\t            (0 == strcmp(key as *const c_char, *(slot as *mut *const c_char))) as c_int\n589\t        } else {\n590\t            (0 == memcmp(key, slot, keysize)) as c_int\n591\t        }\n592\t    }\n593\t}\n594\t\n595\t#[unsafe(no_mangle)]\n596\tpub unsafe extern \"C\" fn stbds_hmfree_func(a: *mut c_void, elemsize: usize) {\n597\t    unsafe {\n598\t        if a.is_null() {\n599\t            return;\n600\t        }\n601\t        if !stbds_hash_table(a).is_null() {\n602\t            if (*stbds_hash_table(a)).string.mode == STBDS_SH_STRDUP {\n603\t                let mut i: usize = 1;\n604\t                while i < (*stbds_header(a)).length {\n605\t                    stbds_free(*(byte_add(a, elemsize.wrapping_mul(i)) as *mut *mut c_void));\n606\t                    i += 1;\n607\t                }\n608\t            }\n609\t            stbds_strreset(&mut (*stbds_hash_table(a)).string);\n610\t        }\n611\t        stbds_free((*stbds_header(a)).hash_table);\n612\t        stbds_free(stbds_header(a) as *mut c_void);\n613\t    }\n614\t}\n615\t\n616\tunsafe fn stbds_hm_find_slot(\n617\t    a: *mut c_void,\n618\t    elemsize: usize,\n619\t    key: *mut c_void,\n620\t    keysize: usize,\n621\t    keyoffset: usize,\n622\t    mode: c_int,\n623\t) -> isize {\n624\t    unsafe {\n625\t        let raw_a = stbds_hash_to_arr(a, elemsize);\n626\t        let table = stbds_hash_table(raw_a);\n627\t        let mut hash = if mode >= STBDS_HM_STRING {\n628\t            stbds_hash_string(key as *mut c_char, (*table).seed)\n629\t        } else {\n630\t            stbds_hash_bytes(key, keysize, (*table).seed)\n631\t        };\n632\t        let mut step = STBDS_BUCKET_LENGTH;\n633\t\n634\t        if hash < 2 {\n635\t            hash = hash.wrapping_add(2);\n636\t        }\n637\t\n638\t        let mut pos = stbds_probe_position(hash, (*table).slot_count, (*table).slot_count_log2);\n639\t\n640\t        loop {\n641\t            let bucket = (*table).storage.add(pos >> STBDS_BUCKET_SHIFT);\n642\t\n643\t            let mut i = pos & STBDS_BUCKET_MASK;\n644\t            while i < STBDS_BUCKET_LENGTH {\n645\t                if (*bucket).hash[i] == hash {\n646\t                    if stbds_is_key_equal(\n647\t                        a,\n648\t                        elemsize,\n649\t                        key,\n650\t                        keysize,\n651\t                        keyoffset,\n652\t                        mode,\n653\t                        (*bucket).index[i] as usize,\n654\t                    ) != 0\n655\t                    {\n656\t                        return ((pos & !STBDS_BUCKET_MASK) + i) as isize;\n657\t                    }\n658\t                } else if (*bucket).hash[i] == STBDS_HASH_EMPTY {\n659\t                    return -1;\n660\t                }\n661\t                i += 1;\n662\t            }\n663\t\n664\t            let limit = pos & STBDS_BUCKET_MASK;\n665\t            for i in 0..limit {\n666\t                if (*bucket).hash[i] == hash {\n667\t                    if stbds_is_key_equal(\n668\t                        a,\n669\t                        elemsize,\n670\t                        key,\n671\t                        keysize,\n672\t                        keyoffset,\n673\t                        mode,\n674\t                        (*bucket).index[i] as usize,\n675\t                    ) != 0\n676\t                    {\n677\t                        return ((pos & !STBDS_BUCKET_MASK) + i) as isize;\n678\t                    }\n679\t                } else if (*bucket).hash[i] == STBDS_HASH_EMPTY {\n680\t                    return -1;\n681\t                }\n682\t            }\n683\t\n684\t            pos = pos.wrapping_add(step);\n685\t            step = step.wrapping_add(STBDS_BUCKET_LENGTH);\n686\t            pos &= (*table).slot_count.wrapping_sub(1);\n687\t        }\n688\t    }\n689\t}\n690\t\n691\t#[unsafe(no_mangle)]\n692\tpub unsafe extern \"C\" fn stbds_hmget_key_ts(\n693\t    a: *mut c_void,\n694\t    elemsize: usize,\n695\t    key: *mut c_void,\n696\t    keysize: usize,\n697\t    temp: *mut isize,\n698\t    mode: c_int,\n699\t) -> *mut c_void {\n700\t    unsafe {\n701\t        let keyoffset: usize = 0;\n702\t        if a.is_null() {\n703\t            let a = stbds_arrgrowf(ptr::null_mut(), elemsize, 0, 1);\n704\t            (*stbds_header(a)).length += 1;\n705\t            c_memset(a, 0, elemsize);\n706\t            *temp = STBDS_INDEX_EMPTY;\n707\t            stbds_arr_to_hash(a, elemsize)\n708\t        } else {\n709\t            let raw_a = stbds_hash_to_arr(a, elemsize);\n710\t            let table = (*stbds_header(raw_a)).hash_table as *mut stbds_hash_index;\n711\t            if table.is_null() {\n712\t                *temp = -1;\n713\t            } else {\n714\t                let slot = stbds_hm_find_slot(a, elemsize, key, keysize, keyoffset, mode);\n715\t                if slot < 0 {\n716\t                    *temp = STBDS_INDEX_EMPTY;\n717\t                } else {\n718\t                    let b = (*table).storage.add((slot >> STBDS_BUCKET_SHIFT) as usize);\n719\t                    *temp = (*b).index[(slot as usize) & STBDS_BUCKET_MASK];\n720\t                }\n721\t            }\n722\t            a\n723\t        }\n724\t    }\n725\t}\n726\t\n727\t#[unsafe(no_mangle)]\n728\tpub unsafe extern \"C\" fn stbds_hmget_key(\n729\t    a: *mut c_void,\n730\t    elemsize: usize,\n731\t    key: *mut c_void,\n732\t    keysize: usize,\n733\t    mode: c_int,\n734\t) -> *mut c_void {\n735\t    unsafe {\n736\t        let mut temp: isize = 0;\n737\t        let p = stbds_hmget_key_ts(a, elemsize, key, keysize, &mut temp, mode);\n738\t        set_stbds_temp(stbds_hash_to_arr(p, elemsize), temp);\n739\t        p\n740\t    }\n741\t}\n742\t\n743\t#[unsafe(no_mangle)]\n744\tpub unsafe extern \"C\" fn stbds_hmput_default(a: *mut c_void, elemsize: usize) -> *mut c_void {\n745\t    unsafe {\n746\t        let mut a = a;\n747\t        if a.is_null() || (*stbds_header(stbds_hash_to_arr(a, elemsize))).length == 0 {\n748\t            let base = if !a.is_null() {\n749\t                stbds_hash_to_arr(a, elemsize)\n750\t            } else {\n751\t                ptr::null_mut()\n752\t            };\n753\t            let na = stbds_arrgrowf(base, elemsize, 0, 1);\n754\t            (*stbds_header(na)).length += 1;\n755\t            c_memset(na, 0, elemsize);\n756\t            a = stbds_arr_to_hash(na, elemsize);\n757\t        }\n758\t        a\n759\t    }\n760\t}\n761\t\n762\t#[unsafe(no_mangle)]\n763\tpub unsafe extern \"C\" fn stbds_hmput_key(\n764\t    a: *mut c_void,\n765\t    elemsize: usize,\n766\t    key: *mut c_void,\n767\t    keysize: usize,\n768\t    mode: c_int,\n769\t) -> *mut c_void {\n770\t    unsafe {\n771\t        let keyoffset: usize = 0;\n772\t        let mut a = a;\n773\t\n774\t        if a.is_null() {\n775\t            a = stbds_arrgrowf(ptr::null_mut(), elemsize, 0, 1);\n776\t            c_memset(a, 0, elemsize);\n777\t            (*stbds_header(a)).length += 1;\n778\t            a = stbds_arr_to_hash(a, elemsize);\n779\t        }\n780\t\n781\t        let mut raw_a = a;\n782\t        a = stbds_hash_to_arr(a, elemsize);\n783\t\n784\t        let mut table = (*stbds_header(a)).hash_table as *mut stbds_hash_index;\n785\t\n786\t        if table.is_null() || (*table).used_count >= (*table).used_count_threshold {\n787\t            let slot_count = if table.is_null() {\n788\t                STBDS_BUCKET_LENGTH\n789\t            } else {\n790\t                (*table).slot_count.wrapping_mul(2)\n791\t            };\n792\t            let nt = stbds_make_hash_index(slot_count, table);\n793\t            if !table.is_null() {\n794\t                stbds_free(table as *mut c_void);\n795\t            } else {\n796\t                (*nt).string.mode = if mode >= STBDS_HM_STRING {\n797\t                    STBDS_SH_DEFAULT\n798\t                } else {\n799\t                    STBDS_SH_NONE\n800\t                };\n801\t            }\n802\t            table = nt;\n803\t            (*stbds_header(a)).hash_table = table as *mut c_void;\n804\t        }\n805\t\n806\t        {\n807\t            let mut hash = if mode >= STBDS_HM_STRING {\n808\t                stbds_hash_string(key as *mut c_char, (*table).seed)\n809\t            } else {\n810\t                stbds_hash_bytes(key, keysize, (*table).seed)\n811\t            };\n812\t            let mut step = STBDS_BUCKET_LENGTH;\n813\t            let mut tombstone: isize = -1;\n814\t            let mut bucket: *mut stbds_hash_bucket;\n815\t\n816\t            if hash < 2 {\n817\t                hash = hash.wrapping_add(2);\n818\t            }\n819\t\n820\t            let mut pos = stbds_probe_position(hash, (*table).slot_count, (*table).slot_count_log2);\n821\t\n822\t            'found_empty_slot: loop {\n823\t                bucket = (*table).storage.add(pos >> STBDS_BUCKET_SHIFT);\n824\t\n825\t                let mut i = pos & STBDS_BUCKET_MASK;\n826\t                while i < STBDS_BUCKET_LENGTH {\n827\t                    if (*bucket).hash[i] == hash {\n828\t                        if stbds_is_key_equal(\n829\t                            raw_a,\n830\t                            elemsize,\n831\t                            key,\n832\t                            keysize,\n833\t                            keyoffset,\n834\t                            mode,\n835\t                            (*bucket).index[i] as usize,\n836\t                        ) != 0\n837\t                        {\n838\t                            set_stbds_temp(a, (*bucket).index[i]);\n839\t                            if mode >= STBDS_HM_STRING {\n840\t                                let kp = byte_add(\n841\t                                    raw_a,\n842\t                                    elemsize\n843\t                                        .wrapping_mul((*bucket).index[i] as usize)\n844\t                                        .wrapping_add(keyoffset),\n845\t                                ) as *mut *mut c_char;\n846\t                                set_stbds_temp_key(a, *kp);\n847\t                            }\n848\t                            return stbds_arr_to_hash(a, elemsize);\n849\t                        }\n850\t                    } else if (*bucket).hash[i] == 0 {\n851\t                        pos = (pos & !STBDS_BUCKET_MASK) + i;\n852\t                        break 'found_empty_slot;\n853\t                    } else if tombstone < 0 {\n854\t                        if (*bucket).index[i] == STBDS_INDEX_DELETED {\n855\t                            tombstone = ((pos & !STBDS_BUCKET_MASK) + i) as isize;\n856\t                        }\n857\t                    }\n858\t                    i += 1;\n859\t                }\n860\t\n861\t                let limit = pos & STBDS_BUCKET_MASK;\n862\t                let mut i: usize = 0;\n863\t                while i < limit {\n864\t                    if (*bucket).hash[i] == hash {\n865\t                        if stbds_is_key_equal(\n866\t                            raw_a,\n867\t                            elemsize,\n868\t                            key,\n869\t                            keysize,\n870\t                            keyoffset,\n871\t                            mode,\n872\t                            (*bucket).index[i] as usize,\n873\t                        ) != 0\n874\t                        {\n875\t                            set_stbds_temp(a, (*bucket).index[i]);\n876\t                            return stbds_arr_to_hash(a, elemsize);\n877\t                        }\n878\t                    } else if (*bucket).hash[i] == 0 {\n879\t                        pos = (pos & !STBDS_BUCKET_MASK) + i;\n880\t                        break 'found_empty_slot;\n881\t                    } else if tombstone < 0 {\n882\t                        if (*bucket).inde