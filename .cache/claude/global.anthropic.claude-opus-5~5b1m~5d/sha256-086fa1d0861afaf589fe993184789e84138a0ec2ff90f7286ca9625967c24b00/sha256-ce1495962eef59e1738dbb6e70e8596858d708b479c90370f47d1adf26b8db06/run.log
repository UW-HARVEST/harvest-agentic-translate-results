\t// the formatting in Rust.\n39\t// ---------------------------------------------------------------------------\n40\textern \"C\" {\n41\t    fn printf(fmt: *const c_char, ...) -> c_int;\n42\t    fn strtol(nptr: *const c_char, endptr: *mut *mut c_char, base: c_int) -> c_long;\n43\t    fn __errno_location() -> *mut c_int;\n44\t}\n45\t\n46\t#[inline]\n47\tunsafe fn errno_get() -> c_int {\n48\t    *__errno_location()\n49\t}\n50\t\n51\t#[inline]\n52\tunsafe fn errno_set(v: c_int) {\n53\t    *__errno_location() = v;\n54\t}\n55\t\n56\t// <errno.h>\n57\tconst EOK: c_int = 0;\n58\t\n59\t// <limits.h>\n60\tconst INT_MIN_L: c_long = c_int::MIN as c_long;\n61\tconst INT_MAX_L: c_long = c_int::MAX as c_long;\n62\t\n63\t// ---------------------------------------------------------------------------\n64\t// typedef struct { int floors; int bedrooms; double bathrooms; } house_t;\n65\t// ---------------------------------------------------------------------------\n66\t#[repr(C)]\n67\tstruct house_t {\n68\t    floors: c_int,\n69\t    bedrooms: c_int,\n70\t    bathrooms: c_double,\n71\t}\n72\t\n73\t// static house_t the_house = {.floors = 2, .bedrooms = 5, .bathrooms = 2.5};\n74\tstatic mut THE_HOUSE: house_t = house_t {\n75\t    floors: 2,\n76\t    bedrooms: 5,\n77\t    bathrooms: 2.5,\n78\t};\n79\t\n80\t// static void add_floor(house_t *house) { house->floors++; }\n81\tunsafe fn add_floor(house: *mut house_t) {\n82\t    // `++` on a signed int; reproduce the two's-complement wrap the C\n83\t    // compiler emits rather than trapping.\n84\t    (*house).floors = (*house).floors.wrapping_add(1);\n85\t}\n86\t\n87\t// static void add_bedrooms(house_t *house, int extra_bedrooms)\n88\tunsafe fn add_bedrooms(house: *mut house_t, extra_bedrooms: c_int) {\n89\t    (*house).bedrooms = (*house).bedrooms.wrapping_add(extra_bedrooms);\n90\t}\n91\t\n92\t// static void add_floor_to_the_house()\n93\tunsafe fn add_floor_to_the_house() {\n94\t    add_floor(addr_of_mut!(THE_HOUSE));\n95\t}\n96\t\n97\t// static void print_the_house()\n98\tunsafe fn print_the_house() {\n99\t    const FMT: &[u8] =\n100\t        b\"The house has %d floors, %d bedrooms, and %.1f bathrooms\\n\\0\";\n101\t    let h = addr_of_mut!(THE_HOUSE);\n102\t    printf(\n103\t        FMT.as_ptr() as *const c_char,\n104\t        (*h).floors,\n105\t        (*h).bedrooms,\n106\t        (*h).bathrooms,\n107\t    );\n108\t}\n109\t\n110\t/// void run(int extra_bedrooms);\n111\t#[unsafe(no_mangle)]\n112\tpub unsafe extern \"C\" fn run(extra_bedrooms: c_int) {\n113\t    print_the_house();\n114\t    add_floor_to_the_house();\n115\t    print_the_house();\n116\t    let h = addr_of_mut!(THE_HOUSE);\n117\t    (*h).bathrooms += 1.0;\n118\t    print_the_house();\n119\t    add_bedrooms(h, extra_bedrooms);\n120\t    print_the_house();\n121\t}\n122\t\n123\t// static bool parse_val(const char *str, int *val)\n124\tunsafe fn parse_val(str_: *const c_char, val: *mut c_int) -> bool {\n125\t    errno_set(EOK);\n126\t    let mut endp: *mut c_char = str_ as *mut c_char;\n127\t    let tmp: c_long = strtol(str_, &mut endp, 10);\n128\t    if endp != (str_ as *mut c_char)\n129\t        && errno_get() == EOK\n130\t        && tmp >= INT_MIN_L\n131\t        && tmp <= INT_MAX_L\n132\t    {\n133\t        *val = tmp as c_int;\n134\t        true\n135\t    } else {\n136\t        false\n137\t    }\n138\t}\n139\t\n140\t/// void driver(const char *in);\n141\t#[unsafe(no_mangle)]\n142\tpub unsafe extern \"C\" fn driver(in_: *const c_char) {\n143\t    // `int x;` -- deliberately left uninitialised in the C source; it is only\n144\t    // read when parse_val() succeeded and therefore wrote it.\n145\t    let mut x: c_int = 0;\n146\t    if parse_val(in_, &mut x) {\n147\t        run(x);\n148\t        run(x);\n149\t    } else {\n150\t        const MSG: &[u8] = b\"An error occurred\\n\\0\";\n151\t        printf(MSG.as_ptr() as *const c_char);\n152\t    }\n153\t}\n154\t"}]},"parent_tool_use_id":null,"session_id":"6e967bdb-9af5-42a7-86c3-9f92c2ba4