{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_011CEo7PvCe73uRD3KU2iNYW","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/`.\n2\t//!\n3\t//! The C library consists of a single translation unit (`src/lib.c`) and a\n4\t//! single public header (`include/lib.h`). Its complete exported ABI is:\n5\t//!\n6\t//! ```text\n7\t//! float contrast_ratio(cb_rgb_255 A, cb_rgb_255 B);\n8\t//! ```\n9\t//!\n10\t//! `cbLuminance` and `cbContrastRatio` are `static` in the C source and are\n11\t//! therefore *not* part of the exported ABI; they are reproduced here as\n12\t//! private helpers.\n13\t//!\n14\t//! Every arithmetic step below mirrors the exact C evaluation order, the exact\n15\t//! C usual-arithmetic-conversions (`float` operands promoted to `double`\n16\t//! whenever they meet a `double` literal such as `0.04045`, `0.055`, `1.055`\n17\t//! or `12.92`), and the exact `float`-precision accumulation used for the\n18\t//! luminance dot product. This is required for byte-identical output.\n19\t\n20\t#![allow(non_snake_case)]\n21\t#![allow(non_camel_case_types)]\n22\t\n23\tuse std::ffi::c_uchar;\n24\t\n25\textern \"C\" {\n26\t    /// Bind directly to the platform `pow` (`pow@GLIBC_2.29` in the C build)\n27\t    /// so the translated code produces bit-identical results to the C library\n28\t    /// rather than relying on any Rust-side reimplementation.\n29\t    fn pow(x: f64, y: f64) -> f64;\n30\t}\n31\t\n32\t/// ```c\n33\t/// typedef struct cb_rgb_255 {\n34\t///     unsigned char R;\n35\t///     unsigned char G;\n36\t///     unsigned char B;\n37\t/// } cb_rgb_255;\n38\t/// ```\n39\t///\n40\t/// `#[repr(C)]` gives this size 3 / align 1, so it is classified INTEGER and\n41\t/// passed packed in a single general-purpose register, matching the C ABI.\n42\t#[repr(C)]\n43\t#[derive(Clone, Copy)]\n44\tpub struct cb_rgb_255 {\n45\t    pub R: c_uchar,\n46\t    pub G: c_uchar,\n47\t    pub B: c_uchar,\n48\t}\n49\t\n50\t/// Faithful translation of the C expression\n51\t///\n52\t/// ```c\n53\t/// (float)(X > 0.04045 ? pow((X + 0.055) / 1.055, 2.4) : X / 12.92)\n54\t/// ```\n55\t///\n56\t/// The comparison and both arms of the conditional are evaluated in `double`\n57\t/// (the `float` argument is promoted because the literals are `double`), the\n58\t/// conditional expression therefore has type `double`, and the result is then\n59\t/// converted back to `float` by the cast.\n60\t#[inline]\n61\tfn cb_srgb_to_linear(x: f32) -> f32 {\n62\t    let x = x as f64;\n63\t    let linear: f64 = if x > 0.04045 {\n64\t        unsafe { pow((x + 0.055) / 1.055, 2.4) }\n65\t    } else {\n66\t        x / 12.92\n67\t    };\n68\t    linear as f32\n69\t}\n70\t\n71\t/// ```c\n72\t/// static float cbLuminance(float R, float G, float B) {\n73\t///     R = ((float)(R > 0.04045 ? pow((R + 0.055) / 1.055, 2.4) : R / 12.92));\n74\t///     G = ((float)(G > 0.04045 ? pow((G + 0.055) / 1.055, 2.4) : G / 12.92));\n75\t///     B = ((float)(B > 0.04045 ? pow((B + 0.055) / 1.055, 2.4) : B / 12.92));\n76\t///     float Result = 0.2126f * R + 0.7152f * G + 0.0722f * B;\n77\t///     return Result;\n78\t/// }\n79\t/// ```\n80\tfn cbLuminance(R: f32, G: f32, B: f32) -> f32 {\n81\t    let R = cb_srgb_to_linear(R);\n82\t    let G = cb_srgb_to_linear(G);\n83\t    let B = cb_srgb_to_linear(B);\n84\t\n85\t    // Single-precision throughout, left-to-right association exactly as C\n86\t    // groups it: ((0.2126f * R) + (0.7152f * G)) + (0.0722f * B).\n87\t    let Result: f32 = 0.2126f32 * R + 0.7152f32 * G + 0.0722f32 * B;\n88\t    Result\n89\t}\n90\t\n91\t/// ```c\n92\t/// static float cbContrastRatio(float RA, float GA, float BA,\n93\t///                              float RB, float GB, float BB) {\n94\t///     float LumA = cbLuminance(RA, GA, BA);\n95\t///     float LumB = cbLuminance(RB, GB, BB);\n96\t///     float High = LumA, Low = LumB;\n97\t///     if (High < Low) {\n98\t///         High = LumB, Low = LumA;\n99\t///     }\n100\t///     float Ratio = High / Low;\n101\t///     return Ratio;\n102\t/// }\n103\t/// ```\n104\t///\n105\t/// Reproduced verbatim, including the original's behaviour for the degenerate\n106\t/// cases: a zero `Low` yields an infinity (or NaN for 0/0) instead of being\n107\t/// guarded against, and the C code applies no WCAG `+0.05` offset. NaN inputs\n108\t/// make `High < Low` false, so no swap occurs -- identical to C.\n109\tfn cbContrastRatio(RA: f32, GA: f32, BA: f32, RB: f32, GB: f32, BB: f32) -> f32 {\n110\t    let LumA = cbLuminance(RA, GA, BA);\n111\t    let LumB = cbLuminance(RB, GB, BB);\n112\t\n113\t    let mut High = LumA;\n114\t    let mut Low = LumB;\n115\t    if High < Low {\n116\t        High = LumB;\n117\t        Low = LumA;\n118\t    }\n119\t\n120\t    let Ratio = High / Low;\n121\t    Ratio\n122\t}\n123\t\n124\t/// ```c\n125\t/// float contrast_ratio(cb_rgb_255 A, cb_rgb_255 B) {\n126\t///     return cbContrastRatio(((float)(A.R) / 255.f), ((float)(A.G) / 255.f),\n127\t///                            ((float)(A.B) / 255.f), ((float)(B.R) / 255.f),\n128\t///                            ((float)(B.G) / 255.f), ((float)(B.B) / 255.f));\n129\t/// }\n130\t/// ```\n131\t///\n132\t/// Each channel is converted `unsigned char` -> `float` and divided by the\n133\t/// `float` literal `255.f`, i.e. the division happens in single precision.\n134\t#[unsafe(no_mangle)]\n135\tpub extern \"C\" fn contrast_ratio(A: cb_rgb_255, B: cb_rgb_255) -> f32 {\n136\t    cbContrastRatio(\n137\t        A.R as f32 / 255.0f32,\n138\t        A.G as f32 / 255.0f32,\n139\t        A.B as f32 / 255.0f32,\n140\t        B.R as f32 / 255.0f32,\n141\t        B.G as f32 / 255.0f32,\n142\t        B.B as f32 / 255.0f32,\n143\t    )\n144\t}\n145\t"}]},"parent_tool_use_id":null,"session_id":"4aeb89ce-3f40-4d71-bc31-50d5f7539e91","uuid":"8e79247c-4928-4e90-9564-f03a6eafebb8","timestamp":"2026-08-26T20:13:25.105Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-oJoEva/translation/src/lib.rs","content":"//! Rust translation of the C library in `c_src/`.\n//!\n//! The C library consists of a single translation unit (`src/lib.c`) and a\n//! single public header (`include/lib.h`). Its complete exported ABI is:\n//!\n//! ```text\n//! float contrast_ratio(cb_rgb_255 A, cb_rgb_255 B);\n//! ```\n//!\n//! `cbLuminance` and `cbContrastRatio` are `static` in the C source and are\n//! therefore *not* part of the exported ABI; they are reproduced here as\n//! private helpers.\n//!\n//! Every arithmetic step below mirrors the exact C evaluation order, the exact\n//! C usual-arithmetic-conversions (`float` operands promoted to `double`\n//! whenever they meet a `double` literal such as `0.04045`, `0.055`, `1.055`\n//! or `12.92`), and the exact `float`-precision accumulation used for the\n//! luminance dot product. This is required for byte-identical output.\n\n#![allow(non_snake_case)]\n#![allow(non_camel_case_types)]\n\nuse std::ffi::c_uchar;\n\nextern \"C\" {\n    /// Bind directly to the platform `pow` (`pow@GLIBC_2.29` in the C build)\n    /// so the translated code produces bit-identical results to the C library\n    /// rather than relying on any Rust-side reimplementation.\n    fn pow(x: f64, y: f64) -> f64;\n}\n\n/// ```c\n/// typedef struct cb_rgb_255 {\n///     unsigned char R;\n///     unsigned char G;\n///     unsigned char B;\n/// } cb_rgb_255;\n/// ```\n///\n/// `#[repr(C)]` gives this size 3 / align 1, so it is classified INTEGER and\n/// passed packed in a single general-purpose register, matching the C ABI.\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct cb_rgb_255 {\n    pub R: c_uchar,\n    pub G: c_uchar,\n    pub B: c_uchar,\n}\n\n/// Faithful translation of the C expression\n///\n/// ```c\n/// (float)(X > 0.04045 ? pow((X + 0.055) / 1.055, 2.4) : X / 12.92)\n/// ```\n///\n/// The comparison and both arms of the conditional are evaluated in `double`\n/// (the `float` argument is promoted because the literals are `double`), the\n/// conditional expression therefore has type `double`, and the result is then\n/// converted back to `float` by the cast.\n#[inline]\nfn cb_srgb_to_linear(x: f32) -> f32 {\n    let x = x as f64;\n    let linear: f64 = if x > 0.04045 {\n        unsafe { pow((x + 0.055) / 1.055, 2.4) }\n    } else {\n        x / 12.92\n    };\n    linear as f32\n}\n\n/// ```c\n/// static float cbLuminance(float R, float G, float B) {\n///     R = ((float)(R > 0.04045 ? pow((R + 0.055) / 1.055, 2.4) : R / 12.92));\n///     G = ((float)(G > 0.04045 ? pow((G + 0.055) / 1.055, 2.4) : G / 12.92));\n///     B = ((float)(B > 0.04045 ? pow((B + 0.055) / 1.055, 2.4) : B / 12.92));\n///     float Result = 0.2126f * R + 0.7152f * G + 0.0722f * B;\n///     return Result;\n/// }\n/// ```\nfn cbLuminance(R: f32, G: f32, B: f32) -> f32 {\n    let R = cb_srgb_to_linear(R);\n    let G = cb_srgb_to_linear(G);\n    let B = cb_srgb_to_linear(B);\n\n    // Single-precision throughout, left-to-right association exactly as C\n    // groups it: ((0.2126f * R) + (0.7152f * G)) + (0.0722f * B).\n    let Result: f32 = 0.2126f32 * R + 0.7152f32 * G + 0.0722f32 * B;\n    Result\n}\n\n/// ```c\n/// static float cbContrastRatio(float RA, float GA, float BA,\n///                              float RB, float GB, float BB) {\n///     float LumA = cbLuminance(RA, GA, BA);\n///     float LumB = cbLuminance(RB, GB, BB);\n///     float High = LumA, Low = LumB;\n///     if (High < Low) {\n///         High = LumB, Low = LumA;\n///     }\n///     float Ratio = High / Low;\n///     return Ratio;\n/// }\n/// ```\n///\n/// Reproduced verbatim, including the original's behaviour for the degenerate\n/// cases: a zero `Low` yields an infinity (or NaN for 0/0) instead of being\n/// guarded against, and the C code applies no WCAG `+0.05` offset. NaN inputs\n/// make `High < Low` false, so no swap occurs -- identical to C.\nfn cbContrastRatio(RA: f32, GA: f32, BA: f32, RB: f32, GB: f32, BB: f32) -> f32 {\n    let LumA = cbLuminance(RA, GA, BA);\n    let LumB = cbLuminance(RB, GB, BB);\n\n    let mut High = LumA;\n    let mut Low = LumB;\n    if High < Low {\n        High = LumB;\n        Low = LumA;\n    }\n\n    let Ratio = High / Low;\n    Ratio\n}\n\n/// ```c\n/// float contrast_ratio(cb_rgb_255 A, cb_rgb_255 B) {\n///     return cbContrastRatio(((float)(A.R) / 255.f), ((float)(A.G) / 255.f),\n///                            ((float)(A.B) / 255.f), ((float)(B.R) / 255.f),\n///                            ((float)(B.G) / 255.f), ((float)(B.B) / 255.f));\n/// }\n/// ```\n///\n/// Each channel is converted `unsigned char` -> `float` and divided by the\n/// `float` literal `255.f`, i.e. the division happens in single precision.\n#[unsafe(no_mangle)]\npub extern \"C\" fn contrast_ratio(A: cb_rgb_255, B: cb_rgb_255) -> f32 {\n    cbContrastRatio(\n        A.R as f32 / 255.0f32,\n        A.G as f32 / 255.0f32,\n        A.B as f32 / 255.0f32,\n        B.R as f32 / 255.0f32,\n        B.G as f32 / 255.0f32,\n        B.B as f32 / 255.0f32,\n    )\n}\n","numLines":145,"startLine":1,"totalLines":145}}}
