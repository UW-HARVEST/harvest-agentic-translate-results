taken for negative hues.","+        // dest = { m, c + m, x + m }","+        store(m, add_ss(c, m), add_ss(x, m));","+    } else if h >= 180.0 && h < 240.0 {","+        // dest = { m, x + m, c + m }","+        store(m, add_ss(x, m), add_ss(c, m));","+    } else if h >= 240.0 && h < 300.0 {","+        // dest = { x + m, m, c + m }","+        store(add_ss(x, m), m, add_ss(c, m));","+    } else if h >= 300.0 && h < 360.0 {","+        // dest = { c + m, m, x + m }","+        store(add_ss(c, m), m, add_ss(x, m));","     } else {","-        write(m, m, m);","+        // Hues outside [0, 360) that reach here (>= 360, or NaN) yield grey.","+        store(m, m, m);","     }"," }"]}],"originalFile":"//! Rust translation of the C library in `c_src/`.\n//!\n//! Public ABI (from `nm -D` on the C shared library):\n//!   * `hsl_to_rgb`\n//!\n//! The translation is intentionally faithful to the original C, including its\n//! quirks (see the third branch below, which tests `h < 120.0f` twice instead\n//! of `h >= 120.0f && h < 180.0f`). Bugs are preserved, not fixed.\n\nuse std::ffi::c_float;\n\n/// `void hsl_to_rgb(float *dest, const float *src);`\n///\n/// Converts an HSL triple (`src[0]` = hue in degrees, `src[1]` = saturation,\n/// `src[2]` = lightness) into an RGB triple written to `dest[0..3]`.\n///\n/// # Safety\n/// `src` must be readable for 3 `float`s and `dest` writable for 3 `float`s,\n/// exactly as required by the C original.\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn hsl_to_rgb(dest: *mut c_float, src: *const c_float) {\n    // float h = src[0]; float s = src[1]; float l = src[2];\n    let (h, s, l) = unsafe { (*src.add(0), *src.add(1), *src.add(2)) };\n\n    let write = |r: c_float, g: c_float, b: c_float| unsafe {\n        *dest.add(0) = r;\n        *dest.add(1) = g;\n        *dest.add(2) = b;\n    };\n\n    // if (s == 0) { dest[0] = dest[1] = dest[2] = l; return; }\n    if s == 0.0 {\n        write(l, l, l);\n        return;\n    }\n\n    // c = (1.0f - fabsf(2.0f * l - 1.0f)) * s;\n    let c: c_float = (1.0f32 - (2.0f32 * l - 1.0f32).abs()) * s;\n    // m = 1.0f * (l - 0.5f * c);\n    let m: c_float = 1.0f32 * (l - 0.5f32 * c);\n    // x = c * (1.0f - fabsf(fmodf(h / 60.0f, 2) - 1.0f));\n    // Rust's `%` on floats has fmod() semantics (truncated, sign of dividend).\n    let x: c_float = c * (1.0f32 - ((h / 60.0f32) % 2.0f32 - 1.0f32).abs());\n\n    if h >= 0.0f32 && h < 60.0f32 {\n        write(c + m, x + m, m);\n    } else if h >= 60.0f32 && h < 120.0f32 {\n        write(x + m, c + m, m);\n    } else if h < 120.0f32 && h < 180.0f32 {\n        // NOTE: faithful reproduction of the C source, which repeats the\n        // `h < 120.0f` test here rather than checking `h >= 120.0f`.\n        write(m, c + m, x + m);\n    } else if h >= 180.0f32 && h < 240.0f32 {\n        write(m, x + m, c + m);\n    } else if h >= 240.0f32 && h < 300.0f32 {\n        write(x + m, m, c + m);\n    } else if h >= 300.0f32 && h < 360.0f32 {\n        write(c + m, m, x + m);\n    } else {\n        write(m, m, m);\n    }\n}\n","userModified":false}}
