{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01WpMo4ZrevdjDQ7YQSfU7Le","type":"tool_result","content":"1\t//! Emulation of C stdio buffering semantics.\n2\t//!\n3\t//! In C, `stdout` is fully buffered when it is not a terminal (the common case\n4\t//! when the program's output is captured/piped) and line buffered when it is a\n5\t//! terminal.  `stderr` is always unbuffered.  Reproducing this exactly matters\n6\t//! because the C program writes to both streams, and the relative ordering of\n7\t//! the two streams in a merged capture depends on that buffering.\n8\t\n9\tuse std::cell::RefCell;\n10\tuse std::io::{IsTerminal, Write};\n11\t\n12\tpub struct StdoutBuf {\n13\t    buf: Vec<u8>,\n14\t    line_buffered: bool,\n15\t}\n16\t\n17\timpl StdoutBuf {\n18\t    fn new() -> Self {\n19\t        StdoutBuf {\n20\t            buf: Vec::new(),\n21\t            line_buffered: std::io::stdout().is_terminal(),\n22\t        }\n23\t    }\n24\t\n25\t    fn push(&mut self, bytes: &[u8]) {\n26\t        self.buf.extend_from_slice(bytes);\n27\t        if self.line_buffered {\n28\t            self.flush_complete_lines();\n29\t        }\n30\t    }\n31\t\n32\t    fn flush_complete_lines(&mut self) {\n33\t        if let Some(pos) = self.buf.iter().rposition(|&c| c == b'\\n') {\n34\t            let stdout = std::io::stdout();\n35\t            let mut lock = stdout.lock();\n36\t            let _ = lock.write_all(&self.buf[..=pos]);\n37\t            let _ = lock.flush();\n38\t            self.buf.drain(..=pos);\n39\t        }\n40\t    }\n41\t\n42\t    fn flush_all(&mut self) {\n43\t        if !self.buf.is_empty() {\n44\t            let stdout = std::io::stdout();\n45\t            let mut lock = stdout.lock();\n46\t            let _ = lock.write_all(&self.buf);\n47\t            let _ = lock.flush();\n48\t            self.buf.clear();\n49\t        }\n50\t    }\n51\t}\n52\t\n53\tthread_local! {\n54\t    static OUT: RefCell<StdoutBuf> = RefCell::new(StdoutBuf::new());\n55\t}\n56\t\n57\t/// `printf`-like write of already formatted text to stdout.\n58\tpub fn out_str(s: &str) {\n59\t    OUT.with(|o| o.borrow_mut().push(s.as_bytes()));\n60\t}\n61\t\n62\t/// Write raw bytes to stdout (used for `%s` of a C `char` buffer).\n63\tpub fn out_bytes(b: &[u8]) {\n64\t    OUT.with(|o| o.borrow_mut().push(b));\n65\t}\n66\t\n67\t/// Flush stdout, as the C runtime does at normal process exit.\n68\tpub fn flush() {\n69\t    OUT.with(|o| o.borrow_mut().flush_all());\n70\t}\n71\t\n72\t/// `printf(...)` to stdout, honoring C's buffering rules.\n73\t#[macro_export]\n74\tmacro_rules! c_printf {\n75\t    ($($arg:tt)*) => {{\n76\t        $crate::cio::out_str(&format!($($arg)*));\n77\t    }};\n78\t}\n79\t\n80\t/// `fprintf(stderr, ...)`: stderr is unbuffered in C, so write immediately.\n81\t#[macro_export]\n82\tmacro_rules! c_eprintf {\n83\t    ($($arg:tt)*) => {{\n84\t        use std::io::Write;\n85\t        let stderr = std::io::stderr();\n86\t        let mut lock = stderr.lock();\n87\t        let _ = lock.write_all(format!($($arg)*).as_bytes());\n88\t        let _ = lock.flush();\n89\t    }};\n90\t}\n91\t\n92\t/// `assert()` from <assert.h>: on failure glibc prints a diagnostic to stderr\n93\t/// and calls abort(), which does *not* flush the buffered stdout stream.\n94\t#[macro_export]\n95\tmacro_rules! c_assert {\n96\t    ($cond:expr, $func:expr) => {{\n97\t        if !$cond {\n98\t            $crate::c_eprintf!(\n99\t                \"driver: main.c:{}: {}: Assertion `{}' failed.\\n\",\n100\t                line!(),\n101\t                $func,\n102\t                stringify!($cond)\n103\t            );\n104\t            std::process::abort();\n105\t        }\n106\t    }};\n107\t}\n108\t"}]},"parent_tool_use_id":null,"session_id":"82aa6a75-5b1d-4e0e-b649-b29b8cb5a220","uuid":"e5c91a0b-18a9-4515-bc8c-64930bad3891","timestamp":"2026-08-28T01:33:40.603Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-oBy85l/translation/src/cio.rs","content":"//! Emulation of C stdio buffering semantics.\n//!\n//! In C, `stdout` is fully buffered when it is not a terminal (the common case\n//! when the program's output is captured/piped) and line buffered when it is a\n//! terminal.  `stderr` is always unbuffered.  Reproducing this exactly matters\n//! because the C program writes to both streams, and the relative ordering of\n//! the two streams in a merged capture depends on that buffering.\n\nuse std::cell::RefCell;\nuse std::io::{IsTerminal, Write};\n\npub struct StdoutBuf {\n    buf: Vec<u8>,\n    line_buffered: bool,\n}\n\nimpl StdoutBuf {\n    fn new() -> Self {\n        StdoutBuf {\n            buf: Vec::new(),\n            line_buffered: std::io::stdout().is_terminal(),\n        }\n    }\n\n    fn push(&mut self, bytes: &[u8]) {\n        self.buf.extend_from_slice(bytes);\n        if self.line_buffered {\n            self.flush_complete_lines();\n        }\n    }\n\n    fn flush_complete_lines(&mut self) {\n        if let Some(pos) = self.buf.iter().rposition(|&c| c == b'\\n') {\n            let stdout = std::io::stdout();\n            let mut lock = stdout.lock();\n            let _ = lock.write_all(&self.buf[..=pos]);\n            let _ = lock.flush();\n            self.buf.drain(..=pos);\n        }\n    }\n\n    fn flush_all(&mut self) {\n        if !self.buf.is_empty() {\n            let stdout = std::io::stdout();\n            let mut lock = stdout.lock();\n            let _ = lock.write_all(&self.buf);\n            let _ = lock.flush();\n            self.buf.clear();\n        }\n    }\n}\n\nthread_local! {\n    static OUT: RefCell<StdoutBuf> = RefCell::new(StdoutBuf::new());\n}\n\n/// `printf`-like write of already formatted text to stdout.\npub fn out_str(s: &str) {\n    OUT.with(|o| o.borrow_mut().push(s.as_bytes()));\n}\n\n/// Write raw bytes to stdout (used for `%s` of a C `char` buffer).\npub fn out_bytes(b: &[u8]) {\n    OUT.with(|o| o.borrow_mut().push(b));\n}\n\n/// Flush stdout, as the C runtime does at normal process exit.\npub fn flush() {\n    OUT.with(|o| o.borrow_mut().flush_all());\n}\n\n/// `printf(...)` to stdout, honoring C's buffering rules.\n#[macro_export]\nmacro_rules! c_printf {\n    ($($arg:tt)*) => {{\n        $crate::cio::out_str(&format!($($arg)*));\n    }};\n}\n\n/// `fprintf(stderr, ...)`: stderr is unbuffered in C, so write immediately.\n#[macro_export]\nmacro_rules! c_eprintf {\n    ($($arg:tt)*) => {{\n        use std::io::Write;\n        let stderr = std::io::stderr();\n        let mut lock = stderr.lock();\n        let _ = lock.write_all(format!($($arg)*).as_bytes());\n        let _ = lock.flush();\n    }};\n}\n\n/// `assert()` from <assert.h>: on failure glibc prints a diagnostic to stderr\n/// and calls abort(), which does *not* flush the buffered stdout stream.\n#[macro_export]\nmacro_rules! c_assert {\n    ($cond:expr, $func:expr) => {{\n        if !$cond {\n            $crate::c_eprintf!(\n                \"driver: main.c:{}: {}: Assertion `{}' failed.\\n\",\n                line!(),\n                $func,\n                stringify!($cond)\n            );\n            std::process::abort();\n        }\n    }};\n}\n","numLines":108,"startLine":1,"totalLines":108}}}
