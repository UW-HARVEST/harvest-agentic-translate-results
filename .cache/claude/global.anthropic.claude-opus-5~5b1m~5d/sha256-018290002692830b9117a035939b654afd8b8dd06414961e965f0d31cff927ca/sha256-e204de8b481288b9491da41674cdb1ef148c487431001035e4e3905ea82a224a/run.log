{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01QrefyfSStCduNXHoXUU8gV","type":"tool_result","content":"1\t//! Faithful translation of c_src/src/tree.c and c_src/include/tree.h.\n2\t//!\n3\t//! The C code stores `tree_node_t *` pointers in the hashmap and mutates nodes\n4\t//! through those pointers.  Here nodes live in an arena (`Vec<TreeNode>`) owned\n5\t//! by the tree and the hashmap stores arena indices, which gives the same\n6\t//! aliasing behavior without unsafe code.  Nodes \"freed\" by the C code are\n7\t//! simply left in the arena; they are unreachable because their id is removed\n8\t//! from the map, exactly as in C.\n9\t\n10\tuse crate::cio;\n11\tuse crate::hashmap::{Hashmap, TreeId};\n12\t\n13\tpub const MAX_CHILDREN: usize = 32;\n14\tpub const MAX_DATA_LENGTH: usize = 256;\n15\t\n16\t#[derive(Clone)]\n17\tpub struct TreeNode {\n18\t    pub id: TreeId,\n19\t    pub parent_id: TreeId,\n20\t    pub child_ids: [TreeId; MAX_CHILDREN],\n21\t    pub child_count: i32,\n22\t    pub data: [u8; MAX_DATA_LENGTH],\n23\t}\n24\t\n25\timpl TreeNode {\n26\t    fn new() -> Self {\n27\t        TreeNode {\n28\t            id: 0,\n29\t            parent_id: 0,\n30\t            child_ids: [0; MAX_CHILDREN],\n31\t            child_count: 0,\n32\t            data: [0; MAX_DATA_LENGTH],\n33\t        }\n34\t    }\n35\t\n36\t    /// The bytes of `data` up to (excluding) the terminating NUL, i.e. what\n37\t    /// printf(\"%s\") would emit.\n38\t    pub fn data_cstr(&self) -> &[u8] {\n39\t        let end = self\n40\t            .data\n41\t            .iter()\n42\t            .position(|&c| c == 0)\n43\t            .unwrap_or(MAX_DATA_LENGTH);\n44\t        &self.data[..end]\n45\t    }\n46\t}\n47\t\n48\t/// strncpy(dst, src, MAX_DATA_LENGTH - 1) followed by dst[MAX_DATA_LENGTH-1] = '\\0'\n49\tfn strncpy_bounded(dst: &mut [u8; MAX_DATA_LENGTH], src: &[u8]) {\n50\t    let n = MAX_DATA_LENGTH - 1;\n51\t    let mut i = 0;\n52\t    while i < n && i < src.len() {\n53\t        dst[i] = src[i];\n54\t        i += 1;\n55\t    }\n56\t    // strncpy zero-pads the remainder of the n bytes.\n57\t    while i < n {\n58\t        dst[i] = 0;\n59\t        i += 1;\n60\t    }\n61\t    dst[MAX_DATA_LENGTH - 1] = 0;\n62\t}\n63\t\n64\tpub struct Tree {\n65\t    pub node_map: Hashmap<usize>,\n66\t    pub root_id: TreeId,\n67\t    pub has_root: i32,\n68\t    pub node_count: usize,\n69\t    nodes: Vec<TreeNode>,\n70\t}\n71\t\n72\timpl Tree {\n73\t    /// tree_create()\n74\t    pub fn create() -> Self {\n75\t        Tree {\n76\t            node_map: Hashmap::create(),\n77\t            root_id: 0,\n78\t            has_root: 0,\n79\t            node_count: 0,\n80\t            nodes: Vec::new(),\n81\t        }\n82\t    }\n83\t\n84\t    /// tree_add_node()\n85\t    pub fn add_node(&mut self, id: TreeId, parent_id: TreeId, data: Option<&str>) -> i32 {\n86\t        // Check if node already exists\n87\t        if self.contains(id) != 0 {\n88\t            c_eprintf!(\"Error: Node with ID {} already exists\\n\", id);\n89\t            return -1;\n90\t        }\n91\t\n92\t        // Allocate new node\n93\t        let mut node = TreeNode::new();\n94\t\n95\t        node.id = id;\n96\t        node.parent_id = parent_id;\n97\t        node.child_count = 0;\n98\t\n99\t        if let Some(d) = data {\n100\t            strncpy_bounded(&mut node.data, d.as_bytes());\n101\t        } else {\n102\t            node.data[0] = 0;\n103\t        }\n104\t\n105\t        // If this is the first node, make it the root\n106\t        if self.has_root == 0 {\n107\t            self.root_id = id;\n108\t            self.has_root = 1;\n109\t            node.parent_id = 0; // Root has no parent\n110\t        } else {\n111\t            // Find parent and add this node as a child\n112\t            let parent = match self.get_node(parent_id) {\n113\t                Some(p) => p,\n114\t                None => {\n115\t                    c_eprintf!(\"Error: Parent node {} not found\\n\", parent_id);\n116\t                    return -1;\n117\t                }\n118\t            };\n119\t\n120\t            if self.nodes[parent].child_count as usize >= MAX_CHILDREN {\n121\t                c_eprintf!(\"Error: Parent has maximum children\\n\");\n122\t                return -1;\n123\t            }\n124\t\n125\t            let slot = self.nodes[parent].child_count as usize;\n126\t            self.nodes[parent].child_ids[slot] = id;\n127\t            self.nodes[parent].child_count += 1;\n128\t        }\n129\t\n130\t        // Add to hashmap\n131\t        let index = self.nodes.len();\n132\t        self.nodes.push(node);\n133\t        if self.node_map.put(id, index) != 0 {\n134\t            c_eprintf!(\"Error: Failed to add node to hashmap\\n\");\n135\t            return -1;\n136\t        }\n137\t\n138\t        self.node_count += 1;\n139\t        0\n140\t    }\n141\t\n142\t    /// tree_remove_subtree() (static helper in tree.c)\n143\t    fn remove_subtree(&mut self, id: TreeId) -> i32 {\n144\t        let node = match self.get_node(id) {\n145\t            Some(n) => n,\n146\t            None => return -1,\n147\t        };\n148\t\n149\t        // Recursively remove all children first\n150\t        let child_count = self.nodes[node].child_count;\n151\t        for i in 0..child_count {\n152\t            let child_id = self.nodes[node].child_ids[i as usize];\n153\t            self.remove_subtree(child_id);\n154\t        }\n155\t\n156\t        // Remove this node from hashmap\n157\t        let removed = self.node_map.remove(id);\n158\t        if removed.is_some() {\n159\t            self.node_count = self.node_count.wrapping_sub(1);\n160\t        }\n161\t\n162\t        0\n163\t    }\n164\t\n165\t    /// tree_remove_node()\n166\t    pub fn remove_node(&mut self, id: TreeId) -> i32 {\n167\t        let node = match self.get_node(id) {\n168\t            Some(n) => n,\n169\t            None => {\n170\t                c_eprintf!(\"Error: Node {} not found\\n\", id);\n171\t                return -1;\n172\t            }\n173\t        };\n174\t\n175\t        // If removing root, tree becomes empty\n176\t        if id == self.root_id {\n177\t            self.remove_subtree(id);\n178\t            self.has_root = 0;\n179\t            self.root_id = 0;\n180\t            return 0;\n181\t        }\n182\t\n183\t        // Remove from parent's child list\n184\t        let parent_id = self.nodes[node].parent_id;\n185\t        if let Some(parent) = self.get_node(parent_id) {\n186\t            let mut i = 0;\n187\t            while i < self.nodes[parent].child_count {\n188\t                if self.nodes[parent].child_ids[i as usize] == id {\n189\t                    // Shift remaining children\n190\t                    let mut j = i;\n191\t                    while j < self.nodes[parent].child_count - 1 {\n192\t                        self.nodes[parent].child_ids[j as usize] =\n193\t                            self.nodes[parent].child_ids[(j + 1) as usize];\n194\t                        j += 1;\n195\t                    }\n196\t                    self.nodes[parent].child_count -= 1;\n197\t                    break;\n198\t                }\n199\t                i += 1;\n200\t            }\n201\t        }\n202\t\n203\t        // Remove this node and all descendants\n204\t        self.remove_subtree(id);\n205\t\n206\t        0\n207\t    }\n208\t\n209\t    /// tree_get_node(): returns the arena index of the node, if present.\n210\t    pub fn get_node(&self, id: TreeId) -> Option<usize> {\n211\t        self.node_map.get(id)\n212\t    }\n213\t\n214\t    /// Borrow a node by its arena index.\n215\t    pub fn node(&self, index: usize) -> &TreeNode {\n216\t        &self.nodes[index]\n217\t    }\n218\t\n219\t    /// tree_contains()\n220\t    pub fn contains(&self, id: TreeId) -> i32 {\n221\t        if self.get_node(id).is_some() {\n222\t            1\n223\t        } else {\n224\t            0\n225\t        }\n226\t    }\n227\t\n228\t    /// tree_size()\n229\t    pub fn size(&self) -> usize {\n230\t        self.node_count\n231\t    }\n232\t\n233\t    /// tree_print_helper() (static helper in tree.c)\n234\t    fn print_helper(&self, id: TreeId, depth: i32) {\n235\t        let node = match self.get_node(id) {\n236\t            Some(n) => n,\n237\t            None => return,\n238\t        };\n239\t\n240\t        // Print indentation\n241\t        for _i in 0..depth {\n242\t            c_printf!(\"  \");\n243\t        }\n244\t\n245\t        c_printf!(\"[{}] \", self.nodes[node].id);\n246\t        cio::out_bytes(self.nodes[node].data_cstr());\n247\t        c_printf!(\"\\n\");\n248\t\n249\t        // Print children\n250\t        let child_count = self.nodes[node].child_count;\n251\t        for i in 0..child_count {\n252\t            let child_id = self.nodes[node].child_ids[i as usize];\n253\t            self.print_helper(child_id, depth + 1);\n254\t        }\n255\t    }\n256\t\n257\t    /// tree_print()\n258\t    pub fn print(&self) {\n259\t        if self.has_root == 0 {\n260\t            c_printf!(\"(empty tree)\\n\");\n261\t            return;\n262\t        }\n263\t\n264\t        self.print_helper(self.root_id, 0);\n265\t    }\n266\t\n267\t    /// tree_get_depth()\n268\t    pub fn get_depth(&self, id: TreeId) -> i32 {\n269\t        if self.contains(id) == 0 {\n270\t            return -1;\n271\t        }\n272\t\n273\t        let mut depth: i32 = 0;\n274\t        let mut current_id = id;\n275\t\n276\t        while current_id != self.root_id {\n277\t            let node = match self.get_node(current_id) {\n278\t                Some(n) => n,\n279\t                None => return -1,\n280\t            };\n281\t            current_id = self.nodes[node].parent_id;\n282\t            depth += 1;\n283\t        }\n284\t\n285\t        depth\n286\t    }\n287\t\n288\t    /// tree_get_height()\n289\t    pub fn get_height(&self, id: TreeId) -> i32 {\n290\t        let node = match self.get_node(id) {\n291\t            Some(n) => n,\n292\t            None => return -1,\n293\t        };\n294\t\n295\t        if self.nodes[node].child_count == 0 {\n296\t            return 0;\n297\t        }\n298\t\n299\t        let mut max_height: i32 = 0;\n300\t        for i in 0..self.nodes[node].child_count {\n301\t            let child_height = self.get_height(self.nodes[node].child_ids[i as usize]);\n302\t            if child_height > max_height {\n303\t                max_height = child_height;\n304\t            }\n305\t        }\n306\t\n307\t        max_height + 1\n308\t    }\n309\t\n310\t    /// tree_count_descendants()\n311\t    pub fn count_descendants(&self, id: TreeId) -> i32 {\n312\t        let node = match self.get_node(id) {\n313\t            Some(n) => n,\n314\t            None => return -1,\n315\t        };\n316\t\n317\t        let mut count: i32 = 0;\n318\t        for i in 0..self.nodes[node].child_count {\n319\t            count += 1; // Count the child\n320\t            count += self.count_descendants(self.nodes[node].child_ids[i as usize]);\n321\t        }\n322\t\n323\t        count\n324\t    }\n325\t\n326\t    /// tree_find_path()\n327\t    pub fn find_path(&self, id: TreeId, path: &mut [TreeId], max_length: i32) -> i32 {\n328\t        if self.contains(id) == 0 {\n329\t            return -1;\n330\t        }\n331\t\n332\t        // Build path from node to root, then reverse\n333\t        let mut temp_path: [TreeId; 1000] = [0; 1000];\n334\t        let mut length: i32 = 0;\n335\t        let mut current_id = id;\n336\t\n337\t        while length < 1000 {\n338\t            temp_path[length as usize] = current_id;\n339\t            length += 1;\n340\t\n341\t            if current_id == self.root_id {\n342\t                break;\n343\t            }\n344\t\n345\t            let node = match self.get_node(current_id) {\n346\t                Some(n) => n,\n347\t                None => return -1,\n348\t            };\n349\t            current_id = self.nodes[node].parent_id;\n350\t        }\n351