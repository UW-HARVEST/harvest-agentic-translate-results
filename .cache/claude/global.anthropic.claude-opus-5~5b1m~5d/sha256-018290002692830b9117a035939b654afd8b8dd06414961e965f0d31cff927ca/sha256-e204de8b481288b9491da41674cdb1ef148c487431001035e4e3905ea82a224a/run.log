{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01AJD23A5Q8NNi18VurrvSxo","type":"tool_result","content":"1\t//! Faithful translation of c_src/src/hashmap.c and c_src/include/hashmap.h.\n2\t//!\n3\t//! The C hashmap stores `void *` values; here the map is generic over a `Copy`\n4\t//! value type and `Option<V>` models the nullable pointer (`None` == `NULL`).\n5\t\n6\tpub const HASHMAP_INITIAL_CAPACITY: usize = 16;\n7\tpub const HASHMAP_LOAD_FACTOR: f64 = 0.75;\n8\t\n9\tpub type TreeId = u64;\n10\t\n11\t#[derive(Clone, Copy)]\n12\tpub struct HashmapEntry<V: Copy> {\n13\t    pub key: TreeId,\n14\t    pub value: Option<V>,\n15\t    pub occupied: bool,\n16\t    pub deleted: bool,\n17\t}\n18\t\n19\timpl<V: Copy> HashmapEntry<V> {\n20\t    /// calloc() zeroes the entry: key 0, NULL value, flags cleared.\n21\t    const fn zeroed() -> Self {\n22\t        HashmapEntry {\n23\t            key: 0,\n24\t            value: None,\n25\t            occupied: false,\n26\t            deleted: false,\n27\t        }\n28\t    }\n29\t}\n30\t\n31\tpub struct Hashmap<V: Copy> {\n32\t    pub entries: Vec<HashmapEntry<V>>,\n33\t    pub capacity: usize,\n34\t    pub size: usize,\n35\t    pub deleted_count: usize,\n36\t}\n37\t\n38\tfn hash_function(key: TreeId) -> u64 {\n39\t    // FNV-1a hash over the raw bytes of the key, in host byte order.\n40\t    let mut hash: u64 = 14695981039346656037;\n41\t    let bytes = key.to_ne_bytes();\n42\t\n43\t    for i in 0..std::mem::size_of::<TreeId>() {\n44\t        hash ^= bytes[i] as u64;\n45\t        hash = hash.wrapping_mul(1099511628211);\n46\t    }\n47\t\n48\t    hash\n49\t}\n50\t\n51\timpl<V: Copy> Hashmap<V> {\n52\t    fn should_resize(&self) -> bool {\n53\t        let load = (self.size + self.deleted_count) as f64 / self.capacity as f64;\n54\t        load > HASHMAP_LOAD_FACTOR\n55\t    }\n56\t\n57\t    fn resize(&mut self) -> i32 {\n58\t        let old_capacity = self.capacity;\n59\t        let old_entries = std::mem::take(&mut self.entries);\n60\t\n61\t        // Double capacity\n62\t        self.capacity *= 2;\n63\t        self.entries = vec![HashmapEntry::zeroed(); self.capacity];\n64\t\n65\t        self.size = 0;\n66\t        self.deleted_count = 0;\n67\t\n68\t        // Rehash all entries\n69\t        for i in 0..old_capacity {\n70\t            if old_entries[i].occupied && !old_entries[i].deleted {\n71\t                self.put_value(old_entries[i].key, old_entries[i].value);\n72\t            }\n73\t        }\n74\t\n75\t        0\n76\t    }\n77\t\n78\t    /// hashmap_create()\n79\t    pub fn create() -> Self {\n80\t        Hashmap {\n81\t            entries: vec![HashmapEntry::zeroed(); HASHMAP_INITIAL_CAPACITY],\n82\t            capacity: HASHMAP_INITIAL_CAPACITY,\n83\t            size: 0,\n84\t            deleted_count: 0,\n85\t        }\n86\t    }\n87\t\n88\t    /// hashmap_put()\n89\t    pub fn put(&mut self, key: TreeId, value: V) -> i32 {\n90\t        self.put_value(key, Some(value))\n91\t    }\n92\t\n93\t    fn put_value(&mut self, key: TreeId, value: Option<V>) -> i32 {\n94\t        if self.should_resize() {\n95\t            if self.resize() != 0 {\n96\t                return -1;\n97\t            }\n98\t        }\n99\t\n100\t        let hash = hash_function(key);\n101\t        let index = (hash % self.capacity as u64) as usize;\n102\t        let mut probe: usize = 0;\n103\t\n104\t        // Linear probing\n105\t        while probe < self.capacity {\n106\t            let current = (index + probe) % self.capacity;\n107\t\n108\t            if !self.entries[current].occupied {\n109\t                // Empty slot\n110\t                self.entries[current].key = key;\n111\t                self.entries[current].value = value;\n112\t                self.entries[current].occupied = true;\n113\t                self.entries[current].deleted = false;\n114\t                self.size += 1;\n115\t                return 0;\n116\t            } else if self.entries[current].deleted {\n117\t                // Reuse deleted slot\n118\t                self.entries[current].key = key;\n119\t                self.entries[current].value = value;\n120\t                self.entries[current].deleted = false;\n121\t                self.size += 1;\n122\t                self.deleted_count -= 1;\n123\t                return 0;\n124\t            } else if self.entries[current].key == key {\n125\t                // Update existing\n126\t                self.entries[current].value = value;\n127\t                return 0;\n128\t            }\n129\t\n130\t            probe += 1;\n131\t        }\n132\t\n133\t        -1 // Map is full (shouldn't happen with resizing)\n134\t    }\n135\t\n136\t    /// hashmap_get()\n137\t    pub fn get(&self, key: TreeId) -> Option<V> {\n138\t        let hash = hash_function(key);\n139\t        let index = (hash % self.capacity as u64) as usize;\n140\t        let mut probe: usize = 0;\n141\t\n142\t        while probe < self.capacity {\n143\t            let current = (index + probe) % self.capacity;\n144\t\n145\t            if !self.entries[current].occupied {\n146\t                return None;\n147\t            }\n148\t\n149\t            if !self.entries[current].deleted && self.entries[current].key == key {\n150\t                return self.entries[current].value;\n151\t            }\n152\t\n153\t            probe += 1;\n154\t        }\n155\t\n156\t        None\n157\t    }\n158\t\n159\t    /// hashmap_remove()\n160\t    pub fn remove(&mut self, key: TreeId) -> Option<V> {\n161\t        let hash = hash_function(key);\n162\t        let index = (hash % self.capacity as u64) as usize;\n163\t        let mut probe: usize = 0;\n164\t\n165\t        while probe < self.capacity {\n166\t            let current = (index + probe) % self.capacity;\n167\t\n168\t            if !self.entries[current].occupied {\n169\t                return None;\n170\t            }\n171\t\n172\t            if !self.entries[current].deleted && self.entries[current].