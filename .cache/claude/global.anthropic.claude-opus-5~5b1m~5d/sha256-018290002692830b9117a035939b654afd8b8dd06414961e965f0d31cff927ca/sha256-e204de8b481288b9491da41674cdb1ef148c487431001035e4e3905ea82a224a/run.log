{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Ru7nYjDzi6D758q8CNgY8m","type":"tool_result","content":"The file /local/home/scheschb/.harvest/work/harvest-work-oBy85l/translation/src/hashmap.rs has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"82aa6a75-5b1d-4e0e-b649-b29b8cb5a220","uuid":"db5e921f-18d8-4580-9acb-1f25fe6eddcd","timestamp":"2026-08-28T01:43:24.184Z","tool_use_result":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-oBy85l/translation/src/hashmap.rs","oldString":"    fn put_value(&mut self, key: TreeId, value: Option<V>) -> i32 {","newString":"    /// hashmap_put() where the C `void *value` may be NULL (`None`). The C code\n    /// happily stores a NULL value: it counts toward `size`, but `hashmap_get`\n    /// then returns NULL for the key and `hashmap_contains` reports 0.\n    pub fn put_value(&mut self, key: TreeId, value: Option<V>) -> i32 {","originalFile":"//! Faithful translation of c_src/src/hashmap.c and c_src/include/hashmap.h.\n//!\n//! The C hashmap stores `void *` values; here the map is generic over a `Copy`\n//! value type and `Option<V>` models the nullable pointer (`None` == `NULL`).\n\npub const HASHMAP_INITIAL_CAPACITY: usize = 16;\npub const HASHMAP_LOAD_FACTOR: f64 = 0.75;\n\npub type TreeId = u64;\n\n#[derive(Clone, Copy)]\npub struct HashmapEntry<V: Copy> {\n    pub key: TreeId,\n    pub value: Option<V>,\n    pub occupied: bool,\n    pub deleted: bool,\n}\n\nimpl<V: Copy> HashmapEntry<V> {\n    /// calloc() zeroes the entry: key 0, NULL value, flags cleared.\n    const fn zeroed() -> Self {\n        HashmapEntry {\n            key: 0,\n            value: None,\n            occupied: false,\n            deleted: false,\n        }\n    }\n}\n\npub struct Hashmap<V: Copy> {\n    pub entries: Vec<HashmapEntry<V>>,\n    pub capacity: usize,\n    pub size: usize,\n    pub deleted_count: usize,\n}\n\nfn hash_function(key: TreeId) -> u64 {\n    // FNV-1a hash over the raw bytes of the key, in host byte order.\n    let mut hash: u64 = 14695981039346656037;\n    let bytes = key.to_ne_bytes();\n\n    for i in 0..std::mem::size_of::<TreeId>() {\n        hash ^= bytes[i] as u64;\n        hash = hash.wrapping_mul(1099511628211);\n    }\n\n    hash\n}\n\nimpl<V: Copy> Hashmap<V> {\n    fn should_resize(&self) -> bool {\n        let load = (self.size + self.deleted_count) as f64 / self.capacity as f64;\n        load > HASHMAP_LOAD_FACTOR\n    }\n\n    fn resize(&mut self) -> i32 {\n        let old_capacity = self.capacity;\n        let old_entries = std::mem::take(&mut self.entries);\n\n        // Double capacity\n        self.capacity *= 2;\n        self.entries = vec![HashmapEntry::zeroed(); self.capacity];\n\n        self.size = 0;\n        self.deleted_count = 0;\n\n        // Rehash all entries\n        for i in 0..old_capacity {\n            if old_entries[i].occupied && !old_entries[i].deleted {\n                self.put_value(old_entries[i].key, old_entries[i].value);\n            }\n        }\n\n        0\n    }\n\n    /// hashmap_create()\n    pub fn create() -> Self {\n        Hashmap {\n            entries: vec![HashmapEntry::zeroed(); HASHMAP_INITIAL_CAPACITY],\n            capacity: HASHMAP_INITIAL_CAPACITY,\n            size: 0,\n            deleted_count: 0,\n        }\n    }\n\n    /// hashmap_put()\n    pub fn put(&mut self, key: TreeId, value: V) -> i32 {\n        self.put_value(key, Some(value))\n    }\n\n    fn put_value(&mut self, key: TreeId, value: Option<V>) -> i32 {\n        if self.should_resize() {\n            if self.resize() != 0 {\n                return -1;\n            }\n        }\n\n        let hash = hash_function(key);\n        let index = (hash % self.capacity as u64) as usize;\n        let mut probe: usize = 0;\n\n        // Linear probing\n        while probe < self.capacity {\n            let current = (index + probe) % self.capacity;\n\n            if !self.entries[current].occupied {\n                // Empty slot\n                self.entries[current].key = key;\n                self.entries[current].value = value;\n                self.entries[current].occupied = true;\n                self.entries[current].deleted = false;\n                self.size += 1;\n                return 0;\n            } else if self.entries[current].deleted {\n                // Reuse deleted slot\n                self.entries[current].key = key;\n                self.entries[current].value = value;\n                self.entries[current].deleted = false;\n                self.size += 1;\n                self.deleted_count -= 1;\n                return 0;\n            } else if self.entries[current].key == key {\n                // Update existing\n                self.entries[current].value = value;\n                return 0;\n            }\n\n            probe += 1;\n        }\n\n        -1 // Map is full (shouldn't happen with resizing)\n    }\n\n    /// hashmap_get()\n    pub fn get(&self, key: TreeId) -> Option<V> {\n        let hash = hash_function(key);\n        let index = (hash % self.capacity as u64) as usize;\n        let mut probe: usize = 0;\n\n        while probe < self.capacity {\n            let current = (index + probe) % self.capacity;\n\n            if !self.entries[current].occupied {\n                return None;\n            }\n\n            if !self.entries[current].deleted && self.entries[current].key == key {\n                return self.entries[current].value;\n            }\n\n            probe += 1;\n        }\n\n        None\n    }\n\n    /// hashmap_remove()\n    pub fn remove(&mut self, key: TreeId) -> Option<V> {\n        let hash = hash_function(key);\n        let index = (hash % self.capacity as u64) as usize;\n        let mut probe: usize = 0;\n\n        while probe < self.capacity {\n            let current = (index + probe) % self.capacity;\n\n            if !self.entries[current].occupied {\n                return None;\n            }\n\n            if !self.entries[current].deleted && self.entries[current].key == key {\n                let value = self.entries[current].value;\n                self.entries[current].deleted = true;\n                self.size = self.size.wrapping_sub(1);\n                self.deleted_count += 1;\n                return value;\n            }\n\n            probe += 1;\n        }\n\n        None\n    }\n\n    /// hashmap_contains()\n    pub fn contains(&self, key: TreeId) -> i32 {\n        if self.get(key).is_some() {\n            1\n        } else {\n            0\n        }\n    }\n\n    /// hashmap_size()\n    pub fn size(&self) -> usize {\n        self.size\n    }\n\n    /// hashmap_clear()\n    #[allow(dead_code)]\n    pub fn clear(&mut self) {\n        for i in 0..self.capacity {\n            self.entries[i].occupied = false;\n            self.entries[i].deleted = false;\n        }\n\n        self.size = 0;\n        self.deleted_count = 0;\n    }\n}\n","structuredPatch":[{"oldStart":90,"oldLines":7,"newStart":90,"newLines":10,"lines":["         self.put_value(key, Some(value))","     }"," ","-    fn put_value(&mut self, key: TreeId, value: Option<V>) -> i32 {","+    /// hashmap_put() where the C `void *value` may be NULL (`None`). The C code","+    /// happily stores a NULL value: it counts toward `size`, but `hashmap_get`","+    /// then returns NULL for the key and `hashmap_contains` reports 0.","+    pub fn put_value(&mut self, key: TreeId, value: Option<V>) -> i32 {","         if self.should_resize() {","             if self.resize() != 0 {","                 return -1;"]}],"userModified":false,"replaceAll":false}}
