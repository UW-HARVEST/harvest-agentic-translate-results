// ---------------------------------------------------------------------------\n40\tmod ffi {\n41\t    use std::ffi::{c_char, c_int, c_long};\n42\t\n43\t    unsafe extern \"C\" {\n44\t        pub unsafe fn printf(fmt: *const c_char, ...) -> c_int;\n45\t\n46\t        pub unsafe fn strtol(nptr: *const c_char, endptr: *mut *mut c_char, base: c_int)\n47\t        -> c_long;\n48\t\n49\t        pub unsafe fn __errno_location() -> *mut c_int;\n50\t    }\n51\t}\n52\t\n53\t#[inline]\n54\tfn errno_ptr() -> *mut c_int {\n55\t    unsafe { ffi::__errno_location() }\n56\t}\n57\t\n58\t#[inline]\n59\tfn get_errno() -> c_int {\n60\t    unsafe { *errno_ptr() }\n61\t}\n62\t\n63\t#[inline]\n64\tfn set_errno(v: c_int) {\n65\t    unsafe { *errno_ptr() = v };\n66\t}\n67\t\n68\t// C: #define INT_MIN / INT_MAX  (as `long` values, matching the C comparison)\n69\tconst C_INT_MIN: c_long = c_int::MIN as c_long;\n70\tconst C_INT_MAX: c_long = c_int::MAX as c_long;\n71\t\n72\t// ---------------------------------------------------------------------------\n73\t// typedef struct {\n74\t//     int floors;\n75\t//     int bedrooms;\n76\t//     double bathrooms;\n77\t// } house_t;\n78\t// ---------------------------------------------------------------------------\n79\t#[repr(C)]\n80\tpub struct house_t {\n81\t    pub floors: c_int,\n82\t    pub bedrooms: c_int,\n83\t    pub bathrooms: c_double,\n84\t}\n85\t\n86\t// static void add_floor(house_t *house)\n87\tfn add_floor(house: &mut house_t) {\n88\t    // house->floors++;\n89\t    house.floors = house.floors.wrapping_add(1);\n90\t}\n91\t\n92\t// static void add_bedrooms(house_t *house, int extra_bedrooms)\n93\tfn add_bedrooms(house: &mut house_t, extra_bedrooms: c_int) {\n94\t    // house->bedrooms += extra_bedrooms;\n95\t    house.bedrooms = house.bedrooms.wrapping_add(extra_bedrooms);\n96\t}\n97\t\n98\t// static void print_house(house_t *house)\n99\tfn print_house(house: &house_t) {\n100\t    // printf(\"The house has %d floors, %d bedrooms, and %.1f bathrooms\\n\", ...)\n101\t    const FMT: &[u8] =\n102\t        b\"The house has %d floors, %d bedrooms, and %.1f bathrooms\\n\\0\";\n103\t    unsafe {\n104\t        ffi::printf(\n105\t            FMT.as_ptr() as *const c_char,\n106\t            house.floors,\n107\t            house.bedrooms,\n108\t            house.bathrooms,\n109\t        );\n110\t    }\n111\t}\n112\t\n113\t// static bool parse_val(const char *str, int *val)\n114\tfn parse_val(str: *const c_char, val: &mut c_int) -> bool {\n115\t    set_errno(0);\n116\t    let mut endp: *mut c_char = str as *mut c_char;\n117\t    let tmp: c_long = unsafe { ffi::strtol(str, &mut endp, 10) };\n118\t    if endp != (str as *mut c_char) && get_errno() == 0 && tmp >= C_INT_MIN && tmp <= C_INT_MAX {\n119\t        // *val = tmp;  (implicit long -> int conversion)\n120\t        *val = tmp as c_int;\n121\t        true\n122\t    } else {\n123\t        false\n124\t    }\n125\t}\n126\t\n127\t// void run(house_t *the_house, int extra_bedrooms)\n128\t#[unsafe(no_mangle)]\n129\tpub unsafe extern \"C\" fn run(the_house: *mut house_t, extra_bedrooms: c_int) {\n130\t    let house = unsafe { &mut *the_house };\n131\t    print_house(house);\n132\t    add_floor(house);\n133\t    print_house(house);\n134\t    // the_house->bathrooms += 1.0;\n135\t    house.bathrooms += 1.0;\n136\t    print_house(house);\n137\t    add_bedrooms(house, extra_bedrooms);\n138\t    print_house(house);\n139\t}\n140\t\n141\t// void driver(const char *in)\n142\t#[unsafe(no_mangle)]\n143\tpub unsafe extern \"C\" fn driver(in_: *const c_char) {\n144\t    let mut x: c_int = 0;\n145\t    if parse_val(in_, &mut x) {\n146\t        let mut the_house = house_t {\n147\t            floors: 2,\n148\t            bedrooms: 5,\n149\t            bathrooms: 2.5,\n150\t        };\n151\t        unsafe {\n152\t            run(&mut the_house, x);\n153\t            run(&mut the_house, x);\n154\t        }\n155\t    } else {\n156\t        const MSG: &[u8] = b\"An error occurred\\n\\0\