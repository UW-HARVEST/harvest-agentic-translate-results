"printf\",\n        \"puts\",\n        \"strtol\",\n        \"__errno_location\",\n        \"memcpy\",\n        \"memmove\",\n        \"memset\",\n        \"memcmp\",\n        \"bcmp\",\n        \"strlen\",\n        \"abort\",\n        \"__cxa_finalize\",\n        \"__gmon_start__\",\n        \"_ITM_deregisterTMCloneTable\",\n        \"_ITM_registerTMCloneTable\",\n        \"__tls_get_addr\",\n        \"_Unwind_Resume\",\n        \"__stack_chk_fail\",\n        \"calloc\",\n        \"malloc\",\n        \"free\",\n        \"realloc\",\n        \"posix_memalign\",\n        \"write\",\n        \"writev\",\n    ]\n    .into_iter()\n    .collect();\n\n    let unexpected: Vec<_> = und\n        .iter()\n        .filter(|s| !allowed.contains(s.as_str()))\n        .cloned()\n        .collect();\n    assert!(\n        unexpected.is_empty(),\n        \"Rust .so has unresolved non-libc symbol(s): {unexpected:?}\\nall undefined: {und:?}\"\n    );\n\n    // And confirm it can be fully resolved by the dynamic linker.\n    let out = Command::new(\"ldd\")\n        .args([\"-r\", &rs])\n        .output()\n        .expect(\"run ldd -r\");\n    let text = format!(\n        \"{}{}\",\n        String::from_utf8_lossy(&out.stdout),\n        String::from_utf8_lossy(&out.stderr)\n    );\n    assert!(\n        !text.contains(\"undefined symbol\"),\n        \"ldd -r reported undefined symbols in the Rust .so:\\n{text}\"\n    );\n}\n\n#[test]\nfn c_so_imports_are_all_satisfiable_too() {\n    // Sanity: the same check on the C side, so a divergence in the *import*\n    // surface (e.g. the printf->puts rewrite) is visible in the report.\n    let c = c_so_str();\n    let und = undefined(&c);\n    assert!(\n        und.contains(\"strtol\"),\n        \"expected the C .so to import strtol; got {und:?}\"\n    );\n    assert!(\n        und.contains(\"printf\") || und.contains(\"puts\"),\n        \"expected the C .so to import printf and/or puts; got {und:?}\"\n    );\n}\n","structuredPatch":[],"origin