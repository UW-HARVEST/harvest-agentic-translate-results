{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01X5FCPLUEfJYQpQ4nYpPiSz","type":"tool_result","content":"1\t// Rust translation of the C library in c_src/.\n2\t//\n3\t// Original copyright notice from the C sources:\n4\t//\n5\t// Copyright 2025 MIT Lincoln Laboratory\n6\t// Permission is hereby granted, free of charge,\n7\t// to any person obtaining a copy of this software\n8\t// and associated documentation files (the \"Software\"),\n9\t// to deal in the Software without restriction,\n10\t// including without limitation the rights to use, copy,\n11\t// modify, merge, publish, distribute, sublicense,\n12\t// and/or sell copies of the Software,\n13\t// and to permit persons to whom the Software is furnished to do so,\n14\t// subject to the following conditions:\n15\t//\n16\t// The above copyright notice and this permission notice\n17\t// shall be included in all copies or substantial portions of the Software.\n18\t//\n19\t// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n20\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n21\t// THE WARRANTIES OF MERCHANTABILITY,\n22\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n23\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n24\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n25\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n26\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n27\t\n28\t#![allow(non_camel_case_types)]\n29\t\n30\tuse std::ffi::{c_char, c_double, c_int, c_long};\n31\t\n32\t// ---------------------------------------------------------------------------\n33\t// libc bindings\n34\t//\n35\t// The C code writes to stdout via `printf` and parses integers via `strtol`.\n36\t// We call straight through to the platform C library so that both the exact\n37\t// byte formatting *and* the stdio buffering behaviour are bit-for-bit\n38\t// identical to the original library.\n39\t// ---------------------------------------------------------------------------\n40\tmod ffi {\n41\t    use std::ffi::{c_char, c_int, c_long};\n42\t\n43\t    unsafe extern \"C\" {\n44\t        pub unsafe fn printf(fmt: *const c_char, ...) -> c_int;\n45\t\n46\t        pub unsafe fn strtol(nptr: *const c_char, endptr: *mut *mut c_char, base: c_int)\n47\t        -> c_long;\n48\t\n49\t        pub unsafe fn __errno_location() -> *mut c_int;\n50\t    }\n51\t}\n52\t\n53\t#[inline]\n54\tfn errno_ptr() -> *mut c_int {\n55\t    unsafe { ffi::__errno_location() }\n56\t}\n57\t\n58\t#[inline]\n59\tfn get_errno() -> c_int {\n60\t    unsafe { *errno_ptr() }\n61\t}\n62\t\n63\t#[inline]\n64\tfn set_errno(v: c_int) {\n65\t    unsafe { *errno_ptr() = v };\n66\t}\n67\t\n68\t// C: #define INT_MIN / INT_MAX  (as `long` values, matching the C comparison)\n69\tconst C_INT_MIN: c_long = c_int::MIN as c_long;\n70\tconst C_INT_MAX: c_long = c_int::MAX as c_long;\n71\t\n72\t// ---------------------------------------------------------------------------\n73\t// typedef struct {\n74\t//     int floors;\n75\t//     int bedrooms;\n76\t//     double bathrooms;\n77\t// } house_t;\n78\t// ---------------------------------------------------------------------------\n79\t#[repr(C)]\n80\tpub struct house_t {\n81\t    pub floors: c_int,\n82\t    pub bedrooms: c_int,\n83\t    pub bathrooms: c_double,\n84\t}\n85\t\n86\t// static void add_floor(house_t *house)\n87\tfn add_floor(house: &mut house_t) {\n88\t    // house->floors++;\n89\t    house.floors = house.floors.wrapping_add(1);\n90\t}\n91\t\n92\t// static void add_bedrooms(house_t *house, int extra_bedrooms)\n93\tfn add_bedrooms(house: &mut house_t, extra_bedrooms: c_int) {\n94\t    // house->bedrooms += extra_bedrooms;\n95\t    house.bedrooms = house.bedrooms.wrapping_add(extra_bedrooms);\n96\t}\n97\t\n98\t// static void print_house(house_t *house)\n99\tfn print_house(house: &house_t) {\n100\t    // printf(\"The house has %d floors, %d bedrooms, and %.1f bathrooms\\n\", ...)\n101\t    const FMT: &[u8] =\n102\t        b\"The house has %d floors, %d bedrooms, and %.1f bathrooms\\n\\0\";\n103\t    unsafe {\n104\t        ffi::printf(\n105\t            FMT.as_ptr() as *const c_char,\n106\t            house.floors,\n107\t            house.bedrooms,\n108\t            house.bathrooms,\n109\t        );\n110\t    }\n111\t}\n112\t\n113\t// static bool parse_val(const char *str, int *val)\n114\tfn parse_val(str: *const c_char, val: &mut c_int) -> bool {\n115\t    set_errno(0);\n116\t    let mut endp: *mut c_char = str as *mut c_char;\n117\t    let tmp: c_long = unsafe { ffi::strtol(str, &mut endp, 10) };\n118\t    if endp != (str as *mut c_char) && get_errno() == 0 && tmp >= C_INT_MIN && tmp <= C_INT_MAX {\n119\t        // *val = tmp;  (implicit long -> int conversion)\n120\t        *val = tmp as c_int;\n121\t        true\n122\t    } else {\n123\t        false\n124\t    }\n125\t}\n126\t\n127\t// void run(house_t *the_house, int extra_bedrooms)\n128\t#[unsafe(no_mangle)]\n129\tpub unsafe extern \"C\" fn run(the_house: *mut house_t, extra_bedrooms: c_int) {\n130\t    let house = unsafe { &mut *the_house };\n131\t    print_house(house);\n132\t    add_floor(house);\n133\t    print_house(house);\n134\t    // the_house->bathrooms += 1.0;\n135\t    house.bathrooms += 1.0;\n136\t    print_house(house);\n137\t    add_bedrooms(house, extra_bedrooms);\n138\t    print_house(house);\n139\t}\n140\t\n141\t// void driver(const char *in)\n142\t#[unsafe(no_mangle)]\n143\tpub unsafe extern \"C\" fn driver(in_: *const c_char) {\n144\t    let mut x: c_int = 0;\n145\t    if parse_val(in_, &mut x) {\n146\t        let mut the_house = house_t {\n147\t            floors: 2,\n148\t            bedrooms: 5,\n149\t            bathrooms: 2.5,\n150\t        };\n151\t        unsafe {\n152\t            run(&mut the_house, x);\n153\t            run(&mut the_house, x);\n154\t        }\n155\t    } else {\n156\t        const MSG: &[u8] = b\"An error occurred\\n\\0\