{p:?} is newer than {so:?}.\\n\\\n                 This crate's only crate-type is `cdylib`, and `cargo test` does NOT rebuild \\\n                 the cdylib, so the suite would be comparing against an OUT-OF-DATE Rust .so.\\n\\\n                 Run `cargo build` (or `cargo build --release`) before `cargo test`, or just \\\n                 use ./run_all.sh which does both.\"\n            );\n        }\n    }\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2763,"cache_read_input_tokens":135914,"cache_creation":{"ephemeral_5m_input_tokens":2763,"ephemeral_1h_input_tokens":0},"output_tokens":5,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"37ad3814-120d-4cd3-86a4-b047164fbfba","uuid":"201d800b-e7a8-490d-8217-eb0a9ca684ac","timestamp":"2026-09-03T11:39:25.648Z"}
