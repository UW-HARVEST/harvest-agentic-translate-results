e_creation_input_tokens":2077,"cache_read_input_tokens":99637,"cache_creation":{"ephemeral_5m_input_tokens":2077,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"94ecab56-1cd7-404d-a102-e9551ae25aff","uuid":"708e1cbe-a23e-40ae-b210-f7ef46267879","timestamp":"2026-08-26T20:52:37.136Z"}
