false, so the C intentionally does NOT free the strdup'd key\n        (\"strdup map, mode=2 (C leaks by design)\", Box::new(|a: &Api| map_workload(a, SH_STRDUP, 2, 60, 40, 300))),\n        (\"strdup map, mode=7 (C leaks by design)\", Box::new(|a: &Api| map_workload(a, SH_STRDUP, 7, 40, 30, 120))),\n        (\"arena map, mode=3 (C leaks by design)\", Box::new(|a: &Api| map_workload(a, SH_ARENA, 3, 40, 30, 120))),\n        (\"string arena\", Box::new(|a: &Api| arena_workload(a, 60, 40, 400))),\n        (\"string arena oversized\", Box::new(|a: &Api| arena_workload(a, 20, 8, 3000))),\n        (\"binary map\", Box::new(|a: &Api| binary_workload(a, 60, 60))),\n    ];\n\n    for (name, w) in &workloads {\n        let dc = measure(p.c, w.as_ref());\n        let dr = measure(p.r, w.as_ref());\n        let rss = rss_bytes();\n        report.push(format!(\"{name}: C net={dc} RUST net={dr} (rss={rss})\"));\n        if dc != dr {\n            fails.push(format!(\"{name}: C net={dc} but RUST net={dr}\"));\n        }\n    }\n    for line in &report {\n        println!(\"{line}\");\n    }\n    assert!(fails.is_empty(), \"heap accounting diverges:\\n{}\", fails.join(\"\\n\"));\n}\n","structuredPatch":[{"oldStart":1,"oldLines":68,"newStart":1,"newLines":94,"lines":["-//! Phase D — heap-neutrality parity.","+//! Phase D — heap-accounting parity."," //!","-//! Some divergences are invisible in the returned values: e.g. if","-//! `stbds_hmfree_func` skipped `stbds_strreset` (arena blocks) or the","-//! `STBDS_SH_STRDUP` key sweep, every call would still return exactly the same","-//! bytes while leaking memory.  This test drives the *same* create/destroy","-//! workload against both libraries repeatedly and requires the resident-set","-//! growth to plateau for both: a leaking implementation keeps growing every","-//! round, a faithful one does not.","+//! Some divergences are invisible in returned values: if `stbds_hmfree_func`","+//! skipped `stbds_strreset` (the arena blocks) or the