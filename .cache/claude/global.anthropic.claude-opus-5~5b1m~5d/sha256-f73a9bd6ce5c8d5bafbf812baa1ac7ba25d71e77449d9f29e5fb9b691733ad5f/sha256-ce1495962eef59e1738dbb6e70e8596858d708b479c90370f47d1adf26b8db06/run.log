1115\t                    } else if (*table).tombstone_count > (*table).tombstone_count_threshold {\n1116\t                        (*stbds_header(raw_a)).hash_table =\n1117\t                            stbds_make_hash_index((*table).slot_count, table) as *mut c_void;\n1118\t                        free(table as *mut c_void);\n1119\t                    }\n1120\t\n1121\t                    a\n1122\t                }\n1123\t            }\n1124\t        }\n1125\t    }\n1126\t}\n1127\t\n1128\t// ---------------------------------------------------------------------------\n1129\t// String arena\n1130\t// ---------------------------------------------------------------------------\n1131\t\n1132\tconst STBDS_STRING_ARENA_BLOCKSIZE_MIN: usize = 512;\n1133\tconst STBDS_STRING_ARENA_BLOCKSIZE_MAX: usize = 1 << 20;\n1134\t\n1135\t#[unsafe(no_mangle)]\n1136\tpub unsafe extern \"C\" fn stbds_stralloc(\n1137\t    a: *mut stbds_string_arena,\n1138\t    str_: *mut c_char,\n1139\t) -> *mut c_char {\n1140\t    unsafe {\n1141\t        let p: *mut c_char;\n1142\t        let len = strlen(str_).wrapping_add(1);\n1143\t        if len > (*a).remaining {\n1144\t            let mut blocksize: usize = (*a).block as usize;\n1145\t\n1146\t            blocksize = STBDS_STRING_ARENA_BLOCKSIZE_MIN << (blocksize >> 1);\n1147\t\n1148\t            if blocksize < STBDS_STRING_ARENA_BLOCKSIZE_MAX {\n1149\t                (*a).block = (*a).block.wrapping_add(1);\n1150\t            }\n1151\t\n1152\t            if len > blocksize {\n1153\t                let sb = realloc(\n1154\t                    ptr::null_mut(),\n1155\t                    SIZEOF_STRING_BLOCK.wrapping_sub(8).wrapping_add(len),\n1156\t                ) as *mut stbds_string_block;\n1157\t                memmove(\n1158\t                    (&raw mut (*sb).storage) as *mut c_void,\n1159\t                    str_ as *const c_void,\n1160\t                    len,\n1161\t                );\n1162\t                if !(*a).storage.is_null() {\n1163