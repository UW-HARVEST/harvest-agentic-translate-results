                       let mut step = STBDS_BUCKET_LENGTH;\n421\t                        'done: loop {\n422\t                            let bucket = (*t).storage.wrapping_add(pos >> STBDS_BUCKET_SHIFT);\n423\t\n424\t                            let mut z = pos & STBDS_BUCKET_MASK;\n425\t                            while z < STBDS_BUCKET_LENGTH {\n426\t                                if (*bucket).hash[z] == 0 {\n427\t                                    (*bucket).hash[z] = hash;\n428\t                                    (*bucket).index[z] = (*ob).index[j];\n429\t                                    break 'done;\n430\t                                }\n431\t                                z += 1;\n432\t                            }\n433\t\n434\t                            let limit = pos & STBDS_BUCKET_MASK;\n435\t                            let mut z = 0usize;\n436\t                            while z < limit {\n437\t                                if (*bucket).hash[z] == 0 {\n438\t                                    (*bucket).hash[z] = hash;\n439\t                                    (*bucket).index[z] = (*ob).index[j];\n440\t                                    break 'done;\n441\t                                }\n442\t                                z += 1;\n443\t                            }\n444\t\n445\t                            pos = pos.wrapping_add(step);\n446\t                            step = step.wrapping_add(STBDS_BUCKET_LENGTH);\n447\t                            pos &= (*t).slot_count.wrapping_sub(1);\n448\t                        }\n449\t                    }\n450\t                }\n451\t                i += 1;\n452\t            }\n453\t        }\n454\t\n455\t        t\n456\t    }\n457\t}\n458\t\n459\t// ---------------------------------------------------------------------------\n460\t// Hash functions\n461\t// ---------------------------------------------------------------------------\n462\t\n463\t#[unsafe(no_mangle)]\n464\tpub unsafe extern \"C\" fn stbds_hash_string(str_: *mut c_char, seed: usize) -> usize {\n465\t    unsafe {\n466\t        let mut hash: usize = seed;\n467\t        let mut s = str_;\n468\t        while *s != 0 {\n469\t            hash = STBDS_ROTATE_LEFT(hash, 9).wrapping_add(*s as u8 as usize);\n470\t            s = s.wrapping_add(1);\n471\t        }\n472\t\n473\t        hash ^= seed;\n474\t        hash = (!hash).wrapping_add(hash << 18);\n475\t        hash ^= hash ^ STBDS_ROTATE_RIGHT(hash, 31);\n476\t        hash = hash.wrapping_mul(21);\n477\t        hash ^= hash ^ STBDS_ROTATE_RIGHT(hash, 11);\n478\t        hash = hash.wrapping_add(hash << 6);\n479\t        hash ^= STBDS_ROTATE_RIGHT(hash, 22);\n480\t        hash.wrapping_add(seed)\n481\t    }\n482\t}\n483\t\n484\tconst STBDS_SIPHASH_C_ROUNDS: usize = 2;\n485\tconst STBDS_SIPHASH_D_ROUNDS: usize = 4;\n486\t\n487\tunsafe fn stbds_siphash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n488\t    unsafe {\n489\t        let mut d = p as *mut u8;\n490\t        let mut v0: usize;\n491\t        let mut v1: usize;\n492\t        let mut v2: usize;\n493\t        let mut v3: usize;\n494\t        let mut data: usize;\n495\t\n496\t        v0 = ((0x736f6d65usize << 16) << 16).wrapping_add(0x70736575) ^ seed;\n497\t        v1 = ((0x646f7261usize << 16) << 16).wrapping_add(0x6e646f6d) ^ !seed;\n498\t        v2 = ((0x6c796765usize << 16) << 16).wrapping_add(0x6e657261) ^ seed;\n499\t        v3 = ((0x74656462usize << 16) << 16).wrapping_add(0x79746573) ^ !seed;\n500\t\n501\t        v0 ^= 0x0706050403020100usize ^ seed;\n502\t        v1 ^= 0x0f0e0d0c0b0a0908usize ^ !seed;\n503\t        v2 ^= 0x0706050403020100usize ^ seed;\n504\t        v3 ^= 0x0f0e0d0c0b0a0908usize ^ !seed;\n505\t\n506\t        // STBDS_SIPROUND()\n507\t        macro_rules! STBDS_SIPROUND {\n508\t            () => {{\n509\t                v0 = v0.wrapping_add(v1);\n510\t                v1 = STBDS_ROTATE_LEFT(v1, 13);\n511\t                v1 ^= v0;\n512\t                v0 = STBDS_ROTATE_LEFT(v0, STBDS_SIZE_T_BITS / 2);\n513\t                v2 = v2.wrapping_add(v3);\n514\t                v3 = STBDS_ROTATE_LEFT(v3, 16);\n515\t                v3 ^= v2;\n516\t                v2 = v2.wrapping_add(v1);\n517\t                v1 = STBDS_ROTATE_LEFT(v1, 17);\n518\t                v1 ^= v2;\n519\t                v2 = STBDS_ROTATE_LEFT(v2, STBDS_SIZE_T_BITS / 2);\n520\t                v0 = v0.wrapping_add(v3);\n521\t                v3 = STBDS_ROTATE_LEFT(v3, 21);\n522\t                v3 ^= v0;\n523\t            }};\n524\t        }\n525\t\n526\t        let mut i: usize = 0;\n527\t        while i.wrapping_add(core::mem::size_of::<usize>()) <= len {\n528\t            // NOTE: the C expression `d[0] | (d[1]<<8) | (d[2]<<16) | (d[3]<<24)`\n529\t            // has type `int`; when d[3] >= 0x80 it becomes negative and the\n530\t            // conversion to size_t sign-extends, filling the top 32 bits with\n531\t            // ones.  That behaviour is preserved exactly here.\n532\t            let lo: i32 = (*d.wrapping_add(0) as i32)\n533\t                | ((*d.wrapping_add(1) as i32) << 8)\n534\t                | ((*d.wrapping_add(2) as i32) << 16)\n535\t                | ((*d.wrapping_add(3) as i32) << 24);\n536\t            data = lo as usize;\n537\t            let hi: i32 = (*d.wrapping_add(4) as i32)\n538\t                | ((*d.wrapping_add(5) as i32) << 8)\n539\t                | ((*d.wrapping_add(6) as i32) << 16)\n540\t                | ((*d.wrapping_add(7) as i32) << 24);\n541\t            data |= ((hi as usize) << 16) << 16; // discarded if size_t == 4\n542\t\n543\t            v3 ^= data;\n544\t            for _j in 0..STBDS_SIPHASH_C_ROUNDS {\n545\t                STBDS_SIPROUND!();\n546\t            }\n547\t            v0 ^= data;\n548\t\n549\t            i = i.wrapping_add(core::mem::size_of::<usize>());\n550\t            d = d.wrapping_add(core::mem::size_of::<usize>());\n551\t        }\n552\t\n553\t        data = len << (STBDS_SIZE_T_BITS - 8);\n554\t        // switch (len - i) with C fall-through semantics\n555\t        let rem = len.wrapping_sub(i);\n556\t        if rem >= 7 {\n557\t            data |= ((*d.wrapping_add(6) as usize) << 24) << 24;\n558\t        }\n559\t        if rem >= 6 {\n560\t            data |= ((*d.wrapping_add(5) as usize) << 20) << 20;\n561\t        }\n562\t        if rem >= 5 {\n563\t            data |= ((*d.wrapping_add(4) as usize) << 16) << 16;\n564\t        }\n565\t        if rem >= 4 {\n566\t            // `(d[3] << 24)` is an int -> may sign-extend into the high 32 bits.\n567\t            data |= ((*d.wrapping_add(3) as i32) << 24) as usize;\n568\t        }\n569\t        if rem >= 3 {\n570\t            data |= ((*d.wrapping_add(2) as i32) << 16) as usize;\n571\t        }\n572\t        if rem >= 2 {\n573\t            data |= ((*d.wrapping_add(1) as i32) << 8) as usize;\n574\t        }\n575\t        if rem >= 1 {\n576\t            data |= *d.wrapping_add(0) as i32 as usize;\n577\t        }\n578\t\n579\t        v3 ^= data;\n580\t        for _j in 0..STBDS_SIPHASH_C_ROUNDS {\n581\t            STBDS_SIPROUND!();\n582\t        }\n583\t        v0 ^= data;\n584\t        v2 ^= 0xff;\n585\t        for _j in 0..STBDS_SIPHASH_D_ROUNDS {\n586\t            STBDS_SIPROUND!();\n587\t        }\n588\t\n589\t        v0 ^ v1 ^ v2 ^ v3\n590\t    }\n591\t}\n592\t\n593\t#[unsafe(no_mangle)]\n594\tpub unsafe extern \"C\" fn stbds_hash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n595\t    unsafe { stbds_siphash_bytes(p, len, seed) }\n596\t}\n597\t\n598\t// ---------------------------------------------------------------------------\n599\t// Hash map internals\n600\t// ---------------------------------------------------------------------------\n601\t\n602\tunsafe fn stbds_is_key_equal(\n603\t    a: *mut c_void,\n604\t    elemsize: usize,\n605\t    key: *mut c_void,\n606\t    keysize: usize,\n607\t    keyoffset: usize,\n608\t    mode: c_int,\n609\t    i: usize,\n610\t) -> c_int {\n6