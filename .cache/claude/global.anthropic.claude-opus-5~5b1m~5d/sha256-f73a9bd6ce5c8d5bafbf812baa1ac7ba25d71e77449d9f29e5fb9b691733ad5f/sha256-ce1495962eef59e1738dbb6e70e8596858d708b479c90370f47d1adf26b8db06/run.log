.tombstone_count -= 1;\n957\t            }\n958\t            (*table).used_count += 1;\n959\t\n960\t            {\n961\t                let i: isize = stbds_arrlen(a);\n962\t                if (i as usize).wrapping_add(1) > stbds_arrcap(a) {\n963\t                    a = stbds_arrgrowf(a, elemsize, 1, 0);\n964\t                }\n965\t                raw_a = stbds_arr_to_hash(a, elemsize);\n966\t                let _ = raw_a;\n967\t\n968\t                STBDS_ASSERT((i as usize).wrapping_add(1) <= stbds_arrcap(a));\n969\t                (*stbds_header(a)).length = (i + 1) as usize;\n970\t                bucket = (*table).storage.wrapping_add(pos >> STBDS_BUCKET_SHIFT);\n971\t                (*bucket).hash[pos & STBDS_BUCKET_MASK] = hash;\n972\t                (*bucket).index[pos & STBDS_BUCKET_MASK] = i - 1;\n973\t                stbds_temp_set(a, i - 1);\n974\t\n975\t                let dst = (a as *mut u8).wrapping_add(elemsize.wrapping_mul(i as usize));\n976\t                match (*table).string.mode as c_int {\n977\t                    STBDS_SH_STRDUP => {\n978\t                        let p = stbds_strdup(key as *mut c_char);\n979\t                        *(dst as *mut *mut c_char) = p;\n980\t                        stbds_temp_key_set(a, p);\n981\t                    }\n982\t                    STBDS_SH_ARENA => {\n983\t                        let p = stbds_stralloc(&raw mut (*table).string, key as *mut c_char);\n984\t                        *(dst as *mut *mut c_char) = p;\n985\t                        stbds_temp_key_set(a, p);\n986\t                    }\n987\t                    STBDS_SH_DEFAULT => {\n988\t                        let p = key as *mut c_char;\n989\t                        *(dst as *mut *mut c_char) = p;\n990\t                        stbds_temp_key_set(a, p);\n991\t                    }\n992\t                    _ => {\n993\t                        memcpy(dst as *mut c_void, key as *const c_void, keysize);\n994\t                    }\n995\t                }\n996\t            }\n997\t            stbds_arr_to_hash(a, elemsize)\n998\t        }\n999\t    }\n1000\t}\n1001\t\n1002\t#[unsafe(no_mangle)]\n1003\tpub unsafe extern \"C\" fn stbds_shmode_func(elemsize: usize, mode: c_int) -> *mut c_void {\n1004\t    unsafe {\n1005\t        let a = stbds_arrgrowf(ptr::null_mut(), elemsize, 0, 1);\n1006\t        let h: *mut stbds_hash_index;\n1007\t        memset(a, 0, elemsize);\n1008\t        (*stbds_header(a)).length = 1;\n1009\t        h = stbds_make_hash_index(STBDS_BUCKET_LENGTH, ptr::null_mut());\n1010\t        (*stbds_header(a)).hash_table = h as *mut c_void;\n1011\t        (*h).string.mode = mode as u8;\n1012\t        stbds_arr_to_hash(a, elemsize)\n1013\t    }\n1014\t}\n1015\t\n1016\t#[unsafe(no_mangle)]\n1017\tpub unsafe extern \"C\" fn stbds_hmdel_key(\n1018\t    a: *mut c_void,\n1019\t    elemsize: usize,\n1020\t    key: *mut c_void,\n1021\t    keysize: usize,\n1022\t    keyoffset: usize,\n1023\t    mode: c_int,\n1024\t) -> *mut c_void {\n1025\t    unsafe {\n1026\t        if a.is_null() {\n1027\t            ptr::null_mut()\n1028\t        } else {\n1029\t            let table: *mut stbds_hash_index;\n1030\t            let raw_a = stbds_hash_to_arr(a, elemsize);\n1031\t            table = (*stbds_header(raw_a)).hash_table as *mut stbds_hash_index;\n1032\t            stbds_temp_set(raw_a, 0);\n1033\t            if table.is_null() {\n1034\t                a\n1035\t            } else {\n1036\t                let mut slot: isize;\n1037\t                slot = stbds_hm_find_slot(a, elemsize, key, keysize, keyoffset, mode);\n1038\t                if slot < 0 {\n1039\t                    a\n1040\t                } else {\n1041\t                    let mut b = (*table)\n1042\t                        .storage\n1043\t                        .wrapping_add((slot >> STBDS_BUCKET_SHIFT) as usize);\n1044\t                    let mut i: c_int = ((slot as usize) & STBDS_BUCKET_MASK) as c_int;\n1045\t                    let 