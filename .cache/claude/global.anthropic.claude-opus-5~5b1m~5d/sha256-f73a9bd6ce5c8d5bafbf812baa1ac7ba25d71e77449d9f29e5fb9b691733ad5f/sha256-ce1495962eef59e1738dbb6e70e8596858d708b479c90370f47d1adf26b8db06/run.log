ut c_char, (*table).seed)\n663\t        } else {\n664\t            stbds_hash_bytes(key, keysize, (*table).seed)\n665\t        };\n666\t        let mut step = STBDS_BUCKET_LENGTH;\n667\t        let mut pos: usize;\n668\t        let mut bucket: *mut stbds_hash_bucket;\n669\t\n670\t        if hash < 2 {\n671\t            hash = hash.wrapping_add(2);\n672\t        }\n673\t\n674\t        pos = stbds_probe_position(hash, (*table).slot_count, (*table).slot_count_log2);\n675\t\n676\t        loop {\n677\t            bucket = (*table).storage.wrapping_add(pos >> STBDS_BUCKET_SHIFT);\n678\t\n679\t            let mut i = pos & STBDS_BUCKET_MASK;\n680\t            while i < STBDS_BUCKET_LENGTH {\n681\t                if (*bucket).hash[i] == hash {\n682\t                    if stbds_is_key_equal(\n683\t                        a,\n684\t                        elemsize,\n685\t                        key,\n686\t                        keysize,\n687\t                        keyoffset,\n688\t                        mode,\n689\t                        (*bucket).index[i] as usize,\n690\t                    ) != 0\n691\t                    {\n692\t                        return ((pos & !STBDS_BUCKET_MASK).wrapping_add(i)) as isize;\n693\t                    }\n694\t                } else if (*bucket).hash[i] == STBDS_HASH_EMPTY {\n695\t                    return -1;\n696\t                }\n697\t                i += 1;\n698\t            }\n699\t\n700\t            let limit = pos & STBDS_BUCKET_MASK;\n701\t            let mut i = 0usize;\n702\t            while i < limit {\n703\t                if (*bucket).hash[i] == hash {\n704\t                    if stbds_is_key_equal(\n705\t                        a,\n706\t                        elemsize,\n707\t                        key,\n708\t                        keysize,\n709\t                        keyoffset,\n710\t                        mode,\n711\t                        (*bucket).index[i] as usize,\n712\t                    ) != 0\n713\t                    {\n714\t                        return ((pos & !STBDS_BUCKET_MASK).wrapping_add(i)) as isize;\n715\t                    }\n716\t                } else if (*bucket).hash[i] == STBDS_HASH_EMPTY {\n717\t                    return -1;\n718\t                }\n719\t                i += 1;\n720\t            }\n721\t\n722\t            pos = pos.wrapping_add(step);\n723\t            step = step.wrapping_add(STBDS_BUCKET_LENGTH);\n724\t            pos &= (*table).slot_count.wrapping_sub(1);\n725\t        }\n726\t    }\n727\t}\n728\t\n729\t#[unsafe(no_mangle)]\n730\tpub unsafe extern \"C\" fn stbds_hmget_key_ts(\n731\t    a: *mut c_void,\n732\t    elemsize: usize,\n733\t    key: *mut c_void,\n734\t    keysize: usize,\n735\t    temp: *mut isize,\n736\t    mode: c_int,\n737\t) -> *mut c_void {\n738\t    unsafe {\n739\t        let keyoffset: usize = 0;\n740\t        if a.is_null() {\n741\t            let a = stbds_arrgrowf(ptr::null_mut(), elemsize, 0, 1);\n742\t            (*stbds_header(a)).length += 1;\n743\t            memset(a, 0, elemsize);\n744\t            *temp = STBDS_INDEX_EMPTY;\n745\t            stbds_arr_to_hash(a, elemsize)\n746\t        } else {\n747\t            let table: *mut stbds_hash_index;\n748\t            let raw_a = stbds_hash_to_arr(a, elemsize);\n749\t            table = (*stbds_header(raw_a)).hash_table as *mut stbds_hash_index;\n750\t            if table.is_null() {\n751\t                *temp = -1;\n752\t            } else {\n753\t                let slot = stbds_hm_find_slot(a, elemsize, key, keysize, keyoffset, mode);\n754\t                if slot < 0 {\n755\t                    *temp = STBDS_INDEX_EMPTY;\n756\t                } else {\n757\t                    let b = (*table)\n758\t                        .storage\n759\t                        .wrapping_add((slot >> STBDS_BUCKET_SHIFT) as usize);\n760\t                    *temp = (*b).index[(slot as usize) & STBDS_BUCKET_MASK];\n761\t                }\n762\t            }\n