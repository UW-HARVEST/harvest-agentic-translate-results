{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_nnlfdjpoptgyaacupvomtcle3rufblq4tpdsg4culfigykj4lr6q","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_012nMx73V2vPKHSJfSJZFnBd","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-yKaisW/translation/tests/zz_localize.rs","content":"//! Scratch: localise the heap-accounting divergence.\nmod common;\n\nuse common::*;\nuse std::ffi::c_void;\n\n#[repr(C)]\n#[derive(Clone, Copy, Default, Debug)]\nstruct MallInfo2 {\n    a: usize,\n    b: usize,\n    c: usize,\n    d: usize,\n    e: usize,\n    f: usize,\n    g: usize,\n    uordblks: usize,\n    i: usize,\n    j: usize,\n}\nunsafe extern \"C\" {\n    fn mallinfo2() -> MallInfo2;\n}\nfn used() -> usize {\n    unsafe { mallinfo2().uordblks }\n}\n\nfn mkkey(m: usize, i: usize, keylen: usize) -> Box<[u8]> {\n    let mut v = format!(\"{m}-{i}-\").into_bytes();\n    while v.len() < keylen {\n        v.push(b'k');\n    }\n    v.push(0);\n    v.into_boxed_slice()\n}\n\n/// one map lifecycle; returns the net heap delta of the library calls only\nfn one(api: &Api, sh: i32, mode: i32, keys: usize, dels: usize, keylen: usize) -> usize {\n    let es = 16usize;\n    unsafe {\n        // pre-build all the key buffers so no test allocation happens between\n        // the two measurements\n        let mut owned: Vec<Box<[u8]>> = (0..keys).map(|i| mkkey(0, i, keylen)).collect();\n        let mut delkeys: Vec<Box<[u8]>> =\n            (0..dels).map(|i| mkkey(0, keys - 1 - i, keylen)).collect();\n        let before = used();\n        let mut h = (api.shmode_func)(es, sh);\n        for kb in owned.iter_mut() {\n            let kp = kb.as_mut_ptr() as *mut c_void;\n            h = (api.hmput_key)(h, es, kp, 8, mode);\n            let idx = map_temp(h, es);\n            let elem = map_raw(h, es).offset((idx + 1) * es as isize);\n            std::ptr::write_bytes(elem.add(8), 0x5a, es - 8);\n        }\n        for kb in delkeys.iter_mut() {\n            h = (api.hmdel_key)(h, es, kb.as_mut_ptr() as *mut c_void, 8, 0, mode);\n        }\n        (api.hmfree_func)(map_raw(h, es) as *mut c_void, es);\n        let after = used();\n        drop(owned);\n        drop(delkeys);\n        after.saturating_sub(before)\n    }\n}\n\n#[test]\nfn localize() {\n    let p = seeded(DEFAULT_SEED);\n    // warm up\n    one(p.c, SH_STRDUP, HM_STRING, 8, 2, 300);\n    one(p.r, SH_STRDUP, HM_STRING, 8, 2, 300);\n    println!(\"keys dels keylen |  C   RUST\");\n    for &(keys, dels) in &[\n        (1usize, 0usize),\n        (1, 1),\n        (2, 0),\n        (2, 1),\n        (2, 2),\n        (3, 1),\n        (5, 0),\n        (5, 2),\n        (6, 0),\n        (7, 0),\n        (7, 3),\n        (10, 0),\n        (10, 4),\n        (20, 7),\n        (40, 14),\n    ] {\n        for &keylen in &[8usize, 300] {\n            let dc = one(p.c, SH_STRDUP, HM_STRING, keys, dels, keylen);\n            let dr = one(p.r, SH_STRDUP, HM_STRING, keys, dels, keylen);\n            println!(\n                \"{keys:>4} {dels:>4} {keylen:>6} | {dc:>6} {dr:>6}  {}\",\n                if dc == dr { \"\" } else { \"  <<<< DIFFER\" }\n            );\n        }\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":810,"cache_read_input_tokens":286260,"cache_creation":{"ephemeral_5m_input_tokens":810,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"ece1fe0a-8825-4840-af0e-a0dc99e742ce","uuid":"17f95233-64e5-4d87-a8a1-463df8fc2c67","timestamp":"2026-08-27T11:49:31.186Z"}
