   showstr(matrix_to_string(m));\n    });\n\n    // --- multiply with degenerate shapes ------------------------------------\n    CASE(\"mul 0-width chain\", {\n        matrix_t* a = allocate_matrix(0, 2);\n        matrix_t* b = allocate_matrix(3, 0);\n        matrix_t* r = multiply_matrices(a, b);\n        show(r); if (r) showstr(matrix_to_string(r));\n    });\n    CASE(\"mul inner dim 0\", {\n        matrix_t* a = allocate_matrix(0, 2);   // 2x0\n        matrix_t* b = allocate_matrix(2, 0);   // 0x2\n        matrix_t* r = multiply_matrices(a, b);\n        show(r); if (r) showstr(matrix_to_string(r));\n    });\n    CASE(\"mul mismatch order\", {\n        matrix_t* a = allocate_matrix(2, 3);\n        matrix_t* b = allocate_matrix(3, 5);\n        printf(\"  -> %s\\n\", multiply_matrices(a, b) ? \"non-null\" : \"NULL\");\n    });\n\n    // --- write_to_file oddities --------------------------------------------\n    CASE(\"write null filename\", { printf(\"  rc=%d\\n\", write_to_file(NULL, \"x\")); });\n    CASE(\"write both null\", { printf(\"  rc=%d\\n\", write_to_file(NULL, NULL)); });\n    CASE(\"write /dev/full\", { printf(\"  rc=%d\\n\", write_to_file(\"/dev/full\", \"x\")); });\n    CASE(\"write /proc/self/mem\", { printf(\"  rc=%d\\n\", write_to_file(\"/proc/self/mem\", \"x\")); });\n    CASE(\"write big content\", {\n        char* big = malloc(200000); memset(big, 'A', 199999); big[199999] = 0;\n        printf(\"  rc=%d\\n\", write_to_file(\"big.txt\", big));\n        FILE* f = fopen(\"big.txt\", \"rb\"); fseek(f, 0, SEEK_END);\n        printf(\"  size=%ld\\n\", ftell(f)); fclose(f);\n    });\n    CASE(\"write embedded newlines/nul-terminated\", {\n        printf(\"  rc=%d\\n\", write_to_file(\"nl.txt\", \"a\\nb\\n\\nc\"));\n        FILE* f = fopen(\"nl.txt\", \"rb\"); int c;\n        printf(\"  <<<\"); while ((c = fgetc(f)) != EOF) putchar(c); printf(\">>>\\n\");\n        fclose(f);\n    });\n\n    // --- driver with hostile inputs ---------------------------