c_void);\n        return EXIT_FAILURE;\n    }\n\n    let res_write = write_to_file(OUT_FILE.as_ptr(), res_str);\n\n    free_matrix(mat_a);\n    free_matrix(mat_b);\n    free_matrix(res);\n    free(res_str as *mut c_void);\n\n    if res_write != 0 {\n        return EXIT_FAILURE;\n    }\n\n    EXIT_SUCCESS\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
