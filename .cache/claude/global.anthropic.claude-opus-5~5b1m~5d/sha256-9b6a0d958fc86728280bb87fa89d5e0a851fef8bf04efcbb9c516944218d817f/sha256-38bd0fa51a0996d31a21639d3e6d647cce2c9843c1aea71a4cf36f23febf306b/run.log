ress_f;\n221\t        if repeat == HUF_repeat_valid && lhSize == 3 {\n222\t            singleStream = 1;\n223\t        }\n224\t        huf_compress = if singleStream != 0 {\n225\t            crate::compress::huf_compress::HUF_compress1X_repeat\n226\t        } else {\n227\t            crate::compress::huf_compress::HUF_compress4X_repeat\n228\t        };\n229\t        cLitSize = huf_compress(\n230\t            ostart.add(lhSize) as *mut c_void,\n231\t            dstCapacity - lhSize,\n232\t            src,\n233\t            srcSize,\n234\t            HUF_SYMBOLVALUE_MAX,\n235\t            LitHufLog,\n236\t            entropyWorkspace,\n237\t            entropyWorkspaceSize,\n238\t            (*nextHuf).CTable.as_mut_ptr() as *mut HUF_CElt,\n239\t            &mut repeat,\n240\t            flags,\n241\t        );\n242\t        if repeat != HUF_repeat_none {\n243\t            /* reused the existing table */\n244\t            hType = set_repeat;\n245\t        }\n246\t    }\n247\t\n248\t    {\n249\t        let minGain: usize = ZSTD_minGain(srcSize, strategy);\n250\t        if (cLitSize == 0) || (cLitSize >= srcSize.wrapping_sub(minGain)) || ERR_isError(cLitSize) != 0\n251\t        {\n252\t            ZSTD_memcpy(\n253\t                nextHuf as *mut c_void,\n254\t                prevHuf as *const c_void,\n255\t                core::mem::size_of::<ZSTD_hufCTables_t>(),\n256\t            );\n257\t            return ZSTD_noCompressLiterals(dst, dstCapacity, src, srcSize);\n258\t        }\n259\t    }\n260\t    if cLitSize == 1 {\n261\t        /* A return value of 1 signals that the alphabet consists of a single symbol.\n262\t         * However, in some rare circumstances, it could be the compressed size (a single byte).\n263\t         * For that outcome to have a chance to happen, it's necessary that `srcSize < 8`.\n264\t         * (it's also necessary to not generate statistics).\n265\t         * Therefore, in such a case, actively check that all bytes are identical. */\n266