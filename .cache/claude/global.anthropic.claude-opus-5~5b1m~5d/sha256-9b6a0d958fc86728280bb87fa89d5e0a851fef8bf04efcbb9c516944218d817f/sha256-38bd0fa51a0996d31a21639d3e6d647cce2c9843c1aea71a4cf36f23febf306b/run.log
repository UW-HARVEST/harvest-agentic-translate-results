{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01TT8oDokGKVGEpkGqfiSz4t","type":"tool_result","content":"44\t\n45\t/// `ERROR(name)` == `(size_t)-ZSTD_error_##name`\n46\t#[inline(always)]\n47\tpub const fn ERROR(code: ZSTD_ErrorCode) -> usize {\n48\t    (0usize).wrapping_sub(code as usize)\n49\t}\n50\t\n51\t#[inline(always)]\n52\tpub fn ERR_isError(code: usize) -> c_uint {\n53\t    (code > ERROR(ZSTD_error_maxCode)) as c_uint\n54\t}\n55\t\n56\t#[inline(always)]\n57\tpub fn ERR_getErrorCode(code: usize) -> ZSTD_ErrorCode {\n58\t    if ERR_isError(code) == 0 {\n59\t        return 0;\n60\t    }\n61\t    (0usize).wrapping_sub(code) as ZSTD_ErrorCode\n62\t}\n63\t\n64\t#[inline(always)]\n65\tpub fn ERR_getErrorName(code: usize) -> *const c_char {\n66\t    ERR_getErrorString_impl(ERR_getErrorCode(code))\n67\t}\n68\t\n69\tmacro_rules! cstr {\n70\t    ($s:expr) => {\n71\t        concat!($s, \"\\0\").as_ptr() as *const c_char\n72\t    };\n73\t}"}]},"parent_tool_use_id":"toolu_bdrk_01EGhJqxjDWR1VPa9tbj9kvE","session_id":"9325aeb1-fde7-405e-a2e0-217179ef0d1d","uuid":"2ccbe4aa-d595-4fb0-96ce-4e463d5c9da6","timestamp":"2026-08-31T08:12:33.429Z","subagent_type":"general-purpose","task_description":"Port legacy zstd_v05.c"}
