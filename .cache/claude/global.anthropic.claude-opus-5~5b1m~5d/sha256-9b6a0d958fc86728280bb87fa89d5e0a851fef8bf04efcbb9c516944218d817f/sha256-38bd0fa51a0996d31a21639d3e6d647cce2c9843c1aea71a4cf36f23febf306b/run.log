{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01G7AQp1dSt8a5EBFz4iLP4r","type":"tool_result","content":"1\t//! Translation of `common/bits.h`\n2\t#![allow(dead_code)]\n3\t\n4\tuse crate::cmem::*;\n5\t\n6\t#[inline(always)]\n7\tpub fn ZSTD_countTrailingZeros32(val: U32) -> u32 {\n8\t    val.trailing_zeros()\n9\t}\n10\t\n11\t#[inline(always)]\n12\tpub fn ZSTD_countLeadingZeros32(val: U32) -> u32 {\n13\t    val.leading_zeros()\n14\t}\n15\t\n16\t#[inline(always)]\n17\tpub fn ZSTD_countTrailingZeros64(val: U64) -> u32 {\n18\t    val.trailing_zeros()\n19\t}\n20\t\n21\t#[inline(always)]\n22\tpub fn ZSTD_countLeadingZeros64(val: U64) -> u32 {\n23\t    val.leading_zeros()\n24\t}\n25\t\n26\t#[inline(always)]\n27\tpub fn ZSTD_NbCommonBytes(val: usize) -> u32 {\n28\t    if MEM_isLittleEndian() != 0 {\n29\t        if MEM_64bits() != 0 {\n30\t            ZSTD_countTrailingZeros64(val as U64) >> 3\n31\t        } else {\n32\t            ZSTD_countTrailingZeros32(val as U32) >> 3\n33\t        }\n34\t    } else if MEM_64bits() != 0 {\n35\t        ZSTD_countLeadingZeros64(val as U64) >> 3\n36\t    } else {\n37\t        ZSTD_countLeadingZeros32(val as U32) >> 3\n38\t    }\n39\t}\n40\t\n41\t#[inline(always)]\n42\tpub fn ZSTD_highbit32(val: U32) -> u32 {\n43\t    31 - ZSTD_countLeadingZeros32(val)\n44\t}\n45\t\n46\t#[inline(always)]\n47\tpub fn ZSTD_rotateRight_U64(value: U64, count: U32) -> U64 {\n48\t    let count = count & 0x3F;\n49\t    (value >> count) | (value << ((0u32.wrapping_sub(count)) & 0x3F))\n50\t}\n51\t\n52\t#[inline(always)]\n53\tpub fn ZSTD_rotateRight_U32(value: U32, count: U32) -> U32 {\n54\t    let count = count & 0x1F;\n55\t    (value >> count) | (value << ((0u32.wrapping_sub(count)) & 0x1F))\n56\t}\n57\t\n58\t#[inline(always)]\n59\tpub fn ZSTD_rotateRight_U16(value: U16, count: U32) -> U16 {\n60\t    let count = count & 0x0F;\n61\t    (value >> count) | ((value as u32) << ((0u32.wrapping_sub(count)) & 0x0F)) as U16\n62\t}\n63\t"}]},"p