alt),\n1229\t        6 => ZSTD_hash6PtrS(p, hBits, hashSalt),\n1230\t        7 => ZSTD_hash7PtrS(p, hBits, hashSalt),\n1231\t        8 => ZSTD_hash8PtrS(p, hBits, hashSalt),\n1232\t        _ => ZSTD_hash4PtrS(p, hBits, hashSalt as U32),\n1233\t    }\n1234\t}\n1235\t\n1236\tpub fn ZSTD_ipow(mut base: U64, mut exponent: U64) -> U64 {\n1237\t    let mut power: U64 = 1;\n1238\t    while exponent != 0 {\n1239\t        if exponent & 1 != 0 {\n1240\t            power = power.wrapping_mul(base);\n1241\t        }\n1242\t        exponent >>= 1;\n1243\t        base = base.wrapping_mul(base);\n1244\t    }\n1245\t    power\n1246\t}\n1247\t\n1248\tpub const ZSTD_ROLL_HASH_CHAR_OFFSET: U64 = 10;\n1249\t\n1250\tpub unsafe fn ZSTD_rollingHash_append(mut hash: U64, buf: *const c_void, size: usize) -> U64 {\n1251\t    let istart = buf as *const BYTE;\n1252\t    let mut pos = 0usize;\n1253\t    while pos < size {\n1254\t        hash = hash.wrapping_mul(prime8bytes);\n1255\t        hash = hash.wrapping_add((*istart.add(pos) as U64).wrapping_add(ZSTD_ROLL_HASH_CHAR_OFFSET));\n1256\t        pos += 1;\n1257\t    }\n1258\t    hash\n1259\t}\n1260\t\n1261\t#[inline(always)]\n1262\tpub unsafe fn ZSTD_rollingHash_compute(buf: *const c_void, size: usize) -> U64 {\n1263\t    ZSTD_rollingHash_append(0, buf, size)\n1264\t}\n1265\t\n1266\t#[inline(always)]\n1267\tpub fn ZSTD_rollingHash_primePower(length: U32) -> U64 {\n1268\t    ZSTD_ipow(prime8bytes, (length - 1) as U64)\n1269\t}\n1270\t\n1271\t#[inline(always)]\n1272\tpub fn ZSTD_rollingHash_rotate(mut hash: U64, toRemove: BYTE, toAdd: BYTE, primePower: U64) -> U64 {\n1273\t    hash = hash.wrapping_sub(\n1274\t        ((toRemove as U64).wrapping_add(ZSTD_ROLL_HASH_CHAR_OFFSET)).wrapping_mul(primePower),\n1275\t    );\n1276\t    hash = hash.wrapping_mul(prime8bytes);\n1277\t    hash = hash.wrapping_add((toAdd as U64).wrapping_add(ZSTD_ROLL_HASH_CHAR_OFFSET));\n1278\t    hash\n1279\t}\n1280\t\n1281\t/* ===== Round buffer management ===== */\n1282\t\n1283\t#[inline(always)]\n1284\tpub fn ZSTD_CURRENT_MAX() -> U32 {\n1285\t    if MEM_64bits() != 0 {\n1286\t        3500u32 * (1 << 20)\n1287\t    } else {\n1288\t        2000u32 * (1 << 20)\n1289\t    }\n1290\t}\n1291\t\n1292\t#[inline(always)]\n1293\tpub fn ZSTD_CHUNKSIZE_MAX() -> U32 {\n1294\t    (u32::MAX).wrapping_sub(ZSTD_CURRENT_MAX())\n1295\t}\n1296\t\n1297\t#[inline(always)]\n1298\tpub unsafe fn ZSTD_window_clear(window: *mut ZSTD_window_t) {\n1299\t    let endT = (*window).nextSrc.offset_from((*window).base) as usize;\n1300\t    let end = endT as U32;\n1301\t    (*window).lowLimit = end;\n1302\t    (*window).dictLimit = end;\n1303\t}\n1304\t\n1305\t#[inline(always)]\n1306\tpub unsafe fn ZSTD_window_isEmpty(window: ZSTD_window_t) -> U32 {\n1307\t    (window.dictLimit == ZSTD_WINDOW_START_INDEX\n1308\t        && window.lowLimit == ZSTD_WINDOW_START_INDEX\n1309\t        && (window.nextSrc.offset_from(window.base) as U32) == ZSTD_WINDOW_START_INDEX)\n1310\t        as U32\n1311\t}\n1312\t\n1313\t#[inline(always)]\n1314\tpub fn ZSTD_window_hasExtDict(window: ZSTD_window_t) -> U32 {\n1315\t    (window.lowLimit < window.dictLimit) as U32\n1316\t}\n1317\t\n1318\t#[inline(always)]\n1319\tpub unsafe fn ZSTD_matchState_dictMode(ms: *const ZSTD_MatchState_t) -> ZSTD_dictMode_e {\n1320\t    if ZSTD_window_hasExtDict((*ms).window) != 0 {\n1321\t        ZSTD_extDict\n1322\t    } else if !(*ms).dictMatchState.is_null() {\n1323\t        if (*(*ms).dictMatchState).dedicatedDictSearch != 0 {\n1324\t            ZSTD_dedicatedDictSearch\n1325\t        } else {\n1326\t            ZSTD_dictMatchState\n1327\t        }\n1328\t    } else {\n1329\t        ZSTD_noDict\n1330\t    }\n1331\t}\n1332\t\n1333\t#[inline(always)]\n1334\tpub unsafe fn ZSTD_window_canOverflowCorrect(\n1335\t    window: ZSTD_window_t,\n1336\t    cycleLog: U32,\n1337\t    maxDist: U32,\n1338\t    loadedDictEnd: U32,\n1339\t    src: *const c_void,\n1340\t) -> U32 {\n1341\t    let cycleSize: U32 = 1u32 << cycleLog