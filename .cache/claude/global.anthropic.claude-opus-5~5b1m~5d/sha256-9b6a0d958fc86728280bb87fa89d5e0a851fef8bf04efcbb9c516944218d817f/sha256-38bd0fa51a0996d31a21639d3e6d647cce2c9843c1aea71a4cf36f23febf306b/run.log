{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Biyki7EdMmU4ADHUqzeB5X","type":"tool_result","content":"1\t//! Translation of `common/fse.h` (constants + inlined functions).\n2\t#![allow(dead_code)]\n3\t\n4\tuse core::ffi::{c_uint, c_void};\n5\t\n6\tuse crate::bitstream::*;\n7\tuse crate::cmem::*;\n8\t\n9\tpub type FSE_CTable = c_uint;\n10\tpub type FSE_DTable = c_uint;\n11\t\n12\tpub const FSE_VERSION_MAJOR: u32 = 0;\n13\tpub const FSE_VERSION_MINOR: u32 = 9;\n14\tpub const FSE_VERSION_RELEASE: u32 = 0;\n15\tpub const FSE_VERSION_NUMBER: u32 =\n16\t    FSE_VERSION_MAJOR * 100 * 100 + FSE_VERSION_MINOR * 100 + FSE_VERSION_RELEASE;\n17\t\n18\tpub const FSE_NCOUNTBOUND: usize = 512;\n19\t\n20\t#[inline(always)]\n21\tpub const fn FSE_BLOCKBOUND(size: usize) -> usize {\n22\t    size + (size >> 7) + 4 + core::mem::size_of::<usize>()\n23\t}\n24\t#[inline(always)]\n25\tpub const fn FSE_COMPRESSBOUND(size: usize) -> usize {\n26\t    FSE_NCOUNTBOUND + FSE_BLOCKBOUND(size)\n27\t}\n28\t\n29\t#[inline(always)]\n30\tpub const fn FSE_CTABLE_SIZE_U32(maxTableLog: u32, maxSymbolValue: u32) -> usize {\n31\t    (1 + (1 << (maxTableLog - 1)) + ((maxSymbolValue + 1) * 2)) as usize\n32\t}\n33\t#[inline(always)]\n34\tpub const fn FSE_DTABLE_SIZE_U32(maxTableLog: u32) -> usize {\n35\t    (1 + (1u32 << maxTableLog)) as usize\n36\t}\n37\t\n38\tpub const FSE_MAX_MEMORY_USAGE: u32 = 14;\n39\tpub const FSE_DEFAULT_MEMORY_USAGE: u32 = 13;\n40\tpub const FSE_MAX_SYMBOL_VALUE: u32 = 255;\n41\tpub const FSE_MAX_TABLELOG: u32 = FSE_MAX_MEMORY_USAGE - 2;\n42\tpub const FSE_MAX_TABLESIZE: u32 = 1u32 << FSE_MAX_TABLELOG;\n43\tpub const FSE_MAXTABLESIZE_MASK: u32 = FSE_MAX_TABLESIZE - 1;\n44\tpub const FSE_DEFAULT_TABLELOG: u32 = FSE_DEFAULT_MEMORY_USAGE - 2;\n45\tpub const FSE_MIN_TABLELOG: u32 = 5;\n46\tpub const FSE_TABLELOG_ABSOLUTE_MAX: u32 = 15;\n47\t\n48\t#[inline(always)]\n49\tpub const fn FSE_TABLESTEP(tableSize: u32) -> u32 {\n50\t    (tableSize >> 1) + (tableS