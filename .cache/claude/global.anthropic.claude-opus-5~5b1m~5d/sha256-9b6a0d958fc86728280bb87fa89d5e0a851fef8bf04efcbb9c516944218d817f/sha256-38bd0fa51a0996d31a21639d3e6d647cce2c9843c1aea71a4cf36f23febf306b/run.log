{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01X1cYdc8vryrBr1Udt7L54w","type":"tool_result","content":"1\t//! Translation of `common/huf.h` (constants and types).\n2\t#![allow(dead_code)]\n3\t\n4\tuse crate::cmem::*;\n5\tuse crate::fse::*;\n6\t\n7\tpub const HUF_BLOCKSIZE_MAX: usize = 128 * 1024;\n8\tpub const HUF_WORKSPACE_SIZE: usize = (8 << 10) + 512;\n9\tpub const HUF_WORKSPACE_SIZE_U64: usize = HUF_WORKSPACE_SIZE / 8;\n10\t\n11\tpub const HUF_TABLELOG_MAX: u32 = 12;\n12\tpub const HUF_TABLELOG_DEFAULT: u32 = 11;\n13\tpub const HUF_SYMBOLVALUE_MAX: u32 = 255;\n14\tpub const HUF_TABLELOG_ABSOLUTEMAX: u32 = 12;\n15\t\n16\tpub const HUF_CTABLEBOUND: usize = 129;\n17\t\n18\t#[inline(always)]\n19\tpub const fn HUF_BLOCKBOUND(size: usize) -> usize {\n20\t    size + (size >> 8) + 8\n21\t}\n22\t#[inline(always)]\n23\tpub const fn HUF_COMPRESSBOUND(size: usize) -> usize {\n24\t    HUF_CTABLEBOUND + HUF_BLOCKBOUND(size)\n25\t}\n26\t\n27\tpub type HUF_CElt = usize;\n28\t\n29\t#[inline(always)]\n30\tpub const fn HUF_CTABLE_SIZE_ST(maxSymbolValue: usize) -> usize {\n31\t    maxSymbolValue + 2\n32\t}\n33\t#[inline(always)]\n34\tpub const fn HUF_CTABLE_SIZE(maxSymbolValue: usize) -> usize {\n35\t    HUF_CTABLE_SIZE_ST(maxSymbolValue) * core::mem::size_of::<usize>()\n36\t}\n37\t\n38\tpub type HUF_DTable = U32;\n39\t\n40\t#[inline(always)]\n41\tpub const fn HUF_DTABLE_SIZE(maxTableLog: u32) -> usize {\n42\t    (1 + (1u32 << maxTableLog)) as usize\n43\t}\n44\t\n45\tpub type HUF_flags_e = i32;\n46\tpub const HUF_flags_bmi2: i32 = 1 << 0;\n47\tpub const HUF_flags_optimalDepth: i32 = 1 << 1;\n48\tpub const HUF_flags_preferRepeat: i32 = 1 << 2;\n49\tpub const HUF_flags_suspectUncompressible: i32 = 1 << 3;\n50\tpub const HUF_flags_disableAsm: i32 = 1 << 4;\n51\tpub const HUF_flags_disableFast: i32 = 1 << 5;\n52\t\n53\tpub type HUF_repeat = u32;\n54\tpub const HUF_repeat_none: HUF_repeat = 0;\n55\tpub const HUF_repeat_check: HUF_repeat = 1;\n56\tpub const HUF_repeat_valid: HUF_repeat = 2;\n57\t\n58\tpub const HUF_CTABLE_WORKSPACE_SIZE_U32: usize = (4 * (HUF_SYMBOLVALUE_MAX as usize + 1)) + 192;\n59\tpub const HUF_CTABLE_WORKSPACE_SIZE: usize = HUF_CTABLE_WORKSPACE_SIZE_U32 * 4;\n60\t\n61\tpub const HUF_READ_STATS_WORKSPACE_SIZE_U32: usize =\n62\t    FSE_DECOMPRESS_WKSP_SIZE_U32(6, HUF_TABLELOG_MAX - 1);\n63\tpub const HUF_READ_STATS_WORKSPACE_SIZE: usize = HUF_READ_STATS_WORKSPACE_SIZE_U32 * 4;\n64\t\n65\tpub const HUF_DECOMPRESS_WORKSPACE_SIZE: usize = (2 << 10) + (1 << 9);\n66\tpub const HUF_DECOMPRESS_WORKSPACE_SIZE_U32: usize = HUF_DECOMPRESS_WORKSPACE_SIZE / 4;\n67\t\n68\t#[repr(C)]\n69\t#[derive(Copy, Clone, Default)]\n70\tpub struct HUF_CTableHeader {\n71\t    pub tableLog: BYTE,\n72\t    pub maxSymbolValue: BYTE,\n73\t    pub unused: [BYTE; core::mem::size_of::<usize>() - 2],\n74\t}\n75\t"}]},"parent_tool_use_id":"toolu_bdrk_01HCiEcC47JuRvnNnUhTqQkT","session_id":"9325aeb1-fde7-405e-a2e0-217179ef0d1d","uuid":"f04a343f-052f-4f08-9324-d3fe276f6b51","timestamp":"2026-08-31T08:08:56.455Z","subagent_type":"general-purpose","task_description":"Port entropy_common + fse_decompress"}
