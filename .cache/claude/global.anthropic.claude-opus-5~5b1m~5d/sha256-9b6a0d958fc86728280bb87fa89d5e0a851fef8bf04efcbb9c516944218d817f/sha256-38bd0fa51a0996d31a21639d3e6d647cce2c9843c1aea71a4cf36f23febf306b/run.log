, 112, 110, 108, 106, 104, 102, 100, 98, 96, 94, 93, 91, 89, 87, 85, 83, 82, 80,\n37\t    78, 76, 74, 73, 71, 69, 67, 66, 64, 62, 61, 59, 57, 55, 54, 52, 50, 49, 47, 46, 44, 42, 41, 39,\n38\t    37, 36, 34, 33, 31, 30, 28, 26, 25, 23, 22, 20, 19, 17, 16, 14, 13, 11, 10, 8, 7, 5, 4, 2, 1,\n39\t];\n40\t\n41\tpub(crate) unsafe fn ZSTD_getFSEMaxSymbolValue(ctable: *const FSE_CTable) -> c_uint {\n42\t    let ptr = ctable as *const c_void;\n43\t    let u16ptr = ptr as *const U16;\n44\t    let maxSymbolValue: U32 = MEM_read16(u16ptr.add(1) as *const c_void) as U32;\n45\t    maxSymbolValue\n46\t}\n47\t\n48\t/**\n49\t * Returns true if we should use ncount=-1 else we should\n50\t * use ncount=1 for low probability symbols instead.\n51\t */\n52\tpub(crate) unsafe fn ZSTD_useLowProbCount(nbSeq: usize) -> c_uint {\n53\t    /* Heuristic: This should cover most blocks <= 16K and\n54\t     * start to fade out after 16K to about 32K depending on\n55\t     * compressibility.\n56\t     */\n57\t    (nbSeq >= 2048) as c_uint\n58\t}\n59\t\n60\t/**\n61\t * Returns the cost in bytes of encoding the normalized count header.\n62\t * Returns an error if any of the helper functions return an error.\n63\t */\n64\tpub(crate) unsafe fn ZSTD_NCountCost(\n65\t    count: *const c_uint,\n66\t    max: c_uint,\n67\t    nbSeq: usize,\n68\t    FSELog: c_uint,\n69\t) -> usize {\n70\t    let mut wksp: [BYTE; FSE_NCOUNTBOUND] = [0; FSE_NCOUNTBOUND];\n71\t    let mut norm: [S16; (MaxSeq + 1) as usize] = [0; (MaxSeq + 1) as usize];\n72\t    let tableLog: U32 = crate::compress::fse_compress::FSE_optimalTableLog(FSELog, nbSeq, max);\n73\t    {\n74\t        let e = crate::compress::fse_compress::FSE_normalizeCount(\n75\t            norm.as_mut_ptr(),\n76\t            tableLog,\n77\t            count,\n78\t            nbSeq,\n79\t            max,\n80\t            ZSTD_useLowProbCount(nbSeq),\n81\t        );\n82\t        if ERR_isError(e) != 0 {\n83\t            return e;\n84\t        }\n85\t    }\n86\t    crate::compress::fse_compress::FSE_writeNCount(\n87\t        wksp.as_mut_ptr() as *mut c_void,\n88\t        core::mem::size_of::<[BYTE; FSE_NCOUNTBOUND]>(),\n89\t        norm.as_ptr(),\n90\t        max,\n91\t        tableLog,\n92\t    )\n93\t}\n94\t\n95\t/**\n96\t * Returns the cost in bits of encoding the distribution described by count\n97\t * using the entropy bound.\n98\t */\n99\tpub(crate) unsafe fn ZSTD_entropyCost(count: *const c_uint, max: c_uint, total: usize) -> usize {\n100\t    let mut cost: c_uint = 0;\n101\t    let mut s: c_uint;\n102\t\n103\t    s = 0;\n104\t    while s <= max {\n105\t        let mut norm: c_uint =\n106\t            ((256u32.wrapping_mul(*count.add(s as usize))) as usize / total) as c_uint;\n107\t        if *count.add(s as usize) != 0 && norm == 0 {\n108\t            norm = 1;\n109\t        }\n110\t        cost = cost.wrapping_add(\n111\t            (*count.add(s as usize)).wrapping_mul(kInverseProbabilityLog256[norm as usize]),\n112\t        );\n113\t        s += 1;\n114\t    }\n115\t    (cost >> 8) as usize\n116\t}\n117\t\n118\t/**\n119\t * Returns the cost in bits of encoding the distribution in count using ctable.\n120\t * Returns an error if ctable cannot represent all the symbols in count.\n121\t */\n122\t#[unsafe(no_mangle)]\n123\tpub unsafe extern \"C\" fn ZSTD_fseBitCost(\n124\t    ctable: *const FSE_CTable,\n125\t    count: *const c_uint,\n126\t    max: c_uint,\n127\t) -> usize {\n128\t    let kAccuracyLog: c_uint = 8;\n129\t    let mut cost: usize = 0;\n130\t    let mut s: c_uint;\n131\t    let mut cstate = FSE_CState_t::default();\n132\t    FSE_initCState(&mut cstate, ctable);\n133\t    if ZSTD_getFSEMaxSymbolValue(ctable) < max {\n134\t        return ERROR(ZSTD_error_GENERIC);\n135\t    }\n136\t    s = 0;\n137\t    while s <= max {\n138\t        let tableLog: c_uint = cstate.stateLog;\n139\t        let badCost: c_uint = (tableLog + 1) << kAccuracyLog;\n140\t        let bitCost: c_uint = FSE_bitCost(cstate.symbolTT, tableLog, s, kAccuracyLog);\n141\t        if *count.add(s as usize) == 0 {\n142\t            s += 1;\n143\t            continue;\n144\t        }\n145\t        if bitCost >= badCost {\n146\t            return ERROR(ZSTD_error_GENERIC);\n147\t        }\n148\t        cost = cost.wrapping_add((*count.add(s as usize) as usize).wrapping_mul(bitCost as usize));\n149\t        s += 1;\n150\t    }\n151\t    cost >> kAccuracyLog\n152\t}\n153\t\n154\t/**\n155\t * Returns the cost in bits of encoding the distribution in count using the\n156\t * table described by norm. The max symbol support by norm is assumed >= max.\n157\t * norm must be valid for every symbol with non-zero probability in count.\n158\t */\n159\t#[unsafe(no_mangle)]\n160\tpub unsafe extern \"C\" fn ZSTD_crossEntropyCost(\n161\t    norm: *const i16,\n162\t    accuracyLog: c_uint,\n163\t    count: *const c_uint,\n164\t    max: c_uint,\n165\t) -> usize {\n166\t    let shift: c_uint = 8 - accuracyLog;\n167\t    let mut cost: usize = 0;\n168\t    let mut s: c_uint;\n169\t\n170\t    s = 0;\n171\t    while s <= max {\n172\t        let normAcc: c_uint = if *norm.add(s as usize) != -1 {\n173\t            *norm.add(s as usize) as c_int as c_uint\n174\t        } else {\n175\t            1\n176\t        };\n177\t        let norm256: c_uint = normAcc << shift;\n178\t        cost = cost.wrapping_add(\n179\t            (*count.add(s as usize)).wrapping_mul(kInverseProbabilityLog256[norm256 as usize])\n180\t                as usize,\n181\t        );\n182\t        s += 1;\n183\t    }\n184\t    cost >> 8\n185\t}\n186\t\n187\t#[unsafe(no_mangle)]\n188\tpub unsafe extern \"C\" fn ZSTD_selectEncodingType(\n189\t    repeatMode: *mut FSE_repeat,\n190\t    count: *const c_uint,\n191\t    max: c_uint,\n192\t    mostFrequent: usize,\n193\t    nbSeq: usize,\n194\t    FSELog: c_uint,\n195\t    prevCTable: *const FSE_CTable,\n196\t    defaultNorm: *const i16,\n197\t    defaultNormLog: U32,\n198\t    isDefaultAllowed: ZSTD_DefaultPolicy_e,\n199\t    strategy: ZSTD_strategy,\n200\t) -> SymbolEncodingType_e {\n201\t    if mostFrequent == nbSeq {\n202\t        *repeatMode = FSE_repeat_none;\n203\t        if isDefaultAllowed != 0 && nbSeq <= 2 {\n204\t            /* Prefer set_basic over set_rle when there are 2 or fewer symbols,\n205\t             * since RLE uses 1 byte, but set_basic uses 5-6 bits per symbol.\n206\t             * If basic encoding isn't possible, always choose RLE.\n207\t             */\n208\t            return set_basic;\n209\t        }\n210\t        return set_rle;\n211\t    }\n212\t    if strategy < ZSTD_lazy {\n213\t        if isDefaultAllowed != 0 {\n214\t            let staticFse_nbSeq_max: usize = 1000;\n215\t            let mult: usize = (10u32.wrapping_sub(strategy)) as usize;\n216\t            let baseLog: usize = 3;\n217\t            /* 28-36 for offset, 56-72 for lengths */\n218\t            let dynamicFse_nbSeq_min: usize =\n219\t                ((1usize << defaultNormLog).wrapping_mul(mult)) >> baseLog;\n220\t            if (*repeatMode == FSE_repeat_valid) && (nbSeq < staticFse_nbSeq_max) {\n221\t                return set_repeat;\n222\t            }\n223\t            if (nbSeq < dynamicFse_nbSeq_min)\n224\t                || (mostFrequent < (nbSeq >> (defaultNormLog - 1)))\n225\t            {\n226\t                /* The format allows default tables to be repeated, but it isn't useful.\n227\t                 * When using simple heuristics to select encoding type, we don't want\n228\t                 * to confuse these tables with dictionaries. When running more careful\n229\t                 * analysis, we don't need to waste time checking both repeating tables\n230\t                 * and default tables.\n231\t                 */\n232\t                *repeatMode = FSE_repeat_none;\n233\t                return set_basic;\n234\t            }\n235\t        }\n236\t    } else {\n237\t        let basicCost: usize = if isDefaultAllowed != 0 {\n238\t            ZSTD_crossEntropyCost(defaultNorm, defaultNormLog, count, max)\n239\t        } else {\n240\t            ERROR(ZSTD_error_GENERIC)\n241\t        };\n242\t        let repeatCost: usize = if *repeatMode != FSE_repeat_none {\n243\t            ZSTD_fseBitCost(prevCTable, count, max)\n244\t        } else {\n245\t            ERROR(ZSTD_error_GENERIC)\n246\t        };\n247\t        let NCountCost: usize = ZSTD_NCountCost(count, max, nbSeq, FSELog);\n248\t        let compressedCost: usize =\n249\t            (NCountCost << 3).wrapping_add(ZSTD_entropyCost(count, max, nbSeq));\n250\t\n251\t        if basicCost <= repeatCost && basicCost <= compressedCost {\n252\t            *repeatMode = FSE_repeat_none;\n253\t            return set_basic;\n254\t        }\n255\t        if repeatCost <= compressedCost {\n256\t            return set_repeat;\n257\t        }\n258\t    }\n259\t    *repeatMode = FSE_repeat_check;\n260\t    set_compressed\n261\t}\n262\t\n263\t#[repr(C)]\n264\tpub struct ZSTD_BuildCTableWksp {\n265\t    pub norm: [S16; (MaxSeq + 1) as usize],\n266\t    pub wksp: [U32; FSE_BUILD_CTABLE_WORKSPACE_SIZE_U32(MaxSeq, MaxFSELog)],\n267\t}\n268\t\n269\t#[unsafe(no_mangle)]\n270\tpub unsafe extern \"C\" fn ZSTD_buildCTable(\n271\t    dst: *mut c_void,\n272\t    dstCapacity: usize,\n273\t    nextCTable: *mut FSE_CTable,\n274\t    FSELog: U32,\n275\t    type_: SymbolEncodingType_e,\n276\t    count: *mut c_uint,\n277\t    max: U32,\n278\t    codeTable: *const BYTE,\n279\t    nbSeq: usize,\n280\t    defaultNorm: *const S16,\n281\t    defaultNormLog: U32,\n282\t    defaultMax: U32,\n283\t    prevCTable: *const FSE_CTable,\n284\t    prevCTableSize: usize,\n285\t    entropyWorkspace: *mut c_void,\n286\t    entropyWorkspaceSize: usize,\n287\t) -> usize {\n288\t    let op = dst as *mut BYTE;\n289\t    let oend = op.add(dstCapacity) as *const BYTE;\n290\t\n291\t    match type_ {\n292\t        set_rle => {\n293\t            {\n294\t                let e = crate::compress::fse_compress::FSE_buildCTable_rle(nextCTable, max as BYTE);\n295\t                if ERR_isError(e) != 0 {\n296\t                    return e;\n297\t                }\n298\t            }\n299\t            if dstCapacity == 0 {\n300\t                return ERROR(ZSTD_error_dstSize_tooSmall);\n301\t            }\n302\t            *op = *codeTable;\n303\t            1\n304\t        }\n305\t        set_repeat => {\n306\t            ZSTD_memcpy(\n307\t                nextCTable as *mut c_void,\n308\t                prevCTable as *const c_void,\n309\t                prevCTableSize,\n310\t            );\n311\t            0\n312\t        }\n313\t        set_basic => {\n314\t            /* note : could be pre-calculated */\n315\t            let e = crate::compress::fse_compress::FSE_buildCTable_wksp(\n316\t                nextCTable,\n317\t                defaultNorm,\n318\t                defaultMax,\n319\t                defaultNormLog,\n320\t                entropyWorkspace,\n321\t                entropyWorkspaceSize,\n322\t            );\n323\t            if ERR_isError(e) != 0 {\n324\t                return e;\n325\t            }\n326\t            0\n327\t        }\n328\t        set_compressed => {\n329\t            let wksp = entropyWorkspace as *mut ZSTD_BuildCTableWksp;\n330\t            let mut nbSeq_1: usize = nbSeq;\n331\t            let tableLog: U32 =\n332\t                crate::compress::fse_compress::FSE_optimalTableLog(FSELog, nbSeq, max);\n333\t            if *count.add(*codeTable.add(nbSeq - 1) as usize) > 1 {\n334\t                *count.add(*codeTable.add(nbSeq - 1) as usize) -= 1;\n335\t                nbSeq_1 -= 1;\n336\t            }\n337\t            {\n338\t                /* \"FSE_normalizeCount failed\" */\n339\t                let e = crate::compress::fse_compress::FSE_normalizeCount(\n340\t                    (*wksp).norm.as_mut_ptr(),\n341\t                    tableLog,\n342\t                    count,\n343\t                    nbSeq_1,\n344\t                    max,\n345\t                    ZSTD_useLowProbCount(nbSeq_1),\n346\t                );\n347\t                if ERR_isError(e) != 0 {\n348\t                    return e;\n349\t                }\n350\t            }\n351\t            {\n352\t                /* overflow protected */\n353\t                let NCountSize: usize = crate::compress::fse_compress::FSE_writeNCount(\n354\t                    op as *mut c_void,\n355\t                    (oend as usize - op as usize) as usize,\n356\t                    (*wksp).norm.as_ptr(),\n357\t                    max,\n358\t                    tableLog,\n359\t                );\n360\t                if ERR_isError(NCountSize) != 0 {\n361\t                    return NCountSize;\n362\t                }\n363\t                {\n364\t                    /* \"FSE_buildCTable_wksp failed\" */\n365\t                    let e = crate::compress::fse_compress::FSE_buildCTable_wksp(\n366\t                        nextCTable,\n367\t                        (*wksp).norm.as_ptr(),\n368\t                        max,\n369\t                        tableLog,\n370\t                        (*wksp).wksp.as_mut_ptr() as *mut c_void,\n371\t                        core::mem::size_of_val(&(*wksp).wksp),\n372\t                    );\n373\t                    if ERR_isError(e) != 0 {\n374\t                        return e;\n375\t                    }\n376\t                }\n377\t                NCountSize\n378\t            }\n379\t        }\n380\t        _ => ERROR(ZSTD_error_GENERIC),\n381\t    }\n382\t}\n383\t\n384\t#[inline(always)]\n385\tpub(crate) unsafe fn ZSTD_encodeSequences_body(\n386\t    dst: *mut c_void,\n387\t    dstCapacity: usize,\n388\t    CTable_MatchLength: *const FSE_CTable,\n389\t    mlCodeTable: *const BYTE,\n390\t    CTable_OffsetBits: *const FSE_CTable,\n391\t    ofCodeTable: *const BYTE,\n392\t    CTable_LitLength: *const FSE_CTable,\n393\t    llCodeTable: *const BYTE,\n394\t    sequences: *const SeqDef,\n395\t    nbSeq: usize,\n396\t    longOffsets: c_int,\n397\t) -> usize {\n398\t    let mut blockStream = BIT_CStream_t::default();\n399\t    let mut stateMatchLength = FSE_CState_t::default();\n400\t    let mut stateOffsetBits = FSE_CState_t::default();\n401\t    let mut stateLitLength = FSE_CState_t::default();\n402\t\n403\t    if ERR_isError(BIT_initCStream(&mut blockStream, dst, dstCapacity)) != 0 {\n404\t        return ERROR(ZSTD_error_dstSize_tooSmall);\n405\t    }\n406\t\n407\t    /* first symbols */\n408\t    FSE_initCState2(\n409\t        &mut stateMatchLength,\n410\t        CTable_MatchLength,\n411\t        *mlCodeTable.add(nbSeq - 1) as U32,\n412\t    );\n413\t    FSE_initCState2(\n414\t        &mut stateOffsetBits,\n415\t        CTable_OffsetBits,\n416\t        *ofCodeTable.add(nbSeq - 1) as U32,\n417\t    );\n418\t    FSE_initCState2(\n419\t        &mut stateLitLength,\n420\t        CTable_LitLength,\n421\t        *llCodeTable.add(nbSeq - 1) as U32,\n422\t    );\n423\t    BIT_addBits(\n424\t        &mut blockStream,\n425\t        (*sequences.add(nbSeq - 1)).litLength as BitContainerType,\n426\t        LL_bits[*llCodeTable.add(nbSeq - 1) as usize] as u32,\n427\t    );\n428\t    if MEM_32bits() != 0 {\n429\t        BIT_flushBits(&mut blockStream);\n430\t    }\n431\t    BIT_addBits(\n432\t        &mut blockStream,\n433\t        (*sequences.add(nbSeq - 1)).mlBase as BitContainerType,\n434\t        ML_bits[*mlCodeTable.add(nbSeq - 1) as usize] as u32,\n435\t    );\n436\t    if MEM_32bits() != 0 {\n437\t        BIT_flushBits(&mut blockStream);\n438\t    }\n439\t    if longOffsets != 0 {\n440\t        let ofBits: U32 = *ofCodeTable.add(nbSeq - 1) as U32;\n441\t        let lim: U32 = STREAM_ACCUMULATOR_MIN() - 1;\n442\t        let extraBits: c_uint = ofBits - (if ofBits < lim { ofBits } else { lim });\n443\t        if extraBits != 0 {\n444\t            BIT_addBits(\n445\t                &mut blockStream,\n446\t                (*sequences.add(nbSeq - 1)).offBase as BitContainerType,\n447\t                e