]=(unsigned char)(pl>>8); src[p+2]=(unsigned char)pl; p+=3;\n  unsigned char*l=src+p;\n  unsigned h0=(unsigned)((litSize<<2)&0x1FFFFF);\n  l[0]=(unsigned char)h0; l[1]=(unsigned char)(h0>>8); l[2]=(unsigned char)((h0>>16)&0x1F); l[0]&=~3u;\n  { unsigned v=(unsigned)((litCSize<<5)&0xFFFFFF); l[2]=(unsigned char)((l[2]&0x1F)|(v&0xE0)); l[3]=(unsigned char)(v>>8); l[4]=(unsigned char)(v>>16); }\n  unsigned char*hp=l+5;\n  hp[0]=(unsigned char)(242+rnd()%14);       /* RLE weights -> valid huffman tree */\n  size_t rem = litCSize-1-6;\n  size_t a1=1+((unsigned)rnd())%(rem/3?rem/3:1);\n  size_t a2=1+((unsigned)rnd())%(rem/3?rem/3:1);\n  size_t a3=1+((unsigned)rnd())%(rem/3?rem/3:1);\n  if(a1+a2+a3>=rem){a1=a2=a3=(rem/4?rem/4:1);}\n  hp[1]=(unsigned char)a1;hp[2]=(unsigned char)(a1>>8);\n  hp[3]=(unsigned char)a2;hp[4]=(unsigned char)(a2>>8);\n  hp[5]=(unsigned char)a3;hp[6]=(unsigned char)(a3>>8);\n  unsigned char*s1=hp+7,*s2=s1+a1,*s3=s2+a2,*s4=s3+a3;\n  size_t a4 = (size_t)((hp+litCSize)-s4);\n  for(size_t i=7;i<litCSize;i++) hp[i]=rnd();\n  if(a1)s1[a1-1]=(unsigned char)(1+rnd()%255);   /* non-zero endMark */\n  if(a2)s2[a2-1]=(unsigned char)(1+rnd()%255);\n  if(a3)s3[a3-1]=(unsigned char)(1+rnd()%255);\n  if(a4&&a4<=litCSize)s4[a4-1]=(unsigned char)(1+rnd()%255);\n  unsigned char*sq=l+5+litCSize;\n  sq[0]=0; sq[1]=0;          /* nbSeq = 0 */\n  sq[2]=0xA8;                /* LL=rle, Off=rle, ML=rle, dumps 2-byte form, low bit 0 */\n  sq[3]=0;                   /* dumpsLength = 0 */\n  sq[4]=(unsigned char)rnd(); sq[5]=(unsigned char)rnd(); sq[6]=(unsigned char)rnd(); /* rle symbols */\n  sq[7]=0x01;                /* 1-byte bitstream, endMark -> endOfDStream true */\n  p+=pl; src[p++]=(unsigned char)(3<<6);src[p++]=0;src[p++]=0;\n  return p;\n}\nint main(int argc,char**argv){\n  void*hc=dlopen(argv[1],RTLD_NOW|RTLD_LOCAL); void*hr=dlopen(argv[2],RTLD_NOW|RTLD_LOCAL);\n  if(!hc||!hr){printf(\"%s\\n\",dlerror());return 1;}\n  dec_t dc=(dec_t)dlsym(hc,\"ZSTDv03_decompress\"), dr=(dec_t)dlsym(hr,\"ZSTDv03_decompress\");\n  ise_t ic=(ise_t)dlsym(hc,\"ZSTDv03_isError\");\n  size_t DST=1<<20; unsigned char*d1=malloc(DST),*d2=malloc(DST);\n  unsigned char src[SRCCAP]; int bad=0,okS=0,okB=0,tries=0;\n  for(int big=0;big<2;big++){\n    st = big?0x5A5A5A5A12345678ULL:0x1122334455667788ULL;\n    for(long it=0; it<400000; it++){\n      size_t n=gen(src,big); if(!n) continue; tries++;\n      memset(d1,0x11,DST); memset(d2,0x22,DST);\n      size_t r1=dc(d1,DST,src,n), r2=dr(d2,DST,src,n);\n      if(r1!=r2){printf(\"big=%d DEC it=%ld %zd vs %zd\\n\",big,it,(ssize_t)r1,(ssize_t)r2); if(++bad>4)return 1;}\n      else if(!ic(r1)){ if(big)okB++; else okS++;\n        if(memcmp(d1,d2,r1)){printf(\"big=%d DATA it=%ld r=%zu\\n\",big,it,r1); if(++bad>4)return 1;} }\n    }\n  }\n  printf(\"done tries=%d fullDecodes small=%d big=%d bad=%d\\n\",tries,okS,okB,bad);\n  return bad?1:0;\n}\nEOF\ngcc -O1 -o h5 h5.c -ldl\n./h5 /local/home/scheschb/.harvest/work/harvest-work-oyxCox/c_src/build/libzstd.so target/release/libv03check.so","uuid":"64036795-5b51-4e7f-bbb0-fdb5a965cb24","session_id":"9325aeb1-fde7-405e-a2e0-217179ef0d1d"}
