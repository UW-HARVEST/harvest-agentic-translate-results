lt(),\n669\t        }\n670\t    }\n671\t}\n672\t\n673\t/// `struct ZSTD_CCtx_s`\n674\t#[repr(C)]\n675\tpub struct ZSTD_CCtx {\n676\t    pub stage: ZSTD_compressionStage_e,\n677\t    pub cParamsChanged: c_int,\n678\t    pub bmi2: c_int,\n679\t    pub requestedParams: ZSTD_CCtx_params,\n680\t    pub appliedParams: ZSTD_CCtx_params,\n681\t    pub simpleApiParams: ZSTD_CCtx_params,\n682\t    pub dictID: U32,\n683\t    pub dictContentSize: usize,\n684\t\n685\t    pub workspace: ZSTD_cwksp,\n686\t    pub blockSizeMax: usize,\n687\t    pub pledgedSrcSizePlusOne: u64,\n688\t    pub consumedSrcSize: u64,\n689\t    pub producedCSize: u64,\n690\t    pub xxhState: XXH64_state_t,\n691\t    pub customMem: ZSTD_customMem,\n692\t    pub pool: *mut crate::pool::POOL_ctx,\n693\t    pub staticSize: usize,\n694\t    pub seqCollector: SeqCollector,\n695\t    pub isFirstBlock: c_int,\n696\t    pub initialized: c_int,\n697\t\n698\t    pub seqStore: SeqStore_t,\n699\t    pub ldmState: ldmState_t,\n700\t    pub ldmSequences: *mut rawSeq,\n701\t    pub maxNbLdmSequences: usize,\n702\t    pub externSeqStore: RawSeqStore_t,\n703\t    pub blockState: ZSTD_blockState_t,\n704\t    pub tmpWorkspace: *mut c_void,\n705\t    pub tmpWkspSize: usize,\n706\t\n707\t    pub bufferedPolicy: ZSTD_buffered_policy_e,\n708\t\n709\t    pub inBuff: *mut i8,\n710\t    pub inBuffSize: usize,\n711\t    pub inToCompress: usize,\n712\t    pub inBuffPos: usize,\n713\t    pub inBuffTarget: usize,\n714\t    pub outBuff: *mut i8,\n715\t    pub outBuffSize: usize,\n716\t    pub outBuffContentSize: usize,\n717\t    pub outBuffFlushedSize: usize,\n718\t    pub streamStage: ZSTD_cStreamStage,\n719\t    pub frameEnded: U32,\n720\t\n721\t    pub expectedInBuffer: ZSTD_inBuffer,\n722\t    pub stableIn_notConsumed: usize,\n723\t    pub expectedOutBufferSize: usize,\n724\t\n725\t    pub localDict: ZSTD_localDict,\n726\t    pub cdict: *const ZSTD_CDict,\n727\t    pub prefixDict: ZSTD_prefixDict,\n728\t\n729\t    /* Tracing (ZSTD_T