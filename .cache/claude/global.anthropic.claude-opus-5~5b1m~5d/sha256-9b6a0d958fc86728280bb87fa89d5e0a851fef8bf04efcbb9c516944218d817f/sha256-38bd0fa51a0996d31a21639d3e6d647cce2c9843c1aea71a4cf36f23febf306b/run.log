{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_0151J1JTocJP8HBcgQ4NGGTu","type":"tool_result","content":"395\t * The context is only dependent on the parameter `d` and can be used multiple\n396\t * times.\n397\t * Returns 0 on success or error code on error.\n398\t * The context must be destroyed with `FASTCOVER_ctx_destroy()`.\n399\t */\n400\tpub(crate) unsafe fn FASTCOVER_ctx_init(\n401\t    ctx: *mut FASTCOVER_ctx_t,\n402\t    samplesBuffer: *const c_void,\n403\t    samplesSizes: *const usize,\n404\t    nbSamples: c_uint,\n405\t    d: c_uint,\n406\t    splitPoint: f64,\n407\t    f: c_uint,\n408\t    accelParams: FASTCOVER_accel_t,\n409\t) -> usize {\n410\t    let samples: *const BYTE = samplesBuffer as *const BYTE;\n411\t    let totalSamplesSize: usize = COVER_sum(samplesSizes, nbSamples);\n412\t    /* Split samples into testing and training sets */\n413\t    let nbTrainSamples: c_uint = if splitPoint < 1.0 {\n414\t        ((nbSamples as f64) * splitPoint) as c_uint\n415\t    } else {\n416\t        nbSamples\n417\t    };\n418\t    let nbTestSamples: c_uint = if splitPoint < 1.0 {\n419\t        nbSamples.wrapping_sub(nbTrainSamples)\n420\t    } else {\n421\t        nbSamples\n422\t    };\n423\t    let trainingSamplesSize: usize = if splitPoint < 1.0 {\n424\t        COVER_sum(samplesSizes, nbTrainSamples)\n425\t    } else {\n426\t        totalSamplesSize\n427\t    };\n428\t    let testSamplesSize: usize = if splitPoint < 1.0 {\n429\t        COVER_sum(samplesSizes.add(nbTrainSamples as usize), nbTestSamples)\n430\t    } else {\n431\t        totalSamplesSize\n432\t    };\n433\t\n434\t    /* Checks */\n435\t    let maxDU64: usize = if (d as usize) > core::mem::size_of::<U64>() {\n436\t        d as usize\n437\t    } else {\n438\t        core::mem::size_of::<U64>()\n439\t    };\n440\t    if totalSamplesSize < maxDU64 || totalSamplesSize >= (FASTCOVER_MAX_SAMPLES_SIZE as usize) {\n441\t        /* DISPLAYLEVEL(1, \"Total samples size is too large ...\") */\n442\t        return ERROR(ZSTD_error_srcSize_wrong);\n443\t    }\n444\t\n445\t    /* Check if there are at least 5 training samples */\n446\t    if nbTrainSamples < 5 {\n447\t        /* DISPLAYLEVEL(1, \"Total number of training samples is %u and is invalid\\n\") */\n448\t        return ERROR(ZSTD_error_srcSize_wrong);\n449\t    }\n450\t\n451\t    /* Check if there's testing sample */\n452\t    if nbTestSamples < 1 {\n453\t        /* DISPLAYLEVEL(1, \"Total number of testing samples is %u and is invalid.\\n\") */\n454\t        return ERROR(ZSTD_error_srcSize_wrong);\n455\t    }\n456\t\n457\t    /* Zero the context */\n458\t    ZSTD_memset(\n459\t        ctx as *mut c_void,\n460\t        0,\n461\t        core::mem::size_of::<FASTCOVER_ctx_t>(),\n462\t    );\n463\t    /* DISPLAYLEVEL(2, \"Training on %u samples of total size %u\\n\", ...) */\n464\t    /* DISPLAYLEVEL(2, \"Testing on %u samples of total size %u\\n\", ...) */\n465\t    let _ = testSamplesSize;\n466\t\n467\t    (*ctx).samples = samples;\n468\t    (*ctx).samplesSizes = samplesSizes;\n469\t    (*ctx).nbSamples = nbSamples as usize;\n470\t    (*ctx).nbTrainSamples = nbTrainSamples as usize;\n471\t    (*ctx).nbTestSamples = nbTestSamples as usize;\n472\t    (*ctx).nbDmers = trainingSamplesSize.wrapping_sub(maxDU64).wrapping_add(1);\n473\t    (*ctx).d = d;\n474\t    (*ctx).f = f;\n475\t    (*ctx).accelParams = accelParams;\n476\t\n477\t    /* The offsets of each file */\n478\t    (*ctx).offsets = calloc(\n479\t        (nbSamples as usize) + 1,\n480\t        core::mem::size_of::<usize>(),\n481\t    ) as *mut usize;\n482\t    if (*ctx).offsets.is_null() {\n483\t        /* DISPLAYLEVEL(1, \"Failed to allocate scratch buffers \\n\") */\n484\t        FASTCOVER_ctx_destroy(ctx);\n485\t        return ERROR(ZSTD_error_memory_allocation);\n486\t    }\n487\t\n488\t    /* Fill offsets from the samplesSizes */\n489\t    {\n490\t        let mut i: U32;\n491\t        *(*ctx).offsets.add(0) = 0;\n492\t        i = 1;\n493\t        while i <= nbSamples {\n494\t            *(*ctx).offsets.add(i as usize) = (*(*ctx).offsets.add((i - 1) as usize))\n495\t                .wrapping_add(*samplesSizes.add((i - 1) as usize));\n496\t            i += 1;\n497\t        }\n498\t    }\n499\t\n500\t    /* Initialize frequency array of size 2^f */\n501\t    (*ctx).freqs = calloc(\n502\t        (1u64 << f) as usize,\n503\t        core::mem::size_of::<U32>(),\n504\t    ) as *mut U32;\n505\t    if (*ctx).freqs.is_null() {\n506\t        /* DISPLAYLEVEL(1, \"Failed to allocate frequency table \\n\") */\n507\t        FASTCOVER_ctx_destroy(ctx);\n508\t        return ERROR(ZSTD_error_memory_allocation);\n509\t    }\n510\t\n511\t    /* DISPLAYLEVEL(2, \"Computing frequencies\\n\") */\n512\t    FASTCOVER_computeFrequency((*ctx).freqs, ctx);\n513\t\n514\t    0\n515\t}\n516\t\n517\t/**\n518\t * Given the prepared context build the dictionary.\n519\t */\n520\tpub(crate) unsafe fn FASTCOVER_buildDictionary(\n521\t    ctx: *const FASTCOVER_ctx_t,\n522\t    freqs: *mut U32,\n523\t    dictBuffer: *mut c_void,\n524\t    dictBufferCapacity: usize,"}]},"parent_tool_use_id":"toolu_bdrk_01PjhR2pdxzLBfvVpSJYLcqU","session_id":"9325aeb1-fde7-405e-a2e0-217179ef0d1d","uuid":"e80adbf3-b048-4096-b5b1-ff68ccc7c256","timestamp":"2026-08-31T09:07:38.070Z","subagent_type":"general-purpose","task_description":"Restore dictBuilder stderr output"}
