          return ERROR(ZSTD_error_dictionaryCreation_failed);\n1740\t        } /* dictionary content too small */\n1741\t        if (dictContentSize as usize) < targetDictSize / 4 {\n1742\t            /* DISPLAYLEVEL(2, \"!  warning : selected content significantly smaller than requested\") */\n1743\t            if samplesBuffSize < 10 * targetDictSize {\n1744\t                /* DISPLAYLEVEL(2, \"!  consider increasing the number of samples\") */\n1745\t            }\n1746\t            if minRep > MINRATIO {\n1747\t                /* DISPLAYLEVEL(2, \"!  consider increasing selectivity ...\") */\n1748\t            }\n1749\t        }\n1750\t\n1751\t        if ((dictContentSize as usize) > targetDictSize * 3)\n1752\t            && (nbSamples > 2 * MINRATIO)\n1753\t            && (selectivity > 1)\n1754\t        {\n1755\t            let mut proposedSelectivity: c_uint = selectivity - 1;\n1756\t            while (nbSamples >> proposedSelectivity) <= MINRATIO {\n1757\t                proposedSelectivity -= 1;\n1758\t            }\n1759\t            /* DISPLAYLEVEL(2, ...) x3 */\n1760\t        }\n1761\t\n1762\t        /* limit dictionary size */\n1763\t        {\n1764\t            let max: U32 = (*dictList).pos; /* convention : nb of useful elts within dictList */\n1765\t            let mut currentSize: U32 = 0;\n1766\t            let mut n: U32 = 1;\n1767\t            while n < max {\n1768\t                currentSize = currentSize.wrapping_add((*dictList.add(n as usize)).length);\n1769\t                if currentSize as usize > targetDictSize {\n1770\t                    currentSize =\n1771\t                        currentSize.wrapping_sub((*dictList.add(n as usize)).length);\n1772\t                    break;\n1773\t                }\n1774\t                n += 1;\n1775\t            }\n1776\t            (*dictList).pos = n;\n1777\t            dictContentSize = currentSize;\n1778\t        }\n1779\t\n1780\t        /* build dict content */\n1781\t        {\n1782\t        