pub notificationLevel: c_uint,\n44\t    /// force dictID value; 0 means auto mode (32-bits random value)\n45\t    pub dictID: c_uint,\n46\t}\n47\t\n48\t#[repr(C)]\n49\t#[derive(Copy, Clone, Default)]\n50\tpub struct ZDICT_cover_params_t {\n51\t    pub k: c_uint,\n52\t    pub d: c_uint,\n53\t    pub steps: c_uint,\n54\t    pub nbThreads: c_uint,\n55\t    pub splitPoint: f64,\n56\t    pub shrinkDict: c_uint,\n57\t    pub shrinkDictMaxRegression: c_uint,\n58\t    pub zParams: ZDICT_params_t,\n59\t}\n60\t\n61\t#[repr(C)]\n62\t#[derive(Copy, Clone, Default)]\n63\tpub struct ZDICT_fastCover_params_t {\n64\t    pub k: c_uint,\n65\t    pub d: c_uint,\n66\t    pub f: c_uint,\n67\t    pub steps: c_uint,\n68\t    pub nbThreads: c_uint,\n69\t    pub splitPoint: f64,\n70\t    pub accel: c_uint,\n71\t    pub shrinkDict: c_uint,\n72\t    pub shrinkDictMaxRegression: c_uint,\n73\t    pub zParams: ZDICT_params_t,\n74\t}\n75\t\n76\t#[repr(C)]\n77\t#[derive(Copy, Clone, Default)]\n78\tpub struct ZDICT_legacy_params_t {\n79\t    pub selectivityLevel: c_uint,\n80\t    pub zParams: ZDICT_params_t,\n81\t}\n82\t\n83\t/*-*************************************\n84\t*  Constants\n85\t***************************************/\n86\tconst DICTLISTSIZE_DEFAULT: c_uint = 10000;\n87\t\n88\tconst NOISELENGTH: usize = 32;\n89\t\n90\tstatic g_selectivity_default: U32 = 9;\n91\t\n92\t/* `ZSTD_CLEVEL_DEFAULT` from zstd.h */\n93\tconst ZSTD_CLEVEL_DEFAULT: c_int = 3;\n94\t\n95\t/* `ZSTD_defaultCMem` from zstd.h */\n96\tconst ZSTD_defaultCMem: ZSTD_customMem = ZSTD_customMem {\n97\t    customAlloc: None,\n98\t    customFree: None,\n99\t    opaque: core::ptr::null_mut(),\n100\t};\n101\t\n102\t/* <time.h> */\n103\tpub type clock_t = i64;\n104\tconst CLOCKS_PER_SEC: clock_t = 1000000;\n105\t\n106\tunsafe extern \"C\" {\n107\t    fn clock() -> clock_t;\n108\t}\n109\t\n110\t/*-*************************************\n111\t*  Console display\n112\t***************************************/\n113\t/* DISPLAY() / DISPLA