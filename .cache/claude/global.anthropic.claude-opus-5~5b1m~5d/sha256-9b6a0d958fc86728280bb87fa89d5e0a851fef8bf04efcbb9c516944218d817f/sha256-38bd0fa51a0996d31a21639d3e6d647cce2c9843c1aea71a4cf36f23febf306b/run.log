olValue as usize)).deltaNbBits >> 16;\n215\t    let threshold: U32 = (minNbBits + 1) << 16;\n216\t    let tableSize: U32 = 1 << tableLog;\n217\t    let deltaFromThreshold: U32 = threshold\n218\t        .wrapping_sub((*symbolTT.add(symbolValue as usize)).deltaNbBits.wrapping_add(tableSize));\n219\t    let normalizedDeltaFromThreshold: U32 = (deltaFromThreshold << accuracyLog) >> tableLog;\n220\t    let bitMultiplier: U32 = 1 << accuracyLog;\n221\t    ((minNbBits + 1).wrapping_mul(bitMultiplier)).wrapping_sub(normalizedDeltaFromThreshold)\n222\t}\n223\t\n224\t/* ===== decompression inlines ===== */\n225\t\n226\t#[inline(always)]\n227\tpub unsafe fn FSE_initDState(\n228\t    DStatePtr: *mut FSE_DState_t,\n229\t    bitD: *mut BIT_DStream_t,\n230\t    dt: *const FSE_DTable,\n231\t) {\n232\t    let DTableH = dt as *const FSE_DTableHeader;\n233\t    (*DStatePtr).state = BIT_readBits(bitD, (*DTableH).tableLog as u32);\n234\t    BIT_reloadDStream(bitD);\n235\t    (*DStatePtr).table = dt.add(1) as *const c_void;\n236\t}\n237\t\n238\t#[inline(always)]\n239\tpub unsafe fn FSE_peekSymbol(DStatePtr: *const FSE_DState_t) -> BYTE {\n240\t    let DInfo = *((*DStatePtr).table as *const FSE_decode_t).add((*DStatePtr).state);\n241\t    DInfo.symbol\n242\t}\n243\t\n244\t#[inline(always)]\n245\tpub unsafe fn FSE_updateState(DStatePtr: *mut FSE_DState_t, bitD: *mut BIT_DStream_t) {\n246\t    let DInfo = *((*DStatePtr).table as *const FSE_decode_t).add((*DStatePtr).state);\n247\t    let nbBits = DInfo.nbBits as U32;\n248\t    let lowBits = BIT_readBits(bitD, nbBits);\n249\t    (*DStatePtr).state = (DInfo.newState as usize).wrapping_add(lowBits);\n250\t}\n251\t\n252\t#[inline(always)]\n253\tpub unsafe fn FSE_decodeSymbol(DStatePtr: *mut FSE_DState_t, bitD: *mut BIT_DStream_t) -> BYTE {\n254\t    let DInfo = *((*DStatePtr).table as *const FSE_decode_t).add((*DStatePtr).state);\n255\t    let nbBits = DInfo.nbBits as U32;\n256\t    let symbol = DInfo.symbol;\n257\t    let lowBits = BIT_readBit