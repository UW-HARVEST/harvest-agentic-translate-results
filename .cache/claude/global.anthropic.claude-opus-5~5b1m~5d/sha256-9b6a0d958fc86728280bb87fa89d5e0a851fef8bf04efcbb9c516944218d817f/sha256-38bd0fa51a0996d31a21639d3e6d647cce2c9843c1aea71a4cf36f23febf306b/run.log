{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_7aevvsvnkmggjiwf5cogawdkd4xomlpwrrl2i6aoxfsi3jxqfg5q","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01KF5cFLZUtotHDgBp1eRrNH","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-oyxCox/translation/src/compress/zstd_compress_literals.rs","content":"//! Translation of `compress/zstd_compress_literals.c`\n#![allow(dead_code)]\n\nuse core::ffi::{c_int, c_uint, c_void};\n\nuse crate::cmem::*;\nuse crate::compress::zstd_compress_internal::*;\nuse crate::error_private::*;\nuse crate::huf::*;\nuse crate::zstd_h::*;\nuse crate::zstd_internal::*;\n\n/* **************************************************************\n*  Debug Traces\n****************************************************************/\n/* `showHexa()` is only compiled for DEBUGLEVEL >= 2; DEBUGLEVEL is 0 here. */\n\n/* **************************************************************\n*  Literals compression - special cases\n****************************************************************/\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn ZSTD_noCompressLiterals(\n    dst: *mut c_void,\n    dstCapacity: usize,\n    src: *const c_void,\n    srcSize: usize,\n) -> usize {\n    let ostart = dst as *mut BYTE;\n    let flSize: U32 = 1 + (srcSize > 31) as U32 + (srcSize > 4095) as U32;\n\n    if srcSize + flSize as usize > dstCapacity {\n        return ERROR(ZSTD_error_dstSize_tooSmall);\n    }\n\n    match flSize {\n        1 => {\n            /* 2 - 1 - 5 */\n            *ostart = ((set_basic as U32 as usize).wrapping_add(srcSize << 3)) as BYTE;\n        }\n        2 => {\n            /* 2 - 2 - 12 */\n            MEM_writeLE16(\n                ostart as *mut c_void,\n                ((set_basic as U32 as usize)\n                    .wrapping_add(1 << 2)\n                    .wrapping_add(srcSize << 4)) as U16,\n            );\n        }\n        3 => {\n            /* 2 - 2 - 20 */\n            MEM_writeLE32(\n                ostart as *mut c_void,\n                ((set_basic as U32 as usize)\n                    .wrapping_add(3 << 2)\n                    .wrapping_add(srcSize << 4)) as U32,\n            );\n        }\n        _ => { /* not necessary : flSize is {1,2,3} */ }\n    }\n\n    ZSTD_memcpy(ostart.add(flSize as usize) as *mut c_void, src, srcSize);\n    srcSize + flSize as usize\n}\n\npub(crate) unsafe fn allBytesIdentical(src: *const c_void, srcSize: usize) -> c_int {\n    {\n        let b: BYTE = *(src as *const BYTE);\n        let mut p: usize = 1;\n        while p < srcSize {\n            if *(src as *const BYTE).add(p) != b {\n                return 0;\n            }\n            p += 1;\n        }\n        return 1;\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn ZSTD_compressRleLiteralsBlock(\n    dst: *mut c_void,\n    dstCapacity: usize,\n    src: *const c_void,\n    srcSize: usize,\n) -> usize {\n    let ostart = dst as *mut BYTE;\n    let flSize: U32 = 1 + (srcSize > 31) as U32 + (srcSize > 4095) as U32;\n\n    match flSize {\n        1 => {\n            /* 2 - 1 - 5 */\n            *ostart = ((set_rle as U32 as usize).wrapping_add(srcSize << 3)) as BYTE;\n        }\n        2 => {\n            /* 2 - 2 - 12 */\n            MEM_writeLE16(\n                ostart as *mut c_void,\n                ((set_rle as U32 as usize)\n                    .wrapping_add(1 << 2)\n                    .wrapping_add(srcSize << 4)) as U16,\n            );\n        }\n        3 => {\n            /* 2 - 2 - 20 */\n            MEM_writeLE32(\n                ostart as *mut c_void,\n                ((set_rle as U32 as usize)\n                    .wrapping_add(3 << 2)\n                    .wrapping_add(srcSize << 4)) as U32,\n            );\n        }\n        _ => { /* not necessary : flSize is {1,2,3} */ }\n    }\n\n    *ostart.add(flSize as usize) = *(src as *const BYTE);\n    flSize as usize + 1\n}\n\n/* ZSTD_minLiteralsToCompre