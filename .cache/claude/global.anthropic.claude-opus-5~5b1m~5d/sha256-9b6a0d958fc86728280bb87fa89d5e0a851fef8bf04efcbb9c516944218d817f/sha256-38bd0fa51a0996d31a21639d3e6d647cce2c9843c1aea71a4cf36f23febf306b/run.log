unsigned char*d1=malloc(DST),*d2=malloc(DST);\n  unsigned char src[SRCCAP]; int bad=0,ok=0,tries=0;\n  for(int pass=4;pass<=5;pass++){\n    st = (pass==4)?0xABCDEF0123456789ULL:0x0F1E2D3C4B5A6978ULL;\n    for(long it=0; it<300000; it++){\n      size_t n=gen_lit(src,pass); if(!n) continue; tries++;\n      memset(d1,0x11,DST); memset(d2,0x11,DST);\n      size_t r1=dc(d1,DST,src,n), r2=dr(d2,DST,src,n);\n      if(r1!=r2){printf(\"pass%d DEC it=%ld %zd vs %zd\\n\",pass,it,(ssize_t)r1,(ssize_t)r2); if(++bad>4)return 1;}\n      else if(!ic(r1)){ok++; if(memcmp(d1,d2,DST)){printf(\"pass%d DATA it=%ld r=%zu\\n\",pass,it,r1); if(++bad>4)return 1;}}\n    }\n  }\n  printf(\"done tries=%d ok=%d bad=%d\\n\",tries,ok,bad);\n  return bad?1:0;\n}\nEOF\ngcc -O1 -o h4 h4.c -ldl\n./h4 /local/home/scheschb/.harvest/work/harvest-work-oyxCox/c_src/build/libzstd.so target/release/libv03check.so\n\necho \"=== coverage of these passes on the C original ===\"\ncp $CS/legacy/zstd_v03.c $CS/legacy/zstd_v03.h .\ncat > cdrv.c <<'EOF'\n#include <stdio.h>\n#include \"gen.h\"\nsize_t ZSTDv03_decompress(void*,size_t,const void*,size_t);\nconst char* ERR_getErrorString(int c){(void)c;return \"\";}\nint main(void){\n  size_t DST=1<<20; unsigned char*d=malloc(DST); unsigned char src[SRCCAP];\n  for(int pass=4;pass<=5;pass++){\n    st=(pass==4)?0xABCDEF0123456789ULL:0x0F1E2D3C4B5A6978ULL;\n    for(long it=0;it<300000;it++){ size_t n=gen_lit(src,pass); if(!n)continue; ZSTDv03_decompress(d,DST,src,n); }\n  }\n  printf(\"cdrv done\\n\"); return 0;\n}\nEOF\ngcc -O0 -g --coverage -I. -I$CS -I$CS/common -c zstd_v03.c -o zv.o\ngcc -O0 -g --coverage -I. -c cdrv.c -o cdrv.o\ngcc --coverage -o cdrv cdrv.o zv.o\n./cdrv\ngcov -b zstd_v03.c | grep 'Lines executed' | head -1\npython3 - <<'PY'\nimport re\nbyline={}\nfor L in open('zstd_v03.c.gcov'):\n    m=re.match(r'^\\s*([^:]*):\\s*(\\d+):',L)\n    if m: byline[int(m.group(2))]=m.group(1).strip()\nfuncs={\"FSE_decompress_usingDTable_generic\":1276,\"FSE_decompress\":1359,\"HUF_readStats\":1477,\n\"HUF_fillDTableX4Level2\":1769,\"HUF_fillDTableX4\":1814,\"HUF_readDTableX4\":1862,\n\"HUF_decodeSymbolX4\":1949,\"HUF_decodeLastSymbolX4\":1957,\"HUF_decodeStreamX4\":1986,\n\"HUF_decompress4X4_usingDTable\":2014,\"HUF_decompress4X4\":2111,\"HUF_decompress\":2154,\n\"HUF_decompress4X2\":1749,\"HUF_readDTableX2\":1560}\nends=sorted(set(list(funcs.values())+[1359,1388,1560,1608,1627,1652,1749,1769,1814,1862,1949,1957,1986,2014,2111,2154,2185]))\nfor f,s in sorted(funcs.items(),key=lambda kv:kv[1]):\n    e=[x for x in ends if x>s][0]\n    ex=nex=0\n    for ln in range(s,e):\n        c=byline.get(ln)\n        if c is None or c in('-',''):continue\n        if c.startswith('#') or c.startswith('='):nex+=1\n        else: ex+=1\n    print(f\"{f:38s} exec={ex:5} notexec={nex:5}\")\nPY","is_backgrounded":false,"task_type":"local_bash","uuid":"6ec540c1-8598-4dc2-b7b0-4167b50d846b","session_id":"9325aeb1-fde7-405e-a2e0-217179ef0d1d"}
