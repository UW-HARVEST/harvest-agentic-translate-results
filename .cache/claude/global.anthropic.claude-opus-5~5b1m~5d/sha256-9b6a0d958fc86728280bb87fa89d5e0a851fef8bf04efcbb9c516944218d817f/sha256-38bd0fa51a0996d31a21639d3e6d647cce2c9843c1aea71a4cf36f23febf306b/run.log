{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_012X3YFcC58qz4w4MqM9FqrH","type":"tool_result","content":"1\t//! Translation of `common/mem.h`, `common/zstd_deps.h` helpers and libc glue.\n2\t#![allow(dead_code)]\n3\t\n4\tuse core::ffi::c_void;\n5\t\n6\tpub type BYTE = u8;\n7\tpub type U8 = u8;\n8\tpub type S8 = i8;\n9\tpub type U16 = u16;\n10\tpub type S16 = i16;\n11\tpub type U32 = u32;\n12\tpub type S32 = i32;\n13\tpub type U64 = u64;\n14\tpub type S64 = i64;\n15\t\n16\tunsafe extern \"C\" {\n17\t    pub fn malloc(size: usize) -> *mut c_void;\n18\t    pub fn calloc(n: usize, size: usize) -> *mut c_void;\n19\t    pub fn free(p: *mut c_void);\n20\t    pub fn memcpy(dst: *mut c_void, src: *const c_void, n: usize) -> *mut c_void;\n21\t    pub fn memmove(dst: *mut c_void, src: *const c_void, n: usize) -> *mut c_void;\n22\t    pub fn memset(dst: *mut c_void, c: i32, n: usize) -> *mut c_void;\n23\t    pub fn memcmp(a: *const c_void, b: *const c_void, n: usize) -> i32;\n24\t    pub fn strlen(s: *const core::ffi::c_char) -> usize;\n25\t}\n26\t\n27\t#[inline(always)]\n28\tpub unsafe fn ZSTD_memcpy(dst: *mut c_void, src: *const c_void, n: usize) {\n29\t    if n != 0 {\n30\t        core::ptr::copy_nonoverlapping(src as *const u8, dst as *mut u8, n);\n31\t    }\n32\t}\n33\t\n34\t#[inline(always)]\n35\tpub unsafe fn ZSTD_memmove(dst: *mut c_void, src: *const c_void, n: usize) {\n36\t    if n != 0 {\n37\t        core::ptr::copy(src as *const u8, dst as *mut u8, n);\n38\t    }\n39\t}\n40\t\n41\t#[inline(always)]\n42\tpub unsafe fn ZSTD_memset(dst: *mut c_void, c: i32, n: usize) {\n43\t    if n != 0 {\n44\t        core::ptr::write_bytes(dst as *mut u8, c as u8, n);\n45\t    }\n46\t}\n47\t\n48\t#[inline(always)]\n49\tpub unsafe fn ZSTD_memcmp(a: *const c_void, b: *const c_void, n: usize) -> i32 {\n50\t    if n == 0 {\n51\t        return 0;\n52\t    }\n53\t    memcmp(a, b, n)\n54\t}\n55\t\n56\t/* ===== platform detection ===== */\n57\t#[inline(always)]\n58\tpub fn MEM_32bits() -> u32 {\n59\t    (core::mem::size_of::<usize>() == 4) as u32\n60\t}\n61\t#[inline(always)]\n62\tpub fn MEM_64bits() -> u32 {\n63\t    (core::mem::size_of::<usize>() == 8) as u32\n64\t}\n65\t#[inline(always)]\n66\tpub fn MEM_isLittleEndian() -> u32 {\n67\t    if cfg!(target_endian = \"little\") {\n68\t        1\n69\t    } else {\n70\t        0\n71\t    }\n72\t}\n73\t\n74\t/* ===== native unaligned read/write ===== */\n75\t#[inline(always)]\n76\tpub unsafe fn MEM_read16(p: *const c_void) -> U16 {\n77\t    (p as *const U16).read_unaligned()\n78\t}\n79\t#[inline(always)]\n80\tpub unsafe fn MEM_read32(p: *const c_void) -> U32 {\n81\t    (p as *const U32).read_unaligned()\n82\t}\n83\t#[inline(always)]\n84\tpub unsafe fn MEM_read64(p: *const c_void) -> U64 {\n85\t    (p as *const U64).read_unaligned()\n86\t}\n87\t#[inline(always)]\n88\tpub unsafe fn MEM_readST(p: *const c_void) -> usize {\n89\t    (p as *const usize).read_unaligned()\n90\t}\n91\t#[inline(always)]\n92\tpub unsafe fn MEM_write16(p: *mut c_void, v: U16) {\n93\t    (p as *mut U16).write_unaligned(v)\n94\t}\n95\t#[inline(always)]\n96\tpub unsafe fn MEM_write32(p: *mut c_void, v: U32) {\n97\t    (p as *mut U32).write_unaligned(v)\n98\t}\n99\t#[inline(always)]\n100\tpub unsafe fn MEM_write64(p: *mut c_void, v: U64) {\n101\t    (p as *mut U64).write_unaligned(v)\n102\t}\n103\t\n104\t/* ===== byteswap ===== */\n105\t#[inline(always)]\n106\tpub fn MEM_swap32(v: U32) -> U32 {\n107\t    v.swap_bytes()\n108\t}\n109\t#[inline(always)]\n110\tpub fn MEM_swap64(v: U64) -> U64 {\n111\t    v.swap_bytes()\n112\t}\n113\t#[inline(always)]\n114\tpub fn MEM_swapST(v: usize) -> usize {\n115\t    v.swap_bytes()\n116\t}\n117\t\n118\t/* ===== little-endian ===== */\n119\t#[inline(always)]\n120\tpub unsafe fn MEM_readLE16(p: *const c_void) -> U16 {\n121\t    U16::from_le(MEM_read16(p))\n122\t}\n123\t#[inline(always)]\n124\tpub unsafe fn MEM_writeLE16(p: *mut c_void, v: U16) {\n125\t    MEM_write16(p, v.to_le())\n126\t}\n127\t#[inline(always)]\n128\tpub unsafe fn MEM_readLE24(p: *const c_void) -> U32 {\n129\t    MEM_readLE16(p) as U32 + ((*(p as *const BYTE).add(2) as U32) << 16)\n130\t}\n131\t#[inline(always)]\n132\tpub unsafe fn MEM_writeLE24(p: *mut c_void, v: U32) {\n133\t    MEM_writeLE16(p, v as U16);\n134\t    *(p as *mut BYTE).add(2) = (v >> 16) as BYTE;\n135\t}\n136\t#[inline(always)]\n137\tpub unsafe fn MEM_readLE32(p: *const c_void) -> U32 {\n138\t    U32::from_le(MEM_read32(p))\n139\t}\n140\t#[inline(always)]\n141\tpub unsafe fn MEM_writeLE32(p: *mut c_void, v: U32) {\n142\t    MEM_write32(p, v.to_le())\n143\t}\n144\t#[inline(always)]\n145\tpub unsafe fn MEM_readLE64(p: *const c_void) -> U64 {\n146\t    U64::from_le(MEM_read64(p))\n147\t}\n148\t#[inline(always)]\n149\tpub unsafe fn MEM_writeLE64(p: *mut c_void, v: U64) {\n150\t    MEM_write64(p, v.to_le())\n151\t}\n152\t#[inline(always)]\n153\tpub unsafe fn MEM_readLEST(p: *const c_void) -> usize {\n154\t    usize::from_le(MEM_readST(p))\n155\t}\n156\t#[inline(always)]\n157\tpub unsafe fn MEM_writeLEST(p: *mut c_void, v: usize) {\n158\t    (p as *mut usize).write_unaligned(v.to_le())\n159\t}\n160\t\n161\t/* ===== big-endian ===== */\n162\t#[inline(always)]\n163\tpub unsafe fn MEM_readBE32(p: *const c_void) -> U32 {\n164\t    U32::from_be(MEM_read32(p))\n165\t}\n166\t#[inline(always)]\n167\tpub unsafe fn MEM_writeBE32(p: *mut c_void, v: U32) {\n168\t    MEM_write32(p, v.to_be())\n169\t}\n170\t#[inline(always)]\n171\tpub unsafe fn MEM_readBE64(p: *const c_void) -> U64 {\n172\t    U64::from_be(MEM_read64(p))\n173\t}\n174\t#[inline(always)]\n175\tpub unsafe fn MEM_writeBE64(p: *mut c_void, v: U64) {\n176\t    MEM_write64(p, v.to_be())\n177\t}\n178\t#[inline(always)]\n179\tpub unsafe fn MEM_readBEST(p: *const c_void) -> usize {\n180\t    usize::from_be(MEM_readST(p))\n181\t}\n182\t#[inline(always)]\n183\tpub unsafe fn MEM_writeBEST(p: *mut c_void, v: usize) {\n184\t    (p as *mut usize).write_unaligned(v.to_be())