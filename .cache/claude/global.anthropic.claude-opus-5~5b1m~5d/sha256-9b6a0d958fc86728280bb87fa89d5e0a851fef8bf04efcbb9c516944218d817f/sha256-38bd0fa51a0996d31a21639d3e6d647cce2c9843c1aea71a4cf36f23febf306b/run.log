CElt* hufTable, HUF_repeat* repeat, int flags);\n156\t\n157\t/** HUF_buildCTable_wksp() :\n158\t *  Same as HUF_buildCTable(), but using externally allocated scratch buffer.\n159\t * `workSpace` must be aligned on 4-bytes boundaries, and its size must be >= HUF_CTABLE_WORKSPACE_SIZE.\n160\t */\n161\t#define HUF_CTABLE_WORKSPACE_SIZE_U32 ((4 * (HUF_SYMBOLVALUE_MAX + 1)) + 192)\n162\t#define HUF_CTABLE_WORKSPACE_SIZE (HUF_CTABLE_WORKSPACE_SIZE_U32 * sizeof(unsigned))\n163\tsize_t HUF_buildCTable_wksp (HUF_CElt* tree,\n164\t                       const unsigned* count, U32 maxSymbolValue, U32 maxNbBits,\n165\t                             void* workSpace, size_t wkspSize);\n166\t\n167\t/*! HUF_readStats() :\n168\t *  Read compact Huffman tree, saved by HUF_writeCTable().\n169\t * `huffWeight` is destination buffer.\n170\t * @return : size read from `src` , or an error Code .\n171\t *  Note : Needed by HUF_readCTable() and HUF_readDTableXn() . */\n172\tsize_t HUF_readStats(BYTE* huffWeight, size_t hwSize,\n173\t                     U32* rankStats, U32* nbSymbolsPtr, U32* tableLogPtr,\n174\t                     const void* src, size_t srcSize);\n175\t\n176\t/*! HUF_readStats_wksp() :\n177\t * Same as HUF_readStats() but takes an external workspace which must be\n178\t * 4-byte aligned and its size must be >= HUF_READ_STATS_WORKSPACE_SIZE.\n179\t * If the CPU has BMI2 support, pass bmi2=1, otherwise pass bmi2=0.\n180\t */\n181\t#define HUF_READ_STATS_WORKSPACE_SIZE_U32 FSE_DECOMPRESS_WKSP_SIZE_U32(6, HUF_TABLELOG_MAX-1)\n182\t#define HUF_READ_STATS_WORKSPACE_SIZE (HUF_READ_STATS_WORKSPACE_SIZE_U32 * sizeof(unsigned))\n183\tsize_t HUF_readStats_wksp(BYTE* huffWeight, size_t hwSize,\n184\t                          U32* rankStats, U32* nbSymbolsPtr, U32* tableLogPtr,\n185\t                          const void* src, size_t srcSize,\n186\t                          void* workspace, size_t wkspSize,\n187\t                          int flags);\n188\t\n189\t/** HUF_readCTable() :\n