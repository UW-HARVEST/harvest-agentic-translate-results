{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01EVE9bz6b71YktNXfCJQGv1","type":"tool_result","content":"1\t// Rust translation of c_src/src/lib.c\n2\t//\n3\t// Copyright 2025 MIT Lincoln Laboratory\n4\t// Permission is hereby granted, free of charge,\n5\t// to any person obtaining a copy of this software\n6\t// and associated documentation files (the \"Software\"),\n7\t// to deal in the Software without restriction,\n8\t// including without limitation the rights to use, copy,\n9\t// modify, merge, publish, distribute, sublicense,\n10\t// and/or sell copies of the Software,\n11\t// and to permit persons to whom the Software is furnished to do so,\n12\t// subject to the following conditions:\n13\t//\n14\t// The above copyright notice and this permission notice\n15\t// shall be included in all copies or substantial portions of the Software.\n16\t//\n17\t// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n18\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n19\t// THE WARRANTIES OF MERCHANTABILITY,\n20\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n21\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n22\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n23\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n24\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n25\t\n26\t#![allow(non_snake_case)]\n27\t// The `printf!` helper macro already wraps the variadic call in `unsafe`, which\n28\t// makes some of the surrounding explicit `unsafe` blocks redundant.\n29\t#![allow(unused_unsafe)]\n30\t\n31\tuse core::ffi::{c_char, c_int, c_uint, c_void};\n32\t\n33\t// ---------------------------------------------------------------------------\n34\t// libc bindings.\n35\t//\n36\t// The C library performs all of its output with `printf` on the C runtime's\n37\t// `stdout`.  We call straight into libc so that formatting *and* buffering\n38\t// behaviour (and therefore the exact byte stream produced) are identical.\n39\t// ---------------------------------------------------------------------------\n40\tunsafe extern \"C\" {\n41\t    #[link_name = \"printf\"]\n42\t    unsafe fn c_printf(fmt: *const c_char, ...) -> c_int;\n43\t    unsafe fn malloc(size: usize) -> *mut c_void;\n44\t    unsafe fn free(ptr: *mut c_void);\n45\t    unsafe fn memcpy(dst: *mut c_void, src: *const c_void, n: usize) -> *mut c_void;\n46\t}\n47\t\n48\t/// Build a NUL-terminated C string literal usable as a `printf` format.\n49\tmacro_rules! cstr {\n50\t    ($s:expr) => {\n51\t        concat!($s, \"\\0\").as_ptr() as *const c_char\n52\t    };\n53\t}\n54\t\n55\t/// `printf(fmt, args...)`\n56\tmacro_rules! printf {\n57\t    ($fmt:expr) => {\n58\t        unsafe { c_printf(cstr!($fmt)) }\n59\t    };\n60\t    ($fmt:expr, $($arg:expr),* $(,)?) => {\n61\t        unsafe { c_printf(cstr!($fmt), $($arg),*) }\n62\t    };\n63\t}\n64\t\n65\t// #define STRINGIFY(x) #x\n66\t// #define LOG_VALUE(var) printf(\"Variable \" STRINGIFY(var) \" = %d\\n\", var)\n67\tmacro_rules! log_value {\n68\t    ($name:expr, $var:expr) => {\n69\t        printf!(concat!(\"Variable \", $name, \" = %d\\n\"), $var as c_int)\n70\t    };\n71\t}\n72\t\n73\t// #define OP_ADD 0x01\n74\t#[allow(dead_code)]\n75\tconst OP_ADD: c_int = 0x01;\n76\t// #define OP_MULTIPLY 0x02\n77\t#[allow(dead_code)]\n78\tconst OP_MULTIPLY: c_int = 0x02;\n79\t// #define OP_XOR 0x03\n80\t#[allow(dead_code)]\n81\tconst OP_XOR: c_int = 0x03;\n82\t// #define OP_SHIFT 0x04\n83\t#[allow(dead_code)]\n84\tconst OP_SHIFT: c_int = 0x04;\n85\t// #define MAGIC_NUMBER 0xDEADBEEF\n86\tconst MAGIC_NUMBER: c_uint = 0xDEAD_BEEF;\n87\t// #define MASK_LOWER 0x0000FFFF\n88\tconst MASK_LOWER: c_uint = 0x0000_FFFF;\n89\t\n90\t/// typedef struct { int accumulator; int operation_count; unsigned int checksum; } ComputeState;\n91\t#[repr(C)]\n92\t#[derive(Clone, Copy)]\n93\tpub struct ComputeState {\n94\t    pub accumulator: c_int,\n95\t    pub operation_count: c_int,\n96\t    pub checksum: c_uint,\n97\t}\n98\t\n99\t/// typedef int (*operation_func)(int, int);\n100\tpub type OperationFunc = Option<unsafe extern \"C\" fn(c_int, c_int) -> c_int>;\n101\t\n102\t// static int static_multiplier = 3;\n103\tconst STATIC_MULTIPLIER: c_int = 3;\n104\t// static int static_addend = 100;\n105\tconst STATIC_ADDEND: c_int = 100;\n106\t// static int static_shift_amount = 2;\n107\tconst STATIC_SHIFT_AMOUNT: c_int = 2;\n108\t\n109\t// ---------------------------------------------------------------------------\n110\t// int multiply_with_static(int a, int b)\n111\t// ---------------------------------------------------------------------------\n112\t#[unsafe(no_mangle)]\n113\tpub unsafe extern \"C\" fn multiply_with_static(a: c_int, b: c_int) -> c_int {\n114\t    // return (a * b) * static_multiplier;\n115\t    a.wrapping_mul(b).wrapping_mul(STATIC_MULTIPLIER)\n116\t}\n117\t\n118\t// ---------------------------------------------------------------------------\n119\t// int add_with_static(int a, int b)\n120\t// ---------------------------------------------------------------------------\n121\t#[unsafe(no_mangle)]\n122\tpub unsafe extern \"C\" fn add_with_static(a: c_int, b: c_int) -> c_int {\n123\t    // return (a + b) + static_addend;\n124\t    a.wrapping_add(b).wrapping_add(STATIC_ADDEND)\n125\t}\n126\t\n127\t// ---------------------------------------------------------------------------\n128\t// int xor_operation(int a, int b)\n129\t// ---------------------------------------------------------------------------\n130\t#[unsafe(no_mangle)]\n131\tpub unsafe extern \"C\" fn xor_operation(a: c_int, b: c_int) -> c_int {\n132\t    // return a ^ b ^ 0xABCD;\n133\t    a ^ b ^ 0xABCD\n134\t}\n135\t\n136\t// ---------------------------------------------------------------------------\n137\t// int shift_with_static(int a, int b)\n138\t// ---------------------------------------------------------------------------\n139\t#[unsafe(no_mangle)]\n140\tpub unsafe extern \"C\" fn shift_with_static(a: c_int, b: c_int) -> c_int {\n141\t    // return (a << static_shift_amount) | (b >> static_shift_amount);\n142\t    //\n143\t    // The left shift of a (possibly negative) signed value is what gcc emits:\n144\t    // a plain logical shift of the bit pattern.  The right shift of a signed\n145\t    // value is an arithmetic shift.\n146\t    let left = ((a as u32) << (STATIC_SHIFT_AMOUNT as u32)) as c_int;\n147\t    let right = a_shr(b, STATIC_SHIFT_AMOUNT);\n148\t    left | right\n149\t}\n150\t\n151\t#[inline]\n152\tfn a_shr(value: c_int, amount: c_int) -> c_int {\n153\t    value >> (amount as u32)\n154\t}\n155\t\n156\t// ---------------------------------------------------------------------------\n157\t// operation_func get_operation(int opcode)\n158\t// ---------------------------------------------------------------------------\n159\t#[unsafe(no_mangle)]\n160\tpub unsafe extern \"C\" fn get_operation(opcode: c_int) -> OperationFunc {\n161\t    // static operation_func ops[4] = {NULL, NULL, NULL, NULL};\n162\t    //\n163\t    // The C code lazily fills the static table on first use; the observable\n164\t    // behaviour is simply the fixed mapping below.\n165\t    let ops: [OperationFunc; 4] = [\n166\t        Some(multiply_with_static),\n167\t        Some(add_with_static),\n168\t        Some(xor_operation),\n169\t        Some(shift_with_static),\n170\t    ];\n171\t\n172\t    if opcode >= 0 && opcode < 4 {\n173\t        return ops[opcode as usize];\n174\t    }\n175\t\n176\t    None\n177\t}\n178\t\n179\t// ---------------------------------------------------------------------------\n180\t// int execute_operation(operation_func func, int a, int b, const char* op_name)\n181\t// ---------------------------------------------------------------------------\n182\t#[unsafe(no_mangle)]\n183\tpub unsafe extern \"C\" fn execute_operation(\n184\t    func: OperationFunc,\n185\t    a: c_int,\n186\t    b: c_int,\n187\t    op_name: *const c_char,\n188\t) -> c_int {\n189\t    let func = match func {\n190\t        None => {\n191\t            printf!(\n192\t                \"Error: Operation function pointer is NULL for %s\\n\",\n193\t                op_name\n194\t            );\n195\t            return 0;\n196\t        }\n197\t        Some(f) => f,\n198\t    };\n199\t\n200\t    log_value!(\"a\", a);\n201\t    log_value!(\"b\", b);\n202\t\n203\t    let result = unsafe { func(a, b) };\n204\t    printf!(\"Result of %s: %d\\n\", op_name, result);\n205\t\n206\t    result\n207\t}\n208\t\n209\t// ---------------------------------------------------------------------------\n210\t// unsigned int compute_checksum(int* values, int count)\n211\t// ---------------------------------------------------------------------------\n212\t#[unsafe(no_mangle)]\n213\tpub unsafe extern \"C\" fn compute_checksum(values: *mut c_int, count: c_int) -> c_uint {\n214\t    let mut checksum: c_uint = 0;\n215\t    // unsigned char buffer[sizeof(int) * 4];\n216\t    let mut buffer = [0u8; core::mem::size_of::<c_int>() * 4];\n217\t\n218\t    if !values.is_null() && count > 0 {\n219\t        let copy_count = if count > 4 { 4 } else { count } as usize;\n220\t        let nbytes = core::mem::size_of::<c_int>() * copy_count;\n221\t\n222\t        unsafe {\n223\t            memcpy(\n224\t                buffer.as_mut_ptr() as *mut c_void,\n225\t                values as *const c_void,\n226\t                nbytes,\n227\t            );\n228\t        }\n229\t\n230\t        for i in 0..nbytes {\n231\t            checksum = (checksum << 1) ^ (buffer[i] as c_uint);\n232\t        }\n233\t\n234\t        checksum ^= MAGIC_NUMBER;\n235\t    }\n236\t\n237\t    checksum & MASK_LOWER\n238\t}\n239\t\n240\t// ---------------------------------------------------------------------------\n241\t// void init_state(ComputeState* state, int initial_value)\n242\t// ---------------------------------------------------------------------------\n243\t#[unsafe(no_mangle)]\n244\tpub unsafe extern \"C\" fn init_state(state: *mut ComputeState, initial_value: c_int) {\n245\t    if state.is_null() {\n246\t        printf!(\"Error: state pointer is NULL in init_state\\n\");\n247\t        return;\n248\t    }\n249\t\n250\t    // ComputeState template = {initial_value, 0, 0x0000};\n251\t    let template = ComputeState {\n252\t        accumulator: initial_value,\n253\t        operation_count: 0,\n254\t        checksum: 0x0000,\n255\t    };\n256\t\n257\t    unsafe {\n258\t        memcpy(\n259\t            state as *mut c_void,\n260\t            &template as *const ComputeState as *const c_void,\n261\t            core::mem::size_of::<ComputeState>(),\n262\t        );\n263\t\n264\t        printf!(\n265\t            \"State initialized with accumulator = %d\\n\",\n266\t            (*state).accumulator\n267\t        );\n268\t    }\n269\t}\n270\t\n271\t// ---------------------------------------------------------------------------\n272\t// void apply_operation(ComputeState* state, int value, operation_func func)\n273\t// ---------------------------------------------------------------------------\n274\t#[unsafe(no_mangle)]\n275\tpub unsafe extern \"C\" fn apply_operation(\n276\t    state: *mut ComputeState,\n277\t    value: c_int,\n278\t    func: OperationFunc,\n279\t) {\n280\t    if state.is_null() {\n281\t        printf!(\"Error: state pointer is NULL in apply_operation\\n\");\n282\t        return;\n283\t    }\n284\t\n285\t    let func = match func {\n286\t        None => {\n287\t            printf!(\"Error: operation function pointer is NULL in apply_operation\\n\");\n288\t            return;\n289\t        }\n290\t        Some(f) => f,\n291\t    };\n292\t\n293\t    unsafe {\n294\t        (*state).accumulator = func((*state).accumulator, value);\n295\t        (*state).operation_count = (*state).operation_count.wrapping_add(1);\n296\t    }\n297\t}\n298\t\n299\t// ---------------------------------------------------------------------------\n300\t// int checkshift(int param1, int param2, int param3, int param4)\n301\t// ---------------------------------------------------------------------------\n302\t#[unsafe(no_mangle)]\n303\tpub unsafe extern \"C\" fn checkshift(\n304\t    param1: c_int,\n305\t    param2: c_int,\n306\t    param3: c_int,\n307\t    param4: c_int,\n308\t) -> c_int {\n309\t    printf!(\"\\n=== Starting foo function ===\\n\");\n310\t    printf!(\n311\t        \"Parameters: %d, %d, %d, %d\\n\",\n312\t        param1,\n313\t        param2,\n314\t        param3,\n315\t        param4\n316\t    );\n317\t\n318\t    let state = unsafe { malloc(core::mem::size_of::<ComputeState>()) } as *mut ComputeState;\n319\t\n320\t    if state.is_null() {\n321\t        printf!(\"Error: Failed to allocate memory for state\\n\");\n322\t        return -1;\n323\t    }\n324\t\n325\t    unsafe { init_state(state, param1) };\n326\t\n327\t    let mut params: [c_int; 4] = [param1, param2, param3, param4];\n328\t\n329\t    let mult_op = unsafe { get_operation(0) };\n330\t    let add_op = unsafe { get_operation(1) };\n331\t    let xor_op = unsafe { get_operation(2) };\n332\t    let shift_op = unsafe { get_operation(3) };\n333\t\n334\t    printf!(\"\\n--- Operation 1: Multiply ---\\n\");\n335\t    unsafe { apply_operation(state, param2, mult_op) };\n336\t\n337\t    printf!(\"\\n--- Operation 2: Add ---\\n\");\n338\t    unsafe { apply_operation(state, param3, add_op) };\n339\t\n340\t    printf!(\"\\n--- Operation 3: XOR ---\\n\");\n341\t    let xor_result = unsafe {\n342\t        execute_operation(xor_op, (*state).accumulator, param4, cstr!(\"XOR\"))\n343\t    };\n344\t\n345\t    printf!(\"\\n--- Operation 4: Shift ---\\n\");\n346\t    let shift_result = unsafe { execute_operation(shift_op, xor_result, param2, cstr!(\"SHIFT\")) };\n347\t\n348\t    unsafe {\n349\t        (*state).checksum = compute_checksum(params.as_mut_ptr(), 4);\n350\t        printf!(\"\\nComputed checksum: 0x%04X\\n\", (*state).checksum);\n351\t    }\n352\t\n353\t    // int final_result = (state->accumulator + shift_result) ^ state->checksum;\n354\t    //\n355\t    // `int ^ unsigned int` promotes both operands to `unsigned int`; the result\n356\t    // is then converted back to `int` (a plain bit-pattern reinterpretation on\n357\t    // every mainstream target).\n358\t    let final_result = unsafe {\n359\t        (((*state).accumulator.wrapping_add(shift_result) as c_uint) ^ (*state).checksum) as c_int\n360\t    };\n361\t\n362\t    unsafe {\n363\t        printf!(\"\\nFinal accumulator: %d\\n\", (*state).accumulator);\n364\t        printf!(\"Operation count: %d\\n\", (*state).operation_count);\n365\t    }\n366\t    printf!(\"Final result: %d\\n\", final_result);\n367\t\n368\t    unsafe { free(state as *mut c_void) };\n369\t    // state = NULL;  (dead store in the C source)\n370\t\n371\t    printf!(\"=== Ending foo function ===\\n\\n\");\n372\t\n373\t    final_result\n374\t}\n375\t"}]},"parent_tool_use_id":null,"session_id":"9b175d5f-493c-4765-a910-c44c15a2b978","uuid":"729fbc80-9f16-464a-ad01-80f649661f61","timestamp":"2026-09-05T13:33:46.030Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-aZUQvV/translation/src/lib.rs","content":"// Rust translation of c_src/src/lib.c\n//\n// Copyright 2025 MIT Lincoln Laboratory\n// Permission is hereby granted, free of charge,\n// to any person obtaining a copy of this software\n// and associated documentation files (the \"Software\"),\n// to deal in the Software without restriction,\n// including without limitation the rights to use, copy,\n// modify, merge, publish, distribute, sublicense,\n// and/or sell copies of the Software,\n// and to permit persons to whom the Software is furnished to do so,\n// subject to the following conditions:\n//\n// The above copyright notice and this permission notice\n// shall be included in all copies or substantial portions of the Software.\n//\n// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n// THE WARRANTIES OF MERCHANTABILITY,\n// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n\n#![allow(non_snake_case)]\n// The `printf!` helper macro already wraps the variadic call in `unsafe`, which\n// makes some of the surrounding explicit `unsafe` blocks redundant.\n#![allow(unused_unsafe)]\n\nuse core::ffi::{c_char, c_int, c_uint, c_void};\n\n// ---------------------------------------------------------------------------\n// libc bindings.\n//\n// The C library performs all of its output with `printf` on the C runtime's\n// `stdout`.  We call straight into libc so that formatting *and* buffering\n// behaviour (and therefore the exact byte stream produced) are identical.\n// ---------------------------------------------------------------------------\nunsafe extern \"C\" {\n    #[link_name = \"printf\"]\n    unsafe fn c_printf(fmt: *const c_char, ...) -> c_int;\n    unsafe fn malloc(size: usize) -> *mut c_void;\n    unsafe fn free(ptr: *mut c_void);\n    unsafe fn memcpy(dst: *mut c_void, src: *const c_void, n: usize) -> *mut c_void;\n}\n\n/// Build a NUL-terminated C string literal usable as a `printf` format.\nmacro_rules! cstr {\n    ($s:expr) => {\n        concat!($s, \"\\0\").as_ptr() as *const c_char\n    };\n}\n\n/// `printf(fmt, args...)`\nmacro_rules! printf {\n    ($fmt:expr) => {\n        unsafe { c_printf(cstr!($fmt)) }\n    };\n    ($fmt:expr, $($arg:expr),* $(,)?) => {\n        unsafe { c_printf(cstr!($fmt), $($arg),*) }\n    };\n}\n\n// #define STRINGIFY(x) #x\n// #define LOG_VALUE(var) printf(\"Variable \" STRINGIFY(var) \" = %d\\n\", var)\nmacro_rules! log_value {\n    ($name:expr, $var:expr) => {\n        printf!(concat!(\"Variable \", $name, \" = %d\\n\"), $var as c_int)\n    };\n}\n\n// #define OP_ADD 0x01\n#[allow(dead_code)]\nconst OP_ADD: c_int = 0x01;\n// #define OP_MULTIPLY 0x02\n#[allow(dead_code)]\nconst OP_MULTIPLY: c_int = 0x02;\n// #define OP_XOR 0x03\n#[allow(dead_code)]\nconst OP_XOR: c_int = 0x03;\n// #define OP_SHIFT 0x04\n#[allow(dead_code)]\nconst OP_SHIFT: c_int = 0x04;\n// #define MAGIC_NUMBER 0xDEADBEEF\nconst MAGIC_NUMBER: c_uint = 0xDEAD_BEEF;\n// #define MASK_LOWER 0x0000FFFF\nconst MASK_LOWER: c_uint = 0x0000_FFFF;\n\n/// typedef struct { int accumulator; int operation_count; unsigned int checksum; } ComputeState;\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct ComputeState {\n    pub accumulator: c_int,\n    pub operation_count: c_int,\n    pub checksum: c_uint,\n}\n\n/// typedef int (*operation_func)(int, int);\npub type OperationFunc = Option<unsafe extern \"C\" fn(c_int, c_int) -> c_int>;\n\n// static int static_multiplier = 3;\nconst STATIC_MULTIPLIER: c_int = 3;\n// static int static_addend = 100;\nconst STATIC_ADDEND: c_int = 100;\n// static int static_shift_amount = 2;\nconst STATIC_SHIFT_AMOUNT: c_int = 2;\n\n// ---------------------------------------------------------------------------\n// int multiply_with_static(int a, int b)\n// ---------------------------------------------------------------------------\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn multiply_with_static(a: c_int, b: c_int) -> c_int {\n    // return (a * b) * static_multiplier;\n    a.wrapping_mul(b).wrapping_mul(STATIC_MULTIPLIER)\n}\n\n// ---------------------------------------------------------------------------\n// int add_with_static(int a, int b)\n// ---------------------------------------------------------------------------\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn add_with_static(a: c_int, b: c_int) -> c_int {\n    // return (a + b) + static_addend;\n    a.wrapping_add(b).wrapping_add(STATIC_ADDEND)\n}\n\n// ---------------------------------------------------------------------------\n// int xor_operation(int a, int b)\n// ---------------------------------------------------------------------------\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn xor_operation(a: c_int, b: c_int) -> c_int {\n    // return a ^ b ^ 0xABCD;\n    a ^ b ^ 0xABCD\n}\n\n// ---------------------------------------------------------------------------\n// int shift_with_static(int a, int b)\n// ---------------------------------------------------------------------------\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn shift_with_static(a: c_int, b: c_int) -> c_int {\n    // return (a << static_shift_amount) | (b >> static_shift_amount);\n    //\n    // The left shift of a (possibly negative) signed value is what gcc emits:\n    // a plain logical shift of the bit pattern.  The right shift of a signed\n    // value is an arithmetic shift.\n    let left = ((a as u32) << (STATIC_SHIFT_AMOUNT as u32)) as c_int;\n    let right = a_shr(b, STATIC_SHIFT_AMOUNT);\n    left | right\n}\n\n#[inline]\nfn a_shr(value: c_int, amount: c_int) -> c_int {\n    value >> (amount as u32)\n}\n\n// ---------------------------------------------------------------------------\n// operation_func get_operation(int opcode)\n// ---------------------------------------------------------------------------\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn get_operation(opcode: c_int) -> OperationFunc {\n    // static operation_func ops[4] = {NULL, NULL, NULL, NULL};\n    //\n    // The C code lazily fills the static table on first use; the observable\n    // behaviour is simply the fixed mapping below.\n    let ops: [OperationFunc; 4] = [\n        Some(multiply_with_static),\n        Some(add_with_static),\n        Some(xor_operation),\n        Some(shift_with_static),\n    ];\n\n    if opcode >= 0 && opcode < 4 {\n        return ops[opcode as usize];\n    }\n\n    None\n}\n\n// ---------------------------------------------------------------------------\n// int execute_operation(operation_func func, int a, int b, const char* op_name)\n// ---------------------------------------------------------------------------\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn execute_operation(\n    func: OperationFunc,\n    a: c_int,\n    b: c_int,\n    op_name: *const c_char,\n) -> c_int {\n    let func = match func {\n        None => {\n            printf!(\n                \"Error: Operation function pointer is NULL for %s\\n\",\n                op_name\n            );\n            return 0;\n        }\n        Some(f) => f,\n    };\n\n    log_value!(\"a\", a);\n    log_value!(\"b\", b);\n\n    let result = unsafe { func(a, b) };\n    printf!(\"Result of %s: %d\\n\", op_name, result);\n\n    result\n}\n\n// ---------------------------------------------------------------------------\n// unsigned int compute_checksum(int* values, int count)\n// ---------------------------------------------------------------------------\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn compute_checksum(values: *mut c_int, count: c_int) -> c_uint {\n    let mut checksum: c_uint = 0;\n    // unsigned char buffer[sizeof(int) * 4];\n    let mut buffer = [0u8; core::mem::size_of::<c_int>() * 4];\n\n    if !values.is_null() && count > 0 {\n        let copy_count = if count > 4 { 4 } else { count } as usize;\n        let nbytes = core::mem::size_of::<c_int>() * copy_count;\n\n        unsafe {\n            memcpy(\n                buffer.as_mut_ptr() as *mut c_void,\n                values as *const c_void,\n                nbytes,\n            );\n        }\n\n        for i in 0..nbytes {\n            checksum = (checksum << 1) ^ (buffer[i] as c_uint);\n        }\n\n        checksum ^= MAGIC_NUMBER;\n    }\n\n    checksum & MASK_LOWER\n}\n\n// ---------------------------------------------------------------------------\n// void init_state(ComputeState* state, int initial_value)\n// ---------------------------------------------------------------------------\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn init_state(state: *mut ComputeState, initial_value: c_int) {\n    if state.is_null() {\n        printf!(\"Error: state pointer is NULL in init_state\\n\");\n        return;\n    }\n\n    // ComputeState template = {initial_value, 0, 0x0000};\n    let template = ComputeState {\n        accumulator: initial_value,\n        operation_count: 0,\n        checksum: 0x0000,\n    };\n\n    unsafe {\n        memcpy(\n            state as *mut c_void,\n            &template as *const ComputeState as *const c_void,\n            core::mem::size_of::<ComputeState>(),\n        );\n\n        printf!(\n            \"State initialized with accumulator = %d\\n\",\n            (*state).accumulator\n        );\n    }\n}\n\n// ---------------------------------------------------------------------------\n// void apply_operation(ComputeState* state, int value, operation_func func)\n// ---------------------------------------------------------------------------\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn apply_operation(\n    state: *mut ComputeState,\n    value: c_int,\n    func: OperationFunc,\n) {\n    if state.is_null() {\n        printf!(\"Error: state pointer is NULL in apply_operation\\n\");\n        return;\n    }\n\n    let func = match func {\n        None => {\n            printf!(\"Error: operation function pointer is NULL in apply_operation\\n\");\n            return;\n        }\n        Some(f) => f,\n    };\n\n    unsafe {\n        (*state).accumulator = func((*state).accumulator, value);\n        (*state).operation_count = (*state).operation_count.wrapping_add(1);\n    }\n}\n\n// ---------------------------------------------------------------------------\n// int checkshift(int param1, int param2, int param3, int param4)\n// ---------------------------------------------------------------------------\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn checkshift(\n    param1: c_int,\n    param2: c_int,\n    param3: c_int,\n    param4: c_int,\n) -> c_int {\n    printf!(\"\\n=== Starting foo function ===\\n\");\n    printf!(\n        \"Parameters: %d, %d, %d, %d\\n\",\n        param1,\n        param2,\n        param3,\n        param4\n    );\n\n    let state = unsafe { malloc(core::mem::size_of::<ComputeState>()) } as *mut ComputeState;\n\n    if state.is_null() {\n        printf!(\"Error: Failed to allocate memory for state\\n\");\n        return -1;\n    }\n\n    unsafe { init_state(state, param1) };\n\n    let mut params: [c_int; 4] = [param1, param2, param3, param4];\n\n    let mult_op = unsafe { get_operation(0) };\n    let add_op = unsafe { get_operation(1) };\n    let xor_op = unsafe { get_operation(2) };\n    let shift_op = unsafe { get_operation(3) };\n\n    printf!(\"\\n--- Operation 1: Multiply ---\\n\");\n    unsafe { apply_operation(state, param2, mult_op) };\n\n    printf!(\"\\n--- Operation 2: Add ---\\n\");\n    unsafe { apply_operation(state, param3, add_op) };\n\n    printf!(\"\\n--- Operation 3: XOR ---\\n\");\n    let xor_result = unsafe {\n        execute_operation(xor_op, (*state).accumulator, param4, cstr!(\"XOR\"))\n    };\n\n    printf!(\"\\n--- Operation 4: Shift ---\\n\");\n    let shift_result = unsafe { execute_operation(shift_op, xor_result, param2, cstr!(\"SHIFT\")) };\n\n    unsafe {\n        (*state).checksum = compute_checksum(params.as_mut_ptr(), 4);\n        printf!(\"\\nComputed checksum: 0x%04X\\n\", (*state).checksum);\n    }\n\n    // int final_result = (state->accumulator + shift_result) ^ state->checksum;\n    //\n    // `int ^ unsigned int` promotes both operands to `unsigned int`; the result\n    // is then converted back to `int` (a plain bit-pattern reinterpretation on\n    // every mainstream target).\n    let final_result = unsafe {\n        (((*state).accumulator.wrapping_add(shift_result) as c_uint) ^ (*state).checksum) as c_int\n    };\n\n    unsafe {\n        printf!(\"\\nFinal accumulator: %d\\n\", (*state).accumulator);\n        pr