ir: &Path| names.iter().map(|n| dir.join(n)).find(|p| p.exists());\n\n    if let Some(p) = probe(&dir) {\n        return p;\n    }\n\n    // Not there yet — build it into the same target dir, honouring this test\n    // binary's profile and the crate's feature selection.\n    let manifest = Path::new(env!(\"CARGO_MANIFEST_DIR\"));\n    let target_dir = dir.parent().unwrap_or(&dir).to_path_buf();\n    let profile_release = dir.file_name().map(|n| n == \"release\").unwrap_or(false);\n    let cargo = std::env::var(\"CARGO\").unwrap_or_else(|_| \"cargo\".to_string());\n\n    let mut cmd = std::process::Command::new(&cargo);\n    cmd.current_dir(manifest)\n        .arg(\"build\")\n        .arg(\"--offline\")\n        .arg(\"--target-dir\")\n        .arg(&target_dir)\n        // Reproduce the feature selection this test binary was compiled with.\n        .args(feature_args());\n    if profile_release {\n        cmd.arg(\"--release\");\n    }\n    let out = cmd.output();\n\n    probe(&dir).unwrap_or_else(|| {\n        panic!(\n            \"Rust cdylib not found in {} and `cargo build` did not produce it.\\n\\\n             Build it manually:  cd translation && cargo build\\n{:?}\",\n            dir.display(),\n            out.map(|o| String::from_utf8_lossy(&o.stderr).into_owned())\n        )\n    })\n}\n\n/// The crate declares no `[features]`, so the feature space is the single\n/// default (empty) combination. This helper exists so that adding features later\n/// automatically propagates into the bootstrap build instead of silently\n/// testing the wrong `.so`.\nfn feature_args() -> Vec<String> {\n    let mut enabled: Vec<String> = std::env::vars()\n        .filter_map(|(k, _)| k.strip_prefix(\"CARGO_FEATURE_\").map(|f| f.to_lowercase()))\n        .collect();\n    enabled.sort();\n    if enabled.is_empty() {\n        vec![\"--no-default-features\".to_string()]\n    } else {\n        vec![\n            \"--no-default-features\".to_string(),\n            \"--features\".to_string(),\n            enabled.join(\",\"),\n        ]\n    }\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1931,"cache_read_input_tokens":88216,"cache_creation":{"ephemeral_5m_input_tokens":1931,"ephemeral_1h_input_tokens":0},"output_tokens":17,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"4c3dce5c-23e4-468e-a43a-b7c663b97536","uuid":"7db5731c-e01f-4249-a01d-0af474e02740","timestamp":"2026-08-27T22:02:55.125Z"}
