{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Gu6goZFjmjvMjA61bX6qf5","type":"tool_result","content":"1\t/* Copyright (C) 2015, Wazuh Inc.\n2\t * Copyright (C) 2009 Trend Micro Inc.\n3\t * All right reserved.\n4\t *\n5\t * This program is free software; you can redistribute it\n6\t * and/or modify it under the terms of the GNU General Public\n7\t * License (version 2) as published by the FSF - Free Software\n8\t * Foundation\n9\t */\n10\t\n11\t/* File monitoring functions */\n12\t\n13\t#include \"read-alert.h\"\n14\t#include \"shared.h\"\n15\t\n16\t#include <stdlib.h>\n17\t#include <stdio.h>\n18\t#include <string.h>\n19\t\n20\t/* ** Alert xyz: email active-response ** */\n21\t\n22\t#define ALERT_BEGIN     \"** Alert\"\n23\t#define ALERT_BEGIN_SZ  8\n24\t#define RULE_BEGIN      \"Rule: \"\n25\t#define RULE_BEGIN_SZ   6\n26\t#define SRCIP_BEGIN     \"Src IP: \"\n27\t#define SRCIP_BEGIN_SZ  8\n28\t#define SRCPORT_BEGIN     \"Src Port: \"\n29\t#define SRCPORT_BEGIN_SZ  10\n30\t#define DSTIP_BEGIN     \"Dst IP: \"\n31\t#define DSTIP_BEGIN_SZ  8\n32\t#define DSTPORT_BEGIN     \"Dst Port: \"\n33\t#define DSTPORT_BEGIN_SZ  10\n34\t#define USER_BEGIN      \"User: \"\n35\t#define USER_BEGIN_SZ   6\n36\t#define ALERT_MAIL      \"mail\"\n37\t#define ALERT_MAIL_SZ   4\n38\t#define OLDMD5_BEGIN      \"Old md5sum was: \"\n39\t#define OLDMD5_BEGIN_SZ   16\n40\t#define NEWMD5_BEGIN      \"New md5sum is : \"\n41\t#define NEWMD5_BEGIN_SZ   16\n42\t#define OLDSHA1_BEGIN     \"Old sha1sum was: \"\n43\t#define OLDSHA1_BEGIN_SZ  17\n44\t#define NEWSHA1_BEGIN     \"New sha1sum is : \"\n45\t#define NEWSHA1_BEGIN_SZ  17\n46\t#define OLDSHA256_BEGIN     \"Old sha256sum was: \"\n47\t#define OLDSHA256_BEGIN_SZ  19\n48\t#define NEWSHA256_BEGIN     \"New sha256sum is : \"\n49\t#define NEWSHA256_BEGIN_SZ  19\n50\t/* \"9/19/2016 - Sivakumar Nellurandi - parsing additions\" */\n51\t#define SIZE_BEGIN        \"Size changed from \"\n52\t#define SIZE_BEGIN_SZ     18\n53\t#define OWNER_BEGIN        \"Ownership was \"\n54\t#define OWNER_BEGIN_SZ     14\n55\t#define GROUP_BEGIN        \"Group ownership was \"\n56\t#define GROUP_BEGIN_SZ     20\n57\t#define PERM_BEGIN        \"Permissions changed from \"\n58\t#define PERM_BEGIN_SZ     25\n59\t\n60\t#define LOG_LIMIT      100\n61\t/* \"9/19/2016 - Sivakumar Nellurandi - parsing additions\" */\n62\t\n63\t\n64\tvoid FreeAlertData(alert_data *al_data) {\n65\t    char **p;\n66\t    os_free(al_data->alertid);\n67\t    os_free(al_data->date);\n68\t    os_free(al_data->location);\n69\t    os_free(al_data->comment);\n70\t    os_free(al_data->group);\n71\t    os_free(al_data->srcip);\n72\t    os_free(al_data->dstip);\n73\t    os_free(al_data->user);\n74\t    os_free(al_data->filename);\n75\t\n76\t/* \"9/19/2016 - Sivakumar Nellurandi - parsing additions\" */\n77\t    // if (al_data->log) {\n78\t    //     p = al_data->log;\n79\t    //\n80\t    //     while (*(p)) {\n81\t    //         os_free(*(p));\n82\t    //         p++;\n83\t    //     }\n84\t    //     os_free(al_data->log);\n85\t    // }\n86\t\n87\t    // al_data can't be NULL\n88\t    free(al_data);\n89\t    al_data = NULL;\n90\t}\n91\t\n92\t/* Return alert data for the file specified */\n93\talert_data *GetAlertData(int flag, FILE *fp) {\n94\t\n95\t    alert_data *al_data;\n96\t    al_data = os_calloc(1, sizeof(alert_data));\n97\t\n98\t    int _r = 0, issyscheck = 0;\n99\t    size_t log_size = 0;\n100\t    char *p;\n101\t    char str[OS_MAXSTR + 1];\n102\t    str[OS_MAXSTR] = '\\0';\n103\t\n104\t    while (fgets(str, OS_MAXSTR, fp) != NULL) {\n105\t        /* End of alert */\n106\t        if (strncmp(ALERT_BEGIN, str, ALERT_BEGIN_SZ) == 0) {\n107\t            char *m;\n108\t            size_t z = 0;\n109\t            /* End of the alert. */\n110\t            if (_r == 2) {\n111\t                if (fseek(fp, -strlen(str), SEEK_CUR) != -1) {\n112\t                    return (al_data);\n113\t                } else {\n114\t                    goto l_error;\n115\t                }\n116\t            }\n117\t\n118\t            p = str + ALERT_BEGIN_SZ + 1;\n119\t\n120\t            m = strstr(p, \":\");\n121\t            if (!m) {\n122\t                continue;\n123\t            }\n124\t\n125\t            z = strlen(p) - strlen(m);\n126\t            al_data->alertid = os_realloc(al_data->alertid, (z + 1) * sizeof(char));\n127\t            strncpy(al_data->alertid, p, z);\n128\t            al_data->alertid[z] = '\\0';\n129\t\n130\t            /* Search for email flag */\n131\t            p = strchr(p, ' ');\n132\t            if (!p) {\n133\t                continue;\n134\t            }\n135\t\n136\t            p++;\n137\t\n138\t            /* Check for the flags */\n139\t            if ((flag & CRALERT_MAIL_SET) &&\n140\t                    (strncmp(ALERT_MAIL, p, ALERT_MAIL_SZ) != 0)) {\n141\t                continue;\n142\t            }\n143\t\n144\t            p = strchr(p, '-');\n145\t            if (p) {\n146\t                p++;\n147\t                /* Skip leading spaces */\n148\t                while (*p == ' ') {\n149\t                        p++;\n150\t                }\n151\t                os_free(al_data->group);\n152\t                al_data->group = os_strdup(p);\n153\t\n154\t                /* Clean newline from group */\n155\t                os_clearnl(al_data->group, p);\n156\t                if (al_data->group != NULL && strstr(al_data->group, \"syscheck\") != NULL) {\n157\t                    issyscheck = 1;\n158\t                }\n159\t            }\n160\t\n161\t            /* Search for active-response flag */\n162\t            _r = 1;\n163\t            continue;\n164\t        }\n165\t\n166\t        if (_r < 1) {\n167\t            continue;\n168\t        }\n169\t\n170\t        /*** Extract information from the event ***/\n171\t\n172\t        /* r1 means: 2006 Apr 13 16:15:17 /var/log/auth.log */\n173\t        if (_r == 1) {\n174\t            /* Clear newline */\n175\t            os_clearnl(str, p);\n176\t\n177\t            p = strchr(str, ':');\n178\t            if (p) {\n179\t                p = strchr(p, ' ');\n180\t                if (p) {\n181\t                    *p = '\\0';\n182\t                    p++;\n183\t                } else {\n184\t                    /* If p is null it is because strchr failed */\n185\t                    perror(\"date of location not NULL\");\n186\t                    goto l_error;\n187\t                }\n188\t            }\n189\t\n190\t            /* If not, str is date and p is the location */\n191\t            if (al_data->date || al_data->location || !p) {\n192\t                perror(\"date or location not NULL or p is NULL\");\n193\t                goto l_error;\n194\t            }\n195\t\n196\t            al_data->date = os_strdup(str);\n197\t            al_data->location = os_strdup(p);\n198\t            _r = 2;\n199\t            log_size = 0;\n200\t            continue;\n201\t        } else if (_r == 2) {\n202\t            /* Rule begin */\n203\t            if (strncmp(RULE_BEGIN, str, RULE_BEGIN_SZ) == 0) {\n204\t                os_clearnl(str, p);\n205\t\n206\t                p = str + RULE_BEGIN_SZ;\n207\t                al_data->rule = atoi(p);\n208\t\n209\t                p = strchr(p, ' ');\n210\t                if (p) {\n211\t                    p++;\n212\t                    p = strchr(p, ' ');\n213\t                    if (p) {\n214\t                        p++;\n215\t                    }\n216\t                }\n217\t\n218\t                if (!p) {\n219\t                    goto l_error;\n220\t                }\n221\t\n222\t                al_data->level = atoi(p);\n223\t\n224\t                /* Get the comment */\n225\t                p = strchr(p, '\\'');\n226\t                if (!p) {\n227\t                    goto l_error;\n228\t                }\n229\t\n230\t                p++;\n231\t                os_free(al_data->comment);\n232\t                al_data->comment = os_strdup(p);\n233\t\n234\t                /* Must have the closing \\' */\n235\t                p = strrchr(al_data->comment, '\\'');\n236\t                if (p) {\n237\t                    *p = '\\0';\n238\t                } else {\n239\t                    goto l_error;\n240\t                }\n241\t            }\n242\t\n243\t            /* srcip */\n244\t            else if (strncmp(SRCIP_BEGIN, str, SRCIP_BEGIN_SZ) == 0) {\n245\t                os_clearnl(str, p);\n246\t\n247\t                p = str + SRCIP_BEGIN_SZ;\n248\t                os_free(al_data->srcip);\n249\t                al_data->srcip = os_strdup(p);\n250\t            }\n251\t            /* srcport */\n252\t            else if (strncmp(SRCPORT_BEGIN, str, SRCPORT_BEGIN_SZ) == 0) {\n253\t                os_clearnl(str, p);\n254\t\n255\t                p = str + SRCPORT_BEGIN_SZ;\n256\t                al_data->srcport = atoi(p);\n257\t            }\n258\t            /* dstip */\n259\t            else if (strncmp(DSTIP_BEGIN, str, DSTIP_BEGIN_SZ) == 0) {\n260\t                os_clearnl(str, p);\n261\t\n262\t                p = str + DSTIP_BEGIN_SZ;\n263\t                os_free(al_data->dstip);\n264\t                al_data->dstip = os_strdup(p);\n265\t            }\n266\t            /* dstport */\n267\t            else if (strncmp(DSTPORT_BEGIN, str, DSTPORT_BEGIN_SZ) == 0) {\n268\t                os_clearnl(str, p);\n269\t\n270\t                p = str + DSTPORT_BEGIN_SZ;\n271\t                al_data->dstport = atoi(p);\n272\t            }\n273\t            /* username */\n274\t            else if (strncmp(USER_BEGIN, str, USER_BEGIN_SZ) == 0) {\n275\t                os_clearnl(str, p);\n276\t\n277\t                p = str + USER_BEGIN_SZ;\n278\t                os_free(al_data->user);\n279\t                al_data->user = os_strdup(p);\n280\t            }\n281\t\n282\t         /* \"9/19/2016 - Sivakumar Nellurandi - parsing additions\" */\n283\t            /* It is a log message */\n284\t            else if (log_size < LOG_LIMIT) {\n285\t                os_clearnl(str, p);\n286\t                if (issyscheck == 1) {\n287\t                    if (strncmp(str, \"Integrity checksum changed for: '\", 33) == 0) {\n288\t                        al_data->filename = strdup(str + 33);\n289\t                        if (al_data->filename) {\n290\t                            al_data->filename[strlen(al_data->filename) - 1] = '\\0';\n291\t                        }\n292\t                    }\n293\t                    issyscheck = 0;\n294\t                }\n295\t\n296\t                // al_data->log = os_realloc(al_data->log, (log_size + 2) * sizeof(char *));\n297\t                // al_data->log[log_size] = os_strdup(str);\n298\t                // log_size++;\n299\t                // al_data->log[log_size] = NULL;\n300\t            }\n301\t        }\n302\t    }\n303\t\n304\t    // We reached the end of the alert and the information is saved.\n305\t    if (feof(fp) && _r == 2) {\n306\t        return al_data;\n307\t    }\n308\t\n309\tl_error:\n310\t    /* Free the memory */\n311\t    FreeAlertData(al_data);\n312\t    /* We need to clean end of file before returning */\n313\t    clearerr(fp);\n314\t    return (NULL);\n315\t}\n316\t"}]},"parent_tool_use_id":"toolu_bdrk_013PA2SEbqrq9nuBsCyF7J8D","session_id":"28b5e5a5-2f5e-4b09-bc69-ff69bc592e87","uuid":"0e7d37c5-dd4e-49b1-b7c6-5a20e0be91fb","timestamp":"2026-09-05T07:41:45.892Z","subagent_type":"general-purpose","task_description":"Audit C vs Rust line by line"}
