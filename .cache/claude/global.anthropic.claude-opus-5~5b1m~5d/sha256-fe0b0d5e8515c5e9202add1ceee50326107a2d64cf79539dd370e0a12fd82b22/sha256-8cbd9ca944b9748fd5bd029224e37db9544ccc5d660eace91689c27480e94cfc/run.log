{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_0187WrtsrhxFsF6X46CRBdtw","type":"tool_result","content":"1\t//! Translation of `c_src/src/file-queue.c` (+ `c_src/include/file-queue.h`).\n2\t\n3\tuse core::ffi::{c_char, c_int, c_long, c_uint};\n4\tuse core::ptr;\n5\t\n6\tuse crate::cbind::*;\n7\tuse crate::read_alert::{alert_data, GetAlertData, ALERTS_DAILY, CRALERT_FP_SET, CRALERT_READ_ALL};\n8\t\n9\t/* ---------------------------------------------------------------- */\n10\t/* file-queue.h                                                     */\n11\t/* ---------------------------------------------------------------- */\n12\t\n13\t/// `#define MAX_FQUEUE 256`\n14\tpub const MAX_FQUEUE: usize = 256;\n15\t/// `#define FQ_TIMEOUT 5`\n16\tpub const FQ_TIMEOUT: c_long = 5;\n17\t\n18\t/// ```c\n19\t/// typedef struct file_queue {\n20\t///     time_t last_change;\n21\t///     int year;\n22\t///     int day;\n23\t///     int flags;\n24\t///     char mon[4];\n25\t///     char file_name[MAX_FQUEUE + 1];\n26\t///     FILE *fp;\n27\t///     struct stat f_status;\n28\t/// } file_queue;\n29\t/// ```\n30\t#[repr(C)]\n31\tpub struct file_queue {\n32\t    pub last_change: c_long,\n33\t    pub year: c_int,\n34\t    pub day: c_int,\n35\t    pub flags: c_int,\n36\t    pub mon: [c_char; 4],\n37\t    pub file_name: [c_char; MAX_FQUEUE + 1],\n38\t    pub fp: *mut FILE,\n39\t    pub f_status: stat,\n40\t}\n41\t\n42\t/* ---------------------------------------------------------------- */\n43\t/* file-queue.c                                                     */\n44\t/* ---------------------------------------------------------------- */\n45\t\n46\tconst FSTAT_ERROR: &[u8] =\n47\t    b\"(1118): Could not retrieve information of file '%s' due to [(%d)-(%s)].\\0\";\n48\tconst FSEEK_ERROR: &[u8] = b\"(1116): Could not set position in file '%s' due to [(%d)-(%s)].\\0\";\n49\t\n50\t/// ```c\n51\t/// void merror(const char *err_template, const char *file_name, int err, const char *err_msg)\n52\t/// ```\n53\t#[unsafe(no_mangle)]\n54\tpub unsafe extern \"C\" fn merror(\n55\t    err_template: *const c_char,\n56\t    file_name: *const c_char,\n57\t    err: c_int,\n58\t    err_msg: *const c_char,\n59\t) {\n60\t    let mut buffer = [0 as c_char; 256];\n61\t    snprintf(\n62\t        buffer.as_mut_ptr(),\n63\t        core::mem::size_of_val(&buffer),\n64\t        err_template,\n65\t        file_name,\n66\t        err,\n67\t        err_msg,\n68\t    );\n69\t    fprintf(stderr, cs(b\"%s\\n\\0\"), buffer.as_ptr());\n70\t}\n71\t\n72\t/// `static const char *(s_month[]) = {\"Jan\", ... \"Dec\"};`\n73\t///\n74\t/// Held as a raw `[*const c_char; 12]` so that indexing can be reproduced\n75\t/// exactly as the C does it -- see `copy_month`.\n76\t#[repr(transparent)]\n77\tstruct MonthTable([*const c_char; 12]);\n78\t\n79\t// The table is immutable, read-only data; the raw pointers only exist because\n80\t// the C declares `const char *[]`.\n81\tunsafe impl Sync for MonthTable {}\n82\t\n83\tstatic S_MONTH: MonthTable = MonthTable([\n84\t    b\"Jan\\0\".as_ptr() as *const c_char,\n85\t    b\"Feb\\0\".as_ptr() as *const c_char,\n86\t    b\"Mar\\0\".as_ptr() as *const c_char,\n87\t    b\"Apr\\0\".as_ptr() as *const c_char,\n88\t    b\"May\\0\".as_ptr() as *const c_char,\n89\t    b\"Jun\\0\".as_ptr() as *const c_char,\n90\t    b\"Jul\\0\".as_ptr() as *const c_char,\n91\t    b\"Aug\\0\".as_ptr() as *const c_char,\n92\t    b\"Sep\\0\".as_ptr() as *const c_char,\n93\t    b\"Oct\\0\".as_ptr() as *const c_char,\n94\t    b\"Nov\\0\".as_ptr() as *const c_char,\n95\t    b\"Dec\\0\".as_ptr() as *const c_char,\n96\t]);\n97\t\n98\t/// `strncpy(fileq->mon, s_month[p->tm_mon], 3);`\n99\t///\n100\t/// The C indexes `s_month` without validating `tm_mon`, so an out-of-range\n101\t/// month reads past the end of the 12-entry table and then `strncpy`s from\n102\t/// whatever pointer that yields. That is undefined behaviour in C, but it is\n103\t/// NOT a rejection the C performs, and adding a bounds check here would make\n104\t/// the Rust behave *differently* from the ground truth for in-range-looking\n105\t/// callers of `Init_FileQueue`/`Read_FileMon`. The unchecked read is therefore\n106\t/// reproduced verbatim rather than \"fixed\".\n107\t#[inline]\n108\tunsafe fn copy_month(fileq: *mut file_queue, tm_mon: c_int) {\n109\t    let entry = *S_MONTH.0.as_ptr().offset(tm_mon as isize);\n110\t    strncpy((*fileq).mon.as_mut_ptr(), entry, 3);\n111\t}\n112\t\n113\t/// ```c\n114\t/// static void file_sleep(void)\n115\t/// ```\n116\tunsafe fn file_sleep() {\n117\t    let mut fp_timeout = timeval {\n118\t        tv_sec: FQ_TIMEOUT,\n119\t        tv_usec: 0,\n120\t    };\n121\t\n122\t    /* Wait for the select timeout */\n123\t    select(\n124\t        0,\n125\t        ptr::null_mut(),\n126\t        ptr::null_mut(),\n127\t        ptr::null_mut(),\n128\t        &mut fp_timeout,\n129\t    );\n130\t}\n131\t\n132\t/// ```c\n133\t/// static void GetFile_Queue(file_queue *fileq)\n134\t/// ```\n135\t#[allow(non_snake_case)]\n136\tunsafe fn GetFile_Queue(fileq: *mut file_queue) {\n137\t    /* Create the logfile name */\n138\t    (*fileq).file_name[0] = 0;\n139\t    (*fileq).file_name[MAX_FQUEUE] = 0;\n140\t\n141\t    let src = if (*fileq).flags & CRALERT_FP_SET != 0 {\n142\t        cs(b\"<stdin>\\0\")\n143\t    } else {\n144\t        cs(ALERTS_DAILY)\n145\t    };\n146\t\n147\t    snprintf(\n148\t        (*fileq).file_name.as_mut_ptr(),\n149\t        MAX_FQUEUE,\n150\t        cs(b\"%s\\0\"),\n151\t        src,\n152\t    );\n153\t}\n154\t\n155\t/// ```c\n156\t/// static int Handle_Queue(file_queue *fileq, int flags)\n157\t/// ```\n158\t#[allow(non_snake_case)]\n159\tunsafe fn Handle_Queue(fileq: *mut file_queue, flags: c_int) -> c_int {\n160\t    /* Close if it is open */\n161\t    if flags & CRALERT_FP_SET == 0 {\n162\t        if !(*fileq).fp.is_null() {\n163\t            fclose((*fileq).fp);\n164\t            (*fileq).fp = ptr::null_mut();\n165\t        }\n166\t\n167\t        /* We must be able to open the file, fseek and get the\n168\t         * time of change from it.\n169\t         */\n170\t        (*fileq).fp = fopen((*fileq).file_name.as_ptr(), cs(b\"r\\0\"));\n171\t        if (*fileq).fp.is_null() {\n172\t            /* Queue not available */\n173\t            return 0;\n174\t        }\n175\t    }\n176\t\n177\t    /* Seek to the end of the file */\n178\t    if flags & CRALERT_READ_ALL == 0 {\n179\t        if (*fileq).fp.is_null() {\n180\t            return 0;\n181\t        }\n182\t\n183\t        if fseek((*fileq).fp, 0, SEEK_END) < 0 {\n184\t            merror(\n185\t                cs(FSEEK_ERROR),\n186\t                (*fileq).file_name.as_ptr(),\n187\t                errno(),\n188\t                strerror(errno()),\n189\t            );\n190\t            fclose((*fileq).fp);\n191\t            (*fileq).fp = ptr::null_mut();\n192\t            return -1;\n193\t        }\n194\t    }\n195\t\n196\t    /* File change time */\n197\t    if !(*fileq).fp.is_null() {\n198\t        if fstat(fileno((*fileq).fp), &mut (*fileq).f_status) < 0 {\n199\t            merror(\n200\t                cs(FSTAT_ERROR),\n201\t                (*fileq).file_name.as_ptr(),\n202\t                errno(),\n203\t                strerror(errno()),\n204\t            );\n205\t            fclose((*fileq).fp);\n206\t            (*fileq).fp = ptr::null_mut();\n207\t            return -1;\n208\t        }\n209\t    }\n210\t\n211\t    (*fileq).last_change = (*fileq).f_status.st_mtim.tv_sec;\n212\t\n213\t    1\n214\t}\n215\t\n216\t/// ```c\n217\t/// int Init_FileQueue(file_queue *fileq, const struct tm *p, int flags)\n218\t/// ```\n219\t#[allow(non_snake_case)]\n220\t#[unsafe(no_mangle)]\n221\tpub unsafe extern \"C\" fn Init_FileQueue(\n222\t    fileq: *mut file_queue,\n223\t    p: *const tm,\n224\t    flags: c_int,\n225\t) -> c_int {\n226\t    /* Initialize file_queue fields */\n227\t    if flags & CRALERT_FP_SET == 0 {\n228\t        (*fileq).fp = ptr::null_mut();\n229\t    }\n230\t    (*fileq).last_change = 0;\n231\t    (*fileq).flags = 0;\n232\t\n233\t    (*fileq).day = (*p).tm_mday;\n234\t    (*fileq).year = (*p).tm_year + 1900;\n235\t\n236\t    copy_month(fileq, (*p).tm_mon);\n237\t    memset(\n238\t        (*fileq).file_name.as_mut_ptr() as *mut core::ffi::c_void,\n239\t        0,\n240\t        MAX_FQUEUE + 1,\n241\t    );\n242\t\n243\t    /* Set the supplied flags */\n244\t    (*fileq).flags = flags;\n245\t\n246\t    /* Get latest file */\n247\t    GetFile_Queue(fileq);\n248\t\n249\t    /* Always seek to the end when starting the queue */\n250\t    if Handle_Queue(fileq, (*fileq).flags) < 0 {\n251\t        return -1;\n252\t    }\n253\t\n254\t    0\n255\t}\n256\t\n257\t/// ```c\n258\t/// alert_data *Read_FileMon(file_queue *fileq, const struct tm *p, unsigned int timeout)\n259\t/// ```\n260\t#[allow(non_snake_case)]\n261\t#[unsafe(no_mangle)]\n262\tpub unsafe extern \"C\" fn Read_FileMon(\n263\t    fileq: *mut file_queue,\n264\t    p: *const tm,\n265\t    timeout: c_uint,\n266\t) -> *mut alert_data {\n267\t    let mut i: c_uint = 0;\n268\t    let mut al_data: *mut alert_data;\n269\t\n270\t    /* If the file queue is not available, try to access it */\n271\t    if (*fileq).fp.is_null() {\n272\t        if Handle_Queue(fileq, 0) != 1 {\n273\t            file_sleep();\n274\t            return ptr::null_mut();\n275\t        }\n276\t    }\n277\t\n278\t    if (*fileq).fp.is_null() {\n279\t        return ptr::null_mut();\n280\t    }\n281\t\n282\t    al_data = GetAlertData((*fileq).flags, (*fileq).fp);\n283\t    if !al_data.is_null() {\n284\t        return al_data;\n285\t    }\n286\t\n287\t    (*fileq).day = (*p).tm_mday;\n288\t    (*fileq).year = (*p).tm_year + 1900;\n289\t    copy_month(fileq, (*p).tm_mon);\n290\t\n291\t    /* Get latest file */\n292\t    GetFile_Queue(fileq);\n293\t\n294\t    if Handle_Queue(fileq, 0) != 1 {\n295\t        file_sleep();\n296\t        return ptr::null_mut();\n297\t    }\n298\t\n299\t    /* Try up to timeout times to get an event */\n300\t    while i < timeout {\n301\t        al_data = GetAlertData((*fileq).flags, (*fileq).fp);\n302\t        if !al_data.is_null() {\n303\t            return al_data;\n304\t        }\n305\t\n306\t        i += 1;\n307\t        file_sleep();\n308\t    }\n309\t\n310\t    /* Return NULL if timeout expires */\n311\t    ptr::null_mut()\n312\t}\n313\t"}]},"parent_tool_use_id":"toolu_bdrk_013PA2SEbqrq9nuBsCyF7J8D","session_id":"28b5e5a5-2f5e-4b09-bc69-ff69bc592e87","uuid":"fdea0f1d-107e-435d-a292-f649da6bfcc9","timestamp":"2026-09-05T07:42:13.112Z","subagent_type":"general-purpose","task_description":"Audit C vs Rust line by line"}
