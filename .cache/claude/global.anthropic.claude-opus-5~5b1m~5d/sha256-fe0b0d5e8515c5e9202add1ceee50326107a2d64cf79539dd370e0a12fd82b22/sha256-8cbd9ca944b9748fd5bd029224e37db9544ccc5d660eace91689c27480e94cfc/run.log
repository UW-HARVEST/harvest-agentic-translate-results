\tvoid merror(const char *err_template, const char *file_name, int err, const char *err_msg) {\n    25\t    char buffer[256];\n    26\t    snprintf(buffer, sizeof(buffer), err_template, file_name, err, err_msg);\n    27\t    fprintf(stderr, \"%s\\n\", buffer);\n    28\t}\n    29\t\n    30\tstatic void file_sleep(void);\n    31\tstatic void GetFile_Queue(file_queue *fileq) __attribute__((nonnull));\n    32\tstatic int Handle_Queue(file_queue *fileq, int flags) __attribute__((nonnull));\n    33\t\n    34\t/* To translate between month (int) to month (char) */\n    35\tstatic const char *(s_month[]) = {\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\",\n    36\t                                  \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"\n    37\t                                 };\n    38\t\n    39\t\n    40\tstatic void file_sleep() {\n    41\t\n    42\t    struct timeval fp_timeout;\n    43\t\n    44\t    fp_timeout.tv_sec = FQ_TIMEOUT;\n    45\t    fp_timeout.tv_usec = 0;\n    46\t\n    47\t    /* Wait for the select timeout */\n    48\t    select(0, NULL, NULL, NULL, &fp_timeout);\n    49\t\n    50\t    return;\n    51\t}\n    52\t\n    53\t/* Get the file queue for that specific hour */\n    54\tstatic void GetFile_Queue(file_queue *fileq)\n    55\t{\n    56\t    /* Create the logfile name */\n    57\t    fileq->file_name[0] = '\\0';\n    58\t    fileq->file_name[MAX_FQUEUE] = '\\0';\n    59\t\n    60\t    snprintf(fileq->file_name, MAX_FQUEUE, \"%s\", fileq->flags & CRALERT_FP_SET ? \"<stdin>\" : ALERTS_DAILY);\n    61\t}\n    62\t\n    63\t/* Re Handle the file queue */\n    64\tstatic int Handle_Queue(file_queue *fileq, int flags)\n    65\t{\n    66\t    /* Close if it is open */\n    67\t    if (!(flags & CRALERT_FP_SET)) {\n    68\t        if (fileq->fp) {\n    69\t            fclose(fileq->fp);\n    70\t            fileq->fp = NULL;\n    71\t        }\n    72\t\n    73\t        /* We must be able to open the file, fseek and get the\n    74\t    