{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01PoQUdjmzBVc2Qpw7AGYZq4","type":"tool_result","content":"===== lib.rs =====\n     1\t//! Rust translation of the `driver` C shared library.\n     2\t//!\n     3\t//! Sources translated (1:1, file for file):\n     4\t//!   * `c_src/include/shared.h`      -> `shared.rs`\n     5\t//!   * `c_src/include/read-alert.h`  -> `read_alert.rs`\n     6\t//!   * `c_src/include/file-queue.h`  -> `file_queue.rs`\n     7\t//!   * `c_src/src/read-alert.c`      -> `read_alert.rs`\n     8\t//!   * `c_src/src/file-queue.c`      -> `file_queue.rs`\n     9\t//!   * `c_src/src/driver.c`          -> `driver.rs`\n    10\t//!\n    11\t//! Exported ABI (matches `nm -D` on the C `libdriver.so`):\n    12\t//!   merror, Init_FileQueue, Read_FileMon,\n    13\t//!   os_calloc, os_realloc, os_strdup,\n    14\t//!   FreeAlertData, GetAlertData, driver\n    15\t\n    16\t#![allow(clippy::missing_safety_doc)]\n    17\t\n    18\tpub mod cbind;\n    19\t#[macro_use]\n    20\tpub mod shared;\n    21\tpub mod driver;\n    22\tpub mod file_queue;\n    23\tpub mod read_alert;\n===== shared.rs =====\n     1\t//! Translation of `c_src/include/shared.h`.\n     2\t//!\n     3\t//! The header defines (not just declares) `os_calloc`, `os_realloc` and\n     4\t//! `os_strdup` with external linkage, so the shared object exports them.\n     5\t\n     6\tuse core::ffi::{c_char, c_void};\n     7\t\n     8\tuse crate::cbind::*;\n     9\t\n    10\t/// `#define OS_MAXSTR 1024`\n    11\tpub const OS_MAXSTR: usize = 1024;\n    12\t\n    13\t/// `#define os_free(x) if(x){free(x);x=NULL;};`\n    14\t///\n    15\t/// Takes a mutable place expression holding a `*mut T`.\n    16\tmacro_rules! os_free {\n    17\t    ($x:expr) => {{\n    18\t        if !$x.is_null() {\n    19\t            $crate::cbind::free($x as *mut core::ffi::c_void);\n    20\t            $x = core::ptr::null_mut();\n    21\t        }\n    22\t    }};\n    23\t}\n    24\t\n    25\t/// `#define os_clearnl(x,p) if((p = strrchr(x, '\\n')))*p = '\\0';`\n    26\tmacro_rules! os_clearnl {\n    27\t    ($x:expr, $p:expr) => {{\n    28\t        $p = $crate::cbind::strrchr($x, b'\\n' as core::ffi::c_int);\n    29\t        if !$p.is_null() {\n    30\t            *$p = 0;\n    31\t        }\n    32\t    }};\n    33\t}\n    34\t\n    35\tpub(crate) use os_clearnl;\n    36\tpub(crate) use os_free;\n    37\t\n    38\t/// ```c\n    39\t/// void *os_calloc(size_t num, size_t size)\n    40\t/// ```\n    41\t#[allow(non_snake_case)]\n    42\t#[unsafe(no_mangle)]\n    43\tpub unsafe extern \"C\" fn os_calloc(num: usize, size: usize) -> *mut c_void {\n    44\t    let out = calloc(num, size);\n    45\t    if out.is_null() {\n    46\t        fprintf(stderr, cs(b\"Memory allocation failed in os_calloc\\0\"));\n    47\t        exit(EXIT_FAILURE);\n    48\t    }\n    49\t    out\n    50\t}\n    51\t\n    52\t/// ```c\n    53\t/// void *os_realloc(void *ptr, size_t new_size)\n    54\t/// ```\n    55\t#[allow(non_snake_case)]\n    56\t#[unsafe(no_mangle)]\n    57\tpub unsafe extern \"C\" fn os_realloc(ptr: *mut c_void, new_size: usize) -> *mut c_void {\n    58\t    let out = realloc(ptr, new_size);\n    59\t    if out.is_null() {\n    60\t        fprintf(stderr, cs(b\"Memory allocation failed in os_realloc\\0\"));\n    61\t        exit(EXIT_FAILURE);\n    62\t    }\n    63\t    out\n    64\t}\n    65\t\n    66\t/// ```c\n    67\t/// char *os_strdup(const char *str)\n    68\t/// ```\n    69\t#[allow(non_snake_case)]\n    70\t#[unsafe(no_mangle)]\n    71\tpub unsafe extern \"C\" fn os_strdup(str_: *const c_char) -> *mut c_char {\n    72\t    if str_.is_null() {\n    73\t        fprintf(stderr, cs(b\"NULL string passed to os_strdup\\0\"));\n    74\t        exit(EXIT_FAILURE);\n    75\t    }\n    76\t    let dup = strdup(str_);\n    77\t    if dup.is_null() {\n    78\t        fprintf(stderr, cs(b\"Memory allocation failed in os_strdup\\0\"));\n    79\t        exit(EXIT_FAILURE);\n    80\t    }\n    81\t    dup\n    82\t}\n===== cbind.rs =====\n     1\t//! Raw bindings to the libc entities that the original C library uses.\n     2\t//!\n     3\t//! The C sources call directly into glibc for every string / stdio / memory\n     4\t//! operation.  To guarantee byte-for-byte identical behaviour (including\n     5\t//! `errno` evolution, `printf` formatting and `strtol`/`atoi` corner cases) the\n     6\t//! translation calls the very same functions instead of re-implementing them.\n     7\t\n     8\t#![allow(non_camel_case_types)]\n     9\t\n    10\tuse core::ffi::{c_char, c_int, c_long, c_uint, c_ulong, c_void};\n    11\t\n    12\t/// Opaque `FILE`.\n    13\t#[repr(C)]\n    14\tpub struct FILE {\n    15\t    _opaque: [u8; 0],\n    16\t}\n    17\t\n    18\t/// `struct timespec`\n    19\t#[repr(C)]\n    20\t#[derive(Clone, Copy)]\n    21\tpub struct timespec {\n    22\t    pub tv_sec: c_long,\n    23\t    pub tv_nsec: c_long,\n    24\t}\n    25\t\n    26\t/// `struct timeval`\n    27\t#[repr(C)]\n    28\t#[derive(Clone, Copy)]\n    29\tpub struct timeval {\n    30\t    pub tv_sec: c_long,\n    31\t    pub tv_usec: c_long,\n    32\t}\n    33\t\n    34\t/// glibc x86-64 `struct stat` (144 bytes, `st_mtim` at offset 88).\n    35\t#[repr(C)]\n    36\t#[derive(Clone, Copy)]\n    37\tpub struct stat {\n    38\t    pub st_dev: c_ulong,\n    39\t    pub st_ino: c_ulong,\n    40\t    pub st_nlink: c_ulong,\n    41\t    pub st_mode: c_uint,\n    42\t    pub st_uid: c_uint,\n    43\t    pub st_gid: c_uint,\n    44\t    pub __pad0: c_uint,\n    45\t    pub st_rdev: c_ulong,\n    46\t    pub st_size: c_long,\n    47\t    pub st_blksize: c_long,\n    48\t    pub st_blocks: c_long,\n    49\t    pub st_atim: timespec,\n    50\t    pub st_mtim: timespec,\n    51\t    pub st_ctim: timespec,\n    52\t    pub __glibc_reserved: [c_long; 3],\n    53\t}\n    54\t\n    55\t/// glibc `struct tm` (56 bytes).\n    56\t#[repr(C)]\n    57\t#[derive(Clone, Copy)]\n    58\tpub struct tm {\n    59\t    pub tm_sec: c_int,\n    60\t    pub tm_min: c_int,\n    61\t    pub tm_hour: c_int,\n    62\t    pub tm_mday: c_int,\n    63\t    pub tm_mon: c_int,\n    64\t    pub tm_year: c_int,\n    65\t    pub tm_wday: c_int,\n    66\t    pub tm_yday: c_int,\n    67\t    pub tm_isdst: c_int,\n    68\t    pub tm_gmtoff: c_long,\n    69\t    pub tm_zone: *const c_char,\n    70\t}\n    71\t\n    72\tpub const SEEK_SET: c_int = 0;\n    73\tpub const SEEK_CUR: c_int = 1;\n    74\tpub const SEEK_END: c_int = 2;\n    75\t\n    76\tpub const EXIT_FAILURE: c_int = 1;\n    77\t\n    78\textern \"C\" {\n    79\t    pub static mut stderr: *mut FILE;\n    80\t\n    81\t    // <stdlib.h>\n    82\t    pub fn calloc(num: usize, size: usize) -> *mut c_void;\n    83\t    pub fn realloc(ptr: *mut c_void, new_size: usize) -> *mut c_void;\n    84\t    pub fn free(ptr: *mut c_void);\n    85\t    pub fn exit(status: c_int) -> !;\n    86\t    pub fn strtol(nptr: *const c_char, endptr: *mut *mut c_char, base: c_int) -> c_long;\n    87\t\n    88\t    // <stdio.h>\n    89\t    pub fn fopen(path: *const c_char, mode: *const c_char) -> *mut FILE;\n    90\t    pub fn fclose(stream: *mut FILE) -> c_int;\n    91\t    pub fn fseek(stream: *mut FILE, offset: c_long, whence: c_int) -> c_int;\n    92\t    pub fn fgets(s: *mut c_char, n: c_int, stream: *mut FILE) -> *mut c_char;\n    93\t    pub fn feof(stream: *mut FILE) -> c_int;\n    94\t    pub fn clearerr(stream: *mut FILE);\n    95\t    pub fn fileno(stream: *mut FILE) -> c_int;\n    96\t    pub fn perror(s: *const c_char);\n    97\t    pub fn fprintf(stream: *mut FILE, format: *const c_char, ...) -> c_int;\n    98\t    pub fn snprintf(s: *mut c_char, n: usize, format: *const c_char, ...) -> c_int;\n    99\t\n   100\t    // <string.h>\n   101\t    pub fn strdup(s: *const c_char) -> *mut c_char;\n   102\t    pub fn strlen(s: *const c_char) -> usize;\n   103\t    pub fn strchr(s: *const c_char, c: c_int) -> *mut c_char;\n   104\t    pub fn strrchr(s: *const c_char, c: c_int) -> *mut c_char;\n   105\t    pub fn strstr(haystack: *const c_char, needle: *const c_char) -> *mut c_char;\n   106\t    pub fn strncmp(s1: *const c_char, s2: *const c_char, n: usize) -> c_int;\n   107\t    pub fn strncpy(dst: *mut c_char, src: *const c_char, n: usize) -> *mut c_char;\n   108\t    pub fn strerror(errnum: c_int) -> *mut c_char;\n   109\t    pub fn memset(s: *mut c_void, c: c_int, n: usize) -> *mut c_void;\n   110\t\n   111\t    // <errno.h>\n   112\t    pub fn __errno_location() -> *mut c_int;\n   113\t\n   114\t    // <sys/stat.h>\n   115\t    pub fn fstat(fd: c_int, buf: *mut stat) -> c_int;\n   116\t\n   117\t    // <sys/select.h>\n   118\t    pub fn select(\n   119\t        nfds: c_int,\n   120\t        readfds: *mut c_void,\n   121\t        writefds: *mut c_void,\n   122\t        exceptfds: *mut c_void,\n   123\t        timeout: *mut timeval,\n   124\t    ) -> c_int;\n   125\t}\n   126\t\n   127\t/// `errno`\n   128\t#[inline]\n   129\tpub unsafe fn errno() -> c_int {\n   130\t    *__errno_location()\n   131\t}\n   132\t\n   133\t/// glibc's `atoi` is an inline wrapper around `strtol` with the result\n   134\t/// truncated to `int` -- exactly what the compiled C does.\n   135\t#[inline]\n   136\tpub unsafe fn atoi(nptr: *const c_char) -> c_int {\n   137\t    strtol(nptr, core::ptr::null_mut(), 10) as c_int\n   138\t}\n   139\t\n   140\t/// Helper: pointer to the NUL-terminated bytes of a byte-string literal.\n   141\t#[inline]\n   142\tpub const fn cs(bytes: &'static [u8]) -> *const c_char {\n   143\t    bytes.as_ptr() as *const c_char\n   144\t}\n===== driver.rs =====\n     1\t//! Translation of `c_src/src/driver.c`.\n     2\t\n     3\tuse core::ffi::{c_int, c_uint};\n     4\tuse core::ptr;\n     5\t\n     6\tuse crate::cbind::*;\n     7\tuse crate::file_queue::{file_queue, Init_FileQueue, Read_FileMon};\n     8\tuse crate::read_alert::alert_data;\n     9\t\n    10\t/// ```c\n    11\t/// // Main entrypoint for this library\n    12\t/// alert_data* driver(int day, int month, int year, unsigned int timeout, int flags)\n    13\t/// ```\n    14\t#[unsafe(no_mangle)]\n    15\tpub unsafe extern \"C\" fn driver(\n    16\t    day: c_int,\n    17\t    month: c_int,\n    18\t    year: c_int,\n    19\t    timeout: c_uint,\n    20\t    flags: c_int,\n    21\t) -> *mut alert_data {\n    22\t    // `struct tm time = {0};`\n    23\t    let mut time: tm = core::mem::zeroed();\n    24\t    time.tm_mday = day;\n    25\t    time.tm_mon = month;\n    26\t    time.tm_year = year;\n    27\t\n    28\t    // `file_queue fq; memset(&fq, 0, sizeof(file_queue));`\n    29\t    let mut fq: file_queue = core::mem::zeroed();\n    30\t    memset(\n    31\t        &mut fq as *mut file_queue as *mut core::ffi::c_void,\n    32\t        0,\n    33\t        core::mem::size_of::<file_queue>(),\n    34\t    );\n    35\t\n    36\t    if Init_FileQueue(&mut fq, &time, flags) < 0 {\n    37\t        fprintf(stderr, cs(b\"File queue initialization failed\\0\"));\n    38\t        return ptr::null_mut();\n    39\t    }\n    40\t\n    41\t    let al_data = Read_FileMon(&mut fq, &time, timeout);\n    42\t\n    43\t    if !fq.fp.is_null() {\n    44\t        fclose(fq.fp);\n    45\t    }\n    46\t    al_data\n    47\t}\n===== file_queue.rs =====\n     1\t//! Translation of `c_src/src/file-queue.c` (+ `c_src/include/file-queue.h`).\n     2\t\n     3\tuse core::ffi::{c_char, c_int, c_long, c_uint};\n     4\tuse core::ptr;\n     5\t\n     6\tuse crate::cbind::*;\n     7\tuse crate::read_alert::{alert_data, GetAlertData, ALERTS_DAILY, CRALERT_FP_SET, CRALERT_READ_ALL};\n     8\t\n     9\t/* ---------------------------------------------------------------- */\n    10\t/* file-queue.h                                                     */\n    11\t/* ---------------------------------------------------------------- */\n    12\t\n    13\t/// `#define MAX_FQUEUE 256`\n    14\tpub const MAX_FQUEUE: usize = 256;\n    15\t/// `#define FQ_TIMEOUT 5`\n    16\tpub const FQ_TIMEOUT: c_long = 5;\n    17\t\n    18\t/// ```c\n    19\t/// typedef struct file_queue {\n    20\t///     time_t last_change;\n    21\t///     int year;\n    22\t///     int day;\n    23\t///     int flags;\n    24\t///     char mon[4];\n    25\t///     char file_name[MAX_FQUEUE + 1];\n    26\t///     FILE *fp;\n    27\t///     struct stat f_status;\n    28\t/// } file_queue;\n    29\t/// ```\n    30\t#[repr(C)]\n    31\tpub struct file_queue {\n    32\t    pub last_change: c_long,\n    33\t    pub year: c_int,\n    34\t    pub day: c_int,\n    35\t    pub flags: c_int,\n    36\t    pub mon: [c_char; 4],\n    37\t    pub file_name: [c_char; MAX_FQUEUE + 1],\n    38\t    pub fp: *mut FILE,\n    39\t    pub f_status: stat,\n    40\t}\n    41\t\n    42\t/* ---------------------------------------------------------------- */\n    43\t/* file-queue.c                                                     */\n    44\t/* ---------------------------------------------------------------- */\n    45\t\n    46\tconst FSTAT_ERROR: &[u8] =\n    47\t    b\"(1118): Could not retrieve information of file '%s' due to [(%d)-(%s)].\\0\";\n    48\tconst FSEEK_ERROR: &[u8] = b\"(1116): Could not set position in file '%s' due to [(%d)-(%s)].\\0\";\n    49\t\n    50\t/// ```c\n    51\t/// void merror(const char *err_template, const char *file_name, int err, const char *err_msg)\n    52\t/// ```\n    53\t#[unsafe(no_mangle)]\n    54\tpub unsafe extern \"C\" fn merror(\n    55\t    err_template: *const c_char,\n    56\t    file_name: *const c_char,\n    57\t    err: c_int,\n    58\t    err_msg: *const c_char,\n    59\t) {\n    60\t    let mut buffer = [0 as c_char; 256];\n    61\t    snprintf(\n    62\t        buffer.as_mut_ptr(),\n    63\t        core::mem::size_of_val(&buffer),\n    64\t        err_template,\n    65\t        file_name,\n    66\t        err,\n    67\t        err_msg,\n    68\t    );\n    69\t    fprintf(stderr, cs(b\"%s\\n\\0\"), buffer.as_ptr());\n    70\t}\n    71\t\n    72\t/// `static const char *(s_month[]) = {\"Jan\", ... \"Dec\"};`\n    73\tstatic S_MONTH: [&[u8]; 12] = [\n    74\t    b\"Jan\\0\", b\"Feb\\0\", b\"Mar\\0\", b\"Apr\\0\", b\"May\\0\", b\"Jun\\0\", b\"Jul\\0\", b\"Aug\\0\", b\"Sep\\0\",\n    75\t    b\"Oct\\0\", b\"Nov\\0\", b\"Dec\\0\",\n    76\t];\n    77\t\n    78\t/// `strncpy(fileq->mon, s_month[p->tm_mon], 3);`\n    79\t///\n    80\t/// The C code indexes `s_month` without validating `tm_mon`; an out-of-range\n    81\t/// month is undefined behaviour there (it reads past the end of a 12 element\n    82\t/// table).  There is nothing meaningful to mirror, so the copy is skipped.\n    83\t#[inline]\n    84\tunsafe fn copy_month(fileq: *mut file_queue, tm_mon: c_int) {\n    85\t    if tm_mon >= 0 && (tm_mon as usize) < 12 {\n    86\t        strncpy(\n    87\t            (*fileq).mon.as_mut_ptr(),\n    88\t            cs(S_MONTH[tm_mon as usize]),\n    89\t            3,\n    90\t        );\n    91\t    }\n    92\t}\n    93\t\n    94\t/// ```c\n    95\t/// static void file_sleep(void)\n    96\t/// ```\n    97\tunsafe fn file_sleep() {\n    98\t    let mut fp_timeout = timeval {\n    99\t        tv_sec: FQ_TIMEOUT,\n   100\t        tv_usec: 0,\n   101\t    };\n   102\t\n   103\t    /* Wait for the select timeout */\n   104\t    select(\n   105\t        0,\n   106\t        ptr::null_mut(),\n   107\t        ptr::null_mut(),\n   108\t        ptr::null_mut(),\n   109\t        &mut fp_timeout,\n   110\t    );\n   111\t}\n   112\t\n   113\t/// ```c\n   114\t/// static void GetFile_Queue(file_queue *fileq)\n   115\t/// ```\n   116\t#[allow(non_snake_case)]\n   117\tunsafe fn GetFile_Queue(fileq: *mut file_queue) {\n   118\t    /* Create the logfile name */\n   119\t    (*fileq).file_name[0] = 0;\n   120\t    (*fileq).file_name[MAX_FQUEUE] = 0;\n   121\t\n   122\t    let src = if (*fileq).flags & CRALERT_FP_SET != 0 {\n   123\t        cs(b\"<stdin>\\0\")\n   124\t    } else {\n   125\t        cs(ALERTS_DAILY)\n   126\t    };\n   127\t\n   128\t    snprintf(\n   129\t        (*fileq).file_name.as_mut_ptr(),\n   130\t        MAX_FQUEUE,\n   131\t        cs(b\"%s\\0\"),\n   132\t        src,\n   133\t    );\n   134\t}\n   135\t\n   136\t/// ```c\n   137\t/// static int Handle_Queue(file_queue *fileq, int flags)\n   138\t/// ```\n   139\t#[allow(non_snake_case)]\n   140\tunsafe fn Handle_Queue(fileq: *mut file_queue, flags: c_int) -> c_int {\n   141\t    /* Close if it is open */\n   142\t    if flags & CRALERT_FP_SET == 0 {\n   143\t        if !(*fileq).fp.is_null() {\n   144\t            fclose((*fileq).fp);\n   145\t            (*fileq).fp = ptr::null_mut();\n   146\t        }\n   147\t\n   148\t        /* We must be able to open the file, fseek and get the\n   149\t         * time of change from it.\n   150\t         */\n   151\t        (*fileq).fp = fopen((*fileq).file_name.as_ptr(), cs(b\"r\\0\"));\n   152\t        if (*fileq).fp.is_null() {\n   153\t            /* Queue not available */\n   154\t            return 0;\n   155\t        }\n   156\t    }\n   157\t\n   158\t    /* Seek to the end of the file */\n   159\t    if flags & CRALERT_READ_ALL == 0 {\n   160\t        if (*fileq).fp.is_null() {\n   161\t            return 0;\n   162\t        }\n   163\t\n   164\t        if fseek((*fileq).fp, 0, SEEK_END) < 0 {\n   165\t            merror(\n   166\t                cs(FSEEK_ERROR),\n   167\t                (*fileq).file_name.as_ptr(),\n   168\t                errno(),\n   169\t                strerror(errno()),\n   170\t            );\n   171\t            fclose((*fileq).fp);\n   172\t            (*fileq).fp = ptr::null_mut();\n   173\t            return -1;\n   174\t        }\n   175\t    }\n   176\t\n   177\t    /* File change time */\n   178\t    if !(*fileq).fp.is_null() {\n   179\t        if fstat(fileno((*fileq).fp), &mut (*fileq).f_status) < 0 {\n   180\t            merror(\n   181\t                cs(FSTAT_ERROR),\n   182\t                (*fileq).file_name.as_ptr(),\n   183\t                errno(),\n   184\t                strerror(errno()),\n   185\t            );\n   186\t            fclose((*fileq).fp);\n   187\t            (*fileq).fp = ptr::null_mut();\n   188\t            return -1;\n   189\t        }\n   190\t    }\n   191\t\n   192\t    (*fileq).last_change = (*fileq).f_status.st_mtim.tv_sec;\n   193\t\n   194\t    1\n   195\t}\n   196\t\n   197\t/// ```c\n   198\t/// int Init_FileQueue(file_queue *fileq, const struct tm *p, int flags)\n   199\t/// ```\n   200\t#[allow(non_snake_case)]\n   201\t#[unsafe(no_mangle)]\n   202\tpub unsafe extern \"C\" fn Init_FileQueue(\n   203\t    fileq: *mut file_queue,\n   204\t    p: *const tm,\n   205\t    flags: c_int,\n   206\t) -> c_int {\n   207\t    /* Initialize file_queue fields */\n   208\t    if flags & CRALERT_FP_SET == 0 {\n   209\t        (*fileq).fp = ptr::null_mut();\n   210\t    }\n   211\t    (*fileq).last_change = 0;\n   212\t    (*fileq).flags = 0;\n   213\t\n   214\t    (*fileq).day = (*p).tm_mday;\n   215\t    (*fileq).year = (*p).tm_year + 1900;\n   216\t\n   217\t    copy_month(fileq, (*p).tm_mon);\n   218\t    memset(\n   219\t        (*fileq).file_name.as_mut_ptr() as *mut core::ffi::c_void,\n   220\t        0,\n   221\t        MAX_FQUEUE + 1,\n   222\t    );\n   223\t\n   224\t    /* Set the supplied flags */\n   225\t    (*fileq).flags = flags;\n   226\t\n   227\t    /* Get latest file */\n   228\t    GetFile_Queue(fileq);\n   229\t\n   230\t    /* Always seek to the end when starting the queue */\n   231\t    if Handle_Queue(fileq, (*fileq).flags) < 0 {\n   232\t        return -1;\n   233\t    }\n   234\t\n   235\t    0\n   236\t}\n   237\t\n   238\t/// ```c\n   239\t/// alert_data *Read_FileMon(file_queue *fileq, const struct tm *p, unsigned int timeout)\n   240\t/// ```\n   241\t#[allow(non_snake_case)]\n   242\t#[unsafe(no_mangle)]\n   243\tpub unsafe extern \"C\" fn Read_FileMon(\n   244\t    fileq: *mut file_queue,\n   245\t    p: *const tm,\n   246\t    timeout: c_uint,\n   247\t) -> *mut alert_data {\n   248\t    let mut i: c_uint = 0;\n   249\t    let mut al_data: *mut alert_data;\n   250\t\n   251\t    /* If the file queue is not available, try to access it */\n   252\t    if (*fileq).fp.is_null() {\n   253\t        if Handle_Queue(fileq, 0) != 1 {\n   254\t            file_sleep();\n   255\t            return ptr::null_mut();\n   256\t        }\n   257\t    }\n   258\t\n   259\t    if (*fileq).fp.is_null() {\n   260\t        return ptr::null_mut();\n   261\t    }\n   262\t\n   263\t    al_data = GetAlertData((*fileq).flags, (*fileq).fp);\n   264\t    if !al_data.is_null() {\n   265\t        return al_data;\n   266\t    }\n   267\t\n   268\t    (*fileq).day = (*p).tm_mday;\n   269\t    (*fileq).year = (*p).tm_year + 1900;\n   270\t    copy_month(fileq, (*p).tm_mon);\n   271\t\n   272\t    /* Get latest file */\n   273\t    GetFile_Queue(fileq);\n   274\t\n   275\t    if Handle_Queue(fileq, 0) != 1 {\n   276\t        file_sleep();\n   277\t        return ptr::null_mut();\n   278\t    }\n   279\t\n   280\t    /* Try up to timeout times to get an event */\n   281\t    while i < timeout {\n   282\t        al_data = GetAlertData((*fileq).flags, (*fileq).fp);\n   283\t        if !al_data.is_null() {\n   284\t            return al_data;\n   285\t        }\n   286\t\n   287\t        i += 1;\n   288\t        file_sleep();\n   289\t    }\n   290\t\n   291\t    /* Return NULL if timeout expires */\n   292\t    ptr::null_mut()\n   293\t}","is_error":false}]},"parent_tool_use_id":null,"session_id":"28b5e5a5-2f5e-4b09-bc69-ff69bc592e87","uuid":"bd0b1bfa-0bbf-4e97-a66d-2c59ee5cfe93","timestamp":"2026-09-05T07:16:32.475Z","tool_use_result":{"stdout":"===== lib.rs =====\n     1\t//! Rust translation of the `driver` C shared library.\n     2\t//!\n     3\t//! Sources translated (1:1, file for file):\n     4\t//!   * `c_src/include/shared.h`      -> `shared.rs`\n     5\t//!   * `c_sr