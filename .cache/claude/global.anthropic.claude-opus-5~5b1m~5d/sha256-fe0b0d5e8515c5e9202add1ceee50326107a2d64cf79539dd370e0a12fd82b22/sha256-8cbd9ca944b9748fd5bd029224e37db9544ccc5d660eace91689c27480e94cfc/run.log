{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01GLyzy3eazs4QT8nnhxZcrr","type":"tool_result","content":"===== include/shared.h =====\n     1\t#ifndef SHARED_H\n     2\t#define SHARED_H\n     3\t\n     4\t#include <stdlib.h>\n     5\t#include <stdio.h>\n     6\t#include <string.h>\n     7\t\n     8\t#define OS_MAXSTR 1024\n     9\t\n    10\t#define os_free(x) if(x){free(x);x=NULL;};\n    11\t#define os_clearnl(x,p) if((p = strrchr(x, '\\n')))*p = '\\0';\n    12\t\n    13\tvoid *os_calloc(size_t num, size_t size) {\n    14\t    void *out = calloc(num, size);\n    15\t    if (!out) {\n    16\t        fprintf(stderr, \"Memory allocation failed in os_calloc\");\n    17\t        exit(EXIT_FAILURE);\n    18\t    }\n    19\t    return out;\n    20\t}\n    21\t\n    22\tvoid *os_realloc(void *ptr, size_t new_size) {\n    23\t    void *out = realloc(ptr, new_size);\n    24\t    if (!out) {\n    25\t        fprintf(stderr, \"Memory allocation failed in os_realloc\");\n    26\t        exit(EXIT_FAILURE);\n    27\t    }\n    28\t    return out;\n    29\t}\n    30\t\n    31\tchar *os_strdup(const char *str) {\n    32\t    if (!str) {\n    33\t        fprintf(stderr, \"NULL string passed to os_strdup\");\n    34\t        exit(EXIT_FAILURE);\n    35\t    }\n    36\t    char *dup = strdup(str);\n    37\t    if (!dup) {\n    38\t        fprintf(stderr, \"Memory allocation failed in os_strdup\");\n    39\t        exit(EXIT_FAILURE);\n    40\t    }\n    41\t    return dup;\n    42\t}\n    43\t\n    44\t#endif\n===== include/file-queue.h =====\n     1\t/* Copyright (C) 2015, Wazuh Inc.\n     2\t * Copyright (C) 2009 Trend Micro Inc.\n     3\t * All right reserved.\n     4\t *\n     5\t * This program is free software; you can redistribute it\n     6\t * and/or modify it under the terms of the GNU General Public\n     7\t * License (version 2) as published by the FSF - Free Software\n     8\t * Foundation\n     9\t */\n    10\t\n    11\t#ifndef CFQUEUE_H\n    12\t#define CFQUEUE_H\n    13\t\n    14\t#include <stdio.h>\n    15\t#include <time.h>\n    16\t#include <sys/stat.h>\n    17\t\n    18\t#define MAX_FQUEUE  256\n    19\t#define FQ_TIMEOUT  5\n    20\t\n    21\t/* File queue */\n    22\ttypedef struct file_queue {\n    23\t    time_t last_change;\n    24\t    int year;\n    25\t    int day;\n    26\t    int flags;\n    27\t\n    28\t    char mon[4];\n    29\t    char file_name[MAX_FQUEUE + 1];\n    30\t\n    31\t    FILE *fp;\n    32\t    struct stat f_status;\n    33\t} file_queue;\n    34\t\n    35\t#include \"read-alert.h\"\n    36\tint Init_FileQueue(file_queue *fileq, const struct tm *p, int flags) __attribute__((nonnull));\n    37\t\n    38\talert_data *Read_FileMon(file_queue *fileq, const struct tm *p, unsigned int timeout) __attribute__((nonnull));\n    39\t\n    40\t#endif /* CFQUEUE_H */\n===== include/read-alert.h =====\n     1\t/* Copyright (C) 2015, Wazuh Inc.\n     2\t * Copyright (C) 2009 Trend Micro Inc.\n     3\t * All right reserved.\n     4\t *\n     5\t * This program is free software; you can redistribute it\n     6\t * and/or modify it under the terms of the GNU General Public\n     7\t * License (version 2) as published by the FSF - Free Software\n     8\t * Foundation\n     9\t */\n    10\t\n    11\t#ifndef CRALERT_H\n    12\t#define CRALERT_H\n    13\t\n    14\t#include <stdio.h>\n    15\t\n    16\t#define ALERTS_DAILY \"alerts.log\"\n    17\t\n    18\t#define CRALERT_MAIL_SET    0x001\n    19\t#define CRALERT_EXEC_SET    0x002\n    20\t#define CRALERT_READ_ALL    0x004\n    21\t#define CRALERT_READ_FAILED 0x008\n    22\t#define CRALERT_FP_SET      0x010\n    23\t\n    24\t/* File queue */\n    25\ttypedef struct alert_data {\n    26\t    unsigned int rule;\n    27\t    unsigned int level;\n    28\t    char *alertid;\n    29\t    char *date;\n    30\t    char *location;\n    31\t    char *comment;\n    32\t    char *group;\n    33\t    char *srcip;\n    34\t    int srcport;\n    35\t    char *dstip;\n    36\t    int dstport;\n    37\t    char *user;\n    38\t    char *filename;\n    39\t} alert_data;\n    40\t\n    41\talert_data *GetAlertData(int flag, FILE *fp) __attribute__((nonnull));\n    42\tvoid        FreeAlertData(alert_data *al_data) __attribute__((nonnull));\n    43\t\n    44\t#endif /* CRALERT_H */\n===== src/driver.c =====\n     1\t#include \"file-queue.h\"\n     2\t\n     3\t#include <memory.h>\n     4\t\n     5\t// Main entrypoint for this library\n     6\talert_data* driver(int day, int month, int year, unsigned int timeout, int flags) {\n     7\t    struct tm time = {0};\n     8\t    time.tm_mday = day;\n     9\t    time.tm_mon = month;\n    10\t    time.tm_year = year;\n    11\t\n    12\t    file_queue fq;\n    13\t    memset(&fq, 0, sizeof(file_queue));\n    14\t\n    15\t    if (Init_FileQueue(&fq, &time, flags) < 0) {\n    16\t        fprintf(stderr, \"File queue initialization failed\");\n    17\t        return NULL;\n    18\t    }\n    19\t\n    20\t    alert_data *al_data = Read_FileMon(&fq, &time, timeout);\n    21\t\n    22\t    if (fq.fp) {\n    23\t        fclose(fq.fp);\n    24\t    }\n    25\t    return al_data;\n    26\t}\n===== src/file-queue.c =====\n     1\t/* Copyright (C) 2015, Wazuh Inc.\n     2\t * Copyright (C) 2009 Trend Micro Inc.\n     3\t * All right reserved.\n     4\t *\n     5\t * This program is free software; you can redistribute it\n     6\t * and/or modify it under the terms of the GNU General Public\n     7\t * License (version 2) as published by the FSF - Free Software\n     8\t * Foundation\n     9\t */\n    10\t\n    11\t/* File monitoring functions */\n    12\t\n    13\t#include \"file-queue.h\"\n    14\t#include \"read-alert.h\"\n    15\t\n    16\t#include <stdio.h>\n    17\t#include <string.h>\n    18\t#include <sys/time.h>\n    19\t#include <errno.h>\n    20\t\n    21\t#define FSTAT_ERROR   \"(1118): Could not retrieve information of file '%s' due to [(%d)-(%s)].\"\n    22\t#define FSEEK_ERROR   \"(1116): Could not set position in file '%s' due to [(%d)-(%s)].\"\n    23\t\n    24\tvoid merror(const char *err_template, const char *file_name, int err, const char *err_msg) {\n    25\t    char buffer[256];\n    26\t    snprintf(buffer, sizeof(buffer), err_template, file_name, err, err_msg);\n    27\t    fprintf(stderr, \"%s\\n\", buffer);\n    28\t}\n    29\t\n    30\tstatic void file_sleep(void);\n    31\tstatic void GetFile_Queue(file_queue *fileq) __attribute__((nonnull));\n    32\tstatic int Handle_Queue(file_queue *fileq, int flags) __attribute__((nonnull));\n    33\t\n    34\t/* To translate between month (int) to month (char) */\n    35\tstatic const char *(s_month[]) = {\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\",\n    36\t                                  \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"\n    37\t                                 };\n    38\t\n    39\t\n    40\tstatic void file_sleep() {\n    41\t\n    42\t    struct timeval fp_timeout;\n    43\t\n    44\t    fp_timeout.tv_sec = FQ_TIMEOUT;\n    45\t    fp_timeout.tv_usec = 0;\n    46\t\n    47\t    /* Wait for the select timeout */\n    48\t    select(0, NULL, NULL, NULL, &fp_timeout);\n    49\t\n    50\t    return;\n    51\t}\n    52\t\n    53\t/* Get the file queue for that specific hour */\n    54\tstatic void GetFile_Queue(file_queue *fileq)\n    55\t{\n    56\t    /* Create the logfile name */\n    57\t    fileq->file_name[0] = '\\0';\n    58\t    fileq->file_name[MAX_FQUEUE] = '\\0';\n    59\t\n    60\t    snprintf(fileq->file_name, MAX_FQUEUE, \"%s\", fileq->flags & CRALERT_FP_SET ? \"<stdin>\" : ALERTS_DAILY);\n    61\t}\n    62\t\n    63\t/* Re Handle the file queue */\n    64\tstatic int Handle_Queue(file_queue *fileq, int flags)\n    65\t{\n    66\t    /* Close if it is open */\n    67\t    if (!(flags & CRALERT_FP_SET)) {\n    68\t        if (fileq->fp) {\n    69\t            fclose(fileq->fp);\n    70\t            fileq->fp = NULL;\n    71\t        }\n    72\t\n    73\t        /* We must be able to open the file, fseek and get the\n    74\t         * time of change from it.\n    75\t         */\n    76\t        fileq->fp = fopen(fileq->file_name, \"r\");\n    77\t        if (!fileq->fp) {\n    78\t            /* Queue not available */\n    79\t            return (0);\n    80\t        }\n    81\t    }\n    82\t\n    83\t    /* Seek to the end of the file */\n    84\t    if (!(flags & CRALERT_READ_ALL)) {\n    85\t        if (!fileq->fp) {\n    86\t            return (0);\n    87\t        }\n    88\t\n    89\t        if (fseek(fileq->fp, 0, SEEK_END) < 0) {\n    90\t            merror(FSEEK_ERROR, fileq->file_name, errno, strerror(errno));\n    91\t            fclose(fileq->fp);\n    92\t            fileq->fp = NULL;\n    93\t            return (-1);\n    94\t        }\n    95\t    }\n    96\t\n    97\t    /* File change time */\n    98\t    if (fileq->fp) {\n    99\t        if (fstat(fileno(fileq->fp), &fileq->f_status) < 0) {\n   100\t            merror(FSTAT_ERROR, fileq->file_name, errno, strerror(errno));\n   101\t            fclose(fileq->fp);\n   102\t            fileq->fp = NULL;\n   103\t            return (-1);\n   104\t        }\n   105\t    }\n   106\t\n   107\t    fileq->last_change = fileq->f_status.st_mtime;\n   108\t\n   109\t    return (1);\n   110\t}\n   111\t\n   112\t/* Initiates the file monitoring */\n   113\tint Init_FileQueue(file_queue *fileq, const struct tm *p, int flags)\n   114\t{\n   115\t    /* Initialize file_queue fields */\n   116\t    if (!(flags & CRALERT_FP_SET)) {\n   117\t        fileq->fp = NULL;\n   118\t    }\n   119\t    fileq->last_change = 0;\n   120\t    fileq->flags = 0;\n   121\t\n   122\t    fileq->day = p->tm_mday;\n   123\t    fileq->year = p->tm_year + 1900;\n   124\t\n   125\t    strncpy(fileq->mon, s_month[p->tm_mon], 3);\n   126\t    memset(fileq->file_name, '\\0', MAX_FQUEUE + 1);\n   127\t\n   128\t    /* Set the supplied flags */\n   129\t    fileq->flags = flags;\n   130\t\n   131\t    /* Get latest file */\n   132\t    GetFile_Queue(fileq);\n   133\t\n   134\t    /* Always seek to the end when starting the queue */\n   135\t    if (Handle_Queue(fileq, fileq->flags) < 0) {\n   136\t        return (-1);\n   137\t    }\n   138\t\n   139\t    return (0);\n   140\t}\n   141\t\n   142\t/* Reads from the monitored file */\n   143\talert_data *Read_FileMon(file_queue *fileq, const struct tm *p, unsigned int timeout)\n   144\t{\n   145\t    unsigned int i = 0;\n   146\t    alert_data *al_data;\n   147\t\n   148\t    /* If the file queue is not available, try to access it */\n   149\t    if (!fileq->fp) {\n   150\t        if (Handle_Queue(fileq, 0) != 1) {\n   151\t            file_sleep();\n   152\t            return (NULL);\n   153\t        }\n   154\t    }\n   155\t\n   156\t    if(!fileq->fp){\n   157\t        return (NULL);\n   158\t    }\n   159\t\n   160\t    if (al_data = GetAlertData(fileq->flags, fileq->fp), al_data) {\n   161\t        return al_data;\n   162\t    }\n   163\t\n   164\t    fileq->day = p->tm_mday;\n   165\t    fileq->year = p->tm_year + 1900;\n   166\t    strncpy(fileq->mon, s_month[p->tm_mon], 3);\n   167\t\n   168\t    /* Get latest file */\n   169\t    GetFile_Queue(fileq);\n   170\t\n   171\t    if (Handle_Queue(fileq, 0) != 1) {\n   172\t        file_sleep();\n   173\t        return (NULL);\n   174\t    }\n   175\t\n   176\t    /* Try up to timeout times to get an event */\n   177\t    while (i < timeout) {\n   178\t        al_data = GetAlertData(fileq->flags, fileq->fp);\n   179\t        if (al_data) {\n   180\t            return (al_data);\n   181\t        }\n   182\t\n   183\t        i++;\n   184\t        file_sleep();\n   185\t    }\n   186\t\n   187\t    /* Return NULL if timeout expires */\n   188\t    return (NULL);\n   189\t}","is_error":false}]},"parent_tool_use_id":null,"session_id":"28b5e5a5-2f5e-4b09-bc69-ff69bc592e87","uuid":"8587a594-c7a4-46d9-b0d2-e9c3803e662c","timestamp":"2026-09-05