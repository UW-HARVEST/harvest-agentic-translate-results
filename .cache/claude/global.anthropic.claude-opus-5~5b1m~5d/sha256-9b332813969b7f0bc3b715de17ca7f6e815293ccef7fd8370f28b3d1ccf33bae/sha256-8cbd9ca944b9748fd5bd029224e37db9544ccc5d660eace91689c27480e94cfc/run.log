       ce.snap().code, json_error_cannot_open_file,\n                    \"json_load_file({path:?}) code\"\n                );\n            }\n\"\"\"\nnew = \"\"\"                assert_eq!(\n                    ce.snap().code, json_error_cannot_open_file,\n                    \"json_load_file({path:?}) code\"\n                );\n            }\n            // Paths that DO open but cannot be read as JSON: whatever the C\n            // reports, the Rust must report identically.\n            for path in [\"/\", \"/tmp\", \"/proc/self\"] {\n                let ps = cs(path);\n                let mut ce = json_error_t::default();\n                let mut re = json_error_t::default();\n                let cj = p.c.json_load_file(ps.as_ptr(), flags, &mut ce);\n                let rj = p.r.json_load_file(ps.as_ptr(), flags, &mut re);\n                assert_eq!(cj.is_null(), rj.is_null(), \"json_load_file({path:?})\");\n                assert_eq!(ce.snap(), re.snap(), \"json_load_file({path:?}) error\");\n                p.c.json_decref(cj);\n                p.r.json_decref(rj);\n            }\n\"\"\"\nassert old in s\ns = s.replace(old, new)\n\n# (3) For the \"tokens after ! / *\" rows the object must CONTAIN the key, or the\n#     item-not-found error fires first.\nold = \"\"\"            // O3: tokens after `!` / `*` inside an object\n            (Node::Obj(vec![]), \"{s:i!s:i}\", json_error_invalid_format),\n            (Node::Obj(vec![]), \"{s:i*s:i}\", json_error_invalid_format),\n            (Node::Obj(vec![]), \"{!s:i}\", json_error_invalid_format),\"\"\"\nnew = \"\"\"            // O3: tokens after `!` / `*` inside an object. The root must\n            // CONTAIN key \"k\", otherwise json_error_item_not_found is raised\n            // first and the format error is never reached.\n            (\n                Node::Obj(vec![(b\"k\".to_vec(), Node::Int(1))]),\n                \"{s:i!s:i}\",\n                json_error_invalid_format,\n            ),\n            (\n                Node::Obj(vec![(b\"k\".to_vec(), Node::Int(1))]),\n                \"{s:i*s:i}\",\n                json_error_invalid_format,\n            ),\n            (Node::Obj(vec![]), \"{!s:i}\", json_error_invalid_format),\"\"\"\nassert old in s\ns = s.replace(old, new)\n\n# Same ordering concern for the array rows \"[i!i]\" / \"[i*i]\": an EMPTY array\n# raises index_out_of_range first.\nold = \"\"\"            // O11: tokens after `!` / `*` inside an array\n            (Node::Arr(vec![]), \"[i!i]\", json_error_invalid_format),\n            (Node::Arr(vec![]), \"[i*i]\", json_error_invalid_format),\n            (Node::Arr(vec![]), \"[!i]\", json_error_invalid_format),\"\"\"\nnew = \"\"\"            // O11: tokens after `!` / `*` inside an array. The array must have\n            // an element, otherwise json_error_index_out_of_range fires first.\n            (Node::Arr(vec![Node::Int(1)]), \"[i!i]\", json_error_invalid_format),\n            (Node::Arr(vec![Node::Int(1)]), \"[i*i]\", json_error_invalid_format),\n            (Node::Arr(vec![]), \"[!i]\", json_error_invalid_format),\"\"\"\nassert old in s\ns = s.replace(old, new)\n\n# \"{s:x}\" / \"{s:#}\" also need the key present.\nold = \"\"\"            (Node::Obj(vec![]), \"{s:x}\", json_error_invalid_format),\n            (Node::Obj(vec![]), \"{s:#}\", json_error_invalid_format),\"\"\"\nnew = \"\"\"            (\n                Node::Obj(vec![(b\"k\".to_vec(), Node::Int(1))]),\n                \"{s:x}\",\n                json_error_invalid_format,\n            ),\n            (\n                Node::Obj(vec![(b\"k\".to_vec(), Node::Int(1))]),\n                \"{s:#}\",\n                json_error_invalid_format,\n            ),\"\"\"\nassert old in s\ns = s.replace(old, new)\n\n# \"[x]\" etc. already use a 1-element array. \"[]]\" garbage-after: fine.\nopen(p,\"w\").write(s)\nprint(\"ok\")\nPY\ncd $R/translation && timeout 900 cargo test --offline --release --test c_errors 2>&1 -- --test-threads=1 