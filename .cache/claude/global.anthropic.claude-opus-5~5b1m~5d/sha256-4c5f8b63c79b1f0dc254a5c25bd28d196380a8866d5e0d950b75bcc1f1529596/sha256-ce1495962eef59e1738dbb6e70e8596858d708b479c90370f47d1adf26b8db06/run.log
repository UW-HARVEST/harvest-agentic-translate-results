{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01JcR74wbojRUuA6uf3BcDrG","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/`.\n2\t//!\n3\t//! Public ABI (as exported by the C shared object):\n4\t//!   * `tflac_pack_u64le`\n5\t//!   * `tflac_md5_addsample`\n6\t//!   * `update_md5`\n7\t//!\n8\t//! Behaviour — including the quirks/bugs of the original C — is reproduced\n9\t//! exactly: the sample-pointer stride in `update_md5` really does advance by\n10\t//! `8 * sizeof(tflac_s32)` *elements* (32), the loop really does run five\n11\t//! times (`i <= 4`), and the byte counter `b` is decremented by\n12\t//! `sizeof(tflac_uint)` (8) each iteration with unsigned wraparound.\n13\t\n14\t#![allow(non_camel_case_types)]\n15\t\n16\tuse core::ffi::c_void;\n17\t\n18\t/* ------------------------------------------------------------------ */\n19\t/* Typedefs mirroring lib.h                                            */\n20\t/* ------------------------------------------------------------------ */\n21\t\n22\tpub type tflac_u8 = u8;\n23\tpub type tflac_s32 = i32;\n24\tpub type tflac_u32 = u32;\n25\tpub type tflac_u64 = u64;\n26\t\n27\t/// `typedef tflac_u64 tflac_uint;` from lib.c\n28\tpub type tflac_uint = tflac_u64;\n29\t\n30\t/// Size of the MD5 scratch buffer: `tflac_u8 buffer[64 + 8]`.\n31\tconst TFLAC_MD5_BUFFER_LEN: usize = 64 + 8;\n32\t\n33\t/// `struct tflac_md5` — verified layout: size 88, pos@0, total@8, buffer@16.\n34\t#[repr(C)]\n35\tpub struct tflac_md5 {\n36\t    pub pos: tflac_u32,\n37\t    pub total: tflac_u64,\n38\t    pub buffer: [tflac_u8; TFLAC_MD5_BUFFER_LEN],\n39\t}\n40\t\n41\t/// `struct tflac` — verified layout: size 96, md5_ctx@0, cur_blocksize@88,\n42\t/// channels@92.\n43\t#[repr(C)]\n44\tpub struct tflac {\n45\t    pub md5_ctx: tflac_md5,\n46\t    pub cur_blocksize: tflac_u32,\n47\t    pub channels: tflac_u32,\n48\t}\n49\t\n50\t/* ----------------------------------------------------------------