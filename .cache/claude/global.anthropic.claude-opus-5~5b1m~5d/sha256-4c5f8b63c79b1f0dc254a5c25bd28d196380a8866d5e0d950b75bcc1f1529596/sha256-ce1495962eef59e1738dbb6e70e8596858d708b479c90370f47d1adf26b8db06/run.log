5\t    let mut bytes: tflac_u32;\n96\t\n97\t    // ((m->total) += (tflac_u64)(bits));\n98\t    let total = core::ptr::addr_of_mut!((*m).total);\n99\t    *total = (*total).wrapping_add(bits as tflac_u64);\n100\t\n101\t    // bytes = bits / 8;\n102\t    bytes = bits / 8;\n103\t\n104\t    let pos = core::ptr::addr_of_mut!((*m).pos);\n105\t    let buffer = core::ptr::addr_of_mut!((*m).buffer) as *mut tflac_u8;\n106\t\n107\t    // tflac_u32 pos2 = m->pos % 64;\n108\t    let pos2 = *pos % 64;\n109\t\n110\t    // tflac_pack_u64le(&m->buffer[pos2], val);\n111\t    tflac_pack_u64le(buffer.add(pos2 as usize), val);\n112\t\n113\t    // m->pos += bytes;\n114\t    *pos = (*pos).wrapping_add(bytes);\n115\t\n116\t    // if (m->pos >= 64) { ... }\n117\t    if *pos >= 64 {\n118\t        *pos %= 64;\n119\t        bytes = *pos;\n120\t        // while (bytes--) m->buffer[bytes] = m->buffer[64 + bytes];\n121\t        //\n122\t        // `bytes` is unsigned, so a zero counter skips the loop entirely\n123\t        // (the post-decrement wraparound is never observed).\n124\t        while bytes != 0 {\n125\t            bytes -= 1;\n126\t            *buffer.add(bytes as usize) = *buffer.add(64 + bytes as usize);\n127\t        }\n128\t    }\n129\t}\n130\t\n131\t/* ------------------------------------------------------------------ */\n132\t/* update_md5                                                          */\n133\t/* ------------------------------------------------------------------ */\n134\t\n135\t/// ```c\n136\t/// tflac_u32 update_md5(tflac *t, const tflac_s32 *samples);\n137\t/// ```\n138\t///\n139\t/// Packs eight sample low-bytes into one 64-bit word, feeds it to\n140\t/// `tflac_md5_addsample`, and repeats five times (`for (int i = 0; i <= 4;\n141\t/// i++)`), returning the remaining byte count.\n142\t///\n143\t/// Faithful details carried over from the C:\n144\t///   * `b` starts as `cur_blocksize * channels` (unsigned 32-bit wraparound).\n145\t///   * Each iteration subtracts `step == sizeof(tflac_uint) == 8` from `b`,\n146\t///     wrapping on underflow.\n147\t///   * `samples` advances by `8 * sizeof(tflac_s32) == 32` *elements* per\n148\t///     iteration (pointer arithmetic already scales by the element size), so\n149\t///     only the first 8 of every 32 samples are consumed.\n150\t///   * Each sample is sign-extended to 64 bits and then masked with `0xFF`,\n151\t///     i.e. only its lowest byte survives.\n152\t#[unsafe(no_mangle)]\n153\tpub unsafe extern \"C\" fn update_md5(t: *mut tflac, samples: *const tflac_s32) -> tflac_u32 {\n154\t    // tflac_u32 b = t->cur_blocksize * t->channels;\n155\t    let mut b: tflac_u32 = (*core::ptr::addr_of!((*t).cur_blocksize))\n156\t        .wrapping_mul(*core::ptr::addr_of!((*t).channels));\n157\t\n158\t    // const tflac_u32 step = sizeof(tflac_uint);\n159\t    let step: tflac_u32 = core::mem::size_of::<tflac_uint>() as tflac_u32;\n160\t\n161\t    let mut samples = samples;\n162\t    let md5_ctx = core::ptr::addr_of_mut!((*t).md5_ctx);\n163\t\n164\t    let mut i: i32 = 0;\n165\t    while i <= 4 {\n166\t        // Sign-extend to tflac_uint (u64) then keep the low byte, exactly as\n167\t        // `(((tflac_uint)samples[k]) & 0xFF) << (8 * k)` does in C.\n168\t        let s = |k: usize| -> tflac_uint { ((*samples.add(k)) as i64 as tflac_uint) & 0xFF };\n169\t\n170\t        let mut v: tflac_uint = s(0) << 0;\n171\t        v |= s(1) << 8;\n172\t        v |= s(2) << 16;\n173\t        v |= s(3) << 24;\n174\t        v |= s(4) << 32;\n175\t        v |= s(5) << 40;\n176\t        v |= s(6) << 48;\n177\t        v |= s(7) << 56;\n178\t\n179\t        // tflac_md5_addsample(&t->md5_ctx, (8 * sizeof(tflac_uint)), v);\n180\t        tflac_md5_addsample(\n181\t            md5_ctx,\n182\t            (8 * core::mem::size_of::<tflac_uint>()) as tflac_u32,\n183\t            v,\n184\t        );\n185\t\n186\t        // b -= step;\n187\t        b = b.wrapping_sub(step);\n188\t\n189\t        // samples += (8 * sizeof(tflac