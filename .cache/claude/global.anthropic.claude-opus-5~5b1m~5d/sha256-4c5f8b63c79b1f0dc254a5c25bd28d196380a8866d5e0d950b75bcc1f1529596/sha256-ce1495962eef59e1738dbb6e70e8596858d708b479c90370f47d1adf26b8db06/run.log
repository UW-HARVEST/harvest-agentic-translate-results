that behaviour. src/lib.rs is always\n# restored, including on interrupt/error.\nset -uo pipefail\ncd \"$(dirname \"$0\")\"\n\nSRC=src/lib.rs\nBAK=$(mktemp)\ncp \"$SRC\" \"$BAK\"\nrestore() { cp \"$BAK\" \"$SRC\"; rm -f \"$BAK\"; cargo build -q >/dev/null 2>&1; }\ntrap restore EXIT INT TERM\n\n# each entry: description :: literal-old :: literal-new\nMUTATIONS=(\n  \"loop runs 4 times instead of 5::while i <= 4 {::while i < 4 {\"\n  \"sample stride 8 elements instead of 32::samples.wrapping_add(8 * core::mem::size_of::<tflac_s32>())::samples.wrapping_add(8)\"\n  \"pos2 masked with 32 instead of 64::let pos2 = ld_u32(p_pos) % 64;::let pos2 = ld_u32(p_pos) % 32;\"\n  \"bits/4 instead of bits/8::bytes = bits / 8;::bytes = bits / 4;\"\n  \"spill test uses > 64 instead of >= 64::if pos >= 64 {::if pos > 64 {\"\n  \"spill source offset 65 instead of 64::ld_u8(buffer.wrapping_add(64usize.wrapping_add(bytes as usize)))::ld_u8(buffer.wrapping_add(65usize.wrapping_add(bytes as usize)))\"\n  \"byte 7 shifted by 55 instead of 56::st_u8(d.wrapping_add(7), (n >> 56) as tflac_u8);::st_u8(d.wrapping_add(7), (n >> 55) as tflac_u8);\"\n  \"b decremented by 4 instead of step::b = b.wrapping_sub(step);::b = b.wrapping_sub(4);\"\n  \"total accumulates bytes instead of bits::st_u64(p_total, ld_u64(p_total).wrapping_add(bits as tflac_u64));::st_u64(p_total, ld_u64(p_total).wrapping_add((bits / 8) as tflac_u64));\"\n  \"pos2 taken from the pre-total-update read order (skip second read)::let mut pos = ld_u32(p_pos).wrapping_add(bytes);::let mut pos = pos2.wrapping_add(bytes);\"\n  \"sample mask 0xFFFF instead of 0xFF::as i64 as tflac_uint) & 0xFF::as i64 as tflac_uint) \\& 0xFFFF\"\n  \"channels/blocksize fields swapped with addition::cur_blocksize.wrapping_mul(channels)::cur_blocksize.wrapping_add(channels)\"\n)\n\nfail=0\ni=0\nfor m in \"${MUTATIONS[@]}\"; do\n  i=$((i+1))\n  desc=${m%%::*}\n  rest=${m#*::}\n  old=${rest%%::*}\n  new=${rest#*::}\n\n  cp \"$BAK\" \"$SRC\"\n  python3 - \"$SRC\" \"$old\" \"$new\" <<'PY'\nimport sys\npath, old, new = sys.argv[1], sys.argv[2], sys.argv[3]\ns = open(path).read()\nif old not in s:\n    sys.stderr.write(\"MUTATION PATTERN NOT FOUND: %r\\n\" % old)\n    sys.exit(3)\nopen(path, \"w\").write(s.replace(old, new, 1))\nPY\n  if [ $? -ne 0 ]; then\n    echo \"[$i] SKIP (pattern not found): $desc\"\n    fail=1\n    continue\n  fi\n\n  if ! cargo build -q >/dev/null 2>&1; then\n    echo \"[$i] SKIP (mutant does not compile): $desc\"\n    fail=1\n    continue\n  fi\n  if cargo test -q >/dev/null 2>&1; then\n    echo \"[$i] NOT DETECTED (BAD): $desc\"\n    fail=1\n  else\n    echo \"[$i] detected: $desc\"\n  fi\ndone\n\ncp \"$BAK\" \"$SRC\"\ncargo build -q >/dev/null 2>&1\nif [ \"$fail\" -eq 0 ]; then\n  echo \"ALL ${#MUTATIONS[@]} MUTATIONS DETECTED\"\nelse\n  echo \"SOME MUTATIONS WERE NOT DETECTED\"\nfi\nexit \"$fail\"\n","userModified":false}}
