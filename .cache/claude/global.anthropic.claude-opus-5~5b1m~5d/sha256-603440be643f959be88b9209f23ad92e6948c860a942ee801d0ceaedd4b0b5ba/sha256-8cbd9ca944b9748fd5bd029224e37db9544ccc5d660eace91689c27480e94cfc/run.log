        0\n912\t                };\n913\t            }\n914\t            table = nt;\n915\t            (*stbds_header(a)).hash_table = table as *mut c_void;\n916\t        }\n917\t\n918\t        {\n919\t            let mut hash = if mode >= STBDS_HM_STRING {\n920\t                stbds_hash_string(key as *mut c_char, (*table).seed)\n921\t            } else {\n922\t                stbds_hash_bytes(key, keysize, (*table).seed)\n923\t            };\n924\t            let mut step = STBDS_BUCKET_LENGTH;\n925\t            let mut pos: usize;\n926\t            let mut tombstone: isize = -1;\n927\t            let mut bucket: *mut stbds_hash_bucket;\n928\t\n929\t            if hash < 2 {\n930\t                hash = hash.wrapping_add(2);\n931\t            }\n932\t\n933\t            pos = stbds_probe_position(hash, (*table).slot_count, (*table).slot_count_log2);\n934\t\n935\t            'found_empty_slot: loop {\n936\t                bucket = (*table).storage.add(pos >> STBDS_BUCKET_SHIFT);\n937\t\n938\t                let mut i = pos & STBDS_BUCKET_MASK;\n939\t                while i < STBDS_BUCKET_LENGTH {\n940\t                    if (*bucket).hash[i] == hash {\n941\t                        if stbds_is_key_equal(\n942\t                            raw_a,\n943\t                            elemsize,\n944\t                            key,\n945\t                            keysize,\n946\t                            keyoffset,\n947\t                            mode,\n948\t                            (*bucket).index[i],\n949\t                        ) != 0\n950\t                        {\n951\t                            stbds_set_temp(a, (*bucket).index[i]);\n952\t                            if mode >= STBDS_HM_STRING {\n953\t                                let src = byte_ptr(\n954\t                                    raw_a,\n955\t                                    (elemsize.wrapping_mul((*bucket).index[i] as usize))\n956\t                                        .wrapping_add(ke