t mut rest = bytes.clone();\n                    // blank out the pointer field: its numeric value legitimately\n                    // differs between the two heaps.\n                    for b in &mut rest[off..off + 8] {\n                        *b = 0;\n                    }\n                    elems.push((rest, key));\n                }\n                KeyKind::StringAtPair(o1, o2) => {\n                    let mut key: Option<Vec<u8>> = None;\n                    let mut rest = bytes.clone();\n                    for off in [o1, o2] {\n                        let kp = *(base.add(off) as *mut *mut c_char);\n                        if !kp.is_null() {\n                            let sv = read_cstr(kp);\n                            key = Some(match key {\n                                None => sv,\n                                Some(mut prev) => {\n                                    prev.push(b'|');\n                                    prev.extend_from_slice(&sv);\n                                    prev\n                                }\n                            });\n                        }\n                        for b in &mut rest[off..off + 8] {\n                            *b = 0;\n                        }\n                    }\n                    elems.push((rest, key));\n                }''')\nopen(p,'w').write(s)\n\np='tests/phase_b_del.rs'\ns=open(p).read()\ns=s.replace('let mut d = Driver::shmode(&s, elemsize, 8, KeyKind::StringAt(0), mode);\\n        let mut rng = Rng::new(0x38 + mode as u64);',\n            'let mut d = Driver::shmode(&s, elemsize, 8, KeyKind::StringAtPair(0, 8), mode);\\n        let mut rng = Rng::new(0x38 + mode as u64);')\nopen(p,'w').write(s)\nPY\ntimeout 600 cargo test --offline --release --test phase_b_del 2>&1 | tail -20","description":"Add StringAtPair key kind, rerun"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":984,"cache_read_input_tok