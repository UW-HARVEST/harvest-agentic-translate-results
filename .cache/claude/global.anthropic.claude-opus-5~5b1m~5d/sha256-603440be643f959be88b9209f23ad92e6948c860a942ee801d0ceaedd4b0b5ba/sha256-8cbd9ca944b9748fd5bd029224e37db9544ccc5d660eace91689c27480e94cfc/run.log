stbds_header(t) ((stbds_array_header *) (t) - 1)`\n166\t///\n167\t/// Wrapping arithmetic keeps the behaviour defined even for `t == NULL`, which\n168\t/// the C code does perform (e.g. `stbds_arrfreef(NULL)`).\n169\t#[inline]\n170\tfn stbds_header(t: *mut c_void) -> *mut stbds_array_header {\n171\t    (t as *mut u8).wrapping_sub(HEADER_SIZE) as *mut stbds_array_header\n172\t}\n173\t\n174\t/// `#define stbds_arrlen(a) ((a) ? (ptrdiff_t) stbds_header(a)->length : 0)`\n175\t#[inline]\n176\tunsafe fn stbds_arrlen(a: *mut c_void) -> isize {\n177\t    if a.is_null() {\n178\t        0\n179\t    } else {\n180\t        unsafe { (*stbds_header(a)).length as isize }\n181\t    }\n182\t}\n183\t\n184\t/// `#define stbds_arrcap(a) ((a) ? stbds_header(a)->capacity : 0)`\n185\t#[inline]\n186\tunsafe fn stbds_arrcap(a: *mut c_void) -> usize {\n187\t    if a.is_null() {\n188\t        0\n189\t    } else {\n190\t        unsafe { (*stbds_header(a)).capacity }\n191\t    }\n192\t}\n193\t\n194\t/// `#define stbds_temp(t) stbds_header(t)->temp`\n195\t#[inline]\n196\tunsafe fn stbds_temp(t: *mut c_void) -> isize {\n197\t    unsafe { (*stbds_header(t)).temp }\n198\t}\n199\t\n200\t#[inline]\n201\tunsafe fn stbds_set_temp(t: *mut c_void, v: isize) {\n202\t    unsafe {\n203\t        (*stbds_header(t)).temp = v;\n204\t    }\n205\t}\n206\t\n207\t/// `#define stbds_temp_key(t) (*(char **) stbds_header(t)->hash_table)`\n208\t#[inline]\n209\tunsafe fn stbds_temp_key(t: *mut c_void) -> *mut c_char {\n210\t    unsafe { *((*stbds_header(t)).hash_table as *mut *mut c_char) }\n211\t}\n212\t\n213\t#[inline]\n214\tunsafe fn stbds_set_temp_key(t: *mut c_void, v: *mut c_char) {\n215\t    unsafe {\n216\t        *((*stbds_header(t)).hash_table as *mut *mut c_char) = v;\n217\t    }\n218\t}\n219\t\n220\t/// `#define stbds_hash_table(a) ((stbds_hash_index *) stbds_header(a)->hash_table)`\n221\t#[inline]\n222\tunsafe fn stbds_hash_table(a: *mut c_void) -> *mut stbds_hash_index {\n223\t    unsafe { (*stbds_header(a)).hash_table as *mut stbds_hash_index }\n224\t}\n225\t\n226\t/// `#define STBDS_HASH_TO_ARR(x,elemsize) ((char *) (x) - (elemsize))`\n227\t#[inline]\n228\tfn stbds_hash_to_arr(x: *mut c_void, elemsize: usize) -> *mut c_void {\n229\t    (x as *mut u8).wrapping_sub(elemsize) as *mut c_void\n230\t}\n231\t\n232\t/// `#define STBDS_ARR_TO_HASH(x,elemsize) ((char *) (x) + (elemsize))`\n233\t#[inline]\n234\tfn stbds_arr_to_hash(x: *mut c_void, elemsize: usize) -> *mut c_void {\n235\t    (x as *mut u8).wrapping_add(elemsize) as *mut c_void\n236\t}\n237\t\n238\t#[inline]\n239\tfn byte_ptr(a: *mut c_void, off: usize) -> *mut u8 {\n240\t    (a as *mut u8).wrapping_add(off)\n241\t}\n242\t\n243\t// C library string/memory primitives, reimplemented so no extra dependency is\n244\t// needed.  Semantics are identical to the C originals.\n245\t#[inline]\n246\tunsafe fn c_strlen(s: *const c_char) -> usize {\n247\t    let mut n = 0usize;\n248\t    unsafe {\n249\t        while *s.add(n) != 0 {\n250\t            n += 1;\n251\t        }\n252\t    }\n253\t    n\n254\t}\n255\t\n256\t#[inline]\n257\tunsafe fn c_strcmp_eq(a: *const c_char, b: *const c_char) -> bool {\n258\t    let mut i = 0usize;\n259\t    unsafe {\n260\t        loop {\n261\t            let ca = *a.add(i) as u8;\n262\t            let cb = *b.add(i) as u8;\n263\t            if ca != cb {\n264\t                return false;\n265\t            }\n266\t            if ca == 0 {\n267\t                return true;\n268\t            }\n269\t            i += 1;\n270\t        }\n271\t    }\n272\t}\n273\t\n274\t#[inline]\n275\tunsafe fn c_memcmp_eq(a: *const u8, b: *const u8, n: usize) -> bool {\n276\t    let mut i = 0usize;\n277\t    unsafe {\n278\t        while i < n {\n279\t            if *a.add(i) != *b.add(i) {\n280\t                return false;\n281\t            }\n282\t            i += 1;\n283\t        }\n284\t    }\n285\t    true\n286\t}\n287\t\n288\t#[inline]\n289\tunsafe fn c_memmove(dst: *mut u8, src: *const u8, n: usize) {\n290\t    unsafe { ptr::copy(src, dst, n) }\n291\t}\n292\t\n293\t#[inline]\n294\tunsafe fn c_memcpy(dst: *mut u8, src: *const u8, n: usize) {\n295\t    unsafe { ptr::copy_nonoverlapping(src, dst, n) }\n296\t}\n297\t\n298\t#[inline]\n299\tunsafe fn c_memset0(dst: *mut u8, n: usize) {\n300\t    unsafe { ptr::write_bytes(dst, 0, n) }\n301\t}\n302\t\n303\t// ---------------------------------------------------------------------------\n304\t// stbds_arrgrowf / stbds_arrfreef\n305\t// ---------------------------------------------------------------------------\n306\t\n307\t#[unsafe(no_mangle)]\n308\tpub unsafe extern \"C\" fn stbds_arrgrowf(\n309\t    a: *mut c_void,\n310\t    elemsize: usize,\n311\t    addlen: usize,\n312\t    min_cap: usize,\n313\t) -> *mut c_void {\n314\t    unsafe {\n315\t        let mut min_cap = min_cap;\n316\t        let b: *mut c_void;\n317\t        // size_t min_len = stbds_arrlen(a) + addlen;\n318\t        let min_len = (stbds_arrlen(a) as usize).wrapping_add(addlen);\n319\t\n320\t        if min_len > min_cap {\n321\t            min_cap = min_len;\n322\t        }\n323\t\n324\t        if min_cap <= stbds_arrcap(a) {\n325\t            return a;\n326\t        }\n327\t\n328\t        if min_cap < 2usize.wrapping_mul(stbds_arrcap(a)) {\n329\t            min_cap = 2usize.wrapping_mul(stbds_arrcap(a));\n330\t        } else if min_cap < 4 {\n331\t            min_cap = 4;\n332\t        }\n333\t\n334\t        let old = if a.is_null() {\n335\t            ptr::null_mut()\n336\t        } else {\n337\t            stbds_header(a) as *mut c_void\n338\t        };\n339\t        b = stbds_realloc(\n340\t            old,\n341\t            elemsize.wrapping_mul(min_cap).wrapping_add(HEADER_SIZE),\n342\t        );\n343\t        let b = (b as *mut u8).wrapping_add(HEADER_SIZE) as *mut c_void;\n344\t        if a.is_null() {\n345\t            (*stbds_header(b)).length = 0;\n346\t            (*stbds_header(b)).hash_table = ptr::null_mut();\n347\t            (*stbds_header(b)).temp = 0;\n348\t        } else {\n349\t            // STBDS_STATS(++stbds_array_grow) -- compiled out\n350\t        }\n351\t        (*stbds_header(b)).capacity = min_cap;\n352\t\n353\t        b\n354\t    }\n355\t}\n356\t\n357\t#[unsafe(no_mangle)]\n358\tpub unsafe extern \"C\" fn stbds_arrfreef(a: *mut c_void) {\n359\t    unsafe {\n360\t        stbds_free(stbds_header(a) as *mut c_void);\n361\t    }\n362\t}\n363\t\n364\t// ---------------------------------------------------------------------------\n365\t// Hash seed / hash index construction\n366\t// ---------------------------------------------------------------------------\n367\t\n368\tstatic mut stbds_hash_seed: usize = 0x31415926;\n369\t\n370\t#[unsafe(no_mangle)]\n371\tpub unsafe extern \"C\" fn stbds_rand_seed(seed: usize) {\n372\t    unsafe {\n373\t        stbds_hash_seed = seed;\n374\t    }\n375\t}\n376\t\n377\t/// ```c\n378\t/// static size_t stbds_probe_position(size_t hash, size_t slot_count, size_t slot_log2)\n379\t/// ```\n380\t#[inline]\n381\tfn stbds_probe_position(hash: usize, slot_count: usize, _slot_log2: usize) -> usize {\n382\t    hash & (slot_count.wrapping_sub(1))\n383\t}\n384\t\n385\t/// ```c\n386\t/// static size_t stbds_log2(size_t slot_count)\n387\t/// ```\n388\tfn stbds_log2(slot_count: usize) -> usize {\n389\t    let mut slot_count = slot_count;\n390\t    let mut n = 0usize;\n391\t    while slot_count > 1 {\n392\t        slot_count >>= 1;\n393\t        n += 1;\n394\t    }\n395\t    n\n396\t}\n397\t\n398\tunsafe fn stbds_make_hash_index(\n399\t    slot_count: usize,\n400\t    ot: *mut stbds_hash_index,\n401\t) -> *mut stbds_hash_index {\n402\t    unsafe {\n403\t        let t = stbds_realloc(\n404\t            ptr::null_mut(),\n405\t            (slot_count >> STBDS_BUCKET_SHIFT)\n406\t                .wrapping_mul(size_of::<stbds_hash_bucket>())\n407\t                .wrapping_add(size_of::<stbds_hash_index>())\n408\t                .wrapping_add(STBDS_CACHE_LINE_SIZE - 1),\n409\t        ) as *mut stbds_hash_index;\n410\t\n411\t        (*t).storage = stbds_align_fwd(\n412\t            (t as *mut u8).wrapping_add(size_of::<stbds_hash_index>()) as usize,\n413\t            STBDS_CACHE_LINE_SIZE,\n414\t        ) as *mut stbds_hash_bucket;\n415\t        (*t).slot_count = slot_count;\n416\t        (*t).slot_count_log2 = stbds_log2(slot_count);\n417\t        (*t).tombstone_count = 0;\n418\t        (*t).used_count = 0;\n419\t\n420\t        (*t).used_count_threshold = slot_count.wrapping_sub(slot_count >> 2);\n421\t        (*t).tombstone_count_threshold = (slot_count >> 3).wrapping_add(slot_count >> 4);\n422\t        (*t).used_count_shrink_threshold = slot_count >> 2;\n423\t\n424\t        if slot_count <= STBDS_BUCKET_LENGTH {\n425\t            (*t).used_count_shrink_threshold = 0;\n426\t        }\n427\t        stbds_assert!(\n428\t            (*t).used_count_threshold + (*t).tombstone_count_threshold < (*t).slot_count\n429\t        );\n430\t\n431\t        if !ot.is_null() {\n432\t            (*t).string = (*ot).string;\n433\t            (*t).seed = (*ot).seed;\n434\t        } else {\n435\t            c_memset0(\n436\t                (&raw mut (*t).string) as *mut u8,\n437\t                size_of::<stbds_string_arena>(),\n438\t            );\n439\t            (*t).seed = stbds_hash_seed;\n440\t            // stbds_load_32_or_64(a,temp, 2147001325, 0x27bb2ee6, 0x87b0b0fd);\n441\t            // stbds_load_32_or_64(b,temp,  715136305,          0, 0xb504f32d);\n442\t            // -> on a 64-bit size_t these evaluate to (hi << 32) | lo.\n443\t            let a: usize = 0x27bb2ee6_87b0b0fd;\n444\t            let b: usize = 0x00000000_b504f32d;\n445\t            stbds_hash_seed = stbds_hash_seed.wrapping_mul(a).wrapping_add(b);\n446\t        }\n447\t\n448\t        {\n449\t            let mut i = 0usize;\n450\t            while i < slot_count >> STBDS_BUCKET_SHIFT {\n451\t                let bucket = (*t).storage.add(i);\n452\t                for j in 0..STBDS_BUCKET_LENGTH {\n453\t                    (*bucket).hash[j] = STBDS_HASH_EMPTY;\n454\t                }\n455\t                for j in 0..STBDS_BUCKET_LENGTH {\n456\t                    (*bucket).index[j] = STBDS_INDEX_EMPTY;\n457\t                }\n458\t                i += 1;\n459\t            }\n460\t        }\n461\t\n462\t        if !ot.is_null() {\n463\t            (*t).used_count = (*ot).used_count;\n464\t            let mut i = 0usize;\n465\t            while i < (*ot).slot_count >> STBDS_BUCKET_SHIFT {\n466\t                let ob = (*ot).storage.add(i);\n467\t                for j in 0..STBDS_BUCKET_LENGTH {\n468\t                    if stbds_index_in_use((*ob).index[j]) {\n469\t                        let hash = (*ob).hash[j];\n470\t                        let mut pos =\n471\t                            stbds_probe_position(hash, (*t).slot_count, (*t).slot_count_log2);\n472\t                        let mut step = STBDS_BUCKET_LENGTH;\n473\t                        'done: loop {\n474\t                            let bucket = (*t).storage.add(pos >> STBDS_BUCKET_SHIFT);\n475\t\n476\t                            let mut z = pos & STBDS_BUCKET_MASK;\n477\t                            while z < STBDS_BUCKET_LENGTH {\n478\t                                if (*bucket).hash[z] == 0 {\n479\t                                    (*bucket).hash[z] = hash;\n480\t                                    (*bucket).index[z] = (*ob).index[j];\n481\t                                    break 'done;\n482\t                                }\n483\t                                z += 1;\n484\t                            }\n485\t\n486\t                            let limit = pos & STBDS_BUCKET_MASK;\n487\t                            let mut z = 0usize;\n488\t                            let mut placed = false;\n489\t                            while z < limit {\n490\t                                if (*bucket).hash[z] == 0 {\n491\t                                    (*bucket).hash[z] = hash;\n492\t                                    (*bucket).index[z] = (*ob).index[j];\n493\t                                    placed = true;\n494\t                                    break;\n495\t                                }\n496\t                                z += 1;\n497\t                            }\n498\t                            if placed {\n499\t                                break 'done;\n500\t                            }\n501\t\n502\t                            pos = pos.wrapping_add(step);\n503\t                            step = step.wrapping_add(STBDS_BUCKET_LENGTH);\n504\t                            pos &= (*t).slot_count.wrapping_sub(1);\n505\t                        }\n506\t                    }\n507\t                }\n508\t                i += 1;\n509\t            }\n510\t        }\n511\t\n512\t        t\n513\t    }\n514\t}\n515\t\n516\t// ---------------------------------------------------------------------------\n517\t// Hash functions\n518\t// ---------------------------------------------------------------------------\n519\t\n520\tconst STBDS_SIZE_T_BITS: u32 = (size_of::<usize>() * 8) as u32;\n521\t\n522\t/// `#define STBDS_ROTATE_LEFT(val, n) (((val) << (n)) | ((val) >> (BITS - (n))))`\n523\t#[inline]\n524\tfn rotl(val: usize, n: u32) -> usize {\n525\t    (val << n) | (val >> (STBDS_SIZE_T_BITS - n))\n526\t}\n527\t\n528\t/// `#define STBDS_ROTATE_RIGHT(val, n) (((val) >> (n)) | ((val) << (BITS - (n))))`\n529\t#[inline]\n530\tfn rotr(val: usize, n: u32) -> usize {\n531\t    (val >> n) | (val << (STBDS_SIZE_T_BITS - n))\n532\t}\n533\t\n534\t#[unsafe(no_mangle)]\n535\tpub unsafe extern \"C\" fn stbds_hash_string(str_: *mut c_char, seed: usize) -> usize {\n536\t    unsafe {\n537\t        let mut hash = seed;\n538\t        let mut s = str_ as *const u8;\n539\t        while *s != 0 {\n540\t            hash = rotl(hash, 9).wrapping_add(*s as usize);\n541\t            s = s.add(1);\n542\t        }\n543\t\n544\t        hash ^= seed;\n545\t        hash = (!hash).wrapping_add(hash << 18);\n546\t        hash ^= hash ^ rotr(hash, 31);\n547\t        hash = hash.wrapping_mul(21);\n548\t        hash ^= hash ^ rotr(hash, 11);\n549\t        hash = hash.wrapping_add(hash << 6);\n550\t        hash ^= rotr(hash, 22);\n551\t        hash.wrapping_add(seed)\n552\t    }\n553\t}\n554\t\n555\tconst STBDS_SIPHASH_C_ROUNDS: usize = 2;\n556\tconst STBDS_SIPHASH_D_ROUNDS: usize = 4;\n557\t\n558\tmacro_rules! siphash_round {\n559\t    ($v0:expr, $v1:expr, $v2:expr, $v3:expr) => {{\n560\t        $v0 = $v0.wrapping_add($v1);\n561\t        $v1 = rotl($v1, 13);\n562\t        $v1 ^= $v0;\n563\t        $v0 = rotl($v0, STBDS_SIZE_T_BITS / 2);\n564\t        $v2 = $v2.wrapping_add($v3);\n565\t        $v3 = rotl($v3, 16);\n566\t        $v3 ^= $v2;\n567\t        $v2 = $v2.wrapping_add($v1);\n568\t        $v1 = rotl($v1, 17);\n569\t        $v1 ^= $v2;\n570\t        $v2 = rotl($v2, STBDS_SIZE_T_BITS / 2);\n571\t        $v0 = $v0.wrapping_add($v3);\n572\t        $v3 = rotl($v3, 21);\n573\t        $v3 ^= $v0;\n574\t    }};\n575\t}\n576\t\n577\tunsafe fn stbds_siphash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n578\t    unsafe {\n579\t        let mut d = p as *const u8;\n580\t        let mut data: usize;\n581\t\n582\t        let mut v0 = (((0x736f6d65usize << 16) << 16).wrapping_add(0x70736575)) ^ seed;\n583\t        let mut v1 = (((0x646f7261usize << 16) << 16).wrapping_add(0x6e646f6d)) ^ !seed;\n584\t        let mut v2 = (((0x6c796765usize << 16) << 16).wrapping_add(0x6e657261)) ^ seed;\n585\t        let mut v3 = (((0x74656462usize << 16) << 16).wrapping_add(0x79746573)) ^ !seed;\n586\t\n587\t        v0 ^= 0x0706050403020100usize ^ seed;\n588\t        v1 ^= 0x0f0e0d0c0b0a0908usize ^ !seed;\n589\t        v2 ^= 0x0706050403020100usize ^ seed;\n590\t        v3 ^= 0x0f0e0d0c0b0a0908usize ^ !seed;\n591\t\n592\t        let mut i = 0usize;\n593\t        while i + size_of::<usize>() <= len {\n594\t            // The C source builds the low half with `int` arithmetic:\n595\t            //   data = d[0] | (d[1] << 8) | (d[2] << 16) | (d[3] << 24);\n596\t            // which becomes a *negative int* when d[3] >= 0x80 and is therefore\n597\t            // sign-extended when stored into the size_t.  Reproduced verbatim.\n598\t            let lo: i32 = (*d.add(0) as i32)\n599\t                | ((*d.add(1) as i32) << 8)\n600\t                | ((*d.add(2) as i32) << 16)\n601\t                | ((*d.add(3) as i32) << 24);\n602\t            data = lo as isize as usize;\n603\t            let hi: i32 = (*d.add(4) as i32)\n604\t                | ((*d.add(5) as i32) << 8)\n605\t                | ((*d.add(6) as i32) << 16)\n606\t                | ((*d.add(7) as i32) << 24);\n607\t            data |= ((hi as isize as usize) << 16) << 16; // discarded if size_t == 4\n608\t\n609\t            v3 ^= data;\n610\t            for _ in 0..STBDS_SIPHASH_C_ROUNDS {\n611\t                siphash_round!(v0, v1, v2, v3);\n612\t            }\n613\t            v0 ^= data;\n614\t\n615\t            i += size_of::<usize>();\n616\t            d = d.add(size_of::<usize>());\n617\t        }\n618\t        data = len << (STBDS_SIZE_T_BITS - 8);\n619\t        // switch (len - i) with fall-through from 7 down to 0.\n620\t        let rem = len - i;\n621\t        if rem >= 7 {\n622\t            data |= ((*d.add(6) as usize) << 24) << 24;\n623\t        }\n624\t        if rem >= 6 {\n625\t            data |= ((*d.add(5) as usize) << 20) << 20;\n626\t        }\n627\t        if rem >= 5 {\n628\t            data |= ((*d.add(4) as usize) << 16) << 16;\n629\t        }\n630\t        if rem >= 4 {\n631\t            // `data |= (d[3] << 24);` -- int arithmetic, sign-extended.\n632\t            data |= ((*d.add(3) as i32) << 24) as isize as usize;\n633\t        }\n634\t        if rem >= 3 {\n635\t            data |= ((*d.add(2) as i32) << 16) as isize as usize;\n636\t        }\n637\t        if rem >= 2 {\n638\t            data |= ((*d.add(1) as i32) << 8) as isize as usize;\n639\t        }\n640\t        if rem >= 1 {\n641\t            data |= (*d.add(0) as i32) as isize as usize;\n642\t        }\n643\t\n644\t        v3 ^= data;\n645\t        for _ in 0..STBDS_SIPHASH_C_ROUNDS {\n646\t            siphash_round!(v0, v1, v2, v3);\n647\t        }\n648\t        v0 ^= data;\n649\t        v2 ^= 0xff;\n650\t        for _ in 0..STBDS_SIPHASH_D_ROUNDS {\n651\t            siphash_round!(v0, v1, v2, v3);\n652\t        }\n653\t\n654\t        v0 ^ v1 ^ v2 ^ v3\n655\t    }\n656\t}\n657\t\n658\t#[unsafe(no_mangle)]\n659\tpub unsafe extern \"C\" fn stbds_hash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n660\t    unsafe { stbds_siphash_bytes(p, len, seed) }\n661\t}\n662\t\n663\t// ---------------------------------------------------------------------------\n664\t// Hash map internals\n665\t// ---------------------------------------------------------------------------\n666\t\n667\tunsafe fn stbds_is_key_equal(\n668\t    a: *mut c_void,\n669\t    elemsize: usize,\n670\t    key: *mut c_void,\n671\t    keysize: usize,\n672\t    keyoffset: usize,\n673\t    mode: c_int,\n674\t    i: isize,\n675\t) -> c_int {\n676\t    unsafe {\n677\t        let slot = (a as *mut u8)\n678\t            .wrapping_offset((elemsize as isize).wrapping_mul(i))\n679\t            .wrapping_add(keyoffset);\n680\t        if mode >= STBDS_HM_STRING {\n681\t            (c_strcmp_eq(key as *const c_char, *(slot as *mut *mut c_char)) as c_int) as c_int\n682\t        } else {\n683\t            c_memcmp_eq(key as *const u8, slot as *const u8, keysize) as c_int\n684\t        }\n685\t    }\n686\t}\n687\t\n688\t#[unsafe(no_mangle)]\n689\tpub unsafe extern \"C\" fn stbds_hmfree_func(a: *mut c_void, elemsize: usize) {\n690\t    unsafe {\n691\t        if a.is_null() {\n692\t            return;\n693\t        }\n694\t        if !stbds_hash_table(a).is_null() {\n695\t            if (*stbds_hash_table(a)).string.mode == STBDS_SH_STRDUP as u8 {\n696\t           