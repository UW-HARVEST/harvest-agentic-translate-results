 repro -- --nocapture 2>&1 | tail -20","description":"Exact c22 repro"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1659,"cache_read_input_tokens":143869,"cache_creation":{"ephemeral_5m_input_tokens":1659,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"61429b9a-98bc-4cd1-a4df-564ad02270a3","uuid":"a76b2646-7daa-4113-ad96-54f020cbb8cb","timestamp":"2026-09-05T11:40:04.447Z"}
