            *temp = STBDS_INDEX_EMPTY;\n804\t            stbds_arr_to_hash(a, elemsize)\n805\t        } else {\n806\t            let raw_a = stbds_hash_to_arr(a, elemsize);\n807\t            let table = (*stbds_header(raw_a)).hash_table as *mut stbds_hash_index;\n808\t            if table.is_null() {\n809\t                *temp = -1;\n810\t            } else {\n811\t                let slot = stbds_hm_find_slot(a, elemsize, key, keysize, keyoffset, mode);\n812\t                if slot < 0 {\n813\t                    *temp = STBDS_INDEX_EMPTY;\n814\t                } else {\n815\t                    let b = (*table).storage.offset(slot >> STBDS_BUCKET_SHIFT);\n816\t                    *temp = (*b).index[(slot as usize) & STBDS_BUCKET_MASK];\n817\t                }\n818\t            }\n819\t            a\n820\t        }\n821\t    }\n822\t}\n823\t\n824\t#[unsafe(no_mangle)]\n825\tpub unsafe extern \"C\" fn stbds_hmget_key(\n826\t    a: *mut c_void,\n827\t    elemsize: usize,\n828\t    key: *mut c_void,\n829\t    keysize: usize,\n830\t    mode: c_int,\n831\t) -> *mut c_void {\n832\t    unsafe {\n833\t        let mut temp: isize = 0;\n834\t        let p = stbds_hmget_key_ts(a, elemsize, key, keysize, &mut temp, mode);\n835\t        stbds_set_temp(stbds_hash_to_arr(p, elemsize), temp);\n836\t        p\n837\t    }\n838\t}\n839\t\n840\t#[unsafe(no_mangle)]\n841\tpub unsafe extern \"C\" fn stbds_hmput_default(a: *mut c_void, elemsize: usize) -> *mut c_void {\n842\t    unsafe {\n843\t        let mut a = a;\n844\t        if a.is_null() || (*stbds_header(stbds_hash_to_arr(a, elemsize))).length == 0 {\n845\t            a = stbds_arrgrowf(\n846\t                if !a.is_null() {\n847\t                    stbds_hash_to_arr(a, elemsize)\n848\t                } else {\n849\t                    ptr::null_mut()\n850\t                },\n851\t                elemsize,\n852\t                0,\n853\t                1,\n854\t            );\n855\t            (*stbds_header(a)).length += 1