2\t    // char raw[sizeof(x)]; memcpy(raw, &x, sizeof(x));\n43\t    let raw: [u8; 4] = x.to_ne_bytes();\n44\t    print_hex(out, &raw, raw.len());\n45\t}\n46\t\n47\t// ---------------------------------------------------------------------------\n48\t// scanf(\"%f\", &x) emulation\n49\t// ---------------------------------------------------------------------------\n50\t\n51\t#[derive(Copy, Clone, PartialEq, Eq)]\n52\tenum St {\n53\t    Start,\n54\t    Sign,\n55\t    Zero,\n56\t    Int,\n57\t    Dot,\n58\t    LeadDot,\n59\t    Frac,\n60\t    E,\n61\t    ESign,\n62\t    Exp,\n63\t    HexPrefix,\n64\t    HexInt,\n65\t    HexDot,\n66\t    HexLeadDot,\n67\t    HexFrac,\n68\t    P,\n69\t    PSign,\n70\t    PExp,\n71\t    I,\n72\t    In,\n73\t    Inf,\n74\t    Infi,\n75\t    Infin,\n76\t    Infini,\n77\t    Infinit,\n78\t    Infinity,\n79\t    N,\n80\t    Na,\n81\t    Nan,\n82\t    NanOpen,\n83\t    NanClose,\n84\t}\n85\t\n86\tfn is_digit(c: u8) -> bool {\n87\t    c.is_ascii_digit()\n88\t}\n89\t\n90\tfn is_hex(c: u8) -> bool {\n91\t    c.is_ascii_hexdigit()\n92\t}\n93\t\n94\tfn accepting(s: St) -> bool {\n95\t    matches!(\n96\t        s,\n97\t        St::Zero\n98\t            | St::Int\n99\t            | St::Dot\n100\t            | St::Frac\n101\t            | St::Exp\n102\t            | St::HexInt\n103\t            | St::HexDot\n104\t            | St::HexFrac\n105\t            | St::PExp\n106\t            | St::Inf\n107\t            | St::Infinity\n108\t            | St::Nan\n109\t            | St::NanClose\n110\t    )\n111\t}\n112\t\n113\t/// Transition of the \"expected form of a floating point subject sequence\" DFA\n114\t/// (as described by C's strtof / scanf %f). Returns `None` when the character\n115\t/// cannot continue any valid prefix.\n116\tfn step(s: St, c: u8) -> Option<St> {\n117\t    let lc = c.to_ascii_lowercase();\n118\t    Some(match s {\n119\t        St::Start | St::Sign => match lc {\n120\t            b'+' | b'-' if s == St::Start => St::Sign,\n121\t            b'0' => St::Zero,\n122\t            b'1'..=b'9' => St::Int,\n123\t            b'.' => St::LeadDot,\n124\t            b'i' => St::I,\n125\t            b'n' => St::N,\n126\t            _ => return None,\n127\t        },\n128\t        St::Zero => match lc {\n129\t            b'x' => St::HexPrefix,\n130\t            b'.' => St::Dot,\n131\t            b'e' => St::E,\n132\t            _ if is_digit(c) => St::Int,\n133\t            _ => return None,\n134\t        },\n135\t        St::Int => match lc {\n136\t            b'.' => St::Dot,\n137\t            b'e' => St::E,\n138\t            _ if is_digit(c) => St::Int,\n139\t            _ => return None,\n140\t        },\n141\t        St::Dot => match lc {\n142\t            b'e' => St::E,\n143\t            _ if is_digit(c) => St::Frac,\n144\t            _ => return None,\n145\t        },\n146\t        St::LeadDot => {\n147\t            if is_digit(c) {\n148\t                St::Frac\n149\t            } else {\n150\t                return None;\n151\t            }\n152\t        }\n153\t        St::Frac => match lc {\n154\t            b'e' => St::E,\n155\t            _ if is_digit(c) => St::Frac,\n156\t            _ => return None,\n157\t        },\n158\t        St::E => match lc {\n159\t            b'+' | b'-' => St::ESign,\n160\t            _ if is_digit(c) => St::Exp,\n161\t            _ => return None,\n162\t        },\n163\t        St::ESign | St::Exp => {\n164\t            if is_digit(c) {\n165\t                St::Exp\n166\t            } else {\n167\t                return None;\n168\t            }\n169\t        }\n170\t        St::HexPrefix => {\n171\t            if is_hex(c) {\n172\t                St::HexInt\n173\t            } else if c == b'.' {\n174\t                St::HexLeadDot\n175\t            } else {\n176\t                return None;\n177\t            }\n178\t        }\n179\t        St::HexInt => {\n180\t            if is_hex(c) {\n181\t                St::HexInt\n182\t            } else if c == b'.' {\n183\t                St::HexDot\n184\t            } else if lc == b'p' {\n185\t                St::P\n186\t            } else {\n187\t                return None;\n188\t            }\n189\t        }\n190\t        St::HexDot => {\n191\t            if is_hex(c) {\n192\t                St::HexFrac\n193\t            } else if lc == b'p' {\n194\t                St::P\n195\t            } else {\n196\t                return None;\n197\t            }\n198\t        }\n199\t        St::HexLeadDot => {\n200\t            if is_hex(c) {\n201\t                St::HexFrac\n202\t            } else {\n203\t                return None;\n204\t            }\n205\t        }\n206\t        St::HexFrac => {\n207\t            if is_hex(c) {\n208\t                St::HexFrac\n209\t            } else if lc == b'p' {\n210\t                St::P\n211\t            } else {\n212\t                return None;\n213\t            }\n214\t        }\n215\t        St::P => match lc {\n216\t            b'+' | b'-' => St::PSign,\n217\t            _ if is_digit(c) => St::PExp,\n218\t            _ => return None,\n219\t        },\n220\t        St::PSign | St::PExp => {\n221\t            if is_digit(c) {\n222\t                St::PExp\n223\t            } else {\n224\t                return None;\n225\t            }\n226\t        }\n227\t        St::I => {\n228\t            if lc == b'n' {\n229\t                St::In\n230\t            } else {\n231\t                return None;\n232\t            }\n233\t        }\n234\t        St::In => {\n235\t            if lc == b'f' {\n236\t                St::Inf\n237\t            } else {\n238\t                return None;\n239\t            }\n240\t        }\n241\t        St::Inf => {\n242\t            if lc == b'i' {\n243\t                St::Infi\n244\t            } else {\n245\t                return None;\n246\t            }\n247\t        }\n248\t        St::Infi => {\n249\t            if lc == b'n' {\n250\t                St::Infin\n251\t            } else {\n252\t                return None;\n253\t            }\n254\t        }\n255\t        St::Infin => {\n256\t            if lc == b'i' {\n257\t                St::Infini\n258\t            } else {\n259\t                return None;\n260\t            }\n261\t        }\n262\t        St::Infini => {\n263\t            if lc == b't' {\n264\t                St::Infinit\n265\t            } else {\n266\t                return None;\n267\t            }\n268\t        }\n269\t        St::Infinit => {\n270\t            if lc == b'y' {\n271\t                St::Infinity\n272\t            } else {\n273\t                return None;\n274\t            }\n275\t        }\n276\t        St::N => {\n277\t            if lc == b'a' {\n278\t                St::Na\n279\t            } else {\n280\t                return None;\n281\t            }\n282\t        }\n283\t        St::Na => {\n284\t            if lc == b'n' {\n285\t                St::Nan\n286\t            } else {\n287\t                return None;\n288\t            }\n289\t        }\n290\t        St::Nan => {\n291\t            if c == b'(' {\n292\t                St::NanOpen\n293\t            } else {\n294\t                return None;\n295\t            }\n296\t        }\n297\t        St::NanOpen => {\n298\t            if c == b')' {\n299\t                St::NanClose\n300\t            } else if c.is_ascii_alphanumeric() || c == b'_' {\n301\t                St::NanOpen\n302\t            } else {\n303\t                return None;\n304\t            }\n305\t        }\n306\t        St::Infinity | St::NanClose => return None,\n307\t    })\n308\t}\n309\t\n310\tstruct ByteReader<R: Read> {\n311\t    inner: R,\n312\t}\n313\t\n314\timpl<R: Read> ByteReader<R> {\n315\t    fn next_byte(&mut self) -> Option<u8> {\n316\t        let mut b = [0u8; 1];\n317\t        loop {\n318\t            match self.inner.read(&mut b) {\n319\t                Ok(0) => return None,\n320\t                Ok(_) => return Some(b[0]),\n321\t                Err(ref e) if e.kind() == std::io::ErrorKind::Interrupted => continue,\n322\t                Err(_) => return None,\n323\t            }\n324\t        }\n325\t    }\n326\t}\n327\t\n328\t/// Emulates `scanf(\"%f\", &x)`: returns `Some(value)` on a successful\n329\t/// conversion, `None` on matching failure or EOF (in which case the C code\n330\t/// leaves `x` untouched).\n331\tfn scan_float<R: Read>(r: &mut ByteReader<R>) -> Option<f32> {\n332\t    // %f skips leading white space (isspace).\n333\t    let mut c = loop {\n334\t        let c = r.next_byte()?;\n335\t        if !matches!(c, b' ' | b'\\t' | b'\\n' | b'\\r' | 0x0b | 0x0c) {\n336\t            break c;\n337\t        }\n338\t    };\n339\t\n340\t    let mut buf: Vec<u8> = Vec::new();\n341\t    let mut state = St::Start;\n342\t    let mut valid_len = 0usize;\n343\t\n344\t    loop {\n345\t        match step(state, c) {\n346\t            Some(next) => {\n347\t                buf.push(c);\n348\t                state = next;\n349\t                if accepting(state) {\n350\t                    valid_len = buf.len();\n351\t                }\n352\t            }\n353\t            None => break,\n354\t        }\n355\t        match r.next_byte() {\n356\t            Some(n) => c = n,\n357\t            None => break,\n358\t        }\n359\t    }\n360\t\n361\t    // glibc's scanf can only push back a single character. Once it has seen\n362\t    // \"inf\" followed by an 'i' it commits to matching the rest of \"infinity\";\n363\t    // if that fails the whole conversion fails (rather than falling back to\n364\t    // the \"inf\" prefix the way strtof would).\n365\t    if matches!(state, St::Infi | St::Infin | St::Infini | St::Infinit) {\n366\t        return None;\n367\t    }\n368\t\n369\t    if valid_len == 0 {\n370\t        return None;\n371\t    }\n372\t    Some(convert(&buf[..valid_len]))\n373\t}\n374\t\n375\tfn scale_pow2(mut x: f64, mut n: i64) -> f64 {\n376\t    // 2^512 and 2^-512 as exact f64 values.\n377\t    let up = f64::from_bits(((1023i64 + 512) as u64) << 52);\n378\t    let down = f64::from_bits(((1023i64 - 512) as u64) << 52);\n379\t    while n > 512 {\n380\t        x *= up;\n381\t        n -= 512;\n382\t    }\n383\t    while n < -512 {\n384\t        x *= down;\n385\t        n += 512;\n386\t    }\n387\t    // For -512 <= n <= 512, 2^n is an exactly representable normal f64.\n388\t    x * f64::from_bits(((1023i64 + n) as u64) << 52)\n389\t}\n390\t\n391\tfn convert(s: &[u8]) -> f32 {\n392\t    let mut i = 0usize;\n393\t    let mut neg = false;\n394\t    if i < s.len() && (s[i] == b'+' || s[i] == b'-') {\n395\t        neg = s[i] == b'-';\n396\t        i += 1;\n397\t    }\n398\t    let body = &s[i..];\n399\t    let lower: Vec<u8> = body.iter().map(|c| c.to_ascii_lowercase()).collect();\n400\t\n401\t    let value: f32 = if lower.starts_with(b\"inf\") {\n402\t        f32::INFINITY\n403\t    } else if lower.starts_with(b\"nan\") {\n404\t        f32::NAN\n405\t    } else if lower.starts_with(b\"0x\") {\n406\t        hex_to_f32(&lower[2..])\n407\t    } else {\n408\t        dec_to_f32(&lower)\n409\t    };\n410\t\n411\t    if neg {\n412\t        -value\n413\t    } else {\n414\t        value\n415\t    }\n416\t}\n417\t\n418\tfn dec_to_f32(s: &[u8]) -> f32 {\n419\t    // Normalize the shapes Rust's parser does not accept (\"1.\", \"1.e5\").\n420\t    let (mant, exp) = match s.iter().position(|&c| c == b'e') {\n421\t        Some(p) => (&s[..p], Some(&s[p..])),\n422\t        None => (s, None),\n423\t    };\n424\t    let mut out = String::new();\n425\t    let mant_str = std::str::from_utf8(mant).unwrap_or(\"0\");\n426\t    let trimmed = mant_str.trim_end_matches('.');\n427\t    out.push_str(if trimmed.is_empty() { \"0\" } else { trimmed });\n428\t    if let Some(e) = exp {\n429\t        out.push_str(std::str::from_utf8(e).unwrap_or(\"\"));\n430\t    }\n431\t    out.parse::<f32>().unwrap_or(0.0)\n432\t}\n433\t\n434\tfn hex_to_f32(s: &[u8]) -> f32 {\n435\t    let mut m: u128 = 0;\n436\t    let mut exp2: i64 = 0;\n437\t    let mut sticky = false;\n438\t    let mut seen_dot = false;\n439\t    let mut i = 0usize;\n440\t\n441\t    while i < s.len() {\n442\t        let c = s[i];\n443\t        if c == b'.' {\n444\t            seen_dot = true;\n445\t            i += 1;\n446\t            continue;\n447\t        }\n448\t        if c == b'p' {\n449\t            break;\n450\t        }\n451\t        let d = match (c as char).to_digit(16) {\n452\t            Some(d) => d as u128,\n453\t            None => break,\n454\t        };\n455\t        if m <= (u128::MAX >> 4) {\n456\t            m = (m << 4) | d;\n457\t            if seen_dot {\n458\t                exp2 -= 4;\n459\t            }\n460\t        } else {\n461\t            if d != 0 {\n462\t                sticky = true;\n463\t            }\n464\t            if !seen_dot {\n465\t                exp2 += 4;\n466\t            }\n467\t        }\n468\t        i += 1;\n469\t    }\n470\t\n471\t    let mut pexp: i64 = 0;\n472\t    if i < s.len() && s[i] == b'p' {\n473\t        i += 1;\n474\t        let mut eneg = false;\n475\t        if i < s.len() && (s[i] == b'+' || s[i] == b'-') {\n476\t            eneg = s[i] == b'-';\n477\t            i += 1;\n478\t        }\n479\t        let mut v: i64 = 0;\n480\t        while i < s.len() && s[i].is_ascii_digit() {\n481\t            v = v.saturating_mul(10).saturating_add((s[i] - b'0') as i64);\n482\t            if v > 100_000 {\n483\t                v = 100_000;\n484\t            }\n485\t            i += 1;\n486\t        }\n487\t        pexp = if eneg { -v } else { v };\n488\t    }\n489\t\n490\t    if m == 0 {\n491\t        return 0.0;\n492\t    }\n493\t\n494\t    // Round to odd at 53 significant bits so the later f64 -> f32 rounding is\n495\t    // correctly rounded (no double rounding).\n496\t    let bits = 128 - m.leading_zeros() as i64;\n497\t    if bits > 53 {\n498\t        let shift = (bits - 53) as u32;\n499\t        let dropped = m & ((1u128 << shift) - 1);\n500\t        m >>= shift;\n501\t        exp2 += shift as i64;\n502\t        if dropped != 0 || sticky {\n503\t            m |= 1;\n504\t        }\n505\t    } else if sticky {\n506\t        m |= 1;\n507\t    }\n508\t\n509\t    let v = scale_pow2(m as f64, exp2.saturating_add(pexp));\n510\t    v as f32\n511\t}\n512\t\n513\tfn main() {\n514\t    let stdin = std::io::stdin();\n515\t    let mut reader = ByteReader {\n516\t        inner: stdin.lock(),\n517\t    };\n518\t\n519\t    let mut x: f32 = 0.0;\n520\t    if let Some(v) = scan_float(&mut reader) {\n521\t        x = v;\n522\t    }\n523\t\n524\t    let stdout = std::io::stdout();\n525\t    let mut out = std::io::BufWriter::new(stdout.lock());\n526\t    driver(&mut out, x);\n527\t    let _ = out.flush();\n528\t}\n529\t"}]},"parent_tool_use_id":null,"session_id":"b8aa8f22-75ff-4aba-83a3-b041fffb6073","uuid":"a1ff11fb-f5da-4494-a502-40b043a65f8b","timestamp":"2026-08-28T16:18:32.738Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-EULy5e/translation/src/main.rs","content":"// Rust translation of c_src/src/main.c\n//\n// Original copyright notice from the C source:\n//\n// Copyright 2025 MIT Lincoln Laboratory\n// Permission is hereby granted, free of charge,\n// to any person obtaining a copy of this software\n// and associated documentation files (the \"Software\"),\n// to deal in the Software without restriction,\n// including without limitation the rights to use, copy,\n// modify, merge, publish, distribute, sublicense,\n// and/or sell copies of the Software,\n// and to permit persons to whom the Software is furnished to do so,\n// subject to the following conditions:\n//\n// The above copyright notice and this permission notice\n// shall be included in all copies or substantial portions of the Software.\n//\n// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n// THE WARRANTIES OF MERCHANTABILITY,\n// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n\nuse std::io::{Read, Write};\n\n// ---------------------------------------------------------------------------\n// print_hex / driver (direct translations)\n// ---------------------------------------------------------------------------\n\nfn print_hex(out: &mut dyn Write, p: &[u8], len: usize) {\n    for i in 0..len {\n        let _ = write!(out, \"{:02x}\", p[i]);\n    }\n    let _ = write!(out, \"\\n\");\n}\n\nfn driver(out: &mut dyn Write, x: f32) {\n    // char raw[sizeof(x)]; memcpy(raw, &x, sizeof(x));\n    let raw: [u8; 4] = x.to_ne_bytes();\n    print_hex(out, &raw, raw.len());\n}\n\n// ---------------------------------------------------------------------------\n// scanf(\"%f\", &x) emulation\n// ---------------------------------------------------------------------------\n\n#[derive(Copy, Clone, PartialEq, Eq)]\nenum St {\n    Start,\n    Sign,\n    Zero,\n    Int,\n    Dot,\n    LeadDot,\n    Frac,\n    E,\n    ESign,\n    Exp,\n    HexPrefix,\n    HexInt,\n    HexDot,\n    HexLeadDot,\n    HexFrac,\n    P,\n    PSign,\n    PExp,\n    I,\n    In,\n    Inf,\n    Infi,\n    Infin,\n    Infini,\n    Infinit,\n    Infinity,\n    N,\n    Na,\n    Nan,\n    NanOpen,\n    NanClose,\n}\n\nfn is_digit(c: u8) -> bool {\n    c.is_ascii_digit()\n}\n\nfn is_hex(c: u8) -> bool {\n    c.is_ascii_hexdigit()\n}\n\nfn accepting(s: St) -> bool {\n    matches!(\n        s,\n        St::Zero\n            | St::Int\n            | St::Dot\n            | St::Frac\n            | St::Exp\n            | St::HexInt\n            | St::HexDot\n            | St::HexFrac\n            | St::PExp\n            | St::Inf\n            | St::Infinity\n            | St::Nan\n            | St::NanClose\n    )\n}\n\n/// Transition of the \"expected form of a floating point subject sequence\" DFA\n/// (as described by C's strtof / scanf %f). Returns `None` when the character\n/// cannot continue any valid prefix.\nfn step(s: St, c: u8) -> Option<St> {\n    let lc = c.to_ascii_lowercase();\n    Some(match s {\n        St::Start | St::Sign => match lc {\n            b'+' | b'-' if s == St::Start => St::Sign,\n            b'0' => St::Zero,\n            b'1'..=b'9' => St::Int,\n            b'.' => St::LeadDot,\n            b'i' => St::I,\n            b'n' => St::N,\n            _ => return None,\n        },\n        St::Zero => match lc {\n            b'x' => St::HexPrefix,\n            b'.' => St::Dot,\n            b'e' => St::E,\n            _ if is_digit(c) => St::Int,\n            _ => return None,\n        },\n        St::Int => match lc {\n            b'.' => St::Dot,\n            b'e' => St::E,\n            _ if is_digit(c) => St::Int,\n            _ => return None,\n        },\n        St::Dot => match lc {\n            b'e' => St::E,\n            _ if is_digit(c) => St::Frac,\n            _ => return None,\n        },\n        St::LeadDot => {\n            if is_digit(c) {\n                St::Frac\n            } else {\n                return None;\n            }\n        }\n        St::Frac => match lc {\n            b'e' => St::E,\n            _ if is_digit(c) => St::Frac,\n            _ => return None,\n        },\n        St::E => match lc {\n            b'+' | b'-' => St::ESign,\n            _ if is_digit(c) => St::Exp,\n            _ => return None,\n        },\n        St::ESign | St::Exp => {\n            if is_digit(c) {\n                St::Exp\n            } else {\n                return None;\n            }\n        }\n        St::HexPrefix => {\n            if is_hex(c) {\n                St::HexInt\n            } else if c == b'.' {\n                St::HexLeadDot\n            } else {\n                return None;\n            }\n        }\n        St::HexInt => {\n            if is_hex(c) {\n                St::HexInt\n            } else if c == b'.' {\n                St::HexDot\n            } else if lc == b'p' {\n                St::P\n            } else {\n                return None;\n            }\n        }\n        St::HexDot => {\n            if is_hex(c) {\n                St::HexFrac\n            } else if lc == b'p' {\n                St::P\n            } else {\n                return None;\n            }\n        }\n        St::HexLeadDot => {\n            if is_hex(c) {\n                St::HexFrac\n            } else {\n                return None;\n            }\n        }\n        St::HexFrac => {\n            if is_hex(c) {\n                St::HexFrac\n            } else if lc == b'p' {\n                St::P\n            } else {\n                return None;\n            }\n        }\n        St::P => match lc {\n            b'+' | b'-' => St::PSign,\n            _ if is_digit(c) => St::PExp,\n            _ => return None,\n        },\n        St::PSign | St::PExp => {\n            if is_digit(c) {\n                St::PExp\n            } else {\n                return None;\n            }\n        }\n        St::I => {\n            if lc == b'n' {\n                St::In\n            } else {\n                return None;\n            }\n        }\n        St::In => {\n            if lc == b'f' {\n                St::Inf\n            } else {\n                return None;\n            }\n        }\n        St::Inf => {\n            if lc == b'i' {\n                St::Infi\n            } else {\n                return None;\n            }\n        }\n        St::Infi => {\n            if lc == b'n' {\n                St::Infin\n            } else {\n                return None;\n            }\n        }\n        St::Infin => {\n            if lc == b'i' {\n                St::Infini\n            } else {\n                return None;\n            }\n        }\n        St::Infini => {\n            if lc == b't' {\n                St::Infinit\n            } else {\n                return None;\n            }\n        }\n        St::Infinit => {\n            if lc == b'y' {\n                St::Infinity\n            } else {\n                return None;\n            }\n        }\n        St::N => {\n            if lc == b'a' {\n                St::Na\n            } else {\n                return None;\n            }\n        }\n        St::Na => {\n            if lc == b'n' {\n                St::Nan\n            } else {\n                return None;\n            }\n        }\n        St::Nan => {\n            if c == b'(' {\n                St::NanOpen\n            } else {\n                return None;\n            }\n        }\n        St::NanOpen => {\n            if c == b')' {\n                St::NanClose\n            } else if c.is_ascii_alphanumeric() || c == b'_' {\n                St::NanOpen\n            } else {\n                return None;\n            }\n        }\n        St::Infinity | St::NanClose => return None,\n    })\n}\n\nstruct ByteReader<R: Read> {\n    inner: R,\n}\n\nimpl<R: Read> ByteReader<R> {\n    fn next_byte(&mut self) -> Option<u8> {\n        let mut b = [0u8; 1];\n        loop {\n            match self.inner.read(&mut b) {\n                Ok(0) => return None,\n                Ok(_) => return Some(b[0]),\n                Err(ref e) if e.kind() == std::io::ErrorKind::Interrupted => continue,\n                Err(_) => return None,\n            }\n        }\n    }\n}\n\n/// Emulates `scanf(\"%f\", &x)`: returns `Some(value)` on a successful\n/// conversion, `None` on matching failure or EOF (in which case the C code\n/// leaves `x` untouched).\nfn scan_float<R: Read>(r: &mut ByteReader<R>) -> Option<f32> {\n    // %f skips leading white space (isspace).\n    let mut c = loop {\n        let c = r.next_byte()?;\n        if !matches!(c, b' ' | b'\\t' | b'\\n' | b'\\r' | 0x0b | 0x0c) {\n            break c;\n        }\n    };\n\n    let mut buf: Vec<u8> = Vec::new();\n    let mut state = St::Start;\n    let mut valid_len = 0usize;\n\n    loop {\n        match step(state, c) {\n            Some(next) => {\n                buf.push(c);\n                state = next;\n                if accepting(state) {\n                    valid_len = buf.len();\n                }\n            }\n            None => break,\n        }\n        match r.next_byte() {\n            Some(n) => c = n,\n            None => break,\n        }\n    }\n\n    // glibc's scanf can only push back a single character. Once it has seen\n    // \"inf\" followed by an 'i' it commits to matching the rest of \"infinity\";\n    // if that fails the whole conversion fails (rather than falling back to\n    // the \"inf\" prefix the way strtof would).\n    if matches!(state, St::Infi | St::Infin | St::Infini | St::Infinit) {\n        return None;\n    }\n\n    if valid_len == 0 {\n        return None;\n    }\n    Some(convert(&buf[..valid_len]))\n}\n\nfn scale_pow2(mut x: f64, mut n: i64) -> f64 {\n    // 2^512 and 2^-512 as exact f64 values.\n    let up = f64::from_bits(((1023i64 + 512) as u64) << 52);\n    let down = f64::from_bits(((1023i64 - 512) as u64) << 52);\n    while n > 512 {\n        x *= up;\n        n -= 512;\n    }\n    while n < -512 {\n        x *= down;\n        n += 512;\n    }\n    // For -512 <= n <= 512, 2^n is an exactly representable normal f64.\n    x * f64::from_bits(((1023i64 + n) as u64) << 52)\n}\n\nfn convert(s: &[u8]) -> f32 {\n    let mut i = 0usize;\n    let mut neg = false;\n    if i < s.len() && (s[i] == b'+' || s[i] == b'-') {\n        neg = s[i] == b'-';\n        i += 1;\n    }\n    let body = &s[i..];\n    let lower: Vec<u8> = body.iter().map(|c| c.to_ascii_lowercase()).collect();\n\n    let value: f32 = if lower.starts_with(b\"inf\") {\n        f32::INFINITY\n    } else if lower.starts_with(b\"nan\") {\n        f32::NAN\n    } else if lower.starts_with(b\"0x\")