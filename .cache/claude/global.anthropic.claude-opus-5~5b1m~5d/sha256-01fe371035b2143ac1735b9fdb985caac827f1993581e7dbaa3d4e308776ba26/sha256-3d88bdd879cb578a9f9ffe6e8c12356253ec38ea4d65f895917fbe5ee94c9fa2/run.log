{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01SiC1ELRAmPHsrC9uzQSnwB","type":"tool_result","content":"1\t/*\n2\t * Copyright 2025 MIT Lincoln Laboratory\n3\t * Permission is hereby granted, free of charge,\n4\t * to any person obtaining a copy of this software\n5\t * and associated documentation files (the \"Software\"),\n6\t * to deal in the Software without restriction,\n7\t * including without limitation the rights to use, copy,\n8\t * modify, merge, publish, distribute, sublicense,\n9\t * and/or sell copies of the Software,\n10\t * and to permit persons to whom the Software is furnished to do so,\n11\t * subject to the following conditions:\n12\t * \n13\t * The above copyright notice and this permission notice\n14\t * shall be included in all copies or substantial portions of the Software.\n15\t * \n16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n18\t * THE WARRANTIES OF MERCHANTABILITY,\n19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n24\t */\n25\t#include <stdio.h>\n26\t#include <stdlib.h>\n27\t#include <string.h>\n28\t#include <stddef.h>\n29\t#include \"inventory.h\"\n30\t\n31\tvoid print_menu(void) {\n32\t    printf(\"\\n\");\n33\t    printf(\"========================================\\n\");\n34\t    printf(\"  GENERIC FOR_EACH MACRO DEMO\\n\");\n35\t    printf(\"========================================\\n\");\n36\t    printf(\"1. Demo: Integer Containers\\n\");\n37\t    printf(\"2. Demo: Double Containers\\n\");\n38\t    printf(\"3. Demo: Inventory Array\\n\");\n39\t    printf(\"4. Demo: Order List\\n\");\n40\t    printf(\"5. Demo: Mixed Operations\\n\");\n41\t    printf(\"6. Run All Demos\\n\");\n42\t    printf(\"7. Exit\\n\");\n43\t    printf(\"========================================\\n\");\n44\t    printf(\"Choice: \");\n45\t}\n46\t\n47\tvoid demo_integer_containers(void) {\n48\t    printf(\"\\n\");\n49\t    printf(\"========================================\\n\");\n50\t    printf(\"  DEMO 1: Integer Containers\\n\");\n51\t    printf(\"========================================\\n\");\n52\t    \n53\t    // Create integer array\n54\t    array_int_t *int_array = array_int_create(10);\n55\t    printf(\"\\n--- Integer Array ---\\n\");\n56\t    printf(\"Adding integers: 10, 20, 30, 40, 50\\n\");\n57\t    array_int_push(int_array, 10);\n58\t    array_int_push(int_array, 20);\n59\t    array_int_push(int_array, 30);\n60\t    array_int_push(int_array, 40);\n61\t    array_int_push(int_array, 50);\n62\t    \n63\t    printf(\"Array contents: \");\n64\t    int val;\n65\t    ARRAY_FOREACH(int, val, int_array) {\n66\t        printf(\"%d \", val);\n67\t    }\n68\t    printf(\"\\n\");\n69\t    \n70\t    // Calculate sum using ARRAY_FOREACH\n71\t    int sum = 0;\n72\t    ARRAY_FOREACH(int, val, int_array) {\n73\t        sum += val;\n74\t    }\n75\t    printf(\"Sum: %d\\n\", sum);\n76\t    printf(\"Average: %.2f\\n\", (double)sum / int_array->size);\n77\t    \n78\t    // Create integer list\n79\t    list_int_t *int_list = list_int_create();\n80\t    printf(\"\\n--- Integer List ---\\n\");\n81\t    printf(\"Adding integers: 100, 200, 300, 400, 500\\n\");\n82\t    list_int_append(int_list, 100);\n83\t    list_int_append(int_list, 200);\n84\t    list_int_append(int_list, 300);\n85\t    list_int_append(int_list, 400);\n86\t    list_int_append(int_list, 500);\n87\t    \n88\t    printf(\"List contents: \");\n89\t    LIST_FOREACH(int, val, int_list) {\n90\t        printf(\"%d \", val);\n91\t    }\n92\t    printf(\"\\n\");\n93\t    \n94\t    // Calculate product using LIST_FOREACH\n95\t    long long product = 1;\n96\t    LIST_FOREACH(int, val, int_list) {\n97\t        product *= val;\n98\t    }\n99\t    printf(\"Product: %lld\\n\", product);\n100\t    \n101\t    // Cleanup\n102\t    array_int_destroy(int_array);\n103\t    list_int_destroy(int_list);\n104\t}\n105\t\n106\tvoid demo_double_containers(void) {\n107\t    printf(\"\\n\");\n108\t    printf(\"========================================\\n\");\n109\t    printf(\"  DEMO 2: Double Containers\\n\");\n110\t    printf(\"========================================\\n\");\n111\t    \n112\t    // Create double array\n113\t    array_double_t *double_array = array_double_create(5);\n114\t    printf(\"\\n--- Double Array (Temperatures in Celsius) ---\\n\");\n115\t    \n116\t    double temps[] = {23.5, 25.0, 22.8, 26.3, 24.1, 21.9, 27.5};\n117\t    int num_temps = sizeof(temps) / sizeof(temps[0]);\n118\t    \n119\t    printf(\"Adding temperatures: \");\n120\t    for (int i = 0; i < num_temps; i++) {\n121\t        array_double_push(double_array, temps[i]);\n122\t        printf(\"%.1f \", temps[i]);\n123\t    }\n124\t    printf(\"\\n\");\n125\t    \n126\t    // Find min, max, average using ARRAY_FOREACH\n127\t    double min_temp = temps[0];\n128\t    double max_temp = temps[0];\n129\t    double sum_temp = 0.0;\n130\t    double temp;\n131\t    \n132\t    ARRAY_FOREACH(double, temp, double_array) {\n133\t        if (temp < min_temp) min_temp = temp;\n134\t        if (temp > max_temp) max_temp = temp;\n135\t        sum_temp += temp;\n136\t    }\n137\t    \n138\t    printf(\"Minimum: %.1f°C\\n\", min_temp);\n139\t    printf(\"Maximum: %.1f°C\\n\", max_temp);\n140\t    printf(\"Average: %.1f°C\\n\", sum_temp / double_array->size);\n141\t    \n142\t    // Create double list\n143\t    list_double_t *price_list = list_double_create();\n144\t    printf(\"\\n--- Double List (Product Prices) ---\\n\");\n145\t    \n146\t    double prices[] = {9.99, 14.50, 7.25, 22.00, 5.99, 18.75};\n147\t    int num_prices = sizeof(prices) / sizeof(prices[0]);\n148\t    \n149\t    printf(\"Adding prices: \");\n150\t    for (int i = 0; i < num_prices; i++) {\n151\t        list_double_append(price_list, prices[i]);\n152\t        printf(\"$%.2f \", prices[i]);\n153\t    }\n154\t    printf(\"\\n\");\n155\t    \n156\t    // Calculate total and find items under $10 using LIST_FOREACH\n157\t    double total = 0.0;\n158\t    int count_under_10 = 0;\n159\t    \n160\t    LIST_FOREACH(double, temp, price_list) {\n161\t        total += temp;\n162\t        if (temp < 10.0) count_under_10++;\n163\t    }\n164\t    \n165\t    printf(\"Total cost: $%.2f\\n\", total);\n166\t    printf(\"Items under $10: %d\\n\", count_under_10);\n167\t    \n168\t    // Cleanup\n169\t    array_double_destroy(double_array);\n170\t    list_double_destroy(price_list);\n171\t}\n172\t\n173\tvoid demo_inventory_array(void) {\n174\t    printf(\"\\n\");\n175\t    printf(\"========================================\\n\");\n176\t    printf(\"  DEMO 3: Inventory Array (Items)\\n\");\n177\t    printf(\"========================================\\n\");\n178\t    \n179\t    // Create inventory array\n180\t    array_item_t_t *inventory = array_item_t_create(20);\n181\t    \n182\t    // Add items\n183\t    printf(\"\\n--- Adding Items to Inventory ---\\n\");\n184\t    array_item_t_push(inventory, create_item(1, \"Laptop\", \"Electronics\", 899.99, 15));\n185\t    array_item_t_push(inventory, create_item(2, \"Mouse\", \"Electronics\", 24.99, 50));\n186\t    array_item_t_push(inventory, create_item(3, \"Keyboard\", \"Electronics\", 79.99, 30));\n187\t    array_item_t_push(inventory, create_item(4, \"Monitor\", \"Electronics\", 299.99, 20));\n188\t    array_item_t_push(inventory, create_item(5, \"Desk Chair\", \"Furniture\", 199.99, 10));\n189\t    array_item_t_push(inventory, create_item(6, \"Desk\", \"Furniture\", 349.99, 8));\n190\t    array_item_t_push(inventory, create_item(7, \"Notebook\", \"Office\", 4.99, 100));\n191\t    array_item_t_push(inventory, create_item(8, \"Pen Set\", \"Office\", 12.99, 75));\n192\t    array_item_t_push(inventory, create_item(9, \"USB Cable\", \"Electronics\", 9.99, 60));\n193\t    array_item_t_push(inventory, create_item(10, \"Bookshelf\", \"Furniture\", 149.99, 12));\n194\t    \n195\t    printf(\"Added %zu items to inventory\\n\", inventory->size);\n196\t    \n197\t    // Display all items using ARRAY_FOREACH\n198\t    printf(\"\\n--- All Inventory Items ---\\n\");\n199\t    item_t item;\n200\t    ARRAY_FOREACH(item_t, item, inventory) {\n201\t        print_item(item);\n202\t        printf(\"\\n\");\n203\t    }\n204\t    \n205\t    // Calculate statistics\n206\t    calculate_inventory_stats(inventory);\n207\t    \n208\t    // Find items by category\n209\t    find_items_by_category(inventory, \"Electronics\");\n210\t    find_items_by_category(inventory, \"Furniture\");\n211\t    \n212\t    // Find low stock items using ARRAY_FOREACH\n213\t    printf(\"\\n--- Low Stock Items (< 20) ---\\n\");\n214\t    int low_stock_count = 0;\n215\t    ARRAY_FOREACH(item_t, item, inventory) {\n216\t        if (item.quantity < 20) {\n217\t            print_item(item);\n218\t            low_stock_count++;\n219\t        }\n220\t    }\n221\t    printf(\"Total low stock items: %d\\n\", low_stock_count);\n222\t    \n223\t    // Cleanup\n224\t    array_item_t_destroy(inventory);\n225\t}\n226\t\n227\tvoid demo_order_list(void) {\n228\t    printf(\"\\n\");\n229\t    printf(\"========================================\\n\");\n230\t    printf(\"  DEMO 4: Order List (Orders)\\n\");\n231\t    printf(\"========================================\\n\");\n232\t    \n233\t    // Create order list\n234\t    list_order_t_t *orders = list_order_t_create();\n235\t    \n236\t    // Add orders\n237\t    printf(\"\\n--- Adding Orders ---\\n\");\n238\t    list_order_t_append(orders, create_order(1001, \"Alice Johnson\", 1249.95));\n239\t    list_order_t_append(orders, create_order(1002, \"Bob Smith\", 89.99));\n240\t    list_order_t_append(orders, create_order(1003, \"Carol White\", 549.98));\n241\t    list_order_t_append(orders, create_order(1004, \"David Brown\", 24.99));\n242\t    list_order_t_append(orders, create_order(1005, \"Eve Davis\", 899.99));\n243\t    list_order_t_append(orders, create_order(1006, \"Frank Miller\", 374.97));\n244\t    list_order_t_append(orders, create_order(1007, \"Grace Lee\", 159.98));\n245\t    list_order_t_append(orders, create_order(1008, \"Henry Wilson\", 1099.99));\n246\t    \n247\t    printf(\"Added %zu orders\\n\", orders->size);\n248\t    \n249\t    // Display all orders using LIST_FOREACH\n250\t    printf(\"\\n--- All Orders ---\\n\");\n251\t    order_t order;\n252\t    LIST_FOREACH(order_t, order, orders) {\n253\t        print_order(order);\n254\t    }\n255\t    \n256\t    // Calculate statistics\n257\t    calculate_order_stats(orders);\n258\t    \n259\t    // Find large orders using LIST_FOREACH\n260\t    printf(\"\\n--- Large Orders (> $500) ---\\n\");\n261\t    int large_order_count = 0;\n262\t    double large_order_total = 0.0;\n263\t    \n264\t    LIST_FOREACH(order_t, order, orders) {\n265\t        if (order.total_amount > 500.0) {\n266\t            print_order(order);\n267\t            large_order_count++;\n268\t            large_order_total += order.total_amount;\n269\t        }\n270\t    }\n271\t    \n272\t    printf(\"Total large orders: %d\\n\", large_order_count);\n273\t    printf(\"Revenue from large orders: $%.2f\\n\", large_order_total);\n274\t    \n275\t    // Cleanup\n276\t    list_order_t_destroy(orders);\n277\t}\n278\t\n279\tvoid demo_mixed_operations(void) {\n280\t    printf(\"\\n\");\n281\t    printf(\"========================================\\n\");\n282\t    printf(\"  DEMO 5: Mixed Operations\\n\");\n283\t    printf(\"========================================\\n\");\n284\t    \n285\t    // Create both array and list with items\n286\t    array_item_t_t *array_inventory = array_item_t_create(10);\n287\t    list_item_t_t *list_inventory = list_item_t_create();\n288\t    \n289\t    printf(\"\\n--- Populating both Array and List ---\\n\");\n290\t    \n291\t    // Add same items to both\n292\t    item_t items[] = {\n293\t        create_item(1, \"Smartphone\", \"Electronics\", 699.99, 25),\n294\t        create_item(2, \"Tablet\", \"Electronics\", 449.99, 18),\n295\t        create_item(3, \"Headphones\", \"Electronics\", 149.99, 40),\n296\t        create_item(4, \"Smart Watch\", \"Electronics\", 299.99, 22),\n297\t        create_item(5, \"Power Bank\", \"Electronics\", 39.99, 55)\n298\t    };\n299\t    \n300\t    int num_items = sizeof(items) / sizeof(items[0]);\n301\t    \n302\t    for (int i = 0; i < num_items; i++) {\n303\t        array_item_t_push(array_inventory, items[i]);\n304\t        list_item_t_append(list_inventory, items[i]);\n305\t    }\n306\t    \n307\t    printf(\"Added %d items to both containers\\n\", num_items);\n308\t    \n309\t    // Compare iteration performance (conceptually)\n310\t    printf(\"\\n--- Iterating through Array ---\\n\");\n311\t    int array_count = 0;\n312\t    item_t item;\n313\t    ARRAY_FOREACH(item_t, item, array_inventory) {\n314\t        array_count++;\n315\t    }\n316\t    printf(\"Array iteration count: %d\\n\", array_count);\n317\t    \n318\t    printf(\"\\n--- Iterating through List ---\\n\");\n319\t    int list_count = 0;\n320\t    LIST_FOREACH(item_t, item, list_inventory) {\n321\t        list_count++;\n322\t    }\n323\t    printf(\"List iteration count: %d\\n\", list_count);\n324\t    \n325\t    // Find items above certain price in both\n326\t    double price_threshold = 200.0;\n327\t    \n328\t    printf(\"\\n--- Items above $%.2f (Array) ---\\n\", price_threshold);\n329\t    ARRAY_FOREACH(item_t, item, array_inventory) {\n330\t        if (item.price >= price_threshold) {\n331\t            printf(\"  %s: $%.2f\\n\", item.name, item.price);\n332\t        }\n333\t    }\n334\t    \n335\t    printf(\"\\n--- Items above $%.2f (List) ---\\n\", price_threshold);\n336\t    LIST_FOREACH(item_t, item, list_inventory) {\n337\t        if (item.price >= price_threshold) {\n338\t            printf(\"  %s: $%.2f\\n\", item.name, item.price);\n339\t        }\n340\t    }\n341\t    \n342\t    // Cleanup\n343\t    array_item_t_destroy(array_inventory);\n344\t    list_item_t_destroy(list_inventory);\n345\t}\n346\t\n347\tint main(void) {\n348\t    printf(\"╔════════════════════════════════════════╗\\n\");\n349\t    printf(\"║   GENERIC FOR_EACH MACRO DEMO         ║\\n\");\n350\t    printf(\"║   Demonstrating Generic Containers    ║\\n\");\n351\t    printf(\"╚════════════════════════════════════════╝\\n\");\n352\t    \n353\t    char input[256];\n354\t    int choice;\n355\t    \n356\t    while (1) {\n357\t        print_menu();\n358\t        \n359\t        if (!fgets(input, sizeof(input), stdin)) {\n360\t            break;\n361\t        }\n362\t        \n363\t        if (sscanf(input, \"%d\", &choice) != 1) {\n364\t            printf(\"Invalid input\\n\");\n365\t            continue;\n366\t        }\n367\t        \n368\t        switch (choice) {\n369\t            case 1:\n370\t                demo_integer_containers();\n371\t                break;\n372\t                \n373\t            case 2:\n374\t                demo_double_containers();\n375\t                break;\n376\t                \n377\t            case 3:\n378\t                demo_inventory_array();\n379\t                break;\n380\t                \n381\t            case 4:\n382\t                demo_order_list();\n383\t                break;\n384\t                \n385\t            case 5:\n386\t                demo_mixed_operations();\n387\t                break;\n388\t                \n389\t            case 6:\n390\t                printf(\"\\n=== Running All Demos ===\\n\");\n391\t                demo_integer_containers();\n392\t                demo_double_containers();\n393\t                demo_inventory_array();\n394\t                demo_order_list();\n395\t                demo_mixed_operations();\n396\t                printf(\"\\n========================================\\n\");\n397\t                printf(\"  All demos completed successfully!\\n\");\n398\t                printf(\"========================================\\n\");\n399\t                break;\n400\t                \n401\t            case 7:\n402\t                printf(\"\\nGoodbye!\\n\");\n403\t                return 0;\n404\t                \n405\t            default:\n406\t                printf(\"Invalid choice\\n\");\n407\t                break;\n408\t        }\n409\t    }\n410\t    \n411\t    return 0;\n412\t}\n413\t"}]},"parent_tool_use_id":null,"session_id":"263324a1-2d26-41f3-afb4-5e3f3bab2038","uuid":"631e8432-8bf6-4c22-81ce-05ae58863598","timestamp":"2026-08-28T01:09:52.778Z","tool_use_result":{"type":"text","file":{"filePath":"c_src/src/main.c","content":"/*\n * Copyright 2025 MIT Lincoln Laboratory\n * Permission is hereby granted, free of charge,\n * to any person obtaining a copy of this software\n * and associated documentation files (the \"Software\"),\n * to deal in the Software without restriction,\n * including without limitation the rights to use, copy,\n * modify, merge, publish, distribute, sublicense,\n * and/or sell copies of the Software,\n * and to permit persons to whom the Software is furnished to do so,\n * subject to the following conditions:\n * \n * The above copyright notice and this permission notice\n * shall be included in all copies or substantial portions of the Software.\n * \n * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n * THE WARRANTIES OF MERCHANTABILITY,\n * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n */\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stddef.h>\n#include \"inventory.h\"\n\nvoid print_menu(void) {\n    printf(\"\\n\");\n    printf(\"========================================\\n\");\n    printf(\"  GENERIC FOR_EACH MACRO DEMO\\n\");\n    printf(\"========================================\\n\");\n    printf(\"1. Demo: Integer Containers\\n\");\n    printf(\"2. Demo: Double Containers\\n\");\n    printf(\"3. Demo: Inventory Array\\n\");\n    printf(\"4. Demo: Order List\\n\");\n    printf(\"5. Demo: Mixed Operations\\n\");\n    printf(\"6. Run All Demos\\n\");\n    printf(\"7. Exit\\n\");\n    printf(\"========================================\\n\");\n    printf(\"Choice: \");\n}\n\nvoid demo_integer_containers(void) {\n    printf(\"\\n\");\n    printf(\"========================================\\n\");\n    printf(\"  DEMO 1: Integer Containers\\n\");\n    printf(\"========================================\\n\");\n    \n    // Create integer array\n    array_int_t *int_array = array_int_create(10);\n    printf(\"\\n--- Integer Array ---\\n\");\n    printf(\"Adding integers: 10, 20, 30, 40, 50\\n\");\n    array_int_push(int_array, 10);\n    array_int_push(int_array, 20);\n    array_int_push(int_array, 30);\n    array_int_push(int_array, 40);\n    array_int_push(int_array, 50);\n    \n    printf(\"Array contents: \");\n    int val;\n    ARRAY_FOREACH(int, val, int_array) {\n        printf(\"%d \", val);\n    }\n    printf(\"\\n\");\n    \n    // Calculate sum using ARRAY_FOREACH\n    int sum = 0;\n    ARRAY_FOREACH(int, val, int_array) {\n        sum += val;\n    }\n    printf(\"Sum: %d\\n\", sum);\n    printf(\"Average: %.2f\\n\", (double)sum / int_array->size);\n    \n    // Create integer list\n    list_int_t *int_list = list_int_create();\n    printf(\"\\n--- Integer List ---\\n\");\n    printf(\"Adding integers: 100, 200, 300, 400, 500\\n\");\n    list_int_append(int_list, 100);\n    list_int_append(int_list, 200);\n    list_int_append(int_list, 300);\n    list_int_append(int_list, 400);\n    list_int_append(int_list, 500);\n    \n    printf(\"List contents: \");\n    LIST_FOREACH(int, val, int_list) {\n        printf(\"%d \", val);\n    }\n    printf(\"\\n\");\n    \n    // Calculate product using LIST_FOREACH\n    long long product = 1;\n    LIST_FOREACH(int, val, int_list) {\n        product *= val;\n    }\n    printf(\"Product: %lld\\n\", product);\n    \n    // Cleanup\n    array_int_destroy(int_array);\n    list_int_destroy(int_list);\n}\n\nvoid demo_double_containers(void) {\n    printf(\"\\n\");\n    printf(\"========================================\\n\");\n    printf(\"  DEMO 2: Double Containers\\n\");\n    printf(\"========================================\\n\");\n    \n    // Create double array\n    array_double_t *double_array = array_double_create(5);\n    printf(\"\\n--- Double Array (Temperatures in Celsius) ---\\n\");\n    \n    double temps[] = {23.5, 25.0, 22.8, 26.3, 24.1, 21.9, 27.5};\n    int num_temps = sizeof(temps) / sizeof(temps[0]);\n    \n    printf(\"Adding temperatures: \");\n    for (int i = 0; i < num_temps; i++) {\n        array_double_push(double_array, temps[i]);\n        printf(\"%.1f \", temps[i]);\n    }\n    printf(\"\\n\");\n    \n    // Find min, max, average using ARRAY_FOREACH\n    double min_temp = temps[0];\n    double max_temp = temps[0];\n    double sum_temp = 0.0;\n    double temp;\n    \n    ARRAY_FOREACH(double, temp, double_array) {\n        if (temp < min_temp) min_temp = temp;\n        if (temp > max_temp) max_temp = temp;\n        sum_temp += temp;\n    }\n    \n    printf(\"Minimum: %.1f°C\\n\", min_temp);\n    printf(\"Maximum: %.1f°C\\n\", max_temp);\n    printf(\"Average: %.1f°C\\n\", sum_temp / double_array->size);\n    \n    // Create double list\n    list_double_t *price_list = list_double_create();\n    printf(\"\\n--- Double List (Product Prices) ---\\n\");\n    \n    double prices[] = {9.99, 14.50, 7.25, 22.00, 5.99, 18.75};\n    int num_prices = sizeof(prices) / sizeof(prices[0]);\n    \n    printf(\"Adding prices: \");\n    for (int i = 0; i < num_prices; i++) {\n        list_double_append(price_list, prices[i]);\n        printf(\"$%.2f \", prices[i]);\n    }\n    printf(\"\\n\");\n    \n    // Calculate total and find items under $10 using LIST_FOREACH\n    double total = 0.0;\n    int count_under_10 = 0;\n    \n    LIST_FOREACH(double, temp, price_list) {\n        total += temp;\n        if (temp < 10.0) count_under_10++;\n    }\n    \n    printf(\"Total cost: $%.2f\\n\", total);\n    printf(\"Items under $10: %d\\n\", count_under_10);\n    \n    // Cleanup\n    array_double_destroy(double_array);\n    list_double_destroy(price_list);\n}\n\nvoid demo_inventory_array(void) {\n    printf(\"\\n\");\n    printf(\"========================================\\n\");\n    printf(\"  DEMO 3: Inventory Array (Items)\\n\");\n    printf(\"========================================\\n\");\n    \n    // Create inventory array\n    array_item_t_t *inventory = array_item_t_create(20);\n    \n    // Add items\n    printf(\"\\n--- Adding Items to Inventory ---\\n\");\n    array_item_t_push(inventory, create_item(1, \"Laptop\", \"Electronics\", 899.99, 15));\n    array_item_t_push(inventory, create_item(2, \"Mouse\", \"Electronics\", 24.99, 50));\n    array_item_t_push(inventory, create_item(3, \"Keyboard\", \"Electronics\", 79.99, 30));\n    array_item_t_push(inventory, create_item(4, \"Monitor\", \"Electronics\", 299.99, 20));\n    array_item_t_push(inventory, create_item(5, \"Desk Chair\", \"Furniture\", 199.99, 10));\n    array_item_t_push(inventory, create_item(6, \"Desk\", \"Furniture\", 349.99, 8));\n    array_item_t_push(inventory, create_item(7, \"Notebook\", \"Office\", 4.99, 100));\n    array_item_t_push(inventory, create_item(8, \"Pen Set\", \"Office\", 12.99, 75));\n    array_item_t_push(inventory, create_item(9, \"USB Cable\", \"Electronics\", 9.99, 60));\n    array_item_t_push(inventory, create_item(10, \"Bookshelf\", \"Furniture\", 149.99, 12));\n    \n    printf(\"Added %zu items to inventory\\n\", inventory->size);\n    \n    // Display all items using ARRAY_FOREACH\n    printf(\"\\n--- All Inventory Items ---\\n\");\n    item_t item;\n    ARRAY_FOREACH(item_t, item, inventory) {\n        print_item(item);\n        printf(\"\\n\");\n    }\n    \n    // Calculate statistics\n    calculate_inventory_stats(inventory);\n    \n    // Find items by category\n    find_items_by_category(inventory, \"Electronics\");\n    find_items_by_category(inventory, \"Furniture\");\n    \n    // Find low stock items using ARRAY_FOREACH\n    printf(\"\\n--- Low Stock Items (< 20) ---\\n\");\n    int low_stock_count = 0;\n    ARRAY_FOREACH(item_t, item, inventory) {\n        if (item.quantity < 20) {\n            print_item(item);\n            low_stock_count++;\n        }\n    }\n    printf(\"Total low stock items: %d\\n\", low_stock_count);\n    \n    // Cleanup\n    array_item_t_destroy(inventory);\n}\n\nvoid demo_order_list(void) {\n    printf(\"\\n\");\n    printf(\"========================================\\n\");\n    printf(\"  DEMO 4: Order List (Orders)\\n\");\n    printf(\"========================================\\n\");\n    \n    // Create order list\n    list_order_t_t *orders = list_order_t_create();\n    \n    // Add orders\n    printf(\"\\n--- Adding Orders ---\\n\");\n    list_order_t_append(orders, create_order(1001, \"Alice Johnson\", 1249.95));\n    list_order_t_append(orders, create_order(1002, \"Bob Smith\", 89.99));\n    list_order_t_append(orders, create_order(1003, \"Carol White\", 549.98));\n    list_order_t_append(orders, create_order(1004, \"David Brown\", 24.99));\n    list_order_t_append(orders, create_order(1005, \"Eve Davis\", 899.99));\n    list_order_t_append(orders, create_order(1006, \"Frank Miller\", 374.97));\n    list_order_t_append(orders, create_order(1007, \"Grace Lee\", 159.98));\n    list_order_t_append(orders, create_order(1008, \"Henry Wilson\", 1099.99));\n    \n    printf(\"Added %zu orders\\n\", orders->size);\n    \n    // Display all orders using LIST_FOREACH\n    printf(\"\\n--- All Orders ---\\n\");\n    order_t order;\n    LIST_FOREACH(order_t, order, orders) {\n        print_order(order);\n    }\n    \n    // Calculate statistics\n    calculate_order_stats(orders);\n    \n    // Find large orders using LIST_FOREACH\n    printf(\"\\n--- Large Orders (> $500) ---\\n\");\n    int large_order_count = 0;\n    double large_order_total = 0.0;\n    \n    LIST_FOREACH(order_t, order, orders) {\n        if (order.total_amount > 500.0) {\n            print_order(order);\n            large_order_count++;\n            large_order_total += order.total_amount;\n        }\n    }\n    \n    printf(\"Total large orders: %d\\n\", large_order_count);\n    printf(\"Revenue from large orders: $%.2f\\n\", large_order_total);\n    \n    // Cleanup\n    list_order_t_destroy(orders);\n}\n\nvoid demo_mixed_operations(void) {\n    printf(\"\\n\");\n    printf(\"========================================\\n\");\n    printf(\"  DEMO 5: Mixed Operations\\n\");\n    printf(\"========================================\\n\");\n    \n    // Create both array and list with items\n    array_item_t_t *array_inventory = array_item_t_create(10);\n    list_item_t_t *list_inventory = list_item_t_create();\n    \n    printf(\"\\n--- Populating both Array and List ---\\n\");\n    \n    // Add same items to both\n    item_t items[] = {\n        create_item(1, \"Smartphone\", \"Electronics\", 699.99, 25),\n        create_item(2, \"Tablet\", \"Electronics\", 449.99, 18),\n        create_item(3, \"Headphones\", \"Electronics\", 149.99, 40),\n        create_item(4, \"Smart Watch\", \"Electronics\", 299.99, 22),\n        create_item(5, \"Power Bank\", \"Electronics\", 39.99, 55)\n    };\n    \n    int num_items = sizeof(items) / sizeof(items[0]);\n    \n    for (int i = 0; i < num_items; i++) {\n        array_item_t_push(array_inventory, items[i]);\n        list_item_t_append(list_inventory, items[i]);\n    }\n    \n    printf(\"Added %d items to both containers\\n\", num_items);\n    \n    // Compare iteration performance (conceptually)\n    printf(\"\\n--- Iterating through Array ---\\n\");\n    int array_count = 0;\n    item_t item;\n    ARRAY_FOREACH(item_t, item, array_inventory) {\n        array_count++;\n    }\n    printf(\"Array iteration count: %d\\n\", array_count);\n    \n    printf(\"\\n--- Iterating through List ---\\n\");\n    int list_count = 0;\n    LIST_FOREACH(item_t, item, list_inventory) {\n        list_count++;\n    }\n    printf(\"List iteration count: %d\\n\", list_count);\n    \n    // Find items above certain price in both\n    double price_threshold = 200.0;\n    \n    printf(\"\\n--- Items above $%.2f (Array) ---\\n\", price_threshold);\n    ARRAY_FOREACH(item_t, item, array_inventory) {\n        if (item.price >= price_threshold) {\n            printf(\"  %s: $%.2f\\n\", item.name, item.price);\n        }\n    }\n    \n    printf(\"\\n--- Items above $%.2f (List) ---\\n\", price_threshold);\n    LIST_FOREACH(item_t, item, list_inventory) {\n        if (item.price >= price_threshold) {\n            printf(\"  %s: $%.2f\\n\", item.name, item.price);\n        }\n    }\n    \n    // Cleanup\n    array_item_t_destroy(array_inventory);\n    list_item_t_destroy(list_inventory);\n}\n\nint main(void) {\n    printf(\"╔════════════════════════════════════════╗\\n\");\n    printf(\"║   GENERIC FOR_EACH MACRO DEMO         ║\\n\");\n    printf(\"║   Demonstrating Generic Containers    ║\\n\");\n    printf(\"╚════════════════════════════════════════╝\\n\");\n    \n    char input[256];\n    int choice;\n    \n    while (1) {\n        print_menu();\n        \n        if (!fgets(input, sizeof(input), stdin)) {\n            break;\n        }\n        \n        if (sscanf(input, \"%d\", &choice) != 1) {\n            printf(\"Invalid input\\n\");\n            continue;\n        }\n        \n        switch (choice) {\n            case 1:\n                demo_integer_containers();\n                break;\n                \n            case 2:\n                demo_double_containers();\n                break;\n                \n            case 3:\n                demo_inventory_array();\n                break;\n                \n            case 4:\n                demo_order_list();\n                break;\n                \n            case 5:\n                demo_mixed_operations();\n                break;\n                \n            case 6:\n                printf(\"\\n=== Running All Demos ===\\n\");\n                demo_integer_containers();\n                demo_double_containers();\n                demo_inventory_array();\n                demo_order_list();\n                demo_mixed_operations();\n                printf(\"\\n========================================\\n\");\n                printf(\"  All demos completed successfully!\\n\");\n                printf(\"========================================\\n\");\n                break;\n                \n            case 7:\n                printf(\"\\nGoodbye!\\n\");\n                return 0;\n                \n            default:\n                printf(\"Invalid choice\\n\");\n                break;\n        }\n    }\n    \n    return 0;\n}\n","numLines":413,"startLine":1,"totalLines":413}}}
