l = 1; ml < 5; ml++) {\n        memset(out, 0x7f, sizeof out);\n        char *r = f(out, ml, (const uint8_t *)\"\", 0);\n        printf(\"empty ml=%zu -> [%s] ret_eq=%d\\n\", ml, out, r == out);\n    }\n    /* growing sequential buffers, exact-fit maxlen (bin_len*2+1) */\n    for (size_t n = 0; n <= 300; n++) {\n        for (size_t i = 0; i < n; i++) buf[i] = (unsigned char)((i * 37 + n * 11) & 0xff);\n        memset(out, 0x7f, sizeof out);\n        char *r = f(out, n * 2 + 1, buf, n);\n        printf(\"seq n=%zu ret_eq=%d hex=%s\\n\", n, r == out, out);\n        /* also dump raw bytes including terminator to catch any difference */\n        fwrite(out, 1, n * 2 + 1, stdout);\n        fputc('\\n', stdout);\n    }\n    /* pattern: all 0x00 and all 0xff */\n    memset(buf, 0x00, 64); memset(out, 0x7f, sizeof out);\n    f(out, 129, buf, 64); printf(\"zeros=%s\\n\", out);\n    memset(buf, 0xff, 64); memset(out, 0x7f, sizeof out);\n    f(out, 129, buf, 64); printf(\"ffs=%s\\n\", out);\n    /* larger maxlen than needed */\n    for (size_t i = 0; i < 16; i++) buf[i] = (unsigned char)(i * 16 + i);\n    memset(out, 0x7f, sizeof out);\n    f(out, 1000, buf, 16); printf(\"slack=%s tail=%02x\\n\", out, (unsigned char)out[33]);\n    fflush(stdout);\n    return 0;\n}\nEOF\ncat > $B/abortdriver.c <<'EOF'\n#include <dlfcn.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdint.h>\ntypedef char *(*bin2hex_t)(char *, size_t, const uint8_t *, size_t);\n/* argv[2] selects the abort scenario */\nint main(int argc, char **argv) {\n    void *h = dlopen(argv[1], RTLD_NOW);\n    bin2hex_t f = (bin2hex_t)dlsym(h, \"bin2hex\");\n    char out[64]; unsigned char b[4] = {1,2,3,4};\n    int mode = atoi(argv[2]);\n    if (mode == 0) f(out, 8, b, 4);            /* hex_maxlen == bin_len*2 -> abort */\n    else if (mode == 1) f(out, 7, b, 4);       /* hex_maxlen <  bin_len*2 -> abort */\n    else if (mode == 2) f(out, 0, b, 0);       /* hex_maxlen == 0         -> abort */\n    else if (mode == 3) f(out, (size_t)-1, b, (size_t)9223372036854775807UL); /* bin_len >= SIZE_MAX/2 */\n    else if (mode == 4) f(out, 9, b, 4);       /* ok, no abort */\n    printf(\"survived\\n\"); fflush(stdout);\n    return 0;\n}\nEOF\ngcc -O2 -o $B/driver $B/driver.c -ldl\ngcc -O2 -o $B/abortdriver $B/abortdriver.c -ldl\n$B/driver \"$CSO\" > $B/out_c.txt 2>$B/err_c.txt; echo \"C driver exit=$?\"\n$B/driver \"$RSO\" > $B/out_r.txt 2>$B/err_r.txt; echo \"R driver exit=$?\"\necho \"C bytes: $(wc -c < $B/out_c.txt)  R bytes: $(wc -c < $B/out_r.txt)\"\nif cmp $B/out_c.txt $B/out_r.txt; then echo \"OUTPUT: BYTE-IDENTICAL\"; else echo \"OUTPUT: DIFFERS\"; diff <(od -c $B/out_c.txt) <(od -c $B/out_r.txt) | head -20; fi\necho \"=== abort/exit-code parity ===\"\nfor m in 0 1 2 3 4; do\n  $B/abortdriver \"$CSO\" $m >$B/ac.txt 2>&1; ec=$?\n  $B/abortdriver \"$RSO\" $m >$B/ar.txt 2>&1; er=$?\n  same_out=DIFF; cmp -s $B/ac.txt $B/ar.txt && same_out=SAME\n  echo \"mode=$m C_exit=$ec R_exit=$er stdout=$same_out\"\ndone"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":854,"cache_read_input_tokens":26538,"cache_creation":{"ephemeral_5m_input_tokens":854,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"05f0bfb4-689f-4a52-9008-bcbe750a4bb6","uuid":"86602cf3-1920-4879-8290-747882314dac","timestamp":"2026-08-26T19:39:53.714Z"}
