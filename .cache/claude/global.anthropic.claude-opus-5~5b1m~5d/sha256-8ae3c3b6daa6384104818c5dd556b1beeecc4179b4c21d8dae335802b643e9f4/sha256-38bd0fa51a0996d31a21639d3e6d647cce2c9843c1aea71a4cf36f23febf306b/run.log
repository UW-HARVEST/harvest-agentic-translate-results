            }\n        } else {\n            if (*stream_ptr).dictSize < 64 * 1024\n                && (*stream_ptr).dictSize < (*stream_ptr).currentOffset\n            {\n                result = LZ4_compress_generic(\n                    stream_ptr,\n                    source,\n                    dest,\n                    input_size,\n                    ptr::null_mut(),\n                    max_output_size,\n                    LIMITED_OUTPUT,\n                    table_type,\n                    USING_EXT_DICT,\n                    DICT_SMALL,\n                    acceleration,\n                );\n            } else {\n                result = LZ4_compress_generic(\n                    stream_ptr,\n                    source,\n                    dest,\n                    input_size,\n                    ptr::null_mut(),\n                    max_output_size,\n                    LIMITED_OUTPUT,\n                    table_type,\n                    USING_EXT_DICT,\n                    NO_DICT_ISSUE,\n                    acceleration,\n                );\n            }\n        }\n        (*stream_ptr).dictionary = source as *const u8;\n        (*stream_ptr).dictSize = input_size as u32;\n        result\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn LZ4_compress_forceExtDict(\n    lz4_dict: *mut LZ4_stream_t,\n    source: *const c_char,\n    dest: *mut c_char,\n    src_size: c_int,\n) -> c_int {\n    let stream_ptr = lz4_dict as *mut LZ4_stream_t_internal;\n    let result: c_int;\n\n    LZ4_renormDictT(stream_ptr, src_size);\n\n    if (*stream_ptr).dictSize < 64 * 1024 && (*stream_ptr).dictSize < (*stream_ptr).currentOffset {\n        result = LZ4_compress_generic(\n            stream_ptr,\n            source,\n            dest,\n            src_size,\n            ptr::null_mut(),\n            0,\n            NOT_LIMITED,\n            BY_U32,\n            USING_EXT_DICT,\n            DICT_SMALL,\n            1,\n        );\n    } else {\n      