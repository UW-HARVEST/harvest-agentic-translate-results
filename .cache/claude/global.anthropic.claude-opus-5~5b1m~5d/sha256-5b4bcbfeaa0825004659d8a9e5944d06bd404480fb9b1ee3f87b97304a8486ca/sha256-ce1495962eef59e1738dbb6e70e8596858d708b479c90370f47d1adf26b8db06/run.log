se, where the C's `int` addition","+/// wraps to a negative index (both then read out of bounds and fault) and a","+/// Rust debug build would otherwise panic on overflow instead."," unsafe fn smoothen(v: *mut f64, length: c_int) {","     let mut i: c_int = 0;","     while i < length {","         let mut sum: f64 = 0.0;","         let mut j: c_int = 0;","-        while j < N_SMOOTH && i + j < length {","+        while j < N_SMOOTH && i.wrapping_add(j) < length {","             //     movsd (%rax),%xmm0        ; xmm0 = v[i + j]","             //     movsd -0x8(%rbp),%xmm1    ; xmm1 = sum","             //     addsd %xmm1,%xmm0         ; dst is v[i + j]","-            sum = addsd(unsafe { *v.offset((i + j) as isize) }, sum);","+            sum = addsd(unsafe { *v.offset(i.wrapping_add(j) as isize) }, sum);","             j += 1;","         }","         unsafe { *v.offset(i as isize) = divsd(sum, N_SMOOTH as f64) };"]}],"userModified":false,"replaceAll":false}}
