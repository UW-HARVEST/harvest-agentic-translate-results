ame categories.","+    let cu = undefined(&c_lib_path());","+    println!(\"C .so undefined symbols ({}): {cu:?}\", cu.len());"," }"," "," /// Sanity: the two `.so`s really are two different files, and both are loadable"]}],"userModified":false,"replaceAll":false}}
