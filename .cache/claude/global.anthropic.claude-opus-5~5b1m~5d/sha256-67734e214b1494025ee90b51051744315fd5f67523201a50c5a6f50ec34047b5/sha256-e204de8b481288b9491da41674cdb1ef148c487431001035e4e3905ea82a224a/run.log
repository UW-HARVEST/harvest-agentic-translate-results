" $'1.9\\n'\nrun \"nul first\" $'\\0005\\n'\nrun \"nul after digits\" $'5\\000abc\\n'\nrun \"cr\" $'5\\r\\n'\nrun \"multi space\" $'  \\n'\nrun \"99 chars\" \"$(python3 -c \"print('1'*98)\")\"\nrun \"100 chars digits\" \"$(python3 -c \"print('1'*99)\")\"\nrun \"long then num\" \"$(python3 -c \"print(' '*99 + '42')\")\"\nrun \"98spaces+num\" \"$(python3 -c \"print(' '*98 + '42')\")\"\nrun \"sign only at 99\" \"$(python3 -c \"print('9'*120)\")\"\n","description":"Differential test over many inputs"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":596,"cache_read_input_tokens":19965,"cache_creation":{"ephemeral_5m_input_tokens":596,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"f895a661-e031-423c-b9b8-b640eb77d1e6","uuid":"59fa6089-112c-4f12-a569-cfc728fc6049","timestamp":"2026-08-28T13:54:43.132Z"}
