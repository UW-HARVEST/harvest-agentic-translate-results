ses the return of a\n88\t// local address (`-Wreturn-local-addr`) and emits `mov $0x0, %eax` for the\n89\t// return value, i.e. `helperBad` hands back a NULL pointer. Verified on the\n90\t// reference build at both -O0 and -O2:\n91\t//\n92\t//     000000000000115b <helperBad>:\n93\t//       ...\n94\t//       117f:  mov    $0x0,%eax        # returns NULL\n95\t//       1184:  pop    %rbp\n96\t//       1185:  ret\n97\t//\n98\t// Consequently `bad()` calls `printLine(NULL)`, which prints nothing at all --\n99\t// the string \"helperBad string\" never reaches the output. Returning a real\n100\t// pointer to a local buffer here (or, worse, a pointer to a static/leaked copy)\n101\t// would print a line the C library does not print and would break byte-for-byte\n102\t// output equivalence.\n103\tfn helperBad() -> *mut c_char {\n104\t    // The local `charString` is materialised exactly as the C compiler does\n105\t    // (the bytes are built up in the frame) and then discarded, because the\n106\t    // dead store is not observable and the returned value is NULL.\n107\t    let _charString: [c_char; 17] = {\n108\t        let mut buf = [0 as c_char; 17];\n109\t        let src = b\"helperBad string\\0\";\n110\t        let mut i = 0;\n111\t        while i < src.len() {\n112\t            buf[i] = src[i] as c_char;\n113\t            i += 1;\n114\t        }\n115\t        buf\n116\t    };\n117\t\n118\t    core::ptr::null_mut()\n119\t}\n120\t\n121\t// ---------------------------------------------------------------------------\n122\t// void bad()\n123\t// ---------------------------------------------------------------------------\n124\t//\n125\t//     void bad()\n126\t//     {\n127\t//         printLine(helperBad());\n128\t//     }\n129\t\n130\t#[unsafe(no_mangle)]\n131\tpub unsafe extern \"C\" fn bad() {\n132\t    printLine(helperBad());\n133\t}\n134\t\n135\t// ---------------------------------------------------------------------------\n136\t// static char *helperGood1()\n137\t// ---