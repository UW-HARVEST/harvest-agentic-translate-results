{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_7b4pwddmrmmtmuumt7ki6olt4oty2ud4yhikqeg4qs7yvlcwtpga","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_012zgz6BZFTWbxfs3GXTHLzE","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-aOKjLC/translation/tests/smoke.rs","content":"// Harness self-check: proves the capture mechanism and both `.so` loads work\n// before any of the real differential suites are trusted.\n\nmod common;\n\nuse common::*;\n\n#[test]\nfn both_libraries_load_and_expose_all_four_symbols() {\n    let c = c_lib();\n    let r = rust_lib();\n    println!(\"C   .so: {:?}\", c.path);\n    println!(\"Rust.so: {:?}\", r.path);\n    // Resolution happened in `Lib::load`; reaching here means all four `dlsym`\n    // lookups succeeded in both objects.\n    assert_eq!(c.name, \"C\");\n    assert_eq!(r.name, \"Rust\");\n}\n\n#[test]\nfn capture_actually_captures_library_output() {\n    // If the capture were broken (e.g. it always returned an empty Vec) every\n    // differential test would pass vacuously. Pin a known-non-empty output.\n    let out = capture(|| unsafe { c_lib().good_raw() });\n    assert_eq!(\n        out, GOOD_OUTPUT,\n        \"capture of the C good() did not produce the expected bytes\"\n    );\n    let out = capture(|| unsafe { rust_lib().good_raw() });\n    assert_eq!(\n        out, GOOD_OUTPUT,\n        \"capture of the Rust good() did not produce the expected bytes\"\n    );\n}\n\n#[test]\nfn capture_is_isolated_between_calls() {\n    let a = capture(|| unsafe { c_lib().good_raw() });\n    let b = capture(|| {});\n    let c = capture(|| unsafe { c_lib().good_raw() });\n    assert_eq!(a, GOOD_OUTPUT);\n    assert!(b.is_empty(), \"leaked bytes into a no-op capture: {b:?}\");\n    assert_eq!(c, GOOD_OUTPUT);\n}\n\n#[test]\nfn capture_survives_large_output() {\n    // 1 MiB in one go: makes sure the scratch-file capture does not deadlock or\n    // truncate the way a fixed-size pipe would.\n    let payload = vec![b'Z'; 1 << 20];\n    let out = with_cstr(&payload, |p| capture(|| unsafe { c_lib().print_line_raw(p) }));\n    assert_eq!(out.len(), (1 << 20) + 1);\n}\n\n#[test]\nfn rng_is_deterministic() {\n    let mut a = Rng::new(7);\n    let mut b = Rng::new(7);\n    for _ in 0..100 {\n        assert_eq!(a.next_u64(), b.next_u64());\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5331,"cache_read_input_tokens":43582,"cache_creation":{"ephemeral_5m_input_tokens":5331,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"b6a4d4fe-b39f-49eb-8eeb-f9032072843f","uuid":"a726e66d-1215-4d57-967c-8b727774f6cd","timestamp":"2026-08-28T12:42:14.848Z"}
