-------------------------------------------\n38\textern \"C\" {\n39\t    fn malloc(size: usize) -> *mut c_void;\n40\t    fn realloc(ptr: *mut c_void, size: usize) -> *mut c_void;\n41\t    fn free(ptr: *mut c_void);\n42\t\n43\t    fn strlen(s: *const c_char) -> usize;\n44\t    fn strcpy(dst: *mut c_char, src: *const c_char) -> *mut c_char;\n45\t    fn strcmp(a: *const c_char, b: *const c_char) -> c_int;\n46\t\n47\t    fn sprintf(buf: *mut c_char, fmt: *const c_char, ...) -> c_int;\n48\t    fn printf(fmt: *const c_char, ...) -> c_int;\n49\t}\n50\t\n51\t/// `typedef struct { char *data; int capacity; int length; } StringBuffer;`\n52\t#[repr(C)]\n53\tpub struct StringBuffer {\n54\t    pub data: *mut c_char,\n55\t    pub capacity: c_int,\n56\t    pub length: c_int,\n57\t}\n58\t\n59\t/// C converts a (possibly negative) `int` argument to the `size_t` parameter of\n60\t/// `malloc`/`realloc` by sign-extending it to pointer width.\n61\t#[inline]\n62\tfn int_to_size(v: c_int) -> usize {\n63\t    v as isize as usize\n64\t}\n65\t\n66\t/// C's `a / b` for a non-zero divisor.\n67\t///\n68\t/// For every representable quotient this is plain truncating division, matching\n69\t/// Rust's `/`. The one remaining case, `INT_MIN / -1`, is undefined in C; the\n70\t/// code gcc actually emits is a bare `idiv`, which raises `SIGFPE` because the\n71\t/// quotient does not fit in `eax`. Rust's `/` would instead panic, so the raw\n72\t/// instruction is issued to keep the observable behaviour identical.\n73\t#[inline]\n74\tunsafe fn c_div(a: c_int, b: c_int) -> c_int {\n75\t    #[cfg(target_arch = \"x86_64\")]\n76\t    {\n77\t        let mut quot: c_int = a;\n78\t        let mut _rem: c_int;\n79\t        core::arch::asm!(\n80\t            \"cdq\",\n81\t            \"idiv {divisor:e}\",\n82\t            divisor = in(reg) b,\n83\t            inout(\"eax\") quot,\n84\t            out(\"edx\") _rem,\n85\t            options(nostack),\n86\t        );\n87\t        quot\n88\t    }\n89\t    #[cfg(no