mpl Stdin {\n43\t    fn new() -> Self {\n44\t        Stdin {\n45\t            inner: io::stdin(),\n46\t            peeked: None,\n47\t            eof: false,\n48\t        }\n49\t    }\n50\t\n51\t    /// Read a single byte, `None` on EOF (or read error, like C's stdio which\n52\t    /// reports both through a NULL/EOF return here).\n53\t    fn read_byte(&mut self) -> Option<u8> {\n54\t        if let Some(b) = self.peeked.take() {\n55\t            return Some(b);\n56\t        }\n57\t        if self.eof {\n58\t            return None;\n59\t        }\n60\t        let mut buf = [0u8; 1];\n61\t        loop {\n62\t            match self.inner.read(&mut buf) {\n63\t                Ok(0) => {\n64\t                    self.eof = true;\n65\t                    return None;\n66\t                }\n67\t                Ok(_) => return Some(buf[0]),\n68\t                Err(ref e) if e.kind() == io::ErrorKind::Interrupted => continue,\n69\t                Err(_) => {\n70\t                    self.eof = true;\n71\t                    return None;\n72\t                }\n73\t            }\n74\t        }\n75\t    }\n76\t\n77\t    /// Faithful `fgets(buf, size, stdin)`.\n78\t    ///\n79\t    /// Stores at most `size - 1` bytes plus a terminating NUL into `buf`,\n80\t    /// stopping after a newline (which is kept) or at EOF. Returns `false`\n81\t    /// (the NULL return of C) when EOF is hit before any byte was read.\n82\t    fn fgets(&mut self, buf: &mut [u8], size: usize) -> bool {\n83\t        if size == 0 {\n84\t            return false;\n85\t        }\n86\t        let mut n = 0usize;\n87\t        while n + 1 < size {\n88\t            match self.read_byte() {\n89\t                Some(b) => {\n90\t                    buf[n] = b;\n91\t                    n += 1;\n92\t                    if b == b'\\n' {\n93\t                        break;\n94\t                    }\n95\t                }\n96\t                None => {\n97\t                    if n == 0 {\n98\t                        // EOF with nothing read -> NULL\n99\t                        return false;\n100\t                    }\n101\t                    break;\n102\t                }\n103\t            }\n104\t        }\n105\t        buf[n] = 0;\n106\t        true\n107\t    }\n108\t}\n109\t\n110\t/// Buffered stdout, flushed once at the end, matching C's buffered `printf`\n111\t/// byte stream (glibc uses a 4096 byte block buffer for non-tty streams; the\n112\t/// buffer contents are lost if the process dies from a signal).\n113\tstruct Stdout {\n114\t    out: io::BufWriter<io::Stdout>,\n115\t}\n116\t\n117\timpl Stdout {\n118\t    fn new() -> Self {\n119\t        Stdout {\n120\t            out: io::BufWriter::with_capacity(4096, io::stdout()),\n121\t        }\n122\t    }\n123\t\n124\t    fn write_str(&mut self, s: &str) {\n125\t        // Ignore write errors, as C's printf return value is ignored here.\n126\t        let _ = self.out.write_all(s.as_bytes());\n127\t    }\n128\t\n129\t    fn flush(&mut self) {\n130\t        let _ = self.out.flush();\n131\t    }\n132\t}\n133\t\n134\t// ---------------------------------------------------------------------------\n135\t// libc helpers\n136\t// ---------------------------------------------------------------------------\n137\t\n138\tfn c_isspace(b: u8) -> bool {\n139\t    matches!(b, b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r')\n140\t}\n141\t\n142\t/// glibc's `atoi`, i.e. `(int) strtol(nptr, NULL, 10)`:\n143\t/// leading whitespace is skipped, an optional sign is accepted, decimal\n144\t/// digits are accumulated saturating at LONG_MIN/LONG_MAX, and the resulting\n145\t/// `long` is truncated to `int`.\n146\tfn c_atoi(bytes: &[u8]) -> i32 {\n147\t    // Only the NUL-terminated prefix is visible to atoi.\n148\t    let s: &[u8] = match bytes.iter().position(|&b| b == 0) {\n149\t        Some(p) => &bytes[..p],\n150\t        None => bytes,\n151\t    };\n152\t\n153\t    let mut i = 0usize;\n154\t    while i < s.len() && c_isspace(s[i]) {\n155\t        i += 1;\n156\t    }\n157\t\n158\t    let mut negative = false;\n159\t    if i < s.len() && (s[i] == b'+' || s[i] == b'-') {\n160\t        negative = s[i] == b'-';\n161\t        i += 1;\n162\t    }\n163\t\n164\t    let mut acc: i64 = 0;\n165\t    let mut overflow = false;\n166\t    while i < s.len() && s[i].is_ascii_digit() {\n167\t        let d = i64::from(s[i] - b'0');\n168\t        if !overflow {\n169\t            match acc.checked_mul(10).and_then(|v| v.checked_add(d)) {\n170\t                Some(v) => acc = v,\n171\t                None => overflow = true,\n172\t            }\n173\t        }\n174\t        i += 1;\n175\t    }\n176\t\n177\t    let value: i64 = if overflow {\n178\t        if negative {\n179\t            i64::MIN\n180\t        } else {\n181\t            i64::MAX\n182\t        }\n183\t    } else if negative {\n184\t        -acc\n185\t    } else {\n186\t        acc\n187\t    };\n188\t\n189\t    // (int) truncation of a long.\n190\t    value as i32\n191\t}\n192\t\n193\t// ---------------------------------------------------------------------------\n194\t// program\n195\t// ---------------------------------------------------------------------------\n196\t\n197\tfn print_line(out: &mut Stdout, line: Option<&str>) {\n198\t    if let Some(line) = line {\n199\t        out.write_str(line);\n200\t        out.write_str(\"\\n\");\n201\t    }\n202\t}\n203\t\n204\tfn print_int_line(out: &mut Stdout, int_number: i32) {\n205\t    out.write_str(&format!(\"{}\\n\", int_number));\n206\t}\n207\t\n208\t/// Number of `int` slots past the end of `buffer` that the reference platform\n209\t/// still has mapped stack memory for. Writes closer than this land in unused\n210\t/// stack space and are invisible; writes beyond it hit unmapped pages and kill\n211\t/// the process with SIGSEGV.\n212\tconst MAPPED_STACK_SLOTS_PAST_BUFFER: i64 = 5000;\n213\t\n214\t/// `buffer[data] = 1` where `buffer` is `int buffer[10]`.\n215\t///\n216\t/// The C code performs an out-of-bounds stack write whenever `data >= 10`\n217\t/// (CWE-787). This reproduces the observed behaviour of the compiled C:\n218\t///  * `0 <= data < 10`: normal in-bounds store.\n219\t///  * moderately out of bounds: the store lands in unrelated stack padding and\n220\t///    has no effect on the ten values printed afterwards.\n221\t///  * far out of bounds: the process dies with SIGSEGV before any of the\n222\t///    buffered stdout data is written out.\n223\tfn store_one(buffer: &mut [i32; 10], data: i32) {\n224\t    let idx = i64::from(data);\n225\t    if idx >= 0 && (idx as usize) < buffer.len() {\n226\t        buffer[idx as usize] = 1;\n227\t    } else if idx >= buffer.len() as i64 + MAPPED_STACK_SLOTS_PAST_BUFFER {\n228\t        segfault();\n229\t    }\n230\t    // Otherwise: write discarded (lands in unused stack space).\n231\t}\n232\t\n233\t/// Reproduce the fatal invalid write of the original C program.\n234\tfn segfault() -> ! {\n235\t    // A volatile write through a null pointer, which the platform turns into\n236\t    // the same SIGSEGV the C program dies from.\n237\t    unsafe {\n238\t        std::ptr::write_volatile(std::ptr::null_mut::<i32>(), 1);\n239\t    }\n240\t    std::process::abort();\n241\t}\n242\t\n243\tfn bad(out: &mut Stdout, stdin: &mut Stdin) {\n244\t    let mut data: i32;\n245\t    /* Initialize data */\n246\t    data = -1;\n247\t    {\n248\t        let mut input_buffer = [0u8; 14];\n249\t        if stdin.fgets(&mut input_buffer, 14) {\n250\t            /* Convert to int */\n251\t            data = c_atoi(&input_buffer);\n252\t        } else {\n253\t            print_line(out, Some(\"fgets() failed.\"));\n254\t        }\n255\t    }\n256\t    {\n257\t        let mut buffer: [i32; 10] = [0; 10];\n258\t        if data >= 0 {\n259\t            store_one(&mut buffer, data);\n260\t            /* Print the array values */\n261\t            for i in 0..10 {\n262\t                print_int_line(out, buffer[i]);\n263\t            }\n264\t        } else {\n265\t            print_line(out, Some(\"ERROR: Array index is negative.\"));\n266\t        }\n267\t    }\n268\t}\n269\t\n270\t/* goodG2B uses the GoodSource with the BadSink */\n271\tfn good_g2b(out: &mut Stdout) {\n272\t    let mut data: i32;\n273\t    /* Initialize data */\n274\t    data = -1;\n275\t    let _ = data;\n276\t    data = 7;\n277\t    {\n278\t        let mut buffer: [i32; 10] = [0; 10];\n279\t        if data >= 0 {\n280\t            store_one(&mut buffer, data);\n281\t            /* Print the array values */\n282\t            for i in 0..10 {\n283\t                print_int_line(out, buffer[i]);\n284\t            }\n285\t        } else {\n286\t            print_line(out, Some(\"ERROR: Array index is negative.\"));\n287\t        }\n288\t    }\n289\t}\n290\t\n291\t/* goodB2G uses the BadSource with the GoodSink */\n292\tfn good_b2g(out: &mut Stdout, stdin: &mut Stdin) {\n293\t    let mut data: i32;\n294\t    /* Initialize data */\n295\t    data = -1;\n296\t    {\n297\t        let mut input_buffer = [0u8; 14];\n298\t        if stdin.fgets(&mut input_buffer, 14) {\n299\t            /* Convert to int */\n300\t            data = c_atoi(&input_buffer);\n301\t        } else {\n302\t            print_line(out, Some(\"fgets() failed.\"));\n303\t        }\n304\t    }\n305\t    {\n306\t        let mut buffer: [i32; 10] = [0; 10];\n307\t        if data >= 0 && data < 10 {\n308\t            store_one(&mut buffer, data);\n309\t            /* Print the array values */\n310\t            for i in 0..10 {\n311\t                print_int_line(out, buffer[i]);\n312\t            }\n313\t        } else {\n314\t            print_line(out, Some(\"ERROR: Array index is out-of-bounds\"));\n315\t        }\n316\t    }\n317\t}\n318\t\n319\tfn good(out: &mut Stdout, stdin: &mut Stdin) {\n320\t    good_g2b(out);\n321\t    good_b2g(out, stdin);\n322\t}\n323\t\n324\tfn main() {\n325\t    let mut out = Stdout::new();\n326\t    let mut stdin = Stdin::new();\n327\t\n328\t    print_line(&mut out, Some(\"Calling good()...\"));\n329\t    good(&mut out, &mut stdin);\n330\t    print_line(&mut out, Some(\"Finished good()\"));\n331\t    print_line(&mut out, Some(\"Calling bad()...\"));\n332\t    bad(&mut out, &mut stdin);\n333\t    print_line(&mut out, Some(\"Finished bad()\"));\n334\t\n335\t    out.flush();\n336\t    std::process::exit(0);\n337\t}\n338\t"}]},"parent_tool_use_id":null,"session_id":"f5b3f3ed-1cac-489d-b784-afa61a974c15","uuid":"75ce6bcc-9183-4ba5-8b5b-9264097a5be0","timestamp":"2026-08-28T10:48:35.327Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-xdlMU9/translation/src/main.rs","content":"// Rust translation of c_src/src/main.c\n//\n// Original copyright notice from the C source:\n//\n// Copyright 2025 MIT Lincoln Laboratory\n// Permission is hereby granted, free of charge,\n// to any person obtaining a copy of this software\n// and associated documentation files (the \"Software\"),\n// to deal in the Software without restriction,\n// including without limitation the rights to use, copy,\n// modify, merge, publish, distribute, sublicense,\n// and/or sell copies of the Software,\n// and to permit persons to whom the Software is furnished to do so,\n// subject to the following conditions:\n//\n// The above copyright notice and this permission notice\n// shall be included in all copies or substantial portions of the Software.\n//\n// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n// THE WARRANTIES OF MERCHANTABILITY,\n// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n\nuse std::io::{self, Read, Write};\n\n// ---------------------------------------------------------------------------\n// stdio emulation\n// ---------------------------------------------------------------------------\n\n/// A single, process-wide stdin byte source, mirroring C's single `stdin`\n/// FILE stream: reads pick up exactly where the previous read stopped.\nstruct Stdin {\n    inner: io::Stdin,\n    peeked: Option<u8>,\n    eof: bool,\n}\n\nimpl Stdin {\n    fn new() -> Self {\n        Stdin {\n            inner: io::stdin(),\n            peeked: None,\n            eof: false,\n        }\n    }\n\n    /// Read a single byte, `None` on EOF (or read error, like C's stdio which\n    /// reports both through a NULL/EOF return here).\n    fn read_byte(&mut self) -> Option<u8> {\n        if let Some(b) = self.peeked.take() {\n            return Some(b);\n        }\n        if self.eof {\n            return None;\n        }\n        let mut buf = [0u8; 1];\n        loop {\n            match self.inner.read(&mut buf) {\n                Ok(0) => {\n                    self.eof = true;\n                    return None;\n                }\n                Ok(_) => return Some(buf[0]),\n                Err(ref e) if e.kind() == io::ErrorKind::Interrupted => continue,\n                Err(_) => {\n                    self.eof = true;\n                    return None;\n                }\n            }\n        }\n    }\n\n    /// Faithful `fgets(buf, size, stdin)`.\n    ///\n    /// Stores at most `size - 1` bytes plus a terminating NUL into `buf`,\n    /// stopping after a newline (which is kept) or at EOF. Returns `false`\n    /// (the NULL return of C) when EOF is hit before any byte was read.\n    fn fgets(&mut self, buf: &mut [u8], size: usize) -> bool {\n        if size == 0 {\n            return false;\n        }\n        let mut n = 0usize;\n        while n + 1 < size {\n            match self.read_byte() {\n                Some(b) => {\n                    buf[n] = b;\n                    n += 1;\n                    if b == b'\\n' {\n                        break;\n                    }\n                }\n                None => {\n                    if n == 0 {\n                        // EOF with nothing read -> NULL\n                        return false;\n                    }\n                    break;\n                }\n            }\n        }\n        buf[n] = 0;\n        true\n    }\n}\n\n/// Buffered stdout, flushed once at the end, matching C's buffered `printf`\n/// byte stream (glibc uses a 4096 byte block buffer for non-tty streams; the\n/// buffer contents are lost if the process dies from a signal).\nstruct Stdout {\n    out: io::BufWriter<io::Stdout>,\n}\n\nimpl Stdout {\n    fn new() -> Self {\n        Stdout {\n            out: io::BufWriter::with_capacity(4096, io::stdout()),\n        }\n    }\n\n    fn write_str(&mut self, s: &str) {\n        // Ignore write errors, as C's printf return value is ignored here.\n        let _ = self.out.write_all(s.as_bytes());\n    }\n\n    fn flush(&mut self) {\n        let _ = self.out.flush();\n    }\n}\n\n// ---------------------------------------------------------------------------\n// libc helpers\n// ---------------------------------------------------------------------------\n\nfn c_isspace(b: u8) -> bool {\n    matches!(b, b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r')\n}\n\n/// glibc's `atoi`, i.e. `(int) strtol(nptr, NULL, 10)`:\n/// leading whitespace is skipped, an optional sign is accepted, decimal\n/// digits are accumulated saturating at LONG_MIN/LONG_MAX, and the resulting\n/// `long` is truncated to `int`.\nfn c_atoi(bytes: &[u8]) -> i32 {\n    // Only the NUL-terminated prefix is visible to atoi.\n    let s: &[u8] = match bytes.iter().position(|&b| b == 0) {\n        Some(p) => &bytes[..p],\n        None => bytes,\n    };\n\n    let mut i = 0usize;\n    while i < s.len() && c_isspace(s[i]) {\n        i += 1;\n    }\n\n    let mut negative = false;\n    if i < s.len() && (s[i] == b'+' || s[i] == b'-') {\n        negative = s[i] == b'-';\n        i += 1;\n    }\n\n    let mut acc: i64 = 0;\n    let mut overflow = false;\n    while i < s.len() && s[i].is_ascii_digit() {\n        let d = i64::from(s[i] - b'0');\n        if !overflow {\n            match acc.checked_mul(10).and_then(|v| v.checked_add(d)) {\n                Some(v) => acc = v,\n                None => overflow = true,\n            }\n        }\n        i += 1;\n    }\n\n    let value: i64 = if overflow {\n        if negative {\n            i64::MIN\n        } else {\n            i64::MAX\n        }\n    } else if negative {\n        -acc\n    } else {\n        acc\n    };\n\n    // (int) truncation of a long.\n    value as i32\n}\n\n// ---------------------------------------------------------------------------\n// program\n// ---------------------------------------------------------------------------\n\nfn print_line(out: &mut Stdout, line: Option<&str>) {\n    if let Some(line) = line {\n        out.write_str(line);\n        out.write_str(\"\\n\");\n    }\n}\n\nfn print_int_line(out: &mut Stdout, int_number: i32) {\n    out.write_str(&format!(\"{}\\n\", int_number));\n}\n\n/// Number of `int` slots past the end of `buffer` that the reference platform\n/// still has mapped stack memory for. Writes closer than this land in unused\n/// stack space and are invisible; writes beyond it hit unmapped pages and kill\n/// the process with SIGSEGV.\nconst MAPPED_STACK_SLOTS_PAST_BUFFER: i64 = 5000;\n\n/// `buffer[data] = 1` where `buffer` is `int buffer[10]`.\n///\n/// The C code performs an out-of-bounds stack write whenever `data >= 10`\n/// (CWE-787). This reproduces the observed behaviour of the compiled C:\n///  * `0 <= data < 10`: normal in-bounds store.\n///  * moderately out of bounds: the store lands in unrelated stack padding and\n///    has no effect on the ten values printed afterwards.\n///  * far out of bounds: the process dies with SIGSEGV before any of the\n///    buffered stdout data is written out.\nfn store_one(buffer: &mut [i32; 10], data: i32) {\n    let idx = i64::from(data);\n    if idx >= 0 && (idx as usize) < buffer.len() {\n        buffer[idx as usize] = 1;\n    } else if idx >= buffer.len() as i64 + MAPPED_STACK_SLOTS_PAST_BUFFER {\n        segfault();\n    }\n    // Otherwise: write discarded (lands in unused stack space).\n}\n\n/// Reproduce the fatal invalid write of the original C program.\nfn segfault() -> ! {\n    // A volatile write through a null pointer, which the platform turns into\n    // the same SIGSEGV the C program dies from.\n    unsafe {\n        std::ptr::write_volatile(std::ptr::null_mut::<i32>(), 1);\n    }\n    std::process::abort();\n}\n\nfn bad(out: &mut Stdout, stdin: &mut Stdin) {\n    let mut data: i32;\n    /* Initialize data */\n    data = -1;\n    {\n        let mut input_buffer = [0u8; 14];\n        if stdin.fgets(&mut input_buffer, 14) {\n            /* Convert to int */\n            data = c_atoi(&input_buffer);\n        } else {\n            print_line(out, Some(\"fgets() failed.\"));\n        }\n    }\n    {\n        let mut buffer: [i32; 10] = [0; 10];\n        if data >= 0 {\n            store_one(&mut buffer, data);\n            /* Print the array values */\n            for i in 0..10 {\n                print_int_line(out, buffer[i]);\n            }\n        } else {\n            print_line(out, Some(\"ERROR: Array index is negative.\"));\n        }\n    }\n}\n\n/* goodG2B uses the GoodSource with the BadSink */\nfn good_g2b(out: &mut Stdout) {\n    let mut data: i32;\n    /* Initialize data */\n    data = -1;\n    let _ = data;\n    data = 7;\n    {\n        let mut buffer: [i32; 10] = [0; 10];\n        if data >= 0 {\n            store_one(&mut buffer, data);\n            /* Print the array values */\n            for i in 0..10 {\n                print_int_line(out, buffer[i]);\n            }\n        } else {\n            print_line(out, Some(\"ERROR: Array index is negative.\"));\n        }\n    }\n}\n\n/* goodB2G uses the BadSource with the GoodSink */\nfn good_b2g(out: &mut Stdout, stdin: &mut Stdin) {\n    let mut data: i32;\n    /* Initialize data */\n    data = -1;\n    {\n        let mut input_buffer = [0u8; 14];\n        if stdin.fgets(&mut input_buffer, 14) {\n            /* Convert to int */\n            data = c_atoi(&input_buffer);\n        } else {\n            print_line(out, Some(\"fgets() failed.\"));\n        }\n    }\n    {\n        let mut buffer: [i32; 10] = [0; 10];\n        if data >= 0 && data < 10 {\n            store_one(&mut buffer, data);\n            /* Print the array values */\n            for i in 0..10 {\n                print_int_line(out, buffer[i]);\n            }\n        } else {\n            print_line(out, Some(\"ERROR: Array index is out-of-bounds\"));\n        }\n    }\n}\n\nfn good(out: &mut Stdout, stdin: &mut Stdin) {\n    good_g2b(out);\n    good_b2g(out, stdin);\n}\n\nfn main() {\n    let mut out = Stdout::new();\n    let mut stdin = Stdin::new();\n\n    print_line(&mut out, Some(\"Calling good()...\"));\n    good(&mut out, &mut stdin);\n    print_line(&mut out, Some(\"Finished good()\"));\n    print_line(&mut out, Some(\"Calling bad()...\"));\n    bad(&mut out, &mut stdin);\n    print_line(&mut out, Some(\"Finished bad()\"));\n\n    out.flush();\n    std::process::exit(0);\n}\n","numLines":338,"startLine":1,"totalLines":338}}}
