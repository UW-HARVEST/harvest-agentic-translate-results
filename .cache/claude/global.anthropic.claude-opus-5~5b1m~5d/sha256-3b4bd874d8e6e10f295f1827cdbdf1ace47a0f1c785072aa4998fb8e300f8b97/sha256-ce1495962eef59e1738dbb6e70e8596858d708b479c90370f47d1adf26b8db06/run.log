{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01RLXWYn3wYnogd7XrVeDMU8","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/`.\n2\t//!\n3\t//! The C library consists of a single translation unit (`src/lib.c`) exposing a\n4\t//! xorshift128+ style pseudo-random number generator through the public header\n5\t//! `include/lib.h`. The complete exported ABI is the single function\n6\t//! `next_double`.\n7\t\n8\t#![allow(non_camel_case_types)]\n9\t\n10\t/// Mirrors:\n11\t/// ```c\n12\t/// typedef struct cn_rnd_t {\n13\t///     uint64_t state[2];\n14\t/// } cn_rnd_t;\n15\t/// ```\n16\t#[repr(C)]\n17\tpub struct cn_rnd_t {\n18\t    pub state: [u64; 2],\n19\t}\n20\t\n21\t/// Translation of the `static` helper:\n22\t///\n23\t/// ```c\n24\t/// static uint64_t cn_rnd_next(cn_rnd_t *rnd) {\n25\t///     uint64_t x = rnd->state[0];\n26\t///     uint64_t y = rnd->state[1];\n27\t///     rnd->state[0] = y;\n28\t///     x ^= x << 23;\n29\t///     x ^= x >> 17;\n30\t///     x ^= y ^ (y >> 26);\n31\t///     rnd->state[1] = x;\n32\t///     return x + y;\n33\t/// }\n34\t/// ```\n35\t///\n36\t/// Kept private, exactly like the C `static` function (it is not part of the\n37\t/// exported ABI). All arithmetic uses wrapping semantics to match C's unsigned\n38\t/// integer overflow behaviour.\n39\tfn cn_rnd_next(rnd: &mut cn_rnd_t) -> u64 {\n40\t    let mut x: u64 = rnd.state[0];\n41\t    let y: u64 = rnd.state[1];\n42\t    rnd.state[0] = y;\n43\t    x ^= x << 23;\n44\t    x ^= x >> 17;\n45\t    x ^= y ^ (y >> 26);\n46\t    rnd.state[1] = x;\n47\t    x.wrapping_add(y)\n48\t}\n49\t\n50\t/// Translation of:\n51\t///\n52\t/// ```c\n53\t/// double next_double(cn_rnd_t *rnd) {\n54\t///     uint64_t value = cn_rnd_next(rnd);\n55\t///     uint64_t exponent = 1023;\n56\t///     uint64_t mantissa = value >> 12;\n57\t///     uint64_t result = (exponent << 52) | mantissa;\n58\t///     return *(double *)&result - 1.0;\n59\t/// }\n60\t/// ```\n61\t///\n62\t/// The type-punning `*(double *)&result` is reproduced bit-for-bit with\n63\t/// `f64::from_bits`.\n64\t#[unsafe(no_mangle)]\n65\tpub unsafe extern \"C\" fn next_double(rnd: *mut cn_rnd_t) -> f64 {\n66\t    let rnd = unsafe { &mut *rnd };\n67\t    let value: u64 = cn_rnd_next(rnd);\n68\t    let exponent: u64 = 1023;\n69\t    let mantissa: u64 = value >> 12;\n70\t    let result: u64 = (exponent << 52) | mantissa;\n71\t    f64::from_bits(result) - 1.0\n72\t}\n73\t"}]},"parent_tool_use_id":null,"session_id":"7ba30cda-1da0-4e30-a68f-d181b526446a","uuid":"14bc24a3-f0d1-484a-87cc-94f97d7f18d1","timestamp":"2026-09-03T11:10:18.615Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-n9KYBK/translation/src/lib.rs","content":"//! Rust translation of the C library in `c_src/`.\n//!\n//! The C library consists of a single translation unit (`src/lib.c`) exposing a\n//! xorshift128+ style pseudo-random number generator through the public header\n//! `include/lib.h`. The complete exported ABI is the single function\n//! `next_double`.\n\n#![allow(non_camel_case_types)]\n\n/// Mirrors:\n/// ```c\n/// typedef struct cn_rnd_t {\n///     uint64_t state[2];\n/// } cn_rnd_t;\n/// ```\n#[repr(C)]\npub struct cn_rnd_t {\n    pub state: [u64; 2],\n}\n\n/// Translation of the `static` helper:\n///\n/// ```c\n/// static uint64_t cn_rnd_next(cn_rnd_t *rnd) {\n///     uint64_t x = rnd->state[0];\n///     uint64_t y = rnd->state[1];\n///     rnd->state[0] = y;\n///     x ^= x << 23;\n///     x ^= x >> 17;\n///     x ^= y ^ (y >> 26);\n///     rnd->state[1] = x;\n///     return x + y;\n/// }\n/// ```\n///\n/// Kept private, exactly like the C `static` function (it is not part of the\n/// exported ABI). All arithmetic uses wrapping semantics to match C's unsigned\n/// integer overflow behaviour.\nfn cn_rnd_next(rnd: &mut cn_rnd_t) -> u64 {\n    let mut x: u64 = rnd.state[0];\n    let y: u64 = rnd.state[1];\n    rnd.state[0] = y;\n    x ^= x << 23;\n    x ^= x >> 17;\n    x ^= y ^ (y >> 26);\n    rnd.state[1] = x;\n    x.wrapping_add(y)\n}\n\n/// Translation of:\n///\n/// ```c\n/// double next_double(cn_rnd_t *rnd) {\n///     uint64_t value = cn_rnd_next(rnd);\n///     uint64_t exponent = 1023;\n///     uint64_t mantissa = value >> 12;\n///     uint64_t result = (exponent << 52) | mantissa;\n///     return *(double *)&result - 1.0;\n/// }\n/// ```\n///\n/// The type-punning `*(double *)&result` is reproduced bit-for-bit with\n/// `f64::from_bits`.\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn next_double(rnd: *mut cn_rnd_t) -> f64 {\n    let rnd = unsafe { &mut *rnd };\n    let value: u64 = cn_rnd_next(rnd);\n    let exponent: u64 = 1023;\n    let mantissa: u64 = value >> 12;\n    let result: u64 = (exponent << 52) | mantissa;\n    f64::from_bits(result) - 1.0\n}\n","numLines":73,"startLine":1,"totalLines":73}}}
