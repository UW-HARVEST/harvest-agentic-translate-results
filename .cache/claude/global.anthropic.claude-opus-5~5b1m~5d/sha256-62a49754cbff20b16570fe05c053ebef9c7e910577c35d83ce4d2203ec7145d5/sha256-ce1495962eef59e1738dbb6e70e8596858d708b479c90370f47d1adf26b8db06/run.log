vT_[1](r,a), \"c2MulrvT\", t);\n        c2x X; X.p = c; X.r = r;\n        ckv(c2Mulxv_[0](X,a), c2Mulxv_[1](X,a), \"c2Mulxv\", t);\n    }\n    { c2r r0 = c2RotIdentity_[0](), r1 = c2RotIdentity_[1]();\n      ck(feq(r0.c,r1.c) && feq(r0.s,r1.s), \"c2RotIdentity\", 0);\n      c2x x0 = c2xIdentity_[0](), x1 = c2xIdentity_[1]();\n      ck(feq(x0.p.x,x1.p.x)&&feq(x0.p.y,x1.p.y)&&feq(x0.r.c,x1.r.c)&&feq(x0.r.s,x1.r.s), \"c2xIdentity\", 0); }\n\n    /* ---- c2BBVerts / c2MakeProxy ---- */\n    for (int t = 0; t < 50000; t++) {\n        c2AABB bb; bb.min = rv(); bb.max = rv();\n        c2v o0[4], o1[4];\n        memset(o0,0,sizeof o0); memset(o1,0,sizeof o1);\n        c2BBVerts_[0](o0,&bb); c2BBVerts_[1](o1,&bb);\n        ck(memcmp(o0,o1,sizeof o0)==0, \"c2BBVerts\", t);\n\n        int ty = (int)(rnd()%5) - 1;  /* -1..3 : includes out of range */\n        c2Circle ci; ci.p = rv(); ci.r = rf();\n        c2AABB ab; ab.min = rv(); ab.max = rv();\n        c2Capsule ca; ca.a = rv(); ca.b = rv(); ca.r = rf();\n        const void *sh = (ty==1)?(void*)&ci:(ty==2)?(void*)&ab:(void*)&ca;\n        c2Proxy p0, p1;\n        memset(&p0, 0xAB, sizeof p0); memset(&p1, 0xAB, sizeof p1);\n        c2MakeProxy_[0](sh, ty, &p0); c2MakeProxy_[1](sh, ty, &p1);\n        ck(memcmp(&p0,&p1,sizeof p0)==0, \"c2MakeProxy\", t);\n    }\n\n    /* ---- simplex functions ---- */\n    for (int t = 0; t < 200000; t++) {\n        c2Simplex s; unsigned char *raw = (unsigned char*)&s;\n        for (size_t i = 0; i < sizeof s; i++) raw[i] = (unsigned char)(rnd()&0xff);\n        /* make the float fields sane */\n        c2sv *vp = &s.a;\n        for (int i = 0; i < 4; i++) { vp[i].sA = rv(); vp[i].sB = rv(); vp[i].p = rv(); vp[i].u = rf(); vp[i].iA = (int)(rnd()%8); vp[i].iB = (int)(rnd()%8); }\n        s.div = rf(); if (s.div == 0.0f) s.div = 1.0f;\n        s.count = (int)(rnd()%6);   /* 0..5 -> exercises default paths */\n\n        c2Simplex s0 = s, s1 = s;\n        ckf(c2GJKSimplexMetric_[0](&s0), c2GJKSimplex