\r\n    66\t\r\n    67\tc2v c2Clampv(c2v a, c2v lo, c2v hi) {\r\n    68\t\treturn c2Maxv(lo, c2Minv(a, hi));\r\n    69\t}\r\n    70\t\r\n    71\tc2v c2Sub(c2v a, c2v b) {\r\n    72\t\ta.x -= b.x;\r\n    73\t\ta.y -= b.y;\r\n    74\t\treturn a;\r\n    75\t}\r\n    76\t\r\n    77\tfloat c2Dot(c2v a, c2v b) {\r\n    78\t\treturn a.x * b.x + a.y * b.y;\r\n    79\t}\r\n    80\t\r\n    81\tc2r c2RotIdentity(void) {\r\n    82\t\tc2r r;\r\n    83\t\tr.c = 1.0f;\r\n    84\t\tr.s = 0;\r\n    85\t\treturn r;\r\n    86\t}\r\n    87\t\r\n    88\tc2x c2xIdentity(void) {\r\n    89\t\tc2x x;\r\n    90\t\tx.p = c2V(0, 0);\r\n    91\t\tx.r = c2RotIdentity();\r\n    92\t\treturn x;\r\n    93\t}\r\n    94\t\r\n    95\ttypedef struct {\r\n    96\t\tfloat radius;\r\n    97\t\tint count;\r\n    98\t\tc2v verts[8];\r\n    99\t} c2Proxy;\r\n   100\t\r\n   101\tvoid c2BBVerts(c2v *out, c2AABB *bb) {\r\n   102\t\tout[0] = bb->min;\r\n   103\t\tout[1] = c2V(bb->max.x, bb->min.y);\r\n   104\t\tout[2] = bb->max;\r\n   105\t\tout[3] = c2V(bb->min.x, bb->max.y);\r\n   106\t}\r\n   107\t\r\n   108\tvoid c2MakeProxy(const void *shape, C2_TYPE type, c2Proxy *p) {\r\n   109\t\tswitch (type) {\r\n   110\t\t\tcase C2_TYPE_CIRCLE: {\r\n   111\t\t\t\t\t\t     c2Circle *c = (c2Circle *)shape;\r\n   112\t\t\t\t\t\t     p->radius = c->r;\r\n   113\t\t\t\t\t\t     p->count = 1;\r\n   114\t\t\t\t\t\t     p->verts[0] = c->p;\r\n   115\t\t\t\t\t     } break;\r\n   116\t\t\tcase C2_TYPE_AABB: {\r\n   117\t\t\t\t\t\t   c2AABB *bb = (c2AABB *)shape;\r\n   118\t\t\t\t\t\t   p->radius = 0;\r\n   119\t\t\t\t\t\t   p->count = 4;\r\n   120\t\t\t\t\t\t   c2BBVerts(p->verts, bb);\r\n   121\t\t\t\t\t   } break;\r\n   122\t\t\tcase C2_TYPE_CAPSULE: {\r\n   123\t\t\t\t\t\t      c2Capsule *c = (c2Capsule *)shape;\r\n   124\t\t\t\t\t\t      p->radius = c->r;\r\n   125\t\t\t\t\t\t      p->count = 2;\r\n   126\t\t\t\t\t\t      p->verts[0] = c->a;\r\n   127\t\t\t\t\t\t      p->verts[1] = c->b;\r\n   128\t\t\t\t\t      } break;\r\n   129\t\t}\r\n   130\t}\r\n   131\t\r\n   132\ttypedef struct {\r\n   133\t\tc2v sA;\r\n   134\t\tc2v sB;\r\n   135\t\tc2v p;\r\n   136\t\tfloat u;\r\n   137\t\tint iA;\r\n   138\t\tint iB;\r\n   139\t} c2sv;\r\n   140\t\r\n   141\ttypedef struct {\r\n   142\t\tc2sv a, b, c, d;\r\n   143\t\tfloat div;\r\n   144\t\tint count;\r\n   145\t} c2Simplex;\r\n   146\t\r\n   147\tfloat c2Len(c2v a) {\r\n   148\t\treturn sqrtf(c2Dot(a, a));\r\n   149\t}\r\n   150\t\r\n   151\tfloat c2Det2(c2v a, c2v b) {\r\n   152\t\treturn a.x * b.y - a.y * b.x;\r\n   153\t}\r\n   154\t\r\n   155\tfloat c2GJKSimplexMetric(c2Simplex *s) {\r\n   156\t\tswitch (s->count) {\r\n   157\t\t\tdefault:\r\n   158\t\t\tcase 1:\r\n   159\t\t\t\treturn 0;\r\n   160\t\t\tcase 2:\r\n   161\t\t\t\treturn c2Len(c2Sub(s->b.p, s->a.p));\r\n   162\t\t\tcase 3:\r\n   163\t\t\t\treturn c2Det2(c2Sub(s->b.p, s->a.p), c2Sub(s->c.p, s->a.p));\r\n   164\t\t}\r\n   165\t}\r\n   166\t\r\n   167\tc2v c2Mulrv(c2r a, c2v b) {\r\n   168\t\treturn c2V(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y);\r\n   169\t}\r\n   170\t\r\n   171\tc2v c2Add(c2v a, c2v b) {\r\n   172\t\ta.x += b.x;\r\n   173\t\ta.y += b.y;\r\n   174\t\treturn a;\r\n   175\t}\r\n   176\t\r\n   177\tc2v c2Mulxv(c2x a, c2v b) {\r\n   178\t\treturn c2Add(c2Mulrv(a.r, b), a.p);\r\n   179\t}\r\n   180\t\r\n   181\tvoid c22(c2Simplex *s) {\r\n   182\t\tc2v a = s->a.p;\r\n   183\t\tc2v b = s->b.p;\r\n   184\t\tfloat u = c2Dot(b, c2Sub(b, a));\r\n   185\t\tfloat v = c2Dot(a, c2Sub(a, b));\r\n   186\t\tif (v <= 0) {\r\n   187\t\t\ts->a.u = 1.0f;\r\n   188\t\t\ts->div = 1.0f;\r\n   189\t\t\ts->count = 1;\r\n   190\t\t} else if (u <= 0) {\r\n   191\t\t\ts->a = s->b;\r\n   192\t\t\ts->a.u = 1.0f;\r\n   193\t\t\ts->div = 1.0f;\r\n   194\t\t\ts->count = 1;\r\n   195\t\t} else {\r\n   196\t\t\ts->a.u = u;\r\n   197\t\t\ts->b.u = v;\r\n   198\t\t\ts->div = u + v;\r\n   199\t\t\ts->count = 2;\r\n   200\t\t}\r\n   201\t}\r\n   202\t\r\n   203\tvoid c23(c2Simplex *s) {\r\n   204\t\tc2v a = s->a.p;\r\n   205\t\tc2v b = s->b.p;\r\n   206\t\tc2v c = s->c.p;\r\n   207\t\tfloat uAB = c2Dot(b, c2Sub(b, a));\r\n   208\t\tfloat vAB = c2Dot(a, c2Sub(a, b));\r\n   209\t\tfloat uBC = c2Dot(c, c2Sub(c, b));\r\n   210\t\tfloat vBC = c2Dot(b, c2Sub(b, c));\r\n   211\t\tfloat uCA = c2Dot(a, c2Sub(a, c));\r\n   212\t\tfloat vCA = c2Dot(c, c2Sub(c, a));\r\n   213\t\tfloat area = c2Det2(c2Sub(b, a), c2Sub(c, a));\r\n   214\t\tfloat uABC = c2Det2(b, c) * area;\r\n   215\t\tfloat vABC = c2Det2(c, a) * area;\r\n   216\t\tfloat wABC = c2Det2(a, b) * area;\r\n   217\t\tif (vAB <= 0 && uCA <= 0) {\r\n   218\t\t\ts->a.u = 1.0f;\r\n   219\t\t\ts->div = 1.0f;\r\n   220\t\t\ts->count = 1;\r\n   221\t\t} else if (uAB <= 0 && vBC <= 0) {\r\n   222\t\t\ts->a = s->b;\r\n   223\t\t\ts->a.u = 1.0f;\r\n   224\t\t\ts->div = 1.0f;\r\n   225\t\t\ts->count = 1;\r\n   226\t\t} else if (uBC <= 0 && vCA <= 0) {\r\n   227\t\t\ts->a = s->c;\r\n   228\t\t\ts->a.u = 1.0f;\r\n   229\t\t\ts->div = 1.0f;\r\n   230\t\t\ts->count = 1;\r\n   231\t\t} else if (uAB > 0 && vAB > 0 && wABC <= 0) {\r\n   232\t\t\ts->a.u = uAB;\r\n   233\t\t\ts->b.u = vAB;\r\n   234\t\t\ts->div = uAB + vAB;\r\n   235\t\t\ts->count = 2;\r\n   236\t\t} else if (uBC > 0 && vBC > 0 && uABC <= 0) {\r\n   237\t\t\ts->a = s->b;\r\n   238\t\t\ts->b = s->c;\r\n   239\t\t\ts->a.u = uBC;\r\n   240\t\t\ts->b.u = vBC;\r\n   241\t\t\ts->div = uBC + vBC;\r\n   242\t\t\ts->count = 2;\r\n   243\t\t} else if (uCA > 0 && vCA > 0 && vABC <= 0) {\r\n   244\t\t\ts->b = s->a;\r\n   245\t\t\ts->a = s->c;\r\n   246\t\t\ts->a.u = uCA;\r\n   247\t\t\ts->b.u = vCA;\r\n   248\t\t\ts->div = uCA + vCA;\r\n   249\t\t\ts->count = 2;\r\n   250\t\t} else {\r\n   251\t\t\ts->a.u = uABC;\r\n   252\t\t\ts->b.u = vABC;\r\n   253\t\t\ts->c.u = wABC;\r\n   254\t\t\ts->div = uABC + vABC + wABC;\r\n   255\t\t\ts->count = 3;\r\n   256\t\t}\r\n   257\t}\r\n   258\t\r\n   259\tc2v c2Neg(c2v a) {\r\n   260\t\treturn c2V(-a.x, -a.y);\r\n   261\t}\r\n   262\t\r\n   263\tc2v c2Skew(c2v a) {\r\n   264\t\tc2v b;\r\n   265\t\tb.x = -a.y;\r\n   266\t\tb.y = a.x;\r\n   267\t\treturn b;\r\n   268\t}\r\n   269\t\r\n   270\tc2v c2CCW90(c2v a) {\r\n   271\t\tc2v b;\r\n   272\t\tb.x = a.y;\r\n   273\t\tb.y = -a.x;\r\n   274\t\treturn b;\r\n   275\t}\r\n   276\t\r\n   277\tc2v c2D(c2Simplex *s) {\r\n   278\t\tswitch (s->count) {\r\n   279\t\t\tcase 1:\r\n   280\t\t\t\treturn c2Neg(s->a.p);\r\n   281\t\t\tcase 2: {\r\n   282\t\t\t\t\tc2v ab = c2Sub(s->b.p, s->a.p);\r\n   283\t\t\t\t\tif (c2Det2(ab, c2Neg(s->a.p)) > 0)\r\n   284\t\t\t\t\t\treturn c2Skew(ab);\r\n   285\t\t\t\t\treturn c2CCW90(ab);\r\n   286\t\t\t\t}\r\n   287\t\t\tcase 3:\r\n   288\t\t\tdefault:\r\n   289\t\t\t\treturn c2V(0, 0);\r\n   290\t\t}\r\n   291\t}\r\n   292\t\r\n   293\tint c2Support(const c2v *verts, int count, c2v d) {\r\n   294\t\tint imax = 0;\r\n   295\t\tfloat dmax = c2Dot(verts[0], d);\r\n   296\t\tfor (int i = 1; i < count; ++i) {\r\n   297\t\t\tfloat dot = c2Dot(verts[i], d);\r\n   298\t\t\tif (dot > dmax) {\r\n   299\t\t\t\timax = i;\r\n   300\t\t\t\tdmax = dot;\r\n   301\t\t\t}\r\n   302\t\t}\r\n   303\t\treturn imax;\r\n   304\t}\r\n   305\t\r\n   306\tvoid c2Witness(c2Simplex *s, c2v *a, c2v *b) {\r\n   307\t\tfloat den = 1.0f / s->div;\r\n   308\t\tswitch (s->count) {\r\n   309\t\t\tcase 1:\r\n   310\t\t\t\t*a = s->a.sA;\r\n   311\t\t\t\t*b = s->a.sB;\r\n   312\t\t\t\tbreak;\r\n   313\t\t\tcase 2:\r\n   314\t\t\t\t*a = c2Add(c2Mulvs(s->a.sA, (den * s->a.u)),\r\n   315\t\t\t\t\t\tc2Mulvs(s->b.sA, (den * s->b.u)));\r\n   316\t\t\t\t*b = c2Add(c2Mulvs(s->a.sB, (den * s->a.u)),\r\n   317\t\t\t\t\t\tc2Mulvs(s->b.sB, (den * s->b.u)));\r\n   318\t\t\t\tbreak;\r\n   319\t\t\tcase 3:\r\n   320\t\t\t\t*a = c2Add(c2Add(c2Mulvs(s->a.sA, (den * s->a.u)),\r\n   321\t\t\t\t\t\t\tc2Mulvs(s->b.sA, (den * s->b.u))),\r\n   322\t\t\t\t\t\tc2Mulvs(s->c.sA, (den * s->c.u)));\r\n   323\t\t\t\t*b = c2Add(c2Add(c2Mulvs(s->a.sB, (den * s->a.u)),\r\n   324\t\t\t\t\t\t\