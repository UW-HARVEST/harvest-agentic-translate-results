.x,b.x) && feq(a.y,b.y))) { fails++; if (fails<40) printf(\"MISMATCH %s @case %d: c=(%.9g,%.9g) rs=(%.9g,%.9g)\\n\", what, idx, a.x,a.y,b.x,b.y); }\n}\nstatic void cki(int a, int b, const char *what, int idx) {\n    checks++;\n    if (a!=b) { fails++; if (fails<40) printf(\"MISMATCH %s @case %d: c=%d rs=%d\\n\", what, idx, a, b); }\n}\n\nstatic uint32_t st = 12345u;\nstatic uint32_t rnd(void) { st ^= st<<13; st ^= st>>17; st ^= st<<5; return st; }\nstatic float rf(void) {\n    int k = rnd() % 10;\n    if (k == 0) return 0.0f;\n    if (k == 1) return (float)((int)(rnd()%7) - 3);\n    if (k == 2) return ((float)(rnd()%2001) - 1000.0f) / 1000.0f;\n    return ((float)(rnd()%200001) - 100000.0f) / 1000.0f;\n}\nstatic c2v rv(void) { c2v v; v.x = rf(); v.y = rf(); return v; }\n\nint main(void) {\n    H[0] = dlopen(getenv(\"LIBC_SO\"), RTLD_NOW|RTLD_LOCAL);\n    H[1] = dlopen(getenv(\"LIBRS_SO\"), RTLD_NOW|RTLD_LOCAL);\n    if (!H[0] || !H[1]) { printf(\"dlopen failed: %s\\n\", dlerror()); return 2; }\n\n    SYM(c2V, c2v(*)(float,float));\n    SYM(c2Mulvs, c2v(*)(c2v,float));\n    SYM(c2Maxv, c2v(*)(c2v,c2v));\n    SYM(c2Minv, c2v(*)(c2v,c2v));\n    SYM(c2Clampv, c2v(*)(c2v,c2v,c2v));\n    SYM(c2Sub, c2v(*)(c2v,c2v));\n    SYM(c2Dot, float(*)(c2v,c2v));\n    SYM(c2RotIdentity, c2r(*)(void));\n    SYM(c2xIdentity, c2x(*)(void));\n    SYM(c2BBVerts, void(*)(c2v*,c2AABB*));\n    SYM(c2MakeProxy, void(*)(const void*,int,c2Proxy*));\n    SYM(c2Len, float(*)(c2v));\n    SYM(c2Det2, float(*)(c2v,c2v));\n    SYM(c2GJKSimplexMetric, float(*)(c2Simplex*));\n    SYM(c2Mulrv, c2v(*)(c2r,c2v));\n    SYM(c2Add, c2v(*)(c2v,c2v));\n    SYM(c2Mulxv, c2v(*)(c2x,c2v));\n    SYM(c22, void(*)(c2Simplex*));\n    SYM(c23, void(*)(c2Simplex*));\n    SYM(c2Neg, c2v(*)(c2v));\n    SYM(c2Skew, c2v(*)(c2v));\n    SYM(c2CCW90, c2v(*)(c2v));\n    SYM(c2D, c2v(*)(c2Simplex*));\n    SYM(c2Support, int(*)(const c2v*,int,c2v));\n    SYM(c2Witness, void(*)(c2Simplex*,c2v*,c2v*));\n    SYM(c2Div, c2v(*)(c2v,f