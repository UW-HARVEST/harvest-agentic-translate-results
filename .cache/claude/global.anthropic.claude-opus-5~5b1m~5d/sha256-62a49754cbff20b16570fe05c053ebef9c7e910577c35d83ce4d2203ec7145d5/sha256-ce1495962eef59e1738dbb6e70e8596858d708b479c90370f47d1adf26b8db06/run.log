 a = (*s).verts[0].p;\n306\t    let b = (*s).verts[1].p;\n307\t    let u = c2Dot(b, c2Sub(b, a));\n308\t    let v = c2Dot(a, c2Sub(a, b));\n309\t    if v <= 0.0 {\n310\t        (*s).verts[0].u = 1.0f32;\n311\t        (*s).div = 1.0f32;\n312\t        (*s).count = 1;\n313\t    } else if u <= 0.0 {\n314\t        (*s).verts[0] = (*s).verts[1];\n315\t        (*s).verts[0].u = 1.0f32;\n316\t        (*s).div = 1.0f32;\n317\t        (*s).count = 1;\n318\t    } else {\n319\t        (*s).verts[0].u = u;\n320\t        (*s).verts[1].u = v;\n321\t        (*s).div = u + v;\n322\t        (*s).count = 2;\n323\t    }\n324\t}\n325\t\n326\t#[unsafe(no_mangle)]\n327\tpub unsafe extern \"C\" fn c23(s: *mut c2Simplex) {\n328\t    let a = (*s).verts[0].p;\n329\t    let b = (*s).verts[1].p;\n330\t    let c = (*s).verts[2].p;\n331\t    let uAB = c2Dot(b, c2Sub(b, a));\n332\t    let vAB = c2Dot(a, c2Sub(a, b));\n333\t    let uBC = c2Dot(c, c2Sub(c, b));\n334\t    let vBC = c2Dot(b, c2Sub(b, c));\n335\t    let uCA = c2Dot(a, c2Sub(a, c));\n336\t    let vCA = c2Dot(c, c2Sub(c, a));\n337\t    let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n338\t    let uABC = c2Det2(b, c) * area;\n339\t    let vABC = c2Det2(c, a) * area;\n340\t    let wABC = c2Det2(a, b) * area;\n341\t    if vAB <= 0.0 && uCA <= 0.0 {\n342\t        (*s).verts[0].u = 1.0f32;\n343\t        (*s).div = 1.0f32;\n344\t        (*s).count = 1;\n345\t    } else if uAB <= 0.0 && vBC <= 0.0 {\n346\t        (*s).verts[0] = (*s).verts[1];\n347\t        (*s).verts[0].u = 1.0f32;\n348\t        (*s).div = 1.0f32;\n349\t        (*s).count = 1;\n350\t    } else if uBC <= 0.0 && vCA <= 0.0 {\n351\t        (*s).verts[0] = (*s).verts[2];\n352\t        (*s).verts[0].u = 1.0f32;\n353\t        (*s).div = 1.0f32;\n354\t        (*s).count = 1;\n355\t    } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n356\t        (*s).verts[0].u = uAB;\n357\t        (*s).verts[1].u = vAB;\n358\t        (*s).div = uAB + vAB;\n359\t        (*s).count = 2;\n360\t    } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n361\t        (*s).verts[0] = (*s).verts[1];\n362\t        (*s).verts[1] = (*s).verts[2];\n363\t        (*s).verts[0].u = uBC;\n364\t        (*s).verts[1].u = vBC;\n365\t        (*s).div = uBC + vBC;\n366\t        (*s).count = 2;\n367\t    } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n368\t        (*s).verts[1] = (*s).verts[0];\n369\t        (*s).verts[0] = (*s).verts[2];\n370\t        (*s).verts[0].u = uCA;\n371\t        (*s).verts[1].u = vCA;\n372\t        (*s).div = uCA + vCA;\n373\t        (*s).count = 2;\n374\t    } else {\n375\t        (*s).verts[0].u = uABC;\n376\t        (*s).verts[1].u = vABC;\n377\t        (*s).verts[2].u = wABC;\n378\t        (*s).div = uABC + vABC + wABC;\n379\t        (*s).count = 3;\n380\t    }\n381\t}\n382\t\n383\t#[unsafe(no_mangle)]\n384\tpub extern \"C\" fn c2Neg(a: c2v) -> c2v {\n385\t    c2V(-a.x, -a.y)\n386\t}\n387\t\n388\t#[unsafe(no_mangle)]\n389\tpub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n390\t    let mut b = c2v { x: 0.0, y: 0.0 };\n391\t    b.x = -a.y;\n392\t    b.y = a.x;\n393\t    b\n394\t}\n395\t\n396\t#[unsafe(no_mangle)]\n397\tpub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n398\t    let mut b = c2v { x: 0.0, y: 0.0 };\n399\t    b.x = a.y;\n400\t    b.y = -a.x;\n401\t    b\n402\t}\n403\t\n404\t#[unsafe(no_mangle)]\n405\tpub unsafe extern \"C\" fn c2D(s: *mut c2Simplex) -> c2v {\n406\t    match (*s).count {\n407\t        1 => c2Neg((*s).verts[0].p),\n408\t        2 => {\n409\t            let ab = c2Sub((*s).verts[1].p, (*s).verts[0].p);\n410\t            if c2Det2(ab, c2Neg((*s).verts[0].p)) > 0.0 {\n411\t                return c2Skew(ab);\n412\t            }\n413\t            c2CCW90(ab)\n414\t        }\n415\t        // `case 3:` / `default:`\n416\t        _ => c2V(0.0, 0.0),\n417\t    }\n418\t}\n419\t\n420\t#[unsafe(no_mangle)]\n421\tpub unsafe extern \"C\" fn c2Support(verts: *const c2v, count: c_int, d: c2v) -> c_int {\n422\t    let mut imax: c_int = 0;\n423\t    let mut dmax = c2Dot(*verts.add(0), d);\n424\t    let mut i: c_int = 1;\n425\t    while i < count {\n426\t        let dot = c2Dot(*verts.offset(i as isize), d);\n427\t        if dot > dmax {\n428\t            imax = i;\n429\t            dmax = dot;\n430\t        }\n431\t        i += 1;\n432\t    }\n433\t    imax\n434\t}\n435\t\n436\t#[unsafe(no_mangle)]\n437\tpub unsafe extern \"C\" fn c2Witness(s: *mut c2Simplex, a: *mut c2v, b: *mut c2v) {\n438\t    let den = 1.0f32 / (*s).div;\n439\t    match (*s).count {\n440\t        1 => {\n441\t            *a = (*s).verts[0].sA;\n442\t            *b = (*s).verts[0].sB;\n443\t        }\n444\t        2 => {\n445\t            *a = c2Add(\n446\t                c2Mulvs((*s).verts[0].sA, den * (*s).verts[0].u),\n447\t                c2Mulvs((*s).verts[1].sA, den * (*s).verts[1].u),\n448\t            );\n449\t            *b = c2Add(\n450\t                c2Mulvs((*s).verts[0].sB, den * (*s).verts[0].u),\n451\t                c2Mulvs((*s).verts[1].sB, den * (*s).verts[1].u),\n452\t            );\n453\t        }\n454\t        3 => {\n455\t            *a = c2Add(\n456\t                c2Add(\n457\t                    c2Mulvs((*s).verts[0].sA, den * (*s).verts[0].u),\n458\t                    c2Mulvs((*s).verts[1].sA, den * (*s).verts[1].u),\n459\t                ),\n460\t                c2Mulvs((*s).verts[2].sA, den * (*s).verts[2].u),\n461\t            );\n462\t            *b = c2Add(\n463\t                c2Add(\n464\t                    c2Mulvs((*s).verts[0].sB, den * (*s).verts[0].u),\n465\t                    c2Mulvs((*s).verts[1].sB, den * (*s).verts[1].u),\n466\t                ),\n467\t                c2Mulvs((*s).verts[2].sB, den * (*s).verts[2].u),\n468\t            );\n469\t        }\n470\t        _ => {\n471\t            *a = c2V(0.0, 0.0);\n472\t            *b = c2V(0.0, 0.0);\n473\t        }\n474\t    }\n475\t}\n476\t\n477\t#[unsafe(no_mangle)]\n478\tpub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n479\t    c2Mulvs(a, 1.0f32 / b)\n480\t}\n481\t\n482\t#[unsafe(no_mangle)]\n483\tpub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n484\t    c2Div(a, c2Len(a))\n485\t}\n486\t\n487\t#[unsafe(no_mangle)]\n488\tpub unsafe extern \"C\" fn c2L(s: *mut c2Simplex) -> c2v {\n489\t    let den = 1.0f32 / (*s).div;\n490\t    match (*s).count {\n491\t        1 => (*s).verts[0].p,\n492\t        2 => c2Add(\n493\t            c2Mulvs((*s).verts[0].p, den * (*s).verts[0].u),\n494\t            c2Mulvs((*s).verts[1].p, den * (*s).verts[1].u),\n495\t        ),\n496\t        _ => c2V(0.0, 0.0),\n497\t    }\n498\t}\n499\t\n500\t#[unsafe(no_mangle)]\n501\tpub extern \"C\" fn c2MulrvT(a: c2r, b: c2v) -> c2v {\n502\t    c2V(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y)\n503\t}\n504\t\n505\t// ---------------------------------------------------------------------------\n506\t// GJK\n507\t// ---------------------------------------------------------------------------\n508\t\n509\t#[unsafe(no_mangle)]\n510\tpub unsafe extern \"C\" fn c2GJK(\n511\t    A: *const c_void,\n512\t    typeA: C2_TYPE,\n513\t    ax_ptr: *const c2x,\n514\t    B: *const c_void,\n515\t    typeB: C2_TYPE,\n516\t    bx_ptr: *const c2x,\n517\t    outA: *mut c2v,\n518\t    outB: *mut c2v,\n519\t    use_radius: c_int,\n520\t    iterations: *mut c_int,\n521\t    cache: *mut c2GJKCache,\n522\t) -> f32 {\n523\t    let ax: c2x;\n524\t    let bx: c2x;\n525\t    if ax_ptr.is_null() {\n526\t        ax = c2xIdentity();\n527\t    } else {\n528\t        ax = *ax_ptr;\n529\t    }\n530\t    if bx_ptr.is_null() {\n531\t        bx = c2xIdentity();\n532\t    } else {\n533\t        bx = *bx_ptr;\n534\t    }\n535\t    let mut pA: c2Proxy = core::mem::zeroed();\n536\t    let mut pB: c2Proxy = core::mem::zeroed();\n537\t    c2MakeProxy(A, typeA, &mut pA);\n538\t    c2MakeProxy(B, typeB, &mut pB);\n539\t    let mut s: c2Simplex = core::mem::zeroed();\n540\t    // `c2sv *verts = &s.a;`\n541\t    let verts: *mut c2sv = s.verts.as_mut_ptr();\n542\t    let mut cache_was_read: c_int = 0;\n543\t    if !cache.is_null() {\n544\t        let cache_was_good = (*cache).count != 0;\n545\t        if cache_was_good {\n546\t            let mut i: c_int = 0;\n547\t            while i < (*cache).count {\n548\t                let iA = *(*cache).iA.as_ptr().offset(i as isize);\n549\t                let iB = *(*cache).iB.as_ptr().offset(i as isize);\n550\t                let sA = c2Mulxv(ax, *pA.verts.as_ptr().offset(iA as isize));\n551\t                let sB = c2Mulxv(bx, *pB.verts.as_ptr().offset(iB as isize));\n552\t                let v: *mut c2sv = verts.offset(i as isize);\n553\t                (*v).iA = iA;\n554\t                (*v).sA = sA;\n555\t                (*v).iB = iB;\n556\t                (*v).sB = sB;\n557\t                (*v).p = c2Sub((*v).sB, (*v).sA);\n558\t                (*v).u = 0.0;\n559\t                i += 1;\n560\t            }\n561\t            s.count = (*cache).count;\n562\t            s.div = (*cache).div;\n563\t            let metric_old = (*cache).metric;\n564\t            let metric = c2GJKSimplexMetric(&mut s);\n565\t            let min_metric = if metric < metric_old { metric } else { metric_old };\n566\t            let max_metric = if metric > metric_old { metric } else { metric_old };\n567\t            if !(min_metric < max_metric * 2.0f32 && metric < -1.0e8f32) {\n568\t                cache_was_read = 1;\n569\t            }\n570\t        }\n571\t    }\n572\t    if cache_was_read == 0 {\n573\t        s.verts[0].iA = 0;\n574\t        s.verts[0].iB = 0;\n575\t        s.verts[0].sA = c2Mulxv(ax, pA.verts[0]);\n576\t        s.verts[0].sB = c2Mulxv(bx, pB.verts[0]);\n577\t        s.verts[0].p = c2Sub(s.verts[0].sB, s.verts[0].sA);\n578\t        s.verts[0].u = 1.0f32;\n579\t        s.div = 1.0f32;\n580\t        s.count = 1;\n581\t    }\n582\t    let mut saveA: [c_int; 3] = [0; 3];\n583\t    let mut saveB: [c_int; 3] = [0; 3];\n584\t    let mut save_count: c_int = 0;\n585\t    let mut d0: f32 = C2_FLT_MAX;\n586\t    let mut d1: f32 = C2_FLT_MAX;\n587\t    let mut iter: c_int = 0;\n588\t    let mut hit: c_int = 0;\n589\t    while iter < 20 {\n590\t        save_count = s.count;\n591\t        let mut i: c_int = 0;\n592\t        while i < save_count {\n593\t            *saveA.as_mut_ptr().offset(i as isize) = (*verts.offset(i as isize)).iA;\n594\t            *saveB.as_mut_ptr().offset(i as isize) = (*verts.offset(i as isize)).iB;\n595\t            i += 1;\n596\t        }\n597\t        match s.count {\n598\t            1 => {}\n599\t            2 => c22(&mut s),\n600\t            3 => c23(&mut s),\n601\t            _ => {}\n602\t        }\n603\t        if s.count == 3 {\n604\t            hit = 1;\n605\t            break;\n606\t        }\n607\t        let p = c2L(&mut s);\n608\t        d1 = c2Dot(p, p);\n609\t        if d1 > d0 {\n610\t            break;\n611\t        }\n612\t        d0 = d1;\n613\t        let d = c2D(&mut s);\n614\t        if c2Dot(d, d) < C2_FLT_EPSILON * C2_FLT_EPSILON {\n615\t            break;\n616\t        }\n617\t        let iA = c2Support(pA.verts.as_ptr(), pA.count, c2MulrvT(ax.r, c2Neg(d)));\n618\t        let sA = c2Mulxv(ax, *pA.verts.as_ptr().offset(iA as isize));\n619\t        let iB = c2Support(pB.verts.as_ptr(), pB.count, c2MulrvT(bx.r, d));\n620\t        let sB = c2Mulxv(bx, *pB.verts.as_ptr().offset(iB as isize));\n621\t        let v: *mut c2sv = verts.offset(s.count as isize);\n622\t        (*v).iA = iA;\n623\t        (*v).sA = sA;\n624\t        (*v).iB = iB;\n625\t        (*v).sB = sB;\n626\t        (*v).p = c2Sub((*v).sB, (*v).sA);\n627\t        let mut dup: c_int = 0;\n628\t        let mut i: c_int = 0;\n629\t        while i < save_count {\n630\t            if iA == *saveA.as_ptr().offset(i as isize) && iB == *saveB.as_ptr().offset(i as isize) {\n631\t                dup = 1;\n632\t                break;\n633\t            }\n634\t            i += 1;\n635\t        }\n636\t        if dup != 0 {\n637\t            break;\n638\t        }\n639\t        s.count += 1;\n640\t        iter += 1;\n641\t    }\n642\t    let mut a: c2v = core::mem::zeroed();\n643\t    let mut b: c2v = core::mem::zeroed();\n644\t    c2Witness(&mut s, &mut a, &mut b);\n645\t    let mut dist = c2Len(c2Sub(a, b));\n646\t    if hit != 0 {\n647\t        a = b;\n648\t        dist = 0.0;\n649\t    } else if use_radius != 0 {\n650\t        let rA = pA.radius;\n651\t        let rB = pB.radius;\n652\t        if dist > rA + rB && dist > C2_FLT_EPSILON {\n653\t            dist -= rA + rB;\n654\t            let n = c2Norm(c2Sub(b, a));\n655\t            a = c2Add(a, c2Mulvs(n, rA));\n656\t            b = c2Sub(b, c2Mulvs(n, rB));\n657\t            if a.x == b.x && a.y == b.y {\n658\t                dist = 0.0;\n659\t            }\n660\t        } else {\n661\t            let p = c2Mulvs(c2Add(a, b), 0.5f32);\n662\t            a = p;\n663\t            b = p;\n664\t            dist = 0.0;\n665\t        }\n666\t    }\n667\t    if !cache.is_null() {\n668\t        (*cache).metric = c2GJKSimplexMetric(&mut s);\n669\t        (*cache).count = s.count;\n670\t        let mut i: c_int = 0;\n671\t        while i < s.count {\n672\t            let v: *mut c2sv = verts.offset(i as isize);\n673\t            *(*cache).iA.as_mut_ptr().offset(i as isize) = (*v).iA;\n674\t            *(*cache).iB.as_mut_ptr().offset(i as isize) = (*v).iB;\n675\t            i += 1;\n676\t        }\n677\t        (*cache).div = s.div;\n678\t    }\n679\t    if !outA.is_null() {\n680\t        *outA = a;\n681\t    }\n682\t    if !outB.is_null() {\n683\t        *outB = b;\n684\t    }\n685\t    if !iterations.is_null() {\n686\t        *iterations = iter;\n687\t    }\n688\t    dist\n689\t}\n690\t\n691\t// ---------------------------------------------------------------------------\n692\t// Boolean shape-vs-shape tests\n693\t// ---------------------------------------------------------------------------\n694\t\n695\t#[unsafe(no_mangle)]\n696\tpub extern \"C\" fn c2AABBtoAABB(A: c2AABB, B: c2AABB) -> c_int {\n697\t    let d0: c_int = (B.max.x < A.min.x) as c_int;\n698\t    let d1: c_int = (A.max.x < B.min.x) as c_int;\n699\t    let d2: c_int = (B.max.y < A.min.y) as c_int;\n700\t    let d3: c_int = (A.max.y < B.min.y) as c_int;\n701\t    ((d0 | d1 | d2 | d3) == 0) as c_int\n702\t}\n703\t\n704\t#[unsafe(no_mangle)]\n705\tpub extern \"C\" fn c2AABBtoCapsule(A: c2AABB, B: c2Capsule) -> c_int {\n706\t    unsafe {\n707\t        if c2GJK(\n708\t            &A as *const c2AABB as *const c_void,\n709\t            C2_TYPE_AABB,\n710\t            core::ptr::null(),\n711\t            &B as *const c2Capsule as *const c_void,\n712\t            C2_TYPE_CAPSULE,\n713\t            core::ptr::null(),\n714\t            core::ptr::null_mut(),\n715\t            core::ptr::null_mut(),\n716\t            1,\n717\t            core::ptr::null_mut(),\n718\t            core::ptr::null_mut(),\n719\t        ) != 0.0\n720\t        {\n721\t            return 0;\n722\t        }\n723\t    }\n724\t    1\n725\t}\n726\t\n727\t#[unsafe(no_mangle)]\n728\tpub extern \"C\" fn c2CapsuletoCapsule(A: c2Capsule, B: c2Capsule) -> c_int {\n729\t    unsafe {\n730\t        if c2GJK(\n731\t            &A as *const c2Capsule as *const c_void,\n732\t            C2_TYPE_CAPSULE,\n733\t            core::ptr::null(),\n734\t            &B as *const c2Capsule as *const c_void,\n735\t            C2_TYPE_CAPSULE,\n736\t            core::ptr::null(),\n737\t            core::ptr::null_mut(),\n738\t            core::ptr::null_mut(),\n739\t            1,\n740\t            core::ptr::null_mut(),\n741\t            core::ptr::null_mut(),\n742\t        ) != 0.0\n743\t        {\n744\t            return 0;\n745\t        }\n746\t    }\n747\t    1\n748\t}\n749\t\n750\t#[unsafe(no_mangle)]\n751\tpub extern \"C\" fn c2CircletoCircle(A: c2Circle, B: c2Circle) -> c_int {\n752\t    let c = c2Sub(B.p, A.p);\n753\t    let d2 = c2Dot(c, c);\n754\t    let mut r2 = A.r + B.r;\n755\t    r2 = r2 * r2;\n756\t    (d2 < r2) as c_int\n757\t}\n758\t\n759\t#[unsafe(no_mangle)]\n760\tpub extern \"C\" fn c2CircletoAABB(A: c2Circle, B: c2AABB) -> c_int {\n761\t    let L = c2Clampv(A.p, B.min, B.max);\n762\t    let ab = c2Sub(A.p, L);\n763\t    let d2 = c2Dot(ab, ab);\n764\t    let r2 = A.r * A.r;\n765\t    (d2 < r2) as c_int\n766\t}\n767\t\n768\t#[unsafe(no_mangle)]\n769\tpub extern \"C\" fn c2CircletoCapsule(A: c2Circle, B: c2Capsule) -> c_int {\n770\t    let n = c2Sub(B.b, B.a);\n771\t    let ap = c2Sub(A.p, B.a);\n772\t    let da = c2Dot(ap, n);\n773\t    let d2: f32;\n774\t    if da < 0.0 {\n775\t        d2 = c2Dot(ap, ap);\n776\t    } else {\n777\t        let db = c2Dot(c2Sub(A.p, B.b), n);\n778\t        if db < 0.0 {\n779\t            let e = c2Sub(ap, c2Mulvs(n, da / c2Dot(n, n)));\n780\t            d2 = c2Dot(e, e);\n781\t        } else {\n782\t            let bp = c2Sub(A.p, B.b);\n783\t            d2 = c2Dot(bp, bp);\n784\t        }\n785\t    }\n786\t    let r = A.r + B.r;\n787\t    (d2 < r * r) as c_int\n788\t}\n789\t\n790\t#[unsafe(no_mangle)]\n791\tpub unsafe extern \"C\" fn c2Collided(\n792\t    A: *const c_void,\n793\t    typeA: C2_TYPE,\n794\t    B: *const c_void,\n795\t    typeB: C2_TYPE,\n796\t) -> c_int {\n797\t    match typeA {\n798\t        C2_TYPE_CIRCLE => match typeB {\n799\t            C2_TYPE_CIRCLE => c2CircletoCircle(\n800\t                (A as *const c2Circle).read_unaligned(),\n801\t                (B as *const c2Circle).read_unaligned(),\n802\t            ),\n803\t            C2_TYPE_AABB => c2CircletoAABB(\n804\t                (A as *const c2Circle).read_unaligned(),\n805\t                (B as *const c2AABB).read_unaligned(),\n806\t            ),\n807\t            C2_TYPE_CAPSULE => c2CircletoCapsule(\n808\t                (A as *const c2Circle).read_unaligned(),\n809\t                (B as *const c2Capsule).read_unaligned(),\n810\t            ),\n811\t            _ => 0,\n812\t        },\n813\t        C2_TYPE_AABB => match typeB {\n814\t            C2_TYPE_CIRCLE => c2CircletoAABB(\n815\t                (B as *const c2Circle).read_unaligned(),\n816\t                (A as *const c2AABB).read_unaligned(),\n817\t            ),\n818\t            C2_TYPE_AABB => c2AABBtoAABB(\n819\t                (A as *const c2AABB).read_unaligned(),\n820\t                (B as *const c2AABB).read_unaligned(),\n821\t            ),\n822\t            C2_TYPE_CAPSULE => c2AABBtoCapsule(\n823\t                (A as *const c2AABB).read_unaligned(),\n824\t                (B as *const c2Capsule).read_unaligned(),\n825\t            ),\n826\t            _ => 0,\n827\t        },\n828\t        C2_TYPE_CAPSULE => match typeB {\n829\t            C2_TYPE_CIRCLE => c2CircletoCapsule(\n830\t                (B as *const c2Circle).read_unaligned(),\n831\t                (A as *const c2Capsule).read_unaligned(),\n832\t            ),\n833\t            C2_TYPE_AABB => c2AABBtoCapsule(\n834\t                (B as *const c2AABB).read_unaligned(),\n835\t                (A as *const c2Capsule).read_unaligned(),\n836\t            ),\n837\t            C2_TYPE_CAPSULE => c2CapsuletoCapsule(\n838\t                (A as *const c2Capsule).read_unaligned(),\n839\t                (B as *const c2Capsule).read_unaligned(),\n840\t            ),\n841\t            _ => 0,\n842\t        },\n843\t        _ => 0,\n844\t    }\n845\t}\n846\t\n847\t// ---------------------------------------------------------------------------\n848\t// Public entry points\n849\t// ---------------------------------------------------------------------------\n850\t\n851\t/// `void *ptr_from_parts(C2_TYPE typ, float a, float b, float c, float d, float e)`\n852\t///\n853\t/// Note: the C function has no `return` statement for an unrecognised `typ`\n854\t/// (it falls off the end of a non-void function). The returned value in that\n855\t/// case is indeterminate in C; a null pointer is produced here. It is never\n856\t/// dereferenced by `omni_collide`, because `c2Collided` returns 0 for an\n857\t/// unknown type before touching the pointer.\n858\t#[unsafe(no_mangle)]\n859\tpub unsafe extern \"C\" fn ptr_from_parts(\n860\t    typ: C2_TYPE,\n861\t    a: f32,\n862\t    b: f32,\n863\t    c: f32,\n864\t    d: f32,\n865\t    e: f32,\n866\t) -> *mut c_void {\n867\t    match typ {\n868\t        C2_TYPE_CIRCLE => {\n869\t            let circle = malloc(core::mem::size_of::<c2Circle>()) as *mut c2Circle;\n870\t            (*circle).p = c2V(a, b);\n871\t            (*circle).r = c;\n872\t            circle as *mut c_void\n873\t        }\n874\t        C2_TYPE_AABB => {\n875\t            let aabb = malloc(core::mem::size_of::<c2AABB>()) as *mut c2AABB;\n876\t            (*aabb).min = c2V(a, b);\n877\t            (*aabb).max = c2V(c, d);\n878\t            aabb as *mut c_void\n879\t        }\n880\t        C2_TYPE_CAPSULE => {\n881\t            let capsule = malloc(core::mem::size_of::<c2Capsule>()) as *mut c2Capsule;\n882\t            (*capsule).a = c2V(a, b);\n883\t            (*capsule).b = c2V(c, d);\n884\t            (*capsule).r = e;\n885\t            capsule as *mut c_void\n886\t        }\n887\t        _ => core::ptr::null_mut(),\n888\t    }\n889\t}\n890\t\n891\t#[unsafe(no_mangle)]\n892\tpub unsafe extern \"C\" fn omni_collide(\n893\t    type_a: C2_TYPE,\n894\t    a1: f32,\n895\t    a2: f32,\n896\t    a3: f32,\n897\t    a4: f32,\n898\t    a5: f32,\n899\t    type_b: C2_TYPE,\n900\t    b1: f32,\n901\t    b2: f32,\n902\t    b3: f32,\n903\t    b4: f32,\n904\t    b5: f32,\n905\t) -> c_int {\n906\t    let A = ptr_from_parts(type_a, a1, a2, a3, a4, a5);\n907\t    let B = ptr_from_parts(type_b, b1, b2, b3, b4, b5);\n908\t\n909\t    c2Collided(A, type_a, B, type_b)\n910\t}\n911\t"}]},"parent_tool_use_id":null,"session_id":"d28431be-c36f-4316-bc23-1df19b169f26","uuid":"127dc69d-3605-4b81-a988-022bb4870c09","timestamp":"2026-08-27T11:42:56.577Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-9oPgJg/translation/src/lib.rs","content":"//! Rust translation of `c_src/src/lib.c` (a cute_c2 derived 2D collision library).\n//!\n//! Every non-static function of the C translation unit is exported here with the\n//! exact same linker symbol name, C calling convention and by-value/by-pointer\n//! argument layout, so this cdylib is a drop-in replacement for the C shared\n//! library.\n//!\n//! Behaviour (including the original code's quirks, such as `ptr_from_parts`\n//! falling off the end of the function for an unknown shape type and\n//! `c2MakeProxy` leaving the proxy untouched in the same situation) is\n//! reproduced as faithfully as possible. No bugs were \"fixed\".\n\n#![allow(\n    non_snake_case,\n    non_camel_case_types,\n    non_upper_case_globals,\n    unused_assignments\n)]\n\nuse core::ffi::{c_int, c_void};\n\n// ---------------------------------------------------------------------------\n// Public header (include/lib.h)\n// ---------------------------------------------------------------------------\n\n/// `typedef enum { C2_TYPE_CAPSULE, C2_TYPE_CIRCLE, C2_TYPE_AABB } C2_TYPE;`\n///\n/// A C enum of this shape is an `int`-sized value in the SysV ABI, so `c_int`\n/// is used for every parameter that is a `C2_TYPE` in the C source.\npub type C2_TYPE = c_int;\n\npub const C2_TYPE_CAPSULE: C2_TYPE = 0;\npub const C2_TYPE_CIRCLE: C2_TYPE = 1;\npub const C2_TYPE_AABB: C2_TYPE = 2;\n\n// ---------------------------------------------------------------------------\n// Internal (src/lib.c) types -- layouts verified against the C compiler.\n// ---------------------------------------------------------------------------\n\n/// `typedef struct c2v { float x; float y; } c2v;` (size 8, align 4)\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2v {\n    pub x: f32,\n    pub y: f32,\n}\n\n/// `typedef struct c2r { float c; float s; } c2r;` (size 8, align 4)\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2r {\n    pub c: f32,\n    pub s: f32,\n}\n\n/// `typedef struct c2x { c2v p; c2r r; } c2x;` (size 16, align 4)\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2x {\n    pub p: c2v,\n    pub r: c2r,\n}\n\n/// `typedef struct c2Circle { c2v p; float r; } c2Circle;` (size 12, align 4)\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2Circle {\n    pub p: c2v,\n    pub r: f32,\n}\n\n/// `typedef struct c2AABB { c2v min; c2v max; } c2AABB;` (size 16, align 4)\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2AABB {\n    pub min: c2v,\n    pub max: c2v,\n}\n\n/// `typedef struct c2Capsule { c2v a; c2v b; float r; } c2Capsule;`\n/// (size 20, align 4 -- classified MEMORY, i.e. passed on the stack)\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2Capsule {\n    pub a: c2v,\n    pub b: c2v,\n    pub r: f32,\n}\n\n/// `typedef struct c2GJKCache { float metric; int count; int iA[3]; int iB[3]; float div; }`\n/// (size 36, align 4)\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2GJKCache {\n    pub metric: f32,\n    pub count: c_int,\n    pub iA: [c_int; 3],\n    pub iB: [c_int; 3],\n    pub div: f32,\n}\n\n/// `typedef struct { float radius; int count; c2v verts[8]; } c2Proxy;`\n/// (size 72, align 4)\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2Proxy {\n    pub radius: f32,\n    pub count: c_int,\n    pub verts: [c2v; 8],\n}\n\n/// `typedef struct { c2v sA; c2v sB; c2v p; float u; int iA; int iB; } c2sv;`\n/// (size 36, align 4)\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2sv {\n    pub sA: c2v,\n    pub sB: c2v,\n    pub p: c2v,\n    pub u: f32,\n    pub iA: c_int,\n    pub iB: c_int,\n}\n\n/// `typedef struct { c2sv a, b, c, d; float div; int count; } c2Simplex;`\n/// (size 152, align 4)\n///\n/// The four `c2sv` members are contiguous and are treated as an array by the C\n/// code (`c2sv *verts = &s.a;`), so they are modelled as an array here.\n/// `verts[0]` is `a`, `verts[1]` is `b`, `verts[2]` is `c`, `verts[3]` is `d`.\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2Simplex {\n    pub verts: [c2sv; 4],\n    pub div: f32,\n    pub count: c_int,\n}\n\n// `<float.h>` constants spelled out literally in the C source.\nconst C2_FLT_MAX: f32 = 3.402_823_466_385_288_598_117_041_834_845_169_25e+38;\nconst C2_FLT_EPSILON: f32 = 1.192_092_895_507_812_5e-7;\n\nextern \"C\" {\n    fn malloc(size: usize) -> *mut c_void;\n}\n\n// ---------------------------------------------------------------------------\n// Vector math\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n    let mut a = c2v { x: 0.0, y: 0.0 };\n    a.x = x;\n    a.y = y;\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulvs(mut a: c2v, b: f32) -> c2v {\n    a.x *= b;\n    a.y *= b;\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n    c2V(\n        if a.x > b.x { a.x } else { b.x },\n        if a.y > b.y { a.y } else { b.y },\n    )\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n    c2V(\n        if a.x < b.x { a.x } else { b.x },\n        if a.y < b.y { a.y } else { b.y },\n    )\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n    c2Maxv(lo, c2Minv(a, hi))\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Sub(mut a: c2v, b: c2v) -> c2v {\n    a.x -= b.x;\n    a.y -= b.y;\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n    a.x * b.x + a.y * b.y\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2RotIdentity() -> c2r {\n    let mut r = c2r { c: 0.0, s: 0.0 };\n    r.c = 1.0f32;\n    r.s = 0.0;\n    r\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2xIdentity() -> c2x {\n    let mut x = c2x {\n        p: c2v { x: 0.0, y: 0.0 },\n        r: c2r { c: 0.0, s: 0.0 },\n    };\n    x.p = c2V(0.0, 0.0);\n    x.r = c2RotIdentity();\n    x\n}\n\n// ---------------------------------------------------------------------------\n// Shape helpers\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2BBVerts(out: *mut c2v, bb: *mut c2AABB) {\n    *out.add(0) = (*bb).min;\n    *out.add(1) = c2V((*bb).max.x, (*bb).min.y);\n    *out.add(2) = (*bb).max;\n    *out.add(3) = c2V((*bb).min.x, (*bb).max.y);\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2MakeProxy(shape: *const c_void, type_: C2_TYPE, p: *mut c2Proxy) {\n    match type_ {\n        C2_TYPE_CIRCLE => {\n            let c = shape as *mut c2Circle;\n            (*p).radius = (*c).r;\n            (*p).count = 1;\n            (*p).verts[0] = (*c).p;\n        }\n        C2_TYPE_AABB => {\n            let bb = shape as *mut c2AABB;\n            (*p).radius = 0.0;\n            (*p).count = 4;\n            c2BBVerts((*p).verts.as_mut_ptr(), bb);\n        }\n        C2_TYPE_CAPSULE => {\n            let c = shape as *mut c2Capsule;\n            (*p).radius = (*c).r;\n            (*p).count = 2;\n            (*p).verts[0] = (*c).a;\n            (*p).verts[1] = (*c).b;\n        }\n        // The C switch has no `default:` label -- an unknown type leaves the\n        // proxy completely untouched.\n        _ => {}\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Len(a: c2v) -> f32 {\n    // sqrtf()\n    c2Dot(a, a).sqrt()\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Det2(a: c2v, b: c2v) -> f32 {\n    a.x * b.y - a.y * b.x\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2GJKSimplexMetric(s: *mut c2Simplex) -> f32 {\n    match (*s).count {\n        2 => c2Len(c2Sub((*s).verts[1].p, (*s).verts[0].p)),\n        3 => c2Det2(\n            c2Sub((*s).verts[1].p, (*s).verts[0].p),\n            c2Sub((*s).verts[2].p, (*s).verts[0].p),\n        ),\n        // `default:` falls through into `case 1:` which returns 0.\n        _ => 0.0,\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulrv(a: c2r, b: c2v) -> c2v {\n    c2V(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Add(mut a: c2v, b: c2v) -> c2v {\n    a.x += b.x;\n    a.y += b.y;\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulxv(a: c2x, b: c2v) -> c2v {\n    c2Add(c2Mulrv(a.r, b), a.p)\n}\n\n// ---------------------------------------------------------------------------\n// Simplex reduction\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c22(s: *mut c2Simplex) {\n    let a = (*s).verts[0].p;\n    let b = (*s).verts[1].p;\n    let u = c2Dot(b, c2Sub(b, a));\n    let v = c2Dot(a, c2Sub(a, b));\n    if v <= 0.0 {\n        (*s).verts[0].u = 1.0f32;\n        (*s).div = 1.0f32;\n        (*s).count = 1;\n    } else if u <= 0.0 {\n        (*s).verts[0] = (*s).verts[1];\n        (*s).verts[0].u = 1.0f32;\n        (*s).div = 1.0f32;\n        (*s).count = 1;\n    } else {\n        (*s).verts[0].u = u;\n        (*s).verts[1].u = v;\n        (*s).div = u + v;\n        (*s).count = 2;\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c23(s: *mut c2Simplex) {\n    let a = (*s).verts[0].p;\n    let b = (*s).verts[1].p;\n    let c = (*s).verts[2].p;\n    let uAB = c2Dot(b, c2Sub(b, a));\n    let vAB = c2Dot(a, c2Sub(a, b));\n    let uBC = c2Dot(c, c2Sub(c, b));\n    let vBC = c2Dot(b, c2Sub(b, c));\n    let uCA = c2Dot(a, c2Sub(a, c));\n    let vCA = c2Dot(c, c2Sub(c, a));\n    let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n    let uABC = c2Det2(b, c) * area;\n    let vABC = c2Det2(c, a) * area;\n    let wABC = c2Det2(a, b) * area;\n    if vAB <= 0.0 && uCA <= 0.0 {\n        (*s).verts[0].u = 1.0f32;\n        (*s).div = 1.0f32;\n        (*s).count = 1;\n    } else if uAB <= 0.0 && vBC <= 0.0 {\n        (*s).verts[0] = (*s).verts[1];\n        (*s).verts[0].u = 1.0f32;\n        (*s).div = 1.0f32;\n        (*s).count = 1;\n    } else if uBC <= 0.0 && vCA <= 0.0 {\n        (*s).verts[0] = (*s).verts[2];\n        (*s).verts[0].u = 1.0f32;\n        (*s).div = 1.0f32;\n        (*s).count = 1;\n    } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n        (*s).verts[0].u = uAB;\n        (*s).verts[1].u = vAB;\n        (*s).div = uAB + vAB;\n        (*s).count = 2;\n    } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n        (*s).verts[0] = (*s).verts[1];\n        (*s).verts[1] = (*s).verts[2];\n        (*s).verts[0].u = uBC;\n        (*s).verts[1].u = vBC;\n        (*s).div = uBC + vBC;\n        (*s).count = 2;\n    } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n        (*s).verts[1] = (*s).verts[0];\n        (*s).verts[0] = (*s).verts[2];\n        (*s).verts[0].u = uCA;\n        (*s).verts[1].u = vCA;\n        (*s).div = uCA + vCA;\n        (*s).count = 2;\n    } else {\n        (*s).verts[0].u = uABC;\n        (*s).verts[1].u = vABC;\n        (*s).verts[2].u = wABC;\n        (*s).div = uABC + vABC + wABC;\n        (*s).count = 3;\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Neg(a: c2v) -> c2v {\n    c2V(-a.x, -a.y)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n    let mut b = c2v { x: 0.0, y: 0.0 };\n    b.x = -a.y;\n    b.y = a.x;\n    b\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n    let mut b = c2v { x: 0.0, y: 0.0 };\n    b.x = a.y;\n    b.y = -a.x;\n    b\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2D(s: *mut c2Simplex) -> c2v {\n    match (*s).count {\n        1 => c2Neg((*s).verts[0].p),\n        2 => {\n            let ab = c2Sub((*s).verts[1].p, (*s).verts[0].p);\n            if c2Det2(ab, c2Neg((*s).verts[0].p)) > 0.0 {\n                return c2Skew(ab);\n            }\n            c2CCW90(ab)\n        }\n        // `case 3:` / `default:`\n        _ => c2V(0.0, 0.0),\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2Support(verts: *const c2v, count: c_int, d: c2v) -> c_int {\n    let mut imax: c_int = 0;\n    let mut dmax = c2Dot(*verts.add(0), d);\n    let mut i: c_int = 1;\n    while i < count {\n        let dot = c2Dot(*verts.offset(i as isize), d);\n        if dot > dmax {\n            imax = i;\n            dmax = dot;\n        }\n        i += 1;\n    }\n    imax\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2Witness(s: *mut c2Simplex, a: *mut c2v, b: *mut c2v) {\n    let den = 1.0f32 / (*s).div;\n    match (*s).count {\n        1 => {\n            *a = (*s).verts[0].sA;\n            *b = (*s).verts[0].sB;\n        }\n        2 => {\n            *a = c2Add(\n                c2Mulvs((*s).verts[0].sA, den * (*s).verts[0].u),\n                c2Mulvs((*s).verts[1].sA, den * (*s).verts[1].u),\n            );\n            *b = c2Add(\n                c2Mulvs((*s).verts[0].sB, den * (*s).verts[0].u),\n                c2Mulvs((*s).verts[1].sB, den * (*s).verts[1].u),\n            );\n        }\n        3 => {\n            *a = c2Add(\n                c2Add(\n                    c2Mulvs((*s).verts[0].sA, den * (*s).verts[0].u),\n                    c2Mulvs((*s).verts[1].sA, den * (*s).verts[1].u),\n                ),\n                c2Mulvs((*s).verts[2].sA, den * (*s).verts[2].u),\n            );\n            *b = c2Add(\n                c2Add(\n                    c2Mulvs((*s).verts[0].sB, den * (*s).verts[0].u),\n                    c2Mulvs((*s).verts[1].sB, den * (*s).verts[1].u),\n                ),\n                c2Mulvs((*s).verts[2].sB, den * (*s).verts[2].u),\n            );\n        }\n        _ => {\n            *a = c2V(0.0, 0.0);\n            *b = c2V(0.0, 0.0);\n        }\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n    c2Mulvs(a, 1.0f32 / b)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n    c2Div(a, c2Len(a))\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2L(s: *mut c2Simplex) -> c2v {\n    let den = 1.0f32 / (*s).div;\n    match (*s).count {\n        1 => (*s).verts[0].p,\n        2 => c2Add(\n            c2Mulvs((*s).verts[0].p, den * (*s).verts[0].u),\n            c2Mulvs((*s).verts[1].p, den * (*s).verts[1].u),\n        ),\n        _ => c2V(0.0, 0.0),\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2MulrvT(a: c2r, b: c2v) -> c2v {\n    c2V(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y)\n}\n\n// ---------------------------------------------------------------------------\n// GJK\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2GJK(\n    A: *const c_void,\n    typeA: C2_TYPE,\n    ax_ptr: *const c2x,\n    B: *const c_void,\n    typeB: C2_TYPE,\n    bx_ptr: *const c2x,\n    outA: *mut c2v,\n    outB: *mut c2v,\n    use_radius: c_int,\n    iterations: *mut c_int,\n    cache: *mut c2GJKCache,\n) -> f32 {\n    let ax: c2x;\n    let bx: c2x;\n    if ax_ptr.is_null() {\n        ax = c2xIdentity();\n    } else {\n        ax = *ax_ptr;\n    }\n    if bx_ptr.is_null() {\n        bx = c2xIdentity();\n    } else {\n        bx = *bx_ptr;\n    }\n    let mut pA: c2Proxy = core::mem::zeroed();\n    let mut pB: c2Proxy = core::mem::zeroed();\n    c2MakeProxy(A, typeA, &mut pA);\n    c2MakeProxy(B, typeB, &mut pB);\n    let mut s: c2Simplex = core::mem::zeroed();\n    // `c2sv *verts = &s.a;`\n    let verts: *mut c2sv = s.verts.as_mut_ptr();\n    let mut cache_was_read: c_int = 0;\n    if !cache.is_null() {\n        let cache_was_good = (*cache).count != 0;\n        if cache_was_good {\n            let mut i: c_int = 0;\n            while i < (*cache).count {\n                let iA = *(*cache).iA.as_ptr().offset(i as isize);\n                let iB = *(*cache).iB.as_ptr().offset(i as isize);\n                let sA = c2Mulxv(ax, *pA.verts.as_ptr().offset(iA as isize));\n                let sB = c2Mulxv(bx, *pB.verts.as_ptr().offset(iB as isize));\n                let v: *mut c2sv = verts.offset(i as isize);\n                (*v).iA = iA;\n                (*v).sA = sA;\n                (*v).iB = iB;\n                (*v).sB = sB;\n                (*v).p = c2Sub((*v).sB, (*v).sA);\n                (*v).u = 0.0;\n                i += 1;\n            }\n            s.count = (*cache).count;\n            s.div = (*cache).div;\n            let metric_old = (*cache).metric;\n            let metric = c2GJKSimplexMetric(&mut s);\n            let min_metric = if metric < metric_old { metric } else { metric_old };\n            let max_metric = if metric > metric_old { metric } else { metric_old };\n            if !(min_metric < max_metric * 2.0f32 && metric < -1.0e8f32) {\n                cache_was_read = 1;\n            }\n        }\n    }\n    if cache_was_read == 0 {\n        s.verts[0].iA = 0;\n        s.verts[0].iB = 0;\n        s.verts[0].sA = c2Mulxv(ax, pA.verts[0]);\n        s.verts[0].sB = c2Mulxv(bx, pB.verts[0]);\n        s.verts[0].p = c2Sub(s.verts[0].sB, s.verts[0].sA);\n        s.verts[0].u = 1.0f32;\n        s.div = 1.0f32;\n        s.count = 1;\n    }\n    let mut saveA: [c_int; 3] = [0; 3];\n    let mut saveB: [c_int; 3] = [0; 3];\n    let mut save_count: c_int = 0;\n    let mut d0: f32 = C2_FLT_MAX;\n    let mut d1: f32 = C2_FLT_MAX;\n    let mut iter: c_int = 0;\n    let mut hit: c_int = 0;\n    while iter < 20 {\n        save_count = s.count;\n        let mut i: c_int = 0;\n        while i < save_count {\n            *saveA.as_mut_ptr().offset(i as isize) = (*verts.offset(i as isize)).iA;\n            *saveB.as_mut_ptr().offset(i as isize) = (*verts.offset(i as isize)).iB;\n            i += 1;\n        }\n        match s.count {\n            1 => {}\n            2 => c22(&mut s),\n            3 => c23(&mut s),\n            _ => {}\n        }\n        if s.count == 3 {\n            hit = 1;\n            break;\n        }\n        let p = c2L(&mut s);\n        d1 = c2Dot(p, p);\n        if d1 > d0 {\n            break;\n        }\n        d0 = d1;\n        let d = c2D(&mut s);\n        if c2Dot(d, d) < C2_FLT_EPSILON * C2_FLT_EPSILON {\n            break;\n        }\n        let iA = c2Support(pA.verts.as_ptr(), pA.count, c2MulrvT(ax.r, c2Neg(d)));\n        let sA = c2Mulxv(ax, *pA.verts.as_ptr().offset(iA as isize));\n        let iB = c2Support(pB.verts.as_ptr(), pB.count, c2MulrvT(bx.r, d));\n        let sB = c2Mulxv(bx, *pB.verts.as_ptr().offset(iB as isize));\n        let v: *mut c2sv = verts.offset(s.count as isize);\n        (*v).iA = iA;\n        (*v).sA = sA;\n        (*v).iB = iB;\n        (*v).sB = sB;\n        (*v).p = c2Sub((*v).sB, (*v).sA);\n        let mut dup: c_int = 0;\n        let mut i: c_int = 0;\n        while i < save_count {\n            if iA == *saveA.as_ptr().offset(i as isize) && iB == *saveB.as_ptr().offset(i as isize) {\n                dup = 1;\n                break;\n            }\n            i += 1;\n        }\n        if dup != 0 {\n            break;\n        }\n        s.count += 1;\n        iter += 1;\n    }\n    let mut a: c2v = core::mem::zeroed();\n    let mut b: c2v = core::mem::zeroed();\n    c2Witness(&mut s, &mut a, &mut b);\n    let mut dist = c2Len(c2Sub(a, b));\n    if hit != 0 {\n        a = b;\n        dist = 0.0;\n    } else if use_radius != 0 {\n        let rA = pA.radius;\n        let rB = pB.radius;\n        if dist > rA + rB && dist > C2_FLT_EPSILON {\n            dist -= rA + rB;\n            let n = c2Norm(c2Sub(b, a));\n            a = c2Add(a, c2Mulvs(n, rA));\n            b = c2Sub(b, c2Mulvs(n, rB));\n            if a.x == b.x && a.y == b.y {\n                dist = 0.0;\n            }\n        } else {\n            let p = c2Mulvs(c2Add(a, b), 0.5f32);\n            a = p;\n            b = p;\n            dist = 0.0;\n        }\n    }\n    if !cache.is_null() {\n        (*cache).metric = c2GJKSimplexMetric(&mut s);\n        (*cache).count = s.count;\n        let mut i: c_int = 0;\n        while i < s.count {\n            let v: *mut c2sv = verts.offset(i as isize);\n            *(*cache).iA.as_mut_ptr().offset(i as isize) = (*v).iA;\n            *(*cache).iB.as_mut_ptr().offset(i as isize) = (*v).iB;\n            i += 1;\n        }\n        (*cache).div = s.div;\n    }\n    if !outA.is_null() {\n        *outA = a;\n    }\n    if !outB.is_null() {\n        *outB = b;\n    }\n    if !iterations.is_null() {\n        *iterations = iter;\n    }\n    dist\n}\n\n// ---------------------------------------------------------------------------\n// Boolean shape-vs-shape tests\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2AABBtoAABB(A: c2AABB, B: c2AABB) -> c_int {\n    let d0: c_int = (B.max.x < A.min.x) as c_int;\n    let d1: c_int = (A.max.x < B.min.x) as c_int;\n    let d2: c_int = (B.max.y < A.min.y) as c_int;\n    let d3: c_int = (A.max.y < B.min.y) as c_int;\n    ((d0 | d1 | d2 | d3) == 0) as c_int\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2AABBtoCapsule(A: c2AABB, B: c2Capsule) -> c_int {\n    unsafe {\n        if c2GJK(\n            &A as *const c2AABB as *const c_void,\n            C2_TYPE_AABB,\n            core::ptr::null(),\n            &B as *const c2Capsule as *const c_void,\n            C2_TYPE_CAPSULE,\n            core::ptr::null(),\n            core::ptr::null_mut(),\n            core::ptr::null_mut(),\n            1,\n            core::ptr::null_mut(),\n            core::ptr::null_mut(),\n        ) != 0.0\n        {\n            return 0;\n        }\n    }\n    1\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CapsuletoCapsule(A: c2Capsule, B: c2Capsule) -> c_int {\n    unsafe {\n        if c2GJK(\n            &A as *const c2Capsule as *const c_void,\n            C2_TYPE_CAPSULE,\n            core::ptr::null(),\n            &B as *const c2Capsule as *const c_void,\n            C2_TYPE_CAPSULE,\n            core::ptr::null(),\n            core::ptr::null_mut(),\n            core::ptr::null_mut(),\n            1,\n            core::ptr::null_mut(),\n            core::ptr::null_mut(),\n        ) != 0.0\n        {\n            return 0;\n        }\n    }\n    1\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CircletoCircle(A: c2Circle, B: c2Circle) -> c_int {\n    let c = c2Sub(B.p, A.p);\n    let d2 = c2Dot(c, c);\n    let mut r2 = A.r + B.r;\n    r2 = r2 * r2;\n    (d2 < r2) as c_int\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CircletoAABB(A: c2Circle, B: c2AABB) -> c_int {\n    let L = c2Clampv(A.p, B.min, B.max);\n    let ab = c2Sub(A.p, L);\n    let d2 = c2Dot(ab, ab);\n    let r2 = A.r * A.r;\n    (d2 < r2) as c_int\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CircletoCapsule(A: c2Circle, B: c2Capsule) -> c_int {\n    let n = c2Sub(B.b, B.a);\n    let ap = c2Sub(A.p, B.a);\n    let da = c2Dot(ap, n);\n    let d2: f32;\n    if da < 0.0 {\n        d2 = c2Dot(ap, ap);\n    } else {\n        let db = c2Dot(c2Sub(A.p, B.b), n);\n        if db < 0.0 {\n            let e = c2Sub(ap, c2Mulvs(n, da / c2Dot(n, n)));\n            d2 = c2Dot(e, e);\n        } else {\n            let bp = c2Sub(A.p, B.b);\n            d2 = c2Dot(bp, bp);\n        }\n    }\n    let r = A.r + B.r;\n    (d2 < r * r) as c_int\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2Collided(\n    A: *const c_void,\n    typeA: C2_TYPE,\n    B: *const c_void,\n    typeB: C2_TYPE,\n) -> c_int {\n    match typeA {\n        C2_TYPE_CIRCLE => match typeB {\n            C2_TYPE_CIRCLE => c2CircletoCircle(\n                (A as *const c2Circle).read_unaligned(),\n                (B as *const c2Circle).read_unaligned(),\n            ),\n            C2_TYPE_AABB => c2CircletoAABB(\n                (A as *const c2Circle).read_unaligned(),\n                (B as *const c2AABB).read_unaligned(),\n            ),\n            C2_TYPE_CAPSULE => c2CircletoCapsule(\n                (A as *const c2Circle).read_unaligned(),\n                (B as *const c2Capsule).read_unaligned(),\n            ),\n            _ => 0,\n        },\n        C2_TYPE_AABB => match typeB {\n            C2_TYPE_CIRCLE => c2CircletoAABB(\n                (B as *const c2Circle).read_unaligned(),\n                (A as *const c2AABB).read_unaligned(),\n            ),\n            C2_TYPE_AABB => c2AABBtoAABB(\n                (A as *const c2AABB).read_unaligned(),\n                (B as *const c2AABB).read_unaligned(),\n            ),\n            C2_TYPE_CAPSULE => c2AABBtoCapsule(\n                (A as *const c2AABB).read_unaligned(),\n                (B as *const c2Capsule).read_unaligned(),\n            ),\n            _ => 0,\n        },\n        C2_TYPE_CAPSULE => match typeB {\n            C2_TYPE_CIRCLE => c2CircletoCapsule(\n                (B as *const c2Circle).read_unaligned(),\n                (A as *const c2Capsule).read_unaligned(),\n            ),\n            C2_TYPE_AABB => c2AABBtoCapsule(\n                (B as *const c2AABB).read_unaligned(),\n                (A as *const c2Capsule).read_unaligned(),\n            ),\n            C2_TYPE_CAPSULE => c2CapsuletoCapsule(\n                (A as *const c2Capsule).read_unaligned(),\n                (B as *const c2Capsule).read_unaligned(),\n            ),\n            _ => 0,\n        },\n        _ => 0,\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Public entry points\n// ---------------------------------------------------------------------------\n\n/// `void *ptr_from_parts(C2_TYPE typ, float a, float b, float c, float d, float e)`\n///\n/// Note: the C function has no `return` statement for an unrecognised `typ`\n/// (it falls off the end of a non-void function). The returned value in that\n/// case is indeterminate in C; a null pointer is produced here. It is never\n/// dereferenced by `omni_collide`, because `c2Collided` returns 0 for an\n/// unknown type before touching the pointer.\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn ptr_from_parts(\n    typ: C2_TYPE,\n    a: f32,\n    b: f32,\n    c: f32,\n    d: f32,\n    e: f32,\n) -> *mut c_void {\n    match typ {\n        C2_TYPE_CIRCLE => {\n            let circle = malloc(core::mem::size_of::<c2Circle>()) as *mut c2Circle;\n            (*circle