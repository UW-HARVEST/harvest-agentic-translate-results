(Copy, Clone)]\n43\tpub struct c2v {\n44\t    pub x: f32,\n45\t    pub y: f32,\n46\t}\n47\t\n48\t/// `typedef struct c2r { float c; float s; } c2r;` (size 8, align 4)\n49\t#[repr(C)]\n50\t#[derive(Copy, Clone)]\n51\tpub struct c2r {\n52\t    pub c: f32,\n53\t    pub s: f32,\n54\t}\n55\t\n56\t/// `typedef struct c2x { c2v p; c2r r; } c2x;` (size 16, align 4)\n57\t#[repr(C)]\n58\t#[derive(Copy, Clone)]\n59\tpub struct c2x {\n60\t    pub p: c2v,\n61\t    pub r: c2r,\n62\t}\n63\t\n64\t/// `typedef struct c2Circle { c2v p; float r; } c2Circle;` (size 12, align 4)\n65\t#[repr(C)]\n66\t#[derive(Copy, Clone)]\n67\tpub struct c2Circle {\n68\t    pub p: c2v,\n69\t    pub r: f32,\n70\t}\n71\t\n72\t/// `typedef struct c2AABB { c2v min; c2v max; } c2AABB;` (size 16, align 4)\n73\t#[repr(C)]\n74\t#[derive(Copy, Clone)]\n75\tpub struct c2AABB {\n76\t    pub min: c2v,\n77\t    pub max: c2v,\n78\t}\n79\t\n80\t/// `typedef struct c2Capsule { c2v a; c2v b; float r; } c2Capsule;`\n81\t/// (size 20, align 4 -- classified MEMORY, i.e. passed on the stack)\n82\t#[repr(C)]\n83\t#[derive(Copy, Clone)]\n84\tpub struct c2Capsule {\n85\t    pub a: c2v,\n86\t    pub b: c2v,\n87\t    pub r: f32,\n88\t}\n89\t\n90\t/// `typedef struct c2GJKCache { float metric; int count; int iA[3]; int iB[3]; float div; }`\n91\t/// (size 36, align 4)\n92\t#[repr(C)]\n93\t#[derive(Copy, Clone)]\n94\tpub struct c2GJKCache {\n95\t    pub metric: f32,\n96\t    pub count: c_int,\n97\t    pub iA: [c_int; 3],\n98\t    pub iB: [c_int; 3],\n99\t    pub div: f32,\n100\t}\n101\t\n102\t/// `typedef struct { float radius; int count; c2v verts[8]; } c2Proxy;`\n103\t/// (size 72, align 4)\n104\t#[repr(C)]\n105\t#[derive(Copy, Clone)]\n106\tpub struct c2Proxy {\n107\t    pub radius: f32,\n108\t    pub count: c_int,\n109\t    pub verts: [c2v; 8],\n110\t}\n111\t\n112\t/// `typedef struct { c2v sA; c2v sB; c2v p; float u; int iA; int iB; } c2sv;`\n113\t/// (size 36, align 4)\n114\t#[repr(C)]\n115\t#[derive(Copy, Clone)]\n116\tpub struct c2sv {\n117\t    pub sA: c2v,\n118\t    pub sB: c2v,\n119\t    pub p: c2v,\n120\t    pub u: f32,\n121\t    pub iA: c_int,\n122\t    pub iB: c_int,\n123\t}\n124\t\n125\t/// `typedef struct { c2sv a, b, c, d; float div; int count; } c2Simplex;`\n126\t/// (size 152, align 4)\n127\t///\n128\t/// The four `c2sv` members are contiguous and are treated as an array by the C\n129\t/// code (`c2sv *verts = &s.a;`), so they are modelled as an array here.\n130\t/// `verts[0]` is `a`, `verts[1]` is `b`, `verts[2]` is `c`, `verts[3]` is `d`.\n131\t#[repr(C)]\n132\t#[derive(Copy, Clone)]\n133\tpub struct c2Simplex {\n134\t    pub verts: [c2sv; 4],\n135\t    pub div: f32,\n136\t    pub count: c_int,\n137\t}\n138\t\n139\t// `<float.h>` constants spelled out literally in the C source.\n140\tconst C2_FLT_MAX: f32 = 3.402_823_466_385_288_598_117_041_834_845_169_25e+38;\n141\tconst C2_FLT_EPSILON: f32 = 1.192_092_895_507_812_5e-7;\n142\t\n143\textern \"C\" {\n144\t    fn malloc(size: usize) -> *mut c_void;\n145\t}\n146\t\n147\t// ---------------------------------------------------------------------------\n148\t// Vector math\n149\t// ---------------------------------------------------------------------------\n150\t\n151\t#[unsafe(no_mangle)]\n152\tpub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n153\t    let mut a = c2v { x: 0.0, y: 0.0 };\n154\t    a.x = x;\n155\t    a.y = y;\n156\t    a\n157\t}\n158\t\n159\t#[unsafe(no_mangle)]\n160\tpub extern \"C\" fn c2Mulvs(mut a: c2v, b: f32) -> c2v {\n161\t    a.x *= b;\n162\t    a.y *= b;\n163\t    a\n164\t}\n165\t\n166\t#[unsafe(no_mangle)]\n167\tpub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n168\t    c2V(\n169\t        if a.x > b.x { a.x } else { b.x },\n170\t        if a.y > b.y { a.y } else { b.y },\n171\t    )\n172\t}\n173\t\n174\t#[unsafe(no_mangle)]\n175\tpub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n176\t    c2V(\n177\t        if a.x < b.x { a.x } else { b.x },\n178\t        if a.y < b.y { a.y } else { b.y },\n179\t    )\n180\t}\n181\t\n182\t#[unsafe(no_mangle)]\n183\tpub extern \"C\" fn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n184\t    c2Maxv(lo, c2Minv(a, hi))\n185\t}\n186\t\n187\t#[unsafe(no_mangle)]\n188\tpub extern \"C\" fn c2Sub(mut a: c2v, b: c2v) -> c2v {\n189\t    a.x -= b.x;\n190\t    a.y -= b.y;\n191\t    a\n192\t}\n193\t\n194\t#[unsafe(no_mangle)]\n195\tpub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n196\t    a.x * b.x + a.y * b.y\n197\t}\n198\t\n199\t#[unsafe(no_mangle)]\n200\tpub extern \"C\" fn c2RotIdentity() -> c2r {\n201\t    let mut r = c2r { c: 0.0, s: 0.0 };\n202\t    r.c = 1.0f32;\n203\t    r.s = 0.0;\n204\t    r\n205\t}\n206\t\n207\t#[unsafe(no_mangle)]\n208\tpub extern \"C\" fn c2xIdentity() -> c2x {\n209\t    let mut x = c2x {\n210\t        p: c2v { x: 0.0, y: 0.0 },\n211\t        r: c2r { c: 0.0, s: 0.0 },\n212\t    };\n213\t    x.p = c2V(0.0, 0.0);\n214\t    x.r = c2RotIdentity();\n215\t    x\n216\t}\n217\t\n218\t// ---------------------------------------------------------------------------\n219\t// Shape helpers\n220\t// ---------------------------------------------------------------------------\n221\t\n222\t#[unsafe(no_mangle)]\n223\tpub unsafe extern \"C\" fn c2BBVerts(out: *mut c2v, bb: *mut c2AABB) {\n224\t    *out.add(0) = (*bb).min;\n225\t    *out.add(1) = c2V((*bb).max.x, (*bb).min.y);\n226\t    *out.add(2) = (*bb).max;\n227\t    *out.add(3) = c2V((*bb).min.x, (*bb).max.y);\n228\t}\n229\t\n230\t#[unsafe(no_mangle)]\n231\tpub unsafe extern \"C\" fn c2MakeProxy(shape: *const c_void, type_: C2_TYPE, p: *mut c2Proxy) {\n232\t    match type_ {\n233\t        C2_TYPE_CIRCLE => {\n234\t            let c = shape as *mut c2Circle;\n235\t            (*p).radius = (*c).r;\n236\t            (*p).count = 1;\n237\t            (*p).verts[0] = (*c).p;\n238\t        }\n239\t        C2_TYPE_AABB => {\n240\t            let bb = shape as *mut c2AABB;\n241\t            (*p).radius = 0.0;\n242\t            (*p).count = 4;\n243\t            c2BBVerts((*p).verts.as_mut_ptr(), bb);\n244\t        }\n245\t        C2_TYPE_CAPSULE => {\n246\t            let c = shape as *mut c2Capsule;\n247\t            (*p).radius = (*c).r;\n248\t            (*p).count = 2;\n249\t            (*p).verts[0] = (*c).a;\n250\t            (*p).verts[1] = (*c).b;\n251\t        }\n252\t        // The C switch has no `default:` label -- an unknown type leaves the\n253\t        // proxy completely untouched.\n254\t        _ => {}\n255\t    }\n256\t}\n257\t\n258\t#[unsafe(no_mangle)]\n259\tpub extern \"C\" fn c2Len(a: c2v) -> f32 {\n260\t    // sqrtf()\n261\t    c2Dot(a, a).sqrt()\n262\t}\n263\t\n264\t#[unsafe(no_mangle)]\n265\tpub extern \"C\" fn c2Det2(a: c2v, b: c2v) -> f32 {\n266\t    a.x * b.y - a.y * b.x\n267\t}\n268\t\n269\t#[unsafe(no_mangle)]\n270\tpub unsafe extern \"C\" fn c2GJKSimplexMetric(s: *mut c2Simplex) -> f32 {\n271\t    match (*s).count {\n272\t        2 => c2Len(c2Sub((*s).verts[1].p, (*s).verts[0].p)),\n273\t        3 => c2Det2(\n274\t            c2Sub((*s).verts[1].p, (*s).verts[0].p),\n275\t            c2Sub((*s).verts[2].p, (*s).verts[0].p),\n276\t        ),\n277\t        // `default:` falls through into `case 1:` which returns 0.\n278\t        _ => 0.0,\n279\t    }\n280\t}\n281\t\n282\t#[unsafe(no_mangle)]\n283\tpub extern \"C\" fn c2Mulrv(a: c2r, b: c2v) -> c2v {\n284\t    c2V(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)\n285\t}\n286\t\n287\t#[unsafe(no_mangle)]\n288\tpub extern \"C\" fn c2Add(mut a: c2v, b: c2v) -> c2v {\n289\t    a.x += b.x;\n290\t    a.y += b.y;\n291\t    a\n292\t}\n293\t\n294\t#[unsafe(no_mangle)]\n295\tpub extern \"C\" fn c2Mulxv(a: c2x, b: c2v) -> c2v {\n296\t    c2Add(c2Mulrv(a.r, b), a.p)\n297\t}\n298\t\n299\t// ---------------------------------------------------------------------------\n300\t// Simplex reduction\n301\t// ---------------------------------------------------------------------------\n302\t\n303\t#[unsafe(no_mangle)]\n304\tpub unsafe extern \"C\" fn c22(s: *mut c2Simplex) {\n305\t    let a = (*s).verts[0].p;\n306\t    let b = (*s).verts[1].p;\n307\t    let u = c2Dot(b, c2Sub(b, a));\n308\t    let v = c2Dot(a, c2Sub(a, b));\n309\t    if v <= 0.0 {\n310\t        (*s).verts[0].u = 1.0f32;\n311\t        (*s).div = 1.0f32;\n312\t        (*s).count = 1;\n313\t    } else if u <= 0.0 {\n314\t        (*s).verts[0] = (*s).verts[1];\n315\t        (*s).verts[0].u = 1.0f32;\n316\t        (*s).div = 1.0f32;\n317\t        (*s).count = 1;\n318\t    } else {\n319\t        (*s).verts[0].u = u;\n320\t        (*s).verts[1].u = v;\n321\t        (*s).div = u + v;\n322\t        (*s).count = 2;\n323\t    }\n324\t}\n325\t\n326\t#[unsafe(no_mangle)]\n327\tpub unsafe extern \"C\" fn c23(s: *mut c2Simplex) {\n328\t    let a = (*s).verts[0].p;\n329\t    let b = (*s).verts[1].p;\n330\t    let c = (*s).verts[2].p;\n331\t    let uAB = c2Dot(b, c2Sub(b, a));\n332\t    let vAB = c2Dot(a, c2Sub(a, b));\n333\t    let uBC = c2Dot(c, c2Sub(c, b));\n334\t    let vBC = c2Dot(b, c2Sub(b, c));\n335\t    let uCA = c2Dot(a, c2Sub(a, c));\n336\t    let vCA = c2Dot(c, c2Sub(c, a));\n337\t    let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n338\t    let uABC = c2Det2(b, c) * area;\n339\t    let vABC = c2Det2(c, a) * area;\n340\t    let wABC = c2Det2(a, b) * area;\n341\t    if vAB <= 0.0 && uCA <= 0.0 {\n342\t        (*s).verts[0].u = 1.0f32;\n343\t        (*s).div = 1.0f32;\n344\t        (*s).count = 1;\n345\t    } else if uAB <= 0.0 && vBC <= 0.0 {\n346\t        (*s).verts[0] = (*s).verts[1];\n347\t        (*s).verts[0].u = 1.0f32;\n348\t        (*s).div = 1.0f32;\n349\t        (*s).count = 1;\n350\t    } else if uBC <= 0.0 && vCA <= 0.0 {\n351\t        (*s).verts[0] = (*s).verts[2];\n352\t        (*s).verts[0].u = 1.0f32;\n353\t        (*s).div = 1.0f32;\n354\t        (*s).count = 1;\n355\t    } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n356\t        (*s).verts[0].u = uAB;\n357\t        (*s).verts[1].u = vAB;\n358\t        (*s).div = uAB + vAB;\n359\t        (*s).count = 2;\n360\t    } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n361\t        (*s).verts[0] = (*s).verts[1];\n362\t        (*s).verts[1] = (*s).verts[2];\n363\t        (*s).verts[0].u = uBC;\n364\t        (*s).verts[1].u = vBC;\n365\t        (*s).div = uBC + vBC;\n366\t        (*s).count = 2;\n367\t    } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n368\t        (*s).verts[1] = (*s).verts[0];\n369\t        (*s).verts[0] = (*s).verts[2];\n370\t        (*s).verts[0].u = uCA;\n371\t        (*s).verts[1].u = vCA;\n372\t        (*s).div = uCA + vCA;\n373\t        (*s).count = 2;\n374\t    } else {\n375\t        (*s).verts[0].u = uABC;\n376\t        (*s).verts[1].u = vABC;\n377\t        (*s).verts[2].u = wABC;\n378\t        (*s).div = uABC + vABC + wABC;\n379\t        (*s).count = 3;\n380\t    }\n381\t}\n382\t\n383\t#[unsafe(no_mangle)]\n384\tpub extern \"C\" fn c2Neg(a: c2v) -> c2v {\n385\t    c2V(-a.x, -a.y)\n386\t}\n387\t\n388\t#[unsafe(no_mangle)]\n389\tpub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n390\t    let mut b = c2v { x: 0.0, y: 0.0 };\n391\t    b.x = -a.y;\n392\t    b.y = a.x;\n393\t    b\n394\t}\n395\t\n396\t#[unsafe(no_mangle)]\n397\tpub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n398\t    let mut b = c2v { x: 0.0, y: 0.0 };\n399\t    b.x = a.y;\n400\t    b.y = -a.x;\n401\t    b\n402\t}\n403\t\n404\t#[unsafe(no_mangle)]\n405\tpub unsafe extern \"C\" fn c2D(s: *mut c2Simplex) -> c2v {\n406\t    match (*s).count {\n407\t        1 => c2Neg((*s).verts[0].p),\n408\t        2 => {\n409\t            let ab = c2Sub((*s).verts[1].p, (*s).verts[0].p);\n410\t            if c2Det2(ab, c2Neg((*s).verts[0].p)) > 0.0 {\n411\t                return c2Skew(ab);\n412\t            }\n413\t            c2CCW90(ab)\n414\t        }\n415\t        // `case 3:` / `default:`\n416\t        _ => c2V(0.0, 0.0),\n417\t    }\n418\t}\n419\t\n420\t#[unsafe(no_mangle)]\n421\tpub unsafe extern \"C\" fn c2Support(verts: *const c2v, count: c_int, d: c2v) -> c_int {\n422\t    let mut imax: c_int = 0;\n423\t    let mut dmax = c2Dot(*verts.add(0), d);\n424\t    let mut i: c_int = 1;\n425\t    while i < count {\n426\t        let dot = c2Dot(*verts.offset(i as isize), d);\n427\t        if dot > dmax {\n428\t            imax = i;\n429\t            dmax = dot;\n430\t        }\n431\t        i += 1;\n432\t    }\n433\t    imax\n434\t}\n435\t\n436\t#[unsafe(no_mangle)]\n437\tpub unsafe extern \"C\" fn c2Witness(s: *mut c2Simplex, a: *mut c2v, b: *mut c2v) {\n438\t    let den = 1.0f32 / (*s).div;\n439\t    match (*s).count {\n440\t        1 => {\n441\t            *a = (*s).verts[0].sA;\n442\t            *b = (*s).verts[0].sB;\n443\t        }\n444\t        2 => {\n445\t            *a = c2Add(\n446\t                c2Mulvs((*s).verts[0].sA, den * (*s).verts[0].u),\n447\t                c2Mulvs((*s).verts[1].sA, den * (*s).verts[1].u),\n448\t            );\n449\t            *b = c2Add(\n450\t                c2Mulvs((*s).verts[0].sB, den * (*s).verts[0].u),\n451\t                c2Mulvs((*s).verts[1].sB, den * (*s).verts[1].u),\n452\t            );\n453\t        }\n454\t        3 => {\n455\t            *a = c2Add(\n456\t                c2Add(\n457\t                    c2Mulvs((*s).verts[0].sA, den * (*s).verts[0].u),\n458\t                    c2Mulvs((*s).verts[1].sA, den * (*s).verts[1].u),\n459\t                ),\n460\t                c2Mulvs((*s).verts[2].sA, den * (*s).verts[2].u),\n461\t            );\n462\t            *b = c2Add(\n463\t                c2Add(\n464\t                    c2Mulvs((*s).verts[0].sB, den * (*s).verts[0].u),\n465\t                    c2Mulvs((*s).verts[1].sB, den * (*s).verts[1].u),\n466\t                ),\n467\t                c2Mulvs((*s).verts[2].sB, den * (*s).verts[2].u),\n468\t            );\n469\t        }\n470\t        _ => {\n471\t            *a = c2V(0.0, 0.0);\n472\t            *b = c2V(0.0, 0.0);\n473\t        }\n474\t    }\n475\t}\n476\t\n477\t#[unsafe(no_mangle)]\n478\tpub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n479\t    c2Mulvs(a, 1.0f32 / b)\n480\t}\n481\t\n482\t#[unsafe(no_mangle)]\n483\tpub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n484\t    c2Div(a, c2Len(a))\n485\t}\n486\t\n487\t#[unsafe(no_mangle)]\n488\tpub unsafe extern \"C\" fn c2L(s: *mut c2Simplex) -> c2v {\n489\t    let den = 1.0f32 / (*s).div;\n490\t    match (*s).count {\n491\t        1 => (*s).verts[0].p,\n492\t        2 => c2Add(\n493\t            c2Mulvs((*s).verts[0].p, den * (*s).verts[0].u),\n494\t            c2Mulvs((*s).verts[1].p, den * (*s).verts[1].u),\n495\t        ),\n496\t        _ => c2V(0.0, 0.0),\n497\t    }\n498\t}\n499\t\n500\t#[unsafe(no_mangle)]\n501\tpub extern \"C\" fn c2MulrvT(a: c2r, b: c2v) -> c2v {\n502\t    c2V(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y)\n503\t}\n504\t\n505\t// ---------------------------------------------------------------------------\n506\t// GJK\n507\t// ---------------------------------------------------------------------------\n508\t\n509\t#[unsafe(no_mangle)]\n510\tpub unsafe extern \"C\" fn c2GJK(\n511\t    A: *const c_void,\n512\t    typeA: C2_TYPE,\n513\t    ax_ptr: *const c2x,\n514\t    B: *const c_void,\n515\t    typeB: C2_TYPE,\n516\t    bx_ptr: *const c2x,\n517\t    outA: *mut c2v,\n518\t    outB: *mut c2v,\n519\t    use_radius: c_int,\n520\t    iterations: *mut c_int,\n521\t    cache: *mut c2GJKCache,\n522\t) -> f32 {\n523\t    let ax: c2x;\n524\t    let bx: c2x;\n525\t    if ax_ptr.is_null() {\n526\t        ax = c2xIdentity();\n527\t    } else {\n528\t        ax = *ax_ptr;\n529\t    }\n530\t    if bx_ptr.is_null() {\n531\t        bx = c2xIdentity();\n532\t    } else {\n533\t        bx = *bx_ptr;\n534\t    }\n535\t    let mut pA: c2Proxy = core::mem::zeroed();\n536\t    let mut pB: c2Proxy = core::mem::zeroed();\n537\t    c2MakeProxy(A, typeA, &mut pA);\n538\t    c2MakeProxy(B, typeB, &mut pB);\n539\t    let mut s: c2Simplex = core::mem::zeroed();\n540\t    // `c2sv *verts = &s.a;`\n541\t    let verts: *mut c2sv = s.verts.as_mut_ptr();\n542\t    let mut cache_was_read: c_int = 0;\n543\t    if !cache.is_null() {\n544\t        let cache_was_good = (*cache).count != 0;\n545\t        if cache_was_good {\n546\t            let mut i: c_int = 0;\n547\t            while i < (*cache).count {\n548\t                let iA = *(*cache).iA.as_ptr().offset(i as isize);\n549\t                let iB = *(*cache).iB.as_ptr().offset(i as isize);\n550\t                let sA = c2Mulxv(ax, *pA.verts.as_ptr().offset(iA as isize));\n551\t                let sB = c2Mulxv(bx, *pB.verts.as_ptr().offset(iB as isize));\n552\t                let v: *mut c2sv = verts.offset(i as isize);\n553\t                (*v).iA = iA;\n554\t                (*v).sA = sA;\n555\t                (*v).iB = iB;\n556\t                (*v).sB = sB;\n557\t                (*v).p = c2Sub((*v).sB, (*v).sA);\n558\t                (*v).u = 0.0;\n559\t                i += 1;\n560\t            }\n561\t            s.count = (*cache).count;\n562\t            s.div = (*cache).div;\n563\t            let metric_old = (*cache).metric;\n564\t            let metric = c2GJKSimplexMetric(&mut s);\n565\t            let min_metric = if metric < metric_old { metric } else { metric_old };\n566\t            let max_metric = if metric > metric_old { metric } else { metric_old };\n567\t            if !(min_metric < max_metric * 2.0f32 && metric < -1.0e8f32) {\n568\t                cache_was_read = 1;\n569\t            }\n570\t        }\n571\t    }\n572\t    if cache_was_read == 0 {\n573\t        s.verts[0].iA = 0;\n574\t        s.verts[0].iB = 0;\n575\t        s.verts[0].sA = c2Mulxv(ax, pA.verts[0]);\n576\t        s.verts[0].sB = c2Mulxv(bx, pB.verts[0]);\n577\t        s.verts[0].p = c2Sub(s.verts[0].sB, s.verts[0].sA);\n578\t        s.verts[0].u = 1.0f32;\n579\t        s.div = 1.0f32;\n580\t        s.count = 1;\n581\t    }\n582\t    let mut saveA: [c_int; 3] = [0; 3];\n583\t    let mut saveB: [c_int; 3] = [0; 3];\n584\t    let mut save_count: c_int = 0;\n585\t    let mut d0: f32 = C2_FLT_MAX;\n586\t    let mut d1: f32 = C2_FLT_MAX;\n587\t    let mut iter: c_int = 0;\n588\t    let mut hit: c_int = 0;\n589\t    while iter < 20 {\n590\t        save_count = s.count;\n591\t        let mut i: c_int = 0;\n592\t        while i < save_count {\n593\t            *saveA.as_mut_ptr().offset(i as isize) = (*verts.offset(i as isize)).iA;\n594\t            *saveB.as_mut_ptr().offset(i as isize) = (*verts.offset(i as isize)).iB;\n595\t            i += 1;\n596\t        }\n597\t        match s.count {\n598\t            1 => {}\n599\t            2 => c22(&mut s),\n600\t            3 => c23(&mut s),\n601\t            _ => {}\n602\t        }\n603\t        if s.count == 3 {\n604\t            hit = 1;\n605\t            break;\n606\t        }\n607\t        let p = c2L(&mut s);\n608\t        d1 = c2Dot(p, p);\n609\t        if d1 > d0 {\n610\t            break;\n611\t        }\n612\t        d0 = d1;\n613\t        let d = c2D(&mut s);\n614\t        if c2Dot(d, d) < C2_FLT_EPSILON * C2_FLT_EPSILON {\n615\t            break;\n616\t        }\n617\t        let iA = c2Support(pA.verts.as_ptr(), pA.count, c2MulrvT(ax.r, c2Neg(d)));\n618\t        let sA = c2Mulxv(ax, *pA.verts.as_ptr().offset(iA as isize));\n619\t        let iB = c2Support(pB.verts.as_ptr(), pB.count, c2MulrvT(bx.r, d));\n620\t        let sB = c2Mulxv(bx, *pB.verts.as_ptr().offset(iB as isize));\n621\t        let v: *mut c2sv = verts.offset(s.count as isize);\n622\t        (*v).iA = iA;\n623\t        (*v).sA = sA;\n624\t        (*v).iB = iB;\n625\t        (*v).sB = sB;\n626\t        (*v).p = c2Sub((*v).sB, (*v).sA);\n627\t        let mut dup: c_int = 0;\n628\t        let mut i: c_int = 0;\n629\t        while i < save_count {\n630\t            if iA == *saveA.as_ptr().offset(i as isize) && iB == *saveB.as_ptr().offset(i as isize) {\n631\t                dup = 1;\n632\t                break;\n633\t            }\n634\t            i += 1;\n635\t        }\n636\t        if dup != 0 {\n637\t            break;\n638\t        }\n639\t        s.co