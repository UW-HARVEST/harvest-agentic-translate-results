n's stack frame.  A plain `[c_int; 10]` here would either panic\n49\t/// (safe indexing) or immediately smash Rust's own frame in ways unrelated to\n50\t/// the C layout, so the array is embedded in a struct that reserves trailing\n51\t/// stack space, mirroring how the C compiler's frame absorbs modest\n52\t/// overflows.  Only the first `BUFFER_LEN` elements are ever printed, exactly\n53\t/// as in C.\n54\t#[repr(C)]\n55\tstruct Frame {\n56\t    buffer: [c_int; BUFFER_LEN],\n57\t    /// Trailing slack that stands in for the remainder of the C stack frame.\n58\t    _slack: [c_int; 118],\n59\t}\n60\t\n61\timpl Frame {\n62\t    fn new() -> Self {\n63\t        // `int buffer[10] = { 0 };`\n64\t        Frame {\n65\t            buffer: [0; BUFFER_LEN],\n66\t            _slack: [0; 118],\n67\t        }\n68\t    }\n69\t}\n70\t\n71\t/// `void bad(int data)`\n72\t///\n73\t/// Reproduced verbatim, including the missing upper-bound check: a `data`\n74\t/// value of 10 or more writes outside `buffer`.\n75\t#[unsafe(no_mangle)]\n76\tpub unsafe extern \"C\" fn bad(data: c_int) {\n77\t    let mut frame = Frame::new();\n78\t    if data >= 0 {\n79\t        // buffer[data] = 1;  -- deliberately unchecked, as in the C original.\n80\t        let base: *mut c_int = frame.buffer.as_mut_ptr();\n81\t        base.offset(data as isize).write(1);\n82\t        /* Print the array values */\n83\t        for i in 0..BUFFER_LEN {\n84\t            printIntLine(*base.add(i));\n85\t        }\n86\t    } else {\n87\t        printLine(b\"ERROR: Array index is negative.\\0\".as_ptr() as *const c_char);\n88\t    }\n89\t}\n90\t\n91\t/// `static void goodG2B(void)` -- the fixed data source: `data` is always 7,\n92\t/// so the write is in bounds.\n93\tunsafe fn goodG2B() {\n94\t    let data: c_int = 7;\n95\t    let mut frame = Frame::new();\n96\t    if data >= 0 {\n97\t        let base: *mut c_int = frame.buffer.as_mut_ptr();\n98\t        base.offset(data as isize).write(1);\n99\t        /* Print the array 