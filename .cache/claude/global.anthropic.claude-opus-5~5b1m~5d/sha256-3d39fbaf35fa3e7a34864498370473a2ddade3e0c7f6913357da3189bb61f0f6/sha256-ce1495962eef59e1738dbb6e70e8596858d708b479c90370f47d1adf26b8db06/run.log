{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01UtckUfq2XrVKK5ZTaTmVRi","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/`.\n2\t//!\n3\t//! Mirrors `c_src/include/lib.h` (public types) and `c_src/src/lib.c`\n4\t//! (implementation).  The only symbol exported by the C shared library is\n5\t//! `dequantize_granule`; `get_bits` is `static` in the C translation unit and\n6\t//! therefore stays private here as well.\n7\t//!\n8\t//! All arithmetic reproduces the observable behaviour of the C code as compiled\n9\t//! by GCC on x86-64 (wrapping integer arithmetic, shift counts masked to 5\n10\t//! bits, arithmetic right shift of signed values, unsigned wrap-around before\n11\t//! the conversion to `int`).\n12\t\n13\t#![allow(non_camel_case_types)]\n14\t\n15\tuse std::ffi::c_int;\n16\t\n17\t/// `typedef struct { const uint8_t *buf; int pos, limit; } bs_t;`\n18\t#[repr(C)]\n19\tpub struct bs_t {\n20\t    pub buf: *const u8,\n21\t    pub pos: c_int,\n22\t    pub limit: c_int,\n23\t}\n24\t\n25\t/// ```c\n26\t/// typedef struct {\n27\t///     float scf[3 * 64];\n28\t///     uint8_t total_bands, stereo_bands, bitalloc[64], scfcod[64];\n29\t/// } L12_scale_info;\n30\t/// ```\n31\t#[repr(C)]\n32\tpub struct L12_scale_info {\n33\t    pub scf: [f32; 3 * 64],\n34\t    pub total_bands: u8,\n35\t    pub stereo_bands: u8,\n36\t    pub bitalloc: [u8; 64],\n37\t    pub scfcod: [u8; 64],\n38\t}\n39\t\n40\t/// ```c\n41\t/// static uint32_t get_bits(bs_t *bs, int n) {\n42\t///     uint32_t next, cache = 0, s = bs->pos & 7;\n43\t///     int shl = n + s;\n44\t///     const uint8_t *p = bs->buf + (bs->pos >> 3);\n45\t///     if ((bs->pos += n) > bs->limit)\n46\t///         return 0;\n47\t///     next = *p++ & (255 >> s);\n48\t///     while ((shl -= 8) > 0) {\n49\t///         cache |= next << shl;\n50\t///         next = *p++;\n51\t///     }\n52\t///     return cache | (next >> -shl);\n53\t/// }\n54\t/// ```\n55\tunsafe fn get_bits(bs: *mut bs_t, n: c_int) -> u32 {\n56\t    let mut cache: u32 = 0;\n57\t    // `bs->pos & 7`: bitwise and on the two's complement representation, so the\n58\t    // result is always in 0..=7 even for a negative `pos`.\n59\t    let s: u32 = ((*bs).pos & 7) as u32;\n60\t    // `int shl = n + s;`  -- `n` is converted to `unsigned` for the addition,\n61\t    // the (possibly wrapped) result is converted back to `int`.\n62\t    let mut shl: c_int = (n as u32).wrapping_add(s) as c_int;\n63\t    // `bs->buf + (bs->pos >> 3)`: `>>` on a signed int is an arithmetic shift.\n64\t    let mut p: *const u8 = (*bs).buf.wrapping_offset(((*bs).pos >> 3) as isize);\n65\t    (*bs).pos = (*bs).pos.wrapping_add(n);\n66\t    if (*bs).pos > (*bs).limit {\n67\t        return 0;\n68\t    }\n69\t    let mut next: u32 = (*p as u32) & (255u32 >> s);\n70\t    p = p.wrapping_offset(1);\n71\t    loop {\n72\t        shl = shl.wrapping_sub(8);\n73\t        if shl <= 0 {\n74\t            break;\n75\t        }\n76\t        cache |= next.wrapping_shl(shl as u32);\n77\t        next = *p as u32;\n78\t        p = p.wrapping_offset(1);\n79\t    }\n80\t    cache | next.wrapping_shr(shl.wrapping_neg() as u32)\n81\t}\n82\t\n83\t/// ```c\n84\t/// int dequantize_granule(float *grbuf, bs_t *bs, L12_scale_info *sci,\n85\t///                                   int group_size) {\n86\t///     int i, j, k, choff = 576;\n87\t///     for (j = 0; j < 4; j++) {\n88\t///         float *dst = grbuf + group_size * j;\n89\t///         for (i = 0; i < 2 * sci->total_bands; i++) {\n90\t///             int ba = sci->bitalloc[i];\n91\t///             if (ba != 0) {\n92\t///                 if (ba < 17) {\n93\t///                     int half = (1 << (ba - 1)) - 1;\n94\t///                     for (k = 0; k < group_size; k++) {\n95\t///                         dst[k] = (float)((int)get_bits(bs, ba) - half);\n96\t///                     }\n97\t///                 } else {\n98\t///                     unsigned mod = (2 << (ba - 17)) + 1;\n99\t///                     unsigned code = get_bits(bs, mod + 2 - (mod >> 3));\n100\t///                     for (k = 0; k < group_size; k++, code /= mod) {\n101\t///                         dst[k] = (float)((int)(code % mod - mod / 2));\n102\t///                     }\n103\t///                 }\n104\t///             }\n105\t///             dst += choff;\n106\t///             choff = 18 - choff;\n107\t///         }\n108\t///     }\n109\t///     return group_size * 4;\n110\t/// }\n111\t/// ```\n112\t#[unsafe(no_mangle)]\n113\tpub unsafe extern \"C\" fn dequantize_granule(\n114\t    grbuf: *mut f32,\n115\t    bs: *mut bs_t,\n116\t    sci: *mut L12_scale_info,\n117\t    group_size: c_int,\n118\t) -> c_int {\n119\t    // `choff` is initialised once, outside of the `j` loop, and keeps its value\n120\t    // across granule iterations.\n121\t    let mut choff: c_int = 576;\n122\t    let mut j: c_int = 0;\n123\t    while j < 4 {\n124\t        let mut dst: *mut f32 = grbuf.wrapping_offset(group_size.wrapping_mul(j) as isize);\n125\t        // Base of `sci->bitalloc`; indexed with a raw offset so that an\n126\t        // out-of-range `total_bands` reproduces the C code's out-of-bounds\n127\t        // reads into the following struct members.\n128\t        let bitalloc: *const u8 = std::ptr::addr_of!((*sci).bitalloc).cast::<u8>();\n129\t        let nbands: c_int = 2i32.wrapping_mul((*sci).total_bands as c_int);\n130\t        let mut i: c_int = 0;\n131\t        while i < nbands {\n132\t            let ba: c_int = *bitalloc.wrapping_offset(i as isize) as c_int;\n133\t            if ba != 0 {\n134\t                if ba < 17 {\n135\t                    let half: c_int = 1i32.wrapping_shl((ba - 1) as u32).wrapping_sub(1);\n136\t                    let mut k: c_int = 0;\n137\t                    while k < group_size {\n138\t                        let v = (get_bits(bs, ba) as c_int).wrapping_sub(half);\n139\t                        *dst.wrapping_offset(k as isize) = v as