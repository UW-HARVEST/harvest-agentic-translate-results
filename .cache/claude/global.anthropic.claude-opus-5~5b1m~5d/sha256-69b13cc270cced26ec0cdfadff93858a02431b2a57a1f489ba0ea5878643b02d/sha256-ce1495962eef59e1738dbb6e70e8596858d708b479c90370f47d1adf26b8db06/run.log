{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01JooAb9urXAm9FhWVgHXe7F","type":"tool_result","content":"1\t// Shared harness for the differential tests.\n2\t//\n3\t// Both the C shared object and the Rust shared object are loaded with\n4\t// `libloading` (RTLD_NOW | RTLD_LOCAL, so the two copies of the identically\n5\t// named symbols cannot interfere with each other) and every call goes through\n6\t// the dynamic symbol table — the Rust crate is never linked directly, so the\n7\t// `#[no_mangle] extern \"C\"` wrappers are exercised exactly as an external C\n8\t// consumer would exercise them.\n9\t#![allow(dead_code)]\n10\t\n11\tuse std::ffi::{c_char, c_int, c_void, OsStr};\n12\tuse std::os::unix::io::AsRawFd;\n13\tuse std::path::{Path, PathBuf};\n14\tuse std::sync::atomic::{AtomicU64, Ordering};\n15\tuse std::sync::{Mutex, OnceLock};\n16\t\n17\tpub type OpFn = unsafe extern \"C\" fn(c_int) -> c_int;\n18\tpub type OpFnOpt = Option<OpFn>;\n19\t\n20\ttype FnCharInBuf = unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int;\n21\ttype FnIntToInt = unsafe extern \"C\" fn(c_int) -> c_int;\n22\ttype FnStrToInt = unsafe extern \"C\" fn(*const c_char) -> c_int;\n23\ttype FnFind = unsafe extern \"C\" fn(*const c_char, usize, c_char) -> *mut c_char;\n24\ttype FnCreate = unsafe extern \"C\" fn(*const c_char) -> *mut c_char;\n25\ttype FnApply = unsafe extern \"C\" fn(OpFnOpt, c_int) -> c_int;\n26\t\n27\textern \"C\" {\n28\t    fn dup(oldfd: c_int) -> c_int;\n29\t    fn dup2(oldfd: c_int, newfd: c_int) -> c_int;\n30\t    fn close(fd: c_int) -> c_int;\n31\t    fn fflush(stream: *mut c_void) -> c_int;\n32\t    fn free(p: *mut c_void);\n33\t}\n34\t\n35\t/// All ten exported entry points of one implementation.\n36\tpub struct Api {\n37\t    pub name: &'static str,\n38\t    pub path: PathBuf,\n39\t    pub charinbuf: FnCharInBuf,\n40\t    pub increment_counter: FnIntToInt,\n41\t    pub decrement_counter: FnIntToInt,\n42\t    pub multiply_counter: FnIntToInt,\n43\t    pub reset_counter: FnIntToInt,\n44\t    pub is_string_empty: FnStrToInt,\n45\t    pub find_char_in_buffer: FnFind,\n46\t    pub create_buffer: FnCreate,\n47\t    pub validate_uint16_range: FnIntToInt,\n48\t    pub apply_operation: FnApply,\n49\t    // Keep the library alive for the whole process lifetime.\n50\t    _lib: &'static libloading::os::unix::Library,\n51\t}\n52\t\n53\timpl Api {\n54\t    fn open(name: &'static str, path: &Path) -> Api {\n55\t        // RTLD_NOW so that any missing symbol shows up immediately, RTLD_LOCAL\n56\t        // (the default) so that the two libraries keep separate symbol scopes.\n57\t        let lib = unsafe {\n58\t            libloading::os::unix::Library::open(\n59\t                Some(OsStr::new(path)),\n60\t                libloading::os::unix::RTLD_NOW | libloading::os::unix::RTLD_LOCAL,\n61\t            )\n62\t        }\n63\t        .unwrap_or_else(|e| panic!(\"failed to dlopen {} ({}): {e}\", name, path.display()));\n64\t        let lib: &'static libloading::os::unix::Library = Box::leak(Box::new(lib));\n65\t\n66\t        macro_rules! sym {\n67\t            ($t:ty, $n:expr) => {{\n68\t                let s: libloading::os::unix::Symbol<$t> = unsafe { lib.get($n) }\n69\t                    .unwrap_or_else(|e| panic!(\"{}: missing symbol {:?}: {e}\", name, $n));\n70\t                *s\n71\t            }};\n72\t        }\n73\t\n74\t        Api {\n75\t            name,\n76\t            path: path.to_path_buf(),\n77\t            charinbuf: sym!(FnCharInBuf, b\"charinbuf\\0\"),\n78\t            increment_counter: sym!(FnIntToInt, b\"increment_counter\\0\"),\n79\t            decrement_counter: sym!(FnIntToInt, b\"decrement_counter\\0\"),\n80\t            multiply_counter: sym!(FnIntToInt, b\"multiply_counter\\0\"),\n81\t            reset_counter: sym!(FnIntToInt, b\"reset_counter\\0\"),\n82\t            is_string_empty: sym!(FnStrToInt, b\"is_string_empty\\0\"),\n83\t            find_char_in_buffer: sym!(FnFind, b\"find_char_in_buffer\\0\"),\n84\t            create_buffer: sym!(FnCreate, b\"create_buffer\\0\"),\n85\t            validate_uint16_range: sym!(FnIntToInt, b\"validate_uint16_range\\0\"),\n86\t            apply_operation: sym!(FnApply, b\"apply_operation\\0\"),\n87\t            _lib: lib,\n88\t        }\n89\t    }\n90\t\n91\t    /// The four counter operations in the order used by `charinbuf` mode 3.\n92\t    pub fn ops(&self) -> [OpFn; 4] {\n93\t        [\n94\t            self.reset_counter,\n95\t            self.increment_counter,\n96\t            self.multiply_counter,\n97\t            self.decrement_counter,\n98\t        ]\n99\t    }\n100\t}\n101\t\n102\t// ---------------------------------------------------------------------------\n103\t// Library discovery\n104\t// ---------------------------------------------------------------------------\n105\t\n106\tfn workspace_root() -> PathBuf {\n107\t    // .../harvest-work-XXXX/translation\n108\t    let manifest = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n109\t    manifest.parent().expect(\"manifest parent\").to_path_buf()\n110\t}\n111\t\n112\t/// `c_src/build/lib<project>.so` — the project name is derived from the parent\n113\t/// directory name by CMakeLists.txt, so the file is located by extension.\n114\tpub fn c_lib_path() -> PathBuf {\n115\t    let dir = workspace_root().join(\"c_src\").join(\"build\");\n116\t    let mut found: Vec<PathBuf> = std::fs::read_dir(&dir)\n117\t        .unwrap_or_else(|e| panic!(\"cannot read {}: {e} — build the C library first\", dir.display()))\n118\t        .filter_map(|e| e.ok().map(|e| e.path()))\n119\t        .filter(|p| p.extension().map(|x| x == \"so\").unwrap_or(false))\n120\t        .collect();\n121\t    found.sort();\n122\t    assert_eq!(\n123\t        found.len(),\n124\t        1,\n125\t        \"expected exactly one .so in {}, found {:?}\",\n126\t        dir.display(),\n127\t        found\n128\t    );\n129\t    found.pop().unwrap()\n130\t}\n131\t\n132\t/// Newest mtime among the crate's own build inputs (`src/**.rs`, `Cargo.toml`).\n133\tfn newest_source_mtime() -> std::time::SystemTime {\n134\t    let root = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n135\t    let mut newest = std::time::SystemTime::UNIX_EPOCH;"}]},"parent_tool_use_id":null,"session_id":"299a4136-f7e5-4178-ae5a-8e0a5c02f6b7","uuid":"1b79a49a-d92d-42cc-b431-46b32631aab3","timestamp":"2026-08-27T23:21:26.328Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-QiJ5vr/translation/tests/support/mod.rs","content":"// Shared harness for the differential tests.\n//\n// Both the C shared object and the Rust shared object are loaded with\n// `libloading` (RTLD_NOW | RTLD_LOCAL, so the two copies of the identically\n// named symbols cannot interfere with each other) and every call goes through\n// the dynamic symbol table — the Rust crate is never linked directly, so the\n// `#[no_mangle] extern \"C\"` wrappers are exercised exactly as an external C\n// consumer would exercise them.\n#![allow(dead_code)]\n\nuse std::ffi::{c_char, c_int, c_void, OsStr};\nuse std::os::unix::io::AsRawFd;\nuse std::path::{Path, PathBuf};\nuse std::sync::atomic::{AtomicU64, Ordering};\nuse std::sync::{Mutex, OnceLock};\n\npub type OpFn = unsafe extern \"C\" fn(c_int) -> c_int;\npub type OpFnOpt = Option<OpFn>;\n\ntype FnCharInBuf = unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int;\ntype FnIntToInt = unsafe extern \"C\" fn(c_int) -> c_int;\ntype FnStrToInt = unsafe extern \"C\" fn(*const c_char) -> c_int;\ntype FnFind = unsafe extern \"C\" fn(*const c_char, usize, c_char) -> *mut c_char;\ntype FnCreate = unsafe extern \"C\" fn(*const c_char) -> *mut c_char;\ntype FnApply = unsafe extern \"C\" fn(OpFnOpt, c_int) -> c_int;\n\nextern \"C\" {\n    fn dup(oldfd: c_int) -> c_int;\n    fn dup2(oldfd: c_int, newfd: c_int) -> c_int;\n    fn close(fd: c_int) -> c_int;\n    fn fflush(stream: *mut c_void) -> c_int;\n    fn free(p: *mut c_void);\n}\n\n/// All ten exported entry points of one implementation.\npub struct Api {\n    pub name: &'static str,\n    pub path: PathBuf,\n    pub charinbuf: FnCharInBuf,\n    pub increment_counter: FnIntToInt,\n    pub decrement_counter: FnIntToInt,\n    pub multiply_counter: FnIntToInt,\n    pub reset_counter: FnIntToInt,\n    pub is_string_empty: FnStrToInt,\n    pub find_char_in_buffer: FnFind,\n    pub create_buffer: FnCreate,\n    pub validate_uint16_range: FnIntToInt,\n    pub apply_operation: FnApply,\n    // Keep the library alive for the whole process lifetime.\n    _lib: &'static libloading::os::unix::Library,\n}\n\nimpl Api {\n    fn open(name: &'static str, path: &Path) -> Api {\n        // RTLD_NOW so that any missing symbol shows up immediately, RTLD_LOCAL\n        // (the default) so that the two libraries keep separate symbol scopes.\n        let lib = unsafe {\n            libloading::os::unix::Library::open(\n                Some(OsStr::new(path)),\n                libloading::os::unix::RTLD_NOW | libloading::os::unix::RTLD_LOCAL,\n            )\n        }\n        .unwrap_or_else(|e| panic!(\"failed to dlopen {} ({}): {e}\", name, path.display()));\n        let lib: &'static libloading::os::unix::Library = Box::leak(Box::new(lib));\n\n        macro_rules! sym {\n            ($t:ty, $n:expr) => {{\n                let s: libloading::os::unix::Symbol<$t> = unsafe { lib.get($n) }\n                    .unwrap_or_else(|e| panic!(\"{}: missing symbol {:?}: {e}\", name, $n));\n                *s\n            }};\n        }\n\n        Api {\n            name,\n            path: path.to_path_buf(),\n            charinbuf: sym!(FnCharInBuf, b\"charinbuf\\0\"),\n            increment_counter: sym!(FnIntToInt, b\"increment_counter\\0\"),\n            decrement_counter: sym!(FnIntToInt, b\"decrement_counter\\0\"),\n            multiply_counter: sym!(FnIntToInt, b\"multiply_counter\\0\"),\n            reset_counter: sym!(FnIntToInt, b\"reset_counter\\0\"),\n            is_string_empty: sym!(FnStrToInt, b\"is_string_empty\\0\"),\n            find_char_in_buffer: sym!(FnFind, b\"find_char_in_buffer\\0\"),\n            create_buffer: sym!(FnCreate, b\"create_buffer\\0\"),\n            validate_uint16_range: sym!(FnIntToInt, b\"validate_uint16_range\\0\"),\n            apply_operation: sym!(FnApply, b\"apply_operation\\0\"),\n            _lib: lib,\n        }\n    }\n\n    /// The four counter operations in the order used by `charinbuf` mode 3.\n    pub fn ops(&self) -> [OpFn; 4] {\n        [\n            self.reset_counter,\n            self.increment_counter,\n            self.multiply_counter,\n            self.decrement_counter,\n        ]\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Library discovery\n// ---------------------------------------------------------------------------\n\nfn workspace_root() -> PathBuf {\n    // .../harvest-work-XXXX/translation\n    let manifest = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    manifest.parent().expect(\"manifest parent\").to_path_buf()\n}\n\n/// `c_src/build/lib<project>.so` — the project name is derived from the parent\n/// directory name by CMakeLists.txt, so the file is located by extension.\npub fn c_lib_path() -> PathBuf {\n    let dir = workspace_root().join(\"c_src\").join(\"build\");\n    let mut found: Vec<PathBuf> = std::fs::read_dir(&dir)\n        .unwrap_or_else(|e| panic!(\"cannot read {}: {e} — build the C library first\", dir.display()))\n        .filter_map(|e| e.ok().map(|e| e.path()))\n        .filter(|p| p.extension().map(|x| x == \"so\").unwrap_or(false))\n        .collect();\n    found.sort();\n    assert_eq!(\n        found.len(),\n        1,\n        \"expected exactly one .so in {}, found {:?}\",\n        dir.display(),\n        found\n    );\n    found.pop().unwrap()\n}\n\n/// Newest mtime among the crate's own build inputs (`src/**.rs`, `Cargo.toml`).\nfn newest_source_mtime() -> std::time::SystemTime {\n    let root = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    let mut newest = std::time::SystemTime::UNIX_EPOCH;","numLines":135,"startLine":1,"totalLines":591}}}
