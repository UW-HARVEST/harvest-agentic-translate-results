{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01E4LikzMPkipuQJSc6GGHiC","type":"tool_result","content":"1\t// Rust translation of c_src/src/lib.c (public API declared in c_src/include/lib.h).\n2\t//\n3\t// Copyright 2025 MIT Lincoln Laboratory\n4\t// Permission is hereby granted, free of charge,\n5\t// to any person obtaining a copy of this software\n6\t// and associated documentation files (the \"Software\"),\n7\t// to deal in the Software without restriction,\n8\t// including without limitation the rights to use, copy,\n9\t// modify, merge, publish, distribute, sublicense,\n10\t// and/or sell copies of the Software,\n11\t// and to permit persons to whom the Software is furnished to do so,\n12\t// subject to the following conditions:\n13\t//\n14\t// The above copyright notice and this permission notice\n15\t// shall be included in all copies or substantial portions of the Software.\n16\t//\n17\t// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n18\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n19\t// THE WARRANTIES OF MERCHANTABILITY,\n20\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n21\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n22\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n23\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n24\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n25\t\n26\t#![allow(clippy::missing_safety_doc)]\n27\t\n28\tuse core::ffi::{c_char, c_int, c_uint, c_void};\n29\tuse core::ptr;\n30\t\n31\t// ---------------------------------------------------------------------------\n32\t// libc bindings.\n33\t//\n34\t// The C code performs all of its output with `printf`, allocates with\n35\t// `malloc`/`free` and searches with `memchr`.  We call straight into libc so\n36\t// that formatting, stdio buffering (and hence the exact byte stream written to\n37\t// stdout) and heap ownership semantics are bit-for-bit identical with the C\n38\t// library: buffers returned by `create_buffer` must remain `free()`-able by the\n39\t// caller.\n40\t// ---------------------------------------------------------------------------\n41\textern \"C\" {\n42\t    fn printf(fmt: *const c_char, ...) -> c_int;\n43\t    fn malloc(size: usize) -> *mut c_void;\n44\t    fn free(ptr: *mut c_void);\n45\t    fn memchr(s: *const c_void, c: c_int, n: usize) -> *mut c_void;\n46\t    fn strlen(s: *const c_char) -> usize;\n47\t    fn strcpy(dst: *mut c_char, src: *const c_char) -> *mut c_char;\n48\t}\n49\t\n50\t/// `UINT16_MAX` from `<stdint.h>`.\n51\tconst UINT16_MAX: c_int = 65535;\n52\t\n53\t/// `static int counter = 0;` — file-scope mutable state shared by the counter\n54\t/// operations, exactly as in the C translation unit (no synchronisation, and\n55\t/// wrapping arithmetic as produced by the C compiler).\n56\tstatic mut COUNTER: c_int = 0;\n57\t\n58\t/// `typedef int (*operation_func)(int);`\n59\t///\n60\t/// Modelled as a nullable function pointer so the `if (!op)` check in\n61\t/// `apply_operation` can be reproduced faithfully.\n62\tpub type OperationFunc = Option<unsafe extern \"C\" fn(c_int) -> c_int>;\n63\t\n64\t// ---------------------------------------------------------------------------\n65\t// Counter operations\n66\t// ---------------------------------------------------------------------------\n67\t\n68\t/// `int increment_counter(int value)`\n69\t#[unsafe(no_mangle)]\n70\tpub extern \"C\" fn increment_counter(value: c_int) -> c_int {\n71\t    unsafe {\n72\t        COUNTER = COUNTER.wrapping_add(value);\n73\t        COUNTER\n74\t    }\n75\t}\n76\t\n77\t/// `int decrement_counter(int value)`\n78\t#[unsafe(no_mangle)]\n79\tpub extern \"C\" fn decrement_counter(value: c_int) -> c_int {\n80\t    unsafe {\n81\t        COUNTER = COUNTER.wrapping_sub(value);\n82\t        COUNTER\n83\t    }\n84\t}\n85\t\n86\t/// `int multiply_counter(int value)`\n87\t#[unsafe(no_mangle)]\n88\tpub extern \"C\" fn multiply_counter(value: c_int) -> c_int {\n89\t    unsafe {\n90\t        COUNTER = COUNTER.wrapping_mul(value);\n91\t        COUNTER\n92\t    }\n93\t}\n94\t\n95\t/// `int reset_counter(int value)`\n96\t#[unsafe(no_mangle)]\n97\tpub extern \"C\" fn reset_counter(value: c_int) -> c_int {\n98\t    unsafe {\n99\t        COUNTER = value;\n100\t        COUNTER\n101\t    }\n102\t}\n103\t\n104\t// ---------------------------------------------------------------------------\n105\t// String / buffer helpers\n106\t// ---------------------------------------------------------------------------\n107\t\n108\t/// `int is_string_empty(const char *str)`\n109\t///\n110\t/// Returns 1 for a NULL pointer or an empty string, 0 otherwise.\n111\t#[unsafe(no_mangle)]\n112\tpub unsafe extern \"C\" fn is_string_empty(str: *const c_char) -> c_int {\n113\t    if str.is_null() {\n114\t        return 1;\n115\t    }\n116\t    if *str != 0 {\n117\t        return 0;\n118\t    }\n119\t    1\n120\t}\n121\t\n122\t/// `char *find_char_in_buffer(const char *buffer, size_t size, char target)`\n123\t#[unsafe(no_mangle)]\n124\tpub unsafe extern \"C\" fn find_char_in_buffer(\n125\t    buffer: *const c_char,\n126\t    size: usize,\n127\t    target: c_char,\n128\t) -> *mut c_char {\n129\t    if buffer.is_null() {\n130\t        return ptr::null_mut();\n131\t    }\n132\t    // `target` is promoted to `int` (sign extended, `char` is signed on the\n133\t    // reference platform) exactly like the C call.\n134\t    memchr(buffer as *const c_void, target as c_int, size) as *mut c_char\n135\t}\n136\t\n137\t/// `char *create_buffer(const char *initial)`\n138\t///\n139\t/// Allocates with `malloc` so the result can be released with `free` by the\n140\t/// caller.  A failed allocation is propagated as NULL, and — as in the C — the\n141\t/// copy is only performed when the allocation succeeded.\n142\t#[unsafe(no_mangle)]\n143\tpub unsafe extern \"C\" fn create_buffer(initial: *const c_char) -> *mut c_char