or (size_t i = 0; i < count; i++) {\n266\t            if (decisions[i]) {\n267\t                return 100 + (int)i;\n268\t            }\n269\t        }\n270\t    } else if (special_count == count - 1) {\n271\t        /* Exactly one false - find which one */\n272\t        for (size_t i = 0; i < count; i++) {\n273\t            if (!decisions[i]) {\n274\t                return 200 + (int)i;\n275\t            }\n276\t        }\n277\t    }\n278\t    \n279\t    /* Check for alternating pattern */\n280\t    bool alternating = true;\n281\t    for (size_t i = 1; i < count; i++) {\n282\t        if (decisions[i] == decisions[i-1]) {\n283\t            alternating = false;\n284\t            break;\n285\t        }\n286\t    }\n287\t    \n288\t    if (alternating) {\n289\t        return 500 + special_count;\n290\t    }\n291\t    \n292\t    /* Check for consecutive true values */\n293\t    int max_consecutive = 0;\n294\t    int current_consecutive = 0;\n295\t    for (size_t i = 0; i < count; i++) {\n296\t        if (decisions[i]) {\n297\t            current_consecutive++;\n298\t            if (current_consecutive > max_consecutive) {\n299\t                max_consecutive = current_consecutive;\n300\t            }\n301\t        } else {\n302\t            current_consecutive = 0;\n303\t        }\n304\t    }\n305\t    \n306\t    if (max_consecutive >= 3) {\n307\t        return 300 + max_consecutive;\n308\t    }\n309\t    \n310\t    /* Return count of true values */\n311\t    return special_count;\n312\t}\n313\t\n314\t/**\n315\t * Validate sequence has proper pattern\n316\t * Checks various decision sequence rules\n317\t */\n318\tstatic int validate_sequence(char *sequence, size_t len) {\n319\t    if (len == 0) return 0;\n320\t    \n321\t    /* Convert all to bools */\n322\t    bool *bools = (bool*)sequence;  /* Reuse buffer */\n323\t    for (size_t i = 0; i < len; i++) {\n324\t        bool val = parse_bool(sequence[i]);\n325\t        bools[i] = val;\n326\t    }\n327\t    \n328\t    /