unsafe extern \"C\" fn c2Collide(\n1269\t    A: *const c_void,\n1270\t    typeA: c_int,\n1271\t    B: *const c_void,\n1272\t    typeB: c_int,\n1273\t    m: *mut c2Manifold,\n1274\t) {\n1275\t    (*m).count = 0;\n1276\t    match typeA {\n1277\t        C2_TYPE_CIRCLE => match typeB {\n1278\t            C2_TYPE_CIRCLE => {\n1279\t                c2CircletoCircleManifold(\n1280\t                    std::ptr::read_unaligned(A as *const c2Circle),\n1281\t                    std::ptr::read_unaligned(B as *const c2Circle),\n1282\t                    m,\n1283\t                );\n1284\t            }\n1285\t            C2_TYPE_AABB => {\n1286\t                c2CircletoAABBManifold(\n1287\t                    std::ptr::read_unaligned(A as *const c2Circle),\n1288\t                    std::ptr::read_unaligned(B as *const c2AABB),\n1289\t                    m,\n1290\t                );\n1291\t            }\n1292\t            C2_TYPE_CAPSULE => {\n1293\t                c2CircletoCapsuleManifold(\n1294\t                    std::ptr::read_unaligned(A as *const c2Circle),\n1295\t                    std::ptr::read_unaligned(B as *const c2Capsule),\n1296\t                    m,\n1297\t                );\n1298\t            }\n1299\t            _ => {}\n1300\t        },\n1301\t        C2_TYPE_AABB => match typeB {\n1302\t            C2_TYPE_CIRCLE => {\n1303\t                c2CircletoAABBManifold(\n1304\t                    std::ptr::read_unaligned(B as *const c2Circle),\n1305\t                    std::ptr::read_unaligned(A as *const c2AABB),\n1306\t                    m,\n1307\t                );\n1308\t                (*m).n = c2Neg((*m).n);\n1309\t            }\n1310\t            C2_TYPE_AABB => {\n1311\t                c2AABBtoAABBManifold(\n1312\t                    std::ptr::read_unaligned(A as *const c2AABB),\n1313\t                    std::ptr::read_unaligned(B as *const c2AABB),\n1314\t                    m,\n1315\t                );\n1316\t            }\n1317\t            C2_