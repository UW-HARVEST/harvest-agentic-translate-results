{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01AbLetWunxaVurTBu1vmCiv","type":"tool_result","content":"1\t//! Rust translation of `c_src/src/lib.c` (a reduced `cute_c2`-style 2D collision\n2\t//! library) preserving the complete public C ABI and bit-exact behaviour.\n3\t//!\n4\t//! Every non-`static` C function is re-exported here with `#[unsafe(no_mangle)]`\n5\t//! and `extern \"C\"`, using the identical signature so the SysV struct-passing\n6\t//! classification matches the C build exactly.\n7\t\n8\t#![allow(non_snake_case)]\n9\t#![allow(non_camel_case_types)]\n10\t#![allow(non_upper_case_globals)]\n11\t#![allow(unused_assignments)]\n12\t#![allow(dead_code)]\n13\t\n14\tuse std::os::raw::{c_int, c_void};\n15\t\n16\t// `<float.h>` constants exactly as spelled in the C source:\n17\t//   3.40282346638528859811704183484516925e+38F  == FLT_MAX\n18\t//   1.19209289550781250000000000000000000e-7F   == FLT_EPSILON\n19\tconst FLT_MAX: f32 = f32::MAX;\n20\tconst FLT_EPSILON: f32 = f32::EPSILON;\n21\t\n22\t// ---------------------------------------------------------------------------\n23\t// include/lib.h\n24\t// ---------------------------------------------------------------------------\n25\t\n26\t// typedef enum { C2_TYPE_CAPSULE, C2_TYPE_CIRCLE, C2_TYPE_AABB, C2_TYPE_POLY } C2_TYPE;\n27\tpub const C2_TYPE_CAPSULE: c_int = 0;\n28\tpub const C2_TYPE_CIRCLE: c_int = 1;\n29\tpub const C2_TYPE_AABB: c_int = 2;\n30\tpub const C2_TYPE_POLY: c_int = 3;\n31\t\n32\t#[repr(C)]\n33\t#[derive(Copy, Clone)]\n34\tpub struct c2v {\n35\t    pub x: f32,\n36\t    pub y: f32,\n37\t}\n38\t\n39\t#[repr(C)]\n40\t#[derive(Copy, Clone)]\n41\tpub struct c2Manifold {\n42\t    pub count: c_int,\n43\t    pub depths: [f32; 2],\n44\t    pub contact_points: [c2v; 2],\n45\t    pub n: c2v,\n46\t}\n47\t\n48\t// ---------------------------------------------------------------------------\n49\t// src/lib.c internal types\n50\t// ---------------------------------------------------------------------------\n51\t\n52\t#[repr(C)]\n53\t#[derive(Copy, Clone)]\n54\tpub struct c2h {\n55\t    pub n: c2v,\n56\t    pub d: f32,\n57\t}\n58\t\n59\t#[repr(C)]\n60\t#[derive(Copy, Clone)]\n61\tpub struct c2r {\n62\t    pub c: f32,\n63\t    pub s: f32,\n64\t}\n65\t\n66\t#[repr(C)]\n67\t#[derive(Copy, Clone)]\n68\tpub struct c2x {\n69\t    pub p: c2v,\n70\t    pub r: c2r,\n71\t}\n72\t\n73\t#[repr(C)]\n74\t#[derive(Copy, Clone)]\n75\tpub struct c2Circle {\n76\t    pub p: c2v,\n77\t    pub r: f32,\n78\t}\n79\t\n80\t#[repr(C)]\n81\t#[derive(Copy, Clone)]\n82\tpub struct c2AABB {\n83\t    pub min: c2v,\n84\t    pub max: c2v,\n85\t}\n86\t\n87\t#[repr(C)]\n88\t#[derive(Copy, Clone)]\n89\tpub struct c2Capsule {\n90\t    pub a: c2v,\n91\t    pub b: c2v,\n92\t    pub r: f32,\n93\t}\n94\t\n95\t#[repr(C)]\n96\t#[derive(Copy, Clone)]\n97\tpub struct c2Poly {\n98\t    pub count: c_int,\n99\t    pub verts: [c2v; 8],\n100\t    pub norms: [c2v; 8],\n101\t}\n102\t\n103\t#[repr(C)]\n104\t#[derive(Copy, Clone)]\n105\tpub struct c2GJKCache {\n106\t    pub metric: f32,\n107\t    pub count: c_int,\n108\t    pub iA: [c_int; 3],\n109\t    pub iB: [c_int; 3],\n110\t    pub div: f32,\n111\t}\n112\t\n113\t/// `typedef struct { float radius; int count; c2v verts[8]; } c2Proxy;`\n114\t#[repr(C)]\n115\t#[derive(Copy, Clone)]\n116\tpub struct c2Proxy {\n117\t    pub radius: f32,\n118\t    pub count: c_int,\n119\t    pub verts: [c2v; 8],\n120\t}\n121\t\n122\t/// `typedef struct { c2v sA; c2v sB; c2v p; float u; int iA; int iB; } c2sv;`\n123\t#[repr(C)]\n124\t#[derive(Copy, Clone)]\n125\tpub struct c2sv {\n126\t    pub sA: c2v,\n127\t    pub sB: c2v,\n128\t    pub p: c2v,\n129\t    pub u: f32,\n130\t    pub iA: c_int,\n131\t    pub iB: c_int,\n132\t}\n133\t\n134\t/// `typedef struct { c2sv a, b, c, d; float div; int count; } c2Simplex;`\n135\t///\n136\t/// The C code relies on `a`, `b`, `c`, `d` being contiguous (`c2sv* verts = &s.a`),\n137\t/// which this `#[repr(C)]` layout reproduces.\n138\t#[repr(C)]\n139\t#[derive(Copy, Clone)]\n140\tpub struct c2Simplex {\n141\t    pub a: c2sv,\n142\t    pub b: c2sv,\n143\t    pub c: c2sv,\n144\t    pub d: c2sv,\n145\t    pub div: f32,\n146\t    pub count: c_int,\n147\t}\n148\t\n149\tconst ZERO_V: c2v = c2v { x: 0.0, y: 0.0 };\n150\t\n151\t/// C's unary `-` on a float is an IEEE-754 sign-bit flip (gcc emits `xorps`),\n152\t/// which is also applied to NaN payloads.  Expressed as an explicit bit flip so\n153\t/// that LLVM cannot rewrite `(-a) * b` into `-(a * b)`, a transform that would\n154\t/// change the sign bit of a resulting NaN.\n155\t#[inline(always)]\n156\tfn fneg(x: f32) -> f32 {\n157\t    // `black_box` is the barrier: without it LLVM recognises the sign flip and\n158\t    // sinks it into the neighbouring arithmetic (e.g. `(-a) * b + c` becomes\n159\t    // `c - a * b`), which changes the sign bit of a NaN result.\n160\t    std::hint::black_box(f32::from_bits(x.to_bits() ^ 0x8000_0000))\n161\t}\n162\t\n163\t/// x86 SSE scalar ops select which NaN propagates by *operand position*:\n164\t/// `op dst, src` yields `dst` when `dst` is NaN, else `src` when `src` is NaN.\n165\t/// gcc's register allocation therefore fixes which NaN a mixed-NaN expression\n166\t/// returns; these helpers let the translation name that choice explicitly.\n167\t/// For non-NaN operands they are exactly the plain IEEE-754 operation.\n168\t#[inline(always)]\n169\tfn x86_mul(dst: f32, src: f32) -> f32 {\n170\t    let r = if dst.is_nan() {\n171\t        dst\n172\t    } else if src.is_nan() {\n173\t        src\n174\t    } else {\n175\t        dst * src\n176\t    };\n177\t    std::hint::black_box(r)\n178\t}\n179\t\n180\t#[inline(always)]\n181\tfn x86_add(dst: f32, src: f32) -> f32 {\n182\t    let r = if dst.is_nan() {\n183\t        dst\n184\t    } else if src.is_nan() {\n185\t        src\n186\t    } else {\n187\t        dst + src\n188\t    };\n189\t    std::hint::black_box(r)\n190\t}\n191\t\n192\t#[inline(always)]\n193\tfn x86_sub(dst: f32, src: f32) -> f32 {\n194\t    let r = if dst.is_nan() {\n195\t        dst\n196\t    } else if src.is_nan() {\n197\t        src\n198\t    } else {\n199\t        dst - src\n200\t    };\n201\t    std::hint::black_box(r)\n202\t}\n203\t\n204\textern \"C\" {\n205\t    fn malloc(size: usize) -> *mut c_void;\n206\t}\n207\t\n208\t// ---------------------------------------------------------------------------\n209\t// Vector helpers\n210\t// ---------------------------------------------------------------------------\n211\t\n212\t#[unsafe(no_mangle)]\n213\tpub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n214\t    let mut a: c2v = ZERO_V;\n215\t    a.x = x;\n216\t    a.y = y;\n217\t    a\n218\t}\n219\t\n220\t#[unsafe(no_mangle)]\n221\tpub extern \"C\" fn c2Mulvs(a: c2v, b: f32) -> c2v {\n222\t    // gcc: mulss dst=a.x,src=b ; mulss dst=a.y,src=b\n223\t    let mut a = a;\n224\t    a.x = x86_mul(a.x, b);\n225\t    a.y = x86_mul(a.y, b);\n226\t    a\n227\t}\n228\t\n229\t#[unsafe(no_mangle)]\n230\tpub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n231\t    c2V(\n232\t        if a.x > b.x { a.x } else { b.x },\n233\t        if a.y > b.y { a.y } else { b.y },\n234\t    )\n235\t}\n236\t\n237\t#[unsafe(no_mangle)]\n238\tpub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n239\t    c2V(\n240\t        if a.x < b.x { a.x } else { b.x },\n241\t        if a.y < b.y { a.y } else { b.y },\n242\t    )\n243\t}\n244\t\n245\t#[unsafe(no_mangle)]\n246\tpub extern \"C\" fn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n247\t    c2Maxv(lo, c2Minv(a, hi))\n248\t}\n249\t\n250\t#[unsafe(no_mangle)]\n251\tpub extern \"C\" fn c2Sub(a: c2v, b: c2v) -> c2v {\n252\t    // gcc: subss dst=a.x,src=b.x ; subss dst=a.y,src=b.y\n253\t    let mut a = a;\n254\t    a.x = x86_sub(a.x, b.x);\n255\t    a.y = x86_sub(a.y, b.y);\n256\t    a\n257\t}\n258\t\n259\t#[unsafe(no_mangle)]\n260\tpub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n261\t    // gcc: mulss dst=a.x,src=b.x ; mulss dst=b.y,src=a.y ; addss dst=p2,src=p1\n262\t    let p1 = x86_mul(a.x, b.x);\n263\t    let p2 = x86_mul(b.y, a.y);\n264\t    x86_add(p2, p1)\n265\t}\n266\t\n267\t#[unsafe(no_mangle)]\n268\tpub extern \"C\" fn c2Dist(h: c2h, p: c2v) -> f32 {\n269\t    c2Dot(h.n, p) - h.d\n270\t}\n271\t\n272\t#[unsafe(no_mangle)]\n273\tpub unsafe extern \"C\" fn c2PlaneAt(p: *const c2Poly, i: c_int) -> c2h {\n274\t    let mut h = c2h { n: ZERO_V, d: 0.0 };\n275\t    let norms = (*p).norms.as_ptr();\n276\t    let verts = (*p).verts.as_ptr();\n277\t    h.n = *norms.offset(i as isize);\n278\t    h.d = c2Dot(*norms.offset(i as isize), *verts.offset(i as isize));\n279\t    h\n280\t}\n281\t\n282\t#[unsafe(no_mangle)]\n283\tpub extern \"C\" fn c2RotIdentity() -> c2r {\n284\t    let mut r = c2r { c: 0.0, s: 0.0 };\n285\t    r.c = 1.0f32;\n286\t    r.s = 0.0;\n287\t    r\n288\t}\n289\t\n290\t#[unsafe(no_mangle)]\n291\tpub extern \"C\" fn c2xIdentity() -> c2x {\n292\t    let mut x = c2x {\n293\t        p: ZERO_V,\n294\t        r: c2r { c: 0.0, s: 0.0 },\n295\t    };\n296\t    x.p = c2V(0.0, 0.0);\n297\t    x.r = c2RotIdentity();\n298\t    x\n299\t}\n300\t\n301\t#[unsafe(no_mangle)]\n302\tpub unsafe extern \"C\" fn c2BBVerts(out: *mut c2v, bb: *mut c2AABB) {\n303\t    *out.offset(0) = (*bb).min;\n304\t    *out.offset(1) = c2V((*bb).max.x, (*bb).min.y);\n305\t    *out.offset(2) = (*bb).max;\n306\t    *out.offset(3) = c2V((*bb).min.x, (*bb).max.y);\n307\t}\n308\t\n309\t/// NOTE: the C source has **no** `C2_TYPE_POLY` case, so a poly proxy is left\n310\t/// completely untouched (uninitialised in C).  Reproduced faithfully: nothing is\n311\t/// written for any other type value.\n312\t#[unsafe(no_mangle)]\n313\tpub unsafe extern \"C\" fn c2MakeProxy(shape: *const c_void, type_: c_int, p: *mut c2Proxy) {\n314\t    match type_ {\n315\t        C2_TYPE_CIRCLE => {\n316\t            let c = shape as *const c2Circle;\n317\t            (*p).radius = (*c).r;\n318\t            (*p).count = 1;\n319\t            (*p).verts[0] = (*c).p;\n320\t        }\n321\t        C2_TYPE_AABB => {\n322\t            let bb = shape as *mut c2AABB;\n323\t            (*p).radius = 0.0;\n324\t            (*p).count = 4;\n325\t            let verts = (*p).verts.as_mut_ptr();\n326\t            c2BBVerts(verts, bb);\n327\t        }\n328\t        C2_TYPE_CAPSULE => {\n329\t            let c = shape as *const c2Capsule;\n330\t            (*p).radius = (*c).r;\n331\t            (*p).count = 2;\n332\t            (*p).verts[0] = (*c).a;\n333\t            (*p).verts[1] = (*c).b;\n334\t        }\n335\t        _ => {}\n336\t    }\n337\t}\n338\t\n339\t#[unsafe(no_mangle)]\n340\tpub extern \"C\" fn c2Len(a: c2v) -> f32 {\n341\t    c2Dot(a, a).sqrt()\n342\t}\n343\t\n344\t#[unsafe(no_mangle)]\n345\tpub extern \"C\" fn c2Det2(a: c2v, b: c2v) -> f32 {\n346\t    // gcc: mulss dst=b.y,src=a.x ; mulss dst=b.x,src=a.y ; subss dst=p1,src=p2\n347\t    let p1 = x86_mul(b.y, a.x);\n348\t    let p2 = x86_mul(b.x, a.y);\n349\t    x86_sub(p1, p2)\n350\t}\n351\t\n352\t#[unsafe(no_mangle)]\n353\tpub unsafe extern \"C\" fn c2GJKSimplexMetric(s: *mut c2Simplex) -> f32 {\n354\t    match (*s).count {\n355\t        2 => c2Len(c2Sub((*s).b.p, (*s).a.p)),\n356\t        3 => c2Det2(c2Sub((*s).b.p, (*s).a.p), c2Sub((*s).c.p, (*s).a.p)),\n357\t        // `default:` and `case 1:` fall together in the C switch.\n358\t        _ => 0.0,\n359\t    }\n360\t}\n361\t\n362\t#[unsafe(no_mangle)]\n363\tpub extern \"C\" fn c2Mulrv(a: c2r, b: c2v) -> c2v {\n364\t    // gcc -O0 emits, for `a.c * b.x - a.s * b.y`:\n365\t    //   mulss dst=b.x,src=a.c ; mulss dst=b.y,src=a.s ; subss dst=p1,src=p2\n366\t    // and for `a.s * b.x + a.c * b.y`:\n367\t    //   mulss dst=a.s,src=b.x ; mulss dst=b.y,src=a.c ; addss dst=p1,src=p2\n368\t    c2V(\n369\t        x86_sub(x86_mul(b.x, a.c), x86_mul(b.y, a.s)),\n370\t        x86_add(x86_mul(a.s, b.x), x86_mul(b.y, a.c)),\n371\t    )\n372\t}\n373\t\n374\t#[unsafe(no_mangle)]\n375\tpub extern \"C\" fn c2MulrvT(a: c2r, b: c2v) -> c2v {\n376\t    // gcc -O0 emits, for `a.c * b.x + a.s * b.y`:\n377\t    //   mulss dst=a.c,src=b.x ; mulss dst=b.y,src=a.s ; addss dst=p1,src=p2\n378\t    // and for `-a.s * b.x + a.c * b.y`:\n379\t    //   xorps (negate) ; mulss dst=-a.s,src=b.x ; mulss dst=b.y,src=a.c ;\n380\t    //   addss dst=p1,src=p2\n381\t    c2V(\n382\t        x86_add(x86_mul(a.c, b.x), x86_mul(b.y, a.s)),\n383\t        x86_add(x86_mul(fneg(a.s), b.x), x86_mul(b.y, a.c)),\n384\t    )\n385\t}\n386\t\n387\t#[unsafe(no_mangle)]\n388\tpub extern \"C\" fn c2Add(a: c2v, b: c2v) -> c2v {\n389\t    // gcc: addss dst=b.x,src=a.x ; addss dst=b.y,src=a.y\n390\t    let mut a = a;\n391\t    a.x = x86_add(b.x, a.x);\n392\t    a.y = x86_add(b.y, a.y);\n393\t    a\n394\t}\n395\t\n396\t#[unsafe(no_mangle)]\n397\tpub extern \"C\" fn c2Mulxv(a: c2x, b: c2v) -> c2v {\n398\t    c2Add(c2Mulrv(a.r, b), a.p)\n399\t}\n400\t\n401\t#[unsafe(no_mangle)]\n402\tpub extern \"C\" fn c2MulxvT(a: c2x, b: c2v) -> c2v {\n403\t    c2MulrvT(a.r, c2Sub(b, a.p))\n404\t}\n405\t\n406\t#[unsafe(no_mangle)]\n407\tpub extern \"C\" fn c2Intersect(a: c2v, b: c2v, da: f32, db: f32) -> c2v {\n408\t    c2Add(a, c2Mulvs(c2Sub(b, a), da / (da - db)))\n409\t}\n410\t\n411\t/// `static int c2Clip(c2v *seg, c2h h)` — not exported.\n412\t///\n413\t/// The C version leaves `out[]` (partly) uninitialised when it returns < 2; the\n414\t/// two callers always bail out in that case without inspecting `seg`, so the\n415\t/// zero-initialisation used here is unobservable.\n416\tunsafe fn c2Clip(seg: *mut c2v, h: c2h) -> c_int {\n417\t    let mut out = [ZERO_V; 4];\n418\t    let mut sp: usize = 0;\n419\t    let d0: f32;\n420\t    let d1: f32;\n421\t    d0 = c2Dist(h, *seg.offset(0));\n422\t    if d0 < 0.0 {\n423\t        out[sp] = *seg.offset(0);\n424\t        sp += 1;\n425\t    }\n426\t    d1 = c2Dist(h, *seg.offset(1));\n427\t    if d1 < 0.0 {\n428\t        out[sp] = *seg.offset(1);\n429\t        sp += 1;\n430\t    }\n431\t    if d0 == 0.0 && d1 == 0.0 {\n432\t        out[sp] = *seg.offset(0);\n433\t        sp += 1;\n434\t        out[sp] = *seg.offset(1);\n435\t        sp += 1;\n436\t    } else if d0 * d1 <= 0.0 {\n437\t        out[sp] = c2Intersect(*seg.offset(0), *seg.offset(1), d0, d1);\n438\t        sp += 1;\n439\t    }\n440\t    *seg.offset(0) = out[0];\n441\t    *seg.offset(1) = out[1];\n442\t    sp as c_int\n443\t}\n444\t\n445\t#[unsafe(no_mangle)]\n446\tpub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n447\t    c2Mulvs(a, 1.0f32 / b)\n448\t}\n449\t\n450\t#[unsafe(no_mangle)]\n451\tpub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n452\t    c2Div(a, c2Len(a))\n453\t}\n454\t\n455\t#[unsafe(no_mangle)]\n456\tpub extern \"C\" fn c2Neg(a: c2v) -> c2v {\n457\t    c2V(fneg(a.x), fneg(a.y))\n458\t}\n459\t\n460\t#[unsafe(no_mangle)]\n461\tpub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n462\t    let mut b: c2v = ZERO_V;\n463\t    b.x = a.y;\n464\t    b.y = fneg(a.x);\n465\t    b\n466\t}\n467\t\n468\t/// `static int c2SidePlanes(c2v *seg, c2v ra, c2v rb, c2h *h)` — not exported.\n469\tunsafe fn c2SidePlanes(seg: *mut c2v, ra: c2v, rb: c2v, h: *mut c2h) -> c_int {\n470\t    let in_ = c2Norm(c2Sub(rb, ra));\n471\t    let left = c2h {\n472\t        n: c2Neg(in_),\n473\t        d: c2Dot(c2Neg(in_), ra),\n474\t    };\n475\t    let right = c2h {\n476\t        n: in_,\n477\t        d: c2Dot(in_, rb),\n478\t    };\n479\t    if c2Clip(seg, left) < 2 {\n480\t        return 0;\n481\t    }\n482\t    if c2Clip(seg, right) < 2 {\n483\t        return 0;\n484\t    }\n485\t    if !h.is_null() {\n486\t        (*h).n = c2CCW90(in_);\n487\t        (*h).d = c2Dot(c2CCW90(in_), ra);\n488\t    }\n489\t    1\n490\t}\n491\t\n492\t/// `static int c2SidePlanesFromPoly(...)` — not exported.\n493\tunsafe fn c2SidePlanesFromPoly(\n494\t    seg: *mut c2v,\n495\t    x: c2x,\n496\t    p: *const c2Poly,\n497\t    e: c_int,\n498\t    h: *mut c2h,\n499\t) -> c_int {\n500\t    let verts = (*p).verts.as_ptr();\n501\t    let ra = c2Mulxv(x, *verts.offset(e as isize));\n502\t    let next = if e + 1 == (*p).count { 0 } else { e + 1 };\n503\t    let rb = c2Mulxv(x, *verts.offset(next as isize));\n504\t    c2SidePlanes(seg, ra, rb, h)\n505\t}\n506\t\n507\t// ---------------------------------------------------------------------------\n508\t// GJK\n509\t// ---------------------------------------------------------------------------\n510\t\n511\t#[unsafe(no_mangle)]\n512\tpub unsafe extern \"C\" fn c22(s: *mut c2Simplex) {\n513\t    let a = (*s).a.p;\n514\t    let b = (*s).b.p;\n515\t    let u = c2Dot(b, c2Sub(b, a));\n516\t    let v = c2Dot(a, c2Sub(a, b));\n517\t    if v <= 0.0 {\n518\t        (*s).a.u = 1.0f32;\n519\t        (*s).div = 1.0f32;\n520\t        (*s).count = 1;\n521\t    } else if u <= 0.0 {\n522\t        (*s).a = (*s).b;\n523\t        (*s).a.u = 1.0f32;\n524\t        (*s).div = 1.0f32;\n525\t        (*s).count = 1;\n526\t    } else {\n527\t        (*s).a.u = u;\n528\t        (*s).b.u = v;\n529\t        (*s).div = x86_add(u, v); // gcc: addss dst=u,src=v\n530\t        (*s).count = 2;\n531\t    }\n532\t}\n533\t\n534\t#[unsafe(no_mangle)]\n535\tpub unsafe extern \"C\" fn c23(s: *mut c2Simplex) {\n536\t    let a = (*s).a.p;\n537\t    let b = (*s).b.p;\n538\t    let c = (*s).c.p;\n539\t    let uAB = c2Dot(b, c2Sub(b, a));\n540\t    let vAB = c2Dot(a, c2Sub(a, b));\n541\t    let uBC = c2Dot(c, c2Sub(c, b));\n542\t    let vBC = c2Dot(b, c2Sub(b, c));\n543\t    let uCA = c2Dot(a, c2Sub(a, c));\n544\t    let vCA = c2Dot(c, c2Sub(c, a));\n545\t    let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n546\t    // gcc: mulss dst=<c2Det2 result>, src=area\n547\t    let uABC = x86_mul(c2Det2(b, c), area);\n548\t    let vABC = x86_mul(c2Det2(c, a), area);\n549\t    let wABC = x86_mul(c2Det2(a, b), area);\n550\t    if vAB <= 0.0 && uCA <= 0.0 {\n551\t        (*s).a.u = 1.0f32;\n552\t        (*s).div = 1.0f32;\n553\t        (*s).count = 1;\n554\t    } else if uAB <= 0.0 && vBC <= 0.0 {\n555\t        (*s).a = (*s).b;\n556\t        (*s).a.u = 1.0f32;\n557\t        (*s).div = 1.0f32;\n558\t        (*s).count = 1;\n559\t    } else if uBC <= 0.0 && vCA <= 0.0 {\n560\t        (*s).a = (*s).c;\n561\t        (*s).a.u = 1.0f32;\n562\t        (*s).div = 1.0f32;\n563\t        (*s).count = 1;\n564\t    } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n565\t        (*s).a.u = uAB;\n566\t        (*s).b.u = vAB;\n567\t        (*s).div = x86_add(uAB, vAB);\n568\t        (*s).count = 2;\n569\t    } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n570\t        (*s).a = (*s).b;\n571\t        (*s).b = (*s).c;\n572\t        (*s).a.u = uBC;\n573\t        (*s).b.u = vBC;\n574\t        (*s).div = x86_add(uBC, vBC);\n575\t        (*s).count = 2;\n576\t    } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n577\t        (*s).b = (*s).a;\n578\t        (*s).a = (*s).c;\n579\t        (*s).a.u = uCA;\n580\t        (*s).b.u = vCA;\n581\t        (*s).div = x86_add(uCA, vCA);\n582\t        (*s).count = 2;\n583\t    } else {\n584\t        (*s).a.u = uABC;\n585\t        (*s).b.u = vABC;\n586\t        (*s).c.u = wABC;\n587\t        (*s).div = x86_add(x86_add(uABC, vABC), wABC);\n588\t        (*s).count = 3;\n589\t    }\n590\t}\n591\t\n592\t#[unsafe(no_mangle)]\n593\tpub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n594\t    let mut b: c2v = ZERO_V;\n595\t    b.x = fneg(a.y);\n596\t    b.y = a.x;\n597\t    b\n598\t}\n599\t\n600\t#[unsafe(no_mangle)]\n601\tpub unsafe extern \"C\" fn c2D(s: *mut c2Simplex) -> c2v {\n602\t    match (*s).count {\n603\t        1 => c2Neg((*s).a.p),\n604\t        2 => {\n605\t            let ab = c2Sub((*s).b.p, (*s).a.p);\n606\t            if c2Det2(ab, c2Neg((*s).a.p)) > 0.0 {\n607\t                return c2Skew(ab);\n608\t            }\n609\t            c2CCW90(ab)\n610\t        }\n611\t        // `case 3:` and `default:`\n612\t        _ => c2V(0.0, 0.0),\n613\t    }\n614\t}\n615\t\n616\t#[unsafe(no_mangle)]\n617\tpub unsafe extern \"C\" fn c2Support(verts: *const c2v, count: c_int, d: c2v) -> c_int {\n618\t    let mut imax: c_int = 0;\n619\t    let mut dmax = c2Dot(*verts.offset(0), d);\n620\t    let mut i: c_int = 1;\n621\t    while i < count {\n622\t        let dot = c2Dot(*verts.offset(i as isize), d);\n623\t        if dot > dmax {\n624\t            imax = i;\n625\t            dmax = dot;\n626\t        }\n627\t        i += 1;\n628\t    }\n629\t    imax\n630\t}\n631\t\n632\t#[unsafe(no_mangle)]\n633\tpub unsafe extern \"C\" fn c2Witness(s: *mut c2Simplex, a: *mut c2v, b: *mut c2v) {\n634\t    let den = 1.0f32 / (*s).div;\n635\t    match (*s).count {\n636\t        1 => {\n637\t            *a = (*s).a.sA;\n638\t            *b = (*s).a.sB;\n639\t        }\n640\t        2 => {\n641\t            *a = c2Add(\n642\t                c2Mulvs((*s).a.sA, x86_mul((*s).a.u, den)),\n643\t                c2Mulvs((*s).b.sA, x86_mul((*s).b.u, den)),\n644\t            );\n645\t            *b = c2Add(\n646\t                c2Mulvs((*s).a.sB, x86_mul((*s).a.u, den)),\n647\t                c2Mulvs((*s).b.sB, x86_mul((*s).b.u, den)),\n648\t            );\n649\t        }\n650\t        3 => {\n651\t            *a = c2Add(\n652\t                c2Add(\n653\t                    c2Mulvs((*s).a.sA, x86_mul((*s).a.u, den)),\n654\t                    c2Mulvs((*s).b.sA, x86_mul((*s).b.u, den)),\n655\t                ),\n656\t                c2Mulvs((*s).c.sA, x86_mul((*s).c.u, den)),\n657\t            );\n658\t            *b = c2Add(\n659\t                c2Add(\n660\t                    c2Mulvs((*s).a.sB, x86_mul((*s).a.u, den)),\n661\t                    c2Mulvs((*s).b.sB, x86_mul((*s).b.u, den)),\n662\t                ),\n663\t                c2Mulvs((*s).c.sB, x86_mul((*s).c.u, den)),\n664\t            );\n665\t        }\n666\t        _ => {\n667\t            *a = c2V(0.0, 0.0);\n668\t            *b = c2V(0.0, 0.0);\n669\t        }\n670\t    }\n671\t}\n672\t\n673\t#[unsafe(no_mangle)]\n674\tpub unsafe extern \"C\" fn c2L(s: *mut c2Simplex) -> c2v {\n675\t    let den = 1.0f32 / (*s).div;\n676\t    match (*s).count {\n677\t        1 => (*s).a.p,\n678\t        2 => c2Add(\n679\t            c2Mulvs((*s).a.p, x86_mul((*s).a.u, den)),\n680\t            c2Mulvs((*s).b.p, x86_mul((*s).b.u, den)),\n681\t        ),\n682\t        _ => c2V(0.0, 0.0),\n683\t    }\n684\t}\n685\t\n686\t#[unsafe(no_mangle)]\n687\tpub unsafe extern \"C\" fn c2GJK(\n688\t    A: *const c_void,\n689\t    typeA: c_int,\n690\t    ax_ptr: *const c2x,\n691\t    B: *const c_void,\n692\t    typeB: c_int,\n693\t    bx_ptr: *const c2x,\n694\t    outA: *mut c2v,\n695\t    outB: *mut c2v,\n696\t    use_radius: c_int,\n697\t    iterations: *mut c_int,\n698\t    cache: *mut c2GJKCache,\n699\t) -> f32 {\n700\t    let ax: c2x;\n701\t    let bx: c2x;\n702\t    if ax_ptr.is_null() {\n703\t        ax = c2xIdentity();\n704\t    } else {\n705\t        ax = *ax_ptr;\n706\t    }\n707\t    if bx_ptr.is_null() {\n708\t        bx = c2xIdentity();\n709\t    } else {\n710\t        bx = *bx_ptr;\n711\t    }\n712\t    // In C these two proxies are uninitialised locals; `c2MakeProxy` has no\n713\t    // `C2_TYPE_POLY` case, so for a poly the proxy keeps whatever the stack held\n714\t    // (radius 0 / count 0 / verts {0,0} on a freshly used stack).\n715\t    let mut pA: c2Proxy = std::mem::zeroed();\n716\t    let mut pB: c2Proxy = std::mem::zeroed();\n717\t    c2MakeProxy(A, typeA, &mut pA);\n718\t    c2MakeProxy(B, typeB, &mut pB);\n719\t    let mut s: c2Simplex = std::mem::zeroed();\n720\t    // `c2sv* verts = &s.a;` — indexes a, b, c, d contiguously.\n721\t    let verts: *mut c2sv = &mut s as *mut c2Simplex as *mut c2sv;\n722\t    let mut cache_was_read: c_int = 0;\n723\t    if !cache.is_null() {\n724\t        let cache_was_good: c_int = ((*cache).count != 0) as c_int;\n725\t        if cache_was_good != 0 {\n726\t            let mut i: c_int = 0;\n727\t            while i < (*cache).count {\n728\t                let iA = *(*cache).iA.as_ptr().offset(i as isize);\n729\t                let iB = *(*cache).iB.as_ptr().offset(i as isize);\n730\t                let sA = c2Mulxv(ax, *pA.verts.as_ptr().offset(iA as isize));\n731\t                let sB = c2Mulxv(bx, *pB.verts.as_ptr().offset(iB as isize));\n732\t                let v: *mut c2sv = verts.offset(i as isize);\n733\t                (*v).iA = iA;\n734\t                (*v).sA = sA;\n735\t                (*v).iB = iB;\n736\t                (*v).sB = sB;\n737\t                (*v).p = c2Sub((*v).sB, (*v).sA);\n738\t                (*v).u = 0.0;\n739\t                i += 1;\n740\t            }\n741\t            s.count = (*cache).count;\n742\t            s.div = (*cache).div;\n743\t            let metric_old = (*cache).metric;\n744\t            let metric = c2GJKSimplexMetric(&mut s);\n745\t            let min_metric = if metric < metric_old { metric } else { metric_old };\n746\t            let max_metric = if metric > metric_old { metric } else { metric_old };\n747\t            if !(min_metric < max_metric * 2.0f32 && metric < -1.0e8f32) {\n748\t                cache_was_read = 1;\n749\t            }\n750\t        }\n751\t    }\n752\t    if cache_was_read == 0 {\n753\t        s.a.iA = 0;\n754\t        s.a.iB = 0;\n755\t        s.a.sA = c2Mulxv(ax, pA.verts[0]);\n756\t        s.a.sB = c2Mulxv(bx, pB.verts[0]);\n757\t        s.a.p = c2Sub(s.a.sB, s.a.sA);\n758\t        s.a.u = 1.0f32;\n759\t        s.div = 1.0f32;\n760\t        s.count = 1;\n761\t    }\n762\t    let mut saveA: [c_int; 3] = [0; 3];\n763\t    let mut saveB: [c_int; 3] = [0; 3];\n764\t    let mut save_count: c_int = 0;\n765\t    let mut d0: f32 = FLT_MAX;\n766\t    let mut d1: f32 = FLT_MAX;\n767\t    let mut iter: c_int = 0;\n768\t    let mut hit: c_int = 0;\n769\t    while iter < 20 {\n770\t        save_count = s.count;\n771\t        {\n772\t            let mut i: c_int = 0;\n773\t            while i < save_count {\n774\t                *saveA.as_mut_ptr().offset(i as isize) = (*verts.offset(i as isize)).iA;\n775\t                *saveB.as_mut_ptr().offset(i as isize) = (*verts.offset(i as isize)).iB;\n776\t                i += 1;\n777\t            }\n778\t        }\n779\t        match s.count {\n780\t            1 => {}\n781\t            2 => c22(&mut s),\n782\t            3 => c23(&mut s),\n783\t            _ => {}\n784\t        }\n785\t        if s.count == 3 {\n786\t            hit = 1;\n787\t            break;\n788\t        }\n789\t        let p = c2L(&mut s);\n790\t        d1 = c2Dot(p, p);\n791\t        if d1 > d0 {\n792\t            break;\n793\t        }\n794\t        d0 = d1;\n795\t        let d = c2D(&mut s);\n796\t        if c2Dot(d, d) < FLT_EPSILON * FLT_EPSILON {\n797\t            break;\n798\t        }\n799\t        let iA = c2Support(pA.verts.as_ptr(), pA.count, c2MulrvT(ax.r, c2Neg(d)));\n800\t        let sA = c2Mulxv(ax, *pA.verts.as_ptr().offset(iA as isize));\n801\t        let iB = c2Support(pB.verts.as_ptr(), pB.count, c2MulrvT(bx.r, d));\n802\t        let sB = c2Mulxv(bx, *pB.verts.as_ptr().offset(iB as isize));\n803\t        let v: *mut c2sv = verts.offset(s.count as isize);\n804\t        (*v).iA = iA;\n805\t        (*v).sA = sA;\n806\t        (*v).iB = iB;\n807\t        (*v).sB = sB;\n808\t        (*v).p = c2Sub((*v).sB, (*v).sA);\n809\t        let mut dup: c_int = 0;\n810\t        {\n811\t            let mut i: c_int = 0;\n812\t            while i < save_count {\n813\t                if iA == *saveA.as_ptr().offset(i as isize)\n814\t                    && iB == *saveB.as_ptr().offset(i as isize)\n815\t                {\n816\t                    dup = 1;\n817\t                    break;\n818\t                }\n819\t                i += 1;\n820\t            }\n821\t        }\n822\t        if dup != 0 {\n823\t            break;\n824\t        }\n825\t        s.count += 1;\n826\t        iter += 1;\n827\t    }\n828\t    let mut a: c2v = ZERO_V;\n829\t    let mut b: c2v = ZERO_V;\n830\t    c2Witness(&mut s, &mut a, &mut b);\n831\t    let mut dist = c2Len(c2Sub(a, b));\n832\t    if hit != 0 {\n833\t        a = b;\n834\t        dist = 0.0;\n835\t    } else if use_radius != 0 {\n836\t        let rA = pA.radius;\n837\t        let rB = pB.radius;\n838\t        if dist > rA + rB && dist > FLT_EPSILON {\n839\t            dist -= rA + rB;\n840\t            let n = c2Norm(c2Sub(b, a));\n841\t            a = c2Add(a, c2Mulvs(n, rA));\n842\t            b = c2Sub(b, c2Mulvs(n, rB));\n843\t            if a.x == b.x && a.y == b.y {\n844\t                dist = 0.0;\n845\t            }\n846\t        } else {\n847\t            let p = c2Mulvs(c2Add(a, b), 0.5f32);\n848\t            a = p;\n849\t            b = p;\n850\t            dist = 0.0;\n851\t        }\n852\t    }\n853\t    if !cache.is_null() {\n854\t        (*cache).metric = c2GJKSimplexMetric(&mut s);\n855\t        (*cache).count = s.count;\n856\t        let mut i: c_int = 0;\n857\t        while i < s.count {\n858\t            let v: *mut c2sv = verts.offset(i as isize);\n859\t            *(*cache).iA.as_mut_ptr().offset(i as isize) = (*v).iA;\n860\t            *(*cache).iB.as_mut_ptr().offset(i as isize) = (*v).iB;\n861\t            i += 1;\n862\t        }\n863\t        (*cache).div = s.div;\n864\t    }\n865\t    if !outA.is_null() {\n866\t        *outA = a;\n867\t    }\n868\t    if !outB.is_null() {\n869\t        *outB = b;\n870\t    }\n871\t    if !iterations.is_null() {\n872\t        *iterations = iter;\n873\t    }\n874\t    let _ = d1;\n875\t    let _ = save_count;\n876\t    dist\n877\t}\n878\t\n879\t#[unsafe(no_mangle)]\n880\tpub extern \"C\" fn c2Absv(a: c2v) -> c2v {\n881\t    c2V(\n882\t        if a.x < 0.0 { fneg(a.x) } else { a.x },\n883\t        if a.y < 0.0 { fneg(a.y) } else { a.y },\n884\t    )\n885\t}\n886\t\n887\t// ---------------------------------------------------------------------------\n888\t// Manifold generation\n889\t// ---------------------------------------------------------------------------\n890\t\n891\t#[unsafe(no_mangle)]\n892\tpub unsafe extern \"C\" fn c2CircletoCircleManifold(A: c2Circle, B: c2Circle, m: *mut c2Manifold) {\n893\t    (*m).count = 0;\n894\t    let d = c2Sub(B.p, A.p);\n895\t    let d2 = c2Dot(d, d);\n896\t    let r = A.r + B.r;\n897\t    if d2 < r * r {\n898\t        let l = d2.sqrt();\n899\t        let n = if l != 0.0 {\n900\t            c2Mulvs(d, 1.0f32 / l)\n901\t        } else {\n902\t            c2V(0.0, 1.0f32)\n903\t        };\n904\t        (*m).count = 1;\n905\t        (*m).depths[0] = r - l;\n906\t        (*m).contact_points[0] = c2Sub(B.p, c2Mulvs(n, B.r));\n907\t        (*m).n = n;\n908\t    }\n909\t}\n910\t\n911\t#[unsafe(no_mangle)]\n912\tpub unsafe extern \"C\" fn c2CircletoAABBManifold(A: c2Circle, B: c2AABB, m: *mut c2Manifold) {\n913\t    (*m).count = 0;\n914\t    let L = c2Clampv(A.p, B.min, B.max);\n915\t    let ab = c2Sub(L, A.p);\n916\t    let d2 = c2Dot(ab, ab);\n917\t    let r2 = A.r * A.r;\n918\t    if d2 < r2 {\n919\t        if d2 != 0.0 {\n920\t            let d = d2.sqrt();\n921\t            let n = c2Norm(ab);\n922\t            (*m).count = 1;\n923\t            (*m).depths[0] = A.r - d;\n924\t            (*m).contact_points[0] = c2Add(A.p, c2Mulvs(n, d));\n925\t            (*m).n = n;\n926\t        } else {\n927\t            let mid = c2Mulvs(c2Add(B.min, B.max), 0.5f32);\n928\t            let e = c2Mulvs(c2Sub(B.max, B.min), 0.5f32);\n929\t            let d = c2Sub(A.p, mid);\n930\t            let abs_d = c2Absv(d);\n931\t            let x_overlap = e.x - abs_d.x;\n932\t            let y_overlap = e.y - abs_d.y;\n933\t            let depth: f32;\n934\t            let mut n: c2v;\n935\t            if x_overlap < y_overlap {\n936\t                depth = x_overlap;\n937\t                n = c2V(1.0f32, 0.0);\n938\t                n = c2Mulvs(n, if d.x < 0.0 { 1.0f32 } else { -1.0f32 });\n939\t            } else {\n940\t                depth = y_overlap;\n941\t                n = c2V(0.0, 1.0f32);\n942\t                n = c2Mulvs(n, if d.y < 0.0 { 1.0f32 } else { -1.0f32 });\n943\t            }\n944\t            (*m).count = 1;\n945\t            (*m).depths[0] = A.r + depth;\n946\t            (*m).contact_points[0] = c2Sub(A.p, c2Mulvs(n, depth));\n947\t            (*m).n = n;\n948\t        }\n949\t    }\n950\t}\n951\t\n952\t#[unsafe(no_mangle)]\n953\tpub unsafe extern \"C\" fn c2CircletoCapsuleManifold(A: c2Circle, B: c2Capsule, m: *mut c2Manifold) {\n954\t    (*m).count = 0;\n955\t    let mut a: c2v = ZERO_V;\n956\t    let mut b: c2v = ZERO_V;\n957\t    let r = A.r + B.r;\n958\t    let d = c2GJK(\n959\t        &A as *const c2Circle as *const c_void,\n960\t        C2_TYPE_CIRCLE,\n961\t        std::ptr::null(),\n962\t        &B as *const c2Capsule as *const c_void,\n963\t        C2_TYPE_CAPSULE,\n964\t        std::ptr::null(),\n965\t        &mut a,\n966\t        &mut b,\n967\t        0,\n968\t        std::ptr::null_mut(),\n969\t        std::ptr::null_mut(),\n970\t    );\n971\t    if d < r {\n972\t        let n: c2v;\n973\t        if d == 0.0 {\n974\t            n = c2Norm(c2Skew(c2Sub(B.b, B.a)));\n975\t        } else {\n976\t            n = c2Norm(c2Sub(b, a));\n977\t        }\n978\t        (*m).count = 1;\n979\t        (*m).depths[0] = r - d;\n980\t        (*m).contact_points[0] = c2Sub(b, c2Mulvs(n, B.r));\n981\t        (*m).n = n;\n982\t    }\n983\t}\n984\t\n985\t#[unsafe(no_mangle)]\n986\tpub unsafe extern \"C\" fn c2AABBtoAABBManifold(A: c2AABB, B: c2AABB, m: *mut c2Manifold) {\n987\t    (*m).count = 0;\n988\t    let mid_a = c2Mulvs(c2Add(A.min, A.max), 0.5f32);\n989\t    let mid_b = c2Mulvs(c2Add(B.min, B.max), 0.5f32);\n990\t    let eA = c2Absv(c2Mulvs(c2Sub(A.max, A.min), 0.5f32));\n991\t    let eB = c2Absv(c2Mulvs(c2Sub(B.max, B.min), 0.5f32));\n992\t    let d = c2Sub(mid_b, mid_a);\n993\t    // gcc: addss dst=eA.x,src=eB.x ; subss dst=<sum>,src=|d.x|\n994\t    let dx = x86_sub(\n995\t        x86_add(eA.x, eB.x),\n996\t        if d.x < 0.0 { fneg(d.x) } else { d.x },\n997\t    );\n998\t    if dx < 0.0 {\n999\t        return;\n1000\t    }\n1001\t    let dy = x86_sub(\n1002\t        x86_add(eA.y, eB.y),\n1003\t        if d.y < 0.0 { fneg(d.y) } else { d.y },\n1004\t    );\n1005\t    if dy < 0.0 {\n1006\t        return;\n1007\t    }\n1008\t    let n: c2v;\n1009\t    let depth: f32;\n1010\t    let p: c2v;\n1011\t    if dx < dy {\n1012\t        depth = dx;\n1013\t        if d.x < 0.0 {\n1014\t            n = c2V(-1.0f32, 0.0);\n1015\t            p = c2Sub(mid_a, c2V(eA.x, 0.0));\n1016\t        } else {\n1017\t            n = c2V(1.0f32, 0.0);\n1018\t            p = c2Add(mid_a, c2V(eA.x, 0.0));\n1019\t        }\n1020\t    } else {\n1021\t        depth = dy;\n1022\t        if d.y < 0.0 {\n1023\t            n = c2V(0.0, -1.0f32);\n1024\t            p = c2Sub(mid_a, c2V(0.0, eA.y));\n1025\t        } else {\n1026\t            n = c2V(0.0, 1.0f32);\n1027\t            p = c2Add(mid_a, c2V(0.0, eA.y));\n1028\t        }\n1029\t    }\n1030\t    (*m).count = 1;\n1031\t    (*m).contact_points[0] = p;\n1032\t    (*m).depths[0] = depth;\n1033\t    (*m).n = n;\n1034\t}\n1035\t\n1036\t/// `static void c2KeepDeep(c2v *seg, c2h h, c2Manifold *m)` — not exported.\n1037\tunsafe fn c2KeepDeep(seg: *mut c2v, h: c2h, m: *mut c2Manifold) {\n1038\t    let mut cp: c_int = 0;\n1039\t    let mut i: c_int = 0;\n1040\t    while i < 2 {\n1041\t        let p = *seg.offset(i as isize);\n1042\t        let d = c2Dist(h, p);\n1043\t        if d <= 0.0 {\n1044\t            *(*m).contact_points.as_mut_ptr().offset(cp as isize) = p;\n1045\t            *(*m).depths.as_mut_ptr().offset(cp as isize) = fneg(d);\n1046\t            cp += 1;\n1047\t        }\n1048\t        i += 1;\n1049\t    }\n1050\t    (*m).count = cp;\n1051\t    (*m).n = h.n;\n1052\t}\n1053\t\n1054\t/// `static void c2Incident(...)` — not exported.\n1055\tunsafe fn c2Incident(incident: *mut c2v, ip: *const c2Poly, ix: c2x, rn_in_incident_space: c2v) {\n1056\t    let mut index: c_int = !0;\n1057\t    let mut min_dot: f32 = FLT_MAX;\n1058\t    let norms = (*ip).norms.as_ptr();\n1059\t    let verts = (*ip).vert