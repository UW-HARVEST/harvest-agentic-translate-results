{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_ikxedd5iozbuglpbmfeou3ukep5icjfvuls3esi5d4hyhzol2dkq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_015PgokShnHgG5QD5BqWcLNU","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-mnIJO3/translation/tests/probe2.rs","content":"//! Scratch probe 2: quantify how often the uninitialised-proxy (POLY) path\n//! actually diverges, and what the C's stack garbage looks like.\n#![allow(non_snake_case)]\n\nmod common;\nuse common::*;\nuse std::os::raw::c_int;\n\n#[test]\nfn probe_reveal_garbage() {\n    // With a 1-vertex proxy for A and POLY for B, `outB` == pB.verts[0] verbatim\n    // whenever the loop terminates at count == 1.\n    let ca = c2Circle {\n        p: c2v { x: 100.0, y: 100.0 },\n        r: 0.0,\n    };\n    let poly = make_poly(&[c2v { x: 0.0, y: 0.0 }; 8], 4);\n    for rep in 0..5 {\n        for side in [Side::C, Side::Rust] {\n            let mut oa = c2v::default();\n            let mut ob = c2v::default();\n            let mut it: c_int = -1;\n            let d = c2GJK(\n                side,\n                &ca as *const c2Circle as *const _,\n                C2_TYPE_CIRCLE,\n                std::ptr::null(),\n                &poly as *const c2Poly as *const _,\n                C2_TYPE_POLY,\n                std::ptr::null(),\n                &mut oa,\n                &mut ob,\n                0,\n                &mut it,\n                std::ptr::null_mut(),\n            );\n            eprintln!(\n                \"rep{rep} {side:?}: d={} oa={} ob={} it={}\",\n                d.show(),\n                oa.show(),\n                ob.show(),\n                it\n            );\n        }\n    }\n}\n\n#[test]\nfn probe_poly_divergence_rate() {\n    let mut rng = Rng::new(1234);\n    let mut diverge_manifold = 0usize;\n    let mut diverge_gjk = 0usize;\n    let total = 20000;\n    let mut first_manifold = String::new();\n    let mut first_gjk = String::new();\n    for i in 0..total {\n        let count = 3 + rng.below(6) as usize;\n        let verts = rng.convex_poly_verts(count);\n        let poly = make_poly(&verts, count as c_int);\n        let cap = rng.capsule();\n        let bx = if rng.bool() { Some(rng.xform()) } else { None };\n        let bxp = match &bx {\n            Some(x) => x as *const c2x,\n            None => std::ptr::null(),\n        };\n\n        let run_m = |side: Side| {\n            let mut m = SENTINEL_MANIFOLD;\n            c2CapsuletoPolyManifold(side, cap, &poly, bxp, &mut m);\n            m\n        };\n        let mc = run_m(Side::C);\n        let mr = run_m(Side::Rust);\n        if !mc.bit_eq(&mr) {\n            diverge_manifold += 1;\n            if first_manifold.is_empty() {\n                first_manifold = format!(\n                    \"#{i} cap={cap:?} count={count} bx={bx:?}\\n  C   ={}\\n  Rust={}\",\n                    mc.show(),\n                    mr.show()\n                );\n            }\n        }\n\n        let run_g = |side: Side| {\n            let mut oa = c2v::default();\n            let mut ob = c2v::default();\n            let mut it: c_int = -1;\n            let d = c2GJK(\n                side,\n                &cap as *const c2Capsule as *const _,\n                C2_TYPE_CAPSULE,\n                std::ptr::null(),\n                &poly as *const c2Poly as *const _,\n                C2_TYPE_POLY,\n                bxp,\n                &mut oa,\n                &mut ob,\n                0,\n                &mut it,\n                std::ptr::null_mut(),\n            );\n            (d, oa, ob, it)\n        };\n        let gc = run_g(Side::C);\n        let gr = run_g(Side::Rust);\n        if !gc.bit_eq(&gr) {\n            diverge_gjk += 1;\n            if first_gjk.is_empty() {\n                first_gjk = format!(\n                    \"#{i} cap={cap:?} count={count}\\n  C   ={}\\n  Rust={}\",\n                    gc.show(),\n                    gr.show()\n                );\n            }\n        }\n    }\n    eprintln!(\"c2CapsuletoPolyManifold divergence: {diverge_manifold}/{total}\");\n    if !first_manifold.is_empty() {\n        eprintln!(\"first: {first_manifold}\");\n    }\n    eprintln!(\"raw c2GJK(POLY) divergence: {diverge_gjk}/{total}\");\n    if !first_gjk.is_empty() {\n        eprintln!(\"first: {first_gjk}\");\n    }\n}\n\n#[test]\nfn probe_aabb_capsule_rate() {\n    let mut rng = Rng::new(555);\n    let mut diverge = 0usize;\n    let total = 20000;\n    let mut first = String::new();\n    for i in 0..total {\n        let bb = rng.aabb();\n        let cap = rng.capsule();\n        let run = |side: Side| {\n            let mut m = SENTINEL_MANIFOLD;\n            c2AABBtoCapsuleManifold(side, bb, cap, &mut m);\n            m\n        };\n        let c = run(Side::C);\n        let r = run(Side::Rust);\n        if !c.bit_eq(&r) {\n            diverge += 1;\n            if first.is_empty() {\n                first = format!(\n                    \"#{i} bb={bb:?} cap={cap:?}\\n  C   ={}\\n  Rust={}\",\n                    c.show(),\n                    r.show()\n                );\n            }\n        }\n    }\n    eprintln!(\"c2AABBtoCapsuleManifold divergence: {diverge}/{total}\");\n    if !first.is_empty() {\n        eprintln!(\"first: {first}\");\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3707,"cache_read_input_tokens":146065,"cache_creation":{"ephemeral_5m_input_tokens":3707,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"4bcc327f-132f-463a-99a7-0691637f7d66","uuid":"70905e71-3c5f-44b5-b9a4-83c23b42fed6","timestamp":"2026-08-27T12:50:04.136Z"}
