 *const c2Circle as *const _,\n        C2_TYPE_CIRCLE,\n        std::ptr::null(),\n        &mut oa,\n        &mut ob,\n        0,\n        std::ptr::null_mut(),\n        std::ptr::null_mut(),\n    );\n}\n\n#[test]\nfn probe_leftover_identity() {\n    eprintln!(\"-- baseline poly probe --\");\n    let r0 = gjk_poly_probe(Side::C, 100.0, 100.0);\n    eprintln!(\"baseline C ob = {}\", r0.2.show());\n\n    eprintln!(\"-- after a CIRCLE/CIRCLE call with distinctive verts --\");\n    gjk_circles(Side::C, (7.0, 8.0), (9.0, 10.0));\n    let r1 = gjk_poly_probe(Side::C, 100.0, 100.0);\n    eprintln!(\"after (7,8)/(9,10): C ob = {}   (== (9,10)?)\", r1.2.show());\n\n    gjk_circles(Side::C, (1.5, 2.5), (-3.25, 4.75));\n    let r2 = gjk_poly_probe(Side::C, 100.0, 100.0);\n    eprintln!(\n        \"after (1.5,2.5)/(-3.25,4.75): C ob = {}   (== (-3.25,4.75)?)\",\n        r2.2.show()\n    );\n\n    eprintln!(\"-- repeat poly probe twice in a row (self-perpetuating?) --\");\n    let r3 = gjk_poly_probe(Side::C, 100.0, 100.0);\n    let r4 = gjk_poly_probe(Side::C, 100.0, 100.0);\n    eprintln!(\"r3 ob = {}\", r3.2.show());\n    eprintln!(\"r4 ob = {}\", r4.2.show());\n\n    eprintln!(\"-- does an intervening Rust call change it? --\");\n    gjk_circles(Side::Rust, (11.0, 12.0), (13.0, 14.0));\n    let r5 = gjk_poly_probe(Side::C, 100.0, 100.0);\n    eprintln!(\"after Rust circle call: C ob = {}\", r5.2.show());\n\n    eprintln!(\"-- AABB/AABB then poly probe --\");\n    let bb = c2AABB {\n        min: c2v { x: -21.0, y: -22.0 },\n        max: c2v { x: 23.0, y: 24.0 },\n    };\n    let mut m = SENTINEL_MANIFOLD;\n    c2AABBtoAABBManifold(Side::C, bb, bb, &mut m);\n    let r6 = gjk_poly_probe(Side::C, 100.0, 100.0);\n    eprintln!(\"after AABBtoAABB: C ob = {}\", r6.2.show());\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
