\n1116\t        let s0 = c2Dist(ab_h0, *bverts.offset(v0 as isize));\n1117\t        let mut ab_h1 = c2h { n: ZERO_V, d: 0.0 };\n1118\t        ab_h1.n = c2Skew(ab);\n1119\t        ab_h1.d = c2Dot(A_in_B.a, ab_h1.n);\n1120\t        let v1 = c2Support(bverts, (*B).count, c2Neg(ab_h1.n));\n1121\t        let s1 = c2Dist(ab_h1, *bverts.offset(v1 as isize));\n1122\t        let mut index: c_int = !0;\n1123\t        let mut sep: f32 = -FLT_MAX;\n1124\t        let mut code: c_int = 0;\n1125\t        let mut i: c_int = 0;\n1126\t        while i < (*B).count {\n1127\t            let h = c2PlaneAt(B, i);\n1128\t            let da = c2Dot(A_in_B.a, c2Neg(h.n));\n1129\t            let db = c2Dot(A_in_B.b, c2Neg(h.n));\n1130\t            let d: f32;\n1131\t            if da > db {\n1132\t                d = c2Dist(h, A_in_B.a);\n1133\t            } else {\n1134\t                d = c2Dist(h, A_in_B.b);\n1135\t            }\n1136\t            if d > sep {\n1137\t                sep = d;\n1138\t                index = i;\n1139\t            }\n1140\t            i += 1;\n1141\t        }\n1142\t        if s0 > sep {\n1143\t            sep = s0;\n1144\t            index = v0;\n1145\t            code = 1;\n1146\t        }\n1147\t        if s1 > sep {\n1148\t            sep = s1;\n1149\t            index = v1;\n1150\t            code = 2;\n1151\t        }\n1152\t        match code {\n1153\t            0 => {\n1154\t                let mut seg: [c2v; 2] = [A.a, A.b];\n1155\t                let mut h = c2h { n: ZERO_V, d: 0.0 };\n1156\t                if c2SidePlanesFromPoly(seg.as_mut_ptr(), bx, B, index, &mut h) == 0 {\n1157\t                    return;\n1158\t                }\n1159\t                c2KeepDeep(seg.as_mut_ptr(), h, m);\n1160\t                (*m).n = c2Neg((*m).n);\n1161\t            }\n1162\t            1 => {\n1163\t                let mut incident: [c2v; 2] = [ZERO_V; 2];\n1164\t                c2Incident(incident.as_mut_ptr(), B, bx, ab_h0.n);\n1165\t                let mut h = c2h { n: ZERO_V, d: 0.0 };\n1166\t                if c2SidePlanes(incident.as_mut_ptr(), A_in_B.b, A_in_B.a, &mut h) == 0 {\n1167\t                    return;\n1168\t                }\n1169\t                c2KeepDeep(incident.as_mut_ptr(), h, m);\n1170\t            }\n1171\t            2 => {\n1172\t                let mut incident: [c2v; 2] = [ZERO_V; 2];\n1173\t                c2Incident(incident.as_mut_ptr(), B, bx, ab_h1.n);\n1174\t                let mut h = c2h { n: ZERO_V, d: 0.0 };\n1175\t                if c2SidePlanes(incident.as_mut_ptr(), A_in_B.a, A_in_B.b, &mut h) == 0 {\n1176\t                    return;\n1177\t                }\n1178\t                c2KeepDeep(incident.as_mut_ptr(), h, m);\n1179\t            }\n1180\t            _ => {\n1181\t                return;\n1182\t            }\n1183\t        }\n1184\t        let mut i: c_int = 0;\n1185\t        while i < (*m).count {\n1186\t            *(*m).depths.as_mut_ptr().offset(i as isize) += A.r;\n1187\t            i += 1;\n1188\t        }\n1189\t    } else if d < A.r {\n1190\t        (*m).count = 1;\n1191\t        (*m).n = c2Norm(c2Sub(b, a));\n1192\t        (*m).contact_points[0] = c2Add(a, c2Mulvs((*m).n, A.r));\n1193\t        (*m).depths[0] = A.r - d;\n1194\t    }\n1195\t}\n1196\t\n1197\t#[unsafe(no_mangle)]\n1198\tpub unsafe extern \"C\" fn c2Norms(verts: *mut c2v, norms: *mut c2v, count: c_int) {\n1199\t    let mut i: c_int = 0;\n1200\t    while i < count {\n1201\t        let a = i;\n1202\t        let b = if i + 1 < count { i + 1 } else { 0 };\n1203\t        let e = c2Sub(*verts.offset(b as isize), *verts.offset(a as isize));\n1204\t        *norms.offset(i as isize) = c2Norm(c2CCW90(e));\n1205\t        i += 1;\n1206\t    }\n1207\t}\n1208\t\n1209\t/// Mirrors gcc's stack frame for `c2AABBtoCapsuleManifold`, where the spilled\n1210\t/// `A` parameter sits immediately below the `c2Poly` local (`A` at `-0xb0(%rbp)`,\n1211\t/// `p` at `-0xa0(%rbp)`).  That matters because a degenerate A