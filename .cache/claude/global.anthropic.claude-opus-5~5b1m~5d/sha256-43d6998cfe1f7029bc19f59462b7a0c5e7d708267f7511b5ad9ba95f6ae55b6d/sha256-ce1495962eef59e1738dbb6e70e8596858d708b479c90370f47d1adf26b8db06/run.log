histogram|best|test result\""}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":696,"cache_read_input_tokens":202657,"cache_creation":{"ephemeral_5m_input_tokens":696,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"4bcc327f-132f-463a-99a7-0691637f7d66","uuid":"73f8f3e6-b7be-4d16-a597-be7a9b33d38b","timestamp":"2026-08-27T12:58:49.762Z"}
