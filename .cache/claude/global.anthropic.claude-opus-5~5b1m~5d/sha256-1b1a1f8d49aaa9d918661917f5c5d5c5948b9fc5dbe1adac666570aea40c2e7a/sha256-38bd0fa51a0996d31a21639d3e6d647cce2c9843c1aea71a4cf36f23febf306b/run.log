 **argv) {\n  if (argc < 3) {\n    fprintf(stderr, \"usage: %s <lib.so> <suite>\\n\", argv[0]);\n    return 2;\n  }\n  void *h = dlopen(argv[1], RTLD_NOW | RTLD_LOCAL);\n  if (!h) {\n    fprintf(stderr, \"dlopen: %s\\n\", dlerror());\n    return 2;\n  }\n#define SYM(v, n)                                                              \\\n  do {                                                                         \\\n    v = dlsym(h, n);                                                           \\\n    if (!v) {                                                                  \\\n      fprintf(stderr, \"missing symbol %s\\n\", n);                               \\\n      return 2;                                                                \\\n    }                                                                          \\\n  } while (0)\n  cp_inflate = (inflate_fn)dlsym(h, \"cp_inflate\");\n  convert_pix = (convert_fn)dlsym(h, \"convert_pix\");\n  SYM(p_error_reason, \"cp_error_reason\");\n  SYM(p_fixed_table, \"cp_fixed_table\");\n  SYM(p_permutation_order, \"cp_permutation_order\");\n  SYM(p_len_extra_bits, \"cp_len_extra_bits\");\n  SYM(p_len_base, \"cp_len_base\");\n  SYM(p_dist_extra_bits, \"cp_dist_extra_bits\");\n  SYM(p_dist_base, \"cp_dist_base\");\n  if (!cp_inflate || !convert_pix) {\n    fprintf(stderr, \"missing function symbol\\n\");\n    return 2;\n  }\n\n  const char *suite = argv[2];\n  if (!strcmp(suite, \"tables\"))\n    dump_tables();\n  else if (!strcmp(suite, \"inflate\"))\n    inflate_suite();\n  else if (!strcmp(suite, \"convert\"))\n    convert_suite();\n  else if (!strcmp(suite, \"errors\"))\n    error_suite();\n  else {\n    fprintf(stderr, \"unknown suite\\n\");\n    return 2;\n  }\n  fflush(stdout);\n  return 0;\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
