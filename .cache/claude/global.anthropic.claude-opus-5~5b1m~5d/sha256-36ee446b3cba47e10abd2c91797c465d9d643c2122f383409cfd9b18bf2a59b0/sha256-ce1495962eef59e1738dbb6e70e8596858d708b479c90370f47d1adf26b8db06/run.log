b.c 35,41,47,49,52,55 */\n        int s5 = d0 >> 5;                                   /* lib.c 50,53,56 */\n        int ng = -d0;                                       /* lib.c 32,38,44 */\n        int v=d0; v &= ~1; v |= (v >> 1) & (v >> 2) & 1;    /* lib.c 14,17 */\n        int w=d0; w |= 1;                                   /* lib.c 21 */\n        int z=d0; z &= ~1;                                  /* lib.c 25 */\n        int m7 = d0 & 7; int m8 = (d0 & 8) ? 1 : 0;         /* lib.c 30,31 */\n        int u1 = d0+1; int u2 = d0-1;                       /* lib.c 6,7 */\n        int t1 = ((d0 ^ u1) & (~7)) ? 1 : 0;                /* lib.c 8  */\n        int t2 = ((d0 ^ u2) & (~7)) ? 1 : 0;                /* lib.c 10 */\n        int arr[12]={a,s5,ng,v,w,z,m7,m8,u1,u2,t1,t2};\n        for(int i=0;i<12;i++) h=mix(h,arr[i]);\n        if(u==0xFFFFFFFFu) break; u++; }\n    return h;\n}\nextern uint64_t r_misc_batch(uint32_t);\nint main(void){\n    uint64_t a=c_misc_batch(); printf(\"C    = %016llx\\n\",(unsigned long long)a); fflush(stdout);\n    uint64_t b=r_misc_batch(0); printf(\"RUST = %016llx\\n\",(unsigned long long)b); fflush(stdout);\n    printf(\"12 sub-exprs exhaustive over ALL 2^32 inputs: %s\\n\", a==b?\"MATCH\":\"*** DIFFER ***\"); fflush(stdout);\n    uint64_t c=r_misc_batch(777777u);\n    printf(\"CANARY (1 injected off-by-one): RUST=%016llx -> %s\\n\",(unsigned long long)c, (a!=c)?\"detected (hash sound)\":\"NOT DETECTED\");\n    return (a!=b)||(a==c);\n}\nCC\nrustc --edition 2024 --crate-type staticlib -O -o libp.a p.rs\ngcc -O2 -fwrapv -o p p.c libp.a\ntime ./p","is_backgrounded":false,"task_type":"local_bash","uuid":"3572ba48-3f9a-478e-bbae-53a96c6288e4","session_id":"6a91fdee-45d7-4693-8d7e-88ac17e9e078"}
