t sum=0; uint32_t x=0; uint32_t u=0;\n    for(;;){\n        int d=(int)u;\n        int v = -d;                                  /* lines 32/38/44 */\n        sum += (int64_t)v;\n        uint32_t vv=(uint32_t)v; uint32_t r=u&31; x ^= (r? ((vv<<r)|(vv>>(32-r))) : vv);\n        if(u==0xFFFFFFFFu) break; u++;\n    }\n    *osum=sum; *oxor=x;\n}\nstatic void c_notmask_batch(int64_t *osum, uint32_t *oxor){\n    int64_t sum=0; uint32_t x=0; uint32_t u=0;\n    for(;;){\n        int uni=(int)u; int uni1=uni+1; int uni2=uni-1;\n        int a = ((uni ^ uni1) & (~7)) ? 1 : 0;      /* line 8  */\n        int b = ((uni ^ uni2) & (~7)) ? 1 : 0;      /* line 10 */\n        int v = a | (b<<1);\n        sum += (int64_t)v;\n        uint32_t vv=(uint32_t)v; uint32_t r=u&31; x ^= (r? ((vv<<r)|(vv>>(32-r))) : vv);\n        if(u==0xFFFFFFFFu) break; u++;\n    }\n    *osum=sum; *oxor=x;\n}\n\nextern void r_diff_batch(int uni, int64_t*, uint32_t*);\nextern void r_abs_batch(int64_t*, uint32_t*);\nextern void r_shr5_batch(int64_t*, uint32_t*);\nextern void r_lsb4_batch(int64_t*, uint32_t*);\nextern void r_neg_batch(int64_t*, uint32_t*);\nextern void r_notmask_batch(int64_t*, uint32_t*);\nextern void r_consts(int*);\nextern int  r_diff(int uni, int step);\n\nstatic int fails=0;\nstatic void cmp(const char*name, int64_t s1, uint32_t x1, int64_t s2, uint32_t x2){\n    int ok = (s1==s2)&&(x1==x2);\n    if(!ok) fails++;\n    printf(\"%-42s C(sum=%lld,xor=%08x)  RUST(sum=%lld,xor=%08x)  %s\\n\",\n        name,(long long)s1,x1,(long long)s2,x2, ok?\"MATCH\":\"*** DIFFER ***\");\n}\n\nint main(void){\n    int64_t s1,s2; uint32_t x1,x2;\n    int cs[4]; r_consts(cs);\n    printf(\"Rust !7 = %d   C ~7 = %d   %s\\n\", cs[0], ~7, (cs[0]==~7)?\"MATCH\":\"*** DIFFER ***\");\n    printf(\"Rust !1 = %d   C ~1 = %d   %s\\n\", cs[1], ~1, (cs[1]==~1)?\"MATCH\":\"*** DIFFER ***\");\n    printf(\"sizeof(c_int) rust = %d  sizeof(int) C = %zu  i32==c_int: %d\\n\", cs[2], sizeof(int), cs[3]);\n    if(cs[0]!=~7||cs[1]!