{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_019cWTVQFEatqjW5SQVUQSuD","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/`.\n2\t//!\n3\t//! Public ABI surface (matches `nm -D` on the C shared object):\n4\t//!   * `encode_quant`\n5\t//!\n6\t//! Semantics are reproduced exactly, including the original code's quirks (for\n7\t//! example both candidate distortions `d1`/`d2` are compared against the\n8\t//! *original* `d0` rather than against a running best). All arithmetic uses\n9\t//! wrapping operations so that the two's-complement behaviour emitted by the C\n10\t//! compiler is preserved rather than panicking in debug builds.\n11\t\n12\tuse std::ffi::c_int;\n13\t\n14\t/// Translation of `int encode_quant(int uni, int step, int pred, int tgt, int tgt2, int lsbit)`\n15\t/// from `c_src/src/lib.c`.\n16\t#[unsafe(no_mangle)]\n17\tpub extern \"C\" fn encode_quant(\n18\t    uni: c_int,\n19\t    step: c_int,\n20\t    pred: c_int,\n21\t    tgt: c_int,\n22\t    tgt2: c_int,\n23\t    lsbit: c_int,\n24\t) -> c_int {\n25\t    let mut uni: i32 = uni;\n26\t    let step: i32 = step;\n27\t    let pred: i32 = pred;\n28\t    let tgt: i32 = tgt;\n29\t    let tgt2: i32 = tgt2;\n30\t    let lsbit: i32 = lsbit;\n31\t\n32\t    let mut uni1: i32;\n33\t    let mut uni2: i32;\n34\t    let mut diff: i32;\n35\t    let p0: i32;\n36\t    let p1: i32;\n37\t    let p2: i32;\n38\t    let mut d0: i32;\n39\t    let mut d1: i32;\n40\t    let mut d2: i32;\n41\t    let mut d3: i32;\n42\t\n43\t    // uni1 = uni + 1; uni2 = uni - 1;\n44\t    uni1 = uni.wrapping_add(1);\n45\t    uni2 = uni.wrapping_sub(1);\n46\t\n47\t    // Reject candidates that cross a 3-bit magnitude boundary.\n48\t    if ((uni ^ uni1) & !7) != 0 {\n49\t        uni1 = uni;\n50\t    }\n51\t    if ((uni ^ uni2) & !7) != 0 {\n52\t        uni2 = uni;\n53\t    }\n54\t\n55\t    // Least-significant-bit conditioning.\n56\t    if lsbit != 0 {\n57\t        if lsbit == 4 {\n58\t            uni &= !1;\n59\t            uni1 &= !1;\n60\t            uni2 &= !1;\n61\t            uni |= (uni >> 1) & (uni >> 2) & 1;\n62\t            uni1 |= (uni1 >> 1) & (uni1 >> 2) & 1;\n63\t            uni2 |= (uni2 >> 1) & (uni2 >> 2) & 1;\n64\t        } else if (lsbit & 1) != 0 {\n65\t            uni |= 1;\n66\t            uni1 |= 1;\n67\t            uni2 |= 1;\n68\t        } else {\n69\t            uni &= !1;\n70\t            uni1 &= !1;\n71\t            uni2 &= !1;\n72\t        }\n73\t    }\n74\t\n75\t    // Candidate 0: uni\n76\t    diff = (2i32\n77\t        .wrapping_mul(uni & 7)\n78\t        .wrapping_add(1)\n79\t        .wrapping_mul(step))\n80\t        / 8;\n81\t    if (uni & 8) != 0 {\n82\t        diff = diff.wrapping_neg();\n83\t    }\n84\t    p0 = pred.wrapping_add(diff);\n85\t    d0 = tgt.wrapping_sub(p0);\n86\t    d0 ^= d0 >> 31;\n87\t\n88\t    // Candidate 1: uni1\n89\t    diff = (2i32\n90\t        .wrapping_mul(uni1 & 7)\n91\t        .wrapping_add(1)\n92\t        .wrapping_mul(step))\n93\t        / 8;\n94\t    if (uni1 & 8) != 0 {\n95\t        diff = diff.wrapping_neg();\n96\t    }\n97\t    p1 = pred.wrapping_add(diff);\n98\t    d1 = tgt.wrapping_sub(p1);\n99\t    d1 ^= d1 >> 31;\n100\t\n101\t    // Candidate 2: uni2\n102\t    diff = (2i32\n103\t        .wrapping_mul(uni2 & 7)\n104\t        .wrapping_add(1)\n105\t        .wrapping_mul(step))\n106\t        / 8;\n107\t    if (uni2 & 8) != 0 {\n108\t        diff = diff.wrapping_neg();\n109\t    }\n110\t    p2 = pred.wrapping_add(diff);\n111\t    d2 = tgt.wrapping_sub(p2);\n112\t    d2 ^= d2 >> 31;\n113\t\n114\t    // Secondary target contributes a 1/32-weighted penalty.\n115\t    d3 = tgt2.wrapping_sub(p0);\n116\t    d3 ^= d3 >> 31;\n117\t    d0 = d0.wrapping_add(d3 >> 5);\n118\t\n119\t    d3 = tgt2.wrapping_sub(p1);\n120\t    d3 ^= d3 >> 31;\n121\t    d1 = d1.wrapping_add(d3 >> 5);\n122\t\n123\t    d3 = tgt2.wrapping_sub(p2);\n124\t    d3 ^= d3 >> 31;\n125\t    d2 = d2.wrapping_add(d3 >> 5);\n126\t\n1