(h,w);\n        h=mix(h,z); h=mix(h,m7); h=mix(h,m8); h=mix(h,u1); h=mix(h,u2);\n        h=mix(h,t1); h=mix(h,t2);\n        if(u==0xFFFFFFFFu) break; u++; }\n    return h;\n}\nextern uint64_t r_diff_batch(int);\nextern uint64_t r_misc_batch(void);\nextern void r_consts(int*);\nint main(void){\n    int fails=0; int cs[12]; r_consts(cs);\n    struct { const char*n; int r; int c; } K[] = {\n      {\"~7 / !7\",            cs[0],  ~7},\n      {\"~1 / !1\",            cs[1],  ~1},\n      {\"sizeof int\",         cs[2],  (int)sizeof(int)},\n      {\"-INT_MIN\",           cs[3],  -(int)INT_MIN},\n      {\"INT_MIN/8\",          cs[4],  INT_MIN/8},\n      {\"-1/8\",               cs[5],  -1/8},\n      {\"-7/8\",               cs[6],  -7/8},\n      {\"-9/8\",               cs[7],  -9/8},\n      {\"-8/8\",               cs[8],  -8/8},\n      {\"-1>>31\",             cs[9],  -1>>31},\n      {\"-1>>5\",              cs[10], -1>>5},\n      {\"INT_MIN>>5\",         cs[11], INT_MIN>>5},\n    };\n    for(unsigned i=0;i<sizeof(K)/sizeof(K[0]);i++){\n        int ok = K[i].r==K[i].c; if(!ok) fails++;\n        printf(\"%-14s  RUST=%-12d C=%-12d %s\\n\", K[i].n, K[i].r, K[i].c, ok?\"MATCH\":\"*** DIFFER ***\");\n    }\n    fflush(stdout);\n    for(int m=0;m<8;m++){\n        uint64_t a=c_diff_batch(m), b=r_diff_batch(m);\n        int ok=(a==b); if(!ok) fails++;\n        printf(\"diff expr exhaustive over ALL 2^32 step, uni&7=%d: C=%016llx RUST=%016llx %s\\n\",\n               m,(unsigned long long)a,(unsigned long long)b, ok?\"MATCH\":\"*** DIFFER ***\");\n        fflush(stdout);\n    }\n    { uint64_t a=c_misc_batch(), b=r_misc_batch();\n      int ok=(a==b); if(!ok) fails++;\n      printf(\"12 sub-exprs exhaustive over ALL 2^32 inputs: C=%016llx RUST=%016llx %s\\n\",\n             (unsigned long long)a,(unsigned long long)b, ok?\"MATCH\":\"*** DIFFER ***\");\n      fflush(stdout); }\n    printf(\"\\nSUBEXPR FAILURES: %d\\n\", fails);\n    return fails?1:0;\n}\nCC\n\nrustc --edition 2024 --crate-type staticlib -O -o libprobe.a probe.rs\n# -fwrapv models the two's-complement behaviour the unoptimised reference build exhibits\ngcc -O2 -fwrapv -o probe probe.c libprobe.a\nnohup ./probe > probe.log 2>&1 &\necho \"launched pid $!\"\nsleep 100; cat probe.log","is_backgrounded":false,"task_type":"local_bash","uuid":"82c8948b-4a81-4a38-9665-07df89d806b5","session_id":"6a91fdee-45d7-4693-8d7e-88ac17e9e078"}
