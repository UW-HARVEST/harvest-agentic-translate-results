"-        unsafe { malloc((array_size as usize).wrapping_mul(size_of::<c_int>())) } as *mut c_int;","+        unsafe { c_malloc((array_size as usize).wrapping_mul(size_of::<c_int>())) } as *mut c_int;"," ","     if data_array.is_null() {","         return -1;"]}],"userModified":false,"replaceAll":false}}
