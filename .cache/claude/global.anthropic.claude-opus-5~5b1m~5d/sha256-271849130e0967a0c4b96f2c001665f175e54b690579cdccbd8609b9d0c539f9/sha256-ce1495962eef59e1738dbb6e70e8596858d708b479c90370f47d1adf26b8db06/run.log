% 5)/switch_fallthrough_calculator(param2, param3 % 4)/'\n\nmutate data_array_init_off_by_one \\\n  's/data_array\\[i\\] = (i + 1) \\* OCTAL_BASE + param1;/data_array[i] = (i + 2) * OCTAL_BASE + param1;/'\n\nmutate array_size_5_to_4 \\\n  's/int array_size = 5;/int array_size = 4;/'\n\nmutate foreach_skips_first \\\n  's/idx = 0, \\\\/idx = 1, \\\\/'\n\nmutate multiplier_1_5_to_1_6 \\\n  's/param4 % 10 + 1, 1\\.5/param4 % 10 + 1, 1.6/'\n\necho\necho \"==============================================================\"\necho \"RESULT: $pass mutant(s)+control handled correctly, $fail MISSED\"\necho \"==============================================================\"\n[ \"$fail\" -eq 0 ]\n","structuredPatch":[{"oldStart":190,"oldLines":6,"newStart":190,"newLines":6,"lines":[" "," echo"," echo \"==============================================================\"","-echo \"RESULT: $pass mutant(s)+control handled correctly, $fail MISSED\"","+echo \"RESULT: $pass caught (incl. control), $equiv proven-equivalent, $fail MISSED\""," echo \"==============================================================\""," [ \"$fail\" -eq 0 ]"]}],"userModified":false,"replaceAll":false}}
