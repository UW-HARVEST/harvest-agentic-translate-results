t\" | grep -E '^\\s{4}\\w+$' | tr -d ' ' | sort -u | head -6 | tr '\\n' ' ')\"","-    if [ \"$failed\" -gt 0 ]; then","-        echo \"-- [$n] DETECTED  $desc   (first failures: $names)\"","+    if printf '%s' \"$out\" | grep -qE '^test result: FAILED'; then","+        names=\"$(printf '%s' \"$out\" | grep -E '^    [a-z0-9_]+$' | tr -d ' ' | sort -u | head -4 | tr '\\n' ' ')\"","+        echo \"-- [$n] DETECTED  $desc   (e.g. $names)\"","     else","         echo \"!! [$n] SURVIVED  $desc   <-- BLIND SPOT\"","         survivors=$((survivors+1))"]},{"oldStart":77,"oldLines":5,"newStart":86,"newLines":5,"lines":[" cargo build --offline --release >/dev/null 2>&1"," echo"," echo \"mutations: $n, survivors: $survivors\"","-[ \"$survivors\" -eq 0 ] && echo \"MUTATION CHECK: OK\" || echo \"MUTATION CHECK: BLIND SPOTS FOUND\"","+if [ \"$survivors\" -eq 0 ]; then echo \"MUTATION CHECK: OK\"; else echo \"MUTATION CHECK: BLIND SPOTS FOUND\"; fi"," exit \"$survivors\""]}],"originalFile":"#!/usr/bin/env bash\n# Validate that the differential suite actually DETECTS divergence: inject a\n# series of small bugs into src/lib.rs, one at a time, and confirm the tests\n# fail. Any mutation that survives means the suite has a blind spot.\n#\n# Restores src/lib.rs unconditionally on exit.\nset -uo pipefail\nhere=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\ncd \"$here\" || exit 2\n\norig=\"$here/target/lib.rs.orig\"\ncp src/lib.rs \"$orig\"\nrestore() { cp \"$orig\" src/lib.rs; }\ntrap restore EXIT\n\nmutations=(\n  # description|from|to\n  \"valid_2 lower bound 0xC2 -> 0xC1|(0xC2u8 as i8)|(0xC1u8 as i8)\"\n  \"REPLACEMENT_INC 4096 -> 2048|const REPLACEMENT_INC: usize = 4096;|const REPLACEMENT_INC: usize = 2048;\"\n  \"valid_3 E0 guard >= 0xA0 -> > 0xA0|(b0 != 0xE0 || b1 >= 0xA0)|(b0 != 0xE0 || b1 > 0xA0)\"\n  \"valid_3 ED guard < 0xA0 -> <= 0xA0|(b0 != 0xED || b1 < 0xA0)|(b0 != 0xED || b1 <= 0xA0)\"\n  \"valid_3 EF guard <= 0xBF -> < 0xBF|(b0 != 0xEF || b1 <= 0xBF)|(b0 != 0xEF || b1 < 0xBF)\"\n  \"valid_4 upper bound 0xF4 -> 0xF5|b0 > 0xF4|b0 > 0xF5\"\n  \"valid_4 lead mask 0xF8 -> 0xF0|(b0 \\& 0xF8) != 0xF0|(b0 \\& 0xF0) != 0xF0\"\n  \"valid_4 F0 guard >= 0x90 -> > 0x90|(b0 != 0xF0 || b1 >= 0x90)|(b0 != 0xF0 || b1 > 0x90)\"\n  \"valid_4 F4 guard <= 0x8F -> < 0x8F|(b0 != 0xF4 || b1 <= 0x8F)|(b0 != 0xF4 || b1 < 0x8F)\"\n  \"repl < 3 -> repl < 4|if repl < 3 {|if repl < 4 {\"\n  \"U+FFFD third byte 0xBD -> 0xBC|0xBDu8 as c_char|0xBCu8 as c_char\"\n  \"drop advances 2 -> 1 for valid_2|string = string.add(2);|string = string.add(1);\"\n  \"bool test != 0 -> \\& 1 != 0|let replacement = replacement != 0;|let replacement = replacement \\& 1 != 0;\"\n  \"assert line 40 -> 41|assert_fail_string_not_null(40,|assert_fail_string_not_null(41,\"\n  \"assert message text|c\\\"string != NULL\\\"|c\\\"string == NULL\\\"\"\n  \"skip the strdup fast path|if *valid == 0 {|if false \\&\\& *valid == 0 {\"\n  \"valid_1 mask 0x80 -> 0xC0|at(x, 0) \\& 0x80 == 0|at(x, 0) \\& 0xC0 == 0\"\n  \"valid_2 lead mask 0xE0 -> 0xF0|(b0 \\& 0xE0) == 0xC0|(b0 \\& 0xF0) == 0xC0\"\n  \"valid_3 lead mask 0xF0 -> 0xE0|(b0 \\& 0xF0) != 0xE0|(b0 \\& 0xE0) != 0xE0\"\n  \"filter copies 3 bytes instead of 4|for _ in 0..4 {|for _ in 0..3 {\"\n)\n\nsurvivors=0\nn=0\nfor m in \"${mutations[@]}\"; do\n    desc=\"${m%%|*}\"; rest=\"${m#*|}\"; from=\"${rest%%|*}\"; to=\"${rest##*|}\"\n    n=$((n+1))\n    restore\n    if ! grep -qF -- \"$(printf '%b' \"${from//\\\\/}\")\" src/lib.rs; then\n        echo \"!! [$n] PATTERN NOT FOUND for '$desc' -- fix the script\"\n        survivors=$((survivors+1)); continue\n    fi\n    python3 - \"$from\" \"$to\" <<'PY'\nimport sys\nfrm = sys.argv[1].replace('\\\\&','&')\nto  = sys.argv[2].replace('\\\\&','&')\np='src/lib.rs'\ns=open(p).read()\nassert frm in s, frm\ns=s.replace(frm,to,1)\nopen(p,'w').write(s)\nPY\n    if ! cargo build --offline           >/dev/null 2>&1 || \\\n       ! cargo build --offline --release >/dev/null 2>&1; then\n        echo \"-- [$n] $desc: does not compile (counts as detected)\"\n        continue\n    fi\n    out=\"$(cargo test --offline 2>&1)\"\n    failed=\"$(printf '%s' \"$out\" | grep -cE '^test .* FAILED$|^test result: FAILED')\"\n    names=\"$(printf '%s' \"$out\" | grep -E '^\\s{4}\\w+$' | tr -d ' ' | sort -u | head -6 | tr '\\n' ' ')\"\n    if [ \"$failed\" -gt 0 ]; then\n        echo \"-- [$n] DETECTED  $desc   (first failures: $names)\"\n    else\n        echo \"!! [$n] SURVIVED  $desc   <-- BLIND SPOT\"\n        survivors=$((survivors+1))\n    fi\ndone\nrestore\ncargo build --offline >/dev/null 2>&1\ncargo build --offline --release >/dev/null 2>&1\necho\necho \"mutations: $n, survivors: $survivors\"\n[ \"$survivors\" -eq 0 ] && echo \"MUTATION CHECK: OK\" || echo \"MUTATION CHECK: BLIND SPOTS FOUND\"\nexit \"$survivors\"\n","userModified":false}}
