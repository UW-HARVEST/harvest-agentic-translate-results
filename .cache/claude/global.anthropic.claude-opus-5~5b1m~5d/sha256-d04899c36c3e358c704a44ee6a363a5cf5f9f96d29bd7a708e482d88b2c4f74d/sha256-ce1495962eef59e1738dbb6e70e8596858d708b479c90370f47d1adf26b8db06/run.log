F, 0x1000, 0xD7FF, 0xE000, 0xFFFD, 0xFFFF,\n    0x1_0000, 0x3_FFFF, 0x4_0000, 0xF_FFFF, 0x10_0000, 0x10_FFFF,\n];\n","structuredPatch":[{"oldStart":7,"oldLines":6,"newStart":7,"newLines":8,"lines":[" "," #![allow(dead_code)]"," ","+pub mod child;","+"," use libloading::{Library, Symbol};"," use std::ffi::c_void;"," use std::os::raw::c_char;"]}],"userModified":false,"replaceAll":false}}
