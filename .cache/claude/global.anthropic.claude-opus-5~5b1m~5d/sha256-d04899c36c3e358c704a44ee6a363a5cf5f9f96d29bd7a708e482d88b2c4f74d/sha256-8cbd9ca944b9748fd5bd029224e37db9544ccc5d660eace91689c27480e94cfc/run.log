= s ? strtol(s, NULL, 10) : 0;\n}\n\nvoid failalloc_arm(void) {\n    init();\n    seen = 0;\n    armed = 1;\n}\n\nvoid failalloc_disarm(void) { armed = 0; }\n\n/* Should this matching call fail? */\nstatic int should_fail(int mode_on) {\n    if (!armed || !mode_on) return 0;\n    if (seen++ < skip) return 0;\n    return 1;\n}\n\nvoid *malloc(size_t n) {\n    init();\n    if (should_fail(mode_malloc)) {\n        errno = ENOMEM;\n        return NULL;\n    }\n    return real_malloc(n);\n}\n\nvoid *realloc(void *p, size_t n) {\n    init();\n    if (should_fail(mode_realloc)) {\n        errno = ENOMEM;\n        return NULL;\n    }\n    return real_realloc(p, n);\n}\n\nchar *strdup(const char *s) {\n    init();\n    if (should_fail(mode_strdup)) {\n        errno = ENOMEM;\n        return NULL;\n    }\n    return real_strdup(s);\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1131,"cache_read_input_tokens":64920,"cache_creation":{"ephemeral_5m_input_tokens":1131,"ephemeral_1h_input_tokens":0},"output_tokens":6,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"60867e95-2696-4f33-80d9-2f09daa96601","uuid":"24fad798-d21f-4cc1-a528-4767e36d75c8","timestamp":"2026-09-05T12:45:40.409Z"}
