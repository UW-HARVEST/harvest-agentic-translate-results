r = src[0]; float g = src[1]; float b = src[2];\n    // All three loads happen up front, exactly as in the C, so an aliasing\n    // `dest == src` call behaves identically.\n    let r: c_float = unsafe { *src.add(0) };\n    let g: c_float = unsafe { *src.add(1) };\n    let b: c_float = unsafe { *src.add(2) };\n\n    let mut h: c_float = 0.0;\n    let mut s: c_float = 0.0;\n    let v: c_float;\n\n    // float min = r; float max = r;\n    let mut min: c_float = r;\n    let mut max: c_float = r;\n    let delta: c_float;\n\n    min = c_min(min, g);\n    min = c_min(min, b);\n    max = c_max(max, g);\n    max = c_max(max, b);\n\n    delta = max - min;\n    v = max;\n\n    if delta == 0.0 || max == 0.0 {\n        unsafe {\n            *dest.add(0) = h;\n            *dest.add(1) = s;\n            *dest.add(2) = v;\n        }\n        return;\n    }\n\n    s = delta / max;\n\n    if r == max {\n        h = (g - b) / delta;\n    } else if g == max {\n        h = 2.0 + (b - r) / delta;\n    } else {\n        h = 4.0 + (r - g) / delta;\n    }\n\n    h *= 60.0;\n\n    if h < 0.0 {\n        h += 360.0;\n    }\n\n    unsafe {\n        *dest.add(0) = h;\n        *dest.add(1) = s;\n        *dest.add(2) = v;\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":500,"cache_read_input_tokens":16940,"cache_creation":{"ephemeral_5m_input_tokens":500,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"0b0411d5-1128-467c-a21b-65c39fe9b2fa","uuid":"062e5fb0-813e-4b21-acd7-69142570ef14","timestamp":"2026-08-27T01:01:32.442Z"}
