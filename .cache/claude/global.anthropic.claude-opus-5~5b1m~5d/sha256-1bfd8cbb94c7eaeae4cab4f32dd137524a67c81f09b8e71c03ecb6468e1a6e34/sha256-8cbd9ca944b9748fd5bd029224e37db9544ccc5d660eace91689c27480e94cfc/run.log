{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_014u3hddT2Ze5ESktQSFcGx2","type":"tool_result","content":"1\t//! Shared harness: loads BOTH the C libzstd.so and the Rust libzstd.so via\n2\t//! libloading and exposes helpers to call the same symbol in both and compare.\n3\t#![allow(dead_code, non_snake_case, non_camel_case_types)]\n4\t\n5\tuse libloading::{Library, Symbol};\n6\tuse std::path::PathBuf;\n7\tuse std::sync::OnceLock;\n8\t\n9\tstatic C_LIB: OnceLock<Library> = OnceLock::new();\n10\tstatic R_LIB: OnceLock<Library> = OnceLock::new();\n11\t\n12\tfn manifest() -> PathBuf {\n13\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n14\t}\n15\t\n16\tpub fn c_so_path() -> PathBuf {\n17\t    manifest().parent().unwrap().join(\"c_src/build/libzstd.so\")\n18\t}\n19\t\n20\tpub fn r_so_path() -> PathBuf {\n21\t    let rel = manifest().join(\"target/release/libzstd.so\");\n22\t    if rel.exists() {\n23\t        return rel;\n24\t    }\n25\t    manifest().join(\"target/debug/libzstd.so\")\n26\t}\n27\t\n28\tpub fn clib() -> &'static Library {\n29\t    C_LIB.get_or_init(|| {\n30\t        let p = c_so_path();\n31\t        assert!(p.exists(), \"C shared library not built: {:?}\", p);\n32\t        unsafe { Library::new(&p).expect(\"load C .so\") }\n33\t    })\n34\t}\n35\t\n36\tpub fn rlib() -> &'static Library {\n37\t    R_LIB.get_or_init(|| {\n38\t        let p = r_so_path();\n39\t        assert!(p.exists(), \"Rust shared library not built: {:?}\", p);\n40\t        unsafe { Library::new(&p).expect(\"load Rust .so\") }\n41\t    })\n42\t}\n43\t\n44\t/// Fetch the same symbol from both libraries.\n45\tpub unsafe fn pair<T>(name: &str) -> (Symbol<'static, T>, Symbol<'static, T>) {\n46\t    let n = name.as_bytes();\n47\t    let c: Symbol<'static, T> = clib()\n48\t        .get(n)\n49\t        .unwrap_or_else(|e| panic!(\"C .so missing symbol {name}: {e}\"));\n50\t    let r: Symbol<'static, T> = rlib()\n51\t        .get(n)\n52\t        .unwrap_or_else(|e| panic!(\"Rust .so missing symbol {name}: {e}\"));\n53\t    (c, r)\n54\t}\n55\t\n56\t/// Declare `let (c_f, r_f) = sym!(\"NAME\", fn_type);`\n57\t#[macro_export]\n58\tmacro_rules! sym {\n59\t    ($name:expr, $t:ty) => {{ unsafe { $crate::common::pair::<$t>($name) } }};\n60\t}\n61\t\n62\t// ---------------------------------------------------------------- PRNG -----\n63\t\n64\t/// Deterministic xoshiro-ish PRNG (fixed seed => reproducible runs).\n65\tpub struct Rng(u64);\n66\t\n67\timpl Rng {\n68\t    pub fn new(seed: u64) -> Rng {\n69\t        Rng(seed ^ 0x9E3779B97F4A7C15)\n70\t    }\n71\t    pub fn next_u64(&mut self) -> u64 {\n72\t        // splitmix64\n73\t        self.0 = self.0.wrapping_add(0x9E3779B97F4A7C15);\n74\t        let mut z = self.0;\n75\t        z = (z ^ (z >> 30)).wrapping_mul(0xBF58476D1CE4E5B9);\n76\t        z = (z ^ (z >> 27)).wrapping_mul(0x94D049BB133111EB);\n77\t        z ^ (z >> 31)\n78\t    }\n79\t    pub fn next_u32(&mut self) -> u32 {\n80\t        (self.next_u64() >> 32) as u32\n81\t    }\n82\t    pub fn below(&mut self, n: usize) -> usize {\n83\t        if n == 0 { 0 } else { (self.next_u64() % n as u64) as usize }\n84\t    }\n85\t    pub fn range(&mut self, lo: usize, hi: usize) -> usize {\n86\t        // inclusive lo, exclusive hi\n87\t        if hi <= lo { lo } else { lo + self.below(hi - lo) }\n88\t    }\n89\t    pub fn byte(&mut self) -> u8 {\n90\t        (self.next_u64() >> 24) as u8\n91\t    }\n92\t}\n93\t\n94\t// ------------------------------------------------------------ generators ---\n95\t\n96\t#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n97\tpub enum Shape {\n98\t    /// pure random bytes: incompressible\n99\t    Random,\n100\t    /// single repeated byte: RLE-able\n101\t    Rle,\n102\t    /// highly repetitive short-period pattern\n103\t    Repetitive,\n104\t    /// text-like: small alphabet, word structure\n105\t    Text,\n106\t    /// long matches far apart (exercises long-distance matching)\n107\t    LongMatches,\n108\t    /// mixed compressible / incompressible sections\n109\t    Mixed,\n110\t    /// mostly zeroes with sparse noise\n111\t    Sparse,\n112\t}\n113\t\n114\tpub const ALL_SHAPES: &[Shape] = &[\n115\t    Shape::Random,\n116\t    Shape::Rle,\n117\t    Shape::Repetitive,\n118\t    Shape::Text,\n119\t    Shape::LongMatches,\n120\t    Shape::Mixed,\n121\t    Shape::Sparse,\n122\t];\n123\t\n124\tpub fn gen(shape: Shape, len: usize, rng: &mut Rng) -> Vec<u8> {\n125\t    let mut v = Vec::with_capacity(len);\n126\t    match shape {\n127\t        Shape::Random => {\n128\t            while v.len() < len {\n129\t                v.extend_from_slice(&rng.next_u64().to_le_bytes());\n130\t            }\n131\t            v.truncate(len);\n132\t        }\n133\t        Shape::Rle => {\n134\t            let b = rng.byte();\n135\t            v.resize(len, b);\n136\t        }\n137\t        Shape::Repetitive => {\n138\t            let period = rng.range(1, 40);\n139\t            let mut pat = Vec::with_capacity(period);\n140\t            for _ in 0..period {\n141\t                pat.push(rng.byte());\n142\t            }\n143\t            while v.len() < len {\n144\t                v.extend_from_slice(&pat);\n145\t            }\n146\t            v.truncate(len);\n147\t        }\n148\t        Shape::Text => {\n149\t            const WORDS: &[&str] = &[\n150\t                \"the \", \"quick \", \"brown \", \"fox \", \"jumps \", \"over \", \"lazy \", \"dog \", \"zstd \",\n151\t                \"compression \", \"ratio \", \"and \", \"speed \", \"\\n\",\n152\t            ];\n153\t            while v.len() < len {\n154\t                v.extend_from_slice(WORDS[rng.below(WORDS.len())].as_bytes());\n155\t            }\n156\t            v.truncate(len);\n157\t        }\n158\t        Shape::LongMatches => {\n159\t            let chunk = 4096.min(len.max(1));\n160\t            let mut base = Vec::with_capacity(chunk);\n161\t            for _ in 0..chunk {\n162\t                base.push(rng.byte());\n163\t            }\n164\t            while v.len() < len {\n165\t                v.extend_from_slice(&base);\n166\t                // insert some noise so it's not a pure repeat\n167\t                for _ in 0..rng.below(16) {\n168\t                    v.push(rng.byte());\n169\t                }\n170\t            }\n171\t            v.truncate(len);\n172\t        }\n173\t        Shape::Mixed => {\n174\t            while v.len() < len {\n175\t                if rng.next_u32() & 1 == 0 {\n176\t                    let n = rng.range(1, 512);\n177\t                    for _ in 0..n {\n178\t                        v.push(rng.byte());\n179\t                    }\n180\t                } else {\n181\t                    let n = rng.range(1, 512);\n182\t                    let b = rng.byte();\n183\t                    for _ in 0..n {\n184\t                        v.push(b);\n185\t                    }\n186\t                }\n187\t            }\n188\t            v.truncate(len);\n189\t        }\n190\t        Shape::Sparse => {\n191\t            v.resize(len, 0);\n192\t            let n = len / 64 + 1;\n193\t            for _ in 0..n {\n194\t                let i = rng.below(len.max(1));\n195\t                if i < v.len() {\n196\t                    v[i] = rng.byte();\n197\t                }\n198\t            }\n199\t        }\n200\t    }\n201\t    v\n202\t}\n203\t\n204\t// --------------------------------------------------------------- utils -----\n205\t\n206\tpub fn hexdump(b: &[u8], max: usize) -> String {\n207\t    let n = b.len().min(max);\n208\t    let mut s = String::new();\n209\t    for x in &b[..n] {\n210\t        s.push_str(&format!(\"{:02x}\", x));\n211\t    }\n212\t    if b.len() > n {\n213\t        s.push_str(\"...\");\n214\t    }\n215\t    s\n216\t}\n217\t\n218\t/// Panic with a helpful diff if two byte buffers differ.\n219\tpub fn assert_bytes_eq(ctx: &str, c: &[u8], r: &[u8]) {\n220\t    if c == r {\n221\t        return;\n222\t    }\n223\t    let first = c\n224\t        .iter()\n225\t        .zip(r.iter())\n226\t        .position(|(a, b)| a != b)\n227\t        .unwrap_or(c.len().min(r.len()));\n228\t    panic!(\n229\t        \"{ctx}: byte mismatch\\n  C   len={} {}\\n  Rust len={} {}\\n  first diff at {}\",\n230\t        c.len(),\n231\t        hexdump(&c[first.saturating_sub(8)..], 48),\n232\t        r.len(),\n233\t        hexdump(&r[first.saturating_sub(8)..], 48),\n234\t        first\n235\t    );\n236\t}\n237\t\n238\tpub const ZSTD_CONTENTSIZE_UNKNOWN: u64 = u64::MAX;\n239\tpub const ZSTD_CONTENTSIZE_ERROR: u64 = u64::MAX - 1;\n240\t\n241\tpub fn is_error(code: usize) -> bool {\n242\t    // ZSTD_isError: code > (size_t)-ZSTD_error_maxCode(=120)\n243\t    (code as isize) < 0 && (0usize.wrapping_sub(code)) <= 120\n244\t}\n245\t\n246\tpub fn err_code(code: usize) -> usize {\n247\t    0usize.wrapping_sub(code)\n248\t}\n249\t"}]},"parent_tool_use_id":"toolu_bdrk_01Vw3T2VXPmk7ueJw4J26uBW","session_id":"2a31ca95-dd24-43a5-a333-deba8c9ab59a","uuid":"1dca7148-869c-435e-8cfc-af9f7616f857","timestamp":"2026-09-08T18:13:37.934Z","subagent_type":"general-purpose","task_description":"Write entropy differential tests"}
