{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Q6Kx2EneiJZvrto5cA1KYH","type":"tool_result","content":"1\t//! Phase B: LOW-LEVEL entry points — compressBegin/Continue/End, the block API,\n2\t//! decompressBegin/nextSrcSizeToDecompress/decompressContinue/nextInputType,\n3\t//! copyCCtx/copyDCtx, insertBlock, getFrameHeader, writeLastEmptyBlock.\n4\t#![allow(non_snake_case, dead_code)]\n5\tmod common;\n6\tuse common::*;\n7\tuse std::os::raw::{c_int, c_uint, c_ulonglong, c_void};\n8\t\n9\ttype FnNew = unsafe extern \"C\" fn() -> *mut c_void;\n10\ttype FnFree = unsafe extern \"C\" fn(*mut c_void) -> usize;\n11\ttype FnBegin = unsafe extern \"C\" fn(*mut c_void, c_int) -> usize;\n12\ttype FnBeginDict = unsafe extern \"C\" fn(*mut c_void, *const u8, usize, c_int) -> usize;\n13\ttype FnBeginAdv =\n14\t    unsafe extern \"C\" fn(*mut c_void, *const u8, usize, Parameters, c_ulonglong) -> usize;\n15\ttype FnBeginCDict = unsafe extern \"C\" fn(*mut c_void, *const c_void) -> usize;\n16\ttype FnBeginCDictAdv =\n17\t    unsafe extern \"C\" fn(*mut c_void, *const c_void, FParams, c_ulonglong) -> usize;\n18\ttype FnChunk = unsafe extern \"C\" fn(*mut c_void, *mut u8, usize, *const u8, usize) -> usize;\n19\ttype FnCopyCCtx = unsafe extern \"C\" fn(*mut c_void, *const c_void, c_ulonglong) -> usize;\n20\ttype FnCopyDCtx = unsafe extern \"C\" fn(*mut c_void, *const c_void);\n21\ttype FnCtxSize = unsafe extern \"C\" fn(*const c_void) -> usize;\n22\ttype FnDBegin = unsafe extern \"C\" fn(*mut c_void) -> usize;\n23\ttype FnDBeginDict = unsafe extern \"C\" fn(*mut c_void, *const u8, usize) -> usize;\n24\ttype FnDBeginDDict = unsafe extern \"C\" fn(*mut c_void, *const c_void) -> usize;\n25\ttype FnNextSize = unsafe extern \"C\" fn(*mut c_void) -> usize;\n26\ttype FnNextType = unsafe extern \"C\" fn(*mut c_void) -> c_int;\n27\ttype FnInsertBlock = unsafe extern \"C\" fn(*mut c_void, *const u8, usize) -> usize;\n28\ttype FnSetParam = unsafe extern \"C\" fn(*mut c_void, c_int, c_int) -> usize;\n29\ttype FnSetFormat = unsafe extern \"C\" fn(*mut c_void, c_int) -> usize;\n30\ttype FnGetFrameHeader = unsafe extern \"C\" fn(*mut FrameHeader, *const u8, usize) -> usize;\n31\ttype FnGetFrameHeaderAdv =\n32\t    unsafe extern \"C\" fn(*mut FrameHeader, *const u8, usize, c_int) -> usize;\n33\ttype FnWriteLastEmpty = unsafe extern \"C\" fn(*mut u8, usize) -> usize;\n34\ttype FnBound = unsafe extern \"C\" fn(usize) -> usize;\n35\ttype FnGetParams = unsafe extern \"C\" fn(c_int, c_ulonglong, usize) -> Parameters;\n36\ttype FnCreateCDict = unsafe extern \"C\" fn(*const u8, usize, c_int) -> *mut c_void;\n37\ttype FnCreateDDict = unsafe extern \"C\" fn(*const u8, usize) -> *mut c_void;\n38\ttype FnFreeDict = unsafe extern \"C\" fn(*mut c_void) -> usize;\n39\ttype FnCompress2 = unsafe extern \"C\" fn(*mut c_void, *mut u8, usize, *const u8, usize) -> usize;\n40\ttype FnCheckContinuity = unsafe extern \"C\" fn(*mut c_void, *const u8, usize);\n41\t\n42\t#[repr(C)]\n43\t#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\n44\tpub struct CParams {\n45\t    pub windowLog: c_uint,\n46\t    pub chainLog: c_uint,\n47\t    pub hashLog: c_uint,\n48\t    pub searchLog: c_uint,\n49\t    pub minMatch: c_uint,\n50\t    pub targetLength: c_uint,\n51\t    pub strategy: c_int,\n52\t}\n53\t#[repr(C)]\n54\t#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\n55\tpub struct FParams {\n56\t    pub contentSizeFlag: c_int,\n57\t    pub checksumFlag: c_int,\n58\t    pub noDictIDFlag: c_int,\n59\t}\n60\t#[repr(C)]\n61\t#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\n62\tpub struct Parameters {\n63\t    pub cParams: CParams,\n64\t    pub fParams: FParams,\n65\t}\n66\t#[repr(C)]\n67\t#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\n68\tpub struct FrameHeader {\n69\t    pub frameContentSize: c_ulonglong,\n70\t    pub windowSize: c_ulonglong,\n71\t    pub blockSizeMax: c_uint,\n72\t    pub frameType: c_int,\n73\t    pub headerSize: c_uint,\n74\t    pub dictID: c_uint,\n75\t    pub checksumFlag: c_uint,\n76\t    pub _r1: c_uint,\n77\t    pub _r2: c_uint,\n78\t}\n79\t\n80\tconst C_COMPRESSIONLEVEL: c_int = 100;\n81\tconst C_MAXBLOCKSIZE: c_int = 1015;\n82\tconst C_WINDOWLOG: c_int = 101;\n83\tconst C_FORMAT: c_int = 10;\n84\tconst C_CHECKSUMFLAG: c_int = 201;\n85\tconst C_CONTENTSIZEFLAG: c_int = 200;\n86\tconst D_WINDOWLOGMAX: c_int = 100;\n87\t\n88\tstruct Both {\n89\t    c: *mut c_void,\n90\t    r: *mut c_void,\n91\t}\n92\t\n93\tfn new_cctx_pair() -> (Both, libloading::Symbol<'static, FnFree>, libloading::Symbol<'static, FnFree>) {\n94\t    let (cn, rn) = unsafe { pair::<FnNew>(\"ZSTD_createCCtx\") };\n95\t    let (cf, rf) = unsafe { pair::<FnFree>(\"ZSTD_freeCCtx\") };\n96\t    (Both { c: unsafe { cn() }, r: unsafe { rn() } }, cf, rf)\n97\t}\n98\t\n99\tfn new_dctx_pair() -> (Both, libloading::Symbol<'static, FnFree>, libloading::Symbol<'static, FnFree>) {\n100\t    let (cn, rn) = unsafe { pair::<FnNew>(\"ZSTD_createDCtx\") };\n101\t    let (cf, rf) = unsafe { pair::<FnFree>(\"ZSTD_freeDCtx\") };\n102\t    (Both { c: unsafe { cn() }, r: unsafe { rn() } }, cf, rf)\n103\t}\n104\t\n105\t/// Run the compressBegin/compressContinue/compressEnd pipeline in both libs.\n106\t/// `begin` performs the chosen begin variant on the given context.\n107\tfn begin_continue_end(\n108\t    begin: &dyn Fn(*mut c_void, bool) -> usize,\n109\t    src: &[u8],\n110\t    chunk: usize,\n111\t    ctx: &str,\n112\t) -> Option<Vec<u8>> {\n113\t    let (cont_c, cont_r) = unsafe { pair::<FnChunk>(\"ZSTD_compressContinue\") };\n114\t    let (end_c, end_r) = unsafe { pair::<FnChunk>(\"ZSTD_compressEnd\") };\n115\t    let (cb, _) = unsafe { pair::<FnBound>(\"ZSTD_compressBound\") };\n116\t    let (both, cf, rf) = new_cctx_pair();\n117\t\n118\t    let mut outs: [Vec<u8>; 2] = [Vec::new(), Vec::new()];\n119\t    let mut rets: [Vec<usize>; 2] = [Vec::new(), Vec::new()];\n120\t    let mut ok = true;\n121\t    for which in 0..2 {\n122\t        let z = if which == 0 { both.c } else { both.r };\n123\t        let rc = begin(z, which == 1);\n124\t        rets[which].push(rc);\n125\t        if is_error(rc) {\n126\t            ok = false;\n127\t            continue;\n128\t        }\n129\t        let mut collected = Vec::new();\n130\t        let mut pos = 0usize;\n131\t        let mut buf = vec![0u8; unsafe { cb(chunk.max(1)) } + 1024];\n132\t        while pos < src.len() {\n133\t            let n = chunk.min(src.len() - pos);\n134\t            let last = pos + n == src.len();\n135\t            let f = if last {\n136\t                if which == 0 { &end_c } else { &end_r }\n137\t            } else if which == 0 {\n138\t                &cont_c\n139\t            } else {\n140\t                &cont_r\n141\t            };\n142\t            let w = unsafe { f(z, buf.as_mut_ptr(), buf.len(), src[pos..].as_ptr(), n) };\n143\t            rets[which].push(w);\n144\t            if is_error(w) {\n145\t                ok = false;\n146\t                break;\n147\t            }\n148\t            collected.extend_from_slice(&buf[..w]);\n149\t            pos += n;\n150\t        }"}]},"parent_tool_use_id":"toolu_bdrk_01Vw3T2VXPmk7ueJw4J26uBW","session_id":"2a31ca95-dd24-43a5-a333-deba8c9ab59a","uuid":"d4b01184-af85-4d2e-ae23-6f1d78bb2d24","timestamp":"2026-09-08T18:13:38.592Z","subagent_type":"general-purpose","task_description":"Write entropy differential tests"}
