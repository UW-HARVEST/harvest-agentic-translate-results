embly\"),\n127\t    (D_MAXBLOCKSIZE, \"maxBlockSize\"),\n128\t];\n129\t\n130\tpub const RESET_SESSION_ONLY: c_int = 1;\n131\tpub const RESET_PARAMETERS: c_int = 2;\n132\tpub const RESET_SESSION_AND_PARAMETERS: c_int = 3;\n133\t\n134\t#[test]\n135\tfn cfg_cParam_getBounds_all() {\n136\t    let (cg, rg) = unsafe { pair::<FnGetBounds>(\"ZSTD_cParam_getBounds\") };\n137\t    for &(p, name) in ALL_CPARAMS {\n138\t        let c = unsafe { cg(p) };\n139\t        let r = unsafe { rg(p) };\n140\t        assert_eq!(c, r, \"ZSTD_cParam_getBounds({name}={p})\");\n141\t        assert_eq!(c.error, 0, \"C bounds error for {name}\");\n142\t    }\n143\t    // unknown / out-of-range parameter values (C enums accept any int)\n144\t    for p in [-1000, -1, 0, 1, 9, 11, 99, 108, 129, 131, 165, 203, 403, 499, 501, 999, 1003, 1018,\n145\t        1019, 100000, c_int::MAX, c_int::MIN] {\n146\t        let c = unsafe { cg(p) };\n147\t        let r = unsafe { rg(p) };\n148\t        assert_eq!(c, r, \"ZSTD_cParam_getBounds(bogus {p})\");\n149\t    }\n150\t}\n151\t\n152\t#[test]\n153\tfn cfg_dParam_getBounds_all() {\n154\t    let (cg, rg) = unsafe { pair::<FnGetBounds>(\"ZSTD_dParam_getBounds\") };\n155\t    for &(p, name) in ALL_DPARAMS {\n156\t        let c = unsafe { cg(p) };\n157\t        let r = unsafe { rg(p) };\n158\t        assert_eq!(c, r, \"ZSTD_dParam_getBounds({name}={p})\");\n159\t        assert_eq!(c.error, 0, \"C bounds error for {name}\");\n160\t    }\n161\t    for p in [-1, 0, 1, 99, 101, 999, 1006, 1007, 100000, c_int::MAX, c_int::MIN] {\n162\t        let c = unsafe { cg(p) };\n163\t        let r = unsafe { rg(p) };\n164\t        assert_eq!(c, r, \"ZSTD_dParam_getBounds(bogus {p})\");\n165\t    }\n166\t}\n167\t\n168\tstruct CCtxPair {\n169\t    c: *mut c_void,\n170\t    r: *mut c_void,\n171\t    c_set: libloading::Symbol<'static, FnSetParam>,\n172\t    r_set: libloading::Symbol<'static, FnSetParam>,\n173\t    c_get: libloading::Symbol<'static, FnGetParam>,\n174\t    r_get: libloading::Symbol<'static, FnGetParam>,\n175\t    c_c2: libloading::Symbol<'static, FnCompress2>,\n176\t    r_c2: libloading::Symbol<'static, FnCompress2>,\n177\t    c_reset: libloading::Symbol<'static, FnReset>,\n178\t    r_reset: libloading::Symbol<'static, FnReset>,\n179\t    c_pledge: libloading::Symbol<'static, FnPledged>,\n180\t    r_pledge: libloading::Symbol<'static, FnPledged>,\n181\t    c_free: libloading::Symbol<'static, FnFree>,\n182\t    r_free: libloading::Symbol<'static, FnFree>,\n183\t}\n184\t\n185\timpl CCtxPair {\n186\t    fn new() -> CCtxPair {\n187\t        let (cn, rn) = unsafe { pair::<FnNew>(\"ZSTD_createCCtx\") };\n188\t        let (c_set, r_set) = unsafe { pair::<FnSetParam>(\"ZSTD_CCtx_setParameter\") };\n189\t        let (c_get, r_get) = unsafe { pair::<FnGetParam>(\"ZSTD_CCtx_getParameter\") };\n190\t        let (c_c2, r_c2) = unsafe { pair::<FnCompress2>(\"ZSTD_compress2\") };\n191\t        let (c_reset, r_reset) = unsafe { pair::<FnReset>(\"ZSTD_CCtx_reset\") };\n192\t        let (c_pledge, r_pledge) = unsafe { pair::<FnPledged>(\"ZSTD_CCtx_setPledgedSrcSize\") };\n193\t        let (c_free, r_free) = unsafe { pair::<FnFree>(\"ZSTD_freeCCtx\") };\n194\t        let c = unsafe { cn() };\n195\t        let r = unsafe { rn() };\n196\t        assert!(!c.is_null() && !r.is_null());\n197\t        CCtxPair { c, r, c_set, r_set, c_get, r_get, c_c2, r_c2, c_reset, r_reset, c_pledge,\n198\t            r_pledge, c_free, r_free }\n199\t    }\n200\t\n201\t    fn set(&self, p: c_int, v: c_int, ctx: &str) -> usize {\n202\t        let a = unsafe { (self.c_set)(self.c, p, v) };\n203\t        let b = unsafe { (self.r_set)(self.r, p, v) };\n204\t        assert_eq!(a, b, \"{ctx}: setParameter({p},{v}) return\");\n205\t        // and the read-back value must match\n206\t        let mut av = 0;\n207\t        let mut bv = 0;\n208\t        let ga = unsafe { (self.c_get)(self.c, p, &mut av) };\n209\t        let gb = unsafe { (self.r_get)(self.r, p, &mut bv) };\n210\t        assert_eq!(ga, gb, \"{ctx}: getParameter({p}) return\");\n211\t        if !is_error(ga) {\n212\t            assert_eq!(av, bv, \"{ctx}: getParameter({p}) value\");\n213\t        }\n214\t        a\n215\t    }\n216\t\n217\t    fn reset(&self, kind: c_int) {\n218\t        let a = unsafe { (self.c_reset)(self.c, kind) };\n219\t        let b = unsafe { (self.r_reset)(self.r, kind) };\n220\t        assert_eq!(a, b, \"CCtx_reset({kind})\");\n221\t    }\n222\t\n223\t    fn pledge(&self, n: u64) -> usize {\n224\t        let a = unsafe { (self.c_pledge)(self.c, n) };\n225\t        let b = unsafe { (self.r_pledge)(self.r, n) };\n226\t        assert_eq!(a, b, \"setPledgedSrcSize({n})\");\n227\t        a\n228\t    }\n229\t\n230\t    /// compress2 in both, requiring identical return and bytes\n231\t    fn compress2(&self, src: &[u8], cap: usize, ctx: &str) -> (usize, Vec<u8>) {\n232\t        let mut cbuf = vec![0xAAu8; cap];\n233\t        let mut rbuf = vec![0x55u8; cap];\n234\t        let a = unsafe { (self.c_c2)(self.c, cbuf.as_mut_ptr(), cap, src.as_ptr(), src.len()) };\n235\t        let b = unsafe { (self.r_c2)(self.r, rbuf.as_mut_ptr(), cap, src.as_ptr(), src.len()) };\n236\t        assert_eq!(a, b, \"{ctx}: compress2 return (C err={})\", err_code(a));\n237\t        if !is_error(a) {\n238\t            assert_bytes_eq(&format!(\"{ctx}: compress2 bytes\"), &cbuf[..a], &rbuf[..a]);\n239\t            cbuf.truncate(a);\n240\t        }\n241\t        (a, cbuf)\n242\t    }\n243\t}\n244\t\n245\timpl Drop for CCtxPair {\n246\t    fn drop(&mut self) {\n247\t        unsafe {\n248\t            (self.c_free)(self.c);\n249\t            (self.r_free)(self.r);\n250\t        }\n251\t    }\n252\t}\n253\t\n254\tfn dctx_decompress_diff(frame: &[u8], expect: Option<&[u8]>, dparams: &[(c_int, c_int)], ctx: &str) {\n255\t    let (cn, rn) = unsafe { pair::<FnNew>(\"ZSTD_createDCtx\") };\n256\t    let (cf, rf) = unsafe { pair::<FnFree>(\"ZSTD_freeDCtx\") };\n257\t    let (cs, rs) = unsafe { pair::<FnSetParam>(\"ZSTD_DCtx_setParameter\") };\n258\t    let (cd, rd) = unsafe { pair::<FnDecompressDCtx>(\"ZSTD_decompressDCtx\") };\n259\t    let c = unsafe { cn() };\n260\t    let r = unsafe { rn() };\n261\t    for &(p, v) in dparams {\n262\t        let a = unsafe { cs(c, p, v) };\n263\t        let b = unsafe { rs(r, p, v) };\n264\t        assert_eq!(a, b, \"{ctx}: DCtx_setParameter({p},{v})\");\n265\t    }\n266\t    let cap = expect.map(|e| e.len()).unwrap_or(1 << 20) + 64;\n267\t    let mut co = vec![0u8; cap];\n268\t    let mut ro = vec![0u8; cap];\n269\t    let a = unsafe { cd(c, co.as_mut_ptr(), cap, frame.as_ptr(), frame.len()) };\n270\t    let b = unsafe { rd(r, ro.as_mut_ptr(), cap, frame.as_ptr(), frame.len()) };\n271\t    assert_eq!(a, b, \"{ctx}: decompressDCtx return (C err {})\", err_code(a));\n272\t    if !is_error(a) {\n273\t        assert_bytes_eq(&format!(\"{ctx}: dec bytes\"), &co[..a], &ro[..b]);\n274\t        if let Some(e) = expect {\n275\t            assert_bytes_eq(&format!(\"{ctx}: dec vs orig\"), &co[..a], e);\n276\t        }\n277\t    }\n278\t    unsafe {\n279\t        cf(c);\n280\t        rf(r);\n281\t    }\n282\t}\n283\t\n284\t/// For every cParameter: set it to lower bound, upper bound, mid, default(0-ish)\n285\t/// and compress several inputs, comparing bytes.\n286\t#[test]\n287\tfn cfg_every_cparam_at_bounds() {\n288\t    let (cg, _) = unsafe { pair::<FnGetBounds>(\"ZSTD_cParam_getBounds\") };\n289\t    let (cb, _) = unsafe { pair::<FnBound>(\"ZSTD_compressBound\") };\n290\t    let mut rng = Rng::new(0xBEEF);\n291\t    for &(p, name) in ALL_CPARAMS {\n292\t        let b = unsafe { cg(p) };\n293\t        assert_eq!(b.error, 0);\n294\t        let mut vals = vec![b.lower_bound, b.upper_bound];\n295\t        if b.upper_bound > b.lower_bound {\n296\t            vals.push(b.lower_bound + (b.upper_bound - b.lower_bound) / 2);\n297\t            vals.push(b.lower_bound.saturating_add(1));\n298\t            vals.push(b.upper_bound - 1);\n299\t        }\n300\t        vals.dedup();\n301\t        for &v in &vals {\n302\t            // limit crazy-large values that would allocate GBs\n303\t            if (p == C_WINDOWLOG || p == C_LDMHASHLOG || p == C_HASHLOG || p == C_CHAINLOG)\n304\t                && v > 27\n305\t            {\n306\t                continue;\n307\t            }\n308\t            if p == C_NBWORKERS && v > 4 {\n309\t                continue;\n310\t            }\n311\t            if p == C_JOBSIZE && v > (1 << 22) {\n312\t                continue;\n313\t            }\n314\t            if p == C_SRCSIZEHINT && v > (1 << 24) {\n315\t                continue;\n316\t            }\n317\t            if p == C_TARGETCBLOCKSIZE && v > (1 << 20) {\n318\t                continue;\n319\t            }\n320\t            if p == C_MAXBLOCKSIZE && v > (1 << 18) {\n321\t                continue;\n322\t            }\n323\t            for &(shape, size) in &[\n324\t                (Shape::Text, 3000usize),\n325\t                (Shape::Random, 5000),\n326\t                (Shape::Rle, 200000),\n327\t                (Shape::LongMatches, 150000),\n328\t            ] {\n329\t                let src = gen(shape, size, &mut rng);\n330\t                let pair_ctx = CCtxPair::new();\n331\t                let ctx = format!(\"cparam {name}({p})={v} shape={shape:?} size={size}\");\n332\t                let rc = pair_ctx.set(p, v, &ctx);\n333\t                if is_error(rc) {\n334\t                    continue;\n335\t                }\n336\t                let cap = unsafe { cb(src.len()) } + 64;\n337\t                let (n, frame) = pair_ctx.compress2(&src, cap, &ctx);\n338\t                if !is_error(n) {\n339\t                    let dp: Vec<(c_int, c_int)> = if p == C_FORMAT && v == 1 {\n340\t                        vec![(D_FORMAT, 1)]\n341\t                    } else {\n342\t                        vec![(D_WINDOWLOGMAX, 31)]\n343\t                    };\n344\t                    dctx_decompress_diff(&frame, Some(&src), &dp, &ctx);\n345\t                }\n346\t            }\n347\t        }\n348\t    }\n349\t}\n350\t\n351\t/// Cross-product of the \"shape of output\" flags with input shapes.\n352\t#[test]\n353\tfn cfg_flag_combinations() {\n354\t    let (cb, _) = unsafe { pair::<FnBound>(\"ZSTD_compressBound\") };\n355\t    let mut rng = Rng::new(0xF00D);\n356\t    for &checksum in &[0, 1] {\n357\t        for &contentsize in &[0, 1] {\n358\t            for &dictid in &[0, 1] {\n359\t                for &format in &[0, 1] {\n360\t                    for &pledged in &[false, true] {\n361\t                        for &shape in &[Shape::Text, Shape::Random, Shape::Rle] {\n362\t                            let size = rng.range(1, 20000);\n363\t                            let src = gen(shape, size, &mut rng);\n364\t                            let p = CCtxPair::new();\n365\t                            let ctx = format!(\n366\t                                \"flags cs={checksum} csz={contentsize} did={dictid} fmt={format} pledge={pledged} shape={shape:?} size={size}\"\n367\t                            );\n368\t                            p.set(C_CHECKSUMFLAG, checksum, &ctx);\n369\t                            p.set(C_CONTENTSIZEFLAG, contentsize, &ctx);\n370\t                            p.set(C_DICTIDFLAG, dictid, &ctx);\n371\t                            p.set(C_FORMAT, format, &ctx);\n372\t                            if pledged {\n373\t                                p.pledge(src.len() as u64);\n374\t                            }\n375\t                            let cap = unsafe { cb(src.len()) } + 64;\n376\t                            let (n, frame) = p.compress2(&src, cap, &ctx);\n377\t                            assert!(!is_error(n), \"{ctx}: {}\", err_code(n));\n378\t                            let dp = if format == 1 {\n379\t                                vec![(D_FORMAT, 1)]\n380\t                            } else {\n381\t                                vec![]\n382\t                            };\n383\t                            dctx_decompress_diff(&frame, Some(&src), &dp, &ctx);\n384\t                        }\n385\t                    }\n386\t                }\n387\t            }\n388\t        }\n389\t    }\n390\t}\n391\t\n392\t/// All 9 strategies x window/hash/chain/search/minMatch/targetLength variation.\n393\t#[test]\n394\tfn cfg_all_strategies_manual_params() {\n395\t    let (cb, _) = unsafe { pair::<FnBound>(\"ZSTD_compressBound\") };\n396\t    let mut rng = Rng::new(0x5721);\n397\t    for strat in 1..=9 {\n398\t        for &(wlog, hlog, clog, slog, mm, tlen) in &[\n399\t            (10, 10, 10, 1, 3, 0),\n400\t            (17, 17, 17, 4, 4, 32),\n401\t            (20, 18, 19, 6, 5, 999),\n402\t            (23, 22, 23, 8, 7, 4096),\n403\t        ] {\n404\t            for &shape in &[Shape::Text, Shape::Random, Shape::LongMatches, Shape::Mixed] {\n405\t                let size = rng.range(1000, 200000);\n406\t                let src = gen(shape, size, &mut rng);\n407\t                let p = CCtxPair::new();\n408\t                let ctx = format!(\n409\t                    \"strategy={strat} w={wlog} h={hlog} c={clog} s={slog} mm={mm} t={tlen} shape={shape:?} size={size}\"\n410\t                );\n411\t                p.set(C_STRATEGY, strat, &ctx);\n412\t                p.set(C_WINDOWLOG, wlog, &ctx);\n413\t                p.set(C_HASHLOG, hlog, &ctx);\n414\t                let e = p.set(C_CHAINLOG, clog, &ctx);\n415\t                let _ = e;\n416\t                p.set(C_SEARCHLOG, slog, &ctx);\n417\t                p.set(C_MINMATCH, mm, &ctx);\n418\t                p.set(C_TARGETLENGTH, tlen, &ctx);\n419\t                let cap = unsafe { cb(src.len()) } + 64;\n420\t                let (n, frame) = p.compress2(&src, cap, &ctx);\n421\t                if !is_error(n) {\n422\t                    dctx_decompress_diff(&frame, Some(&src), &[(D_WINDOWLOGMAX, 31)], &ctx);\n423\t                }\n424\t            }\n425\t        }\n426\t    }\n427\t}\n428\t\n429\t/// Long-distance matching parameter matrix.\n430\t#[test]\n431\tfn cfg_ldm_matrix() {\n432\t    let (cb, _) = unsafe { pair::<FnBound>(\"ZSTD_compressBound\") };\n433\t    let mut rng = Rng::new(0x1D1D);\n434\t    for &enable in &[0, 1] {\n435\t        for &(hlog, mm, bslog, hrlog) in\n436\t            &[(0, 0, 0, 0), (10, 32, 1, 0), (20, 64, 4, 7), (24, 4096, 8, 1)]\n437\t        {\n438\t            for &wlog in &[17, 20, 25] {\n439\t                for &shape in &[Shape::LongMatches, Shape::Repetitive, Shape::Random] {\n440\t                    let size = rng.range(100000, 400000);\n441\t                    let src = gen(shape, size, &mut rng);\n442\t                    let p = CCtxPair::new();\n443\t                    let ctx = format!(\n444\t                        \"ldm en={enable} h={hlog} mm={mm} b={bslog} r={hrlog} w={wlog} shape={shape:?} size={size}\"\n445\t                    );\n446\t                    p.set(C_ENABLELDM, enable, &ctx);\n447\t                    p.set(C_WINDOWLOG, wlog, &ctx);\n448\t                    if hlog != 0 {\n449\t                        p.set(C_LDMHASHLOG, hlog, &ctx);\n450\t                    }\n451\t                    if mm != 0 {\n452\t                        p.set(C_LDMMINMATCH, mm, &ctx);\n453\t                    }\n454\t                    if bslog != 0 {\n455\t                        p.set(C_LDMBUCKETSIZELOG, bslog, &ctx);\n456\t                    }\n457\t                    if hrlog != 0 {\n458\t                        p.set(C_LDMHASHRATELOG, hrlog, &ctx);\n459\t                    }\n460\t                    let cap = unsafe { cb(src.len()) } + 64;\n461\t                    let (n, frame) = p.compress2(&src, cap, &ctx);\n462\t                    if !is_error(n) {\n463\t                        dctx_decompress_diff(&frame, Some(&src), &[(D_WINDOWLOGMAX, 31)], &ctx);\n464\t                    }\n465\t                }\n466\t            }\n467\t        }\n468\t    }\n469\t}\n470\t\n471\t/// Block splitter / row match finder / literal compression mode / repcode resolution.\n472\t#[test]\n473\tfn cfg_misc_experimental_matrix() {\n474\t    let (cb, _) = unsafe { pair::<FnBound>(\"ZSTD_compressBound\") };\n475\t    let mut rng = Rng::new(0xABCD);\n476\t    for &lcm in &[0, 1, 2] {\n477\t        for &rowmf in &[0, 1, 2] {\n478\t            for &bsl in &[0, 1, 2, 3, 4] {\n479\t                for &rcr in &[0, 1, 2] {\n480\t                    for &shape in &[Shape::Text, Shape::Mixed, Shape::Random] {\n481\t                        let size = rng.range(20000, 200000);\n482\t                        let src = gen(shape, size, &mut rng);\n483\t                        let p = CCtxPair::new();\n484\t                        let ctx = format!(\n485\t                            \"misc lcm={lcm} rowmf={rowmf} bsl={bsl} rcr={rcr} shape={shape:?} size={size}\"\n486\t                        );\n487\t                        p.set(C_LITERALCOMPRESSIONMODE, lcm, &ctx);\n488\t                        p.set(C_USEROWMATCHFINDER, rowmf, &ctx);\n489\t                        p.set(C_BLOCKSPLITTERLEVEL, bsl, &ctx);\n490\t                        p.set(C_REPCODERESOLUTION, rcr, &ctx);\n491\t                        p.set(C_COMPRESSIONLEVEL, [1, 5, 9, 13, 19][rng.below(5)], &ctx);\n492\t                        let cap = unsafe { cb(src.len()) } + 64;\n493\t                        let (n, frame) = p.compress2(&src, cap, &ctx);\n494\t                        if !is_error(n) {\n495\t                            dctx_decompress_diff(&frame, Some(&src), &[], &ctx);\n496\t                        }\n497\t                    }\n498\t                }\n499\t            }\n500\t        }\n501\t    }\n502\t}\n503\t\n504\t/// targetCBlockSize / maxBlockSize / srcSizeHint / forceMaxWindow / rsyncable /\n505\t/// deterministicRefPrefix / splitAfterSequences / prefetchCDictTables\n506\t#[test]\n507\tfn cfg_more_experimental_matrix() {\n508\t    let (cb, _) = unsafe { pair::<FnBound>(\"ZSTD_compressBound\") };\n509\t    let mut rng = Rng::new(0xDEAD);\n510\t    for &tcbs in &[0, 1340, 65536] {\n511\t        for &mbs in &[0, 1024, 131072] {\n512\t            for &ssh in &[0, 100, 1 << 20] {\n513\t                for &fmw in &[0, 1] {\n514\t                    for &rsy in &[0, 1] {\n515\t                        for &shape in &[Shape::Text, Shape::Random] {\n516\t                            let size = rng.range(50000, 300000);\n517\t                            let src = gen(shape, size, &mut rng);\n518\t                            let p = CCtxPair::new();\n519\t                            let ctx = format!(\n520\t                                \"more tcbs={tcbs} mbs={mbs} ssh={ssh} fmw={fmw} rsy={rsy} shape={shape:?} size={size}\"\n521\t                            );\n522\t                            p.set(C_TARGETCBLOCKSIZE, tcbs, &ctx);\n523\t                            p.set(C_MAXBLOCKSIZE, mbs, &ctx);\n524\t                            p.set(C_SRCSIZEHINT, ssh, &ctx);\n525\t                            p.set(C_FORCEMAXWINDOW, fmw, &ctx);\n526\t                            p.set(C_RSYNCABLE, rsy, &ctx);\n527\t                            p.set(C_SPLITAFTERSEQUENCES, (rng.next_u32() % 3) as c_int, &ctx);\n528\t                            p.set(C_DETERMINISTICREFPREFIX, (rng.next_u32() % 2) as c_int, &ctx);\n529\t                            let cap = unsafe { cb(src.len()) } + 64;\n530\t                            let (n, frame) = p.compress2(&src, cap, &ctx);\n531\t                            if !is_error(n) {\n532\t                                dctx_decompress_diff(\n533\t                                    &frame,\n534\t                                    Some(&src),\n535\t                                    &[(D_MAXBLOCKSIZE, 131072)],\n536\t                                    &ctx,\n537\t                                );\n538\t                            }\n539\t                        }\n540\t                    }\n541\t                }\n542\t            }\n543\t        }\n544\t    }\n545\t}\n546\t\n547\t/// every dParameter, valid values, on a variety of frames\n548\t#[test]\n549\tfn cfg_every_dparam() {\n550\t    let (cg, _) = unsafe { pair::<FnGetBounds>(\"ZSTD_dParam_getBounds\") };\n551\t    let (cb, _) = unsafe { pair::<FnBound>(\"ZSTD_compressBound\") };\n552\t    let mut rng = Rng::new(0x0D0D);\n553\t    // build a set of frames: plain, with checksum, magicless, big window\n554\t    let mut frames: Vec<(String, Vec<u8>, Vec<u8>, bool)> = Vec::new();\n555\t    for &(cksum, fmt, wlog) in &[(0, 0, 17), (1, 0, 17), (0, 1, 17), (1, 1, 21), (0, 0, 25)] {\n556\t        let src = gen(Shape::Text, 250000, &mut rng);\n557\t        let p = CCtxPair::new();\n558\t        let ctx = format!(\"frame cksum={cksum} fmt={fmt} wlog={wlog}\");\n559\t        p.set(C_CHECKSUMFLAG, cksum, &ctx);\n560\t        p.set(C_FORMAT, fmt, &ctx);\n561\t        p.set(C_WINDOWLOG, wlog, &ctx);\n562\t        let cap = unsafe { cb(src.len()) } + 64;\n563\t        let (n, frame) = p.compress2(&src, cap, &ctx);\n564\t        assert!(!is_error(n));\n565\t        frames.push((ctx, frame, src, fmt == 1));\n566\t    }\n567\t    for &(dp, name) in ALL_DPARAMS {\n568\t        let b = unsafe { cg(dp) };\n569\t        let mut vals = vec![b.lower_bound, b.upper_bound];\n570\t        if b.upper_bound > b.lower_bound {\n571\t            vals.push(b.lower_bound + (b.upper_bound - b.lower_bound) / 2);\n572\t        }\n573\t        vals.dedup();\n574\t        for &v in &vals {\n575\t            if dp == D_MAXBLOCKSIZE && v > (1 << 18) {\n576\t                continue;\n577\t            }\n578\t            for (fctx, frame, src, magicless) in &frames {\n579\t                let mut params = vec![(dp, v)];\n580\t                if *magicless && dp != D_FORMAT {\n581\t                    params.push((D_FORMAT, 1));\n582\t                }\n583\t                if dp != D_WINDOWLOGMAX {\n584\t                    params.push((D_WINDOWLOGMAX, 31));\n585\t                }\n586\t                let ctx = format!(\"dparam {name}({dp})={v} on {fctx}\");\n587\t                // note: some combinations legitimately fail in C (e.g. windowLogMax too\n588\t                // small, wrong format); dctx_decompress_diff compares returns either way\n589\t                let expect: Option<&[u8]> = None;\n590\t                let _ = src;\n591\t                dctx_decompress_diff(frame, expect, &params, &ctx);\n592\t            }\n593\t        }\n594\t    }\n595\t}\n596\t\n597\t#[test]\n598\tfn cfg_reset_and_pledged_sequences() {\n599\t    let (cb, _) = unsafe { pair::<FnBound>(\"ZSTD_compressBound\") };\n600\t    let mut rng = Rng::new(0x9999);\n601\t    let p = CCtxPair::new();\n602\t    for round in 0..30 {\n603\t        let ctx = format!(\"reset round={round}\");\n604\t        let kind = [RESET_SESSION_ONLY, RESET_PARAMETERS, RESET_SESSION_AND_PARAMETERS]\n605\t            [rng.below(3)];\n606\t        p.reset(kind);\n607\t        p.set(C_COMPRESSIONLEVEL, [1, 4, 8, 12, 19][rng.below(5)], &ctx);\n608\t        p.set(C_CHECKSUMFLAG, (rng.next_u32() % 2) as c_int, &ctx);\n609\t        let src = gen(ALL_SHAPES[rng.below(ALL_SHAPES.len())], rng.range(0, 50000), &mut rng);\n610\t        if rng.next_u32() % 2 == 0 {\n611\t            p.pledge(src.len() as u64);\n612\t        }\n613\t        let cap = unsafe { cb(src.len()) } + 64;\n614\t        let (n, frame) = p.compress2(&src, cap, &ctx);\n615\t        if !is_error(n) {\n616\t            dctx_decompress_diff(&frame, Some(&src), &[], &ctx);\n617\t        }\n618\t    }\n619\t}\n620\t"}]},"parent_tool_use_id":"toolu_bdrk_01JDS6Ufv671L4hjddpjV1bD","session_id":"2a31ca95-dd24-43a5-a333-deba8c9ab59a","uuid":"bc676d75-8c8d-4edc-bf1b-da2d68803bc6","timestamp":"2026-09-08T18:15:31.289Z","subagent_type":"general-purpose","task_description":"Write frameinfo/seq/mem tests"}
