i}\"), gen(Shape::Random, 4096, &mut rng)));\n        let mut skewed = vec![7u8; 4096];\n        for _ in 0..41 { let p = rng.below(4096); skewed[p] = rng.byte(); }\n        sources.push((format!(\"skewed#{i}\"), skewed));\n    }\n\n    for &table_log in &[5u32, 6, 9, 11, 12, 13] {\n    for &msv in &[1u32, 15, 100, 255] {\n    for (sname, raw) in &sources {\n        let src = mask_alphabet(raw, msv);\n        for &low_prob in &[0u32, 1] {\n        for &bmi2 in &[0i32, 1] {\n        for which in 0..2 {\n            let is_c = which == 0;\n            let tag = format!(\"tl={table_log} msv={msv} src={sname} lp={low_prob} bmi2={bmi2} which={which}\");\n            let mut count = [0u32; 256];\n            let mut msv_io: c_uint = msv;\n            let hret = unsafe { let f = if is_c {&c_hist} else {&r_hist};\n                f(count.as_mut_ptr(), &mut msv_io, src.as_ptr() as *const c_void, src.len()) };\n            if is_error(hret) { continue; }\n            let amsv = msv_io;\n            let mut norm = [0i16; 256];\n            let nret = unsafe { let f = if is_c {&c_norm} else {&r_norm};\n                f(norm.as_mut_ptr(), table_log, count.as_ptr(), src.len(), amsv, low_prob) };\n            if is_error(nret) || nret == 0 { continue; }\n            let tl = nret as u32;\n\n            let nc_logical = 512usize;\n            let mut ncount = mk8(nc_logical);\n            let wret = unsafe { let f = if is_c {&c_wnc} else {&r_wnc};\n                f(ncount.as_mut_ptr() as *mut c_void, nc_logical, norm.as_ptr(), amsv, tl) };\n            chk8(&format!(\"{tag} ncount\"), &ncount, nc_logical);\n            if is_error(wret) { continue; }\n\n            let ct_l = fse_ctable_size_u32(tl, amsv);\n            let mut ctable = mk32(ct_l);\n            let cw_l = fse_build_ctable_wksp_u32(amsv, tl);\n            let mut ct_wksp = mk32(cw_l);\n            let bret = unsafe { let f = if is_c {&c_bct} else {&r_bct};\n                f(ctable.as_mut_ptr(), norm.as_ptr(), amsv, tl,\n                  ct_wksp.as_mut_ptr() as *mut c_void, cw_l*4) };\n            chk32(&format!(\"{tag} ctable\"), &ctable, ct_l);\n            chk32(&format!(\"{tag} ct_wksp\"), &ct_wksp, cw_l);\n            if is_error(bret) { continue; }\n\n            let cb_l = fse_compress_bound(src.len());\n            let mut cbuf = mk8(cb_l);\n            let cret = unsafe { let f = if is_c {&c_cmp} else {&r_cmp};\n                f(cbuf.as_mut_ptr() as *mut c_void, cb_l, src.as_ptr() as *const c_void, src.len(), ctable.as_ptr()) };\n            chk8(&format!(\"{tag} cbuf\"), &cbuf, cb_l);\n            if is_error(cret) { continue; }\n            let mut small = mk8(8);\n            let _ = unsafe { let f = if is_c {&c_cmp} else {&r_cmp};\n                f(small.as_mut_ptr() as *mut c_void, 8, src.as_ptr() as *const c_void, src.len(), ctable.as_ptr()) };\n            chk8(&format!(\"{tag} small\"), &small, 8);\n\n            let mut norm2 = [0i16; 256];\n            let mut msv2: c_uint = 255;\n            let mut tl2: c_uint = 0;\n            let rret = unsafe { let f = if is_c {&c_rnc} else {&r_rnc};\n                f(norm2.as_mut_ptr(), &mut msv2, &mut tl2, ncount.as_ptr() as *const c_void, nc_logical) };\n            if is_error(rret) { continue; }\n\n            let dt_l = fse_dtable_size_u32(FSE_MAX_TABLELOG);\n            let mut dtable = mk32(dt_l);\n            let dw_l = fse_build_dtable_wksp_u32(FSE_MAX_TABLELOG, 255);\n            let mut dt_wksp = mk32(dw_l);\n            let _ = unsafe { let f = if is_c {&c_bdt} else {&r_bdt};\n                f(dtable.as_mut_ptr(), norm2.as_ptr(), msv2, tl2,\n                  dt_wksp.as_mut_ptr() as *mut c_void, dw_l*4) };\n            chk32(&format!(\"{tag} dtable\"), &dtable, dt_l);\n            chk32(&format!(\"{tag} dt_wksp\"), &dt_wksp, dw_l);\n            let _ = unsafe { let f = if is_c {&c_bdt} else {&r_bdt};\n                f(dtable.as_mut_ptr(), norm2.as_ptr(), msv2, tl2,\n                  dt_wksp.as_mut_ptr() as *mut c_void, 8) };\n            chk32(&format!(\"{tag} dtable(after small)\"), &dtable, dt_l);\n            chk32(&format!(\"{tag} dt_wksp(after small)\"), &dt_wksp, dw_l);\n\n            if cret == 0 { continue; }\n            let mut frame = ncount[..wret].to_vec();\n            frame.extend_from_slice(&cbuf[..cret]);\n            let out_l = src.len();\n            let mut out = mk8(out_l);\n            let dws_l = fse_decompress_wksp_u32(FSE_MAX_TABLELOG, 255);\n            let mut dwksp = mk32(dws_l);\n            let _ = unsafe { let f = if is_c {&c_dec} else {&r_dec};\n                f(out.as_mut_ptr() as *mut c_void, out_l, frame.as_ptr() as *const c_void, frame.len(),\n                  FSE_MAX_TABLELOG, dwksp.as_mut_ptr() as *mut c_void, dws_l*4, bmi2) };\n            chk8(&format!(\"{tag} out\"), &out, out_l);\n            chk32(&format!(\"{tag} dwksp\"), &dwksp, dws_l);\n            let _ = unsafe { let f = if is_c {&c_dec} else {&r_dec};\n                f(out.as_mut_ptr() as *mut c_void, out_l, frame.as_ptr() as *const c_void, frame.len(),\n                  4, dwksp.as_mut_ptr() as *mut c_void, dws_l*4, bmi2) };\n            chk8(&format!(\"{tag} out(maxlog)\"), &out, out_l);\n            chk32(&format!(\"{tag} dwksp(maxlog)\"), &dwksp, dws_l);\n            let _ = unsafe { let f = if is_c {&c_dec} else {&r_dec};\n                f(out.as_mut_ptr() as *mut c_void, out_l, frame.as_ptr() as *const c_void, frame.len(),\n                  FSE_MAX_TABLELOG, dwksp.as_mut_ptr() as *mut c_void, 16, bmi2) };\n            chk8(&format!(\"{tag} out(wksp16)\"), &out, out_l);\n            chk32(&format!(\"{tag} dwksp(wksp16)\"), &dwksp, dws_l);\n        }}}}}}\n}\nEOF\ntimeout 900 cargo test --offline --release --test phase_b_entropy -- --exact --test-threads=1 --nocapture zz_canary 2>&1 | tail -20","description":"Canary test to find the overflow"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_inpu