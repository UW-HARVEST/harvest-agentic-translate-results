{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01U5mYhZULB4GX58uAZ1qQHz","type":"tool_result","content":"570\t    for &seed in &[0xC0FEu64, 0x2222] {\n571\t        let corp = corpus(Shape::Text, seed, 250, 64, 384);\n572\t        for &(k, d) in &[(16u32, 6u32), (50, 6), (200, 8), (1000, 8), (2048, 16)] {\n573\t            for &sp in &[0.0f64, 0.5, 0.75, 1.0] {\n574\t                for &cap in &[1024usize, 16384] {\n575\t                    if k as usize > cap {\n576\t                        continue; // k > maxDictSize is an error path (see err test)\n577\t                    }\n578\t                    let mut p = cover_params(k, d, 3, 12345);\n579\t                    p.splitPoint = sp;\n580\t                    let ctx =\n581\t                        format!(\"cover seed={seed:#x} k={k} d={d} sp={sp} cap={cap}\");\n582\t                    let (n, dict) = train_cover(cap, &corp, p, &ctx);\n583\t                    assert!(!is_error(n), \"{ctx}: error {}\", err_code(n));\n584\t                    assert_eq!(&dict[..4], &DICT_MAGIC, \"{ctx}: magic\");\n585\t                    // dictID was pinned\n586\t                    assert_eq!(&dict[4..8], &12345u32.to_le_bytes(), \"{ctx}: dictID\");\n587\t                }\n588\t            }\n589\t        }\n590\t        // CONFIGS 188: shrinkDict x shrinkDictMaxRegression (no effect on the\n591\t        // non-optimizing entry point, but must still match byte for byte)\n592\t        for &shrink in &[0u32, 1] {\n593\t            for &reg in &[0u32, 1, 5] {\n594\t                for &sp in &[0.5f64, 0.75] {\n595\t                    let mut p = cover_params(200, 8, 3, 1);\n596\t                    p.shrinkDict = shrink;\n597\t                    p.shrinkDictMaxRegression = reg;\n598\t                    p.splitPoint = sp;\n599\t                    let ctx = format!(\n600\t                        \"cover seed={seed:#x} shrink={shrink} reg={reg} sp={sp}\"\n601\t                    );\n602\t                    let (n, _) = train_cover(8192, &corp, p, &ctx);\n603\t                    assert!(!is_error(n), \"{ctx}: error {}\", err_code(n));\n604\t                }\n605\t            }\n606\t        }\n607\t        // compression levels and dictIDs\n608\t        for &lvl in &[0i32, 1, 3, 9, 19] {\n609\t            for &id in &[1u32, 12345, 0x8000_0001] {\n610\t                let p = cover_params(200, 8, lvl, id);\n611\t                let ctx = format!(\"cover seed={seed:#x} lvl={lvl} id={id:#x}\");\n612\t                let (n, dict) = train_cover(8192, &corp, p, &ctx);\n613\t                assert!(!is_error(n), \"{ctx}: error {}\", err_code(n));\n614\t                assert_eq!(&dict[4..8], &id.to_le_bytes(), \"{ctx}: dictID\");\n615\t            }\n616\t        }\n617\t        // dictID == 0 => derived from XXH64(content): deterministic, but the\n618\t        // value is not pinned, so only the return code is asserted here.\n619\t        let p = cover_params(200, 8, 3, 0);\n620\t        let (cf, rf) = unsafe { pair::<FnTrainCover>(\"ZDICT_trainFromBuffer_cover\") };\n621\t        let mut cbuf = vec![0u8; 8192];\n622\t        let mut rbuf = vec![0u8; 8192];\n623\t        let a = unsafe {\n624\t            cf(cbuf.as_mut_ptr(), 8192, corp.ptr(), corp.sptr(), corp.nb(), p)\n625\t        };\n626\t        let b = unsafe {\n627\t            rf(rbuf.as_mut_ptr(), 8192, corp.ptr(), corp.sptr(), corp.nb(), p)\n628\t        };\n629\t        assert_eq!(a, b, \"cover dictID=0 return\");\n630\t        assert!(!is_error(a));\n631\t        // shapes other than text\n632\t        for &shape in &[Shape::Random, Shape::Rle, Shape::Repetitive, Shape::Sparse] {\n633\t            let c = corpus(shape, seed ^ 0x99, 120, 64, 256);\n634\t            let p = cover_params(200, 8, 3, 7);\n635\t            train_cover(4096, &c, p, &format!(\"cover shape={shape:?} seed={seed:#x}\"));\n636\t        }\n637\t    }\n638\t}\n639\t"}]},"parent_tool_use_id":"toolu_bdrk_018ta38GmxYRrD5CPxbp4