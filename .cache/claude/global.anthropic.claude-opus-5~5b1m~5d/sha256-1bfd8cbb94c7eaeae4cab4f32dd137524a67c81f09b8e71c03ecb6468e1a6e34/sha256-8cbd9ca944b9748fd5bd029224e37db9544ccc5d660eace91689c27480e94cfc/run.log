                    junk.as_ptr() as *const c_void, n, maxlog,\n                         wb.as_mut_ptr() as *mut c_void, wksp_size, bmi2)\n                };\n                assert_eq!(x, y, \"FSE_decompress_wksp_bmi2(n={n},maxlog={maxlog},bmi2={bmi2})\");\n                if !is_error(x) {\n                    assert_bytes_eq(\"fse decompressed\", &oa[..x], &ob[..y]);\n                }\n            }\n        }\n    }\n}\n\n#[test]\nfn err_huf() {\n    type FnReadStats = unsafe extern \"C\" fn(*mut u8, usize, *mut c_uint, *mut c_uint, *mut c_uint, *const c_void, usize) -> usize;\n    type FnDecompress1X = unsafe extern \"C\" fn(*mut c_void, usize, *const c_void, usize, *mut c_void, usize, c_int) -> usize;\n    type FnDecompress4X = FnDecompress1X;\n    let (crs, rrs) = unsafe { pair::<FnReadStats>(\"HUF_readStats\") };\n    let (c1, r1) = unsafe { pair::<FnDecompress1X>(\"HUF_decompress1X_DCtx_wksp\") };\n    let (c4, r4) = unsafe { pair::<FnDecompress4X>(\"HUF_decompress4X_hufOnly_wksp\") };\n    let mut rng = Rng::new(0xE015);\n    let wksp_size = 8704 * 2;\n    for n in [0usize, 1, 2, 3, 8, 64, 128, 512] {\n        for &shape in &[Shape::Random, Shape::Rle] {\n            let junk = gen(shape, n, &mut rng);\n            let mut wa = vec![0u8; wksp_size];\n            let mut wb = vec![0u8; wksp_size];\n            let mut ha = vec![0u8; 256];\n            let mut hb = vec![0u8; 256];\n            let mut ra = [0u32; 3];\n            let mut rb = [0u32; 3];\n            let x = unsafe {\n                crs(ha.as_mut_ptr(), 256, ra.as_mut_ptr(), &mut ra[1] as *mut u32,\n                    &mut ra[2] as *mut u32, junk.as_ptr() as *const c_void, n)\n            };\n            let y = unsafe {\n                rrs(hb.as_mut_ptr(), 256, rb.as_mut_ptr(), &mut rb[1] as *mut u32,\n                    &mut rb[2] as *mut u32, junk.as_ptr() as *const c_void, n)\n            };\n            assert_eq!(x, y, \"HUF_readStats(n={n},{shape:?})\");\n            if !is_error(x) {\n                assert_eq!(ha, hb, \"HUF_readStats table\");\n                assert_eq!(ra, rb, \"HUF_readStats out params\");\n            }\n            for flags in [0, 1, 16, 32, 48] {\n                let mut oa = vec![0u8; 4096];\n                let mut ob = vec![0u8; 4096];\n                let x = unsafe {\n                    c1(oa.as_mut_ptr() as *mut c_void, oa.len(),\n                       junk.as_ptr() as *const c_void, n,\n                       wa.as_mut_ptr() as *mut c_void, wksp_size, flags)\n                };\n                let y = unsafe {\n                    r1(ob.as_mut_ptr() as *mut c_void, ob.len(),\n                       junk.as_ptr() as *const c_void, n,\n                       wb.as_mut_ptr() as *mut c_void, wksp_size, flags)\n                };\n                assert_eq!(x, y, \"HUF_decompress1X_DCtx_wksp(n={n},flags={flags})\");\n                if !is_error(x) {\n                    assert_bytes_eq(\"huf 1X out\", &oa[..x], &ob[..y]);\n                }\n                let x = unsafe {\n                    c4(oa.as_mut_ptr() as *mut c_void, oa.len(),\n                       junk.as_ptr() as *const c_void, n,\n                       wa.as_mut_ptr() as *mut c_void, wksp_size, flags)\n                };\n                let y = unsafe {\n                    r4(ob.as_mut_ptr() as *mut c_void, ob.len(),\n                       junk.as_ptr() as *const c_void, n,\n                       wb.as_mut_ptr() as *mut c_void, wksp_size, flags)\n                };\n                assert_eq!(x, y, \"HUF_decompress4X_hufOnly_wksp(n={n},flags={flags})\");\n                if !is_error(x) {\n                    assert_bytes_eq(\"huf 4X out\", &oa[..x], &ob[..y]);\n                }\n            }\n        }\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":9144,"cache_read_input_tokens":322371,"cache_creation":{"ephemeral_5m_input_tokens":9144,"ephemeral_1h_in