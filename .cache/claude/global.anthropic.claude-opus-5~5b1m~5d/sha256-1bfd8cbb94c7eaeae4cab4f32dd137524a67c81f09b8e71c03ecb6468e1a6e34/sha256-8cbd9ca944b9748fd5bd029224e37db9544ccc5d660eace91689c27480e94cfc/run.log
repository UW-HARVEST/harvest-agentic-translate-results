{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_018UNw8z4rNaRtrV8NaxuzEz","type":"tool_result","content":"1\t//! Phase B: dictionary APIs — CDict / DDict / loadDictionary / refPrefix /\n2\t//! dictContentType / dictLoadMethod / attach-pref, plus dictID queries.\n3\t#![allow(non_snake_case, dead_code)]\n4\tmod common;\n5\tuse common::*;\n6\tuse std::os::raw::{c_int, c_uint, c_void};\n7\t\n8\ttype FnNew = unsafe extern \"C\" fn() -> *mut c_void;\n9\ttype FnFree = unsafe extern \"C\" fn(*mut c_void) -> usize;\n10\ttype FnSetParam = unsafe extern \"C\" fn(*mut c_void, c_int, c_int) -> usize;\n11\ttype FnBound = unsafe extern \"C\" fn(usize) -> usize;\n12\ttype FnCreateCDict = unsafe extern \"C\" fn(*const u8, usize, c_int) -> *mut c_void;\n13\ttype FnCreateDDict = unsafe extern \"C\" fn(*const u8, usize) -> *mut c_void;\n14\ttype FnFreeDict = unsafe extern \"C\" fn(*mut c_void) -> usize;\n15\ttype FnCompressUsingCDict =\n16\t    unsafe extern \"C\" fn(*mut c_void, *mut u8, usize, *const u8, usize, *const c_void) -> usize;\n17\ttype FnDecompressUsingDDict =\n18\t    unsafe extern \"C\" fn(*mut c_void, *mut u8, usize, *const u8, usize, *const c_void) -> usize;\n19\ttype FnLoadDict = unsafe extern \"C\" fn(*mut c_void, *const u8, usize) -> usize;\n20\ttype FnLoadDictAdv =\n21\t    unsafe extern \"C\" fn(*mut c_void, *const u8, usize, c_int, c_int) -> usize;\n22\ttype FnRefDict = unsafe extern \"C\" fn(*mut c_void, *const c_void) -> usize;\n23\ttype FnRefPrefixAdv = unsafe extern \"C\" fn(*mut c_void, *const u8, usize, c_int) -> usize;\n24\ttype FnCompress2 = unsafe extern \"C\" fn(*mut c_void, *mut u8, usize, *const u8, usize) -> usize;\n25\ttype FnDecompressDCtx =\n26\t    unsafe extern \"C\" fn(*mut c_void, *mut u8, usize, *const u8, usize) -> usize;\n27\ttype FnDictIDFromBuf = unsafe extern \"C\" fn(*const u8, usize) -> c_uint;\n28\ttype FnDictIDFromDict = unsafe extern \"C\" fn(*const c_void) -> c_uint;\n29\ttype FnSizeofDict = unsafe extern \"C\" fn(*const c_void) -> usize;\n30\ttype FnTrain = unsafe extern \"C\" fn(*mut u8, usize, *const u8, *const usize, c_uint) -> usize;\n31\t\n32\tconst C_COMPRESSIONLEVEL: c_int = 100;\n33\tconst C_CHECKSUMFLAG: c_int = 201;\n34\tconst C_DICTIDFLAG: c_int = 202;\n35\tconst C_FORCEATTACHDICT: c_int = 1001;\n36\tconst C_ENABLEDEDICATEDDICTSEARCH: c_int = 1005;\n37\tconst C_PREFETCHCDICTTABLES: c_int = 1013;\n38\tconst C_DETERMINISTICREFPREFIX: c_int = 1012;\n39\tconst D_REFMULTIPLEDDICTS: c_int = 1003;\n40\t\n41\t/// Build a trained dictionary with the C library (used as test *input*; the\n42\t/// dictBuilder itself is differentially tested in phase_b_dictbuilder.rs).\n43\tfn train_dict(rng: &mut Rng, dict_cap: usize) -> Vec<u8> {\n44\t    let (ctrain, rtrain) = unsafe { pair::<FnTrain>(\"ZDICT_trainFromBuffer\") };\n45\t    let nb = 400;\n46\t    let mut samples = Vec::new();\n47\t    let mut sizes = Vec::new();\n48\t    for _ in 0..nb {\n49\t        let n = rng.range(64, 512);\n50\t        let s = gen(Shape::Text, n, rng);\n51\t        sizes.push(s.len());\n52\t        samples.extend_from_slice(&s);\n53\t    }\n54\t    let mut cbuf = vec![0u8; dict_cap];\n55\t    let mut rbuf = vec![0u8; dict_cap];\n56\t    let cn = unsafe {\n57\t        ctrain(cbuf.as_mut_ptr(), dict_cap, samples.as_ptr(), sizes.as_ptr(), nb as c_uint)\n58\t    };\n59\t    let rn = unsafe {\n60\t        rtrain(rbuf.as_mut_ptr(), dict_cap, samples.as_ptr(), sizes.as_ptr(), nb as c_uint)\n61\t    };\n62\t    assert_eq!(cn, rn, \"ZDICT_trainFromBuffer return\");\n63\t    assert!(!is_error(cn), \"ZDICT_trainFromBuffer failed: {}\", err_code(cn));\n64\t    assert_bytes_eq(\"trained dictionary bytes\", &cbuf[..cn], &rbuf[..rn]);\n65\t    cbuf.truncate(cn);\n66\t    cbuf\n67\t}\n68\t\n69\tfn compress2_diff(\n70\t    setup: &dyn Fn(*mut c_void, bool) -> usize,\n71\t    src: &[u8],\n72\t    ctx: &str,\n73\t) -> Option<Vec<u8>> {\n74\t    let (cn, rn) = unsafe { pair::<FnNew>(\"ZSTD_createCCtx\") };\n75\t    let (cf, rf) = unsafe { pair::<FnFree>(\"ZSTD_freeCCtx\") };\n76\t    let (c2, r2) = unsafe { pair::<FnCompress2>(\"ZSTD_compress2\") };\n77\t    let (cb, _) = unsafe { pair::<FnBound>(\"ZSTD_compressBound\") };\n78\t    let cap = unsafe { cb(src.len()) } + 64;\n79\t\n80\t    let cc = unsafe { cn() };\n81\t    let rc = unsafe { rn() };\n82\t    let sa = setup(cc, false);\n83\t    let sb = setup(rc, true);\n84\t    assert_eq!(sa, sb, \"{ctx}: dictionary setup return differs\");\n85\t    let mut out = None;\n86\t    if !is_error(sa) {\n87\t        let mut cbuf = vec![0xAAu8; cap];\n88\t        let mut rbuf = vec![0x55u8; cap];\n89\t        let a = unsafe { c2(cc, cbuf.as_mut_ptr(), cap, src.as_ptr(), src.len()) };\n90\t        let b = unsafe { r2(rc, rbuf.as_mut_ptr(), cap, src.as_ptr(), src.len()) };\n91\t        assert_eq!(a, b, \"{ctx}: compress2 return (C err {})\", err_code(a));\n92\t        if !is_error(a) {\n93\t            assert_bytes_eq(&format!(\"{ctx}: compress2 bytes\"), &cbuf[..a], &rbuf[..b]);\n94\t            cbuf.truncate(a);\n95\t            out = Some(cbuf);\n96\t        }\n97\t    }\n98\t    unsafe {\n99\t        cf(cc);\n100\t        rf(rc);\n101\t    }\n102\t    out\n103\t}\n104\t\n105\tfn decompress_diff(\n106\t    setup: &dyn Fn(*mut c_void, bool) -> usize,\n107\t    frame: &[u8],\n108\t    expect: &[u8],\n109\t    ctx: &str,\n110\t) {\n111\t    let (cn, rn) = unsafe { pair::<FnNew>(\"ZSTD_createDCtx\") };\n112\t    let (cf, rf) = unsafe { pair::<FnFree>(\"ZSTD_freeDCtx\") };\n113\t    let (cd, rd) = unsafe { pair::<FnDecompressDCtx>(\"ZSTD_decompressDCtx\") };\n114\t    let cc = unsafe { cn() };\n115\t    let rc = unsafe { rn() };\n116\t    let sa = setup(cc, false);\n117\t    let sb = setup(rc, true);\n118\t    assert_eq!(sa, sb, \"{ctx}: dctx setup return differs\");\n119\t    if !is_error(sa) {\n120\t        let cap = expect.len() + 64;\n121\t        let mut co = vec![0u8; cap];\n122\t        let mut ro = vec![0u8; cap];\n123\t        let a = unsafe { cd(cc, co.as_mut_ptr(), cap, frame.as_ptr(), frame.len()) };\n124\t        let b = unsafe { rd(rc, ro.as_mut_ptr(), cap, frame.as_ptr(), frame.len()) };\n125\t        assert_eq!(a, b, \"{ctx}: decompressDCtx return (C err {})\", err_code(a));\n126\t        if !is_error(a) {\n127\t            assert_bytes_eq(&format!(\"{ctx}: dec bytes\"), &co[..a], &ro[..b]);\n128\t            assert_bytes_eq(&format!(\"{ctx}: dec vs orig\"), &co[..a], expect);\n129\t        }\n130\t    }\n131\t    unsafe {\n132\t        cf(cc);\n133\t        rf(rc);\n134\t    }\n135\t}\n136\t\n137\t#[test]\n138\tfn cfg_cdict_ddict_levels_and_shapes() {\n139\t    let (c_ccd, r_ccd) = unsafe { pair::<FnCreateCDict>(\"ZSTD_createCDict\") };\n140\t    let (c_fcd, r_fcd) = unsafe { pair::<FnFreeDict>(\"ZSTD_freeCDict\") };\n141\t    let (c_cdd, r_cdd) = unsafe { pair::<FnCreateDDict>(\"ZSTD_createDDict\") };\n142\t    let (c_fdd, r_fdd) = unsafe { pair::<FnFreeDict>(\"ZSTD_freeDDict\") };\n143\t    let (c_cu, r_cu) = unsafe { pair::<FnCompressUsingCDict>(\"ZSTD_compress_usingCDict\") };\n144\t    let (c_du, r_du) = unsafe { pair::<FnDecompressUsingDDict>(\"ZSTD_decompress_usingDDict\") };\n145\t    let (c_cn, r_cn) = unsafe { pair::<FnNew>(\"ZSTD_createCCtx\") };\n146\t    let (c_cf, r_cf) = unsafe { pair::<FnFree>(\"ZSTD_freeCCtx\") };\n147\t    let (c_dn, r_dn) = unsafe { pair::<FnNew>(\"ZSTD_createDCtx\") };\n148\t    let (c_df, r_df) = unsafe { pair::<FnFree>(\"ZSTD_freeDCtx\") };\n149\t    let (c_szcd, r_szcd) = unsafe { pair::<FnSizeofDict>(\"ZSTD_sizeof_CDict\") };\n150\t    let (c_szdd, r_szdd) = unsafe { pair::<FnSizeofDict>(\"ZSTD_sizeof_DDict\") };\n151\t    let (c_idd, r_idd) = unsafe { pair::<FnDictIDFromDict>(\"ZSTD_getDictID_fromCDict\") };\n152\t    let (c_idD, r_idD) = unsafe { pair::<FnDictIDFromDict>(\"ZSTD_getDictID_fromDDict\") };\n153\t    let (c_idb, r_idb) = unsafe { pair::<FnDictIDFromBuf>(\"ZSTD_getDictID_fromDict\") };\n154\t    let (c_idf, r_idf) = unsafe { pair::<FnDictIDFromBuf>(\"ZSTD_getDictID_fromFrame\") };\n155\t    let (cb, _) = unsafe { pair::<FnBound>(\"ZSTD_compressBound\") };\n156\t\n157\t    let mut rng = Rng::new(0xD1C7);\n158\t    let trained = train_dict(&mut rng, 16384);\n159\t    let raw = gen(Shape::Text, 20000, &mut rng);\n160\t\n161\t    for (dname, dict) in [(\"trained\", &trained), (\"raw\", &raw)] {\n162\t        unsafe {\n163\t            assert_eq!(\n164\t                c_idb(dict.as_ptr(), dict.len()),\n165\t                r_idb(dict.as_ptr(), dict.len()),\n166\t                \"getDictID_fromDict {dname}\"\n167\t            );\n168\t        }\n169\t        for &lvl in &[1, 3, 6, 12, 19, -3] {\n170\t            let ccd = unsafe { c_ccd(dict.as_ptr(), dict.len(), lvl) };\n171\t            let rcd = unsafe { r_ccd(dict.as_ptr(), dict.len(), lvl) };\n172\t            assert!(!ccd.is_null() && !rcd.is_null());\n173\t            unsafe {\n174\t                assert_eq!(c_szcd(ccd), r_szcd(rcd), \"sizeof_CDict {dname} lvl={lvl}\");\n175\t                assert_eq!(c_idd(ccd), r_idd(rcd), \"getDictID_fromCDict {dname}\");\n176\t            }\n177\t            let cdd = unsafe { c_cdd(dict.as_ptr(), dict.len()) };\n178\t            let rdd = unsafe { r_cdd(dict.as_ptr(), dict.len()) };\n179\t            unsafe {\n180\t                assert_eq!(c_szdd(cdd), r_szdd(rdd), \"sizeof_DDict\");\n181\t                assert_eq!(c_idD(cdd), r_idD(rdd), \"getDictID_fromDDict\");\n182\t            }\n183\t\n184\t            let cctx = unsafe { c_cn() };\n185\t            let rctx = unsafe { r_cn() };\n186\t            let dctx = unsafe { c_dn() };\n187\t            let sctx = unsafe { r_dn() };\n188\t            for &shape in &[Shape::Text, Shape::Random, Shape::Repetitive] {\n189\t                for &size in &[0usize, 1, 50, 3000, 70000] {\n190\t                    let src = gen(shape, size, &mut rng);\n191\t                    let cap = unsafe { cb(src.len()) } + 64;\n192\t                    let mut cbuf = vec![0u8; cap];\n193\t                    let mut rbuf = vec![0u8; cap];\n194\t                    let a = unsafe {\n195\t                        c_cu(cctx, cbuf.as_mut_ptr(), cap, src.as_ptr(), src.len(), ccd)\n196\t                    };\n197\t                    let b = unsafe {\n198\t                        r_cu(rctx, rbuf.as_mut_ptr(), cap, src.as_ptr(), src.len(), rcd)\n199\t                    };\n200\t                    let ctx = format!(\n201\t                        \"usingCDict {dname} lvl={lvl} shape={shape:?} size={size}\"\n202\t                    );\n203\t                    assert_eq!(a, b, \"{ctx}\");\n204\t                    assert!(!is_error(a), \"{ctx} err {}\", err_code(a));\n205\t                    assert_bytes_eq(&ctx, &cbuf[..a], &rbuf[..b]);\n206\t                    unsafe {\n207\t                        assert_eq!(\n208\t                            c_idf(cbuf.as_ptr(), a),\n209\t                            r_idf(rbuf.as_ptr(), b),\n210\t                            \"{ctx}: getDictID_fromFrame\"\n211\t                        );\n212\t                    }\n213\t                    let mut co = vec![0u8; size + 8];\n214\t                    let mut ro = vec![0u8; size + 8];\n215\t                    let da = unsafe {\n216\t                        c_du(dctx, co.as_mut_ptr(), co.len(), cbuf.as_ptr(), a, cdd)\n217\t                    };\n218\t                    let db = unsafe {\n219\t                        r_du(sctx, ro.as_mut_ptr(), ro.len(), rbuf.as_ptr(), b, rdd)\n220\t                    };\n221\t                    assert_eq!(da, db, \"{ctx}: decompress_usingDDict\");\n222\t                    assert!(!is_error(da), \"{ctx}: dec err {}\", err_code(da));\n223\t                    assert_bytes_eq(&format!(\"{ctx} dec\"), &co[..da], &src);\n224\t                    assert_bytes_eq(&format!(\"{ctx} decr\"), &ro[..db], &src);\n225\t                }\n226\t            }\n227\t            unsafe {\n228\t                c_cf(cctx);\n229\t                r_cf(rctx);\n230\t                c_df(dctx);\n231\t                r_df(sctx);\n232\t                c_fcd(ccd);\n233\t                r_fcd(rcd);\n234\t                c_fdd(cdd);\n235\t                r_fdd(rdd);\n236\t            }\n237\t        }\n238\t    }\n239\t}\n240\t\n241\t#[test]\n242\tfn cfg_loadDictionary_variants() {\n243\t    let (c_ld, r_ld) = unsafe { pair::<FnLoadDict>(\"ZSTD_CCtx_loadDictionary\") };\n244\t    let (c_ldr, r_ldr) = unsafe { pair::<FnLoadDict>(\"ZSTD_CCtx_loadDictionary_byReference\") };\n245\t    let (c_lda, r_lda) = unsafe { pair::<FnLoadDictAdv>(\"ZSTD_CCtx_loadDictionary_advanced\") };\n246\t    let (c_dld, r_dld) = unsafe { pair::<FnLoadDict>(\"ZSTD_DCtx_loadDictionary\") };\n247\t    let (c_dldr, r_dldr) = unsafe { pair::<FnLoadDict>(\"ZSTD_DCtx_loadDictionary_byReference\") };\n248\t    let (c_dlda, r_dlda) = unsafe { pair::<FnLoadDictAdv>(\"ZSTD_DCtx_loadDictionary_advanced\") };\n249\t    let (c_sp, r_sp) = unsafe { pair::<FnSetParam>(\"ZSTD_CCtx_setParameter\") };\n250\t\n251\t    let mut rng = Rng::new(0x10AD);\n252\t    let trained = train_dict(&mut rng, 8192);\n253\t    let raw = gen(Shape::Text, 30000, &mut rng);\n254\t\n255\t    for (dname, dict) in [(\"trained\", trained.clone()), (\"raw\", raw.clone())] {\n256\t        // 0 = ZSTD_dlm_byCopy, 1 = ZSTD_dlm_byRef; dct: 0 auto, 1 rawContent, 2 fullDict\n257\t        for &(dlm, dct) in &[(0, 0), (0, 1), (0, 2), (1, 0), (1, 1), (1, 2)] {\n258\t            for &lvl in &[1, 5, 13, 19] {\n259\t                for &(shape, size) in\n260\t                    &[(Shape::Text, 5000usize), (Shape::Random, 3000), (Shape::Rle, 100000)]\n261\t                {\n262\t                    let src = gen(shape, size, &mut rng);\n263\t                    let d = dict.clone();\n264\t                    let ctx = format!(\n265\t                        \"loadDict_advanced {dname} dlm={dlm} dct={dct} lvl={lvl} shape={shape:?} size={size}\"\n266\t                    );\n267\t                    let dref = &d;\n268\t                    let setup = |cctx: *mut c_void, is_rust: bool| -> usize {\n269\t                        let sp = if is_rust { &r_sp } else { &c_sp };\n270\t                        let rc = unsafe { sp(cctx, C_COMPRESSIONLEVEL, lvl) };\n271\t                        if is_error(rc) {\n272\t                            return rc;\n273\t                        }\n274\t                        let f = if is_rust { &r_lda } else { &c_lda };\n275\t                        unsafe { f(cctx, dref.as_ptr(), dref.len(), dlm, dct) }\n276\t                    };\n277\t                    if let Some(frame) = compress2_diff(&setup, &src, &ctx) {\n278\t                        let dsetup = |dctx: *mut c_void, is_rust: bool| -> usize {\n279\t                            let f = if is_rust { &r_dlda } else { &c_dlda };\n280\t                            unsafe { f(dctx, dref.as_ptr(), dref.len(), dlm, dct) }\n281\t                        };\n282\t                        decompress_diff(&dsetup, &frame, &src, &ctx);\n283\t                    }\n284\t                }\n285\t            }\n286\t        }\n287\t        // plain + byReference wrappers\n288\t        for &which in &[0, 1] {\n289\t            let src = gen(Shape::Text, 12000, &mut rng);\n290\t            let d = dict.clone();\n291\t            let dref = &d;\n292\t            let ctx = format!(\"loadDict {dname} wrapper={which}\");\n293\t            let setup = |cctx: *mut c_void, is_rust: bool| -> usize {\n294\t                let f = match (which, is_rust) {\n295\t                    (0, false) => &c_ld,\n296\t                    (0, true) => &r_ld,\n297\t                    (_, false) => &c_ldr,\n298\t                    (_, true) => &r_ldr,\n299\t                };\n300\t                unsafe { f(cctx, dref.as_ptr(), dref.len()) }\n301\t            };\n302\t            if let Some(frame) = compress2_diff(&setup, &src, &ctx) {\n303\t                let dsetup = |dctx: *mut c_void, 