{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01GCDtt3XuZ9xMZqkjLTN5MU","type":"tool_result","content":"1\t//! Phase B: streaming API differential tests (new ZSTD_compressStream2 and the\n2\t//! old ZSTD_compressStream / flushStream / endStream), plus ZSTD_decompressStream.\n3\t#![allow(non_snake_case, dead_code)]\n4\tmod common;\n5\tuse common::*;\n6\tuse std::os::raw::{c_int, c_void};\n7\t\n8\t#[repr(C)]\n9\t#[derive(Clone, Copy)]\n10\tstruct InBuffer {\n11\t    src: *const u8,\n12\t    size: usize,\n13\t    pos: usize,\n14\t}\n15\t#[repr(C)]\n16\t#[derive(Clone, Copy)]\n17\tstruct OutBuffer {\n18\t    dst: *mut u8,\n19\t    size: usize,\n20\t    pos: usize,\n21\t}\n22\t\n23\ttype FnNew = unsafe extern \"C\" fn() -> *mut c_void;\n24\ttype FnFree = unsafe extern \"C\" fn(*mut c_void) -> usize;\n25\ttype FnSetParam = unsafe extern \"C\" fn(*mut c_void, c_int, c_int) -> usize;\n26\ttype FnSize = unsafe extern \"C\" fn() -> usize;\n27\ttype FnStream2 =\n28\t    unsafe extern \"C\" fn(*mut c_void, *mut OutBuffer, *mut InBuffer, c_int) -> usize;\n29\ttype FnStream = unsafe extern \"C\" fn(*mut c_void, *mut OutBuffer, *mut InBuffer) -> usize;\n30\ttype FnFlush = unsafe extern \"C\" fn(*mut c_void, *mut OutBuffer) -> usize;\n31\ttype FnInitCStream = unsafe extern \"C\" fn(*mut c_void, c_int) -> usize;\n32\ttype FnInitDStream = unsafe extern \"C\" fn(*mut c_void) -> usize;\n33\ttype FnCtxSize = unsafe extern \"C\" fn(*const c_void) -> usize;\n34\ttype FnBound = unsafe extern \"C\" fn(usize) -> usize;\n35\ttype FnPledged = unsafe extern \"C\" fn(*mut c_void, u64) -> usize;\n36\t\n37\tconst E_CONTINUE: c_int = 0;\n38\tconst E_FLUSH: c_int = 1;\n39\tconst E_END: c_int = 2;\n40\t\n41\tconst C_COMPRESSIONLEVEL: c_int = 100;\n42\tconst C_CHECKSUMFLAG: c_int = 201;\n43\tconst C_CONTENTSIZEFLAG: c_int = 200;\n44\tconst C_FORMAT: c_int = 10;\n45\tconst C_NBWORKERS: c_int = 400;\n46\tconst C_WINDOWLOG: c_int = 101;\n47\tconst C_STRATEGY: c_int = 107;\n48\tconst C_JOBSIZE: c_int = 401;\n49\tconst C_OVERLAPLOG: c_int = 402;\n50\tconst D_FORMAT: c_int = 1000;\n51\tconst D_WINDOWLOGMAX: c_int = 100;\n52\t\n53\t#[test]\n54\tfn cfg_stream_sizes() {\n55\t    for name in [\n56\t        \"ZSTD_CStreamInSize\",\n57\t        \"ZSTD_CStreamOutSize\",\n58\t        \"ZSTD_DStreamInSize\",\n59\t        \"ZSTD_DStreamOutSize\",\n60\t    ] {\n61\t        let (c, r) = unsafe { pair::<FnSize>(name) };\n62\t        assert_eq!(unsafe { c() }, unsafe { r() }, \"{name}\");\n63\t    }\n64\t}\n65\t\n66\t/// Drive compressStream2 in both libs with identical chunking, comparing the\n67\t/// full byte stream and each call's return value.\n68\tfn stream_compress_diff(\n69\t    src: &[u8],\n70\t    params: &[(c_int, c_int)],\n71\t    pledged: Option<u64>,\n72\t    in_chunk: usize,\n73\t    out_chunk: usize,\n74\t    end_mode_pattern: &[c_int],\n75\t    ctx: &str,\n76\t) -> Option<Vec<u8>> {\n77\t    let (cn, rn) = unsafe { pair::<FnNew>(\"ZSTD_createCCtx\") };\n78\t    let (cf, rf) = unsafe { pair::<FnFree>(\"ZSTD_freeCCtx\") };\n79\t    let (cs, rs) = unsafe { pair::<FnSetParam>(\"ZSTD_CCtx_setParameter\") };\n80\t    let (cp, rp) = unsafe { pair::<FnPledged>(\"ZSTD_CCtx_setPledgedSrcSize\") };\n81\t    let (c2, r2) = unsafe { pair::<FnStream2>(\"ZSTD_compressStream2\") };\n82\t\n83\t    let mut outs: [Vec<u8>; 2] = [Vec::new(), Vec::new()];\n84\t    let mut rets: [Vec<usize>; 2] = [Vec::new(), Vec::new()];\n85\t    let mut set_rets: [Vec<usize>; 2] = [Vec::new(), Vec::new()];\n86\t\n87\t    for which in 0..2 {\n88\t        let ctxp = if which == 0 { unsafe { cn() } } else { unsafe { rn() } };\n89\t        let mut skip = false;\n90\t        for &(p, v) in params {\n91\t            let rc = if which == 0 {\n92\t                unsafe { cs(ctxp, p, v) }\n93\t            } else {\n94\t                unsafe { rs(ctxp, p, v) }\n95\t            };\n96\t            set_rets[which].push(rc);\n97\t            if is_error(rc) {\n98\t                skip = true;\n99\t            }\n100\t        }\n101\t        if let Some(n) = pledged {\n102\t            let rc = if which == 0 { unsafe { cp(ctxp, n) } } else { unsafe { rp(ctxp, n) } };\n103\t            set_rets[which].push(rc);\n104\t            if is_error(rc) {\n105\t                skip = true;\n106\t            }\n107\t        }\n108\t        if skip {\n109\t            if which == 0 {\n110\t                unsafe { cf(ctxp) };\n111\t            } else {\n112\t                unsafe { rf(ctxp) };\n113\t            }\n114\t            continue;\n115\t        }\n116\t\n117\t        let mut input = InBuffer { src: src.as_ptr(), size: 0, pos: 0 };\n118\t        let mut outbuf = vec![0u8; out_chunk.max(1)];\n119\t        let mut collected: Vec<u8> = Vec::new();\n120\t        let mut mode_i = 0usize;\n121\t        let mut consumed_target = 0usize;\n122\t        let mut finished = false;\n123\t        let mut guard = 0;\n124\t        let mut prev_rc = 0usize; // 0 == nothing left to flush\n125\t        while !finished {\n126\t            guard += 1;\n127\t            assert!(guard < 2_000_000, \"{ctx}: stream loop did not terminate\");\n128\t            // Feed the next chunk only when the previous operation is fully\n129\t            // flushed and the current input has been consumed (adding input\n130\t            // after requesting an end/flush would violate the API contract).\n131\t            if prev_rc == 0 && input.pos == input.size && consumed_target < src.len() {\n132\t                consumed_target = (consumed_target + in_chunk).min(src.len());\n133\t                input.size = consumed_target;\n134\t            }\n135\t            let last_chunk = consumed_target == src.len();\n136\t            let mode = if last_chunk {\n137\t                E_END\n138\t            } else {\n139\t                end_mode_pattern[mode_i % end_mode_pattern.len()]\n140\t            };\n141\t            mode_i += 1;\n142\t            let mut out = OutBuffer { dst: outbuf.as_mut_ptr(), size: outbuf.len(), pos: 0 };\n143\t            let rc = if which == 0 {\n144\t                unsafe { c2(ctxp, &mut out, &mut input, mode) }\n145\t            } else {\n146\t                unsafe { r2(ctxp, &mut out, &mut input, mode) }\n147\t            };\n148\t            rets[which].push(rc);\n149\t            assert!(!is_error(rc), \"{ctx}: compressStream2 err {}\", err_code(rc));\n150\t            collected.extend_from_slice(&outbuf[..out.pos]);\n151\t            prev_rc = if input.pos < input.size { 1 } else { rc };\n152\t            if last_chunk && rc == 0 && input.pos == input.size {\n153\t                finished = true;\n154\t            }\n155\t        }\n156\t        outs[which] = collected;\n157\t        if which == 0 {\n158\t            unsafe { cf(ctxp) };\n159\t        } else {\n160\t            unsafe { rf(ctxp) };\n161\t        }\n162\t    }\n163\t    assert_eq!(set_rets[0], set_rets[1], \"{ctx}: setParameter return sequence differs\");\n164\t    if set_rets[0].iter().any(|&x| is_error(x)) {\n165\t        return None; // configuration unsupported by BOTH builds (verified identical)\n166\t    }\n167\t    assert_eq!(rets[0], rets[1], \"{ctx}: per-call return sequence differs\");\n168\t    assert_bytes_eq(&format!(\"{ctx}: streamed frame\"), &outs[0], &outs[1]);\n169\t    Some(outs[0].clone())\n170\t}\n171\t\n172\t/// Drive decompressStream in both libs with identical chunking.\n173\tfn stream_decompress_diff(\n174\t    frame: &[u8],\n175\t    expect: Option<&[u8]>,\n176\t    dparams: &[(c_int, c_int)],\n177\t    in_chunk: usize,\n178\t    out_chunk: usize,\n179\t    ctx: &str,\n180\t) {\n181\t    let (cn, rn) = unsafe { pair::<FnNew>(\"ZSTD_createDCtx\") };\n182\t    let (cf, rf) = unsafe { pair::<FnFree>(\"ZSTD_freeDCtx\") };\n183\t    let (cs, rs) = unsafe { pair::<FnSetParam>(\"ZSTD_DCtx_setParameter\") };\n184\t    let (cd, rd) = unsafe { pair::<FnStream>(\"ZSTD_decompressStream\") };\n185\t\n186\t    let mut outs: [Vec<u8>; 2] = [Vec::new(), Vec::new()];\n187\t    let mut rets: [Vec<usize>; 2] = [Vec::new(), Vec::new()];\n188\t    for which in 0..2 {\n189\t        let dctx = if which == 0 { unsafe { cn() } } else { unsafe { rn() } };\n190\t        for &(p, v) in dparams {\n191\t            let rc = if which == 0 {\n192\t                unsafe { cs(dctx, p, v) }\n193\t            } else {\n194\t                unsafe { rs(dctx, p, v) }\n195\t            };\n196\t            assert!(!is_error(rc), \"{ctx}: DCtx_setParameter({p},{v})\");\n197\t        }\n198\t        let mut input = InBuffer { src: frame.as_ptr(), size: 0, pos: 0 };\n199\t        let mut outbuf = vec![0u8; out_chunk.max(1)];\n200\t        let mut collected = Vec::new();\n201\t        let mut avail = 0usize;\n202\t        let mut guard = 0;\n203\t        loop {\n204\t            guard += 1;\n205\t            assert!(guard < 2_000_000, \"{ctx}: decompress loop stuck\");\n206\t            if avail < frame.len() {\n207\t                avail = (avail + in_chunk).min(frame.len());\n208\t                input.size = avail;\n209\t            }\n210\t            let mut out = OutBuffer { dst: outbuf.as_mut_ptr(), size: outbuf.len(), pos: 0 };\n211\t            let before_in = input.pos;\n212\t            let rc = if which == 0 {\n213\t                unsafe { cd(dctx, &mut out, &mut input) }\n214\t            } else {\n215\t                unsafe { rd(dctx, &mut out, &mut input) }\n216\t            };\n217\t            rets[which].push(rc);\n218\t            collected.extend_from_slice(&outbuf[..out.pos]);\n219\t            if is_error(rc) {\n220\t                break;\n221\t            }\n222\t            if rc == 0 && input.pos == frame.len() {\n223\t                break;\n224\t            }\n225\t            // no forward progress and no more input available => done/stuck\n226\t            if input.pos == before_in && out.pos == 0 && avail == frame.len() {\n227\t                break;\n228\t            }\n229\t        }\n230\t        outs[which] = collected;\n231\t        if which == 0 {\n232\t            unsafe { cf(dctx) };\n233\t        } else {\n234\t            unsafe { rf(dctx) };\n235\t        }\n236\t    }\n237\t    assert_eq!(rets[0], rets[1], \"{ctx}: decompressStream return sequence differs\");\n238\t    assert_bytes_eq(&format!(\"{ctx}: decompressed stream\"), &outs[0], &outs[1]);\n239\t    if let Some(e) = expect {\n240\t        assert_bytes_eq(&format!(\"{ctx}: decompressed vs orig\"), &outs[0], e);\n241\t    }\n242\t}\n243\t\n244\t#[test]\n245\tfn cfg_stream2_chunk_matrix() {\n246\t    let mut rng = Rng::new(0x5EED);\n247\t    for &in_chunk in &[1usize, 7, 1000, 131072, 1 << 20] {\n248\t        for &out_chunk in &[1usize, 7, 1000, 131591, 1 << 20] {\n249\t            for &shape in &[Shape::Text, Shape::Random, Shape::Rle] {\n250\t                let size = if in_chunk <= 7 || out_chunk <= 7 {\n251\t                    rng.range(0, 3000)\n252\t                } else {\n253\t                    rng.range(0, 300000)\n254\t                };\n255\t                let src = gen(shape, size, &mut rng);\n256\t                let ctx = format!(\n257\t                    \"stream2 in={in_chunk} out={out_chunk} shape={shape:?} size={size}\"\n258\t                );\n259\t                let frame_opt = stream_compress_diff(\n260\t                    &src,\n261\t                    &[(C_COMPRESSIONLEVEL, 3)],\n262\t                    None,\n263\t                    in_chunk,\n264\t                    out_chunk,\n265\t                    &[E_CONTINUE],\n266\t                    &ctx,\n267\t                );\n268\t                let Some(frame) = frame_opt else { continue };\n269\t                stream_decompress_diff(&frame, Some(&src), &[], in_chunk, out_chunk, &ctx);\n270\t            }\n271\t        }\n272\t    }\n273\t}\n274\t\n275\t#[test]\n276\tfn cfg_stream2_endmode_patterns() {\n277\t    let mut rng = Rng::new(0xE0DE);\n278\t    let patterns: &[&[c_int]] = &[\n279\t        &[E_CONTINUE],\n280\t        &[E_FLUSH],\n281\t        &[E_CONTINUE, E_FLUSH],\n282\t        &[E_FLUSH, E_FLUSH, E_CONTINUE],\n283\t        &[E_END],\n284\t        &[E_CONTINUE, E_END],\n285\t    ];\n286\t    for pat in patterns {\n287\t        for &shape in &[Shape::Text, Shape::Mixed] {\n288\t            for &lvl in &[1, 3, 9, 19] {\n289\t                let size = rng.range(0, 200000);\n290\t                let src = gen(shape, size, &mut rng);\n291\t                let ctx = format!(\"endmode {pat:?} shape={shape:?} lvl={lvl} size={size}\");\n292\t                let frame_opt = stream_compress_diff(\n293\t                    &src,\n294\t                    &[(C_COMPRESSIONLEVEL, lvl), (C_CHECKSUMFLAG, 1)],\n295\t                    None,\n296\t                    rng.range(1, 40000),\n297\t                    rng.range(1, 40000),\n298\t                    pat,\n299\t                    &ctx,\n300\t                );\n301\t                let Some(frame) = frame_opt else { continue };\n302\t                stream_decompress_diff(&frame, Some(&src), &[], 4096, 4096, &ctx);\n303\t            }\n304\t        }\n305\t    }\n306\t}\n307\t\n308\t#[test]\n309\tfn cfg_stream2_params_matrix() {\n310\t    let mut rng = Rng::new(0x77);\n311\t    for &cksum in &[0, 1] {\n312\t        for &csize in &[0, 1] {\n313\t            for &fmt in &[0, 1] {\n314\t                for &pledge in &[false, true] {\n315\t                    for &lvl in &[-3, 1, 6, 12, 19] {\n316\t                        let size = rng.range(0, 250000);\n317\t                        let shape = ALL_SHAPES[rng.below(ALL_SHAPES.len())];\n318\t                        let src = gen(shape, size, &mut rng);\n319\t                        let ctx = format!(\n320\t                            \"s2params cksum={cksum} csize={csize} fmt={fmt} pledge={pledge} lvl={lvl} shape={shape:?} size={size}\"\n321\t                        );\n322\t                        let frame_opt = stream_compress_diff(\n323\t                            &src,\n324\t                            &[\n325\t                                (C_COMPRESSIONLEVEL, lvl),\n326\t                                (C_CHECKSUMFLAG, cksum),\n327\t                                (C_CONTENTSIZEFLAG, csize),\n328\t                                (C_FORMAT, fmt),\n329\t                            ],\n330\t                            if pledge { Some(src.len() as u64) } else { None },\n331\t                            rng.range(1, 70000),\n332\t                            rng.range(1, 70000),\n333\t                            &[E_CONTINUE],\n334\t                            &ctx,\n335\t                        );\n336\t                        let dp: Vec<(c_int, c_int)> =\n337\t                            if fmt == 1 { vec![(D_FORMAT, 1)] } else { vec![] };\n338\t                        let Some(frame) = frame_opt else { continue };\n339\t                        stream_decompress_diff(&frame, Some(&src), &dp, 8192, 8192, &ctx);\n340\t                    }\n341\t                }\n342\t            }\n343\t        }\n344\t    }\n345\t}\n346\t\n347\t#[test]\n348\tfn cfg_stream2_multithreaded() {\n349\t    let mut rng = Rng::new(0x4711);\n350\t    for &workers in &[0, 1, 2, 4] {\n351\t        for &(jobsize, overlap) in &[(0, 0), (1 << 18, 0), (1 << 20, 6), (1 << 17, 9)] {\n352\t            for &shape in &[Shape::Text, Shape::Random] {\n353\t                let size = rng.range(100000, 900000);\n354\t                let src = gen(shape, size, &mut rng);\n355\t                let ctx = format!(\n356\t                    \"mt workers={workers} job={jobsize} ovl={overlap} shape={shape:?} size={size}\"\n357\t                );\n358\t                let frame_opt = stream_compress_diff(\n359\t                    &src,\n360\t                    &[\n361\t                        (C_COMPRESSIONLEVEL, 5),\n362\t                        (C_NBWORKERS, workers),\n363\t                        (C_JOBSIZE, jobsize),\n364\t                        (C_OVERLAPLOG, overlap),\n365\t                        (C_CHECKSUMFLAG, 1),\n366\t                    ],\n367\t                    None,\n368\t                    rng.range(1000, 200000),\n369\t                    rng.range(1000, 200000),\n370\t                    &[E_CONTINUE, E_FLUSH],\n371\t                    &ctx,\n372\t                );\n373\t                let Some(frame) = frame_opt else { continue };\n374\t                stream_decompress_diff(&frame, Some(&src), &[], 16384, 16384, &ctx);\n375\t            }\n376\t        }\n377\t    }\n378\t}\n379\t\n380\t#[test]\n381\tfn cfg_old_cstream_api() {\n382\t    let (cn, rn) = unsafe { pair::<FnNew>(\"ZSTD_createCStream\") };\n383\t    let (cf, rf) = unsafe { pair::<FnFree>(\"ZSTD_freeCStream\") };\n384\t    let (ci, ri) = unsafe { pair::<FnInitCStream>(\"ZSTD_initCStream\") };\n385\t    let (cc, rc) = unsafe { pair::<FnStream>(\"ZSTD_compressStream\") };\n386\t    let (cfl, rfl) = unsafe { pair::<FnFlush>(\"ZSTD_flushStream\") };\n387\t    let (ce, re) = unsafe { pair::<FnFlush>(\"ZSTD_endStream\") };\n388\t    let (csz, rsz) = unsafe { pair::<FnCtxSize>(\"ZSTD_sizeof_CStream\") };\n389\t    let (ctf, rtf) = unsafe { pair::<FnCtxSize>(\"ZSTD_toFlushNow\") };\n390\t\n391\t    let mut rng = Rng::new(0x1234);\n392\t    let cs = unsafe { cn() };\n393\t    let ss = unsafe { rn() };\n394\t    for round in 0..12 {\n395\t        let lvl = [1, 3, 6, 11, 19][rng.below(5)];\n396\t        let shape = ALL_SHAPES[rng.below(ALL_SHAPES.len())];\n397\t        let size = rng.range(0, 150000);\n398\t        let src = gen(shape, size, &mut rng);\n399\t        let in_chunk = rng.range(1, 30000);\n400\t        let out_chunk = rng.range(1, 30000);\n401\t        let ctx = format!(\"oldCStream round={round} lvl={lvl} shape={shape:?} size={size}\");\n402\t\n403\t        let mut got: [Vec<u8>; 2] = [Vec::new(), Vec::new()];\n404\t        let mut rets: [Vec<usize>; 2] = [Vec::new(), Vec::new()];\n405\t        for which in 0..2 {\n406\t            let z = if which == 0 { cs } else { ss };\n407\t            let rc0 = if which == 0 { unsafe { ci(z, lvl) } } else { unsafe { ri(z, lvl) } };\n408\t            assert!(!is_error(rc0), \"{ctx}: initCStream\");\n409\t            rets[which].push(rc0);\n410\t            let mut input = InBuffer { src: src.as_ptr(), size: 0, pos: 0 };\n411\t            let mut outbuf = vec![0u8; out_chunk];\n412\t            let mut coll = Vec::new();\n413\t            let mut avail = 0usize;\n414\t            while avail < src.len() || input.pos < input.size {\n415\t                if input.pos == input.size && avail < src.len() {\n416\t                    avail = (avail + in_chunk).min(src.len());\n417\t                    input.size = avail;\n418\t                }\n419\t                let mut out = OutBuffer { dst: outbuf.as_mut_ptr(), size: outbuf.len(), pos: 0 };\n420\t                let rc = if which == 0 {\n421\t                    unsafe { cc(z, &mut out, &mut input) }\n422\t                } else {\n423\t                    unsafe { rc(z, &mut out, &mut input) }\n424\t                };\n425\t                rets[which].push(rc);\n426\t                assert!(!is_error(rc), \"{ctx}: compressStream err {}\", err_code(rc));\n427\t                coll.extend_from_slice(&outbuf[..out.pos]);\n428\t                let tf = if which == 0 { unsafe { ctf(z) } } else { unsafe { rtf(z) } };\n429\t                rets[which].push(tf);\n430\t            }\n431\t            // flush\n432\t            loop {\n433\t                let mut out = OutBuffer { dst: outbuf.as_mut_ptr(), size: outbuf.len(), pos: 0 };\n434\t                let rc = if which == 0 {\n435\t                    unsafe { cfl(z, &mut out) }\n436\t                } else {\n437\t                    unsafe { rfl(z, &mut out) }\n438\t                };\n439\t                rets[which].push(rc);\n440\t                assert!(!is_error(rc));\n441\t                coll.extend_from_slice(&outbuf[..out.pos]);\n442\t                if rc == 0 {\n443\t                    break;\n444\t                }\n445\t            }\n446\t            // end\n447\t            loop {\n448\t                let mut out = OutBuffer { dst: outbuf.as_mut_ptr(), size: outbuf.len(), pos: 0 };\n449\t                let rc = if which == 0 {\n450\t                    unsafe { ce(z, &mut out) }\n451\t                } else {\n452\t                    unsafe { re(z, &mut out) }\n453\t                };\n454\t                rets[which].push(rc);\n455\t                assert!(!is_error(rc));\n456\t                coll.extend_from_slice(&outbuf[..out.pos]);\n457\t                if rc == 0 {\n458\t                    break;\n459\t                }\n460\t            }\n461\t            let sz = if which == 0 { unsafe { csz(z) } } else { unsafe { rsz(z) } };\n462\t            rets[which].push(sz);\n463\t            got[which] = coll;\n464\t        }\n465\t        assert_eq!(rets[0], rets[1], \"{ctx}: old-API return sequence\");\n466\t        assert_bytes_eq(&ctx, &got[0], &got[1]);\n467\t        stream_decompress_diff(&got[0], Some(&src), &[], 4096, 4096, &ctx);\n468\t    }\n469\t    unsafe {\n470\t        cf(cs);\n471\t        rf(ss);\n472\t    }\n473\t}\n474\t\n475\t#[test]\n476\tfn cfg_old_dstream_api() {\n477\t    let (cn, rn) = unsafe { pair::<FnNew>(\"ZSTD_createDStream\") };\n478\t    let (cf, rf) = unsafe { pair::<FnFree>(\"ZSTD_freeDStream\") };\n479\t    let (ci, ri) = unsafe { pair::<FnInitDStream>(\"ZSTD_initDStream\") };\n480\t    let (cd, rd) = unsafe { pair::<FnStream>(\"ZSTD_decompressStream\") };\n481\t    let (csz, rsz) = unsafe { pair::<FnCtxSize>(\"ZSTD_sizeof_DStream\") };\n482\t    let (cbnd, _) = unsafe { pair::<FnBound>(\"ZSTD_compressBound\") };\n483\t    let (ccomp, _rcomp) = unsafe {\n484\t        pair::<unsafe extern \"C\" fn(*mut u8, usize, *const u8, usize, c_int) -> usize>(\n485\t            \"ZSTD_compress\",\n486\t        )\n487\t    };\n488\t\n489\t    let mut rng = Rng::new(0x8765);\n490\t    let cs = unsafe { cn() };\n491\t    let ss = unsafe { rn() };\n492\t    for round in 0..12 {\n493\t        let shape = ALL_SHAPES[rng.below(ALL_SHAPES.len())];\n494\t        let size = rng.range(0, 200000);\n495\t        let src = gen(shape, size, &mut rng);\n496\t        let cap = unsafe { cbnd(src.len()) } + 64;\n497\t        let mut frame = vec![0u8; cap];\n498\t        let n = unsafe {\n499\t            ccomp(frame.as_mut_ptr(), cap, src.as_ptr(), src.len(), [1, 5, 12, 19][rng.below(4)])\n500\t        };\n501\t        assert!(!is_error(n));\n502\t        frame.truncate(n);\n503\t        let in_chunk = rng.range(1, 20000);\n504\t        let out_chunk = rng.range(1, 20000);\n505\t        let ctx = format!(\"oldDStream round={round} shape={shape:?} size={size}\");\n506\t\n507\t        let mut got: [Vec<u8>; 2] = [Vec::new(), Vec::new()];\n508\t        let mut rets: [Vec<usize>; 2] = [Vec::new(), Vec::new()];\n509\t        for which in 0..2 {\n510\t            let z = if which == 0 { cs } else { ss };\n511\t            let rc0 = if which == 0 { unsafe { ci(z) } } else { unsafe { ri(z) } };\n512\t            rets[which].push(rc0);\n513\t            let mut input = InBuffer { src: frame.as_ptr(), size: 0, pos: 0 };\n514\t            let mut outbuf = vec![0u8; out_chunk];\n515\t            let mut coll = Vec::new();\n516\t            let mut avail = 0usize;\n517\t            loop {\n518\t                if avail < frame.len() {\n519\t                    avail = (avail + in_chunk).min(frame.len());\n520\t                    input.size = avail;\n521\t                }\n522\t                let mut out = OutBuffer { dst: outbuf.as_mut_ptr(), size: outbuf.len(), pos: 0 };\n523\t                let rc = if which == 0 {\n524\t                    unsafe { cd(z, &mut out, &mut input) }\n525\t                } else {\n526\t                    unsafe { rd(z, &mut out, &mut input) }\n527\t                };\n528\t                rets[which].push(rc);\n529\t                assert!(!is_error(rc), \"{ctx}: decompressStream err {}\", err_code(rc));\n530\t                coll.extend_from_slice(&outbuf[..out.pos]);\n531\t                if rc == 0 {\n532\t                    break;\n533\t                }\n534\t            }\n535\t            let sz = if which == 0 { unsafe { csz(z) } } else { unsafe { rsz(z) } };\n536\t            rets[which].push(sz);\n537\t            got[which] = coll;\n538\t        }\n539\t        assert_eq!(rets[0], rets[1], \"{ctx}: return sequence\");\n540\t        assert_bytes_eq(&ctx, &got[0], &got[1]);\n541\t        assert_bytes_eq(&format!(\"{ctx} vs orig\"), &got[0], &src);\n542\t    }\n543\t    unsafe {\n544\t        cf(cs);\n545\t        rf(ss);\n546\t    }\n547\t}\n548\t\n549\t#[test]\n550\tfn cfg_stream_decompress_multiframe_and_skippable() {\n551\t    let mut rng = Rng::new(0xAAAA);\n552\t    // build: skippable frame, data frame, skippable, data frame\n553\t    let (cw, rw) = unsafe {\n554\t        pair::<unsafe extern \"C\" fn(*mut u8, usize, *const u8, usize, u32) -> usize>(\n555\t            \"ZSTD_writeSkippableFrame\",\n556\t        )\n557\t    };\n558\t    let mut all = Vec::new();\n559\t    let mut raw = Vec::new();\n560\t    for i in 0..3u32 {\n561\t        let payload = gen(Shape::Random, rng.range(0, 100), &mut rng);\n562\t        let mut cbuf = vec![0u8; payload.len() + 16];\n563\t        let mut rbuf = vec![0u8; payload.len() + 16];\n564\t        let a = unsafe {\n565\t            cw(cbuf.as_mut_ptr(), cbuf.len(), payload.as_ptr(), payload.len(), i % 16)\n566\t        };\n567\t        let b = unsafe {\n568\t            rw(rbuf.as_mut_ptr(), rbuf.len(), payload.as_ptr(), payload.len(), i % 16)\n569\t        };\n570\t        assert_eq!(a, b, \"writeSkippableFrame\");\n571\t        assert!(!is_error(a), \"writeSkippableFrame err {}\", err_code(a));\n572\t        assert_bytes_eq(\"skippable frame bytes\", &cbuf[..a], &rbuf[..b]);\n573\t        all.extend_from_slice(&cbuf[..a]);\n574\t\