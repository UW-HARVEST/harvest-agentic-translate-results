{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_qtwmklvqz7v7izpgm36qilmprwdyts2dlen4dkfjnwwqehzfyz5q","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_012s8VsSoCdntZBcyvVRiEBX","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-wA9tGe/translation/tests/zz_isolate.rs","content":"//! temporary isolation harness\nmod common;\nuse common::*;\nuse std::ffi::{c_int, c_ulonglong, c_void};\n\ntype FnGenSeq =\n    unsafe extern \"C\" fn(*mut c_void, *mut ZSTD_Sequence, usize, *const c_void, usize) -> usize;\ntype FnMerge = unsafe extern \"C\" fn(*mut ZSTD_Sequence, usize) -> usize;\ntype FnCompressSeq = unsafe extern \"C\" fn(\n    *mut c_void,\n    *mut c_void,\n    usize,\n    *const ZSTD_Sequence,\n    usize,\n    *const c_void,\n    usize,\n) -> usize;\n\nconst PAD: usize = 1 << 16;\nconst CANARY: ZSTD_Sequence = ZSTD_Sequence {\n    offset: 0xDEAD,\n    litLength: 0xBEEF,\n    matchLength: 0xF00D,\n    rep: 0xCAFE,\n};\n\nfn one(which: usize, delim: c_int, vs: c_int, rr_: c_int, sz: usize, cls: usize, lvl: c_int) {\n    unsafe {\n        let (csc, csr) = duo::<FnCompressSeq>(\"ZSTD_compressSequences\");\n        let (gsc, gsr) = duo::<FnGenSeq>(\"ZSTD_generateSequences\");\n        let (mrgc, mrgr) = duo::<FnMerge>(\"ZSTD_mergeBlockDelimiters\");\n        let (sp_c, sp_r) = duo::<FnSetParam>(\"ZSTD_CCtx_setParameter\");\n        let (rc, rr) = duo::<FnReset>(\"ZSTD_CCtx_reset\");\n        let (bd, _) = duo::<FnSizeT1>(\"ZSTD_compressBound\");\n        let (bnd, _) = duo::<FnSizeT1>(\"ZSTD_sequenceBound\");\n        let (pl_c, pl_r) = duo::<unsafe extern \"C\" fn(*mut c_void, c_ulonglong) -> usize>(\n            \"ZSTD_CCtx_setPledgedSrcSize\",\n        );\n        let cctx = CtxPair::cctx();\n        let ctx = if which == 0 { cctx.c } else { cctx.r };\n        let cs = if which == 0 { csc } else { csr };\n        let gs = if which == 0 { gsc } else { gsr };\n        let mg = if which == 0 { mrgc } else { mrgr };\n        let sp = if which == 0 { sp_c } else { sp_r };\n        let rs = if which == 0 { rc } else { rr };\n        let pl = if which == 0 { pl_c } else { pl_r };\n\n        let src = gen_class(cls, sz, 0);\n\n        rs(ctx, ZSTD_reset_session_and_parameters);\n        sp(ctx, ZSTD_c_compressionLevel, lvl);\n        let scap = bnd(sz).max(1);\n        let mut seqs = vec![CANARY; scap + 8192];\n        let n = gs(ctx, seqs.as_mut_ptr(), scap, src.as_ptr() as *const c_void, sz);\n        assert!(!is_err(n), \"generateSequences failed {n:#x}\");\n        let mut over = 0usize;\n        for k in scap..seqs.len() {\n            if seqs[k] != CANARY {\n                over = k - scap + 1;\n            }\n        }\n        assert_eq!(\n            over, 0,\n            \"generateSequences wrote {over} entries past outSeqsCapacity (n={n}, scap={scap})\"\n        );\n        seqs.truncate(n);\n        if delim == 0 && !seqs.is_empty() {\n            let m = mg(seqs.as_mut_ptr(), seqs.len());\n            assert!(!is_err(m));\n            seqs.truncate(m);\n        }\n\n        rs(ctx, ZSTD_reset_session_and_parameters);\n        sp(ctx, ZSTD_c_compressionLevel, lvl);\n        sp(ctx, ZSTD_c_blockDelimiters, delim);\n        sp(ctx, ZSTD_c_validateSequences, vs);\n        sp(ctx, ZSTD_c_repcodeResolution, rr_);\n        pl(ctx, sz as c_ulonglong);\n        let cap = bd(sz) + 64;\n        let mut oc = vec![0xAAu8; cap + PAD];\n        let a = cs(\n            ctx,\n            oc.as_mut_ptr() as *mut c_void,\n            cap,\n            seqs.as_ptr(),\n            seqs.len(),\n            src.as_ptr() as *const c_void,\n            sz,\n        );\n        let obytes = oc[cap..].iter().rposition(|&b| b != 0xAA).map(|k| k + 1).unwrap_or(0);\n        assert_eq!(\n            obytes, 0,\n            \"compressSequences overflowed dst by {obytes} bytes (ret={a:#x} delim={delim} vs={vs} rr={rr_} sz={sz} cls={cls} lvl={lvl})\"\n        );\n    }\n}\n\n#[test]\nfn repro() {\n    for &(delim, vs, rr_) in &[(1, 1, 0), (1, 1, 1), (1, 1, 2), (0, 0, 1), (0, 1, 0)] {\n        for &sz in &[11528usize, 19584, 31677, 46715, 53996, 59352, 60915] {\n            for cls in 0..N_CLASSES {\n                for lvl in [1, 5, 12, 18] {\n                    eprintln!(\"== delim={delim} vs={vs} rr={rr_} sz={sz} cls={cls} lvl={lvl}\");\n                    one(0, delim, vs, rr_, sz, cls, lvl);\n                }\n            }\n        }\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":407,"cache_read_input_tokens":303158,"cache_creation":{"ephemeral_5m_input_tokens":407,"ephemeral_1h_input_tokens":0},"output_tokens":17,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"b0ef8e1e-2e1d-45e6-be23-c299770ecb9a","uuid":"5d91dde4-dc3b-40d6-8302-1e92a8d64509","timestamp":"2026-09-04T05:22:01.387Z"}
