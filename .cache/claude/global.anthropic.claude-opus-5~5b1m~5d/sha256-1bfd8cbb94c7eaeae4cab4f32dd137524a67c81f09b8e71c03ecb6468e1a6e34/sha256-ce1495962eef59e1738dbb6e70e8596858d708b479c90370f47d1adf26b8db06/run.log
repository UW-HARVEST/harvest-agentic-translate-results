   let mut nr = vec![0xA5A5_A5A5u32; ch.ct_u32];\n                                    let (mut oc, mut or) = twin(cap.max(1));\n                                    let mut w1 = vec![0u64; 4096];\n                                    let mut w2 = vec![0u64; 4096];\n                                    let x = bt_c(\n                                        oc.as_mut_ptr() as *mut c_void,\n                                        cap,\n                                        nc.as_mut_ptr(),\n                                        ch.fselog,\n                                        ty,\n                                        cc.as_mut_ptr(),\n                                        max,\n                                        codes.as_ptr(),\n                                        nbSeq,\n                                        ch.defnorm.as_ptr(),\n                                        ch.defnormlog,\n                                        ch.defmax,\n                                        prev_c.as_ptr(),\n                                        ch.ct_u32 * 4,\n                                        w1.as_mut_ptr() as *mut c_void,\n                                        w1.len() * 8,\n                                    );\n                                    let y = bt_r(\n                                        or.as_mut_ptr() as *mut c_void,\n                                        cap,\n                                        nr.as_mut_ptr(),\n                                        ch.fselog,\n                                        ty,\n                                        cr.as_mut_ptr(),\n                                        max,\n                                        codes.as_ptr(),\n                                        nbSeq,\n                                        ch.defnorm.as_ptr(),\n                                        ch.defnormlog,\n                                        ch.defmax,\n                                        prev_r