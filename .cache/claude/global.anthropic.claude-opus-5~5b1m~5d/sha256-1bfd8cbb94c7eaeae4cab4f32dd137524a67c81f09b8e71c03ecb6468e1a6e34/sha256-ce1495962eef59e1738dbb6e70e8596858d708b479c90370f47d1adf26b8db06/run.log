{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_013dSBHL73Lu9pS7wUAo3uiV","type":"tool_result","content":"1\t//! Shared differential-test harness.\n2\t//!\n3\t//! Loads BOTH shared libraries via `libloading`:\n4\t//!   * the reference C build  `c_src/build/libzstd.so`\n5\t//!   * the Rust build         `translation/target/release/libzstd.so`\n6\t//!\n7\t//! Every call in every test goes through `dlsym`, so the `#[no_mangle]`\n8\t//! export wrappers of the Rust crate are what is actually exercised.\n9\t#![allow(dead_code)]\n10\t#![allow(non_snake_case)]\n11\t#![allow(non_upper_case_globals)]\n12\t\n13\tuse libloading::Library;\n14\tuse std::ffi::{c_char, c_int, c_uint, c_ulonglong, c_void, CStr};\n15\tuse std::path::PathBuf;\n16\tuse std::sync::OnceLock;\n17\t\n18\t// ---------------------------------------------------------------- libraries\n19\t\n20\tfn manifest() -> PathBuf {\n21\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n22\t}\n23\t\n24\tpub fn c_so_path() -> PathBuf {\n25\t    manifest().join(\"../c_src/build/libzstd.so\")\n26\t}\n27\t\n28\tpub fn rs_so_path() -> PathBuf {\n29\t    // The cdylib under test. Built by `cargo build --release`.\n30\t    let p = manifest().join(\"target/release/libzstd.so\");\n31\t    if p.exists() {\n32\t        return p;\n33\t    }\n34\t    manifest().join(\"target/debug/libzstd.so\")\n35\t}\n36\t\n37\tstatic C_LIB: OnceLock<Library> = OnceLock::new();\n38\tstatic R_LIB: OnceLock<Library> = OnceLock::new();\n39\t\n40\tpub fn clib() -> &'static Library {\n41\t    C_LIB.get_or_init(|| {\n42\t        let p = c_so_path();\n43\t        assert!(\n44\t            p.exists(),\n45\t            \"missing C shared library {p:?} — build it with\\n  cd c_src && mkdir -p build && cd build && \\\n46\t             cmake .. -DCMAKE_POSITION_INDEPENDENT_CODE=ON && cmake --build .\"\n47\t        );\n48\t        unsafe { Library::new(&p) }.unwrap_or_else(|e| panic!(\"dlopen {p:?}: {e}\"))\n49\t    })\n50\t}\n51\t\n52\tpub fn rlib() -> &'static Library {\n53\t    R_LIB.get_or_init(|| {\n54\t        let p = rs_so_path();\n55\t        assert!(\n56\t            p.exists(),\n57\t            \"missing Rust shared library {p:?} — build it with `cargo build --release`\"\n58\t        );\n59\t        unsafe { Library::new(&p) }.unwrap_or_else(|e| panic!(\"dlopen {p:?}: {e}\"))\n60\t    })\n61\t}\n62\t\n63\t/// Resolve `name` in both libraries and return the two raw function pointers.\n64\t///\n65\t/// `T` must be a function-pointer type (`unsafe extern \"C\" fn(..) -> ..`).\n66\tpub unsafe fn duo<T: Copy>(name: &str) -> (T, T) {\n67\t    let c = *clib()\n68\t        .get::<T>(name.as_bytes())\n69\t        .unwrap_or_else(|e| panic!(\"C .so is missing `{name}`: {e}\"));\n70\t    let r = *rlib()\n71\t        .get::<T>(name.as_bytes())\n72\t        .unwrap_or_else(|e| panic!(\"Rust .so is missing `{name}`: {e}\"));\n73\t    (c, r)\n74\t}\n75\t\n76\t/// Address of a symbol in both libraries (works for data symbols of any size).\n77\tpub unsafe fn duo_addr<T>(name: &str) -> (*mut T, *mut T) {\n78\t    let c = clib()\n79\t        .get::<*mut c_void>(name.as_bytes())\n80\t        .unwrap_or_else(|e| panic!(\"C .so is missing symbol `{name}`: {e}\"));\n81\t    let r = rlib()\n82\t        .get::<*mut c_void>(name.as_bytes())\n83\t        .unwrap_or_else(|e| panic!(\"Rust .so is missing symbol `{name}`: {e}\"));\n84\t    (\n85\t        c.into_raw().into_raw() as *mut T,\n86\t        r.into_raw().into_raw() as *mut T,\n87\t    )\n88\t}\n89\t\n90\t/// Read a *data* symbol (by value) out of both libraries.\n91\tpub unsafe fn duo_value<T: Copy>(name: &str) -> (T, T) {\n92\t    let (c, r) = duo_addr::<T>(name);\n93\t    (*c, *r)\n94\t}\n95\t\n96\t// ---------------------------------------------------------------- assertions\n97\t\n98\tpub fn cstr(p: *const c_char) -> String {\n99\t    if p.is_null() {\n100\t        return \"<null>\".to_string();\n101\t    }\n102\t    unsafe { CStr::from_ptr(p) }.to_string_lossy().into_owned()\n103\t}\n104\t\n105\t#[track_caller]\n106\tpub fn eqv<T: PartialEq + std::fmt::Debug>(what: &str, c: T, r: T) {\n107\t    assert_eq!(c, r, \"return value mismatch in {what}\");\n108\t}\n109\t\n110\t#[track_caller]\n111\tpub fn eqbuf(what: &str, c: &[u8], r: &[u8]) {\n112\t    if c == r {\n113\t        return;\n114\t    }\n115\t    assert_eq!(c.len(), r.len(), \"buffer length mismatch in {what}\");\n116\t    for i in 0..c.len() {\n117\t        if c[i] != r[i] {\n118\t            panic!(\n119\t                \"buffer mismatch in {what}: first difference at byte {i} \\\n120\t                 (C=0x{:02x} Rust=0x{:02x}); len={}\",\n121\t                c[i], r[i], c.len()\n122\t            );\n123\t        }\n124\t    }\n125\t}\n126\t\n127\t// ---------------------------------------------------------------- rng / data\n128\t\n129\t/// xoshiro256** — deterministic, fixed seed per test.\n130\tpub struct Rng {\n131\t    s: [u64; 4],\n132\t}\n133\t\n134\timpl Rng {\n135\t    pub fn new(seed: u64) -> Self {\n136\t        let mut z = seed.wrapping_add(0x9E3779B97F4A7C15);\n137\t        let mut sm = || {\n138\t            z = z.wrapping_add(0x9E3779B97F4A7C15);\n139\t            let mut x = z;\n140\t            x = (x ^ (x >> 30)).wrapping_mul(0xBF58476D1CE4E5B9);\n141\t            x = (x ^ (x >> 27)).wrapping_mul(0x94D049BB133111EB);\n142\t            x ^ (x >> 31)\n143\t        };\n144\t        Rng { s: [sm(), sm(), sm(), sm()] }\n145\t    }\n146\t    pub fn next_u64(&mut self) -> u64 {\n147\t        let r = self.s[1].wrapping_mul(5).rotate_left(7).wrapping_mul(9);\n148\t        let t = self.s[1] << 17;\n149\t        self.s[2] ^= self.s[0];\n150\t        self.s[3] ^= self.s[1];\n151\t        self.s[1] ^= self.s[2];\n152\t        self.s[0] ^= self.s[3];\n153\t        self.s[2] ^= t;\n154\t        self.s[3] = self.s[3].rotate_left(45);\n155\t        r\n156\t    }\n157\t    pub fn next_u32(&mut self) -> u32 {\n158\t        (self.next_u64() >> 32) as u32\n159\t    }\n160\t    pub fn below(&mut self, n: usize) -> usize {\n161\t        if n == 0 {\n162\t            0\n163\t        } else {\n164\t            (self.next_u64() % n as u64) as usize\n165\t        }\n166\t    }\n167\t    pub fn range(&mut self, lo: i32, hi: i32) -> i32 {\n168\t        if hi <= lo {\n169\t            lo\n170\t        } else {\n171\t            lo + self.below((hi - lo + 1) as usize) as i32\n172\t        }\n173\t    }\n174\t    pub fn byte(&mut self) -> u8 {\n175\t        (self.next_u64() >> 24) as u8\n176\t    }\n177\t    pub fn bytes(&mut self, n: usize) -> Vec<u8> {\n178\t        let mut v = Vec::with_capacity(n);\n179\t        while v.len() < n {\n180\t            v.extend_from_slice(&self.next_u64().to_le_bytes());\n181\t        }\n182\t        v.truncate(n);\n183\t        v\n184\t    }\n185\t}\n186\t\n187\t/// The content classes `CONFIGS.md` enumerates.\n188\tpub const N_CLASSES: usize = 8;\n189\tpub const CLASS_NAMES: [&str; N_CLASSES] = [\n190\t    \"zeros\",\n191\t    \"single-byte-run\",\n192\t    \"two-byte-pattern\",\n193\t    \"incompressible-random\",\n194\t    \"text-like\",\n195\t    \"long-range-duplicates\",\n196\t    \"rle-runs\",\n197\t    \"already-compressed\",\n198\t];\n199\t\n200\tpub fn gen_class(class: usize, size: usize, seed: u64) -> Vec<u8> {\n201\t    let mut rng = Rng::new(seed ^ ((class as u64) << 40) ^ ((size as u64) << 8));\n202\t    match class % N_CLASSES {\n203\t        0 => vec![0u8; size],\n204\t        1 => {\n205\t            let b = rng.byte();\n206\t            vec![b; size]\n207\t        }\n208\t        2 => {\n209\t            let a = rng.byte();\n210\t            let b = rng.byte();\n211\t            (0..size).map(|i| if i % 2 == 0 { a } else { b }).collect()\n212\t        }\n213\t        3 => rng.bytes(size),\n214\t        4 => {\n215\t            // low-entropy alphabet, word-like structure\n216\t            const AL: &[u8] = b\"abcdefghijklmnopqrstuvwxyz ,.\\n\";\n217\t            let mut v = Vec::with_capacity(size);\n218\t            while v.len() < size {\n219\t                let wl = 1 + rng.below(9);\n220\t                for _ in 0..wl {\n221\t                    v.push(AL[rng.below(AL.len() - 2)]);\n222\t                    if v.len() >= size {\n223\t                        break;\n224\t                    }\n225\t                }\n226\t                if v.len() < size {\n227\t                    v.push(b' ');\n228\t                }\n229\t            }\n230\t            v.truncate(size);\n231\t            v\n232\t        }\n233\t        5 => {\n234\t            // a few distinct blocks repeated far apart: bait for LDM / long matches\n235\t            let unit = (size / 8).max(1).min(64 * 1024);\n236\t            let a = rng.bytes(unit);\n237\t            let b = rng.bytes(unit);\n238\t            let mut v = Vec::with_capacity(size);\n239\t            let mut i = 0usize;\n240\t            while v.len() < size {\n241\t                let src = if i % 3 == 2 { &b } else { &a };\n242\t                let take = src.len().min(size - v.len());\n243\t                v.extend_from_slice(&src[..take]);\n244\t                i += 1;\n245\t            }\n246\t            v\n247\t        }\n248\t        6 => {\n249\t            let mut v = Vec::with_capacity(size);\n250\t            while v.len() < size {\n251\t                let b = rng.byte();\n252\t                let n = (1 + rng.below(300)).min(size - v.len());\n253\t                v.extend(std::iter::repeat(b).take(n));\n254\t            }\n255\t            v\n256\t        }\n257\t        _ => {\n258\t            // pseudo-\"already compressed\": high entropy with occasional structure\n259\t            let mut v = rng.bytes(size);\n260\t            let mut i = 0;\n261\t            while i + 16 < size {\n262\t                let b = v[i];\n263\t                for k in 0..8 {\n264\t                    v[i + k] = b;\n265\t                }\n266\t                i += 1 + rng.below(4096);\n267\t            }\n268\t            v\n269\t        }\n270\t    }\n271\t}\n272\t\n273\t/// The input-size ladder `CONFIGS.md` enumerates (small end; large sizes are\n274\t/// used only where the row calls for them).\n275\tpub const SIZES: [usize; 13] = [\n276\t    0,\n277\t    1,\n278\t    7,\n279\t    128,\n280\t    1024,\n281\t    8 * 1024,\n282\t    64 * 1024,\n283\t    128 * 1024 - 1,\n284\t    128 * 1024,\n285\t    128 * 1024 + 1,\n286\t    200_000,\n287\t    256 * 1024,\n288\t    1024 * 1024,\n289\t];\n290\t\n291\tpub const SMALL_SIZES: [usize; 8] = [0, 1, 2, 7, 63, 128, 1024, 8 * 1024];\n292\t\n293\t// ---------------------------------------------------------------- constants\n294\t\n295\tpub const ZSTD_CONTENTSIZE_UNKNOWN: c_ulonglong = 0u64.wrapping_sub(1);\n296\tpub const ZSTD_CONTENTSIZE_ERROR: c_ulonglong = 0u64.wrapping_sub(2);\n297\t\n298\t// ZSTD_cParameter\n299\tpub const ZSTD_c_compressionLevel: c_int = 100;\n300\tpub const ZSTD_c_windowLog: c_int = 101;\n301\tpub const ZSTD_c_hashLog: c_int = 102;\n302\tpub const ZSTD_c_chainLog: c_int = 103;\n303\tpub const ZSTD_c_searchLog: c_int = 104;\n304\tpub const ZSTD_c_minMatch: c_int = 105;\n305\tpub const ZSTD_c_targetLength: c_int = 106;\n306\tpub const ZSTD_c_strategy: c_int = 107;\n307\tpub const ZSTD_c_targetCBlockSize: c_int = 130;\n308\tpub const ZSTD_c_enableLongDistanceMatching: c_int = 160;\n309\tpub const ZSTD_c_ldmHashLog: c_int = 161;\n310\tpub const ZSTD_c_ldmMinMatch: c_int = 162;\n311\tpub const ZSTD_c_ldmBucketSizeLog: c_int = 163;\n312\tpub const ZSTD_c_ldmHashRateLog: c_int = 164;\n313\tpub const ZSTD_c_contentSizeFlag: c_int = 200;\n314\tpub const ZSTD_c_checksumFlag: c_int = 201;\n315\tpub const ZSTD_c_dictIDFlag: c_int = 202;\n316\tpub const ZSTD_c_nbWorkers: c_int = 400;\n317\tpub const ZSTD_c_jobSize: c_int = 401;\n318\tpub const ZSTD_c_overlapLog: c_int = 402;\n319\t// experimental (exact enum values from zstd.h L522-541)\n320\tpub const ZSTD_c_rsyncable: c_int = 500; // experimentalParam1\n321\tpub const ZSTD_c_format: c_int = 10; // experimentalParam2\n322\tpub const ZSTD_c_forceMaxWindow: c_int = 1000; // experimentalParam3\n323\tpub const ZSTD_c_forceAttachDict: c_int = 1001; // experimentalParam4\n324\tpub const ZSTD_c_literalCompressionMode: c_int = 1002; // experimentalParam5\n325\tpub const ZSTD_c_srcSizeHint: c_int = 1004; // experimentalParam7\n326\tpub const ZSTD_c_enableDedicatedDictSearch: c_int = 1005; // experimentalParam8\n327\tpub const ZSTD_c_stableInBuffer: c_int = 1006; // experimentalParam9\n328\tpub const ZSTD_c_stableOutBuffer: c_int = 1007; // experimentalParam10\n329\tpub const ZSTD_c_blockDelimiters: c_int = 1008; // experimentalParam11\n330\tpub const ZSTD_c_validateSequences: c_int = 1009; // experimentalParam12\n331\tpub const ZSTD_c_splitAfterSequences: c_int = 1010; // experimentalParam13\n332\tpub const ZSTD_c_useRowMatchFinder: c_int = 1011; // experimentalParam14\n333\tpub const ZSTD_c_deterministicRefPrefix: c_int = 1012; // experimentalParam15\n334\tpub const ZSTD_c_prefetchCDictTables: c_int = 1013; // experimentalParam16\n335\tpub const ZSTD_c_enableSeqProducerFallback: c_int = 1014; // experimentalParam17\n336\tpub const ZSTD_c_maxBlockSize: c_int = 1015; // experimentalParam18\n337\tpub const ZSTD_c_repcodeResolution: c_int = 1016; // experimentalParam19\n338\tpub const ZSTD_c_blockSplitterLevel: c_int = 1017; // experimentalParam20\n339\t\n340\t/// Every public + experimental compression parameter, in header order.\n341\tpub const ALL_CPARAMS: &[(&str, c_int)] = &[\n342\t    (\"compressionLevel\", ZSTD_c_compressionLevel),\n343\t    (\"windowLog\", ZSTD_c_windowLog),\n344\t    (\"hashLog\", ZSTD_c_hashLog),\n345\t    (\"chainLog\", ZSTD_c_chainLog),\n346\t    (\"searchLog\", ZSTD_c_searchLog),\n347\t    (\"minMatch\", ZSTD_c_minMatch),\n348\t    (\"targetLength\", ZSTD_c_targetLength),\n349\t    (\"strategy\", ZSTD_c_strategy),\n350\t    (\"targetCBlockSize\", ZSTD_c_targetCBlockSize),\n351\t    (\"enableLongDistanceMatching\", ZSTD_c_enableLongDistanceMatching),\n352\t    (\"ldmHashLog\", ZSTD_c_ldmHashLog),\n353\t    (\"ldmMinMatch\", ZSTD_c_ldmMinMatch),\n354\t    (\"ldmBucketSizeLog\", ZSTD_c_ldmBucketSizeLog),\n355\t    (\"ldmHashRateLog\", ZSTD_c_ldmHashRateLog),\n356\t    (\"contentSizeFlag\", ZSTD_c_contentSizeFlag),\n357\t    (\"checksumFlag\", ZSTD_c_checksumFlag),\n358\t    (\"dictIDFlag\", ZSTD_c_dictIDFlag),\n359\t    (\"nbWorkers\", ZSTD_c_nbWorkers),\n360\t    (\"jobSize\", ZSTD_c_jobSize),\n361\t    (\"overlapLog\", ZSTD_c_overlapLog),\n362\t    (\"rsyncable(exp1)\", ZSTD_c_rsyncable),\n363\t    (\"format(exp2)\", ZSTD_c_format),\n364\t    (\"forceMaxWindow(exp3)\", ZSTD_c_forceMaxWindow),\n365\t    (\"forceAttachDict(exp4)\", ZSTD_c_forceAttachDict),\n366\t    (\"literalCompressionMode(exp5)\", ZSTD_c_literalCompressionMode),\n367\t    (\"srcSizeHint(exp7)\", ZSTD_c_srcSizeHint),\n368\t    (\"enableDedicatedDictSearch(exp8)\", ZSTD_c_enableDedicatedDictSearch),\n369\t    (\"stableInBuffer(exp9)\", ZSTD_c_stableInBuffer),\n370\t    (\"stableOutBuffer(exp10)\", ZSTD_c_stableOutBuffer),\n371\t    (\"blockDelimiters(exp11)\", ZSTD_c_blockDelimiters),\n372\t    (\"validateSequences(exp12)\", ZSTD_c_validateSequences),\n373\t    (\"splitAfterSequences(exp13)\", ZSTD_c_splitAfterSequences),\n374\t    (\"useRowMatchFinder(exp14)\", ZSTD_c_useRowMatchFinder),\n375\t    (\"deterministicRefPrefix(exp15)\", ZSTD_c_deterministicRefPrefix),\n376\t    (\"prefetchCDictTables(exp16)\", ZSTD_c_prefetchCDictTables),\n377\t    (\"enableSeqProducerFallback(exp17)\", ZSTD_c_enableSeqProducerFallback),\n378\t    (\"maxBlockSize(exp18)\", ZSTD_c_maxBlockSize),\n379\t    (\"repcodeResolution(exp19)\", ZSTD_c_repcodeResolution),\n380\t    (\"blockSplitterLevel(exp20)\", ZSTD_c_blockSplitterLevel),\n381\t];\n382\t\n383\t// ZSTD_dParameter\n384\tpub const ZSTD_d_windowLogMax: c_int = 100;\n385\tpub const ZSTD_d_format: c_int = 1000;\n386\tpub const ZSTD_d_stableOutBuffer: c_int = 1001;\n387\tpub const ZSTD_d_forceIgnoreChecksum: c_int = 1002;\n388\tpub const ZSTD_d_refMultipleDDicts: c_int = 1003;\n389\tpub const ZSTD_d_disableHuffmanAssembly: c_int = 1004;\n390\tpub const ZSTD_d_maxBlockSize: c_int = 1005;\n391\t\n392\tpub const ALL_DPARAMS: &[(&str, c_int)] = &[\n393\t    (\"windowLogMax\", 100),\n394\t    (\"format(exp1)\", 1000),\n395\t    (\"stableOutBuffer(exp2)\", 1001),\n396\t    (\"forceIgnoreChecksum(exp3)\", 1002),\n397\t    (\"refMultipleDDicts(exp4)\", 1003),\n398\t    (\"disableHuffmanAssembly(exp5)\", 1004),\n399\t    (\"maxBlockSize(exp6)\", 1005),\n400\t];\n401\t\n402\t// ZSTD_ResetDirective\n403\tpub const ZSTD_reset_session_only: c_int = 1;\n404\tpub const ZSTD_reset_parameters: c_int = 2;\n405\tpub const ZSTD_reset_session_and_parameters: c_int = 3;\n406\t\n407\t// ZSTD_EndDirective\n408\tpub const ZSTD_e_continue: c_int = 0;\n409\tpub const ZSTD_e_flush: c_int = 1;\n410\tpub const ZSTD_e_end: c_int = 2;\n411\t\n412\t// ZSTD_strategy\n413\tpub const ZSTD_fast: c_int = 1;\n414\tpub const ZSTD_btultra2: c_int = 9;\n415\tpub const ALL_STRATEGIES: [c_int; 9] = [1, 2, 3, 4, 5, 6, 7, 8, 9];\n416\t\n417\t// ZSTD_dictLoadMethod_e / ZSTD_dictContentType_e\n418\tpub const ZSTD_dlm_byCopy: c_int = 0;\n419\tpub const ZSTD_dlm_byRef: c_int = 1;\n420\tpub const ZSTD_dct_auto: c_int = 0;\n421\tpub const ZSTD_dct_rawContent: c_int = 1;\n422\tpub const ZSTD_dct_fullDict: c_int = 2;\n423\t\n424\t// ZSTD_ParamSwitch_e\n425\tpub const ZSTD_ps_auto: c_int = 0;\n426\tpub const ZSTD_ps_enable: c_int = 1;\n427\tpub const ZSTD_ps_disable: c_int = 2;\n428\t\n429\tpub const ZSTD_MAGICNUMBER: u32 = 0xFD2FB528;\n430\tpub const ZSTD_MAGIC_DICTIONARY: u32 = 0xEC30A437;\n431\tpub const ZSTD_MAGIC_SKIPPABLE_START: u32 = 0x184D2A50;\n432\tpub const ZSTD_BLOCKSIZE_MAX: usize = 128 * 1024;\n433\t\n434\tpub const LEGACY_MAGICS: [u32; 7] = [\n435\t    0x1EA92542, // v0.1\n436\t    0xFD2FB522, // v0.2\n437\t    0xFD2FB523, // v0.3\n438\t    0xFD2FB524, // v0.4\n439\t    0xFD2FB525, // v0.5\n440\t    0xFD2FB526, // v0.6\n441\t    0xFD2FB527, // v0.7\n442\t];\n443\t\n444\t// ---------------------------------------------------------------- structs\n445\t\n446\t#[repr(C)]\n447\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n448\tpub struct ZSTD_bounds {\n449\t    pub error: usize,\n450\t    pub lowerBound: c_int,\n451\t    pub upperBound: c_int,\n452\t}\n453\t\n454\t#[repr(C)]\n455\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n456\tpub struct ZSTD_compressionParameters {\n457\t    pub windowLog: c_uint,\n458\t    pub chainLog: c_uint,\n459\t    pub hashLog: c_uint,\n460\t    pub searchLog: c_uint,\n461\t    pub minMatch: c_uint,\n462\t    pub targetLength: c_uint,\n463\t    pub strategy: c_uint,\n464\t}\n465\t\n466\t#[repr(C)]\n467\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n468\tpub struct ZSTD_frameParameters {\n469\t    pub contentSizeFlag: c_int,\n470\t    pub checksumFlag: c_int,\n471\t    pub noDictIDFlag: c_int,\n472\t}\n473\t\n474\t#[repr(C)]\n475\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n476\tpub struct ZSTD_parameters {\n477\t    pub cParams: ZSTD_compressionParameters,\n478\t    pub fParams: ZSTD_frameParameters,\n479\t}\n480\t\n481\t#[repr(C)]\n482\t#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n483\tpub struct ZSTD_inBuffer {\n484\t    pub src: *const c_void,\n485\t    pub size: usize,\n486\t    pub pos: usize,\n487\t}\n488\t\n489\t#[repr(C)]\n490\t#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n491\tpub struct ZSTD_outBuffer {\n492\t    pub dst: *mut c_void,\n493\t    pub size: usize,\n494\t    pub pos: usize,\n495\t}\n496\t\n497\t#[repr(C)]\n498\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n499\tpub struct ZSTD_frameHeader {\n500\t    pub frameContentSize: c_ulonglong,\n501\t    pub windowSize: c_ulonglong,\n502\t    pub blockSizeMax: c_uint,\n503\t    pub frameType: c_uint,\n504\t    pub headerSize: c_uint,\n505\t    pub dictID: c_uint,\n506\t    pub checksumFlag: c_uint,\n507\t    pub _reserved1: c_uint,\n508\t    pub _reserved2: c_uint,\n509\t}\n510\t\n511\t#[repr(C)]\n512\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n513\tpub struct ZSTD_frameProgression {\n514\t    pub ingested: c_ulonglong,\n515\t    pub consumed: c_ulonglong,\n516\t    pub produced: c_ulonglong,\n517\t    pub flushed: c_ulonglong,\n518\t    pub currentJobID: c_uint,\n519\t    pub nbActiveWorkers: c_uint,\n520\t}\n521\t\n522\t#[repr(C)]\n523\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n524\tpub struct ZSTD_Sequence {\n525\t    pub offset: c_uint,\n526\t    pub litLength: c_uint,\n527\t    pub matchLength: c_uint,\n528\t    pub rep: c_uint,\n529\t}\n530\t\n531\t#[repr(C)]\n532\t#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n533\tpub struct ZSTD_customMem {\n534\t    pub customAlloc: Option<unsafe extern \"C\" fn(*mut c_void, usize) -> *mut c_void>,\n535\t    pub customFree: Option<unsafe extern \"C\" fn(*mut c_void, *mut c_void)>,\n536\t    pub opaque: *mut c_void,\n537\t}\n538\t\n539\timpl Default for ZSTD_customMem {\n540\t    fn default() -> Self {\n541\t        ZSTD_customMem { customAlloc: None, customFree: None, opaque: std::ptr::null_mut() }\n542\t    }\n543\t}\n544\t\n545\t// ---------------------------------------------------------------- fn types\n546\t\n547\tpub type FnSizeT0 = unsafe extern \"C\" fn() -> usize;\n548\tpub type FnUint0 = unsafe extern \"C\" fn() -> c_uint;\n549\tpub type FnInt0 = unsafe extern \"C\" fn() -> c_int;\n550\tpub type FnPtr0 = unsafe extern \"C\" fn() -> *mut c_void;\n551\tpub type FnFreePtr = unsafe extern \"C\" fn(*mut c_void) -> usize;\n552\tpub type FnSizeT1 = unsafe extern \"C\" fn(usize) -> usize;\n553\tpub type FnIsError = unsafe extern \"C\" fn(usize) -> c_uint;\n554\tpub type FnErrName = unsafe extern \"C\" fn(usize) -> *const c_char;\n555\t\n556\tpub type FnCompress =\n557\t    unsafe extern \"C\" fn(*mut c_void, usize, *const c_void, usize, c_int) -> usize;\n558\tpub type FnDecompress = unsafe extern \"C\" fn(*mut c_void, usize, *const c_void, usize) -> usize;\n559\tpub type FnCompressCCtx =\n560\t    unsafe extern \"C\" fn(*mut c_void, *mut c_void, usize, *const c_void, usize, c_int) -> usize;\n561\tpub type FnDecompressDCtx =\n562\t    unsafe extern \"C\" fn(*mut c_void, *mut c_void, usize, *const c_void, usize) -> usize;\n563\t\n564\tpub type FnSetParam = unsafe extern \"C\" fn(*mut c_void, c_int, c_int) -> usize;\n565\tpub type FnGetParam = unsafe extern \"C\" fn(*mut c_void, c_int, *mut c_int) -> usize;\n566\tpub type FnReset = unsafe extern \"C\" fn(*mut c_void, c_int) -> usize;\n567\tpub type FnStream2 =\n568\t    unsafe extern \"C\" fn(*mut c_void, *mut ZSTD_outBuffer, *mut ZSTD_inBuffer, c_int) -> usize;\n569\tpub type FnDStream = unsafe extern \"C\" fn(*mut c_void, *mut ZSTD_outBuffer, *mut ZSTD_inBuffer) -> usize;\n570\tpub type FnGetBounds = unsafe extern \"C\" fn(c_int) -> ZSTD_bounds;\n571\t\n572\t// ---------------------------------------------------------------- helpers\n573\t\n574\t/// A pair of contexts (one per library) created/destroyed together.\n575\tpub struct CtxPair {\n576\t    pub c: *mut c_void,\n577\t    pub r: *mut c_void,\n578\t    free_c: FnFreePtr,\n579\t    free_r: FnFreePtr,\n580\t}\n581\t\n582\timpl CtxPair {\n583\t    pub unsafe fn new(create: &str, free: &str) -> CtxPair {\n584\t        let (cc, cr) = duo::<FnPtr0>(create);\n585\t        let (fc, fr) = duo::<FnFreePtr>(free);\n586\t        let c = cc();\n587\t        let r = cr();\n588\t        assert!(!c.is_null(), \"{create} returned NULL in C\");\n589\t        assert!(!r.is_null(), \"{create} returned NULL in Rust\");\n590\t        CtxPair { c, r, free_c: fc, free_r: fr }\n591\t    }\n592\t    pub unsafe fn cctx() -> CtxPair {\n593\t        CtxPair::new(\"ZSTD_createCCtx\", \"ZSTD_freeCCtx\")\n594\t    }\n595\t    pub unsafe fn dctx() -> CtxPair {\n596\t        CtxPair::new(\"ZSTD_createDCtx\", \"ZSTD_freeDCtx\")\n597\t    }\n598\t    pub unsafe fn cstream() -> CtxPair {\n599\t        CtxPair::new(\"ZSTD_createCStream\", \"ZSTD_freeCStream\")\n600\t    }\n601\t    pub unsafe fn dstream() -> CtxPair {\n602\t        CtxPair::new(\"ZSTD_createDStream\", \"ZSTD_freeDStream\")\n603\t    }\n604\t    pub unsafe fn cctx_params() -> CtxPair {\n605\t        CtxPair::new(\"ZSTD_createCCtxParams\", \"ZSTD_freeCCtxParams\")\n606\t    }\n607\t}\n608\t\n609\timpl Drop for CtxPair {\n610\t    fn drop(&mut self) {\n611\t        unsafe {\n612\t            if !self.c.is_null() {\n613\t                (self.free_c)(self.c);\n614\t            }\n615\t            if !self.r.is_null() {\n616\t                (self.free_r)(self.r);\n617\t            }\n618\t        }\n619\t    }\n620\t}\n621\t\n622\t/// Run `f` against both libraries' function pointers and compare the returned\n623\t/// `usize` plus the destination buffer contents.\n624\t///\n625\t/// `f(fnptr, dst) -> ret`\n626\t#[track_caller]\n627\tpub unsafe fn diff_call<T: Copy, F>(what: &str, name: &str, dstlen: usize, mut f: F)\n628\twhere\n629\t    F: FnMut(T, &mut [u8]) -> usize,\n630\t{\n631\t    let (fc, fr) = duo::<T>(name);\n632\t    let mut dc = vec![0xA5u8; dstlen];\n633\t    let mut dr = vec![0xA5u8; dstlen];\n634\t    let rc = f(fc, &mut dc);\n635\t    let rr = f(fr, &mut dr);\n636\t    eqv(&format!(\"{what} [{name}] return\"), rc, rr);\n637\t    eqbuf(&format!(\"{what} [{name}] dst\"), &dc, &dr);\n638\t}\n639\t\n640\t/// Compress `src` with the C library at `level`; panics on error.\n641\tpub unsafe fn c_compress(src: &[u8], level: c_int) -> Vec<u8> {\n642\t    let (bound, _) = duo::<FnSizeT1>(\"ZSTD_compressBound\");\n643\t    let (comp, _) = duo::<FnCompress>(\"ZSTD_compress\");\n644\t    let (iserr, _) = duo::<FnIsError>(\"ZSTD_isError\");\n645\t    let cap = bound(src.len());\n646\t    let mut dst = vec![0u8; cap.max(64)];\n647\t    let n = comp(\n648\t        dst.as_mut_ptr() as *mut c_void,\n649\t        dst.len(),\n650\t        src.as_ptr() as *const c_void,\n651\t        src.len(),\n652\t        level,\n653\t    );\n654\t    assert_eq!(iserr(n), 0, \"helper c_compress failed\");\n655\t    dst.truncate(n);\n656\t    dst\n657\t}\n658\t\n659\tpub fn is_err(n: usize) -> bool {\n660\t    n > usize::MAX - 130\n661\t}\n662\t"}]},"parent_tool_use_id":"toolu_bdrk_01GsrJW4SDePc8qy5zJVbJm3","session_id":"b0ef8e1e-2e1d-45e6-be23-c299770ecb9a","uuid":"abdfd679-9f81-47c0-92d8-7cdeb8356c10","timestamp":"2026-09-04T05:38:00.898Z","subagent_type":"general-purpose","task_description":"Phase C entropy error tests"}
