;  /* 200..255 */\n    unsigned total=0; int ok=1;\n    for(unsigned i=0;i<oSize;i++){\n      unsigned w;\n      /* bias toward small weights */\n      unsigned r=(unsigned)(nx()%100);\n      if(r<30) w=1; else if(r<55) w=2; else if(r<72) w=3; else if(r<84) w=4;\n      else if(r<92) w=5; else if(r<97) w=6; else w=(6+(nx()%(K>6?K-5:1)));\n      if(w>12) w=12;\n      wt[i]=(unsigned char)w; total += 1u<<(w-1);\n      if(total>4000){ ok=0; break; }\n    }\n    if(!ok) continue;\n    if(total<2048) continue;\n    /* need rest = 4096-total to be a power of two: adjust last symbol */\n    unsigned rest = 4096-total;\n    unsigned p=1; while(p<rest) p<<=1;\n    if(p!=rest){\n      /* reduce total so that rest becomes p (the next pow2 >= rest) : total' = 4096-p */\n      unsigned need = total - (4096-p);  /* must subtract this much */\n      /* try to shrink one symbol */\n      int done=0;\n      for(unsigned i=0;i<oSize && !done;i++){\n        unsigned v=1u<<(wt[i]-1);\n        if(v>need){ unsigned nv=v-need; unsigned k=0; while((1u<<k)<nv)k++;\n          if((1u<<k)==nv && k+1>=1 && k+1<=12){ wt[i]=(unsigned char)(k+1); total-=need; done=1; } }\n      }\n      if(!done) continue;\n      rest = 4096-total;\n      if(rest==0) continue;\n      p=1; while(p<rest) p<<=1; if(p!=rest) continue;\n    }\n    /* rankStats[1] must be >=2 and even, counting the implied last weight */\n    { unsigned k=0; while((1u<<k)<rest) k++; unsigned lastW=k+1;\n      unsigned r1=0; for(unsigned i=0;i<oSize;i++) if(wt[i]==1) r1++;\n      if(lastW==1) r1++;\n      if(r1<2 || (r1&1)) continue; }\n    /* FSE-encode the weights */\n    { unsigned msv=255; memset(cnt,0,sizeof(cnt));\n      size_t mx=f_h(cnt,&msv,wt,oSize,hw,sizeof(hw));\n      if(ie(mx)||msv<1||mx==oSize) continue;\n      unsigned tl=f_o(6,oSize,msv);\n      size_t r=f_n(nrm,tl,cnt,oSize,msv,0);\n      if(ie(r)||r==0) continue;\n      tl=(unsigned)r;\n      size_t hdr=f_w(desc+1,sizeof(desc)-1,nrm,msv,tl);\n      if(ie(hdr)) continue;