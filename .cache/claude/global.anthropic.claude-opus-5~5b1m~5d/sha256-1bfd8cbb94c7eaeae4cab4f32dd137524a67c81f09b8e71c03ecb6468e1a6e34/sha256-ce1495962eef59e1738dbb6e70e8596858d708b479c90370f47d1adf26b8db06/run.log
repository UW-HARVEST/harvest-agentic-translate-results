ew2 = '''                    if card < 2 || real_msv == 0 {\n                        continue; // RLE territory; HUF_buildTree needs >=1 symbol\n                    }\n                    let min_tl = mt_c(card);\n                    for &tl in &[0u32, 5, 8, 11, 12] {\n                        // see row136: tableLog < HUF_minTableLog(cardinality) is\n                        // an impossible target for HUF_setMaxHeight() in C.\n                        if tl != 0 && tl < min_tl {\n                            continue;\n                        }'''\nassert old2 in s\ns = s.replace(old2, new2, 1)\nopen(p,'w').write(s)\nprint(\"ok\")\nPY\nTRACE=1 timeout 900 cargo test --offline --release --test phase_b_entropy row136 -- --test-threads=1 --nocapture 2>&1 | tail -8","uuid":"92717d94-3f3b-4a90-b392-96f644ba1841","session_id":"b0ef8e1e-2e1d-45e6-be23-c299770ecb9a"}
