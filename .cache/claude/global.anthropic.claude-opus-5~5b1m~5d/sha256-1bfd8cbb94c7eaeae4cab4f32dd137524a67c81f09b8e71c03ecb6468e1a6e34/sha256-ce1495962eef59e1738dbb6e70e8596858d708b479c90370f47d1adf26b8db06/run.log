&[16u32, 50, 200, 1024] {\\n            for &d in &[6u32, 8] {\\n                for &nb_threads in &[0u32, 1] {\\n                    for &shrink in &[0u32, 1] {\",\n    \"        for &k in &[6u32, 16, 32, 50, 100, 200, 512, 1024, 2048] {\\n            for &d in &[6u32, 8] {\\n                for &nb_threads in &[0u32, 1] {\\n                    for &shrink in &[0u32, 1] {\")\nrep(\"        for &level in &[0i32, 1, 3, 9, 19] {\\n            for &dict_id in &[0u32, 1, 32767, 32768, 0x7FFF_FFFF, 0xFFFF_FFFF] {\\n                let co = Corpus::uniform(4, 40, 400, 0x1481);\",\n    \"        for &level in &[0i32, 1, 3, 9, 19, 22, -1, -5] {\\n            for &dict_id in &[0u32, 1, 32767, 32768, 0x7FFF_FFFF, 0xFFFF_FFFF] {\\n                let co = Corpus::uniform(4, 40, 400, 0x1481);\")\nrep(\"\"\"        for &cap in &CAPS {\n            for class in 0..N_CLASSES {\n                let co = Corpus::uniform(class, 48, 300, 0x1482 + class as u64);\n                let p = ZDICT_cover_params_t {\n                    k: 64,\n                    d: 6,\n                    steps: 4,\n                    nbThreads: 1,\n                    splitPoint: 1.0,\n                    shrinkDict: 0,\n                    shrinkDictMaxRegression: 0,\n                    zParams: zparams(3, 0),\n                };\n                let what = format!(\"row148 cap={cap} class={}\", CLASS_NAMES[class]);\n                if !is_err(diff_train_p(&what, f, cap, &co, p)) {\n                    ok += 1;\n                }\n            }\n        }\n\n        // nbSamples {1,4,32,256}\n        for &(nb, size) in &[(1usize, 4096usize), (4, 1024), (32, 512), (256, 128)] {\"\"\",\n\"\"\"        for &cap in &CAPS {\n            for class in 0..N_CLASSES {\n                for &reg in &[0u32, 1, 5, 50, 100] {\n                    let co = Corpus::uniform(class, 48, 300, 0x1482 + class as u64);\n                    let p = ZDICT_cover_params_t {\n                        k: 64,\n                       