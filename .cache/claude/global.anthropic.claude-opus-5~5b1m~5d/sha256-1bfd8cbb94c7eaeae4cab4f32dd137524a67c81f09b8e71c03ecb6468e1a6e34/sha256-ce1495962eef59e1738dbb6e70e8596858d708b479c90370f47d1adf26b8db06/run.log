{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_012F9zKpiHLExkFGdATpJsBg","type":"tool_result","content":"1\t//! Phase B — CONFIGS.md rows 31..64: the `ZSTD_CCtx` parameter cross-product\n2\t//! and the `ZSTD_CCtx_params` object.\n3\tmod common;\n4\tuse common::*;\n5\tuse std::ffi::{c_int, c_uint, c_ulonglong, c_void};\n6\t\n7\ttype FnCompress2 = unsafe extern \"C\" fn(*mut c_void, *mut c_void, usize, *const c_void, usize) -> usize;\n8\ttype FnPledged = unsafe extern \"C\" fn(*mut c_void, c_ulonglong) -> usize;\n9\ttype FnCParamsFrom = unsafe extern \"C\" fn(\n10\t    *const c_void,\n11\t    u64,\n12\t    usize,\n13\t    c_int,\n14\t) -> ZSTD_compressionParameters;\n15\t\n16\t/// One (C, Rust) pair of CCtx driven with the same parameter script, then the\n17\t/// same input; the compressed frame must be byte identical and must decode.\n18\tstruct Rig {\n19\t    cctx: CtxPair,\n20\t    dctx: CtxPair,\n21\t    set: (FnSetParam, FnSetParam),\n22\t    get: (FnGetParam, FnGetParam),\n23\t    reset: (FnReset, FnReset),\n24\t    c2: (FnCompress2, FnCompress2),\n25\t    dec: (FnDecompressDCtx, FnDecompressDCtx),\n26\t    bound: FnSizeT1,\n27\t    pledged: (FnPledged, FnPledged),\n28\t}\n29\t\n30\timpl Rig {\n31\t    unsafe fn new() -> Rig {\n32\t        Rig {\n33\t            cctx: CtxPair::cctx(),\n34\t            dctx: CtxPair::dctx(),\n35\t            set: duo::<FnSetParam>(\"ZSTD_CCtx_setParameter\"),\n36\t            get: duo::<FnGetParam>(\"ZSTD_CCtx_getParameter\"),\n37\t            reset: duo::<FnReset>(\"ZSTD_CCtx_reset\"),\n38\t            c2: duo::<FnCompress2>(\"ZSTD_compress2\"),\n39\t            dec: duo::<FnDecompressDCtx>(\"ZSTD_decompressDCtx\"),\n40\t            bound: duo::<FnSizeT1>(\"ZSTD_compressBound\").0,\n41\t            pledged: duo::<FnPledged>(\"ZSTD_CCtx_setPledgedSrcSize\"),\n42\t        }\n43\t    }\n44\t    #[track_caller]\n45\t    unsafe fn reset_all(&self) {\n46\t        let a = (self.reset.0)(self.cctx.c, ZSTD_reset_session_and_parameters);\n47\t        let b = (self.reset.1)(self.cctx.r, ZSTD_reset_session_and_parameters);\n48\t        eqv(\"CCtx_reset(session_and_parameters)\", a, b);\n49\t    }\n50\t    /// set the parameter in both, compare the status, then read it back and\n51\t    /// compare the effective value.\n52\t    #[track_caller]\n53\t    unsafe fn set_param(&self, what: &str, p: c_int, v: c_int) -> bool {\n54\t        let a = (self.set.0)(self.cctx.c, p, v);\n55\t        let b = (self.set.1)(self.cctx.r, p, v);\n56\t        eqv(&format!(\"{what} setParameter({p},{v})\"), a, b);\n57\t        let mut xc: c_int = -12345;\n58\t        let mut xr: c_int = -12345;\n59\t        let ga = (self.get.0)(self.cctx.c, p, &mut xc);\n60\t        let gb = (self.get.1)(self.cctx.r, p, &mut xr);\n61\t        eqv(&format!(\"{what} getParameter({p}) status\"), ga, gb);\n62\t        eqv(&format!(\"{what} getParameter({p}) value\"), xc, xr);\n63\t        !is_err(a)\n64\t    }\n65\t    #[track_caller]\n66\t    unsafe fn compress_and_check(&self, what: &str, src: &[u8], expect_ok: bool) {\n67\t        let cap = (self.bound)(src.len()) + 64;\n68\t        let mut oc = vec![0x5Au8; cap];\n69\t        let mut or_ = vec![0x5Au8; cap];\n70\t        let a = (self.c2.0)(\n71\t            self.cctx.c,\n72\t            oc.as_mut_ptr() as *mut c_void,\n73\t            cap,\n74\t            src.as_ptr() as *const c_void,\n75\t            src.len(),\n76\t        );\n77\t        let b = (self.c2.1)(\n78\t            self.cctx.r,\n79\t            or_.as_mut_ptr() as *mut c_void,\n80\t            cap,\n81\t            src.as_ptr() as *const c_void,\n82\t            src.len(),\n83\t        );\n84\t        eqv(&format!(\"{what} compress2 ret\"), a, b);\n85\t        eqbuf(&format!(\"{what} compress2 dst\"), &oc, &or_);\n86\t        if is_err(a) {\n87\t            assert!(!expect_ok, \"{what}: unexpected compression error\");\n88\t            return;\n89\t        }\n90\t        let mut pc = vec![0xA5u8; src.len() + 16];\n91\t        let mut pr = vec![0xA5u8; src.len() + 16];\n92\t        let x = (self.dec.0)(\n93\t            self.dctx.c,\n94\t            pc.as_mut_ptr() as *mut c_void,\n95\t            pc.len(),\n96\t            oc.as_ptr() as *const c_void,\n97\t            a,\n98\t        );\n99\t        let y = (self.dec.1)(\n100\t            self.dctx.r,\n101\t            pr.as_mut_ptr() as *mut c_void,\n102\t            pr.len(),\n103\t            or_.as_ptr() as *const c_void,\n104\t            b,\n105\t        );\n106\t        eqv(&format!(\"{what} decompressDCtx ret\"), x, y);\n107\t        eqbuf(&format!(\"{what} decompressDCtx dst\"), &pc, &pr);\n108\t    }\n109\t}\n110\t\n111\tfn bounds_of(p: c_int) -> (c_int, c_int, bool) {\n112\t    unsafe {\n113\t        let (gb, _) = duo::<FnGetBounds>(\"ZSTD_cParam_getBounds\");\n114\t        let b = gb(p);\n115\t        (b.lowerBound, b.upperBound, !is_err(b.error))\n116\t    }\n117\t}\n118\t\n119\t// ------------------------------------------------------------------ row 31\n120\t\n121\t#[test]\n122\tfn row31_every_param_every_boundary() {\n123\t    unsafe {\n124\t        let rig = Rig::new();\n125\t        for (name, p) in ALL_CPARAMS {\n126\t            let (lo, hi, ok) = bounds_of(*p);\n127\t            assert!(ok, \"{name} has no bounds\");\n128\t            let mid = lo.wrapping_add(hi.wrapping_sub(lo) / 2);\n129\t            let mut vals: Vec<c_int> = vec![\n130\t                lo,\n131\t                lo.saturating_add(1),\n132\t                mid,\n133\t                hi.saturating_sub(1),\n134\t                hi,\n135\t                0,\n136\t                1,\n137\t                -1,\n138\t            ];\n139\t            // one step past each end, plus extremes: also checked in Phase C\n140\t            vals.push(lo.saturating_sub(1));\n141\t            vals.push(hi.saturating_add(1));\n142\t            let mut rng = Rng::new(31 ^ (*p as u64));\n143\t            for _ in 0..12 {\n144\t                vals.push(rng.range(lo.max(i32::MIN / 2), hi.min(i32::MAX / 2)));\n145\t            }\n146\t            for v in vals {\n147\t                rig.reset_all();\n148\t                rig.set_param(&format!(\"row31 {name}\"), *p, v);\n149\t            }\n150\t        }\n151\t    }\n152\t}\n153\t\n154\t// ------------------------------------------------------------------ rows 32-35\n155\t\n156\t#[test]\n157\tfn row32_strategy_minmatch_windowlog() {\n158\t    unsafe {\n159\t        let rig = Rig::new();\n160\t        let mut rng = Rng::new(32);\n161\t        for st in ALL_STRATEGIES {\n162\t            for mm in 3..=7 {\n163\t                for wl in [10, 12, 17, 20, 23] {\n164\t                    rig.reset_all();\n165\t                    rig.set_param(\"row32\", ZSTD_c_strategy, st);\n166\t                    rig.set_param(\"row32\", ZSTD_c_minMatch, mm);\n167\t                    rig.set_param(\"row32\", ZSTD_c_windowLog, wl);\n168\t                    let cls = rng.below(N_CLASSES);\n169\t                    let sz = [0usize, 1, 300, 5000, 40_000, 140_000][rng.below(6)];\n170\t                    let src = gen_class(cls, sz, rng.next_u64());\n171\t                    rig.compress_and_check(\n172\t                        &format!(\"row32 st={st} mm={mm} wl={wl} cls={cls} sz={sz}\"),\n173\t                        &src,\n174\t                        true,\n175\t                    );\n176\t                }\n177\t            }\n178\t        }\n179\t    }\n180\t}\n181\t\n182\t#[test]\n183\tfn row33_strategy_rowmatchfinder() {\n184\t    unsafe {\n185\t        let rig = Rig::new();\n186\t        let mut rng = Rng::new(33);\n187\t        for st in ALL_STRATEGIES {\n188\t            for rmf in [ZSTD_ps_auto, ZSTD_ps_enable, ZSTD_ps_disable] {\n189\t                for i in 0..6 {\n190\t                    rig.reset_all();\n191\t                    rig.set_param(\"row33\", ZSTD_c_strategy, st);\n192\t                    rig.set_param(\"row33\", ZSTD_c_useRowMatchFinder, rmf);\n193\t                    let cls = rng.below(N_CLASSES);\n194\t                    let sz = [7usize, 1000, 30_000, 150_000][rng.below(4)];\n195\t                    let src = gen_class(cls, sz, rng.next_u64());\n196\t                    rig.compress_and_check(\n197\t                        &format!(\"row33 st={st} rmf={rmf} i={i} cls={cls} sz={sz}\"),\n198\t                        &src,\n199\t                        true,\n200\t                    );"}]},"parent_tool_use_id":"toolu_bdrk_011dwFgnZ4wc3rtYdejgSN3w","session_id":"b0ef8e1e-2e1d-45e6-be23-c299770ecb9a","uuid":"a3a18326-8af5-4dc6-8d07-f981633fac15","timestamp":"2026-09-04T05:12:16.426Z","subagent_type":"general-purpose","task_description":"Phase B dict tests"}
