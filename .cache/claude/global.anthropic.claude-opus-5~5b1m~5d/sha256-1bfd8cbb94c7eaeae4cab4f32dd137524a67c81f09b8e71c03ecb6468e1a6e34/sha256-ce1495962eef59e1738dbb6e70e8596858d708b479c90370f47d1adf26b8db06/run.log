{"type":"system","subtype":"task_notification","task_id":"bruv6r491","tool_use_id":"toolu_bdrk_01H3p8oanAaNjWYQzy2sDc3a","status":"completed","output_file":"","summary":"cd /local/home/scheschb/.harvest/work/harvest-work-wA9tGe/translation && python3 - <<'PYEOF'\np='tests/phase_c_entropy.rs'\ns=open(p).read()\n\n# ---- fix row 69: only alphabets of size 2^k give a uniform weight table\nold = \"\"\"        for msv in [129u32, 150, 200, 255] {\n            let (flat, ftl) = c_ctable(msv, 8, true, 0x9002);\n            let r = diff_write_ctable(\n                &format!(\"flat msv={msv}\"),\n                4096,\n                &flat,\n                msv,\n                ftl,\n                HUF_CTABLE_WORKSPACE_SIZE,\n                0,\n            );\n            assert_code(\"HUF_writeCTable_wksp msv>128 raw fallback\", r, E_GENERIC);\n        }\"\"\"\nnew = \"\"\"        // Only a power-of-two alphabet yields a *uniform* code length for every\n        // symbol, which is what makes HUF_compressWeights report \"rle\" (1).\n        for msv in [255u32] {\n            let (flat, ftl) = c_ctable(msv, 8, true, 0x9002);\n            let r = diff_write_ctable(\n                &format!(\"flat msv={msv}\"),\n                4096,\n                &flat,\n                msv,\n                ftl,\n                HUF_CTABLE_WORKSPACE_SIZE,\n                0,\n            );\n            assert_code(\"HUF_writeCTable_wksp msv>128 raw fallback\", r, E_GENERIC);\n        }\n        // non-power-of-two alphabets above 128 exercise the same call shape and\n        // must still agree exactly\n        for msv in [129u32, 150, 200, 254] {\n            let (flat, ftl) = c_ctable(msv, 8, true, 0x9002);\n            for cap in [1usize, 2, 8, 40, 130, 4096] {\n                diff_write_ctable(\n                    &format!(\"flat msv={msv} cap={cap}\"),\n                    cap,\n                    &flat,\n                    msv,\n                    ftl,\n                    HUF_CTABLE_WORKSPACE_SIZE,\n                    0,\n                );\n            }\n        }\"\"\"\nassert old in s; s = s.replace(old, new)\n\n# ---- fix row 70: use power-of-two alphabets <= 128\nold = \"\"\"        for msv in [16u32, 32, 64, 100, 128] {\n            let (flat, ftl) = c_ctable(msv, 8, true, 0x9003);\"\"\"\nnew = \"\"\"        for msv in [3u32, 7, 15, 31, 63, 127] {\n            let (flat, ftl) = c_ctable(msv, 8, true, 0x9003);\"\"\"\nassert old in s; s = s.replace(old, new)\n\n# ---- drop the UB maxNbBits sweep on a deep tree\nold = \"\"\"        // maxNbBits far above the limit\n        for mnb in [14u32, 16, 20, 32, 0xFFFF] {\n            let mut c = vec![0u32; 512];\n            let (mut a, mut b) = (1u32, 1u32);\n            for i in 0..24usize {\n                c[i] = a;\n                let n = a + b;\n                a = b;\n                b = n;\n            }\n            probe(\n                &format!(\"fib maxNbBits={mnb}\"),\n                &c,\n                23,\n                mnb,\n                HUF_CTABLE_WORKSPACE_SIZE,\n                0,\n            );\n        }\"\"\"\nnew = \"\"\"        // `maxNbBits > HUF_TABLELOG_MAX + 1` is only safe when the tree is\n        // already shallower than `maxNbBits`: otherwise HUF_setMaxHeight indexes\n        // `U32 rankLast[HUF_TABLELOG_MAX+2]` at `targetNbBits-currentNbBits`\n        // (huf_compress.c L411/L420), i.e. out of bounds — UB that crashes BOTH\n        // libraries. So only shallow trees are probed here.\n        for mnb in [14u32, 16, 20, 32, 0xFFFF] {\n            let mut c = vec![0u32; 512];\n            let (mut a, mut b) = (1u32, 1u32);\n            for i in 0..8usize {\n                c[i] = a;\n                let n = a + b;\n                a = b;\n                b = n;\n            }\n            probe(\n                &format!(\"shallow fib maxNbBits={mnb}\"),\n                &c,\n                7,\n                mnb,\n                HUF_CTABLE_WORKSPACE_SIZE,\n                0,\n            );\n        }\"\"\"\nassert old in s; s = s.replace(old, new)\nopen(p,'w').write(s)\nPYEOF\ntimeout 600 cargo test --offline --release --test phase_c_entropy 2>&1 | grep -v \"^warning\\|^ *|\\|^ *=\\|^ *-->\\|^[0-9]* *|\\|^\\.\\.\\.\\|^$\" | tail -20","uuid":"bce70b0e-b146-44a5-96b5-21d845a0863b","session_id":"b0ef8e1e-2e1d-45e6-be23-c299770ecb9a"}
