{\n                    let i = rng.below(v.len());\n                    let b = rng.byte();\n                    v[i] = b;\n                }\n                let hb = if rng.below(4) == 0 {\n                    1 + rng.below(v.len())\n                } else {\n                    v.len()\n                };\n                let msv = [0u32, 1, 7, 31, 63, 127, 200, 255][rng.below(8)];\n                if v.len() < 8 {\n                    v.resize(8, 0);\n                }\n                diff_readncount(\"fuzz-mutated\", &v, hb, msv);\n            }\n        }\n        for _ in 0..600 {\n            let n = 1 + rng.below(24);\n            let mut v = rng.bytes(n.max(8));\n            if rng.below(2) == 0 {\n                let nib = rng.below(11) as u8;\n                v[0] = (v[0] & 0xF0) | nib;\n            }\n            let msv = [0u32, 1, 7, 31, 63, 127, 200, 255][rng.below(8)];\n            diff_readncount(\"fuzz-random\", &v, n, msv);\n        }\n    }\n}\nRSEOF\ntimeout 600 cargo test --offline --release --test phase_c_entropy 2>&1 | grep -v \"^warning\\|^ *|\\|^ *=\\|^ *-->\\|^[0-9]* *|\\|^\\.\\.\\.\\|^$\" | tail -30","uuid":"ee0691a0-1adc-46a7-a0f4-591b033ffee7","session_id":"b0ef8e1e-2e1d-45e6-be23-c299770ecb9a"}
