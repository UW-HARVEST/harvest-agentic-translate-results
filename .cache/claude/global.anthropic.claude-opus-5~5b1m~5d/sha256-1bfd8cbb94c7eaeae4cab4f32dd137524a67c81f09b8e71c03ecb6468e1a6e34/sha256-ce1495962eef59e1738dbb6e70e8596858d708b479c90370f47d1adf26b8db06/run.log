ctive steps\na = '''            eqv(&format!(\"{cont}[buf{i} cap{cap}] trace\"), trace_c, trace_r);\n            d.check(&format!(\"{cont}[buf{i} cap{cap}] dst\"));'''\nb = '''            if trace_c.iter().any(|&(_, r)| r != usize::MAX && !is_err(r) && r > 0) {\n                productive += 1;\n            }\n            eqv(&format!(\"{cont}[buf{i} cap{cap}] trace\"), trace_c, trace_r);\n            d.check(&format!(\"{cont}[buf{i} cap{cap}] dst\"));'''\nassert a in s\ns = s.replace(a, b, 1)\n\na = '''    let bufs = corpus(v, 0x57_0000 + v.n() as u64);\n    for (i, b) in bufs.iter().enumerate().filter(|(i, _)| i % 2 == 0) {'''\nb = '''    let bufs = corpus(v, 0x57_0000 + v.n() as u64);\n    let mut productive = 0usize;\n    for (i, b) in bufs.iter().enumerate().filter(|(i, _)| i % 2 == 0) {'''\nassert a in s\ns = s.replace(a, b, 1)\n\na = '''                eqv(&format!(\"{cont}[buf{i} cap{cap}] trace\"), trace_c, trace_r);\n                d.check(&format!(\"{cont}[buf{i} cap{cap}] dst\"));\n            }\n        }\n    }\n}'''\n# not present; instead close of drive_direct_stream is different. handle separately below.\nopen(p,'w').write(s)\nPYEOF\ngrep -n \"productive\" tests/phase_b_legacy.rs"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":596,"cache_read_input_tokens":217183,"cache_creation":{"ephemeral_5m_input_tokens":596,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_01J98wxsynBZbjd3uLfRfYKs","session_id":"b0ef8e1e-2e1d-45e6-be23-c299770ecb9a","uuid":"9f493c5c-643f-4725-8fae-38f2ed4a7817","timestamp":"2026-09-04T05:21:51.017Z","subagent_type":"general-purpose","task_description":"Phase B legacy decoder tests"}
