{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01G7AeQuQHqrarJ95upcNJug","type":"tool_result","content":"//! Phase B — CONFIGS.md rows 1..30: pure helpers, bounds, one-shot\n//! compress/decompress, frame introspection.\nmod common;\nuse common::*;\nuse std::ffi::{c_char, c_int, c_uint, c_ulonglong, c_void};\n\n// ------------------------------------------------------------------ row 1, 2, 13\n\n#[test]\nfn row01_version() {\n    unsafe {\n        let (c, r) = duo::<FnUint0>(\"ZSTD_versionNumber\");\n        eqv(\"ZSTD_versionNumber\", c(), r());\n        let (c, r) = duo::<unsafe extern \"C\" fn() -> *const c_char>(\"ZSTD_versionString\");\n        eqv(\"ZSTD_versionString\", cstr(c()), cstr(r()));\n        let (c, r) = duo::<FnUint0>(\"ZSTD_XXH_versionNumber\");\n        eqv(\"ZSTD_XXH_versionNumber\", c(), r());\n        let (c, r) = duo::<FnUint0>(\"FSE_versionNumber\");\n        eqv(\"FSE_versionNumber\", c(), r());\n    }\n}\n\n#[test]\nfn row02_clevels() {\n    unsafe {\n        for n in [\"ZSTD_maxCLevel\", \"ZSTD_minCLevel\", \"ZSTD_defaultCLevel\"] {\n            let (c, r) = duo::<FnInt0>(n);\n            eqv(n, c(), r());\n        }\n    }\n}\n\n#[test]\nfn row13_stream_sizes() {\n    unsafe {\n        for n in [\n            \"ZSTD_CStreamInSize\",\n            \"ZSTD_CStreamOutSize\",\n            \"ZSTD_DStreamInSize\",\n            \"ZSTD_DStreamOutSize\",\n        ] {\n            let (c, r) = duo::<FnSizeT0>(n);\n            eqv(n, c(), r());\n        }\n        for n in [\n            \"ZBUFF_recommendedCInSize\",\n            \"ZBUFF_recommendedCOutSize\",\n            \"ZBUFF_recommendedDInSize\",\n            \"ZBUFF_recommendedDOutSize\",\n        ] {\n            let (c, r) = duo::<FnSizeT0>(n);\n            eqv(n, c(), r());\n        }\n    }\n}\n\n// ------------------------------------------------------------------ row 3\n\n#[test]\nfn row03_compress_bound() {\n    unsafe {\n        let (c, r) = duo::<FnSizeT1>(\"ZSTD_compressBound\");\n        let mut cases: Vec<usize> = vec![\n            0,\n            1,\n            2,\n            3,\n            127,\n            128,\n            129,\n            1 << 10,\n            (1 << 17) - 1,\n            1 << 17,\n            (1 << 17) + 1,\n            1 << 20,\n            1 << 24,\n            1 << 30,\n            0xFF00FF00,\n            usize::MAX / 2,\n            usize::MAX - 1,\n----\n1250 tests/phase_b_core.rs\n[package]\nname = \"zstd\"\nversion = \"1.5.7\"\nedition = \"2021\"\n\n[lib]\nname = \"zstd\"\ncrate-type = [\"cdylib\"]\npath = \"src/lib.rs\"\n\n[dev-dependencies]\nlibloading = \"0.8\"\n\n[profile.release]\npanic = \"abort\"\noverflow-checks = false\ndebug-assertions = false\n\n[workspace]","is_error":false}]},"parent_tool_use_id":"toolu_bdrk_018RjniPmkYmE7G4S88ySbe7","session_id":"b0ef8e1e-2e1d-45e6-be23-c299770ecb9a","uuid":"78ac3b79-b164-4d2b-8807-18a7d013fbce","timestamp":"2026-09-04T05:01:55.012Z","subagent_type":"general-purpose","task_description":"Phase B streaming tests"}
