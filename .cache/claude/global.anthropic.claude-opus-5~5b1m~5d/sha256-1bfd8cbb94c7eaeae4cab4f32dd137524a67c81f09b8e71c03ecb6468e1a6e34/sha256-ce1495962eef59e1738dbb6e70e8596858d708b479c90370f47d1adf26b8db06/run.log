ormat!(\n                                            \"{tagbase} strat={strategy} lit={litMode} huf={hufRepeat} fse={fseRepeat}\"\n                                        );\n                                        eqv(&format!(\"ZSTD_buildBlockEntropyStats ret {t}\"), x, y);\n                                        eqbuf(\n                                            &format!(\"ZSTD_buildBlockEntropyStats nextEntropy {t}\"),\n                                            raw_bytes(&nxt_c),\n                                            raw_bytes(&nxt_r),\n                                        );\n                                        eqbuf(\n                                            &format!(\"ZSTD_buildBlockEntropyStats metadata {t}\"),\n                                            raw_bytes(&md_c),\n                                            raw_bytes(&md_r),\n                                        );\n                                    }\n                                }\n                            }\n                        }\n                    }\n                }\n            }\n        }\n    }\n}\nEOF\ntimeout 900 cargo test --offline --release --test phase_b_entropy row141 -- --test-threads=1 2>&1 | grep -v \"^warning\\|^ *|\\|^ *=\\|^ *-->\\|^[0-9]* *|\\|^\\.\\.\\.$\" | tail -25","is_backgrounded":false,"task_type":"local_bash","uuid":"1534c58f-9139-40ba-99d8-c78126c8cfd1","session_id":"b0ef8e1e-2e1d-45e6-be23-c299770ecb9a"}
