{"type":"system","subtype":"task_notification","task_id":"b97yeyl5x","tool_use_id":"toolu_bdrk_01R4ittW5jjLJt5Li19M8NsL","status":"completed","output_file":"","summary":"cat > $TMPDIR/exp5.py <<'EOF'\nimport ctypes, random\nC = ctypes.CDLL(\"c_src/build/libzstd.so\")\nclass ZP(ctypes.Structure):\n    _fields_=[(\"compressionLevel\",ctypes.c_int),(\"notificationLevel\",ctypes.c_uint),(\"dictID\",ctypes.c_uint)]\nC.ZDICT_isError.restype=ctypes.c_uint\nC.ZDICT_getErrorName.restype=ctypes.c_char_p\nC.ZDICT_finalizeDictionary.restype=ctypes.c_size_t\nC.ZDICT_finalizeDictionary.argtypes=[ctypes.c_void_p,ctypes.c_size_t,ctypes.c_void_p,ctypes.c_size_t,ctypes.c_void_p,ctypes.POINTER(ctypes.c_size_t),ctypes.c_uint,ZP]\ndef fin(cap,content,samples,sizes,lvl):\n    buf=ctypes.create_string_buffer(max(cap,1))\n    cb=ctypes.create_string_buffer(bytes(content),max(len(content),1))\n    sb=ctypes.create_string_buffer(bytes(samples),max(len(samples),1))\n    arr=(ctypes.c_size_t*max(len(sizes),1))(*sizes)\n    return C.ZDICT_finalizeDictionary(buf,cap,cb,len(content),sb,arr,len(sizes),ZP(lvl,0,0))\nrandom.seed(5)\nbest=0;cfg=None\nfor t in range(1200):\n    n=random.choice([4096,16384,65536])\n    w=[random.uniform(0.0005,1) for v in range(256)]\n    s=bytearray(random.choices(range(256),weights=w,k=n))\n    # sprinkle repeated substrings of varied lengths to diversify ML/LL/offsets\n    for _ in range(random.randint(0,200)):\n        L=random.randint(3,random.choice([16,64,300,1000]))\n        a=random.randrange(max(1,n-L)); b=random.randrange(max(1,n-L))\n        s[b:b+L]=s[a:a+L]\n    s=bytes(s)\n    nb=random.choice([1,2,4]); sz=n//nb\n    lvl=random.choice([1,3,6,9,13,17,19,22])\n    r=fin(4096,b\"\",s,[sz]*nb,lvl)\n    if C.ZDICT_isError(r): continue\n    h=r-8\n    if h>best: best=h;cfg=(n,nb,lvl);print(h,cfg)\nprint(\"MAX\",best,cfg)\nEOF\ntimeout 900 python3 $TMPDIR/exp5.py 2>&1 | tail -8","uuid":"2188b183-0cd1-47bd-a8d8-313cd98d78ef","session_id":"b0ef8e1e-2e1d-45e6-be23