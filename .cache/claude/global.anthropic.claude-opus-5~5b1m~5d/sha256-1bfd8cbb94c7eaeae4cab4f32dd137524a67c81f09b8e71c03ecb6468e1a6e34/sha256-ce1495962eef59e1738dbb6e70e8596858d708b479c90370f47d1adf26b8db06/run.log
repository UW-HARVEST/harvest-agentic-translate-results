press = unsafe extern \"C\" fn(*mut c_void, usize, *const c_void, usize) -> usize;\n559\tpub type FnCompressCCtx =\n560\t    unsafe extern \"C\" fn(*mut c_void, *mut c_void, usize, *const c_void, usize, c_int) -> usize;\n561\tpub type FnDecompressDCtx =\n562\t    unsafe extern \"C\" fn(*mut c_void, *mut c_void, usize, *const c_void, usize) -> usize;\n563\t\n564\tpub type FnSetParam = unsafe extern \"C\" fn(*mut c_void, c_int, c_int) -> usize;\n565\tpub type FnGetParam = unsafe extern \"C\" fn(*mut c_void, c_int, *mut c_int) -> usize;\n566\tpub type FnReset = unsafe extern \"C\" fn(*mut c_void, c_int) -> usize;\n567\tpub type FnStream2 =\n568\t    unsafe extern \"C\" fn(*mut c_void, *mut ZSTD_outBuffer, *mut ZSTD_inBuffer, c_int) -> usize;\n569\tpub type FnDStream = unsafe extern \"C\" fn(*mut c_void, *mut ZSTD_outBuffer, *mut ZSTD_inBuffer) -> usize;\n570\tpub type FnGetBounds = unsafe extern \"C\" fn(c_int) -> ZSTD_bounds;\n571\t\n572\t// ---------------------------------------------------------------- helpers\n573\t\n574\t/// A pair of contexts (one per library) created/destroyed together.\n575\tpub struct CtxPair {\n576\t    pub c: *mut c_void,\n577\t    pub r: *mut c_void,\n578\t    free_c: FnFreePtr,\n579\t    free_r: FnFreePtr,\n580\t}\n581\t\n582\timpl CtxPair {\n583\t    pub unsafe fn new(create: &str, free: &str) -> CtxPair {\n584\t        let (cc, cr) = duo::<FnPtr0>(create);\n585\t        let (fc, fr) = duo::<FnFreePtr>(free);\n586\t        let c = cc();\n587\t        let r = cr();\n588\t        assert!(!c.is_null(), \"{create} returned NULL in C\");\n589\t        assert!(!r.is_null(), \"{create} returned NULL in Rust\");\n590\t        CtxPair { c, r, free_c: fc, free_r: fr }\n591\t    }\n592\t    pub unsafe fn cctx() -> CtxPair {\n593\t        CtxPair::new(\"ZSTD_createCCtx\", \"ZSTD_freeCCtx\")\n594\t    }\n595\t    pub unsafe fn dctx() -> CtxPair {\n596\t        CtxPair::new(\"ZSTD_createDCtx\", \"ZSTD_freeDCtx\")\n597\t    }\n598\t    pub unsafe fn cstream() -> CtxPair {\n599\t        CtxPair::new(\"ZSTD_createCStream\", \"ZSTD_freeCStream\")\n600\t    }\n601\t    pub unsafe fn dstream() -> CtxPair {\n602\t        CtxPair::new(\"ZSTD_createDStream\", \"ZSTD_freeDStream\")\n603\t    }\n604\t    pub unsafe fn cctx_params() -> CtxPair {\n605\t        CtxPair::new(\"ZSTD_createCCtxParams\", \"ZSTD_freeCCtxParams\")\n606\t    }\n607\t}\n608\t\n609\timpl Drop for CtxPair {\n610\t    fn drop(&mut self) {\n611\t        unsafe {\n612\t            if !self.c.is_null() {\n613\t                (self.free_c)(self.c);\n614\t            }\n615\t            if !self.r.is_null() {\n616\t                (self.free_r)(self.r);\n617\t            }\n618\t        }\n619\t    }\n620\t}\n621\t\n622\t/// Run `f` against both libraries' function pointers and compare the returned\n623\t/// `usize` plus the destination buffer contents.\n624\t///\n625\t/// `f(fnptr, dst) -> ret`\n626\t#[track_caller]\n627\tpub unsafe fn diff_call<T: Copy, F>(what: &str, name: &str, dstlen: usize, mut f: F)\n628\twhere\n629\t    F: FnMut(T, &mut [u8]) -> usize,\n630\t{\n631\t    let (fc, fr) = duo::<T>(name);\n632\t    let mut dc = vec![0xA5u8; dstlen];\n633\t    let mut dr = vec![0xA5u8; dstlen];\n634\t    let rc = f(fc, &mut dc);\n635\t    let rr = f(fr, &mut dr);\n636\t    eqv(&format!(\"{what} [{name}] return\"), rc, rr);\n637\t    eqbuf(&format!(\"{what} [{name}] dst\"), &dc, &dr);\n638\t}\n639\t\n640\t/// Compress `src` with the C library at `level`; panics on error.\n641\tpub unsafe fn c_compress(src: &[u8], level: c_int) -> Vec<u8> {\n642\t    let (bound, _) = duo::<FnSizeT1>(\"ZSTD_compressBound\");\n643\t    let (comp, _) = duo::<FnCompress>(\"ZSTD_compress\");\n644\t    let (iserr, _) = duo::<FnIsError>(\"ZSTD_isError\");\n645\t    let cap = bound(src.len());\n646\t    let mut dst = vec![0u8; cap.max(64)];\n647\t    let n = comp(\n648\t        dst.as_mut_ptr() as *mut c_void,\n649\t        dst.len(),\n650\t        src.as_ptr() as *const c_void,\n651\t        src.len(),\n652\t        level,\n653\t    );\n654\t    assert_eq!(iserr(n), 0, \"helper c_compress failed\");\n655\t    dst.truncate(n);\n656\t    dst\n657\t}\n658\t\n659\tpub fn is_err(n: usize) -> bool {\n660\t    n > usize::MAX - 130\n661\t}\n662\t"}]},"parent_tool_use_id":"toolu_bdrk_01WCZHz6uac4djVtvVUhM9QX","session_id":"b0ef8e1e-2e1d-45e6-be23-c299770ecb9a","uuid":"0dfc5822-0603-4f6d-83f4-35d512b01404","timestamp":"2026-09-04T05:38:58.812Z","subagent_type":"general-purpose","task_description":"Phase C dictbuilder+legacy errors"}
