{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_015nZ1732oo9jko89sSjUyxA","type":"tool_result","content":"359\t/// Symmetric round-trip check: the C frame is decoded by the C library with the\n360\t/// same dictionary settings, likewise for Rust; returns and payloads must match\n361\t/// each other, and — when decoding succeeds — the original input.\n362\t#[track_caller]\n363\tunsafe fn rt_check(what: &str, cf: &[u8], rf: &[u8], dict: &[u8], dct: c_int, orig: &[u8]) {\n364\t    let dctx = CtxPair::dctx();\n365\t    let (lc, lr) = duo::<FnLoadDictAdv>(\"ZSTD_DCtx_loadDictionary_advanced\");\n366\t    let a = lc(dctx.c, dict.as_ptr() as *const c_void, dict.len(), ZSTD_dlm_byCopy, dct);\n367\t    let b = lr(dctx.r, dict.as_ptr() as *const c_void, dict.len(), ZSTD_dlm_byCopy, dct);\n368\t    eqv(&format!(\"{what} DCtx_loadDictionary_advanced\"), a, b);\n369\t    let cap = orig.len() + 64;\n370\t    let mut oc = vec![0xC3u8; cap];\n371\t    let mut or_ = vec![0xC3u8; cap];\n372\t    let (dc, dr) = duo::<FnDecompressDCtx>(\"ZSTD_decompressDCtx\");\n373\t    let x = dc(dctx.c, oc.as_mut_ptr() as *mut c_void, cap, cf.as_ptr() as *const c_void, cf.len());\n374\t    let y = dr(dctx.r, or_.as_mut_ptr() as *mut c_void, cap, rf.as_ptr() as *const c_void, rf.len());\n375\t    eqv(&format!(\"{what} roundtrip ret\"), x, y);\n376\t    if is_err(x) {\n377\t        eqbuf(&format!(\"{what} roundtrip dst (error path)\"), &oc, &or_);\n378\t        return;\n379\t    }\n380\t    assert_eq!(x, orig.len(), \"{what}: roundtrip produced {x} bytes, want {}\", orig.len());\n381\t    eqbuf(&format!(\"{what} roundtrip payload\"), orig, &oc[..x]);\n382\t    eqbuf(&format!(\"{what} roundtrip dst\"), &oc[..x], &or_[..x]);\n383\t    check_wildcopy_slack(what, &oc, &or_, x, 0xC3);\n384\t}\n385\t\n386\t/// `ZSTD_decompress*` is documented to clobber up to `ZSTD_WILDCOPY_OVERLENGTH`\n387\t/// (32) bytes past the produced output when `dstCapacity` leaves room for it, and\n388\t/// the clobbered bytes are not part of the API contract.  What *is* checkable is\n389\t/// that both libraries stay inside that window and leave everything after it\n390\t/// untouched — anything else would be a real divergence.\n391\t#[track_caller]\n392\tfn check_wildcopy_slack(what: &str, c: &[u8], r: &[u8], produced: usize, filler: u8) {\n393\t    const WILDCOPY_OVERLENGTH: usize = 32;\n394\t    let lim = (produced + WILDCOPY_OVERLENGTH).min(c.len());\n395\t    for (tag, buf) in [(\"C\", c), (\"Rust\", r)] {\n396\t        for i in lim..buf.len() {\n397\t            assert_eq!(\n398\t                buf[i], filler,\n399\t                \"{what}: {tag} wrote at byte {i}, i.e. more than {WILDCOPY_OVERLENGTH} bytes \\\n400\t                 past the {produced}-byte output (buffer len {})\",\n401\t                buf.len()\n402\t            );\n403\t        }\n404\t    }\n405\t    eqbuf(&format!(\"{what} dst tail past wildcopy slack\"), &c[lim..], &r[lim..]);\n406\t}\n407\t\n408\t/// Compare two decompression destination buffers: the whole buffer on the error\n409\t/// path, the produced bytes plus the wildcopy-slack invariant on success.\n410\t#[track_caller]\n411\tfn cmp_decode_bufs(what: &str, ret: usize, c: &[u8], r: &[u8], filler: u8) {\n412\t    if is_err(ret) {\n413\t        eqbuf(&format!(\"{what} dst (error path)\"), c, r);\n414\t        return;\n415\t    }\n416\t    assert!(ret <= c.len(), \"{what}: return {ret} exceeds buffer {}\", c.len());\n417\t    eqbuf(&format!(\"{what} dst\"), &c[..ret], &r[..ret]);\n418\t    check_wildcopy_slack(what, c, r, ret, filler);\n419\t}\n420\t\n421\t/// `ZSTD_compress2` on both cctxs of a pair; compares return + destination.\n422\t#[track_caller]\n423\tunsafe fn compress2_pair(what: &str, cctx: &CtxPair, src: &[u8]) -> (usize, Vec<u8>, Vec<u8>) {"}]},"parent_tool_use_id":"toolu_bdrk_011dwFgnZ4wc3rtYdejgSN3w","session_id":"b0ef8e1e-2e1d-45e6-be23-c299770ecb9a","uuid":"59cc12b9-7a59-459e-ba9d-96c3ecdf44b5","timestamp":"20