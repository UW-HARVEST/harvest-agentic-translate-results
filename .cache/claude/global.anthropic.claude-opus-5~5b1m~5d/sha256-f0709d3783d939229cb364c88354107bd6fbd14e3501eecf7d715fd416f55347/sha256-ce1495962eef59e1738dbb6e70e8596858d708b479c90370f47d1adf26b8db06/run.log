ns to whom the Software is furnished to do so,\n    14\t// subject to the following conditions:\n    15\t//\n    16\t// The above copyright notice and this permission notice\n    17\t// shall be included in all copies or substantial portions of the Software.\n    18\t//\n    19\t// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    20\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    21\t// THE WARRANTIES OF MERCHANTABILITY,\n    22\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    23\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    24\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    25\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    26\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    27\t\n    28\t#![allow(non_camel_case_types)]\n    29\t\n    30\tmod hello;\n=========== translation/src/hello.rs ===========\n     1\t//! Translation of `c_src/src/hello.c` (public header: `c_src/include/hello.h`).\n     2\t//!\n     3\t//! ```c\n     4\t//! int helloworld() {\n     5\t//!     printf(\"Hello World!\\n\");\n     6\t//!     return 0;\n     7\t//! }\n     8\t//! ```\n     9\t\n    10\tuse core::ffi::{c_char, c_int};\n    11\t\n    12\tunsafe extern \"C\" {\n    13\t    /// C standard library `printf`, used so that output goes through exactly the\n    14\t    /// same `stdout` FILE stream (and buffering behaviour) as the original C\n    15\t    /// library did.  This keeps the emitted bytes, and their interleaving with\n    16\t    /// any other C stdio output, byte-for-byte identical.\n    17\t    #[link_name = \"printf\"]\n    18\t    unsafe fn c_printf(format: *const c_char, ...) -> c_int;\n    19\t}\n    20\t\n    21\t/// `int helloworld()` — prints `Hello World!\\n` to stdout and returns 0.\n    22\t///\n    23\t/// The C original ignores `printf`'s return value and unconditionally returns 0.\n    24\t#[unsafe(no_mangle)]\n    2