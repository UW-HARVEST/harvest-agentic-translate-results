n\\0\"' 'b\"Hello World!\\0\\0\"'                 ; run_mut \"drop the trailing newline\"\npy 'b\"Hello World!\\n\\0\"' 'b\"Hello World!\\r\\n\"'                 ; run_mut \"CRLF instead of LF\"\npy 'b\"Hello World!\\n\\0\"' 'b\"Hello World\\u{21}\\n\\0\"'            ; run_mut \"escape-equivalent text (control)\"\npy \"$CALL\"               ''                                     ; run_mut \"emit nothing at all\"\npy \"$CALL\"               \"$CALL\"$'\\n'\"$CALL\"                    ; run_mut \"emit the line twice\"\npy '    0\n}' '    1\n}'                                                              ; run_mut \"return 1 instead of 0\"\npy \"$CALL\" '        return c_printf(FORMAT.as_ptr() as *const c_char);' ; run_mut \"propagate printf's return value\"\npy \"$CALL\" '        if c_printf(FORMAT.as_ptr() as *const c_char) < 0 { return -1; }' ; run_mut \"return -1 when the write fails\"\npy \"$CALL\" '        let _ = FORMAT; print!(\"Hello World!\\n\");'  ; run_mut \"write via Rust stdout, not the C stream\"\npy \"$CALL\" '        let _ = FORMAT; unsafe { c_printf(c\"Hello World!\\n\".as_ptr()); c_printf(c\"\".as_ptr()); }' ; run_mut \"extra empty printf call\"\npy '#[unsafe(no_mangle)]' '#[unsafe(export_name = \"helloworld_\")]' ; run_mut \"rename the exported symbol\"\n\necho\nif [ \"$survived\" -eq 0 ]; then\n  printf '\\033[32mAll %d mutants were detected — the suite has no blind spots for these.\\033[0m\\n' \"$total\"\nelse\n  printf '\\033[31m%d of %d mutants SURVIVED.\\033[0m\\n' \"$survived\" \"$total\"\nfi\ncargo build --offline >/dev/null 2>&1\nexit \"$survived\"\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2110,"cache_read_input_tokens":123541,"cache_creation":{"ephemeral_5m_input_tokens":2110,"ephemeral_1h_input_tokens":0},"output_tokens":7,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"b345276c-8cf5-4633-9b9b-53c50a668569","uuid":"