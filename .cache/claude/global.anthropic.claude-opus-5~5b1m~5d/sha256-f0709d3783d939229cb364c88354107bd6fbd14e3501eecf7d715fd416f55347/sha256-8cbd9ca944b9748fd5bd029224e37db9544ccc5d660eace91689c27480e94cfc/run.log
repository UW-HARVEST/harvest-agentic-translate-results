 old in s\ns = s.replace(old, '''            Buffering::FullOwnBuf(n) => {\n                libc::setvbuf(libc_stdout(), leaked_buf(n), libc::_IOFBF, n);\n            }\n            Buffering::LineOwnBuf(n) => {\n                libc::setvbuf(libc_stdout(), leaked_buf(n), libc::_IOLBF, n);\n            }''', 1)\n\nold = '''        // Detach from the caller-supplied buffer before it is dropped.\n        libc::setvbuf(libc_stdout(), std::ptr::null_mut(), libc::_IOFBF, 0);\n'''\nassert old in s\ns = s.replace(old, '''        // Move stdout onto a *fresh* leaked buffer; the previous one stays alive.\n        libc::setvbuf(libc_stdout(), leaked_buf(4096), libc::_IOFBF, 4096);\n        libc::clearerr(libc_stdout());\n''', 1)\n\n# 3. with_stdout_to restore\nold = '''        let fr = libc::fflush(libc_stdout());\n        libc::setvbuf(libc_stdout(), std::ptr::null_mut(), libc::_IOFBF, 0);\n        // Discard anything still queued for the failing target.'''\nassert old in s\ns = s.replace(old, '''        let fr = libc::fflush(libc_stdout());\n        libc::setvbuf(libc_stdout(), leaked_buf(4096), libc::_IOFBF, 4096);\n        libc::clearerr(libc_stdout());\n        // Discard anything still queued for the failing target.''', 1)\n\nopen(p,'w').write(s)\nprint(\"common ok\")\n\n# 4. same in phase_c_errors.rs\np='tests/phase_c_errors.rs'\ns=open(p).read()\nn = s.count('libc::setvbuf(libc_stdout(), std::ptr::null_mut(), libc::_IOFBF, 0);')\ns = s.replace('''libc::setvbuf(libc_stdout(), std::ptr::null_mut(), libc::_IOFBF, 0);''',\n              '''libc::setvbuf(libc_stdout(), leaked_buf(4096), libc::_IOFBF, 4096);''')\nopen(p,'w').write(s)\nprint(\"phase_c replaced\", n)\nPY\ngrep -n \"leaked_buf\\|null_mut(), libc::_IOFBF\" tests/common/mod.rs tests/phase_c_errors.rs","description":"Replace user setvbuf buffers with leaked buffers"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":934,"cache_read_input_tokens":