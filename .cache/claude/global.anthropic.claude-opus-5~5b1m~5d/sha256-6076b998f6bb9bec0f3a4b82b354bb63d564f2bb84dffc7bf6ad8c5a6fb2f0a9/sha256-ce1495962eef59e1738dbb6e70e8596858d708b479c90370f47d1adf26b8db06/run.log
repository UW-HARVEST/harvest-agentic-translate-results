{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_019YYBck9BvEPsrGjfY2drd9","type":"tool_result","content":"1\t// Rust translation of c_src/src/lib.c\n2\t//\n3\t// Copyright 2025 MIT Lincoln Laboratory\n4\t// Permission is hereby granted, free of charge,\n5\t// to any person obtaining a copy of this software\n6\t// and associated documentation files (the \"Software\"),\n7\t// to deal in the Software without restriction,\n8\t// including without limitation the rights to use, copy,\n9\t// modify, merge, publish, distribute, sublicense,\n10\t// and/or sell copies of the Software,\n11\t// and to permit persons to whom the Software is furnished to do so,\n12\t// subject to the following conditions:\n13\t//\n14\t// The above copyright notice and this permission notice\n15\t// shall be included in all copies or substantial portions of the Software.\n16\t//\n17\t// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n18\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n19\t// THE WARRANTIES OF MERCHANTABILITY,\n20\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n21\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n22\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n23\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n24\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n25\t\n26\t#![allow(non_camel_case_types)]\n27\t\n28\tuse core::ffi::{c_char, c_int, c_long, c_void};\n29\tuse core::ptr;\n30\t\n31\t// ---------------------------------------------------------------------------\n32\t// C library bindings (libc). Using the platform C library keeps stdio\n33\t// buffering / allocation behaviour byte-for-byte identical with the original.\n34\t// ---------------------------------------------------------------------------\n35\t\n36\t/// `time_t` on the target platforms this library is built for (LP64 Linux).\n37\tpub type time_t = c_long;\n38\t\n39\textern \"C\" {\n40\t    fn calloc(nmemb: usize, size: usize) -> *mut c_void;\n41\t    fn time(tloc: *mut time_t) -> time_t;\n42\t    fn printf(format: *const c_char, ...) -> c_int;\n43\t}\n44\t\n45\t// ---------------------------------------------------------------------------\n46\t// Types mirroring the C declarations\n47\t// ---------------------------------------------------------------------------\n48\t\n49\t// typedef enum { OP_ADD = 1, ... } Operation;  -> passed as a plain C int.\n50\tpub const OP_ADD: c_int = 1;\n51\tpub const OP_MULTIPLY: c_int = 2;\n52\tpub const OP_SUBTRACT: c_int = 3;\n53\tpub const OP_DIVIDE: c_int = 4;\n54\tpub const OP_MODULO: c_int = 5;\n55\t\n56\t// typedef enum { STATUS_SUCCESS = 0, STATUS_ERROR = -1, STATUS_WARNING = 1 } StatusCode;\n57\tpub const STATUS_SUCCESS: c_int = 0;\n58\tpub const _STATUS_ERROR: c_int = -1;\n59\tpub const _STATUS_WARNING: c_int = 1;\n60\t\n61\t// typedef struct { int value; time_t timestamp; StatusCode status; } ComputationResult;\n62\t#[repr(C)]\n63\t#[derive(Clone, Copy)]\n64\tpub struct ComputationResult {\n65\t    pub value: c_int,\n66\t    pub timestamp: time_t,\n67\t    pub status: c_int,\n68\t}\n69\t\n70\t// typedef int (*MathOperation)(int, int, int);\n71\tpub type MathOperation = extern \"C\" fn(c_int, c_int, c_int) -> c_int;\n72\t\n73\t// ---------------------------------------------------------------------------\n74\t// bool is_valid_operation(char op_char)\n75\t// ---------------------------------------------------------------------------\n76\t#[unsafe(no_mangle)]\n77\tpub extern \"C\" fn is_valid_operation(op_char: c_char) -> bool {\n78\t    // char valid = op_char && (op_char >= '1' && op_char <= '5');\n79\t    let valid: c_char = (op_char != 0 && (op_char >= b'1' as c_char && op_char <= b'5' as c_char))\n80\t        as c_char;\n81\t    valid != 0\n82\t}\n83\t\n84\t// ---------------------------------------------------------------------------\n85\t// int get_operation_priority(Operation op