32) -> bool {\n    a == i32::MIN && b == -1\n}\n\n/// Does `mathop(p1,p2,p3,p4)` reach a trapping `idiv` inside the C code?\n///\n/// `mathop` runs two operations:\n///   op1 = (p3 % 5) + 1 applied to (p1, p2)\n///   op2 = ((p4 + 1) % 5) + 1 applied to (intermediate, p4)\n/// DIVIDE is 4 and MODULO is 5; both use `idiv`.\npub fn mathop_would_trap(p1: i32, p2: i32, p3: i32, p4: i32) -> bool {\n    let op1 = p3.wrapping_rem(5).wrapping_add(1);\n    let uses_idiv = |op: i32| op == OP_DIVIDE || op == OP_MODULO;\n\n    if uses_idiv(op1) && is_c_div_trap(p1, p2) {\n        return true;\n    }\n    // Reproduce the intermediate result exactly as the C computes it.\n    let intermediate = match op1 {\n        OP_MULTIPLY => p1.wrapping_mul(p2),\n        OP_SUBTRACT => p1.wrapping_sub(p2),\n        OP_DIVIDE => {\n            if p2 == 0 {\n                0\n            } else {\n                p1.wrapping_div(p2)\n            }\n        }\n        OP_MODULO => {\n            if p2 == 0 {\n                0\n            } else {\n                p1.wrapping_rem(p2)\n            }\n        }\n        _ => p1.wrapping_add(p2), // OP_ADD and every out-of-range value\n    };\n    let op2 = p4.wrapping_add(1).wrapping_rem(5).wrapping_add(1);\n    uses_idiv(op2) && is_c_div_trap(intermediate, p4)\n}\n\n// ---------------------------------------------------------------------------\n// stdout capture (mathop printf output)\n// ---------------------------------------------------------------------------\n\n/// Run `f` with fd 1 redirected into a temp file and return everything the\n/// C library printed. Must be called with `global_lock()` held.\npub fn capture_stdout<R>(f: impl FnOnce() -> R) -> (R, Vec<u8>) {\n    unsafe {\n        fflush(std::ptr::null_mut()); // flush all streams before rewiring fd 1\n    }\n    let dir = std::env::temp_dir();\n    let path = dir.join(format!(\n        \"mathop_stdout_{}_{:?}.txt\",\n        std::process::id(),\n        std::thread::current().id(