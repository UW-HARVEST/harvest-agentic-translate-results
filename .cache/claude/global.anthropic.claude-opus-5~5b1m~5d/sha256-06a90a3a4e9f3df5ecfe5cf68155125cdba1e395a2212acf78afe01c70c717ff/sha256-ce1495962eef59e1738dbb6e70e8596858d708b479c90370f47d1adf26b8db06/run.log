{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_015UPxDM21dXarK3ynVnD3L3","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/`.\n2\t//!\n3\t//! This is a faithful, behaviour-preserving translation of `c_src/src/lib.c`\n4\t//! (a cut-down version of the `cute_c2` 2D collision routines).  Every\n5\t//! non-`static` function of the C translation unit is re-exported here with the\n6\t//! exact same linker symbol name, the exact same C signature and the exact same\n7\t//! floating point evaluation order so that the resulting `cdylib` is a drop-in\n8\t//! replacement for the C shared library and produces byte-identical results.\n9\t//!\n10\t//! Notes on fidelity:\n11\t//!  * All arithmetic is performed in `f32` exactly like the C code (no\n12\t//!    intermediate promotion to `f64`, no reassociation, no use of `fma`).\n13\t//!  * The C source uses expanded `min`/`max`/`abs` ternaries\n14\t//!    (`a < b ? a : b`, `a < 0 ? -a : a`).  Those are reproduced with explicit\n15\t//!    comparisons instead of `f32::min`/`f32::max`/`f32::abs` because the\n16\t//!    library functions differ from the C ternaries for NaN / signed-zero\n17\t//!    inputs.\n18\t//!  * `c2Div` multiplies by the reciprocal (`a * (1.0f / b)`) just like the C\n19\t//!    code -- this is *not* the same as a division and is preserved verbatim.\n20\t//!  * Out parameters are written in exactly the same order (and in the same\n21\t//!    early-return paths) as the C code, including the writes that happen in\n22\t//!    `c2RaytoCapsule` before the function decides to return 0.\n23\t//!  * Every exported function is `#[inline(never)]`.  In the C shared library\n24\t//!    the helpers have default visibility, so GCC emits real (PLT) calls\n25\t//!    between them instead of inlining them; keeping the same call structure\n26\t//!    keeps every call site using one single code path, exactly as in C.\n27\t//!  * `c2CastRay`'s `switch` has no `default` label: for a shape type other\n28\t//!    than 0/1/2 the C function falls off the end without returning a value\n29\t//!    (undefined behaviour -- the compiled code returns whatever happens to be\n30\t//!    in `eax`).  There is nothing meaningful to reproduce there, so 0 is\n31\t//!    returned.\n32\t//!\n33\t//! Verified against the C build with a differential fuzzer (see\n34\t//! `verify/difftest.c`): 13.2M randomized calls covering all 22 exported\n35\t//! symbols -- including +-0.0, denormals, +-inf, huge values -- are bit\n36\t//! identical to both the `-O0` and the `-O2` C builds, and 4M randomized\n37\t//! `spec_ray` calls (NaN inputs included) are bit identical as well.  The only\n38\t//! observable difference is the *payload* of a NaN that is produced by feeding\n39\t//! NaN operands into the low level vector helpers: which of two NaN operands a\n40\t//! `mulss`/`addss` propagates is unspecified by IEEE-754 and depends purely on\n41\t//! instruction operand order, so the C library does not even agree with itself\n42\t//! there (its `-O0` and `-O2` builds differ from each other on more of those\n43\t//! cases than this translation differs from either).\n44\t\n45\t#![allow(non_snake_case)]\n46\t#![allow(non_camel_case_types)]\n47\t\n48\tuse std::ffi::c_int;\n49\tuse std::os::raw::c_void;\n50\t\n51\t/* -------------------------------------------------------------------------- */\n52\t/*                                   types                                    */\n53\t/* -------------------------------------------------------------------------- */\n54\t\n55\t/// `typedef struct c2v { float x; float y; } c2v;`\n56\t#[repr(C)]\n57\t#[derive(Copy, Clone, Debug)]\n58\tpub struct c2v {\n59\t    pub x: f32,\n60\t    pub y: f32,\n61\t}\n62\t\n63\t/// `typedef struct c2Raycast { float t; c2v n; } c2Raycast;`\n64\t#[repr(C)]\n65\t#[derive(Copy, Clone, Debug)]\n66\tpub struct c2Raycast {\n67\t    pub t: f32,\n68\t    pub n: c2v,\n69\t}\n70\t\n71\t/// `typedef struct c2Circle { c2v p; float r; } c2Circle;`\n72\t#[repr(C)]\n73\t#[derive(Copy, Clone, Debug)]\n74\tpub struct c2Circle {\n75\t    pub p: c2v,\n76\t    pub r: f32,\n77\t}\n78\t\n79\t/// `typedef struct c2AABB { c2v min; c2v max; } c2AABB;`\n80\t#[repr(C)]\n81\t#[derive(Copy, Clone, Debug)]\n82\tpub struct c2AABB {\n83\t    pub min: c2v,\n84\t    pub max: c2v,\n85\t}\n86\t\n87\t/// `typedef struct c2Capsule { c2v a; c2v b; float r; } c2Capsule;`\n88\t#[repr(C)]\n89\t#[derive(Copy, Clone, Debug)]\n90\tpub struct c2Capsule {\n91\t    pub a: c2v,\n92\t    pub b: c2v,\n93\t    pub r: f32,\n94\t}\n95\t\n96\t/// `typedef struct c2Ray { c2v p; c2v d; float t; } c2Ray;`\n97\t#[repr(C)]\n98\t#[derive(Copy, Clone, Debug)]\n99\tpub struct c2Ray {\n100\t    pub p: c2v,\n101\t    pub d: c2v,\n102\t    pub t: f32,\n103\t}\n104\t\n105\t/// `typedef struct c2m { c2v x; c2v y; } c2m;`\n106\t#[repr(C)]\n107\t#[derive(Copy, Clone, Debug)]\n108\tpub struct c2m {\n109\t    pub x: c2v,\n110\t    pub y: c2v,\n111\t}\n112\t\n113\t/* `typedef enum { C2_TYPE_CIRCLE, C2_TYPE_AABB, C2_TYPE_CAPSULE } C2_TYPE;` */\n114\tpub const C2_TYPE_CIRCLE: c_int = 0;\n115\tpub const C2_TYPE_AABB: c_int = 1;\n116\tpub const C2_TYPE_CAPSULE: c_int = 2;\n117\t\n118\t/* -------------------------------------------------------------------------- */\n119\t/*                      C ternary helpers (bit-exact)                         */\n120\t/* -------------------------------------------------------------------------- */\n121\t\n122\t/// `a < b ? a : b`\n123\t#[inline(always)]\n124\tfn c_min(a: f32, b: f32) -> f32 {\n125\t    if a < b {\n126\t        a\n127\t    } else {\n128\t        b\n129\t    }\n130\t}\n131\t\n132\t/// `a > b ? a : b`\n133\t#[inline(always)]\n134\tfn c_max(a: f32, b: f32) -> f32 {\n135\t    if a > b {\n136\t        a\n137\t    } else {\n138\t        b\n139\t    }\n140\t}\n141\t\n142\t/// `a < 0 ? -a : a`\n143\t#[inline(always)]\n144\tfn c_abs(a: f32) -> f32 {\n145\t    if a < 0.0 {\n146\t        -a\n147\t    } else {\n148\t        a\n149\t    }\n150\t}\n151\t\n152\t/* -------------------------------------------------------------------------- */\n153\t/*                              vector helpers                                */\n154\t/* -------------------------------------------------------------------------- */\n155\t\n156\t#[inline(never)]\n157\t#[unsafe(no_mangle)]\n158\tpub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n159\t    let mut a = c2v { x: 0.0, y: 0.0 };\n160\t    a.x = x;\n161\t    a.y = y;\n162\t    a\n163\t}\n164\t\n165\t#[inline(never)]\n166\t#[unsafe(no_mangle)]\n167\tpub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n168\t    a.x * b.x + a.y * b.y\n169\t}\n170\t\n171\t#[inline(never)]\n172\t#[unsafe(no_mangle)]\n173\tpub extern \"C\" fn c2Len(a: c2v) -> f32 {\n174\t    sqrtf(c2Dot(a, a))\n175\t}\n176\t\n177\t#[inline(never)]\n178\t#[unsafe(no_mangle)]\n179\tpub extern \"C\" fn c2Add(mut a: c2v, b: c2v) -> c2v {\n180\t    a.x += b.x;\n181\t    a.y += b.y;\n182\t    a\n183\t}\n184\t\n185\t#[inline(never)]\n186\t#[unsafe(no_mangle)]\n187\tpub extern \"C\" fn c2Sub(mut a: c2v, b: c2v) -> c2v {\n188\t    a.x -= b.x;\n189\t    a.y -= b.y;\n190\t    a\n191\t}\n192\t\n193\t#[inline(never)]\n194\t#[unsafe(no_mangle)]\n195\tpub extern \"C\" fn c2Mulvs(mut a: c2v, b: f32) -> c2v {\n196\t    a.x *= b;\n197\t    a.y *= b;\n198\t    a\n199\t}\n200\t\n201\t#[inline(never)]\n202\t#[unsafe(no_mangle)]\n203\tpub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n204\t    c2Mulvs(a, 1.0f32 / b)\n205\t}\n206\t\n207\t#[inline(never)]\n208\t#[unsafe(no_mangle)]\n209\tpub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n210\t    c2Div(a, c2Len(a))\n211\t}\n212\t\n213\t#[inline(never)]\n214\t#[unsafe(no_mangle)]\n215\tpub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n216\t    c2V(c_min(a.x, b.x), c_min(a.y, b.y))\n217\t}\n218\t\n219\t#[inline(never)]\n220\t#[unsafe(no_mangle)]\n221\tpub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n222\t    c2V(c_max(a.x, b.x), c_max(a.y, b.y))\n223\t}\n224\t\n225\t#[inline(never)]\n226\t#[unsafe(no_mangle)]\n227\tpub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n228\t    let mut b = c2v { x: 0.0, y: 0.0 };\n229\t    b.x = -a.y;\n230\t    b.y = a.x;\n231\t    b\n232\t}\n233\t\n234\t#[inline(never)]\n235\t#[unsafe(no_mangle)]\n236\tpub extern \"C\" fn c2Absv(a: c2v) -> c2v {\n237\t    c2V(c_abs(a.x), c_abs(a.y))\n238\t}\n239\t\n240\t#[inline(never)]\n241\t#[unsafe(no_mangle)]\n242\tpub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n243\t    let mut b = c2v { x: 0.0, y: 0.0 };\n244\t    b.x = a.y;\n245\t    b.y = -a.x;\n246\t    b\n247\t}\n248\t\n249\t#[inline(never)]\n250\t#[unsafe(no_mangle)]\n251\tpub extern \"C\" fn c2MulmvT(a: c2m, b: c2v) -> c2v {\n252\t    let mut c = c2v { x: 0.0, y: 0.0 };\n253\t    c.x = a.x.x * b.x + a.x.y * b.y;\n254\t    c.y = a.y.x * b.x + a.y.y * b.y;\n255\t    c\n256\t}\n257\t\n258\t/* -------------------------------------------------------------------------- */\n259\t/*                                  queries                                   */\n260\t/* -------------------------------------------------------------------------- */\n261\t\n262\t#[inline(never)]\n263\t#[unsafe(no_mangle)]\n264\tpub unsafe extern \"C\" fn c2RaytoCircle(A: c2Ray, B: c2Circle, out: *mut c2Raycast) -> c_int {\n265\t    let p: c2v = B.p;\n266\t    let m: c2v = c2Sub(A.p, p);\n267\t    let c: f32 = c2Dot(m, m) - B.r * B.r;\n268\t    let b: f32 = c2Dot(m, A.d);\n269\t    let disc: f32 = b * b - c;\n270\t    if disc < 0.0 {\n271\t        return 0;\n272\t    }\n273\t    let t: f32 = -b - sqrtf(disc);\n274\t    if t >= 0.0 && t <= A.t {\n275\t        unsafe {\n276\t            (*out).t = t;\n277\t        }\n278\t        let impact: c2v = c2Add(A.p, c2Mulvs(A.d, t));\n279\t        unsafe {\n280\t            (*out).n = c2Norm(c2Sub(impact, p));\n281\t        }\n282\t        return 1;\n283\t    }\n284\t    0\n285\t}\n286\t\n287\t#[inline(never)]\n288\t#[unsafe(no_mangle)]\n289\tpub extern \"C\" fn c2AABBtoAABB(A: c2AABB, B: c2AABB) -> c_int {\n290\t    let d0: c_int = (B.max.x < A.min.x) as c_int;\n291\t    let d1: c_int = (A.max.x < B.min.x) as c_int;\n292\t    let d2: c_int = (B.max.y < A.min.y) as c_int;\n293\t    let d3: c_int = (A.max.y < B.min.y) as c_int;\n294\t    /* C: return !(d0 | d1 | d2 | d3); */\n295\t    ((d0 | d1 | d2 | d3) == 0) as c_int\n296\t}\n297\t\n298\t/// `static inline float c2SignedDistPointToPlane_OneDimensional(float, float, float)`\n299\t#[inline(always)]\n300\tfn c2SignedDistPointToPlane_OneDimensional(p: f32, n: f32, d: f32) -> f32 {\n301\t    p * n - d * n\n302\t}\n303\t\n304\t/// `static inline float c2RayToPlane_OneDimensional(float, float)`\n305\t#[inline(always)]\n306\tfn c2RayToPlane_OneDimensional(da: f32, db: f32) -> f32 {\n307\t    if da < 0.0 {\n308\t        0.0\n309\t    } else if da * db > 0.0 {\n310\t        1.0f32\n311\t    } else {\n312\t        let d: f32 = da - db;\n313\t        if d != 0.0 {\n314\t            da / d\n315\t        } else {\n316\t            0.0\n317\t        }\n318\t    }\n319\t}\n320\t\n321\t#[inline(never)]\n322\t#[unsafe(no_mangle)]\n323\tpub unsafe extern \"C\" fn c2RaytoAABB(A: c2Ray, B: c2AABB, out: *mut c2Raycast) -> c_int {\n324\t    let p0: c2v = A.p;\n325\t    let p1: c2v = c2Add(A.p, c2Mulvs(A.d, A.t));\n326\t    let mut a_box = c2AABB {\n327\t        min: c2v { x: 0.0, y: 0.0 },\n328\t        max: c2v { x: 0.0, y: 0.0 },\n329\t    };\n330\t    a_box.min = c2Minv(p0, p1);\n331\t    a_box.max = c2Maxv(p0, p1);\n332\t    if c2AABBtoAABB(a_box, B) == 0 {\n333\t        return 0;\n334\t    }\n335\t    let ab: c2v = c2Sub(p1, p0);\n336\t    let n: c2v = c2Skew(ab);\n337\t    let abs_n: c2v = c2Absv(n);\n338\t    let half_extents: c2v = c2Mulvs(c2Sub(B.max, B.min), 0.5f32);\n339\t    let center_of_b_box: c2v = c2Mulvs(c2Add(B.min, B.max), 0.5f32);\n340\t    let d: f32 = c_abs(c2Dot(n, c2Sub(p0, center_of_b_box))) - c2Dot(abs_n, half_extents);\n341\t    if d > 0.0 {\n342\t        return 0;\n343\t    }\n344\t    let da0: f32 = c2SignedDistPointToPlane_OneDimensional(p0.x, -1.0f32, B.min.x);\n345\t    let db0: f32 = c2SignedDistPointToPlane_OneDimensional(p1.x, -1.0f32, B.min.x);\n346\t    let da1: f32 = c2SignedDistPointToPlane_OneDimensional(p0.x, 1.0f32, B.max.x);\n347\t    let db1: f32 = c2SignedDistPointToPlane_OneDimensional(p1.x, 1.0f32, B.max.x);\n348\t    let da2: f32 = c2SignedDistPointToPlane_OneDimensional(p0.y, -1.0f32, B.min.y);\n349\t    let db2: f32 = c2SignedDistPointToPlane_OneDimensional(p1.y, -1.0f32, B.min.y);\n350\t    let da3: f32 = c2SignedDistPointToPlane_OneDimensional(p0.y, 1.0f32, B.max.y);\n351\t    let db3: f32 = c2SignedDistPointToPlane_OneDimensional(p1.y, 1.0f32, B.max.y);\n352\t    let mut t0: f32 = c2RayToPlane_OneDimensional(da0, db0);\n353\t    let mut t1: f32 = c2RayToPlane_OneDimensional(da1, db1);\n354\t    let mut t2: f32 = c2RayToPlane_OneDimensional(da2, db2);\n355\t    let mut t3: f32 = c2RayToPlane_OneDimensional(da3, db3);\n356\t    let hit0: c_int = (t0 <= 1.0f32) as c_int;\n357\t    let hit1: c_int = (t1 <= 1.0f32) as c_int;\n358\t    let hit2: c_int = (t2 <= 1.0f32) as c_int;\n359\t    let hit3: c_int = (t3 <= 1.0f32) as c_int;\n360\t    let hit: c_int = hit0 | hit1 | hit2 | hit3;\n361\t    if hit != 0 {\n362\t        t0 = (hit0 as f32) * t0;\n363\t        t1 = (hit1 as f32) * t1;\n364\t        t2 = (hit2 as f32) * t2;\n365\t        t3 = (hit3 as f32) * t3;\n366\t        if t0 >= t1 && t0 >= t2 && t0 >= t3 {\n367\t            unsafe {\n368\t                (*out).t = t0 * A.t;\n369\t                (*out).n = c2V(-1.0, 0.0);\n370\t            }\n371\t        } else if t1 >= t0 && t1 >= t2 && t1 >= t3 {\n372\t            unsafe {\n373\t                (*out).t = t1 * A.t;\n374\t                (*out).n = c2V(1.0, 0.0);\n375\t            }\n376\t        } else if t2 >= t0 && t2 >= t1 && t2 >= t3 {\n377\t            unsafe {\n378\t                (*out).t = t2 * A.t;\n379\t                (*out).n = c2V(0.0, -1.0);\n380\t            }\n381\t        } else {\n382\t            unsafe {\n383\t                (*out).t = t3 * A.t;\n384\t                (*out).n = c2V(0.0, 1.0);\n385\t            }\n386\t        }\n387\t        1\n388\t    } else {\n389\t        0\n390\t    }\n391\t}\n392\t\n393\t#[inline(never)]\n394\t#[unsafe(no_mangle)]\n395\tpub extern \"C\" fn c2AABBtoPoint(A: c2AABB, B: c2v) -> c_int {\n396\t    let d0: c_int = (B.x < A.min.x) as c_int;\n397\t    let d1: c_int = (B.y < A.min.y) as c_int;\n398\t    let d2: c_int = (B.x > A.max.x) as c_int;\n399\t    let d3: c_int = (B.y > A.max.y) as c_int;\n400\t    /* C: return !(d0 | d1 | d2 | d3); */\n401\t    ((d0 | d1 | d2 | d3) == 0) as c_int\n402\t}\n403\t\n404\t#[inline(never)]\n405\t#[unsafe(no_mangle)]\n406\tpub extern \"C\" fn c2CircleToPoint(A: c2Circle, B: c2v) -> c_int {\n407\t    let n: c2v = c2Sub(A.p, B);\n408\t    let d2: f32 = c2Dot(n, n);\n409\t    (d2 < A.r * A.r) as c_int\n410\t}\n411\t\n412\t#[inline(never)]\n413\t#[unsafe(no_mangle)]\n414\tpub unsafe extern \"C\" fn c2RaytoCapsule(A: c2Ray, B: c2Capsule, out: *mut c2Raycast) -> c_int {\n415\t    let mut M = c2m {\n416\t        x: c2v { x: 0.0, y: 0.0 },\n417\t        y: c2v { x: 0.0, y: 0.0 },\n418\t    };\n419\t    M.y = c2Norm(c2Sub(B.b, B.a));\n420\t    M.x = c2CCW90(M.y);\n421\t    let cap_n: c2v = c2Sub(B.b, B.a);\n422\t    let yBb: c2v = c2MulmvT(M, cap_n);\n423\t    let yAp: c2v = c2MulmvT(M, c2Sub(A.p, B.a));\n424\t    let yAd: c2v = c2MulmvT(M, A.d);\n425\t    let yAe: c2v = c2Add(yAp, c2Mulvs(yAd, A.t));\n426\t    let mut capsule_bb = c2AABB {\n427\t        min: c2v { x: 0.0, y: 0.0 },\n428\t        max: c2v { x: 0.0, y: 0.0 },\n429\t    };\n430\t    capsule_bb.min = c2V(-B.r, 0.0);\n431\t    capsule_bb.max = c2V(B.r, yBb.y);\n432\t    unsafe {\n433\t        (*out).n = c2Norm(cap_n);\n434\t        (*out).t = 0.0;\n435\t    }\n436\t    if c2AABBtoPoint(capsule_bb, yAp) != 0 {\n437\t        return 1;\n438\t    } else {\n439\t        let mut capsule_a = c2Circle {\n440\t            p: c2v { x: 0.0, y: 0.0 },\n441\t            r: 0.0,\n442\t        };\n443\t        let mut capsule_b = c2Circle {\n444\t            p: c2v { x: 0.0, y: 0.0 },\n445\t            r: 0.0,\n446\t        };\n447\t        capsule_a.p = B.a;\n448\t        capsule_a.r = B.r;\n449\t        capsule_b.p = B.b;\n450\t        capsule_b.r = B.r;\n451\t        if c2CircleToPoint(capsule_a, A.p) != 0 {\n452\t            return 1;\n453\t        } else if c2CircleToPoint(capsule_b, A.p) != 0 {\n454\t            return 1;\n455\t        }\n456\t    }\n457\t    if yAe.x * yAp.x < 0.0 || c_min(c_abs(yAe.x), c_abs(yAp.x)) < B.r {\n458\t        let mut Ca = c2Circle {\n459\t            p: c2v { x: 0.0, y: 0.0 },\n460\t            r: 0.0,\n461\t        };\n462\t        let mut Cb = c2Circle {\n463\t            p: c2v { x: 0.0, y: 0.0 },\n464\t            r: 0.0,\n465\t        };\n466\t        Ca.p = B.a;\n467\t        Ca.r = B.r;\n468\t        Cb.p = B.b;\n469\t        Cb.r = B.r;\n470\t        if c_abs(yAp.x) < B.r {\n471\t            if yAp.y < 0.0 {\n472\t                return unsafe { c2RaytoCircle(A, Ca, out) };\n473\t            } else {\n474\t                return unsafe { c2RaytoCircle(A, Cb, out) };\n475\t            }\n476\t        } else {\n477\t            let c: f32 = if yAp.x > 0.0 { B.r } else { -B.r };\n478\t            let d: f32 = yAe.x - yAp.x;\n479\t            let t: f32 = (c - yAp.x) / d;\n480\t            let y: f32 = yAp.y + (yAe.y - yAp.y) * t;\n481\t            if y <= 0.0 {\n482\t                return unsafe { c2RaytoCircle(A, Ca, out) };\n483\t            }\n484\t            if y >= yBb.y {\n485\t                return unsafe { c2RaytoCircle(A, Cb, out) };\n486\t            } else {\n487\t                unsafe {\n488\t                    (*out).n = if c > 0.0 { M.x } else { c2Skew(M.y) };\n489\t                    (*out).t = t * A.t;\n490\t                }\n491\t                return 1;\n492\t            }\n493\t       