","+            lm_v2(f32::from_bits(0x1d3c_96bf), f32::from_bits(0x728d_180a)),","+        );","+        assert_eq!(bits(r), (0x7fe0_5aad, 0x7fe0_5aad));","+    }","+","+    #[test]","+    fn generic_point() {","+        let r = to_barycentric(","+            lm_v2(-5.5, 2.25),","+            lm_v2(7.125, -3.75),","+            lm_v2(0.5, 9.5),","+            lm_v2(1.0, 1.0),","+        );","+        assert_eq!(bits(r), (0x3e3a_6ec9, 0x3edb_4d9a));","+    }","+}"]}],"originalFile":"//! Rust translation of the C library in `c_src/`.\n//!\n//! Public ABI (as exported by the C shared library):\n//!   * `to_barycentric`\n//!\n//! The C source (`c_src/src/lib.c`) additionally defines the `static` helpers\n//! `lm_v2`, `lm_sub2` and `lm_dot2`; those have internal linkage and therefore\n//! are *not* part of the exported ABI. They are reproduced here as private\n//! functions so the arithmetic (and its exact ordering) is identical.\n\n#![allow(non_snake_case)]\n#![allow(non_camel_case_types)]\n\n/// `typedef struct lm_vec2 { float x, y; } lm_vec2;`\n///\n/// 8-byte aggregate of two `float`s. On the x86-64 SysV ABI this is classified\n/// as a single SSE eightbyte, which `repr(C)` + `extern \"C\"` reproduces exactly\n/// (passed/returned packed in an XMM register).\n#[repr(C)]\n#[derive(Copy, Clone, Debug, Default)]\npub struct lm_vec2 {\n    pub x: f32,\n    pub y: f32,\n}\n\n/// `static lm_vec2 lm_v2(float x, float y)`\n#[inline]\nfn lm_v2(x: f32, y: f32) -> lm_vec2 {\n    lm_vec2 { x, y }\n}\n\n/// `static lm_vec2 lm_sub2(lm_vec2 a, lm_vec2 b)`\n#[inline]\nfn lm_sub2(a: lm_vec2, b: lm_vec2) -> lm_vec2 {\n    lm_v2(a.x - b.x, a.y - b.y)\n}\n\n/// `static float lm_dot2(lm_vec2 a, lm_vec2 b)`\n#[inline]\nfn lm_dot2(a: lm_vec2, b: lm_vec2) -> f32 {\n    a.x * b.x + a.y * b.y\n}\n\n/// `lm_vec2 to_barycentric(lm_vec2 p1, lm_vec2 p2, lm_vec2 p3, lm_vec2 p)`\n///\n/// Note: this mirrors the C exactly, including the fact that the returned pair\n/// is `(u, v)` computed from the edges `p3 - p1` and `p2 - p1` (so the two\n/// coordinates are relative to those edges, in that order), and including the\n/// unguarded `1.0f / denom` division (degenerate triangles yield inf/NaN just\n/// as in C).\n#[unsafe(no_mangle)]\npub extern \"C\" fn to_barycentric(p1: lm_vec2, p2: lm_vec2, p3: lm_vec2, p: lm_vec2) -> lm_vec2 {\n    let v0: lm_vec2 = lm_sub2(p3, p1);\n    let v1: lm_vec2 = lm_sub2(p2, p1);\n    let v2: lm_vec2 = lm_sub2(p, p1);\n    let dot00: f32 = lm_dot2(v0, v0);\n    let dot01: f32 = lm_dot2(v0, v1);\n    let dot02: f32 = lm_dot2(v0, v2);\n    let dot11: f32 = lm_dot2(v1, v1);\n    let dot12: f32 = lm_dot2(v1, v2);\n    let invDenom: f32 = 1.0f32 / (dot00 * dot11 - dot01 * dot01);\n    let u: f32 = (dot11 * dot02 - dot01 * dot12) * invDenom;\n    let v: f32 = (dot00 * dot12 - dot01 * dot02) * invDenom;\n    lm_v2(u, v)\n}\n","userModified":false}}
