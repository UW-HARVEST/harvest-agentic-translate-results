      uint32_t *pc=(uint32_t*)&rc, *pr=(uint32_t*)&rr;\n                  printf(\"MISMATCH mode=%d in=(%.9g,%.9g)(%.9g,%.9g)(%.9g,%.9g)(%.9g,%.9g) C=%08x,%08x R=%08x,%08x\\n\",\n                    mode,a.x,a.y,b.x,b.y,c.x,c.y,d.x,d.y,pc[0],pc[1],pr[0],pr[1]);\n                }\n                bad++;\n            }\n        }\n    }\n    /* explicit edge cases */\n    v2 cases[][4] = {\n        {{0,0},{1,0},{0,1},{0.25f,0.25f}},\n        {{0,0},{1,0},{0,1},{2.0f,3.0f}},\n        {{0,0},{0,0},{0,0},{0,0}},                 /* degenerate -> 1/0 */\n        {{1,1},{1,1},{2,2},{3,3}},                 /* collinear */\n        {{-5.5f,2.25f},{7.125f,-3.75f},{0.5f,9.5f},{1.0f,1.0f}},\n        {{1e38f,1e38f},{-1e38f,2e38f},{3e-40f,-0.0f},{NAN,INFINITY}},\n    };\n    for(unsigned k=0;k<sizeof(cases)/sizeof(cases[0]);k++){\n        v2 rc=fc(cases[k][0],cases[k][1],cases[k][2],cases[k][3]);\n        v2 rr=fr(cases[k][0],cases[k][1],cases[k][2],cases[k][3]);\n        uint32_t *pc=(uint32_t*)&rc, *pr=(uint32_t*)&rr;\n        n++;\n        int ok = memcmp(&rc,&rr,sizeof(v2))==0;\n        if(!ok) bad++;\n        printf(\"edge[%u] C=%08x,%08x (%.9g,%.9g) R=%08x,%08x (%.9g,%.9g) %s\\n\",\n               k,pc[0],pc[1],rc.x,rc.y,pr[0],pr[1],rr.x,rr.y, ok?\"OK\":\"MISMATCH\");\n    }\n    printf(\"\\ncompared %ld calls, %ld bitwise mismatches\\n\", n, bad);\n    return bad!=0;\n}\nEOF\nsed -i 's/FLT_TRUE_MIN_PLACEHOLDER/1.4012985e-45f/' $TMPDIR/diff_test.c\nB=$TMPDIR/cb4 && cmake -S c_src -B $B -DCMAKE_BUILD_TYPE=Release >/dev/null 2>&1 && cmake --build $B >/dev/null 2>&1 \\\n&& gcc -O2 -o $TMPDIR/diff_test $TMPDIR/diff_test.c -ldl -lm \\\n&& C_SO=$B/libharvest-work-hu9sDw.so R_SO=$PWD/translation/target/release/libharvest_work_hu9sDw.so $TMPDIR/diff_test; echo \"exit=$?\"","description":"Run differential bitwise test between C and Rust libs"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":480,"cache_read_input_t