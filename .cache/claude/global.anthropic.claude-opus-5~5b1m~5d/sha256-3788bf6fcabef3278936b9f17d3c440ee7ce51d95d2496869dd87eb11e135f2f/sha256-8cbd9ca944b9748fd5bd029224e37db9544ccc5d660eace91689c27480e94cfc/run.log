on is then followed by a plain\n84\t/// byte truncation, which `as u8` provides.\n85\t#[inline]\n86\tfn f32_to_u8_c_cast(v: f32) -> u8 {\n87\t    // Widen to f64 for the range test: f32 -> f64 is exact, and the bounds\n88\t    // +/-2^31 are exactly representable in f64 (unlike in f32, where\n89\t    // 2147483647.0 rounds up to 2^31 and would wrongly be accepted).\n90\t    let truncated = v.trunc() as f64;\n91\t    let as_i32 = if v.is_nan() || truncated < -2147483648.0 || truncated >= 2147483648.0 {\n92\t        i32::MIN // 0x8000_0000: the x86 \"integer indefinite\" result\n93\t    } else {\n94\t        truncated as i32\n95\t    };\n96\t    as_i32 as u8\n97\t}\n98\t\n99\t/// ```c\n100\t/// static cb_rgb cbRemoveGammaRGB(cb_rgb RGB) {\n101\t///     cb_rgb Result = {\n102\t///         ((float)(RGB.R > 0.04045 ? pow((RGB.R + 0.055) / 1.055, 2.4)\n103\t///                                  : RGB.R / 12.92)), ... };\n104\t///     return Result;\n105\t/// }\n106\t/// ```\n107\t///\n108\t/// The comparison and both arms happen in `double` (the literals are `double`),\n109\t/// with a final narrowing to `float`.\n110\tfn cbRemoveGammaRGB(RGB: cb_rgb) -> cb_rgb {\n111\t    #[inline]\n112\t    fn channel(c: f32) -> f32 {\n113\t        let c = c as f64;\n114\t        // NaN takes the `else` arm, matching C's `>` (and the `comisd`/`ja`\n115\t        // pair in the reference build, which falls through when unordered).\n116\t        let v = if c > 0.04045 {\n117\t            unsafe { pow((c + 0.055) / 1.055, 2.4) }\n118\t        } else {\n119\t            c / 12.92\n120\t        };\n121\t        v as f32\n122\t    }\n123\t\n124\t    cb_rgb {\n125\t        R: channel(RGB.R),\n126\t        G: channel(RGB.G),\n127\t        B: channel(RGB.B),\n128\t    }\n129\t}\n130\t\n131\t/// ```c\n132\t/// static cb_rgb cbNorm(cb_rgb_255 RGB) {\n133\t///     cb_rgb Result = {((float)(RGB.R) / 255.f), ...};\n134\t///     return Result;\n135\t/// }\n136\t/// ```\n137\t///\n138\t/// `unsigned char