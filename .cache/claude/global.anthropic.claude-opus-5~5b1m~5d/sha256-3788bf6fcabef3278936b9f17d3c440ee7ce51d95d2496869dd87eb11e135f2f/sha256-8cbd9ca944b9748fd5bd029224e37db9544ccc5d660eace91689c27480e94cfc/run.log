\n194\t/// ```c\n195\t/// static void Tritanopia(float *Red, float *Green, float *Blue) {\n196\t///     float R = *Red, G = *Green, B = *Blue;\n197\t///     *Red = R + 0.12739886310880f * G - 0.12739886341072f * B;\n198\t///     *Green = -4.486E-11f * R + 0.87390929928361f * G + 0.12609070101523f * B;\n199\t///     *Blue = 3.1113E-10f * R + 0.87390929725848f * G + 0.12609070067115f * B;\n200\t/// }\n201\t/// ```\n202\t///\n203\t/// All coefficients are `f32` literals, so the whole matrix is single\n204\t/// precision. The three inputs are snapshotted first, exactly as the C does,\n205\t/// so later rows see the original values rather than the just-written ones.\n206\tfn Tritanopia(Red: &mut f32, Green: &mut f32, Blue: &mut f32) {\n207\t    let R: f32 = *Red;\n208\t    let G: f32 = *Green;\n209\t    let B: f32 = *Blue;\n210\t    *Red = R + 0.12739886310880f32 * G - 0.12739886341072f32 * B;\n211\t    *Green = -4.486E-11f32 * R + 0.87390929928361f32 * G + 0.12609070101523f32 * B;\n212\t    *Blue = 3.1113E-10f32 * R + 0.87390929725848f32 * G + 0.12609070067115f32 * B;\n213\t}\n214\t\n215\t/// ```c\n216\t/// cb_rgb_255 tritanopia(cb_rgb_255 RGB) {\n217\t///     cb_rgb RGBNorm = cbRemoveGammaRGB(cbNorm(RGB));\n218\t///     Tritanopia(&RGBNorm.R, &RGBNorm.G, &RGBNorm.B);\n219\t///     cb_rgb_255 Result = cbDenorm(cbApplyGammaRGB(RGBNorm));\n220\t///     return Result;\n221\t/// }\n222\t/// ```\n223\t///\n224\t/// The one and only exported symbol of the library.\n225\t#[unsafe(no_mangle)]\n226\tpub extern \"C\" fn tritanopia(RGB: cb_rgb_255) -> cb_rgb_255 {\n227\t    let mut RGBNorm = cbRemoveGammaRGB(cbNorm(RGB));\n228\t    Tritanopia(&mut RGBNorm.R, &mut RGBNorm.G, &mut RGBNorm.B);\n229\t    cbDenorm(cbApplyGammaRGB(RGBNorm))\n230\t}\n231\t"}]},"parent_tool_use_id":null,"session_id":"3c9c1f91-98fb-455f-8755-8a91744505db","uuid":"2458cad4-21fd-4031-a82a-adcfe3c3811e","timestamp":"2026-09-05T02:14:05.689Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/sch