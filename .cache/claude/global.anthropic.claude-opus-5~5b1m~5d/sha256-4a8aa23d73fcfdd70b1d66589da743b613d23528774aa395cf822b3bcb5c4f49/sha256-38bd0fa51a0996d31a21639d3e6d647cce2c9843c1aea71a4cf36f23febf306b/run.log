00FFFFu, 0x80000000u};\n    puts(\"input      -> C output   | Rust output\");\n    for (size_t i = 0; i < sizeof spots / sizeof *spots; i++) {\n        uint32_t x = spots[i], c = c_rev16(x), r = r_rev16(x);\n        printf(\"0x%08X -> 0x%08X | 0x%08X  %s\\n\", x, c, r, c == r ? \"ok\" : \"MISMATCH\");\n    }\n\n    /* Exhaustive sweep over all 2^32 inputs. */\n    uint64_t mismatches = 0;\n    uint32_t first_bad = 0;\n    uint32_t x = 0;\n    do {\n        if (c_rev16(x) != r_rev16(x)) {\n            if (mismatches == 0) first_bad = x;\n            mismatches++;\n        }\n        x++;\n    } while (x != 0);\n\n    if (mismatches) {\n        printf(\"\\nFAIL: %llu mismatches over 2^32 inputs; first at 0x%08X \"\n               \"(C=0x%08X Rust=0x%08X)\\n\",\n               (unsigned long long)mismatches, first_bad, c_rev16(first_bad),\n               r_rev16(first_bad));\n        return 1;\n    }\n    puts(\"\\nPASS: exhaustive sweep over all 4294967296 uint32_t inputs matched \"\n         \"byte-for-byte.\");\n    return 0;\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
