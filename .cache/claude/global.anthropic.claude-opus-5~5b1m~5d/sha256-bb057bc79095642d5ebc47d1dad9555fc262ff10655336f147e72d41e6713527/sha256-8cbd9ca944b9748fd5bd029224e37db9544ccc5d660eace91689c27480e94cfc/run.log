{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_018i13raG5hVygczB4ZHJouz","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/` (an inlined copy of stb_ds.h\n2\t//! plus the `strkey` / `str_put` driver code from `src/lib.c`).\n3\t//!\n4\t//! The translation is deliberately literal: every quirk of the original C\n5\t//! (including implicit `int` sign-extension in the SipHash byte loading, the\n6\t//! missing `temp_key` update in the wrap-around branch of `stbds_hmput_key`,\n7\t//! and the `printf(\"%s %d\\n\", struct_by_value, ...)` call in `str_put`) is\n8\t//! reproduced bit for bit.\n9\t//!\n10\t//! All heap memory is managed through libc `realloc`/`free` so that pointers\n11\t//! handed out by / passed into this library remain interchangeable with the\n12\t//! ones from the original C implementation.\n13\t\n14\t#![allow(non_camel_case_types)]\n15\t#![allow(non_upper_case_globals)]\n16\t#![allow(unused_assignments)]\n17\t\n18\tuse core::ffi::{c_char, c_int, c_void};\n19\tuse core::ptr;\n20\t\n21\t// ---------------------------------------------------------------------------\n22\t// libc bindings (STBDS_REALLOC / STBDS_FREE and the string/stdio helpers)\n23\t// ---------------------------------------------------------------------------\n24\t\n25\textern \"C\" {\n26\t    fn realloc(p: *mut c_void, size: usize) -> *mut c_void;\n27\t    fn free(p: *mut c_void);\n28\t    fn memset(s: *mut c_void, c: c_int, n: usize) -> *mut c_void;\n29\t    fn memcpy(d: *mut c_void, s: *const c_void, n: usize) -> *mut c_void;\n30\t    fn memmove(d: *mut c_void, s: *const c_void, n: usize) -> *mut c_void;\n31\t    fn memcmp(a: *const c_void, b: *const c_void, n: usize) -> c_int;\n32\t    fn strcmp(a: *const c_char, b: *const c_char) -> c_int;\n33\t    fn strlen(s: *const c_char) -> usize;\n34\t    fn printf(fmt: *const c_char, ...) -> c_int;\n35\t    fn sprintf(buf: *mut c_char, fmt: *const c_char, ...) -> c_int;\n36\t}\n37\t\n38\t#[inline(always)]\n39\tunsafe fn stbds_realloc(p: *mut c_void, size: usize) -> *mut c_void {\n40\t    realloc(p, size)\n41\t}\n42\t\n43\t#[inline(always)]\n44\tunsafe fn stbds_free(p: *mut c_void) {\n45\t    free(p)\n46\t}\n47\t\n48\t// ---------------------------------------------------------------------------\n49\t// Types\n50\t// ---------------------------------------------------------------------------\n51\t\n52\t#[repr(C)]\n53\t#[derive(Clone, Copy)]\n54\tstruct stbds_array_header {\n55\t    length: usize,\n56\t    capacity: usize,\n57\t    hash_table: *mut c_void,\n58\t    temp: isize,\n59\t}\n60\t\n61\t#[repr(C)]\n62\tstruct stbds_string_block {\n63\t    next: *mut stbds_string_block,\n64\t    storage: [c_char; 8],\n65\t}\n66\t\n67\t#[repr(C)]\n68\t#[derive(Clone, Copy)]\n69\tpub struct stbds_string_arena {\n70\t    storage: *mut stbds_string_block,\n71\t    remaining: usize,\n72\t    block: u8,\n73\t    mode: u8,\n74\t}\n75\t\n76\tconst STBDS_BUCKET_LENGTH: usize = 8;\n77\tconst STBDS_BUCKET_SHIFT: usize = 3;\n78\tconst STBDS_BUCKET_MASK: usize = STBDS_BUCKET_LENGTH - 1;\n79\tconst STBDS_CACHE_LINE_SIZE: usize = 64;\n80\t\n81\t#[repr(C)]\n82\tstruct stbds_hash_bucket {\n83\t    hash: [usize; STBDS_BUCKET_LENGTH],\n84\t    index: [isize; STBDS_BUCKET_LENGTH],\n85\t}\n86\t\n87\t#[repr(C)]\n88\tstruct stbds_hash_index {\n89\t    temp_key: *mut c_char,\n90\t    slot_count: usize,\n91\t    used_count: usize,\n92\t    used_count_threshold: usize,\n93\t    used_count_shrink_threshold: usize,\n94\t    tombstone_count: usize,\n95\t    tombstone_count_threshold: usize,\n96\t    seed: usize,\n97\t    slot_count_log2: usize,\n98\t    string: stbds_string_arena,\n99\t    storage: *mut stbds_hash_bucket,\n100\t}\n101\t\n102\tconst STBDS_INDEX_EMPTY: isize = -1;\n103\tconst STBDS_INDEX_DELETED: isize = -2;\n104\t\n105\tconst STBDS_HASH_EMPTY: usize = 0;\n106\tconst STBDS_HASH_DELETED: usize = 1;\n107\t\n108\t#[allow(dead_code)]\n109\tconst STBDS_HM_BINARY: c_int = 0;\n110\tconst STBDS_HM_STRING: c_int = 1;\n111\t\n112\tconst STBDS_SH_NONE: c_int = 0;\n113\tconst STBDS_SH_DEFAULT: c_int = 1;\n114\tconst STBDS_SH_STRDUP: c_int = 2;\n115\tconst STBDS_SH_ARENA: c_int = 3;\n116\t\n117\tconst HEADER_SIZE: usize = core::mem::size_of::<stbds_array_header>();\n118\t\n119\t// ---------------------------------------------------------------------------\n120\t// Macro helpers\n121\t// ---------------------------------------------------------------------------\n122\t\n123\t/// `stbds_header(t)` -- `((stbds_array_header *) (t) - 1)`\n124\t#[inline(always)]\n125\tfn stbds_header(t: *mut c_void) -> *mut stbds_array_header {\n126\t    ((t as usize).wrapping_sub(HEADER_SIZE)) as *mut stbds_array_header\n127\t}\n128\t\n129\t/// `stbds_arrlen(a)`\n130\t#[inline(always)]\n131\tunsafe fn stbds_arrlen(a: *mut c_void) -> isize {\n132\t    if !a.is_null() {\n133\t        (*stbds_header(a)).length as isize\n134\t    } else {\n135\t        0\n136\t    }\n137\t}\n138\t\n139\t/// `stbds_arrcap(a)`\n140\t#[inline(always)]\n141\tunsafe fn stbds_arrcap(a: *mut c_void) -> usize {\n142\t    if !a.is_null() {\n143\t        (*stbds_header(a)).capacity\n144\t    } else {\n145\t        0\n146\t    }\n147\t}\n148\t\n149\t/// `stbds_temp(t)` (read)\n150\t#[inline(always)]\n151\tunsafe fn stbds_temp(t: *mut c_void) -> isize {\n152\t    (*stbds_header(t)).temp\n153\t}\n154\t\n155\t/// `stbds_temp(t) = v`\n156\t#[inline(always)]\n157\tunsafe fn stbds_set_temp(t: *mut c_void, v: isize) {\n158\t    (*stbds_header(t)).temp = v;\n159\t}\n160\t\n161\t/// `stbds_temp_key(t) = v` -- `(*(char **) stbds_header(t)->hash_table) = v`\n162\t#[inline(always)]\n163\tunsafe fn stbds_set_temp_key(t: *mut c_void, v: *mut c_char) {\n164\t    let ht = (*stbds_header(t)).hash_table as *mut *mut c_char;\n165\t    *ht = v;\n166\t}\n167\t\n168\t/// `stbds_hash_table(a)` -- `((stbds_hash_index *) stbds_header(a)->hash_table)`\n169\t#[inline(always)]\n170\tunsafe fn stbds_hash_table(a: *mut c_void) -> *mut stbds_hash_index {\n171\t    (*stbds_header(a)).hash_table as *mut stbds_hash_index\n172\t}\n173\t\n174\t/// `STBDS_HASH_TO_ARR(x,elemsize)` -- `((char *) (x) - (elemsize))`\n175\t#[inline(always)]\n176\tfn stbds_hash_to_arr(x: *mut c_void, elemsize: usize) -> *mut c_void {\n177\t    ((x as usize).wrapping_sub(elemsize)) as *mut c_void\n178\t}\n179\t\n180\t/// `STBDS_ARR_TO_HASH(x,elemsize)` -- `((char *) (x) + (elemsize))`\n181\t#[inline(always)]\n182\tfn stbds_arr_to_hash(x: *mut c_void, elemsize: usize) -> *mut c_void {\n183\t    ((x as usize).wrapping_add(elemsize)) as *mut c_void\n184\t}\n185\t\n186\t/// `(char *) a + elemsize*i + keyoffset`\n187\t#[inline(always)]\n188\tfn elem_ptr(a: *mut c_void, elemsize: usize, i: usize, keyoffset: usize) -> *mut c_void {\n189\t    ((a as usize)\n190\t        .wrapping_add(elemsize.wrapping_mul(i))\n191\t        .wrapping_add(keyoffset)) as *mut c_void\n192\t}\n193\t\n194\t/// `STBDS_ALIGN_FWD(n,a)` -- `(((n) + (a) - 1) & ~((a)-1))`\n195\t#[inline(always)]\n196\tfn stbds_align_fwd(n: usize, a: usize) -> usize {\n197\t    n.wrapping_add(a - 1) & !(a - 1)\n198\t}\n199\t\n200\t/// `STBDS_INDEX_IN_USE(x)` -- `((x) >= 0)`\n201\t#[inline(always)]\n202\tfn stbds_index_in_use(x: isize) -> bool {\n203\t    x >= 0\n204\t}\n205\t\n206\tconst STBDS_SIZE_T_BITS: u32 = (core::mem::size_of::<usize>() as u32) * 8;\n207\t\n208\t#[inline(always)]\n209\tfn stbds_rotate_left(val: usize, n: u32) -> usize {\n210\t    (val << n) | (val >> (STBDS_SIZE_T_BITS - n))\n211\t}\n212\t\n213\t#[inline(always)]\n214\tfn stbds_rotate_right(val: usize, n: u32) -> usize {\n215\t    (val >> n) | (val << (STBDS_SIZE_T_BITS - n))\n216\t}\n217\t\n218\t// ---------------------------------------------------------------------------\n219\t// stbds_arrgrowf / stbds_arrfreef\n220\t// ---------------------------------------------------------------------------\n221\t\n222\t#[unsafe(no_mangle)]\n223\tpub unsafe extern \"C\" fn stbds_arrgrowf(\n224\t    a: *mut c_void,\n225\t    elemsize: usize,\n226\t    addlen: usize,\n227\t    min_cap: usize,\n228\t) -> *mut c_void {\n229\t    let mut min_cap = min_cap;\n230\t    let b: *mut c_void;\n231\t    let min_len: usize = (stbds_arrlen(a) as usize).wrapping_add(addlen);\n232\t\n233\t    if min_len > min_cap {\n234\t        min_cap = min_len;\n235\t    }\n236\t\n237\t    if min_cap <= stbds_arrcap(a) {\n238\t        return a;\n239\t    }\n240\t\n241\t    if min_cap < stbds_arrcap(a).wrapping_mul(2) {\n242\t        min_cap = stbds_arrcap(a).wrapping_mul(2);\n243\t    } else if min_cap < 4 {\n244\t        min_cap = 4;\n245\t    }\n246\t\n247\t    let old: *mut c_void = if !a.is_null() {\n248\t        stbds_header(a) as *mut c_void\n249\t    } else {\n250\t        ptr::null_mut()\n251\t    };\n252\t    let raw = stbds_realloc(\n253\t        old,\n254\t        elemsize.wrapping_mul(min_cap).wrapping_add(HEADER_SIZE),\n255\t    );\n256\t    b = ((raw as usize).wrapping_add(HEADER_SIZE)) as *mut c_void;\n257\t    if a.is_null() {\n258\t        (*stbds_header(b)).length = 0;\n259\t        (*stbds_header(b)).hash_table = ptr::null_mut();\n260\t        (*stbds_header(b)).temp = 0;\n261\t    }\n262\t    (*stbds_header(b)).capacity = min_cap;\n263\t\n264\t    b\n265\t}\n266\t\n267\t#[unsafe(no_mangle)]\n268\tpub unsafe extern \"C\" fn stbds_arrfreef(a: *mut c_void) {\n269\t    stbds_free(stbds_header(a) as *mut c_void);\n270\t}\n271\t\n272\t// ---------------------------------------------------------------------------\n273\t// hash seed / hash index construction\n274\t// ---------------------------------------------------------------------------\n275\t\n276\tstatic mut stbds_hash_seed: usize = 0x31415926;\n277\t\n278\t#[unsafe(no_mangle)]\n279\tpub unsafe extern \"C\" fn stbds_rand_seed(seed: usize) {\n280\t    stbds_hash_seed = seed;\n281\t}\n282\t\n283\t/// `stbds_load_32_or_64(var, temp, v32, v64_hi, v64_lo)`\n284\t#[inline(always)]\n285\tfn stbds_load_32_or_64(v32: usize, v64_hi: usize, v64_lo: usize) -> usize {\n286\t    let mut temp: usize = v64_lo ^ v32;\n287\t    temp <<= 16;\n288\t    temp <<= 16;\n289\t    temp >>= 16;\n290\t    temp >>= 16;\n291\t    let mut var: usize = v64_hi;\n292\t    var <<= 16;\n293\t    var <<= 16;\n294\t    var ^= temp ^ v32;\n295\t    var\n296\t}\n297\t\n298\tfn stbds_probe_position(hash: usize, slot_count: usize, _slot_log2: usize) -> usize {\n299\t    hash & (slot_count.wrapping_sub(1))\n300\t}\n301\t\n302\tfn stbds_log2(slot_count: usize) -> usize {\n303\t    let mut slot_count = slot_count;\n304\t    let mut n: usize = 0;\n305\t    while slot_count > 1 {\n306\t        slot_count >>= 1;\n307\t        n += 1;\n308\t    }\n309\t    n\n310\t}\n311\t\n312\tunsafe fn stbds_make_hash_index(\n313\t    slot_count: usize,\n314\t    ot: *mut stbds_hash_index,\n315\t) -> *mut stbds_hash_index {\n316\t    let t: *mut stbds_hash_index = stbds_realloc(\n317\t        ptr::null_mut(),\n318\t        (slot_count >> STBDS_BUCKET_SHIFT)\n319\t            .wrapping_mul(core::mem::size_of::<stbds_hash_bucket>())\n320\t            .wrapping_add(core::mem::size_of::<stbds_hash_index>())\n321\t            .wrapping_add(STBDS_CACHE_LINE_SIZE - 1),\n322\t    ) as *mut stbds_hash_index;\n323\t\n324\t    (*t).storage = stbds_align_fwd(\n325\t        (t as usize).wrapping_add(core::mem::size_of::<stbds_hash_index>()),\n326\t        STBDS_CACHE_LINE_SIZE,\n327\t    ) as *mut stbds_hash_bucket;\n328\t    (*t).slot_count = slot_count;\n329\t    (*t).slot_count_log2 = stbds_log2(slot_count);\n330\t    (*t).tombstone_count = 0;\n331\t    (*t).used_count = 0;\n332\t\n333\t    (*t).used_count_threshold = slot_count.wrapping_sub(slot_count >> 2);\n334\t    (*t).tombstone_count_threshold = (slot_count >> 3).wrapping_add(slot_count >> 4);\n335\t    (*t).used_count_shrink_threshold = slot_count >> 2;\n336\t\n337\t    if slot_count <= STBDS_BUCKET_LENGTH {\n338\t        (*t).used_count_shrink_threshold = 0;\n339\t    }\n340\t\n341\t    if !ot.is_null() {\n342\t        (*t).string = (*ot).string;\n343\t        (*t).seed = (*ot).seed;\n344\t    } else {\n345\t        memset(\n346\t            ptr::addr_of_mut!((*t).string) as *mut c_void,\n347\t            0,\n348\t            core::mem::size_of::<stbds_string_arena>(),\n349\t        );\n350\t        (*t).seed = stbds_hash_seed;\n351\t        let a = stbds_load_32_or_64(2147001325, 0x27bb2ee6, 0x87b0b0fd);\n352\t        let b = stbds_load_32_or_64(715136305, 0, 0xb504f32d);\n353\t        stbds_hash_seed = stbds_hash_seed.wrapping_mul(a).wrapping_add(b);\n354\t    }\n355\t\n356\t    {\n357\t        let mut i: usize = 0;\n358\t        while i < slot_count >> STBDS_BUCKET_SHIFT {\n359\t            let b: *mut stbds_hash_bucket = (*t).storage.add(i);\n360\t            let mut j: usize = 0;\n361\t            while j < STBDS_BUCKET_LENGTH {\n362\t                (*b).hash[j] = STBDS_HASH_EMPTY;\n363\t                j += 1;\n364\t            }\n365\t            j = 0;\n366\t            while j < STBDS_BUCKET_LENGTH {\n367\t                (*b).index[j] = STBDS_INDEX_EMPTY;\n368\t                j += 1;\n369\t            }\n370\t            i += 1;\n371\t        }\n372\t    }\n373\t\n374\t    if !ot.is_null() {\n375\t        (*t).used_count = (*ot).used_count;\n376\t        let mut i: usize = 0;\n377\t        while i < (*ot).slot_count >> STBDS_BUCKET_SHIFT {\n378\t            let ob: *mut stbds_hash_bucket = (*ot).storage.add(i);\n379\t            let mut j: usize = 0;\n380\t            while j < STBDS_BUCKET_LENGTH {\n381\t                if stbds_index_in_use((*ob).index[j]) {\n382\t                    let hash = (*ob).hash[j];\n383\t                    let mut pos =\n384\t                        stbds_probe_position(hash, (*t).slot_count, (*t).slot_count_log2);\n385\t                    let mut step = STBDS_BUCKET_LENGTH;\n386\t                    'done: loop {\n387\t                        let bucket: *mut stbds_hash_bucket =\n388\t                            (*t).storage.add(pos >> STBDS_BUCKET_SHIFT);\n389\t\n390\t                        let mut z = pos & STBDS_BUCKET_MASK;\n391\t                        while z < STBDS_BUCKET_LENGTH {\n392\t                            if (*bucket).hash[z] == 0 {\n393\t                                (*bucket).hash[z] = hash;\n394\t                                (*bucket).index[z] = (*ob).index[j];\n395\t                                break 'done;\n396\t                            }\n397\t                            z += 1;\n398\t                        }\n399\t\n400\t                        let limit = pos & STBDS_BUCKET_MASK;\n401\t                        z = 0;\n402\t                        let mut hit = false;\n403\t                        while z < limit {\n404\t                            if (*bucket).hash[z] == 0 {\n405\t                                (*bucket).hash[z] = hash;\n406\t                                (*bucket).index[z] = (*ob).index[j];\n407\t                                hit = true;\n408\t                                break;\n409\t                            }\n410\t                            z += 1;\n411\t                        }\n412\t                        if hit {\n413\t                            break 'done;\n414\t                        }\n415\t\n416\t                        pos = pos.wrapping_add(step);\n417\t                        step = step.wrapping_add(STBDS_BUCKET_LENGTH);\n418\t                        pos &= (*t).slot_count.wrapping_sub(1);\n419\t                    }\n420\t                }\n421\t                j += 1;\n422\t            }\n423\t            i += 1;\n424\t        }\n425\t    }\n426\t\n427\t    t\n428\t}\n429\t\n430\t// ---------------------------------------------------------------------------\n431\t// hash functions\n432\t// ---------------------------------------------------------------------------\n433\t\n434\t#[unsafe(no_mangle)]\n435\tpub unsafe extern \"C\" fn stbds_hash_string(str_: *mut c_char, seed: usize) -> usize {\n436\t    let mut hash: usize = seed;\n437\t    let mut s = str_ as *const u8;\n438\t    while *s != 0 {\n439\t        hash = stbds_rotate_left(hash, 9).wrapping_add(*s as usize);\n440\t        s = s.add(1);\n441\t    }\n442\t\n443\t    hash ^= seed;\n444\t    hash = (!hash).wrapping_add(hash << 18);\n445\t    hash ^= hash ^ stbds_rotate_right(hash, 31);\n446\t    hash = hash.wrapping_mul(21);\n447\t    hash ^= hash ^ stbds_rotate_right(hash, 11);\n448\t    hash = hash.wrapping_add(hash << 6);\n449\t    hash ^= stbds_rotate_right(hash, 22);\n450\t    hash.wrapping_add(seed)\n451\t}\n452\t\n453\tconst STBDS_SIPHASH_C_ROUNDS: usize = 2;\n454\tconst STBDS_SIPHASH_D_ROUNDS: usize = 4;\n455\t\n456\t/// Mirrors `d[0] | (d[1] << 8) | (d[2] << 16) | (d[3] << 24)` evaluated in\n457\t/// `int` arithmetic and then converted to `size_t` (i.e. sign-extended when\n458\t/// the top byte has its high bit set -- exactly what the C code does).\n459\t#[inline(always)]\n460\tunsafe fn load_int_le32_sign_extended(d: *const u8) -> usize {\n461\t    let v: u32 = (*d.add(0) as u32)\n462\t        | ((*d.add(1) as u32) << 8)\n463\t        | ((*d.add(2) as u32) << 16)\n464\t        | ((*d.add(3) as u32) << 24);\n465\t    (v as i32) as isize as usize\n466\t}\n467\t\n468\tunsafe fn stbds_siphash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n469\t    let mut d = p as *const u8;\n470\t    let mut i: usize;\n471\t    let mut j: usize;\n472\t    let mut v0: usize;\n473\t    let mut v1: usize;\n474\t    let mut v2: usize;\n475\t    let mut v3: usize;\n476\t    let mut data: usize;\n477\t\n478\t    v0 = ((0x736f6d65usize << 16) << 16).wrapping_add(0x70736575) ^ seed;\n479\t    v1 = ((0x646f7261usize << 16) << 16).wrapping_add(0x6e646f6d) ^ !seed;\n480\t    v2 = ((0x6c796765usize << 16) << 16).wrapping_add(0x6e657261) ^ seed;\n481\t    v3 = ((0x74656462usize << 16) << 16).wrapping_add(0x79746573) ^ !seed;\n482\t\n483\t    v0 ^= 0x0706050403020100u64 as usize ^ seed;\n484\t    v1 ^= 0x0f0e0d0c0b0a0908u64 as usize ^ !seed;\n485\t    v2 ^= 0x0706050403020100u64 as usize ^ seed;\n486\t    v3 ^= 0x0f0e0d0c0b0a0908u64 as usize ^ !seed;\n487\t\n488\t    macro_rules! sipround {\n489\t        () => {{\n490\t            v0 = v0.wrapping_add(v1);\n491\t            v1 = stbds_rotate_left(v1, 13);\n492\t            v1 ^= v0;\n493\t            v0 = stbds_rotate_left(v0, STBDS_SIZE_T_BITS / 2);\n494\t            v2 = v2.wrapping_add(v3);\n495\t            v3 = stbds_rotate_left(v3, 16);\n496\t            v3 ^= v2;\n497\t            v2 = v2.wrapping_add(v1);\n498\t            v1 = stbds_rotate_left(v1, 17);\n499\t            v1 ^= v2;\n500\t            v2 = stbds_rotate_left(v2, STBDS_SIZE_T_BITS / 2);\n501\t            v0 = v0.wrapping_add(v3);\n502\t            v3 = stbds_rotate_left(v3, 21);\n503\t            v3 ^= v0;\n504\t        }};\n505\t    }\n506\t\n507\t    i = 0;\n508\t    while i.wrapping_add(core::mem::size_of::<usize>()) <= len {\n509\t        // data = d[0] | (d[1] << 8) | (d[2] << 16) | (d[3] << 24);\n510\t        data = load_int_le32_sign_extended(d);\n511\t        // data |= (size_t) (d[4] | (d[5] << 8) | (d[6] << 16) | (d[7] << 24)) << 16 << 16;\n512\t        data |= (load_int_le32_sign_extended(d.add(4)) << 16) << 16;\n513\t\n514\t        v3 ^= data;\n515\t        j = 0;\n516\t        while j < STBDS_SIPHASH_C_ROUNDS {\n517\t            sipround!();\n518\t            j += 1;\n519\t        }\n520\t        v0 ^= data;\n521\t\n522\t        i = i.wrapping_add(core::mem::size_of::<usize>());\n523\t        d = d.add(core::mem::size_of::<usize>());\n524\t    }\n525\t\n526\t    data = len << (STBDS_SIZE_T_BITS - 8);\n527\t    let tail = len.wrapping_sub(i);\n528\t    // Fall-through switch from the C original.\n529\t    if tail >= 7 {\n530\t        data |= ((*d.add(6) as usize) << 24) << 24;\n531\t    }\n532\t    if tail >= 6 {\n533\t        data |= ((*d.add(5) as usize) << 20) << 20;\n534\t    }\n535\t    if tail >= 5 {\n536\t        data |= ((*d.add(4) as usize) << 16) << 16;\n537\t    }\n538\t    if tail >= 4 {\n539\t        // `data |= (d[3] << 24);` -- int arithmetic, hence sign extension.\n540\t        data |= (((*d.add(3) as u32) << 24) as i32) as isize as usize;\n541\t    }\n542\t    if tail >= 3 {\n543\t        data |= (*d.add(2) as usize) << 16;\n544\t    }\n545\t    if tail >= 2 {\n546\t        data |= (*d.add(1) as usize) << 8;\n547\t    }\n548\t    if tail >= 1 {\n549\t        data |= *d.add(0) as usize;\n550\t    }\n551\t\n552\t    v3 ^= data;\n553\t    j = 0;\n554\t    while j < STBDS_SIPHASH_C_ROUNDS {\n555\t        sipround!();\n556\t        j += 1;\n557\t    }\n558\t    v0 ^= data;\n559\t    v2 ^= 0xff;\n560\t    j = 0;\n561\t    while j < STBDS_SIPHASH_D_ROUNDS {\n562\t        sipround!();\n563\t        j += 1;\n564\t    }\n565\t\n566\t    v0 ^ v1 ^ v2 ^ v3\n567\t}\n568\t\n569\t#[unsafe(no_mangle)]\n570\tpub unsafe extern \"C\" fn stbds_hash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n571\t    stbds_siphash_bytes(p, len, seed)\n572\t}\n573\t\n574\t// ---------------------------------------------------------------------------\n575\t// hash map internals\n576\t// ---------------------------------------------------------------------------\n577\t\n578\tunsafe fn stbds_is_key_equal(\n579\t    a: *mut c_void,\n580\t    elemsize: usize,\n581\t    key: *mut c_void,\n582\t    keysize: usize,\n583\t    keyoffset: usize,\n584\t    mode: c_int,\n585\t    i: usize,\n586\t) -> c_int {\n587\t    if mode >= STBDS_HM_STRING {\n588\t        let stored = *(elem_ptr(a, elemsize, i, keyoffset) as *mut *mut c_char);\n589\t        (strcmp(key as *const c_char, stored) == 0) as c_int\n590\t    } else {\n591\t        (memcmp(\n592\t            key as *const c_void,\n593\t            elem_ptr(a, elemsize, i, keyoffset) as *const c_void,\n594\t            keysize,\n595\t        ) == 0) as c_int\n596\t    }\n597\t}\n598\t\n599\t#[unsafe(no_mangle)]\n600\tpub unsafe extern \"C\" fn stbds_hmfree_func(a: *mut c_void, elemsize: usize) {\n601\t    if a.is_null() {\n602\t        return;\n603\t    }\n604\t    if !stbds_hash_table(a).is_null() {\n605\t        if (*stbds_hash_table(a)).string.mode == STBDS_SH_STRDUP as u8 {\n606\t            let mut i: usize = 1;\n607\t            while i < (*stbds_header(a)).length {\n608\t                stbds_free(*(elem_ptr(a, elemsize, i, 0) as *mut *mut c_char) as *mut c_void);\n609\t                i += 1;\n610\t            }\n611\t        }\n612\t        stbds_strreset(ptr::addr_of_mut!((*stbds_hash_table(a)).string));\n613\t    }\n614\t    stbds_free((*stbds_header(a)).hash_table);\n615\t    stbds_free(stbds_header(a) as *mut c_void);\n616\t}\n617\t\n618\tunsafe fn stbds_hm_find_slot(\n619\t    a: *mut c_void,\n620\t    elemsize: usize,\n621\t    key: *mut c_void,\n622\t    keysize: usize,\n623\t    keyoffset: usize,\n624\t    mode: c_int,\n625\t) -> isize {\n626\t    let raw_a = stbds_hash_to_arr(a, elemsize);\n627\t    let table = stbds_hash_table(raw_a);\n628\t    let mut hash = if mode >= STBDS_HM_STRING {\n629\t        stbds_hash_string(key as *mut c_char, (*table).seed)\n630\t    } else {\n631\t        stbds_hash_bytes(key, keysize, (*table).seed)\n632\t    };\n633\t    let mut step = STBDS_BUCKET_LENGTH;\n634\t    let mut limit: usize;\n635\t    let mut i: usize;\n636\t    let mut pos: usize;\n637\t    let mut bucket: *mut stbds_hash_bucket;\n638\t\n639\t    if hash < 2 {\n640\t        hash = hash.wrapping_add(2);\n641\t    }\n642\t\n643\t    pos = stbds_probe_position(hash, (*table).slot_count, (*table).slot_count_log2);\n644\t\n645\t    loop {\n646\t        bucket = (*table).storage.add(pos >> STBDS_BUCKET_SHIFT);\n647\t\n648\t        i = pos & STBDS_BUCKET_MASK;\n649\t        while i < STBDS_BUCKET_LENGTH {\n650\t            if (*bucket).hash[i] == hash {\n651\t                if stbds_is_key_equal(\n652\t                    a,\n653\t                    elemsize,\n654\t                    key,\n655\t                    keysize,\n656\t                    keyoffset,\n657\t                    mode,\n658\t                    (*bucket).index[i] as usize,\n659\t                ) != 0\n660\t                {\n661\t                    return ((pos & !STBDS_BUCKET_MASK).wrapping_add(i)) as isize;\n662\t                }\n663\t            } else if (*bucket).hash[i] == STBDS_HASH_EMPTY {\n664\t                return -1;\n665\t            }\n666\t            i += 1;\n667\t        }\n668\t\n669\t        limit = pos & STBDS_BUCKET_MASK;\n670\t        i = 0;\n671\t        while i < limit {\n672\t            if (*bucket).hash[i] == hash {\n673\t                if stbds_is_key_equal(\n674\t                    a,\n675\t                    elemsize,\n676\t                    key,\n677\t                    keysize,\n678\t                    keyoffset,\n679\t                    mode,\n680\t                    (*bucket).index[i] as usize,\n681\t                ) != 0\n682\t                {\n683\t                    return ((pos & !STBDS_BUCKET_MASK).wrapping_add(i)) as isize;\n684\t                }\n685\t            } else if (*bucket).hash[i] == STBDS_HASH_EMPTY {\n686\t                return -1;\n687\t            }\n688\t            i += 1;\n689\t        }\n690\t\n691\t        pos = pos.wrapping_add(step);\n692\t        step = step.wrapping_add(STBDS_BUCKET_LENGTH);\n693\t        pos &= (*table).slot_count.wrapping_sub(1);\n694\t    }\n695\t}\n696\t\n697\t#[unsafe(no_mangle)]\n698\tpub unsafe extern \"C\" fn stbds_hmget_key_ts(\n699\t    a: *mut c_void,\n700\t    elemsize: usize,\n701\t    key: *mut c_void,\n702\t    keysize: usize,\n703\t    temp: *mut isize,\n704\t    mode: c_int,\n705\t) -> *mut c_void {\n706\t    let keyoffset: usize = 0;\n707\t    if a.is_null() {\n708\t        let a = stbds_arrgrowf(ptr::null_mut(), elemsize, 0, 1);\n709\t        (*stbds_header(a)).length += 1;\n710\t        memset(a, 0, elemsize);\n711\t        *temp = STBDS_INDEX_EMPTY;\n712\t        stbds_arr_to_hash(a, elemsize)\n713\t    } else {\n714\t        let table: *mut stbds_hash_index;\n715\t        let raw_a = stbds_hash_to_arr(a, elemsize);\n716\t        table = (*stbds_header(raw_a)).hash_table as *mut stbds_hash_index;\n717\t        if table.is_null() {\n718\t            *temp = -1;\n719\t        } else {\n720\t            let slot = stbds_hm_find_slot(a, elemsize, key, keysize, keyoffset, mode);\n721\t            if slot < 0 {\n722\t                *temp = STBDS_INDEX_EMPTY;\n723\t            } else {\n724\t                let b = (*table).storage.add((slot >> STBDS_BUCKET_SHIFT) as usize);\n725\t                *temp = (*b).index[(slot as usize) & STBDS_BUCKET_MASK];\n726\t            }\n727\t        }\n728\t        a\n729\t    }\n730\t}\n731\t\n732\t#[unsafe(no_mangle)]\n733\tpub unsafe extern \"C\" fn stbds_hmget_key(\n734\t    a: *mut c_void,\n735\t    elemsize: usize,\n736\t    key: *mut c_void,\n737\t    keysize: usize,\n738\t    mode: c_int,\n739\t) -> *mut c_void {\n740\t    let mut temp: isize = 0;\n741\t    let p = stbds_hmget_key_ts(a, elemsize, key, keysize, &mut temp, mode);\n742\t    stbds_set_temp(stbds_hash_to_arr(p, elemsize), temp);\n743\t    p\n744\t}\n745\t\n746\t#[unsafe(no_mangle)]\n747\tpub unsafe extern \"C\" fn stbds_hmput_default(a: *mut c_void, elemsize: usize) -> *mut c_void {\n748\t    let mut a = a;\n749\t    if a.is_null() || (*stbds_header(stbds_hash_to_arr(a, elemsize))).length == 0 {\n750\t        a = stbds_arrgrowf(\n751\t            if !a.is_null() {\n752\t                stbds_hash_to_arr(a, elemsize)\n753\t            } else {\n754\t                ptr::null_mut()\n755\t            },\n756\t            elemsize,\n757\t            0,\n758\t            1,\n759\t        );\n760\t        (*stbds_header(a)).length += 1;\n761\t        memset(a, 0, elemsize);\n762\t        a = stbds_arr_to_hash(a, elemsize);\n763\t    }\n764\t    a\n765\t}\n766\t\n767\tunsafe fn stbds_strdup(str_: *mut c_char) -> *mut c_char {\n768\t    let len = strlen(str_) + 1;\n769\t    let p = stbds_realloc(ptr::null_mut(), len) as *mut c_char;\n770\t    memmove(p as *mut c_void, str_ as *const c_void, len);\n771\t    p\n772\t}\n773\t\n774\t#[unsafe(no_mangle)]\n775\tpub unsafe extern \"C\" fn stbds_hmput_key(\n776\t    a: *mut c_void,\n777\t    elemsize: usize,\n778\t    key: *mut c_void,\n779\t    keysize: usize,\n780\t    mode: c_int,\n781\t) -> *mut c_void {\n782\t    let mut a = a;\n783\t    let keyoffset: usize = 0;\n784\t    let mut raw_a: *mut c_void;\n785\t    let mut table: *mut stbds_hash_index;\n786\t\n787\t    if a.is_null() {\n788\t        a = stbds_arrgrowf(ptr::null_mut(), elemsize, 0, 1);\n789\t        memset(a, 0, elemsize);\n790\t        (*stbds_header(a)).length += 1;\n791\t        a = stbds_arr_to_hash(a, elemsize);\n792\t    }\n793\t\n794\t    raw_a = a;\n795\t    a = stbds_hash_to_arr(a, elemsize);\n796\t\n797\t    table = (*stbds_header(a)).hash_table as *mut stbds_hash_index;\n798\t\n799\t    if table.is_null() || (*table).used_count >= (*table).used_count_threshold {\n800\t        let nt: *mut stbds_hash_index;\n801\t        let slot_count: usize;\n802\t\n803\t        slot_count = if table.is_null() {\n804\t            STBDS_BUCKET_LENGTH\n805\t        } else {\n806\t            (*table).slot_count.wrapping_mul(2)\n807\t        };\n808\t        nt = stbds_make_hash_index(slot_count, table);\n809\t        if !table.is_null() {\n810\t            stbds_free(table as *mut c_void);\n811\t        } else {\n812\t            (*nt).string.mode = if mode >= STBDS_HM_STRING {\n813\t                STBDS_SH_DEFAULT as u8\n814\t            } else {\n815\t                STBDS_SH_NONE as u8\n816\t            };\n817\t        }\n818\t        table = nt;\n819\t        (*stbds_header(a)).hash_table = nt as *mut c_void;\n820\t    }\n821\t\n822\t    {\n823\t        let mut hash = if mode >= STBDS_HM_STRING {\n824\t            stbds_hash_string(key as *mut c_char, (*table).seed)\n825\t        } else {\n826\t            stbds_hash_