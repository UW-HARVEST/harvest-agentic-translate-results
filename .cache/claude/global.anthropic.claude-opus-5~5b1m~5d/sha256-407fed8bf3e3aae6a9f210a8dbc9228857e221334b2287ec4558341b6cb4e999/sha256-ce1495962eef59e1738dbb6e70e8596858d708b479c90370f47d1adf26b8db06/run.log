{\n  local name=\"$1\"; local kind=\"$2\"; shift 2\n  restore\n  \"$@\"\n  if cmp -s \"$ORIG\" src/lib.rs; then\n    echo \"  $name: NO-OP PATCH (bad mutation spec)\"; skipped=$((skipped+1)); return\n  fi\n  if ! timeout 600 cargo build --offline --release >/dev/null 2>&1; then\n    echo \"  $name: does not compile (skipped)\"; skipped=$((skipped+1)); return\n  fi\n  local out\n  out=$(timeout 600 cargo test --offline --release 2>&1)\n  if echo \"$out\" | grep -q 'STALE Rust .so'; then\n    echo \"  $name: INCONCLUSIVE - staleness guard tripped, not a real signal\"\n    skipped=$((skipped+1)); return\n  fi\n  local detected=0\n  echo \"$out\" | grep -qE '^test result: FAILED' && detected=1\n\n  if [ \"$kind\" = equiv ]; then\n    if [ \"$detected\" -eq 0 ]; then\n      echo \"  $name: SURVIVED as expected (equivalent mutant)\"\n      equiv_ok=$((equiv_ok+1))\n    else\n      echo \"  $name: *** unexpectedly detected -- equivalence claim is wrong ***\"\n      equiv_bad=$((equiv_bad+1))\n    fi\n    return\n  fi\n\n  if [ \"$detected\" -eq 1 ]; then\n    local n first\n    n=$(echo \"$out\" | grep -cE '\\.\\.\\. FAILED')\n    first=$(echo \"$out\" | grep -oE '^test [a-z0-9_]+ \\.\\.\\. FAILED' | head -3 \\\n            | sed -E 's/^test //; s/ \\.\\.\\. FAILED//' | tr '\\n' ',' | sed 's/,$//')\n    echo \"  $name: CAUGHT ($n tests; e.g. $first)\"\n    caught=$((caught+1))\n  else\n    echo \"  $name: *** NOT CAUGHT -- BLIND SPOT ***\"\n    missed=$((missed+1))\n  fi\n}","originalFile":"#!/usr/bin/env bash\n# Negative control for the differential suite.\n#\n# Each mutation injects a plausible translation bug into src/lib.rs; the suite\n# MUST fail for every one. A mutation that passes means the tests are blind to\n# that class of bug.\n#\n# Correctness requirements this script enforces on itself:\n#   * backup lives in a stable directory (not $TMPDIR, which moves between calls)\n#   * the restore is VERIFIED with cmp before each mutation, so mutations can\n#     never stack cumulatively\n#   * the .so is rebuilt after mutating, so tests never see a stale artifact\n#   * a staleness-guard trip is reported separately from a real divergence, so a\n#     spurious \"caught\" is never counted as evidence\nset -uo pipefail\n\nCRATE=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\"\ncd \"$CRATE\"\nORIG=\"$CRATE/.verif/lib.rs.pristine\"\n\n[ -f \"$ORIG\" ] || { echo \"FATAL: missing pristine backup $ORIG\"; exit 1; }\n\nrestore() {\n  cp \"$ORIG\" src/lib.rs\n  cmp -s \"$ORIG\" src/lib.rs || { echo \"FATAL: restore failed\"; exit 1; }\n}\n\ncaught=0; missed=0; skipped=0\n\nrun_mut() {\n  local name=\"$1\"; shift\n  restore\n  \"$@\"\n  if cmp -s \"$ORIG\" src/lib.rs; then\n    echo \"  $name: NO-OP PATCH (bad mutation spec)\"; skipped=$((skipped+1)); return\n  fi\n  if ! timeout 600 cargo build --offline --release >/dev/null 2>&1; then\n    echo \"  $name: does not compile (skipped)\"; skipped=$((skipped+1)); return\n  fi\n  local out\n  out=$(timeout 600 cargo test --offline --release 2>&1)\n  if echo \"$out\" | grep -q 'STALE Rust .so'; then\n    echo \"  $name: INCONCLUSIVE - staleness guard tripped, not a real signal\"\n    skipped=$((skipped+1)); return\n  fi\n  if echo \"$out\" | grep -qE '^test result: FAILED'; then\n    local n\n    n=$(echo \"$out\" | grep -cE '\\.\\.\\. FAILED')\n    local first\n    first=$(echo \"$out\" | grep -oE '^test [a-z0-9_]+ \\.\\.\\. FAILED' | head -3 \\\n            | sed -E 's/^test //; s/ \\.\\.\\. FAILED//' | tr '\\n' ',' | sed 's/,$//')\n    echo \"  $name: CAUGHT ($n tests; e.g. $first)\"\n    caught=$((caught+1))\n  else\n    echo \"  $name: *** NOT CAUGHT -- BLIND SPOT ***\"\n    missed=$((missed+1))\n  fi\n}\n\necho \"=== value-semantics mutations ===\"\nrun_mut swap_args           sed -i 's/libm_pow(base, exponent)/libm_pow(exponent, base)/' src/lib.rs\nrun_mut abs_base            sed -i 's/libm_pow(base, exponent)/libm_pow(base.abs(), exponent)/' src/lib.rs\nrun_mut rust_powf_intrinsic sed -i 's/libm_pow(base, exponent)/base.powf(exponent)/' src/lib.rs\nrun_mut negate_result       sed -i 's/^        result$/        -result/' src/lib.rs\n\necho \"=== sentinel mutations ===\"\nrun_mut sentinel_to_pos1    sed -i 's/return -1\\.0;/return 1.0;/g' src/lib.rs\nrun_mut sentinel_to_negzero sed -i 's/return -1\\.0;/return -0.0;/g' src/lib.rs\nrun_mut sentinel_to_nan     sed -i 's/return -1\\.0;/return f64::NAN;/g' src/lib.rs\nrun_mut sentinel_edom_only  sed -i '0,/return -1\\.0;/s//return -2.0;/' src/lib.rs\n\necho \"=== errno-handling mutations ===\"\nrun_mut no_errno_reset      sed -i 's/^        errno_set(0);$//' src/lib.rs\nrun_mut wrong_edom_const    sed -i 's/const EDOM: c_int = 33;/const EDOM: c_int = 35;/' src/lib.rs\nrun_mut wrong_erange_const  sed -i 's/const ERANGE: c_int = 34;/const ERANGE: c_int = 36;/' src/lib.rs\nrun_mut swap_errno_consts   sed -i 's/const EDOM: c_int = 33;/const EDOM: c_int = 34;/; s/const ERANGE: c_int = 34;/const ERANGE: c_int = 33;/' src/lib.rs\nrun_mut drop_edom_branch    sed -i 's/if err == EDOM {/if false {/' src/lib.rs\nrun_mut drop_erange_branch  sed -i 's/} else if err == ERANGE {/} else if false {/' src/lib.rs\nrun_mut errno_any_nonzero   sed -i 's/if err == EDOM {/if err != 0 \\&\\& err != ERANGE {/' src/lib.rs\nrun_mut errno_read_late     sed -i 's/^        let err = errno_get();$/        let err = { errno_set(0); errno_get() };/' src/lib.rs\n\necho \"=== diagnostic (stderr) mutations ===\"\nrun_mut msg_domain_typo     sed -i 's/Domain error: pow/Domain Error: pow/' src/lib.rs\nrun_mut msg_range_typo      sed -i 's/Range error: pow/range error: pow/' src/lib.rs\nrun_mut fmt_precision_3     sed -i 's/pow(%\\.2f, %\\.2f) caused/pow(%.3f, %.3f) caused/' src/lib.rs\nrun_mut fmt_use_g           sed -i 's/pow(%\\.2f, %\\.2f) caused/pow(%g, %g) caused/' src/lib.rs\nrun_mut swap_msg_args       sed -i 's/^                base,\\n                exponent,$//' src/lib.rs\nrun_mut use_range_for_edom  sed -i 's/DOMAIN_ERROR_FMT\\.as_ptr()/RANGE_ERROR_FMT.as_ptr()/' src/lib.rs\nrun_mut drop_trailing_nl    sed -i 's/real number domain\\.\\\\n\\\\0/real number domain.\\\\0/' src/lib.rs\n\nrestore\ntimeout 600 cargo build --offline --release >/dev/null 2>&1\necho\necho \"caught=$caught  missed=$missed  skipped=$skipped\"\nif [ \"$missed\" -ne 0 ]; then echo \"SUITE HAS BLIND SPOTS\"; exit 1; fi\necho \"restored: $(md5sum src/lib.rs | cut -d' ' -f1)\"\necho \"NEGATIVE CONTROL OK - every compiling mutation was detected\"\n","structuredPatch":[{"oldStart":25,"oldLines":10,"newStart":25,"newLines":12,"lines":["   cmp -s \"$ORIG\" src/lib.rs || { echo \"FATAL: restore failed\"; exit 1; }"," }"," ","-caught=0; missed=0; skipped=0","+caught=0; missed=0; skipped=0; equiv_ok=0; equiv_bad=0"," ","+# Runs one mutation. $1 = name, $2 = \"kill\" (must be detected) or \"equiv\"","+# (semantically equivalent: MUST survive, and surviving is the correct outcome)."," run_mut() {","-  local name=\"$1\"; shift","+  local name=\"$1\"; local kind=\"$2\"; shift 2","   restore","   \"$@\"","   if cmp -s \"$ORIG\" src/lib.rs; then"]},{"oldStart":43,"oldLines":10,"newStart":45,"newLines":23,"lines":["     echo \"  $name: INCONCLUSIVE - staleness guard tripped, not a real signal\"","     skipped=$((skipped+1)); return","   fi","-  if echo \"$out\" | grep -qE '^test result: FAILED'; then","-    local n","+  local detected=0","+  echo \"$out\" | grep -qE '^test result: FAILED' && detected=1","+","+  if [ \"$kind\" = equiv ]; then","+    if [ \"$detected\" -eq 0 ]; then","+      echo \"  $name: SURVIVED as expected (equivalent mutant)\"","+      equiv_ok=$((equiv_ok+1))","+    else","+      echo \"  $name: *** unexpectedly detected -- equivalence claim is wrong ***\"","+      equiv_bad=$((equiv_bad+1))","+    fi","+    return","+  fi","+","+  if [ \"$detected\" -eq 1 ]; then","+    local n first","     n=$(echo \"$out\" | grep -cE '\\.\\.\\. FAILED')","-    local first","     first=$(echo \"$out\" | grep -oE '^test [a