ta = p; v->cap = nc; return true;\n43\t}\n44\tbool iv_push(IntVec *v,int x){ if(v->len==v->cap && !iv_reserve(v, v->cap? v->cap*2:8)) return false; v->data[v->len++]=x; return true; }\n45\tbool iv_pop (IntVec *v,int *out){ if(!v->len) return false; if(out) *out=v->data[v->len-1]; v->len--; return true; }\n46\tint  iv_peek(const IntVec *v,int def){ return v->len? v->data[v->len-1]: def; }\n47\t\n48\tvoid prog_init(Program *p, const int *code, size_t n){ p->code=code; p->n=n; p->ip=0; }\n49\tbool prog_fetch(Program *p, int *out){ if(p->ip>=p->n) return false; *out=p->code[p->ip++]; return true; }\n50\t\n51\tvoid vm_init(VM *vm){ iv_init(&vm->stack); iv_init(&vm->trace); vm->steps=0; }\n52\tvoid vm_free(VM *vm){ iv_free(&vm->stack); iv_free(&vm->trace); vm->steps=0; }\n53\tvoid vm_trace(VM *vm, int t){ iv_push(&vm->trace, t); }\n54\t\n55\tvoid vm_print(FILE *fp, const char *label, const VM *vm){\n56\t    fprintf(fp, \"%sSTACK_TOP=%d STEPS=%d TRACE=\", label, iv_peek(&vm->stack, -777), vm->steps);\n57\t    for (size_t i=0;i<vm->trace.len;i++) fputc(\"abcdefghijklmnopqrstuvwxyz\"[(vm->trace.data[i])&25], fp);\n58\t    fputc('\\n', fp);\n59\t}\n60\t"}]},"parent_tool_use_id":"toolu_bdrk_01NTuhgc9iXeBDzVJ644MGL4","session_id":"fc26c2df-0846-4744-a03c-650c845acfb6","uuid":"12d3bc1d-1a98-4bc1-b978-f2fa1bec9c23","timestamp":"2026-08-28T06:48:34.509Z","subagent_type":"general-purpose","task_description":"Audit C vs Rust semantics"}
