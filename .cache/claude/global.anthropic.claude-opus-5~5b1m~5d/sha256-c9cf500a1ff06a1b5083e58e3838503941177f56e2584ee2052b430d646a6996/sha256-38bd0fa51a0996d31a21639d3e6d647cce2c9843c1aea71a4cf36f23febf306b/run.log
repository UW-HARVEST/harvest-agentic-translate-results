t)*3*n);\n        float *o1=malloc(sizeof(float)*2*n), *o2=malloc(sizeof(float)*2*n);\n        for(int k=0;k<3*n;k++){ uint32_t u=rnd(); memcpy(&in[k],&u,4); }\n        memset(o1,0x77,sizeof(float)*2*n); memset(o2,0x77,sizeof(float)*2*n);\n        fa(o1,in,n); fb(o2,in,n);\n        checked+=n;\n        if(memcmp(o1,o2,sizeof(float)*2*n)!=0){ printf(\"MISMATCH bigbatch\\n\"); mism++; }\n        free(in);free(o1);free(o2);\n        printf(\"phase6 (big batch n=%d) done: mism=%ld\\n\", n, mism);\n    }\n\n    /* --- count<=0 must touch nothing --- */\n    for(int cv=-5; cv<=0; cv++){\n        float in[9]={1,2,3,4,5,6,7,8,9};\n        float o1[8], o2[8];\n        memset(o1,0x7E,sizeof o1); memset(o2,0x7E,sizeof o2);\n        fa(o1,in,cv); fb(o2,in,cv);\n        checked++;\n        if(memcmp(o1,o2,sizeof o1)!=0){ printf(\"MISMATCH count=%d\\n\",cv); mism++; }\n        float ref[8]; memset(ref,0x7E,sizeof ref);\n        if(memcmp(o1,ref,sizeof ref)!=0){ printf(\"NOTE: C wrote with count=%d\\n\",cv); }\n    }\n    printf(\"phase7 (count<=0) done: mism=%ld\\n\", mism);\n\n    printf(\"\\nTOTAL checked=%ld elements, mismatches=%ld -> %s\\n\",\n           checked, mism, mism?\"FAIL\":\"BYTE-IDENTICAL\");\n    return mism?1:0;\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
