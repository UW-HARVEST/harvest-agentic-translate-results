,in[2],\n                *(uint32_t*)&o1[0],*(uint32_t*)&o1[1],\n                *(uint32_t*)&o2[0],*(uint32_t*)&o2[1]);\n            mism++;\n        }\n    }\n    printf(\"phase1 (special grid) done: checked=%ld mism=%ld\\n\", checked, mism);\n\n    /* --- random bit-pattern fuzz (any float, incl. NaNs/denormals) --- */\n    for(long it=0; it<400000; it++){\n        int n = 1 + (int)(rnd()%6);\n        float *in = malloc(sizeof(float)*3*n);\n        float *o1 = malloc(sizeof(float)*2*n);\n        float *o2 = malloc(sizeof(float)*2*n);\n        for(int k=0;k<3*n;k++){ uint32_t u=rnd(); memcpy(&in[k],&u,4); }\n        memset(o1,0x5A,sizeof(float)*2*n); memset(o2,0x5A,sizeof(float)*2*n);\n        fa(o1,in,n); fb(o2,in,n);\n        checked+=n;\n        if(memcmp(o1,o2,sizeof(float)*2*n)!=0){\n            if(mism<12) printf(\"MISMATCH rndbits n=%d first in=(%a,%a,%a)\\n\",n,in[0],in[1],in[2]);\n            mism++;\n        }\n        free(in);free(o1);free(o2);\n    }\n    printf(\"phase2 (random bits) done: checked=%ld mism=%ld\\n\", checked, mism);\n\n    /* --- random \"plausible\" magnitudes across 40 decades --- */\n    for(long it=0; it<400000; it++){\n        int n = 1 + (int)(rnd()%8);\n        float *in = malloc(sizeof(float)*3*n);\n        float *o1 = malloc(sizeof(float)*2*n);\n        float *o2 = malloc(sizeof(float)*2*n);\n        for(int k=0;k<3*n;k++){\n            double u = (double)rnd()/4294967296.0;\n            double v = (double)rnd()/4294967296.0;\n            double sc = pow(10.0, (v*40.0)-20.0);\n            in[k] = (float)((u*2.0-1.0)*sc);\n        }\n        memset(o1,0x33,sizeof(float)*2*n); memset(o2,0x33,sizeof(float)*2*n);\n        fa(o1,in,n); fb(o2,in,n);\n        checked+=n;\n        if(memcmp(o1,o2,sizeof(float)*2*n)!=0){\n            if(mism<12) printf(\"MISMATCH plaus n=%d in=(%a,%a,%a)\\n\",n,in[0],in[1],in[2]);\n            mism++;\n        }\n        free(in);free(o1);free(o2);\n    }\n    printf(\"phase3 (plausible mags) done: checked=%ld mism=%ld\\n\", checked, mism);\n\n    /* --- near-equal src[0]/src[1] to stress the branch boundary --- */\n    for(long it=0; it<200000; it++){\n        float in[3]; float o1[2],o2[2];\n        uint32_t u=rnd(); memcpy(&in[0],&u,4);\n        int d=(int)(rnd()%5)-2;\n        uint32_t u2=u+(uint32_t)d; memcpy(&in[1],&u2,4);\n        uint32_t u3=rnd(); memcpy(&in[2],&u3,4);\n        memset(o1,0xC3,sizeof o1); memset(o2,0xC3,sizeof o2);\n        fa(o1,in,1); fb(o2,in,1);\n        checked++;\n        if(memcmp(o1,o2,sizeof o1)!=0){\n            if(mism<12) printf(\"MISMATCH near in=(%a,%a,%a)\\n\",in[0],in[1],in[2]);\n            mism++;\n        }\n    }\n    printf(\"phase4 (near-equal) done: checked=%ld mism=%ld\\n\", checked, mism);\n\n    /* --- negative sqd path: force discriminant < 0 so the clamp engages --- */\n    for(long it=0; it<200000; it++){\n        /* sqd = (a-b)^2 + 4c^2 >= 0 mathematically, but rounding/overflow can\n           still produce negatives/NaNs; also feed inf/nan mixes explicitly. */\n        float in[3]; float o1[2],o2[2];\n        in[0] = SPECIALS[rnd()%NSPEC];\n        in[1] = SPECIALS[rnd()%NSPEC];\n        uint32_t u3=rnd(); memcpy(&in[2],&u3,4);\n        memset(o1,0x11,sizeof o1); memset(o2,0x11,sizeof o2);\n        fa(o1,in,1); fb(o2,in,1);\n        checked++;\n        if(memcmp(o1,o2,sizeof o1)!=0){\n            if(mism<12) printf(\"MISMATCH clamp in=(%a,%a,%a)\\n\",in[0],in[1],in[2]);\n            mism++;\n        }\n    }\n    printf(\"phase5 (clamp/overflow) done: checked=%ld mism=%ld\\n\", checked, mism);\n\n    /* --- large batch in one call (stride/pointer-advance correctness) --- */\n    {\n        int n=100000;\n        float *in=malloc(sizeof(float)*3*n);\n        float *o1=malloc(sizeof(float)*2*n), *o2=malloc(sizeof(float)*2*n);\n        for(int k=0;k<3*n;k++){ uint32_t u=rnd(); memcpy(&in[k],&u,4); }\n        memset(o1,0x77,sizeof(float)*2*n); memset(o2,0x77,sizeof(float)*2*n);\n        fa(o1,in,n); fb(o2,in,n);\n        checked+=n;\n        if(memcmp(o1,o2,sizeof(float)*2*n)!=0){ printf(\"MISMATCH bigbatch\\n\"); mism++; }\n        free(in);free(o1);free(o2);\n        printf(\"phase6 (big batch n=%d) done: mism=%ld\\n\", n, mism);\n    }\n\n    /* --- count<=0 must touch nothing --- */\n    for(int cv=-5; cv<=0; cv++){\n        float in[9]={1,2,3,4,5,6,7,8,9};\n        float o1[8], o2[8];\n        memset(o1,0x7E,sizeof o1); memset(o2,0x7E,sizeof o2);\n        fa(o1,in,cv); fb(o2,in,cv);\n        checked++;\n        if(memcmp(o1,o2,sizeof o1)!=0){ printf(\"MISMATCH count=%d\\n\",cv); mism++; }\n        float ref[8]; memset(ref,0x7E,sizeof ref);\n        if(memcmp(o1,ref,sizeof ref)!=0){ printf(\"NOTE: C wrote with count=%d\\n\",cv); }\n    }\n    printf(\"phase7 (count<=0) done: mism=%ld\\n\", mism);\n\n    printf(\"\\nTOTAL checked=%ld elements, mismatches=%ld -> %s\\n\",\n           checked, mism, mism?\"FAIL\":\"BYTE-IDENTICAL\");\n    return mism?1:0;\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":600,"cache_read_input_tokens":28021,"cache_creation":{"ephemeral_5m_input_tokens":600,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"39ed02e0-9676-4095-9dea-9966bf04ae5f","uuid":"86c72a99-8b1f-4d31-b783-d7cc5cbb7929","timestamp":"2026-08-27T01:14:33.770Z"}
