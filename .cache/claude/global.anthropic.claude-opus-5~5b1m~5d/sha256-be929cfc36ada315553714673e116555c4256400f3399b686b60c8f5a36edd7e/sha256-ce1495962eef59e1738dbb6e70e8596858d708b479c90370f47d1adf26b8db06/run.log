stbds_string_arena,\n112\t    storage: *mut stbds_hash_bucket,\n113\t}\n114\t\n115\tconst STBDS_INDEX_EMPTY: isize = -1;\n116\tconst STBDS_INDEX_DELETED: isize = -2;\n117\t\n118\tconst STBDS_HASH_EMPTY: usize = 0;\n119\tconst STBDS_HASH_DELETED: usize = 1;\n120\t\n121\tconst STBDS_HM_BINARY: c_int = 0;\n122\tconst STBDS_HM_STRING: c_int = 1;\n123\t\n124\tconst STBDS_SH_DEFAULT: u8 = 1;\n125\tconst STBDS_SH_STRDUP: u8 = 2;\n126\tconst STBDS_SH_ARENA: u8 = 3;\n127\t\n128\tconst STBDS_SIZE_T_BITS: u32 = (size_of::<usize>() * 8) as u32;\n129\t\n130\tconst HDR_SIZE: usize = size_of::<stbds_array_header>();\n131\t\n132\t// ---------------------------------------------------------------------------\n133\t// Small helpers mirroring the C macros\n134\t// ---------------------------------------------------------------------------\n135\t\n136\t#[inline(always)]\n137\tfn stbds_header(t: *mut c_void) -> *mut stbds_array_header {\n138\t    // ((stbds_array_header *) (t) - 1)\n139\t    (t as *mut u8).wrapping_sub(HDR_SIZE) as *mut stbds_array_header\n140\t}\n141\t\n142\t#[inline(always)]\n143\tunsafe fn stbds_arrlen(a: *mut c_void) -> isize {\n144\t    if a.is_null() {\n145\t        0\n146\t    } else {\n147\t        (*stbds_header(a)).length as isize\n148\t    }\n149\t}\n150\t\n151\t#[inline(always)]\n152\tunsafe fn stbds_arrcap(a: *mut c_void) -> usize {\n153\t    if a.is_null() {\n154\t        0\n155\t    } else {\n156\t        (*stbds_header(a)).capacity\n157\t    }\n158\t}\n159\t\n160\t#[inline(always)]\n161\tunsafe fn stbds_set_temp(a: *mut c_void, v: isize) {\n162\t    (*stbds_header(a)).temp = v;\n163\t}\n164\t\n165\t/// `stbds_temp_key(t)` == `*(char **) stbds_header(t)->hash_table`\n166\t#[inline(always)]\n167\tunsafe fn stbds_set_temp_key(a: *mut c_void, v: *mut c_char) {\n168\t    let ht = (*stbds_header(a)).hash_table as *mut *mut c_char;\n169\t    ptr::write_unaligned(ht, v);\n170\t}\n171\t\n172\t#[inline(always)]\n173\tunsafe fn stbds_hash_table(a: *mut c_void) -> *mut stbds_hash_index {\n174\t    (*stbds_header(a)).hash_table as *mut stbds_hash_index\n175\t}\n176\t\n177\t/// STBDS_HASH_TO_ARR(x,elemsize)\n178\t#[inline(always)]\n179\tfn hash_to_arr(x: *mut c_void, elemsize: usize) -> *mut c_void {\n180\t    (x as *mut u8).wrapping_sub(elemsize) as *mut c_void\n181\t}\n182\t\n183\t/// STBDS_ARR_TO_HASH(x,elemsize)\n184\t#[inline(always)]\n185\tfn arr_to_hash(x: *mut c_void, elemsize: usize) -> *mut c_void {\n186\t    (x as *mut u8).wrapping_add(elemsize) as *mut c_void\n187\t}\n188\t\n189\t#[inline(always)]\n190\tfn elem_ptr(a: *mut c_void, elemsize: usize, i: usize) -> *mut u8 {\n191\t    (a as *mut u8).wrapping_add(elemsize.wrapping_mul(i))\n192\t}\n193\t\n194\t#[inline(always)]\n195\tunsafe fn read_char_ptr(p: *const u8) -> *mut c_char {\n196\t    ptr::read_unaligned(p as *const *mut c_char)\n197\t}\n198\t\n199\t#[inline(always)]\n200\tunsafe fn write_char_ptr(p: *mut u8, v: *mut c_char) {\n201\t    ptr::write_unaligned(p as *mut *mut c_char, v)\n202\t}\n203\t\n204\tunsafe fn c_strlen(s: *const c_char) -> usize {\n205\t    let mut n = 0usize;\n206\t    let mut p = s as *const u8;\n207\t    while *p != 0 {\n208\t        n += 1;\n209\t        p = p.add(1);\n210\t    }\n211\t    n\n212\t}\n213\t\n214\t/// `0 == strcmp(a, b)`\n215\tunsafe fn c_str_eq(a: *const c_char, b: *const c_char) -> bool {\n216\t    let mut x = a as *const u8;\n217\t    let mut y = b as *const u8;\n218\t    loop {\n219\t        let ca = *x;\n220\t        let cb = *y;\n221\t        if ca != cb {\n222\t            return false;\n223\t        }\n224\t        if ca == 0 {\n225\t            return true;\n226\t        }\n227\t        x = x.add(1);\n228\t        y = y.add(1);\n229\t    }\n230\t}\n231\t\n232\t// ---------------------------------------------------------------------------\n233\t// stbds_arrgrowf / stbds_arrfreef\n234\t// ---------------------------------------------------------------------------\n235\t\n236\t#[unsafe(no_mangle)]\n237\tpub unsafe extern \"C\" fn stbds_arrgrowf(\n238\t    a: *mut c_void,\n239\t    elemsize: usize,\n240\t    addlen: usize,\n241\t    min_cap: usize,\n242\t) -> *mut c_void {\n243\t    let mut min_cap = min_cap;\n244\t    // size_t min_len = stbds_arrlen(a) + addlen;  (ptrdiff_t converted to size_t)\n245\t    let min_len = (stbds_arrlen(a) as usize).wrapping_add(addlen);\n246\t\n247\t    if min_len > min_cap {\n248\t        min_cap = min_len;\n249\t    }\n250\t\n251\t    if min_cap <= stbds_arrcap(a) {\n252\t        return a;\n253\t    }\n254\t\n255\t    if min_cap < 2usize.wrapping_mul(stbds_arrcap(a)) {\n256\t        min_cap = 2usize.wrapping_mul(stbds_arrcap(a));\n257\t    } else if min_cap < 4 {\n258\t        min_cap = 4;\n259\t    }\n260\t\n261\t    let old = if !a.is_null() {\n262\t        stbds_header(a) as *mut c_void\n263\t    } else {\n264\t        ptr::null_mut()\n265\t    };\n266\t    let raw = realloc(\n267\t        old,\n268\t        elemsize.wrapping_mul(min_cap).wrapping_add(HDR_SIZE),\n269\t    );\n270\t    let b = (raw as *mut u8).wrapping_add(HDR_SIZE) as *mut c_void;\n271\t    if a.is_null() {\n272\t        (*stbds_header(b)).length = 0;\n273\t        (*stbds_header(b)).hash_table = ptr::null_mut();\n274\t        (*stbds_header(b)).temp = 0;\n275\t    }\n276\t    (*stbds_header(b)).capacity = min_cap;\n277\t\n278\t    b\n279\t}\n280\t\n281\t#[unsafe(no_mangle)]\n282\tpub unsafe extern \"C\" fn stbds_arrfreef(a: *mut c_void) {\n283\t    free(stbds_header(a) as *mut c_void);\n284\t}\n285\t\n286\t// ---------------------------------------------------------------------------\n287\t// hash seed / hash index\n288\t// ---------------------------------------------------------------------------\n289\t\n290\tstatic mut stbds_hash_seed: usize = 0x31415926;\n291\t\n292\t#[unsafe(no_mangle)]\n293\tpub unsafe extern \"C\" fn stbds_rand_seed(seed: usize) {\n294\t    stbds_hash_seed = seed;\n295\t}\n296\t\n297\t#[inline(always)]\n298\tfn stbds_probe_position(hash: usize, slot_count: usize, _slot_log2: usize) -> usize {\n299\t    hash & slot_count.wrapping_sub(1)\n300\t}\n301\t\n302\tfn stbds_log2(slot_count: usize) -> usize {\n303\t    let mut slot_count = slot_count;\n304\t    let mut n = 0usize;\n305\t    while slot_count > 1 {\n306\t        slot_count >>= 1;\n307\t        n += 1;\n308\t    }\n309\t    n\n310\t}\n311\t\n312\t/// stbds_load_32_or_64(var, temp, v32, v64_hi, v64_lo)\n313\t#[inline(always)]\n314\tfn stbds_load_32_or_64(v32: usize, v64_hi: usize, v64_lo: usize) -> usize {\n315\t    let mut temp = v64_lo ^ v32;\n316\t    temp <<= 16;\n317\t    temp <<= 16;\n318\t    temp >>= 16;\n319\t    temp >>= 16;\n320\t    let mut var = v64_hi;\n321\t    var <<= 16;\n322\t    var <<= 16;\n323\t    var ^= temp ^ v32;\n324\t    var\n325\t}\n326\t\n327\t#[inline(always)]\n328\tfn stbds_align_fwd(n: usize, a: usize) -> usize {\n329\t    n.wrapping_add(a - 1) & !(a - 1)\n330\t}\n331\t\n332\tunsafe fn stbds_make_hash_index(\n333\t    slot_count: usize,\n334\t    ot: *mut stbds_hash_index,\n335\t) -> *mut stbds_hash_index {\n336\t    let t = realloc(\n337\t        ptr::null_mut(),\n338\t        (slot_count >> STBDS_BUCKET_SHIFT)\n339\t            .wrapping_mul(size_of::<stbds_hash_bucket>())\n340\t            .wrapping_add(size_of::<stbds_hash_index>())\n341\t            .wrapping_add(STBDS_CACHE_LINE_SIZE - 1),\n342\t    ) as *mut stbds_hash_index;\n343\t\n344\t    (*t).storage = stbds_align_fwd(\n345\t        (t as usize).wrapping_add(size_of::<stbds_hash_index>()),\n346\t        STBDS_CACHE_LINE_SIZE,\n347\t    ) as *mut stbds_hash_bucket;\n348\t    (*t).slot_count = slot_count;\n349\t    (*t).slot_count_log2 = stbds_log2(slot_count);\n350\t    (*t).tombstone_count = 0;\n351\t    (*t).used_count = 0;\n352\t\n353\t    (*t).used_count_threshold = slot_count.wrapping_sub(slot_count >> 2);\n354\t    (*t).tombstone_count_threshold = (slot_count >> 3).wrapping_add(slot_count >> 4);\n355\t    (*t).used_count_shrink_threshold = slot_count >> 2;\n356\t\n357\t    if slot_count <= STBDS_BUCKET_LENGTH {\n358\t        (*t).used_count_shrink_threshold = 0;\n359\t    }\n360\t    stbds_assert!(\n361\t        (*t).used_count_threshold.wrapping_add((*t).tombstone_count_threshold) < (*t).slot_count,\n362\t        b\"t->used_count_threshold + t->tombstone_count_threshold < t->slot_count\\0\",\n363\t        401,\n364\t        b\"stbds_make_hash_index\\0\"\n365\t    );\n366\t\n367\t    if !ot.is_null() {\n368\t        (*t).string = (*ot).string;\n369\t        (*t).seed = (*ot).seed;\n370\t    } else {\n371\t        ptr::write_bytes(\n372\t            ptr::addr_of_mut!((*t).string) as *mut u8,\n373\t            0,\n374\t            size_of::<stbds_string_arena>(),\n375\t        );\n376\t        (*t).seed = stbds_hash_seed;\n377\t        let a = stbds_load_32_or_64(2147001325, 0x27bb2ee6, 0x87b0b0fd);\n378\t        let b = stbds_load_32_or_64(715136305, 0, 0xb504f32d);\n379\t        stbds_hash_seed = stbds_hash_seed.wrapping_mul(a).wrapping_add(b);\n380\t    }\n381\t\n382\t    {\n383\t        let mut i = 0usize;\n384\t        while i < (slot_count >> STBDS_BUCKET_SHIFT) {\n385\t            let b = (*t).storage.add(i);\n386\t            let mut j = 0usize;\n387\t            while j < STBDS_BUCKET_LENGTH {\n388\t                (*b).hash[j] = STBDS_HASH_EMPTY;\n389\t                j += 1;\n390\t            }\n391\t            let mut j = 0usize;\n392\t            while j < STBDS_BUCKET_LENGTH {\n393\t                (*b).index[j] = STBDS_INDEX_EMPTY;\n394\t                j += 1;\n395\t            }\n396\t            i += 1;\n397\t        }\n398\t    }\n399\t\n400\t    if !ot.is_null() {\n401\t        (*t).used_count = (*ot).used_count;\n402\t        let mut i = 0usize;\n403\t        while i < ((*ot).slot_count >> STBDS_BUCKET_SHIFT) {\n404\t            let ob = (*ot).storage.add(i);\n405\t            let mut j = 0usize;\n406\t            while j < STBDS_BUCKET_LENGTH {\n407\t                if (*ob).index[j] >= 0 {\n408\t    