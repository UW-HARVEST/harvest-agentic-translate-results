yoffset: 0,\n            string_key: true,\n            cmp_temp_key: true,\n        }\n    }\n    pub fn with_keyoffset(mut self, k: usize) -> Shape {\n        self.keyoffset = k;\n        self\n    }\n    pub fn with_keysize(mut self, k: usize) -> Shape {\n        self.keysize = k;\n        self\n    }\n    pub fn raw_keys(mut self) -> Shape {\n        self.string_key = false;\n        self.cmp_temp_key = false;\n        self\n    }\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1262,"cache_read_input_tokens":124113,"cache_creation":{"ephemeral_5m_input_tokens":1262,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"05384482-1f61-4a19-aaf0-d0cab88dd547","uuid":"fe33f320-191d-4650-a3bf-79667aa6a9e5","timestamp":"2026-08-27T10:51:06.806Z"}
