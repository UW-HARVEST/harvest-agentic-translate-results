o_mangle)]\n455\tpub unsafe extern \"C\" fn stbds_hash_string(str_: *mut c_char, seed: usize) -> usize {\n456\t    let mut hash = seed;\n457\t    let mut s = str_ as *const u8;\n458\t    while *s != 0 {\n459\t        hash = hash.rotate_left(9).wrapping_add(*s as usize);\n460\t        s = s.add(1);\n461\t    }\n462\t\n463\t    hash ^= seed;\n464\t    hash = (!hash).wrapping_add(hash << 18);\n465\t    hash ^= hash ^ hash.rotate_right(31);\n466\t    hash = hash.wrapping_mul(21);\n467\t    hash ^= hash ^ hash.rotate_right(11);\n468\t    hash = hash.wrapping_add(hash << 6);\n469\t    hash ^= hash.rotate_right(22);\n470\t    hash.wrapping_add(seed)\n471\t}\n472\t\n473\tconst STBDS_SIPHASH_C_ROUNDS: usize = 2;\n474\tconst STBDS_SIPHASH_D_ROUNDS: usize = 4;\n475\t\n476\tmacro_rules! stbds_siphash_round {\n477\t    ($v0:ident, $v1:ident, $v2:ident, $v3:ident) => {{\n478\t        $v0 = $v0.wrapping_add($v1);\n479\t        $v1 = $v1.rotate_left(13);\n480\t        $v1 ^= $v0;\n481\t        $v0 = $v0.rotate_left(STBDS_SIZE_T_BITS / 2);\n482\t        $v2 = $v2.wrapping_add($v3);\n483\t        $v3 = $v3.rotate_left(16);\n484\t        $v3 ^= $v2;\n485\t        $v2 = $v2.wrapping_add($v1);\n486\t        $v1 = $v1.rotate_left(17);\n487\t        $v1 ^= $v2;\n488\t        $v2 = $v2.rotate_left(STBDS_SIZE_T_BITS / 2);\n489\t        $v0 = $v0.wrapping_add($v3);\n490\t        $v3 = $v3.rotate_left(21);\n491\t        $v3 ^= $v0;\n492\t    }};\n493\t}\n494\t\n495\tunsafe fn stbds_siphash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n496\t    let mut d = p as *const u8;\n497\t    let mut v0: usize;\n498\t    let mut v1: usize;\n499\t    let mut v2: usize;\n500\t    let mut v3: usize;\n501\t    let mut data: usize;\n502\t\n503\t    v0 = (((0x736f6d65usize << 16) << 16).wrapping_add(0x70736575)) ^ seed;\n504\t    v1 = (((0x646f7261usize << 16) << 16).wrapping_add(0x6e646f6d)) ^ !seed;\n505\t    v2 = (((0x6c796765usize << 16) << 16).wrapping_add(0x6e657261)) ^ seed;\n506\t    v3 = 