(self.bw.byte_len() + 4 - first_bytes % 4) % 4 != 0 {\n                self.bw.push_bytes(&[pad]);\n            }\n        }\n        let input = self.bw.bytes.clone();\n\n        // resolve stored LENs\n        for s in &self.stored {\n            let len = match s.override_len {\n                Some((l, _)) => l as usize,\n                None => {\n                    let l = input.len() - s.data_off;\n                    assert!(l <= 65535, \"stored block too long\");\n                    let bytes = (l as u16).to_le_bytes();\n                    let nb = (!(l as u16)).to_le_bytes();\n                    // patch LEN / NLEN in place\n                    let mut inp = input.clone();\n                    inp[s.len_field] = bytes[0];\n                    inp[s.len_field + 1] = bytes[1];\n                    inp[s.len_field + 2] = nb[0];\n                    inp[s.len_field + 3] = nb[1];\n                    self.bw.bytes = inp;\n                    l\n                }\n            };\n            if let Seg::StoredTail { len: l, .. } = &mut self.segs[s.seg] {\n                *l = Some(len);\n            }\n        }\n        let input = self.bw.bytes.clone();\n\n        // rebuild the expected output from the segments\n        let mut out: Vec<u8> = Vec::new();\n        let mut known = self.known;\n        for seg in &self.segs {\n            match seg {\n                Seg::Bytes(b) => out.extend_from_slice(b),\n                Seg::StoredTail { data_off, len } => {\n                    let l = len.unwrap();\n                    if data_off + l <= input.len() {\n                        out.extend_from_slice(&input[*data_off..*data_off + l]);\n                    } else {\n                        // the C reads past the end of the caller's buffer\n                        for _ in 0..l {\n                            out.push(0);\n                        }\n                        known = false;\n                    }\n                }\n            }\n        }\