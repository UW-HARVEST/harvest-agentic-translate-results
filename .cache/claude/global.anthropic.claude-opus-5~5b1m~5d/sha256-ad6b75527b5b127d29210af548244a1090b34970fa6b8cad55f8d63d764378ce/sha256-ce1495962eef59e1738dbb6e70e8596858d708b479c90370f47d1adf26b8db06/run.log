cription":"Suppress core dumps via prctl and re-time sweeps","timeout":600000}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":506,"cache_read_input_tokens":353954,"cache_creation":{"ephemeral_5m_input_tokens":506,"ephemeral_1h_input_tokens":0},"output_tokens":9,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"ff3766ed-9021-4a97-b413-26636dbe17c8","uuid":"157247f6-08a3-436b-9c24-0000c3af06ad","timestamp":"2026-08-27T15:31:20.347Z"}
