replace('''fn sweep_random() -> Vec<Case> {''','''/// Every 2-byte input, at `first_bytes == 0`.\nfn sweep_two() -> Vec<Case> {\n    let mut cases = Vec::with_capacity(1 << 16);\n    for v in 0..(1u32 << 16) {\n        cases.push(\n            Case::new(\n                format!(\"2 bytes {v:#06x}\"),\n                vec![(v & 0xFF) as u8, (v >> 8) as u8],\n                4096,\n            )\n            .in_pad(8192)\n            .out_pad(8192)\n            .expect(Expect::Any),\n        );\n    }\n    cases\n}\n\nfn sweep_random() -> Vec<Case> {''')\nopen(p,'w').write(s)\nprint('ok2')\nPY\ntimeout 300 cargo build --offline --tests 2>&1 | grep -E \"^error\" -A5 | head","description":"Add .so override and exhaustive 2-byte sweep","timeout":300000}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1345,"cache_read_input_tokens":358798,"cache_creation":{"ephemeral_5m_input_tokens":1345,"ephemeral_1h_input_tokens":0},"output_tokens":9,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"ff3766ed-9021-4a97-b413-26636dbe17c8","uuid":"5ad5c78b-651c-4321-ba71-7bce2a615111","timestamp":"2026-08-27T15:36:00.864Z"}
