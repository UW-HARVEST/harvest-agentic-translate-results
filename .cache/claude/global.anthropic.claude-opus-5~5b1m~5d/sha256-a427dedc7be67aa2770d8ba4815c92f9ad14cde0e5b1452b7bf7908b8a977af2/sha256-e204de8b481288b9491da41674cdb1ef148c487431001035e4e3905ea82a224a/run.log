\\na b b c c c\\n\\n3\\n7\\n\");\n}\n\n#[test]\nfn distribution_with_long_words() {\n    let long: String = std::iter::repeat('u').take(300).collect();\n    let input = format!(\"1\\n{long} {long} short\\n\\n3\\n7\\n\");\n    assert_same(\"long_words\", input.as_bytes());\n}\n\n#[test]\nfn complexity_score_bands() {\n    // score < 10 -> Low, < 50 -> Medium, otherwise High.\n    assert_same(\"score_zero\", b\"4\\n7\\n\");\n    assert_same(\"score_low\", b\"1\\nint x;\\n\\n4\\n7\\n\");\n\n    let medium = \"if \".repeat(10);\n    assert_same(\n        \"score_medium\",\n        format!(\"1\\n{medium}\\n\\n4\\n7\\n\").as_bytes(),\n    );\n\n    let high = \"if while for return int \".repeat(10);\n    assert_same(\"score_high\", format!(\"1\\n{high}\\n\\n4\\n7\\n\").as_bytes());\n\n    // Comments subtract, and the score is clamped at zero.\n    assert_same(\"score_clamped\", b\"1\\n// a\\n// b\\n// c\\n\\n4\\n7\\n\");\n    let comments = (0..20).map(|i| format!(\"// c{i}\\n\")).collect::<String>();\n    assert_same(\n        \"score_many_comments\",\n        format!(\"1\\n{comments}\\n4\\n7\\n\").as_bytes(),\n    );\n\n    // Punctuation contributes count/10, so the boundary at 10 matters.\n    for n in [9usize, 10, 19, 20] {\n        let puncts = \";\".repeat(n);\n        assert_same(\n            &format!(\"score_punct_{n}\"),\n            format!(\"1\\n{puncts}\\n\\n4\\n7\\n\").as_bytes(),\n        );\n    }\n}\n\n#[test]\nfn find_pattern_before_any_analysis() {\n    // The tokenizer buffer is still empty, so nothing is found.\n    assert_same(\"pattern_fresh\", b\"5\\nx\\n7\\n\");\n    assert_same(\"pattern_fresh_empty\", b\"5\\n\\n7\\n\");\n}\n\n#[test]\nfn find_pattern_eof_after_the_choice() {\n    assert_same(\"eof_after_5\", b\"5\\n\");\n}\n\n#[test]\nfn find_pattern_matches() {\n    assert_same(\"pattern_hit\", b\"1\\nabc abd xbc\\n\\n5\\nab\\n7\\n\");\n    assert_same(\"pattern_miss\", b\"1\\nabc\\n\\n5\\nzz\\n7\\n\");\n    // An empty pattern makes strstr match every single token.\n    assert_same(\"pattern_empty\", b\"1\\nint x = 1;\\n\\n5\\n\\n7\\n\");\n    assert_same(\"pattern_operator\", b\"1\\na == b != c\\n\\n5\\n=\\n7\\n\");\n    assert_same(\"pattern_quote\", b\"1\\n\\\"hi\\\" 'c'\\n\\n5\\n\\\"\\n7\\n\");\n    assert_same(\"pattern_slash\", b\"1\\n// note\\n/* b */\\n\\n5\\n/\\n7\\n\");\n    assert_same(\"pattern_newline_token\", b\"1\\na\\nb\\n\\n5\\nb\\n7\\n\");\n}\n\n#[test]\nfn find_pattern_repeats_and_resets() {\n    // find_patterns calls reset(), so the same search can be repeated and the\n    // cumulative character counter keeps growing.\n    assert_same(\"pattern_twice\", b\"1\\nfoo foo\\n\\n5\\nfoo\\n5\\nfoo\\n1\\nbar\\n\\n5\\nfoo\\n7\\n\");\n}\n\n#[test]\nfn find_pattern_long_and_odd_bytes() {\n    let long: String = std::iter::repeat('z').take(300).collect();\n    assert_same(\n        \"pattern_long\",\n        format!(\"1\\nabc\\n\\n5\\n{long}\\n7\\n\").as_bytes(),\n    );\n    assert_same(\"pattern_high_byte\", b\"1\\nabc\\n\\n5\\n\\xff\\n7\\n\");\n    assert_same(\"pattern_nul\", b\"1\\nabc\\n\\n5\\n\\0abc\\n7\\n\");\n    assert_same(\"pattern_spaces\", b\"1\\nabc def\\n\\n5\\n  \\n7\\n\");\n}\n\n#[test]\nfn interactive_tokenizer_empty() {\n    assert_same(\"interactive_empty\", b\"6\\n\\n7\\n\");\n    assert_same(\"interactive_eof\", b\"6\\n\");\n    assert_same(\"interactive_eof_mid\", b\"6\\nabc\");\n}\n\n#[test]\nfn interactive_tokenizer_basic() {\n    assert_same(\"interactive_basic\", b\"6\\nint x = 1; // c\\n\\n7\\n\");\n    assert_same(\"interactive_multiline\", b\"6\\na\\nb\\nc\\n\\n7\\n\");\n    assert_same(\n        \"interactive_all_kinds\",\n        b\"6\\nif (a >= 1) { \\\"s\\\" /*c*/ @ }\\n\\n7\\n\",\n    );\n}\n\n#[test]\nfn interactive_tokenizer_truncation_boundary() {\n    // The loop stops after printing token 101 (\"count > 100\").\n    for n in [99usize, 100, 101, 102, 105] {\n        let words = vec![\"a\"; n].join(\" \");\n        assert_same(\n            &format!(\"interactive_{n}_tokens\"),\n            format!(\"6\\n{words}\\n\\n7\\n\").as_bytes(),\n        );\n    }\n}\n\n#[test]\nfn interactive_tokenizer_fills_the_buffer() {\n    let mut input = Vec::from(&b\"6\\n\"[..]);\n    for _ in 0..25 {\n        input.extend(std::iter::repeat(b'a').take(254));\n        input.push(b'\\n');\n    }\n    input.extend_from_slice(b\"\\n7\\n\");\n    assert_same(\"interactive_fill\", &input);\n}\n\n#[test]\nfn interactive_tokenizer_negative_columns() {\n    // create_token computes `current_column - token.length`, which goes negative\n    // for a token that follows a newline and is longer than the column counter.\n    assert_same(\"negative_columns\", b\"6\\n\\\"abcdefgh\\\"\\nxyzw\\n\\n7\\n\");\n    assert_same(\"column_after_ws\", b\"6\\n   abcdef\\n\\n7\\n\");\n}\n\n#[test]\nfn interactive_then_analysis_shares_state() {\n    // The interactive tokenizer loads text into the same static buffer but does\n    // not touch the analyzer counters.\n    assert_same(\"interactive_then_3\", b\"6\\nint x;\\n\\n3\\n4\\n7\\n\");\n    assert_same(\"interactive_then_5\", b\"6\\nint x;\\n\\n5\\nint\\n7\\n\");\n    assert_same(\"analysis_then_interactive\", b\"1\\nint x;\\n\\n6\\nfloat y;\\n\\n3\\n5\\nfloat\\n7\\n\");\n}\n\n#[test]\nfn full_session_over_every_menu_entry() {\n    assert_same(\n        \"full_session\",\n        b\"1\\nint main(void) { return 0; }\\n\\n2\\n/nonexistent\\n3\\n4\\n5\\nmain\\n6\\na+b\\n\\n9\\nzz\\n7\\n\",\n    );\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
