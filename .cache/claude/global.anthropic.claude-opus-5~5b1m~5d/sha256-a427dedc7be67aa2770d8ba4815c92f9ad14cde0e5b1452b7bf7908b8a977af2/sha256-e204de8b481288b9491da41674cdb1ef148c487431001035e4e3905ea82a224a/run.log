70\t    b\"double\", b\"void\", b\"struct\", b\"typedef\", b\"const\", b\"static\", b\"extern\",\n71\t    b\"auto\", b\"register\", b\"sizeof\", b\"break\", b\"continue\", b\"switch\", b\"case\",\n72\t    b\"default\", b\"do\", b\"goto\", b\"enum\", b\"union\", b\"signed\", b\"unsigned\",\n73\t    b\"long\", b\"short\",\n74\t];\n75\t\n76\tfn is_keyword(s: &[u8]) -> bool {\n77\t    KEYWORDS.iter().any(|kw| *kw == s)\n78\t}\n79\t\n80\t// Static global variables (file-local scope)\n81\tstruct TokenizerState {\n82\t    input_buffer: Vec<u8>,\n83\t    buffer_length: usize,\n84\t    current_position: usize,\n85\t    current_line: i32,\n86\t    current_column: i32,\n87\t    total_tokens_processed: usize,\n88\t    total_lines_processed: usize,\n89\t    total_chars_processed: usize,\n90\t    lookahead_token: Token,\n91\t    lookahead_valid: bool,\n92\t}\n93\t\n94\timpl TokenizerState {\n95\t    fn new() -> TokenizerState {\n96\t        TokenizerState {\n97\t            input_buffer: vec![0u8; MAX_BUFFER_SIZE],\n98\t            buffer_length: 0,\n99\t            current_position: 0,\n100\t            current_line: 1,\n101\t            current_column: 1,\n102\t            total_tokens_processed: 0,\n103\t            total_lines_processed: 0,\n104\t            total_chars_processed: 0,\n105\t            lookahead_token: Token::empty(),\n106\t            lookahead_valid: false,\n107\t        }\n108\t    }\n109\t\n110\t    fn peek_char(&self) -> u8 {\n111\t        if self.current_position >= self.buffer_length {\n112\t            return 0;\n113\t        }\n114\t        self.input_buffer[self.current_position]\n115\t    }\n116\t\n117\t    fn advance_char(&mut self) -> u8 {\n118\t        if self.current_position >= self.buffer_length {\n119\t            return 0;\n120\t        }\n121\t\n122\t        let c = self.input_buffer[self.current_position];\n123\t        self.current_position += 1;\n124\t        self.total_chars_processed += 1;\n125\t\n126\t        if c == b'\\n' {\n127\t            self.current_line += 1;\n128\t            self.current_column = 1;\n129\t            self.total_lines_processed += 1;\n130\t        } else {\n131\t            self.current_column += 1;\n132\t        }\n133\t\n134\t        c\n135\t    }\n136\t\n137\t    fn skip_whitespace(&mut self) {\n138\t        while self.peek_char() != 0 && is_space(self.peek_char()) && self.peek_char() != b'\\n' {\n139\t            self.advance_char();\n140\t        }\n141\t    }\n142\t\n143\t    fn create_token(&mut self, ttype: TokenType, value: &[u8], length: usize) -> Token {\n144\t        let mut token = Token::empty();\n145\t        token.ttype = ttype;\n146\t        token.length = if length < MAX_TOKEN_LENGTH {\n147\t            length\n148\t        } else {\n149\t            MAX_TOKEN_LENGTH - 1\n150\t        };\n151\t        // strncpy(token.value, value, token.length); token.value[token.length] = 0;\n152\t        let copy_len = token.length.min(value.len());\n153\t        token.value = c_str(&value[..copy_len]).to_vec();\n154\t        token.line = self.current_line;\n155\t        // C computes `current_column - token.length` in size_t arithmetic and\n156\t        // then truncates the (possibly wrapped) result to `int`.\n157\t        token.column = (self.current_column as u64).wrapping_sub(token.length as u64) as u32 as i32;\n158\t        self.total_tokens_processed += 1;\n159\t        token\n160\t    }\n161\t\n162\t    fn scan_word(&mut self) -> Token {\n163\t        let mut buffer: Vec<u8> = Vec::new();\n164\t\n165\t        while self.peek_char() != 0\n166\t            && (is_alnum(self.peek_char()) || self.peek_char() == b'_')\n167\t            && buffer.len() < MAX_TOKEN_LENGTH - 1\n168\t        {\n169\t            let c = self.advance_char();\n170\t            buffer.push(c);\n171\t        }\n172\t\n173\t        let length = buffer.len();\n174\t\n175\t        // Check if it's a keyword\n176\t        if is_keyword(&buffer) {\n177\t            return self.create_token(TokenType::Keyword, &buffer, length);\n178\t        }\n179\t\n180\t        self.create_token(TokenType::Identifier, &buffer, length)\n181\t    }\n182\t\n183\t    fn scan_number(&mut self) -> Token {\n184\t        let mut buffer: Vec<u8> = Vec::new();\n185\t        let mut has_decimal = false;\n186\t\n187\t        while self.peek_char() != 0\n188\t            && (is_digit(self.peek_char()) || self.peek_char() == b'.')\n189\t            && buffer.len() < MAX_TOKEN_LENGTH - 1\n190\t        {\n191\t            if self.peek_char() == b'.' {\n192\t                if has_decimal {\n193\t                    break; // Second decimal point\n194\t                }\n195\t                has_decimal = true;\n196\t            }\n197\t\n198\t            let c = self.advance_char();\n199\t            buffer.push(c);\n200\t        }\n201\t\n202\t        let length = buffer.len();\n203\t        self.create_token(TokenType::Number, &buffer, length)\n204\t    }\n205\t\n206\t    fn scan_string(&mut self) -> Token {\n207\t        let mut buffer: Vec<u8> = Vec::new();\n208\t        let quote = self.advance_char(); // Consume opening quote\n209\t\n210\t        buffer.push(quote);\n211\t\n212\t        while self.peek_char() != 0\n213\t            && self.peek_char() != quote\n214\t            && self.peek_char() != b'\\n'\n215\t            && buffer.len() < MAX_TOKEN_LENGTH - 2\n216\t        {\n217\t            if self.peek_char() == b'\\\\' {\n218\t                let c = self.advance_char(); // Escape character\n219\t                buffer.push(c);\n220\t                if self.peek_char() != 0 {\n221\t                    let c = self.advance_char(); // Escaped character\n222\t                    buffer.push(c);\n223\t                }\n224\t            } else {\n225\t                let c = self.advance_char();\n226\t                buffer.push(c);\n227\t            }\n228\t        }\n229\t\n230\t        if self.peek_char() == quote {\n231\t            let c = self.advance_char(); // Closing quote\n232\t            buffer.push(c);\n233\t        }\n234\t\n235\t        let length = buffer.len();\n236\t        self.create_token(TokenType::Str, &buffer, length)\n237\t    }\n238\t\n239\t    fn scan_comment(&mut self) -> Token {\n240\t        let mut buffer: Vec<u8> = Vec::new();\n241\t\n242\t        // Assume we've seen '/'\n243\t        let c = self.advance_char(); // First '/'\n244\t        buffer.push(c);\n245\t\n246\t        if self.peek_char() == b'/' {\n247\t            // Single-line comment\n248\t            let c = self.advance_char(); // Second '/'\n249\t            buffer.push(c);\n250\t\n251\t            while self.peek_char() != 0\n252\t                && self.peek_char() != b'\\n'\n253\t                && buffer.len() < MAX_TOKEN_LENGTH - 1\n254\t            {\n255\t                let c = self.advance_char();\n256\t                buffer.push(c);\n257\t            }\n258\t        } else if self.peek_char() == b'*' {\n259\t            // Multi-line comment\n260\t            let c = self.advance_char(); // '*'\n261\t            buffer.push(c);\n262\t\n263\t            while self.peek_char() != 0 && buffer.len() < MAX_TOKEN_LENGTH - 2 {\n264\t                if self.peek_char() == b'*' {\n265\t                    let c = self.advance_char();\n266\t                    buffer.push(c);\n267\t                    if self.peek_char() == b'/' {\n268\t                        let c = self.advance_char();\n269\t                        buffer.push(c);\n270\t                        break;\n271\t                    }\n272\t                } else {\n273\t                    let c = self.advance_char();\n274\t                    buffer.push(c);\n275\t                }\n276\t            }\n277\t        }\n278\t\n279\t        let length = buffer.len();\n280\t        self.create_token(TokenType::Comment, &buffer, length)\n281\t    }\n282\t\n283\t    fn scan_operator(&mut self) -> Token {\n284\t        let mut buffer: Vec<u8> = Vec::new();\n285\t        let c = self.peek_char();\n286\t\n287\t        let first = self.advance_char();\n288\t        buffer.push(first);\n289\t\n290\t        // Check for two-character operators\n291\t        let next = self.peek_char();\n292\t        if (c == b'=' && next == b'=')\n293\t            || (c == b'!' && next == b'=')\n294\t            || (c == b'<' && next == b'=')\n295\t            || (c == b'>' && next == b'=')\n296\t            || (c == b'&' && next == b'&')\n297\t            || (c == b'|' && next == b'|')\n298\t            || (c == b'+' && next == b'+')\n299\t            || (c == b'-' && next == b'-')\n300\t            || (c == b'-' && next == b'>')\n301\t            || (c == b'<' && next == b'<')\n302\t            || (c == b'>' && next == b'>')\n303\t        {\n304\t            let c2 = self.advance_char();\n305\t            buffer.push(c2);\n306\t        }\n307\t\n308\t        let length = buffer.len();\n309\t        self.create_token(TokenType::Operator, &buffer, length)\n310\t    }\n311\t\n312\t    fn next_token(&mut self) -> Token {\n313\t        // Check if we have a lookahead token\n314\t        if self.lookahead_valid {\n315\t            self.lookahead_valid = false;\n316\t            return self.lookahead_token.clone();\n317\t        }\n318\t\n319\t        self.skip_whitespace();\n320\t\n321\t        if self.current_position >= self.buffer_length {\n322\t            return self.create_token(TokenType::Eof, b\"\", 0);\n323\t        }\n324\t\n325\t        let c = self.peek_char();\n326\t\n327\t        // Newline\n328\t        if c == b'\\n' {\n329\t            let newline = [self.advance_char()];\n330\t            return self.create_token(TokenType::Newline, &newline, 1);\n331\t        }\n332\t\n333\t        // Identifier or keyword\n334\t        if is_alpha(c) || c == b'_' {\n335\t            return self.scan_word();\n336\t        }\n337\t\n338\t        // Number\n339\t        if is_digit(c) {\n340\t            return self.scan_number();\n341\t        }\n342\t\n343\t        // String\n344\t        if c == b'\"' || c == b'\\'' {\n345\t            return self.scan_string();\n346\t        }\n347\t\n348\t        // Comment\n349\t        // NOTE: this mirrors the original C exactly.  `peek_char()` still\n350\t        // returns the unconsumed '/' itself, so any '/' is scanned as a\n351\t        // comment.\n352\t        if c == b'/' && (self.peek_char() == b'/' || self.peek_char() == b'*') {\n353\t            return self.scan_comment();\n354\t        }\n355\t\n356\t        // Operator\n357\t        if b\"+-*/%=<>!&|^~?:\".contains(&c) {\n358\t            return self.scan_operator();\n359\t        }\n360\t\n361\t        // Punctuation\n362\t        if b\"(){}[];,.\".contains(&c) {\n363\t            let punct = [self.advance_char()];\n364\t            return self.create_token(TokenType::Punctuation, &punct, 1);\n365\t        }\n366\t\n367\t        // Unknown character\n368\t        let unknown = [self.advance_char()];\n369\t        self.create_token(TokenType::Error, &unknown, 1)\n370\t    }\n371\t\n372\t    fn reset(&mut self) {\n373\t        self.current_position = 0;\n374\t        self.current_line = 1;\n375\t        self.current_column = 1;\n376\t        self.lookahead_valid = false;\n377\t        // Note: We don't reset total statistics\n378\t    }\n379\t}\n380\t\n381\tthread_local! {\n382\t    static STATE: RefCell<TokenizerState> = RefCell::new(TokenizerState::new());\n383\t}\n384\t\n385\t// Public functions that use static globals\n386\tpub fn tokenizer_next_token() -> Token {\n387\t    STATE.with(|cell| cell.borrow_mut().next_token())\n388\t}\n389\t\n390\tpub fn tokenizer_peek_token() -> Token {\n391\t    STATE.with(|cell| {\n392\t        let mut state = cell.borrow_mut();\n393\t        if !state.lookahead_valid {\n394\t            let token = state.next_token();\n395\t            state.lookahead_token = token;\n396\t            state.lookahead_valid = true;\n397\t        }\n398\t        state.lookahead_token.clone()\n399\t    })\n400\t}\n401\t\n402\tpub fn tokenizer_reset() {\n403\t    STATE.with(|cell| cell.borrow_mut().reset());\n404\t}\n405\t\n406\tpub fn tokenizer_load_text(text: &[u8]) -> i32 {\n407\t    STATE.with(|cell| {\n408\t        let mut state = cell.borrow_mut();\n409\t\n410\t        let length = text.len();\n411\t        if length >= MAX_BUFFER_SIZE {\n412\t            err_str(\"Error: Input text too large\\n\");\n413\t            return -1;\n414\t        }\n415\t\n416\t        // strncpy(input_buffer, text, MAX_BUFFER_SIZE - 1) pads with NULs.\n417\t        for byte in state.input_buffer.iter_mut() {\n418\t            *byte = 0;\n419\t        }\n420\t        state.input_buffer[..length].copy_from_slice(text);\n421\t        state.buffer_length = length;\n422\t\n423\t        state.reset();\n424\t\n425\t        0\n426\t    })\n427\t}\n428\t\n429\tpub fn tokenizer_get_stats() -> (usize, usize, usize) {\n430\t    STATE.with(|cell| {\n431\t        let state = cell.borrow();\n432\t        (\n433\t            state.total_lines_processed,\n434\t            state.total_tokens_processed,\n435\t            state.total_chars_processed,\n436\t        )\n437\t    })\n438\t}\n439\t\n440\t// Function that returns function pointers\n441\tpub fn get_tokenizer_ops() -> TokenizerOps {\n442\t    TokenizerOps {\n443\t        next_token: tokenizer_next_token,\n444\t        peek_token: tokenizer_peek_token,\n445\t        reset: tokenizer_reset,\n446\t        load_text: tokenizer_load_text,\n447\t        get_stats: tokenizer_get_stats,\n448\t    }\n449\t}\n450\t"}]},"parent_tool_use_id":null,"session_id":"1721bc57-ab33-4d25-8c1f-63627c0b3449","uuid":"d99e965d-15fe-48ac-9c46-31a17ec117c4","timestamp":"2026-09-04T03:07:24.146Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-hhb5i9/translation/src/tokenizer.rs","content":"//! Translation of `tokenizer.c` / `tokenizer.h`.\n\nuse std::cell::RefCell;\n\nuse crate::cio::{c_str, err_str, is_alnum, is_alpha, is_digit, is_space};\n\npub const MAX_TOKEN_LENGTH: usize = 256;\npub const MAX_BUFFER_SIZE: usize = 8192;\n\n#[derive(Copy, Clone, PartialEq, Eq)]\npub enum TokenType {\n    Eof = 0,\n    #[allow(dead_code)]\n    Word = 1,\n    Number = 2,\n    Punctuation = 3,\n    #[allow(dead_code)]\n    Whitespace = 4,\n    Newline = 5,\n    Identifier = 6,\n    Keyword = 7,\n    Operator = 8,\n    Str = 9,\n    Comment = 10,\n    Error = 11,\n}\n\nimpl TokenType {\n    pub fn index(self) -> usize {\n        self as usize\n    }\n}\n\n#[derive(Clone)]\npub struct Token {\n    pub ttype: TokenType,\n    /// Contents of the `char value[MAX_TOKEN_LENGTH]` field as a C string.\n    pub value: Vec<u8>,\n    pub length: usize,\n    pub line: i32,\n    pub column: i32,\n}\n\nimpl Token {\n    fn empty() -> Token {\n        Token {\n            ttype: TokenType::Eof,\n            value: Vec::new(),\n            length: 0,\n            line: 0,\n            column: 0,\n        }\n    }\n}\n\n/// The function-pointer table from `tokenizer.h`.\n#[derive(Copy, Clone)]\npub struct TokenizerOps {\n    pub next_token: fn() -> Token,\n    #[allow(dead_code)]\n    pub peek_token: fn() -> Token,\n    pub reset: fn(),\n    pub load_text: fn(&[u8]) -> i32,\n    pub get_stats: fn() -> (usize, usize, usize),\n}\n\n// Static keywords for recognition\nconst KEYWORDS: [&[u8]; 31] = [\n    b\"if\", b\"else\", b\"while\", b\"for\", b\"return\", b\"int\", b\"char\", b\"float\",\n    b\"double\", b\"void\", b\"struct\", b\"typedef\", b\"const\", b\"static\", b\"extern\",\n    b\"auto\", b\"register\", b\"sizeof\", b\"break\", b\"continue\", b\"switch\", b\"case\",\n    b\"default\", b\"do\", b\"goto\", b\"enum\", b\"union\", b\"signed\", b\"unsigned\",\n    b\"long\", b\"short\",\n];\n\nfn is_keyword(s: &[u8]) -> bool {\n    KEYWORDS.iter().any(|kw| *kw == s)\n}\n\n// Static global variables (file-local scope)\nstruct TokenizerState {\n    input_buffer: Vec<u8>,\n    buffer_length: usize,\n    current_position: usize,\n    current_line: i32,\n    current_column: i32,\n    total_tokens_processed: usize,\n    total_lines_processed: usize,\n    total_chars_processed: usize,\n    lookahead_token: Token,\n    lookahead_valid: bool,\n}\n\nimpl TokenizerState {\n    fn new() -> TokenizerState {\n        TokenizerState {\n            input_buffer: vec![0u8; MAX_BUFFER_SIZE],\n            buffer_length: 0,\n            current_position: 0,\n            current_line: 1,\n            current_column: 1,\n            total_tokens_processed: 0,\n            total_lines_processed: 0,\n            total_chars_processed: 0,\n            lookahead_token: Token::empty(),\n            lookahead_valid: false,\n        }\n    }\n\n    fn peek_char(&self) -> u8 {\n        if self.current_position >= self.buffer_length {\n            return 0;\n        }\n        self.input_buffer[self.current_position]\n    }\n\n    fn advance_char(&mut self) -> u8 {\n        if self.current_position >= self.buffer_length {\n            return 0;\n        }\n\n        let c = self.input_buffer[self.current_position];\n        self.current_position += 1;\n        self.total_chars_processed += 1;\n\n        if c == b'\\n' {\n            self.current_line += 1;\n            self.current_column = 1;\n            self.total_lines_processed += 1;\n        } else {\n            self.current_column += 1;\n        }\n\n        c\n    }\n\n    fn skip_whitespace(&mut self) {\n        while self.peek_char() != 0 && is_space(self.peek_char()) && self.peek_char() != b'\\n' {\n            self.advance_char();\n        }\n    }\n\n    fn create_token(&mut self, ttype: TokenType, value: &[u8], length: usize) -> Token {\n        let mut token = Token::empty();\n        token.ttype = ttype;\n        token.length = if length < MAX_TOKEN_LENGTH {\n            length\n        } else {\n            MAX_TOKEN_LENGTH - 1\n        };\n        // strncpy(token.value, value, token.length); token.value[token.length] = 0;\n        let copy_len = token.length.min(value.len());\n        token.value = c_str(&value[..copy_len]).to_vec();\n        token.line = self.current_line;\n        // C computes `current_column - token.length` in size_t arithmetic and\n        // then truncates the (possibly wrapped) result to `int`.\n        token.column = (self.current_column as u64).wrapping_sub(token.length as u64) as u32 as i32;\n        self.total_tokens_processed += 1;\n        token\n    }\n\n    fn scan_word(&mut self) -> Token {\n        let mut buffer: Vec<u8> = Vec::new();\n\n        while self.peek_char() != 0\n            && (is_alnum(self.peek_char()) || self.peek_char() == b'_')\n            && buffer.len() < MAX_TOKEN_LENGTH - 1\n        {\n            let c = self.advance_char();\n            buffer.push(c);\n        }\n\n        let length = buffer.len();\n\n        // Check if it's a keyword\n        if is_keyword(&buffer) {\n            return self.create_token(TokenType::Keyword, &buffer, length);\n        }\n\n        self.create_token(TokenType::Identifier, &buffer, length)\n    }\n\n    fn scan_number(&mut self) -> Token {\n        let mut buffer: Vec<u8> = Vec::new();\n        let mut has_decimal = false;\n\n        while self.peek_char() != 0\n            && (is_digit(self.peek_char()) || self.peek_char() == b'.')\n            && buffer.len() < MAX_TOKEN_LENGTH - 1\n        {\n            if self.peek_char() == b'.' {\n                if has_decimal {\n                    break; // Second decimal point\n                }\n                has_decimal = true;\n            }\n\n            let c = self.advance_char();\n            buffer.push(c);\n        }\n\n        let length = buffer.len();\n        self.create_token(TokenType::Number, &buffer, length)\n    }\n\n    fn scan_string(&mut self) -> Token {\n        let mut buffer: Vec<u8> = Vec::new();\n        let quote = self.advance_char(); // Consume opening quote\n\n        buffer.push(quote);\n\n        while self.peek_char() != 0\n            && self.peek_char() != quote\n            && self.peek_char() != b'\\n'\n            && buffer.len() < MAX_TOKEN_LENGTH - 2\n        {\n            if self.peek_char() == b'\\\\' {\n                let c = self.advance_char(); // Escape character\n                buffer.push(c);\n                if self.peek_char() != 0 {\n                    let c = self.advance_char(); // Escaped character\n                    buffer.push(c);\n                }\n            } else {\n                let c = self.advance_char();\n                buffer.push(c);\n            }\n        }\n\n        if self.peek_char() == quote {\n            let c = self.advance_char(); // Closing quote\n            buffer.push(c);\n        }\n\n        let length = buffer.len();\n        self.create_token(TokenType::Str, &buffer, length)\n    }\n\n    fn scan_comment(&mut self) -> Token {\n        let mut buffer: Vec<u8> = Vec::new();\n\n        // Assume we've seen '/'\n        let c = self.advance_char(); // First '/'\n        buffer.push(c);\n\n        if self.peek_char() == b'/' {\n            // Single-line comment\n            let c = self.advance_char(); // Second '/'\n            buffer.push(c);\n\n            while self.peek_char() != 0\n                && self.peek_char() != b'\\n'\n                && buffer.len() < MAX_TOKEN_LENGTH - 1\n            {\n                let c = self.advance_char();\n                buffer.push(c);\n            }\n        } else if self.peek_char() == b'*' {\n            // Multi-line comment\n            let c = self.advance_char(); // '*'\n            buffer.push(c);\n\n            while self.peek_char() != 0 && buffer.len() < MAX_TOKEN_LENGTH - 2 {\n                if self.peek_char() == b'*' {\n                    let c = self.advance_char();\n                    buffer.push(c);\n                    if self.peek_char() == b'/' {\n                        let c = self.advance_char();\n                        buffer.push(c);\n                        break;\n                    }\n                } else {\n                    let c = self.advance_char();\n                    buffer.push(c);\n                }\n            }\n        }\n\n        let length = buffer.len();\n        self.create_token(TokenType::Comment, &buffer, length)\n    }\n\n    fn scan_operator(&mut self) -> Token {\n        let mut buffer: Vec<u8> = Vec::new();\n        let c = self.peek_char();\n\n        let first = self.advance_char();\n        buffer.push(first);\n\n        // Check for two-character operators\n        let next = self.peek_char();\n        if (c == b'=' && next == b'=')\n            || (c == b'!' && next == b'=')\n            || (c == b'<' && next == b'=')\n            || (c == b'>' && next == b'=')\n            || (c == b'&' && next == b'&')\n            || (c == b'|' && next == b'|')\n            || (c == b'+' && next == b'+')\n            || (c == b'-' && next == b'-')\n            || (c == b'-' && next == b'>')\n            || (c == b'<' && next == b'<')\n            || (c == b'>' && next == b'>')\n        {\n            let c2 = self.advance_char();\n            buffer.push(c2);\n        }\n\n        let length = buffer.len();\n        self.create_token(TokenType::Operator, &buffer, length)\n    }\n\n    fn next_token(&mut self) -> Token {\n        // Check if we have a lookahead token\n        if self.lookahead_valid {\n            self.lookahead_valid = false;\n            return self.lookahead_token.clone();\n        }\n\n        self.skip_whitespace();\n\n        if self.current_position >= self.buffer_length {\n            return self.create_token(TokenType::Eof, b\"\", 0);\n        }\n\n        let c = self.peek_char();\n\n        // Newline\n        if c == b'\\n' {\n            let newline = [self.advance_char()];\n            return self.create_token(TokenType::Newline, &newline, 1);\n        }\n\n        // Identifier or keyword\n        if is_alpha(c) || c == b'_' {\n            return self.scan_word();\n        }\n\n        // Number\n        if is_digit(c) {\n            return self.scan_number();\n        }\n\n        // String\n        if c == b'\"' || c == b'\\'' {\n            return self.scan_string();\n        }\n\n        // Comment\n        // NOTE: this mirrors the original C exactly.  `peek_char()` still\n        // returns the unconsumed '/' itself, so any '/' is scanned as a\n        // comment.\n        if c == b'/' && (self.peek_char() == b'/' || self.peek_char() == b'*') {\n            return self.scan_comment();\n        }\n\n        // Operator\n        if b\"+-*/%=<>!&|^~?:\".contains(&c) {\n            return self.scan_operator();\n        }\n\n        // Punctuation\n        if b\"(){}[];,.\".contains(&c) {\n            let punct = [self.advance_char()];\n            return self.create_token(TokenType::Punctuation, &punct, 1);\n        }\n\n        // Unknown character\n        let unknown = [self.advance_char()];\n        self.create_token(TokenType::Error, &unknown, 1)\n    }\n\n    fn reset(&mut self) {\n        self.current_position = 0;\n        self.current_line = 1;\n        self.current_column = 1;\n        self.lookahead_valid = false;\n        // Note: We don't reset total statistics\n    }\n}\n\nthread_local! {\n    static STATE: RefCell<TokenizerState> = RefCell::new(TokenizerState::new());\n}\n\n// Public functions that use static globals\npub fn tokenizer_next_token() -> Token {\n    STATE.with(|cell| cell.borrow_mut().next_token())\n}\n\npub fn tokenizer_peek_token() -> Token {\n    STATE.with(|cell| {\n        let mut state = cell.borrow_mut();\n        if !state.lookahead_valid {\n            let token = state.next_token();\n            state.lookahead_token = token;\n            state.lookahead_valid = true;\n        }\n        state.lookahead_token.clone()\n    })\n}\n\npub fn tokenizer_reset() {\n    STATE.with(|cell| cell.borrow_mut().reset());\n}\n\npub fn tokenizer_load_text(text: &[u8]) -> i32 {\n    STATE.with(|cell| {\n        let mut state = cell.borrow_mut();\n\n        let length = text.len();\n        if length >= MAX_BUFFER_SIZE {\n            err_str(\"Error: Input text too large\\n\");\n            return -1;\n        }\n\n        // strncpy(input_buffer, text, MAX_BUFFER_SIZE - 1) pads with NULs.\n        for byte in state.input_buffer.iter_mut() {\n            *byte = 0;\n        }\n        state.input_buffer[..length].copy_from_slice(text);\n        state.buffer_length = length;\n\n        state.reset();\n\n        0\n    })\n}\n\npub fn tokenizer_get_stats() -> (usize, usize, usize) {\n    STATE.with(|cell| {\n        let state = cell.borrow();\n        (\n            state.total_lines_processed,\n            state.total_tokens_processed,\n            state.total_chars_processed,\n        )\n    })\n}\n\n// Function that returns function pointers\npub fn get_tokenizer_ops() -> TokenizerOps {\n    TokenizerOps {\n        next_token: tokenizer_next_token,\n        peek_token: tokenizer_peek_token,\n        reset: tokenizer_reset,\n        load_text: tokenizer_load_text,\n        get_stats: tokenizer_get_stats,\n    }\n}\n","numLines":450,"startLine":1,"totalLines":450}}}
