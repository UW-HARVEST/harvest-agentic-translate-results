{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Kc9oQsZGgWfMZ1QvQ5m8eG","type":"tool_result","content":"60\t}\n61\t\n62\tthread_local! {\n63\t    static STATE: RefCell<AnalyzerState> = RefCell::new(AnalyzerState::new());\n64\t}\n65\t\n66\tpub fn analyzer_init(ops: TokenizerOps) {\n67\t    STATE.with(|cell| {\n68\t        let mut state = cell.borrow_mut();\n69\t        state.tokenizer_ops = Some(ops);\n70\t        state.initialized = true;\n71\t\n72\t        // Reset tracking arrays\n73\t        state.token_type_counts = [0; 20];\n74\t        for count in state.common_word_counts.iter_mut() {\n75\t            *count = 0;\n76\t        }\n77\t        state.num_common_words = 0;\n78\t    });\n79\t}\n80\t\n81\tpub fn analyze_text(text: &[u8]) -> AnalysisResult {\n82\t    let mut result = AnalysisResult::default();\n83\t\n84\t    let ops = STATE.with(|cell| {\n85\t        let state = cell.borrow();\n86\t        if !state.initialized {\n87\t            None\n88\t        } else {\n89\t            state.tokenizer_ops\n90\t        }\n91\t    });\n92\t\n93\t    let ops = match ops {\n94\t        Some(ops) => ops,\n95\t        None => {\n96\t            err_str(\"Error: Analyzer not initialized\\n\");\n97\t            return result;\n98\t        }\n99\t    };\n100\t\n101\t    // Load text using function pointer\n102\t    if (ops.load_text)(text) != 0 {\n103\t        err_str(\"Error: Failed to load text\\n\");\n104\t        return result;\n105\t    }\n106\t\n107\t    // Process all tokens using function pointers\n108\t    loop {\n109\t        let token = (ops.next_token)();\n110\t        if token.ttype == TokenType::Eof {\n111\t            break;\n112\t        }\n113\t\n114\t        // Update counts\n115\t        STATE.with(|cell| {\n116\t            let mut state = cell.borrow_mut();\n117\t            state.token_type_counts[token.ttype.index()] += 1;\n118\t\n119\t            match token.ttype {\n120\t                TokenType::Word | TokenType::Identifier => {\n121\t                    result.word_count += 1;\n122\t                    state.track_word(&token.value);\n123\t                }\n124\t\n125\t                TokenType::Number => {\n126\t                    result.number_count += 1;\n127\t                }\n128\t\n129\t                TokenType::Keyword => {\n130\t                    result.keyword_count += 1;\n131\t                }\n132\t\n133\t                TokenType::Operator => {\n134\t                    result.operator_count += 1;\n135\t                }\n136\t\n137\t                TokenType::Comment => {\n138\t                    result.comment_count += 1;\n139\t                }\n140\t\n141\t                TokenType::Str => {\n142\t                    result.string_count += 1;\n143\t                }\n144\t\n145\t                TokenType::Newline => {\n146\t                    result.line_count += 1;\n147\t                }\n148\t\n149\t                _ => {}\n150\t            }\n151\t        });\n152\t    }\n153\t\n154\t    // Get final statistics using function pointer\n155\t    let (lines, _tokens, chars) = (ops.get_stats)();\n156\t\n157\t    result.line_count = lines;\n158\t    result.char_count = chars;\n159\t\n160\t    result\n161\t}\n162\t\n163\tpub fn print_token_distribution() {\n164\t    out_str(\"\\n=== Token Distribution ===\\n\");\n165\t\n166\t    const TOKEN_NAMES: [&str; 12] = [\n167\t        \"EOF\",\n168\t        \"WORD\",\n169\t        \"NUMBER\",\n170\t        \"PUNCTUATION\",\n171\t        \"WHITESPACE\",\n172\t        \"NEWLINE\",\n173\t        \"IDENTIFIER\",\n174\t        \"KEYWORD\",\n175\t        \"OPERATOR\",\n176\t        \"STRING\",\n177\t        \"COMMENT\",\n178\t        \"ERROR\",\n179\t    ];\n180\t\n181\t    STATE.with(|cell| {\n182\t        let mut state = cell.borrow_mut();\n183\t\n184\t        for i in 0..12 {\n185\t            if state.token_type_counts[i] > 0 {\n186\t                out_str(&format!(\"{}: {}\\n\", TOKEN_NAMES[i], state.token_type_counts[i]));\n187\t            }\n188\t        }\n189\t\n190\t        out_str(\"\\n=== Most Common Words ===\\n\");\n191\t\n192\t        // Simple bubble sort for display\n193\t        let num = state.num_common_words;\n194\t        let mut i = 0i32;\n195\t        while i < num - 1 {\n196\t            let mut j = 0i32;\n197\t            while j < num - i - 1 {\n198\t                let a = j as usize;\n199\t                let b = (j + 1) as usize;\n200\t                if state.common_word_counts[a] < state.common_word_counts[b] {\n201\t                    // Swap counts\n202\t                    state.common_word_counts.swap(a, b);\n203\t\n204\t                    // Swap words\n205\t                    state.common_words.swap(a, b);\n206\t                }\n207\t                j += 1;\n208\t            }\n209\t            i += 1;\n210\t        }\n211\t\n212\t        // Print top 10\n213\t        let limit = if state.num_common_words < 10 {\n214\t            state.num_common_words\n215\t        } else {\n216\t            10\n217\t        };\n218\t        for i in 0..limit {\n219\t            let idx = i as usize;\n220\t            out_str(&format!(\"{}. \", i + 1));\n221\t            out_bytes(&state.common_words[idx]);\n222\t            out_str(&format!(\": {} times\\n\", state.common_word_counts[idx]));\n223\t        }\n224\t    });\n225\t}\n226\t\n227\tpub fn calculate_complexity_score() -> i32 {\n228\t    STATE.with(|cell| {\n229\t        let state = cell.borrow();\n230\t        let mut score: i32 = 0;\n231\t\n232\t        // Base score on keyword density\n233\t        score += state.token_type_counts[TokenType::Keyword.index()] * 2;\n234\t\n235\t        // Add points for operators\n236\t        score += state.token_type_counts[TokenType::Operator.index()];\n237\t\n238\t        // Nesting indicators (braces)\n239\t        score += state.token_type_counts[TokenType::Punctuation.index()] / 10;\n240\t\n241\t        // Comments reduce complexity (good documentation)\n242\t        score -= state.token_type_counts[TokenType::Comment.index()];\n243\t\n244\t        if score < 0 {\n245\t            score = 0;\n246\t        }\n247\t\n248\t        score\n249\t    })\n250\t}\n251\t\n252\tpub fn find_patterns(pattern: &[u8]) {\n253\t    let ops = STATE.with(|cell| {\n254\t        let state = cell.borrow();\n255\t        if !state.initialized {\n256\t            None\n257\t        } else {\n258\t            state.tokenizer_ops\n259\t        }\n260\t    });\n261\t\n262\t    let ops = match ops {\n263\t        Some(ops) => ops,\n264\t        None => return,\n265\t    };\n266\t\n267\t    out_str(\"\\n=== Searching for pattern: '\");\n268\t    out_bytes(pattern);\n269\t    out_str(\"' ===\\n\");\n270\t\n271\t    // Reset tokenizer using function pointer\n272\t    (ops.reset)();\n273\t\n274\t    let mut count: i32 = 0;\n275\t\n276\t    loop {\n277\t        let token = (ops.next_token)();\n278\t        if token.ttype == TokenType::Eof {\n279\t            break;\n280\t        }\n281\t        if c_strstr(&token.value, pattern) {\n282\t            out_str(&format!(\"Line {}, Column {}: \", token.line, token.column));\n283\t            out_bytes(&token.value);\n284\t            out_str(\"\\n\");\n285\t            count += 1;\n286\t        }\n287\t    }\n288\t\n289\t    out_str(&format!(\"Found {} occurrences\\n\", count));\n290\t}\n291\t"}]},"parent_tool_use_id":null,"session_id":"1721bc57-ab33-4d25-8c1f-63627c0b3449","uuid":"96e22327-f212-46a1-9384-27794858c366","timestamp":"2026-09-04T03:07:45.245Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-hhb5i9/translation/src/analyzer.rs","content":"}\n\nthread_local! {\n    static STATE: RefCell<AnalyzerState> = RefCell::new(AnalyzerState::new());\n}\n\npub fn analyzer_init(ops: TokenizerOps) {\n    STATE.with(|cell| {\n        let mut state = cell.borrow_mut();\n        state.tokenizer_ops = Some(ops);\n        state.initialized = true;\n\n        // Reset tracking arrays\n        state.token_type_counts = [0; 20];\n        for count in state.common_word_counts.iter_mut() {\n            *count = 0;\n        }\n        state.num_common_words = 0;\n    });\n}\n\npub fn analyze_text(text: &[u8]) -> AnalysisResult {\n    let mut result = AnalysisResult::default();\n\n    let ops = STATE.with(|cell| {\n        let state = cell.borrow();\n        if !state.initialized {\n            None\n        } else {\n            state.tokenizer_ops\n        }\n    });\n\n    let ops = match ops {\n        Some(ops) => ops,\n        None => {\n            err_str(\"Error: Analyzer not initialized\\n\");\n            return result;\n        }\n    };\n\n    // Load text using function pointer\n    if (ops.load_text)(text) != 0 {\n        err_str(\"Error: Failed to load text\\n\");\n        return result;\n    }\n\n    // Process all tokens using function pointers\n    loop {\n        let token = (ops.next_token)();\n        if token.ttype == TokenType::Eof {\n            break;\n        }\n\n        // Update counts\n        STATE.with(|cell| {\n            let mut state = cell.borrow_mut();\n            state.token_type_counts[token.ttype.index()] += 1;\n\n            match token.ttype {\n                TokenType::Word | TokenType::Identifier => {\n                    result.word_count += 1;\n                    state.track_word(&token.value);\n                }\n\n                TokenType::Number => {\n                    result.number_count += 1;\n                }\n\n                TokenType::Keyword => {\n                    result.keyword_count += 1;\n                }\n\n                TokenType::Operator => {\n                    result.operator_count += 1;\n                }\n\n                TokenType::Comment => {\n                    result.comment_count += 1;\n                }\n\n                TokenType::Str => {\n                    result.string_count += 1;\n                }\n\n                TokenType::Newline => {\n                    result.line_count += 1;\n                }\n\n                _ => {}\n            }\n        });\n    }\n\n    // Get final statistics using function pointer\n    let (lines, _tokens, chars) = (ops.get_stats)();\n\n    result.line_count = lines;\n    result.char_count = chars;\n\n    result\n}\n\npub fn print_token_distribution() {\n    out_str(\"\\n=== Token Distribution ===\\n\");\n\n    const TOKEN_NAMES: [&str; 12] = [\n        \"EOF\",\n        \"WORD\",\n        \"NUMBER\",\n        \"PUNCTUATION\",\n        \"WHITESPACE\",\n        \"NEWLINE\",\n        \"IDENTIFIER\",\n        \"KEYWORD\",\n        \"OPERATOR\",\n        \"STRING\",\n        \"COMMENT\",\n        \"ERROR\",\n    ];\n\n    STATE.with(|cell| {\n        let mut state = cell.borrow_mut();\n\n        for i in 0..12 {\n            if state.token_type_counts[i] > 0 {\n                out_str(&format!(\"{}: {}\\n\", TOKEN_NAMES[i], state.token_type_counts[i]));\n            }\n        }\n\n        out_str(\"\\n=== Most Common Words ===\\n\");\n\n        // Simple bubble sort for display\n        let num = state.num_common_words;\n        let mut i = 0i32;\n        while i < num - 1 {\n            let mut j = 0i32;\n            while j < num - i - 1 {\n                let a = j as usize;\n                let b = (j + 1) as usize;\n                if state.common_word_counts[a] < state.common_word_counts[b] {\n                    // Swap counts\n                    state.common_word_counts.swap(a, b);\n\n                    // Swap words\n                    state.common_words.swap(a, b);\n                }\n                j += 1;\n            }\n            i += 1;\n        }\n\n        // Print top 10\n        let limit = if state.num_common_words < 10 {\n            state.num_common_words\n        } else {\n            10\n        };\n        for i in 0..limit {\n            let idx = i as usize;\n            out_str(&format!(\"{}. \", i + 1));\n            out_bytes(&state.common_words[idx]);\n            out_str(&format!(\": {} times\\n\", state.common_word_counts[idx]));\n        }\n    });\n}\n\npub fn calculate_complexity_score() -> i32 {\n    STATE.with(|cell| {\n        let state = cell.borrow();\n        let mut score: i32 = 0;\n\n        // Base score on keyword density\n        score += state.token_type_counts[TokenType::Keyword.index()] * 2;\n\n        // Add points for operators\n        score += state.token_type_counts[TokenType::Operator.index()];\n\n        // Nesting indicators (braces)\n        score += state.token_type_counts[TokenType::Punctuation.index()] / 10;\n\n        // Comments reduce complexity (good documentation)\n        score -= state.token_type_counts[TokenType::Comment.index()];\n\n        if score < 0 {\n            score = 0;\n        }\n\n        score\n    })\n}\n\npub fn find_patterns(pattern: &[u8]) {\n    let ops = STATE.with(|cell| {\n        let state = cell.borrow();\n        if !state.initialized {\n            None\n        } else {\n            state.tokenizer_ops\n        }\n    });\n\n    let ops = match ops {\n        Some(ops) => ops,\n        None => return,\n    };\n\n    out_str(\"\\n=== Searching for pattern: '\");\n    out_bytes(pattern);\n    out_str(\"' ===\\n\");\n\n    // Reset tokenizer using function pointer\n    (ops.reset)();\n\n    let mut count: i32 = 0;\n\n    loop {\n        let token = (ops.next_token)();\n        if token.ttype == TokenType::Eof {\n            break;\n        }\n        if c_strstr(&token.value, pattern) {\n            out_str(&format!(\"Line {}, Column {}: \", token.line, token.column));\n            out_bytes(&token.value);\n            out_str(\"\\n\");\n            count += 1;\n        }\n    }\n\n    out_str(&format!(\"Found {} occurrences\\n\", count));\n}\n","numLines":232,"startLine":60,"totalLines":291}}}
