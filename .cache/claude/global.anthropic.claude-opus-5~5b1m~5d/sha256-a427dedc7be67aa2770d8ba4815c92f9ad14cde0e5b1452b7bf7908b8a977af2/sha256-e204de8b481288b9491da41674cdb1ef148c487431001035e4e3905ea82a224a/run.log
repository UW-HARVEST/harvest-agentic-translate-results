tware.\n    15\t * \n    16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    18\t * THE WARRANTIES OF MERCHANTABILITY,\n    19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    24\t */\n    25\t#ifndef TOKENIZER_H\n    26\t#define TOKENIZER_H\n    27\t\n    28\t#include <stddef.h>\n    29\t\n    30\t#define MAX_TOKEN_LENGTH 256\n    31\t#define MAX_BUFFER_SIZE 8192\n    32\t\n    33\ttypedef enum {\n    34\t    TOKEN_EOF = 0,\n    35\t    TOKEN_WORD,\n    36\t    TOKEN_NUMBER,\n    37\t    TOKEN_PUNCTUATION,\n    38\t    TOKEN_WHITESPACE,\n    39\t    TOKEN_NEWLINE,\n    40\t    TOKEN_IDENTIFIER,\n    41\t    TOKEN_KEYWORD,\n    42\t    TOKEN_OPERATOR,\n    43\t    TOKEN_STRING,\n    44\t    TOKEN_COMMENT,\n    45\t    TOKEN_ERROR\n    46\t} token_type_t;\n    47\t\n    48\ttypedef struct {\n    49\t    token_type_t type;\n    50\t    char value[MAX_TOKEN_LENGTH];\n    51\t    size_t length;\n    52\t    int line;\n    53\t    int column;\n    54\t} token_t;\n    55\t\n    56\t// Function pointer types for tokenizer operations\n    57\ttypedef token_t (*tokenizer_next_fn)(void);\n    58\ttypedef token_t (*tokenizer_peek_fn)(void);\n    59\ttypedef void (*tokenizer_reset_fn)(void);\n    60\ttypedef int (*tokenizer_load_fn)(const char *text);\n    61\ttypedef void (*tokenizer_get_stats_fn)(size_t *lines, size_t *tokens, size_t *chars);\n    62\t\n    63\t// Tokenizer operations structure\n    64\ttypedef struct {\n    65\t    tokenizer_next_fn next_token;\n    66\t    tokenizer_peek_fn peek_token;\n    67\t    tokenizer_reset_fn reset;\n    68\t    tokenizer_load_fn load_text;\n    69\t    tokenizer_get_stats_fn get_stats;\n    70\t} tokenizer_ops_t;\n    71\t\n    72\t// Get tokenizer operations (returns function pointers)\n    73\ttokenizer_ops_t get_tokenizer_ops(void);\n    74\t\n    75\t// Individual functions (can also be called directly)\n    76\ttoken_t tokenizer_next_token(void);\n    77\ttoken_t tokenizer_peek_token(void);\n    78\tvoid tokenizer_reset(void);\n    79\tint tokenizer_load_text(const char *text);\n    80\tvoid tokenizer_get_stats(size_t *lines, size_t *tokens, size_t *chars);\n    81\t\n    82\t#endif // TOKENIZER_H\n=== src/analyzer.c ===\n     1\t/*\n     2\t * Copyright 2025 MIT Lincoln Laboratory\n     3\t * Permission is hereby granted, free of charge,\n     4\t * to any person obtaining a copy of this software\n     5\t * and associated documentation files (the \"Software\"),\n     6\t * to deal in the Software without restriction,\n     7\t * including without limitation the rights to use, copy,\n     8\t * modify, merge, publish, distribute, sublicense,\n     9\t * and/or sell copies of the Software,\n    10\t * and to permit persons to whom the Software is furnished to do so,\n    11\t * subject to the following conditions:\n    12\t * \n    13\t * The above copyright notice and this permission notice\n    14\t * shall be included in all copies or substantial portions of the Software.\n    15\t * \n    16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    18\t * THE WARRANTIES OF MERCHANTABILITY,\n    19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    24\t */\n    25\t#include \"analyzer.h\"\n    26\t#include <stdio.h>\n    27\t#include <string.h>\n    28\t\n    29\t// Static storage for tokenizer function pointers\n    30\tstatic tokenizer_ops_t tokenizer_ops;\n    31\tstatic int initialized = 0;\n    32\t\n    33\t// Static arrays for tracking\n    34\tstatic int token_type_counts[20];\n    35\tstatic char common_words[100][MAX_TOKEN_LENGTH];\n    36\tstatic int common_word_counts[100];\n    37\tstatic int num_common_words = 0;\n    38\t\n    39\tvoid analyzer_init(tokenizer_ops_t ops) {\n    40\t    tokenizer_ops = ops;\n    41\t    initialized = 1;\n    42\t    \n    43\t    // Reset tracking arrays\n    44\t    memset(token_type_counts, 0, sizeof(token_type_counts));\n    45\t    memset(common_word_counts, 0, sizeof(common_word_counts));\n    46\t    num_common_words = 0;\n    47\t}\n    48\t\n    49\tstatic void track_word(const char *word) {\n    50\t    // Find if word already exists\n    51\t    for (int i = 0; i < num_common_words; i++) {\n    52\t        if (strcmp(common_words[i], word) == 0) {\n    53\t            common_word_counts[i]++;\n    54\t            return;\n    55\t        }\n    56\t    }\n    57\t    \n    58\t    // Add new word\n    59\t    if (num_common_words < 100) {\n    60\t        strncpy(common_words[num_common_words], word, MAX_TOKEN_LENGTH - 1);\n    61\t        common_words[num_common_words][MAX_TOKEN_LENGTH - 1] = '\\0';\n    62\t        common_word_counts[num_common_words] = 1;\n    63\t        num_common_words++;\n    64\t    }\n    65\t}\n    66\t\n    67\tanalysis_result_t analyze_text(const char *text) {\n    68\t    analysis_result_t result = {0};\n    69\t    \n    70\t    if (!initialized) {\n    71\t        fprintf(stderr, \"Error: Analyzer not initialized\\n\");\n    72\t        return result;\n    73\t    }\n    74\t    \n    75\t    // Load text using function pointer\n    76\t    if (tokenizer_ops.load_text(text) != 0) {\n    77\t        fprintf(stderr, \"Error: Failed to load text\\n\");\n    78\t        return result;\n    79\t    }\n    80\t    \n    81\t    // Process all tokens using function pointers\n    82\t    token_t token;\n    83\t    while ((token = tokenizer_ops.next_token()).type != TOKEN_EOF) {\n    84\t        // Update counts\n    85\t        token_type_counts[token.type]++;\n    86\t        \n    87\t        switch (token.type) {\n    88\t            case TOKEN_WORD:\n    89\t            case TOKEN_IDENTIFIER:\n    90\t                result.word_count++;\n    91\t                track_word(token.value);\n    92\t                break;\n    93\t                \n    94\t            case TOKEN_NUMBER:\n    95\t                result.number_count++;\n    96\t                break;\n    97\t                \n    98\t            case TOKEN_KEYWORD:\n    99\t                result.keyword_count++;\n   100\t                break;\n   101\t                \n   102\t            case TOKEN_OPERATOR:\n   103\t                result.operator_count++;\n   104\t                break;\n   105\t                \n   106\t            case TOKEN_COMMENT:\n   107\t                result.comment_count++;\n   108\t                break;\n   109\t                \n   110\t            case TOKEN_STRING:\n   111\t                result.string_count++;\n   112\t                break;\n   113\t                \n   114\t            case TOKEN_NEWLINE:\n   115\t                result.line_count++;\n   116\t                break;\n   117\t                \n   118\t            default:\n   119\t                break;\n   120\t        }\n   121\t    }\n   122\t    \n   123\t    // Get final statistics using function pointer\n   124\t    size_t lines, tokens, chars;\n   125\t    tokenizer_ops.get_stats(&lines, &tokens, &chars);\n   126\t    \n   127\t    result.line_count = lines;\n   128\t    result.char_count = chars;\n   129\t    \n   130\t    return result;\n   131\t}\n   132\t\n   133\tvoid print_token_distribution(void) {\n   134\t    printf(\"\\n=== Token Distribution ===\\n\");\n   135\t    \n   136\t    const char *token_names[] = {\n   137\t        \"EOF\", \"WORD\", \"NUMBER\", \"PUNCTUATION\", \"WHITESPACE\",\n   138\t        \"NEWLINE\", \"IDENTIFIER\", \"KEYWORD\", \"OPERATOR\", \n   139\t        \"STRING\", \"COMMENT\", \"ERROR\"\n   140\t    };\n   141\t    \n   142\t    for (int i = 0; i < 12; i++) {\n   143\t        if (token_type_counts[i] > 0) {\n   144\t            printf(\"%s: %d\\n\", token_names[i], token_type_counts[i]);\n   145\t        }\n   146\t    }\n   147\t    \n   148\t    printf(\"\\n=== Most Common Words ===\\n\");\n   149\t    \n   150\t    // Simple bubble sort for display\n   151\t    for (int i = 0; i < num_common_words - 1; i++) {\n   152\t        for (int j = 0; j < num_common_words - i - 1; j++) {\n   153\t            if (common_word_counts[j] < common_word_counts[j + 1]) {\n   154\t                // Swap counts\n   155\t                int temp_count = common_word_counts[j];\n   156\t                common_word_counts[j] = common_word_counts[j + 1];\n   157\t                common_word_counts[j + 1] = temp_count;\n   158\t                \n   159\t                // Swap words\n   160\t                char temp_word[MAX_TOKEN_LENGTH];\n   161\t                strcpy(temp_word, common_words[j]);\n   162\t                strcpy(common_words[j], common_words[j + 1]);\n   163\t                strcpy(common_words[j + 1], temp_word);\n   164\t            }\n   165\t        }\n   166\t    }\n   167\t    \n   168\t    // Print top 10\n   169\t    int limit = num_common_words < 10 ? num_common_words : 10;\n   170\t    for (int i = 0; i < limit; i++) {\n   171\t        printf(\"%d. %s: %d times\\n\", i + 1, common_words[i], common_word_counts[i]);\n   172\t    }\n   173\t}\n   174\t\n   175\tint calculate_complexity_score(void) {\n   176\t    int score = 0;\n   177\t    \n   178\t    // Base score on keyword density\n   179\t    score += token_type_counts[TOKEN_KEYWORD] * 2;\n   180\t    \n   181\t    // Add points for operators\n   182\t    score += token_type_counts[TOKEN_OPERATOR];\n   183\t    \n   184\t    // Nesting indicators (braces)\n   185\t    score += token_type_counts[TOKEN_PUNCTUATION] / 10;\n   186\t    \n   187\t    // Comments reduce complexity (good documentation)\n   188\t    score -= token_type_counts[TOKEN_COMMENT];\n   189\t    \n   190\t    if (score < 0) score = 0;\n   191\t    \n   192\t    return score;\n   193\t}\n   194\t\n   195\tvoid find_patterns(const char *pattern) {\n   196\t    if (!initialized || !pattern) {\n   197\t        return;\n   198\t    }\n   199\t    \n   200\t    printf(\"\\n=== Searching for pattern: '%s' ===\\n\", pattern);\n   201\t    \n   202\t    // Reset tokenizer using function pointer\n   203\t    tokenizer_ops.reset();\n   204\t    \n   205\t    int count = 0;\n   206\t    token_t token;\n   207\t    \n   208\t    while ((token = tokenizer_ops.next_token()).type != TOKEN_EOF) {\n   209\t        if (strstr(token.value, pattern) != NULL) {\n   210\t            printf(\"Line %d, Column %d: %s\\n\", \n   211\t                   token.line, token.column, token.value);\n   212\t            count++;\n   213\t        }\n   214\t    }\n   215\t    \n   216\t    printf(\"Found %d occurrences\\n\", count);\n   217\t}\n=== src/main.c ===\n     1\t/*\n     2\t * Copyright 2025 MIT Lincoln Laboratory\n     3\t * Permission is hereby granted, free of charge,\n     4\t * to any person obtaining a copy of this software\n     5\t * and associated documentation files (the \"Software\"),\n     6\t * to deal in the Software without restriction,\n     7\t * including without limitation the rights to use, copy,\n     8\t * modify, merge, publish, distribute, sublicense,\n     9\t * and/or sell copies of the Software,\n    10\t * and to permit persons to whom the Software is furnished to do so,\n    11\t * subject to the following conditions:\n    12\t * \n    13\t * The above copyright notice and this permission notice\n    14\t * shall be included in all copies or substantial portions of the Software.\n    15\t * \n    16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    18\t * THE WARRANTIES OF MERCHANTABILITY,\n    19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    24\t */\n    25\t// main.c\n    26\t#include <stdio.h>\n    27\t#include <stdlib.h>\n    28\t#include <string.h>\n    29\t#include \"tokenizer.h\"\n    30\t#include \"analyzer.h\"\n    31\t\n    32\t#define MAX_INPUT_SIZE 4096\n    33\t\n    34\tvoid print_menu(void) {\n    35\t    printf(\"\\n=== Text Analyzer ===\\n\");\n    36\t    printf(\"1. Analyze text\\n\");\n    37\t    printf(\"2. Load text from file\\n\");\n    38\t    printf(\"3. Show token distribution\\n\");\n    39\t    printf(\"4. Calculate complexity score\\n\");\n    40\t    printf(\"5. Find pattern\\n\");\n    41\t    printf(\"6. Interactive tokenizer\\n\");\n    42\t    printf(\"7. Exit\\n\");\n    43\t    printf(\"Choice: \");\n    44\t}\n    45\t\n    46\tvoid print_analysis_result(analysis_result_t result) {\n    47\t    printf(\"\\n=== Analysis Results ===\\n\");\n    48\t    printf(\"Words/Identifiers: %zu\\n\", result.word_count);\n    49\t    printf(\"Numbers: %zu\\n\", result.number_count);\n    50\t    printf(\"Keywords: %zu\\n\", result.keyword_count);\n    51\t    printf(\"Operators: %zu\\n\", result.operator_count);\n    52\t    printf(\"Comments: %zu\\n\", result.comment_count);\n    53\t    printf(\"Strings: %zu\\n\", result.string_count);\n    54\t    printf(\"Lines: %zu\\n\", result.line_count);\n    55\t    printf(\"Characters: %zu\\n\", result.char_count);\n    56\t}\n    57\t\n    58\tvoid interactive_tokenizer(tokenizer_ops_t ops) {\n    59\t    printf(\"\\nEnter text (empty line to stop):\\n\");\n    60\t    \n    61\t    char input[MAX_INPUT_SIZE] = \"\";\n    62\t    char line[256];\n    63\t    \n    64\t    while (fgets(line, sizeof(line), stdin)) {\n    65\t        if (line[0] == '\\n') {\n    66\t            break;\n    67\t        }\n    68\t        strncat(input, line, MAX_INPUT_SIZE - strlen(input) - 1);\n    69\t    }\n    70\t    \n    71\t    if (ops.load_text(input) != 0) {\n    72\t        printf(\"Failed to load text\\n\");\n    73\t        return;\n    74\t    }\n    75\t    \n    76\t    printf(\"\\n=== Tokens ===\\n\");\n    77\t    \n    78\t    const char *token_type_names[] = {\n    79\t        \"EOF\", \"WORD\", \"NUMBER\", \"PUNCT\", \"SPACE\",\n    80\t        \"NEWLINE\", \"IDENT\", \"KEYWORD\", \"OPERATOR\", \n    81\t        \"STRING\", \"COMMENT\", \"ERROR\"\n    82\t    };\n    83\t    \n    84\t    token_t token;\n    85\t    int count = 0;\n    86\t    \n    87\t    while ((token = ops.next_token()).type != TOKEN_EOF) {\n    88\t        printf(\"[%s] '%s' (L%d:C%d)\\n\",\n    89\t               token_type_names[token.type],\n    90\t               token.value,\n    91\t               token.line,\n    92\t               token.column);\n    93\t        count++;\n    94\t        \n    95\t        if (count > 100) {\n    96\t            printf(\"... (truncated, too many tokens)\\n\");\n    97\t            break;\n    98\t        }\n    99\t    }\n   100\t}\n   101\t\n   102\tchar* read_file(const char *filename) {\n   103\t    FILE *file = fopen(filename, \"r\");\n   104\t    if (!file) {\n   105\t        fprintf(stderr, \"Error: Could not open file '%s'\\n\", filename);\n   106\t        return NULL;\n   107\t    }\n   108\t    \n   109\t    fseek(file, 0, SEEK_END);\n   110\t    long size = ftell(file);\n   111\t    fseek(file, 0, SEEK_SET);\n   112\t    \n   113\t    if (size