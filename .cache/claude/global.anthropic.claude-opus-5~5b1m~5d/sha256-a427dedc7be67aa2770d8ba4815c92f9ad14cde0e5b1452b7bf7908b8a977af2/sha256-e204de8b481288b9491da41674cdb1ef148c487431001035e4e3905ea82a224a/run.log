{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_018JQkjgKHiRQtYSgJc2kecA","type":"tool_result","content":"1\t//! Minimal emulation of the C stdio behaviour that the original program relies\n2\t//! on: a block-buffered `stdout`, an unbuffered `stderr` and `fgets`.\n3\t\n4\tuse std::cell::RefCell;\n5\tuse std::io::{IsTerminal, Read, Write};\n6\t\n7\t/// glibc uses the block size of the underlying file for `stdout` when it is not\n8\t/// a terminal; for pipes and regular files this is 4096 bytes.\n9\tconst OUT_BUF_SIZE: usize = 4096;\n10\t\n11\tstruct OutState {\n12\t    buf: Vec<u8>,\n13\t    line_buffered: bool,\n14\t}\n15\t\n16\tstruct InState {\n17\t    reader: std::io::BufReader<std::io::Stdin>,\n18\t}\n19\t\n20\tthread_local! {\n21\t    static OUT: RefCell<OutState> = RefCell::new(OutState {\n22\t        buf: Vec::with_capacity(OUT_BUF_SIZE),\n23\t        line_buffered: std::io::stdout().is_terminal(),\n24\t    });\n25\t\n26\t    static IN: RefCell<InState> = RefCell::new(InState {\n27\t        reader: std::io::BufReader::new(std::io::stdin()),\n28\t    });\n29\t}\n30\t\n31\t/// The Rust runtime ignores `SIGPIPE`, C programs do not.  Restoring the\n32\t/// default disposition makes a truncated output pipe terminate the process the\n33\t/// same way the original executable does.\n34\tpub fn restore_sigpipe() {\n35\t    const SIGPIPE: i32 = 13;\n36\t    const SIG_DFL: usize = 0;\n37\t    extern \"C\" {\n38\t        fn signal(signum: i32, handler: usize) -> usize;\n39\t    }\n40\t    // The single unsafe operation in this program: an FFI call that only\n41\t    // changes the signal disposition of the current process.\n42\t    unsafe {\n43\t        signal(SIGPIPE, SIG_DFL);\n44\t    }\n45\t}\n46\t\n47\tfn raw_write(data: &[u8]) {\n48\t    let mut handle = std::io::stdout();\n49\t    let _ = handle.write_all(data);\n50\t    let _ = handle.flush();\n51\t}\n52\t\n53\tfn drain(state: &mut OutState) {\n54\t    if !state.buf.is_empty() {\n55\t        let data = std::mem::take(&mut state.buf);\n56\t        raw_write(&data);\n57\t        state.buf.reserve(OUT_BUF_SIZE);\n58\t    }\n59\t}\n60\t\n61\t/// `fwrite`-like write to the buffered `stdout`.\n62\tpub fn out_bytes(data: &[u8]) {\n63\t    if data.is_empty() {\n64\t        return;\n65\t    }\n66\t    OUT.with(|cell| {\n67\t        let mut state = cell.borrow_mut();\n68\t        state.buf.extend_from_slice(data);\n69\t        if state.line_buffered {\n70\t            if state.buf.contains(&b'\\n') {\n71\t                drain(&mut state);\n72\t            }\n73\t        } else {\n74\t            while state.buf.len() >= OUT_BUF_SIZE {\n75\t                let rest = state.buf.split_off(OUT_BUF_SIZE);\n76\t                let head = std::mem::replace(&mut state.buf, rest);\n77\t                raw_write(&head);\n78\t            }\n79\t        }\n80\t    });\n81\t}\n82\t\n83\t/// `printf`-style helper for plain text.\n84\tpub fn out_str(s: &str) {\n85\t    out_bytes(s.as_bytes());\n86\t}\n87\t\n88\t/// Flush the buffered `stdout` (called at every program exit point).\n89\tpub fn out_flush() {\n90\t    OUT.with(|cell| {\n91\t        let mut state = cell.borrow_mut();\n92\t        drain(&mut state);\n93\t    });\n94\t}\n95\t\n96\tfn out_is_line_buffered() -> bool {\n97\t    OUT.with(|cell| cell.borrow().line_buffered)\n98\t}\n99\t\n100\t/// `fprintf(stderr, ...)`: stderr is unbuffered in C.\n101\tpub fn err_str(s: &str) {\n102\t    err_bytes(s.as_bytes());\n103\t}\n104\t\n105\tpub fn err_bytes(data: &[u8]) {\n106\t    let mut handle = std::io::stderr();\n107\t    let _ = handle.write_all(data);\n108\t    let _ = handle.flush();\n109\t}\n110\t\n111\tfn read_byte(state: &mut InState) -> Option<u8> {\n112\t    let mut b = [0u8; 1];\n113\t    loop {\n114\t        match state.reader.read(&mut b) {\n115\t            Ok(0) => return None,\n116\t            Ok(_) => return Some(b[0]),\n117\t            Err(ref e) if e.kind() == std::io::ErrorKind::Interrupted => continue,\n118\t            Err(_) => return None,\n119\t        }\n120\t    }\n121\t}\n122\t\n123\t/// `fgets(buf, size, stdin)`.\n124\t///\n125\t/// Reads at most `size - 1` bytes, stopping after a newline (which is kept).\n126\t/// Returns `None` when end-of-file is reached before any byte was read, which\n127\t/// mirrors `fgets` returning `NULL`.\n128\tpub fn fgets(size: usize) -> Option<Vec<u8>> {\n129\t    // glibc flushes all line buffered streams when refilling an input buffer,\n130\t    // which is what makes the interactive prompts appear on a terminal.\n131\t    if out_is_line_buffered() {\n132\t        out_flush();\n133\t    }\n134\t    if size <= 1 {\n135\t        return None;\n136\t    }\n137\t    IN.with(|cell| {\n138\t        let mut state = cell.borrow_mut();\n139\t        let mut line: Vec<u8> = Vec::new();\n140\t        while line.len() < size - 1 {\n141\t            match read_byte(&mut state) {\n142\t                None => break,\n143\t                Some(b) => {\n144\t                    line.push(b);\n145\t                    if b == b'\\n' {\n146\t                        break;\n147\t                    }\n148\t                }\n149\t            }\n150\t        }\n151\t        if line.is_empty() {\n152\t            None\n153\t        } else {\n154\t            Some(line)\n155\t        }\n156\t    })\n157\t}\n158\t\n159\t/// The contents of a C string stored in a byte buffer: everything up to (but\n160\t/// excluding) the first NUL byte.\n161\tpub fn c_str(bytes: &[u8]) -> &[u8] {\n162\t    match bytes.iter().position(|&b| b == 0) {\n163\t        Some(i) => &bytes[..i],\n164\t        None => bytes,\n165\t    }\n166\t}\n167\t\n168\t/// `strstr(haystack, needle) != NULL`\n169\tpub fn c_strstr(haystack: &[u8], needle: &[u8]) -> bool {\n170\t    if needle.is_empty() {\n171\t        return true;\n172\t    }\n173\t    if needle.len() > haystack.len() {\n174\t        return false;\n175\t    }\n176\t    haystack.windows(needle.len()).any(|w| w == needle)\n177\t}\n178\t\n179\t/// `sscanf(s, \"%d\", &out)`: returns the number of assignments performed (0 or\n180\t/// 1) together with the converted value.\n181\tpub fn sscanf_int(s: &[u8]) -> Option<i32> {\n182\t    let mut i = 0usize;\n183\t    while i < s.len() && is_space(s[i]) {\n184\t        i += 1;\n185\t    }\n186\t    if i >= s.len() {\n187\t        // Input exhausted before a conversion: `sscanf` returns EOF.\n188\t        return None;\n189\t    }\n190\t    let mut negative = false;\n191\t    if s[i] == b'+' || s[i] == b'-' {\n192\t        negative = s[i] == b'-';\n193\t        i += 1;\n194\t    }\n195\t    let start = i;\n196\t    let mut value: i64 = 0;\n197\t    let mut overflow = false;\n198\t    while i < s.len() && s[i].is_ascii_digit() {\n199\t        let digit = i64::from(s[i] - b'0');\n200\t        match value.checked_mul(10).and_then(|v| v.checked_add(digit)) {\n201\t            Some(v) => value = v,\n202\t            None => overflow = true,\n203\t        }\n204\t        i += 1;\n205\t    }\n206\t    if i == start {\n207\t        // Matching failure.\n208\t        return None;\n209\t    }\n210\t    if overflow {\n211\t        // glibc converts through `strtol`, which saturates at LONG_MIN/LONG_MAX\n212\t        // and is then truncated to `int`.\n213\t        let saturated: i64 = if negative { i64::MIN } else { i64::MAX };\n214\t        return Some(saturated as i32);\n215\t    }\n216\t    let value = if negative { -value } else { value };\n217\t    Some(value as i32)\n218\t}\n219\t\n220\t/// `isspace` in the C locale.\n221\tpub fn is_space(c: u8) -> bool {\n222\t    matches!(c, b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r')\n223\t}\n224\t\n225\t/// `isalnum` in the C locale.\n226\tpub fn is_alnum(c: u8) -> bool {\n227\t    c.is_ascii_alphanumeric()\n228\t}\n229\t\n230\t/// `isalpha` in the C locale.\n231\tpub fn is_alpha(c: u8) -> bool {\n232\t    c.is_ascii_alphabetic()\n233\t}\n234\t\n235\t/// `isdigit` in the C locale.\n236\tpub fn is_digit(c