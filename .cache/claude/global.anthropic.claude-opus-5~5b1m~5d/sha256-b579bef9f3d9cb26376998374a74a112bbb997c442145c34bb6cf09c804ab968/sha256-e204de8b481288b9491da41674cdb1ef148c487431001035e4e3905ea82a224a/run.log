 8; // 16384\n39\tconst IS_GRAPH: i32 = 128 << 8; // 32768\n40\tconst IS_BLANK: i32 = (1 << 8) >> 8; // 1\n41\tconst IS_CNTRL: i32 = (1 << 9) >> 8; // 2\n42\tconst IS_PUNCT: i32 = (1 << 10) >> 8; // 4\n43\tconst IS_ALNUM: i32 = (1 << 11) >> 8; // 8\n44\t\n45\t/// The `__ctype_b` table entry for the \"C\" locale, for the index range that a\n46\t/// (signed) `char` can produce: -128..=127.  In the \"C\" locale the negative\n47\t/// half of the table (indices -128..=-1) is all zeroes.\n48\tfn ctype_b(c: i8) -> i32 {\n49\t    if c < 0 {\n50\t        return 0;\n51\t    }\n52\t    let b = c as u8;\n53\t    let mut m = 0i32;\n54\t\n55\t    let is_upper = b.is_ascii_uppercase();\n56\t    let is_lower = b.is_ascii_lowercase();\n57\t    let is_digit = b.is_ascii_digit();\n58\t    let is_alpha = is_upper || is_lower;\n59\t    let is_alnum = is_alpha || is_digit;\n60\t    let is_graph = (0x21..=0x7e).contains(&b);\n61\t    let is_print = (0x20..=0x7e).contains(&b);\n62\t    let is_space = b == b' ' || (0x09..=0x0d).contains(&b);\n63\t    let is_blank = b == b' ' || b == 0x09;\n64\t    let is_cntrl = b <= 0x1f || b == 0x7f;\n65\t    let is_xdigit = is_digit || (b'a'..=b'f').contains(&b) || (b'A'..=b'F').contains(&b);\n66\t\n67\t    if is_upper {\n68\t        m |= IS_UPPER;\n69\t    }\n70\t    if is_lower {\n71\t        m |= IS_LOWER;\n72\t    }\n73\t    if is_alpha {\n74\t        m |= IS_ALPHA;\n75\t    }\n76\t    if is_digit {\n77\t        m |= IS_DIGIT;\n78\t    }\n79\t    if is_xdigit {\n80\t        m |= IS_XDIGIT;\n81\t    }\n82\t    if is_space {\n83\t        m |= IS_SPACE;\n84\t    }\n85\t    if is_print {\n86\t        m |= IS_PRINT;\n87\t    }\n88\t    if is_graph {\n89\t        m |= IS_GRAPH;\n90\t    }\n91\t    if is_blank {\n92\t        m |= IS_BLANK;\n93\t    }\n94\t    if is_cntrl {\n95\t        m |= IS_CNTRL;\n96\t    }\n97\t    if is_graph && !is_alnum {\n98\t        m |= IS_PUNCT;\n99\t    }\n100\t    if is_alnum {\n101\t        m |= IS_ALNUM;\n102\t    }\n103\t  