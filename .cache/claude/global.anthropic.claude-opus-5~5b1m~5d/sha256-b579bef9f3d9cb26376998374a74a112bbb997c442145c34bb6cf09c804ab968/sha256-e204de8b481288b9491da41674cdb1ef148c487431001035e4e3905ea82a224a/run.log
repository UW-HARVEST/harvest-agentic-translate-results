out: &mut Vec<u8>, label: &str, value: i32) {\n184\t    out.extend_from_slice(label.as_bytes());\n185\t    out.extend_from_slice(b\": \");\n186\t    out.extend_from_slice(value.to_string().as_bytes());\n187\t    out.push(b'\\n');\n188\t}\n189\t\n190\t/// Emits `printf(\"<label>: %c\\n\", value)`; `%c` writes `(unsigned char)value`.\n191\tfn print_char(out: &mut Vec<u8>, label: &str, value: i32) {\n192\t    out.extend_from_slice(label.as_bytes());\n193\t    out.extend_from_slice(b\": \");\n194\t    out.push((value as u32 & 0xff) as u8);\n195\t    out.push(b'\\n');\n196\t}\n197\t\n198\tfn driver(c: i8) {\n199\t    // setlocale(LC_ALL, \"C\") -- the \"C\" locale is what the tables above model.\n200\t\n201\t    let mut out: Vec<u8> = Vec::new();\n202\t    print_int(&mut out, \"alphanumeric\", isalnum(c));\n203\t    print_int(&mut out, \"alphabetic\", isalpha(c));\n204\t    print_int(&mut out, \"lowercase\", islower(c));\n205\t    print_int(&mut out, \"uppercase\", isupper(c));\n206\t    print_int(&mut out, \"digit\", isdigit(c));\n207\t    print_int(&mut out, \"hexadecimal\", isxdigit(c));\n208\t    print_int(&mut out, \"control\", iscntrl(c));\n209\t    print_int(&mut out, \"graphical\", isgraph(c));\n210\t    print_int(&mut out, \"space\", isspace(c));\n211\t    print_int(&mut out, \"blank\", isblank(c));\n212\t    print_int(&mut out, \"printing\", isprint(c));\n213\t    print_int(&mut out, \"punctuation\", ispunct(c));\n214\t    print_char(&mut out, \"to lower\", tolower(c));\n215\t    print_char(&mut out, \"to upper\", toupper(c));\n216\t\n217\t    let stdout = std::io::stdout();\n218\t    let mut lock = stdout.lock();\n219\t    let _ = lock.write_all(&out);\n220\t    let _ = lock.flush();\n221\t}\n222\t\n223\t/// getchar(): returns the next byte from stdin as an int, or EOF (-1).\n224\tfn getchar() -> i32 {\n225\t    let mut buf = [0u8; 1];\n226\t    match std::io::stdin().read(&mut buf) {\n227\t        Ok(1) => buf[0] as i32,\n228\t        _ => -1,\n229\t    }\n23