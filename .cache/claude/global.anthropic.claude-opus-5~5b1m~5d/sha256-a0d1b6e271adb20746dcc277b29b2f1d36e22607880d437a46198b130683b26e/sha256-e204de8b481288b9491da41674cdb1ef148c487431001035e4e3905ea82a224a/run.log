{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01DZfFo9kpejAwqUjp3b3iVP","type":"tool_result","content":"1\t// Rust translation of c_src/src/main.c\n2\t//\n3\t// Copyright 2025 MIT Lincoln Laboratory\n4\t// Permission is hereby granted, free of charge,\n5\t// to any person obtaining a copy of this software\n6\t// and associated documentation files (the \"Software\"),\n7\t// to deal in the Software without restriction,\n8\t// including without limitation the rights to use, copy,\n9\t// modify, merge, publish, distribute, sublicense,\n10\t// and/or sell copies of the Software,\n11\t// and to permit persons to whom the Software is furnished to do so,\n12\t// subject to the following conditions:\n13\t//\n14\t// The above copyright notice and this permission notice\n15\t// shall be included in all copies or substantial portions of the Software.\n16\t//\n17\t// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n18\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n19\t// THE WARRANTIES OF MERCHANTABILITY,\n20\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n21\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n22\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n23\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n24\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n25\t\n26\tuse std::io::{Read, IsTerminal, Write};\n27\t\n28\textern \"C\" {\n29\t    /// libc raise(), used to reproduce the fatal signal the C program dies with.\n30\t    fn raise(sig: i32) -> i32;\n31\t    /// libc signal(), used to restore the default SIGSEGV disposition (the Rust\n32\t    /// runtime installs its own handler for stack-overflow reporting).\n33\t    fn signal(sig: i32, handler: usize) -> usize;\n34\t}\n35\t\n36\tconst SIGSEGV: i32 = 11;\n37\tconst SIG_DFL: usize = 0;\n38\t\n39\t/// Emulation of C's `stdout`: fully buffered when stdout is not a terminal,\n40\t/// line buffered when it is.  This matters because the original program can die\n41\t/// from a fatal signal with data still sitting in the FILE buffer (that data is\n42\t/// then never written), so the buffering mode is observable.\n43\tstruct CStdout {\n44\t    buf: Vec<u8>,\n45\t    line_buffered: bool,\n46\t}\n47\t\n48\timpl CStdout {\n49\t    fn new() -> Self {\n50\t        CStdout {\n51\t            buf: Vec::new(),\n52\t            line_buffered: std::io::stdout().is_terminal(),\n53\t        }\n54\t    }\n55\t\n56\t    /// `printf`-style write of raw bytes.\n57\t    fn write_bytes(&mut self, bytes: &[u8]) {\n58\t        self.buf.extend_from_slice(bytes);\n59\t        if self.line_buffered && self.buf.contains(&b'\\n') {\n60\t            self.flush();\n61\t        }\n62\t    }\n63\t\n64\t    fn flush(&mut self) {\n65\t        if !self.buf.is_empty() {\n66\t            let out = std::io::stdout();\n67\t            let mut lock = out.lock();\n68\t            let _ = lock.write_all(&self.buf);\n69\t            let _ = lock.flush();\n70\t            self.buf.clear();\n71\t        }\n72\t    }\n73\t}\n74\t\n75\t/// void printLine (const char * line)\n76\t/// `line` is modelled as an optional NUL-terminated byte string; `printf(\"%s\\n\", line)`\n77\t/// stops at the first NUL byte.\n78\tfn print_line(out: &mut CStdout, line: Option<&[u8]>) {\n79\t    if let Some(line) = line {\n80\t        let end = line.iter().position(|&c| c == 0).unwrap_or(line.len());\n81\t        let mut bytes = Vec::with_capacity(end + 1);\n82\t        bytes.extend_from_slice(&line[..end]);\n83\t        bytes.push(b'\\n');\n84\t        out.write_bytes(&bytes);\n85\t    }\n86\t}\n87\t\n88\t/// `fgets(buf, size, stdin)`: reads at most `size - 1` bytes, stopping after a\n89\t/// newline (which is kept) or at EOF.  NUL-terminates what it read.  Returns\n90\t/// false (NULL in C) if EOF was hit before any byte was read.\n91\tfn fgets(buf: &mut [u8], size: usize) -> bool {\n92\t    if size == 0 {\n93\t        return false;\n94\t    }\n95\t    let limit = size - 1;\n96\t    let mut n = 0usize;\n97\t    let stdin = std::io::stdin();\n98\t    let mut lock = stdin.lock();\n99\t    let mut byte = [0u8; 1];\n100\t    while n < limit {\n101\t        match lock.read(&mut byte) {\n102\t            Ok(0) => break,           // EOF\n103\t            Ok(_) => {\n104\t                buf[n] = byte[0];\n105\t                n += 1;\n106\t                if byte[0] == b'\\n' {\n107\t                    break;\n108\t                }\n109\t            }\n110\t            Err(_) => break,          // read error\n111\t        }\n112\t    }\n113\t    if n == 0 {\n114\t        return false;\n115\t    }\n116\t    buf[n] = 0;\n117\t    true\n118\t}\n119\t\n120\t/// `atoi()` as implemented by glibc: `(int) strtol(nptr, NULL, 10)`.\n121\t/// Parses the NUL-terminated contents of `buf`.\n122\tfn atoi(buf: &[u8]) -> i32 {\n123\t    let s = &buf[..buf.iter().position(|&c| c == 0).unwrap_or(buf.len())];\n124\t    let mut i = 0usize;\n125\t    while i < s.len() && matches!(s[i], b' ' | b'\\t' | b'\\n' | 0x0b | b'\\x0c' | b'\\r') {\n126\t        i += 1;\n127\t    }\n128\t    let mut negative = false;\n129\t    if i < s.len() && (s[i] == b'+' || s[i] == b'-') {\n130\t        negative = s[i] == b'-';\n131\t        i += 1;\n132\t    }\n133\t    let mut acc: i64 = 0;\n134\t    let mut saturated = false;\n135\t    while i < s.len() && s[i].is_ascii_digit() {\n136\t        let d = i64::from(s[i] - b'0');\n137\t        if !saturated {\n138\t            match acc.checked_mul(10).and_then(|v| v.checked_add(d)) {\n139\t                Some(v) => acc = v,\n140\t                None => saturated = true, // strtol clamps to LONG_MAX / LONG_MIN\n141\t            }\n142\t        }\n143\t        i += 1;\n144\t    }\n145\t    let value: i64 = if saturated {\n146\t        if negative {\n147\t            i64::MIN\n148\t        } else {\n149\t            i64::MAX\n150\t        }\n151\t    } else if negat