ialize_hash_function(ctx: &mut SpxCtx);\npub fn prf_addr(out: &mut [u8], ctx: &SpxCtx, addr: &[u32; 8]);   // writes SPX_N bytes\npub fn thash(out: &mut [u8], input: &[u8], inblocks: u32, ctx: &SpxCtx, addr: &mut [u32; 8]);\n```\n`thash` reads ALL of `input` before writing `out`; where C passes overlapping\npointers, copy the input into a local buffer first.\n\n`crate::address`:\n```rust\npub const SPX_ADDR_TYPE_WOTS: u32 = 0; // WOTSPK=1, HASHTREE=2, FORSTREE=3, FORSPK=4, WOTSPRF=5, FORSPRF=6\npub fn set_layer_addr(addr: &mut [u32; 8], layer: u32);\npub fn set_tree_addr(addr: &mut [u32; 8], tree: u64);\npub fn set_type(addr: &mut [u32; 8], type_: u32);\npub fn copy_subtree_addr(out: &mut [u32; 8], input: &[u32; 8]);\npub fn set_keypair_addr(addr: &mut [u32; 8], keypair: u32);\npub fn set_chain_addr(addr: &mut [u32; 8], chain: u32);\npub fn set_hash_addr(addr: &mut [u32; 8], hash: u32);\npub fn copy_keypair_addr(out: &mut [u32; 8], input: &[u32; 8]);\npub fn set_tree_height(addr: &mut [u32; 8], tree_height: u32);\npub fn set_tree_index(addr: &mut [u32; 8], tree_index: u32);\npub fn addr_bytes(addr: &[u32; 8]) -> &[u8; 32];\npub fn addr_bytes_mut(addr: &mut [u32; 8]) -> &mut [u8; 32];\n```\n`crate::utils`:\n```rust\npub fn ull_to_bytes(out: &mut [u8], outlen: u32, input: u64);\npub fn u32_to_bytes(out: &mut [u8], input: u32);\npub fn bytes_to_ull(input: &[u8], inlen: u32) -> u64;\npub fn compute_root(root: &mut [u8], leaf: &[u8], leaf_idx: u32, idx_offset: u32,\n                    auth_path: &[u8], tree_height: u32, ctx: &SpxCtx, addr: &mut [u32; 8]);\n```\n\n=== C symbol naming ===\n`SPX_NAMESPACE(s)` expands to `SPX_##s`. All functions declared in\napp/include/wots.h, app/include/wotsx1.h and app/include/utilsx1.h have a\n`#define foo SPX_NAMESPACE(foo)` line, so their linker symbols are\n`SPX_wots_pk_from_sig`, `SPX_chain_lengths`, `SPX_wots_gen_leafx1`,\n`SPX_wots_treehashx1`, `SPX_fors_treehashx1`.\n\n=== YOUR TASK ===\nTranslate:\n  * c_src/app/src/wots.c    (