t(addr: &mut [u32; 8]) -> &mut [u8; 32];\n```\n`crate::utils` provides:\n```rust\npub fn ull_to_bytes(out: &mut [u8], outlen: u32, input: u64);\npub fn u32_to_bytes(out: &mut [u8], input: u32);\npub fn bytes_to_ull(input: &[u8], inlen: u32) -> u64;\n```\n\n=== C symbol naming ===\n`SPX_NAMESPACE(s)` expands to `SPX_##s`. A C function gets linker symbol `SPX_foo`\nONLY if its header has a line `#define foo SPX_NAMESPACE(foo)`.\nIn c_src/lib/sha2/include/sha2.h: `mgf1_256`, `mgf1_512`, `seed_state` ARE namespaced\n(-> `SPX_mgf1_256`, `SPX_mgf1_512`, `SPX_seed_state`), while `sha256_inc_init`,\n`sha256_inc_blocks`, `sha256_inc_finalize`, `sha256`, `sha512_inc_init`,\n`sha512_inc_blocks`, `sha512_inc_finalize`, `sha512` are NOT namespaced — they keep\ntheir plain names. All functions in app/include/hash.h and app/include/thash.h ARE\nnamespaced (`SPX_prf_addr`, `SPX_thash`, ...).\n\n=== YOUR TASK: the SHA2 hash backend ===\nTranslate these C files:\n  * c_src/lib/sha2/src/sha2.c                (701 lines) -> translation/src/backend/sha2.rs\n  * c_src/lib/sha2/src/hash_sha2.c           (198 lines) -> translation/src/backend/hash_sha2.rs\n  * c_src/lib/sha2/src/thash_sha2_robust.c   (75 lines)  -> translation/src/backend/thash_sha2.rs\n  * c_src/lib/sha2/src/thash_sha2_simple.c   (60 lines)  -> (same file, see below)\nRead also c_src/lib/sha2/include/sha2.h, c_src/app/include/hash.h, c_src/app/include/thash.h.\n\n`translation/src/backend/thash_sha2.rs` must contain BOTH variants, gated:\n```rust\n#[cfg(not(feature = \"simple\"))]   // THASH=robust (CMake default)\nmod robust_impl { ... pub fn thash(...) ... }\n#[cfg(feature = \"simple\")]        // THASH=simple\nmod simple_impl { ... pub fn thash(...) ... }\n#[cfg(not(feature = \"simple\"))]\npub use robust_impl::thash;\n#[cfg(feature = \"simple\")]\npub use simple_impl::thash;\n```\nplus ONE `#[unsafe(no_mangle)] pub extern \"C\" fn SPX_thash(...)` wrapper outside the\ncfg blocks forwarding to the selected `thash`.\n\nREQUIRED public safe-Rust API (EXACT signatures — other modules depend on them):\n\nsrc/backend/sha2.rs:\n```rust\npub const SPX_SHA256_BLOCK_BYTES: usize = 64;\npub const SPX_SHA256_OUTPUT_BYTES: usize = 32;\npub const SPX_SHA512_BLOCK_BYTES: usize = 128;\npub const SPX_SHA512_OUTPUT_BYTES: usize = 64;\npub const SPX_SHA256_ADDR_BYTES: usize = 22;\n\npub fn sha256_inc_init(state: &mut [u8]);                       // 40-byte state\npub fn sha256_inc_blocks(state: &mut [u8], input: &[u8], inblocks: usize);\npub fn sha256_inc_finalize(out: &mut [u8], state: &mut [u8], input: &[u8]);\npub fn sha256(out: &mut [u8], input: &[u8]);\npub fn sha512_inc_init(state: &mut [u8]);                       // 72-byte state\npub fn sha512_inc_blocks(state: &mut [u8], input: &[u8], inblocks: usize);\npub fn sha512_inc_finalize(out: &mut [u8], state: &mut [u8], input: &[u8]);\npub fn sha512(out: &mut [u8], input: &[u8]);\npub fn mgf1_256(out: &mut [u8], input: &[u8]);                  // outlen = out.len()\npub fn mgf1_512(out: &mut [u8], input: &[u8]);\npub fn seed_state(ctx: &mut SpxCtx);\n```\nNote the incremental states pack 8 big-endian words plus an 8-byte byte-counter\nexactly as in the C code — reproduce the layout byte for byte.\n\nsrc/backend/hash_sha2.rs:\n```rust\npub fn initialize_hash_function(ctx: &mut SpxCtx);\npub fn prf_addr(out: &mut [u8], ctx: &SpxCtx, addr: &[u32; 8]);\npub fn gen_message_random(r: &mut [u8], sk_prf: &[u8], optrand: &[u8], m: &[u8], ctx: &SpxCtx);\npub fn hash_message(digest: &mut [u8], tree: &mut u64, leaf_idx: &mut u32,\n                    r: &[u8], pk: &[u8], m: &[u8], ctx: &SpxCtx);\n```\nAdd `#[unsafe(no_mangle)] pub extern \"C\"` wrappers `SPX_initialize_hash_function`,\n`SPX_prf_addr`, `SPX_gen_message_random`, `SPX_hash_message` with the exact C\nsignatures from app/include/hash.h, and plain-named wrappers `sha256`,\n`sha256_inc_init`, `sha256_inc_blocks`, `sha256_inc_finalize`, `sha512`,\n`sha512_inc_init`, `sha512_inc_blocks`, `sha512_inc_