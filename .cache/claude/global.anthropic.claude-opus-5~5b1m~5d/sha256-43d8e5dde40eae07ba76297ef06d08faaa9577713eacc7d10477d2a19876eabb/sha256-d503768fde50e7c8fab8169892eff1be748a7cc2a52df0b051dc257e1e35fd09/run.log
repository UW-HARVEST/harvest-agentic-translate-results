ub sk_seed: [u8; SPX_N],\n    #[cfg(feature = \"sha2\")] pub state_seeded: [u8; 40],\n    #[cfg(feature = \"sha2\")] pub state_seeded_512: [u8; 72],\n    #[cfg(feature = \"haraka\")] pub tweaked512_rc64: [[u64; 8]; 10],\n    #[cfg(feature = \"haraka\")] pub tweaked256_rc32: [[u32; 8]; 10],\n}\nimpl SpxCtx { pub fn new() -> Self }\n```\nNOTE: your module is only compiled when the haraka backend is selected, so\n`ctx.tweaked512_rc64` / `ctx.tweaked256_rc32` are always present.\n\n`crate::address` provides:\n```rust\npub const SPX_ADDR_TYPE_WOTS: u32 = 0; // ..WOTSPK=1, HASHTREE=2, FORSTREE=3, FORSPK=4, WOTSPRF=5, FORSPRF=6\npub fn set_layer_addr(addr: &mut [u32; 8], layer: u32);\npub fn set_tree_addr(addr: &mut [u32; 8], tree: u64);\npub fn set_type(addr: &mut [u32; 8], type_: u32);\npub fn copy_subtree_addr(out: &mut [u32; 8], input: &[u32; 8]);\npub fn set_keypair_addr(addr: &mut [u32; 8], keypair: u32);\npub fn set_chain_addr(addr: &mut [u32; 8], chain: u32);\npub fn set_hash_addr(addr: &mut [u32; 8], hash: u32);\npub fn copy_keypair_addr(out: &mut [u32; 8], input: &[u32; 8]);\npub fn set_tree_height(addr: &mut [u32; 8], tree_height: u32);\npub fn set_tree_index(addr: &mut [u32; 8], tree_index: u32);\npub fn addr_bytes(addr: &[u32; 8]) -> &[u8; 32];        // native-endian byte view\npub fn addr_bytes_mut(addr: &mut [u32; 8]) -> &mut [u8; 32];\n```\n`crate::utils` provides:\n```rust\npub fn ull_to_bytes(out: &mut [u8], outlen: u32, input: u64);\npub fn u32_to_bytes(out: &mut [u8], input: u32);\npub fn bytes_to_ull(input: &[u8], inlen: u32) -> u64;\n```\n\n=== C symbol naming ===\n`SPX_NAMESPACE(s)` expands to `SPX_##s`. Every C function whose header contains\n`#define foo SPX_NAMESPACE(foo)` has FINAL linker symbol `SPX_foo`; functions\nwithout such a line keep their plain name. In c_src/lib/haraka/include/haraka.h\nALL functions have the `#define` line, so they are all `SPX_`-prefixed. So are\nall functions in app/include/hash.h and app/include/thash.h.\n\n=== YOUR TASK: the HARAKA hash backend ===\nTranslate these C files:\n  * c_src/lib/haraka/src/haraka.c              (965 lines) -> translation/src/backend/haraka.rs\n  * c_src/lib/haraka/src/hash_haraka.c         (96 lines)  -> translation/src/backend/hash_haraka.rs\n  * c_src/lib/haraka/src/thash_haraka_robust.c (46 lines)  -> translation/src/backend/thash_haraka.rs\n  * c_src/lib/haraka/src/thash_haraka_simple.c (37 lines)  -> (same file, see below)\nRead also c_src/lib/haraka/include/haraka.h, c_src/app/include/hash.h,\nc_src/app/include/thash.h.\n\n`translation/src/backend/thash_haraka.rs` must contain BOTH variants, gated:\n```rust\n#[cfg(not(feature = \"simple\"))]   // THASH=robust (CMake default)\nmod robust_impl { ... pub fn thash(...) ... }\n#[cfg(feature = \"simple\")]        // THASH=simple\nmod simple_impl { ... pub fn thash(...) ... }\n#[cfg(not(feature = \"simple\"))]\npub use robust_impl::thash;\n#[cfg(feature = \"simple\")]\npub use simple_impl::thash;\n```\nplus ONE `#[unsafe(no_mangle)] pub extern \"C\" fn SPX_thash(...)` wrapper outside the\ncfg blocks that forwards to the selected `thash`.\n(Use `#[cfg(feature = \"simple\")]` for the simple variant and\n`#[cfg(not(feature = \"simple\"))]` for robust, so that the CMake default `robust`\nis what you get when neither/both is requested.)\n\nREQUIRED public safe-Rust API (other modules depend on these EXACT signatures):\n\nsrc/backend/haraka.rs:\n```rust\npub fn tweak_constants(ctx: &mut SpxCtx);\npub fn haraka_S_inc_init(s_inc: &mut [u8]);                                  // 64+1 bytes\npub fn haraka_S_inc_absorb(s_inc: &mut [u8], m: &[u8], ctx: &SpxCtx);        // mlen = m.len()\npub fn haraka_S_inc_finalize(s_inc: &mut [u8]);\npub fn haraka_S_inc_squeeze(out: &mut [u8], s_inc: &mut [u8], ctx: &SpxCtx); // outlen = out.len()\npub fn haraka_S(out: &mut [u8], input: &[u8], ctx: &SpxCtx);\npub fn haraka512_perm(out: &mut [u8], input: &[u8], ctx: &SpxCtx);\npub fn haraka512(out: &mut [u8], input: &[u8], ctx: &SpxCtx);\npub fn haraka256(out: &mut [u8], input: &[u8], ctx: &SpxCtx);\n```\nAlso translate faithfully any `static` helper functions in haraka.c\n(e.g. `load_constants`, `haraka512_perm_zero`, `haraka256_sk`, `aesenc`, `mix256`,\n`mix512`, the round-constant tables, etc.) as private items. If haraka.c defines\nextra non-static functions not in the header (check with\n`grep -n '^[a-z].*(' c_src/lib/haraka/src/haraka.c`), export those too under their\nnamespaced names if the file uses the SPX_NAMESPACE `#define`s, otherwise plain.\nThe AES round function in haraka.c is a portable software implementation with\nS-box tables — translate it exactly (do NOT substitute the `aes` crate).\n\nsrc/backend/hash_haraka.rs:\n```rust\npub fn initialize_hash_function(ctx: &mut SpxCtx);\npub fn prf_addr(out: &mut [u8], ctx: &SpxCtx, addr: &[u32; 8]);   // writes SPX_N bytes\npub fn gen_message_random(r: &mut [u8], sk_prf: &[u8], optrand: &[u8], m: &[u8], ctx: &SpxCtx);\npub fn hash_message(digest: &mut [u8], tree: &mut u64, leaf_idx: &mut u32,\n                    r: &[u8], pk: &[u8], m: &[u8], ctx: &SpxCtx);\n```\n(the C versions take `unsigned long long mlen` — use `m.len()`.)\nAdd `#[unsafe(no_mangle)] pub extern \"C\"` wrappers named\n`SPX_initialize_hash_function`, `SPX_prf_addr`, `SPX_gen_message_random`,\n`SPX_hash_message` with the exact C signatures from app/include/hash.h.\n\nsrc/backend/thash_haraka.rs:\n```rust\npub fn thash(out: &mut [u8], input: &[u8], inblocks: u32, ctx: &SpxCtx, addr: &mut [u32; 8]);\n```\n`thash` must read all of `input` before writing `out`.\n\nFinally verify with, from /local/home/scheschb/.harvest/work/harvest-work-NMiSQO/translation:\n`cargo build --release 2>&1 | grep -E \"haraka\" | head -60`\nFix every error in your three files. Report line counts of the files you wrote and any\nremaining errors attributable to them."}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7316,