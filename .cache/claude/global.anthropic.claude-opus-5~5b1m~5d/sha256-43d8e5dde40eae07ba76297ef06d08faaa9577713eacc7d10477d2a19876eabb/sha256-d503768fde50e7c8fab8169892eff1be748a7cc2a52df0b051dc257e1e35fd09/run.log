ke,$TH,$SEC\" 2>&1 | grep -E \"^error\" -A4 | head -20)\n  rm -f rtest_x\n  rustc --edition 2021 -O -C panic=abort -L $D/target/release/deps --extern sphincs_core_det=$D/target/release/libsphincs_core_det.rlib rtest.rs -o rtest_x 2>&1 | grep -E \"^error\" -A6 | head -30\n  ./rtest_x > r_out.txt\n  if diff -q c_out.txt r_out.txt >/dev/null; then echo \"MATCH $SEC $TH ($(wc -l < c_out.txt) lines)\"; else echo \"DIFF $SEC $TH:\"; diff c_out.txt r_out.txt | head -12; fi\ndone","is_backgrounded":false,"task_type":"local_bash","uuid":"d5ea7f2f-2d77-49ee-9aba-ab4a0a240229","session_id":"eb87ec4e-54f9-48e5-a5c6-d85aefaf339c"}
