n#if SPXSHA512\n    ph(\"state_seeded512\", ctxbuf + 2 * SPXN + 40, 72);\n#endif\n    uint32_t addr[8];\n    for (int i = 0; i < 8; i++) addr[i] = 0x11223344u * (uint32_t)(i + 1) + 0x5u;\n    unsigned char out[1024];\n    SPX_prf_addr(out, ctxbuf, addr); ph(\"prf_addr\", out, SPXN);\n    unsigned int blks[] = {1, 2, 3, 14, 35};\n    for (int k = 0; k < 5; k++) { memset(out,0,sizeof(out)); SPX_thash(out, msg + 3, blks[k], ctxbuf, addr);\n        char tag[64]; sprintf(tag, \"thash%u\", blks[k]); ph(tag, out, SPXN); }\n    unsigned long long mlens[] = {0,1,10,31,32,33,47,48,49,63,64,65,95,96,97,103,104,105,111,112,127,128,129,200,1000,3000};\n    unsigned char skprf[64], optrand[64];\n    for (int i = 0; i < SPXN; i++) { skprf[i]=(unsigned char)(0x11*i+3); optrand[i]=(unsigned char)(0x07*i+200); }\n    unsigned char pk[128]; for (int i = 0; i < 2*SPXN; i++) pk[i]=(unsigned char)(0x33+5*i);\n    unsigned char R[64]; for (int i = 0; i < SPXN; i++) R[i]=(unsigned char)(0x91+3*i);\n    for (int k = 0; k < (int)(sizeof(mlens)/sizeof(mlens[0])); k++) {\n        char tag[64]; memset(out,0,sizeof(out));\n        SPX_gen_message_random(out, skprf, optrand, msg+5, mlens[k], ctxbuf);\n        sprintf(tag, \"gmr%llu\", mlens[k]); ph(tag, out, SPXN);\n        unsigned char dig[256]; uint64_t tree=0xdeadbeefcafe1234ull; uint32_t leaf=0x12345678u;\n        memset(dig,0,sizeof(dig));\n        SPX_hash_message(dig,&tree,&leaf,R,pk,msg+5,mlens[k],ctxbuf);\n        sprintf(tag, \"hm%llu\", mlens[k]); ph(tag, dig, DGST);\n        printf(\"hmidx%llu:%016llx %08x\\n\", mlens[k], (unsigned long long)tree, leaf);\n    }\n    for (unsigned long ol = 1; ol <= 200; ol += 37) { char tag[64];\n        memset(out,0,sizeof(out)); SPX_mgf1_256(out,ol,msg+11,40); sprintf(tag,\"mgf256_%lu\",ol); ph(tag,out,ol);\n        memset(out,0,sizeof(out)); SPX_mgf1_512(out,ol,msg+11,40); sprintf(tag,\"mgf512_%lu\",ol); ph(tag,out,ol); }\n    for (size_t l = 0; l < 300; l += 13) { unsigned char h[64]; char tag[64];\n        sha256(h,msg,l); sprintf(tag,\"sha256_%zu\",l); ph(tag,h,32);\n        sha512(h,msg,l); sprintf(tag,\"sha512_%zu\",l); ph(tag,h,64); }\n    return 0;\n}\nEOF\nrun_one() {\n  SEC=$1; THASHV=$2; N=$3; BIG=$4; DGST=$5\n  B=\"$T/c_${SEC}_$THASHV\"; mkdir -p \"$B\"\n  cmake -S $W/c_src -B \"$B\" -DHASH_BACKEND=sha2 -DTHASH=$THASHV -DSECPAR=$SEC > \"$B/cm.log\" 2>&1\n  cmake --build \"$B\" --target sha2 sphincs_core -j8 > \"$B/bl.log\" 2>&1 || { echo \"$SEC/$THASHV C BUILD FAIL\"; return 0; }\n  CSO=$(find \"$B\" -name libsha2.so); CORE=$(find \"$B\" -name libsphincs_core.so)\n  gcc -O2 -DSPXN=$N -DSPXSHA512=$BIG -DDGST=$DGST -o \"$B/hc\" \"$T/harness.c\" \"$CSO\" \"$CORE\" -Wl,-rpath,$(dirname $CSO):$(dirname $CORE) 2>/dev/null\n  \"$B/hc\" > \"$B/c.out\"\n  ( cd $W/translation && cargo build --release --no-default-features --features \"sha2,$THASHV,$SEC\" > \"$B/rs.log\" 2>&1 ) || { echo \"$SEC/$THASHV RUST BUILD FAIL\"; return 0; }\n  cp $W/translation/target/release/libsphincs_core_det.so \"$B/librs.so\"\n  gcc -O2 -DSPXN=$N -DSPXSHA512=$BIG -DDGST=$DGST -o \"$B/hr\" \"$T/harness.c\" \"$B/librs.so\" -Wl,-rpath,\"$B\" 2>/dev/null\n  \"$B/hr\" > \"$B/r.out\"\n  if diff -q \"$B/c.out\" \"$B/r.out\" > /dev/null; then echo \"$SEC/$THASHV MATCH\"; else echo \"$SEC/$THASHV MISMATCH\"; diff \"$B/c.out\" \"$B/r.out\" | head -10; fi\n}\nfor TH in robust simple; do\n  run_one 128s $TH 16 0 30\n  run_one 128f $TH 16 0 34\n  run_one 192s $TH 24 1 39\n  run_one 192f $TH 24 1 42\n  run_one 256s $TH 32 1 47\n  run_one 256f $TH 32 1 49\ndone","is_backgrounded":false,"task_type":"local_bash","uuid":"2ae69173-1be2-499f-a5f7-3193a81ca07a","session_id":"eb87ec4e-54f9-48e5-a5c6-d85aefaf339c"}
