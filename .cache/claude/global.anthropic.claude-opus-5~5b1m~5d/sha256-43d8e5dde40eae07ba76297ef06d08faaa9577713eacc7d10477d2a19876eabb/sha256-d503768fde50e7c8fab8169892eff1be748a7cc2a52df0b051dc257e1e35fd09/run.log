for (size_t i = 0; i < 64; ++i) {\n604\t        out[i] = state[i];\n605\t    }\n606\t}\n607\t\n608\tvoid sha256(uint8_t *out, const uint8_t *in, size_t inlen) {\n609\t    uint8_t state[40];\n610\t\n611\t    sha256_inc_init(state);\n612\t    sha256_inc_finalize(out, state, in, inlen);\n613\t}\n614\t\n615\tvoid sha512(uint8_t *out, const uint8_t *in, size_t inlen) {\n616\t    uint8_t state[72];\n617\t\n618\t    sha512_inc_init(state);\n619\t    sha512_inc_finalize(out, state, in, inlen);\n620\t}\n621\t\n622\t/**\n623\t * mgf1 function based on the SHA-256 hash function\n624\t * Note that inlen should be sufficiently small that it still allows for\n625\t * an array to be allocated on the stack. Typically 'in' is merely a seed.\n626\t * Outputs outlen number of bytes\n627\t */\n628\tvoid mgf1_256(unsigned char *out, unsigned long outlen,\n629\t          const unsigned char *in, unsigned long inlen)\n630\t{\n631\t    SPX_VLA(uint8_t, inbuf, inlen+4);\n632\t    unsigned char outbuf[SPX_SHA256_OUTPUT_BYTES];\n633\t    unsigned long i;\n634\t\n635\t    memcpy(inbuf, in, inlen);\n636\t\n637\t    /* While we can fit in at least another full block of SHA256 output.. */\n638\t    for (i = 0; (i+1)*SPX_SHA256_OUTPUT_BYTES <= outlen; i++) {\n639\t        u32_to_bytes(inbuf + inlen, i);\n640\t        sha256(out, inbuf, inlen + 4);\n641\t        out += SPX_SHA256_OUTPUT_BYTES;\n642\t    }\n643\t    /* Until we cannot anymore, and we fill the remainder. */\n644\t    if (outlen > i*SPX_SHA256_OUTPUT_BYTES) {\n645\t        u32_to_bytes(inbuf + inlen, i);\n646\t        sha256(outbuf, inbuf, inlen + 4);\n647\t        memcpy(out, outbuf, outlen - i*SPX_SHA256_OUTPUT_BYTES);\n648\t    }\n649\t}\n650\t\n651\t/*\n652\t * mgf1 function based on the SHA-512 hash function\n653\t */\n654\tvoid mgf1_512(unsigned char *out, unsigned long outlen,\n655\t          const unsigned char *in, unsigned long inlen)\n656\t{\n657\t    SPX_VLA(uint8_t, inbuf, inlen+4);\n658\t    unsigned char outbuf[SPX_SHA5