t * (the chain address)\n100\t */\n101\tpub fn set_chain_addr(addr: &mut [u32; 8], chain: u32) {\n102\t    addr_bytes_mut(addr)[SPX_OFFSET_CHAIN_ADDR] = chain as u8;\n103\t}\n104\t\n105\t/*\n106\t * Specify where in the Merkle chain we are (the hash address)\n107\t */\n108\tpub fn set_hash_addr(addr: &mut [u32; 8], hash: u32) {\n109\t    addr_bytes_mut(addr)[SPX_OFFSET_HASH_ADDR] = hash as u8;\n110\t}\n111\t\n112\t/* These functions are used for all hash tree addresses (including FORS). */\n113\t\n114\t/*\n115\t * Specify the height of the node in the Merkle/FORS tree we are in\n116\t * (the tree height)\n117\t */\n118\tpub fn set_tree_height(addr: &mut [u32; 8], tree_height: u32) {\n119\t    addr_bytes_mut(addr)[SPX_OFFSET_TREE_HGT] = tree_height as u8;\n120\t}\n121\t\n122\t/*\n123\t * Specify the distance from the left edge of the node in the Merkle/FORS tree\n124\t * (the tree index)\n125\t */\n126\tpub fn set_tree_index(addr: &mut [u32; 8], tree_index: u32) {\n127\t    let bytes = addr_bytes_mut(addr);\n128\t    u32_to_bytes(\n129\t        &mut bytes[SPX_OFFSET_TREE_INDEX..SPX_OFFSET_TREE_INDEX + 4],\n130\t        tree_index,\n131\t    );\n132\t}\n133\t\n134\t// ---------------------------------------------------------------------------\n135\t// C ABI wrappers (exported linker symbols carry the `SPX_` namespace prefix)\n136\t// ---------------------------------------------------------------------------\n137\t\n138\t#[inline]\n139\tunsafe fn as_addr_mut(addr: *mut u32) -> &'static mut [u32; 8] {\n140\t    unsafe { &mut *(addr as *mut [u32; 8]) }\n141\t}\n142\t\n143\t#[inline]\n144\tunsafe fn as_addr(addr: *const u32) -> &'static [u32; 8] {\n145\t    unsafe { &*(addr as *const [u32; 8]) }\n146\t}\n147\t\n148\t#[unsafe(no_mangle)]\n149\tpub extern \"C\" fn SPX_set_layer_addr(addr: *mut u32, layer: u32) {\n150\t    unsafe { set_layer_addr(as_addr_mut(addr), layer) }\n151\t}\n152\t\n153\t#[unsafe(no_mangle)]\n154\tpub extern \"C\" fn SPX_set_tree_addr(addr: *mut u32,