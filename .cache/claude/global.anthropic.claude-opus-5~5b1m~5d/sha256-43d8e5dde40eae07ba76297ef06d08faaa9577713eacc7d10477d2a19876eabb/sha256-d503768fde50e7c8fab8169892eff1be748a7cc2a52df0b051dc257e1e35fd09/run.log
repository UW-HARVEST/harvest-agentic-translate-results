g));\n        SPX_hash_message(dig, &tree, &leaf, R, pk, msg + 5, mlens[k], ctxbuf);\n        sprintf(tag, \"hm%llu\", mlens[k]); ph(tag, dig, DGST);\n        printf(\"hmidx%llu:%016llx %08x\\n\", mlens[k], (unsigned long long)tree, leaf);\n    }\n    for (unsigned long ol = 1; ol <= 200; ol += 37) {\n        char tag[64];\n        memset(out, 0, sizeof(out));\n        SPX_mgf1_256(out, ol, msg + 11, 40); sprintf(tag, \"mgf256_%lu\", ol); ph(tag, out, ol);\n        memset(out, 0, sizeof(out));\n        SPX_mgf1_512(out, ol, msg + 11, 40); sprintf(tag, \"mgf512_%lu\", ol); ph(tag, out, ol);\n    }\n    for (size_t l = 0; l < 300; l += 13) {\n        unsigned char h[64]; char tag[64];\n        sha256(h, msg, l); sprintf(tag, \"sha256_%zu\", l); ph(tag, h, 32);\n        sha512(h, msg, l); sprintf(tag, \"sha512_%zu\", l); ph(tag, h, 64);\n    }\n    { uint8_t st[40]; sha256_inc_init(st); sha256_inc_blocks(st, msg, 3);\n      unsigned char h[32]; sha256_inc_finalize(h, st, msg + 192, 50); ph(\"incr256\", h, 32); }\n    { uint8_t st[72]; sha512_inc_init(st); sha512_inc_blocks(st, msg, 3);\n      unsigned char h[64]; sha512_inc_finalize(h, st, msg + 384, 130); ph(\"incr512\", h, 64); }\n    return 0;\n}\nEOF\nrun_one() {\n  SEC=$1; THASHV=$2; N=$3; BIG=$4; DGST=$5\n  echo \"########## sha2 / $THASHV / $SEC ##########\"\n  B=\"$T/c_$SEC$THASHV\"; mkdir -p \"$B\"\n  cmake -S $W/c_src -B \"$B\" -DHASH_BACKEND=sha2 -DTHASH=$THASHV -DSECPAR=$SEC > \"$B/cm.log\" 2>&1\n  cmake --build \"$B\" --target sha2 sphincs_core -j8 > \"$B/bl.log\" 2>&1 || { echo \"C BUILD FAIL\"; tail -20 \"$B/bl.log\"; return 1; }\n  CSO=$(find \"$B\" -name libsha2.so); CORE=$(find \"$B\" -name libsphincs_core.so)\n  gcc -O2 -DSPXN=$N -DSPXSHA512=$BIG -DDGST=$DGST -o \"$B/hc\" \"$T/harness.c\" \"$CSO\" \"$CORE\" -Wl,-rpath,$(dirname $CSO):$(dirname $CORE) 2>&1 | head -5\n  \"$B/hc\" > \"$B/c.out\"\n  ( cd $W/translation && cargo build --release --no-default-features --features \"sha2,$THASHV,$SEC\" > \"$B