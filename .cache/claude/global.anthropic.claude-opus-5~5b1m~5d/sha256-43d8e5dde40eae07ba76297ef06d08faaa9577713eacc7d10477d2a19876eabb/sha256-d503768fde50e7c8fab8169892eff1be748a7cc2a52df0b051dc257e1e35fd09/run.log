c/main.rs <<'EOF'\n#![allow(non_snake_case)]\n#![allow(non_upper_case_globals)]\n#![allow(dead_code)]\nmod address;\nmod backend;\nmod context;\nmod params;\nmod utils;\n\nuse backend::haraka::{haraka256, haraka512, haraka512_perm, haraka_S, tweak_constants};\nuse backend::{gen_message_random, hash_message, prf_addr, thash};\nuse context::SpxCtx;\nuse params::*;\n\nfn ph(n: &str, b: &[u8]) {\n    print!(\"{} \", n);\n    for x in b { print!(\"{:02x}\", x); }\n    println!();\n}\n\nfn main() {\n    let mut ctx = SpxCtx::new();\n    for i in 0..SPX_N { ctx.pub_seed[i] = (i * 7 + 1) as u8; ctx.sk_seed[i] = (i * 13 + 3) as u8; }\n    tweak_constants(&mut ctx);\n    let rc64: &[u8] = unsafe { core::slice::from_raw_parts(ctx.tweaked512_rc64.as_ptr() as *const u8, 640) };\n    ph(\"rc64\", rc64);\n    let rc32: &[u8] = unsafe { core::slice::from_raw_parts(ctx.tweaked256_rc32.as_ptr() as *const u8, 320) };\n    ph(\"rc32\", rc32);\n\n    let mut in64 = [0u8; 64];\n    for i in 0..64 { in64[i] = (i * 3 + 5) as u8; }\n    let mut out = [0u8; 64];\n    haraka512(&mut out[..32], &in64, &ctx); ph(\"h512\", &out[..32]);\n    haraka512_perm(&mut out, &in64, &ctx); ph(\"perm\", &out[..64]);\n    haraka256(&mut out[..32], &in64[..32], &ctx); ph(\"h256\", &out[..32]);\n\n    let mut big = [0u8; 80];\n    let mut L = 0usize;\n    while L <= 100 {\n        let mut m = [0u8; 100];\n        for i in 0..L { m[i] = (i * 11) as u8; }\n        haraka_S(&mut big[..37], &m[..L], &ctx);\n        ph(\"hS\", &big[..37]);\n        L += 7;\n    }\n    let mut OL = 1usize;\n    while OL <= 70 {\n        let mut m = [0u8; 40];\n        for i in 0..40 { m[i] = (i * 9 + 2) as u8; }\n        haraka_S(&mut big[..OL], &m, &ctx);\n        ph(\"hS2\", &big[..OL]);\n        OL += 9;\n    }\n\n    let mut addr: [u32; 8] = [1, 2, 3, 4, 5, 6, 7, 8];\n    let mut o = [0u8; 64];\n    prf_addr(&mut o[..SPX_N], &ctx, &addr); ph(\"prf\", &o[..SPX_N]);\n\n    let mut inb = vec![0u8; 64 * SPX_N];\n    for i in 0..inb.len() { inb[i] = (i * 5 + 1) as u8; }\n    for nb in 1..=SPX_FORS_TREES as u32 {\n        thash(&mut o[..SPX_N], &inb, nb, &ctx, &mut addr);\n        ph(\"thash\", &o[..SPX_N]);\n    }\n\n    let mut R = [0u8; 64];\n    let mut skprf = vec![0u8; SPX_N];\n    let mut optrand = vec![0u8; SPX_N];\n    let mut pk = vec![0u8; 2 * SPX_N];\n    let mut msg = [0u8; 137];\n    for i in 0..SPX_N { skprf[i] = (i + 1) as u8; optrand[i] = (i + 2) as u8; }\n    for i in 0..2 * SPX_N { pk[i] = (i + 3) as u8; }\n    for i in 0..137 { msg[i] = (i * 3 + 1) as u8; }\n    gen_message_random(&mut R[..SPX_N], &skprf, &optrand, &msg, &ctx); ph(\"gmr\", &R[..SPX_N]);\n    let mut dg = [0u8; 128];\n    let mut tree: u64 = 0;\n    let mut leaf: u32 = 0;\n    hash_message(&mut dg[..SPX_FORS_MSG_BYTES], &mut tree, &mut leaf, &R, &pk, &msg, &ctx);\n    ph(\"dg\", &dg[..SPX_FORS_MSG_BYTES]);\n    println!(\"tree {} leaf {}\", tree, leaf);\n}\nEOF\ncd $R\nfor th in robust simple; do for sp in 128s 128f 192s 192f 256s 256f; do\ncargo build --quiet --no-default-features --features \"haraka,$th,$sp\" 2>&1 | head -20\n./target/debug/rdrv > $W/r_${th}_${sp}.out\nif diff -q $W/c_${th}_${sp}.out $W/r_${th}_${sp}.out >/dev/null; then echo \"$th $sp MATCH\"; else echo \"$th $sp MISMATCH\"; diff $W/c_${th}_${sp}.out $W/r_${th}_${sp}.out | head -6; fi\ndone; done","is_backgrounded":false,"task_type":"local_bash","uuid":"4db22375-6acc-440c-9ff6-a7d4915c3ccc","session_id":"eb87ec4e-54f9-48e5-a5c6-d85aefaf339c"}
