l = 1usize;\n        while ol <= 200 {\n            mo = [0u8; 200];\n            blake256_mgf1(&mut mo[..ol], &input[..48]);\n            print!(\"mgf256 {} \", ol); ph(&mo[..ol]);\n            mo = [0u8; 200];\n            blake512_mgf1(&mut mo[..ol], &input[..48]);\n            print!(\"mgf512 {} \", ol); ph(&mo[..ol]);\n            ol += 37;\n        }\n    }\n    {\n        let mut ctx = SpxCtx::new();\n        for i in 0..SPX_N { ctx.pub_seed[i] = (i + 3) as u8; ctx.sk_seed[i] = (i * 5 + 9) as u8; }\n        let mut addr = [0u32; 8];\n        for i in 0..8 { addr[i] = 0x01020300u32 + i as u32; }\n        let mut o = [0u8; 128];\n        spx::prf_addr(&mut o[..SPX_N], &ctx, &addr);\n        print!(\"prf \"); ph(&o[..SPX_N]);\n        for ib in 1u32..=4 {\n            o = [0u8; 128];\n            spx::thash(&mut o[..SPX_N], &input[..ib as usize * SPX_N], ib, &ctx, &mut addr);\n            print!(\"thash {} \", ib); ph(&o[..SPX_N]);\n        }\n        o = [0u8; 128];\n        spx::gen_message_random(&mut o, &input[..], &input[32..], &input[64..64+137], &ctx);\n        print!(\"gmr \"); ph(&o[..SPX_N]);\n        let mut dg = [0u8; 128];\n        let mut tree: u64 = 0; let mut leaf: u32 = 0;\n        spx::hash_message(&mut dg[..SPX_FORS_MSG_BYTES], &mut tree, &mut leaf,\n                          &input[..], &input[64..], &input[128..128+201], &ctx);\n        print!(\"hm \"); ph(&dg[..SPX_FORS_MSG_BYTES]);\n        println!(\"tree {} leaf {}\", tree, leaf);\n    }\n}\nEOF\nfor cfg in \"128s robust\" \"128s simple\" \"128f robust\" \"192s robust\" \"192s simple\" \"192f simple\" \"256s robust\" \"256f simple\"; do\n  set -- $cfg; SEC=$1; TH=$2\n  gcc -O2 -std=c99 -DPARAMS=sphincs-blake-$SEC -I$C/app/include -I$C/lib/blake/include \\\n     ctest.c $C/lib/blake/src/blake256.c $C/lib/blake/src/blake512.c $C/lib/blake/src/hash_blake.c \\\n     $C/lib/blake/src/thash_blake_$TH.c $C/app/src/utils.c $C/app/src/address.c -o ctest_x 2>&1 | grep -i error | head -5\n  ./ctest_x > c_out.txt\n  (cd $T && cargo build --release --no-default-features --features \"blake,$TH,$SEC\" 2>&1 | grep -E \"^error\" -A4 | head -20)\n  rustc --edition 2021 -O -C panic=abort -L $T/target/release/deps --extern sphincs_core_det=$T/target/release/libsphincs_core_det.rlib rtest.rs -o rtest_x 2>&1 | grep -E \"^error\" -A6 | head -30\n  ./rtest_x > r_out.txt\n  if diff -q c_out.txt r_out.txt >/dev/null; then echo \"MATCH $SEC $TH\"; else echo \"DIFF $SEC $TH:\"; diff c_out.txt r_out.txt | head -8; fi\ndone","is_backgrounded":false,"task_type":"local_bash","uuid":"d76d3c69-7ef3-45de-b122-7196f96c91b4","session_id":"eb87ec4e-54f9-48e5-a5c6-d85aefaf339c"}
