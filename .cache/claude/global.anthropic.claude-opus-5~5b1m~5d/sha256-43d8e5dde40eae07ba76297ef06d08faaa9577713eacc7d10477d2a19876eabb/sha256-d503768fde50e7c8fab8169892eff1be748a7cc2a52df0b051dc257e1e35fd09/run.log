e = \"128f\", not(any(feature = \"256f\", feature = \"256s\", feature = \"192f\", feature = \"192s\"))))]\n49\tmod secpar {\n50\t    pub const SPX_N: usize = 16;\n51\t    pub const SPX_FULL_HEIGHT: usize = 66;\n52\t    pub const SPX_D: usize = 22;\n53\t    pub const SPX_FORS_HEIGHT: usize = 6;\n54\t    pub const SPX_FORS_TREES: usize = 33;\n55\t    pub const SPX_BIG_HASH: u32 = 0;\n56\t}\n57\t\n58\t#[cfg(all(feature = \"128s\", not(any(feature = \"256f\", feature = \"256s\", feature = \"192f\", feature = \"192s\", feature = \"128f\"))))]\n59\tmod secpar {\n60\t    pub const SPX_N: usize = 16;\n61\t    pub const SPX_FULL_HEIGHT: usize = 63;\n62\t    pub const SPX_D: usize = 7;\n63\t    pub const SPX_FORS_HEIGHT: usize = 12;\n64\t    pub const SPX_FORS_TREES: usize = 14;\n65\t    pub const SPX_BIG_HASH: u32 = 0;\n66\t}\n67\t\n68\t// Fallback (no secpar feature selected): CMake default is 128s.\n69\t#[cfg(not(any(feature = \"256f\", feature = \"256s\", feature = \"192f\", feature = \"192s\", feature = \"128f\", feature = \"128s\")))]\n70\tmod secpar {\n71\t    pub const SPX_N: usize = 16;\n72\t    pub const SPX_FULL_HEIGHT: usize = 63;\n73\t    pub const SPX_D: usize = 7;\n74\t    pub const SPX_FORS_HEIGHT: usize = 12;\n75\t    pub const SPX_FORS_TREES: usize = 14;\n76\t    pub const SPX_BIG_HASH: u32 = 0;\n77\t}\n78\t\n79\tpub use secpar::{SPX_D, SPX_FORS_HEIGHT, SPX_FORS_TREES, SPX_FULL_HEIGHT, SPX_N};\n80\t\n81\t/// `SPX_SHA512` from the sha2 parameter sets (1 for 192/256, 0 for 128).\n82\tpub const SPX_SHA512: u32 = secpar::SPX_BIG_HASH;\n83\t/// `SPX_BLAKE512` from the blake parameter sets (1 for 192/256, 0 for 128).\n84\tpub const SPX_BLAKE512: u32 = secpar::SPX_BIG_HASH;\n85\t\n86\tpub const SPX_WOTS_W: usize = 16;\n87\t\n88\t/* For clarity */\n89\tpub const SPX_ADDR_BYTES: usize = 32;\n90\t\n91\t/* WOTS parameters. */\n92\tpub const SPX_WOTS_LOGW: usize = 4;\n93\tpub const SPX_WOTS_LEN1: usize = 8 * SPX_N / SPX_WOTS_LOGW;\n94\tpub const SPX_WOTS_LEN2: usize = if SPX_N <= 8 {\n95\t    2\n96\t} else if SPX_N <= 136 {\n97\t    3\n98\t} else {\n99\t    4\n100\t};\n101\tpub const SPX_WOTS_LEN: usize = SPX_WOTS_LEN1 + SPX_WOTS_LEN2;\n102\tpub const SPX_WOTS_BYTES: usize = SPX_WOTS_LEN * SPX_N;\n103\tpub const SPX_WOTS_PK_BYTES: usize = SPX_WOTS_BYTES;\n104\t\n105\t/* Subtree size. */\n106\tpub const SPX_TREE_HEIGHT: usize = SPX_FULL_HEIGHT / SPX_D;\n107\t\n108\t/* FORS parameters. */\n109\tpub const SPX_FORS_MSG_BYTES: usize = (SPX_FORS_HEIGHT * SPX_FORS_TREES + 7) / 8;\n110\tpub const SPX_FORS_BYTES: usize = (SPX_FORS_HEIGHT + 1) * SPX_FORS_TREES * SPX_N;\n111\tpub const SPX_FORS_PK_BYTES: usize = SPX_N;\n112\t\n113\t/* Resulting SPX sizes. */\n114\tpub const SPX_BYTES: usize =\n115\t    SPX_N + SPX_FORS_BYTES + SPX_D * SPX_WOTS_BYTES + SPX_FULL_HEIGHT * SPX_N;\n116\tpub const SPX_PK_BYTES: usize = 2 * SPX_N;\n117\tpub const SPX_SK_BYTES: usize = 2 * SPX_N + SPX_PK_BYTES;\n118\t\n119\t// ---------------------------------------------------------------------------\n120\t// api.h\n121\t// ---------------------------------------------------------------------------\n122\t\n123\tpub const CRYPTO_SECRETKEYBYTES: usize = SPX_SK_BYTES;\n124\tpub const CRYPTO_PUBLICKEYBYTES: usize = SPX_PK_BYTES;\n125\tpub const CRYPTO_BYTES: usize = SPX_BYTES;\n126\tpub const CRYPTO_SEEDBYTES: usize = 3 * SPX_N;\n127\tpub const CRYPTO_ALGNAME: &str = \"SPHINCS+\";\n128\t\n129\t// ---------------------------------------------------------------------------\n130\t// Address field offsets (backend specific)\n131\t// ---------------------------------------------------------------------------\n132\t\n133\t#[cfg(feature = \"sha2\")]\n134\tmod offsets {\n135\t    pub const SPX_OFFSET_LAYER: usize = 0;\n136\t    pub const SPX_OFFSET_TREE: usize = 1;\n137\t    pub const SPX_OFFSET_TYPE: usize = 9;\n138\t    pub const SPX_OFFSET_KP_ADDR: usize = 10;\n139\t    pub const SPX_OFFSET_CHAIN_ADDR: usize = 17;\n140\t    pub const SPX_OFFSET_HASH_ADDR: usize = 21;\n141\t    pub const SPX_OFFSET_TREE_HGT: usize = 17;\n142\t    pub const SPX_OFFSET_TREE_INDEX: usize = 18;\n143\t}\n144\t\n145\t#[cfg(not(feature = \"sha2\"))]\n146\tmod offsets {\n147\t    pub const SPX_OFFSET_LAYER: usize = 3;\n148\t    pub const SPX_OFFSET_TREE: usize = 8;\n149\t    pub const SPX_OFFSET_TYPE: usize = 19;\n150\t    pub const SPX_OFFSET_KP_ADDR: usize = 20;\n151\t    pub const SPX_OFFSET_CHAIN_ADDR: usize = 27;\n152\t    pub const SPX_OFFSET_HASH_ADDR: usize = 31;\n153\t    pub const SPX_OFFSET_TREE_HGT: usize = 27;\n154\t    pub const SPX_OFFSET_TREE_INDEX: usize = 28;\n155\t}\n156\t\n157\tpub use offsets::*;\n158\t"}]},"parent_tool_use_id":"toolu_bdrk_01Md16Gk5SF4vMao96umm6J2","session_id":"eb87ec4e-54f9-48e5-a5c6-d85aefaf339c","uuid":"074cc19b-9e23-4c57-abd5-7e92feffc5d2","timestamp":"2026-09-02T11:56:20.964Z","subagent_type":"general-purpose","task_description":"Translate wots, wotsx1, utilsx1"}
