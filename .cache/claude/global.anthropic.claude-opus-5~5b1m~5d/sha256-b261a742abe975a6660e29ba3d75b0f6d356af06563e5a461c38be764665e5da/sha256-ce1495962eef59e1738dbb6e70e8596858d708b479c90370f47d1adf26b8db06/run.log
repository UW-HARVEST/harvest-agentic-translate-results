t,\n52\t    lo: c_int,\n53\t    split: c_int,\n54\t    hi: c_int,\n55\t    b: *mut spritebatch_sprite_t,\n56\t) {\n57\t    let mut i: c_int = lo;\n58\t    let mut j: c_int = split;\n59\t    let mut k: c_int = lo;\n60\t    while k < hi {\n61\t        if i < split\n62\t            && (j >= hi\n63\t                || spritebatch_internal_sprite_less_than_or_equal(\n64\t                    a.offset(i as isize),\n65\t                    a.offset(j as isize),\n66\t                ) != 0)\n67\t        {\n68\t            *b.offset(k as isize) = *a.offset(i as isize);\n69\t            i = i.wrapping_add(1);\n70\t        } else {\n71\t            *b.offset(k as isize) = *a.offset(j as isize);\n72\t            j = j.wrapping_add(1);\n73\t        }\n74\t        k = k.wrapping_add(1);\n75\t    }\n76\t}\n77\t\n78\t/// ```c\n79\t/// static void spritebatch_internal_merge_sort_recurse(\n80\t///     spritebatch_sprite_t *b, int lo, int hi, spritebatch_sprite_t *a);\n81\t/// ```\n82\t///\n83\t/// Note the deliberate swap of the buffer arguments in the recursive calls,\n84\t/// exactly as in the C source.\n85\tunsafe fn spritebatch_internal_merge_sort_recurse(\n86\t    b: *mut spritebatch_sprite_t,\n87\t    lo: c_int,\n88\t    hi: c_int,\n89\t    a: *mut spritebatch_sprite_t,\n90\t) {\n91\t    if hi.wrapping_sub(lo) <= 1 {\n92\t        return;\n93\t    }\n94\t    let split: c_int = lo.wrapping_add(hi) / 2;\n95\t    spritebatch_internal_merge_sort_recurse(a, lo, split, b);\n96\t    spritebatch_internal_merge_sort_recurse(a, split, hi, b);\n97\t    spritebatch_internal_merge_sort_iteration(b, lo, split, hi, a);\n98\t}\n99\t\n100\t/// ```c\n101\t/// void merge_sort(spritebatch_sprite_t *a, spritebatch_sprite_t *b, int size);\n102\t/// ```\n103\t#[unsafe(no_mangle)]\n104\tpub unsafe extern \"C\" fn merge_sort(\n105\t    a: *mut spritebatch_sprite_t,\n106\t    b: *mut spritebatch_sprite_t,\n107\t    size: c_int,\n108\t) {\n109\t    // memcpy(b, a, sizeof(spritebatch_sprite_t) * size);\n110\t    //\n111\t    // The C code converts `size` (int) to size_t before multiplying, so a\n112\t    // negative size becomes an enormous byte count; the wrapping arithmetic\n113\t    // below reproduces that computation bit for bit.\n114\t    let bytes: usize = core::mem::size_of::<spritebatch_sprite_t>()\n115\t        .wrapping_mul(size as isize as usize);\n116\t    if bytes != 0 {\n117\t        std::ptr::copy_nonoverlapping(a as *const u8, b as *mut u8, bytes);\n118\t    }\n119\t    spritebatch_internal_merge_sort_recurse(b, 0, size, a);\n120\t}\n121\t"}]},"parent_tool_use_id":null,"session_id":"1fde8561-ba9e-456f-aab5-e839e9993055","uuid":"a0169180-07fa-4433-b4cb-9358fc12e806","timestamp":"2026-08-26T23:51:22.972Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-5x6dJI/translation/src/lib.rs","content":"//! Rust translation of the C library in `c_src/`.\n//!\n//! The C library consists of a single translation unit (`src/lib.c`) exposing a\n//! single public symbol, `merge_sort`, plus three `static` (internal) helpers.\n//! Behaviour — including the quirky comparison predicate, which the C code gets\n//! \"wrong\" (the second `if` is unreachable in practice because the first `if`\n//! already covers `a->sort_bits == b->sort_bits`) — is reproduced exactly.\n\n#![allow(non_camel_case_types)]\n\nuse std::ffi::{c_int, c_ulonglong};\n\n/// ```c\n/// typedef struct spritebatch_sprite_t {\n///     unsigned long long texture_id;\n///     int sort_bits;\n/// } spritebatch_sprite_t;\n/// ```\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct spritebatch_sprite_t {\n    pub texture_id: c_ulonglong,\n    pub sort_bits: c_int,\n}\n\n/// ```c\n/// static int spritebatch_internal_sprite_less_than_or_equal(\n///     spritebatch_sprite_t *a, spritebatch_sprite_t *b);\n/// ```\n///\n/// Kept verbatim: the redundant second test is preserved even though the first\n/// test subsumes it.\nunsafe fn spritebatch_internal_sprite_less_than_