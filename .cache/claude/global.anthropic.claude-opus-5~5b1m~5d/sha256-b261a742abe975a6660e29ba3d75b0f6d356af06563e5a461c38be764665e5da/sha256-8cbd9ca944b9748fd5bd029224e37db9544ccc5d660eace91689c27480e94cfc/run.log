    let mut br = SharedArena::new(bytes);\n    ac.copy_from(&a_seed);\n    ar.copy_from(&a_seed);\n    bc.copy_from(&b_seed);\n    br.copy_from(&b_seed);\n\n    let cf = c_merge_sort();\n    let rf = rust_merge_sort();\n    let (pac, pbc) = (ac.sprites(), bc.sprites());\n    let (par, pbr) = (ar.sprites(), br.sprites());\n\n    let c_out = run_in_child(move || unsafe { cf(pac, pbc, size) });\n    let r_out = run_in_child(move || unsafe { rf(par, pbr, size) });\n\n    assert_eq!(\n        c_out, r_out,\n        \"{label}: termination differs (C={c_out:?}, Rust={r_out:?})\"\n    );\n    assert_shared_eq(label, \"a\", &ac, &ar);\n    assert_shared_eq(label, \"b\", &bc, &br);\n}\n\n#[track_caller]\nfn assert_shared_eq(label: &str, which: &str, c: &SharedArena, r: &SharedArena) {\n    let (cb, rb) = (c.bytes(), r.bytes());\n    if cb != rb {\n        let first = cb.iter().zip(rb).position(|(x, y)| x != y).unwrap();\n        panic!(\n            \"{label}: shared arena `{which}` diverges at byte {first} \\\n             (element {}, offset {})\\nC   : {:02x?}\\nRust: {:02x?}\",\n            first / ELEM_SIZE,\n            first % ELEM_SIZE,\n            &cb[first..(first + 16).min(cb.len())],\n            &rb[first..(first + 16).min(rb.len())],\n        );\n    }\n}\n","numLines":66,"startLine":375,"totalLines":440}}}
