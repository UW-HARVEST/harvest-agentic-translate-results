t,\n52\t    lo: c_int,\n53\t    split: c_int,\n54\t    hi: c_int,\n55\t    b: *mut spritebatch_sprite_t,\n56\t) {\n57\t    let mut i: c_int = lo;\n58\t    let mut j: c_int = split;\n59\t    let mut k: c_int = lo;\n60\t    while k < hi {\n61\t        if i < split\n62\t            && (j >= hi\n63\t                || spritebatch_internal_sprite_less_than_or_equal(\n64\t                    a.offset(i as isize),\n65\t                    a.offset(j as isize),\n66\t                ) != 0)\n67\t        {\n68\t            *b.offset(k as isize) = *a.offset(i as isize);\n69\t            i = i.wrapping_add(1);\n70\t        } else {\n71\t            *b.offset(k as isize) = *a.offset(j as isize);\n72\t            j = j.wrapping_add(1);\n73\t        }\n74\t        k = k.wrapping_add(1);\n75\t    }\n76\t}\n77\t\n78\t/// ```c\n79\t/// static void spritebatch_internal_merge_sort_recurse(\n80\t///     spritebatch_sprite_t *b, int lo, int hi, spritebatch_sprite_t *a);\n81\t/// ```\n82\t///\n83\t/// Note the deliberate swap of the buffer arguments in the recursive calls,\n84\t/// exactly as in the C source.\n85\tunsafe fn spritebatch_internal_merge_sort_recurse(\n86\t    b: *mut spritebatch_sprite_t,\n87\t    lo: c_int,\n88\t    hi: c_int,\n89\t    a: *mut spritebatch_sprite_t,\n90\t) {\n91\t    if hi.wrapping_sub(lo) <= 1 {\n92\t        return;\n93\t    }\n94\t    let split: c_int = lo.wrapping_add(hi) / 2;\n95\t    spritebatch_internal_merge_sort_recurse(a, lo, split, b);\n96\t    spritebatch_internal_merge_sort_recurse(a, split, hi, b);\n97\t    spritebatch_internal_merge_sort_iteration(b, lo, split, hi, a);\n98\t}\n99\t\n100\t/// ```c\n101\t/// void merge_sort(spritebatch_sprite_t *a, spritebatch_sprite_t *b, int size);\n102\t/// ```\n103\t#[unsafe(no_mangle)]\n104\tpub unsafe extern \"C\" fn merge_sort(\n105\t    a: *mut spritebatch_sprite_t,\n106\t    b: *mut spritebatch_sprite_t,\n107\t    size: c_int,\n108\t) {\n109\t    // memcpy(b, a, sizeof(spritebatch_sprite_t) * size);\n110