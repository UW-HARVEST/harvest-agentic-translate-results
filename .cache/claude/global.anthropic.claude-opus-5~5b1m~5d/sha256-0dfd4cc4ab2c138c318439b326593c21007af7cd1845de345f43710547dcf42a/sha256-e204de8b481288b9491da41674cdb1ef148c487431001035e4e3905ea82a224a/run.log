);\n   204\t    let rc_b = run_engine(1, &code.data, &mut vm_b);\n   205\t    let rc_e = run_engine(2, &code.data, &mut vm_e);\n   206\t\n   207\t    {\n   208\t        let stdout = std::io::stdout();\n   209\t        let mut out = std::io::BufWriter::new(stdout.lock());\n   210\t        let _ = write!(out, \"RC:A={} B={} EXT={}\\n\", rc_a, rc_b, rc_e);\n   211\t        vm_print(&mut out, \"A:\", &vm_a);\n   212\t        vm_print(&mut out, \"B:\", &vm_b);\n   213\t        vm_print(&mut out, \"EXT:\", &vm_e);\n   214\t        let _ = out.flush();\n   215\t    }\n   216\t\n   217\t    vm_a.free();\n   218\t    vm_b.free();\n   219\t    vm_e.free();\n   220\t    code.free();\n   221\t    std::process::exit(0);\n   222\t}\n===== src/engine.rs =====\n     1\t// Translation of c_src/src/engine.c\n     2\t//\n     3\t// Copyright 2025 MIT Lincoln Laboratory  (see c_src for the full license text)\n     4\t\n     5\tuse crate::impl_a::{call_a_once, process_a_stream};\n     6\tuse crate::impl_b::{call_b_once, process_b_stream};\n     7\tuse crate::lib_target::target;\n     8\tuse crate::util::{Program, Vm};\n     9\t\n    10\t/// `static int classify(int impl, int x)`\n    11\t///\n    12\t/// `inline_call(f, x)` is `f(x)` and `MAC_CALL(F,X)` is `F(X+1)`.\n    13\tfn classify(imp: i32, x: i32) -> i32 {\n    14\t    if imp == 0 {\n    15\t        // inline_call(call_a_once, x)\n    16\t        return call_a_once(x);\n    17\t    }\n    18\t    if imp == 1 {\n    19\t        // MAC_CALL(call_b_once, x) == call_b_once(x + 1)\n    20\t        return call_b_once(x.wrapping_add(1));\n    21\t    }\n    22\t    // inline_call(&target, MAC_CALL(target, x)) == target(target(x + 1))\n    23\t    target(target(x.wrapping_add(1)))\n    24\t}\n    25\t\n    26\t/// `static int process_stream(int impl, const int *buf, size_t n)`\n    27\tfn process_stream(imp: i32, buf: &[i32]) -> i32 {\n    28\t    if imp == 0 {\n    29\t        return process_a_stream(buf);\n    30\t    }\n    31\t    if