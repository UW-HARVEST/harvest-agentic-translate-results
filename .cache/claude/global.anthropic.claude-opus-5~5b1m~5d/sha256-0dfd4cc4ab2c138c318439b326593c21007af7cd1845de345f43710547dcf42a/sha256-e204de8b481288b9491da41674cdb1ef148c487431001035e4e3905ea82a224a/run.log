   141\t\n   142\t/// `vm_print`\n   143\tpub fn vm_print<W: Write>(fp: &mut W, label: &str, vm: &Vm) {\n   144\t    let _ = write!(\n   145\t        fp,\n   146\t        \"{}STACK_TOP={} STEPS={} TRACE=\",\n   147\t        label,\n   148\t        vm.stack.peek(-777),\n   149\t        vm.steps\n   150\t    );\n   151\t    for i in 0..vm.trace.len() {\n   152\t        // NOTE: the C code masks with 25 (bitwise AND), not modulo 26.\n   153\t        let idx = (vm.trace.data[i] & 25) as usize;\n   154\t        let _ = fp.write_all(&[ALPHABET[idx]]);\n   155\t    }\n   156\t    let _ = fp.write_all(b\"\\n\");\n   157\t}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
