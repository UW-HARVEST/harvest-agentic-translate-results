 vm.trace(7),\n   100\t                    // `case 3:;` falls through to `case 4:`\n   101\t                    3 | 4 => vm.trace(8),\n   102\t                    _ => vm.trace(9),\n   103\t                }\n   104\t            }\n   105\t            6 => {\n   106\t                let mut k: i32 = 0;\n   107\t                if !p.fetch(&mut k) {\n   108\t                    return 5;\n   109\t                }\n   110\t                let mut cond: i32 = 0;\n   111\t                if !vm.stack.pop_into(&mut cond) {\n   112\t                    return 6;\n   113\t                }\n   114\t                if cond != 0 {\n   115\t                    // (size_t)k sign-extends, so a negative k becomes huge and\n   116\t                    // always trips this check.\n   117\t                    if (k as usize) > p.n - p.ip {\n   118\t                        return 7;\n   119\t                    }\n   120\t                    p.ip += k as usize;\n   121\t                    vm.trace(10);\n   122\t                } else {\n   123\t                    vm.trace(11);\n   124\t                }\n   125\t            }\n   126\t            7 => {\n   127\t                let mut times: i32 = 0;\n   128\t                if !p.fetch(&mut times) {\n   129\t                    return 8;\n   130\t                }\n   131\t                if p.ip >= p.n {\n   132\t                    return 9;\n   133\t                }\n   134\t                let saved_ip = p.ip;\n   135\t                let mut i: i32 = 0;\n   136\t                while i < times {\n   137\t                    // `Program inner = p; inner.ip = saved_ip;` then\n   138\t                    // run_engine(impl_id, inner.code + inner.ip, 1, vm)\n   139\t                    let rc = run_engine(impl_id, &p.code[saved_ip..saved_ip + 1], vm);\n   140\t                    if rc != 0 {\n   141\t                        // (the C code assigns p.ip = saved_ip + 1 here too)\n   142\t                        p.ip = saved_ip