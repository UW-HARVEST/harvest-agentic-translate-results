    }\n    80\t    }\n    81\t    acc\n    82\t}\n===== src/lib_target.rs =====\n     1\t// Translation of c_src/src/lib.c (the externally visible `target`, declared in\n     2\t// include/api.h).  Note that a.c and b.c each define their *own* `static int\n     3\t// target`, which shadow this one only inside those translation units; engine.c\n     4\t// sees this global one.\n     5\t//\n     6\t// Copyright 2025 MIT Lincoln Laboratory  (see c_src for the full license text)\n     7\t\n     8\t/// `int target(int code)` from lib.c\n     9\tpub fn target(code: i32) -> i32 {\n    10\t    if code < 0 {\n    11\t        return 7;\n    12\t    }\n    13\t    let m = code % 10;\n    14\t    if m == 0 {\n    15\t        return 0;\n    16\t    }\n    17\t    if m <= 3 {\n    18\t        return 1;\n    19\t    }\n    20\t    if m <= 6 {\n    21\t        return 2;\n    22\t    }\n    23\t    if m == 7 {\n    24\t        return 3;\n    25\t    }\n    26\t    4\n    27\t}\n===== src/util.rs =====\n     1\t// Translation of c_src/src/util.c + c_src/include/util.h\n     2\t//\n     3\t// Copyright 2025 MIT Lincoln Laboratory\n     4\t// Permission is hereby granted, free of charge,\n     5\t// to any person obtaining a copy of this software\n     6\t// and associated documentation files (the \"Software\"),\n     7\t// to deal in the Software without restriction,\n     8\t// including without limitation the rights to use, copy,\n     9\t// modify, merge, publish, distribute, sublicense,\n    10\t// and/or sell copies of the Software,\n    11\t// and to permit persons to whom the Software is furnished to do so,\n    12\t// subject to the following conditions:\n    13\t//\n    14\t// The above copyright notice and this permission notice\n    15\t// shall be included in all copies or substantial portions of the Software.\n    16\t//\n    17\t// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    18\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    19\t// THE WARRANTIES OF MERCHANTABILITY,\n    20\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    21\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    22\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    23\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    24\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    25\t\n    26\tuse std::io::Write;\n    27\t\n    28\t/// `IntVec` from util.h.  The C version is a manually grown `int *` buffer;\n    29\t/// a `Vec<i32>` reproduces every observable behaviour (allocation failure\n    30\t/// paths in the C code are unreachable for these input sizes).\n    31\t#[derive(Default)]\n    32\tpub struct IntVec {\n    33\t    pub data: Vec<i32>,\n    34\t}\n    35\t\n    36\timpl IntVec {\n    37\t    /// `iv_init`\n    38\t    pub fn new() -> IntVec {\n    39\t        IntVec { data: Vec::new() }\n    40\t    }\n    41\t\n    42\t    /// `iv_free`\n    43\t    pub fn free(&mut self) {\n    44\t        self.data.clear();\n    45\t        self.data.shrink_to_fit();\n    46\t    }\n    47\t\n    48\t    /// `iv_push` (the C function returns false only on allocation failure)\n    49\t    pub fn push(&mut self, x: i32) -> bool {\n    50\t        self.data.push(x);\n    51\t        true\n    52\t    }\n    53\t\n    54\t    /// `iv_pop`: on an empty vector it returns false and leaves `*out`\n    55\t    /// untouched, which the callers in engine.c actually depend on.\n    56\t    pub fn pop_into(&mut self, out: &mut i32) -> bool {\n    57\t        match self.data.pop() {\n    58\t            Some(v) => {\n    59\t                *out = v;\n    60\t                true\n    61\t            }\n    62\t            None => false,\n    63\t        }\n    64\t    }\n    65\t\n    66\t    /// `iv_pop` with a NULL `out`\n    67\t    pub fn pop(&mut self) -> Option<i32> {\n    68\t        self.data.pop()\n    69\t    }\n    70\t\n    71\t    /// `iv