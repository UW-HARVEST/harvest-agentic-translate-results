ad_local! {\n     8\t    /// `static int state_a;` (zero initialised, persists between calls)\n     9\t    static STATE_A: Cell<i32> = const { Cell::new(0) };\n    10\t}\n    11\t\n    12\t/// `static inline int a_bias_call(int (*fp)(int), int x)`\n    13\tfn a_bias_call(fp: fn(i32) -> i32, x: i32) -> i32 {\n    14\t    fp((x ^ 0x55).wrapping_add(7))\n    15\t}\n    16\t\n    17\t/// `static int target(int code)` local to a.c\n    18\tfn target(code: i32) -> i32 {\n    19\t    if code < 0 {\n    20\t        return if (STATE_A.get() & 1) != 0 { 6 } else { 5 };\n    21\t    }\n    22\t    // state_a = state_a ^ (code<<1);\n    23\t    let new_state = STATE_A.get() ^ (((code as u32) << 1) as i32);\n    24\t    STATE_A.set(new_state);\n    25\t    let k = ((code >> 2) ^ new_state) & 7;\n    26\t    match k {\n    27\t        0 => 0,\n    28\t        1 => 2,\n    29\t        2 => 4,\n    30\t        3 => 1,\n    31\t        4 => 3,\n    32\t        // `case 5:;` falls through to `case 6:`\n    33\t        5 | 6 => 5,\n    34\t        _ => 7,\n    35\t    }\n    36\t}\n    37\t\n    38\t/// `static inline int wrap(int x){ return target(x-5); }`\n    39\tfn wrap(x: i32) -> i32 {\n    40\t    target(x.wrapping_sub(5))\n    41\t}\n    42\t\n    43\t/// `int call_a_once(int x)`\n    44\tpub fn call_a_once(x: i32) -> i32 {\n    45\t    let fp: fn(i32) -> i32 = target;\n    46\t    let a = fp(x);\n    47\t    let b = wrap(a);\n    48\t    let c = target(b ^ 3);\n    49\t    // A_MAC_CALL(&target, b) == a_bias_call(&target, b)\n    50\t    let d = a_bias_call(target, b);\n    51\t    a ^ (b << 1) ^ (c << 2) ^ (d << 3)\n    52\t}\n    53\t\n    54\t/// `int process_a_stream(const int *xs, size_t n)`\n    55\t///\n    56\t/// `acc` is a `size_t` (64-bit unsigned) in the C source.  The two clamps at\n    57\t/// the end compare it against `long long` constants; the usual arithmetic\n    58\t/// conversions turn those into *unsigned* 64-bit values, so `-0x80000000LL`\n    59\t/// becomes 0xFFFFFFFF80000000 and the second clamp always fires.  The function\n    60\t/// therefore always returns INT_MIN.  This is faithfully reproduced here\n    61\t/// (including all of `target`'s side effects on `state_a`).\n    62\tpub fn process_a_stream(xs: &[i32]) -> i32 {\n    63\t    let mut acc: u64 = 0;\n    64\t    for &v in xs.iter() {\n    65\t        for j in 0..3i32 {\n    66\t            let t = target(v.wrapping_add(j));\n    67\t            if (t & 1) == 0 {\n    68\t                // acc += t;  (int -> size_t conversion sign-extends)\n    69\t                acc = acc.wrapping_add(t as i64 as u64);\n    70\t                continue;\n    71\t            }\n    72\t            acc ^= (t << j) as i64 as u64;\n    73\t            if t == 5 {\n    74\t                break;\n    75\t            }\n    76\t        }\n    77\t    }\n    78\t    // if (acc > 0x7fffffffLL) acc = 0x7fffffffLL;\n    79\t    if acc > 0x7fffffff_u64 {\n    80\t        acc = 0x7fffffff_u64;\n    81\t    }\n    82\t    // if (acc < -0x80000000LL) acc = -0x80000000LL;\n    83\t    const NEG_TWO31: u64 = (-0x80000000_i64) as u64;\n    84\t    if acc < NEG_TWO31 {\n    85\t        acc = NEG_TWO31;\n    86\t    }\n    87\t    // return (int)acc;\n    88\t    acc as u32 as i32\n    89\t}\n===== src/impl_b.rs =====\n     1\t// Translation of c_src/src/b.c\n     2\t//\n     3\t// Copyright 2025 MIT Lincoln Laboratory  (see c_src for the full license text)\n     4\t\n     5\tuse std::cell::Cell;\n     6\t\n     7\tthread_local! {\n     8\t    /// `static int flipflop;` (zero initialised, persists between calls)\n     9\t    static FLIPFLOP: Cell<i32> = const { Cell::new(0) };\n    10\t}\n    11\t\n    12\t/// `static inline int b_twist_call(int (*fp)(int), int x)`\n    13\tfn b_twist_call(fp: fn(i32) -> i32, x: i32) -> i32 {\n    14\t    fp(((x.wrapping_add(9)) ^ 0x2222).wrapping_sub(17))\n    15\t}\n    16\t\n    17\t/// `static int target(int code)` local to b.c\n    18\tfn target(