49\t    parent_id: 0,\n50\t    left_child_id: 0,\n51\t    right_child_id: 0,\n52\t    label: [0; 32],\n53\t};\n54\t\n55\t// `TreeNode node_table[MAX_NODES];` and `int node_count = 0;` are non-static\n56\t// definitions in the C translation unit, so they are part of the exported ABI.\n57\t#[unsafe(no_mangle)]\n58\tpub static mut node_table: [TreeNode; MAX_NODES] = [EMPTY_NODE; MAX_NODES];\n59\t\n60\t#[unsafe(no_mangle)]\n61\tpub static mut node_count: c_int = 0;\n62\t\n63\t#[inline]\n64\tfn table_ptr() -> *mut TreeNode {\n65\t    ptr::addr_of_mut!(node_table) as *mut TreeNode\n66\t}\n67\t\n68\t// ---------------------------------------------------------------------------\n69\t// libc helpers, replicated so that byte-level behaviour matches exactly.\n70\t// ---------------------------------------------------------------------------\n71\t\n72\t/// `strchr(s, c)` — the terminating NUL is part of the searched string.\n73\tunsafe fn c_strchr(s: *const c_char, c: c_int) -> *const c_char {\n74\t    let needle = c as u8 as c_char;\n75\t    let mut p = s;\n76\t    loop {\n77\t        let cur = *p;\n78\t        if cur == needle {\n79\t            return p;\n80\t        }\n81\t        if cur == 0 {\n82\t            return ptr::null();\n83\t        }\n84\t        p = p.add(1);\n85\t    }\n86\t}\n87\t\n88\t/// `strncpy(dst, src, n)` — copies at most `n` bytes, stops reading after the\n89\t/// source NUL, and NUL-pads the remainder of the destination.\n90\tunsafe fn c_strncpy(dst: *mut c_char, src: *const c_char, n: usize) {\n91\t    let mut i = 0usize;\n92\t    while i < n {\n93\t        let ch = *src.add(i);\n94\t        *dst.add(i) = ch;\n95\t        if ch == 0 {\n96\t            break;\n97\t        }\n98\t        i += 1;\n99\t    }\n100\t    while i < n {\n101\t        *dst.add(i) = 0;\n102\t        i += 1;\n103\t    }\n104\t}\n105\t\n106\t// ---------------------------------------------------------------------------\n107\t// Operation implementations\n108\t// ---------------------------------------------------------------------------\n109\t\n110\tpub type OperationFunc = extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int;\n111\t\n112\t#[unsafe(no_mangle)]\n113\tpub extern \"C\" fn add_op(a: c_int, b: c_int, _unused1: c_int, _unused2: c_int) -> c_int {\n114\t    a.wrapping_add(b)\n115\t}\n116\t\n117\t#[unsafe(no_mangle)]\n118\tpub extern \"C\" fn multiply_op(a: c_int, b: c_int, _unused1: c_int, _unused2: c_int) -> c_int {\n119\t    a.wrapping_mul(b)\n120\t}\n121\t\n122\t#[unsafe(no_mangle)]\n123\tpub extern \"C\" fn subtract_op(a: c_int, b: c_int, _unused1: c_int, _unused2: c_int) -> c_int {\n124\t    a.wrapping_sub(b)\n125\t}\n126\t\n127\t#[unsafe(no_mangle)]\n128\tpub extern \"C\" fn divide_op(a: c_int, b: c_int, _unused1: c_int, _unused2: c_int) -> c_int {\n129\t    if b == 0 {\n130\t        return 0;\n131\t    }\n132\t    a.wrapping_div(b)\n133\t}\n134\t\n135\t#[unsafe(no_mangle)]\n136\tpub extern \"C\" fn modulo_op(a: c_int, b: c_int, _unused1: c_int, _unused2: c_int) -> c_int {\n137\t    if b == 0 {\n138\t        return 0;\n139\t    }\n140\t    a.wrapping_rem(b)\n141\t}\n142\t\n143\t// ---------------------------------------------------------------------------\n144\t// Tree handling\n145\t// ---------------------------------------------------------------------------\n146\t\n147\t#[unsafe(no_mangle)]\n148\tpub extern \"C\" fn find_node_by_id(id: c_int) -> *mut TreeNode {\n149\t    unsafe {\n150\t        let table = table_ptr();\n151\t        let count = node_count;\n152\t        let mut i: c_int = 0;\n153\t        while i < count {\n154\t            let node = table.offset(i as isize);\n155\t            if (*node).id == id {\n156\t                return node;\n157\t            }\n158\t            i += 1;\n159\t        }\n160\t        ptr::null_mut()\n161\t    }\n162\t}\n163\t\n164\t#[unsafe(no_mangle)]\n165\tpub extern \"C\" fn add_tree_node(\n166\t    id: c_int,\n167\t    value: c_int,\n168\t    parent_id: c_int,\n169\t    label: