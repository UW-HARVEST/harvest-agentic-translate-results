 & 0x1ff`.\n///\n/// Mirrors `static uint8_t m__shift[512]` in the C source.\nstatic M_SHIFT: [u8; 512] = [\n{shift}\n];\n\n/// Convert a `float` to the bit pattern of its half-precision representation.\n///\n/// Direct translation of:\n///\n/// ```c\n/// uint16_t float2half(float flt) {{\n///     union {{ float flt; uint32_t num; }} in;\n///     uint32_t n, j;\n///     in.flt = flt;\n///     n = in.num;\n///     j = (n >> 23) & 0x1ff;\n///     return (uint16_t)((uint32_t)m__base[j] + ((n & 0x007fffff) >> m__shift[j]));\n/// }}\n/// ```\n///\n/// # Safety\n///\n/// This function takes no pointers and performs no unsafe operations; it is\n/// `unsafe` only because it is exported with the C ABI.\n#[unsafe(no_mangle)]\npub extern \"C\" fn float2half(flt: f32) -> u16 {{\n    // Equivalent to the C union type-pun: reinterpret the float's bits.\n    let n: u32 = f32::to_bits(flt);\n\n    // Index is masked to 9 bits, so it is always within 0..512.\n    let j: u32 = (n >> 23) & 0x1ff;\n    let j = j as usize;\n\n    let base = M_BASE[j] as u32;\n    let shift = M_SHIFT[j] as u32;\n\n    // Every table entry is < 32, so the shift never exceeds u32's width.\n    let mantissa = (n & 0x007f_ffff) >> shift;\n\n    // C computes the sum in `uint32_t` and then truncates to `uint16_t`.\n    base.wrapping_add(mantissa) as u16\n}}\n'''.format(base=fmt(base, 4, 9), shift=fmt(shift, 2, 12))\n\nopen('translation/src/lib.rs','w').write(out)\nprint(\"wrote\", len(out), \"bytes; base[104..112]=\", [hex(x) for x in base[104:112]], \"shift[100:110]=\", [hex(x) for x in shift[100:110]])\nEOF","description":"Generate lib.rs with extracted tables"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":401,"cache_read_input_tokens":21681,"cache_creation":{"ephemeral_5m_input_tokens":401,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"026b