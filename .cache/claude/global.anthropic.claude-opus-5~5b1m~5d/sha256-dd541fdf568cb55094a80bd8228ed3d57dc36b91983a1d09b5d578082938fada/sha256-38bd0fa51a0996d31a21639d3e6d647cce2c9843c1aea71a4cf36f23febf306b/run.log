 = 0; k < sizeof(sv)/sizeof(sv[0]); k++)\n            printf(\"  find(%d) = %d\\n\", sv[k], find_value_in_buffer(buf, 256, sv[k]));\n        /* zero size */\n        printf(\"  find size0(42) = %d\\n\", find_value_in_buffer(buf, 0, 42));\n    }\n    /* partial buffer fill: size smaller/other */\n    {\n        char b2[64];\n        memset(b2, 0x7f, 64);\n        create_numeric_buffer(b2, 10, 250);\n        printf(\"partial:\");\n        for (int i = 0; i < 16; i++) printf(\" %d\", (int)b2[i]);\n        printf(\"\\n\");\n        create_numeric_buffer(b2, 0, 5);\n        create_numeric_buffer(b2, -5, 5);\n        printf(\"zero/neg size ok\\n\");\n    }\n\n    /* --- calculate_with_doubles --- */\n    int av[] = {0, 1, -1, 7, -7, 100, -100, 2147483647, -2147483648, 3, 999999};\n    int bv[] = {0, 1, -1, 2, -2, 3, 7, 10, 256, -256, 2147483647};\n    int cv[] = {0, 1, -1, 5, -5, 9, -9, 10, -10, 11, -11, 19, -19, 100, -100,\n                2147483647, -2147483648};\n    for (unsigned i = 0; i < sizeof(av)/sizeof(av[0]); i++)\n      for (unsigned j = 0; j < sizeof(bv)/sizeof(bv[0]); j++)\n        for (unsigned k = 0; k < sizeof(cv)/sizeof(cv[0]); k++) {\n            double r = calculate_with_doubles(av[i], bv[j], cv[k]);\n            printf(\"calc(%d,%d,%d) = %.17g | %e | %d\\n\", av[i], bv[j], cv[k],\n                   r, r, convert_double_to_int(r));\n        }\n\n    /* --- doubleneg: the big one --- */\n    int q[][4] = {\n        {0,0,0,0}, {1,1,1,1}, {1,2,3,4}, {-1,-2,-3,-4}, {42,7,3,100},\n        {100,0,5,9}, {0,1,2,3}, {255,256,257,258}, {-255,-256,-257,-258},\n        {2147483647,2147483647,2147483647,2147483647},\n        {-2147483648,-2147483648,-2147483648,-2147483648},\n        {1,0,0,0}, {0,0,0,1}, {123,456,789,1011}, {-123,-456,-789,-1011},\n        {7,-3,11,-19}, {1000000,3,-7,42}, {5,10,-10,0}, {93,17,19,23},\n        {-1,1,-1,1}, {256,512,1024,2048}, {6,-2147483648,9,-9},\n        {2147483647,-1,-2147483648,1}, {50,50,50,50}, {100,100,100,100},\n    };