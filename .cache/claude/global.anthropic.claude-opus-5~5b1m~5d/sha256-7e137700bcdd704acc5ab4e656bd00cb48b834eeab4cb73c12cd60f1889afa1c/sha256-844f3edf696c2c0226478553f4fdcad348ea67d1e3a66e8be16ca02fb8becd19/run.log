{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Sc1eUpqyK3BaYPXQTTfRBw","type":"tool_result","content":"=== translation/src/lib.rs\n     1\t// Copyright 2025 MIT Lincoln Laboratory\n     2\t// Permission is hereby granted, free of charge,\n     3\t// to any person obtaining a copy of this software\n     4\t// and associated documentation files (the \"Software\"),\n     5\t// to deal in the Software without restriction,\n     6\t// including without limitation the rights to use, copy,\n     7\t// modify, merge, publish, distribute, sublicense,\n     8\t// and/or sell copies of the Software,\n     9\t// and to permit persons to whom the Software is furnished to do so,\n    10\t// subject to the following conditions:\n    11\t//\n    12\t// The above copyright notice and this permission notice\n    13\t// shall be included in all copies or substantial portions of the Software.\n    14\t//\n    15\t// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    16\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    17\t// THE WARRANTIES OF MERCHANTABILITY,\n    18\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    19\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    20\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    21\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    22\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    23\t\n    24\t//! Shared-library crate for the `driver` translation.\n    25\t//!\n    26\t//! This mirrors the C shared objects built from `mdcore.c` (with `mdmacros.h`\n    27\t//! providing the build-time-configurable operation family and iteration count).\n    28\t//! The public `extern \"C\"` functions keep their original linker symbol names\n    29\t//! (there are no namespace-renaming macros in the C sources) and are exported\n    30\t//! from the `cdylib`.\n    31\t\n    32\tpub mod mdcore;\n    33\tpub mod mdmacros;\n=== translation/src/main.rs\n     1\t// Copyright 2025 MIT Lincoln Laboratory\n     2\t// Permission is hereby granted, free of charge,\n     3\t// to any person obtaining a copy of this software\n     4\t// and associated documentation files (the \"Software\"),\n     5\t// to deal in the Software without restriction,\n     6\t// including without limitation the rights to use, copy,\n     7\t// modify, merge, publish, distribute, sublicense,\n     8\t// and/or sell copies of the Software,\n     9\t// and to permit persons to whom the Software is furnished to do so,\n    10\t// subject to the following conditions:\n    11\t//\n    12\t// The above copyright notice and this permission notice\n    13\t// shall be included in all copies or substantial portions of the Software.\n    14\t//\n    15\t// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    16\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    17\t// THE WARRANTIES OF MERCHANTABILITY,\n    18\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    19\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    20\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    21\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    22\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    23\t\n    24\t//! Rust equivalent of `mdmain.c` (the `driver` binary entry point).\n    25\t//!\n    26\t//! The shared modules are included directly (rather than via the `cdylib`\n    27\t//! crate, which produces no Rust-linkable `rlib`) so this binary is fully\n    28\t//! self-contained while reusing the exact same source as the library.\n    29\t\n    30\tmod mdcore;\n    31\tmod mdmacros;\n    32\t\n    33\tuse core::ffi::c_int;\n    34\tuse std::io::Write;\n    35\tuse std::os::unix::ffi::OsStrExt;\n    36\t\n    37\tuse mdcore::{helper_call, helper_ptr, use_generated, G_OP};\n    38\tuse mdmacros::{op_fn, step, INIT_FOR, OP_NAME, REPEAT};\n    39\t\n    40\t/// Whitespace recognized by the C locale `isspace`, as used by `strtol`/`atoi`.\n    41\tfn c_isspace(c: u8) -> bool {\n    42\t    matches!(c, b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r')\n    43\t}\n    44\t\n    45\t/// Faithful reimplementation of C `atoi`, which on glibc is\n    46\t/// `(int) strtol(nptr, NULL, 10)`:\n    47\t///\n    48\t/// * leading whitespace is skipped,\n    49\t/// * an optional `+`/`-` sign is consumed,\n    50\t/// * decimal digits are accumulated until a non-digit is seen,\n    51\t/// * on overflow `strtol` clamps to `LONG_MIN`/`LONG_MAX` (64-bit) and the\n    52\t///   result is then truncated to `int`,\n    53\t/// * a string with no digits yields `0`.\n    54\tfn c_atoi(bytes: &[u8]) -> c_int {\n    55\t    let n = bytes.len();\n    56\t    let mut i = 0usize;\n    57\t\n    58\t    while i < n && c_isspace(bytes[i]) {\n    59\t        i += 1;\n    60\t    }\n    61\t\n    62\t    let mut neg = false;\n    63\t    if i < n && (bytes[i] == b'+' || bytes[i] == b'-') {\n    64\t        neg = bytes[i] == b'-';\n    65\t        i += 1;\n    66\t    }\n    67\t\n    68\t    // Accumulate in i64 (== C `long` on the target platform); clamp on overflow\n    69\t    // to mirror strtol, then truncate to `int`.\n    70\t    let mut acc: i64 = 0;\n    71\t    let mut clamped = false;\n    72\t    while i < n && bytes[i].is_ascii_digit() {\n    73\t        if !clamped {\n    74\t            let d = (bytes[i] - b'0') as i64;\n    75\t            let next = acc\n    76\t                .checked_mul(10)\n    77\t                .and_then(|v| if neg { v.checked_sub(d) } else { v.checked_add(d) });\n    78\t            match next {\n    79\t                Some(v) => acc = v,\n    80\t                None => {\n    81\t                    acc = if neg { i64::MIN } else { i64::MAX };\n    82\t                    clamped = true;\n    83\t                }\n    84\t            }\n    85\t        }\n    86\t        i += 1;\n    87\t    }\n    88\t\n    89\t    acc as c_int\n    90\t}\n    91\t\n    92\tfn main() {\n    93\t    let args: Vec<std::ffi::OsString> = std::env::args_os().collect();\n    94\t\n    95\t    if args.len() < 3 {\n    96\t        // fprintf(stderr, \"usage: %s A B\\n\", argv[0]);\n    97\t        let prog: &[u8] = args.first().map(|s| s.as_bytes()).unwrap_or(b\"\");\n    98\t        let stderr = std::io::stderr();\n    99\t        let mut h = stderr.lock();\n   100\t        let _ = h.write_all(b\"usage: \");\n   101\t        let _ = h.write_all(prog);\n   102\t        let _ = h.write_all(b\" A B\\n\");\n   103\t        std::process::exit(2);\n   104\t    }\n   105\t\n   106\t    let a = c_atoi(args[1].as_bytes());\n   107\t    let b = c_atoi(args[2].as_bytes());\n   108\t\n   109\t    let r_call = op_fn(a, b);\n   110\t\n   111\t    // int acc = INIT_FOR(OP); RUN_LOOP(OP, acc, REPEAT);\n   112\t    let mut acc = INIT_FOR;\n   113\t    let mut i: c_int = 0;\n   114\t    while i < REPEAT {\n   115\t        acc = step(acc, i);\n   116\t        i += 1;\n   117\t    }\n   118\t\n   119\t    let x1 = helper_call(a, b);\n   120\t    let x2 = helper_ptr(a, b);\n   121\t    let x3 = use_generated(REPEAT);\n   122\t    let g = (G_OP)(a, b);\n   123\t\n   124\t    println!(\"op={} call={} acc={} g.call={}\", OP_NAME, r_call, acc, g);\n   125\t    let summary = r_call\n   126\t        .wrapping_add(acc)\n   127\t        .wrapping_add(x1)\n   128\t        .wrapping_add(x2)\n   129\t        .wrapping_add(x3)\n   130\t        .wrapping_add(g);\n   131\t    println!(\"summary={}\", summary);\n   132\t}\n=== translation/src/mdcore.rs\n     1\t// Copyright 2025 MIT Lincoln Laboratory\n     2\t// Permission is hereby granted, free of charge,\n     3\t// to any person obtaining a copy of this software\n     4\t// and associated documentation files (the \"Software\"),\n     5\t// to deal in the Software without restriction,\n     6\t// including without limitation the rights to use, copy,\n     7\t// modify, merge, publish, distribute, sublicense,\n     8\t// and/or sell copies of the Software,\n     9\t// and to permit persons to whom the Software is furnished to do so,\n    10\t// subject to the following conditions:\n    11\t//\n    12\t// The above copyright notice and this permission notice\n    13\t// shall be included in all copies or substantial portions of the Software.\n    14\t//\n    15\t// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    16\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    17\t// THE WARRANTIES OF MERCHANTABILITY,\n    18\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    19\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    20\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    21\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    22\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    23\t\n    24\t//! Rust equivalent of `mdcore.c`.\n    25\t\n    26\tuse core::ffi::{c_char, c_int, CStr};\n    27\t\n    28\tuse crate::mdmacros::{op_fn, step, INIT_FOR, REPEAT};\n    29\t\n    30\t/* Define operations */\n    31\t\n    32\t/// `int op_add(int a, int b) { return a + b; }`\n    33\t#[unsafe(no_mangle)]\n    34\tpub extern \"C\" fn op_add(a: c_int, b: c_int) -> c_int {\n    35\t    a.wrapping_add(b)\n    36\t}\n    37\t\n    38\t/// `int op_sub(int a, int b) { return a - b; }`\n    39\t#[unsafe(no_mangle)]\n    40\tpub extern \"C\" fn op_sub(a: c_int, b: c_int) -> c_int {\n    41\t    a.wrapping_sub(b)\n    42\t}\n    43\t\n    44\t/// `int op_mul(int a, int b) { return a * b; }`\n    45\t#[unsafe(no_mangle)]\n    46\tpub extern \"C\" fn op_mul(a: c_int, b: c_int) -> c_int {\n    47\t    a.wrapping_mul(b)\n    48\t}\n    49\t\n    50\t/// Macro-generated accumulator for the selected OP: `DEFINE_ACCUM(OP)`.\n    51\t///\n    52\t/// The C `DISPATCH_REP` expands to `switch (n) { case 0..6: REPk; default: }`,\n    53\t/// where each `REPk` applies `step` for indices `0..k`. Only cases `0..=6` are\n    54\t/// handled; any other `n` (including `>= 7` or negative) falls through\n    55\t/// `default:` and leaves the accumulator at its initial value.\n    56\t///\n    57\t/// This is `static` in C (file-local), so it has no exported linker symbol.\n    58\tfn accum(n: c_int) -> c_int {\n    59\t    let mut acc = INIT_FOR;\n    60\t    if (0..=6).contains(&n) {\n    61\t        let mut i: c_int = 0;\n    62\t        while i < n {\n    63\t            acc = step(acc, i);\n    64\t            i += 1;\n    65\t        }\n    66\t    }\n    67\t    acc\n    68\t}\n    69\t\n    70\t/* Global macro uses at file scope (exercises expansion at global init) */\n    71\t\n    72\t/// `int (*G_OP)(int,int) = OP_FN(OP);` — pointer to the selected op function.\n    73\t#[cfg(feature = \"mul\")]\n    74\t#[unsafe(no_mangle)]\n    75\tpub static G_OP: extern \"C\" fn(c_int, c_int) -> c_int = op_mul;\n    76\t#[cfg(all(feature = \"sub\", not(feature = \"mul\")))]\n    77\t#[unsafe(no_mangle)]\n    78\tpub static G_OP: extern \"C\" fn(c_int, c_int) -> c_int = op_sub;\n    79\t#[cfg(all(not(feature = \"mul\"), not(feature = \"sub\")))]\n    80\t#[unsafe(no_mangle)]\n    81\tpub static G_OP: extern \"C\" fn(c_int, c_int) -> c_int = op_add;\n    82\t\n    83\t/// `const char *G_OP_NAME = STR(OP);`\n    84\t///\n    85\t/// A raw C string pointer. `*const c_char` is not `Sync`, so it is wrapped in a\n    86\t/// `#[repr(transparent)]` newtype (identical ABI to a bare pointer) whose\n    87\t/// `Sync` impl we vouch for — the pointee is a `'static` NUL-terminated literal.\n    88\t#[repr(transparent)]\n    89\tpub struct CCharPtr(pub *const c_char);\n    90\t// SAFETY: the wrapped pointer always refers to a read-only `'static` string\n    91\t// literal, so sharing it across threads is sound.\n    92\tunsafe impl Sync for CCharPtr {}\n    93\t\n    94\tconst G_OP_NAME_CSTR: &CStr = if cfg!(feature = \"mul\") {\n    95\t    c\"mul\"\n    96\t} else if cfg!(feature = \"sub\") {\n    97\t    c\"sub\"\n    98\t} else {\n    99\t    c\"add\"\n   100\t};\n   101\t\n   102\t#[unsafe(no_mangle)]\n   103\tpub static G_OP_NAME: CCharPtr = CCharPtr(G_OP_NAME_CSTR.as_ptr());\n   104\t\n   105\t/* Helpers provided by md_core.c */\n   106\t\n   107\t/// ```c\n   108\t/// int helper_call(int a, int b) {\n   109\t///     int r = (OP_FN(OP))(a, b);\n   110\t///     int acc = INIT_FOR(OP);\n   111\t///     RUN_LOOP(OP, acc, REPEAT);\n   112\t///     printf(\"helper.call=%d helper.acc=%d\\n\", r, acc);\n   113\t///     return r + acc;\n   114\t/// }\n   115\t/// ```\n   116\t///\n   117\t/// `RUN_LOOP` statically unrolls exactly `REPEAT` steps over indices\n   118\t/// `0..REPEAT` (the C `REP<REPEAT>` macro).\n   119\t#[unsafe(no_mangle)]\n   120\tpub extern \"C\" fn helper_call(a: c_int, b: c_int) -> c_int {\n   121\t    let r = op_fn(a, b);\n   122\t    let mut acc = INIT_FOR;\n   123\t    let mut i: c_int = 0;\n   124\t    while i < REPEAT {\n   125\t        acc = step(acc, i);\n   126\t        i += 1;\n   127\t    }\n   128\t    println!(\"helper.call={} helper.acc={}\", r, acc);\n   129\t    r.wrapping_add(acc)\n   130\t}\n   131\t\n   132\t/// ```c\n   133\t/// int helper_ptr(int a, int b) {\n   134\t///     int (*fp)(int,int) = OP_FN(OP);\n   135\t///     int r = fp(a, b);\n   136\t///     printf(\"helper.ptr=%d\\n\", r);\n   137\t///     return r;\n   138\t/// }\n   139\t/// ```\n   140\t#[unsafe(no_mangle)]\n   141\tpub extern \"C\" fn helper_ptr(a: c_int, b: c_int) -> c_int {\n   142\t    let fp: extern \"C\" fn(c_int, c_int) -> c_int = G_OP;\n   143\t    let r = fp(a, b);\n   144\t    println!(\"helper.ptr={}\", r);\n   145\t    r\n   146\t}\n   147\t\n   148\t/// ```c\n   149\t/// int use_generated(int n) {\n   150\t///     int r = (ACCUM_FN(OP))(n);\n   151\t///     printf(\"gen.acc=%d\\n\", r);\n   152\t///     return r;\n   153\t/// }\n   154\t/// ```\n   155\t#[unsafe(no_mangle)]\n   156\tpub extern \"C\" fn use_generated(n: c_int) -> c_int {\n   157\t    let r = accum(n);\n   158\t    println!(\"gen.acc={}\", r);\n   159\t    r\n   160\t}\n=== translation/src/mdmacros.rs\n     1\t// Copyright 2025 MIT Lincoln Laboratory\n     2\t// Permission is hereby granted, free of charge,\n     3\t// to any person obtaining a copy of this software\n     4\t// and associated documentation files (the \"Software\"),\n     5\t// to deal in the Software without restriction,\n     6\t// including without limitation the rights to use, copy,\n     7\t// modify, merge, publish, distribute, sublicense,\n     8\t// and/or sell copies of the Software,\n     9\t// and to permit persons to whom the Software is furnished to do so,\n    10\t// subject to the following conditions:\n    11\t//\n    12\t// The above copyright notice and this permission notice\n    13\t// shall be included in all copies or substantial portions of the Software.\n    14\t//\n    15\t// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    16\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    17\t// THE WARRANTIES OF MERCHANTABILITY,\n    18\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    19\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    20\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    21\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    22\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    23\t\n    24\t//! Rust equivalent of `mdmacros.h`.\n    25\t//!\n    26\t//! The C header selects, at preprocessing time, an operation family (`OP`) and\n    27\t//! an iteration count (`REPEAT`) via `-D` defines supplied by CMake. Here those\n    28\t//! selections are resolved from Cargo features, using the exact same names in\n    29\t//! lowercase (`add`/`sub`/`mul` for `OP`; `0`..`7` for `REPEAT`).\n    30\t//!\n    31\t//! Feature semantics:\n    32\t//! * When no OP feature is enabled the default is `add`; when no REPEAT feature\n    33\t//!   is enabled the default is `5` (matching the CMake cache defaults).\n    34\t//! * Enabling several conflicting values still compiles (\"all combinations must\n    35\t//!   compile\"): OP priority is `mul > sub > add`, REPEAT priority is the highest\n    36\t//!   selected number.\n    37\t\n    38\tuse core::ffi::c_int;\n    39\t\n    40\tuse crate::mdcore::{op_add, op_mul, op_sub};\n    41\t\n    42\t/// `STR(OP)` — the textual name of the selected operation.\n    43\t///\n    44\t/// Selection priority mirrors the cfg cascade used throughout this module:\n    45\t/// `mul` > `sub` > `add` (with `add` as the default).\n    46\tpub const OP_NAME: &str = if cfg!(feature = \"mul\") {\n    47\t    \"mul\"\n    48\t} else if cfg!(feature = \"sub\") {\n    49\t    \"sub\"\n    50\t} else {\n    51\t    \"add\"\n    52\t};\n    53\t\n    54\t/// `INIT_FOR(OP)` — the initial accumulator value for the selected op\n    55\t/// (`INIT_add == 0`, `INIT_sub == 0`, `INIT_mul == 1`).\n    56\tpub const INIT_FOR: c_int = if cfg!(feature = \"mul\") { 1 } else { 0 };\n    57\t\n    58\t/// `REPEAT` — the iteration count baked in at build time.\n    59\t///\n    60\t/// The C macros define `REP0`..`REP7`, so valid values are `0..=7`; the CMake\n    61\t/// default is `5`. If several REPEAT features are enabled the largest wins.\n    62\tpub const REPEAT: c_int = if cfg!(feature = \"7\") {\n    63\t    7\n    64\t} else if cfg!(feature = \"6\") {\n    65\t    6\n    66\t} else if cfg!(feature = \"5\") {\n    67\t    5\n    68\t} else if cfg!(feature = \"4\") {\n    69\t    4\n    70\t} else if cfg!(feature = \"3\") {\n    71\t    3\n    72\t} else if cfg!(feature = \"2\") {\n    73\t    2\n    74\t} else if cfg!(feature = \"1\") {\n    75\t    1\n    76\t} else if cfg!(feature = \"0\") {\n    77\t    0\n    78\t} else {\n    79\t    5\n    80\t};\n    81\t\n    82\t/// `STEP_OP(OP, acc, i)` for the selected operation.\n    83\t///\n    84\t/// * `add`: `acc += i`\n    85\t/// * `sub`: `acc -= i`\n    86\t/// * `mul`: `acc *= (i + 1)`\n    87\t///\n    88\t/// Arithmetic wraps on overflow to match the two's-complement behavior produced\n    89\t/// by the C toolchain for these programs.\n    90\t#[inline]\n    91\tpub fn step(acc: c_int, i: c_int) -> c_int {\n    92\t    if cfg!(feature = \"mul\") {\n    93\t        acc.wrapping_mul(i.wrapping_add(1))\n    94\t    } else if cfg!(feature = \"sub\") {\n    95\t        acc.wrapping_sub(i)\n    96\t    } else {\n    97\t        acc.wrapping_add(i)\n    98\t    }\n    99\t}\n   100\t\n   101\t/// `(OP_FN(OP))(a, b)` — invoke the selected operation directly.\n   102\t#[inline]\n   103\tpub fn op_fn(a: c_int, b: c_int) -> c_int {\n   104\t    if cfg!(feature = \"mul\") {\n   105\t        op_mul(a, b)\n   106\t    } else if cfg!(feature = \"sub\") {\n   107\t        op_sub(a, b)\n   108\t    } else {\n   109\t        op_add(a, b)\n   110\t    }\n   111\t}","is_error":false}]},"parent_tool_use_id":null,"session_id":"4fd0ca33-52e0-4ea1-bca3-cb6fcdae06fe","uuid":"eacc3a91-8658-40a9-81ca-c1dba54408fc","timestamp":"2026-08-31T15:07:36.090Z","tool_use_result":{"stdout":"=== translation/src/lib.rs\n     1\t// Copyright 2025 MIT Lincoln Laboratory\n     2\t// Permission is hereby granted, free of charge,\n     3\t// to any person obtaining a copy of this software\n     4\t// and associated documentation files (the \"Software\"),\n     5\t// to deal in the Software without restriction,\n     6\t// including without limitation the rights to use, copy,\n     7\t// modify, merge, publish, distribute, sublicense,\n     8\t// and/or sell copies of the Software,\n     9\t// and to permit persons to whom the Software is furnished to do so,\n    10\t// subject to the following conditions:\n    11\t//\n    12\t// The above copyright notice and this permission notice\n    13\t// shall be included in all copies or substantial portions of the Software.\n    14\t//\n    15\t// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    16\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    17\t// THE WARRANTIES OF MERCHANTABILITY,\n    18\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    19\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    20\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    21\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    22\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    23\t\n    24\t//! Shared-library crate for the `driver` translation.\n    25\t//!\n    26\t//! This mirrors the C shared objects built from `mdcore.c` (with `mdmacros.h`\n    27\t//! providing the build-time-configurable operation family and iteration count).\n    28\t//! The public `extern \"C\"` functions keep their original linker symbol names\n    29\t//! (there are no namespace-renaming macros in the C sources) and are exported\n    30\t//! from the `cdylib`.\n    31\t\n    32\tpub mod mdcore;\n    33\tpub mod mdmacros;\n=== translation/src/main.rs\n     1\t// Copyright 2025 MIT Lincoln Laboratory\n     2\t// Permission is hereby granted, free of charge,\n     3\t// to any person obtaining a copy of this software\n     4\t// and associated documentation files (the \"Software\"),\n     5\t// to deal in the Software without restriction,\n     6\t// including without limitation the rights to use, copy,\n     7\t// modify, merge, publish, distribute, sublicense,\n     8\t// and/or sell copies of the Software,\n     9\t// and to permit persons to whom the Software is furnished to do so,\n    10\t// subject to the following conditions:\n    11\t//\n    12\t// The above copyright notice and this permission notice\n    13\t// shall be included in all copies or substantial portions of the Software.\n    14\t//\n    15\t// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    16\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    17\t// THE WARRANTIES OF MERCHANTABILITY,\n    18\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    19\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    20\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    21\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    22\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    23\t\n    24\t//! Rust equivalent of `mdmain.c` (the `driver` binary entry point).\n    25\t//!\n    26\t//! The shared modules are included directly (rather than via the `cdylib`\n    27\t//! crate, which produces no Rust-linkable `rlib`) so this binary is fully\n    28\t//! self-contained while reusing the exact same source as the library.\n    29\t\n    30\tmod mdcore;\n    31\tmod mdmacros;\n    32\t\n    33\tuse core::ffi::c_int;\n    34\tuse std::io::Write;\n    35\tuse std::os::unix::ffi::OsStrExt;\n    36\t\n    37\tuse mdcore::{helper_call, helper_ptr, use_generated, G_OP};\n    38\tuse mdmacros::{op_fn, step, INIT_FOR, OP_NAME, REPEAT};\n    39\t\n    40\t/// Whitespace recognized by the C locale `isspace`, as used by `strtol`/`atoi`.\n    41\tfn c_isspace(c: u8) -> bool {\n    42\t    matches!(c, b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r')\n    43\t}\n    44\t\n    45\t/// Faithful reimplementation of C `atoi`, which on glibc is\n    46\t/// `(int) strtol(nptr, NULL, 10)`:\n    47\t///\n    48\t/// * leading whitespace is skipped,\n    49\t/// * an optional `+`/`-` sign is consumed,\n    50\t/// * decimal digits are accumulated until a non-digit is seen,\n    51\t/// * on overflow `strtol` clamps to `LONG_MIN`/`LONG_MAX` (64-bit) and the\n    52\t///   result is then truncated to `int`,\n    53\t/// * a string with no digits yields `0`.\n    54\tfn c_atoi(bytes: &[u8]) -> c_int {\n    55\t    let n = bytes.len();\n    56\t    let mut i = 0usize;\n    57\t\n    58\t    while i < n && c_isspace(bytes[i]) {\n    59\t        i += 1;\n    60\t    }\n    61\t\n    62\t    let mut neg = false;\n    63\t    if i < n && (bytes[i] == b'+' || bytes[i] == b'-') {\n    64\t        neg = bytes[i] == b'-';\n    65\t        i += 1;\n    66\t    }\n    67\t\n    68\t    // Accumulate in i64 (== C `long` on the target platform); clamp on overflow\n    69\t    // to mirror strtol, then truncate to `int`.\n    70\t    let mut acc: i64 = 0;\n    71\t    let mut clamped = false;\n    72\t    while i < n && bytes[i].is_ascii_digit() {\n    73\t        if !clamped {\n    74\t            let d = (bytes[i] - b'0') as i64;\n    75\t            let next = acc\n    76\t                .checked_mul(10)\n    77\t                .and_then(|v| if neg { v.checked_sub(d) } else { v.checked_add(d) });\n    78\t            match next {\n    79\t                Some(v) => acc = v,\n    80\t                None => {\n    81\t                    acc = if neg { i64::MIN } else { i64::MAX };\n    82\t                    clamped = true;\n    83\t                }\n    84\t            }\n    85\t        }\n    86\t        i += 1;\n    87\t    }\n    88\t\n    89\t    acc as c_int\n    90\t}\n    91\t\n    92\tfn main() {\n    93\t    let args: Vec<std::ffi::OsString> = std::env::args_os().collect();\n    94\t\n    95\t    if args.len() < 3 {\n    96\t        // fprintf(stderr, \"usage: %s A B\\n\", argv[0]);\n    97\t        let prog: &[u8] = args.first().map(|s| s.as_bytes()).unwrap_or(b\"\");\n    98\t        let stderr = std::io::stderr();\n    99\t        let mut h = stderr.lock();\n   100\t        let _ = h.write_all(b\"usage: \");\n   101\t        let _ = h.write_all(prog);\n   102\t        let _ = h.write_all(b\" A B\\n\");\n   103\t        std::process::exit(2);\n   104\t    }\n   105\t\n   106\t    let a = c_atoi(args[1].as_bytes());\n   107\t    let b = c_atoi(args[2].as_bytes());\n   108\t\n   109\t    let r_call = op_fn(a, b);\n   110\t\n   111\t    // int acc = INIT_FOR(OP); RUN_LOOP(OP, acc, REPEAT);\n   112\t    let mut acc = INIT_FOR;\n   113\t    let mut i: c_int = 0;\n   114\t    while i < REPEAT {\n   115\t        acc = step(acc, i);\n   116\t        i += 1;\n   117\t    }\n   118\t\n   119\t    let x1 = helper_call(a, b);\n   120\t    let x2 = helper_ptr(a, b);\n   121\t    let x3 = use_generated(REPEAT);\n   122\t    let g = (G_OP)(a, b);\n   123\t\n   124\t    println!(\"op={} call={} acc={} g.call={}\", OP_NAME, r_call, acc, g);\n   125\t    let summary = r_call\n   126\t        .wrapping_add(acc)\n   127\t        .wrapping_add(x1)\n   128\t        .wrapping_add(x2)\n   129\t        .wrapping_add(x3)\n   130\t        .wrapping_add(g);\n   131\t    println!(\"summary={}\", summary);\n   132\t}\n=== translation/src/mdcore.rs\n     1\t// Copyright 2025 MIT Lincoln Laboratory\n     2\t// Permission is hereby granted, free of charge,\n     3\t// to any person obtaining a copy of this software\n     4\t// and associated documentation files (the \"Software\"),\n     5\t// to deal in the Software without restriction,\n     6\t// including without limitation the rights to use, copy,\n     7\t// modify, merge, publish, distribute, sublicense,\n     8\t// and/or sell copies of the Software,\n     9\t// and to permit persons to whom the Software is furnished to do so,\n    10\t// subject to the following conditions:\n    11\t//\n    12\t// The above copyright notice and this permission notice\n    13\t// shall be included in all copies or substantial portions of the Software.\n    14\t//\n    15\t// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    16\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    17\t// THE WARRANTIES OF MERCHANTABILITY,\n    18\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    19\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    20\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    21\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    22\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    23\t\n    24\t//! Rust equivalent of `mdcore.c`.\n    25\t\n    26\tuse core::ffi::{c_char, c_int, CStr};\n    27\t\n    28\tuse crate::mdmacros::{op_fn, step, INIT_FOR, REPEAT};\n    29\t\n    30\t/* Define operations */\n    31\t\n    32\t/// `int op_add(int a, int b) { return a + b; }`\n    33\t#[unsafe(no_mangle)]\n    34\tpub extern \"C\" fn op_add(a: c_int, b: c_int) -> c_int {\n    35\t    a.wrapping_add(b)\n    36\t}\n    37\t\n    38\t/// `int op_sub(int a, int b) { return a - b; }`\n    39\t#[unsafe(no_mangle)]\n    40\tpub extern \"C\" fn op_sub(a: c_int, b: c_int) -> c_int {\n    41\t    a.wrapping_sub(b)\n    42\t}\n    43\t\n    44\t/// `int op_mul(int a, int b) { return a * b; }`\n    45\t#[unsafe(no_mangle)]\n    46\tpub extern \"C\" fn op_mul(a: c_int, b: c_int) -> c_int {\n    47\t    a.wrapping_mul(b)\n    48\t}\n    49\t\n    50\t/// Macro-generated accumulator for the selected OP: `DEFINE_ACCUM(OP)`.\n    51\t///\n    52\t/// The C `DISPATCH_REP` expands to `switch (n) { case 0..6: REPk; default: }`,\n    53\t/// where each `REPk` applies `step` for indices `0..k`. Only cases `0..=6` are\n    54\t/// handled; any other `n` (including `>= 7` or negative) falls through\n    55\t/// `default:` and leaves the accumulator at its initial value.\n    56\t///\n    57\t/// This is `static` in C (file-local), so it has no exported linker symbol.\n    58\tfn accum(n: c_int) -> c_int {\n    59\t    let mut acc = INIT_FOR;\n    60\t    if (0..=6).contains(&n) {\n    61\t        let mut i: c_int = 0;\n    62\t        while i < n {\n    63\t            acc = step(acc, i);\n    64\t            i += 1;\n    65\t        }\n    66\t    }\n    67\t    acc\n    68\t}\n    69\t\n    70\t/* Global macro uses at file scope (exercises expansion at global init) */\n    71\t\n    72\t/// `int (*G_OP)(int,int) = OP_FN(OP);` — pointer to the selected op function.\n    73\t#[cfg(feature = \"mul\")]\n    74\t#[unsafe(no_mangle)]\n    75\tpub static G_OP: extern \"C\" fn(c_int, c_int) -> c_int = op_mul;\n    76\t#[cfg(all(feature = \"sub\", not(feature = \"mul\")))]\n    77\t#[unsafe(no_mangle)]\n    78\tpub static G_OP: extern \"C\" fn(c_int, c_int) -> c_int = op_sub;\n    79\t#[cfg(all(not(feature = \"mul\"), not(feature = \"sub\")))]\n    80\t#[unsafe(no_mangle)]\n    81\tpub static G_OP: extern \"C\" fn(c_int, c_int) -> c_int = op_add;\n    82\t\n    83\t/// `const char *G_OP_NAME = STR(OP);`\n    84\t///\n    85\t/// A raw C string pointer. `*const c_char` is not `Sync`, so it is wrapped in a\n    86\t/// `#[repr(transparent)]` newtype (identical ABI to a bare pointer) whose\n    87\t/// `Sync` impl we vouch for — the pointee is a `'static` NUL-terminated literal.\n    88\t#[repr(transparent)]\n    89\tpub struct CCharPtr(pub *const c_char);\n    90\t// SAFETY: the wrapped pointer always refers to a read-only `'static` string\n    91\t// literal, so sharing it across threads is sound.\n    92\tunsafe impl Sync for CCharPtr {}\n    93\t\n    94\tconst G_OP_NAME_CSTR: &CStr = if cfg!(feature = \"mul\") {\n    95\t    c\"mul\"\n    96\t} else if cfg!(feature = \"sub\") {\n    97\t    c\"sub\"\n    98\t} else {\n    99\t    c\"add\"\n   100\t};\n   101\t\n   102\t#[unsafe(no_mangle)]\n   103\tpub static G_OP_NAME: CCharPtr = CCharPtr(G_OP_NAME_CSTR.as_ptr());\n   104\t\n   105\t/* Helpers provided by md_core.c */\n   106\t\n   107\t/// ```c\n   108\t/// int helper_call(int a, int b) {\n   109\t///     int r = (OP_FN(OP))(a, b);\n   110\t///     int acc = INIT_FOR(OP);\n   111\t///     RUN_LOOP(OP, acc, REPEAT);\n   112\t///     printf(\"helper.call=%d helper.acc=%d\\n\", r, acc);\n   113\t///     return r + acc;\n   114\t/// }\n   115\t/// ```\n   116\t///\n   117\t/// `RUN_LOOP` statically unrolls exactly `REPEAT` steps over indices\n   118\t/// `0..REPEAT`