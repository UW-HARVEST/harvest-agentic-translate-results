        }\n        if val % 10 == 9 {\n            break;\n        }\n        // The C code performs `val++`; on signed overflow the C behaviour is\n        // undefined but in practice wraps on the target platforms.\n        val = val.wrapping_add(1);\n    }\n}\n","structuredPatch":[{"oldStart":8,"oldLines":6,"newStart":8,"newLines":9,"lines":[" //"," // Public ABI exported by the C shared library (nm -D libSieve.so): `sieve`."," ","+// The library name mirrors the C target (libSieve.so).","+#![allow(non_snake_case)]","+"," use std::ffi::c_int;"," "," unsafe extern \"C\" {"]}],"userModified":false,"replaceAll":false}}
