e original library.\n39\t// ---------------------------------------------------------------------------\n40\tunsafe extern \"C\" {\n41\t    fn malloc(size: usize) -> *mut c_void;\n42\t    fn free(ptr: *mut c_void);\n43\t    fn printf(fmt: *const c_char, ...) -> c_int;\n44\t    fn snprintf(s: *mut c_char, n: usize, fmt: *const c_char, ...) -> c_int;\n45\t    fn strlen(s: *const c_char) -> usize;\n46\t    fn memchr(s: *const c_void, c: c_int, n: usize) -> *mut c_void;\n47\t}\n48\t\n49\t// ---------------------------------------------------------------------------\n50\t// typedef struct { unsigned int flag1:1, flag2:1, flag3:1, counter:5,\n51\t//                               mode:3, status:5, reserved:16; } PackedFlags;\n52\t//\n53\t// System V / GCC on little-endian targets allocates bit-fields from the least\n54\t// significant bit of the storage unit upwards, so the layout of the single\n55\t// 32-bit allocation unit is:\n56\t//\n57\t//   bit  0      flag1\n58\t//   bit  1      flag2\n59\t//   bit  2      flag3\n60\t//   bits 3..8   counter  (5 bits)\n61\t//   bits 8..11  mode     (3 bits)\n62\t//   bits 11..16 status   (5 bits)\n63\t//   bits 16..32 reserved (16 bits)\n64\t// ---------------------------------------------------------------------------\n65\t#[repr(C)]\n66\t#[derive(Clone, Copy)]\n67\tpub struct PackedFlags {\n68\t    bits: u32,\n69\t}\n70\t\n71\tmacro_rules! bitfield {\n72\t    ($get:ident, $set:ident, $offset:expr, $width:expr) => {\n73\t        #[inline]\n74\t        fn $get(&self) -> c_uint {\n75\t            ((self.bits >> $offset) & ((1u32 << $width) - 1)) as c_uint\n76\t        }\n77\t        #[inline]\n78\t        fn $set(&mut self, value: c_uint) {\n79\t            let mask: u32 = ((1u32 << $width) - 1) << $offset;\n80\t            self.bits = (self.bits & !mask) | (((value as u32) << $offset) & mask);\n81\t        }\n82\t    };\n83\t}\n84\t\n85\t#[allow(dead_code)]\n86\timpl PackedFlags {\n87\t    bitfield!(flag1, set_flag1, 0, 1);\n88\t   