et (p1, p2, p3, p4) = (\n                    r.interesting_i32(),\n                    r.interesting_i32(),\n                    r.interesting_i32(),\n                    r.interesting_i32(),\n                );\n                log.push(format!(\"k={k} -> {}\", (lib.confusion)(p1, p2, p3, p4)));\n            }\n        });\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
