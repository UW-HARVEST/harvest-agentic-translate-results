13\t            break;\n114\t        }\n115\t\n116\t        count++;\n117\t        LOG_OPERATION(memchr_found, count);\n118\t\n119\t        remaining -= (found - ptr + 1);\n120\t        ptr = found + 1;\n121\t    }\n122\t\n123\t    return count;\n124\t}\n125\t\n126\tvoid update_flags(ProcessState* state, int param) {\n127\t    if (state == NULL) {\n128\t        return;\n129\t    }\n130\t\n131\t    state->flags.counter = (state->flags.counter + 1) & 0x1F; // 5-bit counter\n132\t    state->flags.flag1 = (param & 1);\n133\t    state->flags.flag2 = (param & 2) >> 1;\n134\t    state->flags.flag3 = (param & 4) >> 2;\n135\t    state->flags.mode = (param >> 3) & 0x7;\n136\t\n137\t    DEBUG_VAR(state->flags.counter);\n138\t    printf(\"Bit fields - flag1:%d flag2:%d flag3:%d mode:%d\\n\",\n139\t           state->flags.flag1, state->flags.flag2,\n140\t           state->flags.flag3, state->flags.mode);\n141\t}\n142\t\n143\tint confuse_types(ProcessState* state, int operation) {\n144\t    if (state == NULL) {\n145\t        return 0;\n146\t    }\n147\t\n148\t    int result = 0;\n149\t\n150\t    switch (operation) {\n151\t        case 0:\n152\t            state->data.int_val = 1078530011;\n153\t            printf(\"Set as int: %d\\n\", state->data.int_val);\n154\t            break;\n155\t\n156\t        case 1:\n157\t            printf(\"Read as float: %f\\n\", state->data.float_val);\n158\t            result = (int)(state->data.float_val * 100);\n159\t            break;\n160\t\n161\t        case 2:\n162\t            printf(\"Read as uint: %u\\n\", state->data.uint_val);\n163\t            result = state->data.uint_val & 0xFF;\n164\t            break;\n165\t\n166\t        case 3:\n167\t            printf(\"Read as bytes: [%d, %d, %d, %d]\\n\",\n168\t                   state->data.bytes[0], state->data.bytes[1],\n169\t                   state->data.bytes[2], state->data.bytes[3]);\n170\t            result = state->data.bytes[0] + state->data.bytes[1];\n171\t            break;\n172\t