);\ntypedef int (*initfq_t)(file_queue *, const struct tm *, int);\ntypedef alert_data *(*readfm_t)(file_queue *, const struct tm *, unsigned int);\ntypedef void (*merror_t)(const char *, const char *, int, const char *);\ntypedef void *(*oscalloc_t)(size_t, size_t);\ntypedef void *(*osrealloc_t)(void *, size_t);\ntypedef char *(*osstrdup_t)(const char *);\n\nstatic void S(const char *n, const char *v) {\n    if (v) printf(\"  %s=[%s]\\n\", n, v); else printf(\"  %s=NULL\\n\", n);\n}\nstatic void dump(const char *tag, alert_data *a) {\n    printf(\"%s: \", tag);\n    if (!a) { printf(\"NULL\\n\"); return; }\n    printf(\"alert_data\\n  rule=%u\\n  level=%u\\n\", a->rule, a->level);\n    S(\"alertid\", a->alertid); S(\"date\", a->date); S(\"location\", a->location);\n    S(\"comment\", a->comment); S(\"group\", a->group); S(\"srcip\", a->srcip);\n    printf(\"  srcport=%d\\n\", a->srcport);\n    S(\"dstip\", a->dstip);\n    printf(\"  dstport=%d\\n\", a->dstport);\n    S(\"user\", a->user); S(\"filename\", a->filename);\n}\n\nint main(int argc, char **argv) {\n    void *h = dlopen(argv[1], RTLD_NOW);\n    if (!h) { fprintf(stderr, \"dlopen: %s\\n\", dlerror()); return 2; }\n    driver_t    Fdriver   = (driver_t)dlsym(h, \"driver\");\n    getalert_t  Fget      = (getalert_t)dlsym(h, \"GetAlertData\");\n    freealert_t Ffree     = (freealert_t)dlsym(h, \"FreeAlertData\");\n    initfq_t    Finit     = (initfq_t)dlsym(h, \"Init_FileQueue\");\n    readfm_t    Fread     = (readfm_t)dlsym(h, \"Read_FileMon\");\n    merror_t    Fmerror   = (merror_t)dlsym(h, \"merror\");\n    oscalloc_t  Fcalloc   = (oscalloc_t)dlsym(h, \"os_calloc\");\n    osrealloc_t Frealloc  = (osrealloc_t)dlsym(h, \"os_realloc\");\n    osstrdup_t  Fstrdup   = (osstrdup_t)dlsym(h, \"os_strdup\");\n    if (!Fdriver||!Fget||!Ffree||!Finit||!Fread||!Fmerror||!Fcalloc||!Frealloc||!Fstrdup) {\n        fprintf(stderr, \"missing symbol\\n\"); return 2;\n    }\n\n    printf(\"=== os_* helpers ===\\n\");\n    void *m = Fcalloc(4, 8);\n    printf(\"calloc nonnull=%d zeroed=%d\\n\", m != NULL, ((char*)m)[0]==0 && ((char*)m)[31]==0);\n    m = Frealloc(m, 64);\n    printf(\"realloc nonnull=%d\\n\", m != NULL);\n    free(m);\n    char *d = Fstrdup(\"hello world\");\n    printf(\"strdup=[%s]\\n\", d);\n    free(d);\n    d = Fstrdup(\"\");\n    printf(\"strdup empty=[%s] len=%zu\\n\", d, strlen(d));\n    free(d);\n\n    printf(\"=== merror ===\\n\");\n    fflush(stdout);\n    Fmerror(\"(1116): Could not set position in file '%s' due to [(%d)-(%s)].\", \"alerts.log\", 2, \"No such file or directory\");\n    Fmerror(\"plain template no fmt\", \"x\", 1, \"y\");\n    Fmerror(\"%s|%d|%s\", \"a\", -5, \"b\");\n    /* overflow the 256 byte buffer */\n    Fmerror(\"%s%s%s%s\", \"0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789\", 7,\n            \"abcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghij\");\n    fflush(stderr);\n\n    printf(\"=== GetAlertData over files ===\\n\");\n    const char *names[] = {\"t1.log\",\"t2.log\",\"t3.log\",\"t4.log\",\"t5.log\",\"t6.log\",\"t7.log\",\"t8.log\",\"t9.log\",\"t10.log\",\"t11.log\",\"t12.log\", NULL};\n    for (int i = 0; names[i]; i++) {\n        FILE *fp = fopen(names[i], \"r\");\n        if (!fp) { printf(\"%s: (missing)\\n\", names[i]); continue; }\n        int n = 0;\n        alert_data *a;\n        printf(\"-- %s --\\n\", names[i]);\n        fflush(stdout);\n        while ((a = Fget(0, fp)) != NULL) {\n            char tag[64]; snprintf(tag, sizeof tag, \"  alert%d\", n++);\n            fflush(stderr);\n            dump(tag, a);\n            Ffree(a);\n            if (n > 20) break;\n        }\n        fflush(stderr);\n        printf(\"  count=%d feof=%d ftell=%ld\\n\", n, feof(fp), ftell(fp));\n        fclose(fp);\n        /* again with CRALERT_MAIL_SET */\n        fp = fopen(names[i], \"r\");\n        n = 0;\n        fflush(stdout);\n        while ((a = Fget(0x001, fp)) != NULL) {\n            char tag[64]; snprintf(tag, sizeof tag, \"  mail%d\", n++);\n            fflush(stderr);\n            dump(tag, a);\n            Ffree(a);\n            if (n > 20) break;\n        }\n        fflush(stderr);\n        printf(\"  mailcount=%d\\n\", n);\n        fclose(fp);\n    }\n\n    printf(\"=== Init_FileQueue ===\\n\");\n    for (int mon = 0; mon < 12; mon += 5) {\n        for (int fl = 0; fl < 0x20; fl += 4) {\n            file_queue fq; memset(&fq, 0, sizeof fq);\n            struct tm t; memset(&t, 0, sizeof t);\n            t.tm_mday = 17; t.tm_mon = mon; t.tm_year = 125;\n            fflush(stdout);\n            int r = Finit(&fq, &t, fl);\n            fflush(stderr);\n            printf(\"mon=%d fl=%#x -> r=%d day=%d year=%d flags=%#x mon=[%.3s] file=[%s] fp?%d last_change_set=%d\\n\",\n                   mon, fl, r, fq.day, fq.year, fq.flags, fq.mon, fq.file_name, fq.fp != NULL,\n                   fq.last_change == fq.f_status.st_mtime);\n            if (fq.fp) fclose(fq.fp);\n        }\n    }\n\n    printf(\"=== Read_FileMon (timeout 0) ===\\n\");\n    {\n        file_queue fq; memset(&fq, 0, sizeof fq);\n        struct tm t; memset(&t, 0, sizeof t);\n        t.tm_mday = 3; t.tm_mon = 4; t.tm_year = 124;\n        fflush(stdout);\n        int r = Finit(&fq, &t, 0x004);\n        alert_data *a = Fread(&fq, &t, 0);\n        fflush(stderr);\n        printf(\"init=%d\\n\", r);\n        dump(\"readfilemon\", a);\n        if (a) Ffree(a);\n        if (fq.fp) fclose(fq.fp);\n    }\n\n    printf(\"=== driver ===\\n\");\n    {\n        int flagset[] = {0, 0x001, 0x004, 0x005, 0x010, 0x014};\n        for (unsigned i = 0; i < sizeof flagset/sizeof *flagset; i++) {\n            fflush(stdout);\n            alert_data *a = Fdriver(11, 6, 124, 0, flagset[i]);\n            fflush(stderr);\n            char tag[64]; snprintf(tag, sizeof tag, \"driver flags=%#x\", flagset[i]);\n            dump(tag, a);\n            if (a) Ffree(a);\n        }\n    }\n    fflush(stdout); fflush(stderr);\n    return 0;\n}\n","structuredPatch":[{"oldStart":84,"oldLines":9,"newStart":84,"newLines":14,"lines":["     Fmerror(\"(1116): Could not set position in file '%s' due to [(%d)-(%s)].\", \"alerts.log\", 2, \"No such file or directory\");","     Fmerror(\"plain template no fmt\", \"x\", 1, \"y\");","     Fmerror(\"%s|%d|%s\", \"a\", -5, \"b\");","-    /* overflow the 256 byte buffer */","-    Fmerror(\"%s%s%s%s\", \"0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789\", 7,","-            \"abcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghij\");","+    /* overflow the 256 byte buffer -> snprintf truncates */","+    {","+        char big[400];","+        memset(big, 'Z', sizeof big); big[sizeof big - 1] = '\\0';","+        Fmerror(\"<%s> code=%d msg=%s\", big, 12345, \"tail\");","+    }","+    Fmerror(\"%%literal%% %s %d %s\", \"s1\", 0, \"s2\");","+    Fmerror(\"\", \"a\", 1, \"b\");","     fflush(stderr);"," ","     printf(\"=== GetAlertData over files ===\\n\");"]}],"userModified":false,"replaceAll":false}}
