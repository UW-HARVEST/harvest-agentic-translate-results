 os_clearnl(str, p);\n176\t\n177\t            p = strchr(str, ':');\n178\t            if (p) {\n179\t                p = strchr(p, ' ');\n180\t                if (p) {\n181\t                    *p = '\\0';\n182\t                    p++;\n183\t                } else {\n184\t                    /* If p is null it is because strchr failed */\n185\t                    perror(\"date of location not NULL\");\n186\t                    goto l_error;\n187\t                }\n188\t            }\n189\t\n190\t            /* If not, str is date and p is the location */\n191\t            if (al_data->date || al_data->location || !p) {\n192\t                perror(\"date or location not NULL or p is NULL\");\n193\t                goto l_error;\n194\t            }\n195\t\n196\t            al_data->date = os_strdup(str);\n197\t            al_data->location = os_strdup(p);\n198\t            _r = 2;\n199\t            log_size = 0;\n200\t            continue;\n201\t        } else if (_r == 2) {\n202\t            /* Rule begin */\n203\t            if (strncmp(RULE_BEGIN, str, RULE_BEGIN_SZ) == 0) {\n204\t                os_clearnl(str, p);\n205\t\n206\t                p = str + RULE_BEGIN_SZ;\n207\t                al_data->rule = atoi(p);\n208\t\n209\t                p = strchr(p, ' ');\n210\t                if (p) {\n211\t                    p++;\n212\t                    p = strchr(p, ' ');\n213\t                    if (p) {\n214\t                        p++;\n215\t                    }\n216\t                }\n217\t\n218\t                if (!p) {\n219\t                    goto l_error;\n220\t                }\n221\t\n222\t                al_data->level = atoi(p);\n223\t\n224\t                /* Get the comment */\n225\t                p = strchr(p, '\\'');\n226\t                if (!p) {\n227\t                    goto l_error;\n228\t                }\n229\t\n230\t                p++;\n231\t                os_free(al_data->comment);\n232\t                al_data->comment = os_strdup(