{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_0161BHNWr3Z2gaqbydirdrTY","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/`.\n2\t//!\n3\t//! Public ABI (matches `nm -D` of the C shared object):\n4\t//!   * `extractFilename`\n5\t//!   * `FIO_createFilename_fromOutDir`\n6\t//!\n7\t//! The behaviour of the C original is reproduced exactly, including its quirks\n8\t//! (e.g. the out-of-bounds `outDirName[strlen(outDirName)-1]` read when\n9\t//! `outDirName` is the empty string, and the `exit(30)` on allocation failure).\n10\t\n11\t#![allow(non_snake_case)]\n12\t\n13\tuse core::ffi::{c_char, c_int, c_void};\n14\t\n15\t// ---------------------------------------------------------------------------\n16\t// libc bindings\n17\t//\n18\t// The buffer returned by FIO_createFilename_fromOutDir() is expected to be\n19\t// released by the caller with free(), therefore it must come from the very same\n20\t// allocator the C code used: libc's calloc().\n21\t// ---------------------------------------------------------------------------\n22\tunsafe extern \"C\" {\n23\t    fn calloc(nmemb: usize, size: usize) -> *mut c_void;\n24\t    fn exit(status: c_int) -> !;\n25\t    fn fprintf(stream: *mut c_void, format: *const c_char, ...) -> c_int;\n26\t    fn strerror(errnum: c_int) -> *mut c_char;\n27\t    fn __errno_location() -> *mut c_int;\n28\t\n29\t    #[allow(non_upper_case_globals)]\n30\t    static mut stderr: *mut c_void;\n31\t}\n32\t\n33\t/// Platform path separator, mirroring the `#if defined(_MSC_VER) ||\n34\t/// defined(__MINGW32__) || defined(__MSVCRT__)` block of the C source.\n35\t#[cfg(windows)]\n36\tconst SEPARATOR: c_char = b'\\\\' as c_char;\n37\t#[cfg(not(windows))]\n38\tconst SEPARATOR: c_char = b'/' as c_char;\n39\t\n40\t// ---------------------------------------------------------------------------\n41\t// C string helpers (faithful re-implementations of the used libc routines)\n42\t// ---------------------------------------------------------------------------\n43\t\n44\t/// Equivalent of `strlen(s)`.\n45\t///\n46\t/// # Safety\n47\t/// `s` must point to a NUL terminated string.\n48\tunsafe fn strlen(s: *const c_char) -> usize {\n49\t    let mut len = 0usize;\n50\t    // SAFETY: guaranteed by the caller; walks until the terminating NUL.\n51\t    while unsafe { *s.add(len) } != 0 {\n52\t        len += 1;\n53\t    }\n54\t    len\n55\t}\n56\t\n57\t/// Equivalent of `strrchr(s, c)`.\n58\t///\n59\t/// As mandated by the C standard, the terminating NUL byte is considered to be\n60\t/// part of the string, so `strrchr(s, 0)` yields a pointer to that NUL byte.\n61\t///\n62\t/// # Safety\n63\t/// `s` must point to a NUL terminated string.\n64\tunsafe fn strrchr(s: *const c_char, c: c_char) -> *const c_char {\n65\t    // SAFETY: guaranteed by the caller.\n66\t    let len = unsafe { strlen(s) };\n67\t    let mut i = len as isize;\n68\t    while i >= 0 {\n69\t        // SAFETY: `i` stays within `0..=len`, i.e. inside the string including\n70\t        // its terminator.\n71\t        if unsafe { *s.offset(i) } == c {\n72\t            return unsafe { s.offset(i) };\n73\t        }\n74\t        i -= 1;\n75\t    }\n76\t    core::ptr::null()\n77\t}\n78\t\n79\t/// Equivalent of `memcpy(dst, src, n)`.\n80\t///\n81\t/// # Safety\n82\t/// The `n` bytes at `src` and at `dst` must be valid and non-overlapping.\n83\tunsafe fn memcpy(dst: *mut c_char, src: *const c_char, n: usize) {\n84\t    // SAFETY: guaranteed by the caller.\n85\t    unsafe { core::ptr::copy_nonoverlapping(src, dst, n) };\n86\t}\n87\t\n88\t// ---------------------------------------------------------------------------\n89\t// Public ABI\n90\t// ---------------------------------------------------------------------------\n91\t\n92\t/// ```c\n93\t/// const char* extractFilename(const char* path, char separator)\n94\t/// ```\n95\t///\n96\t/// Returns the portion of `path` following the last occurrence of `separator`,\n97\t/// or `