{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01ANvr8VqVbr9icF2KRmuVXv","type":"tool_result","content":"1\t//! Translation of `lib/shake/src/fips202.c`.\n2\t//!\n3\t//! The Keccak-f[1600] permutation is implemented in the standard round-based\n4\t//! form; it is bit-for-bit identical to the unrolled C version. The\n5\t//! incremental sponge bookkeeping mirrors the C code exactly.\n6\t\n7\tpub const SHAKE128_RATE: usize = 168;\n8\tpub const SHAKE256_RATE: usize = 136;\n9\tpub const SHA3_256_RATE: usize = 136;\n10\tpub const SHA3_512_RATE: usize = 72;\n11\t\n12\tfn load64(x: &[u8]) -> u64 {\n13\t    let mut r = 0u64;\n14\t    for i in 0..8 {\n15\t        r |= (x[i] as u64) << (8 * i);\n16\t    }\n17\t    r\n18\t}\n19\t\n20\tfn store64(x: &mut [u8], u: u64) {\n21\t    for i in 0..8 {\n22\t        x[i] = (u >> (8 * i)) as u8;\n23\t    }\n24\t}\n25\t\n26\tconst KECCAK_RC: [u64; 24] = [\n27\t    0x0000000000000001, 0x0000000000008082, 0x800000000000808a, 0x8000000080008000,\n28\t    0x000000000000808b, 0x0000000080000001, 0x8000000080008081, 0x8000000000008009,\n29\t    0x000000000000008a, 0x0000000000000088, 0x0000000080008009, 0x000000008000000a,\n30\t    0x000000008000808b, 0x800000000000008b, 0x8000000000008089, 0x8000000000008003,\n31\t    0x8000000000008002, 0x8000000000000080, 0x000000000000800a, 0x800000008000000a,\n32\t    0x8000000080008081, 0x8000000000008080, 0x0000000080000001, 0x8000000080008008,\n33\t];\n34\t\n35\tconst KECCAK_ROTC: [u32; 24] = [\n36\t    1, 3, 6, 10, 15, 21, 28, 36, 45, 55, 2, 14, 27, 41, 56, 8, 25, 43, 62, 18, 39, 61, 20, 44,\n37\t];\n38\t\n39\tconst KECCAK_PILN: [usize; 24] = [\n40\t    10, 7, 11, 17, 18, 3, 5, 16, 8, 21, 24, 4, 15, 23, 19, 13, 12, 2, 20, 14, 22, 9, 6, 1,\n41\t];\n42\t\n43\tfn keccak_f1600_state_permute(s: &mut [u64]) {\n44\t    for round in 0..24 {\n45\t        // Theta\n46\t        let mut bc = [0u64; 5];\n47\t        for i in 0..5 {\n48\t            bc[i] = s[i] ^ s[i + 5] ^ s[i + 10] ^ s[i + 15] ^ s[i + 20];\n49\t        }\n50\t        for i in 0..5 {\n51\t            let t = bc[(i + 4) % 5] ^ bc[(i + 1) % 5].rotate_left(1);\n52\t            let mut j = 0;\n53\t            while j < 25 {\n54\t                s[j + i] ^= t;\n55\t                j += 5;\n56\t            }\n57\t        }\n58\t        // Rho + Pi\n59\t        let mut t = s[1];\n60\t        for i in 0..24 {\n61\t            let j = KECCAK_PILN[i];\n62\t            let tmp = s[j];\n63\t            s[j] = t.rotate_left(KECCAK_ROTC[i]);\n64\t            t = tmp;\n65\t        }\n66\t        // Chi\n67\t        let mut j = 0;\n68\t        while j < 25 {\n69\t            let mut tmp = [0u64; 5];\n70\t            for i in 0..5 {\n71\t                tmp[i] = s[j + i];\n72\t            }\n73\t            for i in 0..5 {\n74\t                s[j + i] ^= (!tmp[(i + 1) % 5]) & tmp[(i + 2) % 5];\n75\t            }\n76\t            j += 5;\n77\t        }\n78\t        // Iota\n79\t        s[0] ^= KECCAK_RC[round];\n80\t    }\n81\t}\n82\t\n83\tfn keccak_absorb(s: &mut [u64], r: usize, mut m: &[u8], mut mlen: usize, p: u8) {\n84\t    let mut t = [0u8; 200];\n85\t    for i in 0..25 {\n86\t        s[i] = 0;\n87\t    }\n88\t    while mlen >= r {\n89\t        for i in 0..r / 8 {\n90\t            s[i] ^= load64(&m[8 * i..]);\n91\t        }\n92\t        keccak_f1600_state_permute(s);\n93\t        mlen -= r;\n94\t        m = &m[r..];\n95\t    }\n96\t    for i in 0..r {\n97\t        t[i] = 0;\n98\t    }\n99\t    for i in 0..mlen {\n100\t        t[i] = m[i];\n101\t    }\n102\t    t[mlen] = p;\n103\t    t[r - 1] |= 128;\n104\t    for i in 0..r / 8 {\n105\t        s[i] ^= load64(&t[8 * i..]);\n106\t    }\n107\t}\n108\t\n109\tfn keccak_squeezeblocks(h: &mut [u8], mut nblocks: usize, s: &mut [u64], r: usize) {\n110\t    let mut ho = 0usize;\n111\t    while nblocks > 0 {\n112\t        keccak_f1600_state_permute(s);\n113\t        for i in 0..(r >> 3) {\n114\t            store64(&mut h[ho + 8 * i..], s[i]);\n115\t        }\n116\t        ho += r;\n117\t        nblocks -= 1;\n118\t    }\n119\t}\n120\t\n121\tfn keccak_inc_init(s_inc: &mut [u64]) {\n122\t    for i in 0..25 {\n123\t        s_inc[i] = 0;\n124\t    }\n125\t    s_inc[25] = 0;\n126\t}\n127\t\n128\tfn keccak_inc_absorb(s_inc: &mut [u64], r: usize, mut m: &[u8], mut mlen: usize) {\n129\t    let r = r as u64;\n130\t    while mlen as u64 + s_inc[25] >= r {\n131\t        let cnt = (r - s_inc[25]) as usize;\n132\t        for i in 0..cnt {\n133\t            let pos = (s_inc[25] + i as u64) as usize;\n134\t            s_inc[pos >> 3] ^= (m[i] as u64) << (8 * (pos & 0x07));\n135\t        }\n136\t        mlen -= cnt;\n137\t        m = &m[cnt..];\n138\t        s_inc[25] = 0;\n139\t        keccak_f1600_state_permute(s_inc);\n140\t    }\n141\t    for i in 0..mlen {\n142\t        let pos = (s_inc[25] + i as u64) as usize;\n143\t        s_inc[pos >> 3] ^= (m[i] as u64) << (8 * (pos & 0x07));\n144\t    }\n145\t    s_inc[25] += mlen as u64;\n146\t}\n147\t\n148\tfn keccak_inc_finalize(s_inc: &mut [u64], r: usize, p: u8) {\n149\t    let r = r as u64;\n150\t    let pos = s_inc[25] as usize;\n151\t    s_inc[pos >> 3] ^= (p as u64) << (8 * (pos & 0x07));\n152\t    let last = (r - 1) as usize;\n153\t    s_inc[last >> 3] ^= 128u64 << (8 * (last & 0x07));\n154\t    s_inc[25] = 0;\n155\t}\n156\t\n157\tfn keccak_inc_squeeze(h: &mut [u8], mut outlen: usize, s_inc: &mut [u64], r: usize) {\n158\t    let mut ho = 0usize;\n159\t    let mut i = 0usize;\n160\t    while i < outlen && (i as u64) < s_inc[25] {\n161\t        let pos = (r as u64 - s_inc[25] + i as u64) as usize;\n162\t        h[ho + i] = (s_inc[pos >> 3] >> (8 * (pos & 0x07))) as u8;\n163\t        i += 1;\n164\t    }\n165\t    ho += i;\n166\t    outlen -= i;\n167\t    s_inc[25] -= i as u64;\n168\t\n169\t    while outlen > 0 {\n170\t        keccak_f1600_state_permute(s_inc);\n171\t        let mut k = 0usize;\n172\t        while k < outlen && k < r {\n173\t            h[ho + k] = (s_inc[k >> 3] >> (8 * (k & 0x07))) as u8;\n174\t            k += 1;\n175\t        }\n176\t        ho += k;\n177\t        outlen -= k;\n178\t        s_inc[25] = (r - k) as u64;\n179\t    }\n180\t}\n181\t\n182\t// ---- SHAKE-128 ----\n183\tpub fn shake128_absorb(s: &mut [u64], input: &[u8], inlen: usize) {\n184\t    keccak_absorb(s, SHAKE128_RATE, input, inlen, 0x1F);\n185\t}\n186\tpub fn shake128_squeezeblocks(output: &mut [u8], nblocks: usize, s: &mut [u64]) {\n187\t    keccak_squeezeblocks(output, nblocks, s, SHAKE128_RATE);\n188\t}\n189\tpub fn shake128_inc_init(s: &mut [u64]) {\n190\t    keccak_inc_init(s);\n191\t}\n192\tpub fn shake128_inc_absorb(s: &mut [u64], input: &[u8], inlen: usize) {\n193\t    keccak_inc_absorb(s, SHAKE128_RATE, input, inlen);\n194\t}\n195\tpub fn shake128_inc_finalize(s: &mut [u64]) {\n196\t    keccak_inc_finalize(s, SHAKE128_RATE, 0x1F);\n197\t}\n198\tpub fn shake128_inc_squeeze(output: &mut [u8], outlen: usize, s: &mut [u64]) {\n199\t    keccak_inc_squeeze(output, outlen, s, SHAKE128_RATE);\n200\t}\n201\t\n202\t// ---- SHAKE-256 ----\n203\tpub fn shake256_absorb(s: &mut [u64], input: &[u8], inlen: usize) {\n204\t    keccak_absorb(s, SHAKE256_RATE, input, inlen, 0x1F);\n205\t}\n206\tpub fn shake256_squeezeblocks(output: &mut [u8], nblocks: usize, s: &mut [u64]) {\n207\t    keccak_squeezeblocks(output, nblocks, s, SHAKE256_RATE);\n208\t}\n209\tpub fn shake256_inc_init(s: &mut [u64]) {\n210\t    keccak_inc_init(s);\n211\t}\n212\tpub fn shake256_inc_absorb(s: &mut [u64], input: &[u8], inlen: usize) {\n213\t    keccak_inc_absorb(s, SHAKE256_RATE, input, inlen);\n214\t}\n215\tpub fn shake256_inc_finalize(s: &mut [u64]) {\n216\t    keccak_inc_finalize(s, SHAKE256_RATE, 0x1F);\n217\t}\n218\tpub fn shake256_inc_squeeze(output: &mut [u8], outlen: usize, s: &mut [u64]) {\n219\t    keccak_inc_squeeze(output, outlen, s, SHAKE256_RATE);\n220\t}\n221\t\n222\tpub fn shake128(output: &mut [u8], mut outlen: usize, input: &[u8], inlen: usize) {\n223\t    let nblock