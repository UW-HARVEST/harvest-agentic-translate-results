33333333333, 0xCCCCCCCCCCCCCCCC, 2, 4, 6);\n416\t    swapn64(q, 0x3333333333333333, 0xCCCCCCCCCCCCCCCC, 2, 5, 7);\n417\t\n418\t    swapn64(q, 0x0F0F0F0F0F0F0F0F, 0xF0F0F0F0F0F0F0F0, 4, 0, 4);\n419\t    swapn64(q, 0x0F0F0F0F0F0F0F0F, 0xF0F0F0F0F0F0F0F0, 4, 1, 5);\n420\t    swapn64(q, 0x0F0F0F0F0F0F0F0F, 0xF0F0F0F0F0F0F0F0, 4, 2, 6);\n421\t    swapn64(q, 0x0F0F0F0F0F0F0F0F, 0xF0F0F0F0F0F0F0F0, 4, 3, 7);\n422\t}\n423\t\n424\tfn br_aes_ct64_interleave_in(w: &[u32]) -> (u64, u64) {\n425\t    let mut x0 = w[0] as u64;\n426\t    let mut x1 = w[1] as u64;\n427\t    let mut x2 = w[2] as u64;\n428\t    let mut x3 = w[3] as u64;\n429\t    x0 |= x0 << 16;\n430\t    x1 |= x1 << 16;\n431\t    x2 |= x2 << 16;\n432\t    x3 |= x3 << 16;\n433\t    x0 &= 0x0000FFFF0000FFFF;\n434\t    x1 &= 0x0000FFFF0000FFFF;\n435\t    x2 &= 0x0000FFFF0000FFFF;\n436\t    x3 &= 0x0000FFFF0000FFFF;\n437\t    x0 |= x0 << 8;\n438\t    x1 |= x1 << 8;\n439\t    x2 |= x2 << 8;\n440\t    x3 |= x3 << 8;\n441\t    x0 &= 0x00FF00FF00FF00FF;\n442\t    x1 &= 0x00FF00FF00FF00FF;\n443\t    x2 &= 0x00FF00FF00FF00FF;\n444\t    x3 &= 0x00FF00FF00FF00FF;\n445\t    (x0 | (x2 << 8), x1 | (x3 << 8))\n446\t}\n447\t\n448\tfn br_aes_ct64_interleave_out(q0: u64, q1: u64) -> [u32; 4] {\n449\t    let mut x0 = q0 & 0x00FF00FF00FF00FF;\n450\t    let mut x1 = q1 & 0x00FF00FF00FF00FF;\n451\t    let mut x2 = (q0 >> 8) & 0x00FF00FF00FF00FF;\n452\t    let mut x3 = (q1 >> 8) & 0x00FF00FF00FF00FF;\n453\t    x0 |= x0 >> 8;\n454\t    x1 |= x1 >> 8;\n455\t    x2 |= x2 >> 8;\n456\t    x3 |= x3 >> 8;\n457\t    x0 &= 0x0000FFFF0000FFFF;\n458\t    x1 &= 0x0000FFFF0000FFFF;\n459\t    x2 &= 0x0000FFFF0000FFFF;\n460\t    x3 &= 0x0000FFFF0000FFFF;\n461\t    [\n462\t        (x0 as u32) | ((x0 >> 16) as u32),\n463\t        (x1 as u32) | ((x1 >> 16) as u32),\n464\t        (x2 as u32) | ((x2 >> 16) as u32),\n465\t        (x3 as u32) | ((x3 >> 16) as u32),\n466\t    ]\n467\t}\n468\t\n469\tfn add_round_key(q: &mut [u64; 8], sk: &[u64; 8]) {\n470\t    for i in 0..8 {\n471\t        q[i] ^= sk[i];\n472\t    }\n473\t}\n474\t\n475\tfn shift_rows(q: &mut [u64; 8]) {\n476\t    for i in 0..8 {\n477\t        let x = q[i];\n478\t        q[i] = (x & 0x000000000000FFFF)\n479\t            | ((x & 0x00000000FFF00000) >> 4)\n480\t            | ((x & 0x00000000000F0000) << 12)\n481\t            | ((x & 0x0000FF0000000000) >> 8)\n482\t            | ((x & 0x000000FF00000000) << 8)\n483\t            | ((x & 0xF000000000000000) >> 12)\n484\t            | ((x & 0x0FFF000000000000) << 4);\n485\t    }\n486\t}\n487\t\n488\tfn rotr32(x: u64) -> u64 {\n489\t    (x << 32) | (x >> 32)\n490\t}\n491\t\n492\tfn mix_columns(q: &mut [u64; 8]) {\n493\t    let q0 = q[0];\n494\t    let q1 = q[1];\n495\t    let q2 = q[2];\n496\t    let q3 = q[3];\n497\t    let q4 = q[4];\n498\t    let q5 = q[5];\n499\t    let q6 = q[6];\n500\t    let q7 = q[7];\n501\t    let r0 = (q0 >> 16) | (q0 << 48);\n502\t    let r1 = (q1 >> 16) | (q1 << 48);\n503\t    let r2 = (q2 >> 16) | (q2 << 48);\n504\t    let r3 = (q3 >> 16) | (q3 << 48);\n505\t    let r4 = (q4 >> 16) | (q4 << 48);\n506\t    let r5 = (q5 >> 16) | (q5 << 48);\n507\t    let r6 = (q6 >> 16) | (q6 << 48);\n508\t    let r7 = (q7 >> 16) | (q7 << 48);\n509\t\n510\t    q[0] = q7 ^ r7 ^ r0 ^ rotr32(q0 ^ r0);\n511\t    q[1] = q0 ^ r0 ^ q7 ^ r7 ^ r1 ^ rotr32(q1 ^ r1);\n512\t    q[2] = q1 ^ r1 ^ r2 ^ rotr32(q2 ^ r2);\n513\t    q[3] = q2 ^ r2 ^ q7 ^ r7 ^ r3 ^ rotr32(q3 ^ r3);\n514\t    q[4] = q3 ^ r3 ^ q7 ^ r7 ^ r4 ^ rotr32(q4 ^ r4);\n515\t    q[5] = q4 ^ r4 ^ r5 ^ rotr32(q5 ^ r5);\n516\t    q[6] = q5 ^ r5 ^ r6 ^ rotr32(q6 ^ r6);\n517\t    q[7] = q6 ^ r6 ^ r7 ^ rotr32(q7 ^ r7);\n518\t}\n519\t\n520\tfn interleave_constant(out: &mut [u64; 8], inp: &[u8]) {\n521\t    let mut tmp = [0u32; 16];\n522\t    br_range_dec32le(&mut tmp, 16, inp);\n523\t    for i in 0..4 {\n524\t        let (a, b) = br_aes_ct64_interleave_in(&tmp[i << 2..]);\n525\t        out[i] = a;\n526\t        out[i + 4] = b;\n527\t    }\n528\t    br_aes_ct64_ortho(out);\n529\t}\n530\t\n531\tfn interleave_constant32(out: &mut [u32; 8], inp: &[u8]) {\n532\t    for i in 0..4 {\n533\t        out[2 * i] = br_dec32le(&inp[4 * i..]);\n534\t        out[2 * i + 1] = br_dec32le(&inp[4 * i + 16..]);\n535\t    }\n536\t    br_aes_ct_ortho(out);\n537\t}\n538\t\n539\tpub fn tweak_constants(ctx: &mut SpxCtx) {\n540\t    let mut buf = [0u8; 40 * 16];\n541\t\n542\t    ctx.tweaked512_rc64 = HARAKA512_RC64;\n543\t\n544\t    haraka_s(&mut buf, 40 * 16, &ctx.pub_seed, SPX_N as u64, ctx);\n545\t    for i in 0..10 {\n546\t        let mut rc32 = [0u32; 8];\n547\t        interleave_constant32(&mut rc32, &buf[32 * i..]);\n548\t        ctx.tweaked256_rc32[i] = rc32;\n549\t        let mut rc64 = [0u64; 8];\n550\t        interleave_constant(&mut rc64, &buf[64 * i..]);\n551\t        ctx.tweaked512_rc64[i] = rc64;\n552\t    }\n553\t}\n554\t\n555\t/// Applies the 512-bit Haraka permutation to a 64-byte block (by value).\n556\tfn haraka512_perm_bytes(inp: &[u8; 64], ctx: &SpxCtx) -> [u8; 64] {\n557\t    let mut w = [0u32; 16];\n558\t    br_range_dec32le(&mut w, 16, inp);\n559\t    let mut q = [0u64; 8];\n560\t    for i in 0..4 {\n561\t        let (a, b) = br_aes_ct64_interleave_in(&w[i << 2..]);\n562\t        q[i] = a;\n563\t        q[i + 4] = b;\n564\t    }\n565\t    br_aes_ct64_ortho(&mut q);\n566\t\n567\t    for i in 0..5 {\n568\t        for j in 0..2 {\n569\t            br_aes_ct64_bitslice_sbox(&mut q);\n570\t            shift_rows(&mut q);\n571\t            mix_columns(&mut q);\n572\t            add_round_key(&mut q, &ctx.tweaked512_rc64[2 * i + j]);\n573\t        }\n574\t        for j in 0..8 {\n575\t            let t = q[j];\n576\t            q[j] = (t & 0x0001000100010001) << 5\n577\t                | (t & 0x0002000200020002) << 12\n578\t                | (t & 0x0004000400040004) >> 1\n579\t                | (t & 0x0008000800080008) << 6\n580\t                | (t & 0x0020002000200020) << 9\n581\t                | (t & 0x0040004000400040) >> 4\n582\t                | (t & 0x0080008000800080) << 3\n583\t                | (t & 0x2100210021002100) >> 5\n584\t                | (t & 0x0210021002100210) << 2\n585\t                | (t & 0x0800080008000800) << 4\n586\t                | (t & 0x1000100010001000) >> 12\n587\t                | (t & 0x4000400040004000) >> 10\n588\t                | (t & 0x8400840084008400) >> 3;\n589\t        }\n590\t    }\n591\t\n592\t    br_aes_ct64_ortho(&mut q);\n593\t    for i in 0..4 {\n594\t        let outw = br_aes_ct64_interleave_out(q[i], q[i + 4]);\n595\t        w[i << 2] = outw[0];\n596\t        w[(i << 2) + 1] = outw[1];\n597\t        w[(i << 2) + 2] = outw[2];\n598\t        w[(i << 2) + 3] = outw[3];\n599\t    }\n600\t    let mut out = [0u8; 64];\n601\t    br_range_enc32le(&mut out, &w, 16);\n602\t    out\n603\t}\n604\t\n605\tpub fn haraka512_perm(out: &mut [u8], inp: &[u8], ctx: &SpxCtx) {\n606\t    let mut ib = [0u8; 64];\n607\t    ib.copy_from_slice(&inp[..64]);\n608\t    let r = haraka512_perm_bytes(&ib, ctx);\n609\t    out[..64].copy_from_slice(&r);\n610\t}\n611\t\n612\tpub fn haraka512(out: &mut [u8], inp: &[u8], ctx: &SpxCtx) {\n613\t    let mut ib = [0u8; 64];\n614\t    ib.copy_from_slice(&inp[..64]);\n615\t    let mut buf = haraka512_perm_bytes(&ib, ctx);\n616\t    for i in 0..64 {\n617\t        buf[i] ^= ib[i];\n618\t    }\n619\t    out[0..8].copy_from_slice(&buf[8..16]);\n620\t    out[8..16].copy_from_slice(&buf[24..32]);\n621\t    out[16..24].copy_from_slice(&buf[32..40]);\n622\t    out[24..32].copy_from_slice(&buf[48..56]);\n623\t}\n624\t\n625\tpub fn haraka256(out: &mut [u8], inp: &[u8], ctx: &SpxCtx) {\n626\t    let mut q = [0u32; 8];\n627\t    for i in 0..4 {\n628\t        q[2 * i] = br_dec32le(&inp[4 * i..]);\n629\t        q[2 * i + 1] = br_dec32le(&inp[4 * i + 16..]);\n630\t    }\n631\t    br_aes_ct_ortho(&mut q);\n632\t\n633\t    for i in 0..5 {\n634\t        for j in 0..2 {\n635\t            br_aes_ct_bitslice_sbox(&mut q);\n636\t            shift_rows32(&mut q);\n637\t            mix_columns32(&mut q);\n638\t            add_round_key32(&mut q, &ctx.tweaked256_rc32[2 * i + j]);\n639\t        }\n640\t        for j in 0..8 {\n641\t            let t = q[j];\n642\t            q[j] = (t & 0x81818181)\n643\t                | (t & 0x02020202) << 1\n644\t                | (t & 0x04040404) << 2\n645\t                | (t & 0x08080808) << 3\n646\t                | (t & 0x10101010) >> 3\n647\t                | (t & 0x20202020) >> 2\n648\t                | (t & 0x40404040) >> 1;\n649\t        }\n650\t    }\n651\t\n652\t    br_aes_ct_ortho(&mut q);\n653\t    for i in 0..4 {\n654\t        br_enc32le(&mut out[4 * i..], q[2 * i]);\n655\t        br_enc32le(&mut out[4 * i + 16..], q[2 * i + 1]);\n656\t    }\n657\t\n658\t    for i in 0..32 {\n659\t        out[i] ^= inp[i];\n660\t    }\n661\t}\n662\t\n663\tfn haraka_s_absorb(s: &mut [u8; 64], r: usize, mut m: &[u8], mut mlen: usize, p: u8, ctx: &SpxCtx) {\n664\t    let mut t = vec![0u8; r];\n665\t    while mlen >= r {\n666\t        for i in 0..r {\n667\t            s[i] ^= m[i];\n668\t        }\n669\t        let perm = haraka512_perm_bytes(s, ctx);\n670\t        *s = perm;\n671\t        mlen -= r;\n672\t        m = &m[r..];\n673\t    }\n674\t    for i in 0..r {\n675\t        t[i] = 0;\n676\t    }\n677\t    for i in 0..mlen {\n678\t        t[i] = m[i];\n679\t    }\n680\t    t[mlen] = p;\n681\t    t[r - 1] |= 128;\n682\t    for i in 0..r {\n683\t        s[i] ^= t[i];\n684\t    }\n685\t}\n686\t\n687\tfn haraka_s_squeezeblocks(h: &mut [u8], mut nblocks: usize, s: &mut [u8; 64], r: usize, ctx: &SpxCtx) {\n688\t    let mut ho = 0usize;\n689\t    while nblocks > 0 {\n690\t        let perm = haraka512_perm_bytes(s, ctx);\n691\t        *s = perm;\n692\t        h[ho..ho + HARAKAS_RATE].copy_from_slice(&s[..HARAKAS_RATE]);\n693\t        ho += r;\n694\t        nblocks -= 1;\n695\t    }\n696\t}\n697\t\n698\tpub fn haraka_s_inc_init(s_inc: &mut [u8]) {\n699\t    for i in 0..65 {\n700\t        s_inc[i] = 0;\n701\t    }\n702\t}\n703\t\n704\tpub fn haraka_s_inc_absorb(s_inc: &mut [u8], mut m: &[u8], mut mlen: usize, ctx: &SpxCtx) {\n705\t    while mlen + s_inc[64] as usize >= HARAKAS_RATE {\n706\t        let cnt = HARAKAS_RATE - s_inc[64] as usize;\n707\t        for i in 0..cnt {\n708\t            let pos = s_inc[64] as usize + i;\n709\t            s_inc[pos] ^= m[i];\n710\t        }\n711\t        mlen -= cnt;\n712\t        m = &m[cnt..];\n713\t        s_inc[64] = 0;\n714\t        let mut st = [0u8; 64];\n715\t        st.copy_from_slice(&s_inc[..64]);\n716\t        let perm = haraka512_perm_bytes(&st, ctx);\n717\t        s_inc[..64].copy_from_slice(&perm);\n718\t    }\n719\t    for i in 0..mlen {\n720\t        let pos = s_inc[64] as usize + i;\n721\t        s_inc[pos] ^= m[i];\n722\t    }\n723\t    s_inc[64] = s_inc[64].wrapping_add(mlen as u8);\n724\t}\n725\t\n726\tpub fn haraka_s_inc_finalize(s_inc: &mut [u8]) {\n727\t    let pos = s_inc[64] as usize;\n728\t    s_inc[pos] ^= 0x1F;\n729\t    s_inc[HARAKAS_RATE - 1] ^= 128;\n730\t    s_inc[64] = 0;\n731\t}\n732\t\n733\tpub fn haraka_s_inc_squeeze(out: &mut [u8], mut outlen: usize, s_inc: &mut [u8], ctx: &SpxCtx) {\n734\t    let mut oo = 0usize;\n735\t    let mut i = 0usize;\n736\t    while i < outlen && i < s_inc[64] as usize {\n737\t        out[oo + i] = s_inc[HARAKAS_RATE - s_inc[64] as usize + i];\n738\t        i += 1;\n739\t    }\n740\t    oo += i;\n741\t    outlen -= i;\n742\t    s_inc[64] = s_inc[64].wrapping_sub(i as u8);\n743\t\n744\t    while outlen > 0 {\n745\t        let mut st = [0u8; 64];\n746\t        st.copy_from_slice(&s_inc[..64]);\n747\t        let perm = haraka512_perm_bytes(&st, ctx);\n748\t        s_inc[..64].copy_from_slice(&perm);\n749\t\n750\t        let mut k = 0usize;\n751\t        while k < outlen && k < HARAKAS_RATE {\n752\t            out[oo + k] = s_inc[k];\n753\t            k += 1;\n754\t        }\n755\t        oo += k;\n756\t        outlen -= k;\n757\t        s_inc[64] = (HARA