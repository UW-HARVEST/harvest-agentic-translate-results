ta = &data[128..];\n170\t        datalen -= 1024;\n171\t    }\n172\t\n173\t    if datalen > 0 {\n174\t        let nbytes = ((datalen >> 3) & 0x7F) as usize;\n175\t        state.buf[left..left + nbytes].copy_from_slice(&data[..nbytes]);\n176\t        state.buflen = (((left as u64) << 3) as i32) + datalen as i32;\n177\t    } else {\n178\t        state.buflen = 0;\n179\t    }\n180\t}\n181\t\n182\tpub fn blake512_final(state: &mut BlakeState512, digest: &mut [u8]) {\n183\t    let mut msglen = [0u8; 16];\n184\t    let zo: u8 = 0x01;\n185\t    let oo: u8 = 0x81;\n186\t    let lo = state.t[0].wrapping_add(state.buflen as u64);\n187\t    let mut hi = state.t[1];\n188\t    if lo < state.buflen as u64 {\n189\t        hi = hi.wrapping_add(1);\n190\t    }\n191\t    u64to8(&mut msglen[0..], hi);\n192\t    u64to8(&mut msglen[8..], lo);\n193\t\n194\t    if state.buflen == 888 {\n195\t        state.t[0] = state.t[0].wrapping_sub(8);\n196\t        blake512_update(state, &[oo], 8);\n197\t    } else {\n198\t        if state.buflen < 888 {\n199\t            if state.buflen == 0 {\n200\t                state.nullt = 1;\n201\t            }\n202\t            state.t[0] = state.t[0].wrapping_sub((888 - state.buflen) as u64);\n203\t            let pad = &PADDING[..((888 - state.buflen) as usize) >> 3];\n204\t            blake512_update(state, pad, (888 - state.buflen) as u64);\n205\t        } else {\n206\t            state.t[0] = state.t[0].wrapping_sub((1024 - state.buflen) as u64);\n207\t            let pad = &PADDING[..((1024 - state.buflen) as usize) >> 3];\n208\t            blake512_update(state, pad, (1024 - state.buflen) as u64);\n209\t            state.t[0] = state.t[0].wrapping_sub(888);\n210\t            blake512_update(state, &PADDING[1..1 + (888 >> 3)], 888);\n211\t            state.nullt = 1;\n212\t        }\n213\t        blake512_update(state, &[zo], 8);\n214\t        state.t[0] = state.t[0].wrapping_sub(8);\n215\t    }\n216\t    state.t[0] = state.t[0].wrapping_sub(128);\n217\t    blake512_update(state, &msglen, 128);\n218\t\n219\t    u64to8(&mut digest[0..], state.h[0]);\n220\t    u64to8(&mut digest[8..], state.h[1]);\n221\t    u64to8(&mut digest[16..], state.h[2]);\n222\t    u64to8(&mut digest[24..], state.h[3]);\n223\t    u64to8(&mut digest[32..], state.h[4]);\n224\t    u64to8(&mut digest[40..], state.h[5]);\n225\t    u64to8(&mut digest[48..], state.h[6]);\n226\t    u64to8(&mut digest[56..], state.h[7]);\n227\t}\n228\t\n229\tconst fn make_padding() -> [u8; 129] {\n230\t    let mut a = [0u8; 129];\n231\t    a[0] = 0x80;\n232\t    a\n233\t}\n234\tconst PADDING: [u8; 129] = make_padding();\n235\t\n236\tpub fn blake512(out: &mut [u8], inp: &[u8], inlen: u64) -> i32 {\n237\t    let mut s = BlakeState512::new();\n238\t    blake512_init(&mut s);\n239\t    blake512_update(&mut s, inp, inlen * 8);\n240\t    blake512_final(&mut s, out);\n241\t    0\n242\t}\n243\t\n244\tpub fn blake512_mgf1(out: &mut [u8], outlen: usize, inp: &[u8], inlen: usize) {\n245\t    let mut inbuf = vec![0u8; inlen + 4];\n246\t    let mut outbuf = [0u8; SPX_BLAKE512_OUTPUT_BYTES];\n247\t    inbuf[..inlen].copy_from_slice(&inp[..inlen]);\n248\t\n249\t    let mut i: usize = 0;\n250\t    let mut o = 0usize;\n251\t    while (i + 1) * SPX_BLAKE512_OUTPUT_BYTES <= outlen {\n252\t        u32_to_bytes(&mut inbuf[inlen..], i as u32);\n253\t        blake512(&mut out[o..o + SPX_BLAKE512_OUTPUT_BYTES], &inbuf, (inlen + 4) as u64);\n254\t        o += SPX_BLAKE512_OUTPUT_BYTES;\n255\t        i += 1;\n256\t    }\n257\t    if outlen > i * SPX_BLAKE512_OUTPUT_BYTES {\n258\t        u32_to_bytes(&mut inbuf[inlen..], i as u32);\n259\t        blake512(&mut outbuf, &inbuf, (inlen + 4) as u64);\n260\t        out[o..outlen].copy_from_slice(&outbuf[..outlen - i * SPX_BLAKE512_OUTPUT_BYTES]);\n261\t    }\n262\t}\n263\t\n264\t// ------------------------------------------------------------------\n265\t// Exported C ABI wrappers.\n266\t// ------------------------------------------------------------------\n267\t\n268\t#[export_name = \"blake512\"]\n269\tpub unsafe extern \"C\" fn c_blake512(out: *mut u8, inp: *const u8, inlen: core::ffi::c_ulonglong) -> core::ffi::c_int {\n270\t    let o = core::slice::from_raw_parts_mut(out, 64);\n271\t    let i = core::slice::from_raw_parts(inp, inlen as usize);\n272\t    blake512(o, i, inlen)\n273\t}\n274\t#[export_name = \"blake512_init\"]\n275\tpub unsafe extern \"C\" fn c_blake512_init(s: *mut BlakeState512) {\n276\t    blake512_init(&mut *s);\n277\t}\n278\t#[export_name = \"blake512_compress\"]\n279\tpub unsafe extern \"C\" fn c_blake512_compress(s: *mut BlakeState512, block: *const u8) {\n280\t    blake512_compress(&mut *s, core::slice::from_raw_parts(block, 128));\n281\t}\n282\t#[export_name = \"blake512_update\"]\n283\tpub unsafe extern \"C\" fn c_blake512_update(s: *mut BlakeState512, inp: *const u8, inlen: core::ffi::c_ulonglong) {\n284\t    let nbytes = (inlen >> 3) as usize;\n285\t    let data = core::slice::from_raw_parts(inp, nbytes);\n286\t    blake512_update(&mut *s, data, inlen);\n287\t}\n288\t#[export_name = \"blake512_final\"]\n289\tpub unsafe extern \"C\" fn c_blake512_final(s: *mut BlakeState512, out: *mut u8) {\n290\t    blake512_final(&mut *s, core::slice::from_raw_parts_mut(out, 64));\n291\t}\n292\t#[no_mangle]\n293\tpub unsafe extern \"C\" fn SPX_blake512_mgf1(out: *mut u8, outlen: core::ffi::c_ulong, inp: *const u8, inlen: core::ffi::c_ulong) {\n294\t    let o = core::slice::from_raw_parts_mut(out, outlen as usize);\n295\t    let i = core::slice::from_raw_parts(inp, inlen as usize);\n296\t    blake512_mgf1(o, outlen as usize, i, inlen as usize);\n297\t}\n298\t\n299\t\n300\t"}]},"parent_tool_use_id":"toolu_bdrk_018TT8uC2xSZx4nh56V9gCG6","session_id":"6db5455e-f768-477c-9943-e81d8027edae","uuid":"0842f945-77fc-4559-a367-e79c98e5dee9","timestamp":"2026-08-29T00:28:16.446Z","subagent_type":"general-purpose","task_description":"Review haraka+blake+core translations"}
