] ^= m[i];\n790\t    }\n791\t    s_inc[64] += (uint8_t)mlen;\n792\t}\n793\t\n794\tvoid haraka_S_inc_finalize(uint8_t *s_inc)\n795\t{\n796\t    /* After haraka_S_inc_absorb, we are guaranteed that s_inc[64] < HARAKAS_RATE,\n797\t       so we can always use one more byte for p in the current state. */\n798\t    s_inc[s_inc[64]] ^= 0x1F;\n799\t    s_inc[HARAKAS_RATE - 1] ^= 128;\n800\t    s_inc[64] = 0;\n801\t}\n802\t\n803\tvoid haraka_S_inc_squeeze(uint8_t *out, size_t outlen, uint8_t *s_inc,\n804\t        const spx_ctx *ctx)\n805\t{\n806\t    size_t i;\n807\t\n808\t    /* First consume any bytes we still have sitting around */\n809\t    for (i = 0; i < outlen && i < s_inc[64]; i++) {\n810\t        /* There are s_inc[64] bytes left, so r - s_inc[64] is the first\n811\t           available byte. We consume from there, i.e., up to r. */\n812\t        out[i] = (uint8_t)s_inc[(HARAKAS_RATE - s_inc[64] + i)];\n813\t    }\n814\t    out += i;\n815\t    outlen -= i;\n816\t    s_inc[64] -= (uint8_t)i;\n817\t\n818\t    /* Then squeeze the remaining necessary blocks */\n819\t    while (outlen > 0) {\n820\t        haraka512_perm(s_inc, s_inc, ctx);\n821\t\n822\t        for (i = 0; i < outlen && i < HARAKAS_RATE; i++) {\n823\t            out[i] = s_inc[i];\n824\t        }\n825\t        out += i;\n826\t        outlen -= i;\n827\t        s_inc[64] = (uint8_t)(HARAKAS_RATE - i);\n828\t    }\n829\t}\n830\t\n831\tvoid haraka_S(unsigned char *out, unsigned long long outlen,\n832\t              const unsigned char *in, unsigned long long inlen,\n833\t              const spx_ctx *ctx)\n834\t{\n835\t    unsigned long long i;\n836\t    unsigned char s[64];\n837\t    unsigned char d[32];\n838\t\n839\t    for (i = 0; i < 64; i++) {\n840\t        s[i] = 0;\n841\t    }\n842\t    haraka_S_absorb(s, 32, in, inlen, 0x1F, ctx);\n843\t\n844\t    haraka_S_squeezeblocks(out, outlen / 32, s, 32, ctx);\n845\t    out += (outlen / 32) * 32;\n846\t\n847\t    if (outlen % 32) {\n848\t        haraka_S_squeez