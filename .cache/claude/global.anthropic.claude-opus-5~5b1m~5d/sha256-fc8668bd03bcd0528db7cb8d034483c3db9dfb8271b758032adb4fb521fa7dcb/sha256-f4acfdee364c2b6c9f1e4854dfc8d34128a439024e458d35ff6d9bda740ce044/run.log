{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_019ewvZMuRsFxGswYgT2chLJ","type":"tool_result","content":"1\t//! Translation of `lib/sha2/src/sha2.c`.\n2\t//!\n3\t//! The incremental state layout matches the C code exactly (8 hash words in\n4\t//! big-endian order followed by an 8-byte big-endian byte counter), so the\n5\t//! precomputed midstate reuse in `thash`/`prf_addr` behaves identically. The\n6\t//! compression function itself is standard SHA-256/512.\n7\t\n8\tuse crate::context::SpxCtx;\n9\tuse crate::params::{SPX_N, SPX_SHA512};\n10\tuse crate::utils::u32_to_bytes;\n11\t\n12\tpub const SPX_SHA256_BLOCK_BYTES: usize = 64;\n13\tpub const SPX_SHA256_OUTPUT_BYTES: usize = 32;\n14\tpub const SPX_SHA512_BLOCK_BYTES: usize = 128;\n15\tpub const SPX_SHA512_OUTPUT_BYTES: usize = 64;\n16\t\n17\tfn load_be64(x: &[u8]) -> u64 {\n18\t    ((x[0] as u64) << 56)\n19\t        | ((x[1] as u64) << 48)\n20\t        | ((x[2] as u64) << 40)\n21\t        | ((x[3] as u64) << 32)\n22\t        | ((x[4] as u64) << 24)\n23\t        | ((x[5] as u64) << 16)\n24\t        | ((x[6] as u64) << 8)\n25\t        | (x[7] as u64)\n26\t}\n27\t\n28\tfn store_be64(x: &mut [u8], u: u64) {\n29\t    x[0] = (u >> 56) as u8;\n30\t    x[1] = (u >> 48) as u8;\n31\t    x[2] = (u >> 40) as u8;\n32\t    x[3] = (u >> 32) as u8;\n33\t    x[4] = (u >> 24) as u8;\n34\t    x[5] = (u >> 16) as u8;\n35\t    x[6] = (u >> 8) as u8;\n36\t    x[7] = u as u8;\n37\t}\n38\t\n39\tfn load_be32(x: &[u8]) -> u32 {\n40\t    ((x[0] as u32) << 24) | ((x[1] as u32) << 16) | ((x[2] as u32) << 8) | (x[3] as u32)\n41\t}\n42\t\n43\tfn store_be32(x: &mut [u8], u: u32) {\n44\t    x[0] = (u >> 24) as u8;\n45\t    x[1] = (u >> 16) as u8;\n46\t    x[2] = (u >> 8) as u8;\n47\t    x[3] = u as u8;\n48\t}\n49\t\n50\tconst K256: [u32; 64] = [\n51\t    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,\n52\t    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 