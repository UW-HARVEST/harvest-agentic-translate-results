x3 &= (uint64_t)0x0000FFFF0000FFFF;\n606\t    w[0] = (uint32_t)x0 | (uint32_t)(x0 >> 16);\n607\t    w[1] = (uint32_t)x1 | (uint32_t)(x1 >> 16);\n608\t    w[2] = (uint32_t)x2 | (uint32_t)(x2 >> 16);\n609\t    w[3] = (uint32_t)x3 | (uint32_t)(x3 >> 16);\n610\t}\n611\t\n612\tstatic inline void add_round_key(uint64_t *q, const uint64_t *sk)\n613\t{\n614\t    q[0] ^= sk[0];\n615\t    q[1] ^= sk[1];\n616\t    q[2] ^= sk[2];\n617\t    q[3] ^= sk[3];\n618\t    q[4] ^= sk[4];\n619\t    q[5] ^= sk[5];\n620\t    q[6] ^= sk[6];\n621\t    q[7] ^= sk[7];\n622\t}\n623\t\n624\tstatic inline void shift_rows(uint64_t *q)\n625\t{\n626\t    int i;\n627\t\n628\t    for (i = 0; i < 8; i++) {\n629\t        uint64_t x;\n630\t\n631\t        x = q[i];\n632\t        q[i] = (x & (uint64_t)0x000000000000FFFF)\n633\t               | ((x & (uint64_t)0x00000000FFF00000) >> 4)\n634\t               | ((x & (uint64_t)0x00000000000F0000) << 12)\n635\t               | ((x & (uint64_t)0x0000FF0000000000) >> 8)\n636\t               | ((x & (uint64_t)0x000000FF00000000) << 8)\n637\t               | ((x & (uint64_t)0xF000000000000000) >> 12)\n638\t               | ((x & (uint64_t)0x0FFF000000000000) << 4);\n639\t    }\n640\t}\n641\t\n642\tstatic inline uint64_t rotr32(uint64_t x)\n643\t{\n644\t    return (x << 32) | (x >> 32);\n645\t}\n646\t\n647\tstatic inline void mix_columns(uint64_t *q)\n648\t{\n649\t    uint64_t q0, q1, q2, q3, q4, q5, q6, q7;\n650\t    uint64_t r0, r1, r2, r3, r4, r5, r6, r7;\n651\t\n652\t    q0 = q[0];\n653\t    q1 = q[1];\n654\t    q2 = q[2];\n655\t    q3 = q[3];\n656\t    q4 = q[4];\n657\t    q5 = q[5];\n658\t    q6 = q[6];\n659\t    q7 = q[7];\n660\t    r0 = (q0 >> 16) | (q0 << 48);\n661\t    r1 = (q1 >> 16) | (q1 << 48);\n662\t    r2 = (q2 >> 16) | (q2 << 48);\n663\t    r3 = (q3 >> 16) | (q3 << 48);\n664\t    r4 = (q4 >> 16) | (q4 << 48);\n665\t    r5 = (q5 >> 16) | (q5 << 48);\n666\t    r6 = (q6 >> 16) | (q6 << 48);\n667\t    r7 = (q7 >> 16) | (q7 << 48);\n668\t\n669\t    q[0] 