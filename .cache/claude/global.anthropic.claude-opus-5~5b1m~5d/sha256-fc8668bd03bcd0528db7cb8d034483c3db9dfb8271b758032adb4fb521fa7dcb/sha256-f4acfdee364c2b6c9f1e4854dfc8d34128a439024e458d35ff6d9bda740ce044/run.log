s[1]^cst[1],s[2]^cst[2],s[3]^cst[3],cst[4],cst[5],cst[6],cst[7]]\n        if nullt==0:\n            v[12]^=t[0]; v[13]^=t[0]; v[14]^=t[1]; v[15]^=t[1]\n        return v\n    def c_version(h,s,t,nullt,m):\n        v=init(h,s,t,nullt)\n        cur={\"v%d\"%k:v[k] for k in range(16)}\n        for r in rounds:\n            args=r.split(',')\n            loc=dict(cur)\n            for k in range(16):\n                loc[\"m%d\"%k]=m[int(args[2*k][1:])]\n                loc[\"c%d\"%k]=cst[int(re.match(r'cst\\[(\\d+)\\]',args[2*k+1]).group(1))]\n            exec(roundbody, {\"rot\":rot,\"M\":M}, loc)\n            for k in range(16): cur[\"v%d\"%k]=loc[\"v%d\"%k]\n        v=[cur[\"v%d\"%k] for k in range(16)]\n        return [(h[k]^v[k]^v[k+8]^s[k&3])&M for k in range(8)]\n    r1,r2,r3,r4=rots\n    def gfun(v,m,sr,a,b,c,d,e):\n        v[a]=(v[a]+(m[sr[e]]^cst[sr[e+1]])+v[b])&M\n        v[d]=rot(v[d]^v[a],r1); v[c]=(v[c]+v[d])&M; v[b]=rot(v[b]^v[c],r2)\n        v[a]=(v[a]+(m[sr[e+1]]^cst[sr[e]])+v[b])&M\n        v[d]=rot(v[d]^v[a],r3); v[c]=(v[c]+v[d])&M; v[b]=rot(v[b]^v[c],r4)\n    def rust_version(h,s,t,nullt,m):\n        v=init(h,s,t,nullt)\n        for r in range(nrounds):\n            sr=SIGMA[r%10]\n            for a,b,c,d,e in ((0,4,8,12,0),(1,5,9,13,2),(2,6,10,14,4),(3,7,11,15,6),\n                              (0,5,10,15,8),(1,6,11,12,10),(2,7,8,13,12),(3,4,9,14,14)):\n                gfun(v,m,sr,a,b,c,d,e)\n        return [(h[k]^v[k]^v[k+8]^s[k&3])&M for k in range(8)]\n    random.seed(7); ok=True\n    for trial in range(6):\n        h=[random.getrandbits(bits) for _ in range(8)]\n        s=[random.getrandbits(bits) for _ in range(4)]\n        t=[random.getrandbits(bits) for _ in range(2)]\n        m=[random.getrandbits(bits) for _ in range(16)]\n        for nullt in (0,1):\n            if c_version(h,s,t,nullt,m)!=rust_version(h,s,t,nullt,m):\n                ok=False; print(\"MISMATCH\", cfile, trial, nullt)\n    print(cfile, \"compress equivalence:\", \"OK\" if