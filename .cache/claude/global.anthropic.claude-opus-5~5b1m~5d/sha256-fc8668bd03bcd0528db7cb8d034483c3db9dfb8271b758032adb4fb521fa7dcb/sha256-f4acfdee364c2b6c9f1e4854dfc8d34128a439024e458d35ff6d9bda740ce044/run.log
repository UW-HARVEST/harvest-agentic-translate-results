{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_019kt8mnZ8jTJkJLVe3f4Siu","type":"tool_result","content":"1\t//! Translation of `lib/sha2/src/hash_sha2.c`.\n2\t\n3\tuse crate::address::addr_bytes;\n4\tuse crate::context::SpxCtx;\n5\tuse crate::params::*;\n6\tuse crate::sha2::{\n7\t    sha256_inc_finalize, SPX_SHA256_OUTPUT_BYTES,\n8\t};\n9\tuse crate::utils::bytes_to_ull;\n10\t\n11\tconst SPX_SHA256_ADDR_BYTES: usize = 22;\n12\t\n13\t// Select the \"SHA-X\" primitive family (SHA-512 for N >= 24, else SHA-256).\n14\t#[cfg(spx_sha512)]\n15\tmod shax {\n16\t    pub use crate::sha2::{\n17\t        mgf1_512 as mgf1_x, sha512 as shax, sha512_inc_blocks as shax_inc_blocks,\n18\t        sha512_inc_finalize as shax_inc_finalize, sha512_inc_init as shax_inc_init,\n19\t    };\n20\t    pub const OUT: usize = 64;\n21\t    pub const BLOCK: usize = 128;\n22\t    pub const STATE: usize = 72;\n23\t}\n24\t#[cfg(not(spx_sha512))]\n25\tmod shax {\n26\t    pub use crate::sha2::{\n27\t        mgf1_256 as mgf1_x, sha256 as shax, sha256_inc_blocks as shax_inc_blocks,\n28\t        sha256_inc_finalize as shax_inc_finalize, sha256_inc_init as shax_inc_init,\n29\t    };\n30\t    pub const OUT: usize = 32;\n31\t    pub const BLOCK: usize = 64;\n32\t    pub const STATE: usize = 40;\n33\t}\n34\t\n35\tpub fn initialize_hash_function(ctx: &mut SpxCtx) {\n36\t    crate::sha2::seed_state(ctx);\n37\t}\n38\t\n39\t/// Computes PRF(pk_seed, sk_seed, addr). Always uses SHA-256.\n40\tpub fn prf_addr(out: &mut [u8], ctx: &SpxCtx, addr: &[u32; 8]) {\n41\t    let mut sha2_state = [0u8; 40];\n42\t    let mut buf = [0u8; SPX_SHA256_ADDR_BYTES + SPX_N];\n43\t    let mut outbuf = [0u8; SPX_SHA256_OUTPUT_BYTES];\n44\t\n45\t    sha2_state.copy_from_slice(&ctx.state_seeded);\n46\t\n47\t    let ab = addr_bytes(addr);\n48\t    buf[..SPX_SHA256_ADDR_BYTES].copy_from_slice(&ab[..SPX_SHA256_ADDR_BYTES]);\n49\t    buf[SPX_SHA256_ADDR_BYTES..SPX_SHA256_ADDR_BYTES + SPX_N].copy_from_slice(&ctx.sk_seed);\n50\t\n51\t    sha256_inc_finalize(&mut outbuf, &mut sha2_state, &buf, SPX_SHA256_ADDR_BYTES + SPX_N);\n52\t    out[..SPX_N].copy_from_slice(&outbuf[..SPX_N]);\n53\t}\n54\t\n55\t/// Computes the message-dependent randomness R (HMAC-SHA-X construction).\n56\tpub fn gen_message_random(\n57\t    r: &mut [u8],\n58\t    sk_prf: &[u8],\n59\t    optrand: &[u8],\n60\t    m: &[u8],\n61\t    _ctx: &SpxCtx,\n62\t) {\n63\t    use shax::*;\n64\t    let mut buf = [0u8; BLOCK + OUT];\n65\t    let mut state = [0u8; STATE];\n66\t    let mlen = m.len();\n67\t\n68\t    for i in 0..SPX_N {\n69\t        buf[i] = 0x36 ^ sk_prf[i];\n70\t    }\n71\t    for i in SPX_N..BLOCK {\n72\t        buf[i] = 0x36;\n73\t    }\n74\t\n75\t    shax_inc_init(&mut state);\n76\t    shax_inc_blocks(&mut state, &buf, 1);\n77\t\n78\t    buf[..SPX_N].copy_from_slice(&optrand[..SPX_N]);\n79\t\n80\t    if SPX_N + mlen < BLOCK {\n81\t        buf[SPX_N..SPX_N + mlen].copy_from_slice(&m[..mlen]);\n82\t        let (head, tail) = buf.split_at_mut(BLOCK);\n83\t        shax_inc_finalize(&mut tail[..OUT], &mut state, &head[..mlen + SPX_N], mlen + SPX_N);\n84\t    } else {\n85\t        buf[SPX_N..BLOCK].copy_from_slice(&m[..BLOCK - SPX_N]);\n86\t        shax_inc_blocks(&mut state, &buf, 1);\n87\t        let m2 = &m[BLOCK - SPX_N..];\n88\t        let mlen2 = mlen - (BLOCK - SPX_N);\n89\t        let (_head, tail) = buf.split_at_mut(BLOCK);\n90\t        shax_inc_finalize(&mut tail[..OUT], &mut state, m2, mlen2);\n91\t    }\n92\t\n93\t    for i in 0..SPX_N {\n94\t        buf[i] = 0x5c ^ sk_prf[i];\n95\t    }\n96\t    for i in SPX_N..BLOCK {\n97\t        buf[i] = 0x5c;\n98\t    }\n99\t\n100\t    let tmp = buf;\n101\t    shax(&mut buf, &tmp, BLOCK + OUT);\n102\t    r[..SPX_N].copy_from_slice(&buf[..SPX_N]);\n103\t}\n104\t\n105\tconst INBLOCKS: usize =\n106\t    ((SPX_N + SPX_PK_BYTES + shax::BLOCK - 1) & !(shax::BLOCK - 1)) / shax::BLOCK;\n107\t\n108\t/// Computes the message hash and splits it into tree/leaf indices.\n109\tpub fn hash_message(\n110\t    digest: &mut [u8],\n111\t    tree: &mut u64,\n112\t    leaf_idx: &mut u32,\n113\t    r: &[u8],\n114\t    pk: &[u8],\n115\t    m: &[u8],\n116\t    _ctx: &SpxCtx,\n117\t) {\n118\t    use shax::*;\n119\t    let mut seed = [0u8; 2 * SPX_N + OUT];\n120\t    let mut inbuf = [0u8; INBLOCKS * BLOCK];\n121\t    let mut buf = [0u8; SPX_DGST_BYTES];\n122\t    let mut state = [0u8; STATE];\n123\t    let mlen = m.len();\n124\t\n125\t    shax_inc_init(&mut state);\n126\t\n127\t    inbuf[..SPX_N].copy_from_slice(&r[..SPX_N]);\n128\t    inbuf[SPX_N..SPX_N + SPX_PK_BYTES].copy_from_slice(&pk[..SPX_PK_BYTES]);\n129\t\n130\t    if SPX_N + SPX_PK_BYTES + mlen < INBLOCKS * BLOCK {\n131\t        inbuf[SPX_N + SPX_PK_BYTES..SPX_N + SPX_PK_BYTES + mlen].copy_from_slice(&m[..mlen]);\n132\t        shax_inc_finalize(\n133\t            &mut seed[2 * SPX_N..2 * SPX_N + OUT],\n134\t            &mut state,\n135\t            &inbuf,\n136\t            SPX_N + SPX_PK_BYTES + mlen,\n137\t        );\n138\t    } else {\n139\t        let first = INBLOCKS * BLOCK - SPX_N - SPX_PK_BYTES;\n140\t        inbuf[SPX_N + SPX_PK_BYTES..INBLOCKS * BLOCK].copy_from_slice(&m[..first]);\n141\t        shax_inc_blocks(&mut state, &inbuf, INBLOCKS);\n142\t        let m2 = &m[first..];\n143\t        let mlen2 = mlen - first;\n144\t        shax_inc_finalize(&mut seed[2 * SPX_N..2 * SPX_N + OUT], &mut state, m2, mlen2);\n145\t    }\n146\t\n147\t    seed[..SPX_N].copy_from_slice(&r[..SPX_N]);\n148\t    seed[SPX_N..2 * SPX_N].copy_from_slice(&pk[..SPX_N]);\n149\t\n150\t    mgf1_x(&mut buf, SPX_DGST_BYTES, &seed, 2 * SPX_N + OUT);\n151\t\n152\t    digest[..SPX_FORS_MSG_BYTES].copy_from_slice(&buf[..SPX_FORS_MSG_BYTES]);\n153\t    let mut bufp = SPX_FORS_MSG_BYTES;\n154\t\n155\t    if SPX_D == 1 {\n156\t        *tree = 0;\n157\t    } else {\n158\t        *tree = bytes_to_ull(&buf[bufp..], SPX_TREE_BYTES);\n159\t        *tree &= (!0u64) >> (64 - SPX_TREE_BITS);\n160\t    }\n161\t    bufp += SPX_TREE_BYTES;\n162\t\n163\t    *leaf_idx = bytes_to_ull(&buf[bufp..], SPX_LEAF_BYTES) as u32;\n164\t    *leaf_idx &= (!0u32) >> (32 - SPX_LEAF_BITS);\n165\t}\n166\t\n167\t// ------------------------------------------------------------------\n168\t// Exported C ABI wrappers.\n169\t// ------------------------------------------------------------------\n170\t\n171\t#[no_mangle]\n172\tpub unsafe extern \"C\" fn SPX_initialize_hash_function(ctx: *mut SpxCtx) {\n173\t    initialize_hash_function(&mut *ctx);\n174\t}\n175\t\n176\t#[no_mangle]\n177\tpub unsafe extern \"C\" fn SPX_prf_addr(out: *mut u8, ctx: *const SpxCtx, addr: *const u32) {\n178\t    let o = core::slice::from_raw_parts_mut(out, SPX_N);\n179\t    prf_addr(o, &*ctx, &*(addr as *const [u32; 8]));\n180\t}\n181\t\n182\t#[no_mangle]\n183\tpub unsafe extern \"C\" fn SPX_gen_message_random(\n184\t    r: *mut u8,\n185\t    sk_prf: *const u8,\n186\t    optrand: *const u8,\n187\t    m: *const u8,\n188\t    mlen: core::ffi::c_ulonglong,\n189\t    ctx: *const SpxCtx,\n190\t) {\n191\t    let r_s = core::slice::from_raw_parts_mut(r, SPX_N);\n192\t    let sk = core::slice::from_raw_parts(sk_prf, SPX_N);\n193\t    let opt = core::slice::from_raw_parts(optrand, SPX_N);\n194\t    let m_s = core::slice::from_raw_parts(m, mlen as usize);\n195\t    gen_message_random(r_s, sk, opt, m_s, &*ctx);\n196\t}\n197\t\n198\t#[no_mangle]\n199\tpub unsafe extern \"C\" fn SPX_hash_message(\n200\t    digest: *mut u8,\n201\t    tree: *mut u64,\n202\t    leaf_idx: *mut u32,\n203\t    r: *const u8,\n204\t    pk: *const u8,\n205\t    m: *const u8,\n206\t    mlen: core::ffi::c_ulonglong,\n207\t    ctx: *const SpxCtx,\n208\t) {\n209\t    let d = core::slice::from_raw_parts_mut(digest, SPX_FORS_MSG_BYTES);\n210\t    let r_s = core::slice::from_raw_parts(r, SPX_N);\n211\t    let pk_s = core::slice::from_raw_parts(pk, SPX_PK_BYTES);\n212\t    let m_s = core::slice::from_raw_parts(m, mlen as usize);\n213\t    hash_message(d, &mut *tree, &mut *leaf_idx, r_s, pk_s, m_s, &*ctx);\n214\t}\n215\t"}]},"parent_tool_use_id":"toolu_bdrk_01Q8SrE9pL15ifLiS6yGJFGF","session_id":"6db5455e-f768-477c-9943-e81d8027edae","uuid":"e053edaf-0bba-4ad7-87c6-d5006fefe556","timestamp":"2026-08-29T00:25:46.151Z","subagent_type":"general-purpose","task_description":"Review sha2+shake translations"}
