n817\t        outlen,\n818\t        core::slice::from_raw_parts_mut(s_inc, 65),\n819\t        &*ctx,\n820\t    );\n821\t}\n822\t#[no_mangle]\n823\tpub unsafe extern \"C\" fn SPX_haraka_S(\n824\t    out: *mut u8,\n825\t    outlen: core::ffi::c_ulonglong,\n826\t    inp: *const u8,\n827\t    inlen: core::ffi::c_ulonglong,\n828\t    ctx: *const SpxCtx,\n829\t) {\n830\t    haraka_s(\n831\t        core::slice::from_raw_parts_mut(out, outlen as usize),\n832\t        outlen as usize,\n833\t        core::slice::from_raw_parts(inp, inlen as usize),\n834\t        inlen,\n835\t        &*ctx,\n836\t    );\n837\t}\n838\t#[no_mangle]\n839\tpub unsafe extern \"C\" fn SPX_haraka512_perm(out: *mut u8, inp: *const u8, ctx: *const SpxCtx) {\n840\t    haraka512_perm(\n841\t        core::slice::from_raw_parts_mut(out, 64),\n842\t        core::slice::from_raw_parts(inp, 64),\n843\t        &*ctx,\n844\t    );\n845\t}\n846\t#[no_mangle]\n847\tpub unsafe extern \"C\" fn SPX_haraka512(out: *mut u8, inp: *const u8, ctx: *const SpxCtx) {\n848\t    haraka512(\n849\t        core::slice::from_raw_parts_mut(out, 32),\n850\t        core::slice::from_raw_parts(inp, 64),\n851\t        &*ctx,\n852\t    );\n853\t}\n854\t#[no_mangle]\n855\tpub unsafe extern \"C\" fn SPX_haraka256(out: *mut u8, inp: *const u8, ctx: *const SpxCtx) {\n856\t    haraka256(\n857\t        core::slice::from_raw_parts_mut(out, 32),\n858\t        core::slice::from_raw_parts(inp, 32),\n859\t        &*ctx,\n860\t    );\n861\t}\n862\t"}]},"parent_tool_use_id":"toolu_bdrk_018TT8uC2xSZx4nh56V9gCG6","session_id":"6db5455e-f768-477c-9943-e81d8027edae","uuid":"83f95eee-e1de-41f1-ada5-95fd52ced3f6","timestamp":"2026-08-29T00:26:01.424Z","subagent_type":"general-purpose","task_description":"Review haraka+blake+core translations"}
