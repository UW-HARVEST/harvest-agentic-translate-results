, ctx, &fors_pk_addr);\n108\t}\n109\t\n110\t/// Derives the FORS public key from a signature.\n111\tpub fn fors_pk_from_sig(pk: &mut [u8], sig: &[u8], m: &[u8], ctx: &SpxCtx, fors_addr: &[u32; 8]) {\n112\t    let mut indices = [0u32; SPX_FORS_TREES];\n113\t    let mut roots = [0u8; SPX_FORS_TREES * SPX_N];\n114\t    let mut leaf = [0u8; SPX_N];\n115\t    let mut fors_tree_addr = [0u32; 8];\n116\t    let mut fors_pk_addr = [0u32; 8];\n117\t\n118\t    copy_keypair_addr(&mut fors_tree_addr, fors_addr);\n119\t    copy_keypair_addr(&mut fors_pk_addr, fors_addr);\n120\t\n121\t    set_type(&mut fors_tree_addr, SPX_ADDR_TYPE_FORSTREE);\n122\t    set_type(&mut fors_pk_addr, SPX_ADDR_TYPE_FORSPK);\n123\t\n124\t    message_to_indices(&mut indices, m);\n125\t\n126\t    let mut sig_off = 0usize;\n127\t    for i in 0..SPX_FORS_TREES {\n128\t        let idx_offset = (i * (1 << SPX_FORS_HEIGHT)) as u32;\n129\t\n130\t        set_tree_height(&mut fors_tree_addr, 0);\n131\t        set_tree_index(&mut fors_tree_addr, indices[i] + idx_offset);\n132\t\n133\t        fors_sk_to_leaf(&mut leaf, &sig[sig_off..sig_off + SPX_N], ctx, &fors_tree_addr);\n134\t        sig_off += SPX_N;\n135\t\n136\t        let root_off = i * SPX_N;\n137\t        compute_root(\n138\t            &mut roots[root_off..root_off + SPX_N],\n139\t            &leaf,\n140\t            indices[i],\n141\t            idx_offset,\n142\t            &sig[sig_off..],\n143\t            SPX_FORS_HEIGHT as u32,\n144\t            ctx,\n145\t            &mut fors_tree_addr,\n146\t        );\n147\t        sig_off += SPX_N * SPX_FORS_HEIGHT;\n148\t    }\n149\t\n150\t    thash(pk, &roots, SPX_FORS_TREES as u32, ctx, &fors_pk_addr);\n151\t}\n152\t\n153\t// ------------------------------------------------------------------\n154\t// Exported C ABI wrappers.\n155\t// ------------------------------------------------------------------\n156\t\n157\t#[no_mangle]\n158\tpub unsafe extern \"C\" fn SPX_fors_gen_leafx1(\n159\t    leaf: *mut u8,\n160\