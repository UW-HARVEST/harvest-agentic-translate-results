{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01DGVpKZ5Xw64D25FTYtbuze","type":"tool_result","content":"200\t}\n201\t\n202\t// =====================================================================\n203\t// row 48 — sha2\n204\t// =====================================================================\n205\t#[cfg(spx_backend = \"sha2\")]\n206\tmod sha2 {\n207\t    use super::*;\n208\t\n209\t    type FSha = unsafe extern \"C\" fn(*mut u8, *const u8, usize);\n210\t    type FIncInit = unsafe extern \"C\" fn(*mut u8);\n211\t    type FIncBlocks = unsafe extern \"C\" fn(*mut u8, *const u8, usize);\n212\t    type FIncFinal = unsafe extern \"C\" fn(*mut u8, *mut u8, *const u8, usize);\n213\t    type FMgf1 = unsafe extern \"C\" fn(*mut u8, u64, *const u8, u64);\n214\t    type FSeedState = unsafe extern \"C\" fn(*mut u8);\n215\t\n216\t    #[test]\n217\t    fn b48a_sha_oneshot() {\n218\t        let p = pair();\n219\t        let mut rng = Rng::new(SEED ^ 480);\n220\t        unsafe {\n221\t            for (name, outlen) in [(&b\"sha256\\0\"[..], 32usize), (&b\"sha512\\0\"[..], 64)] {\n222\t                let cf = sym!(p.c, name, FSha);\n223\t                let rf = sym!(p.r, name, FSha);\n224\t                for inlen in len_sweep() {\n225\t                    let m = rng.bytes(inlen.max(1));\n226\t                    let mut co = obuf(outlen);\n227\t                    let mut ro = obuf(outlen);\n228\t                    cf(co.as_mut_ptr(), m.as_ptr(), inlen);\n229\t                    rf(ro.as_mut_ptr(), m.as_ptr(), inlen);\n230\t                    eqb(\n231\t                        &format!(\"{} inlen={inlen}\", String::from_utf8_lossy(name)),\n232\t                        &co,\n233\t                        &ro,\n234\t                    );\n235\t                }\n236\t            }\n237\t        }\n238\t    }\n239\t\n240\t    #[test]\n241\t    fn b48b_sha_incremental() {\n242\t        let p = pair();\n243\t        let mut rng = Rng::new(SEED ^ 481);\n244\t        unsafe {\n245\t            for (init, blocks, fin, stlen, blk, outlen) in [\n246\t                (&b\"sha256_inc_init\\0\"[..], &b\"sha256_inc_blocks\\0\"[..], &b\"sha256_inc_finalize\\0\"[..], 40usize, 64usize, 32usize),\n247\t                (&b\"sha512_inc_init\\0\"[..], &b\"sha512_inc_blocks\\0\"[..], &b\"sha512_inc_finalize\\0\"[..], 72, 128, 64),\n248\t            ] {\n249\t                let ci = sym!(p.c, init, FIncInit);\n250\t                let ri = sym!(p.r, init, FIncInit);\n251\t                let cb = sym!(p.c, blocks, FIncBlocks);\n252\t                let rb = sym!(p.r, blocks, FIncBlocks);\n253\t                let cf = sym!(p.c, fin, FIncFinal);\n254\t                let rf = sym!(p.r, fin, FIncFinal);\n255\t\n256\t                for nblocks in [0usize, 1, 2, 3] {\n257\t                    for tail in [0usize, 1, blk - 10, blk - 9, blk - 8, blk - 1, blk, blk + 1, 2 * blk + 3] {\n258\t                        let mut cs = vec![0x33u8; stlen + SLACK];\n259\t                        let mut rs = vec![0x33u8; stlen + SLACK];\n260\t                        ci(cs.as_mut_ptr());\n261\t                        ri(rs.as_mut_ptr());\n262\t                        eqb(\"sha state after init\", &cs, &rs);\n263\t                        if nblocks > 0 {\n264\t                            let m = rng.bytes(nblocks * blk);\n265\t                            cb(cs.as_mut_ptr(), m.as_ptr(), nblocks);\n266\t                            rb(rs.as_mut_ptr(), m.as_ptr(), nblocks);\n267\t                            eqb(&format!(\"sha state after {nblocks} blocks\"), &cs, &rs);\n268\t                        }\n269\t                        let t = rng.bytes(tail.max(1));\n270\t                        let mut co = obuf(outlen);\n271\t                        let mut ro = obuf(outlen);\n272\t                        cf(co.as_mut_ptr(), cs.as_mut_ptr(), t.as_ptr(), tail);\n273\t                        rf(ro.as_mut_ptr(), rs.as_mut_ptr(), t.as_ptr(), tail);\n274\t                        eqb(&format!(\"sha digest nblocks={nblocks} tail={tail}\"), &co, &ro);\n275\t                        eqb(&format!(\"sha state after finalize nblocks={nblocks} tail={tail}\"), &cs, &rs);\n276\t                    }\n277\t                }\n278\t            }\n279\t        }\n280\t    }\n281\t\n282\t    #[test]\n283\t    fn b48c_mgf1_and_seed_state() {\n284\t        let p = pair();\n285\t        let mut rng = Rng::new(SEED ^ 482);\n286\t        unsafe {\n287\t            for name in [&b\"SPX_mgf1_256\\0\"[..], &b\"SPX_mgf1_512\\0\"[..]] {\n288\t                let cf = sym!(p.c, name, FMgf1);\n289\t                let rf = sym!(p.r, name, FMgf1);\n290\t                for inlen in [1usize, 4, 16, 32, 48, 64, 96, 128, 200] {\n291\t                    for outlen in [1usize, 2, 31, 32, 33, 63, 64, 65, 127, 128, 129, 200] {\n292\t                        let m = rng.bytes(inlen);\n293\t                        let mut co = obuf(outlen);\n294\t                        let mut ro = obuf(outlen);\n295\t                        cf(co.as_mut_ptr(), outlen as u64, m.as_ptr(), inlen as u64);\n296\t                        rf(ro.as_mut_ptr(), outlen as u64, m.as_ptr(), inlen as u64);\n297\t                        eqb(\n298\t                            &format!(\"{} in={inlen} out={outlen}\", String::from_utf8_lossy(name)),\n299\t                            &co,\n300\t                            &ro,\n301\t                        );\n302\t                    }\n303\t                }\n304\t            }\n305\t            // seed_state fills ctx->state_seeded(+_512) from pub_seed\n306\t            let cf = sym!(p.c, b\"SPX_seed_state\\0\", FSeedState);\n307\t            let rf = sym!(p.r, b\"SPX_seed_state\\0\", FSeedState);\n308\t            for _ in 0..32 {\n309\t                let ps = rng.bytes(N);\n310\t                let ss = rng.bytes(N);\n311\t                let mut cc = vec![0u8; CTX_BYTES];\n312\t                let mut rc = vec![0u8; CTX_BYTES];\n313\t                cc[..N].copy_from_slice(&ps);\n314\t                cc[N..2 * N].copy_from_slice(&ss);\n315\t                rc.copy_from_slice(&cc);\n316\t                cf(cc.as_mut_ptr());\n317\t                rf(rc.as_mut_ptr());\n318\t                eqb(\"seed_state ctx\", &cc, &rc);\n319\t            }\n320\t        }\n321\t    }\n322\t}\n323\t\n324\t// =====================================================================\n325\t// row 49 — shake\n326\t// =====================================================================\n327\t#[cfg(spx_backend = \"shake\")]\n328\tmod shake {\n329\t    use super::*;\n330\t\n331\t    type FShake = unsafe extern \"C\" fn(*mut u8, usize, *const u8, usize);\n332\t    type FAbsorb = unsafe extern \"C\" fn(*mut u64, *const u8, usize);\n333\t    type FSqueezeBlocks = unsafe extern \"C\" fn(*mut u8, usize, *mut u64);\n334\t    type FIncInit = unsafe extern \"C\" fn(*mut u64);\n335\t    type FIncAbsorb = unsafe extern \"C\" fn(*mut u64, *const u8, usize);\n336\t    type FIncFinalize = unsafe extern \"C\" fn(*mut u64);\n337\t    type FIncSqueeze = unsafe extern \"C\" fn(*mut u8, usize, *mut u64);\n338\t\n339\t    const RATE: usize = 136;\n340\t\n341\t    #[test]\n342\t    fn b49a_shake256_oneshot() {\n343\t        let p = pair();\n344\t        let mut rng = Rng::new(SEED ^ 490);\n345\t        unsafe {\n346\t            let cf = sym!(p.c, b\"shake256\\0\", FShake);\n347\t            let rf = sym!(p.r, b\"shake256\\0\", FShake);\n348\t            for inlen in len_sweep() {\n349\t                for outlen in [0usize, 1, 32, 135, 136, 137, 271, 272, 273] {\n350\t                    let m = rng.bytes(inlen.max(1));\n351\t                    let mut co = obuf(outlen);\n352\t                    let mut ro = obuf(outlen);\n353\t                    cf(co.as_mut_ptr(), outlen, m.as_ptr(), inlen);\n354\t                    rf(ro.as_mut_ptr(), outlen, m.as_ptr(), inlen);\n355\t                    eqb(&format!(\"shake256 in={inlen} out={outlen}\"), &co, &ro);\n356\t                }\n357\t            }\n358\t        }\n359\t    }\n360\t\n361\t    #[test]\n362\t    fn b49b_shake256_absorb_squeeze() {\n363\t        let p = pair();\n364\t        let mut rng = Rng::new(SEED ^ 491);\n365\t        unsafe {\n366\t            let ca = sym!(p.c, b\"shake256_absorb\\0\", FAbsorb);\n367\t            let ra = sym!(p.r, b\"shake256_absorb\\0\", FAbsorb);\n368\t            let cs = sym!(p.c, b\"shake256_squeezeblocks\\0\", FSqueezeBlocks);\n369\t            let rs = sym!(p.r, b\"shake256_squeezeblocks\\0\", FSqueezeBlocks);\n370\t            for inlen in [0usize, 1, 135, 136, 137, 271, 272, 273, 500] {\n371\t                for nblocks in [0usize, 1, 2, 3] {\n372\t                    let m = rng.bytes(inlen.max(1));\n373\t                    let mut cst = vec![0u64; 25 + 8];\n374\t                    let mut rst = vec![0u64; 25 + 8];\n375\t                    ca(cst.as_mut_ptr(), m.as_ptr(), inlen);\n376\t                    ra(rst.as_mut_ptr(), m.as_ptr(), inlen);\n377\t                    eqv(&format!(\"shake256_absorb state in={inlen}\"), &cst, &rst);\n378\t                    let mut co = obuf(nblocks * RATE);\n379\t                    let mut ro = obuf(nblocks * RATE);\n380\t                    cs(co.as_mut_ptr(), nblocks, cst.as_mut_ptr());\n381\t                    rs(ro.as_mut_ptr(), nblocks, rst.as_mut_ptr());\n382\t                    eqb(&format!(\"squeezeblocks out in={inlen} n={nblocks}\"), &co, &ro);\n383\t                    eqv(&format!(\"squeezeblocks state in={inlen} n={nblocks}\"), &cst, &rst);\n384\t                }\n385\t            }\n386\t        }\n387\t    }\n388\t\n389\t    #[test]\n390\t    fn b49c_shake256_incremental() {\n391\t        let p = pair();\n392\t        let mut rng = Rng::new(SEED ^ 492);\n393\t        unsafe {\n394\t            let ci = sym!(p.c, b\"shake256_inc_init\\0\", FIncInit);\n395\t            let ri = sym!(p.r, b\"shake256_inc_init\\0\", FIncInit);\n396\t       