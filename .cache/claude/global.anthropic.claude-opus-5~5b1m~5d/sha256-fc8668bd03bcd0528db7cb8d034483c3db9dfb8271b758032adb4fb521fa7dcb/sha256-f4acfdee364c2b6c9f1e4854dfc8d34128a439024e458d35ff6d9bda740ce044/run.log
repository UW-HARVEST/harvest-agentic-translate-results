          h = g;\n116\t            g = f;\n117\t            f = e;\n118\t            e = d.wrapping_add(t1);\n119\t            d = c;\n120\t            c = b;\n121\t            b = a;\n122\t            a = t1.wrapping_add(t2);\n123\t        }\n124\t        s[0] = s[0].wrapping_add(a);\n125\t        s[1] = s[1].wrapping_add(b);\n126\t        s[2] = s[2].wrapping_add(c);\n127\t        s[3] = s[3].wrapping_add(d);\n128\t        s[4] = s[4].wrapping_add(e);\n129\t        s[5] = s[5].wrapping_add(f);\n130\t        s[6] = s[6].wrapping_add(g);\n131\t        s[7] = s[7].wrapping_add(h);\n132\t        inp = &inp[64..];\n133\t    }\n134\t    for i in 0..8 {\n135\t        store_be32(&mut statebytes[4 * i..], s[i]);\n136\t    }\n137\t}\n138\t\n139\tfn crypto_hashblocks_sha512(statebytes: &mut [u8], mut inp: &[u8]) {\n140\t    let mut s = [0u64; 8];\n141\t    for i in 0..8 {\n142\t        s[i] = load_be64(&statebytes[8 * i..]);\n143\t    }\n144\t    while inp.len() >= 128 {\n145\t        let mut w = [0u64; 80];\n146\t        for i in 0..16 {\n147\t            w[i] = load_be64(&inp[8 * i..]);\n148\t        }\n149\t        for i in 16..80 {\n150\t            let s0 = w[i - 15].rotate_right(1) ^ w[i - 15].rotate_right(8) ^ (w[i - 15] >> 7);\n151\t            let s1 = w[i - 2].rotate_right(19) ^ w[i - 2].rotate_right(61) ^ (w[i - 2] >> 6);\n152\t            w[i] = w[i - 16]\n153\t                .wrapping_add(s0)\n154\t                .wrapping_add(w[i - 7])\n155\t                .wrapping_add(s1);\n156\t        }\n157\t        let (mut a, mut b, mut c, mut d, mut e, mut f, mut g, mut h) =\n158\t            (s[0], s[1], s[2], s[3], s[4], s[5], s[6], s[7]);\n159\t        for i in 0..80 {\n160\t            let big_s1 = e.rotate_right(14) ^ e.rotate_right(18) ^ e.rotate_right(41);\n161\t            let ch = (e & f) ^ ((!e) & g);\n162\t            let t1 = h\n163\t                .wrapping_add(big_s1)\n164\t                .wrapping_add(ch)\n165\t                .wrapping_add(K512[i])\