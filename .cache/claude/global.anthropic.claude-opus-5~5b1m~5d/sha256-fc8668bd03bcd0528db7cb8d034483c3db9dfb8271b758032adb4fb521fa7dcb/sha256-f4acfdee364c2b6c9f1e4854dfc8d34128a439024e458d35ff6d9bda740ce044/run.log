The index is split in\n55\t * the tree index and the leaf index, for convenient copying to an address.\n56\t */\n57\tvoid hash_message(unsigned char *digest, uint64_t *tree, uint32_t *leaf_idx,\n58\t                  const unsigned char *R, const unsigned char *pk,\n59\t                  const unsigned char *m, unsigned long long mlen,\n60\t                  const spx_ctx *ctx)\n61\t{\n62\t#define SPX_TREE_BITS (SPX_TREE_HEIGHT * (SPX_D - 1))\n63\t#define SPX_TREE_BYTES ((SPX_TREE_BITS + 7) / 8)\n64\t#define SPX_LEAF_BITS SPX_TREE_HEIGHT\n65\t#define SPX_LEAF_BYTES ((SPX_LEAF_BITS + 7) / 8)\n66\t#define SPX_DGST_BYTES (SPX_FORS_MSG_BYTES + SPX_TREE_BYTES + SPX_LEAF_BYTES)\n67\t\n68\t    unsigned char buf[SPX_DGST_BYTES];\n69\t    unsigned char *bufp = buf;\n70\t    uint8_t s_inc[65];\n71\t\n72\t    haraka_S_inc_init(s_inc);\n73\t    haraka_S_inc_absorb(s_inc, R, SPX_N, ctx);\n74\t    haraka_S_inc_absorb(s_inc, pk + SPX_N, SPX_N, ctx); // Only absorb root part of pk\n75\t    haraka_S_inc_absorb(s_inc, m, mlen, ctx);\n76\t    haraka_S_inc_finalize(s_inc);\n77\t    haraka_S_inc_squeeze(buf, SPX_DGST_BYTES, s_inc, ctx);\n78\t\n79\t    memcpy(digest, bufp, SPX_FORS_MSG_BYTES);\n80\t    bufp += SPX_FORS_MSG_BYTES;\n81\t\n82\t#if SPX_TREE_BITS > 64\n83\t    #error For given height and depth, 64 bits cannot represent all subtrees\n84\t#endif\n85\t\n86\t    if (SPX_D == 1) {\n87\t\t*tree = 0;\n88\t    } else {\n89\t        *tree = bytes_to_ull(bufp, SPX_TREE_BYTES);\n90\t        *tree &= (~(uint64_t)0) >> (64 - SPX_TREE_BITS);\n91\t    }\n92\t    bufp += SPX_TREE_BYTES;\n93\t\n94\t    *leaf_idx = (uint32_t)bytes_to_ull(bufp, SPX_LEAF_BYTES);\n95\t    *leaf_idx &= (~(uint32_t)0) >> (32 - SPX_LEAF_BITS);\n96\t}\n97\t"}]},"parent_tool_use_id":"toolu_bdrk_018TT8uC2xSZx4nh56V9gCG6","session_id":"6db5455e-f768-477c-9943-e81d8027edae","uuid":"a9d5dae2-ae3c-49db-b5a3-5fe255bf8402","timestamp":"2026-08-29T00:26:31.160Z","subagent_type":"general-purpose","task_description":"Review har