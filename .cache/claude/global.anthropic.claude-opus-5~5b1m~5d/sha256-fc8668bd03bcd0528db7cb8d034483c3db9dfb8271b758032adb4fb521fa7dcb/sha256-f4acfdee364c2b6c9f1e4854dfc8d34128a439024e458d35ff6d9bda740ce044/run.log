s[0]^cst[0],s[1]^cst[1],s[2]^cst[2],s[3]^cst[3],cst[4],cst[5],cst[6],cst[7]]\n    if nullt==0:\n        v[12]^=t[0]; v[13]^=t[0]; v[14]^=t[1]; v[15]^=t[1]\n    g={f\"v{i}\":v[i] for i in range(16)}\n    g.update({\"rot\":rot,\"M\":M})\n    for r in rounds:\n        args=r.split(',')\n        loc=dict(g)\n        for k in range(16):\n            loc[f\"m{k}\"]=m[int(args[2*k][1:])]\n            loc[f\"c{k}\"]=cst[int(re.match(r'cst\\[(\\d+)\\]',args[2*k+1]).group(1))]\n        exec(roundbody, {\"rot\":rot,\"M\":M}, loc)\n        for i in range(16): g[f\"v{i}\"]=loc[f\"v{i}\"]\n    v=[g[f\"v{i}\"] for i in range(16)]\n    return [(h[i]^v[i]^v[i+8]^s[i&3])&M for i in range(8)]\n\ndef gfun(v,m,sr,a,b,c,d,e):\n    v[a]=(v[a]+(m[sr[e]]^cst[sr[e+1]])+v[b])&M\n    v[d]=rot(v[d]^v[a],16)\n    v[c]=(v[c]+v[d])&M\n    v[b]=rot(v[b]^v[c],12)\n    v[a]=(v[a]+(m[sr[e+1]]^cst[sr[e]])+v[b])&M\n    v[d]=rot(v[d]^v[a],8)\n    v[c]=(v[c]+v[d])&M\n    v[b]=rot(v[b]^v[c],7)\n\ndef rust_version(h,s,t,nullt,m):\n    v=list(h)+[s[0]^cst[0],s[1]^cst[1],s[2]^cst[2],s[3]^cst[3],cst[4],cst[5],cst[6],cst[7]]\n    if nullt==0:\n        v[12]^=t[0]; v[13]^=t[0]; v[14]^=t[1]; v[15]^=t[1]\n    for r in range(14):\n        sr=SIGMA[r%10]\n        gfun(v,m,sr,0,4,8,12,0)\n        gfun(v,m,sr,1,5,9,13,2)\n        gfun(v,m,sr,2,6,10,14,4)\n        gfun(v,m,sr,3,7,11,15,6)\n        gfun(v,m,sr,0,5,10,15,8)\n        gfun(v,m,sr,1,6,11,12,10)\n        gfun(v,m,sr,2,7,8,13,12)\n        gfun(v,m,sr,3,4,9,14,14)\n    return [(h[i]^v[i]^v[i+8]^s[i&3])&M for i in range(8)]\n\nrandom.seed(1)\nok=True\nfor trial in range(5):\n    h=[random.getrandbits(32) for _ in range(8)]\n    s=[random.getrandbits(32) for _ in range(4)]\n    t=[random.getrandbits(32) for _ in range(2)]\n    m=[random.getrandbits(32) for _ in range(16)]\n    for nullt in (0,1):\n        a=c_version(h,s,t,nullt,m); b=rust_version(h,s,t,nullt,m)\n        if a!=b:\n            ok=False; print(\"MISMATCH\", trial, nullt, [hex(x) for x in a], [hex(