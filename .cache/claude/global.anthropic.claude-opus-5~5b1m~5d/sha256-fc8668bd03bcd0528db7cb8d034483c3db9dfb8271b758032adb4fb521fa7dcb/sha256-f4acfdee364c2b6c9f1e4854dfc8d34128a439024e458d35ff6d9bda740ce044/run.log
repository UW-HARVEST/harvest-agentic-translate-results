= [0u8; 16];","+    c.buffer_pos = 16;","+    c.buffer = [0u8; 16];","     RNG_SUCCESS"," }"," ","-pub fn seedexpander(ctx: &mut AesXofStruct, x: &mut [u8]) -> i32 {","-    let mut xlen = x.len() as u64;","-    if xlen >= ctx.length_remaining {","+pub unsafe fn seedexpander_impl(ctx: *mut AesXofStruct, x: *mut u8, xlen: u64) -> i32 {","+    if x.is_null() {","+        return RNG_BAD_OUTBUF;","+    }","+    let c = &mut *ctx;","+    if xlen >= c.length_remaining as u64 {","         return RNG_BAD_REQ_LEN;","     }","-    ctx.length_remaining -= xlen;","+    c.length_remaining -= xlen as core::ffi::c_ulong;"," ","+    let mut xlen = xlen;","     let mut offset = 0usize;","     while xlen > 0 {","-        if xlen <= (16 - ctx.buffer_pos) as u64 {","-            x[offset..offset + xlen as usize]","-                .copy_from_slice(&ctx.buffer[ctx.buffer_pos..ctx.buffer_pos + xlen as usize]);","-            ctx.buffer_pos += xlen as usize;","+        let bp = c.buffer_pos as usize;","+        if xlen <= (16u64.wrapping_sub(c.buffer_pos as u64)) {","+            core::ptr::copy_nonoverlapping(","+                c.buffer.as_ptr().add(bp),","+                x.add(offset),","+                xlen as usize,","+            );","+            c.buffer_pos += xlen as core::ffi::c_ulong;","             return RNG_SUCCESS;","         }","-        let avail = 16 - ctx.buffer_pos;","-        x[offset..offset + avail].copy_from_slice(&ctx.buffer[ctx.buffer_pos..16]);","+","+        let avail = 16 - bp;","+        core::ptr::copy_nonoverlapping(c.buffer.as_ptr().add(bp), x.add(offset), avail);","         xlen -= avail as u64;","         offset += avail;"," ","-        let key = ctx.key;","-        let ctr = ctx.ctr;","-        aes256_ecb(&key, &ctr, &mut ctx.buffer);","-        ctx.buffer_pos = 0;","+        let key = c.key;","+        let ctr = c.ctr;","+        aes256_ecb(&key, &ctr, &mut c.buffer);","+        c.buffer_pos = 0;"," ","+        // increment the counter (last 4 bytes 