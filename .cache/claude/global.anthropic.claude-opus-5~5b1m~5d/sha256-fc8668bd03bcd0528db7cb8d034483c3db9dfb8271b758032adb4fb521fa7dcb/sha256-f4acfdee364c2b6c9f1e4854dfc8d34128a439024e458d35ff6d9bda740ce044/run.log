{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_013g1Sw2BBDfm7C5gdxmMmUo","type":"tool_result","content":"1\t//! Translation of `app/src/address.c`.\n2\t//!\n3\t//! Addresses are `uint32_t addr[8]` in C, but every access is performed\n4\t//! through a byte view (`(unsigned char *)addr`). We keep the `[u32; 8]`\n5\t//! representation and manipulate its native-endian bytes, which reproduces the\n6\t//! exact in-memory layout the C code hashes on a little-endian target.\n7\t\n8\tuse crate::params::*;\n9\tuse crate::utils::{u32_to_bytes, ull_to_bytes};\n10\t\n11\t/// View a `[u32; 8]` address as its 32 raw bytes (native endianness).\n12\t#[inline]\n13\tpub fn addr_bytes(addr: &[u32; 8]) -> &[u8; 32] {\n14\t    // Safe: `[u32; 8]` and `[u8; 32]` have identical size; alignment of the\n15\t    // source (4) exceeds that of the destination (1).\n16\t    unsafe { &*(addr.as_ptr() as *const [u8; 32]) }\n17\t}\n18\t\n19\t#[inline]\n20\tfn addr_bytes_mut(addr: &mut [u32; 8]) -> &mut [u8; 32] {\n21\t    unsafe { &mut *(addr.as_mut_ptr() as *mut [u8; 32]) }\n22\t}\n23\t\n24\tpub fn set_layer_addr(addr: &mut [u32; 8], layer: u32) {\n25\t    addr_bytes_mut(addr)[SPX_OFFSET_LAYER] = layer as u8;\n26\t}\n27\t\n28\tpub fn set_tree_addr(addr: &mut [u32; 8], tree: u64) {\n29\t    let b = addr_bytes_mut(addr);\n30\t    ull_to_bytes(&mut b[SPX_OFFSET_TREE..], 8, tree);\n31\t}\n32\t\n33\tpub fn set_type(addr: &mut [u32; 8], t: u32) {\n34\t    addr_bytes_mut(addr)[SPX_OFFSET_TYPE] = t as u8;\n35\t}\n36\t\n37\tpub fn copy_subtree_addr(out: &mut [u32; 8], inp: &[u32; 8]) {\n38\t    let src = addr_bytes(inp);\n39\t    let dst = addr_bytes_mut(out);\n40\t    dst[..SPX_OFFSET_TREE + 8].copy_from_slice(&src[..SPX_OFFSET_TREE + 8]);\n41\t}\n42\t\n43\tpub fn set_keypair_addr(addr: &mut [u32; 8], keypair: u32) {\n44\t    let b = addr_bytes_mut(addr);\n45\t    u32_to_bytes(&mut b[SPX_OFFSET_KP_ADDR..], keypair);\n46\t}\n47\t\n48\tpub fn copy_keypair_addr(out: &mut [u32; 8], inp: &[u32; 8]) {\n49\t    let src = *addr_bytes(inp);\n50\t    let dst = addr_bytes_mut(out);\n51\t    dst[..SPX_OFFSET_TREE + 8].copy_from_slice(&src[..SPX_OFFSET_TREE + 8]);\n52\t    dst[SPX_OFFSET_KP_ADDR..SPX_OFFSET_KP_ADDR + 4]\n53\t        .copy_from_slice(&src[SPX_OFFSET_KP_ADDR..SPX_OFFSET_KP_ADDR + 4]);\n54\t}\n55\t\n56\tpub fn set_chain_addr(addr: &mut [u32; 8], chain: u32) {\n57\t    addr_bytes_mut(addr)[SPX_OFFSET_CHAIN_ADDR] = chain as u8;\n58\t}\n59\t\n60\tpub fn set_hash_addr(addr: &mut [u32; 8], hash: u32) {\n61\t    addr_bytes_mut(addr)[SPX_OFFSET_HASH_ADDR] = hash as u8;\n62\t}\n63\t\n64\tpub fn set_tree_height(addr: &mut [u32; 8], tree_height: u32) {\n65\t    addr_bytes_mut(addr)[SPX_OFFSET_TREE_HGT] = tree_height as u8;\n66\t}\n67\t\n68\tpub fn set_tree_index(addr: &mut [u32; 8], tree_index: u32) {\n69\t    let b = addr_bytes_mut(addr);\n70\t    u32_to_bytes(&mut b[SPX_OFFSET_TREE_INDEX..], tree_index);\n71\t}\n72\t\n73\t// ------------------------------------------------------------------\n74\t// Exported C ABI wrappers (namespaced `SPX_*` linker symbols).\n75\t// ------------------------------------------------------------------\n76\t\n77\tmacro_rules! as_arr8_mut {\n78\t    ($p:expr) => {\n79\t        &mut *($p as *mut [u32; 8])\n80\t    };\n81\t}\n82\tmacro_rules! as_arr8 {\n83\t    ($p:expr) => {\n84\t        &*($p as *const [u32; 8])\n85\t    };\n86\t}\n87\t\n88\t#[no_mangle]\n89\tpub unsafe extern \"C\" fn SPX_set_layer_addr(addr: *mut u32, layer: u32) {\n90\t    set_layer_addr(as_arr8_mut!(addr), layer);\n91\t}\n92\t#[no_mangle]\n93\tpub unsafe extern \"C\" fn SPX_set_tree_addr(addr: *mut u32, tree: u64) {\n94\t    set_tree_addr(as_arr8_mut!(addr), tree);\n95\t}\n96\t#[no_mangle]\n97\tpub unsafe extern \"C\" fn SPX_set_type(addr: *mut u32, t: u32) {\n98\t    set_type(as_arr8_mut!(addr), t);\n99\t}\n100\t#[no_mangle]\n101\tpub unsafe extern \"C\" fn SPX_copy_subtree_addr(out: *mut u32, inp: *const u32) {\n102\t    copy_subtree_addr(as