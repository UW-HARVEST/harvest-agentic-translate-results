{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01AYt4jC4qKPUiKFam5hAZPn","type":"tool_result","content":"1\t//! Pure-Rust translation of the SPHINCS+ reference project.\n2\t//!\n3\t//! Build-time configurability mirrors the CMake cache variables via Cargo\n4\t//! features (resolved into `spx_backend` / `spx_thash` / `spx_secpar` cfgs by\n5\t//! `build.rs`).\n6\t\n7\t#![allow(clippy::needless_range_loop)]\n8\t#![allow(clippy::missing_safety_doc)]\n9\t#![allow(non_snake_case)]\n10\t#![allow(non_upper_case_globals)]\n11\t\n12\tpub mod params;\n13\tpub mod context;\n14\t\n15\tpub mod address;\n16\tpub mod utils;\n17\tpub mod utilsx1;\n18\tpub mod wots;\n19\tpub mod wotsx1;\n20\tpub mod fors;\n21\tpub mod merkle;\n22\tpub mod sign;\n23\tpub mod rng;\n24\tpub mod randombytes;\n25\t\n26\t// -------- Hash backends (exactly one is active at a time) --------\n27\t#[cfg(spx_backend = \"sha2\")]\n28\tpub mod sha2;\n29\t#[cfg(spx_backend = \"sha2\")]\n30\tpub mod sha2_hash;\n31\t#[cfg(spx_backend = \"sha2\")]\n32\tpub mod sha2_thash;\n33\t\n34\t#[cfg(spx_backend = \"shake\")]\n35\tpub mod fips202;\n36\t#[cfg(spx_backend = \"shake\")]\n37\tpub mod shake_hash;\n38\t#[cfg(spx_backend = \"shake\")]\n39\tpub mod shake_thash;\n40\t\n41\t#[cfg(spx_backend = \"haraka\")]\n42\tpub mod haraka;\n43\t#[cfg(spx_backend = \"haraka\")]\n44\tpub mod haraka_hash;\n45\t#[cfg(spx_backend = \"haraka\")]\n46\tpub mod haraka_thash;\n47\t\n48\t#[cfg(spx_backend = \"blake\")]\n49\tpub mod blake256;\n50\t#[cfg(spx_backend = \"blake\")]\n51\tpub mod blake512;\n52\t#[cfg(spx_backend = \"blake\")]\n53\tpub mod blake_hash;\n54\t#[cfg(spx_backend = \"blake\")]\n55\tpub mod blake_thash;\n56\t\n57\t// Backend-agnostic facades used by the core code.\n58\tpub mod hash;\n59\tpub mod thash;\n60\t"}]},"parent_tool_use_id":"toolu_bdrk_018TT8uC2xSZx4nh56V9gCG6","session_id":"6db5455e-f768-477c-9943-e81d8027edae","uuid":"df94ce8b-44ba-4c5a-9da7-489429458dd9","timestamp":"2026-08-29T00:30