nc, m, m.len());\n46\t    shake256_inc_finalize(&mut s_inc);\n47\t    shake256_inc_squeeze(&mut buf, SPX_DGST_BYTES, &mut s_inc);\n48\t\n49\t    digest[..SPX_FORS_MSG_BYTES].copy_from_slice(&buf[..SPX_FORS_MSG_BYTES]);\n50\t    let mut bufp = SPX_FORS_MSG_BYTES;\n51\t\n52\t    if SPX_D == 1 {\n53\t        *tree = 0;\n54\t    } else {\n55\t        *tree = bytes_to_ull(&buf[bufp..], SPX_TREE_BYTES);\n56\t        *tree &= (!0u64) >> (64 - SPX_TREE_BITS);\n57\t    }\n58\t    bufp += SPX_TREE_BYTES;\n59\t\n60\t    *leaf_idx = bytes_to_ull(&buf[bufp..], SPX_LEAF_BYTES) as u32;\n61\t    *leaf_idx &= (!0u32) >> (32 - SPX_LEAF_BITS);\n62\t}\n63\t\n64\t// ------------------------------------------------------------------\n65\t// Exported C ABI wrappers.\n66\t// ------------------------------------------------------------------\n67\t\n68\t#[no_mangle]\n69\tpub unsafe extern \"C\" fn SPX_initialize_hash_function(ctx: *mut SpxCtx) {\n70\t    initialize_hash_function(&mut *ctx);\n71\t}\n72\t#[no_mangle]\n73\tpub unsafe extern \"C\" fn SPX_prf_addr(out: *mut u8, ctx: *const SpxCtx, addr: *const u32) {\n74\t    prf_addr(core::slice::from_raw_parts_mut(out, SPX_N), &*ctx, &*(addr as *const [u32; 8]));\n75\t}\n76\t#[no_mangle]\n77\tpub unsafe extern \"C\" fn SPX_gen_message_random(\n78\t    r: *mut u8,\n79\t    sk_prf: *const u8,\n80\t    optrand: *const u8,\n81\t    m: *const u8,\n82\t    mlen: core::ffi::c_ulonglong,\n83\t    ctx: *const SpxCtx,\n84\t) {\n85\t    gen_message_random(\n86\t        core::slice::from_raw_parts_mut(r, SPX_N),\n87\t        core::slice::from_raw_parts(sk_prf, SPX_N),\n88\t        core::slice::from_raw_parts(optrand, SPX_N),\n89\t        core::slice::from_raw_parts(m, mlen as usize),\n90\t        &*ctx,\n91\t    );\n92\t}\n93\t#[no_mangle]\n94\tpub unsafe extern \"C\" fn SPX_hash_message(\n95\t    digest: *mut u8,\n96\t    tree: *mut u64,\n97\t    leaf_idx: *mut u32,\n98\t    r: *const u8,\n99\t    pk: *const u8,\n100\t    m: *const u8,\n101\t    mlen: cor