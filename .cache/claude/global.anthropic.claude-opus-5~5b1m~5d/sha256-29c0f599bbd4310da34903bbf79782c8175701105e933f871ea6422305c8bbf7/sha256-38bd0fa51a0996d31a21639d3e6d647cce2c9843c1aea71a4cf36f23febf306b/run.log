                   printf(\"p=%d q=%d bins=%d thr=%s -> %d\\n\", p, q, bins, s1, m);\n                    free(a); free(b);\n                }\n            }\n        }\n    }\n\n    /* ---- 2. special float patterns through spectral_contrast ---- */\n    printf(\"### special-pattern spectral_contrast (float) ###\\n\");\n    for (int p = 0; p < 16; p++) {\n        for (int q = 0; q < 16; q++) {\n            for (int len = 1; len <= 20; len++) {\n                float *a = malloc((size_t)len*4), *b = malloc((size_t)len*4);\n                for (int i = 0; i < len; i++) { a[i]=special_f((p+i)%16); b[i]=special_f((q+i*5)%16); }\n                double r = SC(a, b, len);\n                b64(r, s1); h64(a,(size_t)len*4,s2); h64(b,(size_t)len*4,s3);\n                printf(\"p=%d q=%d len=%d -> %s a=%s b=%s\\n\", p, q, len, s1, s2, s3);\n                free(a); free(b);\n            }\n        }\n    }\n\n    /* ---- 3. overlapping but unequal pointers ---- */\n    printf(\"### overlapping pointers ###\\n\");\n    for (int len = 1; len <= 40; len++) {\n        for (int off = 0; off <= 4 && off < len; off++) {\n            S = 0x777ULL + (uint64_t)len*13 + (uint64_t)off;\n            float *buf = malloc((size_t)(len+8)*4);\n            for (int i = 0; i < len+8; i++) buf[i] = (float)(urand()*4.0-2.0);\n            double r = SC(buf, buf+off, len);\n            b64(r, s1); h64(buf,(size_t)(len+8)*4,s2);\n            printf(\"len=%d off=%d -> %s buf=%s\\n\", len, off, s1, s2);\n            free(buf);\n        }\n    }\n    /* match() with overlapping input arrays */\n    for (int bins = 1; bins <= 40; bins++) {\n        for (int off = 0; off <= 3 && off < bins; off++) {\n            S = 0x888ULL + (uint64_t)bins*7 + (uint64_t)off;\n            double *buf = malloc((size_t)(bins+8)*8);\n            for (int i = 0; i < bins+8; i++) buf[i] = urand()*10.0;\n            for (int ti = 0; ti < nthr; ti++) {\n                int m = MATCH(buf, buf+off, bins, thrs[ti]);\n          