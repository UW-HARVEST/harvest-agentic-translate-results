ag > 0 {\n            tmp[n] = b'0' + (mag % 10) as u8;\n            mag /= 10;\n            n += 1;\n        }\n    }\n    if negative {\n        tmp[n] = b'-';\n        n += 1;\n    }\n\n    // reverse\n    let mut bytes = [0u8; 12];\n    for k in 0..n {\n        bytes[k] = tmp[n - 1 - k];\n    }\n\n    IntStr { bytes, len: n }\n}\n\n/// static void initialize_test_data(void)\n///\n/// Present in the original C source but never called; preserved here (and\n/// likewise never called) so that the library's observable state matches.\nunsafe fn initialize_test_data() {\n    unsafe {\n        NODE_COUNT = 0;\n\n        add_node(1, -1, 100.5);\n        add_node(2, 1, 50.25);\n        add_node(3, 1, 75.75);\n        add_node(4, 2, 25.125);\n        add_node(5, 2, 30.875);\n        add_node(6, 3, 40.0625);\n        add_node(7, 4, 12.5);\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":789,"cache_read_input_tokens":22198,"cache_creation":{"ephemeral_5m_input_tokens":789,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"8bc736ad-3c51-4301-99df-17783a557096","uuid":"5bfceef6-da8c-43e9-8faa-2f8f7a41fe32","timestamp":"2026-08-28T02:26:08.143Z"}
