      let mut c_sig = vec![0xA5u8; SPX_WOTS_BYTES + 8];\n        let mut r_sig = vec![0xA5u8; SPX_WOTS_BYTES + 8];\n        let mut c_info = LeafInfoX1Ffi {\n            wots_sig: c_sig.as_mut_ptr(),\n            wots_sign_leaf: idx_leaf,\n            wots_steps: steps.as_ptr(),\n            leaf_addr: base,\n            pk_addr: base,\n        };\n        let mut r_info = LeafInfoX1Ffi {\n            wots_sig: r_sig.as_mut_ptr(),\n            wots_sign_leaf: idx_leaf,\n            wots_steps: steps.as_ptr(),\n            leaf_addr: base,\n            pk_addr: base,\n        };\n        let mut cta = tree_addr;\n        let mut rta = tree_addr;\n        let mut croot = vec![0xA5u8; SPX_N + 8];\n        let mut rroot = vec![0xA5u8; SPX_N + 8];\n        let mut cauth = vec![0xA5u8; h as usize * SPX_N + 8];\n        let mut rauth = vec![0xA5u8; h as usize * SPX_N + 8];\n        unsafe {\n            c(\n                croot.as_mut_ptr(),\n                cauth.as_mut_ptr(),\n                &cc,\n                idx_leaf,\n                0,\n                h,\n                cta.as_mut_ptr(),\n                &mut c_info,\n            );\n            r(\n                rroot.as_mut_ptr(),\n                rauth.as_mut_ptr(),\n                &rc,\n                idx_leaf,\n                0,\n                h,\n                rta.as_mut_ptr(),\n                &mut r_info,\n            );\n        }\n        assert_bytes_eq(&format!(\"SPX_wots_treehashx1(idx_leaf={idx_leaf}) root\"), &croot, &rroot);\n        assert_bytes_eq(\n            &format!(\"SPX_wots_treehashx1(idx_leaf={idx_leaf}) auth_path\"),\n            &cauth,\n            &rauth,\n        );\n        assert_bytes_eq(\n            &format!(\"SPX_wots_treehashx1(idx_leaf={idx_leaf}) wots_sig\"),\n            &c_sig,\n            &r_sig,\n        );\n        assert_bytes_eq(\n            &format!(\"SPX_wots_treehashx1(idx_leaf={idx_leaf}) tree_addr after\"),\n            &addr_bytes(&cta),\n            &addr_bytes(&rta),\n        );\n        assert_bytes_eq(\n            &format!(\"SPX_wots_treehashx1(idx_leaf={idx_leaf}) leaf_addr after\"),\n            &addr_bytes(&c_info.leaf_addr),\n            &addr_bytes(&r_info.leaf_addr),\n        );\n        assert_bytes_eq(\n            &format!(\"SPX_wots_treehashx1(idx_leaf={idx_leaf}) pk_addr after\"),\n            &addr_bytes(&c_info.pk_addr),\n            &addr_bytes(&r_info.pk_addr),\n        );\n    }\n}\n\n// --- row 43 -------------------------------------------------------------\n\n#[test]\nfn row43_fors_treehashx1() {\n    // `fors_treehashx1` has the same signature as `wots_treehashx1` but calls\n    // `fors_gen_leafx1`, which only reads `info->leaf_addr` (aliasing\n    // `fors_gen_leaf_info.leaf_addrx`).\n    let l = libs();\n    let (c, r) = l.pair::<FnTreehashX1>(\"SPX_fors_treehashx1\");\n    let mut rng = Rng::new(0x4301);\n    let h = SPX_FORS_HEIGHT as u32;\n    let max = (1u32 << h) - 1;\n    for it in 0..24 {\n        let (cc, rc) = make_ctx(&mut rng);\n        let leaf_idx = match it {\n            0 => 0u32,\n            1 => 1,\n            2 => max,\n            _ => rng.next_u32() & max,\n        };\n        let idx_offset = match it {\n            0 | 1 | 2 => 0u32,\n            3 => (it as u32) * (1u32 << h),\n            _ => (rng.next_u32() % SPX_FORS_TREES as u32) * (1u32 << h),\n        };\n        let base = rng.addr();\n        let tree_addr = rng.addr();\n\n        let mut c_info = LeafInfoX1Ffi {\n            wots_sig: core::ptr::null_mut(),\n            wots_sign_leaf: u32::MAX,\n            wots_steps: core::ptr::null(),\n            leaf_addr: base,\n            pk_addr: base,\n        };\n        let mut r_info = LeafInfoX1Ffi {\n            wots_sig: core::ptr::null_mut(),\n            wots_sign_leaf: u32::MAX,\n            wots_steps: core::ptr::null(),\n            leaf_addr: base,\n            pk_addr: base,\n        };\n        let mut cta = tree_addr;\n        let mut rta = tree_addr;\n        let mut croot = vec![0xA5u8; SPX_N + 8];\n        let mut rroot = vec![0xA5u8; SPX_N + 8];\n        let mut cauth = vec![0xA5u8; h as usize * SPX_N + 8];\n        let mut rauth = vec![0xA5u8; h as usize * SPX_N + 8];\n        unsafe {\n            c(\n                croot.as_mut_ptr(),\n                cauth.as_mut_ptr(),\n                &cc,\n                leaf_idx,\n                idx_offset,\n                h,\n                cta.as_mut_ptr(),\n                &mut c_info,\n            );\n            r(\n                rroot.as_mut_ptr(),\n                rauth.as_mut_ptr(),\n                &rc,\n                leaf_idx,\n                idx_offset,\n                h,\n                rta.as_mut_ptr(),\n                &mut r_info,\n            );\n        }\n        assert_bytes_eq(\n            &format!(\"SPX_fors_treehashx1(leaf_idx={leaf_idx}, off={idx_offset}) root\"),\n            &croot,\n            &rroot,\n        );\n        assert_bytes_eq(\n            &format!(\"SPX_fors_treehashx1(leaf_idx={leaf_idx}, off={idx_offset}) auth_path\"),\n            &cauth,\n            &rauth,\n        );\n        assert_bytes_eq(\n            &format!(\"SPX_fors_treehashx1 tree_addr after\"),\n            &addr_bytes(&cta),\n            &addr_bytes(&rta),\n        );\n        assert_bytes_eq(\n            &format!(\"SPX_fors_treehashx1 leaf_addr after\"),\n            &addr_bytes(&c_info.leaf_addr),\n            &addr_bytes(&r_info.leaf_addr),\n        );\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3254,"cache_read_input_tokens":230604,"cache_creation":{"ephemeral_5m_input_tokens":3254,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"ad09d3fe-ada9-47ca-9d56-2e4ee9154101","uuid":"1ffba1c8-a8ac-4fae-aea7-c70f06e8d801","timestamp":"2026-09-05T16:25:56.850