usize = (SPX_FORS_HEIGHT * SPX_FORS_TREES + 7) / 8;\n96:pub const SPX_FORS_BYTES: usize = (SPX_FORS_HEIGHT + 1) * SPX_FORS_TREES * SPX_N;\n97:pub const SPX_FORS_PK_BYTES: usize = SPX_N;\n99:pub const SPX_BYTES: usize =\n101:pub const SPX_PK_BYTES: usize = 2 * SPX_N;\n102:pub const SPX_SK_BYTES: usize = 2 * SPX_N + SPX_PK_BYTES;\n108:pub const CRYPTO_SECRETKEYBYTES: usize = SPX_SK_BYTES;\n109:pub const CRYPTO_PUBLICKEYBYTES: usize = SPX_PK_BYTES;\n110:pub const CRYPTO_BYTES: usize = SPX_BYTES;\n111:pub const CRYPTO_SEEDBYTES: usize = 3 * SPX_N;\n112:pub const CRYPTO_ALGNAME: &str = \"SPHINCS+\";\n121:    pub const SPX_OFFSET_LAYER: usize = 0;\n122:    pub const SPX_OFFSET_TREE: usize = 1;\n123:    pub const SPX_OFFSET_TYPE: usize = 9;\n124:    pub const SPX_OFFSET_KP_ADDR: usize = 10;\n125:    pub const SPX_OFFSET_CHAIN_ADDR: usize = 17;\n126:    pub const SPX_OFFSET_HASH_ADDR: usize = 21;\n127:    pub const SPX_OFFSET_TREE_HGT: usize = 17;\n128:    pub const SPX_OFFSET_TREE_INDEX: usize = 18;\n132:    pub const SPX_OFFSET_LAYER: usize = 3;\n133:    pub const SPX_OFFSET_TREE: usize = 8;\n134:    pub const SPX_OFFSET_TYPE: usize = 19;\n135:    pub const SPX_OFFSET_KP_ADDR: usize = 20;\n136:    pub const SPX_OFFSET_CHAIN_ADDR: usize = 27;\n137:    pub const SPX_OFFSET_HASH_ADDR: usize = 31;\n138:    pub const SPX_OFFSET_TREE_HGT: usize = 27;\n139:    pub const SPX_OFFSET_TREE_INDEX: usize = 28;\n145:pub const SPX_ADDR_TYPE_WOTS: u32 = 0;\n146:pub const SPX_ADDR_TYPE_WOTSPK: u32 = 1;\n147:pub const SPX_ADDR_TYPE_HASHTREE: u32 = 2;\n148:pub const SPX_ADDR_TYPE_FORSTREE: u32 = 3;\n149:pub const SPX_ADDR_TYPE_FORSPK: u32 = 4;\n150:pub const SPX_ADDR_TYPE_WOTSPRF: u32 = 5;\n151:pub const SPX_ADDR_TYPE_FORSPRF: u32 = 6;\n154:pub const SPX_TREE_BITS: usize = SPX_TREE_HEIGHT * (SPX_D - 1);\n155:pub const SPX_TREE_BYTES: usize = (SPX_TREE_BITS + 7) / 8;\n156:pub const SPX_LEAF_BITS: usize = SPX_TREE_HEIGHT;\n157:pub const SPX_LEAF_BYTES: usize = (SPX_LEAF_BITS + 7) / 8;\n158:pu