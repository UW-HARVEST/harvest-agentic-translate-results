{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01WBSsQeXA2aPdACy36N8aku","type":"tool_result","content":"1\t//! Translation of `app/src/rng.c` (the deterministic AES-256-CTR-DRBG used by\n2\t//! the KAT driver). The OpenSSL AES-256-ECB call is replaced by a self-contained\n3\t//! pure-Rust AES-256 block encryption (byte-identical to AES-256-ECB).\n4\t\n5\tuse std::sync::Mutex;\n6\t\n7\tpub const RNG_SUCCESS: i32 = 0;\n8\tpub const RNG_BAD_MAXLEN: i32 = -1;\n9\tpub const RNG_BAD_OUTBUF: i32 = -2;\n10\tpub const RNG_BAD_REQ_LEN: i32 = -3;\n11\t\n12\t// ---------------- AES-256 (single block, ECB) ----------------\n13\t\n14\t#[rustfmt::skip]\n15\tconst SBOX: [u8; 256] = [\n16\t    0x63,0x7c,0x77,0x7b,0xf2,0x6b,0x6f,0xc5,0x30,0x01,0x67,0x2b,0xfe,0xd7,0xab,0x76,\n17\t    0xca,0x82,0xc9,0x7d,0xfa,0x59,0x47,0xf0,0xad,0xd4,0xa2,0xaf,0x9c,0xa4,0x72,0xc0,\n18\t    0xb7,0xfd,0x93,0x26,0x36,0x3f,0xf7,0xcc,0x34,0xa5,0xe5,0xf1,0x71,0xd8,0x31,0x15,\n19\t    0x04,0xc7,0x23,0xc3,0x18,0x96,0x05,0x9a,0x07,0x12,0x80,0xe2,0xeb,0x27,0xb2,0x75,\n20\t    0x09,0x83,0x2c,0x1a,0x1b,0x6e,0x5a,0xa0,0x52,0x3b,0xd6,0xb3,0x29,0xe3,0x2f,0x84,\n21\t    0x53,0xd1,0x00,0xed,0x20,0xfc,0xb1,0x5b,0x6a,0xcb,0xbe,0x39,0x4a,0x4c,0x58,0xcf,\n22\t    0xd0,0xef,0xaa,0xfb,0x43,0x4d,0x33,0x85,0x45,0xf9,0x02,0x7f,0x50,0x3c,0x9f,0xa8,\n23\t    0x51,0xa3,0x40,0x8f,0x92,0x9d,0x38,0xf5,0xbc,0xb6,0xda,0x21,0x10,0xff,0xf3,0xd2,\n24\t    0xcd,0x0c,0x13,0xec,0x5f,0x97,0x44,0x17,0xc4,0xa7,0x7e,0x3d,0x64,0x5d,0x19,0x73,\n25\t    0x60,0x81,0x4f,0xdc,0x22,0x2a,0x90,0x88,0x46,0xee,0xb8,0x14,0xde,0x5e,0x0b,0xdb,\n26\t    0xe0,0x32,0x3a,0x0a,0x49,0x06,0x24,0x5c,0xc2,0xd3,0xac,0x62,0x91,0x95,0xe4,0x79,\n27\t    0xe7,0xc8,0x37,0x6d,0x8d,0xd5,0x4e,0xa9,0x6c,0x56,0xf4,0xea,0x65,0x7a,0xae,0x08,\n28\t    0xba,0x78,0x25,0x2e,0x1c,0xa6,0xb4,0xc6,0xe8,0xdd,0x74,0x1f,0x4b,0xbd,0x8b,0x8a,\n29\t    0x70,0x3e,0xb5,0x66,0x48,0x03,0xf6,0x0e,0x61,0x35,0x57,0xb9,0x86,0xc1,0x1d,0x9e,\n30\t    0xe1,0xf8,0x98,0x11,0x69,0xd9,0x8e,0x94,0x9b,0x1e,0x87,0xe9,0xce,0x55,0x28,0xdf,\n31\t    0x8c,0xa1,0x89,0x0d,0xbf,0xe6,0x42,0x68,0x41,0x99,0x2d,0x0f,0xb0,0x54,0xbb,0x16,\n32\t];\n33\t\n34\tconst RCON: [u8; 8] = [0x00, 0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40];\n35\t\n36\tfn key_expansion(key: &[u8; 32]) -> [u8; 240] {\n37\t    let mut w = [0u8; 240];\n38\t    w[..32].copy_from_slice(key);\n39\t    let nk = 8usize;\n40\t    let total_words = 60usize;\n41\t    for i in nk..total_words {\n42\t        let mut temp = [w[4 * (i - 1)], w[4 * (i - 1) + 1], w[4 * (i - 1) + 2], w[4 * (i - 1) + 3]];\n43\t        if i % nk == 0 {\n44\t            // RotWord\n45\t            let t = temp[0];\n46\t            temp[0] = temp[1];\n47\t            temp[1] = temp[2];\n48\t            temp[2] = temp[3];\n49\t            temp[3] = t;\n50\t            // SubWord\n51\t            for b in temp.iter_mut() {\n52\t                *b = SBOX[*b as usize];\n53\t            }\n54\t            temp[0] ^= RCON[i / nk];\n55\t        } else if i % nk == 4 {\n56\t            for b in temp.iter_mut() {\n57\t                *b = SBOX[*b as usize];\n58\t            }\n59\t        }\n60\t        for j in 0..4 {\n61\t            w[4 * i + j] = w[4 * (i - nk) + j] ^ temp[j];\n62\t        }\n63\t    }\n64\t    w\n65\t}\n66\t\n67\tfn xtime(x: u8) -> u8 {\n68\t    let hi = (x >> 7) & 1;\n69\t    (x << 1) ^ (0x1b * hi)\n70\t}\n71\t\n72\tfn aes256_encrypt_block(rk: &[u8; 240], input: &[u8; 16]) -> [u8; 16] {\n73\t    let mut state = *input;\n74\t\n75\t    // Initial round key addition (round 0).\n76\t    for i in 0..16 {\n77\t        state[i] ^= rk[i];\n78\t    }\n79\t\n80\t    for round in 1..14 {\n81\t        // SubBytes\n82\t        for b in state.iter_mut() {\n83\t            *b = SBOX[*b as usize];\n84\t        }\n85\t        // ShiftRows (column-major index r + 4c)\n86\t        let old = state;\n87\t        for c in 0..4 {\n88\t            for r in 0..4 {\n89\t                state[r + 4 * c] = old[r + 4 * ((c + r) % 4)];\n90\t            }\n91\t        }\n92\t        // MixColumns\n93\t        for c in 0..4 {\n94\t            let s0 = state[4 * c];\n95\t            let s1 = state[4 * c + 1];\n96\t            let s2 = state[4 * c + 2];\n97\t            let s3 = state[4 * c + 3];\n98\t            let t = s0 ^ s1 ^ s2 ^ s3;\n99\t            state[4 * c] ^= t ^ xtime(s0 ^ s1);\n100\t            state[4 * c + 1] ^= t ^ xtime(s1 ^ s2);\n101\t            state[4 * c + 2] ^= t ^ xtime(s2 ^ s3);\n102\t            state[4 * c + 3] ^= t ^ xtime(s3 ^ s0);\n103\t        }\n104\t        // AddRoundKey\n105\t        for i in 0..16 {\n106\t            state[i] ^= rk[16 * round + i];\n107\t        }\n108\t    }\n109\t\n110\t    // Final round (no MixColumns).\n111\t    for b in state.iter_mut() {\n112\t        *b = SBOX[*b as usize];\n113\t    }\n114\t    let old = state;\n115\t    for c in 0..4 {\n116\t        for r in 0..4 {\n117\t            state[r + 4 * c] = old[r + 4 * ((c + r) % 4)];\n118\t        }\n119\t    }\n120\t    for i in 0..16 {\n121\t        state[i] ^= rk[16 * 14 + i];\n122\t    }\n123\t\n124\t    state\n125\t}\n126\t\n127\t/// AES-256-ECB single-block encryption: buffer = AES_256(key, ctr).\n128\tfn aes256_ecb(key: &[u8; 32], ctr: &[u8; 16], buffer: &mut [u8; 16]) {\n129\t    let rk = key_expansion(key);\n130\t    *buffer = aes256_encrypt_block(&rk, ctr);\n131\t}\n132\t\n133\t// ---------------- CTR-DRBG ----------------\n134\t\n135\tstruct Drbg {\n136\t    key: [u8; 32],\n137\t    v: [u8; 16],\n138\t    reseed_counter: i32,\n139\t}\n140\t\n141\tstatic DRBG: Mutex<Drbg> = Mutex::new(Drbg {\n142\t    key: [0u8; 32],\n143\t    v: [0u8; 16],\n144\t    reseed_counter: 0,\n145\t});\n146\t\n147\tfn aes256_ctr_drbg_update(provided_data: Option<&[u8; 48]>, key: &mut [u8; 32], v: &mut [u8; 16]) {\n148\t    let mut temp = [0u8; 48];\n149\t    for i in 0..3 {\n150\t        // increment V (128-bit, big-endian)\n151\t        for j in (0..16).rev() {\n152\t            if v[j] == 0xff {\n153\t                v[j] = 0x00;\n154\t            } else {\n155\t                v[j] += 1;\n156\t                break;\n157\t            }\n158\t        }\n159\t        let mut block = [0u8; 16];\n160\t        aes256_ecb(key, v, &mut block);\n161\t        temp[16 * i..16 * i + 16].copy_from_slice(&block);\n162\t    }\n163\t    if let Some(pd) = provided_data {\n164\t        for i in 0..48 {\n165\t            temp[i] ^= pd[i];\n166\t        }\n167\t    }\n168\t    key.copy_from_slice(&temp[..32]);\n169\t    v.copy_from_slice(&temp[32..48]);\n170\t}\n171\t\n172\tpub fn randombytes_init(entropy_input: &[u8; 48], personalization_string: Option<&[u8; 48]>) {\n173\t    let mut seed_material = *entropy_input;\n174\t    if let Some(ps) = personalization_string {\n175\t        for i in 0..48 {\n176\t            seed_material[i] ^= ps[i];\n177\t        }\n178\t    }\n179\t    let mut g = DRBG.lock().unwrap();\n180\t    g.key = [0u8; 32];\n181\t    g.v = [0u8; 16];\n182\t    let mut key = g.key;\n183\t    let mut v = g.v;\n184\t    aes256_ctr_drbg_update(Some(&seed_material), &mut key, &mut v);\n185\t    g.key = key;\n186\t    g.v = v;\n187\t    g.reseed_counter = 1;\n188\t}\n189\t\n190\tpub fn randombytes(x: &mut [u8]) -> i32 {\n191\t    let mut g = DRBG.lock().unwrap();\n192\t    let mut key = g.key;\n193\t    let mut v = g.v;\n194\t\n195\t    let mut xlen = x.len();\n196\t    let mut i = 0usize;\n197\t    while xlen > 0 {\n198\t        // increment V\n199\t        for j in (0..16).rev() {\n200\t            if v[j] == 0xff {\n201\t                v[j] = 0x00;\n202\t            } else {\n203\t                v[j] += 1;\n204\t                break;\n205\t            }\n206\t        }\n207\t        let mut block = [0u8; 16];\n208\t        aes256_ecb(&key, &v, &mut block);\n209\t        if xlen > 15 {\n210\t            x[i..i + 16].copy_from_slice(&block);\n211\t            i += 16;\n212\t            xlen -= 16;\n213\t        } else {\n214\t            x[i..i + xlen].copy_from_slice(&block[..xlen]);\n215\t            xlen = 0;\n216\t        }\n217\t    }\n218\t    aes256_ctr_drbg_update(None, &mut key, &mut v);\n219\t    g.key = key;\n220\t    g.v = v;\n221\t    g.reseed_counter += 1;\n222\t    RNG_SUCCESS\n223\t}\n224\t\n225\t// ---------------- seedexpander (not used by the driver, kept for parity) ----------------\n226\t\n227\tpub struct AesXofStruct {\n228\t    pub buffer: [u8; 16],\n229\t    pub buffer_pos: usize,\n230\t    pub length_remaining: u64,\n231\t    pub key: [u8; 32],\n232\t    pub ctr: [u8; 16],\n233\t}\n234\t\n235\tpub fn seedexpander_init(\n236\t    ctx: &mut AesXofStruct,\n237\t    seed: &[u8; 32],\n238\t    diversifier: &[u8; 8],\n239\t    mut maxlen: u64,\n240\t) -> i32 {\n241\t    if maxlen >= 0x100000000 {\n242\t        return RNG_BAD_MAXLEN;\n243\t    }\n244\t    ctx.length_remaining = maxlen;\n245\t    ctx.key.copy_from_slice(seed);\n246\t    ctx.ctr[..8].copy_from_slice(diversifier);\n247\t    ctx.ctr[11] = (maxlen % 256) as u8;\n248\t    maxlen >>= 8;\n249\t    ctx.ctr[10] = (maxlen % 256) as u8;\n250\t    maxlen >>= 8;\n251\t    ctx.ctr[9] = (maxlen % 256) as u8;\n252\t    maxlen >>= 8;\n253\t    ctx.ctr[8] = (maxlen % 256) as u8;\n254\t    for b in ctx.ctr[12..16].iter_mut() {\n255\t        *b = 0;\n256\t    }\n257\t    ctx.buffer_pos = 16;\n258\t    ctx.buffer = [0u8; 16];\n259\t    RNG_SUCCESS\n260\t}\n261\t\n262\tpub fn seedexpander(ctx: &mut AesXofStruct, x: &mut [u8]) -> i32 {\n263\t    let mut xlen = x.len() as u64;\n264\t    if xlen >= ctx.length_remaining {\n265\t        return RNG_BAD_REQ_LEN;\n266\t    }\n267\t    ctx.length_remaining -= xlen;\n268\t\n269\t    let mut offset = 0usize;\n270\t    while xlen > 0 {\n271\t        if xlen <= (16 - ctx.buffer_pos) as u64 {\n272\t            x[offset..offset + xlen as usize]\n273\t                .copy_from_slice(&ctx.buffer[ctx.buffer_pos..ctx.buffer_pos + xlen as usize]);\n274\t            ctx.buffer_pos += xlen as usize;\n275\t            return RNG_SUCCESS;\n276\t        }\n277\t        let avail = 16 - ctx.buffer_pos;\n278\t        x[offset..offset + avail].copy_from_slice(&ctx.buffer[ctx.buffer_pos..16]);\n279\t        xlen -= avail as u64;\n280\t        offset += avail;\n281\t\n282\t        let key = ctx.key;\n283\t        let ctr = ctx.ctr;\n284\t        aes256_ecb(&key, &ctr, &mut ctx.buffer);\n285\t        ctx.buffer_pos = 0;\n286\t\n287\t        for i in (12..16).rev() {\n288\t            if ctx.ctr[i] == 0xff {\n289\t                ctx.ctr[i] = 0x00;\n290\t            } else {\n291\t                ctx.ctr[i] += 1;\n292\t                break;\n293\t            }\n294\t        }\n295\t    }\n296\t    RNG_SUCCESS\n297\t}\n298\t\n299\t// ------------------------------------------------------------------\n300\t// Exported C ABI wrappers.\n301\t// ------------------------------------------------------------------\n302\t\n303\t#[export_name = \"randombytes_init\"]\n304\tpub unsafe extern \"C\" fn c_randombytes_init(\n305\t    entropy_input: *mut u8,\n306\t    personalization_string: *mut u8,\n307\t) {\n308\t    let ent = &*(entropy_input as *const [u8; 48]);\n309\t    if personalization_string.is_null() {\n310\t        randombytes_init(ent, None);\n311\t    } else {\n312\t        let ps = &*(personalization_string as *const [u8; 48]);\n313\t        randombytes_init(ent, Some(ps));\n314\t    }\n315\t}\n316\t\n317\t#[export_name = \"randombytes\"]\n318\tpub unsafe extern \"C\" fn c_randombytes(x: *mut u8, xlen: core::ffi::c_ulonglong) -> core::ffi::c_int {\n319\t    let s = core::slice::from_raw_parts_mut(x, xlen as usize);\n320\t    randombytes(s)\n321\t}\n322\t"}]},"parent_tool_use_id":"toolu_bdrk_01QWsVk3CptKuw8zpWsV6YrL","session_id":"ad09d3fe-ada9-47ca-9d56-2e4ee9154101","uuid":"0ee3fcbb-792b-4aa0-ab71-0a8b04bbf821","timestamp":"2026-09-05T16:08:55.739Z","subagent_type":"general-purpose","task_description":"Add missing FFI exports to rng.rs"}
