ult stbds_hmdefault\n#define hmdefaults stbds_hmdefaults\n#define shput stbds_shput\n#define shputi stbds_shputi\n#define shputs stbds_shputs\n#define shget stbds_shget\n#define shgeti stbds_shgeti\n#define shgets stbds_shgets\n#define shgetp stbds_shgetp\n#define shgetp_null stbds_shgetp_null\n#define shdel stbds_shdel\n#define shlen stbds_shlen\n#define shlenu stbds_shlenu\n#define shfree stbds_shfree\n#define sh_new_arena stbds_sh_new_arena\n#define sh_new_strdup stbds_sh_new_strdup\n\n/* ---- helpers ---- */\nstatic void dump_table(const char *tag, void *raw_a)\n{\n  stbds_hash_index *t = (stbds_hash_index *) stbds_header(raw_a)->hash_table;\n  size_t i,j;\n  if (!t) { printf(\"%s: table=NULL\\n\", tag); return; }\n  printf(\"%s: slots=%zu log2=%zu used=%zu tomb=%zu ut=%zu uts=%zu tt=%zu seed=%zu strmode=%d block=%d remaining=%zu\\n\",\n     tag, t->slot_count, t->slot_count_log2, t->used_count, t->tombstone_count,\n     t->used_count_threshold, t->used_count_shrink_threshold, t->tombstone_count_threshold,\n     t->seed, (int) t->string.mode, (int) t->string.block, t->string.remaining);\n  for (i=0; i < t->slot_count >> STBDS_BUCKET_SHIFT; ++i) {\n    printf(\"  bucket %zu:\", i);\n    for (j=0; j < STBDS_BUCKET_LENGTH; ++j)\n      printf(\" [%016zx,%td]\", t->storage[i].hash[j], t->storage[i].index[j]);\n    printf(\"\\n\");\n  }\n  printf(\"  aligned=%d\\n\", (((size_t) t->storage) & 63) == 0);\n}\n\ntypedef struct { int key,b,c,d; } stbds_struct;\ntypedef struct { int key[2],b,c,d; } stbds_struct2;\n\nstatic void test_arrays(void)\n{\n  printf(\"== arrays ==\\n\");\n  {\n    int *a = NULL;\n    int i;\n    printf(\"len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n    for (i=0; i < 40; ++i) {\n      arrput(a, i*i);\n      printf(\"put %d -> len=%td cap=%zu last=%d\\n\", i, arrlen(a), arrcap(a), arrlast(a));\n    }\n    arrins(a, 3, -7);\n    arrinsn(a, 10, 4);\n    a[10]=1; a[11]=2; a[12]=3; a[13]=4;\n    arrdel(a, 5);\n    arrdeln(a, 7, 3);\n    arrdelswap(a, 2);\n    printf(\"after edits len=%td cap=%zu:\", arrlen(a), arrcap(a));\n    for (i=0; i < arrlen(a); ++i) printf(\" %d\", a[i]);\n    printf(\"\\n\");\n    printf(\"pop=%d pop=%d len=%td\\n\", arrpop(a), arrpop(a), arrlen(a));\n    arrsetlen(a, 3);\n    printf(\"setlen3 len=%td cap=%zu vals=%d,%d,%d\\n\", arrlen(a), arrcap(a), a[0],a[1],a[2]);\n    arrsetcap(a, 1000);\n    printf(\"setcap1000 len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n    arrsetlen(a, 500);\n    printf(\"setlen500 len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n    {\n      int *p = arraddnptr(a, 7);\n      ptrdiff_t idx = arraddnindex(a, 3);\n      printf(\"addnptr off=%td addnindex=%td len=%td cap=%zu\\n\", p - a, idx, arrlen(a), arrcap(a));\n    }\n    arrfree(a);\n    printf(\"freed a=%p len=%td\\n\", (void*)a, arrlen(a));\n  }\n  {\n    /* exercise arrfreef and lots of growth patterns */\n    double *d = NULL;\n    int i;\n    for (i=0; i < 100; ++i) arrput(d, i/3.0);\n    printf(\"double len=%td cap=%zu last=%f\\n\", arrlen(d), arrcap(d), arrlast(d));\n    p_arrfreef(d);\n    d = NULL;\n    for (i=0; i < 5; ++i) { arrsetcap(d, i*13+1); printf(\"setcap %d cap=%zu\\n\", i*13+1, arrcap(d)); }\n    arrfree(d);\n  }\n  {\n    char *c = NULL;\n    int i;\n    for (i=0; i < 300; ++i) arrput(c, (char)(i*7));\n    printf(\"char len=%td cap=%zu\\n\", arrlen(c), arrcap(c));\n    arrfree(c);\n  }\n}\n\nstatic void test_hash_functions(void)\n{\n  unsigned char buf[64];\n  int i, n;\n  size_t seeds[5];\n  printf(\"== hash functions ==\\n\");\n  seeds[0]=0; seeds[1]=1; seeds[2]=0x31415926; seeds[3]=(size_t)0xdeadbeefcafebabeULL; seeds[4]=(size_t)-1;\n  for (i=0; i < 64; ++i) buf[i] = (unsigned char)(i*37+13);\n  for (n=0; n <= 40; ++n)\n    for (i=0; i < 5; ++i)\n      printf(\"hb pattern1 len=%d seed=%zu -> %016zx\\n\", n, seeds[i], p_hash_bytes(buf, n, seeds[i]));\n  /* all high bits set: exercises the sign-extension quirk */\n  for (i=0; i < 64; ++i) buf[i] = 0xff;\n  for (n=0; n <= 24; ++n)\n    printf(\"hb allff len=%d -> %016zx\\n\", n, p_hash_bytes(buf, n, 12345));\n  /* selective high bytes */\n  for (n=0; n < 8; ++n) {\n    memset(buf, 0, sizeof buf);\n    buf[n] = 0x80;\n    printf(\"hb hi@%d len8 -> %016zx len16 -> %016zx len%d -> %016zx\\n\",\n        n, p_hash_bytes(buf,8,7), p_hash_bytes(buf,16,7), n+1, p_hash_bytes(buf,n+1,7));\n  }\n  for (n=0; n < 64; ++n) {\n    memset(buf, 0, sizeof buf);\n    buf[n] = 0xff;\n    printf(\"hb ff@%d -> %016zx %016zx\\n\", n, p_hash_bytes(buf,64,0), p_hash_bytes(buf,n+1,999));\n  }\n  {\n    static const char *strs[] = { \"\", \"a\", \"ab\", \"abc\", \"abcd\", \"abcdefg\", \"abcdefgh\",\n      \"abcdefghi\", \"the quick brown fox jumps over the lazy dog\",\n      \"\\xff\\xfe\\x80\\x7f\\x01\", \"test_0\", \"test_100000\", \"\\x80\\x80\\x80\\x80\\x80\\x80\\x80\\x80\" };\n    for (n=0; n < (int)(sizeof strs/sizeof *strs); ++n)\n      for (i=0; i < 5; ++i)\n        printf(\"hs \\\"%s\\\" seed=%zu -> %016zx\\n\", strs[n], seeds[i], p_hash_string((char*)strs[n], seeds[i]));\n  }\n  /* int/struct keys as the hash map uses them */\n  for (n=-5; n < 100; ++n) {\n    int k = n*n*n;\n    printf(\"hb int %d -> %016zx\\n\", k, p_hash_bytes(&k, sizeof k, 0x31415926));\n  }\n}\n\nstatic void test_intmap(void)\n{\n  struct { int key; int value; } *m = NULL;\n  int i;\n  printf(\"== int map ==\\n\");\n  hmdefault(m, -999);\n  printf(\"default set len=%td\\n\", hmlen(m));\n  for (i=0; i < 200; ++i) {\n    hmput(m, i*17, i);\n    if (i % 25 == 0) dump_table(\"intmap\", m-1);\n  }\n  printf(\"len=%td lenu=%zu\\n\", hmlen(m), hmlenu(m));\n  for (i=-10; i < 220; ++i)\n    printf(\"get %d -> %d (i=%td)\\n\", i*17, hmget(m, i*17), hmgeti(m, i*17));\n  for (i=0; i < 200; i += 3)\n    printf(\"del %d -> %td len=%td\\n\", i*17, hmdel(m, i*17), hmlen(m));\n  dump_table(\"intmap after del\", m-1);\n  printf(\"contents:\");\n  for (i=0; i < hmlen(m); ++i) printf(\" (%d,%d)\", m[i].key, m[i].value);\n  printf(\"\\n\");\n  for (i=0; i < 200; ++i)\n    printf(\"get2 %d -> %d\\n\", i*17, hmget(m, i*17));\n  {\n    ptrdiff_t temp;\n    for (i=0; i < 20; ++i)\n      printf(\"get_ts %d -> %d %td\\n\", i*17, hmget_ts(m, i*17, temp), temp);\n  }\n  /* delete everything to trigger shrinking */\n  for (i=199; i >= 0; --i) {\n    hmdel(m, i*17);\n    if (i % 20 == 0) dump_table(\"shrink\", m-1);\n  }\n  printf(\"emptied len=%td\\n\", hmlen(m));\n  hmfree(m);\n  printf(\"freed m=%p len=%td\\n\", (void*)m, hmlen(m));\n}\n\nstatic void test_structmap(void)\n{\n  stbds_struct *m = NULL;\n  stbds_struct2 *m2 = NULL;\n  int i;\n  printf(\"== struct map ==\\n\");\n  for (i=0; i < 100; ++i) {\n    stbds_struct s = { i*3, i, i*2, i*5 };\n    hmputs(m, s);\n  }\n  dump_table(\"structmap\", m-1);\n  for (i=0; i < 100; ++i) {\n    stbds_struct *p = hmgetp_null(m, i*3);\n    printf(\"s %d -> %s\\n\", i*3, p ? \"found\" : \"null\");\n    if (p) printf(\"   b=%d c=%d d=%d\\n\", p->b, p->c, p->d);\n  }\n  for (i=0; i < 100; i += 7) hmdel(m, i*3);\n  printf(\"len=%td:\", hmlen(m));\n  for (i=0; i < hmlen(m); ++i) printf(\" %d\", m[i].key);\n  printf(\"\\n\");\n  dump_table(\"structmap del\", m-1);\n  hmfree(m);\n\n  for (i=0; i < 64; ++i) {\n    stbds_struct2 s = { {i, i*2}, i, i*3, i*4 };\n    (m2) = p_hmput_key((m2), sizeof *(m2), &s.key, sizeof s.key, STBDS_HM_BINARY);\n    m2[stbds_temp((m2)-1)] = s;\n  }\n  dump_table(\"struct2map\", m2-1);\n  for (i=0; i < 64; ++i) {\n    int k[2]; k[0]=i; k[1]=i*2;\n    (m2) = p_hmget_key((m2), sizeof *(m2), k, sizeof m2->key, STBDS_HM_BINARY);\n    printf(\"s2 %d -> %td\\n\", i, stbds_temp((m2)-1));\n  }\n  for (i=0; i < 64; i += 5) {\n    int k[2]; k[0]=i; k[1]=i*2;\n    (m2) = p_hmdel_key((m2), sizeof *(m2), k, sizeof m2->key, STBDS_OFFSETOF(m2,key), STBDS_HM_BINARY);\n    printf(\"s2 del %d -> %td len=%td\\n\", i, stbds_temp((m2)-1), hmlen(m2));\n  }\n  dump_table(\"struct2map del\", m2-1);\n  printf(\"contents:\");\n  for (i=0; i < hmlen(m2); ++i) printf(\" (%d,%d,%d)\", m2[i].key[0], m2[i].key[1], m2[i].b);\n  printf(\"\\n\");\n  hmfree(m2);\n}\n\nstatic char kbuf[400][32];\nstatic void mk_keys(void)\n{\n  int i;\n  for (i=0; i < 400; ++i) sprintf(kbuf[i], \"key_%d_%d\", i, i*i);\n}\n\nstatic void test_strmap_default(void)\n{\n  struct { char *key; int value; } *m = NULL;\n  int i;\n  printf(\"== string map (default) ==\\n\");\n  for (i=0; i < 300; ++i) {\n    shput(m, kbuf[i], i*3);\n    if (i % 50 == 0) dump_table(\"shmap\", m-1);\n  }\n  printf(\"len=%td\\n\", shlen(m));\n  for (i=0; i < 400; ++i)\n    printf(\"get %s -> %td\\n\", kbuf[i], shgeti(m, kbuf[i]));\n  for (i=0; i < 300; i += 4)\n    printf(\"del %s -> %td len=%td\\n\", kbuf[i], shdel(m, kbuf[i]), shlen(m));\n  dump_table(\"shmap del\", m-1);\n  printf(\"keys:\");\n  for (i=0; i < shlen(m); ++i) printf(\" %s=%d\", m[i].key, m[i].value);\n  printf(\"\\n\");\n  for (i=0; i < 300; ++i) {\n    void *p = shgetp_null(m, kbuf[i]);\n    printf(\"g2 %d %s\\n\", i, p ? \"y\" : \"n\");\n  }\n  shfree(m);\n  printf(\"freed=%p\\n\", (void*)m);\n}\n\nstatic void test_strmap_strdup(void)\n{\n  struct { char *key; int value; } *m = NULL;\n  char tmp[64];\n  int i;\n  printf(\"== string map (strdup) ==\\n\");\n  sh_new_strdup(m);\n  dump_table(\"strdup init\", m-1);\n  for (i=0; i < 200; ++i) {\n    sprintf(tmp, \"dup_%d\", i);\n    shput(m, tmp, i);\n  }\n  dump_table(\"strdup\", m-1);\n  printf(\"len=%td\\n\", shlen(m));\n  for (i=0; i < 200; ++i) {\n    sprintf(tmp, \"dup_%d\", i);\n    printf(\"g %s -> %d %td\\n\", tmp, shget(m, tmp), shgeti(m, tmp));\n  }\n  printf(\"keys:\");\n  for (i=0; i < shlen(m); ++i) printf(\" %s\", m[i].key);\n  printf(\"\\n\");\n  for (i=0; i < 200; i += 3) {\n    sprintf(tmp, \"dup_%d\", i);\n    printf(\"del %s -> %td\\n\", tmp, shdel(m, tmp));\n  }\n  printf(\"keys2:\");\n  for (i=0; i < shlen(m); ++i) printf(\" %s=%d\", m[i].key, m[i].value);\n  printf(\"\\n\");\n  dump_table(\"strdup del\", m-1);\n  shfree(m);\n}\n\nstatic void test_strmap_arena(void)\n{\n  struct { char *key; int value; } *m = NULL;\n  char tmp[600];\n  int i;\n  printf(\"== string map (arena) ==\\n\");\n  sh_new_arena(m);\n  dump_table(\"arena init\", m-1);\n  for (i=0; i < 250; ++i) {\n    sprintf(tmp, \"arena_%d\", i);\n    shput(m, tmp, i*2);\n  }\n  dump_table(\"arena\", m-1);\n  /* one huge key exceeding the block size */\n  memset(tmp, 'z', 599); tmp[599] = 0;\n  shput(m, tmp, 12345);\n  dump_table(\"arena big\", m-1);\n  printf(\"len=%td big=%d\\n\", shlen(m), shget(m, tmp));\n  for (i=0; i < 250; ++i) {\n    sprintf(tmp, \"arena_%d\", i);\n    printf(\"g %s -> %d\\n\", tmp, shget(m, tmp));\n  }\n  printf(\"keys:\");\n  for (i=0; i < shlen(m); ++i) printf(\" %s=%d\", m[i].key, m[i].value);\n  printf(\"\\n\");\n  for (i=0; i < 250; i += 6) {\n    sprintf(tmp, \"arena_%d\", i);\n    printf(\"del %s -> %td\\n\", tmp, shdel(m, tmp));\n  }\n  dump_table(\"arena del\", m-1);\n  shfree(m);\n}\n\nstatic void test_shputs(void)\n{\n  struct { char *key; int value; } *m = NULL;\n  int i;\n  printf(\"== shputs ==\\n\");\n  sh_new_strdup(m);\n  for (i=0; i < 100; ++i) {\n    struct { char *key; int value; } s;\n    s.key = kbuf[i];\n    s.value = i*11;\n    shputs(m, s);\n  }\n  printf(\"len=%td\\n\", shlen(m));\n  for (i=0; i < 100; ++i) printf(\" %s=%d\\n\", m[i].key, m[i].value);\n  dump_table(\"shputs\", m-1);\n  shfree(m);\n}\n\nstatic void test_defaults(void)\n{\n  struct { int key; int value; } *m = NULL;\n  struct { char *key; int value; } *s = NULL;\n  int i;\n  printf(\"== defaults ==\\n\");\n  hmdefault(m, 42);\n  printf(\"miss -> %d len=%td\\n\", hmget(m, 99), hmlen(m));\n  hmput(m, 5, 6);\n  printf(\"hit -> %d miss -> %d\\n\", hmget(m, 5), hmget(m, 7));\n  hmdefault(m, 77);\n  printf(\"miss2 -> %d\\n\", hmget(m, 7));\n  hmfree(m);\n\n  shdefault(s, -1);\n  printf(\"smiss -> %d\\n\", shget(s, \"nope\"));\n  for (i=0; i < 10; ++i) shput(s, kbuf[i], i);\n  printf(\"shit -> %d smiss -> %d len=%td\\n\", shget(s, kbuf[3]), shget(s, \"zzz\"), shlen(s));\n  shfree(s);\n  {\n    struct { int key; int value; } *q = NULL;\n    struct { int key; int value; } d = { 0, 1234 };\n    hmdefaults(q, d);\n    printf(\"defaults miss -> %d\\n\", hmget(q, 3));\n    hmfree(q);\n  }\n}\n\nstatic void test_arena_direct(void)\n{\n  stbds_string_arena a;\n  int i;\n  char tmp[3000];\n  printf(\"== arena direct ==\\n\");\n  memset(&a, 0, sizeof a);\n  for (i=0; i < 120; ++i) {\n    int n = (i*37) % 200 + 1;\n    memset(tmp, 'a' + (i%26), n);\n    tmp[n] = 0;\n    {\n      char *p = p_stralloc(&a, tmp);\n      printf(\"alloc %d len=%d ok=%d remaining=%zu block=%d off=%td\\n\",\n         i, n, strcmp(p, tmp)==0, a.remaining, (int)a.block,\n         (ptrdiff_t)(p - (char*)a.storage->storage));\n    }\n  }\n  /* huge allocations exceeding blocksize */\n  for (i=0; i < 4; ++i) {\n    int n = 1000 + i*700;\n    memset(tmp, 'Q', n); tmp[n] = 0;\n    {\n      char *p = p_stralloc(&a, tmp);\n      printf(\"big %d ok=%d remaining=%zu block=%d\\n\", i, strcmp(p,tmp)==0, a.remaining, (int)a.block);\n    }\n  }\n  p_strreset(&a);\n  printf(\"reset storage=%p remaining=%zu block=%d mode=%d\\n\", (void*)a.storage, a.remaining, (int)a.block, (int)a.mode);\n  /* re-use after reset */\n  {\n    char *p = p_stralloc(&a, \"hello\");\n    printf(\"reuse ok=%d remaining=%zu block=%d\\n\", strcmp(p,\"hello\")==0, a.remaining, (int)a.block);\n    p_strreset(&a);\n  }\n}\n\nstatic void test_seed(void)\n{\n  int i, r;\n  printf(\"== rand_seed ==\\n\");\n  for (r=0; r < 4; ++r) {\n    struct { int key; int value; } *m = NULL;\n    p_rand_seed((size_t)(r*0x9E3779B97F4A7C15ULL));\n    for (i=0; i < 40; ++i) hmput(m, i, i*i);\n    dump_table(\"seeded\", m-1);\n    hmfree(m);\n  }\n  p_rand_seed(0x31415926);\n  {\n    struct { int key; int value; } *m = NULL;\n    for (i=0; i < 8; ++i) hmput(m, i, i);\n    dump_table(\"reseeded\", m-1);\n    hmfree(m);\n  }\n}\n\nstatic void test_strkey_helxo(void)\n{\n  int i;\n  printf(\"== strkey ==\\n\");\n  for (i=-3; i < 20; ++i) printf(\"strkey(%d)=%s\\n\", i, p_strkey(i));\n  printf(\"strkey(%d)=%s\\n\", 1000000, p_strkey(1000000));\n  printf(\"strkey(%d)=%s\\n\", -2147483647-1, p_strkey(-2147483647-1));\n  printf(\"== helxo ==\\n\");\n  p_helxo('a');\n  p_helxo('Z');\n  p_helxo(0);\n  p_helxo('\\n');\n  p_helxo((char)200);\n  p_helxo(127);\n  for (i=0; i < 5; ++i) p_helxo((char)('0'+i));\n}\n\nint main(int argc, char **argv)\n{\n  void *h;\n  if (argc < 2) { fprintf(stderr, \"usage: %s lib.so\\n\", argv[0]); return 1; }\n  h = dlopen(argv[1], RTLD_NOW | RTLD_LOCAL);\n  if (!h) { fprintf(stderr, \"dlopen: %s\\n\", dlerror()); return 1; }\n#define LOAD(var, name) do { *(void**)&var = dlsym(h, name); if (!var) { fprintf(stderr, \"missing %s\\n\", name); return 1; } } while (0)\n  LOAD(p_arrgrowf, \"stbds_arrgrowf\");\n  LOAD(p_arrfreef, \"stbds_arrfreef\");\n  LOAD(p_rand_seed, \"stbds_rand_seed\");\n  LOAD(p_hash_bytes, \"stbds_hash_bytes\");\n  LOAD(p_hash_string, \"stbds_hash_string\");\n  LOAD(p_stralloc, \"stbds_stralloc\");\n  LOAD(p_strreset, \"stbds_strreset\");\n  LOAD(p_hmfree_f, \"stbds_hmfree_func\");\n  LOAD(p_hmget_key, \"stbds_hmget_key\");\n  LOAD(p_hmget_key_ts, \"stbds_hmget_key_ts\");\n  LOAD(p_hmput_default, \"stbds_hmput_default\");\n  LOAD(p_hmput_key, \"stbds_hmput_key\");\n  LOAD(p_hmdel_key, \"stbds_hmdel_key\");\n  LOAD(p_shmode_func, \"stbds_shmode_func\");\n  LOAD(p_strkey, \"strkey\");\n  LOAD(p_helxo, \"helxo\");\n#undef LOAD\n  mk_keys();\n  test_hash_functions();\n  test_arrays();\n  test_intmap();\n  test_structmap();\n  test_strmap_default();\n  test_strmap_strdup();\n  test_strmap_arena();\n  test_shputs();\n  test_defaults();\n  test_arena_direct();\n  test_seed();\n  test_strkey_helxo();\n  printf(\"== done ==\\n\");\n  fflush(stdout);\n  return 0;\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
