lac_u32; // 64\n49\t\n50\t// ---------------------------------------------------------------------------\n51\t// src/lib.c\n52\t// ---------------------------------------------------------------------------\n53\t\n54\t/// ```c\n55\t/// int bitwriter_add(tflac_bitwriter *bw, tflac_u32 bits, tflac_uint val);\n56\t/// ```\n57\t#[unsafe(no_mangle)]\n58\tpub unsafe extern \"C\" fn bitwriter_add(\n59\t    bw: *mut tflac_bitwriter,\n60\t    bits: tflac_u32,\n61\t    val: tflac_uint,\n62\t) -> c_int {\n63\t    // const tflac_uint mask = (18446744073709551615UL) << 1;\n64\t    const MASK: tflac_uint = 0xFFFF_FFFF_FFFF_FFFFu64 << 1;\n65\t\n66\t    let mut bits: tflac_u32 = bits;\n67\t    let mut val: tflac_uint = val;\n68\t    let b: &mut tflac_bitwriter = unsafe { &mut *bw };\n69\t\n70\t    // val <<= ((8 * sizeof(tflac_uint)) - bits);\n71\t    // The shift count is reduced modulo 64 by the hardware shift instruction.\n72\t    val = val.wrapping_shl(UINT_BITS.wrapping_sub(bits));\n73\t\n74\t    // bw->tot += bits;\n75\t    b.tot = b.tot.wrapping_add(bits);\n76\t\n77\t    // int i = 0;\n78\t    let mut i: c_int = 0;\n79\t\n80\t    // while ((bw->bits + bits >= (8 * sizeof(tflac_uint))) && i < 100) {\n81\t    while b.bits.wrapping_add(bits) >= UINT_BITS && i < 100 {\n82\t        // b = (8 * sizeof(tflac_uint)) - bw->bits - 1;\n83\t        let mut bb: tflac_u32 = UINT_BITS.wrapping_sub(b.bits).wrapping_sub(1);\n84\t\n85\t        // b = b > bits ? bits : b;\n86\t        bb = if bb > bits { bits } else { bb };\n87\t\n88\t        // bw->val |= (val >> bw->bits);\n89\t        b.val |= val.wrapping_shr(b.bits);\n90\t\n91\t        // bw->bits += b;\n92\t        b.bits = b.bits.wrapping_add(bb);\n93\t\n94\t        // bw->val &= mask;\n95\t        b.val &= MASK;\n96\t\n97\t        // val <<= b;\n98\t        val = val.wrapping_shl(bb);\n99\t\n100\t        // bits -= b;\n101\t        bits = bits.wrapping_sub(bb);\n102\t\n103\t        // i++;\n104\t        i = i.wrapping_add(1);\n105\t   