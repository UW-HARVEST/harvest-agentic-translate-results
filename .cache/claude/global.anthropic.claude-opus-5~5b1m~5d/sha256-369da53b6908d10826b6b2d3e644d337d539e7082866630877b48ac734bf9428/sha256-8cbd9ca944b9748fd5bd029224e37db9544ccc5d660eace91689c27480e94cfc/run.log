  0 => BOUNDARIES[(r >> 8) as usize % BOUNDARIES.len()],\n            1 => (r >> 16) as u32 % 65,\n            _ => self.next_u32(),\n        }\n    }\n    /// A `bw->bits` incoming state biased toward boundary values.\n    pub fn interesting_state_bits(&mut self) -> u32 {\n        const BOUNDARIES: [u32; 11] =\n            [0, 1, 31, 32, 62, 63, 64, 65, 128, 1000, u32::MAX];\n        let r = self.next_u64();\n        match r % 3 {\n            0 => BOUNDARIES[(r >> 8) as usize % BOUNDARIES.len()],\n            1 => (r >> 16) as u32 % 65,\n            _ => self.next_u32(),\n        }\n    }\n    pub fn state(&mut self) -> Bitwriter {\n        Bitwriter {\n            val: self.interesting_u64(),\n            bits: self.interesting_state_bits(),\n            pos: self.next_u32(),\n            len: self.next_u32(),\n            tot: self.next_u32(),\n            buffer: self.next_u64() as *mut u8,\n        }\n    }\n}\n","structuredPatch":[{"oldStart":137,"oldLines":6,"newStart":137,"newLines":7,"lines":["     IMPLS.get_or_init(|| {","         let c_path = find_c_so();","         let rust_path = find_rust_so();","+        assert_so_fresh(&rust_path);","         // SAFETY: both libraries are plain C-ABI shared objects with no","         // constructors that could misbehave.","         let c_lib = unsafe { Library::new(&c_path) }"]}],"userModified":false,"replaceAll":false}}
