ange(2500):\n    parts = []\n    parts.append(str(random.choice([0, 1, 2, 3, 4, 5, 6, random.randint(-3, 9)])))\n    n = random.choice([1, 2, 3, 100, random.randint(1, 100)])\n    parts.append(str(n))\n    for _ in range(n):\n        L = random.choice([0, 128, 255, 256, random.randint(0, 256)])\n        parts.append(str(L))\n        parts.extend(str(random.randint(-40, 300)) for _ in range(L))\n    parts.append(str(random.choice([0, -1, 1, 128, 256, 257, -300,\n                                    2147483647, -2147483648])))\n    cases.append(random.choice([\" \", \"\\n\", \" \\t \"]).join(parts).encode())\n\nfails = 0\nfor merge in (False, True):\n    for i, data in enumerate(cases):\n        a = run(C, data, merge)\n        b = run(R, data, merge)\n        if a != b:\n            fails += 1\n            if fails <= 8:\n                print(\"MISMATCH merge=%s case %d len=%d head=%r\" %\n                      (merge, i, len(data), data[:120]))\n                print(\"  C :\", a[0], a[1][:200], a[2] if a[2] is None else a[2][:200])\n                print(\"  Rs:\", b[0], b[1][:200], b[2] if b[2] is None else b[2][:200])\nprint(\"cases=%d (x2 modes) fails=%d\" % (len(cases), fails))\nsys.exit(1 if fails else 0)\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":128,"cache_read_input_tokens":40721,"cache_creation":{"ephemeral_5m_input_tokens":128,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"5f166102-8b6e-4b46-bb99-11cf6c3381b2","uuid":"e52c2968-9e3a-4e3a-b51f-829cd129fa12","timestamp":"2026-08-28T04:06:06.629Z"}
