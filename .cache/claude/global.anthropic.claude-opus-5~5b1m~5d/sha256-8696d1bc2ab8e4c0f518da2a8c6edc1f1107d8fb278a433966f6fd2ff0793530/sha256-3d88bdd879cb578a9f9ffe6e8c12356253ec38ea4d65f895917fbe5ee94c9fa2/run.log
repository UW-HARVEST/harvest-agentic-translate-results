   L = random.choice([0,1,2,3,5,256,257,-1,200,random.randint(0,20)])\n        parts.append(str(L))\n        for _ in range(max(0, min(L, 300)) if L > 0 else 0):\n            parts.append(str(random.choice([0,1,255,256,-1,random.randint(-300,600)])))\n    # extra trailing ints for split/rotate\n    for _ in range(random.randint(0,2)):\n        parts.append(str(random.choice([0,1,-1,3,5,256,-7,random.randint(-20,300),\n                                        2147483647,-2147483648])))\n    sep = random.choice([\" \", \"\\n\", \"  \", \"\\t\", \" \\n \"])\n    s = sep.join(parts)\n    if random.random() < 0.15:\n        s += random.choice([\"\", \"\\n\", \" \", \"abc\", \"\\nxyz\"])\n    add(s)\n\nfails = 0\nfor i, data in enumerate(cases):\n    rc, so, se = run(C, data)\n    rc2, so2, se2 = run(R, data)\n    if (rc, so, se) != (rc2, so2, se2):\n        fails += 1\n        if fails <= 10:\n            print(\"MISMATCH case %d input=%r\" % (i, data[:200]))\n            print(\"  C : rc=%d out=%r err=%r\" % (rc, so[:300], se[:300]))\n            print(\"  Rs: rc=%d out=%r err=%r\" % (rc2, so2[:300], se2[:300]))\nprint(\"cases=%d fails=%d\" % (len(cases), fails))\nsys.exit(1 if fails else 0)\n","structuredPatch":[{"oldStart":1,"oldLines":7,"newStart":1,"newLines":7,"lines":[" #!/usr/bin/env python3"," import os, random, subprocess, sys"," ","-C = os.path.join(os.environ[\"TMPDIR\"], \"cref\", \"driver\")","+C = \"cref/driver\""," R = \"translation/target/release/driver\""," "," def run(exe, data):"]}],"userModified":false,"replaceAll":false}}
