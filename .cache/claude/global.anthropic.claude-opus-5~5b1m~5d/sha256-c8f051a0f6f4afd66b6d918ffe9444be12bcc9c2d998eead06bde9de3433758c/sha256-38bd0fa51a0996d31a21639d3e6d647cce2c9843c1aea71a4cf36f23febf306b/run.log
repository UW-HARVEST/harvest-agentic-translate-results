on goes through libc `realloc`/`free` so blocks stay interchangeable with the C macros.","ttft_ms":6292,"ttft_stream_ms":6125,"time_to_request_ms":45,"type":"result","duration_ms":1012574,"uuid":"15ddfce6-159d-49ea-bba1-0e9ddddec0a3","queued_turn_count":0}
