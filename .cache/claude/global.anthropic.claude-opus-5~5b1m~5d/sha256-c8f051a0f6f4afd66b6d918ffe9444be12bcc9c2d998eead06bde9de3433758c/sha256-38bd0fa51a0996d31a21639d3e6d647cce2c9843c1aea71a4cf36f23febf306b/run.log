{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_ahnnpsennkf6re76lskmwzbx4j2pqqxbvh2b36xt537twy7eeizq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_019kr4u2guAuH8RSLPz9F9ib","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-pMJpv7/.difftest/test.c","content":"/* Differential harness: drives the library through the very same macros the\n   C source defines, so we compare the C .so and the Rust .so behaviour. */\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stddef.h>\n#include <assert.h>\n#include \"prelude.h\"\n\nextern void arr_ins(int num);\nextern char *strkey(int n);\n\ntypedef struct { int key; int value; } imap;\ntypedef struct { long long key; int value; } lmap;\ntypedef struct { char *key; int value; } smap;\ntypedef struct { int key, b, c, d; } tstruct;\ntypedef struct { int key[2], b, c, d; } tstruct2;\n\nstatic void test_hashes(void)\n{\n  unsigned char buf[80];\n  size_t len, s;\n  size_t seeds[5] = { 0, 1, 0x31415926, 0xdeadbeefcafebabeULL, (size_t)-1 };\n  unsigned char hb[24] = { 0x01,0x02,0x03,0xFF, 0x80,0x00,0x00,0x00,\n                           0xff,0xff,0xff,0xff, 0x7f,0x80,0x81,0x82,\n                           0x00,0x00,0x00,0x80, 0x12,0x34,0x56,0x78 };\n  const char *strs[8] = { \"\", \"a\", \"ab\", \"abc\", \"hello world\",\n                          \"test_12345\", \"\\xff\\xfe\\xfd\\x80\", \"the quick brown fox jumps\" };\n  int i;\n\n  puts(\"--- hashes ---\");\n  for (i=0; i < 80; ++i) buf[i] = (unsigned char) (i*7+3);\n  for (s=0; s < 5; ++s)\n    for (len=0; len <= 48; ++len)\n      printf(\"hb %zu %zu %zu\\n\", s, len, stbds_hash_bytes(buf, len, seeds[s]));\n\n  for (s=0; s < 5; ++s)\n    for (len=0; len <= 24; ++len)\n      printf(\"hbq %zu %zu %zu\\n\", s, len, stbds_hash_bytes(hb, len, seeds[s]));\n\n  for (s=0; s < 5; ++s)\n    for (i=0; i < 8; ++i)\n      printf(\"hs %zu %d %zu\\n\", s, i, stbds_hash_string((char*) strs[i], seeds[s]));\n\n  /* 4/8 byte keys, the sizes actually used by the hash map */\n  for (i=-40; i < 40; ++i) {\n    int k = i;\n    long long k8 = (long long) i * 1103515245LL;\n    printf(\"hk4 %d %zu\\n\", i, stbds_hash_bytes(&k, sizeof k, 0x31415926));\n    printf(\"hk8 %d %zu\\n\", i, stbds_hash_bytes(&k8, sizeof k8, 0x31415926));\n  }\n}\n\nstatic void test_arrays(void)\n{\n  int *a = NULL;\n  int *b;\n  void *g;\n  int i;\n\n  puts(\"--- arrays ---\");\n  printf(\"empty len=%td lenu=%zu cap=%zu\\n\", arrlen(a), arrlenu(a), arrcap(a));\n  for (i=0; i < 25; ++i) {\n    arrput(a, i*3);\n    printf(\"put %d len=%td cap=%zu\\n\", i, arrlen(a), arrcap(a));\n  }\n  printf(\"last=%d\\n\", arrlast(a));\n  printf(\"pop=%d len=%td\\n\", arrpop(a), arrlen(a));\n  arrins(a, 5, 777);\n  arrinsn(a, 2, 3);\n  a[2] = -1; a[3] = -2; a[4] = -3;\n  for (i=0; i < arrlen(a); ++i) printf(\"%d \", a[i]);\n  printf(\"\\n\");\n  arrdel(a, 0);\n  arrdeln(a, 3, 4);\n  arrdelswap(a, 1);\n  for (i=0; i < arrlen(a); ++i) printf(\"%d \", a[i]);\n  printf(\"\\n\");\n  arrsetcap(a, 100);\n  printf(\"cap=%zu len=%td\\n\", arrcap(a), arrlen(a));\n  arrsetlen(a, 60);\n  printf(\"cap=%zu len=%td\\n\", arrcap(a), arrlen(a));\n  arrsetlen(a, 8);\n  printf(\"cap=%zu len=%td\\n\", arrcap(a), arrlen(a));\n  b = arraddnptr(a, 5);\n  printf(\"addnptr off=%td len=%td cap=%zu\\n\", (ptrdiff_t)(b-a), arrlen(a), arrcap(a));\n  printf(\"addnindex=%td len=%td\\n\", (ptrdiff_t) arraddnindex(a, 3), arrlen(a));\n  arraddn(a, 0);\n  printf(\"addn0 len=%td\\n\", arrlen(a));\n  b = arraddnptr(a, 0);\n  printf(\"addnptr0 off=%td\\n\", (ptrdiff_t)(b-a));\n  arrfree(a);\n  printf(\"freed len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n\n  /* arrfreef, used directly */\n  arrput(a, 1); arrput(a, 2);\n  stbds_arrfreef(a);\n  a = NULL;\n\n  /* arrgrowf directly, exercising every growth branch */\n  g = stbds_arrgrowf(NULL, 8, 0, 1);\n  printf(\"g0 len=%zu cap=%zu temp=%td ht=%d\\n\", stbds_header(g)->length,\n         stbds_header(g)->capacity, stbds_header(g)->temp,\n         stbds_header(g)->hash_table == NULL);\n  g = stbds_arrgrowf(g, 8, 10, 0);\n  printf(\"g1 cap=%zu\\n\", stbds_header(g)->capacity);\n  g = stbds_arrgrowf(g, 8, 0, 3);\n  printf(\"g2 cap=%zu\\n\", stbds_header(g)->capacity);\n  g = stbds_arrgrowf(g, 8, 0, 1000);\n  printf(\"g3 cap=%zu\\n\", stbds_header(g)->capacity);\n  g = stbds_arrgrowf(g, 8, 1, 0);\n  printf(\"g4 cap=%zu\\n\", stbds_header(g)->capacity);\n  stbds_arrfreef(g);\n\n  for (i=0; i < 24; ++i) {\n    void *h = stbds_arrgrowf(NULL, (size_t) (i%7)+1, (size_t) i, (size_t) (i%5));\n    printf(\"gg %d cap=%zu len=%zu\\n\", i, stbds_header(h)->capacity, stbds_header(h)->length);\n    stbds_arrfreef(h);\n  }\n}\n\nstatic void dump_imap(imap *m)\n{\n  ptrdiff_t i;\n  for (i=0; i < hmlen(m); ++i) printf(\"(%d:%d)\", m[i].key, m[i].value);\n  printf(\"\\n\");\n}\n\nstatic void test_hmap(void)\n{\n  imap *m = NULL;\n  lmap *m8 = NULL;\n  tstruct *ts = NULL;\n  tstruct2 *ts2 = NULL;\n  int i;\n  ptrdiff_t temp;\n\n  puts(\"--- hmap int ---\");\n  hmdefault(m, -999);\n  printf(\"empty get=%d len=%td\\n\", hmget(m, 5), hmlen(m));\n  for (i=0; i < 300; ++i) {\n    hmput(m, i*17, i);\n    if (i % 37 == 0) printf(\"put %d len=%td idx=%td\\n\", i, hmlen(m), hmgeti(m, i*17));\n  }\n  printf(\"len=%td lenu=%zu\\n\", hmlen(m), hmlenu(m));\n  for (i=0; i < 340; i += 3)\n    printf(\"get %d -> %d %td %d\\n\", i*17, hmget(m, i*17), hmgeti(m, i*17),\n           hmgetp_null(m, i*17) != NULL);\n  for (i=0; i < 340; i += 7)\n    printf(\"gets %d -> %d %td\\n\", i*17, hmget_ts(m, i*17, temp), hmgeti_ts(m, i*17, temp));\n  dump_imap(m);\n  for (i=0; i < 300; i += 2)\n    printf(\"del %d -> %td len=%td\\n\", i*17, (ptrdiff_t) hmdel(m, i*17), hmlen(m));\n  printf(\"after del len=%td\\n\", hmlen(m));\n  dump_imap(m);\n  for (i=0; i < 300; i += 2) hmput(m, i*17, -i);\n  printf(\"re-put len=%td\\n\", hmlen(m));\n  dump_imap(m);\n  for (i=299; i >= 0; --i) hmdel(m, i*17);\n  printf(\"all deleted len=%td\\n\", hmlen(m));\n  dump_imap(m);\n  hmfree(m);\n  printf(\"freed len=%td\\n\", hmlen(m));\n\n  puts(\"--- hmap 8 byte keys ---\");\n  for (i=0; i < 200; ++i) hmput(m8, (long long) i * 1103515245LL, i);\n  printf(\"len=%td\\n\", hmlen(m8));\n  for (i=0; i < 210; i += 5)\n    printf(\"get %d -> %d %td\\n\", i, hmget(m8, (long long) i * 1103515245LL),\n           hmgeti(m8, (long long) i * 1103515245LL));\n  for (i=0; i < 200; i += 3) hmdel(m8, (long long) i * 1103515245LL);\n  printf(\"len=%td\\n\", hmlen(m8));\n  for (i=0; i < hmlen(m8); ++i) printf(\"(%lld:%d)\", m8[i].key, m8[i].value);\n  printf(\"\\n\");\n  hmfree(m8);\n\n  puts(\"--- hmap structs ---\");\n  for (i=0; i < 120; ++i) {\n    tstruct t;\n    t.key = i*3; t.b = i; t.c = i+1; t.d = i+2;\n    hmputs(ts, t);\n  }\n  printf(\"len=%td\\n\", hmlen(ts));\n  for (i=0; i < 130; i += 4) {\n    tstruct t = hmgets(ts, i*3);\n    printf(\"gets %d -> %d %d %d %d\\n\", i*3, t.key, t.b, t.c, t.d);\n  }\n  for (i=0; i < 120; i += 5) printf(\"del %d -> %td\\n\", i*3, (ptrdiff_t) hmdel(ts, i*3));\n  for (i=0; i < hmlen(ts); ++i) printf(\"(%d:%d:%d:%d)\", ts[i].key, ts[i].b, ts[i].c, ts[i].d);\n  printf(\"\\n\");\n  hmfree(ts);\n\n  puts(\"--- hmap struct2 ---\");\n  {\n    tstruct2 d0;\n    memset(&d0, 0, sizeof d0);\n    d0.b = -7;\n    hmdefaults(ts2, d0);\n  }\n  for (i=0; i < 100; ++i) {\n    tstruct2 t;\n    memset(&t, 0, sizeof t);\n    t.key[0] = i; t.key[1] = i*i; t.b = i; t.c = 2*i; t.d = 3*i;\n    hmputs(ts2, t);\n  }\n  printf(\"len=%td\\n\", hmlen(ts2));\n  for (i=0; i < 110; i += 3) {\n    tstruct2 q;\n    memset(&q, 0, sizeof q);\n    q.key[0] = i; q.key[1] = i*i;\n    printf(\"geti %d -> %td\\n\", i, hmgeti(ts2, q.key));\n  }\n  hmfree(ts2);\n}\n\nstatic char *persistent[400];\n\nstatic void test_smap(void)\n{\n  smap *s = NULL;\n  smap *sa = NULL;\n  smap *sd = NULL;\n  int i;\n\n  puts(\"--- smap default ---\");\n  for (i=0; i < 400; ++i) {\n    persistent[i] = (char *) malloc(32);\n    sprintf(persistent[i], \"key_%d\", i);\n  }\n  shdefault(s, -1234);\n  printf(\"empty get=%d\\n\", shget(s, \"nope\"));\n  for (i=0; i < 300; ++i) shput(s, persistent[i], i);\n  printf(\"len=%td lenu=%zu\\n\", shlen(s), shlenu(s));\n  for (i=0; i < 400; i += 7)\n    printf(\"get %d -> %d %td %d\\n\", i, shget(s, persistent[i]), shgeti(s, persistent[i]),\n           shgetp_null(s, persistent[i]) != NULL);\n  for (i=0; i < 300; i += 3) printf(\"del %d -> %td\\n\", i, (ptrdiff_t) shdel(s, persistent[i]));\n  printf(\"len=%td\\n\", shlen(s));\n  for (i=0; i < shlen(s); ++i) printf(\"(%s:%d)\", s[i].key, s[i].value);\n  printf(\"\\n\");\n  for (i=0; i < 300; ++i) printf(\"%d\", shgeti(s, persistent[i]) >= 0);\n  printf(\"\\n\");\n  shfree(s);\n\n  puts(\"--- smap arena ---\");\n  sh_new_arena(sa);\n  for (i=0; i < 300; ++i) shput(sa, strkey(i), i*2);\n  printf(\"len=%td\\n\", shlen(sa));\n  for (i=0; i < 320; i += 5) printf(\"get %d -> %d %td\\n\", i, shget(sa, strkey(i)), shgeti(sa, strkey(i)));\n  for (i=0; i < shlen(sa); ++i) printf(\"(%s:%d)\", sa[i].key, sa[i].value);\n  printf(\"\\n\");\n  /* long keys to force the big-block path of stbds_stralloc */\n  {\n    char big[2000];\n    int j;\n    for (j=0; j < 1999; ++j) big[j] = (char) ('a' + (j % 26));\n    big[1999] = 0;\n    shput(sa, big, 4242);\n    printf(\"big -> %d %td\\n\", shget(sa, big), shgeti(sa, big));\n    big[500] = 0;\n    shput(sa, big, 99);\n    printf(\"big2 -> %d\\n\", shget(sa, big));\n  }\n  for (i=0; i < 300; i += 4) shdel(sa, strkey(i));\n  printf(\"len=%td\\n\", shlen(sa));\n  for (i=0; i < shlen(sa); ++i) printf(\"(%.16s:%d)\", sa[i].key, sa[i].value);\n  printf(\"\\n\");\n  shfree(sa);\n\n  puts(\"--- smap strdup ---\");\n  sh_new_strdup(sd);\n  for (i=0; i < 300; ++i) shput(sd, strkey(i), i*3);\n  printf(\"len=%td\\n\", shlen(sd));\n  for (i=0; i < 320; i += 5) printf(\"get %d -> %d %td\\n\", i, shget(sd, strkey(i)), shgeti(sd, strkey(i)));\n  for (i=0; i < 300; i += 3) printf(\"del %d -> %td\\n\", i, (ptrdiff_t) shdel(sd, strkey(i)));\n  printf(\"len=%td\\n\", shlen(sd));\n  for (i=0; i < shlen(sd); ++i) printf(\"(%s:%d)\", sd[i].key, sd[i].value);\n  printf(\"\\n\");\n  shfree(sd);\n\n  puts(\"--- smap shputs ---\");\n  {\n    smap *sp = NULL;\n    sh_new_strdup(sp);\n    for (i=0; i < 100; ++i) {\n      smap e;\n      e.key = strkey(i);\n      e.value = i*7;\n      shputs(sp, e);\n    }\n    printf(\"len=%td\\n\", shlen(sp));\n    for (i=0; i < 100; i += 6) {\n      smap e = shgets(sp, strkey(i));\n      printf(\"gets %d -> %s %d\\n\", i, e.key, e.value);\n    }\n    shfree(sp);\n  }\n\n  for (i=0; i < 400; ++i) free(persistent[i]);\n}\n\nstatic void test_seed(void)\n{\n  imap *m = NULL;\n  int i;\n  puts(\"--- seed ---\");\n  stbds_rand_seed(12345);\n  for (i=0; i < 64; ++i) hmput(m, i, i*i);\n  printf(\"len=%td\\n\", hmlen(m));\n  for (i=0; i < 64; ++i) printf(\"%td,\", hmgeti(m, i));\n  printf(\"\\n\");\n  for (i=0; i < 64; ++i) printf(\"(%d:%d)\", m[i].key, m[i].value);\n  printf(\"\\n\");\n  hmfree(m);\n\n  stbds_rand_seed(0);\n  m = NULL;\n  for (i=0; i < 40; ++i) hmput(m, i*i, i);\n  for (i=0; i < 40; ++i) printf(\"%td,\", hmgeti(m, i*i));\n  printf(\"\\n\");\n  hmfree(m);\n  stbds_rand_seed(0x31415926);\n}\n\nstatic void test_misc(void)\n{\n  int i;\n  puts(\"--- misc ---\");\n  for (i=-5; i < 12; ++i) printf(\"strkey(%d)=%s\\n\", i, strkey(i));\n  printf(\"strkey(min)=%s\\n\", strkey(-2147483647-1));\n  printf(\"strkey(max)=%s\\n\", strkey(2147483647));\n  for (i=-3; i < 6; ++i) { arr_ins(i); printf(\"arr_ins(%d) ok\\n\", i); }\n\n  /* string arena used directly */\n  {\n    stbds_string_arena arena;\n    char *p[64];\n    memset(&arena, 0, sizeof arena);\n    for (i=0; i < 64; ++i) {\n      char tmp[300];\n      int j, n = (i*37) % 280;\n      for (j=0; j < n; ++j) tmp[j] = (char) ('A' + (j+i) % 26);\n      tmp[n] = 0;\n      p[i] = stralloc(&arena, tmp);\n      printf(\"stralloc %d len=%zu str=%.12s\\n\", i, strlen(p[i]), p[i]);\n    }\n    for (i=0; i < 64; ++i) printf(\"%.6s|\", p[i]);\n    printf(\"\\n\");\n    strreset(&arena);\n    printf(\"reset ok\\n\");\n  }\n\n  /* hmput_default / hmget_key on raw pointers */\n  {\n    void *t = stbds_hmput_default(NULL, sizeof(imap));\n    ptrdiff_t temp;\n    int key = 7;\n    printf(\"default len=%zu\\n\", stbds_header((char*)t - sizeof(imap))->length);\n    t = stbds_hmget_key_ts(t, sizeof(imap), &key, sizeof key, &temp, STBDS_HM_BINARY);\n    printf(\"ts temp=%td\\n\", temp);\n    t = stbds_hmget_key(t, sizeof(imap), &key, sizeof key, STBDS_HM_BINARY);\n    printf(\"get temp=%td\\n\", stbds_header((char*)t - sizeof(imap))->temp);\n    t = stbds_hmput_key(t, sizeof(imap), &key, sizeof key, STBDS_HM_BINARY);\n    printf(\"put temp=%td\\n\", stbds_header((char*)t - sizeof(imap))->temp);\n    t = stbds_hmdel_key(t, sizeof(imap), &key, sizeof key, 0, STBDS_HM_BINARY);\n    printf(\"del temp=%td\\n\", stbds_header((char*)t - sizeof(imap))->temp);\n    printf(\"hmdel NULL -> %d\\n\", stbds_hmdel_key(NULL, sizeof(imap), &key, sizeof key, 0, STBDS_HM_BINARY) == NULL);\n    stbds_hmfree_func((char*)t - sizeof(imap), sizeof(imap));\n    stbds_hmfree_func(NULL, sizeof(imap));\n  }\n\n  /* churn: grow, shrink, rebuild the hash index repeatedly */\n  {\n    imap *m = NULL;\n    int round;\n    for (round=0; round < 6; ++round) {\n      for (i=0; i < 500; ++i) hmput(m, i ^ (round*7919), i+round);\n      for (i=0; i < 500; i += 2) hmdel(m, i ^ (round*7919));\n      printf(\"round %d len=%td\\n\", round, hmlen(m));\n      for (i=0; i < 500; i += 11) printf(\"%td,\", hmgeti(m, i ^ (round*7919)));\n      printf(\"\\n\");\n    }\n    for (i=0; i < hmlen(m); ++i) printf(\"(%d:%d)\", m[i].key, m[i].value);\n    printf(\"\\n\");\n    hmfree(m);\n  }\n}\n\nint main(void)\n{\n  test_hashes();\n  test_arrays();\n  test_hmap();\n  test_smap();\n  test_seed();\n  test_misc();\n  puts(\"done\");\n  return 0;\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_det