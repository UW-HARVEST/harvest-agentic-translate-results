   }\n    h /= 60.0f;\n    i = (int)floorf(h);\n    f = h - i;\n    p = v * (1 - s);\n    q = v * (1 - s * f);\n    t = v * (1 - s * (1 - f));\n    switch (i) {\n    case 0:\n        r = v;\n        g = t;\n        b = p;\n        break;\n    case 1:\n        r = q;\n        g = v;\n        b = p;\n        break;\n    case 2:\n        r = p;\n        g = v;\n        b = t;\n        break;\n    case 3:\n        r = p;\n        g = q;\n        b = v;\n        break;\n    case 4:\n        r = t;\n        g = p;\n        b = v;\n        break;\n    default:\n        r = v;\n        g = p;\n        b = q;\n        break;\n    }\n    dest[0] = r;\n    dest[1] = g;\n    dest[2] = b;\n}\n","numLines":60,"startLine":1,"totalLines":60}}}
