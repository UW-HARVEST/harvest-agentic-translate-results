quotient (no double-rounding error).","+mutate m_f64div '    h = divss(h, 60.0f32);@@@    h = if h.is_nan() { quiet(h) } else { (h as f64 / 60.0f64) as c_float };'","+run_mutant m_f64div SURVIVES","+","+echo \"== 18 int->float conversion routed through f64\"","+# EQUIVALENT: i32 -> f64 is exact, so rounding that to f32 equals i32 -> f32.","+mutate m_i2f '    f = subss(h, i as c_float);@@@    f = subss(h, i as f64 as c_float);'","+run_mutant m_i2f SURVIVES","+"," echo","-if [ \"$SURVIVORS\" -eq 0 ]; then","-  echo \"ALL MUTANTS KILLED — the suite is sensitive to each mistranslation\"","+if [ \"$PROBLEMS\" -eq 0 ]; then","+  echo \"ALL PREDICTIONS HELD — every behavioural mutant was killed by its target\"","+  echo \"test, and every provably-equivalent mutant survived.\""," else","-  echo \"$SURVIVORS mutant(s) survived or misbehaved\"","+  echo \"$PROBLEMS unexpected result(s)\""," fi","-exit \"$SURVIVORS\"","+exit \"$PROBLEMS\""]}],"originalFile":"#!/usr/bin/env bash\n# Sensitivity check for the differential suite.\n#\n# A passing test suite only means something if it can FAIL. This script builds a\n# set of deliberately-wrong Rust shared objects (each one a single, plausible\n# mistranslation of `src/lib.rs`), points the suite at each of them via\n# HSV_RUST_SO, and asserts that the suite rejects every one. A mutant that\n# survives is a blind spot in the tests.\n#\n# Usage: ./mutation_check.sh        (run from the `translation` directory)\nset -uo pipefail\n\nCRATE_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\nOUT=\"$CRATE_DIR/target/mutants\"\nmkdir -p \"$OUT\"\nSURVIVORS=0\n\n# name|python replacement expression applied to src/lib.rs\nmutate() {\n  local name=\"$1\" script=\"$2\"\n  python3 - \"$OUT/$name.rs\" \"$script\" <<'PY'\nimport sys\ndst, script = sys.argv[1], sys.argv[2]\ns = open('src/lib.rs').read()\nold, new = script.split('@@@')\nold = old.replace('\\\\n', '\\n')\nnew = new.replace('\\\\n', '\\n')\nif old not in s:\n    sys.exit(f\"mutation target not found: {old!r}\")\nopen(dst, 'w').write(s.replace(old, new, 1))\nPY\n}\n\nrun_mutant() {\n  local name=\"$1\" expect=\"$2\"\n  if ! rustc --crate-type cdylib --edition 2021 -O -A warnings \\\n       -o \"$OUT/lib$name.so\" \"$OUT/$name.rs\" 2>\"$OUT/$name.build.log\"; then\n    echo \"  !! could not compile mutant $name\"; tail -3 \"$OUT/$name.build.log\"\n    SURVIVORS=$((SURVIVORS + 1)); return\n  fi\n  local log=\"$OUT/$name.test.log\"\n  HSV_RUST_SO=\"$OUT/lib$name.so\" timeout 600 cargo test --offline --tests \\\n      --no-fail-fast >\"$log\" 2>&1\n  local caught\n  caught=$(grep -oE '^    (b[0-9]+_[a-z0-9_]+|err[0-9]+_[a-z0-9_]+)' \"$log\" |\n           sed 's/^ *//' | sort -u | tr '\\n' ' ')\n  if [ -z \"$caught\" ]; then\n    echo \"  SURVIVED (blind spot!): $name\"\n    SURVIVORS=$((SURVIVORS + 1))\n  else\n    echo \"  killed by: $caught\"\n    if [ -n \"$expect\" ] && ! grep -q \"    $expect\" \"$log\"; then\n      echo \"  !! expected $expect to catch it\"\n      SURVIVORS=$((SURVIVORS + 1))\n    fi\n  fi\n}\n\ncd \"$CRATE_DIR\" || exit 1\n\necho \"== mutant 1: plain (sinkable) loads instead of pinned unconditional movss\"\nmutate m_plainload 'unsafe fn load_f32(p: *const c_float) -> c_float {\\n    let out: c_float;@@@unsafe fn load_f32(p: *const c_float) -> c_float {\\n    return *p;\\n    #[allow(unreachable_code)] let out: c_float;'\nrun_mutant m_plainload err22_unconditional_h_load_faults\n\necho \"== mutant 2: let LLVM pick the SSE operand order (NaN payload selection)\"\nmutate m_nanorder '    p = mulss(subss(1.0f32, s), v);@@@    p = v * (1.0f32 - s);'\nrun_mutant m_nanorder b41_nan_payload_cross_product\n\necho \"== mutant 3: Rust's saturating float->int cast instead of cvttss2si\"\nmutate m_satcast '    if x.is_nan() || x >= 2_147_483_648.0f32 || x <= -2_147_483_648.0f32 {\\n        c_int::MIN\\n    } else {\\n        x as c_int\\n    }@@@    x as c_int'\nrun_mutant m_satcast b23_hue_int_conversion_boundary\n\necho \"== mutant 4: reversed store order (dest[2] first)\"\nmutate m_storeorder '    store_f32(dest.add(0), r);\\n    store_f32(dest.add(1), g);\\n    store_f32(dest.add(2), b);@@@    store_f32(dest.add(2), b);\\n    store_f32(dest.add(1), g);\\n    store_f32(dest.add(0), r);'\nrun_mutant m_storeorder err23_partial_store_before_fault\n\necho \"== mutant 5: switch arms 3 and 4 swapped\"\nmutate m_swaparms '        3 => {\\n            r = p;\\n            g = q;\\n            b = v;\\n        }@@@        3 => {\\n            r = t;\\n            g = p;\\n            b = v;\\n        }'\nrun_mutant m_swaparms b13_arm3_random\n\necho \"== mutant 6: -0.0 no longer takes the s == 0 short-circuit\"\nmutate m_negzero '    if s == 0.0 {@@@    if s == 0.0 && !s.is_sign_negative() {'\nrun_mutant m_negzero b02_s_negative_zero_random\n\necho \"== mutant 7: SNaN operands not quieted on propagation\"\nmutate m_noquiet 'fn quiet(x: c_float) -> c_float {\\n    c_float::from_bits(x.to_bits() | 0x0040_0000)@@@fn quiet(x: c_float) -> c_float {\\n    x'\nrun_mutant m_noquiet err04_s_is_signalling_nan\n\necho \"== mutant 8: hue divided by 60.0 as f64 (precision change)\"\nmutate m_f64div '    h = divss(h, 60.0f32);@@@    h = (h as f64 / 60.0f64) as c_float;'\nrun_mutant m_f64div ''\n\necho\nif [ \"$SURVIVORS\" -eq 0 ]; then\n  echo \"ALL MUTANTS KILLED — the suite is sensitive to each mistranslation\"\nelse\n  echo \"$SURVIVORS mutant(s) survived or misbehaved\"\nfi\nexit \"$SURVIVORS\"\n","userModified":false}}
