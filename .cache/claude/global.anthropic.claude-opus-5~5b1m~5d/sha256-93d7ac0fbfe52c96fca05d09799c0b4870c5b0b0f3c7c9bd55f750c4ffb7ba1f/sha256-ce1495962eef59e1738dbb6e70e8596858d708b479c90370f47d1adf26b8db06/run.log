: *const c_float) {\n    // float r, g, b;\n    // float f, p, q, t;\n    let r: c_float;\n    let g: c_float;\n    let b: c_float;\n    let f: c_float;\n    let p: c_float;\n    let q: c_float;\n    let t: c_float;\n\n    // float h = src[0]; float s = src[1]; float v = src[2];\n    //\n    // These are `read_volatile`s (not plain loads) on purpose. The C loads all\n    // three elements *before* the `s == 0` test, in index order, and gcc emits\n    // three unconditional `movss`es for them. With plain loads LLVM legally\n    // sinks the `src[0]` load into the `s != 0` branch (verified in the\n    // generated code), which makes the two objects behave differently when\n    // `src[0]` is unreadable but `src[1]`/`src[2]` are and `s == 0`: the C\n    // faults, the Rust would not. `read_volatile` pins the accesses to the C's\n    // order and count without changing any computed value.\n    let mut h: c_float = core::ptr::read_volatile(src.add(0));\n    let s: c_float = core::ptr::read_volatile(src.add(1));\n    let v: c_float = core::ptr::read_volatile(src.add(2));\n\n    // int i;\n    let i: c_int;\n\n    // if (s == 0) { dest[0] = dest[1] = dest[2] = v; return; }\n    if s == 0.0 {\n        // Individual, ordered 4-byte stores, like the C's three `movss`es: a\n        // merged 8-byte store would change which prefix of `dest` is already\n        // committed when a later element is unwritable.\n        core::ptr::write_volatile(dest.add(0), v);\n        core::ptr::write_volatile(dest.add(1), v);\n        core::ptr::write_volatile(dest.add(2), v);\n        return;\n    }\n\n    // h /= 60.0f;\n    h /= 60.0f32;\n    // i = (int)floorf(h);\n    i = c_float_to_int(h.floor());\n    // f = h - i;\n    f = h - (i as c_float);\n    // p = v * (1 - s);\n    p = v * (1.0f32 - s);\n    // q = v * (1 - s * f);\n    q = v * (1.0f32 - s * f);\n    // t = v * (1 - s * (1 - f));\n    t = v * (1.0f32 - s * (1.0f32 - f));\n\n    match i {\n        0 => {\n            r = v;\n    