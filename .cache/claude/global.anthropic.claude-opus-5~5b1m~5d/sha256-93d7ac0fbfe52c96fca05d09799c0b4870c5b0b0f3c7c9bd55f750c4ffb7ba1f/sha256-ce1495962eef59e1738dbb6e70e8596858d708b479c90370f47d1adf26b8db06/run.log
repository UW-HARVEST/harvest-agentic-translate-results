{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01VbRaC9m2BTVgWe7C7aSbLc","type":"tool_result","content":"void hsv_to_rgb(float *dest, const float *src);\n=== Cargo.toml ===\n[package]\nname = \"translation\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[lib]\nname = \"hsv_to_rgb_lib\"\ncrate-type = [\"cdylib\"]\npath = \"src/lib.rs\"\n\n[profile.release]\npanic = \"abort\"\n\n[workspace]\n=== lib.rs ===\n     1\t//! Rust translation of the C library in `c_src/`.\n     2\t//!\n     3\t//! Public ABI (from `nm -D` on the C shared object):\n     4\t//!   * `hsv_to_rgb`\n     5\t//!\n     6\t//! The translation is intentionally literal: operation order, `f32` arithmetic,\n     7\t//! the `(int)floorf(h)` truncation and the `switch` fall-through structure are\n     8\t//! reproduced exactly so that the output is bit-identical to the C version.\n     9\t\n    10\tuse std::ffi::c_float;\n    11\tuse std::ffi::c_int;\n    12\t\n    13\t/// Reproduces the target machine's native `float` -> `int` truncating\n    14\t/// conversion, matching what the C compiler emits for `(int)expr`.\n    15\t///\n    16\t/// Rust's `as` cast *saturates* (NaN -> 0, out-of-range -> `i32::MIN`/`i32::MAX`),\n    17\t/// but C leaves the out-of-range case undefined, so the observable behaviour of\n    18\t/// the C shared object is whatever the hardware does. On x86-64 the compiler\n    19\t/// emits `cvttss2si`, which raises #IA and returns the \"integer indefinite\"\n    20\t/// value `0x8000_0000` for NaN *and* for any value outside `[-2^31, 2^31)`.\n    21\t/// Faithfully mirroring that is required for bit-identical output (e.g. a NaN\n    22\t/// hue must select the `switch` `default` arm, not `case 0`).\n    23\t#[inline]\n    24\t#[cfg(target_arch = \"x86_64\")]\n    25\tfn c_float_to_int(x: c_float) -> c_int {\n    26\t    if x.is_nan() || x >= 2_147_483_648.0f32 || x <= -2_147_483_648.0f32 {\n    27\t        c_int::MIN\n    28\t    } else {\n    29\t        x as c_int\n    30\t    }\n    31\t}\n    32\t\n    33\t/// Non-x86-64 fallback: AArch64's `fcvtzs` (and most other ISAs) clamp exactly\n    34\t/// the way Rust's saturating `as` cast does, so the plain cast is already the\n    35\t/// faithful translation there.\n    36\t#[inline]\n    37\t#[cfg(not(target_arch = \"x86_64\"))]\n    38\tfn c_float_to_int(x: c_float) -> c_int {\n    39\t    x as c_int\n    40\t}\n    41\t\n    42\t/// ```c\n    43\t/// void hsv_to_rgb(float *dest, const float *src);\n    44\t/// ```\n    45\t///\n    46\t/// `src` is read as `[h, s, v]`, `dest` is written as `[r, g, b]`.\n    47\t#[unsafe(no_mangle)]\n    48\tpub unsafe extern \"C\" fn hsv_to_rgb(dest: *mut c_float, src: *const c_float) {\n    49\t    // float r, g, b;\n    50\t    // float f, p, q, t;\n    51\t    let r: c_float;\n    52\t    let g: c_float;\n    53\t    let b: c_float;\n    54\t    let f: c_float;\n    55\t    let p: c_float;\n    56\t    let q: c_float;\n    57\t    let t: c_float;\n    58\t\n    59\t    // float h = src[0]; float s = src[1]; float v = src[2];\n    60\t    let mut h: c_float = *src.add(0);\n    61\t    let s: c_float = *src.add(1);\n    62\t    let v: c_float = *src.add(2);\n    63\t\n    64\t    // int i;\n    65\t    let i: c_int;\n    66\t\n    67\t    // if (s == 0) { dest[0] = dest[1] = dest[2] = v; return; }\n    68\t    if s == 0.0 {\n    69\t        *dest.add(0) = v;\n    70\t        *dest.add(1) = v;\n    71\t        *dest.add(2) = v;\n    72\t        return;\n    73\t    }\n    74\t\n    75\t    // h /= 60.0f;\n    76\t    h /= 60.0f32;\n    77\t    // i = (int)floorf(h);\n    78\t    i = c_float_to_int(h.floor());\n    79\t    // f = h - i;\n    80\t    f = h - (i as c_float);\n    81\t    // p = v * (1 - s);\n    82\t    p = v * (1.0f32 - s);\n    83\t    // q = v * (1 - s * f);\n    84\t    q = v * (1.0f32 - s * f);\n    85\t    // t = v * (1 - s * (1 - f));\n    86\t    t = v * (1.0f32 - s * (1.0f32 - f));\n    87\t\n    88\t    matc