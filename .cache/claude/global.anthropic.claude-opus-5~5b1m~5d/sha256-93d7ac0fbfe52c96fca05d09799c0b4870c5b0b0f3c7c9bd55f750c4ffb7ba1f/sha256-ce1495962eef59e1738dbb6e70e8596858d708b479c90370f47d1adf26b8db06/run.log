t[2] = v; return; }\n    if s == 0.0 {\n        // Individual, ordered 4-byte stores, like the C's three `movss`es: a\n        // merged 8-byte store would change which prefix of `dest` is already\n        // committed when a later element is unwritable.\n        core::ptr::write_volatile(dest.add(0), v);\n        core::ptr::write_volatile(dest.add(1), v);\n        core::ptr::write_volatile(dest.add(2), v);\n        return;\n    }\n\n    // h /= 60.0f;\n    h /= 60.0f32;\n    // i = (int)floorf(h);\n    i = c_float_to_int(h.floor());\n    // f = h - i;\n    f = h - (i as c_float);\n    // p = v * (1 - s);\n    p = v * (1.0f32 - s);\n    // q = v * (1 - s * f);\n    q = v * (1.0f32 - s * f);\n    // t = v * (1 - s * (1 - f));\n    t = v * (1.0f32 - s * (1.0f32 - f));\n\n    match i {\n        0 => {\n            r = v;\n            g = t;\n            b = p;\n        }\n        1 => {\n            r = q;\n            g = v;\n            b = p;\n        }\n        2 => {\n            r = p;\n            g = v;\n            b = t;\n        }\n        3 => {\n            r = p;\n            g = q;\n            b = v;\n        }\n        4 => {\n            r = t;\n            g = p;\n            b = v;\n        }\n        _ => {\n            r = v;\n            g = p;\n            b = q;\n        }\n    }\n\n    // dest[0] = r; dest[1] = g; dest[2] = b;\n    *dest.add(0) = r;\n    *dest.add(1) = g;\n    *dest.add(2) = b;\n}\n","structuredPatch":[{"oldStart":131,"oldLines":7,"newStart":131,"newLines":7,"lines":["     }"," ","     // dest[0] = r; dest[1] = g; dest[2] = b;","-    *dest.add(0) = r;","-    *dest.add(1) = g;","-    *dest.add(2) = b;","+    core::ptr::write_volatile(dest.add(0), r);","+    core::ptr::write_volatile(dest.add(1), g);","+    core::ptr::write_volatile(dest.add(2), b);"," }"]}],"userModified":false,"replaceAll":false}}
