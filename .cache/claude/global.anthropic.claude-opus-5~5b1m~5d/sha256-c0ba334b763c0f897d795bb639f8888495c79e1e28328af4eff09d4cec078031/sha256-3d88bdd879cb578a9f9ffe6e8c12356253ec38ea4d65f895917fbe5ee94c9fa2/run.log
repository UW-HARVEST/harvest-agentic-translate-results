t b = 0, z = 0;\n    scanf(\"%u\", &x);\n    scanf(\"%u\", &y);\n    scanf(\"%d\", &b);\n    scanf(\"%d\", &z);\n    driver(x, y, !!b, z);\n    return 0;\n}","numLines":52,"startLine":1,"totalLines":52}}}
