 b'd' as c_char, b'\\n' as c_char, 0];\n40\t\n41\t// void printIntPtrLine(const int *intNumber)\n42\t// {\n43\t//     printf(\"%d\\n\", *intNumber);\n44\t// }\n45\t#[unsafe(no_mangle)]\n46\tpub unsafe extern \"C\" fn printIntPtrLine(intNumber: *const c_int) {\n47\t    unsafe {\n48\t        printf(FMT_D_NL.as_ptr(), *intNumber);\n49\t    }\n50\t}\n51\t\n52\t// void bad()\n53\t// {\n54\t//     int *data;\n55\t//     printIntPtrLine(data);\n56\t// }\n57\t//\n58\t// CWE-457: `data` is never initialised, so an indeterminate pointer value is\n59\t// read off the stack and handed to printIntPtrLine, which dereferences it.\n60\t// This bug is reproduced faithfully (NOT fixed): the uninitialised stack slot\n61\t// is read through a volatile load so the compiler cannot fold the read away.\n62\t#[unsafe(no_mangle)]\n63\tpub unsafe extern \"C\" fn bad() {\n64\t    let data: MaybeUninit<*const c_int> = MaybeUninit::uninit();\n65\t    let data_val: *const c_int = unsafe { core::ptr::read_volatile(data.as_ptr()) };\n66\t    unsafe {\n67\t        printIntPtrLine(data_val);\n68\t    }\n69\t}\n70\t\n71\t// void good()\n72\t// {\n73\t//     int data;\n74\t//     data = 5;\n75\t//     int *data_addr;\n76\t//     data_addr = &data;\n77\t//     printIntPtrLine(data_addr);\n78\t// }\n79\t#[unsafe(no_mangle)]\n80\tpub unsafe extern \"C\" fn good() {\n81\t    let mut data: MaybeUninit<c_int> = MaybeUninit::uninit();\n82\t    data.write(5);\n83\t    let data_addr: *const c_int = data.as_ptr();\n84\t    unsafe {\n85\t        printIntPtrLine(data_addr);\n86\t    }\n87\t}\n88\t\n89\t// void driver(int useGood)\n90\t// {\n91\t//     if (useGood) { good(); } else { bad(); }\n92\t// }\n93\t#[unsafe(no_mangle)]\n94\tpub unsafe extern \"C\" fn driver(useGood: c_int) {\n95\t    if useGood != 0 {\n96\t        unsafe { good() };\n97\t    } else {\n98\t        unsafe { bad() };\n99\t    }\n100\t}\n101\t"}]},"parent_tool_use_id":null,"session_id":"7753e2b4-8a68-4e99-bbe3-5f1881e1d78e","uuid":"f2557f81-36