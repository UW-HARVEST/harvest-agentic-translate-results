t(),\n                null_mut(),\n            );\n        } else {\n            c2GJK(\n                addr_of_mut!(bb) as *const c_void,\n                C2_TYPE_AABB,\n                null(),\n                addr_of_mut!(cap) as *const c_void,\n                C2_TYPE_CAPSULE,\n                null(),\n                a,\n                b,\n                1,\n                null_mut(),\n                null_mut(),\n            );\n        }\n    }\n}\n","structuredPatch":[{"oldStart":878,"oldLines":11,"newStart":878,"newLines":19,"lines":[" "," /// `c2v c2L(c2Simplex *s)`"," ///","-/// GCC commuted the *first* scalar product only:","+/// Identical shape to `c2Witness`: `den` is the stack slot `-0x14(%rbp)` and is","+/// therefore always the `mulss` *source*, so both products have the vertex","+/// weight as destination."," ///"," /// ```text","-/// 0x1eeb  mulss 0x3c(%rdi)(b.u),%xmm1(den)  ; den * b.u -> dst is den","-/// 0x1f0a  mulss %xmm2(den),%xmm1(a.u)       ; den * a.u -> dst is a.u","+/// 25fd  movss 0x90(%rax),%xmm1   ; s->div","+/// 2605  movss 0x19f3(%rip),%xmm0 ; 1.0f","+/// 260d  divss %xmm1,%xmm0        ; dst = 1.0f     -> div_l(1.0, s->div)","+/// 263a  movss 0x3c(%rax),%xmm0   ; s->b.u","+/// 263f  mulss -0x14(%rbp),%xmm0  ; dst = s->b.u   -> mul_r(den, b.u)","+/// 2662  movss 0x18(%rax),%xmm0   ; s->a.u","+/// 2667  mulss -0x14(%rbp),%xmm0  ; dst = s->a.u   -> mul_r(den, a.u)","+/// 2690  call c2Add               ; c2Add(a term, b term)"," /// ```"," #[unsafe(no_mangle)]"," pub unsafe extern \"C\" fn c2L(s: *mut c2Simplex) -> c2v {"]},{"oldStart":895,"oldLines":7,"newStart":903,"newLines":7,"lines":["             1 => (*v0).p,","             2 => c2Add(","                 c2Mulvs((*v0).p, mul_r(den, (*v0).u)),","-                c2Mulvs((*v1).p, mul_l(den, (*v1).u)),","+                c2Mulvs((*v1).p, mul_r(den, (*v1).u)),","             ),","             _ => c2V(0.0, 0.0),","         }"]}],"userModified":false,"replaceAll":false}}
