featureless.\nrun_combo \"--no-default-features\" --no-default-features\n\n# Every subset of the declared features (2^N), if there are any.\nif [ \"$N\" -gt 0 ]; then\n  for ((mask=0; mask<(1<<N); mask++)); do\n    combo=()\n    for ((i=0; i<N; i++)); do\n      if (( (mask >> i) & 1 )); then combo+=(\"${FEATURES[$i]}\"); fi\n    done\n    joined=$(IFS=,; echo \"${combo[*]:-}\")\n    run_combo \"--no-default-features --features ${joined:-<empty>}\" \\\n      --no-default-features ${joined:+--features \"$joined\"}\n  done\n  # And everything at once, on top of the defaults.\n  run_combo \"--all-features\" --all-features\nfi\n\necho\necho \"ALL FEATURE COMBINATIONS PASSED\"\nEOF\nchmod +x check_features.sh && timeout 600 ./check_features.sh 2>&1 | grep -E 'COMBO|declared|test result|symbol parity|PASSED|error|FAILED|^<|^>'","description":"Create and run feature-combination checker"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":941,"cache_read_input_tokens":347366,"cache_creation":{"ephemeral_5m_input_tokens":941,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"51af6bd4-da19-4276-bde1-7f5d951f391d","uuid":"622f2604-f3bc-4bb1-91d0-cac383440b5b","timestamp":"2026-08-27T10:13:50.600Z"}
