%xmm2,%xmm0         ; dst = b.y     -> mul_r(a.s, b.y)\n/// 271b  addss %xmm0,%xmm1         ; dst = a.c*b.x -> add_l  (x)\n/// ```\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2MulrvT(a: c2r, b: c2v) -> c2v {\n    c2V(\n        add_l(mul_l(a.c, b.x), mul_r(a.s, b.y)),\n        add_l(mul_l(fneg(a.s), b.x), mul_r(a.c, b.y)),\n    )\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1388,"cache_read_input_tokens":125621,"cache_creation":{"ephemeral_5m_input_tokens":1388,"ephemeral_1h_input_tokens":0},"output_tokens":16,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"51af6bd4-da19-4276-bde1-7f5d951f391d","uuid":"347d5241-8236-41e2-9b2f-dda4dbb64856","timestamp":"2026-08-27T09:34:14.506Z"}
