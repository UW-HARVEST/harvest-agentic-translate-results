{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_013m9gqT3khA8QafzQ9Nwu4d","type":"tool_result","content":"1\t//! Rust translation of `c_src/src/lib.c` — a cute_c2-style 2D GJK distance\n2\t//! solver, built as a C shared library.\n3\t//!\n4\t//! This crate reproduces the **complete public ABI** of the C library (all 31\n5\t//! exported symbols) and is bit-for-bit behaviour compatible with it,\n6\t//! including its quirks and bugs.\n7\t//!\n8\t//! # Why the arithmetic looks the way it does\n9\t//!\n10\t//! The C library is built as a `-fPIC` shared object **without**\n11\t//! `-fvisibility=hidden` and with no `static` functions, so every helper is\n12\t//! interposable and GCC cannot inline any of them — the disassembly shows that\n13\t//! every single call (`c2V`, `c2Dot`, `c2Sub`, `c2Add`, …) goes through the\n14\t//! PLT. That means the library's entire floating-point behaviour is determined\n15\t//! by a small, enumerable set of SSE scalar/packed instructions inside the\n16\t//! leaf functions.\n17\t//!\n18\t//! For every *finite* input, IEEE-754 makes those results uniquely determined,\n19\t//! so a straightforward translation is already bit-exact. The one place where\n20\t//! \"obvious\" Rust diverges is **which NaN survives** an operation: `addss`,\n21\t//! `mulss`, `subss` and `divss` return the *destination* operand's NaN in\n22\t//! preference to the source operand's, and GCC's register allocator sometimes\n23\t//! commutes `addss`/`mulss` relative to the C source order (LLVM does too, but\n24\t//! makes different choices). Because a NaN's sign bit and payload are then\n25\t//! observable in the output, this module routes all arithmetic through\n26\t//! `add_l`/`add_r`/`mul_l`/`mul_r`/`sub_l`/`div_l` helpers that pin the\n27\t//! destination operand to exactly what GCC emitted at each site. The choices\n28\t//! are documented per call site against the disassembly.\n29\t\n30\t#![allow(non_snake_case)]\n31\t#![allow(non_camel_case_types)]\n32\t#![allow(non_upper_case_globals)]\n33\t#![allow(unused_assignments)]\n34\t\n35\tuse core::ffi::{c_char, c_int, c_void};\n36\tuse core::ptr::{addr_of, addr_of_mut, null, null_mut};\n37\t\n38\t// ---------------------------------------------------------------------------\n39\t// Constants, spelled out as literals in the C source\n40\t// ---------------------------------------------------------------------------\n41\t\n42\t/// `FLT_MAX`\n43\tconst FLT_MAX: f32 = 3.402_823_466_385_288_598_117_041_834_845_169_25e+38_f32;\n44\t/// `FLT_EPSILON`\n45\tconst FLT_EPSILON: f32 = 1.192_092_895_507_812_5e-7_f32;\n46\t\n47\t// ---------------------------------------------------------------------------\n48\t// SSE-exact scalar arithmetic\n49\t//\n50\t// Intel SDM, ADDSS/SUBSS/MULSS/DIVSS `xmm1, xmm2`:\n51\t//   * if the destination operand (`xmm1`) is NaN, the result is that NaN,\n52\t//     quieted (SNaN -> QNaN by setting the mantissa MSB); sign and payload\n53\t//     are otherwise preserved;\n54\t//   * otherwise, if the source operand is NaN, the result is that NaN,\n55\t//     quieted;\n56\t//   * otherwise the IEEE-754 operation is performed (which itself may raise\n57\t//     #I and produce the \"QNaN indefinite\" for e.g. 0*Inf or Inf-Inf — that\n58\t//     case is order independent, so plain Rust arithmetic reproduces it).\n59\t//\n60\t// `_l` means the *left* argument was GCC's destination operand; `_r` means\n61\t// GCC commuted the instruction so the *right* argument is the destination.\n62\t// `SUBSS`/`DIVSS` are not commutative, so only the `_l` form exists.\n63\t// ---------------------------------------------------------------------------\n64\t\n65\t/// Quiet a NaN exactly the way an SSE arithmetic instruction does: set the\n66\t/// mantissa MSB, leave sign and the rest of the payload untouched.\n67\t#[inline(always)]\n68\tfn quiet(x: f32) -> f32 {\n69\t    f32::from_bits(x.to_bits() | 0x0040_0000)\n70\t}\n71\t\n72\t/// IEEE-754 negation: a pure sign-bit flip (`xorps` against `0x80000000`),\n73\t/// which never quiets a NaN. This is what GCC emits for `-x` in `c2Neg`,\n74\t/// `c2Skew` and `c2CCW90`.\n75\t#[inline(always)]\n76\tfn fneg(x: f32) -> f32 {\n77\t    f32::from_bits(x.to_bits() ^ 0x8000_0000)\n78\t}\n79\t\n80\t/// `addss a, b` — destination is `a`.\n81\t#[inline(always)]\n82\tfn add_l(a: f32, b: f32) -> f32 {\n83\t    if a.is_nan() {\n84\t        quiet(a)\n85\t    } else if b.is_nan() {\n86\t        quiet(b)\n87\t    } else {\n88\t        a + b\n89\t    }\n90\t}\n91\t\n92\t/// `addss b, a` — destination is `b` (GCC commuted the operands).\n93\t#[inline(always)]\n94\tfn add_r(a: f32, b: f32) -> f32 {\n95\t    if b.is_nan() {\n96\t        quiet(b)\n97\t    } else if a.is_nan() {\n98\t        quiet(a)\n99\t    } else {\n100\t        a + b\n101\t    }\n102\t}\n103\t\n104\t/// `subss a, b` — destination is `a` (subtraction is never commuted).\n105\t#[inline(always)]\n106\tfn sub_l(a: f32, b: f32) -> f32 {\n107\t    if a.is_nan() {\n108\t        quiet(a)\n109\t    } else if b.is_nan() {\n110\t        quiet(b)\n111\t    } else {\n112\t        a - b\n113\t    }\n114\t}\n115\t\n116\t/// `mulss a, b` — destination is `a`.\n117\t#[inline(always)]\n118\tfn mul_l(a: f32, b: f32) -> f32 {\n119\t    if a.is_nan() {\n120\t        quiet(a)\n121\t    } else if b.is_nan() {\n122\t        quiet(b)\n123\t    } else {\n124\t        a * b\n125\t    }\n126\t}\n127\t\n128\t/// `mulss b, a` — destination is `b` (GCC commuted the operands).\n129\t#[inline(always)]\n130\tfn mul_r(a: f32, b: f32) -> f32 {\n131\t    if b.is_nan() {\n132\t        quiet(b)\n133\t    } else if a.is_nan() {\n134\t        quiet(a)\n135\t    } else {\n136\t        a * b\n137\t    }\n138\t}\n139\t\n140\t/// `divss a, b` — destination is `a` (division is never commuted).\n141\t#[inline(always)]\n142\tfn div_l(a: f32, b: f32) -> f32 {\n143\t    if a.is_nan() {\n144\t        quiet(a)\n145\t    } else if b.is_nan() {\n146\t        quiet(b)\n147\t    } else {\n148\t        a / b\n149\t    }\n150\t}\n151\t\n152\t// ---------------------------------------------------------------------------\n153\t// C2_TYPE — an unfixed C enum, so `int`-sized in the ABI\n154\t// ---------------------------------------------------------------------------\n155\t\n156\tpub const C2_TYPE_CIRCLE: c_int = 0;\n157\tpub const C2_TYPE_AABB: c_int = 1;\n158\tpub const C2_TYPE_CAPSULE: c_int = 2;\n159\t\n160\t// ---------------------------------------------------------------------------\n161\t// Structures — layouts mirror the C definitions exactly\n162\t// ---------------------------------------------------------------------------\n163\t\n164\t/// `typedef struct c2v { float x; float y; } c2v;`\n165\t#[repr(C)]\n166\t#[derive(Copy, Clone, Debug)]\n167\tpub struct c2v {\n168\t    pub x: f32,\n169\t    pub y: f32,\n170\t}\n171\t\n172\t/// `typedef struct c2r { float c; float s; } c2r;`\n173\t#[repr(C)]\n174\t#[derive(Copy, Clone, Debug)]\n175\tpub struct c2r {\n176\t    pub c: f32,\n177\t    pub s: f32,\n178\t}\n179\t\n180\t/// `typedef struct c2x { c2v p; c2r r; } c2x;`\n181\t#[repr(C)]\n182\t#[derive(Copy, Clone, Debug)]\n183\tpub struct c2x {\n184\t    pub p: c2v,\n185\t    pub r: c2r,\n186\t}\n187\t\n188\t/// `typedef struct c2Circle { c2v p; float r; } c2Circle;`\n189\t#[repr(C)]\n190\t#[derive(Copy, Clone, Debug)]\n191\tpub struct c2Circle {\n192\t    pub p: c2v,\n193\t    pub r: f32,\n194\t}\n195\t\n196\t/// `typedef struct c2AABB { c2v min; c2v max; } c2AABB;`\n197\t#[repr(C)]\n198\t#[derive(Copy, Clone, Debug)]\n199\tpub struct c2AABB {\n200\t    pub min: c2v,\n201\t    pub max: c2v,\n202\t}\n203\t\n204\t/// `typedef struct c2Capsule { c2v a; c2v b; float r; } c2Capsule;`\n205\t#[repr(C)]\n206\t#[derive(Copy, Clone, Debug)]\n207\tpub struct c2Capsule {\n208\t    pub a: c2v,\n209\t    pub b: c2v,\n210\t    pub r: f32,\n211\t}\n212\t\n213\t/// ```c\n214\t/// typedef struct c2GJKCache {\n215\t///         float metric; int count; int iA[3]; int iB[3]; float div;\n216\t/// } c2GJKCache;\n217\t/// ```\n218\t#[repr(C)]\n219\t#[derive(Copy, Clone, Debug)]\n220\tpub struct c2GJKCache {\n221\t    pub metric: f32,\n222\t    pub count: c_int,\n223\t    pub iA: [c_int; 3],\n224\t    pub iB: [c_int; 3],\n225\t    pub div: f32,\n226\t}\n227\t\n228\t/// `typedef struct { float radius; int count; c2v verts[8]; } c2Proxy;`\n229\t#[repr(C)]\n230\t#[derive(Copy, Clone, Debug)]\n231\tpub struct c2Proxy {\n232\t    pub radius: f32,\n233\t    pub count: c_int,\n234\t    pub verts: [c2v; 8],\n235\t}\n236\t\n237\t/// `typedef struct { c2v sA; c2v sB; c2v p; float u; int iA; int iB; } c2sv;`\n238\t#[repr(C)]\n239\t#[derive(Copy, Clone, Debug)]\n240\tpub struct c2sv {\n241\t    pub sA: c2v,\n242\t    pub sB: c2v,\n243\t    pub p: c2v,\n244\t    pub u: f32,\n245\t    pub iA: c_int,\n246\t    pub iB: c_int,\n247\t}\n248\t\n249\t/// `typedef struct { c2sv a, b, c, d; float div; int count; } c2Simplex;`\n250\t///\n251\t/// The four `c2sv` members `a`, `b`, `c`, `d` are modelled as one array so the\n252\t/// C idiom `c2sv *verts = &s->a; verts[i]` can be reproduced verbatim. The\n253\t/// memory layout is byte-identical to the C struct.\n254\t#[repr(C)]\n255\t#[derive(Copy, Clone, Debug)]\n256\tpub struct c2Simplex {\n257\t    /// `a`, `b`, `c`, `d`\n258\t    pub verts: [c2sv; 4],\n259\t    pub div: f32,\n260\t    pub count: c_int,\n261\t}\n262\t\n263\t// Compile-time layout assertions guaranteeing ABI equality with the C structs.\n264\tconst _: () = {\n265\t    assert!(core::mem::size_of::<c2v>() == 8 && core::mem::align_of::<c2v>() == 4);\n266\t    assert!(core::mem::size_of::<c2r>() == 8);\n267\t    assert!(core::mem::size_of::<c2x>() == 16);\n268\t    assert!(core::mem::size_of::<c2Circle>() == 12);\n269\t    assert!(core::mem::size_of::<c2AABB>() == 16);\n270\t    assert!(core::mem::size_of::<c2Capsule>() == 20);\n271\t    assert!(core::mem::size_of::<c2GJKCache>() == 36);\n272\t    assert!(core::mem::size_of::<c2Proxy>() == 72);\n273\t    assert!(core::mem::size_of::<c2sv>() == 36);\n274\t    assert!(core::mem::size_of::<c2Simplex>() == 152);\n275\t};\n276\t\n277\tconst ZERO_V: c2v = c2v { x: 0.0, y: 0.0 };\n278\t\n279\timpl c2Simplex {\n280\t    #[inline]\n281\t    const fn zeroed() -> c2Simplex {\n282\t        const ZSV: c2sv = c2sv {\n283\t            sA: ZERO_V,\n284\t            sB: ZERO_V,\n285\t            p: ZERO_V,\n286\t            u: 0.0,\n287\t            iA: 0,\n288\t            iB: 0,\n289\t        };\n290\t        c2Simplex {\n291\t            verts: [ZSV; 4],\n292\t            div: 0.0,\n293\t            count: 0,\n294\t        }\n295\t    }\n296\t}\n297\t\n298\timpl c2Proxy {\n299\t    #[inline]\n300\t    const fn zeroed() -> c2Proxy {\n301\t        c2Proxy {\n302\t            radius: 0.0,\n303\t            count: 0,\n304\t            verts: [ZERO_V; 8],\n305\t        }\n306\t    }\n307\t}\n308\t\n309\t// ---------------------------------------------------------------------------\n310\t// Vector / rotation helpers\n311\t// ---------------------------------------------------------------------------\n312\t\n313\t/// `c2v c2V(float x, float y)`\n314\t#[unsafe(no_mangle)]\n315\tpub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n316\t    let mut a = ZERO_V;\n317\t    a.x = x;\n318\t    a.y = y;\n319\t    a\n320\t}\n321\t\n322\t/// `c2v c2Mulvs(c2v a, float b)`\n323\t///\n324\t/// GCC broadcasts the scalar (`movsldup`) into the destination register and\n325\t/// multiplies by `a`: `mulps %xmm2(a), %xmm0(b,b)`. The destination is\n326\t/// therefore `b`, so `b`'s NaN wins over `a`'s.\n327\t#[unsafe(no_mangle)]\n328\tpub extern \"C\" fn c2Mulvs(a: c2v, b: f32) -> c2v {\n329\t    let mut a = a;\n330\t    a.x = mul_r(a.x, b);\n331\t    a.y = mul_r(a.y, b);\n332\t    a\n333\t}\n334\t\n335\t/// `c2v c2Maxv(c2v a, c2v b)`\n336\t///\n337\t/// GCC emits `maxss %xmm(b), %xmm(a)`, whose NaN behaviour (\"if either\n338\t/// operand is NaN, return the source operand\") is exactly the C ternary\n339\t/// `a > b ? a : b`. Do **not** use `f32::max` here — it returns the\n340\t/// non-NaN operand instead.\n341\t#[unsafe(no_mangle)]\n342\tpub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n343\t    c2V(\n344\t        if a.x > b.x { a.x } else { b.x },\n345\t        if a.y > b.y { a.y } else { b.y },\n346\t    )\n347\t}\n348\t\n349\t/// `c2v c2Minv(c2v a, c2v b)` — `minss`, mirroring `c2Maxv`.\n350\t#[unsafe(no_mangle)]\n351\tpub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n352\t    c2V(\n353\t        if a.x < b.x { a.x } else { b.x },\n354\t        if a.y < b.y { a.y } else { b.y },\n355\t    )\n356\t}\n357\t\n358\t/// `c2v c2Clampv(c2v a, c2v lo, c2v hi)`\n359\t#[unsafe(no_mangle)]\n360\tpub extern \"C\" fn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n361\t    c2Maxv(lo, c2Minv(a, hi))\n362\t}\n363\t\n364\t/// `c2v c2Sub(c2v a, c2v b)` — `subps %xmm1(b), %xmm0(a)`, destination `a`.\n365\t#[unsafe(no_mangle)]\n366\tpub extern \"C\" fn c2Sub(a: c2v, b: c2v) -> c2v {\n367\t    let mut a = a;\n368\t    a.x = sub_l(a.x, b.x);\n369\t    a.y = sub_l(a.y, b.y);\n370\t    a\n371\t}\n372\t\n373\t/// `c2v c2Add(c2v a, c2v b)` — `addps %xmm1(b), %xmm0(a)`, destination `a`.\n374\t#[unsafe(no_mangle)]\n375\tpub extern \"C\" fn c2Add(a: c2v, b: c2v) -> c2v {\n376\t    let mut a = a;\n377\t    a.x = add_l(a.x, b.x);\n378\t    a.y = add_l(a.y, b.y);\n379\t    a\n380\t}\n381\t\n382\t/// `float c2Dot(c2v a, c2v b)` -> `a.x * b.x + a.y * b.y`\n383\t///\n384\t/// ```text\n385\t/// mulss %xmm1,%xmm0   ; xmm0 = a.x * b.x   (dst a.x)\n386\t/// mulss %xmm3,%xmm1   ; xmm1 = a.y * b.y   (dst a.y)\n387\t/// addss %xmm1,%xmm0   ; dst = a.x * b.x\n388\t/// ```\n389\t#[unsafe(no_mangle)]\n390\tpub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n391\t    add_l(mul_l(a.x, b.x), mul_l(a.y, b.y))\n392\t}\n393\t\n394\t/// `float c2Det2(c2v a, c2v b)` -> `a.x * b.y - a.y * b.x`\n395\t///\n396\t/// ```text\n397\t/// mulss %xmm2,%xmm0   ; xmm0 = a.x * b.y   (dst a.x)\n398\t/// mulss %xmm3,%xmm1   ; xmm1 = a.y * b.x   (dst a.y)\n399\t/// subss %xmm1,%xmm0   ; dst = a.x * b.y\n400\t/// ```\n401\t#[unsafe(no_mangle)]\n402\tpub extern \"C\" fn c2Det2(a: c2v, b: c2v) -> f32 {\n403\t    sub_l(mul_l(a.x, b.y), mul_l(a.y, b.x))\n404\t}\n405\t\n406\t/// `c2r c2RotIdentity(void)`\n407\t#[unsafe(no_mangle)]\n408\tpub extern \"C\" fn c2RotIdentity() -> c2r {\n409\t    let mut r = c2r { c: 0.0, s: 0.0 };\n410\t    r.c = 1.0f32;\n411\t    r.s = 0.0;\n412\t    r\n413\t}\n414\t\n415\t/// `c2x c2xIdentity(void)`\n416\t#[unsafe(no_mangle)]\n417\tpub extern \"C\" fn c2xIdentity() -> c2x {\n418\t    let mut x = c2x {\n419\t        p: ZERO_V,\n420\t        r: c2r { c: 0.0, s: 0.0 },\n421\t    };\n422\t    x.p = c2V(0.0, 0.0);\n423\t    x.r = c2RotIdentity();\n424\t    x\n425\t}\n426\t\n427\t/// `c2v c2Mulrv(c2r a, c2v b)`\n428\t/// -> `c2V(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)`\n429\t///\n430\t/// GCC commuted the `y` term's `addss`, making `a.c * b.y` the destination:\n431\t///\n432\t/// ```text\n433\t/// mulss %xmm1,%xmm5   ; xmm5 = a.s * b.x   (dst a.s)\n434\t/// mulss %xmm3,%xmm1   ; xmm1 = a.c * b.y   (dst a.c)\n435\t/// mulss %xmm4,%xmm0   ; xmm0 = a.c * b.x   (dst a.c)\n436\t/// mulss %xmm3,%xmm2   ; xmm2 = a.s * b.y   (dst a.s)\n437\t/// addss %xmm5,%xmm1   ; y = (a.c*b.y) + (a.s*b.x)   <- dst is the 2nd term\n438\t/// subss %xmm2,%xmm0   ; x = (a.c*b.x) - (a.s*b.y)\n439\t/// ```\n440\t#[unsafe(no_mangle)]\n441\tpub extern \"C\" fn c2Mulrv(a: c2r, b: c2v) -> c2v {\n442\t    c2V(\n443\t        sub_l(mul_l(a.c, b.x), mul_l(a.s, b.y)),\n444\t        add_r(mul_l(a.s, b.x), mul_l(a.c, b.y)),\n445\t    )\n446\t}\n447\t\n448\t/// `c2v c2MulrvT(c2r a, c2v b)`\n449\t/// -> `c2V(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y)`\n450\t///\n451\t/// GCC folded `-x + y` into `subss` with `y` as the destination. IEEE-754\n452\t/// addition is commutative, so `(-x) + y == y - x` bit-exactly for every\n453\t/// non-NaN operand (signed zeros and infinities included):\n454\t///\n455\t/// ```text\n456\t/// subss %xmm5,%xmm1   ; y = (a.c*b.y) - (a.s*b.x)\n457\t/// addss %xmm2,%xmm0   ; x = (a.c*b.x) + (a.s*b.y)\n458\t/// ```\n459\t#[unsafe(no_mangle)]\n460\tpub extern \"C\" fn c2MulrvT(a: c2r, b: c2v) -> c2v {\n461\t    c2V(\n462\t        add_l(mul_l(a.c, b.x), mul_l(a.s, b.y)),\n463\t        sub_l(mul_l(a.c, b.y), mul_l(a.s, b.x)),\n464\t    )\n465\t}\n466\t\n467\t/// `c2v c2Mulxv(c2x a, c2v b)`\n468\t#[unsafe(no_mangle)]\n469\tpub extern \"C\" fn c2Mulxv(a: c2x, b: c2v) -> c2v {\n470\t    c2Add(c2Mulrv(a.r, b), a.p)\n471\t}\n472\t\n473\t/// `c2v c2Neg(c2v a)` — `xorps` sign flip, no NaN quieting.\n474\t#[unsafe(no_mangle)]\n475\tpub extern \"C\" fn c2Neg(a: c2v) -> c2v {\n476\t    c2V(fneg(a.x), fneg(a.y))\n477\t}\n478\t\n479\t/// `c2v c2Skew(c2v a)`\n480\t#[unsafe(no_mangle)]\n481\tpub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n482\t    let mut b = ZERO_V;\n483\t    b.x = fneg(a.y);\n484\t    b.y = a.x;\n485\t    b\n486\t}\n487\t\n488\t/// `c2v c2CCW90(c2v a)`\n489\t#[unsafe(no_mangle)]\n490\tpub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n491\t    let mut b = ZERO_V;\n492\t    b.x = a.y;\n493\t    b.y = fneg(a.x);\n494\t    b\n495\t}\n496\t\n497\t/// `c2v c2Div(c2v a, float b)` — `divss %xmm1(b), %xmm2(1.0f)`.\n498\t#[unsafe(no_mangle)]\n499\tpub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n500\t    c2Mulvs(a, div_l(1.0f32, b))\n501\t}\n502\t\n503\t/// `c2v c2Norm(c2v a)`\n504\t#[unsafe(no_mangle)]\n505\tpub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n506\t    c2Div(a, c2Len(a))\n507\t}\n508\t\n509\t/// `float c2Len(c2v a)` -> `sqrtf(c2Dot(a, a))`\n510\t///\n511\t/// GCC guards the inline `sqrtss` with `ucomiss`/`ja` and falls back to\n512\t/// `sqrtf@plt` only when the argument is *strictly negative* (NaN leaves the\n513\t/// branch untaken, because `ja` is false when unordered). The argument here is\n514\t/// always a sum of squares, so it is never negative and the inline `sqrtss` —\n515\t/// i.e. `f32::sqrt` — is always what runs.\n516\t#[unsafe(no_mangle)]\n517\tpub extern \"C\" fn c2Len(a: c2v) -> f32 {\n518\t    c2Dot(a, a).sqrt()\n519\t}\n520\t\n521\t// ---------------------------------------------------------------------------\n522\t// Shape helpers\n523\t// ---------------------------------------------------------------------------\n524\t\n525\t/// `void c2BBVerts(c2v *out, c2AABB *bb)`\n526\t#[unsafe(no_mangle)]\n527\tpub unsafe extern \"C\" fn c2BBVerts(out: *mut c2v, bb: *mut c2AABB) {\n528\t    unsafe {\n529\t        *out.add(0) = (*bb).min;\n530\t        *out.add(1) = c2V((*bb).max.x, (*bb).min.y);\n531\t        *out.add(2) = (*bb).max;\n532\t        *out.add(3) = c2V((*bb).min.x, (*bb).max.y);\n533\t    }\n534\t}\n535\t\n536\t/// `void c2MakeProxy(const void *shape, C2_TYPE type, c2Proxy *p)`\n537\t///\n538\t/// As in the C original there is no `default:` arm, so for a `type` outside\n539\t/// `{0, 1, 2}` the proxy is left completely untouched.\n540\t#[unsafe(no_mangle)]\n541\tpub unsafe extern \"C\" fn c2MakeProxy(shape: *const c_void, type_: c_int, p: *mut c2Proxy) {\n542\t    unsafe {\n543\t        match type_ {\n544\t            C2_TYPE_CIRCLE => {\n545\t                let c = shape as *mut c2Circle;\n546\t                (*p).radius = (*c).r;\n547\t                (*p).count = 1;\n548\t                (*p).verts[0] = (*c).p;\n549\t            }\n550\t            C2_TYPE_AABB => {\n551\t                let bb = shape as *mut c2AABB;\n552\t                (*p).radius = 0.0;\n553\t                (*p).count = 4;\n554\t                c2BBVerts(addr_of_mut!((*p).verts) as *mut c2v, bb);\n555\t            }\n556\t            C2_TYPE_CAPSULE => {\n557\t                let c = shape as *mut c2Capsule;\n558\t                (*p).radius = (*c).r;\n559\t                (*p).count = 2;\n560\t                (*p).verts[0] = (*c).a;\n561\t                (*p).verts[1] = (*c).b;\n562\t            }\n563\t            _ => {}\n564\t        }\n565\t    }\n566\t}\n567\t\n568\t// ---------------------------------------------------------------------------\n569\t// Simplex routines\n570\t// ---------------------------------------------------------------------------\n571\t\n572\t/// `float c2GJKSimplexMetric(c2Simplex *s)`\n573\t#[unsafe(no_mangle)]\n574\tpub unsafe extern \"C\" fn c2GJKSimplexMetric(s: *mut c2Simplex) -> f32 {\n575\t    unsafe {\n576\t        let verts = addr_of!((*s).verts) as *const c2sv;\n577\t        match (*s).count {\n578\t            2 => c2Len(c2Sub((*verts.add(1)).p, (*verts.add(0)).p)),\n579\t            3 => c2Det2(\n580\t                c2Sub((*verts.add(1)).p, (*verts.add(0)).p),\n581\t                c2Sub((*verts.add(2)).p, (*verts.add(0)).p),\n582\t            ),\n583\t            // `default:` falls through into `case 1:` in the C source.\n584\t            _ => 0.0,\n585\t        }\n586\t    }\n587\t}\n588\t\n589\t/// `void c22(c2Simplex *s)`\n590\t///\n591\t/// `s->div = u + v` is emitted as `addss %xmm0(v), %xmm2(u)`, destination `u`.\n592\t#[unsafe(no_mangle)]\n593\tpub unsafe extern \"C\" fn c22(s: *mut c2Simplex) {\n594\t    unsafe {\n595\t        let verts = addr_of_mut!((*s).verts) as *mut c2sv;\n596\t        let sa = verts.add(0);\n597\t        let sb = verts.add(1);\n598\t\n599\t        let a = (*sa).p;\n600\t        let b = (*sb).p;\n601\t        let u = c2Dot(b, c2Sub(b, a));\n602\t        let v = c2Dot(a, c2Sub(a, b));\n603\t        if v <= 0.0 {\n604\t            (*sa).u = 1.0f32;\n605\t            (*s).div = 1.0f32;\n606\t            (*s).count = 1;\n607\t        } else if u <= 0.0 {\n608\t            *sa = *sb;\n609\t            (*sa).u = 1.0f32;\n610\t            (*s).div = 1.0f32;\n611\t            (*s).count = 1;\n612\t        } else {\n613\t            (*sa).u = u;\n614\t            (*sb).u = v;\n615\t            (*s).div = add_l(u, v);\n616\t            (*s).count = 2;\n617\t        }\n618\t    }\n619\t}\n620\t\n621\t/// `void c23(c2Simplex *s)`\n622\t///\n623\t/// GCC's destination-operand choices for the `div` sums (see disassembly at\n624\t/// `0x1710`):\n625\t///\n626\t/// ```text\n627\t/// 0x1913  addss %xmm5(uBC),%xmm6(vBC)   ; uBC + vBC  -> dst is vBC (commuted)\n628\t/// 0x19e4  addss %xmm6(vCA),%xmm0(uCA)   ; uCA + vCA  -> dst is uCA\n629\t/// 0x1a25  addss %xmm3(vABC),%xmm2(uABC) ; uABC+vABC  -> dst is uABC\n630\t/// 0x1a38  addss %xmm2(sum),%xmm0(wABC)  ; +wABC      -> dst is wABC (commuted)\n631\t/// 0x1a75  addss %xmm3(vAB),%xmm2(uAB)   ; uAB + vAB  -> dst is uAB\n632\t/// ```\n633\t#[unsafe(no_mangle)]\n634\tpub unsafe extern \"C\" fn c23(s: *mut c2Simplex) {\n635\t    unsafe {\n636\t        let verts = addr_of_mut!((*s).verts) as *mut c2sv;\n637\t        let sa = verts.add(0);\n638\t        let sb = verts.add(1);\n639\t        let sc = verts.add(2);\n640\t\n641\t        let a = (*sa).p;\n642\t        let b = (*sb).p;\n643\t        let c = (*sc).p;\n644\t        let uAB = c2Dot(b, c2Sub(b, a));\n645\t        let vAB = c2Dot(a, c2Sub(a, b));\n646\t        let uBC = c2Dot(c, c2Sub(c, b));\n647\t        let vBC = c2Dot(b, c2Sub(b, c));\n648\t        let uCA = c2Dot(a, c2Sub(a, c));\n649\t        let vCA = c2Dot(c, c2Sub(c, a));\n650\t        let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n651\t        let uABC = mul_l(c2Det2(b, c), area);\n652\t        let vABC = mul_l(c2Det2(c, a), area);\n653\t        let wABC = mul_l(c2Det2(a, b), area);\n654\t        if vAB <= 0.0 && uCA <= 0.0 {\n655\t            (*sa).u = 1.0f32;\n656\t            (*s).div = 1.0f32;\n657\t            (*s).count = 1;\n658\t        } else if uAB <= 0.0 && vBC <= 0.0 {\n659\t            *sa = *sb;\n660\t            (*sa).u = 1.0f32;\n661\t            (*s).div = 1.0f32;\n662\t            (*s).count = 1;\n663\t        } else if uBC <= 0.0 && vCA <= 0.0 {\n664\t            *sa = *sc;\n665\t            (*sa).u = 1.0f32;\n666\t            (*s).div = 1.0f32;\n667\t            (*s).count = 1;\n668\t        } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n669\t            (*sa).u = uAB;\n670\t            (*sb).u = vAB;\n671\t            (*s).div = add_l(uAB, vAB);\n672\t            (*s).count = 2;\n673\t        } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n674\t            *sa = *sb;\n675\t            *sb = *sc;\n676\t            (*sa).u = uBC;\n677\t            (*sb).u = vBC;\n678\t            (*s).div = add_r(uBC, vBC);\n679\t            (*s).count = 2;\n680\t        } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n681\t            *sb = *sa;\n682\t            *sa = *sc;\n683\t            (*sa).u = uCA;\n684\t            (*sb).u = vCA;\n685\t            (*s).div = add_l(uCA, vCA);\n686\t            (*s).count = 2;\n687\t        } else {\n688\t            (*sa).u = uABC;\n689\t            (*sb).u = vABC;\n690\t            (*sc).u = wABC;\n691\t            (*s).div = add_r(add_l(uABC, vABC), wABC);\n692\t            (*s).count = 3;\n693\t        }\n694\t    }\n695\t}\n696\t\n697\t/// `c2v c2D(c2Simplex *s)`\n698\t#[unsafe(no_mangle)]\n699\tpub unsafe extern \"C\" fn c2D(s: *mut c2Simplex) -> c2v {\n700\t    unsafe {\n701\t        let verts = addr_of!((*s).verts) as *const c2sv;\n702\t        match (*s).count {\n703\t            1 => c2Neg((*verts.add(0)).p),\n704\t            2 => {\n705\t                let ab = c2Sub((*verts.add(1)).p, (*verts.add(0)).p);\n706\t                if c2Det2(ab, c2Neg((*verts.add(0)).p)) > 0.0 {\n707\t                    return c2Skew(ab);\n708\t                }\n709\t                c2CCW90(ab)\n710\t            }\n711\t            // `case 3:` and `default:`\n712\t            _ => c2V(0.0, 0.0),\n713\t        }\n714\t    }\n715\t}\n716\t\n717\t/// `int c2Support(const c2v *verts, int count, c2v d)`\n718\t#[unsafe(no_mangle)]\n719\tpub unsafe extern \"C\" fn c2Support(verts: *const c2v, count: c_int, d: c2v) -> c_int {\n720\t    unsafe {\n721\t        let mut imax: c_int = 0;\n722\t        let mut dmax = c2Dot(*verts.add(0), d);\n723\t        let mut i: c_int = 1;\n724\t        while i < count {\n725\t            let dot = c2Dot(*verts.offset(i as isize), d);\n726\t            if dot > dmax {\n727\t                imax = i;\n728\t                dmax = dot;\n729\t            }\n730\t            i += 1;\n731\t        }\n732\t        imax\n733\t    }\n734\t}\n735\t\n736\t/// `void c2Witness(c2Simplex *s, c2v *a, c2v *b)`\n737\t///\n738\t/// Every `den * u` product is emitted as `mulss <mem>(u), %xmm1(den)`, so the\n739\t/// destination is always `den` — matching the C source order.\n740\t#[unsafe(no_mangle)]\n741\tpub unsafe extern \"C\" fn c2Witness(s: *mut c2Simplex, a: *mut c2v, b: *mut c2v) {\n742\t    unsafe {\n743\t        let verts = addr_of!((*s).verts) as *const c2sv;\n744\t        let v0 = verts.add(0);\n745\t        let v1 = verts.add(1);\n746\t        let v2 = verts.add(2);\n747\t        let den = div_l(1.0f32, (*s).div);\n748\t        match (*s).count {\n749\t            1 => {\n750\t                *a = (*v0).sA;\n751\t                *b = (*v0).sB;\n752\t            }\n753\t            2 => {\n754\t                *a = c2Add(\n755\t                    c2Mulvs((*v0).sA, mul_l(den, (*v0).u)),\n756\t                    c2Mulvs((*v1).sA, mul_l(den, (*v1).u)),\n757\t                );\n758\t                *b = c2Add(\n759\t                    c2Mulvs((*v0).sB, mul_l(den, (*v0).u)),\n760\t                    c2Mulvs((*v1).sB, mul_l(den, (*v1).u)),\n761\t                );\n762\t            }\n763\t            3 => {\n764\t                *a = c2Add(\n765\t                    c2Add(\n766\t                        c2Mulvs((*v0).sA, mul_l(den, (*v0).u)),\n767\t                        c2Mulvs((*v1).sA, mul_l(den, (*v1).u)),\n768\t                    ),\n769\t                    c2Mulvs((*v2).sA, mul_l(den, (*v2).u)),\n770\t                );\n771\t                *b = c2Add(\n772\t                    c2Add(\n773\t                        c2Mulvs((*v0).sB, mul_l(den, (*v0).u)),\n774\t                        c2Mulvs((*v1).sB, mul_l(den, (*v1).u)),\n775\t                    ),\n776\t                    c2Mulvs((*v2).sB, mul_l(den, (*v2).u)),\n777\t                );\n778\t            }\n779\t            _ => {\n780\t                *a = c2V(0.0, 0.0);\n781\t                *b = c2V(0.0, 0.0);\n782\t            }\n783\t        }\n784\t    }\n785\t}\n786\t\n787\t/// `c2v c2L(c2Simplex *s)`\n788\t///\n789\t/// GCC commuted the *first* scalar product only:\n790\t///\n791\t/// ```text\n792\t/// 0x1eeb  mulss 0x3c(%rdi)(b.u),%xmm1(den)  ; den * b.u -> dst is den\n793\t/// 0x1f0a  mulss %xmm2(den),%xmm1(a.u)       ; den * a.u -> dst is a.u\n794\t/// ```\n795\t#[unsafe(no_mangle)]\n796\tpub unsafe extern \"C\" fn c2L(s: *mut c2Simplex) -> c2v {\n797\t    unsafe {\n798\t        let verts = addr_of!((*s).verts) as *const c2sv;\n799\t        let v0 = verts.add(0);\n800\t        let v1 = verts.add(1);\n801\t        let den = div_l(1.0f32, (*s).div);\n802\t        match (*s).count {\n803\t            1 => (*v0).p,\n804\t            2 => c2Add(\n805\t                c2Mulvs((*v0).p, mul_r(den, (*v0).u)),\n806\t                c2Mulvs((*v1).p, mul_l(den, (*v1).u)),\n807\t            ),\n808\t            _ => c2V(0.0, 0.0),\n809\t        }\n810\t    }\n811\t}\n812\t\n813\t// ---------------------------------------------------------------------------\n814\t// GJK\n815\t// ---------------------------------------------------------------------------\n816\t\n817\t/// ```c\n818\t/// float c2GJK(const void *A, C2_TYPE typeA, const c2x *ax_ptr,\n819\t///             const void *B, C2_TYPE typeB, const c2x *bx_ptr,\n820\t///             c2v *outA, c2v *outB, int use_radius, int *iterations,\n821\t///             c2GJKCache *cache);\n822\t/// ```\n823\t///\n824\t/// Notes on faithfulness:\n825\t/// * `c2Proxy pA, pB;` and `c2Simplex s;` are *uninitialised* in the C. They\n826\t///   are zeroed here to keep this translation deterministic. The only way the\n827\t///   difference is observable is by passing a `cache` whose `iA`/`iB` entries\n828\t///   index past the shape's real vertex count, which makes the C read\n829\t///   uninitialised stack — unreproducible undefined behaviour.\n830\t/// * Indexing that C performs without bounds checks (`verts + i`,\n831\t///   `cache->iA[i]`, `pA.verts[iA]`) is done through raw pointers so that an\n832\t///   out-of-range `cache->count` aliases neighbouring struct fields exactly as\n833\t///   the C does, instead of panicking.\n834\t/// * `max_metric * 2.0f` is emitted by GCC as `addss %xmm6,%xmm1` (i.e.\n835\t///   `m + m`), which is bit-identical to `m * 2.0` for every input.\n836\t#[unsafe(no_mangle)]\n837\tpub unsafe extern \"C\" fn c2GJK(\n838\t    A: *const c_void,\n839\t    typeA: c_int,\n840\t    ax_ptr: *const c2x,\n841\t    B: *const c_void,\n842\t    typeB: c_int,\n843\t    bx_ptr: *const c2x,\n844\t    outA: *mut c2v,\n845\t    outB: *mut c2v,\n846\t    use_radius: c_int,\n847\t    iterations: *mut c_int,\n848\t    cache: *mut c2GJKCache,\n849\t) -> f32 {\n850\t    unsafe {\n851\t        let ax: c2x;\n852\t        let bx: c2x;\n853\t        if ax_ptr.is_null() {\n854\t            ax = c2xIdentity();\n855\t        } else {\n856\t            ax = *ax_ptr;\n857\t        }\n858\t        if bx_ptr.is_null() {\n859\t            bx = c2xIdentity();\n860\t        } else {\n861\t            bx = *bx_ptr;\n862\t        }\n863\t\n864\t        let mut pA = c2Proxy::zeroed();\n865\t        let mut pB = c2Proxy::zeroed();\n866\t        c2MakeProxy(A, typeA, &mut pA);\n867\t        c2MakeProxy(B, typeB, &mut pB);\n868\t        let pA_verts = addr_of!(pA.verts) as *const c2v;\n869\t        let pB_verts = addr_of!(pB.verts) as *const c2v;\n870\t\n871\t        let mut s = c2Simplex::zeroed();\n872\t        let sp: *mut c2Simplex = &mut s;\n873\t        // `c2sv *verts = &s.a;`\n874\t        let verts = addr_of_mut!((*sp).verts) as *mut c2sv;\n875\t\n876\t        let mut cache_was_read: c_int = 0;\n877\t        if !cache.is_null() {\n878\t            let cache_was_good: c_int = ((*cache).count != 0) as c_int;\n879\t            if cache_was_good != 0 {\n880\t                let cache_iA = addr_of_mut!((*cache).iA) as *mut c_int;\n881\t                let cache_iB = addr_of_mut!((*cache).iB) as *mut c_int;\n882\t                let cache_count = (*cache).count;\n883\t                let mut i: c_int = 0;\n884\t                while i < cache_count {\n885\t                    let iA = *cache_iA.offset(i as isize);\n886\t                    let iB = *cache_iB.offset(i as isize);\n887\t                    let sA = c2Mulxv(ax, *pA_verts.offset(iA as isize));\n888\t                    let sB = c2Mulxv(bx, *pB_verts.offset(iB as isize));\n889\t                    let v = verts.offset(i as isize);\n890\t                    (*v).iA = iA;\n891\t                    (*v).sA = sA;\n892\t                    (*v).iB = iB;\n893\t                    (*v).sB = sB;\n894\t                    (*v).p = c2Sub((*v).sB, (*v).sA);\n895\t                    (*v).u = 0.0;\n896\t                    i += 1;\n897\t                }\n898\t                (*sp).count = cache_count;\n899\t                (*sp).div = (*cache).div;\n900\t                let metric_old = (*cache).metric;\n901\t                let metric = c2GJKSimplexMetric(sp);\n902\t                // `minss`/`maxss` with the fresh metric as destination, which\n903\t                // is exactly what these ternaries mean.\n904\t                let min_metric = if metric < metric_old { metric } else { metric_old };\n905\t                let max_metric = if metric > metric_old { metric } else { metric_old };\n906\t                if !(min_metric < add_l(max_metric, max_metric) && metric < -1.0e8f32) {\n907\t                    cache_was_read = 1;\n908\t                }\n909\t            }\n910\t        }\n911\t\n912\t        if cache_was_read == 0 {\n913\t            let v0 = verts.add(0);\n914\t            (*v0).iA = 0;\n915\t            (*v0).iB = 0;\n916\t            (*v0).sA = c2Mulxv(ax, *pA_verts.add(0));\n917\t            (*v0).sB = c2Mulxv(bx, *pB_verts.add(0));\n918\t            (*v0).p = c2Sub((*v0).sB, (*v0).sA);\n919\t            (*v0).u = 1.0f32;\n920\t            (*sp).div = 1.0f32;\n921\t            (*sp).count = 1;\n922\t        }\n923\t\n924\t        let mut saveA: [c_int; 3] = [0; 3];\n925\t        let mut saveB: [c_int; 3] = [0; 3];\n926\t        let saveA_p = saveA.as_mut_ptr();\n927\t        let saveB_p = saveB.as_mut_ptr();\n928\t        let mut save_count: c_int = 0;\n929\t        let mut d0: f32 = FLT_MAX;\n930\t        let mut d1: f32 = FLT_MAX;\n931\t        let mut iter: c_int = 0;\n932\t        let mut hit: c_int = 0;\n933\t        while iter < 20 {\n934\t            save_count = (*sp).count;\n935\t            let mut i: c_int = 0;\n936\t            while i < save_count {\n937\t                *saveA_p.offset(i as isize) = (*verts.offset(i as isize)).iA;\n938\t                *saveB_p.offset(i as isize) = (*verts.offset(i as isize)).iB;\n939\t                i += 1;\n940\t            }\n941\t            match (*sp).count {\n942\t                1 => {}\n943\t                2 => c22(sp),\n944\t                3 => c23(sp),\n945\t                _ => {}\n946\t            }\n947\t            if (*sp).count == 3 {\n948\t                hit = 1;\n949\t                break;\n950\t            }\n951\t            let p = c2L(sp);\n952\t            d1 = c2Dot(p, p);\n953\t            if d1 > d0 {\n954\t                break;\n955\t            }\n956\t            d0 = d1;\n957\t            let d = c2D(sp);\n958\t            if c2Dot(d, d) < FLT_EPSILON * FLT_EPSILON {\n959\t                break;\n960\t            }\n961\t            let iA = c2Support(pA_verts, pA.count, c2MulrvT(ax.r, c2Neg(d)));\n962\t            let sA = c2Mulxv(ax, *pA_verts.offset(iA as isize));\n963\t            let iB = c2Support(pB_verts, pB.count, c2MulrvT(bx.r, d));\n964\t            let sB = c2Mulxv(bx, *pB_verts.offset(iB as isize));\n965\t            let v = verts.offset((*sp).count as isize);\n966\t            (*v).iA = iA;\n967\t            (*v).sA = sA;\n968\t            (*v).iB = iB;\n969\t            (*v).sB = sB;\n970\t            (*v).p = c2Sub((*v).sB, (*v).sA);\n971\t            let mut dup: c_int = 0;\n972\t            let mut i: c_int = 0;\n973\t            while i < save_count {\n974\t                if iA == *saveA_p.offset(i as isize) && iB == *saveB_p.offset(i as isize) {\n975\t                    dup = 1;\n976\t                    break;\n977\t                }\n978\t                i += 1;\n979\t            }\n980\t            if dup != 0 {\n981\t                break;\n982\t            }\n983\t            (*sp).count += 1;\n984\t            iter += 1;\n985\t        }\n986\t        let _ = d1;\n987\t\n988\t        let mut a = ZERO_V;\n989\t        let mut b = ZERO_V;\n990\t        c2Witness(sp, &mut a, &mut b);\n991\t        let mut dist = c2Len(c2Sub(a, b));\n992\t        if hit != 0 {\n993\t            a = b;\n994\t            dist = 0.0;\n995\t        } else if use_radius != 0 {\n996\t            let rA = pA.radius;\n997\t            let rB = pB.radius;\n998\t            // GCC computes `rA + rB` once (dst = rA) and reuses it for both\n999\t            // the comparison and the subtraction.\n1000\t            let r_sum = add_l(rA, rB);\n1001\t            if dist > r_sum && dist > FLT_EPSILON {\n1002\t                dist = sub_l(dist, r_sum);\n1003\t                let n = c2Norm(c2Sub(b, a));\n1004\t                a = c2Add(a, c2Mulvs(n, rA));\n1005\t                b = c2Sub(b, c2Mulvs(n, rB));\n1006\t                if a.x == b.x && a.y == b.y {\n1007\t                    dist = 0.0;\n1008\t                }\n1009\t            } else {\n1010\t                let p = c2Mulvs(c2Add(a, b), 0.5f32);\n1011\t                a = p;\n1012\t                b = p;\n1013\t                dist = 0.0;\n1014\t            }\n1015\t        }\n1016\t        if !cache.is_null() {\n1017\t            (*cache).metric = c2GJKSimplexMetric(sp);\n1018\t            (*cache).count = (*sp).count;\n1019\t            let cache_iA = addr_of_mut!((*cache).iA) as *mut c_int;\n1020\t            let cache_iB = addr_of_mut!((*cache).iB) as *mut c_int;\n1021\t            let mut i: c_int = 0;\n1022\t            while i < (*sp).count {\n1023\t                let v = verts.offset(i as isize);\n1024\t                *cache_iA.offset(i as isize) = (*v).iA;\n1025\t                *cache_iB.offset(i as isize) = (*v).iB;\n1026\t                i += 1;\n1027\t            }\n1028\t            (*cache).div = (*sp).div;\n1029\t        }\n1030\t        if !outA.is_null() {\n1031\t            *outA = a;\n1032\t        }\n1033\t        if !outB.is_null() {\n1034\t            *outB = b;\n1035\t        }\n1036\t        if !iterations.is_null() {\n1037\t            *iterations = iter;\n1038\t        }\n1039\t        dist\n1040\t    }\n1041\t}\n1042\t\n1043\t// ---------------------------------------------------------------------------\n1044\t// Public entry point declared in include/lib.h\n1045\t// ---------------------------------------------------------------------------\n1046\t\n1047\t/// ```c\n1048\t/// void gjk(char reverse, c2v *a, c2v *b, float a1, float a2, float a3,\n1049\t///          float a4, float b1, float b2, float b3, float b4, float b5);\n1050\t/// ```\n1051\t#[unsafe(no_mangle)]\n1052\tpub unsafe extern \"C\" fn gjk(\n1053\t    reverse: c_char,\n1054\t    a: *mut c2v,\n1055\t    b: *mut c2v,\n1056\t    a1: f32,\n1057\t    a2: f32,\n1058\t    a3: f32,\n1059\t    a4: f32,\n1060\t    b1: f32,\n1061\t    b2: f32,\n1062\t    b3: f32,\n1063\t    b4: f32,\n1064\t    b5: f32,\n1065\t) {\n1066\t    unsafe {\n1067\t        let mut bb = c2AABB {\n1068\t            min: ZERO_V,\n1069\t            max: ZERO_V,\n1070\t        };\n1071\t        bb.min = c2V(a1, a2);\n1072\t        bb.max = c2V(a3, a4);\n1073\t\n1074\t        let mut cap = c2Capsule {\n1075\t            a: ZERO_V,\n1076\t            b: ZERO_V,\n1077\t            r: 0.0,\n1078\t        };\n1079\t        cap.a = c2V(b1, b2);\n1080\t        cap.b = c2V(b3, b4);\n1081\t        cap.r = b5;\n1082\t\n1083\t        if reverse != 0 {\n1084\t            c2GJK(\n1085\t                addr_of_mut!(cap) as *const c_void,\n1086\t                C2_TYPE_CAPSULE,\n1087\t                null(),\n1088\t                addr_of_mut!(bb) as *const c_void,\n1089\t                C2_TYPE_AABB,\n1090\t                null(),\n1091\t                a,\n1092\t                b,\n1093\t                1,\n1094\t                null_mut(),\n1095\t                null_mut(),\n1096\t            );\n1097\t        } else {\n1098\t            c2GJK(\n1099\t                addr_of_mut!(bb) as *const c_void,\n1100\t                C2_TYPE_AABB,\n1101\t                null(),\n1102\t                addr_of_mut!(cap) as *const c_void,\n1103\t                C2_TYPE_CAPSULE,\n1104\t                null(),\n1105\t                a,\n1106\t                b,\n1107\t                1,\n1108\t                null_mut(),\n1109\t                null_mut(),\n1110\t            );\n1111\t        }\n1112\t    }\n1113\t}\n1114\t"}]},"parent_tool_use_id":null,"session_id":"51af6bd4-da19-4276-bde1-7f5d951f391d","uuid":"26a4617e-0f29-4cc3-8772-9d802373ba9d","timestamp":"2026-08-27T09:26:31.256Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-IbhHLG/translation/src/lib.rs","content":"//! Rust translation of `c_src/src/lib.c` — a cute_c2-style 2D GJK distance\n//! solver, built as a C shared library.\n//!\n//! This crate reproduces the **complete public ABI** of the C library (all 31\n//! exported symbols) and is bit-for-bit behaviour compatible with it,\n//! including its quirks and bugs.\n//!\n//! # Why the arithmetic looks the way it does\n//!\n//! The C library is built as a `-fPIC` shared object **without**\n//! `-fvisibility=hidden` and with no `static` functions, so every helper is\n//! interposable and GCC cannot inline any of them — the disassembly shows that\n//! every single call (`c2V`, `c2Dot`, `c2Sub`, `c2Add`, …) goes through the\n//! PLT. That means the library's entire floating-point behaviour is determined\n//! by a small, enumerable set of SSE scalar/packed instructions inside the\n//! leaf functions.\n//!\n//! For every *finite* input, IEEE-754 makes those results uniquely determined,\n//! so a straightforward translation is already bit-exact. The one place where\n//! \"obvious\" Rust diverges is **which NaN survives** an operation: `addss`,\n//! `mulss`, `subss` and `divss` return the *destination* operand's NaN in\n//! preference to the source operand's, and GCC's register allocator sometimes\n//! commutes `addss`/`mulss` relative to the C source order (LLVM does too, but\n//! makes different choices). Because a NaN's sign bit and payload are then\n//! observable in the output, this module routes all arithmetic through\n//! `add_l`/`add_r`/`mul_l`/`mul_r`/`sub_l`/`div_l` helpers that pin the\n//! destination operand to exactly what GCC emitted at each site. The choices\n//! are documented per call site against the disassembly.\n\n#![allow(non_snake_case)]\n#![allow(non_camel_case_types)]\n#![allow(non_upper_case_globals)]\n#![allow(unused_assignments)]\n\nuse core::ffi::{c_char, c_int, c_void};\nuse core::ptr::{addr_of, addr_of_mut, null, null_mut};\n\n// ---------------------------------------------------------------------------\n// Constants, spelled out as literals in the C source\n// ---------------------------------------------------------------------------\n\n/// `FLT_MAX`\nconst FLT_MAX: f32 = 3.402_823_466_385_288_598_117_041_834_845_169_25e+38_f32;\n/// `FLT_EPSILON`\nconst FLT_EPSILON: f32 = 1.192_092_895_507_812_5e-7_f32;\n\n// ---------------------------------------------------------------------------\n// SSE-exact scalar arithmetic\n//\n// Intel SDM, ADDSS/SUBSS/MULSS/DIVSS `xmm1, xmm2`:\n//   * if the destination operand (`xmm1`) is NaN, the result is that NaN,\n//     quieted (SNaN -> QNaN by setting the mantissa MSB); sign and payload\n//     are otherwise preserved;\n//   * otherwise, if the source operand is NaN, the result is that NaN,\n//     quieted;\n//   * otherwise the IEEE-754 operation is performed (which itself may raise\n//     #I and produce the \"QNaN indefinite\" for e.g. 0*Inf or Inf-Inf — that\n//     case is order independent, so plain Rust arithmetic reproduces it).\n//\n// `_l` means the *left* argument was GCC's destination operand; `_r` means\n// GCC commuted the instruction so the *right* argument is the destination.\n// `SUBSS`/`DIVSS` are not commutative, so only the `_l` form exists.\n// ---------------------------------------------------------------------------\n\n/// Quiet a NaN exactly the way an SSE arithmetic instruction does: set the\n/// mantissa MSB, leave sign and the rest of the payload untouched.\n#[inline(always)]\nfn quiet(x: f32) -> f32 {\n    f32::from_bits(x.to_bits() | 0x0040_0000)\n}\n\n/// IEEE-754 negation: a pure sign-bit flip (`xorps` against `0x80000000`),\n/// which never quiets a NaN. This is what GCC emits for `-x` in `c2Neg`,\n/// `c2Skew` and `c2CCW90`.\n#[inline(always)]\nfn fneg(x: f32) -> f32 {\n    f32::from_bits(x.to_bits() ^ 0x8000_0000)\n}\n\n/// `addss a, b` — destination is `a`.\n#[inline(always)]\nfn add_l(a: f32, b: f32) -> f32 {\n    if a.is_nan() {\n        quiet(a)\n    } else if b.is_nan() {\n        quiet(b)\n    } else {\n        a + b\n    }\n}\n\n/// `addss b, a` — destination is `b` (GCC commuted the operands).\n#[inline(always)]\nfn add_r(a: f32, b: f32) -> f32 {\n    if b.is_nan() {\n        quiet(b)\n    } else if a.is_nan() {\n        quiet(a)\n    } else {\n        a + b\n    }\n}\n\n/// `subss a, b` — destination is `a` (subtraction is never commuted).\n#[inline(always)]\nfn sub_l(a: f32, b: f32) -> f32 {\n    if a.is_nan() {\n        quiet(a)\n    } else if b.is_nan() {\n        quiet(b)\n    } else {\n        a - b\n    }\n}\n\n/// `mulss a, b` — destination is `a`.\n#[inline(always)]\nfn mul_l(a: f32, b: f32) -> f32 {\n    if a.is_nan() {\n        quiet(a)\n    } else if b.is_nan() {\n        quiet(b)\n    } else {\n        a * b\n    }\n}\n\n/// `mulss b, a` — destination is `b` (GCC commuted the operands).\n#[inline(always)]\nfn mul_r(a: f32, b: f32) -> f32 {\n    if b.is_nan() {\n        quiet(b)\n    } else if a.is_nan() {\n        quiet(a)\n    } else {\n        a * b\n    }\n}\n\n/// `divss a, b` — destination is `a` (division is never commuted).\n#[inline(always)]\nfn div_l(a: f32, b: f32) -> f32 {\n    if a.is_nan() {\n        quiet(a)\n    } else if b.is_nan() {\n        quiet(b)\n    } else {\n        a / b\n    }\n}\n\n// ---------------------------------------------------------------------------\n// C2_TYPE — an unfixed C enum, so `int`-sized in the ABI\n// ---------------------------------------------------------------------------\n\npub const C2_TYPE_CIRCLE: c_int = 0;\npub const C2_TYPE_AABB: c_int = 1;\npub const C2_TYPE_CAPSULE: c_int = 2;\n\n// ---------------------------------------------------------------------------\n// Structures — layouts mirror the C definitions exactly\n// ---------------------------------------------------------------------------\n\n/// `typedef struct c2v { float x; float y; } c2v;`\n#[repr(C)]\n#[derive(Copy, Clone, Debug)]\npub struct c2v {\n    pub x: f32,\n    pub y: f32,\n}\n\n/// `typedef struct c2r { float c; float s; } c2r;`\n#[repr(C)]\n#[derive(Copy, Clone, Debug)]\npub struct c2r {\n    pub c: f32,\n    pub s: f32,\n}\n\n/// `typedef struct c2x { c2v p; c2r r; } c2x;`\n#[repr(C)]\n#[derive(Copy, Clone, Debug)]\npub struct c2x {\n    pub p: c2v,\n    pub r: c2r,\n}\n\n/// `typedef struct c2Circle { c2v p; float r; } c2Circle;`\n#[repr(C)]\n#[derive(Copy, Clone, Debug)]\npub struct c2Circle {\n    pub p: c2v,\n    pub r: f32,\n}\n\n/// `typedef struct c2AABB { c2v min; c2v max; } c2AABB;`\n#[repr(C)]\n#[derive(Copy, Clone, Debug)]\npub struct c2AABB {\n    pub min: c2v,\n    pub max: c2v,\n}\n\n/// `typedef struct c2Capsule { c2v a; c2v b; float r; } c2Capsule;`\n#[repr(C)]\n#[derive(Copy, Clone, Debug)]\npub struct c2Capsule {\n    pub a: c2v,\n    pub b: c2v,\n    pub r: f32,\n}\n\n/// ```c\n/// typedef struct c2GJKCache {\n///         float metric; int count; int iA[3]; int iB[3]; float div;\n/// } c2GJKCache;\n/// ```\n#[repr(C)]\n#[derive(Copy, Clone, Debug)]\npub struct c2GJKCache {\n    pub metric: f32,\n    pub count: c_int,\n    pub iA: [c_int; 3],\n    pub iB: [c_int; 3],\n    pub div: f32,\n}\n\n/// `typedef struct { float radius; int count; c2v verts[8]; } c2Proxy;`\n#[repr(C)]\n#[derive(Copy, Clone, Debug)]\npub struct c2Proxy {\n    pub radius: f32,\n    pub count: c_int,\n    pub verts: [c2v; 8],\n}\n\n/// `typedef struct { c2v sA; c2v sB; c2v p; float u; int iA; int iB; } c2sv;`\n#[repr(C)]\n#[derive(Copy, Clone, Debug)]\npub struct c2sv {\n    pub sA: c2v,\n    pub sB: c2v,\n    pub p: c2v,\n    pub u: f32,\n    pub iA: c_int,\n    pub iB: c_int,\n}\n\n/// `typedef struct { c2sv a, b, c, d; float div; int count; } c2Simplex;`\n///\n/// The four `c2sv` members `a`, `b`, `c`, `d` are modelled as one array so the\n/// C idiom `c2sv *verts = &s->a; verts[i]` can be reproduced verbatim. The\n/// memory layout is byte-identical to the C struct.\n#[repr(C)]\n#[derive(Copy, Clone, Debug)]\npub struct c2Simplex {\n    /// `a`, `b`, `c`, `d`\n    pub verts: [c2sv; 4],\n    pub div: f32,\n    pub count: c_int,\n}\n\n// Compile-time layout assertions guaranteeing ABI equality with the C structs.\nconst _: () = {\n    assert!(core::mem::size_of::<c2v>() == 8 && core::mem::align_of::<c2v>() == 4);\n    assert!(core::mem::size_of::<c2r>() == 8);\n    assert!(core::mem::size_of::<c2x>() == 16);\n    assert!(core::mem::size_of::<c2Circle>() == 12);\n    assert!(core::mem::size_of::<c2AABB>() == 16);\n    assert!(core::mem::size_of::<c2Capsule>() == 20);\n    assert!(core::mem::size_of::<c2GJKCache>() == 36);\n    assert!(core::mem::size_of::<c2Proxy>() == 72);\n    assert!(core::mem::size_of::<c2sv>() == 36);\n    assert!(core::mem::size_of::<c2Simplex>() == 152);\n};\n\nconst ZERO_V: c2v = c2v { x: 0.0, y: 0.0 };\n\nimpl c2Simplex {\n    #[inline]\n    const fn zeroed() -> c2Simplex {\n        const ZSV: c2sv = c2sv {\n            sA: ZERO_V,\n            sB: ZERO_V,\n            p: ZERO_V,\n            u: 0.0,\n            iA: 0,\n            iB: 0,\n        };\n        c2Simplex {\n            verts: [ZSV; 4],\n            div: 0.0,\n            count: 0,\n        }\n    }\n}\n\nimpl c2Proxy {\n    #[inline]\n    const fn zeroed() -> c2Proxy {\n        c2Proxy {\n            radius: 0.0,\n            count: 0,\n            verts: [ZERO_V; 8],\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Vector / rotation helpers\n// ---------------------------------------------------------------------------\n\n/// `c2v c2V(float x, float y)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n    let mut a = ZERO_V;\n    a.x = x;\n    a.y = y;\n    a\n}\n\n/// `c2v c2Mulvs(c2v a, float b)`\n///\n/// GCC broadcasts the scalar (`movsldup`) into the destination register and\n/// multiplies by `a`: `mulps %xmm2(a), %xmm0(b,b)`. The destination is\n/// therefore `b`, so `b`'s NaN wins over `a`'s.\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulvs(a: c2v, b: f32) -> c2v {\n    let mut a = a;\n    a.x = mul_r(a.x, b);\n    a.y = mul_r(a.y, b);\n    a\n}\n\n/// `c2v c2Maxv(c2v a, c2v b)`\n///\n/// GCC emits `maxss %xmm(b), %xmm(a)`, whose NaN behaviour (\"if either\n/// operand is NaN, return the source operand\") is exactly the C ternary\n/// `a > b ? a : b`. Do **not** use `f32::max` here — it returns the\n/// non-NaN operand instead.\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n    c2V(\n        if a.x > b.x { a.x } else { b.x },\n        if a.y > b.y { a.y } else { b.y },\n    )\n}\n\n/// `c2v c2Minv(c2v a, c2v b)` — `minss`, mirroring `c2Maxv`.\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n    c2V(\n        if a.x < b.x { a.x } else { b.x },\n        if a.y < b.y { a.y } else { b.y },\n    )\n}\n\n/// `c2v c2Clampv(c2v a, c2v lo, c2v hi)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n    c2Maxv(lo, c2Minv(a, hi))\n}\n\n/// `c2v c2Sub(c2v a, c2v b)` — `subps %xmm1(b), %xmm0(a)`, destination `a`.\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Sub(a: c2v, b: c2v) -> c2v {\n    let mut a = a;\n    a.x = sub_l(a.x, b.x);\n    a.y = sub_l(a.y, b.y);\n    a\n}\n\n/// `c2v c2Add(c2v a, c2v b)` — `addps %xmm1(b), %xmm0(a)`, destination `a`.\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Add(a: c2v, b: c2v) -> c2v {\n    let mut a = a;\n    a.x = add_l(a.x, b.x);\n    a.y = add_l(a.y, b.y);\n    a\n}\n\n/// `float c2Dot(c2v a, c2v b)` -> `a.x * b.x + a.y * b.y`\n///\n/// ```text\n/// mulss %xmm1,%xmm0   ; xmm0 = a.x * b.x   (dst a.x)\n/// mulss %xmm3,%xmm1   ; xmm1 = a.y * b.y   (dst a.y)\n/// addss %xmm1,%xmm0   ; dst = a.x * b.x\n/// ```\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n    add_l(mul_l(a.x, b.x), mul_l(a.y, b.y))\n}\n\n/// `float c2Det2(c2v a, c2v b)` -> `a.x * b.y - a.y * b.x`\n///\n/// ```text\n/// mulss %xmm2,%xmm0   ; xmm0 = a.x * b.y   (dst a.x)\n/// mulss %xmm3,%xmm1   ; xmm1 = a.y * b.x   (dst a.y)\n/// subss %xmm1,%xmm0   ; dst = a.x * b.y\n/// ```\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Det2(a: c2v, b: c2v) -> f32 {\n    sub_l(mul_l(a.x, b.y), mul_l(a.y, b.x))\n}\n\n/// `c2r c2RotIdentity(void)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2RotIdentity() -> c2r {\n    let mut r = c2r { c: 0.0, s: 0.0 };\n    r.c = 1.0f32;\n    r.s = 0.0;\n    r\n}\n\n/// `c2x c2xIdentity(void)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2xIdentity() -> c2x {\n    let mut x = c2x {\n        p: ZERO_V,\n        r: c2r { c: 0.0, s: 0.0 },\n    };\n    x.p = c2V(0.0, 0.0);\n    x.r = c2RotIdentity();\n    x\n}\n\n/// `c2v c2Mulrv(c2r a, c2v b)`\n/// -> `c2V(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)`\n///\n/// GCC commuted the `y` term's `addss`, making `a.c * b.y` the destination:\n///\n/// ```text\n/// mulss %xmm1,%xmm5   ; xmm5 = a.s * b.x   (dst a.s)\n/// mulss %xmm3,%xmm1   ; xmm1 = a.c * b.y   (dst a.c)\n/// mulss %xmm4,%xmm0   ; xmm0 = a.c * b.x   (dst a.c)\n/// mulss %xmm3,%xmm2   ; xmm2 = a.s * b.y   (dst a.s)\n/// addss %xmm5,%xmm1   ; y = (a.c*b.y) + (a.s*b.x)   <- dst is the 2nd term\n/// subss %xmm2,%xmm0   ; x = (a.c*b.x) - (a.s*b.y)\n/// ```\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulrv(a: c2r, b: c2v) -> c2v {\n    c2V(\n        sub_l(mul_l(a.c, b.x), mul_l(a.s, b.y)),\n        add_r(mul_l(a.s, b.x), mul_l(a.c, b.y)),\n    )\n}\n\n/// `c2v c2MulrvT(c2r a, c2v b)`\n/// -> `c2V(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y)`\n///\n/// GCC folded `-x + y` into `subss` with `y` as the destination. IEEE-754\n/// addition is commutative, so `(-x) + y == y - x` bit-exactly for every\n/// non-NaN operand (signed zeros and infinities included):\n///\n/// ```text\n/// subss %xmm5,%xmm1   ; y = (a.c*b.y) - (a.s*b.x)\n/// addss %xmm2,%xmm0   ; x = (a.c*b.x) + (a.s*b.y)\n/// ```\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2MulrvT(a: c2r, b: c2v) -> c2v {\n    c2V(\n        add_l(mul_l(a.c, b.x), mul_l(a.s, b.y)),\n        sub_l(mul_l(a.c, b.y), mul_l(a.s, b.x)),\n    )\n}\n\n/// `c2v c2Mulxv(c2x a, c2v b)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulxv(a: c2x, b: c2v) -> c2v {\n    c2Add(c2Mulrv(a.r, b), a.p)\n}\n\n/// `c2v c2Neg(c2v a)` — `xorps` sign flip, no NaN quieting.\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Neg(a: c2v) -> c2v {\n    c2V(fneg(a.x), fneg(a.y))\n}\n\n/// `c2v c2Skew(c2v a)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n    let mut b = ZERO_V;\n    b.x = fneg(a.y);\n    b.y = a.x;\n    b\n}\n\n/// `c2v c2CCW90(c2v a)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n    let mut b = ZERO_V;\n    b.x = a.y;\n    b.y = fneg(a.x);\n    b\n}\n\n/// `c2v c2Div(c2v a, float b)` — `divss %xmm1(b), %xmm2(1.0f)`.\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n    c2Mulvs(a, div_l(1.0f32, b))\n}\n\n/// `c2v c2Norm(c2v a)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n    c2Div(a, c2Len(a))\n}\n\n/// `float c2Len(c2v a)` -> `sqrtf(c2Dot(a, a))`\n///\n/// GCC guards the inline `sqrtss` with `ucomiss`/`ja` and falls back to\n/// `sqrtf@plt` only when the argument is *strictly negative* (NaN leaves the\n/// branch untaken, because `ja` is false when unordered). The argument here is\n/// always a sum of squares, so it is never negative and the inline `sqrtss` —\n/// i.e. `f32::sqrt` — is always what runs.\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Len(a: c2v) -> f32 {\n    c2Dot(a, a).sqrt()\n}\n\n// ---------------------------------------------------------------------------\n// Shape helpers\n// ---------------------------------------------------------------------------\n\n/// `void c2BBVerts(c2v *out, c2AABB *bb)`\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2BBVerts(out: *mut c2v, bb: *mut c2AABB) {\n    unsafe {\n        *out.add(0) = (*bb).min;\n        *out.add(1) = c2V((*bb).max.x, (*bb).min.y);\n        *out.add(2) = (*bb).max;\n        *out.add(3) = c2V((*bb).min.x, (*bb).max.y);\n    }\n}\n\n/// `void c2MakeProxy(const void *shape, C2_TYPE type, c2Proxy *p)`\n///\n/// As in the C original there is no `default:` arm, so for a `type` outside\n/// `{0, 1, 2}` the proxy is left completely untouched.\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2MakeProxy(shape: *const c_void, type_: c_int, p: *mut c2Proxy) {\n    unsafe {\n        match type_ {\n            C2_TYPE_CIRCLE => {\n                let c = shape as *mut c2Circle;\n                (*p).radius = (*c).r;\n                (*p).count = 1;\n                (*p).verts[0] = (*c).p;\n            }\n            C2_TYPE_AABB => {\n                let bb = shape as *mut c2AABB;\n                (*p).radius = 0.0;\n                (*p).count = 4;\n                c2BBVerts(addr_of_mut!((*p).verts) as *mut c2v, bb);\n            }\n            C2_TYPE_CAPSULE => {\n                let c = shape as *mut c2Capsule;\n                (*p).radius = (*c).r;\n                (*p).count = 2;\n                (*p).verts[0] = (*c).a;\n                (*p).verts[1] = (*c).b;\n            }\n            _ => {}\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Simplex routines\n// ---------------------------------------------------------------------------\n\n/// `float c2GJKSimplexMetric(c2Simplex *s)`\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2GJKSimplexMetric(s: *mut c2Simplex) -> f32 {\n    unsafe {\n        let verts = addr_of!((*s).verts) as *const c2sv;\n        match (*s).count {\n            2 => c2Len(c2Sub((*verts.add(1)).p, (*verts.add(0)).p)),\n            3 => c2Det2(\n                c2Sub((*verts.add(1)).p, (*verts.add(0)).p),\n                c2Sub((*verts.add(2)).p, (*verts.add(0)).p),\n            ),\n            // `default:` falls through into `case 1:` in the C source.\n            _ => 0.0,\n        }\n    }\n}\n\n/// `void c22(c2Simplex *s)`\n///\n/// `s->div = u + v` is emitted as `addss %xmm0(v), %xmm2(u)`, destination `u`.\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c22(s: *mut c2Simplex) {\n    unsafe {\n        let verts = addr_of_mut!((*s).verts) as *mut c2sv;\n        let sa = verts.add(0);\n        let sb = verts.add(1);\n\n        let a = (*sa).p;\n        let b = (*sb).p;\n        let u = c2Dot(b, c2Sub(b, a));\n        let v = c2Dot(a, c2Sub(a, b));\n        if v <= 0.0 {\n            (*sa).u = 1.0f32;\n            (*s).div = 1.0f32;\n            (*s).count = 1;\n        } else if u <= 0.0 {\n            *sa = *sb;\n            (*sa).u = 1.0f32;\n            (*s).div = 1.0f32;\n            (*s).count = 1;\n        } else {\n            (*sa).u = u;\n            (*sb).u = v;\n            (*s).div = add_l(u, v);\n            (*s).count = 2;\n        }\n    }\n}\n\n/// `void c23(c2Simplex *s)`\n///\n/// GCC's destination-operand choices for the `div` sums (see disassembly at\n/// `0x1710`):\n///\n/// ```text\n/// 0x1913  addss %xmm5(uBC),%xmm6(vBC)   ; uBC + vBC  -> dst is vBC (commuted)\n/// 0x19e4  addss %xmm6(vCA),%xmm0(uCA)   ; uCA + vCA  -> dst is uCA\n/// 0x1a25  addss %xmm3(vABC),%xmm2(uABC) ; uABC+vABC  -> dst is uABC\n/// 0x1a38  addss %xmm2(sum),%xmm0(wABC)  ; +wABC      -> dst is wABC (commuted)\n/// 0x1a75  addss %xmm3(vAB),%xmm2(uAB)   ; uAB + vAB  -> dst is uAB\n/// ```\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c23(s: *mut c2Simplex) {\n    unsafe {\n        let verts = addr_of_mut!((*s).verts) as *mut c2sv;\n        let sa = verts.add(0);\n        let sb = verts.add(1);\n        let sc = verts.add(2);\n\n        let a = (*sa).p;\n        let b = (*sb).p;\n        let c = (*sc).p;\n        let uAB = c2Dot(b, c2Sub(b, a));\n        let vAB = c2Dot(a, c2Sub(a, b));\n        let uBC = c2Dot(c, c2Sub(c, b));\n        let vBC = c2Dot(b, c2Sub(b, c));\n        let uCA = c2Dot(a, c2Sub(a, c));\n        let vCA = c2Dot(c, c2Sub(c, a));\n        let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n        let uABC = mul_l(c2Det2(b, c), area);\n        let vABC = mul_l(c2Det2(c, a), area);\n        let wABC = mul_l(c2Det2(a, b), area);\n        if vAB <= 0.0 && uCA <= 0.0 {\n            (*sa).u = 1.0f32;\n            (*s).div = 1.0f32;\n            (*s).count = 1;\n        } else if uAB <= 0.0 && vBC <= 0.0 {\n            *sa = *sb;\n            (*sa).u = 1.0f32;\n            (*s).div = 1.0f32;\n            (*s).count = 1;\n        } else if uBC <= 0.0 && vCA <= 0.0 {\n            *sa = *sc;\n            (*sa).u = 1.0f32;\n            (*s).div = 1.0f32;\n            (*s).count = 1;\n        } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n            (*sa).u = uAB;\n            (*sb).u = vAB;\n            (*s).div = add_l(uAB, vAB);\n            (*s).count = 2;\n        } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n            *sa = *sb;\n            *sb = *sc;\n            (*sa).u = uBC;\n            (*sb).u = vBC;\n            (*s).div = add_r(uBC, vBC);\n            (*s).count = 2;\n        } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n            *sb = *sa;\n            *sa = *sc;\n            (*sa).u = uCA;\n            (*sb).u = vCA;\n            (*s).div = add_l(uCA, vCA);\n            (*s).count = 2;\n        } else {\n            (*sa).u = uABC;\n            (*sb).u = vABC;\n            (*sc).u = wABC;\n            (*s).div = add_r(add_l(uABC, vABC), wABC);\n            (*s).count = 3;\n        }\n    }\n}\n\n/// `c2v c2D(c2Simplex *s)`\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2D(s: *mut c2Simplex) -> c2v {\n    unsafe {\n        let verts = addr_of!((*s).verts) as *const c2sv;\n        match (*s).count {\n            1 => c2Neg((*verts.add(0)).p),\n            2 => {\n                let ab = c2Sub((*verts.add(1)).p, (*verts.add(0)).p);\n                if c2Det2(ab, c2Neg((*verts.add(0)).p)) > 0.0 {\n                    return c2Skew(ab);\n                }\n                c2CCW90(ab)\n            }\n            // `case 3:` and `default:`\n            _ => c2V(0.0, 0.0),\n        }\n    }\n}\n\n/// `int c2Support(const c2v *verts, int count, c2v d)`\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2Support(verts: *const c2v, count: c_int, d: c2v) -> c_int {\n    unsafe {\n        let mut imax: c_int = 0;\n        let mut dmax = c2Dot(*verts.add(0), d);\n        let mut i: c_int = 1;\n        while i < count {\n            let dot = c2Dot(*verts.offset(i as isize), d);\n            if dot > dmax {\n                imax = i;\n                dmax = dot;\n            }\n            i += 1;\n        }\n        imax\n    }\n}\n\