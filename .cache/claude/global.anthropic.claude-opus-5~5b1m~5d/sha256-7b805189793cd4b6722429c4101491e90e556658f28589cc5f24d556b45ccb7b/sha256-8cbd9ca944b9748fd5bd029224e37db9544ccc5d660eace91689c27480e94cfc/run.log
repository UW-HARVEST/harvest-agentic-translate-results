 0 && uABC <= 0) {\r\n   237\t\t\ts->a = s->b;\r\n   238\t\t\ts->b = s->c;\r\n   239\t\t\ts->a.u = uBC;\r\n   240\t\t\ts->b.u = vBC;\r\n   241\t\t\ts->div = uBC + vBC;\r\n   242\t\t\ts->count = 2;\r\n   243\t\t} else if (uCA > 0 && vCA > 0 && vABC <= 0) {\r\n   244\t\t\ts->b = s->a;\r\n   245\t\t\ts->a = s->c;\r\n   246\t\t\ts->a.u = uCA;\r\n   247\t\t\ts->b.u = vCA;\r\n   248\t\t\ts->div = uCA + vCA;\r\n   249\t\t\ts->count = 2;\r\n   250\t\t} else {\r\n   251\t\t\ts->a.u = uABC;\r\n   252\t\t\ts->b.u = vABC;\r\n   253\t\t\ts->c.u = wABC;\r\n   254\t\t\ts->div = uABC + vABC + wABC;\r\n   255\t\t\ts->count = 3;\r\n   256\t\t}\r\n   257\t}\r\n   258\t\r\n   259\tc2v c2Neg(c2v a) {\r\n   260\t\treturn c2V(-a.x, -a.y);\r\n   261\t}\r\n   262\t\r\n   263\tc2v c2Skew(c2v a) {\r\n   264\t\tc2v b;\r\n   265\t\tb.x = -a.y;\r\n   266\t\tb.y = a.x;\r\n   267\t\treturn b;\r\n   268\t}\r\n   269\t\r\n   270\tc2v c2CCW90(c2v a) {\r\n   271\t\tc2v b;\r\n   272\t\tb.x = a.y;\r\n   273\t\tb.y = -a.x;\r\n   274\t\treturn b;\r\n   275\t}\r\n   276\t\r\n   277\tc2v c2D(c2Simplex *s) {\r\n   278\t\tswitch (s->count) {\r\n   279\t\t\tcase 1:\r\n   280\t\t\t\treturn c2Neg(s->a.p);\r\n   281\t\t\tcase 2: {\r\n   282\t\t\t\t\tc2v ab = c2Sub(s->b.p, s->a.p);\r\n   283\t\t\t\t\tif (c2Det2(ab, c2Neg(s->a.p)) > 0)\r\n   284\t\t\t\t\t\treturn c2Skew(ab);\r\n   285\t\t\t\t\treturn c2CCW90(ab);\r\n   286\t\t\t\t}\r\n   287\t\t\tcase 3:\r\n   288\t\t\tdefault:\r\n   289\t\t\t\treturn c2V(0, 0);\r\n   290\t\t}\r\n   291\t}\r\n   292\t\r\n   293\tint c2Support(const c2v *verts, int count, c2v d) {\r\n   294\t\tint imax = 0;\r\n   295\t\tfloat dmax = c2Dot(verts[0], d);\r\n   296\t\tfor (int i = 1; i < count; ++i) {\r\n   297\t\t\tfloat dot = c2Dot(verts[i], d);\r\n   298\t\t\tif (dot > dmax) {\r\n   299\t\t\t\timax = i;\r\n   300\t\t\t\tdmax = dot;\r\n   301\t\t\t}\r\n   302\t\t}\r\n   303\t\treturn imax;\r\n   304\t}\r\n   305\t\r\n   306\tvoid c2Witness(c2Simplex *s, c2v *a, c2v *b) {\r\n   307\t\tfloat den = 1.0f / s->div;\r\n   308\t\tswitch (s->count) {\r\n   309\t\t\tcase 1:\r\n   310\t\t\t\t*a = s->a.sA;\r\n   311\t\t\t\t*b = s->a.sB;\r\n   312\t\t\t\tbreak;\r\n   313\t\t\tcase 2:\r\n   314\t\t\t\t*a = c2Add(c2Mulvs(s->a.sA, (den * s->a.u)),\r\n   315\t\t\t\t\t\tc2Mulvs(s->b.sA, (den * s->b.u)));\r\n   316\t\t\t\t*b = c2Add(c2Mulvs(s->a.sB, (den * s->a.u)),\r\n   317\t\t\t\t\t\tc2Mulvs(s->b.sB, (den * s->b.u)));\r\n   318\t\t\t\tbreak;\r\n   319\t\t\tcase 3:\r\n   320\t\t\t\t*a = c2Add(c2Add(c2Mulvs(s->a.sA, (den * s->a.u)),\r\n   321\t\t\t\t\t\t\tc2Mulvs(s->b.sA, (den * s->b.u))),\r\n   322\t\t\t\t\t\tc2Mulvs(s->c.sA, (den * s->c.u)));\r\n   323\t\t\t\t*b = c2Add(c2Add(c2Mulvs(s->a.sB, (den * s->a.u)),\r\n   324\t\t\t\t\t\t\tc2Mulvs(s->b.sB, (den * s->b.u))),\r\n   325\t\t\t\t\t\tc2Mulvs(s->c.sB, (den * s->c.u)));\r\n   326\t\t\t\tbreak;\r\n   327\t\t\tdefault:\r\n   328\t\t\t\t*a = c2V(0, 0);\r\n   329\t\t\t\t*b = c2V(0, 0);\r\n   330\t\t}\r\n   331\t}\r\n   332\t\r\n   333\tc2v c2Div(c2v a, float b) {\r\n   334\t\treturn c2Mulvs(a, 1.0f / b);\r\n   335\t}\r\n   336\t\r\n   337\tc2v c2Norm(c2v a) {\r\n   338\t\treturn c2Div(a, c2Len(a));\r\n   339\t}\r\n   340\t\r\n   341\tc2v c2L(c2Simplex *s) {\r\n   342\t    float den = 1.0f / s->div;\r\n   343\t    switch (s->count) {\r\n   344\t    case 1:\r\n   345\t        return s->a.p;\r\n   346\t    case 2:\r\n   347\t        return c2Add(c2Mulvs(s->a.p, (den * s->a.u)),\r\n   348\t                     c2Mulvs(s->b.p, (den * s->b.u)));\r\n   349\t    default:\r\n   350\t        return c2V(0, 0);\r\n   351\t    }\r\n   352\t}\r\n   353\t\r\n   354\tc2v c2MulrvT(c2r a, c2v b) {\r\n   355\t    return c2V(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y);\r\n   356\t}\r\n   357\t\r\n   358\tfloat c2GJK(const void *A, C2_TYPE typeA, const c2x *ax_ptr, const void *B,\r\n   359\t\t\tC2_TYPE typeB, const c2x *bx_ptr, c2v *outA, c2v *outB,\r\n   360\t\t\tint use_radius, int *iterations, c2GJKCache *cache) {\r\n   361\t\