     while let Some(c) = rd.peek() {\n            if c.is_ascii_digit() {\n                edigits.push(c as char);\n                rd.next_byte();\n            } else {\n                break;\n            }\n        }\n        if !edigits.is_empty() {\n            let mut v: i64 = 0;\n            for ch in edigits.bytes() {\n                v = v.saturating_mul(10).saturating_add((ch - b'0') as i64);\n                if v > 1_000_000 {\n                    v = 1_000_000;\n                }\n            }\n            pexp = if eneg { -v } else { v };\n        }\n    }\n\n    let total = exp_adj - 4 * frac_count + pexp;\n    let e = total.clamp(-100_000, 100_000) as i32;\n    Some(assemble(m, sticky, e, neg))\n}\n\nfn print_hex(bytes: &[u8], out: &mut impl Write) {\n    let mut s = String::with_capacity(bytes.len() * 2 + 1);\n    for b in bytes {\n        s.push_str(&format!(\"{:02x}\", b));\n    }\n    s.push('\\n');\n    let _ = out.write_all(s.as_bytes());\n}\n\nfn driver(x: f32, out: &mut impl Write) {\n    print_hex(&x.to_ne_bytes(), out);\n}\n\nfn main() {\n    let mut x: f32 = 0.0;\n    let mut rd = Reader::new();\n    if let Some(v) = scan_float(&mut rd) {\n        x = v;\n    }\n    let stdout = io::stdout();\n    let mut lock = stdout.lock();\n    driver(x, &mut lock);\n    let _ = lock.flush();\n}\n","structuredPatch":[{"oldStart":411,"oldLines":39,"newStart":411,"newLines":15,"lines":["     let mut pexp: i64 = 0;","     if rd.peek() == Some(b'p') || rd.peek() == Some(b'P') {","         rd.next_byte();","-        let mut eneg = false;","-        match rd.peek() {","-            Some(b'+') => {","-                rd.next_byte();","-            }","-            Some(b'-') => {","-                rd.next_byte();","-                eneg = true;","-            }","-            _ => {}","-        }","-        let mut edigits = String::new();","-        while let Some(c) = rd.peek() {","-            if c.is_ascii_digit() {","-                edigits.push(c as 