rflow {\n    67\t        return StrToULResult {\n    68\t            value: u64::MAX, // ULONG_MAX\n    69\t            end_index: i,\n    70\t            range_error: true,\n    71\t        };\n    72\t    }\n    73\t\n    74\t    // A negative value is negated modulo 2^64, exactly like C.\n    75\t    let value = if negative { value.wrapping_neg() } else { value };\n    76\t\n    77\t    StrToULResult {\n    78\t        value,\n    79\t        end_index: i,\n    80\t        range_error: false,\n    81\t    }\n    82\t}\n    83\t\n    84\tconst DEG: usize = 31;\n    85\tconst SEP: usize = 3;\n    86\t\n    87\t/// glibc's default `rand()` generator (TYPE_3).\n    88\tpub struct GlibcRand {\n    89\t    state: [i32; DEG],\n    90\t    fptr: usize,\n    91\t    rptr: usize,\n    92\t}\n    93\t\n    94\timpl GlibcRand {\n    95\t    /// Equivalent of `srand(seed)`.\n    96\t    pub fn new(seed: u32) -> Self {\n    97\t        // glibc replaces a seed of 0 with 1 so the state never becomes all-zero.\n    98\t        let seed = if seed == 0 { 1 } else { seed };\n    99\t\n   100\t        let mut state = [0i32; DEG];\n   101\t        state[0] = seed as i32;\n   102\t        for i in 1..DEG {\n   103\t            // state[i] = (16807 * state[i - 1]) % 2147483647 computed without\n   104\t            // overflowing a 32 bit signed integer (Schrage's method).\n   105\t            let prev = i64::from(state[i - 1]);\n   106\t            let hi = prev / 127773;\n   107\t            let lo = prev % 127773;\n   108\t            let mut word = 16807 * lo - 2836 * hi;\n   109\t            if word < 0 {\n   110\t                word += 2147483647;\n   111\t            }\n   112\t            state[i] = word as i32;\n   113\t        }\n   114\t\n   115\t        let mut rng = GlibcRand {\n   116\t            state,\n   117\t            fptr: SEP,\n   118\t            rptr: 0,\n   119\t        };\n   120\t\n   121\t        // glibc discards the first 10 * DEG outputs.\n   122\t      