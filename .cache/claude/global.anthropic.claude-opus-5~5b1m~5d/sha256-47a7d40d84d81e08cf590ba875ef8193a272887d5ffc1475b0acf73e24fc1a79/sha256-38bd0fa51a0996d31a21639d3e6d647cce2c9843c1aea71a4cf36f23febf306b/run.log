g);\n  cmp_mem(buf, c_in_arena, r_in_arena, inuse);\n\n  checks++;\n  const char *ce = *C->err, *re = *R->err;\n  if ((ce == NULL) != (re == NULL) || (ce && re && strcmp(ce, re) != 0)) {\n    failures++;\n    printf(\"MISMATCH %s: cp_error_reason \\\"%s\\\" vs \\\"%s\\\"\\n\", tag,\n           ce ? ce : \"(null)\", re ? re : \"(null)\");\n  }\n  if (failures > 25) { printf(\"too many failures, aborting\\n\"); exit(1); }\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":247,"cache_read_input_tokens":65766,"cache_creation":{"ephemeral_5m_input_tokens":247,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"d76d48bb-1f9c-43a9-bca7-d11e75e69bbc","uuid":"96ceae3c-9abd-4135-a7c3-07cbe910b11d","timestamp":"2026-08-27T13:41:16.815Z"}
