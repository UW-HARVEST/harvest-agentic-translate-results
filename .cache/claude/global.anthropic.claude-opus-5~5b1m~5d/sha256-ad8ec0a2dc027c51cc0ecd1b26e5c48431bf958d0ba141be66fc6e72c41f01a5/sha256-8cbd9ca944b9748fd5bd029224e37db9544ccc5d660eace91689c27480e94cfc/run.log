{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_016Yf3BXpmfXDxYfKgTfMcqN","type":"tool_result","content":"1\t//! Shared differential-test harness.\n2\t//!\n3\t//! BOTH the C `.so` and the Rust `.so` are loaded with `libloading` and every\n4\t//! call goes through the dynamic-symbol table, exactly as an external C caller\n5\t//! would do it. No Rust function is ever called directly.\n6\t\n7\t#![allow(dead_code)]\n8\t\n9\tuse libloading::{Library, Symbol};\n10\tuse std::ffi::{c_char, c_int, c_void};\n11\tuse std::path::PathBuf;\n12\t\n13\tunsafe extern \"C\" {\n14\t    fn malloc(n: usize) -> *mut c_void;\n15\t    fn free(p: *mut c_void);\n16\t}\n17\t\n18\t// ---------------------------------------------------------------------------\n19\t// Library location\n20\t// ---------------------------------------------------------------------------\n21\t\n22\tfn crate_root() -> PathBuf {\n23\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n24\t}\n25\t\n26\t/// The C library is named after the *parent directory* of `c_src`\n27\t/// (see `cmake_path(GET parent FILENAME project_name)`), so glob for it\n28\t/// instead of hard-coding the name.\n29\tpub fn c_so_path() -> PathBuf {\n30\t    let dir = crate_root().join(\"../c_src/build\");\n31\t    let mut found: Vec<PathBuf> = std::fs::read_dir(&dir)\n32\t        .unwrap_or_else(|e| panic!(\"cannot read {}: {e}. Build the C lib first.\", dir.display()))\n33\t        .filter_map(|e| e.ok().map(|e| e.path()))\n34\t        .filter(|p| {\n35\t            let n = p.file_name().and_then(|s| s.to_str()).unwrap_or(\"\");\n36\t            n.starts_with(\"lib\") && n.ends_with(\".so\")\n37\t        })\n38\t        .collect();\n39\t    found.sort();\n40\t    assert_eq!(found.len(), 1, \"expected exactly one C .so in {}, got {found:?}\", dir.display());\n41\t    found.pop().unwrap()\n42\t}\n43\t\n44\tpub fn rust_so_path() -> PathBuf {\n45\t    // The integration-test binary lives in target/<profile>/deps/, so the\n46\t    // cdylib is two levels up.\n47\t    let mut p = std::env::current_exe().unwrap();\n48\t    p.pop(); // deps\n49\t    p.pop(); // <profile>\n50\t    let so = p.join(\"libarity_lib.so\");\n51\t    assert!(so.exists(), \"{} missing; run `cargo build` first\", so.display());\n52\t\n53\t    // ------------------------------------------------------------------\n54\t    // STALENESS GUARD  (critical!)\n55\t    //\n56\t    // These tests `dlopen` the cdylib by PATH, so they declare no Cargo\n57\t    // dependency on it. That means `cargo test --test <name>` will happily\n58\t    // run against a MONTH-OLD `.so`: an injected bug in `src/lib.rs` would\n59\t    // silently still \"pass\". Verified empirically. So refuse to run unless\n60\t    // the `.so` is newer than every source input.\n61\t    // ------------------------------------------------------------------\n62\t    let so_mtime = std::fs::metadata(&so).and_then(|m| m.modified()).unwrap();\n63\t    for src in [\"src/lib.rs\", \"Cargo.toml\"] {\n64\t        let sp = crate_root().join(src);\n65\t        let Ok(m) = std::fs::metadata(&sp).and_then(|m| m.modified()) else {\n66\t            continue;\n67\t        };\n68\t        assert!(\n69\t            m <= so_mtime,\n70\t            \"\\n\\n*** STALE RUST .so ***\\n\\\n71\t             {} is newer than {}.\\n\\\n72\t             `cargo test --test <name>` does NOT rebuild a cdylib that the test\\n\\\n73\t             only dlopens by path, so this run would have tested an OLD library.\\n\\\n74\t             Run `cargo build --release` (or ./run_tests.sh) first.\\n\",\n75\t            sp.display(),\n76\t            so.display()\n77\t        );\n78\t    }\n79\t    so\n80\t}\n81\t\n82\t// ---------------------------------------------------------------------------\n83\t// The 9 exported symbols, as raw C function pointers\n84\t// ---------------------------------------------------------------------------\n85\t\n86\tpub type FnShiftArray = unsafe extern \"C\" fn(*mut c_int, c_int, c_int);\n87\tpub type FnProcessString = unsafe extern \"C\" fn(*const c_char) -> c_int;\n88\tpub type FnApplyBitmask = unsafe extern \"C\" fn(c_int, c_int) -> c_int;\n89\tpub type FnInitMatrix = unsafe extern \"C\" fn(*mut c_int);\n90\tpub type FnCompareAllocations = unsafe extern \"C\" fn(c_int, c_int) -> c_int;\n91\tpub type FnArity4 = unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int;\n92\tpub type FnArity3 = unsafe extern \"C\" fn(c_int, c_int, c_int) -> c_int;\n93\tpub type FnArity2 = unsafe extern \"C\" fn(c_int, c_int) -> c_int;\n94\tpub type FnArity = unsafe extern \"C\" fn(c_int, *const c_int) -> c_int;\n95\t\n96\tpub struct Lib {\n97\t    pub name: &'static str,\n98\t    pub shift_array: FnShiftArray,\n99\t    pub process_string: FnProcessString,\n100\t    pub apply_bitmask: FnApplyBitmask,\n101\t    pub init_matrix: FnInitMatrix,\n102\t    pub compare_allocations: FnCompareAllocations,\n103\t    pub arity4: FnArity4,\n104\t    pub arity3: FnArity3,\n105\t    pub arity2: FnArity2,\n106\t    pub arity: FnArity,\n107\t}\n108\t\n109\timpl Lib {\n110\t    fn open(name: &'static str, path: &std::path::Path) -> Lib {\n111\t        // Leaked so the symbols stay valid for the whole test process, and so\n112\t        // the library is never `dlclose`d mid-test.\n113\t        let lib: &'static Library = Box::leak(Box::new(unsafe {\n114\t            Library::new(path).unwrap_or_else(|e| panic!(\"dlopen {}: {e}\", path.display()))\n115\t        }));\n116\t        unsafe fn sym<T: Copy>(lib: &'static Library, n: &[u8], who: &str) -> T {\n117\t            let s: Symbol<T> = unsafe { lib.get(n) }\n118\t                .unwrap_or_else(|e| panic!(\"{who}: missing symbol {}: {e}\", String::from_utf8_lossy(n)));\n119\t            *s\n120\t        }\n121\t        unsafe {\n122\t            Lib {\n123\t                name,\n124\t                shift_array: sym(lib, b\"shift_array\", name),\n125\t                process_string: sym(lib, b\"process_string\", name),\n126\t                apply_bitmask: sym(lib, b\"apply_bitmask\", name),\n127\t                init_matrix: sym(lib, b\"init_matrix\", name),\n128\t                compare_allocations: sym(lib, b\"compare_allocations\", name),\n129\t                arity4: sym(lib, b\"arity4\", name),\n130\t                arity3: sym(lib, b\"arity3\", name),\n131\t                arity2: sym(lib, b\"arity2\", name),\n132\t                arity: sym(lib, b\"arity\", name),\n133\t            }\n134\t        }\n135\t    }\n136\t}\n137\t\n138\t/// Loads both libraries. `.0` = C (ground truth), `.1` = Rust.\n139\tpub fn both() -> (Lib, Lib) {\n140\t    (\n141\t        Lib::open(\"C\", &c_so_path()),\n142\t        Lib::open(\"Rust\", &rust_so_path()),\n143\t    )\n144\t}\n145\t\n146\t// ---------------------------------------------------------------------------\n147\t// Allocator-state normalization  (see CONFIGS.md, axis G)\n148\t// ---------------------------------------------------------------------------\n149\t\n150\t/// `compare_allocations()` observably compares the two addresses returned by\n151\t/// two consecutive `malloc(sizeof(int))` calls. glibc's tcache is LIFO, so the\n152\t/// result depends on process-global allocation *history*, not on the arguments.\n153\t///\n154\t/// This primes the 32-byte tcache bin so that the next two `malloc(4)` calls\n155\t/// return the lower address first (`asc = true` -> `ptr1 < ptr2` -> `result 1`)\n156\t/// or the higher address first (`asc = false` -> `ptr1 > ptr2` -> `result 2`).\n157\t///\n158\t/// Making this explicit turns a nondeterministic artifact into a *controlled\n159\t/// input axis*, and lets both pointer-ordering arms be tested deliberately.\n160\t///\n161\t/// Must be called immediately before the measured call, with no intervening\n162\t/// heap traffic.\n163\t#[inline(never)]\n164\tpub fn normalize_heap(asc: bool) {\n165\t    unsafe {\n166\t        let a = malloc(4);\n167\t        let b = malloc(4);\n168\t        assert!(!a.is_null() && !b.is_null());\n169\t        let (lo, hi) = if (a as usize) < (b as usize) { (a, b) } else { (b, a) };\n170\t        if asc {\n171\t            free(hi);\n172\t            free(lo);\n173\t        } else {\n174\t            free(lo);\n175\t            free(hi);\n176\t        }\n177\t    }\n178\t}\n179\t\n180\tpub const BOTH_ORDERS: [bool; 2] = [true, false];\n181\t\n182\t// ---------------------------------------------------------------------------\n183\t// Serialization + retry for heap-sensitive differential calls\n184\t// ---------------------------------------------------------------------------\n185\t\n186\tfn heap_mutex() -> &'static std::sync::Mutex<()> {\n187\t    static M: std::sync::OnceLock<std::sync::Mutex<()>> = std::sync::OnceLock::new();\n188\t    M.get_or_init(|| std::sync::Mutex::new(()))\n189\t}\n190\t\n191\t/// Differential call for any entry point that reaches `compare_allocations`.\n192\t///\n193\t/// `normalize_heap` assumes the next two `malloc(4)` calls hand back exactly\n194\t/// the two chunks it just freed. That holds within a thread, but glibc refills\n195\t/// an empty per-thread tcache bin from the SHARED arena, so a concurrent test\n196\t/// thread can steal the chunk in between. Measured: single-threaded runs are\n197\t/// 100% stable, `--test-threads=8` intermittently reports a bogus off-by-one.\n198\t///\n199\t/// So: hold a process-wide lock across the whole normalize/call/normalize/call\n200\t/// critical section, and retry on mismatch. A transient heap perturbation\n201\t/// cannot masquerade as a divergence, while a genuine translation bug is\n202\t/// deterministic and mismatches on every attempt.\n203\tpub fn diff_norm(\n204\t    row: &str,\n205\t    ctx: impl std::fmt::Debug,\n206\t    asc: bool,\n207\t    cf: &mut dyn FnMut() -> c_int,\n208\t    rf: &mut dyn FnMut() -> c_int,\n209\t) -> c_int {\n210\t    let mut last = (0, 0);\n211\t    for _ in 0..8 {\n212\t        let g = heap_mutex().lock().unwrap_or_else(|e| e.into_inner());\n213\t        normalize_heap(asc);\n214\t        let cv = cf();\n215\t        normalize_heap(asc);\n216\t        let rv = rf();\n217\t        drop(g);\n218\t        if cv == rv {\n219\t            return cv;\n220\t        }\n221\t        last = (cv, rv);\n222\t    }\n223\t    eq_i32(row, ctx, last.0, last.1);\n224\t    unreachable!(\"eq_i32 must have panicked\")\n225\t}\n226\t\n227\t/// Same, for a whole replayed SEQUENCE of calls (see `CONFIGS.md` row 22/42).\n228\tpub fn diff_norm_seq<T: PartialEq + std::fmt::Debug>(\n229\t    row: &str,\n230\t    asc: bool,\n231\t    cf: &mut dyn FnMut() -> Vec<T>,\n232\t    rf: &mut dyn FnMut() -> Vec<T>,\n233\t) -> Vec<T> {\n234\t    let mut last: Option<(Vec<T>, Vec<T>)> = None;\n235\t    for _ in 0..8 {\n236\t        let g = heap_mutex().lock().unwrap_or_else(|e| e.into_inner());\n237\t        normalize_heap(asc);\n238\t        let cs = cf();\n239\t        normalize_heap(asc);\n240\t        let rs = rf();\n241\t        drop(g);\n242\t        if cs == rs {\n243\t            return cs;\n244\t        }\n245\t        last = Some((cs, rs));\n246\t    }\n247\t    let (cs, rs) = last.unwrap();\n248\t    let i = cs.iter().zip(&rs).position(|(a, b)| a != b);\n249\t    panic!(\n250\t        \"\\n[{row}] C/Rust SEQUENCE DIVERGENCE (persisted across 8 retries)\\n  \\\n251\t         first differing index: {i:?}\\n  C len={} Rust len={}\\n  C    : {:?}\\n  Rust : {:?}\\n\",\n252\t        cs.len(),\n253\t        rs.len(),\n254\t        i.map(|i| &cs[i.saturating_sub(2)..(i + 3).min(cs.len())]),\n255\t        i.map(|i| &rs[i.saturating_sub(2)..(i + 3).min(rs.len())]),\n256\t    );\n257\t}\n258\t\n259\t// ---------------------------------------------------------------------------\n260\t// Deterministic RNG (SplitMix64) — fixed seed for reproducibility\n261\t// ---------------------------------------------------------------------------\n262\t\n263\tpub const SEED: u64 = 0x5EED_1234_ABCD;\n264\t\n265\tpub struct Rng(u64);\n266\t\n267\timpl Rng {\n268\t    pub fn new(seed: u64) -> Rng {\n269\t        Rng(seed)\n270\t    }\n271\t    pub fn next_u64(&mut self) -> u64 {\n272\t        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);\n273\t        let mut z = self.0;\n274\t        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);\n275\t        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);\n276\t        z ^ (z >> 31)\n277\t    }\n278\t    /// Uniform over the whole `i32` range (including `INT_MIN`/`INT_MAX`).\n279\t    pub fn i32(&mut self) -> i32 {\n280\t        self.next_u64() as u32 as i32\n281\t    }\n282\t    /// Uniform in `lo..=hi`.\n283\t    pub fn range_i32(&mut self, lo: i32, hi: i32) -> i32 {\n284\t        debug_assert!(lo <= hi);\n285\t        let span = (hi as i64 - lo as i64 + 1) as u64;\n286\t        (lo as i64 + (self.next_u64() % span) as i64) as i32\n287\t    }\n288\t    pub fn range_usize(&mut self, lo: usize, hi: usize) -> usize {\n289\t        debug_assert!(lo <= hi);\n290\t        lo + (self.next_u64() % (hi - lo + 1) as u64) as usize\n291\t    }\n292\t    pub fn u8_nonzero(&mut self) -> u8 {\n293\t        (self.next_u64() % 255) as u8 + 1\n294\t    }\n295\t    /// A value biased towards interesting boundaries.\n296\t    pub fn spicy_i32(&mut self) -> i32 {\n297\t        const SPICE: [i32; 17] = [\n298\t            0, 1, -1, 2, -2, 3, -3, 4, -4, 100, -100, 101, -101, 99, -99,\n299\t            i32::MIN, i32::MAX,\n300\t        ];\n301\t        if self.next_u64() % 3 == 0 {\n302\t            SPICE[(self.next_u64() % SPICE.len() as u64) as usize]\n303\t        } else {\n304\t            self.i32()\n305\t        }\n306\t    }\n307\t}\n308\t\n309\t// ---------------------------------------------------------------------------\n310\t// Assertion helpers\n311\t// ---------------------------------------------------------------------------\n312\t\n313\t#[track_caller]\n314\tpub fn eq_i32(row: &str, ctx: impl std::fmt::Debug, c: c_int, r: c_int) {\n315\t    assert_eq!(\n316\t        c, r,\n317\t        \"\\n[{row}] C/Rust DIVERGENCE\\n  input : {ctx:?}\\n  C     : {c}\\n  Rust  : {r}\\n\"\n318\t    );\n319\t}\n320\t\n321\t#[track_caller]\n322\tpub fn eq_slice(row: &str, ctx: impl std::fmt::Debug, c: &[c_int], r: &[c_int]) {\n323\t    assert_eq!(\n324\t        c, r,\n325\t        \"\\n[{row}] C/Rust DIVERGENCE\\n  input : {ctx:?}\\n  C     : {c:?}\\n  Rust  : {r:?}\\n\"\n326\t    );\n327\t}\n328\t\n329\t/// A NUL-terminated C string buffer that also keeps trailing bytes, so tests\n330\t/// can place an interior NUL and still observe what lies beyond it.\n331\tpub fn cbuf(bytes: &[u8]) -> Vec<c_char> {\n332\t    let mut v: Vec<c_char> = bytes.iter().map(|&b| b as c_char).collect();\n333\t    v.push(0);\n334\t    v\n335\t}\n336\t"}]},"parent_tool_use_id":"toolu_bdrk_016VEYbRuiyp1Pr4A51Mikvf","session_id":"d1c4dd0b-13a9-41fa-b25b-7eb02d42a017","uuid":"e6ef1930-471e-4dee-8235-d97e4f1191a8","timestamp":"2026-09-05T13:09:35.611Z","subagent_type":"general-purpose","task_description":"Refactor heap-sensitive test call sites"}
