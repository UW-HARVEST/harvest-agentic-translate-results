{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_016nUD5NM85pm2JAUBQLXhaF","type":"tool_result","content":"1\t//! Phase C — error-path differential tests.\n2\t//!\n3\t//! One test per row of `ERRORS.md`. Every test constructs the exact invalid\n4\t//! input and asserts C and Rust produce the SAME error/sentinel/fault — not\n5\t//! merely \"both failed somehow\".\n6\t\n7\tmod common;\n8\tuse common::*;\n9\tuse std::ffi::c_int;\n10\tuse std::process::Command;\n11\t\n12\t// ===========================================================================\n13\t// rows 1..5 — arity() length rejection & truncation\n14\t// ===========================================================================\n15\t\n16\t#[test]\n17\tfn err_01_arity_len_trunc_zero() {\n18\t    let (c, r) = both();\n19\t    let params = [11i32, 22, 33, 44, 55, 66, 77, 88];\n20\t    // Every int whose low byte is 0 must be rejected with exactly -1.\n21\t    let mut lens = vec![0i32, 256, 512, 768, 1024, 65536, 0x7FFF_FF00];\n22\t    lens.extend((1..=64).map(|k| k * 256));\n23\t    for len in lens {\n24\t        assert_eq!(len as u8, 0, \"test bug: {len} low byte != 0\");\n25\t        let cv = unsafe { (c.arity)(len, params.as_ptr()) };\n26\t        let rv = unsafe { (r.arity)(len, params.as_ptr()) };\n27\t        eq_i32(\"err-01\", len, cv, rv);\n28\t        assert_eq!(cv, -1, \"C must reject len={len} (low byte 0) with -1\");\n29\t    }\n30\t}\n31\t\n32\t#[test]\n33\tfn err_02_arity_len_trunc_one() {\n34\t    let (c, r) = both();\n35\t    let params = [11i32, 22, 33, 44, 55, 66, 77, 88];\n36\t    let mut lens = vec![1i32, 257, 513, 65537];\n37\t    lens.extend((1..=64).map(|k| k * 256 + 1));\n38\t    for len in lens {\n39\t        assert_eq!(len as u8, 1, \"test bug: {len} low byte != 1\");\n40\t        let cv = unsafe { (c.arity)(len, params.as_ptr()) };\n41\t        let rv = unsafe { (r.arity)(len, params.as_ptr()) };\n42\t        eq_i32(\"err-02\", len, cv, rv);\n43\t        assert_eq!(cv, -1, \"C must reject len={len} (low byte 1) with -1\");\n44\t    }\n45\t}\n46\t\n47\t#[test]\n48\tfn err_03_arity_null_params_is_safe() {\n49\t    // The `len < 2` guard runs BEFORE params is touched, so a NULL params with\n50\t    // a rejected len must return -1 rather than fault. Run in a subprocess so\n51\t    // that a *wrong* implementation which derefs first is observed as a crash\n52\t    // instead of taking the whole test binary down.\n53\t    let out_c = run_worker(&c_so_path().to_string_lossy(), \"arity_null_guarded\");\n54\t    let out_r = run_worker(&rust_so_path().to_string_lossy(), \"arity_null_guarded\");\n55\t    assert_eq!(out_c, out_r, \"err-03: C/Rust divergence\\nC: {out_c:?}\\nR: {out_r:?}\");\n56\t    assert!(out_c.0, \"err-03: C must NOT fault on arity(len<2, NULL)\");\n57\t    assert!(\n58\t        out_c.1.lines().all(|l| l.ends_with(\"= -1\")),\n59\t        \"err-03: every guarded arity(len,NULL) must be -1, got:\\n{}\",\n60\t        out_c.1\n61\t    );\n62\t    // And the mirror: a dispatching len with NULL params faults in BOTH.\n63\t    let a_c = run_worker(&c_so_path().to_string_lossy(), \"arity_null_active\");\n64\t    let a_r = run_worker(&rust_so_path().to_string_lossy(), \"arity_null_active\");\n65\t    assert_eq!(a_c, a_r, \"err-03b: C/Rust divergence on arity(4, NULL)\");\n66\t    assert!(!a_c.0, \"err-03b: arity(4, NULL) is expected to fault in C\");\n67\t}\n68\t\n69\t#[test]\n70\tfn err_04_arity_negative_len() {\n71\t    let (c, r) = both();\n72\t    let params = [11i32, 22, 33, 44, 55, 66, 77, 88];\n73\t    let mut lens: Vec<i32> = (-600..=-1).collect();\n74\t    lens.extend_from_slice(&[i32::MIN, i32::MIN + 1, i32::MIN + 255]);\n75\t    for len in lens {\n76\t        let cv = unsafe { (c.arity)(len, params.as_ptr()) };\n77\t        let rv = unsafe { (r.arity)(len, params.as_ptr()) };\n78\t        eq_i32(\"err-04\", len, cv, rv);\n79\t        // ground truth: unsigned byte comparison of the low 8 bits\n80\t        let lo = len as u8;\n81\t        if lo < 2 {\n82\t            assert_eq!(cv, -1, \"len={len} lo={lo} must be -1\");\n83\t        } else {\n84\t            assert_ne!(cv, -1, \"len={len} lo={lo} must dispatch, not reject\");\n85\t        }\n86\t    }\n87\t}\n88\t\n89\t#[test]\n90\tfn err_05_arity_large_len_reads_only_4() {\n91\t    // A len of 5..255 says \"I gave you N params\" but arity4 only ever reads 4.\n92\t    // The buffer is deliberately only 4 elements long, fenced by a canary, to\n93\t    // prove neither implementation reads past params[3].\n94\t    let (c, r) = both();\n95\t    let mut rng = Rng::new(SEED);\n96\t    for len in 4i32..=255 {\n97\t        let p: Vec<c_int> = (0..4).map(|_| rng.spicy_i32()).collect();\n98\t        normalize_heap(true);\n99\t        let cv = unsafe { (c.arity)(len, p.as_ptr()) };\n100\t        normalize_heap(true);\n101\t        let rv = unsafe { (r.arity)(len, p.as_ptr()) };\n102\t        eq_i32(\"err-05\", (len, &p), cv, rv);\n103\t        normalize_heap(true);\n104\t        let direct = unsafe { (c.arity4)(p[0], p[1], p[2], p[3]) };\n105\t        assert_eq!(cv, direct, \"len={len}: must behave exactly like arity4\");\n106\t    }\n107\t}\n108\t\n109\t// ===========================================================================\n110\t// rows 6..8 — compare_allocations\n111\t// ===========================================================================\n112\t\n113\t#[test]\n114\tfn err_06_compare_alloc_oom_unreachable() {\n115\t    // The `ptr1 == NULL || ptr2 == NULL -> return -1` branch cannot be induced\n116\t    // for malloc(4) with a working glibc. Assert the reachable invariant\n117\t    // identically for both: the -1 sentinel is NEVER produced.\n118\t    let (c, r) = both();\n119\t    let mut rng = Rng::new(SEED);\n120\t    for asc in BOTH_ORDERS {\n121\t        for _ in 0..2000 {\n122\t            let (a, b) = (rng.spicy_i32(), rng.spicy_i32());\n123\t            normalize_heap(asc);\n124\t            let cv = unsafe { (c.compare_allocations)(a, b) };\n125\t            normalize_heap(asc);\n126\t            let rv = unsafe { (r.compare_allocations)(a, b) };\n127\t            eq_i32(\"err-06\", (asc, a, b), cv, rv);\n128\t            assert_ne!(cv, -1, \"OOM sentinel unexpectedly reached in C\");\n129\t            assert_ne!(rv, -1, \"OOM sentinel unexpectedly reached in Rust\");\n130\t        }\n131\t    }\n132\t}\n133\t\n134\t#[test]\n135\tfn err_07_compare_alloc_nonpositive_val1() {\n136\t    // `(*uninit_ptr > 0)` is false => add 0, not 10.\n137\t    let (c, r) = both();\n138\t    let mut rng = Rng::new(SEED);\n139\t    for asc in BOTH_ORDERS {\n140\t        // exact boundary: 0 and -1 must NOT get +10; 1 must.\n141\t        for &(v1, want_plus10) in &[(0i32, false), (-1, false), (i32::MIN, false), (1, true)] {\n142\t            normalize_heap(asc);\n143\t            let cv = unsafe { (c.compare_allocations)(v1, 7) };\n144\t            normalize_heap(asc);\n145\t            let rv = unsafe { (r.compare_allocations)(v1, 7) };\n146\t            eq_i32(\"err-07\", (asc, v1), cv, rv);\n147\t            let base = if asc { 1 } else { 2 };\n148\t            assert_eq!(cv, base + if want_plus10 { 10 } else { 0 }, \"v1={v1} asc={asc}\");\n149\t        }\n150\t        for _ in 0..1000 {\n151\t            let v1 = rng.range_i32(i32::MIN, 0);\n152\t            let v2 = rng.spicy_i32();\n153\t            normalize_heap(asc);\n154\t            let cv = unsafe { (c.compare_allocations)(v1, v2) };\n155\t            normalize_heap(asc);\n156\t            let rv = unsafe { (r.compare_allocations)(v1, v2) };\n157\t            eq_i32(\"err-07\", (asc, v1, v2), cv, rv);\n158\t            assert!(cv < 10, \"v1={v1} <= 0 must not take the +10 arm (got {cv})\");\n159\t        }\n160\t    }\n161\t}\n162\t\n163\t#[test]\n164\tfn err_08_compare_alloc_equal_arm() {\n165\t    // `ptr1 == ptr2 -> result = 3` is unreachable (two live mallocs are never\n166\t    // the same address). Assert the reachable invariant for both: result is\n167\t    // always in {1,2,11,12}, never 3 or 13.\n168\t    let (c, r) = both();\n169\t    let mut rng = Rng::new(SEED);\n170\t    for asc in BOTH_ORDERS {\n171\t        for _ in 0..2000 {\n172\t            let (a, b) = (rng.spicy_i32(), rng.spicy_i32());\n173\t            normalize_heap(asc);\n174\t            let cv = unsafe { (c.compare_allocations)(a, b) };\n175\t            normalize_heap(asc);\n176\t            let rv = unsafe { (r.compare_allocations)(a, b) };\n177\t            eq_i32(\"err-08\", (asc, a, b), cv, rv);\n178\t            assert!(matches!(cv, 1 | 2 | 11 | 12), \"C gave {cv}\");\n179\t            assert!(matches!(rv, 1 | 2 | 11 | 12), \"Rust gave {rv}\");\n180\t        }\n181\t    }\n182\t}\n183\t\n184\t// ===========================================================================\n185\t// rows 9..11 — process_string / apply_bitmask\n186\t// ===========================================================================\n187\t\n188\t#[test]\n189\tfn err_09_process_string_empty() {\n190\t    let (c, r) = both();\n191\t    // `if (*str)` false -> return 0 without calling strlen. The buffer holds\n192\t    // trailing garbage after the NUL to prove strlen is really not consulted.\n193\t    let buf = cbuf(&[]);\n194\t    let cv = unsafe { (c.process_string)(buf.as_ptr()) };\n195\t    let rv = unsafe { (r.process_string)(buf.as_ptr()) };\n196\t    eq_i32(\"err-09\", \"empty\", cv, rv);\n197\t    assert_eq!(cv, 0);\n198\t\n199\t    let mut buf2: Vec<std::ffi::c_char> = vec![0];\n200\t    buf2.extend([b'A' as std::ffi::c_char; 16]);\n201\t    buf2.push(0);\n202\t    let cv = unsafe { (c.process_string)(buf2.as_ptr()) };\n203\t    let rv = unsafe { (r.process_string)(buf2.as_ptr()) };\n204\t    eq_i32(\"err-09\", \"NUL then garbage\", cv, rv);\n205\t    assert_eq!(cv, 0, \"leading NUL must short-circuit to 0\");\n206\t}\n207\t\n208\t#[test]\n209\tfn err_10_process_string_null_segv() {\n210\t    // No NULL check in C: `*str` is dereferenced unconditionally. Both\n211\t    // libraries must fault the SAME way.\n212\t    let a = run_worker(&c_so_path().to_string_lossy(), \"process_string_null\");\n213\t    let b = run_worker(&rust_so_path().to_string_lossy(), \"process_string_null\");\n214\t    assert_eq!(a, b, \"err-10: C/Rust divergence\\nC: {a:?}\\nRust: {b:?}\");\n215\t    assert!(!a.0, \"err-10: C is expected to fault on process_string(NULL)\");\n216\t}\n217\t\n218\t#[test]\n219\tfn err_11_apply_bitmask_default() {\n220\t    // `default:` returns `value` untouched. Covers out-of-range \"enum\" values\n221\t    // crossing the FFI boundary, which C accepts as any int.\n222\t    let (c, r) = both();\n223\t    let mut rng = Rng::new(SEED);\n224\t    let mut ops: Vec<i32> = (4..=64).collect();\n225\t    ops.extend_from_slice(&[255, 256, 1000, 65536, i32::MAX, i32::MAX - 1]);\n226\t    ops.extend((-64..=-1).collect::<Vec<i32>>());\n227\t    ops.extend_from_slice(&[i32::MIN, i32::MIN + 1]);\n228\t    for &op in &ops {\n229\t        assert!(!(0..=3).contains(&op), \"test bug: {op} is a real case label\");\n230\t        for _ in 0..40 {\n231\t            let v = rng.spicy_i32();\n232\t            let cv = unsafe { (c.apply_bitmask)(v, op) };\n233\t            let rv = unsafe { (r.apply_bitmask)(v, op) };\n234\t            eq_i32(\"err-11\", (v, op), cv, rv);\n235\t            assert_eq!(cv, v, \"default: must return value unchanged (op={op})\");\n236\t        }\n237\t    }\n238\t}\n239\t\n240\t#[test]\n241\tfn err_12_negative_modulo_hits_default() {\n242\t    // C's `%` truncates toward zero, so for param1 < 0 the operation passed to\n243\t    // apply_bitmask is negative and lands on `default:` (identity). This is the\n244\t    // canonical \"translation used rem_euclid and silently changed behaviour\"\n245\t    // bug, so assert the operation values directly AND end to end.\n246\t    let (c, r) = both();\n247\t    for op in [-1i32, -2, -3] {\n248\t        for v in [0i32, 1, 255, -1, i32::MAX, i32::MIN] {\n249\t            let cv = unsafe { (c.apply_bitmask)(v, op) };\n250\t            let rv = unsafe { (r.apply_bitmask)(v, op) };\n251\t            eq_i32(\"err-12\", (v, op), cv, rv);\n252\t            assert_eq!(cv, v, \"op={op} must be identity, not case {}\", op + 4);\n253\t        }\n254\t    }\n255\t    // End to end through arity4, for param1 in each negative residue class.\n256\t    let mut rng = Rng::new(SEED);\n257\t    for asc in BOTH_ORDERS {\n258\t        for _ in 0..1500 {\n259\t            let p1 = rng.range_i32(i32::MIN + 4, -1);\n260\t            let p2 = rng.spicy_i32();\n261\t            normalize_heap(asc);\n262\t            let cv = unsafe { (c.arity4)(p1, p2, 0, 0) };\n263\t            normalize_heap(asc);\n264\t            let rv = unsafe { (r.arity4)(p1, p2, 0, 0) };\n265\t            eq_i32(\"err-12/e2e\", (asc, p1, p2), cv, rv);\n266\t        }\n267\t    }\n268\t}\n269\t\n270\t// ===========================================================================\n271\t// rows 13..15, 26 — shift_array guard rejections\n272\t// ===========================================================================\n273\t\n274\t/// Calls shift_array on both and asserts the buffers stay byte-identical to\n275\t/// each other AND (when `expect_noop`) to the original contents.\n276\tfn shift_guard_case(row: &str, c: &Lib, r: &Lib, data: &[c_int], size: c_int, positions: c_int) {\n277\t    let mut cb = data.to_vec();\n278\t    let mut rb = data.to_vec();\n279\t    unsafe {\n280\t        (c.shift_array)(cb.as_mut_ptr(), size, positions);\n281\t        (r.shift_array)(rb.as_mut_ptr(), size, positions);\n282\t    }\n283\t    eq_slice(row, (size, positions), &cb, &rb);\n284\t    assert_eq!(cb, data, \"{row}: size={size} positions={positions} must be a NO-OP\");\n285\t}\n286\t\n287\t#[test]\n288\tfn err_13_shift_positions_nonpositive() {\n289\t    let (c, r) = both();\n290\t    let mut rng = Rng::new(SEED);\n291\t    for _ in 0..500 {\n292\t        let size = rng.range_i32(1, 32);\n293\t        let data: Vec<c_int> = (0..size as usize).map(|_| rng.spicy_i32()).collect();\n294\t        for positions in [0i32, -1, -2, -100, i32::MIN, i32::MIN + 1] {\n295\t            shift_guard_case(\"err-13\", &c, &r, &data, size, positions);\n296\t        }\n297\t    }\n298\t}\n299\t\n300\t#[test]\n301\tfn err_14_shift_positions_ge_size() {\n302\t    let (c, r) = both();\n303\t    let mut rng = Rng::new(SEED);\n304\t    for _ in 0..500 {\n305\t        let size = rng.range_i32(1, 32);\n306\t        let data: Vec<c_int> = (0..size as usize).map(|_| rng.spicy_i32()).collect();\n307\t        // positions == size is the exact boundary; also one past and far past.\n308\t        for positions in [size, size + 1, size + 100, i32::MAX] {\n309\t            shift_guard_case(\"err-14\", &c, &r, &data, size, positions);\n310\t        }\n311\t    }\n312\t}\n313\t\n314\t#[test]\n315\tfn err_15_shift_nonpositive_size() {\n316\t    let (c, r) = both();\n317\t    let mut rng = Rng::new(SEED);\n318\t    for _ in 0..500 {\n319\t        // Buffer is real and 8 long, but `size` is claimed as <= 0.\n320\t        let data: Vec<c_int> = (0..8).map(|_| rng.spicy_i32()).collect();\n321\t        for size in [0i32, -1, -2, -100, i32::MIN] {\n322\t            for positions in [1i32, 2, 0, -1, i32::MAX, i32::MIN] {\n323\t                shift_guard_case(\"err-15\", &c, &r, &data, size, positions);\n324\t            }\n325\t        }\n326\t    }\n327\t}\n328\t\n329\t#[test]\n330\tfn err_26_shift_array_null_guarded_safe() {\n331\t    // arr == NULL but the guard is false: `positions > 0 && positions < size`\n332\t    // short-circuits, so NULL is never dereferenced and both must return\n333\t    // safely. Subprocess so a wrong impl shows up as a crash, not as a\n334\t    // harness abort.\n335\t    let a = run_worker(&c_so_path().to_string_lossy(), \"shift_array_null_guarded\");\n336\t    let b = run_worker(&rust_so_path().to_string_lossy(), \"shift_array_null_guarded\");\n337\t    assert_eq!(a, b, \"err-26: C/Rust divergence\\nC: {a:?}\\nRust: {b:?}\");\n338\t    assert!(a.0, \"err-26: guarded shift_array(NULL, ...) must NOT fault in C\");\n339\t}\n340\t\n341\t#[test]\n342\tfn err_25_shift_array_null_segv() {\n343\t    // arr == NULL with a guard-PASSING (size=4, positions=1): memmove(NULL).\n344\t    let a = run_worker(&c_so_path().to_string_lossy(), \"shift_array_null_active\");\n345\t    let b = run_worker(&rust_so_path().to_string_lossy(), \"shift_array_null_active\");\n346\t    assert_eq!(a, b, \"err-25: C/Rust divergence\\nC: {a:?}\\nRust: {b:?}\");\n347\t    assert!(!a.0, \"err-25: shift_array(NULL,4,1) is expected to fault in C\");\n348\t}\n349\t\n350\t// ===========================================================================\n351\t// rows 17..23 — arity4 arithmetic edges\n352\t// ===========================================================================\n353\t\n354\t#[test]\n355\tfn err_17_arity4_param3_zero() {\n356\t    // param3 == 0 skips `(result * param3) / 100` entirely — in particular it\n357\t    // must NOT zero the result and must NOT divide.\n358\t    let (c, r) = both();\n359\t    let mut rng = Rng::new(SEED);\n360\t    for asc in BOTH_ORDERS {\n361\t        for _ in 0..1500 {\n362\t            let (p1, p2, p4) = (rng.spicy_i32(), rng.spicy_i32(), rng.spicy_i32());\n363\t            normalize_heap(asc);\n364\t            let cv = unsafe { (c.arity4)(p1, p2, 0, p4) };\n365\t            normalize_heap(asc);\n366\t            let rv = unsafe { (r.arity4)(p1, p2, 0, p4) };\n367\t            eq_i32(\"err-17\", (asc, p1, p2, p4), cv, rv);\n368\t        }\n369\t    }\n370\t}\n371\t\n372\t#[test]\n373\tfn err_18_arity4_param4_zero() {\n374\t    let (c, r) = both();\n375\t    let mut rng = Rng::new(SEED);\n376\t    for asc in BOTH_ORDERS {\n377\t        for _ in 0..1500 {\n378\t            let (p1, p2, p3) = (rng.spicy_i32(), rng.spicy_i32(), rng.spicy_i32());\n379\t            normalize_heap(asc);\n380\t            let cv = unsafe { (c.arity4)(p1, p2, p3, 0) };\n381\t            normalize_heap(asc);\n382\t            let rv = unsafe { (r.arity4)(p1, p2, p3, 0) };\n383\t            eq_i32(\"err-18\", (asc, p1, p2, p3), cv, rv);\n384\t        }\n385\t    }\n386\t}\n387\t\n388\t#[test]\n389\tfn err_19_arity4_mul_overflow() {\n390\t    // `result * param3` is signed-overflow UB in C; the emitted code is a\n391\t    // plain `imul`, i.e. 2's-complement wraparound. Rust must wrap, not panic\n392\t    // and not saturate.\n393\t    let (c, r) = both();\n394\t    let extremes = [i32::MAX, i32::MAX - 1, i32::MIN, i32::MIN + 1, 0x4000_0000, -0x4000_0000];\n395\t    for asc in BOTH_ORDERS {\n396\t        for &p1 in &extremes {\n397\t            for &p2 in &extremes {\n398\t                for &p3 in &extremes {\n399\t                    normalize_heap(asc);\n400\t                    let cv = unsafe { (c.arity4)(p1, p2, p3, 0) };\n401\t                    normalize_heap(asc);\n402\t                    let rv = unsafe { (r.arity4)(p1, p2, p3, 0) };\n403\t                    eq_i32(\"err-19\", (asc, p1, p2, p3), cv, rv);\n404\t                }\n405\t            }\n406\t        }\n407\t    }\n408\t}\n409\t\n410\t#[test]\n411\tfn err_20_arity4_add_overflow() {\n412\t    let (c, r) = both();\n413\t    let extremes = [i32::MAX, i32::MAX - 1, i32::MIN, i32::MIN + 1];\n414\t    for asc in BOTH_ORDERS {\n415\t        for &p1 in &extremes {\n416\t            for &p2 in &extremes {\n417\t                for &p3 in &[0i32, 1, -1, i32::MAX, i32::MIN] {\n418\t                    for &p4 in &extremes {\n419\t                        normalize_heap(asc);\n420\t                        let cv = unsafe { (c.arity4)(p1, p2, p3, p4) };\n421\t                        normalize_heap(asc);\n422\t                        let rv = unsafe { (r.arity4)(p1, p2, p3, p4) };\n423\t                        eq_i32(\"err-20\", (asc, p1, p2, p3, p4), cv, rv);\n424\t                    }\n425\t                }\n426\t            }\n427\t        }\n428\t    }\n429\t}\n430\t\n431\t#[test]\n432\tfn err_21_arity4_negative_division() {\n433\t    // C integer division truncates toward ZERO, so -150/100 == -1 (not -2).\n434\t    // Sweep param1/param3 so the dividend lands on both sides of zero and on\n435\t    // exact/inexact multiples of 100.\n436\t    let (c, r) = both();\n437\t    for asc in BOTH_ORDERS {\n438\t        for p1 in -300i32..=300 {\n439\t            for &p3 in &[-1i32, 1, -2, 2, -100, 100, -101, 101, -7, 7] {\n440\t                normalize_heap(asc);\n441\t                let cv = unsafe { (c.arity4)(p1, 5, p3, 0) };\n442\t                normalize_heap(asc);\n443\t                let rv = unsafe { (r.arity4)(p1, 5, p3, 0) };\n444\t                eq_i32(\"err-21\", (asc, p1, p3), cv, rv);\n445\t            }\n446\t        }\n447\t    }\n448\t}\n449\t\n450\t#[test]\n451\tfn err_22_arity4_param1_int_min() {\n452\t    // param1 % 4 with param1 == INT_MIN. (The UB case is `% -1`, not `% 4`,\n453\t    // so this is well-defined and equals 0.) Must not panic in Rust.\n454\t    let (c, r) = both();\n455\t    for asc in BOTH_ORDERS {\n456\t        for &p1 in &[i32::MIN, i32::MIN + 1, i32::MIN + 2, i32::MIN + 3, i32::MIN + 4] {\n457\t            for &p2 in &[0i32, 1, -1, i32::MIN, i32::MAX] {\n458\t                for &p3 in &[0i32, 1, -1] {\n459\t                    for &p4 in &[0i32, 1, -1] {\n460\t                        normalize_heap(asc);\n461\t                        let cv = unsafe { (c.arity4)(p1, p2, p3, p4) };\n462\t                        normalize_heap(asc);\n463\t                        let rv = unsafe { (r.arity4)(p1, p2, p3, p4) };\n464\t                        eq_i32(\"err-22\", (asc, p1, p2, p3, p4), cv, rv);\n465\t                    }\n466\t                }\n467\t            }\n468\t        }\n469\t    }\n470\t    // Also via arity2/arity3/arity so every entry point sees INT_MIN.\n471\t    for asc in BOTH_ORDERS {\n472\t        normalize_heap(asc);\n473\t        let c2 = unsafe { (c.arity2)(i32::MIN, i32::MIN) };\n474\t        normalize_heap(asc);\n475\t        let r2 = unsafe { (r.arity2)(i32::MIN, i32::MIN) };\n476\t        eq_i32(\"err-22/arity2\", asc, c2, r2);\n477\t        let p = [i32::MIN; 4];\n478\t        normalize_heap(asc);\n479\t        let ca = unsafe { (c.arity)(4, p.as_ptr()) };\n480\t        normalize_heap(asc);\n481\t        let ra = unsafe { (r.arity)(4, p.as_ptr()) };\n482\t        eq_i32(\"err-22/arity\", asc, ca, ra);\n483\t    }\n484\t}\n485\t\n486\t#[test]\n487\tfn err_23_arity2_arity3_defaults() {\n488\t    // arity2/arity3 must forward the implicit 0 defaults exactly.\n489\t    let (c, r) = both();\n490\t    let mut rng = Rng::new(SEED);\n491\t    for asc in BOTH_ORDERS {\n492\t        for _ in 0..1000 {\n493\t            let (p1, p2, p3) = (rng.spicy_i32(), rng.spicy_i32(), rng.spicy_i32());\n494\t\n495\t            normalize_heap(asc);\n496\t            let c2 = unsafe { (c.arity2)(p1, p2) };\n497\t            normalize_heap(asc);\n498\t            let r2 = unsafe { (r.arity2)(p1, p2) };\n499\t            eq_i32(\"err-23/arity2\", (asc, p1, p2), c2, r2);\n500\t            normalize_heap(asc);\n501\t            let c2ref = unsafe { (c.arity4)(p1, p2, 0, 0) };\n502\t            normalize_heap(asc);\n503\t            let r2ref = unsafe { (r.arity4)(p1, p2, 0, 0) };\n504\t            assert_eq!(c2, c2ref, \"C: arity2 != arity4(_,_,0,0)\");\n505\t            assert_eq!(r2, r2ref, \"Rust: arity2 != arity4(_,_,0,0)\");\n506\t\n507\t            normalize_heap(asc);\n508\t            let c3 = unsafe { (c.arity3)(p1, p2, p3) };\n509\t            normalize_heap(asc);\n510\t            let r3 = unsafe { (r.arity3)(p1, p2, p3) };\n511\t            eq_i32(\"err-23/arity3\", (asc, p1, p2, p3), c3, r3);\n512\t            normalize_heap(asc);\n513\t            let c3ref = unsafe { (c.arity4)(p1, p2, p3, 0) };\n514\t            normalize_heap(asc);\n515\t            let r3ref = unsafe { (r.arity4)(p1, p2, p3, 0) };\n516\t            assert_eq!(c3, c3ref, \"C: arity3 != arity4(_,_,_,0)\");\n517\t            assert_eq!(r3, r3ref, \"Rust: arity3 != arity4(_,_,_,0)\");\n518\t        }\n519\t    }\n520\t}\n521\t\n522\t#[test]\n523\tfn err_24_init_matrix_null_segv() {\n524\t    let a = run_worker(&c_so_path().to_string_lossy(), \"init_matrix_null\");\n525\t    let b = run_worker(&rust_so_path().to_string_lossy(), \"init_matrix_null\");\n526\t    assert_eq!(a, b, \"err-24: C/Rust divergence\\nC: {a:?}\\nRust: {b:?}\");\n527\t    assert!(!a.0, \"err-24: init_matrix(NULL) is expected to fault in C\");\n528\t}\n529\t\n530\t// ===========================================================================\n531\t// Subprocess helper\n532\t// ===========================================================================\n533\t\n534\t/// Runs `examples/crash_worker <lib> <case>`.\n535\t/// Returns `(exited_cleanly, stdout, signal_or_code)`.\n536\tfn run_worker(lib: &str, case: &str) -> (bool, String, String) {\n537\t    let mut exe = std::env::current_exe().unwrap();\n538\t    exe.pop();\n539\t    exe.pop();\n540\t    let exe = exe.join(\"examples\").join(\"crash_worker\");\n541\t    assert!(\n542\t        exe.exists(),\n543\t        \"{} missing — run `cargo build --release --examples` first\",\n544\t        exe.display()\n545\t    );\n546\t    let out = Command::new(&exe)\n547\t        .arg(lib)\n548\t        .arg(case)\n549\t        .output()\n550\t        .unwrap_or_else(|e| panic!(\"spawn {}: {e}\", exe.display()));\n551\t\n552\t    use std::os::unix::process::ExitStatusExt;\n553\t    let status = if let Some(sig) = out.status.signal() {\n554\t        format!(\"signal {sig}\")\n555\t    } else {\n556\t        format!(\"exit {}\", out.status.code().unwrap_or(-1))\n557\t    };\n558\t    (\n559\t        out.status.success(),\n560\t        String::from_utf8_lossy(&out.stdout).into_owned(),\n561\t        status,\n562\t    )\n563\t}\n564\t"}]},"parent_tool_use_id":"toolu_bdrk_016VEYbRuiyp1