       unsafe { *params.offset(0) },\n>             unsafe { *params.offset(1) },\n>             unsafe { *params.offset(2) },\n>             unsafe { *params.offset(3) },\n>         )\n>     }\n> }","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
