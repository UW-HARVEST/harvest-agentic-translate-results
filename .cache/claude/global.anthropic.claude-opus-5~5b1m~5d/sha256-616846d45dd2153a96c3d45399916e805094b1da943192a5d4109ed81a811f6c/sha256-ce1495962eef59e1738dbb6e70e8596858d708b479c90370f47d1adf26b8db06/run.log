            let e = c2Sub(ap, c2Mulvs(n, da / c2Dot(n, n)));\n   332\t            d2 = c2Dot(e, e);\n   333\t        } else {\n   334\t            let bp = c2Sub(A.p, B.b);\n   335\t            d2 = c2Dot(bp, bp);\n   336\t        }\n   337\t    }\n   338\t    let r = A.r + B.r;\n   339\t    (d2 < r * r) as c_int\n   340\t}\n   341\t\n   342\t/// ```c\n   343\t/// int c2Collided(const void *A, const void *B, C2_TYPE typeB) {\n   344\t///     switch (typeB) {\n   345\t///         case C2_TYPE_CIRCLE:  return c2CircletoCircle(*(c2Circle *)A, *(c2Circle *)B);\n   346\t///         case C2_TYPE_AABB:    return c2CircletoAABB(*(c2Circle *)A, *(c2AABB *)B);\n   347\t///         case C2_TYPE_CAPSULE: return c2CircletoCapsule(*(c2Circle *)A, *(c2Capsule *)B);\n   348\t///         default:              return 0;\n   349\t///     }\n   350\t/// }\n   351\t/// ```\n   352\t///\n   353\t/// `A` is always reinterpreted as a `c2Circle` regardless of `typeB`, exactly\n   354\t/// as in the C original.\n   355\t///\n   356\t/// # Safety\n   357\t///\n   358\t/// `A` must point to a readable `c2Circle` and `B` to a readable object of the\n   359\t/// shape selected by `typeB`, for any `typeB` in `0..=2`.\n   360\t#[unsafe(no_mangle)]\n   361\tpub unsafe extern \"C\" fn c2Collided(A: *const c_void, B: *const c_void, typeB: c_int) -> c_int {\n   362\t    match typeB {\n   363\t        C2_TYPE_CIRCLE => c2CircletoCircle(\n   364\t            unsafe { (A as *const c2Circle).read_unaligned() },\n   365\t            unsafe { (B as *const c2Circle).read_unaligned() },\n   366\t        ),\n   367\t        C2_TYPE_AABB => c2CircletoAABB(\n   368\t            unsafe { (A as *const c2Circle).read_unaligned() },\n   369\t            unsafe { (B as *const c2AABB).read_unaligned() },\n   370\t        ),\n   371\t        C2_TYPE_CAPSULE => c2CircletoCapsule(\n   372\t            unsafe { (A as *const c2Circle).read_unaligned() },\n   373\t            unsafe { (B as *const c2Capsule).read_unaligned(