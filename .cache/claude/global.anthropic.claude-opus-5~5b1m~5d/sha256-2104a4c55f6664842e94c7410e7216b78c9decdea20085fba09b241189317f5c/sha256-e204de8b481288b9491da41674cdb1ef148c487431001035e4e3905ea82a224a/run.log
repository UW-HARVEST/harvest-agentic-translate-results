{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_014vxFH9zJm6jKHnuScx6Z98","type":"tool_result","content":"1\t// main.rs\n2\t//\n3\t// Rust translation of main.c\n4\t\n5\t#[macro_use]\n6\tmod cstdio;\n7\tmod containers;\n8\tmod inventory;\n9\t\n10\tuse std::io::{BufWriter, Write};\n11\t\n12\tuse containers::{Array, List};\n13\tuse cstdio::{fgets, fmt_f, sscanf_int};\n14\tuse inventory::{\n15\t    calculate_inventory_stats, calculate_order_stats, create_item, create_order,\n16\t    find_items_by_category, print_item, print_order, Item, Order,\n17\t};\n18\t\n19\tfn print_menu(out: &mut dyn Write) {\n20\t    p!(out, \"\\n\");\n21\t    p!(out, \"========================================\\n\");\n22\t    p!(out, \"  GENERIC FOR_EACH MACRO DEMO\\n\");\n23\t    p!(out, \"========================================\\n\");\n24\t    p!(out, \"1. Demo: Integer Containers\\n\");\n25\t    p!(out, \"2. Demo: Double Containers\\n\");\n26\t    p!(out, \"3. Demo: Inventory Array\\n\");\n27\t    p!(out, \"4. Demo: Order List\\n\");\n28\t    p!(out, \"5. Demo: Mixed Operations\\n\");\n29\t    p!(out, \"6. Run All Demos\\n\");\n30\t    p!(out, \"7. Exit\\n\");\n31\t    p!(out, \"========================================\\n\");\n32\t    p!(out, \"Choice: \");\n33\t}\n34\t\n35\tfn demo_integer_containers(out: &mut dyn Write) {\n36\t    p!(out, \"\\n\");\n37\t    p!(out, \"========================================\\n\");\n38\t    p!(out, \"  DEMO 1: Integer Containers\\n\");\n39\t    p!(out, \"========================================\\n\");\n40\t\n41\t    // Create integer array\n42\t    let mut int_array: Array<i32> = Array::create(10);\n43\t    p!(out, \"\\n--- Integer Array ---\\n\");\n44\t    p!(out, \"Adding integers: 10, 20, 30, 40, 50\\n\");\n45\t    int_array.push(10);\n46\t    int_array.push(20);\n47\t    int_array.push(30);\n48\t    int_array.push(40);\n49\t    int_array.push(50);\n50\t\n51\t    p!(out, \"Array contents: \");\n52\t    for val in int_array.iter() {\n53\t        p!(out, \"{} \", val);\n54\t    }\n55\t    p!(out, \"\\n\");\n56\t\n57\t    // Calculate sum\n58\t    let mut sum: i32 = 0;\n59\t    for val in int_array.iter() {\n60\t        sum = sum.wrapping_add(*val);\n61\t    }\n62\t    p!(out, \"Sum: {}\\n\", sum);\n63\t    p!(\n64\t        out,\n65\t        \"Average: {}\\n\",\n66\t        fmt_f(f64::from(sum) / int_array.size() as f64, 2)\n67\t    );\n68\t\n69\t    // Create integer list\n70\t    let mut int_list: List<i32> = List::create();\n71\t    p!(out, \"\\n--- Integer List ---\\n\");\n72\t    p!(out, \"Adding integers: 100, 200, 300, 400, 500\\n\");\n73\t    int_list.append(100);\n74\t    int_list.append(200);\n75\t    int_list.append(300);\n76\t    int_list.append(400);\n77\t    int_list.append(500);\n78\t\n79\t    p!(out, \"List contents: \");\n80\t    for val in int_list.iter() {\n81\t        p!(out, \"{} \", val);\n82\t    }\n83\t    p!(out, \"\\n\");\n84\t\n85\t    // Calculate product\n86\t    let mut product: i64 = 1;\n87\t    for val in int_list.iter() {\n88\t        product = product.wrapping_mul(i64::from(*val));\n89\t    }\n90\t    p!(out, \"Product: {}\\n\", product);\n91\t}\n92\t\n93\tfn demo_double_containers(out: &mut dyn Write) {\n94\t    p!(out, \"\\n\");\n95\t    p!(out, \"========================================\\n\");\n96\t    p!(out, \"  DEMO 2: Double Containers\\n\");\n97\t    p!(out, \"========================================\\n\");\n98\t\n99\t    // Create double array\n100\t    let mut double_array: Array<f64> = Array::create(5);\n101\t    p!(out, \"\\n--- Double Array (Temperatures in Celsius) ---\\n\");\n102\t\n103\t    let temps: [f64; 7] = [23.5, 25.0, 22.8, 26.3, 24.1, 21.9, 27.5];\n104\t\n105\t    p!(out, \"Adding temperatures: \");\n106\t    for &t in temps.iter() {\n107\t        double_array.push(t);\n108\t        p!(out, \"{} \", fmt_f(t, 1));\n109\t    }\n110\t    p!(out, \"\\n\");\n111\t\n112\t    // Find min, max, average\n113\t    let mut min_temp: f64 = temps[0];\n114\t    let mut max_temp: f64 = temps[0];\n115\t    let mut sum_temp: f64 = 0.0;\n116\t\n117\t    for temp in double_array.iter() {\n118\t        if *temp < min_temp {\n119\t            min_temp = *temp;\n120\t        }\n121\t        if *temp > max_temp {\n122\t            max_temp = *temp;\n123\t        }\n124\t        sum_temp += *temp;\n125\t    }\n126\t\n127\t    p!(out, \"Minimum: {}\\u{00b0}C\\n\", fmt_f(min_temp, 1));\n128\t    p!(out, \"Maximum: {}\\u{00b0}C\\n\", fmt_f(max_temp, 1));\n129\t    p!(\n130\t        out,\n131\t        \"Average: {}\\u{00b0}C\\n\",\n132\t        fmt_f(sum_temp / double_array.size() as f64, 1)\n133\t    );\n134\t\n135\t    // Create double list\n136\t    let mut price_list: List<f64> = List::create();\n137\t    p!(out, \"\\n--- Double List (Product Prices) ---\\n\");\n138\t\n139\t    let prices: [f64; 6] = [9.99, 14.50, 7.25, 22.00, 5.99, 18.75];\n140\t\n141\t    p!(out, \"Adding prices: \");\n142\t    for &pr in prices.iter() {\n143\t        price_list.append(pr);\n144\t        p!(out, \"${} \", fmt_f(pr, 2));\n145\t    }\n146\t    p!(out, \"\\n\");\n147\t\n148\t    // Calculate total and count items under $10\n149\t    let mut total: f64 = 0.0;\n150\t    let mut count_under_10: i32 = 0;\n151\t\n152\t    for temp in price_list.iter() {\n153\t        total += *temp;\n154\t        if *temp < 10.0 {\n155\t            count_under_10 += 1;\n156\t        }\n157\t    }\n158\t\n159\t    p!(out, \"Total cost: ${}\\n\", fmt_f(total, 2));\n160\t    p!(out, \"Items under $10: {}\\n\", count_under_10);\n161\t}\n162\t\n163\tfn demo_inventory_array(out: &mut dyn Write) {\n164\t    p!(out, \"\\n\");\n165\t    p!(out, \"========================================\\n\");\n166\t    p!(out, \"  DEMO 3: Inventory Array (Items)\\n\");\n167\t    p!(out, \"========================================\\n\");\n168\t\n169\t    // Create inventory array\n170\t    let mut inventory: Array<Item> = Array::create(20);\n171\t\n172\t    // Add items\n173\t    p!(out, \"\\n--- Adding Items to Inventory ---\\n\");\n174\t    inventory.push(create_item(1, b\"Laptop\", b\"Electronics\", 899.99, 15));\n175\t    inventory.push(create_item(2, b\"Mouse\", b\"Electronics\", 24.99, 50));\n176\t    inventory.push(create_item(3, b\"Keyboard\", b\"Electronics\", 79.99, 30));\n177\t    inventory.push(create_item(4, b\"Monitor\", b\"Electronics\", 299.99, 20));\n178\t    inventory.push(create_item(5, b\"Desk Chair\", b\"Furniture\", 199.99, 10));\n179\t    inventory.push(create_item(6, b\"Desk\", b\"Furniture\", 349.99, 8));\n180\t    inventory.push(create_item(7, b\"Notebook\", b\"Office\", 4.99, 100));\n181\t    inventory.push(create_item(8, b\"Pen Set\", b\"Office\", 12.99, 75));\n182\t    inventory.push(create_item(9, b\"USB Cable\", b\"Electronics\", 9.99, 60));\n183\t    inventory.push(create_item(10, b\"Bookshelf\", b\"Furniture\", 149.99, 12));\n184\t\n185\t    p!(out, \"Added {} items to inventory\\n\", inventory.size());\n186\t\n187\t    // Display all items\n188\t    p!(out, \"\\n--- All Inventory Items ---\\n\");\n189\t    for item in inventory.iter() {\n190\t        print_item(out, item);\n191\t        p!(out, \"\\n\");\n192\t    }\n193\t\n194\t    // Calculate statistics\n195\t    calculate_inventory_stats(out, &inventory);\n196\t\n197\t    // Find items by category\n198\t    find_items_by_category(out, &inventory, b\"Electronics\");\n199\t    find_items_by_category(out, &inventory, b\"Furniture\");\n200\t\n201\t    // Find low stock items\n202\t    p!(out, \"\\n--- Low Stock Items (< 20) ---\\n\");\n203\t    let mut low_stock_count: i32 = 0;\n204\t    for item in inventory.iter() {\n205\t        if item.quantity < 20 {\n206\t            print_item(out, item);\n207\t            low_stock_count += 1;\n208\t        }\n209\t    }\n210\t    p!(out, \"Total low stock items: {}\\n\", low_stock_count);\n211\t}\n212\t\n213\tfn demo_order_list(out: &mut dyn Write) {\n214\t    p!(out, \"\\n\");\n215\t    p!(out, \"========================================\\n\");\n216\t    p!(out, \"  DEMO 4: Order List (Orders)\\n\");\n217\t    p!(out, \"========================================\\n\");\n218\t\n219\t    // Create order list\n220\t    let mut orders: List<Order> = List::create();\n221\t\n222\t    // Add orders\n223\t    p!(out, \"\\n--- Adding Orders ---\\n\");\n224\t    orders.append(create_order(1001, b\"Alice Johnson\", 1249.95));\n225\t    orders.append(create_order(1002, b\"Bob Smith\", 89.99));\n226\t    orders.append(create_order(1003, b\"Carol White\", 549.98));\n227\t    orders.append(create_order(1004, b\"David Brown\", 24.99));\n228\t    orders.append(create_order(1005, b\"Eve Davis\", 899.99));\n229\t    orders.append(create_order(1006, b\"Frank Miller\", 374.97));\n230\t    orders.append(create_order(1007, b\"Grace Lee\", 159.98));\n231\t    orders.append(create_order(1008, b\"Henry Wilson\", 1099.99));\n232\t\n233\t    p!(out, \"Added {} orders\\n\", orders.size());\n234\t\n235\t    // Display all orders\n236\t    p!(out, \"\\n--- All Orders ---\\n\");\n237\t    for order in orders.iter() {\n238\t        print_order(out, order);\n239\t    }\n240\t\n241\t    // Calculate statistics\n242\t    calculate_order_stats(out, &orders);\n243\t\n244\t    // Find large orders\n245\t    p!(out, \"\\n--- Large Orders (> $500) ---\\n\");\n246\t    let mut large_order_count: i32 = 0;\n247\t    let mut large_order_total: f64 = 0.0;\n248\t\n249\t    for order in orders.iter() {\n250\t        if order.total_amount > 500.0 {\n251\t            print_order(out, order);\n252\t            large_order_count += 1;\n253\t            large_order_total += order.total_amount;\n254\t        }\n255\t    }\n256\t\n257\t    p!(out, \"Total large orders: {}\\n\", large_order_count);\n258\t    p!(\n259\t        out,\n260\t        \"Revenue from large orders: ${}\\n\",\n261\t        fmt_f(large_order_total, 2)\n262\t    );\n263\t}\n264\t\n265\tfn demo_mixed_operations(out: &mut dyn Write) {\n266\t    p!(out, \"\\n\");\n267\t    p!(out, \"========================================\\n\");\n268\t    p!(out, \"  DEMO 5: Mixed Operations\\n\");\n269\t    p!(out, \"========================================\\n\");\n270\t\n271\t    // Create both array and list with items\n272\t    let mut array_inventory: Array<Item> = Array::create(10);\n273\t    let mut list_inventory: List<Item> = List::create();\n274\t\n275\t    p!(out, \"\\n--- Populating both Array and List ---\\n\");\n276\t\n277\t    // Add same items to both\n278\t    let items: [Item; 5] = [\n279\t        create_item(1, b\"Smartphone\", b\"Electronics\", 699.99, 25),\n280\t        create_item(2, b\"Tablet\", b\"Electronics\", 449.99, 18),\n281\t        create_item(3, b\"Headphones\", b\"Electronics\", 149.99, 40),\n282\t        create_item(4, b\"Smart Watch\", b\"Electronics\", 299.99, 22),\n283\t        create_item(5, b\"Power Bank\", b\"Electronics\", 39.99, 55),\n284\t    ];\n285\t\n286\t    let num_items: i32 = items.len() as i32;\n287\t\n288\t    for item in items.iter() {\n289\t        array_inventory.push(*item);\n290\t        list_inventory.append(*item);\n291\t    }\n292\t\n293\t    p!(out, \"Added {} items to both containers\\n\", num_items);\n294\t\n295\t    // Compare iteration performance (conceptually)\n296\t    p!(out, \"\\n--- Iterating through Array ---\\n\");\n297\t    let mut array_count: i32 = 0;\n298\t    for _item in array_inventory.iter() {\n299\t        array_count += 1;\n300\t    }\n301\t    p!(out, \"Array iteration count: {}\\n\", array_count);\n302\t\n303\t    p!(out, \"\\n--- Iterating through List ---\\n\");\n304\t    let mut list_count: i32 = 0;\n305\t    for _item in list_inventory.iter() {\n306\t        list_count += 1;\n307\t    }\n308\t    p!(out, \"List iteration count: {}\\n\", list_count);\n309\t\n310\t    // Find items above certain price in both\n311\t    let price_threshold: f64 = 200.0;\n312\t\n313\t    p!(\n314\t        out,\n315\t        \"\\n--- Items above ${} (Array) ---\\n\",\n316\t        fmt_f(price_threshold, 2)\n317\t    );\n318\t    for item in array_inventory.iter() {\n319\t        if item.price >= price_threshold {\n320\t            p!(out, \"  \");\n321\t            let _ = out.write_all(cstdio::cstr(&item.name));\n322\t            p!(out, \": ${}\\n\", fmt_f(item.price, 2));\n323\t        }\n324\t    }\n325\t\n326\t    p!(\n327\t        out,\n328\t        \"\\n--- Items above ${} (List) ---\\n\",\n329\t        fmt_f(price_threshold, 2)\n330\t    );\n331\t    for item in list_inventory.iter() {\n332\t        if item.price >= price_threshold {\n333\t            p!(out, \"  \");\n334\t            let _ = out.write_all(cstdio::cstr(&item.name));\n335\t            p!(out, \": ${}\\n\", fmt_f(item.price, 2));\n336\t        }\n337\t    }\n338\t}\n339\t\n340\tfn run(out: &mut dyn Write, stdin: &mut dyn std::io::BufRead) -> i32 {\n341\t    p!(out, \"\\u{2554}{}\\u{2557}\\n\", \"\\u{2550}\".repeat(40));\n342\t    p!(out, \"\\u{2551}   GENERIC FOR_EACH MACRO DEMO         \\u{2551}\\n\");\n343\t    p!(out, \"\\u{2551}   Demonstrating Generic Containers    \\u{2551}\\n\");\n344\t    p!(out, \"\\u{255a}{}\\u{255d}\\n\", \"\\u{2550}\".repeat(40));\n345\t\n346\t    loop {\n347\t        print_menu(out);\n348\t\n349\t        // Keep the prompt visible before blocking on input, as glibc does when\n350\t        // stdout is line buffered.\n351\t        let _ = out.flush();\n352\t\n353\t        let input = match fgets(stdin, 256) {\n354\t            Some(buf) => buf,\n355\t            None => break,\n356\t        };\n357\t\n358\t        let choice = match sscanf_int(&input) {\n359\t            Some(c) => c,\n360\t            None => {\n361\t                p!(out, \"Invalid input\\n\");\n362\t                continue;\n363\t            }\n364\t        };\n365\t\n366\t        match choice {\n367\t            1 => demo_integer_containers(out),\n368\t\n369\t            2 => demo_double_containers(out),\n370\t\n371\t            3 => demo_inventory_array(out),\n372\t\n373\t            4 => demo_order_list(out),\n374\t\n375\t            5 => demo_mixed_operations(out),\n376\t\n377\t            6 => {\n378\t                p!(out, \"\\n=== Running All Demos ===\\n\");\n379\t                demo_integer_containers(out);\n380\t                demo_double_containers(out);\n381\t                demo_inventory_array(out);\n382\t                demo_order_list(out);\n383\t                demo_mixed_operations(out);\n384\t                p!(out, \"\\n========================================\\n\");\n385\t                p!(out, \"  All demos completed successfully!\\n\");\n386\t                p!(out, \"========================================\\n\");\n387\t            }\n388\t\n389\t            7 => {\n390\t                p!(out, \"\\nGoodbye!\\n\");\n391\t                return 0;\n392\t            }\n393\t\n394\t            _ => {\n395\t                p!(out, \"Invalid choice\\n\");\n396\t            }\n397\t        }\n398\t    }\n399\t\n400\t    0\n401\t}\n402\t\n403\tfn main() {\n404\t    let stdin = std::io::stdin();\n405\t    let mut reader = stdin.lock();\n406\t    let stdout = std::io::stdout();\n407\t    let mut writer = BufWriter::new(stdout.lock());\n408\t\n409\t    let code = run(&mut writer, &mut reader);\n410\t\n411\t    let _ = writer.flush();\n412\t    std::process::exit(code);\n413\t}\n414\t"}]},"parent_tool_use_id":null,"session_id":"0a3d7b95-e4e3-4db5-b2bb-1298e0d0e457","uuid":"4b389484-6516-4af6-a9a8-ceb10bc11e2b","timestamp":"2026-08-28T01:15:56.901Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-eF4XiF/translation/src/main.rs","content":"// main.rs\n//\n// Rust translation of main.c\n\n#[macro_use]\nmod cstdio;\nmod containers;\nmod inventory;\n\nuse std::io::{BufWriter, Write};\n\nuse containers::{Array, List};\nuse cstdio::{fgets, fmt_f, sscanf_int};\nuse inventory::{\n    calculate_inventory_stats, calculate_order_stats, create_item, create_order,\n    find_items_by_category, print_item, print_order, Item, Order,\n};\n\nfn print_menu(out: &mut dyn Write) {\n    p!(out, \"\\n\");\n    p!(out, \"========================================\\n\");\n    p!(out, \"  GENERIC FOR_EACH MACRO DEMO\\n\");\n    p!(out, \"========================================\\n\");\n    p!(out, \"1. Demo: Integer Containers\\n\");\n    p!(out, \"2. Demo: Double Containers\\n\");\n    p!(out, \"3. Demo: Inventory Array\\n\");\n    p!(out, \"4. Demo: Order List\\n\");\n    p!(out, \"5. Demo: Mixed Operations\\n\");\n    p!(out, \"6. Run All Demos\\n\");\n    p!(out, \"7. Exit\\n\");\n    p!(out, \"========================================\\n\");\n    p!(out, \"Choice: \");\n}\n\nfn demo_integer_containers(out: &mut dyn Write) {\n    p!(out, \"\\n\");\n    p!(out, \"========================================\\n\");\n    p!(out, \"  DEMO 1: Integer Containers\\n\");\n    p!(out, \"========================================\\n\");\n\n    // Create integer array\n    let mut int_array: Array<i32> = Array::create(10);\n    p!(out, \"\\n--- Integer Array ---\\n\");\n    p!(out, \"Adding integers: 10, 20, 30, 40, 50\\n\");\n    int_array.push(10);\n    int_array.push(20);\n    int_array.push(30);\n    int_array.push(40);\n    int_array.push(50);\n\n    p!(out, \"Array contents: \");\n    for val in int_array.iter() {\n        p!(out, \"{} \", val);\n    }\n    p!(out, \"\\n\");\n\n    // Calculate sum\n    let mut sum: i32 = 0;\n    for val in int_array.iter() {\n        sum = sum.wrapping_add(*val);\n    }\n    p!(out, \"Sum: {}\\n\", sum);\n    p!(\n        out,\n        \"Average: {}\\n\",\n        fmt_f(f64::from(sum) / int_array.size() as f64, 2)\n    );\n\n    // Create integer list\n    let mut int_list: List<i32> = List::create();\n    p!(out, \"\\n--- Integer List ---\\n\");\n    p!(out, \"Adding integers: 100, 200, 300, 400, 500\\n\");\n    int_list.append(100);\n    int_list.append(200);\n    int_list.append(300);\n    int_list.append(400);\n    int_list.append(500);\n\n    p!(out, \"List contents: \");\n    for val in int_list.iter() {\n        p!(out, \"{} \", val);\n    }\n    p!(out, \"\\n\");\n\n    // Calculate product\n    let mut product: i64 = 1;\n    for val in int_list.iter() {\n        product = product.wrapping_mul(i64::from(*val));\n    }\n    p!(out, \"Product: {}\\n\", product);\n}\n\nfn demo_double_containers(out: &mut dyn Write) {\n    p!(out, \"\\n\");\n    p!(out, \"========================================\\n\");\n    p!(out, \"  DEMO 2: Double Containers\\n\");\n    p!(out, \"========================================\\n\");\n\n    // Create double array\n    let mut double_array: Array<f64> = Array::create(5);\n    p!(out, \"\\n--- Double Array (Temperatures in Celsius) ---\\n\");\n\n    let temps: [f64; 7] = [23.5, 25.0, 22.8, 26.3, 24.1, 21.9, 27.5];\n\n    p!(out, \"Adding temperatures: \");\n    for &t in temps.iter() {\n        double_array.push(t);\n        p!(out, \"{} \", fmt_f(t, 1));\n    }\n    p!(out, \"\\n\");\n\n    // Find min, max, average\n    let mut min_temp: f64 = temps[0];\n    let mut max_temp: f64 = temps[0];\n    let mut sum_temp: f64 = 0.0;\n\n    for temp in double_array.iter() {\n        if *temp < min_temp {\n            min_temp = *temp;\n        }\n        if *temp > max_temp {\n            max_temp = *temp;\n        }\n        sum_temp += *temp;\n    }\n\n    p!(out, \"Minimum: {}\\u{00b0}C\\n\", fmt_f(min_temp, 1));\n    p!(out, \"Maximum: {}\\u{00b0}C\\n\", fmt_f(max_temp, 1));\n    p!(\n        out,\n        \"Average: {}\\u{00b0}C\\n\",\n        fmt_f(sum_temp / double_array.size() as f64, 1)\n    );\n\n    // Create double list\n    let mut price_list: List<f64> = List::create();\n    p!(out, \"\\n--- Double List (Product Prices) ---\\n\");\n\n    let prices: [f64; 6] = [9.99, 14.50, 7.25, 22.00, 5.99, 18.75];\n\n    p!(out, \"Adding prices: \");\n    for &pr in prices.iter() {\n        price_list.append(pr);\n        p!(out, \"${} \", fmt_f(pr, 2));\n    }\n    p!(out, \"\\n\");\n\n    // Calculate total and count items under $10\n    let mut total: f64 = 0.0;\n    let mut count_under_10: i32 = 0;\n\n    for temp in price_list.iter() {\n        total += *temp;\n        if *temp < 10.0 {\n            count_under_10 += 1;\n        }\n    }\n\n    p!(out, \"Total cost: ${}\\n\", fmt_f(total, 2));\n    p!(out, \"Items under $10: {}\\n\", count_under_10);\n}\n\nfn demo_inventory_array(out: &mut dyn Write) {\n    p!(out, \"\\n\");\n    p!(out, \"========================================\\n\");\n    p!(out, \"  DEMO 3: Inventory Array (Items)\\n\");\n    p!(out, \"========================================\\n\");\n\n    // Create inventory array\n    let mut inventory: Array<Item> = Array::create(20);\n\n    // Add items\n    p!(out, \"\\n--- Adding Items to Inventory ---\\n\");\n    inventory.push(create_item(1, b\"Laptop\", b\"Electronics\", 899.99, 15));\n    inventory.push(create_item(2, b\"Mouse\", b\"Electronics\", 24.99, 50));\n    inventory.push(create_item(3, b\"Keyboard\", b\"Electronics\", 79.99, 30));\n    inventory.push(create_item(4, b\"Monitor\", b\"Electronics\", 299.99, 20));\n    inventory.push(create_item(5, b\"Desk Chair\", b\"Furniture\", 199.99, 10));\n    inventory.push(create_item(6, b\"Desk\", b\"Furniture\", 349.99, 8));\n    inventory.push(create_item(7, b\"Notebook\", b\"Office\", 4.99, 100));\n    inventory.push(create_item(8, b\"Pen Set\", b\"Office\", 12.99, 75));\n    inventory.push(create_item(9, b\"USB Cable\", b\"Electronics\", 9.99, 60));\n    inventory.push(create_item(10, b\"Bookshelf\", b\"Furniture\", 149.99, 12));\n\n    p!(out, \"Added {} items to inventory\\n\", inventory.size());\n\n    // Display all items\n    p!(out, \"\\n--- All Inventory Items ---\\n\");\n    for item in inventory.iter() {\n        print_item(out, item);\n        p!(out, \"\\n\");\n    }\n\n    // Calculate statistics\n    calculate_inventory_stats(out, &inventory);\n\n    // Find items by category\n    find_items_by_category(out, &inventory, b\"Electronics\");\n    find_items_by_category(out, &inventory, b\"Furniture\");\n\n    // Find low stock items\n    p!(out, \"\\n--- Low Stock Items (< 20) ---\\n\");\n    let mut low_stock_count: i32 = 0;\n    for item in inventory.iter() {\n        if item.quantity < 20 {\n            print_item(out, item);\n            low_stock_count += 1;\n        }\n    }\n    p!(out, \"Total low stock items: {}\\n\", low_stock_count);\n}\n\nfn demo_order_list(out: &mut dyn Write) {\n    p!(out, \"\\n\");\n    p!(out, \"========================================\\n\");\n    p!(out, \"  DEMO 4: Order List (Orders)\\n\");\n    p!(out, \"========================================\\n\");\n\n    // Create order list\n    let mut orders: List<Order> = List::create();\n\n    // Add orders\n    p!(out, \"\\n--- Adding Orders ---\\n\");\n    orders.append(create_order(1001, b\"Alice Johnson\", 1249.95));\n    orders.append(create_order(1002, b\"Bob Smith\", 89.99));\n    orders.append(create_order(1003, b\"Carol White\", 549.98));\n    orders.append(create_order(1004, b\"David Brown\", 24.99));\n    orders.append(create_order(1005, b\"Eve Davis\", 899.99));\n    orders.append(create_order(1006, b\"Frank Miller\", 374.97));\n    orders.append(create_order(1007, b\"Grace Lee\", 159.98));\n    orders.append(create_order(1008, b\"Henry Wilson\", 1099.99));\n\n    p!(out, \"Added {} orders\\n\", orders.size());\n\n    // Display all orders\n    p!(out, \"\\n--- All Orders ---\\n\");\n    for order in orders.iter() {\n        print_order(out, order);\n    }\n\n    // Calculate statistics\n    calculate_order_stats(out, &orders);\n\n    // Find large orders\n    p!(out, \"\\n--- Large Orders (> $500) ---\\n\");\n    let mut large_order_count: i32 = 0;\n    let mut large_order_total: f64 = 0.0;\n\n    for order in orders.iter() {\n        if order.total_amount > 500.0 {\n            print_order(out, order);\n            large_order_count += 1;\n            large_order_total += order.total_amount;\n        }\n    }\n\n    p!(out, \"Total large orders: {}\\n\", large_order_count);\n    p!(\n        out,\n        \"Revenue from large orders: ${}\\n\",\n        fmt_f(large_order_total, 2)\n    );\n}\n\nfn demo_mixed_operations(out: &mut dyn Write) {\n    p!(out, \"\\n\");\n    p!(out, \"========================================\\n\");\n    p!(out, \"  DEMO 5: Mixed Operations\\n\");\n    p!(out, \"========================================\\n\");\n\n    // Create both array and list with items\n    let mut array_inventory: Array<Item> = Array::create(10);\n    let mut list_inventory: List<Item> = List::create();\n\n    p!(out, \"\\n--- Populating both Array and List ---\\n\");\n\n    // Add same items to both\n    let items: [Item; 5] = [\n        create_item(1, b\"Smartphone\", b\"Electronics\", 699.99, 25),\n        create_item(2, b\"Tablet\", b\"Electronics\", 449.99, 18),\n        create_item(3, b\"Headphones\", b\"Electronics\", 149.99, 40),\n        create_item(4, b\"Smart Watch\", b\"Electronics\", 299.99, 22),\n        create_item(5, b\"Power Bank\", b\"Electronics\", 39.99, 55),\n    ];\n\n    let num_items: i32 = items.len() as i32;\n\n    for item in items.iter() {\n        array_inventory.push(*item);\n        list_inventory.append(*item);\n    }\n\n    p!(out, \"Added {} items to both containers\\n\", num_items);\n\n    // Compare iteration performance (conceptually)\n    p!(out, \"\\n--- Iterating through Array ---\\n\");\n    let mut array_count: i32 = 0;\n    for _item in array_inventory.iter() {\n        array_count += 1;\n    }\n    p!(out, \"Array iteration count: {}\\n\", array_count);\n\n    p!(out, \"\\n--- Iterating through List ---\\n\");\n    let mut list_count: i32 = 0;\n    for _item in list_inventory.iter() {\n        list_count += 1;\n    }\n    p!(out, \"List iteration count: {}\\n\", list_count);\n\n    // Find items above certain price in both\n    let price_threshold: f64 = 200.0;\n\n    p!(\n        out,\n        \"\\n--- Items above ${} (Array) ---\\n\",\n        fmt_f(price_threshold, 2)\n    );\n    for item in array_inventory.iter() {\n        if item.price >= price_threshold {\n            p!(out, \"  \");\n            let _ = out.write_all(cstdio::cstr(&item.name));\n            p!(out, \": ${}\\n\", fmt_f(item.price, 2));\n        }\n    }\n\n    p!(\n        out,\n        \"\\n--- Items above ${} (List) ---\\n\",\n        fmt_f(price_threshold, 2)\n    );\n    for item in list_inventory.iter() {\n        if item.price >= price_threshold {\n            p!(out, \"  \");\n            let _ = out.write_all(cstdio::cstr(&item.name));\n            p!(out, \": ${}\\n\", fmt_f(item.price, 2));\n        }\n    }\n}\n\nfn run(out: &mut dyn Write, stdin: &mut dyn std::io::BufRead) -> i32 {\n    p!(out, \"\\u{2554}{}\\u{2557}\\n\", \"\\u{2550}\".repeat(40));\n    p!(out, \"\\u{2551}   GENERIC FOR_EACH MACRO DEMO         \\u{2551}\\n\");\n    p!(out, \"\\u{2551}   Demonstrating Generic Containers    \\u{2551}\\n\");\n    p!(out, \"\\u{255a}{}\\u{255d}\\n\", \"\\u{2550}\".repeat(40));\n\n    loop {\n        print_menu(out);\n\n        // Keep the prompt visible before blocking on input, as glibc does when\n        // stdout is line buffered.\n        let _ = out.flush();\n\n        let input = match fgets(stdin, 256) {\n            Some(buf) => buf,\n            None => break,\n        };\n\n        let choice = match sscanf_int(&input) {\n            Some(c) => c,\n            None => {\n                p!(out, \"Invalid input\\n\");\n                continue;\n            }\n        };\n\n        match choice {\n            1 => demo_integer_containers(out),\n\n            2 => demo_double_containers(out),\n\n            3 => demo_inventory_array(out),\n\n            4 => demo_order_list(out),\n\n            5 => demo_mixed_operations(out),\n\n            6 => {\n                p!(out, \"\\n=== Running All Demos ===\\n\");\n                demo_integer_containers(out);\n                demo_double_containers(out);\n                demo_inventory_array(out);\n                demo_order_list(out);\n                demo_mixed_operations(out);\n                p!(out, \"\\n========================================\\n\");\n                p!(out, \"  All demos completed successfully!\\n\");\n                p!(out, \"========================================\\n\");\n            }\n\n            7 => {\n                p!(out, \"\\nGoodbye!\\n\");\n                return 0;\n            }\n\n            _ => {\n                p!(out, \"Invalid choice\\n\");\n            }\n        }\n    }\n\n    0\n}\n\nfn main() {\n    let stdin = std::io::stdin();\n    let mut reader = stdin.lock();\n    let stdout = std::io::stdout();\n    let mut writer = BufWriter::new(stdout.lock());\n\n    let code = run(&mut writer, &mut reader);\n\n    let _ = writer.flush();\n    std::process::exit(code);\n}\n","numLines":414,"startLine":1,"totalLines":414}}}
