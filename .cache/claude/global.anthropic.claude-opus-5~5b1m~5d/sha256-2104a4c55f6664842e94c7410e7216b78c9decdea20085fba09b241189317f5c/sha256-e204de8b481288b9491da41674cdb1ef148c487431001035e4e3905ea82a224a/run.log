{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01LMsJxQjYv3KAeCuPnR8tvo","type":"tool_result","content":"1\t// cstdio.rs\n2\t//\n3\t// Small helpers that reproduce the exact behaviour of the C standard library\n4\t// functions used by the original program: printf-style float formatting,\n5\t// fgets() line reading and sscanf(buf, \"%d\", &x).\n6\t\n7\tuse std::io::BufRead;\n8\t\n9\t/// Write formatted text to the output stream, ignoring I/O errors the way\n10\t/// printf() does (the C program never checks printf's return value).\n11\tmacro_rules! p {\n12\t    ($out:expr, $($arg:tt)*) => {{\n13\t        let _ = ::std::io::Write::write_fmt($out, format_args!($($arg)*));\n14\t    }};\n15\t}\n16\t\n17\t/// Write raw bytes (used for `%s` of a fixed-size C char buffer).\n18\tmacro_rules! pb {\n19\t    ($out:expr, $bytes:expr) => {{\n20\t        let _ = ::std::io::Write::write_all($out, $bytes);\n21\t    }};\n22\t}\n23\t\n24\t/// The bytes of a NUL-terminated C string held in a fixed-size buffer.\n25\tpub fn cstr(buf: &[u8]) -> &[u8] {\n26\t    match buf.iter().position(|&b| b == 0) {\n27\t        Some(end) => &buf[..end],\n28\t        None => buf,\n29\t    }\n30\t}\n31\t\n32\t/// strncpy(dst, src, dst.len() - 1) followed by dst[dst.len() - 1] = '\\0',\n33\t/// i.e. exactly what create_item()/create_order() do.\n34\tpub fn strncpy_truncate(dst: &mut [u8], src: &[u8]) {\n35\t    for b in dst.iter_mut() {\n36\t        *b = 0;\n37\t    }\n38\t    let limit = dst.len() - 1;\n39\t    for (i, &b) in src.iter().take(limit).enumerate() {\n40\t        if b == 0 {\n41\t            break;\n42\t        }\n43\t        dst[i] = b;\n44\t    }\n45\t}\n46\t\n47\t/// C's \"%.*f\" conversion, including glibc's spellings of the specials.\n48\tpub fn fmt_f(value: f64, precision: usize) -> String {\n49\t    if value.is_nan() {\n50\t        return if value.is_sign_negative() {\n51\t            String::from(\"-nan\")\n52\t        } else {\n53\t            String::from(\"nan\")\n54\t        };\n55\t    }\n56\t    if value.is_infinite() {\n57\t        return if value.is_sign_negative() {\n58\t            String::from(\"-inf\")\n59\t        } else {\n60\t            String::from(\"inf\")\n61\t        };\n62\t    }\n63\t    format!(\"{:.*}\", precision, value)\n64\t}\n65\t\n66\t/// isspace() in the \"C\" locale.\n67\tfn is_c_space(b: u8) -> bool {\n68\t    b == b' ' || b == b'\\t' || b == b'\\n' || b == 0x0b || b == 0x0c || b == b'\\r'\n69\t}\n70\t\n71\t/// fgets(buf, size, stdin).\n72\t///\n73\t/// Reads at most `size - 1` bytes, stopping after a newline (which is kept in\n74\t/// the returned buffer).  Returns None at end of file with nothing read, just\n75\t/// as fgets() returns NULL.\n76\tpub fn fgets<R: BufRead + ?Sized>(reader: &mut R, size: usize) -> Option<Vec<u8>> {\n77\t    let max = size - 1;\n78\t    let mut out: Vec<u8> = Vec::new();\n79\t\n80\t    while out.len() < max {\n81\t        let (chunk, newline_at) = {\n82\t            let available = loop {\n83\t                match reader.fill_buf() {\n84\t                    Ok(buf) => break buf,\n85\t                    Err(ref e) if e.kind() == std::io::ErrorKind::Interrupted => continue,\n86\t                    Err(_) => return None,\n87\t                }\n88\t            };\n89\t            if available.is_empty() {\n90\t                break; // EOF\n91\t            }\n92\t            let room = max - out.len();\n93\t            let take = if available.len() < room {\n94\t                available.len()\n95\t            } else {\n96\t                room\n97\t            };\n98\t            let slice = &available[..take];\n99\t            (slice.to_vec(), slice.iter().position(|&b| b == b'\\n'))\n100\t        };\n101\t\n102\t        match newline_at {\n103\t            Some(i) => {\n104\t                out.extend_from_slice(&chunk[..=i]);\n105\t                reader.consume(i + 1);\n106\t                break;\n107\t            }\n108\t            None => {\n109\t                let n = chunk.len();\n110\t                out.extend_from_slice(&chunk);\n111\t                reader.consume(n);\n112\t            }\n113\t        }\n114\t    }\n115\t\n116\t    if out.is_empty() {\n117\t        None\n118\t    } else {\n119\t        Some(out)\n120\t    }\n121\t}\n122\t\n123\t/// sscanf(input, \"%d\", &value): returns None when the conversion fails (the C\n124\t/// code then reports \"Invalid input\").\n125\t///\n126\t/// Mirrors glibc: leading whitespace is skipped, an optional sign is accepted,\n127\t/// decimal digits are accumulated into a `long` that saturates at\n128\t/// LONG_MAX/LONG_MIN on overflow, and the result is stored into an `int`\n129\t/// (truncating the upper bits).\n130\tpub fn sscanf_int(input: &[u8]) -> Option<i32> {\n131\t    let s = cstr(input);\n132\t    let mut i = 0usize;\n133\t\n134\t    while i < s.len() && is_c_space(s[i]) {\n135\t        i += 1;\n136\t    }\n137\t\n138\t    let mut negative = false;\n139\t    if i < s.len() && (s[i] == b'+' || s[i] == b'-') {\n140\t        negative = s[i] == b'-';\n141\t        i += 1;\n142\t    }\n143\t\n144\t    let digits_start = i;\n145\t    let mut acc: i64 = 0;\n146\t    let mut overflow = false;\n147\t    while i < s.len() && s[i].is_ascii_digit() {\n148\t        let d = i64::from(s[i] - b'0');\n149\t        if !overflow {\n150\t            match acc.checked_mul(10).and_then(|v| v.checked_add(d)) {\n151\t                Some(v) => acc = v,\n152\t                None => overflow = true,\n153\t            }\n154\t        }\n155\t        i += 1;\n156\t    }\n157\t\n158\t    if i == digits_start {\n159\t        return None; // matching failure\n160\t    }\n161\t\n162\t    let as_long: i64 = if overflow {\n163\t        if negative {\n164\t            i64::MIN\n165\t        } else {\n166\t            i64::MAX\n167\t        }\n168\t    } else if negative {\n169\t        -acc\n170\t    } else {\n171\t        acc\n172\t    };\n173\t\n174\t    Some(as_long as i32)\n175\t}\n176\t"}]},"parent_tool_use_id":null,"session_id":"0a3d7b95-e4e3-4db5-b2bb-1298e0d0e457","uuid":"6edca03d-f23a-44ac-b1a1-9d366147ac85","timestamp":"2026-08-28T01:15:57.524Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-eF4XiF/translation/src/cstdio.rs","content":"// cstdio.rs\n//\n// Small helpers that reproduce the exact behaviour of the C standard library\n// functions used by the original program: printf-style float formatting,\n// fgets() line reading and sscanf(buf, \"%d\", &x).\n\nuse std::io::BufRead;\n\n/// Write formatted text to the output stream, ignoring I/O errors the way\n/// printf() does (the C program never checks printf's return value).\nmacro_rules! p {\n    ($out:expr, $($arg:tt)*) => {{\n        let _ = ::std::io::Write::write_fmt($out, format_args!($($arg)*));\n    }};\n}\n\n/// Write raw bytes (used for `%s` of a fixed-size C char buffer).\nmacro_rules! pb {\n    ($out:expr, $bytes:expr) => {{\n        let _ = ::std::io::Write::write_all($out, $bytes);\n    }};\n}\n\n/// The bytes of a NUL-terminated C string held in a fixed-size buffer.\npub fn cstr(buf: &[u8]) -> &[u8] {\n    match buf.iter().position(|&b| b == 0) {\n        Some(end) => &buf[..end],\n        None => buf,\n    }\n}\n\n/// strncpy(dst, src, dst.len() - 1) followed by dst[dst.len() - 1] = '\\0',\n/// i.e. exactly what create_item()/create_order() do.\npub fn strncpy_truncate(dst: &mut [u8], src: &[u8]) {\n    for b in dst.iter_mut() {\n        *b = 0;\n    }\n    let limit = dst.len() - 1;\n    for (i, &b) in src.iter().take(limit).enumerate() {\n        if b == 0 {\n            break;\n        }\n        dst[i] = b;\n    }\n}\n\n/// C's \"%.*f\" conversion, including glibc's spellings of the specials.\npub fn fmt_f(value: f64, precision: usize) -> String {\n    if value.is_nan() {\n        return if value.is_sign_negative() {\n            String::from(\"-nan\")\n        } else {\n            String::from(\"nan\")\n        };\n    }\n    if value.is_infinite() {\n        return if value.is_sign_negative() {\n            String::from(\"-inf\")\n        } else {\n            String::from(\"inf\")\n        };\n    }\n    format!(\"{:.*}\", precision, value)\n}\n\n/// isspace() in the \"C\" locale.\nfn is_c_space(b: u8) -> bool {\n    b == b' ' || b == b'\\t' || b == b'\\n' || b == 0x0b || b == 0x0c || b == b'\\r'\n}\n\n/// fgets(buf, size, stdin).\n///\n/// Reads at most `size - 1` bytes, stopping after a newline (which is kept in\n/// the returned buffer).  Returns None at end of file with nothing read, just\n/// as fgets() returns NULL.\npub fn fgets<R: BufRead + ?Sized>(reader: &mut R, size: usize) -> Option<Vec<u8>> {\n    let max = size - 1;\n    let mut out: Vec<u8> = Vec::new();\n\n    while out.len() < max {\n        let (chunk, newline_at) = {\n            let available = loop {\n                match reader.fill_buf() {\n                    Ok(buf) => break buf,\n                    Err(ref e) if e.kind() == std::io::ErrorKind::Interrupted => continue,\n                    Err(_) => return None,\n                }\n            };\n            if available.is_empty() {\n                break; // EOF\n            }\n            let room = max - out.len();\n            let take = if available.len() < room {\n                available.len()\n            } else {\n                room\n            };\n            let slice = &available[..take];\n            (slice.to_vec(), slice.iter().position(|&b| b == b'\\n'))\n        };\n\n        match newline_at {\n            Some(i) => {\n                out.extend_from_slice(&chunk[..=i]);\n                reader.consume(i + 1);\n                break;\n            }\n            None => {\n                let n = chunk.len();\n                out.extend_from_slice(&chunk);\n                reader.consume(n);\n            }\n        }\n    }\n\n    if out.is_empty() {\n        None\n    } else {\n        Some(out)\n    }\n}\n\n/// sscanf(input, \"%d\", &value): returns None when the conversion fails (the C\n/// code then reports \"Invalid input\").\n///\n/// Mirrors glibc: leading whitespace is skipped, an optional sign is accepted,\n/// decimal digits are accumulated into a `long` that saturates at\n/// LONG_MAX/LONG_MIN on overflow, and the result is stored into an `int`\n/// (truncating the upper bits).\npub fn sscanf_int(input: &[u8]) -> Option<i32> {\n    let s = cstr(input);\n    let mut i = 0usize;\n\n    while i < s.len() && is_c_space(s[i]) {\n        i += 1;\n    }\n\n    let mut negative = false;\n    if i < s.len() && (s[i] == b'+' || s[i] == b'-') {\n        negative = s[i] == b'-';\n        i += 1;\n    }\n\n    let digits_start = i;\n    let mut acc: i64 = 0;\n    let mut overflow = false;\n    while i < s.len() && s[i].is_ascii_digit() {\n        let d = i64::from(s[i] - b'0');\n        if !overflow {\n            match acc.checked_mul(10).and_then(|v| v.checked_add(d)) {\n                Some(v) => acc = v,\n                None => overflow = true,\n            }\n        }\n        i += 1;\n    }\n\n    if i == digits_start {\n        return None; // matching failure\n    }\n\n    let as_long: i64 = if overflow {\n        if negative {\n            i64::MIN\n        } else {\n            i64::MAX\n        }\n    } else if negative {\n        -acc\n    } else {\n        acc\n    };\n\n    Some(as_long as i32)\n}\n","numLines":176,"startLine":1,"totalLines":176}}}
