, sizeof(int), -5);\n    printf(\"negmode get %d -> %td\\\\n\", kk, TEMP(b, sizeof(imap)));\n  }\n  dump_hidx(\"negmode\", ARR(b, sizeof(imap)));\n  stbds_hmfree_func(ARR(b, sizeof(imap)), sizeof(imap));\n\n  /* shmode_func with every mode value */\n  for (int mode = 0; mode <= 3; ++mode) {\n    smap *m = (smap *) stbds_shmode_func(sizeof(smap), mode);\n    void *arr = ARR(m, sizeof(smap));\n    printf(\"shmode %d: len=%zu cap=%zu\\\\n\", mode, HDR(arr)->length, HDR(arr)->capacity);\n    dump_hidx(\"shmode\", arr);\n    if (mode >= 2) {\n      char kb[64];\n      for (int i = 0; i < 15; ++i) {\n        sprintf(kb, \"sk_%d_%d\", mode, i);\n        m = (smap *) stbds_hmput_key(m, sizeof(smap), kb, sizeof(char*), 1);\n        m[TEMP(m,sizeof(smap))].value = i;\n      }\n      arr = ARR(m, sizeof(smap));\n      for (size_t i = 0; i < HDR(arr)->length - 1; ++i) printf(\"  shmode%d [%zu] %s=%d\\\\n\", mode, i, m[i].key, m[i].value);\n      dump_hidx(\"shmode-filled\", arr);\n    }\n    stbds_hmfree_func(ARR(m, sizeof(smap)), sizeof(smap));\n  }\n\n  /* single-entry stralloc edge: string longer than the current block */\n  arena a; memset(&a, 0, sizeof a);\n  char big[2000]; memset(big, 'q', sizeof big); big[1999] = 0;\n  char *p1 = stbds_stralloc(&a, big);\n  printf(\"big1 eq=%d rem=%zu blk=%u\\\\n\", strcmp(p1, big) == 0, a.remaining, (unsigned) a.block);\n  char *p2 = stbds_stralloc(&a, \"small\");\n  printf(\"small eq=%d rem=%zu blk=%u\\\\n\", strcmp(p2, \"small\") == 0, a.remaining, (unsigned) a.block);\n  char *p3 = stbds_stralloc(&a, big);\n  printf(\"big2 eq=%d rem=%zu blk=%u\\\\n\", strcmp(p3, big) == 0, a.remaining, (unsigned) a.block);\n  char *p4 = stbds_stralloc(&a, \"\");\n  printf(\"empty eq=%d rem=%zu blk=%u\\\\n\", strcmp(p4, \"\") == 0, a.remaining, (unsigned) a.block);\n  stbds_strreset(&a);\n  printf(\"reset rem=%zu blk=%u st=%d\\\\n\", a.remaining, (unsigned) a.block, a.storage == NULL);\n  /* many resets */\n  for (int r = 0; r < 3; ++r) {\n    arena 