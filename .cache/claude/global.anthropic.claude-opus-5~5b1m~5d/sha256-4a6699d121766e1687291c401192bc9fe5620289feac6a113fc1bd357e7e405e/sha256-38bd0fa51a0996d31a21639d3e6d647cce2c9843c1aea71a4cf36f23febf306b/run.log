{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_jv4w3uvbbtpppmgmnc5u3rqfateimgoia7hnndyy44ib3uafreyq","type":"message","role":"assistant","content":[{"type":"text","text":"Symbols match exactly. Now let me build a differential test harness to verify behavioral equivalence (including internal state)."}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":462,"cache_read_input_tokens":76177,"cache_creation":{"ephemeral_5m_input_tokens":462,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"f8282fcb-984b-4b2d-ad9e-26bf42e5757d","uuid":"02ea643d-2ec1-480c-9f58-ca15530bc259","timestamp":"2026-08-27T17:50:44.159Z"}
{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_jv4w3uvbbtpppmgmnc5u3rqfateimgoia7hnndyy44ib3uafreyq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01AHmGHAaQvyu7xo9mPyWaF6","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-OMDLK9/.cbuild/driver.c","content":"// Differential driver: exercises every exported symbol of the library and\n// dumps deterministic state (including internal hash-table state) so the C and\n// Rust builds can be compared byte for byte.\n#include <stdio.h>\n#include <stddef.h>\n#include <string.h>\n#include <stdlib.h>\n\ntypedef struct { size_t length, capacity; void *hash_table; ptrdiff_t temp; } hdr;\ntypedef struct string_block { struct string_block *next; char storage[8]; } string_block;\ntypedef struct { string_block *storage; size_t remaining; unsigned char block, mode; } arena;\ntypedef struct { size_t hash[8]; ptrdiff_t index[8]; } bucket;\ntypedef struct {\n  char *temp_key;\n  size_t slot_count, used_count, used_count_threshold, used_count_shrink_threshold;\n  size_t tombstone_count, tombstone_count_threshold, seed, slot_count_log2;\n  arena string;\n  bucket *storage;\n} hidx;\n\nextern void   stbds_rand_seed(size_t seed);\nextern size_t stbds_hash_bytes(void *p, size_t len, size_t seed);\nextern size_t stbds_hash_string(char *str, size_t seed);\nextern char * stbds_stralloc(arena *a, char *str);\nextern void   stbds_strreset(arena *a);\nextern void * stbds_arrgrowf(void *a, size_t elemsize, size_t addlen, size_t min_cap);\nextern void   stbds_arrfreef(void *a);\nextern void   stbds_hmfree_func(void *p, size_t elemsize);\nextern void * stbds_hmget_key(void *a, size_t elemsize, void *key, size_t keysize, int mode);\nextern void * stbds_hmget_key_ts(void *a, size_t elemsize, void *key, size_t keysize, ptrdiff_t *temp, int mode);\nextern void * stbds_hmput_default(void *a, size_t elemsize);\nextern void * stbds_hmput_key(void *a, size_t elemsize, void *key, size_t keysize, int mode);\nextern void * stbds_hmdel_key(void *a, size_t elemsize, void *key, size_t keysize, size_t keyoffset, int mode);\nextern void * stbds_shmode_func(size_t elemsize, int mode);\nextern char * strkey(int n);\nextern void   str_put(int num);\n\n#define HDR(t)  ((hdr*)(void*)(t) - 1)\n#define ARR(t,es) ((void*)((char*)(void*)(t) - (es)))\n#define TEMP(t,es) (HDR(ARR(t,es))->temp)\n\nstatic void dump_hidx(const char *tag, void *arrp) {\n  hidx *h = (hidx *) HDR(arrp)->hash_table;\n  if (!h) { printf(\"%s: table=NULL\\n\", tag); return; }\n  printf(\"%s: slots=%zu used=%zu ut=%zu ust=%zu tomb=%zu tt=%zu seed=%zu log2=%zu arena{rem=%zu blk=%u mode=%u}\\n\",\n    tag, h->slot_count, h->used_count, h->used_count_threshold, h->used_count_shrink_threshold,\n    h->tombstone_count, h->tombstone_count_threshold, h->seed, h->slot_count_log2,\n    h->string.remaining, (unsigned) h->string.block, (unsigned) h->string.mode);\n  for (size_t i = 0; i < h->slot_count >> 3; ++i) {\n    printf(\"  b%zu:\", i);\n    for (int j = 0; j < 8; ++j) printf(\" %zu/%td\", h->storage[i].hash[j], h->storage[i].index[j]);\n    printf(\"\\n\");\n  }\n}\n\n/* ------------------------------- hashes ------------------------------- */\nstatic void test_hashes(void) {\n  unsigned char buf[64];\n  for (int i = 0; i < 64; ++i) buf[i] = (unsigned char)(i * 17 + (i & 1 ? 0x80 : 3));\n  for (size_t len = 0; len <= 40; ++len) {\n    size_t seeds[4] = {0, 1, 0x31415926, 0xdeadbeefcafebabeULL};\n    for (int s = 0; s < 4; ++s)\n      printf(\"hb len=%zu seed=%zu -> %zu\\n\", len, seeds[s], stbds_hash_bytes(buf, len, seeds[s]));\n  }\n  /* all-high-bit and all-low-bit patterns to exercise sign extension */\n  unsigned char hb[16]; memset(hb, 0xff, sizeof hb);\n  for (size_t len = 0; len <= 16; ++len) printf(\"hb_ff len=%zu -> %zu\\n\", len, stbds_hash_bytes(hb, len, 7));\n  memset(hb, 0x80, sizeof hb);\n  for (size_t len = 0; len <= 16; ++len) printf(\"hb_80 len=%zu -> %zu\\n\", len, stbds_hash_bytes(hb, len, 7));\n  memset(hb, 0x01, sizeof hb);\n  for (size_t len = 0; len <= 16; ++len) printf(\"hb_01 len=%zu -> %zu\\n\", len, stbds_hash_bytes(hb, len, 9));\n\n  char *strs[] = {\"\", \"a\", \"ab\", \"abc\", \"hello world\", \"\\xff\\xfe\\x80 high\", \"test_123456789\", \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"};\n  for (int i = 0; i < 8; ++i)\n    for (size_t s = 0; s < 3; ++s)\n      printf(\"hs \\\"%s\\\" seed=%zu -> %zu\\n\", strs[i], s * 12345, stbds_hash_string(strs[i], s * 12345));\n}\n\n/* ------------------------------- arrays ------------------------------- */\nstatic void test_arr(void) {\n  int *a = NULL;\n  for (int i = 0; i < 40; ++i) {\n    if (!a || HDR(a)->length + 1 > HDR(a)->capacity)\n      a = (int *) stbds_arrgrowf(a, sizeof *a, 1, 0);\n    a[HDR(a)->length++] = i * 3;\n    printf(\"arr i=%d len=%zu cap=%zu temp=%td\\n\", i, HDR(a)->length, HDR(a)->capacity, HDR(a)->temp);\n  }\n  for (size_t i = 0; i < HDR(a)->length; ++i) printf(\"arr[%zu]=%d\\n\", i, a[i]);\n  stbds_arrfreef(a);\n\n  /* min_cap paths */\n  double *d = NULL;\n  d = (double *) stbds_arrgrowf(NULL, sizeof *d, 0, 1);   printf(\"d cap=%zu len=%zu\\n\", HDR(d)->capacity, HDR(d)->length);\n  d = (double *) stbds_arrgrowf(d, sizeof *d, 0, 3);      printf(\"d cap=%zu\\n\", HDR(d)->capacity);\n  d = (double *) stbds_arrgrowf(d, sizeof *d, 0, 5);      printf(\"d cap=%zu\\n\", HDR(d)->capacity);\n  d = (double *) stbds_arrgrowf(d, sizeof *d, 100, 0);    printf(\"d cap=%zu\\n\", HDR(d)->capacity);\n  d = (double *) stbds_arrgrowf(d, sizeof *d, 0, 1000);   printf(\"d cap=%zu\\n\", HDR(d)->capacity);\n  stbds_arrfreef(d);\n\n  char *c = (char *) stbds_arrgrowf(NULL, 1, 0, 0);\n  printf(\"c cap=%zu len=%zu\\n\", HDR(c)->capacity, HDR(c)->length);\n  stbds_arrfreef(c);\n}\n\n/* ---------------------------- binary hashmap -------------------------- */\ntypedef struct { int key, value; } imap;\n\nstatic imap *im_put(imap *m, int k, int v) {\n  int kk = k;\n  m = (imap *) stbds_hmput_key(m, sizeof(imap), &kk, sizeof(int), 0);\n  ptrdiff_t t = TEMP(m, sizeof(imap));\n  m[t].key = kk; m[t].value = v;\n  return m;\n}\nstatic imap *im_get(imap *m, int k, ptrdiff_t *slot) {\n  int kk = k;\n  m = (imap *) stbds_hmget_key(m, sizeof(imap), &kk, sizeof(int), 0);\n  *slot = TEMP(m, sizeof(imap));\n  return m;\n}\nstatic imap *im_del(imap *m, int k, ptrdiff_t *res) {\n  int kk = k;\n  m = (imap *) stbds_hmdel_key(m, sizeof(imap), &kk, sizeof(int), offsetof(imap, key), 0);\n  *res = m ? TEMP(m, sizeof(imap)) : 0;\n  return m;\n}\nstatic void im_dump(const char *tag, imap *m) {\n  if (!m) { printf(\"%s: NULL\\n\", tag); return; }\n  void *arr = ARR(m, sizeof(imap));\n  printf(\"%s: len=%zu cap=%zu temp=%td default=(%d,%d)\\n\", tag, HDR(arr)->length, HDR(arr)->capacity,\n         HDR(arr)->temp, m[-1].key, m[-1].value);\n  for (size_t i = 0; i < HDR(arr)->length - 1; ++i) printf(\"  [%zu] %d=%d\\n\", i, m[i].key, m[i].value);\n  dump_hidx(tag, arr);\n}\n\nstatic void test_hmap(void) {\n  imap *m = NULL;\n  ptrdiff_t t;\n  m = im_get(m, 5, &t); printf(\"get-empty slot=%td\\n\", t);\n  im_dump(\"after get-empty\", m);\n\n  for (int i = 0; i < 50; ++i) {\n    m = im_put(m, i, i * i);\n    if (i % 7 == 0) im_dump(\"put\", m);\n  }\n  im_dump(\"after 50 puts\", m);\n  for (int i = 0; i < 55; ++i) { m = im_get(m, i, &t); printf(\"get %d -> slot=%td val=%d\\n\", i, t, t >= 0 ? m[t].value : -999); }\n\n  m = (imap *) stbds_hmput_default(m, sizeof(imap));\n  m[-1].value = -12345;\n  m = im_get(m, 999, &t); printf(\"miss slot=%td default=%d\\n\", t, m[t].value);\n\n  ptrdiff_t r;\n  for (int i = 0; i < 50; i += 3) { m = im_del(m, i, &r); printf(\"del %d -> %td\\n\", i, r); }\n  im_dump(\"after deletes\", m);\n  for (int i = 0; i < 50; ++i) { m = im_get(m, i, &t); printf(\"get2 %d -> slot=%td val=%d\\n\", i, t, t >= 0 ? m[t].value : -999); }\n  for (int i = 0; i < 50; ++i) { m = im_del(m, i, &r); if (i % 5 == 0) im_dump(\"del-loop\", m); }\n  im_dump(\"after all deletes\", m);\n  m = im_put(m, 1234, 4321);\n  im_dump(\"after reinsert\", m);\n\n  /* threadsafe getter */\n  ptrdiff_t tmp;\n  m = (imap *) stbds_hmget_key_ts(m, sizeof(imap), (void*)&(int){1234}, sizeof(int), &tmp, 0);\n  printf(\"ts get 1234 -> %td\\n\", tmp);\n  m = (imap *) stbds_hmget_key_ts(m, sizeof(imap), (void*)&(int){9999}, sizeof(int), &tmp, 0);\n  printf(\"ts get 9999 -> %td\\n\", tmp);\n\n  stbds_hmfree_func(ARR(m, sizeof(imap)), sizeof(imap));\n\n  /* hmget_key_ts on NULL creates the sentinel */\n  imap *n = NULL;\n  n = (imap *) stbds_hmget_key_ts(NULL, sizeof(imap), (void*)&(int){1}, sizeof(int), &tmp, 0);\n  printf(\"ts null -> %td len=%zu cap=%zu\\n\", tmp, HDR(ARR(n,sizeof(imap)))->length, HDR(ARR(n,sizeof(imap)))->capacity);\n  stbds_hmfree_func(ARR(n, sizeof(imap)), sizeof(imap));\n\n  /* hmput_default on NULL */\n  imap *p = NULL;\n  p = (imap *) stbds_hmput_default(NULL, sizeof(imap));\n  printf(\"default null len=%zu cap=%zu key=%d val=%d\\n\", HDR(ARR(p,sizeof(imap)))->length,\n         HDR(ARR(p,sizeof(imap)))->capacity, p[-1].key, p[-1].value);\n  stbds_hmfree_func(ARR(p, sizeof(imap)), sizeof(imap));\n\n  /* del on NULL map */\n  printf(\"del NULL -> %p\\n\", stbds_hmdel_key(NULL, sizeof(imap), (void*)&(int){1}, sizeof(int), 0, 0));\n\n  /* 2-int key */\n  typedef struct { int key[2], value; } i2map;\n  i2map *q = NULL;\n  for (int i = 0; i < 20; ++i) {\n    int kk[2] = { i, i * 2 };\n    q = (i2map *) stbds_hmput_key(q, sizeof(i2map), kk, sizeof kk, 0);\n    ptrdiff_t s = TEMP(q, sizeof(i2map));\n    q[s].key[0] = kk[0]; q[s].key[1] = kk[1]; q[s].value = i + 100;\n  }\n  for (int i = 0; i < 20; ++i) {\n    int kk[2] = { i, i * 2 };\n    q = (i2map *) stbds_hmget_key(q, sizeof(i2map), kk, sizeof kk, 0);\n    ptrdiff_t s = TEMP(q, sizeof(i2map));\n    printf(\"i2 get %d -> %td %d\\n\", i, s, s >= 0 ? q[s].value : -1);\n  }\n  dump_hidx(\"i2map\", ARR(q, sizeof(i2map)));\n  stbds_hmfree_func(ARR(q, sizeof(i2map)), sizeof(i2map));\n}\n\n/* ---------------------------- string hashmap -------------------------- */\ntypedef struct { char *key; int value; } smap;\n\nstatic smap *sm_put(smap *m, char *k, int v) {\n  m = (smap *) stbds_hmput_key(m, sizeof(smap), (void*)k, sizeof(char*), 1);\n  ptrdiff_t t = TEMP(m, sizeof(smap));\n  m[t].value = v;\n  return m;\n}\nstatic void sm_dump(const char *tag, smap *m) {\n  if (!m) { printf(\"%s: NULL\\n\", tag); return; }\n  void *arr = ARR(m, sizeof(smap));\n  printf(\"%s: len=%zu cap=%zu temp=%td\\n\", tag, HDR(arr)->length, HDR(arr)->capacity, HDR(arr)->temp);\n  for (size_t i = 0; i < HDR(arr)->length - 1; ++i) printf(\"  [%zu] %s=%d\\n\", i, m[i].key, m[i].value);\n  dump_hidx(tag, arr);\n}\n\nstatic void test_smap(int mode, const char *tag) {\n  smap *m;\n  if (mode < 0) m = NULL;                                        /* default (no dup) */\n  else m = (smap *) stbds_shmode_func(sizeof(smap), mode);       /* 2=strdup, 3=arena */\n  char keybuf[64];\n  static char *keeper[64];\n  for (int i = 0; i < 40; ++i) {\n    if (mode < 0) { keeper[i] = (char*) malloc(64); sprintf(keeper[i], \"key_%d\", i); m = sm_put(m, keeper[i], i * 5); }\n    else { sprintf(keybuf, \"key_%d\", i); m = sm_put(m, keybuf, i * 5); }\n    if (i % 9 == 0) sm_dump(tag, m);\n  }\n  sm_dump(tag, m);\n  for (int i = 0; i < 45; ++i) {\n    sprintf(keybuf, \"key_%d\", i);\n    m = (smap *) stbds_hmget_key(m, sizeof(smap), keybuf, sizeof(char*), 1);\n    ptrdiff_t t = TEMP(m, sizeof(smap));\n    printf(\"%s get %s -> %td %d\\n\", tag, keybuf, t, t >= 0 ? m[t].value : -1);\n  }\n  for (int i = 0; i < 40; i += 2) {\n    sprintf(keybuf, \"key_%d\", i);\n    m = (smap *) stbds_hmdel_key(m, sizeof(smap), keybuf, sizeof(char*), offsetof(smap, key), 1);\n    printf(\"%s del %s -> %td\\n\", tag, keybuf, m ? TEMP(m, sizeof(smap)) : 0);\n  }\n  sm_dump(tag, m);\n  /* re-add and long keys */\n  for (int i = 0; i < 10; ++i) {\n    char big[300]; memset(big, 'x', sizeof big); big[299] = 0; sprintf(big + 250, \"long_%d\", i);\n    if (mode < 0) { keeper[40+i] = (char*) malloc(400); strcpy(keeper[40+i], big); m = sm_put(m, keeper[40+i], 1000 + i); }\n    else m = sm_put(m, big, 1000 + i);\n  }\n  sm_dump(tag, m);\n  stbds_hmfree_func(ARR(m, sizeof(smap)), sizeof(smap));\n  if (mode < 0) for (int i = 0; i < 50; ++i) if (keeper[i]) { free(keeper[i]); keeper[i] = NULL; }\n}\n\n/* ------------------------------- arena -------------------------------- */\nstatic void test_arena(void) {\n  arena a; memset(&a, 0, sizeof a);\n  char *base = NULL;\n  for (int i = 0; i < 200; ++i) {\n    char b[1200];\n    int n = (i * 37) % 900 + 1;\n    memset(b, 'a' + (i % 26), n); b[n] = 0;\n    char *p = stbds_stralloc(&a, b);\n    printf(\"arena i=%d len=%d rem=%zu blk=%u ok=%d\\n\", i, n, a.remaining, (unsigned)a.block, strcmp(p, b) == 0);\n    (void) base;\n  }\n  stbds_strreset(&a);\n  printf(\"arena reset rem=%zu blk=%u mode=%u storage=%d\\n\", a.remaining, (unsigned)a.block, (unsigned)a.mode, a.storage == NULL);\n  /* tiny strings */\n  arena b2; memset(&b2, 0, sizeof b2);\n  for (int i = 0; i < 300; ++i) { char s[8]; sprintf(s, \"%d\", i); char *p = stbds_stralloc(&b2, s); printf(\"a2 %s rem=%zu blk=%u eq=%d\\n\", p, b2.remaining, (unsigned)b2.block, strcmp(p, s) == 0); }\n  stbds_strreset(&b2);\n  printf(\"a2 reset rem=%zu blk=%u\\n\", b2.remaining, (unsigned)b2.block);\n}\n\nint main(void) {\n  printf(\"== strkey ==\\n\");\n  for (int i = -3; i < 5; ++i) printf(\"strkey(%d)=%s\\n\", i, strkey(i));\n  printf(\"strkey(%d)=%s\\n\", 2147483647, strkey(2147483647));\n  printf(\"== hashes ==\\n\");\n  test_hashes();\n  printf(\"== seeded hashes ==\\n\");\n  stbds_rand_seed(0);\n  test_hashes();\n  stbds_rand_seed(0x31415926);\n  printf(\"== arrays ==\\n\");\n  test_arr();\n  printf(\"== hmap ==\\n\");\n  test_hmap();\n  printf(\"== smap default ==\\n\");\n  test_smap(-1, \"sdef\");\n  printf(\"== smap strdup ==\\n\");\n  test_smap(2, \"sdup\");\n  printf(\"== smap arena ==\\n\");\n  test_smap(3, \"sarena\");\n  printf(\"== arena ==\\n\");\n  test_arena();\n  printf(\"== str_put ==\\n\");\n  for (int i = 0; i < 6; ++i) str_put(i);\n  str_put(-1);\n  str_put(100);\n  str_put(2000);\n  printf(\"== seed-sensitive replay ==\\n\");\n  stbds_rand_seed(12345);\n  test_hmap();\n  str_put(3);\n  printf(\"== done ==\\n\");\n  return 0;\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":462,"cache_read_input_tokens":76177,"cache_creation":{"ephemeral_5m_input_tokens":462,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"f8282fcb-984b-4b2d-ad9e-26bf42e5757d","uuid":"175035e3-fb04-4cd5-8105-d90b15d7d5b7","timestamp":"2026-08-27T17:51:49.159Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01AHmGHAaQvyu7xo9mPyWaF6","type":"tool_result","content":"File created successfully at: /local/home/scheschb/.harvest/work/harvest-work-OMDLK9/.cbuild/driver.c (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"f8282fcb-984b-4b2d-ad9e-26bf42e5757d","uuid":"21426243-89d7-42cb-9dcf-0600e3b97913","timestamp":"2026-08-27T17:51:49.172Z","tool_use_result":{"type":"create","filePath":"/local/home/scheschb/.harvest/work/harvest-work-OMDLK9/.cbuild/driver.c","content":"// Differential driver: exercises every exported symbol of the library and\n// dumps deterministic state (including internal hash-table state) so the C and\n// Rust builds can be compared byte for byte.\n#include <stdio.h>\n#include <stddef.h>\n#include <string.h>\n#include <stdlib.h>\n\ntypedef struct { size_t length, capacity; void *hash_table; ptrdiff_t temp; } hdr;\ntypedef struct string_block { struct string_block *next; char storage[8]; } string_block;\ntypedef struct { string_block *storage; size_t remaining; unsigned char block, mode; } arena;\ntypedef struct { size_t hash[8]; ptrdiff_t index[8]; } bucket;\ntypedef struct {\n  char *temp_key;\n  size_t slot_count, used_count, used_count_threshold, used_count_shrink_threshold;\n  size_t tombstone_count, tombstone_count_threshold, seed, slot_count_log2;\n  arena string;\n  bucket *storage;\n} hidx;\n\nextern void   stbds_rand_seed(size_t seed);\nextern size_t stbds_hash_bytes(void *p, size_t len, size_t seed);\nextern size_t stbds_hash_string(char *str, size_t seed);\nextern char * stbds_stralloc(arena *a, char *str);\nextern void   stbds_strreset(arena *a);\nextern void * stbds_arrgrowf(void *a, size_t elemsize, size_t addlen, size_t min_cap);\nextern void   stbds_arrfreef(void *a);\nextern void   stbds_hmfree_func(void *p, size_t elemsize);\nextern void * stbds_hmget_key(void *a, size_t elemsize, void *key, size_t keysize, int mode);\nextern void * stbds_hmget_key_ts(void *a, size_t elemsize, void *key, size_t keysize, ptrdiff_t *temp, int mode);\nextern void * stbds_hmput_default(void *a, size_t elemsize);\nextern void * stbds_hmput_key(void *a, size_t elemsize, void *key, size_t keysize, int mode);\nextern void * stbds_hmdel_key(void *a, size_t elemsize, void *key, size_t keysize, size_t keyoffset, int mode);\nextern void * stbds_shmode_func(size_t elemsize, int mode);\nextern char * strkey(int n);\nextern void   str_put(int num);\n\n#define HDR(t)  ((hdr*)(void*)(t) - 1)\n#define ARR(t,es) ((void*)((char*)(void*)(t) - (es)))\n#define TEMP(t,es) (HDR(ARR(t,es))->temp)\n\nstatic void dump_hidx(const char *tag, void *arrp) {\n  hidx *h = (hidx *) HDR(arrp)->hash_table;\n  if (!h) { printf(\"%s: table=NULL\\n\", tag); return; }\n  printf(\"%s: slots=%zu used=%zu ut=%zu ust=%zu tomb=%zu tt=%zu seed=%zu log2=%zu arena{rem=%zu blk=%u mode=%u}\\n\",\n    tag, h->slot_count, h->used_count, h->used_count_threshold, h->used_count_shrink_threshold,\n    h->tombstone_count, h->tombstone_count_threshold, h->seed, h->slot_count_log2,\n    h->string.remaining, (unsigned) h->string.block, (unsigned) h->string.mode);\n  for (size_t i = 0; i < h->slot_count >> 3; ++i) {\n    printf(\"  b%zu:\", i);\n    for (int j = 0; j < 8; ++j) printf(\" %zu/%td\", h->storage[i].hash[j], h->storage[i].index[j]);\n    printf(\"\\n\");\n  }\n}\n\n/* ------------------------------- hashes ------------------------------- */\nstatic void test_hashes(void) {\n  unsigned char buf[64];\n  for (int i = 0; i < 64; ++i) buf[i] = (unsigned char)(i * 17 + (i & 1 ? 0x80 : 3));\n  for (size_t len = 0; len <= 40; ++len) {\n    size_t seeds[4] = {0, 1, 0x31415926, 0xdeadbeefcafebabeULL};\n    for (int s = 0; s < 4; ++s)\n      printf(\"hb len=%zu seed=%zu -> %zu\\n\", len, seeds[s], stbds_hash_bytes(buf, len, seeds[s]));\n  }\n  /* all-high-bit and all-low-bit patterns to exercise sign extension */\n  unsigned char hb[16]; memset(hb, 0xff, sizeof hb);\n  for (size_t len = 0; len <= 16; ++len) printf(\"hb_ff len=%zu -> %zu\\n\", len, stbds_hash_bytes(hb, len, 7));\n  memset(hb, 0x80, sizeof hb);\n  for (size_t len = 0; len <= 16; ++len) printf(\"hb_80 len=%zu -> %zu\\n\", len, stbds_hash_bytes(hb, len, 7));\n  memset(hb, 0x01, sizeof hb);\n  for (size_t len = 0; len <= 16; ++len) printf(\"hb_01 len=%zu -> %zu\\n\", len, stbds_hash_bytes(hb, len, 9));\n\n  char *strs[] = {\"\", \"a\", \"ab\", \"abc\", \"hello world\", \"\\xff\\xfe\\x80 high\", \"test_123456789\", \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"};\n  for (int i = 0; i < 8; ++i)\n    for (size_t s = 0; s < 3; ++s)\n      printf(\"hs \\\"%s\\\" seed=%zu -> %zu\\n\", strs[i], s * 12345, stbds_hash_string(strs[i], s * 12345));\n}\n\n/* ------------------------------- arrays ------------------------------- */\nstatic void test_arr(void) {\n  int *a = NULL;\n  for (int i = 0; i < 40; ++i) {\n    if (!a || HDR(a)->length + 1 > HDR(a)->capacity)\n      a = (int *) stbds_arrgrowf(a, sizeof *a, 1, 0);\n    a[HDR(a)->length++] = i * 3;\n    printf(\"arr i=%d len=%zu cap=%zu temp=%td\\n\", i, HDR(a)->length, HDR(a)->capacity, HDR(a)->temp);\n  }\n  for (size_t i = 0; i < HDR(a)->length; ++i) printf(\"arr[%zu]=%d\\n\", i, a[i]);\n  stbds_arrfreef(a);\n\n  /* min_cap paths */\n  double *d = NULL;\n  d = (double *) stbds_arrgrowf(NULL, sizeof *d, 0, 1);   printf(\"d cap=%zu len=%zu\\n\", HDR(d)->capacity, HDR(d)->length);\n  d = (double *) stbds_arrgrowf(d, sizeof *d, 0, 3);      printf(\"d cap=%zu\\n\", HDR(d)->capacity);\n  d = (double *) stbds_arrgrowf(d, sizeof *d, 0, 5);      printf(\"d cap=%zu\\n\", HDR(d)->capacity);\n  d = (double *) stbds_arrgrowf(d, sizeof *d, 100, 0);    printf(\"d cap=%zu\\n\", HDR(d)->capacity);\n  d = (double *) stbds_arrgrowf(d, sizeof *d, 0, 1000);   printf(\"d cap=%zu\\n\", HDR(d)->capacity);\n  stbds_arrfreef(d);\n\n  char *c = (char *) stbds_arrgrowf(NULL, 1, 0, 0);\n  printf(\"c cap=%zu len=%zu\\n\", HDR(c)->capacity, HDR(c)->length);\n  stbds_arrfreef(c);\n}\n\n/* ---------------------------- binary hashmap -------------------------- */\ntypedef struct { int key, value; } imap;\n\nstatic imap *im_put(imap *m, int k, int v) {\n  int kk = k;\n  m = (imap *) stbds_hmput_key(m, sizeof(imap), &kk, sizeof(int), 0);\n  ptrdiff_t t = TEMP(m, sizeof(imap));\n  m[t].key = kk; m[t].value = v;\n  return m;\n}\nstatic imap *im_get(imap *m, int k, ptrdiff_t *slot) {\n  int kk = k;\n  m = (imap *) stbds_hmget_key(m, sizeof(imap), &kk, sizeof(int), 0);\n  *slot = TEMP(m, sizeof(imap));\n  return m;\n}\nstatic imap *im_del(imap *m, int k, ptrdiff_t *res) {\n  int kk = k;\n  m = (imap *) stbds_hmdel_key(m, sizeof(imap), &kk, sizeof(int), offsetof(imap, key), 0);\n  *res = m ? TEMP(m, sizeof(imap)) : 0;\n  return m;\n}\nstatic void im_dump(const char *tag, imap *m) {\n  if (!m) { printf(\"%s: NULL\\n\", tag); return; }\n  void *arr = ARR(m, sizeof(imap));\n  printf(\"%s: len=%zu cap=%zu temp=%td default=(%d,%d)\\n\", tag, HDR(arr)->length, HDR(arr)->capacity,\n         HDR(arr)->temp, m[-1].key, m[-1].value);\n  for (size_t i = 0; i < HDR(arr)->length - 1; ++i) printf(\"  [%zu] %d=%d\\n\", i, m[i].key, m[i].value);\n  dump_hidx(tag, arr);\n}\n\nstatic void test_hmap(void) {\n  imap *m = NULL;\n  ptrdiff_t t;\n  m = im_get(m, 5, &t); printf(\"get-empty slot=%td\\n\", t);\n  im_dump(\"after get-empty\", m);\n\n  for (int i = 0; i < 50; ++i) {\n    m = im_put(m, i, i * i);\n    if (i % 7 == 0) im_dump(\"put\", m);\n  }\n  im_dump(\"after 50 puts\", m);\n  for (int i = 0; i < 55; ++i) { m = im_get(m, i, &t); printf(\"get %d -> slot=%td val=%d\\n\", i, t, t >= 0 ? m[t].value : -999); }\n\n  m = (imap *) stbds_hmput_default(m, sizeof(imap));\n  m[-1].value = -12345;\n  m = im_get(m, 999, &t); printf(\"miss slot=%td default=%d\\n\", t, m[t].value);\n\n  ptrdiff_t r;\n  for (int i = 0; i < 50; i += 3) { m = im_del(m, i, &r); printf(\"del %d -> %td\\n\", i, r); }\n  im_dump(\"after deletes\", m);\n  for (int i = 0; i < 50; ++i) { m = im_get(m, i, &t); printf(\"get2 %d -> slot=%td val=%d\\n\", i, t, t >= 0 ? m[t].value : -999); }\n  for (int i = 0; i < 50; ++i) { m = im_del(m, i, &r); if (i % 5 == 0) im_dump(\"del-loop\", m); }\n  im_dump(\"after all deletes\", m);\n  m = im_put(m, 1234, 4321);\n  im_dump(\"after reinsert\", m);\n\n  /* threadsafe getter */\n  ptrdiff_t tmp;\n  m = (imap *) stbds_hmget_key_ts(m, sizeof(imap), (void*)&(int){1234}, sizeof(int), &tmp, 0);\n  printf(\"ts get 1234 -> %td\\n\", tmp);\n  m = (imap *) stbds_hmget_key_ts(m, sizeof(imap), (void*)&(int){9999}, sizeof(int), &tmp, 0);\n  printf(\"ts get 9999 -> %td\\n\", tmp);\n\n  stbds_hmfree_func(ARR(m, sizeof(imap)), sizeof(imap));\n\n  /* hmget_key_ts on NULL creates the sentinel */\n  imap *n = NULL;\n  n = (imap *) stbds_hmget_key_ts(NULL, sizeof(imap), (void*)&(int){1}, sizeof(int), &tmp, 0);\n  printf(\"ts null -> %td len=%zu cap=%zu\\n\", tmp, HDR(ARR(n,sizeof(imap)))->length, HDR(ARR(n,sizeof(imap)))->capacity);\n  stbds_hmfree_func(ARR(n, sizeof(imap)), sizeof(imap));\n\n  /* hmput_default on NULL */\n  imap *p = NULL;\n  p = (imap *) stbds_hmput_default(NULL, sizeof(imap));\n  printf(\"default null len=%zu cap=%zu key=%d val=%d\\n\", HDR(ARR(p,sizeof(imap)))->length,\n         HDR(ARR(p,sizeof(imap)))->capacity, p[-1].key, p[-1].value);\n  stbds_hmfree_func(ARR(p, sizeof(imap)), sizeof(imap));\n\n  /* del on NULL map */\n  printf(\"del NULL -> %p\\n\", stbds_hmdel_key(NULL, sizeof(imap), (void*)&(int){1}, sizeof(int), 0, 0));\n\n  /* 2-int key */\n  typedef struct { int key[2], value; } i2map;\n  i2map *q = NULL;\n  for (int i = 0; i < 20; ++i) {\n    int kk[2] = { i, i * 2 };\n    q = (i2map *) stbds_hmput_key(q, sizeof(i2map), kk, sizeof kk, 0);\n    ptrdiff_t s = TEMP(q, sizeof(i2map));\n    q[s].key[0] = kk[0]; q[s].key[1] = kk[1]; q[s].value = i + 100;\n  }\n  for (int i = 0; i < 20; ++i) {\n    int kk[2] = { i, i * 2 };\n    q = (i2map *) stbds_hmget_key(q, sizeof(i2map), kk, sizeof kk, 0);\n    ptrdiff_t s = TEMP(q, sizeof(i2map));\n    printf(\"i2 get %d -> %td %d\\n\", i, s, s >= 0 ? q[s].value : -1);\n  }\n  dump_hidx(\"i2map\", ARR(q, sizeof(i2map)));\n  stbds_hmfree_func(ARR(q, sizeof(i2map)), sizeof(i2map));\n}\n\n/* ---------------------------- string hashmap -------------------------- */\ntypedef struct { char *key; int value; } smap;\n\nstatic smap *sm_put(smap *m, char *k, int v) {\n  m = (smap *) stbds_hmput_key(m, sizeof(smap), (void*)k, sizeof(char*), 1);\n  ptrdiff_t t = TEMP(m, sizeof(smap));\n  m[t].value = v;\n  return m;\n}\nstatic void sm_dump(const char *tag, smap *m) {\n  if (!m) { printf(\"%s: NULL\\n\", tag); return; }\n  void *arr = ARR(m, sizeof(smap));\n  printf(\"%s: len=%zu cap=%zu temp=%td\\n\", tag, HDR(arr)->length, HDR(arr)->capacity, HDR(arr)->temp);\n  for (size_t i = 0; i < HDR(arr)->length - 1; ++i) printf(\"  [%zu] %s=%d\\n\", i, m[i].key, m[i].value);\n  dump_hidx(tag, arr);\n}\n\nstatic void test_smap(int mode, const char *tag) {\n  smap *m;\n  if (mode < 0) m = NULL;                                        /* default (no dup) */\n  else m = (smap *) stbds_shmode_func(sizeof(smap), mode);       /* 2=strdup, 3=arena */\n  char keybuf[64];\n  static char *keeper[64];\n  for (int i = 0; i < 40; ++i) {\n    if (mode < 0) { keeper[i] = (char*) malloc(64); sprintf(keeper[i], \"key_%d\", i); m = sm_put(m, keeper[i], i * 5); }\n    else { sprintf(keybuf, \"key_%d\", i); m = sm_put(m, keybuf, i * 5); }\n    if (i % 9 == 0) sm_dump(tag, m);\n  }\n  sm_dump(tag, m);\n  for (int i = 0; i < 45; ++i) {\n    sprintf(keybuf, \"key_%d\", i);\n    m = (smap *) stbds_hmget_key(m, sizeof(smap), keybuf, sizeof(char*), 1);\n    ptrdiff_t t = TEMP(m, sizeof(smap));\n    printf(\"%s get %s -> %td %d\\n\", tag, keybuf, t, t >= 0 ? m[t].value : -1);\n  }\n  for (int i = 0; i < 40; i += 2) {\n    sprintf(keybuf, \"key_%d\", i);\n    m = (smap *) stbds_hmdel_key(m, sizeof(smap), keybuf, sizeof(char*), offsetof(smap, key), 1);\n    printf(\"%s del %s -> %td\\n\", tag, keybuf, m ? TEMP(m, sizeof(smap)) : 0);\n  }\n  sm_dump(tag, m);\n  /* re-add and long keys */\n  for (int i = 0; i < 10; ++i) {\n    char big[300]; memset(big, 'x', sizeof big); big[299] = 0; sprintf(big + 250, \"long_%d\", i);\n    if (mode < 0) { keeper[40+i] = (char*) malloc(400); strcpy(keeper[40+i], big); m = sm_put(m, keeper[40+i], 1000 + i); }\n    else m = sm_put(m, big, 1000 + i);\n  }\n  sm_dump(tag, m);\n  stbds_hmfree_func(ARR(m, sizeof(smap)), sizeof(smap));\n  if (mode < 0) for (int i = 0; i < 50; ++i) if (keeper[i]) { free(keeper[i]); keeper[i] = NULL; }\n}\n\n/* ------------------------------- arena -------------------------------- */\nstatic void test_arena(void) {\n  arena a; memset(&a, 0, sizeof a);\n  char *base = NULL;\n  for (int i = 0; i < 200; ++i) {\n    char b[1200];\n    int n = (i * 37) % 900 + 1;\n    memset(b, 'a' + (i % 26), n); b[n] = 0;\n    char *p = stbds_stralloc(&a, b);\n    printf(\"arena i=%d len=%d rem=%zu blk=%u ok=%d\\n\", i, n, a.remaining, (unsigned)a.block, strcmp(p, b) == 0);\n    (void) base;\n  }\n  stbds_strreset(&a);\n  printf(\"arena reset rem=%zu blk=%u mode=%u storage=%d\\n\", a.remaining, (unsigned)a.block, (unsigned)a.mode, a.storage == NULL);\n  /* tiny strings */\n  arena b2; memset(&b2, 0, sizeof b2);\n  for (int i = 0; i < 300; ++i) { char s[8]; sprintf(s, \"%d\", i); char *p = stbds_stralloc(&b2, s); printf(\"a2 %s rem=%zu blk=%u eq=%d\\n\", p, b2.remaining, (unsigned)b2.block, strcmp(p, s) == 0); }\n  stbds_strreset(&b2);\n  printf(\"a2 reset rem=%zu blk=%u\\n\", b2.remaining, (unsigned)b2.block);\n}\n\nint main(void) {\n  printf(\"== strkey ==\\n\");\n  for (int i = -3; i < 5; ++i) printf(\"strkey(%d)=%s\\n\", i, strkey(i));\n  printf(\"strkey(%d)=%s\\n\", 2147483647, strkey(2147483647));\n  printf(\"== hashes ==\\n\");\n  test_hashes();\n  printf(\"== seeded hashes ==\\n\");\n  stbds_rand_seed(0);\n  test_hashes();\n  stbds_rand_seed(0x31415926);\n  printf(\"== arrays ==\\n\");\n  test_arr();\n  printf(\"== hmap ==\\n\");\n  test_hmap();\n  printf(\"== smap default ==\\n\");\n  test_smap(-1, \"sdef\");\n  printf(\"== smap strdup ==\\n\");\n  test_smap(2, \"sdup\");\n  printf(\"== smap arena ==\\n\");\n  test_smap(3, \"sarena\");\n  printf(\"== arena ==\\n\");\n  test_arena();\n  printf(\"== str_put ==\\n\");\n  for (int i = 0; i < 6; ++i) str_put(i);\n  str_put(-1);\n  str_put(100);\n  str_put(2000);\n  printf(\"== seed-sensitive replay ==\\n\");\n  stbds_rand_seed(12345);\n  test_hmap();\n  str_put(3);\n  printf(\"== done ==\\n\");\n  return 0;\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
