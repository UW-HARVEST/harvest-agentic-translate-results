n\n    echo \"STDOUT-DIFF $b $t $s\"; echo \"  C   =[$cout]\"; echo \"  Rust=[$rout]\"; fail=1\n  elif [ \"$crc\" != \"$rrc\" ]; then\n    echo \"EXIT-DIFF $b $t $s  C=$crc Rust=$rrc\"; fail=1\n  elif [ -n \"$ref\" ] && [ \"$cout\" != \"$ref\" ]; then\n    echo \"REF-DIFF $b $t $s\"; echo \"  got=[$cout]\"; echo \"  ref=[$ref]\"; fail=1\n  else\n    echo \"OK $b $t $s  exit=$crc  $cout\"\n  fi\ndone; done; done\nexit $fail\n","structuredPatch":[{"oldStart":4,"oldLines":6,"newStart":4,"newLines":10,"lines":[" # reference_outputs.txt."," ROOT=\"$(cd \"$(dirname \"$0\")\" && pwd)\""," export CARGO_NET_OFFLINE=1","+# Dedicated target dir: otherwise a concurrent `cargo build`/`cargo test` for a","+# different feature set overwrites target/release/driver mid-run and the","+# comparison silently uses the WRONG binary.","+export CARGO_TARGET_DIR=\"$ROOT/translation/target-drv\""," BACKENDS=\"${BACKENDS:-blake haraka sha2 shake}\""," THASHES=\"${THASHES:-robust simple}\""," SECPARS=\"${SECPARS:-128s 128f 192s 192f 256s 256f}\""]}],"userModified":false,"replaceAll":false}}
