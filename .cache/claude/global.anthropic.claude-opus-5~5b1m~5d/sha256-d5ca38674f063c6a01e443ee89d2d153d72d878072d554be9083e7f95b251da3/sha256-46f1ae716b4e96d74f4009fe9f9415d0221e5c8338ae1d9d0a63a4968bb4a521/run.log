}\"\nfail=0\nfor b in $BACKENDS; do for t in $THASHES; do for s in $SECPARS; do\n  cd \"$ROOT/translation\" || exit 1\n  if ! cargo build --release --no-default-features --features \"$b,$t,$s\" \\\n        > \"$ROOT/gen/drvbuild-$b-$t-$s.log\" 2>&1; then\n    echo \"RUSTBUILD-FAIL $b $t $s\"; fail=1; continue\n  fi\n  cout=$(\"$ROOT/cbuild/$b-$t-$s/app/driver\" 2>/dev/null); crc=$?\n  rout=$(\"$CARGO_TARGET_DIR/release/driver\" 2>/dev/null); rrc=$?\n  ref=$(grep -P \"^$b $t $s\\t\" \"$ROOT/reference_outputs.txt\" | cut -f2)\n  if [ \"$cout\" != \"$rout\" ]; then\n    echo \"STDOUT-DIFF $b $t $s\"; echo \"  C   =[$cout]\"; echo \"  Rust=[$rout]\"; fail=1\n  elif [ \"$crc\" != \"$rrc\" ]; then\n    echo \"EXIT-DIFF $b $t $s  C=$crc Rust=$rrc\"; fail=1\n  elif [ -n \"$ref\" ] && [ \"$cout\" != \"$ref\" ]; then\n    echo \"REF-DIFF $b $t $s\"; echo \"  got=[$cout]\"; echo \"  ref=[$ref]\"; fail=1\n  else\n    echo \"OK $b $t $s  exit=$crc  $cout\"\n  fi\ndone; done; done\nexit $fail\n","userModified":false}}
