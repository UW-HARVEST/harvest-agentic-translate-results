{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01LpMdLJwB4ugbQduAVRpJAr","type":"tool_result","content":"1\t//! Shared differential drivers: compile a pattern in BOTH libraries and compare\n2\t//! every observable — errorcode, erroroffset, all `pattern_info` fields, the\n3\t//! serialized bytecode byte-for-byte — then match and compare rc / ovector /\n4\t//! mark / startchar.\n5\t//!\n6\t//! Available to all test binaries as `common::diff`.\n7\t#![allow(dead_code)]\n8\t\n9\tuse super::*;\n10\tuse std::ffi::c_void;\n11\t\n12\t// ---------------------------------------------------------------- constants\n13\tpub const PCRE2_ANCHORED: u32 = 0x8000_0000;\n14\tpub const PCRE2_NO_UTF_CHECK: u32 = 0x4000_0000;\n15\tpub const PCRE2_ENDANCHORED: u32 = 0x2000_0000;\n16\t\n17\tpub const PCRE2_ALLOW_EMPTY_CLASS: u32 = 0x0000_0001;\n18\tpub const PCRE2_ALT_BSUX: u32 = 0x0000_0002;\n19\tpub const PCRE2_AUTO_CALLOUT: u32 = 0x0000_0004;\n20\tpub const PCRE2_CASELESS: u32 = 0x0000_0008;\n21\tpub const PCRE2_DOLLAR_ENDONLY: u32 = 0x0000_0010;\n22\tpub const PCRE2_DOTALL: u32 = 0x0000_0020;\n23\tpub const PCRE2_DUPNAMES: u32 = 0x0000_0040;\n24\tpub const PCRE2_EXTENDED: u32 = 0x0000_0080;\n25\tpub const PCRE2_FIRSTLINE: u32 = 0x0000_0100;\n26\tpub const PCRE2_MATCH_UNSET_BACKREF: u32 = 0x0000_0200;\n27\tpub const PCRE2_MULTILINE: u32 = 0x0000_0400;\n28\tpub const PCRE2_NEVER_UCP: u32 = 0x0000_0800;\n29\tpub const PCRE2_NEVER_UTF: u32 = 0x0000_1000;\n30\tpub const PCRE2_NO_AUTO_CAPTURE: u32 = 0x0000_2000;\n31\tpub const PCRE2_NO_AUTO_POSSESS: u32 = 0x0000_4000;\n32\tpub const PCRE2_NO_DOTSTAR_ANCHOR: u32 = 0x0000_8000;\n33\tpub const PCRE2_NO_START_OPTIMIZE: u32 = 0x0001_0000;\n34\tpub const PCRE2_UCP: u32 = 0x0002_0000;\n35\tpub const PCRE2_UNGREEDY: u32 = 0x0004_0000;\n36\tpub const PCRE2_UTF: u32 = 0x0008_0000;\n37\tpub const PCRE2_NEVER_BACKSLASH_C: u32 = 0x0010_0000;\n38\tpub const PCRE2_ALT_CIRCUMFLEX: u32 = 0x0020_0000;\n39\tpub const PCRE2_ALT_VERBNAMES: u32 = 0x0040_0000;\n40\tpub const PCRE2_USE_OFFSET_LIMIT: u32 = 0x0080_0000;\n41\tpub const PCRE2_EXTENDED_MORE: u32 = 0x0100_0000;\n42\tpub const PCRE2_LITERAL: u32 = 0x0200_0000;\n43\tpub const PCRE2_MATCH_INVALID_UTF: u32 = 0x0400_0000;\n44\tpub const PCRE2_ALT_EXTENDED_CLASS: u32 = 0x0800_0000;\n45\t\n46\tpub const PCRE2_EXTRA_ALLOW_SURROGATE_ESCAPES: u32 = 0x0000_0001;\n47\tpub const PCRE2_EXTRA_BAD_ESCAPE_IS_LITERAL: u32 = 0x0000_0002;\n48\tpub const PCRE2_EXTRA_MATCH_WORD: u32 = 0x0000_0004;\n49\tpub const PCRE2_EXTRA_MATCH_LINE: u32 = 0x0000_0008;\n50\tpub const PCRE2_EXTRA_ESCAPED_CR_IS_LF: u32 = 0x0000_0010;\n51\tpub const PCRE2_EXTRA_ALT_BSUX: u32 = 0x0000_0020;\n52\tpub const PCRE2_EXTRA_ALLOW_LOOKAROUND_BSK: u32 = 0x0000_0040;\n53\tpub const PCRE2_EXTRA_CASELESS_RESTRICT: u32 = 0x0000_0080;\n54\tpub const PCRE2_EXTRA_ASCII_BSD: u32 = 0x0000_0100;\n55\tpub const PCRE2_EXTRA_ASCII_BSS: u32 = 0x0000_0200;\n56\tpub const PCRE2_EXTRA_ASCII_BSW: u32 = 0x0000_0400;\n57\tpub const PCRE2_EXTRA_ASCII_POSIX: u32 = 0x0000_0800;\n58\tpub const PCRE2_EXTRA_ASCII_DIGIT: u32 = 0x0000_1000;\n59\tpub const PCRE2_EXTRA_PYTHON_OCTAL: u32 = 0x0000_2000;\n60\tpub const PCRE2_EXTRA_NO_BS0: u32 = 0x0000_4000;\n61\tpub const PCRE2_EXTRA_NEVER_CALLOUT: u32 = 0x0000_8000;\n62\tpub const PCRE2_EXTRA_TURKISH_CASING: u32 = 0x0001_0000;\n63\t\n64\tpub const PCRE2_NOTBOL: u32 = 0x0000_0001;\n65\tpub const PCRE2_NOTEOL: u32 = 0x0000_0002;\n66\tpub const PCRE2_NOTEMPTY: u32 = 0x0000_0004;\n67\tpub const PCRE2_NOTEMPTY_ATSTART: u32 = 0x0000_0008;\n68\tpub const PCRE2_PARTIAL_SOFT: u32 = 0x0000_0010;\n69\tpub const PCRE2_PARTIAL_HARD: u32 = 0x0000_0020;\n70\tpub const PCRE2_DFA_RESTART: u32 = 0x0000_0040;\n71\tpub const PCRE2_DFA_SHORTEST: u32 = 0x0000_0080;\n72\tpub const PCRE2_SUBSTITUTE_GLOBAL: u32 = 0x0000_0100;\n73\tpub const PCRE2_SUBSTITUTE_EXTENDED: u32 = 0x0000_0200;\n74\tpub const PCRE2_SUBSTITUTE_UNSET_EMPTY: u32 = 0x0000_0400;\n75\tpub const PCRE2_SUBSTITUTE_UNKNOWN_UNSET: u32 = 0x0000_0800;\n76\tpub const PCRE2_SUBSTITUTE_OVERFLOW_LENGTH: u32 = 0x0000_1000;\n77\tpub const PCRE2_NO_JIT: u32 = 0x0000_2000;\n78\tpub const PCRE2_COPY_MATCHED_SUBJECT: u32 = 0x0000_4000;\n79\tpub const PCRE2_SUBSTITUTE_LITERAL: u32 = 0x0000_8000;\n80\tpub const PCRE2_SUBSTITUTE_MATCHED: u32 = 0x0001_0000;\n81\tpub const PCRE2_SUBSTITUTE_REPLACEMENT_ONLY: u32 = 0x0002_0000;\n82\tpub const PCRE2_DISABLE_RECURSELOOP_CHECK: u32 = 0x0004_0000;\n83\t\n84\tpub const PCRE2_CONVERT_UTF: u32 = 0x0000_0001;\n85\tpub const PCRE2_CONVERT_NO_UTF_CHECK: u32 = 0x0000_0002;\n86\tpub const PCRE2_CONVERT_POSIX_BASIC: u32 = 0x0000_0004;\n87\tpub const PCRE2_CONVERT_POSIX_EXTENDED: u32 = 0x0000_0008;\n88\tpub const PCRE2_CONVERT_GLOB: u32 = 0x0000_0010;\n89\tpub const PCRE2_CONVERT_GLOB_NO_WILD_SEPARATOR: u32 = 0x0000_0030;\n90\tpub const PCRE2_CONVERT_GLOB_NO_STARSTAR: u32 = 0x0000_0050;\n91\t\n92\tpub const PCRE2_ZERO_TERMINATED: usize = usize::MAX;\n93\tpub const PCRE2_UNSET: usize = usize::MAX;\n94\t\n95\t// newline conventions\n96\tpub const NL_CR: u32 = 1;\n97\tpub const NL_LF: u32 = 2;\n98\tpub const NL_CRLF: u32 = 3;\n99\tpub const NL_ANY: u32 = 4;\n100\tpub const NL_ANYCRLF: u32 = 5;\n101\tpub const NL_NUL: u32 = 6;\n102\tpub const ALL_NEWLINES: [u32; 6] = [NL_CR, NL_LF, NL_CRLF, NL_ANY, NL_ANYCRLF, NL_NUL];\n103\t\n104\t// bsr conventions\n105\tpub const BSR_UNICODE: u32 = 1;\n106\tpub const BSR_ANYCRLF: u32 = 2;\n107\t\n108\t// error codes used in assertions\n109\tpub const ERR_NOMATCH: i32 = -1;\n110\tpub const ERR_PARTIAL: i32 = -2;\n111\tpub const ERR_NULL: i32 = -51;\n112\tpub const ERR_BADDATA: i32 = -29;\n113\tpub const ERR_BADMAGIC: i32 = -31;\n114\tpub const ERR_BADOPTION: i32 = -34;\n115\tpub const ERR_BADOFFSET: i32 = -33;\n116\tpub const ERR_NOMEMORY: i32 = -48;\n117\tpub const ERR_NOSUBSTRING: i32 = -49;\n118\tpub const ERR_NOUNIQUESUBSTRING: i32 = -50;\n119\tpub const ERR_UNSET: i32 = -55;\n120\tpub const ERR_BADOFFSETLIMIT: i32 = -56;\n121\tpub const ERR_JIT_BADOPTION: i32 = -45;\n122\tpub const ERR_UNAVAILABLE: i32 = -54;\n123\t\n124\t/// All `pattern_info` selectors that return a scalar, with the size of the\n125\t/// value they write. `NAMETABLE` (19) and `FIRSTBITMAP` (7) return pointers and\n126\t/// are handled separately.\n127\tpub const INFO_U32: [u32; 21] = [\n128\t    0, 1, 2, 3, 4, 5, 6, 8, 9, 10, 11, 12, 13, 14, 15, 17, 18, 20, 21, 23, 26,\n129\t];\n130\tpub const INFO_SIZE_T: [u32; 3] = [16, 22, 24]; // MINLENGTH is u32 actually\n131\tpub const INFO_HEAPLIMIT: u32 = 25;\n132\t\n133\t// ------------------------------------------------------- compile-side config\n134\t/// A full compile-time configuration: the option words plus every compile\n135\t/// context setting the C code branches on.\n136\t#[derive(Clone, Debug, Default)]\n137\tpub struct CompileCfg {\n138\t    pub options: u32,\n139\t    pub extra_options: u32,\n140\t    pub newline: Option<u32>,\n141\t    pub bsr: Option<u32>,\n142\t    pub max_pattern_length: Option<usize>,\n143\t    pub max_pattern_compiled_length: Option<usize>,\n144\t    pub max_varlookbehind: Option<u32>,\n145\t    pub parens_nest_limit: Option<u32>,\n146\t    pub optimize: Option<u32>,\n147\t    /// use `pcre2_maketables()` output instead of the built-in default tables\n148\t    pub own_tables: bool,\n149\t}\n150\t\n151\timpl CompileCfg {\n152\t    pub fn new(options: u32) -> Self {\n153\t        CompileCfg { options, ..Default::default() }\n154\t    }\n155\t    pub fn extra(mut self, e: u32) -> Self {\n156\t        self.extra_options = e;\n157\t        self\n158\t    }\n159\t    pub fn newline(mut self, n: u32) -> Self {\n160\t        self.newline = Some(n);\n161\t        self\n162\t    }\n163\t    pub fn bsr(mut self, b: u32) -> Self {\n164\t        self.bsr = Some(b);\n165\t        self\n166\t    }\n167\t    pub fn varlookbehind(mut self, n: u32) -> Self {\n168\t        self.max_varlookbehind = Some(n);\n169\t        self\n170\t    }\n171\t    pub fn parens_nest(mut self, n: u32) -> Self {\n172\t        self.parens_nest_limit = Some(n);\n173\t        self\n174\t    }\n175\t    pub fn max_len(mut self, n: usize) -> Self {\n176\t        self.max_pattern_length = Some(n);\n177\t        self\n178\t    }\n179\t    pub fn max_compiled(mut self, n: usize) -> Self {\n180\t        self.max_pattern_compiled_length = Some(n);\n181\t        self\n182\t    }\n183\t    pub fn optimize(mut self, n: u32) -> Self {\n184\t        self.optimize = Some(n);\n185\t        self\n186\t    }\n187\t    pub fn own_tables(mut self) -> Self {\n188\t        self.own_tables = true;\n189\t        self\n190\t    }\n191\t    pub fn needs_context(&self) -> bool {\n192\t        self.extra_options != 0\n193\t            || self.newline.is_some()\n194\t            || self.bsr.is_some()\n195\t            || self.max_pattern_length.is_some()\n196\t            || self.max_pattern_compiled_length.is_some()\n197\t            || self.max_varlookbehind.is_some()\n198\t            || self.parens_nest_limit.is_some()\n199\t            || self.optimize.is_some()\n200\t            || self.own_tables\n201\t    }\n202\t}\n203\t\n204\t/// Build the compile context for `cfg` in `api`'s library (NULL if not needed).\n205\t/// Returns `(ccontext, tables_to_free)`.\n206\tpub unsafe fn make_ccontext(\n207\t    api: &Api,\n208\t    cfg: &CompileCfg,\n209\t) -> (*mut c_void, *const u8) {\n210\t    if !cfg.needs_context() {\n211\t        return (std::ptr::null_mut(), std::ptr::null());\n212\t    }\n213\t    let cx = (api.compile_context_create)(std::ptr::null_mut());\n214\t    assert!(!cx.is_null(), \"{}: compile_context_create failed\", api.name);\n215\t    let mut tables = std::ptr::null();\n216\t    if cfg.extra_options != 0 {\n217\t        (api.set_compile_extra_options)(cx, cfg.extra_options);\n218\t    }\n219\t    if let Some(n) = cfg.newline {\n220\t        (api.set_newline)(cx, n);\n221\t    }\n222\t    if let Some(b) = cfg.bsr {\n223\t        (api.set_bsr)(cx, b);\n224\t    }\n225\t    if let Some(n) = cfg.max_pattern_length {\n226\t        (api.set_max_pattern_length)(cx, n);\n227\t    }\n228\t    if let Some(n) = cfg.max_pattern_compiled_length {\n229\t        (api.set_max_pattern_compiled_length)(cx, n);\n230\t    }\n231\t    if let Some(n) = cfg.max_varlookbehind {\n232\t        (api.set_max_varlookbehind)(cx, n);\n233\t    }\n234\t    if let Some(n) = cfg.parens_nest_limit {\n235\t        (api.set_parens_nest_limit)(cx, n);\n236\t    }\n237\t    if let Some(n) = cfg.optimize {\n238\t        (api.set_optimize)(cx, n);\n239\t    }\n240\t    if cfg.own_tables {\n241\t        tables = (api.maketables)(std::ptr::null_mut());\n242\t        assert!(!tables.is_null());\n243\t        (api.set_character_tables)(cx, tables);\n244\t    }\n245\t    (cx, tables)\n246\t}\n247\t\n248\t/// Result of compiling in one library.\n249\tpub struct Compiled {\n250\t    pub api: &'static Api,\n251\t    pub code: *mut c_void,\n252\t    pub errorcode: i32,\n253\t    pub erroroffset: usize,\n254\t    ccontext: *mut c_void,\n255\t    tables: *const u8,\n256\t}\n257\t\n258\timpl Drop for Compiled {\n259\t    fn drop(&mut self) {\n260\t        unsafe {\n261\t            if !self.code.is_null() {\n262\t                (self.api.code_free)(self.code);\n263\t            }\n264\t            if !self.ccontext.is_null() {\n265\t                (self.api.compile_context_free)(self.ccontext);\n266\t            }\n267\t            if !self.tables.is_null() {\n268\t                (self.api.maketables_free)(std::ptr::null_mut(), self.tables);\n269\t            }\n270\t        }\n271\t    }\n272\t}\n273\t\n274\tpub unsafe fn compile_in(\n275\t    api: &'static Api,\n276\t    pattern: &[u8],\n277\t    patlen: usize,\n278\t    cfg: &CompileCfg,\n279\t) -> Compiled {\n280\t    let (cx, tables) = make_ccontext(api, cfg);\n281\t    let mut ec = 0i32;\n282\t    let mut eo = usize::MAX;\n283\t    let code = (api.compile)(\n284\t        pattern.as_ptr(),\n285\t        patlen,\n286\t        cfg.options,\n287\t        &mut ec,\n288\t        &mut eo,\n289\t        cx,\n290\t    );\n291\t    Compiled { api, code, errorcode: ec, erroroffset: eo, ccontext: cx, tables }\n292\t}\n293\t\n294\t/// Serialize one compiled code and return its bytes — this exposes the whole\n295\t/// compiled bytecode block, so comparing it catches ANY codegen divergence.\n296\tpub unsafe fn serialized_bytes(api: &Api, code: *mut c_void) -> Option<Vec<u8>> {\n297\t    let codes = [code as *const c_void];\n298\t    let mut buf: *mut u8 = std::ptr::null_mut();\n299\t    let mut len = 0usize;\n300\t    let rc = (api.serialize_encode)(\n301\t        codes.as_ptr(),\n302\t        1,\n303\t        &mut buf,\n304\t        &mut len,\n305\t        std::ptr::null_mut(),\n306\t    );\n307\t    if rc != 1 {\n308\t        return None;\n309\t    }\n310\t    let v = std::slice::from_raw_parts(buf, len).to_vec();\n311\t    (api.serialize_free)(buf);\n312\t    Some(v)\n313\t}\n314\t\n315\t/// Compare every `pattern_info` field between two compiled codes.\n316\tpub unsafe fn assert_pattern_info_eq(\n317\t    cc: *mut c_void,\n318\t    rc_: *mut c_void,\n319\t    label: &str,\n320\t) {\n321\t    let (c, r) = both();\n322\t    for what in INFO_U32 {\n323\t        let mut cv: u32 = 0xDEAD_BEEF;\n324\t        let mut rv: u32 = 0xDEAD_BEEF;\n325\t        let crc = (c.pattern_info)(cc, what, &mut cv as *mut _ as *mut c_void);\n326\t        let rrc = (r.pattern_info)(rc_, what, &mut rv as *mut _ as *mut c_void);\n327\t        assert_eq!(crc, rrc, \"{}: pattern_info({}) rc\", label, what);\n328\t        if crc == 0 {\n329\t            assert_eq!(cv, rv, \"{}: pattern_info({}) value\", label, what);\n330\t        }\n331\t    }\n332\t    for what in [16u32, 22, 24, 25] {\n333\t        // MINLENGTH(16)=u32, SIZE(22)=PCRE2_SIZE, FRAMESIZE(24)=PCRE2_SIZE,\n334\t        // HEAPLIMIT(25)=u32 — use a usize buffer, which is large enough for all\n335\t        let mut cv: usize = 0xDEAD_BEEF;\n336\t        let mut rv: usize = 0xDEAD_BEEF;\n337\t        let crc = (c.pattern_info)(cc, what, &mut cv as *mut _ as *mut c_void);\n338\t        let rrc = (r.pattern_info)(rc_, what, &mut rv as *mut _ as *mut c_void);\n339\t        assert_eq!(crc, rrc, \"{}: pattern_info({}) rc\", label, what);\n340\t        if crc == 0 {\n341\t            assert_eq!(cv, rv, \"{}: pattern_info({}) value\", label, what);\n342\t        }\n343\t    }\n344\t    // FIRSTBITMAP (7) returns a pointer to a 32-byte bitmap or NULL\n345\t    {\n346\t        let mut cp: *const u8 = std::ptr::null();\n347\t        let mut rp: *const u8 = std::ptr::null();\n348\t        let crc = (c.pattern_info)(cc, 7, &mut cp as *mut _ as *mut c_void);\n349\t        let rrc = (r.pattern_info)(rc_, 7, &mut rp as *mut _ as *mut c_void);\n350\t        assert_eq!(crc, rrc, \"{}: pattern_info(FIRSTBITMAP) rc\", label);\n351\t        assert_eq!(\n352\t            cp.is_null(),\n353\t            rp.is_null(),\n354\t            \"{}: FIRSTBITMAP nullness\",\n355\t            label\n356\t        );\n357\t        if !cp.is_null() {\n358\t            let cs = std::slice::from_raw_parts(cp, 32);\n359\t            let rs = std::slice::from_raw_parts(rp, 32);\n360\t            assert_eq!(cs, rs, \"{}: FIRSTBITMAP bytes\", label);\n361\t        }\n362\t    }\n363\t    // NAMETABLE (19) + NAMECOUNT (17) + NAMEENTRYSIZE (18)\n364\t    {\n365\t        let mut cnt: u32 = 0;\n366\t        let mut esz: u32 = 0;\n367\t        let mut cp: *const u8 = std::ptr::null();\n368\t        let mut rp: *const u8 = std::ptr::null();\n369\t        (c.pattern_info)(cc, 17, &mut cnt as *mut _ as *mut c_void);\n370\t        (c.pattern_info)(cc, 18, &mut esz as *mut _ as *mut c_void);\n371\t        let crc = (c.pattern_info)(cc, 19, &mut cp as *mut _ as *mut c_void);\n372\t        let rrc = (r.pattern_info)(rc_, 19, &mut rp as *mut _ as *mut c_void);\n373\t        assert_eq!(crc, rrc, \"{}: pattern_info(NAMETABLE) rc\", label);\n374\t        if cnt > 0 {\n375\t            let n = (cnt * esz) as usize;\n376\t            let cs = std::slice::from_raw_parts(cp, n);\n377\t            let rs = std::slice::from_raw_parts(rp, n);\n378\t            assert_eq!(cs, rs, \"{}: NAMETABLE bytes\", label);\n379\t        }\n380\t    }\n381\t}\n382\t\n383\t/// Compile `pattern` in both libraries and assert full agreement.\n384\t/// Returns `(c_compiled, r_compiled)` so the caller can go on to match.\n385\tpub unsafe fn compile_both(\n386\t    pattern: &[u8],\n387\t    patlen: usize,\n388\t    cfg: &CompileCfg,\n389\t    label: &str,\n390\t) -> (Compiled, Compiled) {\n391\t    let (c, r) = both();\n392\t    let cc = compile_in(c, pattern, patlen, cfg);\n393\t    let rr = compile_in(r, pattern, patlen, cfg);\n394\t\n395\t    assert_eq!(\n396\t        cc.code.is_null(),\n397\t        rr.code.is_null(),\n398\t        \"{}: compile success differs (C ec={} eo={}, Rust ec={} eo={}) pattern={:?} cfg={:?}\",\n399\t        label,\n400\t        cc.errorcode,\n401\t        cc.erroroffset,\n402\t        rr.errorcode,\n403\t        rr.erroroffset,\n404\t        String::from_utf8_lossy(pattern),\n405\t        cfg\n406\t    );\n407\t\n408\t    if cc.code.is_null() {\n409\t        assert_eq!(\n410\t            cc.errorcode, rr.errorcode,\n411\t            \"{}: errorcode differs for pattern={:?} cfg={:?}\",\n412\t            label,\n413\t            String::from_utf8_lossy(pattern),\n414\t            cfg\n415\t        );\n416\t        assert_eq!(\n417\t            cc.erroroffset, rr.erroroffset,\n418\t            \"{}: erroroffset differs (ec={}) for pattern={:?} cfg={:?}\",\n419\t            label,\n420\t            cc.errorcode,\n421\t            String::from_utf8_lossy(pattern),\n422\t            cfg\n423\t        );\n424\t        // the human-readable message must match too\n425\t        let mut cb = [0u8; 256];\n426\t        let mut rb = [0u8; 256];\n427\t        let cn = (c.get_error_message)(cc.errorcode, cb.as_mut_ptr(), 256);\n428\t        let rn = (r.get_error_message)(rr.errorcode, rb.as_mut_ptr(), 256);\n429\t        assert_eq!(cn, rn, \"{}: error message length\", label);\n430\t        assert_eq!(cb, rb, \"{}: error message text\", label);\n431\t        return (cc, rr);\n432\t    }\n433\t\n434\t    assert_pattern_info_eq(cc.code, rr.code, label);\n435\t\n436\t    // Strongest check: the entire compiled bytecode block, byte for byte.\n437\t    let cb = serialized_bytes(c, cc.code);\n438\t    let rb = serialized_bytes(r, rr.code);\n439\t    match (&cb, &rb) {\n440\t        (Some(cv), Some(rv)) => {\n441\t            assert_eq!(\n442\t                cv.len(),\n443\t                rv.len(),\n444\t                \"{}: serialized length differs for pattern={:?} cfg={:?}\",\n445\t                label,\n446\t                String::from_utf8_lossy(pattern),\n447\t                cfg\n448\t            );\n449\t            if cv != rv {\n450\t                let i = cv.iter().zip(rv.iter()).position(|(a, b)| a != b).unwrap();\n451\t                panic!(\n452\t                    \"{}: serialized bytecode differs at byte {} (C={:#04x} Rust={:#04x})\\n\\\n453\t                     pattern={:?} cfg={:?}\\n C[{}..]={:02x?}\\n R[{}..]={:02x?}\",\n454\t                    label,\n455\t                    i,\n456\t                    cv[i],\n457\t                    rv[i],\n458\t                    String::from_utf8_lossy(pattern),\n459\t                    cfg,\n460\t                    i,\n461\t                    &cv[i..(i + 24).min(cv.len())],\n462\t                    i,\n463\t                    &rv[i..(i + 24).min(rv.len())],\n464\t                );\n465\t            }\n466\t        }\n467\t        (None, None) => {}\n468\t        _ => panic!(\"{}: serialize_encode succeeded in only one library\", label),\n469\t    }\n470\t\n471\t    (cc, rr)\n472\t}\n473\t\n474\t// --------------------------------------------------------- match-side config\n475\t#[derive(Clone, Debug, Default)]\n476\tpub struct MatchCfg {\n477\t    pub options: u32,\n478\t    pub match_limit: Option<u32>,\n479\t    pub depth_limit: Option<u32>,\n480\t    pub heap_limit: Option<u32>,\n481\t    pub offset_limit: Option<usize>,\n482\t    /// ovector pair count for `match_data_create`; `None` = from pattern\n483\t    pub ovecsize: Option<u32>,\n484\t}\n485\t\n486\timpl MatchCfg {\n487\t    pub fn new(options: u32) -> Self {\n488\t        MatchCfg { options, ..Default::default() }\n489\t    }\n490\t    pub fn ovec(mut self, n: u32) -> Self {\n491\t        self.ovecsize = Some(n);\n492\t        self\n493\t    }\n494\t    pub fn match_limit(mut self, n: u32) -> Self {\n495\t        self.match_limit = Some(n);\n496\t        self\n497\t    }\n498\t    pub fn depth_limit(mut self, n: u32) -> Self {\n499\t        self.depth_limit = Some(n);\n500\t        self\n501\t    }\n502\t    pub fn heap_limit(mut self, n: u32) -> Self {\n503\t        self.heap_limit = Some(n);\n504\t        self\n505\t    }\n506\t    pub fn offset_limit(mut self, n: usize) -> Self {\n507\t        self.offset_limit = Some(n);\n508\t        self\n509\t    }\n510\t    pub fn needs_context(&self) -> bool {\n511\t        self.match_limit.is_some()\n512\t            || self.depth_limit.is_some()\n513\t            || self.heap_limit.is_some()\n514\t            || self.offset_limit.is_some()\n515\t    }\n516\t}\n517\t\n518\tpub unsafe fn make_mcontext(api: &Api, cfg: &MatchCfg) -> *mut c_void {\n519\t    if !cfg.needs_context() {\n520\t        return std::ptr::null_mut();\n521\t    }\n522\t    let cx = (api.match_context_create)(std::ptr::null_mut());\n523\t    assert!(!cx.is_null());\n524\t    if let Some(n) = cfg.match_limit {\n525\t        (api.set_match_limit)(cx, n);\n526\t    }\n527\t    if let Some(n) = cfg.depth_limit {\n528\t        (api.set_depth_limit)(cx, n);\n529\t    }\n530\t    if let Some(n) = cfg.heap_limit {\n531\t        (api.set_heap_limit)(cx, n);\n532\t    }\n533\t    if let Some(n) = cfg.offset_limit {\n534\t        (api.set_offset_limit)(cx, n);\n535\t    }\n536\t    cx\n537\t}\n538\t\n539\t/// Everything observable after a match.\n540\t#[derive(Debug, PartialEq, Eq)]\n541\tpub struct MatchOut {\n542\t    pub rc: i32,\n543\t    pub ovector: Vec<usize>,\n544\t    pub ovec_count: u32,\n545\t    pub startchar: usize,\n546\t    pub mark: Option<Vec<u8>>,\n547\t}\n548\t\n549\t/// Which matcher to drive.\n550\t#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n551\tpub enum Engine {\n552\t    Interpreter,\n553\t    Dfa,\n554\t    /// `pcre2_jit_match` — with JIT unsupported this must fail identically\n555\t    JitMatch,\n556\t}\n557\t\n558\tpub unsafe fn run_match(\n559\t    api: &Api,\n560\t    code: *mut c_void,\n561\t    subject: &[u8],\n562\t    subjlen: usize,\n563\t    startoffset: usize,\n564\t    cfg: &MatchCfg,\n565\t    engine: Engine,\n566\t) -> MatchOut {\n567\t    let mcx = make_mcontext(api, cfg);\n568\t    let md = match cfg.ovecsize {\n569\t        Some(n) => (api.match_data_create)(n, std::ptr::null_mut()),\n570\t        None => (api.match_data_create_from_pattern)(code, std::ptr::null_mut()),\n571\t    };\n572\t    assert!(!md.is_null(), \"{}: match_data_create failed\", api.name);\n573\t\n574\t    let rc = match engine {\n575\t        Engine::Interpreter => (api.do_match)(\n576\t            code,\n577\t            subject.as_ptr(),\n578\t            subjlen,\n579\t            startoffset,\n580\t            cfg.options,\n581\t            md,\n582\t            mcx,\n583\t        ),\n584\t        Engine::JitMatch => (api.jit_match)(\n585\t            code,\n586\t            subject.as_ptr(),\n587\t            subjlen,\n588\t            startoffset,\n589\t            cfg.options,\n590\t            md,\n591\t            mcx,\n592\t        ),\n593\t        Engine::Dfa => {\n594\t            let mut wspace = [0i32; 1000];\n595\t            (api.dfa_match)(\n596\t                code,\n597\t                subject.as_ptr(),\n598\t                subjlen,\n599\t                startoffset,\n600\t                cfg.options,\n601\t                md,\n602\t                mcx,\n603\t                wspace.as_mut_ptr(),\n604\t                wspace.len(),\n605\t            )\n606\t        }\n607\t    };\n608\t\n609\t    let count = (api.get_ovector_count)(md);\n610\t    let ovp = (api.get_ovector_pointer)(md);\n611\t    // Only entries that PCRE2 actually DEFINES may be compared; the rest are\n612\t    // uninitialised heap and differ run-to-run even between two runs of the\n613\t    // same library.\n614\t    //   rc > 0  -> pairs 0..rc are set (unused capture slots are set to UNSET)\n615\t    //   rc == 0 -> the ovector was too small, so every pair was filled\n616\t    //   rc == PCRE2_ERROR_PARTIAL -> pair 0 holds the partial match\n617\t    //   any other rc -> nothing is defined\n618\t    let defined_pairs: usize = if rc > 0 {\n619\t        (rc as usize).min(count as usize)\n620\t    } else if rc == 0 {\n621\t        count as usize\n622\t    } else if rc == ERR_PARTIAL {\n623\t        1.min(count as usize)\n624\t    } else {\n625\t        0\n626\t    };\n627\t    let ovector = if ovp.is_null() {\n628\t        Vec::new()\n629\t    } else {\n630\t        std::slice::from_raw_parts(ovp, defined_pairs * 2).to_vec()\n631\t    };\n632\t    // startchar is only meaningful after a match or a partial match.\n633\t    let startchar = if rc >= 0 || rc == ERR_PARTIAL {\n634\t        (api.get_startchar)(md)\n635\t    } else {\n636\t        0\n637\t    };\n638\t    let markp = (api.get_mark)(md);\n639\t    let mark = if markp.is_null() {\n640\t        None\n641\t    } else {\n642\t        // mark is a zero-terminated string in the subject/pattern\n643\t        let mut v = Vec::new();\n644\t        let mut p = markp;\n645\t        while *p != 0 {\n646\t            v.push(*p);\n647\t            p = p.add(1);\n648\t        }\n649\t        Some(v)\n650\t    };\n651\t\n652\t    (api.match_data_free)(md);\n653\t    if !mcx.is_null() {\n654\t        (api.match_context_free)(mcx);\n655\t    }\n656\t    MatchOut { rc, ovector, ovec_count: count, startchar, mark }\n657\t}\n658\t\n659\t/// Match in both libraries and assert full agreement.\n660\tpub unsafe fn assert_match_eq(\n661\t    cc: &Compiled,\n662\t    rr: &Compiled,\n663\t    subject: &[u8],\n664\t    subjlen: usize,\n665\t    startoffset: usize,\n666\t    cfg: &MatchCfg,\n667\t    engine: Engine,\n668\t    label: &str,\n669\t) {\n670\t    let co = run_match(cc.api, cc.code, subject, subjlen, startoffset, cfg, engine);\n671\t    let ro = run_match(rr.api, rr.code, subject, subjlen, startoffset, cfg, engine);\n672\t    assert_eq!(\n673\t        co.rc, ro.rc,\n674\t        \"{}: {:?} rc differs (C={} Rust={}) subject={:?} start={} cfg={:?}\",\n675\t        label, engine, co.rc, ro.rc, String::from_utf8_lossy(subject), startoffset, cfg\n676\t    );\n677\t    assert_eq!(\n678\t        co.ovec_count, ro.ovec_count,\n679\t        \"{}: {:?} ovector count differs\",\n680\t        label, engine\n681\t    );\n682\t    assert_eq!(\n683\t        co.ovector, ro.ovector,\n684\t        \"{}: {:?} ovector differs (rc={}) subject={:?} start={} cfg={:?}\",\n685\t        label, engine, co.rc, String::from_utf8_lossy(subject), startoffset, cfg\n686\t    );\n687\t    assert_eq!(\n688\t        co.startchar, ro.startchar,\n689\t        \"{}: {:?} startchar differs subject={:?}\",\n690\t        label, engine, String::from_utf8_lossy(subject)\n691\t    );\n692\t    assert_eq!(\n693\t        co.mark, ro.mark,\n694\t        \"{}: {:?} mark differs subject={:?}\",\n695\t        label, engine, String::from_utf8_lossy(subject)\n696\t    );\n697\t}\n698\t\n699\t/// The whole pipeline: compile in both, then match every subject with both\n700\t/// engines and assert agreement throughout.\n701\tpub unsafe fn diff_compile_and_match(\n702\t    pattern: &[u8],\n703\t    cfg: &CompileCfg,\n704\t    subjects: &[&[u8]],\n705\t    mcfg: &MatchCfg,\n706\t    engines: &[Engine],\n707\t    label: &str,\n708\t) {\n709\t    let (cc, rr) = compile_both(pattern, pattern.len(), cfg, label);\n710\t    if cc.code.is_null() {\n711\t        return;\n712\t    }\n713\t    for subj in subjects {\n714\t        for &engine in engines {\n715\t            for &start in &[0usize, subj.len() / 2, subj.len()] {\n716\t                if start > subj.len() {\n717\t                    continue;\n718\t                }\n719\t                assert_match_eq(\n720\t                    &cc, &rr, subj, subj.len(), start, mcfg, engine, label,\n721\t                );\n722\t            }\n723\t        }\n724\t    }\n725\t}\n726\t"}]},"parent_tool_use_id":"toolu_bdrk_01LJS2khJyuSbXBnrYHH9FSr","session_id":"f125a214-542c-4276-b4c6-bfe5147344e3","uuid":"3d7a7d04-02f3-4da9-852b-eeb92ff99ccd","timestamp":"2026-09-04T04:54:18.272Z","subagent_type":"general-purpose","task_description":"Write substring/serialize diff tests"}
