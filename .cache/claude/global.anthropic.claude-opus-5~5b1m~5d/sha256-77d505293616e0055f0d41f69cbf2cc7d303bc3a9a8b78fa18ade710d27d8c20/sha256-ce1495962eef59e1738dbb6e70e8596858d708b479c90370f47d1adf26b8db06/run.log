{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_013eNwCgsGTC4bEPWXikyPmo","type":"tool_result","content":"1\t//! Phase C — error-path differential tests for `ERRORS.md` sections\n2\t//! A (`pcre2_compile_8` argument/option/context validation),\n3\t//! H (contexts and `pcre2_set_*`),\n4\t//! I (`pcre2_config_8`) and\n5\t//! J (`pcre2_pattern_info_8` / `pcre2_callout_enumerate_8`).\n6\tmod common;\n7\t\n8\tuse common::diff::*;\n9\tuse common::*;\n10\tuse std::ffi::c_void;\n11\t\n12\t// ============================================================ alloc injection\n13\t// A failure-injecting allocator: the Nth allocation returns NULL. Each library\n14\t// gets its own counter so we can ALSO compare how many allocations each made —\n15\t// a faithful translation must allocate the same number of times.\n16\tstatic mut ALLOC_N: [u32; 2] = [0, 0];\n17\tstatic mut ALLOC_FAIL_AT: [u32; 2] = [u32::MAX, u32::MAX];\n18\t\n19\tunsafe extern \"C\" fn inj_malloc_c(n: SIZE, _d: *mut c_void) -> *mut c_void {\n20\t    ALLOC_N[0] += 1;\n21\t    if ALLOC_N[0] >= ALLOC_FAIL_AT[0] {\n22\t        return std::ptr::null_mut();\n23\t    }\n24\t    libc_malloc(n)\n25\t}\n26\tunsafe extern \"C\" fn inj_malloc_r(n: SIZE, _d: *mut c_void) -> *mut c_void {\n27\t    ALLOC_N[1] += 1;\n28\t    if ALLOC_N[1] >= ALLOC_FAIL_AT[1] {\n29\t        return std::ptr::null_mut();\n30\t    }\n31\t    libc_malloc(n)\n32\t}\n33\tunsafe extern \"C\" fn inj_free(p: *mut c_void, _d: *mut c_void) {\n34\t    if !p.is_null() {\n35\t        libc_free(p);\n36\t    }\n37\t}\n38\t\n39\textern \"C\" {\n40\t    #[link_name = \"malloc\"]\n41\t    fn libc_malloc(n: usize) -> *mut c_void;\n42\t    #[link_name = \"free\"]\n43\t    fn libc_free(p: *mut c_void);\n44\t}\n45\t\n46\tfn injector(i: usize) -> unsafe extern \"C\" fn(SIZE, *mut c_void) -> *mut c_void {\n47\t    if i == 0 {\n48\t        inj_malloc_c\n49\t    } else {\n50\t        inj_malloc_r\n51\t    }\n52\t}\n53\t\n54\t// ======================================================== Section A rows 1-26\n55\t/// Row 1: `errorptr == NULL` -> NULL, `*erroroffset = 0`, no code written.\n56\t#[test]\n57\tfn row1_errorptr_null() {\n58\t    let (c, r) = both();\n59\t    unsafe {\n60\t        for pat in [&b\"a\"[..], b\"\", b\"(bad\", b\"a{2,1}\"] {\n61\t            let mut ceo = 0xAAusize;\n62\t            let mut reo = 0xAAusize;\n63\t            let cp = (c.compile)(\n64\t                pat.as_ptr(), pat.len(), 0,\n65\t                std::ptr::null_mut(), &mut ceo, std::ptr::null_mut(),\n66\t            );\n67\t            let rp = (r.compile)(\n68\t                pat.as_ptr(), pat.len(), 0,\n69\t                std::ptr::null_mut(), &mut reo, std::ptr::null_mut(),\n70\t            );\n71\t            assert!(cp.is_null(), \"C must reject errorptr==NULL\");\n72\t            assert!(rp.is_null(), \"Rust must reject errorptr==NULL\");\n73\t            assert_eq!(ceo, reo, \"erroroffset for pattern {:?}\", pat);\n74\t            assert_eq!(ceo, 0, \"C sets *erroroffset = 0\");\n75\t        }\n76\t    }\n77\t}\n78\t\n79\t/// Row 2 / row 146 (ERR120): `erroroffset == NULL`.\n80\t#[test]\n81\tfn row2_erroroffset_null_err120() {\n82\t    let (c, r) = both();\n83\t    unsafe {\n84\t        for pat in [&b\"a\"[..], b\"\", b\"(bad\"] {\n85\t            let mut cec = 0i32;\n86\t            let mut rec = 0i32;\n87\t            let cp = (c.compile)(\n88\t                pat.as_ptr(), pat.len(), 0,\n89\t                &mut cec, std::ptr::null_mut(), std::ptr::null_mut(),\n90\t            );\n91\t            let rp = (r.compile)(\n92\t                pat.as_ptr(), pat.len(), 0,\n93\t                &mut rec, std::ptr::null_mut(), std::ptr::null_mut(),\n94\t            );\n95\t            assert!(cp.is_null() && rp.is_null());\n96\t            assert_eq!(cec, rec, \"errorcode for pattern {:?}\", pat);\n97\t            assert_eq!(cec, 220, \"ERR120 (=220) expected\");\n98\t        }\n99\t    }\n100\t}\n101\t\n102\t/// Rows 3 & 4: `pattern == NULL` with non-zero / zero length.\n103\t#[test]\n104\tfn rows3_4_null_pattern() {\n105\t    let (c, r) = both();\n106\t    unsafe {\n107\t        // row 3: patlen != 0 -> ERR16 (=116)\n108\t        for patlen in [1usize, 2, 100, PCRE2_ZERO_TERMINATED] {\n109\t            let mut cec = 0i32;\n110\t            let mut rec = 0i32;\n111\t            let mut ceo = 0xAAusize;\n112\t            let mut reo = 0xAAusize;\n113\t            let cp = (c.compile)(\n114\t                std::ptr::null(), patlen, 0, &mut cec, &mut ceo, std::ptr::null_mut(),\n115\t            );\n116\t            let rp = (r.compile)(\n117\t                std::ptr::null(), patlen, 0, &mut rec, &mut reo, std::ptr::null_mut(),\n118\t            );\n119\t            assert!(cp.is_null() && rp.is_null(), \"patlen={}\", patlen);\n120\t            assert_eq!(cec, rec, \"errorcode patlen={}\", patlen);\n121\t            assert_eq!(ceo, reo, \"erroroffset patlen={}\", patlen);\n122\t            assert_eq!(cec, 116, \"ERR16 expected for patlen={}\", patlen);\n123\t        }\n124\t        // row 4: patlen == 0 -> SUCCESS (empty pattern)\n125\t        {\n126\t            let mut cec = 0i32;\n127\t            let mut rec = 0i32;\n128\t            let mut ceo = 0usize;\n129\t            let mut reo = 0usize;\n130\t            let cp = (c.compile)(\n131\t                std::ptr::null(), 0, 0, &mut cec, &mut ceo, std::ptr::null_mut(),\n132\t            );\n133\t            let rp = (r.compile)(\n134\t                std::ptr::null(), 0, 0, &mut rec, &mut reo, std::ptr::null_mut(),\n135\t            );\n136\t            assert_eq!(cp.is_null(), rp.is_null(), \"NULL pattern patlen=0 nullness\");\n137\t            assert!(!cp.is_null(), \"C treats NULL/0 as the empty pattern\");\n138\t            assert_pattern_info_eq(cp, rp, \"NULL pattern patlen=0\");\n139\t            let cb = serialized_bytes(c, cp);\n140\t            let rb = serialized_bytes(r, rp);"}]},"parent_tool_use_id":"toolu_bdrk_01