eLock<Api> = OnceLock::new();\n515\tstatic R_API: OnceLock<Api> = OnceLock::new();\n516\t\n517\tpub fn c() -> &'static Api {\n518\t    C_API.get_or_init(|| Api::load(&c_so_path(), \"C\"))\n519\t}\n520\tpub fn r() -> &'static Api {\n521\t    R_API.get_or_init(|| Api::load(&rust_so_path(), \"Rust\"))\n522\t}\n523\t\n524\t/// Both implementations, C first.\n525\tpub fn both() -> (&'static Api, &'static Api) {\n526\t    (c(), r())\n527\t}\n528\t\n529\t// ------------------------------------------------------------------- PRNG\n530\t/// Deterministic xorshift64* PRNG so every run is reproducible.\n531\tpub struct Rng(u64);\n532\t\n533\timpl Rng {\n534\t    pub fn new(seed: u64) -> Rng {\n535\t        Rng(if seed == 0 { 0x9E3779B97F4A7C15 } else { seed })\n536\t    }\n537\t    pub fn next_u64(&mut self) -> u64 {\n538\t        let mut x = self.0;\n539\t        x ^= x >> 12;\n540\t        x ^= x << 25;\n541\t        x ^= x >> 27;\n542\t        self.0 = x;\n543\t        x.wrapping_mul(0x2545F4914F6CDD1D)\n544\t    }\n545\t    pub fn next_u32(&mut self) -> u32 {\n546\t        (self.next_u64() >> 32) as u32\n547\t    }\n548\t    /// Uniform in `[0, n)`.\n549\t    pub fn below(&mut self, n: u32) -> u32 {\n550\t        if n == 0 {\n551\t            0\n552\t        } else {\n553\t            self.next_u32() % n\n554\t        }\n555\t    }\n556\t    pub fn range(&mut self, lo: u32, hi: u32) -> u32 {\n557\t        if hi <= lo {\n558\t            lo\n559\t        } else {\n560\t            lo + self.below(hi - lo)\n561\t        }\n562\t    }\n563\t    pub fn pick<'a, T>(&mut self, xs: &'a [T]) -> &'a T {\n564\t        &xs[self.below(xs.len() as u32) as usize]\n565\t    }\n566\t    pub fn bool(&mut self) -> bool {\n567\t        self.next_u64() & 1 == 1\n568\t    }\n569\t    /// Random byte string of length `len` drawn from `alphabet`.\n570\t    pub fn bytes_from(&mut self, len: usize, alphabet: &[u8]) -> Vec<u8> {\n571\t        (0..len).map(|_| *self.pick(alphabet)).collect()\n572\t 