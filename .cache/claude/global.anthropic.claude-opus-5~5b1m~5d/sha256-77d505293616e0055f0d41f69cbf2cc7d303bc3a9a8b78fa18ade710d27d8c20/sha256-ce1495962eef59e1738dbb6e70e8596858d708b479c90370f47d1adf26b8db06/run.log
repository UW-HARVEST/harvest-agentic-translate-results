n246\t  }\n247\t\n248\treturn number_of_codes;\n249\t\n250\tcleanup:\n251\tif (dst_re != NULL)\n252\t  memctl->free(dst_re, memctl->memory_data);\n253\tmemctl->free(tables, memctl->memory_data);\n254\tfor (j = 0; j < i; j++)\n255\t  {\n256\t  memctl->free(codes[j], memctl->memory_data);\n257\t  codes[j] = NULL;\n258\t  }\n259\treturn error;\n260\t}\n261\t\n262\t\n263\t/*************************************************\n264\t*    Get the number of serialized patterns       *\n265\t*************************************************/\n266\t\n267\tPCRE2_EXP_DEFN int32_t PCRE2_CALL_CONVENTION\n268\tpcre2_serialize_get_number_of_codes(const uint8_t *bytes)\n269\t{\n270\tconst pcre2_serialized_data *data = (const pcre2_serialized_data *)bytes;\n271\t\n272\tif (data == NULL) return PCRE2_ERROR_NULL;\n273\tif (data->magic != SERIALIZED_DATA_MAGIC) return PCRE2_ERROR_BADMAGIC;\n274\tif (data->version != SERIALIZED_DATA_VERSION) return PCRE2_ERROR_BADMODE;\n275\tif (data->config != SERIALIZED_DATA_CONFIG) return PCRE2_ERROR_BADMODE;\n276\t\n277\treturn data->number_of_codes;\n278\t}\n279\t\n280\t\n281\t/*************************************************\n282\t*            Free the allocated stream           *\n283\t*************************************************/\n284\t\n285\tPCRE2_EXP_DEFN void PCRE2_CALL_CONVENTION\n286\tpcre2_serialize_free(uint8_t *bytes)\n287\t{\n288\tif (bytes != NULL)\n289\t  {\n290\t  pcre2_memctl *memctl = (pcre2_memctl *)(bytes - sizeof(pcre2_memctl));\n291\t  memctl->free(memctl, memctl->memory_data);\n292\t  }\n293\t}\n294\t\n295\t/* End of pcre2_serialize.c */\n296\t"}]},"parent_tool_use_id":"toolu_bdrk_01LJS2khJyuSbXBnrYHH9FSr","session_id":"f125a214-542c-4276-b4c6-bfe5147344e3","uuid":"2b1db58d-006b-4e51-9ebb-3786d58d07aa","timestamp":"2026-09-04T04:54:24.048Z","subagent_type":"general-purpose","task_description":"Write substring/serialize diff tests"}
