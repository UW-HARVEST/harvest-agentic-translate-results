{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_014H1yMsCyfXSmqsqPJg5CKR","type":"tool_result","content":"1\t/* checkrt.c - verify _v/err_runtime.tsv against the real PCRE2 library.\n2\t *\n3\t * Build (from the repository root):\n4\t *   cc -O1 -o _v/checkrt _v/checkrt.c -I c_src/include -DPCRE2_CODE_UNIT_WIDTH=8 \\\n5\t *      c_src/build/libpcre2.so -Wl,-rpath,$PWD/c_src/build\n6\t * Run:\n7\t *   _v/checkrt\n8\t *\n9\t * Every reachable row of _v/err_runtime.tsv (267 of the 300 rows) is\n10\t * implemented here, in exactly the same order as those rows.  The 33 rows whose\n11\t * RECIPE field is UNREACHABLE have no code here.\n12\t *\n13\t * One line per checked row:\n14\t *    <function> <expected> <actual> ok|MISMATCH\n15\t *\n16\t * Four of the 271 printed lines are NOT TSV rows; they are corroborating\n17\t * assertions / setup results and can be recognised by their <expected> text:\n18\t *    \"1(1)\"                          - the pcre2_serialize_encode() call that\n19\t *                                      builds the good stream used to test\n20\t *                                      pcre2_serialize_decode()\n21\t *    \"heapframes_size-unchanged(20480)\" (x2)\n22\t *                                    - proves that the two pcre2_match()\n23\t *                                      PCRE2_ERROR_HEAPLIMIT rows really hit\n24\t *                                      pcre2_match.c:778 and :791 (no frame\n25\t *                                      vector growth actually happened)\n26\t *    \"blength-set-to-required(11)\"    - proves that the\n27\t *                                      PCRE2_SUBSTITUTE_OVERFLOW_LENGTH row\n28\t *                                      reports the needed buffer size\n29\t *\n30\t * The recipes that need a failing allocator use a counting allocator\n31\t * (cmalloc/cfree below): a general context is created while the budget is\n32\t * still positive, and the budget is then lowered so that the Nth subsequent\n33\t * allocation fails.  The recipes that need a corrupted compiled pattern locate\n34\t * pcre2_real_code.magic_number by scanning for 0x50435245 (offset 88 on LP64)\n35\t * and derive the flags / name_entry_size / name_count / blocksize offsets from\n36\t * it.\n37\t */\n38\t\n39\t#include <stdio.h>\n40\t#include <stdlib.h>\n41\t#include <string.h>\n42\t#include <stdint.h>\n43\t#include <limits.h>\n44\t\n45\t#define PCRE2_CODE_UNIT_WIDTH 8\n46\t#include <pcre2.h>\n47\t\n48\t/* ------------------------------------------------------------------ report */\n49\t\n50\tstatic int total = 0, fails = 0;\n51\t\n52\tstatic void chkl(const char *fn, const char *expname, long exp, long act)\n53\t{\n54\t  total++;\n55\t  if (exp == act)\n56\t    printf(\"%s %s(%ld) %ld ok\\n\", fn, expname, exp, act);\n57\t  else\n58\t    { fails++; printf(\"%s %s(%ld) %ld MISMATCH\\n\", fn, expname, exp, act); }\n59\t}\n60\t\n61\tstatic void chkp(const char *fn, const char *expname, int want_null,\n62\t                 const void *p)\n63\t{\n64\t  int ok = want_null ? (p == NULL) : (p != NULL);\n65\t  total++;\n66\t  printf(\"%s %s %s %s\\n\", fn, expname, p ? \"non-NULL\" : \"NULL\",\n67\t         ok ? \"ok\" : \"MISMATCH\");\n68\t  if (!ok) fails++;\n69\t}\n70\t\n71\t/* --------------------------------------------------------------- allocators */\n72\t\n73\tstatic long budget = 1L << 40;          /* number of mallocs still permitted */\n74\t\n75\tstatic void *cmalloc(size_t s, void *d) { (void)d; if (budget-- <= 0) return NULL; return malloc(s); }\n76\tstatic void  cfree(void *p, void *d)    { (void)d; free(p); }\n77\t/* A *valid* general context whose malloc always fails: create it while the\n78\t   budget is still positive, then exhaust the budget. */\n79\tstatic pcre2_general_context *failing_gcontext(void)\n80\t{\n81\t  pcre2_general_context *g = pcre2_general_context_create(cmalloc, cfree, NULL);\n82\t  budget = 0;\n83\t  return g;\n84\t}\n85\tstatic void restore_budget(void) { budget = 1L << 40; }\n86\t\n87\t/* ------------------------------------------------------------------ helpers */\n88\t\n89\tstatic pcre2_code *comp(const char *p, uint32_t opts, uint32_t xopts)\n90\t{\n91\t  int e; PCRE2_SIZE eo; pcre2_compile_context *cc = NULL; pcre2_code *c;\n92\t  if (xopts) { cc = pcre2_compile_context_create(NULL);\n93\t               pcre2_set_compile_extra_options(cc, xopts); }\n94\t  c = pcre2_compile((PCRE2_SPTR)p, PCRE2_ZERO_TERMINATED, opts, &e, &eo, cc);\n95\t  if (cc) pcre2_compile_context_free(cc);\n96\t  if (!c) { char b[256]; pcre2_get_error_message(e, (PCRE2_UCHAR *)b, 256);\n97\t            fprintf(stderr, \"INTERNAL: compile of '%s' failed: %d %s\\n\", p, e, b);\n98\t            exit(2); }\n99\t  return c;\n100\t}\n101\t\n102\t/* Offset of pcre2_real_code.magic_number inside a compiled block. */\n103\tstatic size_t off_magic(const void *code)\n104\t{\n105\t  const unsigned char *p = (const unsigned char *)code;\n106\t  uint32_t magic = 0x50435245u, v;\n107\t  size_t i;\n108\t  for (i = 64; i < 256; i += 4)\n109\t    { memcpy(&v, p + i, 4); if (v == magic) return i; }\n110\t  fprintf(stderr, \"INTERNAL: magic_number not found\\n\"); exit(2);\n111\t}\n112\t#define OFF_FLAGS(m)           ((m) + 16)\n113\t#define OFF_NAME_ENTRY_SIZE(m) ((m) + 52)\n114\t#define OFF_NAME_COUNT(m)      ((m) + 54)\n115\t#define OFF_BLOCKSIZE(m)       ((m) - 16)   /* 2 * sizeof(PCRE2_SIZE) before */\n116\t\n117\tstatic void poke32(void *base, size_t off, uint32_t v)\n118\t{ memcpy((unsigned char *)base + off, &v, 4); }\n119\tstatic uint32_t peek32(const void *base, size_t off)\n120\t{ uint32_t v; memcpy(&v, (const unsigned char *)base + off, 4); return v; }\n121\tstatic void poke16(void *base, size_t off, uint16_t v)\n122\t{ memcpy((unsigned char *)base + off, &v, 2); }\n123\tstatic void pokesz(void *base, size_t off, size_t v)\n124\t{ memcpy((unsigned char *)base + off, &v, sizeof v); }\n125\t\n126\t/* A 99-capture-group pattern whose heapframe is