E2_ERROR_BADREPLACEMENT(-35)\",f\"{SB}:1230\",\"the replacement ends right after '$<'\",\n  'compile b\"(a)\" opts 0; '+SUBHDR+'pcre2_substitute(code, b\"a\", 1, 0, 0, NULL, NULL, b\"$<\", 2, buf, &blen)',\n  \"\")\nR(\"pcre2_substitute_8\",\"PCRE2_ERROR_BADREPLACEMENT(-35)\",f\"{SB}:1237\",\"the replacement ends right after the '*' of '$*'\",\n  'compile b\"(a)\" opts 0; '+SUBHDR+'pcre2_substitute(code, b\"a\", 1, 0, 0, NULL, NULL, b\"$*\", 2, buf, &blen)',\n  \"\")\nR(\"pcre2_substitute_8\",\"PCRE2_ERROR_BADREPLACEMENT(-35)\",f\"{SB}:1276\",\"read_name_subst() failed: the group name is empty, longer than MAX_NAME_SIZE (128) or starts with a non-word character\",\n  'compile b\"(a)\" opts 0; '+SUBHDR+'pcre2_substitute(code, b\"a\", 1, 0, 0, NULL, NULL, b\"$!\", 2, buf, &blen)',\n  \"\")\nR(\"pcre2_substitute_8\",\"PCRE2_ERROR_BADREPLACEMENT(-35)\",f\"{SB}:1329\",\"$<name form: the closing '>' is missing\",\n  'compile b\"(?<n>a)\" opts 0; '+SUBHDR+'pcre2_substitute(code, b\"a\", 1, 0, 0, NULL, NULL, b\"$<n\", 3, buf, &blen)',\n  \"\")\nR(\"pcre2_substitute_8\",\"PCRE2_ERROR_BADREPLACEMENT(-35)\",f\"{SB}:1353\",\"${*name} where name is not MARK (the only recognized star name)\",\n  'compile b\"(a)\" opts 0; '+SUBHDR+'pcre2_substitute(code, b\"a\", 1, 0, 0, NULL, NULL, b\"${*foo}\", 7, buf, &blen)',\n  \"\")\nR(\"pcre2_substitute_8\",\"PCRE2_ERROR_BADREPLACEMENT(-35)\",f\"{SB}:1433\",\"the ${...:+...} reprocessing stack overflows: ptrstackptr >= PTR_STACK_SIZE (20), i.e. more than 10 nesting levels\",\n  'compile b\"(a)\" opts 0; replacement = 11 x b\"${1:+\" then b\"z\" then 11 x b\"}\"; '+SUBHDR+'pcre2_substitute(code, b\"a\", 1, 0, PCRE2_SUBSTITUTE_EXTENDED, NULL, NULL, replacement, PCRE2_ZERO_TERMINATED, buf, &blen)',\n  \"10 nesting levels succeed, 11 fail (two stack slots are used per level)\")\nR(\"pcre2_substitute_8\",\"PCRE2_ERROR_UNSET(-55)\",f\"{SB}:1416\",\"a plain group substitution refers to an unset group and PCRE2_SUBSTITUTE_UNSET_EMPTY is clear\",\n 