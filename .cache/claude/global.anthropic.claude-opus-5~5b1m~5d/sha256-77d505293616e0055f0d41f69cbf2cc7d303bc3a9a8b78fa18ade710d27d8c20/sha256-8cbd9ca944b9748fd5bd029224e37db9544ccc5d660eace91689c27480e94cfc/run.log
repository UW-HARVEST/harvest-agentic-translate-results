arlb,\n                String::from_utf8_lossy(&cs.subj),\n                cs.start,\n                cs.mopts,\n                cs.ovec,\n                cs.mlimit,\n                cs.dlimit,\n                cs.hlimit,\n                cs.olimit as i64,\n                String::from_utf8_lossy(&cs.repl),\n                cs.sopts,\n                a,\n                b\n            );\n        }\n    }\n    println!(\n        \"{}: {} random cases identical ({} compiled successfully)\",\n        label, iters, compiled\n    );\n}\n\n#[test]\nfn fuzz_seed_1() {\n    run_fuzz(0x1234_5678_9abc_def1, 4000, \"seed1\");\n}\n#[test]\nfn fuzz_seed_2() {\n    run_fuzz(0xdead_beef_cafe_0001, 4000, \"seed2\");\n}\n#[test]\nfn fuzz_seed_3() {\n    run_fuzz(0x0000_0000_0000_0003, 4000, \"seed3\");\n}\n#[test]\nfn fuzz_seed_4() {\n    run_fuzz(0xffff_ffff_ffff_fff5, 4000, \"seed4\");\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
