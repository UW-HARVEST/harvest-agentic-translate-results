rn \"C\" fn(*mut *mut u8),\n329\t    pcre2_substring_list_get_8: unsafe extern \"C\" fn(Ptr, *mut *mut *mut u8, *mut *mut usize) -> i32,\n330\t    pcre2_substring_nametable_scan_8: unsafe extern \"C\" fn(\n331\t        Ptr, Sptr, *mut *mut u8, *mut *mut u8) -> i32,\n332\t    pcre2_substring_number_from_name_8: unsafe extern \"C\" fn(Ptr, Sptr) -> i32,\n333\t\n334\t    // ---- serialize\n335\t    pcre2_serialize_encode_8: unsafe extern \"C\" fn(\n336\t        *const Ptr, i32, *mut *mut u8, *mut usize, Ptr) -> i32,\n337\t    pcre2_serialize_decode_8: unsafe extern \"C\" fn(*mut Ptr, i32, *const u8, Ptr) -> i32,\n338\t    pcre2_serialize_get_number_of_codes_8: unsafe extern \"C\" fn(*const u8) -> i32,\n339\t    pcre2_serialize_free_8: unsafe extern \"C\" fn(*mut u8),\n340\t\n341\t    // ---- convert\n342\t    pcre2_pattern_convert_8: unsafe extern \"C\" fn(\n343\t        Sptr, usize, u32, *mut *mut u8, *mut usize, Ptr) -> i32,\n344\t    pcre2_converted_pattern_free_8: unsafe extern \"C\" fn(*mut u8),\n345\t\n346\t    // ---- misc\n347\t    pcre2_config_8: unsafe extern \"C\" fn(u32, Ptr) -> i32,\n348\t    pcre2_get_error_message_8: unsafe extern \"C\" fn(i32, *mut u8, usize) -> i32,\n349\t    pcre2_maketables_8: unsafe extern \"C\" fn(Ptr) -> *const u8,\n350\t    pcre2_maketables_free_8: unsafe extern \"C\" fn(Ptr, *const u8),\n351\t\n352\t    // ---- JIT stubs (SUPPORT_JIT undefined)\n353\t    pcre2_jit_compile_8: unsafe extern \"C\" fn(Ptr, u32) -> i32,\n354\t    pcre2_jit_free_unused_memory_8: unsafe extern \"C\" fn(Ptr),\n355\t    pcre2_jit_stack_create_8: unsafe extern \"C\" fn(usize, usize, Ptr) -> Ptr,\n356\t    pcre2_jit_stack_assign_8: unsafe extern \"C\" fn(Ptr, Ptr, Ptr),\n357\t    pcre2_jit_stack_free_8: unsafe extern \"C\" fn(Ptr),\n358\t    _pcre2_jit_free_8: unsafe extern \"C\" fn(Ptr, Ptr),\n359\t    _pcre2_jit_free_rodata_8: unsafe extern \"C\" fn(Ptr, Ptr),\n360\t    _pcre2_jit_get_size_8: unsafe extern \"C\" fn(Ptr) -> usize,\n361\t    _pcre2_jit_get_target_8: unsafe extern \"C\" fn() -> *const i8,\n362\t\n363\t    // ---- internal (PRIV) leaf functions\n364\t    _pcre2_strlen_8: unsafe extern \"C\" fn(Sptr) -> usize,\n365\t    _pcre2_strcmp_8: unsafe extern \"C\" fn(Sptr, Sptr) -> i32,\n366\t    _pcre2_strcmp_c8_8: unsafe extern \"C\" fn(Sptr, *const i8) -> i32,\n367\t    _pcre2_strncmp_8: unsafe extern \"C\" fn(Sptr, Sptr, usize) -> i32,\n368\t    _pcre2_strncmp_c8_8: unsafe extern \"C\" fn(Sptr, *const i8, usize) -> i32,\n369\t    _pcre2_strcpy_c8_8: unsafe extern \"C\" fn(*mut u8, *const i8) -> usize,\n370\t    _pcre2_ord2utf_8: unsafe extern \"C\" fn(u32, *mut u8) -> u32,\n371\t    _pcre2_valid_utf_8: unsafe extern \"C\" fn(Sptr, usize, *mut usize) -> i32,\n372\t    _pcre2_is_newline_8: unsafe extern \"C\" fn(Sptr, u32, Sptr, *mut u32, i32) -> i32,\n373\t    _pcre2_was_newline_8: unsafe extern \"C\" fn(Sptr, u32, Sptr, *mut u32, i32) -> i32,\n374\t    _pcre2_extuni_8: unsafe extern \"C\" fn(u32, Sptr, Sptr, Sptr, i32, *mut i32) -> Sptr,\n375\t    _pcre2_script_run_8: unsafe extern \"C\" fn(Sptr, Sptr, i32) -> i32,\n376\t    _pcre2_xclass_8: unsafe extern \"C\" fn(u32, Sptr, *const u8, i32) -> i32,\n377\t    _pcre2_eclass_8: unsafe extern \"C\" fn(u32, Sptr, Sptr, *const u8, i32) -> i32,\n378\t    _pcre2_ckd_smul_8: unsafe extern \"C\" fn(*mut usize, i32, i32) -> i32,\n379\t    _pcre2_update_classbits_8: unsafe extern \"C\" fn(u32, u32, i32, *mut u8),\n380\t    _pcre2_memctl_malloc_8: unsafe extern \"C\" fn(usize, Ptr) -> Ptr,\n381\t    _pcre2_find_bracket_8: unsafe extern \"C\" fn(Sptr, i32, i32) -> Sptr,\n382\t    _pcre2_compile_get_hash_from_name8: unsafe extern \"C\" fn(Sptr, usize) -> u32,\n383\t}\n384\t\n385\timpl Api {\n386\t    /// Look up any exported symbol not present in the `Api` struct, as a typed function\n387\t    /// pointer. `T` must be an `unsafe extern \"C\" fn(..) -> ..` type.\n388\t    pub unsafe fn raw<T: Copy>(&self, name: &str) -> T {\n389\t        let s: Symbol<T> = self\n390\t            ._lib\n391\t            .get(format!(\"{}\\0\", name).as_bytes())\n392\t            .unwrap_or_else(|e| panic!(\"{}: symbol {} missing: {}\", self.tag, name, e));\n393\t        *s\n394\t    }\n395\t\n396\t    pub fn data(&self, name: &str) -> *const u8 {\n397\t        unsafe {\n398\t            let s: Symbol<*const u8> = self\n399\t                ._lib\n400\t                .get(format!(\"{}\\0\", name).as_bytes())\n401\t                .unwrap_or_else(|e| panic!(\"{}: data symbol {} missing: {}\", self.tag, name, e));\n402\t            // libloading returns a pointer to the object itself for data symbols.\n403\t            s.into_raw().into_raw() as *const u8\n404\t        }\n405\t    }\n406\t}\n407\t\n408\tfn root() -> PathBuf {\n409\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n410\t        .parent()\n411\t        .unwrap()\n412\t        .to_path_buf()\n413\t}\n414\t\n415\tpub fn c_so() -> PathBuf {\n416\t    root().join(\"c_src/build/libpcre2.so\")\n417\t}\n418\tpub fn rust_so() -> PathBuf {\n419\t    root().join(\"translation/target/release/libpcre2.so\")\n420\t}\n421\t\n422\t/// Load both libraries. Returns `(c, rust)`.\n423\tpub fn both() -> &'static (Api, Api) {\n424\t    use std::sync::OnceLock;\n425\t    static ONCE: OnceLock<(Api, Api)> = OnceLock::new();\n426\t    ONCE.get_or_init(|| {\n427\t        for p in [c_so(), rust_so()] {\n428\t            assert!(\n429\t                p.exists(),\n430\t                \"missing shared object {:?}\\n  build C:    cd c_src && mkdir -p build && cd build && cmake .. -DCMAKE_POSITION_INDEPENDENT_CODE=ON && cmake --build .\\n  build Rust: cd translation && cargo build --release\",\n431\t                p\n432\t            );\n433\t        }\n434\t        (Api::build(\"C\", c_so()), Api::build(\"RUST\", rust_so()))\n435\t    })\n436\t}\n437\t\n438\t// ============================================================ small helpers\n439\t\n440\t/// Deterministic xorshift RNG so every test run uses the same inputs.\n441\tpub struct Rng(pub u64);\n442\timpl Rng {\n443\t    pub fn new(seed: u64) -> Rng {\n444\t        Rng(seed | 1)\n445\t    }\n446\t    pub fn next_u64(&mut self) -> u64 {\n447\t        let mut x = self.0;\n448\t        x ^= x << 13;\n449\t        x ^= x >> 7;\n450\t        x ^= x << 17;\n451\t        self.0 = x;\n452\t        x\n453\t    }\n454\t    pub fn below(&mut self, n: u32) -> u32 {\n455\t        if n == 0 {\n456\t            0\n457\t        } else {\n458\t            (self.next_u64() >> 11) as u32 % n\n459\t        }\n460\t    }\n461\t    pub fn pick<'a, T>(&mut self, v: &'a [T]) -> &'a T {\n462\t        &v[self.below(v.len() as u32) as usize]\n463\t    }\n464\t    pub fn byte(&mut self) -> u8 {\n465\t        (self.next_u64() >> 24) as u8\n466\t    }\n467\t}\n468\t\n469\t/// One compiled-pattern probe: the observable result of `pcre2_compile`.\n470\t#[derive(Debug, PartialEq, Eq, Clone)]\n471\tpub struct CompileOut {\n472\t    pub ok: bool,\n473\t    pub errorcode: i32,\n474\t    pub erroroffset: usize,\n475\t    /// pattern_info values for every key that returns a scalar\n476\t    pub info: Vec<(u32, i32, u64)>,\n477\t    /// the compiled byte image (PCRE2_INFO_SIZE bytes) with pointer fields masked out\n478\t    pub image: Vec<u8>,\n479\t}\n480\t\n481\t/// Scalar pattern_info keys and the width of their output (4 = uint32_t, 8 = size_t).\n482\tpub const INFO_SCALARS: &[(u32, usize)] = &[\n483\t    (PCRE2_INFO_ALLOPTIONS, 4),\n484\t    (PCRE2_INFO_ARGOPTIONS, 4),\n485\t    (PCRE2_INFO_EXTRAOPTIONS, 4),\n486\t    (PCRE2_INFO_BACKREFMAX, 4),\n487\t    (PCRE2_INFO_BSR, 4),\n488\t    (PCRE2_INFO_CAPTURECOUNT, 4),\n489\t    (PCRE2_INFO_FIRSTCODEUNIT, 4),\n490\t    (PCRE2_INFO_FIRSTCODETYPE, 4),\n491\t    (PCRE2_INFO_HASCRORLF, 4),\n492\t    (PCRE2_INFO_JCHANGED, 4),\n493\t    (PCRE2_INFO_LASTCODEUNIT, 4),\n494\t    (PCRE2_INFO_LASTCODETYPE, 4),\n495\t    (PCRE2_INFO_MATCHEMPTY, 4),\n496\t    (PCRE2_INFO_MAXLOOKBEHIND, 4),\n497\t    (PCRE2_INFO_NAMECOUNT, 4),\n498\t    (PCRE2_INFO_NAMEENTRYSIZE, 4),\n499\t    (PCRE2_INFO_NEWLINE, 4),\n500\t    (PCRE2_INFO_HASBACKSLASHC, 4),\n501\t    (PCRE2_INFO_MATCHLIMIT, 4),\n502\t    (PCRE2_INFO_DEPTHLIMIT, 4),\n503\t    (PCRE2_INFO_HEAPLIMIT, 4),\n504\t    (PCRE2_INFO_MINLENGTH, 4),\n505\t    (PCRE2_INFO_JITSIZE, 8),\n506\t    (PCRE2_INFO_SIZE, 8),\n507\t    (PCRE2_INFO_FRAMESIZE, 8),\n508\t];\n509\t\n510\timpl Api {\n511\t    /// Compile a pattern and collect everything observable about the result.\n512\t    pub unsafe fn compile_probe(\n513\t        &self,\n514\t        pattern: &[u8],\n515\t        plen: usize,\n516\t        options: u32,\n517\t        ccontext: Ptr,\n518\t    ) -> CompileOut {\n519\t        let mut ec: i32 = 0;\n520\t        let mut eo: usize = 0;\n521\t        let code = (self.pcre2_compile_8)(\n522\t            pattern.as_ptr(),\n523\t            plen,\n524\t            options,\n525\t            &mut ec,\n526\t            &mut eo,\n527\t            ccontext,\n528\t        );\n529\t        if code.is_null() {\n530\t            return CompileOut {\n531\t                ok: false,\n532\t                errorcode: ec,\n533\t                erroroffset: eo,\n534\t                info: vec![],\n535\t                image: vec![],\n536\t            };\n537\t        }\n538\t        let mut info = vec![];\n539\t        for &(k, w) in INFO_SCALARS {\n540\t            let mut buf = [0u8; 8];\n541\t            let rc = (self.pcre2_pattern_info_8)(code, k, buf.as_mut_ptr() as Ptr);\n542\t            let v = if w == 4 {\n543\t                u32::from_ne_bytes([buf[0], buf[1], buf[2], buf[3]]) as u64\n544\t            } else {\n545\t                u64::from_ne_bytes(buf)\n546\t            };\n547\t            info.push((k, rc, if rc == 0 { v } else { 0 }));\n548\t        }\n549\t        // name table\n550\t        let mut ncount: u32 = 0;\n551\t        let mut nsize: u32 = 0;\n552\t        (self.pcre2_pattern_info_8)(code, PCRE2_INFO_NAMECOUNT, &mut ncount as *mut u32 as Ptr);\n553\t        (self.pcre2_pattern_info_8)(\n554\t            code,\n555\t            PCRE2_INFO_NAMEENTRYSIZE,\n556\t            &mut nsize as *mut u32 as Ptr,\n557\t        );\n558\t        let mut ntab: *const u8 = std::ptr::null();\n559\t        (self.pcre2_pattern_info_8)(\n560\t            code,\n561\t            PCRE2_INFO_NAMETABLE,\n562\t            &mut ntab as *mut *const u8 as Ptr,\n563\t        );\n564\t        let mut image = vec![];\n565\t        if !ntab.is_null() {\n566\t            image.extend_from_slice(std::slice::from_raw_parts(\n567\t                ntab,\n568\t                (ncount * nsize) as usize,\n569\t            ));\n570\t        }\n571\t        // start-code bitmap\n572\t        let mut bm: *const u8 = std::ptr::null();\n573\t        if (self.pcre2_pattern_info_8)(\n574\t            code,\n575\t            PCRE2_INFO_FIRSTBITMAP,\n576\t            &mut bm as *mut *const u8 as Ptr,\n577\t        ) == 0\n578\t            && !bm.is_null()\n579\t        {\n580\t            image.extend_from_slice(std::slice::from_raw_parts(bm, 32));\n581\t        }\n582\t        // The serialized form of the compiled pattern is a deterministic byte image of\n583\t        // the whole `pcre2_real_code` block (pointer fields are zeroed by the encoder),\n584\t        // so comparing it compares every compiled opcode AND the struct layout.\n585\t        let mut sbytes: *mut u8 = std::ptr::null_mut();\n586\t        let mut ssize: usize = 0;\n587\t        let codes = [code];\n588\t        let rc = (self.pcre2_serialize_encode_8)(\n589\t            codes.as_ptr() as *const Ptr,\n590\t            1,\n591\t            &mut sbytes,\n592\t            &mut ssize,\n593\t            std::ptr::null_mut(),\n594\t        );\n595\t        if rc == 1 && !sbytes.is_null() {\n596\t            // skip the leading TABLES_LENGTH tables copy? no - include everything,\n597\t            // it is identical for identical tables and is part of the observable output.\n598\t            image.extend_from_slice(std::slice::from_raw_parts(sbytes, ssize));\n599\t            (self.pcre2_serialize_free_8)(sbytes);\n600\t        } else {\n601\t            image.extend_from_slice(b\"SERIALIZE_FAIL\");\n602\t            image.extend_from_slice(&rc.to_ne_bytes());\n603\t        }\n604\t        (self.pcre2_code_free_8)(code);\n605\t        CompileOut {\n606\t            ok: true,\n607\t            errorcode: ec,\n608\t            erroroffset: eo,\n609\t            info,\n610\t            image,\n611\t        }\n612\t    }\n613\t}\n614\t\n615\t/// The observable result of a match call.\n616\t#[derive(Debug, PartialEq, Eq, Clone)]\n617\tpub struct MatchOut {\n618\t    pub rc: i32,\n619\t    pub ovector: Vec<usize>,\n620\t    pub startchar: usize,\n621\t    pub mark: Option<Vec<u8>>,\n622\t}\n623\t\n624\tpub unsafe fn read_mark(api: &Api, md: Ptr) -> Option<Vec<u8>> {\n625\t    let m = (api.pcre2_get_mark_8)(md);\n626\t    if m.is_null() {\n627\t        None\n628\t    } else {\n629\t        let n = (api._pcre2_strlen_8)(m);\n630\t        Some(std::slice::from_raw_parts(m, n).to_vec())\n631\t    }\n632\t}\n633\t\n634\tpub unsafe fn read_match(api: &Api, md: Ptr, rc: i32) -> MatchOut {\n635\t    let n = (api.pcre2_get_ovector_count_8)(md);\n636\t    let ov = (api.pcre2_get_ovector_pointer_8)(md);\n637\t    MatchOut {\n638\t        rc,\n639\t        ovector: std::slice::from_raw_parts(ov, (n * 2) as usize).to_vec(),\n640\t        startchar: (api.pcre2_get_startchar_8)(md),\n641\t        mark: read_mark(api, md),\n642\t    }\n643\t}\n644\t"}]},"parent_tool_use_id":"toolu_bdrk_01ECtBBNfFJNi6SYKFLUKdLD","session_id":"a4f10895-a33e-435f-9410-97f386d0c503","uuid":"63f6619a-1b86-4fb6-a15d-27d2453149bb","timestamp":"2026-09-08T18:49:31.714Z","subagent_type":"general-purpose","task_description":"Tests for data tables + leaf fns"}
