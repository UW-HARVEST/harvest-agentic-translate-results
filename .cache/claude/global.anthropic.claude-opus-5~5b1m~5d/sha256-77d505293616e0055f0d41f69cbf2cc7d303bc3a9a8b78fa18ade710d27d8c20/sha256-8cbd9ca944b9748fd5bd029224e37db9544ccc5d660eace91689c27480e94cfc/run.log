}\n}\nEOF\nCARGO_TARGET_DIR=../_v/tgt timeout 300 cargo test --offline --release --test repro_ovec -- --nocapture 2>&1 | tail -16","timeout":300000}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5905,"cache_read_input_tokens":217509,"cache_creation":{"ephemeral_5m_input_tokens":5905,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"a4f10895-a33e-435f-9410-97f386d0c503","uuid":"47ec15d0-349f-46e4-93f4-3a748c8efe0a","timestamp":"2026-09-08T19:47:26.845Z"}
