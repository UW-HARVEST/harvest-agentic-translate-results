ERR101\") == 0)\n    pcre2_set_max_pattern_compiled_length(ccontext, 8);\n  else if (strcmp(errname, \"ERR120\") == 0)\n    erroffset_ptr = NULL;\n\n  errorcode = -12345;\n  re = pcre2_compile(patptr, patlen, options, &errorcode, erroffset_ptr, ccontext);\n\n  if (re != NULL)\n    {\n    printf(\"%-6s %3d FAIL: compiled successfully (expected error)\\n\", errname, expected);\n    pcre2_code_free(re);\n    bad++;\n    }\n  else if (errorcode == expected)\n    {\n    ok++;\n    printf(\"%-6s %3d ok\\n\", errname, expected);\n    }\n  else\n    {\n    PCRE2_UCHAR buf[256];\n    pcre2_get_error_message(errorcode, buf, sizeof(buf));\n    printf(\"%-6s %3d FAIL: got %d (%s) at offset %lu\\n\", errname, expected,\n      errorcode, (char *)buf, (unsigned long)erroffset);\n    bad++;\n    }\n\n  pcre2_compile_context_free(ccontext);\n  if (gcontext != NULL) pcre2_general_context_free(gcontext);\n  free(pat);\n  }\n\nfclose(f);\nprintf(\"\\n=== rows=%d verified=%d unreachable=%d failed=%d\\n\", rows, ok, unreachable, bad);\nreturn bad == 0? 0 : 1;\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
