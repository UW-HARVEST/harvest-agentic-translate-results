t PCRE2_CONFIG_BSR: u32 = 0;\n198\tpub const PCRE2_CONFIG_JIT: u32 = 1;\n199\tpub const PCRE2_CONFIG_JITTARGET: u32 = 2;\n200\tpub const PCRE2_CONFIG_LINKSIZE: u32 = 3;\n201\tpub const PCRE2_CONFIG_MATCHLIMIT: u32 = 4;\n202\tpub const PCRE2_CONFIG_NEWLINE: u32 = 5;\n203\tpub const PCRE2_CONFIG_PARENSLIMIT: u32 = 6;\n204\tpub const PCRE2_CONFIG_DEPTHLIMIT: u32 = 7;\n205\tpub const PCRE2_CONFIG_UNICODE: u32 = 9;\n206\tpub const PCRE2_CONFIG_UNICODE_VERSION: u32 = 10;\n207\tpub const PCRE2_CONFIG_VERSION: u32 = 11;\n208\tpub const PCRE2_CONFIG_HEAPLIMIT: u32 = 12;\n209\tpub const PCRE2_CONFIG_NEVER_BACKSLASH_C: u32 = 13;\n210\tpub const PCRE2_CONFIG_COMPILED_WIDTHS: u32 = 14;\n211\tpub const PCRE2_CONFIG_TABLES_LENGTH: u32 = 15;\n212\t\n213\t// ================================================================= loader\n214\tmacro_rules! api {\n215\t    ( $( $field:ident : $t:ty ),* $(,)? ) => {\n216\t        pub struct Api {\n217\t            pub tag: &'static str,\n218\t            pub path: PathBuf,\n219\t            _lib: &'static Library,\n220\t            $( pub $field : $t, )*\n221\t        }\n222\t        impl Api {\n223\t            fn build(tag: &'static str, path: PathBuf) -> Api {\n224\t                let lib: &'static Library = Box::leak(Box::new(unsafe {\n225\t                    Library::new(&path).unwrap_or_else(|e| panic!(\"dlopen {:?}: {}\", path, e))\n226\t                }));\n227\t                unsafe {\n228\t                    Api {\n229\t                        tag, path, _lib: lib,\n230\t                        $( $field : {\n231\t                            let s: Symbol<$t> = lib\n232\t                                .get(concat!(stringify!($field), \"\\0\").as_bytes())\n233\t                                .unwrap_or_else(|e| panic!(\"{}: symbol {} missing: {}\",\n234\t                                                           tag, stringify!($field), e));\n235\t                            *s\n236\t                        }, )*\n237\t                    }\n238\t                }\n239\t            }\n240\t        }\n241\t    };\n242\t}\n243\t\n244\tapi! {\n245\t    // ---- general / compile / match contexts\n246\t    pcre2_general_context_create_8: unsafe extern \"C\" fn(\n247\t        Option<unsafe extern \"C\" fn(usize, Ptr) -> Ptr>,\n248\t        Option<unsafe extern \"C\" fn(Ptr, Ptr)>, Ptr) -> Ptr,\n249\t    pcre2_general_context_copy_8: unsafe extern \"C\" fn(Ptr) -> Ptr,\n250\t    pcre2_general_context_free_8: unsafe extern \"C\" fn(Ptr),\n251\t    pcre2_compile_context_create_8: unsafe extern \"C\" fn(Ptr) -> Ptr,\n252\t    pcre2_compile_context_copy_8: unsafe extern \"C\" fn(Ptr) -> Ptr,\n253\t    pcre2_compile_context_free_8: unsafe extern \"C\" fn(Ptr),\n254\t    pcre2_match_context_create_8: unsafe extern \"C\" fn(Ptr) -> Ptr,\n255\t    pcre2_match_context_copy_8: unsafe extern \"C\" fn(Ptr) -> Ptr,\n256\t    pcre2_match_context_free_8: unsafe extern \"C\" fn(Ptr),\n257\t    pcre2_convert_context_create_8: unsafe extern \"C\" fn(Ptr) -> Ptr,\n258\t    pcre2_convert_context_copy_8: unsafe extern \"C\" fn(Ptr) -> Ptr,\n259\t    pcre2_convert_context_free_8: unsafe extern \"C\" fn(Ptr),\n260\t\n261\t    // ---- setters\n262\t    pcre2_set_bsr_8: unsafe extern \"C\" fn(Ptr, u32) -> i32,\n263\t    pcre2_set_character_tables_8: unsafe extern \"C\" fn(Ptr, *const u8) -> i32,\n264\t    pcre2_set_compile_extra_options_8: unsafe extern \"C\" fn(Ptr, u32) -> i32,\n265\t    pcre2_set_max_pattern_length_8: unsafe extern \"C\" fn(Ptr, usize) -> i32,\n266\t    pcre2_set_max_pattern_compiled_length_8: unsafe extern \"C\" fn(Ptr, usize) -> i32,\n267\t    pcre2_set_max_varlookbehind_8: unsafe extern \"C\" fn(Ptr, u32) -> i32,\n268\t    pcre2_set_newline_8: unsafe extern \"C\" fn(Ptr, u32) -> i32,\n269\t    pcre2_set_parens_nest_limit_8: unsafe extern \"C\" fn(Ptr, u32) -> i32,\n270\t    pcre2_set_compile_recursion_guard_8: unsafe extern \"C\" fn(\n271\t        Ptr, Option<unsafe extern \"C\" fn(u32, Ptr) -> i32>, Ptr) -> i32,\n272\t    pcre2_set_callout_8: unsafe extern \"C\" fn(\n273\t        Ptr, Option<unsafe extern \"C\" fn(Ptr, Ptr) -> i32>, Ptr) -> i32,\n274\t    pcre2_set_substitute_callout_8: unsafe extern \"C\" fn(\n275\t        Ptr, Option<unsafe extern \"C\" fn(Ptr, Ptr) -> i32>, Ptr) -> i32,\n276\t    pcre2_set_substitute_case_callout_8: unsafe extern \"C\" fn(\n277\t        Ptr, Option<unsafe extern \"C\" fn(Sptr, usize, *mut u8, usize, i32, Ptr) -> usize>,\n278\t        Ptr) -> i32,\n279\t    pcre2_set_depth_limit_8: unsafe extern \"C\" fn(Ptr, u32) -> i32,\n280\t    pcre2_set_heap_limit_8: unsafe extern \"C\" fn(Ptr, u32) -> i32,\n281\t    pcre2_set_match_limit_8: unsafe extern \"C\" fn(Ptr, u32) -> i32,\n282\t    pcre2_set_offset_limit_8: unsafe extern \"C\" fn(Ptr, usize) -> i32,\n283\t    pcre2_set_recursion_limit_8: unsafe extern \"C\" fn(Ptr, u32) -> i32,\n284\t    pcre2_set_recursion_memory_management_8: unsafe extern \"C\" fn(\n285\t        Ptr, Option<unsafe extern \"C\" fn(usize, Ptr) -> Ptr>,\n286\t        Option<unsafe extern \"C\" fn(Ptr, Ptr)>, Ptr) -> i32,\n287\t    pcre2_set_optimize_8: unsafe extern \"C\" fn(Ptr, u32) -> i32,\n288\t    pcre2_set_glob_escape_8: unsafe extern \"C\" fn(Ptr, u32) -> i32,\n289\t    pcre2_set_glob_separator_8: unsafe extern \"C\" fn(Ptr, u32) -> i32,\n290\t\n291\t    // ---- compile / code\n292\t    pcre2_compile_8: unsafe extern \"C\" fn(Sptr, usize, u32, *mut i32, *mut usize, Ptr) -> Ptr,\n293\t    pcre2_code_free_8: unsafe extern \"C\" fn(Ptr),\n294\t    pcre2_code_copy_8: unsafe extern \"C\" fn(Ptr) -> Ptr,\n295\t    pcre2_code_copy_with_tables_8: unsafe extern \"C\" fn(Ptr) -> Ptr,\n296\t    pcre2_pattern_info_8: unsafe extern \"C\" fn(Ptr, u32, Ptr) -> i32,\n297\t    pcre2_callout_enumerate_8: unsafe extern \"C\" fn(\n298\t        Ptr, Option<unsafe extern \"C\" fn(Ptr, Ptr) -> i32>, Ptr) -> i32,\n299\t\n300\t    // ---- match data\n301\t    pcre2_match_data_create_8: unsafe extern \"C\" fn(u32, Ptr) -> Ptr,\n302\t    pcre2_match_data_create_from_pattern_8: unsafe extern \"C\" fn(Ptr, Ptr) -> Ptr,\n303\t    pcre2_match_data_free_8: unsafe extern \"C\" fn(Ptr),\n304\t    pcre2_get_ovector_count_8: unsafe extern \"C\" fn(Ptr) -> u32,\n305\t    pcre2_get_ovector_pointer_8: unsafe extern \"C\" fn(Ptr) -> *mut usize,\n306\t    pcre2_get_startchar_8: unsafe extern \"C\" fn(Ptr) -> usize,\n307\t    pcre2_get_mark_8: unsafe extern \"C\" fn(Ptr) -> Sptr,\n308\t    pcre2_get_match_data_size_8: unsafe extern \"C\" fn(Ptr) -> usize,\n309\t    pcre2_get_match_data_heapframes_size_8: unsafe extern \"C\" fn(Ptr) -> usize,\n310\t\n311\t    // ---- matching\n312\t    pcre2_match_8: unsafe extern \"C\" fn(Ptr, Sptr, usize, usize, u32, Ptr, Ptr) -> i32,\n313\t    pcre2_dfa_match_8: unsafe extern \"C\" fn(\n314\t        Ptr, Sptr, usize, usize, u32, Ptr, Ptr, *mut i32, usize) -> i32,\n315\t    pcre2_jit_match_8: unsafe extern \"C\" fn(Ptr, Sptr, usize, usize, u32, Ptr, Ptr) -> i32,\n316\t    pcre2_next_match_8: unsafe extern \"C\" fn(Ptr, *mut usize, *mut u32) -> i32,\n317\t\n318\t    // ---- substitute / substring\n319\t    pcre2_substitute_8: unsafe extern \"C\" fn(\n320\t        Ptr, Sptr, usize, usize, u32, Ptr, Ptr, Sptr, usize, *mut u8, *mut usize) -> i32,\n321\t    pcre2_substring_copy_byname_8: unsafe extern \"C\" fn(Ptr, Sptr, *mut u8, *mut usize) -> i32,\n322\t    pcre2_substring_copy_bynumber_8: unsafe extern \"C\" fn(Ptr, u32, *mut u8, *mut usize) -> i32,\n323\t    pcre2_substring_free_8: unsafe extern \"C\" fn(*mut u8),\n324\t    pcre2_substring_get_byname_8: unsafe extern \"C\" fn(Ptr, Sptr, *mut *mut u8, *mut usize) -> i32,\n325\t    pcre2_substring_get_bynumber_8: unsafe extern \"C\" fn(Ptr, u32, *mut *mut u8, *mut usize) -> i32,\n326\t    pcre2_substring_length_byname_8: unsafe extern \"C\" fn(Ptr, Sptr, *mut usize) -> i32,\n327\t    pcre2_substring_length_bynumber_8: unsafe extern \"C\" fn(Ptr, u32, *mut usize) -> i32,\n328\t    pcre2_substring_list_free_8: unsafe extern \"C\" fn(*mut *mut u8),\n329\t    pcre2_substring_list_get_8: unsafe extern \"C\" fn(Ptr, *mut *mut *mut u8, *mut *mut usize) -> i32,\n330\t    pcre2_substring_nametable_scan_8: unsafe extern \"C\" fn(\n331\t        Ptr, Sptr, *mut *mut u8, *mut *mut u8) -> i32,\n332\t    pcre2_substring_number_from_name_8: unsafe extern \"C\" fn(Ptr, Sptr) -> i32,\n333\t\n334\t    // ---- serialize\n335\t    pcre2_serialize_encode_8: unsafe extern \"C\" fn(\n336\t        *const Ptr, i32, *mut *mut u8, *mut usize, Ptr) -> i32,\n337\t    pcre2_serialize_decode_8: unsafe extern \"C\" fn(*mut Ptr, i32, *const u8, Ptr) -> i32,\n338\t    pcre2_serialize_get_number_of_codes_8: unsafe extern \"C\" fn(*const u8) -> i32,\n339\t    pcre2_serialize_free_8: unsafe extern \"C\" fn(*mut u8),\n340\t\n341\t    // ---- convert\n342\t    pcre2_pattern_convert_8: unsafe extern \"C\" fn(\n343\t        Sptr, usize, u32, *mut *mut u8, *mut usize, Ptr) -> i32,\n344\t    pcre2_converted_pattern_free_8: unsafe extern \"C\" fn(*mut u8),\n345\t\n346\t    // ---- misc\n347\t    pcre2_config_8: unsafe extern \"C\" fn(u32, Ptr) -> i32,\n348\t    pcre2_get_error_message_8: unsafe extern \"C\" fn(i32, *mut u8, usize) -> i32,\n349\t    pcre2_maketables_8: unsafe extern \"C\" fn(Ptr) -> *const u8,\n350\t    pcre2_maketables_free_8: unsafe extern \"C\" fn(Ptr, *const u8),\n351\t\n352\t    // ---- JIT stubs (SUPPORT_JIT undefined)\n353\t    pcre2_jit_compile_8: unsafe extern \"C\" fn(Ptr, u32) -> i32,\n354\t    pcre2_jit_free_unused_memory_8: unsafe extern \"C\" fn(Ptr),\n355\t    pcre2_jit_stack_create_8: unsafe extern \"C\" fn(usize, usize, Ptr) -> Ptr,\n356\t    pcre2_jit_stack_assign_8: unsafe extern \"C\" fn(Ptr, Ptr, Ptr),\n357\t    pcre2_jit_stack_free_8: unsafe extern \"C\" fn(Ptr),\n358\t    _pcre2_jit_free_8: unsafe extern \"C\" fn(Ptr, Ptr),\n359\t    _pcre2_jit_free_rodata_8: unsafe extern \"C\" fn(Ptr, Ptr),\n360\t    _pcre2_jit_get_size_8: unsafe extern \"C\" fn(Ptr) -> usize,\n361\t    _pcre2_jit_get_target_8: unsafe extern \"C\" fn() -> *const i8,\n362\t\n363\t    // ---- internal (PRIV) leaf functions\n364\t    _pcre2_strlen_8: unsafe extern \"C\" fn(Sptr) -> usize,\n365\t    _pcre2_strcmp_8: unsafe extern \"C\" fn(Sptr, Sptr) -> i32,\n366\t    _pcre2_strcmp_c8_8: unsafe extern \"C\" fn(Sptr, *const i8) -> i32,\n367\t    _pcre2_strncmp_8: unsafe extern \"C\" fn(Sptr, Sptr, usize) -> i32,\n368\t    _pcre2_strncmp_c8_8: unsafe extern \"C\" fn(Sptr, *const i8, usize) -> i32,\n369\t    _pcre2_strcpy_c8_8: unsafe extern \"C\" fn(*mut u8, *const i8) -> usize,\n370\t    _pcre2_ord2utf_8: unsafe extern \"C\" fn(u32, *mut u8) -> u32,\n371\t    _pcre2_valid_utf_8: unsafe extern \"C\" fn(Sptr, usize, *mut usize) -> i32,\n372\t    _pcre2_is_newline_8: unsafe extern \"C\" fn(Sptr, u32, Sptr, *mut u32, i32) -> i32,\n373\t    _pcre2_was_newline_8: unsafe extern \"C\" fn(Sptr, u32, Sptr, *mut u32, i32) -> i32,\n374\t    _pcre2_extuni_8: unsafe extern \"C\" fn(u32, Sptr, Sptr, Sptr, i32, *mut i32) -> Sptr,\n375\t    _pcre2_script_run_8: unsafe extern \"C\" fn(Sptr, Sptr, i32) -> i32,\n376\t    _pcre2_xclass_8: unsafe extern \"C\" fn(u32, Sptr, *const u8, i32) -> i32,\n377\t    _pcre2_eclass_8: unsafe extern \"C\" fn(u32, Sptr, Sptr, *const u8, i32) -> i32,\n378\t    _pcre2_ckd_smul_8: unsafe extern \"C\" fn(*mut usize, i32, i32) -> i32,\n379\t    _pcre2_update_classbits_8: unsafe extern \"C\" fn(u32, u32, i32, *mut u8),\n380\t    _pcre2_memctl_malloc_8: unsafe extern \"C\" fn(usize, Ptr) -> Ptr,\n381\t    _pcre2_find_bracket_8: unsafe extern \"C\" fn(Sptr, i32, i32) -> Sptr,\n382\t    // C prototype: uint16_t PRIV(compile_get_hash_from_name)(PCRE2_SPTR, uint32_t)\n383\t    _pcre2_compile_get_hash_from_name8: unsafe extern \"C\" fn(Sptr, u32) -> u16,\n384\t}\n385\t\n386\timpl Api {\n387\t    /// Look up any exported symbol not present in the `Api` struct, as a typed function\n388\t    /// pointer. `T` must be an `unsafe extern \"C\" fn(..) -> ..` type.\n389\t    pub unsafe fn raw<T: Copy>(&self, name: &str) -> T {\n390\t        let s: Symbol<T> = self\n391\t            ._lib\n392\t            .get(format!(\"{}\\0\", name).as_bytes())\n393\t            .unwrap_or_else(|e| panic!(\"{}: symbol {} missing: {}\", self.tag, name, e));\n394\t        *s\n395\t    }\n396\t\n397\t    pub fn data(&self, name: &str) -> *const u8 {\n398\t        unsafe {\n399\t            let s: Symbol<*const u8> = self\n400\t                ._lib\n401\t                .get(format!(\"{}\\0\", name).as_bytes())\n402\t                .unwrap_or_else(|e| panic!(\"{}: data symbol {} missing: {}\", self.tag, name, e));\n403\t            // libloading returns a pointer to the object itself for data symbols.\n404\t            s.into_raw().into_raw() as *const u8\n405\t        }\n406\t    }\n407\t}\n408\t\n409\tfn root() -> PathBuf {\n410\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n411\t        .parent()\n412\t        .unwrap()\n413\t        .to_path_buf()\n414\t}\n415\t\n416\tpub fn c_so() -> PathBuf {\n417\t    root().join(\"c_src/build/libpcre2.so\")\n418\t}\n419\tpub fn rust_so() -> PathBuf {\n420\t    root().join(\"translation/target/release/libpcre2.so\")\n421\t}\n422\t\n423\t/// Load both libraries. Returns `(c, rust)`.\n424\tpub fn both() -> &'static (Api, Api) {\n425\t    use std::sync::OnceLock;\n426\t    static ONCE: OnceLock<(Api, Api)> = OnceLock::new();\n427\t    ONCE.get_or_init(|| {\n428\t        for p in [c_so(), rust_so()] {\n429\t            assert!(\n430\t                p.exists(),\n431\t                \"missing shared object {:?}\\n  build C:    cd c_src && mkdir -p build && cd build && cmake .. -DCMAKE_POSITION_INDEPENDENT_CODE=ON && cmake --build .\\n  build Rust: cd translation && cargo build --release\",\n432\t                p\n433\t            );\n434\t        }\n435\t        (Api::build(\"C\", c_so()), Api::build(\"RUST\", rust_so()))\n436\t    })\n437\t}\n438\t\n439\t// ============================================================ small helpers\n440\t\n441\t/// Deterministic xorshift RNG so every test run uses the same inputs.\n442\tpub struct Rng(pub u64);\n443\timpl Rng {\n444\t    pub fn new(seed: u64) -> Rng {\n445\t        Rng(seed | 1)\n446\t    }\n447\t    pub fn next_u64(&mut self) -> u64 {\n448\t        let mut x = self.0;\n449\t        x ^= x << 13;\n450\t        x ^= x >> 7;\n451\t        x ^= x << 17;\n452\t        self.0 = x;\n453\t        x\n454\t    }\n455\t    pub fn below(&mut self, n: u32) -> u32 {\n456\t        if n == 0 {\n457\t            0\n458\t        } else {\n459\t            (self.next_u64() >> 11) as u32 % n\n460\t        }\n461\t    }\n462\t    pub fn pick<'a, T>(&mut self, v: &'a [T]) -> &'a T {\n463\t        &v[self.below(v.len() as u32) as usize]\n464\t    }\n465\t    pub fn byte(&mut self) -> u8 {\n466\t        (self.next_u64() >> 24) as u8\n467\t    }\n468\t}\n469\t\n470\t/// One compiled-pattern probe: the observable result of `pcre2_compile`.\n471\t#[derive(Debug, PartialEq, Eq, Clone)]\n472\tpub struct CompileOut {\n473\t    pub ok: bool,\n474\t    pub errorcode: i32,\n475\t    pub erroroffset: usize,\n476\t    /// pattern_info values for every key that returns a scalar\n477\t    pub info: Vec<(u32, i32, u64)>,\n478\t    /// the compiled byte image (PCRE2_INFO_SIZE bytes) with pointer fields masked out\n479\t    pub image: Vec<u8>,\n480\t}\n481\t\n482\t/// Scalar pattern_info keys and the width of their output (4 = uint32_t, 8 = size_t).\n483\tpub const INFO_SCALARS: &[(u32, usize)] = &[\n484\t    (PCRE2_INFO_ALLOPTIONS, 4),\n485\t    (PCRE2_INFO_ARGOPTIONS, 4),\n486\t    (PCRE2_INFO_EXTRAOPTIONS, 4),\n487\t    (PCRE2_INFO_BACKREFMAX, 4),\n488\t    (PCRE2_INFO_BSR, 4),\n489\t    (PCRE2_INFO_CAPTURECOUNT, 4),\n490\t    (PCRE2_INFO_FIRSTCODEUNIT, 4),\n491\t    (PCRE2_INFO_FIRSTCODETYPE, 4),\n492\t    (PCRE2_INFO_HASCRORLF, 4),\n493\t    (PCRE2_INFO_JCHANGED, 4),\n494\t    (PCRE2_INFO_LASTCODEUNIT, 4),\n495\t    (PCRE2_INFO_LASTCODETYPE, 4),\n496\t    (PCRE2_INFO_MATCHEMPTY, 4),\n497\t    (PCRE2_INFO_MAXLOOKBEHIND, 4),\n498\t    (PCRE2_INFO_NAMECOUNT, 4),\n499\t    (PCRE2_INFO_NAMEENTRYSIZE, 4),\n500\t    (PCRE2_INFO_NEWLINE, 4),\n501\t    (PCRE2_INFO_HASBACKSLASHC, 4),\n502\t    (PCRE2_INFO_MATCHLIMIT, 4),\n503\t    (PCRE2_INFO_DEPTHLIMIT, 4),\n504\t    (PCRE2_INFO_HEAPLIMIT, 4),\n505\t    (PCRE2_INFO_MINLENGTH, 4),\n506\t    (PCRE2_INFO_JITSIZE, 8),\n507\t    (PCRE2_INFO_SIZE, 8),\n508\t    (PCRE2_INFO_FRAMESIZE, 8),\n509\t];\n510\t\n511\timpl Api {\n512\t    /// Compile a pattern and collect everything observable about the result.\n513\t    pub unsafe fn compile_probe(\n514\t        &self,\n515\t        pattern: &[u8],\n516\t        plen: usize,\n517\t        options: u32,\n518\t        ccontext: Ptr,\n519\t    ) -> CompileOut {\n520\t        let mut ec: i32 = 0;\n521\t        let mut eo: usize = 0;\n522\t        let code = (self.pcre2_compile_8)(\n523\t            pattern.as_ptr(),\n524\t            plen,\n525\t            options,\n526\t            &mut ec,\n527\t            &mut eo,\n528\t            ccontext,\n529\t        );\n530\t        if code.is_null() {\n531\t            return CompileOut {\n532\t                ok: false,\n533\t                errorcode: ec,\n534\t                erroroffset: eo,\n535\t                info: vec![],\n536\t                image: vec![],\n537\t            };\n538\t        }\n539\t        let mut info = vec![];\n540\t        for &(k, w) in INFO_SCALARS {\n541\t            let mut buf = [0u8; 8];\n542\t            let rc = (self.pcre2_pattern_info_8)(code, k, buf.as_mut_ptr() as Ptr);\n543\t            let v = if w == 4 {\n544\t                u32::from_ne_bytes([buf[0], buf[1], buf[2], buf[3]]) as u64\n545\t            } else {\n546\t                u64::from_ne_bytes(buf)\n547\t            };\n548\t            info.push((k, rc, if rc == 0 { v } else { 0 }));\n549\t        }\n550\t        // name table\n551\t        let mut ncount: u32 = 0;\n552\t        let mut nsize: u32 = 0;\n553\t        (self.pcre2_pattern_info_8)(code, PCRE2_INFO_NAMECOUNT, &mut ncount as *mut u32 as Ptr);\n554\t        (self.pcre2_pattern_info_8)(\n555\t            code,\n556\t            PCRE2_INFO_NAMEENTRYSIZE,\n557\t            &mut nsize as *mut u32 as Ptr,\n558\t        );\n559\t        let mut ntab: *const u8 = std::ptr::null();\n560\t        (self.pcre2_pattern_info_8)(\n561\t            code,\n562\t            PCRE2_INFO_NAMETABLE,\n563\t            &mut ntab as *mut *const u8 as Ptr,\n564\t        );\n565\t        let mut image = vec![];\n566\t        if !ntab.is_null() {\n567\t            image.extend_from_slice(std::slice::from_raw_parts(\n568\t                ntab,\n569\t                (ncount * nsize) as usize,\n570\t            ));\n571\t        }\n572\t        // start-code bitmap\n573\t        let mut bm: *const u8 = std::ptr::null();\n574\t        if (self.pcre2_pattern_info_8)(\n575\t            code,\n576\t            PCRE2_INFO_FIRSTBITMAP,\n577\t            &mut bm as *mut *const u8 as Ptr,\n578\t        ) == 0\n579\t            && !bm.is_null()\n580\t        {\n581\t            image.extend_from_slice(std::slice::from_raw_parts(bm, 32));\n582\t        }\n583\t        // The serialized form of the compiled pattern is a deterministic byte image of\n584\t        // the whole `pcre2_real_code` block (pointer fields are zeroed by the encoder),\n585\t        // so comparing it compares every compiled opcode AND the struct layout.\n586\t        let mut sbytes: *mut u8 = std::ptr::null_mut();\n587\t        let mut ssize: usize = 0;\n588\t        let codes = [code];\n589\t        let rc = (self.pcre2_serialize_encode_8)(\n590\t            codes.as_ptr() as *const Ptr,\n591\t            1,\n592\t            &mut sbytes,\n593\t            &mut ssize,\n594\t            std::ptr::null_mut(),\n595\t        );\n596\t        if rc == 1 && !sbytes.is_null() {\n597\t            // skip the leading TABLES_LENGTH tables copy? no - include everything,\n598\t            // it is identical for identical tables and is part of the observable output.\n599\t            image.extend_from_slice(std::slice::from_raw_parts(sbytes, ssize));\n600\t            (self.pcre2_serialize_free_8)(sbytes);\n601\t        } else {\n602\t            image.extend_from_slice(b\"SERIALIZE_FAIL\");\n603\t            image.extend_from_slice(&rc.to_ne_bytes());\n604\t        }\n605\t        (self.pcre2_code_free_8)(code);\n606\t        CompileOut {\n607\t            ok: true,\n608\t            errorcode: ec,\n609\t            erroroffset: eo,\n610\t            info,\n611\t            image,\n612\t        }\n613\t    }\n614\t}\n615\t\n616\t/// The observable result of a match call.\n617\t#[derive(Debug, PartialEq, Eq, Clone)]\n618\tpub struct MatchOut {\n619\t    pub rc: i32,\n620\t    pub ovector: Vec<usize>,\n621\t    pub startchar: usize,\n622\t    pub mark: Option<Vec<u8>>,\n623\t}\n624\t\n625\tpub unsafe fn read_mark(api: &Api, md: Ptr) -> Option<Vec<u8>> {\n626\t    let m = (api.pcre2_get_mark_8)(md);\n627\t    if m.is_null() {\n628\t        None\n629\t    } else {\n630\t        let n = (api._pcre2_strlen_8)(m);\n631\t        Some(std::slice::from_raw_parts(m, n).to_vec())\n632\t    }\n633\t}\n634\t\n635\tpub unsafe fn read_match(api: &Api, md: Ptr, rc: i32) -> MatchOut {\n636\t    let n = (api.pcre2_get_ovector_count_8)(md);\n637\t    let ov = (api.pcre2_get_ovector_pointer_8)(md);\n638\t    MatchOut {\n639\t        rc,\n640\t        ovector: std::slice::from_raw_parts(ov, (n * 2) as usize).to_vec(),\n641\t        startchar: (api.pcre2_get_startchar_8)(md),\n642\t        mark: read_mark(api, md),\n643\t    }\n644\t}\n645\t"}]},"parent_tool_use_id":"toolu_bdrk_013qZpUC2GEF1G9qxZU9u1vo","session_id":"a4f10895-a33e-435f-9410-97f386d0c503","uuid":"cb5b699c-03be-423d-a60b-b8627df26d51","timestamp":"2026-09-08T19:22:23.903Z","subagent_type":"general-purpose","task_description":"Tests for info/convert/free/jit rows"}
