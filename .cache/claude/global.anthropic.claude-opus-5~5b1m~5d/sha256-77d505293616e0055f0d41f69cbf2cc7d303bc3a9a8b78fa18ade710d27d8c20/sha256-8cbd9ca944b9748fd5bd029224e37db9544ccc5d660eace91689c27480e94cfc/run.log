r\n\r\n': [rc=1 ov=0,0]{c=1 off=0 opt=0x8} [rc=1 ov=1,1]{c=1 off=1 opt=0x8} [rc=1 ov=2,2]{c=1 off=2 opt=0x8} [rc=1 ov=3,3]{c=1 off=3 opt=0x8} [rc=1 ov=4,4]{c=0 off=3 opt=0x8}\nNM pat='x?' subj='aéb': [rc=1 ov=0,0]{c=1 off=0 opt=0x8} [rc=1 ov=1,1]{c=1 off=1 opt=0x8} [rc=1 ov=2,2]{c=1 off=2 opt=0x8} [rc=1 ov=3,3]{c=1 off=3 opt=0x8} [rc=1 ov=4,4]{c=0 off=3 opt=0x8}\nNM pat='' subj='': [rc=1 ov=0,0]{c=0 off=0 opt=0}\nNM pat='' subj='aab': [rc=1 ov=0,0]{c=1 off=0 opt=0x8} [rc=1 ov=1,1]{c=1 off=1 opt=0x8} [rc=1 ov=2,2]{c=1 off=2 opt=0x8} [rc=1 ov=3,3]{c=0 off=2 opt=0x8}\nNM pat='' subj='\r\n\r\n': [rc=1 ov=0,0]{c=1 off=0 opt=0x8} [rc=1 ov=1,1]{c=1 off=1 opt=0x8} [rc=1 ov=2,2]{c=1 off=2 opt=0x8} [rc=1 ov=3,3]{c=1 off=3 opt=0x8} [rc=1 ov=4,4]{c=0 off=3 opt=0x8}\nNM pat='' subj='aéb': [rc=1 ov=0,0]{c=1 off=0 opt=0x8} [rc=1 ov=1,1]{c=1 off=1 opt=0x8} [rc=1 ov=2,2]{c=1 off=2 opt=0x8} [rc=1 ov=3,3]{c=1 off=3 opt=0x8} [rc=1 ov=4,4]{c=0 off=3 opt=0x8}\nNM pat='a|' subj='': [rc=1 ov=0,0]{c=0 off=0 opt=0}\nNM pat='a|' subj='aab': [rc=1 ov=0,1]{c=1 off=1 opt=0} [rc=1 ov=1,2]{c=1 off=2 opt=0} [rc=1 ov=2,2]{c=1 off=2 opt=0x8} [rc=1 ov=3,3]{c=0 off=2 opt=0x8}\nNM pat='a|' subj='\r\n\r\n': [rc=1 ov=0,0]{c=1 off=0 opt=0x8} [rc=1 ov=1,1]{c=1 off=1 opt=0x8} [rc=1 ov=2,2]{c=1 off=2 opt=0x8} [rc=1 ov=3,3]{c=1 off=3 opt=0x8} [rc=1 ov=4,4]{c=0 off=3 opt=0x8}\nNM pat='a|' subj='aéb': [rc=1 ov=0,1]{c=1 off=1 opt=0} [rc=1 ov=1,1]{c=1 off=1 opt=0x8} [rc=1 ov=2,2]{c=1 off=2 opt=0x8} [rc=1 ov=3,3]{c=1 off=3 opt=0x8} [rc=1 ov=4,4]{c=0 off=3 opt=0x8}\nNM pat='(?<=a)' subj='': [rc=-1 ov=986228275,120]{c=0 off=0 opt=0}\nNM pat='(?<=a)' subj='aab': [rc=1 ov=1,1]{c=1 off=1 opt=0x8} [rc=1 ov=2,2]{c=1 off=2 opt=0x8} [rc=-1 ov=2,2]{c=0 off=2 opt=0x8}\nNM pat='(?<=a)' subj='\r\n\r\n': [rc=-1 ov=2,2]{c=0 off=0 opt=0}\nNM pat='(?<=a)' subj='aéb': [rc=1 ov=1,1]{c=1 off=1 opt=0x8} [rc=-1 ov=1,1]{c=0 off=1 opt=0x8}","is_error":false}]},"parent_tool_use_id":"toolu_bdrk_015QwkpUyFvJ7XA1rUHAaQD3","session_id":"a4f108