\",\"the error from pcre2_match(), e.g. PCRE2_ERROR_MATCHLIMIT(-47)\",f\"{SB}:996\",\"the internal pcre2_match() returned a negative value other than PCRE2_ERROR_NOMATCH\",\n  'compile b\"a\" opts 0; mc=match_context_create(NULL); pcre2_set_match_limit(mc,0); '+SUBHDR+'pcre2_substitute(code, b\"a\", 1, 0, 0, NULL, mc, b\"X\", 1, buf, &blen)',\n  \"PCRE2_ERROR_NOMATCH merely ends the global loop\")\nR(\"pcre2_substitute_8\",\"PCRE2_ERROR_BADSUBSPATTERN(-60)\",f\"{SB}:1001\",\"ovector[0] < start_offset (the match start moved backwards)\",\n  'compile b\"(?<=\\\\\\\\Kab)c\" opts 0 extra PCRE2_EXTRA_ALLOW_LOOKAROUND_BSK; '+SUBHDR+'pcre2_substitute(code, b\"abc\", 3, 2, 0, NULL, NULL, b\"X\", 1, buf, &blen)',\n  \"PCRE2_EXTRA_ALLOW_LOOKAROUND_BSK is required so that pcre2_match() does not return PCRE2_ERROR_BAD_BACKSLASH_K first\")\nR(\"pcre2_substitute_8\",\"PCRE2_ERROR_BADSUBSPATTERN(-60)\",f\"{SB}:1001\",\"ovector[1] < ovector[0] (the match ends before it starts)\",\n  'compile b\"a(?=b\\\\\\\\K)\" opts 0 extra PCRE2_EXTRA_ALLOW_LOOKAROUND_BSK; '+SUBHDR+'pcre2_substitute(code, b\"ab\", 2, 0, 0, NULL, NULL, b\"X\", 1, buf, &blen)',\n  \"\")\nR(\"pcre2_substitute_8\",\"PCRE2_ERROR_PARTIALSUBS(-76)\",f\"{SB}:1155\",\"$' (the text after the match) used while a partial-matching option is set\",\n  'compile b\"abc\" opts 0; '+SUBHDR+\"pcre2_substitute(code, b\\\"abcd\\\", 4, 0, PCRE2_PARTIAL_SOFT|PCRE2_SUBSTITUTE_REPLACEMENT_ONLY, NULL, NULL, b\\\"$'\\\", 2, buf, &blen)\",\n  \"the subject must produce a complete match, otherwise -2 is returned earlier\")\nR(\"pcre2_substitute_8\",\"PCRE2_ERROR_PARTIALSUBS(-76)\",f\"{SB}:1172\",\"$_ (the whole input) used while a partial-matching option is set\",\n  'compile b\"abc\" opts 0; '+SUBHDR+'pcre2_substitute(code, b\"abcd\", 4, 0, PCRE2_PARTIAL_SOFT|PCRE2_SUBSTITUTE_REPLACEMENT_ONLY, NULL, NULL, b\"$_\", 2, buf, &blen)',\n  \"\")\nR(\"pcre2_substitute_8\",\"PCRE2_ERROR_NOSUBSTRING(-49)\",f\"{SB}:1193\",\"$+ used when the pattern h