ength is left at PCRE2_UNSET\")\nR(\"pcre2_substitute_8\",\"PCRE2_ERROR_NOMEMORY(-48)\",f\"{SB}:1750\",\"the output buffer overflowed but PCRE2_SUBSTITUTE_OVERFLOW_LENGTH was set, so scanning continued to compute the needed size\",\n  'compile b\"abc\" opts 0; PCRE2_UCHAR buf[1024]; PCRE2_SIZE blen = 2; pcre2_substitute(code, b\"abc\", 3, 0, PCRE2_SUBSTITUTE_OVERFLOW_LENGTH, NULL, NULL, b\"XXXXXXXXXX\", 10, buf, &blen)',\n  \"*blength is set to the required size including the trailing NUL (11 here)\")\nR(\"pcre2_substitute_8\",\"PCRE2_ERROR_REPLACECASE(-69)\",f\"{SB}:1776\",\"a substitute_case_callout returned ~(PCRE2_SIZE)0 (CASEERROR label)\",\n  'compile b\"(a)\" opts 0; mc = match_context_create(NULL); pcre2_set_substitute_case_callout(mc, cb, NULL) where cb always returns PCRE2_SIZE::MAX; '+SUBHDR+'pcre2_substitute(code, b\"a\", 1, 0, PCRE2_SUBSTITUTE_EXTENDED, NULL, mc, b\"\\\\\\\\U$1\", 4, buf, &blen)',\n  \"only reachable with a user-supplied case callout\")\nR(\"pcre2_substitute_8\",\"PCRE2_ERROR_INTERNAL_DUPMATCH(-65)\",f\"{SB}:1021\",\"the global loop failed to make progress between two substitutions\",\n  \"UNREACHABLE\",\n  \"guarded by an LCOV_EXCL block; pcre2_next_match() guarantees progress\")\nR(\"pcre2_substitute_8\",\"PCRE2_ERROR_TOOMANYREPLACE(-61)\",f\"{SB}:1034\",\"subs == INT_MAX\",\n  \"UNREACHABLE\",\n  \"would need 2^31-1 substitutions in one call\")\nR(\"pcre2_substitute_8\",\"PCRE2_ERROR_TOOLARGEREPLACE(-70)\",f\"{SB}:1780\",\"a PCRE2_SIZE addition of accumulated lengths overflowed (TOOLARGEREPLACE label)\",\n  \"UNREACHABLE\",\n  \"requires the required output length to exceed 2^64-1\")\nR(\"pcre2_substitute_8\",\"PCRE2_ERROR_BADREPESCAPE(-57)\",f\"{SB}:1585\",\"extended mode: check_escape returned ESC_g but the next code unit is not '<'\",\n  \"UNREACHABLE\",\n  \"_pcre2_check_escape() only returns ESC_g when the escape is \\\\g< , so ptr always points at '<' here\")\n\n# ---------------------------------------------------------------- substring\nDFAMD = ('compile b\"(?<n>a)(?<o>b)\" opts 0; md = match_data_create_from_pattern(code); int ws[1000]; '\n         'pcre2_dfa_match(code, b\"ab\", 2, 0, 0, md, NULL, ws, 1000); ')\nfor fn, base, lines in [\n    (\"pcre2_substring_copy_byname_8\", \"copy\", (74, 78, 90, 90)),\n    (\"pcre2_substring_get_byname_8\",  \"get\",  (162, 166, 178, 178)),\n    (\"pcre2_substring_length_byname_8\",\"length\",(269, 273, 285, 285)),\n]:\n    call = {\"copy\":'pcre2_substring_copy_byname(md, b\"n\\\\0\", buf, &size)',\n            \"get\":'pcre2_substring_get_byname(md, b\"n\\\\0\", &ptr, &size)',\n            \"length\":'pcre2_substring_length_byname(md, b\"n\\\\0\", &size)'}[base]\n    callz = call.replace('b\"n\\\\0\"', 'b\"zz\\\\0\"')\n    R(fn,\"PCRE2_ERROR_DFA_UFUNC(-41)\",f\"{SS}:{lines[0]}\",\"match_data->matchedby == PCRE2_MATCHEDBY_DFA_INTERPRETER\",\n      DFAMD+call, \"the by-name functions need capture support, which the DFA matcher does not provide\")\n    R(fn,\"PCRE2_ERROR_NOSUBSTRING(-49)\",f\"{SS}:{lines[1]}\",\"pcre2_substring_nametable_scan() failed (name not found); its negative result is returned verbatim\",\n      'compile b\"(?<n>a)(?<o>b)\" opts 0; md = match_data_create_from_pattern(code); pcre2_match(code, b\"ab\", 2, 0, 0, md, NULL); '+callz,\n      \"PCRE2_ERROR_NOUNIQUESUBSTRING cannot occur here because firstptr/lastptr are non-NULL\")\n    R(fn,\"PCRE2_ERROR_UNAVAILABLE(-54)\",f\"{SS}:{lines[2]}\",\"no entry with that name has a group number < match_data->oveccount (failrc is never updated)\",\n      'compile b\"(?<n>a)(?<o>b)\" opts 0; md = pcre2_match_data_create(1, NULL); pcre2_match(code, b\"ab\", 2, 0, 0, md, NULL) (returns 0); '+call,\n      \"group n is number 1 but the ovector holds only pair 0\")\n    R(fn,\"PCRE2_ERROR_UNSET(-55)\",f\"{SS}:{lines[3]}\",\"every entry with that name is in the ovector but its start offset is PCRE2_UNSET\",\n      'compile b\"(?<n>a)|c\" opts 0; md = match_data_create_from_pattern(code); pcre2_m