or pat in &pats {\n            let mut cc = Ctr::new();\n            let mut rc_ = Ctr::new();\n            c200_scenario(c, &mut *cc as *mut Ctr, pat);\n            c200_scenario(r, &mut *rc_ as *mut Ctr, pat);\"\"\",\n\"\"\"    let long_name_pat = {\n        // >20 named groups forces the heap-allocated named-group list, and a\n        // long pattern forces the heap-allocated parsed-pattern workspace.\n        let mut p = Vec::new();\n        for i in 0..30 {\n            p.extend_from_slice(format!(\"(?<n{}>a)\", i).as_bytes());\n        }\n        for _ in 0..1500 {\n            p.push(b'z');\n        }\n        p\n    };\n    let long_subj = {\n        let mut s = vec![b'a'; 30];\n        s.extend(std::iter::repeat(b'z').take(1500));\n        s\n    };\n    let pats: Vec<(Vec<u8>, Vec<u8>)> = vec![\n        (\n            b\"(?<n>a)(b)c\\\\\\\\1|x{2,4}[[:alpha:]]+(?C1)\".to_vec(),\n            b\"zzabcaxxqq\".to_vec(),\n        ),\n        (b\"a\".to_vec(), b\"bbba\".to_vec()),\n        (long_name_pat, long_subj),\n    ];\n    unsafe {\n        for (pat, subj) in &pats {\n            let mut cc = Ctr::new();\n            let mut rc_ = Ctr::new();\n            c200_scenario(c, &mut *cc as *mut Ctr, pat, subj);\n            c200_scenario(r, &mut *rc_ as *mut Ctr, pat, subj);\"\"\")\nopen(p,'w').write(s)\nPYEOF\ngrep -n \"c200_scenario\\|let pats: Vec<(Vec<u8>, Vec<u8>)>\" tests/configs_info_convert.rs"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1769,"cache_read_input_tokens":188863,"cache_creation":{"ephemeral_5m_input_tokens":1769,"ephemeral_1h_input_tokens":0},"output_tokens":17,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_013qZpUC2GEF1G9qxZU9u1vo","session_id":"a4f10895-a33e-435f-9410-97f386d0c503","uuid":"6c05860c-c1da-447c-87f9-cc26453e343a","timestamp":"2026-09-08T19:38:25.240Z","subagent_type":"general-purpose","task_description":"Tests fo