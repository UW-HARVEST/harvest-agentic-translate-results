b\\\"$'\\\", 2, buf, &blen)\",\n  \"the subject must produce a complete match, otherwise -2 is returned earlier\")\nR(\"pcre2_substitute_8\",\"PCRE2_ERROR_PARTIALSUBS(-76)\",f\"{SB}:1172\",\"$_ (the whole input) used while a partial-matching option is set\",\n  'compile b\"abc\" opts 0; '+SUBHDR+'pcre2_substitute(code, b\"abcd\", 4, 0, PCRE2_PARTIAL_SOFT|PCRE2_SUBSTITUTE_REPLACEMENT_ONLY, NULL, NULL, b\"$_\", 2, buf, &blen)',\n  \"\")\nR(\"pcre2_substitute_8\",\"PCRE2_ERROR_NOSUBSTRING(-49)\",f\"{SB}:1193\",\"$+ used when the pattern has no capture groups and PCRE2_SUBSTITUTE_UNKNOWN_UNSET is clear\",\n  'compile b\"abc\" opts 0; '+SUBHDR+'pcre2_substitute(code, b\"abc\", 3, 0, 0, NULL, NULL, b\"$+\", 2, buf, &blen)',\n  \"\")\nR(\"pcre2_substitute_8\",\"PCRE2_ERROR_UNAVAILABLE(-54)\",f\"{SB}:1204\",\"$+ used when match_data->oveccount < code->top_bracket + 1\",\n  'compile b\"(a)(b)\" opts 0; md = pcre2_match_data_create(1, NULL); '+SUBHDR+'pcre2_substitute(code, b\"ab\", 2, 0, 0, md, NULL, b\"$+\", 2, buf, &blen)',\n  \"the ovector must be able to hold every group for $+ to be meaningful\")\nR(\"pcre2_substitute_8\",\"PCRE2_ERROR_UNSET(-55)\",f\"{SB}:1213\",\"$+ used when every capture group is unset and PCRE2_SUBSTITUTE_UNSET_EMPTY is clear\",\n  'compile b\"(a)?b\" opts 0; '+SUBHDR+'pcre2_substitute(code, b\"b\", 1, 0, 0, NULL, NULL, b\"$+\", 2, buf, &blen)',\n  \"\")\nR(\"pcre2_substitute_8\",\"PCRE2_ERROR_NOSUBSTRING(-49)\",f\"{SB}:1265\",\"a numeric group reference greater than code->top_bracket and PCRE2_SUBSTITUTE_UNKNOWN_UNSET is clear\",\n  'compile b\"(a)\" opts 0; '+SUBHDR+'pcre2_substitute(code, b\"a\", 1, 0, 0, NULL, NULL, b\"$9\", 2, buf, &blen)',\n  \"\")\nR(\"pcre2_substitute_8\",\"PCRE2_ERROR_BADSUBSTITUTION(-59)\",f\"{SB}:1296\",\"in ${...:X} extended form, X is neither '+' nor '-'\",\n  'compile b\"(a)\" opts 0; '+SUBHDR+'pcre2_substitute(code, b\"a\", 1, 0, PCRE2_SUBSTITUTE_EXTENDED, NULL, NULL, b\"${1:x}\", 6, buf, &blen)',\n  \"requires PCRE2