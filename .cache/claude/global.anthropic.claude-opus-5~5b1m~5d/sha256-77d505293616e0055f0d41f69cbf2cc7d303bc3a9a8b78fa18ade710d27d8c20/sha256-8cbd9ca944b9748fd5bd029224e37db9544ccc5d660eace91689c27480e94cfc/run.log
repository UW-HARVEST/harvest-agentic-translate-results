       (($ch as u32) | 0x20u32) == 0x69u32 || (($ch as u32) | 1u32) == 0x0131u32\n480\t    };\n481\t}\n482\t\n483\t#[macro_export]\n484\tmacro_rules! UCD_DOTTED_I {\n485\t    ($ch:expr) => {\n486\t        ($ch as u32) == 0x69u32 || ($ch as u32) == 0x0130u32\n487\t    };\n488\t}\n489\t\n490\t#[macro_export]\n491\tmacro_rules! UCD_FOLD_I_TURKISH {\n492\t    ($ch:expr) => {\n493\t        if ($ch as u32) == 0x0130u32 {\n494\t            0x69u32\n495\t        } else if ($ch as u32) == 0x49u32 {\n496\t            0x0131u32\n497\t        } else {\n498\t            $ch as u32\n499\t        }\n500\t    };\n501\t}\n502\t\n503\t/* ---------------- Newline testing ---------------- */\n504\t\n505\t/// The body of the IS_NEWLINE macro; the caller supplies the fields of its\n506\t/// own \"NLBLOCK\".\n507\t#[inline]\n508\tpub unsafe fn is_newline_block(\n509\t    p: crate::types::PCRE2_SPTR,\n510\t    nltype: u32,\n511\t    nllen: *mut u32,\n512\t    nl: *const u8,\n513\t    psend: crate::types::PCRE2_SPTR,\n514\t    utf: crate::types::BOOL,\n515\t) -> crate::types::BOOL {\n516\t    if nltype != crate::consts::NLTYPE_FIXED {\n517\t        (p < psend && crate::newline::_pcre2_is_newline_8(p, nltype, psend, nllen, utf) != 0)\n518\t            as crate::types::BOOL\n519\t    } else {\n520\t        (p <= psend.wrapping_sub(*nllen as usize)\n521\t            && *p == *nl\n522\t            && (*nllen == 1 || *p.add(1) == *nl.add(1))) as crate::types::BOOL\n523\t    }\n524\t}\n525\t\n526\t/// The body of the WAS_NEWLINE macro.\n527\t#[inline]\n528\tpub unsafe fn was_newline_block(\n529\t    p: crate::types::PCRE2_SPTR,\n530\t    nltype: u32,\n531\t    nllen: *mut u32,\n532\t    nl: *const u8,\n533\t    psstart: crate::types::PCRE2_SPTR,\n534\t    utf: crate::types::BOOL,"}]},"parent_tool_use_id":"toolu_bdrk_019pov4HGZ8dmNfXQaYbojUc","session_id":"a4f10895-a33e-435f-9410-97f386d0c503","uuid":"fae2ad07-5496-4144-bb6a-f5efb5657e78","timestamp":"2026-09-08T19:47:24.195Z","subagent_type":"gen