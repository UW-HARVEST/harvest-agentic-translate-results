e left untouched).\n#[inline]\nunsafe fn bf_set(p: *mut ConfigFlags, shift: u32, width: u32, value: c_uint) {\n    let b = p as *mut u8;\n    let mask = ((1u32 << width) - 1) as u8;\n    let byte: u8 = core::ptr::read_volatile(b);\n    core::ptr::write_volatile(b, (byte & !(mask << shift)) | (((value as u8) & mask) << shift));\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2012,"cache_read_input_tokens":131125,"cache_creation":{"ephemeral_5m_input_tokens":2012,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"de85969e-7c50-46fb-a11e-740442c8c583","uuid":"927246b1-130e-44e8-bb7f-b30846bf201f","timestamp":"2026-09-03T11:59:11.880Z"}
