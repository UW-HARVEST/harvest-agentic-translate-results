 4],\n86\t}\n87\t\n88\tconst VERBOSE_SHIFT: u32 = 0;\n89\tconst DEBUG_SHIFT: u32 = 1;\n90\tconst OPTIMIZE_SHIFT: u32 = 2;\n91\tconst CACHE_ENABLED_SHIFT: u32 = 3;\n92\tconst LOG_LEVEL_SHIFT: u32 = 4;\n93\tconst RESERVED_SHIFT: u32 = 7;\n94\t\n95\timpl ConfigFlags {\n96\t    #[inline]\n97\t    fn get(&self, shift: u32, width: u32) -> c_uint {\n98\t        ((self.storage[0] >> shift) as c_uint) & ((1u32 << width) - 1)\n99\t    }\n100\t\n101\t    /// Read-modify-write of byte 0 only, exactly as gcc codegens a bit-field\n102\t    /// store for this layout.\n103\t    #[inline]\n104\t    fn set(&mut self, shift: u32, width: u32, value: c_uint) {\n105\t        let mask = ((1u32 << width) - 1) as u8;\n106\t        let byte = self.storage[0];\n107\t        self.storage[0] = (byte & !(mask << shift)) | (((value as u8) & mask) << shift);\n108\t    }\n109\t\n110\t    #[inline]\n111\t    fn verbose(&self) -> c_uint {\n112\t        self.get(VERBOSE_SHIFT, 1)\n113\t    }\n114\t    #[inline]\n115\t    fn debug(&self) -> c_uint {\n116\t        self.get(DEBUG_SHIFT, 1)\n117\t    }\n118\t    #[inline]\n119\t    fn optimize(&self) -> c_uint {\n120\t        self.get(OPTIMIZE_SHIFT, 1)\n121\t    }\n122\t    #[inline]\n123\t    fn cache_enabled(&self) -> c_uint {\n124\t        self.get(CACHE_ENABLED_SHIFT, 1)\n125\t    }\n126\t    #[inline]\n127\t    fn log_level(&self) -> c_uint {\n128\t        self.get(LOG_LEVEL_SHIFT, 3)\n129\t    }\n130\t\n131\t    #[inline]\n132\t    fn set_verbose(&mut self, v: c_uint) {\n133\t        self.set(VERBOSE_SHIFT, 1, v)\n134\t    }\n135\t    #[inline]\n136\t    fn set_debug(&mut self, v: c_uint) {\n137\t        self.set(DEBUG_SHIFT, 1, v)\n138\t    }\n139\t    #[inline]\n140\t    fn set_optimize(&mut self, v: c_uint) {\n141\t        self.set(OPTIMIZE_SHIFT, 1, v)\n142\t    }\n143\t    #[inline]\n144\t    fn set_cache_enabled(&mut self, v: c_uint) {\n145\t        self.set(CACHE_ENABLED_SHIFT, 1, v)\n146\t    }\n147\t    #[inline]\n148\t    fn set_log_level