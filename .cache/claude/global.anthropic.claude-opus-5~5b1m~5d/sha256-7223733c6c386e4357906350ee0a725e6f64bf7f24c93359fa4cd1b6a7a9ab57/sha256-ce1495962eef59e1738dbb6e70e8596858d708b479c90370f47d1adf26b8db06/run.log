(\"smoke/window\", b\"hello world\", Some(2), Some(7));","+    s.row(\"happy_path_matches\", || {","+        assert_same_str(\"smoke/whole\", b\"hello world\", None, None);","+        assert_same_str(\"smoke/suffix\", b\"hello world\", Some(6), None);","+        assert_same_str(\"smoke/prefix\", b\"hello world\", None, Some(5));","+        assert_same_str(\"smoke/window\", b\"hello world\", Some(2), Some(7));","+    });","+","+    s.finish();"," }"]}],"originalFile":"//! Harness self-check: both `.so`s load, export `slice`, and the fd-level\n//! stdout capture actually observes what the loaded library printed.\n\nmod common;\n\nuse common::*;\n\n#[test]\nfn both_libraries_load_and_export_slice() {\n    let c = c_so_path();\n    let r = rust_so_path();\n    assert!(c.exists(), \"missing {}\", c.display());\n    assert!(r.exists(), \"missing {}\", r.display());\n    // Resolving the symbols panics inside the harness if either is absent.\n    let _ = slice_fn(Impl::C);\n    let _ = slice_fn(Impl::Rust);\n}\n\n#[test]\nfn capture_sees_the_printed_slice() {\n    // Sanity: the capture must be non-empty and end in the newline that\n    // `printf(\"%.*s\\n\", ...)` appends.\n    let out = call(Impl::C, b\"hello\\0\", None, None);\n    assert_eq!(out.ret, 0);\n    assert_eq!(out.stdout, b\"hello\\n\", \"captured {:?}\", out.stdout);\n\n    let out = call(Impl::Rust, b\"hello\\0\", None, None);\n    assert_eq!(out.ret, 0);\n    assert_eq!(out.stdout, b\"hello\\n\", \"captured {:?}\", out.stdout);\n}\n\n#[test]\nfn capture_sees_the_error_message() {\n    let too_far: i32 = 99;\n    let out = call(Impl::C, b\"hello\\0\", Some(too_far), None);\n    assert_eq!(out.ret, 1);\n    assert_eq!(out.stdout, b\"Error: start is off the end of the string!\\n\");\n}\n\n#[test]\nfn happy_path_matches() {\n    assert_same_str(\"smoke/whole\", b\"hello world\", None, None);\n    assert_same_str(\"smoke/suffix\", b\"hello world\", Some(6), None);\n    assert_same_str(\"smoke/prefix\", b\"hello world\", None, Some(5));\n    assert_same_str(\"smoke/window\", b\"hello world\", Some(2), Some(7));\n}\n","userModified":false}}
