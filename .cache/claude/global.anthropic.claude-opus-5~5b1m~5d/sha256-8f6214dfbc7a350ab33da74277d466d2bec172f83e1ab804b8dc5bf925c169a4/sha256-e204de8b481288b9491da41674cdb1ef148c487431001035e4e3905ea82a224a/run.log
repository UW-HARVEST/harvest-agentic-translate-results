acunarity, gain, offset, octaves),\n61\t        3 => stb_perlin_fbm_noise3(x, y, z, lacunarity, gain, octaves),\n62\t        4 => stb_perlin_turbulence_noise3(x, y, z, lacunarity, gain, octaves),\n63\t        5 => stb_perlin_noise3_wrap_nonpow2(x, y, z, x_wrap, y_wrap, z_wrap, seed as u8),\n64\t        _ => f32::NAN,\n65\t    }\n66\t}\n67\t\n68\tfn main() {\n69\t    let mut which: i32 = 0;\n70\t    let mut x: f32 = 0.0;\n71\t    let mut y: f32 = 0.0;\n72\t    let mut z: f32 = 0.0;\n73\t    let mut x_wrap: i32 = 0;\n74\t    let mut y_wrap: i32 = 0;\n75\t    let mut z_wrap: i32 = 0;\n76\t    let mut seed: i32 = 0;\n77\t    let mut lacunarity: f32 = 0.0;\n78\t    let mut gain: f32 = 0.0;\n79\t    let mut offset: f32 = 0.0;\n80\t    let mut octaves: i32 = 0;\n81\t\n82\t    let mut input = Vec::new();\n83\t    let _ = std::io::stdin().read_to_end(&mut input);\n84\t    let mut sc = Scanner::new(input);\n85\t\n86\t    // scanf(\"%d%f%f%f%d%d%d%d%f%f%f%d\", ...): conversions stop at the first\n87\t    // matching/input failure, leaving the remaining variables untouched.\n88\t    'scan: {\n89\t        match sc.scan_int() {\n90\t            Some(v) => which = v,\n91\t            None => break 'scan,\n92\t        }\n93\t        match sc.scan_f32() {\n94\t            Some(v) => x = v,\n95\t            None => break 'scan,\n96\t        }\n97\t        match sc.scan_f32() {\n98\t            Some(v) => y = v,\n99\t            None => break 'scan,\n100\t        }\n101\t        match sc.scan_f32() {\n102\t            Some(v) => z = v,\n103\t            None => break 'scan,\n104\t        }\n105\t        match sc.scan_int() {\n106\t            Some(v) => x_wrap = v,\n107\t            None => break 'scan,\n108\t        }\n109\t        match sc.scan_int() {\n110\t            Some(v) => y_wrap = v,\n111\t            None => break 'scan,\n112\t        }\n113\t        match sc.scan_int() {\n114\t            Some(v) => z_wrap = v,\n115\t            None => break 'scan,\n116\t        }\n117\t