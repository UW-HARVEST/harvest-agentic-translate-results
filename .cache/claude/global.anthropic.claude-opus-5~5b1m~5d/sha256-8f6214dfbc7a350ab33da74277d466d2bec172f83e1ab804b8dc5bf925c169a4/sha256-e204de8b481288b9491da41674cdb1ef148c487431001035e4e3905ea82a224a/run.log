{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01BGQ7ScPvHg5FNAq1Un9e9W","type":"tool_result","content":"1\t//! C `printf(\"%.Ng\", value)` emulation for `double` arguments.\n2\t\n3\tpub fn format_g(v: f64, prec: usize) -> String {\n4\t    let prec = if prec == 0 { 1 } else { prec };\n5\t\n6\t    if v.is_nan() {\n7\t        return if v.is_sign_negative() {\n8\t            \"-nan\".to_string()\n9\t        } else {\n10\t            \"nan\".to_string()\n11\t        };\n12\t    }\n13\t    if v.is_infinite() {\n14\t        return if v < 0.0 {\n15\t            \"-inf\".to_string()\n16\t        } else {\n17\t            \"inf\".to_string()\n18\t        };\n19\t    }\n20\t\n21\t    // Round to `prec` significant digits using scientific notation to learn the\n22\t    // decimal exponent that %g uses to pick its style.\n23\t    let sci = format!(\"{:.*e}\", prec - 1, v);\n24\t    let (mant, exp_str) = sci.split_once('e').expect(\"rust e-format has exponent\");\n25\t    let exp: i32 = exp_str.parse().expect(\"valid exponent\");\n26\t\n27\t    if exp < -4 || exp >= prec as i32 {\n28\t        let mant = strip_trailing_zeros(mant);\n29\t        let (sign, digits) = if exp < 0 {\n30\t            ('-', (-(exp as i64)) as u64)\n31\t        } else {\n32\t            ('+', exp as u64)\n33\t        };\n34\t        format!(\"{}e{}{:02}\", mant, sign, digits)\n35\t    } else {\n36\t        let frac_digits = (prec as i32 - 1 - exp) as usize;\n37\t        let s = format!(\"{:.*}\", frac_digits, v);\n38\t        strip_trailing_zeros(&s)\n39\t    }\n40\t}\n41\t\n42\tfn strip_trailing_zeros(s: &str) -> String {\n43\t    if !s.contains('.') {\n44\t        return s.to_string();\n45\t    }\n46\t    let t = s.trim_end_matches('0');\n47\t    let t = t.strip_suffix('.').unwrap_or(t);\n48\t    t.to_string()\n49\t}\n50\t"}]},"parent_tool_use_id":null,"session_id":"4f1a6bb1-77a1-4ee5-b2c3-fe252a860f67","uuid":"b55dbe7d-0829-4048-9e05-02c74f010d7e","timestamp":"2026-08-28T21:07:33.687Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-z8Mta6/translation/src/cformat.rs","content":"//! C `printf(\"%.Ng\", value)` emulation for `double` arguments.\n\npub fn format_g(v: f64, prec: usize) -> String {\n    let prec = if prec == 0 { 1 } else { prec };\n\n    if v.is_nan() {\n        return if v.is_sign_negative() {\n            \"-nan\".to_string()\n        } else {\n            \"nan\".to_string()\n        };\n    }\n    if v.is_infinite() {\n        return if v < 0.0 {\n            \"-inf\".to_string()\n        } else {\n            \"inf\".to_string()\n        };\n    }\n\n    // Round to `prec` significant digits using scientific notation to learn the\n    // decimal exponent that %g uses to pick its style.\n    let sci = format!(\"{:.*e}\", prec - 1, v);\n    let (mant, exp_str) = sci.split_once('e').expect(\"rust e-format has exponent\");\n    let exp: i32 = exp_str.parse().expect(\"valid exponent\");\n\n    if exp < -4 || exp >= prec as i32 {\n        let mant = strip_trailing_zeros(mant);\n        let (sign, digits) = if exp < 0 {\n            ('-', (-(exp as i64)) as u64)\n        } else {\n            ('+', exp as u64)\n        };\n        format!(\"{}e{}{:02}\", mant, sign, digits)\n    } else {\n        let frac_digits = (prec as i32 - 1 - exp) as usize;\n        let s = format!(\"{:.*}\", frac_digits, v);\n        strip_trailing_zeros(&s)\n    }\n}\n\nfn strip_trailing_zeros(s: &str) -> String {\n    if !s.contains('.') {\n        return s.to_string();\n    }\n    let t = s.trim_end_matches('0');\n    let t = t.strip_suffix('.').unwrap_or(t);\n    t.to_string()\n}\n","numLines":50,"startLine":1,"totalLines":50}}}
