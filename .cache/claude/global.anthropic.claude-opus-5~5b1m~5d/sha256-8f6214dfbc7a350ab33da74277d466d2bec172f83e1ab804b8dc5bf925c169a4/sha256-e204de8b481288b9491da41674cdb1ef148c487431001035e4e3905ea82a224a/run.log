{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01AVyYUH6QNiBxnoiWrA3ScN","type":"tool_result","content":"1\t//! Models the x86-64 SSE scalar single-precision operations that the C\n2\t//! compiler emits, including their NaN propagation rules:\n3\t//!\n4\t//! * `OP dst, src` returns `dst`'s NaN (quieted) if `dst` is a NaN,\n5\t//!   otherwise `src`'s NaN (quieted) if `src` is a NaN.\n6\t//! * An invalid operation on non-NaN operands (inf - inf, 0 * inf) produces\n7\t//!   the \"indefinite\" QNaN `0xFFC00000`.\n8\t//!\n9\t//! Spelling the operations out this way keeps the results independent of the\n10\t//! Rust optimizer, which is otherwise free to alter the sign of NaN results.\n11\t\n12\t/// x86 \"real indefinite\" QNaN.\n13\tconst INDEFINITE: u32 = 0xFFC0_0000;\n14\t\n15\tfn indefinite() -> f32 {\n16\t    f32::from_bits(INDEFINITE)\n17\t}\n18\t\n19\tfn quiet(x: f32) -> f32 {\n20\t    f32::from_bits(x.to_bits() | 0x0040_0000)\n21\t}\n22\t\n23\t/// `addss dst, src`\n24\tpub fn addss(dst: f32, src: f32) -> f32 {\n25\t    if dst.is_nan() {\n26\t        return quiet(dst);\n27\t    }\n28\t    if src.is_nan() {\n29\t        return quiet(src);\n30\t    }\n31\t    if dst.is_infinite() && src.is_infinite() && dst.is_sign_negative() != src.is_sign_negative() {\n32\t        return indefinite();\n33\t    }\n34\t    dst + src\n35\t}\n36\t\n37\t/// `subss dst, src`\n38\tpub fn subss(dst: f32, src: f32) -> f32 {\n39\t    if dst.is_nan() {\n40\t        return quiet(dst);\n41\t    }\n42\t    if src.is_nan() {\n43\t        return quiet(src);\n44\t    }\n45\t    if dst.is_infinite() && src.is_infinite() && dst.is_sign_negative() == src.is_sign_negative() {\n46\t        return indefinite();\n47\t    }\n48\t    dst - src\n49\t}\n50\t\n51\t/// `mulss dst, src`\n52\tpub fn mulss(dst: f32, src: f32) -> f32 {\n53\t    if dst.is_nan() {\n54\t        return quiet(dst);\n55\t    }\n56\t    if src.is_nan() {\n57\t        return quiet(src);\n58\t    }\n59\t    if (dst == 0.0 && src.is_infinite()) || (src == 0.0 && dst.is_infinite()) {\n60\t        return indefinite();\n61\t    }\n62\t    dst * src\n63\t}\n64\t\n65\t/// `andps` with a 0x7FFFFFFF mask, i.e. C's `fabsf`.\n66\tpub fn fabs(x: f32) -> f32 {\n67\t    f32::from_bits(x.to_bits() & 0x7FFF_FFFF)\n68\t}\n69\t"}]},"parent_tool_use_id":null,"session_id":"4f1a6bb1-77a1-4ee5-b2c3-fe252a860f67","uuid":"d2d08377-7562-4df5-8f51-26bee172751d","timestamp":"2026-08-28T21:07:26.225Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-z8Mta6/translation/src/sse.rs","content":"//! Models the x86-64 SSE scalar single-precision operations that the C\n//! compiler emits, including their NaN propagation rules:\n//!\n//! * `OP dst, src` returns `dst`'s NaN (quieted) if `dst` is a NaN,\n//!   otherwise `src`'s NaN (quieted) if `src` is a NaN.\n//! * An invalid operation on non-NaN operands (inf - inf, 0 * inf) produces\n//!   the \"indefinite\" QNaN `0xFFC00000`.\n//!\n//! Spelling the operations out this way keeps the results independent of the\n//! Rust optimizer, which is otherwise free to alter the sign of NaN results.\n\n/// x86 \"real indefinite\" QNaN.\nconst INDEFINITE: u32 = 0xFFC0_0000;\n\nfn indefinite() -> f32 {\n    f32::from_bits(INDEFINITE)\n}\n\nfn quiet(x: f32) -> f32 {\n    f32::from_bits(x.to_bits() | 0x0040_0000)\n}\n\n/// `addss dst, src`\npub fn addss(dst: f32, src: f32) -> f32 {\n    if dst.is_nan() {\n        return quiet(dst);\n    }\n    if src.is_nan() {\n        return quiet(src);\n    }\n    if dst.is_infinite() && src.is_infinite() && dst.is_sign_negative() != src.is_sign_negative() {\n        return indefinite();\n    }\n    dst + src\n}\n\n/// `subss dst, src`\npub fn subss(dst: f32, src: f32) -> f32 {\n    if dst.is_nan() {\n        return quiet(dst);\n    }\n    if src.is_nan() {\n        return quiet(src);\n    }\n    if dst.is_infinite() && src.is_infinite() && dst.is_sign_negative() == src.is_sign_negative() {\n        return indefinite();\n    }\n    dst - src\n}\n\n/// `mulss dst, src`\npub fn mulss(dst: f32, src: f32) -> f32 {\n    if dst.is_nan() {\n        return quiet(dst);\n    }\n    if src.is_nan() {\n        return quiet(src);\n    }\n    if (dst == 0.0 && src.is_infinite()) || (src == 0.0 && dst.is_infinite()) {\n        return indefinite();\n    }\n    dst * src\n}\n\n/// `andps` with a 0x7FFFFFFF mask, i.e. C's `fabsf`.\npub fn fabs(x: f32) -> f32 {\n    f32::from_bits(x.to_bits() & 0x7FFF_FFFF)\n}\n","numLines":69,"startLine":1,"totalLines":69}}}
