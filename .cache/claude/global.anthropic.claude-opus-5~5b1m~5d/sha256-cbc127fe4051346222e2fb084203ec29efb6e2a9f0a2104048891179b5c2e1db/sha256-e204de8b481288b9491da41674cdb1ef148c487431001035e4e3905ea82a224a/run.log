{\n48\t    // house->floors++;  (wrapping mirrors the typical hardware behavior of the\n49\t    // C signed-overflow case)\n50\t    house.floors = house.floors.wrapping_add(1);\n51\t}\n52\t\n53\tfn add_bedrooms(house: &mut House, extra_bedrooms: i32) {\n54\t    // house->bedrooms += extra_bedrooms;\n55\t    house.bedrooms = house.bedrooms.wrapping_add(extra_bedrooms);\n56\t}\n57\t\n58\tfn add_floor_to_the_house() {\n59\t    THE_HOUSE.with(|h| add_floor(&mut h.borrow_mut()));\n60\t}\n61\t\n62\tfn print_the_house() {\n63\t    let house = THE_HOUSE.with(|h| *h.borrow());\n64\t    let stdout = std::io::stdout();\n65\t    let mut out = stdout.lock();\n66\t    let _ = write!(\n67\t        out,\n68\t        \"The house has {} floors, {} bedrooms, and {:.1} bathrooms\\n\",\n69\t        house.floors, house.bedrooms, house.bathrooms\n70\t    );\n71\t}\n72\t\n73\tfn run(extra_bedrooms: i32) {\n74\t    print_the_house();\n75\t    add_floor_to_the_house();\n76\t    print_the_house();\n77\t    THE_HOUSE.with(|h| h.borrow_mut().bathrooms += 1.0);\n78\t    print_the_house();\n79\t    THE_HOUSE.with(|h| add_bedrooms(&mut h.borrow_mut(), extra_bedrooms));\n80\t    print_the_house();\n81\t}\n82\t\n83\t/// Emulates `strtol(str, &endp, 10)` combined with the C checks:\n84\t/// `endp != str && errno == 0 && tmp >= INT_MIN && tmp <= INT_MAX`.\n85\t///\n86\t/// `str` is the NUL-terminated C string content (without the terminator).\n87\tfn parse_val(str_bytes: &[u8]) -> Option<i32> {\n88\t    let mut i = 0usize;\n89\t\n90\t    // strtol skips leading whitespace as recognized by isspace().\n91\t    while i < str_bytes.len()\n92\t        && matches!(str_bytes[i], b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r')\n93\t    {\n94\t        i += 1;\n95\t    }\n96\t\n97\t    // Optional sign.\n98\t    let mut negative = false;\n99\t    if i < str_bytes.len() && (str_bytes[i] == b'+' || str_bytes[i] == b'-') {\n100\t        negative = str_bytes[i] == b'-';\n101\t        i += 1;\n102\t    }\n103\t\n104\