   } else {\n                None\n            }\n        })\n        .collect()\n}\n\nfn all_dynamic_symbols(so: &Path) -> BTreeSet<String> {\n    let out = Command::new(\"nm\")\n        .args([\"-D\", so.to_str().unwrap()])\n        .output()\n        .expect(\"run nm -D\");\n    String::from_utf8_lossy(&out.stdout)\n        .lines()\n        .filter_map(|l| l.split_whitespace().last().map(|s| s.to_string()))\n        .collect()\n}\n\n#[test]\nfn c_defined_symbols_are_all_exported_by_rust() {\n    let c_syms = defined_dynamic_symbols(&c_so_path());\n    assert!(\n        c_syms.contains(\"next_double\"),\n        \"sanity: C .so must export next_double, got {c_syms:?}\"\n    );\n\n    for profile in [\"dev\", \"release\"] {\n        let r_syms = defined_dynamic_symbols(&rust_so_path(profile));\n        let missing: Vec<&String> = c_syms.difference(&r_syms).collect();\n        assert!(\n            missing.is_empty(),\n            \"Rust .so ({profile}) is MISSING {} symbol(s) exported by the C .so: {missing:?}\\n\\\n             C   defined: {c_syms:?}\\n\\\n             {profile} defined: {r_syms:?}\",\n            missing.len()\n        );\n    }\n}\n\n#[test]\nfn c_weak_boilerplate_symbols_also_present() {\n    // The four weak/undefined toolchain symbols listed in SYMBOLS.md.\n    let c_all = all_dynamic_symbols(&c_so_path());\n    for profile in [\"dev\", \"release\"] {\n        let r_all = all_dynamic_symbols(&rust_so_path(profile));\n        let missing: Vec<&String> = c_all.difference(&r_all).collect();\n        assert!(\n            missing.is_empty(),\n            \"Rust .so ({profile}) does not reference {} symbol(s) the C .so does: {missing:?}\",\n            missing.len()\n        );\n    }\n}\n\n#[test]\nfn every_c_symbol_is_callable_through_dlsym() {\n    // A symbol that only *appears* in nm but traps/stubs when called would be\n    // worse than a missing one, so actually invoke each exported function.\n    for_each_pair(|c, r| {\n        let mut rng = SplitMix64::new(SEED ^ 0xD1);\n        for _ in 0..256 {\n            assert_one(\n                c,\n                r,\n                CnRnd::new(rng.next_u64(), rng.next_u64()),\n                \"symbol smoke test\",\n            );\n        }\n    });\n}\n\n#[test]\nfn record_symbol_tables() {\n    // Refresh the on-disk artifact referenced by SYMBOLS.md.\n    let mut text = String::new();\n    text.push_str(\"# generated by tests/symbol_parity.rs::record_symbol_tables\\n\");\n    for (label, path) in [\n        (\"C\".to_string(), c_so_path()),\n        (\"rust-dev\".to_string(), rust_so_path(\"dev\")),\n        (\"rust-release\".to_string(), rust_so_path(\"release\")),\n    ] {\n        text.push_str(&format!(\"\\n## {label} ({})\\n\", path.display()));\n        for s in defined_dynamic_symbols(&path) {\n            text.push_str(&format!(\"DEFINED {s}\\n\"));\n        }\n    }\n    let _ = std::fs::write(manifest_dir().join(\"rust_syms.txt\"), text);\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
