ount = (*table).tombstone_count.wrapping_add(1);\n1050\t        set_stbds_temp(raw_a, 1);\n1051\t        (*b).hash[i as usize] = STBDS_HASH_DELETED;\n1052\t        (*b).index[i as usize] = STBDS_INDEX_DELETED;\n1053\t\n1054\t        if mode == STBDS_HM_STRING && (*table).string.mode == STBDS_SH_STRDUP {\n1055\t            stbds_free(\n1056\t                *(elem_at(a, elemsize, old_index as usize, 0) as *mut *mut c_char) as *mut c_void,\n1057\t            );\n1058\t        }\n1059\t\n1060\t        if old_index != final_index {\n1061\t            memmove(\n1062\t                elem_at(a, elemsize, old_index as usize, 0) as *mut c_void,\n1063\t                elem_at(a, elemsize, final_index as usize, 0) as *const c_void,\n1064\t                elemsize,\n1065\t            );\n1066\t\n1067\t            if mode == STBDS_HM_STRING {\n1068\t                let k = *(elem_at(a, elemsize, old_index as usize, keyoffset)\n1069\t                    as *mut *mut c_char);\n1070\t                slot = stbds_hm_find_slot(a, elemsize, k as *mut c_void, keysize, keyoffset, mode);\n1071\t            } else {\n1072\t                let k = elem_at(a, elemsize, old_index as usize, keyoffset);\n1073\t                slot = stbds_hm_find_slot(a, elemsize, k as *mut c_void, keysize, keyoffset, mode);\n1074\t            }\n1075\t            b = (*table)\n1076\t                .storage\n1077\t                .wrapping_add((slot >> STBDS_BUCKET_SHIFT) as usize);\n1078\t            i = ((slot as usize) & STBDS_BUCKET_MASK) as c_int;\n1079\t            (*b).index[i as usize] = old_index;\n1080\t        }\n1081\t        (*stbds_header(raw_a)).length -= 1;\n1082\t\n1083\t        if (*table).used_count < (*table).used_count_shrink_threshold\n1084\t            && (*table).slot_count > STBDS_BUCKET_LENGTH\n1085\t        {\n1086\t            (*stbds_header(raw_a)).hash_table =\n1087\t                stbds_make_hash_index((*table).slot_count >> 1, table) as *mut c_void;\n1088\t            stbds_f