so be zeroed by the memset\n    for mode in [1u8, 2, 3, 7, 255] {\n        let mut a = DualArena::new();\n        a.ac.mode = mode;\n        a.ar.mode = mode;\n        let mut s = mkstr(30, mode);\n        a.alloc(&mut s, \"arena with mode set\");\n        let (sc, _) = a.snap();\n        assert_eq!(sc.mode, mode, \"stralloc must not touch `mode`\");\n        a.reset(); // asserts mode == 0 afterwards\n    }\n    // many blocks (mixture of regular and dedicated)\n    {\"\"\")\nopen(p,'w').write(s)\n\n# 4) bigger key/element shapes for binary maps\np='tests/maps_binary.rs'\ns=open(p).read()\ns=s.replace(\"\"\"    (1, 1),   // minimum sizes\n    (4, 4),   // key == whole element\n];\"\"\",\"\"\"    (1, 1),   // minimum sizes\n    (4, 4),   // key == whole element\n    (12, 4),  // odd element size -> unaligned strides\n    (24, 16), // 16-byte key: two SipHash main-loop iterations\n    (32, 24), // 24-byte key: three SipHash main-loop iterations\n];\"\"\")\n# key_bytes must support keysize > 8\ns=s.replace(\"\"\"fn key_bytes(v: u64, keysize: usize) -> Vec<u8> {\n    v.to_le_bytes()[..keysize.min(8)]\n        .iter()\n        .copied()\n        .chain(std::iter::repeat(0))\n        .take(keysize)\n        .collect()\n}\"\"\",\"\"\"/// A `keysize`-byte key derived from `v`.  For `keysize > 8` the value is\n/// spread over the whole key (with a fixed multiplier per 8-byte lane) so that\n/// distinct `v` always give distinct keys and the SipHash main loop runs.\nfn key_bytes(v: u64, keysize: usize) -> Vec<u8> {\n    let mut out = Vec::with_capacity(keysize);\n    let mut lane = 0u64;\n    while out.len() < keysize {\n        let x = v\n            .wrapping_mul(0x9E37_79B9_7F4A_7C15)\n            .wrapping_add(lane.wrapping_mul(0x1234_5678_9ABC_DEF1))\n            ^ (if lane == 0 { 0 } else { v });\n        let bytes = if lane == 0 { v.to_le_bytes() } else { x.to_le_bytes() };\n        for b in bytes {\n            if out.len() == keysize {\n                break;\n      