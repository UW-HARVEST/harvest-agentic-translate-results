{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01WWqaMCYx9MNbGTNeX8dUB6","type":"tool_result","content":"1\t//! Rust translation of c_src/src/lib.c (stb_ds.h implementation, public domain / MIT,\n2\t//! Sean Barrett) plus the `strkey` / `arr_del` helpers defined in that file.\n3\t//!\n4\t//! The translation is deliberately literal: every quirk of the original C\n5\t//! (including integer promotion / sign-extension artefacts in the SipHash\n6\t//! byte-gathering code, and the missing `temp_key` store in the second probe\n7\t//! loop of `stbds_hmput_key`) is reproduced bit-for-bit.\n8\t\n9\t#![allow(non_camel_case_types)]\n10\t#![allow(non_snake_case)]\n11\t#![allow(non_upper_case_globals)]\n12\t#![allow(unused_assignments)]\n13\t#![allow(unused_variables)]\n14\t#![allow(clippy::missing_safety_doc)]\n15\t\n16\tuse core::ffi::{c_char, c_int, c_void};\n17\tuse core::ptr;\n18\t\n19\t// ---------------------------------------------------------------------------\n20\t// libc bindings (we use the platform allocator so that memory returned by this\n21\t// library is interchangeable with memory from the original C library).\n22\t// ---------------------------------------------------------------------------\n23\t\n24\tunsafe extern \"C\" {\n25\t    fn realloc(p: *mut c_void, size: usize) -> *mut c_void;\n26\t    fn free(p: *mut c_void);\n27\t    fn memset(s: *mut c_void, c: c_int, n: usize) -> *mut c_void;\n28\t    fn memmove(d: *mut c_void, s: *const c_void, n: usize) -> *mut c_void;\n29\t    fn memcpy(d: *mut c_void, s: *const c_void, n: usize) -> *mut c_void;\n30\t    fn memcmp(a: *const c_void, b: *const c_void, n: usize) -> c_int;\n31\t    fn strcmp(a: *const c_char, b: *const c_char) -> c_int;\n32\t    fn strlen(s: *const c_char) -> usize;\n33\t}\n34\t\n35\t/// `STBDS_REALLOC(c,p,s)` -> `realloc(p,s)`\n36\t#[inline]\n37\tunsafe fn stbds_realloc(p: *mut c_void, s: usize) -> *mut c_void {\n38\t    unsafe { realloc(p, s) }\n39\t}\n40\t\n41\t//