      || base.starts_with(\"i\")\n                || base.starts_with(\"n\")\n                || base.starts_with(\"r\")\n                || base.starts_with(\"u\")\n                || base.starts_with(\"d\")\n                || base.starts_with(\"t\")\n                || base.starts_with(\"v\")\n                || base.starts_with(\"w\")\n                || base.starts_with(\"q\")\n                || base.starts_with(\"h\")\n                || base.starts_with(\"j\")\n                || base.starts_with(\"k\")\n                || base.starts_with(\"o\")\n                || base.starts_with(\"g\")\n                || base.starts_with(\"z\");\n            if !ok {\n                bad.push(name.to_string());\n            }\n        }\n    }\n    // The real check: no *stbds_* / *arr_del* / *strkey* symbol may be undefined.\n    let unresolved_lib: Vec<&String> = bad\n        .iter()\n        .chain(\n            text.lines()\n                .filter(|l| l.contains(\" U \"))\n                .filter(|l| l.contains(\"stbds_\") || l.contains(\"arr_del\") || l.contains(\"strkey\"))\n                .map(|_| unreachable!())\n                .collect::<Vec<&String>>()\n                .iter(),\n        )\n        .collect();\n    assert!(unresolved_lib.is_empty(), \"unresolved symbols: {bad:?}\");\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
