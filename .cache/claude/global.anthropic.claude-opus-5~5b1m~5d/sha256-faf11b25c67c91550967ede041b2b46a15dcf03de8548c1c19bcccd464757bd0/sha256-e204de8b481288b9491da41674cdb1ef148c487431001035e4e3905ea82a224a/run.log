luded in all copies or substantial portions of the Software.\n    15\t * \n    16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    18\t * THE WARRANTIES OF MERCHANTABILITY,\n    19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    24\t */\n    25\t#include <string.h>\n    26\t#include <stddef.h>\n    27\t#include <stdint.h>\n    28\t#include <stdio.h>\n    29\t\n    30\t/* Forward declarations */\n    31\tstatic int validate_token(const char *token, const char *expected);\n    32\tstatic int parse_command(char *buffer, size_t buf_size, const char *cmd_list[], int list_size);\n    33\tstatic int compare_prefix(const char *str, const char *prefix, int exact_match);\n    34\tstatic int find_delimiter(const char *data, size_t len, char delim);\n    35\tstatic int match_pattern(const char *text, const char *pattern, int case_sensitive);\n    36\t\n    37\t/**\n    38\t * Main entrance function - performs various string comparison operations\n    39\t * \n    40\t * @param input Input string buffer\n    41\t * @param input_len Length of input buffer\n    42\t * @param reference Reference string for comparison\n    43\t * @param ref_len Length of reference buffer\n    44\t * @param operation Operation code:\n    45\t *                  0: validate token\n    46\t *                  1: parse command\n    47\t *                  2: compare prefix\n    48\t *                  3: find delimiter\n    49\t *                  4: match pattern\n    50\t * @param flags Operation flags (case sensitivity, exact match, etc)\n    51\t * @return Operation result (match count, position, or error code)\n    52\t */\n    53\tint process_strings(char *input, size_t input_len, \n    54\t                   const char *reference, size_t ref_len,\n    55\t                   int operation, uint32_t flags) {\n    56\t    \n    57\t    if (input == NULL) {\n    58\t        return -1;\n    59\t    }\n    60\t    \n    61\t    /* Different operations based on operation code */\n    62\t    switch (operation) {\n    63\t        case 0: {\n    64\t            /* Validate token - VULNERABLE if input not null-terminated */\n    65\t            if (reference == NULL) return -2;\n    66\t            return validate_token(input, reference);\n    67\t        }\n    68\t        \n    69\t        case 1: {\n    70\t            /* Parse command from list - checks against multiple strings */\n    71\t            const char *commands[] = {\"START\", \"STOP\", \"PAUSE\", \"RESUME\", \"RESET\"};\n    72\t            return parse_command(input, input_len, commands, 5);\n    73\t        }\n    74\t        \n    75\t        case 2: {\n    76\t            /* Compare prefix - can use strcmp or strncmp based on flags */\n    77\t            if (reference == NULL) return -2;\n    78\t            int exact = (flags & 0x01);\n    79\t            return compare_prefix(input, reference, exact);\n    80\t        }\n    81\t        \n    82\t        case 3: {\n    83\t            /* Find delimiter position */\n    84\t            char delim = (reference && ref_len > 0) ? reference[0] : ':';\n    85\t            return find_delimiter(input, input_len, delim);\n    86\t        }\n    87\t        \n    88\t        case 4: {\n    89\t            /* Match pattern - VULNERABLE in certain paths */\n    90\t            if (reference == NULL) return -2;\n    91\t            int case_sens = (flags & 0x02);\n    92\t            return match_pattern(input, reference, case_sens);\n    93\t        }\n    94\t        \n    95\t        default:\n    96\t            return -3;\n    97\t    }\n    98\t}\n    99\t\n   100\t/**\n   101\t * Validate token against expected value\n   102\t * VULNERABLE: Uses strcmp without ensuring null termination\n   103\t */\n   104\tstatic int validate_token(const char *token, const char *expected) {\n   105\t    /* Direct strcmp - will overflow if token not null-terminated */\n   106\t    if (strcmp(token, expected) == 0) {\n   107\t        return 1;  /* Valid */\n   108\t    }\n   109\t    \n   110\t    /* Also check some common variations */\n   111\t    if (strcmp(token, \"VALID\") == 0 || strcmp(token, \"OK\") == 0) {\n   112\t        return 1;\n   113\t    }\n   114\t    \n   115\t    return 0;  /* Invalid */\n   116\t}\n   117\t\n   118\t/**\n   119\t * Parse command from a list of valid commands\n   120\t * Mix of safe and unsafe comparisons\n   121\t */\n   122\tstatic int parse_command(char *buffer, size_t buf_size, \n   123\t                        const char *cmd_list[], int list_size) {\n   124\t    \n   125\t    /* Iterate through command list */\n   126\t    for (int i = 0; i < list_size; i++) {\n   127\t        /* Safe comparison using strncmp first */\n   128\t        size_t cmd_len = strlen(cmd_list[i]);\n   129\t        \n   130\t        if (buf_size >= cmd_len) {\n   131\t            if (strncmp(buffer, cmd_list[i], cmd_len) == 0) {\n   132\t                /* Check if exact match - VULNERABLE if buffer not null-terminated */\n   133\t                if (buffer[cmd_len] == '\\0' || buffer[cmd_len] == ' ') {\n   134\t                    return i;  /* Return command index */\n   135\t                }\n   136\t            }\n   137\t        }\n   138\t        \n   139\t        /* Fallback: direct strcmp - VULNERABLE */\n   140\t        if (strcmp(buffer, cmd_list[i]) == 0) {\n   141\t            return i;\n   142\t        }\n   143\t    }\n   144\t    \n   145\t    /* Check for special admin command - always vulnerable strcmp */\n   146\t    if (strcmp(buffer, \"ADMIN\") == 0) {\n   147\t        return 99;\n   148\t    }\n   149\t    \n   150\t    return -1;  /* No match */\n   151\t}\n   152\t\n   153\t/**\n   154\t * Compare prefix with optional exact matching\n   155\t * Safe when exact_match=0, vulnerable when exact_match=1\n   156\t */\n   157\tstatic int compare_prefix(const char *str, const char *prefix, int exact_match) {\n   158\t    size_t prefix_len = strlen(prefix);\n   159\t    \n   160\t    if (exact_match) {\n   161\t        /* Exact match required - VULNERABLE strcmp */\n   162\t        if (strcmp(str, prefix) == 0) {\n   163\t            return 1;\n   164\t        }\n   165\t        \n   166\t        /* Try with some common suffixes */\n   167\t        char variations[5][32] = {\"_v1\", \"_v2\", \"_old\", \"_new\", \"_tmp\"};\n   168\t        for (int i = 0; i < 5; i++) {\n   169\t            /* Construct expected string */\n   170\t            char expected[64];\n   171\t            strncpy(expected, prefix, 63);\n   172\t            expected[63] = '\\0';\n   173\t            strncat(expected, variations[i], 63 - strlen(expected));\n   174\t            \n   175\t            /* VULNERABLE: strcmp without length check on str */\n   176\t            if (strcmp(str, expected) == 0) {\n   177\t                return 2 + i;\n   178\t            }\n   179\t        }\n   180\t        \n   181\t        return 0;\n   182\t    } else {\n   183\t        /* Prefix match only - safer with strncmp */\n   184\t        if (strncmp(str, prefix, prefix_len) == 0) {\n   185\t            return 1;\n   186\t        }\n   187\t        return 0;\n   188\t    }\n   189\t}\n   190\t\n   191\t/**\n   192\t * Find delimiter position in string\n   193\t * Uses strncmp for safety but has edge cases\n   194\t */\n   195\tstatic int find_delimiter(const char *data, size_t len, char delim) {\n   196\t    if (len == 0) return -1;\n   197\t    \n   198\t    /* Manual search with bounds checking */\n   199\t    for (size_t i = 0; i < len; i++) {\n   200\t        if (data[i] == delim) {\n   201\t            return (int)i;\n   202\t        }\n   203\t        if (data[i] == '\\0') {\n   204\t            break;\n   205\t        }\n   206\t    }\n   207\t    \n   208\t    /* Check for special delimiter patterns using strcmp */\n   209\t    /* VULNERABLE: doesn't verify data is null-terminated */\n   210\t    if (delim == '|' && strcmp(data, \"NONE\") == 0) {\n   211\t        return -2;  /* Special case */\n   212\t    }\n   213\t    \n   214\t    if (delim == ':' && strcmp(data, \"EMPTY\") == 0) {\n   215\t        return -3;  /* Special case */\n   216\t    }\n   217\t    \n   218\t    return -1;  /* Not found */\n   219\t}\n   220\t\n   221\t/**\n   222\t * Match pattern with optional case sensitivity\n   223\t * Multiple vulnerable strcmp calls\n   224\t */\n   225\tstatic int match_pattern(const char *text, const char *pattern, int case_sensitive) {\n   226\t    \n   227\t    if (case_sensitive) {\n   228\t        /* Case-sensitive exact match - VULNERABLE */\n   229\t        if (strcmp(text, pattern) == 0) {\n   230\t            return 1;\n   231\t        }\n   232\t        \n   233\t        /* Try with wildcards - construct patterns */\n   234\t        char wildcard_patterns[3][64];\n   235\t        snprintf(wildcard_patterns[0], 64, \"*%s*\", pattern);\n   236\t        snprintf(wildcard_patterns[1], 64, \"%s*\", pattern);\n   237\t        snprintf(wildcard_patterns[2], 64, \"*%s\", pattern);\n   238\t        \n   239\t        /* VULNERABLE: strcmp on unbounded text */\n   240\t        for (int i = 0; i < 3; i++) {\n   241\t            if (strcmp(text, wildcard_patterns[i]) == 0) {\n   242\t                return 2 + i;\n   243\t            }\n   244\t        }\n   245\t        \n   246\t        /* Check if text contains pattern - uses strncmp safely */\n   247\t        size_t text_len = strlen(text);\n   248\t        size_t pattern_len = strlen(pattern);\n   249\t        \n   250\t        for (size_t i = 0; i <= text_len - pattern_len; i++) {\n   251\t            if (strncmp(&text[i], pattern, pattern_len) == 0) {\n   252\t                return 10 + i;  /* Return position + offset */\n   253\t            }\n   254\t        }\n   255\t        \n   256\t    } else {\n   257\t        /* Case-insensitive - need to check both cases */\n   258\t        /* First try exact match - VULNERABLE */\n   259\t        if (strcmp(text, pattern) == 0) {\n   260\t            return 1;\n   261\t        }\n   262\t        \n   263\t        /* Manual case-insensitive comparison */\n   264\t        size_t pattern_len = strlen(pattern);\n   265\t        size_t text_len = strlen(text);\n   266\t        \n   267\t        if (text_len != pattern_len) {\n   268\t            /* Try prefix match with strncmp */\n   269\t            if (strncmp(text, pattern, pattern_len) == 0) {\n   270\t                return 5;\n   271\t            }\n   272\t        }\n   273\t        \n   274\t        /* Compare character by character (safer) */\n   275\t        if (text_len == pattern_len) {\n   276\t            int match = 1;\n   277\t            for (size_t i = 0; i < pattern_len; i++) {\n   278\t                char c1 = text[i];\n   279\t                char c2 = pattern[i];\n   280\t                \n   281\t                /* Convert to lowercase */\n   282\t                if (c1 >= 'A' && c1 <= 'Z') c1 += 32;\n   283\t                if (c2 >= 'A' && c2 <= 'Z') c2 += 32;\n   284\t                \n   285\t                if (c1 != c2) {\n   286\t                    match = 0;\n   287\t                    break;\n   288\t                }\n   289\t            }\n   290\t            if (match) return 6;\n   291\t        }\n   292\t    }\n   293\t    \n   294\t    return 0;  /* No match */\n   295\t}\n===== c_src/src/main.c =====\n     1\t/*\n     2\t * Copyright 2025 MIT Lincoln Laboratory\n     3\t * Permission is hereby granted, free of charge,\n     4\t * to any person obtaining a copy of this software\n     5\t * and associated documentation files (the \"Software\"),\n     6\t * to deal in the Software without restriction,\n     7\t * including without limitation the rights to use, copy,\n     8\t * modify, merge, publish, distribute, sublicense,\n     9\t * and/or sell copies of the Software,\n    10\t * and to permit persons to whom the Software is furnished to do so,\n    11\t * subject to the following conditions:\n    12\t * \n    13\t * The above copyright notice and this permission notice\n    14\t * shall be included in all copies or substantial portions of the Software.\n    15\t * \n    16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    18\t * THE WARRANTIES OF MERCHANTABILITY,\n    19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    24\t */\n    25\t#include <stdio.h>\n    26\t#include <stdlib.h>\n    27\t#include <stdint.h>\n    28\t#include <stddef.h>\n    29\t\n    30\t/* External function declaration */\n    31\tint process_strings(char *input, size_t input_len, \n    32\t                   const char *reference, size_t ref_len,\n    33\t                   int operation, uint32_t flags);\n    34\t\n    35\t#define MAX_BUFFER_SIZE 1024\n    36\t\n    37\tint main(void) {\n    38\t    int operation;\n    39\t    uint32_t flags;\n    40\t    size_t input_len, ref_len;\n    41\t    char input_buffer[MAX_BUFFER_SIZE];\n    42\t    char ref_buffer[MAX_BUFFER_SIZE];\n    43\t    \n    44\t    /* Read operation */\n    45\t    if (scanf(\"%d\", &operation) != 1) {\n    46\t        fprintf(stderr, \"Error reading operation\\n\");\n    47\t        return 1;\n    48\t    }\n    49\t    \n    50\t    /* Read flags */\n    51\t    if (scanf(\"%u\", &flags) != 1) {\n    52\t        fprintf(stderr, \"Error reading flags\\n\");\n    53\t        return 1;\n    54\t    }\n    55\t    \n    56\t    /* Read input length */\n    57\t    if (scanf(\"%zu\", &input_len) != 1) {\n    58\t        fprintf(stderr, \"Error reading input length\\n\");\n    59\t        return 1;\n    60\t    }\n    61\t    \n    62\t    if (input_len > MAX_BUFFER_SIZE) {\n    63\t        fprintf(stderr, \"Error: input length %zu exceeds maximum %d\\n\", \n    64\t                input_len, MAX_BUFFER_SIZE);\n    65\t        return 1;\n    66\t    }\n    67\t    \n    68\t    /* Read input buffer data */\n    69\t    for (size_t i = 0; i < input_len; i++) {\n    70\t        unsigned int byte;\n    71\t        if (scanf(\"%u\", &byte) != 1) {\n    72\t            fprintf(stderr, \"Error reading input byte %zu\\n\", i);\n    73\t            return 1;\n    74\t        }\n    75\t        input_buffer[i] = (char)byte;\n    76\t    }\n    77\t    \n    78\t    /* Read reference length */\n    79\t    if (scanf(\"%zu\", &ref_len) != 1) {\n    80\t        fprintf(stderr, \"Error reading reference length\\n\");\n    81\t        return 1;\n    82\t    }\n    83\t    \n    84\t    if (ref_len > MAX_BUFFER_SIZE) {\n    85\t        fprintf(stderr, \"Error: reference length %zu exceeds maximum %d\\n\", \n    86\t                ref_len, MAX_BUFFER_SIZE);\n    87\t        return 1;\n    88\t    }\n    89\t    \n    90\t    /* Read reference buffer data */\n    91\t    for (size_t i = 0; i < ref_len; i++) {\n    92\t        unsigned int byte;\n    93\t        if (scanf(\"%u\", &byte) != 1) {\n    94\t            fprintf(stderr, \"Error reading reference byte %zu\\n\", i);\n    95\t            return 1;\n    96\t        }\n    97\t        ref_buffer[i] = (char)byte;\n    98\t    }\n    99\t    \n   100\t    /* Call the library function */\n   101\t    int result = process_strings(input_buffer, input_len, \n   102\t                                 ref_buffer, ref_len, \n   103\t                                 operation, flags);\n   104\t    \n   105\t    /* Print result to stdout */\n   106\t    printf(\"%d\\n\", result);\n   107\t    \n   108\t    return 0;\n   109\t}","is_error":false}]},"parent_tool_use_id":null,"session_id":"109ec7ad-c4d9-4e1f-9b1d-b4918287da6f","uuid":"853f7ebd-30e2-44c5-a6db-af7ed80ab890","timestamp":"2026-08-28T06:33:27.437Z","tool_use_result":{"stdout":"===== c_src/CMakeLists.txt =====\n     1\t# Copyright 2025 MIT Lincoln Laboratory\n     2\t# Permission is hereby granted, free of charge,\n     3\t# to any person obtaining a copy of this software\n     4\t# and associated documentation files (the “Software”),\n     5\t# to deal in the Software without restriction,\n     6\t# including without limitation the rights to use, copy,\n     7\t# modify, merge, publish, distribute, sublicense,\n     8\t# and/or sell copies of the Software,\n     9\t# and to permit persons to whom the Software is furnished to do so,\n    10\t# subject to the following conditions:\n    11\t# \n    12\t# The above copyright notice and this permission notice\n    13\t# shall be included in all copies or substantial portions of the Software.\n    14\t# \n    15\t# THE SOFTWARE IS PROVIDED “AS IS”, WITHOUT WARRANTY OF ANY KIND,\n    16\t# EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    17\t# THE WARRANTIES OF MERCHANTABILITY,\n    18\t# FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    19\t# IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    20\t# FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    21\t# TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    22\t# OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    23\t\n    24\tcmake_minimum_required(VERSION 3.10)\n    25\tproject(driver)\n    26\tadd_executable(driver src/main.c src/lib.c)\n===== c_src/include/strcpy-fun.h =====\n     1\t// Copyright 2025 MIT Lincoln Laboratory\n     2\t// Permission is hereby granted, free of charge,\n     3\t// to any person obtaining a copy of this software\n     4\t// and associated documentation files (the “Software”),\n     5\t// to deal in the Software without restriction,\n     6\t// including without limitation the rights to use, copy,\n     7\t// modify, merge, publish, distribute, sublicense,\n     8\t// and/or sell copies of the Software,\n     9\t// and to permit persons to whom the Software is furnished to do so,\n    10\t// subject to the following conditions:\n    11\t// \n    12\t// The above copyright notice and this permission notice\n    13\t// shall be included in all copies or substantial portions of the Software.\n    14\t// \n    15\t// THE SOFTWARE IS PROVIDED “AS IS”, WITHOUT WARRANTY OF ANY KIND,\n    16\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    17\t// THE WARRANTIES OF MERCHANTABILITY,\n    18\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    19\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    20\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    21\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    22\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    23\t\n    24\t#ifndef STRCPY_FUN_H_\n    25\t#define STRCPY_FUN_H_\n    26\tint process_strings(char *input, size_t input_len, \n    27\t                   const char *reference, size_t ref_len,\n    28\t                   int operation, uint32_t flags) \n    29\t#endif //STRCPY_FUN_H_\n===== c_src/src/lib.c =====\n     1\t/*\n     2\t * Copyright 2025 MIT Lincoln Laboratory\n     3\t * Permission is hereby granted, free of charge,\n     4\t * to any person obtaining a copy of this software\n     5\t * and associated documentation files (the \"Software\"),\n     6\t * to deal in the Software without restriction,\n     7\t * including without limitation the rights to use, copy,\n     8\t * modify, merge, publish, distribute, sublicense,\n     9\t * and/or sell copies of the Software,\n    10\t * and to permit persons to whom the Software is furnished to do so,\n    11\t * subject to the following conditions:\n    12\t * \n    13\t * The above copyright notice and this permission notice\n    14\t * shall be included in all copies or substantial portions of the Software.\n    15\t * \n    16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    18\t * THE WARRANTIES OF MERCHANTABILITY,\n    19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    24\t */\n    25\t#include <string.h>\n    26\t#include <stddef.h>\n    27\t#include <stdint.h>\n    28\t#include <stdio.h>\n    29\t\n    30\t/* Forward declarations */\n    31\tstatic int validate_token(const char *token, const char *expected);\n    32\tstatic int parse_command(char *buffer, size_t buf_size, const char *cmd_list[], int list_size);\n    33\tstatic int compare_prefix(const char *str, const char *prefix, int exact_match);\n    34\tstatic int find_delimiter(const char *data, size_t len, char delim);\n    35\tstatic int match_pattern(const char *text, const char *pattern, int case_sensitive);\n    36\t\n    37\t/**\n    38\t * Main entrance function - performs various string comparison operations\n    39\t * \n    40\t * @param input Input string buffer\n    41\t * @param input_len Length of input buffer\n    42\t * @param reference Reference string for comparison\n    43\t * @param ref_len Length of reference buffer\n    44\t * @param operation Operation code:\n    45\t *                  0: validate token\n    46\t *                  1: parse command\n    47\t *                  2: compare prefix\n    48\t *                  3: find delimiter\n    49\t *                  4: match pattern\n    50\t * @param flags Operation flags (case sensitivity, exact match, etc)\n    51\t * @return Operation result (match count, position, or error code)\n    52\t */\n    53\tint process_strings(char *input, size_t input_len, \n    54\t                   const char *reference, size_t ref_len,\n    55\t                   int operation, uint32_t flags) {\n    56\t    \n    57\t    if (input == NULL) {\n    58\t        return -1;\n    59\t    }\n    60\t    \n    61\t    /* Different operations based on operation code */\n    62\t    switch (operation) {\n    63\t        case 0: {\n    64\t            /* Validate token - VULNERABLE if input not null-terminated */\n    65\t            if (reference == NULL) return -2;\n    66\t            return validate_token(input, reference);\n    67\t        }\n    68\t        \n    69\t        case 1: {\n    70\t            /* Parse command from list - checks against multiple strings */\n    71\t            const char *commands[] = {\"START\", \"STOP\", \"PAUSE\", \"RESUME\", \"RESET\"};\n    72\t            return parse_command(input, input_len, commands, 5);\n    73\t        }\n    74\t        \n    75\t        case 2: {\n    76\t            /* Compare prefix - can use strcmp or strncmp based on flags */\n    77\t            if (reference == NULL) return -2;\n    78\t            int exact = (flags & 0x01);\n    79\t            return compare_prefix(input, reference, exact);\n    80\t        }\n    81\t        \n    82\t        case 3: {\n    83\t            /* Find delimiter position */\n    84\t            char delim = (reference && ref_len > 0) ? reference[0] : ':';\n    85\t            return find_delimiter(input, input_len, delim);\n    86\t        }\n    87\t        \n    88\t        case 4: {\n    89\t            /* Match pattern - VULNERABLE in certain paths */\n    90\t            if (reference == NULL) return -2;\n    91\t            int case_sens = (flags & 0x02);\n    92\t            return match_pattern(input, reference, case_sens);\n    93\t        }\n    94\t        \n    95\t        default:\n    96\t            return -3;\n    97\t    }\n    98\t}\n    99\t\n   100\t/**\n   101\t * Validate token against expected value\n   102\t * VULNERABLE: Uses strcmp without ensuring null termination\n   103\t */\n   104\tstatic int validate_token(const char *token, const char *expected) {\n   105\t    /* Direct strcmp - will overflow if token not null-terminated */\n   106\t    if (strcmp(token, expected) == 0) {\n   107\t        return 1;  /* Valid */\n   108\t    }\n   109\t    \n   110\t    /* Also check some common variations */\n   111\t    if (strcmp(token, \"VALID\") == 0 || strcmp(token, \"OK\") == 0) {\n   112\t        return 1;\n   113\t    }\n   114\t    \n   115\t    return 0;  /* Invalid */\n   116\t}\n   117\t\n   118\t/**\n   119\t * Parse command from a list of valid commands\n   120\t * Mix of safe and unsafe comparisons\n   121\t */\n   122\tstatic int parse_command(char *buffer, size_t buf_size, \n   123\t                        const char *cmd_list[], int list_size) {\n   124\t    \n   125\t    /* Iterate through command list */\n   126\t    for (int i = 0; i < list_size; i++) {\n   127\t        /* Safe comparison using strncmp first */\n   128\t        size_t cmd_len = strlen(cmd_list[i]);\n   129\t        \n   130\t        if (buf_size >= cmd_len) {\n   131\t            if (strncmp(buffer, cmd_list[i], cmd_len) == 0) {\n   132\t                /* Check if exact match - VULNERABLE if buffer not null-terminated */\n   133\t                if (buffer[cmd_len] == '\\0' || buffer[cmd_len] == ' ') {\n   134\t                    return i;  /* Return command index */\n   135\t                }\n   136\t            }\n   137\t        }\n   138\t        \n   139\t        /* Fallback: direct strcmp - VULNERABLE */\n   140\t        if (strcmp(buffer, cmd_list[i]) == 0) {\n   141\t            return i;\n   142\t        }\n   143\t    }\n   144\t    \n   145\t    /* Check for special admin command - always vulnerable strcmp */\n   146\t    if (strcmp(buffer, \"ADMIN\") == 0) {\n   147\t        return 99;\n   148\t    }\n   149\t    \n   150\t    return -1;  /* No match */\n   151\t}\n   152\t\n   153\t/**\n   154\t * Compare prefix with optional exact matching\n   155\t * Safe when exact_match=0, vulnerable when exact_match=1\n   156\t */\n   157\tstatic int compare_prefix(const char *str, const char *prefix, int exact_match) {\n   158\t    size_t prefix_len = strlen(prefix);\n   159\t    \n   160\t    if (exact_match) {\n   161\t        /* Exact match required - VULNERABLE strcmp */\n   162\t        if (strcmp(str, prefix) == 0) {\n   163\t            return 1;\n   164\t        }\n   165\t        \n   166\t        /* Try with some common suffixes */\n   167\t        char variations[5][32] = {\"_v1\", \"_v2\", \"_old\", \"_new\", \"_tmp\"};\n   168\t        for (int i = 0; i < 5; i++) {\n   169\t            /* Construct expected string */\n   170\t            char expected[64];\n   171\t            strncpy(expected, prefix, 63);\n   172\t            expected[63] = '\\0';\n   173\t            strncat(expected, variations[i], 63 - strlen(expected));\n   174\t            \n   175\t            /* VULNERABLE: strcmp without length check on str */\n   176\t            if (strcmp(str, expected) == 0) {\n   177\t                return 2 + i;\n   178\t            }\n   179\t        }\n   180\t        \n   181\t        return 0;\n   182\t    } else {\n   183\t        /* Prefix match only - safer with strncmp */\n   184\t        if (strncmp(str, prefix, prefix_len) == 0) {\n   185\t            return 1;\n   186\t        }\n   187\t        return 0;\n   188\t    }\n   189\t}\n   190\t\n   191\t/**\n   192\t * Find delimiter position in string\n   193\t * Use