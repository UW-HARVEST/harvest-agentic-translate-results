har *, size_t))dlsym(RTLD_NEXT, \"strncmp\");\n        if (!real_strncmp) return 0;\n    }\n    if (n == 5 && a != NULL && b != NULL && real_strncmp(a, \"VALID\", 6) == 0 &&\n        real_strncmp(b, \"VALID\", 6) == 0) {\n        strncmp_hits++;\n        if (fail_strncmp) return 1;\n    }\n    return real_strncmp(a, b, n);\n}\n","structuredPatch":[{"oldStart":96,"oldLines":7,"newStart":96,"newLines":16,"lines":[" "," unsigned long harvest_shim_malloc50_hits(void) { return malloc50_hits; }"," unsigned long harvest_shim_strncmp_hits(void) { return strncmp_hits; }","-void harvest_shim_reset_counters(void) { malloc50_hits = 0; strncmp_hits = 0; }","+unsigned long harvest_shim_free_hits(void) { return free_hits; }","+unsigned long harvest_shim_free50_hits(void) { return free50_hits; }","+","+void harvest_shim_reset_counters(void) {","+    malloc50_hits = 0;","+    strncmp_hits = 0;","+    free_hits = 0;","+    free50_hits = 0;","+}","+"," int harvest_shim_present(void) { return 1; }"," "," /* --- interposed libc ----------------------------------------------------- */"]}],"userModified":false,"replaceAll":false}}
