drop(state);\n150\t}\n151\t\n152\t/// `int gotomach(int iterations, int seed, int mode, int threshold);`\n153\t#[unsafe(no_mangle)]\n154\tpub unsafe extern \"C\" fn gotomach(\n155\t    iterations: c_int,\n156\t    seed: c_int,\n157\t    mode: c_int,\n158\t    threshold: c_int,\n159\t) -> c_int {\n160\t    let mut state: Option<Box<ProcessorState>> = None;\n161\t    let mut temp_buffer: Option<Vec<c_int>> = None;\n162\t    let mut result: c_int = 0;\n163\t    let selected_op: operation_fn;\n164\t\n165\t    log_msg!(INFO, \"Starting gotomach function\");\n166\t\n167\t    // Emulates the `goto cleanup` control flow of the C original: every early\n168\t    // exit sets `result` and falls through to the shared cleanup below.\n169\t    'cleanup: {\n170\t        if iterations < 0 || iterations > u16::MAX as c_int {\n171\t            log_msg!(ERROR, \"Invalid iteration count\");\n172\t            result = -1;\n173\t            break 'cleanup;\n174\t        }\n175\t\n176\t        if seed < 0 || seed > u16::MAX as c_int {\n177\t            log_msg!(ERROR, \"Invalid seed value\");\n178\t            result = -2;\n179\t            break 'cleanup;\n180\t        }\n181\t\n182\t        match mode {\n183\t            0 => {\n184\t                selected_op = process_value;\n185\t            }\n186\t            1 => {\n187\t                selected_op = double_value;\n188\t            }\n189\t            2 => {\n190\t                selected_op = triple_value;\n191\t            }\n192\t            _ => {\n193\t                log_msg!(WARNING, \"Invalid mode, using default\");\n194\t                selected_op = process_value;\n195\t            }\n196\t        }\n197\t\n198\t        state = init_processor(iterations as usize, selected_op);\n199\t        if state.is_none() {\n200\t            log_msg!(ERROR, \"Failed to initialize processor\");\n201\t            result = -3;\n202\t            break 'cleanup;\n203\t        }\n204\t        let st = state.as_mut().unwrap();\n205\t\n206\