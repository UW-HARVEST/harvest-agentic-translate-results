f(format: *const c_char, ...) -> c_int;\n39\t}\n40\t\n41\t/// Equivalent of the C macro\n42\t/// `#define LOG_MSG(level, msg) printf(\"[\" #level \"] \" msg \"\\n\")`\n43\t///\n44\t/// The macro stringifies `level` and concatenates the literals at compile time,\n45\t/// producing a single format-string argument to `printf`.\n46\tmacro_rules! log_msg {\n47\t    ($level:ident, $msg:literal) => {{\n48\t        // \"[\" #level \"] \" msg \"\\n\" followed by the NUL terminator.\n49\t        const MSG: &[u8] = concat!(\"[\", stringify!($level), \"] \", $msg, \"\\n\\0\").as_bytes();\n50\t        unsafe {\n51\t            printf(MSG.as_ptr() as *const c_char);\n52\t        }\n53\t    }};\n54\t}\n55\t\n56\t/// `typedef int (*operation_fn)(int value, int unused_param, void *unused_context);`\n57\ttype operation_fn = unsafe extern \"C\" fn(value: c_int, unused_param: c_int, unused_context: *mut c_void) -> c_int;\n58\t\n59\t/// ```c\n60\t/// typedef struct {\n61\t///     int *results;\n62\t///     size_t capacity;\n63\t///     size_t count;\n64\t///     operation_fn operation;\n65\t///     char status;\n66\t/// } ProcessorState;\n67\t/// ```\n68\tstruct ProcessorState {\n69\t    results: Vec<c_int>,\n70\t    capacity: usize,\n71\t    count: usize,\n72\t    operation: Option<operation_fn>,\n73\t    status: c_char,\n74\t}\n75\t\n76\t/// `static bool is_valid_state(ProcessorState *state)`\n77\tfn is_valid_state(state: &ProcessorState) -> bool {\n78\t    if state.status != 0 {\n79\t        return state.count < state.capacity;\n80\t    }\n81\t    false\n82\t}\n83\t\n84\t/// `static bool check_char_flag(char flag)`\n85\tfn check_char_flag(flag: c_char) -> bool {\n86\t    flag != 0\n87\t}\n88\t\n89\t/// `int process_value(int value, int unused_param, void *unused_context)`\n90\t#[unsafe(no_mangle)]\n91\tpub unsafe extern \"C\" fn process_value(\n92\t    value: c_int,\n93\t    _unused_param: c_int,\n94\t    _unused_context: *mut c_void,\n95\t) -> c_int {\n96\t    value.wrapping_add(10)