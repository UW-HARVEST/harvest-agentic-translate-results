\n\tc2v   (*c2CCW90)(c2v);\n\tc2v   (*c2D)(c2Simplex *);\n\tint   (*c2Support)(const c2v *, int, c2v);\n\tvoid  (*c2Witness)(c2Simplex *, c2v *, c2v *);\n\tc2v   (*c2Div)(c2v, float);\n\tc2v   (*c2Norm)(c2v);\n\tc2v   (*c2L)(c2Simplex *);\n\tc2v   (*c2MulrvT)(c2r, c2v);\n\tfloat (*c2GJK)(const void *, C2_TYPE, const c2x *, const void *, C2_TYPE,\n\t               const c2x *, c2v *, c2v *, int, int *, c2GJKCache *);\n\tint   (*c2AABBtoAABB)(c2AABB, c2AABB);\n\tint   (*c2AABBtoCapsule)(c2AABB, c2Capsule);\n\tint   (*c2CapsuletoCapsule)(c2Capsule, c2Capsule);\n\tint   (*c2CircletoCircle)(c2Circle, c2Circle);\n\tint   (*c2CircletoAABB)(c2Circle, c2AABB);\n\tint   (*c2CircletoCapsule)(c2Circle, c2Capsule);\n\tint   (*c2Collided)(const void *, C2_TYPE, const void *, C2_TYPE);\n\tvoid *(*ptr_from_parts)(C2_TYPE, float, float, float, float, float);\n\tint   (*omni_collide)(C2_TYPE, float, float, float, float, float,\n\t                      C2_TYPE, float, float, float, float, float);\n} API;\n\nstatic long failures = 0, checks = 0;\n\n#define LOAD(a, n) do { \\\n\t*(void **)(&(a)->n) = dlsym((a)->h, #n); \\\n\tif (!(a)->n) { fprintf(stderr, \"missing symbol %s\\n\", #n); exit(2); } \\\n} while (0)\n\nstatic void load(API *a, const char *path)\n{\n\ta->h = dlopen(path, RTLD_NOW | RTLD_LOCAL);\n\tif (!a->h) { fprintf(stderr, \"dlopen %s: %s\\n\", path, dlerror()); exit(2); }\n\tLOAD(a, c2V); LOAD(a, c2Mulvs); LOAD(a, c2Maxv); LOAD(a, c2Minv);\n\tLOAD(a, c2Clampv); LOAD(a, c2Sub); LOAD(a, c2Dot); LOAD(a, c2RotIdentity);\n\tLOAD(a, c2xIdentity); LOAD(a, c2BBVerts); LOAD(a, c2MakeProxy);\n\tLOAD(a, c2Len); LOAD(a, c2Det2); LOAD(a, c2GJKSimplexMetric);\n\tLOAD(a, c2Mulrv); LOAD(a, c2Add); LOAD(a, c2Mulxv); LOAD(a, c22);\n\tLOAD(a, c23); LOAD(a, c2Neg); LOAD(a, c2Skew); LOAD(a, c2CCW90);\n\tLOAD(a, c2D); LOAD(a, c2Support); LOAD(a, c2Witness); LOAD(a, c2Div);\n\tLOAD(a, c2Norm); LOAD(a, c2L); LOAD(a, c2MulrvT); LOAD(a, c2GJK);\n\tLOAD(a, c2AABBtoAABB); LOAD(a, c2AABBtoCapsule);\n\tLOAD(a, c2CapsuletoCapsule); LOAD(a, c2CircletoCircle);\n\tLOAD(a, c2CircletoAABB); LOAD(a, c2CircletoCapsule); LOAD(a, c2Collided);\n\tLOAD(a, ptr_from_parts); LOAD(a, omni_collide);\n}\n\nstatic void cmp(const char *what, const void *p, const void *q, size_t n)\n{\n\t++checks;\n\tif (memcmp(p, q, n) != 0) {\n\t\tif (failures < 25) {\n\t\t\tfprintf(stderr, \"MISMATCH %s:\\n  C  =\", what);\n\t\t\tfor (size_t i = 0; i < n; ++i) fprintf(stderr, \" %02x\", ((const unsigned char *)p)[i]);\n\t\t\tfprintf(stderr, \"\\n  RS =\");\n\t\t\tfor (size_t i = 0; i < n; ++i) fprintf(stderr, \" %02x\", ((const unsigned char *)q)[i]);\n\t\t\tfprintf(stderr, \"\\n\");\n\t\t}\n\t\t++failures;\n\t}\n}\n\nstatic uint64_t st = 0x123456789abcdefULL;\nstatic uint32_t rnd(void)\n{\n\tst ^= st << 13; st ^= st >> 7; st ^= st << 17;\n\treturn (uint32_t)(st >> 11);\n}\n\n/* mix of \"nice\" and pathological floats */\nstatic float rf(void)\n{\n\tswitch (rnd() % 12) {\n\tcase 0: return 0.0f;\n\tcase 1: return -0.0f;\n\tcase 2: return 1.0f;\n\tcase 3: return -1.0f;\n\tcase 4: return (float)((int)(rnd() % 21) - 10);\n\tcase 5: return (float)((int)(rnd() % 2001) - 1000) / 8.0f;\n\tcase 6: return 1e-8f * (float)(rnd() % 1000);\n\tcase 7: return 1e8f;\n\tcase 8: return -1e8f;\n\tcase 9: return 3.4028234663852886e+38f;\n\tcase 10: return 1.1920928955078125e-7f;\n\tdefault: {\n\t\tunion { uint32_t u; float f; } u;\n\t\tu.u = rnd() ^ (rnd() << 16);\n\t\tif (!(u.u & 0x7f800000) || (u.u & 0x7f800000) == 0x7f800000) u.u = 0x3f800000;\n\t\treturn u.f;\n\t}\n\t}\n}\n\nstatic c2v rv(void) { c2v v; v.x = rf(); v.y = rf(); return v; }\nstatic c2r rr(void) { c2r r; r.c = rf(); r.s = rf(); return r; }\nstatic c2x rx(void) { c2x x; x.p = rv(); x.r = rr(); return x; }\n\nstatic void rsimplex(c2Simplex *s, int count)\n{\n\tmemset(s, 0, sizeof *s);\n\tc2sv *v = &s->a;\n\tfor (int i = 0; i < 4; ++i) {\n\t\tv[i].sA = rv(); v[i].sB = rv(); v[i].p = rv();\n\t\tv[i].u = rf(); v[i].iA = (int)(rnd() % 8); v[i].iB = (int)(rnd() % 8);\n\t}\n\ts->div = (rnd() % 4) ? rf() : 0.0f;\n\ts->count = count;\n}\n\nint main(int argc, char **argv)\n{\n\tif (argc != 3) { fprintf(stderr, \"usage: %s c.so rust.so\\n\", argv[0]); return 2; }\n\tAPI C, R;\n\tload(&C, argv[1]);\n\tload(&R, argv[2]);\n\n\t/* ---- 0-ary ---- */\n\t{ c2r a = C.c2RotIdentity(), b = R.c2RotIdentity(); cmp(\"c2RotIdentity\", &a, &b, sizeof a); }\n\t{ c2x a = C.c2xIdentity(),   b = R.c2xIdentity();   cmp(\"c2xIdentity\", &a, &b, sizeof a); }\n\n\tfor (long it = 0; it < 200000; ++it) {\n\t\tc2v u = rv(), v = rv(), w = rv();\n\t\tc2r r = rr();\n\t\tc2x x = rx();\n\t\tfloat f = rf();\n\n\t\t{ c2v a = C.c2V(u.x, u.y), b = R.c2V(u.x, u.y); cmp(\"c2V\", &a, &b, sizeof a); }\n\t\t{ c2v a = C.c2Mulvs(u, f), b = R.c2Mulvs(u, f); cmp(\"c2Mulvs\", &a, &b, sizeof a); }\n\t\t{ c2v a = C.c2Maxv(u, v), b = R.c2Maxv(u, v); cmp(\"c2Maxv\", &a, &b, sizeof a); }\n\t\t{ c2v a = C.c2Minv(u, v), b = R.c2Minv(u, v); cmp(\"c2Minv\", &a, &b, sizeof a); }\n\t\t{ c2v a = C.c2Clampv(u, v, w), b = R.c2Clampv(u, v, w); cmp(\"c2Clampv\", &a, &b, sizeof a); }\n\t\t{ c2v a = C.c2Sub(u, v), b = R.c2Sub(u, v); cmp(\"c2Sub\", &a, &b, sizeof a); }\n\t\t{ c2v a = C.c2Add(u, v), b = R.c2Add(u, v); cmp(\"c2Add\", &a, &b, sizeof a); }\n\t\t{ float a = C.c2Dot(u, v), b = R.c2Dot(u, v); cmp(\"c2Dot\", &a, &b, sizeof a); }\n\t\t{ float a = C.c2Len(u), b = R.c2Len(u); cmp(\"c2Len\", &a, &b, sizeof a); }\n\t\t{ float a = C.c2Det2(u, v), b = R.c2Det2(u, v); cmp(\"c2Det2\", &a, &b, sizeof a); }\n\t\t{ c2v a = C.c2Mulrv(r, u), b = R.c2Mulrv(r, u); cmp(\"c2Mulrv\", &a, &b, sizeof a); }\n\t\t{ c2v a = C.c2MulrvT(r, u), b = R.c2MulrvT(r, u); cmp(\"c2MulrvT\", &a, &b, sizeof a); }\n\t\t{ c2v a = C.c2Mulxv(x, u), b = R.c2Mulxv(x, u); cmp(\"c2Mulxv\", &a, &b, sizeof a); }\n\t\t{ c2v a = C.c2Neg(u), b = R.c2Neg(u); cmp(\"c2Neg\", &a, &b, sizeof a); }\n\t\t{ c2v a = C.c2Skew(u), b = R.c2Skew(u); cmp(\"c2Skew\", &a, &b, sizeof a); }\n\t\t{ c2v a = C.c2CCW90(u), b = R.c2CCW90(u); cmp(\"c2CCW90\", &a, &b, sizeof a); }\n\t\t{ c2v a = C.c2Div(u, f), b = R.c2Div(u, f); cmp(\"c2Div\", &a, &b, sizeof a); }\n\t\t{ c2v a = C.c2Norm(u), b = R.c2Norm(u); cmp(\"c2Norm\", &a, &b, sizeof a); }\n\n\t\t/* c2BBVerts */\n\t\t{\n\t\t\tc2AABB bb; bb.min = u; bb.max = v;\n\t\t\tc2v o1[4], o2[4];\n\t\t\tmemset(o1, 0xa5, sizeof o1); memset(o2, 0xa5, sizeof o2);\n\t\t\tC.c2BBVerts(o1, &bb); R.c2BBVerts(o2, &bb);\n\t\t\tcmp(\"c2BBVerts\", o1, o2, sizeof o1);\n\t\t}\n\n\t\t/* c2MakeProxy over all types incl. an invalid one */\n\t\t{\n\t\t\tint types[4] = { C2_TYPE_CAPSULE, C2_TYPE_CIRCLE, C2_TYPE_AABB, 7 };\n\t\t\tfor (int t = 0; t < 4; ++t) {\n\t\t\t\tunsigned char shape[32];\n\t\t\t\tfor (size_t i = 0; i < sizeof shape; ++i) shape[i] = (unsigned char)rnd();\n\t\t\t\tc2Proxy p1, p2;\n\t\t\t\tmemset(&p1, 0, sizeof p1); memset(&p2, 0, sizeof p2);\n\t\t\t\tC.c2MakeProxy(shape, types[t], &p1);\n\t\t\t\tR.c2MakeProxy(shape, types[t], &p2);\n\t\t\t\t/* only the fields the function is documented to fill are compared\n\t\t\t\t * for AABB (verts[4..7] stay untouched in both) */\n\t\t\t\tcmp(\"c2MakeProxy\", &p1, &p2, sizeof p1);\n\t\t\t}\n\t\t}\n\n\t\t/* c2Support */\n\t\t{\n\t\t\tc2v verts[8];\n\t\t\tfor (int i = 0; i < 8; ++i) verts[i] = rv();\n\t\t\tint n = 1 + (int)(rnd() % 8);\n\t\t\tint a = C.c2Support(verts, n, u), b = R.c2Support(verts, n, u);\n\t\t\tcmp(\"c2Support\", &a, &b, sizeof a);\n\t\t}\n\n\t\t/* simplex functions, counts 0..4 */\n\t\tfor (int count = 0; count <= 4; ++count) {\n\t\t\tc2Simplex s0;\n\t\t\trsimplex(&s0, count);\n\t\t\t{\n\t\t\t\tc2Simplex s1 = s0, s2 = s0;\n\t\t\t\tfloat a = C.c2GJKSimplexMetric(&s1), b = R.c2GJKSimplexMetric(&s2);\n\t\t\t\tcmp(\"c2GJKSimplexMetric\", &a, &b, sizeof a);\n\t\t\t\tcmp(\"c2GJKSimplexMetric/state\", &s1, &s2, sizeof s1);\n\t\t\t}\n\t\t\t{\n\t\t\t\tc2Simplex s1 = s0, s2 = s0;\n\t\t\t\tC.c22(&s1); R.c22(&s2);\n\t\t\t\tcmp(\"c22\", &s1, &s2, sizeof s1);\n\t\t\t}\n\t\t\t{\n\t\t\t\tc2Simplex s1 = s0, s2 = s0;\n\t\t\t\tC.