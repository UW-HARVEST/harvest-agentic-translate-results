= val.wrapping_add(1);'\ncheck \"modulo 100 instead of modulo 10\" \\\n      'if val % 10 == 9 {' 'if val % 100 == 9 {'\ncheck \"cast to i64 so the increment never wraps\" \\\n      'val = val.wrapping_add(1);' 'val = ((val as i64) + 1) as i32;'\n\necho \"------------------------------------------------------------------\"\nif [[ $overall -eq 0 ]]; then\n    echo \"ALL MUTANTS DETECTED\"\nelse\n    echo \"SOME MUTANTS SURVIVED\"\nfi\nexit $overall\n","structuredPatch":[{"oldStart":71,"oldLines":8,"newStart":71,"newLines":8,"lines":["       'let mut val = val;' 'let mut val = val.wrapping_add(1);'"," check \"modulo 100 instead of modulo 10\" \\","       'if val % 10 == 9 {' 'if val % 100 == 9 {'","-check \"cast to i64 so the increment never wraps\" \\","-      'val = val.wrapping_add(1);' 'val = ((val as i64) + 1) as i32;'","+check \"test the condition on the already-incremented value\" \\","+      'if val % 10 == 9 {' 'if val.wrapping_add(1) % 10 == 9 {'"," "," echo \"------------------------------------------------------------------\""," if [[ $overall -eq 0 ]]; then"]}],"userModified":false,"replaceAll":false}}
