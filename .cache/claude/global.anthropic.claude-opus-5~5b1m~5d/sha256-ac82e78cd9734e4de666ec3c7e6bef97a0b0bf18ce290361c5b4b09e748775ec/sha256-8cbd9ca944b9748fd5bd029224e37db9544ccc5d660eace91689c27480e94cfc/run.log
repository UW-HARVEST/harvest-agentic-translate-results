  40\t/// * `s -= (s < 0);` subtracts exactly 1 when `s` is negative (C `bool` -> `int`).\n    41\t#[inline]\n    42\tfn mp3d_scale_pcm(sample: f32) -> i16 {\n    43\t    if sample as f64 >= 32766.5 {\n    44\t        return 32767i16;\n    45\t    }\n    46\t    if sample as f64 <= -32767.5 {\n    47\t        return -32768i16;\n    48\t    }\n    49\t    let mut s: i16 = (sample + 0.5f32) as i32 as i16;\n    50\t    s -= (s < 0) as i16;\n    51\t    s\n    52\t}\n    53\t\n    54\t/// Translation of the C `void synth_pair(mp3d_sample_t *pcm, int nch, const float *z)`.\n    55\t///\n    56\t/// The exported linker symbol is `synth_pair` (the public header declares no\n    57\t/// namespace-renaming macros).\n    58\t///\n    59\t/// # Safety\n    60\t///\n    61\t/// Mirrors the C contract verbatim: `pcm` must be writable at indices `0` and\n    62\t/// `16 * nch`, and `z` must be readable at indices `k * 64` and `2 + k * 64`\n    63\t/// for `k` in `0..=14`. No validation is performed, exactly as in the C.\n    64\t#[unsafe(no_mangle)]\n    65\tpub unsafe extern \"C\" fn synth_pair(pcm: *mut mp3d_sample_t, nch: c_int, z: *const f32) {\n    66\t    // Read helper mirroring C's `z[i]` (pointer arithmetic in units of float).\n    67\t    #[inline(always)]\n    68\t    unsafe fn g(z: *const f32, i: isize) -> f32 {\n    69\t        unsafe { *z.offset(i) }\n    70\t    }\n    71\t\n    72\t    let mut a: f32;\n    73\t\n    74\t    // a  = (z[14*64] - z[0])      * 29;\n    75\t    a = (unsafe { g(z, 14 * 64) } - unsafe { g(z, 0) }) * 29f32;\n    76\t    // a += (z[1*64]  + z[13*64])  * 213;\n    77\t    a += (unsafe { g(z, 1 * 64) } + unsafe { g(z, 13 * 64) }) * 213f32;\n    78\t    // a += (z[12*64] - z[2*64])   * 459;\n    79\t    a += (unsafe { g(z, 12 * 64) } - unsafe { g(z, 2 * 64) }) * 459f32;\n    80\t    // a += (z[3*64]  + z[11*64])  * 2037;\n    81\t    a += (unsafe { g(z, 3 * 64) } + unsafe { g(z, 11 * 64) }) * 2037f32;\n    82\t    // a += (z[10*64] - z[4*64])