th it.\n// ---------------------------------------------------------------------------\n\npub const CHILD_ENV: &str = \"HARVEST_DIFF_CHILD\";\n\n/// Re-executes the current test binary with `HARVEST_DIFF_CHILD=<mode>` so the\n/// child performs the fatal operation, and reports `(signal, exit_code)`.\npub fn run_child(test_name: &str, mode: &str) -> (Option<i32>, Option<i32>) {\n    use std::os::unix::process::ExitStatusExt;\n\n    let exe = std::env::current_exe().expect(\"current_exe\");\n    let out = std::process::Command::new(exe)\n        .arg(test_name)\n        .arg(\"--exact\")\n        .arg(\"--nocapture\")\n        .arg(\"--test-threads=1\")\n        .env(CHILD_ENV, mode)\n        .output()\n        .expect(\"spawn child test process\");\n    (out.status.signal(), out.status.code())\n}\n\npub fn child_mode() -> Option<String> {\n    std::env::var(CHILD_ENV).ok()\n}\nEOF\necho appended && grep -c '' tests/common/mod.rs","description":"Append aliasing and subprocess helpers"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11440,"cache_read_input_tokens":58011,"cache_creation":{"ephemeral_5m_input_tokens":11440,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"0030706e-f804-442b-bab0-f45e3401f2db","uuid":"2dcc87b0-afab-4e25-9042-3eba6c7b69b0","timestamp":"2026-08-27T01:15:53.598Z"}
