n271\t    if truncated >= -2147483648.0f64 && truncated <= 2147483647.0f64 {\n272\t        truncated as i32\n273\t    } else {\n274\t        i32::MIN\n275\t    }\n276\t}\n277\t\n278\t/// Emulates C's `fabs()` on the double-promoted value.\n279\tfn c_fabs(value: f64) -> f64 {\n280\t    value.abs()\n281\t}\n282\t\n283\t// ---------------------------------------------------------------------------\n284\t// Translated program\n285\t// ---------------------------------------------------------------------------\n286\t\n287\tfn print_line(line: Option<&str>) {\n288\t    if let Some(line) = line {\n289\t        println!(\"{}\", line);\n290\t    }\n291\t}\n292\t\n293\tfn print_int_line(int_number: i32) {\n294\t    println!(\"{}\", int_number);\n295\t}\n296\t\n297\tconst CHAR_ARRAY_SIZE: usize = 20;\n298\t\n299\tfn bad(stdin: &mut BufReader<Stdin>) {\n300\t    let mut data: f32;\n301\t    data = 0.0f32;\n302\t    {\n303\t        let mut input_buffer = [0u8; CHAR_ARRAY_SIZE];\n304\t        if fgets(&mut input_buffer, stdin) {\n305\t            data = c_atof(&input_buffer) as f32;\n306\t        } else {\n307\t            print_line(Some(\"fgets() failed.\"));\n308\t        }\n309\t    }\n310\t    {\n311\t        let result = f64_to_int(100.0f64 / data as f64);\n312\t        print_int_line(result);\n313\t    }\n314\t}\n315\t\n316\tfn good_g2b() {\n317\t    let data: f32 = 2.0f32;\n318\t    {\n319\t        let result = f64_to_int(100.0f64 / data as f64);\n320\t        print_int_line(result);\n321\t    }\n322\t}\n323\t\n324\tfn good_b2g(stdin: &mut BufReader<Stdin>) {\n325\t    let mut data: f32;\n326\t    data = 0.0f32;\n327\t    {\n328\t        let mut input_buffer = [0u8; CHAR_ARRAY_SIZE];\n329\t        if fgets(&mut input_buffer, stdin) {\n330\t            data = c_atof(&input_buffer) as f32;\n331\t        } else {\n332\t            print_line(Some(\"fgets() failed.\"));\n333\t        }\n334\t    }\n335\t    if c_fabs(data as f64) > 0.000001f64 {\n336\t        let result = f64