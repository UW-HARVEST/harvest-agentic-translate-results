// before any character is read.\n38\tfn fgets<R: BufRead>(buffer: &mut [u8], stream: &mut R) -> bool {\n39\t    let capacity = buffer.len();\n40\t    if capacity == 0 {\n41\t        return false;\n42\t    }\n43\t    let mut count = 0usize;\n44\t    while count + 1 < capacity {\n45\t        match read_byte(stream) {\n46\t            Some(byte) => {\n47\t                buffer[count] = byte;\n48\t                count += 1;\n49\t                if byte == b'\\n' {\n50\t                    break;\n51\t                }\n52\t            }\n53\t            None => break,\n54\t        }\n55\t    }\n56\t    if count == 0 {\n57\t        // EOF (or error) with no characters read: fgets returns NULL and the\n58\t        // buffer contents are left untouched.\n59\t        return false;\n60\t    }\n61\t    buffer[count] = 0;\n62\t    true\n63\t}\n64\t\n65\tfn read_byte<R: BufRead>(stream: &mut R) -> Option<u8> {\n66\t    loop {\n67\t        let available = match stream.fill_buf() {\n68\t            Ok(slice) => slice,\n69\t            Err(ref e) if e.kind() == std::io::ErrorKind::Interrupted => continue,\n70\t            Err(_) => return None,\n71\t        };\n72\t        if available.is_empty() {\n73\t            return None;\n74\t        }\n75\t        let byte = available[0];\n76\t        stream.consume(1);\n77\t        return Some(byte);\n78\t    }\n79\t}\n80\t\n81\tfn is_c_space(byte: u8) -> bool {\n82\t    matches!(byte, b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r')\n83\t}\n84\t\n85\tfn starts_with_ci(haystack: &[u8], needle: &[u8]) -> bool {\n86\t    haystack.len() >= needle.len()\n87\t        && haystack[..needle.len()]\n88\t            .iter()\n89\t            .zip(needle.iter())\n90\t            .all(|(a, b)| a.to_ascii_lowercase() == *b)\n91\t}\n92\t\n93\t/// Emulates `atof()` on a NUL-terminated C string: `strtod()` semantics with\n94\t/// the end pointer discarded and no error reporting.\n95\tfn c_atof(bytes: &[u8]) -> f64 {\n96\t    let text = match bytes.iter()