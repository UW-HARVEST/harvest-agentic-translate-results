mulss(subss(yAe.y, yAp.y), t), yAp.y); // GCC: reversed' \\\\\n  'let y = addss(yAp.y, mulss(subss(yAe.y, yAp.y), t));' || [ $? -eq 1 ] || BLIND=1''',\n'''# NOTE: the *order* of this addss is provably unobservable (reaching the\n# side-plane branch forces yAp.x/yAe.x non-NaN, which forces yAp.y non-NaN, and\n# addition of non-NaNs is commutative). A 20M-case search over an alphabet built\n# specifically to make two distinct NaNs meet here found no witness. So mutate\n# the non-commutative subtraction inside it, which IS observable.\nrun_mutation \"c2RaytoCapsule: y interpolation subtraction reversed\" \\\\\n  'let y = addss(mulss(subss(yAe.y, yAp.y), t), yAp.y); // GCC: reversed' \\\\\n  'let y = addss(mulss(subss(yAp.y, yAe.y), t), yAp.y);' || [ $? -eq 1 ] || BLIND=1''')\n\n# 3. sqrtss: `f32::sqrt` already IS sqrtss, so removing the guards is a no-op.\n#    Mutate something observable instead: clearing a NaN's sign.\ns=s.replace('''run_mutation \"sqrtss: use f32::NAN instead of the x86 indefinite QNaN\" \\\\\n  '    } else if x < 0.0 {\n        INDEFINITE\n    } else {\n        x.sqrt()\n    }' \\\\\n  '    } else {\n        x.sqrt()\n    }' || [ $? -eq 1 ] || BLIND=1''',\n'''# NOTE: `f32::sqrt` already lowers to SQRTSS and reproduces its NaN handling\n# exactly (verified: sqrt(-1.0) == 0xFFC00000, sqrt(sNaN) is quieted), and the\n# only caller passes `c2Dot(a,a)`, which can never be negative. So dropping the\n# guard clauses is a semantic no-op. Mutate an observable property instead: the\n# sign bit of a propagated NaN.\nrun_mutation \"sqrtss: normalise the NaN sign (as fabs would)\" \\\\\n  '    if x.is_nan() {\n        quiet(x)\n    } else if x < 0.0 {' \\\\\n  '    if x.is_nan() {\n        quiet(f32::from_bits(x.to_bits() & 0x7FFF_FFFF))\n    } else if x < 0.0 {' || [ $? -eq 1 ] || BLIND=1''')\n\n# 4. poly_ray: swapping the directions is unobservable because BOTH rays miss.\n#    Use a mutation that changes the outcome.\ns=s.replace('''run_mutation \"poly_ray: swap the two ray directions\" \\\\\n  '        d: c2v { x: 1.0, y: 0.0 },\n        t: 4.0,\n    };\n    let ray1 = c2Ray {' \\\\\n  '        d: c2v { x: 0.0, y: -1.0 },\n        t: 4.0,\n    };\n    let ray1 = c2Ray {' || [ $? -eq 1 ] || BLIND=1''',\n'''# NOTE: in the hard-coded scenario BOTH rays miss, so permuting them is\n# unobservable through the public API (the C behaves identically). Mutate the\n# ray ORIGIN instead, which turns a miss into a hit.\nrun_mutation \"poly_ray: perturb the hard-coded ray origin\" \\\\\n  'x: -3.869416f32,\n            y: 13.0693407f32,' \\\\\n  'x: -3.869416f32,\n            y: 0.0f32,' || [ $? -eq 1 ] || BLIND=1\n\nrun_mutation \"poly_ray: change the hard-coded polygon vertex\" \\\\\n  'p.verts[0] = c2V(0.875f32, -11.5f32);' \\\\\n  'p.verts[0] = c2V(8.875f32, -11.5f32);' || [ $? -eq 1 ] || BLIND=1\n\nrun_mutation \"poly_ray: drop the << 1 on the second hit\" \\\\\n  '        cast2,\n    ) << 1;' \\\\\n  '        cast2,\n    );' || [ $? -eq 1 ] || BLIND=1''')\n\n# Run the suite in release for speed.\ns=s.replace('if timeout 600 cargo test >/dev/null 2>&1; then',\n            'if timeout 600 cargo test --release -q >/dev/null 2>&1; then')\ns=s.replace('if timeout 600 cargo test >/dev/null 2>&1; then\\n  echo \"  restored source: PASS\"',\n            'if timeout 600 cargo test --release -q >/dev/null 2>&1; then\\n  echo \"  restored source: PASS\"')\nopen(p,'w').write(s)\nprint(\"ok\")\nPY\ngrep -c 'run_mutation' mutation_check.sh","description":"Update mutation script with observable variants"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":762,"cache_read_input_tokens":377278,"cache_creation":{"ephemeral_5m_input_tokens":762,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"d7f5ddbc-08b7-475f-b88b-e2f573c46cbe","uuid":"3cbcd83f-ab40-4ca0-abd3-e086e2dbae77","timestamp"