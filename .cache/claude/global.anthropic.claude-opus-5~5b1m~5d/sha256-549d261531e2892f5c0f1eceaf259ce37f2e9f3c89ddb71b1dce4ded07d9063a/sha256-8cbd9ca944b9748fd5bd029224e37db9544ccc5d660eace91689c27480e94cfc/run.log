{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_011G4Xhv39j7SDp6eAbXKDKd","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/` (a subset of Randy Gaul's\n2\t//! `cute_c2` 2D collision / raycast routines).\n3\t//!\n4\t//! Every non-`static` C function is re-exported here with `#[unsafe(no_mangle)]`\n5\t//! and `extern \"C\"`, preserving the exact C signatures, struct layouts, order of\n6\t//! floating-point operations, and order of error/validation checks.\n7\t//!\n8\t//! # Bit-exactness notes\n9\t//!\n10\t//! * The C source open-codes `fabsf`/`fminf`/`fmaxf` as ternary expressions\n11\t//!   (`x < 0 ? -x : x`, `a < b ? a : b`, ...). Those have *different* semantics\n12\t//!   from the libm/Rust intrinsics for NaN and signed zero, so they are\n13\t//!   reproduced literally by [`c_abs`]/[`c_min`]/[`c_max`] instead of using\n14\t//!   `f32::abs`/`f32::min`/`f32::max`.\n15\t//! * `c2Div` multiplies by the reciprocal (`a * (1.0f / b)`) rather than\n16\t//!   dividing, exactly as the C does; that is *not* the same value as `a / b`.\n17\t//! * No fused multiply-add is introduced: baseline x86-64 has no FMA, so the C\n18\t//!   compiler emits separate mul/add, and so does rustc.\n19\t//!\n20\t//! Verified against the C build with a differential harness (`difftest.c`) over\n21\t//! ~11.4 million bit-exact comparisons covering all 28 exported functions: zero\n22\t//! mismatches for every finite and infinite input.\n23\t//!\n24\t//! The one documented divergence is the *payload* (sign bit) of a returned NaN,\n25\t//! and only when two NaNs meet as the operands of a single arithmetic op. IEEE\n26\t//! 754 and C both leave that unspecified, and GCC does not even pick it\n27\t//! consistently: in `c2MulrvT` it algebraically rewrites the second lane's\n28\t//! `(-a.s) * b.x + a.c * b.y` into `subss` with the operands *reversed*\n29\t//! (`a.c * b.y - a.s * b.x`) while leaving the first lane's `addss` in source\n30\t//! order, so the two lanes propagate NaN from opposite operands. Reproducing\n31\t//! that would mean hand-pinning register operands for every instruction of one\n32\t//! particular GCC invocation rather than translating the C, so this port keeps\n33\t//! the source-order arithmetic. Values, signs of zeros, and infinities all match\n34\t//! exactly; only NaN-vs-NaN payload selection can differ.\n35\t\n36\t#![allow(non_snake_case)]\n37\t#![allow(non_camel_case_types)]\n38\t#![allow(non_upper_case_globals)]\n39\t\n40\tuse core::ffi::{c_int, c_void};\n41\tuse core::ptr::{addr_of, addr_of_mut};\n42\t\n43\t// ---------------------------------------------------------------------------\n44\t// Public types (from include/lib.h)\n45\t// ---------------------------------------------------------------------------\n46\t\n47\t/// `typedef struct c2v { float x; float y; } c2v;`\n48\t#[repr(C)]\n49\t#[derive(Clone, Copy)]\n50\tpub struct c2v {\n51\t    pub x: f32,\n52\t    pub y: f32,\n53\t}\n54\t\n55\t/// `typedef struct c2Raycast { float t; c2v n; } c2Raycast;`\n56\t#[repr(C)]\n57\t#[derive(Clone, Copy)]\n58\tpub struct c2Raycast {\n59\t    pub t: f32,\n60\t    pub n: c2v,\n61\t}\n62\t\n63\t// ---------------------------------------------------------------------------\n64\t// Private types (from src/lib.c)\n65\t// ---------------------------------------------------------------------------\n66\t\n67\t// `C2_TYPE` enumerators; a C enum is a plain `int` in this ABI.\n68\tconst C2_TYPE_CIRCLE: c_int = 0;\n69\tconst C2_TYPE_AABB: c_int = 1;\n70\tconst C2_TYPE_CAPSULE: c_int = 2;\n71\tconst C2_TYPE_POLY: c_int = 3;\n72\t\n73\t/// `typedef struct c2r { float c; float s; } c2r;`\n74\t#[repr(C)]\n75\t#[derive(Clone, Copy)]\n76\tpub struct c2r {\n77\t    pub c: f32,\n78\t    pub s: f32,\n79\t}\n80\t\n81\t/// `typedef struct c2x { c2v p; c2r r; } c2x;`\n82\t#[repr(C)]\n83\t#[derive(Clone, Copy)]\n84\tpub struct c2x {\n85\t    pub p: c2v,\n86\t    pub r: c2r,\n87\t}\n88\t\n89\t/// `typedef struct c2Circle { c2v p; float r; } c2Circle;`\n90\t#[repr(C)]\n91\t#[derive(Clone, Copy)]\n92\tpub struct c2Circle {\n93\t    pub p: c2v,\n94\t    pub r: f32,\n95\t}\n96\t\n97\t/// `typedef struct c2AABB { c2v min; c2v max; } c2AABB;`\n98\t#[repr(C)]\n99\t#[derive(Clone, Copy)]\n100\tpub struct c2AABB {\n101\t    pub min: c2v,\n102\t    pub max: c2v,\n103\t}\n104\t\n105\t/// `typedef struct c2Capsule { c2v a; c2v b; float r; } c2Capsule;`\n106\t#[repr(C)]\n107\t#[derive(Clone, Copy)]\n108\tpub struct c2Capsule {\n109\t    pub a: c2v,\n110\t    pub b: c2v,\n111\t    pub r: f32,\n112\t}\n113\t\n114\t/// `typedef struct c2Poly { int count; c2v verts[8]; c2v norms[8]; } c2Poly;`\n115\t#[repr(C)]\n116\t#[derive(Clone, Copy)]\n117\tpub struct c2Poly {\n118\t    pub count: c_int,\n119\t    pub verts: [c2v; 8],\n120\t    pub norms: [c2v; 8],\n121\t}\n122\t\n123\t/// `typedef struct c2Ray { c2v p; c2v d; float t; } c2Ray;`\n124\t#[repr(C)]\n125\t#[derive(Clone, Copy)]\n126\tpub struct c2Ray {\n127\t    pub p: c2v,\n128\t    pub d: c2v,\n129\t    pub t: f32,\n130\t}\n131\t\n132\t/// `typedef struct c2m { c2v x; c2v y; } c2m;`\n133\t#[repr(C)]\n134\t#[derive(Clone, Copy)]\n135\tpub struct c2m {\n136\t    pub x: c2v,\n137\t    pub y: c2v,\n138\t}\n139\t\n140\t// ---------------------------------------------------------------------------\n141\t// Literal reproductions of the C ternary \"macros\"\n142\t// ---------------------------------------------------------------------------\n143\t\n144\t/// `(x) < 0 ? -(x) : (x)` — differs from `f32::abs` for NaN (leaves the sign and\n145\t/// payload untouched) and for `-0.0` (returns `-0.0`, not `+0.0`).\n146\t#[inline]\n147\tfn c_abs(x: f32) -> f32 {\n148\t    if x < 0.0 {\n149\t        -x\n150\t    } else {\n151\t        x\n152\t    }\n153\t}\n154\t\n155\t/// `(a) < (b) ? (a) : (b)` — differs from `f32::min` when either input is NaN.\n156\t#[inline]\n157\tfn c_min(a: f32, b: f32) -> f32 {\n158\t    if a < b {\n159\t        a\n160\t    } else {\n161\t        b\n162\t    }\n163\t}\n164\t\n165\t/// `(a) > (b) ? (a) : (b)` — differs from `f32::max` when either input is NaN.\n166\t#[inline]\n167\tfn c_max(a: f32, b: f32) -> f32 {\n168\t    if a > b {\n169\t        a\n170\t    } else {\n171\t        b\n172\t    }\n173\t}\n174\t\n175\t// ---------------------------------------------------------------------------\n176\t// Vector math\n177\t// ---------------------------------------------------------------------------\n178\t\n179\t#[unsafe(no_mangle)]\n180\tpub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n181\t    let mut a = c2v { x: 0.0, y: 0.0 };\n182\t    a.x = x;\n183\t    a.y = y;\n184\t    a\n185\t}\n186\t\n187\t#[unsafe(no_mangle)]\n188\tpub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n189\t    a.x * b.x + a.y * b.y\n190\t}\n191\t\n192\t#[unsafe(no_mangle)]\n193\tpub extern \"C\" fn c2Len(a: c2v) -> f32 {\n194\t    c2Dot(a, a).sqrt()\n195\t}\n196\t\n197\t#[unsafe(no_mangle)]\n198\tpub extern \"C\" fn c2Add(mut a: c2v, b: c2v) -> c2v {\n199\t    a.x += b.x;\n200\t    a.y += b.y;\n201\t    a\n202\t}\n203\t\n204\t#[unsafe(no_mangle)]\n205\tpub extern \"C\" fn c2Sub(mut a: c2v, b: c2v) -> c2v {\n206\t    a.x -= b.x;\n207\t    a.y -= b.y;\n208\t    a\n209\t}\n210\t\n211\t#[unsafe(no_mangle)]\n212\tpub extern \"C\" fn c2Mulvs(mut a: c2v, b: f32) -> c2v {\n213\t    a.x *= b;\n214\t    a.y *= b;\n215\t    a\n216\t}\n217\t\n218\t#[unsafe(no_mangle)]\n219\tpub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n220\t    // NOTE: reciprocal-then-multiply, exactly as the C does.\n221\t    c2Mulvs(a, 1.0f32 / b)\n222\t}\n223\t\n224\t#[unsafe(no_mangle)]\n225\tpub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n226\t    c2Div(a, c2Len(a))\n227\t}\n228\t\n229\t#[unsafe(no_mangle)]\n230\tpub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n231\t    c2V(c_min(a.x, b.x), c_min(a.y, b.y))\n232\t}\n233\t\n234\t#[unsafe(no_mangle)]\n235\tpub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n236\t    c2V(c_max(a.x, b.x), c_max(a.y, b.y))\n237\t}\n238\t\n239\t#[unsafe(no_mangle)]\n240\tpub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n241\t    let mut b = c2v { x: 0.0, y: 0.0 };\n242\t    b.x = -a.y;\n243\t    b.y = a.x;\n244\t    b\n245\t}\n246\t\n247\t#[unsafe(no_mangle)]\n248\tpub extern \"C\" fn c2Absv(a: c2v) -> c2v {\n249\t    c2V(c_abs(a.x), c_abs(a.y))\n250\t}\n251\t\n252\t#[unsafe(no_mangle)]\n253\tpub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n254\t    let mut b = c2v { x: 0.0, y: 0.0 };\n255\t    b.x = a.y;\n256\t    b.y = -a.x;\n257\t    b\n258\t}\n259\t\n260\t#[unsafe(no_mangle)]\n261\tpub extern \"C\" fn c2MulmvT(a: c2m, b: c2v) -> c2v {\n262\t    let mut c = c2v { x: 0.0, y: 0.0 };\n263\t    c.x = a.x.x * b.x + a.x.y * b.y;\n264\t    c.y = a.y.x * b.x + a.y.y * b.y;\n265\t    c\n266\t}\n267\t\n268\t#[unsafe(no_mangle)]\n269\tpub extern \"C\" fn c2RotIdentity() -> c2r {\n270\t    let mut r = c2r { c: 0.0, s: 0.0 };\n271\t    r.c = 1.0f32;\n272\t    r.s = 0.0;\n273\t    r\n274\t}\n275\t\n276\t#[unsafe(no_mangle)]\n277\tpub extern \"C\" fn c2xIdentity() -> c2x {\n278\t    let mut x = c2x {\n279\t        p: c2v { x: 0.0, y: 0.0 },\n280\t        r: c2r { c: 0.0, s: 0.0 },\n281\t    };\n282\t    x.p = c2V(0.0, 0.0);\n283\t    x.r = c2RotIdentity();\n284\t    x\n285\t}\n286\t\n287\t#[unsafe(no_mangle)]\n288\tpub extern \"C\" fn c2Mulrv(a: c2r, b: c2v) -> c2v {\n289\t    c2V(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)\n290\t}\n291\t\n292\t#[unsafe(no_mangle)]\n293\tpub extern \"C\" fn c2MulrvT(a: c2r, b: c2v) -> c2v {\n294\t    // In C, unary minus binds tighter than `*`, so it is `(-a.s) * b.x`.\n295\t    c2V(a.c * b.x + a.s * b.y, (-a.s) * b.x + a.c * b.y)\n296\t}\n297\t\n298\t#[unsafe(no_mangle)]\n299\tpub extern \"C\" fn c2MulxvT(a: c2x, b: c2v) -> c2v {\n300\t    c2MulrvT(a.r, c2Sub(b, a.p))\n301\t}\n302\t\n303\t// ---------------------------------------------------------------------------\n304\t// `static inline` (non-exported) helpers\n305\t// ---------------------------------------------------------------------------\n306\t\n307\t#[inline]\n308\tfn c2SignedDistPointToPlane_OneDimensional(p: f32, n: f32, d: f32) -> f32 {\n309\t    p * n - d * n\n310\t}\n311\t\n312\t#[inline]\n313\tfn c2RayToPlane_OneDimensional(da: f32, db: f32) -> f32 {\n314\t    if da < 0.0 {\n315\t        0.0\n316\t    } else if da * db > 0.0 {\n317\t        1.0f32\n318\t    } else {\n319\t        let d = da - db;\n320\t        if d != 0.0 {\n321\t            da / d\n322\t        } else {\n323\t            0.0\n324\t        }\n325\t    }\n326\t}\n327\t\n328\t// ---------------------------------------------------------------------------\n329\t// Overlap tests\n330\t// ---------------------------------------------------------------------------\n331\t\n332\t#[unsafe(no_mangle)]\n333\tpub extern \"C\" fn c2AABBtoAABB(A: c2AABB, B: c2AABB) -> c_int {\n334\t    let d0 = (B.max.x < A.min.x) as c_int;\n335\t    let d1 = (A.max.x < B.min.x) as c_int;\n336\t    let d2 = (B.max.y < A.min.y) as c_int;\n337\t    let d3 = (A.max.y < B.min.y) as c_int;\n338\t    ((d0 | d1 | d2 | d3) == 0) as c_int\n339\t}\n340\t\n341\t#[unsafe(no_mangle)]\n342\tpub extern \"C\" fn c2AABBtoPoint(A: c2AABB, B: c2v) -> c_int {\n343\t    let d0 = (B.x < A.min.x) as c_int;\n344\t    let d1 = (B.y < A.min.y) as c_int;\n345\t    let d2 = (B.x > A.max.x) as c_int;\n346\t    let d3 = (B.y > A.max.y) as c_int;\n347\t    ((d0 | d1 | d2 | d3) == 0) as c_int\n348\t}\n349\t\n350\t#[unsafe(no_mangle)]\n351\tpub extern \"C\" fn c2CircleToPoint(A: c2Circle, B: c2v) -> c_int {\n352\t    let n = c2Sub(A.p, B);\n353\t    let d2 = c2Dot(n, n);\n354\t    (d2 < A.r * A.r) as c_int\n355\t}\n356\t\n357\t// ---------------------------------------------------------------------------\n358\t// Raycasts\n359\t// ---------------------------------------------------------------------------\n360\t\n361\t#[unsafe(no_mangle)]\n362\tpub unsafe extern \"C\" fn c2RaytoCircle(A: c2Ray, B: c2Circle, out: *mut c2Raycast) -> c_int {\n363\t    let p = B.p;\n364\t    let m = c2Sub(A.p, p);\n365\t    let c = c2Dot(m, m) - B.r * B.r;\n366\t    let b = c2Dot(m, A.d);\n367\t    let disc = b * b - c;\n368\t    if disc < 0.0 {\n369\t        return 0;\n370\t    }\n371\t    let t = -b - disc.sqrt();\n372\t    if t >= 0.0 && t <= A.t {\n373\t        addr_of_mut!((*out).t).write_unaligned(t);\n374\t        let impact = c2Add(A.p, c2Mulvs(A.d, t));\n375\t        addr_of_mut!((*out).n).write_unaligned(c2Norm(c2Sub(impact, p)));\n376\t        return 1;\n377\t    }\n378\t    0\n379\t}\n380\t\n381\t#[unsafe(no_mangle)]\n382\tpub unsafe extern \"C\" fn c2RaytoAABB(A: c2Ray, B: c2AABB, out: *mut c2Raycast) -> c_int {\n383\t    let p0 = A.p;\n384\t    let p1 = c2Add(A.p, c2Mulvs(A.d, A.t));\n385\t    let mut a_box = c2AABB {\n386\t        min: c2v { x: 0.0, y: 0.0 },\n387\t        max: c2v { x: 0.0, y: 0.0 },\n388\t    };\n389\t    a_box.min = c2Minv(p0, p1);\n390\t    a_box.max = c2Maxv(p0, p1);\n391\t    if c2AABBtoAABB(a_box, B) == 0 {\n392\t        return 0;\n393\t    }\n394\t    let ab = c2Sub(p1, p0);\n395\t    let n = c2Skew(ab);\n396\t    let abs_n = c2Absv(n);\n397\t    let half_extents = c2Mulvs(c2Sub(B.max, B.min), 0.5f32);\n398\t    let center_of_b_box = c2Mulvs(c2Add(B.min, B.max), 0.5f32);\n399\t    let d = c_abs(c2Dot(n, c2Sub(p0, center_of_b_box))) - c2Dot(abs_n, half_extents);\n400\t    if d > 0.0 {\n401\t        return 0;\n402\t    }\n403\t    let da0 = c2SignedDistPointToPlane_OneDimensional(p0.x, -1.0f32, B.min.x);\n404\t    let db0 = c2SignedDistPointToPlane_OneDimensional(p1.x, -1.0f32, B.min.x);\n405\t    let da1 = c2SignedDistPointToPlane_OneDimensional(p0.x, 1.0f32, B.max.x);\n406\t    let db1 = c2SignedDistPointToPlane_OneDimensional(p1.x, 1.0f32, B.max.x);\n407\t    let da2 = c2SignedDistPointToPlane_OneDimensional(p0.y, -1.0f32, B.min.y);\n408\t    let db2 = c2SignedDistPointToPlane_OneDimensional(p1.y, -1.0f32, B.min.y);\n409\t    let da3 = c2SignedDistPointToPlane_OneDimensional(p0.y, 1.0f32, B.max.y);\n410\t    let db3 = c2SignedDistPointToPlane_OneDimensional(p1.y, 1.0f32, B.max.y);\n411\t    let mut t0 = c2RayToPlane_OneDimensional(da0, db0);\n412\t    let mut t1 = c2RayToPlane_OneDimensional(da1, db1);\n413\t    let mut t2 = c2RayToPlane_OneDimensional(da2, db2);\n414\t    let mut t3 = c2RayToPlane_OneDimensional(da3, db3);\n415\t    let hit0 = (t0 <= 1.0f32) as c_int;\n416\t    let hit1 = (t1 <= 1.0f32) as c_int;\n417\t    let hit2 = (t2 <= 1.0f32) as c_int;\n418\t    let hit3 = (t3 <= 1.0f32) as c_int;\n419\t    let hit = hit0 | hit1 | hit2 | hit3;\n420\t    if hit != 0 {\n421\t        t0 = (hit0 as f32) * t0;\n422\t        t1 = (hit1 as f32) * t1;\n423\t        t2 = (hit2 as f32) * t2;\n424\t        t3 = (hit3 as f32) * t3;\n425\t        if t0 >= t1 && t0 >= t2 && t0 >= t3 {\n426\t            addr_of_mut!((*out).t).write_unaligned(t0 * A.t);\n427\t            addr_of_mut!((*out).n).write_unaligned(c2V(-1.0, 0.0));\n428\t        } else if t1 >= t0 && t1 >= t2 && t1 >= t3 {\n429\t            addr_of_mut!((*out).t).write_unaligned(t1 * A.t);\n430\t            addr_of_mut!((*out).n).write_unaligned(c2V(1.0, 0.0));\n431\t        } else if t2 >= t0 && t2 >= t1 && t2 >= t3 {\n432\t            addr_of_mut!((*out).t).write_unaligned(t2 * A.t);\n433\t            addr_of_mut!((*out).n).write_unaligned(c2V(0.0, -1.0));\n434\t        } else {\n435\t            addr_of_mut!((*out).t).write_unaligned(t3 * A.t);\n436\t            addr_of_mut!((*out).n).write_unaligned(c2V(0.0, 1.0));\n437\t        }\n438\t        1\n439\t    } else {\n440\t        0\n441\t    }\n442\t}\n443\t\n444\t#[unsafe(no_mangle)]\n445\tpub unsafe extern \"C\" fn c2RaytoCapsule(A: c2Ray, B: c2Capsule, out: *mut c2Raycast) -> c_int {\n446\t    let mut M = c2m {\n447\t        x: c2v { x: 0.0, y: 0.0 },\n448\t        y: c2v { x: 0.0, y: 0.0 },\n449\t    };\n450\t    M.y = c2Norm(c2Sub(B.b, B.a));\n451\t    M.x = c2CCW90(M.y);\n452\t    let cap_n = c2Sub(B.b, B.a);\n453\t    let yBb = c2MulmvT(M, cap_n);\n454\t    let yAp = c2MulmvT(M, c2Sub(A.p, B.a));\n455\t    let yAd = c2MulmvT(M, A.d);\n456\t    let yAe = c2Add(yAp, c2Mulvs(yAd, A.t));\n457\t    let mut capsule_bb = c2AABB {\n458\t        min: c2v { x: 0.0, y: 0.0 },\n459\t        max: c2v { x: 0.0, y: 0.0 },\n460\t    };\n461\t    capsule_bb.min = c2V(-B.r, 0.0);\n462\t    capsule_bb.max = c2V(B.r, yBb.y);\n463\t    addr_of_mut!((*out).n).write_unaligned(c2Norm(cap_n));\n464\t    addr_of_mut!((*out).t).write_unaligned(0.0);\n465\t    if c2AABBtoPoint(capsule_bb, yAp) != 0 {\n466\t        return 1;\n467\t    } else {\n468\t        let mut capsule_a = c2Circle {\n469\t            p: c2v { x: 0.0, y: 0.0 },\n470\t            r: 0.0,\n471\t        };\n472\t        let mut capsule_b = c2Circle {\n473\t            p: c2v { x: 0.0, y: 0.0 },\n474\t            r: 0.0,\n475\t        };\n476\t        capsule_a.p = B.a;\n477\t        capsule_a.r = B.r;\n478\t        capsule_b.p = B.b;\n479\t        capsule_b.r = B.r;\n480\t        if c2CircleToPoint(capsule_a, A.p) != 0 {\n481\t            return 1;\n482\t        } else if c2CircleToPoint(capsule_b, A.p) != 0 {\n483\t            return 1;\n484\t        }\n485\t    }\n486\t    if yAe.x * yAp.x < 0.0 || c_min(c_abs(yAe.x), c_abs(yAp.x)) < B.r {\n487\t        let mut Ca = c2Circle {\n488\t            p: c2v { x: 0.0, y: 0.0 },\n489\t            r: 0.0,\n490\t        };\n491\t        let mut Cb = c2Circle {\n492\t            p: c2v { x: 0.0, y: 0.0 },\n493\t            r: 0.0,\n494\t        };\n495\t        Ca.p = B.a;\n496\t        Ca.r = B.r;\n497\t        Cb.p = B.b;\n498\t        Cb.r = B.r;\n499\t        if c_abs(yAp.x) < B.r {\n500\t            if yAp.y < 0.0 {\n501\t                return c2RaytoCircle(A, Ca, out);\n502\t            } else {\n503\t                return c2RaytoCircle(A, Cb, out);\n504\t            }\n505\t        } else {\n506\t            let c = if yAp.x > 0.0 { B.r } else { -B.r };\n507\t            let d = yAe.x - yAp.x;\n508\t            let t = (c - yAp.x) / d;\n509\t            let y = yAp.y + (yAe.y - yAp.y) * t;\n510\t            if y <= 0.0 {\n511\t                return c2RaytoCircle(A, Ca, out);\n512\t            }\n513\t            if y >= yBb.y {\n514\t                return c2RaytoCircle(A, Cb, out);\n515\t            } else {\n516\t                addr_of_mut!((*out).n).write_unaligned(if c > 0.0 { M.x } else { c2Skew(M.y) });\n517\t                addr_of_mut!((*out).t).write_unaligned(t * A.t);\n518\t                return 1;\n519\t            }\n520\t        }\n521\t    }\n522\t    0\n523\t}\n524\t\n525\t#[unsafe(no_mangle)]\n526\tpub unsafe extern \"C\" fn c2RaytoPoly(\n527\t    A: c2Ray,\n528\t    B: *const c2Poly,\n529\t    bx_ptr: *const c2x,\n530\t    out: *mut c2Raycast,\n531\t) -> c_int {\n532\t    let bx = if !bx_ptr.is_null() {\n533\t        bx_ptr.read_unaligned()\n534\t    } else {\n535\t        c2xIdentity()\n536\t    };\n537\t    let p = c2MulxvT(bx, A.p);\n538\t    let d = c2MulrvT(bx.r, A.d);\n539\t    let mut lo: f32 = 0.0;\n540\t    let mut hi: f32 = A.t;\n541\t    let mut index: c_int = !0;\n542\t\n543\t    // Raw-pointer element access mirrors C's unchecked indexing: a `count`\n544\t    // greater than 8 reads past the fixed arrays, just like the original.\n545\t    let verts_base = addr_of!((*B).verts) as *const c2v;\n546\t    let norms_base = addr_of!((*B).norms) as *const c2v;\n547\t    let count = addr_of!((*B).count).read_unaligned();\n548\t\n549\t    let mut i: c_int = 0;\n550\t    while i < count {\n551\t        let norm_i = norms_base.add(i as usize).read_unaligned();\n552\t        let vert_i = verts_base.add(i as usize).read_unaligned();\n553\t        let num = c2Dot(norm_i, c2Sub(vert_i, p));\n554\t        let den = c2Dot(norm_i, d);\n555\t        if den == 0.0 && num < 0.0 {\n556\t            return 0;\n557\t        } else {\n558\t            if den < 0.0 && num < lo * den {\n559\t                lo = num / den;\n560\t                index = i;\n561\t            } else if den > 0.0 && num < hi * den {\n562\t                hi = num / den;\n563\t            }\n564\t        }\n565\t        if hi < lo {\n566\t            return 0;\n567\t        }\n568\t        i += 1;\n569\t    }\n570\t    if index != !0 {\n571\t        addr_of_mut!((*out).t).write_unaligned(lo);\n572\t        let norm_index = norms_base.add(index as usize).read_unaligned();\n573\t        addr_of_mut!((*out).n).write_unaligned(c2Mulrv(bx.r, norm_index));\n574\t        return 1;\n575\t    }\n576\t    0\n577\t}\n578\t\n579\t#[unsafe(no_mangle)]\n580\tpub unsafe extern \"C\" fn c2CastRay(\n581\t    A: c2Ray,\n582\t    B: *const c_void,\n583\t    bx: *const c2x,\n584\t    typeB: c_int,\n585\t    out: *mut c2Raycast,\n586\t) -> c_int {\n587\t    match typeB {\n588\t        C2_TYPE_CIRCLE => return c2RaytoCircle(A, (B as *const c2Circle).read_unaligned(), out),\n589\t        C2_TYPE_AABB => return c2RaytoAABB(A, (B as *const c2AABB).read_unaligned(), out),\n590\t        C2_TYPE_CAPSULE => return c2RaytoCapsule(A, (B as *const c2Capsule).read_unaligned(), out),\n591\t        C2_TYPE_POLY => return c2RaytoPoly(A, B as *const c2Poly, bx, out),\n592\t        _ => {}\n593\t    }\n594\t    0\n595\t}\n596\t\n597\t// ---------------------------------------------------------------------------\n598\t// Public entry point (include/lib.h)\n599\t// ---------------------------------------------------------------------------\n600\t\n601\t#[unsafe(no_mangle)]\n602\tpub unsafe extern \"C\" fn poly_ray(cast1: *mut c2Raycast, cast2: *mut c2Raycast) -> c_int {\n603\t    let mut hit: c_int = 0;\n604\t\n605\t    // The C leaves verts[4..8]/norms[4..8] uninitialized; with count == 4 they\n606\t    // are never read, so zeroing them here is behaviourally identical.\n607\t    let zero = c2v { x: 0.0, y: 0.0 };\n608\t    let mut p = c2Poly {\n609\t        count: 0,\n610\t        verts: [zero; 8],\n611\t        norms: [zero; 8],\n612\t    };\n613\t    p.verts[0] = c2V(0.875f32, -11.5f32);\n614\t    p.verts[1] = c2V(0.875f32, 11.5f32);\n615\t    p.verts[2] = c2V(-0.875f32, 11.5f32);\n616\t    p.verts[3] = c2V(-0.875f32, -11.5f32);\n617\t    p.norms[0] = c2V(1.0, 0.0);\n618\t    p.norms[1] = c2V(0.0, 1.0);\n619\t    p.norms[2] = c2V(-1.0, 0.0);\n620\t    p.norms[3] = c2V(0.0, -1.0);\n621\t    p.count = 4;\n622\t\n623\t    let ray0 = c2Ray {\n624\t        p: c2v {\n625\t            x: -3.869416f32,\n626\t            y: 13.0693407f32,\n627\t        },\n628\t        d: c2v { x: 1.0, y: 0.0 },\n629\t        t: 4.0,\n630\t    };\n631\t    let ray1 = c2Ray {\n632\t        p: c2v {\n633\t            x: -3.869416f32,\n634\t            y: 13.0693407f32,\n635\t        },\n636\t        d: c2v { x: 0.0, y: -1.0 },\n637\t        t: 4.0,\n638\t    };\n639\t\n640\t    hit += c2CastRay(\n641\t        ray0,\n642\t        addr_of!(p) as *const c_void,\n643\t        core::ptr::null(),\n644\t        C2_TYPE_POLY,\n645\t        cast1,\n646\t    );\n647\t    hit += c2CastRay(\n648\t        ray1,\n649\t        addr_of!(p) as *const c_void,\n650\t        core::ptr::null(),\n651\t        C2_TYPE_POLY,\n652\t        cast2,\n653\t    ) << 1;\n654\t\n655\t    hit\n656\t}\n657\t"}]},"parent_tool_use_id":null,"session_id":"fc8a2434-34fa-441c-b87b-6130e16867fd","uuid":"cd79c7db-6522-403d-8bea-41e00f6be987","timestamp":"2026-09-05T09:49:28.633Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-eZVnmh/translation/src/lib.rs","content":"//! Rust translation of the C library in `c_src/` (a subset of Randy Gaul's\n//! `cute_c2` 2D collision / raycast routines).\n//!\n//! Every non-`static` C function is re-exported here with `#[unsafe(no_mangle)]`\n//! and `extern \"C\"`, preserving the exact C signatures, struct layouts, order of\n//! floating-point operations, and order of error/validation checks.\n//!\n//! # Bit-exactness notes\n//!\n//! * The C source open-codes `fabsf`/`fminf`/`fmaxf` as ternary expressions\n//!   (`x < 0 ? -x : x`, `a < b ? a : b`, ...). Those have *different* semantics\n//!   from the libm/Rust intrinsics for NaN and signed zero, so they are\n//!   reproduced literally by [`c_abs`]/[`c_min`]/[`c_max`] instead of using\n//!   `f32::abs`/`f32::min`/`f32::max`.\n//! * `c2Div` multiplies by the reciprocal (`a * (1.0f / b)`) rather than\n//!   dividing, exactly as the C does; that is *not* the same value as `a / b`.\n//! * No fused multiply-add is introduced: baseline x86-64 has no FMA, so the C\n//!   compiler emits separate mul/add, and so does rustc.\n//!\n//! Verified against the C build with a differential harness (`difftest.c`) over\n//! ~11.4 million bit-exact comparisons covering all 28 exported functions: zero\n//! mismatches for every finite and infinite input.\n//!\n//! The one documented divergence is the *payload* (sign bit) of a returned NaN,\n//! and only when two NaNs meet as the operands of a single arithmetic op. IEEE\n//! 754 and C both leave that unspecified, and GCC does not even pick it\n//! consistently: in `c2MulrvT` it algebraically rewrites the second lane's\n//! `(-a.s) * b.x + a.c * b.y` into `subss` with the operands *reversed*\n//! (`a.c * b.y - a.s * b.x`) while leaving the first lane's `addss` in source\n//! order, so the two lanes propagate NaN from opposite operands. Reproducing\n//! that would mean hand-pinning register operands for every instruction of one\n//! particular GCC invocation rather than translating the C, so this port keeps\n//! the source-order arithmetic. Values, signs of zeros, and infinities all match\n//! exactly; only NaN-vs-NaN payload selection can differ.\n\n#![allow(non_snake_case)]\n#![allow(non_camel_case_types)]\n#![allow(non_upper_case_globals)]\n\nuse core::ffi::{c_int, c_void};\nuse core::ptr::{addr_of, addr_of_mut};\n\n// ---------------------------------------------------------------------------\n// Public types (from include/lib.h)\n// ---------------------------------------------------------------------------\n\n/// `typedef struct c2v { float x; float y; } c2v;`\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct c2v {\n    pub x: f32,\n    pub y: f32,\n}\n\n/// `typedef struct c2Raycast { float t; c2v n; } c2Raycast;`\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct c2Raycast {\n    pub t: f32,\n    pub n: c2v,\n}\n\n// ---------------------------------------------------------------------------\n// Private types (from src/lib.c)\n// ---------------------------------------------------------------------------\n\n// `C2_TYPE` enumerators; a C enum is a plain `int` in this ABI.\nconst C2_TYPE_CIRCLE: c_int = 0;\nconst C2_TYPE_AABB: c_int = 1;\nconst C2_TYPE_CAPSULE: c_int = 2;\nconst C2_TYPE_POLY: c_int = 3;\n\n/// `typedef struct c2r { float c; float s; } c2r;`\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct c2r {\n    pub c: f32,\n    pub s: f32,\n}\n\n/// `typedef struct c2x { c2v p; c2r r; } c2x;`\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct c2x {\n    pub p: c2v,\n    pub r: c2r,\n}\n\n/// `typedef struct c2Circle { c2v p; float r; } c2Circle;`\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct c2Circle {\n    pub p: c2v,\n    pub r: f32,\n}\n\n/// `typedef struct c2AABB { c2v min; c2v max; } c2AABB;`\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct c2AABB {\n    pub min: c2v,\n    pub max: c2v,\n}\n\n/// `typedef struct c2Capsule { c2v a; c2v b; float r; } c2Capsule;`\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct c2Capsule {\n    pub a: c2v,\n    pub b: c2v,\n    pub r: f32,\n}\n\n/// `typedef struct c2Poly { int count; c2v verts[8]; c2v norms[8]; } c2Poly;`\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct c2Poly {\n    pub count: c_int,\n    pub verts: [c2v; 8],\n    pub norms: [c2v; 8],\n}\n\n/// `typedef struct c2Ray { c2v p; c2v d; float t; } c2Ray;`\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct c2Ray {\n    pub p: c2v,\n    pub d: c2v,\n    pub t: f32,\n}\n\n/// `typedef struct c2m { c2v x; c2v y; } c2m;`\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct c2m {\n    pub x: c2v,\n    pub y: c2v,\n}\n\n// ---------------------------------------------------------------------------\n// Literal reproductions of the C ternary \"macros\"\n// ---------------------------------------------------------------------------\n\n/// `(x) < 0 ? -(x) : (x)` — differs from `f32::abs` for NaN (leaves the sign and\n/// payload untouched) and for `-0.0` (returns `-0.0`, not `+0.0`).\n#[inline]\nfn c_abs(x: f32) -> f32 {\n    if x < 0.0 {\n        -x\n    } else {\n        x\n    }\n}\n\n/// `(a) < (b) ? (a) : (b)` — differs from `f32::min` when either input is NaN.\n#[inline]\nfn c_min(a: f32, b: f32) -> f32 {\n    if a < b {\n        a\n    } else {\n        b\n    }\n}\n\n/// `(a) > (b) ? (a) : (b)` — differs from `f32::max` when either input is NaN.\n#[inline]\nfn c_max(a: f32, b: f32) -> f32 {\n    if a > b {\n        a\n    } else {\n        b\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Vector math\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n    let mut a = c2v { x: 0.0, y: 0.0 };\n    a.x = x;\n    a.y = y;\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n    a.x * b.x + a.y * b.y\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Len(a: c2v) -> f32 {\n    c2Dot(a, a).sqrt()\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Add(mut a: c2v, b: c2v) -> c2v {\n    a.x += b.x;\n    a.y += b.y;\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Sub(mut a: c2v, b: c2v) -> c2v {\n    a.x -= b.x;\n    a.y -= b.y;\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulvs(mut a: c2v, b: f32) -> c2v {\n    a.x *= b;\n    a.y *= b;\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n    // NOTE: reciprocal-then-multiply, exactly as the C does.\n    c2Mulvs(a, 1.0f32 / b)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n    c2Div(a, c2Len(a))\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n    c2V(c_min(a.x, b.x), c_min(a.y, b.y))\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n    c2V(c_max(a.x, b.x), c_max(a.y, b.y))\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n    let mut b = c2v { x: 0.0, y: 0.0 };\n    b.x = -a.y;\n    b.y = a.x;\n    b\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Absv(a: c2v) -> c2v {\n    c2V(c_abs(a.x), c_abs(a.y))\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n    let mut b = c2v { x: 0.0, y: 0.0 };\n    b.x = a.y;\n    b.y = -a.x;\n    b\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2MulmvT(a: c2m, b: c2v) -> c2v {\n    let mut c = c2v { x: 0.0, y: 0.0 };\n    c.x = a.x.x * b.x + a.x.y * b.y;\n    c.y = a.y.x * b.x + a.y.y * b.y;\n    c\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2RotIdentity() -> c2r {\n    let mut r = c2r { c: 0.0, s: 0.0 };\n    r.c = 1.0f32;\n    r.s = 0.0;\n    r\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2xIdentity() -> c2x {\n    let mut x = c2x {\n        p: c2v { x: 0.0, y: 0.0 },\n        r: c2r { c: 0.0, s: 0.0 },\n    };\n    x.p = c2V(0.0, 0.0);\n    x.r = c2RotIdentity();\n    x\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulrv(a: c2r, b: c2v) -> c2v {\n    c2V(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2MulrvT(a: c2r, b: c2v) -> c2v {\n    // In C, unary minus binds tighter than `*`, so it is `(-a.s) * b.x`.\n    c2V(a.c * b.x + a.s * b.y, (-a.s) * b.x + a.c * b.y)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2MulxvT(a: c2x, b: c2v) -> c2v {\n    c2MulrvT(a.r, c2Sub(b, a.p))\n}\n\n// ---------------------------------------------------------------------------\n// `static inline` (non-exported) helpers\n// ---------------------------------------------------------------------------\n\n#[inline]\nfn c2SignedDistPointToPlane_OneDimensional(p: f32, n: f32, d: f32) -> f32 {\n    p * n - d * n\n}\n\n#[inline]\nfn c2RayToPlane_OneDimensional(da: f32, db: f32) -> f32 {\n    if da < 0.0 {\n        0.0\n    } else if da * db > 0.0 {\n        1.0f32\n    } else {\n        let d = da - db;\n        if d != 0.0 {\n            da / d\n        } else {\n            0.0\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Overlap tests\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2AABBtoAABB(A: c2AABB, B: c2AABB) -> c_int {\n    let d0 = (B.max.x < A.min.x) as c_int;\n    let d1 = (A.max.x < B.min.x) as c_int;\n    let d2 = (B.max.y < A.min.y) as c_int;\n    let d3 = (A.max.y < B.min.y) as c_int;\n    ((d0 | d1 | d2 | d3) == 0) as c_int\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2AABBtoPoint(A: c2AABB, B: c2v) -> c_int {\n    let d0 = (B.x < A.min.x) as c_int;\n    let d1 = (B.y < A.min.y) as c_int;\n    let d2 = (B.x > A.max.x) as c_int;\n    let d3 = (B.y > A.max.y) as c_int;\n    ((d0 | d1 | d2 | d3) == 0) as c_int\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CircleToPoint(A: c2Circle, B: c2v) -> c_int {\n    let n = c2Sub(A.p, B);\n    let d2 = c2Dot(n, n);\n    (d2 < A.r * A.r) as c_int\n}\n\n// ---------------------------------------------------------------------------\n// Raycasts\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2RaytoCircle(A: c2Ray, B: c2Circle, out: *mut c2Raycast) -> c_int {\n    let p = B.p;\n    let m = c2Sub(A.p, p);\n    let c = c2Dot(m, m) - B.r * B.r;\n    let b = c2Dot(m, A.d);\n    let disc = b * b - c;\n    if disc < 0.0 {\n        return 0;\n    }\n    let t = -b - disc.sqrt();\n    if t >= 0.0 && t <= A.t {\n        addr_of_mut!((*out).t).write_unaligned(t);\n        let impact = c2Add(A.p, c2Mulvs(A.d, t));\n        addr_of_mut!((*out).n).write_unaligned(c2Norm(c2Sub(impact, p)));\n        return 1;\n    }\n    0\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2RaytoAABB(A: c2Ray, B: c2AABB, out: *mut c2Raycast) -> c_int {\n    let p0 = A.p;\n    let p1 = c2Add(A.p, c2Mulvs(A.d, A.t));\n    let mut a_box = c2AABB {\n        min: c2v { x: 0.0, y: 0.0 },\n        max: c2v { x: 0.0, y: 0.0 },\n    };\n    a_box.min = c2Minv(p0, p1);\n    a_box.max = c2Maxv(p0, p1);\n    if c2AABBtoAABB(a_box, B) == 0 {\n        return 0;\n    }\n    let ab = c2Sub(p1, p0);\n    let n = c2Skew(ab);\n    let abs_n = c2Absv(n);\n    let half_extents = c2Mulvs(c2Sub(B.max, B.min), 0.5f32);\n    let center_of_b_box = c2Mulvs(c2Add(B.min, B.max), 0.5f32);\n    let d = c_abs(c2Dot(n, c2Sub(p0, center_of_b_box))) - c2Dot(abs_n, half_extents);\n    if d > 0.0 {\n        return 0;\n    }\n    let da0 = c2SignedDistPointToPlane_OneDimensional(p0.x, -1.0f32, B.min.x);\n    let db0 = c2SignedDistPointToPlane_OneDimensional(p1.x, -1.0f32, B.min.x);\n    let da1 = c2SignedDistPointToPlane_OneDimensional(p0.x, 1.0f32, B.max.x);\n    let db1 = c2SignedDistPointToPlane_OneDimensional(p1.x, 1.0f32, B.max.x);\n    let da2 = c2SignedDistPointToPlane_OneDimensional(p0.y, -1.0f32, B.min.y);\n    let db2 = c2SignedDistPointToPlane_OneDimensional(p1.y, -1.0f32, B.min.y);\n    let da3 = c2SignedDistPointToPlane_OneDimensional(p0.y, 1.0f32, B.max.y);\n    let db3 = c2SignedDistPointToPlane_OneDimensional(p1.y, 1.0f32, B.max.y);\n    let mut t0 = c2RayToPlane_OneDimensional(da0, db0);\n    let mut t1 = c2RayToPlane_OneDimensional(da1, db1);\n    let mut t2 = c2RayToPlane_OneDimensional(da2, db2);\n    let mut t3 = c2RayToPlane_OneDimensional(da3, db3);\n    let hit0 = (t0 <= 1.0f32) as c_int;\n    let hit1 = (t1 <= 1.0f32) as c_int;\n    let hit2 = (t2 <= 1.0f32) as c_int;\n    let hit3 = (t3 <= 1.0f32) as c_int;\n    let hit = hit0 | hit1 | hit2 | hit3;\n    if hit != 0 {\n        t0 = (hit0 as f32) * t0;\n        t1 = (hit1 as f32) * t1;\n        t2 = (hit2 as f32) * t2;\n        t3 = (hit3 as f32) * t3;\n        if t0 >= t1 && t0 >= t2 && t0 >= t3 {\n            addr_of_mut!((*out).t).write_unaligned(t0 * A.t);\n            addr_of_mut!((*out).n).write_unaligned(c2V(-1.0, 0.0));\n        } else if t1 >= t0 && t1 >= t2 && t1 >= t3 {\n            addr_of_mut!((*out).t).write_unaligned(t1 * A.t);\n            addr_of_mut!((*out).n).write_unaligned(c2V(1.0, 0.0));\n        } else if t2 >= t0 && t2 >= t1 && t2 >= t3 {\n            addr_of_mut!((*out).t).write_unaligned(t2 * A.t);\n            addr_of_mut!((*out).n).write_unaligned(c2V(0.0, -1.0));\n        } else {\n            addr_of_mut!((*out).t).write_unaligned(t3 * A.t);\n            addr_of_mut!((*out).n).write_unaligned(c2V(0.0, 1.0));\n        }\n        1\n    } else {\n        0\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2RaytoCapsule(A: c2Ray, B: c2Capsule, out: *mut c2Raycast) -> c_int {\n    let mut M = c2m {\n        x: c2v { x: 0.0, y: 0.0 },\n        y: c2v { x: 0.0, y: 0.0 },\n    };\n    M.y = c2Norm(c2Sub(B.b, B.a));\n    M.x = c2CCW90(M.y);\n    let cap_n = c2Sub(B.b, B.a);\n    let yBb = c2MulmvT(M, cap_n);\n    let yAp = c2MulmvT(M, c2Sub(A.p, B.a));\n    let yAd = c2MulmvT(M, A.d);\n    let yAe = c2Add(yAp, c2Mulvs(yAd, A.t));\n    let mut capsule_bb = c2AABB {\n        min: c2v { x: 0.0, y: 0.0 },\n        max: c2v { x: 0.0, y: 0.0 },\n    };\n    capsule_bb.min = c2V(-B.r, 0.0);\n    capsule_bb.max = c2V(B.r, yBb.y);\n    addr_of_mut!((*out).n).write_unaligned(c2Norm(cap_n));\n    addr_of_mut!((*out).t).write_unaligned(0.0);\n    if c2AABBtoPoint(capsule_bb, yAp) != 0 {\n        return 1;\n    } else {\n        let mut capsule_a = c2Circle {\n            p: c2v { x: 0.0, y: 0.0 },\n            r: 0.0,\n        };\n        let mut capsule_b = c2Circle {\n            p: c2v { x: 0.0, y: 0.0 },\n            r: 0.0,\n        };\n        capsule_a.p = B.a;\n        capsule_a.r = B.r;\n        capsule_b.p = B.b;\n        capsule_b.r = B.r;\n        if c2CircleToPoint(capsule_a, A.p) != 0 {\n            return 1;\n        } else if c2CircleToPoint(capsule_b, A.p) != 0 {\n            return 1;\n        }\n    }\n    if yAe.x * yAp.x < 0.0 || c_min(c_abs(yAe.x), c_abs(yAp.x)) < B.r {\n        let mut Ca = c2Circle {\n            p: c2v { x: 0.0, y: 0.0 },\n            r: 0.0,\n        };\n        let mut Cb = c2Circle {\n            p: c2v { x: 0.0, y: 0.0 },\n            r: 0.0,\n        };\n        Ca.p = B.a;\n        Ca.r = B.r;\n        Cb.p = B.b;\n        Cb.r = B.r;\n        if c_abs(yAp.x) < B.r {\n            if yAp.y < 0.0 {\n                return c2RaytoCircle(A, Ca, out);\n            } else {\n                return c2RaytoCircle(A, Cb, out);\n            }\n        } else {\n            let c = if yAp.x > 0.0 { B.r } else { -B.r };\n            let d = yAe.x - yAp.x;\n            let t = (c - yAp.x) / d;\n            let y = yAp.y + (yAe.y - yAp.y) * t;\n            if y <= 0.0 {\n                return c2RaytoCircle(A, Ca, out);\n            }\n            if y >= yBb.y {\n                return c2RaytoCircle(A, Cb, out);\n            } else {\n                addr_of_mut!((*out).n).write_unaligned(if c > 0.0 { M.x } else { c2Skew(M.y) });\n                addr_of_mut!((*out).t).write_unaligned(t * A.t);\n                return 1;\n            }\n        }\n    }\n    0\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2RaytoPoly(\n    A: c2Ray,\n    B: *const c2Poly,\n    bx_ptr: *const c2x,\n    out: *mut c2Raycast,\n) -> c_int {\n    let bx = if !bx_ptr.is_null() {\n        bx_ptr.read_unaligned()\n    } else {\n        c2xIdentity()\n    };\n    let p = c2MulxvT(bx, A.p);\n    let d = c2MulrvT(bx.r, A.d);\n    let mut lo: f32 = 0.0;\n    let mut hi: f32 = A.t;\n    let mut index: c_int = !0;\n\n    // Raw-pointer element access mirrors C's unchecked indexing: a `count`\n    // greater than 8 reads past the fixed arrays, just like the original.\n    let verts_base = addr_of!((*B).verts) as *const c2v;\n    let norms_base = addr_of!((*B).norms) as *const c2v;\n    let count = addr_of!((*B).count).read_unaligned();\n\n    let mut i: c_int = 0;\n    while i < count {\n        let norm_i = norms_base.add(i as usize).read_unaligned();\n        let vert_i = verts_base.add(i as usize).read_unaligned();\n        let num = c2Dot(norm_i, c2Sub(vert_i, p));\n        let den = c2Dot(norm_i, d);\n        if den == 0.0 && num < 0.0 {\n            return 0;\n        } else {\n            if den < 0.0 && num < lo * den {\n                lo = num / den;\n                index = i;\n            } else if den > 0.0 && num < hi * den {\n                hi = num / den;\n            }\n        }\n        if hi < lo {\n            return 0;\n        }\n        i += 1;\n    }\n    if index != !0 {\n        addr_of_mut!((*out).t).write_unaligned(lo);\n        let norm_index = norms_base.add(index as usize).read_unaligned();\n        addr_of_mut!((*out).n).write_unaligned(c2Mulrv(bx.r, norm_index));\n        return 1;\n    }\n    0\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2CastRay(\n    A: c2Ray,\n    B: *const c_void,\n    bx: *const c2x,\n    typeB: c_int,\n    out: *mut c2Raycast,\n) -> c_int {\n    match typeB {\n        C2_TYPE_CIRCLE => return c2RaytoCircle(A, (B as *const c2Circle).read_unaligned(), out),\n        C2_TYPE_AABB => return c2RaytoAABB(A, (B as *const c2AABB).read_unaligned(), out),\n        C2_TYPE_CAPSULE => return c2RaytoCapsule(A, (B as *const c2Capsule).read_unaligned(), out),\n        C2_TYPE_POLY => return c2RaytoPoly(A, B as *const c2Poly, bx, out),\n        _ => {}\n    }\n    0\n}\n\n// ---------------------------------------------------------------------------\n// Public entry point (include/lib.h)\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn poly_ray(cast1: *mut c2Raycast, cast2: *mut c2Raycast) -> c_int {\n    let mut hit: c_int = 0;\n\n    // The C leaves verts[4..8]/norms[4..8] uninitialized; with count == 4 they\n    // are never read, so zeroing them here is behaviourally identical.\n    let zero = c2v { x: 0.0, y: 0.0 };\n    let mut p = c2Poly {\n        count: 0,\n        verts: [zero; 8],\n        norms: [zero; 8],\n    };\n    p.verts[0] = c2V(0.875f32, -11.5f32);\n    p.verts[1] = c2V(0.875f32, 11.5f32);\n    p.verts[2] = c2V(-0.875f32, 11.5f32);\n    p.verts[3] = c2V(-0.875f32, -11.5f32);\n    p.norms[0] = c2V(1.0, 0.0);\n    p.norms[1] = c2V(0.0, 1.0);\n    p.norms[2] = c2V(-1.0, 0.0);\n    p.norms[3] = c2V(0.0, -1.0);\n    p.count = 4;\n\n    let ray0 = c2Ray {\n        p: c2v {\n            x: -3.869416f32,\n            y: 13.0693407f32,\n        },\n        d: c2v { x: 1.0, y: 0.0 },\n        t: 4.0,\n    };\n    let ray1 = c2Ray {\n        p: c2v {\n            x: -3.869416f32,\n            y: 13.0693407f32,\n        },\n        d: c2v { x: 0.0, y: -1.0 },\n        t: 4.0,\n    };\n\n    hit += c2CastRay(\n        ray0,\n        addr_of!(p) as *const c_void,\n        core::ptr::null(),\n        C2_TYPE_POLY,\n        cast1,\n    );\n    hit += c2CastRay(\n        ray1,\n        addr_of!(p) as *const c_void,\n        core::ptr::null(),\n        C2_TYPE_POLY,\n        cast2,\n    ) << 1;\n\n    hit\n}\n","numLines":657,"startLine":1,"totalLines":657}}}
