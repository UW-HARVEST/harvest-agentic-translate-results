          x: -3.869416f32,\n            y: 13.0693407f32,\n        },\n        d: c2v { x: 1.0, y: 0.0 },\n        t: 4.0,\n    };\n    let ray1 = c2Ray {\n        p: c2v {\n            x: -3.869416f32,\n            y: 13.0693407f32,\n        },\n        d: c2v { x: 0.0, y: -1.0 },\n        t: 4.0,\n    };\n\n    hit += c2CastRay(\n        ray0,\n        addr_of!(p) as *const c_void,\n        core::ptr::null(),\n        C2_TYPE_POLY,\n        cast1,\n    );\n    hit += c2CastRay(\n        ray1,\n        addr_of!(p) as *const c_void,\n        core::ptr::null(),\n        C2_TYPE_POLY,\n        cast2,\n    ) << 1;\n\n    hit\n}\n","structuredPatch":[{"oldStart":380,"oldLines":7,"newStart":380,"newLines":13,"lines":[" "," #[unsafe(no_mangle)]"," pub extern \"C\" fn c2Mulrv(a: c2r, b: c2v) -> c2v {","-    c2V(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)","+    // `c2V(a.c*b.x - a.s*b.y, a.s*b.x + a.c*b.y)`","+    // lane 1: mulss dst = b.x -> R, mulss dst = b.y -> R, subss dst = m1 -> L","+    // lane 2: mulss dst = a.s -> L, mulss dst = b.y -> R, addss dst = m1 -> L","+    c2V(","+        subss(mulss(b.x, a.c), mulss(b.y, a.s)),","+        addss(mulss(a.s, b.x), mulss(b.y, a.c)),","+    )"," }"," "," #[unsafe(no_mangle)]"]}],"userModified":false,"replaceAll":false}}
