{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01JJWHrr1guz7SLqvEJx7rLb","type":"tool_result","content":"1\t// Translation of c_src/src/luggage.c (\"By Jan Wrobel <wrr@mixedbit.org>\").\n2\t//\n3\t// Behaviour is reproduced exactly, including the original's quirks:\n4\t//   * only `EOF` is checked from `scanf`, so matching failures silently leave\n5\t//     the previous iteration's buffer contents in place (in C those are the\n6\t//     same stack slots every iteration);\n7\t//   * `%d` is read into an `unsigned int`, so negative / oversized values wrap;\n8\t//   * `%80[^\\n]` normally captures the space that separates the arrival code\n9\t//     from the comments, which is why the printed line contains two spaces;\n10\t//   * `supersedes()` stops at the first later directive with the same luggage\n11\t//     id and only reports a supersession when that directive's departure\n12\t//     matches, instead of scanning the whole remaining list.\n13\t//\n14\t// The singly linked list of the original is kept as a linked list (nodes in an\n15\t// arena, linked by index) rather than a sorted `Vec`, so that insertions have\n16\t// the same cost profile as the C code: appending a node is O(1) and only the\n17\t// list walk costs anything, exactly as in `addRoutingDirectiveToList()`.\n18\t// The two recursive C functions are written as loops; they visit the very same\n19\t// nodes in the same order, they just cannot overflow the stack.\n20\t\n21\tmod scan;\n22\t\n23\tuse scan::{scan_airports, scan_comments, scan_ids, scan_time_stamp, Reader, EOF};\n24\tuse std::io::Write;\n25\tuse std::os::unix::ffi::OsStrExt;\n26\t\n27\tconst LUGGAGE_ID_LENGTH: usize = 8;\n28\tconst FLIGHT_ID_LENGTH: usize = 6;\n29\tconst AIRPORT_CODE_LENGTH: usize = 3;\n30\tconst COMMENTS_LENGTH: usize = 80;\n31\t\n32\t/// Restores the default `SIGPIPE` disposition, which every C program starts\n33\t/// with.  Rust's runtime sets `SIGPIPE` to `SIG_IGN`, which would make a closed\n34\t/// stdout end in exit status 0 instead of death by signal 13 as in C.\n35\tfn restore_default_sigpipe() {\n36\t    const SIGPIPE: i32 = 13;\n37\t    const SIG_DFL: usize = 0;\n38\t    extern \"C\" {\n39\t        fn signal(signum: i32, handler: usize) -> usize;\n40\t    }\n41\t    // SAFETY: `signal(SIGPIPE, SIG_DFL)` merely resets a signal disposition to\n42\t    // the value the kernel gives a freshly exec'd process; it touches no memory.\n43\t    unsafe {\n44\t        signal(SIGPIPE, SIG_DFL);\n45\t    }\n46\t}\n47\t\n48\t/// The C `RoutingDirective`.  The character arrays are modelled as the byte\n49\t/// string up to their NUL terminator, which is what `strcpy`, `strcmp` and\n50\t/// `%s` see.\n51\t#[derive(Default)]\n52\tstruct RoutingDirective {\n53\t    time_stamp: u32,\n54\t    luggage_id: Vec<u8>,\n55\t    flight_id: Vec<u8>,\n56\t    departure: Vec<u8>,\n57\t    arrival: Vec<u8>,\n58\t    comments: Vec<u8>,\n59\t}\n60\t\n61\t/// A `RoutingDirective` plus its `next_directive` link, held by index.\n62\tstruct Node {\n63\t    directive: RoutingDirective,\n64\t    next_directive: Option<usize>,\n65\t}\n66\t\n67\t/// The list, including the `directive_list_head` sentinel of `main()` as node 0\n68\t/// (`time_stamp = 0`, `next_directive = NULL`).\n69\tstruct DirectiveList {\n70\t    nodes: Vec<Node>,\n71\t}\n72\t\n73\tconst HEAD: usize = 0;\n74\t\n75\timpl DirectiveList {\n76\t    fn new() -> DirectiveList {\n77\t        DirectiveList {\n78\t            nodes: vec![Node {\n79\t                directive: RoutingDirective::default(),\n80\t                next_directive: None,\n81\t            }],\n82\t        }\n83\t    }\n84\t\n85\t    fn directive(&self, index: usize) -> &RoutingDirective {\n86\t        &self.nodes[index].directive\n87\t    }\n88\t\n89\t    fn first(&self) -> Option<usize> {\n90\t        self.nodes[HEAD].next_directive\n91\t    }\n92\t\n93\t    /// `addRoutingDirectiveToList()`: walks forward while the next directive's\n94\t    /// time stamp is less than or equal to the new one, then links the new\n95\t    /// directive in.  Equal time stamps therefore keep input order.\n96\t    fn add_routing_directive_to_list(&mut self, new_directive: RoutingDirective) {\n97\t        let mut previous = HEAD;\n98\t        while let Some(next) = self.nodes[previous].next_directive {\n99\t            if self.nodes[next].directive.time_stamp > new_directive.time_stamp {\n100\t                break;\n101\t            }\n102\t            previous = next;\n103\t        }\n104\t        let new_index = self.nodes.len();\n105\t        let next_directive = self.nodes[previous].next_directive;\n106\t        self.nodes.push(Node {\n107\t            directive: new_directive,\n108\t            next_directive,\n109\t        });\n110\t        self.nodes[previous].next_directive = Some(new_index);\n111\t    }\n112\t\n113\t    /// `supersedes()`: walks forward, skipping directives for other luggage;\n114\t    /// the first directive for the same luggage decides the answer, even when\n115\t    /// it says \"no\".\n116\t    fn supersedes(&self, start: Option<usize>, luggage_id: &[u8], departure: &[u8]) -> bool {\n117\t        let mut current = start;\n118\t        while let Some(index) = current {\n119\t            let directive = self.directive(index);\n120\t            if directive.luggage_id != luggage_id {\n121\t                current = self.nodes[index].next_directive;\n122\t                continue;\n123\t            }\n124\t            return directive.departure == departure;\n125\t        }\n126\t        false\n127\t    }\n128\t\n129\t    /// `superseded()`: is this directive overridden by a later one?\n130\t    fn superseded(&self, index: usize) -> bool {\n131\t        let directive = self.directive(index);\n132\t        self.supersedes(\n133\t            self.nodes[index].next_directive,\n134\t            &directive.luggage_id,\n135\t            &directive.departure,\n136\t        )\n137\t    }\n138\t}\n139\t\n140\t/// `matches()`: `-` as the first character is the wildcard.\n141\tfn matches(expected: &[u8], actual: &[u8]) -> bool {\n142\t    expected.first() == Some(&b'-') || expected == actual\n143\t}\n144\t\n145\t/// `printMatchingDirectives()`\n146\tfn print_matching_directives(\n147\t    list: &DirectiveList,\n148\t    expected_luggage_id: &[u8],\n149\t    expected_flight_id: &[u8],\n150\t    expected_departure: &[u8],\n151\t    expected_arrival: &[u8],\n152\t    out: &mut impl Write,\n153\t) {\n154\t    let mut current = list.first();\n155\t    while let Some(index) = current {\n156\t        let directive = list.directive(index);\n157\t        if !list.superseded(index)\n158\t            && matches(expected_luggage_id, &directive.luggage_id)\n159\t            && matches(expected_flight_id, &directive.flight_id)\n160\t            && matches(expected_departure, &directive.departure)\n161\t            && matches(expected_arrival, &directive.arrival)\n162\t        {\n163\t            // printf(\"%010u %s %s %s %s %s\\n\", ...)\n164\t            let mut line: Vec<u8> = Vec::new();\n165\t            line.extend_from_slice(format!(\"{:010}\", directive.time_stamp).as_bytes());\n166\t            for field in [\n167\t                &directive.luggage_id,\n168\t                &directive.flight_id,\n169\t                &directive.departure,\n170\t                &directive.arrival,\n171\t                &directive.comments,\n172\t            ] {\n173\t                line.push(b' ');\n174\t                line.extend_from_slice(field);\n175\t            }\n176\t            line.push(b'\\n');\n177\t            let _ = out.write_all(&line);\n178\t        }\n179\t        current = list.nodes[index].next_directive;\n180\t    }\n181\t}\n182\t\n183\tfn main() {\n184\t    restore_default_sigpipe();\n185\t\n186\t    let argv: Vec<std::ffi::OsString> = std::env::args_os().collect();\n187\t    if argv.len() != 5 {\n188\t        let mut stderr = std::io::stderr();\n189\t        let _ = stderr.write_all(b\"Command line error: 4 arguments expected\\n\");\n190\t        let _ = stderr.flush();\n191\t        std::process::exit(1);\n192\t    }\n193\t\n194\t    let mut list = DirectiveList::new();\n195\t    let mut reader = Reader::from_stdin();\n196\t\n197\t    // In C these live in main's stack frame, so a conversion that fails leaves\n198\t    // the value written by an earlier iteration behind.  Fresh stack memory is\n199\t    // modelled as zero-filled, i.e. 0 / empty strings.\n200\t    let mut time_stamp: u32 = 0;\n201\t    let mut luggage_id: Vec<u8> = Vec::new();\n202\t    let mut flight_id: Vec<u8> = Vec::new();\n203\t    let mut departure: Vec<u8> = Vec::new();\n204\t    let mut arrival: Vec<u8> = Vec::new();\n205\t    let mut comments: Vec<u8> = Vec::new();\n206\t\n207\t    loop {\n208\t        comments.clear(); // comments[0] = 0; // comments are optional.\n209\t\n210\t        if scan_time_stamp(&mut reader, &mut time_stamp) == EOF {\n211\t            break;\n212\t        }\n213\t        if scan_ids(\n214\t            &mut reader,\n215\t            &mut luggage_id,\n216\t            LUGGAGE_ID_LENGTH,\n217\t            &mut flight_id,\n218\t            FLIGHT_ID_LENGTH,\n219\t        ) == EOF\n220\t        {\n221\t            break;\n222\t        }\n223\t        if scan_airports(\n224\t            &mut reader,\n225\t            &mut departure,\n226\t            AIRPORT_CODE_LENGTH,\n227\t            &mut arrival,\n228\t            AIRPORT_CODE_LENGTH,\n229\t        ) == EOF\n230\t        {\n231\t            break;\n232\t        }\n233\t        if scan_comments(&mut reader, &mut comments, COMMENTS_LENGTH) == EOF {\n234\t            break;\n235\t        }\n236\t\n237\t        list.add_routing_directive_to_list(RoutingDirective {\n238\t            time_stamp,\n239\t            luggage_id: luggage_id.clone(),\n240\t            flight_id: flight_id.clone(),\n241\t            departure: departure.clone(),\n242\t            arrival: arrival.clone(),\n243\t            comments: comments.clone(),\n244\t        });\n245\t    }\n246\t\n247\t    let stdout = std::io::stdout();\n248\t    // glibc gives a pipe-backed stdout a 4096-byte buffer; matching it keeps the\n249\t    // flush boundaries (and therefore partial output on a broken pipe) the same.\n250\t    let mut out = std::io::BufWriter::with_capacity(4096, stdout.lock());\n251\t    print_matching_directives(\n252\t        &list,\n253\t        argv[1].as_bytes(),\n254\t        argv[2].as_bytes(),\n255\t        argv[3].as_bytes(),\n256\t        argv[4].as_bytes(),\n257\t        &mut out,\n258\t    );\n259\t    let _ = out.flush();\n260\t    std::process::exit(0);\n261\t}\n262\t"}]},"parent_tool_use_id":null,"session_id":"da36df0a-d233-448f-8a9e-391fd8a61084","uuid":"f402c9ef-c3b1-4779-b69f-009e340ef6c2","timestamp":"2026-08-27T19:14:45.932Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-qqu5GL/translation/src/main.rs","content":"// Translation of c_src/src/luggage.c (\"By Jan Wrobel <wrr@mixedbit.org>\").\n//\n// Behaviour is reproduced exactly, including the original's quirks:\n//   * only `EOF` is checked from `scanf`, so matching failures silently leave\n//     the previous iteration's buffer contents in place (in C those are the\n//     same stack slots every iteration);\n//   * `%d` is read into an `unsigned int`, so negative / oversized values wrap;\n//   * `%80[^\\n]` normally captures the space that separates the arrival code\n//     from the comments, which is why the printed line contains two spaces;\n//   * `supersedes()` stops at the first later directive with the same luggage\n//     id and only reports a supersession when that directive's departure\n//     matches, instead of scanning the whole remaining list.\n//\n// The singly linked list of the original is kept as a linked list (nodes in an\n// arena, linked by index) rather than a sorted `Vec`, so that insertions have\n// the same cost profile as the C code: appending a node is O(1) and only the\n// list walk costs anything, exactly as in `addRoutingDirectiveToList()`.\n// The two recursive C functions are written as loops; they visit the very same\n// nodes in the same order, they just cannot overflow the stack.\n\nmod scan;\n\nuse scan::{scan_airports, scan_comments, scan_ids, scan_time_stamp, Reader, EOF};\nuse std::io::Write;\nuse std::os::unix::ffi::OsStrExt;\n\nconst LUGGAGE_ID_LENGTH: usize = 8;\nconst FLIGHT_ID_LENGTH: usize = 6;\nconst AIRPORT_CODE_LENGTH: usize = 3;\nconst COMMENTS_LENGTH: usize = 80;\n\n/// Restores the default `SIGPIPE` disposition, which every C program starts\n/// with.  Rust's runtime sets `SIGPIPE` to `SIG_IGN`, which would make a closed\n/// stdout end in exit status 0 instead of death by signal 13 as in C.\nfn restore_default_sigpipe() {\n    const SIGPIPE: i32 = 13;\n    const SIG_DFL: usize = 0;\n    extern \"C\" {\n        fn signal(signum: i32, handler: usize) -> usize;\n    }\n    // SAFETY: `signal(SIGPIPE, SIG_DFL)` merely resets a signal disposition to\n    // the value the kernel gives a freshly exec'd process; it touches no memory.\n    unsafe {\n        signal(SIGPIPE, SIG_DFL);\n    }\n}\n\n/// The C `RoutingDirective`.  The character arrays are modelled as the byte\n/// string up to their NUL terminator, which is what `strcpy`, `strcmp` and\n/// `%s` see.\n#[derive(Default)]\nstruct RoutingDirective {\n    time_stamp: u32,\n    luggage_id: Vec<u8>,\n    flight_id: Vec<u8>,\n    departure: Vec<u8>,\n    arrival: Vec<u8>,\n    comments: Vec<u8>,\n}\n\n/// A `RoutingDirective` plus its `next_directive` link, held by index.\nstruct Node {\n    directive: RoutingDirective,\n    next_directive: Option<usize>,\n}\n\n/// The list, including the `directive_list_head` sentinel of `main()` as node 0\n/// (`time_stamp = 0`, `next_directive = NULL`).\nstruct DirectiveList {\n    nodes: Vec<Node>,\n}\n\nconst HEAD: usize = 0;\n\nimpl DirectiveList {\n    fn new() -> DirectiveList {\n        DirectiveList {\n            nodes: vec![Node {\n                directive: RoutingDirective::default(),\n                next_directive: None,\n            }],\n        }\n    }\n\n    fn directive(&self, index: usize) -> &RoutingDirective {\n        &self.nodes[index].directive\n    }\n\n    fn first(&self) -> Option<usize> {\n        self.nodes[HEAD].next_directive\n    }\n\n    /// `addRoutingDirectiveToList()`: walks forward while the next directive's\n    /// time stamp is less than or equal to the new one, then links the new\n    /// directive in.  Equal time stamps therefore keep input order.\n    fn add_routing_directive_to_list(&mut self, new_directive: RoutingDirective) {\n        let mut previous = HEAD;\n        while let Some(next) = self.nodes[previous].next_directive {\n            if self.nodes[next].directive.time_stamp > new_directive.time_stamp {\n                break;\n            }\n            previous = next;\n        }\n        let new_index = self.nodes.len();\n        let next_directive = self.nodes[previous].next_directive;\n        self.nodes.push(Node {\n            directive: new_directive,\n            next_directive,\n        });\n        self.nodes[previous].next_directive = Some(new_index);\n    }\n\n    /// `supersedes()`: walks forward, skipping directives for other luggage;\n    /// the first directive for the same luggage decides the answer, even when\n    /// it says \"no\".\n    fn supersedes(&self, start: Option<usize>, luggage_id: &[u8], departure: &[u8]) -> bool {\n        let mut current = start;\n        while let Some(index) = current {\n            let directive = self.directive(index);\n            if directive.luggage_id != luggage_id {\n                current = self.nodes[index].next_directive;\n                continue;\n            }\n            return directive.departure == departure;\n        }\n        false\n    }\n\n    /// `superseded()`: is this directive overridden by a later one?\n    fn superseded(&self, index: usize) -> bool {\n        let directive = self.directive(index);\n        self.supersedes(\n            self.nodes[index].next_directive,\n            &directive.luggage_id,\n            &directive.departure,\n        )\n    }\n}\n\n/// `matches()`: `-` as the first character is the wildcard.\nfn matches(expected: &[u8], actual: &[u8]) -> bool {\n    expected.first() == Some(&b'-') || expected == actual\n}\n\n/// `printMatchingDirectives()`\nfn print_matching_directives(\n    list: &DirectiveList,\n    expected_luggage_id: &[u8],\n    expected_flight_id: &[u8],\n    expected_departure: &[u8],\n    expected_arrival: &[u8],\n    out: &mut impl Write,\n) {\n    let mut current = list.first();\n    while let Some(index) = current {\n        let directive = list.directive(index);\n        if !list.superseded(index)\n            && matches(expected_luggage_id, &directive.luggage_id)\n            && matches(expected_flight_id, &directive.flight_id)\n            && matches(expected_departure, &directive.departure)\n            && matches(expected_arrival, &directive.arrival)\n        {\n            // printf(\"%010u %s %s %s %s %s\\n\", ...)\n            let mut line: Vec<u8> = Vec::new();\n            line.extend_from_slice(format!(\"{:010}\", directive.time_stamp).as_bytes());\n            for field in [\n                &directive.luggage_id,\n                &directive.flight_id,\n                &directive.departure,\n                &directive.arrival,\n                &directive.comments,\n            ] {\n                line.push(b' ');\n                line.extend_from_slice(field);\n            }\n            line.push(b'\\n');\n            let _ = out.write_all(&line);\n        }\n        current = list.nodes[index].next_directive;\n    }\n}\n\nfn main() {\n    restore_default_sigpipe();\n\n    let argv: Vec<std::ffi::OsString> = std::env::args_os().collect();\n    if argv.len() != 5 {\n        let mut stderr = std::io::stderr();\n        let _ = stderr.write_all(b\"Command line error: 4 arguments expected\\n\");\n        let _ = stderr.flush();\n        std::process::exit(1);\n    }\n\n    let mut list = DirectiveList::new();\n    let mut reader = Reader::from_stdin();\n\n    // In C these live in main's stack frame, so a conversion that fails leaves\n    // the value written by an earlier iteration behind.  Fresh stack memory is\n    // modelled as zero-filled, i.e. 0 / empty strings.\n    let mut time_stamp: u32 = 0;\n    let mut luggage_id: Vec<u8> = Vec::new();\n    let mut flight_id: Vec<u8> = Vec::new();\n    let mut departure: Vec<u8> = Vec::new();\n    let mut arrival: Vec<u8> = Vec::new();\n    let mut comments: Vec<u8> = Vec::new();\n\n    loop {\n        comments.clear(); // comments[0] = 0; // comments are optional.\n\n        if scan_time_stamp(&mut reader, &mut time_stamp) == EOF {\n            break;\n        }\n        if scan_ids(\n            &mut reader,\n            &mut luggage_id,\n            LUGGAGE_ID_LENGTH,\n            &mut flight_id,\n            FLIGHT_ID_LENGTH,\n        ) == EOF\n        {\n            break;\n        }\n        if scan_airports(\n            &mut reader,\n            &mut departure,\n            AIRPORT_CODE_LENGTH,\n            &mut arrival,\n            AIRPORT_CODE_LENGTH,\n        ) == EOF\n        {\n            break;\n        }\n        if scan_comments(&mut reader, &mut comments, COMMENTS_LENGTH) == EOF {\n            break;\n        }\n\n        list.add_routing_directive_to_list(RoutingDirective {\n            time_stamp,\n            luggage_id: luggage_id.clone(),\n            flight_id: flight_id.clone(),\n            departure: departure.clone(),\n            arrival: arrival.clone(),\n            comments: comments.clone(),\n        });\n    }\n\n    let stdout = std::io::stdout();\n    // glibc gives a pipe-backed stdout a 4096-byte buffer; matching it keeps the\n    // flush boundaries (and therefore partial output on a broken pipe) the same.\n    let mut out = std::io::BufWriter::with_capacity(4096, stdout.lock());\n    print_matching_directives(\n        &list,\n        argv[1].as_bytes(),\n        argv[2].as_bytes(),\n        argv[3].as_bytes(),\n        argv[4].as_bytes(),\n        &mut out,\n    );\n    let _ = out.flush();\n    std::process::exit(0);\n}\n","numLines":262,"startLine":1,"totalLines":262}}}
