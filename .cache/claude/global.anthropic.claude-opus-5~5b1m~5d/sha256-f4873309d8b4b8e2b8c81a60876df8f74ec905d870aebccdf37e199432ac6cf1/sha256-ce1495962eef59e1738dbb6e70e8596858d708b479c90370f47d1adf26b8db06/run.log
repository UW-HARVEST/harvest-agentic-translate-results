NL: &[u8; 4] = b\"%s\\n\\0\";\n40\t/// `\"%d\\n\"` format string, NUL terminated.\n41\tconst FMT_INT_NL: &[u8; 4] = b\"%d\\n\\0\";\n42\t\n43\t/// Reproduces the C `(int)` cast from a `double`, exactly as the original\n44\t/// library behaves when built for x86-64 (`cvttsd2si`): values that are NaN or\n45\t/// whose truncation does not fit into an `int` yield the \"integer indefinite\"\n46\t/// value `INT_MIN`. Rust's `as` operator saturates instead, so it cannot be\n47\t/// used directly here.\n48\t#[inline]\n49\tfn c_double_to_int(value: c_double) -> c_int {\n50\t    if value.is_nan() {\n51\t        return c_int::MIN;\n52\t    }\n53\t    let truncated = value.trunc();\n54\t    if truncated >= 2147483648.0 || truncated < -2147483648.0 {\n55\t        return c_int::MIN;\n56\t    }\n57\t    truncated as c_int\n58\t}\n59\t\n60\t/// void printLine (const char * line)\n61\t#[unsafe(no_mangle)]\n62\tpub extern \"C\" fn printLine(line: *const c_char) {\n63\t    if !line.is_null() {\n64\t        unsafe {\n65\t            printf(FMT_STR_NL.as_ptr() as *const c_char, line);\n66\t        }\n67\t    }\n68\t}\n69\t\n70\t/// Convenience helper for printing a Rust string literal (which must already be\n71\t/// NUL terminated) through `printLine`.\n72\t#[inline]\n73\tfn print_line_bytes(line: &[u8]) {\n74\t    debug_assert_eq!(line.last(), Some(&0u8));\n75\t    printLine(line.as_ptr() as *const c_char);\n76\t}\n77\t\n78\t/// void printIntLine (int intNumber)\n79\t#[unsafe(no_mangle)]\n80\tpub extern \"C\" fn printIntLine(intNumber: c_int) {\n81\t    unsafe {\n82\t        printf(FMT_INT_NL.as_ptr() as *const c_char, intNumber);\n83\t    }\n84\t}\n85\t\n86\t/// void bad(float data)\n87\t#[unsafe(no_mangle)]\n88\tpub extern \"C\" fn bad(data: c_float) {\n89\t    let result: c_int = c_double_to_int(100.0f64 / (data as c_double));\n90\t    printIntLine(result);\n91\t}\n92\t\n93\t/// static void goodG2B()\n94\tfn goodG2B() {\n95\t    let data: c_float;\n96\t    data = 2.0f32;\n97\t    {\n98\t        let result: c_int = c_double_to_int(100.0f64 / (data as c_double));\n99\t        printIntLine(result);\n100\t    }\n101\t}\n102\t\n103\t/// static void goodB2G(float data)\n104\tfn goodB2G(data: c_float) {\n105\t    if (data as c_double).abs() > 0.000001f64 {\n106\t        let result: c_int = c_double_to_int(100.0f64 / (data as c_double));\n107\t        printIntLine(result);\n108\t    } else {\n109\t        print_line_bytes(b\"This would result in a divide by zero\\0\");\n110\t    }\n111\t}\n112\t\n113\t/// void good(float data)\n114\t#[unsafe(no_mangle)]\n115\tpub extern \"C\" fn good(data: c_float) {\n116\t    goodG2B();\n117\t    goodB2G(data);\n118\t}\n119\t\n120\t/// void driver(float goodData, float badData)\n121\t#[unsafe(no_mangle)]\n122\tpub extern \"C\" fn driver(goodData: c_float, badData: c_float) {\n123\t    print_line_bytes(b\"Calling good()...\\0\");\n124\t    good(goodData);\n125\t    print_line_bytes(b\"Finished good()\\0\");\n126\t    print_line_bytes(b\"Calling bad()...\\0\");\n127\t    bad(badData);\n128\t    print_line_bytes(b\"Finished bad()\\0\");\n129\t}\n130\t"}]},"parent_tool_use_id":null,"session_id":"522b4372-3a10-4e6d-8007-c0dcaeb3f4c5","uuid":"7df79847-c25f-4313-8da5-5f17dbb8ac43","timestamp":"2026-08-28T12:53:59.154Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-veu9HH/translation/src/lib.rs","content":"// Rust translation of c_src/src/driver.c\n//\n// Copyright 2025 MIT Lincoln Laboratory\n// Permission is hereby granted, free of charge,\n// to any person obtaining a copy of this software\n// and associated documentation files (the \"Software\"),\n// to deal in the Software without restriction,\n// including without limitation the rights to use, copy,\n// modify, merge, publish, distribute, sublicense,\n// and/or sell copies of the Software,\n// and to permit persons to whom the Software is furnished to do so,\n// subject to the following conditions:\n//\n// The above