/dev/null 2>&1 ); then\n    ok \"cargo check ${combo:-<default>}\"\n  else\n    bad \"cargo check ${combo:-<default>}\"\n  fi\ndone\n\n# ---------------------------------------------------------------------------\nstep \"Build the Rust shared library (both profiles, every feature combination)\"\nfor combo in \"${COMBOS[@]}\"; do\n  for prof in debug release; do\n    relflag=\"\"; [ \"$prof\" = release ] && relflag=\"--release\"\n    # shellcheck disable=SC2086\n    if ( cd \"$CRATE\" && timeout 600 cargo build $CARGO_FLAGS $relflag $combo >/dev/null 2>&1 ); then\n      ok \"cargo build $prof ${combo:-<default>}\"\n    else\n      bad \"cargo build $prof ${combo:-<default>}\"\n    fi\n  done\ndone\n\n# ---------------------------------------------------------------------------\nstep \"Symbol parity: nm -D on the C .so vs the Rust .so\"\nsyms() { nm -D --defined-only \"$1\" | awk '{print $3}' | sort -u; }\nfor prof in release debug; do\n  RSO=\"$CRATE/target/$prof/libdriver.so\"\n  [ -f \"$RSO\" ] || { bad \"missing $RSO\"; continue; }\n  missing=$(comm -23 <(syms \"$CSO\") <(syms \"$RSO\"))\n  extra=$(comm -13 <(syms \"$CSO\") <(syms \"$RSO\"))\n  if [ -z \"$missing\" ]; then\n    ok \"$prof: 0 symbols missing from the Rust .so ($(syms \"$CSO\" | wc -l) exported by C)\"\n  else\n    bad \"$prof: symbols MISSING from the Rust .so:\"; echo \"$missing\" | sed 's/^/       /'\n  fi\n  [ -n \"$extra\" ] && printf '  \\033[33mNOTE\\033[0m %s: extra Rust-only symbols:\\n%s\\n' \"$prof\" \"$(echo \"$extra\" | sed 's/^/       /')\"\ndone\n\nstep \"Undefined (imported) non-libc symbols in the Rust .so\"\nfor prof in release debug; do\n  RSO=\"$CRATE/target/$prof/libdriver.so\"\n  [ -f \"$RSO\" ] || continue\n  und=$(nm -D --undefined-only \"$RSO\" | awk '{print $NF}' \\\n        | grep -vE '^(_|__|printf$|fabs$|memcpy$|abort$|puts$|putchar$|fwrite$|__stack_chk_fail$)' || true)\n  if [ -z \"$und\" ]; then ok \"$prof: 0 unresolved non-libc imports\"\n  else bad \"$prof: unresolved non-libc imports:\"; echo \"$und\" | sed 's/^/       /'; fi\ndone\n\n# ---------------------------------------------------------------------------\nstep \"Differential test suite (every feature combination x both profiles)\"\nfor combo in \"${COMBOS[@]}\"; do\n  for prof in debug release; do\n    RSO=\"$CRATE/target/$prof/libdriver.so\"\n    [ -f \"$RSO\" ] || continue\n    # shellcheck disable=SC2086\n    out=$( cd \"$CRATE\" && DRIVER_RUST_SO=\"$RSO\" timeout 600 cargo test $CARGO_FLAGS $combo 2>&1 )\n    if printf '%s' \"$out\" | grep -q 'FAILED\\|error\\[\\|error:'; then\n      bad \"tests ${combo:-<default>} / $prof\"\n      printf '%s\\n' \"$out\" | grep -E '^(test |error|---- |thread )' | head -40 | sed 's/^/       /'\n    else\n      n=$(printf '%s' \"$out\" | grep -oP '\\d+(?= passed)' | paste -sd+ | bc)\n      ok \"tests ${combo:-<default>} / $prof  ($n assertions-groups passed)\"\n    fi\n  done\ndone\n\n# ---------------------------------------------------------------------------\nstep \"Result\"\nif [ \"$fail\" -eq 0 ]; then\n  printf '\\033[32mALL PHASE D CHECKS PASSED\\033[0m\\n'\nelse\n  printf '\\033[31mSOME CHECKS FAILED\\033[0m\\n'\nfi\nexit \"$fail\"\n","structuredPatch":[{"oldStart":79,"oldLines":15,"newStart":79,"newLines":23,"lines":["   [ -n \"$extra\" ] && printf '  \\033[33mNOTE\\033[0m %s: extra Rust-only symbols:\\n%s\\n' \"$prof\" \"$(echo \"$extra\" | sed 's/^/       /')\""," done"," ","-step \"Undefined (imported) non-libc symbols in the Rust .so\"","+step \"Unresolved imports in the Rust .so (ldd -r: actual link closure)\"","+# Rust's std legitimately imports many more libc symbols than the C .so does;","+# what matters is that NONE of them are unresolvable, i.e. there is no missing","+# module that a stub would have papered over."," for prof in release debug; do","   RSO=\"$CRATE/target/$prof/libdriver.so\"","   [ -f \"$RSO\" ] || continue","-  und=$(nm -D --undefined-only \"$RSO\" | awk '{print $NF}' \\","-        | grep -vE '^(_|