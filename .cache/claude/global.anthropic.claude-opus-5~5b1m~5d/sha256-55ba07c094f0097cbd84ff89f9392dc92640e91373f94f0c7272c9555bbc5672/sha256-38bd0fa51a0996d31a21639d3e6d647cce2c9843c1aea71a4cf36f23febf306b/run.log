_buffer->depth--;\n1614\t\n1615\t    return true;\n1616\t}\n1617\t\n1618\t/* Build an object from the text. */\n1619\tstatic cJSON_bool parse_object(cJSON * const item, parse_buffer * const input_buffer)\n1620\t{\n1621\t    cJSON *head = NULL; /* linked list head */\n1622\t    cJSON *current_item = NULL;\n1623\t\n1624\t    if (input_buffer->depth >= CJSON_NESTING_LIMIT)\n1625\t    {\n1626\t        return false; /* to deeply nested */\n1627\t    }\n1628\t    input_buffer->depth++;\n1629\t\n1630\t    if (cannot_access_at_index(input_buffer, 0) || (buffer_at_offset(input_buffer)[0] != '{'))\n1631\t    {\n1632\t        goto fail; /* not an object */\n1633\t    }\n1634\t\n1635\t    input_buffer->offset++;\n1636\t    buffer_skip_whitespace(input_buffer);\n1637\t    if (can_access_at_index(input_buffer, 0) && (buffer_at_offset(input_buffer)[0] == '}'))\n1638\t    {\n1639\t        goto success; /* empty object */\n1640\t    }\n1641\t\n1642\t    /* check if we skipped to the end of the buffer */\n1643\t    if (cannot_access_at_index(input_buffer, 0))\n1644\t    {\n1645\t        input_buffer->offset--;\n1646\t        goto fail;\n1647\t    }\n1648\t\n1649\t    /* step back to character in front of the first element */\n1650\t    input_buffer->offset--;\n1651\t    /* loop through the comma separated array elements */\n1652\t    do\n1653\t    {\n1654\t        /* allocate next item */\n1655\t        cJSON *new_item = cJSON_New_Item(&(input_buffer->hooks));\n1656\t        if (new_item == NULL)\n1657\t        {\n1658\t            goto fail; /* allocation failure */\n1659\t        }\n1660\t\n1661\t        /* attach next item to list */\n1662\t        if (head == NULL)\n1663\t        {\n1664\t            /* start the linked list */\n1665\t            current_item = head = new_item;\n1666\t        }\n1667\t        else\n1668\t        {\n1669\t            /* add to the end and advance */\n1670\t            current_item->next = new_item;\n1671\t            new_item->prev = current_item;\n1672\t            current_item = new_item;\n1673\t        }\n1674\t\n1675\t        if (cannot_access_at_index(input_buffer, 1))\n1676\t        {\n1677\t            goto fail; /* nothing comes after the comma */\n1678\t        }\n1679\t\n1680\t        /* parse the name of the child */\n1681\t        input_buffer->offset++;\n1682\t        buffer_skip_whitespace(input_buffer);\n1683\t        if (!parse_string(current_item, input_buffer))\n1684\t        {\n1685\t            goto fail; /* failed to parse name */\n1686\t        }\n1687\t        buffer_skip_whitespace(input_buffer);\n1688\t\n1689\t        /* swap valuestring and string, because we parsed the name */\n1690\t        current_item->string = current_item->valuestring;\n1691\t        current_item->valuestring = NULL;\n1692\t\n1693\t        if (cannot_access_at_index(input_buffer, 0) || (buffer_at_offset(input_buffer)[0] != ':'))\n1694\t        {\n1695\t            goto fail; /* invalid object */\n1696\t        }\n1697\t\n1698\t        /* parse the value */\n1699\t        input_buffer->offset++;\n1700\t        buffer_skip_whitespace(input_buffer);\n1701\t        if (!parse_value(current_item, input_buffer))\n1702\t        {\n1703\t            goto fail; /* failed to parse value */\n1704\t        }\n1705\t        buffer_skip_whitespace(input_buffer);\n1706\t    }\n1707\t    while (can_access_at_index(input_buffer, 0) && (buffer_at_offset(input_buffer)[0] == ','));\n1708\t\n1709\t    if (cannot_access_at_index(input_buffer, 0) || (buffer_at_offset(input_buffer)[0] != '}'))\n1710\t    {\n1711\t        goto fail; /* expected end of object */\n1712\t    }\n1713\t\n1714\tsuccess:\n1715\t    input_buffer->depth--;\n1716\t\n1717\t    if (head != NULL) {\n1718\t        head->prev = current_item;\n1719\t    }\n1720\t\n1721\t    item->type = cJSON_Object;\n1722\t    item->child = head;\n1723\t\n1724\t    input_buffer->offset++;\n1725\t    return true;\n1726\t\n1727\tfail:\n1728\t    if (head != NULL)\n1729\t    {\n1730\t        cJSON_Delete(head);\n1731\t    }\n1732\t\n1733\t    return false;\n1734\t}\n1735\t\n1736\t/* Render an object to text. */\n1737\tstatic cJSON_bool print_object(const cJSON * const item, printbuffer * const output_buffer)\n1738\t{\n1739\t    unsigned char *output_pointer = NULL;\n1740\t    size_t length = 0;\n1741\t    cJSON *current_item = item->child;\n1742\t\n1743\t    if (output_buffer == NULL)\n1744\t    {\n1745\t        return false;\n1746\t    }\n1747\t\n1748\t    /* Compose the output: */\n1749\t    length = (size_t) (output_buffer->format ? 2 : 1); /* fmt: {\\n */\n1750\t    output_pointer = ensure(output_buffer, length + 1);\n1751\t    if (output_pointer == NULL)\n1752\t    {\n1753\t        return false;\n1754\t    }\n1755\t\n1756\t    *output_pointer++ = '{';\n1757\t    output_buffer->depth++;\n1758\t    if (output_buffer->format)\n1759\t    {\n1760\t        *output_pointer++ = '\\n';\n1761\t    }\n1762\t    output_buffer->offset += length;\n1763\t\n1764\t    while (current_item)\n1765\t    {\n1766\t        if (output_buffer->format)\n1767\t        {\n1768\t            size_t i;\n1769\t            output_pointer = ensure(output_buffer, output_buffer->depth);\n1770\t            if (output_pointer == NULL)\n1771\t            {\n1772\t                return false;\n1773\t            }\n1774\t            for (i = 0; i < output_buffer->depth; i++)\n1775\t            {\n1776\t                *output_pointer++ = '\\t';\n1777\t            }\n1778\t            output_buffer->offset += output_buffer->depth;\n1779\t        }\n1780\t\n1781\t        /* print key */\n1782\t        if (!print_string_ptr((unsigned char*)current_item->string, output_buffer))\n1783\t        {\n1784\t            return false;\n1785\t        }\n1786\t        update_offset(output_buffer);\n1787\t\n1788\t        length = (size_t) (output_buffer->format ? 2 : 1);\n1789\t        output_pointer = ensure(output_buffer, length);\n1790\t        if (output_pointer == NULL)\n1791\t        {\n1792\t            return false;\n1793\t        }\n1794\t        *output_pointer++ = ':';\n1795\t        if (output_buffer->format)\n1796\t        {\n1797\t            *output_pointer++ = '\\t';\n1798\t        }\n1799\t        output_buffer->offset += length;\n1800\t\n1801\t        /* print value */\n1802\t        if (!print_value(current_item, output_buffer))\n1803\t        {\n1804\t            return false;\n1805\t        }\n1806\t        update_offset(output_buffer);\n1807\t\n1808\t        /* print comma if not last */\n1809\t        length = ((size_t)(output_buffer->format ? 1 : 0) + (size_t)(current_item->next ? 1 : 0));\n1810\t        output_pointer = ensure(output_buffer, length + 1);\n1811\t        if (output_pointer == NULL)\n1812\t        {\n1813\t            return false;\n1814\t        }\n1815\t        if (current_item->next)\n1816\t        {\n1817\t            *output_pointer++ = ',';\n1818\t        }\n1819\t\n1820\t        if (output_buffer->format)\n1821\t        {\n1822\t            *output_pointer++ = '\\n';\n1823\t        }\n1824\t        *output_pointer = '\\0';\n1825\t        output_buffer->offset += length;\n1826\t\n1827\t        current_item = current_item->next;\n1828\t    }\n1829\t\n1830\t    output_pointer = ensure(output_buffer, output_buffer->format ? (output_buffer->depth + 1) : 2);\n1831\t    if (output_pointer == NULL)\n1832\t    {\n1833\t        return false;\n1834\t    }\n1835\t    if (output_buffer->format)\n1836\t    {\n1837\t        size_t i;\n1838\t        for (i = 0; i < (output_buffer->depth - 1); i++)\n1839\t        {\n1840\t            *output_pointer++ = '\\t';\n1841\t        }\n1842\t    }\n1843\t    *output_pointer++ = '}';\n1844\t    *output_pointer = '\\0';\n1845\t    output_buffer->depth--;\n1846\t\n1847\t    return true;\n1848\t}\n1849\t\n1850\t/* Get Array size/item / object item. */\n1851\tCJSON_PUBLIC(int) cJSON_GetArraySize(const cJSON *array)\n1852\t{\n1853\t    cJSON *child = NULL;\n1854\t    size_t size = 0;\n1855\t\n1856\t    if (array == NULL)\n1857\t    {\n1858\t        return 0;\n1859\t    }\n1860\t\n1861\t    child = array->child;\n1862\t\n1863\t    while(child != NULL)\n1864\t    {\n1865\t        size++;\n1866\t        child = child->next;\n1867\t    }\n1868\t\n1869\t    /* FIXME: Can overflow here. Cannot be fixed without breaking the API */\n1870\t\n1871\t    return (int)size;\n1872\t}\n1873\t\n1874\tstatic cJSON* get_array_item(const cJSON *array, size_t index)\n1875\t{\n1876\t    cJSON *current_child = NULL;\n1877\t\n1878\t    if (array == NULL)\n1879\t    {\n1880\t        return NULL;\n1881\t    }\n1882\t\n1883\t    current_child = array->child;\n1884\t    while ((current_child != NULL) && (index > 0))\n1885\t    {\n1886\t        index--;\n1887\t        current_child = current_child->next;\n1888\t    }\n1889\t\n1890\t    return current_child;\n1891\t}\n1892\t\n1893\tCJSON_PUBLIC(cJSON *) cJSON_GetArrayItem(const cJSON *array, int index)\n1894\t{\n1895\t    if (index < 0)\n1896\t    {\n1897\t        return NULL;\n1898\t    }\n1899\t\n1900\t    return get_array_item(array, (size_t)index);\n1901\t}\n1902\t\n1903\tstatic cJSON *get_object_item(const cJSON * const object, const char * const name, const cJSON_bool case_sensitive)\n1904\t{\n1905\t    cJSON *current_element = NULL;\n1906\t\n1907\t    if ((object == NULL) || (name == NULL))\n1908\t    {\n1909\t        return NULL;\n1910\t    }\n1911\t\n1912\t    current_element = object->child;\n1913\t    if (case_sensitive)\n1914\t    {\n1915\t        while ((current_element != NULL) && (current_element->string != NULL) && (strcmp(name, current_element->string) != 0))\n1916\t        {\n1917\t            current_element = current_element->next;\n1918\t        }\n1919\t    }\n1920\t    else\n1921\t    {\n1922\t        while ((current_element != NULL) && (case_insensitive_strcmp((const unsigned char*)name, (const unsigned char*)(current_element->string)) != 0))\n1923\t        {\n1924\t            current_element = current_element->next;\n1925\t        }\n1926\t    }\n1927\t\n1928\t    if ((current_element == NULL) || (current_element->string == NULL)) {\n1929\t        return NULL;\n1930\t    }\n1931\t\n1932\t    return current_element;\n1933\t}\n1934\t\n1935\tCJSON_PUBLIC(cJSON *) cJSON_GetObjectItem(const cJSON * const object, const char * const string)\n1936\t{\n1937\t    return get_object_item(object, string, false);\n1938\t}\n1939\t\n1940\tCJSON_PUBLIC(cJSON *) cJSON_GetObjectItemCaseSensitive(const cJSON * const object, const char * const string)\n1941\t{\n1942\t    return get_object_item(object, string, true);\n1943\t}\n1944\t\n1945\tCJSON_PUBLIC(cJSON_bool) cJSON_HasObjectItem(const cJSON *object, const char *string)\n1946\t{\n1947\t    return cJSON_GetObjectItem(object, string) ? 1 : 0;\n1948\t}\n1949\t\n1950\t/* Utility for array list handling. */\n1951\tstatic void suffix_object(cJSON *prev, cJSON *item)\n1952\t{\n1953\t    prev->next = item;\n1954\t    item->prev = prev;\n1955\t}\n1956\t\n1957\t/* Utility for handling references. */\n1958\tstatic cJSON *create_reference(const cJSON *item, const internal_hooks * const hooks)\n1959\t{\n1960\t    cJSON *reference = NULL;\n1961\t    if (item == NULL)\n1962\t    {\n1963\t        return NULL;\n1964\t    }\n1965\t\n1966\t    reference = cJSON_New_Item(hooks);\n1967\t    if (reference == NULL)\n1968\t    {\n1969\t        return NULL;\n1970\t    }\n1971\t\n1972\t    memcpy(reference, item, sizeof(cJSON));\n1973\t    reference->string = NULL;\n1974\t    reference->type |= cJSON_IsReference;\n1975\t    reference->next = reference->prev = NULL;\n1976\t    return reference;\n1977\t}\n1978\t\n1979\tstatic cJSON_bool add_item_to_array(cJSON *array, cJSON *item)\n1980\t{\n1981\t    cJSON *child = NULL;\n1982\t\n1983\t    if ((item == NULL) || (array == NULL) || (array == item))\n1984\t    {\n1985\t        return false;\n1986\t    }\n1987\t\n1988\t    child = array->child;\n1989\t    /*\n1990\t     * To find the last item in array quickly, we use prev in array\n1991\t     */\n1992\t    if (child == NULL)\n1993\t    {\n1994\t        /* list is empty, start new one */\n1995\t        array->child = item;\n1996\t        item->prev = item;\n1997\t        item->next = NULL;\n1998\t    }\n1999\t    else\n2000\t    {\n2001\t        /* append to the end */\n2002\t        if (child->prev)\n2003\t        {\n2004\t            suffix_object(child->prev, item);\n2005\t            array->child->prev = item;\n2006\t        }\n2007\t    }\n2008\t\n2009\t    return true;\n2010\t}\n2011\t\n2012\t/* Add item to array/object. */\n2013\tCJSON_PUBLIC(cJSON_bool) cJSON_AddItemToArray(cJSON *array, cJSON *item)\n2014\t{\n2015\t    return add_item_to_array(array, item);\n2016\t}\n2017\t\n2018\t#if defined(__clang__) || (defined(__GNUC__)  && ((__GNUC__ > 4) || ((__GNUC__ == 4) && (__GNUC_MINOR__ > 5))))\n2019\t    #pragma GCC diagnostic push\n2020\t#endif\n2021\t#ifdef __GNUC__\n2022\t#pragma GCC diagnostic ignored \"-Wcast-qual\"\n2023\t#endif\n2024\t/* helper function to cast away const */\n2025\tstatic void* cast_away_const(const void* string)\n2026\t{\n2027\t    return (void*)string;\n2028\t}\n2029\t#if defined(__clang__) || (defined(__GNUC__)  && ((__GNUC__ > 4) || ((__GNUC__ == 4) && (__GNUC_MINOR__ > 5))))\n2030\t    #pragma GCC diagnostic pop\n2031\t#endif\n2032\t\n2033\t\n2034\tstatic cJSON_bool add_item_to_object(cJSON * const object, const char * const string, cJSON * const item, const internal_hooks * const hooks, const cJSON_bool constant_key)\n2035\t{\n2036\t    char *new_key = NULL;\n2037\t    int new_type = cJSON_Invalid;\n2038\t\n2039\t    if ((object == NULL) || (string == NULL) || (item == NULL) || (object == item))\n2040\t    {\n2041\t        return false;\n2042\t    }\n2043\t\n2044\t    if (constant_key)\n2045\t    {\n2046\t        new_key = (char*)cast_away_const(string);\n2047\t        new_type = item->type | cJSON_StringIsConst;\n2048\t    }\n2049\t    else\n2050\t    {\n2051\t        new_key = (char*)cJSON_strdup((const unsigned char*)string, hooks);\n2052\t        if (new_key == NULL)\n2053\t        {\n2054\t            return false;\n2055\t        }\n2056\t\n2057\t        new_type = item->type & ~cJSON_StringIsConst;\n2058\t    }\n2059\t\n2060\t    if (!(item->type & cJSON_StringIsConst) && (item->string != NULL))\n2061\t    {\n2062\t        hooks->deallocate(item->string);\n2063\t    }\n2064\t\n2065\t    item->string = new_key;\n2066\t    item->type = new_type;\n2067\t\n2068\t    return add_item_to_array(object, item);\n2069\t}\n2070\t\n2071\tCJSON_PUBLIC(cJSON_bool) cJSON_AddItemToObject(cJSON *object, const char *string, cJSON *item)\n2072\t{\n2073\t    return add_item_to_object(object, string, item, &global_hooks, false);\n2074\t}\n2075\t\n2076\t/* Add an item to an object with constant string as key */\n2077\tCJSON_PUBLIC(cJSON_bool) cJSON_AddItemToObjectCS(cJSON *object, const char *string, cJSON *item)\n2078\t{\n2079\t    return add_item_to_object(object, string, item, &global_hooks, true);\n2080\t}\n2081\t\n2082\tCJSON_PUBLIC(cJSON_bool) cJSON_AddItemReferenceToArray(cJSON *array, cJSON *item)\n2083\t{\n2084\t    if (array == NULL)\n2085\t    {\n2086\t        return false;\n2087\t    }\n2088\t\n2089\t    return add_item_to_array(array, create_reference(item, &global_hooks));\n2090\t}\n2091\t\n2092\tCJSON_PUBLIC(cJSON_bool) cJSON_AddItemReferenceToObject(cJSON *object, const char *string, cJSON *item)\n2093\t{\n2094\t    if ((object == NULL) || (string == NULL))\n2095\t    {\n2096\t        return false;\n2097\t    }\n2098\t\n2099\t    return add_item_to_object(object, string, create_reference(item, &global_hooks), &global_hooks, false);\n2100\t}\n2101\t\n2102\tCJSON_PUBLIC(cJSON*) cJSON_AddNullToObject(cJSON * const object, const char * const name)\n2103\t{\n2104\t    cJSON *null = cJSON_CreateNull();\n2105\t    if (add_item_to_object(object, name, null, &global_hooks, false))\n2106\t    {\n2107\t        return null;\n2108\t    }\n2109\t\n2110\t    cJSON_Delete(null);\n2111\t    return NULL;\n2112\t}\n2113\t\n2114\tCJSON_PUBLIC(cJSON*) cJSON_AddTrueToObject(cJSON * const object, const char * const name)\n2115\t{\n2116\t    cJSON *true_item = cJSON_CreateTrue();\n2117\t    if (add_item_to_object(object, name, true_item, &global_hooks, false))\n2118\t    {\n2119\t        return true_item;\n2120\t    }\n2121\t\n2122\t    cJSON_Delete(true_item);\n2123\t    return NULL;\n2124\t}\n2125\t\n2126\tCJSON_PUBLIC(cJSON*) cJSON_AddFalseToObject(cJSON * const object, const char * const name)\n2127\t{\n2128\t    cJSON *false_item = cJSON_CreateFalse();\n2129\t    if (add_item_to_object(object, name, false_item, &global_hooks, false))\n2130\t    {\n2131\t        return false_item;\n2132\t    }\n2133\t\n2134\t    cJSON_Delete(false_item);\n2135\t    return NULL;\n2136\t}\n2137\t\n2138\tCJSON_PUBLIC(cJSON*) cJSON_AddBoolToObject(cJSON * const object, const char * const name, const cJSON_bool boolean)\n2139\t{\n2140\t    cJSON *bool_item = cJSON_CreateBool(boolean);\n2141\t    if (add_item_to_object(object, name, bool_item, &global_hooks, false))\n2142\t    {\n2143\t        return bool_item;\n2144\t    }\n2145\t\n2146\t    cJSON_Delete(bool_item);\n2147\t    return NULL;\n2148\t}\n2149\t\n2150\tCJSON_PUBLIC(cJSON*) cJSON_AddNumberToObject(cJSON * const object, const char * const name, const double number)\n2151\t{\n2152\t    cJSON *number_item = cJSON_CreateNumber(number);\n2153\t    if (add_item_to_object(object, name, number_item, &global_hooks, false))\n2154\t    {\n2155\t        return number_item;\n2156\t    }\n2157\t\n2158\t    cJSON_Delete(number_item);\n2159\t    return NULL;\n2160\t}\n2161\t\n2162\tCJSON_PUBLIC(cJSON*) cJSON_AddStringToObject(cJSON * const object, const char * const name, const char * const string)\n2163\t{\n2164\t    cJSON *string_item = cJSON_CreateString(string);\n2165\t    if (add_item_to_object(object, name, string_item, &global_hooks, false))\n2166\t    {\n2167\t        return string_item;\n2168\t    }\n2