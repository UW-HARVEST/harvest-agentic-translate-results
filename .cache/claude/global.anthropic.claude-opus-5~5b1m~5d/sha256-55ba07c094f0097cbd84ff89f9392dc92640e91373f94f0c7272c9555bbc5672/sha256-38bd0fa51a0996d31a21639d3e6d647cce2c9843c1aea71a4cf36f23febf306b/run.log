{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01HDaFgc4pM3RFqc82T6ctUJ","type":"tool_result","content":"1\t/*\n2\t  Copyright (c) 2009-2017 Dave Gamble and cJSON contributors\n3\t\n4\t  Permission is hereby granted, free of charge, to any person obtaining a copy\n5\t  of this software and associated documentation files (the \"Software\"), to deal\n6\t  in the Software without restriction, including without limitation the rights\n7\t  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n8\t  copies of the Software, and to permit persons to whom the Software is\n9\t  furnished to do so, subject to the following conditions:\n10\t\n11\t  The above copyright notice and this permission notice shall be included in\n12\t  all copies or substantial portions of the Software.\n13\t\n14\t  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n15\t  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n16\t  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n17\t  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n18\t  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n19\t  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN\n20\t  THE SOFTWARE.\n21\t*/\n22\t\n23\t/* cJSON */\n24\t/* JSON parser in C. */\n25\t\n26\t#ifdef __GNUC__\n27\t#pragma GCC visibility push(default)\n28\t#endif\n29\t\n30\t#include <string.h>\n31\t#include <stdio.h>\n32\t#include <math.h>\n33\t#include <stdlib.h>\n34\t#include <limits.h>\n35\t#include <ctype.h>\n36\t#include <float.h>\n37\t\n38\t#ifdef ENABLE_LOCALES\n39\t#include <locale.h>\n40\t#endif\n41\t\n42\t#ifdef __GNUC__\n43\t#pragma GCC visibility pop\n44\t#endif\n45\t\n46\t#include \"cJSON.h\"\n47\t\n48\t/* define our own boolean type */\n49\t#ifdef true\n50\t#undef true\n51\t#endif\n52\t#define true ((cJSON_bool)1)\n53\t\n54\t#ifdef false\n55\t#undef false\n56\t#endif\n57\t#define false ((cJSON_bool)0)\n58\t\n59\t/* define isnan and isinf for ANSI C, if in C99 or above, isnan and isinf has been defined in math.h */\n60\t#ifndef isinf\n61\t#define isinf(d) (isnan((d - d)) && !isnan(d))\n62\t#endif\n63\t#ifndef isnan\n64\t#define isnan(d) (d != d)\n65\t#endif\n66\t\n67\t#ifndef NAN\n68\t#define NAN 0.0/0.0\n69\t#endif\n70\t\n71\ttypedef struct {\n72\t    const unsigned char *json;\n73\t    size_t position;\n74\t} error;\n75\tstatic error global_error = { NULL, 0 };\n76\t\n77\tCJSON_PUBLIC(const char *) cJSON_GetErrorPtr(void)\n78\t{\n79\t    return (const char*) (global_error.json + global_error.position);\n80\t}\n81\t\n82\tCJSON_PUBLIC(char *) cJSON_GetStringValue(const cJSON * const item)\n83\t{\n84\t    if (!cJSON_IsString(item))\n85\t    {\n86\t        return NULL;\n87\t    }\n88\t\n89\t    return item->valuestring;\n90\t}\n91\t\n92\tCJSON_PUBLIC(double) cJSON_GetNumberValue(const cJSON * const item)\n93\t{\n94\t    if (!cJSON_IsNumber(item))\n95\t    {\n96\t        return (double) NAN;\n97\t    }\n98\t\n99\t    return item->valuedouble;\n100\t}\n101\t\n102\t/* This is a safeguard to prevent copy-pasters from using incompatible C and header files */\n103\t#if (CJSON_VERSION_MAJOR != 1) || (CJSON_VERSION_MINOR != 7) || (CJSON_VERSION_PATCH != 19)\n104\t    #error cJSON.h and cJSON.c have different versions. Make sure that both have the same.\n105\t#endif\n106\t\n107\tCJSON_PUBLIC(const char*) cJSON_Version(void)\n108\t{\n109\t    static char version[15];\n110\t    sprintf(version, \"%i.%i.%i\", CJSON_VERSION_MAJOR, CJSON_VERSION_MINOR, CJSON_VERSION_PATCH);\n111\t\n112\t    return version;\n113\t}\n114\t\n115\t/* Case insensitive string comparison, doesn't consider two NULL pointers equal though */\n116\tstatic int case_insensitive_strcmp(const unsigned char *string1, const unsigned char *string2)\n117\t{\n118\t    if ((string1 == NULL) || (string2 == NULL))\n119\t    {\n120\t        return 1;\n121\t    }\n122\t\n123\t    if (string1 == string2)\n124\t    {\n125\t        return 0;\n126\t    }\n127\t\n128\t    for(; tolower(*string1) == tolower(*string2); (void)string1++, string2++)\n129\t    {\n130\t        if (*string1 == '\\0')\n131\t        {\n132\t            return 0;\n133\t        }\n134\t    }\n135\t\n136\t    return tolower(*string1) - tolower(*string2);\n137\t}\n138\t\n139\ttypedef struct internal_hooks\n140\t{\n141\t    void *(CJSON_CDECL *allocate)(size_t size);\n142\t    void (CJSON_CDECL *deallocate)(void *pointer);\n143\t    void *(CJSON_CDECL *reallocate)(void *pointer, size_t size);\n144\t} internal_hooks;\n145\t\n146\t#define internal_malloc malloc\n147\t#define internal_free free\n148\t#define internal_realloc realloc\n149\t\n150\t/* strlen of character literals resolved at compile time */\n151\t#define static_strlen(string_literal) (sizeof(string_literal) - sizeof(\"\"))\n152\t\n153\tstatic internal_hooks global_hooks = { internal_malloc, internal_free, internal_realloc };\n154\t\n155\tstatic unsigned char* cJSON_strdup(const unsigned char* string, const internal_hooks * const hooks)\n156\t{\n157\t    size_t length = 0;\n158\t    unsigned char *copy = NULL;\n159\t\n160\t    if (string == NULL)\n161\t    {\n162\t        return NULL;\n163\t    }\n164\t\n165\t    length = strlen((const char*)string) + sizeof(\"\");\n166\t    copy = (unsigned char*)hooks->allocate(length);\n167\t    if (copy == NULL)\n168\t    {\n169\t        return NULL;\n170\t    }\n171\t    memcpy(copy, string, length);\n172\t\n173\t    return copy;\n174\t}\n175\t\n176\tCJSON_PUBLIC(void) cJSON_InitHooks(cJSON_Hooks* hooks)\n177\t{\n178\t    if (hooks == NULL)\n179\t    {\n180\t        /* Reset hooks */\n181\t        global_hooks.allocate = malloc;\n182\t        global_hooks.deallocate = free;\n183\t        global_hooks.reallocate = realloc;\n184\t        return;\n185\t    }\n186\t\n187\t    global_hooks.allocate = malloc;\n188\t    if (hooks->malloc_fn != NULL)\n189\t    {\n190\t        