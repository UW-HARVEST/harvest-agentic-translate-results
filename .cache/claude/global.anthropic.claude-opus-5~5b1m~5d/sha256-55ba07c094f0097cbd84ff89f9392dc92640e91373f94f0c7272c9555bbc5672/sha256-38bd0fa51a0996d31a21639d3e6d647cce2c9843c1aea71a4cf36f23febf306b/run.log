 << 3;\npub const cJSON_String: c_int = 1 << 4;\npub const cJSON_Array: c_int = 1 << 5;\npub const cJSON_Object: c_int = 1 << 6;\npub const cJSON_Raw: c_int = 1 << 7;\n\npub const cJSON_IsReference: c_int = 256;\npub const cJSON_StringIsConst: c_int = 512;\n\npub const CJSON_VERSION_MAJOR: c_int = 1;\npub const CJSON_VERSION_MINOR: c_int = 7;\npub const CJSON_VERSION_PATCH: c_int = 19;\n\nconst CJSON_NESTING_LIMIT: usize = 1000;\nconst CJSON_CIRCULAR_LIMIT: usize = 10000;\n\n/// `INT_MAX` as used by the C source.\nconst INT_MAX: c_int = 2147483647;\n/// `INT_MIN` as used by the C source.\nconst INT_MIN: c_int = -2147483648;\n\n#[repr(C)]\npub struct cJSON {\n    pub next: *mut cJSON,\n    pub prev: *mut cJSON,\n    pub child: *mut cJSON,\n    pub type_: c_int,\n    pub valuestring: *mut c_char,\n    pub valueint: c_int,\n    pub valuedouble: f64,\n    pub string: *mut c_char,\n}\n\npub type cJSON_malloc_fn = unsafe extern \"C\" fn(usize) -> *mut c_void;\npub type cJSON_free_fn = unsafe extern \"C\" fn(*mut c_void);\npub type cJSON_realloc_fn = unsafe extern \"C\" fn(*mut c_void, usize) -> *mut c_void;\n\n#[repr(C)]\npub struct cJSON_Hooks {\n    pub malloc_fn: Option<cJSON_malloc_fn>,\n    pub free_fn: Option<cJSON_free_fn>,\n}\n\n// ---------------------------------------------------------------------------\n// static state\n// ---------------------------------------------------------------------------\n\n#[derive(Clone, Copy)]\nstruct Error {\n    json: *const u8,\n    position: usize,\n}\n\nstatic mut GLOBAL_ERROR: Error = Error {\n    json: ptr::null(),\n    position: 0,\n};\n\n#[derive(Clone, Copy, PartialEq)]\npub(crate) struct InternalHooks {\n    allocate: Option<cJSON_malloc_fn>,\n    deallocate: Option<cJSON_free_fn>,\n    reallocate: Option<cJSON_realloc_fn>,\n}\n\nimpl InternalHooks {\n    const fn zeroed() -> InternalHooks {\n        InternalHooks {\n            allocate: None,\n            deallocate: None,\n            reallocate: None,\n        }\n    }\n\n    #[inline]\n    unsafe fn alloc(&self, size: usize) -> *mut c_void {\n        (self.allocate.unwrap())(size)\n    }\n\n    #[inline]\n    unsafe fn dealloc(&self, pointer: *mut c_void) {\n        (self.deallocate.unwrap())(pointer)\n    }\n}\n\nstatic mut GLOBAL_HOOKS: InternalHooks = InternalHooks {\n    allocate: Some(malloc),\n    deallocate: Some(free),\n    reallocate: Some(realloc),\n};\n\n#[inline]\nfn global_hooks_ptr() -> *mut InternalHooks {\n    &raw mut GLOBAL_HOOKS\n}\n\n#[inline]\nunsafe fn global_hooks() -> InternalHooks {\n    *global_hooks_ptr()\n}\n\nmacro_rules! cs {\n    ($s:expr) => {\n        $s.as_ptr() as *const c_char\n    };\n}\n\n// ---------------------------------------------------------------------------\n// error pointer / trivial accessors\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn cJSON_GetErrorPtr() -> *const c_char {\n    let e = *(&raw const GLOBAL_ERROR);\n    e.json.wrapping_add(e.position) as *const c_char\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn cJSON_GetStringValue(item: *const cJSON) -> *mut c_char {\n    if cJSON_IsString(item) == 0 {\n        return ptr::null_mut();\n    }\n\n    (*item).valuestring\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn cJSON_GetNumberValue(item: *const cJSON) -> f64 {\n    if cJSON_IsNumber(item) == 0 {\n        return f64::NAN;\n    }\n\n    (*item).valuedouble\n}\n\nstatic mut VERSION_BUF: [c_char; 15] = [0; 15];\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn cJSON_Version() -> *const c_char {\n    let version = (&raw mut VERSION_BUF) as *mut c_char;\n    sprintf(\n        version,\n        cs!(b\"%i.%i.%i\\0\"),\n        CJSON_VERSION_MAJOR,\n        CJSON_VERSION_MINOR,\n        CJSON_VERSION_PATCH,\n    );\n\n    version\n}\n\n/// Case insensitive string comparison, doesn't consider two NULL pointers equal though.\nunsafe fn case_insensitive_strcmp(mut string1: *const u8, mut string2: *const u8) -> c_int {\n    if string1.is_null() || string2.is_null() {\n        return 1;\n    }\n\n    if string1 == string2 {\n        return 0;\n    }\n\n    while tolower(*string1 as c_int) == tolower(*string2 as c_int) {\n        if *string1 == b'\\0' {\n            return 0;\n        }\n        string1 = string1.wrapping_add(1);\n        string2 = string2.wrapping_add(1);\n    }\n\n    tolower(*string1 as c_int) - tolower(*string2 as c_int)\n}\n\nunsafe fn cJSON_strdup(string: *const u8, hooks: *const InternalHooks) -> *mut u8 {\n    let length: usize;\n    let copy: *mut u8;\n\n    if string.is_null() {\n        return ptr::null_mut();\n    }\n\n    length = strlen(string as *const c_char) + 1;\n    copy = (*hooks).alloc(length) as *mut u8;\n    if copy.is_null() {\n        return ptr::null_mut();\n    }\n    memcpy(copy as *mut c_void, string as *const c_void, length);\n\n    copy\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn cJSON_InitHooks(hooks: *mut cJSON_Hooks) {\n    let g = global_hooks_ptr();\n\n    if hooks.is_null() {\n        /* Reset hooks */\n        (*g).allocate = Some(malloc);\n        (*g).deallocate = Some(free);\n        (*g).reallocate = Some(realloc);\n        return;\n    }\n\n    (*g).allocate = Some(malloc);\n    if let Some(f) = (*hooks).malloc_fn {\n        (*g).allocate = Some(f);\n    }\n\n    (*g).deallocate = Some(free);\n    if let Some(f) = (*hooks).free_fn {\n        (*g).deallocate = Some(f);\n    }\n\n    /* use realloc only if both free and malloc are used */\n    (*g).reallocate = None;\n    if (*g).allocate == Some(malloc as cJSON_malloc_fn)\n        && (*g).deallocate == Some(free as cJSON_free_fn)\n    {\n        (*g).reallocate = Some(realloc);\n    }\n}\n\n/// Internal constructor.\nunsafe fn cJSON_New_Item(hooks: *const InternalHooks) -> *mut cJSON {\n    let node = (*hooks).alloc(core::mem::size_of::<cJSON>()) as *mut cJSON;\n    if !node.is_null() {\n        ptr::write_bytes(node as *mut u8, 0u8, core::mem::size_of::<cJSON>());\n    }\n\n    node\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn cJSON_Delete(item: *mut cJSON) {\n    let mut item = item;\n    let mut next: *mut cJSON;\n    while !item.is_null() {\n        next = (*item).next;\n        if ((*item).type_ & cJSON_IsReference) == 0 && !(*item).child.is_null() {\n            cJSON_Delete((*item).child);\n        }\n        if ((*item).type_ & cJSON_IsReference) == 0 && !(*item).valuestring.is_null() {\n            global_hooks().dealloc((*item).valuestring as *mut c_void);\n            (*item).valuestring = ptr::null_mut();\n        }\n        if ((*item).type_ & cJSON_StringIsConst) == 0 && !(*item).string.is_null() {\n            global_hooks().dealloc((*item).string as *mut c_void);\n            (*item).string = ptr::null_mut();\n        }\n        global_hooks().dealloc(item as *mut c_void);\n        item = next;\n    }\n}\n\n/// get the decimal point character of the current locale\nunsafe fn get_decimal_point() -> u8 {\n    let lc = localeconv();\n    *(*lc).decimal_point as u8\n}\n\n// ---------------------------------------------------------------------------\n// parse buffer\n// ---------------------------------------------------------------------------\n\nstruct ParseBuffer {\n    content: *const u8,\n    length: usize,\n    offset: usize,\n    depth: usize,\n    hooks: InternalHooks,\n}\n\nimpl ParseBuffer {\n    const fn zeroed() -> ParseBuffer {\n        ParseBuffer {\n            content: ptr::null(),\n            length: 0,\n            offset: 0,\n            depth: 0,\n            hooks: InternalHooks::zeroed(),\n        }\n    }\n}\n\n/// check if the given size is left to read in a given parse buffer (starting with 1)\n#[inline]\nunsafe fn can_read(buffer: *const ParseBuffer, size: usize) -> bool {\n    !buffer.is_null() && ((*buffer).offset.wrapping_add(size) <= (*buffer).length)\n}\n\n/// check if the buffer can be accessed at the given index (starting with 0)\n#[inline]\nunsafe fn can_access_at_index(buffer: *const ParseBuffer, index: usize) -> bool {\n    !buffer.is_null() && ((*buffer).offset.wrapping_add(index) < (*buffer).length)\n}\n\n#[inline]\nunsafe fn cannot_access_at_index(buffer: *const ParseBuffer, index: usize) -> bool {\n    !can_access_at_index(buffer, index)\n}\n\n/// get a pointer to the buffer at the position\n#[inline]\nunsafe fn buffer_at_offset(buffer: *const ParseBuffer) -> *const u8 {\n    (*buffer).content.wrapping_add((*buffer).offset)\n}\n\n/// Parse the input text to generate a number, and populate the result into item.\nunsafe fn parse_number(item: *mut cJSON, input_buffer: *mut ParseBuffer) -> cJSON_bool {\n    let number: f64;\n    let mut after_end: *mut c_char = ptr::null_mut();\n    let number_c_string: *mut u8;\n    let decimal_point = get_decimal_point();\n    let mut i: usize = 0;\n    let mut number_string_length: usize = 0;\n    let mut has_decimal_point: cJSON_bool = FALSE;\n\n    if input_buffer.is_null() || (*input_buffer).content.is_null() {\n        return FALSE;\n    }\n\n    /* copy the number into a temporary buffer and replace '.' with the decimal point\n     * of the current locale (for strtod)\n     * This also takes care of '\\0' not necessarily being available for marking the end of the input */\n    while can_access_at_index(input_buffer, i) {\n        match *buffer_at_offset(input_buffer).wrapping_add(i) {\n            b'0' | b'1' | b'2' | b'3' | b'4' | b'5' | b'6' | b'7' | b'8' | b'9' | b'+' | b'-'\n            | b'e' | b'E' => {\n                number_string_length += 1;\n            }\n\n            b'.' => {\n                number_string_length += 1;\n                has_decimal_point = TRUE;\n            }\n\n            _ => break,\n        }\n        i += 1;\n    }\n\n    /* malloc for temporary buffer, add 1 for '\\0' */\n    number_c_string = (*input_buffer).hooks.alloc(number_string_length + 1) as *mut u8;\n    if number_c_string.is_null() {\n        return 