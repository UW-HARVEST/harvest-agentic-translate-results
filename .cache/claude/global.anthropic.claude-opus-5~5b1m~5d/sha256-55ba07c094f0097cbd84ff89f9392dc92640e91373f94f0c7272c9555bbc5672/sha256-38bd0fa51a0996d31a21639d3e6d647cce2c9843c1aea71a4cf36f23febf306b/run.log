test: f64 = 0.0;\n\n    if output_buffer.is_null() {\n        return FALSE;\n    }\n\n    let nb = number_buffer.as_mut_ptr() as *mut c_char;\n\n    /* This checks for NaN and Infinity */\n    if d.is_nan() || d.is_infinite() {\n        length = sprintf(nb, cs!(b\"null\\0\"));\n    } else if d == (*item).valueint as f64 {\n        length = sprintf(nb, cs!(b\"%d\\0\"), (*item).valueint);\n    } else {\n        /* Try 15 decimal places of precision to avoid nonsignificant nonzero digits */\n        length = sprintf(nb, cs!(b\"%1.15g\\0\"), d);\n\n        /* Check whether the original double can be recovered */\n        if sscanf(nb as *const c_char, cs!(b\"%lg\\0\"), &mut test as *mut f64) != 1\n            || compare_double(test, d) == 0\n        {\n            /* If not, print with 17 decimal places of precision */\n            length = sprintf(nb, cs!(b\"%1.17g\\0\"), d);\n        }\n    }\n\n    /* sprintf failed or buffer overrun occurred */\n    if (length < 0) || (length > (core::mem::size_of::<[u8; 26]>() - 1) as c_int) {\n        return FALSE;\n    }\n\n    /* reserve appropriate space in the output */\n    output_pointer = ensure(output_buffer, length as usize + 1);\n    if output_pointer.is_null() {\n        return FALSE;\n    }\n\n    /* copy the printed number to the output and replace locale\n     * dependent decimal point with '.' */\n    while i < length as usize {\n        if number_buffer[i] == decimal_point {\n            *output_pointer.wrapping_add(i) = b'.';\n            i += 1;\n            continue;\n        }\n\n        *output_pointer.wrapping_add(i) = number_buffer[i];\n        i += 1;\n    }\n    *output_pointer.wrapping_add(i) = b'\\0';\n\n    (*output_buffer).offset += length as usize;\n\n    TRUE\n}\n\n/// parse 4 digit hexadecimal number\nunsafe fn parse_hex4(input: *const u8) -> u32 {\n    let mut h: u32 = 0;\n    let mut i: usize = 0;\n\n    while i < 4 {\n        let c = *input.wrapping_add(i);\n        /* parse digit */\n        if 