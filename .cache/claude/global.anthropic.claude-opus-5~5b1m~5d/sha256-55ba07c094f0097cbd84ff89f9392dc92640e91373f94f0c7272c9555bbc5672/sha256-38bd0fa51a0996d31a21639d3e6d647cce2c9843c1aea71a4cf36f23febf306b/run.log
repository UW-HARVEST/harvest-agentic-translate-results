 let buffer_pointer: *const u8;\n    if buffer.is_null() || (*buffer).buffer.is_null() {\n        return;\n    }\n    buffer_pointer = (*buffer).buffer.wrapping_add((*buffer).offset);\n\n    (*buffer).offset += strlen(buffer_pointer as *const c_char);\n}\n\n/// securely comparison of floating-point variables\nfn compare_double(a: f64, b: f64) -> cJSON_bool {\n    let max_val = if a.abs() > b.abs() { a.abs() } else { b.abs() };\n    if (a - b).abs() <= max_val * f64::EPSILON {\n        TRUE\n    } else {\n        FALSE\n    }\n}\n\n/// Render the number nicely from the given item into a string.\nunsafe fn print_number(item: *const cJSON, output_buffer: *mut PrintBuffer) -> cJSON_bool {\n    let output_pointer: *mut u8;\n    let d = (*item).valuedouble;\n    let mut length: c_int;\n    let mut i: usize = 0;\n    let mut number_buffer: [u8; 26] = [0; 26]; /* temporary buffer to print the number into */\n    let decimal_point = get_decimal_point();\n    let mut test: f64 = 0.0;\n\n    if output_buffer.is_null() {\n        return FALSE;\n    }\n\n    let nb = number_buffer.as_mut_ptr() as *mut c_char;\n\n    /* This checks for NaN and Infinity */\n    if d.is_nan() || d.is_infinite() {\n        length = sprintf(nb, cs!(b\"null\\0\"));\n    } else if d == (*item).valueint as f64 {\n        length = sprintf(nb, cs!(b\"%d\\0\"), (*item).valueint);\n    } else {\n        /* Try 15 decimal places of precision to avoid nonsignificant nonzero digits */\n        length = sprintf(nb, cs!(b\"%1.15g\\0\"), d);\n\n        /* Check whether the original double can be recovered */\n        if sscanf(nb as *const c_char, cs!(b\"%lg\\0\"), &mut test as *mut f64) != 1\n            || compare_double(test, d) == 0\n        {\n            /* If not, print with 17 decimal places of precision */\n            length = sprintf(nb, cs!(b\"%1.17g\\0\"), d);\n        }\n    }\n\n    /* sprintf failed or buffer overrun occurred */\n    if (length < 0) || (length > (core::mem::size_of::<[u8; 26]>() - 1) as c_int) {\n        return FALSE;\n    }\n\n    /* reserve appropriate space in the output */\n    output_pointer = ensure(output_buffer, length as usize + 1);\n    if output_pointer.is_null() {\n        return FALSE;\n    }\n\n    /* copy the printed number to the output and replace locale\n     * dependent decimal point with '.' */\n    while i < length as usize {\n        if number_buffer[i] == decimal_point {\n            *output_pointer.wrapping_add(i) = b'.';\n            i += 1;\n            continue;\n        }\n\n        *output_pointer.wrapping_add(i) = number_buffer[i];\n        i += 1;\n    }\n    *output_pointer.wrapping_add(i) = b'\\0';\n\n    (*output_buffer).offset += length as usize;\n\n    TRUE\n}\n\n/// parse 4 digit hexadecimal number\nunsafe fn parse_hex4(input: *const u8) -> u32 {\n    let mut h: u32 = 0;\n    let mut i: usize = 0;\n\n    while i < 4 {\n        let c = *input.wrapping_add(i);\n        /* parse digit */\n        if c >= b'0' && c <= b'9' {\n            h = h.wrapping_add((c as u32).wrapping_sub(b'0' as u32));\n        } else if c >= b'A' && c <= b'F' {\n            h = h.wrapping_add((10u32.wrapping_add(c as u32)).wrapping_sub(b'A' as u32));\n        } else if c >= b'a' && c <= b'f' {\n            h = h.wrapping_add((10u32.wrapping_add(c as u32)).wrapping_sub(b'a' as u32));\n        } else {\n            /* invalid */\n            return 0;\n        }\n\n        if i < 3 {\n            /* shift left to make place for the next nibble */\n            h <<= 4;\n        }\n        i += 1;\n    }\n\n    h\n}\n\n/// converts a UTF-16 literal to UTF-8\n/// A literal can be one or two sequences of the form \\uXXXX\nunsafe fn utf16_literal_to_utf8(\n    input_pointer: *const u8,\n    input_end: *const u8,\n    output_pointer: *mut *mut u8,\n) -> u8 {\n    let mut codepoint: u64 = 0;\n    let first_code: u32;\n    let first_sequence: *const u8 = input_pointer;\n    let utf8_length: u8;\n    let mut utf8_position: u8;\n    let sequence_length: u8;\n    let mut first_byte_mark: u8 = 0;\n\n    if (input_end as isize - first_sequence as isize) < 6 {\n        /* input ends unexpectedly */\n        return 0;\n    }\n\n    /* get the first utf16 sequence */\n    first_code = parse_hex4(first_sequence.wrapping_add(2));\n\n    /* check that the code is valid */\n    if first_code >= 0xDC00 && first_code <= 0xDFFF {\n        return 0;\n    }\n\n    /* UTF16 surrogate pair */\n    if first_code >= 0xD800 && first_code <= 0xDBFF {\n        let second_sequence: *const u8 = first_sequence.wrapping_add(6);\n        let second_code: u32;\n        sequence_length = 12; /* \\uXXXX\\uXXXX */\n\n        if (input_end as isize - second_sequence as isize) < 6 {\n            /* input ends unexpectedly */\n            return 0;\n        }\n\n        if *second_sequence != b'\\\\' || *second_sequence.wrapping_add(1) != b'u' {\n            /* missing second half of the surrogate pair */\n            return 0;\n        }\n\n        /* get the second utf16 sequence */\n        second_code = parse_hex4(second_sequence.wrapping_add(2));\n        /* check that the code is valid */\n        if second_code < 0xDC00 || second_code > 0xDFFF {\n            /* invalid second half of the surrogate pair */\n            return 0;\n        }\n\n        /* calculate the unicode codepoint from the surrogate pair */\n        codepoint =\n            0x10000u64 + ((((first_code & 0x3FF) << 10) | (second_code & 0x3FF)) as u64);\n    } else {\n        sequence_length = 6; /* \\uXXXX */\n        codepoint = first_code as u64;\n    }\n\n    /* encode as UTF-8\n     * takes at maximum 4 bytes to encode:\n     * 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx */\n    if codepoint < 0x80 {\n        /* normal ascii, encoding 0xxxxxxx */\n        utf8_length = 1;\n    } else if codepoint < 0x800 {\n        /* two bytes, encoding 110xxxxx 10xxxxxx */\n        utf8_length = 2;\n        first_byte_mark = 0xC0; /* 11000000 */\n    } else if codepoint < 0x10000 {\n        /* three bytes, encoding 1110xxxx 10xxxxxx 10xxxxxx */\n        utf8_length = 3;\n        first_byte_mark = 0xE0; /* 11100000 */\n    } else if codepoint <= 0x10FFFF {\n        /* four bytes, encoding 1110xxxx 10xxxxxx 10xxxxxx 10xxxxxx */\n        utf8_length = 4;\n        first_byte_mark = 0xF0; /* 11110000 */\n    } else {\n        /* invalid unicode codepoint */\n        return 0;\n    }\n\n    /* encode as utf8 */\n    utf8_position = utf8_length.wrapping_sub(1);\n    while utf8_position > 0 {\n        /* 10xxxxxx */\n        *(*output_pointer).wrapping_add(utf8_position as usize) =\n            ((codepoint | 0x80) & 0xBF) as u8;\n        codepoint >>= 6;\n        utf8_position = utf8_position.wrapping_sub(1);\n    }\n    /* encode first byte */\n    if utf8_length > 1 {\n        **output_pointer = ((codepoint | first_byte_mark as u64) & 0xFF) as u8;\n    } else {\n        **output_pointer = (codepoint & 0x7F) as u8;\n    }\n\n    *output_pointer = (*output_pointer).wrapping_add(utf8_length as usize);\n\n    sequence_length\n}\n\n/// Parse the input text into an unescaped cinput, and populate item.\nunsafe fn parse_string(item: *mut cJSON, input_buffer: *mut ParseBuffer) -> cJSON_bool {\n    let start = buffer_at_offset(input_buffer).wrapping_add(1);\n    let mut input_pointer: *const u8 = start;\n    let mut input_end: *const u8 = start;\n    let mut output: *mut u8 = ptr::null_mut();\n\n    let succeeded = 'body: {\n        /* not a string */\n        if *buffer_at_offset(input_buffer) != b'\\\"' {\n            break 'body false;\n        }\n\n        {\n            /* calculate approximate size of the output (overestimate) */\n            let allocation_length: usize;\n            let mut skipped_bytes: usize = 0;\n            while (((input_end as usize).wrapping_sub((*input_buffer).content as usize))\n                < (*input_buffer).length)\n                && (*input_end != b'\\\"')\n            {\n                /* is escape sequence */\n                if *input_end == b'\\\\' {\n                    if ((input_end.wrapping_add(1) as usize)\n                        .wrapping_sub((*input_buffer).content as usize))\n                        >= (*input_buffer).length\n                    {\n                        /* prevent buffer overflow when last input character is a backslash */\n                        break 'body false;\n                    }\n                    skipped_bytes += 1;\n                    input_end = input_end.wrapping_add(1);\n                }\n                input_end = input_end.wrapping_add(1);\n            }\n            if (((input_end as usize).wrapping_sub((*input_buffer).content as usize))\n                >= (*input_buffer).length)\n                || (*input_end != b'\\\"')\n            {\n                break 'body false; /* string ended unexpectedly */\n            }\n\n            /* This is at most how much we need for the output */\n            allocation_length = ((input_end as usize)\n                .wrapping_sub(buffer_at_offset(input_buffer) as usize))\n                .wrapping_sub(skipped_bytes);\n            output = (*input_buffer).hooks.alloc(allocation_length + 1) as *mut u8;\n            if output.is_null() {\n                break 'body false; /* allocation failure */\n            }\n        }\n\n        let mut output_pointer: *mut u8 = output;\n        /* loop through the string literal */\n        while input_pointer < input_end {\n            if *input_pointer != b'\\\\' {\n                *output_pointer = *input_pointer;\n                output_pointer = output_pointer.wrapping_add(1);\n                input_pointer = input_pointer.wrapping_add(1);\n            }\n            /* escape sequence */\n            else {\n                let mut sequence_length: u8 = 2;\n                if (input_end as isize - input_pointer as isize) < 1 {\n                    break 'body false;\n                }\n\n                match *input_pointer.wrapping_add(1