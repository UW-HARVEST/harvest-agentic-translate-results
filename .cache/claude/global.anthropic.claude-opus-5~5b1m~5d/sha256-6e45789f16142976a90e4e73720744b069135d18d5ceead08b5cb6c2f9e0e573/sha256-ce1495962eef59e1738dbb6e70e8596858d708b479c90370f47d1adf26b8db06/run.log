_ptr());\n    80\t            return;\n    81\t        }\n    82\t\n    83\t        let index = (*manager).task_count;\n    84\t        (*manager).task_count = index.wrapping_add(1);\n    85\t        let task: *mut Task = (*manager).tasks.offset(index as isize);\n    86\t\n    87\t        let desc: *mut c_char = (&raw mut (*task).description) as *mut c_char;\n    88\t        cstd::strncpy(desc, description, 256 - 1);\n    89\t        *desc.add(256 - 1) = 0;\n    90\t        (*task).priority = priority;\n    91\t\n    92\t        log_info(c\"Task added successfully.\".as_ptr());\n    93\t    }\n    94\t}\n    95\t\n    96\t/// ```c\n    97\t/// void print_tasks(const TaskManager *manager);\n    98\t/// ```\n    99\t#[unsafe(no_mangle)]\n   100\tpub extern \"C\" fn print_tasks(manager: *const TaskManager) {\n   101\t    unsafe {\n   102\t        cstd::c_printf(c\"Tasks:\\n\".as_ptr());\n   103\t        let mut i: c_int = 0;\n   104\t        while i < (*manager).task_count {\n   105\t            let task: *const Task = (*manager).tasks.offset(i as isize);\n   106\t            cstd::c_printf(\n   107\t                c\"  [%d] %s (Priority: %d)\\n\".as_ptr(),\n   108\t                i.wrapping_add(1),\n   109\t                (&raw const (*task).description) as *const c_char,\n   110\t                (*task).priority,\n   111\t            );\n   112\t            i = i.wrapping_add(1);\n   113\t        }\n   114\t    }\n   115\t}\n   116\t\n   117\t/// ```c\n   118\t/// void destroy_task_manager(TaskManager *manager);\n   119\t/// ```\n   120\t#[unsafe(no_mangle)]\n   121\tpub extern \"C\" fn destroy_task_manager(manager: *mut TaskManager) {\n   122\t    unsafe {\n   123\t        cstd::free((*manager).tasks as *mut c_void);\n   124\t        cstd::free(manager as *mut c_void);\n   125\t    }\n   126\t    log_info(c\"TaskManager destroyed successfully.\".as_ptr());\n   127\t}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
