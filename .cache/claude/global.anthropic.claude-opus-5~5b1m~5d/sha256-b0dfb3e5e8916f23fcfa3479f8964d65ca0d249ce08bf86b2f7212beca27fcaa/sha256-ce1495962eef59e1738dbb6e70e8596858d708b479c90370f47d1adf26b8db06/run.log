apper giving a process-wide mutable `int`, mirroring a C function-scope\n    40\t/// `static int`.  Like the C original this performs no synchronisation.\n    41\tstruct CStatic(UnsafeCell<c_int>);\n    42\t\n    43\t// SAFETY: matches the (absent) thread-safety guarantees of the C `static int`.\n    44\tunsafe impl Sync for CStatic {}\n    45\t\n    46\t/// `static int sum = 0;` from `static_sum()`.\n    47\tstatic SUM: CStatic = CStatic(UnsafeCell::new(0));\n    48\t\n    49\t/// ```c\n    50\t/// int\n    51\t/// static_sum(int update) {\n    52\t///   static int sum = 0;\n    53\t///   sum += update;\n    54\t///   return sum;\n    55\t/// }\n    56\t/// ```\n    57\t#[unsafe(no_mangle)]\n    58\tpub extern \"C\" fn static_sum(update: c_int) -> c_int {\n    59\t    let sum = SUM.0.get();\n    60\t    // `wrapping_add` reproduces the two's-complement wrap-around that gcc/clang\n    61\t    // emit for `sum += update` (signed overflow is UB in C, but in practice it\n    62\t    // simply wraps on the supported targets).\n    63\t    unsafe {\n    64\t        *sum = (*sum).wrapping_add(update);\n    65\t        *sum\n    66\t    }\n    67\t}\n    68\t\n    69\t/// ```c\n    70\t/// void\n    71\t/// driver(int stride) {\n    72\t///   for (int i = 0; i < 10; i++) {\n    73\t///     printf(\"%d\\n\", static_sum(i * stride));\n    74\t///   }\n    75\t///   return;\n    76\t/// }\n    77\t/// ```\n    78\t#[unsafe(no_mangle)]\n    79\tpub extern \"C\" fn driver(stride: c_int) {\n    80\t    let mut i: c_int = 0;\n    81\t    while i < 10 {\n    82\t        let value = static_sum(i.wrapping_mul(stride));\n    83\t        unsafe {\n    84\t            printf(b\"%d\\n\\0\".as_ptr() as *const c_char, value);\n    85\t        }\n    86\t        i = i.wrapping_add(1);\n    87\t    }\n    88\t}","is_error":false}]},"parent_tool_use_id":null,"session_id":"95f246a7-fb23-4de5-b1b5-410f54559215","uuid":"1fb1a8f3-a5a2-4a04-9770-0afcfc6da897","timestamp":"2026-08-28T09:52:40.973Z