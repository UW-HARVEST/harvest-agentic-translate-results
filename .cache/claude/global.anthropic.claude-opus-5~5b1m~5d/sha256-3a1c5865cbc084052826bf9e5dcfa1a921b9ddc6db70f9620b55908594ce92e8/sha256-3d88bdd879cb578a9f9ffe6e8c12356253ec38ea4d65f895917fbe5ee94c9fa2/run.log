   while bits > 0 {\n            let k = bits.min(31);\n            if n.divmod_small(1u32 << k) != 0 {\n                return false;\n            }\n            bits -= k;\n        }\n    }\n    true\n}\n\n/// Value of a hexadecimal mantissa (`digits`, of which the last `frac_len` are\n/// fractional) scaled by 2^`pexp`, together with the `ERANGE` flag.\nfn hex_value(digits: &[u8], frac_len: usize, pexp: i64) -> (f64, bool) {\n    let mut sig: u128 = 0;\n    let mut sticky = false;\n    let mut dropped_bits: i128 = 0;\n    for &c in digits {\n        let v = hex_val(c) as u128;\n        if sig == 0 && v == 0 {\n            continue;\n        }\n        if sig >> 120 != 0 {\n            sticky |= v != 0;\n            dropped_bits += 4;\n        } else {\n            sig = (sig << 4) | v;\n        }\n    }\n    if sig == 0 {\n        return (0.0, false);\n    }\n    let exp2 = (pexp as i128) - 4 * (frac_len as i128) + dropped_bits;\n    round_to_double(sig, sticky, exp2)\n}\n\n/// Round `sig * 2^exp2` (plus a sticky remainder below the last bit of `sig`)\n/// to the nearest double, reporting whether `ERANGE` would be raised.\nfn round_to_double(sig: u128, sticky: bool, exp2: i128) -> (f64, bool) {\n    let bl = (128 - sig.leading_zeros()) as i128;\n    let e_msb = exp2 + bl - 1; // exponent of the most significant bit\n    let tiny = e_msb < -1022;\n\n    if e_msb > 1024 {\n        return (f64::INFINITY, true);\n    }\n\n    let keep: i128 = if !tiny { 53 } else { e_msb + 1075 };\n    let shift = bl - keep;\n\n    let (mut m, inexact) = if shift <= 0 {\n        let m = sig << ((-shift) as u32);\n        (m, sticky)\n    } else if shift >= 129 {\n        (0u128, true)\n    } else if shift == 128 {\n        let half = 1u128 << 127;\n        let up = sig > half || (sig == half && sticky);\n        (if up { 1u128 } else { 0u128 }, true)\n    } else {\n        let sh = shift as u32;\n        let mask = (1u128 << sh) - 1;\n        let dropped = sig & mask;\n        let half = 1u128 << (sh - 1);\n        let q = sig >> sh;\n        let up = dropped > half || (dropped == half && (sticky || (q & 1) == 1));\n        (if up { q + 1 } else { q }, sticky || dropped != 0)\n    };\n\n    let mut e = exp2 + shift;\n    if m == 0 {\n        return (0.0, tiny && inexact);\n    }\n\n    // Overflow check after rounding.\n    let bl_m = (128 - m.leading_zeros()) as i128;\n    if e + bl_m - 1 > 1023 {\n        return (f64::INFINITY, true);\n    }\n\n    // Build the exact value m * 2^e.\n    if e < -1074 && m % 2 != 0 {\n        // Unreachable: rounding above always lands on a representable value.\n        return (0.0, tiny && inexact);\n    }\n    while e < -1074 && m % 2 == 0 {\n        m /= 2;\n        e += 1;\n    }\n    let value = (m as f64) * pow2(e as i32);\n    (value, tiny && inexact)\n}\n\n/// Exact 2^e for -1074 <= e <= 1023.\nfn pow2(e: i32) -> f64 {\n    if e >= -1022 {\n        f64::from_bits(((e + 1023) as u64) << 52)","numLines":160,"startLine":255,"totalLines":438}}}
