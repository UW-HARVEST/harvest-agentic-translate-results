)])\n# zeros and specials\nfor b in [\"0\", \"-0\", \"0.0\", \"-0.0\", \"inf\", \"-inf\", \"nan\", \"-nan\"]:\n    for y in [\"0\", \"-0\", \"1\", \"-1\", \"2\", \"-2\", \"0.5\", \"-0.5\", \"3\", \"-3\", \"inf\", \"-inf\", \"nan\", \"-nan\",\n              \"1e300\", \"-1e300\", \"1074\", \"-1074\"]:\n        cases.append([b, y])\n# exactly representable results / %.2f of huge values\nfor b in [\"10\", \"2\", \"-2\", \"1.5\", \"-1.5\", \"7\"]:\n    for y in [str(i) for i in range(0, 40)] + [\"100\", \"300\", \"308\", \"1000\", \"1023\", \"1024\"]:\n        cases.append([b, y])\n        cases.append([b, \"-\" + y])\n# random pairs, biased to interesting magnitudes\nfor _ in range(4000):\n    b = random.choice([random.uniform(-10, 10), random.uniform(-1e300, 1e300),\n                       random.uniform(0, 1e-300), math.ldexp(random.random(), random.randrange(-1074, 1024))])\n    y = random.choice([random.uniform(-1000, 1000), random.uniform(-10, 10), float(random.randrange(-2000, 2000)),\n                       random.uniform(-1e10, 1e10)])\n    cases.append([g(b), g(y)])\n# results near half-way for %.2f rounding\nfor _ in range(2000):\n    v = random.randrange(1, 10**random.randrange(1, 17))\n    cases.append([\"%d.005\" % v, \"1\"])\n    cases.append([\"%d.995\" % v, \"1\"])\n    cases.append([\"%d.5\" % v, \"1\"])\n    cases.append([g(v + 0.125), \"1\"])\n\nfor c in cases:\n    check(c)\n    if fails > 25:\n        print(\"stopping early\"); break\nprint(\"total\", len(cases), \"fails\", fails)\nsys.exit(1 if fails else 0)\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":132,"cache_read_input_tokens":134015,"cache_creation":{"ephemeral_5m_input_tokens":132,"ephemeral_1h_input_tokens":0},"output_tokens":5,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"8e63daaf-7606-4425-84cc-c29d9c9171ad","uuid":"40172b24-2f34-41f6-9743-13cbe0b93961","timestamp"