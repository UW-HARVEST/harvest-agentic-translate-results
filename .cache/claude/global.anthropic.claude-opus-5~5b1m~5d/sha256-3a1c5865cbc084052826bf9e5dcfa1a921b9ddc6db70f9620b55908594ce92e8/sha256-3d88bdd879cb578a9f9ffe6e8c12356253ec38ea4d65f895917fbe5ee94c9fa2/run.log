{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_ijj57vlnluew73bptokeulhjlizqeaubrol53fsnqqf3kibkvoza","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_0124A9t7nLVm1NQ11rKpHmk4","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-vHdJb4/_ref/difftest2.py","content":"#!/usr/bin/env python3\n\"\"\"Targeted differential tests: exact/inexact subnormal decimals, %.2f rounding.\"\"\"\nimport subprocess, sys, random\nfrom decimal import Decimal, getcontext\ngetcontext().prec = 2000\n\nC = \"./_ref/driver\"\nR = \"./translation/target/release/driver\"\n\ndef run(prog, args):\n    p = subprocess.run([prog]+args, capture_output=True)\n    return p.returncode, p.stdout, p.stderr\n\nfails = 0\ndef check(args):\n    global fails\n    a, b = run(C, args), run(R, args)\n    if a != b:\n        fails += 1\n        print(\"MISMATCH\", args)\n        print(\"  C:\", a)\n        print(\"  R:\", b)\n\ncases = []\n# exact multiples of 2^-1074 (exact decimal expansions), plus padded variants\nfor m in [1,2,3,5,7,8,1023,2**26, 2**51, 2**52-1, 2**52, 2**52+1, 2**53-1]:\n    d = Decimal(m) * (Decimal(2) ** -1074)\n    s = format(d, 'f')\n    cases.append([s, \"2\"])\n    cases.append([s + \"000\", \"2\"])\n    cases.append([s[:-1], \"2\"])          # truncated -> inexact\n    cases.append([s + \"1\", \"2\"])         # extended -> inexact\n    cases.append([\"%se-100\" % (format(d * Decimal(10)**100, 'f')), \"2\"])\n# values around 2^-1022 (DBL_MIN)\nminpos = Decimal(2) ** -1022\nfor delta in [0, 1, -1, 2, -2]:\n    v = (Decimal(2)**-1074) * (2**52 + delta)\n    cases.append([format(v, 'f'), \"2\"])\n# half-way rounding towards DBL_MIN\nhalf = (Decimal(2)**-1074) / 2\nfor k in [-1, 0, 1]:\n    v = minpos - half + half*Decimal(k)/10\n    cases.append([format(v, 'f'), \"2\"])\n    cases.append([format(minpos + half*Decimal(k)/10, 'f'), \"2\"])\n# hex exact/inexact subnormals\nfor k in range(1, 60):\n    cases.append([\"0x%xp-1074\" % ((1 << k) | 1), \"2\"])\n    cases.append([\"0x1.%013xp-1022\" % random.getrandbits(52), \"2\"])\n# %.2f rounding: exact .xx5 ties and near ties\nrandom.seed(7)\nvals = [\"0.125\",\"0.375\",\"2.005\",\"1.005\",\"0.005\",\"-0.125\",\"-0.375\",\"2.675\",\"1.115\",\"1e15\",\"1e16\",\"123456789.985\",\n        \"0.015\",\"0.025\",\"0.035\",\"0.045\",\"4503599627370495.5\",\"0.5\",\"1.5\",\"2.5\",\"-2.5\",\"1e300\",\"1e-300\",\"-1e-5\"]\nfor v in vals:\n    cases.append([v, \"1\"])\n    cases.append([v, \"2\"])\n    cases.append([v, \"3\"])\n    cases.append([v, \"0.5\"])\nfor _ in range(1500):\n    a = random.randrange(1, 10**random.randrange(1,18))\n    b = random.randrange(0, 8)\n    cases.append([\"%d.%s\" % (a, str(random.randrange(0,10**6)).zfill(b) if b else \"0\"), random.choice([\"1\",\"2\",\"3\",\"0.5\",\"-1\",\"7\"])])\n# long digit strings\nfor _ in range(200):\n    n = random.randrange(300, 900)\n    digs = \"\".join(random.choice(\"0123456789\") for _ in range(n))\n    e = random.randrange(-700, -280)\n    cases.append([\"0.\" + digs + \"e\" + str(e), \"2\"])\n    cases.append([digs + \"e\" + str(e), \"3\"])\n\nfor c in cases:\n    check(c)\n    if fails > 30: break\nprint(\"total\", len(cases), \"fails\", fails)\nsys.exit(1 if fails else 0)\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2021,"cache_read_input_tokens":71254,"cache_creation":{"ephemeral_5m_input_tokens":2021,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"8e63daaf-7606-4425-84cc-c29d9c9171ad","uuid":"abd8f342-ba71-42a6-9c43-8167ab847b12","timestamp":"2026-08-28T10:12:31.495Z"}
