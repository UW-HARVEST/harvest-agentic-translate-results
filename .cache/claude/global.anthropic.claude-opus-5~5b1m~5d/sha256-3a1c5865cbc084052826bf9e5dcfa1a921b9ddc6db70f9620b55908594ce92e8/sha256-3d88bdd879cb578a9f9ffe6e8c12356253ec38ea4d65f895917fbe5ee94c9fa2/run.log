{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01MvamwM1VhPhNXJCoHvvupU","type":"tool_result","content":"227\t/// Value of a decimal mantissa (`digits`, of which the last `frac_len` are\n228\t/// fractional) scaled by 10^`exp10`, together with the `ERANGE` flag.\n229\tfn decimal_value(digits: &[u8], frac_len: usize, exp10: i64) -> (f64, bool) {\n230\t    // Significant digits: strip leading and trailing zeros, folding the removed\n231\t    // trailing zeros into the decimal exponent.\n232\t    let first = digits.iter().position(|&c| c != b'0');\n233\t    let first = match first {\n234\t        Some(p) => p,\n235\t        None => return (0.0, false), // value is exactly zero\n236\t    };\n237\t    let last = digits.iter().rposition(|&c| c != b'0').unwrap();\n238\t    let sig = &digits[first..=last];\n239\t    let trailing_zeros = (digits.len() - 1 - last) as i64;\n240\t    let e10 = exp10\n241\t        .saturating_sub(frac_len as i64)\n242\t        .saturating_add(trailing_zeros);\n243\t\n244\t    // Correctly rounded conversion, with the exponent clamped to a value that\n245\t    // is guaranteed to produce the same infinity / zero result.\n246\t    let lo = -(sig.len() as i64 + 400);\n247\t    let hi = 400i64;\n248\t    let clamped = if e10 < lo {\n249\t        lo\n250\t    } else if e10 > hi {\n251\t        hi\n252\t    } else {\n253\t        e10\n254\t    };\n255\t    let mut text = String::with_capacity(sig.len() + 24);\n256\t    text.push_str(std::str::from_utf8(sig).unwrap());\n257\t    text.push('e');\n258\t    text.push_str(&clamped.to_string());\n259\t    let value: f64 = text.parse().unwrap_or(f64::INFINITY);\n260\t\n261\t    if value.is_infinite() {\n262\t        return (value, true); // overflow\n263\t    }\n264\t    if value.abs() <= f64::MIN_POSITIVE && is_tiny(sig, e10) && !is_exact_subnormal(sig, e10) {\n265\t        return (value, true); // underflow: tiny and inexact\n266\t    }\n267\t    (value, false)\n268\t}\n269\t\n270\t/// Is `sig * 10^e10` (a positive value) strictly smaller than 2^-1022?\n271\tfn is_tiny(sig: &[u8], e10: i64) -> bool {\n272\t    if e10 >= 0 {\n273\t        return false;\n274\t    }\n275\t    let f = -(e10 as i128);\n276\t    let len = sig.len() as i128;\n277\t    // value < 10^(len - f) and value >= 10^(len - 1 - f)\n278\t    if len - f <= -309 {\n279\t        return true;\n280\t    }\n281\t    if len - 1 - f >= -307 {\n282\t        return false;\n283\t    }\n284\t    // Borderline: compare sig * 2^1022 against 10^f exactly.\n285\t    let mut a = Big::from_digits(sig);\n286\t    a.shl_bits(1022);\n287\t    let b = Big::pow10(f as usize);\n288\t    a.cmp_big(&b) == Ordering::Less\n289\t}\n290\t\n291\t/// Is `sig * 10^e10` an exact integer multiple of 2^-1074 (i.e. exactly\n292\t/// representable as a subnormal double)?\n293\tfn is_exact_subnormal(sig: &[u8], e10: i64) -> bool {\n294\t    if e10 >= 0 {\n295\t        return true;\n296\t    }"}]},"parent_tool_use_id":null,"session_id":"8e63daaf-7606-4425-84cc-c29d9c9171ad","uuid":"a0208aa1-2672-45e5-98db-940ac17d34cf","timestamp":"2026-08-28T10:14:23.486Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-vHdJb4/translation/src/strtod.rs","content":"/// Value of a decimal mantissa (`digits`, of which the last `frac_len` are\n/// fractional) scaled by 10^`exp10`, together with the `ERANGE` flag.\nfn decimal_value(digits: &[u8], frac_len: usize, exp10: i64) -> (f64, bool) {\n    // Significant digits: strip leading and trailing zeros, folding the removed\n    // trailing zeros into the decimal exponent.\n    let first = digits.iter().position(|&c| c != b'0');\n    let first = match first {\n        Some(p) => p,\n        None => return (0.0, false), // value is exactly zero\n    };\n    let last = digits.iter().rposition(|&c| c != b'0').unwrap();\n    let sig = &digits[first..=last];\n    let trailing_zeros = (digits.len() - 1 - last) as i64;\n    let e10 = exp10\n        .saturating_sub(frac_len as i64)\n        .saturating_add(trailing_zeros);\n\n    // Correctly rounded conversion, with the exponent clamped to a value that\n    // is guaranteed to produce the same infinity / zero result.\n    let lo = -(sig.len() as i64 + 400);\n    let hi = 400i64;\n    let clamped = if e10 < lo {\n        lo\n    } else if e10 > hi {\n        hi\n    } else {\n        e10\n    };\n    let mut text = String::with_capacity(sig.len() + 24);\n    text.push_str(std::str::from_utf8(sig).unwrap());\n    text.push('e');\n    text.push_str(&clamped.to_string());\n    let value: f64 = text.parse().unwrap_or(f64::INFINITY);\n\n    if value.is_infinite() {\n        return (value, true); // overflow\n    }\n    if value.abs() <= f64::MIN_POSITIVE && is_tiny(sig, e10) && !is_exact_subnormal(sig, e10) {\n        return (value, true); // underflow: tiny and inexact\n    }\n    (value, false)\n}\n\n/// Is `sig * 10^e10` (a positive value) strictly smaller than 2^-1022?\nfn is_tiny(sig: &[u8], e10: i64) -> bool {\n    if e10 >= 0 {\n        return false;\n    }\n    let f = -(e10 as i128);\n    let len = sig.len() as i128;\n    // value < 10^(len - f) and value >= 10^(len - 1 - f)\n    if len - f <= -309 {\n        return true;\n    }\n    if len - 1 - f >= -307 {\n        return false;\n    }\n    // Borderline: compare sig * 2^1022 against 10^f exactly.\n    let mut a = Big::from_digits(sig);\n    a.shl_bits(1022);\n    let b = Big::pow10(f as usize);\n    a.cmp_big(&b) == Ordering::Less\n}\n\n/// Is `sig * 10^e10` an exact integer multiple of 2^-1074 (i.e. exactly\n/// representable as a subnormal double)?\nfn is_exact_subnormal(sig: &[u8], e10: i64) -> bool {\n    if e10 >= 0 {\n        return true;\n    }","numLines":70,"startLine":227,"totalLines":438}}}
