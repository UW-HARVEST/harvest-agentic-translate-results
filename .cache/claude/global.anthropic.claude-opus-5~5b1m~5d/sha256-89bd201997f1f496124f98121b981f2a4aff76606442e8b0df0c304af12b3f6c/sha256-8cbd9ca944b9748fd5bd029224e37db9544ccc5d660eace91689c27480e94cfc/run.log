{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01QyQe8sxQsaVzewCBskRCsG","type":"tool_result","content":"1\t// Copyright 2025 MIT Lincoln Laboratory\n2\t// Permission is hereby granted, free of charge,\n3\t// to any person obtaining a copy of this software\n4\t// and associated documentation files (the \"Software\"),\n5\t// to deal in the Software without restriction,\n6\t// including without limitation the rights to use, copy,\n7\t// modify, merge, publish, distribute, sublicense,\n8\t// and/or sell copies of the Software,\n9\t// and to permit persons to whom the Software is furnished to do so,\n10\t// subject to the following conditions:\n11\t\n12\t// The above copyright notice and this permission notice\n13\t// shall be included in all copies or substantial portions of the Software.\n14\t\n15\t// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n16\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n17\t// THE WARRANTIES OF MERCHANTABILITY,\n18\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n19\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n20\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n21\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n22\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n23\t\n24\t//! Rust translation of `c_src/src/lib.c`.\n25\t//!\n26\t//! The C translation unit contains no `static` functions, so every function it\n27\t//! defines is part of the shared library's public ABI:\n28\t//!\n29\t//! * `add_operation`\n30\t//! * `multiply_operation`\n31\t//! * `subtract_operation`\n32\t//! * `modulo_operation`\n33\t//! * `safe_double_to_int`\n34\t//! * `compute_scaled_value`\n35\t//! * `compare_results_in_array`\n36\t//! * `init_result_array`\n37\t//! * `process_with_foreach`\n38\t//! * `compute_weighted_sum`\n39\t//! * `arrayfunc`\n40\t//!\n41\t//! All of them are re-exported here with identical linker names, signatures and\n42\t//! (bug-for-bug) behaviour.\n43\t\n44\t#![allow(non_camel_case_types)]\n45\t\n46\tuse std::os::raw::{c_double, c_int};\n47\t\n48\t/// `typedef int (*operation_func)(int a, int b, int unused1, int unused2);`\n49\t///\n50\t/// Modelled as an `Option<extern \"C\" fn ...>` so that a NULL function pointer\n51\t/// coming from C can be represented; the ABI is identical to a bare C function\n52\t/// pointer thanks to the null-pointer optimization.\n53\tpub type operation_func =\n54\t    Option<unsafe extern \"C\" fn(a: c_int, b: c_int, unused1: c_int, unused2: c_int) -> c_int>;\n55\t\n56\t/// ```c\n57\t/// typedef struct {\n58\t///     int value;\n59\t///     double scaled;\n60\t///     int rank;\n61\t/// } Result;\n62\t/// ```\n63\t///\n64\t/// sizeof == 24, offsets: value @ 0, scaled @ 8, rank @ 16.\n65\t#[repr(C)]\n66\t#[derive(Clone, Copy)]\n67\tpub struct Result {\n68\t    pub value: c_int,\n69\t    pub scaled: c_double,\n70\t    pub rank: c_int,\n71\t}\n72\t\n73\t/// ```c\n74\t/// typedef struct {\n75\t///     Result data[10];\n76\t///     int count;\n77\t/// } ResultArray;\n78\t/// ```\n79\t///\n80\t/// sizeof == 248, offsets: data @ 0, count @ 240.\n81\t#[repr(C)]\n82\t#[derive(Clone, Copy)]\n83\tpub struct ResultArray {\n84\t    pub data: [Result; 10],\n85\t    pub count: c_int,\n86\t}\n87\t\n88\t// ---------------------------------------------------------------------------\n89\t// Arithmetic operations\n90\t// ---------------------------------------------------------------------------\n91\t//\n92\t// The C code performs plain `int` arithmetic; signed overflow is UB in C but in\n93\t// practice gcc/clang emit two's-complement wrapping instructions.  `wrapping_*`\n94\t// reproduces exactly what the compiled C does (and never panics).\n95\t\n96\t/// `int add_operation(int a, int b, int unused1, int unused2)`\n97\t#[unsafe(no_mangle)]\n98\tpub extern \"C\" fn add_operation(a: c_int, b: c_int, _unused1: c_int, _unused2: c_int) -> c_int {\n99\t    a.wrapping_add(b)\n100\t}\n101\t\n102\t/// `int multiply_operation(int a, int b, int unused1, int unused2)`\n103\t#[unsafe(no_mangle)]\n104\tpub extern \"C\" fn multiply_operation(a: c_int, b: c_int, _unused1: c_int, _unused2: c_int) -> c_int {\n105\t    a.wrapping_mul(b)\n106\t}\n107\t\n108\t/// `int subtract_operation(int a, int b, int unused1, int unused2)`\n109\t#[unsafe(no_mangle)]\n110\tpub extern \"C\" fn subtract_operation(a: c_int, b: c_int, _unused1: c_int, _unused2: c_int) -> c_int {\n111\t    a.wrapping_sub(b)\n112\t}\n113\t\n114\t/// `int modulo_operation(int a, int b, int unused1, int unused2)`\n115\t///\n116\t/// Keeps the `b == 0` guard in front, exactly as the C does.\n117\t#[unsafe(no_mangle)]\n118\tpub extern \"C\" fn modulo_operation(a: c_int, b: c_int, _unused1: c_int, _unused2: c_int) -> c_int {\n119\t    if b == 0 {\n120\t        return 0;\n121\t    }\n122\t    // `wrapping_rem` matches the hardware behaviour for INT_MIN % -1 (== 0)\n123\t    // without panicking.\n124\t    a.wrapping_rem(b)\n125\t}\n126\t\n127\t// ---------------------------------------------------------------------------\n128\t// Double -> int conversion\n129\t// ---------------------------------------------------------------------------\n130\t\n131\t/// ```c\n132\t/// int safe_double_to_int(double d) {\n133\t///     if (d >= (double)INT32_MAX) return INT32_MAX;\n134\t///     if (d <= (double)INT32_MIN) return INT32_MIN;\n135\t///     if (d != d) return 0;\n136\t///     return (int)d;\n137\t/// }\n138\t/// ```\n139\t///\n140\t/// The order of the checks is preserved verbatim: NaN fails both relational\n141\t/// tests (they are always false) and is therefore caught by the `d != d` test.\n142\t#[unsafe(no_mangle)]\n143\tpub extern \"C\" fn safe_double_to_int(d: c_double) -> c_int {\n144\t    if d >= i32::MAX as c_double {\n145\t        return i32::MAX;\n146\t    }\n147\t    if d <= i32::MIN as c_double {\n148\t        return i32::MIN;\n149\t    }\n150\t    if d != d {\n151\t        return 0;\n152\t    }\n153\t    // Here `d` is strictly inside (INT32_MIN, INT32_MAX), so the saturating\n154\t    // Rust cast performs exactly the same truncation-toward-zero as C.\n155\t    d as c_int\n156\t}\n157\t\n158\t/// `int compute_scaled_value(int base, double scale_factor)`\n159\t#[unsafe(no_mangle)]\n160\tpub extern \"C\" fn compute_scaled_value(base: c_int, scale_factor: c_double) -> c_int {\n161\t    let scaled = base as c_double * scale_factor;\n162\t    safe_double_to_int(scaled)\n163\t}\n164\t\n165\t// ---------------------------------------------------------------------------\n166\t// ResultArray helpers\n167\t// ---------------------------------------------------------------------------\n168\t\n169\t/// ```c\n170\t/// int compare_results_in_array(ResultArray *arr, int idx1, int idx2) {\n171\t///     if (idx1 >= arr->count || idx2 >= arr->count) return 0;\n172\t///     Result *ptr1 = &arr->data[idx1];\n173\t///     Result *ptr2 = &arr->data[idx2];\n174\t///     if (ptr1 < ptr2) return -1;\n175\t///     else if (ptr1 > ptr2) return 1;\n176\t///     return 0;\n177\t/// }\n178\t/// ```\n179\t///\n180\t/// Note the C code only bounds-checks the *upper* limit (negative indices are\n181\t/// accepted, as in the original); the comparison is done on the *addresses* of\n182\t/// the elements, which is monotonic in the index.  This bug-for-bug behaviour\n183\t/// is retained by comparing the computed addresses.\n184\t#[unsafe(no_mangle)]\n185\tpub unsafe extern \"C\" fn compare_results_in_array(\n186\t    arr: *mut ResultArray,\n187\t    idx1: c_int,\n188\t    idx2: c_int,\n189\t) -> c_int {\n190\t    if idx1 >= (*arr).count || idx2 >= (*arr).count {\n191\t        return 0;\n192\t    }\n193\t\n194\t    let base: *mut Result = (*arr).data.as_mut_ptr();\n195\t    // `wrapping_offset` keeps out-of-range indices from being insta-UB while\n196\t    // producing the very same address arithmetic the C compiler emits.\n197\t    let ptr1: *mut Result = base.wrapping_offset(idx1 as isize);\n198\t    let ptr2: *mut Result = base.wrapping_offset(idx2 as isize);\n199\t\n200\t    if ptr1 < ptr2 {\n201\t        -1\n202\t    } else if ptr1 > ptr2 {\n203\t        1\n204\t    } else {\n205\t        0\n206\t    }\n207\t}\n208\t\n209\t/// ```c\n210\t/// void init_result_array(ResultArray *arr, int values[], int count) {\n211\t///     arr->count = count < 10 ? count : 10;\n212\t///     for (int i = 0; i < arr->count; i++) {\n213\t///         arr->data[i] = (Result){ .value = values[i],\n214\t///                                  .scaled = (double)values[i] * 1.5,\n215\t///                                  .rank = i };\n216\t///     }\n217\t/// }\n218\t/// ```\n219\t#[unsafe(no_mangle)]\n220\tpub unsafe extern \"C\" fn init_result_array(\n221\t    arr: *mut ResultArray,\n222\t    values: *mut c_int,\n223\t    count: c_int,\n224\t) {\n225\t    (*arr).count = if count < 10 { count } else { 10 };\n226\t\n227\t    let base: *mut Result = (*arr).data.as_mut_ptr();\n228\t    let mut i: c_int = 0;\n229\t    // The C loop re-reads `arr->count` on every iteration; nothing in the body\n230\t    // modifies it, so a plain comparison against the stored value is exact.\n231\t    while i < (*arr).count {\n232\t        let v: c_int = *values.wrapping_offset(i as isize);\n233\t        *base.wrapping_offset(i as isize) = Result {\n234\t            value: v,\n235\t            scaled: v as c_double * 1.5,\n236\t            rank: i,\n237\t        };\n238\t        i = i.wrapping_add(1);\n239\t    }\n240\t}\n241\t\n242\t/// ```c\n243\t/// int process_with_foreach(ResultArray *arr, operation_func op) {\n244\t///     int total = 0;\n245\t///     Result *item;\n246\t///     FOREACH(item, arr->data, arr->count) {\n247\t///         int result = op(item->value, item->rank, 0, 0);\n248\t///         total += result;\n249\t///         double temp = (double)result * 0.75;\n250\t///         item->scaled = temp;\n251\t///         item->value = safe_double_to_int(temp);\n252\t///     }\n253\t///     return total;\n254\t/// }\n255\t/// ```\n256\t///\n257\t/// The `FOREACH` macro expands to\n258\t///\n259\t/// ```c\n260\t/// for (int keep = 1, count_iter = 0, size = (count);\n261\t///      keep && count_iter != size;\n262\t///      keep = !keep, count_iter++)\n263\t///   for (item = (array) + count_iter; keep; keep = !keep)\n264\t/// ```\n265\t///\n266\t/// i.e. `size` is evaluated exactly once, the loop terminates on `!=` (not\n267\t/// `<`), and `item` walks `arr->data` element by element.  The `keep` flag only\n268\t/// exists so that the inner `for` runs the body once; it does not affect the\n269\t/// visible semantics.\n270\t#[unsafe(no_mangle)]\n271\tpub unsafe extern \"C\" fn process_with_foreach(arr: *mut ResultArray, op: operation_func) -> c_int {\n272\t    let mut total: c_int = 0;\n273\t\n274\t    let base: *mut Result = (*arr).data.as_mut_ptr();\n275\t    let size: c_int = (*arr).count; // evaluated once, as in the macro\n276\t    let op = op.unwrap_unchecked(); // C would call through the raw pointer\n277\t\n278\t    let mut count_iter: c_int = 0;\n279\t    while count_iter != size {\n280\t        let item: *mut Result = base.wrapping_offset(count_iter as isize);\n281\t\n282\t        let result: c_int = op((*item).value, (*item).rank, 0, 0);\n283\t        total = total.wrapping_add(result);\n284\t\n285\t        let temp: c_double = result as c_double * 0.75;\n286\t        (*item).scaled = temp;\n287\t        (*item).value = safe_double_to_int(temp);\n288\t\n289\t        count_iter = count_iter.wrapping_add(1);\n290\t    }\n291\t\n292\t    total\n293\t}\n294\t\n295\t/// ```c\n296\t/// int compute_weighted_sum(ResultArray *arr) {\n297\t///     int sum = 0;\n298\t///     for (int i = 0; i < arr->count; i++) {\n299\t///         Result *current = &arr->data[i];\n300\t///         Result *base = &arr->data[0];\n301\t///         int weight = (current > base) ? (int)(current - base) : 1;\n302\t///         double weighted = (double)current->value * (double)weight * 0.8;\n303\t///         sum += safe_double_to_int(weighted);\n304\t///     }\n305\t///     return sum;\n306\t/// }\n307\t/// ```\n308\t///\n309\t/// `current - base` is a pointer difference in *elements*, i.e. `i`; for `i == 0`\n310\t/// the pointers are equal so the weight is 1 (not 0) — preserved as-is.\n311\t#[unsafe(no_mangle)]\n312\tpub unsafe extern \"C\" fn compute_weighted_sum(arr: *mut ResultArray) -> c_int {\n313\t    let mut sum: c_int = 0;\n314\t\n315\t    let mut i: c_int = 0;\n316\t    while i < (*arr).count {\n317\t        let base: *mut Result = (*arr).data.as_mut_ptr();\n318\t        let current: *mut Result = base.wrapping_offset(i as isize);\n319\t\n320\t        let weight: c_int = if current > base {\n321\t            current.offset_from(base) as c_int\n322\t        } else {\n323\t            1\n324\t        };\n325\t\n326\t        // Evaluation order matters for bit-exact floating point:\n327\t        // ((double)value * (double)weight) * 0.8\n328\t        let weighted: c_double = (*current).value as c_double * weight as c_double * 0.8;\n329\t        sum = sum.wrapping_add(safe_double_to_int(weighted));\n330\t\n331\t        i = i.wrapping_add(1);\n332\t    }\n333\t\n334\t    sum\n335\t}\n336\t\n337\t// ---------------------------------------------------------------------------\n338\t// Public entry point\n339\t// ---------------------------------------------------------------------------\n340\t\n341\t/// ```c\n342\t/// int arrayfunc(int param1, int param2, int param3, int param4);\n343\t/// ```\n344\t#[unsafe(no_mangle)]\n345\tpub extern \"C\" fn arrayfunc(\n346\t    param1: c_int,\n347\t    param2: c_int,\n348\t    param3: c_int,\n349\t    param4: c_int,\n350\t) -> c_int {\n351\t    let operations: [operation_func; 4] = [\n352\t        Some(add_operation_shim),\n353\t        Some(multiply_operation_shim),\n354\t        Some(subtract_operation_shim),\n355\t        Some(modulo_operation_shim),\n356\t    ];\n357\t\n358\t    let mut values: [c_int; 8] = [\n359\t        param1,\n360\t        param2,\n361\t        param3,\n362\t        param4,\n363\t        param1.wrapping_add(param2),\n364\t        param2.wrapping_sub(param3),\n365\t        param3.wrapping_mul(2),\n366\t        // `param4 / 2` truncates toward zero (the divisor is a constant 2, so\n367\t        // the INT_MIN / -1 trap case cannot occur).\n368\t        (param4 / 2).wrapping_add(1),\n369\t    ];\n370\t\n371\t    // `ResultArray arr = {.count = 0};` zero-initialises every other member.\n372\t    let mut arr = ResultArray {\n373\t        data: [Result {\n374\t            value: 0,\n375\t            scaled: 0.0,\n376\t            rank: 0,\n377\t        }; 10],\n378\t        count: 0,\n379\t    };\n380\t\n381\t    unsafe {\n382\t        init_result_array(&mut arr, values.as_mut_ptr(), 8);\n383\t\n384\t        let mut result: c_int = 0;\n385\t\n386\t        let mut i: c_int = 0;\n387\t        while i < 4 {\n388\t            result = result.wrapping_add(process_with_foreach(&mut arr, operations[i as usize]));\n389\t            i += 1;\n390\t        }\n391\t\n392\t        result = result.wrapping_add(compute_weighted_sum(&mut arr));\n393\t\n394\t        let mut i: c_int = 0;\n395\t        while i < arr.count.wrapping_sub(1) {\n396\t            let cmp = compare_results_in_array(&mut arr, i, i.wrapping_add(1));\n397\t            result = result.wrapping_add(cmp);\n398\t            i = i.wrapping_add(1);\n399\t        }\n400\t\n401\t        let final_scale: c_double = result as c_double * 0.333;\n402\t        result = safe_double_to_int(final_scale);\n403\t\n404\t        result\n405\t    }\n406\t}\n407\t\n408\t// ---------------------------------------------------------------------------\n409\t// `unsafe extern \"C\"` shims\n410\t//\n411\t// `operation_func` is an `unsafe extern \"C\" fn` pointer type (so that it can\n412\t// model an arbitrary pointer received from C), while the four exported\n413\t// operations are safe `extern \"C\" fn`s.  These zero-cost shims bridge the two;\n414\t// they are `#[inline]` and never exported, so the ABI is unaffected.\n415\t// ---------------------------------------------------------------------------\n416\t\n417\t#[inline(always)]\n418\tunsafe extern \"C\" fn add_operation_shim(a: c_int, b: c_int, u1: c_int, u2: c_int) -> c_int {\n419\t    add_operation(a, b, u1, u2)\n420\t}\n421\t\n422\t#[inline(always)]\n423\tunsafe extern \"C\" fn multiply_operation_shim(a: c_int, b: c_int, u1: c_int, u2: c_int) -> c_int {\n424\t    multiply_operation(a, b, u1, u2)\n425\t}\n426\t\n427\t#[inline(always)]\n428\tunsafe extern \"C\" fn subtract_operation_shim(a: c_int, b: c_int, u1: c_int, u2: c_int) -> c_int {\n429\t    subtract_operation(a, b, u1, u2)\n430\t}\n431\t\n432\t#[inline(always)]\n433\tunsafe extern \"C\" fn modulo_operation_shim(a: c_int, b: c_int, u1: c_int, u2: c_int) -> c_int {\n434\t    modulo_operation(a, b, u1, u2)\n435\t}\n436\t"}]},"parent_tool_use_id":null,"session_id":"03c5f30a-92c3-4d93-826d-e222e5e8b692","uuid":"7fa2b82b-761a-493c-b0de-5e4c496a8aa4","timestamp":"2026-09-05T13:01:26.925Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-ULEAUu/translation/src/lib.rs","content":"// Copyright 2025 MIT Lincoln Laboratory\n// Permission is hereby granted, free of charge,\n// to any person obtaining a copy of this software\n// and associated documentation files (the \"Software\"),\n// to deal in the Software without restriction,\n// including without limitation the rights to use, copy,\n// modify, merge, publish, distribute, sublicense,\n// and/or sell copies of the Software,\n// and to permit persons to whom the Software is furnished to do so,\n// subject to the following conditions:\n\n// The above copyright notice and this permission notice\n// shall be included in all copies or substantial portions of the Software.\n\n// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n// THE WARRANTIES OF MERCHANTABILITY,\n// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n\n//! Rust translation of `c_src/src/lib.c`.\n//!\n//! The C translation unit contains no `static` functions, so every function it\n//! defines is part of the shared library's public ABI:\n//!\n//! * `add_operation`\n//! * `multiply_operation`\n//! * `subtract_operation`\n//! * `modulo_operation`\n//! * `safe_double_to_int`\n//! * `compute_scaled_value`\n//! * `compare_results_in_array`\n//! * `init_result_array`\n//! * `process_with_foreach`\n//! * `compute_weighted_sum`\n//! * `arrayfunc`\n//!\n//! All of them are re-exported here with identical linker names, signatures and\n//! (bug-for-bug) behaviour.\n\n#![allow(non_camel_case_types)]\n\nuse std::os::raw::{c_double, c_int};\n\n/// `typedef int (*operation_func)(int a, int b, int unused1, int unused2);`\n///\n/// Modelled as an `Option<extern \"C\" fn ...>` so that a NULL function pointer\n/// coming from C can be represented; the ABI is identical to a bare C function\n/// pointer thanks to the null-pointer optimization.\npub type operation_func =\n    Option<unsafe extern \"C\" fn(a: c_int, b: c_int, unused1: c_int, unused2: c_int) -> c_int>;\n\n/// ```c\n/// typedef struct {\n///     int value;\n///     double scaled;\n///     int rank;\n/// } Result;\n/// ```\n///\n/// sizeof == 24, offsets: value @ 0, scaled @ 8, rank @ 16.\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct Result {\n    pub value: c_int,\n    pub scaled: c_double,\n    pub rank: c_int,\n}\n\n/// ```c\n/// typedef struct {\n///     Result data[10];\n///     int count;\n/// } ResultArray;\n/// ```\n///\n/// sizeof == 248, offsets: data @ 0, count @ 240.\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct ResultArray {\n    pub data: [Result; 10],\n    pub count: c_int,\n}\n\n// ---------------------------------------------------------------------------\n// Arithmetic operations\n// ---------------------------------------------------------------------------\n//\n// The C code performs plain `int` arithmetic; signed overflow is UB in C but in\n// practice gcc/clang emit two's-complement wrapping instructions.  `wrapping_*`\n// reproduces exactly what the compiled C does (and never panics).\n\n/// `int add_operation(int a, int b, int unused1, int unused2)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn add_operation(a: c_int, b: c_int, _unused1: c_int, _unused2: c_int) -> c_int {\n    a.wrapping_add(b)\n}\n\n/// `int multiply_operation(int a, int b, int unused1, int unused2)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn multiply_operation(a: c_int, b: c_int, _unused1: c_int, _unused2: c_int) -> c_int {\n    a.wrapping_mul(b)\n}\n\n/// `int subtract_operation(int a, int b, int unused1, int unused2)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn subtract_operation(a: c_int, b: c_int, _unused1: c_int, _unused2: c_int) -> c_int {\n    a.wrapping_sub(b)\n}\n\n/// `int modulo_operation(int a, int b, int unused1, int unused2)`\n///\n/// Keeps the `b == 0` guard in front, exactly as the C does.\n#[unsafe(no_mangle)]\npub extern \"C\" fn modulo_operation(a: c_int, b: c_int, _unused1: c_int, _unused2: c_int) -> c_int {\n    if b == 0 {\n        return 0;\n    }\n    // `wrapping_rem` matches the hardware behaviour for INT_MIN % -1 (== 0)\n    // without panicking.\n    a.wrapping_rem(b)\n}\n\n// ---------------------------------------------------------------------------\n// Double -> int conversion\n// ---------------------------------------------------------------------------\n\n/// ```c\n/// int safe_double_to_int(double d) {\n///     if (d >= (double)INT32_MAX) return INT32_MAX;\n///     if (d <= (double)INT32_MIN) return INT32_MIN;\n///     if (d != d) return 0;\n///     return (int)d;\n/// }\n/// ```\n///\n/// The order of the checks is preserved verbatim: NaN fails both relational\n/// tests (they are always false) and is therefore caught by the `d != d` test.\n#[unsafe(no_mangle)]\npub extern \"C\" fn safe_double_to_int(d: c_double) -> c_int {\n    if d >= i32::MAX as c_double {\n        return i32::MAX;\n    }\n    if d <= i32::MIN as c_double {\n        return i32::MIN;\n    }\n    if d != d {\n        return 0;\n    }\n    // Here `d` is strictly inside (INT32_MIN, INT32_MAX), so the saturating\n    // Rust cast performs exactly the same truncation-toward-zero as C.\n    d as c_int\n}\n\n/// `int compute_scaled_value(int base, double scale_factor)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn compute_scaled_value(base: c_int, scale_factor: c_double) -> c_int {\n    let scaled = base as c_double * scale_factor;\n    safe_double_to_int(scaled)\n}\n\n// ---------------------------------------------------------------------------\n// ResultArray helpers\n// ---------------------------------------------------------------------------\n\n/// ```c\n/// int compare_results_in_array(ResultArray *arr, int idx1, int idx2) {\n///     if (idx1 >= arr->count || idx2 >= arr->count) return 0;\n///     Result *ptr1 = &arr->data[idx1];\n///     Result *ptr2 = &arr->data[idx2];\n///     if (ptr1 < ptr2) return -1;\n///     else if (ptr1 > ptr2) return 1;\n///     return 0;\n/// }\n/// ```\n///\n/// Note the C code only bounds-checks the *upper* limit (negative indices are\n/// accepted, as in the original); the comparison is done on the *addresses* of\n/// the elements, which is monotonic in the index.  This bug-for-bug behaviour\n/// is retained by comparing the computed addresses.\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn compare_results_in_array(\n    arr: *mut ResultArray,\n    idx1: c_int,\n    idx2: c_int,\n) -> c_int {\n    if idx1 >= (*arr).count || idx2 >= (*arr).count {\n        return 0;\n    }\n\n    let base: *mut Result = (*arr).data.as_mut_ptr();\n    // `wrapping_offset` keeps out-of-range indices from being insta-UB while\n    // producing the very same address arithmetic the C compiler emits.\n    let ptr1: *mut Result = base.wrapping_offset(idx1 as isize);\n    let ptr2: *mut Result = base.wrapping_offset(idx2 as isize);\n\n    if ptr1 < ptr2 {\n        -1\n    } else if ptr1 > ptr2 {\n        1\n    } else {\n        0\n    }\n}\n\n/// ```c\n/// void init_result_array(ResultArray *arr, int values[], int count) {\n///     arr->count = count < 10 ? count : 10;\n///     for (int i = 0; i < arr->count; i++) {\n///         arr->data[i] = (Result){ .value = values[i],\n///                                  .scaled = (double)values[i] * 1.5,\n///                                  .rank = i };\n///     }\n/// }\n/// ```\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn init_result_array(\n    arr: *mut ResultArray,\n    values: *mut c_int,\n    count: c_int,\n) {\n    (*arr).count = if count < 10 { count } else { 10 };\n\n    let base: *mut Result = (*arr).data.as_mut_ptr();\n    let mut i: c_int = 0;\n    // The C loop re-reads `arr->count` on every iteration; nothing in the body\n    // modifies it, so a plain comparison against the stored value is exact.\n    while i < (*arr).count {\n        let v: c_int = *values.wrapping_offset(i as isize);\n        *base.wrapping_offset(i as isize) = Result {\n            value: v,\n            scaled: v as c_double * 1.5,\n            rank: i,\n        };\n        i = i.wrapping_add(1);\n    }\n}\n\n/// ```c\n/// int process_with_foreach(ResultArray *arr, operation_func op) {\n///     int total = 0;\n///     Result *item;\n///     FOREACH(item, arr->data, arr->count) {\n///         int result = op(item->value, item->rank, 0, 0);\n///         total += result;\n///         double temp = (double)result * 0.75;\n///         item->scaled = temp;\n///         item->value = safe_double_to_int(temp);\n///     }\n///     return total;\n/// }\n/// ```\n///\n/// The `FOREACH` macro expands to\n///\n/// ```c\n/// for (int keep = 1, count_iter = 0, size = (count);\n///      keep && count_iter != size;\n///      keep = !keep, count_iter++)\n///   for (item = (array) + count_iter; keep; keep = !keep)\n/// ```\n///\n/// i.e. `size` is evaluated exactly once, the loop terminates on `!=` (not\n/// `<`), and `item` walks `arr->data` element by element.  The `keep` flag only\n/// exists so that the inner `for` runs the body once; it does not affect the\n/// visible semantics.\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn process_with_foreach(arr: *mut ResultArray, op: operation_func) -> c_int {\n    let mut total: c_int = 0;\n\n    let base: *mut Result = (*arr).data.as_mut_ptr();\n    let size: c_int = (*arr).count; // evaluated once, as in the macro\n    let op = op.unwrap_unchecked(); // C would call through the raw pointer\n\n    let mut count_iter: c_int = 0;\n    while count_iter != size {\n        let item: *mut Result = base.wrapping_offset(count_iter as isize);\n\n        let result: c_int = op((*item).value, (*item).rank, 0, 0);\n        total = total.wrapping_add(result);\n\n        let temp: c_double = result as c_double * 0.75;\n        (*item).scaled = temp;\n        (*item).value = safe_double_to_int(temp);\n\n        count_iter = count_iter.wrapping_add(1);\n    }\n\n    total\n}\n\n/// ```c\n/// int compute_weighted_sum(ResultArray *arr) {\n///     int sum = 0;\n///     for (int i = 0; i < arr->count; i++) {\n///         Result *current = &arr->data[i];\n///         Result *base = &arr->data[0];\n///         int weight = (current > base) ? (int)(current - base) : 1;\n///         double weighted = (double)current->value * (double)weight * 0.8;\n///         sum += safe_double_to_int(weighted);\n///     }\n///     return sum;\n/// }\n/// ```\n///\n/// `current - base` is a pointer difference in *elements*, i.e. `i`; for `i == 0`\n/// the pointers are equal so the weight is 1 (not 0) — preserved as-is.\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn compute_weighted_sum(arr: *mut ResultArray) -> c_int {\n    let mut sum: c_int = 0;\n\n    let mut i: c_int = 0;\n    while i < (*arr).count {\n        let base: *mut Result = (*arr).data.as_mut_ptr();\n        let current: *mut Result = base.wrapping_offset(i as isize);\n\n        let weight: c_int = if current > base {\n            current.offset_from(base) as c_int\n        } else {\n            1\n        };\n\n        // Evaluation order matters for bit-exact floating point:\n        // ((double)value * (double)weight) * 0.8\n        let weighted: c_double = (*current).value as c_double * weight as c_double * 0.8;\n        sum = sum.wrapping_add(safe_double_to_int(weighted));\n\n        i = i.wrapping_add(1);\n    }\n\n    sum\n}\n\n// ---------------------------------------------------------------------------\n// Public entry point\n// ---------------------------------------------------------------------------\n\n/// ```c\n/// int arrayfunc(int param1, int param2, int param3, int param4);\n/// ```\n#[unsafe(no_mangle)]\npub extern \"C\" fn arrayfunc(\n    param1: c_int,\n    param2: c_int,\n    param3: c_int,\n    param4: c_int,\n) -> c_int {\n    let operations: [operation_func; 4] = [\n        Some(add_operation_shim),\n        Some(multiply_operation_shim),\n        Some(subtract_operation_shim),\n        Some(modulo_operation_shim),\n    ];\n\n    let mut values: [c_int; 8] = [\n        param1,\n        param2,\n        param3,\n        param4,\n        param1.wrapping_add(param2),\n        param2.wrapping_sub(param3),\n        param3.wrapping_mul(2),\n        // `param4 / 2` truncates toward zero (the divisor is a constant 2, so\n        // the INT_MIN / -1 trap case cannot occur).\n        (param4 / 2).wrapping_add(1),\n    ];\n\n    // `ResultArray arr = {.count = 0};` zero-initialises every other member.\n    let mut arr = ResultArray {\n        data: [Result {\n            value: 0,\n            scaled: 0.0,\n            rank: 0,\n        }; 10],\n        count: 0,\n    };\n\n    unsafe {\n        init_result_array(&mut arr, values.as_mut_ptr(), 8);\n\n        let mut result: c_int = 0;\n\n        let mut i: c_int = 0;\n        while i < 4 {\n            result = result.wrapping_add(process_with_foreach(&mut arr, operations[i as usize]));\n            i += 1;\n        }\n\n        result = result.wrapping_add(compute_weighted_sum(&mut arr));\n\n        let mut i: c_int = 0;\n        while i < arr.count.wrapping_sub(1) {\n            let cmp = compare_results_in_array(&mut arr, i, i.wrapping_add(1));\n            result = result.wrapping_add(cmp);\n            i = i.wrapping_add(1);\n        }\n\n        let final_scale: c_double = result as c_double * 0.333;\n        result = safe_double_to_int(final_scale);\n\n        result\n    }\n}\n\n// ---------------------------------------------------------------------------\n// `unsafe extern \"C\"` shims\n//\n// `operation_func` is an `unsafe extern \"C\" fn` pointer type (so that it can\n// model an arbitrary pointer received from C), while the four exported\n// operations are safe `extern \"C\" fn`s.  These zero-cost shims bridge the two;\n// they are `#[inline]` and never exported, so the ABI is unaffected.\n// ---------------------------------------------------------------------------\n\n#[inline(always)]\nunsafe extern \"C\" fn add_operation_shim(a: c_int, b: c_int, u1: c_int, u2: c_int) -> c_int {\n    add_operation(a, b, u1, u2)\n}\n\n#[inline(always)]\nunsafe extern \"C\" fn multiply_operation_shim(a: c_int, b: c_int, u1: c_int, u2: c_int) -> c_int {\n    multiply_operation(a, b, u1, u2)\n}\n\n#[inline(always)]\nunsafe extern \"C\" fn subtract_operation_shim(a: c_int, b: c_int, u1: c_int, u2: c_int) -> c_int {\n    subtract_operation(a, b, u1, u2)\n}\n\n#[inline(always)]\nunsafe extern \"C\" fn modulo_operation_shim(a: c_int, b: c_int, u1: c_int, u2: c_int) -> c_int {\n    modulo_operation(a, b, u1, u2)\n}\n","numLines":436,"startLine":1,"totalLines":436}}}
