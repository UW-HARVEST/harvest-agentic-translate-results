ResultArray *arr, operation_func op) {\n122\t    int total = 0;\n123\t    Result *item;\n124\t\n125\t    FOREACH(item, arr->data, arr->count) {\n126\t        int result = op(item->value, item->rank, 0, 0);\n127\t        total += result;\n128\t\n129\t        double temp = (double)result * 0.75;\n130\t        item->scaled = temp;\n131\t        item->value = safe_double_to_int(temp);\n132\t    }\n133\t\n134\t    return total;\n135\t}\n136\t\n137\tint compute_weighted_sum(ResultArray *arr) {\n138\t    int sum = 0;\n139\t\n140\t    for (int i = 0; i < arr->count; i++) {\n141\t        Result *current = &arr->data[i];\n142\t        Result *base = &arr->data[0];\n143\t\n144\t        int weight = (current > base) ? (int)(current - base) : 1;\n145\t\n146\t        double weighted = (double)current->value * (double)weight * 0.8;\n147\t        sum += safe_double_to_int(weighted);\n148\t    }\n149\t\n150\t    return sum;\n151\t}\n152\t\n153\tint arrayfunc(int param1, int param2, int param3, int param4) {\n154\t    operation_func operations[] = {\n155\t        add_operation,\n156\t        multiply_operation,\n157\t        subtract_operation,\n158\t        modulo_operation\n159\t    };\n160\t\n161\t    int values[] = {param1, param2, param3, param4,\n162\t                    param1 + param2, param2 - param3,\n163\t                    param3 * 2, param4 / 2 + 1};\n164\t\n165\t    ResultArray arr = {.count = 0};\n166\t    init_result_array(&arr, values, 8);\n167\t\n168\t    int result = 0;\n169\t\n170\t    for (int i = 0; i < 4; i++) {\n171\t        result += process_with_foreach(&arr, operations[i]);\n172\t    }\n173\t\n174\t    result += compute_weighted_sum(&arr);\n175\t\n176\t    for (int i = 0; i < arr.count - 1; i++) {\n177\t        int cmp = compare_results_in_array(&arr, i, i + 1);\n178\t        result += cmp;\n179\t    }\n180\t\n181\t    double final_scale = (double)result * 0.333;\n182\t    result = safe_double_to_int(final_scale);\n183\t\n184\t    return result;\n185\t}\n1