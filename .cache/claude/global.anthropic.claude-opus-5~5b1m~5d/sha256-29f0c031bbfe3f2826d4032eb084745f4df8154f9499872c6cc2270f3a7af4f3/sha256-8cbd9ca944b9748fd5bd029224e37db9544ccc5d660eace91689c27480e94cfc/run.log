{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_015R7aXa48v6q3qGxt3kFP3u","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/`.\n2\t//!\n3\t//! The C library (`c_src/src/lib.c` + `c_src/include/lib.h`) is a small 2D\n4\t//! collision-detection library (a cut-down `cute_c2`). Every function in the C\n5\t//! translation unit has external linkage, so all ten of them appear in the\n6\t//! shared object's dynamic symbol table and must be re-exported here with\n7\t//! identical names, signatures and semantics:\n8\t//!\n9\t//! ```text\n10\t//! c2V  c2Maxv  c2Minv  c2Clampv  c2Sub  c2Dot\n11\t//! c2CircletoCircle  c2CircletoAABB  c2AABBtoAABB  collided\n12\t//! ```\n13\t//!\n14\t//! Notes on bit-exactness:\n15\t//! * All arithmetic is done in `f32` exactly as in the C source (single\n16\t//!   precision throughout on the SysV x86-64 ABI, no double promotion).\n17\t//! * `c2Maxv`/`c2Minv` are written with explicit `>` / `<` ternary comparisons\n18\t//!   rather than `f32::max`/`f32::min`, because the C macros\n19\t//!   `(a > b ? a : b)` / `(a < b ? a : b)` propagate the *second* operand when\n20\t//!   an operand is NaN and always return the second operand for `±0.0`,\n21\t//!   whereas `f32::max`/`f32::min` are NaN-suppressing. Reproducing the C\n22\t//!   behaviour requires the raw comparison (this is what gcc lowers to\n23\t//!   `maxss`/`minss`).\n24\t//! * Boolean results are converted with `as c_int`, yielding exactly the 1/0\n25\t//!   that C's relational operators produce.\n26\t\n27\t#![allow(non_snake_case)]\n28\t#![allow(non_camel_case_types)]\n29\t\n30\tuse std::ffi::{c_int, c_uint, c_void};\n31\t\n32\t// ---------------------------------------------------------------------------\n33\t// Types\n34\t// ---------------------------------------------------------------------------\n35\t\n36\t/// `typedef enum { C2_TYPE_CIRCLE, C2_TYPE_AABB } C2_TYPE;`\n37\t///\n38\t/// All enumerators are non-negative, so gcc gives the enum an `unsigned int`\n39\t/// underlying type; it is passed in a 32-bit register either way.\n40\tpub type C2_TYPE = c_uint;\n41\t\n42\tpub const C2_TYPE_CIRCLE: C2_TYPE = 0;\n43\tpub const C2_TYPE_AABB: C2_TYPE = 1;\n44\t\n45\t/// `typedef struct c2v { float x; float y; } c2v;`\n46\t///\n47\t/// 8 bytes, one SSE eightbyte: passed/returned packed in the low half of a\n48\t/// single xmm register.\n49\t#[repr(C)]\n50\t#[derive(Clone, Copy)]\n51\tpub struct c2v {\n52\t    pub x: f32,\n53\t    pub y: f32,\n54\t}\n55\t\n56\t/// `typedef struct c2Circle { c2v p; float r; } c2Circle;`\n57\t///\n58\t/// 12 bytes, two SSE eightbytes: `p` in xmm(n), `r` in xmm(n+1).\n59\t#[repr(C)]\n60\t#[derive(Clone, Copy)]\n61\tpub struct c2Circle {\n62\t    pub p: c2v,\n63\t    pub r: f32,\n64\t}\n65\t\n66\t/// `typedef struct c2AABB { c2v min; c2v max; } c2AABB;`\n67\t///\n68\t/// 16 bytes, two SSE eightbytes: `min` in xmm(n), `max` in xmm(n+1).\n69\t#[repr(C)]\n70\t#[derive(Clone, Copy)]\n71\tpub struct c2AABB {\n72\t    pub min: c2v,\n73\t    pub max: c2v,\n74\t}\n75\t\n76\t// ---------------------------------------------------------------------------\n77\t// Vector helpers\n78\t// ---------------------------------------------------------------------------\n79\t\n80\t/// ```c\n81\t/// c2v c2V(float x, float y) { c2v a; a.x = x; a.y = y; return a; }\n82\t/// ```\n83\t#[unsafe(no_mangle)]\n84\tpub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n85\t    let mut a = c2v { x: 0.0, y: 0.0 };\n86\t    a.x = x;\n87\t    a.y = y;\n88\t    a\n89\t}\n90\t\n91\t/// ```c\n92\t/// c2v c2Maxv(c2v a, c2v b) {\n93\t///     return c2V(((a.x) > (b.x) ? (a.x) : (b.x)),\n94\t///                ((a.y) > (b.y) ? (a.y) : (b.y)));\n95\t/// }\n96\t/// ```\n97\t#[unsafe(no_mangle)]\n98\tpub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n99\t    c2V(\n100\t        if a.x > b.x { a.x } else { b.x },\n101\t        if a.y > b.y { a.y } else { b.y },\n102\t    )\n103\t}\n104\t\n105\t/// ```c\n106\t/// c2v c2Minv(c2v a, c2v b) {\n107\t///     return c2V(((a.x) < (b.x) ? (a.x) : (b.x)),\n108\t///                ((a.y) < (b.y) ? (a.y) : (b.y)));\n109\t/// }\n110\t/// ```\n111\t#[unsafe(no_mangle)]\n112\tpub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n113\t    c2V(\n114\t        if a.x < b.x { a.x } else { b.x },\n115\t        if a.y < b.y { a.y } else { b.y },\n116\t    )\n117\t}\n118\t\n119\t/// ```c\n120\t/// c2v c2Clampv(c2v a, c2v lo, c2v hi) { return c2Maxv(lo, c2Minv(a, hi)); }\n121\t/// ```\n122\t#[unsafe(no_mangle)]\n123\tpub extern \"C\" fn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n124\t    c2Maxv(lo, c2Minv(a, hi))\n125\t}\n126\t\n127\t/// ```c\n128\t/// c2v c2Sub(c2v a, c2v b) { a.x -= b.x; a.y -= b.y; return a; }\n129\t/// ```\n130\t#[unsafe(no_mangle)]\n131\tpub extern \"C\" fn c2Sub(a: c2v, b: c2v) -> c2v {\n132\t    let mut a = a;\n133\t    a.x -= b.x;\n134\t    a.y -= b.y;\n135\t    a\n136\t}\n137\t\n138\t/// Quiet a NaN the way an x86 SSE arithmetic instruction does: the sign bit and\n139\t/// payload are preserved and the \"quiet\" mantissa bit (bit 22) is forced on, so\n140\t/// an sNaN such as `0x7f800001` becomes `0x7fc00001`.\n141\t#[inline]\n142\tfn quiet_nan(v: f32) -> f32 {\n143\t    f32::from_bits(v.to_bits() | 0x0040_0000)\n144\t}\n145\t\n146\t/// `mulss dst, src` — an IEEE multiply with x86's *operand-ordered* NaN\n147\t/// propagation: if the destination operand is a NaN it wins, otherwise the\n148\t/// source operand's NaN wins, otherwise the ordinary product (which yields the\n149\t/// default qNaN `0x7fc00000` for the invalid `0 * inf` case).\n150\t///\n151\t/// This is spelled out explicitly because C's `a.x * b.x` is compiled by gcc to\n152\t/// `mulss` with `a.x` as the destination, and therefore propagates `a`'s NaN\n153\t/// when *both* operands are NaNs with different payloads. LLVM considers `fmul`\n154\t/// commutative and freely swaps the operands (it emits `mulss` with `b.y` as the\n155\t/// destination), which would propagate the other payload. Handling the NaN cases\n156\t/// by hand pins the observable bit pattern to the C library's.\n157\t#[inline]\n158\tfn mulss(dst: f32, src: f32) -> f32 {\n159\t    if dst.is_nan() {\n160\t        quiet_nan(dst)\n161\t    } else if src.is_nan() {\n162\t        quiet_nan(src)\n163\t    } else {\n164\t        dst * src\n165\t    }\n166\t}\n167\t\n168\t/// `addss dst, src` — an IEEE add with x86's operand-ordered NaN propagation\n169\t/// (see [`mulss`]). The non-NaN path still produces the default qNaN for the\n170\t/// invalid `inf + (-inf)` case.\n171\t#[inline]\n172\tfn addss(dst: f32, src: f32) -> f32 {\n173\t    if dst.is_nan() {\n174\t        quiet_nan(dst)\n175\t    } else if src.is_nan() {\n176\t        quiet_nan(src)\n177\t    } else {\n178\t        dst + src\n179\t    }\n180\t}\n181\t\n182\t/// ```c\n183\t/// float c2Dot(c2v a, c2v b) { return a.x * b.x + a.y * b.y; }\n184\t/// ```\n185\t///\n186\t/// The value is bit-exact for every finite/infinite input. The one detail that\n187\t/// needs care is *which* NaN payload comes out when several operands are\n188\t/// distinct NaNs, since that depends on the `mulss`/`addss` operand order the\n189\t/// compiler happens to choose. gcc, building this very `CMakeLists.txt`\n190\t/// (which sets no `CMAKE_BUILD_TYPE`, hence no optimisation), emits:\n191\t///\n192\t/// ```text\n193\t/// movss a.x,xmm1 ; movss b.x,xmm0 ; mulss xmm0,xmm1  -> dst = a.x\n194\t/// movss a.y,xmm2 ; movss b.y,xmm0 ; mulss xmm2,xmm0  -> dst = b.y\n195\t/// addss xmm1,xmm0                                    -> dst = y product\n196\t/// ```\n197\t///\n198\t/// i.e. the x product keeps `a.x` as destination, the y product keeps `b.y`,\n199\t/// and the sum keeps the *y* product. That ordering is mirrored below.\n200\t///\n201\t/// Note that this is the one place where the C library's own behaviour is not\n202\t/// stable across compiler settings: at `-O2` gcc reassociates to\n203\t/// `dst = a.y` for the y product and `dst = x product` for the sum, which\n204\t/// yields a different NaN payload for the same inputs. Inputs containing at\n205\t/// most one distinct NaN payload (the realistic case) produce identical results\n206\t/// under either ordering.\n207\t#[unsafe(no_mangle)]\n208\tpub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n209\t    let x_product = mulss(a.x, b.x);\n210\t    let y_product = mulss(b.y, a.y);\n211\t    addss(y_product, x_product)\n212\t}\n213\t\n214\t// ---------------------------------------------------------------------------\n215\t// Collision routines\n216\t// ---------------------------------------------------------------------------\n217\t\n218\t/// ```c\n219\t/// int c2CircletoCircle(c2Circle A, c2Circle B) {\n220\t///     c2v c = c2Sub(B.p, A.p);\n221\t///     float d2 = c2Dot(c, c);\n222\t///     float r2 = A.r + B.r;\n223\t///     r2 = r2 * r2;\n224\t///     return d2 < r2;\n225\t/// }\n226\t/// ```\n227\t#[unsafe(no_mangle)]\n228\tpub extern \"C\" fn c2CircletoCircle(A: c2Circle, B: c2Circle) -> c_int {\n229\t    let c = c2Sub(B.p, A.p);\n230\t    let d2 = c2Dot(c, c);\n231\t    let mut r2 = A.r + B.r;\n232\t    r2 = r2 * r2;\n233\t    (d2 < r2) as c_int\n234\t}\n235\t\n236\t/// ```c\n237\t/// int c2CircletoAABB(c2Circle A, c2AABB B) {\n238\t///     c2v L = c2Clampv(A.p, B.min, B.max);\n239\t///     c2v ab = c2Sub(A.p, L);\n240\t///     float d2 = c2Dot(ab, ab);\n241\t///     float r2 = A.r * A.r;\n242\t///     return d2 < r2;\n243\t/// }\n244\t/// ```\n245\t#[unsafe(no_mangle)]\n246\tpub extern \"C\" fn c2CircletoAABB(A: c2Circle, B: c2AABB) -> c_int {\n247\t    let L = c2Clampv(A.p, B.min, B.max);\n248\t    let ab = c2Sub(A.p, L);\n249\t    let d2 = c2Dot(ab, ab);\n250\t    let r2 = A.r * A.r;\n251\t    (d2 < r2) as c_int\n252\t}\n253\t\n254\t/// ```c\n255\t/// int c2AABBtoAABB(c2AABB A, c2AABB B) {\n256\t///     int d0 = B.max.x < A.min.x;\n257\t///     int d1 = A.max.x < B.min.x;\n258\t///     int d2 = B.max.y < A.min.y;\n259\t///     int d3 = A.max.y < B.min.y;\n260\t///     return !(d0 | d1 | d2 | d3);\n261\t/// }\n262\t/// ```\n263\t#[unsafe(no_mangle)]\n264\tpub extern \"C\" fn c2AABBtoAABB(A: c2AABB, B: c2AABB) -> c_int {\n265\t    let d0 = (B.max.x < A.min.x) as c_int;\n266\t    let d1 = (A.max.x < B.min.x) as c_int;\n267\t    let d2 = (B.max.y < A.min.y) as c_int;\n268\t    let d3 = (A.max.y < B.min.y) as c_int;\n269\t    ((d0 | d1 | d2 | d3) == 0) as c_int\n270\t}\n271\t\n272\t/// ```c\n273\t/// int collided(const void *A, C2_TYPE typeA, const void *B, C2_TYPE typeB);\n274\t/// ```\n275\t///\n276\t/// Dispatches on the pair of shape tags, exactly reproducing the C switch\n277\t/// nest (including the `default: return 0;` arms for out-of-range tags and the\n278\t/// argument swap in the AABB-vs-circle case).\n279\t///\n280\t/// # Safety\n281\t/// `A` and `B` must point to objects of the type indicated by `typeA` /\n282\t/// `typeB`, just as the C function requires.\n283\t#[unsafe(no_mangle)]\n284\tpub unsafe extern \"C\" fn collided(\n285\t    A: *const c_void,\n286\t    typeA: C2_TYPE,\n287\t    B: *const c_void,\n288\t    typeB: C2_TYPE,\n289\t) -> c_int {\n290\t    match typeA {\n291\t        C2_TYPE_CIRCLE => match typeB {\n292\t            C2_TYPE_CIRCLE => c2CircletoCircle(\n293\t                unsafe { (A as *const c2Circle).read_unaligned() },\n294\t                unsafe { (B as *const c2Circle).read_unaligned() },\n295\t            ),\n296\t            C2_TYPE_AABB => c2CircletoAABB(\n297\t                unsafe { (A as *const c2Circle).read_unaligned() },\n298\t                unsafe { (B as *const c2AABB).read_unaligned() },\n299\t            ),\n300\t            _ => 0,\n301\t        },\n302\t        C2_TYPE_AABB => match typeB {\n303\t            C2_TYPE_CIRCLE => c2CircletoAABB(\n304\t                unsafe { (B as *const c2Circle).read_unaligned() },\n305\t                unsafe { (A as *const c2AABB).read_unaligned() },\n306\t            ),\n307\t            C2_TYPE_AABB => c2AABBtoAABB(\n308\t                unsafe { (A as *const c2AABB).read_unaligned() },\n309\t                unsafe { (B as *const c2AABB).read_unaligned() },\n310\t            ),\n311\t            _ => 0,\n312\t        },\n313\t        _ => 0,\n314\t    }\n315\t}\n316\t"}]},"parent_tool_use_id":null,"session_id":"f4262ae2-0f4e-4595-b6d5-edb6e23770da","uuid":"275ea20e-6141-4241-b0b1-5e12b6075128","timestamp":"2026-09-04T23:39:17.848Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-bvSxNh/translation/src/lib.rs","content":"//! Rust translation of the C library in `c_src/`.\n//!\n//! The C library (`c_src/src/lib.c` + `c_src/include/lib.h`) is a small 2D\n//! collision-detection library (a cut-down `cute_c2`). Every function in the C\n//! translation unit has external linkage, so all ten of them appear in the\n//! shared object's dynamic symbol table and must be re-exported here with\n//! identical names, signatures and semantics:\n//!\n//! ```text\n//! c2V  c2Maxv  c2Minv  c2Clampv  c2Sub  c2Dot\n//! c2CircletoCircle  c2CircletoAABB  c2AABBtoAABB  collided\n//! ```\n//!\n//! Notes on bit-exactness:\n//! * All arithmetic is done in `f32` exactly as in the C source (single\n//!   precision throughout on the SysV x86-64 ABI, no double promotion).\n//! * `c2Maxv`/`c2Minv` are written with explicit `>` / `<` ternary comparisons\n//!   rather than `f32::max`/`f32::min`, because the C macros\n//!   `(a > b ? a : b)` / `(a < b ? a : b)` propagate the *second* operand when\n//!   an operand is NaN and always return the second operand for `±0.0`,\n//!   whereas `f32::max`/`f32::min` are NaN-suppressing. Reproducing the C\n//!   behaviour requires the raw comparison (this is what gcc lowers to\n//!   `maxss`/`minss`).\n//! * Boolean results are converted with `as c_int`, yielding exactly the 1/0\n//!   that C's relational operators produce.\n\n#![allow(non_snake_case)]\n#![allow(non_camel_case_types)]\n\nuse std::ffi::{c_int, c_uint, c_void};\n\n// ---------------------------------------------------------------------------\n// Types\n// ---------------------------------------------------------------------------\n\n/// `typedef enum { C2_TYPE_CIRCLE, C2_TYPE_AABB } C2_TYPE;`\n///\n/// All enumerators are non-negative, so gcc gives the enum an `unsigned int`\n/// underlying type; it is passed in a 32-bit register either way.\npub type C2_TYPE = c_uint;\n\npub const C2_TYPE_CIRCLE: C2_TYPE = 0;\npub const C2_TYPE_AABB: C2_TYPE = 1;\n\n/// `typedef struct c2v { float x; float y; } c2v;`\n///\n/// 8 bytes, one SSE eightbyte: passed/returned packed in the low half of a\n/// single xmm register.\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct c2v {\n    pub x: f32,\n    pub y: f32,\n}\n\n/// `typedef struct c2Circle { c2v p; float r; } c2Circle;`\n///\n/// 12 bytes, two SSE eightbytes: `p` in xmm(n), `r` in xmm(n+1).\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct c2Circle {\n    pub p: c2v,\n    pub r: f32,\n}\n\n/// `typedef struct c2AABB { c2v min; c2v max; } c2AABB;`\n///\n/// 16 bytes, two SSE eightbytes: `min` in xmm(n), `max` in xmm(n+1).\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct c2AABB {\n    pub min: c2v,\n    pub max: c2v,\n}\n\n// ---------------------------------------------------------------------------\n// Vector helpers\n// ---------------------------------------------------------------------------\n\n/// ```c\n/// c2v c2V(float x, float y) { c2v a; a.x = x; a.y = y; return a; }\n/// ```\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n    let mut a = c2v { x: 0.0, y: 0.0 };\n    a.x = x;\n    a.y = y;\n    a\n}\n\n/// ```c\n/// c2v c2Maxv(c2v a, c2v b) {\n///     return c2V(((a.x) > (b.x) ? (a.x) : (b.x)),\n///                ((a.y) > (b.y) ? (a.y) : (b.y)));\n/// }\n/// ```\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n    c2V(\n        if a.x > b.x { a.x } else { b.x },\n        if a.y > b.y { a.y } else { b.y },\n    )\n}\n\n/// ```c\n/// c2v c2Minv(c2v a, c2v b) {\n///     return c2V(((a.x) < (b.x) ? (a.x) : (b.x)),\n///                ((a.y) < (b.y) ? (a.y) : (b.y)));\n/// }\n/// ```\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n    c2V(\n        if a.x < b.x { a.x } else { b.x },\n        if a.y < b.y { a.y } else { b.y },\n    )\n}\n\n/// ```c\n/// c2v c2Clampv(c2v a, c2v lo, c2v hi) { return c2Maxv(lo, c2Minv(a, hi)); }\n/// ```\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n    c2Maxv(lo, c2Minv(a, hi))\n}\n\n/// ```c\n/// c2v c2Sub(c2v a, c2v b) { a.x -= b.x; a.y -= b.y; return a; }\n/// ```\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Sub(a: c2v, b: c2v) -> c2v {\n    let mut a = a;\n    a.x -= b.x;\n    a.y -= b.y;\n    a\n}\n\n/// Quiet a NaN the way an x86 SSE arithmetic instruction does: the sign bit and\n/// payload are preserved and the \"quiet\" mantissa bit (bit 22) is forced on, so\n/// an sNaN such as `0x7f800001` becomes `0x7fc00001`.\n#[inline]\nfn quiet_nan(v: f32) -> f32 {\n    f32::from_bits(v.to_bits() | 0x0040_0000)\n}\n\n/// `mulss dst, src` — an IEEE multiply with x86's *operand-ordered* NaN\n/// propagation: if the destination operand is a NaN it wins, otherwise the\n/// source operand's NaN wins, otherwise the ordinary product (which yields the\n/// default qNaN `0x7fc00000` for the invalid `0 * inf` case).\n///\n/// This is spelled out explicitly because C's `a.x * b.x` is compiled by gcc to\n/// `mulss` with `a.x` as the destination, and therefore propagates `a`'s NaN\n/// when *both* operands are NaNs with different payloads. LLVM considers `fmul`\n/// commutative and freely swaps the operands (it emits `mulss` with `b.y` as the\n/// destination), which would propagate the other payload. Handling the NaN cases\n/// by hand pins the observable bit pattern to the C library's.\n#[inline]\nfn mulss(dst: f32, src: f32) -> f32 {\n    if dst.is_nan() {\n        quiet_nan(dst)\n    } else if src.is_nan() {\n        quiet_nan(src)\n    } else {\n        dst * src\n    }\n}\n\n/// `addss dst, src` — an IEEE add with x86's operand-ordered NaN propagation\n/// (see [`mulss`]). The non-NaN path still produces the default qNaN for the\n/// invalid `inf + (-inf)` case.\n#[inline]\nfn addss(dst: f32, src: f32) -> f32 {\n    if dst.is_nan() {\n        quiet_nan(dst)\n    } else if src.is_nan() {\n        quiet_nan(src)\n    } else {\n        dst + src\n    }\n}\n\n/// ```c\n/// float c2Dot(c2v a, c2v b) { return a.x * b.x + a.y * b.y; }\n/// ```\n///\n/// The value is bit-exact for every finite/infinite input. The one detail that\n/// needs care is *which* NaN payload comes out when several operands are\n/// distinct NaNs, since that depends on the `mulss`/`addss` operand order the\n/// compiler happens to choose. gcc, building this very `CMakeLists.txt`\n/// (which sets no `CMAKE_BUILD_TYPE`, hence no optimisation), emits:\n///\n/// ```text\n/// movss a.x,xmm1 ; movss b.x,xmm0 ; mulss xmm0,xmm1  -> dst = a.x\n/// movss a.y,xmm2 ; movss b.y,xmm0 ; mulss xmm2,xmm0  -> dst = b.y\n/// addss xmm1,xmm0                                    -> dst = y product\n/// ```\n///\n/// i.e. the x product keeps `a.x` as destination, the y product keeps `b.y`,\n/// and the sum keeps the *y* product. That ordering is mirrored below.\n///\n/// Note that this is the one place where the C library's own behaviour is not\n/// stable across compiler settings: at `-O2` gcc reassociates to\n/// `dst = a.y` for the y product and `dst = x product` for the sum, which\n/// yields a different NaN payload for the same inputs. Inputs containing at\n/// most one distinct NaN payload (the realistic case) produce identical results\n/// under either ordering.\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n    let x_product = mulss(a.x, b.x);\n    let y_product = mulss(b.y, a.y);\n    addss(y_product, x_product)\n}\n\n// ---------------------------------------------------------------------------\n// Collision routines\n// ---------------------------------------------------------------------------\n\n/// ```c\n/// int c2CircletoCircle(c2Circle A, c2Circle B) {\n///     c2v c = c2Sub(B.p, A.p);\n///     float d2 = c2Dot(c, c);\n///     float r2 = A.r + B.r;\n///     r2 = r2 * r2;\n///     return d2 < r2;\n/// }\n/// ```\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CircletoCircle(A: c2Circle, B: c2Circle) -> c_int {\n    let c = c2Sub(B.p, A.p);\n    let d2 = c2Dot(c, c);\n    let mut r2 = A.r + B.r;\n    r2 = r2 * r2;\n    (d2 < r2) as c_int\n}\n\n/// ```c\n/// int c2CircletoAABB(c2Circle A, c2AABB B) {\n///     c2v L = c2Clampv(A.p, B.min, B.max);\n///     c2v ab = c2Sub(A.p, L);\n///     float d2 = c2Dot(ab, ab);\n///     float r2 = A.r * A.r;\n///     return d2 < r2;\n/// }\n/// ```\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CircletoAABB(A: c2Circle, B: c2AABB) -> c_int {\n    let L = c2Clampv(A.p, B.min, B.max);\n    let ab = c2Sub(A.p, L);\n    let d2 = c2Dot(ab, ab);\n    let r2 = A.r * A.r;\n    (d2 < r2) as c_int\n}\n\n/// ```c\n/// int c2AABBtoAABB(c2AABB A, c2AABB B) {\n///     int d0 = B.max.x < A.min.x;\n///     int d1 = A.max.x < B.min.x;\n///     int d2 = B.max.y < A.min.y;\n///     int d3 = A.max.y < B.min.y;\n///     return !(d0 | d1 | d2 | d3);\n/// }\n/// ```\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2AABBtoAABB(A: c2AABB, B: c2AABB) -> c_int {\n    let d0 = (B.max.x < A.min.x) as c_int;\n    let d1 = (A.max.x < B.min.x) as c_int;\n    let d2 = (B.max.y < A.min.y) as c_int;\n    let d3 = (A.max.y < B.min.y) as c_int;\n    ((d0 | d1 | d2 | d3) == 0) as c_int\n}\n\n/// ```c\n/// int collided(const void *A, C2_TYPE typeA, const void *B, C2_TYPE typeB);\n/// ```\n///\n/// Dispatches on the pair of shape tags, exactly reproducing the C switch\n/// nest (including the `default: return 0;` arms for out-of-range tags and the\n/// argument swap in the AABB-vs-circle case).\n///\n/// # Safety\n/// `A` and `B` must point to objects of the type indicated by `typeA` /\n/// `typeB`, just as the C function requires.\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn collided(\n    A: *const c_void,\n    typeA: C2_TYPE,\n    B: *const c_void,\n    typeB: C2_TYPE,\n) -> c_int {\n    match typeA {\n        C2_TYPE_CIRCLE => match typeB {\n            C2_TYPE_CIRCLE => c2CircletoCircle(\n                unsafe { (A as *const c2Circle).read_unaligned() },\n                unsafe { (B as *const c2Circle).read_unaligned() },\n            ),\n            C2_TYPE_AABB => c2CircletoAABB(\n                unsafe { (A as *const c2Circle).read_unaligned() },\n                unsafe { (B as *const c2AABB).read_unaligned() },\n            ),\n            _ => 0,\n        },\n        C2_TYPE_AABB => match typeB {\n            C2_TYPE_CIRCLE => c2CircletoAABB(\n                unsafe { (B as *const c2Circle).read_unaligned() },\n                unsafe { (A as *const c2AABB).read_unaligned() },\n            ),\n            C2_TYPE_AABB => c2AABBtoAABB(\n                unsafe { (A as *const c2AABB).read_unaligned() },\n                unsafe { (B as *const c2AABB).read_unaligned() },\n            ),\n            _ => 0,\n        },\n        _ => 0,\n    }\n}\n","numLines":316,"startLine":1,"totalLines":316}}}
