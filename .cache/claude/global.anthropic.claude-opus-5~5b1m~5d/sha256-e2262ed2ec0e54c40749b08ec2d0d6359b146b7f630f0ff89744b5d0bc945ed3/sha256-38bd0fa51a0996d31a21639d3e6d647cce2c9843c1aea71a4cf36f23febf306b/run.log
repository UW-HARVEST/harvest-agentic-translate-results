        printf(\"   C: rv=%d type=%d vi=%d vd=%.17g(0x%016llx) off=%zu\\n\", rc,\n                   ic.type, ic.valueint, ic.valuedouble,\n                   (unsigned long long)*(uint64_t *)&ic.valuedouble, pc.offset);\n            printf(\"   R: rv=%d type=%d vi=%d vd=%.17g(0x%016llx) off=%zu\\n\", rr,\n                   ir.type, ir.valueint, ir.valuedouble,\n                   (unsigned long long)*(uint64_t *)&ir.valuedouble, pr.offset);\n        }\n    }\n}\n\nstatic void cmp_str(const char *s)\n{\n    size_t n = strlen(s);\n    /* full string, and every offset into it, and truncated lengths */\n    for (size_t off = 0; off <= n + 1; off++) cmp(\"off\", (const unsigned char *)s, n, off, 3);\n    for (size_t len = 0; len <= n; len++) cmp(\"len\", (const unsigned char *)s, len, 0, 0);\n}\n\nint main(void)\n{\n    void *hc = dlopen(\"./_cbuild/libdriver.so\", RTLD_NOW);\n    void *hr = dlopen(\"./translation/target/release/libdriver.so\", RTLD_NOW);\n    if (!hc || !hr) { printf(\"dlopen failed: %s\\n\", dlerror()); return 2; }\n    c_fn = (pn_t)dlsym(hc, \"parse_number\");\n    r_fn = (pn_t)dlsym(hr, \"parse_number\");\n    if (!c_fn || !r_fn) { printf(\"dlsym failed\\n\"); return 2; }\n\n    /* NULL / degenerate buffers (item is untouched on these paths in C) */\n    {\n        cJSON_bool rc, rr; cJSON ic, ir; parse_buffer pc, pr;\n        memset(&ic, 0xA5, sizeof ic); memset(&ir, 0xA5, sizeof ir);\n        rc = c_fn(&ic, NULL); rr = r_fn(&ir, NULL);\n        checks++;\n        if (rc != rr || memcmp(&ic, &ir, sizeof ic)) { fails++; printf(\"MISMATCH null buffer\\n\"); }\n        run(c_fn, NULL, 10, 0, 0, &rc, &ic, &pc);\n        run(r_fn, NULL, 10, 0, 0, &rr, &ir, &pr);\n        checks++;\n        if (rc != rr || memcmp(&ic, &ir, sizeof ic) || memcmp(&pc, &pr, sizeof pc)) {\n            fails++; printf(\"MISMATCH null content\\n\");\n        }\n    }\n\n    static const char *cases[] = {\n        \"\", \"0\", \"-0\", \"+0\", \"1\", \"42\", \"-42\", \"3.14\", \