ize.","ttft_ms":2288,"ttft_stream_ms":2137,"time_to_request_ms":50,"type":"result","duration_ms":90853,"uuid":"5c8e0b9c-1591-4e8c-87e5-7c801c0e9b44","queued_turn_count":0}
