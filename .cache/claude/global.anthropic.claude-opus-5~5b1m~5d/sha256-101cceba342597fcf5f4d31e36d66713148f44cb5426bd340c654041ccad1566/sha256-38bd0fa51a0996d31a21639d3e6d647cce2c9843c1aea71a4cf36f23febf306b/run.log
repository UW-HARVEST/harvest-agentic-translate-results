n    let zero = c2v { x: 0.0, y: 0.0 };\n    let mut p = c2Poly {\n        count: 0,\n        verts: [zero; 8],\n        norms: [zero; 8],\n    };\n    p.verts[0] = c2V(0.875f32, -11.5f32);\n    p.verts[1] = c2V(0.875f32, 11.5f32);\n    p.verts[2] = c2V(-0.875f32, 11.5f32);\n    p.verts[3] = c2V(-0.875f32, -11.5f32);\n    p.norms[0] = c2V(1.0, 0.0);\n    p.norms[1] = c2V(0.0, 1.0);\n    p.norms[2] = c2V(-1.0, 0.0);\n    p.norms[3] = c2V(0.0, -1.0);\n    p.count = 4;\n\n    let ray0 = c2Ray {\n        p: c2v {\n            x: -3.869416f32,\n            y: 13.0693407f32,\n        },\n        d: c2v { x: 1.0, y: 0.0 },\n        t: 4.0,\n    };\n    let ray1 = c2Ray {\n        p: c2v {\n            x: -3.869416f32,\n            y: 13.0693407f32,\n        },\n        d: c2v { x: 0.0, y: -1.0 },\n        t: 4.0,\n    };\n\n    hit += c2CastRay(\n        ray0,\n        addr_of!(p) as *const c_void,\n        core::ptr::null(),\n        C2_TYPE_POLY,\n        cast1,\n    );\n    hit += c2CastRay(\n        ray1,\n        addr_of!(p) as *const c_void,\n        core::ptr::null(),\n        C2_TYPE_POLY,\n        cast2,\n    ) << 1;\n\n    hit\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5840,"cache_read_input_tokens":26356,"cache_creation":{"ephemeral_5m_input_tokens":5840,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"3a9ecc60-f6f2-4da8-9e8d-48cb15902a44","uuid":"f5e943ea-3271-4a6a-9005-38d81241332e","timestamp":"2026-08-27T13:59:41.278Z"}
