   float (*c2Dot)(c2v, c2v);\n    float (*c2Len)(c2v);\n    c2v   (*c2Add)(c2v, c2v);\n    c2v   (*c2Sub)(c2v, c2v);\n    c2v   (*c2Mulvs)(c2v, float);\n    c2v   (*c2Div)(c2v, float);\n    c2v   (*c2Norm)(c2v);\n    c2v   (*c2Minv)(c2v, c2v);\n    c2v   (*c2Maxv)(c2v, c2v);\n    c2v   (*c2Skew)(c2v);\n    c2v   (*c2Absv)(c2v);\n    c2v   (*c2CCW90)(c2v);\n    c2v   (*c2MulmvT)(c2m, c2v);\n    c2r   (*c2RotIdentity)(void);\n    c2x   (*c2xIdentity)(void);\n    c2v   (*c2Mulrv)(c2r, c2v);\n    c2v   (*c2MulrvT)(c2r, c2v);\n    c2v   (*c2MulxvT)(c2x, c2v);\n    int   (*c2AABBtoAABB)(c2AABB, c2AABB);\n    int   (*c2AABBtoPoint)(c2AABB, c2v);\n    int   (*c2CircleToPoint)(c2Circle, c2v);\n    int   (*c2RaytoCircle)(c2Ray, c2Circle, c2Raycast *);\n    int   (*c2RaytoAABB)(c2Ray, c2AABB, c2Raycast *);\n    int   (*c2RaytoCapsule)(c2Ray, c2Capsule, c2Raycast *);\n    int   (*c2RaytoPoly)(c2Ray, const c2Poly *, const c2x *, c2Raycast *);\n    int   (*c2CastRay)(c2Ray, const void *, const c2x *, int, c2Raycast *);\n    int   (*poly_ray)(c2Raycast *, c2Raycast *);\n};\n\nstatic long fails = 0, checks = 0;\n\n#define LOAD(a, name) do { \\\n    *(void **)(&(a)->name) = dlsym((a)->h, #name); \\\n    if (!(a)->name) { fprintf(stderr, \"MISSING SYMBOL %s: %s\\n\", #name, dlerror()); exit(2); } \\\n} while (0)\n\nstatic void load(struct api *a, const char *path) {\n    a->h = dlopen(path, RTLD_NOW | RTLD_LOCAL);\n    if (!a->h) { fprintf(stderr, \"dlopen %s: %s\\n\", path, dlerror()); exit(2); }\n    LOAD(a, c2V); LOAD(a, c2Dot); LOAD(a, c2Len); LOAD(a, c2Add); LOAD(a, c2Sub);\n    LOAD(a, c2Mulvs); LOAD(a, c2Div); LOAD(a, c2Norm); LOAD(a, c2Minv);\n    LOAD(a, c2Maxv); LOAD(a, c2Skew); LOAD(a, c2Absv); LOAD(a, c2CCW90);\n    LOAD(a, c2MulmvT); LOAD(a, c2RotIdentity); LOAD(a, c2xIdentity);\n    LOAD(a, c2Mulrv); LOAD(a, c2MulrvT); LOAD(a, c2MulxvT);\n    LOAD(a, c2AABBtoAABB); LOAD(a, c2AABBtoPoint); LOAD(a, c2CircleToPoint);\n    LOAD(a, c2RaytoCircle); LOAD(a, c2RaytoAABB); LOAD(a, c2RaytoCapsule);\n    LOAD(a, c2RaytoPoly); LOAD(a, c2CastRay); LOAD(a, poly_ray);\n}\n\n// Bit-exact comparison of an arbitrary blob.\nstatic void cmp(const char *what, const void *a, const void *b, size_t n) {\n    checks++;\n    if (memcmp(a, b, n) != 0) {\n        fails++;\n        if (fails <= 25) {\n            const unsigned char *pa = a, *pb = b;\n            fprintf(stderr, \"MISMATCH %s:\\n  C   =\", what);\n            for (size_t i = 0; i < n; i++) fprintf(stderr, \" %02x\", pa[i]);\n            fprintf(stderr, \"\\n  rust=\");\n            for (size_t i = 0; i < n; i++) fprintf(stderr, \" %02x\", pb[i]);\n            fprintf(stderr, \"\\n\");\n        }\n    }\n}\n\n// ---- deterministic PRNG ----\nstatic uint64_t st = 0x243F6A8885A308D3ull;\nstatic uint32_t rnd(void) {\n    st ^= st << 13; st ^= st >> 7; st ^= st << 17;\n    return (uint32_t)(st >> 32);\n}\n\n// Interesting float pool: zeros, signed zeros, infinities, NaN, denormals,\n// exact values, and random magnitudes.\nstatic int use_specials = 1;   /* argv[3] == \"finite\" disables inf/nan */\n\nstatic float rf(void) {\n    if (!use_specials) {\n        switch (rnd() % 10) {\n        case 0:  return 0.0f;\n        case 1:  return -0.0f;\n        case 2:  return 1.0f;\n        case 3:  return -1.0f;\n        case 4:  return 0.5f;\n        case 5:  return 11.5f;\n        case 6:  return 0.875f;\n        case 7:  return (float)(int32_t)(rnd() % 21) - 10.0f;\n        default: return (float)(rnd() % 2000001) / 1000.0f - 1000.0f;\n        }\n    }\n    switch (rnd() % 16) {\n    case 0:  return 0.0f;\n    case 1:  return -0.0f;\n    case 2:  return INFINITY;\n    case 3:  return -INFINITY;\n    case 4:  return NAN;\n    case 5:  return 1.0f;\n    case 6:  return -1.0f;\n    case 7:  return 0.5f;\n    case 8:  return 1.4e-45f;   /* denormal */\n    case 9:  return (float)(int32_t)(rnd() % 21) - 10.0f;\n    case 10: return 11.5f;\n    case 11: return 0.875f;\n    default: {\n        // random magnitude in a physically plausible range\n        float m = (float)(rnd() % 2000001) / 1000.0f - 1000.0f;\n        return m;\n    }\n    }\n}\n\nstatic c2v rv(void) { c2v v; v.x = rf(); v.y = rf(); return v; }\nstatic c2r rr(void) { c2r r; r.c = rf(); r.s = rf(); return r; }\nstatic c2x rx(void) { c2x x; x.p = rv(); x.r = rr(); return x; }\nstatic c2m rm(void) { c2m m; m.x = rv(); m.y = rv(); return m; }\nstatic c2Circle rc(void) { c2Circle c; c.p = rv(); c.r = rf(); return c; }\nstatic c2AABB rb(void) { c2AABB b; b.min = rv(); b.max = rv(); return b; }\nstatic c2Capsule rcap(void) { c2Capsule c; c.a = rv(); c.b = rv(); c.r = rf(); return c; }\nstatic c2Ray rray(void) { c2Ray r; r.p = rv(); r.d = rv(); r.t = rf(); return r; }\n\nstatic c2Poly rpoly(void) {\n    c2Poly p;\n    memset(&p, 0, sizeof p);\n    p.count = (int)(rnd() % 9);          // 0..8, always in-bounds\n    for (int i = 0; i < 8; i++) { p.verts[i] = rv(); p.norms[i] = rv(); }\n    return p;\n}\n\nint main(int argc, char **argv) {\n    if (argc != 3) { fprintf(stderr, \"usage: %s <c.so> <rust.so>\\n\", argv[0]); return 2; }\n    struct api C, R;\n    load(&C, argv[1]);\n    load(&R, argv[2]);\n\n    // ---- the public entry point ----\n    for (int rep = 0; rep < 3; rep++) {\n        c2Raycast c1, c2_, r1, r2;\n        memset(&c1, 0xAA, sizeof c1); memset(&c2_, 0xAA, sizeof c2_);\n        memset(&r1, 0xAA, sizeof r1); memset(&r2, 0xAA, sizeof r2);\n        int rc_ = C.poly_ray(&c1, &c2_);\n        int rr_ = R.poly_ray(&r1, &r2);\n        cmp(\"poly_ray ret\", &rc_, &rr_, sizeof rc_);\n        cmp(\"poly_ray cast1\", &c1, &r1, sizeof c1);\n        cmp(\"poly_ray cast2\", &c2_, &r2, sizeof c2_);\n        if (rep == 0)\n            printf(\"poly_ray -> %d  cast1={t=%.9g n=(%.9g,%.9g)}  cast2={t=%.9g n=(%.9g,%.9g)}\\n\",\n                   rc_, c1.t, c1.n.x, c1.n.y, c2_.t, c2_.n.x, c2_.n.y);\n    }\n\n    // ---- identity-style functions ----\n    { c2r a = C.c2RotIdentity(), b = R.c2RotIdentity(); cmp(\"c2RotIdentity\", &a, &b, sizeof a); }\n    { c2x a = C.c2xIdentity(),   b = R.c2xIdentity();   cmp(\"c2xIdentity\", &a, &b, sizeof a); }\n\n    const int N = 300000;\n    for (int i = 0; i < N; i++) {\n        c2v a = rv(), b = rv();\n        float s = rf();\n        { c2v x = C.c2V(a.x, a.y),  y = R.c2V(a.x, a.y);  cmp(\"c2V\", &x, &y, sizeof x); }\n        { float x = C.c2Dot(a,b),   y = R.c2Dot(a,b);     cmp(\"c2Dot\", &x, &y, sizeof x); }\n        { float x = C.c2Len(a),     y = R.c2Len(a);       cmp(\"c2Len\", &x, &y, sizeof x); }\n        { c2v x = C.c2Add(a,b),     y = R.c2Add(a,b);     cmp(\"c2Add\", &x, &y, sizeof x); }\n        { c2v x = C.c2Sub(a,b),     y = R.c2Sub(a,b);     cmp(\"c2Sub\", &x, &y, sizeof x); }\n        { c2v x = C.c2Mulvs(a,s),   y = R.c2Mulvs(a,s);   cmp(\"c2Mulvs\", &x, &y, sizeof x); }\n        { c2v x = C.c2Div(a,s),     y = R.c2Div(a,s);     cmp(\"c2Div\", &x, &y, sizeof x); }\n        { c2v x = C.c2Norm(a),      y = R.c2Norm(a);      cmp(\"c2Norm\", &x, &y, sizeof x); }\n        { c2v x = C.c2Minv(a,b),    y = R.c2Minv(a,b);    cmp(\"c2Minv\", &x, &y, sizeof x); }\n        { c2v x = C.c2Maxv(a,b),    y = R.c2Maxv(a,b);    cmp(\"c2Maxv\", &x, &y, sizeof x); }\n        { c2v x = C.c2Skew(a),      y = R.c2Skew(a);      cmp(\"c2Skew\", &x, &y, sizeof x); }\n        { c2v x = C.c2Absv(a),      y = R.c2Absv(a);      cmp(\"c2Absv\", &x, &y, sizeof x); }\n        { c2v x = C.c2CCW90(a),     y = R.c2CCW90(a);     cmp(\"c2CCW90\", &x, &y, sizeof x); }\n\n        c2m m = rm();\n        { c2v x = C.c2MulmvT(m,a),  y = R.c2MulmvT(m,a);  cmp(\"c2MulmvT\", &x, &y, sizeof x); }\n        c2r r = rr();\n        { c2v x = C.c2Mulrv(r,a),   y = R.c2Mulrv(r,a);   cmp(\"c2Mulrv\", &x, &y, sizeof x); }\n        { c2v x = C.c2MulrvT(r,a),  y = R.c2MulrvT(r,a);  cmp(\"c2MulrvT\", &x, &y, sizeof x); }\n        c2x xf = rx();\n        { c2v x = C.c2MulxvT(xf,a), y = R.c2MulxvT(xf,a); cmp(\"c2MulxvT\", &x, &y, sizeof x); }\n\n        c2AABB b1 = rb(), b2 = rb();\n        { int x = C.c2AABBtoAABB(b1,b2),  y = R.c2AABBtoAABB(b1,b2);  cmp(\"c2AABBtoAABB\", &x, &y, sizeof x); }\n        { int x = C.c2AABBtoPoint(b1,a),  y = R.c2AABBtoPoint(b1,a);  cmp(\"c2AABBtoPoint\", &x, &y, sizeof x); }\n        c2Circle ci = rc();\n        { int x = C.c2CircleToPoint(ci,a), y = R.c2CircleToPoint(ci,a); cmp(\"c2CircleToPoint\", &x, &y, sizeof x); }\n\n        // ---- raycasts: out buffers pre-poisoned so untouched bytes also compare ----\n        c2Ray ray = rray();\n        c2Raycast oc, orr;\n        memset(&oc, 0x5A, sizeof oc); memset(&orr, 0x5A, sizeof orr);\n        { int x = C.c2RaytoCircle(ray, ci, &oc), y = R.c2RaytoCircle(ray, ci, &orr);\n          cmp(\"c2RaytoCircle ret\", &x, &y, sizeof x); cmp(\"c2RaytoCircle out\", &oc, &orr, sizeof oc); }\n\n        memset(&oc, 0x5A, sizeof oc); memset(&orr, 0x5A, sizeof orr);\n        { int x = C.c2RaytoAABB(ray, b1, &oc), y = R.c2RaytoAABB(ray, b1, &orr);\n          cmp(\"c2RaytoAABB ret\", &x, &y, sizeof x); cmp(\"c2RaytoAABB out\", &oc, &orr, sizeof oc); }\n\n        c2Capsule cap = rcap();\n        memset(&oc, 0x5A, sizeof oc); memset(&orr, 0x5A, sizeof orr);\n        { int x = C.c2RaytoCapsule(ray, cap, &oc), y = R.c2RaytoCapsule(ray, cap, &orr);\n          cmp(\"c2RaytoCapsule ret\", &x, &y, sizeof x); cmp(\"c2RaytoCapsule out\", &oc, &orr, sizeof oc); }\n\n        c2Poly poly = rpoly();\n        c2x bxv = rx();\n        const c2x *bxp = (rnd() % 2) ? &bxv : NULL;   // exercise the NULL path\n        memset(&oc, 0x5A, sizeof oc); memset(&orr, 0x5A, sizeof orr);\n        { int x = C.c2RaytoPoly(ray, &poly, bxp, &oc), y = R.c2RaytoPoly(ray, &poly, bxp, &orr);\n          cmp(\"c2RaytoPoly ret\", &x, &y, sizeof x); cmp(\"c2RaytoPoly out\", &oc, &orr, sizeof oc); }\n\n        // ---- c2CastRay dispatch, all types + an out-of-range type ----\n        for (int ty = 0; ty <= 4; ty++) {\n            const void *shape;\n            switch (ty) {\n            case 0: shape = &ci;  break;\n            case 1: shape = &b1;  break;\n            case 2: shape = &cap; break;\n            case 3: shape = &poly; break;\n            default: shape = &ci; break;\n            }\n            memset(&oc, 0x5A, sizeof oc); memset(&orr, 0x5A, sizeof orr);\n            int x = C.c2CastRay(ray, shape, bxp, ty, &oc);\n            int y = R.c2CastRay(ray, shape, bxp, ty, &orr);\n            cmp(\"c2CastRay ret\", &x, &y, sizeof x);\n            cmp(\"c2CastRay out\", &oc, &orr, sizeof oc);\n        }\n    }\n\n    printf(\"%ld bit-exact comparisons, %ld mismatches\\n\", checks, fails);\n    printf(fails ? \"FAIL\\n\" : \"ALL IDENTICAL\\n\");\n    return fails != 0;\n}\n","structuredPatch":[{"oldStart":152,"oldLines":7,"newStart":152,"newLines":9,"lines":[" }"," "," int main(int argc, char **argv) {","-    if (argc != 3) { fprintf(stderr, \"usage: %s <c.so> <rust.so>\\n\", argv[0]); return 2; }","+    if (argc < 3) { fprintf(stderr, \"usage: %s <c.so> <rust.so> [finite]\\n\", argv[0]); return 2; }","+    if (argc > 3 && strcmp(argv[3], \"finite\") == 0) use_specials = 0;","+    printf(\"=== mode: %s ===\\n\", use_specials ? \"all values (incl. inf/nan)\" : \"finite values only\");","     struct api C, R;","     load(&C, argv[1]);","     load(&R, argv[2]);"]}],"userModified":false,"replaceAll":false}}
