ed blocks then final\nb1=bytes([0x00])+struct.pack('<HH',4,0xFFFB)+b'abcd'\nb2=bytes([0x01])+struct.pack('<HH',3,0xFFFC)+b'xyz'\nadd(0,'two-stored',in_data=b1+b2+bytes(4),out_bytes=100)\n# unfilter: bigger, plus prev-row dependency chains\ndef unf(w,h,bpp,filters=None,seed=0):\n    r=random.Random(seed); rows=[]\n    for y in range(max(h,0)):\n        f=filters[y%len(filters)] if filters else r.randrange(5)\n        rows.append(bytes([f])+bytes(r.randrange(256) for _ in range(max(w*bpp,0))))\n    return b''.join(rows)\nfor i in range(40):\n    w=random.randrange(1,120); h=random.randrange(1,60); bpp=random.choice([1,2,3,4,6,8])\n    add(1,'u3-%d'%i,a=w,b=h,c=bpp,out_init=unf(w,h,bpp,None,seed=i))\nfor f in range(5):\n    add(1,'u3-uniform%d'%f,a=97,b=31,c=3,out_init=unf(97,31,3,[f],seed=100+f))\nopen('cases3.bin','wb').write(b''.join(recs))\nprint('wrote',len(recs))\nPY\n./difftest ./libharvest-work-EiJkaG.so ../translation/target/release/libtranslation.so cases3.bin > out5.txt 2>&1; echo exit=$?; tail -2 out5.txt; grep -E 'MISMATCH|both-crashed' out5.txt | head -20"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":609,"cache_read_input_tokens":89144,"cache_creation":{"ephemeral_5m_input_tokens":609,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"794aee64-628f-4e2a-844f-ff1489f1018d","uuid":"2e6a24df-98d7-4192-8360-8d2dd47cfbcb","timestamp":"2026-08-27T19:32:01.354Z"}
