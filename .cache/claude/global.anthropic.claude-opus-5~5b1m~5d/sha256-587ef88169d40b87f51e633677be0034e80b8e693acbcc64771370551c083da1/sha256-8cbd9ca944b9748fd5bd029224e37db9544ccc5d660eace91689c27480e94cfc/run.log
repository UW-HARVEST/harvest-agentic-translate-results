{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Uqmmqe2KTngzxMJimPrz3r","type":"tool_result","content":"1\t//! Phase B — valid-path differential tests for group G1:\n2\t//! `sodium/utils.c`, `sodium/codecs.c`, `sodium/core.c`, `sodium/runtime.c`,\n3\t//! `sodium/version.c`, `crypto_verify/verify.c`.\n4\tmod common;\n5\tuse common::*;\n6\tuse std::os::raw::{c_char, c_int, c_void};\n7\tuse std::ptr;\n8\t\n9\tconst SEED: u64 = 0xC0FFEE_1234_5678;\n10\t\n11\tconst VARIANTS: [c_int; 4] = [1, 3, 5, 7]; // ORIGINAL, ORIGINAL_NO_PADDING, URLSAFE, URLSAFE_NO_PADDING\n12\t\n13\t// ---------------------------------------------------------------- bin2hex ---\n14\t#[test]\n15\tfn g1_bin2hex_all_lengths() {\n16\t    type F = unsafe extern \"C\" fn(*mut c_char, usize, *const u8, usize) -> *mut c_char;\n17\t    unsafe {\n18\t        let (c, r) = pair::<F>(\"sodium_bin2hex\");\n19\t        let mut rng = Rng::new(SEED);\n20\t        for bin_len in 0..=64usize {\n21\t            for _ in 0..8 {\n22\t                let bin = rng.bytes(bin_len);\n23\t                let maxlen = bin_len * 2 + 1;\n24\t                let mut cb = vec![0xAAu8; maxlen + 8];\n25\t                let mut rb = vec![0xAAu8; maxlen + 8];\n26\t                let cp = c(cb.as_mut_ptr() as *mut c_char, maxlen, bin.as_ptr(), bin_len);\n27\t                let rp = r(rb.as_mut_ptr() as *mut c_char, maxlen, bin.as_ptr(), bin_len);\n28\t                assert_eq!(\n29\t                    cp as usize == cb.as_ptr() as usize,\n30\t                    rp as usize == rb.as_ptr() as usize,\n31\t                    \"sodium_bin2hex len={bin_len}: returned-pointer identity differs\"\n32\t                );\n33\t                eq_bytes(&format!(\"sodium_bin2hex len={bin_len}\"), &cb, &rb);\n34\t            }\n35\t        }\n36\t    }\n37\t}\n38\t\n39\t// ---------------------------------------------------------------- hex2bin ---\n40\t#[test]\n41\tfn g1_hex2bin_valid_and_ignore() {\n42\t    type F = unsafe extern \"C\" fn(\n43\t        *mut u8,\n44\t        usize,\n45\t        *const c_char,\n46\t        usize,\n47\t        *const c_char,\n48\t        *mut usize,\n49\t        *mut *const c_char,\n50\t    ) -> c_int;\n51\t    unsafe {\n52\t        let (c, r) = pair::<F>(\"sodium_hex2bin\");\n53\t        let mut rng = Rng::new(SEED ^ 1);\n54\t        let ignores: [Option<&[u8]>; 4] = [None, Some(b\": \\0\"), Some(b\"\\0\"), Some(b\"-:\\0\")];\n55\t        let hexdig = b\"0123456789abcdefABCDEF\";\n56\t        for nbytes in 0..=48usize {\n57\t            for (ii, ign) in ignores.iter().enumerate() {\n58\t                for _ in 0..6 {\n59\t                    // build a hex string, possibly sprinkled with ignore chars\n60\t                    let mut s: Vec<u8> = Vec::new();\n61\t                    for _ in 0..nbytes {\n62\t                        s.push(hexdig[rng.below(hexdig.len())]);\n63\t                        s.push(hexdig[rng.below(hexdig.len())]);\n64\t                        if ii == 1 && rng.below(3) == 0 {\n65\t                            s.push(b':');\n66\t                        }\n67\t                        if ii == 3 && rng.below(4) == 0 {\n68\t                            s.push(b'-');\n69\t                        }\n70\t                    }\n71\t                    s.push(0);\n72\t                    let hex_len = s.len() - 1;\n73\t                    for &maxlen in &[nbytes, nbytes + 1, nbytes.saturating_sub(1)] {\n74\t                        let mut cb = vec![0x55u8; maxlen + 8];\n75\t                        let mut rb = vec![0x55u8; maxlen + 8];\n76\t                        let mut cl = 0usize;\n77\t                        let mut rl = 0usize;\n78\t                        let mut ce: *const c_char = ptr::null();\n79\t                        let mut re: *const c_char = ptr::null();\n80\t                        let ip = ign.map_or(ptr::null(), |x| x.as_ptr() as *const c_char);"}]},"parent_tool_use_id":"toolu_bdrk_01YFsDeJBuv2gUaUX1f