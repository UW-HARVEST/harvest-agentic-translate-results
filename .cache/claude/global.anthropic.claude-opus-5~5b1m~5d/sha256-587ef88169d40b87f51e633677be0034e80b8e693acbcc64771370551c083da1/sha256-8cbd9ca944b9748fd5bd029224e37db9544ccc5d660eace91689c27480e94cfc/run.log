usize::MAX;\n        let mut rl = usize::MAX;\n        set_errno(0);\n        let a = chx(\n            cbuf.as_mut_ptr(),\n            0,\n            b\"\\0\".as_ptr() as *const c_char,\n            0,\n            ptr::null(),\n            &mut cl,\n            ptr::null_mut(),\n        );\n        let ae = errno();\n        set_errno(0);\n        let b = rhx(\n            rbuf.as_mut_ptr(),\n            0,\n            b\"\\0\".as_ptr() as *const c_char,\n            0,\n            ptr::null(),\n            &mut rl,\n            ptr::null_mut(),\n        );\n        let be = errno();\n        eq_i32(\"hex2bin empty\", a, b);\n        assert_eq!(ae, be);\n        assert_eq!(cl, rl);\n        let (cb6, rb6) = pair::<B642Bin>(\"sodium_base642bin\");\n        for v in [1i32, 3, 5, 7] {\n            let mut cl = usize::MAX;\n            let mut rl = usize::MAX;\n            set_errno(0);\n            let a = cb6(\n                cbuf.as_mut_ptr(),\n                0,\n                b\"\\0\".as_ptr() as *const c_char,\n                0,\n                ptr::null(),\n                &mut cl,\n                ptr::null_mut(),\n                v,\n            );\n            let ae = errno();\n            set_errno(0);\n            let b = rb6(\n                rbuf.as_mut_ptr(),\n                0,\n                b\"\\0\".as_ptr() as *const c_char,\n                0,\n                ptr::null(),\n                &mut rl,\n                ptr::null_mut(),\n                v,\n            );\n            let be = errno();\n            eq_i32(&format!(\"base642bin empty v={v}\"), a, b);\n            assert_eq!(ae, be);\n            assert_eq!(cl, rl);\n        }\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1134,"cache_read_input_tokens":111025,"cache_creation":{"ephemeral_5m_input_tokens":1134,"ephemeral_1h_input_tokens":0},"output_tokens":7,"service_tier":"standard"},"context_