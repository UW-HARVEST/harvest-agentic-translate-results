ON _sodium_lock;\n61\tstatic volatile LONG    _sodium_lock_initialized;\n62\t\n63\tstatic int\n64\t_sodium_crit_init(void)\n65\t{\n66\t    LONG status = 0L;\n67\t\n68\t    while ((status = InterlockedCompareExchange(&_sodium_lock_initialized,\n69\t                                                1L, 0L)) == 1L) {\n70\t        Sleep(0);\n71\t    }\n72\t\n73\t    switch (status) {\n74\t    case 0L:\n75\t        InitializeCriticalSection(&_sodium_lock);\n76\t        return InterlockedExchange(&_sodium_lock_initialized, 2L) == 1L ? 0 : -1;\n77\t    case 2L:\n78\t        return 0;\n79\t    default: /* should never be reached */\n80\t        return -1;\n81\t    }\n82\t}\n83\t\n84\tint\n85\tsodium_crit_enter(void)\n86\t{\n87\t    if (_sodium_crit_init() != 0) {\n88\t        return -1; /* LCOV_EXCL_LINE */\n89\t    }\n90\t    EnterCriticalSection(&_sodium_lock);\n91\t    assert(locked == 0);\n92\t    locked = 1;\n93\t\n94\t    return 0;\n95\t}\n96\t\n97\tint\n98\tsodium_crit_leave(void)\n99\t{\n100\t    if (locked == 0) {\n101\t# ifdef EPERM\n102\t        errno = EPERM;\n103\t# endif\n104\t        return -1;\n105\t    }\n106\t    locked = 0;\n107\t    LeaveCriticalSection(&_sodium_lock);\n108\t\n109\t    return 0;\n110\t}\n111\t\n112\t#elif defined(HAVE_PTHREAD) && !defined(__EMSCRIPTEN__)\n113\t\n114\tstatic pthread_mutex_t _sodium_lock = PTHREAD_MUTEX_INITIALIZER;\n115\t\n116\tint\n117\tsodium_crit_enter(void)\n118\t{\n119\t    int ret;\n120\t\n121\t    if ((ret = pthread_mutex_lock(&_sodium_lock)) == 0) {\n122\t        assert(locked == 0);\n123\t        locked = 1;\n124\t    }\n125\t    return ret;\n126\t}\n127\t\n128\tint\n129\tsodium_crit_leave(void)\n130\t{\n131\t    if (locked == 0) {\n132\t# ifdef EPERM\n133\t        errno = EPERM;\n134\t# endif\n135\t        return -1;\n136\t    }\n137\t    locked = 0;\n138\t\n139\t    return pthread_mutex_unlock(&_sodium_lock);\n140\t}\n141\t\n142\t#elif defined(HAVE_ATOMIC_OPS) && !defined(__EMSCRIPTEN__)\n143\t\n144\tstatic volat