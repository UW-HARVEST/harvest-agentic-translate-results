    ARGON2_OUT_PTR_MISMATCH = -27,\n   410\t\n   411\t    ARGON2_THREADS_TOO_FEW  = -28,\n   412\t    ARGON2_THREADS_TOO_MANY = -29,\n   413\t\n   414\t    ARGON2_MISSING_ARGS = -30,\n   415\t\n   416\t    ARGON2_ENCODING_FAIL = -31,\n   417\t\n   418\t    ARGON2_DECODING_FAIL = -32,\n   419\t\n   420\t    ARGON2_THREAD_FAIL = -33,\n   421\t\n   422\t    ARGON2_DECODING_LENGTH_FAIL = -34,\n   423\t\n   424\t    ARGON2_VERIFY_MISMATCH = -35\n   425\t} argon2_error_codes;\n   426\t\n   427\t/* Argon2 external data structures */\n   428\t\n   429\t/*\n   430\t * Context: structure to hold Argon2 inputs:\n   431\t * output array and its length,\n   432\t * password and its length,\n   433\t * salt and its length,\n   434\t * secret and its length,\n   435\t * associated data and its length,\n   436\t * number of passes, amount of used memory (in KBytes, can be rounded up a bit)\n   437\t * number of parallel threads that will be run.\n   438\t * All the parameters above affect the output hash value.\n   439\t * Additionally, two function pointers can be provided to allocate and\n   440\t * deallocate the memory (if NULL, memory will be allocated internally).\n   441\t * Also, three flags indicate whether to erase password, secret as soon as they\n   442\t * are pre-hashed (and thus not needed anymore), and the entire memory\n   443\t *****\n   444\t * Simplest situation: you have output array out[8], password is stored in\n   445\t * pwd[32], salt is stored in salt[16], you do not have keys nor associated\n   446\t * data.\n   447\t * You need to spend 1 GB of RAM and you run 5 passes of Argon2 with 4 parallel\n   448\t * lanes.\n   449\t * You want to erase the password, but you're OK with last pass not being\n   450\t * erased.\n   451\t * You want to use the default memory allocator.\n   452\t * Then you initialize:\n   453\t * Argon2_Context(out,8,pwd,32,salt,16,NULL,0,NULL,0,5,1<<20,4,4,NULL,NULL,true,false,false,false).\n   454\t */\n   455\ttypedef struct Argon2_Context {\n   456\t    uint8_t *out;    /* output array */\n   457\t    uint32_t outlen; /* digest length */\n   458\t\n   459\t    uint8_t *pwd;    /* password array */\n   460\t    uint32_t pwdlen; /* password length */\n   461\t\n   462\t    uint8_t *salt;    /* salt array */\n   463\t    uint32_t saltlen; /* salt length */\n   464\t\n   465\t    uint8_t *secret;    /* key array */\n   466\t    uint32_t secretlen; /* key length */\n   467\t\n   468\t    uint8_t *ad;    /* associated data array */\n   469\t    uint32_t adlen; /* associated data length */\n   470\t\n   471\t    uint32_t t_cost;  /* number of passes */\n   472\t    uint32_t m_cost;  /* amount of memory requested (KB) */\n   473\t    uint32_t lanes;   /* number of lanes */\n   474\t    uint32_t threads; /* maximum number of threads */\n   475\t\n   476\t    uint32_t flags; /* array of bool options */\n   477\t} argon2_context;\n   478\t\n   479\t/* Argon2 primitive type */\n   480\ttypedef enum Argon2_type { Argon2_i = 1, Argon2_id = 2 } argon2_type;\n   481\t\n   482\t/*\n   483\t * Function that performs memory-hard hashing with certain degree of parallelism\n   484\t * @param  context  Pointer to the Argon2 internal structure\n   485\t * @return Error code if something is wrong, ARGON2_OK otherwise\n   486\t */\n   487\tint argon2_ctx(argon2_context *context, argon2_type type);\n   488\t\n   489\t/**\n   490\t * Hashes a password with Argon2i, producing an encoded hash\n   491\t * @param t_cost Number of iterations\n   492\t * @param m_cost Sets memory usage to m_cost kibibytes\n   493\t * @param parallelism Number of threads and compute lanes\n   494\t * @param pwd Pointer to password\n   495\t * @param pwdlen Password size in bytes\n   496\t * @param salt Pointer to salt\n   497\t * @param saltlen Salt size in bytes\n   498\t * @param hashlen Desired length of the hash in bytes\n   499\t * @param encoded Buffer where to write the encoded hash\n   500\t * @param encodedlen Size of the buffer (thus max size of the encoded hash)\n   501\t * @pre   Different parallelism levels will give different results\n   502\t * @pre   Returns ARGON2_OK if successful\n   503\t */\n   504\tint argon2i_hash_encoded(const uint32_t t_cost, const uint32_t m_cost,\n   505\t                         const uint32_t parallelism, const void *pwd,\n   506\t                         const size_t pwdlen, const void *salt,\n   507\t                         const size_t saltlen, const size_t hashlen,\n   508\t                         char *encoded, const size_t encodedlen);\n   509\t\n   510\t/**\n   511\t * Hashes a password with Argon2id, producing an encoded hash\n   512\t * @param t_cost Number of iterations\n   513\t * @param m_cost Sets memory usage to m_cost kibibytes\n   514\t * @param parallelism Number of threads and compute lanes\n   515\t * @param pwd Pointer to password\n   516\t * @param pwdlen Password size in bytes\n   517\t * @param salt Pointer to salt\n   518\t * @param saltlen Salt size in bytes\n   519\t * @param hashlen Desired length of the hash in bytes\n   520\t * @param encoded Buffer where to write the encoded hash\n   521\t * @param encodedlen Size of the buffer (thus max size of the encoded hash)\n   522\t * @pre   Different parallelism levels will give different results\n   523\t * @pre   Returns ARGON2_OK if successful\n   524\t */\n   525\tint argon2id_hash_encoded(const uint32_t t_cost, const uint32_t m_cost,\n   526\t                          const uint32_t parallelism, const void *pwd,\n   527\t                          const size_t pwdlen, const void *salt,\n   528\t                          const size_t saltlen, const size_t hashlen,\n   529\t                          char *encoded, const size_t encodedlen);\n   530\t\n   531\t/**\n   532\t * Hashes a password with Argon2i, producing a raw hash\n   533\t * @param t_cost Number of iterations\n   534\t * @param m_cost Sets memory usage to m_cost kibibytes\n   535\t * @param parallelism Number of threads and compute lanes\n   536\t * @param pwd Pointer to password\n   537\t * @param pwdlen Password size in bytes\n   538\t * @param salt Pointer to salt\n   539\t * @param saltlen Salt size in bytes\n   540\t * @param hash Buffer where to write the raw hash\n   541\t * @param hashlen Desired length of the hash in bytes\n   542\t * @pre   Different parallelism levels will give different results\n   543\t * @pre   Returns ARGON2_OK if successful\n   544\t */\n   545\tint argon2i_hash_raw(const uint32_t t_cost, const uint32_t m_cost,\n   546\t                     const uint32_t parallelism, const void *pwd,\n   547\t                     const size_t pwdlen, const void *salt,\n   548\t                     const size_t saltlen, void *hash, const size_t hashlen);\n   549\t\n   550\t/**\n   551\t * Hashes a password with Argon2id, producing a raw hash\n   552\t * @param t_cost Number of iterations\n   553\t * @param m_cost Sets memory usage to m_cost kibibytes\n   554\t * @param parallelism Number of threads and compute lanes\n   555\t * @param pwd Pointer to password\n   556\t * @param pwdlen Password size in bytes\n   557\t * @param salt Pointer to salt\n   558\t * @param saltlen Salt size in bytes\n   559\t * @param hash Buffer where to write the raw hash\n   560\t * @param hashlen Desired length of the hash in bytes\n   561\t * @pre   Different parallelism levels will give different results\n   562\t * @pre   Returns ARGON2_OK if successful\n   563\t */\n   564\tint argon2id_hash_raw(const uint32_t t_cost, const uint32_t m_cost,\n   565\t                      const uint32_t parallelism, const void *pwd,\n   566\t                      const size_t pwdlen, const void *salt,\n   567\t                      const size_t saltlen, void *hash, const size_t hashlen);\n   568\t\n   569\t/* generic function underlying the above ones */\n   570\tint argon2_hash(const uint32_t t_cost, const uint32_t m_cost,\n   571\t                const uint32_t parallelism, const void *pwd,\n   572\t