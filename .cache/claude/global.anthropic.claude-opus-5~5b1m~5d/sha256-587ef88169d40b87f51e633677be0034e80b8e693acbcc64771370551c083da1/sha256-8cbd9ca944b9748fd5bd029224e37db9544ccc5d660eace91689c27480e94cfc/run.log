{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_014D9b6usFgMhRf4y9qvMKLB","type":"tool_result","content":"1\t//! Translated from `c_src/libsodium/crypto_pwhash/argon2/argon2-encoding.c`.\n2\t//!\n3\t//! Encoder/decoder for Argon2 \"hash strings\" of the form:\n4\t//!\n5\t//!   $argon2<T>$v=<num>$m=<num>,t=<num>,p=<num>$<bin>$<bin>\n6\t\n7\t#![allow(non_upper_case_globals, non_camel_case_types)]\n8\t\n9\tuse core::ffi::{c_char, c_int};\n10\t\n11\tuse crate::csys::{memcpy, strlen, strncmp};\n12\t\n13\t// ---------------------------------------------------------------------\n14\t// Headers: crypto_pwhash/argon2/argon2.h\n15\t// ---------------------------------------------------------------------\n16\t\n17\t/// `argon2_context` — must match `argon2.h` field-for-field (other modules\n18\t/// pass pointers to it).\n19\t#[repr(C)]\n20\tpub struct argon2_context {\n21\t    pub out: *mut u8,\n22\t    pub outlen: u32,\n23\t\n24\t    pub pwd: *mut u8,\n25\t    pub pwdlen: u32,\n26\t\n27\t    pub salt: *mut u8,\n28\t    pub saltlen: u32,\n29\t\n30\t    pub secret: *mut u8,\n31\t    pub secretlen: u32,\n32\t\n33\t    pub ad: *mut u8,\n34\t    pub adlen: u32,\n35\t\n36\t    pub t_cost: u32,\n37\t    pub m_cost: u32,\n38\t    pub lanes: u32,\n39\t    pub threads: u32,\n40\t\n41\t    pub flags: u32,\n42\t}\n43\t\n44\t#[repr(C)]\n45\t#[derive(Clone, Copy, PartialEq, Eq)]\n46\tpub enum argon2_type {\n47\t    Argon2_i = 1,\n48\t    Argon2_id = 2,\n49\t}\n50\t\n51\t// A few `Argon2_ErrorCodes` values used in this file.\n52\tconst ARGON2_OK: c_int = 0;\n53\tconst ARGON2_INCORRECT_TYPE: c_int = -26;\n54\tconst ARGON2_ENCODING_FAIL: c_int = -31;\n55\tconst ARGON2_DECODING_FAIL: c_int = -32;\n56\t\n57\t// crypto_pwhash/argon2/argon2-core.h\n58\tconst ARGON2_VERSION_NUMBER: u32 = 0x13;\n59\t\n60\tconst UINT32_MAX: u64 = u32::MAX as u64;\n61\tconst ULONG_MAX: u64 = u64::MAX;\n62\t\n63\t// ---------------------------------------------------------------------\n64\t// Cross-module calls\n65\t// ---------------------------------------------------------------------\n66\t\n67\textern \"C\" {\n68\t    #[link_name = \"_sodium_argon2_validate_inputs\"]\n69\t    fn argon2_validate_inputs(context: *const argon2_context) -> c_int;\n70\t\n71\t    fn sodium_base642bin(\n72\t        bin: *mut u8,\n73\t        bin_maxlen: usize,\n74\t        b64: *const c_char,\n75\t        b64_len: usize,\n76\t        ignore: *const c_char,\n77\t        bin_len: *mut usize,\n78\t        b64_end: *mut *const c_char,\n79\t        variant: c_int,\n80\t    ) -> c_int;\n81\t\n82\t    fn sodium_bin2base64(\n83\t        b64: *mut c_char,\n84\t        b64_maxlen: usize,\n85\t        bin: *const u8,\n86\t        bin_len: usize,\n87\t        variant: c_int,\n88\t    ) -> *mut c_char;\n89\t}\n90\t\n91\tconst sodium_base64_VARIANT_ORIGINAL_NO_PADDING: c_int = 3;\n92\t\n93\t// ---------------------------------------------------------------------\n94\t// decode_decimal\n95\t// ---------------------------------------------------------------------\n96\t\n97\t/*\n98\t * Decode decimal integer from 'str'; the value is written in '*v'.\n99\t * Returned value is a pointer to the next non-decimal character in the\n100\t * string. If there is no digit at all, or the value encoding is not\n101\t * minimal (extra leading zeros), or the value does not fit in an\n102\t * 'unsigned long', then NULL is returned.\n103\t */\n104\tunsafe fn decode_decimal(str_: *const c_char, v: *mut u64) -> *const c_char {\n105\t    let orig = str_;\n106\t    let mut acc: u64 = 0;\n107\t    let mut p = str_;\n108\t\n109\t    loop {\n110\t        let c = *p as u8 as c_int; // char is signed in C on x86_64 linux; digits are ASCII so fine\n111\t        if !(c >= b'0' as c_int && c <= b'9' as c_int) {\n112\t            break;\n113\t        }\n114\t        let cd = (c - b'0' as c_int) as u64;\n115\t        if acc > ULONG_MAX / 10 {\n116\t            return core::ptr::null();\n117\t        }\n118\t        acc = acc.wrapping_mul(10);\n119\t        if cd > ULONG_MAX - acc {\n120\t            return core::ptr::null();\n121\t        }\n122\t        acc = acc.wrapping_add(cd);\n123\t        p = p.add(1);\n124\t    }\n125\t\n126\t    if p == orig || (*orig as u8 == b'0' && p != orig.add(1)) {\n127\t        return core::ptr::null();\n128\t    }\n129\t    *v = acc;\n130\t    p\n131\t}\n132\t\n133\t// ---------------------------------------------------------------------\n134\t// argon2_decode_string\n135\t// ---------------------------------------------------------------------\n136\t\n137\t/// `CC(prefix)` macro: `prefix` must be a nul-terminated byte string literal\n138\t/// (e.g. `b\"$argon2id\\0\"`). Returns `true` and advances `*str_ptr` past the\n139\t/// prefix if `str` starts with it (via `strncmp`, exactly as the C macro\n140\t/// does); returns `false` otherwise.\n141\tunsafe fn cc(str_ptr: &mut *const c_char, prefix: &[u8]) -> bool {\n142\t    let prefix_ptr = prefix.as_ptr() as *const c_char;\n143\t    let cc_len = strlen(prefix_ptr);\n144\t    if strncmp(*str_ptr, prefix_ptr, cc_len) != 0 {\n145\t        return false;\n146\t    }\n147\t    *str_ptr = (*str_ptr).add(cc_len);\n148\t    true\n149\t}\n150\t\n151\t/*\n152\t * Decode an Argon2i hash string into the provided structure 'ctx'.\n153\t * Returned value is ARGON2_OK on success.\n154\t */\n155\t#[no_mangle]\n156\tpub unsafe extern \"C\" fn _sodium_argon2_decode_string(\n157\t    ctx: *mut argon2_context,\n158\t    str_: *const c_char,\n159\t    type_: argon2_type,\n160\t) -> c_int {\n161\t    let mut str_ = str_;\n162\t\n163\t    let maxsaltlen: usize = (*ctx).saltlen as usize;\n164\t    let maxoutlen: usize = (*ctx).outlen as usize;\n165\t    let mut version: u32 = 0;\n166\t\n167\t    (*ctx).saltlen = 0;\n168\t    (*ctx).outlen = 0;\n169\t\n170\t    match type_ {\n171\t        argon2_type::Argon2_id => {\n172\t            if !cc(&mut str_, b\"$argon2id\\0\") {\n173\t                return ARGON2_DECODING_FAIL;\n174\t            }\n175\t        }\n176\t        argon2_type::Argon2_i => {\n177\t            if !cc(&mut str_, b\"$argon2i\\0\") {\n178\t                return ARGON2_DECODING_FAIL;\n179\t            }\n180\t        }\n181\t    }\n182\t\n183\t    if !cc(&mut str_, b\"$v=\\0\") {\n184\t        return ARGON2_DECODING_FAIL;\n185\t    }\n186\t    // DECIMAL_U32(version)\n187\t    {\n188\t        let mut dec_x: u64 = 0;\n189\t        let np = decode_decimal(str_, &mut dec_x);\n190\t        if np.is_null() || dec_x > UINT32_MAX {\n191\t            return ARGON2_DECODING_FAIL;\n192\t        }\n193\t        str_ = np;\n194\t        version = dec_x as u32;\n195\t    }\n196\t    if version != ARGON2_VERSION_NUMBER {\n197\t        return ARGON2_INCORRECT_TYPE;\n198\t    }\n199\t\n200\t    if !cc(&mut str_, b\"$m=\\0\") {\n201\t        return ARGON2_DECODING_FAIL;\n202\t    }\n203\t    {\n204\t        let mut dec_x: u64 = 0;\n205\t        let np = decode_decimal(str_, &mut dec_x);\n206\t        if np.is_null() || dec_x > UINT32_MAX {\n207\t            return ARGON2_DECODING_FAIL;\n208\t        }\n209\t        str_ = np;\n210\t        (*ctx).m_cost = dec_x as u32;\n211\t    }\n212\t    if (*ctx).m_cost as u64 > UINT32_MAX {\n213\t        return ARGON2_INCORRECT_TYPE;\n214\t    }\n215\t\n216\t    if !cc(&mut str_, b\",t=\\0\") {\n217\t        return ARGON2_DECODING_FAIL;\n218\t    }\n219\t    {\n220\t        let mut dec_x: u64 = 0;\n221\t        let np = decode_decimal(str_, &mut dec_x);\n222\t        if np.is_null() || dec_x > UINT32_MAX {\n223\t            return ARGON2_DECODING_FAIL;\n224\t        }\n225\t        str_ = np;\n226\t        (*ctx).t_cost = dec_x as u32;\n227\t    }\n228\t    if (*ctx).t_cost as u64 > UINT32_MAX {\n229\t        return ARGON2_INCORRECT_TYPE;\n230\t    }\n231\t\n232\t    if !cc(&mut str_, b\",p=\\0\") {\n233\t        return ARGON2_DECODING_FAIL;\n234\t    }\n235\t    {\n236\t        let mut dec_x: u64 = 0;\n237\t        let np = decode_decimal(str_, &mut dec_x);\n238\t        if np.is_null() || dec_x > UINT32_MAX {\n239\t            return ARGON2_DECODING_FAIL;\n240\t        }\n241\t        str_ = np;\n242\t        (*ctx).lanes = dec_x as u32;\n243\t    }\n244\t    if (*ctx).lanes as u64 > UINT32_MAX {\n245\t        return ARGON2_INCORRECT_TYPE;\n246\t    }\n247\t    (*ctx).threads = (*ctx).lanes;\n248\t\n249\t    if !cc(&mut str_, b\"$\\0\") {\n250\t        return ARGON2_DECODING_FAIL;\n251\t    }\n252\t    // BIN(ctx->salt, maxsaltlen, ctx->saltlen)\n253\t    {\n254\t        let mut bin_len: usize = maxsaltlen;\n255\t        let mut str_end: *const c_char = core::ptr::null();\n256\t        let slen = strlen(str_);\n257\t        let rc = sodium_base642bin(\n258\t            (*ctx).salt,\n259\t            maxsaltlen,\n260\t            str_,\n261\t            slen,\n262\t            core::ptr::null(),\n263\t            &mut bin_len,\n264\t            &mut str_end,\n265\t            sodium_base64_VARIANT_ORIGINAL_NO_PADDING,\n266\t        );\n267\t        if rc != 0 || bin_len as u64 > UINT32_MAX {\n268\t            return ARGON2_DECODING_FAIL;\n269\t        }\n270\t        (*ctx).saltlen = bin_len as u32;\n271\t        str_ = str_end;\n272\t    }\n273\t\n274\t    if !cc(&mut str_, b\"$\\0\") {\n275\t        return ARGON2_DECODING_FAIL;\n276\t    }\n277\t    // BIN(ctx->out, maxoutlen, ctx->outlen)\n278\t    {\n279\t        let mut bin_len: usize = maxoutlen;\n280\t        let mut str_end: *const c_char = core::ptr::null();\n281\t        let slen = strlen(str_);\n282\t        let rc = sodium_base642bin(\n283\t            (*ctx).out,\n284\t            maxoutlen,\n285\t            str_,\n286\t            slen,\n287\t            core::ptr::null(),\n288\t            &mut bin_len,\n289\t            &mut str_end,\n290\t            sodium_base64_VARIANT_ORIGINAL_NO_PADDING,\n291\t        );\n292\t        if rc != 0 || bin_len as u64 > UINT32_MAX {\n293\t            return ARGON2_DECODING_FAIL;\n294\t        }\n295\t        (*ctx).outlen = bin_len as u32;\n296\t        str_ = str_end;\n297\t    }\n298\t\n299\t    let validation_result = argon2_validate_inputs(ctx);\n300\t    if validation_result != ARGON2_OK {\n301\t        return validation_result;\n302\t    }\n303\t    if *str_ == 0 {\n304\t        return ARGON2_OK;\n305\t    }\n306\t    ARGON2_DECODING_FAIL\n307\t}\n308\t\n309\t// ---------------------------------------------------------------------\n310\t// u32_to_string\n311\t// ---------------------------------------------------------------------\n312\t\n313\tconst U32_STR_MAXSIZE: usize = 11;\n314\t\n315\tunsafe fn u32_to_string(str_: *mut c_char, mut x: u32) {\n316\t    // char tmp[U32_STR_MAXSIZE - 1] i.e. tmp[10]\n317\t    let mut tmp: [u8; U32_STR_MAXSIZE - 1] = [0; U32_STR_MAXSIZE - 1];\n318\t    let mut i: usize = tmp.len();\n319\t\n320\t    loop {\n321\t        i -= 1;\n322\t        tmp[i] = ((x % 10) as u8) + b'0';\n323\t        x /= 10;\n324\t        if !(x != 0 && i != 0) {\n325\t            break;\n326\t        }\n327\t    }\n328\t    let n = tmp.len() - i;\n329\t    memcpy(\n330\t        str_ as *mut core::ffi::c_void,\n331\t        tmp.as_ptr().add(i) as *const core::ffi::c_void,\n332\t        n,\n333\t    );\n334\t    *str_.add(n) = 0;\n335\t}\n336\t\n337\t// ---------------------------------------------------------------------\n338\t// argon2_encode_string\n339\t// ---------------------------------------------------------------------\n340\t\n341\t/// `SS(str)` macro: copy a nul-terminated string literal into `*dst_ptr`,\n342\t/// advancing `*dst_ptr` / shrinking `*dst_len_ptr`. Returns `false` (and the\n343\t/// caller must return `ARGON2_ENCODING_FAIL`) if it does not fit.\n344\tunsafe fn ss(dst_ptr: &mut *mut c_char, dst_len_ptr: &mut usize, s: &[u8]) -> bool {\n345\t    // s does not include the NUL terminator.\n346\t    let pp_len = s.len();\n347\t    if pp_len >= *dst_len_ptr {\n348\t        return false;\n349\t    }\n350\t    memcpy(\n351\t        