{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01GAty7QSk9SPTRF6YfopoyS","type":"tool_result","content":"1\t//! Shared differential-test harness.\n2\t//!\n3\t//! Loads BOTH the C reference `libsodium.so` and the Rust `liblibsodium.so`\n4\t//! through `libloading` and exposes them as a pair, so every test calls both\n5\t//! implementations exactly the way an external consumer would (through the\n6\t//! dynamic-symbol table), never through Rust-internal calls.\n7\t#![allow(dead_code)]\n8\t\n9\tuse libloading::{Library, Symbol};\n10\tuse std::path::PathBuf;\n11\tuse std::sync::OnceLock;\n12\t\n13\tpub const C_ENV: &str = \"SODIUM_C_SO\";\n14\tpub const R_ENV: &str = \"SODIUM_RUST_SO\";\n15\t\n16\tfn crate_root() -> PathBuf {\n17\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n18\t}\n19\t\n20\tfn c_so_path() -> PathBuf {\n21\t    if let Ok(p) = std::env::var(C_ENV) {\n22\t        return PathBuf::from(p);\n23\t    }\n24\t    let root = crate_root();\n25\t    let ws = root.parent().expect(\"crate parent\");\n26\t    let cand = ws.join(\"c_src/build/libsodium.so\");\n27\t    assert!(\n28\t        cand.exists(),\n29\t        \"C shared library not found at {cand:?}; build it first (see task instructions) \\\n30\t         or set {C_ENV}\"\n31\t    );\n32\t    cand\n33\t}\n34\t\n35\tfn rust_so_path() -> PathBuf {\n36\t    if let Ok(p) = std::env::var(R_ENV) {\n37\t        return PathBuf::from(p);\n38\t    }\n39\t    let root = crate_root();\n40\t    // The test binary lives in target/<profile>/deps/<name>; walk up to the\n41\t    // profile dir so we pick the .so from the same profile we were built with.\n42\t    let exe = std::env::current_exe().expect(\"current_exe\");\n43\t    let profile_dir = exe\n44\t        .parent()\n45\t        .and_then(|p| p.parent())\n46\t        .map(|p| p.to_path_buf());\n47\t    let mut cands: Vec<PathBuf> = Vec::new();\n48\t    if let Some(d) = profile_dir {\n49\t        cands.push(d.join(\"liblibsodium.so\"));\n50\t    }\n51\t    cands.push(root.join(\"target/debug/liblibsodium.so\"));\n52\t    cands.push(root.join(\"target/release/liblibsodium.so\"));\n53\t    // `cargo test` does NOT rebuild a `cdylib`-only lib target for integration\n54\t    // tests, so several candidates may exist. Always take the most recently\n55\t    // built one, and shout if it is older than the newest source file.\n56\t    let mut best: Option<(PathBuf, std::time::SystemTime)> = None;\n57\t    for c in &cands {\n58\t        if let Ok(md) = std::fs::metadata(c) {\n59\t            let t = md.modified().unwrap_or(std::time::UNIX_EPOCH);\n60\t            if best.as_ref().map(|(_, bt)| t > *bt).unwrap_or(true) {\n61\t                best = Some((c.clone(), t));\n62\t            }\n63\t        }\n64\t    }\n65\t    let (path, built) = best.unwrap_or_else(|| {\n66\t        panic!(\"Rust cdylib not found; tried {cands:?}. Run `./dt.sh` (or `cargo build --release`) first, or set {R_ENV}\")\n67\t    });\n68\t    if let Ok(rd) = std::fs::read_dir(root.join(\"src\")) {\n69\t        for e in rd.flatten() {\n70\t            if let Ok(md) = e.metadata() {\n71\t                if md.modified().map(|t| t > built).unwrap_or(false) {\n72\t                    panic!(\n73\t                        \"STALE Rust cdylib: {} is older than {}. \\\n74\t                         Rebuild with `./dt.sh` (cargo build --release && cargo test).\",\n75\t                        path.display(),\n76\t                        e.path().display()\n77\t                    );\n78\t                }\n79\t            }\n80\t        }\n81\t    }\n82\t    path\n83\t}\n84\t\n85\t/// A pair of loaded libraries: `.0` is C (ground truth), `.1` is Rust.\n86\tpub struct Libs {\n87\t    pub c: &'static Library,\n88\t    pub rs: &'static Library,\n89\t}\n90\t\n91\tstatic LIBS: OnceLock<Libs> = OnceLock::new();\n92\t\n93\t/// The `randombytes_implementation` vtable, byte-compatible with\n94\t/// `randombytes.h`.\n95\t#[repr(C)]\n96\tpub struct RandombytesImpl {\n97\t    pub implementation_name: Option<extern \"C\" fn() -> *const std::os::raw::c_char>,\n98\t    pub random: Option<extern \"C\" fn() -> u32>,\n99\t    pub stir: Option<extern \"C\" fn()>,\n100\t    pub uniform: Option<extern \"C\" fn(u32) -> u32>,\n101\t    pub buf: Option<extern \"C\" fn(*mut std::os::raw::c_void, usize)>,\n102\t    pub close: Option<extern \"C\" fn() -> i32>,\n103\t}\n104\tunsafe impl Sync for RandombytesImpl {}\n105\t\n106\t// ---------------------------------------------------------------------------\n107\t// Deterministic randombytes implementation, installed into BOTH libraries so\n108\t// that every entry point that internally draws randomness (keypair\n109\t// generation, `*_keygen`, `crypto_core_*_random`, ...) becomes reproducible\n110\t// and therefore differentially comparable byte-for-byte.\n111\t//\n112\t// It is a plain counter-seeded ChaCha-free xorshift stream: the exact bytes do\n113\t// not matter, only that the two libraries observe the SAME stream.\n114\t// ---------------------------------------------------------------------------\n115\tuse std::sync::atomic::{AtomicU64, Ordering};\n116\t\n117\tstatic DET_STATE: AtomicU64 = AtomicU64::new(0x2545_F491_4F6C_DD1D);\n118\t\n119\tpub fn det_reseed(seed: u64) {\n120\t    DET_STATE.store(seed | 1, Ordering::SeqCst);\n121\t}\n122\t\n123\tfn det_next_u64() -> u64 {\n124\t    // splitmix64\n125\t    let mut z = DET_STATE.fetch_add(0x9E37_79B9_7F4A_7C15, Ordering::SeqCst)\n126\t        .wrapping_add(0x9E37_79B9_7F4A_7C15);\n127\t    z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);\n128\t    z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);\n129\t    z ^ (z >> 31)\n130\t}\n131\t\n132\tconst DET_NAME: &[u8] = b\"harness_det\\0\";\n133\t\n134\textern \"C\" fn det_name() -> *const std::os::raw::c_char {\n135\t    DET_NAME.as_ptr() as *const _\n136\t}\n137\t\n138\textern \"C\" fn det_random() -> u32 {\n139\t    det_next_u64() as u32\n140\t}\n141\t\n142\textern \"C\" fn det_stir() {}\n143\t\n144\textern \"C\" fn det_buf(buf: *mut std::os::raw::c_void, size: usize) {\n145\t    if buf.is_null() || size == 0 {\n146\t        return;\n147\t    }\n148\t    let out = unsafe { std::slice::from_raw_parts_mut(buf as *mut u8, size) };\n149\t    let mut i = 0usize;\n150\t    while i < size {\n151\t        let v = det_next_u64().to_le_bytes();\n152\t        let n = core::cmp::min(8, size - i);\n153\t        out[i..i + n].copy_from_slice(&v[..n]);\n154\t        i += n;\n155\t    }\n156\t}\n157\t\n158\textern \"C\" fn det_close() -> i32 {\n159\t    0\n160\t}\n161\t\n162\tpub static DET_IMPL: RandombytesImpl = RandombytesImpl {\n163\t    implementation_name: Some(det_name),\n164\t    random: Some(det_random),\n165\t    stir: Some(det_stir),\n166\t    uniform: None, // exercise the library's own rejection-sampling code\n167\t    buf: Some(det_buf),\n168\t    close: Some(det_close),\n169\t};\n170\t\n171\t/// Load (once) and initialise both libraries.\n172\tpub fn libs() -> &'static Libs {\n173\t    LIBS.get_or_init(|| {\n174\t        let c = unsafe { Library::new(c_so_path()) }.expect(\"load C libsodium.so\");\n175\t        let rs = unsafe { Library::new(rust_so_path()) }.expect(\"load Rust liblibsodium.so\");\n176\t        let c: &'static Library = Box::leak(Box::new(c));\n177\t        let rs: &'static Library = Box::leak(Box::new(rs));\n178\t        for l in [c, rs] {\n179\t            let init: Symbol<unsafe extern \"C\" fn() -> i32> =\n180\t                unsafe { l.get(b\"sodium_init\\0\") }.expect(\"sodium_init\");\n181\t            let r = unsafe { init() };\n182\t            assert!(r == 0 || r == 1, \"sodium_init returned {r}\");\n183\t        }\n184\t        Libs { c, rs }\n185\t    })\n186\t}\n187\t\n188\t/// Install the deterministic randombytes implementation in both libraries.\n189\t/// Idempotent; safe to call from every test.\n190\tpub fn install_det_random() {\n191\t    static DONE: OnceLock<()> = OnceLock::new();\n192\t    DONE.get_or_init(|| {\n193\t        let l = libs();\n194\t        for lib in [l.c, l.rs] {\n195\t            let f: Symbol<unsafe extern \"C\" fn(*const RandombytesImpl) -> i32> =\n196\t                unsafe { lib.get(b\"randombytes_set_implementation\\0\") }.unwrap();\n197\t            let r = unsafe { f(&DET_IMPL as *const RandombytesImpl) };\n198\t            assert_eq!(r, 0, \"randombytes_set_implementation failed\");\n199\t        }\n200\t    });\n201\t}\n202\t\n203\t/// Fetch the same symbol from both libraries, typed as `F`.\n204\t///\n205\t/// # Safety\n206\t/// The caller must supply a signature matching the C declaration.\n207\tpub unsafe fn pair<F>(name: &str) -> (Symbol<'static, F>, Symbol<'static, F>) {\n208\t    let l = libs();\n209\t    let mut n = name.as_bytes().to_vec();\n210\t    n.push(0);\n211\t    let a: Symbol<'static, F> = l\n212\t        .c\n213\t        .get(&n)\n214\t        .unwrap_or_else(|e| panic!(\"C symbol {name} missing: {e}\"));\n215\t    let b: Symbol<'static, F> = l\n216\t        .rs\n217\t        .get(&n)\n218\t        .unwrap_or_else(|e| panic!(\"Rust symbol {name} missing: {e}\"));\n219\t    (a, b)\n220\t}\n221\t\n222\t/// True when the symbol exists in both libraries.\n223\tpub fn has_sym(name: &str) -> bool {\n224\t    let l = libs();\n225\t    let mut n = name.as_bytes().to_vec();\n226\t    n.push(0);\n227\t    unsafe {\n228\t        l.c.get::<*const ()>(&n).is_ok() && l.rs.get::<*const ()>(&n).is_ok()\n229\t    }\n230\t}\n231\t\n232\t// ---------------------------------------------------------------------------\n233\t// Deterministic test RNG (for generating inputs, independent of the library)\n234\t// ---------------------------------------------------------------------------\n235\tpub struct Rng(u64);\n236\t\n237\timpl Rng {\n238\t    pub fn new(seed: u64) -> Self {\n239\t        Rng(seed ^ 0x9E37_79B9_7F4A_7C15)\n240\t    }\n241\t    pub fn next_u64(&mut self) -> u64 {\n242\t        // xorshift64*\n243\t        let mut x = self.0;\n244\t        x ^= x >> 12;\n245\t        x ^= x << 25;\n246\t        x ^= x >> 27;\n247\t        self.0 = x;\n248\t        x.wrapping_mul(0x2545_F491_4F6C_DD1D)\n249\t    }\n250\t    pub fn next_u32(&mut self) -> u32 {\n251\t        (self.next_u64() >> 32) as u32\n252\t    }\n253\t    pub fn byte(&mut self) -> u8 {\n254\t        (self.next_u64() >> 56) as u8\n255\t    }\n256\t    pub fn below(&mut self, n: usize) -> usize {\n257\t        if n == 0 {\n258\t            0\n259\t        } else {\n260\t            (self.next_u64() % n as u64) as usize\n261\t        }\n262\t    }\n263\t    pub fn range(&mut self, lo: usize, hi_incl: usize) -> usize {\n264\t        lo + self.below(hi_incl - lo + 1)\n265\t    }\n266\t    pub fn bytes(&mut self, n: usize) -> Vec<u8> {\n267\t        (0..n).map(|_| self.byte()).collect()\n268\t    }\n269\t    pub fn fill(&mut self, b: &mut [u8]) {\n270\t        for x in b.iter_mut() {\n271\t            *x = self.byte();\n272\t        }\n273\t    }\n274\t}\n275\t\n276\tpub fn hex(b: &[u8]) -> String {\n277\t    b.iter().map(|x| format!(\"{x:02x}\")).collect()\n278\t}\n279\t\n280\t/// Assert two byte slices are identical, printing a hex diff on failure.\n281\t#[track_caller]\n282\tpub fn eq_bytes(ctx: &str, c: &[u8], r: &[u8]) {\n283\t    if c != r {\n284\t        let at = c.iter().zip(r).position(|(a, b)| a != b);\n285\t        panic!(\n286\t            \"{ctx}: C/Rust output differs (first diff at byte {at:?})\\n  C   = {}\\n  Rust= {}\",\n287\t            hex(c),\n288\t            hex(r)\n289\t        );\n290\t    }\n291\t}\n292\t\n293\t#[track_caller]\n294\tpub fn eq_i32(ctx: &str, c: i32, r: i32) {\n295\t    assert_eq!(c, r, \"{ctx}: return value differs (C={c}, Rust={r})\");\n296\t}\n297\t\n298\t// ---------------------------------------------------------------------------\n299\t// errno access (both libraries share this thread's errno via glibc)\n300\t// ---------------------------------------------------------------------------\n301\tuse std::os::raw::c_int;\n302\t\n303\tfn errno_location() -> *mut c_int {\n304\t    // Cache only the FUNCTION pointer, never the address it returns: errno\n305\t    // lives in thread-local storage, so the address differs per thread (the\n306\t    // test harness runs every #[test] on its own thread).\n307\t    static F: OnceLock<usize> = OnceLock::new();\n308\t    let fp = *F.get_or_init(|| unsafe {\n309\t        let this = libloading::os::unix::Library::this();\n310\t        let f: libloading::os::unix::Symbol<unsafe extern \"C\" fn() -> *mut c_int> =\n311\t            this.get(b\"__errno_location\\0\").expect(\"__errno_location\");\n312\t        let fp: unsafe extern \"C\" fn() -> *mut c_int = *f;\n313\t        std::mem::forget(this);\n314\t        fp as usize\n315\t    });\n316\t    unsafe {\n317\t        let f: unsafe extern \"C\" fn() -> *mut c_int = std::mem::transmute(fp);\n318\t        f()\n319\t    }\n320\t}\n321\t\n322\tpub fn errno() -> i32 {\n323\t    unsafe { *errno_location() }\n324\t}\n325\t\n326\tpub fn set_errno(v: i32) {\n327\t    unsafe { *errno_location() = v }\n328\t}\n329\t\n330\tpub const EPERM: i32 = 1;\n331\tpub const ENOMEM: i32 = 12;\n332\tpub const EINVAL: i32 = 22;\n333\tpub const ENOSYS: i32 = 38;\n334\tpub const ERANGE: i32 = 34;\n335\t\n336\t// ---------------------------------------------------------------------------\n337\t// Abort-path differential testing.\n338\t//\n339\t// Several libsodium rejection paths do not return an error code: they call\n340\t// `sodium_misuse()` / `assert()` and kill the process. To compare those between\n341\t// C and Rust we re-exec THIS test binary in a child process, told (via env) to\n342\t// run one specific case against one specific library, and compare how the two\n343\t// children terminated (exit code / signal).\n344\t// ---------------------------------------------------------------------------\n345\tpub const CASE_ENV: &str = \"SODIUM_DIFF_CASE\";\n346\tpub const LIB_ENV: &str = \"SODIUM_DIFF_LIB\";\n347\tpub const CHILD_TEST: &str = \"zz_abort_child\";\n348\t\n349\t#[derive(Debug, PartialEq, Eq)]\n350\tpub struct Term {\n351\t    pub code: Option<i32>,\n352\t    pub signal: Option<i32>,\n353\t}\n354\t\n355\tfn run_child(case: &str, lib: &str) -> Term {\n356\t    use std::os::unix::process::ExitStatusExt;\n357\t    let exe = std::env::current_exe().expect(\"current_exe\");\n358\t    let out = std::process::Command::new(exe)\n359\t        .arg(\"--exact\")\n360\t        .arg(CHILD_TEST)\n361\t        .arg(\"--nocapture\")\n362\t        .arg(\"--test-threads=1\")\n363\t        .env(CASE_ENV, case)\n364\t        .env(LIB_ENV, lib)\n365\t        .env(C_ENV, c_so_path())\n366\t        .env(R_ENV, rust_so_path())\n367\t        .stdout(std::process::Stdio::null())\n368\t        .stderr(std::process::Stdio::null())\n369\t        .output()\n370\t        .expect(\"spawn child\");\n371\t    Term {\n372\t        code: out.status.code(),\n373\t        signal: out.status.signal(),\n374\t    }\n375\t}\n376\t\n377\t/// Which library the current (child) process should exercise, if any.\n378\tpub fn child_case() -> Option<(String, bool)> {\n379\t    let case = std::env::var(CASE_ENV).ok()?;\n380\t    let lib = std::env::var(LIB_ENV).unwrap_or_else(|_| \"c\".into());\n381\t    Some((case, lib == \"c\"))\n382\t}\n383\t\n384\t/// Run `case` in two child processes (C and Rust) and assert they terminated\n385\t/// identically. Returns the shared termination so the caller can additionally\n386\t/// assert it was a signal / a clean exit.\n387\t#[track_caller]\n388\tpub fn diff_abort_case(case: &str) -> Term {\n389\t    let c = run_child(case, \"c\");\n390\t    let r = run_child(case, \"rust\");\n391\t    assert_eq!(\n392\t        c, r,\n393\t        \"abort-path case {case:?}: C terminated {c:?} but Rust terminated {r:?}\"\n394\t    );\n395\t    c\n396\t}\n397\t\n398\t/// Assert the case aborts (SIGABRT=6 / SIGSEGV=11 / SIGKILL=9 / SIGBUS=7)\n399\t/// identically in both libraries.\n400\t#[track_caller]\n401\tpub fn assert_both_abort(case: &str) {\n402\t    let t = diff_abort_case(case);\n403\t    assert!(\n404\t        t.signal.is_some() || t.code == Some(101) || t.code.map(|c| c != 0).unwrap_or(false),\n405\t        \"case {case:?}: expected abnormal termination in both, got {t:?}\"\n406\t    );\n407\t}\n408\t"}]},"parent_tool_use_id":"toolu_bdrk_01QiaBM6Z2JFrEYVe6tn7un9","session_id":"37babf23-64fa-4bd5-8c90-ef1a4034e89f","uuid":"e660fafc-49fc-4f79-a974-b94f9915a8b8","timestamp":"2026-09-08T15:25:20.851Z","subagent_type":"general-purpose","task_description":"Write G5 asymmetric differential tests"}
