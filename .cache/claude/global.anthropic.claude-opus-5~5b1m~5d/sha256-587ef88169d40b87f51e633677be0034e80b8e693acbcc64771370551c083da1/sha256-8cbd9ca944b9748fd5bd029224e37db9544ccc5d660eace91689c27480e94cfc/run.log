   // opslimit=UINT64_MAX with memlimit=0 makes pickparams pick N=2, r=8,\n    // p=0x3fffffff/8 = 134217727, i.e. B_size = 128*r*p = 128 GiB, so the KDF's\n    // allocation fails and escrypt_r returns NULL.\n    let ctx = \"row239 scrypt_str ops=UINT64_MAX mem=0 -> escrypt_r == NULL\";\n    let (rc, e) = dt_str(\n        \"crypto_pwhash_scryptsalsa208sha256_str\",\n        PW,\n        u64::MAX,\n        0,\n        ctx,\n    );\n    assert_eq!(rc, -1, \"{ctx}\");\n    assert_eq!(e, EINVAL, \"{ctx}: expected errno=EINVAL, got {e}\");\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":736,"cache_read_input_tokens":314463,"cache_creation":{"ephemeral_5m_input_tokens":736,"ephemeral_1h_input_tokens":0},"output_tokens":20,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_01AJX15YUFCoqDqVKRXn4NVP","session_id":"37babf23-64fa-4bd5-8c90-ef1a4034e89f","uuid":"2e1244a3-2695-4572-8bc3-b584cc7acc43","timestamp":"2026-09-08T15:57:27.568Z","subagent_type":"general-purpose","task_description":"Write G2 pwhash differential tests"}
