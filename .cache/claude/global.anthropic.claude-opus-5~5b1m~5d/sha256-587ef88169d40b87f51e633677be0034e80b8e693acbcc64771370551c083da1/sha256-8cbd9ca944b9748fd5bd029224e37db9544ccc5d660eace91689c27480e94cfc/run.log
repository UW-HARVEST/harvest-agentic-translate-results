{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01VZU3tFFb7Enh1NnU3KsRaj","type":"tool_result","content":"1\t//! Phase C — error-path differential tests for group G1 (ERRORS.md rows 1-99).\n2\t//!\n3\t//! Rows whose rejection is a *return value* are compared directly.\n4\t//! Rows whose rejection is a `sodium_misuse()` / `assert()` / `_out_of_bounds()`\n5\t//! abort are compared by re-executing this binary in a child process against\n6\t//! one library at a time and comparing how the two children died.\n7\tmod common;\n8\tuse common::*;\n9\tuse std::os::raw::{c_char, c_int, c_void};\n10\tuse std::ptr;\n11\t\n12\t// ===========================================================================\n13\t// child-process driver for the abort rows\n14\t// ===========================================================================\n15\ttype BinToHex = unsafe extern \"C\" fn(*mut c_char, usize, *const u8, usize) -> *mut c_char;\n16\ttype EncLen = unsafe extern \"C\" fn(usize, c_int) -> usize;\n17\ttype Bin2B64 = unsafe extern \"C\" fn(*mut c_char, usize, *const u8, usize, c_int) -> *mut c_char;\n18\ttype B642Bin = unsafe extern \"C\" fn(\n19\t    *mut u8,\n20\t    usize,\n21\t    *const c_char,\n22\t    usize,\n23\t    *const c_char,\n24\t    *mut usize,\n25\t    *mut *const c_char,\n26\t    c_int,\n27\t) -> c_int;\n28\ttype Pad = unsafe extern \"C\" fn(*mut usize, *mut u8, usize, usize, usize) -> c_int;\n29\t\n30\t#[test]\n31\tfn zz_abort_child() {\n32\t    let Some((case, is_c)) = child_case() else {\n33\t        return; // normal test run: nothing to do\n34\t    };\n35\t    let l = libs();\n36\t    let h = if is_c { l.c } else { l.rs };\n37\t    macro_rules! sym {\n38\t        ($t:ty, $n:literal) => {{\n39\t            let s: libloading::Symbol<$t> = unsafe { h.get(concat!($n, \"\\0\").as_bytes()) }.unwrap();\n40\t            s\n41\t        }};\n42\t    }\n43\t    unsafe {\n44\t        match case.as_str() {\n45\t            // --- row 42: sodium_bin2hex, bin_len >= SIZE_MAX / 2 -------------\n46\t            \"bin2hex_binlen_overflow\" => {\n47\t                let f = sym!(BinToHex, \"sodium_bin2hex\");\n48\t                let mut buf = [0u8; 64];\n49\t                // bin pointer is never dereferenced before the misuse check\n50\t                f(\n51\t                    buf.as_mut_ptr() as *mut c_char,\n52\t                    64,\n53\t                    buf.as_ptr(),\n54\t                    usize::MAX / 2,\n55\t                );\n56\t            }\n57\t            // --- row 43: sodium_bin2hex, hex_maxlen <= bin_len*2 -------------\n58\t            \"bin2hex_maxlen_too_small\" => {\n59\t                let f = sym!(BinToHex, \"sodium_bin2hex\");\n60\t                let bin = [1u8, 2, 3, 4];\n61\t                let mut out = [0u8; 16];\n62\t                f(out.as_mut_ptr() as *mut c_char, 8, bin.as_ptr(), 4);\n63\t            }\n64\t            \"bin2hex_maxlen_exact_zero\" => {\n65\t                let f = sym!(BinToHex, \"sodium_bin2hex\");\n66\t                let bin = [1u8];\n67\t                let mut out = [0u8; 8];\n68\t                f(out.as_mut_ptr() as *mut c_char, 0, bin.as_ptr(), 0);\n69\t            }\n70\t            // --- rows 47/48: sodium_base64_encoded_len, invalid variant ------\n71\t            c if c.starts_with(\"encoded_len_variant_\") => {\n72\t                let v: i32 = c.rsplit('_').next().unwrap().parse().unwrap();\n73\t                let f = sym!(EncLen, \"sodium_base64_encoded_len\");\n74\t                let n = f(16, v);\n75\t                std::process::exit((n & 0x7f) as i32);\n76\t            }\n77\t            // --- row 49: sodium_base64_encoded_len overflow ------------------\n78\t            // bin_len / 3 > (SIZE_MAX - 5) / 4  <=>  bin_len > ~0.75 * SIZE_MAX\n79\t            \"encoded_len_overflow\" => {\n80\t                let f = sym!(EncLen, \"sodium_base64_encoded_len\");\n81\t                f(usize::MAX, 1);\n82\t            }\n83\t            \"encoded_len_no_overflow\" => {\n84\t                let f = sym!(EncLen, \"sodium_base64_encoded_len\");\n85\t                let n = f(usize::MAX / 2, 1);\n86\t                std::process::exit((n & 0x3f) as i32);\n87\t            }\n88\t            // --- row 50: sodium_bin2base64, invalid variant ------------------\n89\t            c if c.starts_with(\"bin2b64_variant_\") => {\n90\t                let v: i32 = c.rsplit('_').next().unwrap().parse().unwrap();\n91\t                let f = sym!(Bin2B64, \"sodium_bin2base64\");\n92\t                let bin = [1u8, 2, 3];\n93\t                let mut out = [0u8; 32];\n94\t                f(out.as_mut_ptr() as *mut c_char, 32, bin.as_ptr(), 3, v);\n95\t            }\n96\t            // --- row 51: sodium_bin2base64 overflow --------------------------\n97\t            \"bin2b64_overflow\" => {\n98\t                let f = sym!(Bin2B64, \"sodium_bin2base64\");\n99\t                let bin = [1u8, 2, 3];\n100\t                let mut out = [0u8; 32];\n101\t                f(\n102\t                    out.as_mut_ptr() as *mut c_char,\n103\t                    usize::MAX,\n104\t                    bin.as_ptr(),\n105\t                    usize::MAX / 2,\n106\t                    1,\n107\t                );\n108\t            }\n109\t            // --- row 52: sodium_bin2base64, b64_maxlen too small -------------\n110\t            \"bin2b64_maxlen_too_small\" => {\n111\t                let f = sym!(Bin2B64, \"sodium_bin2base64\");\n112\t                let bin = [1u8, 2, 3];\n113\t                let mut out = [0u8; 32];\n114\t                f(out.as_mut_ptr() as *mut c_char, 4, bin.as_ptr(), 3, 1);\n115\t            }\n116\t            \"bin2b64_maxlen_zero_empty\" => {\n117\t                let f = sym!(Bin2B64, \"sodium_bin2base64\");\n118\t                let bin = [0u8; 1];\n119\t                let mut out = [0u8; 8];\n120\t                f(out.as_mut_ptr() as *mut c_char, 0, bin.as_ptr(), 0, 1);"}]},"parent_to