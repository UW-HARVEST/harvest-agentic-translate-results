     }\n            eq_bytes(&format!(\"{fam} RFC5869 A.1 prk\"), &prk[0], &prk[1]);\n            eq_bytes(&format!(\"{fam} RFC5869 A.1 okm\"), &okm[0], &okm[1]);\n            // RFC 5869 A.3: zero-length salt and info\n            let mut prk2 = [vec![0u8; keybytes], vec![0u8; keybytes]];\n            let mut okm2 = [vec![0u8; 42], vec![0u8; 42]];\n            for i in 0..2 {\n                assert_eq!(\n                    extract[i](prk2[i].as_mut_ptr(), ptr::null(), 0, ikm.as_ptr(), 22),\n                    0\n                );\n                assert_eq!(\n                    expand[i](okm2[i].as_mut_ptr(), 42, ptr::null(), 0, prk2[i].as_ptr()),\n                    0\n                );\n            }\n            eq_bytes(&format!(\"{fam} RFC5869 A.3 prk\"), &prk2[0], &prk2[1]);\n            eq_bytes(&format!(\"{fam} RFC5869 A.3 okm\"), &okm2[0], &okm2[1]);\n        }\n\n        // --- further extract + expand chains --------------------------------\n        for &(sl, il, cl, ol) in &['''\nassert old in s\ns = s.replace(old, new)\nopen(p,'w').write(s)\nprint('ok')\nPYEOF\necho done"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":987,"cache_read_input_tokens":243245,"cache_creation":{"ephemeral_5m_input_tokens":987,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_01YFsDeJBuv2gUaUX1ftWW4d","session_id":"37babf23-64fa-4bd5-8c90-ef1a4034e89f","uuid":"bead5b30-698d-4d6e-8f8b-238b8dc05126","timestamp":"2026-09-08T15:53:20.656Z","subagent_type":"general-purpose","task_description":"Write G3 hashing differential tests"}
