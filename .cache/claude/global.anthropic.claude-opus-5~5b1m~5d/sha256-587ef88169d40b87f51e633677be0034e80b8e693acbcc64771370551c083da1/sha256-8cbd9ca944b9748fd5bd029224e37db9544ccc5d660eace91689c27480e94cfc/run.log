tern \"C\" fn _sodium_argon2_encode_string(\n406\t    dst: *mut c_char,\n407\t    dst_len: usize,\n408\t    ctx: *mut argon2_context,\n409\t    type_: argon2_type,\n410\t) -> c_int {\n411\t    let mut dst = dst;\n412\t    let mut dst_len = dst_len;\n413\t\n414\t    match type_ {\n415\t        argon2_type::Argon2_id => {\n416\t            if !ss(&mut dst, &mut dst_len, b\"$argon2id$v=\") {\n417\t                return ARGON2_ENCODING_FAIL;\n418\t            }\n419\t        }\n420\t        argon2_type::Argon2_i => {\n421\t            if !ss(&mut dst, &mut dst_len, b\"$argon2i$v=\") {\n422\t                return ARGON2_ENCODING_FAIL;\n423\t            }\n424\t        }\n425\t    }\n426\t\n427\t    let validation_result = argon2_validate_inputs(ctx);\n428\t    if validation_result != ARGON2_OK {\n429\t        return validation_result;\n430\t    }\n431\t\n432\t    if !sx(&mut dst, &mut dst_len, ARGON2_VERSION_NUMBER) {\n433\t        return ARGON2_ENCODING_FAIL;\n434\t    }\n435\t    if !ss(&mut dst, &mut dst_len, b\"$m=\") {\n436\t        return ARGON2_ENCODING_FAIL;\n437\t    }\n438\t    if !sx(&mut dst, &mut dst_len, (*ctx).m_cost) {\n439\t        return ARGON2_ENCODING_FAIL;\n440\t    }\n441\t    if !ss(&mut dst, &mut dst_len, b\",t=\") {\n442\t        return ARGON2_ENCODING_FAIL;\n443\t    }\n444\t    if !sx(&mut dst, &mut dst_len, (*ctx).t_cost) {\n445\t        return ARGON2_ENCODING_FAIL;\n446\t    }\n447\t    if !ss(&mut dst, &mut dst_len, b\",p=\") {\n448\t        return ARGON2_ENCODING_FAIL;\n449\t    }\n450\t    if !sx(&mut dst, &mut dst_len, (*ctx).lanes) {\n451\t        return ARGON2_ENCODING_FAIL;\n452\t    }\n453\t\n454\t    if !ss(&mut dst, &mut dst_len, b\"$\") {\n455\t        return ARGON2_ENCODING_FAIL;\n456\t    }\n457\t    if !sb(&mut dst, &mut dst_len, (*ctx).salt, (*ctx).saltlen) {\n458\t        return ARGON2_ENCODING_FAIL;\n459\t    }\n460\t\n461\t    if !ss(&mut dst, &mut dst_len, b\"$\") {\n462\t        return ARGON2_ENCODING_FAIL;\n463\t    }\n