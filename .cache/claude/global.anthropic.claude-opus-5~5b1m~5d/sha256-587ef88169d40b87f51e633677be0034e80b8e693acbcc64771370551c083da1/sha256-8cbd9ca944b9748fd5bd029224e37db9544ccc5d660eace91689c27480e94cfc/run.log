te_index] & ~bit_mask) | (bit_mask & mask);\n303\t}\n304\t\n305\tstatic void\n306\tpfx_shift_left(uint8_t ip16[16])\n307\t{\n308\t    size_t i;\n309\t\n310\t    for (i = 0; i < 15; i++) {\n311\t        ip16[i] = (ip16[i] << 1) | (ip16[i + 1] >> 7);\n312\t    }\n313\t    ip16[15] <<= 1;\n314\t}\n315\t\n316\tstatic void\n317\tpfx_pad_prefix(uint8_t padded_prefix[16], unsigned int prefix_len_bits)\n318\t{\n319\t    memset(padded_prefix, 0, 16);\n320\t    if (prefix_len_bits == 0) {\n321\t        padded_prefix[15] = 0x01;\n322\t    } else {\n323\t        padded_prefix[3]  = 0x01;\n324\t        padded_prefix[14] = 0xff;\n325\t        padded_prefix[15] = 0xff;\n326\t    }\n327\t}\n328\t\n329\tstatic void\n330\tpfx_encrypt(uint8_t *out, const uint8_t *in, const uint8_t *k)\n331\t{\n332\t    KeySchedule  k1keys;\n333\t    KeySchedule  k2keys;\n334\t    uint8_t      diff[16];\n335\t    uint8_t      encrypted[16];\n336\t    uint8_t      padded_prefix[16];\n337\t    uint8_t      t[16];\n338\t    aes_block_t  e1, e2, e;\n339\t    unsigned int prefix_start = 0;\n340\t    unsigned int prefix_len_bits;\n341\t    unsigned int bit_pos;\n342\t    uint8_t      cipher_bit;\n343\t    uint8_t      original_bit;\n344\t    size_t       i;\n345\t    uint8_t      d;\n346\t\n347\t    expand_key(k1keys, k);\n348\t    expand_key(k2keys, k + 16);\n349\t\n350\t    AES_BLOCK_STORE(diff, AES_BLOCK_XOR(k1keys[ROUNDS / 2], k2keys[ROUNDS / 2]));\n351\t    d = 0;\n352\t    for (i = 0; i < 16; i++) {\n353\t        d |= diff[i];\n354\t    }\n355\t    if (d == 0) {\n356\t        for (i = 0; i < 16; i++) {\n357\t            diff[i] = k[i] ^ 0x5a;\n358\t        }\n359\t        expand_key(k2keys, diff);\n360\t    }\n361\t\n362\t    if (is_ipv4_mapped(in)) {\n363\t        prefix_start = 96;\n364\t    }\n365\t\n366\t    pfx_pad_prefix(padded_prefix, prefix_start);\n367\t\n368\t    memset(encrypted, 0, 16);\n369\t    if (prefix_start == 96) {\n370\t        encrypted[10] = 0xff;\n371\t        encrypted[11] = 0xff;\n372\t    }\n373\t\n374\t    for (prefix_len_bits = prefix_start; prefix_len_bits < 128; prefix_len_bits++) {\n375\t        e1 = AES_BLOCK_XOR(AES_BLOCK_LOAD(padded_prefix), k1keys[0]);\n376\t        e2 = AES_BLOCK_XOR(AES_BLOCK_LOAD(padded_prefix), k2keys[0]);\n377\t        for (i = 1; i < ROUNDS; i++) {\n378\t            e1 = AES_ENC(e1, k1keys[i]);\n379\t            e2 = AES_ENC(e2, k2keys[i]);\n380\t        }\n381\t        e1 = AES_ENCLAST(e1, k1keys[ROUNDS]);\n382\t        e2 = AES_ENCLAST(e2, k2keys[ROUNDS]);\n383\t\n384\t        e = AES_BLOCK_XOR(e1, e2);\n385\t        AES_BLOCK_STORE(t, e);\n386\t\n387\t        cipher_bit   = t[15] & 1;\n388\t        bit_pos      = 127 - prefix_len_bits;\n389\t        original_bit = pfx_get_bit(in, bit_pos);\n390\t        pfx_set_bit(encrypted, bit_pos, original_bit ^ cipher_bit);\n391\t\n392\t        pfx_shift_left(padded_prefix);\n393\t        pfx_set_bit(padded_prefix, 0, original_bit);\n394\t    }\n395\t\n396\t    memcpy(out, encrypted, 16);\n397\t    sodium_memzero(diff, sizeof diff);\n398\t    sodium_memzero(k2keys, sizeof k2keys);\n399\t    sodium_memzero(k1keys, sizeof k1keys);\n400\t}\n401\t\n402\tstatic void\n403\tpfx_decrypt(uint8_t *out, const uint8_t *in, const uint8_t *k)\n404\t{\n405\t    KeySchedule  k1keys;\n406\t    KeySchedule  k2keys;\n407\t    uint8_t      diff[16];\n408\t    uint8_t      decrypted[16];\n409\t    uint8_t      padded_prefix[16];\n410\t    uint8_t      t[16];\n411\t    aes_block_t  e1, e2, e;\n412\t    unsigned int prefix_start = 0;\n413\t    unsigned int prefix_len_bits;\n414\t    unsigned int bit_pos;\n415\t    uint8_t      cipher_bit;\n416\t    uint8_t      encrypted_bit;\n417\t    uint8_t      original_bit;\n418\t    size_t       i;\n419\t    uint8_t      d;\n420\t\n421\t    expand_key(k1keys, k);\n422\t    expand_key(k2keys, k + 16);\n423\t\n424\t    AES_BLOCK_STORE(diff, AES_BLOCK_XOR(k1keys[ROUNDS / 2], k2keys[ROUNDS / 2]));\n425\t    d = 0;\n426\t    for (i = 0; i < 16; i++) {\n427\t        d |= diff[i];\n428\t    }\n429\t    if (d == 0) {\n430\t        for (i = 0; i < 16; i++) {\n431\t            diff[i] = k[i] ^ 0x5a;\n432\t        }\n433\t        expand_key(k2keys, diff);\n434\t    }\n435\t\n436\t    if (is_ipv4_mapped(in)) {\n437\t        prefix_start = 96;\n438\t    }\n439\t\n440\t    pfx_pad_prefix(padded_prefix, prefix_start);\n441\t\n442\t    memset(decrypted, 0, 16);\n443\t    if (prefix_start == 96) {\n444\t        decrypted[10] = 0xff;\n445\t        decrypted[11] = 0xff;\n446\t    }\n447\t\n448\t    for (prefix_len_bits = prefix_start; prefix_len_bits < 128; prefix_len_bits++) {\n449\t        e1 = AES_BLOCK_XOR(AES_BLOCK_LOAD(padded_prefix), k1keys[0]);\n450\t        e2 = AES_BLOCK_XOR(AES_BLOCK_LOAD(padded_prefix), k2keys[0]);\n451\t        for (i = 1; i < ROUNDS; i++) {\n452\t            e1 = AES_ENC(e1, k1keys[i]);\n453\t            e2 = AES_ENC(e2, k2keys[i]);\n454\t        }\n455\t        e1 = AES_ENCLAST(e1, k1keys[ROUNDS]);\n456\t        e2 = AES_ENCLAST(e2, k2keys[ROUNDS]);\n457\t\n458\t        e = AES_BLOCK_XOR(e1, e2);\n459\t        AES_BLOCK_STORE(t, e);\n460\t\n461\t        cipher_bit    = t[15] & 1;\n462\t        bit_pos       = 127 - prefix_len_bits;\n463\t        encrypted_bit = pfx_get_bit(in, bit_pos);\n464\t        original_bit  = encrypted_bit ^ cipher_bit;\n465\t        pfx_set_bit(decrypted, bit_pos, original_bit);\n466\t\n467\t        pfx_shift_left(padded_prefix);\n468\t        pfx_set_bit(padded_prefix, 0, original_bit);\n469\t    }\n470\t\n471\t    memcpy(out, decrypted, 16);\n472\t    sodium_memzero(diff, sizeof diff);\n473\t    sodium_memzero(k2keys, sizeof k2keys);\n474\t    sodium_memzero(k1keys, sizeof k1keys);\n475\t}\n476\t\n477\tstruct ipcrypt_implementation ipcrypt_soft_implementation = {\n478\t    SODIUM_C99(.encrypt =) encrypt,         SODIUM_C99(.decrypt =) decrypt,\n479\t    SODIUM_C99(.nd_encrypt =) nd_encrypt,   SODIUM_C99(.nd_decrypt =) nd_decrypt,\n480\t    SODIUM_C99(.ndx_encrypt =) ndx_encrypt, SODIUM_C99(.ndx_decrypt =) ndx_decrypt,\n481\t    SODIUM_C99(.pfx_encrypt =) pfx_encrypt, SODIUM_C99(.pfx_decrypt =) pfx_decrypt\n482\t};\n483\t"}]},"parent_tool_use_id":"toolu_bdrk_01UwFaLP6CiirK4gAc1ZYBnq","session_id":"37babf23-64fa-4bd5-8c90-ef1a4034e89f","uuid":"755ad308-ea78-4787-8c0f-965a9bc386da","timestamp":"2026-09-08T15:07:52.849Z","subagent_type":"general-purpose","task_description":"Enumerate randombytes/kem/ipcrypt error/config"}
