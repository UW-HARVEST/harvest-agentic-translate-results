ub const ARGON2_MEMORY_TOO_LITTLE: c_int = -14;\n41\tpub const ARGON2_MEMORY_TOO_MUCH: c_int = -15;\n42\tpub const ARGON2_LANES_TOO_FEW: c_int = -16;\n43\tpub const ARGON2_LANES_TOO_MANY: c_int = -17;\n44\tpub const ARGON2_PWD_PTR_MISMATCH: c_int = -18;\n45\tpub const ARGON2_SALT_PTR_MISMATCH: c_int = -19;\n46\tpub const ARGON2_SECRET_PTR_MISMATCH: c_int = -20;\n47\tpub const ARGON2_AD_PTR_MISMATCH: c_int = -21;\n48\tpub const ARGON2_MEMORY_ALLOCATION_ERROR: c_int = -22;\n49\tpub const ARGON2_FREE_MEMORY_CBK_NULL: c_int = -23;\n50\tpub const ARGON2_ALLOCATE_MEMORY_CBK_NULL: c_int = -24;\n51\tpub const ARGON2_INCORRECT_PARAMETER: c_int = -25;\n52\tpub const ARGON2_INCORRECT_TYPE: c_int = -26;\n53\tpub const ARGON2_OUT_PTR_MISMATCH: c_int = -27;\n54\tpub const ARGON2_THREADS_TOO_FEW: c_int = -28;\n55\tpub const ARGON2_THREADS_TOO_MANY: c_int = -29;\n56\tpub const ARGON2_MISSING_ARGS: c_int = -30;\n57\tpub const ARGON2_ENCODING_FAIL: c_int = -31;\n58\tpub const ARGON2_DECODING_FAIL: c_int = -32;\n59\tpub const ARGON2_THREAD_FAIL: c_int = -33;\n60\tpub const ARGON2_DECODING_LENGTH_FAIL: c_int = -34;\n61\tpub const ARGON2_VERIFY_MISMATCH: c_int = -35;\n62\t\n63\t/// `argon2_context` (`Argon2_Context`) — must match `argon2.h` field-for-field\n64\t/// (other modules pass pointers to it; layout is `#[repr(C)]`-identical to\n65\t/// the copy defined in `argon2_encoding.rs`).\n66\t#[repr(C)]\n67\tpub struct argon2_context {\n68\t    pub out: *mut u8,\n69\t    pub outlen: u32,\n70\t\n71\t    pub pwd: *mut u8,\n72\t    pub pwdlen: u32,\n73\t\n74\t    pub salt: *mut u8,\n75\t    pub saltlen: u32,\n76\t\n77\t    pub secret: *mut u8,\n78\t    pub secretlen: u32,\n79\t\n80\t    pub ad: *mut u8,\n81\t    pub adlen: u32,\n82\t\n83\t    pub t_cost: u32,\n84\t    pub m_cost: u32,\n85\t    pub lanes: u32,\n86\t    pub threads: u32,\n87\t\n88\t    pub flags: u32,\n89\t}\n90\t\n91\t/// `ARGON2_FLAG_CLEAR_PASSWORD` / `ARGON2_FLAG_CLEAR_SECRET` / `ARGON2_DEFAULT_FLAGS`.\n92\tpub const ARGON