_position_t,\n159\t}\n160\t\n161\ttype fill_segment_fn = unsafe extern \"C\" fn(*const argon2_instance_t, argon2_position_t);\n162\t\n163\t// ---------------------------------------------------------------------\n164\t// Cross-module calls\n165\t// ---------------------------------------------------------------------\n166\t\n167\textern \"C\" {\n168\t    #[link_name = \"_sodium_blake2b_long\"]\n169\t    fn blake2b_long(pout: *mut c_void, outlen: usize, in_: *const c_void, inlen: usize) -> c_int;\n170\t\n171\t    fn crypto_generichash_blake2b_init(\n172\t        state: *mut crypto_generichash_blake2b_state,\n173\t        key: *const u8,\n174\t        keylen: usize,\n175\t        outlen: usize,\n176\t    ) -> c_int;\n177\t    fn crypto_generichash_blake2b_update(\n178\t        state: *mut crypto_generichash_blake2b_state,\n179\t        in_: *const u8,\n180\t        inlen: u64,\n181\t    ) -> c_int;\n182\t    fn crypto_generichash_blake2b_final(\n183\t        state: *mut crypto_generichash_blake2b_state,\n184\t        out: *mut u8,\n185\t        outlen: usize,\n186\t    ) -> c_int;\n187\t\n188\t    fn sodium_memzero(pnt: *mut c_void, len: usize);\n189\t    fn sodium_memcmp(b1: *const c_void, b2: *const c_void, len: usize) -> c_int;\n190\t    fn randombytes_buf(buf: *mut c_void, size: usize);\n191\t\n192\t    #[link_name = \"_sodium_argon2_encode_string\"]\n193\t    fn argon2_encode_string(\n194\t        dst: *mut c_char,\n195\t        dst_len: usize,\n196\t        ctx: *mut argon2_context,\n197\t        type_: argon2_type,\n198\t    ) -> c_int;\n199\t    #[link_name = \"_sodium_argon2_decode_string\"]\n200\t    fn argon2_decode_string(ctx: *mut argon2_context, str_: *const c_char, type_: argon2_type) -> c_int;\n201\t}\n202\t\n203\t// ---------------------------------------------------------------------\n204\t// block helpers: init_block_value / copy_block / xor_block\n205\t// ---------------------------------------------------------------------\n206\t\n207\t#[inline]\n208\tunsafe fn init_block_value(b: *mut block, val: u8) {\n209\t    // memset(b->v, in, sizeof(b->v)) — target is little-endian, so filling\n210\t    // every byte with `val` is the same as filling every u64 word with the\n211\t    // 8-times-repeated byte pattern.\n212\t    let word = u64::from_le_bytes([val; 8]);\n213\t    for i in 0..ARGON2_QWORDS_IN_BLOCK {\n214\t        (*b).v[i] = word;\n215\t    }\n216\t}\n217\t\n218\t#[inline]\n219\tunsafe fn copy_block(dst: *mut block, src: *const block) {\n220\t    (*dst).v = (*src).v;\n221\t}\n222\t\n223\t#[inline]\n224\tunsafe fn xor_block(dst: *mut block, src: *const block) {\n225\t    for i in 0..ARGON2_QWORDS_IN_BLOCK {\n226\t        (*dst).v[i] ^= (*src).v[i];\n227\t    }\n228\t}\n229\t\n230\tfn zero_block() -> block {\n231\t    block { v: [0u64; ARGON2_QWORDS_IN_BLOCK] }\n232\t}\n233\t\n234\t// ---------------------------------------------------------------------\n235\t// index_alpha (`static uint32_t index_alpha(...)` in argon2-core.h)\n236\t// ---------------------------------------------------------------------\n237\t\n238\tunsafe fn index_alpha(\n239\t    instance: *const argon2_instance_t,\n240\t    position: *const argon2_position_t,\n241\t    pseudo_rand: u32,\n242\t    same_lane: bool,\n243\t) -> u32 {\n244\t    let segment_length = (*instance).segment_length;\n245\t    let lane_length = (*instance).lane_length;\n246\t    let pass = (*position).pass;\n247\t    let slice = (*position).slice as u32;\n248\t    let index = (*position).index;\n249\t\n250\t    let reference_area_size: u32;\n251\t    if pass == 0 {\n252\t        if slice == 0 {\n253\t            reference_area_size = index.wrapping_sub(1);\n254\t        } else if same_lane {\n255\t            reference_area_size = slice\n256\t                .wrapping_mul(segment_length)\n257\t                .wrapping_add(index)\n258\t                .wrapping_sub(1);\n259\t        } else {\n260\t            let adj: u32 = if index == 0 { u32::MAX } else { 0 };\n261\t            reference_area_size = slice.wrapping_mul(segment_length).wrapping_add(adj);\n262\t        }\n263\t    } else if same_lane {\n264\t        reference_area_size = lane_length\n265\t            .wrapping_sub(segment_length)\n266\t            .wrapping_add(index)\n267\t            .wrapping_sub(1);\n268\t    } else {\n269\t        let adj: u32 = if index == 0 { u32::MAX } else { 0 };\n270\t        reference_area_size = lane_length.wrapping_sub(segment_length).wrapping_add(adj);\n271\t    }\n272\t\n273\t    let mut relative_position: u64 = pseudo_rand as u64;\n274\t    relative_position = relative_position.wrapping_mul(relative_position) >> 32;\n275\t    let t: u32 = reference_area_size.wrapping_sub(1);\n276\t    let product_term: u64 = (reference_area_size as u64).wrapping_mul(relative_position) >> 32;\n277\t    relative_position = (t as u64).wrapping_sub(product_term);\n278\t\n279\t    let mut start_position: u32 = 0;\n280\t    if pass != 0 {\n281\t        start_position = if slice == ARGON2_SYNC_POINTS - 1 {\n282\t            0\n283\t        } else {\n284\t            (slice.wrapping_add(1)).wrapping_mul(segment_length)\n285\t        };\n286\t    }\n287\t\n288\t    let mut absolute_position: u64 = (start_position as u64)\n289\t        .wrapping_add(relative_position)\n290\t        .wrapping_sub(lane_length as u64);\n291\t    absolute_position = absolute_position.wrapping_add((lane_length as u64) & (absolute_position >> 32));\n292\t    absolute_position as u32\n293\t}\n294\t\n295\t// ===========================================================================\n296\t// crypto_pwhash/argon2/blamka-round-ref.h\n297\t// ===========================================================================\n298\t\n299\t#[inline]\n300\tfn fblamka(x: u64, y: u64) -> u64 {\n301\t    let m: u64 = 0xFFFFFFFF;\n302\t    let xy = (x & m).wrapping_mul(y & m);\n303\t    x.wrapping_add(y).wrapping_add(xy.wrapping_mul(2))\n304\t}\n305\t\n306\t#[inline]\n307\tunsafe fn g(v: &mut [u64; ARGON2_QWORDS_IN_BLOCK], a: usize, b: usize, c: usize, d: usize) {\n308\t    v[a] = fblamka(v[a], v[b]);\n309\t    v[d] = rotr64(v[d] ^ v[a], 32);\n310\t    v[c] = fblamka(v[c], v[d]);\n311\t    v[b] = rotr64(v[b] ^ v[c], 24);\n312\t    v[a] = fblamka(v[a], v[b]);\n313\t    v[d] = rotr64(v[d] ^ v[a], 16);\n314\t    v[c] = fblamka(v[c], v[d]);\n315\t    v[b] = rotr64(v[b] ^ v[c], 63);\n316\t}\n317\t\n318\t/// `BLAKE2_ROUND_NOMSG(v0..v15)`.\n319\t#[inline]\n320\t#[allow(clippy::too_many_arguments)]\n321\tunsafe fn blake2_round_nomsg(\n322\t    v: &mut [u64; ARGON2_QWORDS_IN_BLOCK],\n323\t    v0: usize,\n324\t    v1: usize,\n325\t    v2: usize,\n326\t    v3: usize,\n327\t    v4: usize,\n328\t    v5: usize,\n329\t    v6: usize,\n330\t    v7: usize,\n331\t    v8: usize,\n332\t    v9: usize,\n333\t    v10: usize,\n334\t    v11: usize,\n335\t    v12: usize,\n336\t    v13: usize,\n337\t    v14: usize,\n338\t    v15: usize,\n339\t) {\n340\t    g(v, v0, v4, v8, v12);\n341\t    g(v, v1, v5, v9, v13);\n342\t    g(v, v2, v6, v10, v14);\n343\t    g(v, v3, v7, v11, v15);\n344\t    g(v, v0, v5, v10, v15);\n345\t    g(v, v1, v6, v11, v12);\n346\t    g(v, v2, v7, v8, v13);\n347\t    g(v, v3, v4, v9, v14);\n348\t}\n349\t\n350\t// ===========================================================================\n351\t// crypto_pwhash/argon2/argon2-fill-block-ref.c\n352\t// ===========================================================================\n353\t\n354\tunsafe fn fill_block(prev_block: *const block, ref_block: *const block, next_block: *mut block) {\n355\t    let mut block_r = zero_block();\n356\t    let mut block_tmp = zero_block();\n357\t\n358\t    copy_block(&mut block_r, ref_block);\n359\t    xor_block(&mut block_r, prev_block);\n360\t    copy_block(&mut block_tmp, &block_r);\n361\t\n362\t    for i in 0..8usize {\n363\t        blake2_round_nomsg(\n364\t            &mut block_r.v,\n365\t            16 * i,\n366\t            16 * i + 1,\n367\t            16 * i + 2,\n368\t            16 * i + 3,\n369\t            16 * i + 4,\n370\t            16 * i + 5,\n371\t            16 * i + 6,\n372\t            16 * i + 7,\n373\t            16 * i + 8,\n374\t            16 * i + 9,\n375\t            16 * i + 10,\n376\t            16 * i + 11,\n377\t            16 * i + 12,\n378\t            16 * i + 13,\n379\t            16 * i + 14,\n380\t            16 * i + 15,\n381\t        );\n382\t    }\n383\t\n384\t    for i in 0..8usize {\n385\t        blake2_round_nomsg(\n386\t            &mut block_r.v,\n387\t            2 * i,\n388\t            2 * i + 1,\n389\t            2 * i + 16,\n390\t            2 * i + 17,\n391\t            2 * i + 32,\n392\t            2 * i + 33,\n393\t            2 * i + 48,\n394\t            2 * i + 49,\n395\t            2 * i + 64,\n396\t            2 * i + 65,\n397\t            2 * i + 80,\n398\t            2 * i + 81,\n399\t            2 * i + 96,\n400\t            2 * i + 97,\n401\t            2 * i + 112,\n402\t            2 * i + 113,\n403\t        );\n404\t    }\n405\t\n406\t    copy_block(next_block, &block_tmp);\n407\t    xor_block(next_block, &block_r);\n408\t}\n409\t\n410\tunsafe fn fill_block_with_xor(prev_block: *const block, ref_block: *const block, next_block: *mut block) {\n411\t    let mut block_r = zero_block();\n412\t    let mut block_tmp = zero_block();\n413\t\n414\t    copy_block(&mut block_r, ref_block);\n415\t    xor_block(&mut block_r, prev_block);\n416\t    copy_block(&mut block_tmp, &block_r);\n417\t    xor_block(&mut block_tmp, next_block);\n418\t\n419\t    for i in 0..8usize {\n420\t        blake2_round_nomsg(\n421\t            &mut block_r.v,\n422\t            16 * i,\n423\t            16 * i + 1,\n424\t            16 * i + 2,\n425\t            16 * i + 3,\n426\t            16 * i + 4,\n427\t            16 * i + 5,\n428\t            16 * i + 6,\n429\t            16 * i + 7,\n430\t            16 * i + 8,\n431\t            16 * i + 9,\n432\t            16 * i + 10,\n433\t            16 * i + 11,\n434\t            16 * i + 12,\n435\t            16 * i + 13,\n436\t            16 * i + 14,\n437\t            16 * i + 15,\n438\t        );\n439\t    }\n440\t\n441\t    for i in 0..8usize {\n442\t        blake2_round_nomsg(\n443\t            &mut block_r.v,\n444\t            2 * i,\n445\t            2 * i + 1,\n446\t            2 * i + 16,\n447\t            2 * i + 17,\n448\t            2 * i + 32,\n449\t            2 * i + 33,\n450\t            2 * i + 48,\n451\t            2 * i + 49,\n452\t            2 * i + 64,\n453\t            2 * i + 65,\n454\t            2 * i + 80,\n455\t            2 * i + 81,\n456\t            2 * i + 96,\n457\t            2 * i + 97,\n458\t            2 * i + 112,\n459\t            2 * i + 113,\n460\t        );\n461\t    }\n462\t\n463\t    copy_block(next_block, &block_tmp);\n464\t    xor_block(next_block, &block_r);\n465\t}\n466\t\n467\tunsafe fn generate_addresses(\n468\t    instance: *const argon2_instance_t,\n469\t    position: *const argon2_position_t,\n470\t    pseudo_rands: *mut u64,\n471\t) {\n472\t    let mut zero_blk = zero_block();\n473\t    let mut input_block = zero_block();\n474\t    init_block_value(&mut zero_blk, 0);\n475\t    init_block_value(&mut input_block, 0);\n476\t\n477\t    if !instance.is_null() && !position.is_null() {\n478\t        input_block.v[0] = (*position).pass as u64;\n479\t        input_block.v[1] = (*position).lane as u64;\n480\t        input_block.v[2] = (*position).slice as u64;\n481\t        input_block.v[3] = (*instance).memory_blocks as u64;\n482\t        input_block.v[4] = (*instance).passes as u64;\n483\t        input_block.v[5] = (*instance).type_ as u64;\n484\t\n485\t        let mut tmp_block = zero_block();\n486\t        let mut address_block = zero_block();\n487\t\n488\t        let segment_length = (*instance).segment_length;\n489\t        for i in 0..segment_length {\n490\t            if i % ARGON2_ADDRESSES_IN_BLOCK == 0 {\n491\t                input_block.v[6] = input_block.v[6].wrapping_add(1);\n492\t                init_block_value(&mut tmp_block, 0);\n493\t                init_block_value(&mut address_block, 0);\n494\t                fill_block_with_xor(&zero_blk, &input_block, &mut tmp_block);\n495\t                fill_block_with_xor(&zero_blk, &tmp_block, &mut address_block);\n496\t            }\n497\t\n498\t            *pseudo_rands.add(i as usize) = address_block.v[(i % ARGON2_ADDRESSES_IN_BLOCK) as usize];\n499\t        }\n500\t    }\n501\t}\n502\t\n503\t/// `argon2_fill_segment_ref` -> `_sodium_argon2_fill_segment_ref`.\n504\t#[no_mangle]\n505\tpub unsafe extern \"C\" fn _sodium_argon2_fill_segment_ref(\n506\t    instance: *const argon2_instance_t,\n507\t    mut position: argon2_position_t,\n508\t) {\n509\t    if instance.is_null() {\n510\t        return;\n511\t    }\n512\t\n513\t    let mut data_independent_addressing = true;\n514\t    if (*instance).type_ == argon2_type::Argon2_id\n515\t        && (position.pass != 0 || position.slice as u32 >= ARGON2_SYNC_POINTS / 2)\n516\t    {\n517\t        data_independent_addressing = false;\n518\t    }\n519\t\n520\t    let pseudo_rands: *mut u64 = (*instance).pseudo_rands;\n521\t\n522\t    if data_independent_addressing {\n523\t        generate_addresses(instance, &position, pseudo_rands);\n524\t    }\n525\t\n526\t    let mut starting_index: u32 = 0;\n527\t    if position.pass == 0 && position.slice == 0 {\n528\t        starting_index = 2;\n529\t    }\n530\t\n531\t    let lane_length = (*instance).lane_length;\n532\t    let segment_length = (*instance).segment_length;\n533\t\n534\t    let mut curr_offset: u32 = position\n535\t        .lane\n536\t        .wrapping_mul(lane_length)\n537\t        .wrapping_add((position.slice as u32).wrapping_mul(segment_length))\n538\t        .wrapping_add(starting_index);\n539\t\n540\t    let mut prev_offset: u32 = if curr_offset % lane_length == 0 {\n541\t        curr_offset.wrapping_add(lane_length).wrapping_sub(1)\n542\t    } else {\n543\t        curr_offset.wrapping_sub(1)\n544\t    };\n545\t\n546\t    let region = (*instance).region;\n547\t    let memory: *mut block = (*region).memory;\n548\t\n549\t    let mut i = starting_index;\n550\t    while i < segment_length {\n551\t        if curr_offset % lane_length == 1 {\n552\t            prev_offset = curr_offset.wrapping_sub(1);\n553\t        }\n554\t\n555\t        let pseudo_rand: u64 = if data_independent_addressing {\n556\t            *pseudo_rands.add(i as usize)\n557\t        } else {\n558\t            (*memory.add(prev_offset as usize)).v[0]\n559\t        };\n560\t\n561\t        let mut ref_lane: u64 = (pseudo_rand >> 32) % ((*instance).lanes as u64);\n562\t\n563\t        if position.pass == 0 && position.slice == 0 {\n564\t            ref_lane = position.lane as u64;\n565\t        }\n566\t\n567\t        position.index = i;\n568\t        let ref_index: u64 = index_alpha(\n569\t            instance,\n570\t            &position,\n571\t            (pseudo_rand & 0xFFFFFFFF) as u32,\n572\t            ref_lane == position.lane as u64,\n573\t        ) as u64;\n574\t\n575\t        let ref_block: *mut block =\n576\t            memory.add((lane_length as u64).wrapping_mul(ref_lane).wrapping_add(ref_index) as usize);\n577\t        let curr_block: *mut block = memory.add(curr_offset as usize);\n578\t\n579\t        if position.pass != 0 {\n580\t            fill_block_with_xor(memory.add(prev_offset as usize), ref_block, curr_block);\n581\t        } else {\n582\t            fill_block(memory.add(prev_offset as usize), ref_block, curr_block);\n583\t        }\n584\t\n585\t        i = i.wrapping_add(1);\n586\t        curr_offset = curr_offset.wrapping_add(1);\n587\t        prev_offset = prev_offset.wrapping_add(1);\n588\t    }\n589\t}\n590\t\n591\t// ===========================================================================\n592\t// crypto_pwhash/argon2/argon2-core.c\n593\t// ===========================================================================\n594\t\n595\tstatic mut FILL_SEGMENT: fill_segment_fn = _sodium_argon2_fill_segment_ref;\n596\t\n597\tunsafe fn load_block(dst: *mut block, input: *const u8) {\n598\t    for i in 0..ARGON2_QWORDS_IN_BLOCK {\n599\t        (*dst).v[i] = crate::common::load64_le(input.add(i * 8));\n600\t    }\n601\t}\n602\t\n603\tunsafe fn store_block(output: *mut u8, src: *const block) {\n604\t    for i in 0..ARGON2_QWORDS_IN_BLOCK {\n605\t        crate::common::store64_le(output.add(i * 8), (*src).v[i]);\n606\t    }\n607\t}\n608\t\n609\tunsafe fn allocate_memory(region: *mut *mut block_region, m_cost: u32) -> c_int {\n610\t    if region.is_null() {\n611\t        return ARGON2_MEMORY_ALLOCATION_ERROR;\n612\t    }\n613\t\n614\t    let memory_size: usize = core::mem::size_of::<block>().wrapping_mul(m_cost as usize);\n615\t    if m_cost == 0 || memory_size / (m_cost as usize) != core::mem::size_of::<block>() {\n616\t        return ARGON2_MEMORY_ALLOCATION_ERROR;\n617\t    }\n618\t\n619\t    *region = malloc(core::mem::size_of::<block_region>()) as *mut block_region;\n620\t    if (*region).is_null() {\n621\t        return ARGON2_MEMORY_ALLOCATION_ERROR;\n622\t    }\n623\t    (**region).base = core::ptr::null_mut();\n624\t    (**region).memory = core::ptr::null_mut();\n625\t\n626\t    let mut memory: *mut block = core::ptr::null_mut();\n627\t    let base: *mut c_void;\n628\t    if memory_size.wrapping_add(63) < memory_size {\n629\t        base = core::ptr::null_mut();\n630\t        set_errno(ENOMEM);\n631\t    } else {\n632\t        base = malloc(memory_size.wrapping_add(63));\n633\t        if !base.is_null() {\n634\t            let mut aligned = (base as *mut u8).add(63);\n635\t            let off = (aligned as usize) & 63;\n636\t            aligned = aligned.sub(off);\n637\t            memory = aligned as *mut block;\n638\t        }\n639\t    }\n640\t\n641\t    if base.is_null() {\n642\t        free(*region as *mut c_void);\n643\t        *region = core::ptr::null_mut();\n644\t        return ARGON2_MEMORY_ALLOCATION_ERROR;\n645\t    }\n646\t\n647\t    (**region).base = base;\n648\t    (**region).memory = memory;\n649\t    (**region).size = memory_size;\n650\t\n651\t    ARGON2_OK\n652\t}\n653\t\n654\tunsafe fn free_memory(region: *mut block_region) {\n655\t    if !region.is_null() && !(*region).base.is_null() {\n656\t        free((*region).base);\n657\t    }\n658\t    free(region as *mut c_void);\n659\t}\n660\t\n661\tunsafe fn argon2_free_instance(instance: *mut argon2_instance_t, _flags: u32) {\n662\t    free((*instance).pseudo_rands as *mut c_void);\n663\t    (*instance).pseudo_rands = core::ptr::null_mut();\n664\t    free_memory((*instance).region);\n665\t    (*instance).region = core::ptr::null_mut();\n666\t}\n667\t\n668\t/// `argon2_finalize` -> `_sodium_argon2_finalize`.\n669\t#[no_mangle]\n670\tpub unsafe extern \"C\" fn _sodium_argon2_finalize(context: *const argon2_context, instance: *mut argon2_instance_t) {\n671\t    if context.is_null() || instance.is_null() {\n672\t        return;\n673\t    }\n674\t\n675\t    let mut blockhash = zero_block();\n676\t    let region = (*instance).region;\n677\t    let memory = (*region).memory;\n678\t    let lane_length = (*instance).lane_length;\n679\t\n680\t    copy_block(&mut blockhash, memory.add((lane_length - 1) as usize));\n681\t\n682\t    for l in 1..(*instance).lanes {\n683\t        let last_block_in_lane = l.wrapping_mul(lane_length).wrapping_add(lane_length.wrapping_sub(1));\n684\t        xor_block(&mut blockhash, memory.add(last_block_in_lane as usize));\n685\t    }\n686\t\n687\t    let mut blockhash_bytes: [u8; ARGON2_BLOCK_SIZE] = [0u8; ARGON2_BLOCK_SIZE];\n688\t    store_block(blockhash_bytes.as_mut_ptr(), &blockhash);\n689\t    blake2b_long(\n690\t        (*context).out as *mut c_void,\n691\t        (*context).outlen as usize,\n692\t        blockhash_bytes.as_ptr() as *const c_void,\n693\t        ARGON2_BLOCK_SIZE,\n694\t    );\n695\t    sodium_memzero(blockhash.v.as_mut_ptr() as *mut c_void, ARGON2_BLOCK_SIZE);\n696\t    sodium_memzero(blockhash_bytes.as_mut_ptr() as *mut c_void, ARGON2_BLOCK_SIZE);\n697\t\n698\t    argon2_free_instance(instance, (*context).flags);\n699\t}\n700\t\n701\t/// `argon2_fill_memory_blocks` -> `_sodium_argon2_fill_memory_blocks`.\n702\t#[no_mangle]\n703\tpub unsafe extern \"C\" fn _sodium_argon2_fill_memory_blocks(instance: *mut argon2_instance_t, pass: u32) {\n704\t    if instance.is_null() || (*instance).lanes == 0 {\n705\t        return;\n706\t    }\n707\t\n708\t    let mut position = argon2_position_t { pass, lane: 0, slice: 0, index: 0 };\n709\t    for s in 0..ARGON2_SYNC_POINTS {\n710\t        position.slice = s as u8;\n711\t        for l in 0..(*instance).lanes {\n712\t            position.lane = l;\n713\t            position.index = 0;\n714\t            FILL_SEGMENT(instance as *const argon2_instance_t, position);\n715\t        }\n716\t    }\n717\t}\n718\t\n719\t// Meaningful bounds from argon2.h / argon2-core.h (values that can never be\n720\t// exceeded because the field is already a `uint32_t` are kept for fidelity\n721\t// even though they are then always-false comparisons, matching the C code).\n722\tconst ARGON2_MIN_OUTLEN: u32 = 16;\n723\tconst ARGON2_MAX_OUTLEN: u32 = 0xFFFFFFFF;\n724\tconst ARGON2_MAX_PWDLEN: u32 = 0xFFFFFFFF;\n725\tconst ARGON2_MIN_SALT_LENGTH: u32 = 8;\n726\tconst ARGON2_MAX_SALT_LENGTH: u32 = 0xFFFFFFFF;\n727\tconst ARGON2_MAX_SECRETLEN: u32 = 0xFFFFFFFF;\n728\tconst ARGON2_MAX_ADLEN: u32 = 0xFFFFFFFF;\n729\tconst ARGON2_MIN_LANES: u32 = 1;\n730\tconst ARGON2_MAX_LANES: u32 = 0xFFFFFF;\n731\tconst ARGON2_MIN_MEMORY: u32 = 2 * ARGON2_SYNC_POINTS;\n732\tconst ARGON2_MAX_MEMORY: u32 = 0xFFFFFFFF;\n733\tconst ARGON2_MIN_TIME: u32 = 1;\n734\tconst ARGON2_MAX_TIME: u32 = 0xFFFFFFFF;\n735\tconst ARGON2_MIN_THREADS: u32 = 1;\n736\tconst ARGON2_MAX_THREADS: u32 = 0xFFFFFF;\n737\t\n738\t/// `argon2_validate_inputs` -> `_sodium_argon2_validate_inputs`.\n739\t#[no_mangle]\n740\tpub unsafe extern \"C\" fn _sodium_argon2_validate_inputs(context: *const argon2_context) -> c_int {\n741\t    if context.is_null() {\n742\t        return ARGON2_INCORRECT_PARAMETER;\n743\t    }\n744\t    let ctx = &*context;\n745\t\n746\t    if ctx.out.is_null() {\n747\t        return ARGON2_OUTPUT_PTR_NULL;\n748\t    }\n749\t    if ARGON2_MIN_OUTLEN > ctx.outlen {\n750\t        return ARGON2_OUTPUT_TOO_SHORT;\n751\t    }\n752\t    if ARGON2_MAX_OUTLEN < ctx.outlen {\n753\t        return ARGON2_OUTPUT_TOO_LONG;\n754\t    }\n755\t\n756\t    if ctx.pwd.is_null() && ctx.pwdlen != 0 {\n757\t        return ARGON2_PWD_PTR_MISMATCH;\n758\t    }\n759\t    if ARGON2_MAX_PWDLEN < ctx.pwdlen {\n760\t        return ARGON2_PWD_TOO_LONG;\n761\t    }\n762\t\n763\t    if ctx.salt.is_null() && ctx.saltlen != 0 {\n764\t        return ARGON2_SALT_PTR_MISMATCH;\n765\t    }\n766\t    if ARGON2_MIN_SALT_LENGTH > ctx.saltlen {\n767\t        return ARGON2_SALT_TOO_SHORT;\n768\t    }\n769\t    if ARGON2_MAX_SALT_LENGTH < ctx.saltlen {\n770\t        return ARGON2_SALT_TOO_LONG;\n771\t    }\n772\t\n773\t    if ctx.secret.is_null() {\n774\t        if ctx.secretlen != 0 {\n775\t            return ARGON2_SECRET_PTR_MISMATCH;\n776\t        }\n777\t    } else if ARGON2_MAX_SECRETLEN < ctx.secretlen {\n778\t        return ARGON2_SECRET_TOO_LONG;\n779\t    }\n780\t\n781\t    if ctx.ad.is_null() {\n782\t        if ctx.adlen != 0 {\n783\t            return ARGON2_AD_PTR_MISMATCH;\n784\t        }\n785\t    } else if ARGON2_MAX_ADLEN < ctx.adlen {\n786\t        return ARGON2_AD_TOO_LONG;\n787\t    }\n788\t\n789\t    if ARGON2_MIN_LANES > ctx.lanes {\n790\t        return ARGON2_LANES_TOO_FEW;\n791\t    }\n792\t    if ARGON2_MAX_LANES < ctx.lanes {\n793\t        return ARGON2_LANES_TOO_MANY;\n794\t    }\n795\t\n796\t    if ARGON2_MIN_MEMORY > ctx.m_cost {\n797\t        return ARGON2_MEMORY_TOO_LITTLE;\n798\t    }\n799\t    if ARGON2_MAX_MEMORY < ctx.m_cost {\n800\t        return ARGON2_MEMORY_TOO_MUCH;\n801\t    }\n802\t    if ctx.m_cost < 8u32.wrapping_mul(ctx.