oly1305_block_size],\n104\t    final_: u8,\n105\t}\n106\t\n107\tconst _: () = assert!(\n108\t    core::mem::size_of::<crypto_onetimeauth_poly1305_state>()\n109\t        >= core::mem::size_of::<poly1305_state_internal_t>()\n110\t);\n111\t\n112\tunsafe fn poly1305_init(st: *mut poly1305_state_internal_t, key: *const u8) {\n113\t    // r &= 0xffffffc0ffffffc0ffffffc0fffffff - wiped after finalization\n114\t    (*st).r[0] = (load32_le(key.add(0)) as u64) & 0x3ffffff;\n115\t    (*st).r[1] = ((load32_le(key.add(3)) as u64) >> 2) & 0x3ffff03;\n116\t    (*st).r[2] = ((load32_le(key.add(6)) as u64) >> 4) & 0x3ffc0ff;\n117\t    (*st).r[3] = ((load32_le(key.add(9)) as u64) >> 6) & 0x3f03fff;\n118\t    (*st).r[4] = ((load32_le(key.add(12)) as u64) >> 8) & 0x00fffff;\n119\t\n120\t    // h = 0\n121\t    (*st).h[0] = 0;\n122\t    (*st).h[1] = 0;\n123\t    (*st).h[2] = 0;\n124\t    (*st).h[3] = 0;\n125\t    (*st).h[4] = 0;\n126\t\n127\t    // save pad for later\n128\t    (*st).pad[0] = load32_le(key.add(16)) as u64;\n129\t    (*st).pad[1] = load32_le(key.add(20)) as u64;\n130\t    (*st).pad[2] = load32_le(key.add(24)) as u64;\n131\t    (*st).pad[3] = load32_le(key.add(28)) as u64;\n132\t\n133\t    (*st).leftover = 0;\n134\t    (*st).final_ = 0;\n135\t}\n136\t\n137\tunsafe fn poly1305_blocks(st: *mut poly1305_state_internal_t, mut m: *const u8, mut bytes: u64) {\n138\t    let hibit: u64 = if (*st).final_ != 0 { 0u64 } else { 1u64 << 24 }; // 1 << 128\n139\t\n140\t    let r0: u64 = (*st).r[0];\n141\t    let r1: u64 = (*st).r[1];\n142\t    let r2: u64 = (*st).r[2];\n143\t    let r3: u64 = (*st).r[3];\n144\t    let r4: u64 = (*st).r[4];\n145\t\n146\t    let s1: u64 = r1.wrapping_mul(5);\n147\t    let s2: u64 = r2.wrapping_mul(5);\n148\t    let s3: u64 = r3.wrapping_mul(5);\n149\t    let s4: u64 = r4.wrapping_mul(5);\n150\t\n151\t    let mut h0: u64 = (*st).h[0];\n152\t    let mut h1: u64 = (*st).h[1];\n153\t    let mut h2: u64 = (*st).h[2];\n154\t    let mut h3: u64 = (*st).h[3];\n155\