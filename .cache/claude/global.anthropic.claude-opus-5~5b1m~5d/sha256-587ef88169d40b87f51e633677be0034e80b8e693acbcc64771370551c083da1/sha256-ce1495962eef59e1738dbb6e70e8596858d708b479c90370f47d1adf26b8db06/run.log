{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_016goRYjo2Z1dvDmyP5DpDak","type":"tool_result","content":"1\t//! Translation of `crypto_aead/aegis256/aead_aegis256.c` and\n2\t//! `crypto_aead/aegis256/aegis256_soft.c` (which textually includes\n3\t//! `aegis256_common.h` after defining the `AES_BLOCK_*` macro layer over\n4\t//! `softaes`).\n5\t//!\n6\t//! The reference build has no `HAVE_AVX*`/AES-NI/ARM-crypto support, so only\n7\t//! the \"soft\" (bitsliced constant-time) AES implementation is compiled, and\n8\t//! `_crypto_aead_aegis256_pick_best_implementation` always selects it.\n9\t\n10\t#![allow(non_upper_case_globals)]\n11\t\n12\tuse core::ffi::{c_int, c_void};\n13\t\n14\tuse crate::common::{load32_le, store32_le, SODIUM_SIZE_MAX};\n15\tuse crate::csys::{memcpy, memset};\n16\t\n17\textern \"C\" {\n18\t    fn sodium_misuse() -> !;\n19\t    fn randombytes_buf(buf: *mut c_void, size: usize);\n20\t    fn crypto_verify_16(x: *const u8, y: *const u8) -> c_int;\n21\t    fn crypto_verify_32(x: *const u8, y: *const u8) -> c_int;\n22\t}\n23\t\n24\t// ---------------------------------------------------------------------\n25\t// include/sodium/private/softaes.h\n26\t// ---------------------------------------------------------------------\n27\t\n28\t#[repr(C)]\n29\t#[derive(Clone, Copy)]\n30\tstruct SoftAesBlock {\n31\t    w0: u32,\n32\t    w1: u32,\n33\t    w2: u32,\n34\t    w3: u32,\n35\t}\n36\t\n37\textern \"C\" {\n38\t    #[link_name = \"_sodium_softaes_block_encrypt\"]\n39\t    fn softaes_block_encrypt(block: SoftAesBlock, rk: SoftAesBlock) -> SoftAesBlock;\n40\t}\n41\t\n42\t#[inline(always)]\n43\tunsafe fn softaes_block_load(inp: *const u8) -> SoftAesBlock {\n44\t    SoftAesBlock {\n45\t        w0: load32_le(inp),\n46\t        w1: load32_le(inp.add(4)),\n47\t        w2: load32_le(inp.add(8)),\n48\t        w3: load32_le(inp.add(12)),\n49\t    }\n50\t}\n51\t\n52\t#[inline(always)]\n53\tfn softaes_block_load64x2(a: u64, b: u64) -> SoftAes