g2_p: *mut u32,\n55\t        r_p: *mut u32,\n56\t        p_p: *mut u32,\n57\t    ) -> *const u8;\n58\t}\n59\t\n60\t/// `escrypt_local_t` — mirrors `escrypt_region_t` from `crypto_scrypt.h`.\n61\t#[repr(C)]\n62\tstruct escrypt_local_t {\n63\t    base: *mut c_void,\n64\t    aligned: *mut c_void,\n65\t    size: usize,\n66\t}\n67\t\n68\t// ---------------------------------------------------------------------\n69\t// crypto_pwhash_scryptsalsa208sha256.h constants\n70\t// ---------------------------------------------------------------------\n71\tconst BYTES_MIN: usize = 16;\n72\tconst PASSWD_MIN: u64 = 0;\n73\tconst SALTBYTES: usize = 32;\n74\tconst STRBYTES: usize = 102;\n75\tconst OPSLIMIT_MIN: u64 = 32768;\n76\tconst OPSLIMIT_MAX: u64 = 4294967295;\n77\tconst MEMLIMIT_MIN: usize = 16777216;\n78\tconst OPSLIMIT_INTERACTIVE: u64 = 524288;\n79\tconst MEMLIMIT_INTERACTIVE: usize = 16777216;\n80\tconst OPSLIMIT_SENSITIVE: u64 = 33554432;\n81\tconst MEMLIMIT_SENSITIVE: usize = 1073741824;\n82\t\n83\t// crypto_scrypt.h\n84\tconst STRSALTBYTES: usize = 32;\n85\tconst STRSETTINGBYTES: usize = 57;\n86\t\n87\tstatic STRPREFIX_CSTR: &[u8; 4] = b\"$7$\\0\";\n88\t\n89\t#[inline]\n90\tfn bytes2chars(bytes: usize) -> usize {\n91\t    (bytes * 8 + 5) / 6\n92\t}\n93\t\n94\t// ---------------------------------------------------------------------\n95\t\n96\tunsafe fn pickparams(\n97\t    mut opslimit: u64,\n98\t    memlimit: usize,\n99\t    n_log2: *mut u32,\n100\t    p: *mut u32,\n101\t    r: *mut u32,\n102\t) -> c_int {\n103\t    let maxn: u64;\n104\t    let mut maxrp: u64;\n105\t\n106\t    if opslimit < 32768 {\n107\t        opslimit = 32768;\n108\t    }\n109\t    *r = 8;\n110\t    if opslimit < (memlimit as u64) / 32 {\n111\t        *p = 1;\n112\t        maxn = opslimit / ((*r as u64) * 4);\n113\t        *n_log2 = 1;\n114\t        while *n_log2 < 63 {\n115\t            if (1u64 << *n_log2) > maxn / 2 {\n116\t                break;\n117\t            }\n118\t            *n_log2 += 1;\n1