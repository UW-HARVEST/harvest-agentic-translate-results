{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_016n7Dp2dE5v5yBiVcTkkBwa","type":"tool_result","content":"1\t//! Differential-test harness: loads BOTH the C `libsodium.so` and the Rust\n2\t//! `liblibsodium.so` with `libloading` and calls every function through the FFI\n3\t//! boundary, exactly as an external consumer would.\n4\t//!\n5\t//! Nothing in this crate is ever called directly — only via `dlopen`/`dlsym`.\n6\t#![allow(dead_code)]\n7\t#![allow(unused_macros)]\n8\t\n9\tuse libloading::Library;\n10\tuse std::path::PathBuf;\n11\tuse std::sync::OnceLock;\n12\t\n13\tpub struct Pair {\n14\t    pub c: Library,\n15\t    pub r: Library,\n16\t}\n17\t\n18\tfn rust_so_path() -> PathBuf {\n19\t    // test exe lives at <target>/<profile>/deps/<name>-<hash>; the cdylib is at\n20\t    // <target>/<profile>/liblibsodium.so\n21\t    let exe = std::env::current_exe().expect(\"current_exe\");\n22\t    let profile_dir = exe\n23\t        .parent()\n24\t        .and_then(|p| p.parent())\n25\t        .expect(\"profile dir\")\n26\t        .to_path_buf();\n27\t    let p = profile_dir.join(\"liblibsodium.so\");\n28\t    if p.exists() {\n29\t        return p;\n30\t    }\n31\t    // fallbacks\n32\t    for prof in [\"release\", \"debug\"] {\n33\t        let q = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n34\t            .join(\"target\")\n35\t            .join(prof)\n36\t            .join(\"liblibsodium.so\");\n37\t        if q.exists() {\n38\t            return q;\n39\t        }\n40\t    }\n41\t    panic!(\"cannot locate Rust liblibsodium.so (looked at {:?})\", p);\n42\t}\n43\t\n44\tfn c_so_path() -> PathBuf {\n45\t    if let Ok(p) = std::env::var(\"C_SODIUM_SO\") {\n46\t        return PathBuf::from(p);\n47\t    }\n48\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n49\t        .join(\"..\")\n50\t        .join(\"c_src\")\n51\t        .join(\"build\")\n52\t        .join(\"libsodium.so\")\n53\t}\n54\t\n55\tstatic LIBS: OnceLock<Pair> = OnceLock::new();\n56\t\n57\tpub fn libs() -> &'static Pair {\n58\t    LIBS.get_or_init(|| {\n59\t        let cp = c_so_path();\n60\t        let rp = rust_so_path();\n61\t        let c = unsafe { Library::new(&cp) }\n62\t            .unwrap_or_else(|e| panic!(\"dlopen C {:?}: {}\", cp, e));\n63\t        let r = unsafe { Library::new(&rp) }\n64\t            .unwrap_or_else(|e| panic!(\"dlopen Rust {:?}: {}\", rp, e));\n65\t        // Both libraries need sodium_init() before some primitives are usable\n66\t        // (runtime implementation selection). Call it on both.\n67\t        unsafe {\n68\t            let ci = c\n69\t                .get::<unsafe extern \"C\" fn() -> i32>(b\"sodium_init\\0\")\n70\t                .unwrap();\n71\t            let ri = r\n72\t                .get::<unsafe extern \"C\" fn() -> i32>(b\"sodium_init\\0\")\n73\t                .unwrap();\n74\t            assert_eq!(ci(), ri(), \"sodium_init return mismatch\");\n75\t        }\n76\t        Pair { c, r }\n77\t    })\n78\t}\n79\t\n80\t/// Fetch a function pointer of type `$t` named `$name` from library `$lib`.\n81\t#[macro_export]\n82\tmacro_rules! getsym {\n83\t    ($lib:expr, $name:expr, $t:ty) => {{\n84\t        let s: libloading::Symbol<$t> = unsafe {\n85\t            $lib.get(concat!($name, \"\\0\").as_bytes())\n86\t                .unwrap_or_else(|e| panic!(\"missing symbol {}: {}\", $name, e))\n87\t        };\n88\t        *s\n89\t    }};\n90\t}\n91\t\n92\t/// Fetch the same symbol from both libraries: `let (c, r) = both!(\"name\", ty);`\n93\t#[macro_export]\n94\tmacro_rules! both {\n95\t    ($name:expr, $t:ty) => {{\n96\t        let l = $crate::common::libs();\n97\t        (\n98\t            $crate::getsym!(l.c, $name, $t),\n99\t            $crate::getsym!(l.r, $name, $t),\n100\t        )\n101\t    }};\n102\t}\n103\t\n104\t/// Fetch a data symbol (pointer to exported object) from both libraries.\n105\t#[macro_export]\n106\tmacro_rules! both_data {\n107\t    ($name:expr, $t:ty) => {{\n108\t        let l = $crate::common::libs();\n109\t        unsafe {\n110\t            let cs: libloading::Symbol<*const $t> =\n111\t                l.c.get(concat!($name, \"\\0\").as_bytes()).unwrap();\n112\t            let rs: libloading::Symbol<*const $t> =\n113\t                l.r.get(concat!($name, \"\\0\").as_bytes()).unwrap();\n114\t            (*cs, *rs)\n115\t        }\n116\t    }};\n117\t}\n118\t\n119\t// ---------------------------------------------------------------- rng --------\n120\t\n121\t/// Deterministic splitmix64-based PRNG (fixed seed ⇒ reproducible tests).\n122\tpub struct Rng(pub u64);\n123\t\n124\timpl Rng {\n125\t    pub fn new(seed: u64) -> Self {\n126\t        Rng(seed ^ 0x9E37_79B9_7F4A_7C15)\n127\t    }\n128\t    pub fn next_u64(&mut self) -> u64 {\n129\t        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);\n130\t        let mut z = self.0;\n131\t        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);\n132\t        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);\n133\t        z ^ (z >> 31)\n134\t    }\n135\t    pub fn u8(&mut self) -> u8 {\n136\t        (self.next_u64() >> 33) as u8\n137\t    }\n138\t    pub fn below(&mut self, n: usize) -> usize {\n139\t        if n == 0 {\n140\t            0\n141\t        } else {\n142\t            (self.next_u64() % n as u64) as usize\n143\t        }\n144\t    }\n145\t    pub fn fill(&mut self, buf: &mut [u8]) {\n146\t        for b in buf.iter_mut() {\n147\t            *b = self.u8();\n148\t        }\n149\t    }\n150\t    pub fn bytes(&mut self, n: usize) -> Vec<u8> {\n151\t        let mut v = vec![0u8; n];\n152\t        self.fill(&mut v);\n153\t        v\n154\t    }\n155\t}\n156\t\n157\t// ------------------------------------------------------------- helpers -------\n158\t\n159\tpub fn hex(b: &[u8]) -> String {\n160\t    b.iter().map(|x| format!(\"{:02x}\", x)).collect()\n161\t}\n162\t\n163\t/// Assert two byte buffers are identical, printing hex on failure.\n164\tpub fn eqb(ctx: &str, c: &[u8], r: &[u8]) {\n165\t    if c != r {\n166\t        panic!(\n167\t            \"{}: byte mismatch\\n  C   = {}\\n  Rust= {}\",\n168\t            ctx,\n169\t            hex(c),\n170\t            hex(r)\n171\t        );\n172\t    }\n173\t}\n174\t\n175\tpub fn eqi(ctx: &str, c: i32, r: i32) {\n176\t    assert_eq!(c, r, \"{}: return-value mismatch\", ctx);\n177\t}\n178\t"}]},"parent_tool_use_id":"toolu_bdrk_01UA4mXwNQXmScfm2RaLPYfv","session_id":"f6aed658-f045-47ac-a150-aec5e315d5dc","uuid":"ac80992b-231b-42f5-b97b-ce80aad275fb","timestamp":"2026-09-04T03:28:50.218Z","subagent_type":"general-purpose","task_description":"Verify chacha20poly1305 aead/secretbox"}
