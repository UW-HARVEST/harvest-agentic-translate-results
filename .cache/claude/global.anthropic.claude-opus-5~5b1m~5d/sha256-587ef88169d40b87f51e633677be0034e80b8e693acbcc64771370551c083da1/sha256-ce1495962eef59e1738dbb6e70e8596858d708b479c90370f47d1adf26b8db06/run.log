     while i < 4 {\n696\t            if i != 0 {\n697\t                *p = b'.' as c_char;\n698\t                p = p.add(1);\n699\t            }\n700\t            ip_write_num(&mut p, *bin.add(12 + i as usize) as u32, 10);\n701\t            i += 1;\n702\t        }\n703\t        len = p.offset_from(buf.as_ptr()) as usize;\n704\t        if len >= ip_maxlen {\n705\t            return core::ptr::null_mut();\n706\t        }\n707\t        memcpy(\n708\t            ip as *mut c_void,\n709\t            buf.as_ptr() as *const c_void,\n710\t            (len + 1) as size_t,\n711\t        );\n712\t        *ip.add(len) = 0;\n713\t\n714\t        return ip;\n715\t    }\n716\t    i = 0;\n717\t    while i < 8 {\n718\t        let word = ((*bin.add(i as usize * 2) as u32) << 8) | (*bin.add(i as usize * 2 + 1) as u32);\n719\t\n720\t        if word == 0 {\n721\t            if cur_start < 0 {\n722\t                cur_start = i;\n723\t            }\n724\t            cur_len += 1;\n725\t        } else {\n726\t            if cur_len > best_len {\n727\t                best_start = cur_start;\n728\t                best_len = cur_len;\n729\t            }\n730\t            cur_start = -1;\n731\t            cur_len = 0;\n732\t        }\n733\t        i += 1;\n734\t    }\n735\t    if cur_len > best_len {\n736\t        best_start = cur_start;\n737\t        best_len = cur_len;\n738\t    }\n739\t    if best_len < 2 {\n740\t        best_start = -1;\n741\t    }\n742\t    i = 0;\n743\t    while i < 8 {\n744\t        if i == best_start {\n745\t            *p = b':' as c_char;\n746\t            p = p.add(1);\n747\t            *p = b':' as c_char;\n748\t            p = p.add(1);\n749\t            i += best_len - 1;\n750\t            i += 1;\n751\t            continue;\n752\t        }\n753\t        if i != 0 && (best_start < 0 || i != best_start + best_len) {\n754\t            *p = b':' as c_char;\n755\t            p = p.add(1);\n756\t        }\n757\t        ip_write_num(\n758\t            &mut p,\n759\