<< 24)) ^\n510\t             rk.w2;\n511\t    out.w3 = ((uint32_t) INV_SBOX[t3 & 0xff] | ((uint32_t) INV_SBOX[(t3 >> 8) & 0xff] << 8) |\n512\t              ((uint32_t) INV_SBOX[(t3 >> 16) & 0xff] << 16) |\n513\t              ((uint32_t) INV_SBOX[(t3 >> 24) & 0xff] << 24)) ^\n514\t             rk.w3;\n515\t\n516\t    return out;\n517\t}\n518\t#else\n519\t\n520\t/*\n521\t * Without FAVOR_PERFORMANCE the round is computed with SRM-1R, a bitsliced\n522\t * representation that holds the block as eight 32-bit bit planes (the real\n523\t * 16 lanes are duplicated into the high halfword so a row rotation is a\n524\t * plain 32-bit rotate). ShiftRows is folded into the input packing, SubBytes\n525\t * is a gate-only Boolean S-box circuit, and MixColumns is a fixed sequence of\n526\t * rotations and XORs. No step indexes memory with secret data, so the round\n527\t * is constant-time on every platform.\n528\t */\n529\t\n530\tstatic inline uint32_t\n531\tsrm1r_dup16(uint32_t x)\n532\t{\n533\t    x &= 0xffff;\n534\t    return x | (x << 16);\n535\t}\n536\t\n537\tstatic inline uint32_t\n538\tsrm1r_ror16(uint32_t x, unsigned int n)\n539\t{\n540\t    /* SRM-1R duplicates the low halfword, so a 16-lane rotate is a 32-bit rotate. */\n541\t    return (x >> n) | (x << (32 - n));\n542\t}\n543\t\n544\tstatic inline uint32_t\n545\tsrm1r_ror32(uint32_t x, unsigned int n)\n546\t{\n547\t    return (x >> n) | (x << (32 - n));\n548\t}\n549\t\n550\tstatic inline uint32_t\n551\tsrm1r_load_row_words(const SoftAesBlock block, unsigned int shift)\n552\t{\n553\t    return ((block.w0 >> shift) & 0xffu) | (((block.w1 >> shift) & 0xffu) << 8) |\n554\t           (((block.w2 >> shift) & 0xffu) << 16) | (((block.w3 >> shift) & 0xffu) << 24);\n555\t}\n556\t\n557\tstatic inline uint32_t\n558\tsrm1r_store_column_word(uint32_t row0, uint32_t row1, uint32_t row2, uint32_t row3, unsigned int shift)\n559\t{\n560\t    return ((row0 >> shift) & 0xffu) | (((row1 >> shift) & 0xffu) << 8) |\n561\t           (((row2 >> shift) & 0xffu) << 16) | (((row3 >> shift) & 0xffu) << 24);\n562\t}\n563\t\n564\tstatic inline uint32_t\n565\tsrm1r_gather_row_bit(uint32_t row_word, unsigned int bit)\n566\t{\n567\t    return (((row_word >> bit) & 0x01010101u) * 0x01020408u) >> 24;\n568\t}\n569\t\n570\tstatic inline uint32_t\n571\tsrm1r_pack_rows_bit(uint32_t row0, uint32_t row1, uint32_t row2, uint32_t row3, unsigned int bit)\n572\t{\n573\t    return srm1r_dup16(srm1r_gather_row_bit(row0, bit) | (srm1r_gather_row_bit(row1, bit) << 4) |\n574\t                       (srm1r_gather_row_bit(row2, bit) << 8) |\n575\t                       (srm1r_gather_row_bit(row3, bit) << 12));\n576\t}\n577\t\n578\tstatic inline uint32_t\n579\tsrm1r_spread_row_bits(uint32_t nibble, unsigned int bit)\n580\t{\n581\t    nibble &= 0x0fu;\n582\t    return ((nibble * 0x00204081u) & 0x01010101u) << bit;\n583\t}\n584\t\n585\tstatic inline uint32_t\n586\tsrm1r_unpack_row_word(const uint32_t planes[8], unsigned int row)\n587\t{\n588\t    const unsigned int lane_shift = 4u * row;\n589\t\n590\t    return srm1r_spread_row_bits(planes[0] >> lane_shift, 7) |\n591\t           srm1r_spread_row_bits(planes[1] >> lane_shift, 6) |\n592\t           srm1r_spread_row_bits(planes[2] >> lane_shift, 5) |\n593\t           srm1r_spread_row_bits(planes[3] >> lane_shift, 4) |\n594\t           srm1r_spread_row_bits(planes[4] >> lane_shift, 3) |\n595\t           srm1r_spread_row_bits(planes[5] >> lane_shift, 2) |\n596\t           srm1r_spread_row_bits(planes[6] >> lane_shift, 1) |\n597\t           srm1r_spread_row_bits(planes[7] >> lane_shift, 0);\n598\t}\n599\t\n600\tstatic inline void\n601\tsrm1r_pack_planes(uint32_t planes[8], uint32_t row0, uint32_t row1, uint32_t row2, uint32_t row3)\n602\t{\n603\t    planes[0] = srm1r_pack_rows_bit(row0, row1, row2, row3, 7);\n604\t    planes[1] = srm1r_pack_rows_bit(row0, row1, row2, row3, 6);\n605\t    planes[2] = srm1r_pack_rows_bit(row0, row1, row2, row3, 5);\n606\t    planes[3] = srm1r_pack_rows_bit(row0, row1, row2, row3, 4);\n607\t    planes[4] = srm1r_pack_rows_bit(row0, row1, row2, row3, 3);\n608\t    planes[5] = srm1r_pack_rows_bit(row0, row1, row2, row3, 2);\n609\t    planes[6] = srm1r_pack_rows_bit(row0, row1, row2, row3, 1);\n610\t    planes[7] = srm1r_pack_rows_bit(row0, row1, row2, row3, 0);\n611\t}\n612\t\n613\tstatic void\n614\tsrm1r_subbytes(uint32_t planes[8])\n615\t{\n616\t    const uint32_t s0  = planes[1] ^ planes[4];\n617\t    const uint32_t s1  = planes[5] ^ planes[7];\n618\t    const uint32_t s2  = planes[3] ^ s0;\n619\t    const uint32_t s3  = planes[0] ^ planes[2];\n620\t    const uint32_t q0  = s1 ^ s2;\n621\t    const uint32_t s4  = planes[0] ^ planes[6];\n622\t    const uint32_t s5  = planes[2] ^ planes[6];\n623\t    const uint32_t s6  = planes[3] ^ s1;\n624\t    const uint32_t s7  = planes[5] ^ s3;\n625\t    const uint32_t q1  = s1 ^ s5;\n626\t    const uint32_t q2  = planes[2] ^ q0;\n627\t    const uint32_t q3  = s4 ^ s2;\n628\t    const uint32_t q4  = s3 ^ q0;\n629\t    const uint32_t s8  = planes[4] ^ s3;\n630\t    const uint32_t q5  = s6 ^ s8;\n631\t    const uint32_t q6  = planes[2] ^ planes[3];\n632\t    const uint32_t q7  = planes[6] ^ s2;\n633\t    const uint32_t s9  = planes[6] ^ s0;\n634\t    const uint32_t q8  = s3 ^ s9;\n635\t    const uint32_t q9  = s4 ^ s6;\n636\t    const uint32_t q10 = s0 ^ s5;\n637\t    const uint32_t q12 = planes[7] ^ s2;\n638\t    const uint32_t q13 = planes[1] ^ s7;\n639\t    const uint32_t q14 = planes[7] ^ s3;\n640\t    const uint32_t q15 = s2 ^ s7;\n641\t    const uint32_t q16 = planes[1] ^ s1;\n642\t    const uint32_t q17 = planes[1] ^ planes[7];\n643\t    const uint32_t q11 = planes[5];\n644\t\n645\t    const uint32_t t20 = q6 & q12;\n646\t    const uint32_t t21 = q3 & q14;\n647\t    const uint32_t t22 = q1 & q16;\n648\t    const uint32_t t23 = q2 & q17;\n649\t    const uint32_t x0  = ((q3 | q14) ^ (q0 & q7)) ^ (t20 ^ t22);\n650\t    const uint32_t x1  = ((q4 | q13) ^ (q10 & q11)) ^ (t21 ^ t20);\n