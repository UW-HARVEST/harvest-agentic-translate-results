  let mut u = [0u8; 32];\n169\t    let mut t = [0u8; 32];\n170\t\n171\t    if dk_len as u64 > 0x1fffffffe0u64 {\n172\t        sodium_misuse();\n173\t    }\n174\t\n175\t    crypto_auth_hmacsha256_init(&mut pshctx, passwd, passwdlen);\n176\t    crypto_auth_hmacsha256_update(&mut pshctx, salt, saltlen as u64);\n177\t\n178\t    let mut i: usize = 0;\n179\t    while i.wrapping_mul(32) < dk_len {\n180\t        store32_be(ivec.as_mut_ptr(), (i as u32).wrapping_add(1));\n181\t        core::ptr::copy_nonoverlapping(\n182\t            &pshctx as *const crypto_auth_hmacsha256_state as *const u8,\n183\t            &mut hctx as *mut crypto_auth_hmacsha256_state as *mut u8,\n184\t            core::mem::size_of::<crypto_auth_hmacsha256_state>(),\n185\t        );\n186\t        crypto_auth_hmacsha256_update(&mut hctx, ivec.as_ptr(), 4);\n187\t        crypto_auth_hmacsha256_final(&mut hctx, u.as_mut_ptr());\n188\t\n189\t        t.copy_from_slice(&u);\n190\t\n191\t        let mut j: u64 = 2;\n192\t        while j <= c {\n193\t            crypto_auth_hmacsha256_init(&mut hctx, passwd, passwdlen);\n194\t            crypto_auth_hmacsha256_update(&mut hctx, u.as_ptr(), 32);\n195\t            crypto_auth_hmacsha256_final(&mut hctx, u.as_mut_ptr());\n196\t\n197\t            for k in 0..32usize {\n198\t                t[k] ^= u[k];\n199\t            }\n200\t            j += 1;\n201\t        }\n202\t\n203\t        let mut clen = dk_len - i * 32;\n204\t        if clen > 32 {\n205\t            clen = 32;\n206\t        }\n207\t        memcpy(\n208\t            buf.add(i * 32) as *mut c_void,\n209\t            t.as_ptr() as *const c_void,\n210\t            clen,\n211\t        );\n212\t\n213\t        i += 1;\n214\t    }\n215\t\n216\t    sodium_memzero(\n217\t        &mut pshctx as *mut crypto_auth_hmacsha256_state as *mut c_void,\n218\t        core::mem::size_of::<crypto_auth_hmacsha256_state>(),\n219\t    );\n220\t}\n221\t\n222\t// =======================================================================\n223\t// nosse/pwhash_scryptsalsa208sha256_nosse.c\n224\t// =======================================================================\n225\t\n226\t#[inline]\n227\tunsafe fn blkcpy(dest: *mut u32, src: *const u32, len: usize) {\n228\t    memcpy(\n229\t        dest as *mut c_void,\n230\t        src as *const c_void,\n231\t        len.wrapping_mul(64),\n232\t    );\n233\t}\n234\t\n235\t#[inline]\n236\tunsafe fn blkxor(dest: *mut u32, src: *const u32, len: usize) {\n237\t    for i in 0..len.wrapping_mul(16) {\n238\t        *dest.add(i) ^= *src.add(i);\n239\t    }\n240\t}\n241\t\n242\t/// `salsa20_8(B)`: apply the salsa20/8 core to the provided block.\n243\tunsafe fn salsa20_8(b: *mut u32) {\n244\t    let mut x = [0u32; 16];\n245\t\n246\t    blkcpy(x.as_mut_ptr(), b, 1);\n247\t    let mut i = 0usize;\n248\t    while i < 8 {\n249\t        // Operate on columns.\n250\t        x[4] ^= rotl32(x[0].wrapping_add(x[12]), 7);\n251\t        x[8] ^= rotl32(x[4].wrapping_add(x[0]), 9);\n252\t        x[12] ^= rotl32(x[8].wrapping_add(x[4]), 13);\n253\t        x[0] ^= rotl32(x[12].wrapping_add(x[8]), 18);\n254\t\n255\t        x[9] ^= rotl32(x[5].wrapping_add(x[1]), 7);\n256\t        x[13] ^= rotl32(x[9].wrapping_add(x[5]), 9);\n257\t        x[1] ^= rotl32(x[13].wrapping_add(x[9]), 13);\n258\t        x[5] ^= rotl32(x[1].wrapping_add(x[13]), 18);\n259\t\n260\t        x[14] ^= rotl32(x[10].wrapping_add(x[6]), 7);\n261\t        x[2] ^= rotl32(x[14].wrapping_add(x[10]), 9);\n262\t        x[6] ^= rotl32(x[2].wrapping_add(x[14]), 13);\n263\t        x[10] ^= rotl32(x[6].wrapping_add(x[2]), 18);\n264\t\n265\t        x[3] ^= rotl32(x[15].wrapping_add(x[11]), 7);\n266\t        x[7] ^= rotl32(x[3].wrapping_add(x[15]), 9);\n267\t        x[11] ^= rotl32(x[7].wrapping_add(x[3]), 13);\n268\t        x[15] ^= rotl32(x[11].wrapping_add(x[7]), 18);\n269\t\n270\t        // Operate on rows.\n271\t        x[1] ^= rotl32(x[0].wrapping_add(x[3]), 7);\n272\t        x[2] ^= rotl32(x[1].wrapping_add(x[0]), 9);\n273\t        x[3] ^= rotl32(x[2].wrapping_add(x[1]), 13);\n274\t        x[0] ^= rotl32(x[3].wrapping_add(x[2]), 18);\n275\t\n276\t        x[6] ^= rotl32(x[5].wrapping_add(x[4]), 7);\n277\t        x[7] ^= rotl32(x[6].wrapping_add(x[5]), 9);\n278\t        x[4] ^= rotl32(x[7].wrapping_add(x[6]), 13);\n279\t        x[5] ^= rotl32(x[4].wrapping_add(x[7]), 18);\n280\t\n281\t        x[11] ^= rotl32(x[10].wrapping_add(x[9]), 7);\n282\t        x[8] ^= rotl32(x[11].wrapping_add(x[10]), 9);\n283\t        x[9] ^= rotl32(x[8].wrapping_add(x[11]), 13);\n284\t        x[10] ^= rotl32(x[9].wrapping_add(x[8]), 18);\n285\t\n286\t        x[12] ^= rotl32(x[15].wrapping_add(x[14]), 7);\n287\t        x[13] ^= rotl32(x[12].wrapping_add(x[15]), 9);\n288\t        x[14] ^= rotl32(x[13].wrapping_add(x[12]), 13);\n289\t        x[15] ^= rotl32(x[14].wrapping_add(x[13]), 18);\n290\t\n291\t        i += 2;\n292\t    }\n293\t    for k in 0..16usize {\n294\t        *b.add(k) = (*b.add(k)).wrapping_add(x[k]);\n295\t    }\n296\t}\n297\t\n298\t/// `blockmix_salsa8(Bin, Bout, X, r)`: compute `Bout = BlockMix_{salsa20/8,r}(Bin)`.\n299\tunsafe fn blockmix_salsa8(bin: *const u32, bout: *mut u32, x: *mut u32, r: usize) {\n300\t    blkcpy(x, bin.add((2 * r - 1) * 16), 1);\n301\t\n302\t    let mut i = 0usize;\n303\t    while i < 2 * r {\n304\t        blkxor(x, bin.add(i * 16), 1);\n305\t        salsa20_8(x);\n306\t        blkcpy(bout.add(i * 8), x, 1);\n307\t\n308\t        blkxor(x, bin.add(i * 16 + 16), 1);\n309\t        salsa20_8(x);\n310\t        blkcpy(bout.add(i * 8 + r * 16), x, 1);\n311\t\n312\t        i += 2;\n313\t    }\n314\t}\n315\t\n316\t/// `integerify(B, r)`: parse `B_{2r-1}` as a little-endian integer.\n317\t#[inline]\n318\tunsafe fn integerify(b: *const u32, r: usize) -> u64 {\n319\t    let x = b.add((2 * r - 1) * 16);\n320\t    ((*x.add(1) as u64) << 32).wrapping_add(*x.add(0) as u64)\n321\t}\n322\t\n323\t/// `smix(B, r, N, V, XY)`: compute `B = SMix_r(B, N)`.\n324\tunsafe fn smix(b: *mut u8, r: usize, n: u64, v: *mut u32, xy: *mut u32) {\n325\t    let x = xy;\n326\t    let y = xy.add(32 * r);\n327\t    let z = xy.add(64 * r);\n328\t\n329\t    for k in 0..(32 * r) {\n330\t        *x.add(k) = load32_le(b.add(4 * k));\n331\t    }\n332\t\n333\t    let mut i: u64 = 0;\n334\t    while i < n {\n335\t        blkcpy(v.add((i as usize) * (32 * r)), x, 2 * r);\n336\t        blockmix_salsa8(x, y, z, r);\n337\t\n338\t        blkcpy(v.add(((i + 1) as usize) * (32 * r)), y, 2 * r);\n339\t        blockmix_salsa8(y, x, z, r);\n340\t\n341\t        i += 2;\n342\t    }\n343\t\n344\t    i = 0;\n345\t    while i < n {\n346\t        let j = integerify(x, r) & (n - 1);\n347\t        blkxor(x, v.add((j as usize) * (32 * r)), 2 * r);\n348\t        blockmix_salsa8(x, y, z, r);\n349\t\n350\t        let j2 = integerify(y, r) & (n - 1);\n351\t        blkxor(y, v.add((j2 as usize) * (32 * r)), 2 * r);\n352\t        blockmix_salsa8(y, x, z, r);\n353\t\n354\t        i += 2;\n355\t    }\n356\t\n357\t    for k in 0..(32 * r) {\n358\t        store32_le(b.add(4 * k), *x.add(k));\n359\t    }\n360\t}\n361\t\n362\t/// `escrypt_kdf_nosse(local, passwd, passwdlen, salt, saltlen, N, r, p, buf, buflen)`.\n363\t#[no_mangle]\n364\tpub unsafe extern \"C\" fn _sodium_escrypt_kdf_nosse(\n365\t    local: *mut escrypt_local_t,\n366\t    passwd: *const u8,\n367\t    passwdlen: usize,\n368\t    salt: *const u8,\n369\t    saltlen: usize,\n370\t    n: u64,\n371\t    _r: u32,\n372\t    _p: u32,\n373\t    buf: *mut u8,\n374\t    buflen: usize,\n375\t) -> c_int {\n376\t    let r: usize = _r as usize;\n377\t    let p: usize = _p as usize;\n378\t\n379\t    // SIZE_MAX > UINT32_MAX on this (64-bit) target, so this check is\n380\t    // always compiled in.\n381\t    if buflen as u64 > (((1u64) << 32) - 1) * 32 {\n382\t        set_errno(EFBIG);\n383\t        return -1;\n384\t    }\n385\t    if (r as u64).wrapping_mul(p as u64) >= (1u64 << 30) {\n386\t        set_errno(EFBIG);\n387\t        return -1;\n388\t  