{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01VGeg3sgnbUsJBrtqQMjXLm","type":"tool_result","content":"1\t//! Translated from:\n2\t//!  - `c_src/libsodium/crypto_sign/crypto_sign.c`\n3\t//!  - `c_src/libsodium/crypto_sign/ed25519/sign_ed25519.c`\n4\t//!  - `c_src/libsodium/crypto_sign/ed25519/ref10/keypair.c`\n5\t//!  - `c_src/libsodium/crypto_sign/ed25519/ref10/sign.c`\n6\t//!  - `c_src/libsodium/crypto_sign/ed25519/ref10/open.c`\n7\t//!\n8\t//! `ED25519_COMPAT` is not defined in the reference build, so `open.c` takes\n9\t//! the `#else` branch (canonical `s` and canonical `pk` checks, no\n10\t//! `crypto_verify_32` call).\n11\t\n12\tuse core::ffi::{c_char, c_int, c_void};\n13\t\n14\tuse crate::ed25519_ref10_fe::*;\n15\tuse crate::types::{crypto_hash_sha512_state, fe25519, ge25519_p2, ge25519_p3};\n16\t\n17\textern \"C\" {\n18\t    fn crypto_hash_sha512(out: *mut u8, inp: *const u8, inlen: u64) -> c_int;\n19\t    fn crypto_hash_sha512_init(state: *mut crypto_hash_sha512_state) -> c_int;\n20\t    fn crypto_hash_sha512_update(\n21\t        state: *mut crypto_hash_sha512_state,\n22\t        inp: *const u8,\n23\t        inlen: u64,\n24\t    ) -> c_int;\n25\t    fn crypto_hash_sha512_final(state: *mut crypto_hash_sha512_state, out: *mut u8) -> c_int;\n26\t\n27\t    #[link_name = \"_sodium_ge25519_p3_tobytes\"]\n28\t    fn ge25519_p3_tobytes(s: *mut u8, h: *const ge25519_p3);\n29\t    #[link_name = \"_sodium_ge25519_frombytes_negate_vartime\"]\n30\t    fn ge25519_frombytes_negate_vartime(h: *mut ge25519_p3, s: *const u8) -> c_int;\n31\t    #[link_name = \"_sodium_ge25519_frombytes\"]\n32\t    fn ge25519_frombytes(h: *mut ge25519_p3, s: *const u8) -> c_int;\n33\t    #[link_name = \"_sodium_ge25519_p2_to_p3\"]\n34\t    fn ge25519_p2_to_p3(r: *mut ge25519_p3, p: *const ge25519_p2);\n35\t    #[link_name = \"_sodium_ge25519_p3_sub\"]\n36\t    fn ge25519_p3_sub(r: *mut ge25519_p3, p: *const ge25519_p3, q: *const ge25519_p3);\n37\t    #[link_name = \"_sodium_ge25519_scalarmult_base\"]\n38\t    fn ge25519_scalarmult_base(h: *mut ge25519_p3, a: *const u8);\n39\t    #[link_name = \"_sodium_ge25519_double_scalarmult_vartime\"]\n40\t    fn ge25519_double_scalarmult_vartime(\n41\t        r: *mut ge25519_p2,\n42\t        a: *const u8,\n43\t        p: *const ge25519_p3,\n44\t        b: *const u8,\n45\t    );\n46\t    #[link_name = \"_sodium_ge25519_is_canonical\"]\n47\t    fn ge25519_is_canonical(s: *const u8) -> c_int;\n48\t    #[link_name = \"_sodium_ge25519_is_on_main_subgroup\"]\n49\t    fn ge25519_is_on_main_subgroup(p: *const ge25519_p3) -> c_int;\n50\t    #[link_name = \"_sodium_ge25519_has_small_order\"]\n51\t    fn ge25519_has_small_order(p: *const ge25519_p3) -> c_int;\n52\t\n53\t    #[link_name = \"_sodium_sc25519_reduce\"]\n54\t    fn sc25519_reduce(s: *mut u8);\n55\t    #[link_name = \"_sodium_sc25519_muladd\"]\n56\t    fn sc25519_muladd(s: *mut u8, a: *const u8, b: *const u8, c: *const u8);\n57\t    #[link_name = \"_sodium_sc25519_is_canonical\"]\n58\t    fn sc25519_is_canonical(s: *const u8) -> c_int;\n59\t\n60\t    fn sodium_memzero(pnt: *mut c_void, len: usize);\n61\t    fn randombytes_buf(buf: *mut c_void, size: usize);\n62\t\n63\t    fn memmove(d: *mut c_void, s: *const c_void, n: usize) -> *mut c_void;\n64\t    fn memset(d: *mut c_void, c: c_int, n: usize) -> *mut c_void;\n65\t}\n66\t\n67\t/// `SODIUM_SIZE_MAX` (see `crate::common`), used to compute\n68\t/// `crypto_sign*_messagebytes_max()`.\n69\tconst SODIUM_SIZE_MAX: u64 = crate::common::SODIUM_SIZE_MAX;\n70\t\n71\t// ---------------------------------------------------------------------------\n72\t// crypto_sign_ed25519.h / crypto_sign.h types\n73\t// ---------------------------------------------------------------------------\n74\t\n75\t/// `typedef struct crypto_sign_ed25519ph_state { crypto_hash_sha512_state hs; } crypto_sign_ed25519ph_state;`\n76\t#[repr(C)]\n77\tpub struct crypto_sign_ed25519ph_state {\n78\t    pub hs: crypto_hash_sha512_state,\n79\t}\n80\t\n81\t/// `typedef crypto_sign_ed25519ph_state crypto_sign_state;`\n82\tpub type crypto_sign_state = crypto_sign_ed25519ph_state;\n83\t\n84\t// ---------------------------------------------------------------------------\n85\t// crypto_sign/ed25519/ref10/sign_ed25519_ref10.h\n86\t// ---------------------------------------------------------------------------\n87\t\n88\t/// `void _crypto_sign_ed25519_ref10_hinit(crypto_hash_sha512_state *hs, int prehashed)`\n89\t///\n90\t/// This name is not rewritten by `quirks.h` — the C source already spells it\n91\t/// with a leading underscore, so the exported symbol keeps the same name.\n92\t#[no_mangle]\n93\tpub unsafe extern \"C\" fn _crypto_sign_ed25519_ref10_hinit(\n94\t    hs: *mut crypto_hash_sha512_state,\n95\t    prehashed: c_int,\n96\t) {\n97\t    static DOM2PREFIX: [u8; 34] = [\n98\t        b'S', b'i', b'g', b'E', b'd', b'2', b'5', b'5', b'1', b'9', b' ', b'n', b'o', b' ', b'E',\n99\t        b'd', b'2', b'5', b'5', b'1', b'9', b' ', b'c', b'o', b'l', b'l', b'i', b's', b'i', b'o',\n100\t        b'n', b's', 1, 0,\n101\t    ];\n102\t\n103\t    crypto_hash_sha512_init(hs);\n104\t    if prehashed != 0 {\n105\t        crypto_hash_sha512_update(hs, DOM2PREFIX.as_ptr(), DOM2PREFIX.len() as u64);\n106\t    }\n107\t}\n108\t\n109\t/// `static inline void _crypto_sign_ed25519_clamp(unsigned char k[32])`\n110\t#[inline]\n111\tunsafe fn crypto_sign_ed25519_clamp(k: *mut u8) {\n112\t    *k &= 248;\n113\t    *k.add(31) &= 127;\n114\t    *k.add(31) |= 64;\n115\t}\n116\t\n117\t/// `int _crypto_sign_ed25519_detached(unsigned char *sig, unsigned long long *siglen_p, const unsigned char *m, unsigned long long mlen, const unsigned char *sk, int prehashed)`\n118\t#[no_mangle]\n119\tpub unsafe extern \"C\" fn _crypto_sign_ed25519_detached(\n120\t    sig: *mut u8,\n121\t    siglen_p: *mut u64,\n122\t    m: *const u8,\n123\t    mlen: u64,\n124\t    sk: *const u8,\n125\t    prehashed: c_int,\n126\t) -> c_int {\n127\t    let mut hs: crypto_hash_sha512_state = core::mem::zeroed();\n128\t    let mut az = [0u8; 64];\n129\t    let mut nonce = [0u8; 64];\n130\t    let mut hram = [0u8; 64];\n131\t    let mut r: ge25519_p3 = core::mem::zeroed();\n132\t\n133\t    _crypto_sign_ed25519_ref10_hinit(&mut hs, prehashed);\n134\t\n135\t    crypto_hash_sha512(az.as_mut_ptr(), sk, 32);\n136\t\n137\t    crypto_hash_sha512_update(&mut hs, az.as_ptr().add(32), 32);\n138\t\n139\t    crypto_hash_sha512_update(&mut hs, m, mlen);\n140\t    crypto_hash_sha512_final(&mut hs, nonce.as_mut_ptr());\n141\t\n142\t    memmove(\n143\t        sig.add(32) as *mut c_void,\n144\t        sk.add(32) as *const c_void,\n145\t        32,\n146\t    );\n147\t\n148\t    sc25519_reduce(nonce.as_mut_ptr());\n149\t    ge25519_scalarmult_base(&mut r, nonce.as_ptr());\n150\t    ge25519_p3_tobytes(sig, &r);\n151\t\n152\t    _crypto_sign_ed25519_ref10_hinit(&mut hs, prehashed);\n153\t    crypto_hash_sha512_update(&mut hs, sig, 64);\n154\t    crypto_hash_sha512_update(&mut hs, m, mlen);\n155\t    crypto_hash_sha512_final(&mut hs, hram.as_mut_ptr());\n156\t\n157\t    sc25519_reduce(hram.as_mut_ptr());\n158\t    crypto_sign_ed25519_clamp(az.as_mut_ptr());\n159\t    sc25519_muladd(sig.add(32), hram.as_ptr(), az.as_ptr(), nonce.as_ptr());\n160\t\n161\t    sodium_memzero(az.as_mut_ptr() as *mut c_void, az.len());\n162\t    sodium_memzero(nonce.as_mut_ptr() as *mut c_void, nonce.len());\n163\t\n164\t    if !siglen_p.is_null() {\n165\t        *siglen_p = 64;\n166\t    }\n167\t    0\n168\t}\n169\t\n170\t/// `int crypto_sign_ed25519_detached(...)`\n171\t#[no_mangle]\n172\tpub unsafe extern \"C\" fn crypto_sign_ed25519_detached(\n173\t    sig: *mut u8,\n174\t    siglen_p: *mut u64,\n175\t    m: *const u8,\n176\t    mlen: u64,\n177\t    sk: *const u8,\n178\t) -> c_int {\n179\t    _crypto_sign_ed25519_detached(sig, siglen_p, m, mlen, sk, 0)\n180\t}\n181\t\n182\t/// `int crypto_sign_ed25519(unsigned char *sm, unsigned long long *smlen_p, const unsigned char *m, unsigned long long mlen, const unsigned char *sk)`\n183\t#[no_mangle]\n184\tpub unsafe extern \"C\" fn crypto_sign_ed25519(\n185\t    sm: *mut u8,\n186\t    smlen_p: *mut u64,\n187\t    m: *const u8,\n188\t    mlen: u64,\n189\t    sk: *const u8,\n190\t) -> c_int {\n191\t    let mut siglen: u64 = 0;\n192\t\n193\t    memmove(\n194\t        sm.add(64) as *mut c_void,\n195\t        m as *const c_void,\n196\t        mlen as usize,\n197\t    );\n198\t\n199\t    if crypto_sign_ed25519_detached(sm, &mut siglen, sm.add(64), mlen, sk) != 0 || siglen != 64 {\n200\t        if !smlen_p.is_null() {\n201\t            *smlen_p = 0;\n202\t        }\n203\t        memset(sm as *mut c_void, 0, (mlen + 64) as usize);\n204\t        return -1;\n205\t    }\n206\t\n207\t    if !smlen_p.is_null() {\n208\t        *smlen_p = mlen + siglen;\n209\t    }\n210\t    0\n211\t}\n212\t\n213\t// ---------------------------------------------------------------------------\n214\t// crypto_sign/ed25519/ref10/open.c\n215\t// ---------------------------------------------------------------------------\n216\t\n217\t/// `int _crypto_sign_ed25519_verify_detached(const unsigned char *sig, const unsigned char *m, unsigned long long mlen, const unsigned char *pk, int prehashed)`\n218\t#[no_mangle]\n219\tpub unsafe extern \"C\" fn _crypto_sign_ed25519_verify_detached(\n220\t    sig: *const u8,\n221\t    m: *const u8,\n222\t    mlen: u64,\n223\t    pk: *const u8,\n224\t    prehashed: c_int,\n225\t) -> c_int {\n226\t    let mut hs: crypto_hash_sha512_state = core::mem::zeroed();\n227\t    let mut h = [0u8; 64];\n228\t    let mut check: ge25519_p3 = core::mem::zeroed();\n229\t    let mut expected_r: ge25519_p3 = core::mem::zeroed();\n230\t    let mut a: ge25519_p3 = core::mem::zeroed();\n231\t    let mut sb_ah: ge25519_p3 = core::mem::zeroed();\n232\t    let mut sb_ah_p2: ge25519_p2 = core::mem::zeroed();\n233\t\n234\t    // ACQUIRE_FENCE is a no-op (HAVE_ATOMIC_OPS / HAVE_PTHREAD not defined).\n235\t\n236\t    if (*sig.add(63) & 240) != 0 && sc25519_is_canonical(sig.add(32)) == 0 {\n237\t        return -1;\n238\t    }\n239\t    if ge25519_is_canonical(pk) == 0 {\n240\t        return -1;\n241\t    }\n242\t\n243\t    if ge25519_frombytes_negate_vartime(&mut a, pk) != 0 || ge25519_has_small_order(&a) != 0 {\n244\t        return -1;\n245\t    }\n246\t    if ge25519_frombytes(&mut expected_r, sig) != 0\n247\t        || ge25519_has_small_order(&expected_r) != 0\n248\t    {\n249\t        return -1;\n250\t    }\n251\t    _crypto_sign_ed25519_ref10_hinit(&mut hs, prehashed);\n252\t    crypto_hash_sha512_update(&mut hs, sig, 32);\n253\t    crypto_hash_sha512_update(&mut hs, pk, 32);\n254\t    crypto_hash_sha512_update(&mut hs, m, mlen);\n255\t    crypto_hash_sha512_final(&mut hs, h.as_mut_ptr());\n256\t    sc25519_reduce(h.as_mut_ptr());\n257\t\n258\t    ge25519_double_scalarmult_vartime(&mut sb_ah_p2, h.as_ptr(), &a, sig.add(32));\n259\t    ge25519_p2_to_p3(&mut sb_ah, &sb_ah_p2);\n260\t    ge25519_p3_sub(&mut check, &expected_r, &sb_ah);\n261\t\n262\t    ge25519_has_small_order(&check) - 1\n263\t}\n264\t\n265\t/// `int crypto_sign_ed25519_verify_detached(...)`\n266\t#[no_mangle]\n267\tpub unsafe extern \"C\" fn crypto_sign_ed25519_verify_detached(\n268\t    sig: *const u8,\n269\t    m: *const u8,\n270\t    mlen: u64,\n271\t    pk: *const u8,\n272\t) -> c_int {\n273\t    _crypto_sign_ed25519_verify_detached(sig, m, mlen, pk, 0)\n274\t}\n275\t\n276\t/// `int crypto_sign_ed25519_open(unsigned char *m, unsigned long long *mlen_p, const unsigned char *sm, unsigned long long smlen, const unsigned char *pk)`\n277\t#[no_mangle]\n278\tpub unsafe extern \"C\" fn crypto_sign_ed25519_open(\n279\t    m: *mut u8,\n280\t    mlen_p: *mut u64,\n281\t    sm: *const u8,\n282\t    smlen: u64,\n283\t    pk: *const u8,\n284\t) -> c_int {\n285\t    let mlen: u64;\n286\t\n287\t    if smlen < 64 || smlen - 64 > (SODIUM_SIZE_MAX - 64) {\n288\t        if !mlen_p.is_null() {\n289\t            *mlen_p = 0;\n290\t        }\n291\t        return -1;\n292\t    }\n293\t    mlen = smlen - 64;\n294\t    if crypto_sign_ed25519_verify_detached(sm, sm.add(64), mlen, pk) != 0 {\n295\t        if !m.is_null() {\n296\t            memset(m as *mut c_void, 0, mlen as usize);\n297\t        }\n298\t        if !mlen_p.is_null() {\n299\t            *mlen_p = 0;\n300\t        }\n301\t        return -1;\n302\t    }\n303\t    if !mlen_p.is_null() {\n304\t        *mlen_p = mlen;\n305\t    }\n306\t    if !m.is_null() {\n307\t        memmove(\n308\t            m as *mut c_void,\n309\t            sm.add(64) as *const c_void,\n310\t            mlen as usize,\n311\t        );\n312\t    }\n313\t    0\n314\t}\n315\t\n316\t// ---------------------------------------------------------------------------\n317\t// crypto_sign/ed25519/ref10/keypair.c\n318\t// ---------------------------------------------------------------------------\n319\t\n320\t/// `int crypto_sign_ed25519_seed_keypair(unsigned char *pk, unsigned char *sk, const unsigned char *seed)`\n321\t#[no_mangle]\n322\tpub unsafe extern \"C\" fn crypto_sign_ed25519_seed_keypair(\n323\t    pk: *mut u8,\n324\t    sk: *mut u8,\n325\t    seed: *const u8,\n326\t) -> c_int {\n327\t    let mut a: ge25519_p3 = core::mem::zeroed();\n328\t\n329\t    crypto_hash_sha512(sk, seed, 32);\n330\t    *sk &= 248;\n331\t    *sk.add(31) &= 127;\n332\t    *sk.add(31) |= 64;\n333\t\n334\t    ge25519_scalarmult_base(&mut a, sk);\n335\t    ge25519_p3_tobytes(pk, &a);\n336\t\n337\t    memmove(sk as *mut c_void, seed as *const c_void, 32);\n338\t    memmove(sk.add(32) as *mut c_void, pk as *const c_void, 32);\n339\t\n340\t    0\n341\t}\n342\t\n343\t/// `int crypto_sign_ed25519_keypair(unsigned char *pk, unsigned char *sk)`\n344\t#[no_mangle]\n345\tpub unsafe extern \"C\" fn crypto_sign_ed25519_keypair(pk: *mut u8, sk: *mut u8) -> c_int {\n346\t    let mut seed = [0u8; 32];\n347\t    let ret: c_int;\n348\t\n349\t    randombytes_buf(seed.as_mut_ptr() as *mut c_void, seed.len());\n350\t    ret = crypto_sign_ed25519_seed_keypair(pk, sk, seed.as_ptr());\n351\t    sodium_memzero(seed.as_mut_ptr() as *mut c_void, seed.len());\n352\t\n353\t    ret\n354\t}\n355\t\n356\t/// `int crypto_sign_ed25519_pk_to_curve25519(unsigned char *curve25519_pk, const unsigned char *ed25519_pk)`\n357\t#[no_mangle]\n358\tpub unsafe extern \"C\" fn crypto_sign_ed25519_pk_to_curve25519(\n359\t    curve25519_pk: *mut u8,\n360\t    ed25519_pk: *const u8,\n361\t) -> c_int {\n362\t    let mut a: ge25519_p3 = core::mem::zeroed();\n363\t    let mut x: fe25519 = [0i32; 10];\n364\t    let mut one_minus_y: fe25519 = [0i32; 10];\n365\t\n366\t    if ge25519_frombytes_negate_vartime(&mut a, ed25519_pk) != 0\n367\t        || ge25519_has_small_order(&a) != 0\n368\t        || ge25519_is_on_main_subgroup(&a) == 0\n369\t    {\n370\t        return -1;\n371\t    }\n372\t    fe25519_1(&mut one_minus_y);\n373\t\n374\t    let one_minus_y_copy = one_minus_y;\n375\t    fe25519_sub(&mut one_minus_y, &one_minus_y_copy, &a.Y);\n376\t    fe25519_1(&mut x);\n377\t    let x_copy = x;\n378\t    fe25519_add(&mut x, &x_copy, &a.Y);\n379\t    let one_minus_y_copy = one_minus_y;\n380\t    fe25519_invert(&mut one_minus_y, &one_minus_y_copy);\n381\t    fe25519_mul_ip(&mut x, &one_minus_y);\n382\t    fe25519_tobytes(curve25519_pk, &x);\n383\t\n384\t    0\n385\t}\n386\t\n387\t/// `int crypto_sign_ed25519_sk_to_curve25519(unsigned char *curve25519_sk, const unsigned char *ed25519_sk)`\n388\t#[no_mangle]\n389\tpub unsafe extern \"C\" fn crypto_sign_ed25519_sk_to_curve25519(\n390\t    curve25519_sk: *mut u8,\n391\t    ed25519_sk: *const u8,\n392\t) -> c_int {\n393\t    let mut h = [0u8; 64];\n394\t\n395\t    crypto_hash_sha512(h.as_mut_ptr(), ed25519_sk, 32);\n396\t    h[0] &= 248;\n397\t    h[31] &= 127;\n398\t    h[31] |= 64;\n399\t    memmove(\n400\t        curve25519_sk as *mut c_void,\n401\t        h.as_ptr() as *const c_void,\n402\t        32,\n403\t    );\n404\t    sodium_memzero(h.as_mut_ptr() as 