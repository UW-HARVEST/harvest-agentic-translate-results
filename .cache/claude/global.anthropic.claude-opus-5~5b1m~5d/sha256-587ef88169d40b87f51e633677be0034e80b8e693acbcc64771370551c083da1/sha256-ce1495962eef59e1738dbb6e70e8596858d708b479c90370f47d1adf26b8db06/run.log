{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01KTtRUaqqnG81MbEGZc6Jj8","type":"tool_result","content":"1\t//! Translation of:\n2\t//! * `crypto_onetimeauth/poly1305/donna/poly1305_donna.c`\n3\t//!   (includes `poly1305_donna32.h`, since `HAVE_TI_MODE` is undefined — the\n4\t//!   32-bit-multiply donna implementation is the one that is actually\n5\t//!   compiled; note that on this target `unsigned long` is 64 bits, exactly\n6\t//!   as it is in the original C, so the field types below are `u64`)\n7\t//! * `crypto_onetimeauth/poly1305/onetimeauth_poly1305.c`\n8\t//! * `crypto_onetimeauth/crypto_onetimeauth.c`\n9\t#![allow(dead_code)]\n10\t#![allow(non_upper_case_globals)]\n11\t\n12\tuse core::ffi::c_int;\n13\t\n14\tuse crate::common::{load32_le, store32_le};\n15\t\n16\textern \"C\" {\n17\t    fn crypto_verify_16(x: *const u8, y: *const u8) -> c_int;\n18\t    fn sodium_memzero(pnt: *mut core::ffi::c_void, len: usize);\n19\t    fn randombytes_buf(buf: *mut core::ffi::c_void, size: usize);\n20\t}\n21\t\n22\t// ---- include/sodium/crypto_onetimeauth_poly1305.h ----\n23\t\n24\t/// `crypto_onetimeauth_poly1305_state`: `CRYPTO_ALIGN(16) unsigned char opaque[256]`.\n25\t#[repr(C, align(16))]\n26\t#[derive(Clone, Copy)]\n27\tpub struct crypto_onetimeauth_poly1305_state {\n28\t    pub opaque: [u8; 256],\n29\t}\n30\t\n31\t// ---- include/sodium/crypto_onetimeauth.h ----\n32\t\n33\t/// `crypto_onetimeauth_state` is a typedef alias of\n34\t/// `crypto_onetimeauth_poly1305_state`.\n35\tpub type crypto_onetimeauth_state = crypto_onetimeauth_poly1305_state;\n36\t\n37\t// ---- crypto_onetimeauth/poly1305/onetimeauth_poly1305.h ----\n38\t\n39\t/// `crypto_onetimeauth_poly1305_implementation`\n40\t#[repr(C)]\n41\t#[derive(Clone, Copy)]\n42\tpub struct crypto_onetimeauth_poly1305_implementation {\n43\t    pub onetimeauth: Option<\n44\t        unsafe extern \"C\" fn(\n45\t            out: *mut u8,\n46\t            inp: *const u8,\n47\t            inlen: u