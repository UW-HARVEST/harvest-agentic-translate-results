n893\t    }\n894\t\n895\t    store32_le(value.as_mut_ptr(), (*context).saltlen);\n896\t    crypto_generichash_blake2b_update(&mut blake_hash, value.as_ptr(), value.len() as u64);\n897\t\n898\t    if !(*context).salt.is_null() {\n899\t        crypto_generichash_blake2b_update(&mut blake_hash, (*context).salt, (*context).saltlen as u64);\n900\t    }\n901\t\n902\t    store32_le(value.as_mut_ptr(), (*context).secretlen);\n903\t    crypto_generichash_blake2b_update(&mut blake_hash, value.as_ptr(), value.len() as u64);\n904\t\n905\t    if !(*context).secret.is_null() {\n906\t        crypto_generichash_blake2b_update(&mut blake_hash, (*context).secret, (*context).secretlen as u64);\n907\t\n908\t        if (*context).flags & ARGON2_FLAG_CLEAR_SECRET != 0 {\n909\t            sodium_memzero((*context).secret as *mut c_void, (*context).secretlen as usize);\n910\t            (*context).secretlen = 0;\n911\t        }\n912\t    }\n913\t\n914\t    store32_le(value.as_mut_ptr(), (*context).adlen);\n915\t    crypto_generichash_blake2b_update(&mut blake_hash, value.as_ptr(), value.len() as u64);\n916\t\n917\t    if !(*context).ad.is_null() {\n918\t        crypto_generichash_blake2b_update(&mut blake_hash, (*context).ad, (*context).adlen as u64);\n919\t    }\n920\t\n921\t    crypto_generichash_blake2b_final(&mut blake_hash, blockhash, ARGON2_PREHASH_DIGEST_LENGTH);\n922\t}\n923\t\n924\t/// `argon2_initialize` -> `_sodium_argon2_initialize`.\n925\t#[no_mangle]\n926\tpub unsafe extern \"C\" fn _sodium_argon2_initialize(\n927\t    instance: *mut argon2_instance_t,\n928\t    context: *mut argon2_context,\n929\t) -> c_int {\n930\t    let mut blockhash: [u8; ARGON2_PREHASH_SEED_LENGTH] = [0u8; ARGON2_PREHASH_SEED_LENGTH];\n931\t\n932\t    if instance.is_null() || context.is_null() {\n933\t        return ARGON2_INCORRECT_PARAMETER;\n934\t    }\n935\t\n936\t    let pr = malloc(core::mem::size_of::<u64>().wrapping_mul((*instance).segment_length as usize)) as *mut u64;\n937\t    (*instance).pse