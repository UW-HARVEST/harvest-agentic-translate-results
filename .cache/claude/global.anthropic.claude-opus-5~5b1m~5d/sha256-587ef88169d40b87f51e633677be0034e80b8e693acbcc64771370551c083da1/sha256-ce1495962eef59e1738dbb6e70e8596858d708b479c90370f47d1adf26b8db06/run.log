{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_ltl2uiwha2ofeg3pys6lpjodi2qvihu3cog4n4m7eqoldesmip6q","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_017DxotB5ULAmDhJr4ruba7t","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-s3DwgU/translation/tests/stream.rs","content":"//! Differential tests for the `stream` area:\n//!\n//!   * `crypto_stream/crypto_stream.c`            (generic xsalsa20 dispatchers)\n//!   * `crypto_stream/salsa20/**`                 (ref impl + implementation struct)\n//!   * `crypto_stream/salsa2012/**`\n//!   * `crypto_stream/salsa208/**`\n//!   * `crypto_stream/xsalsa20/**`\n//!   * `crypto_stream/chacha20/**`                (original + ietf + ietf_ext)\n//!   * `crypto_stream/xchacha20/**`\n//!   * `crypto_core/salsa/ref/core_salsa_ref.c`   (salsa20 / 2012 / 208 cores)\n//!   * `crypto_core/hsalsa20/**`\n//!   * `crypto_core/hchacha20/**`\n//!\n//! Everything is called through `dlopen`'d C and Rust shared objects.\n\n#[macro_use]\nmod common;\n\nuse core::ffi::{c_char, c_int, c_void};\n\n// ------------------------------------------------------------- signatures ----\n\ntype StreamFn = unsafe extern \"C\" fn(*mut u8, u64, *const u8, *const u8) -> c_int;\ntype XorFn = unsafe extern \"C\" fn(*mut u8, *const u8, u64, *const u8, *const u8) -> c_int;\ntype XorIcFn = unsafe extern \"C\" fn(*mut u8, *const u8, u64, *const u8, u64, *const u8) -> c_int;\ntype XorIc32Fn = unsafe extern \"C\" fn(*mut u8, *const u8, u64, *const u8, u32, *const u8) -> c_int;\ntype CoreFn = unsafe extern \"C\" fn(*mut u8, *const u8, *const u8, *const u8) -> c_int;\ntype SizeFn = unsafe extern \"C\" fn() -> usize;\ntype KeygenFn = unsafe extern \"C\" fn(*mut u8);\ntype IntFn = unsafe extern \"C\" fn() -> c_int;\n\n/// `crypto_stream_salsa20_implementation` (crypto_stream/salsa20/stream_salsa20.h)\n#[repr(C)]\nstruct Salsa20Impl {\n    stream: StreamFn,\n    stream_xor_ic: XorIcFn,\n}\n\n/// `crypto_stream_chacha20_implementation` (crypto_stream/chacha20/stream_chacha20.h)\n#[repr(C)]\nstruct Chacha20Impl {\n    stream: StreamFn,\n    stream_ietf_ext: StreamFn,\n    stream_xor_ic: XorIcFn,\n    stream_ietf_ext_xor_ic: XorIc32Fn,\n}\n\n// ------------------------------------------------------------- input sets ----\n\n/// Message/keystream lengths: 0, 1, block-1/block/block+1 for the 64-byte salsa\n/// and chacha block, multi-block, and plenty of non-multiples of 64.\nconst LENS: &[usize] = &[\n    0, 1, 2, 3, 31, 32, 33, 63, 64, 65, 66, 100, 127, 128, 129, 130, 191, 192, 193, 255, 256, 257,\n    320, 383, 384, 385, 511, 512, 513, 1000, 1023, 1024, 1025,\n];\n\n/// 64-bit initial counters. Includes the 32-bit rollover point (0xffffffff, so\n/// the low counter word wraps into the high word after the first block) and the\n/// full 64-bit rollover point (u64::MAX).\nconst ICS: &[u64] = &[\n    0,\n    1,\n    2,\n    7,\n    0xffff_fffe,\n    0xffff_ffff,\n    0x1_0000_0000,\n    0x1_0000_0001,\n    0xdead_beef_1234_5678,\n    0xffff_ffff_ffff_fffe,\n    u64::MAX,\n];\n\n/// 32-bit initial counters for the ietf_ext entry points (the counter is a\n/// single 32-bit word there and is allowed to overflow into the IV).\nconst ICS32: &[u32] = &[0, 1, 2, 0x7fff_ffff, 0x8000_0000, 0xffff_fffe, 0xffff_ffff];\n\nconst PAD: usize = 32;\nconst CAN: u8 = 0x5A;\n\nfn lens_with_random(rng: &mut common::Rng) -> Vec<usize> {\n    let mut v = LENS.to_vec();\n    for _ in 0..20 {\n        v.push(rng.below(1500));\n    }\n    v\n}\n\n// --------------------------------------------------------------- helpers -----\n\n/// Keystream-generation entry points: `crypto_stream*(c, clen, n, k)`.\nfn check_stream(name: &str, cf: StreamFn, rf: StreamFn, noncebytes: usize, rng: &mut common::Rng) {\n    for &len in &lens_with_random(rng) {\n        let k = rng.bytes(32);\n        let n = rng.bytes(noncebytes);\n        let mut cb = vec![CAN; len + PAD];\n        let mut rb = vec![CAN; len + PAD];\n        let rc = unsafe { cf(cb.as_mut_ptr(), len as u64, n.as_ptr(), k.as_ptr()) };\n        let rr = unsafe { rf(rb.as_mut_ptr(), len as u64, n.as_ptr(), k.as_ptr()) };\n        let tag = format!(\"{} len={}\", name, len);\n        common::eqi(&tag, rc, rr);\n        common::eqb(&tag, &cb, &rb);\n        assert!(\n            cb[len..].iter().all(|&b| b == CAN),\n            \"{}: wrote past the requested length\",\n            tag\n        );\n    }\n}\n\n/// `*_xor(c, m, mlen, n, k)` — out-of-place and in-place.\nfn check_xor(name: &str, cf: XorFn, rf: XorFn, noncebytes: usize, rng: &mut common::Rng) {\n    for &len in &lens_with_random(rng) {\n        let k = rng.bytes(32);\n        let n = rng.bytes(noncebytes);\n        let m = rng.bytes(len);\n        let mut cb = vec![CAN; len + PAD];\n        let mut rb = vec![CAN; len + PAD];\n        let rc = unsafe { cf(cb.as_mut_ptr(), m.as_ptr(), len as u64, n.as_ptr(), k.as_ptr()) };\n        let rr = unsafe { rf(rb.as_mut_ptr(), m.as_ptr(), len as u64, n.as_ptr(), k.as_ptr()) };\n        let tag = format!(\"{} len={}\", name, len);\n        common::eqi(&tag, rc, rr);\n        common::eqb(&tag, &cb, &rb);\n        assert!(\n            cb[len..].iter().all(|&b| b == CAN),\n            \"{}: wrote past mlen\",\n            tag\n        );\n\n        // in-place (c == m), which the C reference code supports\n        let mut ci = m.clone();\n        ci.extend(core::iter::repeat(CAN).take(PAD));\n        let mut ri = ci.clone();\n        let rc2 = unsafe {\n            cf(\n                ci.as_mut_ptr(),\n                ci.as_ptr(),\n                len as u64,\n                n.as_ptr(),\n                k.as_ptr(),\n            )\n        };\n        let rr2 = unsafe {\n            rf(\n                ri.as_mut_ptr(),\n                ri.as_ptr(),\n                len as u64,\n                n.as_ptr(),\n                k.as_ptr(),\n            )\n        };\n        let tag2 = format!(\"{} inplace len={}\", name, len);\n        common::eqi(&tag2, rc2, rr2);\n        common::eqb(&tag2, &ci, &ri);\n        common::eqb(&format!(\"{} inplace==oop len={}\", name, len), &ci[..len], &cb[..len]);\n    }\n}\n\n/// `*_xor_ic(c, m, mlen, n, ic, k)` with a 64-bit counter.\nfn check_xor_ic(\n    name: &str,\n    cf: XorIcFn,\n    rf: XorIcFn,\n    noncebytes: usize,\n    rng: &mut common::Rng,\n) {\n    for &len in &lens_with_random(rng) {\n        for &ic in ICS {\n            let k = rng.bytes(32);\n            let n = rng.bytes(noncebytes);\n            let m = rng.bytes(len);\n            let mut cb = vec![CAN; len + PAD];\n            let mut rb = vec![CAN; len + PAD];\n            let rc = unsafe {\n                cf(\n                    cb.as_mut_ptr(),\n                    m.as_ptr(),\n                    len as u64,\n                    n.as_ptr(),\n                    ic,\n                    k.as_ptr(),\n                )\n            };\n            let rr = unsafe {\n                rf(\n                    rb.as_mut_ptr(),\n                    m.as_ptr(),\n                    len as u64,\n                    n.as_ptr(),\n                    ic,\n                    k.as_ptr(),\n                )\n            };\n            let tag = format!(\"{} len={} ic={:#x}\", name, len, ic);\n            common::eqi(&tag, rc, rr);\n            common::eqb(&tag, &cb, &rb);\n            assert!(\n                cb[len..].iter().all(|&b| b == CAN),\n                \"{}: wrote past mlen\",\n                tag\n            );\n\n            // in-place\n            let mut ci = m.clone();\n            ci.extend(core::iter::repeat(CAN).take(PAD));\n            let mut ri = ci.clone();\n            let rc2 = unsafe {\n                cf(\n                    ci.as_mut_ptr(),\n                    ci.as_ptr(),\n                    len as u64,\n                    n.as_ptr(),\n                    ic,\n                    k.as_ptr(),\n                )\n            };\n            let rr2 = unsafe {\n                rf(\n                    ri.as_mut_ptr(),\n                    ri.as_ptr(),\n                    len as u64,\n                    n.as_ptr(),\n                    ic,\n                    k.as_ptr(),\n                )\n            };\n            let tag2 = format!(\"{} inplace len={} ic={:#x}\", name, len, ic);\n            common::eqi(&tag2, rc2, rr2);\n            common::eqb(&tag2, &ci, &ri);\n            common::eqb(&tag2, &ci[..len], &cb[..len]);\n        }\n    }\n}\n\n/// `*_xor_ic(c, m, mlen, n, ic, k)` with a 32-bit counter (ietf_ext).\nfn check_xor_ic32(\n    name: &str,\n    cf: XorIc32Fn,\n    rf: XorIc32Fn,\n    noncebytes: usize,\n    rng: &mut common::Rng,\n) {\n    for &len in &lens_with_random(rng) {\n        for &ic in ICS32 {\n            let k = rng.bytes(32);\n            let n = rng.bytes(noncebytes);\n            let m = rng.bytes(len);\n            let mut cb = vec![CAN; len + PAD];\n            let mut rb = vec![CAN; len + PAD];\n            let rc = unsafe {\n                cf(\n                    cb.as_mut_ptr(),\n                    m.as_ptr(),\n                    len as u64,\n                    n.as_ptr(),\n                    ic,\n                    k.as_ptr(),\n                )\n            };\n            let rr = unsafe {\n                rf(\n                    rb.as_mut_ptr(),\n                    m.as_ptr(),\n                    len as u64,\n                    n.as_ptr(),\n                    ic,\n                    k.as_ptr(),\n                )\n            };\n            let tag = format!(\"{} len={} ic={:#x}\", name, len, ic);\n            common::eqi(&tag, rc, rr);\n            common::eqb(&tag, &cb, &rb);\n            assert!(\n                cb[len..].iter().all(|&b| b == CAN),\n                \"{}: wrote past mlen\",\n                tag\n            );\n\n            let mut ci = m.clone();\n            ci.extend(core::iter::repeat(CAN).take(PAD));\n            let mut ri = ci.clone();\n            let rc2 = unsafe {\n                cf(\n                    ci.as_mut_ptr(),\n                    ci.as_ptr(),\n                    len as u64,\n                    n.as_ptr(),\n                    ic,\n                    k.as_ptr(),\n                )\n            };\n            let rr2 = unsafe {\n                rf(\n                    ri.as_mut_ptr(),\n                    ri.as_ptr(),\n                    len as u64,\n                    n.as_ptr(),\n                    ic,\n                    k.as_ptr(),\n                )\n            };\n            let tag2 = format!(\"{} inplace len={} ic={:#x}\", name, len, ic);\n            common::eqi(&tag2, rc2, rr2);\n            common::eqb(&tag2, &ci, &ri);\n            common::eqb(&tag2, &ci[..len], &cb[..len]);\n        }\n    }\n}\n\nfn eqsz(name: &str, c: SizeFn, r: SizeFn) -> usize {\n    let cv = unsafe { c() };\n    let rv = unsafe { r() };\n    assert_eq!(cv, rv, \"{} mismatch\", name);\n    cv\n}\n\n// =====================================================================\n// crypto_core/salsa/ref/core_salsa_ref.c\n// =====================================================================\n\nfn check_core(name: &str, cf: CoreFn, rf: CoreFn, outlen: usize, rng: &mut common::Rng) {\n    // 40 random cases per `c == NULL` / `c != NULL` branch, plus all-zero and\n    // all-0xff extremes.\n    for case in 0..44 {\n        let (in_, k, konst) = match case {\n            0 => (vec![0u8; 16], vec![0u8; 32], vec![0u8; 16]),\n            1 => (vec![0xffu8; 16], vec![0xffu8; 32], vec![0xffu8; 16]),\n            2 => (vec![0u8; 16], vec![0xffu8; 32], vec![0x5au8; 16]),\n            3 => (vec![0xffu8; 16], vec![0u8; 32], vec![0xa5u8; 16]),\n            _ => (rng.bytes(16), rng.bytes(32), rng.bytes(16)),\n        };\n        for use_const in [false, true] {\n            let cp = if use_const {\n                konst.as_ptr()\n            } else {\n                core::ptr::null()\n            };\n            let mut co = vec![CAN; outlen + PAD];\n            let mut ro = vec![CAN; outlen + PAD];\n            let rc = unsafe { cf(co.as_mut_ptr(), in_.as_ptr(), k.as_ptr(), cp) };\n            let rr = unsafe { rf(ro.as_mut_ptr(), in_.as_ptr(), k.as_ptr(), cp) };\n            let tag = format!(\"{} case={} const={}\", name, case, use_const);\n            common::eqi(&tag, rc, rr);\n            common::eqb(&tag, &co, &ro);\n            assert!(\n                co[outlen..].iter().all(|&b| b == CAN),\n                \"{}: wrote past outputbytes\",\n                tag\n            );\n        }\n    }\n}\n\n#[test]\nfn core_salsa20() {\n    let mut rng = common::Rng::new(0x0001);\n    let (c, r) = both!(\"crypto_core_salsa20\", CoreFn);\n    let out = eqsz(\n        \"crypto_core_salsa20_outputbytes\",\n        both!(\"crypto_core_salsa20_outputbytes\", SizeFn).0,\n        both!(\"crypto_core_salsa20_outputbytes\", SizeFn).1,\n    );\n    assert_eq!(out, 64);\n    assert_eq!(\n        eqsz(\n            \"crypto_core_salsa20_inputbytes\",\n            both!(\"crypto_core_salsa20_inputbytes\", SizeFn).0,\n            both!(\"crypto_core_salsa20_inputbytes\", SizeFn).1\n        ),\n        16\n    );\n    assert_eq!(\n        eqsz(\n            \"crypto_core_salsa20_keybytes\",\n            both!(\"crypto_core_salsa20_keybytes\", SizeFn).0,\n            both!(\"crypto_core_salsa20_keybytes\", SizeFn).1\n        ),\n        32\n    );\n    assert_eq!(\n        eqsz(\n            \"crypto_core_salsa20_constbytes\",\n            both!(\"crypto_core_salsa20_constbytes\", SizeFn).0,\n            both!(\"crypto_core_salsa20_constbytes\", SizeFn).1\n        ),\n        16\n    );\n    check_core(\"crypto_core_salsa20\", c, r, out, &mut rng);\n}\n\n#[test]\nfn core_salsa2012() {\n    let mut rng = common::Rng::new(0x0002);\n    let (c, r) = both!(\"crypto_core_salsa2012\", CoreFn);\n    let out = eqsz(\n        \"crypto_core_salsa2012_outputbytes\",\n        both!(\"crypto_core_salsa2012_outputbytes\", SizeFn).0,\n        both!(\"crypto_core_salsa2012_outputbytes\", SizeFn).1,\n    );\n    assert_eq!(out, 64);\n    assert_eq!(\n        eqsz(\n            \"crypto_core_salsa2012_inputbytes\",\n            both!(\"crypto_core_salsa2012_inputbytes\", SizeFn).0,\n            both!(\"crypto_core_salsa2012_inputbytes\", SizeFn).1\n        ),\n        16\n    );\n    assert_eq!(\n        eqsz(\n            \"crypto_core_salsa2012_keybytes\",\n            both!(\"crypto_core_salsa2012_keybytes\", SizeFn).0,\n            both!(\"crypto_core_salsa2012_keybytes\", SizeFn).1\n        ),\n        32\n    );\n    assert_eq!(\n        eqsz(\n            \"crypto_core_salsa2012_constbytes\",\n            both!(\"crypto_core_salsa2012_constbytes\", SizeFn).0,\n            both!(\"crypto_core_salsa2012_constbytes\", SizeFn).1\n        ),\n        16\n    );\n    check_core(\"crypto_core_salsa2012\", c, r, out, &mut rng);\n}\n\n#[test]\nfn core_salsa208() {\n    let mut rng = common::Rng::new(0x0003);\n    let (c, r) = both!(\"crypto_core_salsa208\", CoreFn);\n    let out = eqsz(\n        \"crypto_core_salsa208_outputbytes\",\n        both!(\"crypto_core_salsa208_outputbytes\", SizeFn).0,\n        both!(\"crypto_core_salsa208_outputbytes\", SizeFn).1,\n    );\n    assert_eq!(out, 64);\n    assert_eq!(\n        eqsz(\n            \"crypto_core_salsa208_inputbytes\",\n            both!(\"crypto_core_salsa208_inputbytes\", SizeFn).0,\n            both!(\"crypto_core_salsa208_inputbytes\", SizeFn).1\n        ),\n        16\n    );\n    assert_eq!(\n        eqsz(\n            \"crypto_core_salsa208_keybytes\",\n            both!(\"crypto_core_salsa208_keybytes\", SizeFn).0,\n            both!(\"crypto_core_salsa208_keybytes\", SizeFn).1\n        ),\n        32\n    );\n    assert_eq!(\n        eqsz(\n            \"crypto_core_salsa208_constbytes\",\n            both!(\"crypto_core_salsa208_constbytes\", SizeFn).0,\n            both!(\"crypto_core_salsa208_constbytes\", SizeFn).1\n        ),\n        16\n    );\n    check_core(\"crypto_core_salsa208\", c, r, out, &mut rng);\n}\n\n#[test]\nfn core_hsalsa20() {\n    let mut rng = common::Rng::new(0x0004);\n    let (c, r) = both!(\"crypto_core_hsalsa20\", CoreFn);\n    let out = eqsz(\n        \"crypto_core_hsalsa20_outputbytes\",\n        both!(\"crypto_core_hsalsa20_outputbytes\", SizeFn).0,\n        both!(\"crypto_core_hsalsa20_outputbytes\", SizeFn).1,\n    );\n    assert_eq!(out, 32);\n    assert_eq!(\n        eqsz(\n            \"crypto_core_hsalsa20_inputbytes\",\n            both!(\"crypto_core_hsalsa20_inputbytes\", SizeFn).0,\n            both!(\"crypto_core_hsalsa20_inputbytes\", SizeFn).1\n        ),\n        16\n    );\n    assert_eq!(\n        eqsz(\n            \"crypto_core_hsalsa20_keybytes\",\n            both!(\"crypto_core_hsalsa20_keybytes\", SizeFn).0,\n            both!(\"crypto_core_hsalsa20_keybytes\", SizeFn).1\n        ),\n        32\n    );\n    assert_eq!(\n        eqsz(\n            \"crypto_core_hsalsa20_constbytes\",\n            both!(\"crypto_core_hsalsa20_constbytes\", SizeFn).0,\n            both!(\"crypto_core_hsalsa20_constbytes\", SizeFn).1\n        ),\n        16\n    );\n    check_core(\"crypto_core_hsalsa20\", c, r, out, &mut rng);\n}\n\n#[test]\nfn core_hchacha20() {\n    let mut rng = common::Rng::new(0x0005);\n    let (c, r) = both!(\"crypto_core_hchacha20\", CoreFn);\n    let out = eqsz(\n        \"crypto_core_hchacha20_outputbytes\",\n        both!(\"crypto_core_hchacha20_outputbytes\", SizeFn).0,\n        both!(\"crypto_core_hchacha20_outputbytes\", SizeFn).1,\n    );\n    assert_eq!(out, 32);\n    assert_eq!(\n        eqsz(\n            \"crypto_core_hchacha20_inputbytes\",\n            both!(\"crypto_core_hchacha20_inputbytes\", SizeFn).0,\n            both!(\"crypto_core_hchacha20_inputbytes\", SizeFn).1\n        ),\n        16\n    );\n    assert_eq!(\n        eqsz(\n            \"crypto_core_hchacha20_keybytes\",\n            both!(\"crypto_core_hchacha20_keybytes\", SizeFn).0,\n            both!(\"crypto_core_hchacha20_keybytes\", SizeFn).1\n        ),\n        32\n    );\n    assert_eq!(\n        eqsz(\n            \"crypto_core_hchacha20_constbytes\",\n            both!(\"crypto_core_hchacha20_constbytes\", SizeFn).0,\n            both!(\"crypto_core_hchacha20_constbytes\", SizeFn).1\n        ),\n        16\n    );\n    check_core(\"crypto_core_hchacha20\", c, r, out, &mut rng);\n}\n\n// =====================================================================\n// crypto_stream/salsa20\n// =====================================================================\n\n#[test]\nfn stream_salsa20() {\n    let mut rng = common::Rng::new(0x1001);\n    assert_eq!(\n        eqsz(\n            \"crypto_stream_salsa20_keybytes\",\n            both!(\"crypto_stream_salsa20_keybytes\", SizeFn).0,\n            both!(\"crypto_stream_salsa20_keybytes\", SizeFn).1\n        ),\n        32\n    );\n    assert_eq!(\n        eqsz(\n            \"crypto_stream_salsa20_noncebytes\",\n            both!(\"crypto_stream_salsa20_noncebytes\", SizeFn).0,\n            both!(\"crypto_stream_salsa20_noncebytes\", SizeFn).1\n        ),\n        8\n    );\n    assert_eq!(\n        eqsz(\n            \"crypto_stream_salsa20_messagebytes_max\",\n            both!(\"crypto_stream_salsa20_messagebytes_max\", SizeFn).0,\n            both!(\"crypto_stream_salsa20_messagebytes_max\", SizeFn).1\n        ),\n        usize::MAX\n    );\n\n    let (c, r) = both!(\"crypto_stream_salsa20\", StreamFn);\n    check_stream(\"crypto_stream_salsa20\", c, r, 8, &mut rng);\n    let (c, r) = both!(\"crypto_stream_salsa20_xor\", XorFn);\n    check_xor(\"crypto_stream_salsa20_xor\", c, r, 8, &mut rng);\n    let (c, r) = both!(\"crypto_stream_salsa20_xor_ic\", XorIcFn);\n    check_xor_ic(\"crypto_stream_salsa20_xor_ic\", c, r, 8, &mut rng);\n}\n\n#[test]\nfn stream_salsa20_ref_implementation_struct() {\n    // Exported implementation struct: exercise every function pointer inside it\n    // through both libraries.\n    let (cp, rp) = both_data!(\"crypto_stream_salsa20_ref_implementation\", Salsa20Impl);\n    let (ci, ri) = unsafe { (&*cp, &*rp) };\n    let mut rng = common::Rng::new(0x1002);\n    check_stream(\"salsa20_ref_impl.stream\", ci.stream, ri.stream, 8, &mut rng);\n    check_xor_ic(\n        \"salsa20_ref_impl.stream_xor_ic\",\n        ci.stream_xor_ic,\n        ri.stream_xor_ic,\n        8,\n        &mut rng,\n    );\n}\n\n#[test]\nfn stream_salsa20_pick_best_implementation() {\n    let (c, r) = both!(\"_crypto_stream_salsa20_pick_best_implementation\", IntFn);\n    let rc = unsafe { c() };\n    let rr = unsafe { r() };\n    common::eqi(\"_crypto_stream_salsa20_pick_best_implementation\", rc, rr);\n    assert_eq!(rc, 0);\n    // and the dispatchers still agree after re-picking\n    let mut rng = common::Rng::new(0x1003);\n    let (c, r) = both!(\"crypto_stream_salsa20\", StreamFn);\n    check_stream(\"crypto_stream_salsa20 (post-pick)\", c, r, 8, &mut rng);\n}\n\n// =====================================================================\n// crypto_stream/salsa2012\n// =====================================================================\n\n#[test]\nfn stream_salsa2012() {\n    let mut rng = common::Rng::new(0x2001);\n    assert_eq!(\n        eqsz(\n            \"crypto_stream_salsa2012_keybytes\",\n            both!(\"crypto_stream_salsa2012_keybytes\", SizeFn).0,\n            both!(\"crypto_stream_salsa2012_keybytes\", SizeFn).1\n        ),\n        32\n    );\n    assert_eq!(\n        eqsz(\n            \"crypto_stream_salsa2012_noncebytes\",\n            both!(\"crypto_stream_salsa2012_noncebytes\", SizeFn).0,\n            both!(\"crypto_stream_salsa2012_noncebytes\", SizeFn).1\n        ),\n        8\n    );\n    assert_eq!(\n        eqsz(\n            \"crypto_stream_salsa2012_messagebytes_max\",\n            both!(\"crypto_stream_salsa2012_messagebytes_max\", SizeFn).0,\n            both!(\"crypto_stream_salsa2012_messagebytes_max\", SizeFn).1\n        ),\n        usize::MAX\n    );\n    let (c, r) = both!(\"crypto_stream_salsa2012\", StreamFn);\n    check_stream(\"crypto_stream_salsa2012\", c, r, 8, &mut rng);\n    let (c, r) = both!(\"crypto_stream_salsa2012_xor\", XorFn);\n    check_xor(\"crypto_stream_salsa2012_xor\", c, r, 8, &mut rng);\n}\n\n// =====================================================================\n// crypto_stream/salsa208\n// =====================================================================\n\n#[test]\nfn stream_salsa208() {\n    let mut rng = common::Rng::new(0x3001);\n    assert_eq!(\n        eqsz(\n            \"crypto_stream_salsa208_keybytes\",\n            both!(\"crypto_stream_salsa208_keybytes\", SizeFn).0,\n            both!(\"crypto_stream_salsa208_keybytes\", SizeFn).1\n        ),\n        32\n    );\n    assert_eq!(\n        eqsz(\n            \"crypto_stream_salsa208_noncebytes\",\n            both!(\"crypto_stream_salsa208_noncebytes\", SizeFn).0,\n            both!(\"crypto_stream_salsa208_noncebytes\", SizeFn).1\n        ),\n        8\n    );\n    assert_eq!(\n        eqsz(\n            \"crypto_stream_salsa208_messagebytes_max\",\n            both!(\"crypto_stream_salsa208_messagebytes_max\", SizeFn).0,\n            both!(\"crypto_stream_salsa208_messagebytes_max\", SizeFn).1\n        ),\n        usize::MAX\n    );\n    let (c, r) = both!(\"crypto_stream_salsa208\", StreamFn);\n    check_stream(\"crypto_stream_salsa208\", c, r, 8, &mut rng);\n    let (c, r) = both!(\"crypto_stream_salsa208_xor\", XorFn);\n    check_xor(\"crypto_stream_salsa208_xor\", c, r, 8, &mut rng);\n}\n\n// =====================================================================\n// crypto_stream/xsalsa20\n// =====================================================================\n\n#[test]\nfn stream_xsalsa20() {\n    let mut rng = common::Rng::new(0x4001);\n    assert_eq!(\n        eqsz(\n            \"crypto_stream_xsalsa20_keybytes\",\n            both!(\"crypto_stream_xsalsa20_keybytes\", SizeFn).0,\n            both!(\"crypto_stream_xsalsa20_keybytes\", SizeFn).1\n        ),\n        32\n    );\n    assert_eq!(\n        eqsz(\n            \"crypto_stream_xsalsa20_noncebytes\",\n            both!(\"crypto_stream_xsalsa20_noncebytes\", SizeFn).0,\n            both!(\"crypto_stream_xsalsa20_noncebytes\", SizeFn).1\n        ),\n        24\n    );\n    assert_eq!(\n        eqsz(\n            \"crypto_stream_xsalsa20_messagebytes_max\",\n            both!(\"crypto_stream_xsalsa20_messagebytes_max\", SizeFn).0,\n            both!(\"crypto_stream_xsalsa20_messagebytes_max\", SizeFn).1\n        ),\n        usize::MAX\n    );\n    let (c, r) = both!(\"crypto_stream_xsalsa20\", StreamFn);\n    check_stream(\"crypto_stream_xsalsa20\", c, r, 24, &mut rng);\n    let (c, r) = both!(\"crypto_stream_xsalsa20_xor\", XorFn);\n    check_xor(\"crypto_stream_xsalsa20_xor\", c, r, 24, &mut rng);\n    let (c, r) = both!(\"crypto_stream_xsalsa20_xor_ic\", XorIcFn);\n    check_xor_ic(\"crypto_stream_xsalsa20_xor_ic\", c, r, 24, &mut rng);\n}\n\n// =====================================================================\n// crypto_stream/crypto_stream.c (generic dispatchers -> xsalsa20)\n// =====================================================================\n\n#[test]\nfn stream_generic() {\n    let mut rng = common::Rng::new(0x5001);\n    assert_eq!(\n        eqsz(\n            \"crypto_stream_keybytes\",\n            both!(\"crypto_stream_keybytes\", SizeFn).0,\n            both!(\"crypto_stream_keybytes\", SizeFn).1\n        ),\n        32\n    );\n    assert_eq!(\n        eqsz(\n            \"crypto_stream_noncebytes\",\n            both!(\"crypto_stream_noncebytes\", SizeFn).0,\n            both!(\"crypto_stream_noncebytes\", SizeFn).1\n        ),\n        24\n    );\n    assert_eq!(\n        eqsz(\n            \"crypto_stream_messagebytes_max\",\n            both!(\"crypto_stream_messagebytes_max\", SizeFn).0,\n            both!(\"crypto_stream_messagebytes_max\", SizeFn).1\n        ),\n        usize::MAX\n    );\n\n    let (c, r) = both!(\"crypto_stream_primitive\", unsafe extern \"C\" fn() -> *const c_char);\n    unsafe {\n        let cs = std::ffi::CStr::from_ptr(c());\n        let rs = std::ffi::CStr::from_ptr(r());\n        assert_eq!(cs, rs, \"crypto_stream_primitive mismatch\");\n        assert_eq!(cs.to_bytes(), b\"xsalsa20\");\n    }\n\n    let (c, r) = both!(\"crypto_stream\", StreamFn);\n    check_stream(\"crypto_stream\", c, r, 24, &mut rng);\n    let (c, r) = both!(\"crypto_stream_xor\", XorFn);\n    check_xor(\"crypto_stream_xor\", c, r, 24, &mut rng);\n}\n\n// =====================================================================\n// crypto_stream/chacha20 — original 8-byte-nonce variant\n// =====================================================================\n\n#[test]\nfn stream_chacha20() {\n    let mut rng = common::Rng::new(0x6001);\n    assert_eq!(\n        eqsz(\n            \"crypto_stream_chacha20_keybytes\",\n            both!(\"crypto_stream_chacha20_keybytes\", SizeFn).0,\n            both!(\"crypto_stream_chacha20_keybytes\", SizeFn).1\n        ),\n        32\n    );\n    assert_eq!(\n        eqsz(\n            \"crypto_stream_chacha20_noncebytes\",\n            both!(\"crypto_stream_chacha20_noncebytes\", SizeFn).0,\n            both!(\"crypto_stream_chacha20_noncebytes\", SizeFn).1\n        ),\n        8\n    );\n    assert_eq!(\n        eqsz(\n            \"crypto_stream_chacha20_messagebytes_max\",\n            both!(\"crypto_stream_chacha20_messagebytes_max\", SizeFn).0,\n            both!(\"crypto_stream_chacha20_messagebytes_max\", SizeFn).1\n        ),\n        usize::MAX\n    );\n    let (c, r) = both!(\"crypto_stream_chacha20\", StreamFn);\n    check_stream(\"crypto_stream_chacha20\", c, r, 8, &mut rng);\n    let (c, r) = both!(\"crypto_stream_chacha20_xor\", XorFn);\n    check_xor(\"crypto_stream_chacha20_xor\", c, r, 8, &mut rng);\n    let (c, r) = both!(\"crypto_stream_chacha20_xor_ic\", XorIcFn);\n    check_xor_ic(\"crypto_stream_chacha20_xor_ic\", c, r, 8, &mut rng);\n}\n\n// =====================================================================\n// crypto_stream/chacha20 — ietf (12-byte nonce, 32-bit counter)\n// =====================================================================\n\n#[test]\nfn stream_chacha20_ietf() {\n    let mut rng = common::Rng::new(0x7001);\n    assert_eq!(\n        eqsz(\n            \"crypto_stream_chacha20_ietf_keybytes\",\n            both!(\"crypto_stream_chacha20_ietf_keybytes\", SizeFn).0,\n            both!(\"crypto_stream_chacha20_ietf_keybytes\", SizeFn).1\n        ),\n        32\n    );\n    assert_eq!(\n        eqsz(\n            \"crypto_stream_chacha20_ietf_noncebytes\",\n            both!(\"crypto_stream_chacha20_ietf_noncebytes\", SizeFn).0,\n            both!(\"crypto_stream_chacha20_ietf_noncebytes\", SizeFn).1\n        ),\n        12\n    );\n    // min(SODIUM_SIZE_MAX, 64 * 2^32) == 64 * 2^32 on 64-bit\n    assert_eq!(\n        eqsz(\n            \"crypto_stream_chacha20_ietf_messagebytes_max\",\n            both!(\"crypto_stream_chacha20_ietf_messagebytes_max\", SizeFn).0,\n            both!(\"crypto_stream_chacha20_ietf_messagebytes_max\", SizeFn).1\n        ),\n        64usize * (1usize << 32)\n    );\n\n    let (c, r) = both!(\"crypto_stream_chacha20_ietf\", StreamFn);\n    check_stream(\"crypto_stream_chacha20_ietf\", c, r, 12, &mut rng);\n    let (c, r) = both!(\"crypto_stream_chacha20_ietf_xor\", XorFn);\n    check_xor(\"crypto_stream_chacha20_ietf_xor\", c, r, 12, &mut rng);\n\n    // ietf_ext_* variants (internal, but exported): counter may overflow into IV\n    let (c, r) = both!(\"crypto_stream_chacha20_ietf_ext\", StreamFn);\n    check_stream(\"crypto_stream_chacha20_ietf_ext\", c, r, 12, &mut rng);\n    let (c, r) = both!(\"crypto_stream_chacha20_ietf_ext_xor_ic\", XorIc32Fn);\n    check_xor_ic32(\"crypto_stream_chacha20_ietf_ext_xor_ic\", c, r, 12, &mut rng);\n}\n\n/// `crypto_stream_chacha20_ietf_xor_ic` rejects `ic` when\n/// `ic > (64*2^32)/64 - (mlen+63)/64`.  Here we hit the *largest accepted* `ic`\n/// for a range of message lengths (the exact boundary of that check), plus the\n/// value just below it.\n#[test]\nfn stream_chacha20_ietf_xor_ic_counter_boundary() {\n    let (c, r) = both!(\"crypto_stream_chacha20_ietf_xor_ic\", XorIc32Fn);\n    let mut rng = common::Rng::new(0x7002);\n\n    // (mlen, largest ic still accepted) = (mlen, 2^32 - ceil(mlen/64))\n    let cases: &[(usize, u32)] = &[\n        (0, 0xffff_ffff), // limit is 2^32, so any u32 ic is accepted\n        (1, 0xffff_ffff),\n        (63, 0xffff_ffff),\n        (64, 0xffff_ffff),\n        (65, 0xffff_fffe),\n        (127, 0xffff_fffe),\n        (128, 0xffff_fffe),\n        (129, 0xffff_fffd),\n        (192, 0xffff_fffd),\n        (256, 0xffff_fffc),\n        (1000, 0xffff_fff0),\n        (1024, 0xffff_fff0),\n        (1025, 0xffff_ffef),\n    ];\n    for &(len, ic_max) in cases {\n        for ic in [ic_max, ic_max.wrapping_sub(1), 0, 1] {\n            let k = rng.bytes(32);\n            let n = rng.bytes(12);\n            let m = rng.bytes(len);\n            let mut cb = vec![CAN; len + PAD];\n            let mut rb = vec![CAN; len + PAD];\n            let rc = unsafe {\n                c(\n                    cb.as_mut_ptr(),\n                    m.as_ptr(),\n                    len as u64,\n                    n.as_ptr(),\n                    ic,\n                    k.as_ptr(),\n                )\n            };\n            let rr = unsafe {\n                r(\n                    rb.as_mut_ptr(),\n                    m.as_ptr(),\n                    len as u64,\n                    n.as_ptr(),\n                    ic,\n                    k.as_ptr(),\n                )\n            };\n            let tag = format!(\"ietf_xor_ic len={} ic={:#x}\", len, ic);\n            common::eqi(&tag, rc, rr);\n            common::eqb(&tag, &cb, &rb);\n            assert!(cb[len..].iter().all(|&b| b == CAN), \"{}: overrun\", tag);\n        }\n    }\n}\n\n#[test]\nfn stream_chacha20_ref_implementation_struct() {\n    let (cp, rp) = both_data!(\"crypto_stream_chacha20_ref_implementation\", Chacha20Impl);\n    let (ci, ri) = unsafe { (&*cp, &*rp) };\n    let mut rng = common::Rng::new(0x6002);\n    check_stream(\"chacha20_ref_impl.stream\", ci.stream, ri.stream, 8, &mut rng);\n    check_stream(\n        \"chacha20_ref_impl.stream_ietf_ext\",\n        ci.stream_ietf_ext,\n        ri.stream_ietf_ext,\n        12,\n        &mut rng,\n    );\n    check_xor_ic(\n        \"chacha20_ref_impl.stream_xor_ic\",\n        ci.stream_xor_ic,\n        ri.stream_xor_ic,\n        8,\n        &mut rng,\n    );\n    check_xor_ic32(\n        \"chacha20_ref_impl.stream_ietf_ext_xor_ic\",\n        ci.stream_ietf_ext_xor_ic,\n        ri.stream_ietf_ext_xor_ic,\n        12,\n        &mut rng,\n    );\n}\n\n#[test]\nfn stream_chacha20_pick_best_implementation() {\n    let (c, r) = both!(\"_crypto_stream_chacha20_pick_best_implementation\", IntFn);\n    let rc = unsafe { c() };\n    let rr = unsafe { r() };\n    common::eqi(\"_crypto_stream_chacha20_pick_best_implementation\", rc, rr);\n    assert_eq!(rc, 0);\n    let mut rng = common::Rng::new(0x6003);\n    let (c, r) = both!(\"crypto_stream_chacha20\", StreamFn);\n    check_stream(\"crypto_stream_chacha20 (post-pick)\", c, r, 8, &mut rng);\n}\n\n// =====================================================================\n// crypto_stream/xchacha20\n// =====================================================================\n\n#[test]\nfn stream_xchacha20() {\n    let mut rng = common::Rng::new(0x8001);\n    assert_eq!(\n        eqsz(\n            \"crypto_stream_xchacha20_keybytes\",\n            both!(\"crypto_stream_xchacha20_keybytes\", SizeFn).0,\n            both!(\"crypto_stream_xchacha20_keybytes\", SizeFn).1\n        ),\n        32\n    );\n    assert_eq!(\n        eqsz(\n            \"crypto_stream_xchacha20_noncebytes\",\n            both!(\"crypto_stream_xchacha20_noncebytes\", SizeFn).0,\n            both!(\"crypto_stream_xchacha20_noncebytes\", SizeFn).1\n        ),\n        24\n    );\n    assert_eq!(\n        eqsz(\n            \"crypto_stream_xchacha20_messagebytes_max\",\n            both!(\"crypto_stream_xchacha20_messagebytes_max\", SizeFn).0,\n            both!(\"crypto_stream_xchacha20_messagebytes_max\", SizeFn).1\n        ),\n        usize::MAX\n    );\n    let (c, r) = both!(\"crypto_stream_xchacha20\", StreamFn);\n    check_stream(\"crypto_stream_xchacha20\", c, r, 24, &mut rng);\n    let (c, r) = both!(\"crypto_stream_xchacha20_xor\", XorFn);\n    check_xor(\"crypto_stream_xchacha20_xor\", c, r, 24, &mut rng);\n    let (c, r) = both!(\"crypto_stream_xchacha20_xor_ic\", XorIcFn);\n    check_xor_ic(\"crypto_stream_xchacha20_xor_ic\", c, r, 24, &mut rng);\n}\n\n// =====================================================================\n// Zero-length / NULL-pointer tolerance\n// =====================================================================\n\n#[test]\nfn zero_length_null_pointers() {\n    let mut rng = common::Rng::new(0x9001);\n    let k = rng.bytes(32);\n    let n24 = rng.bytes(24);\n    let nul: *mut u8 = core::ptr::null_mut();\n    let cnul: *const u8 = core::ptr::null();\n\n    // The salsa20/2012/208 and chacha20 reference bodies do `if (!clen) return 0;`\n    // *before* dereferencing any pointer, so all four pointers may be NULL.\n    for name in [\n        \"crypto_stream_salsa20\",\n        \"crypto_stream_salsa2012\",\n        \"crypto_stream_salsa208\",\n        \"crypto_stream_chacha20\",\n        \"crypto_stream_chacha20_ietf\",\n        \"crypto_stream_chacha20_ietf_ext\",\n    ] {\n        let (c, r) = both!(name, StreamFn);\n        let rc = unsafe { c(nul, 0, cnul, cnul) };\n        let rr = unsafe { r(nul, 0, cnul, cnul) };\n        common::eqi(&format!(\"{} clen=0 all-NULL\", name), rc, rr);\n        assert_eq!(rc, 0, \"{} clen=0 should return 0\", name);\n    }\n    for name in [\n        \"crypto_stream_salsa20_xor\",\n        \"crypto_stream_salsa2012_xor\",\n        \"crypto_stream_salsa208_xor\",\n        \"crypto_stream_chacha20_xor\",\n        \"crypto_stream_chacha20_ietf_xor\",\n    ] {\n        let (c, r) = both!(name, XorFn);\n        let rc = unsafe { c(nul, cnul, 0, cnul, cnul) };\n        let rr = unsafe { r(nul, cnul, 0, cnul, cnul) };\n        common::eqi(&format!(\"{} mlen=0 all-NULL\", name), rc, rr);\n        assert_eq!(rc, 0, \"{} mlen=0 should return 0\", name);\n    }\n    for name in [\"crypto_stream_salsa20_xor_ic\", \"crypto_stream_chacha20_xor_ic\"] {\n        let (c, r) = both!(name, XorIcFn);\n        for ic in [0u64, 1, u64::MAX] {\n            let rc = unsafe { c(nul, cnul, 0, cnul, ic, cnul) };\n            let rr = unsafe { r(nul, cnul, 0, cnul, ic, cnul) };\n            common::eqi(&format!(\"{} mlen=0 all-NULL ic={:#x}\", name, ic), rc, rr);\n            assert_eq!(rc, 0);\n        }\n    }\n    {\n        let (c, r) = both!(\"crypto_stream_chacha20_ietf_ext_xor_ic\", XorIc32Fn);\n        for ic in [0u32, 1, 0xffff_ffff] {\n            let rc = unsafe { c(nul, cnul, 0, cnul, ic, cnul) };\n            let rr = unsafe { r(nul, cnul, 0, cnul, ic, cnul) };\n            common::eqi(\"ietf_ext_xor_ic mlen=0 all-NULL\", rc, rr);\n            assert_eq!(rc, 0);\n        }\n        let (c, r) = both!(\"crypto_stream_chacha20_ietf_xor_ic\", XorIc32Fn);\n        for ic in [0u32, 1, 0xffff_ffff] {\n            let rc = unsafe { c(nul, cnul, 0, cnul, ic, cnul) };\n            let rr = unsafe { r(nul, cnul, 0, cnul, ic, cnul) };\n            common::eqi(\"ietf_xor_ic mlen=0 all-NULL\", rc, rr);\n            assert_eq!(rc, 0);\n        }\n    }\n\n    // x-variants derive a subkey *first*, so n and k must be valid; only the\n    // message/output pointers may be NULL when the length is 0.\n    for name in [\n        \"crypto_stream_xsalsa20\",\n        \"crypto_stream_xchacha20\",\n        \"crypto_stream\",\n    ] {\n        let (c, r) = both!(name, StreamFn);\n        let rc = unsafe { c(nul, 0, n24.as_ptr(), k.as_ptr()) };\n        let rr = unsafe { r(nul, 0, n24.as_ptr(), k.as_ptr()) };\n        common::eqi(&format!(\"{} clen=0 c=NULL\", name), rc, rr);\n        assert_eq!(rc, 0);\n    }\n    for name in [\n        \"crypto_stream_xsalsa20_xor\",\n        \"crypto_stream_xchacha20_xor\",\n        \"crypto_stream_xor\",\n    ] {\n        let (c, r) = both!(name, XorFn);\n        let rc = unsafe { c(nul, cnul, 0, n24.as_ptr(), k.as_ptr()) };\n        let rr = unsafe { r(nul, cnul, 0, n24.as_ptr(), k.as_ptr()) };\n        common::eqi(&format!(\"{} mlen=0 c/m=NULL\", name), rc, rr);\n        assert_eq!(rc, 0);\n    }\n    for name in [\n        \"crypto_stream_xsalsa20_xor_ic\",\n        \"crypto_stream_xchacha20_xor_ic\",\n    ] {\n        let (c, r) = both!(name, XorIcFn);\n        for ic in [0u64, u64::MAX] {\n            let rc = unsafe { c(nul, cnul, 0, n24.as_ptr(), ic, k.as_ptr()) };\n            let rr = unsafe { r(nul, cnul, 0, n24.as_ptr(), ic, k.as_ptr()) };\n            common::eqi(&format!(\"{} mlen=0 c/m=NULL\", name), rc, rr);\n            assert_eq!(rc, 0);\n        }\n    }\n}\n\n// =====================================================================\n// *_keygen — made deterministic by installing a fixed randombytes backend\n// in BOTH libraries, so the outputs can be compared byte-for-byte.\n// =====================================================================\n\nextern \"C\" fn det_name() -> *const c_char {\n    b\"stream-test-det\\0\".as_ptr() as *const c_char\n}\nextern \"C\" fn det_random() -> u32 {\n    0x1234_5678\n}\nextern \"C\" fn det_stir() {}\nextern \"C\" fn det_buf(buf: *mut c_void, size: usize) {\n    // Stateless, so both libraries produce identical bytes.\n    unsafe {\n        let p = buf as *mut u8;\n        for i in 0..size {\n            *p.add(i) = (i as u8).wrapping_mul(37).wrapping_add(11);\n        }\n    }\n}\nextern \"C\" fn det_close() -> c_int {\n    0\n}\n\n#[repr(C)]\nstruct RbImpl {\n    implementation_name: extern \"C\" fn() -> *const c_char,\n    random: extern \"C\" fn() -> u32,\n    stir: extern \"C\" fn(),\n    uniform: Option<extern \"C\" fn(u32) -> u32>,\n    buf: extern \"C\" fn(*mut c_void, usize),\n    close: extern \"C\" fn() -> c_int,\n}\n\nstatic DET_IMPL: RbImpl = RbImpl {\n    implementation_name: det_name,\n    random: det_random,\n    stir: det_stir,\n    uniform: None,\n    buf: det_buf,\n    close: det_close,\n};\n\n#[test]\nfn keygen_all_variants() {\n    type SetImpl = unsafe extern \"C\" fn(*const RbImpl) -> c_int;\n    let (cset, rset) = both!(\"randombytes_set_implementation\", SetImpl);\n    let p: *const RbImpl = &DET_IMPL;\n    assert_eq!(unsafe { cset(p) }, 0);\n    assert_eq!(unsafe { rset(p) }, 0);\n\n    let expected: Vec<u8> = (0..32u8).map(|i| i.wrapping_mul(37).wrapping_add(11)).collect();\n\n    for name in [\n        \"crypto_stream_keygen\",\n        \"crypto_stream_salsa20_keygen\",\n        \"crypto_stream_salsa2012_keygen\",\n        \"crypto_stream_salsa208_keygen\",\n        \"crypto_stream_xsalsa20_keygen\",\n        \"crypto_stream_chacha20_keygen\",\n        \"crypto_stream_chacha20_ietf_keygen\",\n        \"crypto_stream_xchacha20_keygen\",\n    ] {\n        let (c, r) = both!(name, KeygenFn);\n        let mut cb = vec![CAN; 32 + PAD];\n        let mut rb = vec![CAN; 32 + PAD];\n        unsafe { c(cb.as_mut_ptr()) };\n        unsafe { r(rb.as_mut_ptr()) };\n        common::eqb(name, &cb, &rb);\n        common::eqb(&format!(\"{} pattern\", name), &cb[..32], &expected);\n        assert!(\n            cb[32..].iter().all(|&b| b == CAN),\n            \"{}: wrote more than KEYBYTES\",\n            name\n        );\n    }\n}\n\n// =====================================================================\n// sodium_misuse() paths — verified out-of-process (they abort()).\n// =====================================================================\n\n#[cfg(unix)]\n#[test]\nfn misuse_paths_abort_in_both_libraries() {\n    use std::os::unix::process::ExitStatusExt;\n    use std::process::Command;\n\n    const IETF_MAX: u64 = 64u64 * (1u64 << 32);\n\n    if let Ok(spec) = std::env::var(\"STREAM_MISUSE_CASE\") {\n        // Child: perform one misusing call against one library; it must abort.\n        let (which, case) = spec.split_once(':').unwrap();\n        let l = common::libs();\n        let lib = if which == \"c\" { &l.c } else { &l.r };\n        let k = [0u8; 32];\n        let n = [0u8; 12];\n        let mut out = [0u8; 128];\n        unsafe {\n            match case {\n                // crypto_stream_chacha20_ietf: clen > ietf_MESSAGEBYTES_MAX.\n                // The check runs before any memory is touched.\n                \"ietf\" => {\n                    let f = getsym!(lib, \"crypto_stream_chacha20_ietf\", StreamFn);\n                    f(out.as_mut_ptr(), IETF_MAX + 1, n.as_ptr(), k.as_ptr());\n                }\n                // crypto_stream_chacha20_ietf_xor: mlen > ietf_MESSAGEBYTES_MAX\n                \"ietf_xor\" => {\n                    let f = getsym!(lib, \"crypto_stream_chacha20_ietf_xor\", XorFn);\n                    f(\n                        out.as_mut_ptr(),\n                        out.as_ptr(),\n                        IETF_MAX + 1,\n                        n.as_ptr(),\n                        k.as_ptr(),\n                    );\n                }\n                // crypto_stream_chacha20_ietf_xor_ic:\n                // ic > (64*2^32)/64 - (mlen+63)/64  ->  65 bytes needs ic <= 2^32-2\n                \"ietf_xor_ic\" => {\n                    let f = getsym!(lib, \"crypto_stream_chacha20_ietf_xor_ic\", XorIc32Fn);\n                    f(\n                        out.as_mut_ptr(),\n                        out.as_ptr(),\n                        65,\n                        n.as_ptr(),\n                        0xffff_ffff,\n                        k.as_ptr(),\n                    );\n                }\n                other => panic!(\"unknown case {}\", other),\n            }\n        }\n        // Reaching here means the misuse check did NOT fire.\n        eprintln!(\"NO_ABORT\");\n        std::process::exit(17);\n    }\n\n    let exe = std::env::current_exe().unwrap();\n    for case in [\"ietf\", \"ietf_xor\", \"ietf_xor_ic\"] {\n        let mut sigs = Vec::new();\n        for which in [\"c\", \"r\"] {\n            let out = Command::new(&exe)\n                .args([\n                    \"misuse_paths_abort_in_both_libraries\",\n                    \"--exact\",\n                    \"--nocapture\",\n                    \"--test-threads=1\",\n                ])\n                .env(\"STREAM_MISUSE_CASE\", format!(\"{}:{}\", which, case))\n                .output()\n                .expect(\"spawn self\");\n            assert_ne!(\n                out.status.code(),\n                Some(17),\n                \"{}/{}: misuse check did not fire\",\n                which,\n                case\n            );\n            sigs.push(out.status.signal());\n        }\n        assert_eq!(\n            sigs[0], sigs[1],\n            \"case {}: C aborted with {:?} but Rust with {:?}\",\n            case, sigs[0], sigs[1]\n        );\n        assert_eq!(\n            sigs[0],\n            Some(6),\n            \"case {}: expected SIGABRT from sodium_misuse()\",\n            case\n        );\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8420,"cache_read_input_tokens":96214,"cache_creation":{"ephemeral_5m_input_tokens":8420,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_01TKcH65R2s78D3xqfbtWGZy","session_id":"f6aed658-f045-47ac-a150-aec5e315d5dc","uuid":"d2a8cf28-5e0d-42ce-b5c9