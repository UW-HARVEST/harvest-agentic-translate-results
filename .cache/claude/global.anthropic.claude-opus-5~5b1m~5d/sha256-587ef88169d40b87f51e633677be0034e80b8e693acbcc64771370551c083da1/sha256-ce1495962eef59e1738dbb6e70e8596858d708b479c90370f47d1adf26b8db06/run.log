\t            j13 = j13.wrapping_add(1);\n222\t        }\n223\t\n224\t        store32_le(c.add(0), x0);\n225\t        store32_le(c.add(4), x1);\n226\t        store32_le(c.add(8), x2);\n227\t        store32_le(c.add(12), x3);\n228\t        store32_le(c.add(16), x4);\n229\t        store32_le(c.add(20), x5);\n230\t        store32_le(c.add(24), x6);\n231\t        store32_le(c.add(28), x7);\n232\t        store32_le(c.add(32), x8);\n233\t        store32_le(c.add(36), x9);\n234\t        store32_le(c.add(40), x10);\n235\t        store32_le(c.add(44), x11);\n236\t        store32_le(c.add(48), x12);\n237\t        store32_le(c.add(52), x13);\n238\t        store32_le(c.add(56), x14);\n239\t        store32_le(c.add(60), x15);\n240\t\n241\t        if bytes <= 64 {\n242\t            if bytes < 64 {\n243\t                for i in 0..(bytes as usize) {\n244\t                    *ctarget.add(i) = *c.add(i);\n245\t                }\n246\t            }\n247\t            ctx.input[12] = j12;\n248\t            ctx.input[13] = j13;\n249\t\n250\t            return;\n251\t        }\n252\t        bytes -= 64;\n253\t        c = c.add(64);\n254\t        m = m.add(64);\n255\t    }\n256\t}\n257\t\n258\tunsafe extern \"C\" fn stream_ref(c: *mut u8, clen: u64, n: *const u8, k: *const u8) -> c_int {\n259\t    let mut ctx = ChachaCtx { input: [0u32; 16] };\n260\t\n261\t    if clen == 0 {\n262\t        return 0;\n263\t    }\n264\t    chacha_keysetup(&mut ctx, k);\n265\t    chacha_ivsetup(&mut ctx, n, core::ptr::null());\n266\t    memset(c as *mut core::ffi::c_void, 0, clen as usize);\n267\t    chacha20_encrypt_bytes(&mut ctx, c, c, clen);\n268\t    sodium_memzero(\n269\t        &mut ctx as *mut ChachaCtx as *mut u8,\n270\t        core::mem::size_of::<ChachaCtx>(),\n271\t    );\n272\t\n273\t    0\n274\t}\n275\t\n276\tunsafe extern \"C\" fn stream_ietf_ext_ref(\n277\t    c: *mut u8,\n278\t    clen: u64,\n279\t    n: *const u8,\n280\t    k: *const u8,\n281\t) -> c_int {\n282\t    let mut ctx = ChachaCtx