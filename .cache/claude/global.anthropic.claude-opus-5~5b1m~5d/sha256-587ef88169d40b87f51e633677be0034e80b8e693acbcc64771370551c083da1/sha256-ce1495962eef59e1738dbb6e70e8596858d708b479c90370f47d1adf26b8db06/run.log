================================================================\n46\t// crypto_stream/chacha20/ref/chacha20_ref.c\n47\t// =====================================================================\n48\t\n49\tmacro_rules! quarterround {\n50\t    ($a:expr, $b:expr, $c:expr, $d:expr) => {\n51\t        $a = $a.wrapping_add($b);\n52\t        $d = rotl32($d ^ $a, 16);\n53\t        $c = $c.wrapping_add($d);\n54\t        $b = rotl32($b ^ $c, 12);\n55\t        $a = $a.wrapping_add($b);\n56\t        $d = rotl32($d ^ $a, 8);\n57\t        $c = $c.wrapping_add($d);\n58\t        $b = rotl32($b ^ $c, 7);\n59\t    };\n60\t}\n61\t\n62\t#[repr(C)]\n63\tstruct ChachaCtx {\n64\t    input: [u32; 16],\n65\t}\n66\t\n67\tunsafe fn chacha_keysetup(ctx: &mut ChachaCtx, k: *const u8) {\n68\t    ctx.input[0] = 0x6170_7865;\n69\t    ctx.input[1] = 0x3320_646e;\n70\t    ctx.input[2] = 0x7962_2d32;\n71\t    ctx.input[3] = 0x6b20_6574;\n72\t    ctx.input[4] = load32_le(k.add(0));\n73\t    ctx.input[5] = load32_le(k.add(4));\n74\t    ctx.input[6] = load32_le(k.add(8));\n75\t    ctx.input[7] = load32_le(k.add(12));\n76\t    ctx.input[8] = load32_le(k.add(16));\n77\t    ctx.input[9] = load32_le(k.add(20));\n78\t    ctx.input[10] = load32_le(k.add(24));\n79\t    ctx.input[11] = load32_le(k.add(28));\n80\t}\n81\t\n82\tunsafe fn chacha_ivsetup(ctx: &mut ChachaCtx, iv: *const u8, counter: *const u8) {\n83\t    ctx.input[12] = if counter.is_null() {\n84\t        0\n85\t    } else {\n86\t        load32_le(counter.add(0))\n87\t    };\n88\t    ctx.input[13] = if counter.is_null() {\n89\t        0\n90\t    } else {\n91\t        load32_le(counter.add(4))\n92\t    };\n93\t    ctx.input[14] = load32_le(iv.add(0));\n94\t    ctx.input[15] = load32_le(iv.add(4));\n95\t}\n96\t\n97\tunsafe fn chacha_ietf_ivsetup(ctx: &mut ChachaCtx, iv: *const u8, counter: *const u8) {\n98\t    ctx.input[12] = if counter.is_null() {\n99\t        0\n100\t    } else {\n101\t        load32_le(counter)\n102\t    };\n103\t    ctx.input[13] = load32_le(iv.add(0));\n104\t    ctx.input[14] = load32_le(iv.add(4));\n105\t    ctx.input[15] = load32_le(iv.add(8));\n106\t}\n107\t\n108\tunsafe fn chacha20_encrypt_bytes(\n109\t    ctx: &mut ChachaCtx,\n110\t    m: *const u8,\n111\t    c: *mut u8,\n112\t    bytes: u64,\n113\t) {\n114\t    let (mut x0, mut x1, mut x2, mut x3, mut x4, mut x5, mut x6, mut x7);\n115\t    let (mut x8, mut x9, mut x10, mut x11, mut x12, mut x13, mut x14, mut x15);\n116\t    let (mut j12, mut j13);\n117\t    let mut ctarget: *mut u8 = core::ptr::null_mut();\n118\t    let mut tmp = [0u8; 64];\n119\t    let mut bytes = bytes;\n120\t    let mut m = m;\n121\t    let mut c = c;\n122\t\n123\t    if bytes == 0 {\n124\t        return;\n125\t    }\n126\t    let j0 = ctx.input[0];\n127\t    let j1 = ctx.input[1];\n128\t    let j2 = ctx.input[2];\n129\t    let j3 = ctx.input[3];\n130\t    let j4 = ctx.input[4];\n131\t    let j5 = ctx.input[5];\n132\t    let j6 = ctx.input[6];\n133\t    let j7 = ctx.input[7];\n134\t    let j8 = ctx.input[8];\n135\t    let j9 = ctx.input[9];\n136\t    let j10 = ctx.input[10];\n137\t    let j11 = ctx.input[11];\n138\t    j12 = ctx.input[12];\n139\t    j13 = ctx.input[13];\n140\t    let j14 = ctx.input[14];\n141\t    let j15 = ctx.input[15];\n142\t    let mut j12 = j12;\n143\t    let mut j13 = j13;\n144\t\n145\t    loop {\n146\t        if bytes < 64 {\n147\t            memset(tmp.as_mut_ptr() as *mut core::ffi::c_void, 0, 64);\n148\t            for i in 0..(bytes as usize) {\n149\t                tmp[i] = *m.add(i);\n150\t            }\n151\t            m = tmp.as_ptr();\n152\t            ctarget = c;\n153\t            c = tmp.as_mut_ptr();\n154\t        }\n155\t        x0 = j0;\n156\t        x1 = j1;\n157\t        x2 = j2;\n158\t        x3 = j3;\n159\t        x4 = j4;\n160\t        x5 = j5;\n161\t        x6 = j6;\n162\t        x7 = j7;\n163\t        x8 = j8;\n164\t        x9 = j9;\n165\t        x10 = j10;\n166\t        x11 = j11;\n167\t        x12 = j12;\n168\t       