{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01CBKx17AJ87gBJHfN9oLY8X","type":"tool_result","content":"1\t//! Rust translation of `crypto_ipcrypt/crypto_ipcrypt.c` and\n2\t//! `crypto_ipcrypt/ipcrypt_soft.c`.\n3\t//!\n4\t//! In the reference build configuration (no `HAVE_*` macros defined),\n5\t//! `ipcrypt_aesni.c` and `ipcrypt_armcrypto.c` are entirely `#ifdef`-ed out,\n6\t//! so `_crypto_ipcrypt_pick_best_implementation()` always selects the soft\n7\t//! (`ipcrypt_soft_implementation`) backend.\n8\t\n9\tuse core::ffi::{c_int, c_void};\n10\t\n11\t// ---------------------------------------------------------------------\n12\t// softaes glue (include/sodium/private/softaes.h)\n13\t// ---------------------------------------------------------------------\n14\t\n15\t#[repr(C)]\n16\t#[derive(Copy, Clone)]\n17\tpub struct SoftAesBlock {\n18\t    pub w0: u32,\n19\t    pub w1: u32,\n20\t    pub w2: u32,\n21\t    pub w3: u32,\n22\t}\n23\t\n24\tconst ZERO_BLOCK: SoftAesBlock = SoftAesBlock { w0: 0, w1: 0, w2: 0, w3: 0 };\n25\t\n26\textern \"C\" {\n27\t    #[link_name = \"_sodium_softaes_expand_key128\"]\n28\t    fn softaes_expand_key128(rkeys: *mut SoftAesBlock, key: *const u8);\n29\t    #[link_name = \"_sodium_softaes_invert_key_schedule128\"]\n30\t    fn softaes_invert_key_schedule128(rkeys: *mut SoftAesBlock);\n31\t    #[link_name = \"_sodium_softaes_inv_mix_columns\"]\n32\t    fn softaes_inv_mix_columns(block: SoftAesBlock) -> SoftAesBlock;\n33\t    #[link_name = \"_sodium_softaes_block_encrypt\"]\n34\t    fn softaes_block_encrypt(block: SoftAesBlock, rk: SoftAesBlock) -> SoftAesBlock;\n35\t    #[link_name = \"_sodium_softaes_block_decrypt\"]\n36\t    fn softaes_block_decrypt(block: SoftAesBlock, rk: SoftAesBlock) -> SoftAesBlock;\n37\t    #[link_name = \"_sodium_softaes_block_encryptlast\"]\n38\t    fn softaes_block_encryptlast(block: SoftAesBlock, rk: SoftAesBlock) -> SoftAesBlock;\n39\t    #[link_name = \"_sodium_softaes_block_decryptlast\"]\n40\t    fn softaes_block_decryptlast(block: SoftAesBlock, rk: SoftAesBlock) -> SoftAesBlock;\n41\t\n42\t    fn sodium_memzero(pnt: *mut c_void, len: usize);\n43\t    fn memcpy(dest: *mut c_void, src: *const c_void, n: usize) -> *mut c_void;\n44\t    fn memset(dest: *mut c_void, val: c_int, n: usize) -> *mut c_void;\n45\t    fn memcmp(a: *const c_void, b: *const c_void, n: usize) -> c_int;\n46\t    fn randombytes_buf(buf: *mut c_void, size: usize);\n47\t}\n48\t\n49\t// `softaes_block_{load,store,xor}` are `static inline` in\n50\t// `private/softaes.h`, so they are translated locally rather than declared\n51\t// `extern`.\n52\t#[inline(always)]\n53\tunsafe fn softaes_block_load(inp: *const u8) -> SoftAesBlock {\n54\t    SoftAesBlock {\n55\t        w0: crate::common::load32_le(inp),\n56\t        w1: crate::common::load32_le(inp.add(4)),\n57\t        w2: crate::common::load32_le(inp.add(8)),\n58\t        w3: crate::common::load32_le(inp.add(12)),\n59\t    }\n60\t}\n61\t\n62\t#[inline(always)]\n63\tunsafe fn softaes_block_store(out: *mut u8, inb: SoftAesBlock) {\n64\t    crate::common::store32_le(out, inb.w0);\n65\t    crate::common::store32_le(out.add(4), inb.w1);\n66\t    crate::common::store32_le(out.add(8), inb.w2);\n67\t    crate::common::store32_le(out.add(12), inb.w3);\n68\t}\n69\t\n70\t#[inline(always)]\n71\tfn softaes_block_xor(a: SoftAesBlock, b: SoftAesBlock) -> SoftAesBlock {\n72\t    SoftAesBlock { w0: a.w0 ^ b.w0, w1: a.w1 ^ b.w1, w2: a.w2 ^ b.w2, w3: a.w3 ^ b.w3 }\n73\t}\n74\t\n75\t// ---------------------------------------------------------------------\n76\t// ipcrypt_soft.c\n77\t// ---------------------------------------------------------------------\n78\t\n79\ttype KeySchedule = [SoftAesBlock; 11]; // 1 + 10\n80\t\n81\t#[inline(always)]\n82\tunsafe fn expand_key(rkeys: &mut KeySchedule, key: *const u8) {\n83\t    softaes_expand_key128(rkeys.as_mut_ptr(), key);\n84\t}\n85\t\n86\tunsafe fn aes_encrypt(out: *mut u8, inp: *const u8, rkeys: &KeySchedu