{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01SWADbJmK5p7spyRp1zLXxG","type":"tool_result","content":"1\t//! Translated from `c_src/libsodium/sodium/codecs.c`.\n2\t//!\n3\t//! bin2hex / hex2bin, base64 encode/decode variants, ip2bin / bin2ip.\n4\t\n5\t#![allow(non_upper_case_globals)]\n6\t\n7\tuse core::ffi::{c_char, c_int, c_void};\n8\t\n9\tuse crate::csys::{memcmp, memcpy, memmove, memset, strchr, size_t};\n10\t\n11\textern \"C\" {\n12\t    fn sodium_misuse() -> !;\n13\t    fn memchr(s: *const c_void, c: c_int, n: size_t) -> *mut c_void;\n14\t}\n15\t\n16\t/// `SIZE_MAX` as used by the C source (matches `usize::MAX` on this target).\n17\tconst SIZE_MAX: usize = usize::MAX;\n18\t\n19\t// ---------------------------------------------------------------------\n20\t// bin2hex / hex2bin\n21\t// ---------------------------------------------------------------------\n22\t\n23\t/// `(unsigned char) (87U + v + (((v - 10U) >> 8) & ~38U))`, computed in\n24\t/// 32-bit unsigned arithmetic exactly as C promotes it, then truncated to a\n25\t/// byte (matching the explicit `(unsigned char)` cast in the source).\n26\t#[inline(always)]\n27\tfn hex_nibble_enc(v: u32) -> u32 {\n28\t    let raw = 87u32\n29\t        .wrapping_add(v)\n30\t        .wrapping_add((v.wrapping_sub(10) >> 8) & !38u32);\n31\t    (raw as u8) as u32\n32\t}\n33\t\n34\t#[no_mangle]\n35\tpub unsafe extern \"C\" fn sodium_bin2hex(\n36\t    hex: *mut c_char,\n37\t    hex_maxlen: usize,\n38\t    bin: *const u8,\n39\t    bin_len: usize,\n40\t) -> *mut c_char {\n41\t    let mut i: usize = 0;\n42\t    let mut x: u32;\n43\t\n44\t    if bin_len >= SIZE_MAX / 2 || hex_maxlen <= bin_len.wrapping_mul(2) {\n45\t        sodium_misuse(); /* LCOV_EXCL_LINE */\n46\t    }\n47\t    while i < bin_len {\n48\t        let byte = *bin.add(i) as u32;\n49\t        let c = byte & 0xf;\n50\t        let b = byte >> 4;\n51\t        x = (hex_nibble_enc(c) << 8) | hex_nibble_enc(b);\n52\t        *hex.add(i * 2) = 