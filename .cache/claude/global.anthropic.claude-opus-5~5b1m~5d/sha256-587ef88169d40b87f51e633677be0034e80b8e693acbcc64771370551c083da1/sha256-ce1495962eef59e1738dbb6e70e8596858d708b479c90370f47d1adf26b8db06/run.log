);\n78\t\n79\tvoid ge25519_p3_tobytes(unsigned char *s, const ge25519_p3 *h);\n80\t\n81\tint ge25519_frombytes(ge25519_p3 *h, const unsigned char *s);\n82\t\n83\tint ge25519_frombytes_negate_vartime(ge25519_p3 *h, const unsigned char *s);\n84\t\n85\tvoid ge25519_p1p1_to_p2(ge25519_p2 *r, const ge25519_p1p1 *p);\n86\t\n87\tvoid ge25519_p1p1_to_p3(ge25519_p3 *r, const ge25519_p1p1 *p);\n88\t\n89\tvoid ge25519_p2_to_p3(ge25519_p3 *r, const ge25519_p2 *p);\n90\t\n91\tvoid ge25519_p3_add(ge25519_p3 *r, const ge25519_p3 *p, const ge25519_p3 *q);\n92\t\n93\tvoid ge25519_p3_sub(ge25519_p3 *r, const ge25519_p3 *p, const ge25519_p3 *q);\n94\t\n95\tvoid ge25519_scalarmult_base(ge25519_p3 *h, const unsigned char *a);\n96\t\n97\tvoid ge25519_double_scalarmult_vartime(ge25519_p2 *r, const unsigned char *a,\n98\t                                       const ge25519_p3 *A,\n99\t                                       const unsigned char *b);\n100\t\n101\tvoid ge25519_scalarmult(ge25519_p3 *h, const unsigned char *a,\n102\t                        const ge25519_p3 *p);\n103\t\n104\tvoid ge25519_clear_cofactor(ge25519_p3 *p3);\n105\t\n106\tint ge25519_is_canonical(const unsigned char *s);\n107\t\n108\tint ge25519_is_on_curve(const ge25519_p3 *p);\n109\t\n110\tint ge25519_is_on_main_subgroup(const ge25519_p3 *p);\n111\t\n112\tint ge25519_has_small_order(const ge25519_p3 *p);\n113\t\n114\tvoid ge25519_from_uniform(unsigned char s[32], const unsigned char r[32]);\n115\t\n116\tvoid ge25519_from_hash(unsigned char s[32], const unsigned char h[64]);\n117\t\n118\t/*\n119\t Ristretto group\n120\t */\n121\t\n122\tint ristretto255_frombytes(ge25519_p3 *h, const unsigned char *s);\n123\t\n124\tvoid ristretto255_p3_tobytes(unsigned char *s, const ge25519_p3 *h);\n125\t\n126\tvoid ristretto255_from_hash(unsigned char s[32], const unsigned char h[64]);\n127\t\n128\t/*\n129\t The set of scalars is \\Z/l\n130\t where l = 2^252 + 27742317777372353535851937790883648493.\n131\t */\n132\t\n133\tvoid sc2551