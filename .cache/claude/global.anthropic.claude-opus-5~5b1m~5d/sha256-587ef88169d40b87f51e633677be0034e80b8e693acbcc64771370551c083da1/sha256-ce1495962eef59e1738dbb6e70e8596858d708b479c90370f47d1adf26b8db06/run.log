&mut str_, b\"$argon2i\\0\") {\n            return ARGON2_DECODING_FAIL;\n        }\n    } else {\n        return ARGON2_INCORRECT_TYPE;\n    }\n\n    if !cc(&mut str_, b\"$v=\\0\") {\n        return ARGON2_DECODING_FAIL;\n    }\n    // DECIMAL_U32(version)\n--- encoding encode\n    let mut dst_len = dst_len;\n\n    if type_ == Argon2_id {\n        if !ss(&mut dst, &mut dst_len, b\"$argon2id$v=\") {\n            return ARGON2_ENCODING_FAIL;\n        }\n    } else if type_ == Argon2_i {\n        if !ss(&mut dst, &mut dst_len, b\"$argon2i$v=\") {\n            return ARGON2_ENCODING_FAIL;\n        }\n    } else {\n        return ARGON2_ENCODING_FAIL;\n    }\n\n    let validation_result = argon2_validate_inputs(ctx);\n    if validation_result != ARGON2_OK {\n        return validation_result;\n--- pwhash_argon2\n}\n\n/// `typedef enum Argon2_type { Argon2_i = 1, Argon2_id = 2 } argon2_type;`\n/// A plain `int` — see `argon2.rs` for why this must not be a Rust `enum`.\npub type argon2_type = c_int;\npub const Argon2_i: argon2_type = 1;\npub const Argon2_id: argon2_type = 2;\n\nconst ARGON2_OK: c_int = 0;\nconst ARGON2_VERIFY_MISMATCH: c_int = -35;\n\n--- final full build\n0","is_error":false}]},"parent_tool_use_id":"toolu_bdrk_01EXedd8HxZcfhXC2ZXwEF7s","session_id":"f6aed658-f045-47ac-a150-aec5e315d5dc","uuid":"e9ab5fe8-0d39-4aa9-8fe7-9c36bdae6288","timestamp":"2026-09-04T03:58:06.070Z","subagent_type":"general-purpose","task_description":"Verify pwhash argon2/scrypt"}
