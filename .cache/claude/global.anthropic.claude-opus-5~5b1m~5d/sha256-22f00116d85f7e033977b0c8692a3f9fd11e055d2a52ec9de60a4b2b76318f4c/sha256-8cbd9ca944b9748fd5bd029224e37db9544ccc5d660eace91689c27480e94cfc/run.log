stration.\nunsafe fn create_objects(\n    strings: *const *const c_char,\n    numbers: *const [c_int; 3],\n    ids: *const c_int,\n    fields: *const record,\n) {\n    /* declare a few. */\n    let mut root: *mut cJSON;\n    let fmt: *mut cJSON;\n    let img: *mut cJSON;\n    let thm: *mut cJSON;\n    let mut fld: *mut cJSON;\n    let mut i: c_int;\n\n    let zero: f64 = 0.0;\n\n    /* Here we construct some JSON standards, from the JSON site. */\n\n    /* Our \"Video\" datatype: */\n    root = cJSON_CreateObject();\n    cJSON_AddItemToObject(\n        root,\n        cs!(b\"name\\0\"),\n        cJSON_CreateString(cs!(b\"Jack (\\\"Bee\\\") Nimble\\0\")),\n    );\n    fmt = cJSON_CreateObject();\n    cJSON_AddItemToObject(root, cs!(b\"format\\0\"), fmt);\n    cJSON_AddStringToObject(fmt, cs!(b\"type\\0\"), cs!(b\"rect\\0\"));\n    cJSON_AddNumberToObject(fmt, cs!(b\"width\\0\"), 1920.0);\n    cJSON_AddNumberToObject(fmt, cs!(b\"height\\0\"), 1080.0);\n    cJSON_AddFalseToObject(fmt, cs!(b\"interlace\\0\"));\n    cJSON_AddNumberToObject(fmt, cs!(b\"frame rate\\0\"), 24.0);\n\n    /* Print to text */\n    if print_preallocated(root) != 0 {\n        cJSON_Delete(root);\n        exit(1); /* EXIT_FAILURE */\n    }\n    cJSON_Delete(root);\n\n    /* Our \"days of the week\" array: */\n    root = cJSON_CreateStringArray(strings, 7);\n\n    if print_preallocated(root) != 0 {\n        cJSON_Delete(root);\n        exit(1);\n    }\n    cJSON_Delete(root);\n\n    /* Our matrix: */\n    root = cJSON_CreateArray();\n    i = 0;\n    while i < 3 {\n        cJSON_AddItemToArray(\n            root,\n            cJSON_CreateIntArray((*numbers.wrapping_add(i as usize)).as_ptr(), 3),\n        );\n        i += 1;\n    }\n\n    /* cJSON_ReplaceItemInArray(root, 1, cJSON_CreateString(\"Replacement\")); */\n\n    if print_preallocated(root) != 0 {\n        cJSON_Delete(root);\n        exit(1);\n    }\n    cJSON_Delete(root);\n\n    /* Our \"gallery\" item: */\n    root = cJSON_CreateObject();\n    img = cJSON_CreateObject();\n    cJSON_AddItemToObject(root, cs!(b\"Image\\0\"), img);\n    cJSON_AddNumberToObject(img, cs!(b\"Width\\0\"), 800.0);\n    cJSON_AddNumberToObject(img, cs!(b\"Height\\0\"), 600.0);\n    cJSON_AddStringToObject(img, cs!(b\"Title\\0\"), cs!(b\"View from 15th Floor\\0\"));\n    thm = cJSON_CreateObject();\n    cJSON_AddItemToObject(img, cs!(b\"Thumbnail\\0\"), thm);\n    cJSON_AddStringToObject(\n        thm,\n        cs!(b\"Url\\0\"),\n        cs!(b\"http:/*www.example.com/image/481989943\\0\"),\n    );\n    cJSON_AddNumberToObject(thm, cs!(b\"Height\\0\"), 125.0);\n    cJSON_AddStringToObject(thm, cs!(b\"Width\\0\"), cs!(b\"100\\0\"));\n    cJSON_AddItemToObject(img, cs!(b\"IDs\\0\"), cJSON_CreateIntArray(ids, 4));\n\n    if print_preallocated(root) != 0 {\n        cJSON_Delete(root);\n        exit(1);\n    }\n    cJSON_Delete(root);\n\n    /* Our array of \"records\": */\n    root = cJSON_CreateArray();\n    i = 0;\n    while i < 2 {\n        fld = cJSON_CreateObject();\n        cJSON_AddItemToArray(root, fld);\n        let f = fields.wrapping_add(i as usize);\n        cJSON_AddStringToObject(fld, cs!(b\"precision\\0\"), (*f).precision);\n        cJSON_AddNumberToObject(fld, cs!(b\"Latitude\\0\"), (*f).lat);\n        cJSON_AddNumberToObject(fld, cs!(b\"Longitude\\0\"), (*f).lon);\n        cJSON_AddStringToObject(fld, cs!(b\"Address\\0\"), (*f).address);\n        cJSON_AddStringToObject(fld, cs!(b\"City\\0\"), (*f).city);\n        cJSON_AddStringToObject(fld, cs!(b\"State\\0\"), (*f).state);\n        cJSON_AddStringToObject(fld, cs!(b\"Zip\\0\"), (*f).zip);\n        cJSON_AddStringToObject(fld, cs!(b\"Country\\0\"), (*f).country);\n        i += 1;\n    }\n\n    /* cJSON_ReplaceItemInObject(cJSON_GetArrayItem(root, 1), \"City\", cJSON_CreateIntArray(ids, 4)); */\n\n    if print_preallocated(root) != 0 {\n        cJSON_Delete(root);\n        exit(1);\n    }\n    cJSON_Delete(root);\n\n    root = cJSON_CreateObject();\n    let zero_value = ptr::read_volatile(&zero as *const f64);\n    cJSON_AddNumberToObject(root, cs!(b\"number\\0\"), 1.0 / zero_value);\n\n    if print_preallocated(root) != 0 {\n        cJSON_Delete(root);\n        exit(1);\n    }\n    cJSON_Delete(root);\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn driver(\n    strings: *const *const c_char,\n    numbers: *const [c_int; 3],\n    ids: *const c_int,\n    fields: *const record,\n) -> c_int {\n    /* print the version */\n    printf(cs!(b\"Version: %s\\n\\0\"), cJSON_Version());\n\n    /* Now some samplecode for building objects concisely: */\n    create_objects(strings, numbers, ids, fields);\n\n    0\n}\n","numLines":242,"startLine":1,"totalLines":242}}}
