error(\\[|:)|^test |test result|panicked|-->' | head -40","description":"Add global state lock and rerun parse tests"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":475,"cache_read_input_tokens":281627,"cache_creation":{"ephemeral_5m_input_tokens":475,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"f12580f7-38a2-49ac-9a6e-10804310ebb6","uuid":"3ff2f653-ea3b-4cb9-8d0a-14ae566f5313","timestamp":"2026-08-27T06:16:15.814Z"}
