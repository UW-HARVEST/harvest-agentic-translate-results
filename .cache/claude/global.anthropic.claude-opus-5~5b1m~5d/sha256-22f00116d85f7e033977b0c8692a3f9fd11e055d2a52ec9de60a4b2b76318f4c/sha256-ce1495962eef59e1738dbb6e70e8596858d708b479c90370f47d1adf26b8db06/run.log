nalHooks::zeroed(),\n513\t        }\n514\t    }\n515\t}\n516\t\n517\t/// realloc printbuffer if necessary to have at least \"needed\" bytes more\n518\tunsafe fn ensure(p: *mut PrintBuffer, needed: usize) -> *mut u8 {\n519\t    let newbuffer: *mut u8;\n520\t    let newsize: usize;\n521\t    let mut needed = needed;\n522\t\n523\t    if p.is_null() || (*p).buffer.is_null() {\n524\t        return ptr::null_mut();\n525\t    }\n526\t\n527\t    if ((*p).length > 0) && ((*p).offset >= (*p).length) {\n528\t        /* make sure that offset is valid */\n529\t        return ptr::null_mut();\n530\t    }\n531\t\n532\t    if needed > INT_MAX as usize {\n533\t        /* sizes bigger than INT_MAX are currently not supported */\n534\t        return ptr::null_mut();\n535\t    }\n536\t\n537\t    needed = needed.wrapping_add((*p).offset).wrapping_add(1);\n538\t    if needed <= (*p).length {\n539\t        return (*p).buffer.wrapping_add((*p).offset);\n540\t    }\n541\t\n542\t    if (*p).noalloc != 0 {\n543\t        return ptr::null_mut();\n544\t    }\n545\t\n546\t    /* calculate new buffer size */\n547\t    if needed > (INT_MAX as usize / 2) {\n548\t        /* overflow of int, use INT_MAX if possible */\n549\t        if needed <= INT_MAX as usize {\n550\t            newsize = INT_MAX as usize;\n551\t        } else {\n552\t            return ptr::null_mut();\n553\t        }\n554\t    } else {\n555\t        newsize = needed * 2;\n556\t    }\n557\t\n558\t    if (*p).hooks.reallocate.is_some() {\n559\t        /* reallocate with realloc if available */\n560\t        newbuffer =\n561\t            ((*p).hooks.reallocate.unwrap())((*p).buffer as *mut c_void, newsize) as *mut u8;\n562\t        if newbuffer.is_null() {\n563\t            (*p).hooks.dealloc((*p).buffer as *mut c_void);\n564\t            (*p).length = 0;\n565\t            (*p).buffer = ptr::null_mut();\n566\t\n567\t            return ptr::null_mut();\n568\t        }\n569\t    } else {\n570\t        /* otherwise reallocate manually */\n571\t        newbuffer = (*p).hooks.alloc(newsize) as *mut u8;\n572\t        if newbuffer.is_null() {\n573\t            (*p).hooks.dealloc((*p).buffer as *mut c_void);\n574\t            (*p).length = 0;\n575\t            (*p).buffer = ptr::null_mut();\n576\t\n577\t            return ptr::null_mut();\n578\t        }\n579\t\n580\t        memcpy(\n581\t            newbuffer as *mut c_void,\n582\t            (*p).buffer as *const c_void,\n583\t            (*p).offset + 1,\n584\t        );\n585\t        (*p).hooks.dealloc((*p).buffer as *mut c_void);\n586\t    }\n587\t    (*p).length = newsize;\n588\t    (*p).buffer = newbuffer;\n589\t\n590\t    newbuffer.wrapping_add((*p).offset)\n591\t}\n592\t\n593\t/// calculate the new length of the string in a printbuffer and update the offset\n594\tunsafe fn update_offset(buffer: *mut PrintBuffer) {\n595\t    let buffer_pointer: *const u8;\n596\t    if buffer.is_null() || (*buffer).buffer.is_null() {\n597\t        return;\n598\t    }\n599\t    buffer_pointer = (*buffer).buffer.wrapping_add((*buffer).offset);\n600\t\n601\t    (*buffer).offset += strlen(buffer_pointer as *const c_char);\n602\t}\n603\t\n604\t/// securely comparison of floating-point variables\n605\tfn compare_double(a: f64, b: f64) -> cJSON_bool {\n606\t    let max_val = if a.abs() > b.abs() { a.abs() } else { b.abs() };\n607\t    if (a - b).abs() <= max_val * f64::EPSILON {\n608\t        TRUE\n609\t    } else {\n610\t        FALSE\n611\t    }\n612\t}\n613\t\n614\t/// Render the number nicely from the given item into a string.\n615\tunsafe fn print_number(item: *const cJSON, output_buffer: *mut PrintBuffer) -> cJSON_bool {\n616\t    let output_pointer: *mut u8;\n617\t    let d = (*item).valuedouble;\n618\t    let mut length: c_int;\n619\t    let mut i: usize = 0;\n620\t    let mut number_buffer: [u8; 26] = [0; 26]; /* temporary buffer to print the number into */\n621\t    let decimal_point = get_decimal_point();\n622\t    let mut test: f64 = 0.0;\n623\t\n624\t    if output_buffer.is_null() {\n625\t        return FALSE;\n626\t    }\n627\t\n628\t    let nb = number_buffer.as_mut_ptr() as *mut c_char;\n629\t\n630\t    /* This checks for NaN and Infinity */\n631\t    if d.is_nan() || d.is_infinite() {\n632\t        length = sprintf(nb, cs!(b\"null\\0\"));\n633\t    } else if d == (*item).valueint as f64 {\n634\t        length = sprintf(nb, cs!(b\"%d\\0\"), (*item).valueint);\n635\t    } else {\n636\t        /* Try 15 decimal places of precision to avoid nonsignificant nonzero digits */\n637\t        length = sprintf(nb, cs!(b\"%1.15g\\0\"), d);\n638\t\n639\t        /* Check whether the original double can be recovered */\n640\t        if sscanf(nb as *const c_char, cs!(b\"%lg\\0\"), &mut test as *mut f64) != 1\n641\t            || compare_double(test, d) == 0\n642\t        {\n643\t            /* If not, print with 17 decimal places of precision */\n644\t            length = sprintf(nb, cs!(b\"%1.17g\\0\"), d);\n645\t        }\n646\t    }\n647\t\n648\t    /* sprintf failed or buffer overrun occurred */\n649\t    if (length < 0) || (length > (core::mem::size_of::<[u8; 26]>() - 1) as c_int) {\n650\t        return FALSE;\n651\t    }\n652\t\n653\t    /* reserve appropriate space in the output */\n654\t    output_pointer = ensure(output_buffer, length as usize + 1);\n655\t    if output_pointer.is_null() {\n656\t        return FALSE;\n657\t    }\n658\t\n659\t    /* copy the printed number to the output and replace locale\n660\t     * dependent decimal point with '.' */\n661\t    while i < length as usize {\n662\t        if number_buffer[i] == decimal_point {\n663\t            *output_pointer.wrapping_add(i) = b'.';\n664\t            i += 1;\n665\t            continue;\n666\t        }\n667\t\n668\t        *output_pointer.wrapping_add(i) = number_buffer[i];\n669\t        i += 1;\n670\t    }\n671\t    *output_pointer.wrapping_add(i) = b'\\0';\n672\t\n673\t    (*output_buffer).offset += length as usize;\n674\t\n675\t    TRUE\n676\t}\n677\t\n678\t/// parse 4 digit hexadecimal number\n679\tunsafe fn parse_hex4(input: *const u8) -> u32 {\n680\t    let mut h: u32 = 0;\n681\t    let mut i: usize = 0;\n682\t\n683\t    while i < 4 {\n684\t        let c = *input.wrapping_add(i);\n685\t        /* parse digit */\n686\t        if c >= b'0' && c <= b'9' {\n687\t            h = h.wrapping_add((c as u32).wrapping_sub(b'0' as u32));\n688\t        } else if c >= b'A' && c <= b'F' {\n689\t            h = h.wrapping_add((10u32.wrapping_add(c as u32)).wrapping_sub(b'A' as u32));\n690\t        } else if c >= b'a' && c <= b'f' {\n691\t            h = h.wrapping_add((10u32.wrapping_add(c as u32)).wrapping_sub(b'a' as u32));\n692\t        } else {\n693\t            /* invalid */\n694\t            return 0;\n695\t        }\n696\t\n697\t        if i < 3 {\n698\t            /* shift left to make place for the next nibble */\n699\t            h <<= 4;\n700\t        }\n701\t        i += 1;\n702\t    }\n703\t\n704\t    h\n705\t}\n706\t\n707\t/// converts a UTF-16 literal to UTF-8\n708\t/// A literal can be one or two sequences of the form \\uXXXX\n709\t#[allow(unused_assignments)]\n710\tunsafe fn utf16_literal_to_utf8(\n711\t    input_pointer: *const u8,\n712\t    input_end: *const u8,\n713\t    output_pointer: *mut *mut u8,\n714\t) -> u8 {\n715\t    let mut codepoint: u64 = 0;\n716\t    let first_code: u32;\n717\t    let first_sequence: *const u8 = input_pointer;\n718\t    let utf8_length: u8;\n719\t    let mut utf8_position: u8;\n720\t    let sequence_length: u8;\n721\t    let mut first_byte_mark: u8 = 0;\n722\t\n723\t    if (input_end as isize - first_sequence as isize) < 6 {\n724\t        /* input ends unexpectedly */\n725\t        return 0;\n726\t    }\n727\t\n728\t    /* get the first utf16 sequence */\n729\t    first_code = parse_hex4(first_sequence.wrapping_add(2));\n730\t\n731\t    /* check that the code is valid */\n732\t    if first_code >= 0xDC00 && first_code <= 0xDFFF {\n733\t        return 0;\n734\t    }\n735\t\n736\t    /* UTF16 surrogate pair */\n737\t    if first_code >= 0xD800 && first_code <= 0xDBFF {\n738\t        let second_sequence: *const u8 = first_sequence.wrapping_add(6);\n739\t        let second_code: u32;\n740\t        sequence_length = 12; /* \\uXXXX\\uXXXX */\n741\t\n742\t        if (input_end as isize - second_sequence as isize) < 6 {\n743\t            /* input ends unexpectedly */\n744\t            return 0;\n745\t        }\n746\t\n747\t        if *second_sequence != b'\\\\' || *second_sequence.wrapping_add(1) != b'u' {\n748\t            /* missing second half of the surrogate pair */\n749\t            return 0;\n750\t        }\n751\t\n752\t        /* get the second utf16 sequence */\n753\t        second_code = parse_hex4(second_sequence.wrapping_add(2));\n754\t        /* check that the code is valid */\n755\t        if second_code < 0xDC00 || second_code > 0xDFFF {\n756\t            /* invalid second half of the surrogate pair */\n757\t            return 0;\n758\t        }\n759\t\n760\t        /* calculate the unicode codepoint from the surrogate pair */\n761\t        codepoint =\n762\t            0x10000u64 + ((((first_code & 0x3FF) << 10) | (second_code & 0x3FF)) as u64);\n763\t    } else {\n764\t        sequence_length = 6; /* \\uXXXX */\n765\t        codepoint = first_code as u64;\n766\t    }\n767\t\n768\t    /* encode as UTF-8\n769\t     * takes at maximum 4 bytes to encode:\n770\t     * 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx */\n771\t    if codepoint < 0x80 {\n772\t        /* normal ascii, encoding 0xxxxxxx */\n773\t        utf8_length = 1;\n774\t    } else if codepoint < 0x800 {\n775\t        /* two bytes, encoding 110xxxxx 10xxxxxx */\n776\t        utf8_length = 2;\n777\t        first_byte_mark = 0xC0; /* 11000000 */\n778\t    } else if codepoint < 0x10000 {\n779\t        /* three bytes, encoding 1110xxxx 10xxxxxx 10xxxxxx */\n780\t        utf8_length = 3;\n781\t        first_byte_mark = 0xE0; /* 11100000 */\n782\t    } else if codepoint <= 0x10FFFF {\