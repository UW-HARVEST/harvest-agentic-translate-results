{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_qtp6w2bp4k6gncom74xmgjrtwbpzuwpufiepsrg6d7jdmdsp7zkq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01CrQfEmN7ceWhJuTfW4F1ng","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-KcJ46a/translation/tests/smoke.rs","content":"//! Sanity checks for the harness itself plus the `driver` end-to-end entry\n//! point from `c_src/test.c`.\n#![allow(non_snake_case)]\n\nmod harness;\n\nuse harness::*;\nuse std::ffi::{c_char, c_int};\n\n#[test]\nfn harness_loads_both_libraries() {\n    let (c, r) = both();\n    unsafe {\n        let cv = cstr((c.cJSON_Version)());\n        let rv = cstr((r.cJSON_Version)());\n        assert_eq!(cv, rv, \"cJSON_Version mismatch\");\n        assert_eq!(cv, Some(b\"1.7.19\".to_vec()));\n    }\n}\n\n#[test]\nfn struct_layout_matches_c() {\n    // 3 pointers + int(+pad) + pointer + int(+pad) + double + pointer\n    assert_eq!(std::mem::size_of::<CJson>(), 64);\n    assert_eq!(std::mem::align_of::<CJson>(), 8);\n}\n\n/// Runs the full `driver()` entry point from `test.c` on both libraries and\n/// requires byte-identical stdout.\nfn run_driver_case(\n    strings: &[&str; 7],\n    numbers: [[c_int; 3]; 3],\n    ids: [c_int; 4],\n    fields_raw: [(&str, f64, f64, &str, &str, &str, &str, &str); 2],\n) {\n    let (c, r) = both();\n\n    let owned: Vec<std::ffi::CString> = strings.iter().map(|s| cs(s)).collect();\n    let string_ptrs: Vec<*const c_char> = owned.iter().map(|s| s.as_ptr()).collect();\n\n    let mut keep: Vec<std::ffi::CString> = Vec::new();\n    let mut records: Vec<Record> = Vec::new();\n    for f in fields_raw.iter() {\n        let p = cs(f.0);\n        let a = cs(f.3);\n        let ci = cs(f.4);\n        let st = cs(f.5);\n        let z = cs(f.6);\n        let co = cs(f.7);\n        records.push(Record {\n            precision: p.as_ptr(),\n            lat: f.1,\n            lon: f.2,\n            address: a.as_ptr(),\n            city: ci.as_ptr(),\n            state: st.as_ptr(),\n            zip: z.as_ptr(),\n            country: co.as_ptr(),\n        });\n        keep.extend([p, a, ci, st, z, co]);\n    }\n\n    unsafe {\n        let out_c = capture_stdout(|| {\n            (c.driver)(\n                string_ptrs.as_ptr(),\n                numbers.as_ptr(),\n                ids.as_ptr(),\n                records.as_ptr(),\n            );\n        });\n        let out_r = capture_stdout(|| {\n            (r.driver)(\n                string_ptrs.as_ptr(),\n                numbers.as_ptr(),\n                ids.as_ptr(),\n                records.as_ptr(),\n            );\n        });\n        assert!(!out_c.is_empty(), \"C driver produced no output\");\n        if out_c != out_r {\n            panic!(\n                \"driver() stdout differs\\n--- C ---\\n{}\\n--- Rust ---\\n{}\",\n                String::from_utf8_lossy(&out_c),\n                String::from_utf8_lossy(&out_r)\n            );\n        }\n    }\n    drop(keep);\n    drop(owned);\n}\n\n#[test]\nfn driver_matches_upstream_example() {\n    run_driver_case(\n        &[\n            \"Sunday\",\n            \"Monday\",\n            \"Tuesday\",\n            \"Wednesday\",\n            \"Thursday\",\n            \"Friday\",\n            \"Saturday\",\n        ],\n        [[0, -1, 0], [1, 0, 0], [0, 0, 1]],\n        [116, 943, 234, 38793],\n        [\n            (\n                \"zip\",\n                37.7668,\n                -122.3959,\n                \"\",\n                \"SAN FRANCISCO\",\n                \"CA\",\n                \"94107\",\n                \"US\",\n            ),\n            (\n                \"zip\",\n                37.371991,\n                -122.026020,\n                \"\",\n                \"SUNNYVALE\",\n                \"CA\",\n                \"94085\",\n                \"US\",\n            ),\n        ],\n    );\n}\n\n#[test]\nfn driver_matches_randomized_inputs() {\n    let mut rng = Rng::new(0xD1CE_F00D);\n    for iter in 0..40 {\n        // Strings with escapes, control characters, UTF-8 and empties.\n        let pool = [\n            \"\",\n            \"a\",\n            \"tab\\there\",\n            \"nl\\nhere\",\n            \"quote\\\"here\",\n            \"back\\\\slash\",\n            \"\\u{1}\\u{2}\\u{1f}\",\n            \"ünïcøde \\u{1F600}\",\n            \"0123456789012345678901234567890123456789\",\n            \"/slash/\",\n            \"\\u{8}\\u{c}\\r\",\n        ];\n        let pick = |rng: &mut Rng| pool[rng.below(pool.len())];\n        let s: [&str; 7] = [\n            pick(&mut rng),\n            pick(&mut rng),\n            pick(&mut rng),\n            pick(&mut rng),\n            pick(&mut rng),\n            pick(&mut rng),\n            pick(&mut rng),\n        ];\n        let mut numbers = [[0i32; 3]; 3];\n        for row in numbers.iter_mut() {\n            for v in row.iter_mut() {\n                *v = rng.range_i32(i32::MIN, i32::MAX);\n            }\n        }\n        let ids = [\n            rng.range_i32(i32::MIN, i32::MAX),\n            rng.range_i32(-10, 10),\n            0,\n            i32::MIN,\n        ];\n        let f0 = (\n            pick(&mut rng),\n            rng.json_f64(),\n            rng.json_f64(),\n            pick(&mut rng),\n            pick(&mut rng),\n            pick(&mut rng),\n            pick(&mut rng),\n            pick(&mut rng),\n        );\n        let f1 = (\n            pick(&mut rng),\n            rng.json_f64(),\n            rng.json_f64(),\n            pick(&mut rng),\n            pick(&mut rng),\n            pick(&mut rng),\n            pick(&mut rng),\n            pick(&mut rng),\n        );\n        eprintln!(\"driver iteration {iter}\");\n        run_driver_case(&s, numbers, ids, [f0, f1]);\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":9145,"cache_read_input