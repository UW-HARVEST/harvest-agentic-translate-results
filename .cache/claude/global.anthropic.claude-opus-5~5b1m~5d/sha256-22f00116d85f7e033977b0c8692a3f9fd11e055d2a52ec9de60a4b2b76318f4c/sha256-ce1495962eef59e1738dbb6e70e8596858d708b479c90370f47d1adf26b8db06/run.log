_buffer->depth--;\n1614\t\n1615\t    return true;\n1616\t}\n1617\t\n1618\t/* Build an object from the text. */\n1619\tstatic cJSON_bool parse_object(cJSON * const item, parse_buffer * const input_buffer)\n1620\t{\n1621\t    cJSON *head = NULL; /* linked list head */\n1622\t    cJSON *current_item = NULL;\n1623\t\n1624\t    if (input_buffer->depth >= CJSON_NESTING_LIMIT)\n1625\t    {\n1626\t        return false; /* to deeply nested */\n1627\t    }\n1628\t    input_buffer->depth++;\n1629\t\n1630\t    if (cannot_access_at_index(input_buffer, 0) || (buffer_at_offset(input_buffer)[0] != '{'))\n1631\t    {\n1632\t        goto fail; /* not an object */\n1633\t    }\n1634\t\n1635\t    input_buffer->offset++;\n1636\t    buffer_skip_whitespace(input_buffer);\n1637\t    if (can_access_at_index(input_buffer, 0) && (buffer_at_offset(input_buffer)[0] == '}'))\n1638\t    {\n1639\t        goto success; /* empty object */\n1640\t    }\n1641\t\n1642\t    /* check if we skipped to the end of the buffer */\n1643\t    if (cannot_access_at_index(input_buffer, 0))\n1644\t    {\n1645\t        input_buffer->offset--;\n1646\t        goto fail;\n1647\t    }\n1648\t\n1649\t    /* step back to character in front of the first element */\n1650\t    input_buffer->offset--;\n1651\t    /* loop through the comma separated array elements */\n1652\t    do\n1653\t    {\n1654\t        /* allocate next item */\n1655\t        cJSON *new_item = cJSON_New_Item(&(input_buffer->hooks));\n1656\t        if (new_item == NULL)\n1657\t        {\n1658\t            goto fail; /* allocation failure */\n1659\t        }\n1660\t\n1661\t        /* attach next item to list */\n1662\t        if (head == NULL)\n1663\t        {\n1664\t            /* start the linked list */\n1665\t            current_item = head = new_item;\n1666\t        }\n1667\t        else\n1668\t        {\n1669\t            /* add to the end and advance */\n1670\t            current_item->next = new_item;\n1671\t            new_item->prev = current_item;\n1672\t            current_item = new_item;\n1673\t        }\n1674\t\n1675\t        if (cannot_access_at_index(input_buffer, 1))\n1676\t        {\n1677\t            goto fail; /* nothing comes after the comma */\n1678\t        }\n1679\t\n1680\t        /* parse the name of the child */\n1681\t        input_buffer->offset++;\n1682\t        buffer_skip_whitespace(input_buffer);\n1683\t        if (!parse_string(current_item, input_buffer))\n1684\t        {\n1685\t            goto fail; /* failed to parse name */\n1686\t        }\n1687\t        buffer_skip_whitespace(input_buffer);\n1688\t\n1689\t        /* swap valuestring and string, because we parsed the name */\n1690\t        current_item->string = current_item->valuestring;\n1691\t        current_item->valuestring = NULL;\n1692\t\n1693\t        if (cannot_access_at_index(input_buffer, 0) || (buffer_at_offset(input_buffer)[0] != ':'))\n1694\t        {\n1695\t            goto fail; /* invalid object */\n1696\t        }\n1697\t\n1698\t        /* parse the value */\n1699\t        input_buffer->offset++;\n1700\t        buffer_skip_whitespace(input_buffer);\n1701\t        if (!parse_value(current_item, input_buffer))\n1702\t        {\n1703\t            goto fail; /* failed to parse value */\n1704\t        }\n1705\t        buffer_skip_whitespace(input_buffer);\n1706\t    }\n1707\t    while (can_access_at_index(input_buffer, 0) && (buffer_at_offset(input_buffer)[0] == ','));\n1708\t\n1709\t    if (cannot_access_at_index(input_buffer, 0) || (buffer_at_offset(input_buffer)[0] != '}'))\n1710\t    {\n1711\t        goto fail; /* expected end of object */\n1712\t    }\n1713\t\n1714\tsuccess:\n1715\t    input_buffer->depth--;\n1716\t\n1717\t    if (head != NULL) {\n1718\t        head->prev = current_item;\n1719\t    }\n1720\t\n1721\t    item->type = cJSON_Object;\n1722\t    item->child = head;\n1723\t\n1724\t    input_buffer->offset++;\n1725\t    return true;\n1726\t\n1727\tfail:\n1728\t    if (head != NULL)\n1729\t    {\n1730\t 