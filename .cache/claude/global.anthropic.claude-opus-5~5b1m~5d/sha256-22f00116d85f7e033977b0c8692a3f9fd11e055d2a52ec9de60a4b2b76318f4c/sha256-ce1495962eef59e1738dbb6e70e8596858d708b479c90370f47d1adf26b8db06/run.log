\t        (*g).reallocate = Some(realloc);\n249\t    }\n250\t}\n251\t\n252\t/// Internal constructor.\n253\tunsafe fn cJSON_New_Item(hooks: *const InternalHooks) -> *mut cJSON {\n254\t    let node = (*hooks).alloc(core::mem::size_of::<cJSON>()) as *mut cJSON;\n255\t    if !node.is_null() {\n256\t        ptr::write_bytes(node as *mut u8, 0u8, core::mem::size_of::<cJSON>());\n257\t    }\n258\t\n259\t    node\n260\t}\n261\t\n262\t#[unsafe(no_mangle)]\n263\tpub unsafe extern \"C\" fn cJSON_Delete(item: *mut cJSON) {\n264\t    let mut item = item;\n265\t    let mut next: *mut cJSON;\n266\t    while !item.is_null() {\n267\t        next = (*item).next;\n268\t        if ((*item).type_ & cJSON_IsReference) == 0 && !(*item).child.is_null() {\n269\t            cJSON_Delete((*item).child);\n270\t        }\n271\t        if ((*item).type_ & cJSON_IsReference) == 0 && !(*item).valuestring.is_null() {\n272\t            global_hooks().dealloc((*item).valuestring as *mut c_void);\n273\t            (*item).valuestring = ptr::null_mut();\n274\t        }\n275\t        if ((*item).type_ & cJSON_StringIsConst) == 0 && !(*item).string.is_null() {\n276\t            global_hooks().dealloc((*item).string as *mut c_void);\n277\t            (*item).string = ptr::null_mut();\n278\t        }\n279\t        global_hooks().dealloc(item as *mut c_void);\n280\t        item = next;\n281\t    }\n282\t}\n283\t\n284\t/// get the decimal point character of the current locale\n285\tunsafe fn get_decimal_point() -> u8 {\n286\t    let lc = localeconv();\n287\t    *(*lc).decimal_point as u8\n288\t}\n289\t\n290\t// ---------------------------------------------------------------------------\n291\t// parse buffer\n292\t// ---------------------------------------------------------------------------\n293\t\n294\tstruct ParseBuffer {\n295\t    content: *const u8,\n296\t    length: usize,\n297\t    offset: usize,\n298\t    depth: usize,\n299\t    hooks: InternalHooks,\n300\t}\n301\t\n302\timpl ParseBuffer {\n303\t    