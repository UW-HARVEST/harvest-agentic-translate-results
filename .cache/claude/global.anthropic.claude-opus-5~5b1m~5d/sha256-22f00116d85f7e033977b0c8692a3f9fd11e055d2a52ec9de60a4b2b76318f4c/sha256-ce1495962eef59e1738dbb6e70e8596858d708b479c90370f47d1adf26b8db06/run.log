_strdup((const unsigned char*)string, hooks);\n2052\t        if (new_key == NULL)\n2053\t        {\n2054\t            return false;\n2055\t        }\n2056\t\n2057\t        new_type = item->type & ~cJSON_StringIsConst;\n2058\t    }\n2059\t\n2060\t    if (!(item->type & cJSON_StringIsConst) && (item->string != NULL))\n2061\t    {\n2062\t        hooks->deallocate(item->string);\n2063\t    }\n2064\t\n2065\t    item->string = new_key;\n2066\t    item->type = new_type;\n2067\t\n2068\t    return add_item_to_array(object, item);\n2069\t}\n2070\t\n2071\tCJSON_PUBLIC(cJSON_bool) cJSON_AddItemToObject(cJSON *object, const char *string, cJSON *item)\n2072\t{\n2073\t    return add_item_to_object(object, string, item, &global_hooks, false);\n2074\t}\n2075\t\n2076\t/* Add an item to an object with constant string as key */\n2077\tCJSON_PUBLIC(cJSON_bool) cJSON_AddItemToObjectCS(cJSON *object, const char *string, cJSON *item)\n2078\t{\n2079\t    return add_item_to_object(object, string, item, &global_hooks, true);\n2080\t}\n2081\t\n2082\tCJSON_PUBLIC(cJSON_bool) cJSON_AddItemReferenceToArray(cJSON *array, cJSON *item)\n2083\t{\n2084\t    if (array == NULL)\n2085\t    {\n2086\t        return false;\n2087\t    }\n2088\t\n2089\t    return add_item_to_array(array, create_reference(item, &global_hooks));\n2090\t}\n2091\t\n2092\tCJSON_PUBLIC(cJSON_bool) cJSON_AddItemReferenceToObject(cJSON *object, const char *string, cJSON *item)\n2093\t{\n2094\t    if ((object == NULL) || (string == NULL))\n2095\t    {\n2096\t        return false;\n2097\t    }\n2098\t\n2099\t    return add_item_to_object(object, string, create_reference(item, &global_hooks), &global_hooks, false);\n2100\t}\n2101\t\n2102\tCJSON_PUBLIC(cJSON*) cJSON_AddNullToObject(cJSON * const object, const char * const name)\n2103\t{\n2104\t    cJSON *null = cJSON_CreateNull();\n2105\t    if (add_item_to_object(object, name, null, &global_hooks, false))\n2106\t    {\n2107\t        return null;\n2108\t    }\n2109\t\n2110\t    cJSON_Delete(null);\n2111\t    return NULL;\n2112\t}\n2113\t\n2114\tCJSON_PUBLIC(cJSON*) cJSON_AddTrueToObject(cJSON * const object, const char * const name)\n2115\t{\n2116\t    cJSON *true_item = cJSON_CreateTrue();\n2117\t    if (add_item_to_object(object, name, true_item, &global_hooks, false))\n2118\t    {\n2119\t        return true_item;\n2120\t    }\n2121\t\n2122\t    cJSON_Delete(true_item);\n2123\t    return NULL;\n2124\t}\n2125\t\n2126\tCJSON_PUBLIC(cJSON*) cJSON_AddFalseToObject(cJSON * const object, const char * const name)\n2127\t{\n2128\t    cJSON *false_item = cJSON_CreateFalse();\n2129\t    if (add_item_to_object(object, name, false_item, &global_hooks, false))\n2130\t    {\n2131\t        return false_item;\n2132\t    }\n2133\t\n2134\t    cJSON_Delete(false_item);\n2135\t    return NULL;\n2136\t}\n2137\t\n2138\tCJSON_PUBLIC(cJSON*) cJSON_AddBoolToObject(cJSON * const object, const char * const name, const cJSON_bool boolean)\n2139\t{\n2140\t    cJSON *bool_item = cJSON_CreateBool(boolean);\n2141\t    if (add_item_to_object(object, name, bool_item, &global_hooks, false))\n2142\t    {\n2143\t        return bool_item;\n2144\t    }\n2145\t\n2146\t    cJSON_Delete(bool_item);\n2147\t    return NULL;\n2148\t}\n2149\t\n2150\tCJSON_PUBLIC(cJSON*) cJSON_AddNumberToObject(cJSON * const object, const char * const name, const double number)\n2151\t{\n2152\t    cJSON *number_item = cJSON_CreateNumber(number);\n2153\t    if (add_item_to_object(object, name, number_item, &global_hooks, false))\n2154\t    {\n2155\t        return number_item;\n2156\t    }\n2157\t\n2158\t    cJSON_Delete(number_item);\n2159\t    return NULL;\n2160\t}\n2161\t\n2162\tCJSON_PUBLIC(cJSON*) cJSON_AddStringToObject(cJSON * const object, const char * const name, const char * const string)\n2163\t{\n2164\t    cJSON *string_item = cJSON_CreateString(string);\n2165\t    if (add_item_to_object(object, name, string_item, &global_hooks, false))\n2166\t    {\n2167\t        return string_item;\n2168\t    }\n2