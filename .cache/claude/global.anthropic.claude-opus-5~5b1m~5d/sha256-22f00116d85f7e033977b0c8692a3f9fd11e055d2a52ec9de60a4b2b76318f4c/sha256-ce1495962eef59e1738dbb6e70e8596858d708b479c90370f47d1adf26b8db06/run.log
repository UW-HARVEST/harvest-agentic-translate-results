 [X1, X2] [Y1, Y2] => X2 < Y1 or Y2 < X1 */\n419\t        if (!( valuestring + v1_len < object->valuestring || object->valuestring + v2_len < valuestring ))\n420\t        {\n421\t            return NULL;\n422\t        }\n423\t        strcpy(object->valuestring, valuestring);\n424\t        return object->valuestring;\n425\t    }\n426\t    copy = (char*) cJSON_strdup((const unsigned char*)valuestring, &global_hooks);\n427\t    if (copy == NULL)\n428\t    {\n429\t        return NULL;\n430\t    }\n431\t    if (object->valuestring != NULL)\n432\t    {\n433\t        cJSON_free(object->valuestring);\n434\t    }\n435\t    object->valuestring = copy;\n436\t\n437\t    return copy;\n438\t}\n439\t\n440\ttypedef struct\n441\t{\n442\t    unsigned char *buffer;\n443\t    size_t length;\n444\t    size_t offset;\n445\t    size_t depth; /* current nesting depth (for formatted printing) */\n446\t    cJSON_bool noalloc;\n447\t    cJSON_bool format; /* is this print a formatted print */\n448\t    internal_hooks hooks;\n449\t} printbuffer;\n450\t\n451\t/* realloc printbuffer if necessary to have at least \"needed\" bytes more */\n452\tstatic unsigned char* ensure(printbuffer * const p, size_t needed)\n453\t{\n454\t    unsigned char *newbuffer = NULL;\n455\t    size_t newsize = 0;\n456\t\n457\t    if ((p == NULL) || (p->buffer == NULL))\n458\t    {\n459\t        return NULL;\n460\t    }\n461\t\n462\t    if ((p->length > 0) && (p->offset >= p->length))\n463\t    {\n464\t        /* make sure that offset is valid */\n465\t        return NULL;\n466\t    }\n467\t\n468\t    if (needed > INT_MAX)\n469\t    {\n470\t        /* sizes bigger than INT_MAX are currently not supported */\n471\t        return NULL;\n472\t    }\n473\t\n474\t    needed += p->offset + 1;\n475\t    if (needed <= p->length)\n476\t    {\n477\t        return p->buffer + p->offset;\n478\t    }\n479\t\n480\t    if (p->noalloc) {\n481\t        return NULL;\n482\t    }\n483\t\n484\t    /* calculate new buffer size */\n485\t    if 