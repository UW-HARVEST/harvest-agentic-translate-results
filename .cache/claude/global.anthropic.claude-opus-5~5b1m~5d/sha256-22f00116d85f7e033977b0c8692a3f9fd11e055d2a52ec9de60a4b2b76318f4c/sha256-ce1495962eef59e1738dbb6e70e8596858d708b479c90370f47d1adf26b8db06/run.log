1487\t        input_buffer->offset--;\n1488\t        goto fail;\n1489\t    }\n1490\t\n1491\t    /* step back to character in front of the first element */\n1492\t    input_buffer->offset--;\n1493\t    /* loop through the comma separated array elements */\n1494\t    do\n1495\t    {\n1496\t        /* allocate next item */\n1497\t        cJSON *new_item = cJSON_New_Item(&(input_buffer->hooks));\n1498\t        if (new_item == NULL)\n1499\t        {\n1500\t            goto fail; /* allocation failure */\n1501\t        }\n1502\t\n1503\t        /* attach next item to list */\n1504\t        if (head == NULL)\n1505\t        {\n1506\t            /* start the linked list */\n1507\t            current_item = head = new_item;\n1508\t        }\n1509\t        else\n1510\t        {\n1511\t            /* add to the end and advance */\n1512\t            current_item->next = new_item;\n1513\t            new_item->prev = current_item;\n1514\t            current_item = new_item;\n1515\t        }\n1516\t\n1517\t        /* parse next value */\n1518\t        input_buffer->offset++;\n1519\t        buffer_skip_whitespace(input_buffer);\n1520\t        if (!parse_value(current_item, input_buffer))\n1521\t        {\n1522\t            goto fail; /* failed to parse value */\n1523\t        }\n1524\t        buffer_skip_whitespace(input_buffer);\n1525\t    }\n1526\t    while (can_access_at_index(input_buffer, 0) && (buffer_at_offset(input_buffer)[0] == ','));\n1527\t\n1528\t    if (cannot_access_at_index(input_buffer, 0) || buffer_at_offset(input_buffer)[0] != ']')\n1529\t    {\n1530\t        goto fail; /* expected end of array */\n1531\t    }\n1532\t\n1533\tsuccess:\n1534\t    input_buffer->depth--;\n1535\t\n1536\t    if (head != NULL) {\n1537\t        head->prev = current_item;\n1538\t    }\n1539\t\n1540\t    item->type = cJSON_Array;\n1541\t    item->child = head;\n1542\t\n1543\t    input_buffer->offset++;\n1544\t\n1545\t    return true;\n1546\t\n1547\tfail:\n1548\t    if (head != NULL)\n1549\t  