   (self.allocate.unwrap())(size)\n    }\n\n    #[inline]\n    unsafe fn dealloc(&self, pointer: *mut c_void) {\n        (self.deallocate.unwrap())(pointer)\n    }\n}\n\nstatic mut GLOBAL_HOOKS: InternalHooks = InternalHooks {\n    allocate: Some(malloc),\n    deallocate: Some(free),\n    reallocate: Some(realloc),\n};\n\n#[inline]\nfn global_hooks_ptr() -> *mut InternalHooks {\n    &raw mut GLOBAL_HOOKS\n}\n\n#[inline]\nunsafe fn global_hooks() -> InternalHooks {\n    *global_hooks_ptr()\n}\n\nmacro_rules! cs {\n    ($s:expr) => {\n        $s.as_ptr() as *const c_char\n    };\n}\n\n// ---------------------------------------------------------------------------\n// error pointer / trivial accessors\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn cJSON_GetErrorPtr() -> *const c_char {\n    let e = *(&raw const GLOBAL_ERROR);\n    e.json.wrapping_add(e.position) as *const c_char\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn cJSON_GetStringValue(item: *const cJSON) -> *mut c_char {\n    if cJSON_IsString(item) == 0 {\n        return ptr::null_mut();\n    }\n\n    (*item).valuestring\n}\n\n/// The value of cJSON.c's `NAN` macro.\n///\n/// `cJSON.c` is compiled as C89 (`-std=c89` in `CMakeLists.txt`), so glibc's\n/// `<math.h>` leaves `NAN` undefined (it is guarded by `__USE_ISOC99`) and the\n/// library's own fallback `#define NAN 0.0/0.0` takes effect.  The compiler\n/// constant-folds `0.0/0.0` the way the hardware computes it, which on IEEE-754\n/// targets yields the *negative* default quiet NaN, i.e. the bit pattern\n/// `0xFFF8_0000_0000_0000` — not Rust's positive `f64::NAN`.\nconst C_NAN: f64 = f64::from_bits(0xFFF8_0000_0000_0000);\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn cJSON_GetNumberValue(item: *const cJSON) -> f64 {\n    if cJSON_IsNumber(item) == 0 {\n        return C_NAN;\n    }\n\n    (*item).valuedouble\n}\n\nstatic mut VERSION_BUF: [c_char; 15] = [0; 15];\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn cJSON_Version() -> *const c_char {\n    let version = (&raw mut VERSION_BUF) as *mut c_char;\n    sprintf(\n        version,\n        cs!(b\"%i.%i.%i\\0\"),\n        CJSON_VERSION_MAJOR,\n        CJSON_VERSION_MINOR,\n        CJSON_VERSION_PATCH,\n    );\n\n    version\n}\n\n/// Case insensitive string comparison, doesn't consider two NULL pointers equal though.\nunsafe fn case_insensitive_strcmp(mut string1: *const u8, mut string2: *const u8) -> c_int {\n    if string1.is_null() || string2.is_null() {\n        return 1;\n    }\n\n    if string1 == string2 {\n        return 0;\n    }\n\n    while tolower(*string1 as c_int) == tolower(*string2 as c_int) {\n        if *string1 == b'\\0' {\n            return 0;\n        }\n        string1 = string1.wrapping_add(1);\n        string2 = string2.wrapping_add(1);\n    }\n\n    tolower(*string1 as c_int) - tolower(*string2 as c_int)\n}\n\nunsafe fn cJSON_strdup(string: *const u8, hooks: *const InternalHooks) -> *mut u8 {\n    let length: usize;\n    let copy: *mut u8;\n\n    if string.is_null() {\n        return ptr::null_mut();\n    }\n\n    length = strlen(string as *const c_char) + 1;\n    copy = (*hooks).alloc(length) as *mut u8;\n    if copy.is_null() {\n        return ptr::null_mut();\n    }\n    memcpy(copy as *mut c_void, string as *const c_void, length);\n\n    copy\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn cJSON_InitHooks(hooks: *mut cJSON_Hooks) {\n    let g = global_hooks_ptr();\n\n    if hooks.is_null() {\n        /* Reset hooks */\n        (*g).allocate = Some(malloc);\n        (*g).deallocate = Some(free);\n        (*g).reallocate = Some(realloc);\n        return;\n    }\n\n    (*g).allocate = Some(malloc);\n    if let Some(f) = (*hooks).malloc_fn {\n        (*g).allocate = Some(f);\n    }\n\n    (*g).deallocate = Some(free);\n    if let Some(f) = (*hooks).free_fn {\n        (*g).deallocate = Some(f);\n    }\n\n    /* use realloc only if both free and malloc are used */\n    (*g).reallocate = None;\n    let allocate_is_malloc = true;\n    let deallocate_is_free = true;\n    if allocate_is_malloc && deallocate_is_free {\n        (*g).reallocate = Some(realloc);\n    }\n}\n\n/// Internal constructor.\nunsafe fn cJSON_New_Item(hooks: *const InternalHooks) -> *mut cJSON {\n    let node = (*hooks).alloc(core::mem::size_of::<cJSON>()) as *mut cJSON;\n    if !node.is_null() {\n        ptr::write_bytes(node as *mut u8, 0u8, core::mem::size_of::<cJSON>());\n    }\n\n    node\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn cJSON_Delete(item: *mut cJSON) {\n    let mut item = item;\n    let mut next: *mut cJSON;\n    while !item.is_null() {\n        next = (*item).next;\n        if ((*item).type_ & cJSON_IsReference) == 0 && !(*item).child.is_null() {\n            cJSON_Delete((*item).child);\n        }\n        if ((*item).type_ & cJSON_IsReference) == 0 && !(*item).valuestring.is_null() {\n            global_hooks().dealloc((*item).valuestring as *mut c_void);\n            (*item).valuestring = ptr::null_mut();\n        }\n        if ((*item).type_ & cJSON_StringIsConst) == 0 && !(*item).string.is_null() {\n            global_hooks().dealloc((*item).string as *mut c_void);\n            (*item).string = ptr::null_mut();\n        }\n        global_hooks().dealloc(item as *mut c_void);\n        item = next;\n    }\n}\n\n/// get the decimal point character of the current locale\nunsafe fn get_decimal_point() -> u8 {\n    let lc = localeconv();\n    *(*lc).decimal_point as u8\n}\n\n// ---------------------------------------------------------------------------\n// parse buffer\n// ---------------------------------------------------------------------------\n\nstruct ParseBuffer {\n    content: *const u8,\n    length: usize,\n    offset: usize,\n    depth: usize,\n    hooks: InternalHooks,\n}\n\nimpl ParseBuffer {\n    const fn zeroed() -> ParseBuffer {\n        ParseBuffer {\n            content: ptr::null(),\n            length: 0,\n            offset: 0,\n            depth: 0,\n            hooks: InternalHooks::zeroed(),\n        }\n    }\n}\n\n/// check if the given size is left to read in a given parse buffer (starting with 1)\n#[inline]\nunsafe fn can_read(buffer: *const ParseBuffer, size: usize) -> bool {\n    !buffer.is_null() && ((*buffer).offset.wrapping_add(size) <= (*buffer).length)\n}\n\n/// check if the buffer can be accessed at the given index (starting with 0)\n#[inline]\nunsafe fn can_access_at_index(buffer: *const ParseBuffer, index: usize) -> bool {\n    !buffer.is_null() && ((*buffer).offset.wrapping_add(index) < (*buffer).length)\n}\n\n#[inline]\nunsafe fn cannot_access_at_index(buffer: *const ParseBuffer, index: usize) -> bool {\n    !can_access_at_index(buffer, index)\n}\n\n/// get a pointer to the buffer at the position\n#[inline]\nunsafe fn buffer_at_offset(buffer: *const ParseBuffer) -> *const u8 {\n    (*buffer).content.wrapping_add((*buffer).offset)\n}\n\n/// Parse the input text to generate a number, and populate the result into item.\nunsafe fn parse_number(item: *mut cJSON, input_buffer: *mut ParseBuffer) -> cJSON_bool {\n    let number: f64;\n    let mut after_end: *mut c_char = ptr::null_mut();\n    let number_c_string: *mut u8;\n    let decimal_point = get_decimal_point();\n    let mut i: usize = 0;\n    let mut number_string_length: usize = 0;\n    let mut has_decimal_point: cJSON_bool = FALSE;\n\n    if input_buffer.is_null() || (*input_buffer).content.is_null() {\n        return FALSE;\n    }\n\n    /* copy the number into a temporary buffer and replace '.' with the decimal point\n     * of the current locale (for strtod)\n     * This also takes care of '\\0' not necessarily being available for marking the end of the input */\n    while can_access_at_index(input_buffer, i) {\n        match *buffer_at_offset(input_buffer).wrapping_add(i) {\n            b'0' | b'1' | b'2' | b'3' | b'4' | b'5' | b'6' | b'7' | b'8' | b'9' | b'+' | b'-'\n            | b'e' | b'E' => {\n                number_string_length += 1;\n            }\n\n            b'.' => {\n                number_string_length += 1;\n                has_decimal_point = TRUE;\n            }\n\n            _ => break,\n        }\n        i += 1;\n    }\n\n    /* malloc for temporary buffer, add 1 for '\\0' */\n    number_c_string = (*input_buffer).hooks.alloc(number_string_length + 1) as *mut u8;\n    if number_c_string.is_null() {\n        return FALSE; /* allocation failure */\n    }\n\n    memcpy(\n        number_c_string as *mut c_void,\n        buffer_at_offset(input_buffer) as *const c_void,\n        number_string_length,\n    );\n    *number_c_string.wrapping_add(number_string_length) = b'\\0';\n\n    if has_decimal_point != 0 {\n        i = 0;\n        while i < number_string_length {\n            if *number_c_string.wrapping_add(i) == b'.' {\n                /* replace '.' with the decimal point of the current locale (for strtod) */\n                *number_c_string.wrapping_add(i) = decimal_point;\n            }\n            i += 1;\n        }\n    }\n\n    number = strtod(number_c_string as *const c_char, &mut after_end);\n    if number_c_string as *const c_char as usize == after_end as usize {\n        /* free the temporary buffer */\n        (*input_buffer)\n            .hooks\n            .dealloc(number_c_string as *mut c_void);\n        return FALSE; /* parse_error */\n    }\n\n    (*item).valuedouble = number;\n\n    /* use saturation in case of overflow */\n    if number >= INT_MAX as f64 {\n        (*item).valueint = INT_MAX;\n    } else if number <= INT_MIN as f64 {\n        (*item).valueint = INT_MIN;\n    } else {\n        (*item).valueint = double_to_int(number);\n    }\n\n    (*item).type_ = cJSON_Number;\n\n    (*input_buffer).offset = (*input_buffer)\n        .offset\n        .wrapping_add((after_end as usize).wrapping_sub(number_c_string as usize));\n    /* free the temporary buffer */\n    (*input_buffer)\n        .hooks\n        .dealloc(number_c_string as *mut c_void);\n    TRUE\n}\n\n/// don't ask me, but the original cJSON_SetNumberValue returns an integer or double\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn cJSON_SetNumberHelper(object: *mut cJSON, number: f64) -> f64 {\n    if number >= INT_MAX as f64 {\n        (*object).valueint = INT_MAX;\n    } else if number <= INT_MIN as f64 {\n        (*object).valueint = INT_MIN;\n    } else {\n        (*object).valueint = double_to_int(number);\n    }\n\n    (*object).valuedouble = number;\n    (*object).valuedouble\n}\n\n/// Note: when passing a NULL valuestring, cJSON_SetValuestring treats this as an error and return NULL\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn cJSON_SetValuestring(\n    object: *mut cJSON,\n    valuestring: *const c_char,\n) -> *mut c_char {\n    let copy: *mut c_char;\n    let v1_len: usize;\n    let v2_len: usize;\n\n    /* if object's type is not cJSON_String or is cJSON_IsReference, it should not set valuestring */\n    if object.is_null()\n        || ((*object).type_ & cJSON_String) == 0\n        || ((*object).type_ & cJSON_IsReference) != 0\n    {\n        return ptr::null_mut();\n    }\n    /* return NULL if the object is corrupted or valuestring is NULL */\n    if (*object).valuestring.is_null() || valuestring.is_null() {\n        return ptr::null_mut();\n    }\n\n    v1_len = strlen(valuestring);\n    v2_len = strlen((*object).valuestring);\n\n    if v1_len <= v2_len {\n        /* strcpy does not handle overlapping string: [X1, X2] [Y1, Y2] => X2 < Y1 or Y2 < X1 */\n        if !((valuestring as usize).wrapping_add(v1_len) < (*object).valuestring as usize\n            || ((*object).valuestring as usize).wrapping_add(v2_len) < valuestring as usize)\n        {\n            return ptr::null_mut();\n        }\n        strcpy((*object).valuestring, valuestring);\n        return (*object).valuestring;\n    }\n    copy = cJSON_strdup(valuestring as *const u8, global_hooks_ptr()) as *mut c_char;\n    if copy.is_null() {\n        return ptr::null_mut();\n    }\n    if !(*object).valuestring.is_null() {\n        cJSON_free((*object).valuestring as *mut c_void);\n    }\n    (*object).valuestring = copy;\n\n    copy\n}\n\n// ---------------------------------------------------------------------------\n// print buffer\n// ---------------------------------------------------------------------------\n\nstruct PrintBuffer {\n    buffer: *mut u8,\n    length: usize,\n    offset: usize,\n    depth: usize,\n    noalloc: cJSON_bool,\n    format: cJSON_bool,\n    hooks: InternalHooks,\n}\n\nimpl PrintBuffer {\n    const fn zeroed() -> PrintBuffer {\n        PrintBuffer {\n            buffer: ptr::null_mut(),\n            length: 0,\n            offset: 0,\n            depth: 0,\n            noalloc: 0,\n            format: 0,\n            hooks: InternalHooks::zeroed(),\n        }\n    }\n}\n\n/// realloc printbuffer if necessary to have at least \"needed\" bytes more\nunsafe fn ensure(p: *mut PrintBuffer, needed: usize) -> *mut u8 {\n    let newbuffer: *mut u8;\n    let newsize: usize;\n    let mut needed = needed;\n\n    if p.is_null() || (*p).buffer.is_null() {\n        return ptr::null_mut();\n    }\n\n    if ((*p).length > 0) && ((*p).offset >= (*p).length) {\n        /* make sure that offset is valid */\n        return ptr::null_mut();\n    }\n\n    if needed > INT_MAX as usize {\n        /* sizes bigger than INT_MAX are currently not supported */\n        return ptr::null_mut();\n    }\n\n    needed = needed.wrapping_add((*p).offset).wrapping_add(1);\n    if needed <= (*p).length {\n        return (*p).buffer.wrapping_add((*p).offset);\n    }\n\n    if (*p).noalloc != 0 {\n        return ptr::null_mut();\n    }\n\n    /* calculate new buffer size */\n    if needed > (INT_MAX as usize / 2) {\n        /* overflow of int, use INT_MAX if possible */\n        if needed <= INT_MAX as usize {\n            newsize = INT_MAX as usize;\n        } else {\n            return ptr::null_mut();\n        }\n    } else {\n        newsize = needed * 2;\n    }\n\n    if (*p).hooks.reallocate.is_some() {\n        /* reallocate with realloc if available */\n        newbuffer =\n            ((*p).hooks.reallocate.unwrap())((*p).buffer as *mut c_void, newsize) as *mut u8;\n        if newbuffer.is_null() {\n            (*p).hooks.dealloc((*p).buffer as *mut c_void);\n            (*p).length = 0;\n            (*p).buffer = ptr::null_mut();\n\n            return ptr::null_mut();\n        }\n    } else {\n        /* otherwise reallocate manually */\n        newbuffer = (*p).hooks.alloc(newsize) as *mut u8;\n        if newbuffer.is_null() {\n            (*p).hooks.dealloc((*p).buffer as *mut c_void);\n            (*p).length = 0;\n            (*p).buffer = ptr::null_mut();\n\n            return ptr::null_mut();\n        }\n\n        memcpy(\n            newbuffer as *mut c_void,\n            (*p).buffer as *const c_void,\n            (*p).offset + 1,\n        );\n        (*p).hooks.dealloc((*p).buffer as *mut c_void);\n    }\n    (*p).length = newsize;\n    (*p).buffer = newbuffer;\n\n    newbuffer.wrapping_add((*p).offset)\n}\n\n/// calculate the new length of the string in a printbuffer and update the offset\nunsafe fn update_offset(buffer: *mut PrintBuffer) {\n    let buffer_pointer: *const u8;\n    if buffer.is_null() || (*buffer).buffer.is_null() {\n        return;\n    }\n    buffer_pointer = (*buffer).buffer.wrapping_add((*buffer).offset);\n\n    (*buffer).offset += strlen(buffer_pointer as *const c_char);\n}\n\n/// securely comparison of floating-point variables\nfn compare_double(a: f64, b: f64) -> cJSON_bool {\n    let max_val = if a.abs() > b.abs() { a.abs() } else { b.abs() };\n    if (a - b).abs() <= max_val * f64::EPSILON {\n        TRUE\n    } else {\n        FALSE\n    }\n}\n\n/// Render the number nicely from the given item into a string.\nunsafe fn print_number(item: *const cJSON, output_buffer: *mut PrintBuffer) -> cJSON_bool {\n    let output_pointer: *mut u8;\n    let d = (*item).valuedouble;\n    let mut length: c_int;\n    let mut i: usize = 0;\n    let mut number_buffer: [u8; 26] = [0; 26]; /* temporary buffer to print the number into */\n    let decimal_point = get_decimal_point();\n    let mut test: f64 = 0.0;\n\n    if output_buffer.is_null() {\n        return FALSE;\n    }\n\n    let nb = number_buffer.as_mut_ptr() as *mut c_char;\n\n    /* This checks for NaN and Infinity */\n    if d.is_nan() || d.is_infinite() {\n        length = sprintf(nb, cs!(b\"null\\0\"));\n    } else if d == (*item).valueint as f64 {\n        length = sprintf(nb, cs!(b\"%d\\0\"), (*item).valueint);\n    } else {\n        /* Try 15 decimal places of precision to avoid nonsignificant nonzero digits */\n        length = sprintf(nb, cs!(b\"%1.15g\\0\"), d);\n\n        /* Check whether the original double can be recovered */\n        if sscanf(nb as *const c_char, cs!(b\"%lg\\0\"), &mut test as *mut f64) != 1\n            || compare_double(test, d) == 0\n        {\n            /* If not, print with 17 decimal places of precision */\n            length = sprintf(nb, cs!(b\"%1.17g\\0\"), d);\n        }\n    }\n\n    /* sprintf failed or buffer overrun occurred */\n    if (length < 0) || (length > (core::mem::size_of::<[u8; 26]>() - 1) as c_int) {\n        return FALSE;\n    }\n\n    /* reserve appropriate space in the output */\n    output_pointer = ensure(output_buffer, length as usize + 1);\n    if output_pointer.is_null() {\n        return FALSE;\n    }\n\n    /* copy the printed number to the output and replace locale\n     * dependent decimal point with '.' */\n    while i < length as usize {\n        if number_buffer[i] == decimal_point {\n            *output_pointer.wrapping_add(i) = b'.';\n            i += 1;\n            continue;\n        }\n\n        *output_pointer.wrapping_add(i) = number_buffer[i];\n        i += 1;\n    }\n    *output_pointer.wrapping_add(i) = b'\\0';\n\n    (*output_buffer).offset