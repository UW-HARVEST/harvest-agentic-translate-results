84\t    min_cap: usize,\n285\t) -> *mut c_void {\n286\t    let mut min_cap = min_cap;\n287\t    let min_len: usize = (stbds_arrlen(a) as usize).wrapping_add(addlen);\n288\t\n289\t    if min_len > min_cap {\n290\t        min_cap = min_len;\n291\t    }\n292\t\n293\t    if min_cap <= stbds_arrcap(a) {\n294\t        return a;\n295\t    }\n296\t\n297\t    if min_cap < 2usize.wrapping_mul(stbds_arrcap(a)) {\n298\t        min_cap = 2usize.wrapping_mul(stbds_arrcap(a));\n299\t    } else if min_cap < 4 {\n300\t        min_cap = 4;\n301\t    }\n302\t\n303\t    let old: *mut c_void = if !a.is_null() {\n304\t        stbds_header(a) as *mut c_void\n305\t    } else {\n306\t        ptr::null_mut()\n307\t    };\n308\t    let b = stbds_realloc(\n309\t        old,\n310\t        elemsize.wrapping_mul(min_cap).wrapping_add(HEADER_SIZE),\n311\t    );\n312\t    let b = (b as *mut u8).wrapping_add(HEADER_SIZE) as *mut c_void;\n313\t    if a.is_null() {\n314\t        (*stbds_header(b)).length = 0;\n315\t        (*stbds_header(b)).hash_table = ptr::null_mut();\n316\t        (*stbds_header(b)).temp = 0;\n317\t    }\n318\t    (*stbds_header(b)).capacity = min_cap;\n319\t\n320\t    b\n321\t}\n322\t\n323\t#[unsafe(no_mangle)]\n324\tpub unsafe extern \"C\" fn stbds_arrfreef(a: *mut c_void) {\n325\t    stbds_free(stbds_header(a) as *mut c_void);\n326\t}\n327\t\n328\t// ---------------------------------------------------------------------------\n329\t// Hash seed / hash index construction\n330\t// ---------------------------------------------------------------------------\n331\t\n332\tstatic mut STBDS_HASH_SEED: usize = 0x31415926;\n333\t\n334\t#[inline]\n335\tunsafe fn hash_seed_get() -> usize {\n336\t    *(&raw const STBDS_HASH_SEED)\n337\t}\n338\t\n339\t#[inline]\n340\tunsafe fn hash_seed_set(v: usize) {\n341\t    *(&raw mut STBDS_HASH_SEED) = v;\n342\t}\n343\t\n344\t#[unsafe(no_mangle)]\n345\tpub unsafe extern \"C\" fn stbds_rand_seed(seed: usize) {\n346\t    hash_seed_set(seed);\n347\t}\n348\t\n349\tconst STBDS_SIZE_T_BITS: u32 = (core::mem::size_of::<usize>() * 8) as u32;\n350\t\n351\t/// `STBDS_ALIGN_FWD(n,a)  ->  (((n) + (a) - 1) & ~((a)-1))`\n352\t#[inline]\n353\tfn stbds_align_fwd(n: usize, a: usize) -> usize {\n354\t    n.wrapping_add(a - 1) & !(a - 1)\n355\t}\n356\t\n357\tfn stbds_probe_position(hash: usize, slot_count: usize, _slot_log2: usize) -> usize {\n358\t    hash & slot_count.wrapping_sub(1)\n359\t}\n360\t\n361\tfn stbds_log2(slot_count: usize) -> usize {\n362\t    let mut slot_count = slot_count;\n363\t    let mut n: usize = 0;\n364\t    while slot_count > 1 {\n365\t        slot_count >>= 1;\n366\t        n += 1;\n367\t    }\n368\t    n\n369\t}\n370\t\n371\tunsafe fn stbds_make_hash_index(\n372\t    slot_count: usize,\n373\t    ot: *mut stbds_hash_index,\n374\t) -> *mut stbds_hash_index {\n375\t    let t: *mut stbds_hash_index = stbds_realloc(\n376\t        ptr::null_mut(),\n377\t        (slot_count >> STBDS_BUCKET_SHIFT)\n378\t            .wrapping_mul(core::mem::size_of::<stbds_hash_bucket>())\n379\t            .wrapping_add(core::mem::size_of::<stbds_hash_index>())\n380\t            .wrapping_add(STBDS_CACHE_LINE_SIZE - 1),\n381\t    ) as *mut stbds_hash_index;\n382\t\n383\t    (*t).storage = stbds_align_fwd(\n384\t        (t as *mut u8).wrapping_add(core::mem::size_of::<stbds_hash_index>()) as usize,\n385\t        STBDS_CACHE_LINE_SIZE,\n386\t    ) as *mut stbds_hash_bucket;\n387\t    (*t).slot_count = slot_count;\n388\t    (*t).slot_count_log2 = stbds_log2(slot_count);\n389\t    (*t).tombstone_count = 0;\n390\t    (*t).used_count = 0;\n391\t\n392\t    (*t).used_count_threshold = slot_count.wrapping_sub(slot_count >> 2);\n393\t    (*t).tombstone_count_threshold = (slot_count >> 3).wrapping_add(slot_count >> 4);\n394\t    (*t).used_count_shrink_threshold = slot_count >> 2;\n395\t\n396\t    if slot_count <= STBDS_BUCKET_LENGTH {\n397\t        (*t).used_count_shrink_threshold = 0;\n398\t    }\n399\t    stbds_assert(\n400\t        (*t).used_count_threshold.wrapping_add((*t).tombstone_count_threshold) < (*t).slot_count,\n401\t    );\n402\t\n403\t    if !ot.is_null() {\n404\t        (*t).string = (*ot).string;\n405\t        (*t).seed = (*ot).seed;\n406\t    } else {\n407\t        c_memzero(\n408\t            (&raw mut (*t).string) as *mut u8,\n409\t            core::mem::size_of::<stbds_string_arena>(),\n410\t        );\n411\t        (*t).seed = hash_seed_get();\n412\t        // stbds_load_32_or_64(a, temp, 2147001325, 0x27bb2ee6, 0x87b0b0fd);\n413\t        let mut temp: usize;\n414\t        temp = (0x87b0b0fdu32 ^ 2147001325u32) as usize;\n415\t        temp <<= 16;\n416\t        temp <<= 16;\n417\t        temp >>= 16;\n418\t        temp >>= 16;\n419\t        let mut a: usize = 0x27bb2ee6usize;\n420\t        a <<= 16;\n421\t        a <<= 16;\n422\t        a ^= temp ^ 2147001325usize;\n423\t        // stbds_load_32_or_64(b, temp, 715136305, 0, 0xb504f32d);\n424\t        temp = (0xb504f32du32 ^ 715136305u32) as usize;\n425\t        temp <<= 16;\n426\t        temp <<= 16;\n427\t        temp >>= 16;\n428\t        temp >>= 16;\n429\t        let mut b: usize = 0usize;\n430\t        b <<= 16;\n431\t        b <<= 16;\n432\t        b ^= temp ^ 715136305usize;\n433\t        hash_seed_set(hash_seed_get().wrapping_mul(a).wrapping_add(b));\n434\t    }\n435\t\n436\t    {\n437\t        let mut i: usize = 0;\n438\t        while i < slot_count >> STBDS_BUCKET_SHIFT {\n439\t            let b: *mut stbds_hash_bucket = (*t).storage.add(i);\n440\t            let mut j: usize = 0;\n441\t            while j < STBDS_BUCKET_LENGTH {\n442\t                (*b).hash[j] = STBDS_HASH_EMPTY;\n443\t                j += 1;\n444\t            }\n445\t            let mut j: usize = 0;\n446\t            while j < STBDS_BUCKET_LENGTH {\n447\t                (*b).index[j] = STBDS_INDEX_EMPTY;\n448\t                j += 1;\n449\t            }\n450\t            i += 1;\n451\t        }\n452\t    }\n453\t\n454\t    if !ot.is_null() {\n455\t 