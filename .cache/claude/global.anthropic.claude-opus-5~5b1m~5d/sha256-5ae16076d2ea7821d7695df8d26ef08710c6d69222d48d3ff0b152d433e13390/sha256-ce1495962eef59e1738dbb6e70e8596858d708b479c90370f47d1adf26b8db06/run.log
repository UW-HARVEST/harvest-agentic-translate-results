{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01QBo4GE6gsGWsyB6DisSH9o","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/` (an stb_ds.h derived\n2\t//! dynamic-array / hash-map implementation plus the small test helpers\n3\t//! `strkey()` and `arr_push()`).\n4\t//!\n5\t//! The translation is bit-for-bit faithful to the C original:\n6\t//!   * all data structures use the identical `#[repr(C)]` layout so that the\n7\t//!     `stb_ds.h` macros (which poke at the array header directly) keep working,\n8\t//!   * all allocations go through the C library's `realloc`/`free` so that\n9\t//!     memory allocated here can be released by C code (and vice versa),\n10\t//!   * every arithmetic quirk of the original (including implicit `int`\n11\t//!     promotions that sign-extend into `size_t`) is reproduced exactly,\n12\t//!   * the order of all checks/branches is preserved.\n13\t\n14\t#![allow(non_camel_case_types)]\n15\t#![allow(clippy::missing_safety_doc)]\n16\t\n17\tuse core::ffi::{c_char, c_int, c_void};\n18\tuse core::ptr;\n19\t\n20\t// ---------------------------------------------------------------------------\n21\t// libc bindings (STBDS_REALLOC / STBDS_FREE map onto realloc/free)\n22\t// ---------------------------------------------------------------------------\n23\t\n24\tunsafe extern \"C\" {\n25\t    fn realloc(p: *mut c_void, size: usize) -> *mut c_void;\n26\t    fn free(p: *mut c_void);\n27\t}\n28\t\n29\t/// `STBDS_REALLOC(c,p,s)  ->  realloc(p,s)`\n30\t#[inline]\n31\tunsafe fn stbds_realloc(p: *mut c_void, size: usize) -> *mut c_void {\n32\t    realloc(p, size)\n33\t}\n34\t\n35\t/// `STBDS_FREE(c,p)  ->  free(p)`\n36\t#[inline]\n37\tunsafe fn stbds_free(p: *mut c_void) {\n38\t    free(p)\n39\t}\n40\t\n41\t// ---------------------------------------------------------------------------\n42\t// Small C string / memory helpers (equivalent to strlen/memcmp/strcmp/...)\n43\t// ---------------------------------------------------------------------------\n44\t\n45\t#[inline]\n46\tunsafe fn c_strlen(s: *const c_char) -> usize {\n47\t    let mut n: usize = 0;\n48\t    let mut p = s as *const u8;\n49\t    while *p != 0 {\n50\t        n += 1;\n51\t        p = p.add(1);\n52\t    }\n53\t    n\n54\t}\n55\t\n56\t/// `0 == strcmp(a, b)`\n57\t#[inline]\n58\tunsafe fn c_str_eq(a: *const c_char, b: *const c_char) -> bool {\n59\t    let mut pa = a as *const u8;\n60\t    let mut pb = b as *const u8;\n61\t    loop {\n62\t        let ca = *pa;\n63\t        let cb = *pb;\n64\t        if ca != cb {\n65\t            return false;\n66\t        }\n67\t        if ca == 0 {\n68\t            return true;\n69\t        }\n70\t        pa = pa.add(1);\n71\t        pb = pb.add(1);\n72\t    }\n73\t}\n74\t\n75\t/// `0 == memcmp(a, b, n)`\n76\t#[inline]\n77\tunsafe fn c_mem_eq(a: *const u8, b: *const u8, n: usize) -> bool {\n78\t    let mut i: usize = 0;\n79\t    while i < n {\n80\t        if *a.add(i) != *b.add(i) {\n81\t            return false;\n82\t        }\n83\t        i += 1;\n84\t    }\n85\t    true\n86\t}\n87\t\n88\t/// `memmove(dst, src, n)`\n89\t#[inline]\n90\tunsafe fn c_memmove(dst: *mut u8, src: *const u8, n: usize) {\n91\t    if n != 0 {\n92\t        ptr::copy(src, dst, n);\n93\t    }\n94\t}\n95\t\n96\t/// `memcpy(dst, src, n)`\n97\t#[inline]\n98\tunsafe fn c_memcpy(dst: *mut u8, src: *const u8, n: usize) {\n99\t    if n != 0 {\n100\t        ptr::copy_nonoverlapping(src, dst, n);\n101\t    }\n102\t}\n103\t\n104\t/// `memset(dst, 0, n)`\n105\t#[inline]\n106\tunsafe fn c_memzero(dst: *mut u8, n: usize) {\n107\t    if n != 0 {\n108\t        ptr::write_bytes(dst, 0, n);\n109\t    }\n110\t}\n111\t\n112\t/// `STBDS_ASSERT(x)` -- the original relies on `assert()`, which is compiled\n113\t/// out in release builds; the conditions are internal invariants only.\n114\t#[inline]\n115\tfn stbds_assert(_cond: bool) {}\n116\t\n117\t// ---------------------------------------------------------------------------\n118\t// Data structures (layout identical to the C originals)\n119\t// ---------------------------------------------------------------------------\n120\t\n121\t#[repr(C)]\n122\t#[derive(Clone, Copy)]\n123\tpub struct stbds_array_header {\n124\t    pub length: usize,\n125\t    pub capacity: usize,\n126\t    pub hash_table: *mut c_void,\n127\t    pub temp: isize,\n128\t}\n129\t\n130\t#[repr(C)]\n131\t#[derive(Clone, Copy)]\n132\tpub struct stbds_string_block {\n133\t    pub next: *mut stbds_string_block,\n134\t    pub storage: [c_char; 8],\n135\t}\n136\t\n137\t#[repr(C)]\n138\t#[derive(Clone, Copy)]\n139\tpub struct stbds_string_arena {\n140\t    pub storage: *mut stbds_string_block,\n141\t    pub remaining: usize,\n142\t    pub block: u8,\n143\t    pub mode: u8,\n144\t}\n145\t\n146\tconst STBDS_BUCKET_LENGTH: usize = 8;\n147\tconst STBDS_BUCKET_SHIFT: usize = 3; // STBDS_BUCKET_LENGTH == 8 ? 3 : 2\n148\tconst STBDS_BUCKET_MASK: usize = STBDS_BUCKET_LENGTH - 1;\n149\tconst STBDS_CACHE_LINE_SIZE: usize = 64;\n150\t\n151\t#[repr(C)]\n152\t#[derive(Clone, Copy)]\n153\tpub struct stbds_hash_bucket {\n154\t    pub hash: [usize; STBDS_BUCKET_LENGTH],\n155\t    pub index: [isize; STBDS_BUCKET_LENGTH],\n156\t}\n157\t\n158\t#[repr(C)]\n159\t#[derive(Clone, Copy)]\n160\tpub struct stbds_hash_index {\n161\t    pub temp_key: *mut c_char,\n162\t    pub slot_count: usize,\n163\t    pub used_count: usize,\n164\t    pub used_count_threshold: usize,\n165\t    pub used_count_shrink_threshold: usize,\n166\t    pub tombstone_count: usize,\n167\t    pub tombstone_count_threshold: usize,\n168\t    pub seed: usize,\n169\t    pub slot_count_log2: usize,\n170\t    pub string: stbds_string_arena,\n171\t    pub storage: *mut stbds_hash_bucket,\n172\t}\n173\t\n174\t// Compile-time confirmation that the layouts match the C compiler's.\n175\tconst _: () = assert!(core::mem::size_of::<stbds_array_header>() == 32);\n176\tconst _: () = assert!(core::mem::size_of::<stbds_string_block>() == 16);\n177\tconst _: () = assert!(core::mem::size_of::<stbds_string_arena>() == 24);\n178\tconst _: () = assert!(core::mem::size_of::<stbds_hash_bucket>() == 128);\n179\tconst _: () = assert!(core::mem::size_of::<stbds_hash_index>() == 104);\n180\tconst _: () = assert!(core::mem::offset_of!(stbds_hash_index, string) == 72);\n181\tconst _: () = assert!(core::mem::offset_of!(stbds_hash_index, storage) == 96);\n182\tconst _: () = assert!(core::mem::offset_of!(stbds_string_arena, block) == 16);\n183\tconst _: () = assert!(core::mem::offset_of!(stbds_string_arena, mode) == 17);\n184\t\n185\tconst HEADER_SIZE: usize = core::mem::size_of::<stbds_array_header>();\n186\t\n187\tconst STBDS_HM_BINARY: c_int = 0;\n188\tconst STBDS_HM_STRING: c_int = 1;\n189\t\n190\tconst STBDS_SH_NONE: u8 = 0;\n191\t#[allow(dead_code)]\n192\tconst STBDS_SH_DEFAULT: u8 = 1;\n193\tconst STBDS_SH_STRDUP: u8 = 2;\n194\tconst STBDS_SH_ARENA: u8 = 3;\n195\t\n196\tconst STBDS_INDEX_EMPTY: isize = -1;\n197\tconst STBDS_INDEX_DELETED: isize = -2;\n198\t\n199\tconst STBDS_HASH_EMPTY: usize = 0;\n200\tconst STBDS_HASH_DELETED: usize = 1;\n201\t\n202\t#[inline]\n203\tfn stbds_index_in_use(x: isize) -> bool {\n204\t    x >= 0\n205\t}\n206\t\n207\t// ---------------------------------------------------------------------------\n208\t// Header / array accessor helpers (the stb_ds.h macros)\n209\t// ---------------------------------------------------------------------------\n210\t\n211\t/// `stbds_header(t)  ->  ((stbds_array_header *) (t) - 1)`\n212\t#[inline]\n213\tfn stbds_header(a: *mut c_void) -> *mut stbds_array_header {\n214\t    (a as *mut u8).wrapping_sub(HEADER_SIZE) as *mut stbds_array_header\n215\t}\n216\t\n217\t/// `stbds_arrlen(a)`\n218\t#[inline]\n219\tunsafe fn stbds_arrlen(a: *mut c_void) -> isize {\n220\t    if a.is_null() {\n221\t        0\n222\t    } else {\n223\t        (*stbds_header(a)).length as isize\n224\t    }\n225\t}\n226\t\n227\t/// `stbds_arrcap(a)`\n228\t#[inline]\n229\tunsafe fn st