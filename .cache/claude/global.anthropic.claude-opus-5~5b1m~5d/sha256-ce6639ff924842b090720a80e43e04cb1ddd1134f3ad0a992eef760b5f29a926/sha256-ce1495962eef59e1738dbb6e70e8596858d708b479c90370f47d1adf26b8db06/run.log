   let _g = CAPTURE_LOCK.lock().unwrap();\n678\t    let mut path = std::env::temp_dir();\n679\t    path.push(format!(\"mujs_cap_{}_{:?}.txt\", std::process::id(), std::thread::current().id()));\n680\t    let cpath = cs(path.to_str().unwrap());\n681\t    unsafe {\n682\t        fflush(std::ptr::null_mut());\n683\t        let saved = dup(1);\n684\t        /* O_WRONLY|O_CREAT|O_TRUNC = 1|64|512 on linux */\n685\t        let fd = open(cpath.as_ptr(), 1 | 64 | 512, 0o644 as c_int);\n686\t        assert!(fd >= 0, \"cannot open capture file\");\n687\t        dup2(fd, 1);\n688\t        close(fd);\n689\t        f();\n690\t        fflush(std::ptr::null_mut());\n691\t        dup2(saved, 1);\n692\t        close(saved);\n693\t    }\n694\t    let data = std::fs::read(&path).unwrap_or_default();\n695\t    let _ = std::fs::remove_file(&path);\n696\t    String::from_utf8_lossy(&data).into_owned()\n697\t}\n698\t\n699\t/* -------------------------------------------------------------------------- */\n700\t/* deterministic PRNG (fixed seed, reproducible property-style testing)        */\n701\t/* -------------------------------------------------------------------------- */\n702\t\n703\tpub struct Rng(u64);\n704\t\n705\timpl Rng {\n706\t    pub fn new(seed: u64) -> Rng {\n707\t        Rng(seed ^ 0x9E3779B97F4A7C15)\n708\t    }\n709\t    pub fn next_u64(&mut self) -> u64 {\n710\t        /* splitmix64 */\n711\t        self.0 = self.0.wrapping_add(0x9E3779B97F4A7C15);\n712\t        let mut z = self.0;\n713\t        z = (z ^ (z >> 30)).wrapping_mul(0xBF58476D1CE4E5B9);\n714\t        z = (z ^ (z >> 27)).wrapping_mul(0x94D049BB133111EB);\n715\t        z ^ (z >> 31)\n716\t    }\n717\t    pub fn u32(&mut self) -> u32 {\n718\t        self.next_u64() as u32\n719\t    }\n720\t    pub fn below(&mut self, n: u64) -> u64 {\n721\t        if n == 0 {\n722\t            0\n723\t        } else {\n724\t            self.next_u64() % n\n725\t        }\n726\t    }\n727\t    pub fn range_i64(&mut self, lo: i64, h