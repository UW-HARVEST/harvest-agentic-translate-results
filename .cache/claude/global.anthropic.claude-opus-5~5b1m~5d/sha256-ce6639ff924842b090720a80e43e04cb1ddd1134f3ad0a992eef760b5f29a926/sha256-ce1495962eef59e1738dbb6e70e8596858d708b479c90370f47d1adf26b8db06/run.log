t    js_pushliteral: unsafe extern \"C\" fn(JS, *const c_char),\n169\t    js_pushobject: unsafe extern \"C\" fn(JS, Obj),\n170\t    js_newobjectx: unsafe extern \"C\" fn(JS),\n171\t    js_newobject: unsafe extern \"C\" fn(JS),\n172\t    js_newarray: unsafe extern \"C\" fn(JS),\n173\t    js_newboolean: unsafe extern \"C\" fn(JS, c_int),\n174\t    js_newnumber: unsafe extern \"C\" fn(JS, f64),\n175\t    js_newstring: unsafe extern \"C\" fn(JS, *const c_char),\n176\t    js_newcfunction: unsafe extern \"C\" fn(JS, Option<CFun>, *const c_char, c_int),\n177\t    js_newcfunctionx: unsafe extern \"C\" fn(JS, Option<CFun>, *const c_char, c_int, *mut c_void, Option<Finalize>),\n178\t    js_newcconstructor: unsafe extern \"C\" fn(JS, Option<CFun>, Option<CFun>, *const c_char, c_int),\n179\t    js_newuserdata: unsafe extern \"C\" fn(JS, *const c_char, *mut c_void, Option<Finalize>),\n180\t    js_newuserdatax: unsafe extern \"C\" fn(JS, *const c_char, *mut c_void, Option<HasProp>, Option<PutProp>, Option<DelProp>, Option<Finalize>),\n181\t    js_newregexp: unsafe extern \"C\" fn(JS, *const c_char, c_int),\n182\t    js_newarguments: unsafe extern \"C\" fn(JS),\n183\t\n184\t    /* ---- iterators ---- */\n185\t    js_pushiterator: unsafe extern \"C\" fn(JS, c_int, c_int),\n186\t    js_nextiterator: unsafe extern \"C\" fn(JS, c_int) -> *const c_char,\n187\t\n188\t    /* ---- predicates ---- */\n189\t    js_isdefined: unsafe extern \"C\" fn(JS, c_int) -> c_int,\n190\t    js_isundefined: unsafe extern \"C\" fn(JS, c_int) -> c_int,\n191\t    js_isnull: unsafe extern \"C\" fn(JS, c_int) -> c_int,\n192\t    js_isboolean: unsafe extern \"C\" fn(JS, c_int) -> c_int,\n193\t    js_isnumber: unsafe extern \"C\" fn(JS, c_int) -> c_int,\n194\t    js_isstring: unsafe extern \"C\" fn(JS, c_int) -> c_int,\n195\t    js_isprimitive: unsafe extern \"C\" fn(JS, c_int) -> c_int,\n196\t    js_isobject: unsafe extern \"C\" fn(JS, c_int) -> c_int,\n197\t    js_isarray: unsafe extern \"C\" fn(JS, c_int) ->