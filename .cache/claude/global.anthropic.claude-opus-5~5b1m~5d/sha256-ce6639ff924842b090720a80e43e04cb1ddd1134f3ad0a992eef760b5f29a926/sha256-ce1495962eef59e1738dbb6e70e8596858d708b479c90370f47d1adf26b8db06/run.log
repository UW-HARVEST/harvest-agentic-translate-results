n168\t                            (a.js_remove)(J, pic(2));\n169\t                        } else {\n170\t                            (a.js_replace)(J, pic(2));\n171\t                        }\n172\t                        dump(a, J);\n173\t                        (a.js_pushnumber)(J, 0.0);\n174\t                    }\n175\t                }\n176\t                let p = libs();\n177\t                let c = p.c.run_native(act, 0);\n178\t                let r = p.r.run_native(act, 0);\n179\t                let label = format!(\n180\t                    \"{} npush={} idx={}\",\n181\t                    if op == 0 { \"remove\" } else { \"replace\" },\n182\t                    npush,\n183\t                    idx\n184\t                );\n185\t                same(&label, &c, &r);\n186\t                let depth = npush + 1;\n187\t                if idx >= depth || idx < -depth {\n188\t                    assert!(c.contains(\"stack error!\"), \"{}: {}\", label, c);\n189\t                }\n190\t            }\n191\t        }\n192\t    }\n193\t}\n194\t\n195\t/* row 199 js_insert is unconditionally \"not implemented yet\" */\n196\t#[test]\n197\tfn r199_js_insert_not_implemented() {\n198\t    for idx in [-1i64, 0, 1, 99] {\n199\t        set_pi(0, idx);\n200\t        fn act(a: &Api, J: JS) {\n201\t            unsafe {\n202\t                (a.js_pushnumber)(J, 1.0);\n203\t                (a.js_insert)(J, pic(0));\n204\t                emit(\"insert-returned\");\n205\t                (a.js_pushnumber)(J, 0.0);\n206\t            }\n207\t        }\n208\t        let p = libs();\n209\t        let c = p.c.run_native(act, 0);\n210\t        same(&format!(\"js_insert({})\", idx), &c, &p.r.run_native(act, 0));\n211\t        assert!(c.contains(\"not implemented yet\"), \"{}\", c);\n212\t        for f in [JS_STRICT, 2] {\n213\t            diff_native(&format!(\"js_insert({})\", idx), act, f);\n214\t        }\n215\t    }\n216\t}\n217\t\n218\t/* row 204 js_rot / js_rotN — counts that stay