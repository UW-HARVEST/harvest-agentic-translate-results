 -> c_int,\n320\t    jsY_tokenstring: unsafe extern \"C\" fn(c_int) -> *const c_char,\n321\t    jsY_findword: unsafe extern \"C\" fn(*const c_char, *const *const c_char, c_int) -> c_int,\n322\t\n323\t    /* ---- interning / gc ---- */\n324\t    jsS_dumpstrings: unsafe extern \"C\" fn(JS),\n325\t}\n326\t\n327\tfn env_or(name: &str, default: PathBuf) -> PathBuf {\n328\t    match std::env::var_os(name) {\n329\t        Some(v) => PathBuf::from(v),\n330\t        None => default,\n331\t    }\n332\t}\n333\t\n334\tfn root() -> PathBuf {\n335\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n336\t}\n337\t\n338\tpub fn c_so() -> PathBuf {\n339\t    env_or(\n340\t        \"MUJS_C_SO\",\n341\t        root().parent().unwrap().join(\"c_src/build/libmujs.so\"),\n342\t    )\n343\t}\n344\t\n345\tpub fn rust_so() -> PathBuf {\n346\t    if let Some(v) = std::env::var_os(\"MUJS_RUST_SO\") {\n347\t        return PathBuf::from(v);\n348\t    }\n349\t    /* the test binary lives in target/<profile>/deps/, the cdylib in target/<profile>/ */\n350\t    let exe = std::env::current_exe().expect(\"current_exe\");\n351\t    let dir = exe.parent().unwrap().parent().unwrap();\n352\t    let p = dir.join(\"libmujs.so\");\n353\t    if p.exists() {\n354\t        return p;\n355\t    }\n356\t    root().join(\"target/release/libmujs.so\")\n357\t}\n358\t\n359\t/* Both libraries are loaded exactly once per test process. */\n360\tpub struct Pair {\n361\t    pub c: Api,\n362\t    pub r: Api,\n363\t}\n364\t\n365\tpub fn libs() -> &'static Pair {\n366\t    use std::sync::OnceLock;\n367\t    static P: OnceLock<Pair> = OnceLock::new();\n368\t    P.get_or_init(|| {\n369\t        /* c_src/CMakeLists.txt does not link libm, so libmujs.so has undefined\n370\t         * math symbols (ceil, floor, fmod, ...). Put libm in the global scope\n371\t         * first so those lazy bindings resolve. Both mujs libraries themselves\n372\t         * stay RTLD_LOCAL, so they can never interpose on each other. */\n373\t        use libloading::os::unix as ul;\n374\t        let m = unsafe { ul::Library::open(Some(\"libm.so.6\"), ul::RTLD_NOW | ul::RTLD_GLOBAL) }\n375\t            .expect(\"dlopen libm.so.6\");\n376\t        std::mem::forget(m);\n377\t        Pair {\n378\t            c: Api::load(\"C\", &c_so()),\n379\t            r: Api::load(\"RUST\", &rust_so()),\n380\t        }\n381\t    })\n382\t}\n383\t\n384\tpub fn cs(s: &str) -> CString {\n385\t    CString::new(s).unwrap()\n386\t}\n387\t\n388\tpub unsafe fn rs(p: *const c_char) -> String {\n389\t    if p.is_null() {\n390\t        return \"<null>\".to_string();\n391\t    }\n392\t    String::from_utf8_lossy(CStr::from_ptr(p).to_bytes()).into_owned()\n393\t}\n394\t\n395\t/* -------------------------------------------------------------------------- */\n396\t/* native action trampoline: lets a test drive the raw C API inside js_pcall,  */\n397\t/* so that a thrown exception is caught instead of aborting the process.       */\n398\t/* -------------------------------------------------------------------------- */\n399\t\n400\tthread_local! {\n401\t    static CUR: Cell<*const Api> = const { Cell::new(std::ptr::null()) };\n402\t    static ACT: Cell<Option<fn(&Api, JS)>> = const { Cell::new(None) };\n403\t    static OUT: std::cell::RefCell<String> = const { std::cell::RefCell::new(String::new()) };\n404\t}\n405\t\n406\t/// Record an observation from inside a native action. The borrow is never held\n407\t/// across a call into the library, so a longjmp can not leave it locked.\n408\tpub fn emit(s: &str) {\n409\t    OUT.with(|o| {\n410\t        let mut b = o.borrow_mut();\n411\t        b.push_str(s);\n412\t        b.push('|');\n413\t    });\n414\t}\n415\t\n416\tpub fn emit_num(x: f64) {\n417\t    emit(&format!(\"{:#x}\", x.to_bits()));\n418\t}\n419\t\n420\tpub unsafe fn emit_cstr(p: *const c_char) {\n421\t    emit(&format!(\"{:?}\", rs(p)));\n422\t}\n423\t\n424\tfn out_take() -> String {\n425\t    OUT.with(|o| std::mem::take(&mut *o.borrow_mut()))\n426\t}\n427\t\n428\t/* Parameters for native actions (which must be plain `fn`s, no captures). */\n429\tthread_local! {\n430\t    static PI: Cell<[i64; 4]> = const { Cell::new([0; 4]) };\n431\t    static PF: Cell<[f64; 2]> = const { Cell::new([0.0; 2]) };\n432\t    static PS: std::cell::RefCell<[String; 2]> =\n433\t        const { std::cell::RefCell::new([String::new(), String::new()]) };\n434\t}\n435\t\n436\tpub fn set_pi(i: usize, v: i64) {\n437\t    PI.with(|p| {\n438\t        let mut a = p.get();\n439\t        a[i] = v;\n440\t        p.set(a);\n441\t    })\n442\t}\n443\tpub fn pi(i: usize) -> i64 {\n444\t    PI.with(|p| p.get()[i])\n445\t}\n446\tpub fn pic(i: usize) -> c_int {\n447\t    pi(i) as c_int\n448\t}\n449\tpub fn set_pf(i: usize, v: f64) {\n450\t    PF.with(|p| {\n451\t        let mut a = p.get();\n452\t        a[i] = v;\n453\t        p.set(a);\n454\t    })\n455\t}\n456\tpub fn pf(i: usize) -> f64 {\n457\t    PF.with(|p| p.get()[i])\n458\t}\n459\tpub fn set_ps(i: usize, v: &str) {\n460\t    PS.with(|p| p.borrow_mut()[i] = v.to_string())\n461\t}\n462\tpub fn ps(i: usize) -> CString {\n463\t    cs(&PS.with(|p| p.borrow()[i].clone()))\n464\t}\n465\t\n466\tpub fn cur() -> &'static Api {\n467\t    let p = CUR.with(|c| c.get());\n468\t    assert!(!p.is_null(), \"no current Api\");\n469\t    unsafe { &*p }\n470\t}\n471\t\n472\tunsafe extern \"C\" fn trampoline(J: JS) {\n473\t    let f = ACT.with(|a| a.get()).expect(\"no action\");\n474\t    f(cur(), J);\n475\t}\n476\t\n477\timpl Api {\n478\t    /* Result of an evaluation, rendered identically for both libraries. */\n479\t    pub fn newstate(&self, flags: c_int) -> JS {\n480\t        let J = unsafe { (self.js_newstate)(None, std::ptr::null_mut(), flags) };\n481\t        assert!(!J.is_null(), \"{}: js_newstate failed\", self.tag);\n482\t        J\n483\t    }\n484\t\n485\t    /// Evaluate `src` and render `rc` + the resulting value (or error) as a string.\n486\t    pub fn eval(&self, src: &str, flags: c_int) -> String {\n487\t        let J = self.newstate(flags);\n488\t        let s = self.eval_in(J, src);\n489\t        unsafe { (self.js_freestate)(J) };\n490\t        s\n491\t    }\n492\t\n493\t    pub fn eval_in(&self, J: JS, src: &str) -> String {\n494\t        unsafe {\n495\t            let name = cs(\"test.js\");\n496\t            let source = cs(src);\n497\t            let rc = (self.js_ploadstring)(J, name.as_ptr(), source.as_ptr());\n498\t            if rc != 0 {\n499\t                let e = cs(\"<tostring failed>\");\n500\t                let msg = rs((self.js_trystring)(J, -1, e.as_ptr()));\n501\t                (self.js_pop)(J, 1);\n502\t                return format!(\"load-error({}) {}\", rc, msg);\n503\t            }\n504\t            (self.js_pushundefined)(J);\n505\t            let rc = (self.js_pcall)(J, 0);\n506\t            let e = cs(\"<repr failed>\");\n507\t            let out = if rc != 0 {\n508\t                let msg = rs((self.js_trystring)(J, -1, e.as_ptr()));\n509\t                format!(\"throw({}) {}\", rc, msg)\n510\t            } else {\n511\t                format!(\"ok {}\", rs((self.js_tryrepr)(J, -1, e.as_ptr())))\n512\t            };\n513\t            (self.js_pop)(J, 1);\n514\t            out\n515\t        }\n516\t    }\n517\t\n518\t    /// Run a raw-C-API sequence inside `js_pcall` so throws are caught.\n519\t    /// Returns `(rc, rendered top-of-stack)`.\n520\t    pub fn run_native(&self, act: fn(&Api, JS), flags: c_int) -> String {\n521\t        let J = self.newstate(flags);\n522\t        let s = self.run_native_in(J, act);\n523\t        unsafe { (self.js_freestate)(J) };\n524\t        s\n525\t    }\n526\t\n527\t    pub fn run_native_in(&self, J: JS, act: fn(&Api, JS)) -> String {\n528\t        CUR.with(|c| c.set(self as *const Api));\n529\t        ACT.with(|a| a.set(Some(act)));\n530\t        let _ = out_take();\n531\t        unsafe {\n532\t            let n = cs(\"native\");\n533\t            (self.js_newcfunction)(J, Some(trampoline), n.as_ptr(), 0);\n534\t            (self.js_pushundefined)(J);\n535\t            let rc = (self.js_pcall)(J, 0);\n536\t            let e = cs(\"<repr failed>\");\n537\t            let out = if rc != 0 {\n538\t                format!(\"throw({}) {}\", rc, rs((self.js_trystring)(J, -1, e.as_ptr())))\n539\t            } else {\n540\t                format!(\"ok {}\", rs((self.js_tryrepr)(J, -1, e.as_ptr())))\n541\t            };\n542\t            (self.js_pop)(J, 1);\n543\t            format!(\"emit[{}] top={} top-idx={}\", out_take(), out, (self.js_gettop)(J))\n544\t        }\n545\t    }\n546\t}\n547\t\n548\t/* -------------------------------------------------------------------------- */\n549\t/* isolated (sub-process) execution, for paths where the C library aborts,     */\n550\t/* panics or crashes: js_throw without a try, stack overflow past the panic    */\n551\t/* handler, out-of-range stack indices, ...                                    */\n552\t/* -------------------------------------------------------------------------- */\n553\t\n554\tpub fn set_cur(a: &Api) {\n555\t    CUR.with(|c| c.set(a as *const Api));\n556\t}\n557\t\n558\t/// Called at the top of the `isolated_child` test of a test binary. Returns\n559\t/// `true` when it ran as a child (the process then exits).\n560\tpub fn isolated_child_main(cases: &[(&str, fn(&Api, JS))]) -> bool {\n561\t    let case = match std::env::var(\"MUJS_CASE\") {\n562\t        Ok(c) => c,\n563\t        Err(_) => return false,\n564\t    };\n565\t    let which = std::env::var(\"MUJS_LIB\").unwrap_or_else(|_| \"C\".into());\n566\t    let flags: c_int = std::env::var(\"MUJS_FLAGS\")\n567\t        .ok()\n568\t        .and_then(|s| s.parse().ok())\n569\t        .unwrap_or(0);\n570\t    let p = libs();\n571\t    let a = if which == \"C\" { &p.c } else { &p.r };\n572\t    let f = cases\n573\t        .iter()\n574\t        .find(|(n, _)| *n == case)\n575\t        .unwrap_or_else(|| panic!(\"unknown isolated case {:?}\", case))\n576\t        .1;\n577\t    set_cur(a);\n578\t    /* cases named \"nostate_*\" create (or fail to create) the state themselves */\n579\t    let J = if case.starts_with(\"nostate_\") {\n580\t        std::ptr::null_mut()\n581\t    } else {\n582\t        a.newstate(flags)\n583\t    };\n584\t    f(a, J);\n585\t    /* if we get here the operation did not abort */\n586\t    if !J.is_null() {\n587\t        println!(\"CASE-COMPLETED top={}\", unsafe { (a.js_gettop)(J) });\n588\t        unsafe { (a.js_freestate)(J) };\n589\t    } else {\n590\t        println!(\"CASE-COMPLETED\");\n591\t    }\n592\t    println!(\"STATE-FREED\");\n593\t    unsafe {\n594\t        extern \"C\" {\n595\t            fn fflush(f: *mut c_void) -> c_int;\n596\t        }\n597\t        fflush(std::ptr::null_mut());\n598\t    }\n599\t    std::process::exit(0);\n600\t}\n601\t\n602\tfn run_child(case: &str, which: &str, flags: c_int) -> String {\n603\t    let exe = std::env::current_exe().expect(\"current_exe\");\n604\t    let out = std::process::Command::new(exe)\n605\t        .arg(\"isolated_child\")\n606\t        .arg(\"--exact\")\n607\t        .arg(\"--nocapture\")\n608\t        .arg(\"--test-threads=1\")\n609\t        .env(\"MUJS_CASE\", case)\n610\t        .env(\"MUJS_LIB\", which)\n611\t        .env(\"MUJS_FLAGS\", flags.to_string())\n612\t        .output()\n613\t        .expect(\"spawn child\");\n614\t    let mut s = String::new();\n615\t    #[cfg(unix)]\n616\t    {\n617\t        use std::os::unix::process::ExitStatusExt;\n618\t        s.push_str(&format!(\n619\t            \"code={:?} signal={:?}\\n\",\n620\t            out.status.code(),\n621\t            out.status.signal()\n622\t        ));\n623\t    }\n624\t    let stdout = String::from_utf8_lossy(&out.stdout);\n625\t    let stderr = String::from_utf8_lossy(&out.stderr);\n626\t    /* keep only the lines the library itself produced */\n627\t    for l in stdout.lines().chain(stderr.lines()) {\n628\t        /* libtest prints \"test isolated_child ... \" without a newline, so the\n629\t         * first line of real output is glued onto it: strip the prefix and keep\n630\t         * the payload instead of dropping the line. */\n631\t        let l = match l.find(\"isolated_child ... \") {\n632\t            Some(i) => &l[i + \"isolated_child ... \".len()..],\n633\t            None => l,\n634\t        };\n635\t        if l.starts_with(\"running \")\n636\t            || l.starts_with(\"test \")\n637\t            || l.starts_with(\"---- \")\n638\t            || l.is_empty()\n639\t            || l.contains(\"test result\")\n640\t            || l.contains(\"Finished\")\n641\t            || l.contains(\"Running\")\n642\t            || l.contains(\"note: \")\n643\t        {\n644\t            continue;\n645\t        }\n646\t        s.push_str(l);\n647\t        s.push('\\n');\n648\t    }\n649\t    mask_ptrs(&s)\n650\t}\n651\t\n652\t/// Run one isolated case in both libraries and assert identical\n653\t/// exit status / signal / output.\n654\t#[track_caller]\n655\tpub fn diff_isolated(case: &str, flags: c_int) {\n656\t    let c = run_child(case, \"C\", flags);\n657\t    let r = run_child(case, \"RUST\", flags);\n658\t    same(&format!(\"isolated {} flags={}\", case, flags), &c, &r);\n659\t}\n660\t\n661\t/* -------------------------------------------------------------------------- */\n662\t/* stdout capture (js_gc report, jsS_dumpstrings, js_trap all use libc stdio)  */\n663\t/* -------------------------------------------------------------------------- */\n664\t\n665\textern \"C\" {\n666\t    fn dup(fd: c_int) -> c_int;\n667\t    fn dup2(old: c_int, new: c_int) -> c_int;\n668\t    fn close(fd: c_int) -> c_int;\n669\t    fn fflush(f: *mut c_void) -> c_int;\n670\t    fn open(path: *const c_char, flags: c_int, ...) -> c_int;\n671\t}\n672\t\n673\tpub static CAPTURE_LOCK: Mutex<()> = Mutex::new(());\n674\t\n675\t/// Capture everything the callee writes to fd 1.\n676\tpub fn capture_stdout<F: FnOnce()>(f: F) -> String {\n677\t    let _g = CAPTURE_LOCK.lock().unwrap();\n678\t    let mut path = std::env::temp_dir();\n679\t    path.push(format!(\"mujs_cap_{}_{:?}.txt\", std::process::id(), std::thread::current().id()));\n680\t    let cpath = cs(path.to_str().unwrap());\n681\t    unsafe {\n682\t        fflush(std::ptr::null_mut());\n683\t        let saved = dup(1);\n684\t        /* O_WRONLY|O_CREAT|O_TRUNC = 1|64|512 on linux */\n685\t        let fd = open(cpath.as_ptr(), 1 | 64 | 512, 0o644 as c_int);\n686\t        assert!(fd >= 0, \"cannot open capture file\");\n687\t        dup2(fd, 1);\n688\t        close(fd);\n689\t        f();\n690\t        fflush(std::ptr::null_mut());\n691\t        dup2(saved, 1);\n692\t        close(saved);\n693\t    }\n694\t    let data = std::fs::read(&path).unwrap_or_default();\n695\t    let _ = std::fs::remove_file(&path);\n696\t    String::from_utf8_lossy(&data).into_owned()\n697\t}\n698\t\n699\t/* -------------------------------------------------------------------------- */\n700\t/* deterministic PRNG (fixed seed, reproducible property-style testing)        */\n701\t/* -------------------------------------------------------------------------- */\n702\t\n703\tpub struct Rng(u64);\n704\t\n705\timpl Rng {\n706\t    pub fn new(seed: u64) -> Rng {\n707\t        Rng(seed ^ 0x9E3779B97F4A7C15)\n708\t    }\n709\t    pub fn next_u64(&mut self) -> u64 {\n710\t        /* splitmix64 */\n711\t        self.0 = self.0.wrapping_add(0x9E3779B97F4A7C15);\n712\t        let mut z = self.0;\n713\t        z = (z ^ (z >> 30)).wrapping_mul(0xBF58476D1CE4E5B9);\n714\t        z = (z ^ (z >> 27)).wrapping_mul(0x94D049BB133111EB);\n715\t        z ^ (z >> 31)\n716\t    }\n717\t    pub fn u32(&mut self) -> u32 {\n718\t        self.next_u64() as u32\n719\t    }\n720\t    pub fn below(&mut self, n: u64) -> u64 {\n721\t        if n == 0 {\n722\t            0\n723\t        } else {\n724\t            self.next_u64() % n\n725\t        }\n726\t    }\n727\t    pub fn range_i64(&mut self, lo: i64, hi: i64) -> i64 {\n728\t        lo + self.below((hi - lo + 1) as u64) as i64\n729\t    }\n730\t    /// A double drawn from a distribution that covers the interesting classes.\n731\t    pub fn f64(&mut self) -> f64 {\n732\t        match self.below(12) {\n733\t            0 => 0.0,\n734\t            1 => -0.0,\n735\t            2 => f64::NAN,\n736\t            3 => f64::INFINITY,\n737\t            4 => f64::NEG_INFINITY,\n738\t            5 => self.range_i64(-1000, 1000) as f64,\n739\t            6 => self.range_i64(i32::MIN as i64, i32::MAX as i64) as f64,\n740\t            7 => f64::from_bits(self.next_u64()),\n741\t            8 => self.range_i64(-1 << 53, 1 << 53) as f64,\n742\t            9 => (self.next_u64() as f64) / (self.next_u64() as f64 + 1.0),\n743\t            10 => f64::MIN_POSITIVE * (self.below(1000) as f64),\n744\t            _ => {\n745\t                let m = self.next_u64() as f64 / (u64::MAX as f64);\n746\t                let e = self.range_i64(-300, 300) as f64;\n747\t                m * 10f64.powf(e)\n748\t            }\n749\t        }\n750\t    }\n751\t    /// A random string with a mix of ASCII, multibyte UTF-8 and escapes.\n752\t    pub fn string(&mut self, maxlen: usize) -> String {\n753\t        let n = self.below(maxlen as u64 + 1) as usize;\n754\t        let mut s = String::new();\n755\t        for _ in 0..n {\n756\t            let c = match self.below(10) {\n757\t                0..=4 => (b'a' + (self.below(26) as u8)) as char,\n758\t                5 => (b'0' + (self.below(10) as u8)) as char,\n759\t                6 => [' ', '\\t', '\\n', '\"', '\\'', '\\\\', '/', '<', '>', '&'][self.below(10) as usize],\n760\t                7 => char::from_u32(0x80 + self.u32() % 0x700).unwrap_or('\\u{80}'),\n761\t                8 => char::from_u32(0x800 + self.u32() % 0xF000).unwrap_or('\\u{800}'),\n762\t                _ => char::from_u32(0x10000 + self.u32() % 0xFFFFF).unwrap_or('\\u{10000}'),\n763\t            };\n764\t            s.push(c);\n765\t        }\n766\t        s\n767\t    }\n768\t}\n769\t\n770\t/* -------------------------------------------------------------------------- */\n771\t\n772\t/* `js_torepr`/`js_tostring` REPLACE the value at `idx` with the converted\n773\t * string (see jsrepr.c:268). These helpers observe a value without destroying\n774\t * it, by converting a copy. */\n775\tpub unsafe fn repr_at(a: &Api, J: JS, idx: c_int) -> String {\n776\t    (a.js_copy)(J, idx);\n777\t    let e = cs(\"<REPR-ERR>\");\n778\t    let s = rs((a.js_tryrepr)(J, -1, e.as_ptr()));\n779\t    (a.js_pop)(J, 1);\n780\t    s\n781\t}\n782\t\n783\tpub unsafe fn str_at(a: &Api, J: JS, idx: c_int) -> String {\n784\t    (a.js_copy)(J, idx);\n785\t    let e = cs(\"<STR-ERR>\");\n786\t    let s = rs((a.js_trystring)(J, -1, e.as_ptr()));\n787\t    (a.js_pop)(J, 1);\n788\t    s\n789\t}\n790\t\n791\t/// Replace `0x...` hex addresses (js_ref names, js_trap dumps) with a marker:\n792\t/// heap addresses legitimately differ between the two libraries.\n793\tpub fn mask_ptrs(s: &str) -> String {\n794\t    let mut out = String::new();\n795\t    let mut it = s.chars().peekable();\n796\t    while let Some(c) = it.next() {\n797\t        if c == '0' && it.peek() == Some(&'x') {\n798\t            it.next();\n799\t            let mut n = 0;\n800\t            while it.peek().map_or(false, |c| c.is_ascii_hexdigit()) {\n801\t                it.next();\n802\t                n += 1;\n803\t            }\n804\t            if n > 0 {\n805\t                out.push_str(\"0xPTR\");\n806\t            } else {\n807\t                out.push_str(\"0x\");\n808\t            }\n809\t        } else {\n810\t            out.push(c);\n811\t        }\n812\t    }\n813\t    out\n814\t}\n815\t\n816\t/// Assert both libraries agree, with a readable diff.\n817\t#[track_caller]\n818\tpub fn same(label: &str, c: &str, r: &str) {\n819\t    if c != r {\n820\t        panic!(\n821\t            \"DIVERGENCE [{}]\\n  C   : {:?}\\n  RUST: {:?}\",\n822\t            label, c, r\n823\t        );\n824\t    }\n825\t}\n826\t\n827\t/// Run the same JS source through both libraries and compare.\n828\t#[track_caller]\n829\tpub fn diff_eval(label: &str, src: &str, flags: c_int) {\n830\t    let p = libs();\n831\t    let c = p.c.eval(src, flags);\n832\t    let r = p.r.eval(src, flags);\n833\t    same(&format!(\"{} | flags={} | src={:?}\", label, flags, src), &c, &r);\n834\t}\n835\t\n836\t/// Run the same native action through both libraries and compare.\n837\t#[track_caller]\n838\tpub fn diff_native(label: &str, act: fn(&Api, JS), flags: c_int) {\n839\t    let p = libs();\n840\t    let c = p.c.run_native(act, flags);\n841\t    let r = p.r.run_native(act, flags);\n842\t    same(&format!(\"{} | flags={}\", label, flags), &c, &r);\n843\t}\n844\t"}]},"parent_tool_use_id":"toolu_bdrk_018kW2aRAMNFNM6KCEPPBgpx","session_id":"2be16944-0c16-4bac-97a9-ffb5f1a29386","uuid":"47a6c088-3c8f-4cc8-9d99-70af296f5bb9","timestamp":"2026-09-04T04:59:46.376Z","subagent_type":"general-purpose","task_description":"Phase C syntax error tests"}
