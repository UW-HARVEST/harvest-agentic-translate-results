9\t            }\n270\t        }\n271\t        diff_native(&format!(\"rotN op={}\", op), act, 0);\n272\t    }\n273\t}\n274\t\n275\t/* rows 192 + 298: stackidx() masks every out-of-range index as `undefined` */\n276\t#[test]\n277\tfn r192_r298_stackidx_out_of_range() {\n278\t    fn act(a: &Api, J: JS) {\n279\t        unsafe {\n280\t            (a.js_pushnumber)(J, 7.0);\n281\t            (a.js_pushstring)(J, cs(\"s\").as_ptr());\n282\t            let e = cs(\"<E>\");\n283\t            for idx in [-1000i64, -100, -4, -3, -2, -1, 0, 1, 2, 3, 50, 99, 4095, 100000] {\n284\t                let i = idx as c_int;\n285\t                emit(&format!(\n286\t                    \"idx={} type={} typeof={} undef={} def={} tryi={} tryn={:#x} trys={:?} tryr={:?} tob={}\",\n287\t                    idx,\n288\t                    (a.js_type)(J, i),\n289\t                    rs((a.js_typeof)(J, i)),\n290\t                    (a.js_isundefined)(J, i),\n291\t                    (a.js_isdefined)(J, i),\n292\t                    (a.js_tryinteger)(J, i, -7),\n293\t                    (a.js_trynumber)(J, i, -7.5).to_bits(),\n294\t                    rs((a.js_trystring)(J, i, e.as_ptr())),\n295\t                    rs((a.js_tryrepr)(J, i, e.as_ptr())),\n296\t                    (a.js_toboolean)(J, i),\n297\t                ));\n298\t                emit(&format!(\"tonum={:#x}\", (a.js_tonumber)(J, i).to_bits()));\n299\t                /* js_copy of an out-of-range slot yields the shared undefined */\n300\t                (a.js_copy)(J, i);\n301\t                emit(&format!(\"copy={}\", repr_at(a, J, -1)));\n302\t                (a.js_pop)(J, 1);\n303\t            }\n304\t            dump(a, J);\n305\t            (a.js_pushnumber)(J, 0.0);\n306\t        }\n307\t    }\n308\t    for f in [0, JS_STRICT] {\n309\t        diff_native(\"stackidx-oob\", act, f);\n310\t    }\n311\t}\n312\t\n313\t/* ========================================================================== */\n314\t/* rows 171, 179-189, 201-203: CHECKSTACK -> \"stack overflow\"                  */\n315\t/* ========================================================================== */\n316\t\n317\tstatic LIT: &[u8] = b\"literal\\0\";\n318\t\n319\t#[test]\n320\tfn r171_checkstack_overflow_every_push() {\n321\t    /* 0..=15 selects which pushing primitive is hammered until CHECKSTACK fires */\n322\t    for op in 0i64..16 {\n323\t        set_pi(0, op);\n324\t        fn act(a: &Api, J: JS) {\n325\t            unsafe {\n326\t                let long = cs(\"0123456789ABCDEF-a-memstr-not-a-shrstr\");\n327\t                let short = cs(\"s\");\n328\t                for k in 0..6000 {\n329\t                    if k % 1024 == 0 {\n330\t                        emit(&format!(\"k={} top={}\", k, (a.js_gettop)(J)));\n331\t                    }\n332\t                    match pi(0) {\n333\t                        0 => (a.js_pushundefined)(J),\n334\t                        1 => (a.js_pushnull)(J),\n335\t                        2 => (a.js_pushboolean)(J, 1),\n336\t                        3 => (a.js_pushnumber)(J, k as f64),\n337\t                        4 => (a.js_pushstring)(J, short.as_ptr()),\n338\t                        5 => (a.js_pushstring)(J, long.as_ptr()),\n339\t                        6 => (a.js_pushliteral)(J, LIT.as_ptr() as *const c_char),\n340\t                        7 => (a.js_pushlstring)(J, long.as_ptr(), 4),\n341\t                        8 => (a.js_newobject)(J),\n342\t                        9 => (a.js_newarray)(J),\n343\t                        10 => (a.js_copy)(J, 0),\n344\t                        11 => (a.js_dup)(J),\n345\t                        12 => (a.js_dup2)(J),\n346\t                        13 => (a.js_currentfunction)(J),\n347\t                        14 => (a.js_pushglobal)(J),\n348\t                        _ => (a.js_newnumber)(J, k as f64),\n349\t                    }\n350\t                }\n351\t                emit(\"no-overflow\");\n352\t                (a.js_pushnumber)(J, 0.0);\n353\t            }\n354\t        }\n355\t        let p = libs();\n356\t        let c = p.c.run_native(act, 0);\n357\t        let r = p.r.run_native(act, 0);\n358\t        same(&format!(\"checkstack op={}\", op), &c, &r);\n359\t        assert!(c.contains(\"stack overflow\"), \"op={}: {}\", op, c);\n360\t    }\n361\t}\n362\t\n363\t/* rows 178 + 180: JS_STRLIMIT on js_pushstring / js_pushlstring.\n364\t * js_pushlstring checks `n` BEFORE touching the buffer, so the limit is\n365\t * reachable with a tiny buffer and a huge length. */\n366\t#[test]\n367\tfn r180_pushlstring_invalid_string_length() {\n368\t    /* Only two classes of `n` are legal to pass:\n369\t     *   - n <= the real buffer length (the copy stays in bounds), and\n370\t     *   - n > JS_STRLIMIT, which is rejected *before* the buffer is touched.\n371\t     * Anything in between (e.g. n == 1<<28, or a negative n) makes the C\n372\t     * memcpy/`while (n--)` loop run off the end of the buffer — a genuine\n373\t     * out-of-bounds read in both libraries, so it is not exercised here. */\n374\t    for n in [0i64, 1, 4, (1 << 28) + 1, (1 << 29) + 7, i32::MAX as i64] {\n375\t        set_pi(0, n);\n376\t        fn act(a: &Api, J: JS) {\n377\t            unsafe {\n378\t                let buf = cs(\"abcd\");\n379\t                (a.js_pushlstring)(J, buf.as_ptr(), pic(0));\n380\t                emit(&format!(\n381\t                    \"pushed len={} repr={}\",\n382\t                    (a.js_getlength)(J, -1),\n383\t                    repr_at(a, J, -1)\n384\t                ));\n385\t                (a.js_pop)(J, 1);\n386\t                (a.js_pushnumber)(J, 0.0);\n387\t            }\n388\t        }\n389\t        let p = libs();\n390\t        let c = p.c.run_native(act, 0);\n391\t        let r = p.r.run_native(act, 0);\n392\t        same(&format!(\"js_pushlstring n={}\", n), &c, &r);\n393\t        if n > (1 << 28) {\n394\t            assert!(\n395\t                c.contains(\"invalid string length\"),\n396\t                \"expected RangeError for n={}, got {}\",\n397\t                n,\n398\t                c\n399\t            );\n400\t        }\n401\t    }\n402\t}\n403\t\n404\t/* rows 178 + 320: a real >2^28 byte string for js_pushstring / js_intern.\n405\t * Allocates ~256 MiB once and shares it between both libraries. */\n406\tfn huge_string() -> &'static CString {\n407\t    use std::sync::OnceLock;\n408\t    static S: OnceLock<CString> = OnceLock::new();\n409\t    S.get_or_init(|| {\n410\t        let n = (1usize << 28) + 8;\n411\t        CString::new(vec![b'a'; n]).unwrap()\n412\t    })\n413\t}\n414\t\n415\t#[test]\n416\tfn r178_r320_strlimit_pushstring_and_intern() {\n417\t    fn act(a: &Api, J: JS) {\n418\t        unsafe {\n419\t            let s = huge_string();\n420\t            match pi(0) {\n421\t                0 => {\n422\t                    (a.js_pushstring)(J, s.as_ptr());\n423\t                    emit(\"pushstring-ok\");\n424\t                    (a.js_pop)(J, 1);\n425\t                }\n426\t                _ => {\n427\t                    let p = (a.js_intern)(J, s.as_ptr());\n428\t                    emit(&format!(\"intern-ok null={}\", p.is_null()));\n429\t                }\n430\t            }\n431\t            (a.js_pushnumber)(J, 0.0);\n432\t        }\n433\t    }\n434\t    for op in 0i64..2 {\n435\t        set_pi(0, op);\n436\t        let p = libs();\n437\t        let c = p.c.run_native(act, 0);\n438\t        let r = p.r.run_native(act, 0);\n439\t        same(&format!(\"strlimit op={}\", op), &c, &r);\n440\t        assert!(c.contains(\"invalid string length\"), \"op={}: {}\", op, c);\n441\t    }\n442\t}\n443\t\n444\t/* ========================================================================== */\n445\t/* rows 245, 246: JS_ENVLIMIT — deep JS recursion                              */\n446\t/* ========================================================================== */\n447\t\n448\t#[test]\n449\tfn r245_r246_deep_recursion_limits() 