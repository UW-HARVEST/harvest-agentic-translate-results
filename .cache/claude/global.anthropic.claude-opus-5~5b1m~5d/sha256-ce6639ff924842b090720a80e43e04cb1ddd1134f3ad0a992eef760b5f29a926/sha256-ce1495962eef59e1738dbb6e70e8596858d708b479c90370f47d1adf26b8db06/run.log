{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_018u5YSQHaXcP7cn7Eda5JyD","type":"tool_result","content":"1\t//! Phase C — error paths that ABORT, panic or otherwise terminate the process\n2\t//! (uncaught js_throw, stack under/overflow, unimplemented API, allocator\n3\t//! failure). Each case runs in a fresh child process for BOTH libraries and the\n4\t//! exit code, signal and output must match exactly.\n5\t#![allow(non_snake_case)]\n6\t\n7\tmod common;\n8\tuse common::*;\n9\tuse std::ffi::{c_char, c_int, c_void};\n10\t\n11\t/* ---------------------------------------------------------------- cases */\n12\t\n13\tfn c_throw_no_try(a: &Api, J: JS) {\n14\t    unsafe {\n15\t        (a.js_newerror)(J, cs(\"boom\").as_ptr());\n16\t        (a.js_throw)(J);\n17\t    }\n18\t}\n19\t\n20\tfn c_error_no_try(a: &Api, J: JS) {\n21\t    unsafe {\n22\t        /* js_pop underflow raises js_error with no enclosing try */\n23\t        (a.js_pop)(J, 100);\n24\t    }\n25\t}\n26\t\n27\tfn c_pop_negative(a: &Api, J: JS) {\n28\t    unsafe {\n29\t        (a.js_pushnumber)(J, 1.0);\n30\t        (a.js_pop)(J, -5);\n31\t        println!(\"top={}\", (a.js_gettop)(J));\n32\t    }\n33\t}\n34\t\n35\tfn c_stack_overflow(a: &Api, J: JS) {\n36\t    unsafe {\n37\t        for i in 0..8000 {\n38\t            (a.js_pushnumber)(J, i as f64);\n39\t        }\n40\t        println!(\"pushed all\");\n41\t    }\n42\t}\n43\t\n44\tfn c_insert_notimpl(a: &Api, J: JS) {\n45\t    unsafe {\n46\t        (a.js_pushnumber)(J, 1.0);\n47\t        (a.js_pushnumber)(J, 2.0);\n48\t        (a.js_insert)(J, -2);\n49\t        println!(\"inserted\");\n50\t    }\n51\t}\n52\t\n53\tfn c_copy_oob(a: &Api, J: JS) {\n54\t    unsafe {\n55\t        (a.js_copy)(J, 1000);\n56\t        (a.js_copy)(J, -1000);\n57\t        println!(\"top={} undef={}\", (a.js_gettop)(J), (a.js_isundefined)(J, -1));\n58\t    }\n59\t}\n60\t\n61\tfn c_remove_oob(a: &Api, J: JS) {\n62\t    unsafe {\n63\t        (a.js_pushnumber)(J, 1.0);\n64\t        (a.js_remove)(J, 900);\n65\t        println!(\"removed top={}\", (a.js_gettop)(J));\n66\t    }\n67\t}\n68\t\n69\tfn c_replace_oob(a: &Api, J: JS) {\n70\t    unsafe {\n71\t        (a.js_pushnumber)(J, 1.0);\n72\t        (a.js_replace)(J, 900);\n73\t        println!(\"replaced top={}\", (a.js_gettop)(J));\n74\t    }\n75\t}\n76\t\n77\tfn c_rot_underflow(a: &Api, J: JS) {\n78\t    unsafe {\n79\t        (a.js_rot)(J, 5);\n80\t        println!(\"rot done top={}\", (a.js_gettop)(J));\n81\t    }\n82\t}\n83\t\n84\tfn c_endtry_underflow(a: &Api, J: JS) {\n85\t    unsafe {\n86\t        (a.js_endtry)(J);\n87\t        println!(\"endtry done\");\n88\t    }\n89\t}\n90\t\n91\tfn c_getglobal_uncaught(a: &Api, J: JS) {\n92\t    unsafe {\n93\t        /* js_getproperty on a primitive: throws with no try installed */\n94\t        (a.js_pushundefined)(J);\n95\t        (a.js_getproperty)(J, -1, cs(\"x\").as_ptr());\n96\t        println!(\"got\");\n97\t    }\n98\t}\n99\t\n100\tfn c_gc_report_fresh(a: &Api, J: JS) {\n101\t    unsafe {\n102\t        (a.js_gc)(J, 1);\n103\t        println!(\"gc done\");\n104\t    }\n105\t}\n106\t\n107\tfn c_dostring_syntax_error(a: &Api, J: JS) {\n108\t    unsafe {\n109\t        let rc = (a.js_dostring)(J, cs(\"var 1\").as_ptr());\n110\t        println!(\"dostring={}\", rc);\n111\t        let rc = (a.js_dostring)(J, cs(\"throw 1\").as_ptr());\n112\t        println!(\"dostring2={}\", rc);\n113\t    }\n114\t}\n115\t\n116\tfn c_report_default(a: &Api, J: JS) {\n117\t    unsafe {\n118\t        /* the default report handler writes to stderr */\n119\t        (a.js_report)(J, cs(\"a report message\").as_ptr());\n120\t        (a.js_setreport)(J, None);\n121\t        (a.js_report)(J, cs(\"second message\").as_ptr());\n122\t        println!(\"reported\");\n123\t    }\n124\t}\n125\t\n126\t/* allocator that always fails: js_newstate must handle it */\n127\tunsafe extern \"C\" fn null_alloc(_ctx: *mut c_void, _p: *mut c_void, _n: c_int) -> *mut c_void {\n128\t    std::ptr::null_mut()\n129\t}\n130\t\n131\t/* allocator that only serves the first N requests */\n132\tstatic mut BUDGET: c_int = 3;\n133\tunsafe extern \"C\" fn budget_alloc(_ctx: *mut c_void, p: *mut c_void, n: c_int) -> *mut c_void {\n134\t    extern \"C\" {\n135\t        fn realloc(p: *mut c_void, n: usize) -> *mut c_void;\n136\t        fn free(p: *mut c_void);\n137\t    }\n138\t    if n == 0 {\n139\t        free(p);\n140\t        return std::ptr::null_mut();\n141\t    }\n142\t    if BUDGET <= 0 {\n143\t        return std::ptr::null_mut();\n144\t    }\n145\t    BUDGET -= 1;\n146\t    realloc(p, n as usize)\n147\t}\n148\t\n149\tfn c_nostate_null_alloc(a: &Api, _J: JS) {\n150\t    unsafe {\n151\t        let J = (a.js_newstate)(Some(null_alloc), std::ptr::null_mut(), 0);\n152\t        println!(\"newstate_null_alloc_is_null={}\", J.is_null());\n153\t    }\n154\t}\n155\t\n156\tfn c_nostate_budget_alloc(a: &Api, _J: JS) {\n157\t    unsafe {\n158\t        BUDGET = 3;\n159\t        let J = (a.js_newstate)(Some(budget_alloc), std::ptr::null_mut(), 0);\n160\t        println!(\"newstate_budget_is_null={}\", J.is_null());\n161\t    }\n162\t}\n163\t\n164\tfn c_nostate_flags(a: &Api, _J: JS) {\n165\t    unsafe {\n166\t        for f in [0, 1, 2, -1, 0x7fffffff] {\n167\t            let J = (a.js_newstate)(None, std::ptr::null_mut(), f);\n168\t            println!(\"flags={} null={}\", f, J.is_null());\n169\t            if !J.is_null() {\n170\t                (a.js_freestate)(J);\n171\t            }\n172\t        }\n173\t    }\n174\t}\n175\t\n176\tfn c_memlimit_tiny(a: &Api, J: JS) {\n177\t    unsafe {\n178\t        (a.js_setlimit)(J, 0, 1);\n179\t        let rc = (a.js_dostring)(J, cs(\"var a = []; for (var i=0;i<1000;i++) a[i]=i;\").as_ptr());\n180\t        println!(\"dostring={}\", rc);\n181\t    }\n182\t}\n183\t\n184\tfn c_runlimit_one(a: &Api, J: JS) {\n185\t    unsafe {\n186\t        (a.js_setlimit)(J, 1, 0);\n187\t        let rc = (a.js_dostring)(J, cs(\"var i=0; while(i<10) i++;\").as_ptr());\n188\t        println!(\"dostring={}\", rc);\n189\t    }\n190\t}\n191\t\n192\tfn c_deep_recursion(a: &Api, J: JS) {\n193\t    unsafe {\n194\t        let rc = (a.js_dostring)(J, cs(\"function f(n){ return n<=0 ? 0 : 1+f(n-1) } f(2000)\").as_ptr());\n195\t        println!(\"dostring={}\", rc);\n196\t    }\n197\t}\n198\t\n199\tfn c_deep_try(a: &Api, J: JS) {\n200\t    unsafe {\n201\t        let rc = (a.js_dostring)(\n202\t            J,\n203\t            cs(\"function f(n){ try { return n<=0 ? 0 : 1+f(n-1) } catch(e) { throw e } } f(200)\")\n204\t                .as_ptr(),\n205\t        );\n206\t        println!(\"dostring={}\", rc);\n207\t    }\n208\t}\n209\t\n210\tfn c_array_limit(a: &Api, J: JS) {\n211\t    unsafe {\n212\t        let rc = (a.js_dostring)(J, cs(\"var a=[]; a.length = 1<<27; a.length\").as_ptr());\n213\t        println!(\"dostring={}\", rc);\n214\t        let rc = (a.js_dostring)(J, cs(\"var a=[]; a[1<<27]=1;\").as_ptr());\n215\t        println!(\"dostring2={}\", rc);\n216\t    }\n217\t}\n218\t\n219\tfn c_uncaught_typeerror_in_ctor(a: &Api, J: JS) {\n220\t    unsafe {\n221\t        (a.js_pushnumber)(J, 1.0);\n222\t        (a.js_construct)(J, 0);\n223\t        println!(\"constructed\");\n224\t    }\n225\t}\n226\t\n227\tfn c_call_noncallable(a: &Api, J: JS) {\n228\t    unsafe {\n229\t        (a.js_pushnumber)(J, 1.0);\n230\t        (a.js_pushundefined)(J);\n231\t        (a.js_call)(J, 0);\n232\t        println!(\"called\");\n233\t    }\n234\t}\n235\t\n236\tfn c_concat_uncaught(a: &Api, J: JS) {\n237\t    unsafe {\n238\t        /* js_concat on values whose toString throws */\n239\t        let rc = (a.js_dostring)(\n240\t            J,\n241\t            cs(\"var o = { toString: function(){ throw new Error('ts') } }; o + ''\").as_ptr(),\n242\t        );\n243\t        println!(\"dostring={}\", rc);\n244\t    }\n245\t}\n246\t\n247\tfn c_setlength_negative(a: &Api, J: JS) {\n248\t    unsafe {\n249\t        (a.js_newarray)(J);\n250\t        (a.js_setlength)(J, -1, -1);\n251\t        println!(\"len={}\", (a.js_getlength)(J, -1));\n252\t    }\n253\t}\n254\t\n255\tstatic CASES: &[(&str, fn(&Api, JS))] = &[\n256\t    (\"throw_no_try\", c_throw_no_try),\n257\t    (\"error_no_try\", c_error_no_try),\n258\t    (\"pop_negative\", c_pop_negative),\n259\t    (\"stack_overflow\", c_stack_overflow),\n260\t    (\"insert_notimpl\", c_insert_notimpl),\n261\t    (\"copy_oob\", c_copy_oob),\n262\t    (\"remove_oob\", c_remove_oob),\n263\t    (\"replace_oob\", c_replace_oob),\n264\t    (\"rot_underflow\", c_rot_underflow),\n265\t    (\"endtry_underflow\", c_endtry_underflow),\n266\t    (\"getglobal_uncaught\", c_getglobal_uncaught),\n267\t    (\"gc_report_fresh\", c_gc_report_fresh),\n268\t    (\"dostring_syntax_error\", c_dostring_syntax_error),\n269\t    (\"report_default\", c_report_default),\n270\t    (\"nostate_null_alloc\", c_nostate_null_alloc),\n271\t    (\"nostate_budget_alloc\", c_nostate_budget_alloc),\n272\t    (\"nostate_flags\", c_nostate_flags),\n273\t    (\"memlimit_tiny\", c_memlimit_tiny),\n274\t    (\"runlimit_one\", c_runlimit_one),\n275\t    (\"deep_recursion\", c_deep_recursion),\n276\t    (\"deep_try\", c_deep_try),\n277\t    (\"array_limit\", c_array_limit),\n278\t    (\"uncaught_typeerror_in_ctor\", c_uncaught_typeerror_in_ctor),\n279\t    (\"call_noncallable\", c_call_noncallable),\n280\t    (\"concat_uncaught\", c_concat_uncaught),\n281\t    (\"setlength_negative\", c_setlength_negative),\n282\t];\n283\t\n284\t/* The child entry point: dispatches one case for one library, then exits. */\n285\t#[test]\n286\tfn isolated_child() {\n287\t    let _ = isolated_child_main(CASES);\n288\t}\n289\t\n290\t#[test]\n291\tfn all_isolated_cases_match() {\n292\t    if std::env::var(\"MUJS_CASE\").is_ok() {\n293\t        return; /* we are the child */\n294\t    }\n295\t    for (name, _) in CASES {\n296\t        for flags in [0, JS_STRICT] {\n297\t            diff_isolated(name, flags);\n298\t     