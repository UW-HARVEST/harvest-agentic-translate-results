ifferential\n/// check is then on the SyntaxError text itself).\nconst PARSE_ERROR_OK: [&str; 3] = [\n    \"({a:1,a:2})\",\n    \"({get a(){return 1},get a(){return 2}})\",\n    \"({a:1,'a':2})\",\n];\n\n/// Every source in `srcs` under both flag settings, with the same\n/// \"it really compiled\" self-check as `diff_ok` (only at `flags == 0`: several\n/// sources are deliberately rejected by the strict-mode parser).\n#[track_caller]\nfn diff_each(label: &str, srcs: &[&str]) {\n    let p = libs();\n    for f in [0, JS_STRICT] {\n        for s in srcs {\n            let c = p.c.eval(s, f);\n            let r = p.r.eval(s, f);\n            same(&format!(\"{} | flags={} | src={:?}\", label, f, s), &c, &r);\n            if f == 0 && c.starts_with(\"load-error\") && !PARSE_ERROR_OK.contains(s) {\n                panic!(\"[{}] hand-written source does not compile: {:?} -> {}\", label, s, c);\n            }\n        }\n    }\n}''')\n\nrep('''            diff_eval(\"case sweep\", &src, f);''','''            diff_ok(\"case sweep\", &src, f);''')\nopen(p,'w').write(s)\nprint('ok')\nPY\ntimeout 900 cargo test --release --offline --test phase_b_script -- --test-threads=1 2>&1 | tail -50"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6999,"cache_read_input_tokens":160820,"cache_creation":{"ephemeral_5m_input_tokens":6999,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_01UrTSzcsB8tDakT2p1ypBEu","session_id":"2be16944-0c16-4bac-97a9-ffb5f1a29386","uuid":"a5882f9f-7e73-45fc-91bb-90bffb772220","timestamp":"2026-09-04T05:18:30.405Z","subagent_type":"general-purpose","task_description":"Phase B script-level config tests"}
