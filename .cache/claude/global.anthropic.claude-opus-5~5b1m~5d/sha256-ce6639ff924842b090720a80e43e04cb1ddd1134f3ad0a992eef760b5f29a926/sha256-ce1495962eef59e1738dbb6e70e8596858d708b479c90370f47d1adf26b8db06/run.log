{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01LbxctDfMn4Artg5eZEEngt","type":"tool_result","content":"1\t//! Differential-test harness.\n2\t//!\n3\t//! Loads BOTH shared libraries through `libloading` and calls them only through\n4\t//! their exported C symbols, exactly as an external consumer would:\n5\t//!\n6\t//!   * C:    `c_src/build/libmujs.so`\n7\t//!   * Rust: `translation/target/<profile>/libmujs.so`\n8\t//!\n9\t//! Nothing in this file calls a Rust function of the crate directly.\n10\t#![allow(dead_code)]\n11\t#![allow(non_snake_case)]\n12\t\n13\tuse libloading::{Library, Symbol};\n14\tuse std::cell::Cell;\n15\tuse std::ffi::{c_char, c_int, c_short, c_uint, c_ushort, c_void, CStr, CString};\n16\tuse std::path::PathBuf;\n17\tuse std::sync::Mutex;\n18\t\n19\tpub type JS = *mut c_void;\n20\tpub type Obj = *mut c_void;\n21\tpub type Prop = *mut c_void;\n22\tpub type Prog = *mut c_void;\n23\tpub type CFun = unsafe extern \"C\" fn(JS);\n24\tpub type Alloc = unsafe extern \"C\" fn(*mut c_void, *mut c_void, c_int) -> *mut c_void;\n25\tpub type Finalize = unsafe extern \"C\" fn(JS, *mut c_void);\n26\tpub type HasProp = unsafe extern \"C\" fn(JS, *mut c_void, *const c_char) -> c_int;\n27\tpub type PutProp = unsafe extern \"C\" fn(JS, *mut c_void, *const c_char) -> c_int;\n28\tpub type DelProp = unsafe extern \"C\" fn(JS, *mut c_void, *const c_char) -> c_int;\n29\tpub type Report = unsafe extern \"C\" fn(JS, *const c_char);\n30\tpub type Panic = unsafe extern \"C\" fn(JS);\n31\t\n32\t/* mujs.h constants */\n33\tpub const JS_STRICT: c_int = 1;\n34\tpub const JS_REGEXP_G: c_int = 1;\n35\tpub const JS_REGEXP_I: c_int = 2;\n36\tpub const JS_REGEXP_M: c_int = 4;\n37\tpub const JS_READONLY: c_int = 1;\n38\tpub const JS_DONTENUM: c_int = 2;\n39\tpub const JS_DONTCONF: c_int = 4;\n40\tpub const REG_ICASE: c_int = 1;\n41\tpub const REG_NEWLINE: c_int = 2;\n42\tpub const REG_NOTBOL: c_int = 4;\n43\tpub const REG_MAXSUB: usize = 16;\n44\t\n45\t#[repr(C)]\n46\t#[derive(Clone, Copy)]\n47\tpub struct ResubOne {\n48\t    pub sp: *const c_char,\n49\t    pub ep: *const c_char,\n50\t}\n51\t#[repr(C)]\n52\t#[derive(Clone, Copy)]\n53\tpub struct Resub {\n54\t    pub nsub: c_int,\n55\t    pub sub: [ResubOne; REG_MAXSUB],\n56\t}\n57\timpl Default for Resub {\n58\t    fn default() -> Self {\n59\t        Resub {\n60\t            nsub: 0,\n61\t            sub: [ResubOne {\n62\t                sp: std::ptr::null(),\n63\t                ep: std::ptr::null(),\n64\t            }; REG_MAXSUB],\n65\t        }\n66\t    }\n67\t}\n68\t\n69\tmacro_rules! api {\n70\t    ( $( $name:ident : $t:ty ),* $(,)? ) => {\n71\t        pub struct Api {\n72\t            pub tag: &'static str,\n73\t            $( pub $name : $t, )*\n74\t            _lib: Library,\n75\t        }\n76\t        impl Api {\n77\t            pub fn load(tag: &'static str, path: &std::path::Path) -> Api {\n78\t                let lib = unsafe { Library::new(path) }\n79\t                    .unwrap_or_else(|e| panic!(\"cannot dlopen {}: {}\", path.display(), e));\n80\t                let a = Api {\n81\t                    tag,\n82\t                    $( $name : unsafe {\n83\t                        let s: Symbol<$t> = lib\n84\t                            .get(concat!(stringify!($name), \"\\0\").as_bytes())\n85\t                            .unwrap_or_else(|e| panic!(\"{}: missing symbol {}: {}\", path.display(), stringify!($name), e));\n86\t                        *s\n87\t                    }, )*\n88\t                    _lib: lib,\n89\t                };\n90\t                a\n91\t            }\n92\t        }\n93\t    };\n94\t}\n95\t\n96\tapi! {\n97\t    /* ---- state ---- */\n98\t    js_newstate: unsafe extern \"C\" fn(Option<Alloc>, *mut c_void, c_int) -> JS,\n99\t    js_freestate: unsafe extern \"C\" fn(JS),\n100\t    js_setcontext: unsafe extern \"C\" fn(JS, *mut c_void),\n101\t    js_getcontext: unsafe extern \"C\" fn(JS) -> *mut c_void,\n102\t    js_setreport: unsafe extern \"C\" fn(JS, Option<Report>),\n103\t    js_atpanic: unsafe extern \"C\" fn(JS, Option<Panic>) -> Option<Panic>,\n104\t    js_gc: unsafe extern \"C\" fn(JS, c_int),\n105\t    js_setlimit: unsafe extern \"C\" fn(JS, c_int, c_int),\n106\t    js_report: unsafe extern \"C\" fn(JS, *const c_char),\n107\t    js_trap: unsafe extern \"C\" fn(JS, c_int),\n108\t\n109\t    /* ---- eval ---- */\n110\t    js_dostring: unsafe extern \"C\" fn(JS, *const c_char) -> c_int,\n111\t    js_ploadstring: unsafe extern \"C\" fn(JS, *const c_char, *const c_char) -> c_int,\n112\t    js_loadstring: unsafe extern \"C\" fn(JS, *const c_char, *const c_char),\n113\t    js_loadeval: unsafe extern \"C\" fn(JS, *const c_char, *const c_char),\n114\t    js_pcall: unsafe extern \"C\" fn(JS, c_int) -> c_int,\n115\t    js_pconstruct: unsafe extern \"C\" fn(JS, c_int) -> c_int,\n116\t    js_call: unsafe extern \"C\" fn(JS, c_int),\n117\t    js_construct: unsafe extern \"C\" fn(JS, c_int),\n118\t    js_eval: unsafe extern \"C\" fn(JS),\n119\t\n120\t    /* ---- errors ---- */\n121\t    js_newerror: unsafe extern \"C\" fn(JS, *const c_char),\n122\t    js_newevalerror: unsafe extern \"C\" fn(JS, *const c_char),\n123\t    js_newrangeerror: unsafe extern \"C\" fn(JS, *const c_char),\n124\t    js_newreferenceerror: unsafe extern \"C\" fn(JS, *const c_char),\n125\t    js_newsyntaxerror: unsafe extern \"C\" fn(JS, *const c_char),\n126\t    js_newtypeerror: unsafe extern \"C\" fn(JS, *const c_char),\n127\t    js_newurierror: unsafe extern \"C\" fn(JS, *const c_char),\n128\t    js_throw: unsafe extern \"C\" fn(JS),\n129\t    js_savetry: unsafe extern \"C\" fn(JS) -> *mut c_void,\n130\t    js_savetrypc: unsafe extern \"C\" fn(JS, *mut c_void) -> *mut c_void,\n131\t    js_endtry: unsafe extern \"C\" fn(JS),\n132\t\n133\t    /* ---- registry / refs / globals ---- */\n134\t    js_ref: unsafe extern \"C\" fn(JS) -> *const c_char,\n135\t    js_unref: unsafe extern \"C\" fn(JS, *const c_char),\n136\t    js_ge