oLocaleTimeString\",\n    ];\n    for _ in 0..220 {\n        /* a millisecond value biased towards the legal +-8.64e15 window */\n        let t = if rng.below(2) == 0 {\n            rng.range_i64(-8_640_000_000_000_100, 8_640_000_000_000_100) as f64\n        } else {\n            rng.f64()\n        };\n        let ts = jsnum(t);\n        let s = setters[rng.below(setters.len() as u64) as usize];\n        let g = getters[rng.below(getters.len() as u64) as usize];\n        let f = fmts[rng.below(fmts.len() as u64) as usize];\n        let v = jsnum(rng.f64());\n        ev(\"rnd_d_get\", &format!(\"new Date({}).{}()\", ts, g));\n        ev(\"rnd_d_fmt\", &format!(\"new Date({}).{}()\", ts, f));\n        ev(\n            \"rnd_d_iso\",\n            &format!(\"try {{ new Date({}).toISOString() }} catch (e) {{ String(e) }}\", ts),\n        );\n        ev(\"rnd_d_json\", &format!(\"JSON.stringify(new Date({}))\", ts));\n        ev(\n            \"rnd_d_set\",\n            &format!(\"var d=new Date({}); d.{}({}); d.getTime()\", ts, s, v),\n        );\n        ev(\n            \"rnd_d_set_multi\",\n            &format!(\"var d=new Date({}); d.{}({}, {}); d.getTime()\", ts, s, v, v),\n        );\n        ev(\n            \"rnd_d_ctor\",\n            &format!(\"new Date({}, {}).getTime()\", jsnum(rng.f64()), jsnum(rng.f64())),\n        );\n        ev(\n            \"rnd_d_utc\",\n            &format!(\n                \"Date.UTC({}, {}, {}, {})\",\n                jsnum(rng.f64()),\n                jsnum(rng.f64()),\n                jsnum(rng.f64()),\n                jsnum(rng.f64())\n            ),\n        );\n        /* structured, mostly-plausible ISO strings with random field values */\n        let iso = format!(\n            \"{:04}-{:02}-{:02}T{:02}:{:02}:{:02}.{:03}{}\",\n            rng.range_i64(0, 9999),\n            rng.range_i64(0, 20),\n            rng.range_i64(0, 40),\n            rng.range_i64(0, 30),\n            rng.range_i64(0, 70),\n            rng.range_i64(0, 70),\n            rng.range_i64(0, 999),\n            [\"\", \"Z\", \"+01:00\", \"-05:30\", \"+24:00\", \"x\"][rng.below(6) as usize]\n        );\n        ev(\"rnd_d_parse\", &format!(\"Date.parse({})\", jsstr(&iso)));\n        ev(\n            \"rnd_d_parse_trunc\",\n            &format!(\"Date.parse({})\", jsstr(&iso[..1 + rng.below(iso.len() as u64) as usize])),\n        );\n    }\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2224,"cache_read_input_tokens":113073,"cache_creation":{"ephemeral_5m_input_tokens":2224,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_012gQ5jbjZW4mxgkHJC7hDEY","session_id":"2be16944-0c16-4bac-97a9-ffb5f1a29386","uuid":"c8e75840-8a6e-4240-9c36-e045d242c6c2","timestamp":"2026-09-04T05:10:42.410Z","subagent_type":"general-purpose","task_description":"Phase C builtins error tests"}
