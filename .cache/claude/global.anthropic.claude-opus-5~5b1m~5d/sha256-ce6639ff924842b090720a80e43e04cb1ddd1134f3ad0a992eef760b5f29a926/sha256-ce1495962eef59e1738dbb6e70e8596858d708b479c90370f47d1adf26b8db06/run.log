   }\n2380\t        for f in [0, JS_STRICT] {\n2381\t            diff_native(&format!(\"regexp flags={}\", flags), act, f);\n2382\t        }\n2383\t    }\n2384\t}\n2385\t\n2386\t#[test]\n2387\tfn ffi_jsV_newobject_class_out_of_range() {\n2388\t    for class in [16i64, 17, 99, 255, -1, -99, i32::MAX as i64, i32::MIN as i64] {\n2389\t        set_pi(0, class);\n2390\t        fn act(a: &Api, J: JS) {\n2391\t            unsafe {\n2392\t                let obj = (a.jsV_newobject)(J, pic(0), std::ptr::null_mut());\n2393\t                emit(&format!(\"nonnull={}\", !obj.is_null()));\n2394\t                (a.js_pushobject)(J, obj);\n2395\t                emit(&format!(\n2396\t                    \"type={} typeof={} isobject={} isarray={} isregexp={} iscallable={} iserror={}\",\n2397\t                    (a.js_type)(J, -1),\n2398\t                    rs((a.js_typeof)(J, -1)),\n2399\t                    (a.js_isobject)(J, -1),\n2400\t                    (a.js_isarray)(J, -1),\n2401\t                    (a.js_isregexp)(J, -1),\n2402\t                    (a.js_iscallable)(J, -1),\n2403\t                    (a.js_iserror)(J, -1),\n2404\t                ));\n2405\t                /* the repr switch falls into its `default:` branch for unknown classes */\n2406\t                emit(&format!(\"repr={}\", repr_at(a, J, -1)));\n2407\t                emit(&format!(\"str={:?}\", str_at(a, J, -1)));\n2408\t                (a.js_pushnumber)(J, 1.0);\n2409\t                (a.js_setproperty)(J, -2, cs(\"p\").as_ptr());\n2410\t                (a.js_getproperty)(J, -1, cs(\"p\").as_ptr());\n2411\t                emit(&format!(\"p={}\", repr_at(a, J, -1)));\n2412\t                (a.js_pop)(J, 1);\n2413\t                (a.js_delproperty)(J, -1, cs(\"p\").as_ptr());\n2414\t                emit(&format!(\"len={}\", (a.js_getlength)(J, -1)));\n2415\t                (a.js_pop)(J, (a.js_gettop)(J) - 1);\n2416\t                (a.js_gc)(J, 0);\n2417\t                (a.js_pushnumber)(J, 0.0);\n2418\t            }\n2419\t        }\n2420\t        for f in [0, JS_STRICT] {\n2421\t            diff_native(&format!(\"jsV_newobject class={}\", class), act, f);\n2422\t        }\n2423\t    }\n2424\t}\n2425\t\n2426\t/* ========================================================================== */\n2427\t/* NULL pointer arguments the C accepts                                        */\n2428\t/* ========================================================================== */\n2429\t\n2430\t#[test]\n2431\tfn null_pointer_arguments() {\n2432\t    fn act(a: &Api, J: JS) {\n2433\t        unsafe {\n2434\t            /* js_setreport(J, NULL): js_report becomes a no-op */\n2435\t            (a.js_setreport)(J, None);\n2436\t            (a.js_report)(J, cs(\"dropped\").as_ptr());\n2437\t            emit(\"report-with-null-handler-ok\");\n2438\t\n2439\t            /* js_atpanic(J, NULL): installed but never triggered here */\n2440\t            let old = (a.js_atpanic)(J, None);\n2441\t            emit(&format!(\"old_panic_none={}\", old.is_none()));\n2442\t            let back = (a.js_atpanic)(J, old);\n2443\t            emit(&format!(\"back_none={}\", back.is_none()));\n2444\t\n2445\t            /* js_newcfunction with a NULL function pointer, never called */\n2446\t            (a.js_newcfunction)(J, None, b\"nullfn\\0\".as_ptr() as *const c_char, 0);\n2447\t            emit(&format!(\n2448\t                \"nullfn callable={} repr={}\",\n2449\t                (a.js_iscallable)(J, -1),\n2450\t                repr_at(a, J, -1)\n2451\t            ));\n2452\t            (a.js_pop)(J, 1);\n2453\t\n2454\t            /* js_newuserdatax with all-NULL callbacks */\n2455\t            (a.js_newobject)(J);\n2456\t            (a.js_newuserdatax)(\n2457\t                J,\n2458\t                TAG_NULL.as_ptr() as *const c_char,\n2459\t                std::ptr::null_mut(),\n2460\t                None,\n2461\t                None,\n2462\t                None,\n2463\t                None,\n2464\t            );\n2465\t            emit(&format!(\n2466\t                \"ud data={:?} isud={} has={}\",\n2467\t                (a.js_touserdata)(J, -1, TAG_NULL.as_ptr() as *const c_char),\n2468\t                (a.js_isuserdata)(J, -1, TAG_NULL.as_ptr() as *const c_char),\n2469\t                (a.js_hasproperty)(J, -1, cs(\"zap\").as_ptr())\n2470\t            ));\n2471\t            (a.js_pop)(J, (a.js_gettop)(J) - 1);\n2472\t            (a.js_pushnumber)(J, 1.0);\n2473\t            (a.js_setproperty)(J, -2, cs(\"zap\").as_ptr());\n2474\t            (a.js_delproperty)(J, -1, cs(\"zap\").as_ptr());\n2475\t            (a.js_pop)(J, 1);\n2476\t\n2477\t            /* js_regcomp / js_regexec with a NULL Resub */\n2478\t            let mut err: *const c_char = std::ptr::null();\n2479\t            let pat = cs(\"a(b)c\");\n2480\t            let prog = (a.js_regcomp)(pat.as_ptr(), 0, &mut err);\n2481\t            emit(&format!(\"regcomp nonnull={} err={:?}\", !prog.is_null(), rs(err)));\n2482\t            if !prog.is_null() {\n2483\t                let sub = cs(\"xxabcxx\");\n2484\t                emit(&format!(\n2485\t                    \"regexec_null_sub={}\",\n2486\t                    (a.js_regexec)(prog, sub.as_ptr(), std::ptr::null_mut(), 0)\n2487\t                ));\n2488\t                let nomatch = cs(\"zzz\");\n2489\t                emit(&format!(\n2490\t                    \"regexec_null_sub_nomatch={}\",\n2491\t                    (a.js_regexec)(prog, nomatch.as_ptr(), std::ptr::null_mut(), 0)\n2492\t                ));\n2493\t                let mut m = Resub::default();\n2494\t                emit(&format!(\n2495\t                    \"regexec_sub={} nsub={}\",\n2496\t                    (a.js_regexec)(prog, sub.as_ptr(), &mut m, 0),\n2497\t                    m.nsub\n2498\t                ));\n2499\t                (a.js_regfree)(prog);\n2500\t            }\n2501\t            /* js_regcomp of an invalid pattern returns NULL + an error string */\n2502\t            let bad = cs(\"a(\");\n2503\t            let prog2 = (a.js_regcomp)(bad.as_ptr(), 0, &mut err);\n2504\t            emit(&format!(\"regcomp_bad null={} err={:?}\", prog2.is_null(), rs(err)));\n2505\t\n2506\t            /* row 337: js_freestate(NULL) is a documented no-op */\n2507\t            (a.js_freestate)(std::ptr::null_mut());\n2508\t            emit(\"freestate-null-ok\");\n2509\t            (a.js_pushnumber)(J, 0.0);\n2510\t        }\n2511\t    }\n2512\t    for f in [0, JS_STRICT] {\n2513\t        diff_native(\"null pointer args\", act, f);\n2514\t    }\n2515\t}\n2516\t\n2517\t/* rows 190, 191: js_currentfunction / js_currentfunctiondata with BOT == 0.\n2518\t * A brand-new state has no active call frame, so this is only reachable on a\n2519\t * secondary state created inside the action. */\n2520\t#[test]\n2521\tfn r190_r191_currentfunction_without_frame() {\n2522\t    for sub_flags in FLAGSETS {\n2523\t        set_pi(0, sub_flags as i64);\n2524\t        fn act(a: &Api, J: JS) {\n2525\t            unsafe {\n2526\t                let J2 = (a.js_newstate)(None, std::ptr::null_mut(), pic(0));\n2527\t                emit(&format!(\"J2_nonnull={}\", !J2.is_null()));\n2528\t                if !J2.is_null() {\n2529\t                    emit(&format!(\"top0={}\", (a.js_gettop)(J2)));\n2530\t                    emit(&format!(\"data={:?}\", (a.js_currentfunctiondata)(J2)));\n2531\t                    (a.js_currentfunction)(J2);\n2532\t                    emit(&format!(\"top1={}\", (a.js_gettop)(J2)));\n2533\t                    emit(&format!(\"cur={}\", repr_at(a, J2, -1)));\n2534\t                    emit(&format!(\"isundefined={}\", (a.js_isundefined)(J2, -1)));\n2535\t                    (a.js_pop)(J2, 1);\n2536\t                    /* js_gc on a state that has only the bootstrap objects */\n2537\t                    (a.js_gc)(J2, 0);\n2538\t                    (a.js_freestate)(J2);\n2539\t                }\n2540\t                (a.js_pushnumber)(J, 0.0);\n2541\t            }\n2542\t        }\n2543\t        let p = libs();\n2544\t        let c = p.c.run_native(act, 0);\n2545\t        let r = p.r.run_native(act, 0);\n2546\t        same(&format!(\"currentfunction BOT=0 flags={}\", sub_flags), &c, &r);\n2547\t        /* row 190: with BOT == 0 js_currentfunction pushes undefined;\n2548\t         * row 191: js_currentfunctiondata returns NULL */\n2549\t        assert!(c.contains(\"cur=undefined\"), \"{}\", c);\n2550\t        assert!(c.contains(\"data=0x0\"), \"{}\", c);\n2551\t    }\n2552\t}\n2553\t\n2554\t/* row 338: js_setlimit never validates anything */\n2555\t#[test]\n2556\tfn r338_setlimit_accepts_anything() {\n2557\t    for (rl, ml) in [\n2558\t        (i32::MIN as i64, i32::MIN as i64),\n2559\t        (-1, 0),\n2560\t        (0, -1),\n2561\t        (i32::MAX as i64, 0),\n2562\t        (0, i32::MAX as i64),\n2563\t    ] {\n2564\t        set_pi(0, rl);\n2565\t        set_pi(1, ml);\n2566\t        fn act(a: &Api, J: JS) {\n2567\t            unsafe {\n2568\t                (a.js_setlimit)(J, pic(0), pic(1));\n2569\t                emit(\"setlimit-returned\");\n2570\t                (a.js_setlimit)(J, 0, 0);\n2571\t                let src = cs(\"var s=0; for(var i=0;i<20;i++) s+=i; s\");\n2572\t                run_src(a, J, &src, \"after\");\n2573\t                (a.js_pushnumber)(J, 0.0);\n2574\t            }\n2575\t        }\n2576\t        diff_native(&format!(\"setlimit({},{})\", rl, ml), act, 0);\n2577\t    }\n2578\t}\n2579\t\n2580\t/* rows 334-336: js_gc report + gc triggered from the interpreter loop */\n2581\t#[test]\n2582\tfn r335_r336_gc_report_and_trigger() {\n2583\t    let p = libs();\n2584\t    for report in [0i64, 1, 2, -1] {\n2585\t        set_pi(0, report);\n2586\t        fn act(a: &Api, J: JS) {\n2587\t            unsafe {\n2588\t                /* js_gc's report goes through J->report, whose default writes to\n2589\t                 * stderr; route it into the diffed transcript instead. */\n2590\t                (a.js_setreport)(J, Some(rep_emit));\n2591\t                let src = cs(\"var a=[]; for(var i=0;i<400;i++) a.push({x:i,s:'s'+i}); a.length\");\n2592\t                run_src(a, J, &src, \"alloc\");\n2593\t                (a.js_gc)(J, pic(0));\n2594\t                (a.js_gc)(J, pic(0));\n2595\t                emit(\"gc-done\");\n2596\t                (a.js_pushnumber)(J, 0.0);\n2597\t            }\n2598\t        }\n2599\t        /* The gc report prints allocator-dependent byte counts, so only the\n2600\t         * shape (non-digit characters) is compared. libtest's own progress\n2601\t         * lines can land in the captured fd when tests run in parallel; they\n2602\t         * are not produced by the library and are filtered out. */\n2603\t        let strip = |s: &str| {\n2604\t            s.lines()\n2605\t                .filter(|l| !l.starts_with(\"test \") && !l.contains(\"test result\"))\n2606\t                .map(|l| l.chars().filter(|c| !c.is_ascii_digit()).collect::<String>())\n2607\t                .collect::<Vec<_>>()\n2608\t                .join(\"\\n\")\n2609\t        };\n2610\t        let mut oc = String::new();\n2611\t        let mut or_ = String::new();\n2612\t        let c = capture_stdout(|| oc = p.c.run_native(act, 0));\n2613\t        let r = capture_stdout(|| or_ = p.r.run_native(act, 0));\n2614\t        /* nothing of this reaches fd 1 in either library */\n2615\t        same(&format!(\"js_gc({}) stdout\", report), &strip(&c), &strip(&r));\n2616\t        same(&format!(\"js_gc({}) result\", report), &oc, &or_);\n2617\t        if report != 0 {\n2618\t            assert!(oc.contains(\"garbage collected\"), \"report={}: {}\", report, oc);\n2619\t        } else {\n2620\t            assert!(!oc.contains(\"garbage collected\"), \"report={}: {}\", report, oc);\n2621\t        }\n2622\t    }\n2623\t}\n2624\t\n2625\t/* ========================================================================== */\n2626\t/* rows 175, 177, 283, 284, 285: allocator failures                            */\n2627\t/* ========================================================================== */\n2628\t\n2629\tuse std::sync::atomic::{AtomicI64, Ordering};\n2630\t\n2631\tstatic BUDGET: AtomicI64 = AtomicI64::new(0);\n2632\t\n2633\textern \"C\" {\n2634\t    fn realloc(p: *mut c_void, n: usize) -> *mut c_void;\n2635\t    fn free(p: *mut c_void);\n2636\t}\n2637\t\n2638\t/// Fails every allocation (row 283).\n2639\tunsafe extern \"C\" fn null_alloc(_ctx: *mut c_void, p: *mut c_void, n: c_int) -> *mut c_void {\n2640\t    if n == 0 {\n2641\t        free(p);\n2642\t    }\n2643\t    std::ptr::null_mut()\n2644\t}\n2645\t\n2646\t/// Succeeds for the first `BUDGET` requests, then fails (rows 175/177/284/285).\n2647\tunsafe extern \"C\" fn budget_alloc(_ctx: *mut c_void, p: *mut c_void, n: c_int) -> *mut c_void {\n2648\t    if n == 0 {\n2649\t        free(p);\n2650\t        return std::ptr::null_mut();\n2651\t    }\n2652\t    if BUDGET.fetch_sub(1, Ordering::SeqCst) <= 0 {\n2653\t        return std::ptr::null_mut();\n2654\t    }\n2655\t    realloc(p, n as usize)\n2656\t}\n2657\t\n2658\t#[test]\n2659\tfn r283_r285_newstate_allocator_failures() {\n2660\t    /* row 283: the very first allocation fails */\n2661\t    fn act_null(a: &Api, J: JS) {\n2662\t        unsafe {\n2663\t            let J2 = (a.js_newstate)(Some(null_alloc), std::ptr::null_mut(), 0);\n2664\t            emit(&format!(\"null_alloc_state_null={}\", J2.is_null()));\n2665\t            (a.js_pushnumber)(J, 0.0);\n2666\t        }\n2667\t    }\n2668\t    for f in [0, JS_STRICT] {\n2669\t        diff_native(\"newstate null alloc\", act_null, f);\n2670\t    }\n2671\t\n2672\t    /* rows 284/285: the allocation budget runs out at some point during the\n2673\t     * bootstrap; both libraries must fail (or succeed) at the same budget. */\n2674\t    for budget in [\n2675\t        0i64, 1, 2, 3, 4, 5, 8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096, 8192,\n2676\t    ] {\n2677\t        set_pi(0, budget);\n2678\t        fn act(a: &Api, J: JS) {\n2679\t            unsafe {\n2680\t                BUDGET.store(pi(0), Ordering::SeqCst);\n2681\t                let J2 = (a.js_newstate)(Some(budget_alloc), std::ptr::null_mut(), 0);\n2682\t                BUDGET.store(i64::MAX / 2, Ordering::SeqCst);\n2683\t                emit(&format!(\"budget={} null={}\", pi(0), J2.is_null()));\n2684\t                if !J2.is_null() {\n2685\t                    /* rows 175/177: js_malloc / js_realloc get NULL back on an\n2686\t                     * already-bootstrapped state; the throw is caught by pcall */\n2687\t                    BUDGET.store(20, Ordering::SeqCst);\n2688\t                    let nm = cs(\"oom.js\");\n2689\t                    let src = cs(\"var a=[]; for (var i=0;i<300;i++) a.push({k:i,s:'v'+i}); a.length\");\n2690\t                    let rc = (a.js_ploadstring)(J2, nm.as_ptr(), src.as_ptr());\n2691\t                    emit(&format!(\"oom_load={}\", rc));\n2692\t                    if rc == 0 {\n2693\t                        (a.js_pushundefined)(J2);\n2694\t                        let rc = (a.js_pcall)(J2, 0);\n2695\t                        BUDGET.store(i64::MAX / 2, Ordering::SeqCst);\n2696\t                        emit(&format!(\"oom_call={} v={:?}\", rc, str_at(a, J2, -1)));\n2697\t                    } else {\n2698\t                        BUDGET.store(i64::MAX / 2, Ordering::SeqCst);\n2699\t                        emit(&format!(\"oom_loaderr={:?}\", str_at(a, J2, -1)));\n2700\t                    }\n2701\t                    (a.js_pop)(J2, 1);\n2702\t                    (a.js_freestate)(J2);\n2703\t                }\n2704\t                BUDGET.store(i64::MAX / 2, Ordering::SeqCst);\n2705\t                (a.js_pushnumber)(J, 0.0);\n2706\t            }\n2707\t        }\n2708\t        let p = libs();\n2709\t        let c = p.c.run_native(act, 0);\n2710\t        let r = p.r.run_native(act, 0);\n2711\t        same(&format!(\"newstate budget={}\", budget), &c, &r);\n2712\t        if budget == 0 {\n2713\t            assert!(c.contains(\"null=true\"), \"budget 0: {}\", c);\n2714\t        }\n2715\t    }\n2716\t}\n2717\t\n2718\t/* ========================================================================== */\n2719\t/* ground truth: the exact C message text of every reachable thrower           */\n2720\t/* ========================================================================== */\n2721\t\n2722\t#[test]\n2723\tfn ground_truth_messages_js() {\n2724\t    /* (source, flags, expected substring of the rendered C result) */\n2725\t    let cases: &[(&str, c_int, &str)] = &[\n2726\t        (\"var a=[]; a.length=1.5\", 0, \"invalid array length\"),\n2727\t        (\"var a=[]; a.length=-1\", 0, \"invalid array length\"),\n2728\t        (\"var a=[]; a.length=67108865\", 0, \"array too large\"),\n2729\t        (\"'use strict'; var s=new String('ab'); s.length=5\", 0, \"'length' is read-only\"),\n2730\t        (\"'use strict'; var s=new String('ab'); s[0]='z'\", 0, \"'0' is read-only\"),\n2731\t        (\"'use strict'; /a/.source='b'\", 0, \"'source' is read-only\"),\n2732\t        (\"'use strict'; /a/.global=true\", 0, \"'global' is read-only\"),\n2733\t        (\"'use strict'; /a/.ignoreCase=true\", 0, \"'ignoreCase' is read-only\"),\n2734\t        (\"'use strict'; /a/.multiline=true\", 0, \"'multiline' is read-only\"),\n2735\t        (\n2736\t            \"'use strict'; var o={get x(){return 1}}; o.x=2\",\n2737\t            0,\n2738\t            \"setting property 'x' that only has a getter\",\n2739\t        ),\n2740\t        (\n2741\t            \"'use strict'; var o={}; Object.defineProperty(o,'x',{value:1,writable:false}); o.x=2\",\n2742\t            0,\n2743\t            \"'x' is read-only\",\n2744\t        ),\n2745\t        /* NOTE: the `transient` TypeError of jsR_setproperty (rows 227/228) is\n2746\t         * NOT reachable from JS source: OP_SETPROP does\n2747\t         *     obj = js_toobject(J, -3); transient = !js_isobject(J, -3);\n2748\t         * and js_toobject rewrites the stack slot into an object *in place*, so\n2749\t         * the following js_isobject is always true and transient is always 0.\n2750\t         * The assignment therefore silently targets the temporary wrapper. */\n2751\t        (\"'use strict'; 'abc'.foo=1\", 0, \"ok 1\"),\n2752\t        (\"'use strict'; 'abc'.foo=1; 'abc'.foo\", 0, \"ok undefined\"),\n2753\t        (\n2754\t            \"'use strict'; var o=Object.preventExtensions({}); o.x=1\",\n2755\t            0,\n2756\t            \"object is non-extensible\",\n2757\t        ),\n2758\t        (\n2759\t            \"Object.defineProperty([], 'length', {value:3})\",\n2760\t            0,\n2761\t            \"'length' is read-only or non-configurable\",\n2762\t        ),\n2763\t        (\n2764\t            \"Object.defineProperty(new String('ab'), '0', {value:'z'})\",\n2765\t            0,\n2766\t            \"'0' is read-only or non-configurable\",\n2767\t        ),\n2768\t        (\n2769\t            \"Object.defineProperty(/a/, 'lastIndex', {value:1})\",\n2770\t            0,\n2771\t            \"'lastIndex' is read-only or non-configurable\",\n2772\t        ),\n2773\t        (\"'use strict'; delete [].length\", 0, \"'length' is non-configurable\"),\n2774\t        (\n2775\t            \"'use strict'; var s=new String('ab'); delete s[0]\",\n2776\t            0,\n2777\t            \"'0' is non-configurable\",\n2778\t        ),\n2779\t        (\"'use strict'; delete /a/.source\", 0, \"'source' is non-configurable\"),\n2780\t        /* `delete <identifier>` is a strict-mode SyntaxError, so the global\n2781\t         * JS_DONTCONF branch of jsR_delproperty is only observable non-strict\n2782\t         * from JS (false) — the TypeError form is checked natively below. */\n2783\t        (\"delete Math\", 0, \"ok true\"),\n2784\t        (\"delete NaN\", 0, \"ok false\"),\n2785\t        (\"delete Infinity\", 0, \"ok false\"),\n2786\t        (\"'use strict'; delete NaN\", 0, \"delete on an unqualified name\"),\n2787\t        (\n2788\t            \"'use strict'; undeclaredzz = 1\",\n2789\t            0,\n2790\t            \"assignment to undeclared variable 'undeclaredzz'\",\n2791\t        ),\n2792\t        (\"nosuchvariable\", 0, \"'nosuchvariable' is not defined\"),\n2793\t        (\"'x' in 1\", 0, \"operand to 'in' is not an object\"),\n2794\t        (\"undefined.x\", 0, \"cannot convert undefined to object\"),\n2795\t        (\"null.x\", 0, \"cannot convert null to object\"),\n2796\t        (\"var x=1; x()\", 0, \"number is not callable\"),\n2797\t        (\"undefined()\", 0, \"undefined is not callable\"),\n2798\t        (\"({})()\", 0, \"object is not callable\"),\n2799\t        (\"new 1\", 0, \"number is not callable\"),\n2800\t        (\"({}) instanceof 1\", 0, \"instanceof: invalid operand\"),\n2801\t        (\n2802\t            \"function f(){}; f.prototype=1; ({}) instanceof f\",\n2803\t            0,\n2804\t            \"instanceof: 'prototype' property is not an object\",\n2805\t        ),\n2806\t        (\"Error.prototype.toString.call(1)\", 0, \"not an object\"),\n2807\t        (\n2808\t            \"'use strict'; var o=Object.create(null); o+1\",\n2809\t            0,\n2810\t            \"cannot convert object to primitive\",\n2811\t        ),\n2812\t        (\"String(Object.create(null))\", 0, \"[object]\"),\n2813\t        (\"function f(){ return f() } f()\", 0, \"call stack overflow\"),\n2814\t    ];\n2815\t    on_big_stack(move || {\n2816\t        let p = libs();\n2817\t        for (src, f, want) in cases {\n2818\t            let c = p.c.eval(src, *f);\n2819\t            let r = p.r.eval(src, *f);\n2820\t            same(&format!(\"ground truth {:?}\", src), &c, &r);\n2821\t            assert!(\n2822\t                c.contains(want),\n2823\t                \"src={:?} expected {:?} in C output {:?}\",\n2824\t                src,\n2825\t                want,\n2826\t                c\n2827\t            );\n2828\t        }\n2829\t    });\n2830\t}\n2831\t\n2832\t/* (expected message, js_newstate flags) */\n2833\tconst NATIVE_MSGS: &[(&str, c_int)] = &[\n2834\t    (\"not a regexp\", 0),\n2835\t    (\"not a Bar\", 0),\n2836\t    (\"not a function\", 0),\n2837\t    (\"number of arguments cannot be negative\", 0),\n2838\t    (\"not an iterator\", 0),\n2839\t    (\"script ran too long\", 0),\n2840\t    (\"out of memory\", 0),\n2841\t    (\"stack underflow!\", 0),\n2842\t    (\"stack error!\", 0),\n2843\t    (\"not implemented yet\", 0),\n2844\t    (\"stack overflow\", 0),\n2845\t    (\"invalid string length\", 0),\n2846\t    /* rows 227/228 — only reachable through the C API, where the `transient`\n2847\t     * flag is computed from the untouched stack slot */\n2848\t    (\"cannot create property 'foo' on transient object\", JS_STRICT),\n2849\t    (\"'length' is read-only\", JS_STRICT),\n2850\t    (\"'length' is read-only or non-configurable\", 0),\n2851\t    (\"'x' is non-configurable\", JS_STRICT),\n2852\t    (\"cannot convert undefined to object\", 0),\n2853\t    (\"cannot convert null to object\", 0),\n2854\t    (\"exception stack overflow\", 0),\n2855\t    (\"'NaN' is non-configurable\", JS_STRICT),\n2856\t];\n2857\t\n2858\t/* js_newuserdata stores the tag POINTER (it does not copy the bytes), so the\n2859\t * tag must outlive the state: only static strings are safe. */\n2860\tstatic TAG_FOO: &[u8] = b\"Foo\\0\";\n2861\tstatic TAG_BAR: &[u8] = b\"Bar\\0\";\n2862\tstatic TAG_NULL: &[u8] = b\"NullTag\\0\";\n2863\t\n2864\t#[test]\n2865\tfn ground_truth_messages_native() {\n2866\t    for (mode, (want, flags)) in NATIVE_MSGS.iter().enumerate() {\n2867\t        set_pi(0, mode as i64);\n2868\t        fn act(a: &Api, J: JS) {\n2869\t            unsafe {\n2870\t                match pi(0) {\n2871\t                    0 => {\n2872\t                        (a.js_pushnumber)(J, 1.0);\n2873\t                        (a.js_toregexp)(J, -1);\n2874\t                    }\n2875\t                    1 => {\n2876\t                        (a.js_newobject)(J);\n2877\t                        (a.js_newuserdata)(\n2878\t                            J,\n2879\t                            TAG_FOO.as_ptr() as *const c_char,\n2880\t                            0x1 as *mut c_void,\n2881\t                            None,\n2882\t                        );\n2883\t                        (a.js_touserdata)(J, -1, TAG_BAR.as_ptr() as *const c_char);\n2884\t                    }\n2885\t                    2 => {\n2886\t                        (a.js_newobject)(J);\n2887\t                        (a.js_pushnumber)(J, 1.0);\n2888\t                        (a.js_pushnumber)(J, 2.0);\n2889\t                        (a.js_defaccessor)(J, -3, cs(\"p\").as_ptr(), 0);\n2890\t                    }\n2891\t                    3 => {\n2892\t                        (a.js_newcfunction)(J, Some(cf_noop), b\"f\\0\".as_ptr() as *const c_char, 0);\n2893\t                        (a.js_pushundefined)(J);\n2894\t                        (a.js_call)(J, -1);\n2895\t                    }\n2896\t                    4 => {\n2897\t                        (a.js_newobject)(J);\n2898\t                        (a.js_nextiterator)(J, -1);\n2899\t                    }\n2900\t                    5 => {\n2901\t                        (a.js_setlimit)(J, 1, 0);\n2902\t                        let src = cs(\"var s=0; for(var i=0;i<100;i++) s+=i; s\");\n2903\t                        run_src(a, J, &src, \"runlimit\");\n2904\t                    }\n2905\t                    6 => {\n2906\t                        (a.js_setlimit)(J, 0, 8);\n2907\t                        let q = (a.js_malloc)(J, 4096);\n2908\t                        emit(&format!(\"malloc={}\", !q.is_null()));\n2909\t                    }\n2910\t                    7 => (a.js_pop)(J, 99),\n2911\t                    8 => (a.js_remove)(J, 99),\n2912\t                    9 => (a.js_insert)(J, 0),\n2913\t                    10 => {\n2914\t                        for _ in 0..6000 {\n2915\t                            (a.js_pushundefined)(J);\n2916\t                        }\n2917\t                    }\n2918\t                    11 => {\n2919\t                        (a.js_pushlstring)(J, cs(\"abcd\").as_ptr(), (1 << 28) + 1);\n2920\t                    }\n2921\t                    12 => {\n2922\t                        (a.js_pushstring)(J, cs(\"abc\").as_ptr());\n2923\t                        (a.js_pushnumber)(J, 1.0);\n2924\t                        (a.js_setproperty)(J, -2, cs(\"foo\").as_ptr());\n2925\t                    }\n2926\t                    13 => {\n2927\t                        (a.js_newstring)(J, cs(\"ab\").as_ptr());\n2928\t                        (a.js_pushnumber)(J, 5.0);\n2929\t                        (a.js_setproperty)(J, -2, cs(\"length\").as_ptr());\n2930\t                    }\n2931\t                    14 => {\n2932\t                        (a.js_newarray)(J);\n2933\t                        (a.js_pushnumber)(J, 5.0);\n2934\t                        (a.js_defproperty)(J, -2, cs(\"length\").as_ptr(), 0);\n2935\t                    }\n2936\t                    15 => {\n2937\t                        (a.js_newobject)(J);\n2938\t                        (a.js_pushnumber)(J, 1.0);\n2939\t                        (a.js_defproperty)(J, -2, cs(\"x\").as_ptr(), JS_DONTCONF);\n2940\t                        (a.js_delproperty)(J, -1, cs(\"x\").as_ptr());\n2941\t                    }\n2942\t                    16 => {\n2943\t                        (a.js_pushundefined)(J);\n2944\t                        (a.js_toobject)(J, -1);\n2945\t                    }\n2946\t                    17 => {\n2947\t                        (a.js_pushnull)(J);\n2948\t                        (a.js_toobject)(J, -1);\n2949\t                    }\n2950\t                    19 => {\n2951\t                        (a.js_pushglobal)(J);\n2952\t                        (a.js_delproperty)(J, -1, cs(\"NaN\").as_ptr());\n2953\t                    }\n2954\t                    _ => {\n2955\t                        /* JS_TRYLIMIT via nested JS try blocks */\n2956\t                        let mut s = String::from(\"var r='none';\");\n2957\t                        for _ in 0..70 {\n2958\t                            s.push_str(\"try{\");\n2959\t                        }\n2960\t                        s.push_str(\"r='deep';\");\n2961\t                        for _ in 0..70 {\n2962\t                            s.push_str(\"}catch(e){r=String(e)}\");\n2963\t                        }\n2964\t                        s.push_str(\"r\");\n2965\t                        let src = cs(&s);\n2966\t                        run_src(a, J, &src, \"trylimit\");\n2967\t                    }\n2968\t                }\n2969\t                emit(&format!(\"survived top={}\", (a.js_gettop)(J)));\n2970\t                (a.js_pop)(J, (a.js_gettop)(J) - 1);\n2971\t                (a.js_pushnumber)(J, 0.0);\n2972\t            }\n2973\t        }\n2974\t        let p = libs();\n2975\t        let c = p.c.run_native(act, *flags);\n2976\t        let r = p.r.run_native(act, *flags);\n2977\t        same(&format!(\"native ground truth mode={}\", mode), &c, &r);\n2978\t        assert!(c.contains(want), \"mode={} expected {:?} in {:?}\", mode, want, c);\n2979\t    }\n2980\t}\n2981\t\n2982\t/* ========================================================================== */\n2983\t/* randomized coverage over the property / index API (fixed seed)              */\n2984\t/* ========================================================================== */\n2985\t\n2986\t#[test]\n2987\tfn randomized_property_and_index_ops() {\n2988\t    let mut rng = Rng::new(SEED ^ 0xABCD);\n2989\t    let names = [\n2990\t        \"\", \"a\", \"length\", \"0\", \"1\", \"01\", \"-1\", \"1.5\", \"4294967296\", \"source\", \"global\",\n2991\t        \"lastIndex\", \"toString\", \"prototype\", \"constructor\", \"x\", \"99999999999\",\n2992\t    ];\n2993\t    for iter in 0..600 {\n2994\t        let recv = rng.range_i64(0, 9);\n2995\t        let op = rng.range_i64(0, 11);\n2996\t        let name = names[rng.below(names.len() as u64) as usize];\n2997\t        let idx = rng.range_i64(-4, 4);\n2998\t        let atts = rng.range_i64(-1, 8);\n2999\t        let val = rng.range_i64(0, 6);\n3000\t        set_pi(0, recv);\n3001\t        set_pi(1, op);\n3002\t        set_pi(2, atts * 100 + val); /* packed */\n3003\t        set_pi(3, idx);\n3004\t        set_ps(0, name);\n3005\t        fn push_recv(a: &Api, J: JS, k: i64) {\n3006\t            unsafe {\n3007\t                match k {\n3008\t                    0 => (a.js_newobject)(J),\n3009\t                    1 => (a.js_newarray)(J),\n3010\t                    2 => (a.js_newstring)(J, cs(\"abc\").as_ptr()),\n3011\t                    3 => (a.js_newregexp)(J, cs(\"a\").as_ptr(), JS_REGEXP_G),\n3012\t                    4 => (a.js_pushstring)(J, cs(\"abc\").as_ptr()),\n3013\t                    5 => (a.js_pushnumber)(J, 5.0),\n3014\t                    6 => (a.js_pushglobal)(J),\n3015\t                    7 => (a.js_newcfunction)(J, Some(cf_noop), b\"f\\0\".as_ptr() as *const c_char, 0),\n3016\t                    8 => (a.js_newnumber)(J, 3.0),\n3017\t                    _ => (a.js_newarguments)(J),\n3018\t                }\n3019\t            }\n3020\t        }\n3021\t        fn push_val(a: &Api, J: JS, k: i64) {\n3022\t            unsafe {\n3023\t                match k {\n3024\t                    0 => (a.js_pushnumber)(J, 7.0),\n3025\t                    1 => (a.js_pushstring)(J, cs(\"v\").as_ptr()),\n3026\t                    2 => (a.js_pushundefined)(J),\n3027\t                    3 => (a.js_pushnull)(J),\n3028\t                    4 => (a.js_pushboolean)(J, 1),\n3029\t                    5 => (a.js_newobject)(J),\n3030\t                    _ => (a.js_pushnumber)(J, -1.5),\n3031\t                }\n3032\t            }\n3033\t        }\n3034\t        fn act(a: &Api, J: JS) {\n3035\t            unsafe {\n3036\t                let packed = pi(2);\n3037\t                let atts = (packed / 100) as c_int;\n3038\t                let val = packed % 100;\n3039\t                let name = ps(0);\n3040\t                let idx = pic(3);\n3041\t                push_recv(a, J, pi(0));\n3042\t                match pi(1) {\n3043\t                    0 => {\n3044\t                        (a.js_getproperty)(J, -1, name.as_ptr());\n3045\t                        emit(&format!(\"get={}\", repr_at(a, J, -1)));\n3046\t                    }\n3047\t                    1 => {\n3048\t                        push_val(a, J, val);\n3049\t                        (a.js_setproperty)(J, -2, name.as_ptr());\n3050\t                        emit(\"set-ok\");\n3051\t                    }\n3052\t                    2 => {\n3053\t                        push_val(a, J, val);\n3054\t                        (a.js_defproperty)(J, -2, name.as_ptr(), atts);\n3055\t                        emit(\"def-ok\");\n3056\t                    }\n3057\t                    3 => {\n3058\t                        (a.js_delproperty)(J, -1, name.as_ptr());\n3059\t                        emit(\"del-ok\");\n3060\t                    }\n3061\t                    4 => {\n3062\t                        emit(&format!(\"has={}\", (a.js_hasproperty)(J, -1, name.as_ptr())));\n3063\t                    }\n3064\t                    5 => {\n3065\t                        (a.js_getindex)(J, -1, idx);\n3066\t                        emit(&format!(\"getindex={}\", repr_at(a, J, -1)));\n3067\t                    }\n3068\t                    6 => {\n3069\t                        push_val(a, J, val);\n3070\t                        (a.js_setindex)(J, -2, idx);\n3071\t                        emit(\"setindex-ok\");\n3072\t                    }\n3073\t                    7 => {\n3074\t                        (a.js_delindex)(J, -1, idx);\n3075\t                        emit(\"delindex-ok\");\n3076\t                    }\n3077\t                    8 => {\n3078\t                        emit(&format!(\"hasindex={}\", (a.js_hasindex)(J, -1, idx)));\n3079\t                    }\n3080\t                    9 => {\n3081\t                        emit(&format!(\"getlength={}\", (a.js_getlength)(J, -1)));\n3082\t                        (a.js_setlength)(J, -1, idx);\n3083\t                        emit(&format!(\"getlength2={}\", (a.js_getlength)(J, -1)));\n3084\t                    }\n3085\t                    10 => {\n3086\t                        (a.js_newcfunction)(J, Some(cf_noop), b\"g\\0\".as_ptr() as *const c_char, 0);\n3087\t                        (a.js_pushundefined)(J);\n3088\t                        (a.js_defaccessor)(J, -3, name.as_ptr(), atts);\n3089\t                        emit(\"defaccessor-ok\");\n3090\t                    }\n3091\t                    _ => {\n3092\t                        (a.js_pushiterator)(J, -1, (val % 2) as c_int);\n3093\t                        let mut k = 0;\n3094\t                        loop {\n3095\t                            let nm = (a.js_nextiterator)(J, -1);\n3096\t                            if nm.is_null() {\n3097\t                                break;\n3098\t                            }\n3099\t                            emit(&format!(\"it={:?}\", rs(nm)));\n3100\t                            k += 1;\n3101\t                            if k > 12 {\n3102\t                                break;\n3103\t                            }\n3104\t                        }\n3105\t                    }\n3106\t                }\n3107\t                emit(&format!(\"top={}\", (a.js_gettop)(J)));\n3108\t                dump(a, J);\n3109\t                (a.js_pop)(J, (a.js_gettop)(J) - 1);\n3110\t                (a.js_pushnumber)(J, 0.0);\n3111\t            }\n3112\t        }\n3113\t        let p = libs();\n3114\t        for f in [0, JS_STRICT] {\n3115\t            same(\n3116\t                &format!(\n3117\t                    \"rnd iter={} recv={} op={} name={:?} idx={} atts/val={} flags={}\",\n3118\t                    iter, recv, op, name, idx, pi(2), f\n3119\t                ),\n3120\t                &p.c.run_native(act, f),\n3121\t                &p.r.run_native(act, f),\n3122\t            );\n3123\t        }\n3124\t    }\n3125\t}\n3126\t"}]},"parent_tool_use_id":"toolu_bdrk_01Y9hKnfBpBoYWrvrFodjeAa","session_id":"2be16944-0c16-4bac-97a9-ffb5f1a29386","uuid":"123ee55e-b6ad-4906-b9d7-3f8823af71e7","timestamp":"2026-09-04T05:35:38.524Z","subagent_type":"general-purpose","task_description":"Close remaining CONFIGS rows"}
