{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Wa8TmXxbbqF4Af73gFh1sT","type":"tool_result","content":"1\t//! Error-path differential tests, ERRORS.md rows 65..120.\n2\t//!\n3\t//! Covered surfaces:\n4\t//!   * rows  65.. 90 — `jslex.c` lexer / JSON lexer `jsY_error` sites\n5\t//!   * rows  91..102 — `jsnumber.c` `Np_*` type/range errors\n6\t//!   * rows 103..120 — `jsobject.c` `O_*` type errors\n7\t//!\n8\t//! Every test drives the *exact* invalid input named in the row and prints\n9\t//! whatever the library reports, so that both libmujs.so builds must agree\n10\t//! byte for byte (and on exit status).\n11\t\n12\t#![allow(non_snake_case)]\n13\t\n14\tmod common;\n15\tuse common::*;\n16\t\n17\tuse std::ffi::{c_char, c_int};\n18\tuse std::ptr::null_mut;\n19\t\n20\t/* ------------------------------------------------------------------------- */\n21\t/* plumbing                                                                  */\n22\t/* ------------------------------------------------------------------------- */\n23\t\n24\t/// The Api currently under test — needed because a `js_CFunction` is a plain\n25\t/// `extern \"C\"` fn pointer and cannot capture. Same trick as `dtest/driver.c`,\n26\t/// which links against one library at a time.\n27\tstatic mut CUR: *const Api = std::ptr::null();\n28\t\n29\tunsafe extern \"C\" fn jsB_print(J: JS) {\n30\t    let api = &*CUR;\n31\t    let top = (api.js_gettop)(J);\n32\t    let mut i = 1;\n33\t    while i < top {\n34\t        let s = (api.js_tostring)(J, i);\n35\t        if i > 1 {\n36\t            libc::putchar(b' ' as c_int);\n37\t        }\n38\t        libc::printf(b\"%s\\0\".as_ptr() as *const c_char, s);\n39\t        i += 1;\n40\t    }\n41\t    libc::putchar(b'\\n' as c_int);\n42\t    (api.js_pushundefined)(J);\n43\t}\n44\t\n45\t/// Report hook: routed through stdout (printf) so that *all* of a child's\n46\t/// output shares one buffer and therefore one deterministic ordering.\n47\tunsafe extern \"C\" fn myreport(_J: JS, msg: *const c_char) {\n48\t    libc::printf(b\"[report] %s\\n\\0\".as_ptr() as *const c_char, msg);\n49\t}\n50\t\n51\tunsafe fn mkstate(api: &Api) -> JS {\n52\t    CUR = api as *const Api;\n53\t    let J = newstate(api, 0);\n54\t    (api.js_setreport)(J, Some(myreport));\n55\t    (api.js_newcfunction)(J, Some(jsB_print), cs(\"print\").as_ptr(), 0);\n56\t    (api.js_setglobal)(J, cs(\"print\").as_ptr());\n57\t    J\n58\t}\n59\t\n60\tunsafe fn hdr(row: c_int, what: &str) {\n61\t    libc::printf(\n62\t        b\"== row %d %s\\n\\0\".as_ptr() as *const c_char,\n63\t        row,\n64\t        cs(what).as_ptr(),\n65\t    );\n66\t}\n67\t\n68\t/// (a) uncaught: `js_dostring` — the installed report receives the message.\n69\tunsafe fn dostring(api: &Api, src: &str) {\n70\t    let J = mkstate(api);\n71\t    let rc = (api.js_dostring)(J, cs(src).as_ptr());\n72\t    p_int(\"rc\", rc);\n73\t    p_int(\"top\", (api.js_gettop)(J));\n74\t    (api.js_freestate)(J);\n75\t}\n76\t\n77\t/// (b) `js_ploadstring` — returns 1 and leaves the error object on the stack,\n78\t/// so the lexer/parser message can be printed directly.\n79\tunsafe fn ploadstring(api: &Api, src: &str) {\n80\t    let J = mkstate(api);\n81\t    let rc = (api.js_ploadstring)(J, cs(\"[file]\").as_ptr(), cs(src).as_ptr());\n82\t    p_int(\"prc\", rc);\n83\t    if rc != 0 {\n84\t        /* read `name` first: js_tostring() converts the slot in place. */\n85\t        (api.js_getproperty)(J, -1, cs(\"name\").as_ptr());\n86\t        p_str(\"pname\", (api.js_tostring)(J, -1));\n87\t        (api.js_pop)(J, 1);\n88\t        p_str(\"perr\", (api.js_tostring)(J, -1));\n89\t        (api.js_pop)(J, 1);\n90\t    }\n91\t    p_int(\"top\", (api.js_gettop)(J));\n92\t    (api.js_freestate)(J);\n93\t}\n94\t\n95\t/// (c) C-API level: compile then `js_pcall` — the thrown object comes back on\n96\t/// the stack, no JS `try` needed.\n97\tunsafe fn pcallstring(api: &Api, src: &str) {\n98\t    let J = mkstate(api);\n99\t    let lrc = (api.js_ploadstring)(J, cs(\"[expr]\").as_ptr(), cs(src).as_ptr());\n100\t    p_int(\"loadrc\", lrc);\n101\t    if lrc == 0 {\n102\t        (api.js_pushundefined)(J);\n103\t        let rc = (api.js_pcall)(J, 0);\n104\t        p_int(\"pcallrc\", rc);\n105\t        p_str(\"pcallres\", (api.js_tostring)(J, -1));\n106\t        (api.js_pop)(J, 1);\n107\t    } else {\n108\t        p_str(\"loaderr\", (api.js_tostring)(J, -1));\n109\t        (api.js_pop)(J, 1);\n110\t    }\n111\t    p_int(\"top\", (api.js_gettop)(J));\n112\t    (api.js_freestate)(J);\n113\t}\n114\t\n115\t/// (d) inside JavaScript `try`/`catch`, printing `e.name + \": \" + e.message`.\n116\tunsafe fn caught(api: &Api, expr: &str) {\n117\t    let src = format!(\n118\t        \"try {{ {} }} catch (e) {{ print(e.name + \\\": \\\" + e.message) }}\",\n119\t        expr\n120\t    );\n121\t    let J = mkstate(api);\n122\t    let rc = (api.js_dostring)(J, cs(&src).as_ptr());\n123\t    p_int(\"rc\", rc);\n124\t    p_int(\"top\", (api.js_gettop)(J));\n125\t    (api.js_freestate)(J);\n126\t}\n127\t\n128\t/// Lexer rows: the malformed token is rejected at load time, so `try`/`catch`\n129\t/// in the same script cannot see it — drive `js_dostring` and `js_ploadstring`.\n130\tunsafe fn lexrow(api: &Api, row: c_int, src: &str) {\n131\t    hdr(row, \"dostring\");\n132\t    dostring(api, src);\n133\t    hdr(row, \"ploadstring\");\n134\t    ploadstring(api, src);\n135\t}\n136\t\n137\t/// Runtime rows: uncaught + `js_pcall` + JS `try`/`catch`.\n138\tunsafe fn rtrow(api: &Api, row: c_int, expr: &str) {\n139\t    hdr(row, \"dostring\");\n140\t    dostring(api, expr);\n141\t    hdr(row, \"pcall\");\n142\t    pcallstring(api, expr);\n143\t    hdr(row, \"caught\");\n144\t    caught(api, expr);\n145\t}\n146\t\n147\t/* ------------------------------------------------------------------------- */\n148\t/* jslex.c — rows 65..82                                                     */\n149\t/* ------------------------------------------------------------------------- */\n150\t"}]},"parent_tool_use_id":"toolu_bdrk_01Gp1TNe95x7TTDWRxE6p2KW","session_id":"5c8219bc-b0e9-40a9-995a-ed544487508c","uuid":"fa025c07-2765-4519-ab3c-51ffaf367dc5","timestamp":"2026-09-08T17:02:03.538Z","subagent_type":"general-purpose","task_description":"Error tests rows 65-120"}
