" fn(JS),\n279\t\n280\t    /* operators */\n281\t    js_concat: unsafe extern \"C\" fn(JS),\n282\t    js_compare: unsafe extern \"C\" fn(JS, *mut c_int) -> c_int,\n283\t    js_equal: unsafe extern \"C\" fn(JS) -> c_int,\n284\t    js_strictequal: unsafe extern \"C\" fn(JS) -> c_int,\n285\t    js_instanceof: unsafe extern \"C\" fn(JS) -> c_int,\n286\t    js_typeof: unsafe extern \"C\" fn(JS, c_int) -> *const c_char,\n287\t    js_type: unsafe extern \"C\" fn(JS, c_int) -> c_int,\n288\t    js_repr: unsafe extern \"C\" fn(JS, c_int),\n289\t    js_torepr: unsafe extern \"C\" fn(JS, c_int) -> *const c_char,\n290\t    js_tryrepr: unsafe extern \"C\" fn(JS, c_int, *const c_char) -> *const c_char,\n291\t\n292\t    /* memory / strings */\n293\t    js_malloc: unsafe extern \"C\" fn(JS, c_int) -> *mut c_void,\n294\t    js_realloc: unsafe extern \"C\" fn(JS, *mut c_void, c_int) -> *mut c_void,\n295\t    js_free: unsafe extern \"C\" fn(JS, *mut c_void),\n296\t    js_strdup: unsafe extern \"C\" fn(JS, *const c_char) -> *mut c_char,\n297\t    js_intern: unsafe extern \"C\" fn(JS, *const c_char) -> *const c_char,\n298\t    jsS_dumpstrings: unsafe extern \"C\" fn(JS),\n299\t    jsS_freestrings: unsafe extern \"C\" fn(JS),\n300\t    js_putc: unsafe extern \"C\" fn(JS, *mut Buf, c_int),\n301\t    js_puts: unsafe extern \"C\" fn(JS, *mut Buf, *const c_char),\n302\t    js_putm: unsafe extern \"C\" fn(JS, *mut Buf, *const c_char, *const c_char),\n303\t\n304\t    /* numbers */\n305\t    js_fmtexp: unsafe extern \"C\" fn(*mut c_char, c_int),\n306\t    js_grisu2: unsafe extern \"C\" fn(f64, *mut c_char, *mut c_int) -> c_int,\n307\t    js_strtod: unsafe extern \"C\" fn(*const c_char, *mut *mut c_char) -> f64,\n308\t    js_strtol: unsafe extern \"C\" fn(*const c_char, *mut *mut c_char, c_int) -> f64,\n309\t    js_itoa: unsafe extern \"C\" fn(*mut c_char, c_int) -> *const c_char,\n310\t    js_stringtofloat: unsafe extern \"C\" fn(*const c_char, *mut *mut c_char) -> f64,\n311\t    jsV_numbertointeger: unsafe extern \"C\" fn(f64) -> c_int,\n312\t    jsV_numbertoint32: unsafe extern \"C\" fn(f64) -> c_int,\n313\t    jsV_numbertouint32: unsafe extern \"C\" fn(f64) -> c_uint,\n314\t    jsV_numbertoint16: unsafe extern \"C\" fn(f64) -> c_short,\n315\t    jsV_numbertouint16: unsafe extern \"C\" fn(f64) -> c_ushort,\n316\t    jsV_numbertostring: unsafe extern \"C\" fn(JS, *mut c_char, f64) -> *const c_char,\n317\t    jsV_stringtonumber: unsafe extern \"C\" fn(JS, *const c_char) -> f64,\n318\t\n319\t    /* values / objects (low level) */\n320\t    jsV_toboolean: unsafe extern \"C\" fn(JS, *mut js_Value) -> c_int,\n321\t    jsV_tonumber: unsafe extern \"C\" fn(JS, *mut js_Value) -> f64,\n322\t    jsV_tointeger: unsafe extern \"C\" fn(JS, *mut js_Value) -> f64,\n323\t    jsV_tostring: unsafe extern \"C\" fn(JS, *mut js_Value) -> *const c_char,\n324\t    jsV_toobject: unsafe extern \"C\" fn(JS, *mut js_Value) -> Obj,\n325\t    jsV_toprimitive: unsafe extern \"C\" fn(JS, *mut js_Value, c_int),\n326\t    jsV_newobject: unsafe extern \"C\" fn(JS, c_int, Obj) -> Obj,\n327\t    jsV_newmemstring: unsafe extern \"C\" fn(JS, *const c_char, c_int) -> Str,\n328\t    jsV_getownproperty: unsafe extern \"C\" fn(JS, Obj, *const c_char) -> Prop,\n329\t    jsV_getproperty: unsafe extern \"C\" fn(JS, Obj, *const c_char) -> Prop,\n330\t    jsV_getpropertyx: unsafe extern \"C\" fn(JS, Obj, *const c_char, *mut c_int) -> Prop,\n331\t    jsV_setproperty: unsafe extern \"C\" fn(JS, Obj, *const c_char) -> Prop,\n332\t    jsV_delproperty: unsafe extern \"C\" fn(JS, Obj, *const c_char),\n333\t    jsV_newiterator: unsafe extern \"C\" fn(JS, Obj, c_int) -> Obj,\n334\t    jsV_nextiterator: unsafe extern \"C\" fn(JS, Obj) -> *const c_char,\n335\t    jsV_resizearray: unsafe extern \"C\" fn(JS, Obj, c_int),\n336\t    jsR_newenvironment: unsafe extern \"C\" fn(JS, Obj, Env) -> Env,\n337\t    jsR_unflattenarray: unsafe extern \"C\" fn(JS, Obj),\n338\t    js_RegExp_prototype_exec: unsafe extern \"C\" fn(JS, *mut c_void, *const c_char),\n339\t\n340\t    /* utf */\n341\t    jsU_chartorune: unsafe extern \"C\" fn(*mut c_int, *const c_char) -> c_int,\n342\t    jsU_runetochar: unsafe extern \"C\" fn(*mut c_char, *const c_int) -> c_int,\n343\t    jsU_runelen: unsafe extern \"C\" fn(c_int) -> c_int,\n344\t    jsU_isalpharune: unsafe extern \"C\" fn(c_int) -> c_int,\n345\t    jsU_islowerrune: unsafe extern \"C\" fn(c_int) -> c_int,\n346\t    jsU_isupperrune: unsafe extern \"C\" fn(c_int) -> c_int,\n347\t    jsU_tolowerrune: unsafe extern \"C\" fn(c_int) -> c_int,\n348\t    jsU_toupperrune: unsafe extern \"C\" fn(c_int) -> c_int,\n349\t    jsU_tolowerrune_full: unsafe extern \"C\" fn(c_int) -> *const c_int,\n350\t    jsU_toupperrune_full: unsafe extern \"C\" fn(c_int) -> *const c_int,\n351\t    js_utflen: unsafe extern \"C\" fn(*const c_char) -> c_int,\n352\t    js_utfptrtoidx: unsafe extern \"C\" fn(*const c_char, *const c_char) -> c_int,\n353\t    js_runeat: unsafe extern \"C\" fn(JS, *const c_char, c_int) -> c_int,\n354\t\n355\t    /* lexer / parser / compiler */\n356\t    jsY_iswhite: unsafe extern \"C\" fn(c_int) -> c_int,\n357\t    jsY_isnewline: unsafe extern \"C\" fn(c_int) -> c_int,\n358\t    jsY_ishex: unsafe extern \"C\" fn(c_int) -> c_int,\n359\t    jsY_tohex: unsafe extern \"C\" fn(c_int) -> c_int,\n360\t    jsY_tokenstring: unsafe extern \"C\" fn(c_int) -> *const c_char,\n361\t    jsY_findword: unsafe extern \"C\" fn(*const c_char, *const *const c_char, c_int) -> c_int,\n362\t    jsY_initlex: unsafe extern \"C\" fn(JS, *const c_char, *const c_char),\n363\t    jsY_lex: unsafe extern \"C\" fn(JS) -> c_int,\n364\t    jsY_lexjson: unsafe extern \"C\" fn(JS) -> c_int,\n365\t    jsP_parse: unsafe extern \"C\" fn(JS, *const c_char, *const c_char) -> Ast,\n366\t    jsP_parsefunction: unsafe extern \"C\" fn(JS, *const c_char, *const c_char, *const c_char) -> Ast,\n367\t    jsP_freeparse: unsafe extern \"C\" fn(JS),\n368\t    jsC_compilefunction: unsafe extern \"C\" fn(JS, Ast) -> Func,\n369\t    jsC_compilescript: unsafe extern \"C\" fn(JS, Ast, c_int) -> Func,\n370\t\n371\t    /* builtins */\n372\t    jsB_init: unsafe extern \"C\" fn(JS),\n373\t    jsB_initobject: unsafe extern \"C\" fn(JS),\n374\t    jsB_initarray: unsafe extern \"C\" fn(JS),\n375\t    jsB_initfunction: unsafe extern \"C\" fn(JS),\n376\t    jsB_initboolean: unsafe extern \"C\" fn(JS),\n377\t    jsB_initnumber: unsafe extern \"C\" fn(JS),\n378\t    jsB_initstring: unsafe extern \"C\" fn(JS),\n379\t    jsB_initregexp: unsafe extern \"C\" fn(JS),\n380\t    jsB_initerror: unsafe extern \"C\" fn(JS),\n381\t    jsB_initmath: unsafe extern \"C\" fn(JS),\n382\t    jsB_initjson: unsafe extern \"C\" fn(JS),\n383\t    jsB_initdate: unsafe extern \"C\" fn(JS),\n384\t    jsB_propf: unsafe extern \"C\" fn(JS, *const c_char, Option<CFun>, c_int),\n385\t    jsB_propn: unsafe extern \"C\" fn(JS, *const c_char, f64),\n386\t    jsB_props: unsafe extern \"C\" fn(JS, *const c_char, *const c_char),\n387\t\n388\t    /* regexp */\n389\t    js_regcomp: unsafe extern \"C\" fn(*const c_char, c_int, *mut *const c_char) -> Reprog,\n390\t    js_regcompx: unsafe extern \"C\" fn(Option<Alloc>, *mut c_void, *const c_char, c_int, *mut *const c_char) -> Reprog,\n391\t    js_regexec: unsafe extern \"C\" fn(Reprog, *const c_char, *mut Resub, c_int) -> c_int,\n392\t    js_regfree: unsafe extern \"C\" fn(Reprog),\n393\t    js_regfreex: unsafe extern \"C\" fn(Option<Alloc>, *mut c_void, Reprog),\n394\t}\n395\t\n396\tpub struct Libs {\n397\t    pub c: Api,\n398\t    pub r: Api,\n399\t    _libs: (libloading::Library, libloading::Library),\n400\t}\n401\t\n402\tunsafe impl Sync for Libs {}\n403\tunsafe impl Send for Libs {}\n404\t\n405\tstatic LIBS: OnceLock<Libs> = OnceLock::new();\n406\t\n407\tfn root() -> PathBuf {\n408\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\")).parent().unwrap().to_path_buf()\n409\t}\n410\t\n411\tfn rust_so() -> PathBuf {\n412\t    if let Ok(p) = std::env::var(\"MUJS_RUST_SO\") {\n413\t        return PathBuf::from(p);\n414\t    }\n415\t    let base = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\")).join(\"target\");\n416\t    let rel = base.join(\"release/libmujs.so\");\n417\t    let dbg = base.join(\"debug/libmujs.so\");\n418\t    match (rel.exists(), dbg.exists()) {\n419\t        (true, true) => {\n420\t            let mr = std::fs::metadata(&rel).unwrap().modified().unwrap();\n421\t            let md = std::fs::metadata(&dbg).unwrap().modified().unwrap();\n422\t            if md > mr { dbg } else { rel }\n423\t        }\n424\t        (true, false) => rel,\n425\t        (false, true) => dbg,\n426\t        _ => panic!(\"no Rust libmujs.so built\"),\n427\t    }\n428\t}\n429\t\n430\tfn c_so() -> PathBuf {\n431\t    if let Ok(p) = std::env::var(\"MUJS_C_SO\") {\n432\t        return PathBuf::from(p);\n433\t    }\n434\t    root().join(\"c_src/build/libmujs.so\")\n435\t}\n436\t\n437\tpub fn libs() -> &'static Libs {\n438\t    LIBS.get_or_init(|| unsafe {\n439\t        let cpath = c_so();\n440\t        let rpath = rust_so();\n441\t        assert!(cpath.exists(), \"missing {}\", cpath.display());\n442\t        assert!(rpath.exists(), \"missing {}\", rpath.display());\n443\t        /* The C library is linked without -lm (see c_src/CMakeLists.txt), so\n444\t         * pull libm into the global scope first. */\n445\t        let libm = libloading::os::unix::Library::open(\n446\t            Some(\"libm.so.6\"),\n447\t            libloading::os::unix::RTLD_NOW | libloading::os::unix::RTLD_GLOBAL,\n448\t        );\n449\t        std::mem::forget(libm);\n450\t        let cl = libloading::Library::new(&cpath).expect(\"dlopen C lib\");\n451\t        let rl = libloading::Library::new(&rpath).expect(\"dlopen Rust lib\");\n452\t        let c = Api::build(&cl, \"C\");\n453\t        let r = Api::build(&rl, \"RUST\");\n454\t        Libs { c, r, _libs: (cl, rl) }\n455\t    })\n456\t}\n457\t\n458\t/* --- libc bits used by the harness --------------------------------------- */\n459\t\n460\textern \"C\" {\n461\t    fn fork() -> c_int;\n462\t    fn waitpid(pid: c_int, status: *mut c_int, options: c_int) -> c_int;\n463\t    fn _exit(code: c_int) -> !;\n464\t    fn dup2(old: c_int, new: c_int) -> c_int;\n465\t    fn open(path: *const c_char, flags: c_int, ...) -> c_int;\n466\t    fn close(fd: c_int) -> c_int;\n467\t    fn fflush(f: *mut c_void) -> c_int;\n468\t    fn printf(fmt: *const c_char, ...) -> c_int;\n469\t    fn putchar(c: c_int) -> c_int;\n470\t    fn fputs(s: *const c_char, f: *mut c_void) -> c_int;\n471\t    fn puts(s: *const c_char) -> c_int;\n472\t    fn strlen(s: *const c_char) -> usize;\n473\t}\n474\t\n475\tconst O_RDWR: c_int = 2;\n476\tconst O_CREAT: c_int = 64;\n477\tconst O_TRUNC: c_int = 512;\n478\t\n479\t/// Run `f` in a forked child with stdout+stderr redirected to a temp file.\n480\t/// Returns the captured bytes and the raw wait status.\n481\tpub fn capture<F: FnOnce()>(tag: &str, f: F) -> (Vec<u8>, c_int) {\n482\t    let dir = std::env::temp_dir();\n483\t    let path = dir.join(format!(\n484\t        \"mujs_diff_{}_{}_{}.out\",\n485\t        std::process::id(),\n486\t        tag.replace(['/', ' ', '.'], \"_\"),\n487\t        COUNTER.fetch_add(1, std::sync::atomic::Ordering::SeqCst)\n488\t    ));\n489\t    let cpath = std::ffi::CString::new(path.to_str().unwrap()).unwrap();\n490\t    unsafe {\n491\t        fflush(std::ptr::null_mut());\n492\t        let pid = fork();\n493\t        if pid == 0 {\n494\t            let fd = open(cpath.as_ptr(), O_RDWR | O_CREAT | O_TRUNC, 0o600 as c_int);\n495\t            if fd < 0 {\n496\t                _exit(120);\n497\t            }\n498\t            dup2(fd, 1);\n499\t            dup2(fd, 2);\n500\t            close(fd);\n501\t            f();\n502\t            fflush(std::ptr::null_mut());\n503\t            _exit(0);\n504\t        }\n505\t        assert!(pid > 0, \"fork failed\");\n506\t        let mut status: c_int = 0;\n507\t        waitpid(pid, &mut status, 0);\n508\t        let data = std::fs::read(&path).unwrap_or_default();\n509\t        let _ = std::fs::remove_file(&path);\n510\t        (data, status)\n511\t    }\n512\t}\n513\t\n514\tstatic COUNTER: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);\n515\t\n516\t/// Run the same closure against the C API and the Rust API in separate\n517\t/// processes and assert that output bytes and exit status are identical.\n518\tpub fn diff<F: Fn(&Api)>(tag: &str, f: F) {\n519\t    let l = libs();\n520\t    let (oc, sc) = capture(&format!(\"c_{}\", tag), || f(&l.c));\n521\t    let (or, sr) = capture(&format!(\"r_{}\", tag), || f(&l.r));\n522\t    if oc != or || sc != sr {\n523\t        let sc_ = decode_status(sc);\n524\t        let sr_ = decode_status(sr);\n525\t        let a = String::from_utf8_lossy(&oc);\n526\t        let b = String::from_utf8_lossy(&or);\n527\t        let mut msg = format!(\n528\t            \"DIVERGENCE in `{}`\\n  C status: {}\\n  R status: {}\\n\",\n529\t            tag, sc_, sr_\n530\t        );\n531\t        let al: Vec<&str> = a.lines().collect();\n532\t        let bl: Vec<&str> = b.lines().collect();\n533\t        let mut shown = 0;\n534\t        for i in 0..al.len().max(bl.len()) {\n535\t            let x = al.get(i).copied().unwrap_or(\"<missing>\");\n536\t            let y = bl.get(i).copied().unwrap_or(\"<missing>\");\n537\t            if x != y {\n538\t                msg += &format!(\"  line {}:\\n    C: {}\\n    R: {}\\n\", i + 1, x, y);\n539\t                shown += 1;\n540\t                if shown >= 12 {\n541\t                    msg += \"  ...\\n\";\n542\t                    break;\n543\t                }\n544\t            }\n545\t        }\n546\t        if shown == 0 && oc != or {\n547\t            msg += &format!(\"  bytes differ (C {} bytes, R {} bytes)\\n\", oc.len(), or.len());\n548\t        }\n549\t        panic!(\"{}\", msg);\n550\t    }\n551\t}\n552\t\n553\tpub fn decode_status(s: c_int) -> String {\n554\t    if s & 0x7f == 0 {\n555\t        format!(\"exit {}\", (s >> 8) & 0xff)\n556\t    } else {\n557\t        format!(\"signal {}\", s & 0x7f)\n558\t    }\n559\t}\n560\t\n561\t/* --- printing helpers (libc, so bytes match the library's own output) ----- */\n562\t\n563\tpub fn cs(s: &str) -> std::ffi::CString {\n564\t    std::ffi::CString::new(s).unwrap()\n565\t}\n566\t\n567\tpub unsafe fn p_str(label: &str, s: *const c_char) {\n568\t    let l = cs(label);\n569\t    if s.is_null() {\n570\t        printf(cs(\"%s=<null>\\n\").as_ptr(), l.as_ptr());\n571\t    } else {\n572\t        printf(cs(\"%s=%s\\n\").as_ptr(), l.as_ptr(), s);\n573\t    }\n574\t}\n575\t\n576\tpub unsafe fn p_int(label: &str, v: c_int) {\n577\t    printf(cs(\"%s=%d\\n\").as_ptr(), cs(label).as_ptr(), v);\n578\t}\n579\t\n580\tpub unsafe fn p_uint(label: &str, v: c_uint) {\n581\t    printf(cs(\"%s=%u\\n\").as_ptr(), cs(label).as_ptr(), v);\n582\t}\n583\t\n584\tpub unsafe fn p_num(label: &str, v: f64) {\n585\t    printf(cs(\"%s=%.17g\\n\").as_ptr(), cs(label).as_ptr(), v);\n586\t}\n587\t\n588\tpub unsafe fn p_line(s: &str) {\n589\t    puts(cs(s).as_ptr());\n590\t}\n591\t\n592\tpub unsafe fn p_ptr_nonnull(label: &str, p: *const c_void) {\n593\t    printf(cs(\"%s=%s\\n\").as_ptr(), cs(label).as_ptr(),\n594\t        cs(if p.is_null() { \"null\" } else { \"nonnull\" }).as_ptr());\n595\t}\n596\t\n597\t/* --- convenience: fresh state with builtins ------------------------------ */\n598\t\n599\tpub unsafe fn newstate(api: &Api, flags: c_int) -> JS {\n600\t    let J = (api.js_newstate)(None, std::ptr::null_mut(), flags);\n601\t    assert!(!J.is_null());\n602\t    J\n603\t}\n604\t\n605\t/// Deterministic xorshift PRNG so both runs see identical inputs.\n606\tpub struct Rng(pub u64);\n607\t\n608\timpl Rng {\n609\t    pub fn new(seed: u64) -> Rng {\n610\t        Rng(seed | 1)\n611\t    }\n612\t    pub fn next_u64(&mut self) -> u64 {\n613\t        let mut x = self.0;\n614\t        x ^= x << 13;\n615\t        x ^= x >> 7;\n616\t