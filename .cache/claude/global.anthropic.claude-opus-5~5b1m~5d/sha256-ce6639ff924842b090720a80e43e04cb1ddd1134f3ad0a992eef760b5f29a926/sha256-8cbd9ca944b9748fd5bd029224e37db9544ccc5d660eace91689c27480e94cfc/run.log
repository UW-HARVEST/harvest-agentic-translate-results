        f();\n512\t            fflush(std::ptr::null_mut());\n513\t            _exit(0);\n514\t        }\n515\t        assert!(pid > 0, \"fork failed\");\n516\t        let mut status: c_int = 0;\n517\t        waitpid(pid, &mut status, 0);\n518\t        let data = std::fs::read(&path).unwrap_or_default();\n519\t        let _ = std::fs::remove_file(&path);\n520\t        (data, status)\n521\t    }\n522\t}\n523\t\n524\tstatic COUNTER: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);\n525\t\n526\t/// Run the same closure against the C API and the Rust API in separate\n527\t/// processes and assert that output bytes and exit status are identical.\n528\tpub fn diff<F: Fn(&Api)>(tag: &str, f: F) {\n529\t    let l = libs();\n530\t    let (oc, sc) = capture(&format!(\"c_{}\", tag), || f(&l.c));\n531\t    let (or, sr) = capture(&format!(\"r_{}\", tag), || f(&l.r));\n532\t    if oc != or || sc != sr {\n533\t        let sc_ = decode_status(sc);\n534\t        let sr_ = decode_status(sr);\n535\t        let a = String::from_utf8_lossy(&oc);\n536\t        let b = String::from_utf8_lossy(&or);\n537\t        let mut msg = format!(\n538\t            \"DIVERGENCE in `{}`\\n  C status: {}\\n  R status: {}\\n\",\n539\t            tag, sc_, sr_"}]},"parent_tool_use_id":null,"session_id":"5c8219bc-b0e9-40a9-995a-ed544487508c","uuid":"3dae9003-1ab4-4d22-b93c-28b89bf72e85","timestamp":"2026-09-08T17:06:01.161Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-dNzXE1/translation/tests/common/mod.rs","content":"    fn fputs(s: *const c_char, f: *mut c_void) -> c_int;\n    fn puts(s: *const c_char) -> c_int;\n    fn strlen(s: *const c_char) -> usize;\n}\n\nconst O_RDWR: c_int = 2;\nconst O_CREAT: c_int = 64;\nconst O_TRUNC: c_int = 512;\n\n/// Run `f` in a forked child with stdout+stderr redirected to a temp file.\n/// Returns the captured bytes and the raw wait status.\npub fn capture<F: FnOnce()>(tag: &str, f: F) -> (Vec<u8>, c_int) {\n    capture_ex(tag, true, f)\n}\n\n/// Like `capture`, but when `merge_stderr` is false the child's stderr is sent\n/// to /dev/null and only stdout is captured. Needed for the `assert()` abort\n/// paths: the C library is built with assertions live, and glibc's\n/// `__assert_fail` prints a message containing the absolute C source path and\n/// the host program name, which no translation can reproduce. Exit status and\n/// stdout are still compared.\npub fn capture_ex<F: FnOnce()>(tag: &str, merge_stderr: bool, f: F) -> (Vec<u8>, c_int) {\n    let dir = std::env::temp_dir();\n    let path = dir.join(format!(\n        \"mujs_diff_{}_{}_{}.out\",\n        std::process::id(),\n        tag.replace(['/', ' ', '.'], \"_\"),\n        COUNTER.fetch_add(1, std::sync::atomic::Ordering::SeqCst)\n    ));\n    let cpath = std::ffi::CString::new(path.to_str().unwrap()).unwrap();\n    unsafe {\n        fflush(std::ptr::null_mut());\n        let pid = fork();\n        if pid == 0 {\n            let fd = open(cpath.as_ptr(), O_RDWR | O_CREAT | O_TRUNC, 0o600 as c_int);\n            if fd < 0 {\n                _exit(120);\n            }\n            dup2(fd, 1);\n            dup2(fd, 2);\n            close(fd);\n            f();\n            fflush(std::ptr::null_mut());\n            _exit(0);\n        }\n        assert!(pid > 0, \"fork failed\");\n        let mut status: c_int = 0;\n        waitpid(pid, &mut status, 0);\n        let data = std::fs::read(&path).unwrap_or_default();\n        let _ = std::fs::remove_file(&path);\n        (data, status)\n    }\n}\n\nstatic COUNTER: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);\n\n/// Run the same closure against the C API and the Rust API in separate\n/// processes and assert that output bytes and exit status are identical.\npub fn diff<F: Fn(&Api)>(tag: &str, f: F) {\n    let l = libs();\n    let (oc, sc) = capture(&format!(\"c_{}\", tag), || f(&l.c));\n    let (or, sr) = capture(&format!(\"r_{}\", tag), || f(&l.r));\n    if oc != or || sc != sr {\n        let sc_ = decode_status(sc);\n        let sr_ = decode_status(sr);\n        let a = String::from_utf8_lossy(&oc);\n        let b = String::from_utf8_lossy(&or);\n        let mut msg = format!(\n            \"DIVERGENCE in `{}`\\n  C status: {}\\n  R status: {}\\n\",\n            tag, sc_, sr_","numLines":70,"startLine":470,"totalLines":648}}}
