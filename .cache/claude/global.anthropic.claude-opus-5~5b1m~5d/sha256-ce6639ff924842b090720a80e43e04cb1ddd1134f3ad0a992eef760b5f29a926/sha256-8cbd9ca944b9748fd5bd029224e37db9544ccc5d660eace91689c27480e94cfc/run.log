rray length\nrc=1\nsrc=<new Array(1e10);>\nRangeError: invalid array length\nrc=1\nsrc=<new Array(4294967296);>\nRangeError: invalid array length\nrc=1\nsrc=<var a = []; a.length = -1;>\nRangeError: invalid array length\nrc=1\nsrc=<var a = []; a.length = 1e10;>\nRangeError: invalid array length\nrc=1\nsrc=<var a = []; a.length = 0.5;>\nRangeError: invalid array length\nrc=1\nsrc=<var a = []; a.length = 67108865;>\nRangeError: array too large\nrc=1\nsrc=<var a = []; a.length = 67108864;>\nrc=0\nsrc=<var a = []; a[-1] = 1; print(a.length);>\n0\nrc=0\n\n#################### err237_string_length_limit (status exit 0)\n--- row 237: string length limit: invalid string length (JS_STRLIMIT 1<<28) ---\npushlstring_1<<28+1.rc=1\npushlstring_1<<28+1.err=RangeError: invalid string length\npushlstring_INT_MAX.rc=1\npushlstring_INT_MAX.err=RangeError: invalid string length\n1998\njoin.rc=0\n\n#################### err238_environment_stack_overflow (status exit 0)\n--- row 238: environment stack (JS_ENVLIMIT 1024) — shadowed by the trace check ---\nError: call stack overflow\nrecursion.rc=1\nError: call stack overflow\nrecursion_arguments.rc=1\nSyntaxError: (eval):1: too much recursion\nwith_nesting.rc=1\n\n#################### err239_value_stack_overflow (status exit 0)\n--- row 239: value stack (JS_STACKSIZE 4096): stack overflow ---\npushmany.rc=1\npushmany.err=stack overflow\ngettop_after=0\n5001\njs_bigarray.rc=0\n\n#################### err240_runlimit (status exit 0)\n--- row 240: js_setlimit runlimit (jsrun.c:1602): script ran too long ---\nrunlimit=1\nscript ran too long\nrc=1\nrunlimit=2\nscript ran too long\nrc=1\nrunlimit=10\nscript ran too long\nrc=1\nrunlimit=1000\nscript ran too long\nrc=1\nrunlimit=100000\nscript ran too long\nrc=1\n45\nok.rc=0\n\n#################### err241_memlimit (status exit 0)\n--- row 241: js_setlimit memlimit (jsrun.c:55-72): out of memory ---\nmemlimit=1\nout of memory\nrc=1\nmemlimit=16\nout of memory\nrc=1\nmemlimit=1024\nout of memory\nrc