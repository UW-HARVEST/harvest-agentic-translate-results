{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Ey2ZpzXQG8VMQFn1GMrTnk","type":"tool_result","content":"1\t//! Differential test harness: loads the C libmujs.so and the Rust libmujs.so\n2\t//! through `libloading` and compares their behaviour through the FFI boundary.\n3\t//!\n4\t//! Every call goes through `dlsym`ed function pointers — the Rust library is\n5\t//! never called directly, so the `#[no_mangle]` export wrappers are tested too.\n6\t\n7\t#![allow(dead_code, non_snake_case, non_camel_case_types, unused_imports)]\n8\t\n9\tuse std::ffi::{c_char, c_int, c_short, c_uint, c_ushort, c_void};\n10\tuse std::path::{Path, PathBuf};\n11\tuse std::sync::OnceLock;\n12\t\n13\tpub type JS = *mut c_void;\n14\tpub type Obj = *mut c_void;\n15\tpub type Prop = *mut c_void;\n16\tpub type Env = *mut c_void;\n17\tpub type Func = *mut c_void;\n18\tpub type Ast = *mut c_void;\n19\tpub type Str = *mut c_void;\n20\tpub type Buf = *mut c_void;\n21\tpub type Reprog = *mut c_void;\n22\t\n23\tpub type Alloc = unsafe extern \"C\" fn(*mut c_void, *mut c_void, c_int) -> *mut c_void;\n24\tpub type Panic = unsafe extern \"C\" fn(JS);\n25\tpub type CFun = unsafe extern \"C\" fn(JS);\n26\tpub type Finalize = unsafe extern \"C\" fn(JS, *mut c_void);\n27\tpub type HasProp = unsafe extern \"C\" fn(JS, *mut c_void, *const c_char) -> c_int;\n28\tpub type PutProp = unsafe extern \"C\" fn(JS, *mut c_void, *const c_char) -> c_int;\n29\tpub type DelProp = unsafe extern \"C\" fn(JS, *mut c_void, *const c_char) -> c_int;\n30\tpub type Report = unsafe extern \"C\" fn(JS, *const c_char);\n31\t\n32\t/* --- js_Value: identical repr to the C union (16 bytes) ------------------- */\n33\t\n34\t#[repr(C)]\n35\t#[derive(Clone, Copy)]\n36\tpub struct js_Value_t {\n37\t    pub pad: [c_char; 15],\n38\t    pub type_: c_char,\n39\t}\n40\t\n41\t#[repr(C)]\n42\t#[derive(Clone, Copy)]\n43\tpub union js_Value_u {\n44\t    pub shrstr: [c_char; 16],\n45\t    pub boolean: c_int,\n46\t    pub number: f64,\n47\t    pub litstr: *const c_char,\n48\t    pub memstr: *mut c_void,\n49\t    pub object: *mut c_void,\n50\t}\n51\t\n52\t#[repr(C)]\n53\t#[derive(Clone, Copy)]\n54\tpub union js_Value {\n55\t    pub t: js_Value_t,\n56\t    pub u: js_Value_u,\n57\t}\n58\t\n59\timpl js_Value {\n60\t    pub fn zero() -> js_Value {\n61\t        js_Value { u: js_Value_u { shrstr: [0; 16] } }\n62\t    }\n63\t}\n64\t\n65\t#[repr(C)]\n66\t#[derive(Clone, Copy)]\n67\tpub struct ResubEnt {\n68\t    pub sp: *const c_char,\n69\t    pub ep: *const c_char,\n70\t}\n71\t\n72\t#[repr(C)]\n73\t#[derive(Clone, Copy)]\n74\tpub struct Resub {\n75\t    pub nsub: c_int,\n76\t    pub sub: [ResubEnt; 16],\n77\t}\n78\t\n79\timpl Resub {\n80\t    pub fn new() -> Resub {\n81\t        Resub { nsub: 0, sub: [ResubEnt { sp: std::ptr::null(), ep: std::ptr::null() }; 16] }\n82\t    }\n83\t}\n84\t\n85\t/* --- constants from mujs.h ----------------------------------------------- */\n86\t\n87\tpub const JS_STRICT: c_int = 1;\n88\tpub const JS_REGEXP_G: c_int = 1;\n89\tpub const JS_REGEXP_I: c_int = 2;\n90\tpub const JS_REGEXP_M: c_int = 4;\n91\tpub const JS_READONLY: c_int = 1;\n92\tpub const JS_DONTENUM: c_int = 2;\n93\tpub const JS_DONTCONF: c_int = 4;\n94\tpub const REG_ICASE: c_int = 1;\n95\tpub const REG_NEWLINE: c_int = 2;\n96\tpub const REG_NOTBOL: c_int = 4;\n97\t\n98\t/* --- the API table ------------------------------------------------------- */\n99\t\n100\tmacro_rules! api {\n101\t    ( $( $name:ident : $t:ty ),* $(,)? ) => {\n102\t        pub struct Api {\n103\t            pub which: &'static str,\n104\t            $( pub $name : $t, )*\n105\t        }\n106\t        impl Api {\n107\t            unsafe fn build(lib: &libloading::Library, which: &'static str) -> Api {\n108\t                Api {\n109\t                    which,\n110\t                    $( $name : {\n111\t                        let s: libloading::Symbol<$t> =\n112\t                            lib.get(concat!(stringify!($name),