{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01DgCuTSaQpT65kx8riDGsGg","type":"tool_result","content":"130\t\n131\tunsafe fn push_str_array(api: &Api, J: JS, name: &str, vals: &[CString]) {\n132\t    (api.js_newarray)(J);\n133\t    for (i, v) in vals.iter().enumerate() {\n134\t        (api.js_pushstring)(J, v.as_ptr());\n135\t        (api.js_setindex)(J, -2, i as c_int);\n136\t    }\n137\t    (api.js_setglobal)(J, cs(name).as_ptr());\n138\t}\n139\t\n140\tfn set_tz(tz: &str) {\n141\t    std::env::set_var(\"TZ\", tz);\n142\t    unsafe { tzset() };\n143\t}\n144\t\n145\tfn root_dir() -> PathBuf {\n146\t    PathBuf::from(concat!(env!(\"CARGO_MANIFEST_DIR\"), \"/..\"))\n147\t}\n148\t\n149\tfn dtest_dir() -> PathBuf {\n150\t    root_dir().join(\"dtest\")\n151\t}\n152\t\n153\t/* ================================================================ 57 / 58 == */\n154\t\n155\t/// All `dtest/js/*.js` files, sorted, read at runtime.\n156\tfn corpus() -> Vec<(String, CString)> {\n157\t    let dir = dtest_dir().join(\"js\");\n158\t    let mut names: Vec<String> = std::fs::read_dir(&dir)\n159\t        .unwrap_or_else(|e| panic!(\"cannot read {}: {}\", dir.display(), e))\n160\t        .filter_map(|e| e.ok())\n161\t        .map(|e| e.file_name().to_string_lossy().into_owned())\n162\t        .filter(|n| n.ends_with(\".js\"))\n163\t        .collect();\n164\t    names.sort();\n165\t    assert!(names.len() > 50, \"corpus looks too small: {}\", names.len());\n166\t    names\n167\t        .into_iter()\n168\t        .map(|n| {\n169\t            let mut b = std::fs::read(dir.join(&n)).unwrap();\n170\t            b.retain(|c| *c != 0); /* C strings cannot carry NUL */\n171\t            (n, CString::new(b).unwrap())\n172\t        })\n173\t        .collect()\n174\t}\n175\t\n176\t/// `common::diff`, plus the `0x...` -> `PTR` normalisation that dtest/run.sh\n177\t/// applies.  `js_torepr` of a Function prints the raw object address\n178\t/// (`[Function 0x1cabcb90, f, [string]:1]`, see dtest/js/t13_trap.js), which is\n179\t/// process specific, so a byte exact comparison of it would be meaningless.\n180\t/// Everything else is compared byte for byte, exit status included.\n181\tfn diff_norm<F: Fn(&Api)>(tag: &str, f: F) {\n182\t    let l = libs();\n183\t    let (oc, sc) = capture(&format!(\"c_{}\", tag), || f(&l.c));\n184\t    let (or, sr) = capture(&format!(\"r_{}\", tag), || f(&l.r));\n185\t    let (nc, nr) = (norm_hex(&oc), norm_hex(&or));\n186\t    if nc != nr || sc != sr {\n187\t        let mut msg = format!(\n188\t            \"DIVERGENCE in `{}`\\n  C status: {}\\n  R status: {}\\n\",\n189\t            tag,\n190\t            decode_status(sc),\n191\t            decode_status(sr)\n192\t        );\n193\t        msg += &line_diffs(\"stdout+stderr\", &nc, &nr, 12);\n194\t        if nc == nr {\n195\t            msg += \"  output identical, exit status differs\\n\";\n196\t        }\n197\t        panic!(\"{}\", msg);\n198\t    }\n199\t}\n200\t\n201\tfn run_corpus(tagprefix: &str, flags: c_int) {\n202\t    set_tz(\"UTC\"); /* deterministic local time for t07/t15 */\n203\t    let files = corpus();\n204\t    for (name, src) in &files {\n205\t        diff_norm(&format!(\"{}_{}\", tagprefix, name), |api| unsafe {\n206\t            let J = boot(api, flags);\n207\t            let rc = (api.js_dostring)(J, src.as_ptr());\n208\t            finish(api, J, rc);\n209\t        });"}]},"parent_tool_use_id":"toolu_bdrk_01E8ecAiGGHYTpr8UWXCrPR2","session_id":"5c8219bc-b0e9-40a9-995a-ed544487508c","uuid":"908c6513-55cc-4d4e-b6a2-945f24e161bb","timestamp":"2026-09-08T17:16:31.613Z","subagent_type":"general-purpose","task_description":"Write script corpus + builtin tests"}
