{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_0176Wdofi2HGD8zPEuTFLypA","type":"tool_result","content":"1\t//! Phase C (rows 3/6/9), **isolated binary**.\n2\t//!\n3\t//! This test mutates the process address space (`mmap` with `MAP_FIXED_NOREPLACE`)\n4\t//! while calling into both shared objects. Any other test running concurrently\n5\t//! could observe a half-set-up address space, so this file deliberately contains\n6\t//! exactly ONE test: cargo gives each integration-test file its own process, and\n7\t//! a single test means no other thread is touching the mappings.\n8\t\n9\tmod support;\n10\t\n11\tuse support::{Rng, decode, libs};\n12\t\n13\t/// For subscripts far outside `g_pow43` the C's load address is unmapped, so\n14\t/// neither object can be called without a fault and the index arithmetic is\n15\t/// invisible. This test *makes* it visible: a page is mapped at exactly the\n16\t/// address each object's subscript targets, and filled so that each 4-byte slot\n17\t/// holds a hash of its index **relative to that object's own table base**.\n18\t///\n19\t/// Both objects then see the same value at the same *relative* index, so\n20\t/// `c(x) == r(x)` holds iff they computed the same subscript — while a different\n21\t/// subscript (e.g. a logical instead of arithmetic `>>`, or `/64` truncation\n22\t/// instead of flooring) yields a different slot and a different result.\n23\t#[test]\n24\tfn deep_oob_subscript_parity_via_mapped_pages() {\n25\t    let l = libs();\n26\t    let (Some(cv), Some(rv)) = (l.c_table, l.rust_table) else {\n27\t        panic!(\"tables must be locatable\");\n28\t    };\n29\t\n30\t    // Inputs whose subscript lands far outside the table, including the\n31\t    // `x + sign` overflow window at the top of the range (rows 9) and the\n32\t    // far-below-table region (row 3).\n33\t    let mut xs: Vec<i32> = Vec::new();\n34\t    xs.extend((i32::MAX - 80)..=i32::MAX); // x + sign wraps negative\n35\t    xs.extend([\n36\t        i32::MIN,\n37\t        i32::MIN + 1,\n38\t        i32::MIN + 63,\n39\t        -2_000_000_000,\n40\t        -1_000_000_000,\n41\t        -16_000_000,\n42\t        -1_000_000,\n43\t        -100_000,\n44\t        1_000_000,\n45\t        16_000_000,\n46\t        1_000_000_000,\n47\t        2_000_000_000,\n48\t        1_073_741_824,\n49\t        2_147_483_583,\n50\t    ]);\n51\t    let mut rng = Rng::new(0xDEEF_0000);\n52\t    xs.extend((0..400).map(|_| rng.next_i32()));\n53\t\n54\t    let mut verified = 0usize;\n55\t    let mut wrapped_negative = 0usize;\n56\t\n57\t    for x in xs {\n58\t        let d = decode(x);\n59\t        if (0..support::TABLE_LEN as i32).contains(&d.idx) {\n60\t            continue; // in bounds: already covered bit-for-bit elsewhere\n61\t        }\n62\t        if d.computed && x.wrapping_add(d.sign) < 0 {\n63\t            wrapped_negative += 1;\n64\t        }\n65\t\n66\t        // Byte offset of the load, exactly as C computes it.\n67\t        let off = (d.idx as isize).wrapping_mul(4);\n68\t        let c_addr = cv.base.wrapping_add(off as usize);\n69\t        let r_addr = rv.base.wrapping_add(off as usize);\n70\t\n71\t        // Already readable? Then the plain differential path applies.\n72\t        if support::is_readable(c_addr, 4) && support::is_readable(r_addr, 4) {\n73\t            continue;\n74\t        }\n75\t\n76\t        let c_page = c_addr & !(support::PAGE - 1);\n77\t        let r_page = r_addr & !(support::PAGE - 1);\n78\t        if c_page == r_page {\n79\t            continue; // would need one page to serve both bases\n80\t        }\n81\t        let (Some(cp), Some(rp)) = (support::FixedPage::at(c_page), support::FixedPage::at(r_page))\n82\t        else {\n83\t            continue; // address space already occupied there; nothing to do\n84\t        };\n85\t\n86\t        // Fill both pages so slot content depends only on the index *relative*\n87\t        // to that object's own table.\n88\t        for (page, base) in [(&cp, cv.base), (&rp, rv.base)] {\n89\t            let start = page.addr();\n90\t            for s in (0..support::PAGE).step_by(4) {\n91\t                let a = start + s;\n92\t                let rel = (a as i64 - base as i64) / 4;\n93\t                // SAFETY: `a` is inside the page we just mapped read/write.\n94\t                unsafe { std::ptr::write(a as *mut f32, support::slot_value(rel)) };\n95\t            }\n96\t        }\n97\t\n98\t        let c_got = unsafe { (l.c)(x) }.to_bits();\n99\t        let r_got = unsafe { (l.rust)(x) }.to_bits();\n100\t        assert_eq!(\n101\t            c_got, r_got,\n102\t            \"deep out-of-bounds subscript differs at x={x}: C read a different \\\n103\t             relative index than Rust (decoded {d:?})\"\n104\t        );\n105\t\n106\t        // And both must equal the value predicted for that exact subscript.\n107\t        let want = if d.computed {\n108\t            let poly = f32::from_bits(d.poly_bits);\n109\t            ((support::slot_value(d.idx as i64) * poly) * (d.mult as f32)).to_bits()\n110\t        } else {\n111\t            support::slot_value(d.idx as i64).to_bits()\n112\t        };\n113\t        assert_eq!(c_got, want, \"C .so read an unexpected subscript at x={x}\");\n114\t        assert_eq!(r_got, want, \"Rust .so read an unexpected subscript at x={x}\");\n115\t\n116\t        verified += 1;\n117\t        drop(cp);\n118\t        drop(rp);\n119\t    }\n120\t\n121\t    assert!(\n122\t        verified > 20,\n123\t        \"too few deep out-of-bounds inputs verified: {verified}\"\n124\t    );\n125\t    assert!(\n126\t        wrapped_negative > 0,\n127\t        \"the x+sign overflow window (row 9) was not reached\"\n128\t    );\n129\t    eprintln!(\"deep OOB subscript parity verified for {verified} inputs\");\n130\t}\n131\t\n132\t"}]},"parent_tool_use_id":null,"session_id":"c33bed92-1747-4f94-b4d1-217d8aeef992","uuid":"b4e92b71-720b-481a-9ebe-b29b21aa39a8","timestamp":"2026-08-27T00:44:29.677Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-NqWXYC/translation/tests/oob_pages.rs","content":"//! Phase C (rows 3/6/9), **isolated binary**.\n//!\n//! This test mutates the process address space (`mmap` with `MAP_FIXED_NOREPLACE`)\n//! while calling into both shared objects. Any other test running concurrently\n//! could observe a half-set-up address space, so this file deliberately contains\n//! exactly ONE test: cargo gives each integration-test file its own process, and\n//! a single test means no other thread is touching the mappings.\n\nmod support;\n\nuse support::{Rng, decode, libs};\n\n/// For subscripts far outside `g_pow43` the C's load address is unmapped, so\n/// neither object can be called without a fault and the index arithmetic is\n/// invisible. This test *makes* it visible: a page is mapped at exactly the\n/// address each object's subscript targets, and filled so that each 4-byte slot\n/// holds a hash of its index **relative to that object's own table base**.\n///\n/// Both objects then see the same value at the same *relative* index, so\n/// `c(x) == r(x)` holds iff they computed the same subscript — while a different\n/// subscript (e.g. a logical instead of arithmetic `>>`, or `/64` truncation\n/// instead of flooring) yields a different slot and a different result.\n#[test]\nfn deep_oob_subscript_parity_via_mapped_pages() {\n    let l = libs();\n    let (Some(cv), Some(rv)) = (l.c_table, l.rust_table) else {\n        panic!(\"tables must be locatable\");\n    };\n\n    // Inputs whose subscript lands far outside the table, including the\n    // `x + sign` overflow window at the top of the range (rows 9) and the\n    // far-below-table region (row 3).\n    let mut xs: Vec<i32> = Vec::new();\n    xs.extend((i32::MAX - 80)..=i32::MAX); // x + sign wraps negative\n    xs.extend([\n        i32::MIN,\n        i32::MIN + 1,\n        i32::MIN + 63,\n        -2_000_000_000,\n        -1_000_000_000,\n        -16_000_000,\n        -1_000_000,\n        -100_000,\n        1_000_000,\n        16_000_000,\n        1_000_000_000,\n        2_000_000_000,\n        1_073_741_824,\n        2_147_483_583,\n    ]);\n    let mut rng = Rng::new(0xDEEF_0000);\n    xs.extend((0..400).map(|_| rng.next_i32()));\n\n    let mut verified = 0usize;\n    let mut wrapped_negative = 0usize;\n\n    for x in xs {\n        let d = decode(x);\n        if (0..support::TABLE_LEN as i32).contains(&d.idx) {\n            continue; // in bounds: already covered bit-for-bit elsewhere\n        }\n        if d.computed && x.wrapping_add(d.sign) < 0 {\n            wrapped_negative += 1;\n        }\n\n        // Byte offset of the load, exactly as C computes it.\n        let off = (d.idx as isize).wrapping_mul(4);\n        let c_addr = cv.base.wrapping_add(off as usize);\n        let r_addr = rv.base.wrapping_add(off as usize);\n\n        // Already readable? Then the plain differential path applies.\n        if support::is_readable(c_addr, 4) && support::is_readable(r_addr, 4) {\n            continue;\n        }\n\n        let c_page = c_addr & !(support::PAGE - 1);\n        let r_page = r_addr & !(support::PAGE - 1);\n        if c_page == r_page {\n            continue; // would need one page to serve both bases\n        }\n        let (Some(cp), Some(rp)) = (support::FixedPage::at(c_page), support::FixedPage::at(r_page))\n        else {\n            continue; // address space already occupied there; nothing to do\n        };\n\n        // Fill both pages so slot content depends only on the index *relative*\n        // to that object's own table.\n        for (page, base) in [(&cp, cv.base), (&rp, rv.base)] {\n            let start = page.addr();\n            for s in (0..support::PAGE).step_by(4) {\n                let a = start + s;\n                let rel = (a as i64 - base as i64) / 4;\n                // SAFETY: `a` is inside the page we just mapped read/write.\n                unsafe { std::ptr::write(a as *mut f32, support::slot_value(rel)) };\n            }\n        }\n\n        let c_got = unsafe { (l.c)(x) }.to_bits();\n        let r_got = unsafe { (l.rust)(x) }.to_bits();\n        assert_eq!(\n            c_got, r_got,\n            \"deep out-of-bounds subscript differs at x={x}: C read a different \\\n             relative index than Rust (decoded {d:?})\"\n        );\n\n        // And both must equal the value predicted for that exact subscript.\n        let want = if d.computed {\n            let poly = f32::from_bits(d.poly_bits);\n            ((support::slot_value(d.idx as i64) * poly) * (d.mult as f32)).to_bits()\n        } else {\n            support::slot_value(d.idx as i64).to_bits()\n        };\n        assert_eq!(c_got, want, \"C .so read an unexpected subscript at x={x}\");\n        assert_eq!(r_got, want, \"Rust .so read an unexpected subscript at x={x}\");\n\n        verified += 1;\n        drop(cp);\n        drop(rp);\n    }\n\n    assert!(\n        verified > 20,\n        \"too few deep out-of-bounds inputs verified: {verified}\"\n    );\n    assert!(\n        wrapped_negative > 0,\n        \"the x+sign overflow window (row 9) was not reached\"\n    );\n    eprintln!(\"deep OOB subscript parity verified for {verified} inputs\");\n}\n\n","numLines":132,"startLine":1,"totalLines":132}}}
