re the raw IEEE-754 bits.\n#[track_caller]\npub fn assert_same(x: i32) {\n    let l = libs();\n    let c = unsafe { (l.c)(x) };\n    let r = unsafe { (l.rust)(x) };\n    if c.to_bits() != r.to_bits() {\n        let d = decode(x);\n        panic!(\n            \"pow43({x}) diverges: C = {:#010x} ({c:?}), Rust = {:#010x} ({r:?}); decoded = {d:?}\",\n            c.to_bits(),\n            r.to_bits()\n        );\n    }\n}\n\n#[track_caller]\npub fn assert_same_all<I: IntoIterator<Item = i32>>(xs: I) -> usize {\n    let mut n = 0;\n    for x in xs {\n        assert_same(x);\n        n += 1;\n    }\n    assert!(n > 0, \"row exercised zero inputs\");\n    n\n}\n\n// ---------------------------------------------------------------------------\n// Deterministic RNG (SplitMix64) — fixed seed, reproducible\n// ---------------------------------------------------------------------------\n\npub struct Rng(u64);\n\nimpl Rng {\n    pub fn new(seed: u64) -> Self {\n        Rng(seed)\n    }\n    pub fn next_u64(&mut self) -> u64 {\n        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);\n        let mut z = self.0;\n        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);\n        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);\n        z ^ (z >> 31)\n    }\n    pub fn next_i32(&mut self) -> i32 {\n        self.next_u64() as u32 as i32\n    }\n    /// Uniform in `lo..=hi`.\n    pub fn range(&mut self, lo: i32, hi: i32) -> i32 {\n        assert!(lo <= hi);\n        let span = (hi as i64 - lo as i64 + 1) as u64;\n        (lo as i64 + (self.next_u64() % span) as i64) as i32\n    }\n    /// `n` draws from `lo..=hi` kept only when `pred` holds.\n    pub fn take_where<F: Fn(i32) -> bool>(\n        &mut self,\n        n: usize,\n        lo: i32,\n        hi: i32,\n        pred: F,\n    ) -> Vec<i32> {\n        let mut out = Vec::with_capacity(n);\n        let mut guard = 0usize;\n        while out.len() < n && guard < n * 4096 {\n            let x = self.range(lo, hi);\n            if pred(x) {\n                out.push(x);\n            }\n            guard += 1;\n        }\n        assert_eq!(out.len(), n, \"could not draw {n} inputs matching predicate\");\n        out\n    }\n}\n","structuredPatch":[{"oldStart":155,"oldLines":13,"newStart":155,"newLines":14,"lines":[" "," impl TableView {","     /// Address the C would load from for subscript `idx`, or `None` if that","-    /// address is outside the object's readable mapping (in which case a real","-    /// call would trap and must not be attempted).","+    /// address is not inside *any* readable mapping of the process (in which","+    /// case a real call would trap, exactly as the C program would, and must","+    /// not be attempted).","     pub fn readable_at(&self, idx: i32) -> Option<*const f32> {","         // Byte offset exactly as C computes it: `sizeof(float) * idx`, signed.","         let byte_off = (idx as isize).wrapping_mul(4);","         let addr = self.base.wrapping_add(byte_off as usize);","-        if addr >= self.region_start && addr.checked_add(4)? <= self.region_end {","+        if is_readable(addr, 4) {","             Some(addr as *const f32)","         } else {","             None"]},{"oldStart":169,"oldLines":6,"newStart":170,"newLines":65,"lines":["     }"," }"," ","+/// Snapshot of every readable mapping of the process, taken once after both","+/// objects are `dlopen`ed. Used to decide whether an out-of-bounds subscript","+/// can be dereferenced without trapping.","+fn readable_mappings() -> &'static [(usize, usize)] {","+    static MAPS: OnceLock<Vec<(usize, usize)>> = OnceLock::new();","+    MAPS.get_or_init(|| {","+        let mut v = Vec::new();","+        if let Ok(maps) = std::fs::read_to_string(\"/proc/self/maps\") {","+            for line in maps.lines() {","+                let mut it = line.split_whitespace();","+                let Some(range) = it.next() else { continue };","+                let Some(perms) = it.next() else { continue };","+                if !perms.starts_with('r') {","+                    continue;","+                }","+                let Some((s, e)) = range.split_once('-') else {","+                    continue;","+                };","+                if let (Ok(a), Ok(b)) =","+                    (usize::from_str_radix(s, 16), usize::from_str_radix(e, 16))","+                {","+                    if b > a {","+                        v.push((a, b));","+                    }","+                }","+            }","+        }","+        v.sort_unstable();","+        // Merge adjacent/overlapping ranges so a subscript that walks from one","+        // mapping of the same file into the next is still recognised.","+        let mut merged: Vec<(usize, usize)> = Vec::with_capacity(v.len());","+        for (a, b) in v {","+            match merged.last_mut() {","+                Some(last) if a <= last.1 => last.1 = last.1.max(b),","+                _ => merged.push((a, b)),","+            }","+        }","+        merged","+    })","+}","+","+/// True when `[addr, addr + len)` lies wholly inside one readable mapping.","+pub fn is_readable(addr: usize, len: usize) -> bool {","+    let Some(end) = addr.checked_add(len) else {","+        return false;","+    };","+    readable_mappings()","+        .binary_search_by(|&(a, b)| {","+            if b <= addr {","+                std::cmp::Ordering::Less","+            } else if a > addr {","+                std::cmp::Ordering::Greater","+            } else {","+                std::cmp::Ordering::Equal","+            }","+        })","+        .is_ok_and(|i| end <= readable_mappings()[i].1)","+}","+"," /// `dlopen` both objects exactly once per test process."," pub fn libs() -> &'static Libs {","     static LIBS: OnceLock<Libs> = OnceLock::new();"]}],"userModified":false,"replaceAll":false}}
