{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01DhkNTz5Dkop3HikT2urRuY","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/`.\n2\t//!\n3\t//! The C library consists of a single translation unit (`src/lib.c`) whose only\n4\t//! public symbol is `pow43` (declared in `include/lib.h` as\n5\t//! `float pow43(int x);`). There are no namespace/renaming macros in the public\n6\t//! header, so the exported linker symbol is plainly `pow43`.\n7\t//!\n8\t//! The original C:\n9\t//!\n10\t//! ```c\n11\t//! static const float g_pow43[129 + 16] = { ... };\n12\t//!\n13\t//! float pow43(int x) {\n14\t//!     float frac;\n15\t//!     int sign, mult = 256;\n16\t//!     if (x < 129) {\n17\t//!         return g_pow43[16 + x];\n18\t//!     }\n19\t//!     if (x < 1024) {\n20\t//!         mult = 16;\n21\t//!         x <<= 3;\n22\t//!     }\n23\t//!     sign = 2 * x & 64;\n24\t//!     frac = (float)((x & 63) - sign) / ((x & ~63) + sign);\n25\t//!     return g_pow43[16 + ((x + sign) >> 6)] *\n26\t//!            (1.f + frac * ((4.f / 3) + frac * (2.f / 9))) * mult;\n27\t//! }\n28\t//! ```\n29\t//!\n30\t//! Bug-for-bug notes (behaviour deliberately preserved, not \"fixed\"):\n31\t//!\n32\t//! * The table lookup is *not* range checked. `x` in `-16..=128` indexes the\n33\t//!   table in bounds, but any `x < -16` (and, on the second path, any `x`\n34\t//!   large enough that `16 + ((x + sign) >> 6)` exceeds 144) performs an\n35\t//!   out-of-bounds read exactly as the C does. This is reproduced with raw\n36\t//!   pointer arithmetic so that no bounds-check panic is introduced where the\n37\t//!   C would simply read adjacent memory.\n38\t//! * `2 * x`, `x << 3` and `x + sign` are signed `int` operations that can\n39\t//!   overflow for extreme inputs; the C relies on the usual two's-complement\n40\t//!   wrap-around of the target, which is reproduced with wrapping operators\n41\t//!   instead of Rust's panicking/UB-free-but-different arithmetic.\n42\t//! * All arithmetic is performed in single precision (`f32`), matching C's\n43\t//!   `float` semantics on x86-64 (`FLT_EVAL_METHOD == 0`), including the\n44\t//!   left-to-right association of the final multiplication chain.\n45\t\n46\t#![allow(non_upper_case_globals)]\n47\t\n48\tuse std::ffi::c_int;\n49\t\n50\t/// `static const float g_pow43[129 + 16]` from `c_src/src/lib.c`.\n51\t///\n52\t/// 145 entries: the first 16 hold the (negative) values used when `pow43` is\n53\t/// called with a small negative argument, entry 16 onwards hold `x^(4/3)` for\n54\t/// `x = 0 ..= 128`.\n55\tstatic g_pow43: [f32; 129 + 16] = [\n56\t    0.0f32, -1.0f32, -2.519842f32, -4.326749f32, -6.349604f32,\n57\t    -8.549880f32, -10.902724f32, -13.390518f32, -16.000000f32, -18.720754f32,\n58\t    -21.544347f32, -24.463781f32, -27.473142f32, -30.567351f32, -33.741992f32,\n59\t    -36.993181f32, 0.0f32, 1.0f32, 2.519842f32, 4.326749f32,\n60\t    6.349604f32, 8.549880f32, 10.902724f32, 13.390518f32, 16.000000f32,\n61\t    18.720754f32, 21.544347f32, 24.463781f32, 27.473142f32, 30.567351f32,\n62\t    33.741992f32, 36.993181f32, 40.317474f32, 43.711787f32, 47.173345f32,\n63\t    50.699631f32, 54.288352f32, 57.937408f32, 61.644865f32, 65.408941f32,\n64\t    69.227979f32, 73.100443f32, 77.024898f32, 81.000000f32, 85.024491f32,\n65\t    89.097188f32, 93.216975f32, 97.382800f32, 101.593667f32, 105.848633f32,\n66\t    110.146801f32, 114.487321f32, 118.869381f32, 123.292209f32, 127.755065f32,\n67\t    132.257246f32, 136.798076f32, 141.376907f32, 145.993119f32, 150.646117f32,\n68\t    155.335327f32, 160.060199f32, 164.820202f32, 169.614826f32, 174.443577f32,\n69\t    179.305980f32, 184.201575f32, 189.129918f32, 194.090580f32, 199.083145f32,\n70\t    204.107210f32, 209.162385f32, 214.248292f32, 219.364564f32, 224.510845f32,\n71\t    229.686789f32, 234.892058f32, 240.126328f32, 245.389280f32, 250.680604f32,\n72\t    256.000000f32, 261.347174f32, 266.721841f32, 272.123723f32, 277.552547f32,\n73\t    283.008049f32, 288.489971f32, 293.998060f32, 299.532071f32, 305.091761f32,\n74\t    310.676898f32, 316.287249f32, 321.922592f32, 327.582707f32, 333.267377f32,\n75\t    338.976394f32, 344.709550f32, 350.466646f32, 356.247482f32, 362.051866f32,\n76\t    367.879608f32, 373.730522f32, 379.604427f32, 385.501143f32, 391.420496f32,\n77\t    397.362314f32, 403.326427f32, 409.312672f32, 415.320884f32, 421.350905f32,\n78\t    427.402579f32, 433.475750f32, 439.570269f32, 445.685987f32, 451.822757f32,\n79\t    457.980436f32, 464.158883f32, 470.357960f32, 476.577530f32, 482.817459f32,\n80\t    489.077615f32, 495.357868f32, 501.658090f32, 507.978156f32, 514.317941f32,\n81\t    520.677324f32, 527.056184f32, 533.454404f32, 539.871867f32, 546.308458f32,\n82\t    552.764065f32, 559.238575f32, 565.731879f32, 572.243870f32, 578.774440f32,\n83\t    585.323483f32, 591.890898f32, 598.476581f32, 605.080431f32, 611.702349f32,\n84\t    618.342238f32, 625.000000f32, 631.675540f32, 638.368763f32, 645.079578f32,\n85\t];\n86\t\n87\t/// Unchecked `g_pow43[idx]`, mirroring C's unchecked array subscript.\n88\t///\n89\t/// `idx` is the value of the C expression `16 + x` (resp.\n90\t/// `16 + ((x + sign) >> 6)`), which the C code uses verbatim as a subscript\n91\t/// without validating it.\n92\t#[inline]\n93\tfn table(idx: c_int) -> f32 {\n94\t    // SAFETY: this is intentionally as (un)safe as the C it translates. For\n95\t    // every input for which the C program is well defined the index lies in\n96\t    // `0..145`; for the remaining inputs the C performs the same out-of-bounds\n97\t    // load, and reproducing it (rather than panicking) is what keeps the two\n98\t    // libraries observationally identical.\n99\t    unsafe { *g_pow43.as_ptr().offset(idx as isize) }\n100\t}\n101\t\n102\t/// `float pow43(int x)` — see `c_src/include/lib.h`.\n103\t#[unsafe(no_mangle)]\n104\tpub extern \"C\" fn pow43(x: c_int) -> f32 {\n105\t    let mut x: c_int = x;\n106\t    let frac: f32;\n107\t    let sign: c_int;\n108\t    let mut mult: c_int = 256;\n109\t\n110\t    if x < 129 {\n111\t        return table(16i32.wrapping_add(x));\n112\t    }\n113\t    if x < 1024 {\n114\t        mult = 16;\n115\t        x = x.wrapping_shl(3);\n116\t    }\n117\t    // sign = 2 * x & 64;  ->  ((2 * x) & 64)\n118\t    sign = x.wrapping_mul(2) & 64;\n119\t    // frac = (float)((x & 63) - sign) / ((x & ~63) + sign);\n120\t    //\n121\t    // The numerator is cast to `float`; the integer denominator is then\n122\t    // converted to `float` by the usual arithmetic conversions, so the\n123\t    // division itself is a single-precision division.\n124\t    frac = ((x & 63).wrapping_sub(sign) as f32) / ((x & !63).wrapping_add(sign) as f32);\n125\t    // return g_pow43[16 + ((x + sign) >> 6)] *\n126\t    //        (1.f + frac * ((4.f / 3) + frac * (2.f / 9))) * mult;\n127\t    //\n128\t    // `*` is left associative, so the table entry is multiplied by the\n129\t    // polynomial first and that product is then scaled by `mult`.\n130\t    let poly: f32 = 1.0f32 + frac * ((4.0f32 / 3.0f32) + frac * (2.0f32 / 9.0f32));\n131\t    (table(16i32.wrapping_add((x.wrapping_add(sign)) >> 6)) * poly) * (mult as f32)\n132\t}\n133\t\n134\t#[cfg(test)]\n135\tmod tests {\n136\t    use super::pow43;\n137\t\n138\t    /// Raw IEEE-754 bit patterns captured from the original C library\n139\t    /// (`gcc`/`clang`, every optimisation level agrees on these).\n140\t    const REFERENCE: &[(i32, u32)] = &[\n141\t        (-16, 0x00000000),\n142\t        (-15, 0xbf800000),\n143\t        (-1, 0xc213f904),\n144\t        (0, 0x00000000),\n145\t        (1, 0x3f800000),\n146\t        (2, 0x40214517),\n147\t        (127, 0x441f979a),\n148\t        (128, 0x44214518),\n149\t        (129, 0x4422f3b5),\n150\t        (130, 0x4424a371),\n151\t        (255, 0x44ca2138),\n152\t        (256, 0x44cb2ff5),\n153\t        (1023, 0x46210f58),\n154\t        (1024, 0x46214518),\n155\t        (1025, 0x46217adb),\n156\t        (4096, 0x