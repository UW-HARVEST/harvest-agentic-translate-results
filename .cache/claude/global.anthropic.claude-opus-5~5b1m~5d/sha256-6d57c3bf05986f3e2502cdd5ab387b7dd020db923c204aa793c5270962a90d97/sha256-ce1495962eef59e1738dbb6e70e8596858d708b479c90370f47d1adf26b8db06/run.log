          STBDS_FREE(NULL, *(char**) ((char *) a+elemsize*old_index));\n838\t\n839\t        if (old_index != final_index) {\n840\t          memmove((char*) a + elemsize*old_index, (char*) a + elemsize*final_index, elemsize);\n841\t\n842\t          if (mode == STBDS_HM_STRING)\n843\t            slot = stbds_hm_find_slot(a, elemsize, *(char**) ((char *) a+elemsize*old_index + keyoffset), keysize, keyoffset, mode);\n844\t          else\n845\t            slot = stbds_hm_find_slot(a, elemsize,  (char* ) a+elemsize*old_index + keyoffset, keysize, keyoffset, mode);\n846\t          STBDS_ASSERT(slot >= 0);\n847\t          b = &table->storage[slot >> STBDS_BUCKET_SHIFT];\n848\t          i = slot & STBDS_BUCKET_MASK;\n849\t          STBDS_ASSERT(b->index[i] == final_index);\n850\t          b->index[i] = old_index;\n851\t        }\n852\t        stbds_header(raw_a)->length -= 1;\n853\t\n854\t        if (table->used_count < table->used_count_shrink_threshold && table->slot_count > STBDS_BUCKET_LENGTH) {\n855\t          stbds_header(raw_a)->hash_table = stbds_make_hash_index(table->slot_count>>1, table);\n856\t          STBDS_FREE(NULL, table);\n857\t          STBDS_STATS(++stbds_hash_shrink);\n858\t        } else if (table->tombstone_count > table->tombstone_count_threshold) {\n859\t          stbds_header(raw_a)->hash_table = stbds_make_hash_index(table->slot_count   , table);\n860\t          STBDS_FREE(NULL, table);\n861\t          STBDS_STATS(++stbds_hash_rebuild);\n862\t        }\n863\t\n864\t        return a;\n865\t      }\n866\t    }\n867\t  }\n868\t}\n869\t\n870\tstatic char *stbds_strdup(char *str)\n871\t{\n872\t  size_t len = strlen(str)+1;\n873\t  char *p = (char*) STBDS_REALLOC(NULL, 0, len);\n874\t  memmove(p, str, len);\n875\t  return p;\n876\t}\n877\t\n878\t#define STBDS_STRING_ARENA_BLOCKSIZE_MIN  512u\n879\t#define STBDS_STRING_ARENA_BLOCKSIZE_MAX  (1u<<20)\n880\t\n881\tchar *stbds_stralloc(stbds_string_arena *a, char *str)\n882\t{\n883\t  char *p;\n884\t  size_t len = strlen(str)+1;\n885\t  if (len > a->remaining) {\n886\t    size_t blocksize = a->block;\n887\t\n888\t    blocksize = (size_t) (STBDS_STRING_ARENA_BLOCKSIZE_MIN) << (blocksize>>1);\n889\t\n890\t    if (blocksize < (size_t)(STBDS_STRING_ARENA_BLOCKSIZE_MAX))\n891\t      ++a->block;\n892\t\n893\t    if (len > blocksize) {\n894\t      stbds_string_block *sb = (stbds_string_block *) STBDS_REALLOC(NULL, 0, sizeof(*sb)-8 + len);\n895\t      memmove(sb->storage, str, len);\n896\t      if (a->storage) {\n897\t        sb->next = a->storage->next;\n898\t        a->storage->next = sb;\n899\t      } else {\n900\t        sb->next = 0;\n901\t        a->storage = sb;\n902\t        a->remaining = 0;\n903\t      }\n904\t      return sb->storage;\n905\t    } else {\n906\t      stbds_string_block *sb = (stbds_string_block *) STBDS_REALLOC(NULL, 0, sizeof(*sb)-8 + blocksize);\n907\t      sb->next = a->storage;\n908\t      a->storage = sb;\n909\t      a->remaining = blocksize;\n910\t    }\n911\t  }\n912\t\n913\t  STBDS_ASSERT(len <= a->remaining);\n914\t  p = a->storage->storage + a->remaining - len;\n915\t  a->remaining -= len;\n916\t  memmove(p, str, len);\n917\t  return p;\n918\t}\n919\t\n920\tvoid stbds_strreset(stbds_string_arena *a)\n921\t{\n922\t  stbds_string_block *x,*y;\n923\t  x = a->storage;\n924\t  while (x) {\n925\t    y = x->next;\n926\t    STBDS_FREE(NULL, x);\n927\t    x = y;\n928\t  }\n929\t  memset(a, 0, sizeof(*a));\n930\t}\n931\t\n932\t#include <stdio.h>\n933\t#include <assert.h>\n934\t\n935\ttypedef struct { int key,b,c,d; } stbds_struct;\n936\ttypedef struct { int key[2],b,c,d; } stbds_struct2;\n937\t\n938\tstatic char buffer[256];\n939\tchar *strkey(int n)\n940\t{\n941\t   sprintf(buffer, \"test_%d\", n);\n942\t   return buffer;\n943\t}\n944\t\n945\tvoid helxo(char letter)\n946\t{\n947\t  {\n948\t    struct { char *key; char value; } *hash = NULL;\n949\t    char name[4] = \"jen\";\n950\t    shput(hash, \"bob\"   , 'h');\n951\t    shput(hash, \"sally\" , 'e');\n952\t    shput(hash, \"fred\"  , 'l');\n953\t    shput(hash, \"jen\"   , 'x');\n954\t    shput(hash, \"doug\"  , 'o');\n955\t\n956\t    shput(hash, name    , letter);\n957\t\n958\t    for (int z=0; z < shlen(hash); ++z)\n959\t\t    printf(\"%s %c\\n\", hash[z], hash[z].value);\n960\t\n961\t    shfree(hash);\n962\t  }\n963\t}\n964\t"}]},"parent_tool_use_id":"toolu_bdrk_01JJyP2TEcbhMoNNeJZEP6kw","session_id":"53cdfebf-584b-400d-8e8a-413b0712cc6f","uuid":"37d51487-a29b-4018-b3fd-80a02cf6a5d3","timestamp":"2026-08-27T10:16:40.503Z","subagent_type":"general-purpose","task_description":"Independent C↔Rust fidelity review"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01UfK7RYWfbQTuQQkAwQszVD","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/`.\n2\t//!\n3\t//! The C library is a single translation unit (`src/lib.c`) that embeds the\n4\t//! implementation part of `stb_ds.h` (public domain, see `c_src/license.txt`)\n5\t//! together with two extra functions (`strkey`, `helxo`).\n6\t//!\n7\t//! Every public symbol exported by the C shared object is re-exported here with\n8\t//! the identical linker name, signature and observable behaviour (including the\n9\t//! quirks / latent bugs of the original code, which are reproduced verbatim).\n10\t\n11\t#![allow(non_camel_case_types)]\n12\t#![allow(non_snake_case)]\n13\t#![allow(non_upper_case_globals)]\n14\t#![allow(unused_assignments)]\n15\t\n16\tuse core::ffi::{c_char, c_int, c_void};\n17\tuse core::ptr;\n18\t\n19\t// ---------------------------------------------------------------------------\n20\t// libc bindings\n21\t//\n22\t// The C code allocates through `realloc`/`free` (STBDS_REALLOC / STBDS_FREE),\n23\t// so the Rust translation must use the very same allocator: callers of this\n24\t// library free array/hash-map headers with plain `free()` through the\n25\t// `stbds_arrfree` / `stbds_hmfree` macros.\n26\t// ---------------------------------------------------------------------------\n27\textern \"C\" {\n28\t    /// `assert()` is *live* in the C build (`NDEBUG` is not defined - the C `.so`\n29\t    /// imports `__assert_fail`), so `STBDS_ASSERT` is replicated through the very\n30\t    /// same libc entry point: same expression text, same function name and same\n31\t    /// line numbers as `c_src/src/lib.c`.\n32\t    fn __assert_fail(\n33\t        assertion: *const c_char,\n34\t        file: *const c_char,\n35\t        line: u32,\n36\t        function: *const c_char,\n37\t    ) -> !;\n38\t    fn realloc(p: *mut c_void, size: usize) -> *mut c_void;\n39\t    fn free(p: *mut c_void);\n40\t    fn memset(s: *mut c_void, c: c_int, n: usize) -> *mut c_void;\n41\t    fn memcpy(d: *mut c_void, s: *const c_void, n: usize) -> *mut c_void;\n42\t    fn memmove(d: *mut c_void, s: *const c_void, n: usize) -> *mut c_void;\n43\t    fn memcmp(a: *const c_void, b: *const c_void, n: usize) -> c_int;\n44\t    fn strcmp(a: *const c_char, b: *const c_char) -> c_int;\n45\t    fn strlen(s: *const c_char) -> usize;\n46\t    fn printf(fmt: *const c_char, ...) -> c_int;\n47\t    fn sprintf(buf: *mut c_char, fmt: *const c_char, ...) -> c_int;\n48\t}\n49\t\n50\t/// `#define STBDS_ASSERT assert` - aborts through `__assert_fail` exactly like\n51\t/// the C build does.\n52\tmacro_rules! STBDS_ASSERT {\n53\t    ($cond:expr, $text:literal, $line:literal, $func:literal) => {\n54\t        if !($cond) {\n55\t            __assert_fail(\n56\t                concat!($text, \"\\0\").as_ptr() as *const c_char,\n57\t                concat!(\"c_src/src/lib.c\", \"\\0\").as_ptr() as *const c_char,\n58\t                $line,\n59\t                concat!($func, \"\\0\").as_ptr() as *const c_char,\n60\t            );\n61\t        }\n62\t    };\n63\t}\n64\t\n65\t// ---------------------------------------------------------------------------\n66\t// Data structures (layout-identical to the C ones)\n67\t// ---------------------------------------------------------------------------\n68\t\n69\t/// `typedef struct { size_t length; size_t capacity; void *hash_table; ptrdiff_t temp; } stbds_array_header;`\n70\t#[repr(C)]\n71\tstruct stbds_array_header {\n72\t    length: usize,\n73\t    capacity: usize,\n74\t    hash_table: *mut c_void,\n75\t    temp: isize,\n76\t}\n77\t\n78\t/// `typedef struct stbds_string_block { struct stbds_string_block *next; char storage[8]; } stbds_string_block;`\n79\t#[repr(C)]\n80\tstruct stbds_string_block {\n81\t    next: *mut stbds_string_block,\n82\t    storage: [c_char; 8],\n83\t}\n84\t\n85\t/// `struct stbds_string_arena { stbds_string_block *storage; size_t remaining; unsigned char block; unsigned char mode; };`\n86\t#[repr(C)]\n87\tpub struct stbds_string_arena {\n88\t    storage: *mut stbds_string_block,\n89\t    remaining: usize,\n90\t    block: u8,\n91\t    mode: u8,\n92\t}\n93\t\n94\t/// `typedef struct { size_t hash[8]; ptrdiff_t index[8]; } stbds_hash_bucket;`\n95\t#[repr(C)]\n96\tstruct stbds_hash_bucket {\n97\t    hash: [usize; STBDS_BUCKET_LENGTH],\n98\t    index: [isize; STBDS_BUCKET_LENGTH],\n99\t}\n100\t\n101\t/// `typedef struct { ... } stbds_hash_index;`\n102\t#[repr(C)]\n103\tstruct stbds_hash_index {\n104\t    temp_key: *mut c_char,\n105\t    slot_count: usize,\n106\t    used_count: usize,\n107\t    used_count_threshold: usize,\n108\t    used_count_shrink_threshold: usize,\n109\t    tombstone_count: usize,\n110\t    tombstone_count_threshold: usize,\n111\t    seed: usize,\n112\t    slot_count_log2: usize,\n113\t    string: stbds_string_arena,\n114\t    storage: *mut stbds_hash_bucket,\n115\t}\n116\t\n117\t// ---------------------------------------------------------------------------\n118\t// Constants\n119\t// ---------------------------------------------------------------------------\n120\t\n121\tconst STBDS_BUCKET_LENGTH: usize = 8;\n122\tconst STBDS_BUCKET_SHIFT: usize = 3; // (STBDS_BUCKET_LENGTH == 8 ? 3 : 2)\n123\tconst STBDS_BUCKET_MASK: usize = STBDS_BUCKET_LENGTH - 1;\n124\tconst STBDS_CACHE_LINE_SIZE: usize = 64;\n125\t\n126\tconst STBDS_INDEX_EMPTY: isize = -1;\n127\tconst STBDS_INDEX_DELETED: isize = -2;\n128\t\n129\tconst STBDS_HASH_EMPTY: usize = 0;\n130\tconst STBDS_HASH_DELETED: usize = 1;\n131\t\n132\t#[allow(dead_code)]\n133\tconst STBDS_HM_BINARY: c_int = 0;\n134\tconst STBDS_HM_STRING: c_int = 1;\n135\t\n136\t#[allow(dead_code)]\n137\tconst STBDS_SH_NONE: c_int = 0;\n138\tconst STBDS_SH_DEFAULT: c_int = 1;\n139\tconst STBDS_SH_STRDUP: c_int = 2;\n140\tconst STBDS_SH_ARENA: c_int = 3;\n141\t\n142\tconst STBDS_SIZE_T_BITS: u32 = (core::mem::size_of::<usize>() * 8) as u32;\n143\t\n144\tconst STBDS_SIPHASH_C_ROUNDS: usize = 2;\n145\tconst STBDS_SIPHASH_D_ROUNDS: usize = 4;\n146\t\n147\tconst STBDS_STRING_ARENA_BLOCKSIZE_MIN: usize = 512;\n148\tconst STBDS_STRING_ARENA_BLOCKSIZE_MAX: usize = 1 << 20;\n149\t\n150\tconst HEADER_SIZE: usize = core::mem::size_of::<stbds_array_header>();\n151\t\n152\t// ---------------------------------------------------------------------------\n153\t// Small helpers mirroring the C macros\n154\t// ---------------------------------------------------------------------------\n155\t\n156\t/// `#define stbds_header(t)  ((stbds_array_header *) (t) - 1)`\n157\t#[inline]\n158\tunsafe fn stbds_header(t: *mut c_void) -> *mut stbds_array_header {\n159\t    (t as *mut u8).wrapping_sub(HEADER_SIZE) as *mut stbds_array_header\n160\t}\n161\t\n162\t/// `#define stbds_arrlen(a)  ((a) ? (ptrdiff_t) stbds_header(a)->length : 0)`\n163\t#[inline]\n164\tunsafe fn stbds_arrlen(a: *mut c_void) -> isize {\n165\t    if a.is_null() {\n166\t        0\n167\t    } else {\n168\t        (*stbds_header(a)).length as isize\n169\t    }\n170\t}\n171\t\n172\t/// `#define stbds_arrcap(a)  ((a) ? stbds_header(a)->capacity : 0)`\n173\t#[inline]\n174\tunsafe fn stbds_arrcap(a: *mut c_void) -> usize {\n175\t    if a.is_null() {\n176\t        0\n177\t    } else {\n178\t        (*stbds_header(a)).capacity\n179\t    }\n180\t}\n181\t\n182\t/// `#define stbds_temp(t)    stbds_header(t)->temp`\n183\t#[inline]\n184\tunsafe fn stbds_temp_get(t: *mut c_void) -> isize {\n185\t    (*stbds_header(t)).temp\n186\t}\n187\t\n188\t#[inline]\n189\tunsafe fn stbds_temp_set(t: *mut c_void, v: isize) {\n190\t    (*stbds_header(t)).temp = v;\n191\t}\n192\t\n193\t/// `#define stbds_temp_key(t) (*(char **) stbds_header(t)->hash_table)`\n194\t#[inline]\n195\tunsafe fn stbds_temp_key_set(t: *mut c_void, v: *mut c_char) {\n196\t    *((*stbds_header(t)).hash_table as *mut *mut c_char) = v;\n197\t}\n198\t\n199\t/// `#define stbds_hash_table(a)  ((stbds_hash_index *) stbds_header(a)->hash_table)`\n200\t#[inline]\n201\tunsafe fn stbds_hash_table(a: *mut c_void) -> *mut stbds_hash_index {\n202\t    (*stbds_header(a)).hash_table as *mut stbds_hash_index\n203\t}\n204\t\n205\t/// `#define STBDS_HASH_TO_ARR(x,elemsize) ((char *) (x) - (elemsize))`\n206\t#[inline]\n207\tfn STBDS_HASH_TO_ARR(x: *mut c_void, elemsize: usize) -> *mut c_void {\n208\t    (x as *mut u8).wrapping_sub(elemsize) as *mut c_void\n209\t}\n210\t\n211\t/// `#define STBDS_ARR_TO_HASH(x,elemsize) ((char *) (x) + (elemsize))`\n212\t#[inline]\n213\tfn STBDS_ARR_TO_HASH(x: *mut c_void, elemsize: usize) -> *mut c_void {\n214\t    (x as *mut u8).wrapping_add(elemsize) as *mut c_void\n215\t}\n216\t\n217\t/// `#define STBDS_ALIGN_FWD(n,a) (((n) + (a) - 1) & ~((a)-1))`\n218\t#[inline]\n219\tfn STBDS_ALIGN_FWD(n: usize, a: usize) -> usize {\n220\t    n.wrapping_add(a - 1) & !(a - 1)\n221\t}\n222\t\n223\t/// `#define STBDS_ROTATE_LEFT(val, n) (((val) << (n)) | ((val) >> (STBDS_SIZE_T_BITS - (n))))`\n224\t#[inline]\n225\tfn STBDS_ROTATE_LEFT(val: usize, n: u32) -> usize {\n226\t    (val << n) | (val >> (STBDS_SIZE_T_BITS - n))\n227\t}\n228\t\n229\t/// `#define STBDS_ROTATE_RIGHT(val, n) (((val) >> (n)) | ((val) << (STBDS_SIZE_T_BITS - (n))))`\n230\t#[inline]\n231\tfn STBDS_ROTATE_RIGHT(val: usize, n: u32) -> usize {\n232\t    (val >> n) | (val << (STBDS_SIZE_T_BITS - n))\n233\t}\n234\t\n235\t// ---------------------------------------------------------------------------\n236\t// stbds_arrgrowf / stbds_arrfreef\n237\t// ---------------------------------------------------------------------------\n238\t\n239\t#[unsafe(no_mangle)]\n240\tpub unsafe extern \"C\" fn stbds_arrgrowf(\n241\t    a: *mut c_void,\n242\t    elemsize: usize,\n243\t    addlen: usize,\n244\t    mut min_cap: usize,\n245\t) -> *mut c_void {\n246\t    let b: *mut c_void;\n247\t    let min_len: usize = (stbds_arrlen(a) as usize).wrapping_add(addlen);\n248\t\n249\t    if min_len > min_cap {\n250\t        min_cap = min_len;\n251\t    }\n252\t\n253\t    if min_cap <= stbds_arrcap(a) {\n254\t        return a;\n255\t    }\n256\t\n257\t    if min_cap < 2usize.wrapping_mul(stbds_arrcap(a)) {\n258\t        min_cap = 2usize.wrapping_mul(stbds_arrcap(a));\n259\t    } else if min_cap < 4 {\n260\t        min_cap = 4;\n261\t    }\n262\t\n263\t    let old: *mut c_void = if a.is_null() {\n264\t        ptr::null_mut()\n265\t    } else {\n266\t        stbds_header(a) as *mut c_void\n267\t    };\n268\t    let raw = realloc(old, elemsize.wrapping_mul(min_cap).wrapping_add(HEADER_SIZE));\n269\t    b = (raw as *mut u8).wrapping_add(HEADER_SIZE) as *mut c_void;\n270\t    if a.is_null() {\n271\t        (*stbds_header(b)).length = 0;\n272\t        (*stbds_header(b)).hash_table = ptr::null_mut();\n273\t        (*stbds_header(b)).temp = 0;\n274\t    }\n275\t    (*stbds_header(b)).capacity = min_cap;\n276\t\n277\t    b\n278\t}\n279\t\n280\t#[unsafe(no_mangle)]\n281\tpub unsafe extern \"C\" fn stbds_arrfreef(a: *mut c_void) {\n282\t    free(stbds_header(a) as *mut c_void);\n283\t}\n284\t\n285\t// ---------------------------------------------------------------------------\n286\t// hash seed / rng\n287\t// ---------------------------------------------------------------------------\n288\t\n289\tstatic mut stbds_hash_seed: usize = 0x31415926;\n290\t\n291\t#[unsafe(no_mangle)]\n292\tpub unsafe extern \"C\" fn stbds_rand_seed(seed: usize) {\n293\t    stbds_hash_seed = seed;\n294\t}\n295\t\n296\t/// ```c\n297\t/// #define stbds_load_32_or_64(var, temp, v32, v64_hi, v64_lo)   \\\n298\t///   temp = v64_lo ^ v32, temp <<= 16, temp <<= 16, temp >>= 16, temp >>= 16, \\\n299\t///   var = v64_hi, var <<= 16, var <<= 16,                       \\\n300\t///   var ^= temp ^ v32\n301\t/// ```\n302\t#[inline]\n303\tfn stbds_load_32_or_64(v32: u32, v64_hi: u32, v64_lo: u32) -> usize {\n304\t    // In C `v64_lo ^ v32` is computed in `unsigned int` (32 bits) and then\n305\t    // widened to size_t, so the intermediate is naturally 32 bits wide.\n306\t    let mut temp: usize = (v64_lo ^ v32) as usize;\n307\t    temp <<= 16;\n308\t    temp <<= 16;\n309\t    temp >>= 16;\n310\t    temp >>= 16;\n311\t    let mut var: usize = v64_hi as usize;\n312\t    var <<= 16;\n313\t    var <<= 16;\n314\t    var ^= temp ^ (v32 as usize);\n315\t    var\n316\t}\n317\t\n318\t// ---------------------------------------------------------------------------\n319\t// hash index construction\n320\t// ---------------------------------------------------------------------------\n321\t\n322\tfn stbds_probe_position(hash: usize, slot_count: usize, _slot_log2: usize) -> usize {\n323\t    hash & slot_count.wrapping_sub(1)\n324\t}\n325\t\n326\tfn stbds_log2(mut slot_count: usize) -> usize {\n327\t    let mut n: usize = 0;\n328\t    while slot_count > 1 {\n329\t        slot_count >>= 1;\n330\t        n += 1;\n331\t    }\n332\t    n\n333\t}\n334\t\n335\tunsafe fn stbds_make_hash_index(\n336\t    slot_count: usize,\n337\t    ot: *mut stbds_hash_index,\n338\t) -> *mut stbds_hash_index {\n339\t    let t: *mut stbds_hash_index = realloc(\n340\t        ptr::null_mut(),\n341\t        (slot_count >> STBDS_BUCKET_SHIFT)\n342\t            .wrapping_mul(core::mem::size_of::<stbds_hash_bucket>())\n343\t            .wrapping_add(core::mem::size_of::<stbds_hash_index>())\n344\t            .wrapping_add(STBDS_CACHE_LINE_SIZE - 1),\n345\t    ) as *mut stbds_hash_index;\n346\t\n347\t    (*t).storage = STBDS_ALIGN_FWD(t.wrapping_add(1) as usize, STBDS_CACHE_LINE_SIZE)\n348\t        as *mut stbds_hash_bucket;\n349\t    (*t).slot_count = slot_count;\n350\t    (*t).slot_count_log2 = stbds_log2(slot_count);\n351\t    (*t).tombstone_count = 0;\n352\t    (*t).used_count = 0;\n353\t\n354\t    (*t).used_count_threshold = slot_count - (slot_count >> 2);\n355\t    (*t).tombstone_count_threshold = (slot_count >> 3) + (slot_count >> 4);\n356\t    (*t).used_count_shrink_threshold = slot_count >> 2;\n357\t\n358\t    if slot_count <= STBDS_BUCKET_LENGTH {\n359\t        (*t).used_count_shrink_threshold = 0;\n360\t    }\n361\t    STBDS_ASSERT!(\n362\t        (*t)\n363\t            .used_count_threshold\n364\t            .wrapping_add((*t).tombstone_count_threshold)\n365\t            < (*t).slot_count,\n366\t        \"t->used_count_threshold + t->tombstone_count_threshold < t->slot_count\",\n367\t        401,\n368\t        \"stbds_hash_index *stbds_make_hash_index(size_t, stbds_hash_index *)\"\n369\t    );\n370\t\n371\t    if !ot.is_null() {\n372\t        // `t->string = ot->string;` - a whole-struct copy (gcc copies the trailing\n373\t        // padding bytes too, so do a byte-wise copy rather than a field-wise one)\n374\t        ptr::copy_nonoverlapping(\n375\t            ptr::addr_of!((*ot).string) as *const u8,\n376\t            ptr::addr_of_mut!((*t).string) as *mut u8,\n377\t            core::mem::size_of::<stbds_string_arena>(),\n378\t        );\n379\t        (*t).seed = (*ot).seed;\n380\t    } else {\n381\t        memset(\n382\t            ptr::addr_of_mut!((*t).string) as *mut c_void,\n383\t            0,\n384\t            core::mem::size_of::<stbds_string_arena>(),\n385\t        );\n386\t        (*t).seed = stbds_hash_seed;\n387\t        let a = stbds_load_32_or_64(2147001325, 0x27bb2ee6, 0x87b0b0fd);\n388\t        let b = stbds_load_32_or_64(715136305, 0, 0xb504f32d);\n389\t        stbds_hash_seed = stbds_hash_seed.wrapping_mul(a).wrapping_add(b);\n390\t    }\n391\t\n392\t    {\n393\t        let mut i: usize = 0;\n394\t        while i < slot_count >> STBDS_BUCKET_SHIFT {\n395\t            let b: *mut stbds_hash_bucket = (*t).storage.add(i);\n396\t            for j in 0..STBDS_BUCKET_LENGTH {\n397\t                (*b).hash[j] = STBDS_HASH_EMPTY;\n398\t            }\n399\t            for j in 0..STBDS_BUCKET_LENGTH {\n400\t                (*b).index[j] = STBDS_INDEX_EMPTY;\n401\t            }\n402\t            i += 1;\n403\t        }\n404\t    }\n405\t\n406\t    if !ot.is_null() {\n407\t        (*t).used_count = (*ot).used_count;\n408\t        let mut i: usize = 0;\n409\t        while i < (*ot).slot_count >> STBDS_BUCKET_SHIFT {\n410\t            let ob: *mut stbds_hash_bucket = (*ot).storage.add(i);\n411\t            for j in 0..STBDS_BUCKET_LENGTH {\n412\t                if (*ob).index[j] >= 0 {\n413\t                    let hash = (*ob).hash[j];\n414\t                    let mut pos =\n415\t                        stbds_probe_position(hash, (*t).slot_count, (*t).slot_count_log2);\n416\t                    let mut step = STBDS_BUCKET_LENGTH;\n417\t                    'outer: loop {\n418\t                        let bucket: *mut stbds_hash_bucket =\n419\t                            (*t).storage.add(pos >> STBDS_BUCKET_SHIFT);\n420\t\n421\t                        let mut z = pos & STBDS_BUCKET_MASK;\n422\t                        while z < STBDS_BUCKET_LENGTH {\n423\t                            if (*bucket).hash[z] == 0 {\n424\t                                (*bucket).hash[z] = hash;\n425\t                                (*bucket).index[z] = (*ob).index[j];\n426\t                                break 'outer;\n427\t                            }\n428\t                            z += 1;\n429\t                        }\n430\t\n431\t                        let limit = pos & STBDS_BUCKET_MASK;\n432\t                        let mut z = 0usize;\n433\t                        while z < limit {\n434\t                            if (*bucket).hash[z] == 0 {\n435\t                                (*bucket).hash[z] = hash;\n436\t                                (*bucket).index[z] = (*ob).index[j];\n437\t                                break 'outer;\n438\t                            }\n439\t                            z += 1;\n440\t                        }\n441\t\n442\t                        pos = pos.wrapping_add(step);\n443\t                        step = step.wrapping_add(STBDS_BUCKET_LENGTH);\n444\t                        pos &= (*t).slot_count.wrapping_sub(1);\n445\t                    }\n446\t                }\n447\t            }\n448\t            i += 1;\n449\t        }\n450\t    }\n451\t\n452\t    t\n453\t}\n454\t\n455\t// ---------------------------------------------------------------------------\n456\t// hashing\n457\t// ---------------------------------------------------------------------------\n458\t\n459\t#[unsafe(no_mangle)]\n460\tpub unsafe extern \"C\" fn stbds_hash_string(str_: *mut c_char, seed: usize) -> usize {\n461\t    let mut hash: usize = seed;\n462\t    let mut str_ = str_;\n463\t    while *str_ != 0 {\n464\t        hash = STBDS_ROTATE_LEFT(hash, 9).wrapping_add(*str_ as u8 as usize);\n465\t        str_ = str_.add(1);\n466\t    }\n467\t\n468\t    hash ^= seed;\n469\t    hash = (!hash).wrapping_add(hash << 18);\n470\t    hash ^= hash ^ STBDS_ROTATE_RIGHT(hash, 31);\n471\t    hash = hash.wrapping_mul(21);\n472\t    hash ^= hash ^ STBDS_ROTATE_RIGHT(hash, 11);\n473\t    hash = hash.wrapping_add(hash << 6);\n474\t    hash ^= STBDS_ROTATE_RIGHT(hash, 22);\n475\t    hash.wrapping_add(seed)\n476\t}\n477\t\n478\tunsafe fn stbds_siphash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n479\t    let mut d = p as *const u8;\n480\t    let mut i: usize;\n481\t    let mut v0: usize;\n482\t    let mut v1: usize;\n483\t    let mut v2: usize;\n484\t    let mut v3: usize;\n485\t    let mut data: usize;\n486\t\n487\t    v0 = (((0x736f6d65usize << 16) << 16).wrapping_add(0x70736575)) ^ seed;\n488\t    v1 = (((0x646f7261usize << 16) << 16).wrapping_add(0x6e646f6d)) ^ !seed;\n489\t    v2 = (((0x6c796765usize << 16) << 16).wrapping_add(0x6e657261)) ^ seed;\n490\t    v3 = (((0x74656462usize << 16) << 16).wrapping_add(0x79746573)) ^ !seed;\n491\t\n492\t    v0 ^= 0x0706050403020100usize ^ seed;\n493\t    v1 ^= 0x0f0e0d0c0b0a0908usize ^ !seed;\n494\t    v2 ^= 0x0706050403020100usize ^ seed;\n495\t    v3 ^= 0x0f0e0d0c0b0a0908usize ^ !seed;\n496\t\n497\t    macro_rules! STBDS_SIPROUND {\n498\t        () => {{\n499\t            v0 = v0.wrapping_add(v1);\n500\t            v1 = STBDS_ROTATE_LEFT(v1, 13);\n501\t            v1 ^= v0;\n502\t            v0 = STBDS_ROTATE_LEFT(v0, STBDS_SIZE_T_BITS / 2);\n503\t            v2 = v2.wrapping_add(v3);\n504\t            v3 = STBDS_ROTATE_LEFT(v3, 16);\n505\t            v3 ^= v2;\n506\t            v2 = v2.wrapping_add(v1);\n507\t            v1 = STBDS_ROTATE_LEFT(v1, 17);\n508\t            v1 ^= v2;\n509\t            v2 = STBDS_ROTATE_LEFT(v2, STBDS_SIZE_T_BITS / 2);\n510\t            v0 = v0.wrapping_add(v3);\n511\t            v3 = STBDS_ROTATE_LEFT(v3, 21);\n512\t            v3 ^= v0;\n513\t        }};\n514\t    }\n515\t\n516\t    i = 0;\n517\t    while i + core::mem::size_of::<usize>() <= len {\n518\t        // `data = d[0] | (d[1] << 8) | (d[2] << 16) | (d[3] << 24);`\n519\t        //\n520\t        // In C this expression has type `int`; when d[3] >= 0x80 the result is\n521\t        // negative and the conversion to size_t sign-extends it, setting the\n522\t        // whole upper half of `data`.  That behaviour is reproduced here.\n523\t        let w0: i32 = (*d.add(0) as i32)\n524\t            | ((*d.add(1) as i32) << 8)\n525\t            | ((*d.add(2) as i32) << 16)\n526\t            | (((*d.add(3) as u32) << 24) as i32);\n527\t        data = w0 as i64 as usize;\n528\t\n529\t        let w1: i32 = (*d.add(4) as i32)\n530\t            | ((*d.add(5) as i32) << 8)\n531\t            | ((*d.add(6) as i32) << 16)\n532\t            | (((*d.add(7) as u32) << 24) as i32);\n533\t        data |= ((w1 as i64 as usize) << 16) << 16;\n534\t\n535\t        v3 ^= data;\n536\t        for _ in 0..STBDS_SIPHASH_C_ROUNDS {\n537\t            STBDS_SIPROUND!();\n538\t        }\n539\t        v0 ^= data;\n540\t\n541\t        i += core::mem::size_of::<usize>();\n542\t        d = d.add(core::mem::size_of::<usize>());\n543\t    }\n544\t\n545\t    data = len << (STBDS_SIZE_T_BITS - 8);\n546\t    // switch (len - i) with C fall-through semantics\n547\t    let rem = len - i;\n548\t    if rem >= 7 {\n549\t        data |= ((*d.add(6) as usize) << 24) << 24;\n550\t    }\n551\t    if rem >= 6 {\n552\t        data |= ((*d.add(5) as usize) << 20) << 20;\n553\t    }\n554\t    if rem >= 5 {\n555\t        data |= ((*d.add(4) as usize) << 16) << 16;\n556\t    }\n557\t    if rem >= 4 {\n558\t        // `data |= (d[3] << 24);` -- int expression, sign-extended into size_t\n559\t        data |= ((((*d.add(3) as u32) << 24) as i32) as i64) as usize;\n560\t    }\n561\t    if rem >= 3 {\n562\t        data |= (((*d.add(2) as i32) << 16) as i64) as usize;\n563\t    }\n564\t    if rem >= 2 {\n565\t        data |= (((*d.add(1) as i32) << 8) as i64) as usize;\n566\t    }\n567\t    if rem >= 1 {\n568\t        data |= *d.add(0) as usize;\n569\t    }\n570\t\n571\t    v3 ^= data;\n572\t    for _ in 0..STBDS_SIPHASH_C_ROUNDS {\n573\t        STBDS_SIPROUND!();\n574\t    }\n575\t    v0 ^= data;\n576\t    v2 ^= 0xff;\n577\t    for _ in 0..STBDS_SIPHASH_D_ROUNDS {\n578\t        STBDS_SIPROUND!();\n579\t    }\n580\t\n581\t    v0 ^ v1 ^ v2 ^ v3\n582\t}\n583\t\n584\t#[unsafe(no_mangle)]\n585\tpub unsafe extern \"C\" fn stbds_hash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n586\t    stbds_siphash_bytes(p, len, seed)\n587\t}\n588\t\n589\t// ---------------------------------------------------------------------------\n590\t// hash map internals\n591\t// ---------------------------------------------------------------------------\n592\t\n593\tunsafe fn stbds_is_key_equal(\n594\t    a: *mut c_void,\n595\t    elemsize: usize,\n596\t    key: *mut c_void,\n597\t    keysize: usize,\n598\t    keyoffset: usize,\n599\t    mode: c_int,\n600\t    i: isize,\n601\t) -> c_int {\n602\t    if mode >= STBDS_HM_STRING {\n603\t        let stored = *((a as *mut u8)\n604\t            .wrapping_offset(elemsize.wrapping_mul(i as usize) as isize)\n605\t            .wrapping_add(keyoffset) as *mut *mut c_char);\n606\t        (0 == strcmp(key as *mut c_char, stored)) as c_int\n607\t    } else {\n608\t        (0 == memcmp(\n