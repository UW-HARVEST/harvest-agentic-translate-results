        step += STBDS_BUCKET_LENGTH;\n677\t        pos &= (*table).slot_count - 1;\n678\t    }\n679\t}\n680\t\n681\t#[unsafe(no_mangle)]\n682\tpub unsafe extern \"C\" fn stbds_hmget_key_ts(\n683\t    a: *mut c_void,\n684\t    elemsize: usize,\n685\t    key: *mut c_void,\n686\t    keysize: usize,\n687\t    temp: *mut isize,\n688\t    mode: c_int,\n689\t) -> *mut c_void {\n690\t    let keyoffset: usize = 0;\n691\t    if a.is_null() {\n692\t        let a = stbds_arrgrowf(ptr::null_mut(), elemsize, 0, 1);\n693\t        (*stbds_header(a)).length += 1;\n694\t        memset(a, 0, elemsize);\n695\t        *temp = STBDS_INDEX_EMPTY;\n696\t        STBDS_ARR_TO_HASH(a, elemsize)\n697\t    } else {\n698\t        let table: *mut stbds_hash_index;\n699\t        let raw_a = STBDS_HASH_TO_ARR(a, elemsize);\n700\t        table = (*stbds_header(raw_a)).hash_table as *mut stbds_hash_index;\n701\t        if table.is_null() {\n702\t            *temp = -1;\n703\t        } else {\n704\t            let slot = stbds_hm_find_slot(a, elemsize, key, keysize, keyoffset, mode);\n705\t            if slot < 0 {\n706\t                *temp = STBDS_INDEX_EMPTY;\n707\t            } else {\n708\t                let b = (*table).storage.offset(slot >> STBDS_BUCKET_SHIFT);\n709\t                *temp = (*b).index[(slot as usize) & STBDS_BUCKET_MASK];\n710\t            }\n711\t        }\n712\t        a\n713\t    }\n714\t}\n715\t\n716\t#[unsafe(no_mangle)]\n717\tpub unsafe extern \"C\" fn stbds_hmget_key(\n718\t    a: *mut c_void,\n719\t    elemsize: usize,\n720\t    key: *mut c_void,\n721\t    keysize: usize,\n722\t    mode: c_int,\n723\t) -> *mut c_void {\n724\t    let mut temp: isize = 0;\n725\t    let p = stbds_hmget_key_ts(a, elemsize, key, keysize, &mut temp, mode);\n726\t    stbds_temp_set(STBDS_HASH_TO_ARR(p, elemsize), temp);\n727\t    p\n728\t}\n729\t\n730\t#[unsafe(no_mangle)]\n731\tpub unsafe extern \"C\" fn stbds_hmput_default(a: *mut c_void, elemsize: usize) -> *mut c_void {\n732\t    let mu