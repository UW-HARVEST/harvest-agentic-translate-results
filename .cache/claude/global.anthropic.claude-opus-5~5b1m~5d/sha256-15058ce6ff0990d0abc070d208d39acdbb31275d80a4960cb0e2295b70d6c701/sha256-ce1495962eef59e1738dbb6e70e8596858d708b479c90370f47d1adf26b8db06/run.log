{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_gfcvud3j334ph6vdv5qvdchnjnkjbbfaj5xrb2uncumouamp4zya","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01EEpwdmFaKvvCBCMjtCMN6o","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-gKqcQz/translation/tests/scratch.rs","content":"mod common;\nuse common::*;\nuse std::os::raw::{c_char, c_int};\n\ntype F4 = unsafe extern \"C\" fn(*const c_char, *mut c_char, c_int, c_int) -> c_int;\ntype F5 = unsafe extern \"C\" fn(*const c_char, *mut c_char, c_int, c_int, c_int) -> c_int;\ntype FBound = unsafe extern \"C\" fn(c_int) -> c_int;\n\n#[test]\nfn scratch() {\n    let p = libs();\n    let cd: F4 = p.c.sym(\"LZ4_decompress_safe\");\n    let rd: F4 = p.r.sym(\"LZ4_decompress_safe\");\n    let cp: F5 = p.c.sym(\"LZ4_decompress_safe_partial\");\n    let rp: F5 = p.r.sym(\"LZ4_decompress_safe_partial\");\n    let cc: F4 = p.c.sym(\"LZ4_compress_default\");\n    let bound: FBound = p.c.sym(\"LZ4_compressBound\");\n\n    let mut rng = Rng::new(0x6003);\n    let mut cases: Vec<Vec<u8>> = Vec::new();\n    for len in [0usize, 1, 2, 3, 4, 5, 8, 16, 32, 64, 128, 512, 2000] {\n        for _ in 0..40 {\n            cases.push(gen(Shape::Random, len, &mut rng));\n        }\n    }\n    for &n in &[13usize, 100, 1000, 20_000] {\n        for &shape in &[Shape::Text, Shape::Runs, Shape::Random] {\n            let data = gen(shape, n, &mut rng);\n            let full = unsafe { bound(n as c_int) } as usize;\n            let mut comp = vec![0u8; full];\n            let clen = unsafe {\n                cc(\n                    data.as_ptr() as *const c_char,\n                    comp.as_mut_ptr() as *mut c_char,\n                    n as c_int,\n                    full as c_int,\n                )\n            } as usize;\n            comp.truncate(clen);\n            cases.push(comp.clone());\n            for _ in 0..60 {\n                let mut bad = comp.clone();\n                let pos = rng.below(bad.len());\n                bad[pos] ^= 1u8 << rng.below(8);\n                cases.push(bad);\n            }\n            for cut in [0usize, 1, clen / 3, clen / 2, clen - 1] {\n                cases.push(comp[..cut.min(clen)].to_vec());\n            }\n        }\n    }\n    for tok in [0xF0u8, 0x0F, 0xFF, 0xF1, 0x1F] {\n        for tail in 0..6usize {\n            let mut v = vec![tok];\n            v.extend_from_slice(&vec![0xFFu8; tail]);\n            cases.push(v);\n        }\n    }\n    for lit in [0u8, 1, 2] {\n        for off in [0u16, 1, 0xFFFF, 0x8000] {\n            let mut v = vec![(lit << 4) | 0x0F];\n            v.extend_from_slice(&vec![0x41u8; lit as usize]);\n            v.extend_from_slice(&off.to_le_bytes());\n            v.extend_from_slice(&[0xFF, 0xFF, 0x00]);\n            cases.push(v);\n        }\n    }\n\n    for (i, blk) in cases.iter().enumerate() {\n        for &dcap in &[0i32, 1, 5, 16, 100, 4096, 65536] {\n            let sz = dcap.max(0) as usize + 64;\n            let mut co = vec![0x99u8; sz];\n            let mut ro = vec![0x99u8; sz];\n            eprintln!(\"case={} len={} dcap={} -> C\", i, blk.len(), dcap);\n            let a = unsafe {\n                cd(\n                    blk.as_ptr() as *const c_char,\n                    co.as_mut_ptr() as *mut c_char,\n                    blk.len() as c_int,\n                    dcap,\n                )\n            };\n            eprintln!(\"case={} dcap={} C={} -> R\", i, dcap, a);\n            let b = unsafe {\n                rd(\n                    blk.as_ptr() as *const c_char,\n                    ro.as_mut_ptr() as *mut c_char,\n                    blk.len() as c_int,\n                    dcap,\n                )\n            };\n            assert_eq!(a, b, \"safe case={} dcap={} blk={}\", i, dcap, hexdump(blk));\n            for &t in &[-1i32, 0, 1, dcap / 2, dcap, dcap + 1] {\n                eprintln!(\"case={} dcap={} t={} -> partial C\", i, dcap, t);\n                let a = unsafe {\n                    cp(\n                        blk.as_ptr() as *const c_char,\n                        co.as_mut_ptr() as *mut c_char,\n                        blk.len() as c_int,\n                        t,\n                        dcap,\n                    )\n                };\n                eprintln!(\"case={} dcap={} t={} partial C={} -> R\", i, dcap, t, a);\n                let b = unsafe {\n                    rp(\n                        blk.as_ptr() as *const c_char,\n                        ro.as_mut_ptr() as *mut c_char,\n                        blk.len() as c_int,\n                        t,\n                        dcap,\n                    )\n                };\n                assert_eq!(a, b, \"partial case={} dcap={} t={} blk={}\", i, dcap, t, hexdump(blk));\n            }\n        }\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1229,"cache_read_input_tokens":317760,"cache_creation":{"ephemeral_5m_input_tokens":1229,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"fbbc4e99-c89f-4b88-83bb-165c018df800","uuid":"5a845af2-82bc-46f3-a4e3-43a4196d5eb8","timestamp":"2026-09-04T04:04:05.039Z"}
