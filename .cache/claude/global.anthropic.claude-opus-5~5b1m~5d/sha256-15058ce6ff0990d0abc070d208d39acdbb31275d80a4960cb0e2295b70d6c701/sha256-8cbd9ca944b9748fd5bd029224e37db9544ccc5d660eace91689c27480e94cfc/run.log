{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_0169fPbGB8XmPxWXoBTiYR3d","type":"tool_result","content":"1\t//! Phase C — error-path differential tests for the `lz4frame.c` surface.\n2\t//!\n3\t//! Covers ERRORS.md rows 71-115 plus 142, 143, 144, 156.  Every assertion\n4\t//! compares the EXACT `LZ4F_*` return value (i.e. the exact error code, not\n5\t//! merely \"both failed\"), and where relevant the exact in/out `*srcSizePtr` /\n6\t//! `*dstSizePtr` values the C leaves behind.\n7\tmod common;\n8\tuse common::*;\n9\tuse std::ffi::c_void;\n10\tuse std::os::raw::{c_int, c_uint};\n11\tuse std::ptr;\n12\t\n13\t// ---------------------------------------------------------------------------\n14\t// small helpers that drive one library at a time\n15\t// ---------------------------------------------------------------------------\n16\t\n17\tstruct Cctx {\n18\t    lib: &'static Lib,\n19\t    p: *mut c_void,\n20\t}\n21\timpl Cctx {\n22\t    fn new(lib: &'static Lib) -> Cctx {\n23\t        let mut p: *mut c_void = ptr::null_mut();\n24\t        let rc = unsafe {\n25\t            lib.get::<Fn_F_createCompressionContext>(\"LZ4F_createCompressionContext\")(\n26\t                &mut p,\n27\t                LZ4F_VERSION,\n28\t            )\n29\t        };\n30\t        assert!(!is_error(rc), \"{}: createCompressionContext -> {}\", lib.which, show(rc));\n31\t        assert!(!p.is_null());\n32\t        Cctx { lib, p }\n33\t    }\n34\t}\n35\timpl Drop for Cctx {\n36\t    fn drop(&mut self) {\n37\t        unsafe {\n38\t            self.lib\n39\t                .get::<Fn_F_freeCompressionContext>(\"LZ4F_freeCompressionContext\")(self.p);\n40\t        }\n41\t    }\n42\t}\n43\t\n44\tstruct Dctx {\n45\t    lib: &'static Lib,\n46\t    p: *mut c_void,\n47\t}\n48\timpl Dctx {\n49\t    fn new(lib: &'static Lib) -> Dctx {\n50\t        let mut p: *mut c_void = ptr::null_mut();\n51\t        let rc = unsafe {\n52\t            lib.get::<Fn_F_createDecompressionContext>(\"LZ4F_createDecompressionContext\")(\n53\t                &mut p,\n54\t                LZ4F_VERSION,\n55\t            )\n56\t        };\n57\t        assert!(!is_error(rc), \"{}: createDecompressionContext -> {}\", lib.which, show(rc));\n58\t        assert!(!p.is_null());\n59\t        Dctx { lib, p }\n60\t    }\n61\t    fn reset(&self) {\n62\t        unsafe {\n63\t            self.lib\n64\t                .get::<Fn_F_resetDecompressionContext>(\"LZ4F_resetDecompressionContext\")(self.p);\n65\t        }\n66\t    }\n67\t}\n68\timpl Drop for Dctx {\n69\t    fn drop(&mut self) {\n70\t        unsafe {\n71\t            self.lib\n72\t                .get::<Fn_F_freeDecompressionContext>(\"LZ4F_freeDecompressionContext\")(self.p);\n73\t        }\n74\t    }\n75\t}\n76\t\n77\t/// One-shot frame compression with the given library.\n78\tfn compress_frame(lib: &'static Lib, src: &[u8], prefs: Option<&LZ4F_preferences_t>) -> Vec<u8> {\n79\t    let pp = prefs.map(|p| p as *const _).unwrap_or(ptr::null());\n80\t    let bound =\n81\t        unsafe { lib.get::<Fn_F_compressFrameBound>(\"LZ4F_compressFrameBound\")(src.len(), pp) };\n82\t    assert!(!is_error(bound));\n83\t    let mut out = vec![0u8; bound];\n84\t    let n = unsafe {\n85\t        lib.get::<Fn_F_compressFrame>(\"LZ4F_compressFrame\")(\n86\t            out.as_mut_ptr() as *mut c_void,\n87\t            out.len(),\n88\t            src.as_ptr() as *const c_void,\n89\t            src.len(),\n90\t            pp,\n91\t        )\n92\t    };\n93\t    assert!(!is_error(n), \"{}: compressFrame -> {}\", lib.which, show(n));\n94\t    out.truncate(n);\n95\t    out\n96\t}\n97\t\n98\t/// Feed `frame` to `LZ4F_decompress` in one call with an ample output buffer\n99\t/// and return `(return_code, dst_written, src_consumed, output_bytes)`.\n100\tfn decompress_once(lib: &'static Lib, frame: &[u8], dst_cap: usize) -> (usize, usize, usize, Vec<u8>) {\n101\t    let dctx = Dctx::new(lib);\n102\t    let mut out = vec![0u8; dst_cap.max(1)];\n103\t    let mut dst_size = dst_cap;\n104\t    let mut src_size = frame.len();\n105\t    let rc = unsafe {\n106\t        lib.get::<Fn_F_decompress>(\"LZ4F_decompress\")(\n107\t            dctx.p,\n108\t            out.as_mut_ptr() as *mut c_void,\n109\t            &mut dst_size,\n110\t            frame.as_ptr() as *const c_void,\n111\t            &mut src_size,\n112\t            ptr::null(),\n113\t        )\n114\t    };\n115\t    out.truncate(dst_size);\n116\t    (rc, dst_size, src_size, out)\n117\t}\n118\t\n119\t/// Drive `LZ4F_decompress` in a loop until it returns 0, errors, or stalls.\n120\t/// Returns `(final_return_code, total_out, total_consumed, output)`.\n121\tfn decompress_loop(\n122\t    lib: &'static Lib,\n123\t    frame: &[u8],\n124\t    chunk: usize,\n125\t    out_chunk: usize,\n126\t) -> (usize, usize, usize, Vec<u8>) {\n127\t    let dctx = Dctx::new(lib);\n128\t    let mut consumed = 0usize;\n129\t    let mut produced = Vec::new();\n130\t    let mut buf = vec![0u8; out_chunk.max(1)];\n131\t    let mut rc = 1usize;\n132\t    let mut guard = 0;\n133\t    while consumed < frame.len() && rc != 0 {\n134\t        guard += 1;\n135\t        if guard > 100_000 {\n136\t            break;\n137\t        }\n138\t        let take = chunk.min(frame.len() - consumed);\n139\t        let mut src_size = take;\n140\t        let mut dst_size = buf.len();\n141\t        rc = unsafe {\n142\t            lib.get::<Fn_F_decompress>(\"LZ4F_decompress\")(\n143\t                dctx.p,\n144\t                buf.as_mut_ptr() as *mut c_void,\n145\t                &mut dst_size,\n146\t                frame[consumed..].as_ptr() as *const c_void,\n147\t                &mut src_size,\n148\t                ptr::null(),\n149\t            )\n150\t        };\n151\t        if is_error(rc) {\n152\t            return (rc, produced.len(), consumed, produced);\n153\t        }\n154\t        produced.extend_from_slice(&buf[..dst_size]);\n155\t        consumed += src_size;\n156\t        if src_size == 0 && dst_size == 0 {\n157\t            break; // stalled\n158\t        }\n159\t    }\n160\t    (rc, produced.len(), consumed, produced)\n161\t}\n162\t\n163\t// ===========================================================================\n164\t// ERRORS.md rows 71, 72 — LZ4F_getBlockSize range check + out-of-range enums\n165\t// ===========================================================================\n166\t\n167\t#[test]\n168\tfn err_getBlockSize_all_int_values() {\n169\t    let mut vals: Vec<c_int> = (-8..=24).collect();\n170\t    vals.extend_from_slice(&[\n171\t        99,\n172\t        255,\n173\t        256,\n174\t        1000,\n175\t        -100,\n176\t        i32::MAX,\n177\t        i32::MIN,\n178\t        i32::MAX - 1,\n179\t        i32::MIN + 1,\n180\t        0x0001_0004, // low bits look like max64KB but the value is out of range\n181\t    ]);\n182\t    for v in vals {\n183\t        let (cv, rv) = both(|l| unsafe { l.get::<Fn_F_getBlockSize>(\"LZ4F_getBlockSize\")(v) });\n184\t        assert_eq!(\n185\t            cv,\n186\t            rv,\n187\t            \"LZ4F_getBlockSize({}) C={} Rust={}\",\n188\t            v,\n189\t            show(cv),\n190\t            show(rv)\n191\t        );\n192\t    }\n193\t    // sanity: the four valid IDs must yield the documented sizes\n194\t    for (id, want) in [\n195\t        (LZ4F_DEFAULT, 64 * 1024),\n196\t        (LZ4F_MAX64KB, 64 * 1024),\n197\t        (LZ4F_MAX256KB, 256 * 1024),\n198\t        (LZ4F_MAX1MB, 1024 * 1024),\n199\t        (LZ4F_MAX4MB, 4 * 1024 * 1024),\n200\t    ] {\n201\t        let (cv, _) = both(|l| unsafe { l.get::<Fn_F_getBlockSize>(\"LZ4F_getBlockSize\")(id) });\n202\t        assert_eq!(cv, want, \"C LZ4F_getBlockSize({})\", id);\n203\t    }\n204\t}\n205\t\n206\t// ===========================================================================\n207\t// ERRORS.md rows 142, 143 — error classification / naming round-trip\n208\t// ===========================================================================\n209\t\n210\t#[test]\n211\tfn err_isError_getErrorCode_getErrorName_parity() {\n212\t    let mut probes: Vec<usize> = Vec::new();\n213\t    // every code 0..=30 in the negated-size_t representation\n214\t    for code in 0..=30usize {\n215\t        probes.push(0usize.wrapping_sub(code));\n216\t    }\n217\t    // plus plausible non-error return values and the exact boundary\n218\t    probes.extend_from_slice(&[\n219\t        0,\n220\t        1,\n221\t        2,\n222\t        100,\n223\t        65535,\n224\t        usize::MAX / 2,\n225\t        usize::MAX - LZ4F_ERROR_MAX_CODE,     // NOT an error (boundary)\n226\t        usize::MAX - LZ4F_ERROR_MAX_CODE + 1, // IS an error (boundary)\n227\t        usize::MAX - 1,\n228\t        usize::MAX,\n229\t    ]);\n230\t    for p in probes {\n231\t        let (ci, ri) = both(|l| unsafe { l.get::<Fn_F_isError>(\"LZ4F_isError\")(p) });\n232\t        assert_eq!(ci, ri, \"LZ4F_isError({:#x})\", p);\n233\t\n234\t        let (cc, rc) = both(|l| unsafe { l.get::<Fn_F_getErrorCode>(\"LZ4F_getErrorCode\")(p) });\n235\t        assert_eq!(cc, rc, \"LZ4F_getErrorCode({:#x})\", p);\n236\t\n237\t        let (cn, rn) = both(|l| unsafe {\n238\t            cstr(l.get::<Fn_F_getErrorName>(\"LZ4F_getErrorName\")(p))\n239\t        });\n240\t        assert_eq!(cn, rn, \"LZ4F_getErrorName({:#x})\", p);\n241\t    }\n242\t}\n243\t\n244\t// ===========================================================================\n245\t// ERRORS.md rows 76, 77, 92, 93 — context creation\n246\t// ===========================================================================\n247\t\n248\t#[test]\n249\tfn err_create_context_null_out_pointer() {\n250\t    // LZ4F_createCompressionContext(NULL, version) -> parameter_null\n251\t    let (cv, rv) = both(|l| unsafe {\n252\t        l.get::<Fn_F_createCompressionContext>(\"LZ4F_createCompressionContext\")(\n253\t            ptr::null_mut(),\n254\t            LZ4F_VERSION,\n255\t        )\n256\t    });\n257\t    assert_eq!(cv, rv, \"createCompressionContext(NULL): C={} Rust={}\", show(cv), show(rv));\n258\t    assert!(is_error(cv));\n259\t\n260\t    let (cv, rv) = both(|l| unsafe {\n261\t        l.get::<Fn_F_createDecompressionContext>(\"LZ4F_createDecompressionContext\")(\n262\t            ptr::null_mut(),\n263\t            LZ4F_VERSION,\n264\t        )\n265\t    });\n266\t    assert_eq!(cv, rv, \"createDecompressionContext(NULL): C={} Rust={}\", show(cv), show(rv));\n267\t    assert!(is_error(cv));\n268\t}\n269\t\n270\t#[test]\n271\tfn err_create_context_version_values() {\n272\t    // the C stores but does not validate @version; every value must behave the same\n273\t    for v in [0u32, 1, 99, LZ4F_VERSION, 101, 1000, u32::MAX] {\n274\t        let cv = {\n275\t            let mut p = ptr::null_mut();\n276\t            let rc = unsafe {\n277\t                c().get::<Fn_F_createCompressionContext>(\"LZ4F_createCompressionContext\")(\n278\t                    &mut p, v,\n279\t                )\n280\t            };\n281\t            if !p.is_null() {\n282\t                unsafe {\n283\t                    c().get::<Fn_F_freeCompressionContext>(\"LZ4F_freeCompressionContext\")(p)\n284\t                };\n285\t            }\n286\t            (rc, p.is_null())\n287\t        };\n288\t        let rv = {\n289\t            let mut p = ptr::null_mut();\n290\t            let rc = unsafe {\n291\t                r().get::<Fn_F_createCompressionContext>(\"LZ4F_createCompressionContext\")(\n292\t                    &mut p, v,\n293\t                )\n294\t            };\n295\t            if !p.is_null() {\n296\t                unsafe {\n297\t                    r().get::<Fn_F_freeCompressionContext>(\"LZ4F_freeCompressionContext\")(p)\n298\t                };\n299\t            }\n300\t            (rc, p.is_null())\n301\t        };\n302\t        assert_eq!(cv, rv, \"createCompressionContext version={}\", v);\n303\t\n304\t        let cv = {\n305\t            let mut p = ptr::null_mut();\n306\t      