{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01CrcHbTcUFdVRdzm8q1sXVg","type":"tool_result","content":"755\t\n756\t/// `LZ4F_compressUpdate` with a NULL src and a zero / non-zero srcSize.\n757\t#[test]\n758\tfn err_compressUpdate_null_src() {\n759\t    for size in [0usize, 1, 100] {\n760\t        for name in [\"LZ4F_compressUpdate\", \"LZ4F_uncompressedUpdate\"] {\n761\t            let vals = both(|l| {\n762\t                let cctx = Cctx::new(l);\n763\t                let mut out = vec![0u8; 300_000];\n764\t                unsafe {\n765\t                    let h = l.get::<Fn_F_compressBegin>(\"LZ4F_compressBegin\")(\n766\t                        cctx.p,\n767\t                        out.as_mut_ptr() as *mut c_void,\n768\t                        out.len(),\n769\t                        ptr::null(),\n770\t                    );\n771\t                    assert!(!is_error(h));\n772\t                    l.get::<Fn_F_compressUpdate>(name)(\n773\t                        cctx.p,\n774\t                        out.as_mut_ptr() as *mut c_void,\n775\t                        out.len(),\n776\t                        ptr::null(),\n777\t                        size,\n778\t                        ptr::null(),\n779\t                    )\n780\t                }\n781\t            });\n782\t            // size == 0 with a NULL src is legal and must be a no-op; a\n783\t            // non-zero size with NULL src is UB in C, so only probe size == 0.\n784\t            if size == 0 {\n785\t                assert_eq!(vals.0, vals.1, \"{}(NULL, 0)\", name);\n786\t            }\n787\t        }\n788\t    }\n789\t}\n790\t\n791\t// ===========================================================================\n792\t// ERRORS.md rows 86-91 — flush / compressEnd\n793\t// ===========================================================================\n794\t"}]},"parent_tool_use_id":null,"session_id":"efa97b54-4a20-4ac7-b60b-5dc425f1ad2b","uuid":"a7a31f47-4b9d-43ca-abba-bd58d655f240","timestamp":"2026-09-08T16:56:34.037Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-kMGhHl/translation/tests/frame_err.rs","content":"\n/// `LZ4F_compressUpdate` with a NULL src and a zero / non-zero srcSize.\n#[test]\nfn err_compressUpdate_null_src() {\n    for size in [0usize, 1, 100] {\n        for name in [\"LZ4F_compressUpdate\", \"LZ4F_uncompressedUpdate\"] {\n            let vals = both(|l| {\n                let cctx = Cctx::new(l);\n                let mut out = vec![0u8; 300_000];\n                unsafe {\n                    let h = l.get::<Fn_F_compressBegin>(\"LZ4F_compressBegin\")(\n                        cctx.p,\n                        out.as_mut_ptr() as *mut c_void,\n                        out.len(),\n                        ptr::null(),\n                    );\n                    assert!(!is_error(h));\n                    l.get::<Fn_F_compressUpdate>(name)(\n                        cctx.p,\n                        out.as_mut_ptr() as *mut c_void,\n                        out.len(),\n                        ptr::null(),\n                        size,\n                        ptr::null(),\n                    )\n                }\n            });\n            // size == 0 with a NULL src is legal and must be a no-op; a\n            // non-zero size with NULL src is UB in C, so only probe size == 0.\n            if size == 0 {\n                assert_eq!(vals.0, vals.1, \"{}(NULL, 0)\", name);\n            }\n        }\n    }\n}\n\n// ===========================================================================\n// ERRORS.md rows 86-91 — flush / compressEnd\n// ===========================================================================\n","numLines":40,"startLine":755,"totalLines":2450}}}
