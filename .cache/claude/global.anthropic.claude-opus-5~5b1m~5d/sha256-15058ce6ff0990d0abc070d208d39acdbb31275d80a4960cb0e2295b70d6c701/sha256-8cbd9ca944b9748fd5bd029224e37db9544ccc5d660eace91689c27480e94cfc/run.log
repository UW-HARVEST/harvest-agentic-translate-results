{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_017PgUYERAqw5oogvzJTmoV1","type":"tool_result","content":"1\t//! Shared differential-test harness.\n2\t//!\n3\t//! Loads BOTH the C shared library (`c_src/build/liblz4.so`) and the Rust\n4\t//! shared library (`target/<profile>/liblz4.so`) with `libloading` and calls\n5\t//! every function through the FFI boundary, exactly as an external consumer\n6\t//! would.  No Rust function is ever called directly.\n7\t#![allow(dead_code)]\n8\t#![allow(non_camel_case_types)]\n9\t#![allow(non_snake_case)]\n10\t\n11\tuse libloading::{Library, Symbol};\n12\tuse std::ffi::c_void;\n13\tuse std::os::raw::{c_char, c_int, c_uint, c_ulonglong};\n14\tuse std::path::PathBuf;\n15\tuse std::sync::OnceLock;\n16\t\n17\t// ---------------------------------------------------------------------------\n18\t// library loading\n19\t// ---------------------------------------------------------------------------\n20\t\n21\tfn manifest_dir() -> PathBuf {\n22\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n23\t}\n24\t\n25\tfn c_so_path() -> PathBuf {\n26\t    if let Ok(p) = std::env::var(\"LZ4_C_SO\") {\n27\t        return PathBuf::from(p);\n28\t    }\n29\t    manifest_dir()\n30\t        .parent()\n31\t        .unwrap()\n32\t        .join(\"c_src\")\n33\t        .join(\"build\")\n34\t        .join(\"liblz4.so\")\n35\t}\n36\t\n37\tfn rust_so_path() -> PathBuf {\n38\t    if let Ok(p) = std::env::var(\"LZ4_RUST_SO\") {\n39\t        return PathBuf::from(p);\n40\t    }\n41\t    // current_exe is target/<profile>/deps/<testbin>; the cdylib lives in\n42\t    // target/<profile>/liblz4.so\n43\t    if let Ok(exe) = std::env::current_exe() {\n44\t        if let Some(deps) = exe.parent() {\n45\t            if let Some(profile) = deps.parent() {\n46\t                let cand = profile.join(\"liblz4.so\");\n47\t                if cand.exists() {\n48\t                    return cand;\n49\t                }\n50\t            }\n51\t        }\n52\t    }\n53\t    manifest_dir()\n54\t        .join(\"target\")\n55\t        .join(\"release\")\n56\t        .join(\"liblz4.so\")\n57\t}\n58\t\n59\tpub struct Lib {\n60\t    lib: Library,\n61\t    pub which: &'static str,\n62\t}\n63\t\n64\timpl Lib {\n65\t    /// Fetch an exported symbol.  Panics with a clear message when the symbol\n66\t    /// is missing, which is itself a Phase-A/Phase-D failure.\n67\t    pub fn get<T>(&self, name: &str) -> Symbol<'_, T> {\n68\t        let mut owned = Vec::with_capacity(name.len() + 1);\n69\t        owned.extend_from_slice(name.as_bytes());\n70\t        owned.push(0);\n71\t        unsafe {\n72\t            self.lib.get::<T>(&owned).unwrap_or_else(|e| {\n73\t                panic!(\"symbol `{}` missing from {} library: {}\", name, self.which, e)\n74\t            })\n75\t        }\n76\t    }\n77\t\n78\t    pub fn has(&self, name: &str) -> bool {\n79\t        let mut owned = Vec::with_capacity(name.len() + 1);\n80\t        owned.extend_from_slice(name.as_bytes());\n81\t        owned.push(0);\n82\t        unsafe { self.lib.get::<*const c_void>(&owned).is_ok() }\n83\t    }\n84\t}\n85\t\n86\tstatic C_LIB: OnceLock<Lib> = OnceLock::new();\n87\tstatic R_LIB: OnceLock<Lib> = OnceLock::new();\n88\t\n89\tpub fn c() -> &'static Lib {\n90\t    C_LIB.get_or_init(|| {\n91\t        let p = c_so_path();\n92\t        let lib = unsafe { Library::new(&p) }\n93\t            .unwrap_or_else(|e| panic!(\"cannot load C library {:?}: {}\", p, e));\n94\t        Lib { lib, which: \"C\" }\n95\t    })\n96\t}\n97\t\n98\tpub fn r() -> &'static Lib {\n99\t    R_LIB.get_or_init(|| {\n100\t        let p = rust_so_path();\n101\t        let lib = unsafe { Library::new(&p) }\n102\t            .unwrap_or_else(|e| panic!(\"cannot load Rust library {:?}: {}\", p, e));\n103\t        Lib { lib, which: \"Rust\" }\n104\t    })\n105\t}\n106\t\n107\t/// Run the same closure against both libraries and return `(c_result, rust_result)`.\n108\tpub fn both<T, F: Fn(&'static Lib) -> T>(f: F) -> (T, T) {\n109\t    (f(c()), f(r()))\n110\t}\n111\t\n112\t// ---------------------------------------------------------------------------\n113\t// deterministic RNG (xoshiro256**) and data generators\n114\t// ---------------------------------------------------------------------------\n115\t\n116\tpub struct Rng {\n117\t    s: [u64; 4],\n118\t}\n119\t\n120\timpl Rng {\n121\t    pub fn new(seed: u64) -> Rng {\n122\t        // splitmix64 seeding\n123\t        let mut x = seed.wrapping_add(0x9E37_79B9_7F4A_7C15);\n124\t        let mut s = [0u64; 4];\n125\t        for slot in s.iter_mut() {\n126\t            x = x.wrapping_add(0x9E37_79B9_7F4A_7C15);\n127\t            let mut z = x;\n128\t            z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);\n129\t            z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);\n130\t            *slot = z ^ (z >> 31);\n131\t        }\n132\t        Rng { s }\n133\t    }\n134\t\n135\t    pub fn next_u64(&mut self) -> u64 {\n136\t        let result = self.s[1].wrapping_mul(5).rotate_left(7).wrapping_mul(9);\n137\t        let t = self.s[1] << 17;\n138\t        self.s[2] ^= self.s[0];\n139\t        self.s[3] ^= self.s[1];\n140\t        self.s[1] ^= self.s[2];\n141\t        self.s[0] ^= self.s[3];\n142\t        self.s[2] ^= t;\n143\t        self.s[3] = self.s[3].rotate_left(45);\n144\t        result\n145\t    }\n146\t\n147\t    pub fn next_u32(&mut self) -> u32 {\n148\t        (self.next_u64() >> 32) as u32\n149\t    }\n150\t\n151\t    /// uniform in `[0, n)`; returns 0 when `n == 0`\n152\t    pub fn below(&mut self, n: usize) -> usize {\n153\t        if n == 0 {\n154\t            0\n155\t        } else {\n156\t            (self.next_u64() % (n as u64)) as usize\n157\t        }\n158\t    }\n159\t\n160\t    /// uniform in `[lo, hi]`\n161\t    pub fn range(&mut self, lo: usize, hi: usize) -> usize {\n162\t        if hi <= lo {\n163\t            lo\n164\t        } else {\n165\t            lo + self.below(hi - lo + 1)\n166\t        }\n167\t    }\n168\t\n169\t    pub fn byte(&mut self) -> u8 {\n170\t        (self.next_u64() >> 56) as u8\n171\t    }\n172\t\n173\t    pub fn bool(&mut self) -> bool {\n174\t        self.next_u64() & 1 == 1\n175\t    }\n176\t}\n177\t\n178\t/// Data shapes the LZ4 code paths distinguish.\n179\t#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n180\tpub enum Shape {\n181\t    /// pure random bytes — incompressible, forces the \"no match\" path\n182\t    Incompressible,\n183\t    /// all one byte value — maximal match lengths, exercises the long-match\n184\t    /// / 255-continuation encoding\n185\t    Constant,\n186\t    /// small alphabet, produces many short matches and long offsets\n187\t    Text,\n188\t    /// repeated block of `period` bytes — controlled match offsets\n189\t    Periodic(usize),\n190\t    /// long runs of identical bytes separated by random noise\n191\t    Runs,\n192\t    /// mostly zero with sparse random bytes (very compressible)\n193\t    Sparse,\n194\t}\n195\t\n196\tpub const ALL_SHAPES: &[Shape] = &[\n197\t    Shape::Incompressible,\n198\t    Shape::Constant,\n199\t    Shape::Text,\n200\t    Shape::Periodic(3),\n201\t    Shape::Periodic(64),\n202\t    Shape::Periodic(65535),\n203\t    Shape::Runs,\n204\t    Shape::Sparse,\n205\t];\n206\t\n207\tpub fn gen(rng: &mut Rng, len: usize, shape: Shape) -> Vec<u8> {\n208\t    let mut v = Vec::with_capacity(len);\n209\t    match shape {\n210\t        Shape::Incompressible => {\n211\t            while v.len() < len {\n212\t                v.extend_from_slice(&rng.next_u64().to_le_bytes());\n213\t            }\n214\t            v.truncate(len);\n215\t        }\n216\t        Shape::Constant => {\n217\t            let b = rng.byte();\n218\t            v.resize(len, b);\n219\t        }\n220\t        Shape::Text => {\n221\t            const ALPHA: &[u8] = b\"abcdefgh \\n\";\n222\t            for _ in 0..len {\n223\t                v.push(ALPHA[rng.below(ALPHA.len())]);\n224\t            }\n225\t        }\n226\t        Shape::Periodic(p) => {\n227\t            let p = p.max(1);\n228\t            let mut pat = Vec::with_capacity(p);\n229\t            for _ in 0..p {\n230\t                pat.push(rng.byte());\n231\t            }\n232\t            while v.len() < len {\n233\t                let n = (len - v.len()).min(p);\n234\t                v.extend_from_slice(&pat[..n]);\n235\t            }\n236\t        }\n237\t        Shape::Runs => {\n238\t            while v.len() < len {\n239\t                if rng.bool() {\n240\t                    let n = rng.range(1, 300).min(len - v.len());\n241\t                    let b = rng.byte();\n242\t                    for _ in 0..n {\n243\t                        v.push(b);\n244\t                    }\n245\t                } else {\n246\t                    let n = rng.range(1, 40).min(len - v.len());\n247\t                    for _ in 0..n {\n248\t                        v.push(rng.byte());\n249\t                    }\n250\t                }\n251\t            }\n252\t            v.truncate(len);\n253\t        }\n254\t        Shape::Sparse => {\n255\t            v.resize(len, 0);\n256\t            let hits = len / 64 + 1;\n257\t            for _ in 0..hits {\n258\t                let i = rng.below(len.max(1));\n259\t                if i < len {\n260\t                    v[i] = rng.byte();\n261\t                }\n262\t            }\n263\t        }\n264\t    }\n265\t    v\n266\t}\n267\t\n268\t// ---------------------------------------------------------------------------\n269\t// aligned scratch buffers (for the *_extState / initStream entry points)\n270\t// ---------------------------------------------------------------------------\n271\t\n272\t/// Heap buffer with a guaranteed alignment, used for `LZ4_stream_t` /\n273\t/// `LZ4_streamHC_t` scratch space handed to the `extState` entry points.\n274\tpub struct Aligned {\n275\t    ptr: *mut u8,\n276\t    layout: std::alloc::Layout,\n277\t}\n278\t\n279\timpl Aligned {\n280\t    pub fn new(size: usize, align: usize) -> Aligned {\n281\t        let layout = std::alloc::Layout::from_size_align(size.max(1), align).unwrap();\n282\t        let ptr = unsafe { std::alloc::alloc_zeroed(layout) };\n283\t        assert!(!ptr.is_null());\n284\t        Aligned { ptr, layout }\n285\t    }\n286\t    pub fn ptr(&self) -> *mut c_void {\n287\t        self.ptr as *mut c_void\n288\t    }\n289\t    /// A pointer deliberately offset by one byte, i.e. guaranteed misaligned.\n290\t    pub fn misaligned(&self) -> *mut c_void {\n291\t        unsafe { self.ptr.add(1) as *mut c_void }\n292\t    }\n293\t    pub fn size(&self) -> usize {\n294\t        self.layout.size()\n295\t    }\n296\t    pub fn zero(&mut self) {\n297\t        unsafe { std::ptr::write_bytes(self.ptr, 0, self.layout.size()) }\n298\t    }\n299\t    pub fn bytes(&self) -> &[u8] {\n300\t        unsafe { std::slice::from_raw_parts(self.ptr, self.layout.size()) }\n301\t    }\n302\t}\n303\t\n304\timpl Drop for Aligned {\n305\t    fn drop(&mut self) {\n306\t        unsafe { std::alloc::dealloc(self.ptr, self.layout) }\n307\t    }\n308\t}\n309\t\n310\t// ---------------------------------------------------------------------------\n311\t// lz4frame types (layouts copied verbatim from c_src/include/lz4frame.h)\n312\t// ---------------------------------------------------------------------------\n313\t\n314\tpub const LZ4F_VERSION: c_uint = 100;\n315\tpub const LZ4F_HEADER_SIZE_MIN: usize = 7;\n316\tpub const LZ4F_HEADER_SIZE_MAX: usize = 19;\n317\tpub const LZ4F_BLOCK_HEADER_SIZE: usize = 4;\n318\tpub const LZ4F_BLOCK_CHECKSUM_SIZE: usize = 4;\n319\tpub const LZ4F_CONTENT_CHECKSUM_SIZE: usize = 4;\n320\tpub const LZ4F_MAGICNUMBER: u32 = 0x184D_2204;\n321\tpub const LZ4F_MAGIC_SKIPPABLE_START: u32 = 0x184D_2A50;\n322\t\n323\tpub const LZ4_MAX_INPUT_SIZE: c_int = 0x7E00_0000;\n324\tpub const LZ4_ACCELERATION_MAX: c_int = 65537;\n325\tpub const LZ4HC_CLEVEL_MIN: c_int = 2;\n326\tpub const LZ4HC_CLEVEL_DEFAULT: c_int = 9;\n327\tpub const LZ4HC_CLEVEL_OPT_MIN: c_int = 10;\n328\tpub const LZ4HC_CLEVEL_MAX: c_int = 12;\n329\t\n330\t#[repr(C)]\n331\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n332\tpub struct LZ4F_frameInfo_t {\n333\t    pub blockSizeID: c_int,\n334\t    pub blockMode: c_int,\n335\t    pub contentChecksumFlag: c_int,\n336\t    pub frameType: c_int,\n337\t    pub contentSize: c_ulonglong,\n338\t    pub dictID: c_uint,\n339\t    pub blockChecksumFlag: c_int,\n340\t}\n341\t\n342\t#[repr(C)]\n343\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n344\tpub struct LZ4F_preferences_t {\n345\t    pub frameInfo: LZ4F_frameInfo_t,\n346\t    pub compressionLevel: c_int,\n347\t    pub autoFlush: c_uint,\n348\t    pub favorDecSpeed: c_uint,\n349\t    pub reserved: [c_uint; 3],\n350\t}\n351\t\n352\t#[repr(C)]\n353\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n354\tpub struct LZ4F_compressOptions_t {\n355\t    pub stableSrc: c_uint,\n356\t    pub reserved: [c_uint; 3],\n357\t}\n358\t\n359\t#[repr(C)]\n360\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n361\tpub struct LZ4F_decompressOptions_t {\n362\t    pub stableDst: c_uint,\n363\t    pub skipChecksums: c_uint,\n364\t    pub reserved1: c_uint,\n365\t    pub reserved0: c_uint,\n366\t}\n367\t\n368\t// LZ4F_blockSizeID_t\n369\tpub const LZ4F_DEFAULT: c_int = 0;\n370\tpub const LZ4F_MAX64KB: c_int = 4;\n371\tpub const LZ4F_MAX256KB: c_int = 5;\n372\tpub const LZ4F_MAX1MB: c_int = 6;\n373\tpub const LZ4F_MAX4MB: c_int = 7;\n374\t// LZ4F_blockMode_t\n375\tpub const LZ4F_BLOCK_LINKED: c_int = 0;\n376\tpub const LZ4F_BLOCK_INDEPENDENT: c_int = 1;\n377\t// LZ4F_contentChecksum_t\n378\tpub const LZ4F_NO_CONTENT_CHECKSUM: c_int = 0;\n379\tpub const LZ4F_CONTENT_CHECKSUM_ENABLED: c_int = 1;\n380\t// LZ4F_blockChecksum_t\n381\tpub const LZ4F_NO_BLOCK_CHECKSUM: c_int = 0;\n382\tpub const LZ4F_BLOCK_CHECKSUM_ENABLED: c_int = 1;\n383\t// LZ4F_frameType_t\n384\tpub const LZ4F_FRAME: c_int = 0;\n385\tpub const LZ4F_SKIPPABLE_FRAME: c_int = 1;\n386\t\n387\tpub const LZ4F_ERROR_MAX_CODE: usize = 24;\n388\t\n389\t/// Mirror of `LZ4F_isError`.\n390\tpub fn is_error(r: usize) -> bool {\n391\t    r > usize::MAX - LZ4F_ERROR_MAX_CODE\n392\t}\n393\t\n394\t/// Recover the positive error code from an `LZ4F_*` return value.\n395\tpub fn err_code(r: usize) -> i64 {\n396\t    if is_error(r) {\n397\t        -(r as i64)\n398\t    } else {\n399\t        0\n400\t    }\n401\t}\n402\t\n403\t/// Render an `LZ4F_*` return value for assertion messages.\n404\tpub fn show(r: usize) -> String {\n405\t    if is_error(r) {\n406\t        format!(\"ERR({})\", err_code(r))\n407\t    } else {\n408\t        format!(\"ok({})\", r)\n409\t    }\n410\t}\n411\t\n412\t// ---------------------------------------------------------------------------\n413\t// function-pointer type aliases\n414\t// ---------------------------------------------------------------------------\n415\t\n416\tpub type FnU = unsafe extern \"C\" fn() -> c_uint;\n417\tpub type FnI = unsafe extern \"C\" fn() -> c_int;\n418\tpub type FnStr = unsafe extern \"C\" fn() -> *const c_char;\n419\t\n420\t// lz4.h — simple\n421\tpub type Fn_compressBound = unsafe extern \"C\" fn(c_int) -> c_int;\n422\tpub type Fn_compress_default =\n423\t    unsafe extern \"C\" fn(*const c_char, *mut c_char, c_int, c_int) -> c_int;\n424\tpub type Fn_decompress_safe =\n425\t    unsafe extern \"C\" fn(*const c_char, *mut c_char, c_int, c_int) -> c_int;\n426\tpub type Fn_compress_fast =\n427\t    unsafe extern \"C\" fn(*const c_char, *mut c_char, c_int, c_int, c_int) -> c_int;\n428\tpub type Fn_compress_fast_extState =\n429\t    unsafe extern \"C\" fn(*mut c_void, *const c_char, *mut c_char, c_int, c_int, c_int) -> c_int;\n430\tpub type Fn_compress_destSize =\n431\t    unsafe extern \"C\" fn(*const c_char, *mut c_char, *mut c_int, c_int) -> c_int;\n432\tpub type Fn_compress_destSize_extState =\n433\t    unsafe extern \"C\" fn(*mut c_void, *const c_char, *mut c_char, *mut c_int, c_int, c_int) -> c_int;\n434\tpub type Fn_decompress_safe_partial =\n435\t    unsafe extern \"C\" fn(*const c_char, *mut c_char, c_int, c_int, c_int) -> c_int;\n436\tpub type Fn_decompress_fast = unsafe extern \"C\" fn(*const c_char, *mut c_char, c_int) -> c_int;\n437\tpub type Fn_sizeofState = unsafe extern \"C\" fn() -> c_int;\n438\t\n439\t// streaming (block)\n440\tpub type Fn_createStream = unsafe extern \"C\" fn() -> *mut c_void;\n441\tpub type Fn_freeStream = unsafe extern \"C\" fn(*mut c_void) -> c_int;\n442\tpub type Fn_initStream = unsafe extern \"C\" fn(*mut c_void, usize) -> *mut c_void;\n443\tpub type Fn_resetStream = unsafe extern \"C\" fn(*mut c_void);\n444\tpub type Fn_loadDict = unsafe extern \"C\" fn(*mut c_void, *const c_char, c_int) -> c_int;\n445\tpub type Fn_loadDict_internal =\n446\t    unsafe extern \"C\" fn(*mut c_void, *const c_char, c_int, c_int) -> c_int;\n447\tpub type Fn_attach_dictionary = unsafe extern \"C\" fn(*mut c_void, *const c_void);\n448\tpub type Fn_compress_fast_continue =\n449\t    unsafe extern \"C\" fn(*mut c_void, *const c_char, *mut c_char, c_int, c_int, c_int) -> c_int;\n450\tpub type Fn_saveDict = unsafe extern \"C\" fn(*mut c_void, *mut c_char, c_int) -> c_int;\n451\tpub type Fn_createStreamDecode = unsafe extern \"C\" fn() -> *mut c_void;\n452\tpub type Fn_freeStreamDecode = unsafe extern \"C\" fn(*mut c_void) -> c_int;\n453\tpub type Fn_setStreamDecode = unsafe extern \"C\" fn(*mut c_void, *const c_char, c_int) -> c_int;\n454\tpub type Fn_decompress_safe_continue =\n455\t    unsafe extern \"C\" fn(*mut c_void, *const c_char, *mut c_char, c_int, c_int) -> c_int;\n456\tpub type Fn_decompress_fast_continue =\n457\t    unsafe extern \"C\" fn(*mut c_void, *const c_char, *mut c_char, c_int) -> c_int;\n458\tpub type Fn_decompress_usingDict = unsafe extern \"C\" fn(\n459\t    *const c_char,\n460\t    *mut c_char,\n461\t    c_int,\n462\t    c_int,\n463\t    *const c_char,\n464\t    c_int,\n465\t) -> c_int;\n466\tpub type Fn_decompress_partial_usingDict = unsafe extern \"C\" fn(\n467\t    *const c_char,\n468\t    *mut c_char,\n469\t    c_int,\n470\t    c_int,\n471\t    c_int,\n472\t    *const c_char,\n473\t    c_int,\n474\t) -> c_int;\n475\tpub type Fn_decompress_fast_usingDict =\n476\t    unsafe extern \"C\" fn(*const c_char, *mut c_char, c_int, *const c_char, c_int) -> c_int;\n477\tpub type Fn_decoderRingBufferSize = unsafe extern \"C\" fn(c_int) -> c_int;\n478\t\n479\t// lz4hc.h\n480\tpub type Fn_compress_HC =\n481\t    unsafe extern \"C\" fn(*const c_char, *mut c_char, c_int, c_int, c_int) -> c_int;\n482\tpub type Fn_compress_HC_extStateHC =\n483\t    unsafe extern \"C\" fn(*mut c_void, *const c_char, *mut c_char, c_int, c_int, c_int) -> c_int;\n484\tpub type Fn_compress_HC_destSize =\n485\t    unsafe extern \"C\" fn(*mut c_void, *const c_char, *mut c_char, *mut c_int, c_int, c_int) -> c_int;\n486\tpub type Fn_resetStreamHC = unsafe extern \"C\" fn(*mut c_void, c_int);\n487\tpub type Fn_initStreamHC = unsafe extern \"C\" fn(*mut c_void, usize) -> *mut c_void;\n488\tpub type Fn_loadDictHC = unsafe extern \"C\" fn(*mut c_void, *const c_char, c_int) -> c_int;\n489\tpub type Fn_compress_HC_continue =\n490\t    unsafe extern \"C\" fn(*mut c_void, *const c_char, *mut c_char, c_int, c_int) -> c_int;\n491\tpub type Fn_compress_HC_continue_destSize =\n492\t    unsafe extern \"C\" fn(*mut c_void, *const c_char, *mut c_char, *mut c_int, c_int) -> c_int;\n493\tpub type Fn_saveDictHC = unsafe extern \"C\" fn(*mut c_void, *mut c_char, c_int) -> c_int;\n494\tpub type Fn_setCompressionLevel = unsafe extern \"C\" fn(*mut c_void, c_int);\n495\tpub type Fn_favorDecompressionSpeed = unsafe extern \"C\" fn(*mut c_void, c_int);\n496\tpub type Fn_resetStreamStateHC = unsafe extern \"C\" fn(*mut c_void, *mut c_char) -> c_int;\n497\t\n498\t// deprecated\n499\tpub type Fn_compress = unsafe extern \"C\" fn(*const c_char, *mut c_char, c_int) -> c_int;\n500\tpub type Fn_compress_limitedOutput =\n501