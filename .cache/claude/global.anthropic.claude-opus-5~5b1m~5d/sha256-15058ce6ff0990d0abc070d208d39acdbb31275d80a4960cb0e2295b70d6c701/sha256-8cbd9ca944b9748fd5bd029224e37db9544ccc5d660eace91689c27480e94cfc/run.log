eHC = unsafe extern \"C\" fn(*const c_char) -> *mut c_void;\n528\tpub type Fn_freeHC = unsafe extern \"C\" fn(*mut c_void) -> c_int;\n529\tpub type Fn_slideInputBufferHC = unsafe extern \"C\" fn(*mut c_void) -> *mut c_char;\n530\tpub type Fn_compressHC2_continue =\n531\t    unsafe extern \"C\" fn(*mut c_void, *const c_char, *mut c_char, c_int, c_int) -> c_int;\n532\tpub type Fn_compressHC2_limitedOutput_continue =\n533\t    unsafe extern \"C\" fn(*mut c_void, *const c_char, *mut c_char, c_int, c_int, c_int) -> c_int;\n534\tpub type Fn_compress_forceExtDict =\n535\t    unsafe extern \"C\" fn(*mut c_void, *const c_char, *mut c_char, c_int) -> c_int;\n536\t/// `typedef struct { int off; int len; int back; } LZ4HC_match_t;` (lz4hc.c:357)\n537\t#[repr(C)]\n538\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n539\tpub struct LZ4HC_match_t {\n540\t    pub off: c_int,\n541\t    pub len: c_int,\n542\t    pub back: c_int,\n543\t}\n544\t\n545\t/// `LZ4HC_match_t LZ4HC_searchExtDict(const BYTE* ip, U32 ipIndex,\n546\t///        const BYTE* iLowLimit, const BYTE* iHighLimit,\n547\t///        const LZ4HC_CCtx_internal* dictCtx, U32 gDictEndIndex,\n548\t///        int currentBestML, int nbAttempts)` (lz4hc.c:363)\n549\tpub type Fn_HC_searchExtDict = unsafe extern \"C\" fn(\n550\t    *const u8,    // ip\n551\t    u32,          // ipIndex\n552\t    *const u8,    // iLowLimit\n553\t    *const u8,    // iHighLimit\n554\t    *const c_void, // dictCtx (== &LZ4_streamHC_t.internal_donotuse, offset 0)\n555\t    u32,          // gDictEndIndex\n556\t    c_int,        // currentBestML\n557\t    c_int,        // nbAttempts\n558\t) -> LZ4HC_match_t;\n559\t\n560\t// internal-but-exported entry points\n561\tpub type Fn_F_compressBegin_internal = unsafe extern \"C\" fn(\n562\t    *mut c_void, // cctx\n563\t    *mut c_void, // dst\n564\t    usize,\n565\t    *const c_void, // dictBuffer\n566\t    usize,         // dictSize\n567\t    *const c_void, // cdict\n568\t    *const LZ4F_preferences_t,\n569\t) -> usize;\n570\tpub type Fn_F_compressBegin_usingDictOnce = unsafe extern \"C\" fn(\n571\t    *mut c_void,\n572\t    *mut c_void,\n573\t    usize,\n574\t    *const c_void,\n575\t    usize,\n576\t    *const LZ4F_preferences_t,\n577\t) -> usize;\n578\t/// `int LZ4_decompress_safe_forceExtDict(const char*, char*, int, int, const void*, size_t)`\n579\tpub type Fn_decompress_safe_forceExtDict = unsafe extern \"C\" fn(\n580\t    *const c_char,\n581\t    *mut c_char,\n582\t    c_int,\n583\t    c_int,\n584\t    *const c_void,\n585\t    usize,\n586\t) -> c_int;\n587\t/// `int LZ4_decompress_safe_partial_forceExtDict(const char*, char*, int, int, int, const void*, size_t)`\n588\tpub type Fn_decompress_safe_partial_forceExtDict = unsafe extern \"C\" fn(\n589\t    *const c_char,\n590\t    *mut c_char,\n591\t    c_int,\n592\t    c_int,\n593\t    c_int,\n594\t    *const c_void,\n595\t    usize,\n596\t) -> c_int;\n597\t/// `int LZ4_decompress_safe_withPrefix64k(const char*, char*, int, int)`\n598\tpub type Fn_decompress_safe_withPrefix64k =\n599\t    unsafe extern \"C\" fn(*const c_char, *mut c_char, c_int, c_int) -> c_int;\n600\t/// `int LZ4_decompress_fast_withPrefix64k(const char*, char*, int)`\n601\tpub type Fn_decompress_fast_withPrefix64k =\n602\t    unsafe extern \"C\" fn(*const c_char, *mut c_char, c_int) -> c_int;\n603\t\n604\t// lz4frame.h\n605\tpub type Fn_F_getVersion = unsafe extern \"C\" fn() -> c_uint;\n606\tpub type Fn_F_isError = unsafe extern \"C\" fn(usize) -> c_uint;\n607\tpub type Fn_F_getErrorName = unsafe extern \"C\" fn(usize) -> *const c_char;\n608\tpub type Fn_F_getErrorCode = unsafe extern \"C\" fn(usize) -> c_int;\n609\tpub type Fn_F_compressionLevel_max = unsafe extern \"C\" fn() -> c_int;\n610\tpub type Fn_F_compressFrameBound =\n611\t    unsafe extern \"C\" fn(usize, *const LZ4F_preferences_t) -> usize;\n612\tpub type Fn_F_compressFrame = unsafe extern \"C\" fn(\n613\t    *mut c_void,\n614\t    usize,\n615\t    *const c_void,\n616\t    usiz