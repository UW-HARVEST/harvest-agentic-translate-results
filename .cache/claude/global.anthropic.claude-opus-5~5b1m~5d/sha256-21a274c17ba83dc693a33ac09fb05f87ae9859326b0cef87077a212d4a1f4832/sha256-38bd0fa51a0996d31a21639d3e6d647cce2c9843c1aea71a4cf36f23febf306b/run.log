\n\nstatic uint64_t rng_state = 0x123456789abcdefULL;\nstatic uint32_t rnd(void) {\n    rng_state ^= rng_state << 13;\n    rng_state ^= rng_state >> 7;\n    rng_state ^= rng_state << 17;\n    return (uint32_t)(rng_state >> 11);\n}\n\nint main(void) {\n    void *ch = dlopen(\"./libdriver.so\", RTLD_NOW);\n    void *rh = dlopen(\"../translation/target/release/libdriver.so\", RTLD_NOW);\n    if (!ch || !rh) { fprintf(stderr, \"dlopen: %s\\n\", dlerror()); return 2; }\n    c_drop = (drop_fn)dlsym(ch, \"w_utf8_drop\");\n    r_drop = (drop_fn)dlsym(rh, \"w_utf8_drop\");\n    c_filter = (filter_fn)dlsym(ch, \"w_utf8_filter\");\n    r_filter = (filter_fn)dlsym(rh, \"w_utf8_filter\");\n    if (!c_drop || !r_drop || !c_filter || !r_filter) { fprintf(stderr, \"dlsym failed\\n\"); return 2; }\n\n    char buf[4096];\n\n    /* empty string */\n    buf[0] = 0; check(buf);\n\n    /* exhaustive 1, 2 and 3 byte strings (no embedded NULs) */\n    for (int a = 1; a < 256; a++) {\n        buf[0] = (char)a; buf[1] = 0; check(buf);\n        for (int b = 1; b < 256; b++) {\n            buf[0] = (char)a; buf[1] = (char)b; buf[2] = 0; check(buf);\n        }\n    }\n    fprintf(stderr, \"1-2 byte exhaustive done (%lld checks, %lld fails)\\n\", checked, fails);\n\n    for (int a = 1; a < 256; a++)\n        for (int b = 1; b < 256; b++)\n            for (int c = 1; c < 256; c++) {\n                buf[0] = (char)a; buf[1] = (char)b; buf[2] = (char)c; buf[3] = 0;\n                checked++;\n                const char *cd = c_drop(buf), *rd = r_drop(buf);\n                if (cd - buf != rd - buf) { fails++; fprintf(stderr, \"DROP3 mismatch %02X %02X %02X\\n\", a, b, c); if (fails > 10) exit(1); }\n            }\n    fprintf(stderr, \"3 byte exhaustive drop done (%lld checks, %lld fails)\\n\", checked, fails);\n\n    /* exhaustive 4 byte prefixes: leading byte x 3 continuation-ish bytes sampled */\n    for (int a = 1; a < 256; a++)\n        for (int b = 1; b < 256; b++)\n            for (int c = 0x70; c < 0x100; c += 1) {\n                buf[0] = (char)a; buf[1] = (char)b; buf[2] = (char)c; buf[3] = (char)0x80; buf[4] = 0;\n                check(buf);\n                buf[3] = (char)0xBF; check(buf);\n                buf[3] = (char)0x41; check(buf);\n            }\n    fprintf(stderr, \"4 byte sweep done (%lld checks, %lld fails)\\n\", checked, fails);\n\n    /* random fuzz, various alphabets */\n    static const unsigned char alpha_hi[] = {0x41,0x7F,0x80,0x8F,0x90,0xA0,0xBF,0xC0,0xC1,0xC2,0xDF,0xE0,0xED,0xEF,0xF0,0xF4,0xF5,0xF8,0xFF,0x00};\n    for (long iter = 0; iter < 400000; iter++) {\n        int len = 1 + (int)(rnd() % 64);\n        for (int i = 0; i < len; i++) {\n            uint32_t r = rnd();\n            if (r % 3 == 0) buf[i] = (char)alpha_hi[r / 3 % (sizeof(alpha_hi) - 1)];\n            else if (r % 3 == 1) buf[i] = (char)(0x80 + (r / 3) % 0x80);\n            else buf[i] = (char)(1 + (r / 3) % 0xFF);\n        }\n        buf[len] = 0;\n        check(buf);\n    }\n    fprintf(stderr, \"random fuzz done (%lld checks, %lld fails)\\n\", checked, fails);\n\n    /* long strings exercising realloc growth: many invalid bytes */\n    for (int n = 1; n <= 2000; n += 1) {\n        char *big = malloc((size_t)n * 2 + 16);\n        for (int i = 0; i < n; i++) big[i] = (char)0xFF;\n        big[n] = 0;\n        check(big);\n        /* mixed valid/invalid */\n        for (int i = 0; i < n; i++) big[i] = (i % 3 == 0) ? (char)0xFE : (char)('a' + i % 26);\n        big[n] = 0;\n        check(big);\n        /* valid multibyte + trailing garbage */\n        int k = 0;\n        for (int i = 0; i < n && k < n - 4; i++) {\n            big[k++] = (char)0xE2; big[k++] = (char)0x82; big[k++] = (char)0xAC; big[k++] = (char)0xC3; big[k++] = (char)0xA9; big[k++] = (char)0xC0;\n        }\n        big[k] = 0;\n        check(big);\n        free(big);\n    }\n    fprintf(stderr, \"long-string growth done (%lld checks, %lld fails)\\n\", checked, fails);\n\n    /* large all-invalid string (exercise many reallocs) */\n    {\n        size_t n = 200000;\n        char *big = malloc(n + 1);\n        memset(big, 0xFF, n);\n        big[n] = 0;\n        check(big);\n        memset(big, 0xC0, n);\n        big[n] = 0;\n        check(big);\n        free(big);\n    }\n\n    /* valid UTF-8 samples */\n    const char *samples[] = {\n        \"\", \"hello world\", \"\\x7F\", \"\\xC2\\x80\", \"\\xDF\\xBF\", \"\\xE0\\xA0\\x80\", \"\\xEF\\xBF\\xBF\",\n        \"\\xF0\\x90\\x80\\x80\", \"\\xF4\\x8F\\xBF\\xBF\", \"caf\\xC3\\xA9\", \"\\xE2\\x82\\xAC 100\",\n        \"\\xED\\x9F\\xBF\", \"\\xED\\xA0\\x80\", \"\\xF0\\x8F\\xBF\\xBF\", \"\\xF4\\x90\\x80\\x80\",\n        \"a\\xFFb\", \"\\xFF\\xFF\\xFF\", \"\\xC0\\x80\", \"\\xC1\\xBF\", \"\\xE0\\x80\\x80\", \"\\xF5\\x80\\x80\\x80\",\n        \"\\x80\", \"\\xBF\", \"\\xF8\\x88\\x80\\x80\\x80\", \"\\xFC\\x84\\x80\\x80\\x80\\x80\", \"\\xFE\", \"\\xFE\\xFE\\xFF\\xFF\",\n        \"\\xEF\\xBF\\xBD\", \"abc\\xE2\\x82\", \"abc\\xF0\\x9F\\x98\", \"\\xC2\", \"\\xE1\\x80\", \"\\xF1\\x80\\x80\",\n    };\n    for (size_t i = 0; i < sizeof(samples) / sizeof(*samples); i++) check(samples[i]);\n\n    fprintf(stderr, \"\\nTOTAL: %lld checks, %lld mismatches\\n\", checked, fails);\n    return fails != 0;\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":519,"cache_read_input_tokens":38555,"cache_creation":{"ephemeral_5m_input_tokens":519,"ephemeral_1h_input_tokens":0},"output_tokens":10,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"4aac8de3-9c5b-43be-b369-df9c76b4f9ee","uuid":"1193fa5c-0dfa-4333-8d28-644b2954b500","timestamp":"2026-08-27T19:50:36.440Z"}
