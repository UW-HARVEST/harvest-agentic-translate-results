");","+        }","+","+        assert!(","+            p.exists(),","+            \"Rust cdylib not found at {}; build it with `cargo build`\",","+            p.display()","+        );","         load(&p, \"Rust\")","     })"," }"]}],"userModified":false,"replaceAll":false}}
