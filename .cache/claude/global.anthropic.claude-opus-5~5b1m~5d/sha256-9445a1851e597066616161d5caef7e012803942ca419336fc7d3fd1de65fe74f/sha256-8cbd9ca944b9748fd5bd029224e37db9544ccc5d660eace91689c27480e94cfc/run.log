bpp) as isize));\n826\t                        x += 1;\n827\t                    }\n828\t                }\n829\t                2 => {\n830\t                    x = 0;\n831\t                    while x < bpp {\n832\t                        *raw.offset(x as isize) =\n833\t                            (*raw.offset(x as isize)).wrapping_add(*prev.offset(x as isize));\n834\t                        x += 1;\n835\t                    }\n836\t                    while x < len {\n837\t                        *raw.offset(x as isize) =\n838\t                            (*raw.offset(x as isize)).wrapping_add(*prev.offset(x as isize));\n839\t                        x += 1;\n840\t                    }\n841\t                }\n842\t                3 => {\n843\t                    x = 0;\n844\t                    while x < bpp {\n845\t                        *raw.offset(x as isize) =\n846\t                            (*raw.offset(x as isize)).wrapping_add(*prev.offset(x as isize) / 2);\n847\t                        x += 1;\n848\t                    }\n849\t                    while x < len {\n850\t                        let sum = *raw.offset((x - bpp) as isize) as c_int\n851\t                            + *prev.offset(x as isize) as c_int;\n852\t                        *raw.offset(x as isize) =\n853\t                            (*raw.offset(x as isize)).wrapping_add((sum / 2) as u8);\n854\t                        x += 1;\n855\t                    }\n856\t                }\n857\t                4 => {\n858\t                    x = 0;\n859\t                    while x < bpp {\n860\t                        *raw.offset(x as isize) =\n861\t                            (*raw.offset(x as isize)).wrapping_add(*prev.offset(x as isize));\n862\t                        x += 1;\n863\t                    }\n864\t                    while x < len {\n865\t                        *raw.offset(x as isize) = (*raw.offset(x as isize)).wrapping_add(cp_paeth(\n866\t                            *raw.offset((x - bpp) as isize),\n867\t                            *prev.offset(x as isize),\n868\t                            *prev.offset((x - bpp) as isize),\n869\t                        ));\n870\t                        x += 1;\n871\t                    }\n872\t                }\n873\t                _ => return 0,\n874\t            }\n875\t            y += 1;\n876\t            prev = raw;\n877\t            raw = raw.wrapping_offset(len as isize);\n878\t        }\n879\t        1\n880\t    }\n881\t}\n882\t\n883\t/// `static void cp_convert(int bpp, int w, int h, uint8_t *src, cp_pixel_t *dst)`\n884\tunsafe fn cp_convert(bpp: c_int, w: c_int, h: c_int, src: *mut u8, dst: *mut cp_pixel_t) {\n885\t    unsafe {\n886\t        let mut src = src;\n887\t        let mut dst = dst;\n888\t        for _y in 0..h {\n889\t            src = src.wrapping_offset(1);\n890\t            let mut x: c_int = 0;\n891\t            while x < w {\n892\t                match bpp {\n893\t                    1 => {\n894\t                        *dst = cp_make_pixel(*src, *src, *src);\n895\t                        dst = dst.wrapping_offset(1);\n896\t                    }\n897\t                    2 => {\n898\t                        *dst = cp_make_pixel_a(*src, *src, *src, *src.offset(1));\n899\t                        dst = dst.wrapping_offset(1);\n900\t                    }\n901\t                    3 => {\n902\t                        *dst = cp_make_pixel(*src, *src.offset(1), *src.offset(2));\n903\t                        dst = dst.wrapping_offset(1);\n904\t                    }\n905\t                    4 => {\n906\t                        *dst =\n907\t                            cp_make_pixel_a(*src, *src.offset(1), *src.offset(2), *src.offset(3));\n908\t                        dst = dst.wrapping_offset(1);\n909\t                    }\n910\t                    _ => {}\n911\t                }\n912\t                x += 1;\n913\t                src = src.wrapping_offset(bpp as isize);\n914\t            }\n915\t        }\n916\t    }\n917\t}\n918\t\n919\t/// `static uint8_t cp_get_alpha_for_indexed_image(int index, const uint8_t *trns, uint32_t trns_len)`\n920\tunsafe fn cp_get_alpha_for_indexed_image(index: c_int, trns: *const u8, trns_len: u32) -> u8 {\n921\t    unsafe {\n922\t        if trns.is_null() {\n923\t            255\n924\t        } else if (index as u32) >= trns_len {\n925\t            255\n926\t        } else {\n927\t            *trns.offset(index as isize)\n928\t        }\n929\t    }\n930\t}\n931\t\n932\t/// `static void cp_depalette(int w, int h, uint8_t *src, cp_pixel_t *dst, const uint8_t *plte, const uint8_t *trns, uint32_t trns_len)`\n933\tunsafe fn cp_depalette(\n934\t    w: c_int,\n935\t    h: c_int,\n936\t    src: *mut u8,\n937\t    dst: *mut cp_pixel_t,\n938\t    plte: *const u8,\n939\t    trns: *const u8,\n940\t    trns_len: u32,\n941\t) {\n942\t    unsafe {\n943\t        let mut src = src;\n944\t        let mut dst = dst;\n945\t        for _y in 0..h {\n946\t            src = src.wrapping_offset(1);\n947\t            let mut x: c_int = 0;\n948\t            while x < w {\n949\t                let c = *src as c_int;\n950\t                let r = *plte.offset((c * 3) as isize);\n951\t                let g = *plte.offset((c * 3 + 1) as isize);\n952\t                let b = *plte.offset((c * 3 + 2) as isize);\n953\t                let a = cp_get_alpha_for_indexed_image(c, trns, trns_len);\n954\t                *dst = cp_make_pixel_a(r, g, b, a);\n955\t                dst = dst.wrapping_offset(1);\n956\t                x += 1;\n957\t                src = src.wrapping_offset(1);\n958\t            }\n959\t        }\n960\t    }\n961\t}\n962\t\n963\t/// `static uint32_t cp_get_chunk_byte_length(const uint8_t *chunk)`\n964\tunsafe fn cp_get_chunk_byte_length(chunk: *const u8) -> u32 {\n965\t    unsafe { cp_make32(chunk.wrapping_offset(-8)) }\n966\t}\n967\t\n968\t/// `static int cp_out_size(cp_image_t *img, int bpp)`\n969\tfn cp_out_size(img: &cp_image_t, bpp: c_int) -> c_int {\n970\t    img.w.wrapping_add(1).wrapping_mul(img.h).wrapping_mul(bpp)\n971\t}\n972\t\n973\t/// `cp_image_t load_png_mem(const uint8_t *png_data, int png_length)`\n974\t#[unsafe(no_mangle)]\n975\tpub unsafe extern \"C\" fn load_png_mem(png_data: *const u8, png_length: c_int) -> cp_image_t {\n976\t    unsafe {\n977\t        const SIG: &[u8; 8] = b\"\\x89PNG\\r\\n\\x1a\\n\";\n978\t        let ihdr: *const u8;\n979\t        let mut first: *const u8;\n980\t        let plte: *const u8;\n981\t        let trns: *const u8;\n982\t        let bit_depth: c_int;\n983\t        let color_type: c_int;\n984\t        let mut bpp: c_int = 0;\n985\t        let w: c_int;\n986\t        let h: c_int;\n987\t        let pix_bytes: c_int;\n988\t        let compression: c_int;\n989\t        let filter: c_int;\n990\t        let interlace: c_int;\n991\t        let mut datalen: c_int;\n992\t        let mut offset: c_int;\n993\t        let out: *mut u8;\n994\t        let mut img = cp_image_t {\n995\t            w: 0,\n996\t            h: 0,\n997\t            pix: ptr::null_mut(),\n998\t        };\n999\t        let mut data: *mut u8 = ptr::null_mut();\n1000\t        let mut png = cp_raw_png_t {\n1001\t            p: png_data,\n1002\t            end: png_data.wrapping_offset(png_length as isize),\n1003\t        };\n1004\t\n1005\t        macro_rules! fail {\n1006\t            ($msg:expr) => {{\n1007\t                set_error_reason($msg);\n1008\t                free(data as *mut c_void);\n1009\t                free(img.pix as *mut c_void);\n1010\t                img.pix = ptr::null_mut();\n1011\t                return img;\n1012\t            }};\n1013\t        }\n1014\t\n1015\t        if memcmp(\n1016\t            png.p as *const c_void,\n1017\t            SIG.as_ptr() as *const c_void,\n1018\t            8,\n1019\t        ) != 0\n1020\t        {\n1021\t            fail!(c\"incorrect file signature (is this a png file?)\");\n1022\t        }\n1023\t        png.p = png.p.wrapping_offset(8);\n1024\t        ihdr = cp_chunk(&raw mut png, b\"IHDR\", 13);\n1025\t        if ihdr.is_null() {\n1026\t            fail!(c\"unable to find IHDR chunk\");\n1027\t        }\n1028\t        bit_depth = *ihdr.offset(8) as c_int;\n1029\t        color_type = *ihdr.offset(9) as c_int;\n1030\t        if !(bit_depth == 8) {\n1031\t            fail!(c\"only bit-depth of 8 is supported\");\n1032\t        }\n1033\t        match color_type {\n1034\t            0 => bpp = 1,\n1035\t            2 => bpp = 3,\n1036\t            3 => bpp = 1,\n1037\t            4 => bpp = 2,\n1038\t            6 => bpp = 4,\n1039\t            _ => {\n1040\t                fail!(c\"unknown color type\");\n1041\t            }\n1042\t        }\n1043\t        w = cp_make32(ihdr).wrapping_add(1) as c_int;\n1044\t        h = cp_make32(ihdr.offset(4)) as c_int;\n1045\t        if !(w >= 1) {\n1046\t            fail!(c\"invalid IHDR chunk found, image width was less than 1\");\n1047\t        }\n1048\t        if !(h >= 1) {\n1049\t            fail!(c\"invalid IHDR chunk found, image height was less than 1\");\n1050\t        }\n1051\t        if !(((w as i64).wrapping_mul(h as i64) as u64)\n1052\t            .wrapping_mul(core::mem::size_of::<cp_pixel_t>() as u64)\n1053\t            < c_int::MAX as u64)\n1054\t        {\n1055\t            fail!(c\"image too large\");\n1056\t        }\n1057\t        pix_bytes = (w as i64)\n1058\t            .wrapping_mul(h as i64)\n1059\t            .wrapping_mul(core::mem::size_of::<cp_pixel_t>() as i64) as c_int;\n1060\t        img.w = w - 1;\n1061\t        img.h = h;\n1062\t        img.pix = malloc(pix_bytes as usize) as *mut cp_pixel_t;\n1063\t        if img.pix.is_null() {\n1064\t            fail!(c\"unable to allocate raw image space\");\n1065\t        }\n1066\t        compression = *ihdr.offset(10) as c_int;\n1067\t        filter = *ihdr.offset(11) as c_int;\n1068\t        interlace = *ihdr.offset(12) as c_int;\n1069\t        if !(compression == 0) {\n1070\t            fail!(c\"only standard compression DEFLATE is supported\");\n1071\t        }\n1072\t        if !(filter == 0) {\n1073\t            fail!(c\"only standard adaptive filtering is supported\");\n1074\t        }\n1075\t        if !(interlace == 0) {\n1076\t            fail!(c\"interlacing is not supported\");\n1077\t        }\n1078\t        first = png.p;\n1079\t        plte = cp_find(&raw mut png, b\"PLTE\", 0);\n1080\t        if plte.is_null() {\n1081\t            png.p = first;\n1082\t        } else {\n1083\t            first = png.p;\n1084\t        }\n1085\t        trns = cp_find(&raw mut png, b\"tRNS\", 0);\n1086\t        if trns.is_null() {\n1087\t            png.p = first;\n1088\t        } else {\n1089\t            first = png.p;\n1090\t        }\n1091\t        datalen = 0;\n1092\t        {\n1093\t            let mut idat = cp_find(&raw mut png, b\"IDAT\", 0);\n1094\t            while !idat.is_null() {\n1095\t                let len = cp_get_chunk_byte_length(idat);\n1096\t                datalen = (datalen as u32).wrapping_add(len) as c_int;\n1097\t                idat = cp_chunk(&raw mut png, b\"IDAT\", 0);\n1098\t            }\n1099\t        }\n1100\t        png.p = first;\n1101\t        data = malloc(datalen as usize) as *mut u8;\n1102\t        offset = 0;\n1103\t        {\n1104\t            let mut idat = cp_find(&raw mut png, b\"IDAT\", 0);\n1105\t            while !idat.is_null() {\n1106\t                let len = cp_get_chunk_byte_length(idat);\n1107\t                memcpy(\n1108\t                    data.wrapping_offset(offset as isize) as *mut c_void,\n1109\t                    idat as *const c_void,\n1110\t                    len as usize,\n1111\t                );\n1112\t                offset = (offset as u32).wrapping_add(len) as c_int;\n1113\t                idat = cp_chunk(&raw mut png, b\"IDAT\", 0);\n1114\t            }\n1115\t        }\n1116\t        if !(!data.is_null() && datalen >= 6) {\n1117\t            fail!(c\"corrupt z