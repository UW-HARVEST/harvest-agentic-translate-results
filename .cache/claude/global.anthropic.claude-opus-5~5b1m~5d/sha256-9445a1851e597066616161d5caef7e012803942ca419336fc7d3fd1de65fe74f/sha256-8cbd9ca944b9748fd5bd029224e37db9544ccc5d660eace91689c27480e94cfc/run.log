IDAT\"] {\n        for n in [0x7fff_fff8u32, 0x8000_0000, 0xffff_ffff, 0x0010_0000] {\n            let mut v = SIG.to_vec();\n            v.extend_from_slice(&chunk(b\"IHDR\", &ihdr_body(6, 4, 8, 3)));\n            v.extend_from_slice(&chunk_declared_len(kind, n, &[0u8; 8]));\n            v.extend_from_slice(&chunk(b\"IEND\", &[]));\n            cp.png(\n                &format!(\"B4' {} declared len {n:#x}\", String::from_utf8_lossy(kind)),\n                &v,\n            );\n        }\n    }\n    // B9/B10/B13: out-of-range enum bytes in IHDR (all 256 values each)'''\nassert old2 in s\ns = s.replace(old2, new2)\ns = s.replace(\"const IHDR: usize = 16;\\n\", \"\")\ns = s.replace(\"/// Offsets inside a `PngSpec::build()` buffer: 8 sig + 8 chunk header, then IHDR.\\n\", \"\")\nopen(p,'w').write(s)\nPY\ntimeout 600 cargo test --offline --test phase_c_errors -- --test-threads=1 --skip fuzz --skip boundaries --skip row48 2>&1 | tail -40","description":"Move crashing cases to forked runner; rerun"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":602,"cache_read_input_tokens":188799,"cache_creation":{"ephemeral_5m_input_tokens":602,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"1fcac8c8-de4d-4f5d-bb4e-dc7d70d6fb9c","uuid":"5fec8759-d0f4-4c35-9627-5b3ac817d3a6","timestamp":"2026-09-05T09:20:44.546Z"}
