{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01CRJRBfR5sU5wbPFz1ySWg1","type":"tool_result","content":"===== translation/Cargo.toml =====\n     1\t[package]\n     2\tname = \"lib\"\n     3\tversion = \"0.1.0\"\n     4\tedition = \"2021\"\n     5\t\n     6\t[lib]\n     7\tname = \"doubleneg_lib\"\n     8\tcrate-type = [\"cdylib\"]\n     9\tpath = \"src/lib.rs\"\n    10\t\n    11\t[profile.release]\n    12\tpanic = \"abort\"\n    13\t\n    14\t[workspace]\n===== translation/src/lib.rs =====\n     1\t//! Rust translation of the C library in `c_src/`.\n     2\t//!\n     3\t//! The C build globs `c_src/src/*.c` into a single shared library which exports\n     4\t//! exactly six symbols:\n     5\t//!\n     6\t//! | Symbol                   | Signature                                              |\n     7\t//! |--------------------------|--------------------------------------------------------|\n     8\t//! | `convert_double_to_int`  | `int (double)`                                         |\n     9\t//! | `find_value_in_buffer`   | `int (const char *, size_t, int)`                      |\n    10\t//! | `process_negation`       | `int (int)`                                            |\n    11\t//! | `create_numeric_buffer`  | `void (char *, int, int)`                              |\n    12\t//! | `calculate_with_doubles` | `double (int, int, int)`                               |\n    13\t//! | `doubleneg`              | `int (int, int, int, int)`                             |\n    14\t//!\n    15\t//! There are no namespace/renaming macros in `include/lib.h`, so the linker\n    16\t//! names match the source-level names one-for-one.\n    17\t//!\n    18\t//! Behaviour that is undefined or implementation-defined in the original is\n    19\t//! reproduced rather than corrected -- see [`cvt`] for the out-of-range\n    20\t//! `double`-to-`int` casts and [`buffer`] for the signed-`char` truncation.\n    21\t\n    22\t// The crate is a C ABI shim, so the exported entry points intentionally take\n    23\t// raw pointers and use C integer types.\n    24\t#![allow(clippy::missing_safety_doc)]\n    25\t// The crate name mirrors the C library's output name, which is derived from the\n    26\t// enclosing directory and is not snake case.\n    27\t#![allow(non_snake_case)]\n    28\t\n    29\tmod buffer;\n    30\tmod cvt;\n    31\tmod dmath;\n    32\tmod doubleneg;\n    33\tmod ffi;\n    34\tmod negation;\n    35\t\n    36\t// Re-exported so the `#[unsafe(no_mangle)]` definitions are reachable from the\n    37\t// crate root and are not pruned as dead code.\n    38\tpub use buffer::{create_numeric_buffer, find_value_in_buffer};\n    39\tpub use cvt::convert_double_to_int;\n    40\tpub use dmath::calculate_with_doubles;\n    41\tpub use doubleneg::doubleneg;\n    42\tpub use negation::process_negation;\n===== translation/src/ffi.rs =====\n     1\t//! Direct bindings to the C runtime routines that the original library relies\n     2\t//! on.\n     3\t//!\n     4\t//! `lib.c` links against libc and libm (`target_link_libraries(... m)`), and it\n     5\t//! produces all of its observable output through `printf`. Re-using the very\n     6\t//! same `printf` implementation is what guarantees byte-identical output: the\n     7\t//! `%e`/`%d`/`%ld` conversions, the handling of `-0.0`, `inf` and `nan`, and the\n     8\t//! stdout buffering behaviour are then literally the same code that the C\n     9\t//! library ran.\n    10\t//!\n    11\t//! Likewise `pow` is taken from libm rather than re-implemented so that the\n    12\t//! floating point results are bit-for-bit what the C code produced.\n    13\t\n    14\tuse core::ffi::c_char;\n    15\tuse core::ffi::c_int;\n    16\t\n    17\textern \"C\" {\n    18\t    /// C `int printf(const char *restrict format, ...)`.\n    19\t    pub fn printf(format: *const c_char, ...) -> c_int;\n    20\t\n    21\t    /// C `double pow(double x, double y)` from libm.\n    22\t    pub fn pow(x: f64, y: f64) -> f64;\n    23\t}\n    24\t\n    25\t/// Helper for building the NUL-terminated format strings that get handed to\n    26\t/// [`printf`]. The trailing `\\0` is part of the literal so no allocation and no\n    27\t/// runtime work is required.\n    28\tmacro_rules! cstr {\n    29\t    ($s:literal) => {\n    30\t        concat!($s, \"\\0\").as_ptr() as *const core::ffi::c_char\n    31\t    };\n    32\t}\n    33\t\n    34\tpub(crate) use cstr;\n===== translation/src/cvt.rs =====\n     1\t//! Translation of `convert_double_to_int` from `c_src/src/lib.c`.\n     2\t\n     3\tuse core::ffi::c_int;\n     4\t\n     5\t/// Reproduces the x86-64 `cvttsd2si` instruction that GCC emits for the C cast\n     6\t/// `(int)value`.\n     7\t///\n     8\t/// In C, converting a `double` whose truncated value does not fit in an `int`\n     9\t/// (or which is NaN) is undefined behaviour. The original library deliberately\n    10\t/// exercises that UB, and on x86-64 the hardware answers with the \"integer\n    11\t/// indefinite\" value `0x80000000` (`INT_MIN`). The C library's own output\n    12\t/// confirms this: `INFINITY`, `NAN`, `-2^40` and `1e300` all print\n    13\t/// `-2147483648`.\n    14\t///\n    15\t/// This is *not* what Rust's `as i32` does -- Rust saturates, so `1e300 as i32`\n    16\t/// would yield `INT_MAX` and `NAN as i32` would yield `0`. We therefore emulate\n    17\t/// the hardware explicitly instead of fixing up the original behaviour.\n    18\t#[inline]\n    19\tpub fn convert(value: f64) -> c_int {\n    20\t    // NaN never compares in-range, but check explicitly for clarity.\n    21\t    if value.is_nan() {\n    22\t        return c_int::MIN;\n    23\t    }\n    24\t\n    25\t    // `cvttsd2si` truncates toward zero, then reports the indefinite value if\n    26\t    // the truncated result is outside the destination range. Both bounds are\n    27\t    // exactly representable as `f64`, so these comparisons are exact.\n    28\t    let truncated = value.trunc();\n    29\t    if truncated >= -2_147_483_648.0_f64 && truncated <= 2_147_483_647.0_f64 {\n    30\t        truncated as c_int\n    31\t    } else {\n    32\t        c_int::MIN\n    33\t    }\n    34\t}\n    35\t\n    36\t/// C: `int convert_double_to_int(double value)`\n    37\t#[unsafe(no_mangle)]\n    38\tpub extern \"C\" fn convert_double_to_int(value: f64) -> c_int {\n    39\t    convert(value)\n    40\t}\n===== translation/src/buffer.rs =====\n     1\t//! Translation of the buffer helpers `find_value_in_buffer` and\n     2\t//! `create_numeric_buffer` from `c_src/src/lib.c`.\n     3\t\n     4\tuse core::ffi::c_char;\n     5\tuse core::ffi::c_int;\n     6\t\n     7\t/// Equivalent of C `memchr`.\n     8\t///\n     9\t/// `memchr` interprets its `int` needle as an `unsigned char`, which is why the\n    10\t/// caller passes an already-narrowed `u8`. Returns the index of the first match.\n    11\t///\n    12\t/// A zero `size` never dereferences `haystack`, matching glibc's behaviour when\n    13\t/// the pointer is NULL and the length is zero.\n    14\t#[inline]\n    15\tpub fn memchr(haystack: *const c_char, needle: u8, size: usize) -> Option<usize> {\n    16\t    if size == 0 {\n    17\t        return None;\n    18\t    }\n    19\t\n    20\t    // SAFETY: the caller guarantees `haystack` points to at least `size`\n    21\t    // readable bytes, exactly as the C code guarantees to `memchr`.\n    22\t    let bytes = unsafe { core::slice::from_raw_parts(haystack as *const u8, size) };\n    23\t    bytes.iter().position(|&b| b == needle)\n    24\t}\n    25\t\n    26\t/// C: `int find_value_in_buffer(const char *buffer, size_t size, int search_val)`\n    27\t///\n    28\t/// The original narrows `search_val` through `char` before calling `memchr`,\n    29\t/// which then re-widens it and compares as `unsigned char`. The net effect is a\n    30\t/// comparison against the low byte of `search_val`, so `find_value_in_buffer(b,\n    31\t/// n, 300)` looks for byte 44 and `... , -1)` looks for byte 255.\n    32\t#[unsafe(no_mangle)]\n    33\tpub unsafe extern \"C\" fn find_value_in_buffer(\n    34\t    buffer: *const c_char,\n    35\t    size: usize,\n    36\t    search_val: c_int,\n    37\t) -> c_int {\n    38\t    // `char target = (char)search_val;` -- `char` is signed on x86-64 Linux,\n    39\t    // but only the low 8 bits survive either way.\n    40\t    let target = search_val as u8;\n    41\t\n    42\t    match memchr(buffer, target, size) {\n    43\t        // `return (int)((char*)result - buffer);` -- the pointer difference is\n    44\t        // narrowed to `int` by the original cast.\n    45\t        Some(offset) => offset as c_int,\n    46\t        None => -1,\n    47\t    }\n    48\t}\n    49\t\n    50\t/// C: `void create_numeric_buffer(char *buffer, int size, int seed)`\n    51\t///\n    52\t/// Fills `buffer[i] = (char)((seed + i * 7) % 256)`.\n    53\t///\n    54\t/// Two C details are preserved deliberately:\n    55\t///\n    56\t/// * `seed + i * 7` is `int` arithmetic and can overflow for extreme seeds.\n    57\t///   That is UB in C but wraps in practice, so wrapping arithmetic is used.\n    58\t/// * C's `%` truncates toward zero, so a negative `seed` yields a negative\n    59\t///   remainder, and the subsequent `(char)` conversion wraps it into the signed\n    60\t///   char range (e.g. `132` stays `-124` once reinterpreted).\n    61\t///\n    62\t/// A non-positive `size` simply performs no iterations, as in the original loop.\n    63\t#[unsafe(no_mangle)]\n    64\tpub unsafe extern \"C\" fn create_numeric_buffer(buffer: *mut c_char, size: c_int, seed: c_int) {\n    65\t    if size <= 0 {\n    66\t        return;\n    67\t    }\n    68\t\n    69\t    // SAFETY: the caller guarantees `buffer` is writable for `size` bytes, the\n    70\t    // same contract the C function relies on.\n    71\t    let out = unsafe { core::slice::from_raw_parts_mut(buffer, size as usize) };\n    72\t\n    73\t    for (i, slot) in out.iter_mut().enumerate() {\n    74\t        let value = seed.wrapping_add((i as c_int).wrapping_mul(7)) % 256;\n    75\t        // Rust's `%` truncates toward zero just like C's, and `as c_char`\n    76\t        // performs the same truncating conversion GCC applies for `(char)`.\n    77\t        *slot = value as c_char;\n    78\t    }\n    79\t}\n===== translation/src/negation.rs =====\n     1\t//! Translation of `process_negation` from `c_src/src/lib.c`.\n     2\t\n     3\tuse core::ffi::c_int;\n     4\t\n     5\t/// C: `int process_negation(int var1)`\n     6\t///\n     7\t/// The original body is `var2 = !!var1; return var2;` -- the classic\n     8\t/// \"double negation\" idiom that normalises any non-zero value to `1`.\n     9\t#[unsafe(no_mangle)]\n    10\tpub extern \"C\" fn process_negation(var1: c_int) -> c_int {\n    11\t    c_int::from(var1 != 0)\n    12\t}\n===== translation/src/dmath.rs =====\n     1\t//! Translation of `calculate_with_doubles` from `c_src/src/lib.c`.\n     2\t\n     3\tuse core::ffi::c_int;\n     4\t\n     5\tuse crate::ffi;\n     6\t\n     7\t/// Shared implementation so that `doubleneg` observes exactly the same result\n     8\t/// the exported entry point returns.\n     9\t#[inline]\n    10\tpub fn calculate(a: c_int, b: c_int, c: c_int) -> f64 {\n    11\t    let mut result = 0.0_f64;\n    12\t\n    13\t    // Guarding on `b != 0` leaves `result` at 0.0 for a zero divisor rather\n    14\t    // than producing an infinity.\n    15\t    if b != 0 {\n    16\t        result = f64::from(a) / f64::from(b);\n    17\t    }\n    18\t\n    19\t    // `c % 10` truncates toward zero in C, so a negative `c` gives a negative\n    20\t    // exponent. Rust's `%` matches. libm's `pow` is called directly to keep the\n    21\t    // floating point result bit-identical.\n    22\t    let exponent = f64::from(c % 10);\n    23\t    result *= unsafe { ffi::pow(10.0, exponent) };\n    24\t\n    25\t    result\n    26\t}\n    27\t\n    28\t/// C: `double calculate_with_doubles(int a, int b, int c)`\n    29\t#[unsafe(no_mangle)]\n    30\tpub extern \"C\" fn calculate_with_doubles(a: c_int, b: c_int, c: c_int) -> f64 {\n    31\t    calculate(a, b, c)\n    32\t}\n===== translation/src/doubleneg.rs =====\n     1\t//! Translation of `doubleneg` from `c_src/src/lib.c`.\n     2\t//!\n     3\t//! This is the library's headline entry point (the only one declared in\n     4\t//! `include/lib.h`). It is a driver that prints a running commentary while\n     5\t//! exercising the other helpers, so the translation reproduces every `printf`\n     6\t//! call, in order, with the identical format string -- output is produced by the\n     7\t//! very same libc `printf` the C code used.\n     8\t\n     9\tuse core::ffi::c_char;\n    10\tuse core::ffi::c_int;\n    11\tuse core::ffi::c_long;\n    12\t\n    13\tuse crate::buffer;\n    14\tuse crate::cvt;\n    15\tuse crate::dmath;\n    16\tuse crate::ffi;\n    17\tuse crate::ffi::cstr;\n    18\t\n    19\t/// C: `int doubleneg(int param1, int param2, int param3, int param4)`\n    20\t#[unsafe(no_mangle)]\n    21\tpub extern \"C\" fn doubleneg(\n    22\t    param1: c_int,\n    23\t    param2: c_int,\n    24\t    param3: c_int,\n    25\t    param4: c_int,\n    26\t) -> c_int {\n    27\t    let mut result: c_int = 0;\n    28\t    // C: `char buffer[256];` -- declared uninitialised, but\n    29\t    // `create_numeric_buffer` below writes all 256 bytes before any read.\n    30\t    let mut buf: [c_char; 256] = [0; 256];\n    31\t\n    32\t    unsafe {\n    33\t        ffi::printf(cstr!(\"=== Starting foo() execution ===\\n\"));\n    34\t        ffi::printf(\n    35\t            cstr!(\"Parameters: %d, %d, %d, %d\\n\"),\n    36\t            param1,\n    37\t            param2,\n    38\t            param3,\n    39\t            param4,\n    40\t        );\n    41\t\n    42\t        ffi::printf(cstr!(\"\\n--- Integer Negation Test ---\\n\"));\n    43\t        let negation_test: c_int = param1;\n    44\t        let negation_result: c_int = c_int::from(negation_test != 0);\n    45\t        ffi::printf(cstr!(\"Original value: %d\\n\"), negation_test);\n    46\t        ffi::printf(cstr!(\"After !!negation: %d\\n\"), negation_result);\n    47\t        result = result.wrapping_add(negation_result.wrapping_mul(10));\n    48\t\n    49\t        let neg_p2: c_int = c_int::from(param2 != 0);\n    50\t        let neg_p3: c_int = c_int::from(param3 != 0);\n    51\t        let neg_p4: c_int = c_int::from(param4 != 0);\n    52\t        ffi::printf(\n    53\t            cstr!(\"Double negation results: %d, %d, %d\\n\"),\n    54\t            neg_p2,\n    55\t            neg_p3,\n    56\t            neg_p4,\n    57\t        );\n    58\t        result = result\n    59\t            .wrapping_add(neg_p2)\n    60\t            .wrapping_add(neg_p3)\n    61\t            .wrapping_add(neg_p4);\n    62\t\n    63\t        ffi::printf(cstr!(\"\\n--- Double to Int Conversion Test ---\\n\"));\n    64\t\n    65\t        let large_double = dmath::calculate(param1, param2, param3);\n    66\t        ffi::printf(cstr!(\"Calculated double value: %e\\n\"), large_double);\n    67\t\n    68\t        let converted_int = cvt::convert(large_double);\n    69\t        ffi::printf(cstr!(\"Converted to int (may be UB): %d\\n\"), converted_int);\n    70\t\n    71\t        let negative_large = -1.0_f64 * ffi::pow(2.0, 40.0);\n    72\t        ffi::printf(cstr!(\"Very large negative double: %e\\n\"), negative_large);\n    73\t        let converted_neg = cvt::convert(negative_large);\n    74\t        ffi::printf(cstr!(\"Converted to int (UB likely): %d\\n\"), converted_neg);\n    75\t\n    76\t        // Both remainders truncate toward zero; `INT_MIN % 1000` is `-648`.\n    77\t        result = result\n    78\t            .wrapping_add(converted_int % 1000)\n    79\t            .wrapping_add(converted_neg % 1000);\n    80\t\n    81\t        ffi::printf(cstr!(\"\\n--- Memchr Search Test ---\\n\"));\n    82\t\n    83\t        buffer::create_numeric_buffer(buf.as_mut_ptr(), 256, param1);\n    84\t\n    85\t        let search_values: [c_int; 4] = [param2 % 256, param3 % 256, param4 % 256, 42];\n    86\t        let num_searches = search_values.len();\n    87\t\n    88\t        ffi::printf(cstr!(\"Searching buffer for values...\\n\"));\n    89\t        for i in 0..num_searches {\n    90\t            let pos = buffer::find_value_in_buffer(buf.as_ptr(), 256, search_values[i]);\n    91\t            if pos >= 0 {\n    92\t                ffi::printf(\n    93\t                    cstr!(\"Found value %d at position %d\\n\"),\n    94\t                    search_values[i],\n    95\t                    pos,\n    96\t                );\n    97\t                result = result.wrapping_add(pos);\n    98\t            } else {\n    99\t                ffi::printf(cstr!(\"Value %d not found\\n\"), search_values[i]);\n   100\t            }\n   101\t        }\n   102\t\n   103\t        // C: `char *direct_search = (char*)memchr(buffer, 100, 256);`\n   104\t        let direct_search = buffer::memchr(buf.as_ptr(), 100, 256);\n   105\t        if let Some(offset) = direct_search {\n   106\t            ffi::printf(\n   107\t                cstr!(\"Direct memchr found byte 100 at offset: %ld\\n\"),\n   108\t                offset as c_long,\n   109\t            );\n   110\t            result = result.wrapping_add(offset as c_int);\n   111\t        }\n   112\t\n   113\t        ffi::printf(cstr!(\"\\n--- Combined Feature Test ---\\n\"));\n   114\t        for i in 0..10_i32 {\n   115\t            let search_byte: c_int = param1.wrapping_add(i.wrapping_mul(param2)) % 256;\n   116\t            let found = buffer::memchr(buf.as_ptr(), search_byte as u8, 256);\n   117\t            // C: `int found_flag = !!found;` -- double negation on a pointer.\n   118\t            let found_flag: c_int = c_int::from(found.is_some());\n   119\t            ffi::printf(\n   120\t                cstr!(\"Search %d: byte=%d, found=%d\\n\"),\n   121\t                i,\n   122\t                search_byte,\n   123\t                found_flag,\n   124\t            );\n   125\t            result = result.wrapping_add(found_flag);\n   126\t        }\n   127\t\n   128\t        let infinity_val = f64::INFINITY;\n   129\t        let nan_val = f64::NAN;\n   130\t\n   131\t        ffi::printf(cstr!(\"\\n--- Special Double Values ---\\n\"));\n   132\t        ffi::printf(cstr!(\"Converting INFINITY to int: \"));\n   133\t        let inf_as_int = cvt::convert(infinity_val);\n   134\t        ffi::printf(cstr!(\"%d (undefined behavior)\\n\"), inf_as_int);\n   135\t\n   136\t        ffi::printf(cstr!(\"Converting NAN to int: \"));\n   137\t        let nan_as_int = cvt::convert(nan_val);\n   138\t        ffi::printf(cstr!(\"%d (undefined behavior)\\n\"), nan_as_int);\n   139\t\n   140\t        ffi::printf(cstr!(\"\\n=== Final Result ===\\n\"));\n   141\t        ffi::printf(cstr!(\"Accumulated result: %d\\n\"), result);\n   142\t    }\n   143\t\n   144\t    result\n   145\t}","is_error":false}]},"parent_tool_use_id":null,"session_id":"7916fcfe-1ecc-4e84-9174-9e7480706eb2","uuid":"f36be697-d705-4938-8510-906526b41c10","timestamp":"2026-08-28T00:20:45.958Z","tool_use_result":{"stdout":"===== translation/Cargo.toml =====\n     1\t[package]\n     2\tname = \"lib\"\n     3\tversion = \"0.1.0\"\n     4\tedition = \"2021\"\n     5\t\n     6\t[lib]\n     7\tname = \"doubleneg_lib\"\n     8\tcrate-type = [\"cdylib\"]\n     9\tpath = \"src/lib.rs\"\n    10\t\n    11\t[profile.release]\n    12\tpanic = \"abort\"\n    13\t\n    14\t[workspace]\n===== translation/src/lib.rs =====\n     1\t//! Rust translation of the C library in `c_src/`.\n     2\t//!\n     3\t//! The C build globs `c_src/src/*.c` into a single shared library which exports\n     4\t//! exactly six symbols:\n     5\t//!\n     6\t//! | Symbol                   | Signature                                              |\n     7\t//! |--------------------------|--------------------------------------------------------|\n     8\t//! | `convert_double_to_int`  | `int (double)`                                         |\n     9\t//! | `find_value_in_buffer`   | `int (const char *, size_t, int)`                      |\n    10\t//! | `process_negation`       | `int (int)`                                            |\n    11\t//! | `create_numeric_buffer`  | `void (char *, int, int)`                              |\n    12\t//! | `calculate_with_doubles` | `double (int, int, int)`                               |\n    13\t//! | `doubleneg`              | `int (int, int, int, int)`                             |\n    14\t//!\n    15\t//! There are no namespace/renaming macros in `include/lib.h`, so the linker\n    16\t//! names match the source-level names one-for-one.\n    17\t//!\n    18\t//! Behaviour that is undefined or implementation-defined in the original is\n    19\t//! reproduced rather than corrected -- see [`cvt`] for the out-of-range\n    20\t//! `double`-to-`int` casts and [`buffer`] for the signed-`char` truncation.\n    21\t\n    22\t// The crate is a C ABI shim, so the exported entry points intentionally take\n    23\t// raw pointers and use C integer types.\n    24\t#![allow(clippy::missing_safety_doc)]\n    25\t// The crate name mirrors the C library's output name, which is derived from the\n    26\t// enclosing directory and is not snake case.\n    27\t#![allow(non_snake_case)]\n    28\t\n    29\tmod buffer;\n    30\tmod cvt;\n    31\tmod dmath;\n    32\tmod doubleneg;\n    33\tmod ffi;\n    34\tmod negation;\n    35\t\n    36\t// Re-exported so the `#[unsafe(no_mangle)]` definitions are reachable from the\n    37\t// crate root and are not pruned as dead code.\n    38\tpub use buffer::{create_numeric_buffer, find_value_in_buffer};\n    39\tpub use cvt::convert_double_to_int;\n    40\tpub use dmath::calculate_with_doubles;\n    41\tpub use doubleneg::doubleneg;\n    42\tpub use negation::process_negation;\n===== translation/src/ffi.rs =====\n     1\t//! Direct bindings to the C runtime routines that the original library relies\n     2\t//! on.\n     3\t//!\n     4\t//! `lib.c` links against libc and libm (`target_link_libraries(... m)`), and it\n     5\t//! produces all of its observable output through `printf`. Re-using the very\n     6\t//! same `printf` implementation is what guarantees byte-identical output: the\n     7\t//! `%e`/`%d`/`%ld` conversions, the handling of `-0.0`, `inf` and `nan`, and the\n     8\t//! stdout buffering behaviour are then literally the same code that the C\n     9\t//! library ran.\n    10\t//!\n    11\t//! Likewise `pow` is taken from libm rather than re-implemented so that the\n    12\t//! floating point results are bit-for-bit what the C code produced.\n    13\t\n    14\tuse core::ffi::c_char;\n    15\tuse core::ffi::c_int;\n    16\t\n    17\textern \"C\" {\n    18\t    /// C `int printf(const char *restrict format, ...)`.\n    19\t    pub fn printf(format: *const c_char, ...) -> c_int;\n    20\t\n    21\t    /// C `double pow(double x, double y)` from libm.\n    22\t    pub fn pow(x: f64, y: f64) -> f64;\n    23\t}\n    24\t\n    25\t/// Helper for building the NUL-terminated format strings that get handed to\n    26\t/// [`printf`]. The trailing `\\0` is part of the literal so no allocation and no\n    27\t/// runtime work is required.\n    28\tmacro_rules! cstr {\n    29\t    ($s:literal) => {\n    30\t        concat!($s, \"\\0\").as_ptr() as *const core::ffi::c_char\n    31\t    };\n    32\t}\n    33\t\n    34\tpub(crate) use cstr;\n===== translation/src/cvt.rs =====\n     1\t//! Translation of `convert_double_to_int` from `c_src/src/lib.c`.\n     2\t\n     3\tuse core::ffi::c_int;\n     4\t\n     5\t/// Reproduces the x86-64 `cvttsd2si` instruction that GCC emits for the C cast\n     6\t/// `(int)value`.\n     7\t///\n     8\t/// In C, converting a `double` whose truncated value does not fit in an `int