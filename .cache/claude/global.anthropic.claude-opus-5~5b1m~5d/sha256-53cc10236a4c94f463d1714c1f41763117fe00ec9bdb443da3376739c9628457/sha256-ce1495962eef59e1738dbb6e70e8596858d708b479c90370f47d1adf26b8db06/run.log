// caller passes an already-narrowed `u8`. Returns the index of the first match.\n    11\t///\n    12\t/// A zero `size` never dereferences `haystack`, matching glibc's behaviour when\n    13\t/// the pointer is NULL and the length is zero.\n    14\t#[inline]\n    15\tpub fn memchr(haystack: *const c_char, needle: u8, size: usize) -> Option<usize> {\n    16\t    if size == 0 {\n    17\t        return None;\n    18\t    }\n    19\t\n    20\t    // SAFETY: the caller guarantees `haystack` points to at least `size`\n    21\t    // readable bytes, exactly as the C code guarantees to `memchr`.\n    22\t    let bytes = unsafe { core::slice::from_raw_parts(haystack as *const u8, size) };\n    23\t    bytes.iter().position(|&b| b == needle)\n    24\t}\n    25\t\n    26\t/// C: `int find_value_in_buffer(const char *buffer, size_t size, int search_val)`\n    27\t///\n    28\t/// The original narrows `search_val` through `char` before calling `memchr`,\n    29\t/// which then re-widens it and compares as `unsigned char`. The net effect is a\n    30\t/// comparison against the low byte of `search_val`, so `find_value_in_buffer(b,\n    31\t/// n, 300)` looks for byte 44 and `... , -1)` looks for byte 255.\n    32\t#[unsafe(no_mangle)]\n    33\tpub unsafe extern \"C\" fn find_value_in_buffer(\n    34\t    buffer: *const c_char,\n    35\t    size: usize,\n    36\t    search_val: c_int,\n    37\t) -> c_int {\n    38\t    // `char target = (char)search_val;` -- `char` is signed on x86-64 Linux,\n    39\t    // but only the low 8 bits survive either way.\n    40\t    let target = search_val as u8;\n    41\t\n    42\t    match memchr(buffer, target, size) {\n    43\t        // `return (int)((char*)result - buffer);` -- the pointer difference is\n    44\t        // narrowed to `int` by the original cast.\n    45\t        Some(offset) => offset as c_int,\n    46\t        None => -1,\n    47\t    }\n    48\t}\n    49\t\n    50\t/// C: `void create_numeric_buffer(char *buffer, int size, int seed)`\n    51\t///\n    52\t/// Fills `buffer[i] = (char)((seed + i * 7) % 256)`.\n    53\t///\n    54\t/// Two C details are preserved deliberately:\n    55\t///\n    56\t/// * `seed + i * 7` is `int` arithmetic and can overflow for extreme seeds.\n    57\t///   That is UB in C but wraps in practice, so wrapping arithmetic is used.\n    58\t/// * C's `%` truncates toward zero, so a negative `seed` yields a negative\n    59\t///   remainder, and the subsequent `(char)` conversion wraps it into the signed\n    60\t///   char range (e.g. `132` stays `-124` once reinterpreted).\n    61\t///\n    62\t/// A non-positive `size` simply performs no iterations, as in the original loop.\n    63\t#[unsafe(no_mangle)]\n    64\tpub unsafe extern \"C\" fn create_numeric_buffer(buffer: *mut c_char, size: c_int, seed: c_int) {\n    65\t    if size <= 0 {\n    66\t        return;\n    67\t    }\n    68\t\n    69\t    // SAFETY: the caller guarantees `buffer` is writable for `size` bytes, the\n    70\t    // same contract the C function relies on.\n    71\t    let out = unsafe { core::slice::from_raw_parts_mut(buffer, size as usize) };\n    72\t\n    73\t    for (i, slot) in out.iter_mut().enumerate() {\n    74\t        let value = seed.wrapping_add((i as c_int).wrapping_mul(7)) % 256;\n    75\t        // Rust's `%` truncates toward zero just like C's, and `as c_char`\n    76\t        // performs the same truncating conversion GCC applies for `(char)`.\n    77\t        *slot = value as c_char;\n    78\t    }\n    79\t}\n===== translation/src/negation.rs =====\n     1\t//! Translation of `process_negation` from `c_src/src/lib.c`.\n     2\t\n     3\tuse core::ffi::c_int;\n     4\t\n     5\t/// C: `int process_negation(int var1)`\n     6\t///\n     7\t/// The original body is `var2 = !!var1; return var2;` -- the classic\n     8\t/// \"double negation\" idiom that normalises any non-zero value to `1`.\n     9\t#[unsafe(no_mangle)]\n    10\tpub extern \"C\" fn process_negation(var1: c_int) -> c_int {\n    11\t    c_int::from(var1 != 0)\n    12\t}\n===== translation/src/dmath.rs =====\n     1\t//! Translation of `calculate_with_doubles` from `c_src/src/lib.c`.\n     2\t\n     3\tuse core::ffi::c_int;\n     4\t\n     5\tuse crate::ffi;\n     6\t\n     7\t/// Shared implementation so that `doubleneg` observes exactly the same result\n     8\t/// the exported entry point returns.\n     9\t#[inline]\n    10\tpub fn calculate(a: c_int, b: c_int, c: c_int) -> f64 {\n    11\t    let mut result = 0.0_f64;\n    12\t\n    13\t    // Guarding on `b != 0` leaves `result` at 0.0 for a zero divisor rather\n    14\t    // than producing an infinity.\n    15\t    if b != 0 {\n    16\t        result = f64::from(a) / f64::from(b);\n    17\t    }\n    18\t\n    19\t    // `c % 10` truncates toward zero in C, so a negative `c` gives a negative\n    20\t    // exponent. Rust's `%` matches. libm's `pow` is called directly to keep the\n    21\t    // floating point result bit-identical.\n    22\t    let exponent = f64::from(c % 10);\n    23\t    result *= unsafe { ffi::pow(10.0, exponent) };\n    24\t\n    25\t    result\n    26\t}\n    27\t\n    28\t/// C: `double calculate_with_doubles(int a, int b, int c)`\n    29\t#[unsafe(no_mangle)]\n    30\tpub extern \"C\" fn calculate_with_doubles(a: c_int, b: c_int, c: c_int) -> f64 {\n    31\t    calculate(a, b, c)\n    32\t}\n===== translation/src/doubleneg.rs =====\n     1\t//! Translation of `doubleneg` from `c_src/src/lib.c`.\n     2\t//!\n     3\t//! This is the library's headline entry point (the only one declared in\n     4\t//! `include/lib.h`). It is a driver that prints a running commentary while\n     5\t//! exercising the other helpers, so the translation reproduces every `printf`\n     6\t//! call, in order, with the identical format string -- output is produced by the\n     7\t//! very same libc `printf` the C code used.\n     8\t\n     9\tuse core::ffi::c_char;\n    10\tuse core::ffi::c_int;\n    11\tuse core: