  pub sA: c2v,\n124\t    pub sB: c2v,\n125\t    pub p: c2v,\n126\t    pub u: f32,\n127\t    pub iA: c_int,\n128\t    pub iB: c_int,\n129\t}\n130\t\n131\t/// ```c\n132\t/// typedef struct { c2sv a, b, c, d; float div; int count; } c2Simplex;\n133\t/// ```\n134\t///\n135\t/// The four `c2sv` members are stored as a fixed size array: a `#[repr(C)]`\n136\t/// struct with four consecutive members of the same type has exactly the same\n137\t/// layout as `[c2sv; 4]`, and the C code itself relies on that by walking\n138\t/// `c2sv *verts = &s->a;` as an array.\n139\t#[repr(C)]\n140\t#[derive(Clone, Copy, Debug, Default)]\n141\tpub struct c2Simplex {\n142\t    pub verts: [c2sv; 4],\n143\t    pub div: f32,\n144\t    pub count: c_int,\n145\t}\n146\t\n147\t// ---------------------------------------------------------------------------\n148\t// Layout assertions - these mirror what the C compiler reports for the same\n149\t// declarations (verified with sizeof/_Alignof/offsetof against c_src).\n150\t// ---------------------------------------------------------------------------\n151\t\n152\tconst _: () = {\n153\t    use std::mem::{align_of, offset_of, size_of};\n154\t    assert!(size_of::<c2v>() == 8 && align_of::<c2v>() == 4);\n155\t    assert!(size_of::<c2r>() == 8 && align_of::<c2r>() == 4);\n156\t    assert!(size_of::<c2x>() == 16 && align_of::<c2x>() == 4);\n157\t    assert!(size_of::<c2Circle>() == 12 && align_of::<c2Circle>() == 4);\n158\t    assert!(size_of::<c2AABB>() == 16 && align_of::<c2AABB>() == 4);\n159\t    assert!(size_of::<c2Capsule>() == 20 && align_of::<c2Capsule>() == 4);\n160\t\n161\t    assert!(size_of::<c2GJKCache>() == 36 && align_of::<c2GJKCache>() == 4);\n162\t    assert!(offset_of!(c2GJKCache, metric) == 0);\n163\t    assert!(offset_of!(c2GJKCache, count) == 4);\n164\t    assert!(offset_of!(c2GJKCache, iA) == 8);\n165\t    assert!(offset_of!(c2GJKCache, iB) == 20);\n166\t    assert!(offset_of!(c2GJKCache, div) == 32);\n167\t\n168\t    assert!(size_of::<c2Proxy>() == 72 && align_of::<c2Proxy>() == 4);\n169\t    assert!(offset_of!(c2Proxy, radius) == 0);\n170\t    assert!(offset_of!(c2Proxy, count) == 4);\n171\t    assert!(offset_of!(c2Proxy, verts) == 8);\n172\t\n173\t    assert!(size_of::<c2sv>() == 36 && align_of::<c2sv>() == 4);\n174\t    assert!(offset_of!(c2sv, sA) == 0);\n175\t    assert!(offset_of!(c2sv, sB) == 8);\n176\t    assert!(offset_of!(c2sv, p) == 16);\n177\t    assert!(offset_of!(c2sv, u) == 24);\n178\t    assert!(offset_of!(c2sv, iA) == 28);\n179\t    assert!(offset_of!(c2sv, iB) == 32);\n180\t\n181\t    // `verts[0..4]` must land exactly on the C members `a`, `b`, `c`, `d`.\n182\t    assert!(size_of::<c2Simplex>() == 152 && align_of::<c2Simplex>() == 4);\n183\t    assert!(offset_of!(c2Simplex, verts) == 0);\n184\t    assert!(offset_of!(c2Simplex, div) == 144);\n185\t    assert!(offset_of!(c2Simplex, count) == 148);\n186\t};\n187\t\n188\t// ---------------------------------------------------------------------------\n189\t// Small vector helpers (each one is also a public C symbol)\n190\t// ---------------------------------------------------------------------------\n191\t\n192\t/// Materialise a float negation exactly where the C source performs it.\n193\t///\n194\t/// The C library is compiled without optimisation, so `-x` is always emitted as\n195\t/// a standalone `xorps` sign flip whose result is then fed to the following\n196\t/// `mulss`/`addss`.  LLVM, in contrast, happily rewrites `(-x) * y` into\n197\t/// `-(x * y)` and `(-x) * y + z` into `z - x * y`; those are value-identical for\n198\t/// every finite input but produce a different *sign bit* when a NaN flows\n199\t/// through.  An optimisation barrier keeps the emitted sequence (and therefore\n200\t/// the NaN payload/sign propagation) identical to the C build.\n201\t#[inline]\n202\tfn cneg(x: f32) -> f32 {\n203\t    std::hint::black_box(-x)\n204\t}\n205\t\n206\t#[unsafe(no_mangle)]\n207\tpub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n208\t    let mut a = c2v { x: 0.0, y: 0.0 };\n209\t    a.x = x;\n210\t    a.y = y;\n211\t    a\n212\t}\n213\t\n214\t#[unsafe(no_mangle)]\n215\tpub extern \"C\" fn c2Mulvs(mut a: c2v, b: f32) -> c2v {\n216\t    a.x *= b;\n217\t    a.y *= b;\n218\t    a\n219\t}\n220\t\n221\t#[unsafe(no_mangle)]\n222\tpub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n223\t    c2V(\n224\t        if a.x > b.x { a.x } else { b.x },\n225\t        if a.y > b.y { a.y } else { b.y },\n226\t    )\n227\t}\n228\t\n229\t#[unsafe(no_mangle)]\n230\tpub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n231\t    c2V(\n232\t        if a.x < b.x { a.x } else { b.x },\n233\t        if a.y < b.y { a.y } else { b.y },\n234\t    )\n235\t}\n236\t\n237\t#[unsafe(no_mangle)]\n238\tpub extern \"C\" fn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n239\t    c2Maxv(lo, c2Minv(a, hi))\n240\t}\n241\t\n242\t#[unsafe(no_mangle)]\n243\tpub extern \"C\" fn c2Sub(mut a: c2v, b: c2v) -> c2v {\n244\t    a.x -= b.x;\n245\t    a.y -= b.y;\n246\t    a\n247\t}\n248\t\n249\t#[unsafe(no_mangle)]\n250\tpub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n251\t    a.x * b.x + a.y * b.y\n252\t}\n253\t\n254\t#[unsafe(no_mangle)]\n255\tpub extern \"C\" fn c2RotIdentity() -> c2r {\n256\t    let mut r = c2r { c: 0.0, s: 0.0 };\n257\t    r.c = 1.0f32;\n258\t    r.s = 0.0;\n259\t    r\n260\t}\n261\t\n262\t#[unsafe(no_mangle)]\n263\tpub extern \"C\" fn c2xIdentity() -> c2x {\n264\t    let mut x = c2x {\n265\t        p: c2v { x: 0.0, y: 0.0 },\n266\t        r: c2r { c: 0.0, s: 0.0 },\n267\t    };\n268\t    x.p = c2V(0.0, 0.0);\n269\t    x.r = c2RotIdentity();\n270\t    x\n271\t}\n272\t\n273\t#[unsafe(no_mangle)]\n274\tpub extern \"C\" fn c2Len(a: c2v) -> f32 {\n275\t    c2Dot(a, a).sqrt()\n276\t}\n277\t\n278\t#[unsafe(no_mangle)]\n279\tpub extern \"C\" fn c2Det2(a: c2v, b: c2v) -> f32 {\n280\t    a.x * b.y - a.y * b.x\n281\t}\n282\t\n283\t#[unsafe(no_mangle)]\n284\tpub extern \"C\" fn c2Mulrv(a: c2r, b: c2v) -> c2v {\n285\t    c2V(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)\n286\t}\n287\t\n288\t#[unsafe(no_mangle)]\n289\tpub extern \"C\" fn c2Add(mut a: c2v, b: c2v) -> c2v {\n290\t    a.x += b.x;\n291\t    a.y += b.y;\n292\t    a\n293\t}\n294\t\n295\t#[unsafe(no_mangle)]\n296\tpub extern \"C\" fn c2Mulxv(a: c2x, b: c2v) -> c2v {\n297\t    c2Add(c2Mulrv(a.r, b), a.p)\n298\t}\n299\t\n300\t#[unsafe(no_mangle)]\n301\tpub extern \"C\" fn c2Neg(a: c2v) -> c2v {\n302\t    c2V(cneg(a.x), cneg(a.y))\n303\t}\n304\t\n305\t#[unsafe(no_mangle)]\n306\tpub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n307\t    let mut b = c2v { x: 0.0, y: 0.0 };\n308\t    b.x = cneg(a.y);\n309\t    b.y = a.x;\n310\t    b\n311\t}\n312\t\n313\t#[unsafe(no_mangle)]\n314\tpub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n315\t    let mut b = c2v { x: 0.0, y: 0.0 };\n316\t    b.x = a.y;\n317\t    b.y = cneg(a.x);\n318\t    b\n319\t}\n320\t\n321\t#[unsafe(no_mangle)]\n322\tpub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n323\t    c2Mulvs(a, 1.0f32 / b)\n324\t}\n325\t\n326\t#[unsafe(no_mangle)]\n327\tpub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n328\t    c2Div(a, c2Len(a))\n329\t}\n330\t\n331\t#[unsafe(no_mangle)]\n332\tpub extern \"C\" fn c2MulrvT(a: c2r, b: c2v) -> c2v {\n333\t    c2V(a.c * b.x + a.s * b.y, cneg(a.s) * b.x + a.c * b.y)\n334\t}\n335\t\n336\t// ---------------------------------------------------------------------------\n337\t// Proxies\n338\t// ---------------------------------------------------------------------------\n339\t\n340\t#[unsafe(no_mangle)]\n341\tpub unsafe extern \"C\" fn c2BBVerts(out: *mut c2v, bb: *mut c2AABB) {\n342\t    unsafe {\n343\t        let bb = &*bb;\n344\t        *out.add(0) = bb.min;\n345\t        *out.add(1) = c2V(bb.max.x, bb.min.y);\n346\t        *out.add(2) = bb.max;\n347\t        *out.add(3) = c2V(bb.min.x, bb.max.y);\n348\t    }\n349\t}\n350\t\n351\t#[unsafe(no_mangle)]\n352\tpub unsafe extern \"C\" fn c2MakeProxy(shape: *const c_void, type_: c_int, p: *mut c2Proxy) {\n353\t    unsafe {\n354\t        match type_ {\n355\t            C2_TYPE_CIRCLE => {\n356\t                let c = shape as *mut c2Circle;\n357\t                (*p).radius = (*c).r;\n358\t                (*p).count = 1;\n359\t                (*p).verts[0] = (*c).p;\n360\t            }\n361\t            C2_TYPE_AABB => {\n362\t                let bb = shape as *mut c2AABB;\n363\t                (*p).radius = 0.0;\n364\t                (*p).count = 4;\n365\t                c2BBVerts((*p).verts.as_mut_ptr(), bb);\n366\t            }\n367\t            C2_TYPE_CAPSULE => {\n368\t                let c = shape as *mut c2Capsule;\n369\t                (*p).radius = (*c).r;\n370\t                (*p).count = 2;\n371\t                (*p).verts[0] = (*c).a;\n372\t                (*p).verts[1] = (*c).b;\n373\t            }\n374\t            // The C switch has no `default:` label - nothing is written.\n375\t            _ => {}\n376\t        }\n377\t    }\n378\t}\n379\t\n380\t// ---------------------------------------------------------------------------\n381\t// Simplex helpers\n382\t// ---------------------------------------------------------------------------\n383\t\n384\tfn gjk_simplex_metric(s: &c2Simplex) -> f32 {\n385\t    match s.count {\n386\t        // `default:` falls through into `case 1:` in the C source.\n387\t        2 => c2Len(c2Sub(s.verts[1].p, s.verts[0].p)),\n388\t        3 => c2Det2(\n389\t            c2Sub(s.verts[1].p, s.verts[0].p),\n390\t            c2Sub(s.verts[2].p, s.verts[0].p),\n391\t        ),\n392\t        _ => 0.0,\n393\t    }\n394\t}\n395\t\n396\t#[unsafe(no_mangle)]\n397\tpub unsafe extern \"C\" fn c2GJKSimplexMetric(s: *mut c2Simplex) -> f32 {\n398\t    unsafe { gjk_simplex_metric(&*s) }\n399\t}\n400\t\n401\tfn simplex2(s: &mut c2Simplex) {\n402\t    let a = s.verts[0].p;\n403\t    let b = s.verts[1].p;\n404\t    let u = c2Dot(b, c2Sub(b, a));\n405\t    let vv = c2Dot(a, c2Sub(a, b));\n406\t    if vv <= 0.0 {\n407\t        s.verts[0].u = 1.0f32;\n408\t        s.div = 1.0f32;\n409\t        s.count = 1;\n410\t    } else if u <= 0.0 {\n411\t        s.verts[0] = s.verts[1];\n412\t        s.verts[0].u = 1.0f32;\n413\t        s.div = 1.0f32;\n414\t        s.count = 1;\n415\t    } else {\n416\t        s.verts[0].u = u;\n417\t        s.verts[1].u = vv;\n418\t        s.div = u + vv;\n419\t        s.count = 2;\n420\t    }\n421\t}\n422\t\n423\t#[unsafe(no_mangle)]\n424\tpub unsafe extern \"C\" fn c22(s: *mut c2Simplex) {\n425\t    unsafe { simplex2(&mut *s) }\n426\t}\n427\t\n428\tfn simplex3(s: &mut c2Simplex) {\n429\t    let a = s.verts[0].p;\n430\t    let b = s.verts[1].p;\n431\t    let c = s.verts[2].p;\n432\t    let uAB = c2Dot(b, c2Sub(b, a));\n433\t    let vAB = c2Dot(a, c2Sub(a, b));\n434\t    let uBC = c2Dot(c, c2Sub(c, b));\n435\t    let vBC = c2Dot(b, c2Sub(b, c));\n436\t    let uCA = c2Dot(a, c2Sub(a, c));\n437\t    let vCA = c2Dot(c, c2Sub(c, a));\n438\t    let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n439\t    let uABC = c2Det2(b, c) * area;\n440\t    let vABC = c2Det2(c, a) * area;\n441\t    let wABC = c2Det2(a, b) * area;\n442\t    if vAB <= 0.0 && uCA <= 0.0 {\n443\t        s.verts[0].u = 1.0f32;\n444\t        s.div = 1.0f32;\n445\t        s.count = 1;\n446\t    } else if uAB <= 0.0 && vBC <= 0.0 {\n447\t        s.verts[0] = s.verts[1];\n448\t        s.verts[0].u = 1.0f32;\n449\t        s.div = 1.0f32;\n450\t        s.count = 1;\n451\t    } else if uBC <= 0.0 && vCA <= 0.0 {\n452\t        s.verts[0] = s.verts[2];\n453\t        s.verts[0].u = 1.0f32;\n454\t        s.div = 1.0f32;\n455\t        s.count = 1;\n456\t    } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n457\t        s.verts[0].u = uAB;\n458\t        s.verts[1].u = vAB;\n459\t        s.div = uAB + vAB;\n460\t        s.count = 2;\n461\t    } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n462\t        s.verts[0] = s.verts[1];\n463\t        s.verts[1] = s.verts[2];\n464\t        s.verts[0].u = uBC;\n465\t        s.verts[1].u = vBC;\n466\t        s.div = uBC + vBC;\n467\t        s.count = 2;\n468\t    } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n469\t        s.verts[1] = s.verts[0];\n470\t        s.verts[0] = s.verts[2];\n471\t        s.verts[0].u = uCA;\n472\t        s.verts[1].u = vCA;\n473\t        s.div = uCA + vCA;\n474\t        s.count = 2;\n475\t    } else {\n476\t        s.verts[0].u = uABC;\n477\t        s.verts[1].u = vABC;\n478\t        s.verts[2].u = wABC;\n479\t        s.div = uABC + vABC + wABC;\n480\t        s.count = 3;\n481\t    }\n482\t}\n483\t\n484\t#[unsafe(no_mangle)]\n485\tpub unsafe extern \"C\" fn c23(s: *mut c2Simplex) {\n486\t    unsafe { simplex3(&mut *s) }\n487\t}\n488\t\n489\tfn direction(s: &c2Simplex) -> c2v {\n490\t    match s.count {\n491\t        1 => c2Neg(s.verts[0].p),\n492\t        2 => {\n493\t            let ab = c2Sub(s.verts[1].p, s.verts[0].p);\n494\t            if c2Det2(ab, c2Neg(s.verts[0].p)) > 0.0 {\n495\t                return c2Skew(ab);\n496\t            }\n497\t            c2CCW90(ab)\n498\t        }\n499\t        // `case 3:` and `default:` both give the zero vector.\n500\t        _ => c2V(0.0, 0.0),\n501\t    }\n502\t}\n503\t\n504\t#[unsafe(no_mangle)]\n505\tpub unsafe extern \"C\" fn c2D(s: *mut c2Simplex) -> c2v {\n506\t    unsafe { direction(&*s) }\n507\t}\n508\t\n509\t#[unsafe(no_mangle)]\n510\tpub unsafe extern \"C\" fn c2Support(verts: *const c2v, count: c_int, d: c2v) -> c_int {\n511\t    unsafe {\n512\t        let mut imax: c_int = 0;\n513\t        let mut dmax = c2Dot(*verts.add(0), d);\n514\t        let mut i: c_int = 1;\n515\t        while i < count {\n516\t            let dot = c2Dot(*verts.offset(i as isize), d);\n517\t            if dot > dmax {\n518\t                imax = i;\n519\t                dmax = dot;\n520\t            }\n521\t            i += 1;\n522\t        }\n523\t        imax\n524\t    }\n525\t}\n526\t\n527\tfn witness(s: &c2Simplex) -> (c2v, c2v) {\n528\t    let den = 1.0f32 / s.div;\n529\t    match s.count {\n530\t        1 => (s.verts[0].sA, s.verts[0].sB),\n531\t        2 => (\n532\t            c2Add(\n533\t                c2Mulvs(s.verts[0].sA, den * s.verts[0].u),\n534\t                c2Mulvs(s.verts[1].sA, den * s.verts[1].u),\n535\t            ),\n536\t            c2Add(\n537\t                c2Mulvs(s.verts[0].sB, den * s.verts[0].u),\n538\t                c2Mulvs(s.verts[1].sB, den * s.verts[1].u),\n539\t            ),\n540\t        ),\n541\t        3 => (\n542\t            c2Add(\n543\t                c2Add(\n544\t                    c2Mulvs(s.verts[0].sA, den * s.verts[0].u),\n545\t                    c2Mulvs(s.verts[1].sA, den * s.verts[1].u),\n546\t                ),\n547\t                c2Mulvs(s.verts[2].sA, den * s.verts[2].u),\n548\t            ),\n549\t            c2Add(\n550\t                c2Add(\n551\t                    c2Mulvs(s.verts[0].sB, den * s.verts[0].u),\n552\t                    c2Mulvs(s.verts[1].sB, den * s.verts[1].u),\n553\t                ),\n554\t                c2Mulvs(s.verts[2].sB, den * s.verts[2].u),\n555\t            ),\n556\t        ),\n557\t        _ => (c2V(0.0, 0.0), c2V(0.0, 0.0)),\n558\t    }\n559\t}\n560\t\n561\t#[unsafe(no_mangle)]\n562\tpub unsafe extern \"C\" fn c2Witness(s: *mut c2Simplex, a: *mut c2v, b: *mut c2v) {\n563\t    unsafe {\n564\t        let (wa, wb) = witness(&*s);\n565\t        *a = wa;\n566\t        *b = wb;\n567\t    }\n568\t}\n569\t\n570\tfn lerp_point(s: &c2Simplex) -> c2v {\n571\t    let den = 1.0f32 / s.div;\n572\t    match s.count {\n573\t        1 => s.verts[0].p,\n574\t        2 => c2Add(\n575\t            c2Mulvs(s.verts[0].p, den * s.verts[0].u),\n576\t            c2Mulvs(s.verts[1].p, den * s.verts[1].u),\n577\t        ),\n578\t        _ => c2V(0.0, 0.0),\n579\t    }\n580\t}\n581\t\n582\t#[unsafe(no_mangle)]\n583\tpub unsafe extern \"C\" fn c2L(s: *mut c2Simplex) -> c2v {\n584\t    unsafe { lerp_point(&*s) }\n585\t}\n586\t\n587\t// ---------------------------------------------------------------------------\n588\t// GJK\n589\t// ---------------------------------------------------------------------------\n590\t\n591\t#[unsafe(no_mangle)]\n592\tpub unsafe extern \"C\" fn c2GJK(\n593\t    A: *const c_void,\n594\t    typeA: c_int,\n595\t    ax_ptr: *const c2x,\n596\t    B: *const c_void,\n597\t    typeB: c_int,\n598\t    bx_ptr: *const c2x,\n599\t    outA: *mut c2v,\n600\t    outB: *mut c2v,\n601\t    use_radius: c_int,\n602\t    iterations: *mut c_int,\n603\t    cache: *mut c2GJKCache,\n604\t) -> f32 {\n605\t    unsafe {\n606\t        let ax: c2x = if ax_ptr.is_null() {\n607\t            c2xIdentity()\n608\t        } else {\n609\t            *ax_ptr\n610\t        };\n611\t        let bx: c2x = if bx_ptr.is_null() {\n612\t            c2xIdentity()\n613\t        } else {\n614\t            *bx_ptr\n615\t        };\n616\t\n617\t        let mut pA = c2Proxy::default();\n618\t        let mut pB = c2Proxy::default();\n619\t        c2MakeProxy(A, typeA, &mut pA);\n620\t        c2MakeProxy(B, typeB, &mut pB);\n621\t\n622\t        let mut s = c2Simplex::default();\n623\t        let mut cache_was_read = 0;\n624\t        if !cache.is_null() {\n625\t            let cache_was_good = (*cache).count != 0;\n626\t            if cache_was_good {\n627\t                let n = (*cache).count;\n628\t                // `n` is at most 3 for any cache produced by this library;\n629\t                // the bound keeps the index arithmetic in range.\n630\t                let bound = if n > 3 { 3 } else { n };\n631\t                let mut i: c_int = 0;\n632\t                while i < bound {\n633\t                    let idx = i as usize;\n634\t                    let iA = (*cache).iA[idx];\n635\t                    let iB = (*cache).iB[idx];\n636\t                    let sA = c2Mulxv(ax, pA.verts[iA as usize]);\n637\t                    let sB = c2Mulxv(bx, pB.verts[iB as usize]);\n638\t                    let vtx = &mut s.verts[idx];\n639\t                    vtx.iA = iA;\n640\t                    vtx.sA = sA;\n641\t                    vtx.iB = iB;\n642\t                    vtx.sB = sB;\n643\t                    vtx.p = c2Sub(vtx.sB, vtx.sA);\n644\t                    vtx.u = 0.0;\n645\t                    i += 1;\n646\t                }\n647\t                s.count = (*cache).count;\n648\t                s.div = (*cache).div;\n649\t                let metric_old = (*cache).metric;\n650\t                let metric = gjk_simplex_metric(&s);\n651\t                let min_metric = if metric < metric_old {\n652\t                    metric\n653\t                } else {\n654\t                    metric_old\n655\t                };\n656\t                let max_metric = if metric > metric_old {\n657\t                    metric\n658\t                } else {\n659\t                    metric_old\n660\t                };\n661\t                if !(min_metric < max_metric * 2.0f32 && metric < -1.0e8f32) {\n662\t                    cache_was_read = 1;\n663\t                }\n664\t            }\n665\t        }\n666\t\n667\t        if cache_was_read == 0 {\n668\t            s.verts[0].iA = 0;\n669\t            s.verts[0].iB = 0;\n670\t            s.verts[0].sA = c2Mulxv(ax, pA.verts[0]);\n671\t            s.verts[0].sB = c2Mulxv(bx, pB.verts[0]);\n672\t            s.verts[0].p = c2Sub(s.verts[0].sB, s.verts[0].sA);\n673\t            s.verts[0].u = 1.0f32;\n674\t            s.div = 1.0f32;\n675\t            s.count = 1;\n676\t        }\n677\t\n678\t        let mut saveA: [c_int; 4] = [0; 4];\n679\t        let mut saveB: [c_int; 4] = [0; 4];\n680\t        let mut save_count: c_int;\n681\t        let mut d0: f32 = C2_FLT_MAX;\n682\t        let mut d1: f32;\n683\t        let mut iter: c_int = 0;\n684\t        let mut hit: c_int = 0;\n685\t        while iter < 20 {\n686\t            save_count = s.count;\n687\t            let sc = if save_count > 4 { 4 } else { save_count };\n688\t            let mut i: c_int = 0;\n689\t            while i < sc {\n690\t                saveA[i as usize] = s.verts[i as usize].iA;\n691\t                saveB[i as usize] = s.verts[i as usize].iB;\n692\t                i += 1;\n693\t            }\n694\t\n695\t            match s.count {\n696\t                1 => {}\n697\t                2 => simplex2(&mut s),\n698\t                3 => simplex3(&mut s),\n699\t                _ => {}\n700\t            }\n701\t\n702\t            if s.count == 3 {\n703\t                hit = 1;\n704\t                break;\n705\t            }\n706\t\n707\t            let p = lerp_point(&s);\n708\t            d1 = c2Dot(p, p);\n709\t            if d1 > d0 {\n710\t                break;\n711\t            }\n712\t            d0 = d1;\n713\t\n714\t            let d = direction(&s);\n715\t            if c2Dot(d, d) < C2_EPSILON * C2_EPSILON {\n716\t                break;\n717\t            }\n718\t\n719\t            let iA = c2Support(pA.verts.as_ptr(), pA.count, c2MulrvT(ax.r, c2Neg(d)));\n720\t            let sA = c2Mulxv(ax, pA.verts[iA as usize]);\n721\t            let iB = c2Support(pB.verts.as_ptr(), pB.count, c2MulrvT(bx.r, d));\n722\t            let sB = c2Mulxv(bx, pB.verts[iB as usize]);\n723\t            {\n724\t                let vtx = &mut s.verts[s.count as usize];\n725\t                vtx.iA = iA;\n726\t                vtx.sA = sA;\n727\t                vtx.iB = iB;\n728\t                vtx.sB = sB;\n729\t                vtx.p = c2Sub(vtx.sB, vtx.sA);\n730\t            }\n731\t\n732\t            let mut dup = 0;\n733\t            let mut i: c_int = 0;\n734\t            while i < sc {\n735\t                if iA == saveA[i as usize] && iB == saveB[i as usize] {\n736\t                    dup = 1;\n737\t                    break;\n738\t                }\n739\t                i += 1;\n740\t            }\n741\t            if dup != 0 {\n742\t                break;\n743\t            }\n744\t\n745\t            s.count += 1;\n746\t            iter += 1;\n747\t        }\n748\t\n749\t        let (mut a, mut b) = witness(&s);\n750\t        let mut dist = c2Len(c2Sub(a, b));\n751\t        if hit != 0 {\n752\t            a = b;\n753\t            dist = 0.0;\n754\t        } else if use_radius != 0 {\n755\t            let rA = pA.radius;\n756\t            let rB = pB.radius;\n757\t            if dist > rA + rB && dist > C2_EPSILON {\n758\t                dist -= rA + rB;\n759\t                let n = c2Norm(c2Sub(b, a));\n760\t                a = c2Add(a, c2Mulvs(n, rA));\n761\t                b = c2Sub(b, c2Mulvs(n, rB));\n762\t                if a.x == b.x && a.y == b.y {\n763\t                    dist = 0.0;\n764\t                }\n765\t            } else {\n766\t                let p = c2Mulvs(c2Add(a, b), 0.5f32);\n767\t                a = p;\n768\t                b = p;\n769\t                dist = 0.0;\n770\t            }\n771\t        }\n772\t\n773\t        if !cache.is_null() {\n774\t            (*cache).metric = gjk_simplex_metric(&s);\n775\t            (*cache).count = s.count;\n776\t            let n = if s.count > 3 { 3 } else { s.count };\n777\t            let mut i: c_int = 0;\n778\t            while i < n {\n779\t                let idx = i as usize;\n780\t                (*cache).iA[idx] = s.verts[idx].iA;\n781\t                (*cache).iB[idx] = s.verts[idx].iB;\n782\t                i += 1;\n783\t            }\n784\t            (*cache).div = s.div;\n785\t        }\n786\t        if !outA.is_null() {\n787\t            *outA = a;\n788\t        }\n789\t        if !outB.is_null() {\n790\t            *outB = b;\n791\t        }\n792\t        if !iterations.is_null() {\n793\t            *iterations = iter;\n794\t        }\n795\t        dist\n796\t    }\n797\t}\n798\t\n799\t// ---------------------------------------------------------------------------\n800\t// Boolean shape tests\n801\t// ---------------------------------------------------------------------------\n802\t\n803\t#[unsafe(no_mangle)]\n804\tpub extern \"C\" fn c2AABBtoAABB(A: c2AABB, B: c2AABB) -> c_int {\n805\t    let d0: c_int = (B.max.x < A.min.x) as c_int;\n806\t    let d1: c_int = (A.max.x < B.min.x) as c_int;\n807\t    let d2: c_int = (B.max.y < A.min.y) as c_int;\n808\t    let d3: c_int = (A.max.y < B.min.y) as c_int;\n809\t    ((d0 | d1 | d2 | d3) == 0) as c_int\n810\t}\n811\t\n812\t#[unsafe(no_mangle)]\n813\tpub extern \"C\" fn c2AABBtoCapsule(A: c2AABB, B: c2Capsule) -> c_int {\n814\t    unsafe {\n815\t        if c2GJK(\n816\t            &A as *const c2AABB as *const c_void,\n817\t            C2_TYPE_AABB,\n818\t            std::ptr::null(),\n819\t            &B as *const c2Capsule as *const c_void,\n820\t            C2_TYPE_CAPSULE,\n821\t            std::ptr::null(),\n822\t            std::ptr::null_mut(),\n823\t            std::ptr::null_mut(),\n824\t            1,\n825\t            std::ptr::null_mut(),\n826\t            std::ptr::null_mut(),\n827\t        ) != 0.0\n828\t        {\n829\t            return 0;\n830\t        }\n831\t    }\n832\t    1\n833\t}\n834\t\n835\t#[unsafe(no_mangle)]\n836\tpub extern \"C\" fn c2CapsuletoCapsule(A: c2Capsule, B: c2Capsule) -> c_int {\n837\t    unsafe {\n838\t        if c2GJK(\n839\t            &A as *const c2Capsule as *const c_void,\n840\t            C2_TYPE_CAPSULE,\n841\t            std::ptr::null(),\n842\t            &B as *const c2Capsule as *const c_void,\n843\t            C2_TYPE_CAPSULE,\n844\t            std::ptr::null(),\n845\t            std::ptr::null_mut(),\n846\t            std::ptr::null_mut(),\n847\t            1,\n848\t            std::ptr::null_mut(),\n849\t            std::ptr::null_mut(),\n850\t        ) != 0.0\n851\t        {\n852\t            return 0;\n853\t        }\n854\t    }\n855\t    1\n856\t}\n857\t\n858\t#[unsafe(no_mangle)]\n859\tpub extern \"C\" fn c2CircletoCircle(A: c2Circle, B: c2Circle) -> c_int {\n860\t    let c = c2Sub(B.p, A.p);\n861\t    let d2 = c2Dot(c, c);\n862\t    let mut r2 = A.r + B.r;\n863\t    r2 = r2 * r2;\n864\t    (d2 < r2) as c_int\n865\t}\n866\t\n867\t#[unsafe(no_mangle)]\n868\tpub extern \"C\" fn c2CircletoAABB(A: c2Circle, B: c2AABB) -> c_int {\n869\t    let L = c2Clampv(A.p, B.min, B.max);\n870\t    let ab = c2Sub(A.p, L);\n871\t    let d2 = c2Dot(ab, ab);\n872\t    let r2 = A.r * A.r;\n873\t    (d2 < r2) as c_int\n874\t}\n875\t\n876\t#[unsafe(no_mangle)]\n877\tpub extern \"C\" fn c2CircletoCapsule(A: c2Circle, B: c2Capsule) -> c_int {\n878\t    let n = c2Sub(B.b, B.a);\n879\t    let ap = c2Sub(A.p, B.a);\n880\t    let da = c2Dot(ap, n);\n881\t    let d2;\n882\t    if da < 0.0 {\n883\t        d2 = c2Dot(ap, ap);\n884\t    } else {\n885\t        let db = c2Dot(c2Sub(A.p, B.b), n);\n886\t        if db < 0.0 {\n887\t            let e = c2Sub(ap, c2Mulvs(n, da / c2Dot(n, n)));\n888\t            d2 = c2Dot(e, e);\n889\t        } else {\n890\t            let bp = c2Sub(A.p, B.b);\n891\t            d2 = c2Dot(bp, bp);\n892\t        }\n893\t    }\n894\t    let r = A.r + B.r;\n895\t    (d2 < r * r) as c_int\n896\t}\n897\t\n898\t#[unsafe(no_mangle)]\n899\tpub unsafe extern \"C\" fn c2Collided(\n900\t    A: *const c_void,\n901\t    typeA: c_int,\n902\t    B: *const c_void,\n903\t    typeB: c_int,\n904\t) -> c_int {\n905\t    unsafe {\n906\t        match typeA {\n907\t            C2_TYPE_CIRCLE => match typeB {\n908\t                C2_TYPE_CIRCLE => c2CircletoCircle(*(A as *const c2Circle), *(B as *const c2Circle)),\n909\t                C2_TYPE_AABB => c2CircletoAABB(*(A as *const c2Circle), *(B as *const c2AABB)),\n910\t                C2_TYPE_CAPSULE => {\n911\t                    c2CircletoCapsule(*(A as *const c2Circle), *(B as *const c2Capsule))\n912\t                }\n913\t                _ => 0,\n914\t            },\n915\t            C2_TYPE_AABB => match typeB {\n916\t                C2_TYPE_CIRCLE => c2CircletoAABB(*(B as *const c2Circle), *(A as *const c2AABB)),\n917\t                C2_TYPE_AABB => c2AABBtoAABB(*(A as *const c2AABB), *(B as *const c2AABB)),\n918\t                C2_TYPE_CAPSULE => c2AABBtoCapsule(*(A as *const c2AABB), *(B as *const c2Capsule)),\n919\t                _ => 0,\n920\t            },\n921\t            C2_TYPE_CAPSULE => match typeB {\n922\t                C2_TYPE_CIRCLE => {\n923\t                    c2CircletoCapsule(*(B as *const c2Circle), *(A as *const c2Capsule))\n924\t                }\n925\t                C2_TYPE_AABB => c2AABBtoCapsule(*(B as *const c2AABB), *(A as *const c2Capsule)),\n926\t                C2_TYPE_CAPSULE => {\n927\t                    c2CapsuletoCapsule(*(A as *const c2Capsule), *(B as *const c2Capsule))\n928\t                }\n929\t                _ => 0,\n930\t            },\n931\t            _ => 0,\n932\t        }\n933\t    }\n934\t}\n935\t\n936\t// ---------------------------------------------------------------------------\n937\t// Public entry point declared in include/lib.h\n938\t// ---------------------------------------------------------------------------\n939\t\n940\t#[unsafe(no_mangle)]\n941\tpub extern \"C\" fn aabb(min_x: f32, min_y: f32, max_x: f32, max_y: f32) -> c_int {\n942\t    let mut result: c_int = 0;\n943\t\n944\t    let mut aabb_in = c2AABB::default();\n945\t    aabb_in.min = c2V(min_x, min_y);\n946\t    aabb_in.max = c2V(max_x, max_y);\n947\t\n948\t    let mut circle = c2Circle::default();\n949\t    circle.p = c2V(-70.0f32, 0.0);\n950\t    circle.r = 20.0f32;\n951\t\n952\t    let mut aabb = c2AABB::default();\n953\t    aabb.min = c2V(-40.0f32, -40.0f32);\n954\t    aabb.max = c2V(-15.0f32, -15.0f32);\n955\t\n956\t    let mut capsule = c2Capsule::default();\n957\t    capsule.a = c2V(-40.0f32, 40.0f32);\n958\t    capsule.b = c2V(-20.0f32, 100.0f32);\n959\t    capsule.r = 10.0f32;\n960\t\n961\t    unsafe {\n962\t        result += c2Collided(\n963\t            &circle as *const c2Circle as *const c_void,\n964\t            C2_TYPE_CIRCLE,\n965\t            &aabb_in as *const c2AABB as *const c_void,\n966\t            C2_TYPE_AABB,\n967\t        );\n968\t\n969\t        result += c2Collided(\n970\t            &aabb as *co