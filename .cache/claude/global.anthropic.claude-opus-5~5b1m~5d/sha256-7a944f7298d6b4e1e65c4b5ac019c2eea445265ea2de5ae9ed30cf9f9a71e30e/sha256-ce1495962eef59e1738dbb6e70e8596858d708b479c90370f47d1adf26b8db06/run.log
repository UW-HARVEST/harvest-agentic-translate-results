 f8          \tmov    -0x8(%rbp),%rax\n    1740:\t66 48 0f 6e ca       \tmovq   %rdx,%xmm1\n    1745:\t66 48 0f 6e c0       \tmovq   %rax,%xmm0\n    174a:\te8 f1 f9 ff ff       \tcall   1140 <c2Dot@plt>\n    174f:\t66 0f 7e c0          \tmovd   %xmm0,%eax\n    1753:\t66 0f 6e c0          \tmovd   %eax,%xmm0\n    1757:\te8 34 fa ff ff       \tcall   1190 <sqrtf@plt>\n    175c:\tc9                   \tleave\n    175d:\tc3                   \tret\n\nDisassembly of section .fini:","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
