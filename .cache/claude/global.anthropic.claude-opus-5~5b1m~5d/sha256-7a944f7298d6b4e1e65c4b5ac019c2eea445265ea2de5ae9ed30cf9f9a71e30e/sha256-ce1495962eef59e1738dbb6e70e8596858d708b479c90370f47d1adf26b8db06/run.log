{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_0174pjMBUPA5wPb1bBZtuvpS","type":"tool_result","content":"1\t//! Rust translation of `c_src/src/lib.c` (a cute_c2 / tinyc2 derived 2D\n2\t//! collision library).\n3\t//!\n4\t//! Every non-`static` function of the C translation unit has external linkage\n5\t//! and is therefore exported by the C shared object; every one of them is\n6\t//! re-exported here with the exact same linker name, signature and\n7\t//! (bit-for-bit) behaviour.\n8\t//!\n9\t//! # Fidelity notes\n10\t//!\n11\t//! * All arithmetic is `f32` and is performed in exactly the same order as the\n12\t//!   C source.\n13\t//! * The C library is built by `c_src/CMakeLists.txt` without any\n14\t//!   `CMAKE_BUILD_TYPE`, i.e. at `-O0`, so gcc emits one scalar SSE instruction\n15\t//!   per source-level operation with no reassociation and no FMA contraction.\n16\t//!   Consequently the *only* place where a naive Rust transcription can differ\n17\t//!   is NaN payload/sign propagation, which on x86 SSE is\n18\t//!   **destination-operand-wins** (see [`ssf`]). The operand that ends up in\n19\t//!   the destination register is not always the left-hand side of the C\n20\t//!   expression (gcc `-O0` picks it from its evaluation order), so each\n21\t//!   operation below records the order taken from\n22\t//!   `objdump -d` of the reference `.so`.\n23\t//! * Quirks / bugs of the original are preserved verbatim: the nonsensical\n24\t//!   `metric < -1.0e8f` cache-validation conjunct, the missing `default:` in\n25\t//!   `c2MakeProxy`, the argument swapping in `c2Collided`, `c2L`'s `case 3`\n26\t//!   falling into `default:`, `c2Support`'s unconditional `verts[0]` read, and\n27\t//!   `c2GJKSimplexMetric`'s `default:` falling through into `case 1:`.\n28\t\n29\t#![allow(non_snake_case)]\n30\t#![allow(non_camel_case_types)]\n31\t#![allow(non_upper_case_globals)]\n32\t\n33\tuse std::ffi::{c_int, c_void};\n34\t\n35\t// ---------------------------------------------------------------------------\n36\t// Constants used by the original source (spelled out there as literals).\n37\t// ---------------------------------------------------------------------------\n38\t\n39\t/// `3.40282346638528859811704183484516925e+38F` (FLT_MAX), `.rodata` 0x7f7fffff\n40\tconst C2_FLT_MAX: f32 = 3.402_823_466_385_288_598_117_041_834_845_169_25e+38;\n41\t/// `1.19209289550781250000000000000000000e-7F` (FLT_EPSILON), `.rodata` 0x34000000\n42\tconst C2_EPSILON: f32 = 1.192_092_895_507_812_5e-7;\n43\t/// gcc constant-folds `FLT_EPSILON * FLT_EPSILON` to `.rodata` 0x28800000.\n44\tconst C2_EPSILON_SQ: f32 = f32::from_bits(0x2880_0000);\n45\t\n46\t// ---------------------------------------------------------------------------\n47\t// x86 SSE scalar-arithmetic emulation (NaN propagation fidelity)\n48\t// ---------------------------------------------------------------------------\n49\t//\n50\t// For `ADDSS/SUBSS/MULSS/DIVSS xmm_dst, xmm_src`:\n51\t//   * if `dst` is a NaN, the result is `dst` with the quiet bit forced on;\n52\t//   * else if `src` is a NaN, the result is `src` with the quiet bit forced on;\n53\t//   * otherwise the IEEE-754 result (which for an invalid operation such as\n54\t//     `inf - inf`, `0 * inf` or `0 / 0` is the \"real indefinite\" QNaN\n55\t//     `0xffc00000`).\n56\t//\n57\t// Rust's `a op b` lowers to the same instruction but LLVM is free to choose\n58\t// which side lands in the destination register, so the NaN winner is not\n59\t// stable. Making the rule explicit removes that dependency on codegen while\n60\t// leaving the numeric result untouched for every non-NaN input.\n61\t\n62\t/// Force the quiet bit of a NaN on (identity for a QNaN, quietens an SNaN),\n63\t/// preserving sign and payload — exactly what SSE does.\n64\t#[inline(always)]\n65\tfn quiet(x: f32) -> f32 {\n66\t    f32::from_bits(x.to_bits() | 0x0040_0000)\n67\t}\n68\t\n69\t/// Which operand's NaN an SSE arithmetic instruction returns, if any.\n70\t#[inline(always)]\n71\tfn ssf(dst: f32, src: f32) -> Option<f32> {\n72\t    if dst.is_nan() {\n73\t        Some(quiet(dst))\n74\t    } else if src.is_nan() {\n75\t        Some(quiet(src))\n76\t    } else {\n77\t        None\n78\t    }\n79\t}\n80\t\n81\t/// `ADDSS dst, src`\n82\t#[inline(always)]\n83\tfn addss(dst: f32, src: f32) -> f32 {\n84\t    match ssf(dst, src) {\n85\t        Some(v) => v,\n86\t        None => dst + src,\n87\t    }\n88\t}\n89\t\n90\t/// `SUBSS dst, src`\n91\t#[inline(always)]\n92\tfn subss(dst: f32, src: f32) -> f32 {\n93\t    match ssf(dst, src) {\n94\t        Some(v) => v,\n95\t        None => dst - src,\n96\t    }\n97\t}\n98\t\n99\t/// `MULSS dst, src`\n100\t#[inline(always)]\n101\tfn mulss(dst: f32, src: f32) -> f32 {\n102\t    match ssf(dst, src) {\n103\t        Some(v) => v,\n104\t        None => dst * src,\n105\t    }\n106\t}\n107\t\n108\t/// `DIVSS dst, src`\n109\t#[inline(always)]\n110\tfn divss(dst: f32, src: f32) -> f32 {\n111\t    match ssf(dst, src) {\n112\t        Some(v) => v,\n113\t        None => dst / src,\n114\t    }\n115\t}\n116\t\n117\t/// `XORPS x, signmask` — gcc materialises C's unary `-` on a float as a plain\n118\t/// sign-bit flip, which (unlike an arithmetic negation) never quietens an SNaN.\n119\t#[inline(always)]\n120\tfn fneg(x: f32) -> f32 {\n121\t    f32::from_bits(x.to_bits() ^ 0x8000_0000)\n122\t}\n123\t\n124\t/// `SQRTSS` — the C calls `sqrtf` from libm, which on x86-64 is `sqrtss`.\n125\t#[inline(always)]\n126\tfn sqrtss(x: f32) -> f32 {\n127\t    x.sqrt()\n128\t}\n129\t\n130\t// ---------------------------------------------------------------------------\n131\t// C2_TYPE\n132\t// ---------------------------------------------------------------------------\n133\t\n134\tpub const C2_TYPE_CIRCLE: c_int = 0;\n135\tpub const C2_TYPE_AABB: c_int = 1;\n136\tpub const C2_TYPE_CAPSULE: c_int = 2;\n137\t\n138\t// ---------------------------------------------------------------------------\n139\t// Public POD types\n140\t// ---------------------------------------------------------------------------\n141\t\n142\t#[repr(C)]\n143\t#[derive(Clone, Copy, Debug, Default)]\n144\tpub struct c2v {\n145\t    pub x: f32,\n146\t    pub y: f32,\n147\t}\n148\t\n149\t#[repr(C)]\n150\t#[derive(Clone, Copy, Debug, Default)]\n151\tpub struct c2r {\n152\t    pub c: f32,\n153\t    pub s: f32,\n154\t}\n155\t\n156\t#[repr(C)]\n157\t#[derive(Clone, Copy, Debug, Default)]\n158\tpub struct c2x {\n159\t    pub p: c2v,\n160\t    pub r: c2r,\n161\t}\n162\t\n163\t#[repr(C)]\n164\t#[derive(Clone, Copy, Debug, Default)]\n165\tpub struct c2Circle {\n166\t    pub p: c2v,\n167\t    pub r: f32,\n168\t}\n169\t\n170\t#[repr(C)]\n171\t#[derive(Clone, Copy, Debug, Default)]\n172\tpub struct c2AABB {\n173\t    pub min: c2v,\n174\t    pub max: c2v,\n175\t}\n176\t\n177\t#[repr(C)]\n178\t#[derive(Clone, Copy, Debug, Default)]\n179\tpub struct c2Capsule {\n180\t    pub a: c2v,\n181\t    pub b: c2v,\n182\t    pub r: f32,\n183\t}\n184\t\n185\t#[repr(C)]\n186\t#[derive(Clone, Copy, Debug, Default)]\n187\tpub struct c2GJKCache {\n188\t    pub metric: f32,\n189\t    pub count: c_int,\n190\t    pub iA: [c_int; 3],\n191\t    pub iB: [c_int; 3],\n192\t    pub div: f32,\n193\t}\n194\t\n195\t/// ```c\n196\t/// typedef struct { float radius; int count; c2v verts[8]; } c2Proxy;\n197\t/// ```\n198\t#[repr(C)]\n199\t#[derive(Clone, Copy, Debug)]\n200\tpub struct c2Proxy {\n201\t    pub radius: f32,\n202\t    pub count: c_int,\n203\t    pub verts: [c2v; 8],\n204\t}\n205\t\n206\timpl Default for c2Proxy {\n207\t    fn default() -> Self {\n208\t        c2Proxy {\n209\t            radius: 0.0,\n210\t            count: 0,\n211\t            verts: [c2v::default(); 8],\n212\t        }\n213\t    }\n214\t}\n215\t\n216\t/// ```c\n217\t/// typedef struct { c2v sA; c2v sB; c2v p; float u; int iA; int iB; } c2sv;\n218\t/// ```\n219\t#[repr(C)]\n220\t#[derive(Clone, Copy, Debug, Default)]\n221\tpub struct c2sv {\n222\t    pub sA: c2v,\n223\t    pub sB: c2v,\n224\t    pub p: c2v,\n225\t    pub u: f32,\n226\t    pub iA: c_int,\n227\t    pub iB: c_int,\n228\t}\n229\t\n230\t/// ```c\n231\t/// typedef struct { c2sv a, b, c, d; float div; int count; } c2Simplex;\n232\t/// ```\n233\t///\n234\t/// The four `c2sv` members are stored as a fixed size array: a `#[repr(C)]`\n235\t/// struct with four consecutive members of the same type has exactly the same\n236\t/// layout as `[c2sv; 4]`, and the C code itself relies on that by walking\n237\t/// `c2sv *verts = &s->a;` as an array.\n238\t#[repr(C)]\n239\t#[derive(Clone, Copy, Debug, Default)]\n240\tpub struct c2Simplex {\n241\t    pub verts: [c2sv; 4],\n242\t    pub div: f32,\n243\t    pub count: c_int,\n244\t}\n245\t\n246\t// ---------------------------------------------------------------------------\n247\t// Layout assertions - these mirror what the C compiler reports for the same\n248\t// declarations (verified with sizeof/_Alignof/offsetof against c_src).\n249\t// ---------------------------------------------------------------------------\n250\t\n251\tconst _: () = {\n252\t    use std::mem::{align_of, offset_of, size_of};\n253\t    assert!(size_of::<c2v>() == 8 && align_of::<c2v>() == 4);\n254\t    assert!(size_of::<c2r>() == 8 && align_of::<c2r>() == 4);\n255\t    assert!(size_of::<c2x>() == 16 && align_of::<c2x>() == 4);\n256\t    assert!(size_of::<c2Circle>() == 12 && align_of::<c2Circle>() == 4);\n257\t    assert!(size_of::<c2AABB>() == 16 && align_of::<c2AABB>() == 4);\n258\t    assert!(size_of::<c2Capsule>() == 20 && align_of::<c2Capsule>() == 4);\n259\t\n260\t    assert!(size_of::<c2GJKCache>() == 36 && align_of::<c2GJKCache>() == 4);\n261\t    assert!(offset_of!(c2GJKCache, metric) == 0);\n262\t    assert!(offset_of!(c2GJKCache, count) == 4);\n263\t    assert!(offset_of!(c2GJKCache, iA) == 8);\n264\t    assert!(offset_of!(c2GJKCache, iB) == 20);\n265\t    assert!(offset_of!(c2GJKCache, div) == 32);\n266\t\n267\t    assert!(size_of::<c2Proxy>() == 72 && align_of::<c2Proxy>() == 4);\n268\t    assert!(offset_of!(c2Proxy, radius) == 0);\n269\t    assert!(offset_of!(c2Proxy, count) == 4);\n270\t    assert!(offset_of!(c2Proxy, verts) == 8);\n271\t\n272\t    assert!(size_of::<c2sv>() == 36 && align_of::<c2sv>() == 4);\n273\t    assert!(offset_of!(c2sv, sA) == 0);\n274\t    assert!(offset_of!(c2sv, sB) == 8);\n275\t    assert!(offset_of!(c2sv, p) == 16);\n276\t    assert!(offset_of!(c2sv, u) == 24);\n277\t    assert!(offset_of!(c2sv, iA) == 28);\n278\t    assert!(offset_of!(c2sv, iB) == 32);\n279\t\n280\t    // `verts[0..4]` must land exactly on the C members `a`, `b`, `c`, `d`.\n281\t    assert!(size_of::<c2Simplex>() == 152 && align_of::<c2Simplex>() == 4);\n282\t    assert!(offset_of!(c2Simplex, verts) == 0);\n283\t    assert!(offset_of!(c2Simplex, div) == 144);\n284\t    assert!(offset_of!(c2Simplex, count) == 148);\n285\t};\n286\t\n287\t// ---------------------------------------------------------------------------\n288\t// Small vector helpers (each one is also a public C symbol)\n289\t// ---------------------------------------------------------------------------\n290\t\n291\t#[unsafe(no_mangle)]\n292\tpub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n293\t    let mut a = c2v { x: 0.0, y: 0.0 };\n294\t    a.x = x;\n295\t    a.y = y;\n296\t    a\n297\t}\n298\t\n299\t/// ```c\n300\t/// a.x *= b; a.y *= b;\n301\t/// ```\n302\t/// gcc: `mulss` with the *vector component* in the destination.\n303\t#[unsafe(no_mangle)]\n304\tpub extern \"C\" fn c2Mulvs(mut a: c2v, b: f32) -> c2v {\n305\t    a.x = mulss(a.x, b);\n306\t    a.y = mulss(a.y, b);\n307\t    a\n308\t}\n309\t\n310\t#[unsafe(no_mangle)]\n311\tpub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n312\t    c2V(\n313\t        if a.x > b.x { a.x } else { b.x },\n314\t        if a.y > b.y { a.y } else { b.y },\n315\t    )\n316\t}\n317\t\n318\t#[unsafe(no_mangle)]\n319\tpub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n320\t    c2V(\n321\t        if a.x < b.x { a.x } else { b.x },\n322\t        if a.y < b.y { a.y } else { b.y },\n323\t    )\n324\t}\n325\t\n326\t#[unsafe(no_mangle)]\n327\tpub extern \"C\" fn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n328\t    c2Maxv(lo, c2Minv(a, hi))\n329\t}\n330\t\n331\t/// ```c\n332\t/// a.x -= b.x; a.y -= b.y;\n333\t/// ```\n334\t/// gcc: `subss` with `a`'s component in the destination.\n335\t#[unsafe(no_mangle)]\n336\tpub extern \"C\" fn c2Sub(mut a: c2v, b: c2v) -> c2v {\n337\t    a.x = subss(a.x, b.x);\n338\t    a.y = subss(a.y, b.y);\n339\t    a\n340\t}\n341\t\n342\t/// ```c\n343\t/// return a.x * b.x + a.y * b.y;\n344\t/// ```\n345\t/// gcc `-O0`:\n346\t/// ```text\n347\t/// mulss %xmm0,%xmm1   ; xmm1 = a.x (dst) * b.x\n348\t/// mulss %xmm2,%xmm0   ; xmm0 = b.y (dst) * a.y\n349\t/// addss %xmm1,%xmm0   ; xmm0 = (a.y*b.y) (dst) + (a.x*b.x)\n350\t/// ```\n351\t#[unsafe(no_mangle)]\n352\tpub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n353\t    let t_x = mulss(a.x, b.x);\n354\t    let t_y = mulss(b.y, a.y);\n355\t    addss(t_y, t_x)\n356\t}\n357\t\n358\t#[unsafe(no_mangle)]\n359\tpub extern \"C\" fn c2RotIdentity() -> c2r {\n360\t    let mut r = c2r { c: 0.0, s: 0.0 };\n361\t    r.c = 1.0f32;\n362\t    r.s = 0.0;\n363\t    r\n364\t}\n365\t\n366\t#[unsafe(no_mangle)]\n367\tpub extern \"C\" fn c2xIdentity() -> c2x {\n368\t    let mut x = c2x {\n369\t        p: c2v { x: 0.0, y: 0.0 },\n370\t        r: c2r { c: 0.0, s: 0.0 },\n371\t    };\n372\t    x.p = c2V(0.0, 0.0);\n373\t    x.r = c2RotIdentity();\n374\t    x\n375\t}\n376\t\n377\t/// `sqrtf(c2Dot(a, a))`\n378\t#[unsafe(no_mangle)]\n379\tpub extern \"C\" fn c2Len(a: c2v) -> f32 {\n380\t    sqrtss(c2Dot(a, a))\n381\t}\n382\t\n383\t/// ```c\n384\t/// return a.x * b.y - a.y * b.x;\n385\t/// ```\n386\t/// gcc `-O0`:\n387\t/// ```text\n388\t/// mulss %xmm1,%xmm0   ; xmm0 = b.y (dst) * a.x\n389\t/// mulss %xmm2,%xmm1   ; xmm1 = b.x (dst) * a.y\n390\t/// subss %xmm1,%xmm0   ; xmm0 = (a.x*b.y) (dst) - (a.y*b.x)\n391\t/// ```\n392\t#[unsafe(no_mangle)]\n393\tpub extern \"C\" fn c2Det2(a: c2v, b: c2v) -> f32 {\n394\t    let t0 = mulss(b.y, a.x);\n395\t    let t1 = mulss(b.x, a.y);\n396\t    subss(t0, t1)\n397\t}\n398\t\n399\t/// ```c\n400\t/// return c2V(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y);\n401\t/// ```\n402\t/// gcc `-O0` (arguments evaluated right-to-left):\n403\t/// ```text\n404\t/// ; second argument\n405\t/// mulss %xmm0,%xmm1   ; xmm1 = a.s (dst) * b.x\n406\t/// mulss %xmm2,%xmm0   ; xmm0 = b.y (dst) * a.c\n407\t/// addss %xmm0,%xmm3   ; xmm3 = (a.s*b.x) (dst) + (a.c*b.y)\n408\t/// ; first argument\n409\t/// mulss %xmm1,%xmm0   ; xmm0 = b.x (dst) * a.c\n410\t/// mulss %xmm2,%xmm1   ; xmm1 = b.y (dst) * a.s\n411\t/// subss %xmm1,%xmm0   ; xmm0 = (a.c*b.x) (dst) - (a.s*b.y)\n412\t/// ```\n413\t#[unsafe(no_mangle)]\n414\tpub extern \"C\" fn c2Mulrv(a: c2r, b: c2v) -> c2v {\n415\t    let y = addss(mulss(a.s, b.x), mulss(b.y, a.c));\n416\t    let x = subss(mulss(b.x, a.c), mulss(b.y, a.s));\n417\t    c2V(x, y)\n418\t}\n419\t\n420\t/// ```c\n421\t/// a.x += b.x; a.y += b.y;\n422\t/// ```\n423\t/// gcc `-O0` puts **`b`'s** component in the destination:\n424\t/// ```text\n425\t/// addss %xmm1,%xmm0   ; xmm0 = b.x (dst) + a.x\n426\t/// ```\n427\t#[unsafe(no_mangle)]\n428\tpub extern \"C\" fn c2Add(mut a: c2v, b: c2v) -> c2v {\n429\t    a.x = addss(b.x, a.x);\n430\t    a.y = addss(b.y, a.y);\n431\t    a\n432\t}\n433\t\n434\t#[unsafe(no_mangle)]\n435\tpub extern \"C\" fn c2Mulxv(a: c2x, b: c2v) -> c2v {\n436\t    c2Add(c2Mulrv(a.r, b), a.p)\n437\t}\n438\t\n439\t#[unsafe(no_mangle)]\n440\tpub extern \"C\" fn c2Neg(a: c2v) -> c2v {\n441\t    c2V(fneg(a.x), fneg(a.y))\n442\t}\n443\t\n444\t#[unsafe(no_mangle)]\n445\tpub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n446\t    let mut b = c2v { x: 0.0, y: 0.0 };\n447\t    b.x = fneg(a.y);\n448\t    b.y = a.x;\n449\t    b\n450\t}\n451\t\n452\t#[unsafe(no_mangle)]\n453\tpub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n454\t    let mut b = c2v { x: 0.0, y: 0.0 };\n455\t    b.x = a.y;\n456\t    b.y = fneg(a.x);\n457\t    b\n458\t}\n459\t\n460\t/// ```c\n461\t/// return c2Mulvs(a, 1.0f / b);\n462\t/// ```\n463\t/// gcc: `divss` with the literal `1.0f` in the destination.\n464\t#[unsafe(no_mangle)]\n465\tpub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n466\t    c2Mulvs(a, divss(1.0f32, b))\n467\t}\n468\t\n469\t#[unsafe(no_mangle)]\n470\tpub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n471\t    c2Div(a, c2Len(a))\n472\t}\n473\t\n474\t/// ```c\n475\t/// return c2V(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y);\n476\t/// ```\n477\t/// gcc `-O0`:\n478\t/// ```text\n479\t/// ; second argument\n480\t/// xorps %xmm0,%xmm1   ; xmm1 = -a.s (plain sign flip)\n481\t/// mulss %xmm0,%xmm1   ; xmm1 = (-a.s) (dst) * b.x\n482\t/// mulss %xmm2,%xmm0   ; xmm0 = b.y (dst) * a.c\n483\t/// addss %xmm0,%xmm3   ; xmm3 = ((-a.s)*b.x) (dst) + (a.c*b.y)\n484\t/// ; first argument\n485\t/// mulss %xmm0,%xmm1   ; xmm1 = a.c (dst) * b.x\n486\t/// mulss %xmm2,%xmm0   ; xmm0 = b.y (dst) * a.s\n487\t/// addss %xmm0,%xmm1   ; xmm1 = (a.c*b.x) (dst) + (a.s*b.y)\n488\t/// ```\n489\t#[unsafe(no_mangle)]\n490\tpub extern \"C\" fn c2MulrvT(a: c2r, b: c2v) -> c2v {\n491\t    let y = addss(mulss(fneg(a.s), b.x), mulss(b.y, a.c));\n492\t    let x = addss(mulss(a.c, b.x), mulss(b.y, a.s));\n493\t    c2V(x, y)\n494\t}\n495\t\n496\t// ---------------------------------------------------------------------------\n497\t// Proxies\n498\t// ---------------------------------------------------------------------------\n499\t\n500\t#[unsafe(no_mangle)]\n501\tpub unsafe extern \"C\" fn c2BBVerts(out: *mut c2v, bb: *mut c2AABB) {\n502\t    unsafe {\n503\t        let bb = &*bb;\n504\t        *out.add(0) = bb.min;\n505\t        *out.add(1) = c2V(bb.max.x, bb.min.y);\n506\t        *out.add(2) = bb.max;\n507\t        *out.add(3) = c2V(bb.min.x, bb.max.y);\n508\t    }\n509\t}\n510\t\n511\t#[unsafe(no_mangle)]\n512\tpub unsafe extern \"C\" fn c2MakeProxy(shape: *const c_void, type_: c_int, p: *mut c2Proxy) {\n513\t    unsafe {\n514\t        match type_ {\n515\t            C2_TYPE_CIRCLE => {\n516\t                let c = shape as *mut c2Circle;\n517\t                (*p).radius = (*c).r;\n518\t                (*p).count = 1;\n519\t                (*p).verts[0] = (*c).p;\n520\t            }\n521\t            C2_TYPE_AABB => {\n522\t                let bb = shape as *mut c2AABB;\n523\t                (*p).radius = 0.0;\n524\t                (*p).count = 4;\n525\t                c2BBVerts((*p).verts.as_mut_ptr(), bb);\n526\t            }\n527\t            C2_TYPE_CAPSULE => {\n528\t                let c = shape as *mut c2Capsule;\n529\t                (*p).radius = (*c).r;\n530\t                (*p).count = 2;\n531\t                (*p).verts[0] = (*c).a;\n532\t                (*p).verts[1] = (*c).b;\n533\t            }\n534\t            // The C switch has no `default:` label - nothing is written.\n535\t            _ => {}\n536\t        }\n537\t    }\n538\t}\n539\t\n540\t// ---------------------------------------------------------------------------\n541\t// Simplex helpers\n542\t// ---------------------------------------------------------------------------\n543\t\n544\tfn gjk_simplex_metric(s: &c2Simplex) -> f32 {\n545\t    match s.count {\n546\t        // `default:` falls through into `case 1:` in the C source.\n547\t        2 => c2Len(c2Sub(s.verts[1].p, s.verts[0].p)),\n548\t        3 => c2Det2(\n549\t            c2Sub(s.verts[1].p, s.verts[0].p),\n550\t            c2Sub(s.verts[2].p, s.verts[0].p),\n551\t        ),\n552\t        _ => 0.0,\n553\t    }\n554\t}\n555\t\n556\t#[unsafe(no_mangle)]\n557\tpub unsafe extern \"C\" fn c2GJKSimplexMetric(s: *mut c2Simplex) -> f32 {\n558\t    unsafe { gjk_simplex_metric(&*s) }\n559\t}\n560\t\n561\tfn simplex2(s: &mut c2Simplex) {\n562\t    let a = s.verts[0].p;\n563\t    let b = s.verts[1].p;\n564\t    let u = c2Dot(b, c2Sub(b, a));\n565\t    let vv = c2Dot(a, c2Sub(a, b));\n566\t    if vv <= 0.0 {\n567\t        s.verts[0].u = 1.0f32;\n568\t        s.div = 1.0f32;\n569\t        s.count = 1;\n570\t    } else if u <= 0.0 {\n571\t        s.verts[0] = s.verts[1];\n572\t        s.verts[0].u = 1.0f32;\n573\t        s.div = 1.0f32;\n574\t        s.count = 1;\n575\t    } else {\n576\t        s.verts[0].u = u;\n577\t        s.verts[1].u = vv;\n578\t        s.div = addss(u, vv);\n579\t        s.count = 2;\n580\t    }\n581\t}\n582\t\n583\t#[unsafe(no_mangle)]\n584\tpub unsafe extern \"C\" fn c22(s: *mut c2Simplex) {\n585\t    unsafe { simplex2(&mut *s) }\n586\t}\n587\t\n588\tfn simplex3(s: &mut c2Simplex) {\n589\t    let a = s.verts[0].p;\n590\t    let b = s.verts[1].p;\n591\t    let c = s.verts[2].p;\n592\t    let uAB = c2Dot(b, c2Sub(b, a));\n593\t    let vAB = c2Dot(a, c2Sub(a, b));\n594\t    let uBC = c2Dot(c, c2Sub(c, b));\n595\t    let vBC = c2Dot(b, c2Sub(b, c));\n596\t    let uCA = c2Dot(a, c2Sub(a, c));\n597\t    let vCA = c2Dot(c, c2Sub(c, a));\n598\t    let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n599\t    // gcc: `mulss` with the `c2Det2` result in the destination, `area` as src.\n600\t    let uABC = mulss(c2Det2(b, c), area);\n601\t    let vABC = mulss(c2Det2(c, a), area);\n602\t    let wABC = mulss(c2Det2(a, b), area);\n603\t    if vAB <= 0.0 && uCA <= 0.0 {\n604\t        s.verts[0].u = 1.0f32;\n605\t        s.div = 1.0f32;\n606\t        s.count = 1;\n607\t    } else if uAB <= 0.0 && vBC <= 0.0 {\n608\t        s.verts[0] = s.verts[1];\n609\t        s.verts[0].u = 1.0f32;\n610\t        s.div = 1.0f32;\n611\t        s.count = 1;\n612\t    } else if uBC <= 0.0 && vCA <= 0.0 {\n613\t        s.verts[0] = s.verts[2];\n614\t        s.verts[0].u = 1.0f32;\n615\t        s.div = 1.0f32;\n616\t        s.count = 1;\n617\t    } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n618\t        s.verts[0].u = uAB;\n619\t        s.verts[1].u = vAB;\n620\t        s.div = addss(uAB, vAB);\n621\t        s.count = 2;\n622\t    } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n623\t        s.verts[0] = s.verts[1];\n624\t        s.verts[1] = s.verts[2];\n625\t        s.verts[0].u = uBC;\n626\t        s.verts[1].u = vBC;\n627\t        s.div = addss(uBC, vBC);\n628\t        s.count = 2;\n629\t    } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n630\t        s.verts[1] = s.verts[0];\n631\t        s.verts[0] = s.verts[2];\n632\t        s.verts[0].u = uCA;\n633\t        s.verts[1].u = vCA;\n634\t        s.div = addss(uCA, vCA);\n635\t        s.count = 2;\n636\t    } else {\n637\t        s.verts[0].u = uABC;\n638\t        s.verts[1].u = vABC;\n639\t        s.verts[2].u = wABC;\n640\t        s.div = addss(addss(uABC, vABC), wABC);\n641\t        s.count = 3;\n642\t    }\n643\t}\n644\t\n645\t#[unsafe(no_mangle)]\n646\tpub unsafe extern \"C\" fn c23(s: *mut c2Simplex) {\n647\t    unsafe { simplex3(&mut *s) }\n648\t}\n649\t\n650\tfn direction(s: &c2Simplex) -> c2v {\n651\t    match s.count {\n652\t        1 => c2Neg(s.verts[0].p),\n653\t        2 => {\n654\t            let ab = c2Sub(s.verts[1].p, s.verts[0].p);\n655\t            if c2Det2(ab, c2Neg(s.verts[0].p)) > 0.0 {\n656\t                return c2Skew(ab);\n657\t            }\n658\t            c2CCW90(ab)\n659\t        }\n660\t        // `case 3:` and `default:` both give the zero vector.\n661\t        _ => c2V(0.0, 0.0),\n662\t    }\n663\t}\n664\t\n665\t#[unsafe(no_mangle)]\n666\tpub unsafe extern \"C\" fn c2D(s: *mut c2Simplex) -> c2v {\n667\t    unsafe { direction(&*s) }\n668\t}\n669\t\n670\t#[unsafe(no_mangle)]\n671\tpub unsafe extern \"C\" fn c2Support(verts: *const c2v, count: c_int, d: c2v) -> c_int {\n672\t    unsafe {\n673\t        let mut imax: c_int = 0;\n674\t        let mut dmax = c2Dot(*verts.add(0), d);\n675\t        let mut i: c_int = 1;\n676\t        while i < count {\n677\t            let dot = c2Dot(*verts.offset(i as isize), d);\n678\t            if dot > dmax {\n679\t                imax = i;\n680\t                dmax = dot;\n681\t            }\n682\t            i += 1;\n683\t        }\n684\t        imax\n685\t    }\n686\t}\n687\t\n688\t/// gcc emits `den * s->X.u` as `mulss` with **`u`** in the destination.\n689\t#[inline(always)]\n690\tfn wu(u: f32, den: f32) -> f32 {\n691\t    mulss(u, den)\n692\t}\n693\t\n694\t/// `pA.verts[i]` where `i` comes from a caller-supplied `c2GJKCache`.\n695\t///\n696\t/// The C code indexes `c2v verts[8]` with the raw cached index, so anything\n697\t/// outside `[0, 8)` is an out-of-bounds read and anything in\n698\t/// `[proxy.count, 8)` is an *uninitialised* read (see `ERRORS.md` rows U4/U2).\n699\t/// Neither is a value the C source defines, and it is not reproducible, so the\n700\t/// Rust side stays memory-safe: in-range slots read the (zero-initialised)\n701\t/// array exactly like the C reads its slots, and an out-of-range index yields\n702\t/// `(0, 0)` instead of faulting. Every index the library itself ever stores\n703\t/// into a cache is `< proxy.count`, so this is unreachable for any cache that\n704\t/// was produced by `c2GJK`.\n705\t#[inline(always)]\n706\tfn proxy_vert(p: &c2Proxy, i: c_int) -> c2v {\n707\t    if i >= 0 && (i as usize) < p.verts.len() {\n708\t        p.verts[i as usize]\n709\t    } else {\n710\t        c2v { x: 0.0, y: 0.0 }\n711\t    }\n712\t}\n713\t\n714\tfn witness(s: &c2Simplex) -> (c2v, c2v) {\n715\t    let den = divss(1.0f32, s.div);\n716\t    match s.count {\n717\t        1 => (s.verts[0].sA, s.verts[0].sB),\n718\t        2 => (\n719\t            c2Add(\n720\t                c2Mulvs(s.verts[0].sA, wu(s.verts[0].u, den)),\n721\t                c2Mulvs(s.verts[1].sA, wu(s.verts[1].u, den)),\n722\t            ),\n723\t            c2Add(\n724\t                c2Mulvs(s.verts[0].sB, wu(s.verts[0].u, den)),\n725\t                c2Mulvs(s.verts[1].sB, wu(s.verts[1].u, den)),\n726\t            ),\n727\t        ),\n728\t        3 => (\n729\t            c2Add(\n730\t                c2Add(\n731\t                    c2Mulvs(s.verts[0].sA, wu(s.verts[0].u, den)),\n732\t                    c2Mulvs(s.verts[1].sA, wu(s.verts[1].u, den)),\n733\t                ),\n734\t                c2Mulvs(s.verts[2].sA, wu(s.verts[2].u, den)),\n735\t            ),\n736\t            c2Add(\n737\t                c2Add(\n738\t                    c2Mulvs(s.verts[0].sB, wu(s.verts[0].u, den)),\n739\t                    c2Mulvs(s.verts[1].sB, wu(s.verts[1].u, den)),\n740\t                ),\n741\t                c2Mulvs(s.verts[2].sB, wu(s.verts[2].u, den)),\n742\t            ),\n743\t        ),\n744\t        _ => (c2V(0.0, 0.0), c2V(0.0, 0.0)),\n745\t    }\n746\t}\n747\t\n748\t#[unsafe(no_mangle)]\n749\tpub unsafe extern \"C\" fn c2Witness(s: *mut c2Simplex, a: *mut c2v, b: *mut c2v) {\n750\t    unsafe {\n751\t        let (wa, wb) = witness(&*s);\n752\t        *a = wa;\n753\t        *b = wb;\n754\t    }\n755\t}\n756\t\n757\tfn lerp_point(s: &c2Simplex) -> c2v {\n758\t    let den = divss(1.0f32, s.div);\n759\t    match s.count {\n760\t        1 => s.verts[0].p,\n761\t        2 => c2Add(\n762\t            c2Mulvs(s.verts[0].p, wu(s.verts[0].u, den)),\n763\t            c2Mulvs(s.verts[1].p, wu(s.verts[1].u, den)),\n764\t        ),\n765\t        _ => c2V(0.0, 0.0),\n766\t    }\n767\t}\n768\t\n769\t#[unsafe(no_mangle)]\n770\tpub unsafe extern \"C\" fn c2L(s: *mut c2Simplex) -> c2v {\n771\t    unsafe { lerp_point(&*s) }\n772\t}\n773\t\n774\t// ---------------------------------------------------------------------------\n775\t// GJK\n776\t// ---------------------------------------------------------------------------\n777\t\n778\t#[unsafe(no_mangle)]\n779\tpub unsafe extern \"C\" fn c2GJK(\n780\t    A: *const c_void,\n781\t    typeA: c_int,\n782\t    ax_ptr: *const c2x,\n783\t    B: *const c_void,\n784\t    typeB: c_int,\n785\t    bx_ptr: *const c2x,\n786\t    outA: *mut c2v,\n787\t    outB: *mut c2v,\n788\t    use_radius: c_int,\n789\t    iterations: *mut c_int,\n790\t    cache: *mut c2GJKCache,\n791\t) -> f32 {\n792\t    unsafe {\n793\t        let ax: c2x = if ax_ptr.is_null() {\n794\t            c2xIdentity()\n795\t        } else {\n796\t            *ax_ptr\n797\t        };\n798\t        let bx: c2x = if bx_ptr.is_null() {\n799\t            c2xIdentity()\n800\t        } else {\n801\t            *bx_ptr\n802\t        };\n803\t\n804\t        let mut pA = c2Proxy::default();\n805\t        let mut pB = c2Proxy::default();\n806\t        c2MakeProxy(A, typeA, &mut pA);\n807\t        c2MakeProxy(B, typeB, &mut pB);\n808\t\n809\t        let mut s = c2Simplex::default();\n810\t        let mut cache_was_read = 0;\n811\t        if !cache.is_null() {\n812\t            let cache_was_good = (*cache).count != 0;\n813\t            if cache_was_good {\n814\t                let n = (*cache).count;\n815\t                // The C loop is `for (i = 0; i < cache->count; ++i)` and both\n816\t                // `cache->iA[i]` and `s.verts[i]` are 3/4-element arrays, so a\n817\t                // `count` above 4 is out-of-bounds (documented UB, see\n818\t                // ERRORS.md U2). Clamp to the storage the C struct actually\n819\t                // has so the Rust side stays memory-safe.\n820\t                let bound = if n > 3 { 3 } else { n };\n821\t                let mut i: c_int = 0;\n822\t                while i < bound {\n823\t                    let idx = i as usize;\n824\t                    let iA = (*cache).iA[idx];\n825\t                    let iB = (*cache).iB[idx];\n826\t                    let sA = c2Mulxv(ax, proxy_vert(&pA, iA));\n827\t                    let sB = c2Mulxv(bx, proxy_vert(&pB, iB));\n828\t                    let vtx = &mut s.verts[idx];\n829\t                    vtx.iA = iA;\n830\t                    vtx.sA = sA;\n831\t                    vtx.iB = iB;\n832\t                    vtx.sB = sB;\n833\t                    vtx.p = c2Sub(vtx.sB, vtx.sA);\n834\t                    vtx.u = 0.0;\n835\t                    i += 1;\n836\t                }\n837\t                s.count = (*cache).count;\n838\t                s.div = (*cache).div;\n839\t                let metric_old = (*cache).metric;\n840\t                let metric = gjk_simplex_metric(&s);\n841\t                let min_metric = if metric < metric_old {\n842\t                    metric\n843\t                } else {\n844\t                    metric_old\n845\t                };\n846\t                let max_metric = if metric > metric_old {\n847\t                    metric\n848\t                } else {\n849\t                    metric_old\n850\t                };\n851\t                // gcc folds `max_metric * 2.0f` into `addss %xmm0,%xmm0`;\n852\t                // `mulss(max_metric, 2.0)` is bit-identical for every input\n853\t                // (same value, same NaN winner).\n854\t                if !(min_metric < mulss(max_metric, 2.0f32) && metric < -1.0e8f32) {\n855\t                    cache_was_read = 1;\n856\t                }\n857\t            }\n858\t        }\n859\t\n860\t        if cache_was_read == 0 {\n861\t            s.verts[0].iA = 0;\n862\t            s.verts[0].iB = 0;\n863\t            s.verts[0].sA = c2Mulxv(ax, pA.verts[0]);\n864\t            s.verts[0].sB = c2Mulxv(bx, pB.verts[0]);\n865\t            s.verts[0].p = c2Sub(s.verts[0].sB, s.verts[0].sA);\n866\t            s.verts[0].u = 1.0f32;\n867\t            s.div = 1.0f32;\n868\t            s.count = 1;\n869\t        }\n870\t\n871\t        let mut saveA: [c_int; 4] = [0; 4];\n872\t        let mut saveB: [c_int; 4] = [0; 4];\n873\t        let mut save_count: c_int;\n874\t        let mut d0: f32 = C2_FLT_MAX;\n875\t        let mut d1: f32;\n876\t        let mut iter: c_int = 0;\n877\t        let mut hit: c_int = 0;\n878\t        while iter < 20 {\n879\t            save_count = s.count;\n880\t            // `int saveA[3]` in C; `s.count` is at most 3 for any simplex this\n881\t            // library can build, so the clamp is never observable.\n882\t            let sc = if save_count > 4 { 4 } else { save_count };\n883\t            let mut i: c_int = 0;\n884\t            while i < sc {\n885\t                saveA[i as usize] = s.verts[i as usize].iA;\n886\t                saveB[i as usize] = s.verts[i as usize].iB;\n887\t                i += 1;\n888\t            }\n889\t\n890\t            match s.count {\n891\t                1 => {}\n892\t                2 => simplex2(&mut s),\n893\t                3 => simplex3(&mut s),\n894\t                _ => {}\n895\t            }\n896\t\n897\t            if s.count == 3 {\n898\t                hit = 1;\n899\t                break;\n900\t            }\n901\t\n902\t            let p = lerp_point(&s);\n903\t            d1 = c2Dot(p, p);\n904\t            if d1 > d0 {\n905\t                break;\n906\t            }\n907\t            d0 = d1;\n908\t\n909\t            let d = direction(&s);\n910\t            if c2Dot(d, d) < C2_EPSILON_SQ {\n911\t                break;\n912\t            }\n913\t\n914\t            let iA = c2Support(pA.verts.as_ptr(), pA.count, c2MulrvT(ax.r, c2Neg(d)));\n915\t            let sA = c2Mulxv(ax, proxy_vert(&pA, iA));\n916\t            let iB = c2Support(pB.verts.as_ptr(), pB.count, c2MulrvT(bx.r, d));\n917\t            let sB = c2Mulxv(bx, proxy_vert(&pB, iB));\n918\t            // `c2sv *v = verts + s.count;` — `s.count` is provably in `1..=2`\n919\t            // at this point (a 3-simplex `break`s above with `hit`, and any\n920\t            // `count >= 4` coming from a cache `break`s on the epsilon test\n921\t            // during the first iteration), so this is always in bounds. The\n922\t            // `get_mut` keeps that guarantee enforced rather than assumed.\n923\t            if let Some(vtx) = s.verts.get_mut(s.count as usize) {\n924\t                vtx.iA = iA;\n925\t                vtx.sA = sA;\n926\t                vtx.iB = iB;\n927\t                vtx.sB = sB;\n928\t                vtx.p = c2Sub(vtx.sB, vtx.sA);\n929\t            }\n930\t\n931\t            let mut dup = 0;\n932\t            let mut i: c_int = 0;\n933\t            while i < sc {\n934\t                if iA == saveA[i as usize] && iB == saveB[i as usize] {\n935\t                    dup = 1;\n936\t                    break;\n937\t                }\n938\t                i += 1;\n939\t            }\n940\t            if dup != 0 {\n941\t                break;\n942\t            }\n943\t\n944\t            s.count += 1;\n945\t            iter += 1;\n946\t        }\n947\t\n948\t        let (mut a, mut b) = witness(&s);\n949\t        let mut dist = c2Len(c2Sub(a, b));\n950\t        if hit != 0 {\n951\t            a = b;\n952\t            dist = 0.0;\n953\t        } else if use_radius != 0 {\n954\t            let rA = pA.radius;\n955\t            let rB = pB.radius;\n956\t            // gcc: `addss` with `rA` in the destination.\n957\t            let rsum = addss(rA, rB);\n958\t            if dist > rsum && dist > C2_EPSILON {\n959\t                dist = subss(dist, addss(rA, rB));\n960\t                let n = c2Norm(c2Sub(b, a));\n961\t                a = c2Add(a, c2Mulvs(n, rA));\n962\t                b = c2Sub(b, c2Mulvs(n, rB));\n963\t                if a.x == b.x && a.y == b.y {\n964\t                    dist = 0.0;\n965\t                }\n966\t            } else {\n967\t                let p = c2Mulvs(c2Add(a, b), 0.5f32);\n968\t                a = p;\n969\t                b = p;\n970\t                dist = 0.0;\n971\t            }\n972\t        }\n973\t\n974\t        if !cache.is_null() {\n975\t            (*cache).metric = gjk_simplex_metric(&s);\n976\t            (*cache).count = s.count;\n977\t            let n = if s.count > 3 { 3 } else { s.count };\n978\t            let mut i: c_int = 0;\n979\t            while i < n {\n980\t                let idx = i as usize;\n981\t                (*cache).iA[idx] = s.verts[idx].iA;\n982\t                (*cache).iB[idx] = s.verts[idx].iB;\n983\t                i += 1;\n984\t            }\n985\t            (*cache).div = s.div;\n986\t        }\n987\t        if !outA.is_null() {\n988\t            *outA = a;\n989\t        }\n990\t        if !outB.is_null() {\n991\t            *outB = b;\n992\t        }\n993\t        if !iterations.is_null() {\n994\t            *iterations = iter;\n995\t        }\n996\t        dist\n997\t    }\n998\t}\n999\t\n1000\t// ---------------------------------------------------------------------------\n1001\t// Boolean shape tests\n1002\t// ---------------------------------------------------------------------------\n1003\t\n1004\t#[unsafe(no_mangle)]\n1005\tpub extern \"C\" fn c2AABBtoAABB(A: c2AABB, B: c2AABB) -> c_int {\n1006\t    let d0: c_int = (B.max.x < A.min.x) as c_int;\n1007\t    let d1: c_int = (A.max.x < B.min.x) as c_int;\n1008\t    let d2: c_int = (B.max.y < A.min.y) as c_int;\n1009\t    let d3: c_int = (A.max.y < B.min.y) as c_int;\n1010\t    ((d0 | d1 | d2 | d3) == 0) as c_int\n1011\t}\n1012\t\n1013\t#[unsafe(no_mangle)]\n1014\tpub extern \"C\" fn c2AABBtoCapsule(A: c2AABB, B: c2Capsule) -> c_int {\n1015\t    unsafe {\n1016\t        if c2GJK(\n1017\t            &A as *const c2AABB as *const c_void,\n1018\t            C2_TYPE_AABB,\n1019\t            std::ptr::null(),\n1020\t            &B as *const c2Capsule as *const c_void,\n1021\t            C2_TYPE_CAPSULE,\n1022\t            std::ptr::null(),\n1023\t            std::ptr::null_mut(),\n1024\t            std::ptr::null_mut(),\n1025\t            1,\n1026\t            std::ptr::null_mut(),\n1027\t            std::ptr::null_mut(),\n1028\t        ) != 0.0\n1029\t        {\n1030\t            return 0;\n1031\t        }\n1032\t    }\n1033\t    1\n1034\t}\n1035\t\n1036\t#[unsafe(no_mangle)]\n1037\tpub extern \"C\" fn c2CapsuletoCapsule(A: c2Capsule, B: c2Capsule) -> c_int {\n1038\t    unsafe {\n1039\t        if c2GJK(\n1040\t            &A as *const c2Capsule as *const c_void,\n1041\t            C2_TYPE_CAPSULE,\n1042\t            std::ptr::null(),\n1043\t            &B as *const c2Capsule as *const c_void,\n1044\t            C2_TYPE_CAPSULE,\n1045\t            std::ptr::null(),\n1046\t            std::ptr::null_mut(),\n1047\t            std::ptr::null_mut(),\n1048\t            1,\n1049\t            std::ptr::null_mut(),\n1050\t            std::ptr::null_mut(),\n1051\t        ) != 0.0\n1052\t        {\n1053\t            return 0;\n1054\t        }\n1055\t    }\n1056\t    1\n1057\t}\n1058\t\n1059\t/// gcc: `r2 = A.r + B.r` becomes `addss` with **`B.r`** in the destination.\n1060\t#[unsafe(no_mangle)]\n1061\tpub extern \"C\" fn c2CircletoCircle(A: c2Circle, B: c2Circle) -> c_int {\n1062\t    let c = c2Sub(B.p, A.p);\n1063\t    let d2 = c2Dot(c, c);\n1064\t    let mut r2 = addss(B.r, A.r);\n1065\t    r2 = mulss(r2, r2);\n1066\t    (d2 < r2) as c_int\n1067\t}\n1068\t\n1069\t#[unsafe(no_mangle)]\n1070\tpub extern \"C\" fn c2CircletoAABB(A: c2Circle, B: c2AABB) -> c_int {\n1071\t    let L = c2Clampv(A.p, B.min, B.max);\n1072\t    let ab = c2Sub(A.p, L);\n1073\t    let d2 = c2Dot(ab, ab);\n1074\t    let r2 = mulss(A.r, A.r);\n1075\t    (d2 < r2) as c_int\n1076\t}\n1077\t\n1078\t/// gcc: `r = A.r + B.r` becomes `addss` with **`B.r`** in the destination;\n1079\t/// `da / c2Dot(n, n)` is `divss` with `da` in the destination.\n1080\t#[unsafe(no_mangle)]\n1081\tpub extern \"C\" fn c2CircletoCapsule(A: c2Circle, B: c2Capsule) -> c_int {\n1082\t    let n = c2Sub(B.b, B.a);\n1083\t    let ap = c2Sub(A.p, B.a);\n1084\t    let da = c2Dot(ap, n);\n1085\t    let d2;\n1086\t    if da < 0.0 {\n1087\t        d2 = c2Dot(ap, ap);\n1088\t    } else {\n1089\t        let db = c2Dot(c2Sub(A.p, B.b), n);\n1090\t        if db < 0.0 {\n1091\t            let e = c2Sub(ap, c2Mulvs(n, divss(da, c2Dot(n, n))));\n1092\t            d2 = c2Dot(e, e);\n1093\t        } else {\n1094\t            let bp = c2Sub(A.p, B.b);\n1095\t            d2 = c2Dot(bp, bp);\n1096\t        }\n1097\t    }\n1098\t    let r = addss(B.r, A.r);\n1099\t    (d2 < mulss(r, r)) as c_int\n1100\t}\n1101\t\n1102\t#[unsafe(no_mangle)]\n1103\tpub unsafe extern \"C\" fn c2Collided(\n1104\t    A: *const c_void,\n1105\t    typeA: c_int,\n1106\t    B: *const c_void,\n1107\t    typeB: c_int,\n1108\t) -> c_int {\n1109\t    unsafe {\n1110\t        match typeA {\n1111\t            C2_TYPE_CIRCLE => match typeB {\n1112\t                C2_TYPE_CIRCLE => {\n1113\t                    c2CircletoCircle(*(A as *const c2Circle), *(B as *const c2Circle))\n1114\t                }\n1115\t                C2_TYPE_AABB => c2CircletoAABB(*(A as *const c2Circle), *(B as *const c2AABB)),\n1116\t                C2_TYPE_CAPSULE => {\n1117\t                    c2CircletoCapsule(*(A as *const c2Circle), *(B as *const c2Capsule))\n1118\t                }\n1119\t                _ => 0,\n1120\t            },\n1121\t            C2_TYPE_AABB => match typeB {\n1122\t                C2_TYPE_CIRCLE => c2CircletoAABB(*(B as *const c2Circle), *(A as *const c2AABB)),\n1123\t                C2_TYPE_AABB => c2AABBtoAABB(*(A as *const c2AABB), *(B as *const c2AABB)),\n1124\t                C2_TYPE_CAPSULE => {\n1125\t                    c2AABBtoCapsule(*(A as *const c2AABB), *(B as *const c2Capsule))\n1126\t                }\n1127\t                _ => 0,\n1128\t            },\n1129\t            C2_TYPE_CAPSULE => match typeB {\n1130\t                C2_TYPE_CIRCLE => {\n1131\t                    c2CircletoCapsule(*(B as *const c2Circle), *(A as *const c2Capsule))\n1132\t                }\n1133\t                C2_TYPE_AABB => c2AABBtoCapsule(*(B as *const c2AABB), *(A as *const c2Capsule)),\n1134\t                C2_TYPE_CAPSULE => {\n1135\t                    c2CapsuletoCapsule(*(A as *const c2Capsule), *(B as *const c2Capsule))\n1136\t                }\n1137\t                _ => 0,\n1138\t            },\n1139\t            _ => 0,\n1140\t        }\n1141\t    }\n1142\t}\n1143\t\n1144\t// ---------------------------------------------------------------------------\n1145\t// Public entry point declared in include/lib.h\n1146\t// ---------------------------------------------------------------------------\n1147\t\n1148\t#[unsafe(no_mangle)]\n1149\tpub extern \"C\" fn aabb(min_x: f32, min_y: f32, max_x: f32, max_y: f32) -> c_int {\n1150\t    let mut result: c_int = 0;\n1151\t\n1152\t    let mut aabb_in = c2AABB::default();\n1153\t    aabb_in.min = c2V(min_x, min_y);\n1154\t    aabb_in.max = c2V(max_x, max_y);\n1155\t\n1156\t    let mut circle = c2Circle::default();\n1157\t    circle.p = c2V(-70.0f32, 0.0);\n1158\t    circle.r = 20.0f32;\n1159\t\n1160\t    let mut aabb = c2AABB::default();\n1161\t    aabb.min = c2V(-40.0f32, -40.0f32);\n1162\t    aabb.max = c2V(-15.0f32, -15.0f32);\n1163\t\n1164\t    let mut capsule = c2Capsule::default();\n1165\t    capsule.a = c2V(-40.0f32, 40.0f32);\n1166\t    capsule.b = c2V(-20.0f32, 100.0f32);\n1167\t    capsule.r = 10.0f32;\n1168\t\n1169\t    unsafe {\n1170\t        result += c2Collided(\n1171\t            &circle as *const c2Circle as *const c_void,\n1172\t            C2_TYPE_CIRCLE,\n1173\t            &aabb_in as *const c2AABB as *const c_void,\n1174\t            C2_TYPE_AABB,\n1175\t        );\n1176\t\n1177\t        result += c2Collided(\n1178\t            &aabb as *const c2AABB as *const c_void,\n1179\t            C2_TYPE_AABB,\n1180\t            &aabb_in as *const c2AABB as *const c_void,\n1181\t            C2_TYPE_AABB,\n1182\t        ) << 1;\n1183\t\n1184\t        result += c2Collided(\n1185\t            &capsule as *const c2Capsule as *const c_void,\n1186\t            C2_TYPE_CAPSULE,\n1187\t            &aabb_in as *const c2AABB as *const c_void,\n1188\t            C2_TYPE_AABB,\n1189\t        ) << 2;\n1190\t    }\n1191\t\n1192\t    result\n1193\t}\n1194\t"}]},"parent_tool_use_id":"toolu_bdrk_0182jmuhGVuK5nq1taYzZmw2","session_id":"d6baee55-62af-498d-9859-1b970a6dfa0a","uuid":"19aff8cf-a9fa-40c2-9e39-c1cba4ef4e23","timestamp":"2026-08-27T04:36:25.605Z","subagent_type":"Explore","task_description":"Audit C vs Rust semantic diff"}
