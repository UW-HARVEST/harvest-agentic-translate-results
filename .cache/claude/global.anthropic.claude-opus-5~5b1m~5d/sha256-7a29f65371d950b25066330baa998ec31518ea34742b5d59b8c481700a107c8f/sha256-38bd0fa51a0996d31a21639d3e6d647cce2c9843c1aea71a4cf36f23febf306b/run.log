f13_impl(dest: &mut [f32; 3], src: &[f32; 3]) {\n    let r = src[0];\n    let g = src[1];\n    let b = src[2];\n    let mut h: f32 = 0.0;\n    let mut s: f32 = 0.0;\n    let v: f32;\n    let mut min = r;\n    let mut max = r;\n    let delta: f32;\n    min = if min < g { min } else { g };\n    min = if min < b { min } else { b };\n    max = if max > g { max } else { g };\n    max = if max > b { max } else { b };\n    delta = subss(max, min);\n    v = max;\n    if delta == 0.0 || max == 0.0 {\n        dest[0] = h;\n        dest[1] = s;\n        dest[2] = v;\n        return;\n    }\n    s = divss(delta, max);\n    if r == max {\n        h = divss(subss(g, b), delta);\n    } else if g == max {\n        h = addss(2.0f32, divss(subss(b, r), delta));\n    } else {\n        h = addss(4.0f32, divss(subss(r, g), delta));\n    }\n    h = mulss(h, 60.0f32);\n    if h < 0.0 {\n        h = addss(h, 360.0f32);\n    }\n    dest[0] = h;\n    dest[1] = s;\n    dest[2] = v;\n}\n\n/// # Safety\n/// `dest` must be writable for 3 `float`s and `src` readable for 3 `float`s.\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn f13(dest: *mut f32, src: *const f32) {\n    let s: [f32; 3] = [*src.add(0), *src.add(1), *src.add(2)];\n    let mut d: [f32; 3] = [0.0, 0.0, 0.0];\n    f13_impl(&mut d, &s);\n    *dest.add(0) = d[0];\n    *dest.add(1) = d[1];\n    *dest.add(2) = d[2];\n}\n\n// ---------------------------------------------------------------------------\n// agglom — the aggregate entry point declared in include/lib.h\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn agglom(\n    f2_1: f32,\n    f2_2: f32,\n    f2_3: f32,\n    f2_7: f32,\n    f2_8: f32,\n    f2_9: f32,\n    f2_10: f32,\n    f3_1: c_int,\n    f3_2: c_int,\n    f4_1: u64,\n    f4_2: u64,\n    f5_1: u32,\n    f7_1: tflac_u32,\n    f7_2: tflac_u32,\n    f7_3: tflac_u32,\n    f9_1: f32,\n    f9_2: f32,\n    f9_4: f32,\n    f9_5: f32,\n    f9_7: f32,\n   