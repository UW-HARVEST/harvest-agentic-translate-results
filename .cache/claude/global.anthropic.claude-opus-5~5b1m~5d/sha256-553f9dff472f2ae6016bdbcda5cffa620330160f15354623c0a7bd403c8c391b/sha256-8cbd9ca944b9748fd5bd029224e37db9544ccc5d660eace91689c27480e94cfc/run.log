{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01EAGkpCboQXY88uCyx1Nz81","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/`.\n2\t//!\n3\t//! The C library consists of a single translation unit (`src/lib.c`) exposing\n4\t//! one public symbol: `flip_horizontal`. The public types (`cp_pixel_t`,\n5\t//! `cp_image_t`) come from `include/lib.h`.\n6\t//!\n7\t//! Behaviour is reproduced exactly, including the original's (mis)naming: the\n8\t//! function is called `flip_horizontal` but it actually swaps rows, i.e. it\n9\t//! flips the image vertically. That is *not* \"fixed\" here.\n10\t\n11\t#![allow(non_camel_case_types)]\n12\t\n13\tuse std::ffi::c_int;\n14\t\n15\t/// `typedef struct cp_pixel_t { uint8_t r, g, b, a; } cp_pixel_t;`\n16\t#[repr(C)]\n17\t#[derive(Clone, Copy)]\n18\tpub struct cp_pixel_t {\n19\t    pub r: u8,\n20\t    pub g: u8,\n21\t    pub b: u8,\n22\t    pub a: u8,\n23\t}\n24\t\n25\t/// `typedef struct cp_image_t { int w; int h; cp_pixel_t *pix; } cp_image_t;`\n26\t#[repr(C)]\n27\tpub struct cp_image_t {\n28\t    pub w: c_int,\n29\t    pub h: c_int,\n30\t    pub pix: *mut cp_pixel_t,\n31\t}\n32\t\n33\t/// ```c\n34\t/// void flip_horizontal(cp_image_t *img) {\n35\t///     cp_pixel_t *pix = img->pix;\n36\t///     int w = img->w;\n37\t///     int h = img->h;\n38\t///     int flips = h / 2;\n39\t///     for (int i = 0; i < flips; ++i) {\n40\t///         cp_pixel_t *a = pix + w * i;\n41\t///         cp_pixel_t *b = pix + w * (h - i - 1);\n42\t///         for (int j = 0; j < w; ++j) {\n43\t///             cp_pixel_t t = *a;\n44\t///             *a = *b;\n45\t///             *b = t;\n46\t///             ++a;\n47\t///             ++b;\n48\t///         }\n49\t///     }\n50\t/// }\n51\t/// ```\n52\t#[unsafe(no_mangle)]\n53\tpub unsafe extern \"C\" fn flip_horizontal(img: *mut cp_image_t) {\n54\t    // The C code unconditionally dereferences `img`; a NULL pointer faults\n55\t    // there exactly as it does here.\n56\t    let pix: *mut cp_pixel_t = unsafe { (*img).pix };\n57\t    let w: c_int = unsafe { (*img).w };\n58\t    let h: c_int = unsafe { (*img).h };\n59\t\n60\t    // Integer division truncates toward zero, matching C's `h / 2`.\n61\t    // (`h == INT_MIN` is division of the minimum value by 2, which is exact.)\n62\t    let flips: c_int = h.wrapping_div(2);\n63\t\n64\t    let mut i: c_int = 0;\n65\t    while i < flips {\n66\t        // `pix + w * i` and `pix + w * (h - i - 1)`: the index expressions are\n67\t        // computed in `int` before being widened for the pointer arithmetic,\n68\t        // so wrapping ops reproduce the usual C codegen bit-for-bit.\n69\t        let off_a = w.wrapping_mul(i) as isize;\n70\t        let off_b = w.wrapping_mul(h.wrapping_sub(i).wrapping_sub(1)) as isize;\n71\t\n72\t        let mut a: *mut cp_pixel_t = unsafe { pix.offset(off_a) };\n73\t        let mut b: *mut cp_pixel_t = unsafe { pix.offset(off_b) };\n74\t\n75\t        let mut j: c_int = 0;\n76\t        while j < w {\n77\t            unsafe {\n78\t                let t = *a;\n79\t                *a = *b;\n80\t                *b = t;\n81\t                a = a.offset(1);\n82\t                b = b.offset(1);\n83\t            }\n84\t            j = j.wrapping_add(1);\n85\t        }\n86\t\n87\t        i = i.wrapping_add(1);\n88\t    }\n89\t}\n90\t"}]},"parent_tool_use_id":null,"session_id":"9a675958-8a5c-4163-983a-1ededba583e3","uuid":"865cb333-7ed9-481c-9f2b-380014ea9bbd","timestamp":"2026-09-05T00:23:04.428Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-HArM1X/translation/src/lib.rs","content":"//! Rust translation of the C library in `c_src/`.\n//!\n//! The C library consists of a single translation unit (`src/lib.c`) exposing\n//! one public symbol: `flip_horizontal`. The public types (`cp_pixel_t`,\n//! `cp_image_t`) come from `include/lib.h`.\n//!\n//! Behaviour is reproduced exactly, including the original's (mis)naming: the\n//! function is called `flip_horizontal` but it actually swaps rows, i.e. it\n//! flips the image vertically. That is *not* \"fixed\" here.\n\n#![allow(non_camel_case_types)]\n\nuse std::ffi::c_int;\n\n/// `typedef struct cp_pixel_t { uint8_t r, g, b, a; } cp_pixel_t;`\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct cp_pixel_t {\n    pub r: u8,\n    pub g: u8,\n    pub b: u8,\n    pub a: u8,\n}\n\n/// `typedef struct cp_image_t { int w; int h; cp_pixel_t *pix; } cp_image_t;`\n#[repr(C)]\npub struct cp_image_t {\n    pub w: c_int,\n    pub h: c_int,\n    pub pix: *mut cp_pixel_t,\n}\n\n/// ```c\n/// void flip_horizontal(cp_image_t *img) {\n///     cp_pixel_t *pix = img->pix;\n///     int w = img->w;\n///     int h = img->h;\n///     int flips = h / 2;\n///     for (int i = 0; i < flips; ++i) {\n///         cp_pixel_t *a = pix + w * i;\n///         cp_pixel_t *b = pix + w * (h - i - 1);\n///         for (int j = 0; j < w; ++j) {\n///             cp_pixel_t t = *a;\n///             *a = *b;\n///             *b = t;\n///             ++a;\n///             ++b;\n///         }\n///     }\n/// }\n/// ```\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn flip_horizontal(img: *mut cp_image_t) {\n    // The C code unconditionally dereferences `img`; a NULL pointer faults\n    // there exactly as it does here.\n    let pix: *mut cp_pixel_t = unsafe { (*img).pix };\n    let w: c_int = unsafe { (*img).w };\n    let h: c_int = unsafe { (*img).h };\n\n    // Integer division truncates toward zero, matching C's `h / 2`.\n    // (`h == INT_MIN` is division of the minimum value by 2, which is exact.)\n    let flips: c_int = h.wrapping_div(2);\n\n    let mut i: c_int = 0;\n    while i < flips {\n        // `pix + w * i` and `pix + w * (h - i - 1)`: the index expressions are\n        // computed in `int` before being widened for the pointer arithmetic,\n        // so wrapping ops reproduce the usual C codegen bit-for-bit.\n        let off_a = w.wrapping_mul(i) as isize;\n        let off_b = w.wrapping_mul(h.wrapping_sub(i).wrapping_sub(1)) as isize;\n\n        let mut a: *mut cp_pixel_t = unsafe { pix.offset(off_a) };\n        let mut b: *mut cp_pixel_t = unsafe { pix.offset(off_b) };\n\n        let mut j: c_int = 0;\n        while j < w {\n            unsafe {\n                let t = *a;\n                *a = *b;\n                *b = t;\n                a = a.offset(1);\n                b = b.offset(1);\n            }\n            j = j.wrapping_add(1);\n        }\n\n        i = i.wrapping_add(1);\n    }\n}\n","numLines":90,"startLine":1,"totalLines":90}}}
