        .wrapping_sub(7i32.wrapping_mul(ps(psamp, idx, 4)))\n301\t            .wrapping_add(5i32.wrapping_mul(ps(psamp, idx, 5)))\n302\t            .wrapping_sub(4i32.wrapping_mul(ps(psamp, idx, 6)))\n303\t            .wrapping_add(4i32.wrapping_mul(ps(psamp, idx, 7)))\n304\t            .wrapping_sub(3i32.wrapping_mul(ps(psamp, idx, 8)))\n305\t            .wrapping_div(64)\n306\t    }\n307\t}\n308\t\n309\tunsafe extern \"C\" fn BTAC1C2_PredictSample_Pfn10(\n310\t    psamp: *mut c_int,\n311\t    idx: c_int,\n312\t    _pfcn: c_int,\n313\t    _ridx: *mut btac1c_idxstate,\n314\t) -> c_int {\n315\t    unsafe {\n316\t        let p0 = ps(psamp, idx, 1)\n317\t            .wrapping_add(ps(psamp, idx, 2))\n318\t            .wrapping_add(ps(psamp, idx, 3))\n319\t            .wrapping_add(ps(psamp, idx, 4));\n320\t        let p1 = ps(psamp, idx, 5)\n321\t            .wrapping_add(ps(psamp, idx, 6))\n322\t            .wrapping_add(ps(psamp, idx, 7))\n323\t            .wrapping_add(ps(psamp, idx, 8));\n324\t        // NOTE: the C source shifts by 3 here (whereas case 10 of the big\n325\t        // switch shifts by 4); reproduced verbatim.\n326\t        5i32.wrapping_mul(p0).wrapping_sub(p1) >> 3\n327\t    }\n328\t}\n329\t\n330\tunsafe extern \"C\" fn BTAC1C2_PredictSample_Pfn11(\n331\t    psamp: *mut c_int,\n332\t    idx: c_int,\n333\t    _pfcn: c_int,\n334\t    _ridx: *mut btac1c_idxstate,\n335\t) -> c_int {\n336\t    unsafe {\n337\t        let p0 = ps(psamp, idx, 1)\n338\t            .wrapping_add(ps(psamp, idx, 2))\n339\t            .wrapping_add(ps(psamp, idx, 3))\n340\t            .wrapping_add(ps(psamp, idx, 4));\n341\t        let p1 = ps(psamp, idx, 5)\n342\t            .wrapping_add(ps(psamp, idx, 6))\n343\t            .wrapping_add(ps(psamp, idx, 7))\n344\t            .wrapping_add(ps(psamp, idx, 8));\n345\t        // NOTE: the C source shifts by 1 here (whereas case 11 of the big\n346\t        // switch shifts by 3); reproduced verbatim.\n347\t        p0.wrapping_add(p1) >> 1\n348\t    }\n349\t}\n350\t\n351\tfn BTAC1C2_GetPredictFunc(pfcn: c_int) -> *mut c_void {\n352\t    let fcn: PredictFn = match pfcn {\n353\t        0 => BTAC1C2_PredictSample_Pfn0,\n354\t        1 => BTAC1C2_PredictSample_Pfn1,\n355\t        2 => BTAC1C2_PredictSample_Pfn2,\n356\t        3 => BTAC1C2_PredictSample_Pfn3,\n357\t        4 => BTAC1C2_PredictSample_Pfn4,\n358\t        5 => BTAC1C2_PredictSample_Pfn5,\n359\t        6 => BTAC1C2_PredictSample_Pfn6,\n360\t        7 => BTAC1C2_PredictSample_Pfn7,\n361\t        8 => BTAC1C2_PredictSample_Pfn8,\n362\t        9 => BTAC1C2_PredictSample_Pfn9,\n363\t        10 => BTAC1C2_PredictSample_Pfn10,\n364\t        11 => BTAC1C2_PredictSample_Pfn11,\n365\t        _ => BTAC1C2_PredictSample,\n366\t    };\n367\t    fcn as *mut c_void\n368\t}\n369\t\n370\t#[unsafe(no_mangle)]\n371\tpub extern \"C\" fn call_predict(pfcn: c_int) -> c_int {\n372\t    let mut result: c_int = 0;\n373\t    let fcn = BTAC1C2_GetPredictFunc(pfcn);\n374\t    match pfcn {\n375\t        0 => result = (fcn == BTAC1C2_PredictSample_Pfn0 as *mut c_void) as c_int,\n376\t        1 => result = (fcn == BTAC1C2_PredictSample_Pfn1 as *mut c_void) as c_int,\n377\t        2 => result = (fcn == BTAC1C2_PredictSample_Pfn2 as *mut c_void) as c_int,\n378\t        3 => result = (fcn == BTAC1C2_PredictSample_Pfn3 as *mut c_void) as c_int,\n379\t        4 => result = (fcn == BTAC1C2_PredictSample_Pfn4 as *mut c_void) as c_int,\n380\t        5 => result = (fcn == BTAC1C2_PredictSample_Pfn5 as *mut c_void) as c_int,\n381\t        6 => result = (fcn == BTAC1C2_PredictSample_Pfn6 as *mut c_void) as c_int,\n382\t        7 => result = (fcn == BTAC1C2_PredictSample_Pfn7 as *mut c_void) as c_int,\n383\t        8 => result = (fcn == BTAC1C2_PredictSample_Pfn8 as *mut c_void) as c_int,\n384\t        9 => result = (fcn == BTAC1C2_PredictSample_Pfn9 as *mut c_void) as c_int,\n385\t        10 => result = (fcn == BTAC1C2_PredictSample_Pfn10 as *mut c_void) as c_int,\n386\t      