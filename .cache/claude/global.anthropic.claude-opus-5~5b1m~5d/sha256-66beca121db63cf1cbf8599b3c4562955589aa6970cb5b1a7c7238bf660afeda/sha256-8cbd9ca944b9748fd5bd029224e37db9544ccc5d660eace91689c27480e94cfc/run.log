{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_amjuq2mlqc6dmrkyf6cnz7yzx5szvxpbkrdrejd5qljqbas54cvq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_012mTc5GHpUueZHW2CNf1qvH","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-6iQDjX/translation/tests/phase_d_symbols.rs","content":"//! Phase D — symbol parity enforced as a test: every dynamic symbol the C `.so`\n//! exports must also be exported by the Rust `.so`, with the exact same name.\n\nuse std::collections::BTreeSet;\nuse std::path::{Path, PathBuf};\nuse std::process::Command;\n\nmod common;\n\nfn nm_defined(so: &Path) -> BTreeSet<String> {\n    let out = Command::new(\"nm\")\n        .args([\"-D\", \"--defined-only\", \"--format=posix\"])\n        .arg(so)\n        .output()\n        .expect(\"run nm\");\n    assert!(\n        out.status.success(),\n        \"nm failed on {so:?}: {}\",\n        String::from_utf8_lossy(&out.stderr)\n    );\n    String::from_utf8_lossy(&out.stdout)\n        .lines()\n        .filter_map(|l| {\n            let mut it = l.split_whitespace();\n            let name = it.next()?;\n            let kind = it.next()?;\n            // Global text/data/bss/rodata only; skip local (lowercase) symbols.\n            if matches!(kind, \"T\" | \"D\" | \"B\" | \"R\" | \"W\" | \"V\" | \"G\" | \"S\") {\n                Some(name.to_string())\n            } else {\n                None\n            }\n        })\n        .collect()\n}\n\nfn root() -> PathBuf {\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n        .parent()\n        .unwrap()\n        .to_path_buf()\n}\n\nfn find_c_so() -> PathBuf {\n    // The harness in common/ builds the C lib if needed.\n    let _ = common::Libs::load();\n    let build = root().join(\"c_src/build\");\n    let mut found = None;\n    for e in std::fs::read_dir(&build).expect(\"read c_src/build\").flatten() {\n        let p = e.path();\n        let n = p.file_name().unwrap().to_string_lossy().to_string();\n        if n.starts_with(\"lib\") && n.ends_with(\".so\") {\n            found = Some(p);\n        }\n    }\n    found.expect(\"C .so exists\")\n}\n\nfn find_rust_so() -> PathBuf {\n    let exe = std::env::current_exe().unwrap();\n    let mut dir = exe.parent().unwrap().to_path_buf();\n    if dir.file_name().map(|n| n == \"deps\").unwrap_or(false) {\n        dir.pop();\n    }\n    let c = dir.join(\"libcall_predict_lib.so\");\n    if c.exists() {\n        return c;\n    }\n    root().join(\"translation/target/release/libcall_predict_lib.so\")\n}\n\n#[test]\nfn rust_so_exports_every_c_symbol() {\n    let c_syms = nm_defined(&find_c_so());\n    let r_syms = nm_defined(&find_rust_so());\n\n    assert!(\n        c_syms.contains(\"call_predict\"),\n        \"sanity: C .so should export call_predict, got {c_syms:?}\"\n    );\n\n    let missing: Vec<&String> = c_syms.difference(&r_syms).collect();\n    assert!(\n        missing.is_empty(),\n        \"Rust .so is missing C-exported symbols: {missing:?}\"\n    );\n}\n\n#[test]\nfn rust_so_has_no_undefined_non_libc_symbols() {\n    let so = find_rust_so();\n    let out = Command::new(\"nm\")\n        .args([\"-D\", \"--undefined-only\", \"--format=posix\"])\n        .arg(&so)\n        .output()\n        .expect(\"run nm\");\n    assert!(out.status.success());\n    let text = String::from_utf8_lossy(&out.stdout);\n    let suspicious: Vec<&str> = text\n        .lines()\n        .filter_map(|l| l.split_whitespace().next())\n        .filter(|n| {\n            // Anything that looks like it came from the translated library\n            // itself (BTAC1C2_*, call_predict, get_predict_func) must not be\n            // undefined.\n            n.starts_with(\"BTAC1C2\") || *n == \"call_predict\" || *n == \"get_predict_func\"\n        })\n        .collect();\n    assert!(\n        suspicious.is_empty(),\n        \"Rust .so has undefined project symbols: {suspicious:?}\"\n    );\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5544,"cache_read_input_tokens":45259,"cache_creation":{"ephemeral_5m_input_tokens":5544,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"98ae4e8c-bc9e-46da-bfdb-152524d2f32b","uuid":"37488244-f867-481d-aa3f-285c2d517f17","timestamp":"2026-09-05T06:40:15.739Z"}
