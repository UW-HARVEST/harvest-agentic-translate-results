{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_lislr43qy24mqbft4a32q4oscqry67abezrfegxxjhcrcqr6mdxa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01LsxMx6ikgK5R8WiQ24rc7a","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-6iQDjX/translation/tests/common/mod.rs","content":"//! Shared harness: loads BOTH the C `.so` and the Rust `.so` via `libloading`\n//! and calls their exported symbols. The Rust implementation is NEVER called\n//! directly as a Rust function — always through the dynamic library, exactly as\n//! an external C consumer would, so the `#[no_mangle]` wrapper is under test.\n\nuse std::path::PathBuf;\nuse std::process::Command;\n\npub struct Libs {\n    _c: libloading::Library,\n    _rust: libloading::Library,\n    c_call_predict: unsafe extern \"C\" fn(i32) -> i32,\n    rust_call_predict: unsafe extern \"C\" fn(i32) -> i32,\n}\n\nfn repo_root() -> PathBuf {\n    // CARGO_MANIFEST_DIR == <root>/translation\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n        .parent()\n        .expect(\"translation/ has a parent\")\n        .to_path_buf()\n}\n\n/// Build (if needed) and locate the C shared library.\nfn c_so_path() -> PathBuf {\n    let root = repo_root();\n    let c_src = root.join(\"c_src\");\n    let build = c_src.join(\"build\");\n\n    let find = || -> Option<PathBuf> {\n        let entries = std::fs::read_dir(&build).ok()?;\n        let mut found = None;\n        for e in entries.flatten() {\n            let p = e.path();\n            let name = p.file_name()?.to_string_lossy().to_string();\n            if name.starts_with(\"lib\") && name.ends_with(\".so\") {\n                found = Some(p);\n            }\n        }\n        found\n    };\n\n    if let Some(p) = find() {\n        return p;\n    }\n\n    std::fs::create_dir_all(&build).expect(\"create c_src/build\");\n    let st = Command::new(\"cmake\")\n        .current_dir(&build)\n        .args([\"..\", \"-DCMAKE_POSITION_INDEPENDENT_CODE=ON\"])\n        .status()\n        .expect(\"run cmake configure\");\n    assert!(st.success(), \"cmake configure failed\");\n    let st = Command::new(\"cmake\")\n        .current_dir(&build)\n        .args([\"--build\", \".\"])\n        .status()\n        .expect(\"run cmake build\");\n    assert!(st.success(), \"cmake build failed\");\n\n    find().expect(\"C .so produced in c_src/build\")\n}\n\n/// Locate the Rust cdylib. Builds it with the same profile the tests run under.\nfn rust_so_path() -> PathBuf {\n    let manifest = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n\n    // Walk up from the test executable to find the profile dir (…/target/<prof>).\n    let exe = std::env::current_exe().expect(\"test exe path\");\n    let mut dir = exe.parent().expect(\"exe parent\").to_path_buf();\n    if dir.file_name().map(|n| n == \"deps\").unwrap_or(false) {\n        dir.pop();\n    }\n\n    let candidate = dir.join(\"libcall_predict_lib.so\");\n    if candidate.exists() {\n        return candidate;\n    }\n\n    // Fall back to an explicit release build.\n    let st = Command::new(env!(\"CARGO\"))\n        .current_dir(&manifest)\n        .args([\"build\", \"--release\"])\n        .status()\n        .expect(\"cargo build\");\n    assert!(st.success(), \"cargo build --release failed\");\n    let rel = manifest.join(\"target/release/libcall_predict_lib.so\");\n    assert!(rel.exists(), \"rust cdylib not found at {rel:?}\");\n    rel\n}\n\nimpl Libs {\n    pub fn load() -> Libs {\n        let cp = c_so_path();\n        let rp = rust_so_path();\n        unsafe {\n            let c = libloading::Library::new(&cp)\n                .unwrap_or_else(|e| panic!(\"dlopen C lib {cp:?}: {e}\"));\n            let rust = libloading::Library::new(&rp)\n                .unwrap_or_else(|e| panic!(\"dlopen Rust lib {rp:?}: {e}\"));\n\n            let cf: libloading::Symbol<unsafe extern \"C\" fn(i32) -> i32> = c\n                .get(b\"call_predict\\0\")\n                .expect(\"C .so exports call_predict\");\n            let rf: libloading::Symbol<unsafe extern \"C\" fn(i32) -> i32> = rust\n                .get(b\"call_predict\\0\")\n                .expect(\"Rust .so exports call_predict\");\n            let c_call_predict = *cf;\n            let rust_call_predict = *rf;\n\n            Libs {\n                _c: c,\n                _rust: rust,\n                c_call_predict,\n                rust_call_predict,\n            }\n        }\n    }\n\n    #[inline]\n    pub fn c(&self, pfcn: i32) -> i32 {\n        unsafe { (self.c_call_predict)(pfcn) }\n    }\n\n    #[inline]\n    pub fn rust(&self, pfcn: i32) -> i32 {\n        unsafe { (self.rust_call_predict)(pfcn) }\n    }\n\n    /// Assert byte-identical results and return the shared value.\n    #[track_caller]\n    pub fn assert_same(&self, pfcn: i32) -> i32 {\n        let a = self.c(pfcn);\n        let b = self.rust(pfcn);\n        assert_eq!(\n            a, b,\n            \"divergence for call_predict({pfcn}): C returned {a}, Rust returned {b}\"\n        );\n        // Also compare the raw little-endian bytes of the returned int.\n        assert_eq!(\n            a.to_le_bytes(),\n            b.to_le_bytes(),\n            \"byte-level divergence for call_predict({pfcn})\"\n        );\n        a\n    }\n}\n\n/// Deterministic, fixed-seed PRNG (SplitMix64) so runs are reproducible.\npub struct Rng(u64);\n\nimpl Rng {\n    pub fn new(seed: u64) -> Rng {\n        Rng(seed)\n    }\n    pub fn next_u64(&mut self) -> u64 {\n        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);\n        let mut z = self.0;\n        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);\n        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);\n        z ^ (z >> 31)\n    }\n    pub fn next_i32(&mut self) -> i32 {\n        self.next_u64() as u32 as i32\n    }\n    /// Uniform in `lo..=hi`.\n    pub fn range(&mut self, lo: i32, hi: i32) -> i32 {\n        let span = (hi as i64 - lo as i64 + 1) as u64;\n        (lo as i64 + (self.next_u64() % span) as i64) as i32\n    }\n}\n\npub const SEED: u64 = 0x5EED_1234_ABCD_9876;\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":338,"cache_read_input_tokens":42293,"cache_creation":{"ephemeral_5m_input_tokens":338,"ephemeral_1h_input_tokens":0},"output_tokens":17,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"98ae4e8c-bc9e-46da-bfdb-152524d2f32b","uuid":"bdbbe68f-1533-4ec1-919d-4cb0ccd5d3b4","timestamp":"2026-09-05T06:39:07.217Z"}
