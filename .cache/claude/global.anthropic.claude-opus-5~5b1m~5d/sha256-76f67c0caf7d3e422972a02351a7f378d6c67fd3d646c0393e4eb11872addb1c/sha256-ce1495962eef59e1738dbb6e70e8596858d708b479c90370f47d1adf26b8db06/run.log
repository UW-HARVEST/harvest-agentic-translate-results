  set.insert(name.to_string());\n        }\n    }\n    set\n}\n\nfn nm_undefined_non_libc(path: &std::path::Path) -> Vec<String> {\n    let out = Command::new(\"nm\")\n        .args([\"-D\", \"--undefined-only\"])\n        .arg(path)\n        .output()\n        .expect(\"run nm\");\n    assert!(out.status.success());\n    let text = String::from_utf8_lossy(&out.stdout);\n    let mut v = Vec::new();\n    for line in text.lines() {\n        let mut it = line.split_whitespace();\n        let first = it.next().unwrap_or(\"\");\n        // weak symbols show as \"w <name>\", strong as \"U <name>\"\n        let (kind, name) = if first == \"U\" || first == \"w\" {\n            (first, it.next().unwrap_or(\"\"))\n        } else {\n            (it.next().unwrap_or(\"\"), it.next().unwrap_or(\"\"))\n        };\n        if kind != \"U\" {\n            continue; // weak/optional\n        }\n        let bare = name.split('@').next().unwrap_or(name);\n        v.push(bare.to_string());\n    }\n    v\n}\n\n/// Every symbol the C `.so` exports must also be exported by the Rust `.so`,\n/// with the exact same name.\n#[test]\nfn symbol_parity_c_so_vs_rust_so() {\n    let c = common::c_so_path();\n    let rs = common::rust_so_path();\n    let c_syms = nm_defined(&c);\n    let rs_syms = nm_defined(&rs);\n\n    let missing: Vec<&String> = c_syms.difference(&rs_syms).collect();\n    assert!(\n        missing.is_empty(),\n        \"Rust .so is missing {} symbol(s) exported by the C .so: {:?}\\nC:    {:?}\\nRust: {:?}\",\n        missing.len(),\n        missing,\n        c_syms,\n        rs_syms\n    );\n\n    // The nine documented API symbols must really be there (guards against a\n    // regression where `nm` output parsing silently yields an empty set).\n    for want in [\n        \"convert_pix\",\n        \"cp_inflate\",\n        \"cp_error_reason\",\n        \"cp_fixed_table\",\n        \"cp_permutation_order\",\n        \"cp_len_extra_bits\",\n        \"cp_len_base\",\n        \"cp_dist_extra_bits\",\n        \"cp_dist_base\",\n    ] {\n        assert!(c_syms.contains(want), \"C .so lost {want}\");\n        assert!(rs_syms.contains(want), \"Rust .so lost {want}\");\n    }\n}\n\n/// Neither object may reference a non-libc symbol it does not define.\n#[test]\nfn no_undefined_non_libc_symbols() {\n    let known_libc: &[&str] = &[\n        \"__assert_fail\",\n        \"calloc\",\n        \"free\",\n        \"malloc\",\n        \"realloc\",\n        \"memcmp\",\n        \"memcpy\",\n        \"memmove\",\n        \"memset\",\n        \"abort\",\n        \"__cxa_finalize\",\n        \"__errno_location\",\n        \"program_invocation_short_name\",\n        \"write\",\n        \"writev\",\n        \"__libc_start_main\",\n    ];\n    for path in [common::c_so_path(), common::rust_so_path()] {\n        for sym in nm_undefined_non_libc(&path) {\n            let ok = known_libc.contains(&sym.as_str())\n                // the Rust std library links a lot of libc/libgcc/pthread\n                || sym.starts_with(\"pthread_\")\n                || sym.starts_with(\"__pthread\")\n                || sym.starts_with(\"_Unwind_\")\n                || sym.starts_with(\"__tls_get_addr\")\n                || sym.starts_with(\"dl_\")\n                || sym.starts_with(\"__\")\n                || is_plain_libc(&sym);\n            assert!(ok, \"{}: unexpected undefined symbol {sym}\", path.display());\n        }\n    }\n}\n\nfn is_plain_libc(s: &str) -> bool {\n    // Anything lowercase without a namespace prefix that we know ships in\n    // libc/libm/libdl/libpthread.\n    const LIBC: &[&str] = &[\n        \"open\", \"open64\", \"close\", \"read\", \"readlink\", \"poll\", \"mmap\", \"munmap\", \"mprotect\",\n        \"sigaltstack\", \"sigaction\", \"sigemptyset\", \"sigaddset\", \"getcwd\", \"getenv\", \"syscall\",\n        \"sysconf\", \"strlen\", \"strerror_r\", \"getrandom\", \"dlsym\", \"dlopen\", \"dlclose\", \"dlerror\",\n        \"gettimeofday\", \"clock_gettime\", \"nanosleep\", \"pipe2\", \"dup2\", \"fork\", \"execvp\", \"waitpid\",\n        \"kill\", \"raise\", \"exit\", \"_exit\", \"atexit\", \"environ\", \"stderr\", \"stdout\", \"fwrite\",\n        \"fputs\", \"fflush\", \"memrchr\", \"bcmp\", \"posix_memalign\", \"aligned_alloc\", \"free\",\n        \"mremap\", \"madvise\", \"sched_yield\", \"prctl\", \"statx\", \"fstat\", \"lseek\", \"lseek64\",\n        \"unlink\", \"rename\", \"mkdir\", \"rmdir\", \"opendir\", \"readdir64\", \"closedir\", \"abort\",\n    ];\n    LIBC.contains(&s)\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_lljwluv2pehwgfjhvoqfou45puvc755s47dga4ewnoqiaumasokq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01AZ2VxYi9nfCVDTBV8p48A3","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-VVQnEx/translation/tests/globals.rs","content":"//! CONFIGS.md rows 1–7 and 41–44: the exported data symbols, and the effect of\n//! *tampering* with them (they are non-const globals in C, so they are part of\n//! the runtime configuration surface).\n\nmod common;\n\nuse common::*;\n\nfn read_u8s(p: &Pair, sym: &[u8], n: usize) -> (Vec<u8>, Vec<u8>) {\n    let a: *mut u8 = p.c.data(sym);\n    let b: *mut u8 = p.rs.data(sym);\n    unsafe {\n        (\n            std::slice::from_raw_parts(a, n).to_vec(),\n            std::slice::from_raw_parts(b, n).to_vec(),\n        )\n    }\n}\n\nfn read_u32s(p: &Pair, sym: &[u8], n: usize) -> (Vec<u32>, Vec<u32>) {\n    let a: *mut u32 = p.c.data(sym);\n    let b: *mut u32 = p.rs.data(sym);\n    unsafe {\n        (\n            std::slice::from_raw_parts(a, n).to_vec(),\n            std::slice::from_raw_parts(b, n).to_vec(),\n        )\n    }\n}\n\n// --- row 1 -----------------------------------------------------------------\n#[test]\nfn g01_fixed_table() {\n    let p = pair();\n    let (c, r) = read_u8s(&p, b\"cp_fixed_table\\0\", 288 + 32);\n    assert_eq!(c, r, \"cp_fixed_table differs\");\n    // and it really is the DEFLATE fixed table\n    assert_eq!(&c[..144], &[8u8; 144][..]);\n    assert_eq!(&c[144..256], &[9u8; 112][..]);\n    assert_eq!(&c[256..280], &[7u8; 24][..]);\n    assert_eq!(&c[280..288], &[8u8; 8][..]);\n    assert_eq!(&c[288..320], &[5u8; 32][..]);\n}\n\n// --- row 2 -----------------------------------------------------------------\n#[test]\nfn g02_permutation_order() {\n    let p = pair();\n    let (c, r) = read_u8s(&p, b\"cp_permutation_order\\0\", 19);\n    assert_eq!(c, r, \"cp_permutation_order differs\");\n    assert_eq!(\n        c,\n        vec![16u8, 17, 18, 0, 8, 7, 9, 6, 10, 5, 11, 4, 12, 3, 13, 2, 14, 1, 15]\n    );\n}\n\n// --- row 3 -----------------------------------------------------------------\n#[test]\nfn g03_len_extra_bits() {\n    let p = pair();\n    let (c, r) = read_u8s(&p, b\"cp_len_extra_bits\\0\", 29 + 2);\n    assert_eq!(c, r, \"cp_len_extra_bits differs\");\n}\n\n// --- row 4 -----------------------------------------------------------------\n#[test]\nfn g04_len_base() {\n    let p = pair();\n    let (c, r) = read_u32s(&p, b\"cp_len_base\\0\", 29 + 2);\n    assert_eq!(c, r, \"cp_len_base differs\");\n}\n\n// --- row 5 -----------------------------------------------------------------\n#[test]\nfn g05_dist_extra_bits() {\n    let p = pair();\n    let (c, r) = read_u8s(&p, b\"cp_dist_extra_bits\\0\", 30 + 2);\n    assert_eq!(c, r, \"cp_dist_extra_bits differs\");\n}\n\n// --- row 6 -----------------------------------------------------------------\n#[test]\nfn g06_dist_base() {\n    let p = pair();\n    let (c, r) = read_u32s(&p, b\"cp_dist_base\\0\", 30 + 2);\n    assert_eq!(c, r, \"cp_dist_base differs\");\n}\n\n// --- row 7 -----------------------------------------------------------------\n#[test]\nfn g07_error_reason_initially_null() {\n    let p = pair();\n    assert_eq!(p.c.error_reason(), None, \"C cp_error_reason not NULL at load\");\n    assert_eq!(p.rs.error_reason(), None, \"Rust cp_error_reason not NULL at load\");\n}\n\n// ---------------------------------------------------------------------------\n// tampering\n// ---------------------------------------------------------------------------\n\nstruct Saved<T: Copy> {\n    c: *mut T,\n    rs: *mut T,\n    n: usize,\n    old: Vec<T>,\n}\n\nimpl<T: Copy> Saved<T> {\n    fn new(p: &Pair, sym: &[u8], n: usize) -> Saved<T> {\n        let c: *mut T = p.c.data(sym);\n        let rs: *mut T = p.rs.data(sym);\n        let old = unsafe { std::slice::from_raw_parts(c, n).to_vec() };\n        let old_rs = unsafe { std::slice::from_raw_parts(rs, n).to_vec() };\n        let _ = &old_rs;\n        Saved { c, rs, n, old }\n    }\n    fn write(&self, v: &[T]) {\n        assert_eq!(v.len(), self.n);\n        unsafe {\n            std::ptr::copy_nonoverlapping(v.as_ptr(), self.c, self.n);\n            std::ptr::copy_nonoverlapping(v.as_ptr(), self.rs, self.n);\n        }\n    }\n}\n\nimpl<T: Copy> Drop for Saved<T> {\n    fn drop(&mut self) {\n        unsafe {\n            std::ptr::copy_nonoverlapping(self.old.as_ptr(), self.c, self.n);\n            std::ptr::copy_nonoverlapping(self.old.as_ptr(), self.rs, self.n);\n        }\n    }\n}\n\n/// CONFIGS row 41: swap `cp_fixed_table` for a different, still-valid\n/// (`len < 16`) assignment and decode a BTYPE=1 block through it.\n#[test]\nfn g08_tamper_fixed_table() {\n    let p = pair();\n    // A complete tree over all 288 literal symbols with a different shape:\n    // 32 symbols of length 8 and 256 of length 9 => Kraft = 32/256 + 256/512 = 1\n    let mut lit = vec![9u8; 288];\n    for i in 0..32 {\n        lit[i] = 8;\n    }\n    // distances: 32 codes of 5 bits (unchanged shape but let's use 16x4 + 32x6?)\n    // keep 5 bits so distances stay decodable\n    let dst = vec![5u8; 32];\n\n    let mut table = Vec::with_capacity(320);\n    table.extend_from_slice(&lit);\n    table.extend_from_slice(&dst);\n\n    let saved = Saved::<u8>::new(&p, b\"cp_fixed_table\\0\", 320);\n    saved.write(&table);\n\n    let lit_h = Huff::new(lit.clone());\n    let dst_h = Huff::new(dst.clone());\n\n    let mut rng = Rng::new(SEED ^ 0xF1);\n    for case in 0..64 {\n        let n = rng.below(40) as usize;\n        let items: Vec<Item> = (0..n).map(|_| Item::Lit(rng.u8())).collect();\n        let mut w = BitWriter::new();\n        w.bit(1);\n        w.bits_lsb(1, 2);\n        write_items(&mut w, &lit_h, &dst_h, &items);\n        let mut stream = w.bytes.clone();\n        stream.extend_from_slice(&[0u8; 4]);\n        let mut expect = Vec::new();\n        expand(&items, &mut expect);\n        diff_inflate_expect(&p, &stream, &expect, &format!(\"g08/case{case}\"));\n    }\n    drop(saved);\n\n    // and the tables really were restored\n    let (c, r) = read_u8s(&p, b\"cp_fixed_table\\0\", 320);\n    assert_eq!(c, r);\n    assert_eq!(&c[..144], &[8u8; 144][..]);\n}\n\n/// CONFIGS row 42: tamper `cp_len_base` / `cp_len_extra_bits`.\n#[test]\nfn g09_tamper_len_tables() {\n    let p = pair();\n    let saved_base = Saved::<u32>::new(&p, b\"cp_len_base\\0\", 31);\n    let saved_extra = Saved::<u8>::new(&p, b\"cp_len_extra_bits\\0\", 31);\n\n    // Every length symbol becomes \"base 4 + 1 extra bit\" => lengths 4 or 5.\n    let base = vec![4u32; 31];\n    let extra = vec![1u8; 31];\n    saved_base.write(&base);\n    saved_extra.write(&extra);\n\n    let lit_h = Huff::new(fixed_lit_lens());\n    let dst_h = Huff::new(fixed_dist_lens());\n\n    let mut rng = Rng::new(SEED ^ 0xF2);\n    for case in 0..48 {\n        // seed 8 literals, then a match: raw symbol index + explicit extra\n        let mut items: Vec<Item> = (0..8).map(|_| Item::Lit(rng.u8())).collect();\n        let len_idx = rng.below(29) as usize;\n        let len_extra = rng.below(2);\n        let dist_idx = rng.below(3) as usize; // dist 1..4, all 0 extra bits\n        items.push(Item::RawMatch { len_idx, len_extra, dist_idx, dist_extra: 0 });\n\n        let mut w = BitWriter::new();\n        w.bit(1);\n        w.bits_lsb(1, 2);\n        write_items(&mut w, &lit_h, &dst_h, &items);\n        let mut stream = w.bytes.clone();\n        stream.extend_from_slice(&[0u8; 4]);\n\n        // model with the tampered tables\n        let mut expect: Vec<u8> = Vec::new();\n        for it in &items {\n            match *it {\n                Item::Lit(b) => expect.push(b),\n                Item::RawMatch { len_extra, dist_idx, .. } => {\n                    let length = 4 + len_extra;\n                    let dist = DIST_BASE[dist_idx];\n        