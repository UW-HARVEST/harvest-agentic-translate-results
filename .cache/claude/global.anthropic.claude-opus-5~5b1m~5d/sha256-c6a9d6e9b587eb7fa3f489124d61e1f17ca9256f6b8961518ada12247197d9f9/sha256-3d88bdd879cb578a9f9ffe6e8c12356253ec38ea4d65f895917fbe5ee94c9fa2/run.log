obe < map->capacity) {\n119\t        size_t current = (index + probe) % map->capacity;\n120\t        \n121\t        if (!map->entries[current].occupied) {\n122\t            // Empty slot\n123\t            map->entries[current].key = key;\n124\t            map->entries[current].value = value;\n125\t            map->entries[current].occupied = 1;\n126\t            map->entries[current].deleted = 0;\n127\t            map->size++;\n128\t            return 0;\n129\t        } else if (map->entries[current].deleted) {\n130\t            // Reuse deleted slot\n131\t            map->entries[current].key = key;\n132\t            map->entries[current].value = value;\n133\t            map->entries[current].deleted = 0;\n134\t            map->size++;\n135\t            map->deleted_count--;\n136\t            return 0;\n137\t        } else if (map->entries[current].key == key) {\n138\t            // Update existing\n139\t            map->entries[current].value = value;\n140\t            return 0;\n141\t        }\n142\t        \n143\t        probe++;\n144\t    }\n145\t    \n146\t    return -1; // Map is full (shouldn't happen with resizing)\n147\t}\n148\t\n149\tvoid* hashmap_get(hashmap_t *map, tree_id_t key) {\n150\t    if (!map) {\n151\t        return NULL;\n152\t    }\n153\t    \n154\t    uint64_t hash = hash_function(key);\n155\t    size_t index = hash % map->capacity;\n156\t    size_t probe = 0;\n157\t    \n158\t    while (probe < map->capacity) {\n159\t        size_t current = (index + probe) % map->capacity;\n160\t        \n161\t        if (!map->entries[current].occupied) {\n162\t            return NULL;\n163\t        }\n164\t        \n165\t        if (!map->entries[current].deleted && map->entries[current].key == key) {\n166\t            return map->entries[current].value;\n167\t        }\n168\t        \n169\t        probe++;\n170\t    }\n171\t    \n172\t    return NULL;\n173\t}\n174\t\n175\tvoid* hashmap_remove(hashmap_t *map, tree_id_t key) {\n176\t    if (!map) {\n177\t 