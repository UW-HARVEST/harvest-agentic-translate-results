te_flags_t)  dlsym(h, \"update_flags\");\n    f_confuse_types  = (confuse_types_t) dlsym(h, \"confuse_types\");\n    f_confusion      = (confusion_t)     dlsym(h, \"confusion\");\n    if (!f_create_state || !f_destroy_state || !f_process_buffer ||\n        !f_update_flags || !f_confuse_types || !f_confusion) {\n        fprintf(stderr, \"missing symbol\\n\"); return 1;\n    }\n\n    /* ---------- 1. confusion() over a wide parameter sweep ---------- */\n    static const int vals[] = {\n        0, 1, 2, 3, 4, 5, 7, 8, 9, 10, 11, 12, 15, 16, 23, 31, 42, 63, 64, 99,\n        100, 123, 127, 128, 255, 256, 999, 1000, 12345, 65535, 65536,\n        1000000, 1078530011, 2139095040, 2143289344, 2139095039, 1325400064,\n        INT_MAX, INT_MIN, -1, -2, -3, -4, -5, -7, -8, -9, -10, -42, -128,\n        -1000, -12345, -1000000, -2139095040, INT_MIN + 1\n    };\n    const int n = (int)(sizeof(vals) / sizeof(vals[0]));\n    for (int i = 0; i < n; i++) {\n        for (int k = 0; k < 8; k++) {\n            int a = vals[i];\n            int b = vals[(i + k) % n];\n            int c = vals[(i + 2 * k + 1) % n];\n            int d = vals[(i + 3 * k + 2) % n];\n            printf(\"--- confusion(%d,%d,%d,%d) ---\\n\", a, b, c, d);\n            printf(\"=> %d\\n\", f_confusion(a, b, c, d));\n        }\n    }\n    /* every param4 % 4 branch against every interesting bit pattern */\n    for (int i = 0; i < n; i++) {\n        for (int d = -8; d <= 8; d++) {\n            printf(\"--- confusion(%d,%d,%d,%d) ---\\n\", vals[i], i, i, d);\n            printf(\"=> %d\\n\", f_confusion(vals[i], i, i, d));\n        }\n    }\n\n    /* ---------- 2. create_state / process_buffer / destroy_state ---------- */\n    static const int caps[] = {1, 2, 3, 4, 5, 6, 7, 8, 12, 15, 16, 17, 32, 64, 128, 4096};\n    for (int ci = 0; ci < (int)(sizeof(caps) / sizeof(caps[0])); ci++) {\n        for (int i = 0; i < n; i++) {\n            void* s = f_create_state(vals[i], caps[ci]);\n            printf(\"--- create_state(%d,%d) ---\\n\", vals[i], caps[ci]);\n            dump_state(\"state:\", s);\n            for (int t = 0; t < 128; t++) {\n                int r = f_process_buffer(s, (char)t);\n                if (r != 0) printf(\"process_buffer('%c'=%d) => %d\\n\", t ? t : ' ', t, r);\n            }\n            /* negative / high-bit char targets */\n            for (int t = -128; t < 0; t++) {\n                int r = f_process_buffer(s, (char)t);\n                if (r != 0) printf(\"process_buffer(%d) => %d\\n\", t, r);\n            }\n            f_destroy_state(s);\n        }\n    }\n\n    /* ---------- 3. update_flags: counter wrap-around + all bit patterns ---------- */\n    for (int i = 0; i < n; i++) {\n        void* s = f_create_state(vals[i], 64);\n        printf(\"--- update_flags sweep on create_state(%d,64) ---\\n\", vals[i]);\n        for (int p = -40; p <= 80; p++) {\n            f_update_flags(s, p);\n            dump_state(\"after:\", s);\n        }\n        for (int j = 0; j < n; j++) {\n            f_update_flags(s, vals[j]);\n            dump_state(\"afterv:\", s);\n        }\n        f_destroy_state(s);\n    }\n\n    /* ---------- 4. confuse_types: all operations incl. out-of-range ---------- */\n    for (int i = 0; i < n; i++) {\n        for (int op = -6; op <= 6; op++) {\n            void* s = f_create_state(vals[i], 48);\n            printf(\"--- confuse_types(create_state(%d,48), %d) ---\\n\", vals[i], op);\n            printf(\"=> %d\\n\", f_confuse_types(s, op));\n            dump_state(\"after:\", s);\n            /* repeat on the mutated state */\n            printf(\"=> %d\\n\", f_confuse_types(s, op));\n            dump_state(\"after2:\", s);\n            f_destroy_state(s);\n        }\n    }\n\n    /* ---------- 5. NULL / error paths ---------- */\n    printf(\"--- null paths ---\\n\");\n    f_destroy_state(NULL);\n    f_update_flags(NULL, 12345);\n    printf(\"process_buffer(NULL,'x') => %d\\n\", f_process_buffer(NULL, 'x'));\n    printf(\"confuse_types(NULL,0) => %d\\n\", f_confuse_types(NULL, 0));\n    printf(\"confuse_types(NULL,1) => %d\\n\", f_confuse_types(NULL, 1));\n    printf(\"confuse_types(NULL,99) => %d\\n\", f_confuse_types(NULL, 99));\n\n    /* state whose buffer pointer was cleared -> process_buffer error branch */\n    void* s = f_create_state(7, 32);\n    char* saved;\n    memcpy(&saved, (unsigned char*)s + 8, 8);\n    char* nul = NULL;\n    memcpy((unsigned char*)s + 8, &nul, 8);\n    printf(\"process_buffer(buffer=NULL) => %d\\n\", f_process_buffer(s, '7'));\n    memcpy((unsigned char*)s + 8, &saved, 8);\n    f_destroy_state(s);\n\n    /* negative capacity -> malloc failure branch */\n    printf(\"--- negative capacity ---\\n\");\n    void* bad = f_create_state(5, -1);\n    printf(\"create_state(5,-1) => %s\\n\", bad == NULL ? \"NULL\" : \"non-null\");\n    printf(\"confusion via negative not applicable\\n\");\n\n    fflush(stdout);\n    dlclose(h);\n    return 0;\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":686,"cache_read_input_tokens":40003,"cache_creation":{"ephemeral_5m_input_tokens":686,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"b23cc87c-0104-4562-92e8-6d894aad26b8","uuid":"af0ce62d-f2dd-408b-874e-9707cc530532","timestamp":"2026-08-27T23:49:27.858Z"}
