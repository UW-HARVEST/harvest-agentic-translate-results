 c_char {\n82\t    let s = unsafe { malloc(64 * core::mem::size_of::<c_char>()) } as *mut c_char;\n83\t    if s.is_null() {\n84\t        return ptr::null_mut();\n85\t    }\n86\t    unsafe {\n87\t        snprintf(s, 64, c\"Operation: %s, Value: %d\".as_ptr(), op, val);\n88\t    }\n89\t    s\n90\t}\n91\t\n92\t// int check_permissions(int perms, int required)\n93\t#[unsafe(no_mangle)]\n94\tpub extern \"C\" fn check_permissions(perms: c_int, required: c_int) -> c_int {\n95\t    ((perms & required) == required) as c_int\n96\t}\n97\t\n98\t// int safe_add(int a, int b, int perms)\n99\t#[unsafe(no_mangle)]\n100\tpub extern \"C\" fn safe_add(a: c_int, b: c_int, perms: c_int) -> c_int {\n101\t    if check_permissions(perms, READ_PERM | WRITE_PERM) == 0 {\n102\t        unsafe {\n103\t            printf(c\"Insufficient permissions for addition\\n\".as_ptr());\n104\t        }\n105\t        return 0;\n106\t    }\n107\t    a.wrapping_add(b)\n108\t}\n109\t\n110\t// int multiply_with_log(int a, int b, char** log_msg)\n111\t#[unsafe(no_mangle)]\n112\tpub unsafe extern \"C\" fn multiply_with_log(\n113\t    a: c_int,\n114\t    b: c_int,\n115\t    log_msg: *mut *mut c_char,\n116\t) -> c_int {\n117\t    // The C code dereferences `log_msg` unconditionally, with no NULL check.\n118\t    unsafe {\n119\t        *log_msg = create_result_string(c\"multiply\".as_ptr(), a.wrapping_mul(b));\n120\t        if (*log_msg).is_null() {\n121\t            return 0;\n122\t        }\n123\t    }\n124\t    a.wrapping_mul(b)\n125\t}\n126\t\n127\t// int copy_and_sum(int* src, int count)\n128\t#[unsafe(no_mangle)]\n129\tpub unsafe extern \"C\" fn copy_and_sum(src: *mut c_int, count: c_int) -> c_int {\n130\t    if src.is_null() {\n131\t        unsafe {\n132\t            printf(c\"Source pointer is NULL\\n\".as_ptr());\n133\t        }\n134\t        return -1;\n135\t    }\n136\t\n137\t    // `count * sizeof(int)`: `count` is sign-extended to size_t, then the\n138\t    // product wraps modulo 2^64 exactly as it does in C.\n139\t    let nbytes = (count as isize as usize).wrapping_mul(core::mem::size_of::<c_int>());\n140\t\n141\t    let dest = unsafe { malloc(nbytes) } as *mut c_int;\n142\t    if dest.is_null() {\n143\t        unsafe {\n144\t            printf(c\"Memory allocation failed\\n\".as_ptr());\n145\t        }\n146\t        return -1;\n147\t    }\n148\t\n149\t    unsafe {\n150\t        memcpy(dest as *mut c_void, src as *const c_void, nbytes);\n151\t    }\n152\t\n153\t    let mut sum: c_int = 0;\n154\t    let mut i: c_int = 0;\n155\t    while i < count {\n156\t        sum = sum.wrapping_add(unsafe { *dest.offset(i as isize) });\n157\t        i = i.wrapping_add(1);\n158\t    }\n159\t\n160\t    unsafe {\n161\t        free(dest as *mut c_void);\n162\t    }\n163\t    sum\n164\t}\n165\t\n166\t// int compare_operations(const char* op1, const char* op2)\n167\t#[unsafe(no_mangle)]\n168\tpub unsafe extern \"C\" fn compare_operations(op1: *const c_char, op2: *const c_char) -> c_int {\n169\t    if op1.is_null() || op2.is_null() {\n170\t        unsafe {\n171\t            printf(c\"One or both operation strings are NULL\\n\".as_ptr());\n172\t        }\n173\t        return -1;\n174\t    }\n175\t\n176\t    unsafe { strcmp(op1, op2) }\n177\t}\n178\t\n179\t// int complexmode(int mode, int value1, int value2, int value3)\n180\t//\n181\t// `result` is initialized to 0 and then overwritten in every switch arm, just\n182\t// as in the C source; the dead initial store is kept for faithfulness.\n183\t#[allow(unused_assignments)]\n184\t#[unsafe(no_mangle)]\n185\tpub extern \"C\" fn complexmode(\n186\t    mode: c_int,\n187\t    value1: c_int,\n188\t    value2: c_int,\n189\t    value3: c_int,\n190\t) -> c_int {\n191\t    let mut result: c_int = 0;\n192\t    let mut log_message: *mut c_char = ptr::null_mut();\n193\t\n194\t    let permissions: c_int = 0o644; // rw-r--r--\n195\t\n196\t    let res_tracker = unsafe { malloc(core::mem::size_of::<Result>()) } as *mut Result;\n197\t    if res_tracker.