e":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":255,"cache_read_input_tokens":21556,"cache_creation":{"ephemeral_5m_input_tokens":255,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"4c86e1b4-cb9f-42f8-ab23-94101baea11a","uuid":"d488ae2a-bfb5-4532-9151-0fc89a14fdaf","timestamp":"2026-08-28T16:31:07.627Z"}
