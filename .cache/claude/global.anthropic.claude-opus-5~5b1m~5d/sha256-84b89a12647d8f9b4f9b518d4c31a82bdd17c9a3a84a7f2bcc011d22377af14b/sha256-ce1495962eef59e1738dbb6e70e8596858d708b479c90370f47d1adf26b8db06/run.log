{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01PN5fFgvj7vC1t5AFNHtyW7","type":"tool_result","content":"1\t//! Shared differential-test harness.\n2\t//!\n3\t//! Loads BOTH the C `liblz4.so` and the Rust `liblz4.so` via `libloading` and\n4\t//! exposes them as a pair. Tests must never call Rust functions directly: every\n5\t//! call goes through a `.so` export so the `#[no_mangle]` wrappers are covered.\n6\t#![allow(dead_code)]\n7\t#![allow(non_snake_case)]\n8\t#![allow(non_camel_case_types)]\n9\t\n10\tuse libloading::{Library, Symbol};\n11\tuse std::os::raw::{c_char, c_int, c_uint, c_void};\n12\tuse std::path::PathBuf;\n13\t\n14\t// ---------------------------------------------------------------------------\n15\t// Library pair\n16\t// ---------------------------------------------------------------------------\n17\t\n18\tpub struct Pair {\n19\t    pub c: Library,\n20\t    pub r: Library,\n21\t}\n22\t\n23\tfn manifest() -> PathBuf {\n24\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n25\t}\n26\t\n27\tfn c_so() -> PathBuf {\n28\t    manifest().join(\"..\").join(\"c_src\").join(\"build\").join(\"liblz4.so\")\n29\t}\n30\t\n31\tfn rust_so() -> PathBuf {\n32\t    // Prefer the release cdylib; fall back to debug if that is what exists.\n33\t    let rel = manifest().join(\"target\").join(\"release\").join(\"liblz4.so\");\n34\t    if rel.exists() {\n35\t        return rel;\n36\t    }\n37\t    manifest().join(\"target\").join(\"debug\").join(\"liblz4.so\")\n38\t}\n39\t\n40\timpl Pair {\n41\t    pub fn load() -> Pair {\n42\t        let c = c_so();\n43\t        let r = rust_so();\n44\t        assert!(c.exists(), \"C shared library not built: {}\", c.display());\n45\t        assert!(r.exists(), \"Rust shared library not built: {}\", r.display());\n46\t        unsafe {\n47\t            Pair {\n48\t                c: Library::new(&c).expect(\"dlopen C liblz4.so\"),\n49\t                r: Library::new(&r).expect(\"dlopen Rust liblz4.so\"),\n50\t            }\n51\t        }\n52\t    }\n53\t\n54\t    /// Look up `name` in both libraries, returning `(c_fn, rust_fn)`.\n55\t    pub unsafe fn sym<T>(&self, name: &str) -> (Symbol<'_, T>, Symbol<'_, T>) {\n56\t        let cs: Symbol<T> = self\n57\t            .c\n58\t            .get(name.as_bytes())\n59\t            .unwrap_or_else(|e| panic!(\"C .so missing symbol {name}: {e}\"));\n60\t        let rs: Symbol<T> = self\n61\t            .r\n62\t            .get(name.as_bytes())\n63\t            .unwrap_or_else(|e| panic!(\"Rust .so missing symbol {name}: {e}\"));\n64\t        (cs, rs)\n65\t    }\n66\t\n67\t    pub fn has(&self, name: &str) -> (bool, bool) {\n68\t        unsafe {\n69\t            let a = self.c.get::<*const c_void>(name.as_bytes()).is_ok();\n70\t            let b = self.r.get::<*const c_void>(name.as_bytes()).is_ok();\n71\t            (a, b)\n72\t        }\n73\t    }\n74\t}\n75\t\n76\t/// Process-wide lazily-initialised pair, so each test binary dlopens once.\n77\tpub fn libs() -> &'static Pair {\n78\t    use std::sync::OnceLock;\n79\t    static P: OnceLock<Pair> = OnceLock::new();\n80\t    P.get_or_init(Pair::load)\n81\t}\n82\t\n83\t// ---------------------------------------------------------------------------\n84\t// Deterministic PRNG (xorshift64*) — fixed seeds keep every test reproducible.\n85\t// ---------------------------------------------------------------------------\n86\t\n87\tpub struct Rng(u64);\n88\t\n89\timpl Rng {\n90\t    pub fn new(seed: u64) -> Rng {\n91\t        Rng(if seed == 0 { 0x9E3779B97F4A7C15 } else { seed })\n92\t    }\n93\t    pub fn next_u64(&mut self) -> u64 {\n94\t        let mut x = self.0;\n95\t        x ^= x >> 12;\n96\t        x ^= x << 25;\n97\t        x ^= x >> 27;\n98\t        self.0 = x;\n99\t        x.wrapping_mul(0x2545F4914F6CDD1D)\n100\t    }\n101\t    pub fn next_u32(&mut self) -> u32 {\n102\t        (self.next_u64() >> 32) as u32\n103\t    }\n104\t    pub fn below(&mut self, n: usize) -> usize {\n105\t        if n == 0 {\n106\t            0\n107\t        } else {\n108\t            (self.next_u64() % n as u64) as usize\n109\t        }\n110\t    }\n111\t    pub fn range(&mut self, lo: usize, hi_inclusive: usize) -> usize {\n112\t        if hi_inclusive <= lo {\n113\t            lo\n114\t        } else {\n115\t            lo + self.below(hi_inclusive - lo + 1)\n116\t        }\n117\t    }\n118\t    pub fn byte(&mut self) -> u8 {\n119\t        (self.next_u64() >> 56) as u8\n120\t    }\n121\t}\n122\t\n123\t// ---------------------------------------------------------------------------\n124\t// Input-shape generators — these drive the \"input shape\" axis of CONFIGS.md.\n125\t// ---------------------------------------------------------------------------\n126\t\n127\t/// Pure random bytes: essentially incompressible.\n128\tpub fn gen_incompressible(rng: &mut Rng, len: usize) -> Vec<u8> {\n129\t    (0..len).map(|_| rng.byte()).collect()\n130\t}\n131\t\n132\t/// Highly compressible: long runs of a small number of distinct bytes.\n133\tpub fn gen_compressible(rng: &mut Rng, len: usize) -> Vec<u8> {\n134\t    let mut v = Vec::with_capacity(len);\n135\t    while v.len() < len {\n136\t        let b = rng.byte() & 0x07;\n137\t        let run = rng.range(1, 300);\n138\t        for _ in 0..run {\n139\t            if v.len() == len {\n140\t                break;\n141\t            }\n142\t            v.push(b);\n143\t        }\n144\t    }\n145\t    v\n146\t}\n147\t\n148\t/// Text-like data with repeated tokens: realistic mid-ratio input, good at\n149\t/// exercising match finding / hash chains.\n150\tpub fn gen_textlike(rng: &mut Rng, len: usize) -> Vec<u8> {\n151\t    const WORDS: &[&str] = &[\n152\t        \"the \", \"quick \", \"brown \", \"fox \", \"jumps \", \"over \", \"lazy \", \"dog \",\n153\t        \"lz4 \", \"compression \", \"block \", \"frame \", \"stream \", \"dictionary \",\n154\t        \"hash \", \"match \", \"literal \", \"offset \", \"checksum \", \"buffer \",\n155\t    ];\n156\t    let mut v = Vec::with_capacity(len + 32);\n157\t    while v.len() < len {\n158\t        v.extend_from_slice(WORDS[rng.below(WORDS.len())].as_bytes());\n159\t    }\n160\t    v.truncate(len);\n161\t    v\n162\t}\n163\t\n164\t/// Data with a long periodic pattern — hits `LZ4HC` pattern analysis and\n165\t/// `memcpy_using_offset` small-offset paths in the decoder.\n166\tpub fn gen_periodic(rng: &mut Rng, len: usize) -> Vec<u8> {\n167\t    let period = rng.range(1, 8);\n168\t    let base: Vec<u8> = (0..period).map(|_| rng.byte()).collect();\n169\t    (0..len).map(|i| base[i % period]).collect()\n170\t}\n171\t\n172\t/// A handful of near-degenerate shapes: all-zero, all-same, ascending.\n173\tpub fn gen_degenerate(rng: &mut Rng, len: usize) -> Vec<u8> {\n174\t    match rng.below(3) {\n175\t        0 => vec![0u8; len],\n176\t        1 => vec![rng.byte(); len],\n177\t        _ => (0..len).map(|i| (i & 0xFF) as u8).collect(),\n178\t    }\n179\t}\n180\t\n181\t#[derive(Copy, Clone, Debug, PartialEq, Eq)]\n182\tpub enum Shape {\n183\t    Incompressible,\n184\t    Compressible,\n185\t    TextLike,\n186\t    Periodic,\n187\t    Degenerate,\n188\t}\n189\t\n190\tpub const ALL_SHAPES: [Shape; 5] = [\n191\t    Shape::Incompressible,\n192\t    Shape::Compressible,\n193\t    Shape::TextLike,\n194\t    Shape::Periodic,\n195\t    Shape::Degenerate,\n196\t];\n197\t\n198\tpub fn gen(rng: &mut Rng, shape: Shape, len: usize) -> Vec<u8> {\n199\t    match shape {\n200\t        Shape::Incompressible => gen_incompressible(rng, len),\n201\t        Shape::Compressible => gen_compressible(rng, len),\n202\t        Shape::TextLike => gen_textlike(rng, len),\n203\t        Shape::Periodic => gen_periodic(rng, len),\n204\t        Shape::Degenerate => gen_degenerate(rng, len),\n205\t    }\n206\t}\n207\t\n208\t/// Sizes that matter: tiny values, `LZ4_minLength`, the byU16/byU32 table\n209\t/// pivot at `LZ4_64Klimit == 65547`, and the frame block-size boundaries.\n210\tpub fn interesting