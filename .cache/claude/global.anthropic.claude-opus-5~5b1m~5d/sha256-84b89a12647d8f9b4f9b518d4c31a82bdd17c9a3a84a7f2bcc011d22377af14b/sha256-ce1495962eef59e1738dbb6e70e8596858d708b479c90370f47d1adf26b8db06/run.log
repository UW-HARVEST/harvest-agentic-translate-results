{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01CNnVUzp6m1Nwf6bVAzpQBS","type":"tool_result","content":"1\t//! Differential tests for the stdio `FILE*` API in lz4file.c.\n2\t//!\n3\t//! Covers CONFIGS.md rows 157..162 (\"lz4file\") and the `## lz4file.c (stdio\n4\t//! file API)` rows of ERRORS.md (160..184).\n5\t//!\n6\t//! Every call goes through a `.so` export via libloading. The C library and\n7\t//! the Rust library always get their OWN scratch file, their OWN `FILE*` and\n8\t//! their OWN opaque `LZ4_readFile_t` / `LZ4_writeFile_t` handle (created and\n9\t//! destroyed by the same library); only the resulting *file bytes* and the\n10\t//! *return values* are compared.\n11\t#![allow(unused_imports, non_snake_case)]\n12\t\n13\tmod common;\n14\tuse common::*;\n15\tuse std::ffi::CString;\n16\tuse std::os::raw::{c_char, c_int, c_long, c_uint, c_void};\n17\tuse std::path::{Path, PathBuf};\n18\tuse std::ptr;\n19\tuse std::sync::atomic::{AtomicU64, Ordering};\n20\t\n21\t// ---------------------------------------------------------------------------\n22\t// libc stdio (linked from the process's own libc)\n23\t// ---------------------------------------------------------------------------\n24\t\n25\tunsafe extern \"C\" {\n26\t    fn fopen(path: *const c_char, mode: *const c_char) -> *mut c_void;\n27\t    fn fclose(f: *mut c_void) -> c_int;\n28\t    fn fflush(f: *mut c_void) -> c_int;\n29\t    fn fseek(f: *mut c_void, off: c_long, whence: c_int) -> c_int;\n30\t    fn ftell(f: *mut c_void) -> c_long;\n31\t    fn fread(p: *mut c_void, sz: usize, n: usize, f: *mut c_void) -> usize;\n32\t    fn fwrite(p: *const c_void, sz: usize, n: usize, f: *mut c_void) -> usize;\n33\t    fn setvbuf(f: *mut c_void, buf: *mut c_char, mode: c_int, size: usize) -> c_int;\n34\t    fn fmemopen(buf: *mut c_void, size: usize, mode: *const c_char) -> *mut c_void;\n35\t}\n36\t\n37\tconst SEEK_SET: c_int = 0;\n38\tconst SEEK_END: c_int = 2;\n39\tconst IONBF: c_int = 2;\n40\t\n41\t// ---------------------------------------------------------------------------\n42\t// lz4file FFI signatures\n43\t// ---------------------------------------------------------------------------\n44\t\n45\ttype FnWriteOpen =\n46\t    unsafe extern \"C\" fn(*mut *mut c_void, *mut c_void, *const LZ4F_preferences_t) -> usize;\n47\ttype FnWrite = unsafe extern \"C\" fn(*mut c_void, *const c_void, usize) -> usize;\n48\ttype FnReadOpen = unsafe extern \"C\" fn(*mut *mut c_void, *mut c_void) -> usize;\n49\ttype FnRead = unsafe extern \"C\" fn(*mut c_void, *mut c_void, usize) -> usize;\n50\ttype FnClose = unsafe extern \"C\" fn(*mut c_void) -> usize;\n51\t\n52\t#[derive(Copy, Clone)]\n53\tstruct FileApi {\n54\t    tag: &'static str,\n55\t    wopen: FnWriteOpen,\n56\t    write: FnWrite,\n57\t    wclose: FnClose,\n58\t    ropen: FnReadOpen,\n59\t    read: FnRead,\n60\t    rclose: FnClose,\n61\t}\n62\t\n63\tmacro_rules! pair {\n64\t    ($l:expr, $t:ty, $n:expr) => {{\n65\t        let (a, b) = $l.sym::<$t>($n);\n66\t        (*a, *b)\n67\t    }};\n68\t}\n69\t\n70\tunsafe fn apis() -> (FileApi, FileApi) {\n71\t    let l = libs();\n72\t    // Paranoia: the two libraries must really be two distinct code objects.\n73\t    {\n74\t        let (a, b) = l.sym::<FnWriteOpen>(\"LZ4F_writeOpen\");\n75\t        assert_ne!(\n76\t            *a as usize, *b as usize,\n77\t            \"harness bug: LZ4F_writeOpen resolved to the same address in both libraries\"\n78\t        );\n79\t    }\n80\t    let (wo_c, wo_r) = pair!(l, FnWriteOpen, \"LZ4F_writeOpen\");\n81\t    let (w_c, w_r) = pair!(l, FnWrite, \"LZ4F_write\");\n82\t    let (wc_c, wc_r) = pair!(l, FnClose, \"LZ4F_writeClose\");\n83\t    let (ro_c, ro_r) = pair!(l, FnReadOpen, \"LZ4F_readOpen\");\n84\t    let (rd_c, rd_r) = pair!(l, FnRead, \"LZ4F_read\");\n85\t    let (rc_c, rc_r) = pair!(l, FnClose, \"LZ4F_readClose\");\n86\t    (\n87\t        FileApi {\n88\t            tag: \"C\",\n89\t            wopen: wo_c,\n90\t            write: w_c,\n91\t            wclose: wc_c,\n92\t            ropen: ro_c,\n93\t            read: rd_c,\n94\t            rclose: rc_c,\n95\t        },\n96\t        FileApi {\n97\t            tag: \"Rust\",\n98\t            wopen: wo_r,\n99\t            write: w_r,\n100\t            wclose: wc_r,\n101\t            ropen: ro_r,\n102\t            read: rd_r,\n103\t            rclose: rc_r,\n104\t        },\n105\t    )\n106\t}\n107\t\n108\t// ---------------------------------------------------------------------------\n109\t// Scratch files\n110\t// ---------------------------------------------------------------------------\n111\t\n112\tstatic COUNTER: AtomicU64 = AtomicU64::new(0);\n113\t\n114\tstruct Scratch {\n115\t    path: PathBuf,\n116\t}\n117\t\n118\timpl Scratch {\n119\t    fn new(tag: &str) -> Scratch {\n120\t        let n = COUNTER.fetch_add(1, Ordering::SeqCst);\n121\t        let mut p = std::env::temp_dir();\n122\t        p.push(format!(\"lz4file_test_{}_{}_{}.lz4\", std::process::id(), tag, n));\n123\t        let _ = std::fs::remove_file(&p);\n124\t        Scratch { path: p }\n125\t    }\n126\t    fn path(&self) -> &Path {\n127\t        &self.path\n128\t    }\n129\t    fn bytes(&self) -> Vec<u8> {\n130\t        std::fs::read(&self.path).unwrap_or_default()\n131\t    }\n132\t}\n133\t\n134\timpl Drop for Scratch {\n135\t    fn drop(&mut self) {\n136\t        let _ = std::fs::remove_file(&self.path);\n137\t    }\n138\t}\n139\t\n140\t/// One scratch file per library, so the two implementations never share state.\n141\tfn scratch_pair(tag: &str) -> (Scratch, Scratch) {\n142\t    (Scratch::new(&format!(\"{tag}_c\")), Scratch::new(&format!(\"{tag}_r\")))\n143\t}\n144\t\n145\tunsafe fn open_file(path: &Path, mode: &str) -> *mut c_void {\n146\t    let cp = CString::new(path.to_str().unwrap()).unwrap();\n147\t    let cm = CString::new(mode).unwrap();\n148\t    let fp = fopen(cp.as_ptr(), cm.as_ptr());\n149\t    assert!(!fp.is_null(), \"fopen({}, {mode}) failed\", path.display());\n150\t    fp\n151\t}\n152\t\n153\t/// Create `path` with exactly `bytes`, using raw stdio.\n154\tunsafe fn write_raw(path: &Path, bytes: &[u8]) {\n155\t    let fp = open_file(path, \"wb\");\n156\t    let n = fwrite(bytes.as_ptr() as *const c_void, 1, bytes.len(), fp);\n157\t    assert_eq!(n, bytes.len(), \"fwrite({}) short\", path.display());\n158\t    assert_eq!(fflush(fp), 0, \"fflush({}) failed\", path.display());\n159\t    fclose(fp);\n160\t}\n161\t\n162\t/// Read `path` back with raw stdio (`fseek`/`ftell`/`fread`).\n163\tunsafe fn read_raw(path: &Path) -> Vec<u8> {\n164\t    let fp = open_file(path, \"rb\");\n165\t    assert_eq!(fseek(fp, 0, SEEK_END), 0, \"fseek(END) failed\");\n166\t    let len = ftell(fp);\n167\t    assert!(len >= 0, \"ftell failed\");\n168\t    assert_eq!(fseek(fp, 0, SEEK_SET), 0, \"fseek(SET) failed\");\n169\t    let mut v = vec![0u8; len as usize];\n170\t    let n = fread(v.as_mut_ptr() as *mut c_void, 1, len as usize, fp);\n171\t    assert_eq!(n, len as usize, \"fread short\");\n172\t    fclose(fp);\n173\t    v\n174\t}\n175\t\n176\t// ---------------------------------------------------------------------------\n177\t// Write / read drivers\n178\t// ---------------------------------------------------------------------------\n179\t\n180\t#[derive(Debug, Clone, PartialEq, Eq)]\n181\tstruct WriteOutcome {\n182\t    open: usize,\n183\t    writes: Vec<usize>,\n184\t    close: Option<usize>,\n185\t}\n186\t\n187\t/// Open `path` for writing, `LZ4F_writeOpen`, feed each slice of `chunks` to\n188\t/// `LZ4F_write`, then `LZ4F_writeClose`. Returns every return value.\n189\tunsafe fn drive_write(\n190\t    api: &FileApi,\n191\t    path: &Path,\n192\t    prefs: Option<&LZ4F_preferences_t>,\n193\t    chunks: &[&[u8]],\n194\t) -> WriteOutcome {\n195\t    let fp = open_file(path, \"wb\");\n196\t    let mut h: *mut c_void = ptr::null_mut();\n197\t    let pp = match prefs {\n198\t        Some(p) => p as *const LZ4F_preferences_t,\n199\t        None => ptr::null(),\n200\t    };\n201\t    let open = (api.wopen)(&mut h, fp, pp);\n202\t    let mut writes = Vec::new();\n203\t    let mut close = None;\n204\t    if open == 0 {\n205\t        assert!(!h.is_null(), \"{}: writeOpen returned OK but handle is NULL\", api.tag);\n206\t        for ch in chunks {\n207\t            writes.push((api.write)(h, ch.as_ptr() as *const c_void, ch.len()));\n208\t        }\n209\t        close = Some((api.wclose)(h));\n210\t    } else {\n211\t        assert!(\n212\t            h.is_null(),\n213\t            \"{}: writeOpen failed ({open:#x}) but left a non-NULL handle\",\n214\t            api.tag\n215\t        );\n216\t    }\n217\t    fclose(fp);\n218\t    WriteOutcome { open, writes, close }\n219\t}\n220\t\n221\t#[derive(Debug, Clone, PartialEq, Eq)]\n222\tstruct ReadOutcome {\n223\t    open: usize,\n224\t    reads: Vec<usize>,\n225\t    data: Vec<u8>,\n226\t    close: Option<usize>,\n227\t}\n228\t\n229\t/// Open `path`, `LZ4F_readOpen`, then read repeatedly using `sizes` cyclically\n230\t/// until EOF (a 0 return), an error, or `cap` bytes, then `LZ4F_readClose`.\n231\tunsafe fn drive_read(api: &FileApi, path: &Path, sizes: &[usize], cap: usize) -> ReadOutcome {\n232\t    assert!(sizes.iter().any(|&s| s > 0), \"drive_read needs a non-zero size\");\n233\t    let fp = open_file(path, \"rb\");\n234\t    let mut h: *mut c_void = ptr::null_mut();\n235\t    let open = (api.ropen)(&mut h, fp);\n236\t    let mut reads = Vec::new();\n237\t    let mut data = Vec::new();\n238\t    let mut close = None;\n239\t    if open == 0 {\n240\t        assert!(!h.is_null(), \"{}: readOpen returned OK but handle is NULL\", api.tag);\n241\t        let mut i = 0usize;\n242\t        loop {\n243\t            let want = sizes[i % sizes.len()];\n244\t            i += 1;\n245\t            if want == 0 {\n246\t                let ret = (api.read)(h, data.as_mut_ptr() as *mut c_void, 0);\n247\t                reads.push(ret);\n248\t                assert_eq!(ret, 0, \"{}: LZ4F_read(size=0) should return 0\", api.tag);\n249\t                continue;\n250\t            }\n251\t            let mut buf = vec![0u8; want];\n252\t            let ret = (api.read)(h, buf.as_mut_ptr() as *mut c_void, want);\n253\t            reads.push(ret);\n254\t            if is_err_range(ret) {\n255\t                break;\n256\t            }\n257\t            assert!(\n258\t                ret <= want,\n259\t                \"{}: LZ4F_read returned {ret} > requested {want}\",\n260\t                api.tag\n261\t            );\n262\t            data.extend_from_slice(&buf[..ret]);\n263\t            if ret == 0 || data.len() >= cap {\n264\t                break;\n265\t            }\n266\t        }\n267\t        close = Some((api.rclose)(h));\n268\t    } else {\n269\t        assert!(\n270\t            h.is_null(),\n271\t            \"{}: readOpen failed ({open:#x}) but left a non-NULL handle\",\n272\t            api.tag\n273\t        );\n274\t    }\n275\t    fclose(fp);\n276\t    ReadOutcome {\n277\t        open,\n278\t        reads,\n279\t        data,\n280\t        close,\n281\t    }\n282\t}\n283\t\n284\t/// Full differential round-trip: write `chunks` with both libraries into their\n285\t/// own files, compare the produced bytes and every return code, then read both\n286\t/// files back with both libraries and compare everything again.\n287\t#[track_caller]\n288\tunsafe fn roundtrip(\n289\t    ctx: &str,\n290\t    prefs: Option<&LZ4F_preferences_t>,\n291\t    chunks: &[&[u8]],\n292\t    read_sizes: &[usize],\n293\t) -> Vec<u8> {\n294\t    let (c, r) = apis();\n295\t    let (sc, sr) = scratch_pair(\"rt\");\n296\t    let wc = drive_write(&c, sc.path(), prefs, chunks);\n297\t    let wr = drive_write(&r, sr.path(), prefs, chunks);\n298\t    assert_eq!(\n299\t        wc.open as isize, wr.open as isize,\n300\t        \"{ctx}: LZ4F_writeOpen return mismatch (C={:#x} Rust={:#x})\",\n301\t        wc.open, wr.open\n302\t    );\n303\t    assert_eq!(\n304\t        wc.writes.iter().map(|&x| x as isize).collect::<Vec<_>>(),\n305\t        wr.writes.iter().map(|&x| x as isize).collect::<Vec<_>>(),\n306\t        \"{ctx}: LZ4F_write return values differ\"\n307\t    );\n308\t    assert_eq!(\n309\t        wc.close.map(|x| x as isize),\n310\t        wr.close.map(|x| x as isize),\n311\t        \"{ctx}: LZ4F_writeClose return mismatch\"\n312\t    );\n313\t\n314\t    let bc = sc.bytes();\n315\t    let br = sr.bytes();\n316\t    same_full_buffers(&format!(\"{ctx}: compressed file bytes\"), &bc, &br);\n317\t\n318\t    let total: usize = chunks.iter().map(|c| c.len()).sum();\n319\t    let mut original = Vec::with_capacity(total);\n320\t    for ch in chunks {\n321\t        original.extend_from_slice(ch);\n322\t    }\n323\t\n324\t    let rc = drive_read(&c, sc.path(), read_sizes, total + 4096);\n325\t    let rr = drive_read(&r, sr.path(), read_sizes, total + 4096);\n326\t    assert_eq!(\n327\t        rc.open as isize, rr.open as isize,\n328\t        \"{ctx}: LZ4F_readOpen return mismatch (C={:#x} Rust={:#x})\",\n329\t        rc.open, rr.open\n330\t    );\n331\t    assert_eq!(\n332\t        rc.reads.iter().map(|&x| x as isize).collect::<Vec<_>>(),\n333\t        rr.reads.iter().map(|&x| x as isize).collect::<Vec<_>>(),\n334\t        \"{ctx}: LZ4F_read return values differ\"\n335\t    );\n336\t    assert_eq!(\n337\t        rc.close.map(|x| x as isize),\n338\t        rr.close.map(|x| x as isize),\n339\t        \"{ctx}: LZ4F_readClose return mismatch\"\n340\t    );\n341\t    same_full_buffers(&format!(\"{ctx}: decompressed payload\"), &rc.data, &rr.data);\n342\t\n343\t    // cross-read: the C-written file read by the Rust reader and vice versa\n344\t    let x1 = drive_read(&r, sc.path(), read_sizes, total + 4096);\n345\t    let x2 = drive_read(&c, sr.path(), read_sizes, total + 4096);\n346\t    assert_eq!(\n347\t        x1.open as isize, rc.open as isize,\n348\t        \"{ctx}: the Rust reader disagrees with the C reader on the C-written file\"\n349\t    );\n350\t    assert_eq!(\n351\t        x2.open as isize, rc.open as isize,\n352\t        \"{ctx}: the C reader disagrees on the Rust-written file\"\n353\t    );\n354\t\n355\t    if rc.open == 0 {\n356\t        assert_eq!(\n357\t            rc.data.len(),\n358\t            original.len(),\n359\t            \"{ctx}: round-tripped length {} != original {}\",\n360\t            rc.data.len(),\n361\t            original.len()\n362\t        );\n363\t        assert!(rc.data == original, \"{ctx}: round-tripped content differs\");\n364\t        assert!(x1.data == original, \"{ctx}: Rust reader mis-decoded the C-written file\");\n365\t        assert!(x2.data == original, \"{ctx}: C reader mis-decoded the Rust-written file\");\n366\t    } else {\n367\t        // The only legitimate reason for readOpen to fail on a frame we just\n368\t        // wrote is a frame shorter than LZ4F_HEADER_SIZE_MAX (19): lz4file's\n369\t        // readOpen always demands 19 bytes up front.\n370\t        assert_eq!(\n371\t            rc.open,\n372\t            err(23),\n373\t            \"{ctx}: unexpected readOpen error {:#x} on a freshly written {}-byte frame\",\n374\t            rc.open,\n375\t            bc.len()\n376\t        );\n377\t        assert!(\n378\t            bc.len() < 19,\n379\t            \"{ctx}: readOpen reported io_read on a {}-byte frame (>= 19)\",\n380\t            bc.len()\n381\t        );\n382\t    }\n383\t\n384\t    bc\n385\t}\n386\t\n387\t/// `LZ4F_writeClose` returns the byte count produced by `LZ4F_compressEnd` on\n388\t/// success (only `err(22)` / a forwarded compressEnd error means failure), so\n389\t/// \"success\" is \"not in the lz4frame error range\".\n390\t#[track_caller]\n391\tfn assert_ok(ctx: &str, v: Option<usize>) -> usize {\n392\t    let v = v.unwrap_or_else(|| panic!(\"{ctx}: call was never made\"));\n393\t    assert!(\n394\t        !is_err_range(v),\n395\t        \"{ctx}: expected success, got error {:#x} (LZ4F code {})\",\n396\t        v,\n397\t        (0usize).wrapping_sub(v)\n398\t    );\n399\t    v\n400\t}\n401\t\n402\tfn prefs_with(bsid: c_uint) -> LZ4F_preferences_t {\n403\t    let mut p = LZ4F_preferences_t::default();\n404\t    p.frameInfo.blockSizeID = bsid;\n405\t    p\n406\t}\n407\t\n408\t// ===========================================================================\n409\t// Row 157 — LZ4F_writeOpen\n410\t// ===========================================================================\n411\t\n412\t#[test]\n413\tfn row_157_writeOpen_prefs_null_and_every_blocksizeid() {\n414\t    unsafe {\n415\t        let mut rng = Rng::new(157);\n416\t        let payload = gen(&mut rng, Shape::TextLike, 300_000);\n417\t\n418\t        // prefsPtr == NULL -> maxWriteSize 64 KB\n419\t        roundtrip(\"row157 prefs=NULL\", None, &[&payload], &[7000]);\n420\t\n421\t        // every valid blockSizeID\n422\t        for bsid in [LZ4F_DEFAULT, LZ4F_MAX64KB, LZ4F_MAX256KB, LZ4F_MAX1MB, LZ4F_MAX4MB] {\n423\t            let p = prefs_with(bsid);\n424\t            roundtrip(\n425\t                &format!(\"row157 blockSizeID={bsid}\"),\n426\t                Some(&p),\n427\t                &[&payload],\n428\t                &[7000],\n429\t            );\n430\t        }\n431\t    }\n432\t}\n433\t\n434\t#[test]\n435\tfn row_157_writeOpen_invalid_blocksizeid_and_null_params() {\n436\t    unsafe {\n437\t        let (c, r) = apis();\n438\t\n439\t        // invalid blockSizeID -> LZ4F_ERROR_maxBlockSize_invalid == (size_t)-2\n440\t        for bsid in [1u32, 2, 3, 8, 9, 100, u32::MAX] {\n441\t            let p = prefs_with(bsid);\n442\t            let (sc, sr) = scratch_pair(\"w_badbsid\");\n443\t            let wc = drive_write(&c, sc.path(), Some(&p), &[]);\n444\t            let wr = drive_write(&r, sr.path(), Some(&p), &[]);\n445\t            assert_eq!(\n446\t                wc.open as isize, wr.open as isize,\n447\t                \"row157: writeOpen(blockSizeID={bsid}) C={:#x} Rust={:#x}\",\n448\t                wc.open, wr.open\n449\t            );\n450\t            assert_eq!(\n451\t                wc.open,\n452\t                err(2),\n453\t                \"row157: writeOpen(blockSizeID={bsid}) must be LZ4F_ERROR_maxBlockSize_invalid err(2), got {:#x}\",\n454\t                wc.open\n455\t            );\n456\t            assert!(wc.writes.is_empty() && wc.close.is_none());\n457\t            // nothing was written to the file\n458\t            assert!(sc.bytes().is_empty(), \"row157: bytes written despite the error\");\n459\t            assert!(sr.bytes().is_empty(), \"row157: bytes written despite the error\");\n460\t        }\n461\t\n462\t        // fp == NULL -> parameter_null; the handle is left untouched\n463\t        let mut hc: *mut c_void = ptr::null_mut();\n464\t        let mut hr: *mut c_void = ptr::null_mut();\n465\t        let a = (c.wopen)(&mut hc, ptr::null_mut(), ptr::null());\n466\t        let b = (r.wopen)(&mut hr, ptr::null_mut(), ptr::null());\n467\t        assert_eq!(a as isize, b as isize, \"row157: writeOpen(fp=NULL) C={a:#x} Rust={b:#x}\");\n468\t        assert_eq!(a, err(21), \"row157: writeOpen(fp=NULL) must be err(21), got {a:#x}\");\n469\t        assert!(hc.is_null() && hr.is_null());\n470\t\n471\t        // handle == NULL -> parameter_null\n472\t        let (sc, sr) = scratch_pair(\"w_nullhandle\");\n473\t        let fpc = open_file(sc.path(), \"wb\");\n474\t        let fpr = open_file(sr.path(), \"wb\");\n475\t        let a = (c.wopen)(ptr::null_mut(), fpc, ptr::null());\n476\t        let b = (r.wopen)(ptr::null_mut(), fpr, ptr::null());\n477\t        assert_eq!(\n478\t            a as isize, b as isize,\n479\t            \"row157: writeOpen(handle=NULL) C={a:#x} Rust={b:#x}\"\n480\t        );\n481\t        assert_eq!(a, err(21), \"row157: writeOpen(handle=NULL) must be err(21), got {a:#x}\");\n482\t        fclose(fpc);\n483\t        fclose(fpr);\n484\t\n485\t        // both NULL\n486\t        let a = (c.wopen)(ptr::null_mut(), ptr::null_mut(), ptr::null());\n487\t        let b = (r.wopen)(ptr::null_mut(), ptr::null_mut(), ptr::null());\n488\t        assert_eq!(a as isize, b as isize);\n489\t        assert_eq!(a, err(21));\n490\t    }\n491\t}\n492\t\n493\t// ===========================================================================\n494\t// Row 158 — LZ4F_write sizes and NULL parameters\n495\t// ===========================================================================\n496\t\n497\t#[test]\n498\tfn row_158_write_sizes_around_maxwritesize() {\n499\t    unsafe {\n500\t        let mut rng = Rng::new(158);\n501\t        // default prefs -> maxWriteSize == 64 KB\n502\t        const MWS: usize = 64 * 1024;\n503\t        let big = gen(&mut rng, Shape::TextLike, 5 * MWS);\n504\t\n505\t        for &n in &[\n506\t            0usize,\n507\t            1,\n508\t            17,\n509\t            MWS - 1,\n510\t            MWS,\n511\t            MWS + 1,\n512\t            2 * MWS,\n513\t            2 * MWS + 3,\n514\t            5 * MWS,\n515\t        ] {\n516\t            let chunk = &big[..n];\n517\t            let out = roundtrip(\n518\t                &format!(\"row158 single write of {n}\"),\n519\t                None,\n520\t                &[chunk],\n521\t                &[MWS],\n522\t            );\n523\t            assert!(!out.is_empty(), \"row158: empty frame file for n={n}\");\n524\t        }\n525\t\n526\t        // several writes, mixing sizes below / at / above maxWriteSize\n527\t        let a = &big[..10];\n528\t        let b = &big[10..10 + MWS];\n529\t        let cc = &big[..MWS + 12345];\n530\t        let d: &[u8] = &[];\n531\t        roundtrip(\"row158 multi-write\", None, &[a, d, b, d, cc, a], &[1, 3, 5000]);\n532\t\n533\t        // and with a 256 KB block size (maxWriteSize 256 KB)\n534\t        let p = prefs_with(LZ4F_MAX256KB);\n535\t        roundtrip(\n536\t            \"row158 multi-write 256KB\",\n537\t            Some(&p),\n538\t            &[a, b, cc],\n539\t            &[100_000],\n540\t        );\n541\t    }\n542\t}\n543\t\n544\t#[test]\n545\tfn row_158_write_null_buffer_and_null_handle() {\n546\t    unsafe {\n547\t        let (c, r) = apis();\n548\t        let (sc, sr) = scratch_pair(\"w_nullbuf\");\n549\t        let fpc = open_file(sc.path(), \"wb\");\n550\t        let fpr = open_file(sr.path(), \"wb\");\n551\t        let mut hc: *mut c_void = ptr::null_mut();\n552\t        let mut hr: *mut c_void = ptr::null_mut();\n553\t        assert_eq!((c.wopen)(&mut hc, fpc, ptr::null()), 0);\n554\t        assert_eq!((r.wopen)(&mut hr, fpr, ptr::null()), 0);\n555\t\n556\t        // buf == NULL, with size 0 and non-zero: parameter_null in both cases\n557\t        for &n in &[0usize, 1, 100] {\n558\t            let a = (c.write)(hc, ptr::null(), n);\n559\t            let b = (r.write)(hr, ptr::null(), n);\n560\t            assert_eq!(\n561\t                a as isize, b as isize,\n562\t                \"row158: LZ4F_write(buf=NULL,size={n}) C={a:#x} Rust={b:#x}\"\n563\t            );\n564\t            assert_eq!(\n565\t                a,\n566\t                err(21),\n567\t                \"row158: LZ4F_write(buf=NULL,size={n}) must be err(21), got {a:#x}\"\n568\t            );\n569\t        }\n570\t\n571\t        // handle == NULL\n572\t        let data = [1u8, 2, 3];\n573\t        let a = (c.write)(ptr::null_mut(), data.as_ptr() as *const c_void, 3);\n574\t        let b = (r.write)(ptr::null_mut(), data.as_ptr() as *const c_void, 3);\n575\t        assert_eq!(a as isize, b as isize, \"row158: LZ4F_write(handle=NULL)\");\n576\t        assert_eq!(a, err(21));\n577\t        // both NULL\n578\t        let a = (c.write)(ptr::null_mut(), ptr::null(), 0);\n579\t        let b = (r.write)(ptr::null_mut(), ptr::null(), 0);\n580\t        assert_eq!(a as isize, b as isize);\n581\t        assert_eq!(a, err(21));\n582\t\n583\t        // size == 0 with a valid buffer is a no-op returning 0\n584\t        let a = (c.write)(hc, data.as_ptr() as *const c_void, 0);\n585\t        let b = (r.write)(hr, data.as_ptr() as *const c_void, 0);\n586\t        assert_eq!(a as isize, b as isize, \"row158: LZ4F_write(size=0)\");\n587\t        assert_eq!(a, 0, \"row158: LZ4F_write(size=0) must return 0\");\n588\t\n589\t        // the rejected calls must not have poisoned errCode: close still works\n590\t        let a = (c.wclose)(hc);\n591\t        let b = (r.wclose)(hr);\n592\t        assert_eq!(a as isize, b as isize, \"row158: writeClose after rejected writes\");\n593\t        assert_ok(\"row158: writeClose after rejected writes\", Some(a));\n594\t        fclose(fpc);\n595\t        fclose(fpr);\n596\t        same_full_buffers(\"row158 empty frame bytes\", &sc.bytes(), &sr.bytes());\n597\t    }\n598\t}\n599\t\n600\t// ===========================================================================\n601\t// Row 159 — non-default preferences forwarded to compressBegin/compressUpdate\n602\t// ===========================================================================\n603\t\n604\t#[test]\n605\tfn row_159_writeOpen_forwards_non_default_preferences() {\n606\t    unsafe {\n607\t        let mut rng = Rng::new(159);\n608\t        let payload = gen(&mut rng, Shape::TextLike, 200_000);\n609\t        let small = gen(&mut rng, Shape::Compressible, 1000);\n610\t\n611\t        // one axis at a time\n612\t        let mut cases: Vec<(String, LZ4F_preferences_t)> = Vec::new();\n613\t        for cc in [LZ4F_NO_CONTENT_CHECKSUM, LZ4F_CONTENT_CHECKSUM_ENABLED] {\n614\t            for bc in [LZ4F_NO_BLOCK_CHECKSUM, LZ4F_BLOCK_CHECKSUM_ENABLED] {\n615\t                let mut p = LZ4F_preferences_t::default();\n616\t                p.frameInfo.contentChecksumFlag = cc;\n617\t                p.frameInfo.blockChecksumFlag = bc;\n618\t                cases.push((format!(\"cc={cc} bc={bc}\"), p));\n619\t            }\n620\t        }\n621\t        for bm in [LZ4F_BLOCK_LINKED, LZ4F_BLOCK_INDEPENDENT] {\n622\t            let mut p = LZ4F_preferences_t::default();\n623\t            p.frameInfo.blockMode = bm;\n624\t            cases.push((format!(\"blockMode={bm}\"), p));\n625\t        }\n626\t        for lvl in [0i32, 1, 9, 10, 12] {\n627\t            let mut p = LZ4F_preferences_t::default();\n628\t            p.compressionLevel = lvl;\n629\t            cases.push((format!(\"level={lvl}\"), p));\n630\t        }\n631\t        for af in [0u32, 1] {\n632\t            let mut p = LZ4F_preferences_t::default();\n633\t            p.autoFlush = af;\n634\t            cases.push((format!(\"autoFlush={af}\"), p));\n635\t        }\n636\t        for did in [0u32, 1, 0xDEAD_BEEF] {\n637\t            let mut p = LZ4F_preferences_t::default();\n638\t            p.frameInfo.dictID = did;\n639\t            cases.push((format!(\"dictID={did:#x}\"), p));\n640\t        }\n641\t        {\n642\t            let mut p = LZ4F_preferences_t::default();\n643\t            p.frameInfo.contentSize = payload.len() as u64;\n644\t            cases.push((\"contentSize=exact\".to_string(), p));\n645\t        }\n646\t        {\n647\t            // everything at once\n648\t            let mut p = LZ4F_preferences_t::default();\n649\t            p.frameInfo.blockSizeID = LZ4F_MAX256KB;\n650\t            p.frameInfo.blockMode = LZ4F_BLOCK_INDEPENDENT;\n651\t            p.frameInfo.contentChecksumFlag = LZ4F_CONTENT_CHECKSUM_ENABLED;\n652\t            p.frameInfo.blockChecksumFlag = LZ4F_BLOCK_CHECKSUM_ENABLED;\n653\t            p.frameInfo.contentSize = payload.len() as u64;\n654\t            p.frameInfo.dictID = 0x1234_5678;\n655\t            p.compressionLevel = 12;\n656\t            p.autoFlush = 1;\n657\t            p.favorDecSpeed = 1;\n658\t            cases.push((\"all-non-default\".to_string(), p));\n659\t        }\n660\t\n661\t        for (name, p) in &cases {\n662\t            roundtrip(\n663\t                &format!(\"row159 {name}\"),\n664\t                Some(p),\n665\t                &[&payload],\n666\t                &[13_000],\n667\t            );\n668\t        }\n669\t\n670\t        // contentSize declared but wrong -> LZ4F_compressEnd reports\n671\t        // LZ4F_ERROR_frameSize_wrong (err(14)) from LZ4F_writeClose\n672\t        let (c, r) = apis();\n673\t        let mut p = LZ4F_preferences_t::default();\n674\t        p.frameInfo.contentSize = 999_999;\n675\t        let (sc, sr) = scratch_pair(\"w_wrongsize\");\n676\t        let wc = drive_write(&c, sc.path(), Some(&p), &[&small]);\n677\t        let wr = drive_write(&r, sr.path(), Some(&p), &[&small]);\n678\t        assert_eq!(wc, wr, \"row159: wrong contentSize outcome mismatch\");\n679\t        assert_eq!(wc.open, 0);\n680\t        assert_eq!(wc.writes, vec![small.len()]);\n681\t        assert_eq!(\n682\t            wc.close,\n683\t            Some(err(14)),\n684\t            \"row159: writeClose with a wrong declared contentSize must be err(14), got {:?}\",\n685\t            wc.close\n686\t        );\n687\t        same_full_buffers(\"row159 wrong-contentSize bytes\", &sc.bytes(), &sr.bytes());\n688\t    }\n689\t}\n690\t\n691\t// ===========================================================================\n692\t// Row 160 — LZ4F_writeClose\n693\t// ===========================================================================\n694\t\n695\t#[test]\n696\tfn row_160_writeClose_normal_and_null_handle() {\n697\t    unsafe {\n698\t        let (c, r) = apis();\n699\t        let mut rng = Rng::new(160);\n700\t        let payload = gen(&mut rng, Shape::Compressible, 5000);\n701\t\n702\t        // normal close: compressEnd + fwrite, returns 0\n703\t        let (sc, sr) = scratch_pair(\"wclose\");\n704\t        let wc = drive_write(&c, sc.path(), None, &[&payload]);\n705\t        let wr = drive_write(&r, sr.path(), None, &[&payload]);\n706\t        assert_eq!(wc, wr, \"row160: normal write outcome mismatch\");\n707\t        // writeClose returns the compressEnd byte count on success\n708\t        let n = assert_ok(\"row160: normal writeClose\", wc.close);\n709\t        assert!(n > 0, \"row160: writeClose should report the trailer byte count\");\n710\t        same_full_buffers(\"row160 file bytes\", &sc.bytes(), &sr.bytes());\n711\t\n712\t        // handle == NULL -> parameter_null\n713\t        let a = (c.wclose)(ptr::null_mut());\n714\t        let b = (r.wclose)(ptr::null_mut());\n715\t        assert_eq!(a as isize, b as isize, \"row160: writeClose(NULL) C={a:#x} Rust={b:#x}\");\n716\t        assert_eq!(a, err(21), \"row160: writeClose(NULL) must be err(21), got {a:#x}\");\n717\t\n718\t        // close with no payload at all: header + endMark only\n719\t        let (sc, sr) = scratch_pair(\"wclose_empty\");\n720\t        let wc = drive_write(&c, sc.path(), None, &[]);\n721\t        let wr = drive_write(&r, sr.path(), None, &[]);\n722\t        assert_eq!(wc, wr, \"row160: empty-frame outcome mismatch\");\n723\t        assert_eq!(\n724\t            wc.close,\n725\t            Some(4),\n726\t            \"row160: an empty frame's writeClose writes only the 4-byte endMark\"\n727\t        );\n728\t        let bytes = sc.bytes();\n729\t        same_full_buffers(\"row160 empty frame\", &bytes, &sr.bytes());\n730\t        assert_eq!(bytes.len(), 11, \"row160: expected 7-byte header + 4-byte endMark\");\n731\t    }\n732\t}\n733\t\n734\t/// ERRORS rows 180 + 184 — a short write inside `LZ4F_write` latches\n735\t/// `errCode = (size_t)-22` and returns `err(22)`; the following\n736\t/// `LZ4F_writeClose` then SKIPS compressEnd and returns `LZ4F_OK_NoError`.\n737\t/// `/dev/full` provides the short write (buffered stdio lets the small frame\n738\t/// header through, then the bulk data fails).\n739\t#[test]\n740\tfn row_160_writeClose_after_previous_write_error() {\n741\t    unsafe {\n742\t        let (c, r) = apis();\n743\t        let mut rng = Rng::new(1600);\n744\t        let payload = gen(&mut rng, Shape::Incompressible, 4 * 1024 * 1024);\n745\t\n746\t        let mut results = Vec::new();\n747\t        for api in [&c, &r] {\n748\t            let fp = open_file(Path::new(\"/dev/full\"), \"wb\");\n749\t            let mut h: *mut c_void = ptr::null_mut();\n750\t            let open = (api.wopen)(&mut h, fp, ptr::null());\n751\t            let mut w = err(0);\n752\t            let mut close = err(0);\n753\t            if open == 0 {\n754\t                w = (api.write)(h, payload.as_ptr() as *const c_void, payload.len());\n755\t                close = (api.wclose)(h);\n756\t            }\n757\t            fclose(fp);\n758\t            results.push((open, w, close));\n759\t        }\n760\t        assert_eq!(\n761\t            (results[0].0 as isize, results[0].1 as isize, results[0].2 as isize),\n762\t            (results[1].0 as isize, results[1].1 as isize, results[1].2 as isize),\n763\t            \"row160: /dev/full write-error sequence differs: C={:#x?} Rust={:#x?}\",\n764\t            results[0],\n765\t            results[1]\n766\t        );\n767\t        assert_eq!(results[0].0, 0, \"row160: writeOpen on /dev/full should succeed (buffered header)\");\n768\t        assert_eq!(\n769\t            results[0].1,\n770\t            err(22),\n771\t            \"row160: LZ4F_write to /dev/full must be LZ4F_ERROR_io_write err(22), got {:#x}\",\n772\t            results[0].1\n773\t        );\n774\t        assert_eq!(\n775\t            results[0].2, 0,\n776\t            \"row160/ERRORS184: writeClose after a latched write error must return 0, got {:#x}\",\n777\t            results[0].2\n778\t        );\n779\t    }\n780\t}\n781\t\n782\t/// ERRORS row 177 — a short write of the frame header inside `LZ4F_writeOpen`\n783\t/// returns `err(22)` and frees + nulls the handle.\n784\t#[test]\n785\tfn errors_177_writeOpen_short_header_write_is_io_write() {\n786\t    unsafe {\n787\t        let (c, r) = apis();\n788\t        let mut rets = Vec::new();\n789\t        for api in [&c, &r] {\n790\t            let fp = open_file(Path::new(\"/dev/full\"), \"wb\");\n791\t            // unbuffered, so even the 7-byte header write reaches the device\n792\t            assert_eq!(setvbuf(fp, ptr::null_mut(), IONBF, 0), 0);\n793\t            let mut h: *mut c_void = ptr::null_mut();\n794\t            let ret = (api.wopen)(&mut h, fp, ptr::null());\n795\t            assert!(h.is_null(), \"{}: handle not nulled after io_write\", api.tag);\n796\t            fclose(fp);\n797\t            rets.push(ret);\n798\t        }\n799\t        assert_eq!(\n800\t            rets[0] as isize, rets[1] as isize,\n801\t            \"errors177: C={:#x} Rust={:#x}\",\n802\t            rets[0], rets[1]\n803\t        );\n804\t        assert_eq!(\n805\t            rets[0],\n806\t            err(22),\n807\t            \"errors177: expected LZ4F_ERROR_io_write err(22), got {:#x}\",\n808\t            rets[0]\n809\t        );\n810\t    }\n811\t}\n812\t\n813\t/// ERRORS row 183 — a short write of the frame trailer inside\n814\t/// `LZ4F_writeClose` returns `err(22)`. An `fmemopen` buffer sized to hold the\n815\t/// header and the data block but not the 4-byte endMark provides it.\n816\t#[test]\n817\tfn errors_183_writeClose_short_trailer_write_is_io_write() {\n818\t    unsafe {\n819\t        let (c, r) = apis();\n820\t        let mut rng = Rng::new(183);\n821\t        let payload = gen(&mut rng, Shape::Compressible, 4096);\n822\t\n823\t        // Measure the exact frame size first (via a real file).\n824\t        let (sc, _sr) = scratch_pair(\"trailer_probe\");\n825\t        let w = drive_write(&c, sc.path(), None, &[&payload]);\n826\t        assert_ok(\"errors183: probe writeClose\", w.close);\n827\t        let full_len = sc.bytes().len();\n828\t        assert!(full_len > 8);\n829\t        let cap = full_len - 1; // one byte short of the 4-byte endMark\n830\t\n831\t        let mode = CString::new(\"wb\").unwrap();\n832\t        let mut rets = Vec::new();\n833\t        for api in [&c, &r] {\n834\t            let mut mem = vec![0u8; cap];\n835\t            let fp = fmemopen(mem.as_mut_ptr() as *mut c_void, cap, mode.as_ptr());\n836\t            assert!(!fp.is_null(), \"fmemopen failed\");\n837\t            assert_eq!(setvbuf(fp, ptr::null_mut(), IONBF, 0), 0);\n838\t            let mut h: *mut c_void = ptr::null_mut();\n839\t            let open = (api.wopen)(&mut h, fp, ptr::null());\n840\t            let mut wret = err(0);\n841\t            let mut close = err(0);\n842\t            if open == 0 {\n843\t                wret = (api.write)(h, payload.as_ptr() as *const c_void, payload.len());\n844\t                close = (api.wclose)(h);\n845\t            }\n846\t            fclose(fp);\n847\t            rets.push((open, wret, close));\n848\t        }\n849\t        assert_eq!(\n850\t            (rets[0].0 as isize, rets[0].1 as isize, rets[0].2 as isize),\n851\t            (rets[1].0 as isize, rets[1].1 as isize, rets[1].2 as isize),\n852\t            \"errors183: sequence differs C={:#x?} Rust={:#x?}\",\n853\t            rets[0],\n854\t            rets[1]\n855\t        );\n856\t        assert_eq!(rets[0].0, 0, \"errors183: writeOpen should succeed\");\n857\t        assert_eq!(rets[0].1, payload.len(), \"errors183: LZ4F_write should succeed\");\n858\t        assert_eq!(\n859\t            rets[0].2,\n860\t            err(22),\n861\t            \"errors183: writeClose must report LZ4F_ERROR_io_write err(22), got {:#x}\",\n862\t            rets[0].2\n863\t        );\n864\t    }\n865\t}\n866\t\n867\t// ===========================================================================\n868\t// Row 161 — LZ4F_readOpen\n869\t// ===========================================================================\n870\t\n871\t#[test]\n872\tfn row_161_readOpen_short_file_is_io_read() {\n873\t    unsafe {\n874\t        let (c, r) = apis();\n875\t        // any file shorter than LZ4F_HEADER_SIZE_MAX (19) fails the initial\n876\t        // fread with LZ4F_ERROR_io_read\n877\t        for n in [0usize, 1, 4, 6, 7, 11, 18] {\n878\t            let (sc, sr) = scratch_pair(\"short\");\n879\t            let data: Vec<u8> = (0..n).map(|i| (i as u8).wrapping_mul(7)).collect();\n880\t            write_raw(sc.path(), &data);\n881\t            write_raw(sr.path(), &data);\n882\t            let a = drive_read_open_only(&c, sc.path());\n883\t            let b = drive_read_open_only(&r, sr.path());\n884\t            assert_eq!(\n885\t                a as isize, b as isize,\n886\t                \"row161: readOpen on a {n}-byte file C={a:#x} Rust={b:#x}\"\n887\t            );\n888\t            assert_eq!(\n889\t                a,\n890\t                err(23),\n891\t                \"row161: readOpen on a {n}-byte file must be LZ4F_ERROR_io_read err(23), got {a:#x}\"\n892\t            );\n893\t        }\n894\t    }\n895\t}\n896\t\n897\tunsafe fn drive_read_open_only(api: &FileApi, path: &Path) -> usize {\n898\t    let fp = open_file(path, \"rb\");\n899\t    let mut h: *mut c_void = ptr::null_mut();\n900\t    let ret = (api.ropen)(&mut h, fp);\n901\t    if ret == 0 {\n902\t        assert!(!h.is_null());\n903\t        let cl = (api.rclose)(h);\n904\t        assert_eq!(cl, 0, \"{}: readClose failed\", api.tag);\n905\t    } else {\n906\t        assert!(h.is_null(), \"{}: handle not nulled after readOpen error\", api.tag);\n907\t    }\n908\t    fclose(fp);\n909\t    ret\n910\t}\n911\t\n912\t#[test]\n913\tfn row_161_readOpen_each_blocksizeid_and_null_params() {\n914\t    unsafe {\n915\t        let (c, r) = apis();\n916\t        let mut rng = Rng::new(1610);\n917\t        let payload = gen(&mut rng, Shape::TextLike, 700_000);\n918\t\n919\t        // srcBufMaxSize is derived from the frame's blockSizeID: exercise all\n920\t        for bsid in [LZ4F_DEFAULT, LZ4F_MAX64KB, LZ4F_MAX256KB, LZ4F_MAX1MB, LZ4F_MAX4MB] {\n921\t            let p = prefs_with(bsid);\n922\t            roundtrip(\n923\t                &format!(\"row161 readOpen blockSizeID={bsid}\"),\n924\t                Some(&p),\n925\t                &[&payload],\n926\t                &[65536, 1, 300_000],\n927\t            );\n928\t        }\n929\t\n930\t        // fp == NULL / handle == NULL -> parameter_null\n931\t        let mut hc: *mut c_void = ptr::null_mut();\n932\t        let mut hr: *mut c_void = ptr::null_mut();\n933\t        let a = (c.ropen)(&mut hc, ptr::null_mut());\n934\t        let b = (r.ropen)(&mut hr, ptr::null_mut());\n935\t        assert_eq!(a as isize, b as isize, \"row161: readOpen(fp=NULL)\");\n936\t        assert_eq!(a, err(21), \"row161: readOpen(fp=NULL) must be err(21), got {a:#x}\");\n937\t        assert!(hc.is_null() && hr.is_null());\n938\t\n939\t        let (sc, sr) = scratch_pair(\"ropen_null\");\n940\t        // give both files a valid frame so only the NULL handle is at fault\n941\t        let _ = drive_write(&c, sc.path(), None, &[&payload[..100]]);\n942\t        let _ = drive_write(&r, sr.path(), None, &[&payload[..100]]);\n943\t        let fpc = open_file(sc.path(), \"rb\");\n944\t        let fpr = open_file(sr.path(), \"rb\");\n945\t        let a = (c.ropen)(ptr::null_mut(), fpc);\n946\t        let b = (r.ropen)(ptr::null_mut(), fpr);\n947\t        assert_eq!(a as isize, b as isize, \"row161: readOpen(handle=NULL)\");\n948\t        assert_eq!(a, err(21), \"row161: readOpen(handle=NULL) must be err(21), got {a:#x}\");\n949\t        fclose(fpc);\n950\t        fclose(fpr);\n951\t\n952\t        let a = (c.ropen)(ptr::null_mut(), ptr::null_mut());\n953\t        let b = (r.ropen)(ptr::null_mut(), ptr::null_mut());\n954\t        assert_eq!(a as isize, b as isize);\n955\t        assert_eq!(a, err(21));\n956\t    }\n957\t}\n958\t\n959\t/// ERRORS rows 164 + 165 — `LZ4F_getFrameInfo` failures inside\n960\t/// `LZ4F_readOpen` are forwarded verbatim, including the invalid\n961\t/// `blockSizeID` byte (`err(2)`), and the handle is freed + nulled.\n962\t#[test]\n963\tfn row_161_errors_164_165_readOpen_bad_frame_headers() {\n964\t    unsafe {\n965\t        let (c, r) = apis();\n966\t\n967\t        fn frame_header(flg: u8, bd: u8, hc: u8) -> Vec<u8> {\n968\t            let mut v = vec![0x04, 0x22, 0x4D, 0x18, flg, bd, hc];\n969\t            v.resize(32, 0); // >= 19 bytes so the initial fread succeeds\n970\t            v\n971\t        }\n972\t\n973\t        // (name, bytes, expected error)\n974\t        let mut cases: Vec<(String, Vec<u8>, usize)> = Vec::new();\n975\t        // bad magic number -> frameType_unknown err(13)\n976\t        let mut bad_magic = frame_header(0x40, 0x70, 0x00);\n977\t        bad_magic[0] = 0x05;\n978\t        cases.push((\"bad magic\".into(), bad_magic, err(13)));\n979\t        // blockSizeID (BD>>4)&7 < 4 -> maxBlockSize_invalid err(2)\n980\t        for bsid in [0u8, 1, 2, 3] {\n981\t            cases.push((\n982\t                format!(\"blockSizeID byte {bsid}\"),\n983\t                frame_header(0x40, bsid << 4, 0x00),\n984\t                err(2),\n985\t            ));\n986\t        }\n987\t        // FLG reserved bit 1 set -> reservedFlag_set err(8)\n988\t        cases.push((\"FLG reserved bit\".into(), frame_header(0x42, 0x70, 0x00), err(8)));\n989\t        // FLG version field != 1 -> headerVersion_wrong err(6)\n990\t        cases.push((\"bad version\".into(), frame_header(0x80, 0x70, 0x00), err(6)));\n991\t        // BD reserved bit 7 -> reservedFlag_set err(8)\n992\t        cases.push((\"BD reserved bit\".into(), frame_header(0x40, 0xF0, 0x00), err(8)));\n993\t        // BD low nibble non-zero -> reservedFlag_set err(8)\n994\t        cases.push((\"BD low nibble\".into(), frame_header(0x40, 0x71, 0x00), err(8)));\n995\t        // valid FLG/BD but a wrong header checksum -> headerChecksum_invalid err(17)\n996\t        cases.push((\"bad header checksum\".into(), frame_header(0x40, 0x70, 0x00), err(17)));\n997\t\n998\t        for (name, bytes, expect) in cases {\n999\t            let (sc, sr) = scratch_pair(\"badhdr\");\n1000\t            write_raw(sc.path(), &bytes);\n1001\t            write_raw(sr.path(), &bytes);\n1002\t            let a = drive_read_open_only(&c, sc.path());\n1003\t            let b = drive_read_open_only(&r, sr.path());\n1004\t            assert_eq!(\n1005\t                a as isize, b as isize,\n1006\t                \"row161 [{name}]: readOpen C={a:#x} Rust={b:#x}\"\n1007\t            );\n1008\t            assert_eq!(\n1009\t                a, expect,\n1010\t                \"row161 [{name}]: expected {expect:#x}, got {a:#x}\"\n1011\t            );\n1012\t        }\n1013\t\n1014\t        // A legacy-magic / skippable frame is accepted by getFrameInfo? -> the\n1015\t        // skippable magic is recognised by LZ4F_headerSize but the frame type\n1016\t        // makes blockSizeID meaningless; whatever the C library decides, the\n1017\t        // Rust one must agree.\n1018\t        let mut skip = vec![0x50, 0x2A, 0x4D, 0x18, 0x10, 0x00, 0x00, 0x00];\n1019\t        skip.resize(64, 0xAB);\n1020\t        let (sc, sr) = scratch_pair(\"skippable\");\n1021\t        write_raw(sc.path(), &skip);\n1022\t        write_raw(sr.path(), &skip);\n1023\t        let a = drive_read_open_only(&c, sc.path());\n1024\t        let b = drive_read_open_only(&r, sr.path());\n1025\t        assert_eq!(\n1026\t            a as isize, b as isize,\n1027\t            \"row161 [skippable frame]: readOpen C={a:#x} Rust={b:#x}\"\n1028\t        );\n1029\t    }\n1030\t}\n1031\t\n1032\t// ===========================================================================\n1033\t// Row 162 — LZ4F_read / LZ4F_readClose\n1034\t// ===========================================================================\n1035\t\n1036\t#[test]\n1037\tfn row_162_read_sizes_sequential_reads_and_eof_short_count() {\n1038\t    unsafe {\n1039\t        let (c, r) = apis();\n1040\t        let mut rng = Rng::new(162);\n1041\t        let payload = gen(&mut rng, Shape::TextLike, 100_000);\n1042\t\n1043\t        let (sc, sr) = scratch_pair(\"read\");\n1044\t        let wc = drive_write(&c, sc.path(), None, &[&payload]);\n1045\t        let wr = drive_write(&r, sr.path(), None, &[&payload]);\n1046\t        assert_eq!(wc, wr);\n1047\t        same_full_buffers(\"row162 frame bytes\", &sc.bytes(), &sr.bytes());\n1048\t\n1049\t        // size == 0 must return 0 without consuming anything, then a normal\n1050\t        // read must still deliver the first bytes\n1051\t        for api in [&c, &r] {\n1052\t            let path = if api.tag == \"C\" { sc.path() } else { sr.path() };\n1053\t            let fp = open_file(path, \"rb\");\n1054\t            let mut h: *mut c_void = ptr::null_mut();\n1055\t            assert_eq!((api.ropen)(&mut h, fp), 0);\n1056\t            let mut buf = vec![0u8; 1024];\n1057\t            for _ in 0..3 {\n1058\t                let z = (api.read)(h, buf.as_mut_ptr() as *mut c_void, 0);\n1059\t                assert_eq!(z, 0, \"{}: LZ4F_read(size=0) must return 0\", api.tag);\n1060\t            }\n1061\t            let n = (api.read)(h, buf.as_mut_ptr() as *mut c_void, 1024);\n1062\t            assert_eq!(n, 1024, \"{}: expected a full 1024-byte read\", api.tag);\n1063\t            assert_eq!(&buf[..], &payload[..1024], \"{}: wrong content\", api.tag);\n1064\t            // read far more than what remains -> short count at EOF\n1065\t            let mut big = vec![0u8; payload.len()];\n1066\t            let m = (api.read)(h, big.as_mut_ptr() as *mut c_void, payload.len());\n1067\t            assert_eq!(\n1068\t                m,\n1069\t                payload.len() - 1024,\n1070\t                \"{}: expected a short count of {} at EOF, got {m}\",\n1071\t                api.tag,\n1072\t                payload.len() - 1024\n1073\t            );\n1074\t            assert_eq!(&big[..m], &payload[1024..], \"{}: wrong tail content\", api.tag);\n1075\t            // a further read returns 0\n1076\t            let z = (api.read)(h, big.as_mut_ptr() as *mut c_void, 100);\n1077\t            assert_eq!(z, 0, \"{}: read past EOF must return 0\", api.tag);\n1078\t            assert_eq!((api.rclose)(h), 0, \"{}: readClose\", api.tag);\n1079\t            fclose(fp);\n1080\t        }\n1081\t\n1082\t        // many sequential reads with assorted sizes, including 0\n1083\t        for sizes in [\n1084\t            vec![1usize],\n1085\t            vec![0, 1, 0, 2, 0, 3],\n1086\t            vec![7, 1, 4096, 3],\n1087\t            vec![65536],\n1088\t            vec![payload.len() + 12345],\n1089\t            vec![13, 13, 13, 1024 * 1024],\n1090\t        ] {\n1091\t            let a = drive_read(&c, sc.path(), &sizes, payload.len() + 1);\n1092\t            let b = drive_read(&r, sr.path(), &sizes, payload.len() + 1);\n1093\t            assert_eq!(a.open as isize, b.open as isize, \"row162 sizes={sizes:?}: readOpen\");\n1094\t            assert_eq!(\n1095\t                a.reads.iter().map(|&x| x as isize).collect::<Vec<_>>(),\n1096\t                b.reads.iter().map(|&x| x as isize).collect::<Vec<_>>(),\n1097\t                \"row162 sizes={sizes:?}: LZ4F_read returns differ\"\n1098\t            );\n1099\t            assert_eq!(a.close, b.close, \"row162 sizes={sizes:?}: readClose\");\n1100\t            same_full_buffers(&format!(\"row162 sizes={sizes:?} payload\"), &a.data, &b.data);\n1101\t            assert!(\n1102\t                a.data == payload,\n1103\t                \"row162 sizes={sizes:?}: decoded {} bytes, expected {}\",\n1104\t                a.data.len(),\n1105\t                payload.len()\n1106\t            );\n1107\t        }\n1108\t    }\n1109\t}\n1110\t\n1111\t/// `LZ4F_read` consumes the underlying `FILE*` in `srcBufMaxSize` gulps; after\n1112\t/// a complete read both libraries must have left the stream at EOF. Uses raw\n1113\t/// stdio (`fseek`/`ftell`/`fread`/`fwrite`/`fflush`) directly.\n1114\t#[test]\n1115\tfn row_162_stdio_stream_position_after_full_read() {\n1116\t    unsafe {\n1117\t        let (c, r) = apis();\n1118\t        let mut rng = Rng::new(162_000);\n1119\t        let payload = gen(&mut rng, Shape::TextLike, 250_000);\n1120\t        let (sc, sr) = scratch_pair(\"ftell\");\n1121\t        assert_ok(\"writeClose (C)\", drive_write(&c, sc.path(), None, &[&payload]).close);\n1122\t        assert_ok(\"writeClose (Rust)\", drive_write(&r, sr.path(), None, &[&payload]).close);\n1123\t\n1124\t        // raw stdio read-back must match what std::fs sees\n1125\t        assert_eq!(read_raw(sc.path()), sc.bytes(), \"row162: raw read-back mismatch (C)\");\n1126\t        same_full_buffers(\"row162 frame bytes\", &read_raw(sc.path()), &read_raw(sr.path()));\n1127\t        let file_len = sc.bytes().len();\n1128\t\n1129\t        let mut tells = Vec::new();\n1130\t        for api in [&c, &r] {\n1131\t            let path = if api.tag == \"C\" { sc.path() } else { sr.path() };\n1132\t            let fp = open_file(path, \"rb\");\n1133\t            let mut h: *mut c_void = ptr::null_mut();\n1134\t            assert_eq!((api.ropen)(&mut h, fp), 0);\n1135\t            let mut out = vec![0u8; payload.len() + 100];\n1136\t            let mut got = 0usize;\n1137\t            loop {\n1138\t                let n = (api.read)(h, out[got..].as_mut_ptr() as *mut c_void, 65536);\n1139\t                assert!(!is_err_range(n), \"{}: LZ4F_read error {n:#x}\", api.tag);\n1140\t                if n == 0 {\n1141\t                    break;\n1142\t                }\n1143\t                got += n;\n1144\t            }\n1145\t            assert_eq!(got, payload.len(), \"{}: short round-trip\", api.tag);\n1146\t            assert_eq!(&out[..got], &payload[..], \"{}: content mismatch\", api.tag);\n1147\t            assert_eq!((api.rclose)(h), 0, \"{}: readClose\", api.tag);\n1148\t            tells.push(ftell(fp));\n1149\t            fclose(fp);\n1150\t        }\n1151\t        assert_eq!(\n1152\t            tells[0], tells[1],\n1153\t            \"row162: stream position after a full read differs (C={} Rust={})\",\n1154\t            tells[0], tells[1]\n1155\t        );\n1156\t        assert_eq!(\n1157\t            tells[0] as usize, file_len,\n1158\t            \"row162: expected the whole {file_len}-byte file to be consumed, ftell={}\",\n1159\t            tells[0]\n1160\t        );\n1161\t    }\n1162\t}\n1163\t\n1164\t#[test]\n1165\tfn row_162_read_linked_independent_and_checksums() {\n1166\t    unsafe {\n1167\t        let mut rng = Rng::new(1620);\n1168\t        let payload = gen(&mut rng, Shape::TextLike, 400_000);\n1169\t        for bm in [LZ4F_BLOCK_LINKED, LZ4F_BLOCK_INDEPENDENT] {\n1170\t            for cc in [LZ4F_NO_CONTENT_CHECKSUM, LZ4F_CONTENT_CHECKSUM_ENABLED] {\n1171\t                for bc in [LZ4F_NO_BLOCK_CHECKSUM, LZ4F_BLOCK_CHECKSUM_ENABLED] {\n1172\t                    for bsid in [LZ4F_MAX64KB, LZ4F_MAX256KB] {\n1173\t                        let mut p = LZ4F_preferences_t::default();\n1174\t                        p.frameInfo.blockSizeID = bsid;\n1175\t                        p.frameInfo.blockMode = bm;\n1176\t                        p.frameInfo.contentChecksumFlag = cc;\n1177\t                        p.frameInfo.blockChecksumFlag = bc;\n1178\t                        roundtrip(\n1179\t                            &format!(\"row162 bm={bm} cc={cc} bc={bc} bsid={bsid}\"),\n1180\t                            Some(&p),\n1181\t                            &[&payload],\n1182\t                            &[1, 9999, 70_000],\n1183\t                        );\n1184\t                    }\n1185\t                }\n1186\t            }\n1187\t        }\n1188\t    }\n1189\t}\n1190\t\n1191\t#[test]\n1192\tfn row_162_read_and_readClose_null_parameters() {\n1193\t    unsafe {\n1194\t        let (c, r) = apis();\n1195\t        let mut rng = Rng::new(16200);\n1196\t        let payload = gen(&mut rng, Shape::Compressible, 3000);\n1197\t        let (sc, sr) = scratch_pair(\"read_null\");\n1198\t        assert_ok(\"writeClose (C)\", drive_write(&c, sc.path(), None, &[&payload]).close);\n1199\t        assert_ok(\"writeClose (Rust)\", drive_write(&r, sr.path(), None, &[&payload]).close);\n1200\t\n1201\t        let fpc = open_file(sc.path(), \"rb\");\n1202\t        let fpr = open_file(sr.path(), \"rb\");\n1203\t        let mut hc: *mut c_void = ptr::null_mut();\n1204\t        let mut hr: *mut c_void = ptr::null_mut();\n1205\t        assert_eq!((c.ropen)(&mut hc, fpc), 0);\n1206\t        assert_eq!((r.ropen)(&mut hr, fpr), 0);\n1207\t\n1208\t        // buf == NULL, both with size 0 and non-zero\n1209\t        for &n in &[0usize, 1, 100] {\n1210\t            let a = (c.read)(hc, ptr::null_mut(), n);\n1211\t            let b = (r.read)(hr, ptr::null_mut(), n);\n1212\t            assert_eq!(\n1213\t                a as isize, b as isize,\n1214\t                \"row162: LZ4F_read(buf=NULL,size={n}) C={a:#x} Rust={b:#x}\"\n1215\t            );\n1216\t            assert_eq!(\n1217\t                a,\n1218\t                err(21),\n1219\t                \"row162: LZ4F_read(buf=NULL,size={n}) must be err(21), got {a:#x}\"\n1220\t            );\n1221\t        }\n1222\t        // handle == NULL\n1223\t        let mut buf = [0u8; 16];\n1224\t        let a = (c.read)(ptr::null_mut(), buf.as_mut_ptr() as *mut c_void, 16);\n1225\t        let b = (r.read)(ptr::null_mut(), buf.as_mut_ptr() as *mut c_void, 16);\n1226\t        assert_eq!(a as isize, b as isize, \"row162: LZ4F_read(handle=NULL)\");\n1227\t        assert_eq!(a, err(21));\n1228\t        let a = (c.read)(ptr::null_mut(), ptr::null_mut(), 0);\n1229\t        let b = (r.read)(ptr::null_mut(), ptr::null_mut(), 0);\n1230\t        assert_eq!(a as isize, b as isize);\n1231\t        assert_eq!(a, err(21));\n1232\t\n1233\t        // the rejected reads must not have disturbed the stream\n1234\t        let mut out = vec![0u8; payload.len()];\n1235\t        let a = (c.read)(hc, out.as_mut_ptr() as *mut c_void, payload.len());\n1236\t        assert_eq!(a, payload.len(), \"row162: read after rejected calls (C)\");\n1237\t        assert_eq!(out, payload);\n1238\t        let mut out2 = vec![0u8; payload.len()];\n1239\t        let b = (r.read)(hr, out2.as_mut_ptr() as *mut c_void, payload.len());\n1240\t        assert_eq!(b, payload.len(), \"row162: read after rejected calls (Rust)\");\n1241\t        assert_eq!(out2, payload);\n1242\t\n1243\t        assert_eq!((c.rclose)(hc) as isize, (r.rclose)(hr) as isize, \"row162: readClose\");\n1244\t        fclose(fpc);\n1245\t        fclose(fpr);\n1246\t\n1247\t        // readClose(NULL) -> parameter_null\n1248\t        let a = (c.rclose)(ptr::null_mut());\n1249\t        let b = (r.rclose)(ptr::null_mut());\n1250\t        assert_eq!(a as isize, b as isize, \"row162: readClose(NULL) C={a:#x} Rust={b:#x}\");\n1251\t        assert_eq!(a, err(21), \"row162: readClose(NULL) must be err(21), got {a:#x}\");\n1252\t    }\n1253\t}\n1254\t\n1255\t/// ERRORS row 169 — an error from `LZ4F_decompress` is returned verbatim by\n1256\t/// `LZ4F_read`.\n1257\t#[test]\n1258\tfn row_162_errors_169_read_forwards_decompress_errors() {\n1259\t    unsafe {\n1260\t        let (c, r) = apis();\n1261\t        let mut rng = Rng::new(169);\n1262\t        let payload = gen(&mut rng, Shape::TextLike, 50_000);\n1263\t\n1264\t        // block checksums on: corrupting a payload byte must be detected\n1265\t        let mut p = LZ4F_preferences_t::default();\n1266\t        p.frameInfo.blockChecksumFlag = LZ4F_BLOCK_CHECKSUM_ENABLED;\n1267\t        p.frameInfo.contentChecksumFlag = LZ4F_CONTENT_CHECKSUM_ENABLED;\n1268\t\n1269\t        let (sc, sr) = scratch_pair(\"corrupt\");\n1270\t        assert_ok(\"writeClose (C)\", drive_write(&c, sc.path(), Some(&p), &[&payload]).close);\n1271\t        assert_ok(\"writeClose (Rust)\", drive_write(&r, sr.path(), Some(&p), &[&payload]).close);\n1272\t        let mut bc = sc.bytes();\n1273\t        let mut br = sr.bytes();\n1274\t        same_full_buffers(\"row162 corrupt base bytes\", &bc, &br);\n1275\t        // flip a bit well inside the first block's compressed payload\n1276\t        let idx = 40;\n1277\t        bc[idx] ^= 0x55;\n1278\t        br[idx] ^= 0x55;\n1279\t        write_raw(sc.path(), &bc);\n1280\t        write_raw(sr.path(), &br);\n1281\t\n1282\t        let a = drive_read(&c, sc.path(), &[4096], payload.len() + 1);\n1283\t        let b = drive_read(&r, sr.path(), &[4096], payload.len() + 1);\n1284\t        assert_eq!(a.open as isize, b.open as isize, \"row162 corrupt: readOpen\");\n1285\t        assert_eq!(\n1286\t            a.reads.iter().map(|&x| x as isize).collect::<Vec<_>>(),\n1287\t            b.reads.iter().map(|&x| x as isize).collect::<Vec<_>>(),\n1288\t            \"row162 corrupt: LZ4F_read returns differ (C={:#x?} Rust={:#x?})\",\n1289\t            a.reads,\n1290\t            b.reads\n1291\t        );\n1292\t        assert!(\n1293\t            a.reads.iter().any(|&x| is_err_range(x)),\n1294\t            \"row162 corrupt: expected LZ4F_read to report an error, got {:#x?}\",\n1295\t            a.reads\n1296\t        );\n1297\t        assert_eq!(a.close, b.close, \"row162 corrupt: readClose\");\n1298\t\n1299\t        // truncated frame (endMark and content checksum cut off) must behave\n1300\t        // identically in both libraries\n1301\t        let (sc2, sr2) = scratch_pair(\"truncated\");\n1302\t        write_raw(sc2.path(), &bc[..bc.len() / 2]);\n1303\t        write_raw(sr2.path(), &br[..br.len() / 2]);\n1304\t        let a = drive_read(&c, sc2.path(), &[4096], payload.len() + 1);\n1305\t        let b = drive_read(&r, sr2.path(), &[4096], payload.len() + 1);\n1306\t        assert_eq!(a.open as isize, b.open as isize, \"row162 truncated: readOpen\");\n1307\t        assert_eq!(\n1308\t            a.reads.iter().map(|&x| x as isize).collect::<Vec<_>>(),\n1309\t            b.reads.iter().map(|&x| x as isize).collect::<Vec<_>>(),\n1310\t            \"row162 truncated: LZ4F_read returns differ\"\n1311\t        );\n1312\t        same_full_buffers(\"row162 truncated payload\", &a.data, &b.data);\n1313\t        assert_eq!(a.close, b.close, \"row162 truncated: readClose\");\n1314\t    }\n1315\t}\n1316\t\n1317\t// ===========================================================================\n1318\t// Property-style randomized round-trips (rows 157..162 combined)\n1319\t// ===========================================================================\n1320\t\n1321\t#[test]\n1322\tfn rows_157_158_159_160_161_162_randomized_property_roundtrips() {\n1323\t    unsafe {\n1324\t        let mut rng = Rng::new(0xF11E_5EED);\n1325\t        for iter in 0..40 {\n1326\t            // random payload\n1327\t            let shape = ALL_SHAPES[rng.below(ALL_SHAPES.len())];\n1328\t            let len = match rng.below(4) {\n1329\t                0 => rng.range(0, 64),\n1330\t                1 => rng.range(0, 70_000),\n1331\t                2 => rng.range(60_000, 300_000),\n1332\t                _ => rng.range(0, 5000),\n1333\t            };\n1334\t            let payload = gen(&mut rng, shape, len);\n1335\t\n1336\t            // random preferences (contentSize either unknown or exact)\n1337\t            let use_prefs = rng.below(4) != 0;\n1338\t            let mut p = LZ4F_preferences_t::default();\n1339\t            if use_prefs {\n1340\t                p.frameInfo.blockSizeID =\n1341\t                    [LZ4F_DEFAULT, LZ4F_MAX64KB, LZ4F_MAX256KB, LZ4F_MAX1MB, LZ4F_MAX4MB]\n1342\t                        [rng.below(5)];\n1343\t                p.frameInfo.blockMode = [LZ4F_BLOCK_LINKED, LZ4F_BLOCK_INDEPENDENT][rng.below(2)];\n1344\t                p.frameInfo.contentChecksumFlag = rng.below(2) as c_uint;\n1345\t                p.frameInfo.blockChecksumFlag = rng.below(2) as c_uint;\n1346\t                p.frameInfo.dictID = if rng.below(2) == 0 { 0 } else { rng.next_u32() };\n1347\t                p.frameInfo.contentSize = if rng.below(2) == 0 { 0 } else { len as u64 };\n1348\t                p.compressionLevel = [0i32, 1, 2, -1, 9, 10, 12][rng.below(7)];\n1349\t                p.autoFlush = rng.below(2) as c_uint;\n1350\t                p.favorDecSpeed = rng.below(2) as c_uint;\n1351\t            }\n1352\t\n1353\t            // random write chunking\n1354\t            let mut offs = Vec::new();\n1355\t            let mut off = 0usize;\n1356\t            while off < len {\n1357\t                let cap = rng.range(1, 200_000);\n1358\t                let n = rng.range(1, (len - off).min(cap));\n1359\t                offs.push((off, n));\n1360\t                off += n;\n1361\t            }\n1362\t            if offs.is_empty() {\n1363\t                offs.push((0, 0));\n1364\t            }\n1365\t            let chunks: Vec<&[u8]> = offs.iter().map(|&(o, n)| &payload[o..o + n]).collect();\n1366\t\n1367\t            // random read chunking\n1368\t            let mut sizes = Vec::new();\n1369\t            for _ in 0..rng.range(1, 5) {\n1370\t                sizes.push(rng.range(1, 200_000));\n1371\t            }\n1372\t            if rng.below(3) == 0 {\n1373\t                sizes.insert(0, 0);\n1374\t            }\n1375\t\n1376\t            roundtrip(\n1377\t                &format!(\"property iter={iter} shape={shape:?} len={len} prefs={use_prefs}\"),\n1378\t                if use_prefs { Some(&p) } else { None },\n1379\t                &chunks,\n1380\t                &sizes,\n1381\t            );\n1382\t        }\n1383\t    }\n1384\t}\n1385\t\n1386\t/// ERRORS rows 161/162/166/172/174/175/176 (allocation and inner-context\n1387\t/// failures) cannot be triggered without an allocator hook, and row 168\n1388\t/// (`fread` \"negative\" branch) is unreachable because `ret` is a `size_t`.\n1389\t/// This test pins the reachable consequence of row 168's neighbourhood: a\n1390\t/// zero-length `fread` at EOF breaks the loop and yields a short count rather\n1391\t/// than `err(23)`.\n1392\t#[test]\n1393\tfn errors_168_eof_yields_short_count_not_io_read() {\n1394\t    unsafe {\n1395\t        let (c, r) = apis();\n1396\t        let mut rng = Rng::new(168);\n1397\t        let payload = gen(&mut rng, Shape::Compressible, 12_345);\n1398\t        let (sc, sr) = scratch_pair(\"eof\");\n1399\t        assert_ok(\"writeClose (C)\", drive_write(&c, sc.path(), None, &[&payload]).close);\n1400\t        assert_ok(\"writeClose (Rust)\", drive_write(&r, sr.path(), None, &[&payload]).close);\n1401\t\n1402\t        let a = drive_read(&c, sc.path(), &[payload.len() * 3], payload.len() + 1);\n1403\t        let b = drive_read(&r, sr.path(), &[payload.len() * 3], payload.len() + 1);\n1404\t        assert_eq!(\n1405\t            a.reads.iter().map(|&x| x as isize).collect::<Vec<_>>(),\n1406\t            b.reads.iter().map(|&x| x as isize).collect::<Vec<_>>(),\n1407\t            \"errors168: read returns differ\"\n1408\t        );\n1409\t        assert_eq!(\n1410\t            a.reads[0],\n1411\t            payload.len(),\n1412\t            \"errors168: expected a short count of {}, got {:#x}\",\n1413\t            payload.len(),\n1414\t            a.reads[0]\n1415\t        );\n1416\t        assert!(!is_err_range(a.reads[0]), \"errors168: EOF must not be err(23)\");\n1417\t        assert_eq!(a.data, payload);\n1418\t        assert_eq!(b.data, payload);\n1419\t    }\n1420\t}\n1421\t"}]},"parent_tool_use_id":"toolu_bdrk_01MdG8SwhrzW1VX5kmi793uD","session_id":"e6275ffd-eea5-4c85-9a55-8638b42a0b62","uuid":"5fdb9bfb-cef7-42bc-98ab-4a95da8812df","timestamp":"2026-08-31T06:18:17.336Z","subagent_type":"general-purpose","task_description":"Write lz4frame decompression tests"}
