{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_013bSWVjefsEAPqdw7BoSz3B","type":"tool_result","content":"1720\t                    let tag = format!(\"cont dirty #{i} level={level} shape={shape:?}\");\n1721\t                    let (_ri, dic, dir) = cont_pair(\n1722\t                        l,\n1723\t                        &tag,\n1724\t                        &s,\n1725\t                        whole[i * blk..].as_ptr(),\n1726\t                        blk,\n1727\t                        bound,\n1728\t                    );\n1729\t                    same_full_buffers(&tag, &dic, &dir);\n1730\t                }\n1731\t                // explicit reset recovers\n1732\t                stream_call(l, \"LZ4_resetStreamHC_fast\", &s, level);\n1733\t                let tag = format!(\"cont after reset level={level} shape={shape:?}\");\n1734\t                let (r6, d6c, d6r) = cont_pair(l, &tag, &s, whole.as_ptr(), blk, bound);\n1735\t                assert!(r6 > 0, \"{tag}: expected success\");\n1736\t                dec_cross_dict(l, &tag, &d6c, &d6r, r6, &whole[..blk], &[]);\n1737\t                free_streams(l, s);\n1738\t            }\n1739\t        }\n1740\t    }\n1741\t}\n1742\t\n1743\t#[test]\n1744\tfn row_96_continue_two_gb_overflow_reanchor() {\n1745\t    let l = libs();\n1746\t    unsafe {\n1747\t        // Each failing call advances ctx->end by srcSize and the following\n1748\t        // (non-contiguous) call folds that into dictLimit, so dictLimit grows by\n1749\t        // 64 MB per round and crosses the 2 GB automatic-re-anchor threshold\n1750\t        // after 32 rounds -- without ever compressing 2 GB of data.\n1751\t        let mut rng = Rng::new(96);\n1752\t        let n = 64 * 1024 * 1024usize;\n1753\t        let src = gen_incompressible(&mut rng, n);\n1754\t        let s = create_streams(l);\n1755\t        stream_call(l, \"LZ4_resetStreamHC_fast\", &s, LZ4HC_CLEVEL_MIN);\n1756\t        for i in 0..40 {\n1757\t            let tag = format!(\"2GB overflow round #{i}\");\n1758\t            let (ret, dc, dr) = cont_pair(l, &tag, &s, src.as_ptr(), n, 0);\n1759\t            assert_eq!(ret, 0, \"{tag}: expected failure with dstCapacity 0\");\n1760\t            same_full_buffers(&tag, &dc, &dr);\n1761\t        }\n1762\t        // after the re-anchor a normal block must still compress identically\n1763\t        let small = gen(&mut rng, Shape::TextLike, 20_000);\n1764\t        let cap = cbound(l, 20_000) as usize;\n1765\t        let tag = \"2GB overflow: block after re-anchor\";\n1766\t        let (ret, dc, dr) = cont_pair(l, tag, &s, small.as_ptr(), 20_000, cap);\n1767\t        assert!(ret > 0, \"{tag}: expected success\");\n1768\t        same_full_buffers(tag, &dc, &dr);\n1769\t        free_streams(l, s);\n1770\t    }\n1771\t}\n1772\t\n1773\t// ===========================================================================\n1774\t// Row 97-100 : attach dictionary, continue_destSize, saveDictHC\n1775\t// ===========================================================================\n1776\t\n1777\t#[test]\n1778\tfn row_97_attach_hc_dictionary_paths() {\n1779\t    let l = libs();\n1780\t    unsafe {\n1781\t        let (ac, ar) = l.sym::<FnAttachHC>(\"LZ4_attach_HC_dictionary\");\n1782\t        let mut rng = Rng::new(97);\n1783\t        let dict = gen(&mut rng, Shape::TextLike, 60_000);\n1784\t        // (dict level, working level, first block size)\n1785\t        let cases: [(c_int, c_int, usize); 10] = [\n1786\t            (9, 9, 5000),      // position 0, > 4 KB, compatible -> memcpy path\n1787\t            (9, 9, 70_000),    // same, large block\n1788\t            (12, 12, 8000),    // compatible (both optimal)\n1789\t            (9, 12, 9000),     // compatible (both non-mid)\n1790\t            (2, 2, 6000),      // compatible (both mid)\n1791\t            (2, 9, 6000),      // INcompatible -> usingDictCtxHc\n1792\t            (9, 2, 6000),      // INcompatible -> usingDictCtxHc\n1793\t            (2, 12, 7000),     // INcompatible\n1794\t            (9, 9, 3000),      // position 0 but <= 4 KB -> usingDictCtxHc\n1795\t            (2, 2, 1000),      // small block, mid dictCtx\n1796\t        ];\n1797\t        for (i, &(dl, wl, n)) in cases.iter().enumerate() {\n1798\t            let ds = create_streams(l);\n1799\t            stream_call(l, \"LZ4_setCompressionLevel\", &ds, dl);\n1800\t            let tag = format!(\"attach #{i} dictLvl={dl} workLvl={wl} n={n}\");\n1801\t            assert_eq!(load_dict(l, &tag, &ds, &dict), 60_000);\n1802\t\n1803\t            let ws = create_streams(l);\n1804\t            stream_call(l, \"LZ4_resetStreamHC_fast\", &ws, wl);\n1805\t            ac(ws.c, ds.c as *const c_void);\n1806\t            ar(ws.r, ds.r as *const c_void);\n1807\t\n1808\t            // block built from dictionary fragments so the dictCtx is used\n1809\t            let mut blk = Vec::new();\n1810\t            let mut o = 1000usize;\n1811\t            while blk.len() < n {\n1812\t                let take = (n - blk.len()).min(400);\n1813\t                blk.extend_from_slice(&dict[o..o + take]);\n1814\t                blk.extend_from_slice(&gen_incompressible(&mut rng, 7));\n1815\t                o = (o + 977) % 50_000;\n1816\t            }\n1817\t            blk.truncate(n);\n1818\t            let cap = cbound(l, n as c_int) as usize;\n1819\t            let (ret, dc, dr) = cont_pair(l, &tag, &ws, blk.as_ptr(), n, cap);"}]},"parent_tool_use_id":"toolu_bdrk_0189HqSEkrEA5n2sEQAkrBNS","session_id":"e6275ffd-eea5-4c85-9a55-8638b42a0b62","uuid":"dbdc49c0-2c3e-4ad1-8a20-52eb4b4a77e5","timestamp":"2026-08-31T05:54:08.512Z","subagent_type":"general-purpose","task_description":"Write lz4hc differential tests"}
