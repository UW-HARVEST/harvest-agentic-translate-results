\tpub const LZ4F_MAX4MB: c_uint = 7;\n268\t\n269\tpub const LZ4F_BLOCK_LINKED: c_uint = 0;\n270\tpub const LZ4F_BLOCK_INDEPENDENT: c_uint = 1;\n271\t\n272\tpub const LZ4F_NO_CONTENT_CHECKSUM: c_uint = 0;\n273\tpub const LZ4F_CONTENT_CHECKSUM_ENABLED: c_uint = 1;\n274\t\n275\tpub const LZ4F_NO_BLOCK_CHECKSUM: c_uint = 0;\n276\tpub const LZ4F_BLOCK_CHECKSUM_ENABLED: c_uint = 1;\n277\t\n278\tpub const LZ4F_FRAME: c_uint = 0;\n279\tpub const LZ4F_SKIPPABLE_FRAME: c_uint = 1;\n280\t\n281\tpub const LZ4F_VERSION: c_uint = 100;\n282\t\n283\tpub const LZ4_MAX_INPUT_SIZE: usize = 0x7E000000;\n284\tpub const LZ4HC_CLEVEL_MIN: c_int = 2;\n285\tpub const LZ4HC_CLEVEL_DEFAULT: c_int = 9;\n286\tpub const LZ4HC_CLEVEL_OPT_MIN: c_int = 10;\n287\tpub const LZ4HC_CLEVEL_MAX: c_int = 12;\n288\t\n289\t/// `(size_t)-code` — how lz4frame reports `LZ4F_errorCodes`.\n290\tpub fn err(code: usize) -> usize {\n291\t    (0usize).wrapping_sub(code)\n292\t}\n293\t\n294\t/// True when `r` is in the lz4frame error range `[(size_t)-23 ..= (size_t)-1]`.\n295\tpub fn is_err_range(r: usize) -> bool {\n296\t    r > err(24)\n297\t}\n298\t\n299\t// ---------------------------------------------------------------------------\n300\t// Common FFI signatures\n301\t// ---------------------------------------------------------------------------\n302\t\n303\tpub type FnCompressDefault =\n304\t    unsafe extern \"C\" fn(*const c_char, *mut c_char, c_int, c_int) -> c_int;\n305\tpub type FnCompressFast =\n306\t    unsafe extern \"C\" fn(*const c_char, *mut c_char, c_int, c_int, c_int) -> c_int;\n307\tpub type FnCompressBound = unsafe extern \"C\" fn(c_int) -> c_int;\n308\tpub type FnDecompressSafe =\n309\t    unsafe extern \"C\" fn(*const c_char, *mut c_char, c_int, c_int) -> c_int;\n310\tpub type FnDecompressSafePartial =\n311\t    unsafe extern \"C\" fn(*const c_char, *mut c_char, c_int, c_int, c_int) -> c_int;\n312\tpub type FnDecompressFast =\n313\t    unsafe extern \"C\" fn(*const c_char, *mut c_char, c_int) -> c_int;\n314\tpub type FnCompressDestSize =\n315\t    unsafe extern \"C\" fn(*const c_char, *mut c_char, *mut c_int, c_int) -> c_int;\n316\tpub type FnVoidToInt = unsafe extern \"C\" fn() -> c_int;\n317\tpub type FnPtrToInt = unsafe extern \"C\" fn(*mut c_void) -> c_int;\n318\tpub type FnVoidToPtr = unsafe extern \"C\" fn() -> *mut c_void;\n319\tpub type FnFreePtr = unsafe extern \"C\" fn(*mut c_void) -> c_int;\n320\t\n321\t// ---------------------------------------------------------------------------\n322\t// Assertion helpers with rich diagnostics\n323\t// ---------------------------------------------------------------------------\n324\t\n325\tpub fn hexdump(b: &[u8]) -> String {\n326\t    let n = b.len().min(96);\n327\t    let mut s = String::new();\n328\t    for x in &b[..n] {\n329\t        s.push_str(&format!(\"{x:02x}\"));\n330\t    }\n331\t    if b.len() > n {\n332\t        s.push_str(&format!(\"...(+{} bytes)\", b.len() - n));\n333\t    }\n334\t    s\n335\t}\n336\t\n337\tpub fn first_diff(a: &[u8], b: &[u8]) -> Option<usize> {\n338\t    let n = a.len().min(b.len());\n339\t    for i in 0..n {\n340\t        if a[i] != b[i] {\n341\t            return Some(i);\n342\t        }\n343\t    }\n344\t    if a.len() != b.len() {\n345\t        Some(n)\n346\t    } else {\n347\t        None\n348\t    }\n349\t}\n350\t\n351\t/// Assert two returned integers and two output buffers agree byte-for-byte.\n352\t#[track_caller]\n353\tpub fn same_int_and_bytes(ctx: &str, cr: c_int, rr: c_int, cb: &[u8], rb: &[u8]) {\n354\t    assert_eq!(cr, rr, \"{ctx}: return value mismatch (C={cr} Rust={rr})\");\n355\t    if cr > 0 {\n356\t        let n = cr as usize;\n357\t        let (ca, ra) = (&cb[..n.min(cb.len())], &rb[..n.min(rb.len())]);\n358\t        if let Some(i) = first_diff(ca, ra) {\n359\t            panic!(\n360\t                \"{ctx}: output bytes differ at index {i} (ret={cr})\\n  C   : {}\\n  Rust: {}\",\n361\t                hexdump(&ca[i.saturating_sub(8)..]),\n362\t                hexdump(&ra[i.saturating_sub(8)..])\n363\t            );\n364\t        }\n365\t    }\n366\t}\n367\t\n368\t#[track_caller]\n369\tpub fn same_usize_and_bytes(ctx: &str, cr: usize, rr: usize, cb: &[u8], rb: &[u8]) {\n370\t    assert_eq!(\n371\t        cr as i64 as isize, rr as i64 as isize,\n372\t        \"{ctx}: return value mismatch (C={} Rust={}, as signed C={} Rust={})\",\n373\t        cr, rr, cr as isize, rr as isize\n374\t    );\n375\t    if !is_err_range(cr) && cr > 0 {\n376\t        let n = cr.min(cb.len()).min(rb.len());\n377\t        if let Some(i) = first_diff(&cb[..n], &rb[..n]) {\n378\t            panic!(\n379\t                \"{ctx}: output bytes differ at index {i} (ret={cr})\\n  C   : {}\\n  Rust: {}\",\n380\t                hexdump(&cb[i.saturating_sub(8)..n]),\n381\t                hexdump(&rb[i.saturating_sub(8)..n])\n382\t            );\n383\t        }\n384\t    }\n385\t}\n386\t\n387\t/// Assert whole buffers are identical regardless of the return value — used to\n388\t/// prove neither implementation scribbles differently outside the reported\n389\t/// output length.\n390\t#[track_caller]\n391\tpub fn same_full_buffers(ctx: &str, cb: &[u8], rb: &[u8]) {\n392\t    if let Some(i) = first_diff(cb, rb) {\n393\t        panic!(\n394\t            \"{ctx}: full destination buffers differ at index {i}\\n  C   : {}\\n  Rust: {}\",\n395\t            hexdump(&cb[i.saturating_sub(8)..]),\n396\t            hexdump(&rb[i.saturating_sub(8)..])\n397\t        );\n398\t    }\n399\t}\n400\t"}]},"parent_tool_use_id":"toolu_bdrk_01KSNLmugTPJuXaNtEEcWiyX","session_id":"e6275ffd-eea5-4c85-9a55-8638b42a0b62","uuid":"f2c29647-cf37-40e7-8ac8-b0d6b2204fd1","timestamp":"2026-08-31T05:35:29.058Z","subagent_type":"general-purpose","task_description":"Write xxhash and lz4file tests"}
