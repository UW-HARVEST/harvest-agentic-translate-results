{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01VddHafAATpzS1TUZbzdewD","type":"tool_result","content":"1811\t\n1812\t// ===========================================================================\n1813\t// Row 27 — token nibble == 15 with multi-255 extension bytes\n1814\t// ===========================================================================\n1815\t\n1816\t#[test]\n1817\tfn row_27_token_15_multi255_extensions() {\n1818\t    let mut rng = Rng::new(27);\n1819\t\n1820\t    // Literal lengths straddling every 255 boundary.\n1821\t    for k in 0..8usize {\n1822\t        for d in 0..3usize {\n1823\t            let ll = 15 + k * 255 + d;\n1824\t            let lits = rand_lits(&mut rng, ll);\n1825\t            let mut b = Blk::new();\n1826\t            b.seq(&lits, rng.range(1, 16), 4 + rng.below(20));\n1827\t            let tail = rand_lits_range(&mut rng, (5, 30));\n1828\t            let (comp, plain) = b.finish(&tail);\n1829\t            let ctx = format!(\"row27 ll={ll} out={}\", plain.len());\n1830\t            let (ret, out) = diff_decompress_safe(&ctx, &comp, comp.len() as c_int, plain.len());\n1831\t            assert_eq!(ret as usize, plain.len(), \"{ctx}: ret {ret}\");\n1832\t            assert!(out[..plain.len()] == plain[..], \"{ctx}: plaintext mismatch\");\n1833\t        }\n1834\t    }\n1835\t\n1836\t    // Match lengths straddling every 255 boundary (token ML nibble == 15).\n1837\t    for k in 0..8usize {\n1838\t        for d in 0..3usize {\n1839\t            let ml = 19 + k * 255 + d; // ml - 4 >= 15\n1840\t            let head = rand_lits_range(&mut rng, (4, 40));\n1841\t            let mut b = Blk::new();\n1842\t            let off = rng.range(1, head.len().max(1));\n1843\t            b.seq(&head, off, ml);\n1844\t            let tail = rand_lits_range(&mut rng, (5, 30));\n1845\t            let (comp, plain) = b.finish(&tail);\n1846\t            let ctx = format!(\"row27 ml={ml} off={off} out={}\", plain.len());\n1847\t            let (ret, out) = diff_decompress_safe(&ctx, &comp, comp.len() as c_int, plain.len());\n1848\t            assert_eq!(ret as usize, plain.len(), \"{ctx}: ret {ret}\");\n1849\t            assert!(out[..plain.len()] == plain[..], \"{ctx}: plaintext mismatch\");\n1850\t        }\n1851\t    }\n1852\t\n1853\t    // Both nibbles == 15 in the same token, plus a final literal run >= 15.\n1854\t    for _ in 0..40 {\n1855\t        let ll = rng.range(15, 1200);\n1856\t        let ml = rng.range(19, 1500);\n1857\t        let lits = rand_lits(&mut rng, ll);\n1858\t        let mut b = Blk::new();\n1859\t        b.seq(&lits, rng.range(1, ll.min(65535)), ml);\n1860\t        let tail = rand_lits_range(&mut rng, (15, 900));"}]},"parent_tool_use_id":"toolu_bdrk_017SZTSCokiHMF65SBLwxB1T","session_id":"e6275ffd-eea5-4c85-9a55-8638b42a0b62","uuid":"7e3528c5-7ffe-460c-8035-87cda692a158","timestamp":"2026-08-31T05:48:18.787Z","subagent_type":"general-purpose","task_description":"Write lz4 block differential tests"}
