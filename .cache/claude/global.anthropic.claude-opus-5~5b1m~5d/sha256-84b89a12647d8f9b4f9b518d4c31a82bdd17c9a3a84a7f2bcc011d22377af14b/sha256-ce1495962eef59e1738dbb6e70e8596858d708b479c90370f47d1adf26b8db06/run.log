{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_016btYRMLU8uwGVnMQWVVBrd","type":"tool_result","content":"1640\t#[test]\n1641\tfn row_24_fastloop_safe_distance() {\n1642\t    let mut rng = Rng::new(24);\n1643\t\n1644\t    // Outputs strictly below / around 64 bytes: safe loop only.\n1645\t    for out_len in 5..=140usize {\n1646\t        for rep in 0..2 {\n1647\t            // Literals-only block of exactly `out_len` bytes.\n1648\t            let lits = rand_lits(&mut rng, out_len);\n1649\t            let (comp, plain) = Blk::new().finish(&lits);\n1650\t            assert_eq!(plain.len(), out_len);\n1651\t            let ctx = format!(\"row24 literals out={out_len} rep{rep}\");\n1652\t            let (ret, out) = diff_decompress_safe(&ctx, &comp, comp.len() as c_int, out_len);\n1653\t            assert_eq!(ret as usize, out_len, \"{ctx}: ret {ret}\");\n1654\t            assert!(out[..out_len] == plain[..]);\n1655\t\n1656\t            // A block with one match, tuned to end just under/over the limit.\n1657\t            if out_len >= 24 {\n1658\t                let head = rand_lits(&mut rng, 8);\n1659\t                let mut b = Blk::new();\n1660\t                b.seq(&head, rng.range(1, 8), 4 + rng.below(6));\n1661\t                let produced = b.p.len();\n1662\t                if out_len > produced + 5 {\n1663\t                    let tail = rand_lits(&mut rng, out_len - produced);\n1664\t                    let (comp, plain) = b.finish(&tail);\n1665\t                    let ctx = format!(\"row24 match out={out_len} rep{rep}\");\n1666\t                    let (ret, out) =\n1667\t                        diff_decompress_safe(&ctx, &comp, comp.len() as c_int, plain.len());\n1668\t                    assert_eq!(ret as usize, plain.len(), \"{ctx}: ret {ret}\");\n1669\t                    assert!(out[..plain.len()] == plain[..]);\n1670\t                }\n1671\t            }\n1672\t        }\n1673\t    }\n1674\t    assert_eq!(FASTLOOP_SAFE_DISTANCE, 64);\n1675\t\n1676\t    // Outputs far above 64 bytes: fast loop then safe tail.\n1677\t    for _ in 0..40 {\n1678\t        let nseq = rng.range(10, 60);\n1679\t        let (comp, plain) = build_block(\n1680\t            &mut rng,\n1681\t            nseq,\n1682\t            &[1, 2, 3, 4, 5, 6, 7, 8, 12, 16, 20, 64, 200, 1000],\n1683\t            (0, 30),\n1684\t            (4, 60),\n1685\t            (5, 40),\n1686\t        );\n1687\t        let ctx = format!(\"row24 big nseq={nseq} out={}\", plain.len());\n1688\t        let (ret, out) = diff_decompress_safe(&ctx, &comp, comp.len() as c_int, plain.len());\n1689\t        assert_eq!(ret as usize, plain.len(), \"{ctx}: ret {ret}\");\n1690\t        assert!(out[..plain.len()] == plain[..], \"{ctx}: plaintext mismatch\");\n1691\t    }\n1692\t}\n1693\t\n1694\t// ===========================================================================\n1695\t// Row 25 — match offsets 1, 2 and 4 (LZ4_memcpy_using_offset special cases)\n1696\t// ===========================================================================\n1697\t\n1698\t#[test]\n1699\tfn row_25_offsets_1_2_4() {"}]},"parent_tool_use_id":"toolu_bdrk_017SZTSCokiHMF65SBLwxB1T","session_id":"e6275ffd-eea5-4c85-9a55-8638b42a0b62","uuid":"685b5284-7912-4251-bd15-1f486d5a1493","timestamp":"2026-08-31T05:47:54.447Z","subagent_type":"general-purpose","task_description":"Write lz4 block differential tests"}
