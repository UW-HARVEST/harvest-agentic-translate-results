int,\n        );\n        same_int_and_bytes(\"LZ4_compress_default smoke\", rc, rr, &dc, &dr);\n        assert!(rc > 0);\n\n        let (dec_c, dec_r) = l.sym::<FnDecompressSafe>(\"LZ4_decompress_safe\");\n        let mut oc = vec![0u8; src.len()];\n        let mut or = vec![0u8; src.len()];\n        let dcr = dec_c(\n            dc.as_ptr() as *const c_char,\n            oc.as_mut_ptr() as *mut c_char,\n            rc,\n            src.len() as c_int,\n        );\n        let drr = dec_r(\n            dr.as_ptr() as *const c_char,\n            or.as_mut_ptr() as *mut c_char,\n            rr,\n            src.len() as c_int,\n        );\n        same_int_and_bytes(\"LZ4_decompress_safe smoke\", dcr, drr, &oc, &or);","is_error":false}]},"parent_tool_use_id":"toolu_bdrk_01KSNLmugTPJuXaNtEEcWiyX","session_id":"e6275ffd-eea5-4c85-9a55-8638b42a0b62","uuid":"06c343cc-e30a-460c-bdbc-e941cf043f9e","timestamp":"2026-08-31T05:36:05.611Z","subagent_type":"general-purpose","task_description":"Write xxhash and lz4file tests"}
