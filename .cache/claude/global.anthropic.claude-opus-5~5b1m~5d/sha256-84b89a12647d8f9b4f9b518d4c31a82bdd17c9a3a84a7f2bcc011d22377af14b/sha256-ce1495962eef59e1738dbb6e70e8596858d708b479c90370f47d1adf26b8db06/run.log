press */\n271-    const LZ4F_CDict* cdict;\n272-    size_t maxBlockSize;\n273-    size_t maxBufferSize;\n274-    BYTE*  tmpBuff;    /* internal buffer, for streaming */\n275-    BYTE*  tmpIn;      /* starting position of data compress within internal buffer (>= tmpBuff) */\n276-    size_t tmpInSize;  /* amount of data to compress after tmpIn */\n277-    U64    totalInSize;\n278-    XXH32_state_t xxh;","is_error":false}]},"parent_tool_use_id":"toolu_bdrk_01MdG8SwhrzW1VX5kmi793uD","session_id":"e6275ffd-eea5-4c85-9a55-8638b42a0b62","uuid":"708d07ed-ca33-426b-af01-431d02889b67","timestamp":"2026-08-31T06:20:40.581Z","subagent_type":"general-purpose","task_description":"Write lz4frame decompression tests"}
