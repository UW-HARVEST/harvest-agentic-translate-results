{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01QRGyZMheypsXgUAtHaKacR","type":"tool_result","content":"1\t//! Harness sanity check + Phase D symbol-parity gate.\n2\tmod common;\n3\t\n4\tuse common::*;\n5\tuse std::os::raw::{c_char, c_int};\n6\tuse std::process::Command;\n7\t\n8\t#[test]\n9\tfn harness_loads_both_libraries() {\n10\t    let l = libs();\n11\t    unsafe {\n12\t        let (c, r) = l.sym::<FnVoidToInt>(\"LZ4_versionNumber\");\n13\t        assert_eq!(c(), r(), \"LZ4_versionNumber differs\");\n14\t    }\n15\t}\n16\t\n17\t#[test]\n18\tfn roundtrip_smoke() {\n19\t    let l = libs();\n20\t    let mut rng = Rng::new(1);\n21\t    let src = gen_textlike(&mut rng, 4096);\n22\t    unsafe {\n23\t        let (cb_c, cb_r) = l.sym::<FnCompressBound>(\"LZ4_compressBound\");\n24\t        assert_eq!(cb_c(src.len() as c_int), cb_r(src.len() as c_int));\n25\t        let bound = cb_c(src.len() as c_int) as usize;\n26\t\n27\t        let (comp_c, comp_r) = l.sym::<FnCompressDefault>(\"LZ4_compress_default\");\n28\t        let mut dc = vec![0u8; bound];\n29\t        let mut dr = vec![0u8; bound];\n30\t        let rc = comp_c(\n31\t            src.as_ptr() as *const c_char,\n32\t            dc.as_mut_ptr() as *mut c_char,\n33\t            src.len() as c_int,\n34\t            bound as c_int,\n35\t        );\n36\t        let rr = comp_r(\n37\t            src.as_ptr() as *const c_char,\n38\t            dr.as_mut_ptr() as *mut c_char,\n39\t            src.len() as c_int,\n40\t            bound as c_int,\n41\t        );\n42\t        same_int_and_bytes(\"LZ4_compress_default smoke\", rc, rr, &dc, &dr);\n43\t        assert!(rc > 0);\n44\t\n45\t        let (dec_c, dec_r) = l.sym::<FnDecompressSafe>(\"LZ4_decompress_safe\");\n46\t        let mut oc = vec![0u8; src.len()];\n47\t        let mut or = vec![0u8; src.len()];\n48\t        let dcr = dec_c(\n49\t            dc.as_ptr() as *const c_char,\n50\t            oc.as_mut_ptr() as *mut c_char,\n51\t            rc,\n52\t            src.len() as c_int,\n53\t        );\n54\t        let drr = dec_r(\n55\t            dr.as_ptr() as *const c_char,\n56\t            or.as_mut_ptr() as *mut c_char,\n57\t            rr,\n58\t            src.len() as c_int,\n59\t        );\n60\t        same_int_and_bytes(\"LZ4_decompress_safe smoke\", dcr, drr, &oc, &or);\n61\t        assert_eq!(oc, src);\n62\t    }\n63\t}\n64\t\n65\t/// Phase D gate: every dynamic symbol the C `.so` exports must also be exported\n66\t/// by the Rust `.so`, with the exact same name.\n67\t#[test]\n68\tfn phase_d_symbol_parity() {\n69\t    fn syms(path: &str) -> Vec<String> {\n70\t        let out = Command::new(\"nm\")\n71\t            .args([\"-D\", \"--defined-only\", path])\n72\t            .output()\n73\t            .expect(\"run nm\");\n74\t        assert!(out.status.success(), \"nm failed on {path}\");\n75\t        let mut v: Vec<String> = String::from_utf8_lossy(&out.stdout)\n76\t            .lines()\n77\t            .filter_map(|l| l.split_whitespace().nth(2).map(str::to_string))\n78\t            .collect();\n79\t        v.sort();\n80\t        v.dedup();\n81\t        v\n82\t    }\n83\t\n84\t    let root = concat!(env!(\"CARGO_MANIFEST_DIR\"), \"/\");\n85\t    let c = syms(&format!(\"{root}../c_src/build/liblz4.so\"));\n86\t    let r = syms(&format!(\"{root}target/release/liblz4.so\"));\n87\t    assert!(c.len() > 100, \"expected many C symbols, got {}\", c.len());\n88\t\n89\t    let missing: Vec<&String> = c.iter().filter(|s| !r.contains(s)).collect();\n90\t    assert!(\n91\t        missing.is_empty(),\n92\t        \"{} symbols exported by C .so are MISSING from Rust .so: {:?}\",\n93\t        missing.len(),\n94\t        missing\n95\t    );\n96\t\n97\t    let extra: Vec<&String> = r.iter().filter(|s| !c.contains(s)).collect();\n98\t    assert!(extra.is_empty(), \"Rust .so exports extra symbols: {extra:?}\");\n99\t}\n100\t"}]},"parent_tool_use_id":"toolu_bdrk_017SZTSCokiHMF65SBLwxB1T","session_id":"e6275ffd-eea5-4c85-9a55-8638b42a0b62","uuid":"07444dde-ff9f-4fba-b2dc-47d61c1e6dc1","timestamp":"2026-08-31T05:33:40.699Z","subagent_type":"general-purpose","task_description":"Write lz4 block differential tests"}
