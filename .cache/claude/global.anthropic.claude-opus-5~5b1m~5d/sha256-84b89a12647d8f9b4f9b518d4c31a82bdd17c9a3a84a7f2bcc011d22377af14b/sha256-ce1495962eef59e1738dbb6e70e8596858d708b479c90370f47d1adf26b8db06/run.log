{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_0136s9KCH9tUeZNmxTffPPNH","type":"tool_result","content":"1\t// Translation of xxhash.c / xxhash.h (xxHash 0.6.5) to Rust.\n2\t//\n3\t// Compiled originally with -DXXH_NAMESPACE=LZ4_, so every public symbol is\n4\t// exported with an `LZ4_` prefix. Target: x86_64 Linux (little-endian,\n5\t// unaligned accesses allowed, default XXH_FORCE_MEMORY_ACCESS==0 which uses\n6\t// memcpy-based reads -- safe for any alignment). Because of that:\n7\t//   - XXH_CPU_LITTLE_ENDIAN is always 1 (true) on this target.\n8\t//   - XXH_FORCE_ALIGN_CHECK is 0 on x86/x86_64, so the \"aligned\" fast path in\n9\t//     XXH32()/XXH64() is never taken; only the \"unaligned\" endian_align call\n10\t//     with XXH_littleEndian is exercised.\n11\t//   - Since reads always go through the memcpy-style XXH_read32/XXH_read64,\n12\t//     the `align` parameter (aligned vs unaligned) makes no actual behavioral\n13\t//     difference; both paths are identical in codegen terms. We simply always\n14\t//     use unaligned little-endian reads.\n15\t//   - XXH_ACCEPT_NULL_INPUT_POINTER defaults to 0, so NULL input pointers are\n16\t//     NOT specially handled in XXH32()/XXH64() (they would dereference and\n17\t//     segfault on nonzero length, matching the C behavior exactly), and in\n18\t//     the streaming XXH32_update/XXH64_update, a NULL input pointer causes\n19\t//     XXH_ERROR to be returned.\n20\t//   - XXH_FORCE_NATIVE_FORMAT defaults to 0, irrelevant since we're already\n21\t//     little-endian.\n22\t\n23\tuse core::ffi::{c_int, c_uint, c_ulonglong, c_void};\n24\t\n25\tunsafe extern \"C\" {\n26\t    fn malloc(size: usize) -> *mut c_void;\n27\t    fn free(ptr: *mut c_void);\n28\t}\n29\t\n30\t/* *************************************\n31\t *  Types\n32\t ***************************************/\n33\t\n34\tpub type XXH32_hash_t = u32;\n35\tpub type XXH64_hash_t = u64;\n36\t\n37\t// typedef enum { XXH_OK=0, XXH_ERROR } XXH_errorcode;\n38\tpub const XXH_OK: c_int = 0;\n39\tpub const XXH_ERROR: c_int = 1;\n40\t\n41\t#[repr(C)]\n42\tpub struct XXH32_state_s {\n43\t    pub total_len_32: u32,\n44\t    pub large_len: u32,\n45\t    pub v1: u32,\n46\t    pub v2: u32,\n47\t    pub v3: u32,\n48\t    pub v4: u32,\n49\t    pub mem32: [u32; 4],\n50\t    pub memsize: u32,\n51\t    pub reserved: u32,\n52\t}\n53\tpub type XXH32_state_t = XXH32_state_s;\n54\t\n55\t#[repr(C)]\n56\tpub struct XXH64_state_s {\n57\t    pub total_len: u64,\n58\t    pub v1: u64,\n59\t    pub v2: u64,\n60\t    pub v3: u64,\n61\t    pub v4: u64,\n62\t    pub mem64: [u64; 4],\n63\t    pub memsize: u32,\n64\t    pub reserved: [u32; 2],\n65\t}\n66\tpub type XXH64_state_t = XXH64_state_s;\n67\t\n68\t#[repr(C)]\n69\tpub struct XXH32_canonical_t {\n70\t    pub digest: [u8; 4],\n71\t}\n72\t\n73\t#[repr(C)]\n74\tpub struct XXH64_canonical_t {\n75\t    pub digest: [u8; 8],\n76\t}\n77\t\n78\t/* *************************************\n79\t *  Memory reads (XXH_FORCE_MEMORY_ACCESS default == 0, memcpy-based, safe\n80\t *  for any alignment; on this target reads are always effectively\n81\t *  little-endian native reads since XXH_CPU_LITTLE_ENDIAN == 1)\n82\t ***************************************/\n83\t\n84\t#[inline(always)]\n85\tunsafe fn xxh_read32(mem_ptr: *const u8) -> u32 {\n86\t    unsafe { core::ptr::read_unaligned(mem_ptr as *const u32) }\n87\t}\n88\t\n89\t#[inline(always)]\n90\tunsafe fn xxh_read64(mem_ptr: *const u8) -> u64 {\n91\t    unsafe { core::ptr::read_unaligned(mem_ptr as *const u64) }\n92\t}\n93\t\n94\t#[inline(always)]\n95\tfn xxh_swap32(x: u32) -> u32 {\n96\t    x.swap_bytes()\n97\t}\n98\t\n99\t#[inline(always)]\n100\tfn xxh_swap64(x: u64) -> u64 {\n101\t    x.swap_bytes()\n102\t}\n103\t\n104\t// XXH_readLE32_align / XXH_readLE32: endian is always XXH_littleEndian on\n105\t// this target, and align makes no behavioral difference (memcpy-based read).\n106\t#[inline(always)]\n107\tunsafe fn xxh_get32bits(p: *const u8) -> u32 {\n108\t    unsafe { xxh_read32(p) }\n109\t}\n110\t\n111\t#[inline(always)]\n112\tunsafe fn xxh_get64bits(p: *const u8) -> u64 {\n113\t    unsafe { xxh_read64(p) }\n114\t}\n115\t\n116\t// XXH_readBE32/64 : CPU is little-endian, so this always swaps.\n117\t#[inline(always)]\n118\tunsafe fn xxh_read_be32(ptr: *const u8) -> u32 {\n119\t    unsafe { xxh_swap32(xxh_read32(ptr)) }\n120\t}\n121\t\n122\t#[inline(always)]\n123\tunsafe fn xxh_read_be64(ptr: *const u8) -> u64 {\n124\t    unsafe { xxh_swap64(xxh_read64(ptr)) }\n125\t}\n126\t\n127\t#[inline(always)]\n128\tfn xxh_rotl32(x: u32, r: u32) -> u32 {\n129\t    (x << r) | (x >> (32 - r))\n130\t}\n131\t\n132\t#[inline(always)]\n133\tfn xxh_rotl64(x: u64, r: u32) -> u64 {\n134\t    (x << r) | (x >> (64 - r))\n135\t}\n136\t\n137\t/* *******************************************************************\n138\t *  Version\n139\t *********************************************************************/\n140\t\n141\tconst XXH_VERSION_MAJOR: c_uint = 0;\n142\tconst XXH_VERSION_MINOR: c_uint = 6;\n143\tconst XXH_VERSION_RELEASE: c_uint = 5;\n144\tconst XXH_VERSION_NUMBER: c_uint =\n145\t    XXH_VERSION_MAJOR * 100 * 100 + XXH_VERSION_MINOR * 100 + XXH_VERSION_RELEASE;\n146\t\n147\t#[unsafe(no_mangle)]\n148\tpub unsafe extern \"C\" fn LZ4_XXH_versionNumber() -> c_uint {\n149\t    XXH_VERSION_NUMBER\n150\t}\n151\t\n152\t/* *******************************************************************\n153\t *  32-bit hash functions\n154\t *********************************************************************/\n155\t\n156\tconst PRIME32_1: u32 = 2654435761u32;\n157\tconst PRIME32_2: u32 = 2246822519u32;\n158\tconst PRIME32_3: u32 = 3266489917u32;\n159\tconst PRIME32_4: u32 = 668265263u32;\n160\tconst PRIME32_5: u32 = 374761393u32;\n161\t\n162\t#[inline(always)]\n163\tfn xxh32_round(seed: u32, input: u32) -> u32 {\n164\t    let mut seed = seed.wrapping_add(input.wrapping_mul(PRIME32_2));\n165\t    seed = xxh_rotl32(seed, 13);\n166\t    seed = seed.wrapping_mul(PRIME32_1);\n167\t    seed\n168\t}\n169\t\n170\t#[inline(always)]\n171\tfn xxh32_avalanche(mut h32: u32) -> u32 {\n172\t    h32 ^= h32 >> 15;\n173\t    h32 = h32.wrapping_mul(PRIME32_2);\n174\t    h32 ^= h32 >> 13;\n175\t    h32 = h32.wrapping_mul(PRIME32_3);\n176\t    h32 ^= h32 >> 16;\n177\t    h32\n178\t}\n179\t\n180\t// Faithful transcription of XXH32_finalize's switch(len&15) fallthrough\n181\t// chain: it is equivalent to running PROCESS4 (len15/4) times followed by\n182\t// PROCESS1 (len15%4) times, then avalanche. (Verified case-by-case against\n183\t// the C switch statement.)\n184\tunsafe fn xxh32_finalize(mut h32: u32, ptr: *const u8, len: usize) -> u32 {\n185\t    let mut p = ptr;\n186\t    let len15 = len & 15;\n187\t    let n4 = len15 / 4;\n188\t    let n1 = len15 % 4;\n189\t\n190\t    for _ in 0..n4 {\n191\t        h32 = h32.wrapping_add(unsafe { xxh_get32bits(p) }.wrapping_mul(PRIME32_3));\n192\t        p = unsafe { p.add(4) };\n193\t        h32 = xxh_rotl32(h32, 17).wrapping_mul(PRIME32_4);\n194\t    }\n195\t\n196\t    for _ in 0..n1 {\n197\t        h32 = h32.wrapping_add((unsafe { *p } as u32).wrapping_mul(PRIME32_5));\n198\t        p = unsafe { p.add(1) };\n199\t        h32 = xxh_rotl32(h32, 11).wrapping_mul(PRIME32_1);\n200\t    }\n201\t\n202\t    xxh32_avalanche(h32)\n203\t}\n204\t\n205\tunsafe fn xxh32_endian_align(input: *const u8, len: usize, seed: u32) -> u32 {\n206\t    let mut p = input;\n207\t    let b_end = unsafe { p.add(len) };\n208\t    let h32: u32;\n209\t\n210\t    if len >= 16 {\n211\t        let limit = unsafe { b_end.sub(15) };\n212\t        let mut v1 = seed.wrapping_add(PRIME32_1).wrapping_add(PRIME32_2);\n213\t        let mut v2 = seed.wrapping_add(PRIME32_2);\n214\t        let mut v3 = seed.wrapping_add(0);\n215\t        let mut v4 = seed.wrapping_sub(PRIME32_1);\n216\t\n217\t        loop {\n218\t            v1 = xxh32_round(v1, unsafe { xxh_get32bits(p) });\n219\t            p = unsafe { p.add(4) };\n220\t            v2 = xxh32_round(v2, unsafe { xxh_get32bits(p) });\n221\t            p = unsafe { p.add(4) };\n222\t            v3 = xxh32_round(v3, unsafe { xxh_get32bits(p) });\n223\t            p = unsafe { p.add(4) };\n224\t            v4 = xxh32_round(v4, unsafe { xxh_get32bits(p) });\n225\t            p = unsafe { p.add(4) };\n226\t            if !(p < limit) {\n227\t                break;\n228\t            }\n229\t        }\n230\t\n231\t        h32 = xxh_rotl32(v1, 1)\n232\t            .wrapping_add(xxh_rotl32(v2, 7))\n233\t            .wrapping_add(xxh_rotl32(v3, 12))\n234\t            .wrapping_add(xxh_rotl32(v4, 18));\n235\t    } else {\n236\t        h32 = seed.wrapping_add(PRIME32_5);\n237\t    }\n238\t\n239\t    let h32 = h32.wrapping_add(len as u32);\n240\t\n241\t    unsafe { xxh32_finalize(h32, p, len & 15) }\n242\t}\n243\t\n244\t#[unsafe(no_mangle)]\n245\tpub unsafe extern \"C\" fn LZ4_XXH32(input: *const c_void, len: usize, seed: c_uint) -> XXH32_hash_t {\n246\t    // XXH_FORCE_ALIGN_CHECK == 0 on x86_64: the aligned fast-path is never\n247\t    // taken. XXH_CPU_LITTLE_ENDIAN == 1 always on this target.\n248\t    unsafe { xxh32_endian_align(input as *const u8, len, seed) }\n249\t}\n250\t\n251\t/*======   Hash streaming   ======*/\n252\t\n253\t#[unsafe(no_mangle)]\n254\tpub unsafe extern \"C\" fn LZ4_XXH32_createState() -> *mut XXH32_state_t {\n255\t    unsafe { malloc(core::mem::size_of::<XXH32_state_t>()) as *mut XXH32_state_t }\n256\t}\n257\t\n258\t#[unsafe(no_mangle)]\n259\tpub unsafe extern \"C\" fn LZ4_XXH32_freeState(state_ptr: *mut XXH32_state_t) -> c_int {\n260\t    unsafe { free(state_ptr as *mut c_void) };\n261\t    XXH_OK\n262\t}\n263\t\n264\t#[unsafe(no_mangle)]\n265\tpub unsafe extern \"C\" fn LZ4_XXH32_copyState(dst_state: *mut XXH32_state_t, src_state: *const XXH32_state_t) {\n266\t    unsafe {\n267\t        core::ptr::copy_nonoverlapping(src_state, dst_state, 1);\n268\t    }\n269\t}\n270\t\n271\t#[unsafe(no_mangle)]\n272\tpub unsafe extern \"C\" fn LZ4_XXH32_reset(state_ptr: *mut XXH32_state_t, seed: c_uint) -> c_int {\n273\t    let mut state: XXH32_state_t = XXH32_state_t {\n274\t        total_len_32: 0,\n275\t        large_len: 0,\n276\t        v1: 0,\n277\t        v2: 0,\n278\t        v3: 0,\n279\t        v4: 0,\n280\t        mem32: [0; 4],\n281\t        memsize: 0,\n282\t        reserved: 0,\n283\t    };\n284\t    state.v1 = seed.wrapping_add(PRIME32_1).wrapping_add(PRIME32_2);\n285\t    state.v2 = seed.wrapping_add(PRIME32_2);\n286\t    state.v3 = seed.wrapping_add(0);\n287\t    state.v4 = seed.wrapping_sub(PRIME32_1);\n288\t    // do not write into reserved\n289\t    unsafe {\n290\t        core::ptr::copy_nonoverlapping(\n291\t            &state as *const XXH32_state_t as *const u8,\n292\t            state_ptr as *mut u8,\n293\t            core::mem::size_of::<XXH32_state_t>() - core::mem::size_of::<u32>(),\n294\t        );\n295\t    }\n296\t    XXH_OK\n297\t}\n298\t\n299\tunsafe fn xxh32_update_endian(state: *mut XXH32_state_t, input: *const c_void, len: usize) -> c_int {\n300\t    if input.is_null() {\n301\t        return XXH_ERROR;\n302\t    }\n303\t\n304\t    unsafe {\n305\t        let mut p = input as *const u8;\n306\t        let b_end = p.add(len);\n307\t\n308\t        (*state).total_len_32 = (*state).total_len_32.wrapping_add(len as u32);\n309\t        (*state).large_len |= ((len >= 16) as u32) | (((*state).total_len_32 >= 16) as u32);\n310\t\n311\t        if ((*state).memsize as usize + len) < 16 {\n312\t            let dst = ((*state).mem32.as_mut_ptr() as *mut u8).add((*state).memsize as usize);\n313\t            core::ptr::copy_nonoverlapping(p, dst, len);\n314\t            (*state).memsize += len as u32;\n315\t            return XXH_OK;\n316\t        }\n317\t\n318\t        if (*state).memsize != 0 {\n319\t            let dst = ((*state).mem32.as_mut_ptr() as *mut u8).add((*state).memsize as usize);\n320\t            let n = 16 - (*state).memsize as usize;\n321\t            core::ptr::copy_nonoverlapping(p, dst, n);\n322\t            {\n323\t                let mut p32 = (*state).mem32.as_ptr() as *const u8;\n324\t                (*state).v1 = xxh32_round((*state).v1, xxh_get32bits(p32));\n325\t                p32 = p32.add(4);\n326\t                (*state).v2 = xxh32_round((*state).v2, xxh_get32bits(p32));\n327\t                p32 = p32.add(4);\n328\t                (*state).v3 = xxh32_round((*state).v3, xxh_get32bits(p32));\n329\t                p32 = p32.add(4);\n330\t                (*state).v4 = xxh32_round((*state).v4, xxh_get32bits(p32));\n331\t            }\n332\t            p = p.add(16 - (*state).memsize as usize);\n333\t            (*state).memsize = 0;\n334\t        }\n335\t\n336\t        if p <= b_end.sub(16) {\n337\t            let limit = b_end.sub(16);\n338\t            let mut v1 = (*state).v1;\n339\t            let mut v2 = (*state).v2;\n340\t            let mut v3 = (*state).v3;\n341\t            let mut v4 = (*state).v4;\n342\t\n343\t            loop {\n344\t                v1 = xxh32_round(v1, xxh_get32bits(p));\n345\t                p = p.add(4);\n346\t                v2 = xxh32_round(v2, xxh_get32bits(p));\n347\t                p = p.add(4);\n348\t                v3 = xxh32_round(v3, xxh_get32bits(p));\n349\t                p = p.add(4);\n350\t                v4 = xxh32_round(v4, xxh_get32bits(p));\n351\t                p = p.add(4);\n352\t                if !(p <= limit) {\n353\t                    break;\n354\t                }\n355\t            }\n356\t\n357\t            (*state).v1 = v1;\n358\t            (*state).v2 = v2;\n359\t            (*state).v3 = v3;\n360\t            (*state).v4 = v4;\n361\t        }\n362\t\n363\t        if p < b_end {\n364\t            let n = b_end.offset_from(p) as usize;\n365\t            core::ptr::copy_nonoverlapping(p, (*state).mem32.as_mut_ptr() as *mut u8, n);\n366\t            (*state).memsize = n as u32;\n367\t        }\n368\t    }\n369\t\n370\t    XXH_OK\n371\t}\n372\t\n373\t#[unsafe(no_mangle)]\n374\tpub unsafe extern \"C\" fn LZ4_XXH32_update(state_in: *mut XXH32_state_t, input: *const c_void, len: usize) -> c_int {\n375\t    unsafe { xxh32_update_endian(state_in, input, len) }\n376\t}\n377\t\n378\tunsafe fn xxh32_digest_endian(state: *const XXH32_state_t) -> u32 {\n379\t    unsafe {\n380\t        let h32: u32;\n381\t        if (*state).large_len != 0 {\n382\t            h32 = xxh_rotl32((*state).v1, 1)\n383\t                .wrapping_add(xxh_rotl32((*state).v2, 7))\n384\t                .wrapping_add(xxh_rotl32((*state).v3, 12))\n385\t                .wrapping_add(xxh_rotl32((*state).v4, 18));\n386\t        } else {\n387\t            h32 = (*state).v3.wrapping_add(PRIME32_5);\n388\t        }\n389\t\n390\t        let h32 = h32.wrapping_add((*state).total_len_32);\n391\t\n392\t        xxh32_finalize(h32, (*state).mem32.as_ptr() as *const u8, (*state).memsize as usize)\n393\t    }\n394\t}\n395\t\n396\t#[unsafe(no_mangle)]\n397\tpub unsafe extern \"C\" fn LZ4_XXH32_digest(state_in: *const XXH32_state_t) -> XXH32_hash_t {\n398\t    unsafe { xxh32_digest_endian(state_in) }\n399\t}\n400\t\n401\t/*======   Canonical representation   ======*/\n402\t\n403\t#[unsafe(no_mangle)]\n404\tpub unsafe extern \"C\" fn LZ4_XXH32_canonicalFromHash(dst: *mut XXH32_canonical_t, hash: XXH32_hash_t) {\n405\t    // XXH_CPU_LITTLE_ENDIAN is always true on this target.\n406\t    let hash = xxh_swap32(hash);\n407\t    unsafe {\n408\t        core::ptr::copy_nonoverlapping(&hash as *const u32 as *const u8, dst as *mut u8, 4);\n409\t    }\n410\t}\n411\t\n412\t#[unsafe(no_mangle)]\n413\tpub unsafe extern \"C\" fn LZ4_XXH32_hashFromCanonical(src: *const XXH32_canonical_t) -> XXH32_hash_t {\n414\t    unsafe { xxh_read_be32(src as *const u8) }\n415\t}\n416\t\n417\t/* *******************************************************************\n418\t *  64-bit hash functions\n419\t *********************************************************************/\n420\t\n421\tconst PRIME64_1: u64 = 11400714785074694791u64;\n422\tconst PRIME64_2: u64 = 14029467366897019727u64;\n423\tconst PRIME64_3: u64 = 1609587929392839161u64;\n424\tconst PRIME64_4: u64 = 9650029242287828579u64;\n425\tconst PRIME64_5: u64 = 2870177450012600261u64;\n426\t\n427\t#[inline(always)]\n428\tfn xxh64_round(acc: u64, input: u64) -> u64 {\n429\t    let mut acc = acc.wrapping_add(input.wrapping_mul(PRIME64_2));\n430\t    acc = xxh_rotl64(acc, 31);\n431\t    acc = acc.wrapping_mul(PRIME64_1);\n432\t    acc\n433\t}\n434\t\n435\t#[inline(always)]\n436\tfn xxh64_merge_round(acc: u64, val: u64) -> u64 {\n437\t    let val = xxh64_round(0, val);\n438\t    let acc = acc ^ val;\n439\t    let acc = acc.wrapping_mul(PRIME64_1).wrapping_add(PRIME64_4);\n440\t    acc\n441\t}\n442\t\n443\t#[inline(always)]\n444\tfn xxh64_avalanche(mut h64: u64) -> u64 {\n445\t    h64 ^= h64 >> 33;\n446\t    h64 = h64.wrapping_mul(PRIME64_2);\n447\t    h64 ^= h64 >> 29;\n448\t    h64 = h64.wrapping_mul(PRIME64_3);\n449\t    h64 ^= h64 >> 32;\n450\t    h64\n451\t}\n452\t\n453\t// Faithful transcription of XXH64_finalize's switch(len&31) fallthrough\n454\t// chain: equivalent to running PROCESS8 (len32/8) times, then if the\n455\t// remainder r=len32%8 is >=4 running PROCESS4 once and subtracting 4 from r,\n456\t// then running PROCESS1 r times, then avalanche. (Verified case-by-case\n457\t// against the C switch statement.)\n458\tunsafe fn xxh64_finalize(mut h64: u64, ptr: *const u8, len: usize) -> u64 {\n459\t    let mut p = ptr;\n460\t    let len32 = len & 31;\n461\t    let n8 = len32 / 8;\n462\t    let mut r = len32 % 8;\n463\t\n464\t    for _ in 0..n8 {\n465\t        let k1 = xxh64_round(0, unsafe { xxh_get64bits(p) });\n466\t        p = unsafe { p.add(8) };\n467\t        h64 ^= k1;\n468\t        h64 = xxh_rotl64(h64, 27).wrapping_mul(PRIME64_1).wrapping_add(PRIME64_4);\n469\t    }\n470\t\n471\t    if r >= 4 {\n472\t        h64 ^= (unsafe { xxh_get32bits(p) } as u64).wrapping_mul(PRIME64_1);\n473\t        p = unsafe { p.add(4) };\n474\t        h64 = xxh_rotl64(h64, 23).wrapping_mul(PRIME64_2).wrapping_add(PRIME64_3);\n475\t        r -= 4;\n476\t    }\n477\t\n478\t    for _ in 0..r {\n479\t        h64 ^= (unsafe { *p } as u64).wrapping_mul(PRIME64_5);\n480\t        p = unsafe { p.add(1) };\n481\t        h64 = xxh_rotl64(h64, 11).wrapping_mul(PRIME64_1);\n482\t    }\n483\t\n484\t    xxh64_avalanche(h64)\n485\t}\n486\t\n487\tunsafe fn xxh64_endian_align(input: *const u8, len: usize, seed: u64) -> u64 {\n488\t    let mut p = input;\n489\t    let b_end = unsafe { p.add(len) };\n490\t    let h64: u64;\n491\t\n492\t    if len >= 32 {\n493\t        let limit = unsafe { b_end.sub(32) };\n494\t        let mut v1 = seed.wrapping_add(PRIME64_1).wrapping_add(PRIME64_2);\n495\t        let mut v2 = seed.wrapping_add(PRIME64_2);\n496\t        let mut v3 = seed.wrapping_add(0);\n497\t        let mut v4 = seed.wrapping_sub(PRIME64_1);\n498\t\n499\t        loop {\n500\t            v1 = xxh64_round(v1, unsafe { xxh_get64bits(p) });\n501\t            p = unsafe { p.add(8) };\n502\t            v2 = xxh64_round(v2, unsafe { xxh_get64bits(p) });\n503\t            p = unsafe { p.add(8) };\n504\t            v3 = xxh64_round(v3, unsafe { xxh_get64bits(p) });\n505\t            p = unsafe { p.add(8) };\n506\t            v4 = xxh64_round(v4, unsafe { xxh_get64bits(p) });\n507\t            p = unsafe { p.add(8) };\n508\t            if !(p <= limit) {\n509\t                break;\n510\t            }\n511\t        }\n512\t\n513\t        let mut h = xxh_rotl64(v1, 1)\n514\t            .wrapping_add(xxh_rotl64(v2, 7))\n515\t            .wrapping_add(xxh_rotl64(v3, 12))\n516\t            .wrapping_add(xxh_rotl64(v4, 18));\n517\t        h = xxh64_merge_round(h, v1);\n518\t        h = xxh64_merge_round(h, v2);\n519\t        h = xxh64_merge_round(h, v3);\n520\t        h = xxh64_merge_round(h, v4);\n521\t        h64 = h;\n522\t    } else {\n523\t        h64 = seed.wrapping_add(PRIME64_5);\n524\t    }\n52