    int is_short = (g[0].n_short_sfb == 39), is_mixed = (g[0].n_short_sfb == 30);\n        if (is_short == want_short && is_mixed == want_mixed) {\n            *nl = g[0].n_long_sfb; *ns = g[0].n_short_sfb;\n            return g[0].sfbtab;\n        }\n    }\n    return NULL;\n}\n\nint main(int argc, char **argv) {\n    void *hc = dlopen(argv[1], RTLD_NOW), *hr = dlopen(argv[2], RTLD_NOW);\n    fc = (fn_t)dlsym(hc, \"read_side_info\"); fr = (fn_t)dlsym(hr, \"read_side_info\");\n    if (!fc || !fr) { fprintf(stderr, \"dlsym\\n\"); return 2; }\n\n    // Reference points: sr_idx==0, long window  ->  table_base + 640\n    uint8_t nl, ns;\n    const uint8_t *c0 = probe(fc, 0xE2, 0x00, 0, 0, &nl, &ns);\n    const uint8_t *r0 = probe(fr, 0xE2, 0x00, 0, 0, &nl, &ns);\n    const uint8_t *cbase = c0 - 640, *rbase = r0 - 640;\n    printf(\"table base: C=%p Rust=%p\\n\", (void *)cbase, (void *)rbase);\n\n    const char *names[3] = { \"long \", \"short\", \"mixed\" };\n    int bad = 0;\n    for (int mode = 0; mode < 3; mode++) {\n        for (int sr = 0; sr <= 8; sr++) {\n            // sr_idx = ((h2>>2)&3) + popcnt-ish(h1 bits3,4)*3, minus 1 if nonzero\n            int found = 0;\n            for (int h1v = 0; h1v < 256 && !found; h1v++)\n            for (int h2v = 0; h2v < 256 && !found; h2v++) {\n                int s = ((h2v >> 2) & 3) + (((h1v >> 3) & 1) + ((h1v >> 4) & 1)) * 3;\n                s -= (s != 0);\n                if (s != sr) continue;\n                uint8_t a1, a2, b1, b2;\n                const uint8_t *pc = probe(fc, (uint8_t)h1v, (uint8_t)h2v,\n                                          mode == 1, mode == 2, &a1, &a2);\n                if (!pc) continue;\n                const uint8_t *pr = probe(fr, (uint8_t)h1v, (uint8_t)h2v,\n                                          mode == 1, mode == 2, &b1, &b2);\n                if (!pr) continue;\n                long oc = pc - cbase, orr = pr - rbase;\n                int ok = (oc == orr) && a1 == b1 && a2 == b2;\