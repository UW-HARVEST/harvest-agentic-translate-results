    for (unsigned t = 0; t < 3000; t++) {\n        uint8_t hdr[4] = { 0xFF, (uint8_t)rnd(), (uint8_t)rnd(), (uint8_t)rnd() };\n        for (unsigned pi = 0; pi < sizeof poss / sizeof *poss; pi++)\n        for (unsigned li = 0; li < sizeof limits / sizeof *limits; li++) {\n            bs_t bc = { base, poss[pi], limits[li] }, br = { base, poss[pi], limits[li] };\n            L3_gr_info_t gc[8], g2[8];\n            memset(gc, 0x5C, sizeof gc); memset(g2, 0x5C, sizeof g2);\n            int rc = fc(&bc, gc, hdr), rr = fr(&br, g2, hdr);\n            cases++;\n            int bad = (rc != rr) || bc.pos != br.pos || bc.limit != br.limit;\n            for (int i = 0; i < 8; i++) {\n                L3_gr_info_t a = gc[i], b = g2[i];\n                a.sfbtab = b.sfbtab = NULL;             // addresses differ by design\n                if (memcmp(&a, &b, sizeof a)) bad = 1;\n            }\n            if (bad && mism++ < 8)\n                printf(\"MISMATCH hdr=%02x%02x%02x%02x pos=%d limit=%d rc=%d rr=%d posC=%d posR=%d\\n\",\n                       hdr[0], hdr[1], hdr[2], hdr[3], poss[pi], limits[li], rc, rr, bc.pos, br.pos);\n        }\n    }\n    printf(\"edge cases=%ld mismatches=%ld\\n\", cases, mism);\n    return mism ? 1 : 0;\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1621,"cache_read_input_tokens":54887,"cache_creation":{"ephemeral_5m_input_tokens":1621,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"8130ce93-cd4a-49d9-b856-9792fca0afce","uuid":"e03bfc0e-d8d3-4379-81b9-c212faafd912","timestamp":"2026-08-27T00:38:37.500Z"}
