(\"G %d %lld %td\\n\", k, stbds_hmget(m, k), stbds_hmgeti(m, k)); break;\n        case 3: printf(\"D %d %td %td\\n\", k, (ptrdiff_t)stbds_hmdel(m, k), stbds_hmlen(m)); break;\n      }\n    }\n    printf(\"T%d final len=%td\\n\", trial, stbds_hmlen(m));\n    for (ptrdiff_t i = 0; i < stbds_hmlen(m); ++i) printf(\"  %td %d %lld\\n\", i, m[i+1].key, m[i+1].value);\n    stbds_hmfree(m);\n  }\n  /* 4. random string hashmap op sequence in all 3 modes */\n  for (int mode = 0; mode < 3; ++mode)\n    for (int trial = 0; trial < 5; ++trial) {\n      stbds_rand_seed((size_t)rnd());\n      sentry *m = NULL;\n      if (mode == 1) stbds_sh_new_strdup(m);\n      if (mode == 2) stbds_sh_new_arena(m);\n      static char keys[500][40];\n      for (int i = 0; i < 500; ++i) { int n = rnd()%30+1; for(int j=0;j<n;++j) keys[i][j]='a'+(rnd()%26); keys[i][n]=0; }\n      for (int op = 0; op < 2500; ++op) {\n        int k = (int)(rnd() % 500);\n        switch (rnd() % 4) {\n          case 0: case 1: stbds_shput(m, keys[k], (long long)k*3+op); printf(\"SP %d %td %td\\n\", k, stbds_shlen(m), stbds_temp(m-1)); break;\n          case 2: printf(\"SG %d %td\\n\", k, stbds_shgeti(m, keys[k])); break;\n          case 3: printf(\"SD %d %td %td\\n\", k, (ptrdiff_t)stbds_shdel(m, keys[k]), stbds_shlen(m)); break;\n        }\n      }\n      printf(\"ST%d/%d len=%td\\n\", mode, trial, stbds_shlen(m));\n      for (ptrdiff_t i = 0; i < stbds_shlen(m); ++i) printf(\"  %td %s %lld\\n\", i, m[i+1].key, m[i+1].value);\n      stbds_shfree(m);\n    }\n  /* 5. random array ops */\n  for (int trial = 0; trial < 20; ++trial) {\n    int *a = NULL;\n    for (int op = 0; op < 500; ++op) {\n      switch (rnd() % 6) {\n        case 0: stbds_arrput(a, (int)rnd()); break;\n        case 1: if (stbds_arrlen(a)) (void)stbds_arrpop(a); break;\n        case 2: if (stbds_arrlen(a)) stbds_arrdel(a, rnd()%stbds_arrlen(a)); break;\n        case 3: if (stbds_arrlen(a)) stbds_arrdelswap(a, rnd()%stbds_arrlen(a)); break;\n        case