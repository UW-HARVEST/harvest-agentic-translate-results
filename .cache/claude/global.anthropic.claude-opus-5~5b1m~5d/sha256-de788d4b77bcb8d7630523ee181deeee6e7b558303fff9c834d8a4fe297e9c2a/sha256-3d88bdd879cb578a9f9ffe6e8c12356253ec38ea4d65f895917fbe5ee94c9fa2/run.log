o::stdout();\n    let mut stdout = stdout.lock();\n    let _ = stdout.write_all(line.as_bytes());\n    let _ = stdout.flush();\n}\n","structuredPatch":[{"oldStart":1,"oldLines":6,"newStart":1,"newLines":7,"lines":[" //! Port of `main.c`."," "," mod cstd;","+mod fpu;"," mod q_math;"," mod q_shared;"," "]}],"userModified":false,"replaceAll":false}}
