23372036854775809\",\"18446744073709551615\",\"18446744073709551616\",\n          \"99999999999999999999999999999999\",\"-99999999999999999999999999999999\",\n          \"0000000000000000000000000000000009223372036854775808\",\n          \"\\xa0\" + \"5\", \"\\x855\",\"\\x8a5\",\"5\\xa0\",\n          \"٥\"*3, \"+٥\", \"-٥\",\n          \"​5\",\"﻿5\",\n          \"5\\x005\" ]:\n    add(s)\n# long digit strings\ng.append(b\"5\"*5000)\ng.append(b\"-\"+b\"5\"*5000)\ng.append(b\"0\"*10000+b\"7\")\ng.append(b\"-\"+b\"0\"*10000+b\"7\")\ng.append(b\"0\"*10000)\ng.append(b\"+\"*100)\ng.append(b\"-\"*100)\ng.append(b\" \"*1000+b\"5\")\ng.append(b\" \"*1000)\ng.append(b\"9\"*19)\ng.append(b\"9\"*20)\ng.append(b\"1\"+b\"0\"*18)\ng.append(b\"1\"+b\"0\"*19)\n# raw latin1 bytes\nfor byt in [0x00,0x09,0x0a,0x0b,0x0c,0x0d,0x1c,0x1d,0x1e,0x1f,0x20,0x85,0xa0,0xff,0x80]:\n    g.append(bytes([byt])+b\"5\")\n    g.append(b\"5\"+bytes([byt]))\n# filter out NUL-containing (impossible in argv)\ng=[x for x in g if b\"\\x00\" not in x]\nprint(\"corpus size\", len(g))\nstrings=[b\"\",b\"abc\",b\"0123456789\",b\"0123456789abcdefghij\"]\nt=time.time()\nfor s in strings:\n    for a in g:\n        check([s,a])                 # argc==3\n        check([s,a,b\"3\"])            # argc==4, grammar in start\n        check([s,b\"1\",a])            # argc==4, grammar in stop\n        check([s,b\"0\",a])\nprint(\"sweepC grammar: n=%d mis=%d %.1fs\"%(n,len(mis),time.time()-t))\nfor a,x,y in mis[:60]: print(\"  ARGV\",a,\"\\n    C\",x,\"\\n    R\",y)\nPY","is_backgrounded":false,"task_type":"local_bash","uuid":"5a487c82-efe1-43c7-b89c-317803c07588","session_id":"3973024c-41c0-4ae5-81ce-f1cb3e2cdf95"}
