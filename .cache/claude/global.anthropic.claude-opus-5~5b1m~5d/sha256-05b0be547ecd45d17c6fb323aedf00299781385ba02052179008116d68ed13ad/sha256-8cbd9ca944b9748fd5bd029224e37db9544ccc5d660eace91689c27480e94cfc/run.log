{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01QqVbx9yTtYbLcTjf2obV83","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/`.\n2\t//!\n3\t//! The C library consists of a single translation unit (`src/lib.c`) whose only\n4\t//! public (dynamically exported) symbol is `bin2hex`, declared in\n5\t//! `include/lib.h` as:\n6\t//!\n7\t//! ```c\n8\t//! char *bin2hex(char *hex, size_t hex_maxlen, const uint8_t *bin,\n9\t//!               size_t bin_len);\n10\t//! ```\n11\t//!\n12\t//! There are no namespace/renaming macros in the public header, so the final\n13\t//! linker symbol is plain `bin2hex`.\n14\t//!\n15\t//! The translation reproduces the original C semantics exactly, including the\n16\t//! constant-time-ish (branch free) nibble-to-ASCII conversion performed with\n17\t//! wrapping `unsigned int` arithmetic, the exact order of the validation\n18\t//! checks, and the `abort()` call on invalid arguments.\n19\t\n20\t#![allow(non_snake_case)]\n21\t\n22\tuse core::ffi::{c_char, c_int, c_uchar, c_uint};\n23\t\n24\tunsafe extern \"C\" {\n25\t    /// libc's `abort()`, as used by `src/lib.c` via `<stdlib.h>`.\n26\t    ///\n27\t    /// Using the real libc `abort` (rather than a Rust-level panic) keeps the\n28\t    /// observable behaviour identical: the process dies from `SIGABRT`.\n29\t    fn abort() -> !;\n30\t}\n31\t\n32\t/// `SIZE_MAX` as spelled literally in the C source\n33\t/// (`18446744073709551615UL`). The C code hard-codes the 64-bit value, and the\n34\t/// build targets a 64-bit platform, so this is `usize::MAX` there.\n35\tconst C_SIZE_MAX: usize = 18446744073709551615u64 as usize;\n36\t\n37\t/// Translation of the branch-free nibble -> ASCII hex digit expression:\n38\t///\n39\t/// ```c\n40\t/// (unsigned char)(87U + n + (((n - 10U) >> 8) & ~38U))\n41\t/// ```\n42\t///\n43\t/// `n` is an `int` in C, but because it is combined with the `unsigned int`\n44\t/// constants `87U`, `10U` and `~38U`, every operation is carried out modulo\n45\t/// 2^32 in `unsigned int`. For `n < 10` the subtraction wraps around, the\n46\t/// right shift leaves `0x00ffffff`, and masking with `~38U` (`0xffffffd9`)\n47\t/// yields `0x00ffffd9`, so that `87 + n + 0x00ffffd9` truncates (via the\n48\t/// `(unsigned char)` cast) to `'0' + n`. For `10 <= n <= 15` the correction\n49\t/// term is zero and the result is `87 + n`, i.e. `'a' + n - 10`.\n50\t#[inline]\n51\tfn nibble_to_hex(n: c_int) -> c_uchar {\n52\t    let n = n as c_uint;\n53\t    let corrected = (87u32)\n54\t        .wrapping_add(n)\n55\t        .wrapping_add((n.wrapping_sub(10u32) >> 8) & !38u32);\n56\t    // The `(unsigned char)` cast keeps only the low 8 bits.\n57\t    corrected as c_uchar\n58\t}\n59\t\n60\t/// Byte-for-byte translation of `bin2hex` from `c_src/src/lib.c`.\n61\t///\n62\t/// # Safety\n63\t///\n64\t/// Same contract as the C function: `bin` must point to at least `bin_len`\n65\t/// readable bytes and `hex` must point to at least `bin_len * 2 + 1` writable\n66\t/// bytes (which the `hex_maxlen` check partially enforces, aborting otherwise).\n67\t#[unsafe(no_mangle)]\n68\tpub unsafe extern \"C\" fn bin2hex(\n69\t    hex: *mut c_char,\n70\t    hex_maxlen: usize,\n71\t    bin: *const u8,\n72\t    bin_len: usize,\n73\t) -> *mut c_char {\n74\t    // C: size_t i = (size_t)0U; unsigned int x; int b; int c;\n75\t    let mut i: usize = 0usize;\n76\t\n77\t    // if (bin_len >= (18446744073709551615UL) / 2 || hex_maxlen <= bin_len * 2U) {\n78\t    //     abort();\n79\t    // }\n80\t    //\n81\t    // Note the order of the checks and the short-circuiting `||`: the first\n82\t    // check guarantees that `bin_len * 2` cannot overflow. `bin_len * 2U`\n83\t    // promotes `2U` to `size_t`, so the product is computed in `size_t`.\n84\t    if bin_len >= C_SIZE_MAX / 2 || hex_maxlen <= bin_len.wrapping_mul(2usize) {\n85\t        unsafe { abort() };\n86\t    }\n87\t\n88\t    while i < bin_len {\n89\t        // c = bin[i] & 0xf;  b = bin[i] >> 4;   (uint8_t promoted to int)\n90\t        let byte = unsafe { *bin.add(i) } as c_int;\n91\t        let c: c_int = byte & 0xf;\n92\t        let b: c_int = byte >> 4;\n93\t        // x = lo_nibble_char << 8 | hi_nibble_char;\n94\t        let mut x: c_uint = ((nibble_to_hex(c) as c_uint) << 8) | (nibble_to_hex(b) as c_uint);\n95\t        // hex[i * 2U] = (char)x;  -> the high nibble's character\n96\t        unsafe { *hex.add(i.wrapping_mul(2usize)) = x as u8 as c_char };\n97\t        x >>= 8;\n98\t        // hex[i * 2U + 1U] = (char)x;  -> the low nibble's character\n99\t        unsafe { *hex.add(i.wrapping_mul(2usize).wrapping_add(1usize)) = x as u8 as c_char };\n100\t        i = i.wrapping_add(1usize);\n101\t    }\n102\t    // hex[i * 2U] = 0U;\n103\t    unsafe { *hex.add(i.wrapping_mul(2usize)) = 0 };\n104\t\n105\t    hex\n106\t}\n107\t"}]},"parent_tool_use_id":null,"session_id":"24cfdf76-de3a-44a8-ac84-719f360b110e","uuid":"75024a08-84b7-4aa1-92b5-c94b71354adc","timestamp":"2026-09-04T23:39:12.489Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-isR6ra/translation/src/lib.rs","content":"//! Rust translation of the C library in `c_src/`.\n//!\n//! The C library consists of a single translation unit (`src/lib.c`) whose only\n//! public (dynamically exported) symbol is `bin2hex`, declared in\n//! `include/lib.h` as:\n//!\n//! ```c\n//! char *bin2hex(char *hex, size_t hex_maxlen, const uint8_t *bin,\n//!               size_t bin_len);\n//! ```\n//!\n//! There are no namespace/renaming macros in the public header, so the final\n//! linker symbol is plain `bin2hex`.\n//!\n//! The translation reproduces the original C semantics exactly, including the\n//! constant-time-ish (branch free) nibble-to-ASCII conversion performed with\n//! wrapping `unsigned int` arithmetic, the exact order of the validation\n//! checks, and the `abort()` call on invalid arguments.\n\n#![allow(non_snake_case)]\n\nuse core::ffi::{c_char, c_int, c_uchar, c_uint};\n\nunsafe extern \"C\" {\n    /// libc's `abort()`, as used by `src/lib.c` via `<stdlib.h>`.\n    ///\n    /// Using the real libc `abort` (rather than a Rust-level panic) keeps the\n    /// observable behaviour identical: the process dies from `SIGABRT`.\n    fn abort() -> !;\n}\n\n/// `SIZE_MAX` as spelled literally in the C source\n/// (`18446744073709551615UL`). The C code hard-codes the 64-bit value, and the\n/// build targets a 64-bit platform, so this is `usize::MAX` there.\nconst C_SIZE_MAX: usize = 18446744073709551615u64 as usize;\n\n/// Translation of the branch-free nibble -> ASCII hex digit expression:\n///\n/// ```c\n/// (unsigned char)(87U + n + (((n - 10U) >> 8) & ~38U))\n/// ```\n///\n/// `n` is an `int` in C, but because it is combined with the `unsigned int`\n/// constants `87U`, `10U` and `~38U`, every operation is carried out modulo\n/// 2^32 in `unsigned int`. For `n < 10` the subtraction wraps around, the\n/// right shift leaves `0x00ffffff`, and masking with `~38U` (`0xffffffd9`)\n/// yields `0x00ffffd9`, so that `87 + n + 0x00ffffd9` truncates (via the\n/// `(unsigned char)` cast) to `'0' + n`. For `10 <= n <= 15` the correction\n/// term is zero and the result is `87 + n`, i.e. `'a' + n - 10`.\n#[inline]\nfn nibble_to_hex(n: c_int) -> c_uchar {\n    let n = n as c_uint;\n    let corrected = (87u32)\n        .wrapping_add(n)\n        .wrapping_add((n.wrapping_sub(10u32) >> 8) & !38u32);\n    // The `(unsigned char)` cast keeps only the low 8 bits.\n    corrected as c_uchar\n}\n\n/// Byte-for-byte translation of `bin2hex` from `c_src/src/lib.c`.\n///\n/// # Safety\n///\n/// Same contract as the C function: `bin` must point to at least `bin_len`\n/// readable bytes and `hex` must point to at least `bin_len * 2 + 1` writable\n/// bytes (which the `hex_maxlen` check partially enforces, aborting otherwise).\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn bin2hex(\n    hex: *mut c_char,\n    hex_maxlen: usize,\n    bin: *const u8,\n    bin_len: usize,\n) -> *mut c_char {\n    // C: size_t i = (size_t)0U; unsigned int x; int b; int c;\n    let mut i: usize = 0usize;\n\n    // if (bin_len >= (18446744073709551615UL) / 2 || hex_maxlen <= bin_len * 2U) {\n    //     abort();\n    // }\n    //\n    // Note the order of the checks and the short-circuiting `||`: the first\n    // check guarantees that `bin_len * 2` cannot overflow. `bin_len * 2U`\n    // promotes `2U` to `size_t`, so the product is computed in `size_t`.\n    if bin_len >= C_SIZE_MAX / 2 || hex_maxlen <= bin_len.wrapping_mul(2usize) {\n        unsafe { abort() };\n    }\n\n    while i < bin_len {\n        // c = bin[i] & 0xf;  b = bin[i] >> 4;   (uint8_t promoted to int)\n        let byte = unsafe { *bin.add(i) } as c_int;\n        let c: c_int = byte & 0xf;\n        let b: c_int = byte >> 4;\n        // x = lo_nibble_char << 8 | hi_nibble_char;\n        let mut x: c_uint = ((nibble_to_hex(c) as c_uint) << 8) | (nibble_to_hex(b) as c_uint);\n        // hex[i * 2U] = (char)x;  -> the high nibble's character\n        unsafe { *hex.add(i.wrapping_mul(2usize)) = x as u8 as c_char };\n        x >>= 8;\n        // hex[i * 2U + 1U] = (char)x;  -> the low nibble's character\n        unsafe { *hex.add(i.wrapping_mul(2usize).wrapping_add(1usize)) = x as u8 as c_char };\n        i = i.wrapping_add(1usize);\n    }\n    // hex[i * 2U] = 0U;\n    unsafe { *hex.add(i.wrapping_mul(2usize)) = 0 };\n\n    hex\n}\n","numLines":107,"startLine":1,"totalLines":107}}}
