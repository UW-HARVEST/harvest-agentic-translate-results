ons:\n    11\t// \n    12\t// The above copyright notice and this permission notice\n    13\t// shall be included in all copies or substantial portions of the Software.\n    14\t// \n    15\t// THE SOFTWARE IS PROVIDED “AS IS”, WITHOUT WARRANTY OF ANY KIND,\n    16\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    17\t// THE WARRANTIES OF MERCHANTABILITY,\n    18\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    19\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    20\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    21\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    22\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    23\t\n    24\t#include \"driver.h\"\n    25\t\n    26\t#include <stdio.h>\n    27\t\n    28\ttypedef struct {\n    29\t    int floors;\n    30\t    int bedrooms;\n    31\t    double bathrooms;\n    32\t} house_t;\n    33\t\n    34\tstatic void print_hex(unsigned char *p, int len) {\n    35\t    for (int i = 0; i < len; i++) {\n    36\t        printf(\"%02x\", p[i]);\n    37\t    }\n    38\t    printf(\"\\n\");\n    39\t}\n    40\t\n    41\tvoid driver(int floors) {\n    42\t    house_t house = {0};\n    43\t    house.floors = floors;\n    44\t    house.bedrooms = 3;\n    45\t    house.bathrooms = 2.;\n    46\t    print_hex((unsigned char *)&house, sizeof(house));\n    47\t}\n===== translation/Cargo.toml =====\n     1\t[package]\n     2\tname = \"driver\"\n     3\tversion = \"0.1.0\"\n     4\tedition = \"2021\"\n     5\t\n     6\t[lib]\n     7\tname = \"driver\"\n     8\tpath = \"src/lib.rs\"\n     9\tcrate-type = [\"cdylib\"]\n    10\t\n    11\t[profile.release]\n    12\tpanic = \"abort\"\n    13\t\n    14\t[workspace]\n===== translation/src/lib.rs =====\n     1\t// Rust translation of the C library in c_src/.\n     2\t//\n     3\t// Public ABI (matches `nm -D` on the C shared library):\n     4\t//   T driver\n     5\t//\n     6\t// Everything else in the C translation unit (`print_hex`, `house_t`) is\n     7\t// `static`/file-local and therefore stays private here.\n     8\t\n     9\tuse std::ffi::{c_char, c_double, c_int, c_uchar, c_uint};\n    10\t\n    11\textern \"C\" {\n    12\t    // Use the platform C library's `printf` so that the output goes through\n    13\t    // exactly the same `stdout` FILE stream (and buffering behaviour) as the\n    14\t    // original C library. This keeps interleaving with any other C output\n    15\t    // byte-identical.\n    16\t    fn printf(fmt: *const c_char, ...) -> c_int;\n    17\t}\n    18\t\n    19\t/// typedef struct {\n    20\t///     int floors;\n    21\t///     int bedrooms;\n    22\t///     double bathrooms;\n    23\t/// } house_t;\n    24\t#[repr(C)]\n    25\t#[derive(Clone, Copy)]\n    26\tstruct HouseT {\n    27\t    floors: c_int,\n    28\t    bedrooms: c_int,\n    29\t    bathrooms: c_double,\n    30\t}\n    31\t\n    32\timpl HouseT {\n    33\t    /// Equivalent of `house_t house = {0};` -- the whole object (including any\n    34\t    /// padding) is zero initialised.\n    35\t    const fn zeroed() -> Self {\n    36\t        HouseT {\n    37\t            floors: 0,\n    38\t            bedrooms: 0,\n    39\t            bathrooms: 0.0,\n    40\t        }\n    41\t    }\n    42\t}\n    43\t\n    44\t/// static void print_hex(unsigned char *p, int len)\n    45\tfn print_hex(p: *const c_uchar, len: c_int) {\n    46\t    let mut i: c_int = 0;\n    47\t    while i < len {\n    48\t        // `printf(\"%02x\", p[i]);` -- p[i] is promoted to int/unsigned int.\n    49\t        let byte = unsafe { *p.offset(i as isize) };\n    50\t        unsafe {\n    51\t            printf(b\"%02x\\0\".as_ptr() as *const c_char, byte as c_uint);\n    52\t        }\n    53\t        i += 1;\n    54\t    }\n    55\t    unsafe {\n    56\t        printf(b\"\\n\\0\".as_ptr() as *const c_char);\n    57\t    }\n    58\t}\n    59\t\n    60\t/// void driver(int floors)\n    6