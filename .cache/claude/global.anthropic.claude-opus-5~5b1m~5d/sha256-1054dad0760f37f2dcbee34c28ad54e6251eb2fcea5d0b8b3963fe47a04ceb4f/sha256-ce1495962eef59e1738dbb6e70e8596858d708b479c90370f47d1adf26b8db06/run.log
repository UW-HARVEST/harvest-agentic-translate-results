tversion = \"0.1.0\"\n     4\tedition = \"2021\"\n     5\t\n     6\t[lib]\n     7\tname = \"driver\"\n     8\tpath = \"src/lib.rs\"\n     9\tcrate-type = [\"cdylib\"]\n    10\t\n    11\t[profile.release]\n    12\tpanic = \"abort\"\n    13\t\n    14\t[workspace]\n===== translation/src/lib.rs =====\n     1\t// Rust translation of the C library in c_src/.\n     2\t//\n     3\t// Public ABI (matches `nm -D` on the C shared library):\n     4\t//   T driver\n     5\t//\n     6\t// Everything else in the C translation unit (`print_hex`, `house_t`) is\n     7\t// `static`/file-local and therefore stays private here.\n     8\t\n     9\tuse std::ffi::{c_char, c_double, c_int, c_uchar, c_uint};\n    10\t\n    11\textern \"C\" {\n    12\t    // Use the platform C library's `printf` so that the output goes through\n    13\t    // exactly the same `stdout` FILE stream (and buffering behaviour) as the\n    14\t    // original C library. This keeps interleaving with any other C output\n    15\t    // byte-identical.\n    16\t    fn printf(fmt: *const c_char, ...) -> c_int;\n    17\t}\n    18\t\n    19\t/// typedef struct {\n    20\t///     int floors;\n    21\t///     int bedrooms;\n    22\t///     double bathrooms;\n    23\t/// } house_t;\n    24\t#[repr(C)]\n    25\t#[derive(Clone, Copy)]\n    26\tstruct HouseT {\n    27\t    floors: c_int,\n    28\t    bedrooms: c_int,\n    29\t    bathrooms: c_double,\n    30\t}\n    31\t\n    32\timpl HouseT {\n    33\t    /// Equivalent of `house_t house = {0};` -- the whole object (including any\n    34\t    /// padding) is zero initialised.\n    35\t    const fn zeroed() -> Self {\n    36\t        HouseT {\n    37\t            floors: 0,\n    38\t            bedrooms: 0,\n    39\t            bathrooms: 0.0,\n    40\t        }\n    41\t    }\n    42\t}\n    43\t\n    44\t/// static void print_hex(unsigned char *p, int len)\n    45\tfn print_hex(p: *const c_uchar, len: c_int) {\n    46\t    let mut i: c_int = 0;\n    47\t    while i < len {\n