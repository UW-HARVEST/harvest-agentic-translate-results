");\n        log_info(NULL);\n        finalize_logger();\n    } else if (mode == 2) {\n        // task manager struct layout + field inspection\n        printf(\"sizes %zu %zu\\n\", sizeof(Task), sizeof(TaskManager));\n        int r = initialize_logger();\n        printf(\"INIT=%d\\n\", r);\n        TaskManager *m = create_task_manager();\n        if (!m) { printf(\"MGR=NULL\\n\"); finalize_logger(); dlclose(h); return 0; }\n        printf(\"max=%d count=%d tasksnull=%d\\n\", m->max_tasks, m->task_count, m->tasks==NULL);\n        char big[600];\n        memset(big, 'x', sizeof(big)); big[sizeof(big)-1] = 0;\n        add_task(m, \"alpha\", 5);\n        add_task(m, \"\", -1);\n        add_task(m, big, 2147483647);\n        add_task(m, \"gamma\", -2147483648);\n        for (int i = 0; i < 12; i++) add_task(m, \"flood\", i);\n        printf(\"after max=%d count=%d\\n\", m->max_tasks, m->task_count);\n        for (int i = 0; i < m->task_count; i++)\n            printf(\"F[%d] len=%zu p=%d last=%d\\n\", i, strlen(m->tasks[i].description),\n                   m->tasks[i].priority, (int)(unsigned char)m->tasks[i].description[255]);\n        print_tasks(m);\n        destroy_task_manager(m);\n        finalize_logger();\n    } else if (mode == 3) {\n        // print_tasks on a fully hand-built manager (no logger initialized)\n        Task t[3];\n        memset(t, 0, sizeof(t));\n        strcpy(t[0].description, \"one\"); t[0].priority = 1;\n        strcpy(t[1].description, \"%s%d%n oops\"); t[1].priority = -7;\n        strcpy(t[2].description, \"tab\\there\"); t[2].priority = 0;\n        TaskManager m; m.tasks = t; m.max_tasks = 3; m.task_count = 3;\n        print_tasks(&m);\n        m.task_count = 0;\n        print_tasks(&m);\n    }\n    dlclose(h);\n    return 0;\n}\nEOF\ngcc -O1 -o \"$TMPDIR/h/harness\" \"$TMPDIR/h/harness.c\" -ldl && echo HARNESS_OK","description":"Build differential dlopen test harness"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage