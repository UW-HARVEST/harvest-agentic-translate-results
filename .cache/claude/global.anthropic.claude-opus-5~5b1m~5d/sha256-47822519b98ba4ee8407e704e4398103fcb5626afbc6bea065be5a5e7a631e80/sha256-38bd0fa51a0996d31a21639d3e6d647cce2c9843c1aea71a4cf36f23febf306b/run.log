nager || !add_task || !print_tasks\n        || !destroy_task_manager) {\n        fprintf(stderr, \"missing symbol\\n\"); return 98;\n    }\n\n    if (mode == 0) {\n        int r = driver(argv[3]);\n        printf(\"RET=%d\\n\", r);\n    } else if (mode == 1) {\n        /* logging before init must be a silent no-op */\n        log_info(\"pre-init info\");\n        log_warning(\"pre-init warn\");\n        log_error(\"pre-init err\");\n        finalize_logger();\n        int r = initialize_logger();\n        printf(\"INIT=%d\\n\", r);\n        log_info(\"hello\");\n        log_warning(\"careful\");\n        log_error(\"boom\");\n        log_info(\"\");\n        log_info(NULL);\n        finalize_logger();\n        /* second init after finalize (append mode) */\n        int r2 = initialize_logger();\n        printf(\"INIT2=%d\\n\", r2);\n        log_info(\"second round\");\n        finalize_logger();\n    } else if (mode == 2) {\n        printf(\"sizes %zu %zu\\n\", sizeof(Task), sizeof(TaskManager));\n        int r = initialize_logger();\n        printf(\"INIT=%d\\n\", r);\n        TaskManager *m = create_task_manager();\n        if (!m) { printf(\"MGR=NULL\\n\"); finalize_logger(); return 0; }\n        printf(\"max=%d count=%d tasksnull=%d\\n\", m->max_tasks, m->task_count,\n               m->tasks == NULL);\n        char big[600];\n        memset(big, 'x', sizeof(big)); big[sizeof(big)-1] = 0;\n        char e255[256]; memset(e255, 'q', 255); e255[255] = 0;\n        add_task(m, \"alpha\", 5);\n        add_task(m, \"\", -1);\n        add_task(m, big, 2147483647);\n        add_task(m, e255, 42);\n        add_task(m, \"gamma\", -2147483647 - 1);\n        for (int i = 0; i < 12; i++) add_task(m, \"flood\", i);\n        printf(\"after max=%d count=%d\\n\", m->max_tasks, m->task_count);\n        for (int i = 0; i < m->task_count; i++)\n            printf(\"F[%d] len=%zu p=%d b255=%d\\n\", i,\n                   strlen(m->tasks[i].description), m->tasks[i].priority,\n                   (int)(unsigned char)m->tasks[i].description[255]);\n        print_tasks(m);\n        destroy_task_manager(m);\n        /* a second, independent manager */\n        TaskManager *m2 = create_task_manager();\n        if (m2) { add_task(m2, \"second\", 9); print_tasks(m2); destroy_task_manager(m2); }\n        finalize_logger();\n    } else if (mode == 3) {\n        Task t[4];\n        memset(t, 0, sizeof(t));\n        strcpy(t[0].description, \"one\"); t[0].priority = 1;\n        strcpy(t[1].description, \"%s%d%n oops\"); t[1].priority = -7;\n        strcpy(t[2].description, \"tab\\there\"); t[2].priority = 0;\n        memset(t[3].description, 'Z', 255); t[3].priority = 2147483647;\n        TaskManager m; m.tasks = t; m.max_tasks = 4; m.task_count = 4;\n        print_tasks(&m);\n        m.task_count = 0;  print_tasks(&m);\n        m.task_count = -5; print_tasks(&m);\n    }\n    return 0;\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
