\tpub unsafe extern \"C\" fn jumpnode_test_get_node_count() -> c_int {\n397\t    unsafe { NODE_COUNT }\n398\t}\n399\t\n400\t/// `find_node_by_id(id)`, returned as an index into `node_storage` (`-1` for NULL)\n401\t#[cfg(feature = \"expose_init_test_data\")]\n402\t#[unsafe(no_mangle)]\n403\tpub unsafe extern \"C\" fn jumpnode_test_find_node_index(id: c_int) -> c_int {\n404\t    let p = unsafe { find_node_by_id(id) };\n405\t    if p.is_null() {\n406\t        return -1;\n407\t    }\n408\t    let base = node_storage_base();\n409\t    unsafe { p.offset_from(base) as c_int }\n410\t}\n411\t\n412\t/// `compute_size_metric(s)`\n413\t#[cfg(feature = \"expose_init_test_data\")]\n414\t#[unsafe(no_mangle)]\n415\tpub unsafe extern \"C\" fn jumpnode_test_compute_size_metric(s: *const c_char) -> c_int {\n416\t    unsafe { compute_size_metric(s) }\n417\t}\n418\t\n419\t/// `safe_double_to_int(v)`\n420\t#[cfg(feature = \"expose_init_test_data\")]\n421\t#[unsafe(no_mangle)]\n422\tpub unsafe extern \"C\" fn jumpnode_test_safe_double_to_int(v: c_double) -> c_int {\n423\t    safe_double_to_int(v)\n424\t}\n425\t\n426\t/// `process_backward(array, size, start_offset)`\n427\t#[cfg(feature = \"expose_init_test_data\")]\n428\t#[unsafe(no_mangle)]\n429\tpub unsafe extern \"C\" fn jumpnode_test_process_backward(\n430\t    array: *mut c_int,\n431\t    size: usize,\n432\t    start_offset: c_int,\n433\t) -> c_int {\n434\t    unsafe { process_backward(array, size, start_offset) }\n435\t}\n436\t\n437\t/// Reads `node_storage[index]` into the caller's out-params.\n438\t#[cfg(feature = \"expose_init_test_data\")]\n439\t#[unsafe(no_mangle)]\n440\tpub unsafe extern \"C\" fn jumpnode_test_get_node(\n441\t    index: c_int,\n442\t    id: *mut c_int,\n443\t    parent_id: *mut c_int,\n444\t    value: *mut c_double,\n445\t    data_out: *mut c_int,\n446\t) -> c_int {\n447\t    if index < 0 || index as usize >= MAX_NODES {\n448\t        return -1;\n449\t    }\n450\t    let base = node_storage_base();\n451\t    u