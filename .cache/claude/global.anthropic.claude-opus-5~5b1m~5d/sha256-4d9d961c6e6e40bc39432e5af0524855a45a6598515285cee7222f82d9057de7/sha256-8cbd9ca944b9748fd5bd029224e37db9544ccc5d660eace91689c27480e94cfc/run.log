ta_out.add(k) = (*n).data[k];\n        }\n    }\n    0\n}\n\n#[cfg(feature = \"expose_init_test_data\")]\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn jumpnode_test_sizeof_node() -> c_int {\n    core::mem::size_of::<Node>() as c_int\n}\n\n#[cfg(feature = \"expose_init_test_data\")]\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn jumpnode_test_max_nodes() -> c_int {\n    MAX_NODES as c_int\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2708,"cache_read_input_tokens":41946,"cache_creation":{"ephemeral_5m_input_tokens":2708,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"4eff9d63-9e14-4627-9f0a-2df67eb432d6","uuid":"58828a23-c29c-4007-9418-d6b8c5484e93","timestamp":"2026-09-05T14:44:51.592Z"}
