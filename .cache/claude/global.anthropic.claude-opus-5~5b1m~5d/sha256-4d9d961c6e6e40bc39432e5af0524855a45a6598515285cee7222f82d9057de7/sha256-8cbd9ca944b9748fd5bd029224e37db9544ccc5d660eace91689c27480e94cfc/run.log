rage[MAX_NODES];\n45\tstatic mut NODE_STORAGE: [Node; MAX_NODES] = [Node {\n46\t    id: 0,\n47\t    parent_id: 0,\n48\t    value: 0.0,\n49\t    data: [0; 4],\n50\t}; MAX_NODES];\n51\t\n52\t/// static int node_count = 0;\n53\tstatic mut NODE_COUNT: c_int = 0;\n54\t\n55\tconst STATUS_OK: c_int = 0o0;\n56\tconst STATUS_WARNING: c_int = 0o1;\n57\tconst STATUS_ERROR: c_int = 0o2;\n58\tconst STATUS_CRITICAL: c_int = 0o377;\n59\t\n60\t/// Base pointer of `node_storage` (equivalent to the array-to-pointer decay of\n61\t/// `node_storage` in C).\n62\t#[inline]\n63\tfn node_storage_base() -> *mut Node {\n64\t    (&raw mut NODE_STORAGE).cast::<Node>()\n65\t}\n66\t\n67\t/// static Node* find_node_by_id(int id)\n68\tunsafe fn find_node_by_id(id: c_int) -> *mut Node {\n69\t    let base = node_storage_base();\n70\t    let count = unsafe { NODE_COUNT };\n71\t    let mut i: c_int = 0;\n72\t    while i < count {\n73\t        let elem = unsafe { base.offset(i as isize) };\n74\t        if unsafe { (*elem).id } == id {\n75\t            return elem;\n76\t        }\n77\t        i += 1;\n78\t    }\n79\t    core::ptr::null_mut()\n80\t}\n81\t\n82\t/// static int add_node(int id, int parent_id, double value)\n83\tunsafe fn add_node(id: c_int, parent_id: c_int, value: c_double) -> c_int {\n84\t    if unsafe { NODE_COUNT } as usize >= MAX_NODES {\n85\t        return STATUS_ERROR;\n86\t    }\n87\t\n88\t    let base = node_storage_base();\n89\t    let slot = unsafe { base.offset(NODE_COUNT as isize) };\n90\t\n91\t    unsafe {\n92\t        (*slot).id = id;\n93\t        (*slot).parent_id = parent_id;\n94\t        (*slot).value = value;\n95\t\n96\t        (*slot).data[0] = 0o100;\n97\t        (*slot).data[1] = 0o200;\n98\t        (*slot).data[2] = 0o300;\n99\t        (*slot).data[3] = 0o400;\n100\t\n101\t        NODE_COUNT += 1;\n102\t    }\n103\t\n104\t    STATUS_OK\n105\t}\n106\t\n107\t/// static int process_backward(int *array, size_t size, int start_offset)\n108\tunsafe fn process_backward(array: *mut c_int, size: usize, start_offset: c_int) -> c_int {\n109\t    let mut sum: c_int = 0;\n110\t\n111\t    // ptr = array + size;  start = array + start_offset;\n112\t    let mut ptr = unsafe { array.offset(size as isize) };\n113\t    let start = unsafe { array.offset(start_offset as isize) };\n114\t\n115\t    while ptr > start {\n116\t        ptr = unsafe { ptr.offset(-1) };\n117\t        sum = sum.wrapping_add(unsafe { *ptr });\n118\t    }\n119\t\n120\t    sum\n121\t}\n122\t\n123\t/// static int compute_size_metric(const char *str)\n124\tunsafe fn compute_size_metric(s: *const c_char) -> c_int {\n125\t    let len: usize = unsafe { c_strlen(s) };\n126\t    let mut metric: c_int;\n127\t\n128\t    metric = len as c_int;\n129\t\n130\t    metric = metric.wrapping_mul(2).wrapping_add(0o10);\n131\t\n132\t    metric\n133\t}\n134\t\n135\t/// strlen()\n136\tunsafe fn c_strlen(s: *const c_char) -> usize {\n137\t    let mut n: usize = 0;\n138\t    while unsafe { *s.add(n) } != 0 {\n139\t        n += 1;\n140\t    }\n141\t    n\n142\t}\n143\t\n144\t/// static int safe_double_to_int(double value)\n145\tfn safe_double_to_int(value: c_double) -> c_int {\n146\t    let mut value = value;\n147\t\n148\t    if value > 2147483647.0 {\n149\t        value = 2147483647.0;\n150\t    }\n151\t    if value < -2147483648.0 {\n152\t        value = -2147483648.0;\n153\t    }\n154\t\n155\t    value as c_int\n156\t}\n157\t\n158\t/// int jumpnode(int operation_mode, int node_id, int depth, int flags)\n159\t#[unsafe(no_mangle)]\n160\tpub unsafe extern \"C\" fn jumpnode(\n161\t    operation_mode: c_int,\n162\t    node_id: c_int,\n163\t    depth: c_int,\n164\t    flags: c_int,\n165\t) -> c_int {\n166\t    let mut current_node: *mut Node;\n167\t    let mut parent_node: *mut Node;\n168\t    let mut result: c_int = 0;\n169\t    let mut i: c_int;\n170\t    let mut accumulated_value: c_double;\n171\t    let mut temp_array: [c_int; 20] = [0; 20];\n172\t    let array_size: usize;\n173\t    let mut buffer: [c_char; 50] = [0; 50];\n174\t\n175\t    match operation_mode {\n176\t        0o1 => {\n177\t            current_node = unsafe { find_node_by_id(node_id) };\n178\t            if current_node.is_null() {\n179\t                return STATUS_ERROR | 0o20;\n180\t            }\n181\t\n182\t            accumulated_value = unsafe { (*current_node).value };\n183\t\n184\t            i = 0;\n185\t            while i < depth && unsafe { (*current_node).parent_id } != -1 {\n186\t                parent_node = unsafe { find_node_by_id((*current_node).parent_id) };\n187\t                if parent_node.is_null() {\n188\t                    break;\n189\t                }\n190\t\n191\t                accumulated_value += unsafe { (*parent_node).value } * 1.5;\n192\t                current_node = parent_node;\n193\t\n194\t                i += 1;\n195\t            }\n196\t\n197\t            result = safe_double_to_int(accumulated_value);\n198\t        }\n199\t\n200\t        0o2 => {\n201\t            current_node = unsafe { find_node_by_id(node_id) };\n202\t            if current_node.is_null() {\n203\t                return STATUS_ERROR | 0o40;\n204\t            }\n205\t\n206\t            i = 0;\n207\t            while i < 4 {\n208\t                temp_array[i as usize] = unsafe { (*current_node).data[i as usize] };\n209\t                i += 1;\n210\t            }\n211\t\n212\t            i = 4;\n213\t            while i < 0o20 {\n214\t                temp_array[i as usize] = i.wrapping_mul(0o7);\n215\t                i += 1;\n216\t            }\n217\t\n218\t            array_size = 0o20;\n219\t\n220\t            result = unsafe { process_backward(temp_array.as_mut_ptr(), array_size, depth) };\n221\t\n222\t            result = result.wrapping_add((array_size as c_int).wrapping_mul(flags));\n223\t        }\n224\t\n225\t        0o3 => {\n226\t            // sprintf(buffer, \"Node_%d_Depth_%d\", node_id, depth);\n227\t            c_sprintf_node_depth(&mut buffer, node_id, depth);\n228\t\n229\t            result = unsafe { compute_size_metric(buffer.as_ptr()) };\n230\t\n231\t            result = result.wrapping_add(flags & 0o177); /* Mask with octal 0177 */\n232\t        }\n233\t\n234\t        0o4 => {\n235\t            current_node = unsafe { find_node_by_id(node_id) };\n236\t            if current_node.is_null() {\n237\t                return STATUS_ERROR | 0o100;\n238\t            }\n239\t\n240\t            accumulated_value = 0.0;\n241\t            i = 0;\n242\t            while i < 4 {\n243\t                accumulated_value +=\n244\t                    (unsafe { (*current_node).data[i as usize] } as c_double).sqrt() * 2.718281828;\n245\t                i += 1;\n246\t            }\n247\t\n248\t            accumulated_value *= 1.0 + (depth as c_double) * 0.1;\n249\t\n250\t            result = safe_double_to_int(accumulated_value);\n251\t\n252\t            if unsafe { NODE_COUNT } > 2 {\n253\t                let base = node_storage_base();\n254\t                let end_ptr = unsafe { base.offset(NODE_COUNT as isize) };\n255\t                let mut iter = end_ptr;\n256\t                let mut backward_sum: c_int = 0;\n257\t\n258\t                i = 0;\n259\t                while i < 3 && iter > base {\n260\t                    iter = unsafe { iter.offset(-1) };\n261\t                    backward_sum =\n262\t                        backward_sum.wrapping_add(safe_double_to_int(unsafe { (*iter).value }));\n263\t                    i += 1;\n264\t                }\n265\t\n266\t                result = result.wrapping_add(backward_sum);\n267\t            }\n268\t        }\n269\t\n270\t        _ => {\n271\t            result = STATUS_ERROR | 0o200;\n272\t        }\n273\t    }\n274\t\n275\t    result\n276\t}\n277\t\n278\t/// Emulates `sprintf(buffer, \"Node_%d_Depth_%d\", node_id, depth)` writing into\n279\t/// the fixed 50-byte buffer, NUL terminated.\n280\tfn c_sprintf_node_depth(buffer: &mut [c_char; 50], node_id: c_int, depth: c_int) {\n281\t    let id_s = fmt_int(node_id);\n282\t    let depth_s = fmt_int(depth);\n283\t\n284\t    // Longest possible rendering is 5 + 11 + 7 + 11 = 34 bytes plus the NUL,\n285\t    // so it always fits in the 50 byte buffer (as it does in the C original).\n286\t    let mut pos: usize = 0;\n287\t    for part in [\n288\t        b\"Node_\".as_slice(),\n289\t        id_s.as_slice(),\n290\t        b\"_Depth_\".as_slice(),\n291\t        depth_s.as_slice(),\n292\t    ] {\n293\t        for &b in part {\n294\t            buffer[pos] = b as c_char;\n295\t            pos += 1;\n296\t        }\n297\t    }\n298\t    buffer[pos] = 0;\n299\t}\n300\t\n301\t/// Renders a `c_int` the way `printf(\"%d\", v)` does.\n302\tstruct IntStr {\n303\t    bytes: [u8; 12],\n304\t    len: usize,\n305\t}\n306\t\n307\timpl IntStr {\n308\t    fn as_slice(&self) -> &[u8] {\n309\t        &self.bytes[..self.len]\n310\t    }\n311\t}\n312\t\n313\tfn fmt_int(v: c_int) -> IntStr {\n314\t    let mut tmp = [0u8; 12];\n315\t    let mut n: usize = 0;\n316\t\n317\t    let negative = v < 0;\n318\t    // Use the unsigned magnitude so that i32::MIN is handled like C does.\n319\t    let mut mag: u32 = if negative {\n320\t        (v as i64).unsigned_abs() as u32\n321\t    } else {\n322\t        v as u32\n323\t    };\n324\t\n325\t    if mag == 0 {\n326\t        tmp[n] = b'0';\n327\t        n += 1;\n328\t    } else {\n329\t        while mag > 0 {\n330\t            tmp[n] = b'0' + (mag % 10) as u8;\n331\t            mag /= 10;\n332\t            n += 1;\n333\t        }\n334\t    }\n335\t    if negative {\n336\t        tmp[n] = b'-';\n337\t        n += 1;\n338\t    }\n339\t\n340\t    // reverse\n341\t    let mut bytes = [0u8; 12];\n342\t    for k in 0..n {\n343\t        bytes[k] = tmp[n - 1 - k];\n344\t    }\n345\t\n346\t    IntStr { bytes, len: n }\n347\t}\n348\t\n349\t/// static void initialize_test_data(void)\n350\t///\n351\t/// Present in the original C source but never called; preserved here (and\n352\t/// likewise never calle