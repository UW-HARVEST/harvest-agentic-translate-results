{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_018L83eoxq4dUwB33HjLvJtK","type":"tool_result","content":"1\t//! Faithful Rust translation of the C library in `c_src/`.\n2\t//!\n3\t//! The C library consists of a single translation unit (`src/lib.c`) whose only\n4\t//! exported (public) symbol is `ima_parse`.  Everything else in the C source is\n5\t//! `static` (internal linkage) and therefore not part of the ABI, but it is\n6\t//! translated here as well so that the observable behaviour is identical.\n7\t//!\n8\t//! Layout notes (x86-64 / LP64 System V, matching the C compiler):\n9\t//!\n10\t//! ```text\n11\t//! struct caf_header            size  8, align 4   type@0  version@4  flags@6\n12\t//! struct caf_chunk             size 16, align 8   type@0  size@8      (4 bytes padding @4)\n13\t//! struct caf_audio_description size 32, align 8   sample_rate@0 format_id@8 format_flags@12\n14\t//!                                                 bytes_per_packet@16 frames_per_packet@20\n15\t//!                                                 channels_per_frame@24 bits_per_channel@28\n16\t//! struct caf_packet_table      size 24, align 8   packet_count@0 frame_count@8\n17\t//!                                                 priming_frames@16 remainder_frames@20\n18\t//! struct caf_data              size  4, align 4   edit_count@0\n19\t//! struct ima_block             size 34, align 2   preamble@0 data@2\n20\t//! struct ima_info              size 40, align 8   blocks@0 size@8 sample_rate@16\n21\t//!                                                 frame_count@24 channel_count@32\n22\t//! ```\n23\t//!\n24\t//! The C code contains a number of oddities (a chunk header that is 16 bytes\n25\t//! instead of the 12 bytes the CAF format actually uses because of struct\n26\t//! padding, an unguarded infinite chunk scan, unchecked `desc`/`pakt` NULL\n27\t//! pointers, and a `double` -> `unsigned long long` *value* conversion of the\n28\t//! raw sample-rate bits before the byte swap).  None of these are \"fixed\"\n29\t//! here: they are reproduced bit for bit.\n30\t\n31\t#![allow(non_camel_case_types)]\n32\t\n33\tuse core::ffi::{c_int, c_void};\n34\t\n35\t// ---------------------------------------------------------------------------\n36\t// include/lib.h\n37\t// ---------------------------------------------------------------------------\n38\t\n39\tpub type ima_u32_t = u32;\n40\tpub type ima_u64_t = u64;\n41\tpub type ima_f64_t = f64;\n42\t\n43\tpub type ima_u8_t = u8;\n44\tpub type ima_u16_t = u16;\n45\t\n46\t/// `struct ima_block` from `include/lib.h` (size 34, align 2).\n47\t#[repr(C)]\n48\tpub struct ima_block {\n49\t    pub preamble: ima_u16_t,\n50\t    pub data: [ima_u8_t; 32],\n51\t}\n52\t\n53\t/// `struct ima_info` from `include/lib.h` (size 40, align 8).\n54\t#[repr(C)]\n55\tpub struct ima_info {\n56\t    pub blocks: *const ima_block,\n57\t    pub size: ima_u64_t,\n58\t    pub sample_rate: ima_f64_t,\n59\t    pub frame_count: ima_u64_t,\n60\t    pub channel_count: ima_u32_t,\n61\t}\n62\t\n63\t// Compile-time confirmation that the public structures have the exact layout\n64\t// the C compiler gives them (verified against `sizeof`/`offsetof` output of the\n65\t// original library).\n66\tconst _: () = {\n67\t    assert!(core::mem::size_of::<ima_block>() == 34);\n68\t    assert!(core::mem::align_of::<ima_block>() == 2);\n69\t    assert!(core::mem::size_of::<ima_info>() == 40);\n70\t    assert!(core::mem::align_of::<ima_info>() == 8);\n71\t    assert!(core::mem::offset_of!(ima_info, blocks) == 0);\n72\t    assert!(core::mem::offset_of!(ima_info, size) == 8);\n73\t    assert!(core::mem::offset_of!(ima_info, sample_rate) == 16);\n74\t    assert!(core::mem::offset_of!(ima_info, frame_count) == 24);\n75\t    assert!(core::mem::offset_of!(ima_info, channel_count) == 32);\n76\t};\n77\t\n78\t// ---------------------------------------------------------------------------\n79\t// src/lib.c -- private types\n80\t// ---------------------------------------------------------------------------\n81\t\n82\tpub type ima_s32_t = i32;\n83\tpub type ima_s64_t = i64;\n84\t\n85\t// Sizes of the private CAF structures, including the tail padding the C\n86\t// compiler inserts.  These are what the pointer arithmetic in `ima_parse`\n87\t// (`&header[1]`, `&chunk[1]`, ...) is scaled by.\n88\tconst SIZEOF_CAF_HEADER: usize = 8;\n89\tconst SIZEOF_CAF_CHUNK: usize = 16;\n90\tconst SIZEOF_CAF_DATA: usize = 4;\n91\t\n92\t// Field offsets within the private CAF structures.\n93\tconst CAF_HEADER_TYPE: usize = 0;\n94\tconst CAF_HEADER_VERSION: usize = 4;\n95\t\n96\tconst CAF_CHUNK_TYPE: usize = 0;\n97\tconst CAF_CHUNK_SIZE: usize = 8;\n98\t\n99\tconst CAF_DESC_SAMPLE_RATE: usize = 0;\n100\tconst CAF_DESC_FORMAT_ID: usize = 8;\n101\tconst CAF_DESC_CHANNELS_PER_FRAME: usize = 24;\n102\t\n103\tconst CAF_PAKT_FRAME_COUNT: usize = 8;\n104\t\n105\t// FourCC helper mirroring the open-coded expressions in the C source:\n106\t//   ((ima_u32_t)(ima_u8_t)(a) | ((ima_u32_t)(ima_u8_t)(b) << 8) |\n107\t//    ((ima_u32_t)(ima_u8_t)(c) << 16) | ((ima_u32_t)(ima_u8_t)(d) << 24))\n108\tconst fn fourcc(a: u8, b: u8, c: u8, d: u8) -> ima_u32_t {\n109\t    (a as ima_u32_t) | ((b as ima_u32_t) << 8) | ((c as ima_u32_t) << 16) | ((d as ima_u32_t) << 24)\n110\t}\n111\t\n112\t// `'f' | 'f' << 8 | 'a' << 16 | 'c' << 24` == 0x63616666\n113\tconst CAF_TYPE_CAFF: ima_u32_t = fourcc(b'f', b'f', b'a', b'c');\n114\t// `'c' | 's' << 8 | 'e' << 16 | 'd' << 24` == 0x64657363\n115\tconst CAF_TYPE_DESC: ima_u32_t = fourcc(b'c', b's', b'e', b'd');\n116\t// `'t' | 'k' << 8 | 'a' << 16 | 'p' << 24` == 0x70616b74\n117\tconst CAF_TYPE_PAKT: ima_u32_t = fourcc(b't', b'k', b'a', b'p');\n118\t// `'a' | 't' << 8 | 'a' << 16 | 'd' << 24` == 0x64617461\n119\tconst CAF_TYPE_DATA: ima_u32_t = fourcc(b'a', b't', b'a', b'd');\n120\t// `'4' | 'a' << 8 | 'm' << 16 | 'i' << 24` == 0x696d6134\n121\tconst CAF_FORMAT_IMA4: ima_u32_t = fourcc(b'4', b'a', b'm', b'i');\n122\t\n123\t// ---------------------------------------------------------------------------\n124\t// src/lib.c -- static byte-swap helpers\n125\t// ---------------------------------------------------------------------------\n126\t\n127\t/// `static ima_u16_t ima_bswap16(ima_u16_t v)`\n128\t#[inline]\n129\tfn ima_bswap16(v: ima_u16_t) -> ima_u16_t {\n130\t    ((v as u32) << 0x08 & 0xff00u32) as ima_u16_t | (v >> 0x08 & 0x00ffu16)\n131\t}\n132\t\n133\t/// `static ima_u32_t ima_bswap32(ima_u32_t v)`\n134\t#[inline]\n135\tfn ima_bswap32(v: ima_u32_t) -> ima_u32_t {\n136\t    (v << 0x18 & 0xff000000u32)\n137\t        | (v << 0x08 & 0x00ff0000u32)\n138\t        | (v >> 0x08 & 0x0000ff00u32)\n139\t        | (v >> 0x18 & 0x000000ffu32)\n140\t}\n141\t\n142\t/// `static ima_u64_t ima_bswap64(ima_u64_t v)`\n143\t#[inline]\n144\tfn ima_bswap64(v: ima_u64_t) -> ima_u64_t {\n145\t    (v << 0x38 & 0xff00000000000000u64)\n146\t        | (v << 0x28 & 0x00ff000000000000u64)\n147\t        | (v << 0x18 & 0x0000ff0000000000u64)\n148\t        | (v << 0x08 & 0x000000ff00000000u64)\n149\t        | (v >> 0x08 & 0x00000000ff000000u64)\n150\t        | (v >> 0x18 & 0x0000000000ff0000u64)\n151\t        | (v >> 0x28 & 0x000000000000ff00u64)\n152\t        | (v >> 0x38 & 0x00000000000000ffu64)\n153\t}\n154\t\n155\t/// `static ima_u16_t ima_btoh16(ima_u16_t v)` -- big-endian to host.\n156\t///\n157\t/// The C code always byte-swaps (it is only correct on little-endian hosts);\n158\t/// that unconditional swap is preserved here.\n159\t#[inline]\n160\tfn ima_btoh16(v: ima_u16_t) -> ima_u16_t {\n161\t    ima_bswap16(v)\n162\t}\n163\t\n164\t/// `static ima_u32_t ima_btoh32(ima_u32_t v)`\n165\t#[inline]\n166\tfn ima_btoh32(v: ima_u32_t) -> ima_u32_t {\n167\t    ima_bswap32(v)\n168\t}\n169\t\n170\t/// `static ima_u64_t ima_btoh64(ima_u64_t v)`\n171\t#[inline]\n172\tfn ima_btoh64(v: ima_u64_t) -> ima_u64_t {\n173\t    ima_bswap64(v)\n174\t}\n175\t\n176\t// ---------------------------------------------------------------------------\n177\t// Helpers that are not present in the C source\n178\t// ---------------------------------------------------------------------------\n179\t\n180\t// The C code reads the CAF structures through pointers that are cast straight\n181\t// from the caller's buffer, so the accesses may be misaligned.  These helpers\n182\t// perform the same loads without relying on alignment.\n183\t\n184\t#[inline]\n185\tunsafe fn load_u16(base: *const u8, offset: usize) -> ima_u16_t {\n186\t    core::ptr::read_unaligned(base.add(offset) as *const ima_u16_t)\n187\t}\n188\t\n189\t#[inline]\n190\tunsafe fn load_u32(base: *const u8, offset: usize) -> ima_u32_t {\n191\t    core::ptr::read_unaligned(base.add(offset) as *const ima_u32_t)\n192\t}\n193\t\n194\t#[inline]\n195\tunsafe fn load_u64(base: *const u8, offset: usize) -> ima_u64_t {\n196\t    core::ptr::read_unaligned(base.add(offset) as *const ima_u64_t)\n197\t}\n198\t\n199\t#[inline]\n200\tunsafe fn load_f64(base: *const u8, offset: usize) -> ima_f64_t {\n201\t    core::ptr::read_unaligned(base.add(offset) as *const ima_f64_t)\n202\t}\n203\t\n204\t/// x86-64 `cvttsd2si` with a 64-bit destination: truncate toward zero, and\n205\t/// yield the \"integer indefinite\" value `0x8000000000000000` whenever the\n206\t/// result is not representable (NaN, infinity, out-of-range magnitude).\n207\t#[inline]\n208\tfn cvttsd2si64(x: ima_f64_t) -> ima_s64_t {\n209\t    if x.is_nan() {\n210\t        return ima_s64_t::MIN;\n211\t    }\n212\t    let t = x.trunc();\n213\t    // -2^63 is exactly representable as a double; +2^63 is not in range.\n214\t    if t >= -9223372036854775808.0 && t < 9223372036854775808.0 {\n215\t        t as ima_s64_t\n216\t    } else {\n217\t        ima_s64_t::MIN\n218\t    }\n219\t}\n220\t\n221\t/// The C expression `(ima_u64_t)some_double`, as implemented by the C compiler\n222\t/// on x86-64:\n223\t///\n224\t/// ```text\n225\t///     comisd xmm0, 2^63\n226\t///     jae    .big              ; taken only when the compare is ordered and x >= 2^63\n227\t///     cvttsd2si rax, xmm0\n228\t///     ...\n229\t/// .big:\n230\t///     subsd  xmm0, 2^63\n231\t///     cvttsd2si rax, xmm0\n232\t///     btc    rax, 63\n233\t/// ```\n234\t///\n235\t/// Rust's `as` cast saturates instead, so the hardware behaviour (which is\n236\t/// what the C library exhibits for out-of-range and negative values) has to be\n237\t/// spelled out.\n238\t#[inline]\n239\tfn double_to_u64(x: ima_f64_t) -> ima_u64_t {\n240\t    const TWO_POW_63: ima_f64_t = 9223372036854775808.0;\n241\t    if x >= TWO_POW_63 {\n242\t        // `x` is ordered and >= 2^63 here (a NaN compares false).\n243\t        (cvttsd2si64(x - TWO_POW_63) as ima_u64_t) ^ (1u64 << 63)\n244\t    } else {\n245\t        cvttsd2si64(x) as ima_u64_t\n246\t    }\n247\t}\n248\t\n249\t// ---------------------------------------------------------------------------\n250\t// src/lib.c -- public entry point\n251\t// ---------------------------------------------------------------------------\n252\t\n253\t/// `int ima_parse(struct ima_info *info, const void *data)`\n254\t// `blocks`/`desc`/`pakt` are initialised to NULL exactly as in the C source,\n255\t// even though the NULL value of `blocks` can never be observed.\n256\t#[allow(unused_assignments)]\n257\t#[unsafe(no_mangle)]\n258\tpub unsafe extern \"C\" fn ima_parse(info: *mut ima_info, data: *const c_void) -> c_int {\n259\t    let header: *const u8 = data as *const u8;\n260\t    // const struct caf_chunk *chunk = (const struct caf_chunk *)&header[1];\n261\t    let mut chunk: *const u8 = header.wrapping_add(SIZEOF_CAF_HEADER);\n262\t    let mut desc: *const u8 = core::ptr::null();\n263\t    let mut pakt: *const u8 = core::ptr::null();\n264\t    let mut blocks: *const ima_block = core::ptr::null();\n265\t    // union { ima_f64_t f; ima_u64_t u; } conv64;\n266\t    let mut conv64_u: ima_u64_t;\n267\t    let mut chunk_size: ima_s64_t;\n268\t    let mut chunk_type: ima_u32_t;\n269\t\n270\t    if ima_btoh32(load_u32(header, CAF_HEADER_TYPE)) != CAF_TYPE_CAFF {\n271\t        return -1;\n272\t    }\n273\t    if ima_btoh16(load_u16(header, CAF_HEADER_VERSION)) != 1 {\n274\t        return -2;\n275\t    }\n276\t    loop {\n277\t        chunk_type = ima_btoh32(load_u32(chunk, CAF_CHUNK_TYPE));\n278\t        chunk_size = ima_btoh64(load_u64(chunk, CAF_CHUNK_SIZE)) as ima_s64_t;\n279\t        if chunk_type == CAF_TYPE_DESC {\n280\t            // desc = (const struct caf_audio_description *)&chunk[1];\n281\t            desc = chunk.wrapping_add(SIZEOF_CAF_CHUNK);\n282\t        } else if chunk_type == CAF_TYPE_PAKT {\n283\t            // pakt = (const struct caf_packet_table *)&chunk[1];\n284\t            pakt = chunk.wrapping_add(SIZEOF_CAF_CHUNK);\n285\t        } else if chunk_type == CAF_TYPE_DATA {\n286\t            // blocks = (const struct ima_block *)&((const struct caf_data *)&chunk[1])[1];\n287\t            blocks = chunk\n288\t                .wrapping_add(SIZEOF_CAF_CHUNK)\n289\t                .wrapping_add(SIZEOF_CAF_DATA) as *const ima_block;\n290\t            break;\n291\t        }\n292\t        // chunk = (const struct caf_chunk *)((const ima_u8_t *)&chunk[1] + chunk_size);\n293\t        chunk = chunk\n294\t            .wrapping_add(SIZEOF_CAF_CHUNK)\n295\t            .wrapping_offset(chunk_size as isize);\n296\t    }\n297\t    if ima_btoh32(load_u32(desc, CAF_DESC_FORMAT_ID)) != CAF_FORMAT_IMA4 {\n298\t        return -3;\n299\t    }\n300\t    (*info).blocks = blocks;\n301\t    (*info).size = chunk_size as ima_u64_t;\n302\t    (*info).frame_count = ima_btoh64(load_u64(pakt, CAF_PAKT_FRAME_COUNT));\n303\t    (*info).channel_count = ima_btoh32(load_u32(desc, CAF_DESC_CHANNELS_PER_FRAME));\n304\t    // conv64.u = desc->sample_rate;  <-- floating point *value* conversion\n305\t    conv64_u = double_to_u64(load_f64(desc, CAF_DESC_SAMPLE_RATE));\n306\t    // conv64.u = ima_btoh64(*(const ima_u64_t *)&conv64.u);\n307\t    conv64_u = ima_btoh64(conv64_u);\n308\t    // info->sample_rate = conv64.f;  <-- read back through the other member\n309\t    (*info).sample_rate = ima_f64_t::from_bits(conv64_u);\n310\t    0\n311\t}\n312\t"}]},"parent_tool_use_id":null,"session_id":"19405ed4-554f-490b-a6e2-07840dfb1465","uuid":"b93a9c4d-ce8c-4751-804a-387db2e1fa21","timestamp":"2026-09-05T00:56:05.524Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-WmMOBZ/translation/src/lib.rs","content":"//! Faithful Rust translation of the C library in `c_src/`.\n//!\n//! The C library consists of a single translation unit (`src/lib.c`) whose only\n//! exported (public) symbol is `ima_parse`.  Everything else in the C source is\n//! `static` (internal linkage) and therefore not part of the ABI, but it is\n//! translated here as well so that the observable behaviour is identical.\n//!\n//! Layout notes (x86-64 / LP64 System V, matching the C compiler):\n//!\n//! ```text\n//! struct caf_header            size  8, align 4   type@0  version@4  flags@6\n//! struct caf_chunk             size 16, align 8   type@0  size@8      (4 bytes padding @4)\n//! struct caf_audio_description size 32, align 8   sample_rate@0 format_id@8 format_flags@12\n//!                                                 bytes_per_packet@16 frames_per_packet@20\n//!                                                 channels_per_frame@24 bits_per_channel@28\n//! struct caf_packet_table      size 24, align 8   packet_count@0 frame_count@8\n//!                                                 priming_frames@16 remainder_frames@20\n//! struct caf_data              size  4, align 4   edit_count@0\n//! struct ima_block             size 34, align 2   preamble@0 data@2\n//! struct ima_info              size 40, align 8   blocks@0 size@8 sample_rate@16\n//!                                                 frame_count@24 channel_count@32\n//! ```\n//!\n//! The C code contains a number of oddities (a chunk header that is 16 bytes\n//! instead of the 12 bytes the CAF format actually uses because of struct\n//! padding, an unguarded infinite chunk scan, unchecked `desc`/`pakt` NULL\n//! pointers, and a `double` -> `unsigned long long` *value* conversion of the\n//! raw sample-rate bits before the byte swap).  None of these are \"fixed\"\n//! here: they are reproduced bit for bit.\n\n#![allow(non_camel_case_types)]\n\nuse core::ffi::{c_int, c_void};\n\n// ---------------------------------------------------------------------------\n// include/lib.h\n// ---------------------------------------------------------------------------\n\npub type ima_u32_t = u32;\npub type ima_u64_t = u64;\npub type ima_f64_t = f64;\n\npub type ima_u8_t = u8;\npub type ima_u16_t = u16;\n\n/// `struct ima_block` from `include/lib.h` (size 34, align 2).\n#[repr(C)]\npub struct ima_block {\n    pub preamble: ima_u16_t,\n    pub data: [ima_u8_t; 32],\n}\n\n/// `struct ima_info` from `include/lib.h` (size 40, align 8).\n#[repr(C)]\npub struct ima_info {\n    pub blocks: *const ima_block,\n    pub size: ima_u64_t,\n    pub sample_rate: ima_f64_t,\n    pub frame_count: ima_u64_t,\n    pub channel_count: ima_u32_t,\n}\n\n// Compile-time confirmation that the public structures have the exact layout\n// the C compiler gives them (verified against `sizeof`/`offsetof` output of the\n// original library).\nconst _: () = {\n    assert!(core::mem::size_of::<ima_block>() == 34);\n    assert!(core::mem::align_of::<ima_block>() == 2);\n    assert!(core::mem::size_of::<ima_info>() == 40);\n    assert!(core::mem::align_of::<ima_info>() == 8);\n    assert!(core::mem::offset_of!(ima_info, blocks) == 0);\n    assert!(core::mem::offset_of!(ima_info, size) == 8);\n    assert!(core::mem::offset_of!(ima_info, sample_rate) == 16);\n    assert!(core::mem::offset_of!(ima_info, frame_count) == 24);\n    assert!(core::mem::offset_of!(ima_info, channel_count) == 32);\n};\n\n// ---------------------------------------------------------------------------\n// src/lib.c -- private types\n// ---------------------------------------------------------------------------\n\npub type ima_s32_t = i32;\npub type ima_s64_t = i64;\n\n// Sizes of the private CAF structures, including the tail padding the C\n// compiler inserts.  These are what the pointer arithmetic in `ima_parse`\n// (`&header[1]`, `&chunk[1]`, ...) is scaled by.\nconst SIZEOF_CAF_HEADER: usize = 8;\nconst SIZEOF_CAF_CHUNK: usize = 16;\nconst SIZEOF_CAF_DATA: usize = 4;\n\n// Field offsets within the private CAF structures.\nconst CAF_HEADER_TYPE: usize = 0;\nconst CAF_HEADER_VERSION: usize = 4;\n\nconst CAF_CHUNK_TYPE: usize = 0;\nconst CAF_CHUNK_SIZE: usize = 8;\n\nconst CAF_DESC_SAMPLE_RATE: usize = 0;\nconst CAF_DESC_FORMAT_ID: usize = 8;\nconst CAF_DESC_CHANNELS_PER_FRAME: usize = 24;\n\nconst CAF_PAKT_FRAME_COUNT: usize = 8;\n\n// FourCC helper mirroring the open-coded expressions in the C source:\n//   ((ima_u32_t)(ima_u8_t)(a) | ((ima_u32_t)(ima_u8_t)(b) << 8) |\n//    ((ima_u32_t)(ima_u8_t)(c) << 16) | ((ima_u32_t)(ima_u8_t)(d) << 24))\nconst fn fourcc(a: u8, b: u8, c: u8, d: u8) -> ima_u32_t {\n    (a as ima_u32_t) | ((b as ima_u32_t) << 8) | ((c as ima_u32_t) << 16) | ((d as ima_u32_t) << 24)\n}\n\n// `'f' | 'f' << 8 | 'a' << 16 | 'c' << 24` == 0x63616666\nconst CAF_TYPE_CAFF: ima_u32_t = fourcc(b'f', b'f', b'a', b'c');\n// `'c' | 's' << 8 | 'e' << 16 | 'd' << 24` == 0x64657363\nconst CAF_TYPE_DESC: ima_u32_t = fourcc(b'c', b's', b'e', b'd');\n// `'t' | 'k' << 8 | 'a' << 16 | 'p' << 24` == 0x70616b74\nconst CAF_TYPE_PAKT: ima_u32_t = fourcc(b't', b'k', b'a', b'p');\n// `'a' | 't' << 8 | 'a' << 16 | 'd' << 24` == 0x64617461\nconst CAF_TYPE_DATA: ima_u32_t = fourcc(b'a', b't', b'a', b'd');\n// `'4' | 'a' << 8 | 'm' << 16 | 'i' << 24` == 0x696d6134\nconst CAF_FORMAT_IMA4: ima_u32_t = fourcc(b'4', b'a', b'm', b'i');\n\n// ---------------------------------------------------------------------------\n// src/lib.c -- static byte-swap helpers\n// ---------------------------------------------------------------------------\n\n/// `static ima_u16_t ima_bswap16(ima_u16_t v)`\n#[inline]\nfn ima_bswap16(v: ima_u16_t) -> ima_u16_t {\n    ((v as u32) << 0x08 & 0xff00u32) as ima_u16_t | (v >> 0x08 & 0x00ffu16)\n}\n\n/// `static ima_u32_t ima_bswap32(ima_u32_t v)`\n#[inline]\nfn ima_bswap32(v: ima_u32_t) -> ima_u32_t {\n    (v << 0x18 & 0xff000000u32)\n        | (v << 0x08 & 0x00ff0000u32)\n        | (v >> 0x08 & 0x0000ff00u32)\n        | (v >> 0x18 & 0x000000ffu32)\n}\n\n/// `static ima_u64_t ima_bswap64(ima_u64_t v)`\n#[inline]\nfn ima_bswap64(v: ima_u64_t) -> ima_u64_t {\n    (v << 0x38 & 0xff00000000000000u64)\n        | (v << 0x28 & 0x00ff000000000000u64)\n        | (v << 0x18 & 0x0000ff0000000000u64)\n        | (v << 0x08 & 0x000000ff00000000u64)\n        | (v >> 0x08 & 0x00000000ff000000u64)\n        | (v >> 0x18 & 0x0000000000ff0000u64)\n        | (v >> 0x28 & 0x000000000000ff00u64)\n        | (v >> 0x38 & 0x00000000000000ffu64)\n}\n\n/// `static ima_u16_t ima_btoh16(ima_u16_t v)` -- big-endian to host.\n///\n/// The C code always byte-swaps (it is only correct on little-endian hosts);\n/// that unconditional swap is preserved here.\n#[inline]\nfn ima_btoh16(v: ima_u16_t) -> ima_u16_t {\n    ima_bswap16(v)\n}\n\n/// `static ima_u32_t ima_btoh32(ima_u32_t v)`\n#[inline]\nfn ima_btoh32(v: ima_u32_t) -> ima_u32_t {\n    ima_bswap32(v)\n}\n\n/// `static ima_u64_t ima_btoh64(ima_u64_t v)`\n#[inline]\nfn ima_btoh64(v: ima_u64_t) -> ima_u64_t {\n    ima_bswap64(v)\n}\n\n// ---------------------------------------------------------------------------\n// Helpers that are not present in the C source\n// ---------------------------------------------------------------------------\n\n// The C code reads the CAF structures through pointers that are cast straight\n// from the caller's buffer, so the accesses may be misaligned.  These helpers\n// perform the same loads without relying on alignment.\n\n#[inline]\nunsafe fn load_u16(base: *const u8, offset: usize) -> ima_u16_t {\n    core::ptr::read_unaligned(base.add(offset) as *const ima_u16_t)\n}\n\n#[inline]\nunsafe fn load_u32(base: *const u8, offset: usize) -> ima_u32_t {\n    core::ptr::read_unaligned(base.add(offset) as *const ima_u32_t)\n}\n\n#[inline]\nunsafe fn load_u64(base: *const u8, offset: usize) -> ima_u64_t {\n    core::ptr::read_unaligned(base.add(offset) as *const ima_u64_t)\n}\n\n#[inline]\nunsafe fn load_f64(base: *const u8, offset: usize) -> ima_f64_t {\n    core::ptr::read_unaligned(base.add(offset) as *const ima_f64_t)\n}\n\n/// x86-64 `cvttsd2si` with a 64-bit destination: truncate toward zero, and\n/// yield the \"integer indefinite\" value `0x8000000000000000` whenever the\n/// result is not representable (NaN, infinity, out-of-range magnitude).\n#[inline]\nfn cvttsd2si64(x: ima_f64_t) -> ima_s64_t {\n    if x.is_nan() {\n        return ima_s64_t::MIN;\n    }\n    let t = x.trunc();\n    // -2^63 is exactly representable as a double; +2^63 is not in range.\n    if t >= -9223372036854775808.0 && t < 9223372036854775808.0 {\n        t as ima_s64_t\n    } else {\n        ima_s64_t::MIN\n    }\n}\n\n/// The C expression `(ima_u64_t)some_double`, as implemented by the C compiler\n/// on x86-64:\n///\n/// ```text\n///     comisd xmm0, 2^63\n///     jae    .big              ; taken only when the compare is ordered and x >= 2^63\n///     cvttsd2si rax, xmm0\n///     ...\n/// .big:\n///     subsd  xmm0, 2^63\n///     cvttsd2si rax, xmm0\n///     btc    rax, 63\n/// ```\n///\n/// Rust's `as` cast saturates instead, so the hardware behaviour (which is\n/// what the C library exhibits for out-of-range and negative values) has to be\n/// spelled out.\n#[inline]\nfn double_to_u64(x: ima_f64_t) -> ima_u64_t {\n    const TWO_POW_63: ima_f64_t = 9223372036854775808.0;\n    if x >= TWO_POW_63 {\n        // `x` is ordered and >= 2^63 here (a NaN compares false).\n        (cvttsd2si64(x - TWO_POW_63) as ima_u64_t) ^ (1u64 << 63)\n    } else {\n        cvt