{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_amcqeq7cioxu2qej7xw7jbbgyyvbb3jp245zp3o73scq7c4ykgwq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01CbWpJPVpDfvvYY97ZVeSsA","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-WmMOBZ/translation/tests/phase_b_configs.rs","content":"//! Phase B — valid-path differential tests, one test per `CONFIGS.md` row.\n//!\n//! Every test loads BOTH the C `.so` and the Rust `.so` through `libloading`\n//! and compares the `int` return value plus all 40 bytes of `struct ima_info`.\n\nmod common;\nuse common::*;\n\n/// Realistic sample rates, stored big-endian in the file the way a real CAF\n/// writer would (the C then mis-reads them natively — that is the point).\nconst RATES: [f64; 8] = [\n    8000.0, 11025.0, 22050.0, 32000.0, 44100.0, 48000.0, 96000.0, 192000.0,\n];\n\n// ---------------------------------------------------------------------------\n// Row 1 — minimal valid document, all unread fields randomized.\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row01_minimal_valid() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0x1111_1111);\n    for i in 0..500 {\n        let rate = RATES[i % RATES.len()];\n        let buf = valid_doc(\n            &mut rng,\n            u64::from_be_bytes(rate.to_be_bytes()),\n            rng.next_u32(),\n            rng.next_u64(),\n            rng.next_u64() as i64,\n            rng.below(4),\n        );\n        l.assert_same(&format!(\"row01 i={i}\"), &buf);\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 2 — reordered: pakt before desc.\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row02_pakt_before_desc() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0x2222_2222);\n    for i in 0..500 {\n        let mut d = Doc::new(&mut rng);\n        let fc = rng.next_u64();\n        let sr = rng.next_u64();\n        let ch = rng.next_u32();\n        d.pakt(&mut rng, fc);\n        d.desc(&mut rng, sr, FOURCC_IMA4, ch);\n        d.data(&mut rng, rng.next_u64() as i64, rng.below(3));\n        l.assert_same(&format!(\"row02 i={i}\"), &d.bytes);\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 3 — unknown chunks interleaved (0, 1, 2, 8 of them, random FourCCs).\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row03_unknown_chunks() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0x3333_3333);\n    for &n in &[0usize, 1, 2, 3, 8] {\n        for i in 0..200 {\n            let mut d = Doc::new(&mut rng);\n            for _ in 0..n {\n                let body = rng.below(48);\n                d.unknown(&mut rng, body, body as i64);\n            }\n            d.desc(&mut rng, rng.next_u64(), FOURCC_IMA4, rng.next_u32());\n            for _ in 0..n {\n                let body = rng.below(40);\n                d.unknown(&mut rng, body, body as i64);\n            }\n            d.pakt(&mut rng, rng.next_u64());\n            for _ in 0..n {\n                let body = rng.below(24);\n                d.unknown(&mut rng, body, body as i64);\n            }\n            d.data(&mut rng, rng.next_u64() as i64, rng.below(3));\n            l.assert_same(&format!(\"row03 n={n} i={i}\"), &d.bytes);\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 4 — duplicate `desc` chunks: the later one must win.\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row04_duplicate_desc() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0x4444_4444);\n    for i in 0..400 {\n        let mut d = Doc::new(&mut rng);\n        // First desc has a deliberately WRONG format id and different channels;\n        // if the C kept the first one the result would be -3.\n        d.desc(&mut rng, rng.next_u64(), rng.next_u32(), rng.next_u32());\n        d.pakt(&mut rng, rng.next_u64());\n        d.desc(&mut rng, rng.next_u64(), FOURCC_IMA4, rng.next_u32());\n        d.data(&mut rng, rng.next_u64() as i64, rng.below(3));\n        l.assert_same(&format!(\"row04 i={i}\"), &d.bytes);\n\n        // ...and the mirror case: valid first, garbage second -> must be -3.\n        let mut d2 = Doc::new(&mut rng);\n        d2.desc(&mut rng, rng.next_u64(), FOURCC_IMA4, rng.next_u32());\n        d2.desc(&mut rng, rng.next_u64(), rng.next_u32(), rng.next_u32());\n        d2.pakt(&mut rng, rng.next_u64());\n        d2.data(&mut rng, rng.next_u64() as i64, 1);\n        l.assert_same(&format!(\"row04b i={i}\"), &d2.bytes);\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 5 — duplicate `pakt` chunks: the later one must win.\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row05_duplicate_pakt() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0x5555_5555);\n    for i in 0..400 {\n        let mut d = Doc::new(&mut rng);\n        d.pakt(&mut rng, rng.next_u64());\n        d.desc(&mut rng, rng.next_u64(), FOURCC_IMA4, rng.next_u32());\n        d.pakt(&mut rng, rng.next_u64());\n        d.pakt(&mut rng, rng.next_u64());\n        d.data(&mut rng, rng.next_u64() as i64, rng.below(3));\n        l.assert_same(&format!(\"row05 i={i}\"), &d.bytes);\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 6 — unknown chunk with size 0: cursor advances by exactly 16 bytes.\n//          (This is what proves the chunk stride is sizeof(caf_chunk)==16.)\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row06_zero_size_unknown_chunk() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0x6666_6666);\n    for i in 0..300 {\n        let mut d = Doc::new(&mut rng);\n        d.unknown(&mut rng, 0, 0);\n        d.unknown(&mut rng, 0, 0);\n        d.desc(&mut rng, rng.next_u64(), FOURCC_IMA4, rng.next_u32());\n        d.unknown(&mut rng, 0, 0);\n        d.pakt(&mut rng, rng.next_u64());\n        d.unknown(&mut rng, 0, 0);\n        d.data(&mut rng, rng.next_u64() as i64, rng.below(3));\n        l.assert_same(&format!(\"row06 i={i}\"), &d.bytes);\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 7 — unknown chunk with a large positive size (skips a big region).\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row07_large_positive_skip() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0x7777_7777);\n    for &skip in &[64usize, 256, 1024, 4096, 65536] {\n        for i in 0..40 {\n            let mut d = Doc::new(&mut rng);\n            d.desc(&mut rng, rng.next_u64(), FOURCC_IMA4, rng.next_u32());\n            d.pakt(&mut rng, rng.next_u64());\n            d.unknown(&mut rng, skip, skip as i64);\n            d.data(&mut rng, rng.next_u64() as i64, rng.below(3));\n            l.assert_same(&format!(\"row07 skip={skip} i={i}\"), &d.bytes);\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 8 — NEGATIVE chunk size: cursor walks backwards and finds `data`\n//          in a region an earlier forward-skip jumped over.\n//\n//  off   8 : desc  (size 32)            -> next  56\n//  off  56 : pakt  (size 24)            -> next  96\n//  off  96 : JUMP_FWD (size 32)         -> next 144\n//  off 112 : 16 bytes filler (skipped)\n//  off 128 : data chunk header          <- reached by the back-jump\n//  off 144 : JUMP_BACK (size -32)       -> next 128  == data  => break\n// ---------------------------------------------------------------------------\nfn build_negative_skip_doc(rng: &mut Rng, data_size: i64) -> (Vec<u8>, usize) {\n    let mut d = Doc::new(rng);\n    assert_eq!(d.len(), 8);\n    d.desc(rng, rng.next_u64(), FOURCC_IMA4, rng.next_u32());\n    assert_eq!(d.len(), 56);\n    d.pakt(rng, rng.next_u64());\n    assert_eq!(d.len(), 96);\n    d.chunk_hdr(rng, 0x4a_4d_50_31, 32); // JUMP_FWD, size 32 -> 96+16+32 = 144\n    assert_eq!(d.len(), 112);\n    d.pad(rng, 16); // 112..128 filler\n    let data_off = d.len();\n    assert_eq!(data_off, 128);\n    d.chunk_hdr(rng, FOURCC_DATA, data_size); // 128..144\n    assert_eq!(d.len(), 144);\n    d.chunk_hdr(rng, 0x4a_4d_50_32, -32); // JUMP_BACK -> 144+16-32 = 128\n    assert_eq!(d.len(), 160);\n    d.pad(rng, 4 + 34 * 2); // edit_count + blocks living past 160\n    (d.bytes, data_off)\n}\n\n#[test]\nfn cfg_row08_negative_chunk_size() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0x8888_8888);\n    for i in 0..400 {\n        let ds = rng.next_u64() as i64;\n        let (buf, _) = build_negative_skip_doc(&mut rng, ds);\n        l.assert_same(&format!(\"row08 i={i} data_size={ds:#x}\"), &buf);\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 9 — `data` chunk size drives `info->size` (incl. negative / extremes).\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row09_data_chunk_size_values() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0x9999_9999);\n    let mut sizes: Vec<i64> = vec![\n        0,\n        1,\n        16,\n        34,\n        4096,\n        i64::MAX,\n        i64::MIN,\n        -1,\n        -16,\n        -4096,\n        0x7fff_ffff,\n        -0x8000_0000,\n        0xffff_ffffu32 as i64,\n    ];\n    for _ in 0..200 {\n        sizes.push(rng.next_u64() as i64);\n    }\n    for (i, &s) in sizes.iter().enumerate() {\n        let buf = valid_doc(&mut rng, rng.next_u64(), rng.next_u32(), rng.next_u64(), s, 2);\n        l.assert_same(&format!(\"row09 i={i} size={s}\"), &buf);\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 10 — realistic sample rates stored big-endian (the ordinary case).\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row10_realistic_sample_rates_be() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0xAAAA_AAAA);\n    for (i, &r) in RATES.iter().enumerate() {\n        for j in 0..40 {\n            let raw = u64::from_be_bytes(r.to_be_bytes());\n            let buf = valid_doc(\n                &mut rng,\n                raw,\n                rng.next_u32(),\n                rng.next_u64(),\n                rng.next_u64() as i64,\n                1,\n            );\n            l.assert_same(&format!(\"row10 rate={r} i={i} j={j}\"), &buf);\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Rows 11-14 — the `double -> unsigned long long` conversion sub-ranges.\n//\n// `sample_rate_raw` is written in *native* order, so the value below is exactly\n// the `double` the C loads with `movsd`.\n// ---------------------------------------------------------------------------\nfn run_sample_rate_values(name: &str, seed: u64, values: &[f64]) {\n    let l = Libs::load();\n    let mut rng = Rng::new(seed);\n    for (i, &v) in values.iter().enumerate() {\n        let raw = v.to_bits();\n        let buf = valid_doc(\n            &mut rng,\n            raw,\n            rng.next_u32(),\n            rng.next_u64(),\n            rng.next_u64() as i64,\n            1,\n        );\n        l.assert_same(&format!(\"{name} i={i} v={v:e} bits={raw:#018x}\"), &buf);\n    }\n}\n\n#[test]\nfn cfg_row11_sample_rate_in_range_truncation() {\n    let mut rng = Rng::new(0xB0B0_B0B0);\n    let mut v = vec![\n        1.0,\n        1.5,\n        1.9999999999,\n        2.0,\n        3.0,\n        255.5,\n        44100.25,\n        1e6,\n        1e15,\n        (1u64 << 52) as f64,\n        (1u64 << 52) as f64 + 0.5,\n        (1u64 << 62) as f64,\n        9223372036854774784.0, // largest double < 2^63\n    ];\n    for _ in 0..300 {\n        // uniform-ish in [1, 2^63)\n        let x = (rng.next_u64() >> 1) as f64;\n        v.push(x.max(1.0));\n    }\n    run_sample_rate_values(\"row11\", 0xB1B1_B1B1, &v);\n}\n\n#[test]\nfn cfg_row12_sample_rate_ge_two_pow_63() {\n    let mut rng = Rng::new(0xC0C0_C0C0);\n    let two63 = 9223372036854775808.0f64;\n    let mut v = vec![\n        two63,\n        two63 + 4096.0,\n        two63 * 1.5,\n        two63 * 1.99999,\n        two63 * 2.0 - 2048.0,       // just under 2^64\n        18446744073709549568.0,     // largest double < 2^64\n        two63 * 2.0,                // exactly 2^64 -> out of range after subsd\n        two63 * 4.0,\n        1e30,\n        f64::MAX,\n    ];\n    for _ in 0..300 {\n        let m = 1.0 + (rng.next_u64() >> 11) as f64 / (1u64 << 53) as f64;\n        v.push(two63 * m);\n    }\n    run_sample_rate_values(\"row12\", 0xC1C1_C1C1, &v);\n}\n\n#[test]\nfn cfg_row13_sample_rate_negative() {\n    let mut rng = Rng::new(0xD0D0_D0D0);\n    let two63 = 9223372036854775808.0f64;\n    let mut v = vec![\n        -0.0,\n        -1e-300,\n        -0.5,\n        -0.9999999,\n        -1.0,\n        -1.5,\n        -2.0,\n        -44100.0,\n        -1e18,\n        -9223372036854774784.0, // > -2^63\n        -two63,                 // exactly -2^63 (representable)\n        -two63 - 4096.0,        // below -2^63\n        -1e30,\n        f64::MIN,\n    ];\n    for _ in 0..300 {\n        let x = -((rng.next_u64() >> 1) as f64);\n        v.push(x);\n    }\n    run_sample_rate_values(\"row13\", 0xD1D1_D1D1, &v);\n}\n\n#[test]\nfn cfg_row14_sample_rate_specials() {\n    let v = vec![\n        0.0,\n        -0.0,\n        f64::INFINITY,\n        f64::NEG_INFINITY,\n        f64::NAN,\n        -f64::NAN,\n        f64::from_bits(0x7ff0_0000_0000_0001), // signalling NaN\n        f64::from_bits(0xfff0_0000_0000_0001),\n        f64::from_bits(0x7ff8_0000_dead_beef), // quiet NaN with payload\n        f64::MIN_POSITIVE,\n        f64::from_bits(1),        // smallest subnormal\n        f64::from_bits(0x000f_ffff_ffff_ffff), // largest subnormal\n        f64::EPSILON,\n        0.5,\n        0.9999999999999999,\n        f64::MAX,\n        f64::MIN,\n    ];\n    run_sample_rate_values(\"row14\", 0xE1E1_E1E1, &v);\n}\n\n// ---------------------------------------------------------------------------\n// Row 15 — fully random 64-bit sample-rate patterns.\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row15_sample_rate_random_bits() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0xF00D_F00D);\n    for i in 0..10_000 {\n        let raw = rng.next_u64();\n        let buf = valid_doc(\n            &mut rng,\n            raw,\n            rng.next_u32(),\n            rng.next_u64(),\n            rng.next_u64() as i64,\n            0,\n        );\n        l.assert_same(&format!(\"row15 i={i} bits={raw:#018x}\"), &buf);\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 16 — channels_per_frame values.\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row16_channel_counts() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0x1616_1616);\n    let mut chans: Vec<u32> = vec![0, 1, 2, 3, 6, 8, 0x7fff_ffff, 0x8000_0000, 0xffff_ffff, 0xffff];\n    for _ in 0..300 {\n        chans.push(rng.next_u32());\n    }\n    for (i, &c) in chans.iter().enumerate() {\n        let buf = valid_doc(&mut rng, rng.next_u64(), c, rng.next_u64(), 34, 1);\n        l.assert_same(&format!(\"row16 i={i} ch={c}\"), &buf);\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 17 — frame_count values.\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row17_frame_counts() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0x1717_1717);\n    let mut fcs: Vec<u64> = vec![\n        0,\n        1,\n        i64::MAX as u64,\n        u64::MAX,\n        i64::MIN as u64,\n        0x8000_0000_0000_0000,\n        0x0000_0000_ffff_ffff,\n        0xffff_ffff_0000_0000,\n    ];\n    for _ in 0..300 {\n        fcs.push(rng.next_u64());\n    }\n    for (i, &f) in fcs.iter().enumerate() {\n        let buf = valid_doc(&mut rng, rng.next_u64(), rng.next_u32(), f, 34, 1);\n        l.assert_same(&format!(\"row17 i={i} fc={f:#x}\"), &buf);\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 18 — `blocks` output pointer identity: must be data_chunk_offset + 20.\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row18_blocks_pointer_identity() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0x1818_1818);\n    for i in 0..200 {\n        let n_unknown = rng.below(5);\n        let mut d = Doc::new(&mut rng);\n        d.desc(&mut rng, rng.next_u64(), FOURCC_IMA4, rng.next_u32());\n        d.pakt(&mut rng, rng.next_u64());\n        for _ in 0..n_unknown {\n            let body = rng.below(33);\n            d.unknown(&mut rng, body, body as i64);\n        }\n        let data_off = d.data(&mut rng, 34, 2);\n        let buf = d.bytes;\n\n        let ((crc, cb), (rrc, rb)) = l.call_both(&buf, 0x5A);\n        assert_eq!(crc, 0, \"row18 i={i}: C should accept\");\n        assert_eq!(rrc, 0, \"row18 i={i}: Rust should accept\");\n        assert_eq!(cb, rb, \"row18 i={i}: info mismatch\");\n        let expect = buf.as_ptr() as usize + data_off + CHUNK_HDR + 4;\n        let got = u64::from_le_bytes(cb[0..8].try_into().unwrap()) as usize;\n        assert_eq!(\n            got, expect,\n            \"row18 i={i}: blocks pointer should be data_chunk+20\"\n        );\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 19 — misaligned `data` buffers (offsets 0..7 from a 16-aligned base).\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row19_misaligned_buffers() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0x1919_1919);\n    for off in 0..8usize {\n        for i in 0..100 {\n            let doc = valid_doc(\n                &mut rng,\n                rng.next_u64(),\n                rng.next_u32(),\n                rng.next_u64(),\n                rng.next_u64() as i64,\n                2,\n            );\n            let m = Misaligned::new(&doc, off);\n            assert_eq!(m.addr_mod8(), off % 8, \"misalignment setup failed\");\n            l.assert_same(&format!(\"row19 off={off} i={i}\"), m.as_slice());\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 20 — block payload region contents are irrelevant; 0 / 1 / many blocks.\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row20_block_payload_ignored() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0x2020_2020);\n    for &n in &[0usize, 1, 2, 7, 64] {\n        for i in 0..60 {\n            let buf = valid_doc(\n                &mut rng,\n                rng.next_u64(),\n                rng.next_u32(),\n                rng.next_u64(),\n                (n * 34) as i64,\n                n,\n            );\n            l.assert_same(&format!(\"row20 n={n} i={i}\"), &buf);\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 21 — structural fuzz: random valid documents, all axes at once.\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row21_structural_fuzz() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0x2121_2121);\n    for i in 0..5_000 {\n        let mut d = Doc::new(&mut rng);\n        // Random ordering of desc/pakt with random unknown chunks sprinkled in.\n        let desc_first = rng.next_u64() & 1 == 0;\n        let sprinkle = |d: &mut Doc, rng: &mut Rng| {\n            for _ in 0..rng.below(4) {\n                let body = rng.below(40);\n                d.unknown(rng, body, body as i64);\n            }\n        };\n        sprinkle(&mut d, &mut rng);\n        if desc_first {\n            d.desc(&mut rng, rng.next_u64(), FOURCC_IMA4, rng.next_u32());\n            sprinkle(&mut d, &mut rng);\n            d.pakt(&mut rng, rng.next_u64());\n        } else {\n            d.pakt(&mut rng, rng.next_u64());\n            sprinkle(&mut d, &mut rng);\n            d.desc(&mut rng, rng.next_u64(), FOURCC_IMA4, rng.next_u32());\n        }\n        sprinkle(&mut d, &mut rng);\n        d.data(&mut rng, rng.next_u64() as i64, rng.below(4));\n        l.assert_same(&format!(\"row21 i={i}\"), &d.bytes);\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 22 — `data` chunk physically BEFORE `desc`, reached by a back-jump so\n//          that `desc`/`pakt` are still populated first.\n//\n//  off   8 : JUMP_FWD (size 48)  -> next 72\n//  off  24 : data chunk header (skipped over on the way out)\n//  off  72 : desc (size 32)      -> next 120\n//  off 120 : pakt (size 24)      -> next 160\n//  off 160 : JUMP_BACK (size -152) -> next 24 == data => break\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row22_data_before_desc_via_backjump() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0x2222_0022);\n    for i in 0..300 {\n        let ds = rng.next_u64() as i64;\n        let mut d = Doc::new(&mut rng);\n        d.chunk_hdr(&mut rng, 0x4a_4d_50_41, 48); // 8..24, -> 8+16+48 = 72\n        assert_eq!(d.len(), 24);\n        let data_off = d.len();\n        d.chunk_hdr(&mut rng, FOURCC_DATA, ds); // 24..40\n        d.pad(&mut rng, 32); // 40..72 (part of the skipped 48 bytes)\n        assert_eq!(d.len(), 72);\n        d.desc(&mut rng, rng.next_u64(), FOURCC_IMA4, rng.next_u32()); // 72..120\n        assert_eq!(d.len(), 120);\n        d.pakt(&mut rng, rng.next_u64()); // 120..160\n        assert_eq!(d.len(), 160);\n        d.chunk_hdr(&mut rng, 0x4a_4d_50_42, -152); // 160..176, -> 160+16-152 = 24\n        assert_eq!(d.len(), 176);\n\n        let buf = d.bytes;\n        let ((crc, cb), (rrc, rb)) = l.call_both(&buf, 0x3C);\n        assert_eq!(crc, rrc, \"row22 i={i}: rc mismatch {crc} vs {rrc}\");\n        assert_eq!(cb, rb, \"row22 i={i}: info mismatch\");\n        assert_eq!(crc, 0, \"row22 i={i}: expected success\");\n        let expect = buf.as_ptr() as usize + data_off + CHUNK_HDR + 4;\n        let got = u64::from_le_bytes(cb[0..8].try_into().unwrap()) as usize;\n        assert_eq!(got, expect, \"row22 i={i}: blocks pointer\");\n        assert_eq!(\n            u64::from_le_bytes(cb[8..16].try_into().unwrap()),\n            ds as u64,\n            \"row22 i={i}: info->size\"\n        );\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 23 — on the error paths `*info` must be left exactly as the caller had it.\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row23_info_untouched_on_error() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0x2323_2323);\n    for i in 0..300 {\n        // bad magic\n        let mut d = Doc::with_header(&mut rng, rng.next_u32() | 0x8000_0000, 1);\n        d.pad(&mut rng, 64);\n        for poison in [0x00u8, 0xFF, 0xA5, 0x5A] {\n            let ((crc, cb), (rrc, rb)) = l.call_both(&d.bytes, poison);\n            assert_eq!((crc, cb), (rrc, rb), \"row23 magic i={i} poison={poison:#x}\");\n            assert_eq!(crc, -1);\n            assert_eq!(cb, ImaInfo::poisoned(poison).raw(), \"info was modified\");\n        }\n        // bad version\n        let mut d = Doc::with_header(&mut rng, FOURCC_CAFF, rng.next_u16() | 2);\n        d.pad(&mut rng, 64);\n        for poison in [0x00u8, 0xFF, 0xA5] {\n            let ((crc, cb), (rrc, rb)) = l.call_both(&d.bytes, poison);\n            assert_eq!((crc, cb), (rrc, rb), \"row23 version i={i}\");\n            assert_eq!(crc, -2);\n            assert_eq!(cb, ImaInfo::poisoned(poison).raw(), \"info was modified\");\n        }\n        // bad format id\n        let mut bad = rng.next_u32();\n        if bad == FOURCC_IMA4 {\n            bad ^= 1;\n        }\n        let mut d = Doc::new(&mut rng);\n        d.desc(&mut rng, rng.next_u64(), bad, rng.next_u32());\n        d.pakt(&mut rng, rng.next_u64());\n        d.data(&mut rng, 34, 1);\n        for poison in [0x00u8, 0xFF, 0xA5] {\n            let ((crc, cb), (rrc, rb)) = l.call_both(&d.bytes, poison);\n            assert_eq!((crc, cb), (rrc, rb), \"row23 fmt i={i}\");\n            assert_eq!(crc, -3);\n            assert_eq!(cb, ImaInfo::poisoned(poison).raw(), \"info was modified\");\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 24 — statelessness: alternating valid/invalid calls reusing one `info`.\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row24_repeated_calls_stateless() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0x2424_2424);\n    let mut ci = ImaInfo::poisoned(0x11);\n    let mut ri = ImaInfo::poisoned(0x11);\n    for i in 0..300 {\n        let buf: Vec<u8> = match i % 4 {\n            0 => valid_doc(&mut rng, rng.next_u64(), rng.next_u32(), rng.next_u64(), 34, 1),\n            1 => {\n                let mut d = Doc::with_header(&mut rng, rng.next_u32() | 1, 1);\n                d.pad(&mut rng, 32);\n                d.bytes\n            }\n            2 => {\n                let mut d = Doc::with_header(&mut rng, FOURCC_CAFF, 0);\n                d.pad(&mut rng, 32);\n                d.bytes\n            }\n            _ => {\n                let mut d = Doc::new(&mut rng);\n                d.desc(&mut rng, rng.next_u64(), 0, rng.next_u32());\n                d.pakt(&mut rng, rng.next_u64());\n                d.data(&mut rng, 34, 1);\n                d.bytes\n            }\n        };\n        let p = buf.as_ptr() as *const std::ffi::c_void;\n        let crc = unsafe { (l.c_parse)(&mut ci, p) };\n        let rrc = unsafe { (l.r_parse)(&mut ri, p) };\n        assert_eq!(crc, rrc, \"row24 i={i}: rc mismatch\");\n        assert_eq!(ci.raw(), ri.raw(), \"row24 i={i}: info mismatch\");\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1323,"cache_read_input_tokens":51912,"cache_creation":{"ephemeral_5m_input_tokens":1323,"ephemeral_1h_input_tokens":0},"output_tokens":7,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"19405ed4-554f-490b-a6e2-07840dfb1465","uuid":"af0e18d0-7681-40ae-897c-60f73756eefb","timestamp":"2026-09-05T01:01:30.006Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01CbWpJPVpDfvvYY97ZVeSsA","type":"tool_result","content":"File created successfully at: /local/home/scheschb/.harvest/work/harvest-work-WmMOBZ/translation/tests/phase_b_configs.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"19405ed4-554f-490b-a6e2-07840dfb1465","uuid":"1674c3da-f36a-44fd-9071-2215962e3972","timestamp":"2026-09-05T01:01:30.029Z","tool_use_result":{"type":"create","filePath":"/local/home/scheschb/.harvest/work/harvest-work-WmMOBZ/translation/tests/phase_b_configs.rs","content":"//! Phase B — valid-path differential tests, one test per `CONFIGS.md` row.\n//!\n//! Every test loads BOTH the C `.so` and the Rust `.so` through `libloading`\n//! and compares the `int` return value plus all 40 bytes of `struct ima_info`.\n\nmod common;\nuse common::*;\n\n/// Realistic sample rates, stored big-endian in the file the way a real CAF\n/// writer would (the C then mis-reads them natively — that is the point).\nconst RATES: [f64; 8] = [\n    8000.0, 11025.0, 22050.0, 32000.0, 44100.0, 48000.0, 96000.0, 192000.0,\n];\n\n// ---------------------------------------------------------------------------\n// Row 1 — minimal valid document, all unread fields randomized.\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row01_minimal_valid() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0x1111_1111);\n    for i in 0..500 {\n        let rate = RATES[i % RATES.len()];\n        let buf = valid_doc(\n            &mut rng,\n            u64::from_be_bytes(rate.to_be_bytes()),\n            rng.next_u32(),\n            rng.next_u64(),\n            rng.next_u64() as i64,\n            rng.below(4),\n        );\n        l.assert_same(&format!(\"row01 i={i}\"), &buf);\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 2 — reordered: pakt before desc.\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row02_pakt_before_desc() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0x2222_2222);\n    for i in 0..500 {\n        let mut d = Doc::new(&mut rng);\n        let fc = rng.next_u64();\n        let sr = rng.next_u64();\n        let ch = rng.next_u32();\n        d.pakt(&mut rng, fc);\n        d.desc(&mut rng, sr, FOURCC_IMA4, ch);\n        d.data(&mut rng, rng.next_u64() as i64, rng.below(3));\n        l.assert_same(&format!(\"row02 i={i}\"), &d.bytes);\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 3 — unknown chunks interleaved (0, 1, 2, 8 of them, random FourCCs).\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row03_unknown_chunks() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0x3333_3333);\n    for &n in &[0usize, 1, 2, 3, 8] {\n        for i in 0..200 {\n            let mut d = Doc::new(&mut rng);\n            for _ in 0..n {\n                let body = rng.below(48);\n                d.unknown(&mut rng, body, body as i64);\n            }\n            d.desc(&mut rng, rng.next_u64(), FOURCC_IMA4, rng.next_u32());\n            for _ in 0..n {\n                let body = rng.below(40);\n                d.unknown(&mut rng, body, body as i64);\n            }\n            d.pakt(&mut rng, rng.next_u64());\n            for _ in 0..n {\n                let body = rng.below(24);\n                d.unknown(&mut rng, body, body as i64);\n            }\n            d.data(&mut rng, rng.next_u64() as i64, rng.below(3));\n            l.assert_same(&format!(\"row03 n={n} i={i}\"), &d.bytes);\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 4 — duplicate `desc` chunks: the later one must win.\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row04_duplicate_desc() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0x4444_4444);\n    for i in 0..400 {\n        let mut d = Doc::new(&mut rng);\n        // First desc has a deliberately WRONG format id and different channels;\n        // if the C kept the first one the result would be -3.\n        d.desc(&mut rng, rng.next_u64(), rng.next_u32(), rng.next_u32());\n        d.pakt(&mut rng, rng.next_u64());\n        d.desc(&mut rng, rng.next_u64(), FOURCC_IMA4, rng.next_u32());\n        d.data(&mut rng, rng.next_u64() as i64, rng.below(3));\n        l.assert_same(&format!(\"row04 i={i}\"), &d.bytes);\n\n        // ...and the mirror case: valid first, garbage second -> must be -3.\n        let mut d2 = Doc::new(&mut rng);\n        d2.desc(&mut rng, rng.next_u64(), FOURCC_IMA4, rng.next_u32());\n        d2.desc(&mut rng, rng.next_u64(), rng.next_u32(), rng.next_u32());\n        d2.pakt(&mut rng, rng.next_u64());\n        d2.data(&mut rng, rng.next_u64() as i64, 1);\n        l.assert_same(&format!(\"row04b i={i}\"), &d2.bytes);\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 5 — duplicate `pakt` chunks: the later one must win.\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row05_duplicate_pakt() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0x5555_5555);\n    for i in 0..400 {\n        let mut d = Doc::new(&mut rng);\n        d.pakt(&mut rng, rng.next_u64());\n        d.desc(&mut rng, rng.next_u64(), FOURCC_IMA4, rng.next_u32());\n        d.pakt(&mut rng, rng.next_u64());\n        d.pakt(&mut rng, rng.next_u64());\n        d.data(&mut rng, rng.next_u64() as i64, rng.below(3));\n        l.assert_same(&format!(\"row05 i={i}\"), &d.bytes);\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 6 — unknown chunk with size 0: cursor advances by exactly 16 bytes.\n//          (This is what proves the chunk stride is sizeof(caf_chunk)==16.)\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row06_zero_size_unknown_chunk() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0x6666_6666);\n    for i in 0..300 {\n        let mut d = Doc::new(&mut rng);\n        d.unknown(&mut rng, 0, 0);\n        d.unknown(&mut rng, 0, 0);\n        d.desc(&mut rng, rng.next_u64(), FOURCC_IMA4, rng.next_u32());\n        d.unknown(&mut rng, 0, 0);\n        d.pakt(&mut rng, rng.next_u64());\n        d.unknown(&mut rng, 0, 0);\n        d.data(&mut rng, rng.next_u64() as i64, rng.below(3));\n        l.assert_same(&format!(\"row06 i={i}\"), &d.bytes);\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 7 — unknown chunk with a large positive size (skips a big region).\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row07_large_positive_skip() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0x7777_7777);\n    for &skip in &[64usize, 256, 1024, 4096, 65536] {\n        for i in 0..40 {\n            let mut d = Doc::new(&mut rng);\n            d.desc(&mut rng, rng.next_u64(), FOURCC_IMA4, rng.next_u32());\n            d.pakt(&mut rng, rng.next_u64());\n            d.unknown(&mut rng, skip, skip as i64);\n            d.data(&mut rng, rng.next_u64() as i64, rng.below(3));\n            l.assert_same(&format!(\"row07 skip={skip} i={i}\"), &d.bytes);\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 8 — NEGATIVE chunk size: cursor walks backwards and finds `data`\n//          in a region an earlier forward-skip jumped over.\n//\n//  off   8 : desc  (size 32)            -> next  56\n//  off  56 : pakt  (size 24)            -> next  96\n//  off  96 : JUMP_FWD (size 32)         -> next 144\n//  off 112 : 16 bytes filler (skipped)\n//  off 128 : data chunk header          <- reached by the back-jump\n//  off 144 : JUMP_BACK (size -32)       -> next 128  == data  => break\n// ---------------------------------------------------------------------------\nfn build_negative_skip_doc(rng: &mut Rng, data_size: i64) -> (Vec<u8>, usize) {\n    let mut d = Doc::new(rng);\n    assert_eq!(d.len(), 8);\n    d.desc(rng, rng.next_u64(), FOURCC_IMA4, rng.next_u32());\n    assert_eq!(d.len(), 56);\n    d.pakt(rng, rng.next_u64());\n    assert_eq!(d.len(), 96);\n    d.chunk_hdr(rng, 0x4a_4d_50_31, 32); // JUMP_FWD, size 32 -> 96+16+32 = 144\n    assert_eq!(d.len(), 112);\n    d.pad(rng, 16); // 112..128 filler\n    let data_off = d.len();\n    assert_eq!(data_off, 128);\n    d.chunk_hdr(rng, FOURCC_DATA, data_size); // 128..144\n    assert_eq!(d.len(), 144);\n    d.chunk_hdr(rng, 0x4a_4d_50_32, -32); // JUMP_BACK -> 144+16-32 = 128\n    assert_eq!(d.len(), 160);\n    d.pad(rng, 4 + 34 * 2); // edit_count + blocks living past 160\n    (d.bytes, data_off)\n}\n\n#[test]\nfn cfg_row08_negative_chunk_size() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0x8888_8888);\n    for i in 0..400 {\n        let ds = rng.next_u64() as i64;\n        let (buf, _) = build_negative_skip_doc(&mut rng, ds);\n        l.assert_same(&format!(\"row08 i={i} data_size={ds:#x}\"), &buf);\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 9 — `data` chunk size drives `info->size` (incl. negative / extremes).\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row09_data_chunk_size_values() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0x9999_9999);\n    let mut sizes: Vec<i64> = vec![\n        0,\n        1,\n        16,\n        34,\n        4096,\n        i64::MAX,\n        i64::MIN,\n        -1,\n        -16,\n        -4096,\n        0x7fff_ffff,\n        -0x8000_0000,\n        0xffff_ffffu32 as i64,\n    ];\n    for _ in 0..200 {\n        sizes.push(rng.next_u64() as i64);\n    }\n    for (i, &s) in sizes.iter().enumerate() {\n        let buf = valid_doc(&mut rng, rng.next_u64(), rng.next_u32(), rng.next_u64(), s, 2);\n        l.assert_same(&format!(\"row09 i={i} size={s}\"), &buf);\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 10 — realistic sample rates stored big-endian (the ordinary case).\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row10_realistic_sample_rates_be() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0xAAAA_AAAA);\n    for (i, &r) in RATES.iter().enumerate() {\n        for j in 0..40 {\n            let raw = u64::from_be_bytes(r.to_be_bytes());\n            let buf = valid_doc(\n                &mut rng,\n                raw,\n                rng.next_u32(),\n                rng.next_u64(),\n                rng.next_u64() as i64,\n                1,\n            );\n            l.assert_same(&format!(\"row10 rate={r} i={i} j={j}\"), &buf);\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Rows 11-14 — the `double -> unsigned long long` conversion sub-ranges.\n//\n// `sample_rate_raw` is written in *native* order, so the value below is exactly\n// the `double` the C loads with `movsd`.\n// ---------------------------------------------------------------------------\nfn run_sample_rate_values(name: &str, seed: u64, values: &[f64]) {\n    let l = Libs::load();\n    let mut rng = Rng::new(seed);\n    for (i, &v) in values.iter().enumerate() {\n        let raw = v.to_bits();\n        let buf = valid_doc(\n            &mut rng,\n            raw,\n            rng.next_u32(),\n            rng.next_u64(),\n            rng.next_u64() as i64,\n            1,\n        );\n        l.assert_same(&format!(\"{name} i={i} v={v:e} bits={raw:#018x}\"), &buf);\n    }\n}\n\n#[test]\nfn cfg_row11_sample_rate_in_range_truncation() {\n    let mut rng = Rng::new(0xB0B0_B0B0);\n    let mut v = vec![\n        1.0,\n        1.5,\n        1.9999999999,\n        2.0,\n        3.0,\n        255.5,\n        44100.25,\n        1e6,\n        1e15,\n        (1u64 << 52) as f64,\n        (1u64 << 52) as f64 + 0.5,\n        (1u64 << 62) as f64,\n        9223372036854774784.0, // largest double < 2^63\n    ];\n    for _ in 0..300 {\n        // uniform-ish in [1, 2^63)\n        let x = (rng.next_u64() >> 1) as f64;\n        v.push(x.max(1.0));\n    }\n    run_sample_rate_values(\"row11\", 0xB1B1_B1B1, &v);\n}\n\n#[test]\nfn cfg_row12_sample_rate_ge_two_pow_63() {\n    let mut rng = Rng::new(0xC0C0_C0C0);\n    let two63 = 9223372036854775808.0f64;\n    let mut v = vec![\n        two63,\n        two63 + 4096.0,\n        two63 * 1.5,\n        two63 * 1.99999,\n        two63 * 2.0 - 2048.0,       // just under 2^64\n        18446744073709549568.0,     // largest double < 2^64\n        two63 * 2.0,                // exactly 2^64 -> out of range after subsd\n        two63 * 4.0,\n        1e30,\n        f64::MAX,\n    ];\n    for _ in 0..300 {\n        let m = 1.0 + (rng.next_u64() >> 11) as f64 / (1u64 << 53) as f64;\n        v.push(two63 * m);\n    }\n    run_sample_rate_values(\"row12\", 0xC1C1_C1C1, &v);\n}\n\n#[test]\nfn cfg_row13_sample_rate_negative() {\n    let mut rng = Rng::new(0xD0D0_D0D0);\n    let two63 = 9223372036854775808.0f64;\n    let mut v = vec![\n        -0.0,\n        -1e-300,\n        -0.5,\n        -0.9999999,\n        -1.0,\n        -1.5,\n        -2.0,\n        -44100.0,\n        -1e18,\n        -9223372036854774784.0, // > -2^63\n        -two63,                 // exactly -2^63 (representable)\n        -two63 - 4096.0,        // below -2^63\n        -1e30,\n        f64::MIN,\n    ];\n    for _ in 0..300 {\n        let x = -((rng.next_u64() >> 1) as f64);\n        v.push(x);\n    }\n    run_sample_rate_values(\"row13\", 0xD1D1_D1D1, &v);\n}\n\n#[test]\nfn cfg_row14_sample_rate_specials() {\n    let v = vec![\n        0.0,\n        -0.0,\n        f64::INFINITY,\n        f64::NEG_INFINITY,\n        f64::NAN,\n        -f64::NAN,\n        f64::from_bits(0x7ff0_0000_0000_0001), // signalling NaN\n        f64::from_bits(0xfff0_0000_0000_0001),\n        f64::from_bits(0x7ff8_0000_dead_beef), // quiet NaN with payload\n        f64::MIN_POSITIVE,\n        f64::from_bits(1),        // smallest subnormal\n        f64::from_bits(0x000f_ffff_ffff_ffff), // largest subnormal\n        f64::EPSILON,\n        0.5,\n        0.9999999999999999,\n        f64::MAX,\n        f64::MIN,\n    ];\n    run_sample_rate_values(\"row14\", 0xE1E1_E1E1, &v);\n}\n\n// ---------------------------------------------------------------------------\n// Row 15 — fully random 64-bit sample-rate patterns.\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row15_sample_rate_random_bits() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0xF00D_F00D);\n    for i in 0..10_000 {\n        let raw = rng.next_u64();\n        let buf = valid_doc(\n            &mut rng,\n            raw,\n            rng.next_u32(),\n            rng.next_u64(),\n            rng.next_u64() as i64,\n            0,\n        );\n        l.assert_same(&format!(\"row15 i={i} bits={raw:#018x}\"), &buf);\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 16 — channels_per_frame values.\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row16_channel_counts() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0x1616_1616);\n    let mut chans: Vec<u32> = vec![0, 1, 2, 3, 6, 8, 0x7fff_ffff, 0x8000_0000, 0xffff_ffff, 0xffff];\n    for _ in 0..300 {\n        chans.push(rng.next_u32());\n    }\n    for (i, &c) in chans.iter().enumerate() {\n        let buf = valid_doc(&mut rng, rng.next_u64(), c, rng.next_u64(), 34, 1);\n        l.assert_same(&format!(\"row16 i={i} ch={c}\"), &buf);\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 17 — frame_count values.\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row17_frame_counts() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0x1717_1717);\n    let mut fcs: Vec<u64> = vec![\n        0,\n        1,\n        i64::MAX as u64,\n        u64::MAX,\n        i64::MIN as u64,\n        0x8000_0000_0000_0000,\n        0x0000_0000_ffff_ffff,\n        0xffff_ffff_0000_0000,\n    ];\n    for _ in 0..300 {\n        fcs.push(rng.next_u64());\n    }\n    for (i, &f) in fcs.iter().enumerate() {\n        let buf = valid_doc(&mut rng, rng.next_u64(), rng.next_u32(), f, 34, 1);\n        l.assert_same(&format!(\"row17 i={i} fc={f:#x}\"), &buf);\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 18 — `blocks` output pointer identity: must be data_chunk_offset + 20.\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row18_blocks_pointer_identity() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0x1818_1818);\n    for i in 0..200 {\n        let n_unknown = rng.below(5);\n        let mut d = Doc::new(&mut rng);\n        d.desc(&mut rng, rng.next_u64(), FOURCC_IMA4, rng.next_u32());\n        d.pakt(&mut rng, rng.next_u64());\n        for _ in 0..n_unknown {\n            let body = rng.below(33);\n            d.unknown(&mut rng, body, body as i64);\n        }\n        let data_off = d.data(&mut rng, 34, 2);\n        let buf = d.bytes;\n\n        let ((crc, cb), (rrc, rb)) = l.call_both(&buf, 0x5A);\n        assert_eq!(crc, 0, \"row18 i={i}: C should accept\");\n        assert_eq!(rrc, 0, \"row18 i={i}: Rust should accept\");\n        assert_eq!(cb, rb, \"row18 i={i}: info mismatch\");\n        let expect = buf.as_ptr() as usize + data_off + CHUNK_HDR + 4;\n        let got = u64::from_le_bytes(cb[0..8].try_into().unwrap()) as usize;\n        assert_eq!(\n            got, expect,\n            \"row18 i={i}: blocks pointer should be data_chunk+20\"\n        );\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 19 — misaligned `data` buffers (offsets 0..7 from a 16-aligned base).\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row19_misaligned_buffers() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0x1919_1919);\n    for off in 0..8usize {\n        for i in 0..100 {\n            let doc = valid_doc(\n                &mut rng,\n                rng.next_u64(),\n                rng.next_u32(),\n                rng.next_u64(),\n                rng.next_u64() as i64,\n                2,\n            );\n            let m = Misaligned::new(&doc, off);\n            assert_eq!(m.addr_mod8(), off % 8, \"misalignment setup failed\");\n            l.assert_same(&format!(\"row19 off={off} i={i}\"), m.as_slice());\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 20 — block payload region contents are irrelevant; 0 / 1 / many blocks.\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row20_block_payload_ignored() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0x2020_2020);\n    for &n in &[0usize, 1, 2, 7, 64] {\n        for i in 0..60 {\n            let buf = valid_doc(\n                &mut rng,\n                rng.next_u64(),\n                rng.next_u32(),\n                rng.next_u64(),\n                (n * 34) as i64,\n                n,\n            );\n            l.assert_same(&format!(\"row20 n={n} i={i}\"), &buf);\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 21 — structural fuzz: random valid documents, all axes at once.\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row21_structural_fuzz() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0x2121_2121);\n    for i in 0..5_000 {\n        let mut d = Doc::new(&mut rng);\n        // Random ordering of desc/pakt with random unknown chunks sprinkled in.\n        let desc_first = rng.next_u64() & 1 == 0;\n        let sprinkle = |d: &mut Doc, rng: &mut Rng| {\n            for _ in 0..rng.below(4) {\n                let body = rng.below(40);\n                d.unknown(rng, body, body as i64);\n            }\n        };\n        sprinkle(&mut d, &mut rng);\n        if desc_first {\n            d.desc(&mut rng, rng.next_u64(), FOURCC_IMA4, rng.next_u32());\n            sprinkle(&mut d, &mut rng);\n            d.pakt(&mut rng, rng.next_u64());\n        } else {\n            d.pakt(&mut rng, rng.next_u64());\n            sprinkle(&mut d, &mut rng);\n            d.desc(&mut rng, rng.next_u64(), FOURCC_IMA4, rng.next_u32());\n        }\n        sprinkle(&mut d, &mut rng);\n        d.data(&mut rng, rng.next_u64() as i64, rng.below(4));\n        l.assert_same(&format!(\"row21 i={i}\"), &d.bytes);\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 22 — `data` chunk physically BEFORE `desc`, reached by a back-jump so\n//          that `desc`/`pakt` are still populated first.\n//\n//  off   8 : JUMP_FWD (size 48)  -> next 72\n//  off  24 : data chunk header (skipped over on the way out)\n//  off  72 : desc (size 32)      -> next 120\n//  off 120 : pakt (size 24)      -> next 160\n//  off 160 : JUMP_BACK (size -152) -> next 24 == data => break\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row22_data_before_desc_via_backjump() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0x2222_0022);\n    for i in 0..300 {\n        let ds = rng.next_u64() as i64;\n        let mut d = Doc::new(&mut rng);\n        d.chunk_hdr(&mut rng, 0x4a_4d_50_41, 48); // 8..24, -> 8+16+48 = 72\n        assert_eq!(d.len(), 24);\n        let data_off = d.len();\n        d.chunk_hdr(&mut rng, FOURCC_DATA, ds); // 24..40\n        d.pad(&mut rng, 32); // 40..72 (part of the skipped 48 bytes)\n        assert_eq!(d.len(), 72);\n        d.desc(&mut rng, rng.next_u64(), FOURCC_IMA4, rng.next_u32()); // 72..120\n        assert_eq!(d.len(), 120);\n        d.pakt(&mut rng, rng.next_u64()); // 120..160\n        assert_eq!(d.len(), 160);\n        d.chunk_hdr(&mut rng, 0x4a_4d_50_42, -152); // 160..176, -> 160+16-152 = 24\n        assert_eq!(d.len(), 176);\n\n        let buf = d.bytes;\n        let ((crc, cb), (rrc, rb)) = l.call_both(&buf, 0x3C);\n        assert_eq!(crc, rrc, \"row22 i={i}: rc mismatch {crc} vs {rrc}\");\n        assert_eq!(cb, rb, \"row22 i={i}: info mismatch\");\n        assert_eq!(crc, 0, \"row22 i={i}: expected success\");\n        let expect = buf.as_ptr() as usize + data_off + CHUNK_HDR + 4;\n        let got = u64::from_le_bytes(cb[0..8].try_into().unwrap()) as usize;\n        assert_eq!(got, expect, \"row22 i={i}: blocks pointer\");\n        assert_eq!(\n            u64::from_le_bytes(cb[8..16].try_into().unwrap()),\n            ds as u64,\n            \"row22 i={i}: info->size\"\n        );\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 23 — on the error paths `*info` must be left exactly as the caller had it.\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row23_info_untouched_on_error() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0x2323_2323);\n    for i in 0..300 {\n        // bad magic\n        let mut d = Doc::with_header(&mut rng, rng.next_u32() | 0x8000_0000, 1);\n        d.pad(&mut rng, 64);\n        for poison in [0x00u8, 0xFF, 0xA5, 0x5A] {\n            let ((crc, cb), (rrc, rb)) = l.call_both(&d.bytes, poison);\n            assert_eq!((crc, cb), (rrc, rb), \"row23 magic i={i} poison={poison:#x}\");\n            assert_eq!(crc, -1);\n            assert_eq!(cb, ImaInfo::poisoned(poison).raw(), \"info was modified\");\n        }\n        // bad version\n        let mut d = Doc::with_header(&mut rng, FOURCC_CAFF, rng.next_u16() | 2);\n        d.pad(&mut rng, 64);\n        for poison in [0x00u8, 0xFF, 0xA5] {\n            let ((crc, cb), (rrc, rb)) = l.call_both(&d.bytes, poison);\n            assert_eq!((crc, cb), (rrc, rb), \"row23 version i={i}\");\n            assert_eq!(crc, -2);\n            assert_eq!(cb, ImaInfo::poisoned(poison).raw(), \"info was modified\");\n        }\n        // bad format id\n        let mut bad = rng.next_u32();\n        if bad == FOURCC_IMA4 {\n            bad ^= 1;\n        }\n        let mut d = Doc::new(&mut rng);\n        d.desc(&mut rng, rng.next_u64(), bad, rng.next_u32());\n        d.pakt(&mut rng, rng.next_u64());\n        d.data(&mut rng, 34, 1);\n        for poison in [0x00u8, 0xFF, 0xA5] {\n            let ((crc, cb), (rrc, rb)) = l.call_both(&d.bytes, poison);\n            assert_eq!((crc, cb), (rrc, rb), \"row23 fmt i={i}\");\n            assert_eq!(crc, -3);\n            assert_eq!(cb, ImaInfo::poisoned(poison).raw(), \"info was modified\");\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 24 — statelessness: alternating valid/invalid calls reusing one `info`.\n// ---------------------------------------------------------------------------\n#[test]\nfn cfg_row24_repeated_calls_stateless() {\n    let l = Libs::load();\n    let mut rng = Rng::new(0x2424_2424);\n    let mut ci = ImaInfo::poisoned(0x11);\n    let mut ri = ImaInfo::poisoned(0x11);\n    for i in 0..300 {\n        let buf: Vec<u8> = match i % 4 {\n            0 => valid_doc(&mut rng, rng.next_u64(), rng.next_u32(), rng.next_u64(), 34, 1),\n            1 => {\n                let mut d = Doc::with_header(&mut rng, rng.next_u32() | 1, 1);\n                d.pad(&mut rng, 32);\n                d.bytes\n            }\n            2 => {\n                let mut d = Doc::with_header(&mut rng, FOURCC_CAFF, 0);\n                d.pad(&mut rng, 32);\n                d.bytes\n            }\n            _ => {\n                let mut d = Doc::new(&mut rng);\n                d.desc(&mut rng, rng.next_u64(), 0, rng.next_u32());\n                d.pakt(&mut rng, rng.next_u64());\n                d.data(&mut rng, 34, 1);\n                d.bytes\n            }\n        };\n        let p = buf.as_ptr() as *const std::ffi::c_void;\n        let crc = unsafe { (l.c_parse)(&mut ci, p) };\n        let rrc = unsafe { (l.r_parse)(&mut ri, p) };\n        assert_eq!(crc, rrc, \"row24 i={i}: rc mismatch\");\n        assert_eq!(ci.raw(), ri.raw(), \"row24 i={i}: info mismatch\");\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
