_info).rowbytes);\n358\t\n359\t        if (*row_info).bit_depth == 1 {\n360\t            table = onebppswaptable.as_ptr();\n361\t        } else if (*row_info).bit_depth == 2 {\n362\t            table = twobppswaptable.as_ptr();\n363\t        } else if (*row_info).bit_depth == 4 {\n364\t            table = fourbppswaptable.as_ptr();\n365\t        } else {\n366\t            return;\n367\t        }\n368\t\n369\t        rp = row;\n370\t        while rp < row_end {\n371\t            *rp = *table.add(*rp as usize);\n372\t            rp = rp.add(1);\n373\t        }\n374\t    }\n375\t}\n376\t\n377\t/* Remove a channel - this used to be 'png_do_strip_filler' but it used a\n378\t * somewhat weird combination of flags to determine what to do.  All the calls\n379\t * to png_do_strip_filler are changed in 1.5.2 to call this instead with the\n380\t * correct arguments.\n381\t *\n382\t * The routine isn't general - the channel must be the channel at the start or\n383\t * end (not in the middle) of each pixel.\n384\t */\n385\t#[unsafe(no_mangle)]\n386\tpub unsafe extern \"C-unwind\" fn png_do_strip_channel(\n387\t    row_info: png_row_infop,\n388\t    row: png_bytep,\n389\t    at_start: c_int,\n390\t) {\n391\t    let mut sp: png_bytep = row; /* source pointer */\n392\t    let mut dp: png_bytep = row; /* destination pointer */\n393\t    let ep: png_bytep = row.add((*row_info).rowbytes); /* One beyond end of row */\n394\t\n395\t    /* At the start sp will point to the first byte to copy and dp to where\n396\t     * it is copied to.  ep always points just beyond the end of the row, so\n397\t     * the loop simply copies (channels-1) channels until sp reaches ep.\n398\t     *\n399\t     * at_start:        0 -- convert AG, XG, ARGB, XRGB, AAGG, XXGG, etc.\n400\t     *            nonzero -- convert GA, GX, RGBA, RGBX, GGAA, RRGGBBXX, etc.\n401\t     */\n402\t\n403\t    /* GA, GX, XG cases */\n404\t    if (*row_info).channels == 2 {\n405\t        if (*row_info).bit_depth == 8 {\n406\t            if at_start != 0\n407\t            /* Skip initial filler */\n408\t            {\n409\t                sp = sp.add(1);\n410\t            } else\n411\t            /* Skip initial channel and, for sp, the filler */\n412\t            {\n413\t                sp = sp.add(2);\n414\t                dp = dp.add(1);\n415\t            }\n416\t\n417\t            /* For a 1 pixel wide image there is nothing to do */\n418\t            while sp < ep {\n419\t                *dp = *sp;\n420\t                dp = dp.add(1);\n421\t                sp = sp.add(2);\n422\t            }\n423\t\n424\t            (*row_info).pixel_depth = 8;\n425\t        } else if (*row_info).bit_depth == 16 {\n426\t            if at_start != 0\n427\t            /* Skip initial filler */\n428\t            {\n429\t                sp = sp.add(2);\n430\t            } else\n431\t            /* Skip initial channel and, for sp, the filler */\n432\t            {\n433\t                sp = sp.add(4);\n434\t                dp = dp.add(2);\n435\t            }\n436\t\n437\t            while sp < ep {\n438\t                *dp = *sp;\n439\t                dp = dp.add(1);\n440\t                sp = sp.add(1);\n441\t                *dp = *sp;\n442\t                dp = dp.add(1);\n443\t                sp = sp.add(3);\n444\t            }\n445\t\n446\t            (*row_info).pixel_depth = 16;\n447\t        } else {\n448\t            return; /* bad bit depth */\n449\t        }\n450\t\n451\t        (*row_info).channels = 1;\n452\t\n453\t        /* Finally fix the color type if it records an alpha channel */\n454\t        if (*row_info).color_type as c_int == PNG_COLOR_TYPE_GRAY_ALPHA {\n455\t            (*row_info).color_type = PNG_COLOR_TYPE_GRAY as png_byte;\n456\t        }\n457\t    }\n458\t    /* RGBA, RGBX, XRGB cases */\n459\t    else if (*row_info).channels == 4 {\n460\t        if (*row_info).bit_depth == 8 {\n461\t            if at_start != 0\n462\t            /* Skip initial filler */\n463\t            {\n464\t                sp = sp.add(1);\n465\t            } else\n466\t            /* Skip initial channels and, for sp, the filler */\n467\t            {\n468\t                sp = sp.add(4);\n469\t                dp = dp.add(3);\n470\t            }\n471\t\n472\t            /* Note that the loop adds 3 to dp and 4 to sp each time. */\n473\t            while sp < ep {\n474\t                *dp = *sp;\n475\t                dp = dp.add(1);\n476\t                sp = sp.add(1);\n477\t                *dp = *sp;\n478\t                dp = dp.add(1);\n479\t                sp = sp.add(1);\n480\t                *dp = *sp;\n481\t                dp = dp.add(1);\n482\t                sp = sp.add(2);\n483\t            }\n484\t\n485\t            (*row_info).pixel_depth = 24;\n486\t        } else if (*row_info).bit_depth == 16 {\n487\t            if at_start != 0\n488\t            /* Skip initial filler */\n489\t            {\n490\t                sp = sp.add(2);\n491\t            } else\n492\t            /* Skip initial channels and, for sp, the filler */\n493\t            {\n494\t                sp = sp.add(8);\n495\t                dp = dp.add(6);\n496\t            }\n497\t\n498\t            while sp < ep {\n499\t                /* Copy 6 bytes, skip 2 */\n500\t                *dp = *sp;\n501\t                dp = dp.add(1);\n502\t                sp = sp.add(1);\n503\t                *dp = *sp;\n504\t                dp = dp.add(1);\n505\t                sp = sp.add(1);\n506\t                *dp = *sp;\n507\t                dp = dp.add(1);\n508\t                sp = sp.add(1);\n509\t                *dp = *sp;\n510\t                dp = dp.add(1);\n511\t                sp = sp.add(1);\n512\t                *dp = *sp;\n513\t                dp = dp.add(1);\n514\t                sp = sp.add(1);\n515\t                *dp = *sp;\n516\t                dp = dp.add(1);\n517\t                sp = sp.add(3);\n518\t            }\n519\t\n520\t            (*row_info).pixel_depth = 48;\n521\t   