png_const_sPLT_entryp = *const png_sPLT_entry;\n104\t\n105\t#[repr(C)]\n106\t#[derive(Copy, Clone)]\n107\tpub struct png_sPLT_t {\n108\t    pub name: png_charp,\n109\t    pub depth: png_byte,\n110\t    pub entries: png_sPLT_entryp,\n111\t    pub nentries: png_int_32,\n112\t}\n113\tpub type png_sPLT_tp = *mut png_sPLT_t;\n114\tpub type png_const_sPLT_tp = *const png_sPLT_t;\n115\tpub type png_sPLT_tpp = *mut png_sPLT_tp;\n116\t\n117\timpl Default for png_sPLT_t {\n118\t    fn default() -> Self {\n119\t        png_sPLT_t {\n120\t            name: core::ptr::null_mut(),\n121\t            depth: 0,\n122\t            entries: core::ptr::null_mut(),\n123\t            nentries: 0,\n124\t        }\n125\t    }\n126\t}\n127\t\n128\t#[repr(C)]\n129\t#[derive(Copy, Clone)]\n130\tpub struct png_text {\n131\t    pub compression: c_int,\n132\t    pub key: png_charp,\n133\t    pub text: png_charp,\n134\t    pub text_length: usize,\n135\t    pub itxt_length: usize,\n136\t    pub lang: png_charp,\n137\t    pub lang_key: png_charp,\n138\t}\n139\tpub type png_textp = *mut png_text;\n140\tpub type png_const_textp = *const png_text;\n141\tpub type png_textpp = *mut png_textp;\n142\t\n143\timpl Default for png_text {\n144\t    fn default() -> Self {\n145\t        png_text {\n146\t            compression: 0,\n147\t            key: core::ptr::null_mut(),\n148\t            text: core::ptr::null_mut(),\n149\t            text_length: 0,\n150\t            itxt_length: 0,\n151\t            lang: core::ptr::null_mut(),\n152\t            lang_key: core::ptr::null_mut(),\n153\t        }\n154\t    }\n155\t}\n156\t\n157\tpub const PNG_TEXT_COMPRESSION_NONE_WR: c_int = -3;\n158\tpub const PNG_TEXT_COMPRESSION_zTXt_WR: c_int = -2;\n159\tpub const PNG_TEXT_COMPRESSION_NONE: c_int = -1;\n160\tpub const PNG_TEXT_COMPRESSION_zTXt: c_int = 0;\n161\tpub const PNG_ITXT_COMPRESSION_NONE: c_int = 1;\n162\tpub const PNG_ITXT_COMPRESSION_zTXt: c_int = 2;\n163\tpub const PNG_TEXT_COMPRESSION_LAST: c_int = 3;\n164\