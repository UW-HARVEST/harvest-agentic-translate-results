{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_011W7MrQC3YGoaMUMXQUyDTk","type":"tool_result","content":"1\t//! Small shims over the C standard library facilities that libpng uses\n2\t//! directly (stdio, malloc, gmtime, ...).\n3\t#![allow(non_camel_case_types)]\n4\t#![allow(dead_code)]\n5\t\n6\tuse core::ffi::{c_char, c_int, c_long, c_void};\n7\t\n8\t#[repr(C)]\n9\tpub struct tm {\n10\t    pub tm_sec: c_int,\n11\t    pub tm_min: c_int,\n12\t    pub tm_hour: c_int,\n13\t    pub tm_mday: c_int,\n14\t    pub tm_mon: c_int,\n15\t    pub tm_year: c_int,\n16\t    pub tm_wday: c_int,\n17\t    pub tm_yday: c_int,\n18\t    pub tm_isdst: c_int,\n19\t    pub tm_gmtoff: c_long,\n20\t    pub tm_zone: *const c_char,\n21\t}\n22\t\n23\tpub type time_t = i64;\n24\t\n25\textern \"C\" {\n26\t    pub fn malloc(size: usize) -> *mut c_void;\n27\t    pub fn free(p: *mut c_void);\n28\t    pub fn abort() -> !;\n29\t\n30\t    pub fn fopen(path: *const c_char, mode: *const c_char) -> *mut c_void;\n31\t    pub fn fclose(f: *mut c_void) -> c_int;\n32\t    pub fn fread(buf: *mut c_void, size: usize, n: usize, f: *mut c_void) -> usize;\n33\t    pub fn fwrite(buf: *const c_void, size: usize, n: usize, f: *mut c_void) -> usize;\n34\t    pub fn fflush(f: *mut c_void) -> c_int;\n35\t    pub fn ferror(f: *mut c_void) -> c_int;\n36\t    pub fn fprintf(f: *mut c_void, fmt: *const c_char, ...) -> c_int;\n37\t\n38\t    pub fn gmtime(t: *const time_t) -> *mut tm;\n39\t\n40\t    #[link_name = \"stderr\"]\n41\t    pub static mut stderr_ptr: *mut c_void;\n42\t}\n43\t\n44\t/// `memcpy`\n45\t#[inline]\n46\tpub unsafe fn memcpy(dst: *mut u8, src: *const u8, n: usize) {\n47\t    if n != 0 {\n48\t        core::ptr::copy_nonoverlapping(src, dst, n);\n49\t    }\n50\t}\n51\t\n52\t/// `memmove`\n53\t#[inline]\n54\tpub unsafe fn memmove(dst: *mut u8, src: *const u8, n: usize) {\n55\t    if n != 0 {\n56\t        core::ptr::copy(src, dst, n);\n57\t    }\n58\t}\n59\t\n60\t/// `memset`\n61\t#[inline]\n62\tpub unsafe fn memset(dst: *mut u8, v: u8, n: usize) {\n63\t    if n != 0 {\n64\t        core::ptr::write_bytes(dst, v, n);\n65\t    }\n66\t}\n67\t\n68\t/// `memcmp`\n69\t#[inline]\n70\tpub unsafe fn memcmp(a: *const u8, b: *const u8, n: usize) -> c_int {\n71\t    for i in 0..n {\n72\t        let x = *a.add(i);\n73\t        let y = *b.add(i);\n74\t        if x != y {\n75\t            return x as c_int - y as c_int;\n76\t        }\n77\t    }\n78\t    0\n79\t}\n80\t\n81\t/// `strlen`\n82\t#[inline]\n83\tpub unsafe fn strlen(s: *const c_char) -> usize {\n84\t    let mut n = 0usize;\n85\t    while *s.add(n) != 0 {\n86\t        n += 1;\n87\t    }\n88\t    n\n89\t}\n90\t\n91\t/// `strcmp`\n92\t#[inline]\n93\tpub unsafe fn strcmp(a: *const c_char, b: *const c_char) -> c_int {\n94\t    let mut i = 0usize;\n95\t    loop {\n96\t        let x = *a.add(i) as u8;\n97\t        let y = *b.add(i) as u8;\n98\t        if x != y {\n99\t            return x as c_int - y as c_int;\n100\t        }\n101\t        if x == 0 {\n102\t            return 0;\n103\t        }\n104\t        i += 1;\n105\t    }\n106\t}\n107\t"}]},"parent_tool_use_id":"toolu_bdrk_01LtC8X2KneR5WzcVxhVQHSZ","session_id":"bedb3620-db7f-4287-b934-614ec17ac76e","uuid":"67ae7cbf-3094-49dc-bc35-40d5f69242a1","timestamp":"2026-08-31T12:38:28.380Z","subagent_type":"general-purpose","task_description":"Translate pngrutil.c 1999-3226"}
