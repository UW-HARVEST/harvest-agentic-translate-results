{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01R2DPL9HR2o46hMKFQR5u4j","type":"tool_result","content":"1\t//! pngmem.c - memory allocation.\n2\tuse crate::prelude::*;\n3\tuse core::ffi::{c_char, c_int, c_void};\n4\t\n5\t/// `png_destroy_png_struct` (PRIVATE, but exported by the reference build)\n6\t#[unsafe(no_mangle)]\n7\tpub unsafe extern \"C-unwind\" fn png_destroy_png_struct(png_ptr: png_structrp) {\n8\t    if !png_ptr.is_null() {\n9\t        /* png_free might call png_error and may certainly call\n10\t         * png_get_mem_ptr, so fake a temporary png_struct to support this.\n11\t         */\n12\t        let mut dummy_struct: png_struct = core::ptr::read(png_ptr);\n13\t        memset(png_ptr as *mut u8, 0, core::mem::size_of::<png_struct>());\n14\t        png_free(&mut dummy_struct, png_ptr as png_voidp);\n15\t\n16\t        /* We may have a jmp_buf left to deallocate. */\n17\t        png_free_jmpbuf(&mut dummy_struct);\n18\t    }\n19\t}\n20\t\n21\t#[unsafe(no_mangle)]\n22\tpub unsafe extern \"C-unwind\" fn png_calloc(\n23\t    png_ptr: png_const_structrp,\n24\t    size: png_alloc_size_t,\n25\t) -> png_voidp {\n26\t    let ret: png_voidp = png_malloc(png_ptr, size);\n27\t\n28\t    if !ret.is_null() {\n29\t        memset(ret as *mut u8, 0, size);\n30\t    }\n31\t\n32\t    ret\n33\t}\n34\t\n35\t#[unsafe(no_mangle)]\n36\tpub unsafe extern \"C-unwind\" fn png_malloc_base(\n37\t    png_ptr: png_const_structrp,\n38\t    size: png_alloc_size_t,\n39\t) -> png_voidp {\n40\t    /* This is checked too because the system malloc call below takes a\n41\t     * (size_t).\n42\t     */\n43\t    if size > PNG_SIZE_MAX {\n44\t        return core::ptr::null_mut();\n45\t    }\n46\t\n47\t    if !png_ptr.is_null() && (*png_ptr).malloc_fn.is_some() {\n48\t        return ((*png_ptr).malloc_fn.unwrap())(png_ptr as png_structrp, size);\n49\t    }\n50\t\n51\t    /* Use the system malloc */\n52\t    crate::cabi::malloc(size)\n53\t}\n54\t\n55\tunsafe fn png_malloc_array_checked(\n56\t    png_ptr: png_const_structrp,\n57\t    nelements: c_int,\n58\t    element_size: usize,\n59\t) -> png_voidp {\n60\t    let req: png_alloc_size_t = nelements as png_alloc_size_t; /* known to be > 0 */\n61\t\n62\t    if req <= PNG_SIZE_MAX / element_size {\n63\t        return png_malloc_base(png_ptr, req * element_size);\n64\t    }\n65\t\n66\t    /* The failure case when the request is too large */\n67\t    core::ptr::null_mut()\n68\t}\n69\t\n70\t#[unsafe(no_mangle)]\n71\tpub unsafe extern \"C-unwind\" fn png_malloc_array(\n72\t    png_ptr: png_const_structrp,\n73\t    nelements: c_int,\n74\t    element_size: usize,\n75\t) -> png_voidp {\n76\t    if nelements <= 0 || element_size == 0 {\n77\t        png_error(png_ptr, c\"internal error: array alloc\".as_ptr());\n78\t    }\n79\t\n80\t    png_malloc_array_checked(png_ptr, nelements, element_size)\n81\t}\n82\t\n83\t#[unsafe(no_mangle)]\n84\tpub unsafe extern \"C-unwind\" fn png_realloc_array(\n85\t    png_ptr: png_const_structrp,\n86\t    old_array: png_const_voidp,\n87\t    old_elements: c_int,\n88\t    add_elements: c_int,\n89\t    element_size: usize,\n90\t) -> png_voidp {\n91\t    /* These are internal errors: */\n92\t    if add_elements <= 0\n93\t        || element_size == 0\n94\t        || old_elements < 0\n95\t        || (old_array.is_null() && old_elements > 0)\n96\t    {\n97\t        png_error(png_ptr, c\"internal error: array realloc\".as_ptr());\n98\t    }\n99\t\n100\t    /* Check for overflow on the elements count (so the caller does not have to\n101\t     * check.)\n102\t     */\n103\t    if add_elements <= c_int::MAX - old_elements {\n104\t        let new_array: png_voidp =\n105\t            png_malloc_array_checked(png_ptr, old_elements + add_elements, element_size);\n106\t\n107\t        if !new_array.is_null() {\n108\t            /* Because png_malloc_array worked the size calculations below\n109\t             * cannot overflow.\n110\t             */\n111\t            if old_elements > 0 {\n112\t                memcpy(\n113\t                    new_array as *mut u8,\n114\t                    old_array as *const u8,\n115\t                    element_size * (old_elements as u32 as usize),\n116\t                );\n117\t            }\n118\t\n119\t            memset(\n120\t                (new_array as *mut u8).add(element_size * (old_elements as u32 as usize)),\n121\t                0,\n122\t                element_size * (add_elements as u32 as usize),\n123\t            );\n124\t\n125\t            return new_array;\n126\t        }\n127\t    }\n128\t\n129\t    core::ptr::null_mut() /* error */\n130\t}\n131\t\n132\t#[unsafe(no_mangle)]\n133\tpub unsafe extern \"C-unwind\" fn png_malloc(\n134\t    png_ptr: png_const_structrp,\n135\t    size: png_alloc_size_t,\n136\t) -> png_voidp {\n137\t    if png_ptr.is_null() {\n138\t        return core::ptr::null_mut();\n139\t    }\n140\t\n141\t    let ret: png_voidp = png_malloc_base(png_ptr, size);\n142\t\n143\t    if ret.is_null() {\n144\t        png_error(png_ptr, c\"Out of memory\".as_ptr()); /* 'm' means png_malloc */\n145\t    }\n146\t\n147\t    ret\n148\t}\n149\t\n150\t#[unsafe(no_mangle)]\n151\tpub unsafe extern \"C-unwind\" fn png_malloc_default(\n152\t    png_ptr: png_const_structrp,\n153\t    size: png_alloc_size_t,\n154\t) -> png_voidp {\n155\t    if png_ptr.is_null() {\n156\t        return core::ptr::null_mut();\n157\t    }\n158\t\n159\t    /* Passing 'NULL' here bypasses the application provided memory handler. */\n160\t    let ret: png_voidp = png_malloc_base(core::ptr::null(), size);\n161\t\n162\t    if ret.is_null() {\n163\t        png_error(png_ptr, c\"Out of Memory\".as_ptr()); /* 'M' means png_malloc_default */\n164\t    }\n165\t\n166\t    ret\n167\t}\n168\t\n169\t#[unsafe(no_mangle)]\n170\tpub unsafe extern \"C-unwind\" fn png_malloc_warn(\n171\t    png_ptr: png_const_structrp,\n172\t    size: png_alloc_size_t,\n173\t) -> png_voidp {\n174\t    if !png_ptr.is_null() {\n175\t        let ret: png_voidp = png_malloc_base(png_ptr, size);\n176\t\n177\t        if !ret.is_null() {\n178\t            return ret;\n179\t        }\n180\t\n181\t        png_warning(png_ptr, c\"Out of memory\".as_ptr());\n182\t    }\n183\t\n184\t    core::ptr::null_mut()\n185\t}\n186\t\n187\t#[unsafe(no_mangle)]\n188\tpub unsafe extern \"C-unwind\" fn png_free(png_ptr: png_const_structrp, ptr: png_voidp) {\n189\t    if png_ptr.is_null() || ptr.is_null() {\n190\t        return;\n191\t    }\n192\t\n193\t    if (*png_ptr).free_fn.is_some() {\n194\t        ((*png_ptr).free_fn.unwrap())(png_ptr as png_structrp, ptr);\n195\t    } else {\n196\t        png_free_default(png_ptr, ptr);\n197\t    }\n198\t}\n199\t\n200\t#[unsafe(no_mangle)]\n201\tpub unsafe extern \"C-unwind\" fn png_free_default(png_ptr: png_const_structrp, ptr: png_voidp) {\n202\t    if png_ptr.is_null() || ptr.is_null() {\n203\t        return;\n204\t    }\n205\t\n206\t    crate::cabi::free(ptr);\n207\t}\n208\t\n209\t#[unsafe(no_mangle)]\n210\tpub unsafe extern \"C-unwind\" fn png_set_mem_fn(\n211\t    png_ptr: png_structrp,\n212\t    mem_ptr: png_voidp,\n213\t    malloc_fn: png_malloc_ptr,\n214\t    free_fn: png_free_ptr,\n215\t) {\n216\t    if !png_ptr.is_null() {\n217\t        (*png_ptr).mem_ptr = mem_ptr;\n218\t        (*png_ptr).malloc_fn = malloc_fn;\n219\t        (*png_ptr).free_fn = free_fn;\n220\t    }\n221\t}\n222\t\n223\t#[unsafe(no_mangle)]\n224\tpub unsafe extern \"C-unwind\" fn png_get_mem_ptr(png_ptr: png_const_structrp) -> png_voidp {\n225\t    if png_ptr.is_null() {\n226\t        return core::ptr::null_mut();\n227\t    }\n228\t\n229\t    (*png_ptr).mem_ptr\n230\t}\n231\t"}]},"parent_tool_use_id":"toolu_bdrk_016o1R3UxZEVMHfBb3ne3uzs","session_id":"bedb3620-db7f-4287-b934-614ec17ac76e","uuid":"38699696-1225-4bf9-a28d-d7d7376462b0","timestamp":"2026-08-31T12:36:26.587Z","subagent_type":"general-purpose","task_description":"Translate pngset.c 1156-2057"}
