{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_014dygHKRG61is5L7eCBKHDZ","type":"tool_result","content":"1\t//! File-local (C `static` / typedef) definitions from pngread.c, pngwrite.c and\n2\t//! pngwutil.c that are shared between the Rust modules a single C file was\n3\t//! split into.\n4\t#![allow(non_camel_case_types)]\n5\t#![allow(dead_code)]\n6\t\n7\tuse crate::types::*;\n8\tuse core::ffi::{c_int, c_void};\n9\t\n10\t// ---------------------------------------------------------------------------\n11\t// pngread.c\n12\t// ---------------------------------------------------------------------------\n13\t\n14\t/* File encodings (\"E_\"/\"P_\" values) */\n15\tpub const P_NOTSET: c_int = 0; /* File encoding not yet known */\n16\tpub const P_sRGB: c_int = 1; /* 8-bit encoded to sRGB gamma */\n17\tpub const P_LINEAR: c_int = 2; /* 16-bit linear: not encoded, NOT pre-multiplied! */\n18\tpub const P_FILE: c_int = 3; /* 8-bit encoded to file gamma, not sRGB or linear */\n19\tpub const P_LINEAR8: c_int = 4; /* 8-bit linear: only from a file value */\n20\t\n21\tpub const PNG_CMAP_NONE: c_int = 0;\n22\tpub const PNG_CMAP_GA: c_int = 1;\n23\tpub const PNG_CMAP_TRANS: c_int = 2;\n24\tpub const PNG_CMAP_RGB: c_int = 3;\n25\tpub const PNG_CMAP_RGB_ALPHA: c_int = 4;\n26\t\n27\tpub const PNG_CMAP_NONE_BACKGROUND: c_int = 256;\n28\tpub const PNG_CMAP_GA_BACKGROUND: c_int = 231;\n29\tpub const PNG_CMAP_TRANS_BACKGROUND: c_int = 254;\n30\tpub const PNG_CMAP_RGB_BACKGROUND: c_int = 256;\n31\tpub const PNG_CMAP_RGB_ALPHA_BACKGROUND: c_int = 216;\n32\t\n33\tpub const PNG_GRAY_COLORMAP_ENTRIES: c_int = 256;\n34\tpub const PNG_GA_COLORMAP_ENTRIES: c_int = 256;\n35\tpub const PNG_RGB_COLORMAP_ENTRIES: c_int = 216;\n36\tpub const sRGB_TOLERANCE: png_fixed_point = 1000;\n37\t\n38\t/// `PNG_DIV51(v8)`\n39\t#[inline]\n40\tpub const fn PNG_DIV51(v8: png_uint_32) -> png_uint_32 {\n41\t    (v8 * 5 + 130) >> 8\n42\t}\n43\t\n44\t/// `PNG_RGB_INDEX(r,g,b)` from pngread.