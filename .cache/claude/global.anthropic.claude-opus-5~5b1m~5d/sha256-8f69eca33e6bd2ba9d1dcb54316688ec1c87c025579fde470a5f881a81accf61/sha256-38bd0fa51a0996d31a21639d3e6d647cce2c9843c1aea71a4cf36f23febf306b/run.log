 const PNG_EXPAND_tRNS: png_uint_32 = 0x2000000;\n81\tpub const PNG_SCALE_16_TO_8: png_uint_32 = 0x4000000;\n82\t\n83\tpub const PNG_STRUCT_PNG: png_uint_32 = 0x0001;\n84\tpub const PNG_STRUCT_INFO: png_uint_32 = 0x0002;\n85\t\n86\t// --- png_ptr->flags --------------------------------------------------------\n87\tpub const PNG_FLAG_ZLIB_CUSTOM_STRATEGY: png_uint_32 = 0x0001;\n88\tpub const PNG_FLAG_ZSTREAM_INITIALIZED: png_uint_32 = 0x0002;\n89\tpub const PNG_FLAG_ZSTREAM_ENDED: png_uint_32 = 0x0008;\n90\tpub const PNG_FLAG_ROW_INIT: png_uint_32 = 0x0040;\n91\tpub const PNG_FLAG_FILLER_AFTER: png_uint_32 = 0x0080;\n92\tpub const PNG_FLAG_CRC_ANCILLARY_USE: png_uint_32 = 0x0100;\n93\tpub const PNG_FLAG_CRC_ANCILLARY_NOWARN: png_uint_32 = 0x0200;\n94\tpub const PNG_FLAG_CRC_CRITICAL_USE: png_uint_32 = 0x0400;\n95\tpub const PNG_FLAG_CRC_CRITICAL_IGNORE: png_uint_32 = 0x0800;\n96\tpub const PNG_FLAG_OPTIMIZE_ALPHA: png_uint_32 = 0x2000;\n97\tpub const PNG_FLAG_DETECT_UNINITIALIZED: png_uint_32 = 0x4000;\n98\tpub const PNG_FLAG_LIBRARY_MISMATCH: png_uint_32 = 0x20000;\n99\tpub const PNG_FLAG_STRIP_ERROR_TEXT: png_uint_32 = 0x80000;\n100\tpub const PNG_FLAG_BENIGN_ERRORS_WARN: png_uint_32 = 0x100000;\n101\tpub const PNG_FLAG_APP_WARNINGS_WARN: png_uint_32 = 0x200000;\n102\tpub const PNG_FLAG_APP_ERRORS_WARN: png_uint_32 = 0x400000;\n103\t\n104\tpub const PNG_FLAG_CRC_ANCILLARY_MASK: png_uint_32 =\n105\t    PNG_FLAG_CRC_ANCILLARY_USE | PNG_FLAG_CRC_ANCILLARY_NOWARN;\n106\tpub const PNG_FLAG_CRC_CRITICAL_MASK: png_uint_32 =\n107\t    PNG_FLAG_CRC_CRITICAL_USE | PNG_FLAG_CRC_CRITICAL_IGNORE;\n108\tpub const PNG_FLAG_CRC_MASK: png_uint_32 =\n109\t    PNG_FLAG_CRC_ANCILLARY_MASK | PNG_FLAG_CRC_CRITICAL_MASK;\n110\t\n111\t// --- Chunk type constants --------------------------------------------------\n112\t#[inline]\n113\tpub const fn PNG_U32(b1: u32, b2: u32, b3: u32, b4: u32) -> png_uint_32 {\n114\t    (b1 << 24) | (b2 << 16) | (b3 << 8) | b4\n115\t}\n116\t\n117\tpub const png_IDAT: png_uint_32 = PNG_U32(73, 68, 65, 84);\n118\tpub const png_IEND: png_uint_32 = PNG_U32(73, 69, 78, 68);\n119\tpub const png_IHDR: png_uint_32 = PNG_U32(73, 72, 68, 82);\n120\tpub const png_PLTE: png_uint_32 = PNG_U32(80, 76, 84, 69);\n121\tpub const png_acTL: png_uint_32 = PNG_U32(97, 99, 84, 76);\n122\tpub const png_bKGD: png_uint_32 = PNG_U32(98, 75, 71, 68);\n123\tpub const png_cHRM: png_uint_32 = PNG_U32(99, 72, 82, 77);\n124\tpub const png_cICP: png_uint_32 = PNG_U32(99, 73, 67, 80);\n125\tpub const png_cLLI: png_uint_32 = PNG_U32(99, 76, 76, 73);\n126\tpub const png_eXIf: png_uint_32 = PNG_U32(101, 88, 73, 102);\n127\tpub const png_fcTL: png_uint_32 = PNG_U32(102, 99, 84, 76);\n128\tpub const png_fdAT: png_uint_32 = PNG_U32(102, 100, 65, 84);\n129\tpub const png_fRAc: png_uint_32 = PNG_U32(102, 82, 65, 99);\n130\tpub const png_gAMA: png_uint_32 = PNG_U32(103, 65, 77, 65);\n131\tpub const png_gIFg: png_uint_32 = PNG_U32(103, 73, 70, 103);\n132\tpub const png_gIFt: png_uint_32 = PNG_U32(103, 73, 70, 116);\n133\tpub const png_gIFx: png_uint_32 = PNG_U32(103, 73, 70, 120);\n134\tpub const png_hIST: png_uint_32 = PNG_U32(104, 73, 83, 84);\n135\tpub const png_iCCP: png_uint_32 = PNG_U32(105, 67, 67, 80);\n136\tpub const png_iTXt: png_uint_32 = PNG_U32(105, 84, 88, 116);\n137\tpub const png_mDCV: png_uint_32 = PNG_U32(109, 68, 67, 86);\n138\tpub const png_oFFs: png_uint_32 = PNG_U32(111, 70, 70, 115);\n139\tpub const png_pCAL: png_uint_32 = PNG_U32(112, 67, 65, 76);\n140\tpub const png_pHYs: png_uint_32 = PNG_U32(112, 72, 89, 115);\n141\tpub const png_sBIT: png_uint_32 = PNG_U32(115, 66, 73, 84);\n142\tpub const png_sCAL: png_uint_32 = PNG_U32(115, 67, 65, 76);\n143\tpub const png_sPLT: png_uint_32 = PNG_U32(115, 80, 76, 84);\n144\tpub const png_sRGB: png_uint_32 = PNG_U32(115, 82, 71, 66);\n145\tpub const png_sTER: png_uint_32 = PNG_U32(115, 84, 69, 82);\n146\tpub const png_tEXt: png_uint_32 = PNG_U32(116, 69, 88, 116);\n147\tpub const png_tIME: png_uint_32 = PNG_U32(116, 73, 77, 69);\n148\tpub const png_tRNS: png_uint_32 = PNG_U32(116, 82, 78, 83);\n149\tpub const png_zTXt: png_uint_32 = PNG_U32(122, 84, 88, 116);\n150\t\n151\t#[inline]\n152\tpub const fn PNG_32to8(cn: png_uint_32, s: u32) -> u32 {\n153\t    (cn >> s) & 0xff\n154\t}\n155\t#[inline]\n156\tpub const fn PNG_CN_VALID_UPPER(b: u32) -> bool {\n157\t    b >= 65 && b <= 90\n158\t}\n159\t#[inline]\n160\tpub const fn PNG_CN_VALID_ASCII(b: u32) -> bool {\n161\t    PNG_CN_VALID_UPPER(b & !32u32)\n162\t}\n163\t#[inline]\n164\tpub const fn PNG_CHUNK_NAME_VALID(cn: png_uint_32) -> bool {\n165\t    PNG_CN_VALID_ASCII(PNG_32to8(cn, 24))\n166\t        && PNG_CN_VALID_ASCII(PNG_32to8(cn, 16))\n167\t        && PNG_CN_VALID_UPPER(PNG_32to8(cn, 8))\n168\t        && PNG_CN_VALID_ASCII(PNG_32to8(cn, 0))\n169\t}\n170\t\n171\t/// `PNG_CHUNK_FROM_STRING(s)`\n172\t#[inline]\n173\tpub unsafe fn PNG_CHUNK_FROM_STRING(s: *const png_byte) -> png_uint_32 {\n174\t    PNG_U32(\n175\t        (*s.add(0)) as u32,\n176\t        (*s.add(1)) as u32,\n177\t        (*s.add(2)) as u32,\n178\t        (*s.add(3)) as u32,\n179\t    )\n180\t}\n181\t\n182\t/// `PNG_STRING_FROM_CHUNK(s, c)`\n183\t#[inline]\n184\tpub unsafe fn PNG_STRING_FROM_CHUNK(s: *mut png_byte, c: png_uint_32) {\n185\t    *s.add(0) = ((c >> 24) & 0xff) as png_byte;\n186\t    *s.add(1) = ((c >> 16) & 0xff) as png_byte;\n187\t    *s.add(2) = ((c >> 8) & 0xff) as png_byte;\n188\t    *s.add(3) = (c & 0xff) as png_byte;\n189\t}\n190\t\n191\t/// `PNG_CSTRING_FROM_CHUNK(s, c)`\n192\t#[inline]\n193\tpub unsafe fn PNG_CSTRING_FROM_CHUNK(s: *mut png_byte, c: png_uint_32) {\n194\t    PNG_STRING_FROM_CHUNK(s, c);\n195\t    *s.add(4) = 0;\n196\t}\n197\t\n198\t#[inline]\n199\tpub const fn PNG_CHUNK_ANCILLARY(c: png_uint_32) -> u32 {\n200\t    1 & (c >> 29)\n201\t}\n202\t#[inline]\n203\tpub const fn PNG_CHUNK_CRITICAL(c: png_uint_32) -> bool {\n204\t    PNG_CHUNK_ANCILLARY(c) == 0\n205\t}\n206\t#[inline]\n207\tpub const fn PNG_CHUNK_PRIVATE(c: png_uint_32) -> u32 {\n208\t    1 & (c >> 21)\n209\t}\n210\t#[inline]\n211\tpub const fn PNG_CHUNK_RESERVED(c: png_uint_32) -> u32 {\n212\t    1 & (c >> 13)\n213\t}\n214\t#[inline]\n215\tpub const fn PNG_CHUNK_SAFE_TO_COPY(c: png_uint_32) -> u32 {\n216\t    1 & (c >> 5)\n217\t}\n218\t\n219\t// --- Gamma constants -------------------------------------------------------\n220\tpub const PNG_GAMMA_MAC_OLD: png_fixed_point = 151724;\n221\tpub const PNG_GAMMA_MAC_INVERSE: png_fixed_point = 65909;\n222\tpub const PNG_GAMMA_sRGB_INVERSE: png_fixed_point = 45455;\n223\tpub const PNG_LIB_GAMMA_MIN: png_fixed_point = 1000;\n224\tpub const PNG_LIB_GAMMA_MAX: png_fixed_point = 10000000;\n225\t\n226\t// --- Utility macros --------------------------------------------------------\n227\t#[inline]\n228\tpub const fn PNG_DIV65535(v24: png_uint_32) -> png_uint_32 {\n229\t    (v24.wrapping_add(32895)) >> 16\n230\t}\n231\t#[inline]\n232\tpub const fn PNG_DIV257(v16: png_uint_32) -> png_uint_32 {\n233\t    PNG_DIV65535(v16.wrapping_mul(255))\n234\t}\n235\t\n236\t/// `PNG_ROWBYTES(pixel_bits, width)`\n237\t#[inline]\n238\tpub const fn PNG_ROWBYTES(pixel_bits: u32, width: png_uint_32) -> usize {\n239\t    if pixel_bits >= 8 {\n240\t        (width as usize).wrapping_mul((pixel_bits as usize) >> 3)\n241\t    } else {\n242\t        ((width as usize)\n243\t            .wrapping_mul(pixel_bits as usize)\n244\t            .wrapping_add(7))\n245\t            >> 3\n246\t    }\n247\t}\n248\t\n249\t#[inline]\n250\tpub const fn PNG_TRAILBITS(pixel_bits: u32, width: png_uint_32) -> png_uint_32 {\n251\t    (pixel_bits.wrapping_mul(width % 8)) % 8\n252\t}\n253\t\n254\t#[inline]\n255\tpub const fn PNG_PADBITS(pixel_bits: u32, width: png_uint_32) -> png_uint_32 {\n256\t    (8 - PNG_TRAILBITS(pixel_bits, width)) % 8\n257\t}\n258\t\n259\t#[inline]\n260\tpub fn PNG_OUT_OF_RANGE(value: png_fixed_point, ideal: png_fixed_point, delta: png_fixed_point) -> bool {\n261\t    value < ideal - delta || value > ideal + delta\n262\t}\n263\t\n264\t#[inline]\n265\tpub fn PNG_COLOR_DIST(c1: png_color, c2: png_color) -> c_int {\n266\t    ((c1.red as c_int) - (c2.red as c_int)).abs()\n267\t        + ((c1.green as c_int) - (c2.green as c_int)).abs()\n268\t        + ((c1.blue as c_int) - (c2.blue as c_int)).abs()\n269\t}\n270\t\n271\t/// `png_float(png_ptr, fixed, s)`\n272\t#[inline]\n273\tpub fn png_float_of(fixed: png_fixed_point) -> f64 {\n274\t    0.00001f64 * (fixed as f64)\n275\t}\n276\t\n277\t// --- warning / number formatting -------------------------------------------\n278\tpub const PNG_NUMBER_BUFFER_SIZE: usize = 24;\n279\tpub const PNG_NUMBER_FORMAT_u: c_int = 1;\n280\tpub const PNG_NUMBER_FORMAT_02u: c_int = 2;\n281\tpub const PNG_NUMBER_FORMAT_d: c_int = 1;\n282\tpub const PNG_NUMBER_FORMAT_02d: c_int = 2;\n283\tpub const PNG_NUMBER_FORMAT_x: c_int = 3;\n284\tpub const PNG_NUMBER_FORMAT_02x: c_int = 4;\n285\tpub const PNG_NUMBER_FORMAT_fixed: c_int = 5;\n286\t\n287\tpub const PNG_WARNING_PARAMETER_SIZE: usize = 32;\n288\tpub const PNG_WARNING_PARAMETER_COUNT: usize = 8;\n289\tpub type png_warning_parameters = [[core::ffi::c_char; PNG_WARNING_PARAMETER_SIZE];\n290\t    PNG_WARNING_PARAMETER_COUNT];\n291\t\n292\tpub const PNG_CHUNK_WARNING: c_int = 0;\n293\tpub const PNG_CHUNK_WRITE_ERROR: c_int = 1;\n294\tpub const PNG_CHUNK_ERROR: c_int = 2;\n295\t\n296\tpub const PNG_UNEXPECTED_ZLIB_RETURN: c_int = -7;\n297\t\n298\t// --- ASCII <-> FP parser states -------------------------------------------\n299\tpub const PNG_sCAL_MAX_DIGITS: usize = PNG_sCAL_PRECISION + 1 + 1 + 10;\n300\t\n301\tpub const PNG_FP_INTEGER: c_int = 0;\n302\tpub const PNG_FP_FRACTION: c_int = 1;\n303\tpub const PNG_FP_EXPONENT: c_int = 2;\n304\tpub const PNG_FP_STATE: c_int = 3;\n305\tpub const PNG_FP_SAW_SIGN: c_int = 4;\n306\tpub const PNG_FP_SAW_DIGIT: c_int = 8;\n307\tpub const PNG_FP_SAW_DOT: c_int = 16;\n308\tpub const PNG_FP_SAW_E: c_int = 32;\n309\tpub const PNG_FP_SAW_ANY: c_int = 60;\n310\tpub const PNG_FP_WAS_VALID: c_int = 64;\n311\tpub const PNG_FP_NEGATIVE: c_int = 128;\n312\tpub const PNG_FP_NONZERO: c_int = 256;\n313\tpub const PNG_FP_STICKY: c_int = 448;\n314\tpub const PNG_FP_INVALID: c_int = 512;\n315\tpub const PNG_FP_MAYBE: c_int = 0;\n316\tpub const PNG_FP_OK: c_int = 1;\n317\tpub const PNG_FP_NZ_MASK: c_int = PNG_FP_SAW_DIGIT | PNG_FP_NEGATIVE | PNG_FP_NONZERO;\n318\tpub const PNG_FP_Z_MASK: c_int = PNG_FP_SAW_DIGIT | PNG_FP_NONZERO;\n319\t\n320\t#[inline]\n321\tpub const fn PNG_FP_IS_ZERO(state: c_int) -> bool {\n322\t    (state & PNG_FP_Z_MASK) == PNG_FP_SAW_DIGIT\n323\t}\n324\t#[inline]\n325\tpub const fn PNG_FP_IS_POSITIVE(state: c_int) -> bool {\n326\t    (state & PNG_FP_NZ_MASK) == PNG_FP_Z_MASK\n327\t}\n328\t#[inline]\n329\tpub const fn PNG_FP_IS_NEGATIVE(state: c_int) -> bool {\n330\t    (state & PNG_FP_NZ_MASK) == PNG_FP_NZ_MASK\n331\t}\n332\t\n333\t// --- png_handle_result_code ------------------------------------------------\n334\tpub const handled_error: c_int = 0;\n335\tpub const handled_discarded: c_int = 1;\n336\tpub const handled_saved: c_int = 2;\n337\tpub const handled_ok: c_int = 3;\n338\t\n339\tpub const PNG_USE_COMPILE_TIME_MASKS: c_int = 1;\n340\t\n341\t/// `PNG_sRGB_FROM_LINEAR(linear)`\n342\t#[inline]\n343\tpub fn PNG_sRGB_FROM_LINEAR(linear: png_uint_32) -> png_byte {\n344\t    unsafe {\n345\t        let hi = (linear >> 15) as usize;\n346\t        (0xff & ((crate::srgb_tables::png_sRGB_base[hi] as u32\n347\t            + (((linear & 0x7fff) * crate::srgb_tables::png_sRGB_delta[hi] as u32) >> 12))\n348\t            >> 8)) as png_byte\n349\t    }\n350\t}\n351\t"}]},"parent_tool_use_id":"toolu_bdrk_018wqynw38KuR3qPrhdR6c7s","session_id":"bedb3620-db7f-4287-b934-614ec17ac76e","uuid":"6523fa48-bb5a-40c2-906f-fba8f994f539","timestamp":"2026-08-31T12:38:35.820Z","subagent_type":"general-purpose","task_description":"Translate pngrutil.c 3227-3953"}
