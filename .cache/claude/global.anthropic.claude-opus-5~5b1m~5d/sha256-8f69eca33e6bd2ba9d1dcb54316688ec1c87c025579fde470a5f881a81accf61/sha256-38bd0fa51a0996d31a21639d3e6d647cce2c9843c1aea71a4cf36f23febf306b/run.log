{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01WqzZnJM6HiSTqTF23QPVNE","type":"tool_result","content":"1\t//! pngwio.c - functions for data output.\n2\tuse crate::prelude::*;\n3\tuse core::ffi::{c_int, c_void};\n4\t\n5\t#[unsafe(no_mangle)]\n6\tpub unsafe extern \"C-unwind\" fn png_write_data(\n7\t    png_ptr: png_structrp,\n8\t    data: png_const_bytep,\n9\t    length: usize,\n10\t) {\n11\t    /* NOTE: write_data_fn must not change the buffer! */\n12\t    if (*png_ptr).write_data_fn.is_some() {\n13\t        ((*png_ptr).write_data_fn.unwrap())(png_ptr, data as png_bytep, length);\n14\t    } else {\n15\t        png_error(png_ptr, c\"Call to NULL write function\".as_ptr());\n16\t    }\n17\t}\n18\t\n19\t#[unsafe(no_mangle)]\n20\tpub unsafe extern \"C-unwind\" fn png_default_write_data(\n21\t    png_ptr: png_structp,\n22\t    data: png_bytep,\n23\t    length: usize,\n24\t) {\n25\t    let check: usize;\n26\t\n27\t    if png_ptr.is_null() {\n28\t        return;\n29\t    }\n30\t\n31\t    check = crate::cabi::fwrite(data as *const c_void, 1, length, (*png_ptr).io_ptr);\n32\t\n33\t    if check != length {\n34\t        png_error(png_ptr, c\"Write Error\".as_ptr());\n35\t    }\n36\t}\n37\t\n38\t#[unsafe(no_mangle)]\n39\tpub unsafe extern \"C-unwind\" fn png_flush(png_ptr: png_structrp) {\n40\t    if (*png_ptr).output_flush_fn.is_some() {\n41\t        ((*png_ptr).output_flush_fn.unwrap())(png_ptr);\n42\t    }\n43\t}\n44\t\n45\t#[unsafe(no_mangle)]\n46\tpub unsafe extern \"C-unwind\" fn png_default_flush(png_ptr: png_structp) {\n47\t    let io_ptr: *mut c_void;\n48\t\n49\t    if png_ptr.is_null() {\n50\t        return;\n51\t    }\n52\t\n53\t    io_ptr = (*png_ptr).io_ptr;\n54\t    crate::cabi::fflush(io_ptr);\n55\t}\n56\t\n57\t#[unsafe(no_mangle)]\n58\tpub unsafe extern \"C-unwind\" fn png_set_write_fn(\n59\t    png_ptr: png_structrp,\n60\t    io_ptr: png_voidp,\n61\t    write_data_fn: png_rw_ptr,\n62\t    output_flush_fn: png_flush_ptr,\n63\t) {\n64\t    if png_ptr.is_null() {\n65\t        return;\n66\t    }\n67\t\n68\t    (*png_ptr).io_ptr = io_ptr;\n69\t\n70\t    if write_data_fn.is_some() {\n71\t        (*png_ptr).write_data_fn = write_data_fn;\n72\t    } else {\n73\t        (*png_ptr).write_data_fn = Some(png_default_write_data);\n74\t    }\n75\t\n76\t    if output_flush_fn.is_some() {\n77\t        (*png_ptr).output_flush_fn = output_flush_fn;\n78\t    } else {\n79\t        (*png_ptr).output_flush_fn = Some(png_default_flush);\n80\t    }\n81\t\n82\t    /* It is an error to read while writing a png file */\n83\t    if (*png_ptr).read_data_fn.is_some() {\n84\t        (*png_ptr).read_data_fn = None;\n85\t\n86\t        png_warning(\n87\t            png_ptr,\n88\t            c\"Can't set both read_data_fn and write_data_fn in the same structure\".as_ptr(),\n89\t        );\n90\t    }\n91\t}\n92\t"}]},"parent_tool_use_id":"toolu_bdrk_01Ef94Q6WfkLVHxPqb466Btt","session_id":"bedb3620-db7f-4287-b934-614ec17ac76e","uuid":"01d0fbde-4b39-43f7-8214-79c3c307e244","timestamp":"2026-08-31T12:37:20.224Z","subagent_type":"general-purpose","task_description":"Translate pngwrite.c 1-1533"}
