 = PNG_U32(116, 73, 77, 69);\n148\tpub const png_tRNS: png_uint_32 = PNG_U32(116, 82, 78, 83);\n149\tpub const png_zTXt: png_uint_32 = PNG_U32(122, 84, 88, 116);\n150\t\n151\t#[inline]\n152\tpub const fn PNG_32to8(cn: png_uint_32, s: u32) -> u32 {\n153\t    (cn >> s) & 0xff\n154\t}\n155\t#[inline]\n156\tpub const fn PNG_CN_VALID_UPPER(b: u32) -> bool {\n157\t    b >= 65 && b <= 90\n158\t}\n159\t#[inline]\n160\tpub const fn PNG_CN_VALID_ASCII(b: u32) -> bool {\n161\t    PNG_CN_VALID_UPPER(b & !32u32)\n162\t}\n163\t#[inline]\n164\tpub const fn PNG_CHUNK_NAME_VALID(cn: png_uint_32) -> bool {\n165\t    PNG_CN_VALID_ASCII(PNG_32to8(cn, 24))\n166\t        && PNG_CN_VALID_ASCII(PNG_32to8(cn, 16))\n167\t        && PNG_CN_VALID_UPPER(PNG_32to8(cn, 8))\n168\t        && PNG_CN_VALID_ASCII(PNG_32to8(cn, 0))\n169\t}\n170\t\n171\t/// `PNG_CHUNK_FROM_STRING(s)`\n172\t#[inline]\n173\tpub unsafe fn PNG_CHUNK_FROM_STRING(s: *const png_byte) -> png_uint_32 {\n174\t    PNG_U32(\n175\t        (*s.add(0)) as u32,\n176\t        (*s.add(1)) as u32,\n177\t        (*s.add(2)) as u32,\n178\t        (*s.add(3)) as u32,\n179\t    )\n180\t}\n181\t\n182\t/// `PNG_STRING_FROM_CHUNK(s, c)`\n183\t#[inline]\n184\tpub unsafe fn PNG_STRING_FROM_CHUNK(s: *mut png_byte, c: png_uint_32) {\n185\t    *s.add(0) = ((c >> 24) & 0xff) as png_byte;\n186\t    *s.add(1) = ((c >> 16) & 0xff) as png_byte;\n187\t    *s.add(2) = ((c >> 8) & 0xff) as png_byte;\n188\t    *s.add(3) = (c & 0xff) as png_byte;\n189\t}\n190\t\n191\t/// `PNG_CSTRING_FROM_CHUNK(s, c)`\n192\t#[inline]\n193\tpub unsafe fn PNG_CSTRING_FROM_CHUNK(s: *mut png_byte, c: png_uint_32) {\n194\t    PNG_STRING_FROM_CHUNK(s, c);\n195\t    *s.add(4) = 0;\n196\t}\n197\t\n198\t#[inline]\n199\tpub const fn PNG_CHUNK_ANCILLARY(c: png_uint_32) -> u32 {\n200\t    1 & (c >> 29)\n201\t}\n202\t#[inline]\n203\tpub const fn PNG_CHUNK_CRITICAL(c: png_uint_32) -> bool {\n204\t    PNG_CHUNK_ANCILLARY(c) == 0\n205\t}\n206\t#[inline]\n207\tpub const fn PNG_CHUNK_PRIVATE(c: