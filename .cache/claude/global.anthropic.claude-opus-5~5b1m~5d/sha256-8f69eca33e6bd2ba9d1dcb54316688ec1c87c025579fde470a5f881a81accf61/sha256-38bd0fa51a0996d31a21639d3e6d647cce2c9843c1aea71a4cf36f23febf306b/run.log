            v = 0;\n61\t               }\n62\t            }\n63\t\n64\t            if (mask != 0x80)\n65\t               *dp = (png_byte)v;\n66\t\n67\t            break;\n68\t         }\n69\t\n70\t         case 2:\n71\t         {\n72\t            png_bytep sp, dp;\n73\t            unsigned int shift;\n74\t            int v;\n75\t            png_uint_32 i;\n76\t            png_uint_32 row_width = row_info->width;\n77\t\n78\t            sp = row;\n79\t            dp = row;\n80\t            shift = 6;\n81\t            v = 0;\n82\t\n83\t            for (i = 0; i < row_width; i++)\n84\t            {\n85\t               png_byte value;\n86\t\n87\t               value = (png_byte)(*sp & 0x03);\n88\t               v |= (value << shift);\n89\t\n90\t               if (shift == 0)\n91\t               {\n92\t                  shift = 6;\n93\t                  *dp = (png_byte)v;\n94\t                  dp++;\n95\t                  v = 0;\n96\t               }\n97\t\n98\t               else\n99\t                  shift -= 2;\n100\t\n101\t               sp++;\n102\t            }\n103\t\n104\t            if (shift != 6)\n105\t               *dp = (png_byte)v;\n106\t\n107\t            break;\n108\t         }\n109\t\n110\t         case 4:\n111\t         {\n112\t            png_bytep sp, dp;\n113\t            unsigned int shift;\n114\t            int v;\n115\t            png_uint_32 i;\n116\t            png_uint_32 row_width = row_info->width;\n117\t\n118\t            sp = row;\n119\t            dp = row;\n120\t            shift = 4;\n121\t            v = 0;\n122\t\n123\t            for (i = 0; i < row_width; i++)\n124\t            {\n125\t               png_byte value;\n126\t\n127\t               value = (png_byte)(*sp & 0x0f);\n128\t               v |= (value << shift);\n129\t\n130\t               if (shift == 0)\n131\t               {\n132\t                  shift = 4;\n133\t                  *dp = (png_byte)v;\n134\t                  dp++;\n135\t                  v = 0;\n136\t     