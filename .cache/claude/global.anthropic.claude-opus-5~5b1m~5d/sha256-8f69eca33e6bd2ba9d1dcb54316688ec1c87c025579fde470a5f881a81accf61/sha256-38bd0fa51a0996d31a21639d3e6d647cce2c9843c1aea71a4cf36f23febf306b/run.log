{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01YaGRcDthafDaScwE4sBbDU","type":"tool_result","content":"1\t//! A translation of libpng 1.6.59.git to Rust.\n2\t//!\n3\t//! The public ABI (every symbol exported by the reference C shared library) is\n4\t//! reproduced exactly; behaviour, including error messages, error ordering and\n5\t//! byte-for-byte output, follows the C sources.\n6\t#![allow(non_camel_case_types)]\n7\t#![allow(non_snake_case)]\n8\t#![allow(non_upper_case_globals)]\n9\t#![allow(unused_imports)]\n10\t#![allow(unused_parens)]\n11\t#![allow(unused_assignments)]\n12\t#![allow(unused_mut)]\n13\t#![allow(unused_variables)]\n14\t#![allow(dead_code)]\n15\t#![allow(unreachable_code)]\n16\t#![allow(unused_labels)]\n17\t#![allow(unpredictable_function_pointer_comparisons)]\n18\t#![allow(clippy::all)]\n19\t\n20\tpub mod cabi;\n21\tpub mod pngpriv;\n22\tpub mod pngstruct;\n23\tpub mod shared;\n24\tpub mod srgb_tables;\n25\tpub mod types;\n26\tpub mod zlib;\n27\t\n28\tpub mod png_a;\n29\tpub mod png_b;\n30\tpub mod png_c;\n31\tpub mod png_d;\n32\tpub mod pngerror;\n33\tpub mod pngget;\n34\tpub mod pngmem;\n35\tpub mod pngpread;\n36\tpub mod pngread_a;\n37\tpub mod pngread_b;\n38\tpub mod pngread_c;\n39\tpub mod pngread_d;\n40\tpub mod pngrio;\n41\tpub mod pngrtran_a;\n42\tpub mod pngrtran_b;\n43\tpub mod pngrtran_c;\n44\tpub mod pngrtran_d;\n45\tpub mod pngrtran_e;\n46\tpub mod pngrutil_a;\n47\tpub mod pngrutil_b;\n48\tpub mod pngrutil_c;\n49\tpub mod pngrutil_d;\n50\tpub mod pngrutil_e;\n51\tpub mod pngset_a;\n52\tpub mod pngset_b;\n53\tpub mod pngtrans;\n54\tpub mod pngwio;\n55\tpub mod pngwrite_a;\n56\tpub mod pngwrite_b;\n57\tpub mod pngwtran;\n58\tpub mod pngwutil_a;\n59\tpub mod pngwutil_b;\n60\tpub mod pngwutil_c;\n61\t\n62\t/// Items every translated module needs.\n63\tpub mod prelude {\n64\t    pub use core::ffi::{c_char, c_double, c_int, c_long, c_uint, c_ulong, c_void};\n65\t\n66\t    pub use crate::cabi::{memcmp, memcpy, memmove, memset, strcmp, strlen};\n67\t    pub use crate::pngpriv::*;\n68\t    pub use crate::pngstruct::*;\n69\t    pub use crate::shared::*;\n70\t    pub use crate::srgb_tables::{png_sRGB_base, png_sRGB_delta, png_sRGB_table};\n71\t    pub use crate::types::*;\n72\t    pub use crate::zlib;\n73\t    pub use crate::zlib::{\n74\t        adler32, crc32, deflate, deflateBound, deflateEnd, deflateInit2, deflateReset, inflate,\n75\t        inflateEnd, inflateInit, inflateInit2, inflateReset, inflateReset2, inflateValidate, uInt,\n76\t        uLong, z_stream, Z_BUF_ERROR, Z_DATA_ERROR, Z_DEFAULT_COMPRESSION, Z_DEFAULT_STRATEGY,\n77\t        Z_DEFLATED, Z_ERRNO, Z_FINISH, Z_MEM_ERROR, Z_NEED_DICT, Z_NO_FLUSH, Z_OK, Z_STREAM_END,\n78\t        Z_STREAM_ERROR, Z_SYNC_FLUSH, Z_VERSION_ERROR,\n79\t    };\n80\t\n81\t    // Cross-module entry points (public *and* file-local helpers).\n82\t    pub use crate::png_a::*;\n83\t    pub use crate::png_b::*;\n84\t    pub use crate::png_c::*;\n85\t    pub use crate::png_d::*;\n86\t    pub use crate::pngerror::*;\n87\t    pub use crate::pngget::*;\n88\t    pub use crate::pngmem::*;\n89\t    pub use crate::pngpread::*;\n90\t    pub use crate::pngread_a::*;\n91\t    pub use crate::pngread_b::*;\n92\t    pub use crate::pngread_c::*;\n93\t    pub use crate::pngread_d::*;\n94\t    pub use crate::pngrio::*;\n95\t    pub use crate::pngrtran_a::*;\n96\t    pub use crate::pngrtran_b::*;\n97\t    pub use crate::pngrtran_c::*;\n98\t    pub use crate::pngrtran_d::*;\n99\t    pub use crate::pngrtran_e::*;\n100\t    pub use crate::pngrutil_a::*;\n101\t    pub use crate::pngrutil_b::*;\n102\t    pub use crate::pngrutil_c::*;\n103\t    pub use crate::pngrutil_d::*;\n104\t    pub use crate::pngrutil_e::*;\n105\t    pub use crate::pngset_a::*;\n106\t    pub use crate::pngset_b::*;\n107\t    pub use crate::pngtrans::*;\n108\t    pub use crate::pngwio::*;\n109\t    pub use crate::pngwrite_a::*;\n110\t    pub use crate::pngwrite_b::*;\n111\t    pub use crat