{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01JKwXPeg1bpVTYsP9XKyfdu","type":"tool_result","content":"1\t//! pngrio.c - functions for data input.\n2\tuse crate::prelude::*;\n3\tuse core::ffi::{c_int, c_void};\n4\t\n5\t#[unsafe(no_mangle)]\n6\tpub unsafe extern \"C-unwind\" fn png_read_data(\n7\t    png_ptr: png_structrp,\n8\t    data: png_bytep,\n9\t    length: usize,\n10\t) {\n11\t    if (*png_ptr).read_data_fn.is_some() {\n12\t        ((*png_ptr).read_data_fn.unwrap())(png_ptr, data, length);\n13\t    } else {\n14\t        png_error(png_ptr, c\"Call to NULL read function\".as_ptr());\n15\t    }\n16\t}\n17\t\n18\t#[unsafe(no_mangle)]\n19\tpub unsafe extern \"C-unwind\" fn png_default_read_data(\n20\t    png_ptr: png_structp,\n21\t    data: png_bytep,\n22\t    length: usize,\n23\t) {\n24\t    let check: usize;\n25\t\n26\t    if png_ptr.is_null() {\n27\t        return;\n28\t    }\n29\t\n30\t    /* fread() returns 0 on error, so it is OK to store this in a size_t\n31\t     * instead of an int, which is what fread() actually returns.\n32\t     */\n33\t    check = crate::cabi::fread(data as *mut c_void, 1, length, (*png_ptr).io_ptr);\n34\t\n35\t    if check != length {\n36\t        png_error(png_ptr, c\"Read Error\".as_ptr());\n37\t    }\n38\t}\n39\t\n40\t#[unsafe(no_mangle)]\n41\tpub unsafe extern \"C-unwind\" fn png_set_read_fn(\n42\t    png_ptr: png_structrp,\n43\t    io_ptr: png_voidp,\n44\t    read_data_fn: png_rw_ptr,\n45\t) {\n46\t    if png_ptr.is_null() {\n47\t        return;\n48\t    }\n49\t\n50\t    (*png_ptr).io_ptr = io_ptr;\n51\t\n52\t    if read_data_fn.is_some() {\n53\t        (*png_ptr).read_data_fn = read_data_fn;\n54\t    } else {\n55\t        (*png_ptr).read_data_fn = Some(png_default_read_data);\n56\t    }\n57\t\n58\t    /* It is an error to write to a read device */\n59\t    if (*png_ptr).write_data_fn.is_some() {\n60\t        (*png_ptr).write_data_fn = None;\n61\t        png_warning(\n62\t            png_ptr,\n63\t            c\"Can't set both read_data_fn and write_data_fn in the same structure\".as_ptr(),\n64\t        );\n65\t    }\n66\t\n67\t    (*png_ptr).output_flush_fn = None;\n68\t}\n69\t"}]},"parent_tool_use_id":"toolu_bdrk_01Mu4y1rJRNNK2pfACJvwAhg","session_id":"bedb3620-db7f-4287-b934-614ec17ac76e","uuid":"27c3b376-f640-4ef2-9e77-cc56731dd66c","timestamp":"2026-08-31T12:37:46.780Z","subagent_type":"general-purpose","task_description":"Translate pngrutil.c 1-900"}
