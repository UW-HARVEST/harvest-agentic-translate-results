{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_018biwSBqE6tFZnEwz79mvRZ","type":"tool_result","content":"1\t/* Row reading for interlaced 16-to-8 bit depth conversion with local buffer. */\n2\tstatic int\n3\tpng_image_read_direct_scaled(png_voidp argument)\n4\t{\n5\t   png_image_read_control *display = png_voidcast(png_image_read_control*,\n6\t       argument);\n7\t   png_imagep image = display->image;\n8\t   png_structrp png_ptr = image->opaque->png_ptr;\n9\t   png_inforp info_ptr = image->opaque->info_ptr;\n10\t   png_bytep local_row = png_voidcast(png_bytep, display->local_row);\n11\t   png_bytep first_row = png_voidcast(png_bytep, display->first_row);\n12\t   ptrdiff_t row_step = display->row_step;\n13\t   size_t row_bytes = png_get_rowbytes(png_ptr, info_ptr);\n14\t   int passes;\n15\t\n16\t   /* Handle interlacing. */\n17\t   switch (png_ptr->interlaced)\n18\t   {\n19\t      case PNG_INTERLACE_NONE:\n20\t         passes = 1;\n21\t         break;\n22\t\n23\t      case PNG_INTERLACE_ADAM7:\n24\t         passes = PNG_INTERLACE_ADAM7_PASSES;\n25\t         break;\n26\t\n27\t      default:\n28\t         png_error(png_ptr, \"unknown interlace type\");\n29\t   }\n30\t\n31\t   /* Read each pass using local_row as intermediate buffer. */\n32\t   while (--passes >= 0)\n33\t   {\n34\t      png_uint_32 y = image->height;\n35\t      png_bytep output_row = first_row;\n36\t\n37\t      for (; y > 0; --y)\n38\t      {\n39\t         /* Read into local_row (gets transformed 8-bit data). */\n40\t         png_read_row(png_ptr, local_row, NULL);\n41\t\n42\t         /* Copy from local_row to user buffer.\n43\t          * Use row_bytes (i.e. the actual size in bytes of the row data) for\n44\t          * copying into output_row. Use row_step for advancing output_row,\n45\t          * to respect the caller's stride for padding or negative (bottom-up)\n46\t          * layouts.\n47\t          */\n48\t         memcpy(output_row, local_row, row_bytes);\n49\t         output_row += row_step;\n50\t      }\n51\t   }\n52\t\n53\t   return 1;\n54\t}\n55\t\n56\t/* Just the row reading part of png_image_read. */\n57\tstatic int\n58\tpng_image_read_composite(png_voidp argument)\n59\t{\n60\t   png_image_read_control *display = png_voidcast(png_image_read_control*,\n61\t       argument);\n62\t   png_imagep image = display->image;\n63\t   png_structrp png_ptr = image->opaque->png_ptr;\n64\t   int passes;\n65\t\n66\t   switch (png_ptr->interlaced)\n67\t   {\n68\t      case PNG_INTERLACE_NONE:\n69\t         passes = 1;\n70\t         break;\n71\t\n72\t      case PNG_INTERLACE_ADAM7:\n73\t         passes = PNG_INTERLACE_ADAM7_PASSES;\n74\t         break;\n75\t\n76\t      default:\n77\t         png_error(png_ptr, \"unknown interlace type\");\n78\t   }\n79\t\n80\t   {\n81\t      png_uint_32 height = image->height;\n82\t      png_uint_32 width = image->width;\n83\t      ptrdiff_t row_step = display->row_step;\n84\t      unsigned int channels =\n85\t          (image->format & PNG_FORMAT_FLAG_COLOR) != 0 ? 3 : 1;\n86\t      int optimize_alpha = (png_ptr->flags & PNG_FLAG_OPTIMIZE_ALPHA) != 0;\n87\t      int pass;\n88\t\n89\t      for (pass = 0; pass < passes; ++pass)\n90\t      {\n91\t         unsigned int startx, stepx, stepy;\n92\t         png_uint_32 y;\n93\t\n94\t         if (png_ptr->interlaced == PNG_INTERLACE_ADAM7)\n95\t         {\n96\t            /* The row may be empty for a short image: */\n97\t            if (PNG_PASS_COLS(width, pass) == 0)\n98\t               continue;\n99\t\n100\t            startx = PNG_PASS_START_COL(pass) * channels;\n101\t            stepx = PNG_PASS_COL_OFFSET(pass) * channels;\n102\t            y = PNG_PASS_START_ROW(pass);\n103\t            stepy = PNG_PASS_ROW_OFFSET(pass);\n104\t         }\n105\t\n106\t         else\n107\t         {\n108\t            y = 0;\n109\t            startx = 0;\n110\t            stepx = channels;\n111\t            stepy = 1;\n112\t         }\n113\t\n114\t         for (; y<heig