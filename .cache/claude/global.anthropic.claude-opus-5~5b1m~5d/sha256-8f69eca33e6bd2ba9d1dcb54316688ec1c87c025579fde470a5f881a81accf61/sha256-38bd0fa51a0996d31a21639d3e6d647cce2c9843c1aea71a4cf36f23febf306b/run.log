 }\n    }\n}\n\n/// The internal structure that `png_image::opaque` points to.\n#[repr(C)]\npub struct png_control {\n    pub png_ptr: png_structp,\n    pub info_ptr: png_infop,\n    pub error_buf: png_voidp,\n\n    pub memory: png_const_bytep,\n    pub size: usize,\n\n    /// bitfield: bit0 = for_write, bit1 = owned_file\n    pub bits: c_uint,\n}\n\nimpl png_control {\n    #[inline]\n    pub fn for_write(&self) -> bool {\n        (self.bits & 1) != 0\n    }\n    #[inline]\n    pub fn set_for_write(&mut self, v: bool) {\n        if v {\n            self.bits |= 1\n        } else {\n            self.bits &= !1\n        }\n    }\n    #[inline]\n    pub fn owned_file(&self) -> bool {\n        (self.bits & 2) != 0\n    }\n    #[inline]\n    pub fn set_owned_file(&mut self, v: bool) {\n        if v {\n            self.bits |= 2\n        } else {\n            self.bits &= !2\n        }\n    }\n}\n\nimpl Default for png_control {\n    fn default() -> Self {\n        unsafe { core::mem::zeroed() }\n    }\n}\n\n/// Convenience: dummy value for `error_buf` (a jmp_buf in C).  The Rust\n/// translation uses unwinding rather than setjmp/longjmp, but the pointer must\n/// still be non-NULL / NULL at the same points as in the C code.\npub const _: () = ();\n\n#[allow(unused)]\nfn _unused(_: *mut c_void) {}\n","structuredPatch":[{"oldStart":441,"oldLines":10,"newStart":441,"newLines":5,"lines":["     }"," }"," ","-/// Convenience: dummy value for `error_buf` (a jmp_buf in C).  The Rust","-/// translation uses unwinding rather than setjmp/longjmp, but the pointer must","-/// still be non-NULL / NULL at the same points as in the C code.","-pub const _: () = ();","-"," #[allow(unused)]"," fn _unused(_: *mut c_void) {}"]}],"userModified":false,"replaceAll":false}}
