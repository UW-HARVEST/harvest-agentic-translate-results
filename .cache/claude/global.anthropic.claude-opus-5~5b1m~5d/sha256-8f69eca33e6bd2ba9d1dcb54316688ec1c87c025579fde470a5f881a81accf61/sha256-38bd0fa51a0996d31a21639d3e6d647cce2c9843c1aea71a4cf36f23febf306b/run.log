 c_int) -> c_int {\n542\t    ((1 & !pass) << (3 - (pass >> 1))) & 7\n543\t}\n544\t#[inline]\n545\tpub const fn png_pass_start_col(pass: c_int) -> c_int {\n546\t    ((1 & pass) << (3 - ((pass + 1) >> 1))) & 7\n547\t}\n548\t#[inline]\n549\tpub const fn png_pass_row_offset(pass: c_int) -> c_int {\n550\t    if pass > 2 {\n551\t        8 >> ((pass - 1) >> 1)\n552\t    } else {\n553\t        8\n554\t    }\n555\t}\n556\t#[inline]\n557\tpub const fn png_pass_col_offset(pass: c_int) -> c_int {\n558\t    1 << ((7 - pass) >> 1)\n559\t}\n560\t#[inline]\n561\tpub const fn png_pass_row_shift(pass: c_int) -> c_int {\n562\t    if pass > 2 {\n563\t        (8 - pass) >> 1\n564\t    } else {\n565\t        3\n566\t    }\n567\t}\n568\t#[inline]\n569\tpub const fn png_pass_col_shift(pass: c_int) -> c_int {\n570\t    if pass > 1 {\n571\t        (7 - pass) >> 1\n572\t    } else {\n573\t        3\n574\t    }\n575\t}\n576\t#[inline]\n577\tpub const fn png_pass_rows(height: png_uint_32, pass: c_int) -> png_uint_32 {\n578\t    (height.wrapping_add(\n579\t        ((1u32 << png_pass_row_shift(pass)) - 1).wrapping_sub(png_pass_start_row(pass) as u32),\n580\t    )) >> png_pass_row_shift(pass)\n581\t}\n582\t#[inline]\n583\tpub const fn png_pass_cols(width: png_uint_32, pass: c_int) -> png_uint_32 {\n584\t    (width.wrapping_add(\n585\t        ((1u32 << png_pass_col_shift(pass)) - 1).wrapping_sub(png_pass_start_col(pass) as u32),\n586\t    )) >> png_pass_col_shift(pass)\n587\t}\n588\t#[inline]\n589\tpub const fn png_row_from_pass_row(y_in: png_uint_32, pass: c_int) -> png_uint_32 {\n590\t    (y_in << png_pass_row_shift(pass)).wrapping_add(png_pass_start_row(pass) as u32)\n591\t}\n592\t#[inline]\n593\tpub const fn png_col_from_pass_col(x_in: png_uint_32, pass: c_int) -> png_uint_32 {\n594\t    (x_in << png_pass_col_shift(pass)).wrapping_add(png_pass_start_col(pass) as u32)\n595\t}\n596\t#[inline]\n597\tpub const fn png_pass_mask(pass: c_int, off: c_int) -> c_uint {\n598\t    ((0x110145AFu32 >> (((7 - off) - pass) << 2)) & 0xF)\n599\t        | ((0x01145AF0u32 >> (((7 - off) - pass) << 2)) & 0xF0)\n600\t}\n601\t#[inline]\n602\tpub const fn png_row_in_interlace_pass(y: png_uint_32, pass: c_int) -> c_uint {\n603\t    (png_pass_mask(pass, 0) >> (y & 7)) & 1\n604\t}\n605\t#[inline]\n606\tpub const fn png_col_in_interlace_pass(x: png_uint_32, pass: c_int) -> c_uint {\n607\t    (png_pass_mask(pass, 1) >> (x & 7)) & 1\n608\t}\n609\t\n610\t/// `png_composite` (NODIV variant, which is what this build uses)\n611\t#[inline]\n612\tpub fn png_composite(fg: png_uint_16, alpha: png_uint_16, bg: png_uint_16) -> png_byte {\n613\t    let temp: png_uint_16 = (fg)\n614\t        .wrapping_mul(alpha)\n615\t        .wrapping_add((bg).wrapping_mul(255u16.wrapping_sub(alpha)))\n616\t        .wrapping_add(128);\n617\t    (((temp as u32 + (temp as u32 >> 8)) >> 8) & 0xff) as png_byte\n618\t}\n619\t"}]},"parent_tool_use_id":"toolu_bdrk_018wqynw38KuR3qPrhdR6c7s","session_id":"bedb3620-db7f-4287-b934-614ec17ac76e","uuid":"a2868fd4-e71d-403f-b406-8b1b1fa4257f","timestamp":"2026-08-31T12:38:44.380Z","subagent_type":"general-purpose","task_description":"Translate pngrutil.c 3227-3953"}
