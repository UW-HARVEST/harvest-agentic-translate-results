te(strm: *mut z_stream, flush: c_int) -> c_int;\n116\t    pub fn inflateEnd(strm: *mut z_stream) -> c_int;\n117\t    pub fn inflateReset(strm: *mut z_stream) -> c_int;\n118\t    pub fn inflateReset2(strm: *mut z_stream, windowBits: c_int) -> c_int;\n119\t    pub fn inflateValidate(strm: *mut z_stream, check: c_int) -> c_int;\n120\t    pub fn crc32(crc: uLong, buf: *const Bytef, len: uInt) -> uLong;\n121\t    pub fn adler32(adler: uLong, buf: *const Bytef, len: uInt) -> uLong;\n122\t}\n123\t\n124\t#[inline]\n125\tpub unsafe fn deflateInit2(\n126\t    strm: *mut z_stream,\n127\t    level: c_int,\n128\t    method: c_int,\n129\t    window_bits: c_int,\n130\t    mem_level: c_int,\n131\t    strategy: c_int,\n132\t) -> c_int {\n133\t    deflateInit2_(\n134\t        strm,\n135\t        level,\n136\t        method,\n137\t        window_bits,\n138\t        mem_level,\n139\t        strategy,\n140\t        zlibVersion(),\n141\t        core::mem::size_of::<z_stream>() as c_int,\n142\t    )\n143\t}\n144\t\n145\t#[inline]\n146\tpub unsafe fn inflateInit(strm: *mut z_stream) -> c_int {\n147\t    inflateInit_(\n148\t        strm,\n149\t        zlibVersion(),\n150\t        core::mem::size_of::<z_stream>() as c_int,\n151\t    )\n152\t}\n153\t\n154\t#[inline]\n155\tpub unsafe fn inflateInit2(strm: *mut z_stream, window_bits: c_int) -> c_int {\n156\t    inflateInit2_(\n157\t        strm,\n158\t        window_bits,\n159\t        zlibVersion(),\n160\t        core::mem::size_of::<z_stream>() as c_int,\n161\t    )\n162\t}\n163\t\n164\t/// ZLIB_VERNUM of the zlib libpng was configured against.  The reference build\n165\t/// used zlib >= 1.2.11.\n166\tpub const ZLIB_VERNUM: c_int = 0x12b0;\n167\t\n168\t/// `(uInt)-1`\n169\tpub const ZLIB_IO_MAX: uInt = uInt::MAX;\n170\t\n171\t#[allow(unused)]\n172\tfn _unused(_: c_long) {}\n173\t"}]},"parent_tool_use_id":"toolu_bdrk_01Ef94Q6WfkLVHxPqb466Btt","session_id":"bedb3620-db7f-4287-b934-614ec17ac76e","uuid":"17f83f87-7e30-4d8f-9f9a-6ef9f9962b3d","tim