{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01MbE1mUDxCVVbJEUa1Yf1uW","type":"tool_result","content":"1\t//! Bindings to the system zlib (libpng does not implement DEFLATE itself).\n2\t#![allow(non_camel_case_types)]\n3\t#![allow(dead_code)]\n4\t\n5\tuse core::ffi::{c_char, c_int, c_long, c_uint, c_ulong, c_void};\n6\t\n7\tpub type Bytef = u8;\n8\tpub type uInt = c_uint;\n9\tpub type uLong = c_ulong;\n10\tpub type voidpf = *mut c_void;\n11\t\n12\tpub type alloc_func = Option<unsafe extern \"C\" fn(voidpf, uInt, uInt) -> voidpf>;\n13\tpub type free_func = Option<unsafe extern \"C\" fn(voidpf, voidpf)>;\n14\t\n15\t#[repr(C)]\n16\tpub struct z_stream {\n17\t    pub next_in: *const Bytef,\n18\t    pub avail_in: uInt,\n19\t    pub total_in: uLong,\n20\t    pub next_out: *mut Bytef,\n21\t    pub avail_out: uInt,\n22\t    pub total_out: uLong,\n23\t    pub msg: *const c_char,\n24\t    pub state: *mut c_void,\n25\t    pub zalloc: alloc_func,\n26\t    pub zfree: free_func,\n27\t    pub opaque: voidpf,\n28\t    pub data_type: c_int,\n29\t    pub adler: uLong,\n30\t    pub reserved: uLong,\n31\t}\n32\t\n33\timpl Default for z_stream {\n34\t    fn default() -> Self {\n35\t        z_stream {\n36\t            next_in: core::ptr::null(),\n37\t            avail_in: 0,\n38\t            total_in: 0,\n39\t            next_out: core::ptr::null_mut(),\n40\t            avail_out: 0,\n41\t            total_out: 0,\n42\t            msg: core::ptr::null(),\n43\t            state: core::ptr::null_mut(),\n44\t            zalloc: None,\n45\t            zfree: None,\n46\t            opaque: core::ptr::null_mut(),\n47\t            data_type: 0,\n48\t            adler: 0,\n49\t            reserved: 0,\n50\t        }\n51\t    }\n52\t}\n53\t\n54\tpub const Z_NO_FLUSH: c_int = 0;\n55\tpub const Z_PARTIAL_FLUSH: c_int = 1;\n56\tpub const Z_SYNC_FLUSH: c_int = 2;\n57\tpub const Z_FULL_FLUSH: c_int = 3;\n58\tpub const Z_FINISH: c_int = 4;\n59\tpub const Z_BLOCK: c_int = 5;\n60\tpub const Z_TREES: c_int = 6;\n61\t\n62\tpub const Z_OK: c_int = 0;\n63\tpub const Z_STREAM_END: c_int = 1;\n64\tpub const Z_NEED_DICT: c_int = 2;\n65\tpub const Z_ERRNO: c_int = -1;\n66\tpub const Z_STREAM_ERROR: c_int = -2;\n67\tpub const Z_DATA_ERROR: c_int = -3;\n68\tpub const Z_MEM_ERROR: c_int = -4;\n69\tpub const Z_BUF_ERROR: c_int = -5;\n70\tpub const Z_VERSION_ERROR: c_int = -6;\n71\t\n72\tpub const Z_NO_COMPRESSION: c_int = 0;\n73\tpub const Z_BEST_SPEED: c_int = 1;\n74\tpub const Z_BEST_COMPRESSION: c_int = 9;\n75\tpub const Z_DEFAULT_COMPRESSION: c_int = -1;\n76\t\n77\tpub const Z_FILTERED: c_int = 1;\n78\tpub const Z_HUFFMAN_ONLY: c_int = 2;\n79\tpub const Z_RLE: c_int = 3;\n80\tpub const Z_FIXED: c_int = 4;\n81\tpub const Z_DEFAULT_STRATEGY: c_int = 0;\n82\t\n83\tpub const Z_BINARY: c_int = 0;\n84\tpub const Z_TEXT: c_int = 1;\n85\tpub const Z_UNKNOWN: c_int = 2;\n86\t\n87\tpub const Z_DEFLATED: c_int = 8;\n88\t\n89\tpub const MAX_WBITS: c_int = 15;\n90\tpub const MAX_MEM_LEVEL: c_int = 9;\n91\t\n92\textern \"C\" {\n93\t    pub fn zlibVersion() -> *const c_char;\n94\t    pub fn deflateInit2_(\n95\t        strm: *mut z_stream,\n96\t        level: c_int,\n97\t        method: c_int,\n98\t        windowBits: c_int,\n99\t        memLevel: c_int,\n100\t        strategy: c_int,\n101\t        version: *const c_char,\n102\t        stream_size: c_int,\n103\t    ) -> c_int;\n104\t    pub fn deflate(strm: *mut z_stream, flush: c_int) -> c_int;\n105\t    pub fn deflateEnd(strm: *mut z_stream) -> c_int;\n106\t    pub fn deflateReset(strm: *mut z_stream) -> c_int;\n107\t    pub fn deflateBound(strm: *mut z_stream, sourceLen: uLong) -> uLong;\n108\t    pub fn inflateInit_(strm: *mut z_stream, version: *const c_char, stream_size: c_int) -> c_int;\n109\t    pub fn inflateInit2_(\n110\t        strm: *mut z_stream,\n111\t        windowBits: c_int,\n112\t        version: *const c_char,\n113\t        stream_size: c_int,\n114\t    ) -> c_int;\n115\t    pub fn inflate(strm: *mut z_stream, flush: c_int) -> c_int;\n116\t    pub fn inflateEnd(strm: *mut z_stream) -> c_int;\n117\t    pub fn inflateReset(strm: *mut z_stream) -> c_int;\n118\t    pub fn inflateReset2(strm: *mut z_stream, windowBits: c_int) -> c_int;\n119\t    pub fn inflateValidate(strm: *mut z_stream, check: c_int) -> c_int;\n120\t    pub fn crc32(crc: uLong, buf: *const Bytef, len: uInt) -> uLong;\n121\t    pub fn adler32(adler: uLong, buf: *const Bytef, len: uInt) -> uLong;\n122\t}\n123\t\n124\t#[inline]\n125\tpub unsafe fn deflateInit2(\n126\t    strm: *mut z_stream,\n127\t    level: c_int,\n128\t    method: c_int,\n129\t    window_bits: c_int,\n130\t    mem_level: c_int,\n131\t    strategy: c_int,\n132\t) -> c_int {\n133\t    deflateInit2_(\n134\t        strm,\n135\t        level,\n136\t        method,\n137\t        window_bits,\n138\t        mem_level,\n139\t        strategy,\n140\t        zlibVersion(),\n141\t        core::mem::size_of::<z_stream>() as c_int,\n142\t    )\n143\t}\n144\t\n145\t#[inline]\n146\tpub unsafe fn inflateInit(strm: *mut z_stream) -> c_int {\n147\t    inflateInit_(\n148\t        strm,\n149\t        zlibVersion(),\n150\t        core::mem::size_of::<z_stream>() as c_int,\n151\t    )\n152\t}\n153\t\n154\t#[inline]\n155\tpub unsafe fn inflateInit2(strm: *mut z_stream, window_bits: c_int) -> c_int {\n156\t    inflateInit2_(\n157\t        strm,\n158\t        window_bits,\n159\t        zlibVersion(),\n160\t        core::mem::size_of::<z_stream>() as c_int,\n161\t    )\n162\t}\n163\t\n164\t/// ZLIB_VERNUM of the zlib libpng was configured against.  The reference build\n165\t/// used zlib >= 1.2.11.\n166\tpub const ZLIB_VERNUM: c_int = 0x12b0;\n167\t\n168\t/// `(uInt)-1`\n169\tpub const ZLIB_IO_MAX: uInt = uInt::MAX;\n170\t\n171\t#[allow(unused)]\n172\tfn _unused(_: c_long) {}\n173\t"}]},"parent_tool_use_id":"toolu_bdrk_01JdyGFsZp1T8YM6tUocoFZs","session_id":"bedb3620-db7f-4287-b934-614ec17ac76e","uuid":"c5054411-c519-499b-9291-95d1aacfdee8","tim