              startx = 0;\n429\t                  stepx = outchannels;\n430\t                  stepy = 1;\n431\t               }\n432\t\n433\t               for (; y<height; y += stepy)\n434\t               {\n435\t                  png_const_uint_16p inrow;\n436\t                  png_uint_16p outrow = first_row + y * row_step;\n437\t                  png_uint_16p row_end = outrow + width * outchannels;\n438\t\n439\t                  /* Read the row, which is packed: */\n440\t                  png_read_row(png_ptr, png_voidcast(png_bytep,\n441\t                      display->local_row), NULL);\n442\t                  inrow = png_voidcast(png_const_uint_16p, display->local_row);\n443\t\n444\t                  /* Now do the pre-multiplication on each pixel in this row.\n445\t                   */\n446\t                  outrow += startx;\n447\t                  for (; outrow < row_end; outrow += stepx)\n448\t                  {\n449\t                     png_uint_32 component = inrow[0];\n450\t                     png_uint_16 alpha = inrow[1];\n451\t\n452\t                     if (alpha > 0) /* else 0 */\n453\t                     {\n454\t                        if (alpha < 65535) /* else just use component */\n455\t                        {\n456\t                           component *= alpha;\n457\t                           component += 32767;\n458\t                           component /= 65535;\n459\t                        }\n460\t                     }\n461\t\n462\t                     else\n463\t                        component = 0;\n464\t\n465\t                     outrow[swap_alpha] = (png_uint_16)component;\n466\t                     if (preserve_alpha != 0)\n467\t                        outrow[1 ^ swap_alpha] = alpha;\n468\t\n469\t                     inrow += 2; /* components and alpha channel */\n470\t                  }\n471\t               }\n472\t            }\n473\t         }\n474\t         break;\n475\t\n476\t#ifdef __GNUC__\n477\t      default:\n478\t         png_error(png_ptr, \"unexpected bit depth\");\n479\t#endif\n480\t   }\n481\t\n482\t   return 1;\n483\t}\n484\t\n485\t/* The guts of png_image_finish_read as a png_safe_execute callback. */\n486\tstatic int\n487\tpng_image_read_direct(png_voidp argument)\n488\t{\n489\t   png_image_read_control *display = png_voidcast(png_image_read_control*,\n490\t       argument);\n491\t   png_imagep image = display->image;\n492\t   png_structrp png_ptr = image->opaque->png_ptr;\n493\t   png_inforp info_ptr = image->opaque->info_ptr;\n494\t\n495\t   png_uint_32 format = image->format;\n496\t   int linear = (format & PNG_FORMAT_FLAG_LINEAR) != 0;\n497\t   int do_local_compose = 0;\n498\t   int do_local_background = 0; /* to avoid double gamma correction bug */\n499\t   int do_local_scale = 0; /* for interlaced 16-to-8 bit conversion */\n500\t   int passes = 0;\n501\t\n502\t   /* Add transforms to ensure the correct output format is produced then check\n503\t    * that the required implementation support is there.  Always expand; always\n504\t    * need 8 bits minimum, no palette and expanded tRNS.\n505\t    */\n506\t   png_set_expand(png_ptr);\n507\t\n508\t   /* Now check the format to see if it was modified. */\n509\t   {\n510\t      png_uint_32 base_format = png_image_format(png_ptr) &\n511\t         ~PNG_FORMAT_FLAG_COLORMAP /* removed by png_set_expand */;\n512\t      png_uint_32 change = format ^ base_format;\n513\t      png_fixed_point output_gamma;\n514\t      int mode; /* alpha mode */\n515\t\n516\t      /* Do this first so that we have a record if rgb to gray is happening. */\n517\t      if ((change & PNG_FORMAT_FLAG_COLOR) != 0)\n518\t      {\n519\t         /* gray<->color transformation required. */\n520\t         if ((format & PNG_FORMAT_FLAG_COLOR) != 0)\n521\t            png_set_gray_to_rgb(png_ptr);\n522\t\n523\t         else\n524\t         {\n525\t            /* libpng can't do both rgb to gray and\n526\t             * background/pre-multiplication if there is also significant gamma\n527\t             * correction, because both operations require linear colors and\n528\t             * the code only supports one transform doing the gamma correction.\n529\t             * Handle this by doing the pre-multiplication or background\n530\t             * operation in this code, if necessary.\n531\t             *\n532\t             * TODO: fix this by rewriting pngrtran.c (!)\n533\t             *\n534\t             * For the moment (given that fixing this in pngrtran.c is an\n535\t             * enormous change) 'do_local_background' is used to indicate that\n536\t             * the problem exists.\n537\t             */\n538\t            if ((base_format & PNG_FORMAT_FLAG_ALPHA) != 0)\n539\t               do_local_background = 1/*maybe*/;\n540\t\n541\t            png_set_rgb_to_gray_fixed(png_ptr, PNG_ERROR_ACTION_NONE,\n542\t                PNG_RGB_TO_GRAY_DEFAULT, PNG_RGB_TO_GRAY_DEFAULT);\n543\t         }\n544\t\n545\t         change &= ~PNG_FORMAT_FLAG_COLOR;\n546\t      }\n547\t\n548\t      /* Set the gamma appropriately, linear for 16-bit input, sRGB otherwise.\n549\t       */\n550\t      {\n551\t         /* This is safe but should no longer be necessary as\n552\t          * png_ptr->default_gamma should have been set after the\n553\t          * info-before-IDAT was read in png_image_read_header.\n554\t          *\n555\t          * TODO: 1.8: remove this and see what happens.\n556\t          */\n557\t         png_fixed_point input_gamma_default;\n558\t\n559\t         if ((base_format & PNG_FORMAT_FLAG_LINEAR) != 0 &&\n560\t             (image->flags & PNG_IMAGE_FLAG_16BIT_sRGB) == 0)\n561\t            input_gamma_default = PNG_GAMMA_LINEAR;\n562\t         else\n563\t            input_gamma_default = PNG_DEFAULT_sRGB;\n564\t\n565\t         /* Call png_set_alpha_mode to set the default for the input gamma; the\n566\t          * output gamma is set by a second call below.\n567\t          */\n568\t         png_set_alpha_mode_fixed(png_ptr, PNG_ALPHA_PNG, input_gamma_default);\n569\t      }\n570\t\n571\t      if (linear != 0)\n572\t      {\n573\t         /* If there *is* an alpha channel in the input it must be multiplied\n574\t          * out; use PNG_ALPHA_STANDARD, otherwise just use PNG_ALPHA_PNG.\n575\t          */\n576\t         if ((base_format & PNG_FORMAT_FLAG_ALPHA) != 0)\n577\t            mode = PNG_ALPHA_STANDARD; /* associated alpha */\n578\t\n579\t         else\n580\t            mode = PNG_ALPHA_PNG;\n581\t\n582\t         output_gamma = PNG_GAMMA_LINEAR;\n583\t      }\n584\t\n585\t      else\n586\t      {\n587\t         mode = PNG_ALPHA_PNG;\n588\t         output_gamma = PNG_DEFAULT_sRGB;\n589\t      }\n590\t\n591\t      if ((change & PNG_FORMAT_FLAG_ASSOCIATED_ALPHA) != 0)\n592\t      {\n593\t         mode = PNG_ALPHA_OPTIMIZED;\n594\t         change &= ~PNG_FORMAT_FLAG_ASSOCIATED_ALPHA;\n595\t      }\n596\t\n597\t      /* If 'do_local_background' is set check for the presence of gamma\n598\t       * correction; this is part of the work-round for the libpng bug\n599\t       * described above.\n600\t       *\n601\t       * TODO: fix libpng and remove this.\n602\t       */\n603\t      if (do_local_background != 0)\n604\t      {\n605\t         png_fixed_point gtest;\n606\t\n607\t         /* This is 'png_gamma_threshold' from pngrtran.c; the test used for\n608\t          * gamma correction, the screen gamma hasn't been set on png_struct\n609\t          * yet; it's set below.  png_struct::gamma, however, is set to the\n610\t          * final value.\n611\t          */\n612\t         if (png_muldiv(&gtest, output_gamma,\n613\t                  png_resolve_file_gamma(png_ptr), PNG_FP_1) != 0 &&\n614\t             png_gamma_significant(gtest) == 0)\n615\t            do_local_background = 0;\n616\t\n617\t         else if (mode == PNG_ALPHA_STANDARD)\n618\t         {\n619\t            do_local_background = 2/*required*/;\n620\t            mode = PNG_ALPHA_PNG; /* prevent libpng doing it */\n621\t         }\n622\t\n623\t         /* else leave as 1 for the checks below */\n624\t      }\n625\t\n626\t      /* If the bit-depth changes then handle that here. */\n627\t      if ((change & PNG_FORMAT_FLAG_LINEAR) != 0)\n628\t      {\n629\t         if (linear != 0 /*16-bit output*/)\n630\t            png_set_expand_16(png_ptr);\n631\t\n632\t         else /* 8-bit output */\n633\t         {\n634\t            png_set_scale_16(png_ptr);\n635\t\n636\t            /* For interlaced images, use local_row buffer to avoid overflow\n637\t             * in png_combine_row() which writes using IHDR bit-depth.\n638\t             */\n639\t            if (png_ptr->interlaced != 0)\n640\t               do_local_scale = 1;\n641\t         }\n642\t\n643\t         change &= ~PNG_FORMAT_FLAG_LINEAR;\n644\t      }\n645\t\n646\t      /* Now the background/alpha channel changes. */\n647\t      if ((change & PNG_FORMAT_FLAG_ALPHA) != 0)\n648\t      {\n649\t         /* Removing an alpha channel requires composition for the 8-bit\n650\t          * formats; for the 16-bit it is already done, above, by the\n651\t          * pre-multiplication and the channel just needs to be stripped.\n652\t          */\n653\t         if ((base_format & PNG_FORMAT_FLAG_ALPHA) != 0)\n654\t         {\n655\t            /* If RGB->gray is happening the alpha channel must be left and the\n656\t             * operation completed locally.\n657\t             *\n658\t             * TODO: fix libpng and remove this.\n659\t             */\n660\t            if (do_local_background != 0)\n661\t               do_local_background = 2/*required*/;\n662\t\n663\t            /* 16-bit output: just remove the channel */\n664\t            else if (linear != 0) /* compose on black (well, pre-multiply) */\n665\t               png_set_strip_alpha(png_ptr);\n666\t\n667\t            /* 8-bit output: do an appropriate compose */\n668\t            else if (display->background != NULL)\n669\t            {\n670\t               png_color_16 c;\n671\t\n672\t               c.index = 0; /*unused*/\n673\t               c.red = display->background->red;\n674\t               c.green = display->background->green;\n675\t               c.blue = display->background->blue;\n676\t               c.gray = display->background->green;\n677\t\n678\t               /* This is always an 8-bit sRGB value, using the 'green' channel\n679\t                * for gray is much better than calculating the luminance here;\n680\t                * we can get off-by-one errors in that calculation relative to\n681\t                * the app expectations and that will show up in transparent\n682\t                * pixels.\n683\t                */\n684\t               png_set_background_fixed(png_ptr, &c,\n685\t                   PNG_BACKGROUND_GAMMA_SCREEN, 0/*need_expand*/,\n686\t                   0/*gamma: not used*/);\n687\t            }\n688\t\n689\t            else /* compose on row: implemented below. */\n690\t            {\n691\t               do_local_compose = 1;\n692\t               /* This leaves the alpha channel in the output, so it has to be\n693\t                * removed by the code below.  Set the encoding to the 'OPTIMIZE'\n694\t                * one so the code only has to hack on the pixels that require\n695\t                * composition.\n696\t                */\n697\t               mode = PNG_ALPHA_OPTIMIZED;\n698\t            }\n699\t         }\n700\t\n701\t         else /* output needs an alpha channel */\n702\t         {\n703\t            /* This is tricky because it happens before the swap operation has\n704\t             * been accomplished; however, the swap does *not* swap the added\n705\t             * alpha channel (weird API), so it must be added in the correct\n706\t             * place.\n707\t             */\n708\t            png_uint_32 filler; /* opaque filler */\n709\t            int where;\n710\t\n711\t            if (linear != 0)\n712\t               filler = 65535;\n713\t\n714\t            else\n715\t               filler = 255;\n716\t\n717\t#ifdef PNG_FORMAT_AFIRST_SUPPORTED\n718\t            if ((format & PNG_FORMAT_FLAG_AFIRST) != 0)\n719\t            {\n720\t               where = PNG_FILLER_BEFORE;\n721\t               change &= ~PNG_FORMAT_FLAG_AFIRST;\n722\t            }\n723\t\n724\t            else\n725\t#endif\n726\t            where = PNG_FILLER_AFTER;\n727\t\n728\t            png_set_add_alpha(png_ptr, filler, where);\n729\t         }\n730\t\n731\t         /* This stops the (irrelevant) call to swap_alpha below. */\n732\t         change &= ~PNG_FORMAT_FLAG_ALPHA;\n733\t      }\n734\t\n735\t      /* Now set the alpha mode correctly; this is always done, even if there is\n736\t       * no alpha channel in either the input or the output because it correctly\n737\t       * sets the output gamma.\n738\t       */\n739\t      png_set_alpha_mode_fixed(png_ptr, mode, output_gamma);\n740\t\n741\t#     ifdef PNG_FORMAT_BGR_SUPPORTED\n742\t         if ((change & PNG_FORMAT_FLAG_BGR) != 0)\n743\t         {\n744\t            /* Check only the output format; PNG is never BGR; don't do this if\n745\t             * the output is gray, but fix up the 'format' value in that case.\n746\t             */\n747\t            if ((format & PNG_FORMAT_FLAG_COLOR) != 0)\n748\t               png_set_bgr(png_ptr);\n749\t\n750\t            else\n751\t               format &= ~PNG_FORMAT_FLAG_BGR;\n752\t\n753\t            change &= ~PNG_FORMAT_FLAG_BGR;\n754\t         }\n755\t#     endif\n756\t\n757\t#     ifdef PNG_FORMAT_AFIRST_SUPPORTED\n758\t         if ((change & PNG_FORMAT_FLAG_AFIRST) != 0)\n759\t         {\n760\t            /* Only relevant if there is an alpha channel - it's particularly\n761\t             * important to handle this correctly because do_local_compose may\n762\t             * be set above and then libpng will keep the alpha channel for this\n763\t             * code to remove.\n764\t             */\n765\t            if ((format & PNG_FORMAT_FLAG_ALPHA) != 0)\n766\t            {\n767\t               /* Disable this if doing a local background,\n768\t                * TODO: remove this when local background is no longer required.\n769\t                */\n770\t               if (do_local_background != 2)\n771\t                  png_set_swap_alpha(png_ptr);\n772\t            }\n773\t\n774\t            else\n775\t               format &= ~PNG_FORMAT_FLAG_AFIRST;\n776\t\n777\t            change &= ~PNG_FORMAT_FLAG_AFIRST;\n778\t         }\n779\t#     endif\n780\t\n781\t      /* If the *output* is 16-bit then we need to check for a byte-swap on this\n782\t       * architecture.\n783\t       */\n784\t      if (linear != 0)\n785\t      {\n786\t         png_uint_16 le = 0x0001;\n787\t\n788\t         if ((*(png_const_bytep) & le) != 0)\n789\t            png_set_swap(png_ptr);\n790\t      }\n791\t\n792\t      /* If change is not now 0 some transformation is missing - error out. */\n793\t      if (change != 0)\n794\t         png_error(png_ptr, \"png_read_image: unsupported transformation\");\n795\t   }\n796\t\n797\t   PNG_SKIP_CHUNKS(png_ptr);\n798\t\n799\t   /* Update the 'info' structure and make sure the result is as required; first\n800\t    * make sure to turn on the interlace handling if it will be required\n801\t    * (because it can't be turned on *after* the call to png_read_update_info!)\n802\t    *\n803\t    * TODO: remove the do_local_background fixup below.\n804\t    */\n805\t   if (do_local_compose == 0 && do_local_background != 2)\n806\t      passes = png_set_interlace_handling(png_ptr);\n807\t\n808\t   png_read_update_info(png_ptr, info_ptr);\n809\t\n810\t   {\n811\t      png_uint_32 info_format = 0;\n812\t\n813\t      if ((info_ptr->color_type & PNG_COLOR_MASK_COLOR) != 0)\n814\t         info_format |= PNG_FORMAT_FLAG_COLOR;\n815\t\n816\t      if ((info_ptr->color_type & PNG_COLOR_MASK_ALPHA) != 0)\n817\t      {\n818\t         /* do_local_compose removes this channel below. */\n819\t         if (do_local_compose == 0)\n820\t         {\n821\t            /* do_local_background does the same if required. */\n822\t            if (do_local_background != 2 ||\n823\t               (format & PNG_FORMAT_FLAG_ALPHA) != 0)\n824\t               info_format |= PNG_FORMAT_FLAG_ALPHA;\n825\t         }\n826\t      }\n827\t\n828\t      else if (do_local_compose != 0) /* internal error */\n829\t         png_error(png_ptr, \"png_image_read: alpha channel lost\");\n830\t\n831\t      if ((format & PNG_FORMAT_FLAG_ASSOCIATED_ALPHA) != 0) {\n832\t         info_format |= PNG_FORMAT_FLAG_ASSOCIATED_ALPHA;\n833\t      }\n834\t\n835\t      if (info_ptr->bit_depth == 16)\n836\t         info_format |= PNG_FORMAT_FLAG_LINEAR;\n837\t\n838\t#ifdef PNG_FORMAT_BGR_SUPPORTED\n839\t      if ((png_ptr->transformations & PNG_BGR) != 0)\n840\t         info_format |= PNG_FORMAT_FLAG_BGR;\n841\t#endif\n842\t\n843\t#ifdef PNG_FORMAT_AFIRST_SUPPORTED\n844\t         if (do_local_background == 2)\n845\t         {\n846\t            if ((format & PNG_FORMAT_FLAG_AFIRST) != 0)\n847\t               info_format |= PNG_FORMAT_FLAG_AFIRST;\n848\t         }\n849\t\n850\t         if ((png_ptr->transformations & PNG_SWAP_ALPHA) != 0 ||\n851\t            ((png_ptr->transformations & PNG_ADD_ALPHA) != 0 &&\n852\t            (png_ptr->flags & PNG_FLAG_FILLER_AFTER) == 0))\n853\t         {\n854\t            if (do_local_background == 2)\n855\t               png_error(png_ptr, \"unexpected alpha swap transformation\");\n856\t\n857\t            info_format |= PNG_FORMAT_FLAG_AFIRST;\n858\t         }\n859\t#     endif\n860\t\n861\t      /* This is actually an internal error. */\n862\t      if (info_format != format)\n863\t         png_error(png_ptr, \"png_read_image: invalid transformations\");\n864\t   }\n865\t\n866\t   /* Now read the rows.  If do_local_compose is set then it is necessary to use\n867\t    * a local row buffer.  The output will be GA, RGBA or BGRA and must be\n868\t    * converted to G, RGB or BGR as appropriate.  The 'local_row' member of the\n869\t    * display acts as a flag.\n870\t    */\n871\t   {\n872\t      png_voidp first_row = display->buffer;\n873\t      ptrdiff_t row_step = display->row_stride;\n874\t\n875\t      if (linear != 0)\n876\t         row_step *= 2;\n877\t\n878\t      /* The following adjustment is to ensure that calculations are correct,\n879\t       * regardless whether row_step is positive or negative.\n880\t       */\n881\t      if (row_step < 0)\n882\t      {\n883\t         char *ptr = png_voidcast(char*, first_row);\n884\t         ptr += (image->height - 1) * (-row_step);\n885\t         first_row = png_voidcast(png_voidp, ptr);\n886\t      }\n887\t\n888\t      display->first_row = first_row;\n889\t      display->row_step = row_step;\n890\t   }\n891\t\n892\t   if (do_local_compose != 0)\n893\t   {\n894\t      int result;\n895\t      png_voidp row = png_malloc(png_ptr, png_get_rowbytes(png_ptr, info_ptr));\n896\t\n897\t      display->local_row = row;\n898\t      result = png_safe_execute(image, png_image_read_composite, display);\n899\t      display->local_row = NULL;\n900\t      png_free(png_ptr, row);\n901\t\n902\t      return result;\n903\t   }\n904\t\n905\t   else if (do_local_background == 2)\n906\t   {\n907\t      int result;\n908\t      png_voidp row = png_malloc(png_ptr, png_get_rowbytes(png_ptr, info_ptr));\n909\t\n910\t      display->local_row = row;\n911\t      result = png_safe_execute(image, png_image_read_background, display);\n912\t      display->local_row = NULL;\n913\t      png_free(png_ptr, row);\n914\t\n915\t      return result;\n916\t   }\n917\t\n918\t   else if (do_local_scale != 0)\n919\t   {\n920\t      /* For interlaced 16-to-8 conversion, use an intermediate row buffer\n921\t       * to avoid buffer overflows in png_combine_row. The local_row is sized\n922\t       * for the transformed (8-bit) output, preventing the overflow that would\n923\t       * occur if png_combine_row wrote 16-bit data directly to the user buffer.\n924\t       */\n925\t      int result;\n926\t      png_voidp row = png_malloc(png_ptr, png_get_rowbytes(png_ptr, info_ptr));\n927\t\n928\t      display->local_row = row;\n929\t      result = png_safe_execute(image, png_image_read_direct_scaled, display);\n930\t      display->local_row = NULL;\n931\t      png_free(png_ptr, row);\n932\t\n933\t      return result;\n934\t   }\n935\t\n936\t   else\n937\t   {\n938\t      ptrdiff_t row_step = display->row_step;\n939\t\n940\t      while (--passes >= 0)\n941\t      {\n942\t         png_uint_32 y = image->height;\n943\t         png_bytep row = png_voidcast(png_bytep, display->first_row);\n944\t\n945\t         for (; y > 0; --y)\n946\t         {\n947\t            png_read_row(png_ptr, row, NULL);\n948\t            row += row_step;\n949\t         }\n950\t      }\n951\t\n952\t      return 1;\n953\t   }\n954\t}\n955\t\n956\tint PNGAPI\n957\tpng_image_finish_read(png_imagep image, png_const_colorp background,\n958\t    void *buffer, png_int_32 row_stride, void *colormap)\n959\t{\n960\t   if (image != NULL && image->version == PNG_IMAGE_VERSION)\n961\t   {\n962\t      /* Check for row_stride overflow.  This check is not performed on the\n963\t       * original PNG format because it may not occur in the output PNG format\n964\t       * and libpng deals with the issues of reading the original.\n965\t       */\n966\t      unsigned int channels = PNG_IMAGE_PIXEL_CHANNELS(image->format);\n967\t\n968\t      /* The following checks just the 'row_stride' calculation to ensure it\n969\t       * fits in a signed 32-bit value.  Because channels/components can be\n970\t       * either 1 or 2 bytes in size the length of a row can still overflow 32\n971\t       * bits; this is just to verify that the 'row_stride' argument can be\n972\t       * represented.\n973\t       */\n974\t      if (image->width <= 0x7fffffffU/channels) /* no overflow */\n975\t      {\n976\t         png_uint_32 check;\n977\t         png_uint_32 png_row_stride = image->width * channels;\n978\t\n979\t         if (row_stride == 0)\n980\t            row_stride = (png_int_32)/*SAFE*/png_row_stride;\n981\t\n982\t         if (row_stride < 0)\n983\t            check = -(png_uint_32)row_stride;\n984\t\n985\t         else\n986\t            check = (png_uint_32)row_stride;\n987\t\n988\t         /* This verifies 'check', the absolute value of the actual stride\n989\t          * passed in and detects overflow in the application calculation (i.e.\n990\t          * if the app did actually pass in a non-zero 'row_stride'.\n991\t          */\n992\t         if (image->opaque != NULL && buffer != NULL && check >= png_row_stride)\n993\t         {\n994\t            /* Now check for overflow of the image buffer calculation; this\n995\t             * limits the whole image size to 32 bits for API compatibility with\n996\t             * the current, 32-bit, PNG_IMAGE_BUFFER_SIZE macro.\n997\t             *\n998\t             * The PNG_IMAGE_BUFFER_SIZE macro is:\n999\t             *\n1000\t             *    (PNG_IMAGE_PIXEL_COMPONENT_SIZE(fmt)*height*(row_stride))\n1001\t             *\n1002\t             * And the component size is always 1 or 2, so make sure that the\n1003\t             * number of *bytes* that the application is saying are available\n1004\t             * does actually fit into a 32-bit number.\n1005\t             *\n1006\t             * NOTE: this will be changed in 1.7 because PNG_IMAGE_BUFFER_SIZE\n1007\t             * will be changed to use png_alloc_size_t; bigger images can be\n1008\t             * accommodated on 64-bit systems.\n1009\t             */\n1010\t            if (image->height <=\n1011\t                0xffffffffU/PNG_IMAGE_PIXEL_COMPONENT_SIZE(image->format)/check)\n1012\t            {\n1013\t               if ((image->format & PNG_FORMAT_FLAG_COLORMAP) == 0 ||\n1014\t                  (image->colormap_entries > 0 && colormap != NULL))\n1015\t               {\n1016\t                  int result;\n1017\t   