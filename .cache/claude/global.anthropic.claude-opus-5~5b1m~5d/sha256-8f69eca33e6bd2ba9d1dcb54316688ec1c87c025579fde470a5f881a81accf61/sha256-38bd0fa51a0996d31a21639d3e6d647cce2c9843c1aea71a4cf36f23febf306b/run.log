 delta\n262\t}\n263\t\n264\t#[inline]\n265\tpub fn PNG_COLOR_DIST(c1: png_color, c2: png_color) -> c_int {\n266\t    ((c1.red as c_int) - (c2.red as c_int)).abs()\n267\t        + ((c1.green as c_int) - (c2.green as c_int)).abs()\n268\t        + ((c1.blue as c_int) - (c2.blue as c_int)).abs()\n269\t}\n270\t\n271\t/// `png_float(png_ptr, fixed, s)`\n272\t#[inline]\n273\tpub fn png_float_of(fixed: png_fixed_point) -> f64 {\n274\t    0.00001f64 * (fixed as f64)\n275\t}\n276\t\n277\t// --- warning / number formatting -------------------------------------------\n278\tpub const PNG_NUMBER_BUFFER_SIZE: usize = 24;\n279\tpub const PNG_NUMBER_FORMAT_u: c_int = 1;\n280\tpub const PNG_NUMBER_FORMAT_02u: c_int = 2;\n281\tpub const PNG_NUMBER_FORMAT_d: c_int = 1;\n282\tpub const PNG_NUMBER_FORMAT_02d: c_int = 2;\n283\tpub const PNG_NUMBER_FORMAT_x: c_int = 3;\n284\tpub const PNG_NUMBER_FORMAT_02x: c_int = 4;\n285\tpub const PNG_NUMBER_FORMAT_fixed: c_int = 5;\n286\t\n287\tpub const PNG_WARNING_PARAMETER_SIZE: usize = 32;\n288\tpub const PNG_WARNING_PARAMETER_COUNT: usize = 8;\n289\tpub type png_warning_parameters = [[core::ffi::c_char; PNG_WARNING_PARAMETER_SIZE];\n290\t    PNG_WARNING_PARAMETER_COUNT];\n291\t\n292\tpub const PNG_CHUNK_WARNING: c_int = 0;\n293\tpub const PNG_CHUNK_WRITE_ERROR: c_int = 1;\n294\tpub const PNG_CHUNK_ERROR: c_int = 2;\n295\t\n296\tpub const PNG_UNEXPECTED_ZLIB_RETURN: c_int = -7;\n297\t\n298\t// --- ASCII <-> FP parser states -------------------------------------------\n299\tpub const PNG_sCAL_MAX_DIGITS: usize = PNG_sCAL_PRECISION + 1 + 1 + 10;\n300\t\n301\tpub const PNG_FP_INTEGER: c_int = 0;\n302\tpub const PNG_FP_FRACTION: c_int = 1;\n303\tpub const PNG_FP_EXPONENT: c_int = 2;\n304\tpub const PNG_FP_STATE: c_int = 3;\n305\tpub const PNG_FP_SAW_SIGN: c_int = 4;\n306\tpub const PNG_FP_SAW_DIGIT: c_int = 8;\n307\tpub const PNG_FP_SAW_DOT: c_int = 16;\n308\tpub const PNG_FP_SAW_E: c_int = 32;\n309\tpub const PNG_FP_SAW_ANY: c_int = 60;\n310\tpub cons