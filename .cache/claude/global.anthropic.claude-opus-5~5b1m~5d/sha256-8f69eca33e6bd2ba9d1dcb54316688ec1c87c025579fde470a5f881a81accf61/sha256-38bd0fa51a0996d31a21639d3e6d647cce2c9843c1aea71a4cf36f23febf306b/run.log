{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_016btRmQxUdXwF3cVWNgcAfr","type":"tool_result","content":"1\t//! pngtrans.c lines 1-895: transforms the data in a row (used by both readers\n2\t//! and writers)\n3\tuse crate::prelude::*;\n4\tuse core::ffi::{c_char, c_double, c_int, c_long, c_uint, c_ulong, c_void};\n5\t\n6\t/* Turn on BGR-to-RGB mapping */\n7\t#[unsafe(no_mangle)]\n8\tpub unsafe extern \"C-unwind\" fn png_set_bgr(png_ptr: png_structrp) {\n9\t    if png_ptr.is_null() {\n10\t        return;\n11\t    }\n12\t\n13\t    (*png_ptr).transformations |= PNG_BGR;\n14\t}\n15\t\n16\t/* Turn on 16-bit byte swapping */\n17\t#[unsafe(no_mangle)]\n18\tpub unsafe extern \"C-unwind\" fn png_set_swap(png_ptr: png_structrp) {\n19\t    if png_ptr.is_null() {\n20\t        return;\n21\t    }\n22\t\n23\t    if (*png_ptr).bit_depth == 16 {\n24\t        (*png_ptr).transformations |= PNG_SWAP_BYTES;\n25\t    }\n26\t}\n27\t\n28\t/* Turn on pixel packing */\n29\t#[unsafe(no_mangle)]\n30\tpub unsafe extern \"C-unwind\" fn png_set_packing(png_ptr: png_structrp) {\n31\t    if png_ptr.is_null() {\n32\t        return;\n33\t    }\n34\t\n35\t    if (*png_ptr).bit_depth < 8 {\n36\t        (*png_ptr).transformations |= PNG_PACK;\n37\t        (*png_ptr).usr_bit_depth = 8;\n38\t    }\n39\t}\n40\t\n41\t/* Turn on packed pixel swapping */\n42\t#[unsafe(no_mangle)]\n43\tpub unsafe extern \"C-unwind\" fn png_set_packswap(png_ptr: png_structrp) {\n44\t    if png_ptr.is_null() {\n45\t        return;\n46\t    }\n47\t\n48\t    if (*png_ptr).bit_depth < 8 {\n49\t        (*png_ptr).transformations |= PNG_PACKSWAP;\n50\t    }\n51\t}\n52\t\n53\t#[unsafe(no_mangle)]\n54\tpub unsafe extern \"C-unwind\" fn png_set_shift(png_ptr: png_structrp, true_bits: png_const_color_8p) {\n55\t    if png_ptr.is_null() || true_bits.is_null() {\n56\t        return;\n57\t    }\n58\t\n59\t    /* Check the shift values before passing them on to png_do_shift. */\n60\t    {\n61\t        let bit_depth: png_byte = (*png_ptr).bit_depth;\n62\t        let mut invalid: c_int = 0;\n63\t\n64\t        if ((*png_ptr).color_type as c_int & PNG_COLOR_MASK_COLOR) != 0 {\n65\t            if (*true_bits).red == 0\n66\t                || (*true_bits).red > bit_depth\n67\t                || (*true_bits).green == 0\n68\t                || (*true_bits).green > bit_depth\n69\t                || (*true_bits).blue == 0\n70\t                || (*true_bits).blue > bit_depth\n71\t            {\n72\t                invalid = 1;\n73\t            }\n74\t        } else {\n75\t            if (*true_bits).gray == 0 || (*true_bits).gray > bit_depth {\n76\t                invalid = 1;\n77\t            }\n78\t        }\n79\t\n80\t        if ((*png_ptr).color_type as c_int & PNG_COLOR_MASK_ALPHA) != 0\n81\t            && ((*true_bits).alpha == 0 || (*true_bits).alpha > bit_depth)\n82\t        {\n83\t            invalid = 1;\n84\t        }\n85\t\n86\t        if invalid != 0 {\n87\t            png_app_error(png_ptr, c\"png_set_shift: invalid shift values\".as_ptr());\n88\t            return;\n89\t        }\n90\t    }\n91\t\n92\t    (*png_ptr).transformations |= PNG_SHIFT;\n93\t    (*png_ptr).shift = *true_bits;\n94\t}\n95\t\n96\t#[unsafe(no_mangle)]\n97\tpub unsafe extern \"C-unwind\" fn png_set_interlace_handling(png_ptr: png_structrp) -> c_int {\n98\t    if !png_ptr.is_null() && (*png_ptr).interlaced != 0 {\n99\t        (*png_ptr).transformations |= PNG_INTERLACE;\n100\t        return 7;\n101\t    }\n102\t\n103\t    1\n104\t}\n105\t\n106\t/* Add a filler byte on read, or remove a filler or alpha byte on write.\n107\t * The filler type has changed in v0.95 to allow future 2-byte fillers\n108\t * for 48-bit input data, as well as to avoid problems with some compilers\n109\t * that don't like bytes as parameters.\n110\t */\n111\t#[unsafe(no_mangle)]\n112\tpub unsafe extern \"C-unwind\" fn png_set_filler(\n113\t    png_ptr: png_structrp,\n114\t    filler: png_uint_32,\n115\t    filler_loc: c_int,\n116\t) {\n117\t    if png_ptr.is_null() {\n118\t        return;\n119\t    }\n120\t\n121\t    /* In libpng 1.6 it is possible to determine whether this is a read or write\n122\t     * operation and therefore to do more checking here for a valid call.\n123\t     */\n124\t    if ((*png_ptr).mode & PNG_IS_READ_STRUCT) != 0 {\n125\t        /* On read png_set_filler is always valid, regardless of the base PNG\n126\t         * format, because other transformations can give a format where the\n127\t         * filler code can execute (basically an 8 or 16-bit component RGB or G\n128\t         * format.)\n129\t         *\n130\t         * NOTE: usr_channels is not used by the read code!  (This has led to\n131\t         * confusion in the past.)  The filler is only used in the read code.\n132\t         */\n133\t        (*png_ptr).filler = filler as png_uint_16;\n134\t    } else\n135\t    /* write */\n136\t    {\n137\t        /* On write the usr_channels parameter must be set correctly at the\n138\t         * start to record the number of channels in the app-supplied data.\n139\t         */\n140\t        match (*png_ptr).color_type as c_int {\n141\t            PNG_COLOR_TYPE_RGB => {\n142\t                (*png_ptr).usr_channels = 4;\n143\t            }\n144\t\n145\t            PNG_COLOR_TYPE_GRAY => {\n146\t                if (*png_ptr).bit_depth >= 8 {\n147\t                    (*png_ptr).usr_channels = 2;\n148\t                } else {\n149\t                    /* There simply isn't any code in libpng to strip out bits\n150\t                     * from bytes when the components are less than a byte in\n151\t                     * size!\n152\t                     */\n153\t                    png_app_error(\n154\t                        png_ptr,\n155\t                        c\"png_set_filler is invalid for low bit depth gray output\".as_ptr(),\n156\t                    );\n157\t                    return;\n158\t                }\n159\t            }\n160\t\n161\t            _