           * the application has not set specific save or ignore for this\n2825\t             * chunk or global save or ignore.\n2826\t             */\n2827\t            if (keep < PNG_HANDLE_CHUNK_IF_SAFE)\n2828\t            {\n2829\t#              ifdef PNG_SET_UNKNOWN_CHUNKS_SUPPORTED\n2830\t               if (png_ptr->unknown_default < PNG_HANDLE_CHUNK_IF_SAFE)\n2831\t               {\n2832\t                  png_chunk_warning(png_ptr, \"Saving unknown chunk:\");\n2833\t                  png_app_warning(png_ptr,\n2834\t                      \"forcing save of an unhandled chunk;\"\n2835\t                      \" please call png_set_keep_unknown_chunks\");\n2836\t                      /* with keep = PNG_HANDLE_CHUNK_IF_SAFE */\n2837\t               }\n2838\t#              endif\n2839\t               keep = PNG_HANDLE_CHUNK_IF_SAFE;\n2840\t            }\n2841\t         }\n2842\t\n2843\t         else /* chunk was handled */\n2844\t         {\n2845\t            handled = handled_ok;\n2846\t            /* Critical chunks can be safely discarded at this point. */\n2847\t            keep = PNG_HANDLE_CHUNK_NEVER;\n2848\t         }\n2849\t      }\n2850\t\n2851\t      else\n2852\t         keep = PNG_HANDLE_CHUNK_NEVER; /* insufficient memory */\n2853\t   }\n2854\t\n2855\t   else\n2856\t   /* Use the SAVE_UNKNOWN_CHUNKS code or skip the chunk */\n2857\t#  endif /* READ_USER_CHUNKS */\n2858\t\n2859\t#  ifdef PNG_SAVE_UNKNOWN_CHUNKS_SUPPORTED\n2860\t   {\n2861\t      /* keep is currently just the per-chunk setting, if there was no\n2862\t       * setting change it to the global default now (not that this may\n2863\t       * still be AS_DEFAULT) then obtain the cache of the chunk if required,\n2864\t       * if not simply skip the chunk.\n2865\t       */\n2866\t      if (keep == PNG_HANDLE_CHUNK_AS_DEFAULT)\n2867\t         keep = png_ptr->unknown_default;\n2868\t\n2869\t      if (keep == PNG_HANDLE_CHUNK_ALWAYS ||\n2870\t         (keep == PNG_HANDLE_CHUNK_IF_SAFE &&\n2871\t  