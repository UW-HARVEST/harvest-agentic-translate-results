(--dp) = *(--sp);\n2877\t               *(--dp) = *(--sp);\n2878\t            }\n2879\t            *(--dp) = lo_filler;\n2880\t            *(--dp) = hi_filler;\n2881\t            row_info->channels = 2;\n2882\t            row_info->pixel_depth = 32;\n2883\t            row_info->rowbytes = (size_t)row_width * 4;\n2884\t         }\n2885\t\n2886\t         else\n2887\t         {\n2888\t            /* This changes the data from GG to XXGG */\n2889\t            png_bytep sp = row + (size_t)row_width * 2;\n2890\t            png_bytep dp = sp  + (size_t)row_width * 2;\n2891\t            for (i = 0; i < row_width; i++)\n2892\t            {\n2893\t               *(--dp) = *(--sp);\n2894\t               *(--dp) = *(--sp);\n2895\t               *(--dp) = lo_filler;\n2896\t               *(--dp) = hi_filler;\n2897\t            }\n2898\t            row_info->channels = 2;\n2899\t            row_info->pixel_depth = 32;\n2900\t            row_info->rowbytes = (size_t)row_width * 4;\n2901\t         }\n2902\t      }\n2903\t#endif\n2904\t   } /* COLOR_TYPE == GRAY */\n2905\t   else if (row_info->color_type == PNG_COLOR_TYPE_RGB)\n2906\t   {\n2907\t      if (row_info->bit_depth == 8)\n2908\t      {\n2909\t         if ((flags & PNG_FLAG_FILLER_AFTER) != 0)\n2910\t         {\n2911\t            /* This changes the data from RGB to RGBX */\n2912\t            png_bytep sp = row + (size_t)row_width * 3;\n2913\t            png_bytep dp = sp  + (size_t)row_width;\n2914\t            for (i = 1; i < row_width; i++)\n2915\t            {\n2916\t               *(--dp) = lo_filler;\n2917\t               *(--dp) = *(--sp);\n2918\t               *(--dp) = *(--sp);\n2919\t               *(--dp) = *(--sp);\n2920\t            }\n2921\t            *(--dp) = lo_filler;\n2922\t            row_info->channels = 4;\n2923\t            row_info->pixel_depth = 32;\n2924\t            row_info->rowbytes = (size_t)row_width * 4;\n2925\t         }\n2926\t\n2927\t         else\n2928\t         {\n2929\t            /* This changes the data from RGB to XRGB */\n2930\t            png_bytep sp = row + (size_t)row_width * 3;\n2931\t            png_bytep dp = sp + (size_t)row_width;\n2932\t            for (i = 0; i < row_width; i++)\n2933\t            {\n2934\t               *(--dp) = *(--sp);\n2935\t               *(--dp) = *(--sp);\n2936\t               *(--dp) = *(--sp);\n2937\t               *(--dp) = lo_filler;\n2938\t            }\n2939\t            row_info->channels = 4;\n2940\t            row_info->pixel_depth = 32;\n2941\t            row_info->rowbytes = (size_t)row_width * 4;\n2942\t         }\n2943\t      }\n2944\t\n2945\t#ifdef PNG_READ_16BIT_SUPPORTED\n2946\t      else if (row_info->bit_depth == 16)\n2947\t      {\n2948\t         if ((flags & PNG_FLAG_FILLER_AFTER) != 0)\n2949\t         {\n2950\t            /* This changes the data from RRGGBB to RRGGBBXX */\n2951\t            png_bytep sp = row + (size_t)row_width * 6;\n2952\t            png_bytep dp = sp  + (size_t)row_width * 2;\n2953\t            for (i = 1; i < row_width; i++)\n2954\t            {\n2955\t               *(--dp) = lo_filler;\n2956\t               *(--dp) = hi_filler;\n2957\t               *(--dp) = *(--sp);\n2958\t               *(--dp) = *(--sp);\n2959\t               *(--dp) = *(--sp);\n2960\t               *(--dp) = *(--sp);\n2961\t               *(--dp) = *(--sp);\n2962\t               *(--dp) = *(--sp);\n2963\t            }\n2964\t            *(--dp) = lo_filler;\n2965\t            *(--dp) = hi_filler;\n2966\t            row_info->channels = 4;\n2967\t            row_info->pixel_depth = 64;\n2968\t            row_info->rowbytes = (size_t)row_width * 8;\n2969\t         }\n2970\t\n2971\t         else\n2972\t         {\n2973\t            /* This changes the data from RRGGBB to XXRRGGBB */\n2974\t            png_bytep sp = row + (size_t)row_width * 6;\n2975\t            png_bytep dp = sp  + (size_t)row_width * 2;\n2976\t            for (i = 0; i < row_width; i++)\n2977\t            {\n2978\t               *(--dp) = *(--sp);\n2979\t               *(--dp) = *(--sp);\n2980\t               *(--dp) = *(--sp);\n2981\t               *(--dp) = *(--sp);\n2982\t               *(--dp) = *(--sp);\n2983\t               *(--dp) = *(--sp);\n2984\t               *(--dp) = lo_filler;\n2985\t               *(--dp) = hi_filler;\n2986\t            }\n2987\t\n2988\t            row_info->channels = 4;\n2989\t            row_info->pixel_depth = 64;\n2990\t            row_info->rowbytes = (size_t)row_width * 8;\n2991\t         }\n2992\t      }\n2993\t#endif\n2994\t   } /* COLOR_TYPE == RGB */\n2995\t}\n2996\t#endif\n2997\t\n2998\t#ifdef PNG_READ_GRAY_TO_RGB_SUPPORTED\n2999\t/* Expand grayscale files to RGB, with or without alpha */\n3000\tstatic void\n3001\tpng_do_gray_to_rgb(png_row_infop row_info, png_bytep row)\n3002\t{\n3003\t   png_uint_32 i;\n3004\t   png_uint_32 row_width = row_info->width;\n3005\t\n3006\t   png_debug(1, \"in png_do_gray_to_rgb\");\n3007\t\n3008\t   if (row_info->bit_depth >= 8 &&\n3009\t       (row_info->color_type & PNG_COLOR_MASK_COLOR) == 0)\n3010\t   {\n3011\t      if (row_info->color_type == PNG_COLOR_TYPE_GRAY)\n3012\t      {\n3013\t         if (row_info->bit_depth == 8)\n3014\t         {\n3015\t            /* This changes G to RGB */\n3016\t            png_bytep sp = row + (size_t)row_width - 1;\n3017\t            png_bytep dp = sp  + (size_t)row_width * 2;\n3018\t            for (i = 0; i < row_width; i++)\n3019\t            {\n3020\t               *(dp--) = *sp;\n3021\t               *(dp--) = *sp;\n3022\t               *(dp--) = *(sp--);\n3023\t            }\n3024\t         }\n3025\t\n3026\t         else\n3027\t         {\n3028\t            /* This changes GG to RRGGBB */\n3029\t            png_bytep sp = row + (size_t)row_width * 2 - 1;\n3030\t            png_bytep dp = sp  + (size_t)row_width * 4;\n3031\t            for (i = 0; i < row_width; i++)\n3032\t            {\n3033\t               *(dp--) = *sp;\n3034\t               *(dp--) = *(sp - 1);\n3035\t               *(dp--) = *sp;\n3036\t               *(dp--) = *(sp - 1);\n3037\t               *(dp--) = *(sp--);\n3038\t               *(dp--) = *(sp--);\n3039\t            }\n3040\t         }\n3041\t      }\n3042\t\n3043\t      else if (row_info->color_type == PNG_COLOR_TYPE_GRAY_ALPHA)\n3044\t      {\n3045\t         if (row_info->bit_depth == 8)\n3046\t         {\n3047\t            /* This changes GA to RGBA */\n3048\t            png_bytep sp = row + (size_t)row_width * 2 - 1;\n3049\t            png_bytep dp = sp  + (size_t)row_width * 2;\n3050\t            for (i = 0; i < row_width; i++)\n3051\t            {\n3052\t               *(dp--) = *(sp--);\n3053\t               *(dp--) = *sp;\n3054\t               *(dp--) = *sp;\n3055\t               *(dp--) = *(sp--);\n3056\t            }\n3057\t         }\n3058\t\n3059\t         else\n3060\t         {\n3061\t            /* This changes GGAA to RRGGBBAA */\n3062\t            png_bytep sp = row + (size_t)row_width * 4 - 1;\n3063\t            png_bytep dp = sp  + (size_t)row_width * 4;\n3064\t            for (i = 0; i < row_width; i++)\n3065\t            {\n3066\t               *(dp--) = *(sp--);\n3067\t               *(dp--) = *(sp--);\n3068\t               *(dp--) = *sp;\n3069\t               *(dp--) = *(sp - 1);\n3070\t               *(dp--) = *sp;\n3071\t               *(dp--) = *(sp - 1);\n3072\t               *(dp--) = *(sp--);\n3073\t               *(dp--) = *(sp--);\n3074\t            }\n3075\t         }\n3076\t      }\n3077\t      row_info->channels = (png_byte)(row_info->channels + 2);\n3078\t      row_info->color_type |= PNG_COLOR_MASK_COLOR;\n3079\t      row_info->pixel_depth = (png_byte)(row_info->channels *\n3080\t          row_info->bit_depth);\n3081\t      row_info->rowbytes = PNG_ROWBYTES(row_info->pixel_depth, row_width);\n3082\t   }\n3083\t}\n3084\t#endif\n3085\t\n3086\t#ifdef PNG_READ_RGB_TO_GRAY_SUPPORTED\n3087\t/* Reduce RGB files to grayscale, with or without alpha\n3088\t * using the equation given in Poynton's ColorFAQ of 1998-01-04 at\n3089\t * <http://www.inforamp.net/~poynton/>  (THIS LINK IS DEAD June 2008 but\n3090\t * versions dated 1998 through November 2002 have been archived at\n3091\t * https://web.archive.org/web/20000816232553/www.inforamp.net/\n3092\t * ~poynton/notes/colour_and_gamma/ColorFAQ.txt )\n3093\t * Charles Poynton poynton at poynton.com\n3094\t *\n3095\t *     Y = 0.212671 * R + 0.715160 * G + 0.072169 * B\n3096\t *\n3097\t *  which can be expressed with integers as\n3098\t *\n3099\t *     Y = (6969 * R + 23434 * G + 2365 * B)/32768\n3100\t *\n3101\t * Poynton's current link (as of January 2003 through July 2011):\n3102\t * <http://www.poynton.com/notes/colour_and_gamma/>\n3103\t * has changed the numbers slightly:\n3104\t *\n3105\t *     Y = 0.2126*R + 0.7152*G + 0.0722*B\n3106\t *\n3107\t *  which can be expressed with integers as\n3108\t *\n3109\t *     Y = (6966 * R + 23436 * G + 2366 * B)/32768\n3110\t *\n3111\t *  Historically, however, libpng uses numbers derived from the ITU-R Rec 709\n3112\t *  end point chromaticities and the D65 white point.  Depending on the\n3113\t *  precision used for the D65 white point this produces a variety of different\n3114\t *  numbers, however if the four decimal place value used in ITU-R Rec 709 is\n3115\t *  used (0.3127,0.3290) the Y calculation would be:\n3116\t *\n3117\t *     Y = (6968 * R + 23435 * G + 2366 * B)/32768\n3118\t *\n3119\t *  While this is correct the rounding results in an overflow for white, because\n3120\t *  the sum of the rounded coefficients is 32769, not 32768.  Consequently\n3121\t *  libpng uses, instead, the closest non-overflowing approximation:\n3122\t *\n3123\t *     Y = (6968 * R + 23434 * G + 2366 * B)/32768\n3124\t *\n3125\t *  Starting with libpng-1.5.5, if the image being converted has a cHRM chunk\n3126\t *  (including an sRGB chunk) then the chromaticities are used to calculate the\n3127\t *  coefficients.  See the chunk handling in pngrutil.c for more information.\n3128\t *\n3129\t *  In all cases the calculation is to be done in a linear colorspace.  If no\n3130\t *  gamma information is available to correct the encoding of the original RGB\n3131\t *  values this results in an implicit assumption that the original PNG RGB\n3132\t *  values were linear.\n3133\t *\n3134\t *  Other integer coefficients can be used via png_set_rgb_to_gray().  Because\n3135\t *  the API takes just red and green coefficients the blue coefficient is\n3136\t *  calculated to make the sum 32768.  This will result in different rounding\n3137\t *  to that used above.\n3138\t */\n3139\tstatic int\n3140\tpng_do_rgb_to_gray(png_structrp png_ptr, png_row_infop row_info, png_bytep row)\n3141\t{\n3142\t   int rgb_error = 0;\n3143\t\n3144\t   png_debug(1, \"in png_do_rgb_to_gray\");\n3145\t\n3146\t   if ((row_info->color_type & PNG_COLOR_MASK_PALETTE) == 0 &&\n3147\t       (row_info->color_type & PNG_COLOR_MASK_COLOR) != 0)\n3148\t   {\n3149\t      png_uint_32 rc = png_ptr->rgb_to_gray_red_coeff;\n3150\t      png_uint_32 gc = png_ptr->rgb_to_gray_green_coeff;\n3151\t      png_uint_32 bc = 32768 - rc - gc;\n3152\t      png_uint_32 row_width = row_info->width;\n3153\t      int have_alpha = (row_info->color_type & PNG_COLOR_MASK_ALPHA) != 0;\n3154\t\n3155\t      if (row_info->bit_depth == 8)\n3156\t      {\n3157\t#ifdef PNG_READ_GAMMA_SUPPORTED\n3158\t         /* Notice that gamma to/from 1 are not necessarily inverses (if\n3159\t          * there is an overall gamma correction).  Prior to 1.5.5 this code\n3160\t          * checked the linearized values for equality; this doesn't match\n3161\t          * the documentation, the original values must be checked.\n3162\t          */\n3163\t         if (png_ptr->gamma_from_1 != NULL && png_ptr->gamma_to_1 != NULL)\n3164\t         {\n3165\t            png_bytep sp = row;\n3166\t            png_bytep dp = row;\n3167\t            png_uint_32 i;\n3168\t\n3169\t            for (i = 0; i < row_width; i++)\n