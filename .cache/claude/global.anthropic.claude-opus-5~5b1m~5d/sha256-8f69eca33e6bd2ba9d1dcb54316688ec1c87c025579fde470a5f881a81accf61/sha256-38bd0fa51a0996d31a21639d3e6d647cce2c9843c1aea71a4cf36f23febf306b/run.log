n606\tpub const fn png_col_in_interlace_pass(x: png_uint_32, pass: c_int) -> c_uint {\n607\t    (png_pass_mask(pass, 1) >> (x & 7)) & 1\n608\t}\n609\t\n610\t/// `png_composite` (NODIV variant, which is what this build uses)\n611\t#[inline]\n612\tpub fn png_composite(fg: png_uint_16, alpha: png_uint_16, bg: png_uint_16) -> png_byte {\n613\t    let temp: png_uint_16 = (fg)\n614\t        .wrapping_mul(alpha)\n615\t        .wrapping_add((bg).wrapping_mul(255u16.wrapping_sub(alpha)))\n616\t        .wrapping_add(128);\n617\t    (((temp as u32 + (temp as u32 >> 8)) >> 8) & 0xff) as png_byte\n618\t}\n619\t\n620\t/// `png_composite_16` (NODIV variant)\n621\t#[inline]\n622\tpub fn png_composite_16(fg: png_uint_32, alpha: png_uint_32, bg: png_uint_32) -> png_uint_16 {\n623\t    let temp: png_uint_32 = (fg)\n624\t        .wrapping_mul(alpha)\n625\t        .wrapping_add((bg).wrapping_mul(65535u32.wrapping_sub(alpha)));\n626\t    let temp = temp.wrapping_add(32768);\n627\t    (0xffff & ((temp.wrapping_add(temp >> 16)) >> 16)) as png_uint_16\n628\t}\n629\t"}]},"parent_tool_use_id":"toolu_bdrk_01CN3y7wbUDqhBPd3MvkeND5","session_id":"bedb3620-db7f-4287-b934-614ec17ac76e","uuid":"ced7e713-8a6d-442e-8888-471a396078f8","timestamp":"2026-08-31T12:38:45.312Z","subagent_type":"general-purpose","task_description":"Translate pngrutil.c 3954-4684"}
