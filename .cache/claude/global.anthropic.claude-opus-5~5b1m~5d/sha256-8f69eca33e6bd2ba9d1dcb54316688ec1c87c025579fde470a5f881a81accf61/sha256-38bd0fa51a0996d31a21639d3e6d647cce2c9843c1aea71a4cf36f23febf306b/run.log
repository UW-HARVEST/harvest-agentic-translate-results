{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01HDxZD8SCPnYKCiPcE2tZ4M","type":"tool_result","content":"1\t//! File-local (C `static` / typedef) definitions from pngread.c, pngwrite.c and\n2\t//! pngwutil.c that are shared between the Rust modules a single C file was\n3\t//! split into.\n4\t#![allow(non_camel_case_types)]\n5\t#![allow(dead_code)]\n6\t\n7\tuse crate::types::*;\n8\tuse core::ffi::{c_int, c_void};\n9\t\n10\t// ---------------------------------------------------------------------------\n11\t// pngread.c\n12\t// ---------------------------------------------------------------------------\n13\t\n14\t/* File encodings (\"E_\"/\"P_\" values) */\n15\tpub const P_NOTSET: c_int = 0; /* File encoding not yet known */\n16\tpub const P_sRGB: c_int = 1; /* 8-bit encoded to sRGB gamma */\n17\tpub const P_LINEAR: c_int = 2; /* 16-bit linear: not encoded, NOT pre-multiplied! */\n18\tpub const P_FILE: c_int = 3; /* 8-bit encoded to file gamma, not sRGB or linear */\n19\tpub const P_LINEAR8: c_int = 4; /* 8-bit linear: only from a file value */\n20\t\n21\tpub const PNG_CMAP_NONE: c_int = 0;\n22\tpub const PNG_CMAP_GA: c_int = 1;\n23\tpub const PNG_CMAP_TRANS: c_int = 2;\n24\tpub const PNG_CMAP_RGB: c_int = 3;\n25\tpub const PNG_CMAP_RGB_ALPHA: c_int = 4;\n26\t\n27\tpub const PNG_CMAP_NONE_BACKGROUND: c_int = 256;\n28\tpub const PNG_CMAP_GA_BACKGROUND: c_int = 231;\n29\tpub const PNG_CMAP_TRANS_BACKGROUND: c_int = 254;\n30\tpub const PNG_CMAP_RGB_BACKGROUND: c_int = 256;\n31\tpub const PNG_CMAP_RGB_ALPHA_BACKGROUND: c_int = 216;\n32\t\n33\tpub const PNG_GRAY_COLORMAP_ENTRIES: c_int = 256;\n34\tpub const PNG_GA_COLORMAP_ENTRIES: c_int = 256;\n35\tpub const PNG_RGB_COLORMAP_ENTRIES: c_int = 216;\n36\tpub const sRGB_TOLERANCE: png_fixed_point = 1000;\n37\t\n38\t/// `PNG_DIV51(v8)`\n39\t#[inline]\n40\tpub const fn PNG_DIV51(v8: png_uint_32) -> png_uint_32 {\n41\t    (v8 * 5 + 130) >> 8\n42\t}\n43\t\n44\t/// `PNG_RGB_INDEX(r,g,b)` from pngread.c\n45\t#[inline]\n46\tpub const fn PNG_RGB_INDEX(r: png_uint_32, g: png_uint_32, b: png_uint_32) -> png_byte {\n47\t    (PNG_DIV51(r) * 36 + PNG_DIV51(g) * 6 + PNG_DIV51(b)) as png_byte\n48\t}\n49\t\n50\t#[repr(C)]\n51\tpub struct png_image_read_control {\n52\t    /* Arguments */\n53\t    pub image: png_imagep,\n54\t    pub buffer: png_voidp,\n55\t    pub row_stride: png_int_32,\n56\t    pub colormap: png_voidp,\n57\t    pub background: png_const_colorp,\n58\t\n59\t    /* Instance variables */\n60\t    pub local_row: png_voidp,\n61\t    pub first_row: png_voidp,\n62\t    pub row_step: isize,\n63\t    pub file_encoding: c_int,\n64\t    pub gamma_to_linear: png_fixed_point,\n65\t    pub colormap_processing: c_int,\n66\t}\n67\t\n68\timpl Default for png_image_read_control {\n69\t    fn default() -> Self {\n70\t        unsafe { core::mem::zeroed() }\n71\t    }\n72\t}\n73\t\n74\t// ---------------------------------------------------------------------------\n75\t// pngwrite.c\n76\t// ---------------------------------------------------------------------------\n77\t\n78\t#[repr(C)]\n79\tpub struct png_image_write_control {\n80\t    /* Arguments */\n81\t    pub image: png_imagep,\n82\t    pub buffer: png_const_voidp,\n83\t    pub row_stride: png_int_32,\n84\t    pub colormap: png_const_voidp,\n85\t    pub convert_to_8bit: c_int,\n86\t\n87\t    /* Instance variables */\n88\t    pub first_row: png_const_voidp,\n89\t    pub local_row: png_voidp,\n90\t    pub row_step: isize,\n91\t\n92\t    /* Byte count for memory writing */\n93\t    pub memory: png_bytep,\n94\t    pub memory_bytes: png_alloc_size_t, /* not used for STDIO */\n95\t    pub output_bytes: png_alloc_size_t, /* running total */\n96\t}\n97\t\n98\timpl Default for png_image_write_control {\n99\t    fn default() -> Self {\n100\t        unsafe { core::mem::zeroed() }\n101\t    }\n102\t}\n103\t\n104\t// ---------------------------------------------------------------------------\n105\t// pngrutil.c\n106\t// ---------------------------------------------------------------------------\n107\t\n108\t/// `LZ77Min` - minimum LZ77 match length overhead used by png_decompress_chunk.\n109\tpub const LZ77Min: png_uint_32 = 2 + 5 + 4;\n110\t\n111\t/* Arrays to facilitate interlace calculations */\n112\tpub static png_pass_start: [png_byte; 7] = [0, 4, 0, 2, 0, 1, 0];\n113\tpub static png_pass_inc: [png_byte; 7] = [8, 8, 4, 4, 2, 2, 1];\n114\tpub static png_pass_ystart: [png_byte; 7] = [0, 0, 4, 0, 2, 0, 1];\n115\tpub static png_pass_yinc: [png_byte; 7] = [8, 8, 8, 4, 4, 2, 2];\n116\t\n117\t// ---------------------------------------------------------------------------\n118\t// pngwutil.c\n119\t// ---------------------------------------------------------------------------\n120\t\n121\t#[repr(C)]\n122\tpub struct compression_state {\n123\t    pub input: png_const_bytep,       /* The uncompressed input data */\n124\t    pub input_len: png_alloc_size_t,  /* Its length */\n125\t    pub output_len: png_uint_32,      /* Final compressed length */\n126\t    pub output: [png_byte; 1024],     /* First block of output */\n127\t}\n128\t\n129\timpl Default for compression_state {\n130\t    fn default() -> Self {\n131\t        unsafe { core::mem::zeroed() }\n132\t    }\n133\t}\n134\t"}]},"parent_tool_use_id":"toolu_bdrk_01Mu4y1rJRNNK2pfACJvwAhg","session_id":"bedb3620-db7f-4287-b934-614ec17ac76e","uuid":"2d1b3aa0-918f-48b4-88c9-dc2ff7a3fff2","timestamp":"2026-08-31T12:37:55.328Z","subagent_type":"general-purpose","task_description":"Translate pngrutil.c 1-900"}
