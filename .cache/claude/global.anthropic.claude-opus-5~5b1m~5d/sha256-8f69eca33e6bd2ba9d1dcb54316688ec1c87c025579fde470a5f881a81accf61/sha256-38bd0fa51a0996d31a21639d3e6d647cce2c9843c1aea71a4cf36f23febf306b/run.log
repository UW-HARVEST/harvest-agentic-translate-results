t ret: png_voidp = png_malloc_base(png_ptr, size);\n176\t\n177\t        if !ret.is_null() {\n178\t            return ret;\n179\t        }\n180\t\n181\t        png_warning(png_ptr, c\"Out of memory\".as_ptr());\n182\t    }\n183\t\n184\t    core::ptr::null_mut()\n185\t}\n186\t\n187\t#[unsafe(no_mangle)]\n188\tpub unsafe extern \"C-unwind\" fn png_free(png_ptr: png_const_structrp, ptr: png_voidp) {\n189\t    if png_ptr.is_null() || ptr.is_null() {\n190\t        return;\n191\t    }\n192\t\n193\t    if (*png_ptr).free_fn.is_some() {\n194\t        ((*png_ptr).free_fn.unwrap())(png_ptr as png_structrp, ptr);\n195\t    } else {\n196\t        png_free_default(png_ptr, ptr);\n197\t    }\n198\t}\n199\t\n200\t#[unsafe(no_mangle)]\n201\tpub unsafe extern \"C-unwind\" fn png_free_default(png_ptr: png_const_structrp, ptr: png_voidp) {\n202\t    if png_ptr.is_null() || ptr.is_null() {\n203\t        return;\n204\t    }\n205\t\n206\t    crate::cabi::free(ptr);\n207\t}\n208\t\n209\t#[unsafe(no_mangle)]\n210\tpub unsafe extern \"C-unwind\" fn png_set_mem_fn(\n211\t    png_ptr: png_structrp,\n212\t    mem_ptr: png_voidp,\n213\t    malloc_fn: png_malloc_ptr,\n214\t    free_fn: png_free_ptr,\n215\t) {\n216\t    if !png_ptr.is_null() {\n217\t        (*png_ptr).mem_ptr = mem_ptr;\n218\t        (*png_ptr).malloc_fn = malloc_fn;\n219\t        (*png_ptr).free_fn = free_fn;\n220\t    }\n221\t}\n222\t\n223\t#[unsafe(no_mangle)]\n224\tpub unsafe extern \"C-unwind\" fn png_get_mem_ptr(png_ptr: png_const_structrp) -> png_voidp {\n225\t    if png_ptr.is_null() {\n226\t        return core::ptr::null_mut();\n227\t    }\n228\t\n229\t    (*png_ptr).mem_ptr\n230\t}\n231\t"}]},"parent_tool_use_id":"toolu_bdrk_01FthT979u86LsVSxZQ3y9My","session_id":"bedb3620-db7f-4287-b934-614ec17ac76e","uuid":"574905ff-2a31-47ad-9682-23cd3a3d14c9","timestamp":"2026-08-31T12:42:02.619Z","subagent_type":"general-purpose","task_description":"Translate pngread.c 1955-3131"}
