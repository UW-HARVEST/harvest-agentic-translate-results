{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01BroDvjiwF11yDAFEcZYsrG","type":"tool_result","content":"1\t//! pngerror.c - error handling.\n2\tuse crate::prelude::*;\n3\tuse core::ffi::{c_char, c_int, c_void};\n4\t\n5\tpub const PNG_MAX_ERROR_TEXT: usize = 196;\n6\t\n7\t/// Payload of the panic used to emulate the `longjmp` calls that the C code\n8\t/// performs internally (`png_safe_error`, `png_free_jmpbuf`,\n9\t/// `png_create_png_struct`).\n10\tpub struct PngLongjmp(pub c_int);\n11\t\n12\t/// A `png_longjmp_ptr` that raises the internal unwind used in place of\n13\t/// `longjmp` in the few places where libpng calls `setjmp` itself.\n14\tpub unsafe extern \"C-unwind\" fn png_internal_longjmp(_jb: *mut jmp_buf, val: c_int) -> ! {\n15\t    std::panic::panic_any(PngLongjmp(val))\n16\t}\n17\t\n18\t#[unsafe(no_mangle)]\n19\tpub unsafe extern \"C-unwind\" fn png_error(\n20\t    png_ptr: png_const_structrp,\n21\t    error_message: png_const_charp,\n22\t) -> ! {\n23\t    if !png_ptr.is_null() && (*png_ptr).error_fn.is_some() {\n24\t        ((*png_ptr).error_fn.unwrap())(png_ptr as png_structrp, error_message);\n25\t    }\n26\t\n27\t    /* If the custom handler doesn't exist, or if it returns,\n28\t       use the default handler, which will not return. */\n29\t    png_default_error(png_ptr, error_message)\n30\t}\n31\t\n32\t#[unsafe(no_mangle)]\n33\tpub unsafe extern \"C-unwind\" fn png_safecat(\n34\t    buffer: png_charp,\n35\t    bufsize: usize,\n36\t    pos_in: usize,\n37\t    string_in: png_const_charp,\n38\t) -> usize {\n39\t    let mut pos = pos_in;\n40\t    let mut string = string_in;\n41\t\n42\t    if !buffer.is_null() && pos < bufsize {\n43\t        if !string.is_null() {\n44\t            while *string != 0 && pos < bufsize - 1 {\n45\t                *buffer.add(pos) = *string;\n46\t                pos += 1;\n47\t                string = string.add(1);\n48\t            }\n49\t        }\n50\t\n51\t        *buffer.add(pos) = 0;\n52\t    }\n53\t\n54\t    pos\n55\t}\n56\t\n57\t#[unsafe(no_mangle)]\n58\tpub unsafe extern \"C-unwind\" fn png_format_number(\n59\t    start: png_const_charp,\n60\t    end_in: png_charp,\n61\t    format: c_int,\n62\t    number_in: png_alloc_size_t,\n63\t) -> png_charp {\n64\t    static DIGITS: [u8; 17] = *b\"0123456789ABCDEF\\0\";\n65\t\n66\t    let mut end = end_in;\n67\t    let mut number = number_in;\n68\t    let mut count: c_int = 0; /* number of digits output */\n69\t    let mut mincount: c_int = 1; /* minimum number required */\n70\t    let mut output: c_int = 0; /* digit output (for the fixed point format) */\n71\t\n72\t    end = end.sub(1);\n73\t    *end = 0;\n74\t\n75\t    /* This is written so that the loop always runs at least once, even with\n76\t     * number zero.\n77\t     */\n78\t    while (end as *const c_char) > start && (number != 0 || count < mincount) {\n79\t        if format == PNG_NUMBER_FORMAT_fixed {\n80\t            /* Needs five digits (the fraction) */\n81\t            mincount = 5;\n82\t            if output != 0 || number % 10 != 0 {\n83\t                end = end.sub(1);\n84\t                *end = DIGITS[(number % 10) as usize] as c_char;\n85\t                output = 1;\n86\t            }\n87\t            number /= 10;\n88\t        } else if format == PNG_NUMBER_FORMAT_02u || format == PNG_NUMBER_FORMAT_u {\n89\t            /* PNG_NUMBER_FORMAT_02u expects at least 2 digits, then falls\n90\t             * through into the PNG_NUMBER_FORMAT_u case.\n91\t             */\n92\t            if format == PNG_NUMBER_FORMAT_02u {\n93\t                mincount = 2;\n94\t            }\n95\t            end = end.sub(1);\n96\t            *end = DIGITS[(number % 10) as usize] as c_char;\n97\t            number /= 10;\n98\t        } else if format == PNG_NUMBER_FORMAT_02x || format == PNG_NUMBER_FORMAT_x {\n99\t            /* PNG_NUMBER_FORMAT_02x expects at least two digits, then falls\n100\t             * through into the PNG_NUMBER_FORMAT_x case.\n101\t             */\n102\t            if format == PNG_NUMBER_FORMAT_02x {\n103\t                mincount = 2;\n104\t            }\n105\t            end = end.sub(1);\n106\t            *end = DIGITS[(number & 0xf) as usize] as c_char;\n107\t            number >>= 4;\n108\t        } else {\n109\t            /* an error */\n110\t            number = 0;\n111\t        }\n112\t\n113\t        /* Keep track of the number of digits added */\n114\t        count += 1;\n115\t\n116\t        /* Float a fixed number here: */\n117\t        if format == PNG_NUMBER_FORMAT_fixed && count == 5 && (end as *const c_char) > start {\n118\t            /* End of the fraction, but maybe nothing was output?  In that case\n119\t             * drop the decimal point.  If the number is a true zero handle that\n120\t             * here.\n121\t             */\n122\t            if output != 0 {\n123\t                end = end.sub(1);\n124\t                *end = b'.' as c_char;\n125\t            } else if number == 0 {\n126\t                /* and !output */\n127\t                end = end.sub(1);\n128\t                *end = b'0' as c_char;\n129\t            }\n130\t        }\n131\t    }\n132\t\n133\t    end\n134\t}\n135\t\n136\t#[unsafe(no_mangle)]\n137\tpub unsafe extern \"C-unwind\" fn png_warning(\n138\t    png_ptr: png_const_structrp,\n139\t    warning_message: png_const_charp,\n140\t) {\n141\t    let offset: usize = 0;\n142\t    if !png_ptr.is_null() && (*png_ptr).warning_fn.is_some() {\n143\t        ((*png_ptr).warning_fn.unwrap())(png_ptr as png_structrp, warning_message.add(offset));\n144\t    } else {\n145\t        png_default_warning(png_ptr, warning_message.add(offset));\n146\t    }\n147\t}\n148\t\n149\t#[unsafe(no_mangle)]\n150\tpub unsafe extern \"C-unwind\" fn png_warning_parameter(\n151\t    p: *mut [c_char; PNG_WARNING_PARAMETER_SIZE],\n152\t    number: c_int,\n153\t    string: png_const_charp,\n154\t) {\n155\t    if number > 0 && number <= PNG_WARNING_PARAMETER_COUNT as c_int {\n156\t        let row = (*p.add((number - 1) as usize)).as_mut_ptr();\n157\t        png_safecat(row, PNG_WARNING_PARAMETER_SIZE, 0, string);\n158\t    }\n159\t}\n160\t\n161\t#[unsafe(no_mangle)]\n162\tpub unsafe extern \"C-unwind\" fn png_warning_parameter_unsigned(\n163\t    p: *mut [c_char; PNG_WARNING_PARAMETER_SIZE],\n164\t    number: c_int,\n165\t    format: c_int,\n166\t    value: png_alloc_size_t,\n167\t) {\n168\t    let mut buffer: [c_char; PNG_NUMBER_BUFFER_SIZE] = [0; PNG_NUMBER_BUFFER_SIZE];\n169\t    let s = png_format_number(\n170\t        buffer.as_ptr(),\n171\t        buffer.as_mut_ptr().add(PNG_NUMBER_BUFFER_SIZE),\n172\t        format,\n173\t        value,\n174\t    );\n175\t    png_warning_parameter(p, number, s);\n176\t}\n177\t\n178\t#[unsafe(no_mangle)]\n179\tpub unsafe extern \"C-unwind\" fn png_warning_parameter_signed(\n180\t    p: *mut [c_char; PNG_WARNING_PARAMETER_SIZE],\n181\t    number: c_int,\n182\t    format: c_int,\n183\t    value: png_int_32,\n184\t) {\n185\t    let mut u: png_alloc_size_t;\n186\t    let mut str_: png_charp;\n187\t    let mut buffer: [c_char; PNG_NUMBER_BUFFER_SIZE] = [0; PNG_NUMBER_BUFFER_SIZE];\n188\t\n189\t    /* Avoid overflow by doing the negate in a png_alloc_size_t: */\n190\t    u = value as isize as png_alloc_size_t;\n191\t    if value < 0 {\n192\t        u = (!u).wrapping_add(1);\n193\t    }\n194\t\n195\t    str_ = png_format_number(\n196\t        buffer.as_ptr(),\n197\t        buffer.as_mut_ptr().add(PNG_NUMBER_BUFFER_SIZE),\n198\t        format,\n199\t        u,\n200\t    );\n201\t\n202\t    if value < 0 && str_ > buffer.as_mut_ptr() {\n203\t        str_ = str_.sub(1);\n204\t        *str_ = b'-' as c_char;\n205\t    }\n206\t\n207\t    png_warning_parameter(p, number, str_);\n208\t}\n209\t\n210\t#[unsafe(no_mangle)]\n211\tpub unsafe extern \"C-unwind\" fn png_formatted_warning(\n212\t    png_ptr: png_const_structrp,\n213\t    p: *mut [c_char; PNG_WARNING_PARAMETER_SIZE],\n214\t    message_in: png_const_charp,\n215\t) {\n216\t    /* The internal buffer is just 192 bytes - enough for all our messages,\n217\t     * overflow doesn't happen because this code checks!\n218\t     */\n219\t    let mut i: usize = 0; /* Index in the msg[] buffer: */\n220\t    let mut msg: [c_char; 192] = [0; 192];\n221\t    let mut message = message_in;\n222\t\n223\t    while i < 192 - 1 && *message != 0 {\n224\t        /* '@' at end of string is now just printed (previously it was skipped);\n225\t         * it is an error in the calling code to terminate the string with @.\n226\t         */\n227\t        if !p.is_null() && *message == b'@' as c_char && *message.add(1) != 0 {\n228\t            message = message.add(1); /* Consume the '@' */\n229\t            let parameter_char: c_int = *message as c_int;\n230\t            static VALID_PARAMETERS: [u8; 10] = *b\"123456789\\0\";\n231\t            let mut parameter: usize = 0;\n232\t\n233\t            /* Search for the parameter digit, the index in the string is the\n234\t             * parameter to use.\n235\t             */\n236\t            while VALID_PARAMETERS[parameter] as c_int != parameter_char\n237\t                && VALID_PARAMETERS[parameter] != 0\n238\t            {\n239\t                parameter += 1;\n240\t            }\n241\t\n242\t            /* If the parameter digit is out of range it will just get printed. */\n243\t            if parameter < PNG_WARNING_PARAMETER_COUNT {\n244\t                /* Append this parameter */\n245\t                let mut parm: png_const_charp = (*p.add(parameter)).as_ptr();\n246\t                let pend: png_const_charp = (*p.add(parameter))\n247\t                    .as_ptr()\n248\t                    .add(PNG_WARNING_PARAMETER_SIZE);\n249\t\n250\t                while i < 192 - 1 && *parm != 0 && parm < pend {\n251\t                    msg[i] = *parm;\n252\t                    i += 1;\n253\t                    parm = parm.add(1);\n254\t                }\n255\t\n256\t                /* Consume the parameter digit too: */\n257\t                message = message.add(1);\n258\t                continue;\n259\t            }\n260\t\n261\t            /* else not a parameter and there is a character after the @ sign;\n262\t             * just copy that.\n263\t             */\n264\t        }\n265\t\n266\t        msg[i] = *message;\n267\t        i += 1;\n268\t        message = message.add(1);\n269\t    }\n270\t\n271\t    /* i is always less than (sizeof msg), so: */\n272\t    msg[i] = 0;\n273\t\n274\t    png_warning(png_ptr, msg.as_ptr());\n275\t}\n276\t\n277\t#[unsafe(no_mangle)]\n278\tpub unsafe extern \"C-unwind\" fn png_benign_error(\n279\t    png_ptr: png_const_structrp,\n280\t    error_message: png_const_charp,\n281\t) {\n282\t    if ((*png_ptr).flags & PNG_FLAG_BENIGN_ERRORS_WARN) != 0 {\n283\t        if ((*png_ptr).mode & PNG_IS_READ_STRUCT) != 0 && (*png_ptr).chunk_name != 0 {\n284\t            png_chunk_warning(png_ptr, error_message);\n285\t        } else {\n286\t            png_warning(png_ptr, error_message);\n287\t        }\n288\t    } else {\n289\t        if ((*png_ptr).mode & PNG_IS_READ_STRUCT) != 0 && (*png_ptr).chunk_name != 0 {\n290\t            png_chunk_error(png_ptr, error_message);\n291\t        } else {\n292\t            png_error(png_ptr, error_message);\n293\t        }\n294\t    }\n295\t}\n296\t\n297\t#[unsafe(no_mangle)]\n298\tpub unsafe extern \"C-unwind\" fn png_app_warning(\n299\t    png_ptr: png_const_structrp,\n300\t    error_message: png_const_charp,\n301\t) {\n302\t    if ((*png_ptr).flags & PNG_FLAG_APP_WARNINGS_WARN) != 0 {\n303\t        png_warning(png_ptr, error_message);\n304\t    } else {\n305\t        png_error(png_ptr, error_message);\n306\t    }\n307\t}\n308\t\n309\t#[unsafe(no_mangle)]\n310\tpub unsafe extern \"C-unwind\" fn png_app_error(\n311\t    png_ptr: png_const_structrp,\n312\t    error_message: png_const_charp,\n313\t) {\n314\t    if ((*png_ptr).flags & PNG_FLAG_APP_ERRORS_WARN) != 0 {\n315\t        png_warning(png_ptr, error_message);\n316\t    } else {\n317\t        png_error(png_ptr, error_message);\n318\t    }\n319\t}\n320\t\n321\t#[inline]\n322\tfn isnonalpha(c: c_int) -> bool {\n323\t    c < 65 || c > 122 || (c > 90 && c < 97)\n324\t}\n325\t\n326\tstatic PNG_DIGIT: [u8; 16] = [\n327\t    b'0', b'1', b'2', b'3', b'4', b'5', b'6', b'7', b'8', b'9', b'A', b'B', b'C', b'D', b'E', b'F',\n328\t];\n329\t\n330\tunsafe fn png_format_buffer(\n331\t    png_ptr: png_const_structrp,\n332\t    buffer: png_charp,\n333\t    error_message: png_const_charp,\n334\t) {\n335\t    let chunk_name: png_uint_32 = (*png_ptr).chunk_name;\n336\t    let mut iout: usize = 0;\n337\t    let mut ishift: c_int = 24;\n338\t\n339\t    while ishift >= 0 {\n340\t        let c: c_int = ((chunk_name >> ishift) & 0xff) as c_int;\n341\t\n342\t        ishift -= 8;\n343\t        if isnonalpha(c) {\n344\t            *buffer.add(iout) = PNG_LITERAL_LEFT_SQUARE_BRACKET as c_char;\n345\t            iout += 1;\n346\t            *buffer.add(iout) = PNG_DIGIT[((c & 0xf0) >> 4) as usize] as c_char;\n347\t            iout += 1;\n348\t            *buffer.add(iout) = PNG_DIGIT[(c & 0x0f) as usize] as c_char;\n349\t            iout += 1;\n350\t            *buffer.add(iout) = PNG_LITERAL_RIGHT_SQUARE_BRACKET as c_char;\n351\t            iout += 1;\n352\t        } else {\n353\t            *buffer.add(iout) = c as c_char;\n354\t            iout += 1;\n355\t        }\n356\t    }\n357\t\n358\t    if error_message.is_null() {\n359\t        *buffer.add(iout) = 0;\n360\t    } else {\n361\t        let mut iin: usize = 0;\n362\t\n363\t        *buffer.add(iout) = b':' as c_char;\n364\t        iout += 1;\n365\t        *buffer.add(iout) = b' ' as c_char;\n366\t        iout += 1;\n367\t\n368\t        while iin < PNG_MAX_ERROR_TEXT - 1 && *error_message.add(iin) != 0 {\n369\t            *buffer.add(iout) = *error_message.add(iin);\n370\t            iout += 1;\n371\t            iin += 1;\n372\t        }\n373\t\n374\t        /* iin < PNG_MAX_ERROR_TEXT, so the following is safe: */\n375\t        *buffer.add(iout) = 0;\n376\t    }\n377\t}\n378\t\n379\t#[unsafe(no_mangle)]\n380\tpub unsafe extern \"C-unwind\" fn png_chunk_error(\n381\t    png_ptr: png_const_structrp,\n382\t    error_message: png_const_charp,\n383\t) -> ! {\n384\t    let mut msg: [c_char; 18 + PNG_MAX_ERROR_TEXT] = [0; 18 + PNG_MAX_ERROR_TEXT];\n385\t    if png_ptr.is_null() {\n386\t        png_error(png_ptr, error_message)\n387\t    } else {\n388\t        png_format_buffer(png_ptr, msg.as_mut_ptr(), error_message);\n389\t        png_error(png_ptr, msg.as_ptr())\n390\t    }\n391\t}\n392\t\n393\t#[unsafe(no_mangle)]\n394\tpub unsafe extern \"C-unwind\" fn png_chunk_warning(\n395\t    png_ptr: png_const_structrp,\n396\t    warning_message: png_const_charp,\n397\t) {\n398\t    let mut msg: [c_char; 18 + PNG_MAX_ERROR_TEXT] = [0; 18 + PNG_MAX_ERROR_TEXT];\n399\t    if png_ptr.is_null() {\n400\t        png_warning(png_ptr, warning_message);\n401\t    } else {\n402\t        png_format_buffer(png_ptr, msg.as_mut_ptr(), warning_message);\n403\t        png_warning(png_ptr, msg.as_ptr());\n404\t    }\n405\t}\n406\t\n407\t#[unsafe(no_mangle)]\n408\tpub unsafe extern \"C-unwind\" fn png_chunk_benign_error(\n409\t    png_ptr: png_const_structrp,\n410\t    error_message: png_const_charp,\n411\t) {\n412\t    if ((*png_ptr).flags & PNG_FLAG_BENIGN_ERRORS_WARN) != 0 {\n413\t        png_chunk_warning(png_ptr, error_message);\n414\t    } else {\n415\t        png_chunk_error(png_ptr, error_message);\n416\t    }\n417\t}\n418\t\n419\t#[unsafe(no_mangle)]\n420\tpub unsafe extern \"C-unwind\" fn png_chunk_report(\n421\t    png_ptr: png_const_structrp,\n422\t    message: png_const_charp,\n423\t    error: c_int,\n424\t) {\n425\t    if ((*png_ptr).mode & PNG_IS_READ_STRUCT) != 0 {\n426\t        if error < PNG_CHUNK_ERROR {\n427\t            png_chunk_warning(png_ptr, message);\n428\t        } else {\n429\t            png_chunk_benign_error(png_ptr, message);\n430\t  