e */\n338\t               {\n339\t                  png_byte background8 = display->background->green;\n340\t                  png_uint_16 background = png_sRGB_table[background8];\n341\t\n342\t                  for (; y<height; y += stepy)\n343\t                  {\n344\t                     png_bytep inrow = png_voidcast(png_bytep,\n345\t                         display->local_row);\n346\t                     png_bytep outrow = first_row + y * row_step;\n347\t                     png_const_bytep row_end = outrow + width;\n348\t\n349\t                     /* Read the row, which is packed: */\n350\t                     png_read_row(png_ptr, inrow, NULL);\n351\t\n352\t                     /* Now do the composition on each pixel in this row. */\n353\t                     outrow += startx;\n354\t                     for (; outrow < row_end; outrow += stepx)\n355\t                     {\n356\t                        png_byte alpha = inrow[1];\n357\t\n358\t                        if (alpha > 0) /* else use background */\n359\t                        {\n360\t                           png_uint_32 component = inrow[0];\n361\t\n362\t                           if (alpha < 255) /* else just use component */\n363\t                           {\n364\t                              component = png_sRGB_table[component] * alpha;\n365\t                              component += background * (255-alpha);\n366\t                              component = PNG_sRGB_FROM_LINEAR(component);\n367\t                           }\n368\t\n369\t                           outrow[0] = (png_byte)component;\n370\t                        }\n371\t\n372\t                        else\n373\t                           outrow[0] = background8;\n374\t\n375\t                        inrow += 2; /* gray and alpha channel */\n376\t                     }\n377\t                  }\n378\t               }\n379\t            }\n380\t         }\n381\t         break;\n382\t\n383\t      case 16:\n384\t         /* 16-bit l