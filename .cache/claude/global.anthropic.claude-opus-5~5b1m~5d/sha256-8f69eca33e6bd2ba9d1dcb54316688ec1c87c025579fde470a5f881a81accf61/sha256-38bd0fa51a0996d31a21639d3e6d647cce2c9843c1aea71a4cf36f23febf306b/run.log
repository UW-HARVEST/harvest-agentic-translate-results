9\t                core::mem::size_of_val(&(*image).message),\n640\t                pos,\n641\t                error_message,\n642\t            );\n643\t        }\n644\t    }\n645\t\n646\t    /* Here on an internal programming error. */\n647\t    crate::cabi::abort()\n648\t}\n649\t\n650\t#[unsafe(no_mangle)]\n651\tpub unsafe extern \"C-unwind\" fn png_safe_warning(\n652\t    png_nonconst_ptr: png_structp,\n653\t    warning_message: png_const_charp,\n654\t) {\n655\t    let png_ptr: png_const_structrp = png_nonconst_ptr;\n656\t    let image: png_imagep = (*png_ptr).error_ptr as png_imagep;\n657\t\n658\t    /* A warning is only logged if there is no prior warning or error. */\n659\t    if (*image).warning_or_error == 0 {\n660\t        png_safecat(\n661\t            (*image).message.as_mut_ptr(),\n662\t            core::mem::size_of_val(&(*image).message),\n663\t            0,\n664\t            warning_message,\n665\t        );\n666\t        (*image).warning_or_error |= PNG_IMAGE_WARNING;\n667\t    }\n668\t}\n669\t\n670\t#[unsafe(no_mangle)]\n671\tpub unsafe extern \"C-unwind\" fn png_safe_execute(\n672\t    image: png_imagep,\n673\t    function: Option<unsafe extern \"C-unwind\" fn(png_voidp) -> c_int>,\n674\t    arg: png_voidp,\n675\t) -> c_int {\n676\t    let saved_error_buf: png_voidp = (*(*image).opaque).error_buf;\n677\t    /* Stands in for `jmp_buf safe_jmpbuf` - only ever tested for NULL. */\n678\t    let mut safe_jmpbuf: jmp_buf = jmp_buf([0; 25]);\n679\t\n680\t    /* Safely execute function(arg), with png_error returning back here. */\n681\t    let caught = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {\n682\t        (*(*image).opaque).error_buf = (&mut safe_jmpbuf) as *mut jmp_buf as png_voidp;\n683\t        let result = (function.unwrap())(arg);\n684\t        (*(*image).opaque).error_buf = saved_error_buf;\n685\t\n686\t        result\n687\t    }));\n688\t\n689\t    if let Ok(result) = caught {\n690\t        if result != 0 {\n691\t            retu