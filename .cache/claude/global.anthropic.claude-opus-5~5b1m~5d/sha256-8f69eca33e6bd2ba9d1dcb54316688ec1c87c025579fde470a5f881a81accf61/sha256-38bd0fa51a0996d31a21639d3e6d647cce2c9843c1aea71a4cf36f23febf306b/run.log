#[inline]\n62\tpub unsafe fn memset(dst: *mut u8, v: u8, n: usize) {\n63\t    if n != 0 {\n64\t        core::ptr::write_bytes(dst, v, n);\n65\t    }\n66\t}\n67\t\n68\t/// `memcmp`\n69\t#[inline]\n70\tpub unsafe fn memcmp(a: *const u8, b: *const u8, n: usize) -> c_int {\n71\t    for i in 0..n {\n72\t        let x = *a.add(i);\n73\t        let y = *b.add(i);\n74\t        if x != y {\n75\t            return x as c_int - y as c_int;\n76\t        }\n77\t    }\n78\t    0\n79\t}\n80\t\n81\t/// `strlen`\n82\t#[inline]\n83\tpub unsafe fn strlen(s: *const c_char) -> usize {\n84\t    let mut n = 0usize;\n85\t    while *s.add(n) != 0 {\n86\t        n += 1;\n87\t    }\n88\t    n\n89\t}\n90\t\n91\t/// `strcmp`\n92\t#[inline]\n93\tpub unsafe fn strcmp(a: *const c_char, b: *const c_char) -> c_int {\n94\t    let mut i = 0usize;\n95\t    loop {\n96\t        let x = *a.add(i) as u8;\n97\t        let y = *b.add(i) as u8;\n98\t        if x != y {\n99\t            return x as c_int - y as c_int;\n100\t        }\n101\t        if x == 0 {\n102\t            return 0;\n103\t        }\n104\t        i += 1;\n105\t    }\n106\t}\n107\t"}]},"parent_tool_use_id":"toolu_bdrk_018wqynw38KuR3qPrhdR6c7s","session_id":"bedb3620-db7f-4287-b934-614ec17ac76e","uuid":"52a47bf2-0ea6-4cd6-a9a7-fbcab08e1943","timestamp":"2026-08-31T12:39:35.777Z","subagent_type":"general-purpose","task_description":"Translate pngrutil.c 3227-3953"}
