ng_uint_32,\n358\t    pub exif: png_bytep,\n359\t\n360\t    pub hist: png_uint_16p,\n361\t\n362\t    pub pcal_purpose: png_charp,\n363\t    pub pcal_X0: png_int_32,\n364\t    pub pcal_X1: png_int_32,\n365\t    pub pcal_units: png_charp,\n366\t    pub pcal_params: png_charpp,\n367\t    pub pcal_type: png_byte,\n368\t    pub pcal_nparams: png_byte,\n369\t\n370\t    pub free_me: png_uint_32,\n371\t\n372\t    pub unknown_chunks: png_unknown_chunkp,\n373\t    pub unknown_chunks_num: c_int,\n374\t\n375\t    pub splt_palettes: png_sPLT_tp,\n376\t    pub splt_palettes_num: c_int,\n377\t\n378\t    pub scal_unit: png_byte,\n379\t    pub scal_s_width: png_charp,\n380\t    pub scal_s_height: png_charp,\n381\t\n382\t    pub row_pointers: png_bytepp,\n383\t\n384\t    pub cHRM: png_xy,\n385\t\n386\t    pub gamma: png_fixed_point,\n387\t\n388\t    pub rendering_intent: c_int,\n389\t}\n390\t\n391\timpl Default for png_info {\n392\t    fn default() -> Self {\n393\t        unsafe { core::mem::zeroed() }\n394\t    }\n395\t}\n396\t\n397\t/// The internal structure that `png_image::opaque` points to.\n398\t#[repr(C)]\n399\tpub struct png_control {\n400\t    pub png_ptr: png_structp,\n401\t    pub info_ptr: png_infop,\n402\t    pub error_buf: png_voidp,\n403\t\n404\t    pub memory: png_const_bytep,\n405\t    pub size: usize,\n406\t\n407\t    /// bitfield: bit0 = for_write, bit1 = owned_file\n408\t    pub bits: c_uint,\n409\t}\n410\t\n411\timpl png_control {\n412\t    #[inline]\n413\t    pub fn for_write(&self) -> bool {\n414\t        (self.bits & 1) != 0\n415\t    }\n416\t    #[inline]\n417\t    pub fn set_for_write(&mut self, v: bool) {\n418\t        if v {\n419\t            self.bits |= 1\n420\t        } else {\n421\t            self.bits &= !1\n422\t        }\n423\t    }\n424\t    #[inline]\n425\t    pub fn owned_file(&self) -> bool {\n426\t        (self.bits & 2) != 0\n427\t    }\n428\t    #[inline]\n429\t    pub fn set_owned_file(&mut self, v: bool) {\n430\t        if v {\n431\t            self.bits |= 2\n432\t        } else {\n433\t            self.bits &= !2\n434\t        }\n435\t    }\n436\t}\n437\t\n438\timpl Default for png_control {\n439\t    fn default() -> Self {\n440\t        unsafe { core::mem::zeroed() }\n441\t    }\n442\t}\n443\t\n444\t#[allow(unused)]\n445\tfn _unused(_: *mut c_void) {}\n446\t"}]},"parent_tool_use_id":"toolu_bdrk_01K2yGzjxzHLFHuBSXEUodKY","session_id":"bedb3620-db7f-4287-b934-614ec17ac76e","uuid":"512df9db-2b09-4fa7-afdb-c120c261cbcc","timestamp":"2026-08-31T12:39:14.617Z","subagent_type":"general-purpose","task_description":"Translate pngrtran.c 1146-2292"}
