    * instead of linear premultiplied.\n157\t                            * (Belt-and-suspenders for CVE-2025-66293.)\n158\t                            */\n159\t                           if (component > 255*65535)\n160\t                              component = 255*65535;\n161\t\n162\t                           /* So 'component' is scaled by 255*65535 and is\n163\t                            * therefore appropriate for the sRGB-to-linear\n164\t                            * conversion table.\n165\t                            */\n166\t                           component = PNG_sRGB_FROM_LINEAR(component);\n167\t                        }\n168\t                        else\n169\t                        {\n170\t                           /* Compositing was already done on the palette\n171\t                            * entries.  The data is sRGB premultiplied on black.\n172\t                            * Composite with the background in sRGB space.\n173\t                            * This is not gamma-correct, but matches what was\n174\t                            * done to the palette.\n175\t                            */\n176\t                           png_uint_32 background = outrow[c];\n177\t                           component += ((255-alpha) * background + 127) / 255;\n178\t                           if (component > 255)\n179\t                              component = 255;\n180\t                        }\n181\t                     }\n182\t\n183\t                     outrow[c] = (png_byte)component;\n184\t                  }\n185\t               }\n186\t\n187\t               inrow += channels+1; /* components and alpha channel */\n188\t            }\n189\t         }\n190\t      }\n191\t   }\n192\t\n193\t   return 1;\n194\t}\n195\t\n196\t/* The do_local_background case; called when all the following transforms are to\n197\t * be done:\n198\t *\n199\t * PNG_RGB_TO_GRAY\n200\t * PNG_COMPOSITE\n201\t * PNG_GAMMA\n202\t *\n203\t * This is a work-around for the fact that