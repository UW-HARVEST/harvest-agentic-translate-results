 i, 'a'+(i%26));\n      printf(\"hs %d %zu\\n\", i, stbds_hash_string(buf, (size_t)i*0x9E3779B97F4A7C15ull));\n      printf(\"hb %d %zu\\n\", i, stbds_hash_bytes(buf, strlen(buf), (size_t)i));\n    }\n    unsigned char raw[40];\n    for (int i=0;i<40;i++) raw[i] = (unsigned char)(i*37+200);\n    for (int l=0;l<=32;l++) printf(\"hbl %d %zu\\n\", l, stbds_hash_bytes(raw, l, 12345));\n    for (int l=0;l<=32;l++) printf(\"hbl0 %d %zu\\n\", l, stbds_hash_bytes(raw+3, l, 0));\n  } else if (mode == 2) {\n    /* array api */\n    int *a = NULL;\n    a = stbds_arrgrowf(NULL, sizeof(int), 0, 1);\n    printf(\"cap %zu len %zu\\n\", HDR(a)->capacity, HDR(a)->length);\n    for (int i=0;i<100;i++) {\n      if (HDR(a)->length+1 > HDR(a)->capacity) a = stbds_arrgrowf(a, sizeof(int), 1, 0);\n      a[HDR(a)->length++] = i*i;\n    }\n    printf(\"cap %zu len %zu last %d\\n\", HDR(a)->capacity, HDR(a)->length, a[99]);\n    stbds_arrfreef(a);\n    void *b = stbds_arrgrowf(NULL, 24, 5, 3);\n    printf(\"cap %zu len %zu\\n\", HDR(b)->capacity, HDR(b)->length);\n    b = stbds_arrgrowf(b, 24, 100, 0);\n    printf(\"cap %zu len %zu\\n\", HDR(b)->capacity, HDR(b)->length);\n    b = stbds_arrgrowf(b, 24, 0, 2);\n    printf(\"cap %zu len %zu\\n\", HDR(b)->capacity, HDR(b)->length);\n    stbds_arrfreef(b);\n  } else if (mode == 3) {\n    /* binary hashmap via raw api */\n    typedef struct { int key; int value; } kv;\n    kv *t = NULL;\n    ptrdiff_t tmp;\n    for (int i=0;i<200;i++) {\n      int k = i*7%211;\n      t = stbds_hmput_key(t, sizeof(kv), &k, sizeof(int), 0);\n      ptrdiff_t idx = HDR((char*)t - sizeof(kv))->temp;\n      t[idx].key = k; t[idx].value = i;\n    }\n    printf(\"len %zd\\n\", (ptrdiff_t)HDR((char*)t-sizeof(kv))->length - 1);\n    for (int i=0;i<220;i++) {\n      int k=i;\n      t = stbds_hmget_key(t, sizeof(kv), &k, sizeof(int), 0);\n      ptrdiff_t idx = HDR((char*)t-sizeof(kv))->temp;\n      printf(\"get %d %zd %d\\n\", i, idx, idx>=0?t[idx].value:-999);\n    }\n    for (int z=0; z < (ptrdiff_t)HDR((char*)t-sizeof(kv))->length-1; z++)\n      printf(\"iter %d %d %d\\n\", z, t[z].key, t[z].value);\n    for (int i=0;i<220;i+=3) {\n      int k=i;\n      t = stbds_hmdel_key(t, sizeof(kv), &k, sizeof(int), 0, 0);\n      printf(\"del %d %zd\\n\", i, t?HDR((char*)t-sizeof(kv))->temp:0);\n    }\n    for (int z=0; z < (ptrdiff_t)HDR((char*)t-sizeof(kv))->length-1; z++)\n      printf(\"iter2 %d %d %d\\n\", z, t[z].key, t[z].value);\n    for (int i=0;i<220;i++) {\n      int k=i;\n      t = stbds_hmget_key_ts(t, sizeof(kv), &k, sizeof(int), &tmp, 0);\n      printf(\"gts %d %zd\\n\", i, tmp);\n    }\n    stbds_hmfree_func((char*)t - sizeof(kv), sizeof(kv));\n  } else if (mode == 4) {\n    /* string maps: default / strdup / arena */\n    typedef struct { char *key; int value; } kv;\n    for (int m = 0; m < 4; m++) {\n      kv *t = NULL;\n      if (m == 1) t = stbds_shmode_func(sizeof(kv), 1);\n      if (m == 2) t = stbds_shmode_func(sizeof(kv), 2);\n      if (m == 3) t = stbds_shmode_func(sizeof(kv), 3);\n      t = stbds_hmput_default(t, sizeof(kv));\n      t[-1].value = -7;\n      char *keys[150];\n      for (int i=0;i<150;i++) { char b[32]; sprintf(b, \"k%d\", i*13%149); keys[i]=strdup(b); }\n      for (int i=0;i<150;i++) {\n        t = stbds_hmput_key(t, sizeof(kv), keys[i], sizeof(char*), 1);\n        ptrdiff_t idx = HDR((char*)t-sizeof(kv))->temp;\n        t[idx].value = i;\n      }\n      printf(\"m%d len %zd\\n\", m, (ptrdiff_t)HDR((char*)t-sizeof(kv))->length-1);\n      for (int z=0; z<(ptrdiff_t)HDR((char*)t-sizeof(kv))->length-1; z++)\n        printf(\"m%d iter %d %s %d\\n\", m, z, t[z].key, t[z].value);\n      for (int i=0;i<150;i+=2) {\n        t = stbds_hmdel_key(t, sizeof(kv), keys[i], sizeof(char*), 0, 1);\n        printf(\"m%d del %d %zd\\n\", m, i, t?HDR((char*)t-sizeof(kv))->temp:0);\n      }\n      for (int i=0;i<150;i++) {\n        t = stbds_hmget_key(t, sizeof(kv), keys[i], sizeof(char*), 1);\n        ptrdiff_t idx = HDR((char*)t-sizeof(kv))->temp;\n        printf(\"m%d get %d %zd %d\\n\", m, i, idx, t[idx].value);\n      }\n      for (int z=0; z<(ptrdiff_t)HDR((char*)t-sizeof(kv))->length-1; z++)\n        printf(\"m%d iter2 %d %s %d\\n\", m, z, t[z].key, t[z].value);\n      stbds_hmfree_func((char*)t-sizeof(kv), sizeof(kv));\n    }\n  } else if (mode == 5) {\n    /* arena */\n    struct arena_pub a; memset(&a,0,sizeof(a));\n    for (int i=0;i<300;i++) {\n      char b[2000];\n      int n = (i*37)%1500 + 1;\n      memset(b, 'a'+(i%26), n); b[n]=0;\n      char *p = stbds_stralloc((stbds_string_arena*)&a, b);\n      printf(\"sa %d %d %zu %d %d\\n\", i, (int)strlen(p), a.remaining, a.block, a.mode);\n    }\n    stbds_strreset((stbds_string_arena*)&a);\n    printf(\"after reset %p %zu %d %d\\n\", (void*)a.storage, a.remaining, a.block, a.mode);\n  } else if (mode == 6) {\n    for (int i=-5;i<20;i++) printf(\"strkey %s\\n\", strkey(i));\n    stbds_rand_seed(42);\n    printf(\"hs %zu\\n\", stbds_hash_string(\"abc\", 42));\n    sh_geti(6);\n    stbds_rand_seed(0);\n    sh_geti(6);\n  }\n  return 0;\n}\nEOF\ngcc -O0 -g driver.c -o driver_c -L. -l:libharvest-work-AReiP1.so -Wl,-rpath,. 2>&1 | head -20 && echo BUILT","description":"Write and build a C driver exercising the API"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1307,"cache_read_input_tokens":50085,"cache_creation":{"ephemeral_5m_input_tokens":1307,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"fe38f336-3ae4-4387-8047-c188aff405c7","uuid":"5557a4b8-50c0-43e5-af7a-2f7d68e23035","timestamp":"2026-08-27T16:12:32.725Z"}
