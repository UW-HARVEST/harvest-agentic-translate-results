n=0; len<=40; len++)\n        printf(\"a %d %d %zu %zu\\n\", off, len, stbds_hash_bytes(data+off, len, 0), stbds_hash_bytes(data+off,len,0xdeadbeefcafe1234ull));\n    for (int i=0;i<64;i++) data[i] = 0xff;\n    for (int len=0; len<=40; len++) printf(\"b %d %zu\\n\", len, stbds_hash_bytes(data, len, 1));\n    for (int i=0;i<64;i++) data[i] = 0;\n    for (int len=0; len<=40; len++) printf(\"c %d %zu\\n\", len, stbds_hash_bytes(data, len, 0));\n    for (int i=0;i<64;i++) data[i] = (unsigned char)(i*61+7);\n    for (int len=0; len<=40; len++) printf(\"d %d %zu\\n\", len, stbds_hash_bytes(data+1, len, 999));\n    char *strs[] = {\"\", \"a\", \"\\x80\\xff\", \"hello world\", \"\\x01\\x02\\x03\\x04\\x05\\x06\\x07\\x08\\x09\", \"the quick brown fox jumps over the lazy dog\"};\n    for (int i=0;i<6;i++)\n      for (int s=0;s<4;s++)\n        printf(\"e %d %d %zu\\n\", i, s, stbds_hash_string(strs[i], s==0?0:(size_t)0x9e3779b9*s));\n  } else if (mode == 8) {\n    sh_geti(300);\n    sh_geti(301);\n    sh_geti(1000);\n  } else if (mode == 9) {\n    /* 8-byte binary keys, random ops, exercises grow/shrink/rehash */\n    typedef struct { long long key; int value; } kv;\n    kv *t = NULL;\n    for (int step=0; step<4000; step++) {\n      int op = rnd()%3;\n      long long k = (long long)(rnd()%400);\n      if (op == 0) {\n        t = stbds_hmput_key(t, sizeof(kv), &k, sizeof(long long), 0);\n        ptrdiff_t idx = HDR((char*)t-sizeof(kv))->temp;\n        t[idx].key = k; t[idx].value = step;\n        printf(\"p %lld %zd\\n\", k, idx);\n      } else if (op == 1) {\n        t = stbds_hmget_key(t, sizeof(kv), &k, sizeof(long long), 0);\n        ptrdiff_t idx = HDR((char*)t-sizeof(kv))->temp;\n        printf(\"g %lld %zd %d\\n\", k, idx, idx>=0?t[idx].value:-1);\n      } else {\n        t = stbds_hmdel_key(t, sizeof(kv), &k, sizeof(long long), 0, 0);\n        printf(\"d %lld %zd %zu\\n\", k, t?HDR((char*)t-sizeof(kv))->temp:0, t?HDR((char*)t-sizeof(kv))->length:0);\n      }\n    }\n   