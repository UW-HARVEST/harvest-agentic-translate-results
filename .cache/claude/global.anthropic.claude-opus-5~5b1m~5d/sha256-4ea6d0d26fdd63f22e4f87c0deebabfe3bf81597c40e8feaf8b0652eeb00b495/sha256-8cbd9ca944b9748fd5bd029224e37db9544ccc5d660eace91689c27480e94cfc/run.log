on::bits(&c),","-            [0.25f32.to_bits(); 3],","-            \"E3 unexpectedly short-circuited\"","+            cb.map(f32::to_bits),","+            [0.5f32.to_bits(); 3],","+            \"E3 unexpectedly short-circuited for s=0x{:08x}\",","+            big_sub.to_bits()","         );","         for i in 0..3_000 {","             let h = r.range(-500.0, 900.0);"]}],"userModified":false,"replaceAll":false}}
