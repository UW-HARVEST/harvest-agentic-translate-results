  103\t#[unsafe(no_mangle)]\n   104\tpub unsafe extern \"C\" fn hsl_to_rgb(dest: *mut c_float, src: *const c_float) {\n   105\t    // float h = src[0];\n   106\t    // float s = src[1];\n   107\t    // float l = src[2];\n   108\t    let h: c_float = unsafe { *src.add(0) };\n   109\t    let s: c_float = unsafe { *src.add(1) };\n   110\t    let l: c_float = unsafe { *src.add(2) };\n   111\t\n   112\t    // Stores dest[0..3]; the C writes the three slots in ascending order.\n   113\t    let store = |r: c_float, g: c_float, b: c_float| unsafe {\n   114\t        *dest.add(0) = r;\n   115\t        *dest.add(1) = g;\n   116\t        *dest.add(2) = b;\n   117\t    };\n   118\t\n   119\t    // if (s == 0) { dest[0] = dest[1] = dest[2] = l; return; }\n   120\t    // A NaN saturation compares unequal, so it falls through, as in C.\n   121\t    if s == 0.0 {\n   122\t        store(l, l, l);\n   123\t        return;\n   124\t    }\n   125\t\n   126\t    // c = (1.0f - fabsf(2.0f * l - 1.0f)) * s;\n   127\t    let c: c_float = mul_ss(sub_ss(1.0, fabsf(sub_ss(mul_ss(2.0, l), 1.0))), s);\n   128\t    // m = 1.0f * (l - 0.5f * c);\n   129\t    // (multiplying by 1.0f cannot change the value, and the subtraction has\n   130\t    //  already quietened any NaN, so the factor is a no-op)\n   131\t    let m: c_float = sub_ss(l, mul_ss(0.5, c));\n   132\t    // x = c * (1.0f - fabsf(fmodf(h / 60.0f, 2) - 1.0f));\n   133\t    // The C compiler evaluates this product with the `1.0f - ...` term as the\n   134\t    // first source operand, which is what decides the surviving NaN when both\n   135\t    // factors are NaN.\n   136\t    let x: c_float = mul_ss(\n   137\t        sub_ss(1.0, fabsf(sub_ss(fmodf(div_ss(h, 60.0), 2.0), 1.0))),\n   138\t        c,\n   139\t    );\n   140\t\n   141\t    if h >= 0.0 && h < 60.0 {\n   142\t        // dest = { c + m, x + m, m }\n   143\t        store(add_ss(c, m), add_ss(x, m), m);\n   144\t    } else if h >= 60.0 && h < 120.0 {\n   145\t        // dest =