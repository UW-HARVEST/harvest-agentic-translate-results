iseexcept(excepts: c_int) -> c_int;\n}\n\n/// `FE_INVALID` — the invalid-operation flag (bit 0 of the x87/SSE status word;\n/// the value glibc's `<fenv.h>` defines on every architecture it supports).\nconst FE_INVALID: c_int = 0x01;\n\n/// Raise the invalid-operation flag, as the `comiss` in\n/// `if (h >= 0.0f && h < 60.0f)` does when `h` is a NaN of either kind.\n#[inline]\nfn raise_invalid() {\n    feraiseexcept(FE_INVALID);\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3159,"cache_read_input_tokens":175475,"cache_creation":{"ephemeral_5m_input_tokens":3159,"ephemeral_1h_input_tokens":0},"output_tokens":17,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"28b3df08-e114-40c6-835f-7a4bcdb69832","uuid":"bea345e6-6a80-4240-a788-5a317e1a622b","timestamp":"2026-08-26T22:43:35.263Z"}
