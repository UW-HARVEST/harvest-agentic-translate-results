{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Pv3KBranP9TQwxFGqtD8Yz","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/`.\n2\t//!\n3\t//! Public ABI (the complete set of symbols exported by the C shared library,\n4\t//! per `nm -D`):\n5\t//!   * `hsl_to_rgb`   (declared in `c_src/include/lib.h`, defined in\n6\t//!                     `c_src/src/lib.c`)\n7\t//!\n8\t//! The translation is deliberately literal: the operation order, the order of\n9\t//! the comparisons, and the quirks of the original are all preserved. In\n10\t//! particular the third branch of the dispatch chain tests `h < 120.0f` twice\n11\t//! instead of `h >= 120.0f && h < 180.0f`; that is a bug in the C, so it is\n12\t//! reproduced here verbatim rather than fixed.\n13\t//!\n14\t//! To get bit-for-bit identical results even for exotic inputs (infinities and\n15\t//! NaNs), the arithmetic goes through small helpers that reproduce the exact\n16\t//! NaN-propagation rules of the scalar SSE instructions the C compiler emits\n17\t//! (`addss`/`subss`/`mulss`/`divss`): if the first source operand is a NaN the\n18\t//! result is that NaN made quiet, otherwise if the second source operand is a\n19\t//! NaN the result is that NaN made quiet. Relying on plain `+`/`-`/`*` would\n20\t//! leave the choice of operand order (and hence the NaN sign/payload that\n21\t//! survives) up to LLVM's canonicalisation.\n22\t\n23\t//!\n24\t//! The helpers nevertheless *always* perform the hardware operation, even when\n25\t//! its result is going to be discarded in favour of a forwarded NaN, because the\n26\t//! instruction's side effect on the floating-point status word is observable\n27\t//! (`fetestexcept`, or a trap if the caller used `feenableexcept`). Only the\n28\t//! *value* is overridden.\n29\t//!\n30\t//! For the same reason the hue dispatch raises `FE_INVALID` explicitly for a NaN\n31\t//! hue: the C compiles `h >= 0.0f` and friends to **`comiss`**, the *signalling*\n32\t//! compare, which raises the invalid-operation flag even for a quiet NaN,\n33\t//! whereas Rust's `>=`/`<` lower to the quiet `ucomiss`.\n34\t\n35\t#![allow(clippy::missing_safety_doc)]\n36\t\n37\tuse std::ffi::c_float;\n38\tuse std::ffi::c_int;\n39\tuse std::hint::black_box;\n40\t\n41\tunsafe extern \"C\" {\n42\t    /// `float fmodf(float, float)` from libm, exactly as used by the C source.\n43\t    safe fn fmodf(x: c_float, y: c_float) -> c_float;\n44\t    /// `<fenv.h>`; used to reproduce the side effect of the C's signalling\n45\t    /// `comiss` hue comparisons.\n46\t    safe fn feraiseexcept(excepts: c_int) -> c_int;\n47\t}\n48\t\n49\t/// `FE_INVALID` — the invalid-operation flag, bit 0 of the x87/SSE status word.\n50\tconst FE_INVALID: c_int = 0x01;\n51\t\n52\t/// Raise the invalid-operation flag, as the `comiss` that the C compiler emits\n53\t/// for `if (h >= 0.0f && h < 60.0f)` does when `h` is a NaN of *either* kind.\n54\t#[inline]\n55\tfn raise_invalid() {\n56\t    feraiseexcept(FE_INVALID);\n57\t}\n58\t\n59\t/// Set the \"quiet\" bit of a NaN, as every SSE arithmetic instruction does when\n60\t/// it forwards a source NaN to its result.\n61\t#[inline]\n62\tfn quiet(v: c_float) -> c_float {\n63\t    c_float::from_bits(v.to_bits() | 0x0040_0000)\n64\t}\n65\t\n66\t/// SSE scalar NaN-operand selection: `src1` wins over `src2`.\n67\t#[inline]\n68\tfn nan_result(src1: c_float, src2: c_float) -> Option<c_float> {\n69\t    if src1.is_nan() {\n70\t        Some(quiet(src1))\n71\t    } else if src2.is_nan() {\n72\t        Some(quiet(src2))\n73\t    } else {\n74\t        None\n75\t    }\n76\t}\n77\t\n78\t/// `addss src1, src2`\n79\t///\n80\t/// `black_box` keeps the addition itself alive even on the paths where its value\n81\t/// is discarded, so that the instruction's effect on the FP status word (e.g.\n82\t/// `FE_INVALID` for a signalling-NaN operand) still happens exactly as in the C.\n83\t#[inline]\n84\tfn add_ss(src1: c_float, src2: c_float) -> c_float {\n85\t    let raw = black_box(src1 + src2);\n86\t    match nan_result(src1, src2) {\n87\t        Some(v) => v,\n88\t        None => raw,\n89\t    }\n90\t}\n91\t\n92\t/// `subss src1, src2`\n93\t#[inline]\n94\tfn sub_ss(src1: c_float, src2: c_float) -> c_float {\n95\t    let raw = black_box(src1 - src2);\n96\t    match nan_result(src1, src2) {\n97\t        Some(v) => v,\n98\t        None => raw,\n99\t    }\n100\t}\n101\t\n102\t/// `mulss src1, src2`\n103\t#[inline]\n104\tfn mul_ss(src1: c_float, src2: c_float) -> c_float {\n105\t    let raw = black_box(src1 * src2);\n106\t    match nan_result(src1, src2) {\n107\t        Some(v) => v,\n108\t        None => raw,\n109\t    }\n110\t}\n111\t\n112\t/// `divss src1, src2`\n113\t#[inline]\n114\tfn div_ss(src1: c_float, src2: c_float) -> c_float {\n115\t    let raw = black_box(src1 / src2);\n116\t    match nan_result(src1, src2) {\n117\t        Some(v) => v,\n118\t        None => raw,\n119\t    }\n120\t}\n121\t\n122\t/// `fabsf` — clears the sign bit (`andps` with `0x7fffffff`), NaNs included.\n123\t#[inline]\n124\tfn fabsf(v: c_float) -> c_float {\n125\t    c_float::from_bits(v.to_bits() & 0x7fff_ffff)\n126\t}\n127\t\n128\t/// `void hsl_to_rgb(float *dest, const float *src);`\n129\t///\n130\t/// `src[0]` is the hue in degrees, `src[1]` the saturation and `src[2]` the\n131\t/// lightness; the corresponding red, green and blue components are stored in\n132\t/// `dest[0]`, `dest[1]` and `dest[2]`.\n133\t///\n134\t/// # Safety\n135\t///\n136\t/// `src` must be valid for reads of three `float`s and `dest` valid for writes\n137\t/// of three `float`s — the same contract the C function imposes.\n138\t#[unsafe(no_mangle)]\n139\tpub unsafe extern \"C\" fn hsl_to_rgb(dest: *mut c_float, src: *const c_float) {\n140\t    // float h = src[0];\n141\t    // float s = src[1];\n142\t    // float l = src[2];\n143\t    let h: c_float = unsafe { *src.add(0) };\n144\t    let s: c_float = unsafe { *src.add(1) };\n145\t    le