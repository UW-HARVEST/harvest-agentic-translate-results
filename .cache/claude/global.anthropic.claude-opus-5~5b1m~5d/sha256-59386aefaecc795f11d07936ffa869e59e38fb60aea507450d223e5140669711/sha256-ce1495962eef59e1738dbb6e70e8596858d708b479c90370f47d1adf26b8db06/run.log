{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Qr1Hut5RakJdYZvh5BejXw","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/`.\n2\t//!\n3\t//! Public ABI (mirrors `c_src/include/lib.h`):\n4\t//!   void rgb_to_hsv(float *dest, const float *src);\n5\t//!\n6\t//! The translation is intentionally literal: operation order, comparison\n7\t//! direction (which matters for NaN inputs), the `delta == 0 || max == 0`\n8\t//! early-out, and the order of the stores into `dest` all match the C exactly.\n9\t\n10\t#![allow(clippy::missing_safety_doc)]\n11\t\n12\tuse std::ffi::c_float;\n13\t\n14\t/// Literal translation of the C `MIN(a, b)` expansion\n15\t/// `(((a) < (b)) ? (a) : (b))`.\n16\t///\n17\t/// This is *not* `f32::min`: for NaN operands the C ternary yields `b`\n18\t/// whenever the `<` comparison is false, which differs from `f32::min`'s\n19\t/// NaN-suppressing behaviour. Reproducing the C exactly requires the\n20\t/// raw comparison.\n21\t#[inline]\n22\tfn c_min(a: c_float, b: c_float) -> c_float {\n23\t    if a < b {\n24\t        a\n25\t    } else {\n26\t        b\n27\t    }\n28\t}\n29\t\n30\t/// Literal translation of the C `MAX(a, b)` expansion\n31\t/// `(((a) > (b)) ? (a) : (b))`. See [`c_min`] for why `f32::max` is avoided.\n32\t#[inline]\n33\tfn c_max(a: c_float, b: c_float) -> c_float {\n34\t    if a > b {\n35\t        a\n36\t    } else {\n37\t        b\n38\t    }\n39\t}\n40\t\n41\t/// Convert an RGB triple to HSV.\n42\t///\n43\t/// `src` must point to at least 3 readable `float`s, `dest` to at least 3\n44\t/// writable `float`s — the same contract the C function imposes.\n45\t///\n46\t/// Hue is returned in degrees `[0, 360)`, saturation and value in `[0, 1]`\n47\t/// for in-range inputs. Out-of-range inputs are not validated, matching C.\n48\t#[unsafe(no_mangle)]\n49\tpub unsafe extern \"C\" fn rgb_to_hsv(dest: *mut c_float, src: *const c_float) {\n50\t    // float r = src[0]; float g = src[1]; float b = src[2];\n51\t    // All three loads happen up front, exactly as in the C, so an aliasing\n52\t    // `dest == src` call behaves identically.\n53\t    let r: c_float = unsafe { *src.add(0) };\n54\t    let g: c_float = unsafe { *src.add(1) };\n55\t    let b: c_float = unsafe { *src.add(2) };\n56\t\n57\t    let mut h: c_float = 0.0;\n58\t    let mut s: c_float = 0.0;\n59\t    let v: c_float;\n60\t\n61\t    // float min = r; float max = r;\n62\t    let mut min: c_float = r;\n63\t    let mut max: c_float = r;\n64\t    let delta: c_float;\n65\t\n66\t    min = c_min(min, g);\n67\t    min = c_min(min, b);\n68\t    max = c_max(max, g);\n69\t    max = c_max(max, b);\n70\t\n71\t    delta = max - min;\n72\t    v = max;\n73\t\n74\t    if delta == 0.0 || max == 0.0 {\n75\t        unsafe {\n76\t            *dest.add(0) = h;\n77\t            *dest.add(1) = s;\n78\t            *dest.add(2) = v;\n79\t        }\n80\t        return;\n81\t    }\n82\t\n83\t    s = delta / max;\n84\t\n85\t    if r == max {\n86\t        h = (g - b) / delta;\n87\t    } else if g == max {\n88\t        h = 2.0 + (b - r) / delta;\n89\t    } else {\n90\t        h = 4.0 + (r - g) / delta;\n91\t    }\n92\t\n93\t    h *= 60.0;\n94\t\n95\t    if h < 0.0 {\n96\t        h += 360.0;\n97\t    }\n98\t\n99\t    unsafe {\n100\t        *dest.add(0) = h;\n101\t        *dest.add(1) = s;\n102\t        *dest.add(2) = v;\n103\t    }\n104\t}\n105\t"}]},"parent_tool_use_id":null,"session_id":"00f7396f-3edb-470c-ace3-794ad5e4b7df","uuid":"db7ebaad-969f-4c18-bbb7-8dd2a234e198","timestamp":"2026-08-27T01:03:00.010Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-3CiLnC/translation/src/lib.rs","content":"//! Rust translation of the C library in `c_src/`.\n//!\n//! Public ABI (mirrors `c_src/include/lib.h`):\n//!   void rgb_to_hsv(float *dest, const float *src);\n//!\n//! The translation is intentionally literal: operation order, comparison\n//! direction (which matters for NaN inputs), the `delta == 0 || max == 0`\n//! early-out, and the order of the stores into `dest` all match the C exactly.\n\n#![allow(clippy::missing_safety_doc)]\n\nuse std::ffi::c_float;\n\n/// Literal translation of the C `MIN(a, b)` expansion\n/// `(((a) < (b)) ? (a) : (b))`.\n///\n/// This is *not* `f32::min`: for NaN operands the C ternary yields `b`\n/// whenever the `<` comparison is false, which differs from `f32::min`'s\n/// NaN-suppressing behaviour. Reproducing the C exactly requires the\n/// raw comparison.\n#[inline]\nfn c_min(a: c_float, b: c_float) -> c_float {\n    if a < b {\n        a\n    } else {\n        b\n    }\n}\n\n/// Literal translation of the C `MAX(a, b)` expansion\n/// `(((a) > (b)) ? (a) : (b))`. See [`c_min`] for why `f32::max` is avoided.\n#[inline]\nfn c_max(a: c_float, b: c_float) -> c_float {\n    if a > b {\n        a\n    } else {\n        b\n    }\n}\n\n/// Convert an RGB triple to HSV.\n///\n/// `src` must point to at least 3 readable `float`s, `dest` to at least 3\n/// writable `float`s — the same contract the C function imposes.\n///\n/// Hue is returned in degrees `[0, 360)`, saturation and value in `[0, 1]`\n/// for in-range inputs. Out-of-range inputs are not validated, matching C.\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn rgb_to_hsv(dest: *mut c_float, src: *const c_float) {\n    // float r = src[0]; float g = src[1]; float b = src[2];\n    // All three loads happen up front, exactly as in the C, so an aliasing\n    // `dest == src` call behaves identically.\n    let r: c_float = unsafe { *src.add(0) };\n    let g: c_float = unsafe { *src.add(1) };\n    let b: c_float = unsafe { *src.add(2) };\n\n    let mut h: c_float = 0.0;\n    let mut s: c_float = 0.0;\n    let v: c_float;\n\n    // float min = r; float max = r;\n    let mut min: c_float = r;\n    let mut max: c_float = r;\n    let delta: c_float;\n\n    min = c_min(min, g);\n    min = c_min(min, b);\n    max = c_max(max, g);\n    max = c_max(max, b);\n\n    delta = max - min;\n    v = max;\n\n    if delta == 0.0 || max == 0.0 {\n        unsafe {\n            *dest.add(0) = h;\n            *dest.add(1) = s;\n            *dest.add(2) = v;\n        }\n        return;\n    }\n\n    s = delta / max;\n\n    if r == max {\n        h = (g - b) / delta;\n    } else if g == max {\n        h = 2.0 + (b - r) / delta;\n    } else {\n        h = 4.0 + (r - g) / delta;\n    }\n\n    h *= 60.0;\n\n    if h < 0.0 {\n        h += 360.0;\n    }\n\n    unsafe {\n        *dest.add(0) = h;\n        *dest.add(1) = s;\n        *dest.add(2) = v;\n    }\n}\n","numLines":105,"startLine":1,"totalLines":105}}}
