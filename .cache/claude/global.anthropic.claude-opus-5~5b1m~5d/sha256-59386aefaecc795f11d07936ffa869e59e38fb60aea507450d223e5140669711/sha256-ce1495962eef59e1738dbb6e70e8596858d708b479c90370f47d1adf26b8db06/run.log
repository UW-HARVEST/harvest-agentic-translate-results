"+  case \"$verdict\" in","+    CAUGHT) printf '  OK   %-36s caught by: %s\\n' \"$m\" \"$names\" ;;","+    PASSED) printf '  FAIL %-36s *** BLIND SPOT: suite did not notice ***\\n' \"$m\"; fails=$((fails+1)) ;;","+    *)      printf '  FAIL %-36s %s (see %s)\\n' \"$m\" \"$verdict\" \"$WORK/$m\"; fails=$((fails+1)) ;;","+  esac"," done"," "," echo","-echo \"mutations caught: $pass   uncaught: $fail\"","-if [ ${#UNCAUGHT[@]} -gt 0 ]; then","-  echo \"BLIND SPOTS: ${UNCAUGHT[*]}\"","-  exit 1","+echo \"=== KNOWN_EQUIVALENT: provably output-identical, suite must still PASS ===\"","+for m in $KNOWN_EQUIVALENT; do","+  r=$(run_one \"$m\"); verdict=${r%% *}; names=${r#* }","+  case \"$verdict\" in","+    PASSED) printf '  OK   %-36s not flagged (correct: equivalent mutant)\\n' \"$m\" ;;","+    CAUGHT) printf '  FAIL %-36s flagged by %s -- equivalence claim is WRONG\\n' \"$m\" \"$names\"; fails=$((fails+1)) ;;","+    *)      printf '  FAIL %-36s %s\\n' \"$m\" \"$verdict\"; fails=$((fails+1)) ;;","+  esac","+done","+","+echo","+if [ \"$fails\" -eq 0 ]; then","+  echo \"mutation check PASSED: every real bug detected, every equivalent mutant ignored.\"","+  rm -rf \"$WORK\"","+  exit 0"," fi","-echo \"All injected bugs were detected -- the differential suite has teeth.\"","+echo \"mutation check FAILED: $fails problem(s). Artifacts kept in $WORK\"","+exit 1"]}],"originalFile":"#!/usr/bin/env bash\n# Negative control for the Phase B/C suites.\n#\n# Injects deliberate, individually plausible bugs into a COPY of the Rust\n# translation and asserts the differential suite CATCHES each one. A suite that\n# passes on the real translation proves nothing unless it also fails on a\n# broken one; this script supplies that evidence.\n#\n# Never touches translation/src/lib.rs itself -- all work happens in $TMPDIR.\nset -uo pipefail\n\nHERE=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nC_SO=\"$(ls \"$HERE\"/../c_src/build/lib*.so | head -1)\"\nWORK=\"${TMPDIR:-/tmp}/mutants\"\nrm -rf \"$WORK\"; mkdir -p \"$WORK\"\n\npython3 - \"$WORK\" <<'PY'\nimport os, shutil, sys\nwork = sys.argv[1]\norig = open(os.path.join(os.path.dirname(os.path.abspath(__file__)), 'src/lib.rs')).read() \\\n    if False else None\nPY\n\nSRC=\"$HERE/src/lib.rs\"\n\n# name|python-repr-of-old|python-repr-of-new\nmutations=$(cat <<'EOF'\nM1_min_max_nan_semantics\nM2_drop_short_circuit_max_zero\nM3_branch_order_r_before_g\nM4_wrap_constant\nM5_wrap_condition_le\nM6_reload_src_after_store\nEOF\n)\n\npass=0; fail=0\ndeclare -a UNCAUGHT\n\nfor m in $mutations; do\n  d=\"$WORK/$m\"\n  mkdir -p \"$d\"\n  cp -r \"$HERE/src\" \"$HERE/tests\" \"$HERE/Cargo.toml\" \"$HERE/Cargo.lock\" \"$d/\" 2>/dev/null\n  mkdir -p \"$d/.cargo\"; printf '[net]\\noffline = true\\n' > \"$d/.cargo/config.toml\"\n\n  python3 - \"$d/src/lib.rs\" \"$m\" <<'PY'\nimport sys\npath, mut = sys.argv[1], sys.argv[2]\ns = open(path).read()\nbefore = s\n\nMIN_BODY = \"    if a < b {\\n        a\\n    } else {\\n        b\\n    }\\n\"\nMAX_BODY = \"    if a > b {\\n        a\\n    } else {\\n        b\\n    }\\n\"\n\nif mut == \"M1_min_max_nan_semantics\":\n    # Use f32::min/max, which suppress NaN and normalise signed zeros -- the\n    # single most likely mistake when translating the C ternary macros.\n    s = s.replace(MIN_BODY, \"    a.min(b)\\n\", 1)\n    s = s.replace(MAX_BODY, \"    a.max(b)\\n\", 1)\nelif mut == \"M2_drop_short_circuit_max_zero\":\n    s = s.replace(\"if delta == 0.0 || max == 0.0 {\", \"if delta == 0.0 {\", 1)\nelif mut == \"M3_branch_order_r_before_g\":\n    # Test g == max before r == max (i.e. get the tie precedence wrong).\n    s = s.replace(\"if r == max {\", \"if r == max && g != max {\", 1)\nelif mut == \"M4_wrap_constant\":\n    s = s.replace(\"h += 360.0;\", \"h += 359.9;\", 1)\nelif mut == \"M5_wrap_condition_le\":\n    s = s.replace(\"if h < 0.0 {\", \"if h <= 0.0 {\", 1)\nelif mut == \"M6_reload_src_after_store\":\n    # Semantically identical for disjoint buffers; differs only under aliasing.\n    old = (\"    unsafe {\\n\"\n           \"        *dest.add(0) = h;\\n\"\n           \"        *dest.add(1) = s;\\n\"\n           \"        *dest.add(2) = v;\\n\"\n           \"    }\\n}\")\n    new = (\"    unsafe {\\n\"\n           \"        *dest.add(0) = h;\\n\"\n           \"        *dest.add(1) = s;\\n\"\n           \"        *dest.add(2) = c_max(c_max(*src.add(0), *src.add(1)), *src.add(2));\\n\"\n           \"    }\\n}\")\n    s = s.replace(old, new, 1)\nelse:\n    sys.exit(\"unknown mutation \" + mut)\n\nif s == before:\n    sys.exit(\"MUTATION %s DID NOT APPLY -- pattern not found\" % mut)\nopen(path, \"w\").write(s)\nPY\n  if [ $? -ne 0 ]; then echo \"!! $m failed to apply\"; fail=$((fail+1)); continue; fi\n\n  ( cd \"$d\" && cargo build -q 2>/dev/null && cargo build -q --release 2>/dev/null )\n  if [ $? -ne 0 ]; then echo \"!! $m did not compile\"; fail=$((fail+1)); continue; fi\n\n  out=\"$d/test.log\"\n  ( cd \"$d\" && HARVEST_C_SO=\"$C_SO\" \\\n      cargo test -q --test phase_b_configs --test phase_c_errors 2>&1 ) > \"$out\"\n\n  caught=$(grep -cE '^(test )?.*\\bFAILED\\b|^failures:' \"$out\")\n  names=$(sed -n '/^failures:$/,$p' \"$out\" | grep -E '^    (cfg|err|probe)' | sort -u | tr '\\n' ' ')\n  if grep -q 'test result: FAILED' \"$out\"; then\n    echo \"CAUGHT   $m\"\n    echo \"         by: ${names:-<see log>}\"\n    pass=$((pass+1))\n  else\n    echo \"UNCAUGHT $m   <-- BLIND SPOT\"\n    UNCAUGHT+=(\"$m\")\n    fail=$((fail+1))\n  fi\ndone\n\necho\necho \"mutations caught: $pass   uncaught: $fail\"\nif [ ${#UNCAUGHT[@]} -gt 0 ]; then\n  echo \"BLIND SPOTS: ${UNCAUGHT[*]}\"\n  exit 1\nfi\necho \"All injected bugs were detected -- the differential suite has teeth.\"\n","userModified":false}}
