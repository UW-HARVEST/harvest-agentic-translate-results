\nassert old_loop in s\ns = s.replace(old_loop, new_loop, 1)\n\nold_child = '''    let p = Pair::load();\n    let f = if which == \"c\" { p.c_fn } else { p.rust_fn };\n    let src = [0.5f32, 0.25, 0.75];\n    // Deliberate UB, mirroring the C contract violation. Expected to crash.\n    unsafe { f(std::ptr::null_mut(), src.as_ptr()) };\n    std::process::exit(0);'''\nnew_child = '''    let p = Pair::load();\n    let f = if which == \"c\" { p.c_fn } else { p.rust_fn };\n    let src = [0.5f32, 0.25, 0.75];\n    let mut dest = [0f32; 3];\n    let arg = std::env::var(\"HARVEST_NULL_ARG\").unwrap_or_else(|_| \"dest\".into());\n    // Deliberate UB, mirroring the C contract violation. Expected to crash.\n    unsafe {\n        match arg.as_str() {\n            \"src\" => f(dest.as_mut_ptr(), std::ptr::null()),\n            \"both\" => f(std::ptr::null_mut(), std::ptr::null()),\n            _ => f(std::ptr::null_mut(), src.as_ptr()),\n        }\n    };\n    std::process::exit(0);'''\nassert old_child in s\ns = s.replace(old_child, new_child, 1)\n\n# Add sibling tests for null src / both by re-running the same body with the env set.\nextra = '''\n/// Row 12, `src == NULL` variant: same comparison, NULL passed as the *input*\n/// pointer instead of the output pointer.\n#[test]\nfn err12c_null_src_same_fatal_signal() {\n    std::env::set_var(\"HARVEST_NULL_ARG\", \"src\");\n    err12b_null_pointer_same_fatal_signal();\n    std::env::remove_var(\"HARVEST_NULL_ARG\");\n}\n\n/// Row 12, both-NULL variant.\n#[test]\nfn err12d_both_null_same_fatal_signal() {\n    std::env::set_var(\"HARVEST_NULL_ARG\", \"both\");\n    err12b_null_pointer_same_fatal_signal();\n    std::env::remove_var(\"HARVEST_NULL_ARG\");\n}\n'''\nanchor = '''/// Child helper for `err12b`. Never run as part of the normal suite.'''\nassert anchor in s\ns = s.replace(anchor, extra + \"\\n\" + anchor, 1)\nopen(f,'w').write(s)\nprint(\"ok\")\nPYEOF\ngrep -n \"err12c\\|err12d\\|HARVEST_NULL_ARG\" tests/errors.rs | head"