st.add(0) = h;\n        *dest.add(1) = s;\n        *dest.add(2) = v;\n    }\n}\" \"        *dest.add(0) = h;\n        *dest.add(1) = s;\n        *dest.add(2) = c_max(c_max(*src.add(0), *src.add(1)), *src.add(2));\n    }\n}\"\n# Same slip on the early-out path.\nmutate kill \"early-out re-reads src after writing dest[0] (aliasing-visible)\" \\\\\n  \"            *dest.add(0) = h;\n            *dest.add(1) = s;\n            *dest.add(2) = v;\n        }\n        return;\" \"            *dest.add(0) = h;\n            *dest.add(1) = s;\n            *dest.add(2) = c_max(c_max(*src.add(0), *src.add(1)), *src.add(2));\n        }\n        return;\"''')\nopen(f,'w').write(s)\nprint(\"ok\")\nPYEOF\nbash -n mutation_check.sh && echo \"syntax ok\"; timeout 600 ./mutation_check.sh 2>&1 | tail -45","is_backgrounded":false,"task_type":"local_bash","uuid":"b3a0764a-a80d-4e39-82e3-d9c6e6a864c9","session_id":"e7cb0090-07ae-4882-8a3e-5ec98bc89d81"}
