{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01HMwH9wSiuwiLZjnbtP9J1Q","type":"tool_result","content":"1\t/*\n2\t * Copyright 2025 MIT Lincoln Laboratory\n3\t * Permission is hereby granted, free of charge,\n4\t * to any person obtaining a copy of this software\n5\t * and associated documentation files (the \"Software\"),\n6\t * to deal in the Software without restriction,\n7\t * including without limitation the rights to use, copy,\n8\t * modify, merge, publish, distribute, sublicense,\n9\t * and/or sell copies of the Software,\n10\t * and to permit persons to whom the Software is furnished to do so,\n11\t * subject to the following conditions:\n12\t *\n13\t * The above copyright notice and this permission notice\n14\t * shall be included in all copies or substantial portions of the Software.\n15\t *\n16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n18\t * THE WARRANTIES OF MERCHANTABILITY,\n19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n24\t */\n25\t\n26\t//! Faithful Rust translation of `c_src/src/lib.c`.\n27\t//!\n28\t//! The buffer is modelled as a mutable byte slice plus an explicit logical\n29\t//! length, exactly like the `uint8_t *buf, size_t len` pairs of the C code.\n30\t//! Every operation is reproduced step by step (including the quirks of the\n31\t//! original implementation); `memmove` becomes `copy_within` /\n32\t//! `copy_from_slice`, which have the same \"as if copied through a temporary\"\n33\t//! semantics for overlapping ranges.\n34\t\n35\t/// Main entrance function - processes buffer based on operation flags\n36\t///\n37\t/// * `buffer` - Input/output buffer\n38\t/// * `length` - Buffer length\n39\t/// * `flags`  - Bit flags:\n40\t///              bit 0: rotate buffer\n41\t///              bit 1: compact runs\n42\t///              bit 2: remove duplicates\n43\t///              bit 3: interleave halves\n44\t///              bit 4: reverse segments\n45\t/// * `param1` - Operation-specific parameter (rotation offset, run threshold, segment size)\n46\t/// * `param2` - Secondary parameter (preserve order flag, etc)\n47\t///\n48\t/// Returns the new buffer length after processing.\n49\tpub fn process_buffer(\n50\t    buffer: &mut [u8],\n51\t    length: usize,\n52\t    flags: u32,\n53\t    param1: i32,\n54\t    param2: i32,\n55\t) -> usize {\n56\t    let mut new_len = length;\n57\t\n58\t    /* `buffer == NULL` cannot be expressed with a slice; an empty slice is the\n59\t     * closest analogue and is handled together with `length == 0`. */\n60\t    if buffer.is_empty() || length == 0 {\n61\t        return 0;\n62\t    }\n63\t\n64\t    /* Branch based on multiple flags - creates diverse control flow */\n65\t    if flags & 0x01 != 0 {\n66\t        /* Rotate */\n67\t        let offset = param1.wrapping_rem(length as i32);\n68\t        if offset != 0 {\n69\t            rotate_buffer(buffer, length, offset);\n70\t        }\n71\t    }\n72\t\n73\t    if flags & 0x02 != 0 {\n74\t        /* Compact runs */\n75\t        let threshold: u8 = if param1 > 0 && param1 <= 255 {\n76\t            param1 as u8\n77\t        } else {\n78\t            3\n79\t        };\n80\t        new_len = compact_runs(buffer, new_len, threshold);\n81\t    }\n82\t\n83\t    if flags & 0x04 != 0 {\n84\t        /* Remove duplicates */\n85\t        let preserve = param2 != 0;\n86\t        new_len = remove_duplicates(buffer, new_len, preserve);\n87\t    }\n88\t\n89\t    /* Conditional chaining based on length */\n90\t    if (flags & 0x08 != 0) && new_len >= 2 {\n91\t        /* Interleave */\n92\t        interleave_halves(buffer, new_len);\n93\t    }\n94\t\n95\t    if (flags & 0x10 != 0) && new_len >= 4 {\n96\t        /* Reverse segments */\n97\t        let seg_size: usize = if param1 > 0 { param1 as usize } else { 4 };\n98\t        if seg_size <= new_len {\n99\t            reverse_segments(buffer, new_len, seg_size);\n100\t        }\n101\t    }\n102\t\n103\t    new_len\n104\t}\n105\t\n106\t/// Rotate buffer by offset positions (positive = right, negative = left)\n107\t/// Uses multiple memmove operations with different patterns\n108\tfn rotate_buffer(buf: &mut [u8], len: usize, offset: i32) {\n109\t    if len <= 1 {\n110\t        return;\n111\t    }\n112\t\n113\t    /* Normalize offset */\n114\t    let mut offset = offset.wrapping_rem(len as i32);\n115\t    if offset < 0 {\n116\t        offset += len as i32;\n117\t    }\n118\t    if offset == 0 {\n119\t        return;\n120\t    }\n121\t    let offset = offset as usize;\n122\t\n123\t    /* Use reversal algorithm with memmove */\n124\t    let mut temp = [0u8; 256];\n125\t    let chunk = if offset < 256 { offset } else { 256 };\n126\t\n127\t    if offset < len / 2 {\n128\t        /* Small offset: move prefix aside, shift main part, restore prefix */\n129\t        let mut i = 0usize;\n130\t        while i < offset {\n131\t            let copy_len = if offset - i < chunk { offset - i } else { chunk };\n132\t            temp[..copy_len].copy_from_slice(&buf[i..i + copy_len]);\n133\t            buf.copy_within(offset..len, i);\n134\t            let dst = len - offset;\n135\t            temp_to_buf(buf, dst, &temp, copy_len);\n136\t            i += chunk;\n137\t        }\n138\t    } else {\n139\t        /* Large offset: work from the right */\n140\t        let shift = len - offset;\n141\t        temp[..shift].copy_from_slice(&buf[..shift]);\n142\t        buf.copy_within(shift..shift + offset, 0);\n143\t        temp_to_buf(buf, offset, &temp, shift);\n144\t    }\n145\t}\n146\t\n147\t/// Helper mirroring `memmove(buf + dst, temp, n)`.\n148\tfn temp_to_buf(buf: &mut [u8], dst: usize, temp: &[u8], n: usize) {\n149\t    buf[dst..dst + n].copy_from_slice(&temp[..n]);\n150\t}\n151\t\n152\t/// Compact consecutive runs of same value if run length >= threshold\n153\t/// Complex nested loops with multiple data paths\n154\tfn compact_runs(buf: &mut [u8], len: usize, threshold: u8) -> usize {\n155\t    let mut len = len;\n156\t    let mut read = 0usize;\n157\t    let mut write = 0usize;\n158\t\n159\t    while read < len {\n160\t        let current = buf[read];\n161\t        let mut run_len = 1usize;\n162\t\n163\t        /* Count run length */\n164\t        while read + run_len < len && buf[read + run_len] == current {\n165\t            run_len += 1;\n166\t        }\n167\t\n168\t        if run_len >= threshold as usize {\n169\t            /* Compact to 2 elements: value, count */\n170\t            if run_len > 255 {\n171\t                run_len = 255; /* Cap at 255 */\n172\t            }\n173\t\n174\t            buf[write] = current;\n175\t            write += 1;\n176\t            buf[write] = run_len as u8;\n177\t            write += 1;\n178\t\n179\t            /* Shift remaining data if needed */\n180\t            if read + run_len < len {\n181\t                let remaining = len - (read + run_len);\n182\t                buf.copy_within(read + run_len..read + run_len + remaining, write);\n183\t            }\n184\t            len = write + (len - (read + run_len));\n185\t            read = write;\n186\t        } else {\n187\t            /* Keep run as-is, but may need to move it */\n188\t            if write != read {\n189\t                buf.copy_within(read..read + run_len, write);\n190\t            }\n191\t            write += run_len;\n192\t            read += run_len;\n193\t        }\n194\t    }\n195\t\n196\t    len\n197\t}\n198\t\n199\t/// Remove duplicate values - different paths for ordered/unordered\n200\tfn remove_duplicates(buf: &mut [u8], len: usize, preserve_order: bool) -> usize {\n201\t    if len <= 1 {\n202\t        return len;\n203\t    }\n204\t\n205\t    if preserve_order {\n206\t        /* Preserve order: O(n^2) but maintains sequence */\n207\t        let mut write = 1usize;\n208\t        for i in 1..len {\n209\t            let mut j = 0usize;\n210\t            while j < write {\n211\t                if buf[i] == buf[j] {\n212\t                    break;\n213\t                }\n214\t                j += 1;\n215\t            }\n216\t            if j == write {\n217\t                if write != i {\n218\t                    buf[write] = buf[i];\n219\t                }\n220\t                write += 1;\n221\t            }\n222\t        }\n223\t        write\n224\t    } else {\n225\t        /* Don't preserve order: sort-like approach with memmove */\n226\t        let mut seen = [0u8; 256];\n227\t        let mut write = 0usize;\n228\t\n229\t        for i in 0..len {\n230\t            if seen[buf[i] as usize] == 0 {\n231\t                seen[buf[i] as usize] = 1;\n232\t                if write != i {\n233\t                    /* Swap to front */\n234\t                    let temp = buf[write];\n235\t                    buf[write] = buf[i];\n236\t                    buf[i] = temp;\n237\t                }\n238\t                write += 1;\n239\t            }\n240\t        }\n241\t        write\n242\t    }\n243\t}\n244\t\n245\t/// Interleave first and second halves of buffer\n246\t/// Complex memmove pattern with temporary storage\n247\tfn interleave_halves(buf: &mut [u8], len: usize) {\n248\t    if len < 2 {\n249\t        return;\n250\t    }\n251\t\n252\t    let half = len / 2;\n253\t    let odd = len % 2;\n254\t    let mut temp = [0u8; 512];\n255\t\n256\t    if half <= 256 {\n257\t        /* Use temp buffer for small sizes */\n258\t        temp[..half].copy_from_slice(&buf[..half]);\n259\t\n260\t        for i in 0..half {\n261\t            buf[i * 2 + 1] = buf[half + i];\n262\t            buf[i * 2] = temp[i];\n263\t        }\n264\t        if odd != 0 {\n265\t            buf[len - 1] = buf[half];\n266\t        }\n267\t    } else {\n268\t        /* In-place for large buffers - more complex */\n269\t        for i in 0..half {\n270\t            let src = half + i;\n271\t            let dst = i * 2 + 1;\n272\t            if dst < src {\n273\t                let val = buf[src];\n274\t                buf.copy_within(dst..src, dst + 1);\n275\t                buf[dst] = val;\n276\t            }\n277\t        }\n278\t    }\n279\t}\n280\t\n281\t/// Reverse buffer in fixed-size segments\n282\t/// Nested loops with conditional memmove operations\n283\tfn reverse_segments(buf: &mut [u8], len: usize, seg_size: usize) {\n284\t    if seg_size <= 1 || len < seg_size {\n285\t        return;\n286\t    }\n287\t\n288\t    let num_segments = len / seg_size;\n289\t    let remainder = len % seg_size;\n290\t\n291\t    /* Process complete segments */\n292\t    for seg in 0..num_segments {\n293\t        let base = seg * seg_size;\n294\t\n295\t        /* Reverse within segment using memmove */\n296\t        for i in 0..(seg_size / 2) {\n297\t            let left = base + i;\n298\t            let right = base + seg_size - 1 - i;\n299\t\n300\t            let temp = buf[left];\n301\t            buf[left] = buf[right];\n302\t            buf[right] = temp;\n303\t        }\n304\t    }\n305\t\n306\t    /* Handle remainder if exists and is > 1 */\n307\t    if remainder > 1 {\n308\t        let base = num_segments * seg_size;\n309\t        for i in 0..(remainder / 2) {\n310\t            let temp = buf[base + i];\n311\t            buf[base + i] = buf[base + remainder - 1 - i];\n312\t            buf[base + remainder - 1 - i] = temp;\n313\t        }\n314\t    }\n315\t}\n316\t"}]},"parent_tool_use_id":null,"session_id":"ff993cf9-42c6-4084-af5f-96944f4fc84f","uuid":"3c926a21-8de2-4b9c-bf3f-c0a76402b483","timestamp":"2026-08-28T04:19:04.424Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-50AVSe/translation/src/lib.rs","content"