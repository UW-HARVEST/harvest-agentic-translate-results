|n| n.starts_with(\"lib\"))\n                    .unwrap_or(false)\n        })\n        .collect();\n    hits.sort();\n    hits.into_iter().next()\n}\n\n/// Build (if needed) and locate the Rust cdylib.\nfn rust_so_path() -> PathBuf {\n    let manifest = Path::new(env!(\"CARGO_MANIFEST_DIR\"));\n\n    // The test binary lives at <target>/<profile>/deps/<name>-<hash>; the\n    // cdylib built under the SAME profile sits at <target>/<profile>/.\n    // Always prefer that one so `--release` tests never load the debug .so.\n    let mut candidates: Vec<PathBuf> = Vec::new();\n    if let Ok(exe) = std::env::current_exe() {\n        if let Some(profile_dir) = exe.parent().and_then(|deps| deps.parent()) {\n            candidates.push(profile_dir.join(\"libdataentry_lib.so\"));\n        }\n    }\n    candidates.push(manifest.join(\"target/debug/libdataentry_lib.so\"));\n    candidates.push(manifest.join(\"target/release/libdataentry_lib.so\"));\n\n    for c in &candidates {\n        if c.is_file() {\n            return c.clone();\n        }\n    }\n\n    let st = Command::new(env!(\"CARGO\"))\n        .current_dir(manifest)\n        .args([\"build\", \"--offline\", \"--release\"])\n        .status()\n        .expect(\"cargo build --release\");\n    assert!(st.success(), \"cargo build --release failed\");\n\n    candidates\n        .iter()\n        .find(|c| c.is_file())\n        .cloned()\n        .expect(\"Rust cdylib not found after building\")\n}\n\n/// Guard against the *silent vacuous pass*: if the `.so` we are about to dlopen\n/// is older than the sources it is built from, every differential assertion\n/// would compare against stale code and pass for the wrong reason.\nfn assert_fresh(so: &Path, sources: &[PathBuf], what: &str) {\n    let so_mtime = std::fs::metadata(so)\n        .and_then(|m| m.modified())\n        .unwrap_or_else(|e| panic!(\"stat {}: {e}\", so.display()));\n    for src in sources {\n        if !src.is_file() {\n            continue;\n        }\n        let src_mtime = std::fs::metadata(src)\n            .and_then(|m| m.modified())\n            .unwrap_or_else(|e| panic!(\"stat {}: {e}\", src.display()));\n        assert!(\n            so_mtime >= src_mtime,\n            \"STALE {what}: {} is older than {}. The tests would have compared \\\n             against out-of-date code and passed vacuously. Rebuild first \\\n             (cargo build / cmake --build c_src/build).\",\n            so.display(),\n            src.display()\n        );\n    }","numLines":105,"startLine":27,"totalLines":278}}}
