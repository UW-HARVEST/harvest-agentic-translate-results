\")\nseed(b\"99999999999999999999 AB CD EFG HIJ huge\\n\")\nseed(b\"12345678901 AB CD EFG HIJ wrap\\n\")\nseed(b\"-9223372036854775808 AB CD EFG HIJ lmin\\n\")\nseed(b\"-9223372036854775807 AB CD EFG HIJ lmin1\\n\")\nseed(b\"9223372036854775808 AB CD EFG HIJ lmaxp1\\n\")\nseed(b\"4294967295 AB CD EFG HIJ umax\\n\")\nseed(b\"4294967296 AB CD EFG HIJ umaxp1\\n\")\nseed(b\"2147483647 AB CD EFG HIJ imax\\n\")\nseed(b\"2147483648 AB CD EFG HIJ imaxp1\\n\")\nseed(b\"-2147483648 AB CD EFG HIJ imin\\n\")\nseed(b\"0x10 AB CD EFG HIJ hex\\n\")\nseed(b\"010 AB CD EFG HIJ oct\\n\")\nseed(b\"- AB CD EFG HIJ dash\\n\")\nseed(b\"+ AB CD EFG HIJ plus\\n\")\nseed(b\"-- AB CD EFG HIJ dd\\n\")\nseed(b\"-A1 B2 CD EF z\\n\")\nseed(b\"ABCDEFGHIJ KLMNOPQR STU VWX y\\n\")            # width overflow on ids\nseed(b\"1 ABCDEFGH12 IJKLMN34 OPQR STUV w\\n\")\nseed(b\"1\\nLUG00001\\nFL1234\\nJFK\\nLAX\\ncomment\\n\")\nseed(b\"1 \\t\\v\\f\\r\\nAB \\t\\v\\f\\r\\nCD \\r\\n EFG\\v HIJ  cmt\\n\")\nseed(b\"1 AB CD EFG HIJ \" + b\"y\" * 79 + b\"\\n2 ZZ QQ RRR SSS tail\\n\")\nseed(b\"1 AB CD EFG HIJ \" + b\"y\" * 80 + b\"\\n\")\nseed(b\"1 AB CD EFG HIJ \" + b\"y\" * 81 + b\"\\n\")\nseed(b\"1 AB CD EFG HIJ \" + b\"Y\" * 200 + b\"\\n\")\nseed(b\"1 AB CD EFG HIJ\\x00tail\\n2 ZZ QQ RRR SSS t\\n\")\nseed(b\"1 AB CD EFG HIJ a\\x00b\\n\")\nseed(b\"\\x001 AB CD EFG HIJ a\\n\")\nseed(b\"1\\x00AB CD EFG HIJ a\\n\")\nseed(b\"1 AB\\x00CD EFG HIJ a\\n\")\nseed(b\"\\xff\\xfe\\x80 AB CD EFG HIJ a\\n\")\nseed(b\"1 AB CD EFG HIJ \\xff\\xfe\\x80\\n\")\nseed(b\"1 AB CD EFG HIJ c\\r\\n2 ZZ QQ RRR SSS d\\r\\n\")\nseed(b\"\\r\\n\\r\\n1 AB CD EFG HIJ c\\r\\n\")\nseed(b\"1 AB CD EFG HIJ one 2 ZZ QQ RRR SSS two\\n\")\nseed(b\"5 AAAAAAAA BBBBBB CCC DDD a\\n5 AAAAAAAA BBBBBB CCC DDD b\\n5 AAAAAAAA BBBBBB CCC DDD c\\n\")\nseed(b\"1 A B C D e\\n2 A B C E f\\n3 A B G D h\\n\")\nseed(b\"lowercase junk here\\n2 ZZ QQ RRR SSS ok\\n\")\nseed(b\"x\\ny\\nz\\n\")\nseed(b\"1 AB CD EFG HIJ x\\n!\\n!\\n!\\n\")\nseed(b\"1 AB CD EFG HIJ x\\n\\n\\n\\n\")\nseed(b\"   \\t\\n\\v\\f\\r  \\n\")\nseed(b\"1 AB CD EFG HIJ\")\nseed(b\"1 AB CD EFG HIJ \")\nseed(b\"1 AB CD EFG\")\nseed(b\"1 AB CD\")\nseed(b\"1 AB\")\nseed(b\"1 \")\nseed(b\"1\")\nseed(b\"\")\nseed(b\"\\n\")\nseed(b\"0000000000000000000000000000005 AB CD EFG HIJ lz\\n\")\nseed(b\"1\" * 400 + b\" AB CD EFG HIJ manydigits\\n\")\nseed(b\"0\" * 400 + b\"7 AB CD EFG HIJ manyzeros\\n\")\nseed(b\"-\" + b\"9\" * 400 + b\" AB CD EFG HIJ negmany\\n\")\nseed(b\"1 abcdefgh ijklmn opq rst u\\n\")\nseed(b\"1 AB CD EFG HIJ\\t\\n\")\nseed(b\"1 AB CD EFG HIJ\\v\\n\")\n\njobs = []\n# 1) every seed x every argset\nfor i, s in enumerate(SEEDS):\n    for a in ARGSETS:\n        jobs.append((\"seed%d\" % i, a, s))\n\n# 2) truncate every seed at EVERY byte offset (wildcard args + one specific)\nfor i, s in enumerate(SEEDS):\n    for n in range(len(s) + 1):\n        jobs.append((\"trunc%d@%d\" % (i, n), WILD, s[:n]))\nfor i, s in enumerate(SEEDS[:30]):\n    for n in range(len(s) + 1):\n        jobs.append((\"truncA%d@%d\" % (i, n), ARGSETS[1], s[:n]))\n\n# 3) every seed with one byte appended / a byte inserted at each position\nEXTRA = [b\"\\x00\", b\"\\n\", b\" \", b\"-\", b\"+\", b\"\\xff\", b\"A\", b\"1\", b\"\\r\", b\"\\v\"]\nrandom.seed(7)\nfor i, s in enumerate(SEEDS[:25]):\n    for e in EXTRA:\n        jobs.append((\"app%d\" % i, WILD, s + e))\n        for n in range(0, len(s) + 1, 3):\n            jobs.append((\"ins%d@%d\" % (i, n), WILD, s[:n] + e + s[n:]))\n\n# 4) byte-level fuzz over a nasty alphabet\nALPHA = bytes(b\"0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcxyz -+\\n\\t\\r\\v\\f\\x00\\xff\\x80\\x01!.\")\nfor k in range(9000):\n    n = random.randint(0, 70)\n    d = bytes(random.choice(ALPHA) for _ in range(n))\n    jobs.append((\"bytefuzz\", random.choice(ARGSETS), d))\n\n# 5) token-level structured fuzz\nTS = [b\"0\", b\"1\", b\"5\", b\"-1\", b\"+1\", b\"-\", b\"+\", b\"--\", b\"0x1\", b\"4294967295\",\n      b\"4294967296\", b\"99999999999999999999\", b\"-92233720