FL0001 JFK LAX a\\n\"\n46\t        b\"0000000005 LUGBBBBB FL0002 JFK LAX b\\n\"\n47\t        b\"0000000005 LUGCCCCC FL0003 JFK LAX c\\n\"\n48\t    ),\n49\t    # supersession: later directive, same luggage, same departure\n50\t    \"superseded_same_dep\": (\n51\t        b\"0000000001 LUG00001 FL0001 JFK LAX v1\\n\"\n52\t        b\"0000000002 LUG00001 FL0002 JFK BOS v2\\n\"\n53\t    ),\n54\t    # later directive, same luggage, different departure -> not superseded\n55\t    \"superseded_diff_dep\": (\n56\t        b\"0000000001 LUG00001 FL0001 JFK LAX v1\\n\"\n57\t        b\"0000000002 LUG00001 FL0002 BOS SFO v2\\n\"\n58\t    ),\n59\t    # the \"stop at first same-luggage directive\" quirk\n60\t    \"supersede_quirk\": (\n61\t        b\"0000000001 LUG00001 FL0001 JFK LAX v1\\n\"\n62\t        b\"0000000002 LUG00001 FL0002 BOS SFO v2\\n\"\n63\t        b\"0000000003 LUG00001 FL0003 JFK ORD v3\\n\"\n64\t    ),\n65\t    \"zero_ts\": b\"0 LUG00001 FL1234 JFK LAX zero\\n\",\n66\t    \"big_ts\": b\"4294967295 LUG00001 FL1234 JFK LAX big\\n\",\n67\t    \"huge_ts\": b\"99999999999999999999 LUG00001 FL1234 JFK LAX huge\\n\",\n68\t    \"neg_ts\": b\"-5 LUG00001 FL1234 JFK LAX neg\\n\",\n69\t    \"plus_ts\": b\"+7 LUG00001 FL1234 JFK LAX plus\\n\",\n70\t    \"wrap_ts\": b\"12345678901 LUG00001 FL1234 JFK LAX wrap\\n\",\n71\t    \"leading_zeros\": b\"0000000042 LUG00001 FL1234 JFK LAX lz\\n\",\n72\t    \"spread_over_lines\": (\n73\t        b\"0000000001\\nLUG00001\\nFL1234\\nJFK\\nLAX\\n\"\n74\t        b\"0000000002 LUG00002\\n FL5678  BOS   SFO trailing\\n\"\n75\t    ),\n76\t    \"extra_blank_lines\": (\n77\t        b\"\\n\\n0000000001 LUG00001 FL1234 JFK LAX one\\n\\n\\n\"\n78\t        b\"0000000002 LUG00002 FL5678 BOS SFO two\\n\\n\"\n79\t    ),\n80\t    \"tabs\": b\"0000000001\\tLUG00001\\tFL1234\\tJFK\\tLAX\\tcomment with tab\\n\",\n81\t    \"crlf\": b\"0000000001 LUG00001 FL1234 JFK LAX c\\r\\n0000000002 LUG00002 FL5678 BOS SFO d\\r\\n\",\n82\t    \"crlf_no_comment\": b\"0000000001 LUG00001 FL1234 JFK LAX\\r\\n\",\n83\t    \"long_luggage\": b\"0000000001 LUG0000123456 FL1234 JFK LAX long\\n\",\n84\t    \"long_airport\": b\"0000000001 LUG00001 FL1234 JFKKK LAXXX long\\n\",\n85\t    \"long_comment\": b\"0000000001 LUG00001 FL1234 JFK LAX \" + b\"x\" * 200 + b\"\\n\",\n86\t    \"comment_exactly_80\": b\"0000000001 LUG00001 FL1234 JFK LAX\" + b\" \" + b\"y\" * 79 + b\"\\n\",\n87\t    \"lowercase_ids\": b\"0000000001 lug00001 fl1234 jfk lax bad\\n\",\n88\t    \"lowercase_airport\": b\"0000000001 LUG00001 FL1234 jfk lax bad\\n\",\n89\t    \"nonnumeric_ts\": b\"abc LUG00001 FL1234 JFK LAX bad\\n\",\n90\t    \"missing_fields\": b\"0000000001 LUG00001\\n\",\n91\t    \"missing_arrival\": b\"0000000001 LUG00001 FL1234 JFK\\n\",\n92\t    \"ts_only\": b\"0000000001\\n\",\n93\t    \"ts_then_eof\": b\"0000000001 \",\n94\t    \"double_record_one_line\": (\n95\t        b\"0000000001 LUG00001 FL1234 JFK LAX one 0000000002 LUG00002 FL5678 BOS SFO two\\n\"\n96\t    ),\n97\t    \"many\": b\"\".join(\n98\t        b\"%010d LUG%05d FL%04d %s %s comment %d\\n\"\n99\t        % (i * 7 % 23, i % 5, i, b\"JFK\" if i % 2 else b\"BOS\", b\"LAX\" if i % 3 else b\"SFO\", i)\n100\t        for i in range(40)\n101\t    ),\n102\t    \"dup_all_identical\": b\"0000000009 LUG00001 FL0001 JFK LAX same\\n\" * 5,\n103\t    \"utf8_comment\": \"0000000001 LUG00001 FL1234 JFK LAX café ünïcødé ✈\\n\".encode(),\n104\t    \"binary_comment\": b\"0000000001 LUG00001 FL1234 JFK LAX \\x01\\x02\\xff\\xfe\\x80 bin\\n\",\n105\t    \"nul_in_comment\": b\"0000000001 LUG00001 FL1234 JFK LAX a\\x00b\\n\",\n106\t    \"digits_in_airport\": b\"0000000001 LUG00001 FL1234 JF1 LAX bad\\n\",\n107\t    \"sign_only_ts\": b\"- LUG00001 FL1234 JFK LAX bad\\n\",\n108\t    \"ts_hex\": b\"0x10 LUG00001 FL1234 JFK LAX hex\\n\",\n109\t}\n110\t\n111\t\n112\tdef run(binary, args, data):\n113\t    p = subprocess.run([binary] + args, input=data, stdout=subprocess.PIPE,\n114\t                       stderr=subprocess.PIPE, timeout=30)\n115\t    return p.returncode, p.stdout, p.stderr\n116\t\n117\t\n118\tdef compare(name, args, data, failures):\n119\t    try:\n120\t        c = run(C_BIN, args, data)\n121\t        r = run(RUST_BIN, args, data)\n122\t    except subprocess.TimeoutExpired:\n123\t        failures.append((name, args, data, \"TIMEOUT\", \"\"))\n124\t        return\n125\t    if c != r:\n126\t        failures.append((name, args, data, c, r))\n127\t\n128\t\n129\tdef main():\n130\t    failures = []\n131\t    checks = 0\n132\t\n133\t    for name, data in CASES.items():\n134\t        for args in ARGSETS:\n135\t            compare(name, args, data, failures)\n136\t            checks += 1\n137\t\n138\t    for args in BAD_ARGSETS:\n139\t        compare(\"argc\", args, b\"0000000001 LUG00001 FL1234 JFK LAX x\\n\", failures)\n140\t        checks += 1\n141\t\n142\t    # Structured fuzzing over well-formed-ish records.\n143\t    random.seed(1234)\n144\t    tokens_ts = [b\"0\", b\"1\", b\"0000000007\", b\"42\", b\"-3\", b\"4294967295\", b\"99999999999999999999\", b\"12345678901\"]\n145\t    lug = [b\"LUG00001\", b\"LUG00002\", b\"A\", b\"ABCDEFGH\", b\"ABCDEFGHIJ\", b\"9\"]\n146\t    fl = [b\"FL0001\", b\"FL0002\", b\"F\", b\"ABCDEF\", b\"ABCDEFGH\"]\n147\t    ap = [b\"JFK\", b\"BOS\", b\"LAX\", b\"SFO\", b\"A\", b\"AB\", b\"ABCD\"]\n148\t    cm = [b\"\", b\" hello\", b\" a b c\", b\"   \", b\" \" + b\"z\" * 90, b\" \\xff\\x01\"]\n149\t    seps = [b\" \", b\"  \", b\"\\t\", b\"\\n\", b\" \\n \", b\"\\r\\n\"]\n150\t    for _ in range(1500):\n151\t        n = random.randint(0, 6)\n152\t        parts = []\n153\t        for _ in range(n):\n154\t            rec = [random.choice(tokens_ts), random.choice(lug), random.choice(fl),\n155\t                   random.choice(ap), random.choice(ap)]\n156\t            line = b\"\"\n157\t            for tok in rec:\n158\t                line += tok + random.choice(seps)\n159\t            line = line.rstrip(b\" \\t\") if random.random() < 0.3 else line