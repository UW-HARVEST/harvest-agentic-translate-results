tern \"C\" fn sh_geti(num: c_int) {\n1249\t    let mut strmap: *mut sh_geti_entry = ptr::null_mut();\n1250\t    let mut sa: stbds_string_arena = stbds_string_arena {\n1251\t        storage: ptr::null_mut(),\n1252\t        remaining: 0,\n1253\t        block: 0,\n1254\t        mode: 0,\n1255\t    };\n1256\t    let mut i: c_int;\n1257\t    let mut j: c_int;\n1258\t\n1259\t    let foo: *const c_char = c\"foo\".as_ptr();\n1260\t\n1261\t    i = 0;\n1262\t    while i < num {\n1263\t        stbds_stralloc(&mut sa, strkey(i));\n1264\t        i += 1;\n1265\t    }\n1266\t    stbds_strreset(&mut sa);\n1267\t\n1268\t    j = 0;\n1269\t    while j < 2 {\n1270\t        STBDS_ASSERT!(sh_geti_macro(&mut strmap, foo) == -1);\n1271\t        if j == 0 {\n1272\t            // sh_new_strdup(strmap)\n1273\t            strmap = stbds_shmode_func(SH_ES, STBDS_SH_STRDUP as c_int) as *mut sh_geti_entry;\n1274\t        } else {\n1275\t            // sh_new_arena(strmap)\n1276\t            strmap = stbds_shmode_func(SH_ES, STBDS_SH_ARENA as c_int) as *mut sh_geti_entry;\n1277\t        }\n1278\t        STBDS_ASSERT!(sh_geti_macro(&mut strmap, foo) == -1);\n1279\t        // shdefault(strmap, -2)\n1280\t        strmap = stbds_hmput_default(strmap as *mut c_void, SH_ES) as *mut sh_geti_entry;\n1281\t        (*strmap.wrapping_offset(-1)).value = -2;\n1282\t        STBDS_ASSERT!(sh_geti_macro(&mut strmap, foo) == -1);\n1283\t\n1284\t        i = 0;\n1285\t        while i < num {\n1286\t            sh_put(&mut strmap, strkey(i), i.wrapping_mul(3));\n1287\t            i += 2;\n1288\t        }\n1289\t\n1290\t        let mut z: c_int = 0;\n1291\t        while (z as isize) < sh_len(strmap) {\n1292\t            let e: sh_geti_entry = *strmap.wrapping_offset(z as isize);\n1293\t            // printf(\"%s %d\\n\", strmap[z], strmap[z].value);\n1294\t            //\n1295\t            // The struct is passed by value: on the SysV AMD64 ABI it occupies\n1296\t            // two INTEGER eightbytes, so \"%s\" consu