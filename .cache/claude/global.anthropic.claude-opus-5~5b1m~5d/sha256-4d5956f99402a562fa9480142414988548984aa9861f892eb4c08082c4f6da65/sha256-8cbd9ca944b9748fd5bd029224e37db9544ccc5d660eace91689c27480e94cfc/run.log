{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01QdFwh8YBwgyzLTc1BjrHNR","type":"tool_result","content":"1\t//! Faithful Rust translation of the C library in `c_src/` (an stb_ds derived\n2\t//! hash-map / dynamic-array implementation plus the `sh_geti` / `strkey`\n3\t//! driver helpers).\n4\t//!\n5\t//! The translation is intentionally literal: every arithmetic quirk, implicit\n6\t//! integer conversion, order of operations, and (mis)behaviour of the original\n7\t//! C is reproduced, including the sign-extension bug in the SipHash byte\n8\t//! loading and the `printf(\"%s %d\\n\", struct, struct.value)` call in\n9\t//! `sh_geti`.\n10\t//!\n11\t//! Memory management uses libc `realloc`/`free` exactly like the C code so\n12\t//! that the header-behind-the-pointer trick and the pointer arithmetic remain\n13\t//! byte-for-byte compatible with the C implementation.\n14\t\n15\t#![allow(non_camel_case_types)]\n16\t#![allow(non_snake_case)]\n17\t#![allow(non_upper_case_globals)]\n18\t#![allow(unused_assignments)]\n19\t#![allow(clippy::missing_safety_doc)]\n20\t\n21\tuse core::ffi::{c_char, c_int, c_void};\n22\tuse core::ptr;\n23\t\n24\t// ---------------------------------------------------------------------------\n25\t// libc bindings (the C library links against libc + libm)\n26\t// ---------------------------------------------------------------------------\n27\t\n28\textern \"C\" {\n29\t    fn realloc(p: *mut c_void, size: usize) -> *mut c_void;\n30\t    fn free(p: *mut c_void);\n31\t    fn memset(s: *mut c_void, c: c_int, n: usize) -> *mut c_void;\n32\t    fn memcpy(d: *mut c_void, s: *const c_void, n: usize) -> *mut c_void;\n33\t    fn memmove(d: *mut c_void, s: *const c_void, n: usize) -> *mut c_void;\n34\t    fn memcmp(a: *const c_void, b: *const c_void, n: usize) -> c_int;\n35\t    fn strcmp(a: *const c_char, b: *const c_char) -> c_int;\n36\t    fn strlen(s: *const c_char) -> usize;\n37\t    fn printf(fmt: *const c_char, ...) -> c_int;\n38\t    fn sprintf(buf: *mut c_char, fmt: *const c_char, ...) -> c_int;\n39\t    fn abort() -> !;\n40\t}\n41\t\n42\t/// `assert()` from <assert.h>.  NDEBUG is not defined for the C build, so the\n43\t/// assertions are live; a failing assertion terminates the process.\n44\tmacro_rules! STBDS_ASSERT {\n45\t    ($cond:expr) => {\n46\t        if !($cond) {\n47\t            unsafe { abort() }\n48\t        }\n49\t    };\n50\t}\n51\t\n52\t// ---------------------------------------------------------------------------\n53\t// Types\n54\t// ---------------------------------------------------------------------------\n55\t\n56\t#[repr(C)]\n57\t#[derive(Copy, Clone)]\n58\tstruct stbds_array_header {\n59\t    length: usize,\n60\t    capacity: usize,\n61\t    hash_table: *mut c_void,\n62\t    temp: isize,\n63\t}\n64\t\n65\t#[repr(C)]\n66\t#[derive(Copy, Clone)]\n67\tstruct stbds_string_block {\n68\t    next: *mut stbds_string_block,\n69\t    storage: [c_char; 8],\n70\t}\n71\t\n72\t#[repr(C)]\n73\t#[derive(Copy, Clone)]\n74\tpub struct stbds_string_arena {\n75\t    storage: *mut stbds_string_block,\n76\t    remaining: usize,\n77\t    block: u8,\n78\t    mode: u8,\n79\t}\n80\t\n81\tconst STBDS_BUCKET_LENGTH: usize = 8;\n82\tconst STBDS_BUCKET_SHIFT: usize = 3;\n83\tconst STBDS_BUCKET_MASK: usize = STBDS_BUCKET_LENGTH - 1;\n84\tconst STBDS_CACHE_LINE_SIZE: usize = 64;\n85\t\n86\t#[repr(C)]\n87\t#[derive(Copy, Clone)]\n88\tstruct stbds_hash_bucket {\n89\t    hash: [usize; STBDS_BUCKET_LENGTH],\n90\t    index: [isize; STBDS_BUCKET_LENGTH],\n91\t}\n92\t\n93\t#[repr(C)]\n94\t#[derive(Copy, Clone)]\n95\tstruct stbds_hash_index {\n96\t    temp_key: *mut c_char,\n97\t    slot_count: usize,\n98\t    used_count: usize,\n99\t    used_count_threshold: usize,\n100\t    used_count_shrink_threshold: usize,\n101\t    tombstone_count: usize,\n102\t    tombstone_count_threshold: usize,\n103\t    seed: usize,\n104\t    slot_count_log2: usize,\n105\t    string: stbds_string_arena,\n106\t    storage: *mut stbds_hash_bucket,\n107\t}\n108\t\n109\tconst STBDS_INDEX_EMPTY: isize = -1;\n110\tconst STBDS_INDEX_DELETED: isize = -2;\n111\t\n112\tconst STBDS_HASH_EMPTY: usize = 0;\n113\tconst STBDS_HASH_DELETED: usize = 1;\n114\t\n115\tconst STBDS_HM_BINARY: c_int = 0;\n116\tconst STBDS_HM_STRING: c_int = 1;\n117\t\n118\tconst STBDS_SH_NONE: u8 = 0;\n119\tconst STBDS_SH_DEFAULT: u8 = 1;\n120\tconst STBDS_SH_STRDUP: u8 = 2;\n121\tconst STBDS_SH_ARENA: u8 = 3;\n122\t\n123\tconst STBDS_SIZE_T_BITS: u32 = (core::mem::size_of::<usize>() * 8) as u32;\n124\t\n125\tconst HEADER_SIZE: usize = core::mem::size_of::<stbds_array_header>();\n126\t\n127\t// ---------------------------------------------------------------------------\n128\t// Small helpers mirroring the C macros\n129\t// ---------------------------------------------------------------------------\n130\t\n131\t/// `stbds_header(t)` == `((stbds_array_header *) (t) - 1)`\n132\t#[inline(always)]\n133\tunsafe fn stbds_header(t: *mut c_void) -> *mut stbds_array_header {\n134\t    (t as *mut u8).wrapping_sub(HEADER_SIZE) as *mut stbds_array_header\n135\t}\n136\t\n137\t/// `stbds_arrcap(a)`\n138\t#[inline(always)]\n139\tunsafe fn stbds_arrcap(a: *mut c_void) -> usize {\n140\t    if a.is_null() {\n141\t        0\n142\t    } else {\n143\t        (*stbds_header(a)).capacity\n144\t    }\n145\t}\n146\t\n147\t/// `stbds_arrlen(a)`\n148\t#[inline(always)]\n149\tunsafe fn stbds_arrlen(a: *mut c_void) -> isize {\n150\t    if a.is_null() {\n151\t        0\n152\t    } else {\n153\t        (*stbds_header(a)).length as isize\n154\t    }\n155\t}\n156\t\n157\t/// `stbds_temp(t)` (lvalue read)\n158\t#[inline(always)]\n159\tunsafe fn stbds_temp(t: *mut c_void) -> isize {\n160\t    (*stbds_header(t)).temp\n161\t}\n162\t\n163\t/// `stbds_temp(t) = v`\n164\t#[inline(always)]\n165\tunsafe fn stbds_set_temp(t: *mut c_void, v: isize) {\n166\t    (*stbds_header(t)).temp = v;\n167\t}\n168\t\n169\t/// `stbds_temp_key(t) = v`, i.e. `*(char **) stbds_header(t)->hash_table = v`\n170\t#[inline(always)]\n171\tunsafe fn stbds_set_temp_key(t: *mut c_void, v: *mut c_char) {\n172\t    *((*stbds_header(t)).hash_table as *mut *mut c_char) = v;\n173\t}\n174\t\n175\t/// `stbds_hash_table(a)`\n176\t#[inline(always)]\n177\tunsafe fn stbds_hash_table(a: *mut c_void) -> *mut stbds_hash_index {\n178\t    (*stbds_header(a)).hash_table as *mut stbds_hash_index\n179\t}\n180\t\n181\t/// `STBDS_HASH_TO_ARR(x, elemsize)`\n182\t#[inline(always)]\n183\tfn STBDS_HASH_TO_ARR(x: *mut c_void, elemsize: usize) -> *mut c_void {\n184\t    (x as *mut u8).wrapping_sub(elemsize) as *mut c_void\n185\t}\n186\t\n187\t/// `STBDS_ARR_TO_HASH(x, elemsize)`\n188\t#[inline(always)]\n189\tfn STBDS_ARR_TO_HASH(x: *mut c_void, elemsize: usize) -> *mut c_void {\n190\t    (x as *mut u8).wrapping_add(elemsize) as *mut c_void\n191\t}\n192\t\n193\t/// `(char *) a + elemsize * i`\n194\t#[inline(always)]\n195\tfn elem_at(a: *mut c_void, elemsize: usize, i: usize) -> *mut u8 {\n196\t    (a as *mut u8).wrapping_add(elemsize.wrapping_mul(i))\n197\t}\n198\t\n199\t/// `STBDS_ALIGN_FWD(n, a)`\n200\t#[inline(always)]\n201\tfn STBDS_ALIGN_FWD(n: usize, a: usize) -> usize {\n202\t    (n.wrapping_add(a - 1)) & !(a - 1)\n203\t}\n204\t\n205\t/// `STBDS_ROTATE_LEFT(val, n)`\n206\t#[inline(always)]\n207\tfn STBDS_ROTATE_LEFT(val: usize, n: u32) -> usize {\n208\t    (val << n) | (val >> (STBDS_SIZE_T_BITS - n))\n209\t}\n210\t\n211\t/// `STBDS_ROTATE_RIGHT(val, n)`\n212\t#[inline(always)]\n213\tfn STBDS_ROTATE_RIGHT(val: usize, n: u32) -> usize {\n214\t    (val >> n) | (val << (STBDS_SIZE_T_BITS - n))\n215\t}\n216\t\n217\t// ---------------------------------------------------------------------------\n218\t// Dynamic array growth\n219\t// ---------------------------------------------------------------------------\n220\t\n221\t#[unsafe(no_mangle)]\n222\tpub unsafe extern \"C\" fn stbds_arrgrowf(\n223\t    a: *mut c_void,\n224\t    elemsize: usize,\n225\t    addlen: usize,\n226\t    mut min_cap: usize,\n227\t) -> *mut c_void {\n228\t    let b: *mut c_void;\n229\t    let min_len: usize = (stbds_arrlen(a) as usize).wrapping_add(addlen);\n230\t\n231\t    if min_len > min_cap {\n232\t        min_cap = min_len;\n233\t    }\n234\t\n235\t    if min_cap <= stbds_arrcap(a) {\n236\t        return a;\n237\t    }\n238\t\n239\t    if min_cap < 2usize.wrapping_mul(stbds_arrcap(a)) {\n240\t        min_cap = 2usize.wrapping_mul(stbds_arrcap(a));\n241\t    } else if min_cap < 4 {\n242\t        min_cap = 4;\n243\t    }\n244\t\n245\t    let old: *mut c_void = if !a.is_null() {\n246\t        stbds_header(a) as *mut c_void\n247\t    } else {\n248\t        ptr::null_mut()\n249\t    };\n250\t    let raw = realloc(\n251\t        old,\n252\t        elemsize\n253\t            .wrapping_mul(min_cap)\n254\t            .wrapping_add(HEADER_SIZE),\n255\t    );\n256\t    b = (raw as *mut u8).wrapping_add(HEADER_SIZE) as *mut c_void;\n257\t    if a.is_null() {\n258\t        (*stbds_header(b)).length = 0;\n259\t        (*stbds_header(b)).hash_table = ptr::null_mut();\n260\t        (*stbds_header(b)).temp = 0;\n261\t    }\n262\t    (*stbds_header(b)).capacity = min_cap;\n263\t\n264\t    b\n265\t}\n266\t\n267\t#[unsafe(no_mangle)]\n268\tpub unsafe extern \"C\" fn stbds_arrfreef(a: *mut c_void) {\n269\t    free(stbds_header(a) as *mut c_void);\n270\t}\n271\t\n272\t// ---------------------------------------------------------------------------\n273\t// Hash index\n274\t// ---------------------------------------------------------------------------\n275\t\n276\tstatic mut stbds_hash_seed: usize = 0x3141_5926;\n277\t\n278\t#[unsafe(no_mangle)]\n279\tpub unsafe extern \"C\" fn stbds_rand_seed(seed: usize) {\n280\t    stbds_hash_seed = seed;\n281\t}\n282\t\n283\t#[inline]\n284\tfn stbds_probe_position(hash: usize, slot_count: usize, _slot_log2: usize) -> usize {\n285\t    hash & (slot_count.wrapping_sub(1))\n286\t}\n287\t\n288\tfn stbds_log2(mut slot_count: usize) -> usize {\n289\t    let mut n: usize = 0;\n290\t    while slot_count > 1 {\n291\t        slot_count >>= 1;\n292\t        n += 1;\n293\t    }\n294\t    n\n295\t}\n296\t\n297\tunsafe fn stbds_make_hash_index(\n298\t    slot_count: usize,\n299\t    ot: *mut stbds_hash_index,\n300\t) -> *mut stbds_hash_index {\n301\t    let t: *mut stbds_hash_index;\n302\t    t = realloc(\n303\t        ptr::null_mut(),\n304\t        (slot_count >> STBDS_BUCKET_SHIFT)\n305\t            .wrapping_mul(core::mem::size_of::<stbds_hash_bucket>())\n306\t            .wrapping_add(core::mem::size_of::<stbds_hash_index>())\n307\t            .wrapping_add(STBDS_CACHE_LINE_SIZE - 1),\n308\t    ) as *mut stbds_hash_index;\n309\t    (*t).storage = STBDS_ALIGN_FWD(t.wrapping_add(1) as usize, STBDS_CACHE_LINE_SIZE)\n310\t        as *mut stbds_hash_bucket;\n311\t    (*t).slot_count = slot_count;\n312\t    (*t).slot_count_log2 = stbds_log2(slot_count);\n313\t    (*t).tombstone_count = 0;\n314\t    (*t).used_count = 0;\n315\t\n316\t    (*t).used_count_threshold = slot_count.wrapping_sub(slot_count >> 2);\n317\t    (*t).tombstone_count_threshold = (slot_count >> 3).wrapping_add(slot_count >> 4);\n318\t    (*t).used_count_shrink_threshold = slot_count >> 2;\n319\t\n320\t    if slot_count <= STBDS_BUCKET_LENGTH {\n321\t        (*t).used_count_shrink_threshold = 0;\n322\t    }\n323\t    STBDS_ASSERT!(\n324\t        (*t).used_count_threshold.wrapping_add((*t).tombstone_count_threshold) < (*t).slot_count\n325\t    );\n326\t    if !ot.is_null() {\n327\t        (*t).string = (*ot).string;\n328\t        (*t).seed = (*ot).seed;\n329\t    } else {\n330\t        let a: usize;\n331\t        let b: usize;\n332\t        let mut temp: usize;\n333\t        memset(\n334\t            ptr::addr_of_mut!((*t).string) as *mut c_void,\n335\t            0,\n336\t            core::mem::size_of::<stbds_string_arena>(),\n337\t        );\n338\t        (*t).seed = stbds_hash_seed;\n339\t        // stbds_load_32_or_64(a, temp, 2147001325, 0x27bb2ee6, 0x87b0b0f