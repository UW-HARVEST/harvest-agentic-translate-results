436\t        hash = STBDS_ROTATE_LEFT(hash, 9).wrapping_add(*s as usize);\n437\t        s = s.wrapping_add(1);\n438\t    }\n439\t\n440\t    hash ^= seed;\n441\t    hash = (!hash).wrapping_add(hash << 18);\n442\t    hash ^= hash ^ STBDS_ROTATE_RIGHT(hash, 31);\n443\t    hash = hash.wrapping_mul(21);\n444\t    hash ^= hash ^ STBDS_ROTATE_RIGHT(hash, 11);\n445\t    hash = hash.wrapping_add(hash << 6);\n446\t    hash ^= STBDS_ROTATE_RIGHT(hash, 22);\n447\t    hash.wrapping_add(seed)\n448\t}\n449\t\n450\tconst STBDS_SIPHASH_C_ROUNDS: usize = 2;\n451\tconst STBDS_SIPHASH_D_ROUNDS: usize = 4;\n452\t\n453\t#[inline(always)]\n454\tfn stbds_sipround(v: &mut [usize; 4]) {\n455\t    v[0] = v[0].wrapping_add(v[1]);\n456\t    v[1] = STBDS_ROTATE_LEFT(v[1], 13);\n457\t    v[1] ^= v[0];\n458\t    v[0] = STBDS_ROTATE_LEFT(v[0], STBDS_SIZE_T_BITS / 2);\n459\t    v[2] = v[2].wrapping_add(v[3]);\n460\t    v[3] = STBDS_ROTATE_LEFT(v[3], 16);\n461\t    v[3] ^= v[2];\n462\t    v[2] = v[2].wrapping_add(v[1]);\n463\t    v[1] = STBDS_ROTATE_LEFT(v[1], 17);\n464\t    v[1] ^= v[2];\n465\t    v[2] = STBDS_ROTATE_LEFT(v[2], STBDS_SIZE_T_BITS / 2);\n466\t    v[0] = v[0].wrapping_add(v[3]);\n467\t    v[3] = STBDS_ROTATE_LEFT(v[3], 21);\n468\t    v[3] ^= v[0];\n469\t}\n470\t\n471\t/// The C code builds `data` out of `int` sub-expressions; when the top byte has\n472\t/// its high bit set the `int` becomes negative and the conversion to `size_t`\n473\t/// sign-extends.  That behaviour is part of the observable output and is\n474\t/// reproduced here.\n475\t#[inline(always)]\n476\tfn c_int_to_size_t(v: u32) -> usize {\n477\t    ((v as i32) as i64) as usize\n478\t}\n479\t\n480\tunsafe fn stbds_siphash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n481\t    let mut d: *const u8 = p as *const u8;\n482\t    let mut i: usize;\n483\t    let mut j: usize;\n484\t    let mut v: [usize; 4] = [0; 4];\n485\t    let mut data: usize;\n486\t\n487\t    v[0] = ((0x736f_6d65usize << 16) << 16).wrapping_add(