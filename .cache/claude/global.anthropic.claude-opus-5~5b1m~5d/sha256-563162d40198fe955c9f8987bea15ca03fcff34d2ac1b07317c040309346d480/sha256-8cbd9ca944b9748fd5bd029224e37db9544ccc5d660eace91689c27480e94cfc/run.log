got as usize).to_vec()\n        };\n        (valid(l, pp, ip), r, got, bytes)'''\nassert old_dis in s\nnew_dis='''        let r = api::png_get_iCCP(l, pp, ip, &mut nm, &mut oct, &mut p, &mut got);\n        // png_get_iCCP reports the *embedded* length (999), not the 8 bytes\n        // that were stored, so only those 8 bytes may be inspected.\n        let bytes = if p.is_null() {\n            Vec::new()\n        } else {\n            std::slice::from_raw_parts(p, 8).to_vec()\n        };\n        (valid(l, pp, ip), r, got, bytes)'''\ns=s.replace(old_dis,new_dis)\nopen(p,'w').write(s)\nPYEOF\ngrep -n \"eprintln\\|zz_probe\" tests/t_err2.rs | head; timeout 900 cargo test --offline --release --test t_err2 2>&1 | grep -v \"^libpng warning\" | tail -30","is_backgrounded":false,"task_type":"local_bash","uuid":"2930591d-05f3-47b8-9f33-a2ecdf51fb3b","session_id":"814b2895-9042-4f5f-bd73-35bea46615cb"}
