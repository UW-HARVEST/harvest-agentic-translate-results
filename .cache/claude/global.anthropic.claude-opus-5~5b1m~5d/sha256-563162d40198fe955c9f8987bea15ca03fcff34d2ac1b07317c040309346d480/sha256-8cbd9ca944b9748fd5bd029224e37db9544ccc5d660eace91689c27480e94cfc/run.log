{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01JbJPUUTgEV3XbAAAN5C8JB","type":"tool_result","content":"1\t//! Shared differential-test harness.\n2\t//!\n3\t//! Loads BOTH the reference C `libpng.so` and the translated Rust\n4\t//! `liblibpng.so` with `libloading` and calls every function through the\n5\t//! dynamic-symbol table, exactly like an external C consumer.  Nothing in the\n6\t//! Rust crate is ever called directly.\n7\t#![allow(dead_code)]\n8\t#![allow(non_camel_case_types)]\n9\t#![allow(non_snake_case)]\n10\t#![allow(non_upper_case_globals)]\n11\t\n12\tuse libloading::{Library, Symbol};\n13\tuse std::cell::RefCell;\n14\tuse std::ffi::{c_char, c_double, c_int, c_long, c_uint, c_ulong, c_void, CStr, CString};\n15\tuse std::sync::OnceLock;\n16\t\n17\t// ---------------------------------------------------------------- libpng types\n18\t\n19\tpub type png_byte = u8;\n20\tpub type png_uint_16 = u16;\n21\tpub type png_int_32 = i32;\n22\tpub type png_uint_32 = u32;\n23\tpub type png_fixed_point = i32;\n24\tpub type png_structp = *mut c_void;\n25\tpub type png_infop = *mut c_void;\n26\tpub type png_voidp = *mut c_void;\n27\tpub type png_bytep = *mut png_byte;\n28\tpub type png_const_bytep = *const png_byte;\n29\tpub type png_charp = *mut c_char;\n30\tpub type png_const_charp = *const c_char;\n31\t\n32\t#[repr(C)]\n33\t#[derive(Clone, Copy, Default, Debug, PartialEq)]\n34\tpub struct png_color {\n35\t    pub red: png_byte,\n36\t    pub green: png_byte,\n37\t    pub blue: png_byte,\n38\t}\n39\t\n40\t#[repr(C)]\n41\t#[derive(Clone, Copy, Default, Debug, PartialEq)]\n42\tpub struct png_color_16 {\n43\t    pub index: png_byte,\n44\t    pub red: png_uint_16,\n45\t    pub green: png_uint_16,\n46\t    pub blue: png_uint_16,\n47\t    pub gray: png_uint_16,\n48\t}\n49\t\n50\t#[repr(C)]\n51\t#[derive(Clone, Copy, Default, Debug, PartialEq)]\n52\tpub struct png_color_8 {\n53\t    pub red: png_byte,\n54\t    pub green: png_byte,\n55\t    pub blue: png_byte,\n56\t    pub gray: png_byte,\n57\t    pub alpha: png_byte,\n58\t}\n59\t\n60\t#[repr(C)]\n61\t#[derive(Clone, Copy, Default, Debug, PartialEq)]\n62\tpub struct png_sPLT_entry {\n63\t    pub red: png_uint_16,\n64\t    pub green: png_uint_16,\n65\t    pub blue: png_uint_16,\n66\t    pub alpha: png_uint_16,\n67\t    pub frequency: png_uint_16,\n68\t}\n69\t\n70\t#[repr(C)]\n71\t#[derive(Clone, Copy, Debug)]\n72\tpub struct png_sPLT_t {\n73\t    pub name: png_charp,\n74\t    pub depth: png_byte,\n75\t    pub entries: *mut png_sPLT_entry,\n76\t    pub nentries: png_int_32,\n77\t}\n78\t\n79\t#[repr(C)]\n80\t#[derive(Clone, Copy, Debug)]\n81\tpub struct png_text {\n82\t    pub compression: c_int,\n83\t    pub key: png_charp,\n84\t    pub text: png_charp,\n85\t    pub text_length: usize,\n86\t    pub itxt_length: usize,\n87\t    pub lang: png_charp,\n88\t    pub lang_key: png_charp,\n89\t}\n90\t\n91\t#[repr(C)]\n92\t#[derive(Clone, Copy, Default, Debug, PartialEq)]\n93\tpub struct png_time {\n94\t    pub year: png_uint_16,\n95\t    pub month: png_byte,\n96\t    pub day: png_byte,\n97\t    pub hour: png_byte,\n98\t    pub minute: png_byte,\n99\t    pub second: png_byte,\n100\t}\n101\t\n102\t#[repr(C)]\n103\t#[derive(Clone, Copy, Debug)]\n104\tpub struct png_unknown_chunk {\n105\t    pub name: [png_byte; 5],\n106\t    pub data: *mut png_byte,\n107\t    pub size: usize,\n108\t    pub location: png_byte,\n109\t}\n110\t\n111\t#[repr(C)]\n112\t#[derive(Clone, Copy, Default, Debug, PartialEq)]\n113\tpub struct png_row_info {\n114\t    pub width: png_uint_32,\n115\t    pub rowbytes: usize,\n116\t    pub color_type: png_byte,\n117\t    pub bit_depth: png_byte,\n118\t    pub channels: png_byte,\n119\t    pub pixel_depth: png_byte,\n120\t}\n121\t\n122\t#[repr(C)]\n123\t#[derive(Clone, Copy)]\n124\tpub struct png_image {\n125\t    pub opaque: *mut c_void,\n126\t    pub version: png_uint_32,\n127\t    pub width: png_uint_32,\n128\t    pub height: png_uint_32,\n129\t    pub format: png_uint_32,\n130\t    pub flags: png_uint_32,\n131\t    pub colormap_entries: png_uint_32,\n132\t    pub warning_or_error: png_uint_32,\n133\t    pub message: [c_char; 64],\n134\t}\n135\t\n136\timpl Default for png_image {\n137\t    fn default() -> Self {\n138\t        png_image {\n139\t            opaque: std::ptr::null_mut(),\n140\t            version: 1,\n141\t            width: 0,\n142\t            height: 0,\n143\t            format: 0,\n144\t            flags: 0,\n145\t            colormap_entries: 0,\n146\t            warning_or_error: 0,\n147\t            message: [0; 64],\n148\t        }\n149\t    }\n150\t}\n151\t\n152\timpl png_image {\n153\t    pub fn msg(&self) -> String {\n154\t        let b: Vec<u8> = self\n155\t            .message\n156\t            .iter()\n157\t            .take_while(|&&c| c != 0)\n158\t            .map(|&c| c as u8)\n159\t            .collect();\n160\t        String::from_utf8_lossy(&b).into_owned()\n161\t    }\n162\t    /// everything except `opaque` (which is a heap pointer and always differs)\n163\t    pub fn cmp_key(&self) -> (u32, u32, u32, u32, u32, u32, u32, String) {\n164\t        (\n165\t            self.version,\n166\t            self.width,\n167\t            self.height,\n168\t            self.format,\n169\t            self.flags,\n170\t            self.colormap_entries,\n171\t            self.warning_or_error,\n172\t            self.msg(),\n173\t        )\n174\t    }\n175\t}\n176\t\n177\t// -------------------------------------------------------------- png.h constants\n178\t\n179\tpub const PNG_LIBPNG_VER_STRING: &[u8] = b\"1.6.59\\0\";\n180\t\n181\tpub const PNG_COLOR_TYPE_GRAY: c_int = 0;\n182\tpub const PNG_COLOR_TYPE_PALETTE: c_int = 3;\n183\tpub const PNG_COLOR_TYPE_RGB: c_int = 2;\n184\tpub const PNG_COLOR_TYPE_RGB_ALPHA: c_int = 6;\n185\tpub const PNG_COLOR_TYPE_GRAY_ALPHA: c_int = 4;\n186\tpub const PNG_COLOR_MASK_PALETTE: c_int = 1;\n187\tpub const PNG_COLOR_MASK_COLOR: c_int = 2;\n188\tpub const PNG_COLOR_MASK_ALPHA: c_int = 4;\n189\t\n190\tpub const PNG_INTERLACE_NONE: c_int = 0;\n191\tpub const PNG_INTERLACE_ADAM7: c_int = 1;\n192\tpub const PNG_COMPRESSION_TYPE_BASE: c_int = 0;\n193\tpub const PNG_FILTER_TYPE_BASE: c_int = 0;\n194\tpub const PNG_INTRAPIXEL_DIFFERENCING: c_int = 64;\n195\t\n196\tpub const PNG_NO_FILTERS: c_int = 0x00;\n197\tpub const PNG_FILTER_NONE: c_int = 0x08;\n198\tpub const PNG_FILTER_SUB: c_int = 0x10;\n199\tpub const PNG_FILTER_UP: c_int = 0x20;\n200\tpub const PNG_FILTER_AVG: c_int = 0x40;\n201\tpub const PNG_FILTER_PAETH: c_int = 0x80;\n202\tpub const PNG_ALL_FILTERS: c_int = 0xF8;\n203\t\n204\tpub const PNG_FILTER_VALUE_NONE: c_int = 0;\n205\tpub const PNG_FILTER_VALUE_SUB: c_int = 1;\n206\tpub const PNG_FILTER_VALUE_UP: c_int = 2;\n207\tpub const PNG_FILTER_VALUE_AVG: c_int = 3;\n208\tpub const PNG_FILTER_VALUE_PAETH: c_int = 4;\n209\t\n210\tpub const PNG_UINT_31_MAX: png_uint_32 = 0x7fff_ffff;\n211\tpub const PNG_FP_1: png_fixed_point = 100000;\n212\t\n213\tpub const PNG_INFO_gAMA: png_uint_32 = 0x0001;\n214\tpub const PNG_INFO_sBIT: png_uint_32 = 0x0002;\n215\tpub const PNG_INFO_cHRM: png_uint_32 = 0x0004;\n216\tpub const PNG_INFO_PLTE: png_uint_32 = 0x0008;\n217\tpub const PNG_INFO_tRNS: png_uint_32 = 0x0010;\n218\tpub const PNG_INFO_bKGD: png_uint_32 = 0x0020;\n219\tpub const PNG_INFO_hIST: png_uint_32 = 0x0040;\n220\tpub const PNG_INFO_pHYs: png_uint_32 = 0x0080;\n221\tpub const PNG_INFO_oFFs: png_uint_32 = 0x0100;\n222\tpub const PNG_INFO_tIME: png_uint_32 = 0x0200;\n223\tpub const PNG_INFO_pCAL: png_uint_32 = 0x0400;\n224\tpub const PNG_INFO_sRGB: png_uint_32 = 0x0800;\n225\tpub const PNG_INFO_iCCP: png_uint_32 = 0x1000;\n226\tpub const PNG_INFO_sPLT: png_uint_32 = 0x2000;\n227\tpub const PNG_INFO_sCAL: png_uint_32 = 0x4000;\n228\tpub const PNG_INFO_IDAT: png_uint_32 = 0x8000;\n229\tpub const PNG_INFO_eXIf: png_uint_32 = 0x10000;\n230\tpub const PNG_INFO_cICP: png_uint_32 = 0x20000;\n231\tpub const PNG_INFO_cLLI: png_uint_32 = 0x40000;\n232\tpub const PNG_INFO_mDCV: png_uint_32 = 0x80000;\n233\t\n234\tpub const PNG_TRANSFORM_IDENTITY: c_int = 0x0000;\n235\tpub const PNG_TRANSFORM_STRIP_16: c_int = 0x0001;\n236\tpub const PNG_TRANSFORM_STRIP_ALPHA: c_int = 0x0002;\n237\tpub const PNG_TRANSFORM_PACKING: c_int = 0x0004;\n238\tpub const PNG_TRANSFORM_PACKSWAP: c_int = 0x0008;\n239\tpub const PNG_TRANSFORM_EXPAND: c_int = 0x0010;\n240\tpub const PNG_TRANSFORM_INVERT_MONO: c_int = 0x0020;\n241\tpub const PNG_TRANSFORM_SHIFT: c_int = 0x0040;\n242\tpub const PNG_TRANSFORM_BGR: c_int = 0x0080;\n243\tpub const PNG_TRANSFORM_SWAP_ALPHA: c_int = 0x0100;\n244\tpub const PNG_TRANSFORM_SWAP_ENDIAN: c_int = 0x0200;\n245\tpub const PNG_TRANSFORM_INVERT_ALPHA: c_int = 0x0400;\n246\tpub const PNG_TRANSFORM_STRIP_FILLER: c_int = 0x0800;\n247\tpub const PNG_TRANSFORM_STRIP_FILLER_BEFORE: c_int = 0x0800;\n248\tpub const PNG_TRANSFORM_STRIP_FILLER_AFTER: c_int = 0x1000;\n249\tpub const PNG_TRANSFORM_GRAY_TO_RGB: c_int = 0x2000;\n250\tpub const PNG_TRANSFORM_EXPAND_16: c_int = 0x4000;\n251\tpub const PNG_TRANSFORM_SCALE_16: c_int = 0x8000;\n252\t\n253\tpub const PNG_FILLER_BEFORE: c_int = 0;\n254\tpub const PNG_FILLER_AFTER: c_int = 1;\n255\t\n256\tpub const PNG_BACKGROUND_GAMMA_UNKNOWN: c_int = 0;\n257\tpub const PNG_BACKGROUND_GAMMA_SCREEN: c_int = 1;\n258\tpub const PNG_BACKGROUND_GAMMA_FILE: c_int = 2;\n259\tpub const PNG_BACKGROUND_GAMMA_UNIQUE: c_int = 3;\n260\t\n261\tpub const PNG_ALPHA_PNG: c_int = 0;\n262\tpub const PNG_ALPHA_STANDARD: c_int = 1;\n263\tpub const PNG_ALPHA_ASSOCIATED: c_int = 1;\n264\tpub const PNG_ALPHA_OPTIMIZED: c_int = 2;\n265\tpub const PNG_ALPHA_BROKEN: c_int = 3;\n266\t\n267\tpub const PNG_DEFAULT_sRGB: png_fixed_point = -1;\n268\tpub const PNG_GAMMA_MAC_18: png_fixed_point = -2;\n269\t\n270\tpub const PNG_ERROR_ACTION_NONE: c_int = 1;\n271\tpub const PNG_ERROR_ACTION_WARN: c_int = 2;\n272\tpub const PNG_ERROR_ACTION_ERROR: c_int = 3;\n273\t\n274\tpub const PNG_CRC_DEFAULT: c_int = 0;\n275\tpub const PNG_CRC_ERROR_QUIT: c_int = 1;\n276\tpub const PNG_CRC_WARN_DISCARD: c_int = 2;\n277\tpub const PNG_CRC_WARN_USE: c_int = 3;\n278\tpub const PNG_CRC_QUIET_USE: c_int = 4;\n279\tpub const PNG_CRC_NO_CHANGE: c_int = 5;\n280\t\n281\tpub const PNG_HANDLE_CHUNK_AS_DEFAULT: c_int = 0;\n282\tpub const PNG_HANDLE_CHUNK_NEVER: c_int = 1;\n283\tpub const PNG_HANDLE_CHUNK_IF_SAFE: c_int = 2;\n284\tpub const PNG_HANDLE_CHUNK_ALWAYS: c_int = 3;\n285\t\n286\tpub const PNG_HAVE_IHDR: c_int = 0x01;\n287\tpub const PNG_HAVE_PLTE: c_int = 0x02;\n288\tpub const PNG_AFTER_IDAT: c_int = 0x08;\n289\t\n290\tpub const PNG_FREE_ALL: c_int = 0x7FFF;\n291\tpub const PNG_FREE_TEXT: c_int = 0x0200;\n292\tpub const PNG_FREE_PLTE: c_int = 0x1000;\n293\tpub const PNG_FREE_HIST: c_int = 0x0008;\n294\tpub const PNG_FREE_TRNS: c_int = 0x0800;\n295\tpub const PNG_FREE_SPLT: c_int = 0x0020;\n296\tpub const PNG_FREE_UNKN: c_int = 0x0040;\n297\tpub const PNG_FREE_ICCP: c_int = 0x0100;\n298\tpub const PNG_FREE_ROWS: c_int = 0x0400;\n299\tpub const PNG_FREE_PCAL: c_int = 0x0010;\n300\tpub const PNG_FREE_SCAL: c_int = 0x0004;\n301\t\n302\tpub const PNG_DESTROY_WILL_FREE_DATA: c_int = 1;\n303\tpub const PNG_SET_WILL_FREE_DATA: c_int = 1;\n304\tpub const PNG_USER_WILL_FREE_DATA: c_int = 2;\n305\t\n306\tpub const PNG_TEXT_COMPRESSION_NONE: c_int = -1;\n307\tpub const PNG_TEXT_COMPRESSION_zTXt: c_int = 0;\n308\tpub const PNG_ITXT_COMPRESSION_NONE: c_int = 1;\n309\tpub const PNG_ITXT_COMPRESSION_zTXt: c_int = 2;\n310\t\n311\tpub const PNG_MAXIMUM_INFLATE_WINDOW: c_int = 2;\n312\tpub const PNG_SKIP_sRGB_CHECK_PROFILE: c_int = 4;\n313\tpub const PNG_IGNORE_ADLER32: c_int = 8;\n314\tpub const PNG_OPTION_UNSET: c_int = 0;\n315\tpub const PNG_OPTION_INVALID: c_int = 1;\n316\tpub const PNG_OPTION_OFF: c_int = 2;\n317\tpub const PNG_OPTION_ON: c_int = 3;\n318\t\n319\tpub const PNG_FLAG_MNG_EMPTY_PLTE: c_int = 0x01;\n320\tpub const PNG_FLAG_MNG_FILTER_64: c_int = 0x04;\n321\tpub const PNG_ALL_MNG_FEATURES: c_int = 0x05;\n322\t\n323\tpub const PNG_FORMAT_FLAG_ALPHA: png_uint_32 = 0x01;\n324\tpub const PNG_FORMAT_FLAG_COLOR: png_uint_32 = 0x02;\n325\tpub const PNG_FORMAT_FLAG_LINEAR: png_uint_32 = 0x04;\n326\tpub const PNG_FORMAT_FLAG_COLORMAP: png_uint_32 = 0x08;\n327\tpub const PNG_FORMAT_FLAG_BGR: png_uint_32 = 0x10;\n328\tpub const PNG_FORMAT_FLAG_AFIRST: png_uint_32 = 0x20;\n329\tpub const PNG_FORMAT_GRAY: png_uint_32 = 0;\n330\tpub const PNG_FORMAT_GA: png_uint_32 = PNG_FORMAT_FLAG_ALPHA;\n331\tpub const PNG_FORMAT_AG: png_uint_32 = PNG_FORMAT_GA | PNG_FORMAT_FLAG_AFIRST;\n332\tpub const PNG_FORMAT_RGB: png_uint_32 = PNG_FORMAT_FLAG_COLOR;\n333\tpub const PNG_FORMAT_BGR: png_uint_32 = PNG_FORMAT_FLAG_COLOR | PNG_FORMAT_FLAG_BGR;\n334\tpub const PNG_FORMAT_RGBA: png_uint_32 = PNG_FORMAT_RGB | PNG_FORMAT_FLAG_ALPHA;\n335\tpub const PNG_FORMAT_ARGB: png_uint_32 = PNG_FORMAT_RGBA | PNG_FORMAT_FLAG_AFIRST;\n336\tpub const PNG_FORMAT_BGRA: png_uint_32 = PNG_FORMAT_BGR | PNG_FORMAT_FLAG_ALPHA;\n337\tpub const PNG_FORMAT_ABGR: png_uint_32 = PNG_FORMAT_BGRA | PNG_FORMAT_FLAG_AFIRST;\n338\tpub const PNG_FORMAT_LINEAR_Y: png_uint_32 = PNG_FORMAT_FLAG_LINEAR;\n339\tpub const PNG_FORMAT_LINEAR_Y_ALPHA: png_uint_32 =\n340\t    PNG_FORMAT_FLAG_LINEAR | PNG_FORMAT_FLAG_ALPHA;\n341\tpub const PNG_FORMAT_LINEAR_RGB: png_uint_32 = PNG_FORMAT_FLAG_LINEAR | PNG_FORMAT_FLAG_COLOR;\n342\tpub const PNG_FORMAT_LINEAR_RGB_ALPHA: png_uint_32 =\n343\t    PNG_FORMAT_FLAG_LINEAR | PNG_FORMAT_FLAG_COLOR | PNG_FORMAT_FLAG_ALPHA;\n344\tpub const PNG_FORMAT_RGB_COLORMAP: png_uint_32 = PNG_FORMAT_RGB | PNG_FORMAT_FLAG_COLORMAP;\n345\tpub const PNG_FORMAT_BGR_COLORMAP: png_uint_32 = PNG_FORMAT_BGR | PNG_FORMAT_FLAG_COLORMAP;\n346\tpub const PNG_FORMAT_RGBA_COLORMAP: png_uint_32 = PNG_FORMAT_RGBA | PNG_FORMAT_FLAG_COLORMAP;\n347\tpub const PNG_FORMAT_GRAY_COLORMAP: png_uint_32 = PNG_FORMAT_GRAY | PNG_FORMAT_FLAG_COLORMAP;\n348\tpub const PNG_IMAGE_VERSION: png_uint_32 = 1;\n349\t\n350\tpub const PNG_NUMBER_FORMAT_u: c_int = 1;\n351\tpub const PNG_NUMBER_FORMAT_02u: c_int = 2;\n352\tpub const PNG_NUMBER_FORMAT_d: c_int = 1;\n353\tpub const PNG_NUMBER_FORMAT_02d: c_int = 2;\n354\tpub const PNG_NUMBER_FORMAT_x: c_int = 3;\n355\tpub const PNG_NUMBER_FORMAT_02x: c_int = 4;\n356\tpub const PNG_NUMBER_FORMAT_fixed: c_int = 5;\n357\tpub const PNG_NUMBER_BUFFER_SIZE: usize = 24;\n358\tpub const PNG_WARNING_PARAMETER_SIZE: usize = 32;\n359\tpub const PNG_WARNING_PARAMETER_COUNT: usize = 8;\n360\tpub const PNG_fp_MAX: usize = 32;\n361\t\n362\t// ------------------------------------------------------------ library loading\n363\t\n364\tpub struct Libs {\n365\t    pub c: Library,\n366\t    pub rs: Library,\n367\t}\n368\t\n369\tunsafe impl Send for Libs {}\n370\tunsafe impl Sync for Libs {}\n371\t\n372\tstatic LIBS: OnceLock<Libs> = OnceLock::new();\n373\t\n374\tpub fn libs() -> &'static Libs {\n375\t    LIBS.get_or_init(|| {\n376\t        let root = std::path::Path::new(env!(\"CARGO_MANIFEST_DIR\"));\n377\t        let cpath = root.join(\"../c_src/build/libpng.so\");\n378\t        let rpath = root.join(\"target/release/liblibpng.so\");\n379\t        let rpath = if rpath.exists() {\n380\t            rpath\n381\t        } else {\n382\t            root.join(\"target/debug/liblibpng.so\")\n383\t        };\n384\t        unsafe {\n385\t            Libs {\n386\t                c: Library::new(&cpath)\n387\t                    .unwrap_or_else(|e| panic!(\"load {}: {e}\", cpath.display())),\n388\t                rs: Library::new(&rpath)\n389\t                    .unwrap_or_else(|e| panic!(\"load {}: {e}\", rpath.display())),\n390\t            }\n391\t        }\n392\t    })\n393\t}\n394\t\n395\t/// Fetch a symbol of type `T` from a library, panicking with a clear message.\n396\tpub fn sym<'a, T>(lib: &'a Library, name: &str) -> Symbol<'a, T> {\n397\t    let mut n = name.as_bytes().to_vec();\n398\t    n.push(0);\n399\t    unsafe { lib.get::<T>(&n).unwrap_or_else(|e| panic!(\"symbol {name}: {e}\")) }\n400\t}\n401\t\n402\t/// Run `f` once against the C library and once against the Rust library.\n403\tpub fn both<R, F: Fn(&'static Library) -> R>(f: F) -> (R, R) {\n404\t    let l = libs();\n405\t    (f(&l.c), f(&l.rs))\n406\t}\n407\t\n408\t// ------------------------------------------------------- error/warning capture\n409\t//\n410\t// libpng reports errors through the app's error callback which is expected NOT\n411\t// to return (the app longjmps).  We install a callback that records the exact\n412\t// message bytes and then unwinds via `panic!`, which is the translated crate's\n413\t// own stand-in for longjmp and which propagates correctly out of the C frames\n414\t// too (they are compiled with -fasynchronous-unwind-tables and have no\n415\t// cleanups).\n416\t\n417\t#[derive(Clone, Debug, PartialEq, Eq)]\n418\tpub enum Msg {\n419\t    Warn(Vec<u8>),\n420\t    Err(Vec<u8>),\n421\t}\n422\t\n423\timpl std::fmt::Display for Msg {\n424\t    fn fmt(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {\n425\t        match self {\n426\t            Msg::Warn(m) => write!(f, \"WARN({})\", String::from_utf8_lossy(m)),\n427\t            Msg::Err(m) => write!(f, \"ERR({})\", String::from_utf8_lossy(m)),\n428\t        }\n429\t    }\n430\t}\n431\t\n432\tthread_local! {\n433\t    static LOG: RefCell<Vec<Msg>> = const { RefCell::new(Vec::new()) };\n434\t}\n435\t\n436\tpub fn log_clear() {\n437\t    LOG.with(|l| l.borrow_mut().clear());\n438\t}\n439\tpub fn log_take() -> Vec<Msg> {\n440\t    LOG.with(|l| std::mem::take(&mut *l.borrow_mut()))\n441\t}\n442\tpub fn log_push(m: Msg) {\n443\t    LOG.with(|l| l.borrow_mut().push(m));\n444\t}\n445\t\n446\tunsafe fn cstr_bytes(s: png_const_charp) -> Vec<u8> {\n447\t    if s.is_null() {\n448\t        b\"<null>\".to_vec()\n449\t    } else {\n450\t        CStr::from_ptr(s).to_bytes().to_vec()\n451\t    }\n452\t}\n453\t\n454\tstruct PngLongjmp;\n455\t\n456\tpub unsafe extern \"C-unwind\" fn rec_error(_pp: png_structp, msg: png_const_charp) {\n457\t    log_push(Msg::Err(cstr_bytes(msg)));\n458\t    std::panic::panic_any(PngLongjmp);\n459\t}\n460\t\n461\tpub unsafe extern \"C-unwind\" fn rec_warning(_pp: png_structp, msg: png_const_charp) {\n462\t    log_push(Msg::Warn(cstr_bytes(msg)));\n463\t}\n464\t\n465\t/// Result of one differential operation.\n466\tpub struct Run<T> {\n467\t    pub out: Option<T>, // None == the library errored out (longjmp/panic)\n468\t    pub log: Vec<Msg>,\n469\t}\n470\t\n471\timpl<T: PartialEq + std::fmt::Debug> Run<T> {\n472\t    pub fn assert_eq(&self, other: &Run<T>, what: &str) {\n473\t        assert_eq!(\n474\t            self.log.iter().map(|m| m.to_string()).collect::<Vec<_>>(),\n475\t            other.log.iter().map(|m| m.to_string()).collect::<Vec<_>>(),\n476\t            \"{what}: message log differs (C first)\"\n477\t        );\n478\t        assert_eq!(\n479\t            self.out.is_some(),\n480\t            other.out.is_some(),\n481\t            \"{what}: one library errored and the other did not (C errored={})\",\n482\t            self.out.is_none()\n483\t        );\n484\t        assert_eq!(self.out, other.out, \"{what}: output differs\");\n485\t    }\n486\t}\n487\t\n488\t/// Execute `f`, capturing an error-callback unwind and the message log.\n489\tpub fn capture<T, F: FnOnce() -> T>(f: F) -> Run<T> {\n490\t    log_clear();\n491\t    let prev = std::panic::take_hook();\n492\t    std::panic::set_hook(Box::new(|_| {}));\n493\t    let out = std::panic::catch_unwind(std::panic::AssertUnwindSafe(f)).ok();\n494\t    std::panic::set_hook(prev);\n495\t    Run { out, log: log_take() }\n496\t}\n497\t\n498\t/// Same as [`capture`] but re-raises a panic that is *not* a libpng error\n499\t/// (i.e. a genuine bug such as an arithmetic overflow or index panic).\n500\tpub fn capture_strict<T, F: FnOnce() -> T>(f: F) -> Run<T> {\n501\t    log_clear();\n502\t    let prev = std::panic::take_hook();\n503\t    std::panic::set_hook(Box::new(|_| {}));\n504\t    let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(f));\n505\t    std::panic::set_hook(prev);\n506\t    let out = match r {\n507\t        Ok(v) => Some(v),\n508\t        Err(e) => {\n509\t            if e.downcast_ref::<PngLongjmp>().is_some() {\n510\t                None\n511\t            } else {\n512\t                std::panic::resume_unwind(e);\n513\t            }\n514\t        }\n515\t    };\n516\t    Run { out, log: log_take() }\n517\t}\n518\t\n519\t// --------------------------------------------------------------- I/O plumbing\n520\t\n521\t/// Sink for `png_set_write_fn`: collects all bytes libpng writes.\n522\tpub struct WriteSink {\n523\t    pub data: Vec<u8>,\n524\t    pub flushes: usize,\n525\t}\n526\t\n527\t// The sink/source is reached through a thread-local rather than through\n528\t// `png_get_io_ptr` so that the harness never has to interpret the internals of\n529\t// either library's `png_struct`.  The io_ptr we hand to `png_set_write_fn` /\n530\t// `png_set_read_fn` is still non-NULL and is checked separately by the\n531\t// `png_get_io_ptr` differential test.\n532\tthread_local! {\n533\t    static SINK: RefCell<WriteSink> = const { RefCell::new(WriteSink { data: Vec::new(), flushes: 0 }) };\n534\t    static SRC: RefCell<ReadSrc> = const { RefCell::new(ReadSrc { data: Vec::new(), pos: 0 }) };\n535\t}\n536\t\n537\tpub fn sink_reset() {\n538\t    SINK.with(|s| {\n539\t        let mut s = s.borrow_mut();\n540\t        s.data.clear();\n541\t        s.flushes = 0;\n542\t    });\n543\t}\n544\tpub fn sink_take() -> (Vec<u8>, usize) {\n545\t    SINK.with(|s| {\n546\t        let mut s = s.borrow_mut();\n547\t        (std::mem::take(&mut s.data), std::mem::replace(&mut s.flushes, 0))\n548\t    })\n549\t}\n550\tpub fn sink_len() -> usize {\n551\t    SINK.with(|s| s.borrow().data.len())\n552\t}\n553\tpub fn src_set(data: &[u8]) {\n554\t    SRC.with(|s| {\n555\t        let mut s = s.borrow_mut();\n556\t        s.data = data.to_vec();\n557\t        s.pos = 0;\n558\t    });\n559\t}\n560\tpub fn src_pos() -> usize {\n561\t    SRC.with(|s| s.borrow().pos)\n562\t}\n563\t\n564\tpub unsafe extern \"C-unwind\" fn write_cb(_pp: png_structp, data: png_bytep, len: usize) {\n565\t    let slice = std::slice::from_raw_parts(data, len);\n566\t    SINK.with(|s| s.borrow_mut().data.extend_from_slice(slice));\n567\t}\n568\t\n569\tpub unsafe extern \"C-unwind\" fn flush_cb(_pp: png_structp) {\n570\t    SINK.with(|s| s.borrow_mut().flushes += 1);\n571\t}\n572\t\n573\t/// Source for `png_set_read_fn`.\n574\tpub struct ReadSrc {\n575\t    pub data: Vec<u8>,\n576\t    pub pos: usize,\n577\t}\n578\t\n579\tpub unsafe extern \"C-unwind\" fn read_cb(_pp: png_structp, out: png_bytep, len: usize) {\n580\t    let n = SRC.with(|s| {\n581\t        let mut s = s.borrow_mut();\n582\t        let avail = s.data.len().saturating_sub(s.pos);\n583\t        let n = core::cmp::min(len, avail);\n584\t        if n > 0 {\n585\t            std::ptr::copy_nonoverlapping(s.data.as_ptr().add(s.pos), out, n);\n586\t            s.pos += n;\n587\t        }\n588\t        n\n589\t    });\n590\t    if n < len {\n591\t        // A real app's read callback must not return short; it calls png_error,\n592\t        // which longjmps.  Do the equivalent, identically for both libraries.\n593\t        log_push(Msg::Err(b\"harness: short read\".to_vec()));\n594\t        std::panic::panic_any(PngLongjmp);\n595\t    }\n596\t}\n597\t\n598\t// ------------------------------------------------------------ tiny RNG (xorshift)\n599\t\n600\tpub struct Rng(u64);\n601\t\n602\timpl Rng {\n603\t    pub fn new(seed: u64) -> Rng {\n604\t        Rng(seed | 1)\n605\t    }\n606\t    pub fn next_u64(&mut self) -> u64 {\n607\t        let mut x = self.0;\n608\t        x ^= x << 13;\n609\t        x ^= x >> 7;\n610\t        x ^= x << 17;\n611\t        self.0 = x;\n612\t        x\n613\t    }\n614\t    pub fn u32(&mut self) -> u32 {\n615\t        (self.next_u64() >> 32) as u32\n616\t    }\n617\t    pub fn u8(&mut self) -> u8 {\n618\t        (self.next_u64() >> 56) as u8\n619\t    }\n620\t    pub fn below(&mut self, n: u32) -> u32 {\n621\t        if n == 0 {\n622\t            0\n623\t        } else {\n624\t            self.u32() % n\n625\t        }\n626\t    }\n627\t    pub fn range_i32(&mut self, lo: i32, hi: i32) -> i32 {\n628\t        lo + (self.below((hi - lo + 1) as u32) as i32)\n629\t    }\n630\t    pub fn bytes(&mut self, n: usize) -> Vec<u8> {\n631\t        (0..n).map(|_| self.u8()).collect()\n632\t    }\n633\t    pub fn f64_unit(&mut self) -> f64 {\n634\t        (self.next_u64() >> 11) as f64 / (1u64 << 53) as f64\n635\t    }\n636\t}\n637\t\n638\tpub fn cs(s: &str) -> CString {\n639\t    CString::new(s).unwrap()\n640\t}\n641\t\n642\tpub fn hex(b: &[u8]) -> String {\n643\t    b.iter().map(|x| format!(\"{x:02x}\")).collect()\n644\t}\n645\t\n646\tpub type c_charp = *mut c_char;\n647\tpub type PngErrorFn = unsafe extern \"C-unwind\" fn(png_structp, png_const_charp);\n648\tpub type PngRwFn = unsafe extern \"C-unwind\" fn(png_structp, png_bytep, usize);\n649\tpub type PngFlushFn = unsafe extern \"C-unwind\" fn(png_structp);\n650\tpub type c_size = usize;\n651\tpub type C_int = c_int;\n652\tpub type C_uint = c_uint;\n653\tpub type C_long = c_long;\n654\tpub type C_ulong = c_ulong;\n655\tpub type C_double = c_double;\n656\t\n657\t// ------------------------------------------------------------- API bindings\n658\t\n659\t#[macro_export]\n660\tmacro_rules! decl_api {\n661\t    ($( fn $name:ident ( $($p:ident : $t:ty),* $(,)? ) $(-> $r:ty)? ; )*) => {\n662\t        $(\n663\t            #[allow(clippy::too_many_arguments)]\n664\t            pub unsafe fn $name(l: &::libloading::Library, $($p: $t),*) $(-> $r)? {\n665\t                let f: ::libloading::Symbol<unsafe extern \"C-unwind\" fn($($t),*) $(-> $r)?> =\n666\t                    $crate::common::sym(l, stringify!($name));\n667\t                f($($p),*)\n668\t            }\n669\t        )*\n670\t    };\n671\t}\n672\t\n673\tpub mod api;\n674\t"}]},"parent_tool_use_id":"toolu_bdrk_012M3mdF1NGDE8vXy56KWEEg","session_id":"814b2895-9042-4f5f-bd73-35bea46615cb","uuid":"bc7bca60-3c3c-46b5-b4a8-3d3d6e8fd655","timestamp":"2026-09-08T15:23:24.225Z","subagent_type":"general-purpose","task_description":"Write t_err1.rs error-path tests"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01S6LQkjMnZmGqgfbK5w4Zmd","type":"tool_result","content":"png_image_set_PLTE(png_image_write_control *display)\n{\n   png_imagep image = display->image;\n   const void *cmap = display->colormap;\n   int entries = image->colormap_entries > 256 ? 256 :\n       (int)image->colormap_entries;\n\n   /* NOTE: the caller must check for cmap != NULL and entries != 0 */\n   png_uint_32 format = image->format;\n   unsigned int channels = PNG_IMAGE_SAMPLE_CHANNELS(format);\n\n#   if defined(PNG_FORMAT_BGR_SUPPORTED) &&\\\n      defined(PNG_SIMPLIFIED_WRITE_AFIRST_SUPPORTED)\n      int afirst = (format & PNG_FORMAT_FLAG_AFIRST) != 0 &&\n          (format & PNG_FORMAT_FLAG_ALPHA) != 0;\n#   else\n#     define afirst 0\n#   endif\n\n#   ifdef PNG_FORMAT_BGR_SUPPORTED\n      int bgr = (format & PNG_FORMAT_FLAG_BGR) != 0 ? 2 : 0;\n#   else\n#     define bgr 0\n#   endif\n\n   int i, num_trans;\n   png_color palette[256];\n   png_byte tRNS[256];\n\n   memset(tRNS, 255, (sizeof tRNS));\n   memset(palette, 0, (sizeof palette));\n\n   for (i=num_trans=0; i<entries; ++i)\n   {\n      /* This gets automatically converted to sRGB with reversal of the\n       * pre-multiplication if the color-map has an alpha channel.\n       */\n      if ((format & PNG_FORMAT_FLAG_LINEAR) != 0)\n      {\n         png_const_uint_16p entry = png_voidcast(png_const_uint_16p, cmap);\n\n         entry += (unsigned int)i * channels;\n\n         if ((channels & 1) != 0) /* no alpha */\n         {\n            if (channels >= 3) /* RGB */\n            {\n               palette[i].blue = (png_byte)PNG_sRGB_FROM_LINEAR(255 *\n                   entry[(2 ^ bgr)]);\n               palette[i].green = (png_byte)PNG_sRGB_FROM_LINEAR(255 *\n                   entry[1]);\n               palette[i].red = (png_byte)PNG_sRGB_FROM_LINEAR(255 *\n                   entry[bgr]);\n            }\n\n            else /* Gray */\n               palette[i].blue = palette[i].red = palette[i].green =\n                  (png_byte)PNG_sRGB_FROM_LINEAR(255 * *entry);\n         }\n\n         else /* alpha */\n         {\n            png_uint_16 alpha = entry[afirst ? 0 : channels-1];\n            png_byte alphabyte = (png_byte)PNG_DIV257(alpha);\n            png_uint_32 reciprocal = 0;\n\n            /* Calculate a reciprocal, as in the png_write_image_8bit code above\n             * this is designed to produce a value scaled to 255*65535 when\n             * divided by 128 (i.e. asr 7).\n             */\n            if (alphabyte > 0 && alphabyte < 255)\n               reciprocal = (((0xffff*0xff)<<7)+(alpha>>1))/alpha;\n\n            tRNS[i] = alphabyte;\n            if (alphabyte < 255)\n               num_trans = i+1;\n\n            if (channels >= 3) /* RGB */\n            {\n               palette[i].blue = png_unpremultiply(entry[afirst + (2 ^ bgr)],\n                   alpha, reciprocal);\n               palette[i].green = png_unpremultiply(entry[afirst + 1], alpha,\n                   reciprocal);\n               palette[i].red = png_unpremultiply(entry[afirst + bgr], alpha,\n                   reciprocal);\n            }\n\n            else /* gray */\n               palette[i].blue = palette[i].red = palette[i].green =\n                   png_unpremultiply(entry[afirst], alpha, reciprocal);\n         }\n      }\n\n      else /* Color-map has sRGB values */\n      {\n         png_const_bytep entry = png_voidcast(png_const_bytep, cmap);\n\n         entry += (unsigned int)i * channels;\n\n         switch (channels)","is_error":false}]},"parent_tool_use_id":"toolu_bdrk_01LbBxjEteijbrPPa5EWUuMx","session_id":"814b2895-9042-4f5f-bd73-35bea46615cb","uuid":"5118d0fa-f936-4640-9300-2f8a2090601f","timestamp":"2026-09-08T15:23:24.230Z","subagent_type":"general-purpose","task_description":"Write t_simple.rs differential tests"}
