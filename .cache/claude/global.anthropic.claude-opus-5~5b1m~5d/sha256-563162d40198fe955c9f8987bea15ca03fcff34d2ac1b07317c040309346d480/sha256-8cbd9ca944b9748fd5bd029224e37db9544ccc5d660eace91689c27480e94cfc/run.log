{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01GcLs1d4L8AW5AiDqBgHGf9","type":"tool_result","content":"1\t//! Every libpng entry point used by the tests, declared once.  Each wrapper\n2\t//! takes the `Library` to call as its first argument and resolves the symbol\n3\t//! with `dlsym`, so the identical test body drives the C `.so` and the Rust\n4\t//! `.so`.\n5\t#![allow(dead_code)]\n6\t#![allow(non_snake_case)]\n7\t\n8\tuse super::*;\n9\tuse core::ffi::{c_char, c_double, c_int, c_long, c_uint, c_ulong, c_void};\n10\t\n11\tpub type PngRw = unsafe extern \"C-unwind\" fn(png_structp, png_bytep, usize);\n12\tpub type PngFlush = unsafe extern \"C-unwind\" fn(png_structp);\n13\tpub type PngErr = unsafe extern \"C-unwind\" fn(png_structp, png_const_charp);\n14\tpub type PngRowCb = unsafe extern \"C-unwind\" fn(png_structp, png_uint_32, c_int);\n15\tpub type PngInfoCb = unsafe extern \"C-unwind\" fn(png_structp, png_infop);\n16\tpub type PngProgRowCb = unsafe extern \"C-unwind\" fn(png_structp, png_bytep, png_uint_32, c_int);\n17\tpub type PngEndCb = unsafe extern \"C-unwind\" fn(png_structp, png_infop);\n18\tpub type PngUserChunkCb =\n19\t    unsafe extern \"C-unwind\" fn(png_structp, *mut png_unknown_chunk) -> c_int;\n20\tpub type PngUserTransformCb =\n21\t    unsafe extern \"C-unwind\" fn(png_structp, *mut png_row_info, png_bytep);\n22\tpub type PngMalloc = unsafe extern \"C-unwind\" fn(png_structp, usize) -> png_voidp;\n23\tpub type PngFreeFn = unsafe extern \"C-unwind\" fn(png_structp, png_voidp);\n24\t\n25\tcrate::decl_api! {\n26\t    // ---- version / misc\n27\t    fn png_access_version_number() -> png_uint_32;\n28\t    fn png_get_libpng_ver(pp: png_structp) -> png_const_charp;\n29\t    fn png_get_header_ver(pp: png_structp) -> png_const_charp;\n30\t    fn png_get_header_version(pp: png_structp) -> png_const_charp;\n31\t    fn png_get_copyright(pp: png_structp) -> png_const_charp;\n32\t    fn png_sig_cmp(sig: png_const_bytep, start: 