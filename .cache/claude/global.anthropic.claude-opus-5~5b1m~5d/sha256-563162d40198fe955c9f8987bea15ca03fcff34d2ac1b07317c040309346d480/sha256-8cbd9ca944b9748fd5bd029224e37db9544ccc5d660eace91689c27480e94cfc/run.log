0x9e37_79b9_7f4a_7c15] {\n        for &(ct, bd) in CT_BD {\n            for il in [0, 1] {\n                for &(w, h) in &[(9u32, 17u32), (33, 5)] {\n                    let png = make_png(ct, bd, il, w, h, seed);\n                    for mode in [Mode::Image, Mode::RowDisplay] {\n                        diff(\n                            &format!(\"cfg38 seed={seed:#x} ct={ct} bd={bd} il={il} {w}x{h} {mode:?}\"),\n                            &png,\n                            Opt {\n                                mode,\n                                ..Opt::default()\n                            },\n                            &nohook,\n                            &nohook,\n                        );\n                    }\n                }\n            }\n        }\n    }\n}\n\n// ===========================================================================\n// row 39 - one test per read transform\n// ==========================================================================='''\nassert old in s\ns = s.replace(old, new, 1)\n\n# --- progressive: more shapes -------------------------------------------\nold = '''#[test]\nfn cfg42_progressive_read() {\n    for &(ct, bd) in CT_BD {\n        for il in [0, 1] {\n            let png = make_png(ct, bd, il, 9, 7, 0x42_0004);\n            for granule in [1usize, 2, 3, 7, 13, usize::MAX] {\n                let g = if granule == usize::MAX {\n                    \"all\".to_string()\n                } else {\n                    granule.to_string()\n                };\n                diff_prog(\n                    &format!(\"cfg42 ct={ct} bd={bd} il={il} granule={g}\"),\n                    &png,\n                    ProgOpt {\n                        granule,\n                        ..ProgOpt::default()\n                    },\n                );\n            }\n        }\n    }\n}'''\nnew = '''#[test]\nfn cfg42_progressive_read() {\n    for &(ct, bd) in CT_BD {\n        for il in [0, 1] {\n            for &(w, h) in &[(