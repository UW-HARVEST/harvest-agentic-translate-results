{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01FobAJ9U88A3Nm9GUM6xz4b","type":"tool_result","content":"1\t//! Every libpng entry point used by the tests, declared once.  Each wrapper\n2\t//! takes the `Library` to call as its first argument and resolves the symbol\n3\t//! with `dlsym`, so the identical test body drives the C `.so` and the Rust\n4\t//! `.so`.\n5\t#![allow(dead_code)]\n6\t#![allow(non_snake_case)]\n7\t\n8\tuse super::*;\n9\tuse core::ffi::{c_char, c_double, c_int, c_long, c_uint, c_ulong, c_void};\n10\t\n11\tpub type PngRw = unsafe extern \"C-unwind\" fn(png_structp, png_bytep, usize);\n12\tpub type PngFlush = unsafe extern \"C-unwind\" fn(png_structp);\n13\tpub type PngErr = unsafe extern \"C-unwind\" fn(png_structp, png_const_charp);\n14\tpub type PngRowCb = unsafe extern \"C-unwind\" fn(png_structp, png_uint_32, c_int);\n15\tpub type PngInfoCb = unsafe extern \"C-unwind\" fn(png_structp, png_infop);\n16\tpub type PngProgRowCb = unsafe extern \"C-unwind\" fn(png_structp, png_bytep, png_uint_32, c_int);\n17\tpub type PngEndCb = unsafe extern \"C-unwind\" fn(png_structp, png_infop);\n18\tpub type PngUserChunkCb =\n19\t    unsafe extern \"C-unwind\" fn(png_structp, *mut png_unknown_chunk) -> c_int;\n20\tpub type PngUserTransformCb =\n21\t    unsafe extern \"C-unwind\" fn(png_structp, *mut png_row_info, png_bytep);\n22\tpub type PngMalloc = unsafe extern \"C-unwind\" fn(png_structp, usize) -> png_voidp;\n23\tpub type PngFreeFn = unsafe extern \"C-unwind\" fn(png_structp, png_voidp);\n24\t\n25\tcrate::decl_api! {\n26\t    // ---- version / misc\n27\t    fn png_access_version_number() -> png_uint_32;\n28\t    fn png_get_libpng_ver(pp: png_structp) -> png_const_charp;\n29\t    fn png_get_header_ver(pp: png_structp) -> png_const_charp;\n30\t    fn png_get_header_version(pp: png_structp) -> png_const_charp;\n31\t    fn png_get_copyright(pp: png_structp) -> png_const_charp;\n32\t    fn png_sig_cmp(sig: png_const_bytep, start: usize, num: usize) -> c_int;\n33\t\n34\t    // ---- byte order helpers\n35\t    fn png_save_uint_32(buf: png_bytep, i: png_uint_32);\n36\t    fn png_save_int_32(buf: png_bytep, i: png_int_32);\n37\t    fn png_save_uint_16(buf: png_bytep, i: c_uint);\n38\t    fn png_get_uint_32(buf: png_const_bytep) -> png_uint_32;\n39\t    fn png_get_uint_16(buf: png_const_bytep) -> png_uint_16;\n40\t    fn png_get_int_32(buf: png_const_bytep) -> png_int_32;\n41\t    fn png_get_uint_31(pp: png_structp, buf: png_const_bytep) -> png_uint_32;\n42\t\n43\t    // ---- arithmetic helpers\n44\t    fn png_muldiv(res: *mut png_fixed_point, a: png_fixed_point, times: png_int_32,\n45\t                  divisor: png_int_32) -> c_int;\n46\t    fn png_reciprocal(a: png_fixed_point) -> png_fixed_point;\n47\t    fn png_reciprocal2(a: png_fixed_point, b: png_fixed_point) -> png_fixed_point;\n48\t    fn png_fixed(pp: png_structp, fp: c_double, text: png_const_charp) -> png_fixed_point;\n49\t    fn png_fixed_ITU(pp: png_structp, fp: c_double, text: png_const_charp) -> png_fixed_point;\n50\t    fn png_gamma_significant(g: png_fixed_point) -> c_int;\n51\t    fn png_gamma_8bit_correct(value: c_uint, g: png_fixed_point) -> png_byte;\n52\t    fn png_gamma_16bit_correct(value: c_uint, g: png_fixed_point) -> png_uint_16;\n53\t    fn png_gamma_correct(pp: png_structp, value: c_uint, g: png_fixed_point) -> png_uint_16;\n54\t    fn png_XYZ_from_xy(xyz: *mut c_void, xy: *const c_void) -> c_int;\n55\t    fn png_xy_from_XYZ(xy: *mut c_void, xyz: *const c_void) -> c_int;\n56\t    fn png_check_fp_number(s: png_const_charp, size: usize, statep: *mut c_int,\n57\t                           whereami: *mut usize) -> c_int;\n58\t    fn png_check_fp_string(s: png_const_charp, size: usize) -> c_int;\n59\t    fn png_ascii_from_fp(pp: png_structp, ascii: png_charp, size: usize, fp: c_double,\n60\t                         precision: c_uint);\n61\t    fn png_ascii_from_fixed(pp: png_structp, ascii: png_charp, size: usize,\n62\t 