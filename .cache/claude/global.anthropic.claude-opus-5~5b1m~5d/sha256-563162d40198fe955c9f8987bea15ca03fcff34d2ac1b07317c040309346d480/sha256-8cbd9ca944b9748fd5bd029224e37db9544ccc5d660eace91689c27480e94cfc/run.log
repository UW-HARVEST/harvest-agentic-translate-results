n &actions {\n            for name in [b\"teSt\", b\"TEST\"] {'''\nnew = '''    let mut distinct: std::collections::BTreeSet<String> = Default::default();\n    for &crit in &actions {\n        for &ancil in &actions {\n            for name in [b\"teSt\", b\"TEST\"] {'''\nassert old in s\ns = s.replace(old, new, 1)\n\nold = '''                a.assert_eq(\n                    &b,\n                    &format!(\n                        \"crc_action(crit={crit}, ancil={ancil}) name={}\",\n                        String::from_utf8_lossy(name)\n                    ),\n                );\n            }\n        }\n    }\n}'''\nnew = '''                a.assert_eq(\n                    &b,\n                    &format!(\n                        \"crc_action(crit={crit}, ancil={ancil}) name={}\",\n                        String::from_utf8_lossy(name)\n                    ),\n                );\n                if let Some(h) = &a.out {\n                    distinct.insert(h.clone());\n                }\n            }\n        }\n    }\n    // PNG_CRC_QUIET_USE turns need_crc off inside png_calculate_crc, which\n    // must show up as a different trailing CRC.\n    assert!(\n        distinct.len() >= 4,\n        \"png_set_crc_action never changed the emitted CRC ({} distinct)\",\n        distinct.len()\n    );\n}'''\nassert old in s\ns = s.replace(old, new, 1)\n\n# ---- cfg67_handle_unknown_keep non-vacuity --------------------------------\nold = '''    for (label, name, body) in bodies {'''\nnew = '''    let mut codes: std::collections::BTreeSet<&'static str> = Default::default();\n    let mut saved = 0usize;\n    for (label, name, body) in bodies {'''\nassert old in s\ns = s.replace(old, new, 1)\n\nold = '''                a.assert_eq(\n                    &b,\n                    &format!(\"png_handle_unknown[{label}] keep={keep} global={global}\"),\n                );\n            }\n        }\n    }\n}'''\nnew = '''                a.assert_eq(\n                    &b,\n