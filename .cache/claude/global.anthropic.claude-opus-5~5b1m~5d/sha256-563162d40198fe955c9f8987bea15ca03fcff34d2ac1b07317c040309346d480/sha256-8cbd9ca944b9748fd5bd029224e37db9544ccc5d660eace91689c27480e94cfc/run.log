nt) -> c_int;\n504\t    fn png_icc_check_length(pp: png_structp, colorspace: *mut c_void,\n505\t                            name: png_const_charp, proflen: png_uint_32) -> c_int;\n506\t    fn png_icc_check_tag_table(pp: png_structp, colorspace: *mut c_void,\n507\t                               name: png_const_charp, proflen: png_uint_32,\n508\t                               profile: png_const_bytep) -> c_int;\n509\t    fn png_chunk_unknown_handling(pp: png_structp, chunk_name: png_uint_32) -> c_int;\n510\t    fn png_user_version_check(pp: png_structp, ver: png_const_charp) -> c_int;\n511\t}\n512\t\n513\t// ------------------------------------------------------------ convenience\n514\t\n515\t/// Create a write struct with the recording error/warning handlers and the\n516\t/// harness write sink installed.\n517\tpub unsafe fn new_writer(l: &::libloading::Library) -> png_structp {\n518\t    let pp = png_create_write_struct(\n519\t        l,\n520\t        PNG_LIBPNG_VER_STRING.as_ptr() as png_const_charp,\n521\t        1usize as png_voidp,\n522\t        Some(rec_error),\n523\t        Some(rec_warning),\n524\t    );\n525\t    assert!(!pp.is_null());\n526\t    png_set_write_fn(l, pp, 1usize as png_voidp, Some(write_cb), Some(flush_cb));\n527\t    pp\n528\t}\n529\t\n530\t/// Create a read struct with the recording handlers and the harness read\n531\t/// source installed (call [`src_set`] first).\n532\tpub unsafe fn new_reader(l: &::libloading::Library) -> png_structp {\n533\t    let pp = png_create_read_struct(\n534\t        l,\n535\t        PNG_LIBPNG_VER_STRING.as_ptr() as png_const_charp,\n536\t        1usize as png_voidp,\n537\t        Some(rec_error),\n538\t        Some(rec_warning),\n539\t    );\n540\t    assert!(!pp.is_null());\n541\t    png_set_read_fn(l, pp, 1usize as png_voidp, Some(read_cb));\n542\t    pp\n543\t}\n544\t"}]},"parent_tool_use_id":"toolu_bdrk_01D8yDYvQFjXi4pay6PRxu1y","session_id":"814b2895-9042-4f5f-bd73-35bea46615cb","uuid":"9b0c6d36-82ce-466b-9a