es.push((8, 8, 8, PNG_COLOR_TYPE_GRAY, 0, 0, ft));\n    }\n\n    diff(\n        \"row17\",\n        &cases,\n        |lib, &(w, h, bd, ct, il, cm, ft)| unsafe {\n            let pp = api::new_reader(lib);\n            api::png_check_IHDR(lib, pp, w, h, bd, ct, il, cm, ft);\n            destroy_reader(lib, pp);\n            0u8\n        },\n    );\n}\n\n// ============================================================ row 18\n// png_build_grayscale_palette\n\n#[test]\nfn r18_build_grayscale_palette() {\n    let mut cases: Vec<c_int> = vec![0, 1, 2, 3, 4, 8, 16];\n    cases.extend_from_slice(&[5, 6, 7, 9, 15, 17, 32, -1, -8, i32::MIN, i32::MAX]);\n\n    diff(\"row18\", &cases, |lib, &bd| unsafe {\n        let mut pal = [png_color {\n            red: 1,\n            green: 2,\n            blue: 3,\n        }; 256];\n        api::png_build_grayscale_palette(lib, bd, pal.as_mut_ptr());\n        pal.to_vec()\n    });\n\n    // NULL palette must be a no-op in both\n    diff(\"row18.null\", &[0i32, 1, 8, 16], |lib, &bd| unsafe {\n        api::png_build_grayscale_palette(lib, bd, std::ptr::null_mut());\n        0u8\n    });\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":793,"cache_read_input_tokens":107948,"cache_creation":{"ephemeral_5m_input_tokens":793,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_015Vpu62jt87qW7L9e5oxiyH","session_id":"814b2895-9042-4f5f-bd73-35bea46615cb","uuid":"fac15c1e-ddc3-4da8-a808-dc91b6901447","timestamp":"2026-09-08T15:28:46.517Z","subagent_type":"general-purpose","task_description":"Write t_pure.rs differential tests"}
