= 0)\n         png_warning(png_ptr, \"Ignoring invalid time value\");\n\n      else\n         return png_ptr->time_buffer;\n   }\n\n   return NULL;\n}\n-----\npng_convert_from_struct_tm(png_timep ptime, const struct tm * ttime)\n{\n   png_debug(1, \"in png_convert_from_struct_tm\");\n\n   ptime->year = (png_uint_16)(1900 + ttime->tm_year);\n   ptime->month = (png_byte)(ttime->tm_mon + 1);\n   ptime->day = (png_byte)ttime->tm_mday;\n   ptime->hour = (png_byte)ttime->tm_hour;\n   ptime->minute = (png_byte)ttime->tm_min;\n   ptime->second = (png_byte)ttime->tm_sec;\n}\n-----\npng_convert_from_time_t(png_timep ptime, time_t ttime)\n{\n   struct tm *tbuf;\n\n   png_debug(1, \"in png_convert_from_time_t\");\n\n   tbuf = gmtime(&ttime);\n   if (tbuf == NULL)\n   {\n      /* TODO: add a safe function which takes a png_ptr argument and raises\n       * a png_error if the ttime argument is invalid and the call to gmtime\n       * fails as a consequence.\n       */\n      memset(ptime, 0, sizeof(*ptime));\n      return;\n   }\n\n   png_convert_from_struct_tm(ptime, tbuf);\n}","is_error":false}]},"parent_tool_use_id":"toolu_bdrk_015Vpu62jt87qW7L9e5oxiyH","session_id":"814b2895-9042-4f5f-bd73-35bea46615cb","uuid":"bc523c11-e136-4c3d-a707-4a6515efea80","timestamp":"2026-09-08T15:21:32.437Z","subagent_type":"general-purpose","task_description":"Write t_pure.rs differential tests"}
