{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01M4gtNWBbwV5mhW2s5XQpqe","type":"tool_result","content":"1\t//! Harness smoke test: both .so files load, symbols resolve, and an\n2\t//! error-callback unwind propagates out of C and Rust frames alike.\n3\tmod common;\n4\tuse common::*;\n5\tuse libloading::Symbol;\n6\tuse std::ffi::{c_int, c_void};\n7\t\n8\ttype FnCreateRead = unsafe extern \"C-unwind\" fn(\n9\t    png_const_charp,\n10\t    png_voidp,\n11\t    Option<PngErrorFn>,\n12\t    Option<PngErrorFn>,\n13\t) -> png_structp;\n14\ttype FnDestroyRead =\n15\t    unsafe extern \"C-unwind\" fn(*mut png_structp, *mut png_infop, *mut png_infop);\n16\ttype FnVersion = unsafe extern \"C-unwind\" fn() -> png_uint_32;\n17\ttype FnSetSigBytes = unsafe extern \"C-unwind\" fn(png_structp, c_int);\n18\t\n19\t#[test]\n20\tfn version_matches() {\n21\t    let (a, b) = both(|l| unsafe { sym::<FnVersion>(l, \"png_access_version_number\")() });\n22\t    assert_eq!(a, b);\n23\t    assert_eq!(a, 10659);\n24\t}\n25\t\n26\t#[test]\n27\tfn error_unwind_works_through_both_libraries() {\n28\t    for (name, lib) in [(\"C\", &libs().c), (\"Rust\", &libs().rs)] {\n29\t        let r = capture_strict(|| unsafe {\n30\t            let create: Symbol<FnCreateRead> = sym(lib, \"png_create_read_struct\");\n31\t            let pp = create(\n32\t                PNG_LIBPNG_VER_STRING.as_ptr() as png_const_charp,\n33\t                std::ptr::null_mut::<c_void>(),\n34\t                Some(rec_error),\n35\t                Some(rec_warning),\n36\t            );\n37\t            assert!(!pp.is_null(), \"{name}: create failed\");\n38\t            // png_set_sig_bytes(pp, 9) -> png_error \"Too many bytes for PNG signature\"\n39\t            let f: Symbol<FnSetSigBytes> = sym(lib, \"png_set_sig_bytes\");\n40\t            f(pp, 9);\n41\t            let d: Symbol<FnDestroyRead> = sym(lib, \"png_destroy_read_struct\");\n42\t            let mut p = pp;\n43\t            d(&mut p, std::ptr::null_mut(), std::ptr::null_mut());\n44\t            0u32\n45\t        });\n46\t        assert!(r.out.is_none(), \"{name}: expected the error to unwind\");\n47\t        assert_eq!(\n48\t            r.log,\n49\t            vec![Msg::Err(b\"Too many bytes for PNG signature\".to_vec())],\n50\t            \"{name}: message log\"\n51\t        );\n52\t    }\n53\t}\n54\t"}]},"parent_tool_use_id":"toolu_bdrk_01Vd7RCgzqQMCnW9rPtUEPZ6","session_id":"814b2895-9042-4f5f-bd73-35bea46615cb","uuid":"cfe9f071-e1a6-4865-8dbf-30cdf68df1ac","timestamp":"2026-09-08T15:22:41.391Z","subagent_type":"general-purpose","task_description":"Write t_mem.rs differential tests"}
