{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_014ZMaCr9Nc7PrLpLN26MJki","type":"tool_result","content":"//! Phase C — write-path rejections.\n//!\n//! On the write side `png_error`, `png_app_error`, `png_app_warning` and\n//! `png_benign_error` are all FATAL in this build (`PNG_RELEASE_BUILD == 0` and\n//! `PNG_BENIGN_WRITE_ERRORS_SUPPORTED` is off), and `png_error` must not\n//! return.  Rust cannot `setjmp`, so each case runs in a SUB-PROCESS: the test\n//! binary re-executes itself once for the C library and once for the Rust\n//! library with an error handler that prints the message and `exit(70)`s.  The\n//! parent then compares the two transcripts — the ordered list of warnings, the\n//! error message and the exit code — so a divergence in the message text, in\n//! the *order* of the diagnostics, or in whether the call was fatal at all is\n//! caught.\nmod common;\n\nuse common::api::{apis, Api};\nuse common::harness::*;\nuse common::pngbuild as pb;\nuse common::*;\nuse std::ffi::{c_char, c_int, c_void};\n\n// ---------------------------------------------------------------------------\n// the child: performs one named case against one library\n// ---------------------------------------------------------------------------\n\n/// Fresh write struct with the recording callbacks installed.\nunsafe fn new_write(a: &Api) -> (png_structp, png_infop) {\n    let p = (a.png_create_write_struct)(\n        PNG_LIBPNG_VER_STRING.as_ptr() as *const c_char,\n        std::ptr::null_mut(),\n        Some(error_cb),\n        Some(warn_cb),\n    );\n    assert!(!p.is_null());\n    let info = (a.png_create_info_struct)(p);\n    assert!(!info.is_null());\n    (a.png_set_write_fn)(p, std::ptr::null_mut(), Some(write_cb), Some(flush_cb));\n    (p, info)\n}\n\n/// A minimal valid header so that row writing can be reached.\nunsafe fn hdr(a: &Api, p: png_structp, info: png_infop, w: u32, h: u32, bd: c_int, ct: c_int) {\n    (a.png_set_IHDR)(p, info, w, h, bd, ct, 0, 0, 0);\n    if ct == PNG_COLOR_TYPE_PALETTE {\n        let pal = [png_color { red: 1, green: 2, blue: 3 }; 4];\n        (a.png_set_PLTE)(p, info, pal.as_ptr(), 4);\n    }\n}\n\nfn run_case(a: &Api, case: &str) {\n    unsafe {\n        match case {\n            // ---------------- png_create_write_struct ----------------\n            \"create-version-null\" => {\n                let p = (a.png_create_write_struct)(\n                    std::ptr::null(),\n                    std::ptr::null_mut(),\n                    Some(error_cb),\n                    Some(warn_cb),\n                );\n                emit(format!(\"RET:{}\", if p.is_null() { \"NULL\" } else { \"ptr\" }));\n            }\n            \"create-version-empty\" => {\n                let p = (a.png_create_write_struct)(\n                    c\"\".as_ptr(),\n                    std::ptr::null_mut(),\n                    Some(error_cb),\n                    Some(warn_cb),\n                );\n                emit(format!(\"RET:{}\", if p.is_null() { \"NULL\" } else { \"ptr\" }));\n            }\n            \"create-version-major-mismatch\" => {\n                let p = (a.png_create_write_struct)(\n                    c\"2.6.59\".as_ptr(),\n                    std::ptr::null_mut(),\n                    Some(error_cb),\n                    Some(warn_cb),\n                );\n                emit(format!(\"RET:{}\", if p.is_null() { \"NULL\" } else { \"ptr\" }));\n            }\n            \"create-version-minor-mismatch\" => {\n....\n929:fn harness_child() {\n930-    let Some((case, which)) = child_case() else {\n931-        return;\n932-    };\n933-    set_child_mode(true);\n934-    let b = apis();\n935-    let a = if which == \"c\" { &b.c } else { &b.rs };\n936-    set_cur_is_c(which == \"c\");\n937-    reset_all();\n938-    run_case(a, &case);\n939-}\n940-\n941-// ---------------------------------------------------------------------------\n942-// the parent: one #[test] per group of ERRORS.md rows\n943-// ---------------------------------------------------------------------------\n944-\n945-fn run_all(cases: &[String]) {\n946-    for c in cases {\n947-        diff_case(c);\n948-    }\n949-}\n950-\n951-#[test]\n952-fn create_struct_version_rejections() {\n953-    run_all(&[\n954-        \"create-version-null\".into(),\n955-        \"create-version-empty\".into(),\n956-        \"create-version-major-mismatch\".into(),\n957-        \"create-version-minor-mismatch\".into(),\n958-        \"create-version-garbage\".into(),\n959-    ]);\n960-}\n961-\n962-#[test]\n963-fn ihdr_rejections() {\n964-    let mut cases = Vec::new();\n965-    // every bit depth x colour type, valid and invalid\n966-    for bd in [0i32, 1, 2, 3, 4, 5, 7, 8, 9, 15, 16, 17, 32, -1] {\n967-        for ct in [0i32, 1, 2, 3, 4, 5, 6, 7, 8, -1] {\n968-            cases.push(format!(\"ihdr:4,2,{bd},{ct},0,0,0\"));\n969-        }\n970-    }\n971-    // dimensions\n972-    for (w, h) in [\n973-        (0u32, 2u32),\n974-        (4, 0),\n975-        (0, 0),\n976-        (0x8000_0000, 2),\n977-        (2, 0x8000_0000),\n978-        (0xffff_ffff, 1),\n979-        (1_000_001, 1),\n980-        (1, 1_000_001),\n981-        (1_000_000, 1),\n982-        (1, 1),\n983-    ] {\n984-        cases.push(format!(\"ihdr:{w},{h},8,2,0,0,0\"));\n985-    }\n986-    // interlace / compression / filter methods\n987-    for il in [0i32, 1, 2, 3, 255, -1] {\n988-        cases.push(format!(\"ihdr:4,2,8,2,{il},0,0\"));\n989-    }","is_error":false}]},"parent_tool_use_id":"toolu_bdrk_01HToFN23FCmJT1ACgxSmMPa","session_id":"d61bc42a-4e8d-424f-b737-52a7165119c7","uuid":"f115de83-03ee-443c-83c4-53d8a7cc0c0c","timestamp":"2026-09-04T04:09:12.482Z","subagent_type":"general-purpose","task_description":"Write getter error-path tests"}
