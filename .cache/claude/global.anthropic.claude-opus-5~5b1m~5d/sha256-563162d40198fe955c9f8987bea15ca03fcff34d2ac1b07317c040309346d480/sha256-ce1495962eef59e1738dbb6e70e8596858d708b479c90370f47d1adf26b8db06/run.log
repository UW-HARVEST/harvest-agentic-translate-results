9\t   info_ptr->free_me |= PNG_FREE_HIST;\n430\t   info_ptr->valid |= PNG_INFO_hIST;\n431\t}\n432\t#endif\n433\t\n434\tvoid PNGAPI\n435\tpng_set_IHDR(png_const_structrp png_ptr, png_inforp info_ptr,\n436\t    png_uint_32 width, png_uint_32 height, int bit_depth,\n437\t    int color_type, int interlace_type, int compression_type,\n438\t    int filter_type)\n439\t{\n440\t   png_debug1(1, \"in %s storage function\", \"IHDR\");\n441\t\n442\t   if (png_ptr == NULL || info_ptr == NULL)\n443\t      return;\n444\t\n445\t   info_ptr->width = width;\n446\t   info_ptr->height = height;\n447\t   info_ptr->bit_depth = (png_byte)bit_depth;\n448\t   info_ptr->color_type = (png_byte)color_type;\n449\t   info_ptr->compression_type = (png_byte)compression_type;\n450\t   info_ptr->filter_type = (png_byte)filter_type;\n451\t   info_ptr->interlace_type = (png_byte)interlace_type;\n452\t\n453\t   png_check_IHDR (png_ptr, info_ptr->width, info_ptr->height,\n454\t       info_ptr->bit_depth, info_ptr->color_type, info_ptr->interlace_type,\n455\t       info_ptr->compression_type, info_ptr->filter_type);\n456\t\n457\t   if (info_ptr->color_type == PNG_COLOR_TYPE_PALETTE)\n458\t      info_ptr->channels = 1;\n459\t\n460\t   else if ((info_ptr->color_type & PNG_COLOR_MASK_COLOR) != 0)\n461\t      info_ptr->channels = 3;\n462\t\n463\t   else\n464\t      info_ptr->channels = 1;\n465\t\n466\t   if ((info_ptr->color_type & PNG_COLOR_MASK_ALPHA) != 0)\n467\t      info_ptr->channels++;\n468\t\n469\t   info_ptr->pixel_depth = (png_byte)(info_ptr->channels * info_ptr->bit_depth);\n470\t\n471\t   info_ptr->rowbytes = PNG_ROWBYTES(info_ptr->pixel_depth, width);\n472\t}\n473\t\n474\t#ifdef PNG_oFFs_SUPPORTED\n475\tvoid PNGAPI\n476\tpng_set_oFFs(png_const_structrp png_ptr, png_inforp info_ptr,\n477\t    png_int_32 offset_x, png_int_32 offset_y, int unit_type)\n478\t{\n479\t   png_debug1(1, \"in %s storage function\", \"oFFs\");\n480\t\n481\t   if (png_ptr == NULL || info_ptr == NULL)\n482\t      return;\n48