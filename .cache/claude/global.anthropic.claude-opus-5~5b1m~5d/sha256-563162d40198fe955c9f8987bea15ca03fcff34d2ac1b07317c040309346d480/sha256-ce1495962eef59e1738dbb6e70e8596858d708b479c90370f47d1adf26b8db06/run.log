ync::OnceLock;\n649\t    static B: OnceLock<Both> = OnceLock::new();\n650\t    B.get_or_init(|| {\n651\t        let l = libs();\n652\t        Both {\n653\t            c: Api::new(&l.c),\n654\t            rs: Api::new(&l.rs),\n655\t        }\n656\t    })\n657\t}\n658\t\n659\t/// Iterate over `(label, api)` for both libraries, C first.\n660\tpub fn each() -> [(&'static str, &'static Api); 2] {\n661\t    let b = apis();\n662\t    [(\"C\", &b.c), (\"RUST\", &b.rs)]\n663\t}\n664\t"}]},"parent_tool_use_id":"toolu_bdrk_01HToFN23FCmJT1ACgxSmMPa","session_id":"d61bc42a-4e8d-424f-b737-52a7165119c7","uuid":"c0e99a5e-c62a-4503-957d-21f9b9be49fc","timestamp":"2026-09-04T04:07:44.390Z","subagent_type":"general-purpose","task_description":"Write getter error-path tests"}
