{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01BJL4tggXyziQDXmSjh2zRF","type":"tool_result","content":"1920\t}\n1921\t#endif /* ?SET_USER_LIMITS */\n1922\t\n1923\t\n1924\t#ifdef PNG_BENIGN_ERRORS_SUPPORTED\n1925\tvoid PNGAPI\n1926\tpng_set_benign_errors(png_structrp png_ptr, int allowed)\n1927\t{\n1928\t   png_debug(1, \"in png_set_benign_errors\");\n1929\t\n1930\t   /* If allowed is 1, png_benign_error() is treated as a warning.\n1931\t    *\n1932\t    * If allowed is 0, png_benign_error() is treated as an error (which\n1933\t    * is the default behavior if png_set_benign_errors() is not called).\n1934\t    */\n1935\t\n1936\t   if (allowed != 0)\n1937\t      png_ptr->flags |= PNG_FLAG_BENIGN_ERRORS_WARN |\n1938\t         PNG_FLAG_APP_WARNINGS_WARN | PNG_FLAG_APP_ERRORS_WARN;\n1939\t\n1940\t   else\n1941\t      png_ptr->flags &= ~(PNG_FLAG_BENIGN_ERRORS_WARN |\n1942\t         PNG_FLAG_APP_WARNINGS_WARN | PNG_FLAG_APP_ERRORS_WARN);\n1943\t}\n1944\t#endif /* BENIGN_ERRORS */\n1945\t\n1946\t#ifdef PNG_CHECK_FOR_INVALID_INDEX_SUPPORTED\n1947\t   /* Whether to report invalid palette index; added at libpng-1.5.10.\n1948\t    * It is possible for an indexed (color-type==3) PNG file to contain\n1949\t    * pixels with invalid (out-of-range) indexes if the PLTE chunk has\n1950\t    * fewer entries than the image's bit-depth would allow. We recover\n1951\t    * from this gracefully by filling any incomplete palette with zeros\n1952\t    * (opaque black).  By default, when this occurs libpng will issue\n1953\t    * a benign error.  This API can be used to override that behavior.\n1954\t    */\n1955\tvoid PNGAPI\n1956\tpng_set_check_for_invalid_index(png_structrp png_ptr, int allowed)\n1957\t{\n1958\t   png_debug(1, \"in png_set_check_for_invalid_index\");\n1959\t\n1960\t   if (allowed > 0)\n1961\t      png_ptr->num_palette_max = 0;\n1962\t\n1963\t   else\n1964\t      png_ptr->num_palette_max = -1;\n1965\t}\n1966\t#endif\n1967\t\n1968\t#if defined(PNG_TEXT_SUPPORTED) || defined(PNG_pCAL_SUPPORTED) || \\\n1969\t    defined(PNG_iCCP_SUPPORTED) || defined(PNG_sPLT_SUPPORTED)\n1970\t/* Check that the tEXt or zTXt keyword is valid per PNG 1.0 specification,\n1971\t * and if invalid, correct the keyword rather than discarding the entire\n1972\t * chunk.  The PNG 1.0 specification requires keywords 1-79 characters in\n1973\t * length, forbids leading or trailing whitespace, multiple internal spaces,\n1974\t * and the non-break space (0x80) from ISO 8859-1.  Returns keyword length.\n1975\t *\n1976\t * The 'new_key' buffer must be 80 characters in size (for the keyword plus a\n1977\t * trailing '\\0').  If this routine returns 0 then there was no keyword, or a\n1978\t * valid one could not be generated, and the caller must png_error.\n1979\t */\n1980\tpng_uint_32 /* PRIVATE */\n1981\tpng_check_keyword(png_structrp png_ptr, png_const_charp key, png_bytep new_key)\n1982\t{\n1983\t#ifdef PNG_WARNINGS_SUPPORTED\n1984\t   png_const_charp orig_key = key;\n1985\t#endif\n1986\t   png_uint_32 key_len = 0;\n1987\t   int bad_character = 0;\n1988\t   int space = 1;\n1989\t\n1990\t   png_debug(1, \"in png_check_keyword\");\n1991\t\n1992\t   if (key == NULL)\n1993\t   {\n1994\t      *new_key = 0;\n1995\t      return 0;\n1996\t   }\n1997\t\n1998\t   while (*key && key_len < 79)\n1999\t   {\n2000\t      png_byte ch = (png_byte)*key++;\n2001\t\n2002\t      if ((ch > 32 && ch <= 126) || (ch >= 161 /*&& ch <= 255*/))\n2003\t      {\n2004\t         *new_key++ = ch; ++key_len; space = 0;\n2005\t      }\n2006\t\n2007\t      else if (space == 0)\n2008\t      {\n2009\t         /* A space or an invalid character when one wasn't seen immediately\n2010\t          * before; output just a space.\n2011\t          */\n2012\t         *new_key++ = 32; ++key_len; space = 1;\n2013\t\n2014\t         /* If the character was not a space then it is invalid. */\n2015\t         if (ch != 32)\n2016\t            bad_character = ch;\n2017\t      }\n2018\t\n2019\t      else if (bad_character == 0)\n2020\t         bad_character = ch; /* just skip it, record the first error */\n2021\t   }\n2022\t\n2023\t   if (key_len > 0 && space != 0) /* trailing space */\n2024\t   {\n2025\t      --key_len; --new_key;\n2026\t      if (bad_character == 0)\n2027\t         bad_character = 32;\n2028\t   }\n2029\t\n2030\t   /* Terminate the keyword */\n2031\t   *new_key = 0;\n2032\t\n2033\t   if (key_len == 0)\n2034\t      return 0;\n2035\t\n2036\t#ifdef PNG_WARNINGS_SUPPORTED\n2037\t   /* Try to only output one warning per keyword: */\n2038\t   if (*key != 0) /* keyword too long */\n2039\t      png_warning(png_ptr, \"keyword truncated\");\n2040\t\n2041\t   else if (bad_character != 0)\n2042\t   {\n2043\t      PNG_WARNING_PARAMETERS(p)\n2044\t\n2045\t      png_warning_parameter(p, 1, orig_key);\n2046\t      png_warning_parameter_signed(p, 2, PNG_NUMBER_FORMAT_02x, bad_character);\n2047\t\n2048\t      png_formatted_warning(png_ptr, p, \"keyword \\\"@1\\\": bad character '0x@2'\");\n2049\t   }"}]},"parent_tool_use_id":"toolu_bdrk_01YVWdKEQN8gJaNH8hEvMTG4","session_id":"d61bc42a-4e8d-424f-b737-52a7165119c7","uuid":"af2d9ad4-79cb-418e-98db-c015f6499535","timestamp":"2026-09-04T04:10:45.540Z","subagent_type":"general-purpose","task_description":"Write misc/internal error tests"}
