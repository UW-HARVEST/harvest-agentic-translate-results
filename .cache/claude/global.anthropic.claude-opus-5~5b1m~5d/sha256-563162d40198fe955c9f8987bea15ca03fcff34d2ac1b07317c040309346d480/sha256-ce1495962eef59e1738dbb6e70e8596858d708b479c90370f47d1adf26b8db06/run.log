tr += (image->height-1) * (-row_step);\n3092\t         first_row = png_voidcast(png_voidp, ptr);\n3093\t      }\n3094\t\n3095\t      display->first_row = first_row;\n3096\t      display->row_step = row_step;\n3097\t   }\n3098\t\n3099\t   if (passes == 0)\n3100\t   {\n3101\t      int result;\n3102\t      png_voidp row = png_malloc(png_ptr, png_get_rowbytes(png_ptr, info_ptr));\n3103\t\n3104\t      display->local_row = row;\n3105\t      result = png_safe_execute(image, png_image_read_and_map, display);\n3106\t      display->local_row = NULL;\n3107\t      png_free(png_ptr, row);\n3108\t\n3109\t      return result;\n3110\t   }\n3111\t\n3112\t   else\n3113\t   {\n3114\t      ptrdiff_t row_step = display->row_step;\n3115\t\n3116\t      while (--passes >= 0)\n3117\t      {\n3118\t         png_uint_32 y = image->height;\n3119\t         png_bytep row = png_voidcast(png_bytep, display->first_row);\n3120\t\n3121\t         for (; y > 0; --y)\n3122\t         {\n3123\t            png_read_row(png_ptr, row, NULL);\n3124\t            row += row_step;\n3125\t         }\n3126\t      }\n3127\t\n3128\t      return 1;\n3129\t   }\n3130\t}\n3131\t\n3132\t/* Row reading for interlaced 16-to-8 bit depth conversion with local buffer. */\n3133\tstatic int\n3134\tpng_image_read_direct_scaled(png_voidp argument)\n3135\t{\n3136\t   png_image_read_control *display = png_voidcast(png_image_read_control*,\n3137\t       argument);\n3138\t   png_imagep image = display->image;\n3139\t   png_structrp png_ptr = image->opaque->png_ptr;\n3140\t   png_inforp info_ptr = image->opaque->info_ptr;\n3141\t   png_bytep local_row = png_voidcast(png_bytep, display->local_row);\n3142\t   png_bytep first_row = png_voidcast(png_bytep, display->first_row);\n3143\t   ptrdiff_t row_step = display->row_step;\n3144\t   size_t row_bytes = png_get_rowbytes(png_ptr, info_ptr);\n3145\t   int passes;\n3146\t\n3147\t   /* Handle interlacing. */\n3148\t   switch (png_ptr->interlaced)\n3149\t   {\n3150\t      case PNG_INTERLACE_NONE:\n3151\t         passes = 1;\n3152\t         break;\n3153\t\n3154\t      case PNG_INTERLACE_ADAM7:\n3155\t         passes = PNG_INTERLACE_ADAM7_PASSES;\n3156\t         break;\n3157\t\n3158\t      default:\n3159\t         png_error(png_ptr, \"unknown interlace type\");\n3160\t   }\n3161\t\n3162\t   /* Read each pass using local_row as intermediate buffer. */\n3163\t   while (--passes >= 0)\n3164\t   {\n3165\t      png_uint_32 y = image->height;\n3166\t      png_bytep output_row = first_row;\n3167\t\n3168\t      for (; y > 0; --y)\n3169\t      {\n3170\t         /* Read into local_row (gets transformed 8-bit data). */\n3171\t         png_read_row(png_ptr, local_row, NULL);\n3172\t\n3173\t         /* Copy from local_row to user buffer.\n3174\t          * Use row_bytes (i.e. the actual size in bytes of the row data) for\n3175\t          * copying into output_row. Use row_step for advancing output_row,\n3176\t          * to respect the caller's stride for padding or negative (bottom-up)\n3177\t          * layouts.\n3178\t          */\n3179\t         memcpy(output_row, local_row, row_bytes);\n3180\t         output_row += row_step;\n3181\t      }\n3182\t   }\n3183\t\n3184\t   return 1;\n3185\t}\n3186\t\n3187\t/* Just the row reading part of png_image_read. */\n3188\tstatic int\n3189\tpng_image_read_composite(png_voidp argument)\n3190\t{\n3191\t   png_image_read_control *display = png_voidcast(png_image_read_control*,\n3192\t       argument);\n3193\t   png_imagep image = display->image;\n3194\t   png_structrp png_ptr = image->opaque->png_ptr;\n3195\t   int passes;\n3196\t\n3197\t   switch (png_ptr->interlaced)\n3198\t   {\n3199\t      case PNG_INTERLACE_NONE:\n3200\t         passes = 1;\n3201\t         break;\n3202\t\n3203\t      case PNG_INTERLACE_ADAM7:\n3204\t         passes = PNG_INTERLACE_ADAM7_PASSES;\n3205\t         break;\n3206\t\n3207\t      default:\n3208\t         png_error(png_ptr, \"unknown interlace type\");\n3209\t   }\n3210\t\n3211\t   {\n3212\t      png_uint_32 height = image->height;\n3213\t      png_uint_32 width = image->width;\n3214\t      ptrdiff_t row_step = display->row_step;\n3215\t      unsigned int channels =\n3216\t          (image->format & PNG_FORMAT_FLAG_COLOR) != 0 ? 3 : 1;\n3217\t      int optimize_alpha = (png_ptr->flags & PNG_FLAG_OPTIMIZE_ALPHA) != 0;\n3218\t      int pass;\n3219\t\n3220\t      for (pass = 0; pass < passes; ++pass)\n3221\t      {\n3222\t         unsigned int startx, stepx, stepy;\n3223\t         png_uint_32 y;\n3224\t\n3225\t         if (png_ptr->interlaced == PNG_INTERLACE_ADAM7)\n3226\t         {\n3227\t            /* The row may be empty for a short image: */\n3228\t            if (PNG_PASS_COLS(width, pass) == 0)\n3229\t               continue;\n3230\t\n3231\t            startx = PNG_PASS_START_COL(pass) * channels;\n3232\t            stepx = PNG_PASS_COL_OFFSET(pass) * channels;\n3233\t            y = PNG_PASS_START_ROW(pass);\n3234\t            stepy = PNG_PASS_ROW_OFFSET(pass);\n3235\t         }\n3236\t\n3237\t         else\n3238\t         {\n3239\t            y = 0;\n3240\t            startx = 0;\n3241\t            stepx = channels;\n3242\t            stepy = 1;\n3243\t         }\n3244\t\n3245\t         for (; y<height; y += stepy)\n3246\t         {\n3247\t            png_bytep inrow = png_voidcast(png_bytep, display->local_row);\n3248\t            png_bytep outrow;\n3249\t            png_const_bytep row_end;\n3250\t\n3251\t            /* Read the row, which is packed: */\n3252\t            png_read_row(png_ptr, inrow, NULL);\n3253\t\n3254\t            outrow = png_voidcast(png_bytep, display->first_row);\n3255\t            outrow += y * row_step;\n3256\t            row_end = outrow + width * channels;\n3257\t\n3258\t            /* Now do the composition on each pixel in this row. */\n3259\t            outrow += startx;\n3260\t            for (; outrow < row_end; outrow += stepx)\n3261\t            {\n3262\t               png_byte alpha = inrow[channels];\n3263\t\n3264\t               if (alpha > 0) /* else no change to the output */\n3265\t               {\n3266\t                  unsigned int c;\n3267\t\n3268\t                  for (c=0; c<channels; ++c)\n3269\t                  {\n3270\t                     png_uint_32 component = inrow[c];\n3271\t\n3272\t                     if (alpha < 255) /* else just use component */\n3273\t                     {\n3274\t                        if (optimize_alpha != 0)\n3275\t                        {\n3276\t                           /* This is PNG_OPTIMIZED_ALPHA, the component value\n3277\t                            * is a linear 8-bit value.  Combine this with the\n3278\t                            * current outrow[c] value which is sRGB encoded.\n3279\t                            * Arithmetic here is 16-bits to preserve the output\n3280\t                            * values correctly.\n3281\t                            */\n3282\t                           component *= 257*255; /* =65535 */\n3283\t                           component += (255-alpha)*png_sRGB_table[outrow[c]];\n3284\t\n3285\t                           /* Clamp to the valid range to defend against\n3286\t                            * unforeseen cases where the data might be sRGB\n3287\t                            * instead of linear premultiplied.\n3288\t                            * (Belt-and-suspenders for CVE-2025-66293.)\n3289\t                            */\n3290\t                           if (component > 255*65535)\n3291\t                              component = 255*65535;\n3292\t\n3293\t                           /* So 'component' is scaled by 255*65535 and is\n3294\t                            * therefore appropriate for the sRGB-to-linear\n3295\t                            * conversion table.\n3296\t                            */\n3297\t                           component = PNG_sRGB_FROM_LINEAR(component);\n3298\t                        }\n3299\t                        else\n3300\t                        {\n3301\t                           /* Compositing was already done on the palette\n3302\t                            * entries.  The data is sRGB premultiplied on black.\n3303\t                            * Composite with the background in sRGB space.\n3304\t                            * This is not gamma-correct, but matches what was\n3305\t                            * done to the palette.\n3306\t                            */\n3307\t                           png_uint_32 background = outrow[c];\n3308\t                           component += ((255-alpha) * background + 127) / 255;\n3309\t                           if (component > 255)\n3310\t                              component = 255;\n3311\t                        }\n3312\t                     }\n3313\t\n3314\t                     outrow[c] = (png_byte)component;\n3315\t                  }\n3316\t               }\n3317\t\n3318\t               inrow += channels+1; /* components and alpha channel */\n3319\t            }\n3320\t         }\n3321\t      }\n3322\t   }\n3323\t\n3324\t   return 1;\n3325\t}\n3326\t\n3327\t/* The do_local_background case; called when all the following transforms are to\n3328\t * be done:\n3329\t *\n3330\t * PNG_RGB_TO_GRAY\n3331\t * PNG_COMPOSITE\n3332\t * PNG_GAMMA\n3333\t *\n3334\t * This is a work-around for the fact that both the PNG_RGB_TO_GRAY and\n3335\t * PNG_COMPOSITE code performs gamma correction, so we get double gamma\n3336\t * correction.  The fix-up is to prevent the PNG_COMPOSITE operation from\n3337\t * happening inside libpng, so this routine sees an 8 or 16-bit gray+alpha\n3338\t * row and handles the removal or pre-multiplication of the alpha channel.\n3339\t */\n3340\tstatic int\n3341\tpng_image_read_background(png_voidp argument)\n3342\t{\n3343\t   png_image_read_control *display = png_voidcast(png_image_read_control*,\n3344\t       argument);\n3345\t   png_imagep image = display->image;\n3346\t   png_structrp png_ptr = image->opaque->png_ptr;\n3347\t   png_inforp info_ptr = image->opaque->info_ptr;\n3348\t   png_uint_32 height = image->height;\n3349\t   png_uint_32 width = image->width;\n3350\t   int pass, passes;\n3351\t\n3352\t   /* Double check the convoluted logic below.  We expect to get here with\n3353\t    * libpng doing rgb to gray and gamma correction but background processing\n3354\t    * left to the png_image_read_background function.  The rows libpng produce\n3355\t    * might be 8 or 16-bit but should always have two channels; gray plus alpha.\n3356\t    */\n3357\t   if ((png_ptr->transformations & PNG_RGB_TO_GRAY) == 0)\n3358\t      png_error(png_ptr, \"lost rgb to gray\");\n3359\t\n3360\t   if ((png_ptr->transformations & PNG_COMPOSE) != 0)\n3361\t      png_error(png_ptr, \"unexpected compose\");\n3362\t\n3363\t   if (png_get_channels(png_ptr, info_ptr) != 2)\n3364\t      png_error(png_ptr, \"lost/gained channels\");\n3365\t\n3366\t   /* Expect the 8-bit case to always remove the alpha channel */\n3367\t   if ((image->format & PNG_FORMAT_FLAG_LINEAR) == 0 &&\n3368\t      (image->format & PNG_FORMAT_FLAG_ALPHA) != 0)\n3369\t      png_error(png_ptr, \"unexpected 8-bit transformation\");\n3370\t\n3371\t   switch (png_ptr->interlaced)\n3372\t   {\n3373\t      case PNG_INTERLACE_NONE:\n3374\t         passes = 1;\n3375\t         break;\n3376\t\n3377\t      case PNG_INTERLACE_ADAM7:\n3378\t         passes = PNG_INTERLACE_ADAM7_PASSES;\n3379\t         break;\n3380\t\n3381\t      default:\n3382\t         png_error(png_ptr, \"unknown interlace type\");\n3383\t   }\n3384\t\n3385\t   /* Use direct access to info_ptr here because otherwise the simplified API\n3386\t    * would require PNG_EASY_ACCESS_SUPPORTED (just for this.)  Note this is\n3387\t    * checking the value after libpng expansions, not the original value in the\n3388\t    * PNG.\n3389\t    */\n3390\t   switch (info_ptr->bit_depth)\n3391\t   {\n3392\t      case 8:\n3393\t         /* 8-bit sRGB gray values with an alpha channel; the alpha channel is\n3394\t          * to be removed by composing on a background: either the row if\n3395\t          * display->background is NULL or display->background->green if not.\n3396\t          * Unlike the code above ALPHA_OPTIMIZED has *not* been done.\n3397\t          */\n3398\t         {\n3399\t            png_bytep first_row = png_voidcast(png_bytep, display->first_row);\n3400\t            ptrdiff_t row_step = display->row_step;\n3401\t\n3402\t            for (pass = 0; pass < passes; ++pass)\n3403\t            {\n3404\t               unsigned int startx, stepx, stepy;\n3405\t               png_uint_32 y;\n3406\t\n3407\t               if (png_ptr->interlaced == PNG_INTERLACE_ADAM7)\n3408\t               {\n3409\t                  /* The row may be empty for a short image: */\n3410\t                  if (PNG_PASS_COLS(width, pass) == 0)\n3411\t                     continue;\n3412\t\n3413\t                  startx = PNG_PASS_START_COL(pass);\n3414\t                  stepx = PNG_PASS_COL_OFFSET(pass);\n3415\t                  y = PNG_PASS_START_ROW(pass);\n3416\t                  stepy = PNG_PASS_ROW_OFFSET(pass);\n3417\t               }\n3418\t\n3419\t               else\n3420\t               {\n3421\t                  y = 0;\n3422\t                  startx = 0;\n3423\t                  stepx = stepy = 1;\n3424\t               }\n3425\t\n3426\t               if (display->background == NULL)\n3427\t               {\n3428\t                  for (; y<height; y += stepy)\n3429\t                  {\n3430\t                     png_bytep inrow = png_voidcast(png_bytep,\n3431\t                         display->local_row);\n3432\t                     png_bytep outrow = first_row + y * row_step;\n3433\t                     png_const_bytep row_end = outrow + width;\n3434\t\n3435\t                     /* Read the row, which is packed: */\n3436\t                     png_read_row(png_ptr, inrow, NULL);\n3437\t\n3438\t                     /* Now do the composition on each pixel in this row. */\n3439\t                     outrow += startx;\n3440\t                     for (; outrow < row_end; outrow += stepx)\n3441\t                     {\n3442\t                        png_byte alpha = inrow[1];\n3443\t\n3444\t                        if (alpha > 0) /* else no change to the output */\n3445\t                        {\n3446\t                           png_uint_32 component = inrow[0];\n3447\t\n3448\t                           if (alpha < 255) /* else just use component */\n3449\t                           {\n3450\t                              /* Since PNG_OPTIMIZED_ALPHA was not set it is\n3451\t                               * necessary to invert the sRGB transfer\n3452\t                               * function and multiply the alpha out.\n3453\t                               */\n3454\t                              component = png_sRGB_table[component] * alpha;\n3455\t                              component += png_sRGB_table[outrow[0]] *\n3456\t                                 (255-alpha);\n3457\t                              component = PNG_sRGB_FROM_LINEAR(component);\n3458\t                           }\n3459\t\n3460\t                           outrow[0] = (png_byte)component;\n3461\t                        }\n3462\t\n3463\t                        inrow += 2; /* gray and alpha channel */\n3464\t                     }\n3465\t                  }\n3466\t               }\n3467\t\n3468\t               else /* constant background value */\n3469\t               {\n3470\t                  png_byte background8 = display->background->green;\n3471\t                  png_uint_16 background = png_sRGB_table[background8];\n3472\t\n3473\t                  for (; y<height; y += stepy)\n3474\t                  {\n3475\t                     png_bytep inrow = png_voidcast(png_bytep,\n3476\t                         display->local_row);\n3477\t                     png_bytep outrow = first_row + y * row_step;\n3478\t                     png_const_bytep row_end = outrow + width;\n3479\t\n3480\t                     /* Read the row, which is packed: */\n3481\t                     png_read_row(png_ptr, inrow, NULL);\n3482\t\n3483\t                     /* Now do the composition on each pixel in this row. */\n3484\t                     outrow += startx;\n3485\t                     for (; outrow < row_end; outrow += stepx)\n3486\t                     {\n3487\t                        png_byte alpha = inrow[1];\n3488\t\n3489\t                        if (alpha > 0) /* else use background */\n3490\t                        {\n3491\t                           png_uint_32 component = inrow[0];\n3492\t\n3493\t                           if (alpha < 255) /* else just use component */\n3494\t                           {\n3495\t                              component = png_sRGB_table[component] * alpha;\n3496\t                              component += background * (255-alpha);\n3497\t                              component = PNG_sRGB_FROM_LINEAR(component);\n3498\t                           }\n3499\t\n3500\t                           outrow[0] = (png_byte)component;\n3501\t                        }\n3502\t\n3503\t                        else\n3504\t                           outrow[0] = background8;\n3505\t\n3506\t                        inrow += 2; /* gray and alpha channel */\n3507\t                     }\n3508\t                  }\n3509\t               }\n3510\t            }\n3511\t         }\n3512\t         break;\n3513\t\n3514\t      case 16:\n3515\t         /* 16-bit linear with pre-multiplied alpha; the pre-multiplication must\n3516\t          * still be done and, maybe, the alpha channel removed.  This code also\n3517\t          * handles the alpha-first option.\n3518\t          */\n3519\t         {\n3520\t            png_uint_16p first_row = png_voidcast(png_uint_16p,\n3521\t                display->first_row);\n3522\t            /* The division by two is safe because the caller passed in a\n3523\t             * stride which was multiplied by 2 (below) to get row_step.\n3524\t             */\n3525\t            ptrdiff_t row_step = display->row_step / 2;\n3526\t            unsigned int preserve_alpha = (image->format &\n3527\t                PNG_FORMAT_FLAG_ALPHA) != 0;\n3528\t            unsigned int outchannels = 1U+preserve_alpha;\n3529\t            int swap_alpha = 0;\n3530\t\n3531\t#           ifdef PNG_SIMPLIFIED_READ_AFIRST_SUPPORTED\n3532\t               if (preserve_alpha != 0 &&\n3533\t                   (image->format & PNG_FORMAT_FLAG_AFIRST) != 0)\n3534\t                  swap_alpha = 1;\n3535\t#           endif\n3536\t\n3537\t            for (pass = 0; pass < passes; ++pass)\n3538\t            {\n3539\t               unsigned int startx, stepx, stepy;\n3540\t               png_uint_32 y;\n3541\t\n3542\t               /* The 'x' start and step are adjusted to output components here.\n3543\t                */\n3544\t               if (png_ptr->interlaced == PNG_INTERLACE_ADAM7)\n3545\t               {\n3546\t                  /* The row may be empty for a short image: */\n3547\t                  if (PNG_PASS_COLS(width, pass) == 0)\n3548\t                     continue;\n3549\t\n3550\t                  startx = PNG_PASS_START_COL(pass) * outchannels;\n3551\t                  stepx = PNG_PASS_COL_OFFSET(pass) * outchannels;\n3552\t                  y = PNG_PASS_START_ROW(pass);\n3553\t                  stepy = PNG_PASS_ROW_OFFSET(pass);\n3554\t               }\n3555\t\n3556\t               else\n3557\t               {\n3558\t                  y = 0;\n3559\t                  startx = 0;\n3560\t                  stepx = outchannels;\n3561\t                  stepy = 1;\n3562\t               }\n3563\t\n3564\t               for (; y<height; y += stepy)\n3565\t               {\n3566\t                  png_const_uint_16p inrow;\n3567\t                  png_uint_16p outrow = first_row + y * row_step;\n3568\t                  png_uint_16p row_end = outrow + width * outchannels;\n3569\t\n3570\t                  /* Read the row, which is packed: */\n3571\t                  png_read_row(png_ptr, png_voidcast(png_bytep,\n3572\t                      display->local_row), NULL);\n3573\t                  inrow = png_voidcast(png_const_uint_16p, display->local_row);\n3574\t\n3575\t                  /* Now do the pre-multiplication on each pixel in this row.\n3576\t                   */\n3577\t                  outrow += startx;\n3578\t                  for (; outrow < row_end; outrow += stepx)\n3579\t                  {\n3580\t                     png_uint_32 component = inrow[0];\n3581\t                     png_uint_16 alpha = inrow[1];\n3582\t\n3583\t                     if (alpha > 0) /* else 0 */\n3584\t                     {\n3585\t                        if (alpha < 65535) /* else just use component */\n3586\t                        {\n3587\t                           component *= alpha;\n3588\t                           component += 32767;\n3589\t                           component /= 65535;\n3590\t                        }\n3591\t                     }\n3592\t\n3593\t                     else\n3594\t                        component = 0;\n3595\t\n3596\t                     outrow[swap_alpha] = (png_uint_16)component;\n3597\t                     if (preserve_alpha != 0)\n3598\t                        outrow[1 ^ swap_alpha] = alpha;\n3599\t\n3600\t                     inrow += 2; /* components and alpha channel */\n3601\t                  }\n3602\t               }\n3603\t            }\n3604\t         }\n3605\t         break;\n3606\t\n3607\t#ifdef __GNUC__\n3608\t      default:\n3609\t         png_error(png_ptr, \"unexpected bit depth\");\n3610\t#endif\n3611\t   }\n3612\t\n3613\t   return 1;\n3614\t}\n3615\t\n3616\t/* The guts of png_image_finish_read as a png_safe_execute callback. */\n3617\tstatic int\n3618\tpng_image_read_direct(png_voidp argument)\n3619\t{\n3620\t   png_image_read_control *display = png_voidcast(png_image_read_control*,\n3621\t       argument);\n3622\t   png_imagep image = display->image;\n3623\t   png_structrp png_ptr = image->opaque->png_ptr;\n3624\t   png_inforp info_ptr = image->opaque->info_ptr;\n3625\t\n3626\t   png_uint_32 format = image->format;\n3627\t   int linear = (format & PNG_FORMAT_FLAG_LINEAR) != 0;\n3628\t   int do_local_compose = 0;\n3629\t   int do_local_background = 0; /* to avoid double gamma correction bug */\n3630\t   int do_local_scale = 0; /* for interlaced 16-to-8 bit conversion */\n3631\t   int passes = 0;\n3632\t\n3633\t   /* Add transforms to ensure the correct output format is produced then check\n3634\t    * that the required implementation support is there.  Always expand; always\n3635\t    * need 8 bits minimum, no palette and expanded tRNS.\n3636\t    */\n3637\t   png_set_expand(png_ptr);\n3638\t\n3639\t   /* Now check the format to see if it was modified. */\n3640\t   {\n3641\t      png_uint_32 base_format = png_image_format(png_ptr) &\n3642\t         ~PNG_FORMAT_FLAG_COLORMAP /* removed by png_set_expand */;\n3643\t      png_uint_32 change = format ^ base_format;\n3644\t      png_fixed_point output_gamma;\n3645\t      int mode; /* alpha mode */\n3646\t\n3647\t      /* Do this first so that we have a record if rgb to gray is happening. */\n3648\t      if ((change & PNG_FORMAT_FLAG_COLOR) != 0)\n3649\t      {\n3650\t         /* gray<->color transformation required. */\n3651\t         if ((format & PNG_FORMAT_FLAG_COLOR) != 0)\n3652\t            png_set_gray_to_rgb(png_ptr);\n3653\t\n3654\t         else\n3655\t         {\n3656\t            /* libpng can't do both rgb to gray and\n3657\t             * background/pre-multiplication if there is also significant gamma\n3658\t             * correction, because both operations require linear colors and\n3659\t             * the code only supports one transform doing the gamma correction.\n3660\t             * Handle this by doing the pre-multiplication or background\n3661\t             * operation in this code, if necessary.\n3662\t             *\n3663\t             * TODO: fix this by rewriting pngrtran.c (!)\n3664\t             *\n3665\t             * For the moment (given that fixing this in pngrtran.c is an\n3666\t             * enormous change) 'do_local_background' is used to indicate that\n3667\t             * the problem exists.\n3668\t             */\n3669\t            if ((base_format & PNG_FORMAT_FLAG_ALPHA) != 0)\n3670\t               do_local_background = 1/*maybe*/;\n3671\t\n3672\t            png_set_rgb_to_gray_fixed(png_ptr, PNG_ERROR_ACTION_NONE,\n3673\t                PNG_RGB_TO_GRAY_DEFAULT, PNG_RGB_TO_GRAY_DEFAULT);\n3674\t         }\n3675\t\n3676\t         change &= ~PNG_FORMAT_FLAG_COLOR;\n3677\t      }\n3678\t\n3679\t      /* Set the gamma appropriately, linear for 16-bit input, sRGB otherwise.\n3680\t       */\n3681\t      {\n3682\t         /* This is safe but should no longer be necessary as\n3683\t          * png_ptr->default_gamma should have been set after the\n3684\t          * info-before-IDAT was read in png_image_read_header.\n3685\t          *\n3686\t          * TODO: 1.8: remove this and see what happens.\n3687\t          */\n3688\t         png_fixed_point input_gamma_default;\n3689\t\n3690\t         if ((base_format & PNG_FORMAT_FLAG_LINEAR) != 0 &&\n3691\t             (image->flags & PNG_IMAGE_FLAG_16BIT_sRGB) == 0)\n3692\t            input_gamma_default = PNG_GAMMA_LINEAR;\n3693\t         else\n3694\t            input_gamma_default = PNG_DEFAULT_sRGB;\n3695\t\n3696\t         /* Call png_set_alpha_mode to set the default for the input gamma; the\n3697\t          * output gamma is set by a second call below.\n3698\t          */\n3699\t         png_set_alpha_mode_fixed(png_ptr, PNG_ALPHA_PNG, input_gamma_default);\n3700\t      }\n3701\t\n3702\t      if (linear != 0)\n3703\t      {\n3704\t         /* If there *is* an alpha channel in the input it must be multiplied\n3705\t          * out; use PNG_ALPHA_STANDARD, otherwise just use PNG_ALPHA_PNG.\n3706\t          */\n3707\t         if ((base_format & PNG_FORMAT_FLAG_ALPHA) != 0)\n3708\t            mode = PNG_ALPHA_STANDARD; /* associated alpha */\n3709\t\n3710\t         else\n3711\t            mode = PNG_ALPHA_PNG;\n3712\t\n3713\t         output_gamma = PNG_GAMMA_LINEAR;\n3714\t      }\n3715\t\n3716\t      else\n3717\t      {\n3718\t         mode = PNG_ALPHA_PNG;\n3719\t         output_gamma = PNG_DEFAULT_sRGB;\n3720\t      }\n3721\t\n3722\t      if ((change & PNG_FORMAT_FLAG_ASSOCIATED_ALPHA) != 0)\n3723\t      {\n3724\t         mode = PNG_ALPHA_OPTIMIZED;\n3725\t         change &= ~PNG_FORMAT_FLAG_ASSOCIATED_ALPHA;\n3726\t      }\n3727\t\n3728\t      /* If 'do_local_background' is set check for the presence of gamma\n3729\t       * correction; this is part of the work-round for the libpng bug\n3730\t       * described above.\n3731\t       *\n3732\t       * TODO: fix libpng and remove this.\n3733\t       */\n3734\t      if (do_local_background != 0)\n3735\t      {\n3736\t         png_fixed_point gtest;\n3737\t\n3738\t         /* This is 'png_gamma_threshold' from pngrtran.c; the test used for\n3739\t          * gamma correction, the screen gamma hasn't been set on png_struct\n3740\t          * yet; it's set below.  png_struct::gamma, however, is set to the\n3741\t          * final value.\n3742\t          */\n3743\t         if (png_muldiv(&gtest, output_gamma,\n3744\t                  png_resolve_file_gamma(png_ptr), PNG_FP_1) != 0 &&\n3745\t             png_gamma_significant(gtest) == 0)\n3746\t            do_local_background = 0;\n3747\t\n3748\t         else if (mode == PNG_ALPHA_STANDARD)\n3749\t         {\n3750\t            do_local_background = 2/*required*/;\n3751\t            mode = PNG_ALPHA_PNG; /* prevent libpng doing it */\n3752\t         }\n3753\t\n3754\t         /* else leave as 1 for the checks below */\n3755\t      }\n3756\t\n3757\t      /* If the bit-depth changes then handle that here. */\n3758\t      if ((change & PNG_FORMAT_FLAG_LINEAR) != 0)\n3759\t      {\n3760\t         if (linear != 0 /*16-bit output*/)\n3761\t            png_set_expand_16(png_ptr);\n3762\t\n3763\t         else /* 8-bit output */\n3764\t         {\n3765\t            png_set_scale_16(png_ptr);\n3766\t\n3767\t            /* For interlaced images, use local_row buffer to avoid overflow\n3768\t             * in png_combine_row() which writes using IHDR bit-depth.\n3769\t             */\n3770\t            if (png_ptr->interlaced != 0)\n3771\t               do_local_scale = 1;\n3772\t         }\n3773\t\n3774\t         change &= ~PNG_FORMAT_FLAG_LINEAR;\n3775\t      }\n3776\t\n3777\t      /* Now the background/alpha channel changes. */\n3778\t      if ((change & PNG_FORMAT_FLAG_ALPHA) != 0)\n3779\t      {\n3780\t         /* Removing an alpha channel requires composition for the 8-bit\n3781\t          * formats; for the 16-bit it is already done, above, by the\n3782\t          * pre-multiplication and the channel just needs to be stripped.\n3783\t          */\n3784\t         if ((base_format & PNG_FORMAT_FLAG_ALPHA) != 0)\n3785\t         {\n3786\t            /* If RGB->gray is happening the alpha channel must be left and the\n3787\t             * operation completed locally.\n3788\t             *\n3789\t             * TODO: fix libpng and remove this.\n3790\t             */\n3791\t            if (do_local_background != 0)\n3792\t               do_local_background = 2/*required*/;\n3793\t\n3794\t            /* 16-bit output: just remove the channel */\n3795\t            else if (linear != 0) /* compose on black (well, pre-multiply) */\n3796\t               png_set_strip_alpha(png_ptr);\n3797\t\n3798\t            /* 8-bit output: do an appropriate compose */\n3799\t            else if (display->background != NULL)\n3800\t            {\n3801\t               png_color_16 c;\n3802\t\n3803\t               c.index = 0; /*unused*/\n3804\t               c.red = display->background->red;\n3805\t               c.green = display->background->green;\n3806\t               c.blue = display->background->blue;\n3807\t               c.gray = display->background->green;\n3808\t\n3809\t               /* This is always an 8-bit sRGB value, using the 'green' channel\n3810\t                * for gray is much better than calculating the luminance here;\n3811\t                * we can get off-by-one errors in that calculation relative to\n3812\t                * the app expectations and that will show up in transparent\n3813\t                * pixels.\n3814\t                */\n3815\t               png_set_background_fixed(png_ptr, &c,\n3816\t                   PNG_BACKGROUND_GAMMA_SCREEN, 0/*need_expand*/,\n3817\t                   0/*gamma: not used*/);\n3818\t            }\n3819\t\n3820\t            else /* compose on row: implemented below. */\n3821\t            {\n3822\t               do_local_compose = 1;\n3823\t               /* This leaves the alpha channel in the output, so it has to be\n3824\t                * removed by the code below.  Set the encoding to the 'OPTIMIZE'\n3825\t                * one so the code only has to hack on the pixels that require\n3826\t                * composition.\n3827\t                */\n3828\t               mode = PNG_ALPHA_OPTIMIZED;\n3829\t            }\n3830\t         }\n3831\t\n3832\t         else /* output needs an alpha channel */\n3833\t         {\n3834\t            /* This is tricky because it happens before the swap operation has\n3835\t             * been accomplished; however, the swap does *not* swap the added\n3836\t             * alpha channel (weird API), so it must be added in the correct\n3837\t             * place.\n3838\t             */\n3839\t            png_uint_32 filler; /* opaque filler */\n3840\t            int where;\n3841\t\n3842\t            if (linear != 0)\n3843\t               filler = 65535;\n3844\t\n3845\t            else\n3846\t               filler = 255;\n3847\t\n3848\t#ifdef PNG_FORMAT_AFIRST_SUPPORTED\n3849\t            if ((format & PNG_FORMAT_FLAG_AFIRST) != 0)\n3850\t            {\n3851\t               where = PNG_FILLER_BEFORE;\n3852\t               change &= ~PNG_FORMAT_FLAG_AFIRST;\n3853\t            }\n3854\t\n3855\t            else\n3856\t#endif\n3857\t            where = PNG_FILLER_AFTER;\n3858\t\n3859\t            png_set_add_alpha(png_ptr, filler, where);\n3860\t         }\n3861\t\n3862\t         /* This stops the (irrelevant) call to swap_alpha below. */\n3863\t         change &= ~PNG_FORMAT_FLAG_ALPHA;\n3864\t      }\n3865\t\n3866\t      /* Now set the alpha mode correctly; this is always done, even if there is\n3867\t       * no alpha channel in either the input or the output because it correctly\n3868\t       * sets the output gamma.\n3869\t       */\n3870\t      png_set_alpha_mode_fixed(png_ptr, mode, output_gamma);\n3871\t\n3872\t#     ifdef PNG_FORMAT_BGR_SUPPORTED\n3873\t         if ((change & PNG_FORMAT_FLAG_BGR) != 0)\n3874\t         {\n3875\t            /* Check only the output format; PNG is never BGR; don't do this if\n3876\t             * the output is gray, but fix up the 'format' value in that case.\n3877\t             */\n3878\t            if ((format & PNG_FORMAT_FLAG_COLOR) != 0)\n3879\t               png_set_bgr(png_ptr);\n3880\t\n3881\t            else\n3882\t               format &= ~PNG_FORMAT_FLAG_BGR;\n3883\t\n3884\t            change &= ~PNG_FORMAT_FLAG_BGR;\n3885\t         }\n3886\t#     endif\n3887\t\n3888\t#     ifdef PNG_FORMAT_AFIRST_SUPPORTED\n3889\t         if ((change & PNG_FORMAT_FLAG_AFIRST) != 0)\n3890\t         {\n3891\t            /* Only relevant if there is an alpha channel - it's particularly\n3892\t             * important to handle this correctly because do_local_compose may\n3893\t             * be set above and then libpng will keep the alpha channel for this\n3894\t             * code to remove.\n3895\t             */\n3896\t            if ((format & PNG_FORMAT_FLAG_ALPHA) != 0)\n3897\t            {\n3898\t               /* Disable this if doing a local background,\n3899\t                * TODO: remove this when local background is no longer required.\n3900\t                */\n3901\t               if (do_local_background != 2)\n3902\t                  png_set_swap_alpha(png_ptr);\n3903\t            }\n3904\t\n3905\t            else\n3906\t               format &= ~PNG_FORMAT_FLAG_AFIRST;\n3907\t\n3908\t            change &= ~PNG_FORMAT_FLAG_AFIRST;\n3909\t         }\n3910\t#     endif\n3911\t\n3912\t      /* If the *output* is 16-bit then we need to check for a byte-swap on this\n3913\t       * architecture.\n3914\t       */\n3915\t      if (linear != 0)\n3916\t      {\n3917\t         png_uint_16 le = 0x0001;\n3918\t\n3919\t         if ((*(png_const_bytep) & le) != 0)\n3920\t            png_set_swap(png_ptr);\n3921\t      }\n3922\t\n3923\t      /* If change is not now 0 some transformation is missing - error out. */\n3924\t      if (change != 0)\n3925\t         png_error(png_ptr, \"png_read_image: unsupported transformation\");\n3926\t   }\n3927\t\n3928\t   PNG_SKIP_CHUNKS(png_ptr);\n3929\t\n3930\t   /* Update the 'info' structure and make sure the result is as required; first\n3931\t    * make sure to turn on the interlace handling if it will be required\n3932\t    * (because it can't be turned on *after* the call to png_read_update_info!)\n3933\t    *\n3934\t    * TODO: remove the do_local_background fixup below.\n3935\t    */\n3936\t   if (do_local_compose == 0 && do_local_background != 2)\n3937\t      passes = png_set_interlace_handling(png_ptr);\n3938\t\n3939\t   png_read_update_info(png_ptr, info_ptr);\n3940\t\n3941\t   {\n3942\t      png_uint_32 info_format = 0;\n3943\t\n3944\t      if ((info_ptr->color_type & PNG_COLOR_MASK_COLOR) != 0)\n3945\t         info_format |= PNG_FORMAT_FLAG_COLOR;\n3946\t\n3947\t      if ((info_ptr->color_type & PNG_COLOR_MASK_ALPHA) != 0)\n3948\t      {\n3949\t         /* do_local_compose removes this channel below. */\n3950\t         if (do_local_compose == 0)\n3951\t         {\n3952\t            /* do_local_background does the same if required. */\n3953\t            if (do_local_background != 2 ||\n3954\t               (format & PNG_FORMAT_FLAG_ALPHA) != 0)\n3955\t               info_format |= PNG_FORMAT_FLAG_ALPHA;\n3956\t         }\n3957\t      }\n3958\t\n3959\t      else if (do_local_compose != 0) /* internal error */\n3960\t         png_error(png_ptr, \"png_image_read: alpha channel lost\");\n3961\t\n3962\t      if ((format & PNG_FORMAT_FLAG_ASSOCIATED_ALPHA) != 0) {\n3963\t         info_format |= PNG_FORMAT_FLAG_ASSOCIATED_ALPHA;\n3964\t      }\n3965\t\n3966\t      if (info_ptr->bit_depth == 16)\n3967\t         info_format |= PNG_FORMAT_FLAG_LINEAR;\n3968\t\n3969\t#ifdef PNG_FORMAT_BGR_SUPPORTED\n3970\t      if ((png_ptr->transformations & PNG_BGR) != 0)\n3971\t         info_format |= PNG_FORMAT_FLAG_BGR;\n3972\t#endif\n3973\t\n3974\t#ifdef PNG_FORMAT_AFIRST_SUPPORTED\n3975\t         if (do_local_background == 2)\n3976\t         {\n3977\t            if ((format & PNG_FORMAT_FLAG_AFIRST) != 0)\n3978\t               info_format |= PNG_FORMAT_FLAG_AFIRST;\n3979\t         }\n3980\t\n3981\t         if ((png_ptr->transformations & PNG_SWAP_ALPHA) != 0 ||\n3982\t            ((png_ptr->transformations & PNG_ADD_ALPHA) != 0 &&\n3983\t            (png_ptr->flags & PNG_FLAG_FILLER_AFTER) == 0))\n3984\t         {\n3985\t            if (do_local_background == 2)\n3986\t               png_error(png_ptr, \"unexpected alpha swap transformation\");\n3987\t\n3988\t            info_format |= PNG_FORMAT_FLAG_AFIRST;\n3989\t         }\n3990\t#     endif\n3991\t\n3992\t      /* This is actually an internal error. */\n3993\t      if (info_format != format)\n3994\t         png_error(png_ptr, \"png_read_image: invalid transformations\");\n3995\t   }\n3996\t\n3997\t   /* Now read the rows.  If do_local_compose is set then it is necessary to use\n3998\t    * a local row buffer.  The output will be GA, RGBA or BGRA and must be\n3999\t    * converted to G, RGB or BGR as appropriate.  The 'local_row' member of the\n4000\t    * display acts as a flag.\n4001\t    */\n4002\t   {\n4003\t      png_voidp first_row = display->buffer;\n4004\t      ptrdiff_t row_step = display->row_stride;\n4005\t\n4006\t      if (linear != 0)\n4007\t         row_step *= 2;\n4008\t\n4009\t      /* The following adjustment is to ensure that calculations are correct,\n4010\t       * regardless whether row_step is positive or negative.\n4011\t       */\n4012\t      if (row_step < 0)\n4013\t      {\n4014\t         char *ptr = png_voidcast(char*, first_row);\n4015\t         ptr += (image->height - 1) * (-row_step);\n4016\t         first_row = png_voidcast(png_voidp, ptr);\n4017\t      }\n4018\t\n4019\t      display->first_row = first_row;\n4020\t      display->row_step = row_step;\n4021\t   }\n4022\t\n4023\t   if (do_local_compose != 0)\n4024\t   {\n4025\t      int result;\n4026\t      png_voidp row = png_malloc(png_ptr, png_get_rowbytes(png_ptr, info_ptr));\n4027\t\n4028\t      display->local_row = row;\n4029\t      result = png_safe_execute(image, png_image_read_composite, display);\n4030\t      display->local_row = NULL;\n4031\t      png_free(png_ptr, row);\n4032\t\n4033\t      return result;\n4034\t   }\n4035\t\n4036\t   else if (do_local_background == 2)\n4037\t   {\n4038\t      int result;\n4039\t      png_voidp row = png_malloc(png_ptr, png_get_rowbytes(png_ptr, info_ptr));\n4040\t\n4041\t      display->local_row = row;\n4042\t      result = png_safe_execute(image, png_image_read_background, display);\n4043\t      display->local_row = NULL;\n4044\t      png_free(png_ptr, row);\n4045\t\n4046\t      return result;\n4047\t   }\n4048\t\n4049\t   else if (do_local_scale != 0)\n4050\t   {\n4051\t      /* For interlaced 16-to-8 conversion, use an intermediate row buffer\n4052\t       * to avoid buffer overflows in png_combine_row. The local_row is sized\n4053\t       * for the transformed (8-bit) output, preventing the overflow that would\n4054\t       * occur if png_combine_row wrote 16-bit data directly to the user buffer.\n4055\t       */\n4056\t      int result;\n4057\t      png_voidp row = png_malloc(png_ptr, png_get_rowbytes(png_ptr, info_ptr));\n4058\t\n4059\t      display->local_row = row;\n4060\t      result = png_safe_execute(image, png_image_read_direct_scaled, display);\n4061\t      display->local_row = NULL;\n4062\t      png_free(png_ptr, row);\n4063\t\n4064\t      return result;\n4065\t   }\n4066\t\n4067\t   else\n4068\t   {\n4069\t      ptrdiff_t row_step = display->row_step;\n4070\t\n4071\t      while (--passes >= 0)\n4072\t      {\n4073\t         png_uint_32 y = image->height;\n4074\t         png_bytep row = png_voidcast(png_bytep, display->first_row);\n4075\t\n4076\t         for (; y > 0; --y)\n4077\t         {\n4078\t            png_read_row(png_ptr, row, NULL);\n4079\t            row += row_step;\n4080\t         }\n4081\t      }\n4082\t\n4083\t      return 1;\n4084\t   }\n4085\t}\n4086\t\n4087\tint PNGAPI\n4088\tpng_image_finish_read(png_imagep image, png_const_colorp background,\n4089\t    void *buffer, png_int_32 row_stride, void *colormap)\n4090\t{\n4091\t   if (image != NULL && image->version == PNG_IMAGE_VERSION)\n4092\t   {\n4093\t      /* Check for row_stride overflow.  This check is not performed on the\n4094\t       * original PNG format because it may not occur in the output PNG format\n4095\t       * and libpng deals with the issues of reading the original.\n4096\t       */\n4097\t      unsigned int channels = PNG_IMAGE_PIXEL_CHANNELS(image->format);\n4098\t\n4099\t      /* The following checks just the 'row_stride' calculation to ensure it\n4100\t       * fits in a signed 32-bit value.  Because channels/components can be\n4101\t       * either 1 or 2 bytes in size the length of a row can still overflow 32\n4102\t       * bits; this is just to verify that the 'row_stride' argument can be\n4103\t       * represented.\n4104\t       */\n4105\t      if (image->width <= 0x7fffffffU/channels) /* no overflow */\n4106\t      {\n4107\t         png_uint_32 check;\n4108\t         png_uint_32 png_row_stride = image->width * channels;\n4109\t\n4110\t         if (row_stride == 0)\n4111\t            row_stride = (png_int_32)/*SAFE*/png_row_stride;\n4112\t\n4113\t         if (row_stride < 0)\n4114\t            check = -(png_uint_32)row_stride;\n4115\t\n4116\t         else\n4117\t            check = (png_uint_32)row_stride;\n4118\t\n4119\t         /* This verifies 'check', the absolute value of the actual stride\n4120\t          * passed in and detects overflow in the application calculation (i.e.\n4121\t          * if the app did actually pass in a non-zero 'row_stride'.\n4122\t          */\n4123\t         if (image->opaque != NULL && buffer != NULL && check >= png_row_stride)\n4124\t         {\n4125\t            /* Now check for overflow of the image buffer calculation; this\n4126\t             * limits the whole image size to 32 bits for API compatibility with\n4127\t             * the current, 32-bit, PNG_IMAGE_BUFFER_SIZE macro.\n4128\t             *\n4129\t             * The PNG_IMAGE_BUFFER_SIZE macro is:\n4130\t             *\n4131\t             *    (PNG_IMAGE_PIXEL_COMPONENT_SIZE(fmt)*height*(row_stride))\n4132\t             *\n4133\t             * And the component size is always 1 or 2, so make sure that the\n4134\t             * number of *bytes* that the application is saying are available\n4135\t             * does actually fit into a 32-bit number.\n4136\t             *\n4137\t             * NOTE: this will be changed in 1.7 because PNG_IMAGE_BUFFER_SIZE\n4138\t             * will be changed to use png_alloc_size_t; bigger images can be\n4139\t             * accommodated on 64-bit systems.\n4140\t             */\n4141\t            if (image->height <=\n4142\t                0xffffffffU/PNG_IMAGE_PIXEL_COMPONENT_SIZE(image->format)/check)\n4143\t            {\n4144\t               if ((image->format & PNG_FORMAT_FLAG_COLORMAP) == 0 ||\n4145\t                  (image->colormap_entries > 0 && colormap != NULL))\n4146\t               {\n4147\t                  int result;\n4148\t                  png_image_read_control display;\n4149\t\n4150\t                  memset(&display, 0, (sizeof display));\n4151\t                  display.image = image;\n4152\t                  display.buffer = buffer;\n4153\t                  display.row_stride = row_stride;\n4154\t                  display.colormap = colormap;\n4155\t                  display.background = background;\n4156\t                  display.local_row = NULL;\n4157\t\n4158\t                  /* Choose the correct 'end' routine; for the color-map case\n4159\t                   * all the setup has already been done.\n4160\t                   */\n4161\t                  if ((image->format & PNG_FORMAT_FLAG_COLORMAP) != 0)\n4162\t                     result =\n4163\t                         png_safe_execute(image,\n4164\t                             png_image_read_colormap, &display) &&\n4165\t                             png_safe_execute(image,\n4166\t                             png_image_read_colormapped, &display);\n4167\t\n4168\t                  else\n4169\t                     result =\n4170\t                        png_safe_execute(image,\n4171\t                            png_image_read_direct, &display);\n4172\t\n4173\t                  png_image_free(image);\n4174\t                  return result;\n4175\t               }\n4176\t\n4177\t               else\n4178\t                  return png_image_error(image,\n4179\t                      \"png_image_finish_read[color-map]: no color-map\");\n4180\t            }\n4181\t\n4182\t            else\n4183\t               return png_image_error(image,\n4184\t                   \"png_image_finish_read: image too large\");\n4185\t         }\n4186\t\n4187\t         else\n4188\t            return png_image_error(image,\n4189\t                \"png_image_finish_read: invalid argument\");\n4190\t      }\n4191\t\n4192\t      else\n4193\