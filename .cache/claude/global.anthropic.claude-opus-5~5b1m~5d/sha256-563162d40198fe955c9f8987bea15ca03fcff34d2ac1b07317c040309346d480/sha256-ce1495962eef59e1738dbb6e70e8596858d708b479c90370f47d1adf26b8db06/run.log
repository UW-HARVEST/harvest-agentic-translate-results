   (\"int *\", \"*mut c_int\"), (\"int\", \"c_int\"),\n    (\"jmp_buf*\", \"*mut c_void\"),\n    (\"unsigned int\", \"c_uint\"),\n    (\"void\", \"()\"),\n]\nD = dict(TM)\n\n\ndef conv(t):\n    t = \" \".join(t.strip().split())\n    if t in D:\n        return D[t]\n    raise SystemExit(\"UNMAPPED TYPE: %r\" % t)\n\n\ndef split_arg(a):\n    a = \" \".join(a.strip().split())\n    if a == \"void\":\n        return None\n    if a == \"char out[29]\":\n        return \"*mut c_char\"\n    if a in D:\n        return D[a]\n    m = re.match(r\"^(.*?)([A-Za-z_][A-Za-z0-9_]*)$\", a)\n    if not m:\n        raise SystemExit(\"bad arg %r\" % a)\n    head = m.group(1)\n    if head.strip() == \"\":\n        raise SystemExit(\"UNMAPPED %r\" % a)\n    return conv(head)\n\n\ndef decls(path):\n    src = open(path).read()\n    src = re.sub(r\"/\\*.*?\\*/\", \"\", src, flags=re.S)\n    out = {}\n    pat = re.compile(\n        r\"PNG_(?:FP_|FIXED_)?EXPORT\\s*\\(\\s*\\d+\\s*,\\s*([A-Za-z_][A-Za-z0-9_ *]*?)\\s*,\"\n        r\"\\s*(\\w+)\\s*,\\s*\\((.*?)\\)\\s*\\)\",\n        re.S,\n    )\n    for m in pat.finditer(src):\n        out[m.group(2)] = (\" \".join(m.group(1).split()), \" \".join(m.group(3).split()))\n    pata = re.compile(\n        r\"PNG_EXPORTA\\s*\\(\\s*\\d+\\s*,\\s*([A-Za-z_][A-Za-z0-9_ *]*?)\\s*,\\s*(\\w+)\\s*,\\s*\\((.*?)\\)\\s*,\",\n        re.S,\n    )\n    for m in pata.finditer(src):\n        out[m.group(2)] = (\" \".join(m.group(1).split()), \" \".join(m.group(3).split()))\n    return out\n\n\n# Declared in png.h but compiled out of this build (absent from both `.so`s):\n#   png_err                     -- PNG_ERROR_TEXT_SUPPORTED is on, so png_err\n#                                  is only declared for the !ERROR_TEXT case\n#   png_set_strip_error_numbers -- PNG_ERROR_NUMBERS_SUPPORTED is off\nNOT_EXPORTED = {\"png_err\", \"png_set_strip_error_numbers\"}\n\n\ndef main():\n    d = decls(\"c_src/include/png.h\")\n    fields = []\n    for name in sorted(d):\n        if 