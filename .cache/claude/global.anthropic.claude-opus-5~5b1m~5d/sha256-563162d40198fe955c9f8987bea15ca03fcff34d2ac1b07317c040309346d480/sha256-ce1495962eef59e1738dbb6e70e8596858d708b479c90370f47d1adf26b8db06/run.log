png_struct::chromaticities is not set here because the RGB to gray\n1306\t    * coefficients are known without a need for the chromaticities.\n1307\t    */\n1308\t\n1309\t#ifdef PNG_READ_GAMMA_SUPPORTED\n1310\t      /* PNGv3: chunk precedence for gamma is cICP, [iCCP], sRGB, gAMA.  iCCP is\n1311\t       * not supported by libpng so the only requirement is to check for cICP\n1312\t       * setting the gamma (this is NYI, but this check is safe.)\n1313\t       */\n1314\t      if (!png_has_chunk(png_ptr, cICP) || png_ptr->chunk_gamma == 0)\n1315\t         png_ptr->chunk_gamma = PNG_GAMMA_sRGB_INVERSE;\n1316\t#endif /*READ_GAMMA*/\n1317\t\n1318\t   return handled_ok;\n1319\t   PNG_UNUSED(length)\n1320\t}\n1321\t#else\n1322\t#  define png_handle_sRGB NULL\n1323\t#endif /* READ_sRGB */\n1324\t\n1325\t#ifdef PNG_READ_iCCP_SUPPORTED\n1326\tstatic png_handle_result_code /* PRIVATE */\n1327\tpng_handle_iCCP(png_structrp png_ptr, png_inforp info_ptr, png_uint_32 length)\n1328\t/* Note: this does not properly handle profiles that are > 64K under DOS */\n1329\t{\n1330\t   png_const_charp errmsg = NULL; /* error message output, or no error */\n1331\t   int finished = 0; /* crc checked */\n1332\t\n1333\t   png_debug(1, \"in png_handle_iCCP\");\n1334\t\n1335\t   /* PNGv3: allow PNG files with both sRGB and iCCP because the PNG spec only\n1336\t    * ever said that there \"should\" be only one, not \"shall\" and the PNGv3\n1337\t    * colour chunk precedence rules give a handling for this case anyway.\n1338\t    */\n1339\t   {\n1340\t      uInt read_length, keyword_length;\n1341\t      char keyword[81];\n1342\t\n1343\t      /* Find the keyword; the keyword plus separator and compression method\n1344\t       * bytes can be at most 81 characters long.\n1345\t       */\n1346\t      read_length = 81; /* maximum */\n1347\t      if (read_length > length)\n1348\t         read_length = (uInt)/*SAFE*/length;\n1349\t\n1350\t      png_crc_read(png_ptr, (png_bytep)keyword, read_length);\n1351\t      length -= read_length;\n1352\t\n1353\t      if (length < LZ77Min)\n1354\t      {\n1355\t         png_crc_finish(png_ptr, length);\n1356\t         png_chunk_benign_error(png_ptr, \"too short\");\n1357\t         return handled_error;\n1358\t      }\n1359\t\n1360\t      keyword_length = 0;\n1361\t      while (keyword_length < 80 && keyword_length < read_length &&\n1362\t         keyword[keyword_length] != 0)\n1363\t         ++keyword_length;\n1364\t\n1365\t      /* TODO: make the keyword checking common */\n1366\t      if (keyword_length >= 1 && keyword_length <= 79)\n1367\t      {\n1368\t         /* We only understand '0' compression - deflate - so if we get a\n1369\t          * different value we can't safely decode the chunk.\n1370\t          */\n1371\t         if (keyword_length+1 < read_length &&\n1372\t            keyword[keyword_length+1] == PNG_COMPRESSION_TYPE_BASE)\n1373\t         {\n1374\t            read_length -= keyword_length+2;\n1375\t\n1376\t            if (png_inflate_claim(png_ptr, png_iCCP) == Z_OK)\n1377\t            {\n1378\t               Byte profile_header[132]={0};\n1379\t               Byte local_buffer[PNG_INFLATE_BUF_SIZE];\n1380\t               png_alloc_size_t size = (sizeof profile_header);\n1381\t\n1382\t               png_ptr->zstream.next_in = (Bytef*)keyword + (keyword_length+2);\n1383\t               png_ptr->zstream.avail_in = read_length;\n1384\t               (void)png_inflate_read(png_ptr, local_buffer,\n1385\t                   (sizeof local_buffer), &length, profile_header, &size,\n1386\t                   0/*finish: don't, because the output is too small*/);\n1387\t\n1388\t               if (size == 0)\n1389\t               {\n1390\t                  /* We have the ICC profile header; do the basic header checks.\n1391\t                   */\n1392\t                  png_uint_32 profile_length = png_get_uint_32(profile_header);\n1393\t\n1394\t                  if (png_icc_check_length(png_ptr, keyword, profile_length) !=\n1395\t                      0)\n1396\t                  {\n1397\t                     /* The length is apparently ok, so we can check the 132\n1398\t                      * byte header.\n1399\t                      */\n1400\t                     if (png_icc_check_header(png_ptr, keyword, profile_length,\n1401\t                              profile_header, png_ptr->color_type) != 0)\n1402\t                     {\n1403\t                        /* Now read the tag table; a variable size buffer is\n1404\t                         * needed at this point, allocate one for the whole\n1405\t                         * profile.  The header check has already validated\n1406\t                         * that none of this stuff will overflow.\n1407\t                         */\n1408\t                        png_uint_32 tag_count =\n1409\t                           png_get_uint_32(profile_header + 128);\n1410\t                        png_bytep profile = png_read_buffer(png_ptr,\n1411\t                              profile_length);\n1412\t\n1413\t                        if (profile != NULL)\n1414\t                        {\n1415\t                           memcpy(profile, profile_header,\n1416\t                               (sizeof profile_header));\n1417\t\n1418\t                           size = 12 * tag_count;\n1419\t\n1420\t                           (void)png_inflate_read(png_ptr, local_buffer,\n1421\t                               (sizeof local_buffer), &length,\n1422\t                               profile + (sizeof profile_header), &size, 0);\n1423\t\n1424\t                           /* Still expect a buffer error because we expect\n1425\t                            * there to be some tag data!\n1426\t                            */\n1427\t                           if (size == 0)\n1428\t                           {\n1429\t                              if (png_icc_check_tag_table(png_ptr,\n1430\t                                       keyword, profile_length, profile) != 0)\n1431\t                              {\n1432\t                                 /* The profile has been validated for basic\n1433\t                                  * security issues, so read the whole thing in.\n1434\t                                  */\n1435\t                                 size = profile_length - (sizeof profile_header)\n1436\t                                     - 12 * tag_count;\n1437\t\n1438\t                                 (void)png_inflate_read(png_ptr, local_buffer,\n1439\t                                     (sizeof local_buffer), &length,\n1440\t                                     profile + (sizeof profile_header) +\n1441\t                                     12 * tag_count, &size, 1/*finish*/);\n1442\t\n1443\t                                 if (length > 0 && !(png_ptr->flags &\n1444\t                                     PNG_FLAG_BENIGN_ERRORS_WARN))\n1445\t                                    errmsg = \"extra compressed data\";\n1446\t\n1447\t                                 /* But otherwise allow extra data: */\n1448\t                                 else if (size == 0)\n1449\t                                 {\n1450\t                                    if (length > 0)\n1451\t                                    {\n1452\t                                       /* This can be handled completely, so\n1453\t                                        * keep going.\n1454\t                                        */\n1455\t                                       png_chunk_warning(png_ptr,\n1456\t                                           \"extra compressed data\");\n1457\t                                    }\n1458\t\n1459\t                                    png_crc_finish(png_ptr, length);\n1460\t                                    finished = 1;\n1461\t\n1462\t                                    /* Steal the profile for info_ptr. */\n1463\t                                    if (info_ptr != NULL)\n1464\t                                    {\n1465\t                                       png_free_data(png_ptr, info_ptr,\n1466\t                                           PNG_FREE_ICCP, 0);\n1467\t\n1468\t                                       info_ptr->iccp_name = png_voidcast(char*,\n1469\t                                           png_malloc_base(png_ptr,\n1470\t                                           keyword_length+1));\n1471\t                                       if (info_ptr->iccp_name != NULL)\n1472\t                                       {\n1473\t                                          memcpy(info_ptr->iccp_name, keyword,\n1474\t                                              keyword_length+1);\n1475\t                                          info_ptr->iccp_proflen =\n1476\t                                              profile_length;\n1477\t                                          info_ptr->iccp_profile = profile;\n1478\t                                          png_ptr->read_buffer = NULL; /*steal*/\n1479\t                                          info_ptr->free_me |= PNG_FREE_ICCP;\n1480\t                                          info_ptr->valid |= PNG_INFO_iCCP;\n1481\t                                       }\n1482\t\n1483\t                                       else\n1484\t                                          errmsg = \"out of memory\";\n1485\t                                    }\n1486\t\n1487\t                                    /* else the profile remains in the read\n1488\t                                     * buffer which gets reused for subsequent\n1489\t                                     * chunks.\n1490\t                                     */\n1491\t\n1492\t                                    if (errmsg == NULL)\n1493\t                                    {\n1494\t                                       png_ptr->zowner = 0;\n1495\t                                       return handled_ok;\n1496\t                                    }\n1497\t                                 }\n1498\t                                 if (errmsg == NULL)\n1499\t                                    errmsg = png_ptr->zstream.msg;\n1500\t                              }\n1501\t                              /* else png_icc_check_tag_table output an error */\n1502\t                           }\n1503\t                           else /* profile truncated */\n1504\t                              errmsg = png_ptr->zstream.msg;\n1505\t                        }\n1506\t\n1507\t                        else\n1508\t                           errmsg = \"out of memory\";\n1509\t                     }\n1510\t\n1511\t                     /* else png_icc_check_header output an error */\n1512\t                  }\n1513\t\n1514\t                  /* else png_icc_check_length output an error */\n1515\t               }\n1516\t\n1517\t               else /* profile truncated */\n1518\t                  errmsg = png_ptr->zstream.msg;\n1519\t\n1520\t               /* Release the stream */\n1521\t               png_ptr->zowner = 0;\n1522\t            }\n1523\t\n1524\t            else /* png_inflate_claim failed */\n1525\t               errmsg = png_ptr->zstream.msg;\n1526\t         }\n1527\t\n1528\t         else\n1529\t            errmsg = \"bad compression method\"; /* or missing */\n1530\t      }\n1531\t\n1532\t      else\n1533\t         errmsg = \"bad keyword\";\n1534\t   }\n1535\t\n1536\t   /* Failure: the reason is in 'errmsg' */\n1537\t   if (finished == 0)\n1538\t      png_crc_finish(png_ptr, length);\n1539\t\n1540\t   if (errmsg != NULL) /* else already output */\n1541\t      png_chunk_benign_error(png_ptr, errmsg);\n1542\t\n1543\t   return handled_error;\n1544\t}\n1545\t#else\n1546\t#  define png_handle_iCCP NULL\n1547\t#endif /* READ_iCCP */\n1548\t\n1549\t#ifdef PNG_READ_sPLT_SUPPORTED\n1550\tstatic png_handle_result_code /* PRIVATE */\n1551\tpng_handle_sPLT(png_structrp png_ptr, png_inforp info_ptr, png_uint_32 length)\n1552\t/* Note: this does not properly handle chunks that are > 64K under DOS */\n1553\t{\n1554\t   png_bytep buffer;\n1555\t   png_bytep entry_start;\n1556\t   png_sPLT_t new_palette;\n1557\t   png_sPLT_entryp pp;\n1558\t   png_uint_32 data_length;\n1559\t   int entry_size, i;\n1560\t   png_uint_32 skip = 0;\n1561\t   png_uint_32 dl;\n1562\t   size_t max_dl;\n1563\t\n1564\t   png_debug(1, \"in png_handle_sPLT\");\n1565\t\n1566\t#ifdef PNG_USER_LIMITS_SUPPORTED\n1567\t   if (png_ptr->user_chunk_cache_max != 0)\n1568\t   {\n1569\t      if (png_ptr->user_chunk_cache_max == 1)\n1570\t      {\n1571\t         png_crc_finish(png_ptr, length);\n1572\t         return handled_error;\n1573\t      }\n1574\t\n1575\t      if (--png_ptr->user_chunk_cache_max == 1)\n1576\t      {\n1577\t         png_warning(png_ptr, \"No space in chunk cache for sPLT\");\n1578\t         png_crc_finish(png_ptr, length);\n1579\t         return handled_error;\n1580\t      }\n1581\t   }\n1582\t#endif\n1583\t\n1584\t   buffer = png_read_buffer(png_ptr, length+1);\n1585\t   if (buffer == NULL)\n1586\t   {\n1587\t      png_crc_finish(png_ptr, length);\n1588\t      png_chunk_benign_error(png_ptr, \"out of memory\");\n1589\t      return handled_error;\n1590\t   }\n1591\t\n1592\t\n1593\t   /* WARNING: this may break if size_t is less than 32 bits; it is assumed\n1594\t    * that the PNG_MAX_MALLOC_64K test is enabled in this case, but this is a\n1595\t    * potential breakage point if the types in pngconf.h aren't exactly right.\n1596\t    */\n1597\t   png_crc_read(png_ptr, buffer, length);\n1598\t\n1599\t   if (png_crc_finish(png_ptr, skip) != 0)\n1600\t      return handled_error;\n1601\t\n1602\t   buffer[length] = 0;\n1603\t\n1604\t   for (entry_start = buffer; *entry_start; entry_start++)\n1605\t      /* Empty loop to find end of name */ ;\n1606\t\n1607\t   ++entry_start;\n1608\t\n1609\t   /* A sample depth should follow the separator, and we should be on it  */\n1610\t   if (length < 2U || entry_start > buffer + (length - 2U))\n1611\t   {\n1612\t      png_warning(png_ptr, \"malformed sPLT chunk\");\n1613\t      return handled_error;\n1614\t   }\n1615\t\n1616\t   new_palette.depth = *entry_start++;\n1617\t   entry_size = (new_palette.depth == 8 ? 6 : 10);\n1618\t   /* This must fit in a png_uint_32 because it is derived from the original\n1619\t    * chunk data length.\n1620\t    */\n1621\t   data_length = length - (png_uint_32)(entry_start - buffer);\n1622\t\n1623\t   /* Integrity-check the data length */\n1624\t   if ((data_length % (unsigned int)entry_size) != 0)\n1625\t   {\n1626\t      png_warning(png_ptr, \"sPLT chunk has bad length\");\n1627\t      return handled_error;\n1628\t   }\n1629\t\n1630\t   dl = (png_uint_32)(data_length / (unsigned int)entry_size);\n1631\t   max_dl = PNG_SIZE_MAX / (sizeof (png_sPLT_entry));\n1632\t\n1633\t   if (dl > max_dl)\n1634\t   {\n1635\t      png_warning(png_ptr, \"sPLT chunk too long\");\n1636\t      return handled_error;\n1637\t   }\n1638\t\n1639\t   new_palette.nentries = (png_int_32)(data_length / (unsigned int)entry_size);\n1640\t\n1641\t   new_palette.entries = (png_sPLT_entryp)png_malloc_warn(png_ptr,\n1642\t       (png_alloc_size_t) new_palette.nentries * (sizeof (png_sPLT_entry)));\n1643\t\n1644\t   if (new_palette.entries == NULL)\n1645\t   {\n1646\t      png_warning(png_ptr, \"sPLT chunk requires too much memory\");\n1647\t      return handled_error;\n1648\t   }\n1649\t\n1650\t   for (i = 0; i < new_palette.nentries; i++)\n1651\t   {\n1652\t      pp = new_palette.entries + i;\n1653\t\n1654\t      if (new_palette.depth == 8)\n1655\t      {\n1656\t         pp->red = *entry_start++;\n1657\t         pp->green = *entry_start++;\n1658\t         pp->blue = *entry_start++;\n1659\t         pp->alpha = *entry_start++;\n1660\t      }\n1661\t\n1662\t      else\n1663\t      {\n1664\t         pp->red   = png_get_uint_16(entry_start); entry_start += 2;\n1665\t         pp->green = png_get_uint_16(entry_start); entry_start += 2;\n1666\t         pp->blue  = png_get_uint_16(entry_start); entry_start += 2;\n1667\t         pp->alpha = png_get_uint_16(entry_start); entry_start += 2;\n1668\t      }\n1669\t\n1670\t      pp->frequency = png_get_uint_16(entry_start); entry_start += 2;\n1671\t   }\n1672\t\n1673\t   /* Discard all chunk data except the name and stash that */\n1674\t   new_palette.name = (png_charp)buffer;\n1675\t\n1676\t   png_set_sPLT(png_ptr, info_ptr, &new_palette, 1);\n1677\t\n1678\t   png_free(png_ptr, new_palette.entries);\n1679\t   return handled_ok;\n1680\t}\n1681\t#else\n1682\t#  define png_handle_sPLT NULL\n1683\t#endif /* READ_sPLT */\n1684\t\n1685\t#ifdef PNG_READ_tRNS_SUPPORTED\n1686\tstatic png_handle_result_code /* PRIVATE */\n1687\tpng_handle_tRNS(png_structrp png_ptr, png_inforp info_ptr, png_uint_32 length)\n1688\t{\n1689\t   png_byte readbuf[PNG_MAX_PALETTE_LENGTH];\n1690\t\n1691\t   png_debug(1, \"in png_handle_tRNS\");\n1692\t\n1693\t   if (png_ptr->color_type == PNG_COLOR_TYPE_GRAY)\n1694\t   {\n1695\t      png_byte buf[2];\n1696\t\n1697\t      if (length != 2)\n1698\t      {\n1699\t         png_crc_finish(png_ptr, length);\n1700\t         png_chunk_benign_error(png_ptr, \"invalid\");\n1701\t         return handled_error;\n1702\t      }\n1703\t\n1704\t      png_crc_read(png_ptr, buf, 2);\n1705\t      png_ptr->num_trans = 1;\n1706\t      png_ptr->trans_color.gray = png_get_uint_16(buf);\n1707\t   }\n1708\t\n1709\t   else if (png_ptr->color_type == PNG_COLOR_TYPE_RGB)\n1710\t   {\n1711\t      png_byte buf[6];\n1712\t\n1713\t      if (length != 6)\n1714\t      {\n1715\t         png_crc_finish(png_ptr, length);\n1716\t         png_chunk_benign_error(png_ptr, \"invalid\");\n1717\t         return handled_error;\n1718\t      }\n1719\t\n1720\t      png_crc_read(png_ptr, buf, length);\n1721\t      png_ptr->num_trans = 1;\n1722\t      png_ptr->trans_color.red = png_get_uint_16(buf);\n1723\t      png_ptr->trans_color.green = png_get_uint_16(buf + 2);\n1724\t      png_ptr->trans_color.blue = png_get_uint_16(buf + 4);\n1725\t   }\n1726\