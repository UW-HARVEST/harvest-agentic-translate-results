  {\n544\t      png_chunk_report(png_ptr, \"Insufficient memory for pCAL purpose\",\n545\t            PNG_CHUNK_WRITE_ERROR);\n546\t      return;\n547\t   }\n548\t\n549\t   memcpy(info_ptr->pcal_purpose, purpose, length);\n550\t\n551\t   info_ptr->free_me |= PNG_FREE_PCAL;\n552\t\n553\t   png_debug(3, \"storing X0, X1, type, and nparams in info\");\n554\t   info_ptr->pcal_X0 = X0;\n555\t   info_ptr->pcal_X1 = X1;\n556\t   info_ptr->pcal_type = (png_byte)type;\n557\t   info_ptr->pcal_nparams = (png_byte)nparams;\n558\t\n559\t   length = strlen(units) + 1;\n560\t   png_debug1(3, \"allocating units for info (%lu bytes)\",\n561\t       (unsigned long)length);\n562\t\n563\t   info_ptr->pcal_units = png_voidcast(png_charp,\n564\t       png_malloc_warn(png_ptr, length));\n565\t\n566\t   if (info_ptr->pcal_units == NULL)\n567\t   {\n568\t      png_warning(png_ptr, \"Insufficient memory for pCAL units\");\n569\t      return;\n570\t   }\n571\t\n572\t   memcpy(info_ptr->pcal_units, units, length);\n573\t\n574\t   info_ptr->pcal_params = png_voidcast(png_charpp, png_malloc_warn(png_ptr,\n575\t       (size_t)(((unsigned int)nparams + 1) * (sizeof (png_charp)))));\n576\t\n577\t   if (info_ptr->pcal_params == NULL)\n578\t   {\n579\t      png_warning(png_ptr, \"Insufficient memory for pCAL params\");\n580\t      return;\n581\t   }\n582\t\n583\t   memset(info_ptr->pcal_params, 0, ((unsigned int)nparams + 1) *\n584\t       (sizeof (png_charp)));\n585\t\n586\t   for (i = 0; i < nparams; i++)\n587\t   {\n588\t      length = strlen(params[i]) + 1;\n589\t      png_debug2(3, \"allocating parameter %d for info (%lu bytes)\", i,\n590\t          (unsigned long)length);\n591\t\n592\t      info_ptr->pcal_params[i] = (png_charp)png_malloc_warn(png_ptr, length);\n593\t\n594\t      if (info_ptr->pcal_params[i] == NULL)\n595\t      {\n596\t         png_warning(png_ptr, \"Insufficient memory for pCAL parameter\");\n597\t         return;\n598\t      }\n599\t\n600\t      memcpy(info_ptr->pcal_params[i], params[i], length);\n601\t   }\n602\t\n603\t   info_ptr->valid |= PNG_INFO_pCAL;\n604\t}\n605\t#endif\n606\t\n607\t#ifdef PNG_sCAL_SUPPORTED\n608\tvoid PNGAPI\n609\tpng_set_sCAL_s(png_const_structrp png_ptr, png_inforp info_ptr,\n610\t    int unit, png_const_charp swidth, png_const_charp sheight)\n611\t{\n612\t   size_t lengthw = 0, lengthh = 0;\n613\t\n614\t   png_debug1(1, \"in %s storage function\", \"sCAL\");\n615\t\n616\t   if (png_ptr == NULL || info_ptr == NULL)\n617\t      return;\n618\t\n619\t   /* Double check the unit (should never get here with an invalid\n620\t    * unit unless this is an API call.)\n621\t    */\n622\t   if (unit != 1 && unit != 2)\n623\t      png_error(png_ptr, \"Invalid sCAL unit\");\n624\t\n625\t   if (swidth == NULL || (lengthw = strlen(swidth)) == 0 ||\n626\t       swidth[0] == 45 /* '-' */ || !png_check_fp_string(swidth, lengthw))\n627\t      png_error(png_ptr, \"Invalid sCAL width\");\n628\t\n629\t   if (sheight == NULL || (lengthh = strlen(sheight)) == 0 ||\n630\t       sheight[0] == 45 /* '-' */ || !png_check_fp_string(sheight, lengthh))\n631\t      png_error(png_ptr, \"Invalid sCAL height\");\n632\t\n633\t   info_ptr->scal_unit = (png_byte)unit;\n634\t\n635\t   ++lengthw;\n636\t\n637\t   png_debug1(3, \"allocating unit for info (%u bytes)\", (unsigned int)lengthw);\n638\t\n639\t   info_ptr->scal_s_width = png_voidcast(png_charp,\n640\t       png_malloc_warn(png_ptr, lengthw));\n641\t\n642\t   if (info_ptr->scal_s_width == NULL)\n643\t   {\n644\t      png_warning(png_ptr, \"Memory allocation failed while processing sCAL\");\n645\t\n646\t      return;\n647\t   }\n648\t\n649\t   memcpy(info_ptr->scal_s_width, swidth, lengthw);\n650\t\n651\t   ++lengthh;\n652\t\n653\t   png_debug1(3, \"allocating unit for info (%u bytes)\", (unsigned int)lengthh);\n654\t\n655\t   info_ptr->scal_s_height = png_voidcast(png_charp,\n656\t       png_malloc_warn(png_ptr, lengthh));\n657\t\n658\t   if (info_ptr->scal_s_height == NULL)\n659\t   {\n660\t      png_free(png_ptr, info_ptr->scal_s_width);\n661\t      info_ptr->scal_s_width = NULL;\n662\t\n663\t      png_warning(png_ptr, \"Memory allocation failed while processing sCAL\");\n664\t      return;\n665\t   }\n666\t\n667\t   memcpy(info_ptr->scal_s_height, sheight, lengthh);\n668\t\n669\t   info_ptr->free_me |= PNG_FREE_SCAL;\n670\t   info_ptr->valid |= PNG_INFO_sCAL;\n671\t}\n672\t\n673\t#  ifdef PNG_FLOATING_POINT_SUPPORTED\n674\tvoid PNGAPI\n675\tpng_set_sCAL(png_const_structrp png_ptr, png_inforp info_ptr, int unit,\n676\t    double width, double height)\n677\t{\n678\t   png_debug1(1, \"in %s storage function\", \"sCAL\");\n679\t\n680\t   /* Check the arguments. */\n681\t   if (width <= 0)\n682\t      png_warning(png_ptr, \"Invalid sCAL width ignored\");\n683\t\n684\t   else if (height <= 0)\n685\t      png_warning(png_ptr, \"Invalid sCAL height ignored\");\n686\t\n687\t   else\n688\t   {\n689\t      /* Convert 'width' and 'height' to ASCII. */\n690\t      char swidth[PNG_sCAL_MAX_DIGITS+1];\n691\t      char sheight[PNG_sCAL_MAX_DIGITS+1];\n692\t\n693\t      png_ascii_from_fp(png_ptr, swidth, (sizeof swidth), width,\n694\t          PNG_sCAL_PRECISION);\n695\t      png_ascii_from_fp(png_ptr, sheight, (sizeof sheight), height,\n696\t          PNG_sCAL_PRECISION);\n697\t\n698\t      png_set_sCAL_s(png_ptr, info_ptr, unit, swidth, sheight);\n699\t   }\n700\t}\n701\t#  endif\n702\t\n703\t#  ifdef PNG_FIXED_POINT_SUPPORTED\n704\tvoid PNGAPI\n705\tpng_set_sCAL_fixed(png_const_structrp png_ptr, png_inforp info_ptr, int unit,\n706\t    png_fixed_point width, png_fixed_point height)\n707\t{\n708\t   png_debug1(1, \"in %s storage function\", \"sCAL\");\n709\t\n710\t   /* Check the arguments. */\n711\t   if (width <= 0)\n712\t      png_warning(png_ptr, \"Invalid sCAL width ignored\");\n713\t\n714\t   else if (height <= 0)\n715\t      png_warning(png_ptr, \"Invalid sCAL height ignored\");\n716\t\n717\t   else\n718\t   {\n719\t      /* Convert 'width' and 'height' to ASCII. */\n720\t      char swidth[PNG_sCAL_MAX_DIGITS+1];\n721\t      char sheight[PNG_sCAL_MAX_DIGITS+1];\n722\t\n723\t      png_ascii_from_fixed(png_ptr, swidth, (sizeof swidth), width);\n724\t      png_ascii_from_fixed(png_ptr, sheight, (sizeof sheight), height);\n725\t\n726\t      png_set_sCAL_s(png_ptr, info_ptr, unit, swidth, sheight);\n727\t   }\n728\t}\n729\t#  endif\n730\t#endif\n731\t\n732\t#ifdef PNG_pHYs_SUPPORTED\n733\tvoid PNGAPI\n734\tpng_set_pHYs(png_const_structrp png_ptr, png_inforp info_ptr,\n735\t    png_uint_32 res_x, png_uint_32 res_y, int unit_type)\n736\t{\n737\t   png_debug1(1, \"in %s storage function\", \"pHYs\");\n738\t\n739\t   if (png_ptr == NULL || info_ptr == NULL)\n740\t      return;\n741\t\n742\t   info_ptr->x_pixels_per_unit = res_x;\n743\t   info_ptr->y_pixels_per_unit = res_y;\n744\t   info_ptr->phys_unit_type = (png_byte)unit_type;\n745\t   info_ptr->valid |= PNG_INFO_pHYs;\n746\t}\n747\t#endif\n748\t\n749\tvoid PNGAPI\n750\tpng_set_PLTE(png_structrp png_ptr, png_inforp info_ptr,\n751\t    png_const_colorp palette, int num_palette)\n752\t{\n753\t   png_color safe_palette[PNG_MAX_PALETTE_LENGTH];\n754\t   png_uint_32 max_palette_length;\n755\t\n756\t   png_debug1(1, \"in %s storage function\", \"PLTE\");\n757\t\n758\t   if (png_ptr == NULL || info_ptr == NULL)\n759\t      return;\n760\t\n761\t   max_palette_length = (info_ptr->color_type == PNG_COLOR_TYPE_PALETTE) ?\n762\t      (1 << info_ptr->bit_depth) : PNG_MAX_PALETTE_LENGTH;\n763\t\n764\t   if (num_palette < 0 || num_palette > (int) max_palette_length)\n765\t   {\n766\t      if (info_ptr->color_type == PNG_COLOR_TYPE_PALETTE)\n767\t         png_error(png_ptr, \"Invalid palette length\");\n768\t\n769\t      else\n770\t      {\n771\t         png_warning(png_ptr, \"Invalid palette length\");\n772\t\n773\t         return;\n774\t      }\n775\t   }\n776\t\n777\t   if ((num_palette > 0 && palette == NULL) ||\n778\t      (num_palette == 0\n779\t#        ifdef PNG_MNG_FEATURES_SUPPORTED\n780\t            && (png_ptr->mng_features_permitted & PNG_FLAG_MNG_EMPTY_PLTE) == 0\n781\t#        endif\n782\t      ))\n783\t   {\n784\t      png_error(png_ptr, \"Invalid palette\");\n785\t   }\n786\t\n787\t   /* Snapshot the caller's palette before freeing, in case it points to\n788\t    * info_ptr->palette (getter-to-setter aliasing).\n789\t    */\n790\t   if (num_palette > 0)\n791\t      memcpy(safe_palette, palette, (unsigned int)num_palette *\n792\t          (sizeof (png_color)));\n793\t\n794\t   palette = safe_palette;\n795\t\n796\t   png_free_data(png_ptr, info_ptr, PNG_FREE_PLTE, 0);\n797\t\n798\t   /* Changed in libpng-1.2.1 to allocate PNG_MAX_PALETTE_LENGTH instead\n799\t    * of num_palette entries, in case of an invalid PNG file or incorrect\n800\t    * call to png_set_PLTE() with too-large sample values.\n801\t    *\n802\t    * Allocate independent buffers for info_ptr and png_ptr so that the\n803\t    * lifetime of png_ptr->palette is decoupled from the lifetime of\n804\t    * info_ptr->palette.  Previously, these two pointers were aliased,\n805\t    * which caused a use-after-free vulnerability if png_free_data freed\n806\t    * info_ptr->palette while png_ptr->palette was still in use by the\n807\t    * row transform functions (e.g. png_do_expand_palette).\n808\t    *\n809\t    * Both buffers are allocated with png_calloc to zero-fill, because\n810\t    * the ARM NEON palette riffle reads all 256 entries unconditionally,\n811\t    * regardless of num_palette.\n812\t    */\n813\t   png_free(png_ptr, png_ptr->palette);\n814\t   png_ptr->palette = NULL;\n815\t   png_ptr->palette = png_voidcast(png_colorp, png_calloc(png_ptr,\n816\t       PNG_MAX_PALETTE_LENGTH * (sizeof (png_color))));\n817\t   info_ptr->palette = png_voidcast(png_colorp, png_calloc(png_ptr,\n818\t       PNG_MAX_PALETTE_LENGTH * (sizeof (png_color))));\n819\t   png_ptr->num_palette = info_ptr->num_palette = (png_uint_16)num_palette;\n820\t\n821\t   if (num_palette > 0)\n822\t   {\n823\t      memcpy(info_ptr->palette, palette, (unsigned int)num_palette *\n824\t          (sizeof (png_color)));\n825\t      memcpy(png_ptr->palette, palette, (unsigned int)num_palette *\n826\t          (sizeof (png_color)));\n827\t   }\n828\t\n829\t   info_ptr->free_me |= PNG_FREE_PLTE;\n830\t   info_ptr->valid |= PNG_INFO_PLTE;\n831\t}\n832\t\n833\t#ifdef PNG_sBIT_SUPPORTED\n834\tvoid PNGAPI\n835\tpng_set_sBIT(png_const_structrp png_ptr, png_inforp info_ptr,\n836\t    png_const_color_8p sig_bit)\n837\t{\n838\t   png_debug1(1, \"in %s storage function\", \"sBIT\");\n839\t\n840\t   if (png_ptr == NULL || info_ptr == NULL || sig_bit == NULL)\n841\t      return;\n842\t\n843\t   info_ptr->sig_bit = *sig_bit;\n844\t   info_ptr->valid |= PNG_INFO_sBIT;\n845\t}\n846\t#endif\n847\t\n848\t#ifdef PNG_sRGB_SUPPORTED\n849\tvoid PNGAPI\n850\tpng_set_sRGB(png_const_structrp png_ptr, png_inforp info_ptr, int srgb_intent)\n851\t{\n852\t   png_debug1(1, \"in %s storage function\", \"sRGB\");\n853\t\n854\t   if (png_ptr == NULL || info_ptr == NULL)\n855\t      return;\n856\t\n857\t   info_ptr->rendering_intent = srgb_intent;\n858\t   info_ptr->valid |= PNG_INFO_sRGB;\n859\t}\n860\t\n861\tvoid PNGAPI\n862\tpng_set_sRGB_gAMA_and_cHRM(png_const_structrp png_ptr, png_inforp info_ptr,\n863\t    int srgb_intent)\n864\t{\n865\t   png_debug1(1, \"in %s storage function\", \"sRGB_gAMA_and_cHRM\");\n866\t\n867\t   if (png_ptr == NULL || info_ptr == NULL)\n868\t      return;\n869\t\n870\t   png_set_sRGB(png_ptr, info_ptr, srgb_intent);\n871\t\n872\t#  ifdef PNG_gAMA_SUPPORTED\n873\t      png_set_gAMA_fixed(png_ptr, info_ptr, PNG_GAMMA_sRGB_INVERSE);\n874\t#  endif /* gAMA */\n875\t\n876\t#  ifdef PNG_cHRM_SUPPORTED\n877\t      png_set_cHRM_fixed(png_ptr, info_ptr,\n878\t         /* color      x       y */\n879\t         /* white */ 31270, 32900,\n880\t         /* red   */ 64000, 33000,\n881\t         /* green */ 30000, 60000,\n882\t         /* blue  */ 15000,  6000);\n883\t#  endif /* cHRM */\n884\t}\n885\t#endif /* sRGB */\n886\t\n887\t\n888\t#ifdef PNG_iCCP_SUPPORTED\n889\tvoid PNGAPI\n890\tpng_set_iCCP(png_const_structrp png_ptr, png_inforp info_ptr,\n891\t    png_const_charp name, int compression_type,\n892\t    png_const_bytep profile, png_uint_32 proflen)\n893\t{\n894\t   png_charp new_iccp_name;\n895\t   png_bytep new_iccp_profile;\n896\t   size_t length;\n897\t\n898\t   png_debug1(1, \"in %s storage function\", \"iCCP\");\n899\t\n900\t   if (png_ptr == NULL || info_ptr == NULL || name == NULL || profile == NULL)\n901\t      return;\n902\t\n903\t   if (compression_type != PNG_COMPRESSION_TYPE_BASE)\n904\t      png_app_error(png_ptr, \"Invalid iCCP compression method\");\n905\t\n906\t   length = strlen(name)+1;\n907\t   new_iccp_name = png_voidcast(png_charp, png_malloc_warn(png_ptr, length));\n908\t\n909\t   if (new_iccp_name == NULL)\n910\t   {\n911\t      png_benign_error(png_ptr, \"Insufficient memory to process iCCP chunk\");\n912\t\n913\t      return;\n914\t   }\n915\t\n916\t   memcpy(new_iccp_name, name, length);\n917\t   new_iccp_profile = png_voidcast(png_bytep,\n918\t       png_malloc_warn(png_ptr, proflen));\n919\t\n920\t   if (new_iccp_profile == NULL)\n921\t   {\n922\t      png_free(png_ptr, new_iccp_name);\n923\t      png_benign_error(png_ptr,\n924\t          \"Insufficient memory to process iCCP profile\");\n925\t\n926\t      return;\n927\t   }\n928\t\n929\t   memcpy(new_iccp_profile, profile, proflen);\n930\t\n931\t   png_free_data(png_ptr, info_ptr, PNG_FREE_ICCP, 0);\n932\t\n933\t   info_ptr->iccp_proflen = proflen;\n934\t   info_ptr->iccp_name = new_iccp_name;\n935\t   info_ptr->iccp_profile = new_iccp_profile;\n936\t   info_ptr->free_me |= PNG_FREE_ICCP;\n937\t   info_ptr->valid |= PNG_INFO_iCCP;\n938\t}\n939\t#endif\n940\t\n941\t#ifdef PNG_TEXT_SUPPORTED\n942\tvoid PNGAPI\n943\tpng_set_text(png_const_structrp png_ptr, png_inforp info_ptr,\n944\t    png_const_textp text_ptr, int num_text)\n945\t{\n946\t   int ret;\n947\t   ret = png_set_text_2(png_ptr, info_ptr, text_ptr, num_text);\n948\t\n949\t   if (ret != 0)\n950\t      png_error(png_ptr, \"Insufficient memory to store text\");\n951\t}\n952\t\n953\tint /* PRIVATE */\n954\tpng_set_text_2(png_const_structrp png_ptr, png_inforp info_ptr,\n955\t    png_const_textp text_ptr, int num_text)\n956\t{\n957\t   int i;\n958\t   png_textp old_text = NULL;\n959\t\n960\t   png_debug1(1, \"in text storage function, chunk typeid = 0x%lx\",\n961\t      png_ptr == NULL ? 0xabadca11UL : (unsigned long)png_ptr->chunk_name);\n962\t\n963\t   if (png_ptr == NULL || info_ptr == NULL || num_text <= 0 || text_ptr == NULL)\n964\t      return 0;\n965\t\n966\t   /* Make sure we have enough space in the \"text\" array in info_struct\n967\t    * to hold all of the incoming text_ptr objects.  This compare can't overflow\n968\t    * because max_text >= num_text (anyway, subtract of two positive integers\n969\t    * can't overflow in any case.)\n970\t    */\n971\t   if (num_text > info_ptr->max_text - info_ptr->num_text)\n972\t   {\n973\t      int old_num_text = info_ptr->num_text;\n974\t      int max_text;\n975\t      png_textp new_text = NULL;\n976\t\n977\t      /* Calculate an appropriate max_text, checking for overflow. */\n978\t      max_text = old_num_text;\n979\t      if (num_text <= INT_MAX - max_text)\n980\t      {\n981\t         max_text += num_text;\n982\t\n983\t         /* Round up to a multiple of 8 */\n984\t         if (max_text < INT_MAX-8)\n985\t            max_text = (max_text + 8) & ~0x7;\n986\t\n987\t         else\n988\t            max_text = INT_MAX;\n989\t\n990\t         /* Now allocate a new array and copy the old members in; this does all\n991\t          * the overflow checks.\n992\t          */\n993\t         new_text = png_voidcast(png_textp,png_realloc_array(png_ptr,\n994\t             info_ptr->text, old_num_text, max_text-old_num_text,\n995\t             sizeof *new_text));\n996\t      }\n997\t\n998\t      if (new_text == NULL)\n999\t      {\n1000\t         png_chunk_report(png_ptr, \"too many text chunks\",\n1001\t             PNG_CHUNK_WRITE_ERROR);\n1002\t\n1003\t         return 1;\n1004\t      }\n1005\t\n1006\t      /* Defer freeing the old array until after the copy loop below,\n1007\t       * in case text_ptr aliases info_ptr->text (getter-to-setter).\n1008\t       */\n1009\t      old_text = info_ptr->text;\n1010\t\n1011\t      info_ptr->text = new_text;\n1012\t      info_ptr->free_me |= PNG_FREE_TEXT;\n1013\t      info_ptr->max_text = max_text;\n1014\t      /* num_text is adjusted below as the entries are copied in */\n1015\t\n1016\t      png_debug1(3, \"allocated %d entries for info_ptr->text\", max_text);\n1017\t   }\n1018\t\n1019\t   for (i = 0; i < num_text; i++)\n1020\t   {\n1021\t      size_t text_length, key_len;\n1022\t      size_t lang_len, lang_key_len;\n1023\t      png_textp textp = &(info_ptr->text[info_ptr->num_text]);\n1024\t\n1025\t      if (text_ptr[i].key == NULL)\n1026\t          continue;\n1027\t\n1028\t      if (text_ptr[i].compression < PNG_TEXT_COMPRESSION_NONE ||\n1029\t          text_ptr[i].compression >= PNG_TEXT_COMPRESSION_LAST)\n1030\t      {\n1031\t         png_chunk_report(png_ptr, \"text compression mode is out of range\",\n1032\t             PNG_CHUNK_WRITE_ERROR);\n1033\t         continue;\n1034\t      }\n1035\t\n1036\t      key_len = strlen(text_ptr[i].key);\n1037\t\n1038\t      if (text_ptr[i].compression <= 0)\n1039\t      {\n1040\t         lang_len = 0;\n1041\t         lang_key_len = 0;\n1042\t      }\n1043\t\n1044\t      else\n1045\t#  ifdef PNG_iTXt_SUPPORTED\n1046\t      {\n1047\t         /* Set iTXt data */\n1048\t\n1049\t         if (text_ptr[i].lang != NULL)\n1050\t            lang_len = strlen(text_ptr[i].lang);\n1051\t\n1052\t         else\n1053\t            lang_len = 0;\n1054\t\n1055\t         if (text_ptr[i].lang_key != NULL)\n1056\t            lang_key_len = strlen(text_ptr[i].lang_key);\n1057\t\n1058\t         else\n1059\t            lang_key_len = 0;\n1060\t      }\n1061\t#  else /* iTXt */\n1062\t      {\n1063\t         png_chunk_report(png_ptr, \"iTXt chunk not supported\",\n1064\t             PNG_CHUNK_WRITE_ERROR);\n1065\t         continue;\n1066\t      }\n1067\t#  endif\n1068\t\n1069\t      if (text_ptr[i].text == NULL || text_ptr[i].text[0] == '\\0')\n1070\t      {\n1071\t         text_length = 0;\n1072\t#  ifdef PNG_iTXt_SUPPORTED\n1073\t         if (text_ptr[i].compression > 0)\n1074\t            textp->compression = PNG_ITXT_COMPRESSION_NONE;\n1075\t\n1076\t         else\n1077\t#  endif\n1078\t            textp->compression = PNG_TEXT_COMPRESSION_NONE;\n1079\t      }\n1080\t\n1081\t      else\n1082\t      {\n1083\t         text_length = strlen(text_ptr[i].text);\n1084\t         textp->compression = text_ptr[i].compression;\n1085\t      }\n1086\t\n1087\t      textp->key = png_voidcast(png_charp,png_malloc_base(png_ptr,\n1088\t          key_len + text_length + lang_len + lang_key_len + 4));\n1089\t\n1090\t      if (textp->key == NULL)\n1091\t      {\n1092\t         png_chunk_report(png_ptr, \"text chunk: out of memory\",\n1093\t             PNG_CHUNK_WRITE_ERROR);\n1094\t         png_free(png_ptr, old_text);\n1095\t\n1096\t         return 1;\n1097\t      }\n1098\t\n1099\t      png_debug2(2, \"Allocated %lu bytes at %p in png_set_text\",\n1100\t          (unsigned long)(png_uint_32)\n1101\t          (key_len + lang_len + lang_key_len + text_length + 4),\n1102\t          textp->key);\n1103\t\n1104\t      memcpy(textp->key, text_ptr[i].key, key_len);\n1105\t      *(textp->key + key_len) = '\\0';\n1106\t\n1107\t      if (text_ptr[i].compression > 0)\n1108\t      {\n1109\t         textp->lang = textp->key + key_len + 1;\n1110\t         memcpy(textp->lang, text_ptr[i].lang, lang_len);\n1111\t         *(textp->lang + lang_len) = '\\0';\n1112\t         textp->lang_key = textp->lang + lang_len + 1;\n1113\t         memcpy(textp->lang_key, text_ptr[i].lang_key, lang_key_len);\n1114\t         *(textp->lang_key + lang_key_len) = '\\0';\n1115\t         textp->text = textp->lang_key + lang_key_len + 1;\n1116\t      }\n1117\t\n1118\t      else\n1119\t      {\n1120\t         textp->lang=NULL;\n1121\t         textp->lang_key=NULL;\n1122\t         textp->text = textp->key + key_len + 1;\n1123\t      }\n1124\t\n1125\t      if (text_length != 0)\n1126\t         memcpy(textp->text, text_ptr[i].text, text_length);\n1127\t\n1128\t      *(textp->text + text_length) = '\\0';\n1129\t\n1130\t#  ifdef PNG_iTXt_SUPPORTED\n1131\t      if (textp->compression > 0)\n1132\t      {\n1133\t         textp->text_length = 0;\n1134\t         textp->itxt_length = text_length;\n1135\t      }\n1136\t\n1137\t      else\n1138\t#  endif\n1139\t      {\n1140\t         textp->text_length = text_length;\n1141\t         textp->itxt_length = 0;\n1142\t      }\n1143\t\n1144\t      info_ptr->num_text++;\n1145\t      png_debug1(3, \"transferred text chunk %d\", info_ptr->num_text);\n1146\t   }\n1147\t\n1148\t   png_free(png_ptr, old_text);\n1149\t\n1150\t   return 0;\n1151\t}\n1152\t#endif\n1153\t\n1154\t#ifdef PNG_tIME_SUPPORTED\n1155\tvoid PNGAPI\n1156\tpng_set_tIME(png_const_structrp png_ptr, png_inforp info_ptr,\n1157\t    png_const_timep mod_time)\n1158\t{\n1159\t   png_debug1(1, \"in %s storage function\", \"tIME\");\n1160\t\n1161\t   if (png_ptr == NULL || info_ptr == NULL || mod_time == NULL ||\n1162\t       (png_ptr->mode & PNG_WROTE_tIME) != 0)\n1163\t      return;\n1164\t\n1165\t   if (mod_time->month == 0   || mod_time->month > 12  ||\n1166\t       mod_time->day   == 0   || mod_time->day   > 31  ||\n1167\t       mod_time->hour  > 23   || mod_time->minute > 59 ||\n1168\t       mod_time->second > 60)\n1169\t   {\n1170\t      png_warning(png_ptr, \"Ignoring invalid time value\");\n1171\t\n1172\t      return;\n1173\t   }\n1174\t\n1175\t   info_ptr->mod_time = *mod_time;\n1176\t   info_ptr->valid |= PNG_INFO_tIME;\n1177\t}\n1178\t#endif\n1179\t\n1180\t#ifdef PNG_tRNS_SUPPORTED\n1181\tvoid PNGAPI\n1182\t