Some((c, l)),\n198\t        _ => None,\n199\t    }\n200\t}\n201\t\n202\t#[derive(Debug, PartialEq, Eq, Clone)]\n203\tpub struct Transcript {\n204\t    pub exit: Option<i32>,\n205\t    pub signal: bool,\n206\t    pub lines: Vec<String>,\n207\t}\n208\t\n209\t/// Re-execute this very test binary to run `case` against library `which`.\n210\tpub fn run_child(case: &str, which: &str) -> Transcript {\n211\t    let exe = std::env::current_exe().expect(\"current_exe\");\n212\t    let out = std::process::Command::new(exe)\n213\t        .args([\"--exact\", \"harness_child\", \"--nocapture\", \"--test-threads=1\"])\n214\t        .env(ENV_CASE, case)\n215\t        .env(ENV_LIB, which)\n216\t        .env(\"RUST_BACKTRACE\", \"0\")\n217\t        .output()\n218\t        .expect(\"spawn child\");\n219\t    let stdout = String::from_utf8_lossy(&out.stdout).into_owned();\n220\t    let lines: Vec<String> = stdout\n221\t        .lines()\n222\t        .filter(|l| l.starts_with(\"@@\"))\n223\t        .map(|l| l[2..].to_string())\n224\t        .collect();\n225\t    Transcript {\n226\t        exit: out.status.code(),\n227\t        signal: out.status.code().is_none(),\n228\t        lines,\n229\t    }\n230\t}\n231\t\n232\t/// Run `case` against both libraries and assert the transcripts are identical.\n233\t#[track_caller]\n234\tpub fn diff_case(case: &str) {\n235\t    let c = run_child(case, \"c\");\n236\t    let r = run_child(case, \"rs\");\n237\t    if c != r {\n238\t        panic!(\n239\t            \"ERROR-PATH MISMATCH for case {case:?}\\n  C   : exit={:?} lines={:#?}\\n  RUST: exit={:?} lines={:#?}\",\n240\t            c.exit, c.lines, r.exit, r.lines\n241\t        );\n242\t    }\n243\t    // A crash in *both* means the case is not a real rejection but C-level UB;\n244\t    // make that loud rather than silently \"passing\".\n245\t    assert!(\n246\t        !c.signal,\n247\t        \"case {case:?} crashed (signal) in BOTH libraries - not a valid rejection test\"\n248\t    );\n249\t}\n25