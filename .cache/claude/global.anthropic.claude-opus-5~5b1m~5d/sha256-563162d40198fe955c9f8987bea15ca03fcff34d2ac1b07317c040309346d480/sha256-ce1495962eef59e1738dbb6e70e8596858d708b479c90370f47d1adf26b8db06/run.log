{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Tk3Pn7DfGBSQWcfMPhCQgL","type":"tool_result","content":"1\t//! Helpers to synthesise PNG byte streams (valid and deliberately invalid) so\n2\t//! that the read side of both libraries can be driven with identical input.\n3\t#![allow(dead_code)]\n4\t\n5\tpub const PNG_SIG: [u8; 8] = [0x89, b'P', b'N', b'G', 0x0d, 0x0a, 0x1a, 0x0a];\n6\t\n7\t// ---------------------------------------------------------------------------\n8\t// CRC-32 (the PNG/zlib polynomial)\n9\t// ---------------------------------------------------------------------------\n10\t\n11\tfn crc_table() -> &'static [u32; 256] {\n12\t    use std::sync::OnceLock;\n13\t    static T: OnceLock<[u32; 256]> = OnceLock::new();\n14\t    T.get_or_init(|| {\n15\t        let mut t = [0u32; 256];\n16\t        for n in 0..256u32 {\n17\t            let mut c = n;\n18\t            for _ in 0..8 {\n19\t                c = if c & 1 != 0 { 0xedb8_8320 ^ (c >> 1) } else { c >> 1 };\n20\t            }\n21\t            t[n as usize] = c;\n22\t        }\n23\t        t\n24\t    })\n25\t}\n26\t\n27\tpub fn crc32(data: &[u8]) -> u32 {\n28\t    let t = crc_table();\n29\t    let mut c = 0xffff_ffffu32;\n30\t    for &b in data {\n31\t        c = t[((c ^ b as u32) & 0xff) as usize] ^ (c >> 8);\n32\t    }\n33\t    c ^ 0xffff_ffff\n34\t}\n35\t\n36\tpub fn adler32(data: &[u8]) -> u32 {\n37\t    let mut a: u32 = 1;\n38\t    let mut b: u32 = 0;\n39\t    for &x in data {\n40\t        a = (a + x as u32) % 65521;\n41\t        b = (b + a) % 65521;\n42\t    }\n43\t    (b << 16) | a\n44\t}\n45\t\n46\t// ---------------------------------------------------------------------------\n47\t// Chunk / stream assembly\n48\t// ---------------------------------------------------------------------------\n49\t\n50\tpub fn be32(v: u32) -> [u8; 4] {\n51\t    v.to_be_bytes()\n52\t}\n53\t\n54\t/// Append a well-formed chunk (correct length + CRC).\n55\tpub fn push_chunk(out: &mut Vec<u8>, name: &[u8; 4], data: &[u8]) {\n56\t    out.extend_from_slice(&be32(data.len() as u32));\n57\t    out.extend_from_slice(name);\n58\t    out.extend_from_slice(data);\n59\t    let mut crc_in = Vec::with_capacity(4 + data.len());\n60\t    crc_in.extend_from_slice(name);\n61\t    crc_in.extend_from_slice(data);\n62\t    out.extend_from_slice(&be32(crc32(&crc_in)));\n63\t}\n64\t\n65\t/// Append a chunk with an arbitrary (possibly wrong) declared length and CRC.\n66\tpub fn push_chunk_raw(out: &mut Vec<u8>, len: u32, name: &[u8; 4], data: &[u8], crc: u32) {\n67\t    out.extend_from_slice(&be32(len));\n68\t    out.extend_from_slice(name);\n69\t    out.extend_from_slice(data);\n70\t    out.extend_from_slice(&be32(crc));\n71\t}\n72\t\n73\t/// Append a chunk whose CRC is deliberately corrupted.\n74\tpub fn push_chunk_bad_crc(out: &mut Vec<u8>, name: &[u8; 4], data: &[u8]) {\n75\t    let mut crc_in = Vec::with_capacity(4 + data.len());\n76\t    crc_in.extend_from_slice(name);\n77\t    crc_in.extend_from_slice(data);\n78\t    let crc = crc32(&crc_in) ^ 0xffff_ffff;\n79\t    push_chunk_raw(out, data.len() as u32, name, data, crc);\n80\t}\n81\t\n82\tpub fn ihdr_data(\n83\t    width: u32,\n84\t    height: u32,\n85\t    bit_depth: u8,\n86\t    color_type: u8,\n87\t    compression: u8,\n88\t    filter: u8,\n89\t    interlace: u8,\n90\t) -> Vec<u8> {\n91\t    let mut d = Vec::with_capacity(13);\n92\t    d.extend_from_slice(&be32(width));\n93\t    d.extend_from_slice(&be32(height));\n94\t    d.push(bit_depth);\n95\t    d.push(color_type);\n96\t    d.push(compression);\n97\t    d.push(filter);\n98\t    d.push(interlace);\n99\t    d\n100\t}\n101\t\n102\t// ---------------------------------------------------------------------------\n103\t// A minimal \"store\"-mode DEFLATE encoder, so the tests need no zlib of their\n104\t// own and the IDAT payload is fully deterministic.\n105\t// ---------------------------------------------------------------------------\n106\t\n107\tpub fn zlib_store(raw: &[u8]) -> Vec<u8> {\n108\t    let mut out = Vec::with_capacity(raw.len() + raw.len() / 65535 * 5 + 11);\n109\t    out.push(0x78); // CM=8, CINFO=7\n110\t    out.push(0x01); // FLEVEL=0, FCHECK so that (0x78<<8|0x01) % 31 == 0\n111\t    if raw.is_empty() {\n112\t        out.push(0x01);\n113\t        out.extend_from_slice(&[0x00, 0x00, 0xff, 0xff]);\n114\t    } else {\n115\t        let mut i = 0usize;\n116\t        while i < raw.len() {\n117\t            let n = (raw.len() - i).min(65535);\n118\t            let last = if i + n == raw.len() { 1u8 } else { 0u8 };\n119\t            out.push(last);\n120\t            out.extend_from_slice(&(n as u16).to_le_bytes());\n121\t            out.extend_from_slice(&(!(n as u16)).to_le_bytes());\n122\t            out.extend_from_slice(&raw[i..i + n]);\n123\t            i += n;\n124\t        }\n125\t    }\n126\t    out.extend_from_slice(&adler32(raw).to_be_bytes());\n127\t    out\n128\t}\n129\t\n130\t// ---------------------------------------------------------------------------\n131\t// Row geometry\n132\t// ---------------------------------------------------------------------------\n133\t\n134\tpub fn channels_of(color_type: u8) -> u32 {\n135\t    match color_type {\n136\t        0 => 1,\n137\t        2 => 3,\n138\t        3 => 1,\n139\t        4 => 2,\n140\t        6 => 4,\n141\t        _ => 1,\n142\t    }\n143\t}\n144\t\n145\tpub fn pixel_depth(bit_depth: u8, color_type: u8) -> u32 {\n146\t    bit_depth as u32 * channels_of(color_type)\n147\t}\n148\t\n149\tpub fn rowbytes(bit_depth: u8, color_type: u8, width: u32) -> usize {\n150\t    let pd = pixel_depth(bit_depth, color_type) as u64;\n151\t    (((width as u64 * pd) + 7) >> 3) as usize\n152\t}\n153\t\n154\t/// Adam7 pass geometry: (xstart, ystart, xstep, ystep)\n155\tpub const ADAM7: [(u32, u32, u32, u32); 7] = [\n156\t    (0, 0, 8, 8),\n157\t    (4, 0, 8, 8),\n158\t    (0, 4, 4, 8),\n159\t    (2, 0, 4, 4),\n160\t    (0, 2, 2, 4),\n161\t    (1, 0, 2, 2),\n162\t    (0, 1, 1, 2),\n163\t];\n164\t\n165\tpub fn pass_width(width: u32, pass: usize) -> u32 {\n166\t    let (xs, _, xt, _) = ADAM7[pass];\n167\t    if width <= xs {\n168\t        0\n169\t    } else {\n170\t        (width - xs + xt - 1) / xt\n171\t    }\n172\t}\n173\t\n174\tpub fn pass_height(height: u32, pass: usize) -> u32 {\n175\t    let (_, ys, _, yt) = ADAM7[pass];\n176\t    if height <= ys {\n177\t        0\n178\t    } else {\n179\t        (height - ys + yt - 1) / yt\n180\t    }\n181\t}\n182\t\n183\t/// Build the raw (filter-byte prefixed, filter type 0 = None) scan-line data\n184\t/// for a non-interlaced image whose pixel bytes come from `gen`.\n185\tpub fn raw_rows_none(\n186\t    width: u32,\n187\t    height: u32,\n188\t    bit_depth: u8,\n189\t    color_type: u8,\n190\t    gen: &mut dyn FnMut(u32, usize) -> Vec<u8>,\n191\t) -> Vec<u8> {\n192\t    let rb = rowbytes(bit_depth, color_type, width);\n193\t    let mut out = Vec::with_capacity(height as usize * (rb + 1));\n194\t    for y in 0..height {\n195\t        out.push(0); // filter: None\n196\t        let mut row = gen(y, rb);\n197\t        row.resize(rb, 0);\n198\t        // zero the unused low bits of the final byte, as libpng writes them\n199\t        if rb > 0 {\n200\t            let pd = pixel_depth(bit_depth, color_type);\n201\t            if pd < 8 {\n202\t                let used = (width * pd) % 8;\n203\t                if used != 0 {\n204\t                    let mask = 0xffu8 << (8 - used);\n205\t                    let last = rb - 1;\n206\t                    row[last] &= mask;\n207\t                }\n208\t            }\n209\t        }\n210\t        out.extend_from_slice(&row);\n211\t    }\n212\t    out\n213\t}\n214\t\n215\t/// Interlaced (Adam7) equivalent of `raw_rows_none`.\n216\tpub fn raw_rows_adam7(\n217\t    width: u32,\n218\t    height: u32,\n219\t    bit_depth: u8,\n220\t    color_type: u8,\n221\t    gen: &mut dyn FnMut(usize, u32, usize) -> Vec<u8>,\n222\t) -> Vec<u8> {\n223\t    let mut out = Vec::new();\n224\t    let pd = pixel_depth(bit_depth, color_type);\n225\t    for pass in 0..7 {\n226\t        let pw = pass_width(width, pass);\n227\t        let ph = pass_height(height, pass);\n228\t        if pw == 0 || ph == 0 {\n229\t            continue;\n230\t        }\n231\t        let rb = rowbytes(bit_depth, color_type, pw);\n232\t        for y in 0..ph {\n233\t            out.push(0);\n234\t            let mut row = gen(pass, y, rb);\n235\t            row.resize(rb, 0);\n236\t            if pd < 8 && rb > 0 {\n237\t                let used = (pw * pd) % 8;\n238\t                if used != 0 {\n239\t                    let mask = 0xffu8 << (8 - used);\n240\t                    let last = rb - 1;\n241\t                    row[last] &= mask;\n242\t                }\n243\t            }\n244\t            out.extend_from_slice(&row);\n245\t        }\n246\t    }\n247\t    out\n248\t}\n249\t\n250\t// ---------------------------------------------------------------------------\n251\t// Complete images\n252\t// ---------------------------------------------------------------------------\n253\t\n254\tpub struct PngSpec {\n255\t    pub width: u32,\n256\t    pub height: u32,\n257\t    pub bit_depth: u8,\n258\t    pub color_type: u8,\n259\t    pub interlace: u8,\n260\t    /// PLTE entries (RGB triples), required for colour type 3.\n261\t    pub palette: Vec<u8>,\n262\t    /// tRNS chunk payload, if any.\n263\t    pub trns: Option<Vec<u8>>,\n264\t    /// extra chunks placed before IDAT, in order\n265\t    pub pre_idat: Vec<([u8; 4], Vec<u8>)>,\n266\t    /// extra chunks placed after IDAT, in order\n267\t    pub post_idat: Vec<([u8; 4], Vec<u8>)>,\n268\t    /// raw (unfiltered, filter-byte prefixed) image data\n269\t    pub raw: Vec<u8>,\n270\t    /// split the IDAT payload into this many chunks (>=1)\n271\t    pub idat_chunks: usize,\n272\t}\n273\t\n274\timpl PngSpec {\n275\t    pub fn new(width: u32, height: u32, bit_depth: u8, color_type: u8, interlace: u8) -> Self {\n276\t        PngSpec {\n277\t            width,\n278\t            height,\n279\t            bit_depth,\n280\t            color_type,\n281\t            interlace,\n282\t            palette: Vec::new(),\n283\t            trns: None,\n284\t            pre_idat: Vec::new(),\n285\t            post_idat: Vec::new(),\n286\t            raw: Vec::new(),\n287\t            idat_chunks: 1,\n288\t        }\n289\t    }\n290\t\n291\t    pub fn build(&self) -> Vec<u8> {\n292\t        let mut out = Vec::new();\n293\t        out.extend_from_slice(&PNG_SIG);\n294\t        push_chunk(\n295\t            &mut out,\n296\t            b\"IHDR\",\n297\t            &ihdr_data(\n298\t                self.width,\n299\t                self.height,\n300\t                self.bit_depth,\n301\t                self.color_type,\n302\t                0,\n303\t                0,\n304\t                self.interlace,\n305\t            ),\n306\t        );\n307\t        if !self.palette.is_empty() {\n308\t            push_chunk(&mut out, b\"PLTE\", &self.palette);\n309\t        }\n310\t        if let Some(t) = &self.trns {\n311\t            push_chunk(&mut out, b\"tRNS\", t);\n312\t        }\n313\t        for (n, d) in &self.pre_idat {\n314\t            push_chunk(&mut out, n, d);\n315\t        }\n316\t        let z = zlib_store(&self.raw);\n317\t        let nch = self.idat_chunks.max(1);\n318\t        let per = (z.len() + nch - 1) / nch.max(1);\n319\t        if z.is_empty() {\n320\t            push_chunk(&mut out, b\"IDAT\", &[]);\n321\t        } else {\n322\t            let mut i = 0;\n323\t            while i < z.len() {\n324\t                let n = per.max(1).min(z.len() - i);\n325\t                push_chunk(&mut out, b\"IDAT\", &z[i..i + n]);\n326\t                i += n;\n327\t            }\n328\t        }\n329\t        for (n, d) in &self.post_idat {\n330\t            push_chunk(&mut out, n, d);\n331\t        }\n332\t        push_chunk(&mut out, b\"IEND\", &[]);\n333\t        out\n334\t    }\n335\t}\n336\t\n337\t/// Deterministic, fully valid PNG of the given geometry.\n338\tpub fn make_png(\n339\t    seed: u64,\n340\t    width: u32,\n341\t    height: u32,\n342\t    bit_depth: u8,\n343\t    color_type: u8,\n344\t    interlace: u8,\n345\t) -> Vec<u8> {\n346\t    let mut rng = super::Rng::new(seed);\n347\t    let mut spec = PngSpec::new(width, height, bit_depth, color_type, interlace);\n348\t    if color_type == 3 {\n349\t        let n = 1usize << bit_depth.min(8);\n350\t        let n = n.min(256);\n351\t        spec.palette = (0..n * 3).map(|_| rng.next_u8()).collect();\n352\t    }\n353\t    spec.raw = if interlace == 1 {\n354\t        let mut r2 = super::Rng::new(seed ^ 0xabcd);\n355\t        raw_rows_adam7(width, height, bit_depth, color_type, &mut |_p, _y, rb| {\n356\t            (0..rb).map(|_| r2.next_u8()).collect()\n357\t        })\n358\t    } else {\n359\t        let mut r2 = super::Rng::new(seed ^ 0xabcd);\n360\t        raw_rows_none(width, height, bit_depth, color_type, &mut |_y, rb| {\n361\t            (0..rb).map(|_| r2.next_u8()).collect()\n362\t        })\n363\t    };\n364\t    spec.build()\n365\t}\n366\t"}]},"parent_tool_use_id":"toolu_bdrk_012CPpz7bU3bkntXCbBPR1Mq","session_id":"d61bc42a-4e8d-424f-b737-52a7165119c7","uuid":"e6caef30-b43b-4f36-bc09-b85ca12ff020","timestamp":"2026-09-04T03:52:40.670Z","subagent_type":"general-purpose","task_description":"Write simplified API tests"}
