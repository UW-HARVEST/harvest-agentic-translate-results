{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01RyuUub8LkVQJTRSC7PGWzi","type":"tool_result","content":"1\t//! Shared differential-test harness.\n2\t//!\n3\t//! Loads BOTH shared libraries through `libloading`:\n4\t//!   * the reference C build  `c_src/build/libpng.so`\n5\t//!   * the Rust translation   `translation/target/<profile>/liblibpng.so`\n6\t//!\n7\t//! Nothing in the Rust crate is ever called directly — every call goes through\n8\t//! the `.so` export table, exactly as an external C consumer would do, so the\n9\t//! `#[no_mangle] extern \"C\"` wrappers are part of what is under test.\n10\t#![allow(dead_code)]\n11\t#![allow(non_camel_case_types)]\n12\t#![allow(non_snake_case)]\n13\t#![allow(non_upper_case_globals)]\n14\t\n15\tpub mod api;\n16\tpub mod harness;\n17\tpub mod pngbuild;\n18\t\n19\tuse libloading::{Library, Symbol};\n20\tuse std::ffi::{c_char, c_double, c_int, c_long, c_uint, c_ulong, c_void};\n21\tuse std::path::PathBuf;\n22\tuse std::sync::OnceLock;\n23\t\n24\t// ---------------------------------------------------------------------------\n25\t// libpng public types (repr(C) mirrors of png.h)\n26\t// ---------------------------------------------------------------------------\n27\t\n28\tpub type png_byte = u8;\n29\tpub type png_uint_32 = u32;\n30\tpub type png_int_32 = i32;\n31\tpub type png_uint_16 = u16;\n32\tpub type png_int_16 = i16;\n33\tpub type png_fixed_point = i32;\n34\tpub type png_size_t = usize;\n35\tpub type png_alloc_size_t = usize;\n36\tpub type png_structp = *mut c_void;\n37\tpub type png_infop = *mut c_void;\n38\tpub type png_bytep = *mut png_byte;\n39\tpub type png_const_bytep = *const png_byte;\n40\tpub type png_charp = *mut c_char;\n41\tpub type png_const_charp = *const c_char;\n42\tpub type png_voidp = *mut c_void;\n43\t\n44\t#[repr(C)]\n45\t#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]\n46\tpub struct png_color {\n47\t    pub red: png_byte,\n48\t    pub green: png_byte,\n49\t    pub blue: png_byte,\n50\t}\n51\t\n52\t#[repr(C)]\n53\t#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]\n54\tpub struct png_color_8 {\n55\t    pub red: png_byte,\n56\t    pub green: png_byte,\n57\t    pub blue: png_byte,\n58\t    pub gray: png_byte,\n59\t    pub alpha: png_byte,\n60\t}\n61\t\n62\t#[repr(C)]\n63\t#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]\n64\tpub struct png_color_16 {\n65\t    pub index: png_byte,\n66\t    pub red: png_uint_16,\n67\t    pub green: png_uint_16,\n68\t    pub blue: png_uint_16,\n69\t    pub gray: png_uint_16,\n70\t}\n71\t\n72\t#[repr(C)]\n73\t#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]\n74\tpub struct png_sPLT_entry {\n75\t    pub red: png_uint_16,\n76\t    pub green: png_uint_16,\n77\t    pub blue: png_uint_16,\n78\t    pub alpha: png_uint_16,\n79\t    pub frequency: png_uint_16,\n80\t}\n81\t\n82\t#[repr(C)]\n83\t#[derive(Clone, Copy, Debug)]\n84\tpub struct png_sPLT_t {\n85\t    pub name: png_charp,\n86\t    pub depth: png_byte,\n87\t    pub entries: *mut png_sPLT_entry,\n88\t    pub nentries: png_int_32,\n89\t}\n90\t\n91\t#[repr(C)]\n92\t#[derive(Clone, Copy, Debug)]\n93\tpub struct png_text {\n94\t    pub compression: c_int,\n95\t    pub key: png_charp,\n96\t    pub text: png_charp,\n97\t    pub text_length: usize,\n98\t    pub itxt_length: usize,\n99\t    pub lang: png_charp,\n100\t    pub lang_key: png_charp,\n101\t}\n102\t\n103\t#[repr(C)]\n104\t#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]\n105\tpub struct png_time {\n106\t    pub year: png_uint_16,\n107\t    pub month: png_byte,\n108\t    pub day: png_byte,\n109\t    pub hour: png_byte,\n110\t    pub minute: png_byte,\n111\t    pub second: png_byte,\n112\t}\n113\t\n114\t#[repr(C)]\n115\t#[derive(Clone, Copy, Debug)]\n116\tpub struct png_unknown_chunk {\n117\t    pub name: [png_byte; 5],\n118\t    pub data: *mut png_byte,\n119\t    pub size: usize,\n120\t    pub location: png_byte,\n121\t}\n122\t\n123\t/// `png_image` from png.h — the simplified API entry structure.\n124\t#[repr(C)]\n125\t#[derive(Clone, Copy)]\n126\tpub struct png_image {\n127\t    pub opaque: *mut c_void,\n128\t    pub version: png_uint_32,\n129\t    pub width: png_uint_32,\n130\t    pub height: png_uint_32,\n131\t    pub format: png_uint_32,\n132\t    pub flags: png_uint_32,\n133\t    pub colormap_entries: png_uint_32,\n134\t    pub warning_or_error: png_uint_32,\n135\t    pub message: [c_char; 64],\n136\t}\n137\t\n138\timpl Default for png_image {\n139\t    fn default() -> Self {\n140\t        png_image {\n141\t            opaque: std::ptr::null_mut(),\n142\t            version: PNG_IMAGE_VERSION,\n143\t            width: 0,\n144\t            height: 0,\n145\t            format: 0,\n146\t            flags: 0,\n147\t            colormap_entries: 0,\n148\t            warning_or_error: 0,\n149\t            message: [0; 64],\n150\t        }\n151\t    }\n152\t}\n153\t\n154\timpl png_image {\n155\t    pub fn msg(&self) -> String {\n156\t        let b: Vec<u8> = self\n157\t            .message\n158\t            .iter()\n159\t            .take_while(|c| **c != 0)\n160\t            .map(|c| *c as u8)\n161\t            .collect();\n162\t        String::from_utf8_lossy(&b).into_owned()\n163\t    }\n164\t    /// Everything except `opaque` (which is an allocation address and therefore\n165\t    /// legitimately differs between the two libraries).\n166\t    pub fn cmp_tuple(&self) -> (u32, u32, u32, u32, u32, u32, u32, String) {\n167\t        (\n168\t            self.version,\n169\t            self.width,\n170\t            self.height,\n171\t            self.format,\n172\t            self.flags,\n173\t            self.colormap_entries,\n174\t            self.warning_or_error,\n175\t            self.msg(),\n176\t        )\n177\t    }\n178\t}\n179\t\n180\timpl std::fmt::Debug for png_image {\n181\t    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n182\t        f.debug_struct(\"png_image\")\n183\t            .field(\"version\", &self.version)\n184\t            .field(\"width\", &self.width)\n185\t            .field(\"height\", &self.height)\n186\t            .field(\"format\", &format_args!(\"0x{:x}\", self.format))\n187\t            .field(\"flags\", &self.flags)\n188\t            .field(\"colormap_entries\", &self.colormap_entries)\n189\t            .field(\"warning_or_error\", &self.warning_or_error)\n190\t            .field(\"message\", &self.msg())\n191\t            .finish()\n192\t    }\n193\t}\n194\t\n195\t// ---------------------------------------------------------------------------\n196\t// Constants from png.h / pngconf.h\n197\t// ---------------------------------------------------------------------------\n198\t\n199\tpub const PNG_LIBPNG_VER_STRING: &[u8] = b\"1.6.59.git\\0\";\n200\tpub const PNG_IMAGE_VERSION: png_uint_32 = 1;\n201\tpub const PNG_IMAGE_WARNING: png_uint_32 = 1;\n202\tpub const PNG_IMAGE_ERROR: png_uint_32 = 2;\n203\t\n204\tpub const PNG_COLOR_MASK_PALETTE: c_int = 1;\n205\tpub const PNG_COLOR_MASK_COLOR: c_int = 2;\n206\tpub const PNG_COLOR_MASK_ALPHA: c_int = 4;\n207\tpub const PNG_COLOR_TYPE_GRAY: c_int = 0;\n208\tpub const PNG_COLOR_TYPE_PALETTE: c_int = 3;\n209\tpub const PNG_COLOR_TYPE_RGB: c_int = 2;\n210\tpub const PNG_COLOR_TYPE_RGB_ALPHA: c_int = 6;\n211\tpub const PNG_COLOR_TYPE_GRAY_ALPHA: c_int = 4;\n212\t\n213\tpub const PNG_COMPRESSION_TYPE_BASE: c_int = 0;\n214\tpub const PNG_FILTER_TYPE_BASE: c_int = 0;\n215\tpub const PNG_INTRAPIXEL_DIFFERENCING: c_int = 64;\n216\tpub const PNG_INTERLACE_NONE: c_int = 0;\n217\tpub const PNG_INTERLACE_ADAM7: c_int = 1;\n218\t\n219\tpub const PNG_NO_FILTERS: c_int = 0x00;\n220\tpub const PNG_FILTER_NONE: c_int = 0x08;\n221\tpub const PNG_FILTER_SUB: c_int = 0x10;\n222\tpub const PNG_FILTER_UP: c_int = 0x20;\n223\tpub const PNG_FILTER_AVG: c_int = 0x40;\n224\tpub const PNG_FILTER_PAETH: c_int = 0x80;\n225\tpub const PNG_ALL_FILTERS: c_int = 0xf8;\n226\t\n227\tpub const PNG_FILTER_VALUE_NONE: c_int = 0;\n228\tpub const PNG_FILTER_VALUE_SUB: c_int = 1;\n229\tpub const PNG_FILTER_VALUE_UP: c_int = 2;\n230\tpub const PNG_FILTER_VALUE_AVG: c_int = 3;\n231\tpub const PNG_FILTER_VALUE_PAETH: c_int = 4;\n232\tpub const PNG_FILTER_VALUE_LAST: c_int = 5;\n233\t\n234\tpub const PNG_INFO_gAMA: png_uint_32 = 0x0001;\n235\tpub const PNG_INFO_sBIT: png_uint_32 = 0x0002;\n236\tpub const PNG_INFO_cHRM: png_uint_32 = 0x0004;\n237\tpub const PNG_INFO_PLTE: png_uint_32 = 0x0008;\n238\tpub const PNG_INFO_tRNS: png_uint_32 = 0x0010;\n239\tpub const PNG_INFO_bKGD: png_uint_32 = 0x0020;\n240\tpub const PNG_INFO_hIST: png_uint_32 = 0x0040;\n241\tpub const PNG_INFO_pHYs: png_uint_32 = 0x0080;\n242\tpub const PNG_INFO_oFFs: png_uint_32 = 0x0100;\n243\tpub const PNG_INFO_tIME: png_uint_32 = 0x0200;\n244\tpub const PNG_INFO_pCAL: png_uint_32 = 0x0400;\n245\tpub const PNG_INFO_sRGB: png_uint_32 = 0x0800;\n246\tpub const PNG_INFO_iCCP: png_uint_32 = 0x1000;\n247\tpub const PNG_INFO_sPLT: png_uint_32 = 0x2000;\n248\tpub const PNG_INFO_sCAL: png_uint_32 = 0x4000;\n249\tpub const PNG_INFO_IDAT: png_uint_32 = 0x8000;\n250\tpub const PNG_INFO_eXIf: png_uint_32 = 0x10000;\n251\tpub const PNG_INFO_cICP: png_uint_32 = 0x20000;\n252\tpub const PNG_INFO_cLLI: png_uint_32 = 0x40000;\n253\tpub const PNG_INFO_mDCV: png_uint_32 = 0x80000;\n254\t\n255\tpub const PNG_TRANSFORM_IDENTITY: c_int = 0x0000;\n256\tpub const PNG_TRANSFORM_STRIP_16: c_int = 0x0001;\n257\tpub const PNG_TRANSFORM_STRIP_ALPHA: c_int = 0x0002;\n258\tpub const PNG_TRANSFORM_PACKING: c_int = 0x0004;\n259\tpub const PNG_TRANSFORM_PACKSWAP: c_int = 0x0008;\n260\tpub const PNG_TRANSFORM_EXPAND: c_int = 0x0010;\n261\tpub const PNG_TRANSFORM_INVERT_MONO: c_int = 0x0020;\n262\tpub const PNG_TRANSFORM_SHIFT: c_int = 0x0040;\n263\tpub const PNG_TRANSFORM_BGR: c_int = 0x0080;\n264\tpub const PNG_TRANSFORM_SWAP_ALPHA: c_int = 0x0100;\n265\tpub const PNG_TRANSFORM_SWAP_ENDIAN: c_int = 0x0200;\n266\tpub const PNG_TRANSFORM_INVERT_ALPHA: c_int = 0x0400;\n267\tpub const PNG_TRANSFORM_STRIP_FILLER: c_int = 0x0800;\n268\tpub const PNG_TRANSFORM_STRIP_FILLER_BEFORE: c_int = 0x0800;\n269\tpub const PNG_TRANSFORM_STRIP_FILLER_AFTER: c_int = 0x1000;\n270\tpub const PNG_TRANSFORM_GRAY_TO_RGB: c_int = 0x2000;\n271\tpub const PNG_TRANSFORM_EXPAND_16: c_int = 0x4000;\n272\tpub const PNG_TRANSFORM_SCALE_16: c_int = 0x8000;\n273\t\n274\tpub const PNG_FILLER_BEFORE: c_int = 0;\n275\tpub const PNG_FILLER_AFTER: c_int = 1;\n276\t\n277\tpub const PNG_BACKGROUND_GAMMA_UNKNOWN: c_int = 0;\n278\tpub const PNG_BACKGROUND_GAMMA_SCREEN: c_int = 1;\n279\tpub const PNG_BACKGROUND_GAMMA_FILE: c_int = 2;\n280\tpub const PNG_BACKGROUND_GAMMA_UNIQUE: c_int = 3;\n281\t\n282\tpub const PNG_ALPHA_PNG: c_int = 0;\n283\tpub const PNG_ALPHA_STANDARD: c_int = 1;\n284\tpub const PNG_ALPHA_ASSOCIATED: c_int = 1;\n285\tpub const PNG_ALPHA_OPTIMIZED: c_int = 2;\n286\tpub const PNG_ALPHA_BROKEN: c_int = 3;\n287\t\n288\tpub const PNG_DEFAULT_sRGB: png_fixed_point = -1;\n289\tpub const PNG_GAMMA_MAC_18: png_fixed_point = -2;\n290\t\n291\tpub const PNG_CRC_DEFAULT: c_int = 0;\n292\tpub const PNG_CRC_ERROR_QUIT: c_int = 1;\n293\tpub const PNG_CRC_WARN_DISCARD: c_int = 2;\n294\tpub const PNG_CRC_WARN_USE: c_int = 3;\n295\tpub const PNG_CRC_QUIET_USE: c_int = 4;\n296\tpub const PNG_CRC_NO_CHANGE: c_int = 5;\n297\t\n298\tpub const PNG_HANDLE_CHUNK_AS_DEFAULT: c_int = 0;\n299\tpub const PNG_HANDLE_CHUNK_NEVER: c_int = 1;\n300\tpub const PNG_HANDLE_CHUNK_IF_SAFE: c_int = 2;\n301\tpub const PNG_HANDLE_CHUNK_ALWAYS: c_int = 3;\n302\tpub const PNG_HANDLE_CHUNK_LAST: c_int = 4;\n303\t\n304\tpub const PNG_OPTION_INVALID: c_int = 1;\n305\tpub const PNG_OPTION_OFF: c_int = 2;\n306\tpub const PNG_OPTION_ON: c_int = 3;\n307\tpub const PNG_MAXIMUM_INFLATE_WINDOW: c_int = 2;\n308\tpub const PNG_SKIP_sRGB_CHECK_PROFILE: c_int = 4;\n309\tpub const PNG_IGNORE_ADLER32: c_int = 8;\n310\tpub const PNG_OPTION_NEXT: c_int = 10;\n311\t\n312\tpub const PNG_IO_NONE: png_uint_32 = 0x0000;\n313\tpub const PNG_IO_READING: png_uint_32 = 0x0001;\n314\tpub const PNG_IO_WRITING: png_uint_32 = 0x0002;\n315\tpub const PNG_IO_SIGNATURE: png_uint_32 = 0x0010;\n316\tpub const PNG_IO_CHUNK_HDR: png_uint_32 = 0x0020;\n317\tpub const PNG_IO_CHUNK_DATA: png_uint_32 = 0x0040;\n318\tpub const PNG_IO_CHUNK_CRC: png_uint_32 = 0x0080;\n319\t\n320\tpub const PNG_TEXT_COMPRESSION_NONE_WR: c_int = -3;\n321\tpub const PNG_TEXT_COMPRESSION_zTXt_WR: c_int = -2;\n322\tpub const PNG_TEXT_COMPRESSION_NONE: c_int = -1;\n323\tpub const PNG_TEXT_COMPRESSION_zTXt: c_int = 0;\n324\tpub const PNG_ITXT_COMPRESSION_NONE: c_int = 1;\n325\tpub const PNG_ITXT_COMPRESSION_zTXt: c_int = 2;\n326\t\n327\tpub const PNG_RESOLUTION_UNKNOWN: c_int = 0;\n328\tpub const PNG_RESOLUTION_METER: c_int = 1;\n329\tpub const PNG_OFFSET_PIXEL: c_int = 0;\n330\tpub const PNG_OFFSET_MICROMETER: c_int = 1;\n331\tpub const PNG_SCALE_UNKNOWN: c_int = 0;\n332\tpub const PNG_SCALE_METER: c_int = 1;\n333\tpub const PNG_SCALE_RADIAN: c_int = 2;\n334\tpub const PNG_EQUATION_LINEAR: c_int = 0;\n335\tpub const PNG_EQUATION_BASE_E: c_int = 1;\n336\tpub const PNG_EQUATION_ARBITRARY: c_int = 2;\n337\tpub const PNG_EQUATION_HYPERBOLIC: c_int = 3;\n338\tpub const PNG_EQUATION_LAST: c_int = 4;\n339\t\n340\tpub const PNG_sRGB_INTENT_PERCEPTUAL: c_int = 0;\n341\tpub const PNG_sRGB_INTENT_RELATIVE: c_int = 1;\n342\tpub const PNG_sRGB_INTENT_SATURATION: c_int = 2;\n343\tpub const PNG_sRGB_INTENT_ABSOLUTE: c_int = 3;\n344\tpub const PNG_sRGB_INTENT_LAST: c_int = 4;\n345\t\n346\tpub const PNG_FLAG_MNG_EMPTY_PLTE: c_int = 0x01;\n347\tpub const PNG_FLAG_MNG_FILTER_64: c_int = 0x04;\n348\tpub const PNG_ALL_MNG_FEATURES: c_int = 0x05;\n349\t\n350\tpub const PNG_UINT_31_MAX: png_uint_32 = 0x7fff_ffff;\n351\tpub const PNG_UINT_32_MAX: png_uint_32 = u32::MAX;\n352\t\n353\t// simplified-API formats\n354\tpub const PNG_FORMAT_FLAG_ALPHA: png_uint_32 = 0x01;\n355\tpub const PNG_FORMAT_FLAG_COLOR: png_uint_32 = 0x02;\n356\tpub const PNG_FORMAT_FLAG_LINEAR: png_uint_32 = 0x04;\n357\tpub const PNG_FORMAT_FLAG_COLORMAP: png_uint_32 = 0x08;\n358\tpub const PNG_FORMAT_FLAG_BGR: png_uint_32 = 0x10;\n359\tpub const PNG_FORMAT_FLAG_AFIRST: png_uint_32 = 0x20;\n360\tpub const PNG_FORMAT_FLAG_ASSOCIATED_ALPHA: png_uint_32 = 0x40;\n361\t\n362\tpub const PNG_FORMAT_GRAY: png_uint_32 = 0;\n363\tpub const PNG_FORMAT_GA: png_uint_32 = PNG_FORMAT_FLAG_ALPHA;\n364\tpub const PNG_FORMAT_AG: png_uint_32 = PNG_FORMAT_GA | PNG_FORMAT_FLAG_AFIRST;\n365\tpub const PNG_FORMAT_RGB: png_uint_32 = PNG_FORMAT_FLAG_COLOR;\n366\tpub const PNG_FORMAT_BGR: png_uint_32 = PNG_FORMAT_FLAG_COLOR | PNG_FORMAT_FLAG_BGR;\n367\tpub const PNG_FORMAT_RGBA: png_uint_32 = PNG_FORMAT_RGB | PNG_FORMAT_FLAG_ALPHA;\n368\tpub const PNG_FORMAT_ARGB: png_uint_32 = PNG_FORMAT_RGBA | PNG_FORMAT_FLAG_AFIRST;\n369\tpub const PNG_FORMAT_BGRA: png_uint_32 = PNG_FORMAT_BGR | PNG_FORMAT_FLAG_ALPHA;\n370\tpub const PNG_FORMAT_ABGR: png_uint_32 = PNG_FORMAT_BGRA | PNG_FORMAT_FLAG_AFIRST;\n371\tpub const PNG_FORMAT_LINEAR_Y: png_uint_32 = PNG_FORMAT_FLAG_LINEAR;\n372\tpub const PNG_FORMAT_LINEAR_Y_ALPHA: png_uint_32 =\n373\t    PNG_FORMAT_FLAG_LINEAR | PNG_FORMAT_FLAG_ALPHA;\n374\tpub const PNG_FORMAT_LINEAR_RGB: png_uint_32 = PNG_FORMAT_FLAG_LINEAR | PNG_FORMAT_FLAG_COLOR;\n375\tpub const PNG_FORMAT_LINEAR_RGB_ALPHA: png_uint_32 =\n376\t    PNG_FORMAT_FLAG_LINEAR | PNG_FORMAT_FLAG_COLOR | PNG_FORMAT_FLAG_ALPHA;\n377\tpub const PNG_FORMAT_RGB_COLORMAP: png_uint_32 = PNG_FORMAT_RGB | PNG_FORMAT_FLAG_COLORMAP;\n378\tpub const PNG_FORMAT_BGR_COLORMAP: png_uint_32 = PNG_FORMAT_BGR | PNG_FORMAT_FLAG_COLORMAP;\n379\tpub const PNG_FORMAT_RGBA_COLORMAP: png_uint_32 = PNG_FORMAT_RGBA | PNG_FORMAT_FLAG_COLORMAP;\n380\tpub const PNG_FORMAT_ARGB_COLORMAP: png_uint_32 = PNG_FORMAT_ARGB | PNG_FORMAT_FLAG_COLORMAP;\n381\tpub const PNG_FORMAT_BGRA_COLORMAP: png_uint_32 = PNG_FORMAT_BGRA | PNG_FORMAT_FLAG_COLORMAP;\n382\tpub const PNG_FORMAT_ABGR_COLORMAP: png_uint_32 = PNG_FORMAT_ABGR | PNG_FORMAT_FLAG_COLORMAP;\n383\t\n384\tpub const PNG_IMAGE_FLAG_COLORSPACE_NOT_sRGB: png_uint_32 = 0x01;\n385\tpub const PNG_IMAGE_FLAG_FAST: png_uint_32 = 0x02;\n386\tpub const PNG_IMAGE_FLAG_16BIT_sRGB: png_uint_32 = 0x04;\n387\t\n388\t// ---------------------------------------------------------------------------\n389\t// The two libraries\n390\t// ---------------------------------------------------------------------------\n391\t\n392\tfn repo_root() -> PathBuf {\n393\t    // CARGO_MANIFEST_DIR == <root>/translation\n394\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n395\t        .parent()\n396\t        .unwrap()\n397\t        .to_path_buf()\n398\t}\n399\t\n400\tfn c_so_path() -> PathBuf {\n401\t    if let Ok(p) = std::env::var(\"PNG_C_SO\") {\n402\t        return PathBuf::from(p);\n403\t    }\n404\t    repo_root().join(\"c_src/build/libpng.so\")\n405\t}\n406\t\n407\tfn rust_so_path() -> PathBuf {\n408\t    if let Ok(p) = std::env::var(\"PNG_RUST_SO\") {\n409\t        return PathBuf::from(p);\n410\t    }\n411\t    let base = repo_root().join(\"translation/target\");\n412\t    // Prefer the profile the test binary itself was built with.\n413\t    let (first, second) = if cfg!(debug_assertions) {\n414\t        (\"debug\", \"release\")\n415\t    } else {\n416\t        (\"release\", \"debug\")\n417\t    };\n418\t    let a = base.join(first).join(\"liblibpng.so\");\n419\t    if a.exists() {\n420\t        return a;\n421\t    }\n422\t    base.join(second).join(\"liblibpng.so\")\n423\t}\n424\t\n425\tpub struct Libs {\n426\t    pub c: Library,\n427\t    pub rs: Library,\n428\t}\n429\t\n430\tstatic LIBS: OnceLock<Libs> = OnceLock::new();\n431\t\n432\tpub fn libs() -> &'static Libs {\n433\t    LIBS.get_or_init(|| {\n434\t        // The reference C build is linked against zlib but relies on the\n435\t        // executable pulling in libm (`floor`, `pow`, ...).  A Rust test binary\n436\t        // does not, so load libm with RTLD_GLOBAL first.\n437\t        {\n438\t            use libloading::os::unix as u;\n439\t            let flags = u::RTLD_NOW | u::RTLD_GLOBAL;\n440\t            for name in [\"libm.so.6\", \"libm.so\"] {\n441\t                if let Ok(l) = unsafe { u::Library::open(Some(name), flags) } {\n442\t                    std::mem::forget(l);\n443\t                    break;\n444\t                }\n445\t            }\n446\t        }\n447\t        let cp = c_so_path();\n448\t        let rp = rust_so_path();\n449\t        // RTLD_LOCAL (libloading default) keeps the two symbol tables apart.\n450\t        let c = unsafe { Library::new(&cp) }\n451\t            .unwrap_or_else(|e| panic!(\"cannot load C .so {}: {e}\", cp.display()));\n452\t        let rs = unsafe { Library::new(&rp) }\n453\t            .unwrap_or_else(|e| panic!(\"cannot load Rust .so {}: {e}\", rp.display()));\n454\t        Libs { c, rs }\n455\t    })\n456\t}\n457\t\n458\t/// Resolve a symbol of the given type from one of the loaded libraries.\n459\tpub fn sym<T>(lib: &'static Library, name: &str) -> T\n460\twhere\n461\t    T: Copy,\n462\t{\n463\t    let cname = std::ffi::CString::new(name).unwrap();\n464\t    unsafe {\n465\t        let s: Symbol<T> = lib\n466\t            .get(cname.as_bytes_with_nul())\n467\t            .unwrap_or_else(|e| panic!(\"symbol {name} not found: {e}\"));\n468\t        *s\n469\t    }\n470\t}\n471\t\n472\t/// Fetch the same symbol from both libraries.\n473\tpub fn both<T: Copy>(name: &str) -> (T, T) {\n474\t    let l = libs();\n475\t    (sym::<T>(&l.c, name), sym::<T>(&l.rs, name))\n476\t}\n477\t\n478\t/// True when the symbol exists in both libraries.\n479\tpub fn has_both(name: &str) -> bool {\n480\t    let l = libs();\n481\t    let cname = std::ffi::CString::new(name).unwrap();\n482\t    unsafe {\n483\t        l.c.get::<*const c_void>(cname.as_bytes_with_nul()).is_ok()\n484\t            && l.rs.get::<*const c_void>(cname.as_bytes_with_nul()).is_ok()\n485\t    }\n486\t}\n487\t\n488\t// ---------------------------------------------------------------------------\n489\t// Deterministic PRNG (xorshift64*) — reproducible property-style inputs\n490\t// ---------------------------------------------------------------------------\n491\t\n492\tpub struct Rng(u64);\n493\t\n494\timpl Rng {\n495\t    pub fn new(seed: u64) -> Self {\n496\t        Rng(if seed == 0 { 0x9E3779B97F4A7C15 } else { seed })\n497\t    }\n498\t    pub fn next_u64(&mut self) -> u64 {\n499\t        let mut x = self.0;\n500\t        x ^= x >> 12;\n501\t        x ^= x << 25;\n502\t        x ^= x >> 27;\n503\t        self.0 = x;\n504\t        x.wrapping_mul(0x2545F4914F6CDD1D)\n505\t    }\n506\t    pub fn next_u32(&mut self) -> u32 {\n507\t        (self.next_u64() >> 32) as u32\n508\t    }\n509\t    pub fn next_u16(&mut self) -> u16 {\n510\t        (self.next_u64() >> 40) as u16\n511\t    }\n512\t    pub fn next_u8(&mut self) -> u8 {\n513\t        (self.next_u64() >> 48) as u8\n514\t    }\n515\t    /// Uniform in `[0, n)`.\n516\t    pub fn below(&mut self, n: u32) -> u32 {\n517\t        if n == 0 {\n518\t            0\n519\t        } else {\n520\t            self.next_u32() % n\n521\t        }\n522\t    }\n523\t    pub fn range(&mut self, lo: u32, hi_inclusive: u32) -> u32 {\n524\t        lo + self.below(hi_inclusive - lo + 1)\n525\t    }\n526\t    pub fn bool(&mut self) -> bool {\n527\t        self.next_u64() & 1 != 0\n528\t    }\n529\t    pub fn bytes(&mut self, n: usize) -> Vec<u8> {\n530\t        (0..n).map(|_| self.next_u8()).collect()\n531\t    }\n532\t    pub fn pick<'a, T>(&mut self, xs: &'a [T]) -> &'a T {\n533\t        &xs[self.below(xs.len() as u32) as usize]\n534\t    }\n535\t    /// Values biased towards interesting boundaries.\n536\t    pub fn interesting_u32(&mut self) -> u32 {\n537\t        const SPECIAL: [u32; 16] = [\n538\t            0,\n539\t            1,\n540\t            2,\n541\t            0x7f,\n542\t            0x80,\n543\t            0xff,\n544\t            0x100,\n545\t            0x7fff,\n546\t            0x8000,\n547\t            0xffff,\n548\t            0x1_0000,\n549\t            0x7fff_ffff,\n550\t            0x8000_0000,\n551\t            0xffff_ffff,\n552\t            0x7fff_fffe,\n553\t            0x8000_0001,\n554\t        ];\n555\t        if self.next_u64() & 3 == 0 {\n556\t            SPECIAL[self.below(16) as usize]\n557\t        } else {\n558\t            self.next_u32()\n559\t        }\n560\t    }\n561\t}\n562\t\n563\t// ---------------------------------------------------------------------------\n564\t// Function-pointer typedefs used by the tests\n565\t// ---------------------------------------------------------------------------\n566\t\n567\tpub type png_error_ptr = Option<unsafe extern \"C\" fn(png_structp, png_const_charp)>;\n568\tpub type png_rw_ptr = Option<unsafe extern \"C\" fn(png_structp, png_bytep, usize)>;\n569\tpub type png_flush_ptr = Option<unsafe extern \"C\" fn(png_structp)>;\n570\tpub type png_read_status_ptr =\n571\t    Option<unsafe extern \"C\" fn(png_structp, png_uint_32, c_int)>;\n572\tpub type png_write_status_ptr =\n573\t    Option<unsafe extern \"C\" fn(png_structp, png_uint_32, c_int)>;\n574\tpub type png_progressive_info_ptr = Option<unsafe extern \"C\" fn(png_structp, png_infop)>;\n575\tpub type png_progressive_row_ptr =\n576\t    Option<unsafe extern \"C\" fn(png_structp, png_bytep, png_uint_32, c_int)>;\n577\tpub type png_progressive_end_ptr = Option<unsafe extern \"C\" fn(png_structp, png_infop)>;\n578\tpub type png_user_transform_ptr =\n579\t    Option<unsafe extern \"C\" fn(png_structp, *mut c_void, png_bytep)>;\n580\tpub type png_user_chunk_ptr = Option<unsafe extern \"C\" fn(png_structp, *mut c_void) -> c_int>;\n581\tpub type png_longjmp_ptr = Option<unsafe extern \"C\" fn(*mut c_void, c_int)>;\n582\tpub type png_malloc_ptr = Option<unsafe extern \"C\" fn(png_structp, usize) -> png_voidp>;\n583\tpub type png_free_ptr = Option<unsafe extern \"C\" fn(png_structp, png_voidp)>;\n584\t\n585\t// ---------------------------------------------------------------------------\n586\t// Signature aliases for every entry point the tests use\n587\t// ---------------------------------------------------------------------------\n588\t\n589\tpub type Fn_create_read = unsafe extern \"C\" fn(\n590\t    png_const_charp,\n591\t    png_voidp,\n592\t    png_error_ptr,\n593\t    png_error_ptr,\n594\t) -> png_structp;\n595\tpub type Fn_create_write = Fn_create_read;\n596\tpub type Fn_create_info = unsafe extern \"C\" fn(png_structp) -> png_infop;\n597\tpub type Fn_destroy_read = unsafe extern \"C\" fn(*mut png_structp, *mut png_infop, *mut png_infop);\n598\tpub type Fn_destroy_write = unsafe extern \"C\" fn(*mut png_structp, *mut png_infop);\n599\tpub type Fn_set_error_fn =\n600\t    unsafe extern \"C\" fn(png_structp, png_voidp, png_error_ptr, png_error_ptr);\n601\tpub type Fn_set_read_fn = unsafe extern \"C\" fn(png_structp, png_voidp, png_rw_ptr);\n602\tpub type Fn_set_write_fn =\n603\t    unsafe extern \"C\" fn(png_structp, png_voidp, png_rw_ptr, png_flush_ptr);\n604\tpub type Fn_set_longjmp = unsafe extern \"C\" fn(png_structp, png_longjmp_ptr, usize) -> *mut c_void;\n605\t\n606\tpub type Fn_v_p = unsafe extern \"C\" fn(png_structp);\n607\tpub type Fn_v_pi = unsafe extern \"C\" fn(png_structp, png_infop);\n608\tpub type Fn_v_pii = unsafe extern \"C\" fn(png_structp, png_infop, c_int);\n609\tpub type Fn_i_p = unsafe extern \"C\" fn(png_structp) -> c_int;\n610\tpub type Fn_u_p = unsafe extern \"C\" fn(png_structp) -> png_uint_32;\n611\tpub type Fn_u32_pi = unsafe extern \"C\" fn(png_structp, png_infop) -> png_uint_32;\n612\tpub type Fn_b_pi = unsafe extern \"C\" fn(png_structp, png_infop) -> png_byte;\n613\tpub type Fn_sz_pi = unsafe extern \"C\" fn(png_structp, png_infop) -> usize;\n614\t\n615\t// ---------------------------------------------------------------------------\n616\t// Error/warning capture: an `extern \"C\"` handler that records the message in a\n617\t// thread-local slot and then unwinds out of the library via a Rust panic ...\n618\t// which is NOT allowed for the C library.  Instead we use `png_set_longjmp_fn`\n619\t// with a real `setjmp` replacement is impossible from Rust, so the strategy is:\n620\t//\n621\t//   * install an error handler that records the message and then calls\n622\t//     `png_longjmp`-equivalent by *panicking*.  For the C library the panic\n623\t//     unwinds through C frames compiled with `-fexceptions`?  Not guaranteed.\n624\t//\n625\t// The portable approach used throughout these tests: run the library call in a\n626\t// child *process* is too slow.  Instead we exploit the documented libpng\n627\t// contract: the error handler must not return.  We therefore record the message\n628\t// and `longjmp` using the `jmp_buf` libpng itself owns, by calling the\n629\t// exported `png_longjmp` only in the Rust case ... also not portable.\n630\t//\n631\t// => The tests below never let an error escape when the C library is involved\n632\t//    unless the call is made through `png_safe_execute`-based entry points\n633\t//    (the simplified API, `png_image_*`), which return an error code instead of\n634\t//    longjmp'ing.  For direct low-level calls the tests use *valid* input, and\n635\t//    error paths are exercised through:\n636\t//      - the simplified API (returns 0 + message in png_image.message)\n637\t//      - `png_set_*` app errors, which are warnings in this build for the read\n638\t//        side and thus return normally\n639\t//      - getters/utility functions, which return sentinels\n640\t//    plus `abort_on_error` handlers that make a divergence loud.\n641\t// ---------------------------------------------------------------------------\n642\t\n643\t/// A do-nothing warning handler (libpng calls it and continues).\n644\tpub unsafe extern \"C\" fn ignore_warning(_p: png_structp, _m: png_const_charp) {}\n645\t\n646\tpub fn cstr_to_string(p: png_const_charp) -> String {\n647\t    if p.is_null() {\n648\t        return String::new();\n649\t    }\n650\t    unsafe { std::ffi::CStr::from_ptr(p) }\n651\t        .to_string_lossy()\n652\t        .into_owned()\n653\t}\n654\t\n655\t// ---------------------------------------------------------------------------\n656\t// Assertion helpers\n657\t// ---------------------------------------------------------------------------\n658\t\n659\t#[track_caller]\n660\tpub fn eq_dbg<T: PartialEq + std::fmt::Debug>(what: &str, c: T, r: T) {\n661\t    assert_eq!(c, r, \"MISMATCH in {what}: C={c:?} RUST={r:?}\");\n662\t}\n663\t\n664\t#[track_caller]\n665\tpub fn eq_bytes(what: &str, c: &[u8], r: &[u8]) {\n666\t    if c != r {\n667\t        let n = c.len().min(r.len());\n668\t        let mut first = n;\n669\t        for i in 0..n {\n670\t            if c[i] != r[i] {\n671\t                first = i;\n672\t                break;\n673\t            }\n674\t        }\n675\t        panic!(\n676\t            \"MISMATCH in {what}: lengths C={} RUST={}, first differing byte at {}\\n  C   [{}..]={:02x?}\\n  RUST[{}..]={:02x?}\",\n677\t            c.len(),\n678\t            r.len(),\n679\t            first,\n680\t            first,\n681\t            &c[first..(first + 24).min(c.len())],\n682\t            first,\n683\t            &r[first..(first + 24).min(r.len())],\n684\t        );\n685\t    }\n686\t}\n687\t\n688\t// re-export the ffi scalar types so test files need only `use common::*`\n689\tpub use std::ffi::{c_char as CChar, c_int as CInt};\n690\tpub type CDouble = c_double;\n691\tpub type CLong = c_long;\n692\tpub type CUint = c_uint;\n693\tpub type CUlong = c_ulong;\n694\tpub type CVoid = c_void;\n695\t"}]},"parent_tool_use_id":"toolu_bdrk_01H4bkgNE6Ud9yVg834dhBsz","session_id":"d61bc42a-4e8d-424f-b737-52a7165119c7","uuid":"e6bab9ef-defe-4fa8-8366-61ab4ccdf930","timestamp":"2026-09-04T04:08:28.650Z","subagent_type":"general-purpose","task_description":"Write setter/transform error tests"}
