p text,\n1570\t    size_t text_len)\n1571\t{\n1572\t   png_uint_32 key_len;\n1573\t   png_byte new_key[80];\n1574\t\n1575\t   png_debug(1, \"in png_write_tEXt\");\n1576\t\n1577\t   key_len = png_check_keyword(png_ptr, key, new_key);\n1578\t\n1579\t   if (key_len == 0)\n1580\t      png_error(png_ptr, \"tEXt: invalid keyword\");\n1581\t\n1582\t   if (text == NULL || *text == '\\0')\n1583\t      text_len = 0;\n1584\t\n1585\t   else\n1586\t      text_len = strlen(text);\n1587\t\n1588\t   if (text_len > PNG_UINT_31_MAX - (key_len+1))\n1589\t      png_error(png_ptr, \"tEXt: text too long\");\n1590\t\n1591\t   /* Make sure we include the 0 after the key */\n1592\t   png_write_chunk_header(png_ptr, png_tEXt,\n1593\t       (png_uint_32)/*checked above*/(key_len + text_len + 1));\n1594\t   /*\n1595\t    * We leave it to the application to meet PNG-1.0 requirements on the\n1596\t    * contents of the text.  PNG-1.0 through PNG-1.2 discourage the use of\n1597\t    * any non-Latin-1 characters except for NEWLINE.  ISO PNG will forbid them.\n1598\t    * The NUL character is forbidden by PNG-1.0 through PNG-1.2 and ISO PNG.\n1599\t    */\n1600\t   png_write_chunk_data(png_ptr, new_key, key_len + 1);\n1601\t\n1602\t   if (text_len != 0)\n1603\t      png_write_chunk_data(png_ptr, (png_const_bytep)text, text_len);\n1604\t\n1605\t   png_write_chunk_end(png_ptr);\n1606\t}\n1607\t#endif\n1608\t\n1609\t#ifdef PNG_WRITE_zTXt_SUPPORTED\n1610\t/* Write a compressed text chunk */\n1611\tvoid /* PRIVATE */\n1612\tpng_write_zTXt(png_structrp png_ptr, png_const_charp key, png_const_charp text,\n1613\t    int compression)\n1614\t{\n1615\t   png_uint_32 key_len;\n1616\t   png_byte new_key[81];\n1617\t   compression_state comp;\n1618\t\n1619\t   png_debug(1, \"in png_write_zTXt\");\n1620\t\n1621\t   if (compression == PNG_TEXT_COMPRESSION_NONE)\n1622\t   {\n1623\t      png_write_tEXt(png_ptr, key, text, 0);\n1624\t      return;\n1625\t   }\n1626\t\n1627\t   if (compression != PNG_TEXT_COMPRESSION_