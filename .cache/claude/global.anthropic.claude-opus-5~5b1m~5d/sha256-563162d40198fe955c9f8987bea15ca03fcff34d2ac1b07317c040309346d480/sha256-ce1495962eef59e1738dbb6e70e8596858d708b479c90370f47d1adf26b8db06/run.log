tr\", \"png_free_ptr\"),\n    (\"const struct tm *\", \"*const c_void\"), (\"time_t\", \"c_long\"),\n    (\"FILE *\", \"*mut c_void\"),\n    (\"const char *\", \"*const c_char\"), (\"char out[29]\", \"*mut c_char\"),\n    (\"const void *\", \"*const c_void\"), (\"void *\", \"*mut c_void\"),\n    (\"size_t *\", \"*mut usize\"), (\"size_t\", \"usize\"),\n    (\"double *\", \"*mut c_double\"), (\"double\", \"c_double\"),\n    (\"float\", \"f32\"),\n    (\"int *\", \"*mut c_int\"), (\"int\", \"c_int\"),\n    (\"jmp_buf*\", \"*mut c_void\"),\n    (\"unsigned int\", \"c_uint\"),\n    (\"void\", \"()\"),\n]\nD = dict(TM)\n\n\ndef conv(t):\n    t = \" \".join(t.strip().split())\n    if t in D:\n        return D[t]\n    raise SystemExit(\"UNMAPPED TYPE: %r\" % t)\n\n\ndef split_arg(a):\n    a = \" \".join(a.strip().split())\n    if a == \"void\":\n        return None\n    if a == \"char out[29]\":\n        return \"*mut c_char\"\n    if a in D:\n        return D[a]\n    m = re.match(r\"^(.*?)([A-Za-z_][A-Za-z0-9_]*)$\", a)\n    if not m:\n        raise SystemExit(\"bad arg %r\" % a)\n    head = m.group(1)\n    if head.strip() == \"\":\n        raise SystemExit(\"UNMAPPED %r\" % a)\n    return conv(head)\n\n\ndef decls(path):\n    src = open(path).read()\n    src = re.sub(r\"/\\*.*?\\*/\", \"\", src, flags=re.S)\n    out = {}\n    pat = re.compile(\n        r\"PNG_(?:FP_|FIXED_)?EXPORT\\s*\\(\\s*\\d+\\s*,\\s*([A-Za-z_][A-Za-z0-9_ *]*?)\\s*,\"\n        r\"\\s*(\\w+)\\s*,\\s*\\((.*?)\\)\\s*\\)\",\n        re.S,\n    )\n    for m in pat.finditer(src):\n        out[m.group(2)] = (\" \".join(m.group(1).split()), \" \".join(m.group(3).split()))\n    pata = re.compile(\n        r\"PNG_EXPORTA\\s*\\(\\s*\\d+\\s*,\\s*([A-Za-z_][A-Za-z0-9_ *]*?)\\s*,\\s*(\\w+)\\s*,\\s*\\((.*?)\\)\\s*,\",\n        re.S,\n    )\n    for m in pata.finditer(src):\n        out[m.group(2)] = (\" \".join(m.group(1).split()), \" \".join(m.group(3).split()))\n    return out\n\n\ndef main():\n    d = decls(\"c_src/include/png.h\")\n    fields = []\n    for name in sorted(d):\n        ret, args = d[name]\n        args = args.strip()\n        if args.startswith(\"(\") and args.endswith(\")\"):\n            args = args[1:-1]\n        parts, depth, cur = [], 0, \"\"\n        for ch in args:\n            if ch == \"(\":\n                depth += 1\n            if ch == \")\":\n                depth -= 1\n            if ch == \",\" and depth == 0:\n                parts.append(cur)\n                cur = \"\"\n            else:\n                cur += ch\n        if cur.strip():\n            parts.append(cur)\n        rargs = [c for c in (split_arg(p) for p in parts) if c is not None]\n        rret = conv(ret)\n        sig = 'unsafe extern \"C\" fn(%s)' % \", \".join(rargs)\n        if rret != \"()\":\n            sig += \" -> %s\" % rret\n        fields.append((name, sig))\n\n    w = sys.stdout.write\n    w(HEADER)\n    w(\"\\npub struct Api {\\n\")\n    for n, s in fields:\n        w(\"    pub %s: %s,\\n\" % (n, s))\n    w(\"}\\n\\nimpl Api {\\n    pub fn new(lib: &'static Library) -> Api {\\n        Api {\\n\")\n    for n, s in fields:\n        w('            %s: sym::<%s>(lib, \"%s\"),\\n' % (n, s, n))\n    w(\"        }\\n    }\\n}\\n\")\n    w(FOOTER)\n\n\nif __name__ == \"__main__\":\n    main()\n","structuredPatch":[{"oldStart":156,"oldLines":10,"newStart":156,"newLines":19,"lines":["     return out"," "," ","+# Declared in png.h but compiled out of this build (absent from both `.so`s):","+#   png_err                     -- PNG_ERROR_TEXT_SUPPORTED is on, so png_err","+#                                  is only declared for the !ERROR_TEXT case","+#   png_set_strip_error_numbers -- PNG_ERROR_NUMBERS_SUPPORTED is off","+NOT_EXPORTED = {\"png_err\", \"png_set_strip_error_numbers\"}","+","+"," def main():","     d = decls(\"c_src/include/png.h\")","     fields = []","     for name in sorted(d):","+        if name in NOT_EXPORTED:","+            continue","         ret, args