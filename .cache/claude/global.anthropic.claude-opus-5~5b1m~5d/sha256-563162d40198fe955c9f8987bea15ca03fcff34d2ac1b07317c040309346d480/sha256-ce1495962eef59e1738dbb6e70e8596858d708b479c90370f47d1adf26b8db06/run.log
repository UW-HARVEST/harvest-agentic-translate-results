{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01MPEh7LrDqdwGNPA7nDznyH","type":"tool_result","content":"1\t//! Two complementary ways to drive the libraries.\n2\t//!\n3\t//! 1. **In-process** (`Recorder`): used by the valid-path (Phase B) tests.  A\n4\t//!    warning handler records every warning message in order; the error handler\n5\t//!    prints the message and aborts, because a `png_error` on a valid input is\n6\t//!    itself a bug and must not be silently swallowed.  I/O goes through a\n7\t//!    thread-local byte buffer so no `png_get_io_ptr` round-trip is needed and\n8\t//!    exactly the same callbacks serve both libraries.\n9\t//!\n10\t//! 2. **Sub-process** (`run_child`): used by the error-path (Phase C) tests.\n11\t//!    `png_error` must not return; the only portable way to observe it from Rust\n12\t//!    without `setjmp` is to let the handler print the message and `exit`.  The\n13\t//!    parent re-executes the test binary (`--exact harness_child`) once for the\n14\t//!    C library and once for the Rust library and compares the two transcripts\n15\t//!    line by line, so the error message, the preceding warnings, their order\n16\t//!    and the exit code must all agree.\n17\t#![allow(dead_code)]\n18\t\n19\tuse super::*;\n20\tuse std::cell::RefCell;\n21\tuse std::ffi::c_char;\n22\tuse std::io::Write;\n23\t\n24\t// ---------------------------------------------------------------------------\n25\t// thread-local state shared by the callbacks\n26\t// ---------------------------------------------------------------------------\n27\t\n28\tthread_local! {\n29\t    static OUT: RefCell<Vec<u8>> = const { RefCell::new(Vec::new()) };\n30\t    static IN: RefCell<(Vec<u8>, usize)> = const { RefCell::new((Vec::new(), 0)) };\n31\t    static LOG: RefCell<Vec<String>> = const { RefCell::new(Vec::new()) };\n32\t    /// When set, `error_cb` prints the transcript and exits instead of aborting.\n33\t    static CHILD_MODE: RefCell<bool> = const { RefCell::new(false) };\n34\t    /// Number of rows delivered to the progressive-read row callback, and a\n35\t    /// digest of everything the progressive reader handed us.\n36\t    static PROG: RefCell<Vec<String>> = const { RefCell::new(Vec::new()) };\n37\t}\n38\t\n39\tpub fn out_reset() {\n40\t    OUT.with(|o| o.borrow_mut().clear());\n41\t}\n42\tpub fn out_take() -> Vec<u8> {\n43\t    OUT.with(|o| std::mem::take(&mut *o.borrow_mut()))\n44\t}\n45\tpub fn out_len() -> usize {\n46\t    OUT.with(|o| o.borrow().len())\n47\t}\n48\t\n49\tpub fn in_set(data: &[u8]) {\n50\t    IN.with(|i| {\n51\t        let mut b = i.borrow_mut();\n52\t        b.0 = data.to_vec();\n53\t        b.1 = 0;\n54\t    });\n55\t}\n56\tpub fn in_pos() -> usize {\n57\t    IN.with(|i| i.borrow().1)\n58\t}\n59\t\n60\tpub fn log_reset() {\n61\t    LOG.with(|l| l.borrow_mut().clear());\n62\t}\n63\tpub fn log_push(s: String) {\n64\t    LOG.with(|l| l.borrow_mut().push(s));\n65\t}\n66\tpub fn log_take() -> Vec<String> {\n67\t    LOG.with(|l| std::mem::take(&mut *l.borrow_mut()))\n68\t}\n69\t\n70\tpub fn prog_reset() {\n71\t    PROG.with(|l| l.borrow_mut().clear());\n72\t}\n73\tpub fn prog_push(s: String) {\n74\t    PROG.with(|l| l.borrow_mut().push(s));\n75\t}\n76\tpub fn prog_take() -> Vec<String> {\n77\t    PROG.with(|l| std::mem::take(&mut *l.borrow_mut()))\n78\t}\n79\t\n80\tpub fn set_child_mode(on: bool) {\n81\t    CHILD_MODE.with(|c| *c.borrow_mut() = on);\n82\t}\n83\tfn child_mode() -> bool {\n84\t    CHILD_MODE.with(|c| *c.borrow())\n85\t}\n86\t\n87\t/// Reset everything before a run.\n88\tpub fn reset_all() {\n89\t    out_reset();\n90\t    log_reset();\n91\t    prog_reset();\n92\t}\n93\t\n94\t// ---------------------------------------------------------------------------\n95\t// callbacks (identical code serves both libraries)\n96\t// ---------------------------------------------------------------------------\n97\t\n98\tpub unsafe extern \"C\" fn write_cb(_p: png_structp, data: png_bytep, len: usize) {\n99\t    OUT.with(|o| {\n100\t        let mut b = o.borrow_mut();\n101\t        if len > 0 && !data.is_null() {\n102\t            b.extend_from_slice(std::slice::from_raw_parts(data, len));\n103\t        }\n104\t    });\n105\t}\n106\t\n107\tpub unsafe extern \"C\" fn flush_cb(_p: png_structp) {\n108\t    log_push(\"FLUSH\".to_string());\n109\t}\n110\t\n111\t/// Reader that satisfies the request from the thread-local input buffer and, if\n112\t/// the buffer runs dry, reports a read error the same way `png_default_read_data`\n113\t/// would (by calling `png_error`).  Instead of calling back into the library we\n114\t/// simply supply zero bytes and let libpng detect the truncation, which is what\n115\t/// the deliberately-truncated-stream error rows need.\n116\tpub unsafe extern \"C\" fn read_cb(p: png_structp, data: png_bytep, len: usize) {\n117\t    let mut short = false;\n118\t    IN.with(|i| {\n119\t        let mut b = i.borrow_mut();\n120\t        let (buf, pos) = (&b.0, b.1);\n121\t        let avail = buf.len().saturating_sub(pos);\n122\t        let n = avail.min(len);\n123\t        if n > 0 {\n124\t            std::ptr::copy_nonoverlapping(buf.as_ptr().add(pos), data, n);\n125\t        }\n126\t        if n < len {\n127\t            // zero-fill the remainder\n128\t            std::ptr::write_bytes(data.add(n), 0, len - n);\n129\t            short = true;\n130\t        }\n131\t        b.1 = pos + n;\n132\t    });\n133\t    if short {\n134\t        // mirror png_default_read_data's behaviour on a short read\n135\t        let l = libs();\n136\t        let f: unsafe extern \"C\" fn(png_structp, *const c_char) -> ! = if is_c(p) {\n137\t            sym(&l.c, \"png_error\")\n138\t        } else {\n139\t            sym(&l.rs, \"png_error\")\n140\t        };\n141\t        f(p, c\"Read Error\".as_ptr());\n142\t    }\n143\t}\n144\t\n145\t/// Which library a `png_structp` belongs to cannot be determined from the\n146\t/// pointer, so the tests set this before each run.\n147\tthread_local! {\n148\t    static CUR_IS_C: RefCell<bool> = const { RefCell::new(true) };\n149\t}\n150\tpub fn set_cur_is_c(b: bool) {\n151\t    CUR_IS_C.with(|c| *c.borrow_mut() = b);\n152\t}\n153\tfn is_c(_p: png_structp) -> bool {\n154\t    CUR_IS_C.with(|c| *c.borrow())\n155\t}\n156\t\n157\tpub unsafe extern \"C\" fn warn_cb(_p: png_structp, msg: png_const_charp) {\n158\t    log_push(format!(\"WARN:{}\", cstr_to_string(msg)));\n159\t}\n160\t\n161\tpub unsafe extern \"C\" fn error_cb(_p: png_structp, msg: png_const_charp) -> () {\n162\t    let m = cstr_to_string(msg);\n163\t    if child_mode() {\n164\t        for l in log_take() {\n165\t            println!(\"@@{l}\");\n166\t        }\n167\t        println!(\"@@ERROR:{m}\");\n168\t        let _ = std::io::stdout().flush();\n169\t        std::process::exit(70);\n170\t    } else {\n171\t        eprintln!(\"UNEXPECTED png_error on a valid input: {m}\");\n172\t        for l in log_take() {\n173\t            eprintln!(\"  prior {l}\");\n174\t        }\n175\t        let _ = std::io::stderr().flush();\n176\t        std::process::abort();\n177\t    }\n178\t}\n179\t\n180\tpub unsafe extern \"C\" fn read_status_cb(_p: png_structp, row: png_uint_32, pass: c_int) {\n181\t    log_push(format!(\"RSTATUS:{row}:{pass}\"));\n182\t}\n183\tpub unsafe extern \"C\" fn write_status_cb(_p: png_structp, row: png_uint_32, pass: c_int) {\n184\t    log_push(format!(\"WSTATUS:{row}:{pass}\"));\n185\t}\n186\t\n187\t// ---------------------------------------------------------------------------\n188\t// sub-process driver\n189\t// ---------------------------------------------------------------------------\n190\t\n191\tpub const ENV_CASE: &str = \"PNG_DIFF_CASE\";\n192\tpub const ENV_LIB: &str = \"PNG_DIFF_LIB\";\n193\t\n194\t/// In the child: `Some((case, \"c\"|\"rs\"))`.\n195\tpub fn child_case() -> Option<(String, String)> {\n196\t    match (std::env::var(ENV_CASE), std::env::var(ENV_LIB)) {\n197\t        (Ok(c), Ok(l)) => Some((c, l)),\n198\t        _ => None,\n199\t    }\n200\t}\n201\t\n202\t#[derive(Debug, PartialEq, Eq, Clone)]\n203\tpub struct Transcript {\n204\t    /// `exit(n)` status, `None` when the child died from a signal.\n205\t    pub exit: Option<i32>,\n206\t    /// The terminating signal, when any.  `PNG_ABORT()` (used by `png_longjmp`\n207\t    /// when no `jmp_buf` was installed) legitimately raises SIGABRT, and that is\n208\t    /// itself a rejection whose equality must be checked.\n209\t    pub signal: Option<i32>,\n210\t    pub lines: Vec<String>,\n211\t}\n212\t\n213\t/// Re-execute this very test binary to run `case` against library `which`.\n214\tpub fn run_child(case: &str, which: &str) -> Transcript {\n215\t    let exe = std::env::current_exe().expect(\"current_exe\");\n216\t    let out = std::process::Command::new(exe)\n217\t        .args([\"--exact\", \"harness_child\", \"--nocapture\", \"--test-threads=1\"])\n218\t        .env(ENV_CASE, case)\n219\t        .env(ENV_LIB, which)\n220\t        .env(\"RUST_BACKTRACE\", \"0\")\n221\t        .output()\n222\t        .expect(\"spawn child\");\n223\t    let stdout = String::from_utf8_lossy(&out.stdout).into_owned();\n224\t    // libtest prints `test harness_child ... ` WITHOUT a trailing newline, so the\n225\t    // first transcript line is not at the start of its line.  Match the `@@`\n226\t    // marker anywhere.\n227\t    let lines: Vec<String> = stdout\n228\t        .lines()\n229\t        .filter_map(|l| l.find(\"@@\").map(|i| l[i + 2..].to_string()))\n230\t        .filter(|l| !l.is_empty())\n231\t        .collect();\n232\t    use std::os::unix::process::ExitStatusExt;\n233\t    Transcript {\n234\t        exit: out.status.code(),\n235\t        signal: out.status.signal(),\n236\t        lines,\n237\t    }\n238\t}\n239\t\n240\t/// Run `case` against both libraries and assert the transcripts are identical.\n241\t#[track_caller]\n242\tpub fn diff_case(case: &str) {\n243\t    let c = run_child(case, \"c\");\n244\t    let r = run_child(case, \"rs\");\n245\t    if c != r {\n246\t        panic!(\n247\t            \"ERROR-PATH MISMATCH for case {case:?}\\n  C   : exit={:?} signal={:?} lines={:#?}\\n  RUST: exit={:?} signal={:?} lines={:#?}\",\n248\t            c.exit, c.signal, c.lines, r.exit, r.signal, r.lines\n249\t        );\n250\t    }\n251\t    // A case that produces NO transcript at all AND no clean exit observed\n252\t    // nothing; that would be a vacuous \"pass\", so reject it.\n253\t    assert!(\n254\t        !(c.lines.is_empty() && c.exit.is_none()),\n255\t        \"case {case:?} died from signal {:?} in BOTH libraries without emitting \\\n256\t         anything - nothing was actually compared\",\n257\t        c.signal\n258\t    );\n259\t}\n260\t\n261\t/// Emit a transcript line from inside a child.\n262\tpub fn emit(s: impl AsRef<str>) {\n263\t    println!(\"@@{}\", s.as_ref());\n264\t}\n265\t\n266\t/// Flush the recorded warning log to the transcript (children only).\n267\tpub fn emit_log() {\n268\t    for l in log_take() {\n269\t        emit(l);\n270\t    }\n271\t}\n272\t\n273\tpub fn child_finish() -> ! {\n274\t    emit_log();\n275\t    emit(\"OK\");\n276\t    let _ = std::io::stdout().flush();\n277\t    std::process::exit(0);\n278\t}\n279\t"}]},"parent_tool_use_id":"toolu_bdrk_01YVWdKEQN8gJaNH8hEvMTG4","session_id":"d61bc42a-4e8d-424f-b737-52a7165119c7","uuid":"5fd5ced9-a283-4e0d-8024-736e5a16a0f7","timestamp":"2026-09-04T04:09:04.664Z","subagent_type":"general-purpose","task_description":"Write misc/internal error tests"}
