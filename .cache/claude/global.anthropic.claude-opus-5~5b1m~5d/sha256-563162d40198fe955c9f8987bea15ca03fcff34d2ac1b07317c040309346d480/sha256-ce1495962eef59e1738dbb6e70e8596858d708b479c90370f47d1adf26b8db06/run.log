0\t      png_free(png_ptr, info_ptr->scal_s_width);\n661\t      info_ptr->scal_s_width = NULL;\n662\t\n663\t      png_warning(png_ptr, \"Memory allocation failed while processing sCAL\");\n664\t      return;\n665\t   }\n666\t\n667\t   memcpy(info_ptr->scal_s_height, sheight, lengthh);\n668\t\n669\t   info_ptr->free_me |= PNG_FREE_SCAL;\n670\t   info_ptr->valid |= PNG_INFO_sCAL;\n671\t}\n672\t\n673\t#  ifdef PNG_FLOATING_POINT_SUPPORTED\n674\tvoid PNGAPI\n675\tpng_set_sCAL(png_const_structrp png_ptr, png_inforp info_ptr, int unit,\n676\t    double width, double height)\n677\t{\n678\t   png_debug1(1, \"in %s storage function\", \"sCAL\");\n679\t\n680\t   /* Check the arguments. */\n681\t   if (width <= 0)\n682\t      png_warning(png_ptr, \"Invalid sCAL width ignored\");\n683\t\n684\t   else if (height <= 0)\n685\t      png_warning(png_ptr, \"Invalid sCAL height ignored\");\n686\t\n687\t   else\n688\t   {\n689\t      /* Convert 'width' and 'height' to ASCII. */\n690\t      char swidth[PNG_sCAL_MAX_DIGITS+1];\n691\t      char sheight[PNG_sCAL_MAX_DIGITS+1];\n692\t\n693\t      png_ascii_from_fp(png_ptr, swidth, (sizeof swidth), width,\n694\t          PNG_sCAL_PRECISION);\n695\t      png_ascii_from_fp(png_ptr, sheight, (sizeof sheight), height,\n696\t          PNG_sCAL_PRECISION);\n697\t\n698\t      png_set_sCAL_s(png_ptr, info_ptr, unit, swidth, sheight);\n699\t   }\n700\t}\n701\t#  endif\n702\t\n703\t#  ifdef PNG_FIXED_POINT_SUPPORTED\n704\tvoid PNGAPI\n705\tpng_set_sCAL_fixed(png_const_structrp png_ptr, png_inforp info_ptr, int unit,\n706\t    png_fixed_point width, png_fixed_point height)\n707\t{\n708\t   png_debug1(1, \"in %s storage function\", \"sCAL\");\n709\t\n710\t   /* Check the arguments. */\n711\t   if (width <= 0)\n712\t      png_warning(png_ptr, \"Invalid sCAL width ignored\");\n713\t\n714\t   else if (height <= 0)\n715\t      png_warning(png_ptr, \"Invalid sCAL height ignored\");\n716\t\n717\t   else\n718\t   {\n719\t      /* Convert 'width' and 'height' t