{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01HyQWRkv1kWKenmm7owvhAA","type":"tool_result","content":"1\t//! Phase C — write-path rejections.\n2\t//!\n3\t//! On the write side `png_error`, `png_app_error`, `png_app_warning` and\n4\t//! `png_benign_error` are all FATAL in this build (`PNG_RELEASE_BUILD == 0` and\n5\t//! `PNG_BENIGN_WRITE_ERRORS_SUPPORTED` is off), and `png_error` must not\n6\t//! return.  Rust cannot `setjmp`, so each case runs in a SUB-PROCESS: the test\n7\t//! binary re-executes itself once for the C library and once for the Rust\n8\t//! library with an error handler that prints the message and `exit(70)`s.  The\n9\t//! parent then compares the two transcripts — the ordered list of warnings, the\n10\t//! error message and the exit code — so a divergence in the message text, in\n11\t//! the *order* of the diagnostics, or in whether the call was fatal at all is\n12\t//! caught.\n13\tmod common;\n14\t\n15\tuse common::api::{apis, Api};\n16\tuse common::harness::*;\n17\tuse common::pngbuild as pb;\n18\tuse common::*;\n19\tuse std::ffi::{c_char, c_int, c_void};\n20\t\n21\t// ---------------------------------------------------------------------------\n22\t// the child: performs one named case against one library\n23\t// ---------------------------------------------------------------------------\n24\t\n25\t/// Fresh write struct with the recording callbacks installed.\n26\tunsafe fn new_write(a: &Api) -> (png_structp, png_infop) {\n27\t    let p = (a.png_create_write_struct)(\n28\t        PNG_LIBPNG_VER_STRING.as_ptr() as *const c_char,\n29\t        std::ptr::null_mut(),\n30\t        Some(error_cb),\n31\t        Some(warn_cb),\n32\t    );\n33\t    assert!(!p.is_null());\n34\t    let info = (a.png_create_info_struct)(p);\n35\t    assert!(!info.is_null());\n36\t    (a.png_set_write_fn)(p, std::ptr::null_mut(), Some(write_cb), Some(flush_cb));\n37\t    (p, info)\n38\t}\n39\t\n40\t/// A minimal valid header so that row writing can be reached.\n41\tunsafe fn hdr(a: &Api, p: png_structp, info: png_infop, w: u32, h: u32, bd: c_int, ct: c_int) {\n42\t    (a.png_set_IHDR)(p, info, w, h, bd, ct, 0, 0, 0);\n43\t    if ct == PNG_COLOR_TYPE_PALETTE {\n44\t        let pal = [png_color { red: 1, green: 2, blue: 3 }; 4];\n45\t        (a.png_set_PLTE)(p, info, pal.as_ptr(), 4);\n46\t    }\n47\t}\n48\t\n49\tfn run_case(a: &Api, case: &str) {\n50\t    unsafe {\n51\t        match case {\n52\t            // ---------------- png_create_write_struct ----------------\n53\t            \"create-version-null\" => {\n54\t                let p = (a.png_create_write_struct)(\n55\t                    std::ptr::null(),\n56\t                    std::ptr::null_mut(),\n57\t                    Some(error_cb),\n58\t                    Some(warn_cb),\n59\t                );\n60\t                emit(format!(\"RET:{}\", if p.is_null() { \"NULL\" } else { \"ptr\" }));\n61\t            }\n62\t            \"create-version-empty\" => {\n63\t                let p = (a.png_create_write_struct)(\n64\t                    c\"\".as_ptr(),\n65\t                    std::ptr::null_mut(),\n66\t                    Some(error_cb),\n67\t                    Some(warn_cb),\n68\t                );\n69\t                emit(format!(\"RET:{}\", if p.is_null() { \"NULL\" } else { \"ptr\" }));\n70\t            }\n71\t            \"create-version-major-mismatch\" => {\n72\t                let p = (a.png_create_write_struct)(\n73\t                    c\"2.6.59\".as_ptr(),\n74\t                    std::ptr::null_mut(),\n75\t                    Some(error_cb),\n76\t                    Some(warn_cb),\n77\t                );\n78\t                emit(format!(\"RET:{}\", if p.is_null() { \"NULL\" } else { \"ptr\" }));\n79\t            }\n80\t            \"create-version-minor-mismatch\" => {\n81\t                let p = (a.png_create_write_struct)(\n82\t                    c\"1.5.59\".as_ptr(),\n83\t                    std::ptr::null_mut(),\n84\t                    Some(error_cb),\n85\t                    Some(warn_cb),\n86\t                );\n87\t                emit(format!(\"RET:{}\", if p.is_null() { \"NULL\" } else { \"ptr\" }));\n88\t            }\n89\t            \"create-version-garbage\" => {\n90\t                let p = (a.png_create_write_struct)(\n91\t                    c\"garbage\".as_ptr(),\n92\t                    std::ptr::null_mut(),\n93\t                    Some(error_cb),\n94\t                    Some(warn_cb),\n95\t                );\n96\t                emit(format!(\"RET:{}\", if p.is_null() { \"NULL\" } else { \"ptr\" }));\n97\t            }\n98\t\n99\t            // ---------------- png_set_IHDR / png_check_IHDR ----------------\n100\t            _ if case.starts_with(\"ihdr:\") => {\n101\t                let f: Vec<&str> = case[5..].split(',').collect();\n102\t                let (p, info) = new_write(a);\n103\t                (a.png_set_IHDR)(\n104\t                    p,\n105\t                    info,\n106\t                    f[0].parse().unwrap(),\n107\t                    f[1].parse().unwrap(),\n108\t                    f[2].parse().unwrap(),\n109\t                    f[3].parse().unwrap(),\n110\t                    f[4].parse().unwrap(),\n111\t                    f[5].parse().unwrap(),\n112\t                    f[6].parse().unwrap(),\n113\t                );\n114\t                emit(\"set_IHDR returned\");\n115\t                (a.png_write_info)(p, info);\n116\t                emit(\"write_info returned\");\n117\t            }\n118\t\n119\t            // ---------------- writing without a header ----------------\n120\t            \"write-info-no-ihdr\" => {\n121\t                let (p, info) = new_write(a);\n122\t                (a.png_write_info)(p, info);\n123\t                emit(\"write_info returned\");\n124\t            }\n125\t            \"write-row-before-info\" => {\n126\t                let (p, info) = new_write(a);\n127\t                hdr(a, p, info, 4, 2, 8, 2);\n128\t                let row = [0u8; 12];\n129\t                (a.png_write_row)(p, row.as_ptr());\n130\t                emit(\"write_row returned\");\n131\t            }\n132\t            \"write-end-before-info\" => {\n133\t                let (p, info) = new_write(a);\n134\t                hdr(a, p, info, 4, 2, 8, 2);\n135\t                (a.png_write_end)(p, info);\n136\t                emit(\"write_end returned\");\n137\t            }\n138\t            \"write-too-many-rows\" => {\n139\t                let (p, info) = new_write(a);\n140\t                hdr(a, p, info, 4, 2, 8, 2);\n141\t                (a.png_write_info)(p, info);\n142\t                let row = [0u8; 12];\n143\t                for i in 0..5 {\n144\t                    (a.png_write_row)(p, row.as_ptr());\n145\t                    emit(format!(\"row {i} ok\"));\n146\t                }\n147\t            }\n148\t            \"write-end-too-few-rows\" => {\n149\t                let (p, info) = new_write(a);\n150\t                hdr(a, p, info, 4, 4, 8, 2);\n151\t                (a.png_write_info)(p, info);\n152\t                let row = [0u8; 12];\n153\t                (a.png_write_row)(p, row.as_ptr());\n154\t                (a.png_write_end)(p, info);\n155\t                emit(\"write_end returned\");\n156\t            }\n157\t            // NOTE: `png_write_image(p, NULL)` is NOT a testable rejection --\n158\t            // pngwrite.c dereferences `image[i]` with no NULL check, so the C\n159\t            // segfaults.  There is no check to compare against.\n160\t            \"write-png-no-rows\" => {\n161\t                let (p, info) = new_write(a);\n162\t                hdr(a, p, info, 4, 2, 8, 2);\n163\t                (a.png_write_png)(p, info, 0, std::ptr::null_mut());\n164\t                emit(\"write_png returned\");\n165\t            }\n166\t            // NOTE: `png_write_row(p, NULL)` is likewise not a rejection -- the C\n167\t            // has no NULL check and dereferences the row pointer.\n168\t            \"write-rows-zero\" => {\n169\t                let (p, info) = new_write(a);\n170\t                hdr(a, p, info, 4, 2, 8, 2);\n171\t                (a.png_write_info)(p, info);\n172\t                (a.png_write_rows)(p, std::ptr::null_mut(), 0);\n173\t                emit(\"write_rows(NULL,0) returned\");\n174\t            }\n175\t\n176\t            // ---------------- PLTE ----------------\n177\t            _ if case.starts_with(\"plte:\") => {\n178\t                let f: Vec<&str> = case[5..].split(',').collect();\n179\t                let bd: c_int = f[0].parse().unwrap();\n180\t                let ct: c_int = f[1].parse().unwrap();\n181\t                let n: c_int = f[2].parse().unwrap();\n182\t                let (p, info) = new_write(a);\n183\t                (a.png_set_IHDR)(p, info, 4, 2, bd, ct, 0, 0, 0);\n184\t                let pal = vec![png_color { red: 1, green: 2, blue: 3 }; 300];\n185\t                (a.png_set_PLTE)(p, info, pal.as_ptr(), n);\n186\t                emit(\"set_PLTE returned\");\n187\t                (a.png_write_info)(p, info);\n188\t                emit(\"write_info returned\");\n189\t            }\n190\t            \"plte-null\" => {\n191\t                let (p, info) = new_write(a);\n192\t                (a.png_set_IHDR)(p, info, 4, 2, 8, 3, 0, 0, 0);\n193\t                (a.png_set_PLTE)(p, info, std::ptr::null(), 4);\n194\t                emit(\"set_PLTE(NULL) returned\");\n195\t            }\n196\t            \"plte-missing\" => {\n197\t                let (p, info) = new_write(a);\n198\t                (a.png_set_IHDR)(p, info, 4, 2, 8, 3, 0, 0, 0);\n199\t                (a.png_write_info)(p, info);\n200\t                emit(\"write_info returned\");\n201\t            }\n202\t            \"palette-index-out-of-range\" => {\n203\t                let (p, info) = new_write(a);\n204\t                (a.png_set_IHDR)(p, info, 4, 2, 8, 3, 0, 0, 0);\n205\t                let pal = [png_color { red: 1, green: 2, blue: 3 }; 2];\n206\t                (a.png_set_PLTE)(p, info, pal.as_ptr(), 2);\n207\t                (a.png_set_check_for_invalid_index)(p, 1);\n208\t                (a.png_write_info)(p, info);\n209\t                let row = [200u8, 201, 202, 203];\n210\t                (a.png_write_row)(p, row.as_ptr());\n211\t                (a.png_write_row)(p, row.as_ptr());\n212\t                emit(\"rows written\");\n213\t                (a.png_write_end)(p, info);\n214\t                emit(\"write_end returned\");\n215\t            }\n216\t\n217\t            // ---------------- tRNS ----------------\n218\t            _ if case.starts_with(\"trns:\") => {\n219\t                let f: Vec<&str> = case[5..].split(',').collect();\n220\t                let ct: c_int = f[0].parse().unwrap();\n221\t                let n: c_int = f[1].parse().unwrap();\n222\t                let use_alpha: bool = f[2] == \"1\";\n223\t                let (p, info) = new_write(a);\n224\t                (a.png_set_IHDR)(p, info, 4, 2, 8, ct, 0, 0, 0);\n225\t                if ct == 3 {\n226\t                    let pal = [png_color { red: 1, green: 2, blue: 3 }; 4];\n227\t                    (a.png_set_PLTE)(p, info, pal.as_ptr(), 4);\n228\t                }\n229\t                let alpha = vec![0x80u8; 300];\n230\t                let col = png_color_16 {\n231\t                    index: 0,\n232\t                    red: 1,\n233\t                    green: 2,\n234\t                    blue: 3,\n235\t                    gray: 4,\n236\t                };\n237\t                (a.png_set_tRNS)(\n238\t                    p,\n239\t                    info,\n240\t                    if use_alpha {\n241\t                        alpha.as_ptr()\n242\t                    } else {\n243\t                        std::ptr::null()\n244\t                    },\n245\t                    n,\n246\t                    if use_alpha { std::ptr::null() } else { &col },\n247\t                );\n248\t                emit(\"set_tRNS returned\");\n249\t                (a.png_write_info)(p, info);\n250\t                emit(\"write_info returned\");\n251\t            }\n252\t\n253\t            // ---------------- other chunk setters ----------------\n254\t            _ if case.starts_with(\"srgb:\") => {\n255\t                let i: c_int = case[5..].parse().unwrap();\n256\t                let (p, info) = new_write(a);\n257\t                hdr(a, p, info, 4, 2, 8, 2);\n258\t                (a.png_set_sRGB)(p, info, i);\n259\t                emit(\"set_sRGB returned\");\n260\t                (a.png_write_info)(p, info);\n261\t                emit(\"write_info returned\");\n262\t            }\n263\t            _ if case.starts_with(\"gama:\") => {\n264\t                let g: i32 = case[5..].parse().unwrap();\n265\t                let (p, info) = new_write(a);\n266\t                hdr(a, p, info, 4, 2, 8, 2);\n267\t                (a.png_set_gAMA_fixed)(p, info, g);\n268\t                emit(\"set_gAMA returned\");\n269\t                (a.png_write_info)(p, info);\n270\t                emit(\"write_info returned\");\n271\t            }\n272\t            _ if case.starts_with(\"sbit:\") => {\n273\t                let f: Vec<&str> = case[5..].split(',').collect();\n274\t                let ct: c_int = f[0].parse().unwrap();\n275\t                let bd: c_int = f[1].parse().unwrap();\n276\t                let v: u8 = f[2].parse().unwrap();\n277\t                let (p, info) = new_write(a);\n278\t                hdr(a, p, info, 4, 2, bd, ct);\n279\t                let s = png_color_8 {\n280\t                    red: v,\n281\t                    green: v,\n282\t                    blue: v,\n283\t                    gray: v,\n284\t                    alpha: v,\n285\t                };\n286\t                (a.png_set_sBIT)(p, info, &s);\n287\t                emit(\"set_sBIT returned\");\n288\t                (a.png_write_info)(p, info);\n289\t                