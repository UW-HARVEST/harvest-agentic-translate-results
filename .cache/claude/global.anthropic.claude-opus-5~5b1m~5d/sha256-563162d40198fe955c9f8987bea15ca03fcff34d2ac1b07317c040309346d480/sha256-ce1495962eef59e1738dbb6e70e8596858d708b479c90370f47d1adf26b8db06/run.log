(profile, profile_header,\n1416\t                               (sizeof profile_header));\n1417\t\n1418\t                           size = 12 * tag_count;\n1419\t\n1420\t                           (void)png_inflate_read(png_ptr, local_buffer,\n1421\t                               (sizeof local_buffer), &length,\n1422\t                               profile + (sizeof profile_header), &size, 0);\n1423\t\n1424\t                           /* Still expect a buffer error because we expect\n1425\t                            * there to be some tag data!\n1426\t                            */\n1427\t                           if (size == 0)\n1428\t                           {\n1429\t                              if (png_icc_check_tag_table(png_ptr,\n1430\t                                       keyword, profile_length, profile) != 0)\n1431\t                              {\n1432\t                                 /* The profile has been validated for basic\n1433\t                                  * security issues, so read the whole thing in.\n1434\t                                  */\n1435\t                                 size = profile_length - (sizeof profile_header)\n1436\t                                     - 12 * tag_count;\n1437\t\n1438\t                                 (void)png_inflate_read(png_ptr, local_buffer,\n1439\t                                     (sizeof local_buffer), &length,\n1440\t                                     profile + (sizeof profile_header) +\n1441\t                                     12 * tag_count, &size, 1/*finish*/);\n1442\t\n1443\t                                 if (length > 0 && !(png_ptr->flags &\n1444\t                                     PNG_FLAG_BENIGN_ERRORS_WARN))\n1445\t                                    errmsg = \"extra compressed data\";\n1446\t\n1447\t                                 /* But otherwise allow extra data: */\n1448\t                                 else if (size == 0)\n1449\t                                 {\n1450\t                                    if (length > 0)\n1451\t                                    {\n1452\t                                       /* This can be handled completely, so\n1453\t                                        * keep going.\n1454\t                                        */\n1455\t                                       png_chunk_warning(png_ptr,\n1456\t                                           \"extra compressed data\");\n1457\t                                    }\n1458\t\n1459\t                                    png_crc_finish(png_ptr, length);\n1460\t                                    finished = 1;\n1461\t\n1462\t                                    /* Steal the profile for info_ptr. */\n1463\t                                    if (info_ptr != NULL)\n1464\t                                    {\n1465\t                                       png_free_data(png_ptr, info_ptr,\n1466\t                                           PNG_FREE_ICCP, 0);\n1467\t\n1468\t                                       info_ptr->iccp_name = png_voidcast(char*,\n1469\t                                           png_malloc_base(png_ptr,\n1470\t                                           keyword_length+1));\n1471\t                                       if (info_ptr->iccp_name != NULL)\n1472\t                                       {\n1473\t                                          memcpy(info_ptr->iccp_name, keyword,\n1474\t                                              keyword_length+1);\n1475\t                                          info_ptr->iccp_proflen =\n1476\t                                              profile_length;\n1477\t                                          info_ptr->iccp_profile = profile;\n1478\t                                          png_ptr->read_buffer = NULL; /*steal*/\n1479\t                                          info_ptr->free_me |= PNG_FREE_ICCP;\n1480\t                                          info_ptr->valid |= PNG_INFO_iCCP;\n1481\t                                       }\n1482\t\n1483\t                                       else\n1484\t                                          errmsg = \"out of memory\";\n1485\t                                    }\n1486\t\n1487\t                                    /* else the profile remains in the read\n1488\t                                     * buffer which gets reused for subsequent\n1489\t                                     * chunks.\n1490\t                                     */\n1491\t\n1492\t                                    if (errmsg == NULL)\n1493\t                                    {\n1494\t                                       png_ptr->zowner = 0;\n1495\t                                       return handled_ok;\n1496\t                                    }\n1497\t                                 }\n1498\t                                 if (errmsg == NULL)\n1499\t                                    errmsg = png_ptr->zstream.msg;\n1500\t                              }\n1501\t                              /* else png_icc_check_tag_table output an error */\n1502\t                           }\n1503\t                           else /* profile truncated */\n1504\t                              errmsg = png_ptr->zstream.msg;\n1505\t                        }\n1506\t\n1507\t                        else\n1508\t                           errmsg = \"out of memory\";\n1509\t                     }\n1510\t\n1511\t                     /* else png_icc_check_header output an error */\n1512\t                  }\n1513\t\n1514\t                  /* else png_icc_check_length output an error */\n1515\t               }\n1516\t\n1517\t               else /* profile truncated */\n1518\t                  errmsg = png_ptr->zstream.msg;\n1519\t\n1520\t               /* Release the stream */\n1521\t               png_ptr->zowner = 0;\n1522\t            }\n1523\t\n1524\t            else /* png_inflate_claim failed */\n1525\t               errmsg = png_ptr->zstream.msg;\n1526\t         }\n1527\t\n1528\t         else\n1529\t            errmsg = \"bad compression method\"; /* or missing */\n1530\t      }\n1531\t\n1532\t      else\n1533\t         errmsg = \"bad keyword\";\n1534\t   }\n1535\t\n1536\t   /* Failure: the reason is in 'errmsg' */\n1537\t   if (finished == 0)\n1538\t      png_crc_finish(png_ptr, length);\n1539\t\n1540\t   if (errmsg != NULL) /* else already output */\n1541\t      png_chunk_benign_error(png_ptr, errmsg);\n1542\t\n1543\t   return handled_error;\n1544\t}\n1545\t#else\n1546\t#  define png_handle_iCCP NULL\n1547\t#endif /* READ_iCCP */\n1548\t\n1549\t#ifdef PNG_READ_sPLT_SUPPORTED\n1550\tstatic png_handle_result_code /* PRIVATE */\n1551\tpng_handle_sPLT(png_structrp png_ptr, png_inforp info_ptr, png_uint_32 length)\n1552\t/* Note: this does not properly handle chunks that are > 64K under DOS */\n1553\t{\n1554\t   png_bytep buffer;\n1555\t   png_bytep entry_start;\n1556\t   png_sPLT_t new_palette;\n1557\t   png_sPLT_entryp pp;\n1558\t   png_uint_32 data_length;\n1559\t   int entry_size, i;\n1560\t   png_uint_32 skip = 0;\n1561\t   png_uint_32 dl;\n1562\t   size_t max_dl;\n1563\t\n1564\t   png_debug(1, \"in png_handle_sPLT\");\n1565\t\n1566\t#ifdef PNG_USER_LIMITS_SUPPORTED\n1567\t   if (png_ptr->user_chunk_cache_max != 0)\n1568\t   {\n1569\t      if (png_ptr->user_chunk_cache_max == 1)\n1570\t      {\n1571\t         png_crc_finish(png_ptr, length);\n1572\t         return handled_error;\n1573\t      }\n1574\t\n1575\t      if (--png_ptr->user_chunk_cache_max == 1)\n1576\t      {\n1577\t         png_warning(png_ptr, \"No space in chunk cache for sPLT\");\n1578\t         png_crc_finish(png_ptr, length);\n1579\t         return handled_error;\n1580\t      }\n1581\t   }\n1582\t#endif\n1583\t\n1584\t   buffer = png_read_buffer(png_ptr, length+1);\n1585\t   if (buffer == NULL)\n1586\t   {\n1587\t      png_crc_finish(png_ptr, length);\n1588\t      png_chunk_benign_error(png_ptr, \"out of memory\");\n1589\t      return handled_error;\n1590\t   }\n1591\t\n1592\t\n1593\t   /* WARNING: this may break if size_t is less than 32 bits; it is assumed\n1594\t    * that the PNG_MAX_MALLOC_64K test is enabled in this case, but this is a\n1595\t    * potential breakage point if the types in pngconf.h aren't exactly right.\n1596\t    */\n1597\t   png_crc_read(png_ptr, buffer, length);\n1598\t\n1599\t   if (png_crc_finish(png_ptr, skip) != 0)\n1600\t      return handled_error;\n1601\t\n1602\t   buffer[length] = 0;\n1603\t\n1604\t   for (entry_start = buffer; *entry_start; entry_start++)\n1605\t      /* Empty loop to find end of name */ ;\n1606\t\n1607\t   ++entry_start;\n1608\t\n1609\t   /* A sample depth should follow the separator, and we should be on it  */\n1610\t   if (length < 2U || entry_start > buffer + (length - 2U))\n1611\t   {\n1612\t      png_warning(png_ptr, \"malformed sPLT chunk\");\n1613\t      return handled_error;\n1614\t   }\n1615\t\n1616\t   new_palette.depth = *entry_start++;\n1617\t   entry_size = (new_palette.depth == 8 ? 6 : 10);\n1618\t   /* This must fit in a png_uint_32 because it is derived from the original\n1619\t    * chunk data length.\n1620\t    */\n1621\t   data_length = length - (png_uint_32)(entry_start - buffer);\n1622\t\n1623\t   /* Integrity-check the data length */\n1624\t   if ((data_length % (unsigned int)entry_size) != 0)\n1625\t   {\n1626\t      png_warning(png_ptr, \"sPLT chunk has bad length\");\n1627\t      return handled_error;\n1628\t   }\n1629\t\n1630\t   dl = (png_uint_32)(data_length / (unsigned int)entry_size);\n1631\t   max_dl = PNG_SIZE_MAX / (sizeof (png_sPLT_entry));\n1632\t\n1633\t   if (dl > max_dl)\n1634\t   {\n1635\t      png_warning(png_ptr, \"sPLT chunk too long\");\n1636\t      return handled_error;\n1637\t   }\n1638\t\n1639\t   new_palette.nentries = (png_int_32)(data_length / (unsigned int)entry_size);\n1640\t\n1641\t   new_palette.entries = (png_sPLT_entryp)png_malloc_warn(png_ptr,\n1642\t       (png_alloc_size_t) new_palette.nentries * (s