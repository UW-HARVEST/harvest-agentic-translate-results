t l = libs();\n548\t        Both {\n549\t            c: Api::new(&l.c),\n550\t            rs: Api::new(&l.rs),\n551\t        }\n552\t    })\n553\t}\n554\t\n555\t/// Iterate over `(label, api)` for both libraries, C first.\n556\tpub fn each() -> [(&'static str, &'static Api); 2] {\n557\t    let b = apis();\n558\t    [(\"C\", &b.c), (\"RUST\", &b.rs)]\n559\t}\n560\t"}]},"parent_tool_use_id":"toolu_bdrk_01ULCxkZD4zFb42w4dLYkpGA","session_id":"d61bc42a-4e8d-424f-b737-52a7165119c7","uuid":"34d7b7ac-26b1-4b3e-9577-b8c5b465c7a5","timestamp":"2026-09-04T03:53:19.095Z","subagent_type":"general-purpose","task_description":"Write info set/get roundtrip tests"}
