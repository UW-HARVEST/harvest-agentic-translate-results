epth < 8)\n488\t   {\n489\t      png_const_bytep table;\n490\t      png_bytep rp;\n491\t      png_bytep row_end = row + row_info->rowbytes;\n492\t\n493\t      if (row_info->bit_depth == 1)\n494\t         table = onebppswaptable;\n495\t\n496\t      else if (row_info->bit_depth == 2)\n497\t         table = twobppswaptable;\n498\t\n499\t      else if (row_info->bit_depth == 4)\n500\t         table = fourbppswaptable;\n501\t\n502\t      else\n503\t         return;\n504\t\n505\t      for (rp = row; rp < row_end; rp++)\n506\t         *rp = table[*rp];\n507\t   }\n508\t}\n509\t#endif /* PACKSWAP || WRITE_PACKSWAP */\n510\t\n511\t#if defined(PNG_WRITE_FILLER_SUPPORTED) || \\\n512\t    defined(PNG_READ_STRIP_ALPHA_SUPPORTED)\n513\t/* Remove a channel - this used to be 'png_do_strip_filler' but it used a\n514\t * somewhat weird combination of flags to determine what to do.  All the calls\n515\t * to png_do_strip_filler are changed in 1.5.2 to call this instead with the\n516\t * correct arguments.\n517\t *\n518\t * The routine isn't general - the channel must be the channel at the start or\n519\t * end (not in the middle) of each pixel.\n520\t */\n521\tvoid /* PRIVATE */\n522\tpng_do_strip_channel(png_row_infop row_info, png_bytep row, int at_start)\n523\t{\n524\t   png_bytep sp = row; /* source pointer */\n525\t   png_bytep dp = row; /* destination pointer */\n526\t   png_bytep ep = row + row_info->rowbytes; /* One beyond end of row */\n527\t\n528\t   png_debug(1, \"in png_do_strip_channel\");\n529\t\n530\t   /* At the start sp will point to the first byte to copy and dp to where\n531\t    * it is copied to.  ep always points just beyond the end of the row, so\n532\t    * the loop simply copies (channels-1) channels until sp reaches ep.\n533\t    *\n534\t    * at_start:        0 -- convert AG, XG, ARGB, XRGB, AAGG, XXGG, etc.\n535\t    *            nonzero -- convert GA, GX, RGBA, RGBX, GGAA, RRGGBBXX, etc.\n536\t    */\n537\t\n538\t   /* GA, GX, XG cases */\n539\t   if (row_info->channels == 2)\n540\t   {\n541\t      if (row_info->bit_depth == 8)\n542\t      {\n543\t         if (at_start != 0) /* Skip initial filler */\n544\t            ++sp;\n545\t         else          /* Skip initial channel and, for sp, the filler */\n546\t         {\n547\t            sp += 2; ++dp;\n548\t         }\n549\t\n550\t         /* For a 1 pixel wide image there is nothing to do */\n551\t         while (sp < ep)\n552\t         {\n553\t            *dp++ = *sp; sp += 2;\n554\t         }\n555\t\n556\t         row_info->pixel_depth = 8;\n557\t      }\n558\t\n559\t      else if (row_info->bit_depth == 16)\n560\t      {\n561\t         if (at_start != 0) /* Skip initial filler */\n562\t            sp += 2;\n563\t         else          /* Skip initial channel and, for sp, the filler */\n564\t         {\n565\t            sp += 4; dp += 2;\n566\t         }\n567\t\n568\t         while (sp < ep)\n569\t         {\n570\t            *dp++ = *sp++; *dp++ = *sp; sp += 3;\n571\t         }\n572\t\n573\t         row_info->pixel_depth = 16;\n574\t      }\n575\t\n576\t      else\n577\t         return; /* bad bit depth */\n578\t\n579\t      row_info->channels = 1;\n580\t\n581\t      /* Finally fix the color type if it records an alpha channel */\n582\t      if (row_info->color_type == PNG_COLOR_TYPE_GRAY_ALPHA)\n583\t         row_info->color_type = PNG_COLOR_TYPE_GRAY;\n584\t   }\n585\t\n586\t   /* RGBA, RGBX, XRGB cases */\n587\t   else if (row_info->channels == 4)\n588\t   {\n589\t      if (row_info->bit_depth == 8)\n590\t      {\n591\t         if (at_start != 0) /* Skip initial filler */\n592\t            ++sp;\n593\t         else          /* Skip initial channels and, for sp, the filler */\n594\t         {\n595\t            sp += 4; dp += 3;\n596\t         }\n597\t\n598\t         /* Note that the loop adds 3 to dp and 4 to sp each time. */\n599\t         while (sp < ep)\n600\t         {\n601\t            *dp++ = *sp++; *dp++ = *sp++; *dp++ = *sp; sp += 2;\n602\t         }\n603\t\n604\t         row_info->pixel_depth = 24;\n605\t      }\n606\t\n607\t      else if (row_info->bit_depth == 16)\n608\t      {\n609\t         if (at_start != 0) /* Skip initial filler */\n610\t            sp += 2;\n611\t         else          /* Skip initial channels and, for sp, the filler */\n612\t         {\n613\t            sp += 8; dp += 6;\n614\t         }\n615\t\n616\t         while (sp < ep)\n617\t         {\n618\t            /* Copy 6 bytes, skip 2 */\n619\t            *dp++ = *sp++; *dp++ = *sp++;\n620\t            *dp++ = *sp++; *dp++ = *sp++;\n621\t            *dp++ = *sp++; *dp++ = *sp; sp += 3;\n622\t         }\n623\t\n624\t         row_info->pixel_depth = 48;\n625\t      }\n626\t\n627\t      else\n628\t         return; /* bad bit depth */\n629\t\n630\t      row_info->channels = 3;\n631\t\n632\t      /* Finally fix the color type if it records an alpha channel */\n633\t      if (row_info->color_type == PNG_COLOR_TYPE_RGB_ALPHA)\n634\t         row_info->color_type = PNG_COLOR_TYPE_RGB;\n635\t   }\n636\t\n637\t   else\n638\t      return; /* The filler channel has gone already */\n639\t\n640\t   /* Fix the rowbytes value. */\n641\t   row_info->rowbytes = (size_t)(dp-row);\n642\t}\n643\t#endif\n644\t\n645\t#if defined(PNG_READ_BGR_SUPPORTED) || defined(PNG_WRITE_BGR_SUPPORTED)\n646\t/* Swaps red and blue bytes within a pixel */\n647\tvoid /* PRIVATE */\n648\tpng_do_bgr(png_row_infop row_info, png_bytep row)\n649\t{\n650\t   png_debug(1, \"in png_do_bgr\");\n651\t\n652\t   if ((row_info->color_type & PNG_COLOR_MASK_COLOR) != 0)\n653\t   {\n654\t      png_uint_32 row_width = row_info->width;\n655\t      if (row_info->bit_depth == 8)\n656\t      {\n657\t         if (row_info->color_type == PNG_COLOR_TYPE_RGB)\n658\t         {\n659\t            png_bytep rp;\n660\t            png_uint_32 i;\n661\t\n662\t            for (i = 0, rp = row; i < row_width; i++, rp += 3)\n663\t            {\n664\t               png_byte save = *rp;\n665\t               *rp = *(r