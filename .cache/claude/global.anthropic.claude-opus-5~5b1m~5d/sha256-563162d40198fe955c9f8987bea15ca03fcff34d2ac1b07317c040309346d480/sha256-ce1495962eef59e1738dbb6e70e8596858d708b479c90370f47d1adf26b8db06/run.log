irst_row);\n3522\t            /* The division by two is safe because the caller passed in a\n3523\t             * stride which was multiplied by 2 (below) to get row_step.\n3524\t             */\n3525\t            ptrdiff_t row_step = display->row_step / 2;\n3526\t            unsigned int preserve_alpha = (image->format &\n3527\t                PNG_FORMAT_FLAG_ALPHA) != 0;\n3528\t            unsigned int outchannels = 1U+preserve_alpha;\n3529\t            int swap_alpha = 0;\n3530\t\n3531\t#           ifdef PNG_SIMPLIFIED_READ_AFIRST_SUPPORTED\n3532\t               if (preserve_alpha != 0 &&\n3533\t                   (image->format & PNG_FORMAT_FLAG_AFIRST) != 0)\n3534\t                  swap_alpha = 1;\n3535\t#           endif\n3536\t\n3537\t            for (pass = 0; pass < passes; ++pass)\n3538\t            {\n3539\t               unsigned int startx, stepx, stepy;\n3540\t               png_uint_32 y;\n3541\t\n3542\t               /* The 'x' start and step are adjusted to output components here.\n3543\t                */\n3544\t               if (png_ptr->interlaced == PNG_INTERLACE_ADAM7)\n3545\t               {\n3546\t                  /* The row may be empty for a short image: */\n3547\t                  if (PNG_PASS_COLS(width, pass) == 0)\n3548\t                     continue;\n3549\t\n3550\t                  startx = PNG_PASS_START_COL(pass) * outchannels;\n3551\t                  stepx = PNG_PASS_COL_OFFSET(pass) * outchannels;\n3552\t                  y = PNG_PASS_START_ROW(pass);\n3553\t                  stepy = PNG_PASS_ROW_OFFSET(pass);\n3554\t               }\n3555\t\n3556\t               else\n3557\t               {\n3558\t                  y = 0;\n3559\t                  startx = 0;\n3560\t                  stepx = outchannels;\n3561\t                  stepy = 1;\n3562\t               }\n3563\t\n3564\t               for (; y<height; y += stepy)\n3565\t               {\n3566\t                  png_const_uint_16p inrow;\n3567\t                  png_uin