      }\n    })\n}\n\n/// Iterate over `(label, api)` for both libraries, C first.\npub fn each() -> [(&'static str, &'static Api); 2] {\n    let b = apis();\n    [(\"C\", &b.c), (\"RUST\", &b.rs)]\n}\n'''\n\nTM = [\n    (\"png_const_structrp\", \"png_structp\"), (\"png_const_structp\", \"png_structp\"),\n    (\"png_structrp\", \"png_structp\"), (\"png_structp\", \"png_structp\"),\n    (\"png_structpp\", \"*mut png_structp\"),\n    (\"png_const_inforp\", \"png_infop\"), (\"png_const_infop\", \"png_infop\"),\n    (\"png_inforp\", \"png_infop\"), (\"png_infop\", \"png_infop\"),\n    (\"png_infopp\", \"*mut png_infop\"),\n    (\"png_imagep\", \"*mut png_image\"),\n    (\"png_const_bytep\", \"*const png_byte\"), (\"png_bytepp\", \"*mut *mut png_byte\"),\n    (\"png_bytep *\", \"*mut *mut png_byte\"), (\"png_bytepp *\", \"*mut *mut *mut png_byte\"),\n    (\"png_bytep\", \"*mut png_byte\"),\n    (\"png_const_charp\", \"*const c_char\"), (\"png_charpp *\", \"*mut *mut *mut c_char\"),\n    (\"png_charpp\", \"*mut *mut c_char\"), (\"png_charp *\", \"*mut *mut c_char\"),\n    (\"png_charp\", \"*mut c_char\"),\n    (\"png_const_colorp\", \"*const png_color\"), (\"png_colorp *\", \"*mut *mut png_color\"),\n    (\"png_colorp\", \"*mut png_color\"),\n    (\"png_const_color_8p\", \"*const png_color_8\"), (\"png_color_8p *\", \"*mut *mut png_color_8\"),\n    (\"png_color_8p\", \"*mut png_color_8\"),\n    (\"png_const_color_16p\", \"*const png_color_16\"),\n    (\"png_color_16p *\", \"*mut *mut png_color_16\"), (\"png_color_16p\", \"*mut png_color_16\"),\n    (\"png_const_timep\", \"*const png_time\"), (\"png_timep *\", \"*mut *mut png_time\"),\n    (\"png_timep\", \"*mut png_time\"),\n    (\"png_const_textp\", \"*const png_text\"), (\"png_textp *\", \"*mut *mut png_text\"),\n    (\"png_textp\", \"*mut png_text\"),\n    (\"png_sPLT_tpp\", \"*mut *mut png_sPLT_t\"), (\"png_const_sPLT_tp\", \"*const png_sPLT_t\"),\n    (\"png_unknown_chunkpp\", \"*mut *mut png_unknown_chunk\"),\n    (