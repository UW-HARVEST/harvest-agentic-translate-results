l printLine","+/// leave","+/// ret","+/// ```","+///","+/// so the slot is at `entry_rsp - 16`. The naked function below emits exactly","+/// that sequence, which makes the Rust `bad()` read the identical byte range of","+/// the identical stack address for an identical call site — and therefore","+/// produce identical output (or an identical fault).","+///","+/// Stack alignment note: the SysV ABI guarantees `entry_rsp % 16 == 8`, so at the","+/// inner `call` we have `rsp = entry_rsp - 24 ≡ 0 (mod 16)`, exactly as gcc does.","+#[cfg(all(target_arch = \"x86_64\", target_os = \"linux\"))]"," #[unsafe(no_mangle)]","+#[unsafe(naked)]"," pub unsafe extern \"C\" fn bad() {","-    // Stale/garbage stack contents: a non-NULL pointer whose first byte is 0.","+    core::arch::naked_asm!(","+        \"push rbp\",","+        \"mov  rbp, rsp\",","+        \"sub  rsp, 16\",","+        \"mov  rax, qword ptr [rbp - 8]\",","+        \"mov  rdi, rax\",","+        \"call {print_line}\",","+        \"leave\",","+        \"ret\",","+        print_line = sym printLine,","+    )","+}","+","+/// Portable fallback for targets where the exact `gcc -O0` frame layout cannot","+/// be reproduced. It mirrors the *typical* observed behaviour of the C build","+/// (a non-NULL pointer to an empty string, i.e. a bare newline) because the","+/// value of an indeterminate slot cannot be modelled portably.","+#[cfg(not(all(target_arch = \"x86_64\", target_os = \"linux\")))]","+#[unsafe(no_mangle)]","+pub unsafe extern \"C\" fn bad() {","     static GARBAGE: [c_char; 1] = [0];","     let data: *const c_char = GARBAGE.as_ptr();","     printLine(data);"," }"," ","-/// void good(void)","+/// ```c","+/// void good()","+/// {","+///     char *data;","+///     data = \"string\";","+///     printLine(data);","+/// }","+/// ```"," #[unsafe(no_mangle)]"," pub unsafe extern \"C\" fn good() {","-    // char *data; data = \"string\";","-    const STRING: [c_char; 7] = [","-        b's' as c_char,","-        b't