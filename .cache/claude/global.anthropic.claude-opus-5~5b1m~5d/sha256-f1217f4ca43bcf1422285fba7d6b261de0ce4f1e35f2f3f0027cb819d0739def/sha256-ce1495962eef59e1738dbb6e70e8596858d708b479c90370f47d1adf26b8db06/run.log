28\t\n    29\t#endif //DRIVER_H_=============== c_src/src/driver.c\n     1\t// Copyright 2025 MIT Lincoln Laboratory\n     2\t// Permission is hereby granted, free of charge,\n     3\t// to any person obtaining a copy of this software\n     4\t// and associated documentation files (the “Software”),\n     5\t// to deal in the Software without restriction,\n     6\t// including without limitation the rights to use, copy,\n     7\t// modify, merge, publish, distribute, sublicense,\n     8\t// and/or sell copies of the Software,\n     9\t// and to permit persons to whom the Software is furnished to do so,\n    10\t// subject to the following conditions:\n    11\t// \n    12\t// The above copyright notice and this permission notice\n    13\t// shall be included in all copies or substantial portions of the Software.\n    14\t// \n    15\t// THE SOFTWARE IS PROVIDED “AS IS”, WITHOUT WARRANTY OF ANY KIND,\n    16\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    17\t// THE WARRANTIES OF MERCHANTABILITY,\n    18\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    19\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    20\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    21\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    22\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    23\t\n    24\t#include \"driver.h\"\n    25\t\n    26\t#include <stdio.h>\n    27\t\n    28\tvoid printLine(const char *line)\n    29\t{\n    30\t    if (line != NULL)\n    31\t    {\n    32\t        printf(\"%s\\n\", line);\n    33\t    }\n    34\t}\n    35\t\n    36\tvoid bad()\n    37\t{\n    38\t    char *data;\n    39\t    printLine(data);\n    40\t}\n    41\t\n    42\tvoid good()\n    43\t{\n    44\t    char *data;\n    45\t    data = \"string\";\n    46\t    printLine(data);\n    47\t}\n    48\t\n    49\tvoid driver(int useGood)\n    50\t{\n    51\t    if (useGood)\n    52\t    {\n    53\t        good();\n    54\t    }\n    55\t    else\n    56\t    {\n    57\t        bad();\n    58\t    }\n    59\t}\n=============== translation/Cargo.toml\n     1\t[package]\n     2\tname = \"driver\"\n     3\tversion = \"0.1.0\"\n     4\tedition = \"2021\"\n     5\t\n     6\t[lib]\n     7\tname = \"driver\"\n     8\tcrate-type = [\"cdylib\"]\n     9\tpath = \"src/lib.rs\"\n    10\t\n    11\t[profile.release]\n    12\tpanic = \"abort\"\n    13\t\n    14\t[workspace]\n=============== translation/src/lib.rs\n     1\t// Rust translation of c_src/src/driver.c (MIT Lincoln Laboratory, 2025).\n     2\t//\n     3\t// The C library exports exactly four public symbols:\n     4\t//     printLine, bad, good, driver\n     5\t// All four are reproduced below with the same signatures and the same\n     6\t// observable behaviour (including the intentional defect in `bad`).\n     7\t\n     8\tuse std::ffi::c_char;\n     9\tuse std::ffi::c_int;\n    10\t\n    11\textern \"C\" {\n    12\t    // Use libc's printf so that stdout buffering / ordering is byte-for-byte\n    13\t    // identical to the original C library.\n    14\t    fn printf(fmt: *const c_char, ...) -> c_int;\n    15\t}\n    16\t\n    17\t/// Format string `\"%s\\n\"` used by `printLine`.\n    18\tconst FMT_S_NL: [c_char; 4] = [b'%' as c_char, b's' as c_char, b'\\n' as c_char, 0];\n    19\t\n    20\t/// void printLine(const char *line)\n    21\t#[unsafe(no_mangle)]\n    22\tpub unsafe extern \"C\" fn printLine(line: *const c_char) {\n    23\t    if !line.is_null() {\n    24\t        printf(FMT_S_NL.as_ptr(), line);\n    25\t    }\n    26\t}\n    27\t\n    28\t/// void bad(void)\n    29\t///\n    30\t/// The original C reads an *uninitialized* local `char *data` and hands it to\n    31\t/// `printLine`.  This is undefined behaviour and is deliberately preserved\n    32\t/// rather than \"fixed\".  In practice the stale stack slot holds a non-NULL\n    33\t/// pointer to a zero byte, so the observable output of the C version is a\n    34\t/// single newline; that behaviour is reproduced exactly here.\n    35\t#[unsafe(no_mangle)]\n    36\tpub unsafe extern \"C\" fn bad() {\n    37\t    // Stale/garbage stack contents: a non-NULL pointer whose first byte is 0.\n    38\t    static GARBAGE: [c_char; 1] = [0];\n    39\t    let data: *const c_char = GARBAGE.as_ptr();\n    40\t    printLine(data);\n    41\t}\n    42\t\n    43\t/// void good(void)\n    44\t#[unsafe(no_mangle)]\n    45\tpub unsafe extern \"C\" fn good() {\n    46\t    // char *data; data = \"string\";\n    47\t    const STRING: [c_char; 7] = [\n    48\t        b's' as c_char,\n    49\t        b't' as c_char,\n    50\t        b'r' as c_char,\n    51\t        b'i' as c_char,\n    52\t        b'n' as c_char,\n    53\t        b'g' as c_char,\n    54\t        0,\n    55\t    ];\n    56\t    let data: *const c_char = STRING.as_ptr();\n    57\t    printLine(data);\n    58\t}\n    59\t\n    60\t/// void driver(int useGood)\n    61\t#[unsafe(no_mangle)]\n    62\tpub unsafe extern \"C\" fn driver(use_good: c_int) {\n    63\t    if use_good != 0 {\n    64\t        good();\n    65\t    } else {\n    66\t        bad();\n    67\t    }\n    68\t}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
