        break;\n        }\n        assert!(r >= 0, \"waitpid failed\");\n    }\n    drop(file);\n\n    let mut out = Vec::new();\n    fs::File::open(&path)\n        .expect(\"reopen isolation file\")\n        .read_to_end(&mut out)\n        .expect(\"read isolation file\");\n    let _ = fs::remove_file(&path);\n    Isolated { out, status }\n}\n\n/// Differential assertion for cases that may crash: compares BOTH the bytes\n/// written and the termination status (exit code / fatal signal).\npub fn assert_same_isolated<F>(case: &str, mut f: F)\nwhere\n    F: FnMut(&Api),\n{\n    let p = pair();\n    let _guard = capture_lock();\n    let c = run_isolated_locked(|| f(&p.c));\n    let r = run_isolated_locked(|| f(&p.rust));\n    assert!(\n        c == r,\n        \"isolated mismatch for case `{case}`\\n  C   : {}\\n  Rust: {}\",\n        c.describe(),\n        r.describe()\n    );\n}\n\n// ---------------------------------------------------------------------------\n// Stack dirtying — the axis the uninitialized read in `bad()` is sensitive to\n// ---------------------------------------------------------------------------"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4231,"cache_read_input_tokens":61505,"cache_creation":{"ephemeral_5m_input_tokens":4231,"ephemeral_1h_input_tokens":0},"output_tokens":20,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"e25d0245-0da3-449f-ad2c-b94e24aa7eb9","uuid":"1e630b62-9f36-4b54-81f2-62b3d3301686","timestamp":"2026-08-28T12:03:21.638Z"}
