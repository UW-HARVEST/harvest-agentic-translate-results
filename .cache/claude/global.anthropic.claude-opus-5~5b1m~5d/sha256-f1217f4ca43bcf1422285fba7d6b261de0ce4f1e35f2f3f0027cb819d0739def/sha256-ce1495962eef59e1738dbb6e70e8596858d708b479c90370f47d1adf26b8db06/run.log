a subsequent `bad()` call at the same stack depth reads, which is","+/// why the C prints `string` for the sequence `good(); bad();`.","+#[cfg(all(target_arch = \"x86_64\", target_os = \"linux\"))]"," #[unsafe(no_mangle)]","+#[unsafe(naked)]"," pub unsafe extern \"C\" fn good() {","-    let data: *const c_char = STRING_LITERAL.as_ptr();","-    printLine(data);","+    core::arch::naked_asm!(","+        \"push rbp\",","+        \"mov  rbp, rsp\",","+        \"sub  rsp, 16\",","+        \"lea  rax, [rip + {lit}]\",","+        \"mov  qword ptr [rbp - 8], rax\",","+        \"mov  rax, qword ptr [rbp - 8]\",","+        \"mov  rdi, rax\",","+        \"call {print_line}\",","+        \"nop\",","+        \"leave\",","+        \"ret\",","+        lit = sym STRING_LITERAL,","+        print_line = sym printLine,","+    )"," }"," "," /// ```c"]},{"oldStart":134,"oldLines":10,"newStart":208,"newLines":90,"lines":[" /// }"," /// ```"," ///","-/// Note the C tests plain truthiness, so *every* non-zero `int` — including","-/// negative values, `INT_MIN`, `INT_MAX` and any value that would be an","-/// out-of-range enum — selects `good()`. Only exactly `0` selects `bad()`.","+/// The C tests plain truthiness, so *every* non-zero `int` — negative values,","+/// `INT_MIN`, `INT_MAX`, and any value that would be an out-of-range enum —","+/// selects `good()`; only exactly `0` selects `bad()`. Note also that the","+/// parameter arrives in `%edi`, so a wider value is truncated to 32 bits before","+/// the test.","+///","+/// gcc -O0 emits:","+/// ```text","+/// push %rbp; mov %rsp,%rbp; sub $0x10,%rsp","+/// mov  %edi,-0x4(%rbp)","+/// cmpl $0x0,-0x4(%rbp)","+/// je   .Lbad","+/// mov  $0x0,%eax; call good@plt","+/// jmp  .Lend","+/// .Lbad: mov $0x0,%eax; call bad@plt","+/// .Lend: nop; leave; ret","+/// ```","+///","+/// The `sub $0x10,%rsp` here is what places `bad`'s indeterminate slot at","+/// `driver_entry_rsp - 40`; a differently sized frame reads different memory and","+/// changes the program's output, so the frame size is part of the contract.","+#[cfg(all(target_arch = \"x86_64\", target_os = \"linux\"))]"," #[unsafe(no_mangle)]","+#[unsafe(naked)]","+pub unsafe extern \"C\" fn driver(_useGood: c_int) {","+    core::arch::naked_asm!(","+        \"push rbp\",","+        \"mov  rbp, rsp\",","+        \"sub  rsp, 16\",","+        \"mov  dword ptr [rbp - 4], edi\",","+        \"cmp  dword ptr [rbp - 4], 0\",","+        \"je   2f\",","+        \"mov  eax, 0\",","+        \"call {good}\",","+        \"jmp  3f\",","+        \"2:\",","+        \"mov  eax, 0\",","+        \"call {bad}\",","+        \"3:\",","+        \"nop\",","+        \"leave\",","+        \"ret\",","+        good = sym good,","+        bad = sym bad,","+    )","+}","+","+// ===========================================================================","+// Portable fallback (non x86-64-Linux targets)","+// ===========================================================================","+//","+// Here the exact frame layout of `gcc -O0` cannot be pinned, so the","+// indeterminate read in `bad()` cannot be modelled. These definitions implement","+// the C's *specified* behaviour and, for `bad()`, the most common outcome","+// observed from the reference build (a non-NULL pointer to an empty string, i.e.","+// a bare newline).","+","+/// See the x86-64 definition for documentation.","+#[cfg(not(all(target_arch = \"x86_64\", target_os = \"linux\")))]","+#[unsafe(no_mangle)]","+pub unsafe extern \"C\" fn printLine(line: *const c_char) {","+    if !line.is_null() {","+        puts(line);","+    }","+}","+","+/// See the x86-64 definition for documentation.","+#[cfg(not(all(target_arch = \"x86_64\", target_os = \"linux\")))]","+#[unsafe(no_mangle)]","+pub unsafe extern \"C\" fn bad() {","+    static GARBAGE: [c_char; 1] = [0];","+    printLine(GARBAGE.as_ptr());","+}","+","+/// See the x86-64 definition for documentation.","+#[cfg(not(all(target_arch = \"x86_64\", target_os = \"linux\")))]","+#[unsafe(no_mangle)]","+pub unsafe extern \"C\" fn good() {","+    printLine(STRING_LITERAL.as_ptr());","+}","+","+/// See the x86-64 definition for documentation.","+#[cfg(not(all(target_arch = \"x86_64\", target_os = \"linux\")))]","+#[unsafe(no_mangle)]"," pub unsafe extern \"C\" fn driver(useGood: c_int) {","     if useGood != 0 {","         good();"]}],"originalFile":"// Rust translation of c_src/src/driver.c (MIT Lincoln Laboratory, 2025).\n//\n// The C library exports exactly four public symbols:\n//     printLine, bad, good, driver\n// All four are reproduced below with the same signatures and the same\n// observable behaviour (including the intentional defect in `bad`).\n\n#![allow(non_snake_case)]\n\nuse std::ffi::c_char;\nuse std::ffi::c_int;\n\nextern \"C\" {\n    // Use libc's printf so that stdout buffering / ordering is byte-for-byte\n    // identical to the original C library.\n    fn printf(fmt: *const c_char, ...) -> c_int;\n}\n\n/// Format string `\"%s\\n\"` used by `printLine`.\nstatic FMT_S_NL: [c_char; 4] = [b'%' as c_char, b's' as c_char, b'\\n' as c_char, 0];\n\n/// The string literal `\"string\"` assigned to `data` in `good()`.\nstatic STRING_LITERAL: [c_char; 7] = [\n    b's' as c_char,\n    b't' as c_char,\n    b'r' as c_char,\n    b'i' as c_char,\n    b'n' as c_char,\n    b'g' as c_char,\n    0,\n];\n\n/// ```c\n/// void printLine(const char *line)\n/// {\n///     if (line != NULL)\n///     {\n///         printf(\"%s\\n\", line);\n///     }\n/// }\n/// ```\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn printLine(line: *const c_char) {\n    if !line.is_null() {\n        printf(FMT_S_NL.as_ptr(), line);\n    }\n}\n\n/// ```c\n/// void bad()\n/// {\n///     char *data;\n///     printLine(data);\n/// }\n/// ```\n///\n/// `data` is **never initialised**: the C reads an indeterminate 8-byte stack\n/// slot and passes it straight to `printLine`. This is the intentional defect of\n/// the sample (CWE-457, use of an uninitialised variable) and it is *preserved*,\n/// not fixed.\n///\n/// Because the value read is literally \"whatever the caller left on the stack\",\n/// the observable behaviour of the C is caller-dependent: it prints nothing when\n/// the stale slot happens to be `NULL`, prints stale bytes when it is a readable\n/// pointer, and faults when it is not. Reproducing that faithfully means\n/// reproducing the *frame layout*, so that the Rust reads the exact same address\n/// as the C does. `gcc -O0` compiles the C body to\n///\n/// ```text\n/// push %rbp                  ; rsp -= 8\n/// mov  %rsp,%rbp\n/// sub  $0x10,%rsp\n/// mov  -0x8(%rbp),%rax       ; <-- the indeterminate read, at entry_rsp - 16\n/// mov  %rax,%rdi\n/// call printLine\n/// leave\n/// ret\n/// ```\n///\n/// so the slot is at `entry_rsp - 16`. The naked function below emits exactly\n/// that sequence, which makes the Rust `bad()` read the identical byte range of\n/// the identical stack address for an identical call site — and therefore\n/// produce identical output (or an identical fault).\n///\n/// Stack alignment note: the SysV ABI guarantees `entry_rsp % 16 == 8`, so at the\n/// inner `call` we have `rsp = entry_rsp - 24 ≡ 0 (mod 16)`, exactly as gcc does.\n#[cfg(all(target_arch = \"x86_64\", target_os = \"linux\"))]\n#[unsafe(no_mangle)]\n#[unsafe(naked)]\npub unsafe extern \"C\" fn bad() {\n    core::arch::naked_asm!(\n        \"push rbp\",\n        \"mov  rbp, rsp\",\n        \"sub  rsp, 16\",\n        \"mov  rax, qword ptr [rbp - 8]\",\n        \"mov  rdi, rax\",\n        \"call {print_line}\",\n        \"leave\",\n        \"ret\",\n        print_line = sym printLine,\n    )\n}\n\n/// Portable fallback for targets where the exact `gcc -O0` frame layout cannot\n/// be reproduced. It mirrors the *typical* observed behaviour of the C build\n/// (a non-NULL pointer to an empty string, i.e. a bare newline) because the\n/// value of an indeterminate slot cannot be modelled portably.\n#[cfg(not(all(target_arch = \"x86_64\", target_os = \"linux\")))]\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn bad() {\n    static GARBAGE: [c_char; 1] = [0];\n    let data: *const c_char = GARBAGE.as_ptr();\n    printLine(data);\n}\n\n/// ```c\n/// void good()\n/// {\n///     char *data;\n///     data = \"string\";\n///     printLine(data);\n/// }\n/// ```\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn good() {\n    let data: *const c_char = STRING_LITERAL.as_ptr();\n    printLine(data);\n}\n\n/// ```c\n/// void driver(int useGood)\n/// {\n///     if (useGood) { good(); } else { bad(); }\n/// }\n/// ```\n///\n/// Note the C tests plain truthiness, so *every* non-zero `int` — including\n/// negative values, `INT_MIN`, `INT_MAX` and any value that would be an\n/// out-of-range enum — selects `good()`. Only exactly `0` selects `bad()`.\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn driver(useGood: c_int) {\n    if useGood != 0 {\n        good();\n    } else {\n        bad();\n    }\n}\n","userModified":false}}
