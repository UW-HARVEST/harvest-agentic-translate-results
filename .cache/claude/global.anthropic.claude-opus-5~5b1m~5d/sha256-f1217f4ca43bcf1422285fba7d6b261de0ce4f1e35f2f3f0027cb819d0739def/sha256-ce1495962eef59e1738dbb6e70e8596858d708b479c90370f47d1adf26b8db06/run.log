   _ => api.bad(),","+                }","+            });","+            eprintln!(\"{nm:<5} {label:<12} {}\", r.describe());","+        }","     }","     for fill in [0u64, 0x4141_4141_4141_4141, 0xdead_beef_dead_beef, 1] {","         for depth in 0..3u32 {","             for (nm, api) in [(\"C\", &p.c), (\"Rust\", &p.rust)] {","-                let out = capture(|| {","+                let r = run_isolated(|| {","                     dirty_stack(fill, depth);","                     unsafe { api.bad() }","                 });","-                show(&format!(\"{nm} bad f={fill:016x} d={depth}\"), &out);","-                let out = capture(|| {","+                eprintln!(\"{nm:<5} bad  f={fill:016x} d={depth}  {}\", r.describe());","+                let r = run_isolated(|| {","                     dirty_stack(fill, depth);","                     unsafe { api.driver(0) }","                 });","-                show(&format!(\"{nm} drv0 f={fill:016x} d={depth}\"), &out);","+                eprintln!(\"{nm:<5} drv0 f={fill:016x} d={depth}  {}\", r.describe());","             }","         }","     }"]}],"originalFile":"//! Exploratory probe (not an assertion test): prints what each `.so` writes for\n//! the uninitialized-read paths so the divergence can be inspected with\n//! `cargo test --test probe_ub -- --nocapture`.\n\nmod common;\n\nuse common::*;\n\nfn show(label: &str, b: &[u8]) {\n    let hex: Vec<String> = b.iter().take(32).map(|x| format!(\"{x:02x}\")).collect();\n    eprintln!(\"{label:<28} len={} [{}]\", b.len(), hex.join(\" \"));\n}\n\n#[test]\nfn probe_uninitialized_paths() {\n    let p = pair();\n    for (nm, api) in [(\"C\", &p.c), (\"Rust\", &p.rust)] {\n        show(&format!(\"{nm} good()\"), &capture(|| unsafe { api.good() }));\n        show(&format!(\"{nm} driver(1)\"), &capture(|| unsafe { api.driver(1) }));\n        show(&format!(\"{nm} driver(0)\"), &capture(|| unsafe { api.driver(0) }));\n        show(&format!(\"{nm} bad()\"), &capture(|| unsafe { api.bad() }));\n    }\n    for fill in [0u64, 0x4141_4141_4141_4141, 0xdead_beef_dead_beef, 1] {\n        for depth in 0..3u32 {\n            for (nm, api) in [(\"C\", &p.c), (\"Rust\", &p.rust)] {\n                let out = capture(|| {\n                    dirty_stack(fill, depth);\n                    unsafe { api.bad() }\n                });\n                show(&format!(\"{nm} bad f={fill:016x} d={depth}\"), &out);\n                let out = capture(|| {\n                    dirty_stack(fill, depth);\n                    unsafe { api.driver(0) }\n                });\n                show(&format!(\"{nm} drv0 f={fill:016x} d={depth}\"), &out);\n            }\n        }\n    }\n}\n","userModified":false}}
