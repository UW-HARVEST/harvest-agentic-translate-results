      eprintln!(\"{nm:<5} {label:<12} {}\", r.describe());\n        }\n    }\n    for fill in [0u64, 0x4141_4141_4141_4141, 0xdead_beef_dead_beef, 1] {\n        for depth in 0..3u32 {\n            for (nm, api) in [(\"C\", &p.c), (\"Rust\", &p.rust)] {\n                let r = run_isolated(|| {\n                    dirty_stack(fill, depth);\n                    unsafe { api.bad() }\n                });\n                eprintln!(\"{nm:<5} bad  f={fill:016x} d={depth}  {}\", r.describe());\n                let r = run_isolated(|| {\n                    dirty_stack(fill, depth);\n                    unsafe { api.driver(0) }\n                });\n                eprintln!(\"{nm:<5} drv0 f={fill:016x} d={depth}  {}\", r.describe());\n            }\n        }\n    }\n}\n","userModified":false}}
