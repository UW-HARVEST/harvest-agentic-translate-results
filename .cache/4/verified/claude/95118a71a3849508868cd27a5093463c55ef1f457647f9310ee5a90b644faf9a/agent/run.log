{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01EsrD3wgLgArooaK9mM5erU","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/` (an stb_ds-style implementation\n2\t//! plus the `arr_del`/`strkey` test helpers).\n3\t//!\n4\t//! The translation is intentionally literal: allocation sizes, memory layouts,\n5\t//! integer wrap-around, sign-extension quirks and the exact order of operations\n6\t//! of the original C code are all preserved so that the resulting shared object\n7\t//! is behaviourally (byte-for-byte) identical to the C one.\n8\t\n9\t#![allow(non_camel_case_types)]\n10\t#![allow(non_snake_case)]\n11\t#![allow(non_upper_case_globals)]\n12\t#![allow(dead_code)]\n13\t#![allow(clippy::missing_safety_doc)]\n14\t\n15\tuse core::ffi::{c_char, c_int, c_void};\n16\tuse core::mem::size_of;\n17\t\n18\tmod arena;\n19\tmod array;\n20\tmod hash;\n21\tmod hashmap;\n22\tmod tests;\n23\t\n24\t#[allow(unused_imports)]\n25\tpub(crate) use arena::*;\n26\t#[allow(unused_imports)]\n27\tpub(crate) use array::*;\n28\t#[allow(unused_imports)]\n29\tpub(crate) use hash::*;\n30\t#[allow(unused_imports)]\n31\tpub(crate) use hashmap::*;\n32\t\n33\t// ---------------------------------------------------------------------------\n34\t// libc bindings.  The C code uses realloc()/free()/mem*()/str*() directly; we\n35\t// call the very same functions so that ownership of blocks handed out by (or\n36\t// handed back to) this library stays 100% compatible with the C version.\n37\t// ---------------------------------------------------------------------------\n38\textern \"C\" {\n39\t    pub(crate) fn realloc(p: *mut c_void, size: usize) -> *mut c_void;\n40\t    pub(crate) fn free(p: *mut c_void);\n41\t    pub(crate) fn memset(s: *mut c_void, c: c_int, n: usize) -> *mut c_void;\n42\t    pub(crate) fn memcpy(d: *mut c_void, s: *const c_void, n: usize) -> *mut c_void;\n43\t    pub(crate) fn memmove(d: *mut c_void, s: *const c_void, n: usize) -> *mut c_void;\n44\t    pub(crate) fn memcmp(a: *const c_void, b: *const c_void, n: usize) -> c_int;\n45\t    pub(crate) fn strcmp(a: *const c_char, b: *const c_char) -> c_int;\n46\t    pub(crate) fn strlen(s: *const c_char) -> usize;\n47\t}\n48\t\n49\t// ---------------------------------------------------------------------------\n50\t// STBDS_REALLOC / STBDS_FREE\n51\t// ---------------------------------------------------------------------------\n52\t#[inline]\n53\tpub(crate) unsafe fn STBDS_REALLOC(p: *mut c_void, s: usize) -> *mut c_void {\n54\t    realloc(p, s)\n55\t}\n56\t\n57\t#[inline]\n58\tpub(crate) unsafe fn STBDS_FREE(p: *mut c_void) {\n59\t    free(p)\n60\t}\n61\t\n62\t// ---------------------------------------------------------------------------\n63\t// Structures (all layout-compatible with the C originals)\n64\t// ---------------------------------------------------------------------------\n65\t\n66\t/// ```c\n67\t/// typedef struct {\n68\t///   size_t length; size_t capacity; void *hash_table; ptrdiff_t temp;\n69\t/// } stbds_array_header;\n70\t/// ```\n71\t#[repr(C)]\n72\tpub(crate) struct stbds_array_header {\n73\t    pub length: usize,\n74\t    pub capacity: usize,\n75\t    pub hash_table: *mut c_void,\n76\t    pub temp: isize,\n77\t}\n78\t\n79\t/// ```c\n80\t/// typedef struct stbds_string_block {\n81\t///   struct stbds_string_block *next; char storage[8];\n82\t/// } stbds_string_block;\n83\t/// ```\n84\t#[repr(C)]\n85\tpub struct stbds_string_block {\n86\t    pub next: *mut stbds_string_block,\n87\t    pub storage: [c_char; 8],\n88\t}\n89\t\n90\t/// ```c\n91\t/// struct stbds_string_arena {\n92\t///   stbds_string_block *storage; size_t remaining;\n93\t///   unsigned char block; unsigned char mode;\n94\t/// };\n95\t/// ```\n96\t#[repr(C)]\n97\t#[derive(Clone, Copy)]\n98\tpub struct stbds_string_arena {\n99\t    pub storage: *mut stbds_string_block,\n100\t    pub remaining: usize,\n101\t    pub block: u8,\n102\t    pub mode: u8,\n103\t}\n104\t\n105\t/// ```c\n106\t/// typedef struct {\n107\t///   size_t hash[STBDS_BUCKET_LENGTH]; ptrdiff_t index[STBDS_BUCKET_LENGTH];\n108\t/// } stbds_hash_bucket;\n109\t/// ```\n110\t#[repr(C)]\n111\tpub(crate) struct stbds_hash_bucket {\n112\t    pub hash: [usize; STBDS_BUCKET_LENGTH],\n113\t    pub index: [isize; STBDS_BUCKET_LENGTH],\n114\t}\n115\t\n116\t/// ```c\n117\t/// typedef struct {\n118\t///   char *temp_key;\n119\t///   size_t slot_count, used_count, used_count_threshold,\n120\t///          used_count_shrink_threshold, tombstone_count,\n121\t///          tombstone_count_threshold, seed, slot_count_log2;\n122\t///   stbds_string_arena string;\n123\t///   stbds_hash_bucket *storage;\n124\t/// } stbds_hash_index;\n125\t/// ```\n126\t#[repr(C)]\n127\tpub(crate) struct stbds_hash_index {\n128\t    pub temp_key: *mut c_char,\n129\t    pub slot_count: usize,\n130\t    pub used_count: usize,\n131\t    pub used_count_threshold: usize,\n132\t    pub used_count_shrink_threshold: usize,\n133\t    pub tombstone_count: usize,\n134\t    pub tombstone_count_threshold: usize,\n135\t    pub seed: usize,\n136\t    pub slot_count_log2: usize,\n137\t    pub string: stbds_string_arena,\n138\t    pub storage: *mut stbds_hash_bucket,\n139\t}\n140\t\n141\t// ---------------------------------------------------------------------------\n142\t// Constants\n143\t// ---------------------------------------------------------------------------\n144\tpub(crate) const STBDS_HM_BINARY: c_int = 0;\n145\tpub(crate) const STBDS_HM_STRING: c_int = 1;\n146\t\n147\tpub(crate) const STBDS_SH_NONE: u8 = 0;\n148\tpub(crate) const STBDS_SH_DEFAULT: u8 = 1;\n149\tpub(crate) const STBDS_SH_STRDUP: u8 = 2;\n150\tpub(crate) const STBDS_SH_ARENA: u8 = 3;\n151\t\n152\tpub(crate) const STBDS_BUCKET_LENGTH: usize = 8;\n153\tpub(crate) const STBDS_BUCKET_SHIFT: usize = 3;\n154\tpub(crate) const STBDS_BUCKET_MASK: usize = STBDS_BUCKET_LENGTH - 1;\n155\tpub(crate) const STBDS_CACHE_LINE_SIZE: usize = 64;\n156\t\n157\tpub(crate) const STBDS_INDEX_EMPTY: isize = -1;\n158\tpub(crate) const STBDS_INDEX_DELETED: isize = -2;\n159\t\n160\tpub(crate) const STBDS_HASH_EMPTY: usize = 0;\n161\tpub(crate) const STBDS_HASH_DELETED: usize = 1;\n162\t\n163\tpub(crate) const STBDS_SIZE_T_BITS: u32 = (size_of::<usize>() as u32) * 8;\n164\t\n165\t#[inline]\n166\tpub(crate) fn STBDS_INDEX_IN_USE(x: isize) -> bool {\n167\t    x >= 0\n168\t}\n169\t\n170\t#[inline]\n171\tpub(crate) fn STBDS_ALIGN_FWD(n: usize, a: usize) -> usize {\n172\t    n.wrapping_add(a).wrapping_sub(1) & !(a.wrapping_sub(1))\n173\t}\n174\t\n175\t// ---------------------------------------------------------------------------\n176\t// Pointer helpers mirroring the C macros\n177\t// ---------------------------------------------------------------------------\n178\t\n179\t/// `#define stbds_header(t) ((stbds_array_header *) (t) - 1)`\n180\t#[inline]\n181\tpub(crate) fn stbds_header(t: *mut c_void) -> *mut stbds_array_header {\n182\t    (t as *mut u8).wrapping_sub(size_of::<stbds_array_header>()) as *mut stbds_array_header\n183\t}\n184\t\n185\t/// `#define STBDS_HASH_TO_ARR(x,elemsize) ((char *) (x) - (elemsize))`\n186\t#[inline]\n187\tpub(crate) fn STBDS_HASH_TO_ARR(x: *mut c_void, elemsize: usize) -> *mut c_void {\n188\t    (x as *mut u8).wrapping_sub(elemsize) as *mut c_void\n189\t}\n190\t\n191\t/// `#define STBDS_ARR_TO_HASH(x,elemsize) ((char *) (x) + (elemsize))`\n192\t#[inline]\n193\tpub(crate) fn STBDS_ARR_TO_HASH(x: *mut c_void, elemsize: usize) -> *mut c_void {\n194\t    (x as *mut u8).wrapping_add(elemsize) as *mut c_void\n195\t}\n196\t\n197\t/// byte offset from a `void *`\n198\t#[inline]\n199\tpub(crate) fn byte_off(p: *mut c_void, n: usize) -> *mut u8 {\n200\t    (p as *mut u8).wrapping_add(n)\n201\t}\n202\t\n203\t/// `#define stbds_temp(t) stbds_header(t)->temp`\n204\t#[inline]\n205\tpub(crate) unsafe fn stbds_temp(t: *mut c_void) -> isize {\n206\t    (*stbds_header(t)).temp\n207\t}\n208\t\n209\t#[inline]\n210\tpub(crate) unsafe fn stbds_set_temp(t: *mut c_void, v: isize) {\n211\t    (*stbds_header(t)).temp = v;\n212\t}\n213\t\n214\t/// `#define stbds_temp_key(t) (*(char **) stbds_header(t)->hash_table)`\n215\t#[inline]\n216\tpub(crate) unsafe fn stbds_set_temp_key(t: *mut c_void, v: *mut c_char) {\n217\t    *((*stbds_header(t)).hash_table as *mut *mut c_char) = v;\n218\t}\n219\t\n220\t/// `#define stbds_hash_table(a) ((stbds_hash_index *) stbds_header(a)->hash_table)`\n221\t#[inline]\n222\tpub(crate) unsafe fn stbds_hash_table(a: *mut c_void) -> *mut stbds_hash_index {\n223\t    (*stbds_header(a)).hash_table as *mut stbds_hash_index\n224\t}\n225\t\n226\t/// `#define stbds_arrlen(a) ((a) ? (ptrdiff_t) stbds_header(a)->length : 0)`\n227\t#[inline]\n228\tpub(crate) unsafe fn stbds_arrlen(a: *mut c_void) -> isize {\n229\t    if a.is_null() {\n230\t        0\n231\t    } else {\n232\t        (*stbds_header(a)).length as isize\n233\t    }\n234\t}\n235\t\n236\t/// `#define stbds_arrcap(a) ((a) ? stbds_header(a)->capacity : 0)`\n237\t#[inline]\n238\tpub(crate) unsafe fn stbds_arrcap(a: *mut c_void) -> usize {\n239\t    if a.is_null() {\n240\t        0\n241\t    } else {\n242\t        (*stbds_header(a)).capacity\n243\t    }\n244\t}\n245\t\n246\t/// `STBDS_ASSERT` -- `assert()` from <assert.h>.  Aborts the process just like a\n247\t/// failing C assertion would (message text of a failing assert is not part of\n248\t/// the library's normal output).\n249\t#[inline]\n250\tpub(crate) fn STBDS_ASSERT(cond: bool) {\n251\t    if !cond {\n252\t        std::process::abort();\n253\t    }\n254\t}\n255\t"}]},"parent_tool_use_id":null,"session_id":"42be0eca-3321-477d-b867-854c40f82f5c","uuid":"5b79ddb2-74a0-46d4-b600-999679747a88","timestamp":"2026-08-20T05:28:24.968Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-DyHZgT/translated_rust/src/lib.rs","content":"//! Rust translation of the C library in `c_src/` (an stb_ds-style implementation\n//! plus the `arr_del`/`strkey` test helpers).\n//!\n//! The translation is intentionally literal: allocation sizes, memory layouts,\n//! integer wrap-around, sign-extension quirks and the exact order of operations\n//! of the original C code are all preserved so that the resulting shared object\n//! is behaviourally (byte-for-byte) identical to the C one.\n\n#![allow(non_camel_case_types)]\n#![allow(non_snake_case)]\n#![allow(non_upper_case_globals)]\n#![allow(dead_code)]\n#![allow(clippy::missing_safety_doc)]\n\nuse core::ffi::{c_char, c_int, c_void};\nuse core::mem::size_of;\n\nmod arena;\nmod array;\nmod hash;\nmod hashmap;\nmod tests;\n\n#[allow(unused_imports)]\npub(crate) use arena::*;\n#[allow(unused_imports)]\npub(crate) use array::*;\n#[allow(unused_imports)]\npub(crate) use hash::*;\n#[allow(unused_imports)]\npub(crate) use hashmap::*;\n\n// ---------------------------------------------------------------------------\n// libc bindings.  The C code uses realloc()/free()/mem*()/str*() directly; we\n// call the very same functions so that ownership of blocks handed out by (or\n// handed back to) this library stays 100% compatible with the C version.\n// ---------------------------------------------------------------------------\nextern \"C\" {\n    pub(crate) fn realloc(p: *mut c_void, size: usize) -> *mut c_void;\n    pub(crate) fn free(p: *mut c_void);\n    pub(crate) fn memset(s: *mut c_void, c: c_int, n: usize) -> *mut c_void;\n    pub(crate) fn memcpy(d: *mut c_void, s: *const c_void, n: usize) -> *mut c_void;\n    pub(crate) fn memmove(d: *mut c_void, s: *const c_void, n: usize) -> *mut c_void;\n    pub(crate) fn memcmp(a: *const c_void, b: *const c_void, n: usize) -> c_int;\n    pub(crate) fn strcmp(a: *const c_char, b: *const c_char) -> c_int;\n    pub(crate) fn strlen(s: *const c_char) -> usize;\n}\n\n// ---------------------------------------------------------------------------\n// STBDS_REALLOC / STBDS_FREE\n// ---------------------------------------------------------------------------\n#[inline]\npub(crate) unsafe fn STBDS_REALLOC(p: *mut c_void, s: usize) -> *mut c_void {\n    realloc(p, s)\n}\n\n#[inline]\npub(crate) unsafe fn STBDS_FREE(p: *mut c_void) {\n    free(p)\n}\n\n// ---------------------------------------------------------------------------\n// Structures (all layout-compatible with the C originals)\n// ---------------------------------------------------------------------------\n\n/// ```c\n/// typedef struct {\n///   size_t length; size_t capacity; void *hash_table; ptrdiff_t temp;\n/// } stbds_array_header;\n/// ```\n#[repr(C)]\npub(crate) struct stbds_array_header {\n    pub length: usize,\n    pub capacity: usize,\n    pub hash_table: *mut c_void,\n    pub temp: isize,\n}\n\n/// ```c\n/// typedef struct stbds_string_block {\n///   struct stbds_string_block *next; char storage[8];\n/// } stbds_string_block;\n/// ```\n#[repr(C)]\npub struct stbds_string_block {\n    pub next: *mut stbds_string_block,\n    pub storage: [c_char; 8],\n}\n\n/// ```c\n/// struct stbds_string_arena {\n///   stbds_string_block *storage; size_t remaining;\n///   unsigned char block; unsigned char mode;\n/// };\n/// ```\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct stbds_string_arena {\n    pub storage: *mut stbds_string_block,\n    pub remaining: usize,\n    pub block: u8,\n    pub mode: u8,\n}\n\n/// ```c\n/// typedef struct {\n///   size_t hash[STBDS_BUCKET_LENGTH]; ptrdiff_t index[STBDS_BUCKET_LENGTH];\n/// } stbds_hash_bucket;\n/// ```\n#[repr(C)]\npub(crate) struct stbds_hash_bucket {\n    pub hash: [usize; STBDS_BUCKET_LENGTH],\n    pub index: [isize; STBDS_BUCKET_LENGTH],\n}\n\n/// ```c\n/// typedef struct {\n///   char *temp_key;\n///   size_t slot_count, used_count, used_count_threshold,\n///          used_count_shrink_threshold, tombstone_count,\n///          tombstone_count_threshold, seed, slot_count_log2;\n///   stbds_string_arena string;\n///   stbds_hash_bucket *storage;\n/// } stbds_hash_index;\n/// ```\n#[repr(C)]\npub(crate) struct stbds_hash_index {\n    pub temp_key: *mut c_char,\n    pub slot_count: usize,\n    pub used_count: usize,\n    pub used_count_threshold: usize,\n    pub used_count_shrink_threshold: usize,\n    pub tombstone_count: usize,\n    pub tombstone_count_threshold: usize,\n    pub seed: usize,\n    pub slot_count_log2: usize,\n    pub string: stbds_string_arena,\n    pub storage: *mut stbds_hash_bucket,\n}\n\n// ---------------------------------------------------------------------------\n// Constants\n// ---------------------------------------------------------------------------\npub(crate) const STBDS_HM_BINARY: c_int = 0;\npub(crate) const STBDS_HM_STRING: c_int = 1;\n\npub(crate) const STBDS_SH_NONE: u8 = 0;\npub(crate) const STBDS_SH_DEFAULT: u8 = 1;\npub(crate) const STBDS_SH_STRDUP: u8 = 2;\npub(crate) const STBDS_SH_ARENA: u8 = 3;\n\npub(crate) const STBDS_BUCKET_LENGTH: usize = 8;\npub(crate) const STBDS_BUCKET_SHIFT: usize = 3;\npub(crate) const STBDS_BUCKET_MASK: usize = STBDS_BUCKET_LENGTH - 1;\npub(crate) const STBDS_CACHE_LINE_SIZE: usize = 64;\n\npub(crate) const STBDS_INDEX_EMPTY: isize = -1;\npub(crate) const STBDS_INDEX_DELETED: isize = -2;\n\npub(crate) const STBDS_HASH_EMPTY: usize = 0;\npub(crate) const STBDS_HASH_DELETED: usize = 1;\n\npub(crate) const STBDS_SIZE_T_BITS: u32 = (size_of::<usize>() as u32) * 8;\n\n#[inline]\npub(crate) fn STBDS_INDEX_IN_USE(x: isize) -> bool {\n    x >= 0\n}\n\n#[inline]\npub(crate) fn STBDS_ALIGN_FWD(n: usize, a: usize) -> usize {\n    n.wrapping_add(a).wrapping_sub(1) & !(a.wrapping_sub(1))\n}\n\n// ---------------------------------------------------------------------------\n// Pointer helpers mirroring the C macros\n// ---------------------------------------------------------------------------\n\n/// `#define stbds_header(t) ((stbds_array_header *) (t) - 1)`\n#[inline]\npub(crate) fn stbds_header(t: *mut c_void) -> *mut stbds_array_header {\n    (t as *mut u8).wrapping_sub(size_of::<stbds_array_header>()) as *mut stbds_array_header\n}\n\n/// `#define STBDS_HASH_TO_ARR(x,elemsize) ((char *) (x) - (elemsize))`\n#[inline]\npub(crate) fn STBDS_HASH_TO_ARR(x: *mut c_void, elemsize: usize) -> *mut c_void {\n    (x as *mut u8).wrapping_sub(elemsize) as *mut c_void\n}\n\n/// `#define STBDS_ARR_TO_HASH(x,elemsize) ((char *) (x) + (elemsize))`\n#[inline]\npub(crate) fn STBDS_ARR_TO_HASH(x: *mut c_void, elemsize: usize) -> *mut c_void {\n    (x as *mut u8).wrapping_add(elemsize) as *mut c_void\n}\n\n/// byte offset from a `void *`\n#[inline]\npub(crate) fn byte_off(p: *mut c_void, n: usize) -> *mut u8 {\n    (p as *mut u8).wrapping_add(n)\n}\n\n/// `#define stbds_temp(t) stbds_header(t)->temp`\n#[inline]\npub(crate) unsafe fn stbds_temp(t: *mut c_void) -> isize {\n    (*stbds_header(t)).temp\n}\n\n#[inline]\npub(crate) unsafe fn stbds_set_temp(t: *mut c_void, v: isize) {\n    (*stbds_header(t)).temp = v;\n}\n\n/// `#define stbds_temp_key(t) (*(char **) stbds_header(t)->hash_table)`\n#[inline]\npub(crate) unsafe fn stbds_set_temp_key(t: *mut c_void, v: *mut c_char) {\n    *((*stbds_header(t)).hash_table as *mut *mut c_char) = v;\n}\n\n/// `#define stbds_hash_table(a) ((stbds_hash_index *) stbds_header(a)->hash_table)`\n#[inline]\npub(crate) unsafe fn stbds_hash_table(a: *mut c_void) -> *mut stbds_hash_index {\n    (*stbds_header(a)).hash_table as *mut stbds_hash_index\n}\n\n/// `#define stbds_arrlen(a) ((a) ? (ptrdiff_t) stbds_header(a)->length : 0)`\n#[inline]\npub(crate) unsafe fn stbds_arrlen(a: *mut c_void) -> isize {\n    if a.is_null() {\n        0\n    } else {\n        (*stbds_header(a)).length as isize\n    }\n}\n\n/// `#define stbds_arrcap(a) ((a) ? stbds_header(a)->capacity : 0)`\n#[inline]\npub(crate) unsafe fn stbds_arrcap(a: *mut c_void) -> usize {\n    if a.is_null() {\n        0\n    } else {\n        (*stbds_header(a)).capacity\n    }\n}\n\n/// `STBDS_ASSERT` -- `assert()` from <assert.h>.  Aborts the process just like a\n/// failing C assertion 