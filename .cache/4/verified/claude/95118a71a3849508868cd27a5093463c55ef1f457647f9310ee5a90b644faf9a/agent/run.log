{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_017kmddSgLgV7B3bGqY9iCKh","type":"tool_result","content":"1\t//! Hashing (`stbds_hash_string`, `stbds_hash_bytes`, siphash-2-4), the random\n2\t//! seed, and hash-index construction/rehashing.\n3\t\n4\tuse core::ffi::{c_char, c_void};\n5\tuse core::mem::size_of;\n6\tuse core::ptr::null_mut;\n7\t\n8\tuse crate::*;\n9\t\n10\t/// `static size_t stbds_hash_seed=0x31415926;`\n11\tstatic mut stbds_hash_seed: usize = 0x3141_5926;\n12\t\n13\t#[inline]\n14\tpub(crate) unsafe fn hash_seed_get() -> usize {\n15\t    *(&raw const stbds_hash_seed)\n16\t}\n17\t\n18\t#[inline]\n19\tpub(crate) unsafe fn hash_seed_set(v: usize) {\n20\t    *(&raw mut stbds_hash_seed) = v;\n21\t}\n22\t\n23\t/// ```c\n24\t/// void stbds_rand_seed(size_t seed)\n25\t/// ```\n26\t#[unsafe(no_mangle)]\n27\tpub unsafe extern \"C\" fn stbds_rand_seed(seed: usize) {\n28\t    hash_seed_set(seed);\n29\t}\n30\t\n31\t/// `#define STBDS_ROTATE_LEFT(val, n) (((val) << (n)) | ((val) >> (STBDS_SIZE_T_BITS - (n))))`\n32\t///\n33\t/// `wrapping_shl`/`wrapping_shr` reproduce the x86 shift semantics that the C\n34\t/// compiler emits for the (technically undefined) `n == 0` case.\n35\t#[inline]\n36\tpub(crate) fn STBDS_ROTATE_LEFT(val: usize, n: u32) -> usize {\n37\t    val.wrapping_shl(n) | val.wrapping_shr(STBDS_SIZE_T_BITS.wrapping_sub(n))\n38\t}\n39\t\n40\t/// `#define STBDS_ROTATE_RIGHT(val, n) (((val) >> (n)) | ((val) << (STBDS_SIZE_T_BITS - (n))))`\n41\t#[inline]\n42\tpub(crate) fn STBDS_ROTATE_RIGHT(val: usize, n: u32) -> usize {\n43\t    val.wrapping_shr(n) | val.wrapping_shl(STBDS_SIZE_T_BITS.wrapping_sub(n))\n44\t}\n45\t\n46\t/// ```c\n47\t/// static size_t stbds_probe_position(size_t hash, size_t slot_count, size_t slot_log2)\n48\t/// ```\n49\tpub(crate) fn stbds_probe_position(hash: usize, slot_count: usize, _slot_log2: usize) -> usize {\n50\t    // STBDS_NOTUSED(slot_log2);\n51\t    hash & slot_count.wrapping_sub(1)\n52\t}\n53\t\n54\t/// ```c\n55\t/// static size_t stbds_log2(size_t slot_count)\n56\t/// ```\n57\tpub(crate) fn stbds_log2(slot_count: usize) -> usize {\n58\t    let mut slot_count = slot_count;\n59\t    let mut n: usize = 0;\n60\t    while slot_count > 1 {\n61\t        slot_count >>= 1;\n62\t        n += 1;\n63\t    }\n64\t    n\n65\t}\n66\t\n67\t/// Expansion of the `stbds_load_32_or_64` macro for a 64-bit `size_t`:\n68\t///\n69\t/// ```c\n70\t/// temp = v64_lo ^ v32, temp <<= 16, temp <<= 16, temp >>= 16, temp >>= 16,\n71\t/// var = v64_hi, var <<= 16, var <<= 16,\n72\t/// var ^= temp ^ v32\n73\t/// ```\n74\t///\n75\t/// `v32` is an `int` constant (positive here, so widening is value preserving)\n76\t/// and `v64_lo`/`v64_hi` are `unsigned int` constants, so the xor happens in\n77\t/// 32-bit arithmetic and is then zero-extended.\n78\t#[inline]\n79\tfn stbds_load_32_or_64(v32: u32, v64_hi: u32, v64_lo: u32) -> usize {\n80\t    let mut temp: usize = (v64_lo ^ v32) as usize;\n81\t    temp <<= 16;\n82\t    temp <<= 16;\n83\t    temp >>= 16;\n84\t    temp >>= 16;\n85\t    let mut var: usize = v64_hi as usize;\n86\t    var <<= 16;\n87\t    var <<= 16;\n88\t    var ^= temp ^ (v32 as usize);\n89\t    var\n90\t}\n91\t\n92\t/// ```c\n93\t/// static stbds_hash_index *stbds_make_hash_index(size_t slot_count, stbds_hash_index *ot)\n94\t/// ```\n95\tpub(crate) unsafe fn stbds_make_hash_index(\n96\t    slot_count: usize,\n97\t    ot: *mut stbds_hash_index,\n98\t) -> *mut stbds_hash_index {\n99\t    let t: *mut stbds_hash_index = STBDS_REALLOC(\n100\t        null_mut(),\n101\t        (slot_count >> STBDS_BUCKET_SHIFT)\n102\t            .wrapping_mul(size_of::<stbds_hash_bucket>())\n103\t            .wrapping_add(size_of::<stbds_hash_index>())\n104\t            .wrapping_add(STBDS_CACHE_LINE_SIZE - 1),\n105\t    ) as *mut stbds_hash_index;\n106\t\n107\t    (*t).storage = STBDS_ALIGN_FWD(t.wrapping_add(1) as usize, STBDS_CACHE_LINE_SIZE)\n108\t        as *mut stbds_hash_bucket;\n109\t    (*t).s