ash_bucket;\n   330\t\n   331\ttypedef struct\n   332\t{\n   333\t  char * temp_key;\n   334\t  size_t slot_count;\n   335\t  size_t used_count;\n   336\t  size_t used_count_threshold;\n   337\t  size_t used_count_shrink_threshold;\n   338\t  size_t tombstone_count;\n   339\t  size_t tombstone_count_threshold;\n   340\t  size_t seed;\n   341\t  size_t slot_count_log2;\n   342\t  stbds_string_arena string;\n   343\t  stbds_hash_bucket *storage;\n   344\t} stbds_hash_index;\n   345\t\n   346\t#define STBDS_INDEX_EMPTY    -1\n   347\t#define STBDS_INDEX_DELETED  -2\n   348\t#define STBDS_INDEX_IN_USE(x)  ((x) >= 0)\n   349\t\n   350\t#define STBDS_HASH_EMPTY      0\n   351\t#define STBDS_HASH_DELETED    1\n   352\t\n   353\tstatic size_t stbds_hash_seed=0x31415926;\n   354\t\n   355\tvoid stbds_rand_seed(size_t seed)\n   356\t{\n   357\t  stbds_hash_seed = seed;\n   358\t}\n   359\t\n   360\t#define stbds_load_32_or_64(var, temp, v32, v64_hi, v64_lo)                                          \\\n   361\t  temp = v64_lo ^ v32, temp <<= 16, temp <<= 16, temp >>= 16, temp >>= 16,                           \\\n   362\t  var = v64_hi, var <<= 16, var <<= 16,                                                              \\\n   363\t  var ^= temp ^ v32\n   364\t\n   365\t#define STBDS_SIZE_T_BITS           ((sizeof (size_t)) * 8)\n   366\t\n   367\tstatic size_t stbds_probe_position(size_t hash, size_t slot_count, size_t slot_log2)\n   368\t{\n   369\t  size_t pos;\n   370\t  STBDS_NOTUSED(slot_log2);\n   371\t  pos = hash & (slot_count-1);\n   372\t  return pos;\n   373\t}\n   374\t\n   375\tstatic size_t stbds_log2(size_t slot_count)\n   376\t{\n   377\t  size_t n=0;\n   378\t  while (slot_count > 1) {\n   379\t    slot_count >>= 1;\n   380\t    ++n;\n   381\t  }\n   382\t  return n;\n   383\t}\n   384\t\n   385\tstatic stbds_hash_index *stbds_make_hash_index(size_t slot_count, stbds_hash_index *ot)\n   386\t{\n   387\t  stbds_hash_index *t;\n   388\t  t = (stbds_hash_index *) STBDS_REALLOC(NULL,0,(slot_count >> STBDS_BUCKET_SHIFT) * sizeof(stbds_hash_bucket) + sizeof(stbds_hash_index) + STBDS_CACHE_LINE_SIZE-1);\n   389\t  t->storage = (stbds_hash_bucket *) STBDS_ALIGN_FWD((size_t) (t+1), STBDS_CACHE_LINE_SIZE);\n   390\t  t->slot_count = slot_count;\n   391\t  t->slot_count_log2 = stbds_log2(slot_count);\n   392\t  t->tombstone_count = 0;\n   393\t  t->used_count = 0;\n   394\t\n   395\t  t->used_count_threshold        = slot_count - (slot_count>>2);\n   396\t  t->tombstone_count_threshold   = (slot_count>>3) + (slot_count>>4);\n   397\t  t->used_count_shrink_threshold = slot_count >> 2;\n   398\t\n   399\t  if (slot_count <= STBDS_BUCKET_LENGTH)\n   400\t    t->used_count_shrink_threshold = 0;\n   401\t  STBDS_ASSERT(t->used_count_threshold + t->tombstone_count_threshold < t->slot_count);\n   402\t  STBDS_STATS(++stbds_hash_alloc);\n   403\t  if (ot) {\n   404\t    t->string = ot->string;\n   405\t    t->seed = ot->seed;\n   406\t  } else {\n   407\t    size_t a,b,temp;\n   408\t    memset(&t->string, 0, sizeof(t->string));\n   409\t    t->seed = stbds_hash_seed;\n   410\t    stbds_load_32_or_64(a,temp, 2147001325, 0x27bb2ee6, 0x87b0b0fd);\n   411\t    stbds_load_32_or_64(b,temp,  715136305,          0, 0xb504f32d);\n   412\t    stbds_hash_seed = stbds_hash_seed  * a + b;\n   413\t  }\n   414\t\n   415\t  {\n   416\t    size_t i,j;\n   417\t    for (i=0; i < slot_count >> STBDS_BUCKET_SHIFT; ++i) {\n   418\t      stbds_hash_bucket *b = &t->storage[i];\n   419\t      for (j=0; j < STBDS_BUCKET_LENGTH; ++j)\n   420\t        b->hash[j] = STBDS_HASH_EMPTY;\n   421\t      for (j=0; j < STBDS_BUCKET_LENGTH; ++j)\n   422\t        b->index[j] = STBDS_INDEX_EMPTY;\n   423\t    }\n   424\t  }\n   425\t\n   426\t  if (ot) {\n   427\t    size_t i,j;\n   428\t    t->used_count = ot->used_count;\n   429\t    for (i=0; i < ot->slot_count >> STBDS_BUCKET_SHIFT; ++i) {\n   430\t      stbds_hash_bucket *ob = &ot->storage[i];\n   431\t      for (j=0; j < STBDS_BUCKET_LENGTH; ++j) {\n   432\t        if (STBDS_INDEX_IN_USE(ob->index[j])) {\n   433\t          size_t hash = ob->hash[j];\n   434\t          size_t pos = stbds_probe_position(hash, t->slot_count, t->slot_count_log2);\n   435\t          size_t step = STBDS_BUCKET_LENGTH;\n   436\t          STBDS_STATS(++stbds_rehash_items);\n   437\t          for (;;) {\n   438\t            size_t limit,z;\n   439\t            stbds_hash_bucket *bucket;\n   440\t            bucket = &t->storage[pos >> STBDS_BUCKET_SHIFT];\n   441\t            STBDS_STATS(++stbds_rehash_probes);\n   442\t\n   443\t            for (z=pos & STBDS_BUCKET_MASK; z < STBDS_BUCKET_LENGTH; ++z) {\n   444\t              if (bucket->hash[z] == 0) {\n   445\t                bucket->hash[z] = hash;\n   446\t                bucket->index[z] = ob->index[j];\n   447\t                goto done;\n   448\t              }\n   449\t            }\n   450\t\n   451\t            limit = pos & STBDS_BUCKET_MASK;\n   452\t            for (z = 0; z < limit; ++z) {\n   453\t              if (bucket->hash[z] == 0) {\n   454\t                bucket->hash[z] = hash;\n   455\t                bucket->index[z] = ob->index[j];\n   456\t                goto done;\n   457\t              }\n   458\t            }\n   459\t\n   460\t            pos += step;\n   461\t            step += STBDS_BUCKET_LENGTH;\n   462\t            pos &= (t->slot_count-1);\n   463\t          }\n   464\t        }\n   465\t       done:\n   466\t        ;\n   467\t      }\n   468\t    }\n   469\t  }\n   470\t\n   471\t  return t;\n   472\t}\n   473\t\n   474\t#define STBDS_ROTATE_LEFT(val, n)   (((val) << (n)) | ((val) >> (STBDS_SIZE_T_BITS - (n))))\n   475\t#define STBDS_ROTATE_RIGHT(val, n)  (((val) >> (n)) | ((val) << (STBDS_SIZE_T_BITS - (n))))\n   476\t\n   477\tsize_t stbds_hash_string(char *str, size_t seed)\n   478\t{\n   479\t  size_t hash = seed;\n   480\t  while (*str)\n   481\t     hash = STBDS_ROTATE_LEFT(hash, 9) + (unsigned char) *str++