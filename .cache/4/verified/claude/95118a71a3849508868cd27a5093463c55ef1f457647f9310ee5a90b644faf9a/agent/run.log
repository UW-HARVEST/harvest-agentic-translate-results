p/.c.$$\n  nm -D --defined-only \"$so\" | awk '{print $3}' | sort > /tmp/.r.$$\n  missing=$(comm -23 /tmp/.c.$$ /tmp/.r.$$)\n  if [ -n \"$missing\" ]; then echo \"MISSING FROM RUST:\"; echo \"$missing\"; fail=1\n  else echo \"OK: all $(wc -l < /tmp/.c.$$) C symbols are exported by the Rust .so\"; fi\n  rm -f /tmp/.c.$$ /tmp/.r.$$\ndone\n\nlog \"RESULT\"\n[ \"$fail\" = 0 ] && echo \"ALL CONFIGURATIONS PASSED\" || echo \"FAILURES PRESENT\"\nexit \"$fail\"\n","structuredPatch":[],"originalFile":null,"userModified":false}}
