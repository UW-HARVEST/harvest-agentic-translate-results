  let fr = l.sym::<unsafe extern \"C\" fn(c2v) -> c2v>(Side::R, $name);\n            for _ in 0..20000 {\n                let a = rng.v_mixed(50.0);\n                unsafe { assert_same($name, &a, fc(a), fr(a)) };\n            }\n        }};\n    }\n    macro_rules! v_f {\n        ($name:literal) => {{\n            let fc = l.sym::<unsafe extern \"C\" fn(c2v) -> f32>(Side::C, $name);\n            let fr = l.sym::<unsafe extern \"C\" fn(c2v) -> f32>(Side::R, $name);\n            for _ in 0..20000 {\n                let a = rng.v_mixed(50.0);\n                unsafe { assert_same($name, &a, fc(a), fr(a)) };\n            }\n        }};\n    }\n\n    vv_v!(\"c2Maxv\");\n    vv_v!(\"c2Minv\");\n    vv_v!(\"c2Sub\");\n    vv_v!(\"c2Add\");\n    vv_f!(\"c2Dot\");\n    vv_f!(\"c2Det2\");\n    v_v!(\"c2Neg\");\n    v_v!(\"c2Skew\");\n    v_v!(\"c2CCW90\");\n    v_v!(\"c2Norm\");\n    v_f!(\"c2Len\");\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
