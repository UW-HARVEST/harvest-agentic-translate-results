      }\n142\t    }\n143\t}\n144\t\n145\timpl c2Simplex {\n146\t    const fn new() -> c2Simplex {\n147\t        c2Simplex {\n148\t            verts: [ZERO_SV; 4],\n149\t            div: 0.0,\n150\t            count: 0,\n151\t        }\n152\t    }\n153\t}\n154\t\n155\t// FLT_MAX / FLT_EPSILON, spelled out in the C source as literals.\n156\tconst C2_FLT_MAX: f32 = f32::MAX; // 3.40282346638528859811704183484516925e+38F\n157\tconst C2_FLT_EPSILON: f32 = f32::EPSILON; // 1.19209289550781250000000000000000000e-7F\n158\t\n159\t// ---------------------------------------------------------------------------\n160\t// Bit-exact scalar arithmetic\n161\t//\n162\t// For finite/normal inputs plain Rust `+`, `-`, `*`, `/` on `f32` already match\n163\t// the C code bit for bit.  They only diverge for the *payload and sign of a NaN\n164\t// result*: the x86 scalar SSE instructions (`ADDSS`, `SUBSS`, `MULSS`, `DIVSS`)\n165\t// return the NaN of their destination operand when both operands are NaN, and\n166\t// which of the two source expressions ends up in the destination register is a\n167\t// register-allocation detail of the compiler.  The helpers below make that\n168\t// choice explicit so the translation reproduces the C library exactly; `dst` is\n169\t// the operand that occupies the destination register in the C build.\n170\t// ---------------------------------------------------------------------------\n171\t\n172\t/// x86 quiets a NaN by setting the most significant significand bit, keeping the\n173\t/// sign and the rest of the payload.\n174\t#[inline(always)]\n175\tfn quiet_nan(x: f32) -> f32 {\n176\t    f32::from_bits(x.to_bits() | 0x0040_0000)\n177\t}\n178\t\n179\t/// `ADDSS dst, src` -> `dst + src`\n180\t#[inline(always)]\n181\tfn sse_add(dst: f32, src: f32) -> f32 {\n182\t    if dst.is_nan() {\n183\t        quiet_nan(dst)\n184\t    } else if src.is_nan() {\n185\t        quiet_nan(src)\n186\t    } else {\n187\t        dst + src\n188\t    }\n189\t}\n190\t\n191\t/// `SUBSS dst, src` -> `dst - src`\n192\t#[inline(always)]\n193\tfn sse_sub(dst: f32, src: f32) -> f32 {\n194\t    if dst.is_nan() {\n195\t        quiet_nan(dst)\n196\t    } else if src.is_nan() {\n197\t        quiet_nan(src)\n198\t    } else {\n199\t        dst - src\n200\t    }\n201\t}\n202\t\n203\t/// `MULSS dst, src` -> `dst * src`\n204\t#[inline(always)]\n205\tfn sse_mul(dst: f32, src: f32) -> f32 {\n206\t    if dst.is_nan() {\n207\t        quiet_nan(dst)\n208\t    } else if src.is_nan() {\n209\t        quiet_nan(src)\n210\t    } else {\n211\t        dst * src\n212\t    }\n213\t}\n214\t\n215\t/// `DIVSS dst, src` -> `dst / src`\n216\t#[inline(always)]\n217\tfn sse_div(dst: f32, src: f32) -> f32 {\n218\t    if dst.is_nan() {\n219\t        quiet_nan(dst)\n220\t    } else if src.is_nan() {\n221\t        quiet_nan(src)\n222\t    } else {\n223\t        dst / src\n224\t    }\n225\t}\n226\t\n227\t// ---------------------------------------------------------------------------\n228\t// Vector / rotation helpers\n229\t// ---------------------------------------------------------------------------\n230\t\n231\t#[unsafe(no_mangle)]\n232\tpub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n233\t    c2v { x, y }\n234\t}\n235\t\n236\t#[unsafe(no_mangle)]\n237\tpub extern \"C\" fn c2Mulvs(mut a: c2v, b: f32) -> c2v {\n238\t    a.x = sse_mul(a.x, b);\n239\t    a.y = sse_mul(a.y, b);\n240\t    a\n241\t}\n242\t\n243\t#[unsafe(no_mangle)]\n244\tpub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n245\t    c2V(\n246\t        if a.x > b.x { a.x } else { b.x },\n247\t        if a.y > b.y { a.y } else { b.y },\n248\t    )\n249\t}\n250\t\n251\t#[unsafe(no_mangle)]\n252\tpub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n253\t    c2V(\n254\t        if a.x < b.x { a.x } else { b.x },\n255\t        if a.y < b.y { a.y } else { b.y },\n256\t    )\n257\t}\n258\t\n259\t#[unsafe(no_mangle)]\n260\tpub extern \"C\" fn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n261\t    c2Maxv(lo, c2Minv(a, hi))\n262\t}\n263\t\n264\t#[unsafe(no_mangle)]\n265\tpub extern \"C\" fn c2Sub(mut a: c2v, b: c2v) -> c2v {\n266\t    a.x = sse_sub(a.x, b.x);\n267\t    a.y = sse_sub(a.y, b.y);\n268\t    a\n269\t}\n270\t\n271\t#[unsafe(no_mangle)]\n272\tpub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n273\t    // a.x * b.x + a.y * b.y\n274\t    let p0 = sse_mul(a.x, b.x);\n275\t    let p1 = sse_mul(b.y, a.y);\n276\t    sse_add(p1, p0)\n277\t}\n278\t\n279\t#[unsafe(no_mangle)]\n280\tpub extern \"C\" fn c2RotIdentity() -> c2r {\n281\t    c2r { c: 1.0, s: 0.0 }\n282\t}\n283\t\n284\t#[unsafe(no_mangle)]\n285\tpub extern \"C\" fn c2xIdentity() -> c2x {\n286\t    c2x {\n287\t        p: c2V(0.0, 0.0),\n288\t        r: c2RotIdentity(),\n289\t    }\n290\t}\n291\t\n292\t#[unsafe(no_mangle)]\n293\tpub extern \"C\" fn c2Mulrv(a: c2r, b: c2v) -> c2v {\n294\t    // c2V(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)\n295\t    let y = sse_add(sse_mul(a.s, b.x), sse_mul(b.y, a.c));\n296\t    let x = sse_sub(sse_mul(b.x, a.c), sse_mul(b.y, a.s));\n297\t    c2V(x, y)\n298\t}\n299\t\n300\t#[unsafe(no_mangle)]\n301\tpub extern \"C\" fn c2MulrvT(a: c2r, b: c2v) -> c2v {\n302\t    // c2V(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y)\n303\t    let y = sse_add(sse_mul(-a.s, b.x), sse_mul(b.y, a.c));\n304\t    let x = sse_add(sse_mul(a.c, b.x), sse_mul(b.y, a.s));\n305\t    c2V(x, y)\n306\t}\n307\t\n308\t#[unsafe(no_mangle)]\n309\tpub extern \"C\" fn c2Add(mut a: c2v, b: c2v) -> c2v {\n310\t    a.x = sse_add(b.x, a.x);\n311\t    a.y = sse_add(b.y, a.y);\n312\t    a\n313\t}\n314\t\n315\t#[unsafe(no_mangle)]\n316\tpub extern \"C\" fn c2Mulxv(a: c2x, b: c2v) -> c2v {\n317\t    c2Add(c2Mulrv(a.r, b), a.p)\n318\t}\n319\t\n320\t#[unsafe(no_mangle)]\n321\tpub extern \"C\" fn c2Neg(a: c2v) -> c2v {\n322\t    c2V(-a.x, -a.y)\n323\t}\n324\t\n325\t#[unsafe(no_mangle)]\n326\tpub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n327\t    c2v { x: -a.y, y: a.x }\n328\t}\n329\t\n330\t#[unsafe(no_mangle)]\n331\tpub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n332\t    c2v { x: a.y, y: -a.x }\n333\t}\n334\t\n335\t#[unsafe(no_mangle)]\n336\tpub extern \"C\" fn c2Len(a: c2v) -> f32 {\n337\t    // sqrtf()\n338\t    c2Dot(a, a).sqrt()\n339\t}\n340\t\n341\t#[unsafe(no_mangle)]\n342\tpub extern \"C\" fn c2Det2(a: c2v, b: c2v) -> f32 {\n343\t    // a.x * b.y - a.y * b.x\n344\t    let p0 = sse_mul(b.y, a.x);\n345\t    let p1 = sse_mul(b.x, a.y);\n346\t    sse_sub(p0, p1)\n347\t}\n348\t\n349\t#[unsafe(no_mangle)]\n350\tpub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n351\t    c2Mulvs(a, sse_div(1.0, b))\n352\t}\n353\t\n354\t#[unsafe(no_mangle)]\n355\tpub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n356\t    c2Div(a, c2Len(a))\n357\t}\n358\t\n359\t// ---------------------------------------------------------------------------\n360\t// Proxies\n361\t// ---------------------------------------------------------------------------\n362\t\n363\t#[unsafe(no_mangle)]\n364\tpub unsafe extern \"C\" fn c2BBVerts(out: *mut c2v, bb: *mut c2AABB) {\n365\t    *out.offset(0) = (*bb).min;\n366\t    *out.offset(1) = c2V((*bb).max.x, (*bb).min.y);\n367\t    *out.offset(2) = (*bb).max;\n368\t    *out.offset(3) = c2V((*bb).min.x, (*bb).max.y);\n369\t}\n370\t\n371\t#[unsafe(no_mangle)]\n372\tpub unsafe extern \"C\" fn c2MakeProxy(shape: *const c_void, type_: C2_TYPE, p: *mut c2Proxy) {\n373\t    match type_ {\n374\t        C2_TYPE_CIRCLE => {\n375\t            let c = shape as *mut c2Circle;\n376\t            (*p).radius = (*c).r;\n377\t            (*p).count = 1;\n378\t            (*p).verts[0] = (*c).p;\n379\t        }\n380\t        C2_TYPE_AABB => {\n381\t            let bb = shape as *mut c2AABB;\n382\t            (*p).radius = 0.0;\n383\t            (*p).count = 4;\n384\t            c2BBVerts((*p).verts.as_mut_ptr(), bb);\n385\t        }\n386\t        C2_TYPE_CAPSULE => {\n387\t            let c = shape as *mut c2Capsule;\n388\t            (*p).radius = (*c).r;\n389\t            (*p).count = 2;\n390\t            (*p).verts[0] = (*c).a;\n391\t            (*p).verts[1] = (*c).b;\n392\t        }\n393\t        _ => {}\n394\t    }\n395\t}\n396\t\n397\t// ---------------------------------------------------------------------------\n398\t// Simplex helpers\n399\t// ---------------------------------------------------------------------------\n400\t\n401\t#[unsafe(no_mangle)]\n402\tpub unsafe extern \"C\" fn c2GJKSimplexMetric(s: *mut c2Simplex) -> f32 {\n403\t    match (*s).count {\n404\t        2 => c2Len(c2Sub((*s).verts[1].p, (*s).verts[0].p)),\n405\t        3 => c2Det2(\n406\t            c2Sub((*s).verts[1].p, (*s).verts[0].p),\n407\t            c2Sub((*s).verts[2].p, (*s).verts[0].p),\n408\t        ),\n409\t        // `default:` falls through into `case 1:` in the C source.\n410\t        _ => 0.0,\n411\t    }\n412\t}\n413\t\n414\t#[unsafe(no_mangle)]\n415\tpub unsafe extern \"C\" fn c22(s: *mut c2Simplex) {\n416\t    let a = (*s).verts[0].p;\n417\t    let b = (*s).verts[1].p;\n418\t    let u = c2Dot(b, c2Sub(b, a));\n419\t    let v = c2Dot(a, c2Sub(a, b));\n420\t    if v <= 0.0 {\n421\t        (*s).verts[0].u = 1.0;\n422\t        (*s).div = 1.0;\n423\t        (*s).count = 1;\n424\t    } else if u <= 0.0 {\n425\t        (*s).verts[0] = (*s).verts[1];\n426\t        (*s).verts[0].u = 1.0;\n427\t        (*s).div = 1.0;\n428\t        (*s).count = 1;\n429\t    } else {\n430\t        (*s).verts[0].u = u;\n431\t        (*s).verts[1].u = v;\n432\t        (*s).div = sse_add(u, v);\n433\t        (*s).count = 2;\n434\t    }\n435\t}\n436\t\n437\t#[unsafe(no_mangle)]\n438\tpub unsafe extern \"C\" fn c23(s: *mut c2Simplex) {\n439\t    let a = (*s).verts[0].p;\n440\t    let b = (*s).verts[1].p;\n441\t    let c = (*s).verts[2].p;\n442\t    let uAB = c2Dot(b, c2Sub(b, a));\n443\t    let vAB = c2Dot(a, c2Sub(a, b));\n444\t    let uBC = c2Dot(c, c2Sub(c, b));\n445\t    let vBC = c2Dot(b, c2Sub(b, c));\n446\t    let uCA = c2Dot(a, c2Sub(a, c));\n447\t    let vCA = c2Dot(c, c2Sub(c, a));\n448\t    let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n449\t    let uABC = sse_mul(c2Det2(b, c), area);\n450\t    let vABC = sse_mul(c2Det2(c, a), area);\n451\t    let wABC = sse_mul(c2Det2(a, b), area);\n452\t    if vAB <= 0.0 && uCA <= 0.0 {\n453\t        (*s).verts[0].u = 1.0;\n454\t        (*s).div = 1.0;\n455\t        (*s).count = 1;\n456\t    } else if uAB <= 0.0 && vBC <= 0.0 {\n457\t        (*s).verts[0] = (*s).verts[1];\n458\t        (*s).verts[0].u = 1.0;\n459\t        (*s).div = 1.0;\n460\t        (*s).count = 1;\n461\t    } else if uBC <= 0.0 && vCA <= 0.0 {\n462\t        (*s).verts[0] = (*s).verts[2];\n463\t        (*s).verts[0].u = 1.0;\n464\t        (*s).div = 1.0;\n465\t        (*s).count = 1;\n466\t    } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n467\t        (*s).verts[0].u = uAB;\n468\t        (*s).verts[1].u = vAB;\n469\t        (*s).div = sse_add(uAB, vAB);\n470\t        (*s).count = 2;\n471\t    } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n472\t        (*s).verts[0] = (*s).verts[1];\n473\t        (*s).verts[1] = (*s).verts[2];\n474\t        (*s).verts[0].u = uBC;\n475\t        (*s).verts[1].u = vBC;\n476\t        (*s).div = sse_add(uBC, vBC);\n477\t        (*s).count = 2;\n478\t    } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n479\t        (*s).verts[1] = (*s).verts[0];\n480\t        (*s).verts[0] = (*s).verts[2];\n481\t        (*s).verts[0].u = uCA;\n482\t        (*s).verts[1].u = vCA;\n483\t        (*s).div = sse_add(uCA, vCA);\n484\t        (*s).count = 2;\n485\t    } else {\n486\t        (*s).verts[0].u = uABC;\n487\t        (*s).verts[1].u = vABC;\n488\t        (*s).verts[2].u = wABC;\n489\t        (*s).div = sse_add(sse_add(uABC, vABC), wABC);\n490\t        (*s).count = 3;\n491\t    }\n492\t}\n493\t\n494\t#[unsafe(no_mangle)]\n495\tpub unsafe extern \"C\" fn c2D(s: *mut c2Simplex) -> c2v {\n496\t    match (*s).count {\n497\t        1 => c2Neg((*s).verts[0].p),\n498\t        2 => {\n499\t            let ab = c2Sub((*s).verts[1].p, (*s).verts[0].p);\n500\t            if c2Det2(ab, c2Neg((*s).verts[0].p)) > 0.0 {\n501\t                return c2Skew(ab);\n502\t            }\n503\t            c2CCW90(ab)\n504\t        }\n505\t        // case 3 and default\n506\t        _ => c2V(0.0, 0.0),\n507\t    }\n508\t}\n509\t\n510\t#[unsafe(no_mangle)]\n511\tpub unsafe extern \"C\" fn c2Support(verts: *const c2v, count: c_int, d: c2v) -> c_int {\n512\t    let mut imax: c_int = 0;\n513\t    let mut dmax = c2Dot(*verts.offset(0), d);\n514\t    let mut i: c_int = 1;\n515\t    while i < count {\n516\t        let dot = c2Dot(*verts.offset(i as isize), d);\n517\t        if dot > dmax {\n518\t            imax = i;\n519\t            dmax = dot;\n520\t        }\n521\t        i += 1;\n522\t    }\n523\t    imax\n524\t}\n525\t\n526\t#[unsafe(no_mangle)]\n527\tpub unsafe extern \"C\" fn c2Witness(s: *mut c2Simplex, a: *mut c2v, b: *mut c2v) {\n528\t    let den = sse_div(1.0, (*s).div);\n529\t    match (*s).count {\n530\t        1 => {\n531\t            *a = (*s).verts[0].sA;\n532\t            *b = (*s).verts[0].sB;\n533\t        }\n534\t        2 => {\n535\t            *a = c2Add(\n536\t                c2Mulvs((*s).verts[0].sA, sse_mul((*s).verts[0].u, den)),\n537\t                c2Mulvs((*s).verts[1].sA, sse_mul((*s).verts[1].u, den)),\n538\t            );\n539\t            *b = c2Add(\n540\t                c2Mulvs((*s).verts[0].sB, sse_mul((*s).verts[0].u, den)),\n541\t                c2Mulvs((*s).verts[1].sB, sse_mul((*s).verts[1].u, den)),\n542\t            );\n543\t        }\n544\t        3 => {\n545\t            *a = c2Add(\n546\t                c2Add(\n547\t                    c2Mulvs((*s).verts[0].sA, sse_mul((*s).verts[0].u, den)),\n548\t                    c2Mulvs((*s).verts[1].sA, sse_mul((*s).verts[1].u, den)),\n549\t                ),\n550\t                c2Mulvs((*s).verts[2].sA, sse_mul((*s).verts[2].u, den)),\n551\t            );\n552\t            *b = c2Add(\n553\t                c2Add(\n554\t                    c2Mulvs((*s).verts[0].sB, sse_mul((*s).verts[0].u, den)),\n555\t                    c2Mulvs((*s).verts[1].sB, sse_mul((*s).verts[1].u, den)),\n556\t                ),\n557\t                c2Mulvs((*s).verts[2].sB, sse_mul((*s).verts[2].u, den)),\n558\t            );\n559\t        }\n560\t        _ => {\n561\t            *a = c2V(0.0, 0.0);\n562\t            *b = c2V(0.0, 0.0);\n563\t        }\n564\t    }\n565\t}\n566\t\n567\t#[unsafe(no_mangle)]\n568\tpub unsafe extern \"C\" fn c2L(s: *mut c2Simplex) -> c2v {\n569\t    let den = sse_div(1.0, (*s).div);\n570\t    match (*s).count {\n571\t        1 => (*s).verts[0].p,\n572\t        2 => c2Add(\n573\t            c2Mulvs((*s).verts[0].p, sse_mul((*s).verts[0].u, den)),\n574\t            c2Mulvs((*s).verts[1].p, sse_mul((*s).verts[1].u, den)),\n575\t        ),\n576\t        _ => c2V(0.0, 0.0),\n577\t    }\n578\t}\n579\t\n580\t// ---------------------------------------------------------------------------\n581\t// GJK\n582\t// ---------------------------------------------------------------------------\n583\t\n584\t#[unsafe(no_mangle)]\n585\tpub unsafe extern \"C\" fn c2GJK(\n586\t    A: *const c_void,\n587\t    typeA: C2_TYPE,\n588\t    ax_ptr: *const c2x,\n589\t    B: *const c_void,\n590\t    typeB: C2_TYPE,\n591\t    bx_ptr: *const c2x,\n592\t    outA: *mut c2v,\n593\t    outB: *mut c2v,\n594\t    use_radius: c_int,\n595\t    iterations: *mut c_int,\n596\t    cache: *mut c2GJKCache,\n597\t) -> f32 {\n598\t    let ax: c2x;\n599\t    let bx: c2x;\n600\t    if ax_ptr.is_null() {\n601\t        ax = c2xIdentity();\n602\t    } else {\n603\t        ax = *ax_ptr;\n604\t    }\n605\t    if bx_ptr.is_null() {\n606\t        bx = c2xIdentity();\n607\t    } else {\n608\t        bx = *bx_ptr;\n609\t    }\n610\t\n611\t    let mut pA = c2Proxy::new();\n612\t    let mut pB = c2Proxy::new();\n613\t    c2MakeProxy(A, typeA, &mut pA);\n614\t    c2MakeProxy(B, typeB, &mut pB);\n615\t\n616\t    let mut s = c2Simplex::new();\n617\t    // All accesses to the simplex go through raw pointers, mirroring the C code\n618\t    // (which keeps `c2sv *verts = &s.a;` live across the calls below).\n619\t    let sp: *mut c2Simplex = core::ptr::addr_of_mut!(s);\n620\t    // `c2sv *verts = &s.a;`\n621\t    let verts: *mut c2sv = core::ptr::addr_of_mut!((*sp).verts) as *mut c2sv;\n622\t\n623\t    let mut cache_was_read: c_int = 0;\n624\t    if !cache.is_null() {\n625\t        let cache_was_good: c_int = ((*cache).count != 0) as c_int;\n626\t        if cache_was_good != 0 {\n627\t            let mut i: c_int = 0;\n628\t            while i < (*cache).count {\n629\t                let iA = *(*cache).iA.as_ptr().offset(i as isize);\n630\t                let iB = *(*cache).iB.as_ptr().offset(i as isize);\n631\t                let sA = c2Mulxv(ax, *pA.verts.as_ptr().offset(iA as isize));\n632\t                let sB = c2Mulxv(bx, *pB.verts.as_ptr().offset(iB as isize));\n633\t                let v = verts.offset(i as isize);\n634\t                (*v).iA = iA;\n635\t                (*v).sA = sA;\n636\t                (*v).iB = iB;\n637\t                (*v).sB = sB;\n638\t                (*v).p = c2Sub((*v).sB, (*v).sA);\n639\t                (*v).u = 0.0;\n640\t                i += 1;\n641\t            }\n642\t            (*sp).count = (*cache).count;\n643\t            (*sp).div = (*cache).div;\n644\t            let metric_old = (*cache).metric;\n645\t            let metric = c2GJKSimplexMetric(sp);\n646\t            let min_metric = if metric < metric_old { metric } else { metric_old };\n647\t            let max_metric = if metric > metric_old { metric } else { metric_old };\n648\t            if !(min_metric < sse_add(max_metric, max_metric) && metric < -1.0e8) {\n649\t                cache_was_read = 1;\n650\t            }\n651\t        }\n652\t    }\n653\t\n654\t    if cache_was_read == 0 {\n655\t        (*sp).verts[0].iA = 0;\n656\t        (*sp).verts[0].iB = 0;\n657\t        (*sp).verts[0].sA = c2Mulxv(ax, pA.verts[0]);\n658\t        (*sp).verts[0].sB = c2Mulxv(bx, pB.verts[0]);\n659\t        (*sp).verts[0].p = c2Sub((*sp).verts[0].sB, (*sp).verts[0].sA);\n660\t        (*sp).verts[0].u = 1.0;\n661\t        (*sp).div = 1.0;\n662\t        (*sp).count = 1;\n663\t    }\n664\t\n665\t    let mut saveA: [c_int; 3] = [0; 3];\n666\t    let mut saveB: [c_int; 3] = [0; 3];\n667\t    let mut save_count: c_int = 0;\n668\t    let mut d0: f32 = C2_FLT_MAX;\n669\t    let mut d1: f32 = C2_FLT_MAX;\n670\t    let mut iter: c_int = 0;\n671\t    let mut hit: c_int = 0;\n672\t    while iter < 20 {\n673\t        save_count = (*sp).count;\n674\t        let mut i: c_int = 0;\n675\t        while i < save_count {\n676\t            *saveA.as_mut_ptr().offset(i as isize) = (*verts.offset(i as isize)).iA;\n677\t            *saveB.as_mut_ptr().offset(i as isize) = (*verts.offset(i as isize)).iB;\n678\t            i += 1;\n679\t        }\n680\t\n681\t        match (*sp).count {\n682\t            1 => {}\n683\t            2 => c22(sp),\n684\t            3 => c23(sp),\n685\t            _ => {}\n686\t        }\n687\t\n688\t        if (*sp).count == 3 {\n689\t            hit = 1;\n690\t            break;\n691\t        }\n692\t\n693\t        let p = c2L(sp);\n694\t        d1 = c2Dot(p, p);\n695\t        if d1 > d0 {\n696\t            break;\n697\t        }\n698\t        d0 = d1;\n699\t\n700\t        let d = c2D(sp);\n701\t        if c2Dot(d, d) < C2_FLT_EPSILON * C2_FLT_EPSILON {\n702\t            break;\n703\t        }\n704\t\n705\t        let iA = c2Support(pA.verts.as_ptr(), pA.count, c2MulrvT(ax.r, c2Neg(d)));\n706\t        let sA = c2Mulxv(ax, *pA.verts.as_ptr().offset(iA as isize));\n707\t        let iB = c2Support(pB.verts.as_ptr(), pB.count, c2MulrvT(bx.r, d));\n708\t        let sB = c2Mulxv(bx, *pB.verts.as_ptr().offset(iB as isize));\n709\t\n710\t        let v = verts.offset((*sp).count as isize);\n711\t        (*v).iA = iA;\n712\t        (*v).sA = sA;\n713\t        (*v).iB = iB;\n714\t        (*v).sB = sB;\n715\t        (*v).p = c2Sub((*v).sB, (*v).sA);\n716\t\n717\t        let mut dup: c_int = 0;\n718\t        let mut i: c_int = 0;\n719\t        while i < save_count {\n720\t            if iA == *saveA.as_ptr().offset(i as isize) && iB == *saveB.as_ptr().offset(i as isize) {\n721\t                dup = 1;\n722\t                break;\n723\t            }\n724\t            i += 1;\n725\t        }\n726\t        if dup != 0 {\n727\t            break;\n728\t        }\n729\t\n730\t        (*sp).count += 1;\n731\t        iter += 1;\n732\t    }\n733\t\n734\t    let mut a: c2v = ZERO_V;\n735\t    let mut b: c2v = ZERO_V;\n736\t    c2Witness(sp, &mut a, &mut b);\n737\t    let mut dist = c2Len(c2Sub(a, b));\n738\t\n739\t    if hit != 0 {\n740\t        a = b;\n741\t        dist = 0.0;\n742\t    } else if use_radius != 0 {\n743\t        let rA = pA.radius;\n744\t        let rB = pB.radius;\n745\t        if dist > sse_add(rA, rB) && dist > C2_FLT_EPSILON {\n746\t            dist = sse_sub(dist, sse_add(rA, rB));\n747\t            let n = c2Norm(c2Sub(b, a));\n748\t            a = c2Add(a, c2Mulvs(n, rA));\n749\t            b = c2Sub(b, c2Mulvs(n, rB));\n750\t            if a.x == b.x && a.y == b.y {\n751\t                dist = 0.0;\n752\t            }\n753\t        } else {\n754\t            let p = c2Mulvs(c2Add(a, b), 0.5);\n755\t            a = p;\n756\t            b = p;\n757\t            dist = 0.0;\n758\t        }\n759\t    }\n760\t\n761\t    if !cache.is_null() {\n762\t        (*cache).metric = c2GJKSimplexMetric(sp);\n763\t        (*cache).count = (*sp).count;\n764\t        let mut i: c_int = 0;\n765\t        while i < (*sp).count {\n766\t            let v = verts.offset(i as isize);\n767\t            *(*cache).iA.as_mut_ptr().offset(i as isize) = (*v).iA;\n768\t            *(*cache).iB.as_mut_ptr().offset(i as isize) = (*v).iB;\n769\t            i += 1;\n770\t        }\n771\t        (*cache).div = (*sp).div;\n772\t    }\n773\t\n774\t    if !outA.is_null() {\n775\t        *outA = a;\n776\t    }\n777\t    if !outB.is_null() {\n778\t        *outB = b;\n779\t    }\n780\t    if !iterations.is_null() {\n781\t        *iterations = iter;\n782\t    }\n783\t    dist\n784\t}\n785\t\n786\t// ---------------------------------------------------------------------------\n787\t// Boolean collision routines\n788\t// ---------------------------------------------------------------------------\n789\t\n790\t#[unsafe(no_mangle)]\n791\tpub extern \"C\" fn c2AABBtoAABB(A: c2AABB, B: c2AABB) -> c_int {\n792\t    let d0: c_int = (B.max.x < A.min.x) as c_int;\n793\t    let d1: c_int = (A.max.x < B.min.x) as c_int;\n794\t    let d2: c_int = (B.max.y < A.min.y) as c_int;\n795\t    let d3: c_int = (A.max.y < B.min.y) as c_int;\n796\t    ((d0 | d1 | d2 | d3) == 0) as c_int\n797\t}\n798\t\n799\t#[unsafe(no_mangle)]\n800\tpub extern \"C\" fn c2AABBtoCapsule(A: c2AABB, B: c2Capsule) -> c_int {\n801\t    unsafe {\n802\t        if c2GJK(\n803\t            &A as *const c2AABB as *const c_void,\n804\t            C2_TYPE_AABB,\n805\t            core::ptr::null(),\n806\t            &B as *const c2Capsule as *const c_void,\n807\t            C2_TYPE_CAPSULE,\n808\t            core::ptr::null(),\n809\t            core::ptr::null_mut(),\n810\t            core::ptr::null_mut(),\n811\t            1,\n812\t            core::ptr::null_mut(),\n813\t            core::ptr::null_mut(),\n814\t        ) != 0.0\n815\t        {\n816\t            return 0;\n817\t        }\n818\t    }\n819\t    1\n820\t}\n821\t\n822\t#[unsafe(no_mangle)]\n823\tpub extern \"C\" fn c2CapsuletoCapsule(A: c2Capsule, B: c2Capsule) -> c_int {\n824\t    unsafe {\n825\t        if c2GJK(\n826\t            &A as *const c2Capsule as *const c_void,\n827\t            C2_TYPE_CAPSULE,\n828\t            core::ptr::null(),\n829\t            &B as *const c2Capsule as *const c_void,\n830\t            C2_TYPE_CAPSULE,\n831\t            core::ptr::null(),\n832\t            core::ptr::null_mut(),\n833\t            core::ptr::null_mut(),\n834\t            1,\n835\t            core::ptr::null_mut(),\n836\t            core::ptr::null_mut(),\n837\t        ) != 0.0\n838\t        {\n839\t            return 0;\n840\t        }\n841\t    }\n842\t    1\n843\t}\n844\t\n845\t#[unsafe(no_mangle)]\n846\tpub extern \"C\" fn c2CircletoCircle(A: c2Circle, B: c2Circle) -> c_int {\n847\t    let c = c2Sub(B.p, A.p);\n848\t    let d2 = c2Dot(c, c);\n849\t    let mut r2 = sse_add(B.r, A.r);\n850\t    r2 = sse_mul(r2, r2);\n851\t    (d2 < r2) as c_int\n852\t}\n853\t\n854\t#[unsafe(no_mangle)]\n855\tpub extern \"C\" fn c2CircletoAABB(A: c2Circle, B: c2AABB) -> c_int {\n856\t    let L = c2Clampv(A.p, B.min, B.max);\n857\t    let ab = c2Sub(A.p, L);\n858\t    let d2 = c2Dot(ab, ab);\n859\t    let r2 = sse_mul(A.r, A.r);\n860\t    (d2 < r2) as c_int\n861\t}\n862\t\n863\t#[unsafe(no_mangle)]\n864\tpub extern \"C\" fn c2CircletoCapsule(A: c2Circle, B: c2Capsule) -> c_int {\n865\t    let n = c2Sub(B.b, B.a);\n866\t    let ap = c2Sub(A.p, B.a);\n867\t    let da = c2Dot(ap, n);\n868\t    let d2: f32;\n869\t    if da < 0.0 {\n870\t        d2 = c2Dot(ap, ap);\n871\t    } else {\n872\t        let db = c2Dot(c2Sub(A.p, B.b), n);\n873\t        if db < 0.0 {\n874\t            let e = c2Sub(ap, c2Mulvs(n, sse_div(da, c2Dot(n, n))));\n875\t            d2 = c2Dot(e, e);\n876\t        } else {\n877\t            let bp = c2Sub(A.p, B.b);\n878\t            d2 = c2Dot(bp, bp);\n879\t        }\n880\t    }\n881\t    let r = sse_add(B.r, A.r);\n882\t    (d2 < sse_mul(r, r)) as c_int\n883\t}\n884\t\n885\t#[unsafe(no_mangle)]\n886\tpub unsafe extern \"C\" fn c2Collided(\n887\t    A: *const c_void,\n888\t    typeA: C2_TYPE,\n889\t    B: *const c_void,\n890\t    typeB: C2_TYPE,\n891\t) -> c_int {\n892\t    match typeA {\n893\t        C2_TYPE_CIRCLE => match typeB {\n894\t            C2_TYPE_CIRCLE => c2CircletoCircle(*(A as *const c2Circle), *(B as *const c2Circle)),\n895\t            C2_TYPE_AABB => c2CircletoAABB(*(A as *const c2Circle), *(B as *const c2AABB)),\n896\t            C2_TYPE_CAPSULE => c2CircletoCapsule(*(A as *const c2Circle), *(B as *const c2Capsule)),\n897\t            _ => 0,\n898\t        },\n899\t        C2_TYPE_AABB => match typeB {\n900\t            C2_TYPE_CIRCLE => c2CircletoAABB(*(B as *const c2Circle), *(A as *const c2AABB)),\n901\t            C2_TYPE_AABB => c2AABBtoAABB(*(A as *const c2AABB), *(B as *const c2AABB)),\n902\t            C2_TYPE_CAPSULE => c2AABBtoCapsule(*(A as *const c2AABB), *(B as *const c2Capsule)),\n903\t            _ => 0,\n904\t        },\n905\t        C2_TYPE_CAPSULE => match typeB {\n906\t            C2_TYPE_CIRCLE => c2CircletoCapsule(*(B as *const c2Circle), *(A as *const c2Capsule)),\n907\t            C2_TYPE_AABB => c2AABBtoCapsule(*(B as *const c2AABB), *(A as *const c2Capsule)),\n908\t            C2_TYPE_CAPSULE => {\n909\t                c2CapsuletoCapsule(*(A as *const c2Capsule), *(B as *const c2Capsule))\n910\t            }\n911\t            _ => 0,\n912\t        },\n913\t        _ => 0,\n914\t    }\n915\t}\n916\t\n917\t// ---------------------------------------------------------------------------\n918\t// Public entry point (include/lib.h)\n919\t// ---------------------------------------------------------------------------\n920\t\n921\t#[unsafe(no_mangle)]\n922\tpub extern \"C\" fn aabb(min_x: f32, min_y: f32, max_x: f32, max_y: f32) -> c_int {\n923\t    let mut result: c_int = 0;\n924\t\n925\t    let aabb_in = c2AABB {\n926\t        min: c2V(min_x, min_y),\n927\t        max: c2V(max_x, max_y),\n928\t    };\n929\t\n930\t    let circle = c2Circle {\n931\t        p: c2V(-70.0, 0.0),\n932\t        r: 20.0,\n933\t    };\n934\t\n935\t    let aabb = c2AABB {\n936\t        min: c2V(-40.0, -40.0),\n937\t        max: c2V(-15.0, -15.0),\n938\t    };\n939\t\n940\t    let capsule = c2Capsule {\n941\t        a: c2V(-40.0, 40.0),\n942\t        b: c2V(-20.0, 100.0),\n943\t        r: 10.0,\n944\t    };\n945\t\n946\t    unsafe {\n947\t        result += c2Collided(\n948\t            &circle as *const c2Circle as *const c_void,\n949\t            C2_TYPE_CIRCLE,\n950\t            &aabb_in as *const c2AABB as *const c_void,\n951\t            C2_TYPE_AABB,\n952\t        );\n953\t\n954\t        result += c2Collided(\n955\t            &aabb as *const c2AABB as *const c_void,\n956\t            C2_TYPE_AABB,\n957\t            &aabb_in as *const c2AABB as *const c_void,\n958\t            C2_TYPE_AABB,\n959\t        ) << 1;\n960\t\n961\t        result += c2Collided(\n962\t            &capsule as *const c2Capsule as *const c_void,\n963\t            C2_TYPE_CAPSULE,\n964\t            &aabb_in as *const c2AABB as *const c_void,\n965\t            C2_TYPE_AABB,\n966\t        ) << 2;\n967\t    }\n968\t\n969\t    result\n970\t}\n971\t"}]},"parent_tool_use_id":null,"session_id":"decfb6c4-450a-46c9-b484-bc4fca72900c","uuid":"a1ce0bb9-7f92-49b3-a501-81fb7bf5a471","timestamp":"2026-08-20T05:28:16.371Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-JHk2Z1/translated_rust/src/lib.rs","content":"//! Rust translation of c_src/src/lib.c (a cute_c2 style 2D collision library).\n//!\n//! Every public symbol exported by the C shared library is reproduced here with\n//! the identical linker name, C ABI signature and bit-exact behaviour.  No bugs\n//! of the original implementation have been \"fixed\": the order of the checks,\n//! the floating point expressions and even reads of never-initialised fields are\n//! mirrored as closely as possible.\n\n#![allow(non_snake_case)]\n#![allow(non_camel_case_types)]\n#![allow(non_upper_case_globals)]\n#![allow(unused_assignments)]\n\nuse core::ffi::{c_int, c_uint, c_void};\n\n// ---------------------------------------------------------------------------\n// Types\n// ---------------------------------------------------------------------------\n\n/// `typedef enum { C2_TYPE_CIRCLE, C2_TYPE_AABB, C2_TYPE_CAPSULE } C2_TYPE;`\n///\n/// The C enum only has non-negative enumerators, so gcc gives it the\n/// `unsigned int` representation.\npub type C2_TYPE = c_uint;\n\npub const C2_TYPE_CIRCLE: C2_TYPE = 0;\npub const C2_TYPE_AABB: C2_TYPE = 1;\npub const C2_TYPE_CAPSULE: C2_TYPE = 2;\n\n#[repr(C)]\n#[derive(Clone, Copy, PartialEq, Debug)]\npub struct c2v {\n    pub x: f32,\n    pub y: f32,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug)]\npub struct c2r {\n    pub c: f32,\n    pub s: f32,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug)]\npub struct c2x {\n    pub p: c2v,\n    pub r: c2r,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug)]\npub struct c2Circle {\n    pub p: c2v,\n    pub r: f32,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug)]\npub struct c2AABB {\n    pub min: c2v,\n    pub max: c2v,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug)]\npub struct c2Capsule {\n    pub a: c2v,\n    pub b: c2v,\n    pub r: f32,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug)]\npub struct c2GJKCache {\n    pub metric: f32,\n    pub count: c_int,\n    pub iA: [c_int; 3],\n    pub iB: [c_int; 3],\n    pub div: f32,\n}\n\n/// ```c\n/// typedef struct { float radius; int count; c2v verts[8]; } c2Proxy;\n/// ```\n#[repr(C)]\n#[derive(Clone, Copy, Debug)]\npub struct c2Proxy {\n    pub radius: f32,\n    pub count: c_int,\n    pub verts: [c2v; 8],\n}\n\n/// ```c\n/// typedef struct { c2v sA; c2v sB; c2v p; float u; int iA; int iB; } c2sv;\n/// ```\n#[repr(C)]\n#[derive(Clone, Copy, Debug)]\npub struct c2sv {\n    pub sA: c2v,\n    pub sB: c2v,\n    pub p: c2v,\n    pub u: f32,\n    pub iA: c_int,\n    pub iB: c_int,\n}\n\n/// ```c\n/// typedef struct { c2sv a, b, c, d; float div; int count; } c2Simplex;\n/// ```\n///\n/// The four `c2sv` members are laid out contiguously in C and the original code\n/// walks them through `c2sv *verts = &s.a;`, so they are modelled as an array\n/// here (identical memory layout).\n#[repr(C)]\n#[derive(Clone, Copy, Debug)]\npub struct c2Simplex {\n    /// `a`, `b`, `c`, `d`\n    pub verts: [c2sv; 4],\n    pub div: f32,\n    pub count: c_int,\n}\n\nconst ZERO_V: c2v = c2v { x: 0.0, y: 0.0 };\n\nconst ZERO_SV: c2sv = c2sv {\n    sA: ZERO_V,\n    sB: ZERO_V,\n    p: ZERO_V,\n    u: 0.0,\n    iA: 0,\n    iB: 0,\n};\n\nimpl c2Proxy {\n    const fn new() -> c2Proxy {\n        c2Proxy {\n            radius: 0.0,\n            count: 0,\n            verts: [ZERO_V; 8],\n        }\n    }\n}\n\nimpl c2Simplex {\n    const fn new() -> c2Simplex {\n        c2Simplex {\n            verts: [ZERO_SV; 4],\n            div: 0.0,\n            count: 0,\n        }\n    }\n}\n\n// FLT_MAX / FLT_EPSILON, spelled out in the C source as literals.\nconst C2_FLT_MAX: f32 = f32::MAX; // 3.40282346638528859811704183484516925e+38F\nconst C2_FLT_EPSILON: f32 = f32::EPSILON; // 1.19209289550781250000000000000000000e-7F\n\n// ---------------------------------------------------------------------------\n// Bit-exact scalar arithmetic\n//\n// For finite/normal inputs plain Rust `+`, `-`, `*`, `/` on `f32` already match\n// the C code bit for bit.  They only diverge for the *payload and sign of a NaN\n// result*: the x86 scalar SSE instructions (`ADDSS`, `SUBSS`, `MULSS`, `DIVSS`)\n// return the NaN of their destination operand when both operands are NaN, and\n// which of the two source expressions ends up in the destination register is a\n// register-allocation detail of the compiler.  The helpers below make that\n// choice explicit so the translation reproduces the C library exactly; `dst` is\n// the operand that occupies the destination register in the C build.\n// ---------------------------------------------------------------------------\n\n/// x86 quiets a NaN by setting the most significant significand bit, keeping the\n/// sign and the rest of the payload.\n#[inline(always)]\nfn quiet_nan(x: f32) -> f32 {\n    f32::from_bits(x.to_bits() | 0x0040_0000)\n}\n\n/// `ADDSS dst, src` -> `dst + src`\n#[inline(always)]\nfn sse_add(dst: f32, src: f32) -> f32 {\n    if dst.is_nan() {\n        quiet_nan(dst)\n    } else if src.is_nan() {\n        quiet_nan(src)\n    } else {\n        dst + src\n    }\n}\n\n/// `SUBSS dst, src` -> `dst - src`\n#[inline(always)]\nfn sse_sub(dst: f32, src: f32) -> f32 {\n    if dst.is_nan() {\n        quiet_nan(dst)\n    } else if src.is_nan() {\n        quiet_nan(src)\n    } else {\n        dst - src\n    }\n}\n\n/// `MULSS dst, src` -> `dst * src`\n#[inline(always)]\nfn sse_mul(dst: f32, src: f32) -> f32 {\n    if dst.is_nan() {\n        quiet_nan(dst)\n    } else if src.is_nan() {\n        quiet_nan(src)\n    } else {\n        dst * src\n    }\n}\n\n/// `DIVSS dst, src` -> `dst / src`\n#[inline(always)]\nfn sse_div(dst: f32, src: f32) -> f32 {\n    if dst.is_nan() {\n        quiet_nan(dst)\n    } else if src.is_nan() {\n        quiet_nan(src)\n    } else {\n        dst / src\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Vector / rotation helpers\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n    c2v { x, y }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulvs(mut a: c2v, b: f32) -> c2v {\n    a.x = sse_mul(a.x, b);\n    a.y = sse_mul(a.y, b);\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n    c2V(\n        if a.x > b.x { a.x } else { b.x },\n        if a.y > b.y { a.y } else { b.y },\n    )\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n    c2V(\n        if a.x < b.x { a.x } else { b.x },\n        if a.y < b.y { a.y } else { b.y },\n    )\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n    c2Maxv(lo, c2Minv(a, hi))\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Sub(mut a: c2v, b: c2v) -> c2v {\n    a.x = sse_sub(a.x, b.x);\n    a.y = sse_sub(a.y, b.y);\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n    // a.x * b.x + a.y * b.y\n    let p0 = sse_mul(a.x, b.x);\n    let p1 = sse_mul(b.y, a.y);\n    sse_add(p1, p0)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2RotIdentity() -> c2r {\n    c2r { c: 1.0, s: 0.0 }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2xIdentity() -> c2x {\n    c2x {\n        p: c2V(0.0, 0.0),\n        r: c2RotIdentity(),\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulrv(a: c2r, b: c2v) -> c2v {\n    // c2V(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)\n    let y = sse_add(sse_mul(a.s, b.x), sse_mul(b.y, a.c));\n    let x = sse_sub(sse_mul(b.x, a.c), sse_mul(b.y, a.s));\n    c2V(x, y)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2MulrvT(a: c2r, b: c2v) -> c2v {\n    // c2V(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y)\n    let y = sse_add(sse_mul(-a.s, b.x), sse_mul(b.y, a.c));\n    let x = sse_add(sse_mul(a.c, b.x), sse_mul(b.y, a.s));\n    c2V(x, y)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Add(mut a: c2v, b: c2v) -> c2v {\n    a.x = sse_add(b.x, a.x);\n    a.y = sse_add(b.y, a.y);\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulxv(a: c2x, b: c2v) -> c2v {\n    c2Add(c2Mulrv(a.r, b), a.p)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Neg(a: c2v) -> c2v {\n    c2V(-a.x, -a.y)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n    c2v { x: -a.y, y: a.x }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n    c2v { x: a.y, y: -a.x }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Len(a: c2v) -> f32 {\n    // sqrtf()\n    c2Dot(a, a).sqrt()\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Det2(a: c2v, b: c2v) -> f32 {\n    // a.x * b.y - a.y * b.x\n    let p0 = sse_mul(b.y, a.x);\n    let p1 = sse_mul(b.x, a.y);\n    sse_sub(p0, p1)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n    c2Mulvs(a, sse_div(1.0, b))\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n    c2Div(a, c2Len(a))\n}\n\n// ---------------------------------------------------------------------------\n// Proxies\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2BBVerts(out: *mut c2v, bb: *mut c2AABB) {\n    *out.offset(0) = (*bb).min;\n    *out.offset(1) = c2V((*bb).max.x, (*bb).min.y);\n    *out.offset(2) = (*bb).max;\n    *out.offset(3) = c2V((*bb).min.x, (*bb).max.y);\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2MakeProxy(shape: *const c_void, type_: C2_TYPE, p: *mut c2Proxy) {\n    match type_ {\n        C2_TYPE_CIRCLE => {\n            let c = shape as *mut c2Circle;\n            (*p).radius = (*c).r;\n            (*p).count = 1;\n            (*p).verts[0] = (*c).p;\n        }\n        C2_TYPE_AABB => {\n            let bb = shape as *mut c2AABB;\n            (*p).radius = 0.0;\n            (*p).count = 4;\n            c2BBVerts((*p).verts.as_mut_ptr(), bb);\n        }\n        C2_TYPE_CAPSULE => {\n            let c = shape as *mut c2Capsule;\n            (*p).radius = (*c).r;\n            (*p).count = 2;\n            (*p).verts[0] = (*c).a;\n            (*p).verts[1] = (*c).b;\n        }\n        _ => {}\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Simplex helpers\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2GJKSimplexMetric(s: *mut c2Simplex) -> f32 {\n    match (*s).count {\n        2 => c2Len(c2Sub((*s).verts[1].p, (*s).verts[0].p)),\n        3 => c2Det2(\n            c2Sub((*s).verts[1].p, (*s).verts[0].p),\n            c2Sub((*s).verts[2].p, (*s).verts[0].p),\n        ),\n        // `default:` falls through into `case 1:` in the C source.\n        _ => 0.0,\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c22(s: *mut c2Simplex) {\n    let a = (*s).verts[0].p;\n    let b = (*s).verts[1].p;\n    let u = c2Dot(b, c2Sub(b, a));\n    let v = c2Dot(a, c2Sub(a, b));\n    if v <= 0.0 {\n        (*s).verts[0].u = 1.0;\n        (*s).div = 1.0;\n        (*s).count = 1;\n    } else if u <= 0.0 {\n        (*s).verts[0] = (*s).verts[1];\n        (*s).verts[0].u = 1.0;\n        (*s).div = 1.0;\n        (*s).count = 1;\n    } else {\n        (*s).verts[0].u = u;\n        (*s).verts[1].u = v;\n        (*s).div = sse_add(u, v);\n        (*s).count = 2;\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c23(s: *mut c2Simplex) {\n    let a = (*s).verts[0].p;\n    let b = (*s).verts[1].p;\n    let c = (*s).verts[2].p;\n    let uAB = c2Dot(b, c2Sub(b, a));\n    let vAB = c2Dot(a, c2Sub(a, b));\n    let uBC = c2Dot(c, c2Sub(c, b));\n    let vBC = c2Dot(b, c2Sub(b, c));\n    let uCA = c2Dot(a, c2Sub(a, c));\n    let vCA = c2Dot(c, c2Sub(c, a));\n    let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n    let uABC = sse_mul(c2Det2(b, c), area);\n    let vABC = sse_mul(c2Det2(c, a), area);\n    let wABC = sse_mul(c2Det2(a, b), area);\n    if vAB <= 0.0 && uCA <= 0.0 {\n        (*s).verts[0].u = 1.0;\n        (*s).div = 1.0;\n        (*s).count = 1;\n    } else if uAB <= 0.0 && vBC <= 0.0 {\n        (*s).verts[0] = (*s).verts[1];\n        (*s).verts[0].u = 1.0;\n        (*s).div = 1.0;\n        (*s).count = 1;\n    } else if uBC <= 0.0 && vCA <= 0.0 {\n        (*s).verts[0] = (*s).verts[2];\n        (*s).verts[0].u = 1.0;\n        (*s).div = 1.0;\n        (*s).count = 1;\n    } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n        (*s).verts[0].u = uAB;\n        (*s).verts[1].u = vAB;\n        (*s).div = sse_add(uAB, vAB);\n        (*s).count = 2;\n    } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n        (*s).verts[0] = (*s).verts[1];\n        (*s).verts[1] = (*s).verts[2];\n        (*s).verts[0].u = uBC;\n        (*s).verts[1].u = vBC;\n        (*s).div = sse_add(uBC, vBC);\n        (*s).count = 2;\n    } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n        (*s).verts[1] = (*s).verts[0];\n        (*s).verts[0] = (*s).verts[2];\n        (*s).verts[0].u = uCA;\n        (*s).verts[1].u = vCA;\n        (*s).div = sse_add(uCA, vCA);\n        (*s).count = 2;\n    } else {\n        (*s).verts[0].u = uABC;\n        (*s).verts[1].u = vABC;\n        (*s).verts[2].u = wABC;\n        (*s).div = sse_add(sse_add(uABC, vABC), wABC);\n        (*s).count = 3;\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2D(s: *mut c2Simplex) -> c2v {\n    match (*s).count {\n        1 => c2Neg((*s).verts[0].p),\n        2 => {\n            let ab = c2Sub((*s).verts[1].p, (*s).verts[0].p);\n            if c2Det2(ab, c2Neg((*s).verts[0].p)) > 0.0 {\n                return c2Skew(ab);\n            }\n            c2CCW90(ab)\n        }\n        // case 3 and default\n        _ => c2V(0.0, 0.0),\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2Support(verts: *const c2v, count: c_int, d: c2v) -> c_int {\n    let mut imax: c_int = 0;\n    let mut dmax = c2Dot(*verts.offset(0), d);\n    let mut i: c_int = 1;\n    while i < count {\n        let dot = c2Dot(*verts.offset(i as isize), d);\n        if dot > dmax {\n            imax = i;\n            dmax = dot;\n        }\n        i += 1;\n    }\n    imax\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2Witness(s: *mut c2Simplex, a: *mut c2v, b: *mut c2v) {\n    let den = sse_div(1.0, (*s).div);\n    match (*s).count {\n        1 => {\n            *a = (*s).verts[0].sA;\n            *b = (*s).verts[0].sB;\n        }\n        2 => {\n            *a = c2Add(\n                c2Mulvs((*s).verts[0].sA, sse_mul((*s).verts[0].u, den)),\n                c2Mulvs((*s).verts[1].sA, sse_mul((*s).verts[1].u, den)),\n            );\n            *b = c2Add(\n                c2Mulvs((*s).verts[0].sB, sse_mul((*s).verts[0].u, den)),\n                c2Mulvs((*s).verts[1].sB, sse_mul((*s).verts[1].u, den)),\n            );\n        }\n        3 => {\n            *a = c2Add(\n                c2Add(\n                    c2Mulvs((*s).verts[0].sA, sse_mul((*s).verts[0].u, den)),\n                    c2Mulvs((*s).verts[1].sA, sse_mul((*s).verts[1].u, den)),\n                ),\n                c2Mulvs((*s).verts[2].sA, sse_mul((*s).verts[2].u, den)),\n            );\n            *b = c2Add(\n                c2Add(\n                    c2Mulvs((*s).verts[0].sB, sse_mul((*s).verts[0].u, den)),\n                    c2Mulvs((*s).verts[1].sB, sse_mul((*s).verts[1].u, den)),\n                ),\n                c2Mulvs((*s).verts[2].sB, sse_mul((*s).verts[2].u, den)),\n            );\n        }\n        _ => {\n            *a = c2V(0.0, 0.0);\n            *b = c2V(0.0, 0.0);\n        }\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2L(s: *mut c2Simplex) -> c2v {\n    let den = sse_div(1.0, (*s).div);\n    match (*s).count {\n        1 => (*s).verts[0].p,\n        2 => c2Add(\n            c2Mulvs((*s).verts[0].p, sse_mul((*s).verts[0].u, den)),\n            c2Mulvs((*s).verts[1].p, sse_mul((*s).verts[1].u, den)),\n        ),\n        _ => c2V(0.0, 0.0),\n    }\n}\n\n// ---------------------------------------------------------------------------\n// GJK\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2GJK(\n    A: *const c_void,\n    typeA: C2_TYPE,\n    ax_ptr: *const c2x,\n    B: *const c_void,\n    typeB: C2_TYPE,\n    bx_ptr: *const c2x,\n    outA: *mut c2v,\n    outB: *mut c2v,\n    use_radius: c_int,\n    iterations: *mut c_int,\n    cache: *mut c2GJKCache,\n) -> f32 {\n    let ax: c2x;\n    let bx: c2x;\n    if ax_ptr.is_null() {\n        ax = c2xIdentity();\n    } else {\n        ax = *ax_ptr;\n    }\n    if bx_ptr.is_null() {\n        bx = c2xIdentity();\n    } else {\n        bx = *bx_ptr;\n    }\n\n    let mut pA = c2Proxy::new();\n    let mut pB = c2Proxy::new();\n    c2MakeProxy(A, typeA, &mut pA);\n    c2MakeProxy(B, typeB, &mut pB);\n\n    let mut s = c2Simplex::new();\n    // All accesses to the simplex go through raw pointers, mirroring the C code\n    // (which keeps `c2sv *verts = &s.a;` live across the calls below).\n    let sp: *mut c2Simplex = core::ptr::addr_of_mut!(s);\n    // `c2sv *verts = &s.a;`\n    let verts: *mut c2sv = core::ptr::addr_of_mut!((*sp).verts) as *mut c2sv;\n\n    let mut cache_was_read: c_int = 0;\n    if !cache.is_null() {\n        let cache_was_good: c_int = ((*cache).count != 0) as c_int;\n        if cache_was_good != 0 {\n            let mut i: c_int = 0;\n            while i < (*cache).count {\n                let iA = *(*cache).iA.as_ptr().offset(i as isize);\n                let iB = *(*cache).iB.as_ptr().offset(i as isize);\n                let sA = c2Mulxv(ax, *pA.verts.as_ptr().offset(iA as isize));\n                let sB = c2Mulxv(bx, *pB.verts.as_ptr().offset(iB as isize));\n                let v = verts.offset(i as isize);\n                (*v).iA = iA;\n                (*v).sA = sA;\n                (*v).iB = iB;\n                (*v).sB = sB;\n                (*v).p = c2Sub((*v).sB, (*v).sA);\n                (*v).u = 0.0;\n                i += 1;\n            }\n            (*sp).count = (*cache).count;\n            (*sp).div = (*cache).div;\n            let metric_old = (*cache).metric;\n            let metric = c2GJKSimplexMetric(sp);\n            let min_metric = if metric < metric_old { metric } else { metric_old };\n            let max_metric = if metric > metric_old { metric } else { metric_old };\n            if !(min_metric < sse_add(max_metric, max_metric) && metric < -1.0e8) {\n                cache_was_read = 1;\n            }\n        }\n    }\n\n    if cache_was_read == 0 {\n        (*sp).verts[0].iA = 0;\n        (*sp).verts[0].iB = 0;\n        (*sp).verts[0].sA = c2Mulxv(ax, pA.verts[0]);\n        (*sp).verts[0].sB = c2Mulxv(bx, pB.verts[0]);\n        (*sp).verts[0].p = c2Sub((*sp).verts[0].sB, (*sp).verts[0].sA);\n        (*sp).verts[0].u = 1.0;\n        (*sp).div = 1.0;\n        (*sp).count = 1;\n    }\n\n    let mut saveA: [c_int; 3] = [0; 3];\n    let mut saveB: [c_int; 3] = [0; 3];\n    let mut save_count: c_int = 0;\n    let mut d0: f32 = C2_FLT_MAX;\n    let mut d1: f32 = C2_FLT_MAX;\n    let mut iter: c_int = 0;\n    let mut hit: c_int = 0;\n    while iter < 20 {\n        save_count = (*sp).count;\n        let mut i: c_int = 0;\n        while i < save_count {\n            *saveA.as_mut_ptr().offset(i as isize) = (*verts.offset(i as isize)).iA;\n            *saveB.as_mut_ptr().offset(i as isize) = (*verts.offset(i as isize)).iB;\n            i += 1;\n        }\n\n        match (*sp).count {\n            1 => {}\n            2 => c22(sp),\n            3 => c23(sp),\n            _ => {}\n        }\n\n        if (*sp).count == 3 {\n            hit = 1;\n            break;\n        }\n\n        let p = c2L(sp);\n        d1 = c2Dot(p, p);\n        if d1 > d0 {\n            break;\n        }\n        d0 = d1;\n\n        let d = c2D(sp);\n        if c2Dot(d, d) < C2_FLT_EPSILON * C2_FLT_EPSILON {\n            break;\n        }\n\n        let iA = c2Support(pA.verts.as_ptr(), pA.count, c2MulrvT(ax.r, c2Neg(d)));\n        let sA = c2Mulxv(ax, *pA.verts.as_ptr().offset(iA as isize));\n        let iB = c2Support(pB.verts.as_ptr(), pB.count, c2MulrvT(bx.r, d));\n        let sB = c2Mulxv(bx, *pB.verts.as_ptr().offset(iB as isize));\n\n        let v = verts.offset((*sp).count as isize);\n        (*v).iA = iA;\n        (*v).sA = sA;\n        (*v).iB = iB;\n        (*v).sB = sB;\n        (*v).p = c2Sub((*v).sB, (*v).sA);\n\n        let mut dup: c_int = 0;\n        let mut i: c_int = 0;\n        while i < save_count {\n            if iA == *saveA.as_ptr().offset(i as isize) && iB == *saveB.as_ptr().offset(i as isize) {\n                dup = 1;\n                break;\n            }\n            i += 1;\n        }\n        if dup != 0 {\n            break;\n        }\n\n        (*sp).count += 1;\n        iter += 1;\n    }\n\n    let mut a: c2v = ZERO_V;\n    let mut b: c2v = ZERO_V;\n    c2Witness(sp, &mut a, &mut b);\n    let mut dist = c2Len(c2Sub(a, b));\n\n    if hit != 0 {\n        a = b;\n        dist = 0.0;\n    } else if use_radius != 0 {\n        let rA = pA.radius;\n        let rB = pB.radius;\n        if dist > sse_add(rA, rB) && dist > C2_FLT_EPSILON {\n            dist = sse_sub(dist, sse_add(rA, rB));\n            let n = c2Norm(c2Sub(b, a));\n            a = c2Add(a, c2Mulvs(n, rA));\n            b = c2Sub(b, c2Mulvs(n, rB));\n            if a.x == b.x && a.y == b.y {\n                dist = 0.0;\n            }\n        } else {\n            let p = c2Mulvs(c2Add(a, b), 0.5);\n            a = p;\n            b = p;\n            dist = 0.0;\n        }\n    }\n\n    if !cache.is_null() {\n        (*cache).metric = c2GJKSimplexMetric(sp);\n        (*cache).count = (*sp).count;\n        let mut i: c_int = 0;\n        while i < (*sp).count {\n            let v = verts.offset(i as isize);\n            *(*cache).iA.as_mut_ptr().offset(i as isize) = (*v).iA;\n            *(*cache).iB.as_mut_ptr().offset(i as isize) = (*v).iB;\n            i += 1;\n        }\n        (*cache).div = (*sp).div;\n    }\n\n    if !outA.is_null() {\n        *outA = a;\n    }\n    if !outB.is_null() {\n        *outB = b;\n    }\n    if !iterations.is_null() {\n        *iterations = iter;\n    }\n    dist\n}\n\n// ---------------------------------------------------------------------------\n// Boolean collision routines\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2AABBtoAABB(A: c2AABB, B: c2AABB) -> c_int {\n    let d0: c_int = (B.max.x < A.min.x) as c_int;\n    let d1: c_int = (A.max.x < B.min.x) as c_int;\n    let d2: c_int = (B.max.y < A.min.y) as c_int;\n    let d3: c_int = (A.max.y < B.min.y) as c_int;\n    ((d0 | d1 | d2 | d3) == 0) as c_int\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2AABBtoCapsule(A: c2AABB, B: c2Capsule) -> c_int {\n    unsafe {\n        if c2GJK(\n            &A as *const c2AABB as *const c_void,\n            C2_TYPE_AABB,\n            core::ptr::null(),\n            &B as *const c2Capsule as *const c_void,\n            C2_TYPE_CAPSULE,\n            core::ptr::null(),\n            core::ptr::null_mut(),\n            core::ptr::null_mut(),\n            1,\n            core::ptr::null_mut(),\n            core::ptr::null_mut(),\n        ) != 0.0\n        {\n            return 0;\n        }\n    }\n    1\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CapsuletoCapsule(A: c2Capsule, B: c2Capsule) -> c_int {\n    unsafe {\n        if c2GJK(\n            &A as *const c2Capsule as *const c_void,\n            C2_TYPE_CAPSULE,\n            core::ptr::null(),\n            &B as *const c2Capsule as *const c_void,\n            C2_TYPE_CAPSULE,\n            core::ptr::null(),\n            core::ptr::null_mut(),\n            core::ptr::null_mut(),\n            1,\n            core::ptr::null_mut(),\n            core::ptr::null_mut(),\n        ) != 0.0\n        {\n            return 0;\n        }\n    }\n    1\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CircletoCircle(A: c2Circle, B: c2Circle) -> c_int {\n    let c = c2Sub(B.p, A.p);\n    let d2 = c2Dot(c, c);\n    let mut r2 = sse_add(B.r, A.r);\n    r2 = sse_mul(r2, r2);\n    (d2 < r2) as c_int\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CircletoAABB(A: c2Circle, B: c2AABB) -> c_int {\n    let L = c2Clampv(A.p, B.min, B.max);\n    let ab = c2Sub(A.p, L);\n    let d2 = c2Dot(ab, ab);\n    let r2 = sse_mul(A.r, A.r);\n    (d2 < r2) as c_int\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CircletoCapsule(A: c2Circle, B: c2Capsule) -> c_int {\n    let n = c2Sub(B.b, B.a);\n    let ap = c2Sub(A.p, B.a);\n    let da = c2Dot(ap, n);\n    let d2: f32;\n    if da < 0.0 {\n        d2 = c2Dot(ap, ap);\n    } else {\n        let db = c2Dot(c2Sub(A.p, B.b), n);\n        if db < 0.0 {\n            let e = c2Sub(ap, c2Mulvs(n, sse_div(da, c2Dot(n, n))));\n            d2 = c2Dot(e, e);\n        } else {\n            let bp = c2Sub(A.p, B.b);\n            d2 = c2Dot(bp, bp);\n        }\n    }\n    let r = sse_add(B.r, A.r);\n    (d2 < sse_mul(r, r)) as c_int\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2Collided(\n    A: *const c_void,\n    typeA: C2_TYPE,\n    B: *const c_void,\n    typeB: C2_TYPE,\n) -> c_int {\n    match typeA {\n        C2_TYPE_CIRCLE => match typeB {\n            C2_TYPE_CIRCLE => c2CircletoCircle(*(A as *const c2Circle), *(B as *const c2Circle)),\n            C2_TYPE_AABB => c2CircletoAABB(*(A as *const c2Circle), *(B as *const c2AABB)),\n            C2_TYPE_CAPSULE => c2CircletoCapsule(*(A as *const c2Circle), *(B as *const c2Capsule)),\n            _ => 0,\n        },\n        C2_TYPE_AABB => match typeB {\n            C2_TYPE_CIRCLE => c2CircletoAABB(*(B as *const c2Circle), *(A as *const c2AABB)),\n            C2_TYPE_AABB => c2AABBtoAABB(*(A as *const c2AABB), *(B as *const c2AABB)),\n            C2_TYPE_CAPSULE => c2AABBtoCapsule(*(A as *const c2AABB), *(B as *const c2Capsule)),\n            _ => 0,\n        },\n        C2_TYPE_CAPSULE => match typeB {\n            C2_TYPE_CIRCLE => c2CircletoCapsule(*(B as *const c2Circle), *(A as *const c2Capsule)),\n            C2_TYPE_AABB => c2AABBtoCapsule(*(B as *const c2AABB), *(A as *const c2Capsule)),\n            C2_TYPE_CAPSULE => {\n                c2CapsuletoCapsule(*(A as *const c2Capsule), *(B as *const c2Capsule))\n            }\n            _ => 0,\n        },\n        _ => 0,\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Public entry point (include/lib.h)\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn aabb(min_x: f32, min_y: f32, max_x: f32, max_y: f32) -> c_int {\n    let mut result: c_int = 0;\n\n    let aabb_in = c2AABB {\n        min: c2V(min_x, min_y),\n        max: c2V(max_x, max_y),\n    };\n\n    let circle = c2Circle {\n        p