ck --offline --tests \"$@\" 2>&1 | tail -5; then\n        echo \"CHECK FAILED [$label]\"; fail=1; return\n    fi\n    note \"cargo build  [$label]\"\n    timeout 600 cargo build --offline \"$@\" >/dev/null 2>&1 || {\n        echo \"BUILD FAILED [$label]\"; fail=1; return; }\n    note \"symbol parity [$label]\"\n    ./check_symbols.sh || fail=1\n    note \"cargo test   [$label]\"\n    if ! timeout 600 cargo test --offline \"$@\" 2>&1 | tail -12; then\n        echo \"TESTS FAILED [$label]\"; fail=1\n    fi\n}\n\nfor c in \"${combos[@]}\"; do\n    if [ -z \"$c\" ]; then\n        run \"no-default-features\" --no-default-features\n    else\n        run \"no-default-features + $c\" --no-default-features --features \"$c\"\n    fi\ndone\n\n# The default and all-features builds too (identical here, but checked anyway).\nrun \"default\"\nrun \"all-features\" --all-features\n\nnote \"RESULT\"\nif [ \"$fail\" = 0 ]; then\n    echo \"ALL CONFIGURATIONS VERIFIED\"\nelse\n    echo \"FAILURES DETECTED\"\nfi\nexit $fail\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":15635,"cache_read_input_tokens":198338,"cache_creation":{"ephemeral_5m_input_tokens":15635,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"decfb6c4-450a-46c9-b484-bc4fca72900c","uuid":"8023d821-caf2-4372-a77e-48a6383ad2eb","timestamp":"2026-08-20T05:54:16.039Z"}
