{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01KMrJk4JUdCeTDqtyj2LGxh","type":"tool_result","content":"1\t//! Rust translation of c_src/src/lib.c (a cute_c2 style 2D collision library).\n2\t//!\n3\t//! Every public symbol exported by the C shared library is reproduced here with\n4\t//! the identical linker name, C ABI signature and bit-exact behaviour.  No bugs\n5\t//! of the original implementation have been \"fixed\": the order of the checks,\n6\t//! the floating point expressions and even reads of never-initialised fields are\n7\t//! mirrored as closely as possible.\n8\t\n9\t#![allow(non_snake_case)]\n10\t#![allow(non_camel_case_types)]\n11\t#![allow(non_upper_case_globals)]\n12\t#![allow(unused_assignments)]\n13\t\n14\tuse core::ffi::{c_int, c_uint, c_void};\n15\t\n16\t// ---------------------------------------------------------------------------\n17\t// Types\n18\t// ---------------------------------------------------------------------------\n19\t\n20\t/// `typedef enum { C2_TYPE_CIRCLE, C2_TYPE_AABB, C2_TYPE_CAPSULE } C2_TYPE;`\n21\t///\n22\t/// The C enum only has non-negative enumerators, so gcc gives it the\n23\t/// `unsigned int` representation.\n24\tpub type C2_TYPE = c_uint;\n25\t\n26\tpub const C2_TYPE_CIRCLE: C2_TYPE = 0;\n27\tpub const C2_TYPE_AABB: C2_TYPE = 1;\n28\tpub const C2_TYPE_CAPSULE: C2_TYPE = 2;\n29\t\n30\t#[repr(C)]\n31\t#[derive(Clone, Copy, PartialEq, Debug)]\n32\tpub struct c2v {\n33\t    pub x: f32,\n34\t    pub y: f32,\n35\t}\n36\t\n37\t#[repr(C)]\n38\t#[derive(Clone, Copy, Debug)]\n39\tpub struct c2r {\n40\t    pub c: f32,\n41\t    pub s: f32,\n42\t}\n43\t\n44\t#[repr(C)]\n45\t#[derive(Clone, Copy, Debug)]\n46\tpub struct c2x {\n47\t    pub p: c2v,\n48\t    pub r: c2r,\n49\t}\n50\t\n51\t#[repr(C)]\n52\t#[derive(Clone, Copy, Debug)]\n53\tpub struct c2Circle {\n54\t    pub p: c2v,\n55\t    pub r: f32,\n56\t}\n57\t\n58\t#[repr(C)]\n59\t#[derive(Clone, Copy, Debug)]\n60\tpub struct c2AABB {\n61\t    pub m