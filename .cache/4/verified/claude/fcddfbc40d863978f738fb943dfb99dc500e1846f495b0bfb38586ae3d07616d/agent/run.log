ck(\"hmput_key(raw keysize)\");\"\"\"\nnew3 = \"\"\"            let ce = self.ct.add(es * ci as usize);\n            let re = self.rt.add(es * ri as usize);\n            write_value(ce, re, self.value_off, value);\n            self.check(\"hmput_key(raw keysize)\");\"\"\"\nassert old3 in s\ns = s.replace(old3, new3)\nmarker = \"pub struct MapPair {\"\nhelper = \"\"\"/// Write the caller-owned \"value\" part of an element into both maps.\nunsafe fn write_value(ce: *mut u8, re: *mut u8, off: usize, value: &[u8]) {\n    unsafe {\n        if value.is_empty() {\n            return;\n        }\n        std::ptr::copy_nonoverlapping(value.as_ptr(), ce.add(off), value.len());\n        std::ptr::copy_nonoverlapping(value.as_ptr(), re.add(off), value.len());\n    }\n}\n\n\"\"\"\nassert marker in s\ns = s.replace(marker, helper + marker, 1)\nopen(p,'w').write(s)\nprint(\"ok\")\nEOF","description":"Patch harness value-write guards"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":951,"cache_read_input_tokens":178504,"cache_creation":{"ephemeral_5m_input_tokens":951,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"84845924-0592-4851-88b6-27cefaf022f4","uuid":"059e2814-cc1f-42f1-887d-40cb209fab0e","timestamp":"2026-08-20T16:15:22.367Z"}
