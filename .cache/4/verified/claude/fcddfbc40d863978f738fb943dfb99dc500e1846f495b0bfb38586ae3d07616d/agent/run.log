                           raw_a,\n853\t                            elemsize,\n854\t                            key,\n855\t                            keysize,\n856\t                            keyoffset,\n857\t                            mode,\n858\t                            (*bucket).index[i] as usize,\n859\t                        ) != 0\n860\t                        {\n861\t                            stbds_temp_set(a, (*bucket).index[i]);\n862\t                            if mode >= STBDS_HM_STRING {\n863\t                                let existing = *(raw_a.add(\n864\t                                    elemsize\n865\t                                        .wrapping_mul((*bucket).index[i] as usize)\n866\t                                        .wrapping_add(keyoffset),\n867\t                                ) as *mut *mut c_char);\n868\t                                stbds_temp_key_set(a, existing);\n869\t                            }\n870\t                            return arr_to_hash(a, elemsize) as *mut c_void;\n871\t                        }\n872\t                    } else if (*bucket).hash[i] == 0 {\n873\t                        pos = (pos & !STBDS_BUCKET_MASK) + i;\n874\t                        escaped = true;\n875\t                        break;\n876\t                    } else if tombstone < 0 {\n877\t                        if (*bucket).index[i] == STBDS_INDEX_DELETED {\n878\t                            tombstone = ((pos & !STBDS_BUCKET_MASK) + i) as isize;\n879\t                        }\n880\t                    }\n881\t                    i += 1;\n882\t                }\n883\t                if escaped {\n884\t                    break 'found_empty_slot;\n885\t                }\n886\t\n887\t                let limit = pos & STBDS_BUCKET_MASK;\n888\t                let mut i = 0usize;\n889\t                let mut escaped = false;\n890\t                while i < limit {\n891\t                    if (*bucket).hash[i] == hash {\n892\t          