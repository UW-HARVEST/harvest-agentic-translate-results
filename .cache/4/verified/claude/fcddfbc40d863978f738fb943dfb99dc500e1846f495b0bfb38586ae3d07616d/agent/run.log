, HM_STRING);\n            orig.push((k, kb));\n        }\n        unsafe {\n            let ti = *((*header_of(m.ct, 16)).hash_table as *const HashIndex);\n            assert_eq!(ti.slot_count, 8, \"expected a single 8-slot bucket\");\n            assert_eq!(ti.string.mode, 1, \"expected SH_DEFAULT\");\n            let tbl_seed = ti.seed;\n            let bk = *ti.storage;\n\n            for (k, kb) in &orig {\n                // where will the probe start, and where does the entry sit?\n                let mut h = (l.c.hash_string)(*k, tbl_seed);\n                if h < 2 {\n                    h += 2;\n                }\n                let start = (h & (ti.slot_count - 1)) & BUCKET_MASK;\n                let at = (0..BUCKET_LENGTH)\n                    .find(|&s| bk.hash[s] == h)\n                    .expect(\"key not in bucket\");\n\n                let before_c = temp_key_of(m.ct, 16);\n                let before_r = temp_key_of(m.rt, 16);\n                assert_eq!(before_c, before_r, \"temp_key must already agree\");\n\n                // a *different* pointer with the same contents\n                let dup = leak_cstr(kb);\n                assert_ne!(dup, *k);\n                m.put_string(dup, &(-1i64).to_le_bytes(), HM_STRING);\n                assert_eq!(hmlen(m.ct, 16), 6, \"duplicate must not insert\");\n\n                let after_c = temp_key_of(m.ct, 16);\n                let after_r = temp_key_of(m.rt, 16);\n                assert_eq!(\n                    after_c, after_r,\n                    \"C and RUST temp_key must agree (start={start} at={at})\"\n                );\n                if at >= start {\n                    first_loop += 1;\n                    assert_eq!(\n                        after_c, *k,\n                        \"first probe loop must report the ALREADY-STORED pointer, \\\\\n                         not the caller's (start={start} at={at})\"\n                    );\n                    assert_ne!(after_c, dup, \"must not be the caller's new pointer\");\n                } else {\n                    second_loop += 1;\n                    assert_eq!(\n                        after_c, before_c,\n                        \"second probe loop must leave temp_key UNTOUCHED \\\\\n                         (start={start} at={at})\"\n                    );\n                    assert_ne!(after_c, dup, \"must not be the caller's new pointer\");\n                }\n                free_raw(dup);\n            }\n        }\n        m.free();\n        for (k, _) in orig {\n            free_raw(k);\n        }\n    }\n    assert!(first_loop > 0, \"the FIRST probe loop was never exercised\");\n    assert!(\n        second_loop > 0,\n        \"the SECOND probe loop (which must NOT touch temp_key) was never exercised\"\n    );\n    eprintln!(\"temp_key: first loop {first_loop}x, second loop {second_loop}x\");\n}\n\n'''\nassert anchor in t\nt = t.replace(anchor, new + anchor, 1)\nopen(p,'w').write(t)\nprint(\"ok\")\nPY\ntimeout 300 cargo test --offline --test phase_c_errors -- --test-threads=1 --nocapture err_24b 2>&1 | tail -20","description":"Add targeted temp_key probe-loop test"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1982,"cache_read_input_tokens":342491,"cache_creation":{"ephemeral_5m_input_tokens":1982,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"84845924-0592-4851-88b6-27cefaf022f4","uuid":"2a1ab40c-f513-409d-9855-cbd3ce5293db","timestamp":"2026-08-20T16:46:20.539Z"}
