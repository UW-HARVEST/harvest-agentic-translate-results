[inline]\n45\tunsafe fn c_memmove(dst: *mut u8, src: *const u8, n: usize) {\n46\t    unsafe { ptr::copy(src, dst, n) }\n47\t}\n48\t\n49\t// ---------------------------------------------------------------------------\n50\t// Data structures (layout-identical to the C ones)\n51\t// ---------------------------------------------------------------------------\n52\t\n53\t/// `stbds_array_header`\n54\t#[repr(C)]\n55\tstruct stbds_array_header {\n56\t    length: usize,\n57\t    capacity: usize,\n58\t    hash_table: *mut c_void,\n59\t    temp: isize,\n60\t}\n61\t\n62\t/// `stbds_string_block`\n63\t#[repr(C)]\n64\tstruct stbds_string_block {\n65\t    next: *mut stbds_string_block,\n66\t    storage: [c_char; 8],\n67\t}\n68\t\n69\t/// `struct stbds_string_arena`\n70\t#[repr(C)]\n71\t#[derive(Clone, Copy)]\n72\tpub struct stbds_string_arena {\n73\t    storage: *mut stbds_string_block,\n74\t    remaining: usize,\n75\t    block: u8,\n76\t    mode: u8,\n77\t}\n78\t\n79\t/// `stbds_hash_bucket`\n80\t#[repr(C)]\n81\tstruct stbds_hash_bucket {\n82\t    hash: [usize; STBDS_BUCKET_LENGTH],\n83\t    index: [isize; STBDS_BUCKET_LENGTH],\n84\t}\n85\t\n86\t/// `stbds_hash_index`\n87\t#[repr(C)]\n88\tstruct stbds_hash_index {\n89\t    temp_key: *mut c_char,\n90\t    slot_count: usize,\n91\t    used_count: usize,\n92\t    used_count_threshold: usize,\n93\t    used_count_shrink_threshold: usize,\n94\t    tombstone_count: usize,\n95\t    tombstone_count_threshold: usize,\n96\t    seed: usize,\n97\t    slot_count_log2: usize,\n98\t    string: stbds_string_arena,\n99\t    storage: *mut stbds_hash_bucket,\n100\t}\n101\t\n102\tconst STBDS_BUCKET_LENGTH: usize = 8;\n103\tconst STBDS_BUCKET_SHIFT: usize = 3;\n104\tconst STBDS_BUCKET_MASK: usize = STBDS_BUCKET_LENGTH - 1;\n105\tconst STBDS_CACHE_LINE_SIZE: usize = 64;\n106\t\n107\tconst STBDS_INDEX_EMPTY: isize = -1;\n108\tconst STBDS_INDEX_DELETED: isize = -2;\n109\t\n110\tconst STBDS_HASH_EMPTY: usize = 0;\n111\tconst STBDS_HASH_DELETED: usize = 1;\n112\t\n113\t#[allow(dead_code)]\n114\tconst STBDS_HM_BINARY: c_int = 0;\n115\tconst STBDS_HM_STRING: c_int = 1;\n116\t\n117\t// enum { STBDS_SH_NONE, STBDS_SH_DEFAULT, STBDS_SH_STRDUP, STBDS_SH_ARENA }\n118\tconst STBDS_SH_NONE: u8 = 0;\n119\tconst STBDS_SH_DEFAULT: u8 = 1;\n120\tconst STBDS_SH_STRDUP: u8 = 2;\n121\tconst STBDS_SH_ARENA: u8 = 3;\n122\t\n123\tconst STBDS_SIZE_T_BITS: u32 = 64;\n124\tconst STBDS_SIPHASH_C_ROUNDS: usize = 2;\n125\tconst STBDS_SIPHASH_D_ROUNDS: usize = 4;\n126\t\n127\tconst HEADER_SIZE: usize = core::mem::size_of::<stbds_array_header>(); // 32\n128\t\n129\tconst STBDS_STRING_ARENA_BLOCKSIZE_MIN: usize = 512;\n130\tconst STBDS_STRING_ARENA_BLOCKSIZE_MAX: usize = 1 << 20;\n131\t\n132\t// Layout checks against the C structs (x86-64 SysV: 32/16/24/128/104 bytes).\n133\tconst _: () = {\n134\t    use core::mem::{align_of, size_of};\n135\t    assert!(size_of::<stbds_array_header>() == 32 && align_of::<stbds_array_header>() == 8);\n136\t    assert!(size_of::<stbds_string_block>() == 16);\n137\t    assert!(size_of::<stbds_string_arena>() == 24);\n138\t    assert!(size_of::<stbds_hash_bucket>() == 128);\n139\t    assert!(size_of::<stbds_hash_index>() == 104);\n140\t    assert!(size_of::<usize>() == 8, \"STBDS_SIPHASH_2_4 requires a 64-bit build\");\n141\t};\n142\t\n143\t// ---------------------------------------------------------------------------\n144\t// Macro helpers\n145\t// ---------------------------------------------------------------------------\n146\t\n147\t/// `stbds_header(t)` == `((stbds_array_header *)(t) - 1)`\n148\t#[inline]\n149\tunsafe fn stbds_header(t: *mut u8) -> *mut stbds_array_header {\n150\t    unsafe { (t as *mut stbds_array_header).offset(-1) }\n151\t}\n152\t\n153\t/// `stbds_arrlen(a)`\n154\t#[inline]\n155\tunsafe fn stbds_arrlen(a: *mut u8) -> isize {\n156\t    if a.is_null() {\n157\t        0\n158\t    } else {\n159\t        unsafe { (*stbds_header(a)).length as isize }\n160\t    }\n161\t}\n162\t\n163\t/// `stbds_arrcap(a)`\n164\t#[inline]\n165\tunsafe fn stbds_arrcap(a: *mut u8) -> usize {\n166\t    if a.is_null() {\n167\t        0\n168\t    } else {\n169\t        unsafe { (*stbds_header(a)).capacity }\n170\t    }\n171\t}\n172\t\n173\t/// `stbds_temp(t)` (read)\n174\t#[inline]\n175\tunsafe fn stbds_temp_get(t: *mut u8) -> isize {\n176\t    unsafe { (*stbds_header(t)).temp }\n177\t}\n178\t\n179\t/// `stbds_temp(t) = v`\n180\t#[inline]\n181\tunsafe fn stbds_temp_set(t: *mut u8, v: isize) {\n182\t    unsafe { (*stbds_header(t)).temp = v }\n183\t}\n184\t\n185\t/// `stbds_temp_key(t)` == `(*(char **) stbds_header(t)->hash_table)` (write)\n186\t#[inline]\n187\tunsafe fn stbds_temp_key_set(t: *mut u8, v: *mut c_char) {\n188\t    unsafe { *((*stbds_header(t)).hash_table as *mut *mut c_char) = v }\n189\t}\n190\t\n191\t/// `stbds_hash_table(a)`\n192\t#[inline]\n193\tunsafe fn stbds_hash_table(a: *mut u8) -> *mut stbds_hash_index {\n194\t    unsafe { (*stbds_header(a)).hash_table as *mut stbds_hash_index }\n195\t}\n196\t\n197\t/// `STBDS_HASH_TO_ARR(x,elemsize)`\n198\t#[inline]\n199\tunsafe fn hash_to_arr(x: *mut u8, elemsize: usize) -> *mut u8 {\n200\t    unsafe { x.sub(elemsize) }\n201\t}\n202\t\n203\t/// `STBDS_ARR_TO_HASH(x,elemsize)`\n204\t#[inline]\n205\tunsafe fn arr_to_hash(x: *mut u8, elemsize: usize) -> *mut u8 {\n206\t    unsafe { x.add(elemsize) }\n207\t}\n208\t\n209\t// ---------------------------------------------------------------------------\n210\t// stbds_arrgrowf / stbds_arrfreef\n211\t// ---------------------------------------------------------------------------\n212\t\n213\t#[unsafe(no_mangle)]\n214\tpub unsafe extern \"C\" fn stbds_arrgrowf(\n215\t    a: *mut c_void,\n216\t    elemsize: usize,\n217\t    addlen: usize,\n218\t    min_cap: usize,\n219\t) -> *mut c_void {\n220\t    unsafe {\n221\t        let a = a as *mut u8;\n222\t        let mut min_cap = min_cap;\n223\t        let min_len = (stbds_arrlen(a) as usize).wrapping_add(addlen);\n224\t\n225\t        if min_len > min_cap {\n226\t            min_cap = min_len;\n227\t        }\n228\t\n229\t        if min_cap <= stbds_arrcap(a) {\n230\t            return a as *mut c_void;\n231\t        }\n232\t\n233\t        let cap2 = stbds_arrcap(a).wrapping_mul(2);\n234\t        if min_cap < cap2 {\n235\t            min_cap = cap2;\n236\t        } else if min_cap < 4 {\n237\t            min_cap = 4;\n238\t        }\n239\t\n240\t        let old = if a.is_null() {\n241\t            ptr::null_mut()\n242\t        } else {\n243\t            stbds_header(a) as *mut c_void\n244\t        };\n245\t        let raw = stbds_realloc(\n246\t            old,\n247\t            elemsize.wrapping_mul(min_cap).wrapping_add(HEADER_SIZE),\n248\t        );\n249\t        let b = (raw as *mut u8).add(HEADER_SIZE);\n250\t        if a.is_null() {\n251\t            (*stbds_header(b)).length = 0;\n252\t            (*stbds_header(b)).hash_table = ptr::null_mut();\n253\t            (*stbds_header(b)).temp = 0;\n254\t        }\n255\t        (*stbds_header(b)).capacity = min_cap;\n256\t\n257\t        b as *mut c_void\n258\t    }\n259\t}\n260\t\n261\t#[unsafe(no_mangle)]\n262\tpub unsafe extern \"C\" fn stbds_arrfreef(a: *mut c_void) {\n263\t    unsafe {\n264\t        stbds_free(stbds_header(a as *mut u8) as *mut c_void);\n265\t    }\n266\t}\n267\t\n268\t// ---------------------------------------------------------------------------\n269\t// hashing\n270\t// ---------------------------------------------------------------------------\n271\t\n272\tstatic STBDS_HASH_SEED: AtomicUsize = AtomicUsize::new(0x3141_5926);\n273\t\n274\t#[unsafe(no_mangle)]\n275\tpub unsafe extern \"C\" fn stbds_rand_seed(seed: usize) {\n276\t    STBDS_HASH_SEED.store(seed, Ordering::Relaxed);\n277\t}\n278\t\n279\t/// `stbds_load_32_or_64(var, temp, v32, v64_hi, v64_lo)`\n280\t#[inline]\n281\tfn stbds_load_32_or_64(v32: u32, v64_hi: u32, v64_lo: u32) -> usize {\n282\t    // temp = v64_lo ^ v32, temp <<= 16, temp <<= 16, temp >>= 16, temp >>= 16\n283\t    let mut temp: usize = (v64_lo ^ v32) as usize;\n284\t    temp <<= 16;\n285\t    temp <<= 16;\n286\t    temp >>= 16;\n287\t    temp >>= 16;\n288\t    // var = v64_hi, var <<= 16, var <<= 16\n289\t    let mut var: usize = v64_hi as usize;\n290\t    var <<= 16;\n291\t    var <<= 16;\n292\t    // var ^= temp ^ v32\n293\t    var ^= temp ^ (v32 as usize);\n294\t    var\n295\t}\n296\t\n297\t#[inline]\n298\tfn stbds_probe_position(hash: usize, slot_count: usize, _slot_log2: usize) -> usize {\n299\t    hash & (slot_count - 1)\n300\t}\n301\t\n302\tfn stbds_log2(slot_count: usize) -> usize {\n303\t    let mut slot_count = slot_count;\n304\t    let mut n: usize = 0;\n305\t    while slot_count > 1 {\n306\t        slot_count >>= 1;\n307\t        n += 1;\n308\t    }\n309\t    n\n310\t}\n311\t\n312\t#[inline]\n313\tfn stbds_rotate_left(val: usize, n: u32) -> usize {\n314\t    (val << n) | (val >> (STBDS_SIZE_T_BITS - n))\n315\t}\n316\t\n317\t#[inline]\n318\tfn stbds_rotate_right(val: usize, n: u32) -> usize {\n319\t    (val >> n) | (val << (STBDS_SIZE_T_BITS - n))\n320\t}\n321\t\n322\t#[unsafe(no_mangle)]\n323\tpub unsafe extern \"C\" fn stbds_hash_string(str_: *mut c_char, seed: usize) -> usize {\n324\t    unsafe {\n325\t        let mut hash: usize = seed;\n326\t        let mut s = str_ as *const u8;\n327\t        while *s != 0 {\n328\t            hash = stbds_rotate_left(hash, 9).wrapping_add(*s as usize);\n329\t            s = s.add(1);\n330\t        }\n331\t\n332\t        hash ^= seed;\n333\t        hash = (!hash).wrapping_add(hash << 18);\n334\t        hash ^= hash ^ stbds_rotate_right(hash, 31);\n335\t        hash = hash.wrapping_mul(21);\n336\t        hash ^= hash ^ stbds_rotate_right(hash, 11);\n337\t        hash = hash.wrapping_add(hash << 6);\n338\t        hash ^= stbds_rotate_right(hash, 22);\n339\t        hash.wrapping_add(seed)\n340\t    }\n341\t}\n342\t\n343\tmacro_rules! siphash_round {\n344\t    ($v0:ident, $v1:ident, $v2:ident, $v3:ident) => {{\n345\t        $v0 = $v0.wrapping_add($v1);\n346\t        $v1 = stbds_rotate_left($v1, 13);\n347\t        $v1 ^= $v0;\n348\t        $v0 = stbds_rotate_left($v0, STBDS_SIZE_T_BITS / 2);\n349\t        $v2 = $v2.wrapping_add($v3);\n350\t        $v3 = stbds_rotate_left($v3, 16);\n351\t        $v3 ^= $v2;\n352\t        $v2 = $v2.wrapping_add($v1);\n353\t        $v1 = stbds_rotate_left($v1, 17);\n354\t        $v1 ^= $v2;\n355\t        $v2 = stbds_rotate_left($v2, STBDS_SIZE_T_BITS / 2);\n356\t        $v0 = $v0.wrapping_add($v3);\n357\t        $v3 = stbds_rotate_left($v3, 21);\n358\t        $v3 ^= $v0;\n359\t    }};\n360\t}\n361\t\n362\tunsafe fn stbds_siphash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n363\t    unsafe {\n364\t        let mut d = p as *const u8;\n365\t        let mut v0: usize;\n366\t        let mut v1: usize;\n367\t        let mut v2: usize;\n368\t        let mut v3: usize;\n369\t\n370\t        v0 = ((0x736f6d65usize << 16) << 16).wrapping_add(0x70736575) ^ seed;\n371\t        v1 = ((0x646f7261usize << 16) << 16).wrapping_add(0x6e646f6d) ^ !seed;\n372\t        v2 = ((0x6c796765usize << 16) << 16).wrapping_add(0x6e657261) ^ seed;\n373\t        v3 = ((0x74656462usize << 16) << 16).wrapping_add(0x79746573) ^ !seed;\n374\t\n375\t        v0 ^= 0x0706050403020100usize ^ seed;\n376\t        v1 ^= 0x0f0e0d0c0b0a0908usize ^ !seed;\n377\t        v2 ^= 0x0706050403020100usize ^ seed;\n378\t        v3 ^= 0x0f0e0d0c0b0a0908usize ^ !seed;\n379\t\n380\t        let mut i: usize = 0;\n381\t        let mut data: usize;\n382\t        while i + core::mem::size_of::<usize>() <= len {\n383\t            // data = d[0] | (d[1] << 8) | (d[2] << 16) | (d[3] << 24);\n384\t            // (int arithmetic in C: d[3]<<24 may become negative and then\n385\t            //  sign-extends when converted to size_t)\n386\t            let lo: i32 = (*d.add(0) as i32)\n387\t                | ((*d.add(1) as i32) << 8)\n388\t                | ((*d.add(2) as i32) << 16)\n389\t                | ((*d.add(3) as i32) << 24);\n390\t            data = lo as i64 as usize;\n391\t            let hi: i32 = (*d.add(4) as i32)\n392\t                | ((*d.add(5) as i32) << 8)\n393\t                | ((*d.add(6) as i32) << 16)\n394\t                | ((*d.add(7) as i32) << 24);\n395\t            data |= ((hi as i64 as usize) << 16) << 16;\n396\t\n397\t            v3 ^= data;\n398\t            for _ in 0..STBDS_SIPHASH_C_ROUNDS {\n399\t                siphash_round!(v0, v1, v2, v3);\n400\t            }\n401\t            v0 ^= data;\n402\t\n403\t            i += core::mem::size_of::<usize>();\n404\t            d = d.add(core::mem::size_of::<usize>());\n405\t        }\n406\t\n407\t        data = len << (STBDS_SIZE_T_BITS - 8);\n408\t        let rem = len - i;\n409\t        // switch (len - i) with fall-through\n410\t        if rem >= 7 {\n411\t            data |= ((*d.add(6) as usize) << 24) << 24;\n412\t        }\n413\t        if rem >= 6 {\n414\t            data |= ((*d.add(5) as usize) << 20) << 20;\n415\t        }\n416\t        if rem >= 5 {\n417\t            data |= ((*d.add(4) as usize) << 16) << 16;\n418\t        }\n419\t        if rem >= 4 {\n420\t            data |= (((*d.add(3) as i32) << 24) as i64) as usize;\n421\t        }\n422\t        if rem >= 3 {\n423\t            data |= (((*d.add(2) as i32) << 16) as i64) as usize;\n424\t        }\n425\t        if rem >= 2 {\n426\t            data |= (((*d.add(1) as i32) << 8) as i64) as usize;\n427\t        }\n428\t        if rem >= 1 {\n429\t            data |= (*d.add(0) as i32) as i64 as usize;\n430\t        }\n431\t\n432\t        v3 ^= data;\n433\t        for _ in 0..STBDS_SIPHASH_C_ROUNDS {\n434\t            siphash_round!(v0, v1, v2, v3);\n435\t        }\n436\t        v0 ^= data;\n437\t        v2 ^= 0xff;\n438\t        for _ in 0..STBDS_SIPHASH_D_ROUNDS {\n439\t            siphash_round!(v0, v1, v2, v3);\n440\t        }\n441\t\n442\t        v0 ^ v1 ^ v2 ^ v3\n443\t    }\n444\t}\n445\t\n446\t#[unsafe(no_mangle)]\n447\tpub unsafe extern \"C\" fn stbds_hash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n448\t    unsafe { stbds_siphash_bytes(p, len, seed) }\n449\t}\n450\t\n451\t// ---------------------------------------------------------------------------\n452\t// hash index construction\n453\t// ---------------------------------------------------------------------------\n454\t\n455\t#[inline]\n456\tfn stbds_align_fwd(n: usize, a: usize) -> usize {\n457\t    (n.wrapping_add(a - 1)) & !(a - 1)\n458\t}\n459\t\n460\tunsafe fn stbds_make_hash_index(\n461\t    slot_count: usize,\n462\t    ot: *mut stbds_hash_index,\n463\t) -> *mut stbds_hash_index {\n464\t    unsafe {\n465\t        let t = stbds_realloc(\n466\t            ptr::null_mut(),\n467\t            (slot_count >> STBDS_BUCKET_SHIFT)\n468\t                .wrapping_mul(core::mem::size_of::<stbds_hash_bucket>())\n469\t                .wrapping_add(core::mem::size_of::<stbds_hash_index>())\n470\t                .wrapping_add(STBDS_CACHE_LINE_SIZE - 1),\n471\t        ) as *mut stbds_hash_index;\n472\t\n473\t        (*t).storage =\n474\t            stbds_align_fwd(t.add(1) as usize, STBDS_CACHE_LINE_SIZE) as *mut stbds_hash_bucket;\n475\t        (*t).slot_count = slot_count;\n476\t        (*t).slot_count_log2 = stbds_log2(slot_count);\n477\t        (*t).tombstone_count = 0;\n478\t        (*t).used_count = 0;\n479\t\n480\t        (*t).used_count_threshold = slot_count - (slot_count >> 2);\n481\t        (*t).tombstone_count_threshold = (slot_count >> 3) + (slot_count >> 4);\n482\t        (*t).used_count_shrink_threshold = slot_count >> 2;\n483\t\n484\t        if slot_count <= STBDS_BUCKET_LENGTH {\n485\t            (*t).used_count_shrink_threshold = 0;\n486\t        }\n487\t\n488\t        if !ot.is_null() {\n489\t            (*t).string = (*ot).string;\n490\t            (*t).seed = (*ot).seed;\n491\t        } else {\n492\t            c_memset(\n493\t                (&raw mut (*t).string) as *mut u8,\n494\t                0,\n495\t                core::mem::size_of::<stbds_string_arena>(),\n496\t            );\n497\t            let old_seed = STBDS_HASH_SEED.load(Ordering::Relaxed);\n498\t            (*t).seed = old_seed;\n499\t            let a = stbds_load_32_or_64(2147001325, 0x27bb2ee6, 0x87b0b0fd);\n500\t            let b = stbds_load_32_or_64(715136305, 0, 0xb504f32d);\n501\t            STBDS_HASH_SEED.store(\n502\t                old_seed.wrapping_mul(a).wrapping_add(b),\n503\t                Ordering::Relaxed,\n504\t            );\n505\t        }\n506\t\n507\t        {\n508\t            let mut i: usize = 0;\n509\t            while i < slot_count >> STBDS_BUCKET_SHIFT {\n510\t                let b = (*t).storage.add(i);\n511\t                for j in 0..STBDS_BUCKET_LENGTH {\n512\t                    (*b).hash[j] = STBDS_HASH_EMPTY;\n513\t                }\n514\t                for j in 0..STBDS_BUCKET_LENGTH {\n515\t                    (*b).index[j] = STBDS_INDEX_EMPTY;\n516\t                }\n517\t                i += 1;\n518\t            }\n519\t        }\n520\t\n521\t        if !ot.is_null() {\n522\t            (*t).used_count = (*ot).used_count;\n523\t            let mut i: usize = 0;\n524\t            while i < (*ot).slot_count >> STBDS_BUCKET_SHIFT {\n525\t                let ob = (*ot).storage.add(i);\n526\t                for j in 0..STBDS_BUCKET_LENGTH {\n527\t                    if (*ob).index[j] >= 0 {\n528\t                        let hash = (*ob).hash[j];\n529\t                        let mut pos =\n530\t                            stbds_probe_position(hash, (*t).slot_count, (*t).slot_count_log2);\n531\t                        let mut step = STBDS_BUCKET_LENGTH;\n532\t                        'probe: loop {\n533\t                            let bucket = (*t).storage.add(pos >> STBDS_BUCKET_SHIFT);\n534\t\n535\t                            let mut z = pos & STBDS_BUCKET_MASK;\n536\t                            while z < STBDS_BUCKET_LENGTH {\n537\t                                if (*bucket).hash[z] == 0 {\n538\t                                    (*bucket).hash[z] = hash;\n539\t                                    (*bucket).index[z] = (*ob).index[j];\n540\t                                    break 'probe;\n541\t                                }\n542\t                                z += 1;\n543\t                            }\n544\t\n545\t                            let limit = pos & STBDS_BUCKET_MASK;\n546\t                            let mut z = 0usize;\n547\t                            while z < limit {\n548\t                                if (*bucket).hash[z] == 0 {\n549\t                                    (*bucket).hash[z] = hash;\n550\t                                    (*bucket).index[z] = (*ob).index[j];\n551\t                                    break 'probe;\n552\t                                }\n553\t                                z += 1;\n554\t                            }\n555\t\n556\t                            pos = pos.wrapping_add(step);\n557\t                            step += STBDS_BUCKET_LENGTH;\n558\t                            pos &= (*t).slot_count - 1;\n559\t                        }\n560\t                    }\n561\t                }\n562\t                i += 1;\n563\t            }\n564\t        }\n565\t\n566\t        t\n567\t    }\n568\t}\n569\t\n570\t// ---------------------------------------------------------------------------\n571\t// hash map internals\n572\t// ---------------------------------------------------------------------------\n573\t\n574\tunsafe fn stbds_is_key_equal(\n575\t    a: *mut u8,\n576\t    elemsize: usize,\n577\t    key: *mut c_void,\n578\t    keysize: usize,\n579\t    keyoffset: usize,\n580\t    mode: c_int,\n581\t    i: usize,\n582\t) -> c_int {\n583\t    unsafe {\n584\t        if mode >= STBDS_HM_STRING {\n585\t            let stored = *(a.add(elemsize.wrapping_mul(i).wrapping_add(keyoffset))\n586\t                as *mut *mut c_char);\n587\t            (0 == strcmp