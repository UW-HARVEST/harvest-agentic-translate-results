 explained).\nmod common;\n\nuse common::{capture_stdout_to_path, hash_stdout, impls};\n\nfn env_i64(k: &str, d: i64) -> i64 {\n    std::env::var(k).ok().and_then(|v| v.parse().ok()).unwrap_or(d)\n}\n\n#[test]\n#[ignore]\nfn investigate_chunk() {\n    let im = impls();\n    let start = env_i64(\"START\", -1_820_327_936);\n    let n = env_i64(\"N\", 4_194_304) as u32;\n    let lo = start as i32;\n    let reps = env_i64(\"REPS\", 1);\n\n    for rep in 0..reps {\n        let dir = std::env::temp_dir();\n        let pc = dir.join(\"inv_c.txt\");\n        let pr = dir.join(\"inv_r.txt\");\n        let nc = capture_stdout_to_path(&pc, || {\n            for k in 0..n {\n                (im.c.driver)(lo.wrapping_add(k as i32));\n            }\n        });\n        let nr = capture_stdout_to_path(&pr, || {\n            for k in 0..n {\n                (im.rust.driver)(lo.wrapping_add(k as i32));\n            }\n        });\n        eprintln!(\"rep {rep}: start={start} n={n} bytes C={nc} Rust={nr} (diff {})\", nc as i64 - nr as i64);\n        if nc != nr {\n            let bc = std::fs::read(&pc).unwrap();\n            let br = std::fs::read(&pr).unwrap();\n            let m = bc.len().min(br.len());\n            let mut i = 0;\n            while i < m && bc[i] == br[i] {\n                i += 1;\n            }\n            eprintln!(\"first difference at byte {i}\");\n            let s = i.saturating_sub(120);\n            eprintln!(\"C    : {:?}\", String::from_utf8_lossy(&bc[s..(i + 200).min(bc.len())]));\n            eprintln!(\"Rust : {:?}\", String::from_utf8_lossy(&br[s..(i + 200).min(br.len())]));\n            panic!(\"byte counts differ: C={nc} Rust={nr}\");\n        }\n        let _ = std::fs::remove_file(&pc);\n        let _ = std::fs::remove_file(&pr);\n    }\n    eprintln!(\"no divergence in {reps} reps\");\n}\n\n/// Same chunk, but through the hashing pipe capture, repeated, to see whether\n/// the 68-byte anomaly is specific to the pipe/hash path or time dependent.\n#[test]\n#[ignore]\nfn investigate_hash_path() {\n    let im = impls();\n    let start = env_i64(\"START\", -1_820_327_936);\n    let n = env_i64(\"N\", 4_194_304) as u32;\n    let lo = start as i32;\n    let reps = env_i64(\"REPS\", 40);\n    let t0 = std::time::Instant::now();\n    for rep in 0..reps {\n        let (hc, nc) = hash_stdout(|| {\n            for k in 0..n {\n                (im.c.driver)(lo.wrapping_add(k as i32));\n            }\n        });\n        let (hr, nr) = hash_stdout(|| {\n            for k in 0..n {\n                (im.rust.driver)(lo.wrapping_add(k as i32));\n            }\n        });\n        if (hc, nc) != (hr, nr) {\n            panic!(\n                \"rep {rep} at {:.1}s: C={hc:#x}/{nc} Rust={hr:#x}/{nr} (delta {})\",\n                t0.elapsed().as_secs_f64(),\n                nc as i64 - nr as i64\n            );\n        }\n    }\n    eprintln!(\"hash path OK for {reps} reps in {:.1}s\", t0.elapsed().as_secs_f64());\n}\n","structuredPatch":[{"oldStart":7,"oldLines":8,"newStart":7,"newLines":40,"lines":["     std::env::var(k).ok().and_then(|v| v.parse().ok()).unwrap_or(d)"," }"," ","+/// ORDER is a string of `c`/`r`: run that sequence of captures and report the","+/// byte count of each.  Distinguishes \"the Rust library misbehaves\" from \"the","+/// Nth capture misbehaves\"."," #[test]"," #[ignore]","+fn investigate_order() {","+    let im = impls();","+    let start = env_i64(\"START\", -1_820_327_936);","+    let n = env_i64(\"N\", 4_194_304) as u32;","+    let lo = start as i32;","+    let order: Vec<char> = std::env::var(\"ORDER\")","+        .unwrap_or_else(|_| \"cr\".into())","+        .chars()","+        .collect();","+    for (i, which) in order.iter().enumerate() {","+        let f = match which {","+            'c' => im.c.driver,","+            _ => im.rust.driver,","+        };","+        eprintln!(\"capture {i} ({which}) starting...\");","+        let p = std::env::temp_dir().join(format!(\"inv_{i}_{which