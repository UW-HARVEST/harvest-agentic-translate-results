{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01F9aedZHgU3HXDWajRnHGN5","type":"tool_result","content":"1\t//! Literal translation of the stb_ds implementation part of `c_src/src/lib.c`.\n2\t//!\n3\t//! Every function keeps the exact order of operations, the C integer\n4\t//! wrap-around semantics and the (intentional) sign-extension quirks of the\n5\t//! original code.\n6\t\n7\tuse core::ffi::{c_char, c_int, c_void};\n8\tuse core::ptr;\n9\t\n10\tuse crate::ffi::*;\n11\t\n12\t// ---------------------------------------------------------------------------\n13\t// #defines\n14\t// ---------------------------------------------------------------------------\n15\t\n16\tpub const STBDS_HM_BINARY: c_int = 0;\n17\tpub const STBDS_HM_STRING: c_int = 1;\n18\t\n19\tpub const STBDS_SH_NONE: c_int = 0;\n20\tpub const STBDS_SH_DEFAULT: c_int = 1;\n21\tpub const STBDS_SH_STRDUP: c_int = 2;\n22\tpub const STBDS_SH_ARENA: c_int = 3;\n23\t\n24\tpub const STBDS_BUCKET_LENGTH: usize = 8;\n25\tpub const STBDS_BUCKET_SHIFT: usize = 3;\n26\tpub const STBDS_BUCKET_MASK: usize = STBDS_BUCKET_LENGTH - 1;\n27\tpub const STBDS_CACHE_LINE_SIZE: usize = 64;\n28\t\n29\tpub const STBDS_INDEX_EMPTY: isize = -1;\n30\tpub const STBDS_INDEX_DELETED: isize = -2;\n31\t\n32\tpub const STBDS_HASH_EMPTY: usize = 0;\n33\tpub const STBDS_HASH_DELETED: usize = 1;\n34\t\n35\tpub const STBDS_SIZE_T_BITS: u32 = 64;\n36\t\n37\tconst STBDS_SIPHASH_C_ROUNDS: usize = 2;\n38\tconst STBDS_SIPHASH_D_ROUNDS: usize = 4;\n39\t\n40\tconst STBDS_STRING_ARENA_BLOCKSIZE_MIN: usize = 512;\n41\tconst STBDS_STRING_ARENA_BLOCKSIZE_MAX: usize = 1 << 20;\n42\t\n43\tconst HEADER_SIZE: usize = core::mem::size_of::<stbds_array_header>();\n44\t\n45\t/// `#define STBDS_INDEX_IN_USE(x) ((x) >= 0)`\n46\t#[inline(always)]\n47\tfn stbds_index_in_use(x: isize) -> bool {\n48\t    x >= 0\n49\t}\n50\t\n51\t/// `#define STBDS_ALIGN_FWD(n,a) (((n) + (a) - 1) & ~((a)-1))`\n52\t#[inline(always)]\n53\tfn stbds_align_fwd(n: usize, a: usize) -> usize {\n54\t    n.wrapping_add(a).wrapping_sub(1) & !(a.wrapping_sub(1))\n55\t}\n56\t\n57\t/// `#define STBDS_ROTATE_LEFT(val, n) (((val) << (n)) | ((val) >> (STBDS_SIZE_T_BITS - (n))))`\n58\t#[inline(always)]\n59\tfn rotate_left(val: usize, n: u32) -> usize {\n60\t    (val << n) | (val >> (STBDS_SIZE_T_BITS - n))\n61\t}\n62\t\n63\t/// `#define STBDS_ROTATE_RIGHT(val, n) (((val) >> (n)) | ((val) << (STBDS_SIZE_T_BITS - (n))))`\n64\t#[inline(always)]\n65\tfn rotate_right(val: usize, n: u32) -> usize {\n66\t    (val >> n) | (val << (STBDS_SIZE_T_BITS - n))\n67\t}\n68\t\n69\t// ---------------------------------------------------------------------------\n70\t// Array header access helpers (\"stbds_header(t)\", \"stbds_temp(t)\", ...)\n71\t// ---------------------------------------------------------------------------\n72\t\n73\t/// `#define stbds_header(t) ((stbds_array_header *) (t) - 1)`\n74\t#[inline(always)]\n75\tpub fn stbds_header(t: *mut c_void) -> *mut stbds_array_header {\n76\t    (t as *mut stbds_array_header).wrapping_sub(1)\n77\t}\n78\t\n79\t/// `#define stbds_arrlen(a) ((a) ? (ptrdiff_t) stbds_header(a)->length : 0)`\n80\t#[inline(always)]\n81\tpub(crate) unsafe fn stbds_arrlen(a: *mut c_void) -> isize {\n82\t    if !a.is_null() {\n83\t        (*stbds_header(a)).length as isize\n84\t    } else {\n85\t        0\n86\t    }\n87\t}\n88\t\n89\t/// `#define stbds_arrcap(a) ((a) ? stbds_header(a)->capacity : 0)`\n90\t#[inline(always)]\n91\tpub(crate) unsafe fn stbds_arrcap(a: *mut c_void) -> usize {\n92\t    if !a.is_null() {\n93\t        (*stbds_header(a)).capacity\n94\t    } else {\n95\t        0\n96\t    }\n97\t}\n98\t\n99\t/// `#define stbds_temp(t) stbds_header(t)->temp`\n100\t#[inline(always)]\n101\tpub(crate) unsafe fn stbds_temp_set(t: *mut c_void, v: isize) {\n102\t    (*stbds_header(t)).temp = v;\n103\t}\n104\t\n105\t/// `#define stbds_temp_key(t) (*(char **) stbds_header(t)->hash_table)`\n106\t#[inline(always)]\n107\tunsafe fn stbds_temp_key_set(t: *mut c_void, v: *mut c_char) {\n108\t    let ht = (*stbds_header(t)).hash_table as *mut *mut c_char;\n109\t    *ht = v;\n110\t}\n111\t\n112\t/// `#define stbds_hash_table(a) ((stbds_hash_index *) stbds_header(a)->hash_table)`\n113\t#[inline(always)]\n114\tunsafe fn stbds_hash_table(a: *mut c_void) -> *mut stbds_hash_index {\n115\t    (*stbds_header(a)).hash_table as *mut stbds_hash_index\n116\t}\n117\t\n118\t/// `#define STBDS_HASH_TO_ARR(x,elemsize) ((char*) (x) - (elemsize))`\n119\t#[inline(always)]\n120\tpub(crate) fn stbds_hash_to_arr(x: *mut c_void, elemsize: usize) -> *mut c_void {\n121\t    (x as *mut u8).wrapping_sub(elemsize) as *mut c_void\n122\t}\n123\t\n124\t/// `#define STBDS_ARR_TO_HASH(x,elemsize) ((char*) (x) + (elemsize))`\n125\t#[inline(always)]\n126\tpub(crate) fn stbds_arr_to_hash(x: *mut c_void, elemsize: usize) -> *mut c_void {\n127\t    (x as *mut u8).wrapping_add(elemsize) as *mut c_void\n128\t}\n129\t\n130\t/// `(char *) a + elemsize*i + keyoffset`\n131\t#[inline(always)]\n132\tpub(crate) fn elem_at(a: *mut c_void, elemsize: usize, i: usize, keyoffset: usize) -> *mut u8 {\n133\t    (a as *mut u8)\n134\t        .wrapping_add(elemsize.wrapping_mul(i))\n135\t        .wrapping_add(keyoffset)\n136\t}\n137\t\n138\t// ---------------------------------------------------------------------------\n139\t// dynamic array\n140\t// ---------------------------------------------------------------------------\n141\t\n142\t/// ```c\n143\t/// void *stbds_arrgrowf(void *a, size_t elemsize, size_t addlen, size_t min_cap)\n144\t/// ```\n145\t#[unsafe(no_mangle)]\n146\tpub unsafe extern \"C\" fn stbds_arrgrowf(\n147\t    a: *mut c_void,\n148\t    elemsize: usize,\n149\t    addlen: usize,\n150\t    mut min_cap: usize,\n151\t) -> *mut c_void {\n152\t    // stbds_array_header temp={0}; (void) sizeof(temp);\n153\t    let min_len: usize = (stbds_arrlen(a) as usize).wrapping_add(addlen);\n154\t\n155\t    if min_len > min_cap {\n156\t        min_cap = min_len;\n157\t    }\n158\t\n159\t    if min_cap <= stbds_arrcap(a) {\n160\t        return a;\n161\t    }\n162\t\n163\t    if min_cap < 2usize.wrapping_mul(stbds_arrcap(a)) {\n164\t        min_cap = 2usize.wrapping_mul(stbds_arrcap(a));\n165\t    } else if min_cap < 4 {\n166\t        min_cap = 4;\n167\t    }\n168\t\n169\t    let old: *mut c_void = if !a.is_null() {\n170\t        stbds_header(a) as *mut c_void\n171\t    } else {\n172\t        ptr::null_mut()\n173\t    };\n174\t\n175\t    let mut b = realloc(old, elemsize.wrapping_mul(min_cap).wrapping_add(HEADER_SIZE));\n176\t    b = (b as *mut u8).wrapping_add(HEADER_SIZE) as *mut c_void;\n177\t\n178\t    if a.is_null() {\n179\t        (*stbds_header(b)).length = 0;\n180\t        (*stbds_header(b)).hash_table = ptr::null_mut();\n181\t        (*stbds_header(b)).temp = 0;\n182\t    }\n183\t    (*stbds_header(b)).capacity = min_cap;\n184\t\n185\t    b\n186\t}\n187\t\n188\t/// ```c\n189\t/// void stbds_arrfreef(void *a)\n190\t/// ```\n191\t#[unsafe(no_mangle)]\n192\tpub unsafe extern \"C\" fn stbds_arrfreef(a: *mut c_void) {\n193\t    free(stbds_header(a) as *mut c_void);\n194\t}\n195\t\n196\t// ---------------------------------------------------------------------------\n197\t// hash index\n198\t// ---------------------------------------------------------------------------\n199\t\n200\t/// `static size_t stbds_hash_seed=0x31415926;`\n201\tstatic mut STBDS_HASH_SEED: usize = 0x3141_5926;\n202\t\n203\t/// ```c\n204\t/// void stbds_rand_seed(size_t seed)\n205\t/// ```\n206\t#[unsafe(no_mangle)]\n207\tpub unsafe extern \"C\" fn stbds_rand_seed(seed: usize) {\n208\t    STBDS_HASH_SEED = seed;\n209\t}\n210\t\n211\t/// ```c\n212\t/// static size_t stbds_probe_position(size_t hash, size_t slot_count, size_t slot_log2)\n213\t/// ```\n214\t#[inline(always)]\n215\tfn stbds_probe_position(hash: usize, slot_count: usize, _slot_log2: usize) -> usize {\n216\t    hash & slot_count.wrapping_sub(1)\n217\t}\n218\t\n219\t/// ```c\n220\t/// static size_t stbds_log2(size_t slot_count)\n221\t/// ```\n222\tfn stbds_log2(mut slot_count: usize) -> usize {\n223\t    let mut n: usize = 0;\n224\t    while slot_count > 1 {\n225\t        slot_count >>= 1;\n226\t        n += 1;\n227\t    }\n228\t    n\n229\t}\n230\t\n231\t/// ```c\n232\t/// stbds_load_32_or_64(a, temp, 2147001325, 0x27bb2ee6, 0x87b0b0fd);\n233\t/// stbds_load_32_or_64(b, temp,  715136305,          0, 0xb504f32d);\n234\t/// ```\n235\t/// (the intermediate `v64_lo ^ v32` is computed in `unsigned int`)\n236\t#[inline(always)]\n237\tfn stbds_load_32_or_64(v32: u32, v64_hi: u32, v64_lo: u32) -> usize {\n238\t    let mut temp: usize = (v64_lo ^ v32) as usize;\n239\t    temp <<= 16;\n240\t    temp <<= 16;\n241\t    temp >>= 16;\n242\t    temp >>= 16;\n243\t    let mut var: usize = v64_hi as usize;\n244\t    var <<= 16;\n245\t    var <<= 16;\n246\t    var ^= temp ^ (v32 as usize);\n247\t    var\n248\t}\n249\t\n250\t/// ```c\n251\t/// static stbds_hash_index *stbds_make_hash_index(size_t slot_count, stbds_hash_index *ot)\n252\t/// ```\n253\tunsafe fn stbds_make_hash_index(\n254\t    slot_count: usize,\n255\t    ot: *mut stbds_hash_index,\n256\t) -> *mut stbds_hash_index {\n257\t    let t = realloc(\n258\t        ptr::null_mut(),\n259\t        (slot_count >> STBDS_BUCKET_SHIFT)\n260\t            .wrapping_mul(core::mem::size_of::<stbds_hash_bucket>())\n261\t            .wrapping_add(core::mem::size_of::<stbds_hash_index>())\n262\t            .wrapping_add(STBDS_CACHE_LINE_SIZE - 1),\n263\t    ) as *mut stbds_hash_index;\n264\t\n265\t    (*t).storage = stbds_align_fwd(\n266\t        (t as usize).wrapping_add(core::mem::size_of::<stbds_hash_index>()),\n267\t        STBDS_CACHE_LINE_SIZE,\n268\t    ) as *mut stbds_hash_bucket;\n269\t    (*t).slot_count = slot_count;\n270\t    (*t).slot_count_log2 = stbds_log2(slot_count);\n271\t    (*t).tombstone_count = 0;\n272\t    (*t).used_count = 0;\n273\t\n274\t    (*t).used_count_threshold = slot_count.wrapping_sub(slot_count >> 2);\n275\t    (*t).tombstone_count_threshold = (slot_count >> 3).wrapping_add(slot_count >> 4);\n276\t    (*t).used_count_shrink_threshold = slot_count >> 2;\n277\t\n278\t    if slot_count <= STBDS_BUCKET_LENGTH {\n279\t        (*t).used_count_shrink_threshold = 0;\n280\t    }\n281\t    stbds_assert!(\n282\t        (*t).used_count_threshold.wrapping_add((*t).tombstone_count_threshold) < (*t).slot_count,\n283\t        b\"t->used_count_threshold + t->tombstone_count_threshold < t->slot_count\\0\",\n284\t        401,\n285\t        b\"stbds_make_hash_index\\0\"\n286\t    );\n287\t\n288\t    if !ot.is_null() {\n289\t        (*t).string = (*ot).string;\n290\t        (*t).seed = (*ot).seed;\n291\t    } else {\n292\t        ptr::write_bytes(\n293\t            ptr::addr_of_mut!((*t).string) as *mut u8,\n294\t            0,\n295\t            core::mem::size_of::<stbds_string_arena>(),\n296\t        );\n297\t        (*t).seed = STBDS_HASH_SEED;\n298\t        let a = stbds_load_32_or_64(2147001325, 0x27bb_2ee6, 0x87b0_b0fd);\n299\t        let b = stbds_load_32_or_64(715136305, 0, 0xb504_f32d);\n300\t        STBDS_HASH_SEED = STBDS_HASH_SEED.wrapping_mul(a).wrapping_add(b);\n301\t    }\n302\t\n303\t    {\n304\t        let mut i: usize = 0;\n305\t        while i < slot_count >> STBDS_BUCKET_SHIFT {\n306\t            let b = (*t).storage.wrapping_add(i);\n307\t            let mut j: usize = 0;\n308\t            while j < STBDS_BUCKET_LENGTH {\n309\t                (*b).hash[j] = STBDS_HASH_EMPTY;\n310\t                j += 1;\n311\t            }\n312\t            let mut j: usize = 0;\n313\t            while j < STBDS_BUCKET_LENGTH {\n314\t                (*b).index[j] = STBDS_INDEX_EMPTY;\n315\t                j += 1;\n316\t            }\n317\t            i += 1;\n318\t        }\n319\t    }\n320\t\n321\t    if !ot.is_null() {\n322\t        (*t).used_count = (*ot).used_count;\n323\t        let mut i: usize = 0;\n324\t        while i < (*ot).slot_count >> STBDS_BUCKET_SHIFT {\n325\t            let ob = (*ot).storage.wrapping_add(i);\n326\t            let mut j: usize = 0;\n327\t            while j < STBDS_BUCKET_LENGTH {\n328\t                if stbds_index_in_use((*ob).index[j]) {\n329\t                    let hash = (*ob).hash[j];\n330\t                    let mut pos =\n331\t                        stbds_probe_position(hash, (*t).slot_count, (*t).slot_count_log2);\n332\t                    let mut step = STBDS_BUCKET_LENGTH;\n333\t                    'done: loop {\n334\t                        let bucket = (*t).storage.wrapping_add(pos >> STBDS_BUCKET_SHIFT);\n335\t\n336\t                        let mut z: usize = pos & STBDS_BUCKET_MASK;\n337\t                        while z < STBDS_BUCKET_LENGTH {\n338\t                            if (*bucket).hash[z] == 0 {\n339\t                                (*bucket).hash[z] = hash;\n340\t                                (*bucket).index[z] = (*ob).index[j];\n341\t                                break 'done;\n342\t                            }\n343\t                            z += 1;\n344\t                        }\n345\t\n346\t                        let limit: usize = pos & STBDS_BUCKET_MASK;\n347\t                        let mut z: usize = 0;\n348\t                        while z < limit {\n349\t                            if (*bucket).hash[z] == 0 {\n350\t                                (*bucket).hash[z] = hash;\n351\t                                (*bucket).index[z] = (*ob).index[j];\n352\t                                break 'done;\n353\t                            }\n354\t                            z += 1;\n355\t                        }\n356\t\n357\t                        pos = pos.wrapping_add(step);\n358\t                        step = step.wrapping_add(STBDS_BUCKET_LENGTH);\n359\t                        pos &= (*t).slot_count.wrapping_sub(1);\n360\t                    }\n361\t                }\n362\t                j += 1;\n363\t            }\n364\t            i += 1;\n365\t        }\n366\t    }\n367\t\n368\t    t\n369\t}\n370\t\n371\t// ---------------------------------------------------------------------------\n372\t// hashing\n373\t// ---------------------------------------------------------------------------\n374\t\n375\t/// ```c\n376\t/// size_t stbds_hash_string(char *str, size_t seed)\n377\t/// ```\n378\t#[unsafe(no_mangle)]\n379\tpub unsafe extern \"C\" fn stbds_hash_string(str_: *mut c_char, seed: usize) -> usize {\n380\t    let mut hash: usize = seed;\n381\t    let mut s = str_ as *const u8;\n382\t    while *s != 0 {\n383\t        // hash = STBDS_ROTATE_LEFT(hash, 9) + (unsigned char) *str++;\n384\t        hash = rotate_left(hash, 9).wrapping_add(*s as usize);\n385\t        s = s.wrapping_add(1);\n386\t    }\n387\t\n388\t    hash ^= seed;\n389\t    hash = (!hash).wrapping_add(hash << 18);\n390\t    hash ^= hash ^ rotate_right(hash, 31);\n391\t    hash = hash.wrapping_mul(21);\n392\t    hash ^= hash ^ rotate_right(hash, 11);\n393\t    hash = hash.wrapping_add(hash << 6);\n394\t    hash ^= rotate_right(hash, 22);\n395\t    hash.wrapping_add(seed)\n396\t}\n397\t\n398\tmacro_rules! stbds_sipround {\n399\t    ($v0:ident, $v1:ident, $v2:ident, $v3:ident) => {\n400\t        $v0 = $v0.wrapping_add($v1);\n401\t        $v1 = rotate_left($v1, 13);\n402\t        $v1 ^= $v0;\n403\t        $v0 = rotate_left($v0, STBDS_SIZE_T_BITS / 2);\n404\t        $v2 = $v2.wrapping_add($v3);\n405\t        $v3 = rotate_left($v3, 16);\n406\t        $v3 ^= $v2;\n407\t        $v2 = $v2.wrapping_add($v1);\n408\t        $v1 = rotate_left($v1, 17);\n409\t        $v1 ^= $v2;\n410\t        $v2 = rotate_left($v2, STBDS_SIZE_T_BITS / 2);\n411\t        $v0 = $v0.wrapping_add($v3);\n412\t        $v3 = rotate_left($v3, 21);\n413\t        $v3 ^= $v0;\n414\t    };\n415\t}\n416\t\n417\t/// ```c\n418\t/// static size_t stbds_siphash_bytes(void *p, size_t len, size_t seed)\n419\t/// ```\n420\tunsafe fn stbds_siphash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n421\t    let mut d = p as *const u8;\n422\t    let mut i: usize;\n423\t    let mut j: usize;\n424\t    let mut v0: usize;\n425\t    let mut v1: usize;\n426\t    let mut v2: usize;\n427\t    let mut v3: usize;\n428\t    let mut data: usize;\n429\t\n430\t    v0 = (((0x736f_6d65usize << 16) << 16).wrapping_add(0x7073_6575)) ^ seed;\n431\t    v1 = (((0x646f_7261usize << 16) << 16).wrapping_add(0x6e64_6f6d)) ^ !seed;\n432\t    v2 = (((0x6c79_6765usize << 16) << 16).wrapping_add(0x6e65_7261)) ^ seed;\n433\t    v3 = (((0x7465_6462usize << 16) << 16).wrapping_add(0x7974_6573)) ^ !seed;\n434\t\n435\t    v0 ^= 0x0706_0504_0302_0100usize ^ seed;\n436\t    v1 ^= 0x0f0e_0d0c_0b0a_0908usize ^ !seed;\n437\t    v2 ^= 0x0706_0504_0302_0100usize ^ seed;\n438\t    v3 ^= 0x0f0e_0d0c_0b0a_0908usize ^ !seed;\n439\t\n440\t    i = 0;\n441\t    while i.wrapping_add(core::mem::size_of::<usize>()) <= len {\n442\t        // data = d[0] | (d[1] << 8) | (d[2] << 16) | (d[3] << 24);\n443\t        // NOTE: this is an `int` expression in C; for d[3] >= 0x80 the result is\n444\t        // negative and the conversion to size_t sign extends, setting all upper\n445\t        // 32 bits.  Reproduced verbatim (bug-compatible).\n446\t        let lo: c_int = (*d.wrapping_add(0) as c_int)\n447\t            | ((*d.wrapping_add(1) as c_int) << 8)\n448\t            | ((*d.wrapping_add(2) as c_int) << 16)\n449\t            | ((*d.wrapping_add(3) as c_int) << 24);\n450\t        data = lo as usize;\n451\t        let hi: c_int = (*d.wrapping_add(4) as c_int)\n452\t            | ((*d.wrapping_add(5) as c_int) << 8)\n453\t            | ((*d.wrapping_add(6) as c_int) << 16)\n454\t            | ((*d.wrapping_add(7) as c_int) << 24);\n455\t        data |= ((hi as usize) << 16) << 16;\n456\t\n457\t        v3 ^= data;\n458\t        j = 0;\n459\t        while j < STBDS_SIPHASH_C_ROUNDS {\n460\t            stbds_sipround!(v0, v1, v2, v3);\n461\t            j += 1;\n462\t        }\n463\t        v0 ^= data;\n464\t\n465\t        i = i.wrapping_add(core::mem::size_of::<usize>());\n466\t        d = d.wrapping_add(core::mem::size_of::<usize>());\n467\t    }\n468\t\n469\t    data = len << (STBDS_SIZE_T_BITS - 8);\n470\t    let rem = len.wrapping_sub(i);\n471\t    // switch (len - i) with fall-through\n472\t    if rem >= 7 {\n473\t        data |= ((*d.wrapping_add(6) as usize) << 24) << 24;\n474\t    }\n475\t    if rem >= 6 {\n476\t        data |= ((*d.wrapping_add(5) as usize) << 20) << 20;\n477\t    }\n478\t    if rem >= 5 {\n479\t        data |= ((*d.wrapping_add(4) as usize) << 16) << 16;\n480\t    }\n481\t    if rem >= 4 {\n482\t        // `(d[3] << 24)` is an int -> sign extends into the upper 32 bits.\n483\t        data |= ((*d.wrapping_add(3) as c_int) << 24) as usize;\n484\t    }\n485\t    if rem >= 3 {\n486\t        data |= ((*d.wrapping_add(2) as c_int) << 16) as usize;\n487\t    }\n488\t    if rem >= 2 {\n489\t        data |= ((*d.wrapping_add(1) as c_int) << 8) as usize;\n490\t    }\n491\t    if rem >= 1 {\n492\t        data |= (*d.wrapping_add(0) as c_int) as usize;\n493\t    }\n494\t\n495\t    v3 ^= data;\n496\t    j = 0;\n497\t    while j < STBDS_SIPHASH_C_ROUNDS {\n498\t        stbds_sipround!(v0, v1, v2, v3);\n499\t        j += 1;\n500\t    }\n501\t    v0 ^= data;\n502\t    v2 ^= 0xff;\n503\t    j = 0;\n504\t    while j < STBDS_SIPHASH_D_ROUNDS {\n505\t        stbds_sipround!(v0, v1, v2, v3);\n506\t        j += 1;\n507\t    }\n508\t\n509\t    v0 ^ v1 ^ v2 ^ v3\n510\t}\n511\t\n512\t/// ```c\n513\t/// size_t stbds_hash_bytes(void *p, size_t len, size_t seed)\n514\t/// ```\n515\t#[unsafe(no_mangle)]\n516\tpub unsafe extern \"C\" fn stbds_hash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n517\t    stbds_siphash_bytes(p, len, seed)\n518\t}\n519\t\n520\t/// ```c\n521\t/// static int stbds_is_key_equal(void *a, size_t elemsize, void *key, size_t keysize,\n522\t///                              size_t keyoffset, int mode, size_t i)\n523\t/// ```\n524\tunsafe fn stbd