{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01X8JB5WqmBXyRfpuBtC3Z1z","type":"tool_result","content":"1\t//! Raw C runtime bindings plus the shared data layout of the C library.\n2\t//!\n3\t//! The C code uses `realloc`/`free` from <stdlib.h> for every allocation\n4\t//! (`STBDS_REALLOC(c,p,s) realloc(p,s)` / `STBDS_FREE(c,p) free(p)`), so the\n5\t//! Rust translation must use the very same libc allocator: memory handed out by\n6\t//! e.g. `stbds_arrgrowf` may be released by `stbds_arrfreef` or by the caller,\n7\t//! and the allocation/free *sequence* has to stay identical.\n8\t\n9\tuse core::ffi::{c_char, c_int, c_uchar, c_uint, c_void};\n10\t\n11\textern \"C\" {\n12\t    pub fn realloc(p: *mut c_void, n: usize) -> *mut c_void;\n13\t    pub fn free(p: *mut c_void);\n14\t    pub fn memmove(d: *mut c_void, s: *const c_void, n: usize) -> *mut c_void;\n15\t    pub fn memcpy(d: *mut c_void, s: *const c_void, n: usize) -> *mut c_void;\n16\t    pub fn memcmp(a: *const c_void, b: *const c_void, n: usize) -> c_int;\n17\t    pub fn strcmp(a: *const c_char, b: *const c_char) -> c_int;\n18\t    pub fn strlen(s: *const c_char) -> usize;\n19\t    pub fn printf(fmt: *const c_char, ...) -> c_int;\n20\t    pub fn sprintf(buf: *mut c_char, fmt: *const c_char, ...) -> c_int;\n21\t    pub fn __assert_fail(\n22\t        assertion: *const c_char,\n23\t        file: *const c_char,\n24\t        line: c_uint,\n25\t        function: *const c_char,\n26\t    ) -> !;\n27\t}\n28\t\n29\t/// `assert()` from <assert.h>: `STBDS_ASSERT` is `#define`d to `assert` and\n30\t/// `NDEBUG` is never defined, so the assertions are live in the C build.\n31\tmacro_rules! stbds_assert {\n32\t    ($cond:expr, $text:expr, $line:expr, $func:expr) => {\n33\t        if !($cond) {\n34\t            $crate::ffi::__assert_fail(\n35\t                $text.as_ptr() as *const core::ffi::c_char,\n36\t                $crate::ffi::FILE_NAME.as_ptr() as *const core::ffi::c_char,\n37\t                $line,\n38\t                $func.as_ptr() as *const core::ffi::c_char,\n39\t            );\n40\t        }\n41\t    };\n42\t}\n43\tpub(crate) use stbds_assert;\n44\t\n45\tpub static FILE_NAME: &[u8] = b\"src/lib.c\\0\";\n46\t\n47\t// ---------------------------------------------------------------------------\n48\t// Layout of the structures shared with the C code.  These are part of the\n49\t// observable ABI (callers embed `stbds_string_arena` and read the array header\n50\t// through the stb_ds macros), so the layouts must match exactly.\n51\t// ---------------------------------------------------------------------------\n52\t\n53\t/// ```c\n54\t/// typedef struct {\n55\t///   size_t      length;\n56\t///   size_t      capacity;\n57\t///   void      * hash_table;\n58\t///   ptrdiff_t   temp;\n59\t/// } stbds_array_header;\n60\t/// ```\n61\t#[repr(C)]\n62\t#[derive(Clone, Copy)]\n63\tpub struct stbds_array_header {\n64\t    pub length: usize,\n65\t    pub capacity: usize,\n66\t    pub hash_table: *mut c_void,\n67\t    pub temp: isize,\n68\t}\n69\t\n70\t/// ```c\n71\t/// typedef struct stbds_string_block {\n72\t///   struct stbds_string_block *next;\n73\t///   char storage[8];\n74\t/// } stbds_string_block;\n75\t/// ```\n76\t#[repr(C)]\n77\t#[derive(Clone, Copy)]\n78\tpub struct stbds_string_block {\n79\t    pub next: *mut stbds_string_block,\n80\t    pub storage: [c_char; 8],\n81\t}\n82\t\n83\t/// ```c\n84\t/// struct stbds_string_arena {\n85\t///   stbds_string_block *storage;\n86\t///   size_t remaining;\n87\t///   unsigned char block;\n88\t///   unsigned char mode;\n89\t/// };\n90\t/// ```\n91\t#[repr(C)]\n92\t#[derive(Clone, Copy)]\n93\tpub struct stbds_string_arena {\n94\t    pub storage: *mut stbds_string_block,\n95\t    pub remaining: usize,\n96\t    pub block: c_uchar,\n97\t    pub mode: c_uchar,\n98\t}\n99\t\n100\t/// ```c\n101\t/// typedef struct {\n102\t///    size_t    hash [STBDS_BUCKET_LENGTH];\n103\t///    ptrdiff_t index[STBDS_BUCKET_LENGTH];\n104\t/// } stbds_hash_bucket;\n105\t/// ```\n106\t#[repr(C)]\n107\t#[derive(Clone, Copy)]\n108\tpub struct stbds_hash_bucket {\n109\t    pub hash: [usize; 8],\n110\t    pub index: [isize; 8],\n111\t}\n112\t\n113\t/// ```c\n114\t/// typedef struct {\n115\t///   char * temp_key;\n116\t///   size_t slot_count;\n117\t///   size_t used_count;\n118\t///   size_t used_count_threshold;\n119\t///   size_t used_count_shrink_threshold;\n120\t///   size_t tombstone_count;\n121\t///   size_t tombstone_count_threshold;\n122\t///   size_t seed;\n123\t///   size_t slot_count_log2;\n124\t///   stbds_string_arena string;\n125\t///   stbds_hash_bucket *storage;\n126\t/// } stbds_hash_index;\n127\t/// ```\n128\t#[repr(C)]\n129\tpub struct stbds_hash_index {\n130\t    pub temp_key: *mut c_char,\n131\t    pub slot_count: usize,\n132\t    pub used_count: usize,\n133\t    pub used_count_threshold: usize,\n134\t    pub used_count_shrink_threshold: usize,\n135\t    pub tombstone_count: usize,\n136\t    pub tombstone_count_threshold: usize,\n137\t    pub seed: usize,\n138\t    pub slot_count_log2: usize,\n139\t    pub string: stbds_string_arena,\n140\t    pub storage: *mut stbds_hash_bucket,\n141\t}\n142\t\n143\t// Compile time layout checks mirroring the C struct sizes on LP64.\n144\tconst _: () = {\n145\t    assert!(core::mem::size_of::<stbds_array_header>() == 32);\n146\t    assert!(core::mem::size_of::<stbds_string_block>() == 16);\n147\t    assert!(core::mem::size_of::<stbds_string_arena>() == 24);\n148\t    assert!(core::mem::size_of::<stbds_hash_bucket>() == 128);\n149\t    assert!(core::mem::size_of::<stbds_hash_index>() == 104);\n150\t    assert!(core::mem::size_of::<usize>() == 8);\n151\t};\n152\t"}]},"parent_tool_use_id":null,"session_id":"f0f99972-4265-4275-9682-9ed22be120aa","uuid":"762a3e92-66f4-412c-90ac-279d464bc3e2","timestamp":"2026-08-20T15:37:31.765Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-uLwdb7/translated_rust/src/ffi.rs","content":"//! Raw C runtime bindings plus the shared data layout of the C library.\n//!\n//! The C code uses `realloc`/`free` from <stdlib.h> for every allocation\n//! (`STBDS_REALLOC(c,p,s) realloc(p,s)` / `STBDS_FREE(c,p) free(p)`), so the\n//! Rust translation must use the very same libc allocator: memory handed out by\n//! e.g. `stbds_arrgrowf` may be released by `stbds_arrfreef` or by the caller,\n//! and the allocation/free *sequence* has to stay identical.\n\nuse core::ffi::{c_char, c_int, c_uchar, c_uint, c_void};\n\nextern \"C\" {\n    pub fn realloc(p: *mut c_void, n: usize) -> *mut c_void;\n    pub fn free(p: *mut c_void);\n    pub fn memmove(d: *mut c_void, s: *const c_void, n: usize) -> *mut c_void;\n    pub fn memcpy(d: *mut c_void, s: *const c_void, n: usize) -> *mut c_void;\n    pub fn memcmp(a: *const c_void, b: *const c_void, n: usize) -> c_int;\n    pub fn strcmp(a: *const c_char, b: *const c_char) -> c_int;\n    pub fn strlen(s: *const c_char) -> usize;\n    pub fn printf(fmt: *const c_char, ...) -> c_int;\n    pub fn sprintf(buf: *mut c_char, fmt: *const c_char, ...) -> c_int;\n    pub fn __assert_fail(\n        assertion: *const c_char,\n        file: *const c_char,\n        line: c_uint,\n        function: *const c_char,\n    ) -> !;\n}\n\n/// `assert()` from <assert.h>: `STBDS_ASSERT` is `#define`d to `assert` and\n/// `NDEBUG` is never defined, so the assertions are live in the C build.\nmacro_rules! stbds_assert {\n    ($cond:expr, $text:expr, $line:expr, $func:expr) => {\n        if !($cond) {\n            $crate::ffi::__assert_fail(\n                $text.as_ptr() as *const core::ffi::c_char,\n                $crate::ffi::FILE_NAME.as_ptr() as *const core::ffi::c_char,\n                $line,\n                $func.as_ptr() as *const core::ffi::c_char,\n            );\n        }\n    };\n}\npub(crate) use stbds_assert;\n\npub static FILE_NAME: &[u8] = b\"src/lib.c\\0\";\n\n// ---------------------------------------------------------------------------\n// Layout of the structures shared with the C code.  These are part of the\n// observable ABI (callers embed `stbds_string_arena` and read the array header\n// through the stb_ds macros), so the layouts must match exactly.\n// ---------------------------------------------------------------------------\n\n/// ```c\n/// typedef struct {\n///   size_t      length;\n///   size_t      capacity;\n///   void      * hash_table;\n///   ptrdiff_t   temp;\n/// } stbds_array_header;\n/// ```\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct stbds_array_header {\n    pub length: usize,\n    pub capacity: usize,\n    pub hash_table: *mut c_void,\n    pub temp: isize,\n}\n\n/// ```c\n/// typedef struct stbds_string_block {\n///   struct stbds_string_block *next;\n///   char storage[8];\n/// } stbds_string_block;\n/// ```\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct stbds_string_block {\n    pub next: *mut stbds_string_block,\n    pub storage: [c_char; 8],\n}\n\n/// ```c\n/// struct stbds_string_arena {\n///   stbds_string_block *storage;\n///   size_t remaining;\n///   unsigned char block;\n///   unsigned char mode;\n/// };\n/// ```\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct stbds_string_arena {\n    pub storage: *mut stbds_string_block,\n    pub remaining: usize,\n    pub block: c_uchar,\n    pub mode: c_uchar,\n}\n\n/// ```c\n/// typedef struct {\n///    size_t    hash [STBDS_BUCKET_LENGTH];\n///    ptrdiff_t index[STBDS_BUCKET_LENGTH];\n/// } stbds_hash_bucket;\n/// ```\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct stbds_hash_bucket {\n    pub hash: [usize; 8],\n    pub index: [isize; 8],\n}\n\n/// ```c\n/// typedef struct {\n///   char * temp_key;\n///   size_t slot_count;\n///   size_t used_count;\n///   size_t used_count_threshold;\n///   size_t used_count_shrink_threshold;\n///   size_t tombstone_count;\n///   size_t tombstone_count_threshold;\n///   size_t seed;\n///   size_t slot_count_log2;\n///   stbds_string_arena string;\n///   stbds_hash_bucket *storage;\n/// } stbds_hash_index;\n/// ```\n#[repr(C)]\npub struct stbds_hash_index {\n    pub temp_key: *mut c_char,\n    pub slot_count: usize,\n    pub used_count: usize,\n    pub used_count_threshold: usize,\n    pub used_count_shrink_threshold: usize,\n    pub tombstone_count: usize,\n    pub tombstone_count_threshold: usize,\n    pub seed: usize,\n    pub slot_count_log2: usize,\n    pub string: stbds_string_arena,\n    pub storage: *mut stbds_hash_bucket,\n}\n\n// Compile time layout checks mirroring the C struct sizes on LP64.\nconst _: () = {\n    assert!(core::mem::size_of::<stbds_array_header>() == 32);\n    assert!(core::mem::size_of::<stbds_string_block>() == 16);\n    assert!(core::mem::size_of::<stbds_string_arena>() == 24);\n    assert!(core::mem::size_of::<stbds_hash_bucket>() == 128);\n    assert!(core::mem::size_of::<stbds_hash_index>() == 104);\n    assert!(core::mem::size_of::<usize>() == 8);\n};\n","numLines":152,"startLine":1,"totalLines":152}}}
