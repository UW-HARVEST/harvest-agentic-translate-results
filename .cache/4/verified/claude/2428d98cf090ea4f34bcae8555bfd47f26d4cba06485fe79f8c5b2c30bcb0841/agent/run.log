city: 0,\n            hash_table_null: true,\n            temp: 0,\n            data: Vec::new(),\n        };\n    }\n    let h = header(a);\n    ArrObs {\n        is_null: false,\n        length: (*h).length,\n        capacity: (*h).capacity,\n        hash_table_null: (*h).hash_table.is_null(),\n        temp: (*h).temp,\n        data: std::slice::from_raw_parts(a as *const u8, data_len.min(elemsize * (*h).capacity))\n            .to_vec(),\n    }\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1012,"cache_read_input_tokens":164548,"cache_creation":{"ephemeral_5m_input_tokens":1012,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"f0f99972-4265-4275-9682-9ed22be120aa","uuid":"c55baf67-d239-4333-afe2-4058e5e7b071","timestamp":"2026-08-20T15:55:48.019Z"}
