{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01BunKzaZFyXhTHPV7RaaxVj","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"Mechanically verify that every ERRORS.md / CONFIGS.md row has a test.\n3\t\n4\tCoverage is declared in the test sources with annotation fields:\n5\t\n6\t    rows:     &[12, 13]     in tests/phase_c_*.rs   -> ERRORS.md  rows\n7\t    cfg_rows: &[7]          in tests/phase_b_*.rs   -> CONFIGS.md rows\n8\t\n9\tUsage:\n10\t    python3 check_coverage.py            # report\n11\t    python3 check_coverage.py --tick     # also tick CONFIGS.md checkboxes\n12\t\"\"\"\n13\timport glob\n14\timport re\n15\timport sys\n16\t\n17\tROOT = \".\"\n18\t\n19\t\n20\tdef table_rows(path):\n21\t    \"\"\"Row numbers present in a markdown table in `path`.\"\"\"\n22\t    out = []\n23\t    for line in open(path, encoding=\"utf-8\"):\n24\t        m = re.match(r\"^\\|\\s*(\\d+)\\s*\\|\", line)\n25\t        if m:\n26\t            out.append(int(m.group(1)))\n27\t    return out\n28\t\n29\t\n30\tdef declared(patterns, field):\n31\t    \"\"\"Row numbers declared via `field: &[...]` across the given globs.\"\"\"\n32\t    got = {}\n33\t    rx = re.compile(field + r\"\\s*:\\s*&\\[([0-9,\\s]*)\\]\")\n34\t    for g in patterns:\n35\t        for path in sorted(glob.glob(g)):\n36\t            for n in rx.finditer(open(path, encoding=\"utf-8\").read()):\n37\t                for tok in n.group(1).replace(\",\", \" \").split():\n38\t                    got.setdefault(int(tok), set()).add(path.split(\"/\")[-1])\n39\t    return got\n40\t\n41\t\n42\tdef report(name, table_path, globs, field):\n43\t    rows = table_rows(table_path)\n44\t    if not rows:\n45\t        print(f\"{name}: NO ROWS FOUND in {table_path}\")\n46\t        return False, {}\n47\t    expected = set(range(1, len(rows) + 1))\n48\t    seq_ok = rows == sorted(expected)\n49\t    cov = declared(globs, field)\n50\t    covered = set(cov) & expected\n51\t    missing = sorted(expected - covered)\n52\t    extra = sorted(set(cov) - expected)\n53\t\n54\t    print(f\"=== {name} ({table_path}) ===\")\n55\t    print(f\"  rows in table          : {len(rows)}  (1..{len(rows)})\")\n56\t    print(f\"  numbering sequential   : {seq_ok}\")\n57\t    print(f\"  rows covered by tests  : {len(covered)}\")\n58\t    print(f\"  rows MISSING coverage  : {len(missing)}\")\n59\t    if missing:\n60\t        print(f\"    -> {compress(missing)}\")\n61\t    if extra:\n62\t        print(f\"  annotations out of range: {extra}\")\n63\t    files = sorted({f for s in cov.values() for f in s})\n64\t    print(f\"  declaring files        : {files}\")\n65\t    ok = seq_ok and not missing and not extra\n66\t    print(f\"  RESULT: {'OK' if ok else 'INCOMPLETE'}\")\n67\t    print()\n68\t    return ok, cov\n69\t\n70\t\n71\tdef compress(ns):\n72\t    \"\"\"[1,2,3,7] -> '1-3,7'\"\"\"\n73\t    out, i = [], 0\n74\t    while i < len(ns):\n75\t        j = i\n76\t        while j + 1 < len(ns) and ns[j + 1] == ns[j] + 1:\n77\t            j += 1\n78\t        out.append(str(ns[i]) if i == j else f\"{ns[i]}-{ns[j]}\")\n79\t        i = j + 1\n80\t    return \",\".join(out)\n81\t\n82\t\n83\tdef tick(path, cov):\n84\t    \"\"\"Turn `| [ ] |` into `| [x] |` for covered rows.\"\"\"\n85\t    lines = open(path, encoding=\"utf-8\").read().split(\"\\n\")\n86\t    n = 0\n87\t    for i, line in enumerate(lines):\n88\t        m = re.match(r\"^\\|\\s*(\\d+)\\s*\\|\", line)\n89\t        if m and int(m.group(1)) in cov and line.rstrip().endswith(\"[ ] |\"):\n90\t            lines[i] = re.sub(r\"\\[ \\] \\|\\s*$\", \"[x] |\", line.rstrip())\n91\t            n += 1\n92\t    open(path, \"w\", encoding=\"utf-8\").write(\"\\n\".join(lines))\n93\t    print(f\"ticked {n} checkboxes in {path}\")\n94\t\n95\t\n96\tdef main():\n97\t    ok1, _ = report(\n98\t        \"ERRORS.md / Phase C\", f\"{ROOT}/ERRORS.md\", [f\"{ROOT}/tests/phase_c_*.rs\"], \"rows\"\n99\t    )\n100\t    ok2, cfgcov = report(\n101\t        \"CONFIGS.md / Phase B\",\n102\t        f\"{ROOT}/CONFIGS.md\",\n103\t        [f\"{ROOT}/tests/phase_b_*.rs\"],\n104\t        \"cfg_rows\",\n105\t    )\n106\t    if \"--tick\" in sys.argv:\n107\t        tick(f\"{ROOT}/CONFIGS.md\", set(cfgcov))\n108\t    print(\"OVERALL:\", \"OK\" if (ok1 and ok2) else \"INCOMPLETE\")\n109\t    return 0 if (ok1 and ok2) else 1\n110\t\n111\t\n112\tif __name__ == \"__main__\":\n113\t    sys.exit(main())\n114\t"}]},"parent_tool_use_id":"toolu_bdrk_0132LA9cgz2p7XSoHs8rV8dW","session_id":"cde48455-d5ce-4cd5-a0b0-2154082e5ad7","uuid":"f2a5fdab-4799-48a4-be30-cb13ec08a83f","timestamp":"2026-08-23T10:58:19.354Z","subagent_type":"general-purpose","task_description":"CONFIGS rows 294-351 dfa/substitute"}
