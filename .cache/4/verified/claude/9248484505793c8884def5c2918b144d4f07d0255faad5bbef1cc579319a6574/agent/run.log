*/\n426:      return ~(PCRE2_SIZE)0;\n541:    if (rc == ~(PCRE2_SIZE)0) return rc;\n582:  if (rc2 == ~(PCRE2_SIZE)0) return rc2;\n598:if (rc2 > ~(PCRE2_SIZE)0 - rc)  /* Integer overflow */\n599:  return ~(PCRE2_SIZE)0;\n643:       if (chkmc_length > ~(PCRE2_SIZE)0 - extra_needed)  /* Integer overflow */ \\\n695:      if (chkcc_rc > ~(PCRE2_SIZE)0 - extra_needed)  /* Integer overflow */ \\\n708:    if (chkcc_rc == ~(PCRE2_SIZE)0) goto CASEERROR; \\\n723:         if (guess > ~(PCRE2_SIZE)0 - extra_needed)  /* Integer overflow */ \\\n869:  if ((options & ~(SUBSTITUTE_OPTIONS|PCRE2_NO_UTF_CHECK)) !=\n951:suboptions = options & SUBSTITUTE_OPTIONS;\n952:options &= ~SUBSTITUTE_OPTIONS;\n1691:        (newlength_extra > ~(PCRE2_SIZE)0 - newlength_buf)?  /* Integer overflow */\n1692:        ~(PCRE2_SIZE)0 : newlength_buf + newlength_extra;    /* Cap the addition */\n1701:        if (additional > ~(PCRE2_SIZE)0 - extra_needed)  /* Integer overflow */\n1752:  if (extra_needed > ~(PCRE2_SIZE)0 - buff_length)  /* Integer overflow */\n=== convert ===\n46:#define TYPE_OPTIONS (PCRE2_CONVERT_GLOB| \\\n47:  PCRE2_CONVERT_POSIX_BASIC|PCRE2_CONVERT_POSIX_EXTENDED)\n49:#define ALL_OPTIONS (PCRE2_CONVERT_UTF|PCRE2_CONVERT_NO_UTF_CHECK| \\\n50:  PCRE2_CONVERT_GLOB_NO_WILD_SEPARATOR| \\\n51:  PCRE2_CONVERT_GLOB_NO_STARSTAR| \\\n163:BOOL extended = (pattype & PCRE2_CONVERT_POSIX_EXTENDED) != 0;\n857:BOOL no_wildsep = (options & PCRE2_CONVERT_GLOB_NO_WILD_SEPARATOR) != 0;\n858:BOOL no_starstar = (options & PCRE2_CONVERT_GLOB_NO_STARSTAR) != 0;\n1126:BOOL utf = (options & PCRE2_CONVERT_UTF) != 0;\n1159:if (utf && (options & PCRE2_CONVERT_NO_UTF_CHECK) == 0)\n1190:    case PCRE2_CONVERT_GLOB:\n1191:    rc = convert_glob(options & ~PCRE2_CONVERT_GLOB, pattern, plength, utf,\n1195:    case PCRE2_CONVERT_POSIX_BASIC:\n1196:    case PCRE2_CONVERT_POSIX_EXTENDED:","is_error":false}]},"parent_tool_use_id":"toolu_bdrk_013AKCBbobyVBAS3x5b4Hmgw","session_id":"cde48455-d5ce-4cd5-a0b0-2154082e5ad7","uuid