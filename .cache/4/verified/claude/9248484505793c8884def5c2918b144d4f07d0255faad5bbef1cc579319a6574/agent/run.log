{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_018TT6Hi4QSTQF3eqSxskVSa","type":"tool_result","content":"1\t// Phase B — the compile pipeline and both matchers, driven end to end the way\n2\t// a real consumer does: build a compile context, set the options, compile, then\n3\t// run the full match with a match context.\n4\t//\n5\t// The compiled bytecode is compared BYTE FOR BYTE, which is a far stronger\n6\t// check than comparing match results alone: it transitively validates every\n7\t// internal that only runs during compilation (the parser, `_pcre2_study_8`,\n8\t// `_pcre2_auto_possessify_8`, `_pcre2_check_escape_8`, the class compilers, the\n9\t// capture-group/name-table helpers), none of which can be called directly\n10\t// without fabricating an internal `compile_block`.\n11\t\n12\tmod common;\n13\tuse common::*;\n14\tuse std::ffi::{c_int, c_void};\n15\tuse std::ptr;\n16\t\n17\t/// One compile configuration: option bits plus compile-context state.\n18\t#[derive(Clone, Copy, Debug)]\n19\tpub struct Cfg {\n20\t    pub name: &'static str,\n21\t    pub opts: u32,\n22\t    pub xopts: u32,\n23\t    pub newline: u32,\n24\t    pub bsr: u32,\n25\t    pub varlookbehind: u32,\n26\t    pub parens_limit: u32,\n27\t    pub optimize: u32,\n28\t    pub own_tables: bool,\n29\t}\n30\t\n31\timpl Cfg {\n32\t    const fn new(name: &'static str, opts: u32, xopts: u32) -> Cfg {\n33\t        Cfg {\n34\t            name,\n35\t            opts,\n36\t            xopts,\n37\t            newline: 0,\n38\t            bsr: 0,\n39\t            varlookbehind: 0,\n40\t            parens_limit: 0,\n41\t            optimize: u32::MAX,\n42\t            own_tables: false,\n43\t        }\n44\t    }\n45\t}\n46\t\n47\t/// The configuration axes the C actually branches on, crossed.\n48\tfn configs() -> Vec<Cfg> {\n49\t    let mut v = vec![\n50\t        Cfg::new(\"default\", 0, 0),\n51\t        Cfg::new(\"CASELESS\", PCRE2_CASELESS, 0),\n52\t        Cfg::new(\"MULTILINE\", PCRE2_MULTILINE, 0),\n53\t        Cfg::new(\"DOTALL\", PCRE2_DOTALL, 0),\n54\t        Cfg::new(\"EXTENDED\", PCRE2_EXTENDED, 0),\n55\t        Cfg::new(\"EXTENDED_MORE\", PCRE2_EXTENDED | PCRE2_EXTENDED_MORE, 0),\n56\t        Cfg::new(\"UNGREEDY\", PCRE2_UNGREEDY, 0),\n57\t        Cfg::new(\"DUPNAMES\", PCRE2_DUPNAMES, 0),\n58\t        Cfg::new(\"NO_AUTO_CAPTURE\", PCRE2_NO_AUTO_CAPTURE, 0),\n59\t        Cfg::new(\"NO_AUTO_POSSESS\", PCRE2_NO_AUTO_POSSESS, 0),\n60\t        Cfg::new(\"NO_START_OPTIMIZE\", PCRE2_NO_START_OPTIMIZE, 0),\n61\t        Cfg::new(\"NO_DOTSTAR_ANCHOR\", PCRE2_NO_DOTSTAR_ANCHOR, 0),\n62\t        Cfg::new(\"ANCHORED\", PCRE2_ANCHORED, 0),\n63\t        Cfg::new(\"ENDANCHORED\", PCRE2_ENDANCHORED, 0),\n64\t        Cfg::new(\"ANCHORED|ENDANCHORED\", PCRE2_ANCHORED | PCRE2_ENDANCHORED, 0),\n65\t        Cfg::new(\"DOLLAR_ENDONLY|MULTILINE\", PCRE2_DOLLAR_ENDONLY | PCRE2_MULTILINE, 0),\n66\t        Cfg::new(\"FIRSTLINE\", PCRE2_FIRSTLINE, 0),\n67\t        Cfg::new(\"ALT_CIRCUMFLEX|MULTILINE\", PCRE2_ALT_CIRCUMFLEX | PCRE2_MULTILINE, 0),\n68\t        Cfg::new(\"ALT_BSUX\", PCRE2_ALT_BSUX, 0),\n69\t        Cfg::new(\"ALT_VERBNAMES\", PCRE2_ALT_VERBNAMES, 0),\n70\t        Cfg::new(\"ALLOW_EMPTY_CLASS\", PCRE2_ALLOW_EMPTY_CLASS, 0),\n71\t        Cfg::new(\"MATCH_UNSET_BACKREF\", PCRE2_MATCH_UNSET_BACKREF, 0),\n72\t        Cfg::new(\"LITERAL\", PCRE2_LITERAL, 0),\n73\t        Cfg::new(\"LITERAL|CASELESS\", PCRE2_LITERAL | PCRE2_CASELESS, 0),\n74\t        Cfg::new(\"AUTO_CALLOUT\", PCRE2_AUTO_CALLOUT, 0),\n75\t        Cfg::new(\"ALT_EXTENDED_CLASS\", PCRE2_ALT_EXTENDED_CLASS, 0),\n76\t        // --- UTF / UCP axis, the biggest behaviour switch in the library\n77\t        Cfg::new(\"UTF\", PCRE2_UTF, 0),\n78\t        Cfg::new(\"UCP\", PCRE2_UCP, 0),\n79\t        Cfg::new(\"UTF|UCP\", PCRE2_UTF | PCRE2_UCP, 0),\n80\t        Cfg::new(\"UTF|CASELESS\", PCRE2_UTF | PCRE2_CASELESS, 0),\n81\t        Cfg::new(\"UTF|UCP|CASELESS\", PCRE2_UTF | PCRE2_UCP | PCRE2_CASELESS, 0),\n82\t        Cfg::new(\"UTF|MATCH_INVALID_UTF\", PCRE2_UTF | PCRE2_MATCH_INVALID_UTF, 0),\n83\t        Cfg::new(\"UTF|UCP|DOTALL|MULTILINE\", PCRE2_UTF | PCRE2_UCP | PCRE2_DOTALL | PCRE2_MULTILINE, 0),\n84\t        // --- EXTRA options\n85\t        Cfg::new(\"X:CASELESS_RESTRICT\", PCRE2_CASELESS, PCRE2_EXTRA_CASELESS_RESTRICT),\n86\t        Cfg::new(\n87\t            \"UTF|UCP|CASELESS + X:CASELESS_RESTRICT\",\n88\t            PCRE2_UTF | PCRE2_UCP | PCRE2_CASELESS,\n89\t            PCRE2_EXTRA_CASELESS_RESTRICT,\n90\t        ),\n91\t        Cfg::new(\"X:TURKISH_CASING\", PCRE2_UTF | PCRE2_CASELESS, PCRE2_EXTRA_TURKISH_CASING),\n92\t        Cfg::new(\"X:ASCII_BSD\", PCRE2_UCP, PCRE2_EXTRA_ASCII_BSD),\n93\t        Cfg::new(\"X:ASCII_BSS\", PCRE2_UCP, PCRE2_EXTRA_ASCII_BSS),\n94\t        Cfg::new(\"X:ASCII_BSW\", PCRE2_UCP, PCRE2_EXTRA_ASCII_BSW),\n95\t        Cfg::new(\"X:ASCII_POSIX\", PCRE2_UCP, PCRE2_EXTRA_ASCII_POSIX),\n96\t        Cfg::new(\"X:ASCII_DIGIT\", PCRE2_UCP, PCRE2_EXTRA_ASCII_DIGIT),\n97\t        Cfg::new(\n98\t            \"X:ASCII_all|UCP|UTF\",\n99\t            PCRE2_UCP | PCRE2_UTF,\n100\t            PCRE2_EXTRA_ASCII_BSD | PCRE2_EXTRA_ASCII_BSS | PCRE2_EXTRA_ASCII_BSW\n101\t                | PCRE2_EXTRA_ASCII_POSIX | PCRE2_EXTRA_ASCII_DIGIT,\n102\t        ),\n103\t        Cfg::new(\"X:BAD_ESCAPE_IS_LITERAL\", 0, PCRE2_EXTRA_BAD_ESCAPE_IS_LITERAL),\n104\t        Cfg::new(\"X:MATCH_WORD\", 0, PCRE2_EXTRA_MATCH_WORD),\n105\t        Cfg::new(\"X:MATCH_LINE\", 0, PCRE2_EXTRA_MATCH_LINE),\n106\t        Cfg::new(\"X:MATCH_LINE|MULTILINE\", PCRE2_MULTILINE, PCRE2_EXTRA_MATCH_LINE),\n107\t        Cfg::new(\"X:ESCAPED_CR_IS_LF\", 0, PCRE2_EXTRA_ESCAPED_CR_IS_LF),\n108\t        Cfg::new(\"X:ALT_BSUX\", 0, PCRE2_EXTRA_ALT_BSUX | PCRE2_ALT_BSUX * 0),\n109\t        Cfg::new(\"ALT_BSUX + X:ALT_BSUX\", PCRE2_ALT_BSUX, PCRE2_EXTRA_ALT_BSUX),\n110\t        Cfg::new(\"X:ALLOW_LOOKAROUND_BSK\", 0, PCRE2_EXTRA_ALLOW_LOOKAROUND_BSK),\n111\t        Cfg::new(\"X:ALLOW_SURROGATE_ESCAPES|UTF\", PCRE2_UTF, PCRE2_EXTRA_ALLOW_SURROGATE_ESCAPES),\n112\t        Cfg::new(\"X:PYTHON_OCTAL\", 0, PCRE2_EXTRA_PYTHON_OCTAL),\n113\t        Cfg::new(\"X:NO_BS0\", 0, PCRE2_EXTRA_NO_BS0),\n114\t        Cfg::new(\"X:NEVER_CALLOUT\", 0, PCRE2_EXTRA_NEVER_CALLOUT),\n115\t    ];\n116\t    // --- newline convention axis (affects ., $, \\R, \\N and the CRLF scan)\n117\t    for nl in [\n118\t        PCRE2_NEWLINE_CR,\n119\t        PCRE2_NEWLINE_LF,\n120\t        PCRE2_NEWLINE_CRLF,\n121\t        PCRE2_NEWLINE_ANY,\n122\t        PCRE2_NEWLINE_ANYCRLF,\n123\t        PCRE2_NEWLINE_NUL,\n124\t    ] {\n125\t        let mut c = Cfg::new(\"MULTILINE + newline\", PCRE2_MULTILINE, 0);\n126\t        c.newline = nl;\n127\t        v.push(c);\n128\t        let mut c = Cfg::new(\"UTF|MULTILINE + newline\", PCRE2_UTF | PCRE2_MULTILINE, 0);\n129\t        c.newline = nl;\n130\t        v.push(c);\n131\t    }\n132\t    // --- \\R convention axis\n133\t    for bsr in [PCRE2_BSR_UNICODE, PCRE2_BSR_ANYCRLF] {\n134\t        let mut c = Cfg::new(\"bsr\", 0, 0);\n135\t        c.bsr = bsr;\n136\t        v.push(c);\n137\t        let mut c = Cfg::new(\"UTF + bsr\", PCRE2_UTF, 0);\n138\t        c.bsr = bsr;\n139\t        v.push(c);\n140\t    }\n141\t    // --- optimization directives (auto-possessify / start optimize on+off)\n142\t    for opt in [\n143\t        PCRE2_OPTIMIZATION_NONE,\n144\t        PCRE2_OPTIMIZATION_FULL,\n145\t        PCRE2_AUTO_POSSESS_OFF,\n146\t        PCRE2_START_OPTIMIZE_OFF,\n147\t    ] {\n148\t        let mut c = Cfg::new(\"optimize\", 0, 0);\n149\t        c.optimize = opt;\n150\t        v.push(c);\n151\t        let mut c = Cfg::new(\"UTF|UCP + optimize\", PCRE2_UTF | PCRE2_UCP, 0);\n152\t        c.optimize = opt;\n153\t        v.push(c);\n154\t    }\n155\t    // --- variable lookbehind limit\n156\t    for vl in [1u32, 2, 255] {\n157\t        let mut c = Cfg::new(\"max_varlookbehind\", 0, 0);\n158\t        c.varlookbehind = vl;\n159\t        v.push(c);\n160\t    }\n161\t    // --- parens nest limit (drives PARENTHESES_NEST_TOO_DEEP)\n162\t    for pl in [1u32, 3, 250] {\n163\t        let mut c = Cfg::new(\"parens_nest_limit\", 0, 0);\n164\t        c.parens_limit = pl;\n165\t        v.push(c);\n166\t    }\n167\t    // --- locale tables built by pcre2_maketables (vs the built-in defaults)\n168\t    let mut c = Cfg::new(\"own tables (pcre2_maketables)\", 0, 0);\n169\t    c.own_tables = true;\n170\t    v.push(c);\n171\t    let mut c = Cfg::new(\"own tables + CASELESS\", PCRE2_CASELESS, 0);\n172\t    c.own_tables = true;\n173\t    v.push(c);\n174\t    v\n175\t}\n176\t\n177\t/// `pcre2_compile` stores a BORROWED pointer to the character tables in the\n178\t/// compiled pattern (`re->tables = tables`) — that is exactly why\n179\t/// `pcre2_code_copy_with_tables` exists. So the locale tables must outlive every\n180\t/// `pcre2_code` compiled against them; they are built once and kept for the\n181\t/// lifetime of the process. (`pcre2_maketables_free` is covered separately.)\n182\tfn locale_tables(api: &Api) -> *const u8 {\n183\t    use std::sync::OnceLock;\n184\t    static C_T: OnceLock<usize> = OnceLock::new();\n185\t    static R_T: OnceLock<usize> = OnceLock::new();\n186\t    let cell = if api.name == \"C\" { &C_T } else { &R_T };\n187\t    *cell.get_or_init(|| {\n188\t        let t = unsafe { (api.maketables)(ptr::null_mut()) };\n189\t        assert!(!t.is_null(), \"[{}] pcre2_maketables_8 failed\", api.name);\n190\t        t as usize\n191\t    }) as *const u8\n192\t}\n193\t\n194\t/// A compile context configured per `Cfg`.\n195\tstruct Ctx {\n196\t    ccontext: Ptr,\n197\t}\n198\t\n199\tunsafe fn make_ctx(api: &Api, cfg: &Cfg) -> Ctx {\n200\t    let cc = (api.compile_context_create)(ptr::null_mut());\n201\t    assert!(!cc.is_null(), \"[{}] compile_context_create failed\", api.name);\n202\t    if cfg.newline != 0 {\n203\t        assert_eq!((api.set_newline)(cc, cfg.newline), 0);\n204\t    }\n205\t    if cfg.bsr != 0 {\n206\t        assert_eq!((api.set_bsr)(cc, cfg.bsr), 0);\n207\t    }\n208\t    if cfg.varlookbehind != 0 {\n209\t        assert_eq!((api.set_max_varlookbehind)(cc, cfg.varlookbehind), 0);\n210\t    }\n211\t    if cfg.parens_limit != 0 {\n212\t        assert_eq!((api.set_parens_nest_limit)(cc, cfg.parens_limit), 0);\n213\t    }\n214\t    if cfg.xopts != 0 {\n215\t        assert_eq!((api.set_compile_extra_options)(cc, cfg.xopts), 0);\n216\t    }\n217\t    if cfg.optimize != u32::MAX {\n218\t        assert_eq!((api.set_optimize)(cc, cfg.optimize), 0);\n219\t    }\n220\t    if cfg.own_tables {\n221\t        assert_eq!((api.set_character_tables)(cc, locale_tables(api)), 0);\n222\t    }\n223\t    Ctx { ccontext: cc }\n224\t}\n225\t\n226\tunsafe fn free_ctx(api: &Api, c: Ctx) {\n227\t    (api.compile_context_free)(c.ccontext);\n228\t}\n229\t\n230\t/// Compile `pat` under `cfg` in both libraries.  Asserts the two agree on\n231\t/// success/failure, on the error code and error offset, and (on success) that\n232\t/// the produced bytecode is byte-identical.  Returns the two code objects.\n233\tunsafe fn compile_both(p: &Pair, pat: &[u8], len: Sz, cfg: &Cfg, d: &mut Diffs) -> Option<(Ptr, Ptr)> {\n234\t    let cc = make_ctx(&p.c, cfg);\n235\t    let rc = make_ctx(&p.r, cfg);\n236\t    let (mut eca, mut ecb) = (0 as c_int, 0 as c_int);\n237\t    let (mut eoa, mut eob) = (usize::MAX, usize::MAX);\n238\t    let a = (p.c.compile)(pat.as_ptr(), len, cfg.opts, &mut eca, &mut eoa, cc.ccontext);\n239\t    let b = (p.r.compile)(pat.as_ptr(), len, cfg.opts, &mut ecb, &mut eob, rc.ccontext);\n240\t    free_ctx(&p.c, cc);\n241\t    free_ctx(&p.r, rc);\n242\t\n243\t    let tag = format!(\"compile({}) cfg[{}]\", show(pat), cfg.name);\n244\t    d.eq(&format!(\"{tag} null?\"), a.is_null(), b.is_null());\n245\t    d.eq(&format!(\"{tag} errorcode\"), eca, ecb);\n246\t    d.eq(&format!(\"{tag} erroroffset\"), eoa, eob);\n247\t    if a.is_null() || b.is_null() {\n248\t        if !a.is_null() {\n249\t            (p.c.code_free)(a);\n250\t        }\n251\t        if !b.is_null() {\n252\t            (p.r.code_free)(b);\n253\t        }\n254\t        return None;\n255\t    }\n256\t    assert_code_eq(a, b, &tag);\n257\t    d.checked += 1;\n258\t    Some((a, b))\n259\t}\n260\t\n261\t// ============================================== compile: bytecode + info\n262\t\n263\t// CONFIGS rows: every Cfg x every pattern -> identical bytecode and identical\n264\t// pattern_info for all 27 info ids.\n265\t#[test]\n266\tfn compile_bytecode_and_info_identical() {\n267\t    let p = pair();\n268\t    let cfgs = configs();\n269\t    let mut d = Diffs::new();\n270\t    for cfg in &cfgs {\n271\t        for pat in PATTERNS {\n272\t            let raw = pat.as_bytes();\n273\t            // both explicit length and PCRE2_ZERO_TERMINATED; the latter needs\n274\t            // a genuinely NUL-terminated buffer to read from\n275\t            let mut zt = raw.to_vec();\n276\t            zt.push(0);\n277\t            for &len in &[raw.len(), PCRE2_ZERO_TERMINATED] {\n278\t                if len == PCRE2_ZERO_TERMINATED && raw.contains(&0) {\n279\t                    continue;\n280\t                }\n281\t                let b: &[u8] = if len == PCRE2_ZERO_TERMINATED { &zt } else { raw };\n282\t                unsafe {\n283\t                    if let Some((a, bb)) = compile_both(p, b, len, cfg, &mut d) {\n284\t                        compare_all_info(p, a, bb, &format!(\"{} cfg[{}]\", show(b), cfg.name), &mut d);\n285\t                        (p.c.code_free)(a);\n286\t                        (p.r.code_free)(bb);\n287\t                    }\n288\t                }\n289\t            }\n290\t        }\n291\t    }\n292\t    println!(\"compile configs={} patterns={}\", cfgs.len(), PATTERNS.len());\n293\t    d.finish(\"compile: all Cfg x all PATTERNS x {explicit len, ZERO_TERMINATED}\");\n294\t}\n295\t\n296\t/// `pcre2_pattern_info` for every info id, using the right result width.\n297\tunsafe fn compare_all_info(p: &Pair, a: Ptr, b: Ptr, tag: &str, d: &mut Diffs) {\n298\t    // uint32_t results\n299\t    for what in [\n300\t        PCRE2_INFO_ARGOPTIONS,\n301\t        PCRE2_INFO_ALLOPTIONS,\n302\t        PCRE2_INFO_EXTRAOPTIONS,\n303\t        PCRE2_INFO_BACKREFMAX,\n304\t        PCRE2_INFO_BSR,\n305\t        PCRE2_INFO_CAPTURECOUNT,\n306\t        PCRE2_INFO_FIRSTCODEUNIT,\n307\t        PCRE2_INFO_FIRSTCODETYPE,\n308\t        PCRE2_INFO_HASCRORLF,\n309\t        PCRE2_INFO_JCHANGED,\n310\t        PCRE2_INFO_LASTCODEUNIT,\n311\t        PCRE2_INFO_LASTCODETYPE,\n312\t        PCRE2_INFO_MATCHEMPTY,\n313\t        PCRE2_INFO_MATCHLIMIT,\n314\t        PCRE2_INFO_MAXLOOKBEHIND,\n315\t        PCRE2_INFO_MINLENGTH,\n316\t        PCRE2_INFO_NAMECOUNT,\n317\t        PCRE2_INFO_NAMEENTRYSIZE,\n318\t        PCRE2_INFO_NEWLINE,\n319\t        PCRE2_INFO_DEPTHLIMIT,\n320\t        PCRE2_INFO_HASBACKSLASHC,\n321\t        PCRE2_INFO_HEAPLIMIT,\n322\t    ] {\n323\t        let (mut va, mut vb) = (0xDEAD_BEEFu32, 0xDEAD_BEEFu32);\n324\t        let ra = (p.c.pattern_info)(a, what, &mut va as *mut u32 as Ptr);\n325\t        let rb = (p.r.pattern_info)(b, what, &mut vb as *mut u32 as Ptr);\n326\t        d.eq(&format!(\"info[{what}] rc {tag}\"), ra, rb);\n327\t        d.eq(&format!(\"info[{what}] val {tag}\"), va, vb);\n328\t    }\n329\t    // PCRE2_SIZE results\n330\t    for what in [PCRE2_INFO_SIZE, PCRE2_INFO_FRAMESIZE, PCRE2_INFO_JITSIZE] {\n331\t        let (mut va, mut vb) = (usize::MAX, usize::MAX);\n332\t        let ra = (p.c.pattern_info)(a, what, &mut va as *mut usize as Ptr);\n333\t        let rb = (p.r.pattern_info)(b, what, &mut vb as *mut usize as Ptr);\n334\t        d.eq(&format!(\"info[{what}] rc {tag}\"), ra, rb);\n335\t        d.eq(&format!(\"info[{what}] val {tag}\"), va, vb);\n336\t    }\n337\t    // FIRSTBITMAP: pointer to a 32-byte table (or NULL)\n338\t    {\n339\t        let (mut pa, mut pb) = (ptr::null::<u8>(), ptr::null::<u8>());\n340\t        let ra = (p.c.pattern_info)(a, PCRE2_INFO_FIRSTBITMAP, &mut pa as *mut _ as Ptr);\n341\t        let rb = (p.r.pattern_info)(b, PCRE2_INFO_FIRSTBITMAP, &mut pb as *mut _ as Ptr);\n342\t        d.eq(&format!(\"info[FIRSTBITMAP] rc {tag}\"), ra, rb);\n343\t        d.eq(&format!(\"info[FIRSTBITMAP] null {tag}\"), pa.is_null(), pb.is_null());\n344\t        if !pa.is_null() && !pb.is_null() {\n345\t            d.eq(\n346\t                &format!(\"info[FIRSTBITMAP] bytes {tag}\"),\n347\t                std::slice::from_raw_parts(pa, 32).to_vec(),\n348\t                std::slice::from_raw_parts(pb, 32).to_vec(),\n349\t            );\n350\t        }\n351\t    }\n352\t    // NAMETABLE: name_count entries of name_entry_size bytes\n353\t    {\n354\t        let (mut na, mut nb) = (0u32, 0u32);\n355\t        (p.c.pattern_info)(a, PCRE2_INFO_NAMECOUNT, &mut na as *mut u32 as Ptr);\n356\t        (p.r.pattern_info)(b, PCRE2_INFO_NAMECOUNT, &mut nb as *mut u32 as Ptr);\n357\t        let (mut sa, mut sb) = (0u32, 0u32);\n358\t        (p.c.pattern_info)(a, PCRE2_INFO_NAMEENTRYSIZE, &mut sa as *mut u32 as Ptr);\n359\t        (p.r.pattern_info)(b, PCRE2_INFO_NAMEENTRYSIZE, &mut sb as *mut u32 as Ptr);\n360\t        if na == nb && sa == sb && na > 0 {\n361\t            let (mut ta, mut tb) = (ptr::null::<u8>(), ptr::null::<u8>());\n362\t            (p.c.pattern_info)(a, PCRE2_INFO_NAMETABLE, &mut ta as *mut _ as Ptr);\n363\t            (p.r.pattern_info)(b, PCRE2_INFO_NAMETABLE, &mut tb as *mut _ as Ptr);\n364\t            let n = (na * sa) as usize;\n365\t            d.eq(\n366\t                &format!(\"info[NAMETABLE] {tag}\"),\n367\t                std::slice::from_raw_parts(ta, n).to_vec(),\n368\t                std::slice::from_raw_parts(tb, n).to_vec(),\n369\t            );\n370\t            // and the by-name lookups over that table\n371\t            for i in 0..na {\n372\t                let ent = ta.add((i * sa) as usize);\n373\t                let name = ent.add(2); // 2-byte group number, then NUL-term name\n374\t                d.eq(\n375\t                    &format!(\"substring_number_from_name #{i} {tag}\"),\n376\t                    (p.c.substring_number_from_name)(a, name),\n377\t                    (p.r.substring_number_from_name)(b, name),\n378\t                );\n379\t                let (mut f1, mut l1) = (ptr::null(), ptr::null());\n380\t                let (mut f2, mut l2) = (ptr::null(), ptr::null());\n381\t                let ra = (p.c.substring_nametable_scan)(a, name, &mut f1, &mut l1);\n382\t                let rb = (p.r.substring_nametable_scan)(b, name, &mut f2, &mut l2);\n383\t                d.eq(&format!(\"nametable_scan rc #{i} {tag}\"), ra, rb);\n384\t                if ra >= 0 && rb >= 0 {\n385\t                    d.eq(\n386\t                        &format!(\"nametable_scan span #{i} {tag}\"),\n387\t                        (f1 as usize - ta as usize, l1 as usize - ta as usize),\n388\t                        (f2 as usize - tb as usize, l2 as usize - tb as usize),\n389\t                    );\n390\t                }\n391\t            }\n392\t        }\n393\t    }\n394\t}\n395\t\n396\t// ============================================================ code_copy\n397\t\n398\t// CONFIGS row: pcre2_code_copy / pcre2_code_copy_with_tables must reproduce a\n399\t// pattern that is byte-identical to the original and to the other library's.\n400\t#[test]\n401\tfn code_copy_identical() {\n402\t    let p = pair();\n403\t    let cfgs = configs();\n404\t    let mut d = Diffs::new();\n405\t    for cfg in cfgs.iter().take(34) {\n406\t        for pat in PATTERNS.iter().step_by(3) {\n407\t            let b = pat.as_bytes();\n408\t            unsafe {\n409\t                if let Some((a, bb)) = compile_both(p, b, b.len(), cfg, &mut d) {\n410\t                    let tag = format!(\"{} cfg[{}]\", show(b), cfg.name);\n411\t                    let ca = (p.c.code_copy)(a);\n412\t                    let cb = (p.r.code_copy)(bb);\n413\t                    assert!(!ca.is_null() && !cb.is_null(), \"code_copy failed {tag}\");\n414\t                    assert_code_eq(ca, cb, &format!(\"code_copy {tag}\"));\n415\t                    assert_code_eq(a, ca, &format!(\"code_copy vs original (C) {tag}\"));\n416\t                    let ta = (p.c.code_copy_with_tables)(a);\n417\t                    let tb = (p.r.code_copy_with_tables)(bb);\n418\t                    assert!(!ta.is_null() && !tb.is_null(), \"code_copy_with_tables failed {tag}\");\n419\t                    assert_code_eq(ta, tb, &format!(\"code_copy_with_tables {tag}\"));\n420\t                    d.checked += 2;\n421\t                    (p.c.code_free)(ca);\n422\t                    (p.r.code_free)(cb);\n423\t                    (p.c.code_free)(ta);\n424\t                    (p.r.code_free)(tb);\n425\t                    (p.c.code_free)(a);\n426\t                    (p.r.code_free)(bb);\n427\t                }\n428\t            }\n429\t        }\n430\t    }\n431\t    d.finish(\"pcre2_code_copy_8 / pcre2_code_copy_with_tables_8 over Cfg x patterns\");\n432\t}\n433\t\n434\t// ================================================================= matching\n435\t\n436\t/// Runs `pcre2_match` in both libraries and compares rc, ovector, startchar,\n437\t/// mark, and the derived match-data accessors.\n438\tunsafe fn cmp_match(\n439\t    p: &Pair,\n440\t    a: Ptr,\n441\t    b: Ptr,\n442\t    subj: &[u8],\n443\t    len: Sz,\n444\t    start: Sz,\n445\t    mopts: u32,\n446\t    ovecsize: u32,\n447\t    mctx: (Ptr, Ptr),\n448\t    tag: &str,\n449\t    d: &mut Diffs,\n450\t) {\n451\t    let mda = (p.c.match_data_create)(ovecsize, ptr::null_mut());\n452\t    let mdb = (p.r.match_data_create)(ovecsize, ptr::null_mut());\n453\t    let ra = (p.c.do_match)(a, subj.as_ptr(), len, start, mopts, mda, mctx.0);\n454\t    let rb = (p.r.do_match)(b, subj.as_ptr(), len, start, mopts, mdb, mctx.1);\n455\t    let oa = read_match_out(&p.c, mda, ra);\n456\t    let ob = read_match_out(&p.r, mdb, rb);\n457\t    d.eq(tag, oa, ob);\n458\t    d.eq(\n459\t        &format!(\"{tag} :: ovector_count\"),\n460\t        (p.c.get_ovector_count)(mda),\n461\t        (p.r.get_ovector_count)(mdb),\n462\t    );\n463\t    d.eq(\n464\t        &format!(\"{tag} :: match_data_size\"),\n465\t        (p.c.get_match_data_size)(mda),\n466\t        (p.r.get_match_data_size)(mdb),\n467\t    );\n468\t    d.eq(\n469\t        &format!(\"{tag} :: heapframes_size\"),\n470\t        (p.c.get_match_data_heapframes_size)(mda),\n471\t        (p.r.get_match_data_heapframes_size)(mdb),\n472\t    );\n473\t    // substring accessors over the result\n474\t    if ra > 0 && rb > 0 {\n475\t        for i in 0..(ra.max(rb) as u32 + 1) {\n476\t            let (mut la, mut lb) = (usize::MAX, usize::MAX);\n477\t            d.eq(\n478\t                &format!(\"{tag} :: substring_length_bynumber({i}) rc\"),\n479\t                (p.c.substring_length_bynumber)(mda, i, &mut la),\n480\t                (p.r.substring_length_bynumber)(mdb, i, &mut lb),\n481\t            );\n482\t            d.eq(&format!(\"{tag} :: substring_length_bynumber({i}) len\"), la, lb);\n483\t            let mut ba = [0u8; 256];\n484\t            let mut bb = [0u8; 256];\n485\t            let (mut ca, mut cb) = (ba.len(), bb.len());\n486\t            d.eq(\n487\t                &format!(\"{tag} :: substring_copy_bynumber({i}) rc\"),\n488\t                (p.c.substring_copy_bynumber)(mda, i, ba.as_mut_ptr(), &mut ca),\n489\t                (p.r.substring_copy_bynumber)(mdb, i, bb.as_mut_ptr(), &mut cb),\n490\t            );\n491\t            d.eq(&format!(\"{tag} :: substring_copy_bynumber({i}) out\"), (ba, ca), (bb, cb));\n492\t            let (mut pa, mut pb) = (ptr::null_mut::<u8>(), ptr::null_mut::<u8>());\n493\t            let (mut na, mut nb) = (usize::MAX, usize::MAX);\n494\t            let ga = (p.c.substring_get_bynumber)(mda, i, &mut pa, &mut na);\n495\t            let gb = (p.r.substring_get_bynumber)(mdb, i, &mut pb, &mut nb);\n496\t            d.eq(&format!(\"{tag} :: substring_get_bynumber({i}) rc\"), ga, gb);\n497\t            d.eq(&format!(\"{tag} :: substring_get_bynumber({i}) len\"), na, nb);\n498\t            if ga == 0 && gb == 0 {\n499\t                d.eq(\n500\t                    &format!(\"{tag} :: substring_get_bynumber({i}) bytes\"),\n501\t                    std::slice::from_raw_parts(pa, na + 1).to_vec(),\n502\t                    std::slice::from_raw_parts(pb, nb + 1).to_vec(),\n503\t                );\n504\t            }\n505\t            if !pa.is_null() {\n506\t                (p.c.substring_free)(pa);\n507\t            }\n508\t            if !pb.is_null() {\n509\t                (p.r.substring_free)(pb);\n510\t            }\n511\t        }\n512\t        // whole-list variant\n513\t        let (mut la, mut lb) = (ptr::null_mut(), ptr::null_mut());\n514\t        let (mut sa, mut sb) = (ptr::null_mut(), ptr::null_mut());\n515\t        let ra2 = (p.c.substring_list_get)(mda, &mut la, &mut sa);\n516\t        let rb2 = (p.r.substring_list_get)(mdb, &mut lb, &mut sb);\n517\t        d.eq(&format!(\"{tag} :: substring_list_get rc\"), ra2, rb2);\n518\t        if ra2 == 0 && rb2 == 0 {\n519\t            // The C uses `count = match_data->rc`, or `oveccount` when rc == 0\n520\t            // (ovector too small), and stores exactly `count` entries plus a\n521\t            // NULL terminator.\n522\t            let n = if ra > 0 {\n523\t                ra as usize\n524\t            } else {\n525\t                (p.c.get_ovector_count)(mda) as usize\n526\t            };\n527\t            for i in 0..n {\n528\t                let (x, y) = (*la.add(i), *lb.add(i));\n529\t                let (nx, ny) = (*sa.add(i), *sb.add(i));\n530\t                d.eq(&format!(\"{tag} :: list[{i}] len\"), nx, ny);\n531\t                if nx == ny {\n532\t                    d.eq(\n533\t                        &format!(\"{tag} :: list[{i}] bytes\"),\n534\t                        std::slice::from_raw_parts(x, nx).to_vec(),\n535\t                        std::slice::from_raw_parts(y, ny).to_vec(),\n536\t                    );\n537\t                }\n538\t            }\n539\t            (p.c.substring_list_free)(la);\n540\t            (p.r.substring_list_free)(lb);\n541\t        }\n542\t    }\n543\t    (p.c.match_data_free)(mda);\n544\t    (p.r.match_data_free)(mdb);\n545\t}\n546\t\n547\t/// Match options crossed over the axes `pcre2_match` branches on.\n548\tconst MOPTS: &[(u32, &str)] = &[\n549\t    (0, \"none\"),\n550\t    (PCRE2_NOTBOL, \"NOTBOL\"),\n551\t    (PCRE2_NOTEOL, \"NOTEOL\"),\n552\t    (PCRE2_NOTBOL | PCRE2_NOTEOL, \"NOTBOL|NOTEOL\"),\n553\t    (PCRE2_NOTEMPTY, \"NOTEMPTY\"),\n554\t    (PCRE2_NOTEMPTY_ATSTART, \"NOTEMPTY_ATSTART\"),\n555\t    (PCRE2_ANCHORED, \"ANCHORED\"),\n556\t    (PCRE2_ENDANCHORED, \"ENDANCHORED\"),\n557\t    (PCRE2_ANCHORED | PCRE2_ENDANCHORED, \"ANCHORED|ENDANCHORED\"),\n558\t    (PCRE2_PARTIAL_SOFT, \"PARTIAL_SOFT\"),\n559\t    (PCRE2_PARTIAL_HARD, \"PARTIAL_HARD\"),\n560\t    (PCRE2_NO_START_OPTIMIZE, \"NO_START_OPTIMIZE\"),\n561\t    (PCRE2_NO_UTF_CHECK, \"NO_UTF_CHECK\"),\n562\t    (PCRE2_COPY_MATCHED_SUBJECT, \"COPY_MATCHED_SUBJECT\"),\n563\t    (PCRE2_DISABLE_RECURSELOOP_CHECK, \"DISABLE_RECURSELOOP_CHECK\"),\n564\t    (PCRE2_NO_JIT, \"NO_JIT\"),\n565\t];\n566\t\n567\t/// Compile configurations used for matching (a representative spread; the full\n568\t/// set is covered by the bytecode test above).\n569\tfn match_cfgs() -> Vec<Cfg> {\n570\t    let all = configs();\n571\t    let names = [\n572\t        \"default\",\n573\t        \"CASELESS\",\n574\t        \"MULTILINE\",\n575\t        \"DOTALL\",\n576\t        \"UNGREEDY\",\n577\t        \"NO_START_OPTIMIZE\",\n578\t        \"NO_AUTO_POSSESS\",\n579\t        \"ANCHORED\",\n580\t        \"ENDANCHORED\",\n581\t        \"FIRSTLINE\",\n582\t        \"MATCH_UNSET_BACKREF\",\n583\t        \"AUTO_CALLOUT\",\n584\t        \"UTF\",\n585\t        \"UCP\",\n586\t        \"UTF|UCP\",\n587\t        \"UTF|CASELESS\",\n588\t        \"UTF|UCP|CASELESS\",\n589\t        \"UTF|MATCH_INVALID_UTF\",\n590\t        \"UTF|UCP|DOTALL|MULTILINE\",\n591\t        \"X:CASELESS_RESTRICT\",\n592\t        \"X:TURKISH_CASING\",\n593\t        \"X:ASCII_all|UCP|UTF\",\n594\t        \"X:MATCH_WORD\",\n595\t        \"X:MATCH_LINE\",\n596\t        \"own tables (pcre2_maketables)\",\n597\t    ];\n598\t    let mut v: Vec<Cfg> = all\n599\t        .iter()\n600\t        .filter(|c| names.contains(&c.name))\n601\t        .cloned()\n602\t        .collect();\n603\t    // plus each newline convention with MULTILINE, and both \\R conventions\n604\t    for nl in [\n605\t        PCRE2_NEWLINE_CR,\n606\t        PCRE2_NEWLINE_LF,\n607\t        PCRE2_NEWLINE_CRLF,\n608\t        PCRE2_NEWLINE_ANY,\n609\t        PCRE2_NEWLINE_ANYCRLF,\n610\t        PCRE2_NEWLINE_NUL,\n611\t    ] {\n612\t        let mut c = Cfg::new(\"MULTILINE + newline\", PCRE2_MULTILINE, 0);\n613\t        c.newline = nl;\n614\t        v.push(c);\n615\t    }\n616\t    for bsr in [PCRE2_BSR_UNICODE, PCRE2_BSR_ANYCRLF] {\n617\t        let mut c = Cfg::new(\"UTF + bsr\", PCRE2_UTF, 0);\n618\t        c.bsr = bsr;\n619\t        v.push(c);\n620\t    }\n621\t    v\n622\t}\n623\t\n624\t// CONFIGS rows: pcre2_match over (compile cfg) x (pattern) x (subject) x\n625\t// (match options) x (startoffset) x (ovector size).\n626\t#[test]\n627\tfn match_identical() {\n628\t    let p = pair();\n629\t    let mut rng = Rng::new(100);\n630\t    let mut d = Diffs::new();\n631\t    // Bound the run: deterministic limits so both libraries hit them alike.\n632\t    let mca = unsafe { (p.c.match_context_create)(ptr::null_mut()) };\n633\t    let mcb = unsafe { (p.r.match_context_create)(ptr::null_mut()) };\n634\t    unsafe {\n635\t        for (m, v) in [(&p.c, mca), (&p.r, mcb)] {\n636\t            assert_eq!((m.set_match_limit)(v, 20_000), 0);\n637\t            assert_eq!((m.set_depth_limit)(v, 2_000), 0);\n638\t            assert_eq!((m.set_heap_limit)(v, 200), 0);\n639\t        }\n640\t    }\n641\t    for cfg in &match_cfgs() {\n642\t        for pat in PATTERNS {\n643\t            let pb = pat.as_bytes();\n644\t            unsafe {\n645\t                let Some((a, b)) = compile_both(p, pb, pb.len(), cfg, &mut d) else {\n646\t                    continue;\n647\t                };\n648\t                for subj in SUBJECTS {\n649\t                    let raw = subj.as_bytes();\n650\t                    let mut zt = raw.to_vec();\n651\t                    zt.push(0);\n652\t                    // a random slice of the option/offset/ovector axes per\n653\t                    // (pattern, subject) keeps the run bounded while still\n654\t                    // covering every axis many thousands of times overall\n655\t                    for _ in 0..3 {\n656\t                        let (mo, mn) = MOPTS[rng.below(MOPTS.len())];\n657\t                        let start = if raw.is_empty() { 0 } else { rng.below(raw.len() + 1) };\n658\t                        let ovec = *rng.pick(&[0u32, 1, 2, 4, 16, 64]);\n659\t                        let zero_term = rng.chance(4) && !raw.contains(&0);\n660\t                        let len = if zero_term { PCRE2_ZERO_TERMINATED } else { raw.len() };\n661\t                        let sb: &[u8] = if zero_term { &zt } else { raw };\n662\t                        let tag = format!(\n663\t                            \"match {} cfg[{}] subj={} start={} mopts={} ovec={} len={}\",\n664\t                            show(pb),\n665\t                            cfg.name,\n666\t                            show(sb),\n667\t                            start,\n668\t                            mn,\n669\t                            ovec,\n670\t                            if len == PCRE2_ZERO_TERMINATED { \"ZT\".into() } else { len.to_string() }\n671\t                        );\n672\t                        cmp_match(p, a, b, sb, len, start, mo, ovec, (mca, mcb), &tag, &mut d);\n673\t                    }\n674\t                }\n675\t                (p.c.code_free)(a);\n676\t                (p.r.code_free)(b);\n677\t            }\n678\t        }\n679\t    }\n680\t    unsafe {\n681\t        (p.c.match_context_free)(mca);\n682\t        (p.r.match_context_free)(mcb);\n683\t    }\n684\t    d.finish(\"pcre2_match_8: match_cfgs x PATTERNS x SUBJECTS x MOPTS x startoffset x ovector size\");\n685\t}\n686\t\n687\t// CONFIGS rows: pcre2_dfa_match over the same axes, plus DFA_SHORTEST,\n688\t// DFA_RESTART and workspace sizes.\n689\t#[test]\n690\tfn dfa_match_identical() {\n691\t    let p = pair();\n692\t    let mut rng = Rng::new(200);\n693\t    let mut d = Diffs::new();\n694\t    let mca = unsafe { (p.c.match_context_create)(ptr::null_mut()) };\n695\t    let mcb = unsafe { (p.r.match_context_create)(ptr::null_mut()) };\n696\t    unsafe {\n697\t        for (m, v) in [(&p.c, mca), (&p.r, mcb)] {\n698\t            assert_eq!((m.set_match_limit)(v, 20_000), 0);\n699\t            assert_eq!((m.set_depth_limit)(v, 2_000), 0);\n700\t        }\n701\t    }\n702\t    let dfa_opts: &[(u32, &str)] = &[\n703\t        (0, \"none\"),\n704\t        (PCRE2_DFA_SHORTEST, \"DFA_SHORTEST\"),\n705\t        (PCRE2_NOTBOL, \"NOTBOL\"),\n706\t        (PCRE2_NOTEOL, \"NOTEOL\"),\n707\t        (PCRE2_NOTEMPTY, \"NOTEMPTY\"),\n708\t        (PCRE2_NOTEMPTY_ATSTART, \"NOTEMPTY_ATSTART\"),\n709\t        (PCRE2_ANCHORED, \"ANCHORED\"),\n710\t        (PCRE2_ENDANCHORED, \"ENDANCHORED\"),\n711\t        (PCRE2_PARTIAL_SOFT, \"PARTIAL_SOFT\"),\n712\t        (PCRE2_PARTIAL_HARD, \"PARTIAL_HARD\"),\n713\t        (PCRE2_NO_START_OPTIMIZE, \"NO_START_OPTIMIZE\"),\n714\t        (PCRE2_NO_UTF_CHECK, \"NO_UTF_CHECK\"),\n715\t        (PCRE2_COPY_MATCHED_SUBJECT, \"COPY_MATCHED_SUBJECT\"),\n716\t    ];\n717\t    for cfg in &match_cfgs() {\n718\t        for pat in PATTERNS {\n719\t            let pb = pat.as_bytes();\n720\t            unsafe {\n721\t                let Some((a, b)) = compile_both(p, pb, pb.len(), cfg, &mut d) else {\n722\t                    continue;\n723\t                };\n724\t                for subj in SUBJECTS {\n725\t                    let sb = subj.as_bytes();\n726\t                    for _ in 0..3 {\n727\t                        let (mo, mn) = dfa_opts[rng.below(dfa_opts.len())];\n728\t                        let start = if sb.is_empty() { 0 } else { rng.below(sb.len() + 1) };\n729\t                        let ovec = *rng.pick(&[0u32, 1, 2, 4, 16]);\n730\t                        // include a deliberately tiny workspace to reach\n731\t                        // PCRE2_ERROR_DFA_WSSIZE identically\n732\t                        let wsn = *rng.pick(&[20usize, 100, 1000]);\n733\t                        let mut wa = vec![0 as c_int; wsn];\n734\t                        let mut wb = vec![0 as c_int; wsn];\n735\t                        let mda = (p.c.match_data_create)(ovec, ptr::null_mut());\n736\t                        let mdb = (p.r.match_data_create)(ovec, ptr::null_mut());\n737\t                        let ra = (p.c.dfa_match)(\n738\t                            a, sb.as_ptr(), sb.len(), start, mo, mda, mca, wa.as_mut_ptr(), wsn,\n739\t                        );\n740\t                        let rb = (p.r.dfa_match)(\n741\t                            b, sb.as_ptr(), sb.len(), start, mo, mdb, mcb, wb.as_mut_ptr(), wsn,\n742\t                        );\n743\t                        let tag = format!(\n744\t                            \"dfa_match {} cfg[{}] subj={} start={} opts={} ovec={} ws={}\",\n745\t                            show(pb), cfg.name, show(sb), start, mn, ovec, wsn\n746\t                        );\n747\t                        d.eq(&tag, read_match_out_of(&p.c, mda, ra, Engine::Dfa), read_match_out_of(&p.r, mdb, rb, Engine::Dfa));\n748\t                        (p.c.match_data_free)(mda);\n749\t                        (p.r.match_data_free)(mdb);\n750\t                    }\n751\t                }\n752\t                (p.c.code_free)(a);\n753\t                (p.r.code_free)(b);\n754\t            }\n755\t        }\n756\t    }\n757\t    unsafe {\n758\t        (p.c.match_context_free)(mca);\n759\t        (p.r.match_context_free)(mcb);\n760\t    }\n761\t    d.finish(\"pcre2_dfa_match_8: match_cfgs x PATTERNS x SUBJECTS x dfa options x workspace sizes\");\n762\t}\n763\t\n764\t// CONFIGS row: pcre2_next_match_8 — iterating the alternative match ends that\n765\t// pcre2_dfa_match records in the ovector.\n766\t#[test]\n767\tfn next_match_identical() {\n768\t    let p = pair();\n769\t    let mut d = Diffs::new();\n770\t    let cfgs = match_cfgs();\n771\t    for cfg in cfgs.iter().take(20) {\n772\t        for pat in PATTERNS {\n773\t            let pb = pat.as_bytes();\n774\t            unsafe {\n775\t                let Some((a, b)) = compile_both(p, pb, pb.len(), cfg, &mut d) else {\n776\t                    continue;\n777\t                };\n778\t                for subj in SUBJECTS {\n779\t                    let sb = subj.as_bytes();\n780\t                    let mut ws_a = vec![0 as c_int; 1000];\n781\t                    let mut ws_b = vec![0 as c_int; 1000];\n782\t                    let mda = (p.c.match_data_create)(16, ptr::null_mut());\n783\t                    let mdb = (p.r.match_data_create)(16, ptr::null_mut());\n784\t                    let ra = (p.c.dfa_match)(\n785\t                        a, sb.as_ptr(), sb.len(), 0, 0, mda, ptr::null_mut(), ws_a.as_mut_ptr(), 1000,\n786\t                    );\n787\t                    let rb = (p.r.dfa_match)(\n788\t                        b, sb.as_ptr(), sb.len(), 0, 0, mdb, ptr::null_mut(), ws_b.as_mut_ptr(), 1000,\n789\t                    );\n790\t                    let tag = format!(\"next_match {} cfg[{}] subj={}\", show(pb), cfg.name, show(sb));\n791\t                    d.eq(&format!(\"{tag} dfa rc\"), ra, rb);\n792\t                    // walk the whole iterator to exhaustion in both\n793\t                    let mut steps_a = Vec::new();\n794\t                    let mut steps_b = Vec::new();\n795\t                    loop {\n796\t                        let (mut o, mut f) = (usize::MAX, 0u32);\n797\t                        let rc = (p.c.next_match)(mda, &mut o, &mut f);\n798\t                        steps_a.push((rc, o, f));\n799\t                        if rc <= 0 || steps_a.len() > 40 {\n800\t                            break;\n801\t                        }\n802\t                    }\n803\t                    loop {\n804\t                        let (mut o, mut f) = (usize::MAX, 0u32);\n805\t                        let rc = (p.r.next_match)(mdb, &mut o, &mut f);\n806\t                        steps_b.push((rc, o, f));\n807\t                        if rc <= 0 || steps_b.len() > 40 {\n808\t                            break;\n809\t                        }\n810\t                    }\n811\t                    d.eq(&format!(\"{tag} next_match sequence\"), steps_a, steps_b);\n812\t                    (p.c.match_data_free)(mda);\n813\t                    (p.r.match_data_free)(mdb);\n814\t                }\n815\t                (p.c.code_free)(a);\n816\t                (p.r.code_free)(b);\n817\t            }\n818\t        }\n819\t    }\n820\t    d.finish(\"pcre2_next_match_8: full iteration after pcre2_dfa_match over cfgs x patterns x subjects\");\n821\t}\n822\t\n823\t// =========================================================== callouts\n824\t\n825\tstatic mut CALLOUT_LOG: Vec<u8> = Vec::new();\n826\t\n827\t/// Records the fields of every callout block so the two libraries' callout\n828\t/// sequences can be compared exactly.  Layout mirrors `pcre2_callout_block`.\n829\t#[repr(C)]\n830\tstruct CalloutBlock {\n831\t    version: u32,\n832\t    callout_number: u32,\n833\t    capture_top: u32,\n834\t    capture_last: u32,\n835\t    offset_vector: *const Sz,\n836\t    mark: Sptr,\n837\t    subject: Sptr,\n838\t    subject_length: Sz,\n839\t    start_match: Sz,\n840\t    current_position: Sz,\n841\t    pattern_position: Sz,\n842\t    next_item_length: Sz,\n843\t    callout_string_offset: Sz,\n844\t    callout_string_length: Sz,\n845\t    callout_string: Sptr,\n846\t    callout_flags: u32,\n847\t}\n848\t\n849\t/// `pcre2_callout_enumerate_block` — a DIFFERENT layout from\n850\t/// `pcre2_callout_block`, so it needs its own recorder.\n851\t#[repr(C)]\n852\tstruct CalloutEnumBlock {\n853\t    version: u32,\n854\t    pattern_position: Sz,\n855\t    next_item_length: Sz,\n856\t    callout_number: u32,\n857\t    callout_string_offset: Sz,\n858\t    callout_string_length: Sz,\n859\t    callout_string: Sptr,\n860\t}\n861\t\n862\tunsafe extern \"C\" fn record_enum_callout(blk: *mut c_void, _data: *mut c_void) -> c_int {\n863\t    let b = &*(blk as *const CalloutEnumBlock);\n864\t    let log = &mut *ptr::addr_of_mut!(CALLOUT_LOG);\n865\t    for v in [\n866\t        b.version as u64,\n867\t        b.pattern_position as u64,\n868\t        b.next_item_length as u64,\n869\t        b.callout_number as u64,\n870\t        b.callout_string_offset as u64,\n871\t        b.callout_string_length as u64,\n872\t    ] {\n873\t        log.extend_from_slice(&v.to_le_bytes());\n874\t    }\n875\t    if !b.callout_string.is_null() {\n876\t        log.extend_from_slice(std::slice::from_raw_parts(\n877\t            b.callout_string,\n878\t            b.callout_string_length,\n879\t        ));\n880\t    }\n881\t    0\n882\t}\n883\t\n884\tunsafe extern \"C\" fn record_callout(blk: *mut c_void, _data: *mut c_void) -> c_int {\n885\t    let b = &*(blk as *const CalloutBlock);\n886\t    let log = &mut *ptr::addr_of_mut!(CALLOUT_LOG);\n887\t    for v in [\n888\t        b.version as u64,\n889\t        b.callout_number as u64,\n890\t        b.capture_top as u64,\n891\t        b.capture_last as u64,\n892\t        b.subject_length as u64,\n893\t        b.start_match as u64,\n894\t        b.current_position as u64,\n895\t        b.pattern_position as u64,\n896\t        b.next_item_length as u64,\n897\t        b.callout_string_offset as u64,\n898\t        b.callout_string_length as u64,\n899\t        b.callout_flags as u64,\n900\t        b.mark.is_null() as u64,\n901\t    ] {\n902\t        log.extend_from_slice(&v.to_le_bytes());\n903\t    }\n904\t    if !b.callout_string.is_null() {\n905\t        log.extend_from_slice(std::slice::from_raw_parts(\n906\t            b.callout_string,\n907\t            b.callout_string_length,\n908\t        ));\n909\t    }\n910\t    0\n911\t}\n912\t\n913\t// CONFIGS rows: match-time callouts, with AUTO_CALLOUT and with explicit\n914\t// (?C) / (?C1) / (?C{str}) callouts — the whole callout sequence must match.\n915\t#[test]\n916\tfn callouts_identical() {\n917\t    let p = pair();\n918\t    let mut d = Diffs::new();\n919\t    let cal_pats: &[&str] = &[\n920\t        \"a(?C)b\",\n921\t        \"a(?C1)b\",\n922\t        \"a(?C255)b\",\n923\t        \"a(?C{txt})b\",\n924\t        \"(?C0)a(?C1)b(?C2)c\",\n925\t        \"(a)(?C)(b)\",\n926\t        \"\\\\d+(?C9)\\\\w*\",\n927\t        \"(?:a(?C)|b(?C))+\",\n928\t        \"^(?C)a*(?C)$\",\n929\t    ];\n930\t    for cfg in [\n931\t        Cfg::new(\"default\", 0, 0),\n932\t        Cfg::new(\"AUTO_CALLOUT\", PCRE2_AUTO_CALLOUT, 0),\n933\t        Cfg::new(\"UTF|AUTO_CALLOUT\", PCRE2_UTF | PCRE2_AUTO_CALLOUT, 0),\n934\t        Cfg::new(\"UTF|UCP\", PCRE2_UTF | PCRE2_UCP, 0),\n935\t    ] {\n936\t        // AUTO_CALLOUT applies to every pattern, so use the full corpus there\n937\t        let pats: Vec<&str> = if cfg.opts & PCRE2_AUTO_CALLOUT != 0 {\n938\t            PATTERNS.iter().copied().collect()\n939\t        } else {\n940\t            cal_pats.iter().copied().collect()\n941\t        };\n942\t        for pat in pats {\n943\t            let pb = pat.as_bytes();\n944\t            unsafe {\n945\t                let Some((a, b)) = compile_both(p, pb, pb.len(), &cfg, &mut d) else {\n946\t                    continue;\n947\t                };\n948\t                // pcre2_callout_enumerate walks the compiled pattern\n949\t                {\n950\t                    CALLOUT_LOG.clear();\n951\t                    let ea = (p.c.callout_enumerate)(a, Some(record_enum_callout), ptr::null_mut());\n952\t                    let la = CALLOUT_LOG.clone();\n953\t                    CALLOUT_LOG.clear();\n954\t                    let eb = (p.r.callout_enumerate)(b, Some(record_enum_callout), ptr::null_mut());\n955\t                    let lb = CALLOUT_LOG.clone();\n956\t                    d.eq(&format!(\"callout_enumerate rc {}\", show(pb)), ea, eb);\n957\t                    d.eq(&format!(\"callout_enumerate log {}\", show(pb)), la, lb);\n958\t                }\n959\t                let mca = (p.c.match_context_create)(ptr::null_mut());\n960\t                let mcb = (p.r.match_context_create)(ptr::null_mut());\n961\t                assert_eq!((p.c.set_callout)(mca, Some(record_callout), ptr::null_mut()), 0);\n962\t                assert_eq!((p.r.set_callout)(mcb, Some(record_callout), ptr::null_mut()), 0);\n963\t                for subj in SUBJECTS {\n964\t                    let sb = subj.as_bytes();\n965\t                    for &(mo, mn) in &[(0u32, \"none\"), (PCRE2_NO_START_OPTIMIZE, \"NO_START_OPT\")] {\n966\t                        let mda = (p.c.match_data_create)(16, ptr::null_mut());\n967\t                        let mdb = (p.r.match_data_create)(16, ptr::null_mut());\n968\t                        CALLOUT_LOG.clear();\n969\t                        let ra = (p.c.do_match)(a, sb.as_ptr(), sb.len(), 0, mo, mda, mca);\n970\t                        let la = CALLOUT_LOG.clone();\n971\t                        CALLOUT_LOG.clear();\n972\t                        let rb = (p.r.do_match)(b, sb.as_ptr(), sb.len(), 0, mo, mdb, mcb);\n973\t                        let lb = CALLOUT_LOG.clone();\n974\t                        let tag =\n975\t                            format!(\"callout match {} cfg[{}] subj={} {}\", show(pb), cfg.name, show(sb), mn);\n976\t                        d.eq(&tag, read_match_out_of(&p.c, mda, ra, Engine::Dfa), read_match_out_of(&p.r, mdb, rb, Engine::Dfa));\n977\t                        d.eq(&format!(\"{tag} :: callout log\"), la, lb);\n978\t                        (p.c.match_data_free)(mda);\n979\t                        (p.r.match_data_free)(mdb);\n980\t                    }\n981\t                }\n982\t                (p.c.match_context_free)(mca);\n983\t                (p.r.match_context_free)(mcb);\n984\t                (p.c.code_free)(a);\n985\t                (p.r.code_free)(b);\n986\t            }\n987\t        }\n988\t    }\n989\t    d.finish(\"callouts: explicit (?C..) and AUTO_CALLOUT, pcre2_callout_enumerate_8 + match-time sequence\");\n990\t}\n991\t\n992\t// ================================================== bytecode-level internals\n993\t\n994\t/// Finds the unique occurrence of `op` in a compiled pattern's bytecode.\n995\t/// Returns the byte offset from the bytecode start, or None if not unique.\n996\tunsafe fn unique_op(code: Ptr, op: u8) -> Option<usize> {\n997\t    let start = bytecode_ptr(code);\n998\t    let n = code_blocksize(code) - (start as usize - code as usize);\n999\t    let by = std::slice::from_raw_parts(start, n);\n1000\t    let mut found = None;\n1001\t    for i in 0..n.saturating_sub(3) {\n1002\t        if by[i] != op {\n1003\t            continue;\n1004\t        }\n1005\t        let link = ((by[i + 1] as usize) << 8) | by[i + 2] as usize; // LINK_SIZE == 2\n1006\t        if link >= 4 && i + link <= n {\n1007\t            if found.is_some() {\n1008\t                return None; // ambiguous\n1009\t            }\n1010\t            found = Some(i);\n1011\t        }\n1012\t    }\n1013\t    found\n1014\t}\n1015\t\n1016\tconst OP_XCLASS: u8 = 112;\n1017\tconst OP_ECLASS: u8 = 113;\n1018\t\n1019\t// CONFIGS row: _pcre2_xclass_8 and _pcre2_eclass_8 driven over every code point\n1020\t// class boundary, using real XCLASS/ECLASS bytecode produced by the compiler.\n1021\t#[test]\n1022\tfn xclass_and_eclass_identical() {\n1023\t    let p = pair();\n1024\t    let mut d = Diffs::new();\n1025\t    // patterns that produce exactly one wide/extended class\n1026\t    let xpats: &[(&str, u32, u32)] = &[\n1027\t        (\"[\\\\x{100}-\\\\x{200}]\", PCRE2_UTF, 0),\n1028\t        (\"[^\\\\x{100}-\\\\x{200}]\", PCRE2_UTF, 0),\n1029\t        (\"[\\\\x{100}\\\\x{300}\\\\x{500}]\", PCRE2_UTF, 0),\n1030\t        (\"[a-c\\\\x{100}-\\\\x{200}]\", PCRE2_UTF, 0),\n1031\t        (\"[\\\\p{L}]\", PCRE2_UTF | PCRE2_UCP, 0),\n1032\t        (\"[\\\\P{L}]\", PCRE2_UTF | PCRE2_UCP, 0),\n1033\t        (\"[\\\\p{Greek}\\\\p{Nd}]\", PCRE2_UTF | PCRE2_UCP, 0),\n1034\t        (\"[\\\\p{Lu}a-f]\", PCRE2_UTF | PCRE2_UCP, 0),\n1035\t        (\"[\\\\x{100}-\\\\x{10ffff}]\", PCRE2_UTF, 0),\n1036\t        (\"[[:alpha:]\\\\x{100}]\", PCRE2_UTF, 0),\n1037\t        (\"(?[\\\\p{L} & \\\\p{Greek}])\", PCRE2_UTF | PCRE2_UCP | PCRE2_ALT_EXTENDED_CLASS, 0),\n1038\t        (\"(?[\\\\p{L} -- [a-z]])\", PCRE2_UTF | PCRE2_UCP | PCRE2_ALT_EXTENDED_CLASS, 0),\n1039\t        (\"(?[[a-z] | \\\\p{Nd}])\", PCRE2_UTF | PCRE2_UCP | PCRE2_ALT_EXTENDED_CLASS, 0),\n1040\t        (\"(?[\\\\p{L} ^ \\\\p{Lu}])\", PCRE2_UTF | PCRE2_UCP | PCRE2_ALT_EXTENDED_CLASS, 0),\n1041\t        (\"[\\\\p{Xan}\\\\x{2000}-\\\\x{2fff}]\", PCRE2_UTF | PCRE2_UCP, 0),\n1042\t    ];\n1043\t    // code points at and around every interesting boundary, plus a sweep\n1044\t    let mut cps: Vec<u32> = vec![\n1045\t        0, 1, 0x40, 0x41, 0x5a, 0x61, 0x7a, 0x7f, 0x80, 0xff, 0x100, 0x101, 0x1ff, 0x200, 0x201,\n1046\t        0x2ff, 0x300, 0x37f, 0x386, 0x3b1, 0x400, 0x2000, 0x2028, 0x2fff, 0xffff, 0x10000,\n1047\t        0x10ffff,\n1048\t    ];\n1049\t    for i in 0..2000u32 {\n1050\t        cps.push(i * 137 % 0x11_0000);\n1051\t    }\n1052\t    for &(pat, opts, xopts) in xpats {\n1053\t        let mut cfg = Cfg::new(\"xclass\", opts, xopts);\n1054\t        cfg.name = \"xclass probe\";\n1055\t        let pb = pat.as_bytes();\n1056\t        unsafe {\n1057\t            let Some((a, b)) = compile_both(p, pb, pb.len(), &cfg, &mut d) else {\n1058\t                continue;\n1059\t            };\n1060\t            let sa = bytecode_ptr(a);\n1061\t            let sb = bytecode_ptr(b);\n1062\t            for (op, is_e) in [(OP_XCLASS, false), (OP_ECLASS, true)] {\n1063\t                let Some(off) = unique_op(a, op) else { continue };\n1064\t                assert_eq!(Some(off), unique_op(b, op), \"opcode offset differs for {pat}\");\n1065\t                for utf in [0 as Bool, 1] {\n1066\t                    for &c in &cps {\n1067\t                        let da = sa.add(off + 3); // skip opcode + LINK_SIZE\n1068\t                        let db = sb.add(off + 3);\n1069\t                        if is_e {\n1070\t                            let link = {\n1071\t                                let by = std::slice::from_raw_parts(sa.add(off), 3);\n1072\t                                ((by[1] as usize) << 8) | by[2] as usize\n1073\t                            };\n1074\t                            d.eq(\n1075\t                                &format!(\"eclass({c:#x}, {pat}, utf={utf})\"),\n1076\t                                (p.c.p_eclass)(c, da, sa.add(off + link), sa, utf),\n1077\t                                (p.r.p_eclass)(c, db, sb.add(off + link), sb, utf),\n1078\t                            );\n1079\t                        } else {\n1080\t                            d.eq(\n1081\t                                &format!(\"xclass({c:#x}, {pat}, utf={utf})\"),\n1082\t                                (p.c.p_xclass)(c, da, sa, utf),\n1083\t                                (p.r.p_xclass)(c, db, sb, utf),\n1084\t                            );\n1085\t                        }\n1086\t                    }\n1087\t                }\n1088\t            }\n1089\t            (p.c.code_free)(a);\n1090\t            (p.r.code_free)(b);\n1091\t        }\n1092\t    }\n1093\t    d.finish(\"_pcre2_xclass_8 / _pcre2_eclass_8: real XCLASS/ECLASS bytecode x ~2000 code points x utf\");\n1094\t}\n1095\t\n1096\t// CONFIGS row: _pcre2_find_bracket_8 over real bytecode, for every group\n1097\t// number present plus out-of-range and negative numbers.\n1098\t#[test]\n1099\tfn find_bracket_identical() {\n1100\t    let p = pair();\n1101\t    let mut d = Diffs::new();\n1102\t    for cfg in [\n1103\t        Cfg::new(\"default\", 0, 0),\n1104\t        Cfg::new(\"UTF\", PCRE2_UTF, 0),\n1105\t        Cfg::new(\"DUPNAMES\", PCRE2_DUPNAMES, 0),\n1106\t        Cfg::new(\"NO_AUTO_CAPTURE\", PCRE2_NO_AUTO_CAPTURE, 0),\n1107\t    ] {\n1108\t        for pat in PATTERNS {\n1109\t            let pb = pat.as_bytes();\n1110\t            unsafe {\n1111\t                let Some((a, b)) = compile_both(p, pb, pb.len(), &cfg, &mut d) else {\n1112\t                    continue;\n1113\t                };\n1114\t                let (sa, sb) = (bytecode_ptr(a), bytecode_ptr(b));\n1115\t                let mut top = 0u32;\n1116\t                (p.c.pattern_info)(a, PCRE2_INFO_CAPTURECOUNT, &mut top as *mut u32 as Ptr);\n1117\t                for utf in [0 as Bool, 1] {\n1118\t                    for num in -3i32..=(top as i32 + 3) {\n1119\t                        let ra = (p.c.p_find_bracket)(sa, utf, num);\n1120\t                        let rb = (p.r.p_find_bracket)(sb, utf, num);\n1121\t                        d.eq(\n1122\t                            &format!(\"find_bracket({} cfg[{}] n={num} utf={utf})\", show(pb), cfg.name),\n1123\t                            if ra.is_null() { None } else { Some(ra as usize - sa as usize) },\n1124\t                            if rb.is_null() { None } else { Some(rb as usize - sb as usize) },\n1125\t                        );\n1126\t                    }\n1127\t                }\n1128\t                (p.c.code_free)(a);\n1129\t                (p.r.code_free)(b);\n1130\t            }\n1131\t        }\n1132\t    }\n1133\t    d.finish(\"_pcre2_find_bracket_8: real bytecode x group numbers -3..top+3 x utf on/off\");\n1134\t}\n1135\t"}]},"parent_tool_use_id":"toolu_bdrk_01TxnLYF4CJ5TTdH8Vu1QwS3","session_id":"cde48455-d5ce-4cd5-a0b0-2154082e5ad7","uuid":"7160fdf5-6a07-4797-9870-af0b9ce7b747","timestamp":"2026-08-23T10:49:06.482Z","subagent_type":"general-purpose","task_description":"CONFIGS rows 1-153 compile sign-off"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01CJbUbQnU5MZ1DWKrLzebGc","type":"tool_result","content":"1\t// Phase B sign-off for CONFIGS.md rows 445-456:\n2\t//   * the exported read-only data tables, cross-checked against the BEHAVIOUR\n3\t//     they drive (not just dumped), and\n4\t//   * the no-JIT stub arms, including the option-validation side effect that\n5\t//     `pcre2_jit_compile_8` leaves behind on `re->overall_options`.\n6\t\n7\tmod common;\n8\tuse common::*;\n9\tuse std::ffi::{c_int, CStr};\n10\tuse std::ptr;\n11\t\n12\tpub const COVERAGE: &[CfgCov] = &[\n13\t    CfgCov { cfg_rows: &[445], note: \"_pcre2_OP_lengths_8 dump + opcode-walk consistency\" },\n14\t    CfgCov { cfg_rows: &[446], note: \"_pcre2_default_tables_8 dump + per-region behaviour cross-check\" },\n15\t    CfgCov { cfg_rows: &[447], note: \"hspace/vspace lists + \\\\h/\\\\v matching, UTF and non-UTF\" },\n16\t    CfgCov { cfg_rows: &[448], note: \"utf8_table1..4 + size, cross-checked against ord2utf/valid_utf\" },\n17\t    CfgCov { cfg_rows: &[449], note: \"utt / utt_names / utt_size + every entry resolvable via \\\\p{name}\" },\n18\t    CfgCov { cfg_rows: &[450], note: \"ucp_gentype, ucp_gbtable, posix_class_maps, callout delimiters\" },\n19\t    CfgCov { cfg_rows: &[451], note: \"all _pcre2_ucd_* tables, full dumps\" },\n20\t    CfgCov { cfg_rows: &[452], note: \"jit_compile PCRE2_JIT_TEST_ALLOC alone vs combined\" },\n21\t    CfgCov { cfg_rows: &[453], note: \"jit_compile NULL code, out-of-range bits, valid mode bits\" },\n22\t    CfgCov { cfg_rows: &[454], note: \"jit_compile PCRE2_JIT_INVALID_UTF side effect on overall_options\" },\n23\t    CfgCov { cfg_rows: &[455], note: \"jit_stack_create/assign/free, jit_free_unused_memory\" },\n24\t    CfgCov { cfg_rows: &[456], note: \"_pcre2_jit_get_target/get_size/free/free_rodata\" },\n25\t];\n26\t\n27\t#[test]\n28\tfn coverage_declaration_is_sane() {\n29\t    check_coverage_decl(COVERAGE);\n30\t}\n31\t\n32\t// --------------------------------------------------------------- helpers\n33\t\n34\tunsafe fn compile(api: &Api, pat: &[u8], opts: u32) -> Ptr {\n35\t    let (mut ec, mut eo) = (0 as c_int, 0usize);\n36\t    (api.compile)(pat.as_ptr(), pat.len(), opts, &mut ec, &mut eo, ptr::null_mut())\n37\t}\n38\t\n39\t/// Does `pat` match `subj` (rc >= 0)?  Compared between the two libraries.\n40\tunsafe fn both_match(p: &Pair, pat: &[u8], opts: u32, subj: &[u8], d: &mut Diffs, tag: &str) {\n41\t    let a = compile(&p.c, pat, opts);\n42\t    let b = compile(&p.r, pat, opts);\n43\t    d.eq(&format!(\"{tag} compile null?\"), a.is_null(), b.is_null());\n44\t    if a.is_null() || b.is_null() {\n45\t        if !a.is_null() {\n46\t            (p.c.code_free)(a);\n47\t        }\n48\t        if !b.is_null() {\n49\t            (p.r.code_free)(b);\n50\t        }\n51\t        return;\n52\t    }\n53\t    assert_code_eq(a, b, tag);\n54\t    let mda = (p.c.match_data_create)(4, ptr::null_mut());\n55\t    let mdb = (p.r.match_data_create)(4, ptr::null_mut());\n56\t    let ra = (p.c.do_match)(a, subj.as_ptr(), subj.len(), 0, 0, mda, ptr::null_mut());\n57\t    let rb = (p.r.do_match)(b, subj.as_ptr(), subj.len(), 0, 0, mdb, ptr::null_mut());\n58\t    d.eq(tag, read_match_out(&p.c, mda, ra), read_match_out(&p.r, mdb, rb));\n59\t    (p.c.match_data_free)(mda);\n60\t    (p.r.match_data_free)(mdb);\n61\t    (p.c.code_free)(a);\n62\t    (p.r.code_free)(b);\n63\t}\n64\t\n65\tfn utf8_of(cp: u32) -> Vec<u8> {\n66\t    let mut b = [0u8; 4];\n67\t    char::from_u32(cp).unwrap().encode_utf8(&mut b).as_bytes().to_vec()\n68\t}\n69\t\n70\t// ============================================ row 445: OP_lengths\n71\t\n72\t#[test]\n73\tfn cfg_445_op_lengths() {\n74\t    let p = pair();\n75\t    let mut d = Diffs::new();\n76\t    unsafe {\n77\t        let (a, b) = (p.c.data(\"_pcre2_OP_lengths_8\"), p.r.data(\"_pcre2_OP_lengths_8\"));\n78\t        let (sa, sb) = (\n79\t            std::slice::from_raw_parts(a, 173),\n80\t            std::slice::from_raw_parts(b, 173),\n81\t        );\n82\t        d.eq(\"_pcre2_OP_lengths_8 full dump\", sa.to_vec(), sb.to_vec());\n83\t        // Walk the fixed-length opcode prefix of every corpus pattern using each\n84\t        // library's own table; the walks must agree step for step.\n85\t        for pat in PATTERNS {\n86\t            let pb = pat.as_bytes();\n87\t            let ka = compile(&p.c, pb, 0);\n88\t            let kb = compile(&p.r, pb, 0);\n89\t            if ka.is_null() || kb.is_null() {\n90\t                if !ka.is_null() {\n91\t                    (p.c.code_free)(ka);\n92\t                }\n93\t                if !kb.is_null() {\n94\t                    (p.r.code_free)(kb);\n95\t                }\n96\t                continue;\n97\t            }\n98\t            let walk = |code: Ptr, tbl: &[u8]| -> Vec<(usize, u8)> {\n99\t                let start = bytecode_ptr(code);\n100\t                let n = code_blocksize(code) - (start as usize - code as usize);\n101\t                let by = std::slice::from_raw_parts(start, n);\n102\t                let mut steps = Vec::new();\n103\t                let mut i = 0usize;\n104\t                while i < n && steps.len() < 4096 {\n105\t                    let op = by[i];\n106\t                    steps.push((i, op));\n107\t                    let l = tbl[op as usize] as usize;\n108\t                    if l == 0 {\n109\t                        break; // variable-length opcode: stop, both must stop here\n110\t                    }\n111\t                    i += l;\n112\t                }\n113\t                steps\n114\t            };\n115\t            d.eq(\n116\t                &format!(\"OP_lengths walk of {}\", show(pb)),\n117\t                walk(ka, sa),\n118\t                walk(kb, sb),\n119\t            );\n120\t            (p.c.code_free)(ka);\n121\t            (p.r.code_free)(kb);\n122\t        }\n123\t    }\n124\t    d.finish(\"CONFIGS 445: _pcre2_OP_lengths_8 dump + opcode-walk consistency over all corpus patterns\");\n125\t}\n126\t\n127\t// ============================ row 446: default tables vs behaviour\n128\t\n129\t#[test]\n130\tfn cfg_446_default_tables() {\n131\t    let p = pair();\n132\t    let mut d = Diffs::new();\n133\t    unsafe {\n134\t        let mut len = 0u32;\n135\t        (p.c.config)(PCRE2_CONFIG_TABLES_LENGTH, &mut len as *mut u32 as Ptr);\n136\t        let n = len as usize;\n137\t        let (a, b) = (p.c.data(\"_pcre2_default_tables_8\"), p.r.data(\"_pcre2_default_tables_8\"));\n138\t        d.eq(\n139\t            \"_pcre2_default_tables_8 full dump\",\n140\t            std::slice::from_raw_parts(a, n).to_vec(),\n141\t            std::slice::from_raw_parts(b, n).to_vec(),\n142\t        );\n143\t        // Cross-check every table region through the behaviour it drives, for\n144\t        // all 256 single-byte subjects.\n145\t        let probes: &[(&str, u32)] = &[\n146\t            (\"\\\\d\", 0),\n147\t            (\"\\\\D\", 0),\n148\t            (\"\\\\w\", 0),\n149\t            (\"\\\\W\", 0),\n150\t            (\"\\\\s\", 0),\n151\t            (\"\\\\S\", 0),\n152\t            (\"[[:alpha:]]\", 0),\n153\t            (\"[[:alnum:]]\", 0),\n154\t            (\"[[:lower:]]\", 0),\n155\t            (\"[[:upper:]]\", 0),\n156\t            (\"[[:digit:]]\", 0),\n157\t            (\"[[:xdigit:]]\", 0),\n158\t            (\"[[:space:]]\", 0),\n159\t            (\"[[:graph:]]\", 0),\n160\t            (\"[[:print:]]\", 0),\n161\t            (\"[[:punct:]]\", 0),\n162\t            (\"[[:cntrl:]]\", 0),\n163\t            (\"[[:word:]]\", 0),\n164\t            (\"[[:ascii:]]\", 0),\n165\t            (\"[[:blank:]]\", 0),\n166\t            // the lowercase / case-flip tables\n167\t            (\"a\", PCRE2_CASELESS),\n168\t            (\"Z\", PCRE2_CASELESS),\n169\t            (\"[a-f]\", PCRE2_CASELESS),\n170\t            (\"(?i)[X-Z]\", 0),\n171\t        ];\n172\t        for &(pat, opts) in probes {\n173\t            for byte in 0u8..=255 {\n174\t                let subj = [byte];\n175\t                both_match(\n176\t                    p,\n177\t                    pat.as_bytes(),\n178\t                    opts,\n179\t                    &subj,\n180\t                    &mut d,\n181\t                    &format!(\"tables probe {pat} vs {byte:#04x}\"),\n182\t                );\n183\t            }\n184\t        }\n185\t    }\n186\t    d.finish(\"CONFIGS 446: _pcre2_default_tables_8 dump + all class/case regions over all 256 bytes\");\n187\t}\n188\t\n189\t// ==================== row 447: hspace / vspace lists vs \\h and \\v\n190\t\n191\t#[test]\n192\tfn cfg_447_hspace_vspace() {\n193\t    let p = pair();\n194\t    let mut d = Diffs::new();\n195\t    unsafe {\n196\t        for (sym, len) in [(\"_pcre2_hspace_list_8\", 80usize), (\"_pcre2_vspace_list_8\", 32)] {\n197\t            d.eq(\n198\t                &format!(\"{sym} full dump\"),\n199\t                std::slice::from_raw_parts(p.c.data(sym), len).to_vec(),\n200\t                std::slice::from_raw_parts(p.r.data(sym), len).to_vec(),\n201\t            );\n202\t        }\n203\t        // Read the code points out of the C table and drive \\h / \\v with each,\n204\t        // in UTF and non-UTF mode, plus the ones just outside each list.\n205\t        let read_list = |sym: &str, len: usize| -> Vec<u32> {\n206\t            let base = p.c.data(sym) as *const u32;\n207\t            (0..len / 4).map(|i| *base.add(i)).collect()\n208\t        };\n209\t        let hs = read_list(\"_pcre2_hspace_list_8\", 80);\n210\t        let vs = read_list(\"_pcre2_vspace_list_8\", 32);\n211\t        println!(\"hspace list = {hs:#x?}\\nvspace list = {vs:#x?}\");\n212\t        let mut cps: Vec<u32> = Vec::new();\n213\t        for v in hs.iter().chain(vs.iter()) {\n214\t            if *v == u32::MAX || *v > 0x10_FFFF {\n215\t                continue;\n216\t            }\n217\t            cps.push(*v);\n218\t            if *v > 0 {\n219\t                cps.push(*v - 1);\n220\t            }\n221\t            cps.push(*v + 1);\n222\t        }\n223\t        cps.extend([0, 0x20, 0x41, 0x7f, 0x80, 0xa0, 0xff, 0x100, 0x2000, 0x3000]);\n224\t        cps.sort_unstable();\n225\t        cps.dedup();\n226\t        for &cp in &cps {\n227\t            if cp > 0x10_FFFF || (0xd800..=0xdfff).contains(&cp) {\n228\t                continue;\n229\t            }\n230\t            let utf = utf8_of(cp);\n231\t            for pat in [\"\\\\h\", \"\\\\H\", \"\\\\v\", \"\\\\V\", \"[\\\\h]\", \"[\\\\v]\", \"[^\\\\h\\\\v]\", \"\\\\R\"] {\n232\t                // UTF mode: full code point\n233\t                both_match(\n234\t                    p,\n235\t                    pat.as_bytes(),\n236\t                    PCRE2_UTF,\n237\t                    &utf,\n238\t                    &mut d,\n239\t                    &format!(\"{pat} UTF U+{cp:04X}\"),\n240\t                );\n241\t                // non-UTF: single byte only\n242\t                if cp < 0x100 {\n243\t                    both_match(\n244\t                        p,\n245\t                        pat.as_bytes(),\n246\t                        0,\n247\t                        &[cp as u8],\n248\t                        &mut d,\n249\t                        &format!(\"{pat} 8-bit {cp:#04x}\"),\n250\t                    );\n251\t                }\n252\t            }\n253\t        }\n254\t    }\n255\t    d.finish(\"CONFIGS 447: hspace/vspace dumps cross-checked against \\\\h \\\\H \\\\v \\\\V \\\\R in UTF and 8-bit\");\n256\t}\n257\t\n258\t// =============== row 448: utf8_table1..4 vs ord2utf / valid_utf\n259\t\n260\t#[test]\n261\tfn cfg_448_utf8_tables() {\n262\t    let p = pair();\n263\t    let mut d = Diffs::new();\n264\t    unsafe {\n265\t        for (sym, len) in [\n266\t            (\"_pcre2_utf8_table1\", 24usize),\n267\t            (\"_pcre2_utf8_table1_size\", 4),\n268\t            (\"_pcre2_utf8_table2\", 24),\n269\t            (\"_pcre2_utf8_table3\", 24),\n270\t            (\"_pcre2_utf8_table4\", 64),\n271\t        ] {\n272\t            d.eq(\n273\t                &format!(\"{sym} full dump\"),\n274\t                std::slice::from_raw_parts(p.c.data(sym), len).to_vec(),\n275\t                std::slice::from_raw_parts(p.r.data(sym), len).to_vec(),\n276\t            );\n277\t        }\n278\t        let size = *(p.c.data(\"_pcre2_utf8_table1_size\") as *const u32);\n279\t        assert_eq!(size, 6, \"utf8_table1_size must be 6\");\n280\t        let t1 = p.c.data(\"_pcre2_utf8_table1\") as *const i32;\n281\t        let bands: Vec<i32> = (0..6).map(|i| *t1.add(i)).collect();\n282\t        println!(\"utf8_table1 bands = {bands:#x?}\");\n283\t        // Cross-check ord2utf band selection at each band edge and just past it.\n284\t        let mut probes: Vec<u32> = vec![0];\n285\t        for &b in &bands {\n286\t            let b = b as u32;\n287\t            probes.extend([b.wrapping_sub(1), b, b.wrapping_add(1)]);\n288\t        }\n289\t        probes.extend([0x10_FFFF, 0x11_0000, 0x7FFF_FFFF, 0x8000_0000, u32::MAX]);\n290\t        for &cp in &probes {\n291\t            let mut ba = [0xEEu8; 16];\n292\t            let mut bb = [0xEEu8; 16];\n293\t            let na = (p.c.p_ord2utf)(cp, ba.as_mut_ptr());\n294\t            let nb = (p.r.p_ord2utf)(cp, bb.as_mut_ptr());\n295\t            d.eq(&format!(\"ord2utf band U+{cp:X} len\"), na, nb);\n296\t            d.eq(&format!(\"ord2utf band U+{cp:X} bytes\"), ba, bb);\n297\t            // and feed the encoding straight back into the validator\n298\t            let enc = ba[..na as usize].to_vec();\n299\t            let (mut oa, mut ob) = (usize::MAX, usize::MAX);\n300\t            d.eq(\n301\t                &format!(\"valid_utf(ord2utf(U+{cp:X})) rc\"),\n302\t                (p.c.p_valid_utf)(enc.as_ptr(), enc.len(), &mut oa),\n303\t                (p.r.p_valid_utf)(enc.as_ptr(), enc.len(), &mut ob),\n304\t            );\n305\t            d.eq(&format!(\"valid_utf(ord2utf(U+{cp:X})) off\"), oa, ob);\n306\t        }\n307\t        // utf8_table4 gives the number of additional bytes per lead byte: check\n308\t        // the validator's behaviour for every possible lead byte, truncated.\n309\t        for lead in 0xC0u8..=0xFF {\n310\t            for extra in 0usize..=5 {\n311\t                let mut s = vec![lead];\n312\t                s.extend(std::iter::repeat(0x80u8).take(extra));\n313\t                let (mut oa, mut ob) = (usize::MAX, usize::MAX);\n314\t                d.eq(\n315\t                    &format!(\"valid_utf lead {lead:#04x} +{extra} rc\"),\n316\t                    (p.c.p_valid_utf)(s.as_ptr(), s.len(), &mut oa),\n317\t                    (p.r.p_valid_utf)(s.as_ptr(), s.len(), &mut ob),\n318\t                );\n319\t                d.eq(&format!(\"valid_utf lead {lead:#04x} +{extra} off\"), oa, ob);\n320\t            }\n321\t        }\n322\t    }\n323\t    d.finish(\"CONFIGS 448: utf8_table1..4 dumps + ord2utf band edges + valid_utf over every lead byte\");\n324\t}\n325\t\n326\t// ================= row 449: utt / utt_names vs \\p{name} compiles\n327\t\n328\t#[test]\n329\tfn cfg_449_utt_tables() {\n330\t    let p = pair();\n331\t    let mut d = Diffs::new();\n332\t    unsafe {\n333\t        for (sym, len) in [\n334\t            (\"_pcre2_utt_8\", 3108usize),\n335\t            (\"_pcre2_utt_names_8\", 3834),\n336\t            (\"_pcre2_utt_size_8\", 8),\n337\t        ] {\n338\t            d.eq(\n339\t                &format!(\"{sym} full dump\"),\n340\t                std::slice::from_raw_parts(p.c.data(sym), len).to_vec(),\n341\t                std::slice::from_raw_parts(p.r.data(sym), len).to_vec(),\n342\t            );\n343\t        }\n344\t        let utt_size = *(p.c.data(\"_pcre2_utt_size_8\") as *const usize);\n345\t        println!(\"utt_size = {utt_size}\");\n346\t        assert_eq!(utt_size * 6, 3108, \"utt entry size should be 6 bytes\");\n347\t        // Every property name in the table must compile identically via \\p{...}\n348\t        // and \\P{...}, and must then match/not-match identically.\n349\t        let utt = p.c.data(\"_pcre2_utt_8\") as *const u16;\n350\t        let names = p.c.data(\"_pcre2_utt_names_8\") as *const u8;\n351\t        let mut tested = 0;\n352\t        for i in 0..utt_size {\n353\t            let name_off = *utt.add(i * 3) as usize;\n354\t            let nm = CStr::from_ptr(names.add(name_off) as *const i8)\n355\t                .to_str()\n356\t                .expect(\"property name is ASCII\");\n357\t            for form in [\n358\t                format!(\"\\\\p{{{nm}}}\"),\n359\t                format!(\"\\\\P{{{nm}}}\"),\n360\t                format!(\"[\\\\p{{{nm}}}]\"),\n361\t            ] {\n362\t                let pb = form.as_bytes();\n363\t                for opts in [PCRE2_UTF | PCRE2_UCP, PCRE2_UCP] {\n364\t                    let a = compile(&p.c, pb, opts);\n365\t                    let b = compile(&p.r, pb, opts);\n366\t                    d.eq(&format!(\"compile {form} null?\"), a.is_null(), b.is_null());\n367\t                    if !a.is_null() && !b.is_null() {\n368\t                        assert_code_eq(a, b, &format!(\"utt {form}\"));\n369\t                        tested += 1;\n370\t                    }\n371\t                    if !a.is_null() {\n372\t                        (p.c.code_free)(a);\n373\t                    }\n374\t                    if !b.is_null() {\n375\t                        (p.r.code_free)(b);\n376\t                    }\n377\t                }\n378\t            }\n379\t        }\n380\t        println!(\"compiled {tested} \\\\p/\\\\P forms from the utt table\");\n381\t        assert!(tested > 1000, \"expected to exercise most of the utt table\");\n382\t        // loose matching and the sc:/scx:/bc: prefixes\n383\t        for form in [\n384\t            \"\\\\p{Latin}\", \"\\\\p{latin}\", \"\\\\p{LATIN}\", \"\\\\p{ Latin }\", \"\\\\p{L_a-t_i n}\",\n385\t            \"\\\\p{sc:Latin}\", \"\\\\p{scx:Latin}\", \"\\\\p{bc:L}\", \"\\\\p{Script=Latin}\",\n386\t            \"\\\\p{Script_Extensions=Latin}\", \"\\\\p{General_Category=Lu}\", \"\\\\p{gc=Lu}\",\n387\t            \"\\\\p{Bidi_Class=AL}\", \"\\\\p{Is_Latin}\", \"\\\\p{IsLatin}\", \"\\\\p{nonesuch}\",\n388\t            \"\\\\p{sc:nonesuch}\", \"\\\\p{=}\", \"\\\\p{:}\", \"\\\\p{}\",\n389\t        ] {\n390\t            let pb = form.as_bytes();\n391\t            let (mut e1, mut e2) = (0 as c_int, 0 as c_int);\n392\t            let (mut f1, mut f2) = (0usize, 0usize);\n393\t            let a = (p.c.compile)(pb.as_ptr(), pb.len(), PCRE2_UTF | PCRE2_UCP, &mut e1, &mut f1, ptr::null_mut());\n394\t            let b = (p.r.compile)(pb.as_ptr(), pb.len(), PCRE2_UTF | PCRE2_UCP, &mut e2, &mut f2, ptr::null_mut());\n395\t            d.eq(&format!(\"loose-name {form} null?\"), a.is_null(), b.is_null());\n396\t            d.eq(&format!(\"loose-name {form} ec\"), e1, e2);\n397\t            d.eq(&format!(\"loose-name {form} eo\"), f1, f2);\n398\t            if !a.is_null() && !b.is_null() {\n399\t                assert_code_eq(a, b, &format!(\"loose {form}\"));\n400\t            }\n401\t            if !a.is_null() {\n402\t                (p.c.code_free)(a);\n403\t            }\n404\t            if !b.is_null() {\n405\t                (p.r.code_free)(b);\n406\t            }\n407\t        }\n408\t    }\n409\t    d.finish(\"CONFIGS 449: utt/utt_names/utt_size dumps + every entry compiled via \\\\p{}/\\\\P{} + loose matching\");\n410\t}\n411\t\n412\t// ============ row 450: gentype / gbtable / posix maps / callout delims\n413\t\n414\t#[test]\n415\tfn cfg_450_misc_tables() {\n416\t    let p = pair();\n417\t    let mut d = Diffs::new();\n418\t    unsafe {\n419\t        for (sym, len) in [\n420\t            (\"_pcre2_ucp_gentype_8\", 120usize),\n421\t            (\"_pcre2_ucp_gbtable_8\", 60),\n422\t            (\"_pcre2_posix_class_maps8\", 168),\n423\t            (\"_pcre2_callout_start_delims_8\", 36),\n424\t            (\"_pcre2_callout_end_delims_8\", 36),\n425\t        ] {\n426\t            d.eq(\n427\t                &format!(\"{sym} full dump\"),\n428\t                std::slice::from_raw_parts(p.c.data(sym), len).to_vec(),\n429\t                std::slice::from_raw_parts(p.r.data(sym), len).to_vec(),\n430\t            );\n431\t        }\n432\t        // gbtable drives _pcre2_extuni_8: exercise it over a grapheme corpus.\n433\t        let pieces: &[&[u8]] = &[\n434\t            b\"a\", b\"\\xcc\\x81\", b\"\\xe2\\x80\\x8d\", b\"\\xf0\\x9f\\x87\\xa6\", b\"\\xf0\\x9f\\x87\\xa7\",\n435\t            b\"\\xe1\\x84\\x80\", b\"\\xe1\\x85\\xa1\", b\"\\xe1\\x86\\xa8\", b\"\\xf0\\x9f\\x91\\xa8\",\n436\t            b\"\\xe2\\x9d\\xa4\", b\"\\xef\\xb8\\x8f\", b\"\\xe0\\xa4\\xa8\", b\"\\xe0\\xa4\\xbe\", b\"\\r\", b\"\\n\",\n437\t        ];\n438\t        let mut rng = Rng::new(4500);\n439\t        for _ in 0..3000 {\n440\t            let mut s = Vec::new();\n441\t            for _ in 0..rng.range(1, 6) {\n442\t                s.extend_from_slice(rng.pick_bytes(pieces));\n443\t            }\n444\t            let Ok(t) = std::str::from_utf8(&s) else { continue };\n445\t            let ch = t.chars().next().unwrap();\n446\t            let start = s.as_ptr();\n447\t            let end = start.add(s.len());\n448\t            let eptr = start.add(ch.len_utf8());\n449\t            let (mut xa, mut xb) = (0 as c_int, 0 as c_int);\n450\t            let ra = (p.c.p_extuni)(ch as u32, eptr, start, end, 1, &mut xa);\n451\t            let rb = (p.r.p_extuni)(ch as u32, eptr, start, end, 1, &mut xb);\n452\t            d.eq(\n453\t                &format!(\"gbtable/extuni {}\", show(&s)),\n454\t                (ra as usize - start as usize, xa),\n455\t                (rb as usize - start as usize, xb),\n456\t            );\n457\t            // and \\X over the same data\n458\t            both_match(p, b\"\\\\X\", PCRE2_UTF, &s, &mut d, &format!(\"\\\\X {}\", show(&s)));\n459\t        }\n460\t        //