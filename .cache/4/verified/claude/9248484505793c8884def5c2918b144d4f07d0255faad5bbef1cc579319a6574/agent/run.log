(&p.c, \"(b)\", 0);\n        let b2 = mk(&p.r, \"(b)\", 0);\n        let subj = b\"abc\";\n        let subj2 = b\"abc\"; // same content, different pointer\n        let mut go = |name: &str,\n                      ca: Ptr, cb: Ptr,\n                      pre: &dyn Fn(&Api, Ptr, Ptr),\n                      code_a: Ptr, code_b: Ptr,\n                      s: &[u8], slen: usize, start: usize, so: u32| {\n            let mda = (p.c.match_data_create_from_pattern)(ca, ptr::null_mut());\n            let mdb = (p.r.match_data_create_from_pattern)(cb, ptr::null_mut());\n            pre(&p.c, ca, mda);\n            pre(&p.r, cb, mdb);\n            let cap = 64usize;\n            let mut oa = vec![0xEEu8; cap + 8];\n            let mut ob = vec![0xEEu8; cap + 8];\n            let (mut la, mut lb) = (cap, cap);\n            let ra = (p.c.substitute)(\n                code_a, s.as_ptr(), slen, start, so, mda, ptr::null_mut(),\n                b\"Z\".as_ptr(), 1, oa.as_mut_ptr(), &mut la,\n            );\n            let rbv = (p.r.substitute)(\n                code_b, s.as_ptr(), slen, start, so, mdb, ptr::null_mut(),\n                b\"Z\".as_ptr(), 1, ob.as_mut_ptr(), &mut lb,\n            );\n            println!(\"{name} => C rc={ra} len={} | R rc={rbv} len={}\", show_len(la), show_len(lb));\n            assert_eq!((ra, la, &oa), (rbv, lb, &ob), \"{name}\");\n            (p.c.match_data_free)(mda);\n            (p.r.match_data_free)(mdb);\n        };\n        let m = PCRE2_SUBSTITUTE_MATCHED;\n        // 328: leftover BADOFFSET\n        go(\"328 badoffset\", a1, b1,\n           &|api, code, md| { (api.do_match)(code, b\"abc\".as_ptr(), 3, 9, 0, md, ptr::null_mut()); },\n           a1, b1, subj, 3, 0, m);\n        // 328: leftover BADOPTION\n        go(\"328 badoption\", a1, b1,\n           &|api, code, md| { (api.do_match)(code, b\"abc\".as_ptr(), 3, 0, PCRE2_DFA_SHORTEST, md, ptr::null_mut()); },\n           a1, b1, subj, 3, 0, m);\n        // 330: different code\n      