->rightchar = ((mb->last_used_ptr > mb->end_match_ptr)?\n8187\t    mb->last_used_ptr : mb->end_match_ptr) - subject;\n8188\t  if ((options & PCRE2_COPY_MATCHED_SUBJECT) != 0)\n8189\t    {\n8190\t    if (length != 0)\n8191\t      {\n8192\t      match_data->subject = match_data->memctl.malloc(CU2BYTES(length),\n8193\t        match_data->memctl.memory_data);\n8194\t      if (match_data->subject == NULL)\n8195\t        return match_data->rc = PCRE2_ERROR_NOMEMORY;\n8196\t      memcpy((void *)match_data->subject, subject, CU2BYTES(length));\n8197\t      }\n8198\t    else\n8199\t      match_data->subject = NULL;\n8200\t    match_data->flags |= PCRE2_MD_COPIED_SUBJECT;\n8201\t    }\n8202\t  else match_data->subject = original_subject;\n8203\t\n8204\t  return match_data->rc;\n8205\t  }\n8206\t\n8207\t/* Control gets here if there has been a partial match, an error, or if the\n8208\toverall match attempt has failed at all permitted starting positions. Any mark\n8209\tdata is in the nomatch_mark field. */\n8210\t\n8211\tmatch_data->mark = mb->nomatch_mark;\n8212\t\n8213\t/* For anything other than nomatch or partial match, just return the code. */\n8214\t\n8215\tif (rc != MATCH_NOMATCH && rc != PCRE2_ERROR_PARTIAL) match_data->rc = rc;\n8216\t\n8217\t/* Handle a partial match. If a \"soft\" partial match was requested, searching\n8218\tfor a complete match will have continued, and the value of rc at this point\n8219\twill be MATCH_NOMATCH. For a \"hard\" partial match, it will already be\n8220\tPCRE2_ERROR_PARTIAL. */\n8221\t\n8222\telse if (match_partial != NULL)\n8223\t  {\n8224\t  match_data->subject = original_subject;\n8225\t  match_data->subject_length = length;\n8226\t  match_data->start_offset = start_offset;\n8227\t  match_data->ovector[0] = match_partial - subject;\n8228\t  match_data->ovector[1] = end_subject - subject;\n8229\t  match_data->startchar = match_partial - subject;\n8230\t  match_data->leftchar = start_partial - subject;\n8231\t  match_data->rightchar =