d latest consulted characters. */\n6701\t\n6702\t    case OP_NOT_WORD_BOUNDARY:\n6703\t    case OP_WORD_BOUNDARY:\n6704\t    case OP_NOT_UCP_WORD_BOUNDARY:\n6705\t    case OP_UCP_WORD_BOUNDARY:\n6706\t    if (Feptr == mb->check_subject) prev_is_word = FALSE; else\n6707\t      {\n6708\t      PCRE2_SPTR lastptr = Feptr - 1;\n6709\t#ifdef SUPPORT_UNICODE\n6710\t      if (utf)\n6711\t        {\n6712\t        BACKCHAR(lastptr);\n6713\t        GETCHAR(fc, lastptr);\n6714\t        }\n6715\t      else\n6716\t#endif  /* SUPPORT_UNICODE */\n6717\t      fc = *lastptr;\n6718\t      if (lastptr < mb->start_used_ptr) mb->start_used_ptr = lastptr;\n6719\t#ifdef SUPPORT_UNICODE\n6720\t      if (Fop == OP_UCP_WORD_BOUNDARY || Fop == OP_NOT_UCP_WORD_BOUNDARY)\n6721\t        {\n6722\t        int chartype = UCD_CHARTYPE(fc);\n6723\t        int category = PRIV(ucp_gentype)[chartype];\n6724\t        prev_is_word = (category == ucp_L || category == ucp_N ||\n6725\t          chartype == ucp_Mn || chartype == ucp_Pc);\n6726\t        }\n6727\t      else\n6728\t#endif  /* SUPPORT_UNICODE */\n6729\t      prev_is_word = CHMAX_255(fc) && (mb->ctypes[fc] & ctype_word) != 0;\n6730\t      }\n6731\t\n6732\t    /* Get status of next character */\n6733\t\n6734\t    if (Feptr >= mb->end_subject)\n6735\t      {\n6736\t      SCHECK_PARTIAL();\n6737\t      cur_is_word = FALSE;\n6738\t      }\n6739\t    else\n6740\t      {\n6741\t      PCRE2_SPTR nextptr = Feptr + 1;\n6742\t#ifdef SUPPORT_UNICODE\n6743\t      if (utf)\n6744\t        {\n6745\t        FORWARDCHARTEST(nextptr, mb->end_subject);\n6746\t        GETCHAR(fc, Feptr);\n6747\t        }\n6748\t      else\n6749\t#endif  /* SUPPORT_UNICODE */\n6750\t      fc = *Feptr;\n6751\t      if (nextptr > mb->last_used_ptr) mb->last_used_ptr = nextptr;\n6752\t#ifdef SUPPORT_UNICODE\n6753\t      if (Fop == OP_UCP_WORD_BOUNDARY || Fop == OP_NOT_UCP_WORD_BOUNDARY)\n6754\t        {\n6755\t        int chartype = UCD_CHARTYPE(fc);\n6756\t        int category = PRIV(ucp