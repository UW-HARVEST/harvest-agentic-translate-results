{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Sz4wDcMbmSqxNu8y3d7woS","type":"tool_result","content":"430\t    }\n431\t    d.finish(\"pcre2_code_copy_8 / pcre2_code_copy_with_tables_8 over Cfg x patterns\");\n432\t}\n433\t\n434\t// ================================================================= matching\n435\t\n436\t/// Runs `pcre2_match` in both libraries and compares rc, ovector, startchar,\n437\t/// mark, and the derived match-data accessors.\n438\tunsafe fn cmp_match(\n439\t    p: &Pair,\n440\t    a: Ptr,\n441\t    b: Ptr,\n442\t    subj: &[u8],\n443\t    len: Sz,\n444\t    start: Sz,\n445\t    mopts: u32,\n446\t    ovecsize: u32,\n447\t    mctx: (Ptr, Ptr),\n448\t    tag: &str,\n449\t    d: &mut Diffs,\n450\t) {\n451\t    let mda = (p.c.match_data_create)(ovecsize, ptr::null_mut());\n452\t    let mdb = (p.r.match_data_create)(ovecsize, ptr::null_mut());\n453\t    let ra = (p.c.do_match)(a, subj.as_ptr(), len, start, mopts, mda, mctx.0);\n454\t    let rb = (p.r.do_match)(b, subj.as_ptr(), len, start, mopts, mdb, mctx.1);\n455\t    let oa = read_match_out(&p.c, mda, ra);\n456\t    let ob = read_match_out(&p.r, mdb, rb);\n457\t    d.eq(tag, oa, ob);\n458\t    d.eq(\n459\t        &format!(\"{tag} :: ovector_count\"),\n460\t        (p.c.get_ovector_count)(mda),\n461\t        (p.r.get_ovector_count)(mdb),\n462\t    );\n463\t    d.eq(\n464\t        &format!(\"{tag} :: match_data_size\"),\n465\t        (p.c.get_match_data_size)(mda),\n466\t        (p.r.get_match_data_size)(mdb),\n467\t    );\n468\t    d.eq(\n469\t        &format!(\"{tag} :: heapframes_size\"),\n470\t        (p.c.get_match_data_heapframes_size)(mda),\n471\t        (p.r.get_match_data_heapframes_size)(mdb),\n472\t    );\n473\t    // substring accessors over the result\n474\t    if ra > 0 && rb > 0 {\n475\t        for i in 0..(ra.max(rb) as u32 + 1) {\n476\t            let (mut la, mut lb) = (usize::MAX, usize::MAX);\n477\t            d.eq(\n478\t                &format!(\"{tag} :: substring_length_bynumber({i}) rc\"),\n479\t                (p.c.substring_length_bynumber)(mda, i, &mut la),\n480\t                (p.r.substring_length_bynumber)(mdb, i, &mut lb),\n481\t            );\n482\t            d.eq(&format!(\"{tag} :: substring_length_bynumber({i}) len\"), la, lb);\n483\t            let mut ba = [0u8; 256];\n484\t            let mut bb = [0u8; 256];\n485\t            let (mut ca, mut cb) = (ba.len(), bb.len());\n486\t            d.eq(\n487\t                &format!(\"{tag} :: substring_copy_bynumber({i}) rc\"),\n488\t                (p.c.substring_copy_bynumber)(mda, i, ba.as_mut_ptr(), &mut ca),\n489\t                (p.r.substring_copy_bynumber)(mdb, i, bb.as_mut_ptr(), &mut cb),\n490\t            );\n491\t            d.eq(&format!(\"{tag} :: substring_copy_bynumber({i}) out\"), (ba, ca), (bb, cb));\n492\t            let (mut pa, mut pb) = (ptr::null_mut::<u8>(), ptr::null_mut::<u8>());\n493\t            let (mut na, mut nb) = (usize::MAX, usize::MAX);\n494\t            let ga = (p.c.substring_get_bynumber)(mda, i, &mut pa, &mut na);\n495\t            let gb = (p.r.substring_get_bynumber)(mdb, i, &mut pb, &mut nb);\n496\t            d.eq(&format!(\"{tag} :: substring_get_bynumber({i}) rc\"), ga, gb);\n497\t            d.eq(&format!(\"{tag} :: substring_get_bynumber({i}) len\"), na, nb);\n498\t            if ga == 0 && gb == 0 {\n499\t                d.eq(\n500\t                    &format!(\"{tag} :: substring_get_bynumber({i}) bytes\"),\n501\t                    std::slice::from_raw_parts(pa, na + 1).to_vec(),\n502\t                    std::slice::from_raw_parts(pb, nb + 1).to_vec(),\n503\t                );\n504\t            }\n505\t            if !pa.is_null() {\n506\t                (p.c.substring_free)(pa);\n507\t            }\n508\t            if !pb.is_null() {\n509\t                (p.r.substring_free)(pb);\n510\t            }\n511\t        }\n512\t        // whole-list variant\n513\t        let (mut la, mut lb) = (ptr::null_mut(), ptr::null_mut());\n514\t        let (mut sa, mut sb) = (ptr::null_mut(), ptr::null_mut());\n515\t        let ra2 = (p.c.substring_list_get)(mda, &mut la, &mut sa);\n516\t        let rb2 = (p.r.substring_list_get)(mdb, &mut lb, &mut sb);\n517\t        d.eq(&format!(\"{tag} :: substring_list_get rc\"), ra2, rb2);\n518\t        if ra2 == 0 && rb2 == 0 {\n519\t            // The C uses `count = match_data->rc`, or `oveccount` when rc == 0\n520\t            // (ovector too small), and stores exactly `count` entries plus a\n521\t            // NULL terminator.\n522\t            let n = if ra > 0 {\n523\t                ra as usize\n524\t            } else {\n525\t                (p.c.get_ovector_count)(mda) as usize\n526\t            };\n527\t            for i in 0..n {\n528\t                let (x, y) = (*la.add(i), *lb.add(i));\n529\t                let (nx, ny) = (*sa.add(i), *sb.add(i));\n530\t                d.eq(&format!(\"{tag} :: list[{i}] len\"), nx, ny);\n531\t                if nx == ny {\n532\t                    d.eq(\n533\t                        &format!(\"{tag} :: list[{i}] bytes\"),\n534\t                        std::slice::from_raw_parts(x, nx).to_vec(),\n535\t                        std::slice::from_raw_parts(y, ny).to_vec(),\n536\t                    );\n537\t                }\n538\t            }\n539\t            (p.c.substring_list_free)(la);\n540\t            (p.r.substring_list_free)(lb);\n541\t        }\n542\t    }\n543\t    (p.c.match_data_free)(mda);\n544\t    (p.r.match_data_free)(mdb);\n545\t}\n546\t\n547\t/// Match options crossed over the axes `pcre2_match` branches on.\n548\tconst MOPTS: &[(u32, &str)] = &[\n549\t    (0, \"none\"),\n550\t    (PCRE2_NOTBOL, \"NOTBOL\"),\n551\t    (PCRE2_NOTEOL, \"NOTEOL\"),\n552\t    (PCRE2_NOTBOL | PCRE2_NOTEOL, \"NOTBOL|NOTEOL\"),\n553\t    (PCRE2_NOTEMPTY, \"NOTEMPTY\"),\n554\t    (PCRE2_NOTEMPTY_ATSTART, \"NOTEMPTY_ATSTART\"),\n555\t    (PCRE2_ANCHORED, \"ANCHORED\"),\n556\t    (PCRE2_ENDANCHORED, \"ENDANCHORED\"),\n557\t    (PCRE2_ANCHORED | PCRE2_ENDANCHORED, \"ANCHORED|ENDANCHORED\"),\n558\t    (PCRE2_PARTIAL_SOFT, \"PARTIAL_SOFT\"),\n559\t    (PCRE2_PARTIAL_HARD, \"PARTIAL_HARD\"),\n560\t    (PCRE2_NO_START_OPTIMIZE, \"NO_START_OPTIMIZE\"),\n561\t    (PCRE2_NO_UTF_CHECK, \"NO_UTF_CHECK\"),\n562\t    (PCRE2_COPY_MATCHED_SUBJECT, \"COPY_MATCHED_SUBJECT\"),\n563\t    (PCRE2_DISABLE_RECURSELOOP_CHECK, \"DISABLE_RECURSELOOP_CHECK\"),\n564\t    (PCRE2_NO_JIT, \"NO_JIT\"),\n565\t];\n566\t\n567\t/// Compile configurations used for matching (a representative spread; the full\n568\t/// set is covered by the bytecode test above).\n569\tfn match_cfgs() -> Vec<Cfg> {\n570\t    let all = configs();\n571\t    let names = [\n572\t        \"default\",\n573\t        \"CASELESS\",\n574\t        \"MULTILINE\",\n575\t        \"DOTALL\",\n576\t        \"UNGREEDY\",\n577\t        \"NO_START_OPTIMIZE\",\n578\t        \"NO_AUTO_POSSESS\",\n579\t        \"ANCHORED\",\n580\t        \"ENDANCHORED\",\n581\t        \"FIRSTLINE\",\n582\t        \"MATCH_UNSET_BACKREF\",\n583\t        \"AUTO_CALLOUT\",\n584\t        \"UTF\",\n585\t        \"UCP\",\n586\t        \"UTF|UCP\",\n587\t        \"UTF|CASELESS\",\n588\t        \"UTF|UCP|CASELESS\",\n589\t        \"UTF|MATCH_INVALID_UTF\",\n590\t        \"UTF|UCP|DOTALL|MULTILINE\",\n591\t        \"X:CASELESS_RESTRICT\",\n592\t        \"X:TURKISH_CASING\",\n593\t        \"X:ASCII_all|UCP|UTF\",\n594\t        \"X:MATCH_WORD\",\n595\t        \"X:MATCH_LINE\",\n596\t        \"own tables (pcre2_maketables)\",\n597\t    ];\n598\t    let mut v: Vec<Cfg> = all\n599\t        .iter()\n600\t        .filter(|c| names.contains(&c.name))\n601\t        .cloned()\n602\t        .collect();\n603\t    // plus each newline convention with MULTILINE, and both \\R conventions\n604\t    for nl in [\n605\t        PCRE2_NEWLINE_CR,\n606\t        PCRE2_NEWLINE_LF,\n607\t        PCRE2_NEWLINE_CRLF,\n608\t        PCRE2_NEWLINE_ANY,\n609\t        PCRE2_NEWLINE_ANYCRLF,\n610\t        PCRE2_NEWLINE_NUL,\n611\t    ] {\n612\t        let mut c = Cfg::new(\"MULTILINE + newline\", PCRE2_MULTILINE, 0);\n613\t        c.newline = nl;\n614\t        v.push(c);\n615\t    }\n616\t    for bsr in [PCRE2_BSR_UNICODE, PCRE2_BSR_ANYCRLF] {\n617\t        let mut c = Cfg::new(\"UTF + bsr\", PCRE2_UTF, 0);\n618\t        c.bsr = bsr;\n619\t        v.push(c);\n620\t    }\n621\t    v\n622\t}\n623\t\n624\t// CONFIGS rows: pcre2_match over (compile cfg) x (pattern) x (subject) x\n625\t// (match options) x (startoffset) x (ovector size).\n626\t#[test]\n627\tfn match_identical() {\n628\t    let p = pair();\n629\t    let mut rng = Rng::new(100);\n630\t    let mut d = Diffs::new();\n631\t    // Bound the run: deterministic limits so both libraries hit them alike.\n632\t    let mca = unsafe { (p.c.match_context_create)(ptr::null_mut()) };\n633\t    let mcb = unsafe { (p.r.match_context_create)(ptr::null_mut()) };\n634\t    unsafe {\n635\t        for (m, v) in [(&p.c, mca), (&p.r, mcb)] {\n636\t            assert_eq!((m.set_match_limit)(v, 20_000), 0);\n637\t            assert_eq!((m.set_depth_limit)(v, 2_000), 0);\n638\t            assert_eq!((m.set_heap_limit)(v, 200), 0);\n639\t        }\n640\t    }\n641\t    for cfg in &match_cfgs() {\n642\t        for pat in PATTERNS {\n643\t            let pb = pat.as_bytes();\n644\t            unsafe {\n645\t                let Some((a, b)) = compile_both(p, pb, pb.len(), cfg, &mut d) else {\n646\t                    continue;\n647\t                };\n648\t                for subj in SUBJECTS {\n649\t                    let raw = subj.as_bytes();\n650\t                    let mut zt = raw.to_vec();\n651\t                    zt.push(0);\n652\t                    // a random slice of the option/offset/ovector axes per\n653\t                    // (pattern, subject) keeps the run bounded while still\n654\t                    // covering every axis many thousands of times overall\n655\t                    for _ in 0..3 {\n656\t                        let (mo, mn) = MOPTS[rng.below(MOPTS.len())];\n657\t                        let start = if raw.is_empty() { 0 } else { rng.below(raw.len() + 1) };\n658\t                        let ovec = *rng.pick(&[0u32, 1, 2, 4, 16, 64]);\n659\t                        let zero_term = rng.chance(4) && !raw.contains(&0);\n660\t                        let len = if zero_term { PCRE2_ZERO_TERMINATED } else { raw.len() };\n661\t                        let sb: &[u8] = if zero_term { &zt } else { raw };\n662\t                        let tag = format!(\n663\t                            \"match {} cfg[{}] subj={} start={} mopts={} ovec={} len={}\",\n664\t                            show(pb),\n665\t                            cfg.name,\n666\t                            show(sb),\n667\t                            start,\n668\t                            mn,\n669\t                            ovec,\n670\t                            if len == PCRE2_ZERO_TERMINATED { \"ZT\".into() } else { len.to_string() }\n671\t                        );\n672\t                        cmp_match(p, a, b, sb, len, start, mo, ovec, (mca, mcb), &tag, &mut d);\n673\t                    }\n674\t                }\n675\t                (p.c.code_free)(a);\n676\t                (p.r.code_free)(b);\n677\t            }\n678\t        }\n679\t    }\n680\t    unsafe {\n681\t        (p.c.match_context_free)(mca);\n682\t        (p.r.match_context_free)(mcb);\n683\t    }\n684\t    d.finish(\"pcre2_match_8: match_cfgs x PATTERNS x SUBJECTS x MOPTS x startoffset x ovector size\");\n685\t}\n686\t\n687\t// CONFIGS rows: pcre2_dfa_match over the same axes, plus DFA_SHORTEST,\n688\t// DFA_RESTART and workspace sizes.\n689\t#[test]\n690\tfn dfa_match_identical() {\n691\t    let p = pair();\n692\t    let mut rng = Rng::new(200);\n693\t    let mut d = Diffs::new();\n694\t    let mca = unsafe { (p.c.match_context_create)(ptr::null_mut()) };\n695\t    let mcb = unsafe { (p.r.match_context_create)(ptr::null_mut()) };\n696\t    unsafe {\n697\t        for (m, v) in [(&p.c, mca), (&p.r, mcb)] {\n698\t            assert_eq!((m.set_match_limit)(v, 20_000), 0);\n699\t            assert_eq!((m.set_depth_limit)(v, 2_000), 0);\n700\t        }\n701\t    }\n702\t    let dfa_opts: &[(u32, &str)] = &[\n703\t        (0, \"none\"),\n704\t        (PCRE2_DFA_SHORTEST, \"DFA_SHORTEST\"),\n705\t        (PCRE2_NOTBOL, \"NOTBOL\"),\n706\t        (PCRE2_NOTEOL, \"NOTEOL\"),\n707\t        (PCRE2_NOTEMPTY, \"NOTEMPTY\"),\n708\t        (PCRE2_NOTEMPTY_ATSTART, \"NOTEMPTY_ATSTART\"),\n709\t        (PCRE2_ANCHORED, \"ANCHORED\"),\n710\t        (PCRE2_ENDANCHORED, \"ENDANCHORED\"),\n711\t        (PCRE2_PARTIAL_SOFT, \"PARTIAL_SOFT\"),\n712\t        (PCRE2_PARTIAL_HARD, \"PARTIAL_HARD\"),\n713\t        (PCRE2_NO_START_OPTIMIZE, \"NO_START_OPTIMIZE\"),\n714\t        (PCRE2_NO_UTF_CHECK, \"NO_UTF_CHECK\"),\n715\t        (PCRE2_COPY_MATCHED_SUBJECT, \"COPY_MATCHED_SUBJECT\"),\n716\t    ];\n717\t    for cfg in &match_cfgs() {\n718\t        for pat in PATTERNS {\n719\t            let pb = pat.as_bytes();\n720\t            unsafe {\n721\t                let Some((a, b)) = compile_both(p, pb, pb.len(), cfg, &mut d) else {\n722\t                    continue;\n723\t                };\n724\t                for subj in SUBJECTS {\n725\t                    let sb = subj.as_bytes();\n726\t                    for _ in 0..3 {\n727\t                        let (mo, mn) = dfa_opts[rng.below(dfa_opts.len())];\n728\t                        let start = if sb.is_empty() { 0 } else { rng.below(sb.len() + 1) };\n729\t                        let ovec = *rng.pick(&[0u32, 1, 2, 4, 16]);\n730\t                        // include a deliberately tiny workspace to reach\n731\t                        // PCRE2_ERROR_DFA_WSSIZE identically\n732\t                        let wsn = *rng.pick(&[20usize, 100, 1000]);\n733\t                        let mut wa = vec![0 as c_int; wsn];\n734\t                        let mut wb = vec![0 as c_int; wsn];\n735\t                        let mda = (p.c.match_data_create)(ovec, ptr::null_mut());\n736\t                        let mdb = (p.r.match_data_create)(ovec, ptr::null_mut());\n737\t                        let ra = (p.c.dfa_match)(\n738\t                            a, sb.as_ptr(), sb.len(), start, mo, mda, mca, wa.as_mut_ptr(), wsn,\n739\t                        );\n740\t                        let rb = (p.r.dfa_match)(\n741\t                            b, sb.as_ptr(), sb.len(), start, mo, mdb, mcb, wb.as_mut_ptr(), wsn,\n742\t                        );\n743\t                        let tag = format!(\n744\t                            \"dfa_match {} cfg[{}] subj={} start={} opts={} ovec={} ws={}\",\n745\t                            show(pb), cfg.name, show(sb), start, mn, ovec, wsn\n746\t                        );\n747\t                        d.eq(&tag, read_match_out_of(&p.c, mda, ra, Engine::Dfa), read_match_out_of(&p.r, mdb, rb, Engine::Dfa));\n748\t                        (p.c.match_data_free)(mda);\n749\t                        (p.r.match_data_free)(mdb);\n750\t                    }\n751\t                }\n752\t                (p.c.code_free)(a);\n753\t                (p.r.code_free)(b);\n754\t            }\n755\t        }\n756\t    }\n757\t    unsafe {\n758\t        (p.c.match_context_free)(mca);\n759\t        (p.r.match_context_free)(mcb);\n760\t    }\n761\t    d.finish(\"pcre2_dfa_match_8: match_cfgs x PATTERNS x SUBJECTS x dfa options x workspace sizes\");\n762\t}\n763\t\n764\t// CONFIGS row: pcre2_next_match_8 — iterating the alternative match ends that\n765\t// pcre2_dfa_match records in the ovector.\n766\t#[test]\n767\tfn next_match_identical() {\n768\t    let p = pair();\n769\t    let mut d = Diffs::new();\n770\t    let cfgs = match_cfgs();\n771\t    for cfg in cfgs.iter().take(20) {\n772\t        for pat in PATTERNS {\n773\t            let pb = pat.as_bytes();\n774\t            unsafe {\n775\t                let Some((a, b)) = compile_both(p, pb, pb.len(), cfg, &mut d) else {\n776\t                    continue;\n777\t                };\n778\t                for subj in SUBJECTS {\n779\t                    let sb = subj.as_bytes();\n780\t                    let mut ws_a = vec![0 as c_int; 1000];\n781\t                    let mut ws_b = vec![0 as c_int; 1000];\n782\t                    let mda = (p.c.match_data_create)(16, ptr::null_mut());\n783\t                    let mdb = (p.r.match_data_create)(16, ptr::null_mut());\n784\t                    let ra = (p.c.dfa_match)(\n785\t                        a, sb.as_ptr(), sb.len(), 0, 0, mda, ptr::null_mut(), ws_a.as_mut_ptr(), 1000,\n786\t                    );\n787\t                    let rb = (p.r.dfa_match)(\n788\t                        b, sb.as_ptr(), sb.len(), 0, 0, mdb, ptr::null_mut(), ws_b.as_mut_ptr(), 1000,\n789\t                    );\n790\t                    let tag = format!(\"next_match {} cfg[{}] subj={}\", show(pb), cfg.name, show(sb));\n791\t                    d.eq(&format!(\"{tag} dfa rc\"), ra, rb);\n792\t                    // walk the whole iterator to exhaustion in both\n793\t                    let mut steps_a = Vec::new();\n794\t                    let mut steps_b = Vec::new();\n795\t                    loop {\n796\t                        let (mut o, mut f) = (usize::MAX, 0u32);\n797\t                        let rc = (p.c.next_match)(mda, &mut o, &mut f);\n798\t                        steps_a.push((rc, o, f));\n799\t                        if rc <= 0 || steps_a.len() > 40 {\n800\t                            break;\n801\t                        }\n802\t                    }\n803\t                    loop {\n804\t                        let (mut o, mut f) = (usize::MAX, 0u32);\n805\t                        let rc = (p.r.next_match)(mdb, &mut o, &mut f);\n806\t                        steps_b.push((rc, o, f));\n807\t                        if rc <= 0 || steps_b.len() > 40 {\n808\t                            break;\n809\t                        }\n810\t                    }\n811\t                    d.eq(&format!(\"{tag} next_match sequence\"), steps_a, steps_b);\n812\t                    (p.c.match_data_free)(mda);\n813\t                    (p.r.match_data_free)(mdb);\n814\t                }\n815\t                (p.c.code_free)(a);\n816\t                (p.r.code_free)(b);\n817\t            }\n818\t        }\n819\t    }\n820\t    d.finish(\"pcre2_next_match_8: full iteration after pcre2_dfa_match over cfgs x patterns x subjects\");\n821\t}\n822\t\n823\t// =========================================================== callouts\n824\t\n825\tstatic mut CALLOUT_LOG: Vec<u8> = Vec::new();\n826\t\n827\t/// Records the fields of every callout block so the two libraries' callout\n828\t/// sequences can be compared exactly.  Layout mirrors `pcre2_callout_block`.\n829\t#[repr(C)]\n830\tstruct CalloutBlock {\n831\t    version: u32,\n832\t    callout_number: u32,\n833\t    capture_top: u32,\n834\t    capture_last: u32,\n835\t    offset_vector: *const Sz,\n836\t    mark: Sptr,\n837\t    subject: Sptr,\n838\t    subject_length: Sz,\n839\t    start_match: Sz,\n840\t    current_position: Sz,\n841\t    pattern_position: Sz,\n842\t    next_item_length: Sz,\n843\t    callout_string_offset: Sz,\n844\t    callout_string_length: Sz,\n845\t    callout_string: Sptr,\n846\t    callout_flags: u32,\n847\t}\n848\t\n849\t/// `pcre2_callout_enumerate_block` — a DIFFERENT layout from\n850\t/// `pcre2_callout_block`, so it needs its own recorder.\n851\t#[repr(C)]\n852\tstruct CalloutEnumBlock {\n853\t    version: u32,\n854\t    pattern_position: Sz,\n855\t    next_item_length: Sz,\n856\t    callout_number: u32,\n857\t    callout_string_offset: Sz,\n858\t    callout_string_length: Sz,\n859\t    callout_string: Sptr,\n860\t}\n861\t\n862\tunsafe extern \"C\" fn record_enum_callout(blk: *mut c_void, _data: *mut c_void) -> c_int {\n863\t    let b = &*(blk as *const CalloutEnumBlock);\n864\t    let log = &mut *ptr::addr_of_mut!(CALLOUT_LOG);\n865\t    for v in [\n866\t        b.version as u64,\n867\t        b.pattern_position as u64,\n868\t        b.next_item_length as u64,\n869\t        b.callout_number as u64,\n870\t        b.callout_string_offset as u64,\n871\t        b.callout_string_length as u64,\n872\t    ] {\n873\t        log.extend_from_slice(&v.to_le_bytes());\n874\t    }\n875\t    if !b.callout_string.is_null() {\n876\t        log.extend_from_slice(std::slice::from_raw_parts(\n877\t            b.callout_string,\n878\t            b.callout_string_length,\n879\t        ));\n880\t    }\n881\t    0\n882\t}\n883\t\n884\tunsafe extern \"C\" fn record_callout(blk: *mut c_void, _data: *mut c_void) -> c_int {\n885\t    let b = &*(blk as *const CalloutBlock);\n886\t    let log = &mut *ptr::addr_of_mut!(CALLOUT_LOG);\n887\t    for v in [\n888\t        b.version as u64,\n889\t        b.callout_number as u64,\n890\t        b.capture_top as u64,\n891\t        b.capture_last as u64,\n892\t        b.subject_length as u64,\n893\t        b.start_match as u64,\n894\t        b.current_position as u64,\n895\t        b.pattern_position as u64,\n896\t        b.next_item_length as u64,\n897\t        b.callout_string_offset as u64,\n898\t        b.callout_string_length as u64,\n899\t        b.callout_flags as u64,\n900\t        b.mark.is_null() as u64,\n901\t    ] {\n902\t        log.extend_from_slice(&v.to_le_bytes());\n903\t    }\n904\t    if !b.callout_string.is_null() {\n905\t        log.extend_from_slice(std::slice::from_raw_parts(\n906\t            b.callout_string,\n907\t            b.callout_string_length,\n908\t        ));\n909\t    }\n910\t    0\n911\t}\n912\t\n913\t// CONFIGS rows: match-time callouts, with AUTO_CALLOUT and with explicit\n914\t// (?C) / (?C1) / (?C{str}) callouts — the whole callout sequence must match.\n915\t#[test]\n916\tfn callouts_identical() {\n917\t    let p = pair();\n918\t    let mut d = Diffs::new();\n919\t    let cal_pats: &[&str] = &[\n920\t        \"a(?C)b\",\n921\t        \"a(?C1)b\",\n922\t        \"a(?C255)b\",\n923\t        \"a(?C{txt})b\",\n924\t        \"(?C0)a(?C1)b(?C2)c\",\n925\t        \"(a)(?C)(b)\",\n926\t        \"\\\\d+(?C9)\\\\w*\",\n927\t        \"(?:a(?C)|b(?C))+\",\n928\t        \"^(?C)a*(?C)$\",\n929\t    ];\n930\t    for cfg in [\n931\t        Cfg::new(\"default\", 0, 0),\n932\t        Cfg::new(\"AUTO_CALLOUT\", PCRE2_AUTO_CALLOUT, 0),\n933\t        Cfg::new(\"UTF|AUTO_CALLOUT\", PCRE2_UTF | PCRE2_AUTO_CALLOUT, 0),\n934\t        Cfg::new(\"UTF|UCP\", PCRE2_UTF | PCRE2_UCP, 0),\n935\t    ] {\n936\t        // AUTO_CALLOUT applies to every pattern, so use the full corpus there\n937\t        let pats: Vec<&str> = if cfg.opts & PCRE2_AUTO_CALLOUT != 0 {\n938\t            PATTERNS.iter().copied().collect()\n939\t        } else {\n940\t            cal_pats.iter().copied().collect()\n941\t        };\n942\t        for pat in pats {\n943\t            let pb = pat.as_bytes();\n944\t            unsafe {\n945\t                let Some((a, b)) = compile_both(p, pb, pb.len(), &cfg, &mut d) else {\n946\t                    continue;\n947\t                };\n948\t                // pcre2_callout_enumerate walks the compiled pattern\n949\t                {\n950\t                    CALLOUT_LOG.clear();\n951\t                    let ea = (p.c.callout_enumerate)(a, Some(record_enum_callout), ptr::null_mut());\n952\t                    let la = CALLOUT_LOG.clone();\n953\t                    CALLOUT_LOG.clear();\n954\t                    let eb = (p.r.callout_enumerate)(b, Some(record_enum_callout), ptr::null_mut());\n955\t                    let lb = CALLOUT_LOG.clone();\n956\t                    d.eq(&format!(\"callout_enumerate rc {}\", show(pb)), ea, eb);\n957\t                    d.eq(&format!(\"callout_enumerate log {}\", show(pb)), la, lb);\n958\t                }\n959\t                let mca = (p.c.match_context_create)(ptr::null_mut());\n960\t                let mcb = (p.r.match_context_create)(ptr::null_mut());\n961\t                assert_eq!((p.c.set_callout)(mca, Some(record_callout), ptr::null_mut()), 0);\n962\t                assert_eq!((p.r.set_callout)(mcb, Some(record_callout), ptr::null_mut()), 0);\n963\t                for subj in SUBJECTS {\n964\t                    let sb = subj.as_bytes();\n965\t                    for &(mo, mn) in &[(0u32, \"none\"), (PCRE2_NO_START_OPTIMIZE, \"NO_START_OPT\")] {\n966\t                        let mda = (p.c.match_data_create)(16, ptr::null_mut());\n967\t                        let mdb = (p.r.match_data_create)(16, ptr::null_mut());\n968\t                        CALLOUT_LOG.clear();\n969\t                        let ra = (p.c.do_match)(a, sb.as_ptr(), sb.len(), 0, mo, mda, mca);\n970\t                        let la = CALLOUT_LOG.clone();\n971\t                        CALLOUT_LOG.clear();\n972\t                        let rb = (p.r.do_match)(b, sb.as_ptr(), sb.len(), 0, mo, mdb, mcb);\n973\t                        let lb = CALLOUT_LOG.clone();\n974\t                        let tag =\n975\t                            format!(\"callout match {} cfg[{}] subj={} {}\", show(pb), cfg.name, show(sb), mn);\n976\t                        d.eq(&tag, read_match_out_of(&p.c, mda, ra, Engine::Dfa), read_match_out_of(&p.r, mdb, rb, Engine::Dfa));\n977\t                        d.eq(&format!(\"{tag} :: callout log\"), la, lb);\n978\t                        (p.c.match_data_free)(mda);\n979\t                        (p.r.match_data_free)(mdb);\n980\t                    }\n981\t                }\n982\t                (p.c.match_context_free)(mca);\n983\t                (p.r.match_context_free)(mcb);\n984\t                (p.c.code_free)(a);\n985\t                (p.r.code_free)(b);\n986\t            }\n987\t        }\n988\t    }\n989\t    d.finish(\"callouts: explicit (?C..) and AUTO_CALLOUT, pcre2_callout_enumerate_8 + match-time sequence\");"}]},"parent_tool_use_id":"toolu_bdrk_01E3Rz4Ctn9oqZ4a1TsEvLXT","session_id":"cde48455-d5ce-4cd5-a0b0-2154082e5