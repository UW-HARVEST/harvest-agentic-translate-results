8\t\n5339\t    for (i = 1; i <= Lmin; i++)\n5340\t      {\n5341\t      PCRE2_SIZE slength;\n5342\t      rrc = match_ref(Loffset, Lcaseless, Lcaseopts, F, mb, &slength);\n5343\t      if (rrc != 0)\n5344\t        {\n5345\t        if (rrc > 0) Feptr = mb->end_subject;   /* Partial match */\n5346\t        CHECK_PARTIAL();\n5347\t        RRETURN(MATCH_NOMATCH);\n5348\t        }\n5349\t      Feptr += slength;\n5350\t      }\n5351\t\n5352\t    /* If min = max, we are done. They are not both allowed to be zero. */\n5353\t\n5354\t    if (Lmin == Lmax) continue;\n5355\t\n5356\t    /* If minimizing, keep trying and advancing the pointer. */\n5357\t\n5358\t    if (reptype == REPTYPE_MIN)\n5359\t      {\n5360\t      for (;;)\n5361\t        {\n5362\t        PCRE2_SIZE slength;\n5363\t        RMATCH(Fecode, RM20);\n5364\t        if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n5365\t        if (Lmin++ >= Lmax) RRETURN(MATCH_NOMATCH);\n5366\t        rrc = match_ref(Loffset, Lcaseless, Lcaseopts, F, mb, &slength);\n5367\t        if (rrc != 0)\n5368\t          {\n5369\t          if (rrc > 0) Feptr = mb->end_subject;   /* Partial match */\n5370\t          CHECK_PARTIAL();\n5371\t          RRETURN(MATCH_NOMATCH);\n5372\t          }\n5373\t        Feptr += slength;\n5374\t        }\n5375\t\n5376\t      PCRE2_UNREACHABLE(); /* Control never reaches here */\n5377\t      }\n5378\t\n5379\t    /* If maximizing, find the longest string and work backwards, as long as\n5380\t    the matched lengths for each iteration are the same. */\n5381\t\n5382\t    else\n5383\t      {\n5384\t      BOOL samelengths = TRUE;\n5385\t      Lstart = Feptr;     /* Starting position */\n5386\t      Llength = Fovector[Loffset+1] - Fovector[Loffset];\n5387\t\n5388\t      for (i = Lmin; i < Lmax; i++)\n5389\t        {\n5390\t        PCRE2_SIZE slength;\n5391\t        rrc = match_ref(Loffset, Lcaseless, Lcaseopts, F, mb, &slength);\n5392\t        if (rrc != 0)\n5393\t          {\n5394\t          /* Can't use CHECK_PARTIAL because we don't want to update Feptr in\n5395\t          the soft partial matching case. */\n5396\t\n5397\t          if (rrc > 0 && mb->partial != 0 &&\n5398\t              mb->end_subject > mb->start_used_ptr)\n5399\t            {\n5400\t            mb->hitend = TRUE;\n5401\t            if (mb->partial > 1) return PCRE2_ERROR_PARTIAL;\n5402\t            }\n5403\t          break;\n5404\t          }\n5405\t\n5406\t        if (slength != Llength) samelengths = FALSE;\n5407\t        Feptr += slength;\n5408\t        }\n5409\t\n5410\t      /* No recursion if the repeat type is possessive. */\n5411\t      if (reptype == REPTYPE_POS) break;\n5412\t\n5413\t      /* If the length matched for each repetition is the same as the length of\n5414\t      the captured group, we can easily work backwards. This is the normal\n5415\t      case. However, in caseless UTF-8 mode there are pairs of case-equivalent\n5416\t      characters whose lengths (in terms of code units) differ. However, this\n5417\t      is very rare, so we handle it by re-matching fewer and fewer times. */\n5418\t\n5419\t      if (samelengths)\n5420\t        {\n5421\t        while (Feptr >= Lstart)\n5422\t          {\n5423\t          RMATCH(Fecode, RM21);\n5424\t          if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n5425\t          Feptr -= Llength;\n5426\t          }\n5427\t        }\n5428\t\n5429\t      /* The rare case of non-matching lengths. Re-scan the repetition for each\n5430\t      iteration. We know that match_ref() will succeed every time. */\n5431\t\n5432\t      else\n5433\t        {\n5434\t        Lmax = i;\n5435\t        for (;;)\n5436\t          {\n5437\t          RMATCH(Fecode, RM22);\n5438\t          if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n5439\t          if (Feptr == Lstart) break; /* Failed after minimal repetition */\n5440\t          Feptr = Lstart;\n5441\t          Lmax--;\n5442\t          for (i = Lmin; i < Lmax; i++)\n5443\t            {\n5444\t            PCRE2_SIZE slength;\n5445\t            (void)match_ref(Loffset, Lcaseless, Lcaseopts, F, mb, &slength);\n5446\t            Feptr += slength;\n5447\t            }\n5448\t          }\n5449\t        }\n5450\t\n5451\t      RRETURN(MATCH_NOMATCH);\n5452\t      }\n5453\t\n5454\t    PCRE2_DEBUG_UNREACHABLE(); /* Control should never reach here */\n5455\t\n5456\t#undef Lstart\n5457\t#undef Loffset\n5458\t#undef Llength\n5459\t#undef Lmin\n5460\t#undef Lmax\n5461\t#undef Lcaseless\n5462\t#undef Lcaseopts\n5463\t\n5464\t\n5465\t/* ========================================================================= */\n5466\t/*           Opcodes for the start of various parenthesized items            */\n5467\t/* ========================================================================= */\n5468\t\n5469\t    /* In all cases, if the result of RMATCH() is MATCH_THEN, check whether the\n5470\t    (*THEN) is within the current branch by comparing the address of OP_THEN\n5471\t    that is passed back with the end of the branch. If (*THEN) is within the\n5472\t    current branch, and the branch is one of two or more alternatives (it\n5473\t    either starts or ends with OP_ALT), we have reached the limit of THEN's\n5474\t    action, so convert the return code to NOMATCH, which will cause normal\n5475\t    backtracking to happen from now on. Otherwise, THEN is passed back to an\n5476\t    outer alternative. This implements Perl's treatment of parenthesized\n5477\t    groups, where a group not containing | does not affect the current\n5478\t    alternative, that is, (X) is NOT the same as (X|(*F)). */\n5479\t\n5480\t\n5481\t    /* ===================================================================== */\n5482\t    /* BRAZERO, BRAMINZERO and SKIPZERO occur just before a non-possessive\n5483\t    bracket group, indicating that it may occur zero times. It may repeat\n5484\t    infinitely, or not at all - i.e. it could be ()* or ()? or even (){0} in\n5485\t    the pattern. Brackets with fixed upper repeat limits are compiled as a\n5486\t    number of copies, with the optional ones preceded by BRAZERO or BRAMINZERO.\n5487\t    Possessive groups with possible zero repeats are preceded by BRAPOSZERO. */\n5488\t\n5489\t    case OP_BRAZERO:\n5490\t      {\n5491\t      PCRE2_SPTR next_ecode;\n5492\t\n5493\t      Fecode++;\n5494\t      RMATCH(Fecode, RM9);\n5495\t      if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n5496\t      next_ecode = Fecode;\n5497\t      do next_ecode += GET(next_ecode, 1); while (*next_ecode == OP_ALT);\n5498\t      Fecode = next_ecode + 1 + LINK_SIZE;\n5499\t      }\n5500\t    break;\n5501\t\n5502\t    case OP_BRAMINZERO:\n5503\t      {\n5504\t      PCRE2_SPTR next_ecode;\n5505\t\n5506\t      Fecode++;\n5507\t      next_ecode = Fecode;\n5508\t      do next_ecode += GET(next_ecode, 1); while (*next_ecode == OP_ALT);\n5509\t      RMATCH(next_ecode + 1 + LINK_SIZE, RM10);\n5510\t      if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n5511\t      }\n5512\t    break;\n5513\t\n5514\t    case OP_SKIPZERO:\n5515\t      {\n5516\t      PCRE2_SPTR next_ecode = Fecode + 1;\n5517\t      do next_ecode += GET(next_ecode, 1); while (*next_ecode == OP_ALT);\n5518\t      Fecode = next_ecode + 1 + LINK_SIZE;\n5519\t      }\n5520\t    break;\n5521\t\n5522\t\n5523\t    /* ===================================================================== */\n5524\t    /* Handle possessive brackets with an unlimited repeat. The end of these\n5525\t    brackets will always be OP_KETRPOS, which returns MATCH_KETRPOS without\n5526\t    going further in the pattern. */\n5527\t\n5528\t#define Lstart_eptr    F->fields.op_brapos.start_eptr\n5529\t#define Lstart_group   F->fields.op_brapos.start_group\n5530\t#define Lframe_type    F->fields.op_brapos.frame_type\n5531\t#define Lmatched_once  F->byte1\n5532\t#define Lzero_allowed  F->byte2\n5533\t\n5534\t    case OP_BRAPOSZERO:\n5535\t    Lzero_allowed = TRUE;                /* Zero repeat is allowed */\n5536\t    Fecode += 1;\n5537\t    if (*Fecode == OP_CBRAPOS || *Fecode == OP_SCBRAPOS)\n5538\t      goto POSSESSIVE_CAPTURE;\n5539\t    goto POSSESSIVE_NON_CAPTURE;\n5540\t\n5541\t    case OP_BRAPOS:\n5542\t    case OP_SBRAPOS:\n5543\t    Lzero_allowed = FALSE;               /* Zero repeat not allowed */\n5544\t\n5545\t    POSSESSIVE_NON_CAPTURE:\n5546\t    Lframe_type = GF_NOCAPTURE;          /* Remembered frame type */\n5547\t    goto POSSESSIVE_GROUP;\n5548\t\n5549\t    case OP_CBRAPOS:\n5550\t    case OP_SCBRAPOS:\n5551\t    Lzero_allowed = FALSE;               /* Zero repeat not allowed */\n5552\t\n5553\t    POSSESSIVE_CAPTURE:\n5554\t    number = GET2(Fecode, 1+LINK_SIZE);\n5555\t    Lframe_type = GF_CAPTURE | number;   /* Remembered frame type */\n5556\t\n5557\t    POSSESSIVE_GROUP:\n5558\t    Lmatched_once = FALSE;               /* Never matched */\n5559\t    Lstart_group = Fecode;               /* Start of this group */\n5560\t\n5561\t    for (;;)\n5562\t      {\n5563\t      Lstart_eptr = Feptr;               /* Position at group start */\n5564\t      group_frame_type = Lframe_type;\n5565\t      RMATCH(Fecode + PRIV(OP_lengths)[*Fecode], RM8);\n5566\t      if (rrc == MATCH_KETRPOS)\n5567\t        {\n5568\t        Lmatched_once = TRUE;            /* Matched at least once */\n5569\t        if (Feptr == Lstart_eptr)        /* Empty match; skip to end */\n5570\t          {\n5571\t          do Fecode += GET(Fecode, 1); while (*Fecode == OP_ALT);\n5572\t          break;\n5573\t          }\n5574\t\n5575\t        Fecode = Lstart_group;\n5576\t        continue;\n5577\t        }\n5578\t\n5579\t      /* See comment above about handling THEN. */\n5580\t\n5581\t      if (rrc == MATCH_THEN)\n5582\t        {\n5583\t        PCRE2_SPTR next_ecode = Fecode + GET(Fecode,1);\n5584\t        if (mb->verb_ecode_ptr < next_ecode &&\n5585\t            (*Fecode == OP_ALT || *next_ecode == OP_ALT))\n5586\t          rrc = MATCH_NOMATCH;\n5587\t        }\n5588\t\n5589\t      if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n5590\t      Fecode += GET(Fecode, 1);\n5591\t      if (*Fecode != OP_ALT) break;\n5592\t      }\n5593\t\n5594\t    /* Success if matched something or zero repeat allowed */\n5595\t\n5596\t    if (Lmatched_once || Lzero_allowed)\n5597\t      {\n5598\t      Fecode += 1 + LINK_SIZE;\n5599\t      break;\n5600\t      }\n5601\t\n5602\t    RRETURN(MATCH_NOMATCH);\n5603\t\n5604\t#undef Lstart_eptr\n5605\t#undef Lstart_group\n5606\t#undef Lframe_type\n5607\t#undef Lmatched_once\n5608\t#undef Lzero_allowed\n5609\t\n5610\t\n5611\t    /* ===================================================================== */\n5612\t    /* Handle non-capturing brackets that cannot match an empty string. When we\n5613\t    get to the final alternative within the brackets, as long as there are no\n5614\t    THEN's in the pattern, we can optimize by not recording a new backtracking\n5615\t    point. (Ideally we should test for a THEN within this group, but we don't\n5616\t    have that information.) Don't do this if we are at the very top level,\n5617\t    however, because that would make handling assertions and once-only brackets\n5618\t    messier when there is nothing to go back to. */\n5619\t\n5620\t#define Lframe_type    F->fields.op_bra.frame_type\n5621\t\n5622\t    case OP_BRA:\n5623\t    if (mb->hasthen || Frdepth == 0)\n5624\t      {\n5625\t      Lframe_type = 0;\n5626\t      goto GROUPLOOP;\n5627\t      }\n5628\t\n5629\t    for (;;)\n5630\t      {\n5631\t      PCRE2_SPTR current_branch = Fecode;\n5632\t      PCRE2_SPTR next_branch = current_branch + GET(current_branch, 1);\n5633\t\n5634\t      if (*next_branch != OP_ALT) break;\n5635\t\n5636\t      /* This is never the final branch. We do not need to test for MATCH_THEN\n5637\t      here because this code is not used when there is a THEN in the pattern. */\n5638\t\n5639\t      Fecode = next_branch;\n5640\t      PCRE2_ASSERT((*current_branch == OP_BRA || *current_branch == OP_ALT) &&\n5641\t                   PRIV(OP_lengths)[OP_BRA] == 1 + LINK_SIZE &&\n5642\t                   PRIV(OP_lengths)[OP_ALT] == 1 + LINK_SIZE);\n5643\t\n5644\t      RMATCH(current_branch + 1 + LINK_SIZE, RM1);\n5645\t      if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n5646\t      }\n5647\t\n5648\t    /* Hit the start of the final branch. Continue at this level. */\n5649\t\n5650\t    PCRE2_ASSERT((*Fecode == OP_BRA || *Fecode == OP_ALT) &&\n5651\t                 PRIV(OP_lengths)[OP_BRA] == 1 + LINK_SIZE &&\n5652\t                 PRIV(OP_lengths)[OP_ALT] == 1 + LINK_SIZE);\n5653\t    Fecode += 1 + LINK_SIZE;\n5654\t    break;\n5655\t\n5656\t\n5657\t    /* ===================================================================== */\n5658\t    /* Handle a capturing bracket, other than those that are possessive with an\n5659\t    unlimited repeat. */\n5660\t\n5661\t    case OP_CBRA:\n5662\t    case OP_SCBRA:\n5663\t    Lframe_type = GF_CAPTURE | GET2(Fecode, 1+LINK_SIZE);\n5664\t    goto GROUPLOOP;\n5665\t\n5666\t\n5667\t    /* ===================================================================== */\n5668\t    /* Atomic groups and non-capturing brackets that can match an empty string\n5669\t    must record a backtracking point and also set up a chained frame. */\n5670\t\n5671\t    case OP_ONCE:\n5672\t    case OP_SCRIPT_RUN:\n5673\t    case OP_SBRA:\n5674\t    Lframe_type = GF_NOCAPTURE;\n5675\t\n5676\t    GROUPLOOP:\n5677\t    for (;;)\n5678\t      {\n5679\t      group_frame_type = Lframe_type;\n5680\t      RMATCH(Fecode + PRIV(OP_lengths)[*Fecode], RM2);\n5681\t      if (rrc == MATCH_THEN)\n5682\t        {\n5683\t        PCRE2_SPTR next_ecode = Fecode + GET(Fecode,1);\n5684\t        if (mb->verb_ecode_ptr < next_ecode &&\n5685\t            (*Fecode == OP_ALT || *next_ecode == OP_ALT))\n5686\t          rrc = MATCH_NOMATCH;\n5687\t        }\n5688\t      if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n5689\t      Fecode += GET(Fecode, 1);\n5690\t      if (*Fecode != OP_ALT) RRETURN(MATCH_NOMATCH);\n5691\t      }\n5692\t    PCRE2_UNREACHABLE(); /* Control never reaches here */\n5693\t\n5694\t#undef Lframe_type\n5695\t\n5696\t\n5697\t    /* ===================================================================== */\n5698\t    /* Pattern recursion either matches the current regex, or some\n5699\t    subexpression. The offset data is the offset to the starting bracket from\n5700\t    the start of the whole pattern. This is so that it works from duplicated\n5701\t    subpatterns. For a whole-pattern recursion, we have to infer the number\n5702\t    zero. */\n5703\t\n5704\t#define Lstart_branch  F->fields.op_recurse.start_branch\n5705\t#define Lframe_type    F->fields.op_recurse.frame_type\n5706\t\n5707\t    case OP_RECURSE:\n5708\t    bracode = mb->start_code + GET(Fecode, 1);\n5709\t    number = (bracode == mb->start_code)? 0 : GET2(bracode, 1 + LINK_SIZE);\n5710\t\n5711\t    /* If we are already in a pattern recursion, check for repeating the same\n5712\t    one without changing the subject pointer or the last referenced character\n5713\t    in the subject. This should catch convoluted mutual recursions; some\n5714\t    simple cases are caught at compile time. However, there are rare cases when\n5715\t    this check needs to be turned off. In this case, actual recursion loops\n5716\t    will be caught by the match or heap limits. */\n5717\t\n5718\t    if (Fcurrent_recurse != RECURSE_UNSET)\n5719\t      {\n5720\t      offset = Flast_group_offset;\n5721\t      while (offset != PCRE2_UNSET)\n5722\t        {\n5723\t        N = (heapframe *)((char *)match_data->heapframes + offset);\n5724\t        P = (heapframe *)((char *)N - frame_size);\n5725\t        if (N->group_frame_type == (GF_RECURSE | number))\n5726\t          {\n5727\t          if (Feptr == P->eptr && mb->last_used_ptr == P->recurse_last_used &&\n5728\t               (mb->moptions & PCRE2_DISABLE_RECURSELOOP_CHECK) == 0)\n5729\t            return PCRE2_ERROR_RECURSELOOP;\n5730\t          break;\n5731\t          }\n5732\t        offset = P->last_group_offset;\n5733\t        }\n5734\t      }\n5735\t\n5736\t    /* R