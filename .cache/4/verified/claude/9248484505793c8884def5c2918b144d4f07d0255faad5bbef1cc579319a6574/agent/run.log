{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01RUty1u465k1Y16uRQE2QSm","type":"tool_result","content":"1\t// Phase B sign-off for CONFIGS.md rows 352-406:\n2\t//   substring accessors (352-364), pattern_info + callout_enumerate (365-372),\n3\t//   serialize (373-379), pattern_convert (380-394), contexts / config /\n4\t//   error messages (395-406).\n5\t//\n6\t// Every row drives its exact named configuration through BOTH `.so`s and\n7\t// compares every observable, and each row additionally gets a randomized sweep\n8\t// with a fixed seed so value-dependent bugs are reachable.\n9\t\n10\tmod common;\n11\tuse common::*;\n12\tuse std::ffi::{c_int, c_void, CStr};\n13\tuse std::ptr;\n14\t\n15\tpub const COVERAGE: &[CfgCov] = &[\n16\t    // --- substring\n17\t    CfgCov { cfg_rows: &[352], note: \"length_bynumber: set/unset/>top_bracket/oveccount edges\" },\n18\t    CfgCov { cfg_rows: &[353], note: \"length_bynumber on a PARTIAL match_data\" },\n19\t    CfgCov { cfg_rows: &[354], note: \"length_bynumber on a DFA match_data (no top_bracket check)\" },\n20\t    CfgCov { cfg_rows: &[355], note: \"length_bynumber when rc == 0 (ovector too small)\" },\n21\t    CfgCov { cfg_rows: &[356], note: \"length_bynumber with \\\\K making left > right\" },\n22\t    CfgCov { cfg_rows: &[357], note: \"copy_bynumber buffer sizes: exact, one-too-small, 0, zero-length substring\" },\n23\t    CfgCov { cfg_rows: &[358], note: \"get_bynumber + substring_free, incl. NUL-containing and NULL\" },\n24\t    CfgCov { cfg_rows: &[359], note: \"nametable_scan: none/unique/duplicates, firstptr NULL\" },\n25\t    CfgCov { cfg_rows: &[360], note: \"number_from_name: unique / duplicate / absent\" },\n26\t    CfgCov { cfg_rows: &[361], note: \"*_byname on DFA match_data => DFA_UFUNC checked first\" },\n27\t    CfgCov { cfg_rows: &[362], note: \"*_byname DUPNAMES matrix, first-set scan order\" },\n28\t    CfgCov { cfg_rows: &[363], note: \"copy_byname exact/one-too-small + partial match_data\" },\n29\t    CfgCov { cfg_rows: &[364], note: \"substring_list_get with/without lengths, unset groups, free\" },\n30\t    // --- pattern_info\n31\t    CfgCov { cfg_rows: &[365], note: \"pattern_info NULL length query for every request code\" },\n32\t    CfgCov { cfg_rows: &[366], note: \"all 27 request codes on a rich DUPNAMES|UTF|CASELESS pattern\" },\n33\t    CfgCov { cfg_rows: &[367], note: \"FIRSTCODETYPE 1/2/0 and FIRSTCODEUNIT\" },\n34\t    CfgCov { cfg_rows: &[368], note: \"LASTCODETYPE / LASTCODEUNIT 1 vs 0\" },\n35\t    CfgCov { cfg_rows: &[369], note: \"FIRSTBITMAP non-NULL (32 bytes) vs NULL\" },\n36\t    CfgCov { cfg_rows: &[370], note: \"MATCHLIMIT/DEPTHLIMIT/HEAPLIMIT set vs UNSET-with-value\" },\n37\t    CfgCov { cfg_rows: &[371], note: \"JITSIZE always 0; FRAMESIZE vs top_bracket\" },\n38\t    CfgCov { cfg_rows: &[372], note: \"callout_enumerate over every opcode-skip arm\" },\n39\t    // --- serialize\n40\t    CfgCov { cfg_rows: &[373], note: \"1-code round trip, gcontext NULL, exact stream size\" },\n41\t    CfgCov { cfg_rows: &[374], note: \"many-code round trip; decode count <, ==, > stream count\" },\n42\t    CfgCov { cfg_rows: &[375], note: \"all codes sharing one pcre2_maketables block\" },\n43\t    CfgCov { cfg_rows: &[376], note: \"different custom allocators on encode and decode\" },\n44\t    CfgCov { cfg_rows: &[377], note: \"get_number_of_codes on 1- and 5-code streams\" },\n45\t    CfgCov { cfg_rows: &[378], note: \"decoded code fully usable: info/match/substitute/copy/enumerate\" },\n46\t    CfgCov { cfg_rows: &[379], note: \"serialize_free(NULL) no-op\" },\n47\t    // --- convert\n48\t    CfgCov { cfg_rows: &[380], note: \"GLOB basics with default separator and escape\" },\n49\t    CfgCov { cfg_rows: &[381], note: \"GLOB ** forms\" },\n50\t    CfgCov { cfg_rows: &[382], note: \"GLOB_NO_WILD_SEPARATOR / GLOB_NO_STARSTAR / both\" },\n51\t    CfgCov { cfg_rows: &[383], note: \"GLOB character classes\" },\n52\t    CfgCov { cfg_rows: &[384], note: \"GLOB negated class with NO_WILD_SEPARATOR (stale out_str byte)\" },\n53\t    CfgCov { cfg_rows: &[385], note: \"set_glob_separator / . x representative patterns\" },\n54\t    CfgCov { cfg_rows: &[386], note: \"set_glob_escape default / 0 / backtick, trailing lone escape\" },\n55\t    CfgCov { cfg_rows: &[387], note: \"escape+separator skip at **\" },\n56\t    CfgCov { cfg_rows: &[388], note: \"POSIX_BASIC full translation table\" },\n57\t    CfgCov { cfg_rows: &[389], note: \"POSIX_EXTENDED same inputs, asserting the differences\" },\n58\t    CfgCov { cfg_rows: &[390], note: \"valid option corners: glob-mod bits ignored by POSIX modes\" },\n59\t    CfgCov { cfg_rows: &[391], note: \"CONVERT_UTF for BASIC / EXTENDED / GLOB\" },\n60\t    CfgCov { cfg_rows: &[392], note: \"the three buffer protocols\" },\n61\t    CfgCov { cfg_rows: &[393], note: \"input shapes: NULL/0/ZERO_TERMINATED/embedded NUL/0xFF\" },\n62\t    CfgCov { cfg_rows: &[394], note: \"converted_pattern_free(NULL) no-op\" },\n63\t    // --- contexts / config / errors\n64\t    CfgCov { cfg_rows: &[395], note: \"general_context create/copy/free incl. partial allocator pairs\" },\n65\t    CfgCov { cfg_rows: &[396], note: \"compile_context create == defaults, copy, extra options\" },\n66\t    CfgCov { cfg_rows: &[397], note: \"match_context create == defaults, copy\" },\n67\t    CfgCov { cfg_rows: &[398], note: \"convert_context create == defaults, copy\" },\n68\t    CfgCov { cfg_rows: &[399], note: \"set_newline all 6 values observed via compile+match\" },\n69\t    CfgCov { cfg_rows: &[400], note: \"set_bsr both values observed via INFO_BSR and \\\\R\" },\n70\t    CfgCov { cfg_rows: &[401], note: \"set_optimize every legal directive, effect on bytecode\" },\n71\t    CfgCov { cfg_rows: &[402], note: \"set_glob_separator / set_glob_escape accepted value sets\" },\n72\t    CfgCov { cfg_rows: &[403], note: \"set_character_tables + maketables(+free), all table regions\" },\n73\t    CfgCov { cfg_rows: &[404], note: \"config NULL length query for every code\" },\n74\t    CfgCov { cfg_rows: &[405], note: \"config value query for every code\" },\n75\t    CfgCov { cfg_rows: &[406], note: \"get_error_message every code x buffer sizes incl. truncation\" },\n76\t];\n77\t\n78\t#[test]\n79\tfn coverage_declaration_is_sane() {\n80\t    check_coverage_decl(COVERAGE);\n81\t}\n82\t\n83\t// ------------------------------------------------------------------ helpers\n84\t\n85\tstruct Ctx {\n86\t    a: Ptr,\n87\t    b: Ptr,\n88\t}\n89\t\n90\tunsafe fn compile2(p: &Pair, pat: &[u8], opts: u32, cc: Option<&Ctx>) -> (Ptr, Ptr, c_int, c_int) {\n91\t    let (mut e1, mut e2) = (0 as c_int, 0 as c_int);\n92\t    let (mut f1, mut f2) = (0usize, 0usize);\n93\t    let (ca, cb) = cc.map_or((ptr::null_mut(), ptr::null_mut()), |c| (c.a, c.b));\n94\t    let a = (p.c.compile)(pat.as_ptr(), pat.len(), opts, &mut e1, &mut f1, ca);\n95\t    let b = (p.r.compile)(pat.as_ptr(), pat.len(), opts, &mut e2, &mut f2, cb);\n96\t    assert_eq!(a.is_null(), b.is_null(), \"compile {} nullness differs\", show(pat));\n97\t    assert_eq!(e1, e2, \"compile {} errorcode differs\", show(pat));\n98\t    assert_eq!(f1, f2, \"compile {} erroroffset differs\", show(pat));\n99\t    if !a.is_null() {\n100\t        assert_code_eq(a, b, &format!(\"compile {}\", show(pat)));\n101\t    }\n102\t    (a, b, e1, f1 as c_int)\n103\t}\n104\t\n105\t/// Every `pcre2_substring_*` accessor applied to a pair of match_data objects.\n106\tunsafe fn cmp_all_substring(p: &Pair, mda: Ptr, mdb: Ptr, ca: Ptr, cb: Ptr, top: u32, tag: &str, d: &mut Diffs) {\n107\t    for n in 0..=(top + 3) {\n108\t        let (mut la, mut lb) = (usize::MAX, usize::MAX);\n109\t        d.eq(\n110\t            &format!(\"{tag} length_bynumber({n}) rc\"),\n111\t            (p.c.substring_length_bynumber)(mda, n, &mut la),\n112\t            (p.r.substring_length_bynumber)(mdb, n, &mut lb),\n113\t        );\n114\t        d.eq(&format!(\"{tag} length_bynumber({n}) size\"), la, lb);\n115\t        // buffer sizes: 0, exactly-enough-1, exactly enough, generous\n116\t        let exact = if la != usize::MAX { la } else { 0 };\n117\t        for cap in [0usize, exact, exact + 1, exact + 8, 256] {\n118\t            let mut ba = vec![0xEEu8; cap + 16];\n119\t            let mut bb = vec![0xEEu8; cap + 16];\n120\t            let (mut sa, mut sb) = (cap, cap);\n121\t            d.eq(\n122\t                &format!(\"{tag} copy_bynumber({n}, cap={cap}) rc\"),\n123\t                (p.c.substring_copy_bynumber)(mda, n, ba.as_mut_ptr(), &mut sa),\n124\t                (p.r.substring_copy_bynumber)(mdb, n, bb.as_mut_ptr(), &mut sb),\n125\t            );\n126\t            d.eq(&format!(\"{tag} copy_bynumber({n}, cap={cap}) size\"), sa, sb);\n127\t            d.eq(&format!(\"{tag} copy_bynumber({n}, cap={cap}) buf\"), ba, bb);\n128\t        }\n129\t        let (mut pa, mut pb) = (ptr::null_mut::<u8>(), ptr::null_mut::<u8>());\n130\t        let (mut ga, mut gb) = (usize::MAX, usize::MAX);\n131\t        let qa = (p.c.substring_get_bynumber)(mda, n, &mut pa, &mut ga);\n132\t        let qb = (p.r.substring_get_bynumber)(mdb, n, &mut pb, &mut gb);\n133\t        d.eq(&format!(\"{tag} get_bynumber({n}) rc\"), qa, qb);\n134\t        d.eq(&format!(\"{tag} get_bynumber({n}) size\"), ga, gb);\n135\t        if qa == 0 && qb == 0 {\n136\t            d.eq(\n137\t                &format!(\"{tag} get_bynumber({n}) bytes+NUL\"),\n138\t                std::slice::from_raw_parts(pa, ga + 1).to_vec(),\n139\t                std::slice::from_raw_parts(pb, gb + 1).to_vec(),\n140\t            );\n141\t        }\n142\t        if !pa.is_null() {\n143\t            (p.c.substring_free)(pa);\n144\t        }\n145\t        if !pb.is_null() {\n146\t            (p.r.substring_free)(pb);\n147\t        }\n148\t    }\n149\t    // list form, with and without lengths\n150\t    for want_lengths in [true, false] {\n151\t        let (mut la, mut lb) = (ptr::null_mut(), ptr::null_mut());\n152\t        let (mut sa, mut sb): (*mut Sz, *mut Sz) = (ptr::null_mut(), ptr::null_mut());\n153\t        let (pla, plb) = if want_lengths {\n154\t            (&mut sa as *mut _, &mut sb as *mut _)\n155\t        } else {\n156\t            (ptr::null_mut(), ptr::null_mut())\n157\t        };\n158\t        let ra = (p.c.substring_list_get)(mda, &mut la, pla);\n159\t        let rb = (p.r.substring_list_get)(mdb, &mut lb, plb);\n160\t        d.eq(&format!(\"{tag} list_get(lengths={want_lengths}) rc\"), ra, rb);\n161\t        if ra == 0 && rb == 0 {\n162\t            // count = rc if > 0 else oveccount (see pcre2_substring.c)\n163\t            let mdrc = (p.c.substring_length_bynumber)(mda, 0, &mut 0usize);\n164\t            let _ = mdrc;\n165\t            let cnt = {\n166\t                let mut n = 0usize;\n167\t                while !(*la.add(n)).is_null() && n < 1024 {\n168\t                    n += 1;\n169\t                }\n170\t                n\n171\t            };\n172\t            let cntb = {\n173\t                let mut n = 0usize;\n174\t                while !(*lb.add(n)).is_null() && n < 1024 {\n175\t                    n += 1;\n176\t                }\n177\t                n\n178\t            };\n179\t            d.eq(&format!(\"{tag} list_get entry count\"), cnt, cntb);\n180\t            for i in 0..cnt.min(cntb) {\n181\t                if want_lengths {\n182\t                    let (nx, ny) = (*sa.add(i), *sb.add(i));\n183\t                    d.eq(&format!(\"{tag} list[{i}] len\"), nx, ny);\n184\t                    if nx == ny {\n185\t                        d.eq(\n186\t                            &format!(\"{tag} list[{i}] bytes\"),\n187\t                            std::slice::from_raw_parts(*la.add(i), nx).to_vec(),\n188\t                            std::slice::from_raw_parts(*lb.add(i), ny).to_vec(),\n189\t                        );\n190\t                    }\n191\t                } else {\n192\t                    // NUL-term