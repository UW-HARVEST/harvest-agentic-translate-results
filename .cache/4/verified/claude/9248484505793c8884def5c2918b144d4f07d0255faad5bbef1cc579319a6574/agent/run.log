extern \"C\" fn(Ptr) -> Sz,\n362\t    next_match: \"pcre2_next_match_8\": unsafe extern \"C\" fn(Ptr, *mut Sz, *mut u32) -> c_int,\n363\t\n364\t    // ---- substring\n365\t    substring_copy_byname: \"pcre2_substring_copy_byname_8\":\n366\t        unsafe extern \"C\" fn(Ptr, Sptr, *mut u8, *mut Sz) -> c_int,\n367\t    substring_copy_bynumber: \"pcre2_substring_copy_bynumber_8\":\n368\t        unsafe extern \"C\" fn(Ptr, u32, *mut u8, *mut Sz) -> c_int,\n369\t    substring_free: \"pcre2_substring_free_8\": unsafe extern \"C\" fn(*mut u8),\n370\t    substring_get_byname: \"pcre2_substring_get_byname_8\":\n371\t        unsafe extern \"C\" fn(Ptr, Sptr, *mut *mut u8, *mut Sz) -> c_int,\n372\t    substring_get_bynumber: \"pcre2_substring_get_bynumber_8\":\n373\t        unsafe extern \"C\" fn(Ptr, u32, *mut *mut u8, *mut Sz) -> c_int,\n374\t    substring_length_byname: \"pcre2_substring_length_byname_8\":\n375\t        unsafe extern \"C\" fn(Ptr, Sptr, *mut Sz) -> c_int,\n376\t    substring_length_bynumber: \"pcre2_substring_length_bynumber_8\":\n377\t        unsafe extern \"C\" fn(Ptr, u32, *mut Sz) -> c_int,\n378\t    substring_nametable_scan: \"pcre2_substring_nametable_scan_8\":\n379\t        unsafe extern \"C\" fn(Ptr, Sptr, *mut Sptr, *mut Sptr) -> c_int,\n380\t    substring_number_from_name: \"pcre2_substring_number_from_name_8\":\n381\t        unsafe extern \"C\" fn(Ptr, Sptr) -> c_int,\n382\t    substring_list_free: \"pcre2_substring_list_free_8\": unsafe extern \"C\" fn(*mut *mut u8),\n383\t    substring_list_get: \"pcre2_substring_list_get_8\":\n384\t        unsafe extern \"C\" fn(Ptr, *mut *mut *mut u8, *mut *mut Sz) -> c_int,\n385\t\n386\t    // ---- serialize\n387\t    serialize_encode: \"pcre2_serialize_encode_8\":\n388\t        unsafe extern \"C\" fn(*const Ptr, i32, *mut *mut u8, *mut Sz, Ptr) -> i32,\n389\t    serialize_decode: \"pcre2_serialize_decode_8\":\n390\t        unsafe extern \"C\" fn(*mut Ptr, i32, *const u8, Ptr) -> i32,\n391\t    serialize_get_number_of_codes: \"pcre2_serialize_get_number_of_codes_8\":\n392\t        unsafe extern \"C\" fn(*const u8) -> i32,\n393\t    serialize_free: \"pcre2_serialize_free_8\": unsafe extern \"C\" fn(*mut u8),\n394\t\n395\t    // ---- substitute\n396\t    substitute: \"pcre2_substitute_8\":\n397\t        unsafe extern \"C\" fn(Ptr, Sptr, Sz, Sz, u32, Ptr, Ptr, Sptr, Sz, *mut u8, *mut Sz) -> c_int,\n398\t\n399\t    // ---- convert\n400\t    pattern_convert: \"pcre2_pattern_convert_8\":\n401\t        unsafe extern \"C\" fn(Sptr, Sz, u32, *mut *mut u8, *mut Sz, Ptr) -> c_int,\n402\t    converted_pattern_free: \"pcre2_converted_pattern_free_8\": unsafe extern \"C\" fn(*mut u8),\n403\t\n404\t    // ---- JIT (no-JIT stubs in this configuration)\n405\t    jit_compile: \"pcre2_jit_compile_8\": unsafe extern \"C\" fn(Ptr, u32) -> c_int,\n406\t    jit_match: \"pcre2_jit_match_8\":\n407\t        unsafe extern \"C\" fn(Ptr, Sptr, Sz, Sz, u32, Ptr, Ptr) -> c_int,\n408\t    jit_free_unused_memory: \"pcre2_jit_free_unused_memory_8\": unsafe extern \"C\" fn(Ptr),\n409\t    jit_stack_create: \"pcre2_jit_stack_create_8\": unsafe extern \"C\" fn(usize, usize, Ptr) -> Ptr,\n410\t    jit_stack_assign: \"pcre2_jit_stack_assign_8\": unsafe extern \"C\" fn(Ptr, Ptr, Ptr),\n411\t    jit_stack_free: \"pcre2_jit_stack_free_8\": unsafe extern \"C\" fn(Ptr),\n412\t\n413\t    // ---- exported low-level internals\n414\t    p_valid_utf: \"_pcre2_valid_utf_8\": unsafe extern \"C\" fn(Sptr, Sz, *mut Sz) -> c_int,\n415\t    p_ord2utf: \"_pcre2_ord2utf_8\": unsafe extern \"C\" fn(u32, *mut u8) -> std::ffi::c_uint,\n416\t    p_strlen: \"_pcre2_strlen_8\": unsafe extern \"C\" fn(Sptr) -> Sz,\n417\t    p_strcmp: \"_pcre2_strcmp_8\": unsafe extern \"C\" fn(Sptr, Sptr) -> c_int,\n418\t    p_strcmp_c8: \"_pcre2_strcmp_c8_8\": unsafe extern \"C\" fn(Sptr, *const c_char) -> c_int,\n419\t    p_strncmp: \"_pcre2_strncmp_8\": unsafe extern \"C\" fn(Sptr, Sptr, usize) -> c_int,\n420\t    p_strncmp_c8: \"_pcre2_strncmp_c8_8\": unsafe extern \"C\" fn(Sptr, *const c_char, usize) -> c_int,\n421\t    p_strcpy_c8: \"_pcre2_strcpy_c8_8\": unsafe extern \"C\" fn(*mut u8, *const c_char) -> Sz,\n422\t    p_ckd_smul: \"_pcre2_ckd_smul_8\": unsafe extern \"C\" fn(*mut Sz, c_int, c_int) -> Bool,\n423\t    p_is_newline: \"_pcre2_is_newline_8\":\n424\t        unsafe extern \"C\" fn(Sptr, u32, Sptr, *mut u32, Bool) -> Bool,\n425\t    p_was_newline: \"_pcre2_was_newline_8\":\n426\t        unsafe extern \"C\" fn(Sptr, u32, Sptr, *mut u32, Bool) -> Bool,\n427\t    p_extuni: \"_pcre2_extuni_8\":\n428\t        unsafe extern \"C\" fn(u32, Sptr, Sptr, Sptr, Bool, *mut c_int) -> Sptr,\n429\t    p_script_run: \"_pcre2_script_run_8\": unsafe extern \"C\" fn(Sptr, Sptr, Bool) -> Bool,\n430\t    p_xclass: \"_pcre2_xclass_8\": unsafe extern \"C\" fn(u32, Sptr, *const u8, Bool) -> Bool,\n431\t    p_eclass: \"_pcre2_eclass_8\": unsafe extern \"C\" fn(u32, Sptr, Sptr, *const u8, Bool) -> Bool,\n432\t    p_find_bracket: \"_pcre2_find_bracket_8\": unsafe extern \"C\" fn(Sptr, Bool, c_int) -> Sptr,\n433\t    p_update_classbits: \"_pcre2_update_classbits_8\":\n434\t        unsafe extern \"C\" fn(u32, u32, Bool, *mut u8),\n435\t    p_get_hash_from_name: \"_pcre2_compile_get_hash_from_name8\":\n436\t        unsafe extern \"C\" fn(Sptr, u32) -> u16,\n437\t    p_study: \"_pcre2_study_8\": unsafe extern \"C\" fn(Ptr) -> c_int,\n438\t    p_memctl_malloc: \"_pcre2_memctl_malloc_8\": unsafe extern \"C\" fn(usize, Ptr) -> Ptr,\n439\t    p_jit_get_size: \"_pcre2_jit_get_size_8\": unsafe extern \"C\" fn(Ptr) -> usize,\n440\t    p_jit_get_target: \"_pcre2_jit_get_target_8\": unsafe extern \"C\" fn() -> *const c_char,\n441\t    p_jit_free: \"_pcre2_jit_free_8\": unsafe extern \"C\" fn(Ptr, Ptr),\n442\t    p_jit_free_rodata: \"_pcre2_jit_free_rodata_8\": unsafe extern \"C\" fn(Ptr, Ptr),\n443\t    p_auto_possessify: \"_pcre2_auto_possessify_8\": unsafe extern \"C\" fn(*mut u8, Ptr) -> c_int,\n444\t}\n445\t\n446\t// ----------------------------------------------------------------- loading\n447\t\n448\tfn crate_root() -> PathBuf {\n449\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n450\t}\n451\t\n452\tfn require(p: PathBuf, what: &str) -> PathBuf {\n453\t    assert!(\n454\t        p.exists(),\n455\t        \"{} shared library not found at {}\\n\\\n456\t         Build it first:\\n  C:    cd c_src && mkdir -p build && cd build && \\\n457\t         cmake .. -DCMAKE_POSITION_INDEPENDENT_CODE=ON && cmake --build .\\n  \\\n458\t         Rust: cargo build --release\",\n459\t        what,\n460\t        p.display()\n461\t    );\n462\t    p\n463\t}\n464\t\n465\t/// The pair of libraries under test.\n466\tpub struct Pair {\n467\t    pub c: Api,\n468\t    pub r: Api,\n469\t}\n470\t\n471\tstatic mut PAIR: Option<Pair> = None;\n472\tstatic ONCE: std::sync::Once = std::sync::Once::new();\n473\t\n474\t/// Load (once per test binary) the C and the Rust `.so`.\n475\tpub fn pair() -> &'static Pair {\n476\t    unsafe {\n477\t        ONCE.call_once(|| {\n478\t            let root = crate_root();\n479\t            let c_path = require(root.join(\"c_src/build/libpcre2.so\"), \"C\");\n480\t            // Prefer the release cdylib: the release profile is the one that\n481\t            // disables overflow checks / debug assertions, matching C.\n482\t            let rel = root.join(\"target/release/libpcre2.so\");\n483\t            let dbg = root.join(\"target/debug/libpcre2.so\");\n484\t            let r_path = if rel.exists() { rel } else { require(dbg, \"Rust\") };\n485\t            PAIR = Some(Pair {\n486\t                c: Api::load(\"C\", &c_path),\n487\t                r: Api::load(\"rust\", &r_path),\n488\t            });\n489\t        });\n490\t        #[allow(static_mut_refs)]\n491\t        PAIR.as_ref().unwrap()\n492\t    }\n493\t}\n494\t\n495\t// ------------------------------------------------------------- tiny PRNG\n496\t\n497\t/// SplitMix64 — deterministic, seedable, no external crates.\n498\tpub struct Rng(pub u64);\n499\t\n500\timpl Rng {\n501\t    pub fn new(seed: u64) -> Rng {\n502\t        Rng(seed ^ 0x9E37_79B9_7F4A_7C15)\n503\t    }\n504\t    pub fn next_u64(&mut self) -> u64 {\n505\t        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);\n506\t        let mut z = self.0;\n507\t        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);\n508\t        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);\n509\t        z ^ (z >> 31)\n510\t    }\n511\t    pub fn next_u32(&mut self) -> u32 {\n512\t        (self.next_u64() >> 32) as u32\n513\t    }\n514\t    /// Uniform in `0..n` (n > 0).\n515\t    pub fn below(&mut self, n: usize) -> usize {\n516\t        (self.next_u64() % (n as u64)) as usize\n517\t    }\n518\t    pub fn range(&mut self, lo: usize, hi_incl: usize) -> usize {\n519\t        lo + self.below(hi_incl - lo + 1)\n520\t    }\n521\t    pub fn byte(&mut self) -> u8 {\n522\t        (self.next_u64() >> 24) as u8\n523\t    }\n524\t    pub fn chance(&mut self, one_in: usize) -> bool {\n525\t        self.below(one_in) == 0\n526\t    }\n527\t    pub fn pick<'a, T>(&mut self, xs: &'a [T]) -> &'a T {\n528\t        &xs[self.below(xs.len())]\n529\t    }\n530\t    /// `pick` for slices-of-slices, returning the inner slice directly.\n531\t    pub fn pick_bytes<'a>(&mut self, xs: &[&'a [u8]]) -> &'a [u8] {\n532\t        xs[self.below(xs.len())]\n533\t    }\n534\t}\n535\t\n536\t// ------------------------------------------------------- subject generators\n537\t\n538\t/// Random ASCII-ish bytes drawn from a small alphabet: produces plenty of\n539\t/// matches instead of mostly-NOMATCH noise.\n540\tpub fn gen_ascii(rng: &mut Rng, max_len: usize) -> Vec<u8> {\n541\t    const AL: &[u8] = b\"aAbBcC01 \\t\\r\\n_-.:;xyzZ&@#\";\n542\t    let n = rng.below(max_len + 1);\n543\t    (0..n).map(|_| *rng.pick(AL)).collect()\n544\t}\n545\t\n546\t/// Random *valid* UTF-8 covering 1/2/3/4-byte forms.\n547\tpub fn gen_utf8(rng: &mut Rng, max_chars: usize) -> Vec<u8> {\n548\t    let n = rng.below(max_chars + 1);\n549\t    let mut out = Vec::new();\n550\t    for _ in 0..n {\n551\t        let cp: u32 = match rng.below(10) {\n552\t            0..=3 => rng.range(0x20, 0x7e) as u32,\n553\t            4..=5 => rng.range(0x80, 0x7ff) as u32,\n554\t            6..=7 => {\n555\t                // avoid surrogates\n556\t                let v = rng.range(0x800, 0xffff) as u32;\n557\t                if (0xd800..=0xdfff).contains(&v) {\n558\t                    0x2028\n559\t                } else {\n560\t                    v\n561\t                }\n562\t            }\n563\t            _ => rng.range(0x1_0000, 0x10_ffff) as u32,\n564\t        };\n565\t        let mut buf = [0u8; 4];\n566\t        let s = char::from_u32(cp).unwrap_or('?').encode_utf8(&mut buf);\n567\t        out.extend_from_slice(s.as_bytes());\n568\t    }\n569\t    out\n570\t}\n571\t\n572\t/// Random bytes, mostly invalid UTF-8 — for the UTF validity checks.\n573\tpub fn gen_raw(rng: &mut Rng, max_len: usize) -> Vec<u8> {\n574\t    let n = rng.below(max_len + 1);\n575\t    (0..n).map(|_| rng.byte()).collect()\n576\t}\n577\t\n578\t// ------------------------------------------------------------ comparators\n579\t\n580\t/// The PCRE2 `pcre2_code` magic ('PCRE'), used to self-check the layout below.\n581\tpub const MAGIC_NUMBER: u32 = 0x5043_5245;\n582\t\n583\t/// Compiled-code accessors. Mirrors `pcre2_real_code` from\n584\t/// `c_src/src/pcre2_intmodedep.h`, where\n585\t/// `#define CODE_BLOCKSIZE_TYPE PCRE2_SIZE`, i.e. `usize` — NOT `uint32_t`.\n586\t#[repr(C)]\n587\tpub struct RealCodeHead {\n588\t    pub memctl_malloc: *mut c_void,\n589\t    pub memctl_free: *mut c_void,\n590\t    pub memctl_data: *mut c_void,\n591\t    pub tables: *const u8,\n592\t    pub executable_jit: *mut c_void,\n593\t    pub start_bitmap: [u8; 32],\n594\t    pub blocksize: usize,\n595\t    pub code_start: usize,\n596\t    pub magic_number: u32,\n597\t    pub compile_options: u32,\n598\t    pub overall_options: u32,\n599\t    pub extra_options: u32,\n600\t    pub flags: u32,\n601\t    pub limit_heap: u32,\n602\t    pub limit_match: u32,\n603\t    pub limit_depth: u32,\n604\t    pub first_codeunit: u32,\n605\t    pub last_codeunit: u32,\n606\t    pub bsr_convention: u16,\n607\t    pub newline_convention: u16,\n608\t    pub max_lookbehind: u16,\n609\t    pub minlength: u16,\n610\t    pub top_bracket: u16,\n611\t    pub top_backref: u16,\n612\t    pub name_entry_size: u16,\n613\t    pub name_count: u16,\n614\t    pub optimization_flags: u32,\n615\t}\n616\t\n617\t/// Pointer to the first byte of compiled bytecode inside a `pcre2_code`.\n618\tpub unsafe fn bytecode_ptr(code: Ptr) -> Sptr {\n619\t    let head = check_head(code);\n620\t    (code as *const u8).add(head.code_start)\n621\t}\n622\t\n623\tpub unsafe fn code_blocksize(code: Ptr) -> usize {\n624\t    check_head(code).blocksize\n625\t}\n626\t\n627\t/// Validates that `RealCodeHead` really does describe this `pcre2_code` before\n628\t/// any offset derived from it is used — a silently wrong layout would make the\n629\t/// bytecode comparison meaningless.\n630\tpub unsafe fn check_head(code: Ptr) -> &'static RealCodeHead {\n631\t    let h = &*(code as *const RealCodeHead);\n632\t    assert_eq!(\n633\t        h.magic_number, MAGIC_NUMBER,\n634\t        \"RealCodeHead layout is wrong: magic_number read as {:#x}, expected {:#x}\",\n635\t        h.magic_number, MAGIC_NUMBER\n636\t    );\n637\t    assert!(\n638\t        h.code_start >= std::mem::size_of::<RealCodeHead>() && h.code_start < h.blocksize,\n639\t        \"implausible code_start={} (blocksize={}, sizeof head={})\",\n640\t        h.code_start,\n641\t        h.blocksize,\n642\t        std::mem::size_of::<RealCodeHead>()\n643\t    );\n644\t    h\n645\t}\n646\t\n647\t/// Byte-for-byte comparison of two compiled patterns, skipping only the fields\n648\t/// that legitimately hold host addresses (allocator pointers, tables pointer,\n649\t/// JIT pointer).\n650\t/// `PCRE2_DEREF_TABLES` from `pcre2_internal.h`: set by\n651\t/// `pcre2_serialize_decode` because the character tables are then part of the\n652\t/// code block and must be released with it.\n653\tpub const PCRE2_DEREF_TABLES: u32 = 0x0004_0000;\n654\t\n655\tpub unsafe fn assert_code_eq(a: Ptr, b: Ptr, ctx: &str) {\n656\t    assert_code_eq_masked(a, b, 0, ctx)\n657\t}\n658\t\n659\t/// As `assert_code_eq`, but `allow_flags` names flag bits that are permitted to\n660\t/// differ (and must differ exactly in that way).\n661\tpub unsafe fn assert_code_eq_masked(a: Ptr, b: Ptr, allow_flags: u32, ctx: &str) {\n662\t    if allow_flags != 0 {\n663\t        let (ha, hb) = (&*(a as *const RealCodeHead), &*(b as *const RealCodeHead));\n664\t        assert_eq!(\n665\t            ha.flags & !allow_flags,\n666\t            hb.flags & !allow_flags,\n667\t            \"{ctx}: `flags` differ outside the permitted mask {allow_flags:#x} \\\n668\t             (a={:#x} b={:#x})\",\n669\t            ha.flags,\n670\t            hb.flags\n671\t        );\n672\t    }\n673\t    assert_code_eq_inner(a, b, allow_flags, ctx)\n674\t}\n675\t\n676\tunsafe fn assert_code_eq_inner(a: Ptr, b: Ptr, allow_flags: u32, ctx: &str) {\n677\t    let (ha, hb) = (a as *const RealCodeHead, b as *const RealCodeHead);\n678\t    let (sa, sb) = (code_blocksize(a), code_blocksize(b));\n679\t    assert_eq!(sa, sb, \"{ctx}: blocksize differs (C={sa} rust={sb})\");\n680\t    assert_eq!(\n681\t        (*ha).code_start,\n682\t        (*hb).code_start,\n683\t        \"{ctx}: code_start differs\"\n684\t    );\n685\t\n686\t    macro_rules! f {\n687\t        ($($n:ident),*) => { $(\n688\t            assert_eq!((*ha).$n, (*hb).$n, \"{}: field `{}` differs\", ctx, stringify!($n));\n689\t        )* };\n690\t    }\n691\t    f!(\n692\t        start_bitmap,\n693\t        blocksize,\n694\t        code_start,\n695\t        magic_number,\n696\t        compile_options,\n697\t        overall_options,\n698\t        extra_options,\n699\t        limit_heap,\n700\t        limit_match,\n701\t        limit_depth,\n702\t        first_codeunit,\n703\t        last_codeunit,\n704\t        bsr_convention,\n705\t        newline_convention,\n706\t        max_lookbehind,\n707\t        minlength,\n708\t        top_bracket,\n709\t        top_backref,\n710\t        name_entry_size,\n711\t        name_count,\n712\t        optimization_flags\n713\t    );\n714\t    // `flags` is compared outside the permitted mask (see assert_code_eq_masked)\n715\t    assert_eq!(\n716\t        (*ha).flags & !allow_flags,\n717\t        (*hb).flags & !allow_flags,\n718\t        \"{ctx}: field `flags` differs (a={:#x} b={:#x}, permitted mask {allow_flags:#x})\",\n719\t        (*ha).flags,\n720\t        (*hb).flags\n721\t    );\n722\t\n723\t    // everything from code_start to blocksize: name table + bytecode\n724\t    let off = (*ha).code_start as usize;\n725\t    let ba = std::slice::from_raw_parts((a as *const u8).add(off), sa - off);\n726\t    let bb = std::slice::from_raw_parts((b as *const u8).add(off), sa - off);\n727\t    if ba != bb {\n728\t        let at = ba.iter().zip(bb).position(|(x, y)| x != y).unwrap();\n729\t        panic!(\n730\t            \"{ctx}: bytecode differs at offset {at} (abs {}) \\nC   ={:02x?}\\nrust={:02x?}\",\n731\t            off + at,\n732\t            &ba[at.saturating_sub(8)..(at + 24).min(ba.len())],\n733\t            &bb[at.saturating_sub(8)..(at + 24).min(bb.len())],\n734\t        );\n735\t    }\n736\t}\n737\t\n738\t/// Result of one match call, in a comparable form.\n739\t#[derive(Debug, PartialEq, Eq, Clone)]\n740\tpub struct MatchOut {\n741\t    pub rc: c_int,\n742\t    pub ovector: Vec<Sz>,\n743\t    /// `None` when the C leaves it undefined for this return code.\n744\t    pub startchar: Option<Sz>,\n745\t    pub mark: Option<Vec<u8>>,\n746\t}\n747\t\n748\t/// Reads only the parts of a `pcre2_match_data` that the C actually DEFINES for\n749\t/// the given return code.\n750\t///\n751\t/// `pcre2_match_data_create` does not zero the ovector, `mark` or `startchar`;\n752\t/// the matchers write only a documented prefix/subset. Comparing beyond that\n753\t/// would be comparing whatever the allocator happened to hand over, which\n754\t/// differs between the two libraries for reasons that are not behaviour.\n755\t///\n756\t///   * `rc > 0`  — the first `2*rc` ovector entries\n757\t///     (`rc = end_offset_top/2 + 1`, see `pcre2_match.c`).\n758\t///   * `rc == 0` — the ovector was too small, so all `2*oveccount` are written.\n759\t///   * `rc == PCRE2_ERROR_PARTIAL` — `ovector[0]` and `ovector[1]` only.\n760\t///   * any other `rc < 0` — no ovector entry is written.\n761\t///\n762\t/// `startchar` is zeroed just after argument validation and then written by the\n763\t/// matcher and by the UTF validity check, so it is defined for success,\n764\t/// NOMATCH, PARTIAL and the UTF error codes, but not for the early\n765\t/// argument-validation errors. `mark` is written only on the success / NOMATCH /\n766\t/// PARTIAL paths.\n767\t/// Which matcher produced the result — they define different fields.\n768\t#[derive(Copy, Clone, PartialEq, Eq, Debug)]\n769\tpub enum Engine {\n770\t    /// `pcre2_match_8`: zeroes `startchar` right after argument validation, so\n771\t    /// it is defined for NOMATCH too.\n772\t    Match,\n773\t    /// `pcre2_dfa_match_8`: assigns `startchar` only on success and on a UTF\n774\t    /// error, never on NOMATCH.\n775\t    Dfa,\n776\t}\n777\t\n778\tpub unsafe fn read_match_out(api: &Api, md: Ptr, rc: c_int) -> MatchOut {\n779\t    read_match_out_of(api, md, rc, Engine::Match)\n780\t}\n781\t\n782\tpub unsafe fn read_match_out_of(api: &Api, md: Ptr, rc: c_int, engine: Engine) -> MatchOut {\n783\t    let oveccount = (api.get_ovector_count)(md) as usize;\n784\t    let ov = (api.get_ovector_pointer)(md);\n785\t    let n = if rc > 0 {\n786\t        (2 * rc as usize).min(2 * oveccount)\n787\t    } else if rc == 0 {\n788\t        2 * oveccount\n789\t    } else if rc == PCRE2_ERROR_PARTIAL {\n790\t        2.min(2 * oveccount)\n791\t    } else {\n792\t        0\n793\t    };\n794\t    let ovector = std::slice::from_raw_parts(ov, n).to_vec();\n795\t    let matcher_ran = rc >= 0 || rc == PCRE2_ERROR_NOMATCH || rc == PCRE2_ERROR_PARTIAL;\n796\t    // UTF validity errors (-3 .. -28) return early but do set startchar to the\n797\t    // offset of the bad code unit.\n798\t    let startchar_defined = match engine {\n799\t        Engine::Match => matcher_ran || (-28..=-3).contains(&rc),\n800\t        Engine::Dfa => rc >= 0 || rc == PCRE2_ERROR_PARTIAL || (-28..=-3).contains(&rc),\n801\t    };\n802\t    let markp = if matcher_ran { (api.get_mark)(md) } else { ptr::null() };\n803\t    let mark = if markp.is_null() {\n804\t        None\n805\t    } else {\n806\t        let mut v = Vec::new();\n807\t        let mut p = markp;\n808\t        while *p != 0 && v.len() < 4096 {\n809\t            v.push(*p);\n810\t            p = p.add(1);\n811\t        }\n812\t        Some(v)\n813\t    };\n814\t    MatchOut {\n815\t        rc,\n816\t        ovector,\n817\t        startchar: if startchar_defined {\n818\t            Some((api.get_startchar)(md))\n819\t        } else {\n820\t            None\n821\t        },\n822\t        mark,\n823\t    }\n824\t}\n825\t\n826\t// -------------------------------------------------------------- reporting\n827\t\n828\t/// Collects failures so a whole configuration row can be reported at once\n829\t/// instead of aborting on the first randomized input.\n830\t#[derive(Default)]\n831\tpub struct Diffs {\n832\t    pub rows: Vec<String>,\n833\t    pub checked: usize,\n834\t}\n835\t\n836\timpl Diffs {\n837\t    pub fn new() -> Diffs {\n838\t        Diffs::default()\n839\t    }\n840\t    pub fn eq<T: PartialEq + std::fmt::Debug>(&mut self, what: &str, c: T, r: T) {\n841\t        self.checked += 1;\n842\t        if c != r {\n843\t            if self.rows.len() < 25 {\n844\t                self.rows.push(format!(\"{what}\\n     C = {c:?}\\n  rust = {r:?}\"));\n845\t            }\n846\t        }\n847\t    }\n848\t    pub fn finish(self, row: &str) {\n849\t        if !self.rows.is_empty() {\n850\t            panic!(\n851\t                \"CONFIGS row [{}]: {} of {} randomized inputs diverged:\\n\\n{}\",\n852\t                row,\n853\t                self.rows.len(),\n854\t                self.checked,\n855\t                self.rows.join(\"\\n\\n\")\n856\t            );\n857\t        }\n858\t        assert!(self.checked > 0, \"row [{row}] asserted nothing\");\n859\t    }\n860\t}\n861\t\n862\t/// Escape a byte string for readable failure messages.\n863\tpub fn show(b: &[u8]) -> String {\n864\t    let mut s = String::from(\"\\\"\");\n865\t    for &c in b {\n866\t        match c {\n867\t            b'\\\\' => s.push_str(\"\\\\\\\\\"),\n868\t            b'\"' => s.push_str(\"\\\\\\\"\"),\n869\t            b'\\n' => s.push_str(\"\\\\n\"),\n870\t            b'\\r' => s.push_str(\"\\\\r\"),\n871\t            b'\\t' => s.push_str(\"\\\\t\"),\n872\t            0x20..=0x7e => s.push(c as char),\n873\t            _ => s.push_str(&format!(\"\\\\x{c:02x}\")),\n874\t        }\n875\t    }\n876\t    s.push('\"');\n877\t    s\n878\t}\n879\t\n880\t// ============================================================ pattern corpus\n881\t\n882\t/// Patterns chosen to reach the distinct compile/match code paths: every\n883\t/// quantifier form, class form, assertion form, group form, escape form, verb,\n884\t/// and the Unicode-specific constructs.\n885\tpub const PATTERNS: &[&str] = &[\n886\t    // --- literals / empty / anchors\n887\t    \"\",\n888\t    \"a\",\n889\t    \"abc\",\n890\t    \"^abc$\",\n891\t    \"\\\\Aabc\\\\z\",\n892\t    \"\\\\Aabc\\\\Z\",\n893\t    \"\\\\Gabc\",\n894\t    \"^\",\n895\t    \"$\",\n896\t    \"\\\\b\",\n897\t    \"\\\\Babc\",\n898\t    // --- alternation\n899\t    \"a|b\",\n900\t    \"abc|abd|abe\",\n901\t    \"(?:a|b|c)+\",\n902\t    \"|a\",\n903\t    \"a|