{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01AKbsv3sWAXKazqzVxQVED2","type":"tool_result","content":"1\t// Phase B — the LOWEST-level exported entry points, called directly through\n2\t// both `.so`s.  These are the leaves the whole engine is built on, so they are\n3\t// driven with many randomized inputs (fixed seed) rather than one value each.\n4\t\n5\tmod common;\n6\tuse common::*;\n7\tuse std::ffi::{c_char, c_int, CStr};\n8\tuse std::ptr;\n9\t\n10\tconst N: usize = 4000;\n11\t\n12\t// ===================================================================== strings\n13\t\n14\t// CONFIGS row: _pcre2_strlen_8 — empty / 1 / many, embedded high bytes.\n15\t#[test]\n16\tfn strlen() {\n17\t    let p = pair();\n18\t    let mut rng = Rng::new(1);\n19\t    let mut d = Diffs::new();\n20\t    for _ in 0..N {\n21\t        let mut s = gen_raw(&mut rng, 40);\n22\t        s.retain(|&b| b != 0); // NUL terminated: no interior NULs\n23\t        s.push(0);\n24\t        unsafe {\n25\t            d.eq(\n26\t                &format!(\"strlen({})\", show(&s)),\n27\t                (p.c.p_strlen)(s.as_ptr()),\n28\t                (p.r.p_strlen)(s.as_ptr()),\n29\t            );\n30\t        }\n31\t    }\n32\t    d.finish(\"_pcre2_strlen_8: random NUL-terminated strings, len 0..40\");\n33\t}\n34\t\n35\t// CONFIGS row: _pcre2_strcmp_8 — equal / prefix / differing, all byte values.\n36\t#[test]\n37\tfn strcmp() {\n38\t    let p = pair();\n39\t    let mut rng = Rng::new(2);\n40\t    let mut d = Diffs::new();\n41\t    let mk = |rng: &mut Rng| {\n42\t        let mut s = gen_ascii(rng, 12);\n43\t        s.retain(|&b| b != 0);\n44\t        s.push(0);\n45\t        s\n46\t    };\n47\t    for _ in 0..N {\n48\t        let a = mk(&mut rng);\n49\t        // half the time compare against a mutated copy so equality/prefix\n50\t        // relationships actually occur\n51\t        let b = if rng.chance(2) {\n52\t            let mut b = a.clone();\n53\t            if b.len() > 1 && rng.chance(2) {\n54\t                let i = rng.below(b.len() - 1);\n55\t                b[i] = rng.byte().max(1);\n56\t            }\n57\t            if rng.chance(3) && b.len() > 1 {\n58\t                b.truncate(b.len() - 1);\n59\t                b.push(0);\n60\t            }\n61\t            b\n62\t        } else {\n63\t            mk(&mut rng)\n64\t        };\n65\t        unsafe {\n66\t            let (ca, cb) = ((p.c.p_strcmp)(a.as_ptr(), b.as_ptr()), (p.r.p_strcmp)(a.as_ptr(), b.as_ptr()));\n67\t            d.eq(&format!(\"strcmp({},{})\", show(&a), show(&b)), ca, cb);\n68\t            let n = rng.below(14);\n69\t            d.eq(\n70\t                &format!(\"strncmp({},{},{n})\", show(&a), show(&b)),\n71\t                (p.c.p_strncmp)(a.as_ptr(), b.as_ptr(), n),\n72\t                (p.r.p_strncmp)(a.as_ptr(), b.as_ptr(), n),\n73\t            );\n74\t        }\n75\t    }\n76\t    d.finish(\"_pcre2_strcmp_8 / _pcre2_strncmp_8: equal, prefix and differing pairs, n 0..13\");\n77\t}\n78\t\n79\t// CONFIGS row: the `_c8` variants (PCRE2_SPTR vs C `char *`).\n80\t#[test]\n81\tfn strcmp_c8_and_strcpy_c8() {\n82\t    let p = pair();\n83\t    let mut rng = Rng::new(3);\n84\t    let mut d = Diffs::new();\n85\t    for _ in 0..N {\n86\t        let mut a = gen_ascii(&mut rng, 12);\n87\t        a.retain(|&b| b != 0);\n88\t        a.push(0);\n89\t        let mut b = if rng.chance(2) { a.clone() } else { gen_ascii(&mut rng, 12) };\n90\t        b.retain(|&x| x != 0);\n91\t        b.push(0);\n92\t        let bc = b.as_ptr() as *const c_char;\n93\t        unsafe {\n94\t            d.eq(\n95\t                &format!(\"strcmp_c8({},{})\", show(&a), show(&b)),\n96\t                (p.c.p_strcmp_c8)(a.as_ptr(), bc),\n97\t                (p.r.p_strcmp_c8)(a.as_ptr(), bc),\n98\t            );\n99\t            let n = rng.below(14);\n100\t            d.eq(\n101\t                &format!(\"strncmp_c8({},{},{n})\", show(&a), show(&b)),\n102\t                (p.c.p_strncmp_c8)(a.as_ptr(), bc, n),\n103\t                (p.r.p_strncmp_c8)(a.as_ptr(), bc, n),\n104\t            );\n105\t            // strcpy_c8 writes; compare returned length AND the written bytes.\n106\t            let mut ba = [0xEEu8; 64];\n107\t            let mut bb = [0xEEu8; 64];\n108\t            let la = (p.c.p_strcpy_c8)(ba.as_mut_ptr(), bc);\n109\t            let lb = (p.r.p_strcpy_c8)(bb.as_mut_ptr(), bc);\n110\t            d.eq(&format!(\"strcpy_c8({}) len\", show(&b)), la, lb);\n111\t            d.eq(&format!(\"strcpy_c8({}) buf\", show(&b)), ba, bb);\n112\t        }\n113\t    }\n114\t    d.finish(\"_pcre2_strcmp_c8_8 / _pcre2_strncmp_c8_8 / _pcre2_strcpy_c8_8\");\n115\t}\n116\t\n117\t// ======================================================================== UTF\n118\t\n119\t// CONFIGS row: _pcre2_ord2utf_8 — EVERY code point 0..=0x10FFFF plus the\n120\t// out-of-range values the signed comparison in the C makes reachable.\n121\t#[test]\n122\tfn ord2utf_exhaustive() {\n123\t    let p = pair();\n124\t    let mut d = Diffs::new();\n125\t    let check = |cp: u32, d: &mut Diffs| unsafe {\n126\t        let mut ba = [0xEEu8; 16];\n127\t        let mut bb = [0xEEu8; 16];\n128\t        let na = (p.c.p_ord2utf)(cp, ba.as_mut_ptr());\n129\t        let nb = (p.r.p_ord2utf)(cp, bb.as_mut_ptr());\n130\t        d.eq(&format!(\"ord2utf(U+{cp:X}) len\"), na, nb);\n131\t        d.eq(&format!(\"ord2utf(U+{cp:X}) bytes\"), ba, bb);\n132\t    };\n133\t    for cp in 0u32..=0x10_FFFF {\n134\t        check(cp, &mut d);\n135\t    }\n136\t    // beyond Unicode: the C compares `(int)cvalue <= utf8_table1[i]`, so the\n137\t    // whole 6-byte encoding range and the negative-when-signed range are live.\n138\t    for cp in [\n139\t        0x11_0000, 0x1F_FFFF, 0x20_0000, 0x3F_FFFF, 0x40_0000, 0x3FF_FFFF, 0x400_0000,\n140\t        0x7FFF_FFFE, 0x7FFF_FFFF, 0x8000_0000, 0x8000_0001, 0xFFFF_FFFE, 0xFFFF_FFFF,\n141\t    ] {\n142\t        check(cp, &mut d);\n143\t    }\n144\t    d.finish(\"_pcre2_ord2utf_8: all code points 0..0x10FFFF + out-of-range/negative-as-signed\");\n145\t}\n146\t\n147\t// CONFIGS row: _pcre2_valid_utf_8 — valid UTF-8 of every length class, and\n148\t// random raw bytes that exercise the 21 distinct UTF-8 error classes.\n149\t#[test]\n150\tfn valid_utf() {\n151\t    let p = pair();\n152\t    let mut rng = Rng::new(4);\n153\t    let mut d = Diffs::new();\n154\t    let mut one = |s: &[u8], d: &mut Diffs| unsafe {\n155\t        let (mut oa, mut ob) = (usize::MAX, usize::MAX);\n156\t        let ra = (p.c.p_valid_utf)(s.as_ptr(), s.len(), &mut oa);\n157\t        let rb = (p.r.p_valid_utf)(s.as_ptr(), s.len(), &mut ob);\n158\t        d.eq(&format!(\"valid_utf({}) rc\", show(s)), ra, rb);\n159\t        d.eq(&format!(\"valid_utf({}) erroroffset\", show(s)), oa, ob);\n160\t    };\n161\t    for _ in 0..N {\n162\t        one(&gen_utf8(&mut rng, 12), &mut d); // well-formed\n163\t        one(&gen_raw(&mut rng, 12), &mut d); // arbitrary bytes\n164\t        // targeted malformed shapes: truncated / bad continuation / overlong /\n165\t        // surrogate / too-big, embedded at a random offset in valid text\n166\t        let mut s = gen_utf8(&mut rng, 6);\n167\t        let bad: &[&[u8]] = &[\n168\t            &[0x80],\n169\t            &[0xBF],\n170\t            &[0xC0, 0x80],\n171\t            &[0xC1, 0xBF],\n172\t            &[0xC2],\n173\t            &[0xE0, 0x80, 0x80],\n174\t            &[0xE0, 0xA0],\n175\t            &[0xE2, 0x28, 0xA1],\n176\t            &[0xED, 0xA0, 0x80],\n177\t            &[0xED, 0xBF, 0xBF],\n178\t            &[0xF0, 0x80, 0x80, 0x80],\n179\t            &[0xF0, 0x90, 0x80],\n180\t            &[0xF4, 0x90, 0x80, 0x80],\n181\t            &[0xF5, 0x80, 0x80, 0x80],\n182\t            &[0xF8, 0x88, 0x80, 0x80, 0x80],\n183\t            &[0xFC, 0x84, 0x80, 0x80, 0x80, 0x80],\n184\t            &[0xFE],\n185\t            &[0xFF],\n186\t        ];\n187\t        s.extend_from_slice(rng.pick_bytes(bad));\n188\t        s.extend_from_slice(&gen_utf8(&mut rng, 4));\n189\t        one(&s, &mut d);\n190\t    }\n191\t    d.finish(\"_pcre2_valid_utf_8: valid 1/2/3/4-byte forms, random bytes, all malformed classes\");\n192\t}\n193\t\n194\t// ================================================================== chkdint\n195\t\n196\t// CONFIGS row: _pcre2_ckd_smul_8 — positive, zero, negative and huge factors.\n197\t#[test]\n198\tfn ckd_smul() {\n199\t    let p = pair();\n200\t    let mut rng = Rng::new(5);\n201\t    let mut d = Diffs::new();\n202\t    let edges: [c_int; 11] = [\n203\t        0, 1, -1, 2, -2, 46341, 65536, i32::MAX, i32::MIN, i32::MAX - 1, i32::MIN + 1,\n204\t    ];\n205\t    let one = |a: c_int, b: c_int, d: &mut Diffs| unsafe {\n206\t        let (mut ra, mut rb) = (0xAAAA_AAAA_AAAA_AAAAusize, 0xAAAA_AAAA_AAAA_AAAAusize);\n207\t        let oa = (p.c.p_ckd_smul)(&mut ra, a, b);\n208\t        let ob = (p.r.p_ckd_smul)(&mut rb, a, b);\n209\t        d.eq(&format!(\"ckd_smul({a},{b}) overflow\"), oa, ob);\n210\t        d.eq(&format!(\"ckd_smul({a},{b}) result\"), ra, rb);\n211\t    };\n212\t    for &a in &edges {\n213\t        for &b in &edges {\n214\t            one(a, b, &mut d);\n215\t        }\n216\t    }\n217\t    for _ in 0..N {\n218\t        let a = rng.next_u32() as c_int;\n219\t        let b = rng.next_u32() as c_int;\n220\t        one(a, b, &mut d);\n221\t        one(rng.below(70000) as c_int, rng.below(70000) as c_int, &mut d);\n222\t    }\n223\t    d.finish(\"_pcre2_ckd_smul_8: edge x edge, random full-range and small-positive factors\");\n224\t}\n225\t\n226\t// ================================================================== newline\n227\t\n228\t// CONFIGS rows: _pcre2_is_newline_8 / _pcre2_was_newline_8 across\n229\t// NLTYPE_ANY / NLTYPE_ANYCRLF x utf on/off, over data containing every\n230\t// newline character (LF VT FF CR NEL LS PS).\n231\t#[test]\n232\tfn is_and_was_newline() {\n233\t    let p = pair();\n234\t    let mut rng = Rng::new(6);\n235\t    let mut d = Diffs::new();\n236\t    // alphabet loaded with newline characters, incl. multi-byte NEL/LS/PS\n237\t    let pieces: &[&[u8]] = &[\n238\t        b\"a\", b\"\\n\", b\"\\x0b\", b\"\\x0c\", b\"\\r\", b\"\\r\\n\", b\"\\xc2\\x85\", /* NEL */\n239\t        b\"\\xe2\\x80\\xa8\", /* LS */\n240\t        b\"\\xe2\\x80\\xa9\", /* PS */\n241\t        b\"\\x85\", b\"\\xc2\", b\"\\xe2\\x80\",\n242\t    ];\n243\t    for _ in 0..N {\n244\t        let mut s = Vec::new();\n245\t        let n = rng.range(1, 8);\n246\t        for _ in 0..n {\n247\t            s.extend_from_slice(rng.pick_bytes(pieces));\n248\t        }\n249\t        let end = unsafe { s.as_ptr().add(s.len()) };\n250\t        // is_newline: ptr must be < endptr\n251\t        for ty in [1u32, 2] {\n252\t            for utf in [0 as Bool, 1] {\n253\t                let i = rng.below(s.len());\n254\t                // in UTF mode the pointer must be on a character boundary\n255\t                let i = if utf != 0 {\n256\t                    let mut j = i;\n257\t                    while j > 0 && (s[j] & 0xc0) == 0x80 {\n258\t                        j -= 1;\n259\t                    }\n260\t                    j\n261\t                } else {\n262\t                    i\n263\t                };\n264\t                unsafe {\n265\t                    let ptr = s.as_ptr().add(i);\n266\t                    let (mut la, mut lb) = (0xFFFF_FFFFu32, 0xFFFF_FFFFu32);\n267\t                    let ra = (p.c.p_is_newline)(ptr, ty, end, &mut la, utf);\n268\t                    let rb = (p.r.p_is_newline)(ptr, ty, end, &mut lb, utf);\n269\t                    let tag = format!(\"is_newline({}, @{i}, ty={ty}, utf={utf})\", show(&s));\n270\t                    d.eq(&format!(\"{tag} rc\"), ra, rb);\n271\t                    if ra != 0 && rb != 0 {\n272\t                        d.eq(&format!(\"{tag} len\"), la, lb);\n273\t                    }\n274\t                }\n275\t                // was_newline: ptr must be > start\n276\t                let j = rng.range(1, s.len());\n277\t                let j = if utf != 0 {\n278\t                    let mut j = j;\n279\t                    while j < s.len() && (s[j] & 0xc0) == 0x80 {\n280\t                        j += 1;\n281\t                    }\n282\t                    j.max(1)\n283\t                } else {\n284\t                    j\n285\t                };\n286\t                unsafe {\n287\t                    let ptr = s.as_ptr().add(j);\n288\t                    let (mut la, mut lb) = (0xFFFF_FFFFu32, 0xFFFF_FFFFu32);\n289\t                    let ra = (p.c.p_was_newline)(ptr, ty, s.as_ptr(), &mut la, utf);\n290\t                    let rb = (p.r.p_was_newline)(ptr, ty, s.as_ptr(), &mut lb, utf);\n291\t                    let tag = format!(\"was_newline({}, @{j}, ty={ty}, utf={utf})\", show(&s));\n292\t                    d.eq(&format!(\"{tag} rc\"), ra, rb);\n293\t                    if ra != 0 && rb != 0 {\n294\t                        d.eq(&format!(\"{tag} len\"), la, lb);\n295\t                    }\n296\t                }\n297\t            }\n298\t        }\n299\t    }\n300\t    d.finish(\"_pcre2_is_newline_8 / _pcre2_was_newline_8: NLTYPE_ANY|ANYCRLF x utf on/off\");\n301\t}\n302\t\n303\t// =============================================================== extuni / scripts\n304\t\n305\t// CONFIGS row: _pcre2_extuni_8 — grapheme cluster stepping, utf on/off,\n306\t// with and without an xcount accumulator.\n307\t#[test]\n308\tfn extuni() {\n309\t    let p = pair();\n310\t    let mut rng = Rng::new(7);\n311\t    let mut d = Diffs::new();\n312\t    // include combining marks, ZWJ, regional indicators, Hangul jamo, emoji\n313\t    let pieces: &[&[u8]] = &[\n314\t        b\"a\",\n315\t        b\"\\xcc\\x81\",         // U+0301 combining acute\n316\t        b\"\\xe2\\x80\\x8d\",     // U+200D ZWJ\n317\t        b\"\\xf0\\x9f\\x87\\xa6\", // U+1F1E6 regional indicator A\n318\t        b\"\\xf0\\x9f\\x87\\xa7\", // U+1F1E7 regional indicator B\n319\t        b\"\\xe1\\x84\\x80\",     // U+1100 Hangul choseong\n320\t        b\"\\xe1\\x85\\xa1\",     // U+1161 Hangul jungseong\n321\t        b\"\\xe1\\x86\\xa8\",     // U+11A8 Hangul jongseong\n322\t        b\"\\xf0\\x9f\\x91\\xa8\", // U+1F468 man\n323\t        b\"\\xe2\\x9d\\xa4\",     // U+2764 heart\n324\t        b\"\\xef\\xb8\\x8f\",     // U+FE0F variation selector\n325\t        b\"\\xe0\\xa4\\xa8\",     // U+0928 devanagari na\n326\t        b\"\\xe0\\xa4\\xbe\",     // U+093E devanagari sign aa\n327\t        b\"\\n\",\n328\t        b\"\\r\",\n329\t    ];\n330\t    for _ in 0..N {\n331\t        let mut s = Vec::new();\n332\t        for _ in 0..rng.range(1, 8) {\n333\t            s.extend_from_slice(rng.pick_bytes(pieces));\n334\t        }\n335\t        for utf in [0 as Bool, 1] {\n336\t            unsafe {\n337\t                let start = s.as_ptr();\n338\t                let end = start.add(s.len());\n339\t                // decode the first character the way the engine would\n340\t                let (c, adv) = if utf != 0 {\n341\t                    match std::str::from_utf8(&s) {\n342\t                        Ok(t) => {\n343\t                            let ch = t.chars().next().unwrap();\n344\t                            (ch as u32, ch.len_utf8())\n345\t                        }\n346\t                        Err(_) => continue,\n347\t                    }\n348\t                } else {\n349\t                    (s[0] as u32, 1)\n350\t                };\n351\t                let eptr = start.add(adv);\n352\t                for use_count in [false, true] {\n353\t                    let (mut xa, mut xb) = (0 as c_int, 0 as c_int);\n354\t                    let (pa, pb) = if use_count {\n355\t                        (&mut xa as *mut c_int, &mut xb as *mut c_int)\n356\t                    } else {\n357\t                        (ptr::null_mut(), ptr::null_mut())\n358\t                    };\n359\t                    let ra = (p.c.p_extuni)(c, eptr, start, end, utf, pa);\n360\t                    let rb = (p.r.p_extuni)(c, eptr, start, end, utf, pb);\n361\t                    let tag = format!(\"extuni({}, utf={utf}, xcount={use_count})\", show(&s));\n362\t                    d.eq(\n363\t                        &format!(\"{tag} advance\"),\n364\t                        ra as usize - start as usize,\n365\t                        rb as usize - start as usize,\n366\t                    );\n367\t                    if use_count {\n368\t                        d.eq(&format!(\"{tag} xcount\"), xa, xb);\n369\t                    }\n370\t                }\n371\t            }\n372\t        }\n373\t    }\n374\t    d.finish(\"_pcre2_extuni_8: grapheme clusters (marks/ZWJ/RI/Hangul/emoji), utf on/off, xcount null+set\");\n375\t}\n376\t\n377\t// CONFIGS row: _pcre2_script_run_8 — single-script and mixed-script spans.\n378\t#[test]\n379\tfn script_run() {\n380\t    let p = pair();\n381\t    let mut rng = Rng::new(8);\n382\t    let mut d = Diffs::new();\n383\t    let pieces: &[&[u8]] = &[\n384\t        b\"a\", b\"Z\", b\"0\", b\"9\", b\"_\",\n385\t        b\"\\xd0\\xb0\",         // Cyrillic a\n386\t        b\"\\xce\\xb1\",         // Greek alpha\n387\t        b\"\\xd7\\x90\",         // Hebrew alef\n388\t        b\"\\xd8\\xa7\",         // Arabic alef\n389\t        b\"\\xe3\\x81\\x82\",     // Hiragana a\n390\t        b\"\\xe4\\xb8\\x80\",     // Han one\n391\t        b\"\\xe0\\xa4\\xa8\",     // Devanagari na\n392\t        b\"\\xcc\\x81\",         // combining acute (inherited)\n393\t        b\"\\xef\\xbc\\x91\",     // fullwidth digit one\n394\t        b\"\\xd9\\xa1\",         // Arabic-Indic digit one\n395\t        b\"\\xe0\\xa5\\xa7\",     // Devanagari digit one\n396\t    ];\n397\t    for _ in 0..N {\n398\t        let mut s = Vec::new();\n399\t        for _ in 0..rng.range(1, 7) {\n400\t            s.extend_from_slice(rng.pick_bytes(pieces));\n401\t        }\n402\t        for utf in [0 as Bool, 1] {\n403\t            if utf != 0 && std::str::from_utf8(&s).is_err() {\n404\t                continue;\n405\t            }\n406\t            unsafe {\n407\t                let start = s.as_ptr();\n408\t                let end = start.add(s.len());\n409\t                d.eq(\n410\t                    &format!(\"script_run({}, utf={utf})\", show(&s)),\n411\t                    (p.c.p_script_run)(start, end, utf),\n412\t                    (p.r.p_script_run)(start, end, utf),\n413\t                );\n414\t            }\n415\t        }\n416\t    }\n417\t    d.finish(\"_pcre2_script_run_8: single/mixed script spans incl. digits and inherited marks, utf on/off\");\n418\t}\n419\t\n420\t// ============================================================ class bitmaps\n421\t\n422\t// CONFIGS row: _pcre2_update_classbits_8 — every property type, many pdata\n423\t// values, negated on/off, over pre-seeded bitmaps.\n424\t#[test]\n425\tfn update_classbits() {\n426\t    let p = pair();\n427\t    let mut rng = Rng::new(9);\n428\t    let mut d = Diffs::new();\n429\t    // ptype range: PT_ANY .. PT_TABLE_LENGTH; go one past to cover the default\n430\t    for ptype in 0u32..24 {\n431\t        for pdata in 0u32..40 {\n432\t            for negated in [0 as Bool, 1] {\n433\t                unsafe {\n434\t                    let seed: [u8; 32] = std::array::from_fn(|_| rng.byte());\n435\t                    let mut ba = seed;\n436\t                    let mut bb = seed;\n437\t                    (p.c.p_update_classbits)(ptype, pdata, negated, ba.as_mut_ptr());\n438\t                    (p.r.p_update_classbits)(ptype, pdata, negated, bb.as_mut_ptr());\n439\t                    d.eq(\n440\t                        &format!(\"update_classbits(ptype={ptype}, pdata={pdata}, neg={negated})\"),\n441\t                        ba,\n442\t                        bb,\n443\t                    );\n444\t                }\n445\t            }\n446\t        }\n447\t    }\n448\t    d.finish(\"_pcre2_update_classbits_8: ptype 0..23 x pdata 0..39 x negated, random seed bitmaps\");\n449\t}\n450\t\n451\t// ============================================================== name hashing\n452\t\n453\t// CONFIGS row: _pcre2_compile_get_hash_from_name8 — all lengths incl. 0.\n454\t#[test]\n455\tfn get_hash_from_name() {\n456\t    let p = pair();\n457\t    let mut rng = Rng::new(10);\n458\t    let mut d = Diffs::new();\n459\t    for _ in 0..N {\n460\t        let mut s = gen_ascii(&mut rng, 40);\n461\t        if s.is_empty() {\n462\t            s.push(b'x');\n463\t        }\n464\t        // The C reads name[0] and name[length-1] unconditionally\n465\t        // (`PCRE2_ASSERT(length > 0)` compiles away here), so length 0 is\n466\t        // out-of-bounds in the C itself and not a meaningful differential.\n467\t        let n = rng.range(1, s.len()) as u32;\n468\t        unsafe {\n469\t            d.eq(\n470\t                &format!(\"get_hash_from_name({}, {n})\", show(&s)),\n471\t                (p.c.p_get_hash_from_name)(s.as_ptr(), n),\n472\t                (p.r.p_get_hash_from_name)(s.as_ptr(), n),\n473\t            );\n474\t        }\n475\t    }\n476\t    // also every single byte value, length 1\n477\t    for b in 0u8..=255 {\n478\t        let s = [b];\n479\t        unsafe {\n480\t            d.eq(\n481\t                &format!(\"get_hash_from_name([{b:#04x}], 1)\"),\n482\t                (p.c.p_get_hash_from_name)(s.as_ptr(), 1),\n483\t                (p.r.p_get_hash_from_name)(s.as_ptr(), 1),\n484\t            );\n485\t        }\n486\t    }\n487\t    d.finish(\"_pcre2_compile_get_hash_from_name8: random names, lengths 0..len, all single bytes\");\n488\t}\n489\t\n490\t// ============================================================== JIT stubs\n491\t\n492\t// CONFIGS row: the no-JIT stubs must agree exactly (this build has no JIT).\n493\t#[test]\n494\tfn jit_stubs() {\n495\t    let p = pair();\n496\t    unsafe {\n497\t        let (ta, tb) = ((p.c.p_jit_get_target)(), (p.r.p_jit_get_target)());\n498\t        match (ta.is_null(), tb.is_null()) {\n499\t            (true, true) => {}\n500\t            (false, false) => assert_eq!(CStr::from_ptr(ta), CStr::from_ptr(tb)),\n501\t            _ => panic!(\"_pcre2_jit_get_target_8 nullness differs\"),\n502\t        }\n503\t        assert_eq!(\n504\t            (p.c.p_jit_get_size)(ptr::null_mut()),\n505\t            (p.r.p_jit_get_size)(ptr::null_mut()),\n506\t            \"_pcre2_jit_get_size_8(NULL) differs\"\n507\t        );\n508\t        // pcre2_jit_stack_create must fail identically without JIT\n509\t        for (a, b) in [(1usize, 1usize), (32 * 1024, 512 * 1024), (0, 0)] {\n510\t            let sa = (p.c.jit_stack_create)(a, b, ptr::null_mut());\n511\t            let sb = (p.r.jit_stack_create)(a, b, ptr::null_mut());\n512\t            assert_eq!(\n513\t                sa.is_null(),\n514\t                sb.is_null(),\n515\t                \"jit_stack_create({a},{b}) nullness differs\"\n516\t            );\n517\t            if !sa.is_null() {\n518\t                (p.c.jit_stack_free)(sa);\n519\t            }\n520\t            if !sb.is_null() {\n521\t                (p.r.jit_stack_free)(sb);\n522\t            }\n523\t        }\n524\t        // free_unused_memory / stack_assign are no-ops; just prove they don't trap\n525\t        (p.c.jit_free_unused_memory)(ptr::null_mut());\n526\t        (p.r.jit_free_unused_memory)(ptr::null_mut());\n527\t        (p.c.jit_stack_assign)(ptr::null_mut(), ptr::null_mut(), ptr::null_mut());\n528\t        (p.r.jit_stack_assign)(ptr::null_mut(), ptr::null_mut(), ptr::null_mut());\n529\t    }\n530\t}\n531\t\n532\t// ============================================================ memctl_malloc\n533\t\n534\tstatic mut REQ_C: usize = 0;\n535\tstatic mut REQ_R: usize = 0;\n536\t\n537\tunsafe extern \"C\" fn rec_malloc_c(n: usize, _d: *mut std::ffi::c_void) -> *mut std::ffi::c_void {\n538\t    REQ_C = n;\n539\t    libc_malloc(n)\n540\t}\n541\tunsafe extern \"C\" fn rec_malloc_r(n: usize, _d: *mut std::ffi::c_void) -> *mut std::ffi::c_void {\n542\t    REQ_R = n;\n543\t    libc_malloc(n)\n544\t}\n545\tunsafe extern \"C\" fn rec_free(p: *mut std::ffi::c_void, _d: *mut std::ffi::c_void) {\n546\t    libc_free(p)\n547\t}\n548\t\n549\t// Minimal allocator so the test does not depend on the `libc` crate.\n550\tunsafe fn libc_malloc(n: usize) -> *mut std::ffi::c_void {\n551\t    let layout = std::alloc::Layout::from_size_align(n.max(1) + 16, 16).unwrap();\n552\t    let p = std::alloc::alloc(layout);\n553\t    *(p as *mut usize) = n.max(1) + 16;\n554\t    p.add(16) as *mut std::ffi::c_void\n555\t}\n556\tunsafe fn libc_free(p: *mut std::ffi::c_void) {\n557\t    if p.is_null() {\n558\t        return;\n559\t    }\n560\t    let base = (p as *mut u8).sub(16);\n561\t    let sz = *(base as *mut usize);\n562\t    std::alloc::dealloc(base, std::alloc::Layout::from_size_align(sz, 16).unwrap());\n563\t}\n564\t\n565\t#[repr(C)]\n566\tstruct MemCtl {\n567\t    malloc: Option<MallocFn>,\n568\t    free: Option<FreeFn>,\n569\t    memory_data: *mut std::ffi::c_void,\n570\t}\n571\t\n572\t// CONFIGS row: _pcre2_memctl_malloc_8 — the requested size must match exactly\n573\t// (it embeds a pcre2_memctl header ahead of the payload).\n574\t#[test]\n575\tfn memctl_malloc() {\n576\t    let p = pair();\n577\t    unsafe {\n578\t        // The C writes a whole `pcre2_memctl` (3 pointers = 24 bytes) at the\n579\t        // front of the block it obtains, so every real caller passes\n580\t        // `size >= sizeof(pcre2_memctl)`; smaller sizes corrupt the heap in the\n581\t        // C too and are not a meaningful differential.\n582\t        const MEMCTL: usize = std::mem::size_of::<MemCtl>();\n583\t        for size in [MEMCTL, MEMCTL + 1, 32, 88, 96, 100, 4096, 65536] {\n584\t            let mut ma = MemCtl {\n585\t                malloc: Some(rec_malloc_c),\n586\t                free: Some(rec_free),\n587\t                memory_data: ptr::null_mut(),\n588\t            };\n589\t            let mut mb = MemCtl {\n590\t                malloc: Some(rec_malloc_r),\n591\t                free: Some(rec_free),\n592\t                memory_data: ptr::null_mut(),\n593\t            };\n594\t            REQ_C = 0;\n595\t            REQ_R = 0;\n596\t            let a = (p.c.p_memctl_malloc)(size, &mut ma as *mut _ as Ptr);\n597\t            let b = (p.r.p_memctl_malloc)(size, &mut mb as *mut _ as Ptr);\n598\t            assert_eq!(a.is_null(), b.is_null(), \"memctl_malloc({size}) nullness differs\");\n599\t            assert_eq!(REQ_C, REQ_R, \"memctl_malloc({size}) requested size differs\");\n600\t            assert!(REQ_C >= size, \"requested less than asked\");\n601\t            // the header written into the block must carry the memctl through\n602\t            if !a.is_null() {\n603\t                let ha = &*(a as *const MemCtl);\n604\t                let hb = &*(b as *const MemCtl);\n605\t                assert_eq!(ha.memory_data, hb.memory_data);\n606\t                assert!(ha.malloc.is_some() && hb.malloc.is_some());\n607\t                rec_free(a, ptr::null_mut());\n608\t                rec_free(b, ptr::null_mut());\n609\t            }\n610\t        }\n611\t    }\n612\t}\n613\t"}]},"parent_tool_use_id":"toolu_bdrk_01Qz7FB2Krnwsnf7BJpPHXu5","session_id":"cde48455-d5ce-4cd5-a0b0-2154082e5ad7","uuid":"5b9e41e9-1e62-4f2c-9363-e40045a706fd","timestamp":"2026-08-23T10:49:50.185Z","subagent_type":"general-purpose","task_description":"CONFIGS rows 407-444 low-level sign-off"}
