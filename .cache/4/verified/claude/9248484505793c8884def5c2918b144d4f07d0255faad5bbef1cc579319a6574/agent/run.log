= 48usize;\n135\t                    let rc = (api.substitute)(\n136\t                        code, sb.as_ptr(), sb.len(), 0, PCRE2_SUBSTITUTE_EXTENDED,\n137\t                        ptr::null_mut(), ptr::null_mut(), rb.as_ptr(), rb.len(),\n138\t                        out.as_mut_ptr(), &mut bl,\n139\t                    );\n140\t                    println!(\n141\t                        \"[{}] turkish subj={} rep={} rc={rc} out={}\",\n142\t                        api.name, show(sb), rep, show(&out[..bl.min(48)])\n143\t                    );\n144\t                }\n145\t            }\n146\t            (api.code_free)(code);\n147\t            (api.compile_context_free)(cc);\n148\t        }\n149\t    }\n150\t}\n151\t\n152\tstatic mut LOG: Vec<String> = Vec::new();\n153\t\n154\t#[repr(C)]\n155\tstruct CalloutBlock {\n156\t    version: u32,\n157\t    callout_number: u32,\n158\t    capture_top: u32,\n159\t    capture_last: u32,\n160\t    offset_vector: *const Sz,\n161\t    mark: Sptr,\n162\t    subject: Sptr,\n163\t    subject_length: Sz,\n164\t    start_match: Sz,\n165\t    current_position: Sz,\n166\t    pattern_position: Sz,\n167\t    next_item_length: Sz,\n168\t    callout_string_offset: Sz,\n169\t    callout_string_length: Sz,\n170\t    callout_string: Sptr,\n171\t    callout_flags: u32,\n172\t}\n173\t\n174\tstatic mut CALLOUT_RET: c_int = 0;\n175\t\n176\tunsafe extern \"C\" fn cb(blk: *mut c_void, _d: *mut c_void) -> c_int {\n177\t    let b = &*(blk as *const CalloutBlock);\n178\t    let log = &mut *ptr::addr_of_mut!(LOG);\n179\t    log.push(format!(\n180\t        \"v={} n={} ct={} cl={} sm={} cp={} pp={} nil={} mark_null={}\",\n181\t        b.version, b.callout_number, b.capture_top, b.capture_last, b.start_match,\n182\t        b.current_position, b.pattern_position, b.next_item_length, b.mark.is_null()\n183\t    ));\n184\t    *ptr::addr_of_mut!(CALLOUT_RET)\n185\t}\n186\t\n187\t#[test]\n188\tfn probe_dfa_callout() {\n189\t    let p = pair();\n190\t    unsafe {\