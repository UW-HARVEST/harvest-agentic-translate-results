{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01X8T5P1h6Lc37nK9Fuj39pN","type":"tool_result","content":"1\t// Differential-test harness for the PCRE2 C -> Rust translation.\n2\t//\n3\t// BOTH libraries are loaded as shared objects through `libloading` and every\n4\t// call crosses the FFI boundary.  The Rust implementation is NEVER called\n5\t// directly as a Rust crate: that way the `#[no_mangle] extern \"C\"` export\n6\t// wrappers are part of what is under test, exactly as an external C consumer\n7\t// would see them.\n8\t//\n9\t// Both `.so`s export the *same* symbol names, so they are opened with\n10\t// RTLD_LOCAL and looked up through their own handle -- no interposition.\n11\t\n12\t#![allow(dead_code)]\n13\t\n14\tuse libloading::os::unix::{Library as UnixLibrary, Symbol as UnixSymbol, RTLD_LOCAL, RTLD_NOW};\n15\tuse std::ffi::{c_char, c_int, c_void};\n16\tuse std::path::PathBuf;\n17\tuse std::ptr;\n18\t\n19\t// ----------------------------------------------------------------基本 types\n20\t\n21\tpub type Sz = usize; // PCRE2_SIZE\n22\tpub type Sptr = *const u8; // PCRE2_SPTR  (8-bit width)\n23\tpub type Uchar = u8; // PCRE2_UCHAR\n24\tpub type Bool = c_int; // BOOL == int\n25\tpub type Ptr = *mut c_void;\n26\t\n27\tpub type MallocFn = unsafe extern \"C\" fn(usize, *mut c_void) -> *mut c_void;\n28\tpub type FreeFn = unsafe extern \"C\" fn(*mut c_void, *mut c_void);\n29\tpub type CalloutFn = unsafe extern \"C\" fn(*mut c_void, *mut c_void) -> c_int;\n30\tpub type GuardFn = unsafe extern \"C\" fn(u32, *mut c_void) -> c_int;\n31\tpub type CaseFn = unsafe extern \"C\" fn(Sptr, Sz, *mut u8, Sz, c_int, *mut c_void) -> Sz;\n32\t\n33\t// --------------------------------------------------------------- constants\n34\t\n35\tpub const PCRE2_ANCHORED: u32 = 0x8000_0000;\n36\tpub const PCRE2_NO_UTF_CHECK: u32 = 0x4000_0000;\n37\tpub const PCRE2_ENDANCHORED: u32 = 0x2000_0000;\n38\t\n39\tpub const PCRE2_ALLOW_EMPTY_CLASS: u32 = 0x0000_0001;\n40\tpub const PCRE2_ALT_BSUX: u32 = 0x0000_0002;\n41\tpub const PCRE2_AUTO_CALLOUT: u32 = 0x0000_0004;\n42\tpub const PCRE2_CASELESS: u32 = 0x0000_0008;\n43\tpub const PCRE2_DOLLAR_ENDONLY: u32 = 0x0000_0010;\n44\tpub const PCRE2_DOTALL: u32 = 0x0000_0020;\n45\tpub const PCRE2_DUPNAMES: u32 = 0x0000_0040;\n46\tpub const PCRE2_EXTENDED: u32 = 0x0000_0080;\n47\tpub const PCRE2_FIRSTLINE: u32 = 0x0000_0100;\n48\tpub const PCRE2_MATCH_UNSET_BACKREF: u32 = 0x0000_0200;\n49\tpub const PCRE2_MULTILINE: u32 = 0x0000_0400;\n50\tpub const PCRE2_NEVER_UCP: u32 = 0x0000_0800;\n51\tpub const PCRE2_NEVER_UTF: u32 = 0x0000_1000;\n52\tpub const PCRE2_NO_AUTO_CAPTURE: u32 = 0x0000_2000;\n53\tpub const PCRE2_NO_AUTO_POSSESS: u32 = 0x0000_4000;\n54\tpub const PCRE2_NO_DOTSTAR_ANCHOR: u32 = 0x0000_8000;\n55\tpub const PCRE2_NO_START_OPTIMIZE: u32 = 0x0001_0000;\n56\tpub const PCRE2_UCP: u32 = 0x0002_0000;\n57\tpub const PCRE2_UNGREEDY: u32 = 0x0004_0000;\n58\tpub const PCRE2_UTF: u32 = 0x0008_0000;\n59\tpub const PCRE2_NEVER_BACKSLASH_C: u32 = 0x0010_0000;\n60\tpub const PCRE2_ALT_CIRCUMFLEX: u32 = 0x0020_0000;\n61\tpub const PCRE2_ALT_VERBNAMES: u32 = 0x0040_0000;\n62\tpub const PCRE2_USE_OFFSET_LIMIT: u32 = 0x0080_0000;\n63\tpub const PCRE2_EXTENDED_MORE: u32 = 0x0100_0000;\n64\tpub const PCRE2_LITERAL: u32 = 0x0200_0000;\n65\tpub const PCRE2_MATCH_INVALID_UTF: u32 = 0x0400_0000;\n66\tpub const PCRE2_ALT_EXTENDED_CLASS: u32 = 0x0800_0000;\n67\t\n68\tpub const PCRE2_EXTRA_ALLOW_SURROGATE_ESCAPES: u32 = 0x0000_0001;\n69\tpub const PCRE2_EXTRA_BAD_ESCAPE_IS_LITERAL: u32 = 0x0000_0002;\n70\tpub const PCRE2_EXTRA_MATCH_WORD: u32 = 0x0000_0004;\n71\tpub const PCRE2_EXTRA_MATCH_LINE: u32 = 0x0000_0008;\n72\tpub const PCRE2_EXTRA_ESCAPED_CR_IS_LF: u32 = 0x0000_0010;\n73\tpub const PCRE2_EXTRA_ALT_BSUX: u32 = 0x0000_0020;\n74\tpub const PCRE2_EXTRA_ALLOW_LOOKAROUND_BSK: u32 = 0x0000_0040;\n75\tpub const PCRE2_EXTRA_CASELESS_RESTRICT: u32 = 0x0000_0080;\n76\tpub const PCRE2_EXTRA_ASCII_BSD: u32 