RE2_ERROR_DFA_UFUNC: c_int = -41;\n200\tpub const PCRE2_ERROR_DFA_UITEM: c_int = -42;\n201\tpub const PCRE2_ERROR_DFA_WSSIZE: c_int = -43;\n202\tpub const PCRE2_ERROR_INTERNAL: c_int = -44;\n203\tpub const PCRE2_ERROR_JIT_BADOPTION: c_int = -45;\n204\tpub const PCRE2_ERROR_MATCHLIMIT: c_int = -47;\n205\tpub const PCRE2_ERROR_NOMEMORY: c_int = -48;\n206\tpub const PCRE2_ERROR_NOSUBSTRING: c_int = -49;\n207\tpub const PCRE2_ERROR_NOUNIQUESUBSTRING: c_int = -50;\n208\tpub const PCRE2_ERROR_NULL: c_int = -51;\n209\tpub const PCRE2_ERROR_RECURSELOOP: c_int = -52;\n210\tpub const PCRE2_ERROR_DEPTHLIMIT: c_int = -53;\n211\tpub const PCRE2_ERROR_UNAVAILABLE: c_int = -54;\n212\tpub const PCRE2_ERROR_UNSET: c_int = -55;\n213\tpub const PCRE2_ERROR_BADOFFSETLIMIT: c_int = -56;\n214\tpub const PCRE2_ERROR_BADREPESCAPE: c_int = -57;\n215\tpub const PCRE2_ERROR_REPMISSINGBRACE: c_int = -58;\n216\tpub const PCRE2_ERROR_BADSUBSTITUTION: c_int = -59;\n217\tpub const PCRE2_ERROR_BADSUBSPATTERN: c_int = -60;\n218\tpub const PCRE2_ERROR_TOOMANYREPLACE: c_int = -61;\n219\tpub const PCRE2_ERROR_BADSERIALIZEDDATA: c_int = -62;\n220\tpub const PCRE2_ERROR_HEAPLIMIT: c_int = -63;\n221\tpub const PCRE2_ERROR_CONVERT_SYNTAX: c_int = -64;\n222\tpub const PCRE2_ERROR_DFA_UINVALID_UTF: c_int = -66;\n223\tpub const PCRE2_ERROR_INVALIDOFFSET: c_int = -67;\n224\tpub const PCRE2_ERROR_JIT_UNSUPPORTED: c_int = -68;\n225\tpub const PCRE2_ERROR_REPLACECASE: c_int = -69;\n226\tpub const PCRE2_ERROR_TOOLARGEREPLACE: c_int = -70;\n227\tpub const PCRE2_ERROR_DIFFSUBSPATTERN: c_int = -71;\n228\tpub const PCRE2_ERROR_DIFFSUBSSUBJECT: c_int = -72;\n229\tpub const PCRE2_ERROR_DIFFSUBSOFFSET: c_int = -73;\n230\tpub const PCRE2_ERROR_DIFFSUBSOPTIONS: c_int = -74;\n231\tpub const PCRE2_ERROR_BAD_BACKSLASH_K: c_int = -75;\n232\tpub const PCRE2_ERROR_PARTIALSUBS: c_int = -76;\n233\t\n234\t// ------------------------------------------------------------- the Api table\n235\t\n236\tmacro_rules! def_api {\n237\t    ( $( $field:ident : $sym:literal : $t:ty ),* $(,)? ) => {\n238\t        pub struct Api {\n239\t            pub name: &'static str,\n240\t            pub lib: &'static UnixLibrary,\n241\t            $( pub $field: $t, )*\n242\t        }\n243\t\n244\t        impl Api {\n245\t            pub fn load(name: &'static str, path: &std::path::Path) -> Api {\n246\t                let lib: &'static UnixLibrary = Box::leak(Box::new(unsafe {\n247\t                    UnixLibrary::open(Some(path), RTLD_NOW | RTLD_LOCAL)\n248\t                }\n249\t                .unwrap_or_else(|e| panic!(\"cannot dlopen {}: {}\", path.display(), e))));\n250\t                Api {\n251\t                    name,\n252\t                    lib,\n253\t                    $( $field: unsafe {\n254\t                        let s: UnixSymbol<$t> = lib\n255\t                            .get(concat!($sym, \"\\0\").as_bytes())\n256\t                            .unwrap_or_else(|e| {\n257\t                                panic!(\"[{}] missing symbol {}: {}\", name, $sym, e)\n258\t                            });\n259\t                        *s\n260\t                    }, )*\n261\t                }\n262\t            }\n263\t\n264\t            /// Address of an exported *data* symbol.\n265\t            pub fn data(&self, sym: &str) -> *const u8 {\n266\t                let mut owned = sym.as_bytes().to_vec();\n267\t                owned.push(0);\n268\t                unsafe {\n269\t                    let s: UnixSymbol<*const u8> = self\n270\t                        .lib\n271\t                        .get(&owned)\n272\t                        .unwrap_or_else(|e| panic!(\"[{}] missing data symbol {}: {}\", self.name, sym, e));\n273\t                    s.into_raw() as *const u8\n274\t                }\n275\t            }\n276\t        }\n277\t    };\n278\t}\n279\t\n280\tdef_api! {\n281\t    // ---- general information\n282\t    config: \"pcre2_config_8\": unsafe extern \"C\" fn(u32, Ptr) -> c_int,\n283\t    get_error_message: \"pcre2_get_error_message_8\": unsafe extern \"C\" fn(c_int, *mut u8, Sz) -> c_int,\n284\t    maketables: \"pcre2_maketables_8\": unsafe extern \"C\" fn(Ptr) -> *const u8,\n285\t    maketables_free: \"pcre2_maketables_free_8\": unsafe extern \"C\" fn(Ptr, *const u8),\n286\t\n287\t    // ---- general context\n288\t    general_context_create: \"pcre2_general_context_create_8\":\n289\t        unsafe extern \"C\" fn(Option<MallocFn>, Option<FreeFn>, Ptr) -> Ptr,\n290\t    general_context_copy: \"pcre2_general_context_copy_8\": unsafe extern \"C\" fn(Ptr) -> Ptr,\n291\t    general_context_free: \"pcre2_general_context_free_8\": unsafe extern \"C\" fn(Ptr),\n292\t\n293\t    // ---- compile context\n294\t    compile_context_create: \"pcre2_compile_context_create_8\": unsafe extern \"C\" fn(Ptr) -> Ptr,\n295\t    compile_context_copy: \"pcre2_compile_context_copy_8\": unsafe extern \"C\" fn(Ptr) -> Ptr,\n296\t    compile_context_free: \"pcre2_compile_context_free_8\": unsafe extern \"C\" fn(Ptr),\n297\t    set_bsr: \"pcre2_set_bsr_8\": unsafe extern \"C\" fn(Ptr, u32) -> c_int,\n298\t    set_character_tables: \"pcre2_set_character_tables_8\": unsafe extern \"C\" fn(Ptr, *const u8) -> c_int,\n299\t    set_compile_extra_options: \"pcre2_set_compile_extra_options_8\": unsafe extern \"C\" fn(Ptr, u32) -> c_int,\n300\t    set_max_pattern_length: \"pcre2_set_max_pattern_length_8\": unsafe extern \"C\" fn(Ptr, Sz) -> c_int,\n301\t    set_max_pattern_compiled_length: \"pcre2_set_max_pattern_compiled_length_8\":\n302\t        unsafe extern \"C\" fn(Ptr, Sz) -> c_int,\n303\t    set_max_varlookbehind: \"pcre2_set_max_varlookbehind_8\": unsafe extern \"C\" fn(Ptr, u32) -> c_int,\n304\t    set_newline: \"pcre2_set_newline_8\": unsafe extern \"C\" fn(Ptr, u32) -> c_int,\n305\t    set_parens_nest_limit: \"pcre2_set_parens_nest_limit_8\": unsafe extern \"C\" fn(Ptr, u32) -> c_int,\n306\t    set_compile_recursion_guard: \"pcre2_set_compile_recursion_guard_8\":\n307\t        unsafe extern \"C\" fn(Ptr, Option<GuardFn>, Ptr) -> c_int,\n308\t    set_optimize: \"pcre2_set_optimize_8\": unsafe extern \"C\" fn(Ptr, u32) -> c_int,\n309\t\n310\t    // ---- match context\n311\t    match_context_create: \"pcre2_match_context_create_8\": unsafe extern \"C\" fn(Ptr) -> Ptr,\n312\t    match_context_copy: \"pcre2_match_context_copy_8\": unsafe extern \"C\" fn(Ptr) -> Ptr,\n313\t    match_context_free: \"pcre2_match_context_free_8\": unsafe extern \"C\" fn(Ptr),\n314\t    set_callout: \"pcre2_set_callout_8\": unsafe extern \"C\" fn(Ptr, Option<CalloutFn>, Ptr) -> c_int,\n315\t    set_substitute_callout: \"pcre2_set_substitute_callout_8\":\n316\t        unsafe extern \"C\" fn(Ptr, Option<CalloutFn>, Ptr) -> c_int,\n317\t    set_substitute_case_callout: \"pcre2_set_substitute_case_callout_8\":\n318\t        unsafe extern \"C\" fn(Ptr, Option<CaseFn>, Ptr) -> c_int,\n319\t    set_depth_limit: \"pcre2_set_depth_limit_8\": unsafe extern \"C\" fn(Ptr, u32) -> c_int,\n320\t    set_heap_limit: \"pcre2_set_heap_limit_8\": unsafe extern \"C\" fn(Ptr, u32) -> c_int,\n321\t    set_match_limit: \"pcre2_set_match_limit_8\": unsafe extern \"C\" fn(Ptr, u32) -> c_int,\n322\t    set_offset_limit: \"pcre2_set_offset_limit_8\": unsafe extern \"C\" fn(Ptr, Sz) -> c_int,\n323\t    set_recursion_limit: \"pcre2_set_recursion_limit_8\": unsafe extern \"C\" fn(Ptr, u32) -> c_int,\n324\t    set_recursion_memory_management: \"pcre2_set_recursion_memory_management_8\":\n325\t        unsafe extern \"C\" fn(Ptr, Option<MallocFn>, Option<FreeFn>, Ptr) -> c_int,\n326\t\n327\t    // ---- convert context\n328\t    convert_context_create: \"pcre2_convert_context_create_8\": unsafe extern \"C\" fn(Ptr) -> Ptr,\n329\t    convert_context_copy: \"pcre2_convert_context_copy_8\": unsafe extern \"C\" fn(Ptr) -> Ptr,\n330\t    convert_context_free: \"pcre2_convert_context_free_8\": unsafe extern \"C\" fn(Ptr),\n331\t    set_glob_escape: \"pcre2_set_glob_escape_8\": unsafe extern \"C\" fn(Ptr,