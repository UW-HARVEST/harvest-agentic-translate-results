\n6158\t\n6159\t    Fecode += condition? PRIV(OP_lengths)[*Fecode] : Llength;\n6160\t\n6161\t    /* If the opcode is OP_SCOND it means we are at a repeated conditional\n6162\t    group that might match an empty string. We must therefore descend a level\n6163\t    so that the start is remembered for checking. For OP_COND we can just\n6164\t    continue at this level. */\n6165\t\n6166\t    if (Fop == OP_SCOND)\n6167\t      {\n6168\t      group_frame_type = GF_NOCAPTURE;\n6169\t      RMATCH(Fecode, RM35);\n6170\t      RRETURN(rrc);\n6171\t      }\n6172\t    break;\n6173\t\n6174\t#undef Lstart_branch\n6175\t#undef Llength\n6176\t#undef Lpositive\n6177\t\n6178\t\n6179\t/* ========================================================================= */\n6180\t/*                  End of start of parenthesis opcodes                      */\n6181\t/* ========================================================================= */\n6182\t\n6183\t\n6184\t    /* ===================================================================== */\n6185\t    /* Move the subject pointer back by one fixed amount. This occurs at the\n6186\t    start of each branch that has a fixed length in a lookbehind assertion. If\n6187\t    we are too close to the start to move back, fail. When working with UTF-8\n6188\t    we move back a number of characters, not bytes. */\n6189\t\n6190\t    case OP_REVERSE:\n6191\t    number = GET2(Fecode, 1);\n6192\t#ifdef SUPPORT_UNICODE\n6193\t    if (utf)\n6194\t      {\n6195\t      /* We used to do a simpler `while (number-- > 0)` but that triggers\n6196\t      clang's unsigned integer overflow sanitizer. */\n6197\t      while (number > 0)\n6198\t        {\n6199\t        --number;\n6200\t        if (Feptr <= mb->check_subject) RRETURN(MATCH_NOMATCH);\n6201\t        Feptr--;\n6202\t        BACKCHAR(Feptr);\n6203\t        }\n6204\t      }\n6205\t    else\n6206\t#endif\n6207\t\n6208\t    /* No UTF support, or not in UTF mode: count is code unit count */\n6209\t\n6210\t      {\n