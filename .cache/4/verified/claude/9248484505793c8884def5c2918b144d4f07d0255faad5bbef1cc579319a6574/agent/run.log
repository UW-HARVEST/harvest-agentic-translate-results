n697\t            (p.c.jit_free_unused_memory)(ga);\n698\t            (p.r.jit_free_unused_memory)(gb);\n699\t            (p.c.general_context_free)(ga);\n700\t            (p.r.general_context_free)(gb);\n701\t        }\n702\t        // jit_stack_free(NULL) must be safe\n703\t        (p.c.jit_stack_free)(ptr::null_mut());\n704\t        (p.r.jit_stack_free)(ptr::null_mut());\n705\t        d.checked += 1;\n706\t    }\n707\t    d.finish(\"CONFIGS 455: jit_stack_create/assign/free and jit_free_unused_memory in a no-JIT build\");\n708\t}\n709\t\n710\t// ======================= row 456: exported JIT internals\n711\t\n712\t#[test]\n713\tfn cfg_456_jit_internals() {\n714\t    let p = pair();\n715\t    let mut d = Diffs::new();\n716\t    unsafe {\n717\t        let (ta, tb) = ((p.c.p_jit_get_target)(), (p.r.p_jit_get_target)());\n718\t        d.eq(\"jit_get_target nullness\", ta.is_null(), tb.is_null());\n719\t        if !ta.is_null() && !tb.is_null() {\n720\t            let (sa, sb) = (CStr::from_ptr(ta).to_bytes().to_vec(), CStr::from_ptr(tb).to_bytes().to_vec());\n721\t            println!(\"jit_get_target = {:?}\", String::from_utf8_lossy(&sa));\n722\t            d.eq(\"jit_get_target string\", sa, sb);\n723\t        }\n724\t        d.eq(\n725\t            \"jit_get_size(NULL)\",\n726\t            (p.c.p_jit_get_size)(ptr::null_mut()),\n727\t            (p.r.p_jit_get_size)(ptr::null_mut()),\n728\t        );\n729\t        // a non-NULL (but JIT-less) pointer: use a compiled code's executable_jit\n730\t        let ka = compile(&p.c, b\"abc\", 0);\n731\t        let kb = compile(&p.r, b\"abc\", 0);\n732\t        assert!(!ka.is_null() && !kb.is_null());\n733\t        let ja = (*(ka as *const RealCodeHead)).executable_jit;\n734\t        let jb = (*(kb as *const RealCodeHead)).executable_jit;\n735\t        d.eq(\"executable_jit is NULL without JIT\", ja.is_null(), jb.is_null());\n736\t        d.eq(\n737\t            \"jit_get_size(code->executable_jit)\",\n738\t            (p.c