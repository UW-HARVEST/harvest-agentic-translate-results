{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01DPdpJopNK1WciHvsmGog6S","type":"tool_result","content":"1\t// Differential-test harness for the PCRE2 C -> Rust translation.\n2\t//\n3\t// BOTH libraries are loaded as shared objects through `libloading` and every\n4\t// call crosses the FFI boundary.  The Rust implementation is NEVER called\n5\t// directly as a Rust crate: that way the `#[no_mangle] extern \"C\"` export\n6\t// wrappers are part of what is under test, exactly as an external C consumer\n7\t// would see them.\n8\t//\n9\t// Both `.so`s export the *same* symbol names, so they are opened with\n10\t// RTLD_LOCAL and looked up through their own handle -- no interposition.\n11\t\n12\t#![allow(dead_code)]\n13\t\n14\tuse libloading::os::unix::{Library as UnixLibrary, Symbol as UnixSymbol, RTLD_LOCAL, RTLD_NOW};\n15\tuse std::ffi::{c_char, c_int, c_void};\n16\tuse std::path::PathBuf;\n17\tuse std::ptr;\n18\t\n19\t// ----------------------------------------------------------------基本 types\n20\t\n21\tpub type Sz = usize; // PCRE2_SIZE\n22\tpub type Sptr = *const u8; // PCRE2_SPTR  (8-bit width)\n23\tpub type Uchar = u8; // PCRE2_UCHAR\n24\tpub type Bool = c_int; // BOOL == int\n25\tpub type Ptr = *mut c_void;\n26\t\n27\tpub type MallocFn = unsafe extern \"C\" fn(usize, *mut c_void) -> *mut c_void;\n28\tpub type FreeFn = unsafe extern \"C\" fn(*mut c_void, *mut c_void);\n29\tpub type CalloutFn = unsafe extern \"C\" fn(*mut c_void, *mut c_void) -> c_int;\n30\tpub type GuardFn = unsafe extern \"C\" fn(u32, *mut c_void) -> c_int;\n31\tpub type CaseFn = unsafe extern \"C\" fn(Sptr, Sz, *mut u8, Sz, c_int, *mut c_void) -> Sz;\n32\t\n33\t// --------------------------------------------------------------- constants\n34\t\n35\tpub const PCRE2_ANCHORED: u32 = 0x8000_0000;\n36\tpub const PCRE2_NO_UTF_CHECK: u32 = 0x4000_0000;\n37\tpub const PCRE2_ENDANCHORED: u32 = 0x2000_0000;\n38\t\n39\tpub const PCRE2_ALLOW_EMPTY_CLASS: u32 = 0x0000_0001;\n40\tpub const PCRE2_ALT_BSUX: u32 = 0x0000_0002;\n41\tpub const PCRE2_AUTO_CALLOUT: u32 = 0x0000_0004;\n42\tpub const PCRE2_CASELESS: u32 = 0x0000_0008;\n43\tpub const PCRE2_DOLLAR_ENDONLY: u32 = 0x0000_0010;\n44\tpub const PCRE2_DOTALL: u32 = 0x0000_0020;\n45\tpub const PCRE2_DUPNAMES: u32 = 0x0000_0040;\n46\tpub const PCRE2_EXTENDED: u32 = 0x0000_0080;\n47\tpub const PCRE2_FIRSTLINE: u32 = 0x0000_0100;\n48\tpub const PCRE2_MATCH_UNSET_BACKREF: u32 = 0x0000_0200;\n49\tpub const PCRE2_MULTILINE: u32 = 0x0000_0400;\n50\tpub const PCRE2_NEVER_UCP: u32 = 0x0000_0800;\n51\tpub const PCRE2_NEVER_UTF: u32 = 0x0000_1000;\n52\tpub const PCRE2_NO_AUTO_CAPTURE: u32 = 0x0000_2000;\n53\tpub const PCRE2_NO_AUTO_POSSESS: u32 = 0x0000_4000;\n54\tpub const PCRE2_NO_DOTSTAR_ANCHOR: u32 = 0x0000_8000;\n55\tpub const PCRE2_NO_START_OPTIMIZE: u32 = 0x0001_0000;\n56\tpub const PCRE2_UCP: u32 = 0x0002_0000;\n57\tpub const PCRE2_UNGREEDY: u32 = 0x0004_0000;\n58\tpub const PCRE2_UTF: u32 = 0x0008_0000;\n59\tpub const PCRE2_NEVER_BACKSLASH_C: u32 = 0x0010_0000;\n60\tpub const PCRE2_ALT_CIRCUMFLEX: u32 = 0x0020_0000;\n61\tpub const PCRE2_ALT_VERBNAMES: u32 = 0x0040_0000;\n62\tpub const PCRE2_USE_OFFSET_LIMIT: u32 = 0x0080_0000;\n63\tpub const PCRE2_EXTENDED_MORE: u32 = 0x0100_0000;\n64\tpub const PCRE2_LITERAL: u32 = 0x0200_0000;\n65\tpub const PCRE2_MATCH_INVALID_UTF: u32 = 0x0400_0000;\n66\tpub const PCRE2_ALT_EXTENDED_CLASS: u32 = 0x0800_0000;\n67\t\n68\tpub const PCRE2_EXTRA_ALLOW_SURROGATE_ESCAPES: u32 = 0x0000_0001;\n69\tpub const PCRE2_EXTRA_BAD_ESCAPE_IS_LITERAL: u32 = 0x0000_0002;\n70\tpub const PCRE2_EXTRA_MATCH_WORD: u32 = 0x0000_0004;\n71\tpub const PCRE2_EXTRA_MATCH_LINE: u32 = 0x0000_0008;\n72\tpub const PCRE2_EXTRA_ESCAPED_CR_IS_LF: u32 = 0x0000_0010;\n73\tpub const PCRE2_EXTRA_ALT_BSUX: u32 = 0x0000_0020;\n74\tpub const PCRE2_EXTRA_ALLOW_LOOKAROUND_BSK: u32 = 0x0000_0040;\n75\tpub const PCRE2_EXTRA_CASELESS_RESTRICT: u32 = 0x0000_0080;\n76\tpub const PCRE2_EXTRA_ASCII_BSD: u32 = 0x0000_0100;\n77\tpub const PCRE2_EXTRA_ASCII_BSS: u32 = 0x0000_0200;\n78\tpub const PCRE2_EXTRA_ASCII_BSW: u32 = 0x0000_0400;\n79\tpub const PCRE2_EXTRA_ASCII_POSIX: u32 = 0x0000_0800;\n80\tpub const PCRE2_EXTRA_ASCII_DIGIT: u32 = 0x0000_1000;\n81\tpub const PCRE2_EXTRA_PYTHON_OCTAL: u32 = 0x0000_2000;\n82\tpub const PCRE2_EXTRA_NO_BS0: u32 = 0x0000_4000;\n83\tpub const PCRE2_EXTRA_NEVER_CALLOUT: u32 = 0x0000_8000;\n84\tpub const PCRE2_EXTRA_TURKISH_CASING: u32 = 0x0001_0000;\n85\t\n86\tpub const PCRE2_JIT_COMPLETE: u32 = 0x0000_0001;\n87\tpub const PCRE2_JIT_PARTIAL_SOFT: u32 = 0x0000_0002;\n88\tpub const PCRE2_JIT_PARTIAL_HARD: u32 = 0x0000_0004;\n89\tpub const PCRE2_JIT_INVALID_UTF: u32 = 0x0000_0100;\n90\tpub const PCRE2_JIT_TEST_ALLOC: u32 = 0x0000_0200;\n91\t\n92\tpub const PCRE2_NOTBOL: u32 = 0x0000_0001;\n93\tpub const PCRE2_NOTEOL: u32 = 0x0000_0002;\n94\tpub const PCRE2_NOTEMPTY: u32 = 0x0000_0004;\n95\tpub const PCRE2_NOTEMPTY_ATSTART: u32 = 0x0000_0008;\n96\tpub const PCRE2_PARTIAL_SOFT: u32 = 0x0000_0010;\n97\tpub const PCRE2_PARTIAL_HARD: u32 = 0x0000_0020;\n98\tpub const PCRE2_DFA_RESTART: u32 = 0x0000_0040;\n99\tpub const PCRE2_DFA_SHORTEST: u32 = 0x0000_0080;\n100\tpub const PCRE2_SUBSTITUTE_GLOBAL: u32 = 0x0000_0100;\n101\tpub const PCRE2_SUBSTITUTE_EXTENDED: u32 = 0x0000_0200;\n102\tpub const PCRE2_SUBSTITUTE_UNSET_EMPTY: u32 = 0x0000_0400;\n103\tpub const PCRE2_SUBSTITUTE_UNKNOWN_UNSET: u32 = 0x0000_0800;\n104\tpub const PCRE2_SUBSTITUTE_OVERFLOW_LENGTH: u32 = 0x0000_1000;\n105\tpub const PCRE2_NO_JIT: u32 = 0x0000_2000;\n106\tpub const PCRE2_COPY_MATCHED_SUBJECT: u32 = 0x0000_4000;\n107\tpub const PCRE2_SUBSTITUTE_LITERAL: u32 = 0x0000_8000;\n108\tpub const PCRE2_SUBSTITUTE_MATCHED: u32 = 0x0001_0000;\n109\tpub const PCRE2_SUBSTITUTE_REPLACEMENT_ONLY: u32 = 0x0002_0000;\n110\tpub const PCRE2_DISABLE_RECURSELOOP_CHECK: u32 = 0x0004_0000;\n111\t\n112\tpub const PCRE2_CONVERT_UTF: u32 = 0x0000_0001;\n113\tpub const PCRE2_CONVERT_NO_UTF_CHECK: u32 = 0x0000_0002;\n114\tpub const PCRE2_CONVERT_POSIX_BASIC: u32 = 0x0000_0004;\n115\tpub const PCRE2_CONVERT_POSIX_EXTENDED: u32 = 0x0000_0008;\n116\tpub const PCRE2_CONVERT_GLOB: u32 = 0x0000_0010;\n117\tpub const PCRE2_CONVERT_GLOB_NO_WILD_SEPARATOR: u32 = 0x0000_0030;\n118\tpub const PCRE2_CONVERT_GLOB_NO_STARSTAR: u32 = 0x0000_0050;\n119\t\n120\tpub const PCRE2_NEWLINE_CR: u32 = 1;\n121\tpub const PCRE2_NEWLINE_LF: u32 = 2;\n122\tpub const PCRE2_NEWLINE_CRLF: u32 = 3;\n123\tpub const PCRE2_NEWLINE_ANY: u32 = 4;\n124\tpub const PCRE2_NEWLINE_ANYCRLF: u32 = 5;\n125\tpub const PCRE2_NEWLINE_NUL: u32 = 6;\n126\t\n127\tpub const PCRE2_BSR_UNICODE: u32 = 1;\n128\tpub const PCRE2_BSR_ANYCRLF: u32 = 2;\n129\t\n130\tpub const PCRE2_INFO_ALLOPTIONS: u32 = 0;\n131\tpub const PCRE2_INFO_ARGOPTIONS: u32 = 1;\n132\tpub const PCRE2_INFO_BACKREFMAX: u32 = 2;\n133\tpub const PCRE2_INFO_BSR: u32 = 3;\n134\tpub const PCRE2_INFO_CAPTURECOUNT: u32 = 4;\n135\tpub const PCRE2_INFO_FIRSTCODEUNIT: u32 = 5;\n136\tpub const PCRE2_INFO_FIRSTCODETYPE: u32 = 6;\n137\tpub const PCRE2_INFO_FIRSTBITMAP: u32 = 7;\n138\tpub const PCRE2_INFO_HASCRORLF: u32 = 8;\n139\tpub const PCRE2_INFO_JCHANGED: u32 = 9;\n140\tpub const PCRE2_INFO_JITSIZE: u32 = 10;\n141\tpub const PCRE2_INFO_LASTCODEUNIT: u32 = 11;\n142\tpub const PCRE2_INFO_LASTCODETYPE: u32 = 12;\n143\tpub const PCRE2_INFO_MATCHEMPTY: u32 = 13;\n144\tpub const PCRE2_INFO_MATCHLIMIT: u32 = 14;\n145\tpub const PCRE2_INFO_MAXLOOKBEHIND: u32 = 15;\n146\tpub const PCRE2_INFO_MINLENGTH: u32 = 16;\n147\tpub const PCRE2_INFO_NAMECOUNT: u32 = 17;\n148\tpub const PCRE2_INFO_NAMEENTRYSIZE: u32 = 18;\n149\tpub const PCRE2_INFO_NAMETABLE: u32 = 19;\n150\tpub const PCRE2_INFO_NEWLINE: u32 = 20;\n151\tpub const PCRE2_INFO_DEPTHLIMIT: u32 = 21;\n152\tpub const PCRE2_INFO_SIZE: u32 = 22;\n153\tpub const PCRE2_INFO_HASBACKSLASHC: u32 = 23;\n154\tpub const PCRE2_INFO_FRAMESIZE: u32 = 24;\n155\tpub const PCRE2_INFO_HEAPLIMIT: u32 = 25;\n156\tpub const PCRE2_INFO