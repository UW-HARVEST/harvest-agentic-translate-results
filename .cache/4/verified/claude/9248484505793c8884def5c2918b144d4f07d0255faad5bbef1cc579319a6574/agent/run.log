{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_019X3Es6Vdp5NYES9ufeUFhr","type":"tool_result","content":"1\t// Phase B sign-off for CONFIGS.md rows 445-456:\n2\t//   * the exported read-only data tables, cross-checked against the BEHAVIOUR\n3\t//     they drive (not just dumped), and\n4\t//   * the no-JIT stub arms, including the option-validation side effect that\n5\t//     `pcre2_jit_compile_8` leaves behind on `re->overall_options`.\n6\t\n7\tmod common;\n8\tuse common::*;\n9\tuse std::ffi::{c_int, CStr};\n10\tuse std::ptr;\n11\t\n12\tpub const COVERAGE: &[CfgCov] = &[\n13\t    CfgCov { cfg_rows: &[445], note: \"_pcre2_OP_lengths_8 dump + opcode-walk consistency\" },\n14\t    CfgCov { cfg_rows: &[446], note: \"_pcre2_default_tables_8 dump + per-region behaviour cross-check\" },\n15\t    CfgCov { cfg_rows: &[447], note: \"hspace/vspace lists + \\\\h/\\\\v matching, UTF and non-UTF\" },\n16\t    CfgCov { cfg_rows: &[448], note: \"utf8_table1..4 + size, cross-checked against ord2utf/valid_utf\" },\n17\t    CfgCov { cfg_rows: &[449], note: \"utt / utt_names / utt_size + every entry resolvable via \\\\p{name}\" },\n18\t    CfgCov { cfg_rows: &[450], note: \"ucp_gentype, ucp_gbtable, posix_class_maps, callout delimiters\" },\n19\t    CfgCov { cfg_rows: &[451], note: \"all _pcre2_ucd_* tables, full dumps\" },\n20\t    CfgCov { cfg_rows: &[452], note: \"jit_compile PCRE2_JIT_TEST_ALLOC alone vs combined\" },\n21\t    CfgCov { cfg_rows: &[453], note: \"jit_compile NULL code, out-of-range bits, valid mode bits\" },\n22\t    CfgCov { cfg_rows: &[454], note: \"jit_compile PCRE2_JIT_INVALID_UTF side effect on overall_options\" },\n23\t    CfgCov { cfg_rows: &[455], note: \"jit_stack_create/assign/free, jit_free_unused_memory\" },\n24\t    CfgCov { cfg_rows: &[456], note: \"_pcre2_jit_get_target/get_size/free/free_rodata\" },\n25\t];\n26\t\n27\t#[test]\n28\tfn coverage_declaration_is_sane() {\n29\t    check_coverage_decl(COVERAGE);\n30\t}\n31\t\n32\t// --------------------------------------------------------------- helpers\n33\t\n34\tunsafe fn compile(api: &Api, pat: &[u8], opts: u32) -> Ptr {\n35\t    let (mut ec, mut eo) = (0 as c_int, 0usize);\n36\t    (api.compile)(pat.as_ptr(), pat.len(), opts, &mut ec, &mut eo, ptr::null_mut())\n37\t}\n38\t\n39\t/// Does `pat` match `subj` (rc >= 0)?  Compared between the two libraries.\n40\tunsafe fn both_match(p: &Pair, pat: &[u8], opts: u32, subj: &[u8], d: &mut Diffs, tag: &str) {\n41\t    let a = compile(&p.c, pat, opts);\n42\t    let b = compile(&p.r, pat, opts);\n43\t    d.eq(&format!(\"{tag} compile null?\"), a.is_null(), b.is_null());\n44\t    if a.is_null() || b.is_null() {\n45\t        if !a.is_null() {\n46\t            (p.c.code_free)(a);\n47\t        }\n48\t        if !b.is_null() {\n49\t            (p.r.code_free)(b);\n50\t        }\n51\t        return;\n52\t    }\n53\t    assert_code_eq(a, b, tag);\n54\t    let mda = (p.c.match_data_create)(4, ptr::null_mut());\n55\t    let mdb = (p.r.match_data_create)(4, ptr::null_mut());\n56\t    let ra = (p.c.do_match)(a, subj.as_ptr(), subj.len(), 0, 0, mda, ptr::null_mut());\n57\t    let rb = (p.r.do_match)(b, subj.as_ptr(), subj.len(), 0, 0, mdb, ptr::null_mut());\n58\t    d.eq(tag, read_match_out(&p.c, mda, ra), read_match_out(&p.r, mdb, rb));\n59\t    (p.c.match_data_free)(mda);\n60\t    (p.r.match_data_free)(mdb);\n61\t    (p.c.code_free)(a);\n62\t    (p.r.code_free)(b);\n63\t}\n64\t\n65\tfn utf8_of(cp: u32) -> Vec<u8> {\n66\t    let mut b = [0u8; 4];\n67\t    char::from_u32(cp).unwrap().encode_utf8(&mut b).as_bytes().to_vec()\n68\t}\n69\t\n70\t// ============================================ row 445: OP_lengths\n71\t\n72\t#[test]\n73\tfn cfg_445_op_lengths() {\n74\t    let p = pair();\n75\t    let mut d = Diffs::new();\n76\t    unsafe {\n77\t        let (a, b) = (p.c.data(\"_pcre2_OP_lengths_8\"), p.r.data(\"_pcre2_OP_lengths_8\"));\n78\t        let (sa, sb) = (\n79\t            std::slice::from_raw_parts(a, 173),\n80\t            std::slice::from_raw_parts(b, 173),\n81\t        );\n82\t        d.eq(\"_pcre2_OP_lengths_8 full dump\", sa.to_vec(), sb.to_vec());\n83\t        // Walk the fixed-length opcode prefix of every corpus pattern using each\n84\t        // library's own table; the walks must agree step for step.\n85\t        for pat in PATTERNS {\n86\t            let pb = pat.as_bytes();\n87\t            let ka = compile(&p.c, pb, 0);\n88\t            let kb = compile(&p.r, pb, 0);\n89\t            if ka.is_null() || kb.is_null() {\n90\t                if !ka.is_null() {\n91\t                    (p.c.code_free)(ka);\n92\t                }\n93\t                if !kb.is_null() {\n94\t                    (p.r.code_free)(kb);\n95\t                }\n96\t                continue;\n97\t            }\n98\t            let walk = |code: Ptr, tbl: &[u8]| -> Vec<(usize, u8)> {\n99\t                let start = bytecode_ptr(code);\n100\t                let n = code_blocksize(code) - (start as usize - code as usize);\n101\t                let by = std::slice::from_raw_parts(start, n);\n102\t                let mut steps = Vec::new();\n103\t                let mut i = 0usize;\n104\t                while i < n && steps.len() < 4096 {\n105\t                    let op = by[i];\n106\t                    steps.push((i, op));\n107\t                    let l = tbl[op as usize] as usize;\n108\t                    if l == 0 {\n109\t                        break; // variable-length opcode: stop, both must stop here\n110\t                    }\n111\t                    i += l;\n112\t                }\n113\t                steps\n114\t            };\n115\t            d.eq(\n116\t                &format!(\"OP_lengths walk of {}\", show(pb)),\n117\t                walk(ka, sa),\n118\t                walk(kb, sb),\n119\t            );\n120\t            (p.c.code_free)(ka);\n121\t            (p.r.code_free)(kb);\n122\t        }\n123\t    }\n124\t    d.finish(\"CONFIGS 445: _pcre2_OP_lengths_8 dump + opcode-walk consistency over all corpus patterns\");\n125\t}\n126\t\n127\t// ============================ row 446: default tables vs behaviour\n128\t\n129\t#[test]\n130\tfn cfg_446_default_tables() {\n131\t    let p = pair();\n132\t    let mut d = Diffs::new();\n133\t    unsafe {\n134\t        let mut len = 0u32;\n135\t        (p.c.config)(PCRE2_CONFIG_TABLES_LENGTH, &mut len as *mut u32 as Ptr);\n136\t        let n = len as usize;\n137\t        let (a, b) = (p.c.data(\"_pcre2_default_tables_8\"), p.r.data(\"_pcre2_default_tables_8\"));\n138\t        d.eq(\n139\t            \"_pcre2_default_tables_8 full dump\",\n140\t            std::slice::from_raw_parts(a, n).to_vec(),\n141\t            std::slice::from_raw_parts(b, n).to_vec(),\n142\t        );\n143\t        // Cross-check every table region through the behaviour it drives, for\n144\t        // all 256 single-byte subjects.\n145\t        let probes: &[(&str, u32)] = &[\n146\t            (\"\\\\d\", 0),\n147\t            (\"\\\\D\", 0),\n148\t            (\"\\\\w\", 0),\n149\t            (\"\\\\W\", 0),\n150\t            (\"\\\\s\", 0),\n151\t            (\"\\\\S\", 0),\n152\t            (\"[[:alpha:]]\", 0),\n153\t            (\"[[:alnum:]]\", 0),\n154\t            (\"[[:lower:]]\", 0),\n155\t            (\"[[:upper:]]\", 0),\n156\t            (\"[[:digit:]]\", 0),\n157\t            (\"[[:xdigit:]]\", 0),\n158\t            (\"[[:space:]]\", 0),\n159\t            (\"[[:graph:]]\", 0),\n160\t            (\"[[:print:]]\", 0),\n161\t            (\"[[:punct:]]\", 0),\n162\t            (\"[[:cntrl:]]\", 0),\n163\t            (\"[[:word:]]\", 0),\n164\t            (\"[[:ascii:]]\", 0),\n165\t            (\"[[:blank:]]\", 0),\n166\t            // the lowercase / case-flip tables\n167\t            (\"a\", PCRE2_CASELESS),\n168\t            (\"Z\", PCRE2_CASELESS),\n169\t            (\"[a-f]\", PCRE2_CASELESS),\n170\t            (\"(?i)[X-Z]\", 0),\n171\t        ];\n172\t        for &(pat, opts) in probes {\n173\t            for byte in 0u8..=255 {\n174\t                let subj = [byte];\n175\t                both_match(\n176\t                    p,\n177\t                    pat.as_bytes(),\n178\t                    opts,\n179\t                    &subj,\n180\t                    &mut d,\n181\t                    &format!(\"tables probe {pat} vs {byte:#04x}\"),\n182\t                );\n183\t            }\n184\t        }\n185\t    }\n186\t    d.finish(\"CONFIGS 446: _pcre2_default_tables_8 dump + all class/case regions over all 256 bytes\");\n187\t}\n188\t\n189\t// ==================== row 447: hspace / vspace lists vs \\h and \\v\n190\t\n191\t#[test]\n192\tfn cfg_447_hspace_vspace() {\n193\t    let p = pair();\n194\t    let mut d = Diffs::new();\n195\t    unsafe {\n196\t        for (sym, len) in [(\"_pcre2_hspace_list_8\", 80usize), (\"_pcre2_vspace_list_8\", 32)] {\n197\t            d.eq(\n198\t                &format!(\"{sym} full dump\"),\n199\t                std::slice::from_raw_parts(p.c.data(sym), len).to_vec(),\n200\t                std::slice::from_raw_parts(p.r.data(sym), len).to_vec(),\n201\t            );\n202\t        }\n203\t        // Read the code points out of the C table and drive \\h / \\v with each,\n204\t        // in UTF and non-UTF mode, plus the ones just outside each list.\n205\t        let read_list = |sym: &str, len: usize| -> Vec<u32> {\n206\t            let base = p.c.data(sym) as *const u32;\n207\t            (0..len / 4).map(|i| *base.add(i)).collect()\n208\t        };\n209\t        let hs = read_list(\"_pcre2_hspace_list_8\", 80);\n210\t        let vs = read_list(\"_pcre2_vspace_list_8\", 32);\n211\t        println!(\"hspace list = {hs:#x?}\\nvspace list = {vs:#x?}\");\n212\t        let mut cps: Vec<u32> = Vec::new();\n213\t        for v in hs.iter().chain(vs.iter()) {\n214\t            if *v == u32::MAX || *v > 0x10_FFFF {\n215\t                continue;\n216\t            }\n217\t            cps.push(*v);\n218\t            if *v > 0 {\n219\t                cps.push(*v - 1);\n220\t            }\n221\t            cps.push(*v + 1);\n222\t        }\n223\t        cps.extend([0, 0x20, 0x41, 0x7f, 0x80, 0xa0, 0xff, 0x100, 0x2000, 0x3000]);\n224\t        cps.sort_unstable();\n225\t        cps.dedup();\n226\t        for &cp in &cps {\n227\t            if cp > 0x10_FFFF || (0xd800..=0xdfff).contains(&cp) {\n228\t                continue;\n229\t            }\n230\t            let utf = utf8_of(cp);\n231\t            for pat in [\"\\\\h\", \"\\\\H\", \"\\\\v\", \"\\\\V\", \"[\\\\h]\", \"[\\\\v]\", \"[^\\\\h\\\\v]\", \"\\\\R\"] {\n232\t                // UTF mode: full code point\n233\t                both_match(\n234\t                    p,\n235\t                    pat.as_bytes(),\n236\t                    PCRE2_UTF,\n237\t                    &utf,\n238\t                    &mut d,\n239\t                    &format!(\"{pat} UTF U+{cp:04X}\"),\n240\t                );\n241\t                // non-UTF: single byte only\n242\t                if cp < 0x100 {\n243\t                    both_match(\n244\t                        p,\n245\t                        pat.as_bytes(),\n246\t                        0,\n247\t                        &[cp as u8],\n248\t                        &mut d,\n249\t                        &format!(\"{pat} 8-bit {cp:#04x}\"),\n250\t                    );\n251\t                }\n252\t            }\n253\t        }\n254\t    }\n255\t    d.finish(\"CONFIGS 447: hspace/vspace dumps cross-checked against \\\\h \\\\H \\\\v \\\\V \\\\R in UTF and 8-bit\");\n256\t}\n257\t\n258\t// =============== row 448: utf8_table1..4 vs ord2utf / valid_utf\n259\t\n260\t#[test]\n261\tfn cfg_448_utf8_tables() {\n262\t    let p = pair();\n263\t    let mut d = Diffs::new();\n264\t    unsafe {\n265\t        for (sym, len) in [\n266\t            (\"_pcre2_utf8_table1\", 24usize),\n267\t            (\"_pcre2_utf8_table1_size\", 4),\n268\t            (\"_pcre2_utf8_table2\", 24),\n269\t            (\"_pcre2_utf8_table3\", 24),\n270\t            (\"_pcre2_utf8_table4\", 64),\n271\t        ] {\n272\t            d.eq(\n273\t                &format!(\"{sym} full dump\"),\n274\t                std::slice::from_raw_parts(p.c.data(sym), len).to_vec(),\n275\t                std::slice::from_raw_parts(p.r.data(sym), len).to_vec(),\n276\t            );\n277\t        }\n278\t        let size = *(p.c.data(\"_pcre2_utf8_table1_size\") as *const u32);\n279\t        assert_eq!(size, 6, \"utf8_table1_size must be 6\");\n280\t        let t1 = p.c.data(\"_pcre2_utf8_table1\") as *const i32;\n281\t        let bands: Vec<i32> = (0..6).map(|i| *t1.add(i)).collect();\n282\t        println!(\"utf8_table1 bands = {bands:#x?}\");\n283\t        // Cross-check ord2utf band selection at each band edge and just past it.\n284\t        let mut probes: Vec<u32> = vec![0];\n285\t        for &b in &bands {\n286\t            let b = b as u32;\n287\t            probes.extend([b.wrapping_sub(1), b, b.wrapping_add(1)]);\n288\t        }\n289\t        probes.extend([0x10_FFFF, 0x11_0000, 0x7FFF_FFFF, 0x8000_0000, u32::MAX]);\n290\t        for &cp in &probes {\n291\t            let mut ba = [0xEEu8; 16];\n292\t            let mut bb = [0xEEu8; 16];\n293\t            let na = (p.c.p_ord2utf)(cp, ba.as_mut_ptr());\n294\t            let nb = (p.r.p_ord2utf)(cp, bb.as_mut_ptr());\n295\t            d.eq(&format!(\"ord2utf band U+{cp:X} len\"), na, nb);\n296\t            d.eq(&format!(\"ord2utf band U+{cp:X} bytes\"), ba, bb);\n297\t            // and feed the encoding straight back into the validator\n298\t            let enc = ba[..na as usize].to_vec();\n299\t            let (mut oa, mut ob) = (usize::MAX, usize::MAX);\n300\t            d.eq(\n301\t                &format!(\"valid_utf(ord2utf(U+{cp:X})) rc\"),\n302\t                (p.c.p_valid_utf)(enc.as_ptr(), enc.len(), &mut oa),\n303\t                (p.r.p_valid_utf)(enc.as_ptr(), enc.len(), &mut ob),\n304\t            );\n305\t            d.eq(&format!(\"valid_utf(ord2utf(U+{cp:X})) off\"), oa, ob);\n306\t        }\n307\t        // utf8_table4 gives the number of additional bytes per lead byte: check\n308\t        // the validator's behaviour for every possible lead byte, truncated.\n309\t        for lead in 0xC0u8..=0xFF {\n310\t            for extra in 0usize..=5 {\n311\t                let mut s = vec![lead];\n312\t                s.extend(std::iter::repeat(0x80u8).take(extra));\n313\t                let (mut oa, mut ob) = (usize::MAX, usize::MAX);\n314\t                d.eq(\n315\t                    &format!(\"valid_utf lead {lead:#04x} +{extra} rc\"),\n316\t                    (p.c.p_valid_utf)(s.as_ptr(), s.len(), &mut oa),\n317\t                    (p.r.p_valid_utf)(s.as_ptr(), s.len(), &mut ob),\n318\t                );\n319\t                d.eq(&format!(\"valid_utf lead {lead:#04x} +{extra} off\"), oa, ob);\n320\t            }\n321\t        }\n322\t    }\n323\t    d.finish(\"CONFIGS 448: utf8_table1..4 dumps + ord2utf band edges + valid_utf over every lead byte\");\n324\t}\n325\t\n326\t// ================= row 449: utt / utt_names vs \\p{name} compiles\n327\t\n328\t#[test]\n329\tfn cfg_449_utt_tables() {\n330\t    let p = pair();\n331\t    let mut d = Diffs::new();\n332\t    unsafe {\n333\t        for (sym, len) in [\n334\t            (\"_pcre2_utt_8\", 3108usize),\n335\t            (\"_pcre2_utt_names_8\", 3834),\n336\t            (\"_pcre2_utt_size_8\", 8),\n337\t        ] {\n338\t            d.eq(\n339\t                &format!(\"{sym} full dump\"),\n340\t                std::slice::from_raw_parts(p.c.data(sym), len).to_vec(),\n341\t                std::slice::from_raw_parts(p.r.data(sym), len).to_vec(),\n342\t            );\n343\t        }\n344\t        let utt_size = *(p.c.data(\"_pcre2_utt_size_8\") as *const usize);\n345\t        println!(\"utt_size = {utt_size}\");\n346\t        assert_eq!(utt_size * 6, 3108, \"utt entry size should be 6 bytes\");\n347\t        // Every property name in the table must compile identically via \\p{...}\n348\t        // and \\P{...}, and must then match/not-match identically.\n349\t        let utt = p.c.data(\"_pcre2_utt_8\") as *const u16;\n350\t        let names = p.c.data(\"_pcre2_utt_names_8\") as *const u8;\n351\t        let mut tested = 0;\n352\t        for i in 0..utt_size {\n353\t            let name_off = *utt.add(i * 3) as usize;\n354\t            let nm = CStr::from_ptr(names.add(name_off) as *const i8)\n355\t                .to_str()\n356\t                .expect(\"property name is ASCII\");\n357\t            for form in [\n358\t                format!(\"\\\\p{{{nm}}}\"),\n359\t                format!(\"\\\\P{{{nm}}}\"),\n360\t                format!(\"[\\\\p{{{nm}}}]\"),\n361\t            ] {\n362\t                let pb = form.as_bytes();\n363\t                for opts in [PCRE2_UTF | PCRE2_UCP, PCRE2_UCP] {\n364\t                    let a = compile(&p.c, pb, opts);\n365\t                    let b = compile(&p.r, pb, opts);\n366\t                    d.eq(&format!(\"compile {form} null?\"), a.is_null(), b.is_null());\n367\t                    if !a.is_null() && !b.is_null() {\n368\t                        assert_code_eq(a, b, &format!(\"utt {form}\"));\n369\t                        tested += 1;\n370\t                    }\n371\t                    if !a.is_null() {\n372\t                        (p.c.code_free)(a);\n373\t                    }\n374\t                    if !b.is_null() {\n375\t                        (p.r.code_free)(b);\n376\t                    }\n377\t                }\n378\t            }\n379\t        }\n380\t        println!(\"compiled {tested} \\\\p/\\\\P forms from the utt table\");\n381\t        assert!(tested > 1000, \"expected to exercise most of the utt table\");\n382\t        // loose matching and the sc:/scx:/bc: prefixes\n383\t        for form in [\n384\t            \"\\\\p{Latin}\", \"\\\\p{latin}\", \"\\\\p{LATIN}\", \"\\\\p{ Latin }\", \"\\\\p{L_a-t_i n}\",\n385\t            \"\\\\p{sc:Latin}\", \"\\\\p{scx:Latin}\", \"\\\\p{bc:L}\", \"\\\\p{Script=Latin}\",\n386\t            \"\\\\p{Script_Extensions=Latin}\", \"\\\\p{General_Category=Lu}\", \"\\\\p{gc=Lu}\",\n387\t            \"\\\\p{Bidi_Class=AL}\", \"\\\\p{Is_Latin}\", \"\\\\p{IsLatin}\", \"\\\\p{nonesuch}\",\n388\t            \"\\\\p{sc:nonesuch}\", \"\\\\p{=}\", \"\\\\p{:}\", \"\\\\p{}\",\n389\t        ] {\n390\t            let pb = form.as_bytes();\n391\t            let (mut e1, mut e2) = (0 as c_int, 0 as c_int);\n392\t            let (mut f1, mut f2) = (0usize, 0usize);\n393\t            let a = (p.c.compile)(pb.as_ptr(), pb.len(), PCRE2_UTF | PCRE2_UCP, &mut e1, &mut f1, ptr::null_mut());\n394\t            let b = (p.r.compile)(pb.as_ptr(), pb.len(), PCRE2_UTF | PCRE2_UCP, &mut e2, &mut f2, ptr::null_mut());\n395\t            d.eq(&format!(\"loose-name {form} null?\"), a.is_null(), b.is_null());\n396\t            d.eq(&format!(\"loose-name {form} ec\"), e1, e2);\n397\t            d.eq(&format!(\"loose-name {form} eo\"), f1, f2);\n398\t            if !a.is_null() && !b.is_null() {\n399\t                assert_code_eq(a, b, &format!(\"loose {form}\"));\n400\t            }\n401\t            if !a.is_null() {\n402\t                (p.c.code_free)(a);\n403\t            }\n404\t            if !b.is_null() {\n405\t                (p.r.code_free)(b);\n406\t            }\n407\t        }\n408\t    }\n409\t    d.finish(\"CONFIGS 449: utt/utt_names/utt_size dumps + every entry compiled via \\\\p{}/\\\\P{} + loose matching\");\n410\t}\n411\t\n412\t// ============ row 450: gentype / gbtable / posix maps / callout delims\n413\t\n414\t#[test]\n415\tfn cfg_450_misc_tables() {\n416\t    let p = pair();\n417\t    let mut d = Diffs::new();\n418\t    unsafe {\n419\t        for (sym, len) in [\n420\t            (\"_pcre2_ucp_gentype_8\", 120usize),\n421\t            (\"_pcre2_ucp_gbtable_8\", 60),\n422\t            (\"_pcre2_posix_class_maps8\", 168),\n423\t            (\"_pcre2_callout_start_delims_8\", 36),\n424\t            (\"_pcre2_callout_end_delims_8\", 36),\n425\t        ] {\n426\t            d.eq(\n427\t                &format!(\"{sym} full dump\"),\n428\t                std::slice::from_raw_parts(p.c.data(sym), len).to_vec(),\n429\t                std::slice::from_raw_parts(p.r.data(sym), len).to_vec(),\n430\t            );\n431\t        }\n432\t        // gbtable drives _pcre2_extuni_8: exercise it over a grapheme corpus.\n433\t        let pieces: &[&[u8]] = &[\n434\t            b\"a\", b\"\\xcc\\x81\", b\"\\xe2\\x80\\x8d\", b\"\\xf0\\x9f\\x87\\xa6\", b\"\\xf0\\x9f\\x87\\xa7\",\n435\t            b\"\\xe1\\x84\\x80\", b\"\\xe1\\x85\\xa1\", b\"\\xe1\\x86\\xa8\", b\"\\xf0\\x9f\\x91\\xa8\",\n436\t            b\"\\xe2\\x9d\\xa4\", b\"\\xef\\xb8\\x8f\", b\"\\xe0\\xa4\\xa8\", b\"\\xe0\\xa4\\xbe\", b\"\\r\", b\"\\n\",\n437\t        ];\n438\t        let mut rng = Rng::new(4500);\n439\t        for _ in 0..3000 {\n440\t            let mut s = Vec::new();\n441\t            for _ in 0..rng.range(1, 6) {\n442\t                s.extend_from_slice(rng.pick_bytes(pieces));\n443\t            }\n444\t            let Ok(t) = std::str::from_utf8(&s) else { continue };\n445\t            let ch = t.chars().next().unwrap();\n446\t            let start = s.as_ptr();\n447\t            let end = start.add(s.len());\n448\t            let eptr = start.add(ch.len_utf8());\n449\t            let (mut xa, mut xb) = (0 as c_int, 0 as c_int);\n450\t            let ra = (p.c.p_extuni)(ch as u32, eptr, start, end, 1, &mut xa);\n451\t            let rb = (p.r.p_extuni)(ch as u32, eptr, start, end, 1, &mut xb);\n452\t            d.eq(\n453\t                &format!(\"gbtable/extuni {}\", show(&s)),\n454\t                (ra as usize - start as usize, xa),\n455\t                (rb as usize - start as usize, xb),\n456\t            );\n457\t            // and \\X over the same data\n458\t            both_match(p, b\"\\\\X\", PCRE2_UTF, &s, &mut d, &format!(\"\\\\X {}\", show(&s)));\n459\t        }\n460\t        //