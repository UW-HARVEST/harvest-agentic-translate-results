 = 0; *message != 0; i++)\n364\t  {\n365\t  if (i >= size - 1)\n366\t    {\n367\t    rc = PCRE2_ERROR_NOMEMORY;\n368\t    break;\n369\t    }\n370\t  buffer[i] = *message++;\n371\t  }\n372\t\n373\t#if defined EBCDIC && 'a' != 0x81\n374\t/* If compiling for EBCDIC, but the compiler's string literals are not EBCDIC,\n375\tthen we are in the \"force EBCDIC 1047\" mode. I have chosen to add a few lines\n376\there to translate the error strings on the fly, rather than require the string\n377\tliterals above to be written out arduously using the \"STR_XYZ\" macros. */\n378\tfor (PCRE2_SIZE j = 0; j < i; ++j)\n379\t  buffer[j] = PRIV(ascii_to_ebcdic_1047)[buffer[j]];\n380\t#endif\n381\t\n382\tbuffer[i] = 0;     /* Terminate message, even if truncated. */\n383\treturn rc? rc : (int)i;\n384\t}\n385\t\n386\t/* End of pcre2_error.c */\n387\t"}]},"parent_tool_use_id":"toolu_bdrk_01M8Xd1f59tGBgncMaSd2ciT","session_id":"cde48455-d5ce-4cd5-a0b0-2154082e5ad7","uuid":"c58a5be7-8e7a-44db-b75e-5175e7f34766","timestamp":"2026-08-23T10:11:37.441Z","subagent_type":"general-purpose","task_description":"Produce ERRORS.md error surface table"}
