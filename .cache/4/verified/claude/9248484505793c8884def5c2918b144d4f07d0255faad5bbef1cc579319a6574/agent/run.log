equired_len = 1 + (32 / sizeof(PCRE2_UCHAR));\n2645\t\n2646\t    if (lengthptr != NULL)\n2647\t      {\n2648\t      if (required_len > (*lengthptr - previous_length))\n2649\t      *lengthptr = previous_length + required_len;\n2650\t      }\n2651\t\n2652\t    /* Advancing code means rewinding lengthptr, at this point. */\n2653\t    if (lengthptr != NULL) *lengthptr -= required_len;\n2654\t    *code++ = (op_info.op_single_type == ECL_ANY)? OP_NCLASS : OP_CLASS;\n2655\t    memcpy(code, op_info.bits.classbits, 32);\n2656\t    code += 32 / sizeof(PCRE2_UCHAR);\n2657\t    }\n2658\t\n2659\t  /* Otherwise, we have an ECL_XCLASS, so we have the OP_XCLASS data\n2660\t  there, but, we pulled out its bitmap into op_info, so now we have to\n2661\t  put that back into the OP_XCLASS. */\n2662\t\n2663\t  else\n2664\t    {\n2665\t#ifndef SUPPORT_WIDE_CHARS\n2666\t    PCRE2_DEBUG_UNREACHABLE();\n2667\t#else\n2668\t    BOOL need_map = context.needs_bitmap;\n2669\t    PCRE2_SIZE required_len;\n2670\t\n2671\t    PCRE2_ASSERT(op_info.op_single_type == ECL_XCLASS);\n2672\t    required_len = op_info.length + (need_map? 32/sizeof(PCRE2_UCHAR) : 0);\n2673\t\n2674\t    if (lengthptr != NULL)\n2675\t      {\n2676\t      /* Don't unconditionally request all the space we need - we may\n2677\t      already have asked for more during processing of the ECLASS. */\n2678\t      if (required_len > (*lengthptr - previous_length))\n2679\t        *lengthptr = previous_length + required_len;\n2680\t\n2681\t      /* The code we write out here won't be ignored, even during the\n2682\t      (lengthptr != NULL) phase, because if there's a following quantifier\n2683\t      it will peek backwards. So we do have to write out a (truncated)\n2684\t      OP_XCLASS, even on this branch. */\n2685\t      *lengthptr -= 1 + LINK_SIZE + 1;\n2686\t      *code++ = OP_XCLASS;\n2687\t      PUT(code, 0, 1 + LINK_SIZE + 1);\n2688\t      code += LINK_SIZE;\n2689\t      *code++ = 0;\n2690\t      }\n2691\t    else\n2692\t      {\n2693\t      PCRE2_UCHAR *rest;\n2694\t      PCRE2_SIZE rest_len;\n2695\t      PCRE2_UCHAR flags;\n2696\t\n2697\t      /* 1 unit: OP_XCLASS | LINK_SIZE units | 1 unit: flags | ...rest */\n2698\t      PCRE2_ASSERT(op_info.length >= 1 + LINK_SIZE + 1);\n2699\t      rest = op_info.code_start + 1 + LINK_SIZE + 1;\n2700\t      rest_len = (op_info.code_start + op_info.length) - rest;\n2701\t\n2702\t      /* First read any data we use, before memmove splats it. */\n2703\t      flags = op_info.code_start[1 + LINK_SIZE];\n2704\t      PCRE2_ASSERT((flags & XCL_MAP) == 0);\n2705\t\n2706\t      /* Next do the memmove before any writes. */\n2707\t      memmove(code + 1 + LINK_SIZE + 1 + (need_map? 32/sizeof(PCRE2_UCHAR) : 0),\n2708\t              rest, CU2BYTES(rest_len));\n2709\t\n2710\t      /* Finally write the header data. */\n2711\t      *code++ = OP_XCLASS;\n2712\t      PUT(code, 0, (int)required_len);\n2713\t      code += LINK_SIZE;\n2714\t      *code++ = flags | (need_map? XCL_MAP : 0);\n2715\t      if (need_map)\n2716\t        {\n2717\t        memcpy(code, op_info.bits.classbits, 32);\n2718\t        code += 32 / sizeof(PCRE2_UCHAR);\n2719\t        }\n2720\t      code += rest_len;\n2721\t      }\n2722\t#endif /* SUPPORT_WIDE_CHARS */\n2723\t    }\n2724\t  }\n2725\t\n2726\t/* Otherwise, we're going to keep the OP_ECLASS. However, again we need\n2727\tto do some adjustment to insert the bitmap if we have one. */\n2728\t\n2729\t#ifdef SUPPORT_WIDE_CHARS\n2730\telse\n2731\t  {\n2732\t  BOOL need_map = context.needs_bitmap;\n2733\t  PCRE2_SIZE required_len =\n2734\t    1 + LINK_SIZE + 1 + (need_map? 32/sizeof(PCRE2_UCHAR) : 0) + op_info.length;\n2735\t\n2736\t  if (lengthptr != NULL)\n2737\t    {\n2738\t    if (required_len > (*lengthptr - previous_length))\n2739\t      *lengthptr = previous_length + required_len;\n2740\t\n2741\t    /* As for the XCLASS branch above, we do have to write out a dummy\n2742\t    OP_ECLASS, because of the backwards peek by the quantifier code. Wr