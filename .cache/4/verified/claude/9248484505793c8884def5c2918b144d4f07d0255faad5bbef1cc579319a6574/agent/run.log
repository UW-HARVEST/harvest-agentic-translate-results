{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_015V3tDZKSeXv9wDarvUD6rV","type":"tool_result","content":"874\t/*************************************************\n875\t*           XClass related properties            *\n876\t*************************************************/\n877\t\n878\t/* XClass needs to be generated. */\n879\t#define XCLASS_REQUIRED 0x1\n880\t/* XClass has 8 bit character. */\n881\t#define XCLASS_HAS_8BIT_CHARS 0x2\n882\t/* XClass has properties. */\n883\t#define XCLASS_HAS_PROPS 0x4\n884\t/* XClass has character lists. */\n885\t#define XCLASS_HAS_CHAR_LISTS 0x8\n886\t/* XClass matches to all >= 256 characters. */\n887\t#define XCLASS_HIGH_ANY 0x10\n888\t\n889\t#endif\n890\t\n891\t\n892\t/*************************************************\n893\t*   Internal entry point for add range to class  *\n894\t*************************************************/\n895\t\n896\t/* This function sets the overall range for characters < 256.\n897\tIt also handles non-utf case folding.\n898\t\n899\tArguments:\n900\t  options       the options bits\n901\t  xoptions      the extra options bits\n902\t  cb            compile data\n903\t  start         start of range character\n904\t  end           end of range character\n905\t\n906\tReturns:        cb->classbits is updated\n907\t*/\n908\t\n909\tstatic void\n910\tadd_to_class(uint32_t options, uint32_t xoptions, compile_block *cb,\n911\t  uint32_t start, uint32_t end)\n912\t{\n913\tuint8_t *classbits = cb->classbits.classbits;\n914\tuint32_t c, byte_start, byte_end;\n915\tuint32_t classbits_end = (end <= 0xff ? end : 0xff);\n916\t\n917\t#ifndef SUPPORT_UNICODE\n918\t(void)xoptions; /* Avoid compiler warning. */\n919\t#endif\n920\t\n921\t/* If caseless matching is required, scan the range and process alternate\n922\tcases. In Unicode, there are 8-bit characters that have alternate cases that\n923\tare greater than 255 and vice-versa (though these may be ignored if caseless\n924\trestriction is in force). Sometimes we can just extend the original range. */\n925\t\n926\tif ((options & PCRE2_CASELESS) != 0)\n927\t  {\n928\t#ifdef SUPPORT_UNICODE\n929\t  /* UTF mode. This branch is taken if we don't support wide characters (e.g.\n930\t  8-bit library, without UTF), but we do treat those characters as Unicode\n931\t  (if UCP flag is set). In this case, we only need to expand the character class\n932\t  set to include the case pairs which are in the 0-255 codepoint range. */\n933\t  if ((options & (PCRE2_UTF|PCRE2_UCP)) != 0)\n934\t    {\n935\t      BOOL turkish_i = (xoptions & (PCRE2_EXTRA_TURKISH_CASING|PCRE2_EXTRA_CASELESS_RESTRICT)) ==\n936\t        PCRE2_EXTRA_TURKISH_CASING;\n937\t      if (start < 128)\n938\t        {\n939\t        uint32_t lo_end = (classbits_end < 127 ? classbits_end : 127);\n940\t        for (c = start; c <= lo_end; c++)\n941\t          {\n942\t          if (turkish_i && UCD_ANY_I(c)) continue;\n943\t          SETBIT(classbits, cb->fcc[c]);\n944\t          }\n945\t        }\n946\t      if (classbits_end >= 128)\n947\t        {\n948\t        uint32_t hi_start = (start > 128 ? start : 128);\n949\t        for (c = hi_start; c <= classbits_end; c++)\n950\t          {\n951\t          uint32_t co = UCD_OTHERCASE(c);\n952\t          if (co <= 0xff) SETBIT(classbits, co);\n953\t          }\n954\t        }\n955\t    }\n956\t\n957\t  else\n958\t#endif  /* SUPPORT_UNICODE */\n959\t\n960\t  /* Not UTF mode */\n961\t    {\n962\t    for (c = start; c <= classbits_end; c++)\n963\t      SETBIT(classbits, cb->fcc[c]);\n964\t    }\n965\t  }\n966\t\n967\t/* Use the bitmap for characters < 256. Otherwise use extra data. */\n968\t\n969\tbyte_start = (start + 7) >> 3;\n970\tbyte_end = (classbits_end + 1) >> 3;\n971\t\n972\tif (byte_start >= byte_end)\n973\t  {\n974\t  for (c = start; c <= classbits_end; c++)\n975\t    /* Regardless of start, c will always be <= 255. */\n976\t    SETBIT(classbits, c);\n977\t  return;\n978\t  }\n979\t\n980\tfor (c = byte_start; c < byte_end; c++)\n981\t  classbits[c] = 0xff;\n982\t\n983\tbyte_start <<= 3;\n984\tbyte_end <<= 3;\n985\t\n986\tfor (c = start; c < byte_start; c++)\n987\t  SETBIT(classbits, c);\n988\t\n989\tfor (c = byte_end; c <= classbits_end; c++)\n990\t  SETBIT(classbits, c);\n991\t}\n992\t\n993\t\n994\t#if PCRE2_CODE_UNIT_WIDTH == 8\n995\t/*************************************************\n996\t*   Internal entry point for add list to class   *\n997\t*************************************************/\n998\t\n999\t/* This function is used for adding a list of horizontal or vertical whitespace\n1000\tcharacters to a class. The list must be in order so that ranges of characters\n1001\tcan be detected and handled appropriately. This function sets the overall range\n1002\tso that the internal functions can try to avoid duplication when handling\n1003\tcase-independence.\n1004\t\n1005\tArguments:\n1006\t  options       the options bits\n1007\t  xoptions      the extra options bits\n1008\t  cb            contains pointers to tables etc.\n1009\t  p             points to row of 32-bit values, terminated by NOTACHAR\n1010\t\n1011\tReturns:        cb->classbits is updated\n1012\t*/\n1013\t\n1014\tstatic void\n1015\tadd_list_to_class(uint32_t options, uint32_t xoptions, compile_block *cb,\n1016\t  const uint32_t *p)\n1017\t{\n1018\twhile (p[0] < 256)\n1019\t  {\n1020\t  unsigned int n = 0;\n1021\t\n1022\t  while(p[n+1] == p[0] + n + 1) n++;\n1023\t  add_to_class(options, xoptions, cb, p[0], p[n]);\n1024\t\n1025\t  p += n + 1;\n1026\t  }\n1027\t}\n1028\t\n1029\t\n1030\t\n1031\t/*************************************************\n1032\t*    Add characters not in a list to a class     *\n1033\t*************************************************/\n1034\t\n1035\t/* This function is used for adding the complement of a list of horizontal or\n1036\tvertical whitespace to a class. The list must be in order.\n1037\t\n1038\tArguments:\n1039\t  options       the options bits\n1040\t  xoptions      the extra options bits\n1041\t  cb            contains pointers to tables etc.\n1042\t  p             points to row of 32-bit values, terminated by NOTACHAR\n1043\t\n1044\tReturns:        cb->classbits is updated\n1045\t*/\n1046\t\n1047\tstatic void\n1048\tadd_not_list_to_class(uint32_t options, uint32_t xoptions, compile_block *cb,\n1049\t  const uint32_t *p)\n1050\t{\n1051\tif (p[0] > 0)\n1052\t  add_to_class(options, xoptions, cb, 0, p[0] - 1);\n1053\twhile (p[0] < 256)\n1054\t  {\n1055\t  while (p[1] == p[0] + 1) p++;\n1056\t  add_to_class(options, xoptions, cb, p[0] + 1, (p[1] > 255) ? 255 : p[1] - 1);\n1057\t  p++;\n1058\t  }\n1059\t}\n1060\t#endif /* PCRE2_CODE_UNIT_WIDTH == 8 */\n1061\t\n1062\t\n1063\t\n1064\t/*************************************************\n1065\t*  Main entry-point to compile a character class *\n1066\t*************************************************/\n1067\t\n1068\t/* This function consumes a \"leaf\", which is a set of characters that will\n1069\tbecome a single OP_CLASS OP_NCLASS, OP_XCLASS, or OP_ALLANY. */\n1070\t\n1071\tuint32_t *\n1072\tPRIV(compile_class_not_nested)(uint32_t options, uint32_t xoptions,\n1073\t  uint32_t *start_ptr, PCRE2_UCHAR **pcode, BOOL negate_class, BOOL* has_bitmap,\n1074\t  int *errorcodeptr, compile_block *cb, PCRE2_SIZE *lengthptr)\n1075\t{\n1076\tuint32_t *pptr = start_ptr;\n1077\tPCRE2_UCHAR *code = *pcode;\n1078\tBOOL should_flip_negation;\n1079\tconst uint8_t *cbits = cb->cbits;\n1080\t/* Some functions such as add_to_class() or eclass processing\n1081\texpects that the bitset is stored in cb->classbits.classbits. */\n1082\tuint8_t *const classbits = cb->classbits.classbits;\n1083\t\n1084\t#ifdef SUPPORT_UNICODE\n1085\tBOOL utf = (options & PCRE2_UTF) != 0;\n1086\t#else  /* No Unicode support */\n1087\tBOOL utf = FALSE;\n1088\t#endif\n1089\t\n1090\t/* Helper variables for OP_XCLASS opcode (for characters > 255). */\n1091\t\n1092\t#ifdef SUPPORT_WIDE_CHARS\n1093\tuint32_t xclass_props;\n1094\tPCRE2_UCHAR *class_uchardata;\n1095\tclass_ranges* cranges;\n1096\t#else\n1097\t(void)has_bitmap;    /* Avoid compiler warning. */\n1098\t(void)errorcodeptr;  /* Avoid compiler warning. */\n1099\t(void)lengthptr;     /* Avoid compiler warning. */\n1100\t#endif\n1101\t\n1102\t/* If an XClass contains a negative special such as \\S, we need to flip the\n1103\tnegation flag at the end, so that support for characters > 255 works correctly\n1104\t(they are all included in the class). An XClass may need to insert specific\n1105\tmatching or non-matching code for wide characters.\n1106\t*/\n1107\t\n1108\tshould_flip_negation = FALSE;\n1109\t\n1110\t/* XClass will be used when characters > 255 might match. */\n1111\t\n1112\t#ifdef SUPPORT_WIDE_CHARS\n1113\txclass_props = 0;"}]},"parent_tool_use_id":"toolu_bdrk_01X7TwwhWorp7Ydr7bYEPTaV","session_id":"cde48455-d5ce-4cd5-a0b0-2154082e5ad7","uuid":"a6cedf3e-8b5f-4c6f-ae35-b79bd2d7d73e","timestamp":"2026-08-23T10:17:14.482Z","subagent_type":"Explore","task_description":"Analyze compile option branches"}
