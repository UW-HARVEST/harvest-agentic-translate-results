{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01RQJbKGQc8xknzNUwyhqRh1","type":"tool_result","content":"1\t// Temporary exploration probe for the phase-B dfa_match / substitute sign-off.\n2\t// Deleted once tests/phase_b_cfg_dfa_subst.rs is final.\n3\tmod common;\n4\tuse common::*;\n5\tuse std::ffi::{c_int, c_void};\n6\tuse std::ptr;\n7\t\n8\t#[repr(C)]\n9\tstruct MdHead {\n10\t    memctl_malloc: *mut c_void,\n11\t    memctl_free: *mut c_void,\n12\t    memctl_data: *mut c_void,\n13\t    code: *const c_void,\n14\t    subject: Sptr,\n15\t    mark: Sptr,\n16\t    heapframes: *mut c_void,\n17\t    heapframes_size: Sz,\n18\t    subject_length: Sz,\n19\t    start_offset: Sz,\n20\t    leftchar: Sz,\n21\t    rightchar: Sz,\n22\t    startchar: Sz,\n23\t    matchedby: u8,\n24\t    flags: u8,\n25\t    oveccount: u16,\n26\t    options: u32,\n27\t    rc: c_int,\n28\t}\n29\t\n30\tunsafe fn compile1(api: &Api, pat: &[u8], opts: u32) -> Ptr {\n31\t    let (mut ec, mut eo) = (0 as c_int, 0usize);\n32\t    let c = (api.compile)(pat.as_ptr(), pat.len(), opts, &mut ec, &mut eo, ptr::null_mut());\n33\t    assert!(!c.is_null(), \"compile {} failed ec={ec} eo={eo}\", show(pat));\n34\t    c\n35\t}\n36\t\n37\t#[test]\n38\tfn probe_md_layout() {\n39\t    let p = pair();\n40\t    unsafe {\n41\t        for api in [&p.c, &p.r] {\n42\t            let code = compile1(api, b\"(a)(b)?\", 0);\n43\t            let md = (api.match_data_create)(7, ptr::null_mut());\n44\t            let subj = b\"xxab\";\n45\t            let rc = (api.do_match)(code, subj.as_ptr(), 4, 0, 0, md, ptr::null_mut());\n46\t            let h = &*(md as *const MdHead);\n47\t            println!(\n48\t                \"[{}] rc={rc} h.rc={} oveccount={} startchar={} matchedby={} flags={} \\\n49\t                 leftchar={} rightchar={} sublen={} start_offset={} options={:#x} subj_eq={}\",\n50\t                api.name, h.rc, h.oveccount, h.startchar, h.matchedby, h.flags,\n51\t                h.leftchar, h.rightchar, h.subject_length, h.start_offset, h.options,\n52\t                h.subject == subj.as_ptr()\n53\t            );\n54\t            assert_eq!(h.rc, rc);\n55\t            assert_eq!(h.oveccount as u32, (api.get_ovector_count)(md));\n56\t            assert_eq!(h.startchar, (api.get_startchar)(md));\n57\t            assert_eq!(h.code as usize, code as usize);\n58\t            // now DFA\n59\t            let mut ws = vec![0 as c_int; 1000];\n60\t            let rc2 = (api.dfa_match)(\n61\t                code, subj.as_ptr(), 4, 0, 0, md, ptr::null_mut(), ws.as_mut_ptr(), 1000,\n62\t            );\n63\t            let h = &*(md as *const MdHead);\n64\t            println!(\n65\t                \"[{}] dfa rc={rc2} matchedby={} leftchar={} rightchar={} startchar={}\",\n66\t                api.name, h.matchedby, h.leftchar, h.rightchar, h.startchar\n67\t            );\n68\t            assert_eq!(h.matchedby, 1);\n69\t            (api.match_data_free)(md);\n70\t            (api.code_free)(code);\n71\t        }\n72\t    }\n73\t}\n74\t\n75\t#[test]\n76\tfn probe_restart_workspace() {\n77\t    let p = pair();\n78\t    unsafe {\n79\t        for api in [&p.c, &p.r] {\n80\t            let code = compile1(api, b\"abcd\", 0);\n81\t            for wsn in [20usize, 32, 44] {\n82\t                let mut ws = vec![0 as c_int; wsn];\n83\t                let md = (api.match_data_create)(4, ptr::null_mut());\n84\t                let r1 = (api.dfa_match)(\n85\t                    code, b\"ab\".as_ptr(), 2, 0, PCRE2_PARTIAL_SOFT, md, ptr::null_mut(),\n86\t                    ws.as_mut_ptr(), wsn,\n87\t                );\n88\t                println!(\"[{}] ws={wsn} partial rc={r1} ws0={} ws1={}\", api.name, ws[0], ws[1]);\n89\t                let bound = ((wsn - 2) / 3) as c_int;\n90\t                for w1 in [0 as c_int, 1, bound, bound + 1] {\n91\t                    let mut ws2 = ws.clone();\n92\t                    ws2[1] = w1;\n93\t                    let r2 = (api