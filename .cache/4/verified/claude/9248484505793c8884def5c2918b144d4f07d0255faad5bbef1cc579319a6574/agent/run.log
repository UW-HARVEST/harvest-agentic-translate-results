( $field:ident : $sym:literal : $t:ty ),* $(,)? ) => {\n238\t        pub struct Api {\n239\t            pub name: &'static str,\n240\t            pub lib: &'static UnixLibrary,\n241\t            $( pub $field: $t, )*\n242\t        }\n243\t\n244\t        impl Api {\n245\t            pub fn load(name: &'static str, path: &std::path::Path) -> Api {\n246\t                let lib: &'static UnixLibrary = Box::leak(Box::new(unsafe {\n247\t                    UnixLibrary::open(Some(path), RTLD_NOW | RTLD_LOCAL)\n248\t                }\n249\t                .unwrap_or_else(|e| panic!(\"cannot dlopen {}: {}\", path.display(), e))));\n250\t                Api {\n251\t                    name,\n252\t                    lib,\n253\t                    $( $field: unsafe {\n254\t                        let s: UnixSymbol<$t> = lib\n255\t                            .get(concat!($sym, \"\\0\").as_bytes())\n256\t                            .unwrap_or_else(|e| {\n257\t                                panic!(\"[{}] missing symbol {}: {}\", name, $sym, e)\n258\t                            });\n259\t                        *s\n260\t                    }, )*\n261\t                }\n262\t            }\n263\t\n264\t            /// Address of an exported *data* symbol.\n265\t            pub fn data(&self, sym: &str) -> *const u8 {\n266\t                let mut owned = sym.as_bytes().to_vec();\n267\t                owned.push(0);\n268\t                unsafe {\n269\t                    let s: UnixSymbol<*const u8> = self\n270\t                        .lib\n271\t                        .get(&owned)\n272\t                        .unwrap_or_else(|e| panic!(\"[{}] missing data symbol {}: {}\", self.name, sym, e));\n273\t                    s.into_raw() as *const u8\n274\t                }\n275\t            }\n276\t        }\n277\t    };\n278\t}\n279\t\n280\tdef_api! {\n281\t    // ---- general information\n282\t    config: \"pcre2_config_8\": unsafe extern \"C\" fn(u32, Ptr) -> c_int,\n283\t    get