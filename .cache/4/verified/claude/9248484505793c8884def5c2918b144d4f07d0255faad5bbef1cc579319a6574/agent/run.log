* A matching negative assertion returns MATCH, which is turned into\n6448\t      NOMATCH at the assertion level. For a variable lookbehind, check its end\n6449\t      point. */\n6450\t\n6451\t      case OP_ASSERTBACK_NOT:\n6452\t      if (branch_start[1 + LINK_SIZE] == OP_VREVERSE && Feptr != P->eptr)\n6453\t        RRETURN(MATCH_NOMATCH);\n6454\t      PCRE2_FALLTHROUGH /* Fall through */\n6455\t\n6456\t      case OP_ASSERT_NOT:\n6457\t      RRETURN(MATCH_MATCH);\n6458\t\n6459\t      /* A scan substring group must preserve the current end_subject,\n6460\t      and restore it before the backtracking is performed into its sub\n6461\t      pattern. */\n6462\t\n6463\t      case OP_ASSERT_SCS:\n6464\t      F->fields.op_assert_scs.saved_end_subject = mb->end_subject;\n6465\t      mb->end_subject = P->fields.op_assert_scs.saved_end_subject;\n6466\t      mb->true_end_subject = mb->end_subject + P->fields.op_assert_scs.true_end_extra;\n6467\t      Feptr = P->fields.op_assert_scs.saved_eptr;\n6468\t\n6469\t      RMATCH(Fecode + 1 + LINK_SIZE, RM39);\n6470\t\n6471\t      mb->end_subject = F->fields.op_assert_scs.saved_end_subject;\n6472\t      mb->true_end_subject = mb->end_subject;\n6473\t      RRETURN(rrc);\n6474\t      break;\n6475\t\n6476\t      /* At the end of a script run, apply the script-checking rules. This code\n6477\t      will never by exercised if Unicode support it not compiled, because in\n6478\t      that environment script runs cause an error at compile time. */\n6479\t\n6480\t      case OP_SCRIPT_RUN:\n6481\t      if (!PRIV(script_run)(P->eptr, Feptr, utf)) RRETURN(MATCH_NOMATCH);\n6482\t      break;\n6483\t\n6484\t      /* Whole-pattern recursion is coded as a recurse into group 0, and is\n6485\t      handled with OP_BRA above. Other recursion is handled here. */\n6486\t\n6487\t      case OP_CBRA:\n6488\t      case OP_CBRAPOS:\n6489\t      case OP_SCBRA:\n6490\t      case OP_SCBRAPOS:\n6491\t      number = GET2(bracode, 1+LINK_SIZE);\n6492\t\n6493\t      /* Handle a recursively called group. We reinstate the previous set of\n6494\t      captures and then carry on after the recursion call. */\n6495\t\n6496\t      if (Fcurrent_recurse == number)\n6497\t        {\n6498\t        P = (heapframe *)((char *)N - frame_size);\n6499\t        Fecode = P->ecode + 1 + LINK_SIZE;\n6500\t\n6501\t        if (*Fecode != OP_CREF)\n6502\t          {\n6503\t          memcpy(F->ovector, P->ovector, Foffset_top * sizeof(PCRE2_SIZE));\n6504\t          Foffset_top = P->offset_top;\n6505\t          }\n6506\t        else\n6507\t          recurse_update_offsets(F, P);\n6508\t\n6509\t        Fcapture_last = P->capture_last;\n6510\t        Fcurrent_recurse = P->current_recurse;\n6511\t        continue;  /* With next opcode */\n6512\t        }\n6513\t\n6514\t      /* Deal with actual capturing. */\n6515\t\n6516\t      offset = (number << 1) - 2;\n6517\t      Fcapture_last = number;\n6518\t      Fovector[offset] = P->eptr - mb->start_subject;\n6519\t      Fovector[offset+1] = Feptr - mb->start_subject;\n6520\t      if (offset >= Foffset_top) Foffset_top = offset + 2;\n6521\t      break;\n6522\t      }  /* End actions relating to the starting opcode */\n6523\t\n6524\t    /* OP_KETRPOS is a possessive repeating ket. Remember the current position,\n6525\t    and return the MATCH_KETRPOS. This makes it possible to do the repeats one\n6526\t    at a time from the outer level. This must precede the empty string test -\n6527\t    in this case that test is done at the outer level. */\n6528\t\n6529\t    if (*Fecode == OP_KETRPOS)\n6530\t      {\n6531\t      memcpy((char *)P + offsetof(heapframe, eptr),\n6532\t             (char *)F + offsetof(heapframe, eptr),\n6533\t             frame_copy_size);\n6534\t      RRETURN(MATCH_KETRPOS);\n6535\t      }\n6536\t\n6537\t    /* Handle the different kinds of closing brackets. A non-repeating ket\n6538\t    needs no special action, just continuing at this level. This also happens\n6539\t    for the repeating kets if the group matched no characters, in order to\n6540\t    forcibly break infinite loops. Otherwise, the repeating kets try the rest\n6541\t    of the pattern or restart from the preceding bracket, in the appropriate\n6542\t    order. */\n6543\t\n6544\t    if (Fop != OP_KET && (P == NULL || Feptr != P->eptr))\n6545\t      {\n6546\t      if (Fop == OP_KETRMIN)\n6547\t        {\n6548\t        RMATCH(Fecode + 1 + LINK_SIZE, RM6);\n6549\t        if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n6550\t        Fecode -= GET(Fecode, 1);\n6551\t        break;   /* End of ket processing */\n6552\t        }\n6553\t\n6554\t      /* Repeat the maximum number of times (KETRMAX) */\n6555\t\n6556\t      RMATCH(bracode, RM7);\n6557\t      if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n6558\t      }\n6559\t\n6560\t    /* Carry on at this level for a non-repeating ket, or after matching an\n6561\t    empty string, or after repeating for a maximum number of times. */\n6562\t\n6563\t    Fecode += 1 + LINK_SIZE;\n6564\t    break;\n6565\t\n6566\t\n6567\t    /* ===================================================================== */\n6568\t    /* Start and end of line assertions, not multiline mode. */\n6569\t\n6570\t    case OP_CIRC:   /* Start of line, unless PCRE2_NOTBOL is set. */\n6571\t    if (Feptr != mb->start_subject || (mb->moptions & PCRE2_NOTBOL) != 0)\n6572\t      RRETURN(MATCH_NOMATCH);\n6573\t    Fecode++;\n6574\t    break;\n6575\t\n6576\t    case OP_SOD:    /* Unconditional start of subject */\n6577\t    if (Feptr != mb->start_subject) RRETURN(MATCH_NOMATCH);\n6578\t    Fecode++;\n6579\t    break;\n6580\t\n6581\t    /* When PCRE2_NOTEOL is unset, assert before the subject end, or a\n6582\t    terminating newline unless PCRE2_DOLLAR_ENDONLY is set. */\n6583\t\n6584\t    case OP_DOLL:\n6585\t    if ((mb->moptions & PCRE2_NOTEOL) != 0) RRETURN(MATCH_NOMATCH);\n6586\t    if ((mb->poptions & PCRE2_DOLLAR_ENDONLY) == 0) goto ASSERT_NL_OR_EOS;\n6587\t\n6588\t    PCRE2_FALLTHROUGH /* Fall through *