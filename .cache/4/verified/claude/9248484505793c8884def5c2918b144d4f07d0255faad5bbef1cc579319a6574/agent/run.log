{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01N58NbfFx9pDyuhdQTZBjo1","type":"tool_result","content":"1\t// Phase B — the remaining public API surface: config, error messages,\n2\t// substitute, substring-by-name, serialize round trips, pattern conversion,\n3\t// contexts with custom allocators, and the match-data accessors.\n4\t\n5\tmod common;\n6\tuse common::*;\n7\tuse std::ffi::{c_int, c_void, CStr};\n8\tuse std::ptr;\n9\t\n10\t// ===================================================================== config\n11\t\n12\t// CONFIGS row: pcre2_config_8 for every documented `what`, both with a buffer\n13\t// and with NULL (the size query form).\n14\t#[test]\n15\tfn config_identical() {\n16\t    let p = pair();\n17\t    let mut d = Diffs::new();\n18\t    unsafe {\n19\t        for what in 0u32..=16 {\n20\t            // size query\n21\t            d.eq(\n22\t                &format!(\"config({what}, NULL)\"),\n23\t                (p.c.config)(what, ptr::null_mut()),\n24\t                (p.r.config)(what, ptr::null_mut()),\n25\t            );\n26\t            // string-valued: VERSION, UNICODE_VERSION, JITTARGET\n27\t            if what == PCRE2_CONFIG_VERSION || what == PCRE2_CONFIG_UNICODE_VERSION {\n28\t                let mut ba = [0u8; 128];\n29\t                let mut bb = [0u8; 128];\n30\t                let ra = (p.c.config)(what, ba.as_mut_ptr() as Ptr);\n31\t                let rb = (p.r.config)(what, bb.as_mut_ptr() as Ptr);\n32\t                d.eq(&format!(\"config({what}) rc\"), ra, rb);\n33\t                d.eq(&format!(\"config({what}) text\"), ba, bb);\n34\t                println!(\"config[{what}] = {:?}\", CStr::from_bytes_until_nul(&ba).unwrap());\n35\t            } else {\n36\t                let (mut va, mut vb) = (0xDEAD_BEEFu32, 0xDEAD_BEEFu32);\n37\t                let ra = (p.c.config)(what, &mut va as *mut u32 as Ptr);\n38\t                let rb = (p.r.config)(what, &mut vb as *mut u32 as Ptr);\n39\t                d.eq(&format!(\"config({what}) rc\"), ra, rb);\n40\t                d.eq(&format!(\"config({what}) val\"), va, vb);\n41\t            }\n42\t        }\n43\t    }\n44\t    d.finish(\"pcre2_config_8: every `what` 0..=16, buffer form and NULL size-query form\");\n45\t}\n46\t\n47\t// CONFIGS row: pcre2_get_error_message_8 for EVERY error number the library\n48\t// knows, across buffer sizes from 0 to comfortably large.\n49\t#[test]\n50\tfn get_error_message_identical() {\n51\t    let p = pair();\n52\t    let mut d = Diffs::new();\n53\t    unsafe {\n54\t        let mut codes: Vec<c_int> = (-90..=0).collect();\n55\t        codes.extend(100..=200); // compile errors\n56\t        codes.extend([300, 1000, -1000, c_int::MAX, c_int::MIN]);\n57\t        for code in codes {\n58\t            for size in [0usize, 1, 2, 5, 16, 64, 512] {\n59\t                let mut ba = vec![0xEEu8; size + 8];\n60\t                let mut bb = vec![0xEEu8; size + 8];\n61\t                let ra = (p.c.get_error_message)(code, ba.as_mut_ptr(), size);\n62\t                let rb = (p.r.get_error_message)(code, bb.as_mut_ptr(), size);\n63\t                d.eq(&format!(\"get_error_message({code}, size={size}) rc\"), ra, rb);\n64\t                d.eq(&format!(\"get_error_message({code}, size={size}) buf\"), ba, bb);\n65\t            }\n66\t        }\n67\t    }\n68\t    d.finish(\"pcre2_get_error_message_8: all error numbers x buffer sizes 0..512\");\n69\t}\n70\t\n71\t// ================================================================ substitute\n72\t\n73\t/// Replacement strings covering the whole substitution mini-language.\n74\tconst REPLACEMENTS: &[&str] = &[\n75\t    \"\",\n76\t    \"X\",\n77\t    \"[$0]\",\n78\t    \"$1\",\n79\t    \"$2\",\n80\t    \"$9\",\n81\t    \"${1}\",\n82\t    \"${0}\",\n83\t    \"$1$2\",\n84\t    \"a${1}b\",\n85\t    \"\\\\1\",\n86\t    \"\\\\0\",\n87\t    \"$$\",\n88\t    \"$\",\n89\t    \"\\\\$\",\n90\t    \"\\\\\\\\\",\n91\t    \"\\\\n\",\n92\t    \"\\\\r\\\\t\",\n93\t    \"\\\\x41\",\n94\t    \"\\\\x{41}\",\n95\t    \"\\\\o{101}\",\n96\t    \"$*MARK\",\n97\t    \"${*MARK}\",\n98\t    \"$*MARK:$0\",\n99\t    \"${name}\",\n100\t    \"$name\",\n101\t    \"${n}\",\n102\t    \"${y}-${m}\",\n103\t    // case operators (SUBSTITUTE_EXTENDED)\n104\t    \"\\\\U$0\\\\E\",\n105\t    \"\\\\L$0\\\\E\",\n106\t    \"\\\\u$0\",\n107\t    \"\\\\l$0\",\n108\t    \"\\\\U$1\\\\E-\\\\L$2\\\\E\",\n109\t    \"\\\\u\\\\L$0\\\\E\",\n110\t    // conditional forms (SUBSTITUTE_EXTENDED)\n111\t    \"${1:-empty}\",\n112\t    \"${1:+yes:no}\",\n113\t    \"${9:-d}\",\n114\t    \"${name:-none}\",\n115\t    \"${1:+[$1]:(none)}\",\n116\t    // pathological / malformed-ish but valid-under-some-options\n117\t    \"$1\\\\\",\n118\t    \"${1\",\n119\t    \"$}\",\n120\t    \"\\\\Q$1\\\\E\",\n121\t];\n122\t\n123\t// CONFIGS rows: pcre2_substitute_8 over substitute options x patterns x\n124\t// subjects x replacements x output buffer sizes (including the two-pass\n125\t// length-query form).\n126\t#[test]\n127\tfn substitute_identical() {\n128\t    let p = pair();\n129\t    let mut rng = Rng::new(300);\n130\t    let mut d = Diffs::new();\n131\t    let subs_opts: &[(u32, &str)] = &[\n132\t        (0, \"none\"),\n133\t        (PCRE2_SUBSTITUTE_GLOBAL, \"GLOBAL\"),\n134\t        (PCRE2_SUBSTITUTE_EXTENDED, \"EXTENDED\"),\n135\t        (PCRE2_SUBSTITUTE_GLOBAL | PCRE2_SUBSTITUTE_EXTENDED, \"GLOBAL|EXTENDED\"),\n136\t        (PCRE2_SUBSTITUTE_LITERAL, \"LITERAL\"),\n137\t        (PCRE2_SUBSTITUTE_GLOBAL | PCRE2_SUBSTITUTE_LITERAL, \"GLOBAL|LITERAL\"),\n138\t        (PCRE2_SUBSTITUTE_UNSET_EMPTY, \"UNSET_EMPTY\"),\n139\t        (PCRE2_SUBSTITUTE_UNKNOWN_UNSET, \"UNKNOWN_UNSET\"),\n140\t        (\n141\t            PCRE2_SUBSTITUTE_UNSET_EMPTY | PCRE2_SUBSTITUTE_UNKNOWN_UNSET,\n142\t            \"UNSET_EMPTY|UNKNOWN_UNSET\",\n143\t        ),\n144\t        (PCRE2_SUBSTITUTE_OVERFLOW_LENGTH, \"OVERFLOW_LENGTH\"),\n145\t        (\n146\t            PCRE2_SUBSTITUTE_GLOBAL | PCRE2_SUBSTITUTE_OVERFLOW_LENGTH,\n147\t            \"GLOBAL|OVERFLOW_LENGTH\",\n148\t        ),\n149\t        (PCRE2_SUBSTITUTE_REPLACEMENT_ONLY, \"REPLACEMENT_ONLY\"),\n150\t        (\n151\t            PCRE2_SUBSTITUTE_GLOBAL | PCRE2_SUBSTITUTE_REPLACEMENT_ONLY,\n152\t            \"GLOBAL|REPLACEMENT_ONLY\",\n153\t        ),\n154\t        (\n155\t            PCRE2_SUBSTITUTE_GLOBAL | PCRE2_SUBSTITUTE_EXTENDED | PCRE2_SUBSTITUTE_UNSET_EMPTY\n156\t                | PCRE2_SUBSTITUTE_UNKNOWN_UNSET,\n157\t            \"GLOBAL|EXTENDED|UNSET_EMPTY|UNKNOWN_UNSET\",\n158\t        ),\n159\t        (PCRE2_NOTBOL, \"NOTBOL\"),\n160\t        (PCRE2_NOTEMPTY, \"NOTEMPTY\"),\n161\t        (PCRE2_NOTEMPTY_ATSTART | PCRE2_SUBSTITUTE_GLOBAL, \"NOTEMPTY_ATSTART|GLOBAL\"),\n162\t        (PCRE2_ANCHORED, \"ANCHORED\"),\n163\t        (PCRE2_NO_UTF_CHECK, \"NO_UTF_CHECK\"),\n164\t    ];\n165\t    // patterns with captures / names / marks, which is what substitution needs\n166\t    let pats: &[(&str, u32)] = &[\n167\t        (\"a\", 0),\n168\t        (\"a+\", 0),\n169\t        (\"(a)(b)\", 0),\n170\t        (\"(?<name>a+)\", 0),\n171\t        (\"(?<y>\\\\d{4})-(?<m>\\\\d{2})\", 0),\n172\t        (\"(a)|(b)\", 0),\n173\t        (\"(a)?b\", 0),\n174\t        (\"\", 0),\n175\t        (\"x*\", 0),\n176\t        (\"\\\\b\", 0),\n177\t        (\"(*MARK:m1)a\", 0),\n178\t        (\"\\\\w+\", 0),\n179\t        (\"[aeiou]\", 0),\n180\t        (\"(.)(.)\", 0),\n181\t        (\"a\", PCRE2_CASELESS),\n182\t        (\"\\\\w+\", PCRE2_UTF | PCRE2_UCP),\n183\t        (\".\", PCRE2_UTF),\n184\t        (\"(\\\\X)\", PCRE2_UTF),\n185\t        (\"^\", PCRE2_MULTILINE),\n186\t        (\"$\", PCRE2_MULTILINE),\n187\t    ];\n188\t    for &(pat, copts) in pats {\n189\t        let pb = pat.as_bytes();\n190\t        unsafe {\n191\t            let (mut eca, mut ecb) = (0 as c_int, 0 as c_int);\n192\t            let (mut eoa, mut eob) = (0usize, 0usize);\n193\t            let a = (p.c.compile)(pb.as_ptr(), pb.len(), copts, &mut eca, &mut eoa, ptr::null_mut());\n194\t            let b = (p.r.compile)(pb.as_ptr(), pb.len(), copts, &mut ecb, &mut eob, ptr::null_mut());\n195\t            d.eq(&format!(\"substitute-compile {}\", show(pb)), a.is_null(), b.is_null());\n196\t            if a.is_null() || b.is_null() {\n197\t                continue;\n198\t            }\n199\t            for subj in SUBJECTS {\n200\t                let sb = subj.as_bytes();\n201\t                if copts & PCRE2_UTF != 0 && std::str::from_utf8(sb).is_err() {\n202\t                    continue;\n203\t                }\n204\t                for _ in 0..8 {\n205\t                    let &(so, sn) = &subs_opts[rng.below(subs_opts.len())];\n206\t                    let rep = REPLACEMENTS[rng.below(REPLACEMENTS.len())].as_bytes();\n207\t                    let start = if sb.is_empty() { 0 } else { rng.below(sb.len() + 1) };\n208\t                    // exercise too-small, exact and generous output buffers, and\n209\t                    // the length-query form (buffer NULL is not allowed, but a\n210\t                    // zero-length buffer is the documented query)\n211\t                    let cap = *rng.pick(&[0usize, 1, 2, 4, 8, 32, 512]);\n212\t                    let mut oa = vec![0xEEu8; cap + 16];\n213\t                    let mut ob = vec![0xEEu8; cap + 16];\n214\t                    let (mut la, mut lb) = (cap, cap);\n215\t                    let ra = (p.c.substitute)(\n216\t                        a, sb.as_ptr(), sb.len(), start, so, ptr::null_mut(), ptr::null_mut(),\n217\t                        rep.as_ptr(), rep.len(), oa.as_mut_ptr(), &mut la,\n218\t                    );\n219\t                    let rb = (p.r.substitute)(\n220\t                        b, sb.as_ptr(), sb.len(), start, so, ptr::null_mut(), ptr::null_mut(),\n221\t                        rep.as_ptr(), rep.len(), ob.as_mut_ptr(), &mut lb,\n222\t                    );\n223\t                    let tag = format!(\n224\t                        \"substitute pat={} subj={} rep={} opts={} start={} cap={}\",\n225\t                        show(pb), show(sb), show(rep), sn, start, cap\n226\t                    );\n227\t                    d.eq(&format!(\"{tag} rc\"), ra, rb);\n228\t                    d.eq(&format!(\"{tag} outlen\"), la, lb);\n229\t                    d.eq(&format!(\"{tag} out\"), oa, ob);\n230\t                    // zero-terminated replacement form\n231\t                    let mut zrep = rep.to_vec();\n232\t                    zrep.push(0);\n233\t                    let (mut la2, mut lb2) = (cap, cap);\n234\t                    let mut oa2 = vec![0xEEu8; cap + 16];\n235\t                    let mut ob2 = vec![0xEEu8; cap + 16];\n236\t                    let ra2 = (p.c.substitute)(\n237\t                        a, sb.as_ptr(), sb.len(), start, so, ptr::null_mut(), ptr::null_mut(),\n238\t                        zrep.as_ptr(), PCRE2_ZERO_TERMINATED, oa2.as_mut_ptr(), &mut la2,\n239\t                    );\n240\t                    let rb2 = (p.r.substitute)(\n241\t                        b, sb.as_ptr(), sb.len(), start, so, ptr::null_mut(), ptr::null_mut(),\n242\t                        zrep.as_ptr(), PCRE2_ZERO_TERMINATED, ob2.as_mut_ptr(), &mut lb2,\n243\t                    );\n244\t                    d.eq(&format!(\"{tag} [ZT rep] rc\"), ra2, rb2);\n245\t                    d.eq(&format!(\"{tag} [ZT rep] outlen\"), la2, lb2);\n246\t                    d.eq(&format!(\"{tag} [ZT rep] out\"), oa2, ob2);\n247\t                }\n248\t            }\n249\t            (p.c.code_free)(a);\n250\t            (p.r.code_free)(b);\n251\t        }\n252\t    }\n253\t    d.finish(\"pcre2_substitute_8: substitute options x patterns x subjects x replacements x buffer sizes\");\n254\t}\n255\t\n256\t// --- SUBSTITUTE_MATCHED: substitution driven from a pre-existing match_data\n257\t\n258\t// CONFIGS row: PCRE2_SUBSTITUTE_MATCHED reuses the ovector of an earlier\n259\t// pcre2_match call instead of matching again.\n260\t#[test]\n261\tfn substitute_matched_identical() {\n262\t    let p = pair();\n263\t    let mut d = Diffs::new();\n264\t    unsafe {\n265\t        for (pat, subj) in [\n266\t            (\"(a)(b)\", \"xxabyy\"),\n267\t            (\"(?<n>\\\\w+)\", \"hello world\"),\n268\t            (\"a+\", \"baaad\"),\n269\t            (\"\", \"abc\"),\n270\t            (\"(x)?y\", \"zy\"),\n271\t        ] {\n272\t            let pb = pat.as_bytes();\n273\t            let sb = subj.as_bytes();\n274\t            let (mut ec, mut eo) = (0 as c_int, 0usize);\n275\t            let a = (p.c.compile)(pb.as_ptr(), pb.len(), 0, &mut ec, &mut eo, ptr::null_mut());\n276\t            let b = (p.r.compile)(pb.as_ptr(), pb.len(), 0, &mut ec, &mut eo, ptr::null_mut());\n277\t            assert!(!a.is_null() && !b.is_null());\n278\t            for rep in REPLACEMENTS {\n279\t                let rb_ = rep.as_bytes();\n280\t                for so in [\n281\t                    PCRE2_SUBSTITUTE_MATCHED,\n282\t                    PCRE2_SUBSTITUTE_MATCHED | PCRE2_SUBSTITUTE_EXTENDED,\n283\t                    PCRE2_SUBSTITUTE_MATCHED | PCRE2_SUBSTITUTE_REPLACEMENT_ONLY,\n284\t                ] {\n285\t                    let mda = (p.c.match_data_create_from_pattern)(a, ptr::null_mut());\n286\t                    let mdb = (p.r.match_data_create_from_pattern)(b, ptr::null_mut());\n287\t                    let m1 = (p.c.do_match)(a, sb.as_ptr(), sb.len(), 0, 0, mda, ptr::null_mut());\n288\t                    let m2 = (p.r.do_match)(b, sb.as_ptr(), sb.len(), 0, 0, mdb, ptr::null_mut());\n289\t                    d.eq(&format!(\"pre-match {pat}/{subj}\"), m1, m2);\n290\t                    let (mut la, mut lb) = (256usize, 256usize);\n291\t                    let mut oa = vec![0xEEu8; 300];\n292\t                    let mut ob = vec![0xEEu8; 300];\n293\t                    let ra = (p.c.substitute)(\n294\t                        a, sb.as_ptr(), sb.len(), 0, so, mda, ptr::null_mut(),\n295\t                        rb_.as_ptr(), rb_.len(), oa.as_mut_ptr(), &mut la,\n296\t                    );\n297\t                    let rbv = (p.r.substitute)(\n298\t                        b, sb.as_ptr(), sb.len(), 0, so, mdb, ptr::null_mut(),\n299\t                        rb_.as_ptr(), rb_.len(), ob.as_mut_ptr(), &mut lb,\n300\t                    );\n301\t                    let tag = format!(\"SUBSTITUTE_MATCHED {pat}/{subj} rep={} opts={so:#x}\", show(rb_));\n302\t                    d.eq(&format!(\"{tag} rc\"), ra, rbv);\n303\t                    d.eq(&format!(\"{tag} len\"), la, lb);\n304\t                    d.eq(&format!(\"{tag} out\"), oa, ob);\n305\t                    (p.c.match_data_free)(mda);\n306\t                    (p.r.match_data_free)(mdb);\n307\t                }\n308\t            }\n309\t            (p.c.code_free)(a);\n310\t            (p.r.code_free)(b);\n311\t        }\n312\t    }\n313\t    d.finish(\"pcre2_substitute_8 with PCRE2_SUBSTITUTE_MATCHED over a pre-filled match_data\");\n314\t}\n315\t\n316\t// --- substitute callouts\n317\t\n318\tstatic mut SUBS_LOG: Vec<u8> = Vec::new();\n319\t\n320\t/// Exact layout of `pcre2_substitute_callout_block` from `pcre2.h`\n321\t/// (note `version` is followed by padding before the first pointer).\n322\t#[repr(C)]\n323\tstruct SubstituteCalloutBlock {\n324\t    version: u32,\n325\t    input: Sptr,\n326\t    output: *const u8,\n327\t    output_offsets: [Sz; 2],\n328\t    ovector: *const Sz,\n329\t    oveccount: u32,\n330\t    subscount: u32,\n331\t}\n332\t\n333\tunsafe extern \"C\" fn subs_callout(blk: *mut c_void, _d: *mut c_void) -> c_int {\n334\t    let b = &*(blk as *const SubstituteCalloutBlock);\n335\t    let log = &mut *ptr::addr_of_mut!(SUBS_LOG);\n336\t    for v in [\n337\t        b.version as u64,\n338\t        b.oveccount as u64,\n339\t        b.subscount as u64,\n340\t        b.output_offsets[0] as u64,\n341\t        b.output_offsets[1] as u64,\n342\t    ] {\n343\t        log.extend_from_slice(&v.to_le_bytes());\n344\t    }\n345\t    // the ovector contents the callout sees, and the changed slice of output\n346\t    for i in 0..(2 * b.oveccount as usize) {\n347\t        log.extend_from_slice(&(*b.ovector.add(i) as u64).to_le_bytes());\n348\t    }\n349\t    let (s, e) = (b.output_offsets[0], b.output_offsets[1]);\n350\t    if e >= s && e < 1 << 20 {\n351\t        log.extend_from_slice(std::slice::from_raw_parts(b.output.add(s), e - s));\n352\t    }\n353\t    0\n354\t}\n355\t\n356\t/// A case-conversion callout that is deliberately simple but observable.\n357\tunsafe extern \"C\" fn case_callout(\n358\t    input: Sptr,\n359\t    inlen: Sz,\n360\t    output: *mut u8,\n361\t    outlen: Sz,\n362\t    to_case: c_int,\n363\t    _d: *mut c_void,\n364\t) -> Sz {\n365\t    let log = &mut *ptr::addr_of_mut!(SUBS_LOG);\n366\t    log.extend_from_slice(&(inlen as u64).to_le_bytes());\n367\t    log.extend_from_slice(&(outlen as u64).to_le_bytes());\n368\t    log.extend_from_slice(&(to_case as i64).to_le_bytes());\n369\t    if inlen > outlen {\n370\t        return usize::MAX; // signal \"not enough room\" the documented way\n371\t    }\n372\t    for i in 0..inlen {\n373\t        let c = *input.add(i);\n374\t        *output.add(i) = match to_case {\n375\t            0 => c.to_ascii_lowercase(),\n376\t            _ => c.to_ascii_uppercase(),\n377\t        };\n378\t    }\n379\t    inlen\n380\t}\n381\t\n382\t// CONFIGS rows: pcre2_set_substitute_callout_8 and\n383\t// pcre2_set_substitute_case_callout_8 — the callback sequences must match.\n384\t#[test]\n385\tfn substitute_callouts_identical() {\n386\t    let p = pair();\n387\t    let mut d = Diffs::new();\n388\t    unsafe {\n389\t        for (pat, subj) in [\n390\t            (\"a\", \"banana\"),\n391\t            (\"(\\\\w)(\\\\w)\", \"abcd ef\"),\n392\t            (\"[aeiou]+\", \"queueing\"),\n393\t            (\"\", \"xy\"),\n394\t        ] {\n395\t            let pb = pat.as_bytes();\n396\t            let sb = subj.as_bytes();\n397\t            let (mut ec, mut eo) = (0 as c_int, 0usize);\n398\t            let a = (p.c.compile)(pb.as_ptr(), pb.len(), 0, &mut ec, &mut eo, ptr::null_mut());\n399\t            let b = (p.r.compile)(pb.as_ptr(), pb.len(), 0, &mut ec, &mut eo, ptr::null_mut());\n400\t            assert!(!a.is_null() && !b.is_null());\n401\t            let mca = (p.c.match_context_create)(ptr::null_mut());\n402\t            let mcb = (p.r.match_context_create)(ptr::null_mut());\n403\t            d.eq(\n404\t                \"set_substitute_callout rc\",\n405\t                (p.c.set_substitute_callout)(mca, Some(subs_callout), ptr::null_mut()),\n406\t                (p.r.set_substitute_callout)(mcb, Some(subs_callout), ptr::null_mut()),\n407\t            );\n408\t            d.eq(\n409\t                \"set_substitute_case_callout rc\",\n410\t                (p.c.set_substitute_case_callout)(mca, Some(case_callout), ptr::null_mut()),\n411\t                (p.r.set_substitute_case_callout)(mcb, Some(case_callout), ptr::null_mut()),\n412\t            );\n413\t            for rep in REPLACEMENTS {\n414\t                let rp = rep.as_bytes();\n415\t                for so in [\n416\t                    PCRE2_SUBSTITUTE_GLOBAL,\n417\t                    PCRE2_SUBSTITUTE_GLOBAL | PCRE2_SUBSTITUTE_EXTENDED,\n418\t                    PCRE2_SUBSTITUTE_EXTENDED,\n419\t                ] {\n420\t                    let (mut la, mut lb) = (256usize, 256usize);\n421\t                    let mut oa = vec![0xEEu8; 300];\n422\t                    let mut ob = vec![0xEEu8; 300];\n423\t                    SUBS_LOG.clear();\n424\t                    let ra = (p.c.substitute)(\n425\t                        a, sb.as_ptr(), sb.len(), 0, so, ptr::null_mut(), mca,\n426\t                        rp.as_ptr(), rp.len(), oa.as_mut_ptr(), &mut la,\n427\t                    );\n428\t                    let loga = SUBS_LOG.clone();\n429\t                    SUBS_LOG.clear();\n430\t                    let rbv = (p.r.substitute)(\n431\t                        b, sb.as_ptr(), sb.len(), 0, so, ptr::null_mut(), mcb,\n432\t                        rp.as_ptr(), rp.len(), ob.as_mut_ptr(), &mut lb,\n433\t                    );\n434\t                    let logb = SUBS_LOG.clone();\n435\t                    let tag = format!(\"subs-callout {pat}/{subj} rep={} opts={so:#x}\", show(rp));\n436\t                    d.eq(&format!(\"{tag} rc\"), ra, rbv);\n437\t                    d.eq(&format!(\"{tag} len\"), la, lb);\n438\t                    d.eq(&format!(\"{tag} out\"), oa, ob);\n439\t                    d.eq(&format!(\"{tag} callout log\"), loga, logb);\n440\t                }\n441\t            }\n442\t            (p.c.match_context_free)(mca);\n443\t            (p.r.match_context_free)(mcb);\n444\t            (p.c.code_free)(a);\n445\t            (p.r.code_free)(b);\n446\t        }\n447\t    }\n448\t    d.finish(\"pcre2_set_substitute_callout_8 / pcre2_set_substitute_case_callout_8 sequences\");\n449\t}\n450\t\n451\t// ============================================================== substring by name\n452\t\n453\t// CONFIGS rows: the by-name substring accessors, including DUPNAMES where a\n454\t// name maps to several groups.\n455\t#[test]\n456\tfn substring_byname_identical() {\n457\t    let p = pair();\n458\t    let mut d = Diffs::new();\n459\t    let cases: &[(&str, u32, &str)] = &[\n460\t        (\"(?<a>x)(?<b>y)\", 0, \"xy\"),"}]},"parent_tool_use_id":"toolu_bdrk_0132LA9cgz2p7XSoHs8rV8dW","session_id":"cde48455-d5ce-4cd5-a0b0-2154082e5ad7","uuid":"cb4eaa58-73ea-4cb6-978f-dc4e8e18e1d5","timestamp":"2026-08-23T10:58:15.005Z","subagent_type":"general-purpose","task_description":"CONFIGS rows 294-351 dfa/substitute"}
