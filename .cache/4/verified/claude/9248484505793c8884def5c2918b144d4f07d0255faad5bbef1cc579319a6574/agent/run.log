={:?}\", show(rep));\n        (p.c.code_free)(a);\n        (p.r.code_free)(b);\n        (p.c.compile_context_free)(cca);\n        (p.r.compile_context_free)(ccb);\n        (ra, la, rb, lb)\n    }\n}\n\nfn show_len(l: usize) -> String {\n    if l == PCRE2_UNSET { \"UNSET\".into() } else { l.to_string() }\n}\n\n#[test]\nfn probe() {\n    let x = PCRE2_EXTRA_ALLOW_LOOKAROUND_BSK;\n    let e = PCRE2_SUBSTITUTE_EXTENDED;\n    let g = PCRE2_SUBSTITUTE_GLOBAL;\n    let cases: &[(&str, u32, u32, &[u8], usize, u32, &[u8], usize)] = &[\n        // -75 / -60 candidates\n        (\"(?<=\\\\Ka)b\", 0, x, b\"aab\", 2, 0, b\"X\", 64),\n        (\"(?<=\\\\Ka)b\", 0, x, b\"aab\", 0, g, b\"X\", 64),\n        (\"(?<=a\\\\K)b\", 0, x, b\"aab\", 0, g, b\"X\", 64),\n        (\"a\\\\K\", 0, 0, b\"aaa\", 0, g, b\"X\", 64),\n        (\"a\\\\Kb\", 0, 0, b\"ab\", 0, g, b\"X\", 64),\n        (\"(?(DEFINE)(a\\\\K))b(?=(?1))\", 0, 0, b\"ba\", 0, 0, b\"X\", 64),\n        (\"(?(DEFINE)(a\\\\K))b(?=(?1))\", 0, 0, b\"bab\", 0, 0, b\"X\", 64),\n        (\"(?(DEFINE)(\\\\Ka))(?<=(?1))b\", 0, 0, b\"aab\", 1, 0, b\"X\", 64),\n        (\"(?(DEFINE)(\\\\Ka))(?<=(?1))b\", 0, 0, b\"aab\", 0, 0, b\"X\", 64),\n        (\"(?(DEFINE)(a\\\\K))(?=(?1))a\", 0, 0, b\"aa\", 0, 0, b\"X\", 64),\n        // BADREPLACEMENT / friends: check blength offsets\n        (\"(a)\", 0, 0, b\"a\", 0, 0, b\"$\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, 0, b\"abc$\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, 0, b\"${\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, 0, b\"$<\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, 0, b\"${*\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, 0, b\"$*\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, 0, b\"$-\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, 0, b\"${}\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, 0, b\"$<>\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, 0, b\"${*}\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, 0, b\"$<name\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, 0, b\"$<name}\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, 0, b\"${*FOO}\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, 0, b\"${*mark}\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, 0, b\"${1\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, 0, b\"${name\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, 0, b\"${1x\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, 0, b\"${name)\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, e, b\"${1:-abc\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, e, b\"${1:+abc\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, e, b\"${1:+set:unset\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, e, b\"${1:xy}\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, e, b\"${1:=ab}\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, e, b\"${1:x}\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, e, b\"${1:-\\\\q}\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, e, b\"${1:+\\\\d:x}\", 64),\n        // escapes\n        (\"(a)\", 0, 0, b\"a\", 0, e, b\"\\\\q\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, e, b\"\\\\y\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, e, b\"\\\\x{110000}\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, e, b\"\\\\o{}\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, e, b\"\\\\c\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, e, b\"\\\\N{U+41}\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, e, b\"\\\\g\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, e, b\"\\\\gA\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, e, b\"\\\\g<>\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, e, b\"\\\\g<->\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, e, b\"\\\\g<name\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, e, b\"\\\\g<1a\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, e, b\"\\\\g<70000>\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, e, b\"\\\\d\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, e, b\"\\\\w\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, e, b\"\\\\A\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, e, b\"\\\\K\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, e, b\"\\\\N\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, e, b\"\\\\p{L}\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, 0, b\"\\\\q\", 64),\n        // group refs\n        (\"abc\", 0, 0, b\"abc\", 0, 0, b\"$+\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, 0, b\"$2\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, 0, b\"${99}\", 64),\n        (\"(?<a>x)\", 0, 0, b\"x\", 0, 0, b\"${b}\", 64),\n        (\"(?<a>x)\", 0, 0, b\"x\", 0, 0, b\"$<b>\", 64),\n        (\"(?<a>x)\", 0, 0, b\"x\", 0, e, b\"\\\\g<b>\", 64),\n        (\"a(x)?\", 0, 0, b\"a\", 0, 0, b\"$+\", 64),\n        (\"a(x)?\", 0, 0, b\"a\", 0, 0, b\"$1\", 64),\n        (\"a(x)?\", 0, 0, b\"a\", 0, 0, b\"${1}\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, PCRE2_SUBSTITUTE_UNKNOWN_UNSET, b\"$2\", 64),\n        // partial subs\n        (\"a\", 0, 0, b\"ab\", 0, PCRE2_PARTIAL_HARD | PCRE2_SUBSTITUTE_REPLACEMENT_ONLY, b\"$'\", 64),\n        (\"a\", 0, 0, b\"ab\", 0, PCRE2_PARTIAL_HARD | PCRE2_SUBSTITUTE_REPLACEMENT_ONLY, b\"$_\", 64),\n        (\"a\", 0, 0, b\"ab\", 0, PCRE2_PARTIAL_SOFT | PCRE2_SUBSTITUTE_REPLACEMENT_ONLY, b\"$`\", 64),\n        (\"abcd\", 0, 0, b\"abc\", 0, PCRE2_PARTIAL_HARD | PCRE2_SUBSTITUTE_REPLACEMENT_ONLY, b\"X\", 64),\n        (\"abcd\", 0, 0, b\"abc\", 0, PCRE2_PARTIAL_SOFT | PCRE2_SUBSTITUTE_REPLACEMENT_ONLY, b\"X\", 64),\n        // nomemory\n        (\"a\", 0, 0, b\"aaa\", 0, 0, b\"bbbb\", 4),\n        (\"a\", 0, 0, b\"a\", 0, 0, b\"b\", 1),\n        (\"a\", 0, 0, b\"aaa\", 0, PCRE2_SUBSTITUTE_OVERFLOW_LENGTH, b\"bbbb\", 4),\n        (\"a\", 0, 0, b\"aaa\", 0, g | PCRE2_SUBSTITUTE_OVERFLOW_LENGTH, b\"bbbb\", 4),\n        // literal / non-extended\n        (\"a\", 0, 0, b\"a\", 0, PCRE2_SUBSTITUTE_LITERAL, b\"${\", 64),\n        (\"(a)\", 0, 0, b\"a\", 0, 0, b\"${1:-x}\", 64),\n        // reserved options\n        (\"a\", 0, 0, b\"a\", 0, PCRE2_DFA_SHORTEST, b\"X\", 64),\n        (\"a\", 0, 0, b\"a\", 0, PCRE2_DFA_RESTART, b\"X\", 64),\n        // start offset\n        (\"a\", 0, 0, b\"abc\", 4, 0, b\"X\", 64),\n        // utf\n        (\".\", PCRE2_UTF, 0, b\"\\xc3\\xa9\", 0, 0, b\"\\x80\", 64),\n        (\".\", PCRE2_UTF, 0, b\"\\xc3\\xa9\", 0, 0, b\"\\xc3\", 64),\n        (\".\", PCRE2_UTF, 0, b\"\\xc3\\xa9\", 1, PCRE2_NO_UTF_CHECK, b\"X\", 64),\n        (\".\", PCRE2_UTF, 0, b\"\\xc3\\xa9\", 1, 0, b\"X\", 64),\n        (\".\", PCRE2_UTF, 0, b\"\\x80\\x80\", 0, 0, b\"X\", 64),\n    ];\n    for &(pat, copts, xopts, subj, start, sopts, rep, cap) in cases {\n        let (ra, la, rb, lb) = run(pat, copts, xopts, subj, start, sopts, rep, cap);\n        println!(\n            \"pat={pat:?} xo={xopts:#x} subj={} st={start} so={sopts:#x} rep={} cap={cap} => C rc={ra} len={} | R rc={rb} len={}\",\n            show(subj), show(rep), show_len(la), show_len(lb)\n        );\n        assert_eq!((ra, la), (rb, lb), \"DIVERGENCE pat={pat:?} rep={}\", show(rep));\n    }\n\n    // deep nesting for -35 at PTR_STACK_SIZE\n    for levels in [9usize, 10, 11, 12] {\n        let mut rep = Vec::new();\n        for _ in 0..levels {\n            rep.extend_from_slice(b\"${1:-\");\n        }\n        rep.push(b'x');\n        for _ in 0..levels {\n            rep.push(b'}');\n        }\n        let (ra, la, rb, lb) = run(\"a(x)?\", 0, 0, b\"a\", 0, e, &rep, 256);\n        println!(\"nest {levels} => C rc={ra} len={} | R rc={rb} len={}\", show_len(la), show_len(lb));\n        assert_eq!((ra, la), (rb, lb));\n    }\n\n    // long name\n    for n in [127usize, 128, 129, 200] {\n        let mut rep = b\"${\".to_vec();\n        rep.extend(std::iter::repeat(b'a').take(n));\n        rep.push(b'}');\n        let (ra, la, rb, lb) = run(\"(?<a>x)\", 0, 0, b\"x\", 0, PCRE2_SUBSTITUTE_UNKNOWN_UNSET | PCRE2_SUBSTITUTE_UNSET_EMPTY, &rep, 256);\n        println!(\"name len {n} => C rc={ra} len={} | R rc={rb} len={}\", show_len(la), show_len(lb));\n        assert_eq!((ra, la), (rb, lb));\n    }\n}\n\n// ---- case callout probes (-69 / -70)\n\nstatic mut CASE_RET: usize = 0;\nunsafe extern \"C\" fn case_cb(\n    _input: Sptr,\n    _inlen: Sz,\n    _output: *mut u8,\n    _outlen: Sz,\n    _to_case: c_int,\n    _d: *mut c_void,\n) -> Sz {\n    *ptr::addr_of_mut!(CASE_RET)\n}\n\n#[test]\nfn probe_case() {\n    let p = pair();\n    unsafe {\n        let pb = b\"(a)\";\n        let (mut ec, mut eo) = (0 as c_int, 0usize);\n        let a = (p.c.compile)(pb.as_ptr(), pb.len(), 0, &mut ec, &mut eo, ptr::null_mut());\n        let b = (p.r.compile)(pb.as_ptr(), pb.len(), 0, &mut ec, &mut eo, ptr::null_mut());\n        let mca = (p.c.match_context_create)(ptr::null_mut());\n        let mcb = (p.r.match_context_create)(ptr::null_mut());\n        (p.c.set_substitute_case_callout)(mca, Some(case_cb), ptr::null_mut());\n        (p.r.set_substitute_case_callout)(mcb, Some(case_cb), ptr::null_mut());\n        for ret in [usize::MAX, usize::MAX - 1, usize::MAX / 2, 3usize] {\n            for so in [\n                PCRE2_SUBSTITUTE_EXTENDED,\n                PCRE2_SUBSTITUTE_EXTENDED | PCRE2_SUBSTITUTE_OVERFLOW_LENGTH,\n            ] {\n                for rep in [&b\"\\\\Uabc\"[..], &b\"\\\\uabc\"[..], &b\"\\\\U$1\"[..], &b\"\\\\l\\\\Uabc\"[..]] {\n                    CASE_RET = ret;\n                    let cap = 32usize;\n                    let mut oa = vec![0xEEu8; cap + 8];\n                    let mut ob = vec![0xEEu8; cap + 8];\n                    let (mut la, mut lb) = (cap, cap);\n                    let ra = (p.c.substitute)(\n                        a, b\"a\".as_ptr(), 1, 0, so, ptr::null_mut(), mca,\n                        rep.as_ptr(), rep.len(), oa.as_mut_ptr(), &mut la,\n                    );\n                    let rbv = (p.r.substitute)(\n                        b, b\"a\".as_ptr(), 1, 0, so, ptr::null_mut(), mcb,\n                        rep.as_ptr(), rep.len(), ob.as_mut_ptr(), &mut lb,\n                    );\n                    println!(\n                        \"caseret={ret:#x} so={so:#x} rep={} => C rc={ra} len={} | R rc={rbv} len={}\",\n                        show(rep), show_len(la), show_len(lb)\n                    );\n                    assert_eq!((ra, la, &oa), (rbv, lb, &ob));\n                }\n            }\n        }\n        (p.c.match_context_free)(mca);\n        (p.r.match_context_free)(mcb);\n        (p.c.code_free)(a);\n        (p.r.code_free)(b);\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4254,"cache_read_input_tokens":131935,"cache_creation":{"ephemeral_5m_input_tokens":4254,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_01CEeVNoMBVMS2TgwKsqnpex","session_id":"cde48455-d5ce-4cd5-a0b0-2154082e5ad7","uuid":"bf635b58-f97f-467a-8f5c-74be98853874","timestamp":"2026-08-23T10:50:13.488Z","subagent_type":"general-purpose","task_description":"Phase C tests rows 324-379 substitute"}
