*/\n8083\t\n8084\t/* When we reach here, one of the following stopping conditions is true:\n8085\t\n8086\t(1) The match succeeded, either completely, or partially;\n8087\t\n8088\t(2) The pattern is anchored or the match was failed after (*COMMIT);\n8089\t\n8090\t(3) We are past the end of the subject or the bumpalong limit;\n8091\t\n8092\t(4) PCRE2_FIRSTLINE is set and we have failed to match at a newline, because\n8093\t    this option requests that a match occur at or before the first newline in\n8094\t    the subject.\n8095\t\n8096\t(5) Some kind of error occurred.\n8097\t\n8098\t*/\n8099\t\n8100\tENDLOOP:\n8101\t\n8102\t/* If end_subject != true_end_subject, it means we are handling invalid UTF,\n8103\tand have just processed a non-terminal fragment. If this resulted in no match\n8104\tor a partial match we must carry on to the next fragment (a partial match is\n8105\treturned to the caller only at the very end of the subject). A loop is used to\n8106\tavoid trying to match against empty fragments; if the pattern can match an\n8107\tempty string it would have done so already. */\n8108\t\n8109\t#ifdef SUPPORT_UNICODE\n8110\tif (utf && end_subject != true_end_subject &&\n8111\t    (rc == MATCH_NOMATCH || rc == PCRE2_ERROR_PARTIAL))\n8112\t  {\n8113\t  for (;;)\n8114\t    {\n8115\t    /* Advance past the first bad code unit, and then skip invalid character\n8116\t    starting code units in 8-bit and 16-bit modes. */\n8117\t\n8118\t    start_match = end_subject + 1;\n8119\t\n8120\t#if PCRE2_CODE_UNIT_WIDTH != 32\n8121\t    while (start_match < true_end_subject && NOT_FIRSTCU(*start_match))\n8122\t      start_match++;\n8123\t#endif\n8124\t\n8125\t    /* If we have hit the end of the subject, there isn't another non-empty\n8126\t    fragment, so give up. */\n8127\t\n8128\t    if (start_match >= true_end_subject)\n8129\t      {\n8130\t      rc = MATCH_NOMATCH;  /* In case it was partial */\n8131\t      match_partial = NULL;\n8132\t      break;\n8133\t      }\n8134\t\n8