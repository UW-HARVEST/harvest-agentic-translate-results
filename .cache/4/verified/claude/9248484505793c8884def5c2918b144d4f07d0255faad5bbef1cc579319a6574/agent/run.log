8\t    case OP_COND:\n6009\t    case OP_SCOND:\n6010\t\n6011\t    /* The variable Llength will be added to Fecode when the condition is\n6012\t    false, to get to the second branch. Setting it to the offset to the ALT or\n6013\t    KET, then incrementing Fecode achieves this effect. However, if the second\n6014\t    branch is non-existent, we must point to the KET so that the end of the\n6015\t    group is correctly processed. We now have Fecode pointing to the condition\n6016\t    or callout. */\n6017\t\n6018\t    Llength = GET(Fecode, 1);    /* Offset to the second branch */\n6019\t    if (Fecode[Llength] != OP_ALT) Llength -= 1 + LINK_SIZE;\n6020\t    Fecode += 1 + LINK_SIZE;     /* From this opcode */\n6021\t\n6022\t    /* Because of the way auto-callout works during compile, a callout item is\n6023\t    inserted between OP_COND and an assertion condition. Such a callout can\n6024\t    also be inserted manually. */\n6025\t\n6026\t    if (*Fecode == OP_CALLOUT || *Fecode == OP_CALLOUT_STR)\n6027\t      {\n6028\t      rrc = do_callout(F, mb, &length);\n6029\t      if (rrc > 0) RRETURN(MATCH_NOMATCH);\n6030\t      if (rrc < 0) RRETURN(rrc);\n6031\t\n6032\t      /* Advance Fecode past the callout, so it now points to the condition. We\n6033\t      must adjust Llength so that the value of Fecode+Llength is unchanged. */\n6034\t\n6035\t      Fecode += length;\n6036\t      Llength -= length;\n6037\t      }\n6038\t\n6039\t    /* Test the various possible conditions */\n6040\t\n6041\t    condition = FALSE;\n6042\t    switch(*Fecode)\n6043\t      {\n6044\t      case OP_RREF:                  /* Group recursion test */\n6045\t      if (Fcurrent_recurse != RECURSE_UNSET)\n6046\t        {\n6047\t        number = GET2(Fecode, 1);\n6048\t        condition = (number == RREF_ANY || number == Fcurrent_recurse);\n6049\t        }\n6050\t      break;\n6051\t\n6052\t      case OP_DNRREF:       /* Duplicate named group recursion test */\n6053\t      if (Fcurrent_recurse != RECURSE_UN