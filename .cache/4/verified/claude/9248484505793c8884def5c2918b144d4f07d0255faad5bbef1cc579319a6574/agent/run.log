 META_MINMAX_QUERY     0x80430000u  /* {n,m}? repeat */\n161\t\n162\t/* These meta codes must be kept in a group, with the OR/SUB/XOR in\n163\tthis order, and AND/NOT at the start/end. */\n164\t\n165\t#define META_ECLASS_AND       0x80440000u  /* && (or &) in a class */\n166\t#define META_ECLASS_OR        0x80450000u  /* || (or |, +) in a class */\n167\t#define META_ECLASS_SUB       0x80460000u  /* -- (or -) in a class */\n168\t#define META_ECLASS_XOR       0x80470000u  /* ~~ (or ^) in a class */\n169\t#define META_ECLASS_NOT       0x80480000u  /* ! in a class */\n170\t\n171\t/* Convenience aliases. */\n172\t\n173\t#define META_FIRST_QUANTIFIER META_ASTERISK\n174\t#define META_LAST_QUANTIFIER  META_MINMAX_QUERY\n175\t\n176\t/* This is a special \"meta code\" that is used only to distinguish (*asr: from\n177\t(*sr: in the table of alphabetic assertions. It is never stored in the parsed\n178\tpattern because (*asr: is turned into (*sr:(*atomic: at that stage. There is\n179\ttherefore no need for it to have a length entry, so use a high value. */\n180\t\n181\t#define META_ATOMIC_SCRIPT_RUN 0x8fff0000u\n182\t\n183\t/* Macros for manipulating elements of the parsed pattern vector. */\n184\t\n185\t#define META_CODE(x)   (x & 0xffff0000u)\n186\t#define META_DATA(x)   (x & 0x0000ffffu)\n187\t#define META_DIFF(x,y) ((x-y)>>16)\n188\t\n189\t/* Macros to store and retrieve a PCRE2_SIZE value in the parsed pattern, which\n190\tconsists of uint32_t elements. Assume that if uint32_t can't hold it, two of\n191\tthem will be able to (i.e. assume a 64-bit world). */\n192\t\n193\t#if PCRE2_SIZE_MAX <= UINT32_MAX\n194\t#define PUTOFFSET(s,p) *p++ = s\n195\t#define GETOFFSET(s,p) s = *p++\n196\t#define GETPLUSOFFSET(s,p) s = *(++p)\n197\t#define READPLUSOFFSET(s,p) s = p[1]\n198\t#define SKIPOFFSET(p) p++\n199\t#define SIZEOFFSET 1\n200\t#else\n201\t#define PUTOFFSET(s,p) \\\n202\t  { *p++ = (uint32_t)(s >> 32); *p++ = (uint32_t)(s & 0xffffffff); }\n203\t#define GETOFFSET(s,p) \\\n204\t  { s = ((PCRE2_SIZE)p[0] << 32) | (PCRE2_SIZE)p[1]; p += 2; }\n205\t#define GETPLUSOFFSET(s,p) \\\n206\t  { s = ((PCRE2_SIZE)p[1] << 32) | (PCRE2_SIZE)p[2]; p += 2; }\n207\t#define READPLUSOFFSET(s,p) \\\n208\t  { s = ((PCRE2_SIZE)p[1] << 32) | (PCRE2_SIZE)p[2]; }\n209\t#define SKIPOFFSET(p) p += 2\n210\t#define SIZEOFFSET 2\n211\t#endif\n212\t\n213\t#ifdef PCRE2_DEBUG\n214\t/* Compile data types. */\n215\t#define CDATA_RECURSE_ARGS       0 /* Argument list for recurse */\n216\t#define CDATA_CRANGE             1 /* Character range list */\n217\t#endif\n218\t\n219\t/* Extended class management flags. */\n220\t\n221\t#define CLASS_IS_ECLASS 0x1\n222\t\n223\t/* Macro for the highest character value. */\n224\t\n225\t#if PCRE2_CODE_UNIT_WIDTH == 8\n226\t#define MAX_UCHAR_VALUE 0xffu\n227\t#elif PCRE2_CODE_UNIT_WIDTH == 16\n228\t#define MAX_UCHAR_VALUE 0xffffu\n229\t#else\n230\t#define MAX_UCHAR_VALUE 0xffffffffu\n231\t#endif\n232\t\n233\t#define GET_MAX_CHAR_VALUE(utf) \\\n234\t  ((utf) ? MAX_UTF_CODE_POINT : MAX_UCHAR_VALUE)\n235\t\n236\t/* Macro for setting individual bits in class bitmaps. */\n237\t\n238\t#define SETBIT(a,b) a[(b) >> 3] |= (uint8_t)(1u << ((b) & 0x7))\n239\t\n240\t/* Macro for 8 bit specific checks. */\n241\t#if PCRE2_CODE_UNIT_WIDTH == 8\n242\t#define SELECT_VALUE8(value8, value) (value8)\n243\t#else\n244\t#define SELECT_VALUE8(value8, value) (value)\n245\t#endif\n246\t\n247\t/* Macro for aligning data. */\n248\t#define CLIST_ALIGN_TO(base, align) \\\n249\t  ((base + ((size_t)(align) - 1)) & ~((size_t)(align) - 1))\n250\t\n251\t/* Structure for holding information about an OP_ECLASS internal operand.\n252\tAn \"operand\" here could be just a single OP_[X]CLASS, or it could be some\n253\tcomplex expression; but it's some sequence of ECL_* codes which pushes one\n254\tvalue to the stack. */\n255\ttypedef struct {\n256\t  /* The position of the operand - or NULL if (lengthptr != NULL). */\n257\t  PCRE2_UCHAR *code_start;\n258\t  PCRE2_SIZE length;\n25