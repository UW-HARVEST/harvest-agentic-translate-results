u2;\n6991\t#endif\n6992\t\n6993\tPCRE2_UCHAR first_cu = 0;\n6994\tPCRE2_UCHAR first_cu2 = 0;\n6995\tPCRE2_UCHAR req_cu = 0;\n6996\tPCRE2_UCHAR req_cu2 = 0;\n6997\t\n6998\tPCRE2_UCHAR null_str[1] = { 0xcd };\n6999\tPCRE2_SPTR original_subject = subject;\n7000\tPCRE2_SPTR bumpalong_limit;\n7001\tPCRE2_SPTR end_subject;\n7002\tPCRE2_SPTR true_end_subject;\n7003\tPCRE2_SPTR start_match;\n7004\tPCRE2_SPTR req_cu_ptr;\n7005\tPCRE2_SPTR start_partial;\n7006\tPCRE2_SPTR match_partial;\n7007\t\n7008\t#ifdef SUPPORT_JIT\n7009\tBOOL use_jit;\n7010\t#endif\n7011\t\n7012\t/* This flag is needed even when Unicode is not supported for convenience\n7013\t(it is used by the IS_NEWLINE macro). */\n7014\t\n7015\tBOOL utf = FALSE;\n7016\t\n7017\t#ifdef SUPPORT_UNICODE\n7018\tBOOL ucp = FALSE;\n7019\tBOOL allow_invalid;\n7020\tuint32_t fragment_options = 0;\n7021\t#ifdef SUPPORT_JIT\n7022\tBOOL jit_checked_utf = FALSE;\n7023\t#endif\n7024\t#endif  /* SUPPORT_UNICODE */\n7025\t\n7026\tPCRE2_SIZE frame_size;\n7027\tPCRE2_SIZE heapframes_size;\n7028\t\n7029\t/* We need to have mb as a pointer to a match block, because the IS_NEWLINE\n7030\tmacro is used below, and it expects NLBLOCK to be defined as a pointer. */\n7031\t\n7032\tpcre2_callout_block cb;\n7033\tmatch_block actual_match_block;\n7034\tmatch_block *mb = &actual_match_block;\n7035\t\n7036\t/* Recognize NULL, length 0 as an empty string. */\n7037\t\n7038\tif (subject == NULL && length == 0) subject = null_str;\n7039\t\n7040\t/* Plausibility checks */\n7041\t\n7042\tif (match_data == NULL) return PCRE2_ERROR_NULL;\n7043\tif (code == NULL || subject == NULL)\n7044\t  return match_data->rc = PCRE2_ERROR_NULL;\n7045\tif ((options & ~PUBLIC_MATCH_OPTIONS) != 0)\n7046\t  return match_data->rc = PCRE2_ERROR_BADOPTION;\n7047\t\n7048\tstart_match = subject + start_offset;\n7049\treq_cu_ptr = start_match - 1;\n7050\tif (length == PCRE2_ZERO_TERMINATED)\n7051\t  {\n7052\t  length = PRIV(strlen)(subject);\n7053\t  }\n7054\ttrue_end_subject = end_subject = subject + length;\n7055\t\n7056\tif (start_offset > length) return match_data->rc = PCRE2_ERROR_BADOFFSET;\n7057\t\n7058\t/* Check that the first field in the block is the magic number. */\n7059\t\n7060\tif (re->magic_number != MAGIC_NUMBER)\n7061\t  return match_data->rc = PCRE2_ERROR_BADMAGIC;\n7062\t\n7063\t/* Check the code unit width. */\n7064\t\n7065\tif ((re->flags & PCRE2_MODE_MASK) != PCRE2_CODE_UNIT_WIDTH/8)\n7066\t  return match_data->rc = PCRE2_ERROR_BADMODE;\n7067\t\n7068\t/* PCRE2_NOTEMPTY and PCRE2_NOTEMPTY_ATSTART are match-time flags in the\n7069\toptions variable for this function. Users of PCRE2 who are not calling the\n7070\tfunction directly would like to have a way of setting these flags, in the same\n7071\tway that they can set pcre2_compile() flags like PCRE2_NO_AUTO_POSSESS with\n7072\tconstructions like (*NO_AUTOPOSSESS). To enable this, (*NOTEMPTY) and\n7073\t(*NOTEMPTY_ATSTART) set bits in the pattern's \"flag\" function which we now\n7074\ttransfer to the options for this function. The bits are guaranteed to be\n7075\tadjacent, but do not have the same values. This bit of Boolean trickery assumes\n7076\tthat the match-time bits are not more significant than the flag bits. If by\n7077\taccident this is not the case, a compile-time division by zero error will\n7078\toccur. */\n7079\t\n7080\t#define FF (PCRE2_NOTEMPTY_SET|PCRE2_NE_ATST_SET)\n7081\t#define OO (PCRE2_NOTEMPTY|PCRE2_NOTEMPTY_ATSTART)\n7082\toptions |= (re->flags & FF) / ((FF & (~FF+1)) / (OO & (~OO+1)));\n7083\t#undef FF\n7084\t#undef OO\n7085\t\n7086\t/* If the pattern was successfully studied with JIT support, we will run the\n7087\tJIT executable instead of the rest of this function. Most options must be set\n7088\tat compile time for the JIT code to be usable. */\n7089\t\n7090\t#ifdef SUPPORT_JIT\n7091\tuse_jit = (re->executable_jit != NULL &&\n7092\t          (options & ~PUBLIC_JIT_MATCH_OPTIONS) == 0);\n7093\t#endif\n7094\t\n7095\t/* Initialize UTF/UCP parameters. */\n7096\t\n7097\t#ifdef SUPPORT_UNICODE\n7098\tutf = (re->overall_options & PCRE2_UTF) != 0;\n7099\tallow_invalid = (re->overall_options & PCRE2_MATCH_INVALID_UTF) != 0;\n7100\tucp = (re->overall_options & PCRE2_UCP) != 0;\n7101\t#endif  /* SUPPORT_UNICODE */\n7102\t\n7103\t/* Convert the partial matching flags into an integer. */\n7104\t\n7105\tmb->partial = ((options & PCRE2_PARTIAL_HARD) != 0)? 2 :\n7106\t              ((options & PCRE2_PARTIAL_SOFT) != 0)? 1 : 0;\n7107\t\n7108\t/* Partial matching and PCRE2_ENDANCHORED are currently not allowed at the same\n7109\ttime. */\n7110\t\n7111\tif (mb->partial != 0 &&\n7112\t   ((re->overall_options | options) & PCRE2_ENDANCHORED) != 0)\n7113\t  return match_data->rc = PCRE2_ERROR_BADOPTION;\n7114\t\n7115\t/* It is an error to set an offset limit without setting the flag at compile\n7116\ttime. */\n7117\t\n7118\tif (mcontext != NULL && mcontext->offset_limit != PCRE2_UNSET &&\n7119\t     (re->overall_options & PCRE2_USE_OFFSET_LIMIT) == 0)\n7120\t  return match_data->rc = PCRE2_ERROR_BADOFFSETLIMIT;\n7121\t\n7122\t/* If the match data block was previously used with PCRE2_COPY_MATCHED_SUBJECT,\n7123\tfree the memory that was obtained. Set the field to NULL for match error\n7124\tcases. */\n7125\t\n7126\tif ((match_data->flags & PCRE2_MD_COPIED_SUBJECT) != 0)\n7127\t  {\n7128\t  match_data->memctl.free((void *)match_data->subject,\n7129\t    match_data->memctl.memory_data);\n7130\t  match_data->flags &= ~PCRE2_MD_COPIED_SUBJECT;\n7131\t  }\n7132\tmatch_data->subject = NULL;\n7133\t\n7134\t/* Zero the error offset in case the first code unit is invalid UTF. */\n7135\t\n7136\tmatch_data->startchar = 0;\n7137\t\n7138\t\n7139\t/* ============================= JIT matching ============================== */\n7140\t\n7141\t/* Prepare for JIT matching. Check a UTF string for validity unless no check is\n7142\trequested or invalid UTF can be handled. We check only the portion of the\n7143\tsubject that might be be inspected during matching - from the offset minus the\n7144\tmaximum lookbehind to the given length. This saves time when a small part of a\n7145\tlarge subject is being matched by the use of a starting offset. Note that the\n7146\tmaximum lookbehind is a number of characters, not code units. */\n7147\t\n7148\t#ifdef SUPPORT_JIT\n7149\tif (use_jit)\n7150\t  {\n7151\t#ifdef SUPPORT_UNICODE\n7152\t  if (utf && (options & PCRE2_NO_UTF_CHECK) == 0 && !allow_invalid)\n7153\t    {\n7154\t\n7155\t    /* For 8-bit and 16-bit UTF, check that the first code unit is a valid\n7156\t    character start. */\n7157\t\n7158\t#if PCRE2_CODE_UNIT_WIDTH != 32\n7159\t    if (start_match < end_subject && NOT_FIRSTCU(*start_match))\n7160\t      {\n7161\t      if (start_offset > 0) return match_data->rc = PCRE2_ERROR_BADUTFOFFSET;\n7162\t#if PCRE2_CODE_UNIT_WIDTH == 8\n7163\t      return match_data->rc = PCRE2_ERROR_UTF8_ERR20;  /* Isolated 0x80 byte */\n7164\t#else\n7165\t      return match_data->rc = PCRE2_ERROR_UTF16_ERR3;  /* Isolated low surrogate */\n7166\t#endif\n7167\t      }\n7168\t#endif  /* WIDTH != 32 */\n7169\t\n7170\t    /* Move back by the maximum lookbehind, just in case it happens at the very\n7171\t    start of matching. */\n7172\t\n7173\t#if PCRE2_CODE_UNIT_WIDTH != 32\n7174\t    for (unsigned int i = re->max_lookbehind; i > 0 && start_match > subject; i--)\n7175\t      {\n7176\t      start_match--;\n7177\t      while (start_match > subject &&\n7178\t#if PCRE2_CODE_UNIT_WIDTH == 8\n7179\t      (*start_match & 0xc0) == 0x80)\n7180\t#else  /* 16-bit */\n7181\t      (*start_match & 0xfc00) == 0xdc00)\n7182\t#endif\n7183\t        start_match--;\n7184\t      }\n7185\t#else  /* PCRE2_CODE_UNIT_WIDTH != 32 */\n7186\t\n7187\t    /* In the 32-bit library, one code unit equals one character. However,\n7188\t    we cannot just subtract the lookbehind and then compare pointers, because\n7189\t    a very large lookbehind could create an invalid pointer. */\n7190\t\n7191\t    if (start_offset >= re->max_lookbehind)\n7192\t      start_match -= re->max_lookbehind;\n7193\t    else\n7194\t      start_match = subject;\n7195\t#endif  /* PCRE2_CODE_UNIT_WIDTH != 32 */\n7196\t\n7197\t    /* Validate the relevant portion of the subject. Adjust the offset of an\n7198\t    invalid code point to be an absolute offset in the whole string. */\n7199\t\n7200\t    rc = PRIV(valid_utf)(start_match,\n7201\t      length - (start_match - subject), &(match_data->startchar));\n7202\t    if (rc != 0)\n7203\t      {\n7204\t      match_data->startchar += start_match - subject;\n7205\t      return match_data->rc = rc;\n7206\t      }\n7207\t    jit_checked_utf = TRUE;\n7208\t    }\n7209\t#endif  /* SUPPORT_UNICODE */\n7210\t\n7211\t  /* If JIT returns BADOPTION, which means that the selected complete or\n7212\t  partial matching mode was not compiled, fall through to the interpreter. */\n7213\t\n7214\t  rc = pcre2_jit_match(code, subject, length, start_offset, options,\n7215\t    match_data, mcontext);\n7216\t  if (rc != PCRE2_ERROR_JIT_BADOPTION)\n7217\t    {\n7218\t    match_data->options = original_options;\n7219\t    if (rc >= 0 && (options & PCRE2_COPY_MATCHED_SUBJECT) != 0)\n7220\t      {\n7221\t      if (length != 0)\n7222\t        {\n7223\t        match_data->subject = match_data->memctl.malloc(CU2BYTES(length),\n7224\t          match_data->memctl.memory_data);\n7225\t        if (match_data->subject == NULL)\n7226\t          return match_data->rc = PCRE2_ERROR_NOMEMORY;\n7227\t        memcpy((void *)match_data->subject, subject, CU2BYTES(length));\n7228\t        }\n7229\t      else\n7230\t        match_data->subject = NULL;\n7231\t      match_data->flags |= PCRE2_MD_COPIED_SUBJECT;\n7232\t      }\n7233\t    else\n7234\t      {\n7235\t      /* When pcre2_jit_match sets the subject, it doesn't know what the\n7236\t      original passed-in pointer was. */\n7237\t      if (match_data->subject != NULL) match_data->subject = original_subject;\n7238\t      }\n7239\t    return rc;\n7240\t    }\n7241\t  }\n7242\t#endif  /* SUPPORT_JIT */\n7243\t\n7244\t/* ========================= End of JIT matching ========================== */\n7245\t\n7246\t\n7247\t/* Proceed with non-JIT matching. The default is to allow lookbehinds to the\n7248\tstart of the subject. A UTF check when there is a non-zero offset may change\n7249\tthis. */\n7250\t\n7251\tmb->check_subject = subject;\n7252\t\n7253\t/* If a UTF subject string was not checked for validity in the JIT code above,\n7254\tcheck it here, and handle support for invalid UTF strings. The check above\n7255\thappens only when invalid UTF is not supported and PCRE2_NO_CHECK_UTF is unset.\n7256\tIf we get here in those circumstances, it means the subject string is valid,\n7257\tbut for some reason JIT matching was not successful. There is no need to check\n7258\tthe subject again.\n7259\t\n7260\tWe check only the portion of the subject that might be be inspected during\n7261\tmatching - from the offset minus the maximum lookbehind to the given length.\n7262\tThis saves time when a small part of a large subject is being matched by the\n7263\tuse of a starting offset. Note that the maximum lookbehind is a number of\n7264\tcharacters, not code units.\n7265\t\n7266\tNote also that support for invalid UTF forces a check, overriding the setting\n7267\tof PCRE2_NO_CHECK_UTF. */\n7268\t\n7269\t#ifdef SUPPORT_UNICODE\n7270\tif (utf &&\n7271\t#ifdef SUPPORT_JIT\n7272\t    !jit_checked_utf &&\n7273\t#endif\n7274\t    ((options & PCRE2_NO_UTF_CHECK) == 0 || allow_invalid))\n7275\t  {\n7276\t#if PCRE2_CODE_UNIT_WIDTH != 32\n7277\t  BOOL skipped_bad_start = FALSE;\n7278\t#endif\n7279\t\n7280\t  /* For 8-bit and 16-bit UTF, check that the first code unit is a valid\n7281\t  character start. If we are handling invalid UTF, just skip over such code\n7282\t  units. Otherwise, give an appropriate error. */\n7283\t\n7284\t#if PCRE2_CODE_UNIT_WIDTH != 32\n7285\t  if (allow_invalid)\n7286\t    {\n7287\t    while (start_match < end_subject && NOT_FIRSTCU(*start_match))\n7288\t      {\n7289\t      start_match++;\n7290\t      skipped_bad_start = TRUE;\n7291\t      }\n7292\t    }\n7293\t  else if (start_match < end_subject && NOT_FIRSTCU(*start_match))\n7294\t    {\n7295\t    if (start_offset > 0) return match_data->rc = PCRE2_ERROR_BADUTFOFFSET;\n7296\t#if PCRE2_CODE_UNIT_WIDTH == 8\n7297\t    return match_data->rc = PCRE2_ERROR_UTF8_ERR20;  /* Isolated 0x80 byte */\n7298\t#else\n7299\t    return match_data->rc = PCRE2_ERROR_UTF16_ERR3;  /* Isolated low surrogate */\n7300\t#endif\n7301\t    }\n7302\t#endif  /* WIDTH != 32 */\n7303\t\n7304\t  /* The mb->check_subject field points to the start of UTF checking;\n7305\t  lookbehinds can go back no further than this. */\n7306\t\n7307\t  mb->check_subject = start_match;\n7308\t\n7309\t  /* Move back by the maximum lookbehind, just in case it happens at the very\n7310\t  start of matching, but don't do this if we skipped bad 8-bit or 16-bit code\n7311\t  units above. */\n7312\t\n7313\t#if PCRE2_CODE_UNIT_WIDTH != 32\n7314\t  if (!skipped_bad_start)\n7315\t    {\n7316\t    unsigned int i;\n7317\t    for (i = re->max_lookbehind; i > 0 && mb->check_subject > subject; i--)\n7318\t      {\n7319\t      mb->check_subject--;\n7320\t      while (mb->check_subject > subject &&\n7321\t#if PCRE2_CODE_UNIT_WIDTH == 8\n7322\t      (*mb->check_subject & 0xc0) == 0x80)\n7323\t#else  /* 16-bit */\n7324\t      (*mb->check_subject & 0xfc00) == 0xdc00)\n7325\t#endif\n7326\t        mb->check_subject--;\n7327\t      }\n7328\t    }\n7329\t#else  /* PCRE2_CODE_UNIT_WIDTH != 32 */\n7330\t\n7331\t  /* In the 32-bit library, one code unit equals one character. However,\n7332\t  we cannot just subtract the lookbehind and then compare pointers, because\n7333\t  a very large lookbehind could create an invalid pointer. */\n7334\t\n7335\t  if (start_offset >= re->max_lookbehind)\n7336\t    mb->check_subject -= re->max_lookbehind;\n7337\t  else\n7338\t    mb->check_subject = subject;\n7339\t#endif  /* PCRE2_CODE_UNIT_WIDTH != 32 */\n7340\t\n7341\t  /* Validate the relevant portion of the subject. There's a loop in case we\n7342\t  encounter bad UTF in the characters preceding start_match which we are\n7343\t  scanning because of a lookbehind. */\n7344\t\n7345\t  for (;;)\n7346\t    {\n7347\t    rc = PRIV(valid_utf)(mb->check_subject,\n7348\t      length - (mb->check_subject - subject), &(match_data->startchar));\n7349\t\n7350\t    if (rc == 0) break;   /* Valid UTF string */\n7351\t\n7352\t    /* Invalid UTF string. Adjust the offset to be an absolute offset in the\n7353\t    whole string. If we are handling invalid UTF strings, set end_subject to\n7354\t    stop before the bad code unit, and set the options to \"not end of line\".\n7355\t    Otherwise return the error. */\n7356\t\n7357\t    match_data->startchar += mb->check_subject - subject;\n7358\t    if (!allow_invalid || rc > 0) return match_data->rc = rc;\n7359\t    end_subject = subject + match_data->startchar;\n7360\t\n7361\t    /* If the end precedes start_match, it means there is invalid UTF in the\n7362\t    extra code units we reversed over because of a lookbehind. Advance past the\n7363\t    first bad code unit, and then skip invalid character starting code units in\n7364\t    8-bit and 16-bit modes, and try again with the original end point. */\n7365\t\n7366\t    if (end_subject < start_match)\n7367\t      {\n7368\t      mb->check_subject = end_subject + 1;\n7369\t#if PCRE2_CODE_UNIT_WIDTH != 32\n7370\t      while (mb->check_subject < start_match && NOT_FIRSTCU(*mb->check_subject))\n7371\t        mb->check_subject++;\n7372\t#endif\n7373\t      end_subject = true_end_subject;\n7374\t      }\n7375\t\n7376\t    /* Otherwise, set the not end of line option, and do the match. */\n7377\t\n7378\t    else\n7379\t      {\n7380\t      fragment_options = PCRE2_NOTEOL;\n7381\t      break;\n7382\t      }\n7383\t    }\n7384\t  }\n7385\t#endif  /* SUPPORT_UNICODE */\n7386\t\n7387\t/* A NULL match context means \"use a default context\", but we take the memory\n7388\tcontrol functions from the pattern. */\n7389\t\n7390\tif (mcontext == NULL)\n7391\t  {\n7392\t  mcontext = (pcre2_match_context *)(&PRIV(default_match_context));\n7393\t  mb->memctl = re->memctl;\n7394\t  }\n7395\telse mb->memctl = mcontext->memctl;\n7396\t\n7397\tanchored = ((re->overall_options | options) & PCRE2_ANCHORED) != 0;\n7398\tfirstline = !anchored && (re->overall_options & PCRE2_FIRSTLINE) != 0;\n7399\tstartline = (re->flags & PCRE2_STARTLINE) != 0;\n7400\tbumpalong_limit = (mcontext->offset_limit == PCRE2_UNSET)?\n7401\t  true_end_subject : subject + mcontext->offset_limit;\n7402\t\n7403\t/* Initialize and set up the fixed fields in the callout block, with a pointer\n7404\tin the match block. */\n7405\t\n7406\tmb->cb = &cb;\n7407\tcb.version = 2;\n7408\tcb.subject = subject;\n7409\tcb.subject_length = (PCRE2_SIZE)(end_subject - subject);\n7410\tcb.callout_flags = 0;\n7411\t\n7412\t/* Fill in the remaining fields in the match block, except for moptions, which\n7413\tgets set later. */\n7414\t\n7415\tmb->callout = mcontext->callout;\n7416\tmb->callout_data = mcontext->callout_data;\n7417\t\n7418\tmb->start_subject = subject;\n7419\tmb->start_offset = start_offset;\n7420\tmb->end_subject = end_subject;\n7421\tmb->true_end_subject = true_end_subject;\n7422\tmb->hasthen = (re->flags & PCRE2_HASTHEN) != 0;\n7423\tmb->hasbsk = (re->flags & PCRE2_HASBSK) != 0;\n7424\tmb->allowemptypartial = (re->max_lookbehind > 0) ||\n7425\t    (re->flags & PCRE2_MATCH_EMPTY) != 0;\n7426\tmb->allowlookaroundbsk =\n7427\t  (re->extra_options & PCRE2_EXTRA_ALLOW_LOOKAROUND_BSK) != 0;\n7428\tmb->poptions = re->overall_options;          /* Pattern options */\n7429\tmb->ignore_skip_arg = 0;\n7430\tmb->mark = mb->nomatch_mark = NULL;          /* In case never set */\n7431\t\n7432\t/* The name table is needed for finding all the numbers associated with a\n7433\tgiven name, for condition testing. The code follows the name table. */\n7434\t\n7435\tmb->name_table = (PCRE2_SPTR)((const uint8_t *)re + sizeof(pcre2_real_code));\n7436\tmb->name_count = re->name_count;\n7437\tmb->name_entry_size = re->name_entry_size;\n7438\tmb->start_code = (PCRE2_SPTR)((const uint8_t *)re + re->code_start);\n7439\t\n7440\t/* Process the \\R and newline settings. */\n7441\t\n7442\tmb->bsr_convention = re->bsr_convention;\n7443\tmb->nltype = NLTYPE_FIXED;\n7444\tswitch(re->newline_convention)\n7445\t  {\n7446\t  case PCRE2_NEWLINE_CR:\n7447\t  mb->nllen = 1;\n7448\t  mb->nl[0] = CHAR_CR;\n7449\t  break;\n7450\t\n7451\t  case PCRE2_NEWLINE_LF:\n7452\t  mb->nllen = 1;\n7453\t  mb->nl[0] = CHAR_NL;\n7454\t  break;\n7455\t\n7456\t  case PCRE2_NEWLINE_NUL:\n7457\t  mb->nllen = 1;\n7458\t  mb->nl[0] = CHAR_NUL;\n7459\t  break;\n7460\t\n7461\t  case PCRE2_NEWLINE_CRLF:\n7462\t  mb->nllen = 2;\n7463\t  mb->nl[0] = CHAR_CR;\n7464\t  mb->nl[1] = CHAR_NL;\n7465\t  break;\n7466\t\n7467\t  case PCRE2_NEWLINE_ANY:\n7468\t  mb->nltype = NLTYPE_ANY;\n7469\t  break;\n7470\t\n7471\t  case PCRE2_NEWLINE_ANYCRLF:\n7472\t  mb->nltype = NLTYPE_ANYCRLF;\n7473\t  break;\n7474\t\n7475\t  /* LCOV_EXCL_START */\n7476\t  default:\n7477\t  PCRE2_DEBUG_UNREACHABLE();\n7478\t  return match_data->rc = PCRE2_ERROR_INTERNAL;\n7479\t  /* LCOV_EXCL_STOP */\n7480\t  }\n7481\t\n7482\t/* The backtracking frames have fixed data at the front, and a PCRE2_SIZE\n7483\tvector at the end, whose size depends on the number of capturing parentheses in\n7484\tthe pattern. It is not used at all if there are no capturing parentheses.\n7485\t\n7486\t  frame_size                   is the total size of each frame\n7487\t  match_data->heapframes       is the pointer to the frames vector\n7488\t  match_data->heapframes_size  is the allocated size of the vector\n7489\t\n7490\tWe must pad the frame_size for alignment to ensure subsequent frames are as\n7491\taligned as heapframe. Whilst ovector is word-aligned due to being a PCRE2_SIZE\n7492\tarray, that does not guarantee it is suitably aligned for pointers, as some\n7493\tarchitectures have pointers that are larger than a size_t. */\n7494\t\n7495\tframe_size = (offsetof(heapframe, ovector) +\n7496\t  re->top_bracket * 2 * sizeof(PCRE2_SIZE) + HEAPFRAME_ALIGNMENT - 1) &\n7497\t  ~(HEAPFRAME_ALIGNMENT - 1);\n7498\t\n7499\t/* Limits set in the pattern override the match context only if they are\n7500\tsmaller. */\n7501\t\n7502\tmb->heap_limit = ((mcontext->heap_limit < re->limit_heap)?\n7503\t  mcontext->heap_limit : re->limit_heap);\n7504\t\n7505\tmb->match_limit = (mcontext->match_limit < re->limit_match)?\n7506\t  mcontext->match_limit : re->limit_match;\n7507\t\n7508\tmb->match_limit_depth = (mcontext->depth_limit < re->limit_depth)?\n7509\t  mcontext->depth_limit : re->limit_depth;\n7510\t\n7511\t/* If a pattern has very many capturing parentheses, the frame size may be very\n7512\tlarge. Set the initial frame vector size to ensure that there are at least 10\n7513\tavailable frames, but enforce a minimum of START_FRAMES_SIZE. If this is\n7514\tgreater than the heap limit, get as large a vector as possible. */\n7515\t\n7516\theapframes_size = frame_size * 10;\n7517\tif (heapframes_size < START_FRAMES_SIZE) heapframes_size = START_FRAMES_SIZE;\n7518\tif (heapframes_size / 1024 > mb->heap_limit)\n7519\t  {\n7520\t  PCRE2_SIZE max_size = 1024 * mb->heap_limit;\n7521\t  if (max_size < frame_size) return match_data->rc = PCRE2_ERROR_HEAPLIMIT;\n7522\t  heapframes_size = max_size;\n7523\t  }\n7524\t\n7525\t/* If an existing frame vector in the match_data block is large enough, we can\n7526\tuse it. Otherwise, free any pre-existing vector and get a new one. */\n7527\t\n7528\tif (match_data->heapframes_size < heapframes_size)\n7529\t  {\n7530\t  match_data->memctl.free(match_data->heapframes,\n7531\t    match_data->memctl.memory_data);\n7532\t  match_data->heapframes = match_data->memctl.malloc(heapframes_size,\n7533\t    match_data->memctl.memory_data);\n7534\t  if (match_data->heapframes == NULL)\n7535\t    {\n7536\t    match_data->heapframes_size = 0;\n7537\t    return match_data->rc = PCRE2_ERROR_NOMEMORY;\n7538\t    }\n7539\t  match_data->heapframes_size = heapframes_size;\n7540\t  }\n7541\t\n7542\t/* Write to the ovector within the first frame to mark every capture unset and\n7543\tto avoid uninitialized memory read errors when it is copied to a new frame. */\n7544\t\n7545\tmemset((char *)(match_data->heapframes) + offsetof(heapframe, ovector), 0xff,\n7546\t  frame_size - offsetof(heapframe, ovector));\n7547\t\n7548\t/* Pointers to the individual character tables */\n7549\t\n7550\tmb->lcc = re->tables + lcc_offset;\n7551\tmb->fcc = re->tables + fcc_offset;\n7552\tmb->ctypes = re->tables + ctypes_offset;\n7553\t\n7554\t/* Set up the first code unit to match, if available. If there's no first code\n7555\tunit there may be a bitmap of possible first characters. */\n7556\t\n7557\tif ((re->flags & PCRE2_FIRSTSET) != 0)\n7558\t  {\n7559\t  has_first_cu = TRUE;\n7560\t  first_cu = first_cu2 = (PCRE2_UCHAR)(re->first_codeunit);\n7561\t  if ((re->flags & PCRE2_FIRSTCASELESS) != 0)\n7562\t    {\n7563\t    first_cu2 = TABLE_GET(first_cu, mb->fcc, first_cu);\n7564\t#ifdef SUPPORT_UNICODE\n7565\t#if PCRE2_CODE_UNIT_WIDTH == 8\n7566\t    if (first_cu > 127 && ucp && !utf) first_cu2 = UCD_OTHERCASE(first_cu);\n7567\t#else\n7568\t    if (first_cu > 127 && (utf || ucp)) first_cu2 = UCD_OTHERCASE(first_cu);\n7569\t#endif\n7570\t#endif  /* SUPPORT_UNICODE */\n7571\t    }\n7572\t  }\n7573\telse\n7574\t  if (!startline && (re->flags & PCRE2_FIRSTMAPSET) != 0)\n7575\t    start_bits = re->start_bitmap;\n7576\t\n7577\t/* There may also be a \"last known required character\" set. */\n7578\t\n7579\tif ((re->flags & PCRE2_LASTSET) != 0)\n7580\t  {\n7581\t  has_req_cu = TRUE;\n7582\t  req_cu = req_cu2 = (PCRE2_UCHAR)(re->last_codeunit);\n7583\t  if ((re->flags & PCRE2_LASTCASELESS) != 0)\n7584\t    {\n7585\t    req_cu2 = TABLE_GET(req_cu, mb->fcc, req_cu);\n7586\t#ifdef SUPPORT_UNICODE\n7587\t#if PCRE2_CODE_UNIT_WIDTH == 8\n7588\t    if (req_cu > 127 && ucp && !utf) req_cu2 = UCD_OTHERCASE(req_cu);\n7589\t#else\n7590\t    if (req_cu > 127 && (utf || ucp)) req_cu2 = UCD_OTHERCASE(req_cu);\n7591\t#endif\n7592\t#endif  /* SUPPORT_UNICODE */\n7593\t    }\n7594\t  }\n7595\t\n7596\t\n7597\t/* ==========================================================================*/\n7598\t\n7599\t/* Loop for handling unanchored repeated matching attempts; for anchored regexs\n7600\tthe loop runs just once. */\n7601\t\n7602\t#ifdef SUPPORT_UNICODE\n7603\tFRAGMENT_RESTART:\n7604\t#endif\n7605\t\n7606\tstart_partial = match_partial = NULL;\n7607\tmb->hitend = FALSE;\n7608\t\n7609\t#if PCRE2_CODE_UNIT_WIDTH == 8\n7610\tmemchr_found_first_cu = NULL;\n7611\tmemchr_found_first_cu2 = NULL;\n7612\t#endif\n7613\t\n7614\tfor(;;)\n7615\t  {\n7616\t  PCRE2_SPTR new_start_match;\n7617\t\n7618\t  /* ----------------- Start of match optimizations ---------------- */\n7619\t\n7620\t  /* There are some optimizations that avoid running the match if a known\n7621\t  starting point is not found, or if a known later code unit is not present.\n7622\t  However, there is an option (settable at compile time) that disables these,\n7623\t  for testing and for ensuring that all callouts do actually occur. */\n7624\t\n7625\t  if ((re->optimization_flags & PCRE2_OPTIM_START_OPTIMIZE) != 0)\n7626\t    {\n7627\t    /* If firstline is TRUE, the start of the match is constrained to the first\n7628\t    line of a multiline string. That is, the match must be before or at the\n7629\t    first newline following the start of matching. Temporarily adjust\n7630\t    end_subject so that we stop the scans for a first code unit at a newline.\n7631\t    If the match fails at the newline, later code breaks the loop. */\n7632\t\n7633\t    if (firstline)\n7634\t      {\n7635\t      PCRE2_SPTR t = start_match;\n7636\t#ifdef SUPPORT_UNICODE\n7637\t      if (utf)\n7638\t        {\n7639\t        while (t < end_subject && !IS_NEWLINE(t))\n7640\t          {\n7641\t          t++;\n7642\t          ACROSSCHAR(t < end_subject, t, t++);\n7643\t          }\n7644\t        }\n7645\t      else\n7646\t#endif\n7647\t      while (t < end_subject && !IS_NEWLINE(t)) t++;\n7648\t      end_subject = t;\n7649\t      }\n7650\t\n7651\t    /* Anchored: check the first code unit if one is recorded. This may seem\n7652\t    pointless but it can help in detecting a no match case without scanning for\n7653\t    the required code unit. */\n7654\t\n7655\t    if (anchored)\n7656\t      {\n7657\t      if (has_first_cu || start_bits != NULL)\n7658\t        {\n7659\t        BOOL ok = start_match < end_subject;\n7660\t        if (ok)\n7661\t          {\n7662\t          PCRE2_UCHAR c = *start_match;\n7663\t          ok = has_first_cu && (c == first_cu || c == first_cu2);\n7664\t          if (!ok && start_bits != NULL)\n7665\t            {\n7666\t#if PCRE2_CODE_UNIT_WIDTH != 8\n7667\t            if (c > 255) c = 255;\n7668\t#endif\n7669\t            ok = (start_bits[c/8] & (1u << (c&7))) != 0;\n7670\t            }\n7671\t          }\n7672\t        if (!ok)\n7673\t          {\n7674\t          rc = MATCH_NOMATCH;\n7675\t          break;\n7676\t          }\n7677\t        }\n7678\t      }\n7679\t\n7680\t    /* Not anchored. Advance to a unique first code unit if there is one. */\n7681\t\n7682\t    else\n7683\t      {\n7684\t      if (has_first_cu)\n7685\t        {\n7686\t        if (first_cu != first_cu2)  /* Caseless */\n7687\t          {\n7688\t          /* In 16-bit and 32_bit modes we have to do our own search, so can\n7689\t          look for both cases at once. */\n7690\t\n7691\t#if PCRE2_CODE_UNIT_WIDTH != 8\n7692\t          PCRE2_UCHAR smc;\n7693\t          while (start_match < end_subject &&\n7694\t                (smc = *start_match) != first_cu &&\n7695\t                 smc != first_cu2)\n7696\t            start_match++;\n7697\t#else\n7698\t          /* In 8-bit mode, the use of memchr() gives a big speed up, even\n7699\t          though we have to call it twice in order to find the earliest\n7700\t          occurrence of the code unit in either of its cases. Caching is used\n7701\t          to remember the positions of previously found code units. This can\n7702\t          make a huge difference when the strings are very long and only one\n7703\t          case is actually present. */\n7704\t\n7705\t          PCRE2_SPTR pp1 = NULL;\n7706\t          PCRE2_SPTR pp2 = NULL;\n7707\t          PCRE2_SIZE searchlength = end_subject - start_match;\n7708\t\n7709\t          /* If we haven't got a previously found position for first_cu, or if\n7710\t          the current starting position is later, we need to do a search. If\n7711\t          the code unit is not found, set it to the end. */\n7712\t\n7713\t          if (memchr_found_first_cu == NULL ||\n7714\t              start_match > memchr_found_first_cu)\n7715\t            {\n7716\t            pp1 = memchr(start_match, first_cu, searchlength);\n7717\t            memchr_found_first_cu = (pp1 == NULL)? end_subject : pp1;\n7718\t            }\n7719\t\n7720\t          /* If the start is before a previously found position, use the\n7721\t          previous position, or NULL if a previous search failed. */\n7722\t\n7723\t          else pp1 = (memchr_found_first_cu == end_subject)? NULL :\n7724\t            memchr_found_first_cu;\n7725\t\n7726\t          /* Do the same thing for the other case. */\n7727\t\n7728\t          if (memchr_found_first_cu2 == NULL ||\n7729\t              start_match > memchr_found_first_cu2)\n7730\t            {\n7731\t            pp2 = memchr(start_match, first_cu2, searchlength);\n7732\t            memchr_found_first_cu2 = (pp2 == NULL)? end_subject : pp2;\n7733\t            }\n7734\t\n7735\t          else pp2 = (memchr_found_first_cu2 == end_subject)? NULL :\n7736\t            memchr_found_first_cu2;\n7737\t\n7738\t          /* Set the start to the end of the subject if neither case was found.\n7739\t          Otherwise, use the earlier found point. */\n7740\t\n7741\t          if (pp1 == NULL)\n7742\t            start_match = (pp2 == NULL)? end_subject : pp2;\n7743\t          else\n7744\t            start_match = (pp2 == NULL || pp1 < pp2)? pp1 : pp2;\n7745\t\n7746\t#endif  /* 8-bit handling */\n7747\t          }\n7748\t\n7749\t        /* The caseful case is much simpler. */\n7750\t\n7751\t        else\n7752\t          {\n7753\t#if PCRE2_CODE_UNIT_WIDTH != 8\n7754\t          while (start_match < end_subject && *start_match !=\n7755\t                 first_cu)\n7756\t            start_match++;\n7757\t#else\n7758\t          start_match = memchr(start_match, first_cu, end_subject - start_match);\n7759\t          if (start_match == NULL) start_match = end_subject;\n7760\t#endif\n7761\t          }\n7762\t\n7763\t        /* If we can't find the required first code unit, having reached the\n7764\t        true end of the subject, break the bumpalong loop, to force a match\n7765\t        failure, except when doing partial matching, when we let the next cycle\n7766\t        run at the end of the subject. To see why, consider the pattern\n7767\t        /(?<=abc)def/, which partially matches \"abc\", even though the string\n7768\t        does not contain the starting character \"d\". If we have not reached the\n7769\t        true end of the subject (PCRE2_FIRSTLINE caused end_subject to be\n7770\t        temporarily modified) we also let the cycle run, because the matching\n7771\t        string is legitimately allowed to start with the first code unit of a\n7772\t        newline. */\n7773\t\n7774\t        if (mb->partial == 0 && start_match >= mb->end_subject)\n7775\t          {\n7776\t          rc = MATCH_NOMATCH;\n7777\t          break;\n7778\t          }\n7779\t        }\n7780\t\n7781\t      /* If there's no first code unit, advance to just after a linebreak for a\n7782\t      multiline match if required. */\n7783\t\n7784\t      else if (startline)\n7785\t        {\n7786\t        if (start_match > mb->start_subject + start_offset)\n7787\t          {\n7788\t#ifdef SUPPORT_UNICODE\n7789\t          if (utf)\n7790\t            {\n7791\t            while (start_match < end_subject && !WAS_NEWLINE(start_match))\n7792\t              {\n7793\t              start_match++;\n7794\t              ACROSSCHAR(start_match < end_subject, start_match, start_match++);\n7795\t              }\n7796\t            }\n7797\t          else\n7798\t#endif\n7799\t          while (start_match < end_subject && !WAS_NEWLINE(start_match))\n7800\t            start_match++;\n7801\t\n7802\t          /* If we have just passed a CR and the newline option is ANY or\n7803\t          ANYCRLF, and we are now at a LF, advance the match position by one\n7804\t          more code unit. */\n7805\t\n7806\t          if (start_match[-1] == CHAR_CR &&\n7807\t               (mb->nltype == NLTYPE_ANY || mb->nltype == NLTYPE_ANYCRLF) &&\n7808\t               start_match < end_subject &&\n7809\t               *start_match == CHAR_NL)\n7810\t            start_match++;\n7811\t          }\n7812\t        }\n7813\t\n7814\t      /* If there's no first code unit or a requirement for a multiline line\n7815\t      start, advance to a non-unique first code unit if any have been\n7816\t      identified. The bitmap contains only 256 bits. When code units are 16 or\n7817\t      32 bits wide, all code units greater than 254 set the 255 bit. */\n7818\t\n7819\t      else if (start_bits != NULL)\n7820\t        {\n7821\t        while (start_match < end_subject)\n7822\t          {\n7823\t          uint32_t c = *start_match;\n7824\t#if PCRE2_CODE_UNIT_WIDTH != 8\n7825\t          if (c > 255) c = 255;\n7826\t#endif\n7827\t          if ((start_bits[c/8] & (1u << (c&7))) != 0) break;\n7828\t          start_match++;\n7829\t          }\n7830\t\n7831\t        /* See comment above in first_cu checking about the next few lines. */\n7832\t\n7833\t        if (mb->partial == 0 && start_match >= mb->end_subject)\n7834\t          {\n7835\t          rc = MATCH_NOMATCH;\n7836\t          break;\n7837\t          }\n7838\t        }\n7839\t      }   /* End first code unit handling */\n7840\t\n7841\t    /* Restore fudged end_subject */\n7842\t\n7843\t    end_subject = mb->end_subject;\n7844\t\n7845\t    /* The following two optimizations must be disabled for partial matching. */\n7846\t\n7847\t    if (mb->partial == 0)\n7848\t      {\n7849\t      PCRE2_SPTR p;\n7850\t\n7851\t      /* The minimum matching length is a lower bound; no string of that length\n7852\t      may actually match the pattern. Although the value is, strictly, in\n7853\t      characters, we treat it as code units to avoid spending too much time in\n7854\t      this optimization. */\n7855\t\n7856\t      if (end_subject - start_match < re->minlength)\n7857\t        {\n7858\t        rc = MATCH_NOMATCH;\n7859\t        break;\n7860\t        }\n7861\t\n7862\t      /* If req_cu is set, we know that that code unit must appear in the\n7863\t      subject for the (non-partial) match to succeed. If the first code unit is\n7864\t      set, req_cu must be later in the subject; otherwise the test starts at\n7865\t      the match point. This optimization can save a huge amount of backtracking\n7866\t      in patterns with nested unlimited repeats that aren't going to match.\n7867\t      Writing separate code for caseful/caseless versions makes it go faster,\n7868\t      as does using an autoincrement and backing off on a match. As in the case\n7869\t      of the first code unit, using memchr() in the 8-bit library gives a big\n7870\t      speed up. Unlike the first_cu check above, we do not need to call\n7871\t      memchr() twice in the caseless case because we only need to check for the\n7872\t      presence of the character in either case, not find the first occurrence.\n7873\t\n7874\t      The search can be skipped if the code unit was found later than the\n7875\t      current starting point in a previous iteration of the bumpalong loop.\n7876\t\n7877\t      HOWEVER: when the subject string is very, very long, searching to its end\n7878\t      can take a long time, and give bad performance on quite ordinary\n7879\t      anchored patterns. This showed up when somebody was matching something\n7880\t      like /^\\d+C/ on a 32-megabyte string... so we don't do this when the\n7881\t      string is sufficiently long, but it's worth searching a lot more for\n7882\t      unanchored patterns. */\n7883\t\n7884\t      p = start_match + (has_first_cu? 1:0);\n7885\t      if (has_req_cu && p > req_cu_ptr)\n7886\t        {\n7887\t        PCRE2_SIZE check_length = end_subject - start_match;\n7888\t\n7889\t        if (check_length < REQ_CU_MAX ||\n7890\t              (!anchored && check_length < REQ_CU_MAX * 1000))\n7891\t          {\n7892\t          if (req_cu != req_cu2)  /* Caseless */\n7893\t            {\n7894\t#if PCRE2_CODE_UNIT_WIDTH != 8\n7895\t            while (p < end_subject)\n7896\t              {\n7897\t              uint32_t pp = *p++;\n7898\t              if (pp == req_cu || pp == req_cu2) { p--; break; }\n7899\t              }\n7900\t#else  /* 8-bit code units */\n7901\t            PCRE2_SPTR pp = p;\n7902\t            p = memchr(pp, req_cu, end_subject - pp);\n7903\t            if (p == NULL)\n7904\t              {\n7905\t              p = memchr(pp, req_cu2, end_subject - pp);\n7906\t              if (p == NULL) p = end_subject;\n7907\t              }\n7908\t#endif /* PCRE2_CODE_UNIT_WIDTH != 8 */\n7909\t            }\n7910\t\n7911\t          /* The caseful case */\n7912\t\n7913\t          else\n7914\t            {\n7915\t#if PCRE2_CODE_UNIT_WIDTH != 8\n7916\t            while (p < end_subject)\n7917\t              {\n7918\t              if (*p++ == req_cu) { p--; break; }\n7919\t              }\n7920\t\n7921\t#else  /* 8-bit code units */\n7922\t            p = memchr(p, req_cu, end_subject - p);\n7923\t            if (p == NULL) p = end_sub