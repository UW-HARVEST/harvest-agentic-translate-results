);\n151\t        }\n152\t    }\n153\t}\n154\t\n155\t// (h) SUBSTITUTE_MATCHED consistency checks\n156\t#[test]\n157\tfn probe_matched() {\n158\t    let p = pair();\n159\t    unsafe {\n160\t        let mk = |api: &Api, pat: &str, copts: u32| -> Ptr {\n161\t            let pb = pat.as_bytes();\n162\t            let (mut ec, mut eo) = (0 as c_int, 0usize);\n163\t            let c = (api.compile)(pb.as_ptr(), pb.len(), copts, &mut ec, &mut eo, ptr::null_mut());\n164\t            assert!(!c.is_null(), \"compile {pat:?} err {ec}\");\n165\t            c\n166\t        };\n167\t        let a1 = mk(&p.c, \"(a)\", 0);\n168\t        let b1 = mk(&p.r, \"(a)\", 0);\n169\t        let a2 = mk(&p.c, \"(b)\", 0);\n170\t        let b2 = mk(&p.r, \"(b)\", 0);\n171\t        let subj: Vec<u8> = b\"abc\".to_vec();\n172\t        let subj2: Vec<u8> = b\"abc\".to_vec(); // same content, distinct pointer\n173\t        let subj: &[u8] = &subj;\n174\t        let subj2: &[u8] = &subj2;\n175\t        assert_ne!(subj.as_ptr(), subj2.as_ptr());\n176\t        let mut go = |name: &str,\n177\t                      ca: Ptr, cb: Ptr,\n178\t                      pre: &dyn Fn(&Api, Ptr, Ptr),\n179\t                      code_a: Ptr, code_b: Ptr,\n180\t                      s: &[u8], slen: usize, start: usize, so: u32| {\n181\t            let mda = (p.c.match_data_create_from_pattern)(ca, ptr::null_mut());\n182\t            let mdb = (p.r.match_data_create_from_pattern)(cb, ptr::null_mut());\n183\t            pre(&p.c, ca, mda);\n184\t            pre(&p.r, cb, mdb);\n185\t            let cap = 64usize;\n186\t            let mut oa = vec![0xEEu8; cap + 8];\n187\t            let mut ob = vec![0xEEu8; cap + 8];\n188\t            let (mut la, mut lb) = (cap, cap);\n189\t            let ra = (p.c.substitute)(\n190\t                code_a, s.as_ptr(), slen, start, so, mda, ptr::null_mut(),\n191\t                b\"Z\".as_ptr(), 1, oa.as_mut_ptr(), &mut la,\n192\t            );\n193\t            let rbv = (p.r.su