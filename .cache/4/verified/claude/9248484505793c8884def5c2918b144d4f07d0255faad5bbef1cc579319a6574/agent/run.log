kind of unexpected problem\n6970\t*/\n6971\t\n6972\tPCRE2_EXP_DEFN int PCRE2_CALL_CONVENTION\n6973\tpcre2_match(const pcre2_code *code, PCRE2_SPTR subject, PCRE2_SIZE length,\n6974\t  PCRE2_SIZE start_offset, uint32_t options, pcre2_match_data *match_data,\n6975\t  pcre2_match_context *mcontext)\n6976\t{\n6977\tint rc;\n6978\tconst uint8_t *start_bits = NULL;\n6979\tconst pcre2_real_code *re = (const pcre2_real_code *)code;\n6980\tuint32_t original_options = options;\n6981\t\n6982\tBOOL anchored;\n6983\tBOOL firstline;\n6984\tBOOL has_first_cu = FALSE;\n6985\tBOOL has_req_cu = FALSE;\n6986\tBOOL startline;\n6987\t\n6988\t#if PCRE2_CODE_UNIT_WIDTH == 8\n6989\tPCRE2_SPTR memchr_found_first_cu;\n6990\tPCRE2_SPTR memchr_found_first_cu2;\n6991\t#endif\n6992\t\n6993\tPCRE2_UCHAR first_cu = 0;\n6994\tPCRE2_UCHAR first_cu2 = 0;\n6995\tPCRE2_UCHAR req_cu = 0;\n6996\tPCRE2_UCHAR req_cu2 = 0;\n6997\t\n6998\tPCRE2_UCHAR null_str[1] = { 0xcd };\n6999\tPCRE2_SPTR original_subject = subject;\n7000\tPCRE2_SPTR bumpalong_limit;\n7001\tPCRE2_SPTR end_subject;\n7002\tPCRE2_SPTR true_end_subject;\n7003\tPCRE2_SPTR start_match;\n7004\tPCRE2_SPTR req_cu_ptr;\n7005\tPCRE2_SPTR start_partial;\n7006\tPCRE2_SPTR match_partial;\n7007\t\n7008\t#ifdef SUPPORT_JIT\n7009\tBOOL use_jit;\n7010\t#endif\n7011\t\n7012\t/* This flag is needed even when Unicode is not supported for convenience\n7013\t(it is used by the IS_NEWLINE macro). */\n7014\t\n7015\tBOOL utf = FALSE;\n7016\t\n7017\t#ifdef SUPPORT_UNICODE\n7018\tBOOL ucp = FALSE;\n7019\tBOOL allow_invalid;\n7020\tuint32_t fragment_options = 0;\n7021\t#ifdef SUPPORT_JIT\n7022\tBOOL jit_checked_utf = FALSE;\n7023\t#endif\n7024\t#endif  /* SUPPORT_UNICODE */\n7025\t\n7026\tPCRE2_SIZE frame_size;\n7027\tPCRE2_SIZE heapframes_size;\n7028\t\n7029\t/* We need to have mb as a pointer to a match block, because the IS_NEWLINE\n7030\tmacro is used below, and it expects NLBLOCK to be defined as a pointer. */\n7031\t\n7032\tpcre2_callout_block cb;\n7033\tmatch_