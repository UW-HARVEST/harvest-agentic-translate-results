      m=stbds_hmput_key(m,sizeof*m,&k,sizeof m->key,0);\n      m[TEMP((IM*)m-1)].key=k; m[TEMP((IM*)m-1)].value=round*10000+i;}\n    dump(\"churn-put\",(IM*)m-1);\n    for(int i=0;i<200;i+=2){int k=round*1000+i;\n      m=stbds_hmdel_key(m,sizeof*m,&k,sizeof m->key,0,0);\n      printf(\"d %d %td %zu\\n\",k,TEMP((IM*)m-1),HDR((IM*)m-1)->length);}\n    dump(\"churn-del\",(IM*)m-1);\n    for(int i=0;i<200;i++){int k=round*1000+i+500000;\n      m=stbds_hmput_key(m,sizeof*m,&k,sizeof m->key,0);\n      m[TEMP((IM*)m-1)].key=k; m[TEMP((IM*)m-1)].value=-i;}\n    dump(\"churn-put2\",(IM*)m-1);\n  }\n  for(size_t i=1;i<HDR((IM*)m-1)->length;i++) printf(\"v %zu %d %d\\n\",i,m[i].key,m[i].value);\n  /* delete everything -> shrink chain */\n  for(int round=0;round<6;round++)for(int i=0;i<200;i++){\n    int k=round*1000+i; m=stbds_hmdel_key(m,sizeof*m,&k,sizeof m->key,0,0);\n    int k2=round*1000+i+500000; m=stbds_hmdel_key(m,sizeof*m,&k2,sizeof m->key,0,0);\n    printf(\"dd %d %d %zu\\n\",k,k2,HDR((IM*)m-1)->length);\n  }\n  dump(\"emptied\",(IM*)m-1);\n  stbds_hmfree_func((IM*)m-1,sizeof*m);\n\n  /* strdup mode churn (exercises the free paths) */\n  for(int mode=2;mode<=3;mode++){\n    stbds_rand_seed(99);\n    SM *s=stbds_shmode_func(sizeof*s,mode);\n    char kb[64];\n    for(int i=0;i<300;i++){sprintf(kb,\"k%04d_%d\",i,i*7);\n      s=stbds_hmput_key(s,sizeof*s,kb,sizeof s->key,1);\n      s[TEMP((SM*)s-1)].value=i; s[TEMP((SM*)s-1)].key=TEMPKEY((SM*)s-1);}\n    dump(\"sd-put\",(SM*)s-1);\n    for(int i=0;i<300;i+=3){sprintf(kb,\"k%04d_%d\",i,i*7);\n      s=stbds_hmdel_key(s,sizeof*s,kb,sizeof s->key,0,1);\n      printf(\"sd %d %td %zu\\n\",i,TEMP((SM*)s-1),HDR((SM*)s-1)->length);}\n    for(int i=300;i<450;i++){sprintf(kb,\"k%04d_%d\",i,i*7);\n      s=stbds_hmput_key(s,sizeof*s,kb,sizeof s->key,1);\n      s[TEMP((SM*)s-1)].value=i; s[TEMP((SM*)s-1)].key=TEMPKEY((SM*)s-1);}\n    dump(\"sd-put2\",(SM*)s-1);\n    for(size_t i=1;i<HDR((SM*)s-1)->length;i++) printf(\"sv %zu %s %d\\n\",i,s[i].key,s[i].value);\n    for(int i=0;i<460;i++){sprintf(kb,\"k%04d_%d\",i,i*7);\n      s=stbds_hmget_key(s,sizeof*s,kb,sizeof s->key,1);\n      printf(\"sg %d %td\\n\",i,TEMP((SM*)s-1));}\n    stbds_hmfree_func((SM*)s-1,sizeof*s);\n  }\n  /* unaligned / odd length hash bytes with high bits */\n  unsigned char blob[80];\n  for(int i=0;i<80;i++) blob[i]=(unsigned char)(i*211+17);\n  for(int off=0;off<8;off++) for(int L=0;L<=40;L++) printf(\"hbo %d %d %zu\\n\",off,L,stbds_hash_bytes(blob+off,L,off*7+1));\n  printf(\"DONE2\\n\");\n  return 0;\n}\nEOF\ngcc -O1 -w -o t2c test2.c -L. -lref -Wl,-rpath,'$ORIGIN' && gcc -O1 -w -o t2r test2.c -Lrustlib -lref -Wl,-rpath,'$ORIGIN/rustlib' && ./t2c > o2c.txt 2>&1; echo \"c exit=$?\"; ./t2r > o2r.txt 2>&1; echo \"r exit=$?\"; wc -l o2c.txt o2r.txt; diff o2c.txt o2r.txt > d2.txt; echo \"diff=$(wc -l < d2.txt)\"; head -30 d2.txt; tail -2 o2c.txt"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":372,"cache_read_input_tokens":87947,"cache_creation":{"ephemeral_5m_input_tokens":372,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"8223d0a0-9e2b-49a0-adbd-0f955151381c","uuid":"8776bf53-b2a9-4fde-8563-d586ff0e02be","timestamp":"2026-08-20T04:56:34.550Z"}
