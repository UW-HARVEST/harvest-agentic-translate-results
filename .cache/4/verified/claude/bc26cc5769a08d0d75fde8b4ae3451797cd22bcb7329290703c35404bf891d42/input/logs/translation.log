tct=%zu seed=%zu scl2=%zu smode=%u sblock=%u srem=%zu\\n\",\n    tag, HDR(raw)->length, HDR(raw)->capacity, HDR(raw)->temp,\n    h->slot_count, h->used_count, h->uct, h->ucst, h->tc, h->tct, h->seed, h->scl2,\n    h->string.mode, h->string.block, h->string.remaining);\n  for (size_t i=0;i<h->slot_count>>3;i++){\n    HB *b=&h->storage[i];\n    for (int j=0;j<8;j++) printf(\"  b[%zu][%d] h=%zu i=%td\\n\", i, j, b->hash[j], b->index[j]);\n  }\n}\n\ntypedef struct { int key, value; } IM;\ntypedef struct { char *key; int value; } SM;\ntypedef struct { long long key[2]; int value; } BM;\n\nint main(void){\n  /* ---- 1: arrays ---- */\n  printf(\"== arrays ==\\n\");\n  int *arr = NULL;\n  for (int i=0;i<40;i++){\n    if (!arr || HDR(arr)->length+1 > HDR(arr)->capacity) arr = stbds_arrgrowf(arr, sizeof *arr, 1, 0);\n    arr[HDR(arr)->length++] = i*i;\n    printf(\"push %d len=%zu cap=%zu\\n\", i, HDR(arr)->length, HDR(arr)->capacity);\n  }\n  for (int i=0;i<40;i++) printf(\"a[%d]=%d\\n\", i, arr[i]);\n  stbds_arrfreef(arr);\n  arr = NULL;\n  arr = stbds_arrgrowf(arr, sizeof *arr, 0, 100);\n  printf(\"setcap len=%zu cap=%zu\\n\", HDR(arr)->length, HDR(arr)->capacity);\n  arr = stbds_arrgrowf(arr, sizeof *arr, 0, 50);\n  printf(\"setcap2 len=%zu cap=%zu\\n\", HDR(arr)->length, HDR(arr)->capacity);\n  arr = stbds_arrgrowf(arr, sizeof *arr, 300, 0);\n  printf(\"addn len=%zu cap=%zu\\n\", HDR(arr)->length, HDR(arr)->capacity);\n  stbds_arrfreef(arr);\n\n  /* ---- 2: hashes ---- */\n  printf(\"== hashes ==\\n\");\n  unsigned char buf[40];\n  for (int i=0;i<40;i++) buf[i] = (unsigned char)(i*37+3);\n  for (int L=0;L<=40;L++) printf(\"hb %d %zu\\n\", L, stbds_hash_bytes(buf,L,0x31415926u));\n  for (int L=0;L<=40;L++) printf(\"hb2 %d %zu\\n\", L, stbds_hash_bytes(buf,L,0));\n  char *strs[] = {\"\", \"a\", \"ab\", \"abc\", \"hello world\", \"\\xff\\xfe\\x80\", \"a very long string to hash 0123456789\", \"test_12345\"};\n  for (int i=0;i<8;i++) for (size_t sd=0; sd<3; sd++) printf(\"hs %d %zu %zu\\n\", i, sd, stbds_hash_string(strs[i], sd*0x9e3779b9u));\n\n  /* ---- 3: binary int map ---- */\n  printf(\"== int map ==\\n\");\n  stbds_rand_seed(0x31415926);\n  IM *m = NULL;\n  for (int i=0;i<60;i++){\n    int k = i*7%101;\n    m = stbds_hmput_key(m, sizeof *m, (void*)&k, sizeof m->key, 0);\n    m[TEMP((IM*)m-1)].key = k;\n    m[TEMP((IM*)m-1)].value = i;\n  }\n  dump_tbl(\"intmap\", (IM*)m-1);\n  for (int i=0;i<60;i++) printf(\"e[%d] k=%d v=%d\\n\", i, m[i].key, m[i].value);\n  for (int k=0;k<110;k++){\n    m = stbds_hmget_key(m, sizeof *m, (void*)&k, sizeof m->key, 0);\n    printf(\"get %d -> %td\\n\", k, TEMP((IM*)m-1));\n  }\n  for (int k=0;k<110;k+=3){\n    ptrdiff_t t;\n    m = stbds_hmget_key_ts(m, sizeof *m, (void*)&k, sizeof m->key, &t, 0);\n    printf(\"get_ts %d -> %td\\n\", k, t);\n  }\n  for (int k=0;k<110;k+=2){\n    m = stbds_hmdel_key(m, sizeof *m, (void*)&k, sizeof m->key, 0, 0);\n    printf(\"del %d -> %td len=%zu\\n\", k, m?TEMP((IM*)m-1):0, HDR((IM*)m-1)->length);\n  }\n  dump_tbl(\"intmap-after-del\", (IM*)m-1);\n  for (size_t i=0;i<HDR((IM*)m-1)->length;i++) printf(\"f[%zu] k=%d v=%d\\n\", i, m[i].key, m[i].value);\n  for (int k=0;k<110;k++){\n    m = stbds_hmget_key(m, sizeof *m, (void*)&k, sizeof m->key, 0);\n    printf(\"get2 %d -> %td\\n\", k, TEMP((IM*)m-1));\n  }\n  stbds_hmfree_func((IM*)m-1, sizeof *m);\n\n  /* ---- 4: big key map + defaults ---- */\n  printf(\"== big key map ==\\n\");\n  BM *bm = NULL;\n  bm = stbds_hmput_default(bm, sizeof *bm);\n  bm[-1].value = -999;\n  printf(\"bmdefault len=%zu v=%d\\n\", HDR((BM*)bm-1)->length, bm[-1].value);\n  for (int i=0;i<20;i++){\n    long long kk[2] = { i*1000003LL, ~(long long)i };\n    bm = stbds_hmput_key(bm, sizeof *bm, (void*)kk, sizeof bm->key, 0);\n    memcpy(bm[TEMP((BM*)bm-1)].key, kk, sizeof kk);\n    bm[TEMP((BM*)bm-1)].value = i*3;\n  }\n  dump_tbl(\"bigmap\", (BM*)bm-1);\n  bm = stbds_hmput_default(bm, sizeof *bm);\n  printf(\"bmdefault2 len=%zu v=%d\\n\", HDR((BM*)bm-1)->length, bm[-1].value);\n  for (int i=0;i<25;i++){\n    long long kk[2] = { i*1000003LL, ~(long long)i };\n    bm = stbds_hmget_key(bm, sizeof *bm, (void*)kk, sizeof bm->key, 0);\n    printf(\"bget %d -> %td\\n\", i, TEMP((BM*)bm-1));\n  }\n  stbds_hmfree_func((BM*)bm-1, sizeof *bm);\n\n  /* ---- 5: string maps, all 3 modes ---- */\n  for (int mode=1; mode<=3; mode++){\n    printf(\"== string map mode %d ==\\n\", mode);\n    stbds_rand_seed(0x31415926);\n    SM *sm;\n    if (mode==1) { sm = NULL; }\n    else sm = stbds_shmode_func(sizeof *sm, mode);\n    char keys[80][16];\n    for (int i=0;i<80;i++) sprintf(keys[i], \"key_%d_%d\", i, i*i);\n    for (int i=0;i<80;i++){\n      sm = stbds_hmput_key(sm, sizeof *sm, (void*)keys[i], sizeof sm->key, 1);\n      sm[TEMP((SM*)sm-1)].value = i*11;\n      sm[TEMP((SM*)sm-1)].key = TEMPKEY((SM*)sm-1);\n    }\n    dump_tbl(\"smap\", (SM*)sm-1);\n    for (size_t i=1;i<HDR((SM*)sm-1)->length;i++) printf(\"s[%zu] %s %d\\n\", i, sm[i].key, sm[i].value);\n    for (int i=0;i<90;i++){\n      char k[16]; sprintf(k, \"key_%d_%d\", i, i*i);\n      sm = stbds_hmget_key(sm, sizeof *sm, (void*)k, sizeof sm->key, 1);\n      printf(\"sget %d -> %td\\n\", i, TEMP((SM*)sm-1));\n    }\n    /* re-put existing keys */\n    for (int i=0;i<10;i++){\n      char k[16]; sprintf(k, \"key_%d_%d\", i, i*i);\n      sm = stbds_hmput_key(sm, sizeof *sm, (void*)k, sizeof sm->key, 1);\n      printf(\"reput %d -> %td key=%s\\n\", i, TEMP((SM*)sm-1), sm[TEMP((SM*)sm-1)].key);\n    }\n    for (int i=0;i<80;i+=3){\n      char k[16]; sprintf(k, \"key_%d_%d\", i, i*i);\n      sm = stbds_hmdel_key(sm, sizeof *sm, (void*)k, sizeof sm->key, 0, 1);\n      printf(\"sdel %d -> %td len=%zu\\n\", i, TEMP((SM*)sm-1), HDR((SM*)sm-1)->length);\n    }\n    dump_tbl(\"smap-after-del\", (SM*)sm-1);\n    for (size_t i=1;i<HDR((SM*)sm-1)->length;i++) printf(\"s2[%zu] %s %d\\n\", i, sm[i].key, sm[i].value);\n    for (int i=0;i<90;i++){\n      char k[16]; sprintf(k, \"key_%d_%d\", i, i*i);\n      sm = stbds_hmget_key(sm, sizeof *sm, (void*)k, sizeof sm->key, 1);\n      printf(\"sget2 %d -> %td\\n\", i, TEMP((SM*)sm-1));\n    }\n    stbds_hmfree_func((SM*)sm-1, sizeof *sm);\n  }\n\n  /* ---- 6: string arena ---- */\n  printf(\"== arena ==\\n\");\n  SA sa = {0};\n  char *ptrs[600];\n  for (int i=0;i<600;i++){\n    char t[64]; sprintf(t, \"arena_string_%d\", i);\n    ptrs[i] = stbds_stralloc(&sa, t);\n    printf(\"al %d %s rem=%zu block=%u\\n\", i, ptrs[i], sa.remaining, sa.block);\n  }\n  for (int i=0;i<600;i++) if (strncmp(ptrs[i],\"arena_string_\",13)) printf(\"CORRUPT %d\\n\", i);\n  stbds_strreset(&sa);\n  printf(\"reset rem=%zu block=%u storage=%d\\n\", sa.remaining, sa.block, sa.storage!=NULL);\n  /* huge strings forcing the len>blocksize path */\n  SA sa2 = {0};\n  static char big[4096];\n  for (int i=0;i<4095;i++) big[i]='x'+(i%3);\n  big[4095]=0;\n  for (int i=0;i<6;i++){\n    big[1000+i]=0;\n    char *q = stbds_stralloc(&sa2, big);\n    printf(\"big %d len=%zu rem=%zu block=%u ok=%d\\n\", i, strlen(q), sa2.remaining, sa2.block, strcmp(q,big)==0);\n    big[1000+i]='y';\n  }\n  stbds_strreset(&sa2);\n  printf(\"reset2 rem=%zu block=%u\\n\", sa2.remaining, sa2.block);\n\n  /* ---- 7: strkey / sh_puts ---- */\n  printf(\"== strkey ==\\n\");\n  for (int i=-5;i<5;i++) printf(\"sk %d %s\\n\", i, strkey(i));\n  printf(\"sk big %s\\n\", strkey(2147483647));\n  printf(\"== sh_puts ==\\n\");\n  int ns[] = {0,1,2,3,7,10,100,1000,5000};\n  for (int i=0;i<9;i++){ printf(\"shputs %d:\\n\", ns[i]); fflush(stdout); sh_puts(ns[i]); }\n\n  /* ---- 8: seed effects ---- */\n  printf(\"== seeds ==\\n\");\n  for (size_t sd = 0; sd < 5; sd++){\n    stbds_rand_seed(sd*0x9e3779b97f4a7c15ull + 1);\n    IM *q = NULL;\n    for (int i=0;i<30;i++){\n      int k=i;\n      q = stbds_hmput_key(q, sizeof *q, (void*)&k, sizeof q->key, 0);\n      q[TEMP((IM*)q-1)].key=k; q[TEMP((IM*)q-1)].value=i;\n    }\n    dump_tbl(\"seedmap\", (IM*)q-1);\n    stbds_hmfree_func((IM*)q-1, sizeof *q);\n  }\n\n  /* ---- 9: NULL / edge cases ---- */\n  printf(\"== edges ==\\n\");\n  printf(\"hmdel_key(NULL)=%d\\n\", stbds_hmdel_key(NULL,16,NULL,8,0,0)==NULL);\n  stbds_hmfree_func(NULL, 16);\n  ptrdiff_t tt=12345;\n  void *e = stbds_hmget_key_ts(NULL, sizeof(IM), NULL, 4, &tt, 0);\n  printf(\"get_ts NULL temp=%td len=%zu cap=%zu\\n\", tt, HDR((IM*)e-1)->length, HDR((IM*)e-1)->capacity);\n  int kz=1;\n  e = stbds_hmget_key_ts(e, sizeof(IM), &kz, 4, &tt, 0);\n  printf(\"get_ts notbl temp=%td\\n\", tt);\n  e = stbds_hmget_key(e, sizeof(IM), &kz, 4, 0);\n  printf(\"get notbl temp=%td\\n\", TEMP((IM*)e-1));\n  e = stbds_hmdel_key(e, sizeof(IM), &kz, 4, 0, 0);\n  printf(\"del notbl temp=%td\\n\", TEMP((IM*)e-1));\n  stbds_hmfree_func((IM*)e-1, sizeof(IM));\n  void *d2 = stbds_hmput_default(NULL, sizeof(IM));\n  printf(\"default NULL len=%zu cap=%zu\\n\", HDR((IM*)d2-1)->length, HDR((IM*)d2-1)->capacity);\n  stbds_hmfree_func((IM*)d2-1, sizeof(IM));\n  printf(\"DONE\\n\");\n  return 0;\n}\nEOF\ngcc -O1 -w -o test_c test.c -L. -lref -Wl,-rpath,'$ORIGIN' && ./test_c > out_c.txt 2>&1; echo \"exit=$?\"; wc -l out_c.txt; tail -3 out_c.txt"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":545,"cache_read_input_tokens":80470,"cache_creation":{"ephemeral_5m_input_tokens":545,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"8223d0a0-9e2b-49a0-adbd-0f955151381c","uuid":"f8754773-0c08-44f5-ae74-a66f1c882512","timestamp":"2026-08-20T04:55:55.633Z"}
