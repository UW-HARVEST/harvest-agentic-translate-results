    if(!cf||!rf){printf(\"dlsym failed\\n\"); return 1;}\n\n    int diffs = 0;\n    /* NULL pointer cases */\n    for (int op=-2; op<=5; op++) for (size_t L=0; L<=3; L++) {\n        int a = cf(NULL, L, op, 0);\n        int b = rf(NULL, L, op, 0);\n        if (a!=b) { printf(\"NULL MISMATCH op=%d len=%zu C=%d R=%d\\n\", op, L, a, b); diffs++; }\n    }\n\n    /* exhaustive single-byte parse_bool via op 0 (len 3, vary byte 0) */\n    for (int c=0;c<256;c++){\n        unsigned char buf[3]; buf[0]=(unsigned char)c; buf[1]='n'; buf[2]='n';\n        diffs += (cmp_case(buf,3,3,0,0,1)!=0);\n        buf[0]='y'; buf[1]=(unsigned char)c; buf[2]='y';\n        diffs += (cmp_case(buf,3,3,0,0,1)!=0);\n        unsigned char b3[1]; b3[0]=(unsigned char)c;\n        diffs += (cmp_case(b3,1,1,3,0,1)!=0);\n    }\n\n    /* exhaustive 3-char over alphabet for ops 0,1 with all params */\n    const unsigned char alpha[] = {'y','Y','n','N','a',0x00,0xff,0x80,' '};\n    int na = sizeof alpha;\n    for (int i=0;i<na;i++) for(int j=0;j<na;j++) for(int k=0;k<na;k++){\n        unsigned char buf[3]={alpha[i],alpha[j],alpha[k]};\n        for (int op=-1; op<=4; op++) for (int p=-1;p<=4;p++)\n            diffs += (cmp_case(buf,3,3,op,p,1)!=0);\n    }\n\n    /* exhaustive bit patterns for op 2 and op 3, lengths 1..14 (y/n only) */\n    for (int L=1; L<=14; L++) {\n        for (long m=0; m < (1L<<L); m++) {\n            unsigned char buf[16];\n            for (int i=0;i<L;i++) buf[i] = ((m>>i)&1) ? 'y' : 'n';\n            diffs += (cmp_case(buf,L,L,2,0,1)!=0);\n            diffs += (cmp_case(buf,L,L,3,0,1)!=0);\n            if (diffs > 20) { printf(\"bail\\n\"); return 1; }\n        }\n    }\n    printf(\"diffs=%d\\n\", diffs);\n    return 0;\n}\nEOF\ncd \"$TMPDIR\" && gcc -O1 -o harness harness.c -ldl && ./harness 2>&1 | tail -40"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":919,"cache_read_input_tokens":44157,"cache_creation":{"