           if cond2 {\n   206\t                    count += 1;\n   207\t                }\n   208\t                if cond3 {\n   209\t                    count += 1;\n   210\t                }\n   211\t                return 100 + count;\n   212\t            }\n   213\t            0\n   214\t        }\n   215\t\n   216\t        2 => {\n   217\t            /* XOR - odd number must be true */\n   218\t            let result = cond1 ^ cond2 ^ cond3;\n   219\t\n   220\t            if result {\n   221\t                /* Determine which combination */\n   222\t                if cond1 && !cond2 && !cond3 {\n   223\t                    return 1;\n   224\t                }\n   225\t                if !cond1 && cond2 && !cond3 {\n   226\t                    return 2;\n   227\t                }\n   228\t                if !cond1 && !cond2 && cond3 {\n   229\t                    return 3;\n   230\t                }\n   231\t                if cond1 && cond2 && cond3 {\n   232\t                    return 7;\n   233\t                }\n   234\t                return 90;\n   235\t            }\n   236\t            0\n   237\t        }\n   238\t\n   239\t        3 => {\n   240\t            /* NAND - not all true */\n   241\t            let result = !(cond1 && cond2 && cond3);\n   242\t\n   243\t            if result {\n   244\t                /* Various false combinations */\n   245\t                if !cond1 && !cond2 && !cond3 {\n   246\t                    return 200;\n   247\t                }\n   248\t                if !cond1 {\n   249\t                    return 150;\n   250\t                }\n   251\t                if !cond2 {\n   252\t                    return 151;\n   253\t                }\n   254\t                if !cond3 {\n   255\t                    return 152;\n   256\t                }\n   257\t                return 100;\n   258\t            }\n   259\t            0\n   260\t        }\n   261\t\n   262\t        _ => -1,\n   263\t    }\n   264\t}\n   265\t\n   266\t/// Configure system flags based on array of decisions\n   267\t/// Creates bitmask and applies various rules\n   268\tfn configure_flags(decisions: &[bool], count: usize) -> i32 {\n   269\t    let mut flags: u32 = 0;\n   270\t    let mut special_count: i32 = 0;\n   271\t\n   272\t    /* Build flag bitmask */\n   273\t    let mut i = 0usize;\n   274\t    while i < count && i < 32 {\n   275\t        if decisions[i] {\n   276\t            flags |= 1u32 << i;\n   277\t            special_count += 1;\n   278\t        }\n   279\t        i += 1;\n   280\t    }\n   281\t    /* `flags` is computed but never used by the C code either. */\n   282\t    let _ = flags;\n   283\t\n   284\t    /* Apply rules based on flag patterns */\n   285\t    if special_count == 0 {\n   286\t        /* All false */\n   287\t        return 0;\n   288\t    } else if special_count as usize == count {\n   289\t        /* All true */\n   290\t        return 1000 + count as i32;\n   291\t    } else if special_count == 1 {\n   292\t        /* Exactly one true - find which one */\n   293\t        for i in 0..count {\n   294\t            if decisions[i] {\n   295\t                return 100 + i as i32;\n   296\t            }\n   297\t        }\n   298\t    } else if special_count as usize == count.wrapping_sub(1) {\n   299\t        /* Exactly one false - find which one */\n   300\t        for i in 0..count {\n   301\t            if !decisions[i] {\n   302\t                return 200 + i as i32;\n   303\t            }\n   304\t        }\n   305\t    }\n   306\t\n   307\t    /* Check for alternating pattern */\n   308\t    let mut alternating = true;\n   309\t    for i in 1..count {\n   310\t        if decisions[i] == decisions[i - 1] {\n   311\t            alternating = false;\n   312\t            break;\n   313\t        }\n   314\t    }\n   315\t\n   316\t    if alternating {\n   317\t        return 500 + special_count;\n   318\t    }\n   319\t\n   320\t    /* Check for consecutive true values */\n   321\t    let mut max_consecutive: i32 = 0;\n   322\t    let mut current_consecutive: i32 = 0;\n   323\t    for i in 0..count {\n   324\t        if decisions[i] {\n   325\t            current_consecutive += 1;\n   326\t            if current_consecutive > max_consecutive {\n   327\t                max_consecutive = current_consecutive;\n   328\t            }\n   329\t        } else {\n   330\t            current_consecutive = 0;\n   331\t        }\n   332\t    }\n   333\t\n   334\t    if max_consecutive >= 3 {\n   335\t        return 300 + max_consecutive;\n   336\t    }\n   337\t\n   338\t    /* Return count of true values */\n   339\t    special_count\n   340\t}\n   341\t\n   342\t/// Validate sequence has proper pattern\n   343\t/// Checks various decision sequence rules\n   344\tfn validate_sequence(sequence: &[u8], len: usize) -> i32 {\n   345\t    if len == 0 {\n   346\t        return 0;\n   347\t    }\n   348\t\n   349\t    /* Convert all to bools.  The C code aliases the caller's char buffer and\n   350\t     * rewrites each byte in place, which is an in-place map of parse_bool over\n   351\t     * the sequence; the transformed buffer is never observed by the caller. */\n   352\t    let bools: Vec<bool> = (0..len).map(|i| parse_bool(sequence[i])).collect();\n   353\t\n   354\t    /* Rule 1: Must start with 'y' */\n   355\t    if !bools[0] {\n   356\t        return -10;\n   357\t    }\n   358\t\n   359\t    /* Rule 2: Must end with 'n' if length > 1 */\n   360\t    if len > 1 && bools[len - 1] {\n   361\t        return -11;\n   362\t    }\n   363\t\n   364\t    /* Rule 3: Cannot have more than 3 consecutive same values */\n   365\t    let mut consecutive: i32 = 1;\n   366\t    for i in 1..len {\n   367\t        if bools[i] == bools[i - 1] {\n   368\t            consecutive += 1;\n   369\t            if consecutive > 3 {\n   370\t                return -12;\n   371\t            }\n   372\t        } else {\n   373\t            consecutive = 1;\n   374\t        }\n   375\t    }\n   376\t\n   377\t    /* Rule 4: Count transitions */\n   378\t    let mut transitions: i32 = 0;\n   379\t    for i in 1..len {\n   380\t        if bools[i] != bools[i - 1] {\n   381\t            transitions += 1;\n   382\t        }\n   383\t    }\n   384\t\n   385\t    /* Validate based on length */\n   386\t    if len <= 3 {\n   387\t        /* Short sequences - simple rules */\n   388\t        if transitions == 0 {\n   389\t            return 1; /* All same (but passes other rules) */\n   390\t        }\n   391\t        if transitions as usize == len - 1 {\n   392\t            return 2; /* All different */\n   393\t        }\n   394\t        10 + transitions\n   395\t    } else if len <= 10 {\n   396\t        /* Medium sequences */\n   397\t        if (transitions as usize) < len / 3 {\n   398\t            return 20; /* Few transitions */\n   399\t        }\n   400\t        if transitions as usize > len / 2 {\n   401\t            return 30; /* Many transitions */\n   402\t        }\n   403\t        25\n   404\t    } else {\n   405\t        /* Long sequences */\n   406\t        if transitions < 3 {\n   407\t            return 40;\n   408\t        }\n   409\t        if transitions as usize > len - 3 {\n   410\t            return 50;\n   411\t        }\n   412\t        45\n   413\t    }\n   414\t}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
