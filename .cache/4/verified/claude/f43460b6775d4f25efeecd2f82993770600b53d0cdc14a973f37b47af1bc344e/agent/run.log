cond1 || cond2 || cond3;\n   198\t\n   199\t            if result {\n   200\t                /* Count how many are true */\n   201\t                let mut count: i32 = 0;\n   202\t                if cond1 {\n   203\t                    count += 1;\n   204\t                }\n   205\t                if cond2 {\n   206\t                    count += 1;\n   207\t                }\n   208\t                if cond3 {\n   209\t                    count += 1;\n   210\t                }\n   211\t                return 100 + count;\n   212\t            }\n   213\t            0\n   214\t        }\n   215\t\n   216\t        2 => {\n   217\t            /* XOR - odd number must be true */\n   218\t            let result = cond1 ^ cond2 ^ cond3;\n   219\t\n   220\t            if result {\n   221\t                /* Determine which combination */\n   222\t                if cond1 && !cond2 && !cond3 {\n   223\t                    return 1;\n   224\t                }\n   225\t                if !cond1 && cond2 && !cond3 {\n   226\t                    return 2;\n   227\t                }\n   228\t                if !cond1 && !cond2 && cond3 {\n   229\t                    return 3;\n   230\t                }\n   231\t                if cond1 && cond2 && cond3 {\n   232\t                    return 7;\n   233\t                }\n   234\t                return 90;\n   235\t            }\n   236\t            0\n   237\t        }\n   238\t\n   239\t        3 => {\n   240\t            /* NAND - not all true */\n   241\t            let result = !(cond1 && cond2 && cond3);\n   242\t\n   243\t            if result {\n   244\t                /* Various false combinations */\n   245\t                if !cond1 && !cond2 && !cond3 {\n   246\t                    return 200;\n   247\t                }\n   248\t                if !cond1 {\n   249\t                    return 150;\n   250\t                }\n   251\t                if !cond2 {\n   252\t                    return 151;\n   253\t        