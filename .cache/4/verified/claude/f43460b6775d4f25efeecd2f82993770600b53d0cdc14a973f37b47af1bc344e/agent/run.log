umber */\n   126\t    let buffer = match c_fgets(&mut reader, MAX_INPUT_SIZE) {\n   127\t        Some(b) => b,\n   128\t        None => {\n   129\t            eprint!(\"Error reading operation\\n\");\n   130\t            return ExitCode::from(1);\n   131\t        }\n   132\t    };\n   133\t    let operation = c_atoi(c_string(&buffer));\n   134\t\n   135\t    /* Read parameter */\n   136\t    let buffer = match c_fgets(&mut reader, MAX_INPUT_SIZE) {\n   137\t        Some(b) => b,\n   138\t        None => {\n   139\t            eprint!(\"Error reading parameter\\n\");\n   140\t            return ExitCode::from(1);\n   141\t        }\n   142\t    };\n   143\t    let param = c_atoi(c_string(&buffer));\n   144\t\n   145\t    /* Read decision string */\n   146\t    let buffer = match c_fgets(&mut reader, MAX_INPUT_SIZE) {\n   147\t        Some(b) => b,\n   148\t        None => {\n   149\t            eprint!(\"Error reading decision string\\n\");\n   150\t            return ExitCode::from(1);\n   151\t        }\n   152\t    };\n   153\t\n   154\t    let mut input: &[u8] = c_string(&buffer);\n   155\t\n   156\t    /* Remove trailing newline if present */\n   157\t    let mut len = input.len();\n   158\t    if len > 0 && input[len - 1] == b'\\n' {\n   159\t        len -= 1;\n   160\t        input = &input[..len];\n   161\t    }\n   162\t\n   163\t    /* Call the library function */\n   164\t    let result = decisions::process_decisions(input, len, operation, param);\n   165\t\n   166\t    /* Print result to stdout */\n   167\t    let stdout = io::stdout();\n   168\t    let mut out = stdout.lock();\n   169\t    let _ = write!(out, \"{}\\n\", result);\n   170\t    let _ = out.flush();\n   171\t\n   172\t    ExitCode::SUCCESS\n   173\t}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
