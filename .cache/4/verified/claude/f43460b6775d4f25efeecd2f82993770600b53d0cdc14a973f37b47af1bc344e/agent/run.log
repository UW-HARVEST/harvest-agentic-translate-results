t/// mirroring fgets returning NULL.\n    40\tfn c_fgets<R: Read>(reader: &mut R, size: usize) -> Option<Vec<u8>> {\n    41\t    let mut out: Vec<u8> = Vec::new();\n    42\t    let capacity = size - 1;\n    43\t    let mut byte = [0u8; 1];\n    44\t\n    45\t    while out.len() < capacity {\n    46\t        match reader.read(&mut byte) {\n    47\t            Ok(0) => break,\n    48\t            Ok(_) => {\n    49\t                out.push(byte[0]);\n    50\t                if byte[0] == b'\\n' {\n    51\t                    break;\n    52\t                }\n    53\t            }\n    54\t            Err(ref e) if e.kind() == io::ErrorKind::Interrupted => continue,\n    55\t            Err(_) => break,\n    56\t        }\n    57\t    }\n    58\t\n    59\t    if out.is_empty() {\n    60\t        /* Nothing read: EOF/error -> NULL */\n    61\t        None\n    62\t    } else {\n    63\t        Some(out)\n    64\t    }\n    65\t}\n    66\t\n    67\t/// Bytes of the NUL-terminated C string that `fgets` left in the buffer, i.e.\n    68\t/// everything up to (but not including) the first embedded NUL byte.\n    69\tfn c_string(bytes: &[u8]) -> &[u8] {\n    70\t    match bytes.iter().position(|&b| b == 0) {\n    71\t        Some(nul) => &bytes[..nul],\n    72\t        None => bytes,\n    73\t    }\n    74\t}\n    75\t\n    76\t/// Emulates glibc's `atoi`, which is `(int) strtol(nptr, NULL, 10)`:\n    77\t/// leading whitespace is skipped, an optional sign is honoured, digits are\n    78\t/// consumed until the first non-digit, out-of-range values saturate at\n    79\t/// LONG_MIN/LONG_MAX and the result is truncated to `int`.\n    80\tfn c_atoi(s: &[u8]) -> i32 {\n    81\t    let mut i = 0usize;\n    82\t\n    83\t    while i < s.len() && matches!(s[i], b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r') {\n    84\t        i += 1;\n    85\t    }\n    86\t\n    87\t    let mut negative = false;\n    88\t    if i < s.len() && (s[i] == b'+' || s[i] == b'-') {\n    89\t        negative = s[i] == b'-';\n    90\t        i += 1;\n    91\t    }\n    92\t\n    93\t    let mut acc: i64 = 0;\n    94\t    let mut overflow = false;\n    95\t    while i < s.len() && s[i].is_ascii_digit() {\n    96\t        let digit = i64::from(s[i] - b'0');\n    97\t        if !overflow {\n    98\t            match acc.checked_mul(10).and_then(|v| v.checked_add(digit)) {\n    99\t                Some(v) => acc = v,\n   100\t                None => overflow = true,\n   101\t            }\n   102\t        }\n   103\t        i += 1;\n   104\t    }\n   105\t\n   106\t    let value: i64 = if overflow {\n   107\t        if negative {\n   108\t            i64::MIN\n   109\t        } else {\n   110\t            i64::MAX\n   111\t        }\n   112\t    } else if negative {\n   113\t        -acc\n   114\t    } else {\n   115\t        acc\n   116\t    };\n   117\t\n   118\t    value as i32\n   119\t}\n   120\t\n   121\tfn main() -> ExitCode {\n   122\t    let stdin = io::stdin();\n   123\t    let mut reader = BufReader::new(stdin.lock());\n   124\t\n   125\t    /* Read operation number */\n   126\t    let buffer = match c_fgets(&mut reader, MAX_INPUT_SIZE) {\n   127\t        Some(b) => b,\n   128\t        None => {\n   129\t            eprint!(\"Error reading operation\\n\");\n   130\t            return ExitCode::from(1);\n   131\t        }\n   132\t    };\n   133\t    let operation = c_atoi(c_string(&buffer));\n   134\t\n   135\t    /* Read parameter */\n   136\t    let buffer = match c_fgets(&mut reader, MAX_INPUT_SIZE) {\n   137\t        Some(b) => b,\n   138\t        None => {\n   139\t            eprint!(\"Error reading parameter\\n\");\n   140\t            return ExitCode::from(1);\n   141\t        }\n   142\t    };\n   143\t    let param = c_atoi(c_string(&buffer));\n   144\t\n   145\t    /* Read decision string */\n   146\t    let buffer = match c_fgets(&mut reader, MAX_INPUT_SIZE) {\n   147\t        Some(b) => b,\n   148\t        None => {\n   149\t            eprint!(\