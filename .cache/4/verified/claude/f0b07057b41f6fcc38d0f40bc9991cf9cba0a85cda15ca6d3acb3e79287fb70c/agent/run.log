en(p,'w').write(s.replace(find, repl, 1))\nPY\n\n  out=$(timeout 600 cargo test --release 2>&1)\n  if printf '%s' \"$out\" | grep -q \"test result: FAILED\"; then\n    nfail=$(printf '%s' \"$out\" | grep -c \"^test .* FAILED\")\n    printf '  KILLED  %s (%s failing tests)\\n' \"$desc\" \"$nfail\"\n    killed=$((killed+1))\n  elif printf '%s' \"$out\" | grep -q \"error\\[\\|error:\"; then\n    printf '  SKIP    %s (did not compile)\\n' \"$desc\"\n    skipped=$((skipped+1))\n  else\n    printf '  SURVIVED %s\\n' \"$desc\"\n    survived=$((survived+1)); SURVIVORS+=(\"$desc\")\n  fi\ndone\n\nrestore\necho\necho \"==============================================\"\necho \" mutation score: $killed killed / $survived survived / $skipped skipped\"\necho \"==============================================\"\nif [ \"$survived\" -gt 0 ]; then\n  echo \"Surviving mutants (test-suite blind spots):\"\n  for s in \"${SURVIVORS[@]}\"; do echo \"  - $s\"; done\n  exit 1\nfi\necho \"All behavioural mutants detected.\"\n","structuredPatch":[],"originalFile":null,"userModified":false}}
