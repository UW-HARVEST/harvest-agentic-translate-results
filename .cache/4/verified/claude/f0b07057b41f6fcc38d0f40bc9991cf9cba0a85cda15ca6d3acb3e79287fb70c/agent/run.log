sult\" | head -20\n    fail=1\n  else\n    printf '%s' \"$out\" | grep -E \"test result\" \\\n      | awk -F'[ ;]' '{p+=$4; f+=$6} END {print \"  tests passed=\"p\" failed=\"f}'\n  fi\n  echo\ndone\n\necho \"==============================================================\"\nif [ \"$fail\" -eq 0 ]; then\n  echo \" ALL ${#COMBOS[@]} FEATURE COMBINATION(S) PASSED\"\nelse\n  echo \" FAILURES DETECTED\"\nfi\necho \"==============================================================\"\nexit \"$fail\"\n","structuredPatch":[],"originalFile":null,"userModified":false}}
