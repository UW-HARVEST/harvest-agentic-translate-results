{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_019xghdsMnS8QS5tfk6ZbPeP","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/` (cute_c2 style GJK routines).\n2\t//!\n3\t//! The translation is intentionally literal: every exported C function is\n4\t//! reproduced with the same name, signature, order of operations, order of\n5\t//! error/validation checks and (buggy) behaviour as the original C code.\n6\t\n7\t#![allow(non_snake_case)]\n8\t#![allow(non_camel_case_types)]\n9\t#![allow(non_upper_case_globals)]\n10\t\n11\tuse core::ffi::{c_char, c_int, c_void};\n12\t\n13\t// ---------------------------------------------------------------------------\n14\t// Public types (include/lib.h)\n15\t// ---------------------------------------------------------------------------\n16\t\n17\t#[repr(C)]\n18\t#[derive(Copy, Clone)]\n19\tpub struct c2v {\n20\t    pub x: f32,\n21\t    pub y: f32,\n22\t}\n23\t\n24\t// ---------------------------------------------------------------------------\n25\t// Private types (src/lib.c)\n26\t// ---------------------------------------------------------------------------\n27\t\n28\t// typedef enum { C2_TYPE_CIRCLE, C2_TYPE_AABB, C2_TYPE_CAPSULE } C2_TYPE;\n29\tpub const C2_TYPE_CIRCLE: c_int = 0;\n30\tpub const C2_TYPE_AABB: c_int = 1;\n31\tpub const C2_TYPE_CAPSULE: c_int = 2;\n32\t\n33\t#[repr(C)]\n34\t#[derive(Copy, Clone)]\n35\tpub struct c2r {\n36\t    pub c: f32,\n37\t    pub s: f32,\n38\t}\n39\t\n40\t#[repr(C)]\n41\t#[derive(Copy, Clone)]\n42\tpub struct c2x {\n43\t    pub p: c2v,\n44\t    pub r: c2r,\n45\t}\n46\t\n47\t#[repr(C)]\n48\t#[derive(Copy, Clone)]\n49\tpub struct c2Circle {\n50\t    pub p: c2v,\n51\t    pub r: f32,\n52\t}\n53\t\n54\t#[repr(C)]\n55\t#[derive(Copy, Clone)]\n56\tpub struct c2AABB {\n57\t    pub min: c2v,\n58\t    pub max: c2v,\n59\t}\n60\t\n61\t#[repr(C)]\n62\t#[derive(Copy, Clone)]\n63\tpub struct c2Capsule {\n64\t    pub a: c2v,\n65\t    pub b: c2v,\n66\t    pub r: f32,\n67\t}\n68\t\n69\t#[repr(C)]\n70\t#[derive(Copy, Clone)]\n71\tpub struct c2GJKCache {\n72\t    pub metric: f32,\n73\t    pub count: c_int,\n74\t    pub iA: [c_int; 3],\n75\t    pub iB: [c_int; 3],\n76\t    pub div: f32,\n77\t}\n78\t\n79\t#[repr(C)]\n80\t#[derive(Copy, Clone)]\n81\tpub struct c2Proxy {\n82\t    pub radius: f32,\n83\t    pub count: c_int,\n84\t    pub verts: [c2v; 8],\n85\t}\n86\t\n87\t#[repr(C)]\n88\t#[derive(Copy, Clone)]\n89\tpub struct c2sv {\n90\t    pub sA: c2v,\n91\t    pub sB: c2v,\n92\t    pub p: c2v,\n93\t    pub u: f32,\n94\t    pub iA: c_int,\n95\t    pub iB: c_int,\n96\t}\n97\t\n98\t/// Layout identical to the C `c2Simplex { c2sv a, b, c, d; float div; int count; }`.\n99\t/// The four vertices are stored as an array because the C code walks them via\n100\t/// `c2sv* verts = &s.a;`.\n101\t#[repr(C)]\n102\t#[derive(Copy, Clone)]\n103\tpub struct c2Simplex {\n104\t    pub verts: [c2sv; 4],\n105\t    pub div: f32,\n106\t    pub count: c_int,\n107\t}\n108\t\n109\tconst ZERO_V: c2v = c2v { x: 0.0, y: 0.0 };\n110\t\n111\tconst ZERO_SV: c2sv = c2sv {\n112\t    sA: ZERO_V,\n113\t    sB: ZERO_V,\n114\t    p: ZERO_V,\n115\t    u: 0.0,\n116\t    iA: 0,\n117\t    iB: 0,\n118\t};\n119\t\n120\t// FLT_MAX / FLT_EPSILON as spelled out in the C source.\n121\tconst C_FLT_MAX: f32 = 3.402_823_466_385_288_6e+38_f32;\n122\tconst C_FLT_EPSILON: f32 = 1.192_092_895_507_812_5e-7_f32;\n123\t\n124\t// ---------------------------------------------------------------------------\n125\t// Bit-exact scalar arithmetic helpers\n126\t//\n127\t// `ADDSS`/`MULSS` on x86 give NaN-propagation priority to their *destination*\n128\t// operand: if the destination is a NaN the result is that NaN (quieted),\n129\t// otherwise if the source is a NaN the result is the source NaN (quieted).\n130\t// Since `+` and `*` are commutative the compiler is free to choose which\n131\t// operand ends up in the destination register, and that choice decides which\n132\t// NaN payload survives.  To stay bit-identical with the C build we spell the\n133\t// destination operand out explicitly: `addp(dst, src)` / `mulp(dst, src)`\n134\t// reproduce `ADDSS dst, src` / `MULSS dst, src`.\n135\t//\n136\t// For non-NaN operands these helpers are exactly `dst + src` / `dst * src`\n137\t// (both operations are bit-exactly commutative on finite/infinite values), so\n138\t// ordinary arithmetic is completely unaffected.\n139\t//\n140\t// Subtraction and division are not commutative, so `SUBSS`/`DIVSS` always take\n141\t// the left-hand operand as destination — plain `-` and `/` already match.\n142\t// ---------------------------------------------------------------------------\n143\t\n144\t/// x86 NaN quieting: set the quiet bit, keep sign and payload.\n145\t#[inline(always)]\n146\tfn quiet(x: f32) -> f32 {\n147\t    f32::from_bits(x.to_bits() | 0x0040_0000)\n148\t}\n149\t\n150\t/// `ADDSS dst, src`\n151\t#[inline(always)]\n152\tfn addp(dst: f32, src: f32) -> f32 {\n153\t    if dst.is_nan() {\n154\t        quiet(dst)\n155\t    } else if src.is_nan() {\n156\t        quiet(src)\n157\t    } else {\n158\t        dst + src\n159\t    }\n160\t}\n161\t\n162\t/// `MULSS dst, src`\n163\t#[inline(always)]\n164\tfn mulp(dst: f32, src: f32) -> f32 {\n165\t    if dst.is_nan() {\n166\t        quiet(dst)\n167\t    } else if src.is_nan() {\n168\t        quiet(src)\n169\t    } else {\n170\t        dst * src\n171\t    }\n172\t}\n173\t\n174\t// ---------------------------------------------------------------------------\n175\t// Vector helpers\n176\t// ---------------------------------------------------------------------------\n177\t\n178\t#[unsafe(no_mangle)]\n179\tpub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n180\t    let mut a = c2v { x: 0.0, y: 0.0 };\n181\t    a.x = x;\n182\t    a.y = y;\n183\t    a\n184\t}\n185\t\n186\t#[unsafe(no_mangle)]\n187\tpub extern \"C\" fn c2Mulvs(a: c2v, b: f32) -> c2v {\n188\t    let mut a = a;\n189\t    a.x = mulp(a.x, b);\n190\t    a.y = mulp(a.y, b);\n191\t    a\n192\t}\n193\t\n194\t#[unsafe(no_mangle)]\n195\tpub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n196\t    c2V(\n197\t        if a.x > b.x { a.x } else { b.x },\n198\t        if a.y > b.y { a.y } else { b.y },\n199\t    )\n200\t}\n201\t\n202\t#[unsafe(no_mangle)]\n203\tpub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n204\t    c2V(\n205\t        if a.x < b.x { a.x } else { b.x },\n206\t        if a.y < b.y { a.y } else { b.y },\n207\t    )\n208\t}\n209\t\n210\t#[unsafe(no_mangle)]\n211\tpub extern \"C\" fn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n212\t    c2Maxv(lo, c2Minv(a, hi))\n213\t}\n214\t\n215\t#[unsafe(no_mangle)]\n216\tpub extern \"C\" fn c2Sub(a: c2v, b: c2v) -> c2v {\n217\t    let mut a = a;\n218\t    a.x -= b.x;\n219\t    a.y -= b.y;\n220\t    a\n221\t}\n222\t\n223\t#[unsafe(no_mangle)]\n224\tpub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n225\t    // a.x * b.x + a.y * b.y\n226\t    let t1 = mulp(a.x, b.x);\n227\t    let t2 = mulp(b.y, a.y);\n228\t    addp(t2, t1)\n229\t}\n230\t\n231\t#[unsafe(no_mangle)]\n232\tpub extern \"C\" fn c2RotIdentity() -> c2r {\n233\t    let mut r = c2r { c: 0.0, s: 0.0 };\n234\t    r.c = 1.0f32;\n235\t    r.s = 0.0;\n236\t    r\n237\t}\n238\t\n239\t#[unsafe(no_mangle)]\n240\tpub extern \"C\" fn c2xIdentity() -> c2x {\n241\t    let mut x = c2x {\n242\t        p: ZERO_V,\n243\t        r: c2r { c: 0.0, s: 0.0 },\n244\t    };\n245\t    x.p = c2V(0.0, 0.0);\n246\t    x.r = c2RotIdentity();\n247\t    x\n248\t}\n249\t\n250\t#[unsafe(no_mangle)]\n251\tpub unsafe extern \"C\" fn c2BBVerts(out: *mut c2v, bb: *mut c2AABB) {\n252\t    unsafe {\n253\t        *out.offset(0) = (*bb).min;\n254\t        *out.offset(1) = c2V((*bb).max.x, (*bb).min.y);\n255\t        *out.offset(2) = (*bb).max;\n256\t        *out.offset(3) = c2V((*bb).min.x, (*bb).max.y);\n257\t    }\n258\t}\n259\t\n260\t#[unsafe(no_mangle)]\n261\tpub unsafe extern \"C\" fn c2MakeProxy(shape: *const c_void, type_: c_int, p: *mut c2Proxy) {\n262\t    unsafe {\n263\t        match type_ {\n264\t            C2_TYPE_CIRCLE => {\n265\t                let c = shape as *mut c2Circle;\n266\t                (*p).radius = (*c).r;\n267\t                (*p).count = 1;\n268\t                (*p).verts[0] = (*c).p;\n269\t            }\n270\t            C2_TYPE_AABB => {\n271\t                let bb = shape as *mut c2AABB;\n272\t                (*p).radius = 0.0;\n273\t                (*p).count = 4;\n274\t                c2BBVerts((&raw mut (*p).verts) as *mut c2v, bb);\n275\t            }\n276\t            C2_TYPE_CAPSULE => {\n277\t                let c = shape as *mut c2Capsule;\n278\t                (*p).radius = (*c).r;\n279\t                (*p).count = 2;\n280\t                (*p).verts[0] = (*c).a;\n281\t                (*p).verts[1] = (*c).b;\n282\t            }\n283\t            _ => {}\n284\t        }\n285\t    }\n286\t}\n287\t\n288\t#[unsafe(no_mangle)]\n289\tpub extern \"C\" fn c2Len(a: c2v) -> f32 {\n290\t    c2Dot(a, a).sqrt()\n291\t}\n292\t\n293\t#[unsafe(no_mangle)]\n294\tpub extern \"C\" fn c2Det2(a: c2v, b: c2v) -> f32 {\n295\t    // a.x * b.y - a.y * b.x\n296\t    let t1 = mulp(b.y, a.x);\n297\t    let t2 = mulp(b.x, a.y);\n298\t    t1 - t2\n299\t}\n300\t\n301\t#[unsafe(no_mangle)]\n302\tpub unsafe extern \"C\" fn c2GJKSimplexMetric(s: *mut c2Simplex) -> f32 {\n303\t    unsafe {\n304\t        match (*s).count {\n305\t            2 => c2Len(c2Sub((*s).verts[1].p, (*s).verts[0].p)),\n306\t            3 => c2Det2(\n307\t                c2Sub((*s).verts[1].p, (*s).verts[0].p),\n308\t                c2Sub((*s).verts[2].p, (*s).verts[0].p),\n309\t            ),\n310\t            // `default:` falls through to `case 1:` in the C source.\n311\t            _ => 0.0,\n312\t        }\n313\t    }\n314\t}\n315\t\n316\t#[unsafe(no_mangle)]\n317\tpub extern \"C\" fn c2Mulrv(a: c2r, b: c2v) -> c2v {\n318\t    // c2V(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)\n319\t    let x = mulp(b.x, a.c) - mulp(b.y, a.s);\n320\t    let y = addp(mulp(a.s, b.x), mulp(b.y, a.c));\n321\t    c2V(x, y)\n322\t}\n323\t\n324\t#[unsafe(no_mangle)]\n325\tpub extern \"C\" fn c2Add(a: c2v, b: c2v) -> c2v {\n326\t    let mut a = a;\n327\t    a.x = addp(b.x, a.x);\n328\t    a.y = addp(b.y, a.y);\n329\t    a\n330\t}\n331\t\n332\t#[unsafe(no_mangle)]\n333\tpub extern \"C\" fn c2Mulxv(a: c2x, b: c2v) -> c2v {\n334\t    c2Add(c2Mulrv(a.r, b), a.p)\n335\t}\n336\t\n337\t#[unsafe(no_mangle)]\n338\tpub unsafe extern \"C\" fn c22(s: *mut c2Simplex) {\n339\t    unsafe {\n340\t        let a = (*s).verts[0].p;\n341\t        let b = (*s).verts[1].p;\n342\t        let u = c2Dot(b, c2Sub(b, a));\n343\t        let v = c2Dot(a, c2Sub(a, b));\n344\t        if v <= 0.0 {\n345\t            (*s).verts[0].u = 1.0f32;\n346\t            (*s).div = 1.0f32;\n347\t            (*s).count = 1;\n348\t        } else if u <= 0.0 {\n349\t            (*s).verts[0] = (*s).verts[1];\n350\t            (*s).verts[0].u = 1.0f32;\n351\t            (*s).div = 1.0f32;\n352\t            (*s).count = 1;\n353\t        } else {\n354\t            (*s).verts[0].u = u;\n355\t            (*s).verts[1].u = v;\n356\t            (*s).div = addp(u, v);\n357\t            (*s).count = 2;\n358\t        }\n359\t    }\n360\t}\n361\t\n362\t#[unsafe(no_mangle)]\n363\tpub unsafe extern \"C\" fn c23(s: *mut c2Simplex) {\n364\t    unsafe {\n365\t        let a = (*s).verts[0].p;\n366\t        let b = (*s).verts[1].p;\n367\t        let c = (*s).verts[2].p;\n368\t        let uAB = c2Dot(b, c2Sub(b, a));\n369\t        let vAB = c2Dot(a, c2Sub(a, b));\n370\t        let uBC = c2Dot(c, c2Sub(c, b));\n371\t        let vBC = c2Dot(b, c2Sub(b, c));\n372\t        let uCA = c2Dot(a, c2Sub(a, c));\n373\t        let vCA = c2Dot(c, c2Sub(c, a));\n374\t        let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n375\t        let uABC = mulp(c2Det2(b, c), area);\n376\t        let vABC = mulp(c2Det2(c, a), area);\n377\t        let wABC = mulp(c2Det2(a, b), area);\n378\t        if vAB <= 0.0 && uCA <= 0.0 {\n379\t            (*s).verts[0].u = 1.0f32;\n380\t            (*s).div = 1.0f32;\n381\t            (*s).count = 1;\n382\t        } else if uAB <= 0.0 && vBC <= 0.0 {\n383\t            (*s).verts[0] = (*s).verts[1];\n384\t            (*s).verts[0].u = 1.0f32;\n385\t            (*s).div = 1.0f32;\n386\t            (*s).count = 1;\n387\t        } else if uBC <= 0.0 && vCA <= 0.0 {\n388\t            (*s).verts[0] = (*s).verts[2];\n389\t            (*s).verts[0].u = 1.0f32;\n390\t            (*s).div = 1.0f32;\n391\t            (*s).count = 1;\n392\t        } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n393\t            (*s).verts[0].u = uAB;\n394\t            (*s).verts[1].u = vAB;\n395\t            (*s).div = addp(uAB, vAB);\n396\t            (*s).count = 2;\n397\t        } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n398\t            (*s).verts[0] = (*s).verts[1];\n399\t            (*s).verts[1] = (*s).verts[2];\n400\t            (*s).verts[0].u = uBC;\n401\t            (*s).verts[1].u = vBC;\n402\t            (*s).div = addp(uBC, vBC);\n403\t            (*s).count = 2;\n404\t        } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n405\t            (*s).verts[1] = (*s).verts[0];\n406\t            (*s).verts[0] = (*s).verts[2];\n407\t            (*s).verts[0].u = uCA;\n408\t            (*s).verts[1].u = vCA;\n409\t            (*s).div = addp(uCA, vCA);\n410\t            (*s).count = 2;\n411\t        } else {\n412\t            (*s).verts[0].u = uABC;\n413\t            (*s).verts[1].u = vABC;\n414\t            (*s).verts[2].u = wABC;\n415\t            (*s).div = addp(addp(uABC, vABC), wABC);\n416\t            (*s).count = 3;\n417\t        }\n418\t    }\n419\t}\n420\t\n421\t#[unsafe(no_mangle)]\n422\tpub extern \"C\" fn c2Neg(a: c2v) -> c2v {\n423\t    c2V(-a.x, -a.y)\n424\t}\n425\t\n426\t#[unsafe(no_mangle)]\n427\tpub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n428\t    let mut b = c2v { x: 0.0, y: 0.0 };\n429\t    b.x = -a.y;\n430\t    b.y = a.x;\n431\t    b\n432\t}\n433\t\n434\t#[unsafe(no_mangle)]\n435\tpub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n436\t    let mut b = c2v { x: 0.0, y: 0.0 };\n437\t    b.x = a.y;\n438\t    b.y = -a.x;\n439\t    b\n440\t}\n441\t\n442\t#[unsafe(no_mangle)]\n443\tpub unsafe extern \"C\" fn c2D(s: *mut c2Simplex) -> c2v {\n444\t    unsafe {\n445\t        match (*s).count {\n446\t            1 => c2Neg((*s).verts[0].p),\n447\t            2 => {\n448\t                let ab = c2Sub((*s).verts[1].p, (*s).verts[0].p);\n449\t                if c2Det2(ab, c2Neg((*s).verts[0].p)) > 0.0 {\n450\t                    return c2Skew(ab);\n451\t                }\n452\t                c2CCW90(ab)\n453\t            }\n454\t            _ => c2V(0.0, 0.0),\n455\t        }\n456\t    }\n457\t}\n458\t\n459\t#[unsafe(no_mangle)]\n460\tpub unsafe extern \"C\" fn c2Support(verts: *const c2v, count: c_int, d: c2v) -> c_int {\n461\t    unsafe {\n462\t        let mut imax: c_int = 0;\n463\t        let mut dmax = c2Dot(*verts.offset(0), d);\n464\t        let mut i: c_int = 1;\n465\t        while i < count {\n466\t            let dot = c2Dot(*verts.offset(i as isize), d);\n467\t            if dot > dmax {\n468\t                imax = i;\n469\t                dmax = dot;\n470\t            }\n471\t            i += 1;\n472\t        }\n473\t        imax\n474\t    }\n475\t}\n476\t\n477\t#[unsafe(no_mangle)]\n478\tpub unsafe extern \"C\" fn c2Witness(s: *mut c2Simplex, a: *mut c2v, b: *mut c2v) {\n479\t    unsafe {\n480\t        let den = 1.0f32 / (*s).div;\n481\t        match (*s).count {\n482\t            1 => {\n483\t                *a = (*s).verts[0].sA;\n484\t                *b = (*s).verts[0].sB;\n485\t            }\n486\t            2 => {\n487\t                *a = c2Add(\n488\t                    c2Mulvs((*s).verts[0].sA, mulp((*s).verts[0].u, den)),\n489\t                    c2Mulvs((*s).verts[1].sA, mulp((*s).verts[1].u, den)),\n490\t                );\n491\t                *b = c2Add(\n492\t                    c2Mulvs((*s).verts[0].sB, mulp((*s).verts[0].u, den)),\n493\t                    c2Mulvs((*s).verts[1].sB, mulp((*s).verts[1].u, den)),\n494\t                );\n495\t            }\n496\t            3 => {\n497\t                *a = c2Add(\n498\t                    c2Add(\n499\t                        c2Mulvs((*s).verts[0].sA, mulp((*s).verts[0].u, den)),\n500\t                        c2Mulvs((*s).verts[1].sA, mulp((*s).verts[1].u, den)),\n501\t                    ),\n502\t                    c2Mulvs((*s).verts[2].sA, mulp((*s).verts[2].u, den)),\n503\t                );\n504\t                *b = c2Add(\n505\t                    c2Add(\n506\t                        c2Mulvs((*s).verts[0].sB, mulp((*s).verts[0].u, den)),\n507\t                        c2Mulvs((*s).verts[1].sB, mulp((*s).verts[1].u, den)),\n508\t                    ),\n509\t                    c2Mulvs((*s).verts[2].sB, mulp((*s).verts[2].u, den)),\n510\t                );\n511\t            }\n512\t            _ => {\n513\t                *a = c2V(0.0, 0.0);\n514\t                *b = c2V(0.0, 0.0);\n515\t            }\n516\t        }\n517\t    }\n518\t}\n519\t\n520\t#[unsafe(no_mangle)]\n521\tpub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n522\t    c2Mulvs(a, 1.0f32 / b)\n523\t}\n524\t\n525\t#[unsafe(no_mangle)]\n526\tpub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n527\t    c2Div(a, c2Len(a))\n528\t}\n529\t\n530\t#[unsafe(no_mangle)]\n531\tpub unsafe extern \"C\" fn c2L(s: *mut c2Simplex) -> c2v {\n532\t    unsafe {\n533\t        let den = 1.0f32 / (*s).div;\n534\t        match (*s).count {\n535\t            1 => (*s).verts[0].p,\n536\t            2 => c2Add(\n537\t                c2Mulvs((*s).verts[0].p, mulp((*s).verts[0].u, den)),\n538\t                c2Mulvs((*s).verts[1].p, mulp((*s).verts[1].u, den)),\n539\t            ),\n540\t            _ => c2V(0.0, 0.0),\n541\t        }\n542\t    }\n543\t}\n544\t\n545\t#[unsafe(no_mangle)]\n546\tpub extern \"C\" fn c2MulrvT(a: c2r, b: c2v) -> c2v {\n547\t    // c2V(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y)\n548\t    let x = addp(mulp(a.c, b.x), mulp(b.y, a.s));\n549\t    let y = addp(mulp(-a.s, b.x), mulp(b.y, a.c));\n550\t    c2V(x, y)\n551\t}\n552\t\n553\t#[unsafe(no_mangle)]\n554\tpub unsafe extern \"C\" fn c2GJK(\n555\t    A: *const c_void,\n556\t    typeA: c_int,\n557\t    ax_ptr: *const c2x,\n558\t    B: *const c_void,\n559\t    typeB: c_int,\n560\t    bx_ptr: *const c2x,\n561\t    outA: *mut c2v,\n562\t    outB: *mut c2v,\n563\t    use_radius: c_int,\n564\t    iterations: *mut c_int,\n565\t    cache: *mut c2GJKCache,\n566\t) -> f32 {\n567\t    unsafe {\n568\t        let ax: c2x;\n569\t        let bx: c2x;\n570\t        if ax_ptr.is_null() {\n571\t            ax = c2xIdentity();\n572\t        } else {\n573\t            ax = *ax_ptr;\n574\t        }\n575\t        if bx_ptr.is_null() {\n576\t            bx = c2xIdentity();\n577\t        } else {\n578\t            bx = *bx_ptr;\n579\t        }\n580\t        let mut pA = c2Proxy {\n581\t            radius: 0.0,\n582\t            count: 0,\n583\t            verts: [ZERO_V; 8],\n584\t        };\n585\t        let mut pB = c2Proxy {\n586\t            radius: 0.0,\n587\t            count: 0,\n588\t            verts: [ZERO_V; 8],\n589\t        };\n590\t        c2MakeProxy(A, typeA, &raw mut pA);\n591\t        c2MakeProxy(B, typeB, &raw mut pB);\n592\t        let mut s = c2Simplex {\n593\t            verts: [ZERO_SV; 4],\n594\t            div: 0.0,\n595\t            count: 0,\n596\t        };\n597\t        // `c2sv* verts = &s.a;` — the simplex vertices walked as an array.\n598\t        // Re-derived from the local at every use so the pointer provenance\n599\t        // always covers the whole vertex array.\n600\t        macro_rules! verts {\n601\t            ($i:expr) => {\n602\t                ((&raw mut s.verts) as *mut c2sv).offset($i as isize)\n603\t            };\n604\t        }\n605\t        let mut cache_was_read = 0;\n606\t        if !cache.is_null() {\n607\t            let cache_was_good = ((*cache).count != 0) as c_int;\n608\t            if cache_was_good != 0 {\n609\t                let mut i: c_int = 0;\n610\t                while i < (*cache).count {\n611\t                    let iA = *((&raw const (*cache).iA) as *const c_int).offset(i as isize);\n612\t                    let iB = *((&raw const (*cache).iB) as *const c_int).offset(i as isize);\n613\t                    let sA = c2Mulxv(ax, *((&raw const pA.verts) as *const c2v).offset(iA as isize));\n614\t                    let sB = c2Mulxv(bx, *((&raw const pB.verts) as *const c2v).offset(iB as isize));\n615\t                    let v: *mut c2sv = verts!(i);\n616\t                    (*v).iA = iA;\n617\t                    (*v).sA = sA;\n618\t                    (*v).iB = iB;\n619\t                    (*v).sB = sB;\n620\t                    (*v).p = c2Sub((*v).sB, (*v).sA);\n621\t                    (*v).u = 0.0;\n622\t                    i += 1;\n623\t                }\n624\t                s.count = (*cache).count;\n625\t                s.div = (*cache).div;\n626\t                let metric_old = (*cache).metric;\n627\t                let metric = c2GJKSimplexMetric(&raw mut s);\n628\t                let min_metric = if metric < metric_old { metric } else { metric_old };\n629\t                let max_metric = if metric > metric_old { metric } else { metric_old };\n630\t                if !(min_metric < max_metric * 2.0f32 && metric < -1.0e8f32) {\n631\t                    cache_was_read = 1;\n632\t                }\n633\t            }\n634\t        }\n635\t        if cache_was_read == 0 {\n636\t            s.verts[0].iA = 0;\n637\t            s.verts[0].iB = 0;\n638\t            s.verts[0].sA = c2Mulxv(ax, pA.verts[0]);\n639\t            s.verts[0].sB = c2Mulxv(bx, pB.verts[0]);\n640\t            s.verts[0].p = c2Sub(s.verts[0].sB, s.verts[0].sA);\n641\t            s.verts[0].u = 1.0f32;\n642\t            s.div = 1.0f32;\n643\t            s.count = 1;\n644\t        }\n645\t        let mut saveA: [c_int; 3] = [0; 3];\n646\t        let mut saveB: [c_int; 3] = [0; 3];\n647\t        let mut save_count: c_int = 0;\n648\t        let mut d0: f32 = C_FLT_MAX;\n649\t        let mut d1: f32;\n650\t        let mut iter: c_int = 0;\n651\t        let mut hit: c_int = 0;\n652\t        while iter < 20 {\n653\t            save_count = s.count;\n654\t            let mut i: c_int = 0;\n655\t            while i < save_count {\n656\t                *((&raw mut saveA) as *mut c_int).offset(i as isize) = (*verts!(i)).iA;\n657\t                *((&raw mut saveB) as *mut c_int).offset(i as isize) = (*verts!(i)).iB;\n658\t                i += 1;\n659\t            }\n660\t            match s.count {\n661\t                1 => {}\n662\t                2 => c22(&raw mut s),\n663\t                3 => c23(&raw mut s),\n664\t                _ => {}\n665\t            }\n666\t            if s.count == 3 {\n667\t                hit = 1;\n668\t                break;\n669\t            }\n670\t            let p = c2L(&raw mut s);\n671\t            d1 = c2Dot(p, p);\n672\t            if d1 > d0 {\n673\t                break;\n674\t            }\n675\t            d0 = d1;\n676\t            let d = c2D(&raw mut s);\n677\t            if c2Dot(d, d) < C_FLT_EPSILON * C_FLT_EPSILON {\n678\t                break;\n679\t            }\n680\t            let iA = c2Support(\n681\t                (&raw const pA.verts) as *const c2v,\n682\t                pA.count,\n683\t                c2MulrvT(ax.r, c2Neg(d)),\n684\t            );\n685\t            let sA = c2Mulxv(ax, *((&raw const pA.verts) as *const c2v).offset(iA as isize));\n686\t            let iB = c2Support((&raw const pB.verts) as *const c2v, pB.count, c2MulrvT(bx.r, d));\n687\t            let sB = c2Mulxv(bx, *((&raw const pB.verts) as *const c2v).offset(iB as isize));\n688\t            let v: *mut c2sv = verts!(s.count);\n689\t            (*v).iA = iA;\n690\t            (*v).sA = sA;\n691\t            (*v).iB = iB;\n692\t            (*v).sB = sB;\n693\t            (*v).p = c2Sub((*v).sB, (*v).sA);\n694\t            let mut dup = 0;\n695\t            let mut i: c_int = 0;\n696\t            while i < save_count {\n697\t                if iA == *((&raw const saveA) as *const c_int).offset(i as isize)\n698\t                    && iB == *((&raw const saveB) as *const c_int).offset(i as isize)\n699\t                {\n700\t                    dup = 1;\n701\t                    break;\n702\t                }\n703\t                i += 1;\n704\t            }\n705\t            if dup != 0 {\n706\t                break;\n707\t            }\n708\t            s.count += 1;\n709\t            iter += 1;\n710\t        }\n711\t        let _ = save_count;\n712\t        let mut a = ZERO_V;\n713\t        let mut b = ZERO_V;\n714\t        c2Witness(&raw mut s, &raw mut a, &raw mut b);\n715\t        let mut dist = c2Len(c2Sub(a, b));\n716\t        if hit != 0 {\n717\t            a = b;\n718\t            dist = 0.0;\n719\t        } else if use_radius != 0 {\n720\t            let rA = pA.radius;\n721\t            let rB = pB.radius;\n722\t            if dist > addp(rA, rB) && dist > C_FLT_EPSILON {\n723\t                dist -= addp(rA, rB);\n724\t                let n = c2Norm(c2Sub(b, a));\n725\t                a = c2Add(a, c2Mulvs(n, rA));\n726\t                b = c2Sub(b, c2Mulvs(n, rB));\n727\t                if a.x == b.x && a.y == b.y {\n728\t                    dist = 0.0;\n729\t                }\n730\t            } else {\n731\t                let p = c2Mulvs(c2Add(a, b), 0.5f32);\n732\t                a = p;\n733\t                b = p;\n734\t                dist = 0.0;\n735\t            }\n736\t        }\n737\t        if !cache.is_null() {\n738\t            (*cache).metric = c2GJKSimplexMetric(&raw mut s);\n739\t            (*cache).count = s.count;\n740\t            let mut i: c_int = 0;\n741\t            while i < s.count {\n742\t                let v: *mut c2sv = verts!(i);\n743\t                *((&raw mut (*cache).iA) as *mut c_int).offset(i as isize) = (*v).iA;\n744\t                *((&raw mut (*cache).iB) as *mut c_int).offset(i as isize) = (*v).iB;\n745\t                i += 1;\n746\t            }\n747\t            (*cache).div = s.div;\n748\t        }\n749\t        if !outA.is_null() {\n750\t            *outA = a;\n751\t        }\n752\t        if !outB.is_null() {\n753\t            *outB = b;\n754\t        }\n755\t        if !iterations.is_null() {\n756\t            *iterations = iter;\n757\t        }\n758\t        dist\n759\t    }\n760\t}\n761\t\n762\t// ---------------------------------------------------------------------------\n763\t// Public entry point (include/lib.h)\n764\t// ---------------------------------------------------------------------------\n765\t\n766\t#[unsafe(no_mangle)]\n767\tpub unsafe extern \"C\" fn gjk(\n768\t    reverse: c_char,\n769\t    a: *mut c2v,\n770\t    b: *mut c2v,\n771\t    a1: f32,\n772\t    a2: f32,\n773\t    a3: f32,\n774\t    a4: f32,\n775\t    b1: f32,\n776\t    b2: f32,\n777\t    b3: f32,\n778\t    b4: f32,\n779\t    b5: f32,\n780\t) {\n781\t    unsafe {\n782\t        let mut bb = c2AABB {\n783\t            min: ZERO_V,\n784\t            max: ZERO_V,\n785\t        };\n786\t        bb.min = c2V(a1, a2);\n787\t        bb.max = c2V(a3, a4);\n788\t\n789\t        let mut cap = c2Capsule {\n790\t            a: ZERO_V,\n791\t            b: ZERO_V,\n792\t            r: 0.0,\n793\t        };\n794\t        cap.a = c2V(b1, b2);\n795\t        cap.b = c2V(b3, b4);\n796\t        cap.r = b5;\n797\t\n798\t        if reverse != 0 {\n799\t            c2GJK(\n800\t                &mut cap as *mut c2Capsule as *const c_void,\n801\t                C2_TYPE_CAPSULE,\n802\t                core::ptr::null(),\n803\t                &mut bb as *mut c2AABB as *const c_void,\n804\t                C2_TYPE_AABB,\n805\t                core::ptr::null(),\n806\t                a,\n807\t                b,\n808\t                1,\n809\t                core::ptr::null_mut(),\n810\t                core::ptr::null_mut(),\n811\t            );\n812\t        } else {\n813\t            c2GJK(\n814\t                &mut bb as *mut c2AABB as *const c_void,\n815\t                C2_TYPE_AABB,\n816\t                core::ptr::null(),\n817\t                &mut cap as *mut c2Capsule as *const c_void,\n818\t                C2_TYPE_CAPSULE,\n819\t                core::ptr::null(),\n820\t                a,\n821\t                b,\n822\t                1,\n823\t                core::ptr::null_mut(),\n824\t                core::ptr::null_mut(),\n825\t            );\n826\t        }\n827\t    }\n828\t}\n829\t"}]},"parent_tool_use_id":null,"session_id":"3528ea46-9e11-41df-9325-94400ae6b1c3","uuid":"3deb58ab-3c6a-41f8-a64f-2a92502ccbbb","timestamp":"2026-08-20T09:07:08.969Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-vF5o8N/translated_rust/src/lib.rs","content":"//! Rust translation of the C library in `c_src/` (cute_c2 style GJK routines).\n//!\n//! The translation is intentionally literal: every exported C function is\n//! reproduced with the same name, signature, order of operations, order of\n//! error/validation checks and (buggy) behaviour as the original C code.\n\n#![allow(non_snake_case)]\n#![allow(non_camel_case_types)]\n#![allow(non_upper_case_globals)]\n\nuse core::ffi::{c_char, c_int, c_void};\n\n// ---------------------------------------------------------------------------\n// Public types (include/lib.h)\n// ---------------------------------------------------------------------------\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2v {\n    pub x: f32,\n    pub y: f32,\n}\n\n// ---------------------------------------------------------------------------\n// Private types (src/lib.c)\n// ---------------------------------------------------------------------------\n\n// typedef enum { C2_TYPE_CIRCLE, C2_TYPE_AABB, C2_TYPE_CAPSULE } C2_TYPE;\npub const C2_TYPE_CIRCLE: c_int = 0;\npub const C2_TYPE_AABB: c_int = 1;\npub const C2_TYPE_CAPSULE: c_int = 2;\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2r {\n    pub c: f32,\n    pub s: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2x {\n    pub p: c2v,\n    pub r: c2r,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2Circle {\n    pub p: c2v,\n    pub r: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2AABB {\n    pub min: c2v,\n    pub max: c2v,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2Capsule {\n    pub a: c2v,\n    pub b: c2v,\n    pub r: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2GJKCache {\n    pub metric: f32,\n    pub count: c_int,\n    pub iA: [c_int; 3],\n    pub iB: [c_int; 3],\n    pub div: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2Proxy {\n    pub radius: f32,\n    pub count: c_int,\n    pub verts: [c2v; 8],\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2sv {\n    pub sA: c2v,\n    pub sB: c2v,\n    pub p: c2v,\n    pub u: f32,\n    pub iA: c_int,\n    pub iB: c_int,\n}\n\n/// Layout identical to the C `c2Simplex { c2sv a, b, c, d; float div; int count; }`.\n/// The four vertices are stored as an array because the C code walks them via\n/// `c2sv* verts = &s.a;`.\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2Simplex {\n    pub verts: [c2sv; 4],\n    pub div: f32,\n    pub count: c_int,\n}\n\nconst ZERO_V: c2v = c2v { x: 0.0, y: 0.0 };\n\nconst ZERO_SV: c2sv = c2sv {\n    sA: ZERO_V,\n    sB: ZERO_V,\n    p: ZERO_V,\n    u: 0.0,\n    iA: 0,\n    iB: 0,\n};\n\n// FLT_MAX / FLT_EPSILON as spelled out in the C source.\nconst C_FLT_MAX: f32 = 3.402_823_466_385_288_6e+38_f32;\nconst C_FLT_EPSILON: f32 = 1.192_092_895_507_812_5e-7_f32;\n\n// ---------------------------------------------------------------------------\n// Bit-exact scalar arithmetic helpers\n//\n// `ADDSS`/`MULSS` on x86 give NaN-propagation priority to their *destination*\n// operand: if the destination is a NaN the result is that NaN (quieted),\n// otherwise if the source is a NaN the result is the source NaN (quieted).\n// Since `+` and `*` are commutative the compiler is free to choose which\n// operand ends up in the destination register, and that choice decides which\n// NaN payload survives.  To stay bit-identical with the C build we spell the\n// destination operand out explicitly: `addp(dst, src)` / `mulp(dst, src)`\n// reproduce `ADDSS dst, src` / `MULSS dst, src`.\n//\n// For non-NaN operands these helpers are exactly `dst + src` / `dst * src`\n// (both operations are bit-exactly commutative on finite/infinite values), so\n// ordinary arithmetic is completely unaffected.\n//\n// Subtraction and division are not commutative, so `SUBSS`/`DIVSS` always take\n// the left-hand operand as destination — plain `-` and `/` already match.\n// ---------------------------------------------------------------------------\n\n/// x86 NaN quieting: set the quiet bit, keep sign and payload.\n#[inline(always)]\nfn quiet(x: f32) -> f32 {\n    f32::from_bits(x.to_bits() | 0x0040_0000)\n}\n\n/// `ADDSS dst, src`\n#[inline(always)]\nfn addp(dst: f32, src: f32) -> f32 {\n    if dst.is_nan() {\n        quiet(dst)\n    } else if src.is_nan() {\n        quiet(src)\n    } else {\n        dst + src\n    }\n}\n\n/// `MULSS dst, src`\n#[inline(always)]\nfn mulp(dst: f32, src: f32) -> f32 {\n    if dst.is_nan() {\n        quiet(dst)\n    } else if src.is_nan() {\n        quiet(src)\n    } else {\n        dst * src\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Vector helpers\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n    let mut a = c2v { x: 0.0, y: 0.0 };\n    a.x = x;\n    a.y = y;\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulvs(a: c2v, b: f32) -> c2v {\n    let mut a = a;\n    a.x = mulp(a.x, b);\n    a.y = mulp(a.y, b);\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n    c2V(\n        if a.x > b.x { a.x } else { b.x },\n        if a.y > b.y { a.y } else { b.y },\n    )\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n    c2V(\n        if a.x < b.x { a.x } else { b.x },\n        if a.y < b.y { a.y } else { b.y },\n    )\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n    c2Maxv(lo, c2Minv(a, hi))\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Sub(a: c2v, b: c2v) -> c2v {\n    let mut a = a;\n    a.x -= b.x;\n    a.y -= b.y;\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n    // a.x * b.x + a.y * b.y\n    let t1 = mulp(a.x, b.x);\n    let t2 = mulp(b.y, a.y);\n    addp(t2, t1)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2RotIdentity() -> c2r {\n    let mut r = c2r { c: 0.0, s: 0.0 };\n    r.c = 1.0f32;\n    r.s = 0.0;\n    r\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2xIdentity() -> c2x {\n    let mut x = c2x {\n        p: ZERO_V,\n        r: c2r { c: 0.0, s: 0.0 },\n    };\n    x.p = c2V(0.0, 0.0);\n    x.r = c2RotIdentity();\n    x\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2BBVerts(out: *mut c2v, bb: *mut c2AABB) {\n    unsafe {\n        *out.offset(0) = (*bb).min;\n        *out.offset(1) = c2V((*bb).max.x, (*bb).min.y);\n        *out.offset(2) = (*bb).max;\n        *out.offset(3) = c2V((*bb).min.x, (*bb).max.y);\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2MakeProxy(shape: *const c_void, type_: c_int, p: *mut c2Proxy) {\n    unsafe {\n        match type_ {\n            C2_TYPE_CIRCLE => {\n                let c = shape as *mut c2Circle;\n                (*p).radius = (*c).r;\n                (*p).count = 1;\n                (*p).verts[0] = (*c).p;\n            }\n            C2_TYPE_AABB => {\n                let bb = shape as *mut c2AABB;\n                (*p).radius = 0.0;\n                (*p).count = 4;\n                c2BBVerts((&raw mut (*p).verts) as *mut c2v, bb);\n            }\n            C2_TYPE_CAPSULE => {\n                let c = shape as *mut c2Capsule;\n                (*p).radius = (*c).r;\n                (*p).count = 2;\n                (*p).verts[0] = (*c).a;\n                (*p).verts[1] = (*c).b;\n            }\n            _ => {}\n        }\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Len(a: c2v) -> f32 {\n    c2Dot(a, a).sqrt()\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Det2(a: c2v, b: c2v) -> f32 {\n    // a.x * b.y - a.y * b.x\n    let t1 = mulp(b.y, a.x);\n    let t2 = mulp(b.x, a.y);\n    t1 - t2\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2GJKSimplexMetric(s: *mut c2Simplex) -> f32 {\n    unsafe {\n        match (*s).count {\n            2 => c2Len(c2Sub((*s).verts[1].p, (*s).verts[0].p)),\n            3 => c2Det2(\n                c2Sub((*s).verts[1].p, (*s).verts[0].p),\n                c2Sub((*s).verts[2].p, (*s).verts[0].p),\n            ),\n            // `default:` falls through to `case 1:` in the C source.\n            _ => 0.0,\n        }\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulrv(a: c2r, b: c2v) -> c2v {\n    // c2V(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)\n    let x = mulp(b.x, a.c) - mulp(b.y, a.s);\n    let y = addp(mulp(a.s, b.x), mulp(b.y, a.c));\n    c2V(x, y)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Add(a: c2v, b: c2v) -> c2v {\n    let mut a = a;\n    a.x = addp(b.x, a.x);\n    a.y = addp(b.y, a.y);\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulxv(a: c2x, b: c2v) -> c2v {\n    c2Add(c2Mulrv(a.r, b), a.p)\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c22(s: *mut c2Simplex) {\n    unsafe {\n        let a = (*s).verts[0].p;\n        let b = (*s).verts[1].p;\n        let u = c2Dot(b, c2Sub(b, a));\n        let v = c2Dot(a, c2Sub(a, b));\n        if v <= 0.0 {\n            (*s).verts[0].u = 1.0f32;\n            (*s).div = 1.0f32;\n            (*s).count = 1;\n        } else if u <= 0.0 {\n            (*s).verts[0] = (*s).verts[1];\n            (*s).verts[0].u = 1.0f32;\n            (*s).div = 1.0f32;\n            (*s).count = 1;\n        } else {\n            (*s).verts[0].u = u;\n            (*s).verts[1].u = v;\n            (*s).div = addp(u, v);\n            (*s).count = 2;\n        }\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c23(s: *mut c2Simplex) {\n    unsafe {\n        let a = (*s).verts[0].p;\n        let b = (*s).verts[1].p;\n        let c = (*s).verts[2].p;\n        let uAB = c2Dot(b, c2Sub(b, a));\n        let vAB = c2Dot(a, c2Sub(a, b));\n        let uBC = c2Dot(c, c2Sub(c, b));\n        let vBC = c2Dot(b, c2Sub(b, c));\n        let uCA = c2Dot(a, c2Sub(a, c));\n        let vCA = c2Dot(c, c2Sub(c, a));\n        let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n        let uABC = mulp(c2Det2(b, c), area);\n        let vABC = mulp(c2Det2(c, a), area);\n        let wABC = mulp(c2Det2(a, b), area);\n        if vAB <= 0.0 && uCA <= 0.0 {\n            (*s).verts[0].u = 1.0f32;\n            (*s).div = 1.0f32;\n            (*s).count = 1;\n        } else if uAB <= 0.0 && vBC <= 0.0 {\n            (*s).verts[0] = (*s).verts[1];\n            (*s).verts[0].u = 1.0f32;\n            (*s).div = 1.0f32;\n            (*s).count = 1;\n        } else if uBC <= 0.0 && vCA <= 0.0 {\n            (*s).verts[0] = (*s).verts[2];\n            (*s).verts[0].u = 1.0f32;\n            (*s).div = 1.0f32;\n            (*s).count = 1;\n        } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n            (*s).verts[0].u = uAB;\n            (*s).verts[1].u = vAB;\n            (*s).div = addp(uAB, vAB);\n            (*s).count = 2;\n        } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n            (*s).verts[0] = (*s).verts[1];\n            (*s).verts[1] = (*s).verts[2];\n            (*s).verts[0].u = uBC;\n            (*s).verts[1].u = vBC;\n            (*s).div = addp(uBC, vBC);\n            (*s).count = 2;\n        } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n            (*s).verts[1] = (*s).verts[0];\n            (*s).verts[0] = (*s).verts[2];\n            (*s).verts[0].u = uCA;\n            (*s).verts[1].u = vCA;\n            (*s).div = addp(uCA, vCA);\n            (*s).count = 2;\n        } else {\n            (*s).verts[0].u = uABC;\n            (*s).verts[1].u = vABC;\n            (*s).verts[2].u = wABC;\n            (*s).div = addp(addp(uABC, vABC), wABC);\n            (*s).count = 3;\n        }\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Neg(a: c2v) -> c2v {\n    c2V(-a.x, -a.y)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n    let mut b = c2v { x: 0.0, y: 0.0 };\n    b.x = -a.y;\n    b.y = a.x;\n    b\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n    let mut b = c2v { x: 0.0, y: 0.0 };\n    b.x = a.y;\n    b.y = -a.x;\n    b\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2D(s: *mut c2Simplex) -> c2v {\n    unsafe {\n        match (*s).count {\n            1 => c2Neg((*s).verts[0].p),\n            2 => {\n                let ab = c2Sub((*s).verts[1].p, (*s).verts[0].p);\n                if c2Det2(ab, c2Neg((*s).verts[0].p)) > 0.0 {\n                    return c2Skew(ab);\n                }\n                c2CCW90(ab)\n            }\n            _ => c2V(0.0, 0.0),\n        }\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2Support(verts: *const c2v, count: c_int, d: c2v) -> c_int {\n    unsafe {\n        let mut imax: c_int = 0;\n        let mut dmax = c2Dot(*verts.offset(0), d);\n        let mut i: c_int = 1;\n        while i < count {\n            let dot = c2Dot(*verts.offset(i as isize), d);\n            if dot > dmax {\n                imax = i;\n                dmax = dot;\n            }\n            i += 1;\n        }\n        imax\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2Witness(s: *mut c2Simplex, a: *mut c2v, b: *mut c2v) {\n    unsafe {\n        let den = 1.0f32 / (*s).div;\n        match (*s).count {\n            1 => {\n                *a = (*s).verts[0].sA;\n                *b = (*s).verts[0].sB;\n            }\n            2 => {\n                *a = c2Add(\n                    c2Mulvs((*s).verts[0].sA, mulp((*s).verts[0].u, den)),\n                    c2Mulvs((*s).verts[1].sA, mulp((*s).verts[1].u, den)),\n                );\n                *b = c2Add(\n                    c2Mulvs((*s).verts[0].sB, mulp((*s).verts[0].u, den)),\n                    c2Mulvs((*s).verts[1].sB, mulp((*s).verts[1].u, den)),\n                );\n            }\n            3 => {\n                *a = c2Add(\n                    c2Add(\n                        c2Mulvs((*s).verts[0].sA, mulp((*s).verts[0].u, den)),\n                        c2Mulvs((*s).verts[1].sA, mulp((*s).verts[1].u, den)),\n                    ),\n                    c2Mulvs((*s).verts[2].sA, mulp((*s).verts[2].u, den)),\n                );\n                *b = c2Add(\n                    c2Add(\n                        c2Mulvs((*s).verts[0].sB, mulp((*s).verts[0].u, den)),\n                        c2Mulvs((*s).verts[1].sB, mulp((*s).verts[1].u, den)),\n                    ),\n                    c2Mulvs((*s).verts[2].sB, mulp((*s).verts[2].u, den)),\n                );\n            }\n            _ => {\n                *a = c2V(0.0, 0.0);\n                *b = c2V(0.0, 0.0);\n            }\n        }\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n    c2Mulvs(a, 1.0f32 / b)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n    c2Div(a, c2Len(a))\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2L(s: *mut c2Simplex) -> c2v {\n    unsafe {\n        let den = 1.0f32 / (*s).div;\n        match (*s).count {\n            1 => (*s).verts[0].p,\n            2 => c2Add(\n                c2Mulvs((*s).verts[0].p, mulp((*s).verts[0].u, den)),\n                c2Mulvs((*s).verts[1].p, mulp((*s).verts[1].u, den)),\n            ),\n            _ => c2V(0.0, 0.0),\n        }\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2MulrvT(a: c2r, b: c2v) -> c2v {\n    // c2V(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y)\n    let x = addp(mulp(a.c, b.x), mulp(b.y, a.s));\n    let y = addp(mulp(-a.s, b.x), mulp(b.y, a.c));\n    c2V(x, y)\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2GJK(\n    A: *const c_void,\n    typeA: c_int,\n    ax_ptr: *const c2x,\n    B: *const c_void,\n    typeB: c_int,\n    bx_ptr: *const c2x,\n    outA: *mut c2v,\n    outB: *mut c2v,\n    use_radius: c_int,\n    iterations: *mut c_int,\n    cache: *mut c2GJKCache,\n) -> f32 {\n    unsafe {\n        let ax: c2x;\n        let bx: c2x;\n        if ax_ptr.is_null() {\n            ax = c2xIdentity();\n        } else {\n            ax = *ax_ptr;\n        }\n        if bx_ptr.is_null() {\n            bx = c2xIdentity();\n        } else {\n            bx = *bx_ptr;\n        }\n        let mut pA = c2Proxy {\n            radius: 0.0,\n            count: 0,\n            verts: [ZERO_V; 8],\n        };\n        let mut pB = c2Proxy {\n            radius: 0.0,\n            count: 0,\n            verts: [ZERO_V; 8],\n        };\n        c2MakeProxy(A, typeA, &raw mut pA);\n        c2MakeProxy(B, typeB, &raw mut pB);\n        let mut s = c2Simplex {\n            verts: [ZERO_SV; 4],\n            div: 0.0,\n            count: 0,\n        };\n        // `c2sv* verts = &s.a;` — the simplex vertices walked as an array.\n        // Re-derived from the local at every use so the pointer provenance\n        // always covers the whole vertex array.\n        macro_rules! verts {\n            ($i:expr) => {\n                ((&raw mut s.verts) as *mut c2sv).offset($i as isize)\n            };\n        }\n        let mut cache_was_read = 0;\n        if !cache.is_null() {\n            let cache_was_good = ((*cache).count != 0) as c_int;\n            if cache_was_good != 0 {\n                let mut i: c_int = 0;\n                while i < (*cache).count {\n                    let iA = *((&raw const (*cache).iA) as *const c_int).offset(i as isize);\n                    let iB = *((&raw const (*cache).iB) as *const c_int).offset(i as isize);\n                    let sA = c2Mulxv(ax, *((&raw const pA.verts) as *const c2v).offset(iA as isize));\n                    let sB = c2Mulxv(bx, *((&raw const pB.verts) as *const c2v).offset(iB as isize));\n                    let v: *mut c2sv = verts!(i);\n                    (*v).iA = iA;\n                    (*v).sA = sA;\n                    (*v).iB = iB;\n                    (*v).sB = sB;\n                    (*v).p = c2Sub((*v).sB, (*v).sA);\n                    (*v).u = 0.0;\n                    i += 1;\n                }\n                s.count = (*cache).count;\n                s.div = (*cache).div;\n                let metric_old = (*cache).metric;\n                let metric = c2GJKSimplexMetric(&raw mut s);\n                let min_metric = if metric < metric_old { metric } else { metric_old };\n                let max_metric = if metric > metric_old { metric } else { metric_old };\n                if !(min_metric < max_metric * 2.0f32 && metric < -1.0e8f32) {\n                    cache_was_read = 1;\n                }\n            }\n        }\n        if cache_was_read == 0 {\n            s.verts[0].iA = 0;\n            s.verts[0].iB = 0;\n            s.verts[0].sA = c2Mulxv(ax, pA.verts[0]);\n            s.verts[0].sB = c2Mulxv(bx, pB.verts[0]);\n            s.verts[0].p = c2Sub(s.verts[0].sB, s.verts[0].sA);\n            s.verts[0].u = 1.0f32;\n            s.div = 1.0f32;\n            s.count = 1;\n        }\n        let mut saveA: [c_int; 3] = [0; 3];\n        let mut saveB: [c_int; 3] = [0; 3];\n        let mut save_count: c_int = 0;\n        let mut d0: f32 = C_FLT_MAX;\n        let mut d1: f32;\n        let mut iter: c_int = 0;\n        let mut hit: c_int = 0;\n        while iter < 20 {\n            save_count = s.count;\n            let mut i: c_int = 0;\n            while i < save_count {\n                *((&raw mut saveA) as *mut c_int).offset(i as isize) = (*verts!(i)).iA;\n                *((&raw mut saveB) as *mut c_int).offset(i as isize) = (*verts!(i)).iB;\n                i += 1;\n            }\n            match s.count {\n                1 => {}\n                2 => c22(&raw mut s),\n                3 => c23(&raw mut s),\n                _ => {}\n            }\n            if s.count == 3 {\n                hit = 1;\n                break;\n            }\n            let p = c2L(&raw mut s);\n            d1 = c2Dot(p, p);\n            if d1 > d0 {\n                break;\n            }\n            d0 = d1;\n            let d = c2D(&raw mut s);\n            if c2Dot(d, d) < C_FLT_EPSILON * C_FLT_EPSILON {\n                break;\n            }\n            let iA = c2Support(\n                (&raw const pA.verts) as *const c2v,\n                pA.count,\n                c2MulrvT(ax.r, c2Neg(d)),\n            );\n            let sA = c2Mulxv(ax, *((&raw const pA.verts) as *const c2v).offset(iA as isize));\n            let iB = c2Support((&raw const pB.verts) as *const c2v, pB.count, c2MulrvT(bx.r, d));\n            let sB = c2Mulxv(bx, *((&raw const pB.verts) as *const c2v).offset(iB as isize));\n            let v: *mut c2sv = verts!(s.count);\n            (*v).iA = iA;\n            (*v).sA = sA;\n            (*v).iB = iB;\n            (*v).sB = sB;\n            (*v).p = c2Sub((*v).sB, (*v).sA);\n            let mut dup = 0;\n            let mut i: c_int = 0;\n            while i < save_count {\n                if iA == *((&raw const saveA) as *const c_int).offset(i as isize)\n                    && iB == *((&raw const saveB) as *const c_int).offset(i as isize)\n                {\n                    dup = 1;\n                    break;\n                }\n                i += 1;\n            }\n            if dup != 0 {\n                break;\n            }\n            s.count += 1;\n            iter += 1;\n        }\n        let _ = save_count;\n        let mut a = ZERO_V;\n        let mut b = ZERO_V;\n        c2Witness(&raw mut s, &raw mut a, &raw mut b);\n        let mut dist = c2Len(c2Sub(a, b));\n        if hit != 0 {\n            a = b;\n            dist = 0.0;\n        } else if use_radius != 0 {\n            let rA = pA.radius;\n            let rB = pB.radius;\n            if dist > addp(rA, rB) && dist > C_FLT_EPSILON {\n                dist -= addp(rA, rB);\n                let n = c2Norm(c2Sub(b, a));\n                a = c2Add(a, c2Mulvs(n, rA));\n                b = c2Sub(b, c2Mulvs(n, rB));\n                if a.x == b.x && a.y == b.y {\n                    dist = 0.0;\n                }\n            } else {\n                let p = c2Mulvs(c2Add(a, b), 0.5f32);\n                a = p;\n                b = p;\n                dist = 0.0;\n            }\n        }\n        if !cache.is_null() {\n            (*cache).metric = c2GJKSimplexMetric(&raw mut s);\n            (*cache).count = s.count;\n            let mut i: c_int = 0;\n            while i < s.count {\n                let v: *mut c2sv = verts!(i);\n                *((&raw mut (*cache).iA) as *mut c_int).offset(i as isize) = (*v).iA;\n                *((&raw mut (*cache).iB) as *mut c_int).offset(i as isize) = (*v).iB;\n                i += 1;\n            }\n            (*cache).div = s.div;\n        }\n        if !outA.is_null() {\n            *outA = a;\n        }\n        if !outB.is_null() {\n            *outB = b;\n        }\n        if !iterations.is_null() {\n            *iterations = iter;\n        }\n        dist\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Public entry point (include/lib.h)\n// ---------------------------------------------------------------------------\n\n#[unsa