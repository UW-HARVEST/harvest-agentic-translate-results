38\t// behaving identically to the plain C loads/stores in single-threaded use.\n39\t// ---------------------------------------------------------------------------\n40\tstatic GLOBAL_COUNTER: AtomicI32 = AtomicI32::new(0);\n41\tstatic GLOBAL_ACCUMULATOR: AtomicI32 = AtomicI32::new(0);\n42\t\n43\t#[inline]\n44\tfn global_counter_get() -> c_int {\n45\t    GLOBAL_COUNTER.load(Ordering::Relaxed)\n46\t}\n47\t\n48\t#[inline]\n49\tfn global_counter_set(v: c_int) {\n50\t    GLOBAL_COUNTER.store(v, Ordering::Relaxed);\n51\t}\n52\t\n53\t#[inline]\n54\tfn global_accumulator_get() -> c_int {\n55\t    GLOBAL_ACCUMULATOR.load(Ordering::Relaxed)\n56\t}\n57\t\n58\t#[inline]\n59\tfn global_accumulator_set(v: c_int) {\n60\t    GLOBAL_ACCUMULATOR.store(v, Ordering::Relaxed);\n61\t}\n62\t\n63\t// typedef int (*operation_func)(int, int, int);\n64\tpub type OperationFunc = extern \"C\" fn(c_int, c_int, c_int) -> c_int;\n65\t\n66\t// typedef void (*modifier_func)(int, int);\n67\tpub type ModifierFunc = extern \"C\" fn(c_int, c_int);\n68\t\n69\t// ---------------------------------------------------------------------------\n70\t// void increment_counter(int value, int unused_param)\n71\t// ---------------------------------------------------------------------------\n72\t#[unsafe(no_mangle)]\n73\tpub extern \"C\" fn increment_counter(value: c_int, _unused_param: c_int) {\n74\t    // global_counter += value;\n75\t    global_counter_set(global_counter_get().wrapping_add(value));\n76\t}\n77\t\n78\t// ---------------------------------------------------------------------------\n79\t// void update_accumulator(int value, int unused_param)\n80\t// ---------------------------------------------------------------------------\n81\t#[unsafe(no_mangle)]\n82\tpub extern \"C\" fn update_accumulator(value: c_int, _unused_param: c_int) {\n83\t    // global_accumulator = global_accumulator * 2 + value;\n84\t    global_accumulator_set(\n85\t        global_accumulator_get()\n86\t            .wrapping_mul(2)\n87\t            .wrapping_add(value),\n88\t    );\n89\t}\n90\t\n91\t// ---------------------------------------------------------------------------\n92\t// int apply_operation(operation_func op, int a, int b, int c)\n93\t// ---------------------------------------------------------------------------\n94\t#[unsafe(no_mangle)]\n95\tpub extern \"C\" fn apply_operation(op: OperationFunc, a: c_int, b: c_int, c: c_int) -> c_int {\n96\t    op(a, b, c)\n97\t}\n98\t\n99\t// ---------------------------------------------------------------------------\n100\t// int add_three(int a, int b, int c)\n101\t// ---------------------------------------------------------------------------\n102\t#[unsafe(no_mangle)]\n103\tpub extern \"C\" fn add_three(a: c_int, b: c_int, c: c_int) -> c_int {\n104\t    a.wrapping_add(b).wrapping_add(c)\n105\t}\n106\t\n107\t// ---------------------------------------------------------------------------\n108\t// int multiply_add(int a, int b, int c)\n109\t// ---------------------------------------------------------------------------\n110\t#[unsafe(no_mangle)]\n111\tpub extern \"C\" fn multiply_add(a: c_int, b: c_int, c: c_int) -> c_int {\n112\t    a.wrapping_mul(b).wrapping_add(c)\n113\t}\n114\t\n115\t// ---------------------------------------------------------------------------\n116\t// int complex_calc(int a, int b, int c)\n117\t// ---------------------------------------------------------------------------\n118\t#[unsafe(no_mangle)]\n119\tpub extern \"C\" fn complex_calc(a: c_int, b: c_int, c: c_int) -> c_int {\n120\t    // return (a - b) * c + global_counter;\n121\t    a.wrapping_sub(b)\n122\t        .wrapping_mul(c)\n123\t        .wrapping_add(global_counter_get())\n124\t}\n125\t\n126\t// ---------------------------------------------------------------------------\n127\t// typedef struct {\n128\t//     int id;\n129\t//     int value;\n130\t//     time_t timestamp;\n131\t//     char name[32];\n132\t// } DataRecord;\n133\t//\n134\t// x86-64 Linux layout: size 48, a