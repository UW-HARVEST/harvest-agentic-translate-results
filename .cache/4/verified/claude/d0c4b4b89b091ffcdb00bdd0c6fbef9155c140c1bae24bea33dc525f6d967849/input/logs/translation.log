rr(buf,&a,&b);\n            /* run again to test repeated mutation */\n            ck(buf, C.process_with_foreach(&a,co), R.process_with_foreach(&b,ro));\n            ckarr(buf,&a,&b);\n        }\n    }\n    /* cross-library op pointer: C driver op through both */\n    for(int cnt=0;cnt<=10;cnt++){\n        ResultArray a,b; memset(&a,0,sizeof a); memset(&b,0,sizeof b);\n        C.init_result_array(&a,vals,cnt); R.init_result_array(&b,vals,cnt);\n        ck(\"pwf_crossop\", C.process_with_foreach(&a, R.add_operation),\n                          R.process_with_foreach(&b, C.add_operation));\n        ckarr(\"pwf_crossop\",&a,&b);\n    }\n\n    /* 10: compute_weighted_sum (incl. negative count) */\n    for(int cnt=-2; cnt<=10; cnt++){\n        ResultArray a,b; memset(&a,0,sizeof a); memset(&b,0,sizeof b);\n        if(cnt>=0){ C.init_result_array(&a,vals,cnt); R.init_result_array(&b,vals,cnt); }\n        else { a.count=cnt; b.count=cnt; }\n        char buf[96]; snprintf(buf,sizeof buf,\"compute_weighted_sum(cnt=%d)\",cnt);\n        ck(buf, C.compute_weighted_sum(&a), R.compute_weighted_sum(&b));\n        ckarr(buf,&a,&b);\n    }\n    /* weighted sum with huge values */\n    { int ev[10]={2147483647,-2147483648,2147483647,-2147483648,2147483647,\n                  -2147483648,2147483647,-2147483648,2147483647,-2147483648};\n      ResultArray a,b; memset(&a,0,sizeof a); memset(&b,0,sizeof b);\n      C.init_result_array(&a,ev,10); R.init_result_array(&b,ev,10);\n      ck(\"cws_extreme\", C.compute_weighted_sum(&a), R.compute_weighted_sum(&b));\n    }\n\n    /* 11: arrayfunc - the public API */\n    for(int i=0;i<NI;i++) for(int j=0;j<NI;j++){\n        int a=ints[i], b=ints[j];\n        char buf[128]; snprintf(buf,sizeof buf,\"arrayfunc(%d,%d,%d,%d)\",a,b,b,a);\n        ck(buf, C.arrayfunc(a,b,b,a), R.arrayfunc(a,b,b,a));\n        snprintf(buf,sizeof buf,\"arrayfunc(%d,%d,%d,%d)\",a,a,b,b);\n        ck(buf, C.arrayfunc(a,a,b,b), R.arrayfunc(a,a,b,b));\n        snprintf(buf,s