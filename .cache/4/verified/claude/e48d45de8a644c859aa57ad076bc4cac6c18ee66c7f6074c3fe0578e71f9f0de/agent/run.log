{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01V8np3m474YTKLTTES4JuRM","type":"tool_result","content":"40\t///\n41\t/// The state is accessed through the raw pointer with unaligned loads/stores\n42\t/// rather than through a `&mut cn_rnd_t`. The C code performs plain `uint64_t`\n43\t/// loads and stores with no alignment check, so a caller that passes a\n44\t/// misaligned `cn_rnd_t *` gets a normal (unaligned) access. Forming a Rust\n45\t/// reference would instead trip the `misaligned pointer dereference` check and\n46\t/// abort the process, which the C never does — so the reference is avoided.\n47\t#[inline]\n48\tunsafe fn cn_rnd_next(rnd: *mut cn_rnd_t) -> u64 {\n49\t    let state = rnd as *mut u64;\n50\t    let s0 = state;\n51\t    let s1 = unsafe { state.add(1) };\n52\t\n53\t    let mut x = unsafe { s0.read_unaligned() };\n54\t    let y = unsafe { s1.read_unaligned() };\n55\t    unsafe { s0.write_unaligned(y) };\n56\t    x ^= x << 23;\n57\t    x ^= x >> 17;\n58\t    x ^= y ^ (y >> 26);\n59\t    unsafe { s1.write_unaligned(x) };\n60\t    x.wrapping_add(y)\n61\t}\n62\t\n63\t/// `double next_double(cn_rnd_t *rnd);`\n64\t///\n65\t/// Reproduces the C body verbatim, including the type-punning read of the\n66\t/// assembled bit pattern as an IEEE-754 double:\n67\t///\n68\t/// ```c\n69\t/// uint64_t value = cn_rnd_next(rnd);\n70\t/// uint64_t exponent = 1023;\n71\t/// uint64_t mantissa = value >> 12;\n72\t/// uint64_t result = (exponent << 52) | mantissa;\n73\t/// return *(double *)&result - 1.0;\n74\t/// ```\n75\t#[unsafe(no_mangle)]\n76\tpub unsafe extern \"C\" fn next_double(rnd: *mut cn_rnd_t) -> c_double {\n77\t    // The C code dereferences `rnd` unconditionally with no NULL check and with\n78\t    // no alignment requirement enforced; we preserve that behaviour rather than\n79\t    // \"fixing\" it. A NULL pointer therefore faults exactly as the C does.\n80\t    let value: u64 = unsafe { cn_rnd_next(rnd) };\n81\t    let exponent: u64 = 1023;\n82\t    let mantissa: u64 = value >> 12;\n83\t    let result: u64 = (exponent << 52) | mantissa;\n84\t    f64::from_bits(result) - 1.0"}]},"parent_tool_use_id":null,"session_id":"841c8d4b-39bd-463c-9376-616c5d19a057","uuid":"ea08116f-a1b3-4b31-a130-07c4431acb5e","timestamp":"2026-08-19T14:03:07.995Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-rMYm54/translated_rust/src/lib.rs","content":"///\n/// The state is accessed through the raw pointer with unaligned loads/stores\n/// rather than through a `&mut cn_rnd_t`. The C code performs plain `uint64_t`\n/// loads and stores with no alignment check, so a caller that passes a\n/// misaligned `cn_rnd_t *` gets a normal (unaligned) access. Forming a Rust\n/// reference would instead trip the `misaligned pointer dereference` check and\n/// abort the process, which the C never does — so the reference is avoided.\n#[inline]\nunsafe fn cn_rnd_next(rnd: *mut cn_rnd_t) -> u64 {\n    let state = rnd as *mut u64;\n    let s0 = state;\n    let s1 = unsafe { state.add(1) };\n\n    let mut x = unsafe { s0.read_unaligned() };\n    let y = unsafe { s1.read_unaligned() };\n    unsafe { s0.write_unaligned(y) };\n    x ^= x << 23;\n    x ^= x >> 17;\n    x ^= y ^ (y >> 26);\n    unsafe { s1.write_unaligned(x) };\n    x.wrapping_add(y)\n}\n\n/// `double next_double(cn_rnd_t *rnd);`\n///\n/// Reproduces the C body verbatim, including the type-punning read of the\n/// assembled bit pattern as an IEEE-754 double:\n///\n/// ```c\n/// uint64_t value = cn_rnd_next(rnd);\n/// uint64_t exponent = 1023;\n/// uint64_t mantissa = value >> 12;\n/// uint64_t result = (exponent << 52) | mantissa;\n/// return *(double *)&result - 1.0;\n/// ```\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn next_double(rnd: *mut cn_rnd_t) -> c_double {\n    // The C code dereferences `rnd` unconditionally with no NULL check and with\n    // no alignment requirement enforced; we preserve that behaviour rather than\n    // \"fixing\" it. A NULL pointer therefore faults exactly as the C does.\n    let value: u64 = unsafe { cn_rnd_next(rnd) };\n    let exponent: u64 = 1023;\n    let mantissa: u64 = value >> 12;\n    let result: u64 = (exponent << 52) | mantissa;\n    f64::from_bits(result) - 1.0","numLines":45,"startLine":40,"totalLines":86}}}
