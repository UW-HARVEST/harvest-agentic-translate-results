/// ```\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn next_double(rnd: *mut cn_rnd_t) -> c_double {\n    // The C code dereferences `rnd` unconditionally with no NULL check; we\n    // preserve that behaviour rather than \"fixing\" it.\n    let rnd = unsafe { &mut *rnd };\n\n    let value: u64 = cn_rnd_next(rnd);\n    let exponent: u64 = 1023;\n    let mantissa: u64 = value >> 12;\n    let result: u64 = (exponent << 52) | mantissa;\n    f64::from_bits(result) - 1.0\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":480,"cache_read_input_tokens":15637,"cache_creation":{"ephemeral_5m_input_tokens":480,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"81ac51a9-2a84-4488-bf3c-4f8d6c3b5dc4","uuid":"35a71c6b-a6cd-44bd-96a9-ef1994e88f05","timestamp":"2026-08-19T10:24:50.572Z"}
