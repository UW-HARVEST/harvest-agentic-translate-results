check_group_expect_signal(\n            rep,\n            name,\n            &[InflateCase::new(vec![1, 2, 3, 4, 5, 6, 7, 8]).in_bytes(n).out(64, 256).encode()],\n            sig,\n        );\n    }\"\"\"\nassert old in s\ns=s.replace(old,new)\nopen(p,'w').write(s)\nprint('ok')\nPY\ntimeout 300 cargo build --tests 2>&1 | grep -E \"^error\" | head","description":"Allow identical-signal expectation"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1116,"cache_read_input_tokens":172257,"cache_creation":{"ephemeral_5m_input_tokens":1116,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"a438d629-c807-4b9d-ac71-026d3fe26fa4","uuid":"541fe09d-313d-4d11-b507-633650b051af","timestamp":"2026-08-20T18:32:35.008Z"}
