*both* libraries.\nfn check_group(rep: &mut Report, name: &str, cases: &[Case]) {\n    rep.groups += 1;\n    let cl = c_lib_path();\n    let rl = rust_lib_path();\n    let mut start = 0usize;\n    let mut guard = 0usize;\n    while start < cases.len() {\n        guard += 1;\n        if guard > cases.len() + 8 {\n            rep.failures.push(format!(\"{name}: resume loop did not terminate\"));\n            return;\n        }\n        let spec = encode_spec(&cases[start..]);\n        let c = run_child(&cl, &spec, \"c\");\n        let r = run_child(&rl, &spec, \"rust\");\n\n        let crecs = split_records(&c.raw);\n        let rrecs = split_records(&r.raw);\n        let common = crecs.len().min(rrecs.len());\n        let mut first_bad: Option<usize> = None;\n        for k in 0..common {\n            if crecs[k].1 != rrecs[k].1 {\n                first_bad = Some(k);\n                break;\n            }\n        }\n        if let Some(k) = first_bad {\n            rep.failures.push(format!(\n                \"{name}: case {} output differs\\n    C   ({} bytes) {}\\n    RUST({} bytes) {}\",\n                start + k,\n                crecs[k].1.len(),\n                hexdump(&crecs[k].1),\n                rrecs[k].1.len(),\n                hexdump(&rrecs[k].1),\n            ));\n            return;\n        }\n        if crecs.len() != rrecs.len() || c.status != r.status {\n            rep.failures.push(format!(\n                \"{name}: divergent termination at case {}: C completed {} ({}) vs RUST completed {} ({})\",\n                start + common,\n                crecs.len(),\n                c.status,\n                rrecs.len(),\n                r.status\n            ));\n            return;\n        }\n        rep.cases += crecs.len();\n        if c.status == \"exit 0\" {\n            if crecs.len() != cases.len() - start {\n                rep.failures.push(format!(\n                    \"{name}: child exited 0 after only {}/{} cases\",\n               