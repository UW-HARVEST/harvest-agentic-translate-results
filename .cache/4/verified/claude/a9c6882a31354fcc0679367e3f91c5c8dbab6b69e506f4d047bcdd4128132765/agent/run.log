err }\n}\"\"\"\nassert old in s; s=s.replace(old,new)\n\n# expect_signal gains an assertion-text check\nold = \"\"\"fn check_group_expect_signal(rep: &mut Report, name: &str, cases: &[Case], sig: i32) {\"\"\"\nnew = \"\"\"fn check_group_expect_signal(rep: &mut Report, name: &str, cases: &[Case], sig: i32) {\n    check_group_expect_signal_msg(rep, name, cases, sig, None)\n}\n\n/// `assert_text`: a substring that must appear in the C child's stderr, proving\n/// that the *intended* `assert()` (and not some other one) fired.\nfn check_group_expect_signal_msg(\n    rep: &mut Report,\n    name: &str,\n    cases: &[Case],\n    sig: i32,\n    assert_text: Option<&str>,\n) {\"\"\"\nassert old in s; s=s.replace(old,new)\n\nold = \"\"\"    rep.cases += crecs.len() + 1;\n    rep.aborts += 1;\n    println!(\"  ok {name}: both died with {want} after {} identical records\", crecs.len());\n}\"\"\"\nnew = \"\"\"    if let Some(t) = assert_text {\n        if !c.stderr.contains(t) {\n            rep.failures.push(format!(\n                \"{name}: C stderr does not mention {t:?}; got {:?}\",\n                c.stderr.trim()\n            ));\n            return;\n        }\n    }\n    rep.cases += crecs.len() + 1;\n    rep.aborts += 1;\n    println!(\n        \"  ok {name}: both died with {want} after {} identical records{}\",\n        crecs.len(),\n        match assert_text {\n            Some(t) => format!(\"  [C assert: {t}]\"),\n            None => String::new(),\n        }\n    );\n}\"\"\"\nassert old in s; s=s.replace(old,new)\nopen(p,'w').write(s)\nprint('ok')\nPY\ntimeout 300 cargo build --tests 2>&1 | grep -E \"^error\" -A6 | head -20","description":"Capture child stderr to verify which assert fires"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":965,"cache_read_input_tokens":177616,"cache_creation":{"ephemeral_5m_input_tokens":965,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard