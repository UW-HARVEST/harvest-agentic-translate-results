&spec, \"probe\");\n        let key = if c.status == \"exit 0\" {\n            let recs = split_records(&c.raw);\n            let (ret, reason) = decode_inflate(&recs[0].1);\n            format!(\n                \"ret {ret} / {}\",\n                reason.map(|v| String::from_utf8_lossy(&v).to_string()).unwrap_or(\"-\".into())\n            )\n        } else {\n            let line = c.stderr.trim().rsplit('/').next().unwrap_or(\"\").to_string();\n            format!(\"{} :: {line}\", c.status)\n        };\n        let e = tally.entry(key).or_insert((0, String::new()));\n        e.0 += 1;\n        if e.1.is_empty() {\n            e.1 = format!(\"align={align} data={}\", hexdump(&data));\n        }\n    }\n    for (k, (cnt, ex)) in tally {\n        println!(\"{cnt:6}  {k}\\n           e.g. {ex}\");\n    }\n}\nEOF\npython3 - <<'PY'\np='tests/diff.rs'\ns=open(p).read()\nold=\"\"\"    let mut rep = Report::new();\n    let only = std::env::var(\"DIFF_ONLY\").unwrap_or_default();\"\"\"\nnew=\"\"\"    if std::env::var(\"DIFF_PROBE\").is_ok() {\n        probe();\n        return;\n    }\n\n    let mut rep = Report::new();\n    let only = std::env::var(\"DIFF_ONLY\").unwrap_or_default();\"\"\"\nassert old in s; s=s.replace(old,new)\nopen(p,'w').write(s)\nprint('ok')\nPY\ntimeout 300 cargo build --tests 2>&1 | grep -E \"^error\" -A6 | head -20","description":"Add assertion probe mode"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5096,"cache_read_input_tokens":181421,"cache_creation":{"ephemeral_5m_input_tokens":5096,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"a438d629-c807-4b9d-ac71-026d3fe26fa4","uuid":"706447ed-a4eb-4b81-ba0d-d679f8d77e98","timestamp":"2026-08-20T18:36:32.409Z"}
