n39\t        use std::os::unix::ffi::OsStrExt;\n40\t        arg.as_os_str().as_bytes().to_vec()\n41\t    }\n42\t    #[cfg(not(unix))]\n43\t    {\n44\t        arg.to_string_lossy().into_owned().into_bytes()\n45\t    }\n46\t}\n47\t\n48\t/// `isspace` for the C locale, as used by `strtol` when skipping leading blanks.\n49\tfn is_c_space(b: u8) -> bool {\n50\t    matches!(b, b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r')\n51\t}\n52\t\n53\t/// Faithful port of `strtol(s, &end, 10)`.\n54\t///\n55\t/// Returns the parsed `long` value together with the offset that C would store\n56\t/// into `end`. When no conversion can be performed the offset is `0`, which is\n57\t/// how the caller detects `end == argv[1]`.\n58\tfn strtol_base10(s: &[u8]) -> (i64, usize) {\n59\t    let mut i = 0usize;\n60\t\n61\t    // Skip leading whitespace.\n62\t    while i < s.len() && is_c_space(s[i]) {\n63\t        i += 1;\n64\t    }\n65\t\n66\t    // Optional sign.\n67\t    let mut negative = false;\n68\t    if i < s.len() && (s[i] == b'+' || s[i] == b'-') {\n69\t        negative = s[i] == b'-';\n70\t        i += 1;\n71\t    }\n72\t\n73\t    // Digits.\n74\t    let digits_start = i;\n75\t    let mut acc: u64 = 0;\n76\t    let mut overflow = false;\n77\t    // Magnitude limit: LONG_MAX for positives, |LONG_MIN| for negatives.\n78\t    let limit: u64 = if negative {\n79\t        i64::MIN.unsigned_abs()\n80\t    } else {\n81\t        i64::MAX as u64\n82\t    };\n83\t\n84\t    while i < s.len() && s[i].is_ascii_digit() {\n85\t        let digit = u64::from(s[i] - b'0');\n86\t        if !overflow {\n87\t            match acc.checked_mul(10).and_then(|v| v.checked_add(digit)) {\n88\t                Some(v) if v <= limit => acc = v,\n89\t                _ => overflow = true,\n90\t            }\n91\t        }\n92\t        i += 1;\n93\t    }\n94\t\n95\t    if i == digits_start {\n96\t        // No digits consumed: no conversion performed, `end` == start of string.\n97\t        return (0, 0);\n98\t    }\n99\t\n100\t    let value = if overflow {\n101\t        // strtol clamps and sets ERANGE; the clamped value is what the caller sees.\n102\t        if negative {\n103\t            i64::MIN\n104\t        } else {\n105\t            i64::MAX\n106\t        }\n107\t    } else if negative {\n108\t        (acc as i64).wrapping_neg()\n109\t    } else {\n110\t        acc as i64\n111\t    };\n112\t\n113\t    (value, i)\n114\t}\n115\t\n116\t/// Rust's runtime ignores `SIGPIPE`; a C program does not. Restore the default\n117\t/// disposition so that a closed stdout terminates this program exactly as it\n118\t/// terminated the original binary.\n119\t#[cfg(unix)]\n120\tfn reset_sigpipe() {\n121\t    const SIGPIPE: i32 = 13;\n122\t    const SIG_DFL: usize = 0;\n123\t    extern \"C\" {\n124\t        fn signal(signum: i32, handler: usize) -> usize;\n125\t    }\n126\t    unsafe {\n127\t        signal(SIGPIPE, SIG_DFL);\n128\t    }\n129\t}\n130\t\n131\t#[cfg(not(unix))]\n132\tfn reset_sigpipe() {}\n133\t\n134\tfn main() -> ExitCode {\n135\t    reset_sigpipe();\n136\t\n137\t    let argv: Vec<OsString> = std::env::args_os().collect();\n138\t    let argc = argv.len();\n139\t\n140\t    let stdout = io::stdout();\n141\t    let mut out = BufWriter::new(stdout.lock());\n142\t\n143\t    if argc != 2 {\n144\t        let _ = out.write_all(b\"Error: should only be a single (integer) argument!\\n\");\n145\t        let _ = out.flush();\n146\t        return ExitCode::from(1);\n147\t    }\n148\t\n149\t    let arg = arg_bytes(&argv[1]);\n150\t    let (parsed, end) = strtol_base10(&arg);\n151\t    // `int val = strtol(...)` truncates the long result to 32 bits.\n152\t    let mut val = parsed as i32;\n153\t    if end == 0 {\n154\t        // end is set to start of string if nothing parsed\n155\t        let _ = out.write_all(b\"Error: first argument must be an integer!\\n\");\n156\t        let _ = out.flush();\n157\t        return ExitCode::from(1);\n158\t    }\n159\t\n160\t    let mut buf = itoa_i32();\n161\t    loop {\n162\t        let _ = out.write_all(format_i32(&mut buf, val));\n163\t        if val % 10 == 9 {\n164\t            break;\n165\t        }\n166\t        // Signed overflow is undefined in C; reproduce the wraparound that the\n167\t        // original binary exhibits on two's-complement hardware.\n168\t        val = val.wrapping_add(1);\n169\t    }\n170\t\n171\t    let _ = out.flush();\n172\t    ExitCode::SUCCESS\n173\t}\n174\t\n175\t/// Scratch buffer for decimal formatting: at most 11 digits/sign plus a newline.\n176\tfn itoa_i32() -> [u8; 12] {\n177\t    [0u8; 12]\n178\t}\n179\t\n180\t/// Renders `val` exactly as `printf(\"%d\\n\", val)` would, into `buf`.\n181\tfn format_i32(buf: &mut [u8; 12], val: i32) -> &[u8] {\n182\t    let mut tmp = [0u8; 11];\n183\t    let mut n = 0usize;\n184\t    let mut magnitude = (val as i64).unsigned_abs();\n185\t\n186\t    if magnitude == 0 {\n187\t        tmp[n] = b'0';\n188\t        n += 1;\n189\t    } else {\n190\t        while magnitude > 0 {\n191\t            tmp[n] = b'0' + (magnitude % 10) as u8;\n192\t            magnitude /= 10;\n193\t            n += 1;\n194\t        }\n195\t    }\n196\t\n197\t    let mut len = 0usize;\n198\t    if val < 0 {\n199\t        buf[len] = b'-';\n200\t        len += 1;\n201\t    }\n202\t    for k in (0..n).rev() {\n203\t        buf[len] = tmp[k];\n204\t        len += 1;\n205\t    }\n206\t    buf[len] = b'\\n';\n207\t    len += 1;\n208\t\n209\t    &buf[..len]\n210\t}\n211\t"}]},"parent_tool_use_id":null,"session_id":"5c72e38d-7458-440b-9b2d-8f203be39e4b","uuid":"26076b6b-d9fa-4edb-9a8b-a6cfccf74cde","timestamp":"2026-08-17T22:13:46.536Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-8x4Yrb/translated_rust/src/main.rs","content":"// Copyright 2025 MIT Lincoln Laboratory\n// Permission is hereby granted, free of charge,\n// to any person obtaining a copy of this software\n// and associated documentation files (the \"Software\"),\n// 