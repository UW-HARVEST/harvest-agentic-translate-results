{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01SD4Q3veNk8RUsAtnYCsDfm","type":"tool_result","content":"File created successfully at: /local/home/scheschb/.harvest/work/harvest-work-8x4Yrb/translated_rust/tests/common/mod.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"5c72e38d-7458-440b-9b2d-8f203be39e4b","uuid":"10e46dab-ba16-421d-94d9-4096790f5244","timestamp":"2026-08-17T22:24:01.634Z","tool_use_result":{"type":"create","filePath":"/local/home/scheschb/.harvest/work/harvest-work-8x4Yrb/translated_rust/tests/common/mod.rs","content":"// Differential-test harness: runs the ORIGINAL C binary and the TRANSLATED Rust\n// binary through their real external boundary (process invocation) and compares\n// stdout / stderr / exit status byte-for-byte.\n//\n// This crate builds an EXECUTABLE (c_src/CMakeLists.txt: add_executable), so\n// there is no shared object to `dlopen`; the process contract *is* the exported\n// surface. Rust code is never called in-process — always via the built binary,\n// exactly as an external caller would.\n#![allow(dead_code)]\n\nuse std::ffi::{CString, OsStr, OsString};\nuse std::io::Read;\nuse std::os::unix::ffi::{OsStrExt, OsStringExt};\nuse std::os::unix::process::{CommandExt, ExitStatusExt};\nuse std::path::{Path, PathBuf};\nuse std::process::{Child, Command, Stdio};\nuse std::sync::atomic::{AtomicBool, Ordering};\nuse std::sync::{Arc, Mutex, OnceLock};\nuse std::time::Duration;\n\n// ---------------------------------------------------------------------------\n// raw libc bits we need (no libc crate available offline)\n// ---------------------------------------------------------------------------\nextern \"C\" {\n    fn close(fd: i32) -> i32;\n    fn fork() -> i32;\n    fn execv(path: *const i8, argv: *const *const i8) -> i32;\n    fn pipe(fds: *mut i32) -> i32;\n    fn dup2(old: i32, new: i32) -> i32;\n    fn waitpid(pid: i32, status: *mut i32, options: i32) -> i32;\n    fn read(fd: i32, buf: *mut u8, count: usize) -> isize;\n    fn kill(pid: i32, sig: i32) -> i32;\n    fn _exit(code: i32) -> !;\n}\n\nconst SIGKILL: i32 = 9;\n\n// ---------------------------------------------------------------------------\n// binaries under test\n// ---------------------------------------------------------------------------\n\npub fn manifest_dir() -> PathBuf {\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n}\n\n/// The translated Rust binary, as an external caller sees it.\npub fn rust_bin() -> PathBuf {\n    PathBuf::from(env!(\"CARGO_BIN_EXE_driver\"))\n}\n\n/// The original C binary (ground truth). Built with cmake on first use.\npub fn c_bin() -> PathBuf {\n    static C: OnceLock<PathBuf> = OnceLock::new();\n    C.get_or_init(|| {\n        static LOCK: Mutex<()> = Mutex::new(());\n        let _g = LOCK.lock().unwrap();\n        let src = manifest_dir().join(\"c_src\");\n        let build = src.join(\"build\");\n        let bin = build.join(\"driver\");\n        if !bin.exists() {\n            std::fs::create_dir_all(&build).expect(\"create c_src/build\");\n            let st = Command::new(\"cmake\")\n                .current_dir(&build)\n                .arg(\"..\")\n                .arg(\"-DCMAKE_POSITION_INDEPENDENT_CODE=ON\")\n                .stdout(Stdio::null())\n                .stderr(Stdio::inherit())\n                .status()\n                .expect(\"run cmake (is cmake installed?)\");\n            assert!(st.success(), \"cmake configure failed\");\n            let st = Command::new(\"cmake\")\n                .current_dir(&build)\n                .args([\"--build\", \".\"])\n                .stdout(Stdio::null())\n                .stderr(Stdio::inherit())\n                .status()\n                .expect(\"run cmake --build\");\n            assert!(st.success(), \"cmake build failed\");\n        }\n        assert!(bin.exists(), \"C binary missing at {}\", bin.display());\n        bin\n    })\n    