   r: 0.0,\n    };\n    cap.a = c2V(cap_a_x, cap_a_y);\n    cap.b = c2V(cap_b_x, cap_b_y);\n    cap.r = cap_r;\n\n    hit += unsafe {\n        c2CastRay(\n            ray,\n            (&raw const cap) as *const c_void,\n            C2_TYPE_CAPSULE,\n            cast2,\n        )\n    } << 1;\n\n    let mut bb = c2AABB {\n        min: c2v { x: 0.0, y: 0.0 },\n        max: c2v { x: 0.0, y: 0.0 },\n    };\n    bb.min = c2V(bb_min_x, bb_min_y);\n    bb.max = c2V(bb_max_x, bb_max_y);\n\n    hit += unsafe { c2CastRay(ray, (&raw const bb) as *const c_void, C2_TYPE_AABB, cast3) } << 2;\n\n    hit\n}\n","structuredPatch":[{"oldStart":225,"oldLines":9,"newStart":225,"newLines":18,"lines":[" ///         return a.x * b.x + a.y * b.y;"," /// }"," /// ```","+///","+/// `-O0` codegen (`c2Dot+0x0e`):","+/// ```asm","+/// movss a.x,%xmm1 ; movss b.x,%xmm0 ; mulss %xmm0,%xmm1   ; xmm1 = a.x*b.x  (dst=a.x)","+/// movss a.y,%xmm2 ; movss b.y,%xmm0 ; mulss %xmm2,%xmm0   ; xmm0 = b.y*a.y  (dst=b.y)","+/// addss %xmm1,%xmm0                                       ; xmm0 = p2 + p1  (dst=p2)","+/// ```"," #[unsafe(no_mangle)]"," pub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {","-    fadd(fmul(a.x, b.x), fmul(a.y, b.y))","+    let p1 = fmul(a.x, b.x);","+    let p2 = fmul(b.y, a.y);","+    fadd(p2, p1)"," }"," "," /// ```c"]}],"userModified":false,"replaceAll":false}}
