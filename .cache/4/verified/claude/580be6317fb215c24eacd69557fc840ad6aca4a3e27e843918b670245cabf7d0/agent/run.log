criptions of the C ternary macros.\n   100\t//\n   101\t// These deliberately do NOT use `f32::abs`, `f32::min` or `f32::max`, because\n   102\t// the C macros differ from those for signed zeros and NaNs:\n   103\t//   * `-0.0f < 0` is false, so the macro yields `-0.0f` where `fabsf` yields\n   104\t//     `+0.0f`.\n   105\t//   * any comparison with NaN is false, so the macros propagate the *second*\n   106\t//     operand (min/max) or the unmodified NaN with its sign bit intact (abs),\n   107\t//     whereas the standard-library helpers pick the non-NaN operand / clear\n   108\t//     the sign bit.\n   109\t// ---------------------------------------------------------------------------\n   110\t\n   111\t// ---------------------------------------------------------------------------\n   112\t// Order-preserving IEEE-754 primitives.\n   113\t//\n   114\t// IEEE addition and multiplication are commutative for every operand pair\n   115\t// EXCEPT when both operands are NaN: x86 `ADDSS`/`ADDPS`/`MULSS`/`MULPS`\n   116\t// return the *destination* (left-hand) operand, quieted.  LLVM treats `fadd`\n   117\t// and `fmul` as freely commutable, and it does in fact swap them here -- its\n   118\t// SLP vectorizer reassociates lane 1 of `c2MulmvT` into\n   119\t// `a.y.y*b.y + a.y.x*b.x`, which flips the sign of the resulting NaN relative\n   120\t// to the C artifact (`ffc00000` vs `7fc00000`).\n   121\t//\n   122\t// These helpers pin the operand order written in the C source so that NaN\n   123\t// sign and payload bits are reproduced exactly.  For non-NaN operands they\n   124\t// are plain IEEE ops, so ordinary results are bit-for-bit unaffected.\n   125\t// ---------------------------------------------------------------------------\n   126\t\n   127\t/// Quiet a NaN the way the x86 FP units do: set the mantissa MSB, leave the\n   128\t/// sign bit and the rest of the payload alone.\n   129\t#[inline]\n   130\tfn quiet(x: f32) -> f32 {\n   131\t    f32::from_bits(x.to_bits() | 0x0040_0000)\n   132\t}\n   133\t\n   134\t/// `a + b`, selecting the left operand's NaN when both are NaN.\n   135\t#[inline]\n   136\tfn fadd(a: f32, b: f32) -> f32 {\n   137\t    if a.is_nan() {\n   138\t        quiet(a)\n   139\t    } else if b.is_nan() {\n   140\t        quiet(b)\n   141\t    } else {\n   142\t        a + b\n   143\t    }\n   144\t}\n   145\t\n   146\t/// `a - b`, selecting the left operand's NaN when both are NaN.\n   147\t#[inline]\n   148\tfn fsub(a: f32, b: f32) -> f32 {\n   149\t    if a.is_nan() {\n   150\t        quiet(a)\n   151\t    } else if b.is_nan() {\n   152\t        quiet(b)\n   153\t    } else {\n   154\t        a - b\n   155\t    }\n   156\t}\n   157\t\n   158\t/// `a * b`, selecting the left operand's NaN when both are NaN.\n   159\t#[inline]\n   160\tfn fmul(a: f32, b: f32) -> f32 {\n   161\t    if a.is_nan() {\n   162\t        quiet(a)\n   163\t    } else if b.is_nan() {\n   164\t        quiet(b)\n   165\t    } else {\n   166\t        a * b\n   167\t    }\n   168\t}\n   169\t\n   170\t/// `a / b`, selecting the left operand's NaN when both are NaN.\n   171\t#[inline]\n   172\tfn fdiv(a: f32, b: f32) -> f32 {\n   173\t    if a.is_nan() {\n   174\t        quiet(a)\n   175\t    } else if b.is_nan() {\n   176\t        quiet(b)\n   177\t    } else {\n   178\t        a / b\n   179\t    }\n   180\t}\n   181\t\n   182\t/// `#define c2Abs(a) ((a) < 0 ? -(a) : (a))`\n   183\t#[inline]\n   184\tfn m_abs(a: f32) -> f32 {\n   185\t    if a < 0.0 { -a } else { a }\n   186\t}\n   187\t\n   188\t/// `#define c2Min(a, b) ((a) < (b) ? (a) : (b))`\n   189\t#[inline]\n   190\tfn m_min(a: f32, b: f32) -> f32 {\n   191\t    if a < b { a } else { b }\n   192\t}\n   193\t\n   194\t/// `#define c2Max(a, b) ((a) > (b) ? (a) : (b))`\n   195\t#[inline]\n   196\tfn m_max(a: f32, b: f32) -> f32 {\n   197\t    if a > b { a } else { b }\n   198\t}\n   199\t\n   200\t// ---------------------------------------------------------------------------\n   201\t// Vector helpers\n   202\t// ---------------------------------------------------------------------------\n   203\t\n   204\t/// ```c\n   205\t/// c2v c2V(float x, float y) {\n   206\t///         c2v a;\n   207\t///         a.x = x;\n   208\t///         a.y = y;\n   209\t///         return a;\n   210\t/// }\n   211\t/// ```\n   212\t#[unsafe(no_mangle)]\n   213\tpub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n   214\t    c2v { x, y }\n   215\t}\n   216\t\n   217\t/// ```c\n   218\t/// float c2Dot(c2v a, c2v b) {\n   219\t///         return a.x * b.x + a.y * b.y;\n   220\t/// }\n   221\t/// ```\n   222\t#[unsafe(no_mangle)]\n   223\tpub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n   224\t    fadd(fmul(a.x, b.x), fmul(a.y, b.y))\n   225\t}\n   226\t\n   227\t/// ```c\n   228\t/// float c2Len(c2v a) {\n   229\t///         return sqrtf(c2Dot(a, a));\n   230\t/// }\n   231\t/// ```\n   232\t#[unsafe(no_mangle)]\n   233\tpub extern \"C\" fn c2Len(a: c2v) -> f32 {\n   234\t    c2Dot(a, a).sqrt()\n   235\t}\n   236\t\n   237\t/// ```c\n   238\t/// c2v c2Add(c2v a, c2v b) {\n   239\t///         a.x += b.x;\n   240\t///         a.y += b.y;\n   241\t///         return a;\n   242\t/// }\n   243\t/// ```\n   244\t#[unsafe(no_mangle)]\n   245\tpub extern \"C\" fn c2Add(mut a: c2v, b: c2v) -> c2v {\n   246\t    a.x = fadd(a.x, b.x);\n   247\t    a.y = fadd(a.y, b.y);\n   248\t    a\n   249\t}\n   250\t\n   251\t/// ```c\n   252\t/// c2v c2Sub(c2v a, c2v b) {\n   253\t///         a.x -= b.x;\n   254\t///         a.y -= b.y;\n   255\t///         return a;\n   256\t/// }\n   257\t/// ```\n   258\t#[unsafe(no_mangle)]\n   259\tpub extern \"C\" fn c2Sub(mut a: c2v, b: c2v) -> c2v {\n   260\t    a.x = fsub(a.x, b.x);\n   261\t    a.y = fsub(a.y, b.y);\n   262\t    a\n   263\t}\n   264\t\n   265\t/// ```c\n   266\t/// c2v c2Mulvs(c2v a, float b) {\n   267\t///         a.x *= b;\n   268\t///         a.y *= b;\n   269\t///         return a;\n   270\t/// }\n   271\t/// ```\n   272\t///\n   273\t/// GCC compiles this to `movsldup`/`mulps` with the *broadcast `b`* as the\n   274\t/// destination register (`mulps %xmm2,%xmm0` where `xmm0 = [b, b]`), i.e. it\n   275\t/// commutes the multiply.  The operand order below matches that artifact, so a\n   276\t/// NaN `b` wins over a NaN `a.x`/`a.y`.\n   277\t#[unsafe(no_mangle)]\n   278\tpub extern \"C\" fn c2Mulvs(mut a: c2v, b: f32) -> c2v {\n   279\t    a.x = fmul(b, a.x);\n   280\t    a.y = fmul(b, a.y);\n   281\t    a\n   282\t}\n   283\t\n   284\t/// ```c\n   285\t/// c2v c2Div(c2v a, float b) {\n   286\t///         return c2Mulvs(a, 1.0f / b);\n   287\t/// }\n   288\t/// ```\n   289\t///\n   290\t/// Note: reciprocal-then-multiply, not componentwise division.\n   291\t#[unsafe(no_mangle)]\n   292\tpub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n   293\t    c2Mulvs(a, fdiv(1.0f32, b))\n   294\t}\n   295\t\n   296\t/// ```c\n   297\t/// c2v c2Norm(c2v a) {\n   298\t///         return c2Div(a, c2Len(a));\n   299\t/// }\n   300\t/// ```\n   301\t#[unsafe(no_mangle)]\n   302\tpub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n   303\t    c2Div(a, c2Len(a))\n   304\t}\n   305\t\n   306\t/// ```c\n   307\t/// c2v c2Minv(c2v a, c2v b) {\n   308\t///         return c2V(((a.x) < (b.x) ? (a.x) : (b.x)),\n   309\t///                         ((a.y) < (b.y) ? (a.y) : (b.y)));\n   310\t/// }\n   311\t/// ```\n   312\t#[unsafe(no_mangle)]\n   313\tpub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n   314\t    c2V(m_min(a.x, b.x), m_min(a.y, b.y))\n   315\t}\n   316\t\n   317\t/// ```c\n   318\t/// c2v c2Maxv(c2v a, c2v b) {\n   319\t///         return c2V(((a.x) > (b.x) ? (a.x) : (b.x)),\n   320\t///                         ((a.y) > (b.y) ? (a.y) : (b.y)));\n   321\t/// }\n   322\t/// ```\n   323\t#[unsafe(no_mangle)]\n   324\tpub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n   325\t    c2V(m_max(a.x, b.x), m_max(a.y, b.y))\n   326\t}\n   327\t\n   328\t/// ```c\n   329\t/// c2v c2Skew(c2v a) {\n   330\t///         c2v b;\n   331\t///         b.x = -a.y;\n   332\t///         b.y = a.x;\n   333\t///         return b;\n   334\t/// }\n   335\t/// ```\n   336\t#[unsafe(no_mangle)]\n   337\tpub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n   338\t    c2v { x: -a.y, y: a.x }\n   339\t}\n   340\t\n   341\t/// ```c\n   342\t/// c2v c2Absv(c2v a) {\n   343\t///         return c2V(((a.x) < 0 ? -(a.x) : (a.x)), ((a.y) < 0 ? -(a.y) : (a.y)));\n   344\t/// }\n   345\t/// ```\n   346\t#[unsafe(no_mangle)]\n   347\tpub extern \"C\" fn c2Absv(a: c2v) -> c2v {\n   348\t    c2V(m_abs(a.x), m_abs(a.y))\n   349\t}\n   350\t\n   351\t/// ```c\n   352\t/// c2v c2CCW90(c2v a) {\n   353\t///         c2v b;\n   354\t///         b.x = a.y;\n   355\t///         b.y = -a.x;\n   356\t///         return b;\n   357\t/// }\n   358\t/// ```\n   359\t#[unsafe(no_mangle)]\n   360\tpub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n   361\t    c2v { x: a.y, y: -a.x }\n   362\t}\n   363\t\n   364\t/// ```c\n   365\t/// c2v c2MulmvT(c2m a, c2v b) {\n   366\t///         c2v c;\n   367\t///         c.x = a.x.x * b.x + a.x.y * b.y;\n   368\t///         c.y = a.y.x * b.x + a.y.y * b.y;\n   369\t///         return c;\n   370\t/// }\n   371\t/// ```\n   372\t#[unsafe(no_mangle)]\n   373\tpub extern \"C\" fn c2MulmvT(a: c2m, b: c2v) -> c2v {\n   374\t    c2v {\n   375\t        x: fadd(fmul(a.x.x, b.x), fmul(a.x.y, b.y)),\n   376\t        y: fadd(fmul(a.y.x, b.x), fmul(a.y.y, b.y)),\n   377\t    }\n   378\t}\n   379\t\n   380\t// ---------------------------------------------------------------------------\n   381\t// Overlap tests\n   382\t// ---------------------------------------------------------------------------\n   383\t\n   384\t/// ```c\n   385\t/// int c2AABBtoAABB(c2AABB A, c2AABB B) {\n   386\t///         int d0 = B.max.x < A.min.x;\n   387\t///         int d1 = A.max.x < B.min.x;\n   388\t///         int d2 = B.max.y < A.min.y;\n   389\t///         int d3 = A.max.y < B.min.y;\n   390\t///         return !(d0 | d1 | d2 | d3);\n   391\t/// }\n   392\t/// ```\n   393\t#[unsafe(no_mangle)]\n   394\tpub extern \"C\" fn c2AABBtoAABB(A: c2AABB, B: c2AABB) -> c_int {\n   395\t    let d0: c_int = (B.max.x < A.min.x) as c_int;\n   396\t    let d1: c_int = (A.max.x < B.min.x) as c_int;\n   397\t    let d2: c_int = (B.max.y < A.min.y) as c_int;\n   398\t    let d3: c_int = (A.max.y < B.min.y) as c_int;\n   399\t    ((d0 | d1 | d2 | d3) == 0) as c_int\n   400\t}\n   401\t\n   402\t/// ```c\n   403\t/// int c2AABBtoPoint(c2AABB A, c2v B) {\n   404\t///         int d0 = B.x < A.min.x;\n   405\t///         int d1 = B.y < A.min.y;\n   406\t///         int d2 = B.x > A.max.x;\n   407\t///         int d3 = B.y > A.max.y;\n   408\t///         return !(d0 | d1 | d2 | d3);\n   409\t/// }\n   410\t/// ```\n   411\t#[unsafe(no_mangle)]\n   412\tpub extern \"C\" fn c2AABBtoPoint(A: c2AABB, B: c2v) -> c_int {\n   413\t    let d0: c_int = (B.x < A.min.x) as c_int;\n   414\t    let d1: c_int = (B.y < A.min.y) as c_int;\n   415\t    let d2: c_int = (B.x > A.max.x) as c_int;\n   416\t    let d3: c_int = (B.y > A.max.y) as c_int;\n   417\t    ((d0 | d1 | d2 | d3) == 0) as c_int\n   418\t}\n   419\t\n   420\t/// ```c\n   421\t/// int c2CircleToPoint(c2Circle A, c2v B) {\n   422\t///         c2v n = c2Sub(A.p, B);\n   423\t///         float d2 = c2Dot(n, n);\n   424\t///         return d2 < A.r * A.r;\n   425\t/// }\n   426\t/// ```\n   427\t#[unsafe(no_mangle)]\n   428\tpub extern \"C\" fn c2CircleToPoint(A: c2Circle, B: c2v) -> c_int {\n   429\t    let n = c2Sub(A.p, B);\n   430\t    let d2 = c2Dot(n, n);\n   431\t    (d2 < fmul(A.r, A.r)) as c_int\n   432\t}\n   433\t\n   434\t// ---------------------------------------------------------------------------\n   435\t// `static inline` plane helpers (not exported by the C library)\n   436\t// ---------------------------------------------------------------------------\n   437\t\n   438\t/// ```c\n   439\t/// static inline float c2SignedDistPointToPlane_OneDimensional(float p, float n,\n   440\t///                 float d) {\n   441\t///         return p * n - d * n;\n   442\t/// }\n   443\t/// ```\n   444\t///\n   445\t/// `n` is always the literal `1.0f` or `-1.0f` at the eight call sites in\n   446\t/// `c2RaytoAABB`, and GCC constant-folds the two multiplies away entirely:\n   447\t///\n   448\t/// * `n == 1.0f`  becomes `subss` with `p` as the destination (`p - d`)\n   449\t/// * `n == -1.0f` becomes `subss` with `d` as the destination (`d - p`)\n   450\t///\n   451\t/// The second form is *not* the same as evaluating `(-p) - (-d)` when both\n   452\t/// operands are NaN (the destination operand wins, and `-p` would have had its\n   453\t/// sign bit flipped), so the two specializations are transcribed separately.\n   454\t#[inline]\n   455\tfn c2SignedDist_pos1(p: f32, d: f32) -> f32 {\n   456\t    // p * 1.0f - d * 1.0f  ==>  p - d\n   457\t    fsub(p, d)\n   458\t}\n   459\t\n   460\t/// See [`c2SignedDist_pos1`]: the `n == -1.0f` specialization.\n   461\t#[inline]\n   462\tfn c2SignedDist_neg1(p: f32, d: f32) -> f32 {\n   463\t    // p * -1.0f - d * -1.0f  ==>  d - p\n   464\t    fsub(d, p)\n   465\t}\n   466\t\n   467\t/// ```c\n   468\t/// static inline float c2RayToPlane_OneDimensional(float da, float db) {\n   469\t///         if (da < 0)\n   470\t///                 return 0;\n   471\t///         else if (da * db > 0)\n   472\t///                 return 1.0f;\n   473\t///         else {\n   474\t///                 float d = da - db;\n   475\t///                 if (d != 0)\n   476\t///                         return da / d;\n   477\t///                 else\n   478\t///                         return 0;\n   479\t///         }\n   480\t/// }\n   481\t/// ```\n   482\t#[inline]\n   483\tfn c2RayToPlane_OneDimensional(da: f32, db: f32) -> f32 {\n   484\t    if da < 0.0 {\n   485\t        0.0\n   486\t    } else if fmul(db, da) > 0.0 {\n   487\t        // GCC emits `mulss %xmm5,%xmm6` with `db` as the destination.\n   488\t        1.0f32\n   489\t    } else {\n   490\t        let d = fsub(da, db);\n   491\t        if d != 0.0 { fdiv(da, d) } else { 0.0 }\n   492\t    }\n   493\t}\n   494\t\n   495\t// ---------------------------------------------------------------------------\n   496\t// Raycasts\n   497\t// ---------------------------------------------------------------------------\n   498\t\n   499\t/// ```c\n   500\t/// int c2RaytoCircle(c2Ray A, c2Circle B, c2Raycast *out) {\n   501\t///         c2v p = B.p;\n   502\t///         c2v m = c2Sub(A.p, p);\n   503\t///         float c = c2Dot(m, m) - B.r * B.r;\n   504\t///         float b = c2Dot(m, A.d);\n   505\t///         float disc = b * b - c;\n   506\t///         if (disc < 0)\n   507\t///                 return 0;\n   508\t///         float t = -b - sqrtf(disc);\n   509\t///         if (t >= 0 && t <= A.t) {\n   510\t///                 out->t = t;\n   511\t///                 c2v impact = c2Add(A.p, c2Mulvs(A.d, t));\n   512\t///                 out->n = c2Norm(c2Sub(impact, p));\n   513\t///                 return 1;\n   514\t///         }\n   515\t///         return 0;\n   516\t/// }\n   517\t/// ```\n   518\t#[unsafe(no_mangle)]\n   519\tpub unsafe extern \"C\" fn c2RaytoCircle(A: c2Ray, B: c2Circle, out: *mut c2Raycast) -> c_int {\n   520\t    let p = B.p;\n   521\t    let m = c2Sub(A.p, p);\n   522\t    let c = fsub(c2Dot(m, m), fmul(B.r, B.r));\n   523\t    let b = c2Dot(m, A.d);\n   524\t    let disc = fsub(fmul(b, b), c);\n   525\t    if disc < 0.0 {\n   526\t        return 0;\n   527\t    }\n   528\t    let t = fsub(-b, disc.sqrt());\n   529\t    if t >= 0.0 && t <= A.t {\n   530\t        unsafe {\n   531\t            (*out).t = t;\n   532\t            let impact = c2Add(A.p, c2Mulvs(A.d, t));\n   533\t            (*out).n = c2Norm(c2Sub(impact, p));\n   534\t        }\n   535\t        return 1;\n   536\t    }\n   537\t    0\n   538\t}\n   539\t\n   540\t/// ```c\n   541\t/// int c2RaytoAABB(c2Ray A, c2AABB B, c2Raycast *out) { ... }\n   542\t/// ```\n   543\t///\n   544\t/// See `c_src/src/lib.c:139` — the structure (including the `d > 0` early out\n   545\t/// and the four-way `>=` cascade that picks the exit face) is preserved\n   546\t/// exactly, as is the `(float)hitN * tN` masking which propagates NaN when a\n   547\t/// `tN` is NaN even though `hitN` is 0.\n   548\t#[unsafe(no_mangle)]\n   549\tpub unsafe extern \"C\" fn c2RaytoAABB(A: c2Ray, B: c2AABB, out: *mut c2Raycast) -> c_int {\n   550\t    let p0 = A.p;\n   551\t    let p1 = c2Add(A.p, c2Mulvs(A.d, A.t));\n   552\t    let a_box = c2AABB {\n   553\t        min: c2Minv(p0, p1),\n   554\t        max: c2Maxv(p0, p1),\n   555\t    };\n   556\t    if c2AABBtoAABB(a_box, B) == 0 {\n   557\t        return 0;\n   558\t    }\n   559\t    let ab = c2Sub(p1, p0);\n   560\t    let n = c2Skew(ab);\n   561\t    let abs_n = c2Absv(n);\n   562\t    let half_extents = c2Mulvs(c2Sub(B.max, B.min), 0.5f32);\n   563\t    let center_of_b_box = c2Mulvs(c2Add(B.min, B.max), 0.5f32);\n   564\t    let d = fsub(\n   565\t        m_abs(c2Dot(n, c2Sub(p0, center_of_b_box))),\n   566\t        c2Dot(abs_n, half_extents),\n   567\t    );\n   568\t    if d > 0.0 {\n   569\t        return 0;\n   570\t    }\n   571\t    let da0 = c2SignedDist_neg1(p0.x, B.min.x);\n   572\t    let db0 = c2SignedDist_neg1(p1.x, B.min.x);\n   573\t    let da1 = c2SignedDist_pos1(p0.x, B.max.x);\n   574\t    let db1 = c2SignedDist_pos1(p1.x, B.max.x);\n   575\t    let da2 = c2SignedDist_neg1(p0.y, B.min.y);\n   576\t    let db2 = c2SignedDist_neg1(p1.y, B.min.y);\n   577\t    let da3 = c2SignedDist_pos1(p0.y, B.max.y);\n   578\t    let db3 = c2SignedDist_pos1(p1.y, B.max.y);\n   579\t    let mut t0 = c2RayToPlane_OneDimensional(da0, db0);\n   580\t    let mut t1 = c2RayToPlane_OneDimensional(da1, db1);\n   581\t    let mut t2 = c2RayToPlane_OneDimensional(da2, db2);\n   582\t    let mut t3 = c2RayToPlane_OneDimensional(da3, db3);\n   583\t    let hit0: c_int = (t0 <= 1.0f32) as c_int;\n   584\t    let hit1: c_int = (t1 <= 1.0f32) as c_int;\n   585\t    let hit2: c_int = (t2 <= 1.0f32) as c_int;\n   586\t    let hit3: c_int = (t3 <= 1.0f32) as c_int;\n   587\t    let hit: c_int = hit0 | hit1 | hit2 | hit3;\n   588\t    if hit != 0 {\n   589\t        t0 = fmul(hit0 as f32, t0);\n   590\t        t1 = fmul(hit1 as f32, t1);\n   591\t        t2 = fmul(hit2 as f32, t2);\n   592\t        t3 = fmul(hit3 as f32, t3);\n   593\t        unsafe {\n   594\t            if t0 >= t1 && t0 >= t2 && t0 >= t3 {\n   595\t                (*out).t = fmul(t0, A.t);\n   596\t                (*out).n = c2V(-1.0, 0.0);\n   597\t            } else if t1 >= t0 && t1 >= t2 && t1 >= t3 {\n   598\t                (*out).t = fmul(t1, A.t);\n   599\t                (*out).n = c2V(1.0, 0.0);\n   600\t            } else if t2 >= t0 && t2 >= t1 && t2 >= t3 {\n   601\t                (*out).t = fmul(t2, A.t);\n   602\t                (*out).n = c2V(0.0, -1.0);\n   603\t            } else {\n   604\t                (*out).t = fmul(t3, A.t);\n   605\t                (*out).n = c2V(0.0, 1.0);\n   606\t            }\n   607\t        }\n   608\t        1\n   609\t    } else {\n   610\t        0\n   611\t    }\n   612\t}\n   613\t\n   614\t/// ```c\n   615\t/// int c2RaytoCapsule(c2Ray A, c2Capsule B, c2Raycast *out) { ... }\n   616\t/// ```\n   617\t///\n   618\t/// See `c_src/src/lib.c:231`.  Note that `out->n` / `out->t` are written\n   619\t/// *before* the early-out overlap tests, so `out` is mutated even on the\n   620\t/// `return 1` \"already inside\" paths and on some `return 0` paths — that\n   621\t/// side effect is preserved.\n   622\t#[unsafe(no_mangle)]\n   623\tpub unsafe extern \"C\" fn c2RaytoCapsule(A: c2Ray, B: c2Capsule, out: *mut c2Raycast) -> c_int {\n   624\t    let mut M = c2m {\n   625\t        x: c2v { x: 0.0, y: 0.0 },\n   626\t        y: c2v { x: 0.0, y: 0.0 },\n   627\t    };\n   628\t    M.y = c2Norm(c2Sub(B.b, B.a));\n  