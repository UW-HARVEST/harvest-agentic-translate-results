{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01FCepsWKiFfmkTTmJaZA8XM","type":"tool_result","content":"495\t///         if (da < 0)\n496\t///                 return 0;\n497\t///         else if (da * db > 0)\n498\t///                 return 1.0f;\n499\t///         else {\n500\t///                 float d = da - db;\n501\t///                 if (d != 0)\n502\t///                         return da / d;\n503\t///                 else\n504\t///                         return 0;\n505\t///         }\n506\t/// }\n507\t/// ```\n508\t#[inline]\n509\tfn c2RayToPlane_OneDimensional(da: f32, db: f32) -> f32 {\n510\t    if da < 0.0 {\n511\t        0.0\n512\t    } else if fmul(da, db) > 0.0 {\n513\t        // -O0: `movss da,%xmm0 ; mulss db,%xmm0` -> dst = da.\n514\t        1.0f32\n515\t    } else {\n516\t        let d = fsub(da, db);\n517\t        if d != 0.0 { fdiv(da, d) } else { 0.0 }\n518\t    }\n519\t}\n520\t\n521\t// ---------------------------------------------------------------------------\n522\t// Raycasts\n523\t// ---------------------------------------------------------------------------\n524\t\n525\t/// ```c\n526\t/// int c2RaytoCircle(c2Ray A, c2Circle B, c2Raycast *out) {\n527\t///         c2v p = B.p;\n528\t///         c2v m = c2Sub(A.p, p);\n529\t///         float c = c2Dot(m, m) - B.r * B.r;\n530\t///         float b = c2Dot(m, A.d);\n531\t///         float disc = b * b - c;\n532\t///         if (disc < 0)\n533\t///                 return 0;\n534\t///         float t = -b - sqrtf(disc);\n535\t///         if (t >= 0 && t <= A.t) {\n536\t///                 out->t = t;\n537\t///                 c2v impact = c2Add(A.p, c2Mulvs(A.d, t));\n538\t///                 out->n = c2Norm(c2Sub(impact, p));\n539\t///                 return 1;\n540\t///         }\n541\t///         return 0;\n542\t/// }\n543\t/// ```\n544\t#[unsafe(no_mangle)]\n545\tpub unsafe extern \"C\" fn c2RaytoCircle(A: c2Ray, B: c2Circle, out: *mut c2Raycast) -> c_int {\n546\t    let p = B.p;\n547\t    let m = c2Sub(A.p, p);\n548\t    let c = fsub(c2Dot(m, m), fmul(B.r, B.r));\n549\t    let b = c2Dot(m, A.d);\n550\t    let disc = fsub(fmul(b, b), c);\n551\t    if disc < 0.0 {\n552\t        return 0;\n553\t    }\n554\t    let t = fsub(-b, disc.sqrt());\n555\t    if t >= 0.0 && t <= A.t {\n556\t        unsafe {\n557\t            (*out).t = t;\n558\t            let impact = c2Add(A.p, c2Mulvs(A.d, t));\n559\t            (*out).n = c2Norm(c2Sub(impact, p));\n560\t        }\n561\t        return 1;\n562\t    }\n563\t    0\n564\t}\n565\t\n566\t/// ```c\n567\t/// int c2RaytoAABB(c2Ray A, c2AABB B, c2Raycast *out) { ... }\n568\t/// ```\n569\t///\n570\t/// See `c_src/src/lib.c:139` — the structure (including the `d > 0` early out\n571\t/// and the four-way `>=` cascade that picks the exit face) is preserved\n572\t/// exactly, as is the `(float)hitN * tN` masking which propagates NaN when a\n573\t/// `tN` is NaN even though `hitN` is 0.\n574\t#[unsafe(no_mangle)]\n575\tpub unsafe extern \"C\" fn c2RaytoAABB(A: c2Ray, B: c2AABB, out: *mut c2Raycast) -> c_int {\n576\t    let p0 = A.p;\n577\t    let p1 = c2Add(A.p, c2Mulvs(A.d, A.t));\n578\t    let a_box = c2AABB {\n579\t        min: c2Minv(p0, p1),\n580\t        max: c2Maxv(p0, p1),\n581\t    };\n582\t    if c2AABBtoAABB(a_box, B) == 0 {\n583\t        return 0;\n584\t    }\n585\t    let ab = c2Sub(p1, p0);\n586\t    let n = c2Skew(ab);\n587\t    let abs_n = c2Absv(n);\n588\t    let half_extents = c2Mulvs(c2Sub(B.max, B.min), 0.5f32);\n589\t    let center_of_b_box = c2Mulvs(c2Add(B.min, B.max), 0.5f32);\n590\t    let d = fsub(\n591\t        m_abs(c2Dot(n, c2Sub(p0, center_of_b_box))),\n592\t        c2Dot(abs_n, half_extents),\n593\t    );\n594\t    if d > 0.0 {\n595\t        return 0;\n596\t    }\n597\t    let da0 = c2SignedDistPointToPlane_OneDimensional(p0.x, -1.0f32, B.min.x);\n598\t    let db0 = c2SignedDistPointToPlane_OneDimensional(p1.x, -1.0f32, B.min.x);\n599\t    let da1 = c2SignedDistPointToPlane_OneDimensional(p0.x, 1.0f32, B.max.x);\n600\t    let db1 = c2SignedDistPointToPlane_OneDimensional(p1.x, 1.0f32, B.max.x);\n601\t    let da2 = c2SignedDistPointToPlane_OneDimensional(p0.y, -1.0f32, B.min.y);\n602\t    let db2 = c2SignedDistPointToPlane_OneDimensional(p1.y, -1.0f32, B.min.y);\n603\t    let da3 = c2SignedDistPointToPlane_OneDimensional(p0.y, 1.0f32, B.max.y);\n604\t    let db3 = c2SignedDistPointToPlane_OneDimensional(p1.y, 1.0f32, B.max.y);\n605\t    let mut t0 = c2RayToPlane_OneDimensional(da0, db0);\n606\t    let mut t1 = c2RayToPlane_OneDimensional(da1, db1);\n607\t    let mut t2 = c2RayToPlane_OneDimensional(da2, db2);\n608\t    let mut t3 = c2RayToPlane_OneDimensional(da3, db3);\n609\t    let hit0: c_int = (t0 <= 1.0f32) as c_int;\n610\t    let hit1: c_int = (t1 <= 1.0f32) as c_int;\n611\t    let hit2: c_int = (t2 <= 1.0f32) as c_int;\n612\t    let hit3: c_int = (t3 <= 1.0f32) as c_int;\n613\t    let hit: c_int = hit0 | hit1 | hit2 | hit3;\n614\t    if hit != 0 {\n615\t        t0 = fmul(hit0 as f32, t0);\n616\t        t1 = fmul(hit1 as f32, t1);\n617\t        t2 = fmul(hit2 as f32, t2);\n618\t        t3 = fmul(hit3 as f32, t3);\n619\t        unsafe {\n620\t            // -O0: `movss 0x20(%rbp),%xmm0 ; mulss tN,%xmm0` -> dst = A.t.\n621\t            if t0 >= t1 && t0 >= t2 && t0 >= t3 {\n622\t                (*out).t = fmul(A.t, t0);\n623\t                (*out).n = c2V(-1.0, 0.0);\n624\t            } else if t1 >= t0 && t1 >= t2 && t1 >= t3 {\n625\t                (*out).t = fmul(A.t, t1);\n626\t                (*out).n = c2V(1.0, 0.0);\n627\t            } else if t2 >= t0 && t2 >= t1 && t2 >= t3 {\n628\t                (*out).t = fmul(A.t, t2);\n629\t                (*out).n = c2V(0.0, -1.0);\n630\t            } else {\n631\t                (*out).t = fmul(A.t, t3);\n632\t                (*out).n = c2V(0.0, 1.0);\n633\t            }\n634\t        }\n635\t        1\n636\t    } else {\n637\t        0\n638\t    }\n639\t}\n640\t\n641\t/