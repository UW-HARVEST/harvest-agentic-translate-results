printf(\"%02x\", ((const unsigned char *)a)[i]);\n            printf(\" R=\");\n            for (size_t i = 0; i < n; i++) printf(\"%02x\", ((const unsigned char *)b)[i]);\n            printf(\"\\n\");\n        }\n    }\n}\n\n/* xorshift PRNG for reproducibility */\nstatic uint64_t st = 88172645463325252ULL;\nstatic uint64_t rnd(void) { st ^= st << 13; st ^= st >> 7; st ^= st << 17; return st; }\n\nstatic float rf(void) {\n    switch (rnd() % 16) {\n    case 0: return 0.0f;\n    case 1: return -0.0f;\n    case 2: return 1.0f;\n    case 3: return -1.0f;\n    case 4: return (float)INFINITY_HACK;\n    case 5: return -(float)INFINITY_HACK;\n    case 6: { uint32_t u = 0x7fc00000u | (uint32_t)(rnd() & 0x3fffffu); float f; memcpy(&f,&u,4); return f; }\n    case 7: { uint32_t u = (uint32_t)(rnd() & 0x007fffffu); float f; memcpy(&f,&u,4); return f; } /* denormal */\n    case 8: { uint32_t u = (uint32_t)rnd(); float f; memcpy(&f,&u,4); return f; }               /* any bits */\n    default: break;\n    }\n    /* general finite values, mixed magnitude */\n    double m = (double)(rnd() % 2000001) / 1000.0 - 1000.0;\n    int e = (int)(rnd() % 9) - 4;\n    double s = m;\n    while (e > 0) { s *= 16.0; e--; }\n    while (e < 0) { s /= 16.0; e++; }\n    return (float)s;\n}\nstatic c2v rv(void) { c2v a; a.x = rf(); a.y = rf(); return a; }\n\nint main(void) {\n    hc = dlopen(getenv(\"CLIB\"), RTLD_NOW | RTLD_LOCAL);\n    if (!hc) { printf(\"dlopen C failed: %s\\n\", dlerror()); return 2; }\n    hr = dlopen(getenv(\"RLIB\"), RTLD_NOW | RTLD_LOCAL);\n    if (!hr) { printf(\"dlopen R failed: %s\\n\", dlerror()); return 2; }\n\n    const char *names[] = {\n        \"c2V\",\"c2Dot\",\"c2Len\",\"c2Add\",\"c2Sub\",\"c2Mulvs\",\"c2Div\",\"c2Norm\",\"c2Minv\",\n        \"c2Maxv\",\"c2Skew\",\"c2Absv\",\"c2CCW90\",\"c2MulmvT\",\"c2RotIdentity\",\"c2xIdentity\",\n        \"c2Mulrv\",\"c2MulrvT\",\"c2MulxvT\",\"c2AABBtoAABB\",\"c2AABBtoPoint\",\"c2CircleToPoint\",\n        \"c2RaytoCircle\",\"c2