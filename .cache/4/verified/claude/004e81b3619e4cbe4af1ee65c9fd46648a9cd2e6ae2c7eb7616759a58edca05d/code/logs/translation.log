\n    case 2: return 1.0f;\n    case 3: return -1.0f;\n    case 4: return (float)INFINITY_HACK;\n    default: break;\n    }\n    /* general finite values, mixed magnitude */\n    double m = (double)(rnd() % 2000001) / 1000.0 - 1000.0;\n    int e = (int)(rnd() % 9) - 4;\n    double s = m;\n    while (e > 0) { s *= 16.0; e--; }\n    while (e < 0) { s /= 16.0; e++; }\n    return (float)s;\n}\nstatic c2v rv(void) { c2v a; a.x = rf(); a.y = rf(); return a; }\n\nint main(void) {\n    hc = dlopen(getenv(\"CLIB\"), RTLD_NOW | RTLD_LOCAL);\n    if (!hc) { printf(\"dlopen C failed: %s\\n\", dlerror()); return 2; }\n    hr = dlopen(getenv(\"RLIB\"), RTLD_NOW | RTLD_LOCAL);\n    if (!hr) { printf(\"dlopen R failed: %s\\n\", dlerror()); return 2; }\n\n    const char *names[] = {\n        \"c2V\",\"c2Dot\",\"c2Len\",\"c2Add\",\"c2Sub\",\"c2Mulvs\",\"c2Div\",\"c2Norm\",\"c2Minv\",\n        \"c2Maxv\",\"c2Skew\",\"c2Absv\",\"c2CCW90\",\"c2MulmvT\",\"c2RotIdentity\",\"c2xIdentity\",\n        \"c2Mulrv\",\"c2MulrvT\",\"c2MulxvT\",\"c2AABBtoAABB\",\"c2AABBtoPoint\",\"c2CircleToPoint\",\n        \"c2RaytoCircle\",\"c2RaytoAABB\",\"c2RaytoCapsule\",\"c2RaytoPoly\",\"c2CastRay\",\"poly_ray\"\n    };\n    for (unsigned i = 0; i < sizeof(names)/sizeof(*names); i++) {\n        if (!dlsym(hc, names[i])) { printf(\"C missing %s\\n\", names[i]); return 3; }\n        if (!dlsym(hr, names[i])) { printf(\"R missing %s\\n\", names[i]); return 3; }\n    }\n    printf(\"all 28 symbols resolvable in both libs\\n\");\n\n    /* ---- poly_ray (the public entry point) ---- */\n    {\n        c2Raycast a1, a2, b1, b2;\n        memset(&a1, 0xAA, sizeof a1); memset(&a2, 0xAA, sizeof a2);\n        memset(&b1, 0xAA, sizeof b1); memset(&b2, 0xAA, sizeof b2);\n        int rc = ((fn_i_pp)SYM(hc, \"poly_ray\"))(&a1, &a2);\n        int rr = ((fn_i_pp)SYM(hr, \"poly_ray\"))(&b1, &b2);\n        cmp(\"poly_ray:ret\", &rc, &rr, sizeof rc);\n        cmp(\"poly_ray:cast1\", &a1, &b1, sizeof a1);\n        cmp(\"poly_ray:cast2\", &a2, &b2, sizeof a2);\n        printf(\"poly_ray -> %d ; cast1={t=%.9g n=(%.9g,%.9g)} cast2={t=%.9g n=(%.9g,%.9g)}\\n\",\n               rc, a1.t, a1.n.x, a1.n.y, a2.t, a2.n.x, a2.n.y);\n    }\n\n    /* ---- scalar / vector helpers ---- */\n    {\n        fn_r_void fc = (fn_r_void)SYM(hc, \"c2RotIdentity\"), fr = (fn_r_void)SYM(hr, \"c2RotIdentity\");\n        c2r x = fc(), y = fr(); cmp(\"c2RotIdentity\", &x, &y, sizeof x);\n        fn_x_void gc = (fn_x_void)SYM(hc, \"c2xIdentity\"), gr = (fn_x_void)SYM(hr, \"c2xIdentity\");\n        c2x u = gc(), w = gr(); cmp(\"c2xIdentity\", &u, &w, sizeof u);\n    }\n\n    for (long it = 0; it < 300000; it++) {\n        c2v a = rv(), b = rv();\n        float s = rf();\n\n        { c2v p = ((fn_v_ff)SYM(hc,\"c2V\"))(a.x,a.y), q = ((fn_v_ff)SYM(hr,\"c2V\"))(a.x,a.y); cmp(\"c2V\",&p,&q,sizeof p); }\n        { float p = ((fn_f_vv)SYM(hc,\"c2Dot\"))(a,b), q = ((fn_f_vv)SYM(hr,\"c2Dot\"))(a,b); cmp(\"c2Dot\",&p,&q,sizeof p); }\n        { float p = ((fn_f_v)SYM(hc,\"c2Len\"))(a), q = ((fn_f_v)SYM(hr,\"c2Len\"))(a); cmp(\"c2Len\",&p,&q,sizeof p); }\n        { c2v p = ((fn_v_vv)SYM(hc,\"c2Add\"))(a,b), q = ((fn_v_vv)SYM(hr,\"c2Add\"))(a,b); cmp(\"c2Add\",&p,&q,sizeof p); }\n        { c2v p = ((fn_v_vv)SYM(hc,\"c2Sub\"))(a,b), q = ((fn_v_vv)SYM(hr,\"c2Sub\"))(a,b); cmp(\"c2Sub\",&p,&q,sizeof p); }\n        { c2v p = ((fn_v_vf)SYM(hc,\"c2Mulvs\"))(a,s), q = ((fn_v_vf)SYM(hr,\"c2Mulvs\"))(a,s); cmp(\"c2Mulvs\",&p,&q,sizeof p); }\n        { c2v p = ((fn_v_vf)SYM(hc,\"c2Div\"))(a,s), q = ((fn_v_vf)SYM(hr,\"c2Div\"))(a,s); cmp(\"c2Div\",&p,&q,sizeof p); }\n        { c2v p = ((fn_v_v)SYM(hc,\"c2Norm\"))(a), q = ((fn_v_v)SYM(hr,\"c2Norm\"))(a); cmp(\"c2Norm\",&p,&q,sizeof p); }\n        { c2v p = ((fn_v_vv)SYM(hc,\"c2Minv\"))(a,b), q = ((fn_v_vv)SYM(hr,\"c2Minv\"))(a,b); cmp(\"c2Minv\",&p,&q,sizeof p); }\n        { c2v p = ((fn_v_vv)SYM(hc,\"c2Maxv\"))(a,b), q = ((fn_v_vv)SYM(hr,\"c2Maxv\"))(a,b); cmp(\"c2Maxv\",&p,&q,sizeof p); }\n        { c2v p = ((fn_v_v)SYM(hc,\"c2Skew\"))(a), q = ((fn_v_v)SYM(hr,\"c2Skew\"))(a); cmp(\"c2Skew\",&p,&q,sizeof p); }\n        { c2v p = ((fn_v_v)SYM(hc,\"c2Absv\"))(a), q = ((fn_v_v)SYM(hr,\"c2Absv\"))(a); cmp(\"c2Absv\",&p,&q,sizeof p); }\n        { c2v p = ((fn_v_v)SYM(hc,\"c2CCW90\"))(a), q = ((fn_v_v)SYM(hr,\"c2CCW90\"))(a); cmp(\"c2CCW90\",&p,&q,sizeof p); }\n        { c2m m; m.x = a; m.y = b; c2v t = rv();\n          c2v p = ((fn_v_mv)SYM(hc,\"c2MulmvT\"))(m,t), q = ((fn_v_mv)SYM(hr,\"c2MulmvT\"))(m,t); cmp(\"c2MulmvT\",&p,&q,sizeof p); }\n        { c2r r; r.c = rf(); r.s = rf();\n          c2v p = ((fn_v_rv)SYM(hc,\"c2Mulrv\"))(r,a), q = ((fn_v_rv)SYM(hr,\"c2Mulrv\"))(r,a); cmp(\"c2Mulrv\",&p,&q,sizeof p);\n          c2v p2 = ((fn_v_rv)SYM(hc,\"c2MulrvT\"))(r,a), q2 = ((fn_v_rv)SYM(hr,\"c2MulrvT\"))(r,a); cmp(\"c2MulrvT\",&p2,&q2,sizeof p2);\n          c2x xx; xx.p = b; xx.r = r;\n          c2v p3 = ((fn_v_xv)SYM(hc,\"c2MulxvT\"))(xx,a), q3 = ((fn_v_xv)SYM(hr,\"c2MulxvT\"))(xx,a); cmp(\"c2MulxvT\",&p3,&q3,sizeof p3); }\n\n        c2AABB A, B; A.min = rv(); A.max = rv(); B.min = rv(); B.max = rv();\n        { int p = ((fn_i_bb)SYM(hc,\"c2AABBtoAABB\"))(A,B), q = ((fn_i_bb)SYM(hr,\"c2AABBtoAABB\"))(A,B); cmp(\"c2AABBtoAABB\",&p,&q,sizeof p); }\n        { int p = ((fn_i_bv)SYM(hc,\"c2AABBtoPoint\"))(A,a), q = ((fn_i_bv)SYM(hr,\"c2AABBtoPoint\"))(A,a); cmp(\"c2AABBtoPoint\",&p,&q,sizeof p); }\n        c2Circle C; C.p = rv(); C.r = rf();\n        { int p = ((fn_i_cv)SYM(hc,\"c2CircleToPoint\"))(C,a), q = ((fn_i_cv)SYM(hr,\"c2CircleToPoint\"))(C,a); cmp(\"c2CircleToPoint\",&p,&q,sizeof p); }\n\n        c2Ray R; R.p = rv(); R.d = ((fn_v_v)SYM(hc,\"c2Norm\"))(rv()); R.t = rf();\n        c2Raycast oc, orr;\n        memset(&oc, 0x5A, sizeof oc); memset(&orr, 0x5A, sizeof orr);\n        { int p = ((fn_i_rayc)SYM(hc,\"c2RaytoCircle\"))(R,C,&oc), q = ((fn_i_rayc)SYM(hr,\"c2RaytoCircle\"))(R,C,&orr);\n          cmp(\"c2RaytoCircle:ret\",&p,&q,sizeof p); cmp(\"c2RaytoCircle:out\",&oc,&orr,sizeof oc); }\n        memset(&oc, 0x5A, sizeof oc); memset(&orr, 0x5A, sizeof orr);\n        { int p = ((fn_i_rayb)SYM(hc,\"c2RaytoAABB\"))(R,B,&oc), q = ((fn_i_rayb)SYM(hr,\"c2RaytoAABB\"))(R,B,&orr);\n          cmp(\"c2RaytoAABB:ret\",&p,&q,sizeof p); cmp(\"c2RaytoAABB:out\",&oc,&orr,sizeof oc); }\n        c2Capsule K; K.a = rv(); K.b = rv(); K.r = rf();\n        memset(&oc, 0x5A, sizeof oc); memset(&orr, 0x5A, sizeof orr);\n        { int p = ((fn_i_rayk)SYM(hc,\"c2RaytoCapsule\"))(R,K,&oc), q = ((fn_i_rayk)SYM(hr,\"c2RaytoCapsule\"))(R,K,&orr);\n          cmp(\"c2RaytoCapsule:ret\",&p,&q,sizeof p); cmp(\"c2RaytoCapsule:out\",&oc,&orr,sizeof oc); }\n\n        /* random convex-ish polygon (correctness of shape is irrelevant, both\n         * libs must agree bit-for-bit) */\n        c2Poly P; memset(&P, 0, sizeof P);\n        P.count = (int)(rnd() % 9);\n        for (int i = 0; i < 8; i++) { P.verts[i] = rv(); P.norms[i] = ((fn_v_v)SYM(hc,\"c2Norm\"))(rv()); }\n        c2x bx; bx.p = rv(); { c2v n = ((fn_v_v)SYM(hc,\"c2Norm\"))(rv()); bx.r.c = n.x; bx.r.s = n.y; }\n        const c2x *bxp = (rnd() & 1) ? &bx : NULL;\n        memset(&oc, 0x5A, sizeof oc); memset(&orr, 0x5A, sizeof orr);\n        { int p = ((fn_i_rayp)SYM(hc,\"c2RaytoPoly\"))(R,&P,bxp,&oc), q = ((fn_i_rayp)SYM(hr,\"c2RaytoPoly\"))(R,&P,bxp,&orr);\n          cmp(\"c2RaytoPoly:ret\",&p,&q,sizeof p); cmp(\"c2RaytoPoly:out\",&oc,&orr,sizeof oc); }\n\n        /* c2CastRay across all four type tags plus an invalid tag */\n        for (unsigned ty = 0; ty < 5; ty++) {\n            const void *obj;\n            switch (ty) {\n            case 0: obj = &C; break;\n            case 1: obj = &B; break;\n            case 2: obj = &K; break;\n            default: obj = &P; break;\n            }\n            memset(&oc, 0x5A, sizeof oc); memset(&orr, 0x5A, sizeof orr);\n            int p = ((fn_i_cast)SYM(hc,\"c2CastRay\"))(R,obj,bxp,ty,&oc);\n            int q = ((fn_i_cast)SYM(hr,\"c2CastRay\"))