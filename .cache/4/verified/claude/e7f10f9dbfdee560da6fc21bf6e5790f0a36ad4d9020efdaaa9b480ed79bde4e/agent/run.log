0\t/// `stbds_temp(t) = v`\n181\t#[inline]\n182\tunsafe fn stbds_temp_set(t: *mut c_void, v: isize) {\n183\t    (*stbds_header(t)).temp = v;\n184\t}\n185\t\n186\t/// `stbds_temp_key(t) = v`  (== `*(char **) stbds_header(t)->hash_table = v`)\n187\t#[inline]\n188\tunsafe fn stbds_temp_key_set(t: *mut c_void, v: *mut c_char) {\n189\t    let ht = (*stbds_header(t)).hash_table as *mut *mut c_char;\n190\t    *ht = v;\n191\t}\n192\t\n193\t/// `stbds_hash_table(a)` == `((stbds_hash_index *) stbds_header(a)->hash_table)`\n194\t#[inline]\n195\tunsafe fn stbds_hash_table(a: *mut c_void) -> *mut stbds_hash_index {\n196\t    (*stbds_header(a)).hash_table as *mut stbds_hash_index\n197\t}\n198\t\n199\t#[inline]\n200\tfn byte_ptr(p: *mut c_void, off: usize) -> *mut u8 {\n201\t    (p as *mut u8).wrapping_add(off)\n202\t}\n203\t\n204\t#[inline]\n205\tunsafe fn c_memset(p: *mut c_void, value: u8, n: usize) {\n206\t    ptr::write_bytes(p as *mut u8, value, n);\n207\t}\n208\t\n209\t#[inline]\n210\tunsafe fn c_memmove(dst: *mut c_void, src: *const c_void, n: usize) {\n211\t    ptr::copy(src as *const u8, dst as *mut u8, n);\n212\t}\n213\t\n214\t#[inline]\n215\tunsafe fn c_memcmp(a: *const c_void, b: *const c_void, n: usize) -> c_int {\n216\t    let mut i = 0usize;\n217\t    while i < n {\n218\t        let x = *(a as *const u8).add(i);\n219\t        let y = *(b as *const u8).add(i);\n220\t        if x != y {\n221\t            return x as c_int - y as c_int;\n222\t        }\n223\t        i += 1;\n224\t    }\n225\t    0\n226\t}\n227\t\n228\t#[inline]\n229\tunsafe fn c_strcmp(a: *const c_char, b: *const c_char) -> c_int {\n230\t    let mut i = 0usize;\n231\t    loop {\n232\t        let x = *(a as *const u8).add(i);\n233\t        let y = *(b as *const u8).add(i);\n234\t        if x != y {\n235\t            return x as c_int - y as c_int;\n236\t        }\n237\t        if x == 0 {\n238\t            return 0;\n239\t        }\n240\t        i += 1;\n241\t    }\n242\t}\n243\t\n244\t#[inline]\n245\tunsafe fn c_strlen(s: *const c_char) -> usize {\n246\t    let mut n = 0usize;\n247\t    while *(s as *const u8).add(n) != 0 {\n248\t        n += 1;\n249\t    }\n250\t    n\n251\t}\n252\t\n253\t#[inline]\n254\tfn stbds_rotate_left(val: usize, n: u32) -> usize {\n255\t    (val << n) | (val >> (STBDS_SIZE_T_BITS - n))\n256\t}\n257\t\n258\t#[inline]\n259\tfn stbds_rotate_right(val: usize, n: u32) -> usize {\n260\t    (val >> n) | (val << (STBDS_SIZE_T_BITS - n))\n261\t}\n262\t\n263\t// ---------------------------------------------------------------------------\n264\t// stbds_arrgrowf / stbds_arrfreef\n265\t// ---------------------------------------------------------------------------\n266\t\n267\t#[unsafe(no_mangle)]\n268\tpub unsafe extern \"C\" fn stbds_arrgrowf(\n269\t    a: *mut c_void,\n270\t    elemsize: usize,\n271\t    addlen: usize,\n272\t    min_cap: usize,\n273\t) -> *mut c_void {\n274\t    let mut min_cap = min_cap;\n275\t    let mut b: *mut c_void;\n276\t    // size_t min_len = stbds_arrlen(a) + addlen;\n277\t    let min_len = (stbds_arrlen(a) as usize).wrapping_add(addlen);\n278\t\n279\t    if min_len > min_cap {\n280\t        min_cap = min_len;\n281\t    }\n282\t\n283\t    if min_cap <= stbds_arrcap(a) {\n284\t        return a;\n285\t    }\n286\t\n287\t    if min_cap < 2usize.wrapping_mul(stbds_arrcap(a)) {\n288\t        min_cap = 2usize.wrapping_mul(stbds_arrcap(a));\n289\t    } else if min_cap < 4 {\n290\t        min_cap = 4;\n291\t    }\n292\t\n293\t    b = stbds_realloc(\n294\t        if !a.is_null() {\n295\t            stbds_header(a) as *mut c_void\n296\t        } else {\n297\t            ptr::null_mut()\n298\t        },\n299\t        elemsize.wrapping_mul(min_cap).wrapping_add(HEADER_SIZE),\n300\t    );\n301\t    b = (b as *mut u8).wrapping_add(HEADER_SIZE) as *mut c_void;\n302\t    if a.is_null() {\n303\t        (*stbds_header(b)).length = 0;\n304\t        (*stbds_header(b)).hash_table = ptr::null_mut();\n305\t        (*stbds_header(b)).temp = 0;\n306\t    } else {\n307\t        // STBDS_STATS(++stbds_array_grow);\n308\t    }\n309\t    (*stbds_header(b)).capacity = min_cap;\n310\t\n311\t    b\n312\t}\n313\t\n314\t#[unsafe(no_mangle)]\n315\tpub unsafe extern \"C\" fn stbds_arrfreef(a: *mut c_void) {\n316\t    stbds_free(stbds_header(a) as *mut c_void);\n317\t}\n318\t\n319\t// ---------------------------------------------------------------------------\n320\t// hash seed / hash index\n321\t// ---------------------------------------------------------------------------\n322\t\n323\tstatic mut stbds_hash_seed: usize = 0x31415926;\n324\t\n325\t#[unsafe(no_mangle)]\n326\tpub unsafe extern \"C\" fn stbds_rand_seed(seed: usize) {\n327\t    stbds_hash_seed = seed;\n328\t}\n329\t\n330\t#[inline]\n331\tfn stbds_probe_position(hash: usize, slot_count: usize, _slot_log2: usize) -> usize {\n332\t    hash & (slot_count.wrapping_sub(1))\n333\t}\n334\t\n335\tfn stbds_log2(slot_count: usize) -> usize {\n336\t    let mut slot_count = slot_count;\n337\t    let mut n: usize = 0;\n338\t    while slot_count > 1 {\n339\t        slot_count >>= 1;\n340\t        n += 1;\n341\t    }\n342\t    n\n343\t}\n344\t\n345\t/// `STBDS_ALIGN_FWD(n, a)` == `(((n) + (a) - 1) & ~((a)-1))`\n346\t#[inline]\n347\tfn stbds_align_fwd(n: usize, a: usize) -> usize {\n348\t    n.wrapping_add(a).wrapping_sub(1) & !(a.wrapping_sub(1))\n349\t}\n350\t\n351\tunsafe fn stbds_make_hash_index(\n352\t    slot_count: usize,\n353\t    ot: *mut stbds_hash_index,\n354\t) -> *mut stbds_hash_index {\n355\t    let t: *mut stbds_hash_index = stbds_realloc(\n356\t        ptr::null_mut(),\n357\t        (slot_count >> STBDS_BUCKET_SHIFT)\n358\t            .wrapping_mul(size_of::<stbds_hash_bucket>())\n359\t            .wrapping_add(size_of::<stbds_hash_index>())\n360\t            .wrapping_add(STBDS_CACHE_LINE_SIZE - 1),\n361\t    ) as *mut stbds_hash_index;\n362\t\n363\t    (*t).storage =\n364\t        stbds_align_fwd(t.wrapping_add(1) as usize, STBDS_CACHE_LINE_SIZE) as *mut stbds_hash_bucket;\n365\t    (*t).slot_count = slot_count;\n366\t    (*t).slot_count_log2 = stbds_log2(slot_count);\n367\t    (*t).tombstone_count = 0;\n368\t    (*t).used_count = 0;\n369\t\n370\t    (*t).used_count_threshold = slot_count.wrapping_sub(slot_count >> 2);\n371\t    (*t).tombstone_count_threshold = (slot_count >> 3).wrapping_add(slot_count >> 4);\n372\t    (*t).used_count_shrink_threshold = slot_count >> 2;\n373\t\n374\t    if slot_count <= STBDS_BUCKET_LENGTH {\n375\t        (*t).used_count_shrink_threshold = 0;\n376\t    }\n377\t    // STBDS_ASSERT(t->used_count_threshold + t->tombstone_count_threshold < t->slot_count);\n378\t    stbds_assert(\n379\t        (*t)\n380\t            .used_count_threshold\n381\t            .wrapping_add((*t).tombstone_count_threshold)\n382\t            < (*t).slot_count,\n383\t    );\n384\t\n385\t    if !ot.is_null() {\n386\t        (*t).string = (*ot).string;\n387\t        (*t).seed = (*ot).seed;\n388\t    } else {\n389\t        c_memset(\n390\t            (&mut (*t).string) as *mut stbds_string_arena as *mut c_void,\n391\t            0,\n392\t            size_of::<stbds_string_arena>(),\n393\t        );\n394\t        (*t).seed = stbds_hash_seed;\n395\t        // stbds_load_32_or_64(a, temp, 2147001325, 0x27bb2ee6, 0x87b0b0fd);\n396\t        let a = stbds_load_32_or_64(2147001325u32, 0x27bb2ee6u32, 0x87b0b0fdu32);\n397\t        // stbds_load_32_or_64(b, temp,  715136305,          0, 0xb504f32d);\n398\t        let b = stbds_load_32_or_64(715136305u32, 0u32, 0xb504f32du32);\n399\t        stbds_hash_seed = stbds_hash_seed.wrapping_mul(a).wrapping_add(b);\n400\t    }\n401\t\n402\t    {\n403\t        let mut i: usize = 0;\n404\t        while i < slot_count >> STBDS_BUCKET_SHIFT {\n405\t            let b: *mut stbds_hash_bucket = (*t).storage.add(i);\n406\t            let mut j: usize = 0;\n407\t            while j < STBDS_BUCKET_LENGTH {\n408\t                (*b).hash[j] = STBDS_HASH_EMPTY;\n409\t                j += 1;\n410\t            }\n411\t            j = 0;\n412\t            while j < STBDS_BUCKET_LENGTH {\n413\t                (*b).index[j] = STBDS_INDEX_EMPTY;\n414\t                j += 1;\n415\t            }\n416\t            i += 1;\n417\t        }\n418\t    }\n419\t\n420\t    if !ot.is_null() {\n421\t        (*t).used_count = (*ot).used_count;\n422\t        let mut i: usize = 0;\n423\t        while i < (*ot).slot_count >> STBDS_BUCKET_SHIFT {\n424\t            let ob: *mut stbds_hash_bucket = (*ot).storage.add(i);\n425\t            let mut j: usize = 0;\n426\t            while j < STBDS_BUCKET_LENGTH {\n427\t                if STBDS_INDEX_IN_USE((*ob).index[j]) {\n428\t                    let hash = (*ob).hash[j];\n429\t                    let mut pos =\n430\t                        stbds_probe_position(hash, (*t).slot_count, (*t).slot_count_log2);\n431\t                    let mut step = STBDS_BUCKET_LENGTH;\n432\t                    'done: loop {\n433\t                        let bucket: *mut stbds_hash_bucket =\n434\t                            (*t).storage.add(pos >> STBDS_BUCKET_SHIFT);\n435\t\n436\t                        let mut z = pos & STBDS_BUCKET_MASK;\n437\t                        while z < STBDS_BUCKET_LENGTH {\n438\t                            if (*bucket).hash[z] == 0 {\n439\t                                (*bucket).hash[z] = hash;\n440\t                                (*bucket).index[z] = (*ob).index[j];\n441\t                                break 'done;\n442\t                            }\n443\t                            z += 1;\n444\t                        }\n445\t\n446\t                        let limit = pos & STBDS_BUCKET_MASK;\n447\t                        z = 0;\n448\t                        while z < limit {\n449\t                            if (*bucket).hash[z] == 0 {\n450\t                                (*bucket).hash[z] = hash;\n451\t                                (*bucket).index[z] = (*ob).index[j];\n452\t                                break 'done;\n453\t                            }\n454\t                            z += 1;\n455\t                        }\n456\t\n457\t                        pos = pos.wrapping_add(step);\n458\t                        step = step.wrapping_add(STBDS_BUCKET_LENGTH);\n459\t                        pos &= (*t).slot_count.wrapping_sub(1);\n460\t                    }\n461\t                }\n462\t                j += 1;\n463\t            }\n464\t            i += 1;\n465\t        }\n466\t    }\n467\t\n468\t    t\n469\t}\n470\t\n471\t/// ```c\n472\t/// #define stbds_load_32_or_64(var, temp, v32, v64_hi, v64_lo)     \\\n473\t///   temp = v64_lo ^ v32, temp <<= 16, temp <<= 16, temp >>= 16, temp >>= 16, \\\n474\t///   var = v64_hi, var <<= 16, var <<= 16,                         \\\n475\t///   var ^= temp ^ v32\n476\t/// ```\n477\t/// Note: `v64_lo ^ v32` is computed in 32-bit `unsigned int` arithmetic in C\n478\t/// (the hex literals do not fit in `int`, the decimal ones do), then widened.\n479\t#[inline]\n480\tfn stbds_load_32_or_64(v32: u32, v64_hi: u32, v64_lo: u32) -> usize {\n481\t    let mut temp: usize = (v64_lo ^ v32) as usize;\n482\t    temp <<= 16;\n483\t    temp <<= 16;\n484\t    temp >>= 16;\n485\t    temp >>= 16;\n486\t    let mut var: usize = v64_hi as usize;\n487\t    var <<= 16;\n488\t    var <<= 16;\n489\t    var ^= temp ^ (v32 as usize);\n490\t    var\n491\t}\n492\t\n493\t// ---------------------------------------------------------------------------\n494\t// hash functions\n495\t// ---------------------------------------------------------------------------\n496\t\n497\t#[unsafe(no_mangle)]\n498\tpub unsafe extern \"C\" fn stbds_hash_string(str_: *mut c_char, seed: usize) -> usize {\n499\t    let mut hash: usize = seed;\n500\t    let mut str_ = str_ as *const u8;\n501\t    while *str_ != 0 {\n502\t        hash = stbds_rotate_left(hash, 9).wrapping_add(*str_ as usize);\n503\t        str_ = str_.add(1);\n504\t    }\n505\t\n506\t    hash ^= seed;\n507\t    hash = (!hash).wrapping_add(hash << 18);\n508\t    hash ^= hash ^ stbds_rotate_right(hash, 31);\n509\t    hash = hash.wrapping_mul(21);\n510\t    hash ^= hash ^ stbds_rotate_right(hash, 11);\n511\t    hash = hash.wrapping_add(hash << 6);\n512\t    hash ^= stbds_rotate_right(hash, 22);\n513\t    hash.wrapping_add(seed)\n514\t}\n515\t\n516\tconst STBDS_SIPHASH_C_ROUNDS: usize = 2;\n517\tconst STBDS_SIPHASH_D_ROUNDS: usize = 4;\n518\t\n519\tmacro_rules! stbds_sipround {\n520\t    ($v0:expr, $v1:expr, $v2:expr, $v3:expr) => {{\n521\t        $v0 = $v0.wrapping_add($v1);\n522\t        $v1 = stbds_rotate_left($v1, 13);\n523\t        $v1 ^= $v0;\n524\t        $v0 = stbds_rotate_left($v0, STBDS_SIZE_T_BITS / 2);\n525\t        $v2 = $v2.wrapping_add($v3);\n526\t        $v3 = stbds_rotate_left($v3, 16);\n527\t        $v3 ^= $v2;\n528\t        $v2 = $v2.wrapping_add($v1);\n529\t        $v1 = stbds_rotate_left($v1, 17);\n530\t        $v1 ^= $v2;\n531\t        $v2 = stbds_rotate_left($v2, STBDS_SIZE_T_BITS / 2);\n532\t        $v0 = $v0.wrapping_add($v3);\n533\t        $v3 = stbds_rotate_left($v3, 21);\n534\t        $v3 ^= $v0;\n535\t    }};\n536\t}\n537\t\n538\tunsafe fn stbds_siphash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n539\t    let mut d = p as *const u8;\n540\t    let mut i: usize;\n541\t    let mut j: usize;\n542\t    let mut v0: usize;\n543\t    let mut v1: usize;\n544\t    let mut v2: usize;\n545\t    let mut v3: usize;\n546\t    let mut data: usize;\n547\t\n548\t    v0 = ((((0x736f6d65usize << 16) << 16).wrapping_add(0x70736575)) ^ seed) as usize;\n549\t    v1 = ((((0x646f7261usize << 16) << 16).wrapping_add(0x6e646f6d)) ^ !seed) as usize;\n550\t    v2 = ((((0x6c796765usize << 16) << 16).wrapping_add(0x6e657261)) ^ seed) as usize;\n551\t    v3 = ((((0x74656462usize << 16) << 16).wrapping_add(0x79746573)) ^ !seed) as usize;\n552\t\n553\t    v0 ^= 0x0706050403020100u64 as usize ^ seed;\n554\t    v1 ^= 0x0f0e0d0c0b0a0908u64 as usize ^ !seed;\n555\t    v2 ^= 0x