    break;\n178\t        }\n179\t\n180\t        count = count.wrapping_add(1);\n181\t        ffi::printf(cstr(FMT_LOG_MEMCHR_FOUND), count);\n182\t\n183\t        // `remaining -= (found - ptr + 1);` — unsigned (size_t) arithmetic.\n184\t        remaining = remaining.wrapping_sub((found.offset_from(ptr_cur) as usize).wrapping_add(1));\n185\t        ptr_cur = found.add(1);\n186\t    }\n187\t\n188\t    count\n189\t}\n190\t\n191\t// ---------------------------------------------------------------------------\n192\t// void update_flags(ProcessState* state, int param)\n193\t// ---------------------------------------------------------------------------\n194\t\n195\t/// ```c\n196\t/// void update_flags(ProcessState* state, int param) { ... }\n197\t/// ```\n198\t#[unsafe(no_mangle)]\n199\tpub unsafe extern \"C\" fn update_flags(state: *mut ProcessState, param: c_int) {\n200\t    if state.is_null() {\n201\t        return;\n202\t    }\n203\t\n204\t    let flags = &mut (*state).flags;\n205\t\n206\t    // 5-bit counter\n207\t    let next_counter = (flags.counter().wrapping_add(1)) & 0x1F;\n208\t    flags.set_counter(next_counter);\n209\t    flags.set_flag1((param & 1) as u32);\n210\t    flags.set_flag2(((param & 2) >> 1) as u32);\n211\t    flags.set_flag3(((param & 4) >> 2) as u32);\n212\t    // Arithmetic right shift, matching gcc's `>>` on a signed int.\n213\t    flags.set_mode(((param >> 3) & 0x7) as u32);\n214\t\n215\t    ffi::printf(cstr(FMT_DEBUG_COUNTER), flags.counter() as c_int);\n216\t    ffi::printf(\n217\t        cstr(FMT_BIT_FIELDS),\n218\t        flags.flag1() as c_int,\n219\t        flags.flag2() as c_int,\n220\t        flags.flag3() as c_int,\n221\t        flags.mode() as c_int,\n222\t    );\n223\t}\n224\t\n225\t// ---------------------------------------------------------------------------\n226\t// int confuse_types(ProcessState* state, int operation)\n227\t// ---------------------------------------------------------------------------\n228\t\n229\t/// ```c\n230\t/// int confuse_types(ProcessState* state, int operation) { ... }\n231\t/// ```\n232\t#[unsafe(no_mangle)]\n233\tpub unsafe extern \"C\" fn confuse_types(state: *mut ProcessState, operation: c_int) -> c_int {\n234\t    if state.is_null() {\n235\t        return 0;\n236\t    }\n237\t\n238\t    let mut result: c_int = 0;\n239\t\n240\t    match operation {\n241\t        0 => {\n242\t            (*state).data.int_val = 1078530011;\n243\t            ffi::printf(cstr(FMT_SET_AS_INT), (*state).data.int_val);\n244\t        }\n245\t\n246\t        1 => {\n247\t            // `%f` promotes the float to double.\n248\t            ffi::printf(cstr(FMT_READ_AS_FLOAT), (*state).data.float_val as f64);\n249\t            // gcc emits `mulss` (single precision) followed by `cvttss2si`.\n250\t            result = cvttss2si((*state).data.float_val * 100.0f32);\n251\t        }\n252\t\n253\t        2 => {\n254\t            ffi::printf(cstr(FMT_READ_AS_UINT), (*state).data.uint_val);\n255\t            result = ((*state).data.uint_val & 0xFF) as c_int;\n256\t        }\n257\t\n258\t        3 => {\n259\t            let bytes = (*state).data.bytes;\n260\t            ffi::printf(\n261\t                cstr(FMT_READ_AS_BYTES),\n262\t                // `char` promotes to `int` (sign-extended: char is signed here).\n263\t                bytes[0] as c_int,\n264\t                bytes[1] as c_int,\n265\t                bytes[2] as c_int,\n266\t                bytes[3] as c_int,\n267\t            );\n268\t            result = (bytes[0] as c_int).wrapping_add(bytes[1] as c_int);\n269\t        }\n270\t\n271\t        _ => {}\n272\t    }\n273\t\n274\t    result\n275\t}\n276\t\n277\t// ---------------------------------------------------------------------------\n278\t// int confusion(int param1, int param2, int param3, int param4)\n279\t// ---------------------------------------------------------------------------\n280\t\n281\t/// ```c\n282\t/// int confusion(int param1, int param2, int param3, int param4) { ... }\n283\t/// ```\n284\t#[unsafe(no_mangle)]\n285\tpub unsafe extern \"C\" fn confusion(\n286\t    param1: c_int,\n287\t    param2: c_int,\n288\t    param3: c_int,\n289\t    param4: c_int,\n290\t) -> c_int {\n291\t    ffi::printf(cstr(FMT_DEBUG_PARAM1), param1);\n292\t    ffi::printf(cstr(FMT_DEBUG_PARAM2), param2);\n293\t    ffi::printf(cstr(FMT_DEBUG_PARAM3), param3);\n294\t    ffi::printf(cstr(FMT_DEBUG_PARAM4), param4);\n295\t\n296\t    let mut result: c_int = 0;\n297\t\n298\t    let state = create_state(param1, 128);\n299\t\n300\t    if state.is_null() {\n301\t        return -1;\n302\t    }\n303\t\n304\t    update_flags(state, param2);\n305\t\n306\t    // `char search_char = '0' + (param3 % 10);` — the int result is truncated\n307\t    // to `char`.\n308\t    let search_char = (b'0' as c_int).wrapping_add(param3 % 10) as c_char;\n309\t    let found_count = process_buffer(state, search_char);\n310\t    result = result.wrapping_add(found_count.wrapping_mul(10));\n311\t\n312\t    let confusion_result = confuse_types(state, param4 % 4);\n313\t    result = result.wrapping_add(confusion_result);\n314\t\n315\t    result = result.wrapping_add(((*state).flags.counter() as c_int).wrapping_mul(5));\n316\t    result = result.wrapping_add(((*state).flags.mode() as c_int).wrapping_mul(3));\n317\t\n318\t    ffi::printf(cstr(FMT_FINAL_RESULT), result);\n319\t\n320\t    destroy_state(state);\n321\t\n322\t    result\n323\t}\n324\t"}]},"parent_tool_use_id":"toolu_bdrk_0122x2hcB3UCZxW3so2PFuAf","session_id":"0d767b69-ab62-4fa8-8e41-e4011018e1f5","uuid":"6230e38d-bd32-476b-8120-7312afbbb12d","timestamp":"2026-08-19T19:06:40.428Z","subagent_type":"general-purpose","task_description":"Audit C vs Rust semantics"}
