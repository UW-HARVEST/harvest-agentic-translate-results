ffer_t pb = (process_buffer_t) dlsym(h, \"process_buffer\");\n    update_flags_t  uf = (update_flags_t) dlsym(h, \"update_flags\");\n    confuse_types_t ct = (confuse_types_t) dlsym(h, \"confuse_types\");\n    confusion_t     cf = (confusion_t) dlsym(h, \"confusion\");\n    if (!cs||!ds||!pb||!uf||!ct||!cf) { fprintf(stderr,\"missing symbol\\n\"); return 2; }\n\n    const char* mode = argv[2];\n    if (!strcmp(mode, \"confusion\")) {\n        int r = cf(atoi(argv[3]), atoi(argv[4]), atoi(argv[5]), atoi(argv[6]));\n        printf(\"RET=%d\\n\", r);\n    } else if (!strcmp(mode, \"cs\")) {\n        ProcessState* s = cs(atoi(argv[3]), atoi(argv[4]));\n        dump_state(s);\n        if (s) ds(s);\n    } else if (!strcmp(mode, \"pb\")) {\n        /* argv[3] = buffer contents, argv[4] = target char code */\n        ProcessState* s = cs(0, 128);\n        strcpy(s->buffer, argv[3]);\n        int r = pb(s, (char)atoi(argv[4]));\n        printf(\"RET=%d\\n\", r);\n        ds(s);\n    } else if (!strcmp(mode, \"pbnull\")) {\n        printf(\"RET=%d\\n\", pb(NULL, 'a'));\n        ProcessState st; memset(&st,0,sizeof st); st.buffer = NULL;\n        printf(\"RET=%d\\n\", pb(&st, 'a'));\n    } else if (!strcmp(mode, \"uf\")) {\n        ProcessState* s = cs(atoi(argv[3]), 128);\n        int n = atoi(argv[4]);\n        for (int i = 0; i < n; i++) uf(s, atoi(argv[5]) + i);\n        dump_state(s);\n        uf(NULL, 1);\n        ds(s);\n    } else if (!strcmp(mode, \"ufraw\")) {\n        /* set raw flag bits then update_flags with given param */\n        ProcessState* s = cs(0, 128);\n        unsigned int raw = (unsigned int)strtoul(argv[3], NULL, 0);\n        memcpy(&s->flags, &raw, 4);\n        uf(s, (int)strtol(argv[4], NULL, 0));\n        dump_state(s);\n        ds(s);\n    } else if (!strcmp(mode, \"ct\")) {\n        /* argv[3] = raw union bits, argv[4] = operation */\n        ProcessState* s = cs(0, 128);\n        unsigned int raw = (unsigned int)strtoul(argv[3], NULL, 0);\n    