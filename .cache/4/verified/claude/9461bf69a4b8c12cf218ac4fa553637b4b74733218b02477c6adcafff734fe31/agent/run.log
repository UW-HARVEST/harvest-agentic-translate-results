[inline]\n51\tconst fn mask((shift, width): (u32, u32)) -> c_uint {\n52\t    (((1u64 << width) - 1) as c_uint) << shift\n53\t}\n54\t\n55\t#[inline]\n56\tconst fn get(bits: c_uint, field: (u32, u32)) -> c_uint {\n57\t    (bits & mask(field)) >> field.0\n58\t}\n59\t\n60\t#[inline]\n61\tfn set(bits: &mut c_uint, field: (u32, u32), value: c_uint) {\n62\t    let m = mask(field);\n63\t    // Storing into a bit-field keeps only the low `width` bits of the value,\n64\t    // exactly as a C truncating bit-field assignment does.\n65\t    *bits = (*bits & !m) | ((value << field.0) & m);\n66\t}\n67\t\n68\tmacro_rules! bitfield_accessors {\n69\t    ($( $name:ident / $setter:ident => $field:ident ),* $(,)?) => {\n70\t        impl PackedFlags {\n71\t            $(\n72\t                #[inline]\n73\t                pub fn $name(&self) -> c_uint {\n74\t                    get(self.bits, $field)\n75\t                }\n76\t\n77\t                #[inline]\n78\t                pub fn $setter(&mut self, value: c_uint) {\n79\t                    set(&mut self.bits, $field, value);\n80\t                }\n81\t            )*\n82\t        }\n83\t    };\n84\t}\n85\t\n86\tbitfield_accessors! {\n87\t    flag1 / set_flag1 => FLAG1,\n88\t    flag2 / set_flag2 => FLAG2,\n89\t    flag3 / set_flag3 => FLAG3,\n90\t    counter / set_counter => COUNTER,\n91\t    mode / set_mode => MODE,\n92\t    status / set_status => STATUS,\n93\t    reserved / set_reserved => RESERVED,\n94\t}\n95\t\n96\t/// ```c\n97\t/// typedef union {\n98\t///     int int_val;\n99\t///     float float_val;\n100\t///     unsigned int uint_val;\n101\t///     char bytes[4];\n102\t/// } TypeConfusion;\n103\t/// ```\n104\t#[repr(C)]\n105\t#[derive(Copy, Clone)]\n106\tpub union TypeConfusion {\n107\t    pub int_val: c_int,\n108\t    pub float_val: f32,\n109\t    pub uint_val: c_uint,\n110\t    pub bytes: [c_char; 4],\n111\t}\n112\t\n113\t/// ```c\n114\t/// typedef struct {\n115\t///     PackedFlags flags;\n116\t///     TypeConfusion data;\n117\t///     char* buffer;\n118\t///     int capacity;\n119\t/// } ProcessState;\n120\t/// ```\n121\t#[repr(C)]\n122\tpub struct ProcessState {\n123\t    pub flags: PackedFlags,\n124\t    pub data: TypeConfusion,\n125\t    pub buffer: *mut c_char,\n126\t    pub capacity: c_int,\n127\t}\n128\t\n129\t// Compile-time verification that the layouts match the gcc x86-64 SysV ones.\n130\tconst _: () = {\n131\t    use core::mem::{align_of, offset_of, size_of};\n132\t\n133\t    assert!(size_of::<PackedFlags>() == 4);\n134\t    assert!(align_of::<PackedFlags>() == 4);\n135\t\n136\t    assert!(size_of::<TypeConfusion>() == 4);\n137\t    assert!(align_of::<TypeConfusion>() == 4);\n138\t\n139\t    assert!(size_of::<ProcessState>() == 24);\n140\t    assert!(align_of::<ProcessState>() == 8);\n141\t    assert!(offset_of!(ProcessState, flags) == 0);\n142\t    assert!(offset_of!(ProcessState, data) == 4);\n143\t    assert!(offset_of!(ProcessState, buffer) == 8);\n144\t    assert!(offset_of!(ProcessState, capacity) == 16);\n145\t\n146\t    // Bit-field placement inside the storage unit.\n147\t    assert!(mask(FLAG1) == 0x0000_0001);\n148\t    assert!(mask(FLAG2) == 0x0000_0002);\n149\t    assert!(mask(FLAG3) == 0x0000_0004);\n150\t    assert!(mask(COUNTER) == 0x0000_00F8);\n151\t    assert!(mask(MODE) == 0x0000_0700);\n152\t    assert!(mask(STATUS) == 0x0000_F800);\n153\t    assert!(mask(RESERVED) == 0xFFFF_0000);\n154\t};\n155\t"}]},"parent_tool_use_id":null,"session_id":"0d767b69-ab62-4fa8-8e41-e4011018e1f5","uuid":"ee1b7724-55a6-4187-8294-ed89df7524c1","timestamp":"2026-08-19T18:47:56.725Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-b0TCSB/translated_rust/src/types.rs","content":"// Rust equivalents of the C aggregate types declared in c_src/src/lib.c.\n//\n// The layouts below are ABI-identical to what gcc produces on x86-64 SysV\n// (verified against the C build):\n//\n//   PackedFlags  : size 4, align 4\n//   TypeConfusion: size 4, align 4\n//   ProcessState : size 24, align 8; offsets flags=0 data=4 buffer=8 capacity=16\n//\n// Bit-field placement inside `PackedFlags` (little-endian, allocated from the\n// least significant bit upwards, verified with a layout probe against gcc):\n//\n//   flag1    -> 0x0000_0001 (bit  0, width  1)\n//   flag2    -> 0x0000_0002 (bit  1, width  1)\n//   flag3    -> 0x0000_0004 (bit  2, width  1)\n//   counter  -> 0x0000_00F8 (bit  3, width  5)\n//   mode     -> 0x0000_0700 (bit  8, width  3)\n//   status   -> 0x0000_F800 (bit 11, width  5)\n//   reserved -> 0xFFFF_0000 (bit 16, width 16)\n\nuse core::ffi::{c_char, c_int, c_uint};\n\n/// ```c\n/// typedef struct {\n///     unsigned int flag1 : 1;\n///     unsigned int flag2 : 1;\n///     unsigned int flag3 : 1;\n///     unsigned int counter : 5;\n///     unsigned int mode : 3;\n///     unsigned int status : 5;\n///     unsigned int reserved : 16;\n/// } PackedFlags;\n/// ```\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct PackedFlags {\n    /// The single 32-bit storage unit holding every bit-field.\n    pub bits: c_uint,\n}\n\n/// Shift / width for each bit-field of [`PackedFlags`].\nconst FLAG1: (u32, u32) = (0, 1);\nconst FLAG2: (u32, u32) = (1, 1);\nconst FLAG3: (u32, u32) = (2, 1);\nconst COUNTER: (u32, u32) = (3, 5);\nconst MODE: (u32, u32) = (8, 3);\nconst STATUS: (u32, u32) = (11, 5);\nconst RESERVED: (u32, u32) = (16, 16);\n\n#[inline]\nconst fn mask((shift, width): (u32, u32)) -> c_uint {\n    (((1u64 << width) - 1) as c_uint) << shift\n}\n\n#[inline]\nconst fn get(bits: c_uint, field: (u32, u32)) -> c_uint {\n    (bits & mask(field)) >> field.0\n}\n\n#[inline]\nfn set(bits: &mut c_uint, field: (u32, u32), value: c_uint) {\n    let m = mask(field);\n    // Storing into a bit-field keeps only the low `width` bits of the value,\n    // exactly as a C truncating bit-field assignment does.\n    *bits = (*bits & !m) | ((value << field.0) & m);\n}\n\nmacro_rules! bitfield_accessors {\n    ($(