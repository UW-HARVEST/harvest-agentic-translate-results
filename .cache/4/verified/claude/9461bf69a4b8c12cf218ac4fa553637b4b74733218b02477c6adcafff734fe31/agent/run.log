\tuse types::{PackedFlags, ProcessState, TypeConfusion};\n44\t\n45\t// ---------------------------------------------------------------------------\n46\t// Format strings, byte-for-byte as produced by the C preprocessor.\n47\t//\n48\t//   #define STRINGIFY(x) #x\n49\t//   #define DEBUG_VAR(var) printf(\"Debug: \" STRINGIFY(var) \" = %d\\n\", var)\n50\t//   #define LOG_OPERATION(op, val)\n51\t//       printf(\"Operation: \" STRINGIFY(op) \" with value %d\\n\", val)\n52\t// ---------------------------------------------------------------------------\n53\t\n54\tconst FMT_ERR_STATE_ALLOC: &[u8] = b\"Error: Failed to allocate memory for state\\n\\0\";\n55\tconst FMT_ERR_BUFFER_ALLOC: &[u8] = b\"Error: Failed to allocate buffer\\n\\0\";\n56\tconst FMT_STATE_MODE: &[u8] = b\"State:%d:Mode:%d\\0\";\n57\tconst FMT_ERR_NULL_PROCESS_BUFFER: &[u8] = b\"Error: Null pointer in process_buffer\\n\\0\";\n58\t/// `LOG_OPERATION(memchr_found, count)`\n59\tconst FMT_LOG_MEMCHR_FOUND: &[u8] = b\"Operation: memchr_found with value %d\\n\\0\";\n60\t/// `DEBUG_VAR(state->flags.counter)`\n61\tconst FMT_DEBUG_COUNTER: &[u8] = b\"Debug: state->flags.counter = %d\\n\\0\";\n62\tconst FMT_BIT_FIELDS: &[u8] = b\"Bit fields - flag1:%d flag2:%d flag3:%d mode:%d\\n\\0\";\n63\tconst FMT_SET_AS_INT: &[u8] = b\"Set as int: %d\\n\\0\";\n64\tconst FMT_READ_AS_FLOAT: &[u8] = b\"Read as float: %f\\n\\0\";\n65\tconst FMT_READ_AS_UINT: &[u8] = b\"Read as uint: %u\\n\\0\";\n66\tconst FMT_READ_AS_BYTES: &[u8] = b\"Read as bytes: [%d, %d, %d, %d]\\n\\0\";\n67\t/// `DEBUG_VAR(param1)` .. `DEBUG_VAR(param4)`\n68\tconst FMT_DEBUG_PARAM1: &[u8] = b\"Debug: param1 = %d\\n\\0\";\n69\tconst FMT_DEBUG_PARAM2: &[u8] = b\"Debug: param2 = %d\\n\\0\";\n70\tconst FMT_DEBUG_PARAM3: &[u8] = b\"Debug: param3 = %d\\n\\0\";\n71\tconst FMT_DEBUG_PARAM4: &[u8] = b\"Debug: param4 = %d\\n\\0\";\n72\tconst FMT_FINAL_RESULT: &[u8] = b\"Final result: %d\\n\\0\";\n73\t\n74\t#[inline]\n75\tconst fn cstr(bytes: &[u8]) -> *const c_char {\n76\t    bytes.as_ptr() as *const c_char\n77\t}\n78\t\n79\t// ---------------------------------------------------------------------------\n80\t// ProcessState* create_state(int initial_val, int capacity)\n81\t// ---------------------------------------------------------------------------\n82\t\n83\t/// ```c\n84\t/// ProcessState* create_state(int initial_val, int capacity) { ... }\n85\t/// ```\n86\t#[unsafe(no_mangle)]\n87\tpub unsafe extern \"C\" fn create_state(initial_val: c_int, capacity: c_int) -> *mut ProcessState {\n88\t    let state = ffi::malloc(size_of::<ProcessState>()) as *mut ProcessState;\n89\t\n90\t    if state.is_null() {\n91\t        ffi::printf(cstr(FMT_ERR_STATE_ALLOC));\n92\t        return ptr::null_mut();\n93\t    }\n94\t\n95\t    // Every one of the 32 bits of `PackedFlags` is assigned below, so building\n96\t    // the storage unit up from zero is equivalent to gcc's read-modify-write\n97\t    // sequence over the freshly malloc'd (indeterminate) bytes.\n98\t    let mut flags = PackedFlags { bits: 0 };\n99\t    flags.set_flag1(1);\n100\t    flags.set_flag2(0);\n101\t    flags.set_flag3(1);\n102\t    flags.set_counter(0);\n103\t    flags.set_mode(3);\n104\t    flags.set_status(15);\n105\t    flags.set_reserved(0);\n106\t    (*state).flags = flags;\n107\t\n108\t    (*state).data = TypeConfusion {\n109\t        int_val: initial_val,\n110\t    };\n111\t\n112\t    (*state).capacity = capacity;\n113\t    // C converts the `int` argument to `size_t`, i.e. sign-extends it; a\n114\t    // negative capacity therefore becomes a huge request and malloc fails.\n115\t    (*state).buffer = ffi::malloc(capacity as isize as usize) as *mut c_char;\n116\t\n117\t    if (*state).buffer.is_null() {\n118\t        ffi::printf(cstr(FMT_ERR_BUFFER_ALLOC));\n119\t        ffi::free(state as *mut c_void);\n120\t        return ptr::null_mut();\n121\t    }\n122\t\n123\t    ffi::snprintf(\n124\t        (*state).buffer,\n125\t        capacity as isize as usize,\n126\t        cstr