re(|| unsafe { (c.confusion)(i32::MIN, i32::MIN, cc, d) });\n            let rv = capture(|| unsafe { (r.confusion)(i32::MIN, i32::MIN, cc, d) });\n            assert_same(&ctx, cv, rv);\n        }\n    }\n}\n","structuredPatch":[{"oldStart":139,"oldLines":9,"newStart":139,"newLines":10,"lines":["     let fd = unsafe { open(path.as_ptr(), O_WRONLY | O_CREAT | O_TRUNC, 0o644) };","     assert!(fd >= 0, \"child could not open capture file\");","     assert!(unsafe { dup2(fd, 1) } >= 0);","-    // Warm up stdio (identical prefix in both children).","+    // Warm up stdio (identical prefix in both children) so that glibc has","+    // already allocated the `stdout` buffer before the heap is exhausted.","     let warm = b\"warmup\\n\\0\";","-    unsafe { (im.printf_probe)(warm.as_ptr() as *const c_char) };","+    unsafe { printf(warm.as_ptr() as *const c_char) };","     unsafe { fflush(std::ptr::null_mut()) };"," ","     // Exhaust the heap: coarse blocks first, then finer and finer, so that even"]}],"userModified":false,"replaceAll":false}}
