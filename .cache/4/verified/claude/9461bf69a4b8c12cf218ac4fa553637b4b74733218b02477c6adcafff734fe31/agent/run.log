f [ \"$rc\" -eq 0 ]; then\n    echo \"ALL FEATURE COMBINATIONS PASSED\"\nelse\n    echo \"FAILURES DETECTED\"\nfi\nexit \"$rc\"\n","structuredPatch":[],"originalFile":null,"userModified":false}}
