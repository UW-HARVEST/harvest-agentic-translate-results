{"type":"system","subtype":"task_notification","task_id":"bd89afxdr","tool_use_id":"toolu_bdrk_0131fhxGVkh1R2sp5292Tf6N","status":"completed","output_file":"","summary":"cat > $TMPDIR/audit/exh.c <<'EOF'\n#define _GNU_SOURCE\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <unistd.h>\n#include <fcntl.h>\n#include <dlfcn.h>\n#include <stdint.h>\ntypedef struct { unsigned int flag1:1,flag2:1,flag3:1,counter:5,mode:3,status:5,reserved:16; } PF;\ntypedef union { int i; float f; unsigned u; char b[4]; } TC;\ntypedef struct { PF flags; TC data; char* buffer; int capacity; } PS;\ntypedef PS* (*cs_t)(int,int); typedef void (*ds_t)(PS*); typedef int (*ct_t)(PS*,int);\ntypedef int (*pb_t)(PS*,char); typedef void (*uf_t)(PS*,int); typedef int (*cf_t)(int,int,int,int);\ntypedef struct{void*h;cs_t cs;ds_t ds;pb_t pb;uf_t uf;ct_t ct;cf_t cf;}L;\nstatic L ld(const char*p){L l;l.h=dlopen(p,RTLD_NOW|RTLD_LOCAL);if(!l.h){fprintf(stderr,\"%s\\n\",dlerror());exit(2);}\n l.cs=dlsym(l.h,\"create_state\");l.ds=dlsym(l.h,\"destroy_state\");l.pb=dlsym(l.h,\"process_buffer\");\n l.uf=dlsym(l.h,\"update_flags\");l.ct=dlsym(l.h,\"confuse_types\");l.cf=dlsym(l.h,\"confusion\");return l;}\nstatic int sv; static char ba[1<<16], bb[1<<16]; static size_t la,lb;\nstatic void cb(const char*p){fflush(stdout);int fd=open(p,O_RDWR|O_CREAT|O_TRUNC,0600);dup2(fd,1);close(fd);}\nstatic size_t ce(const char*p,char*d,size_t n){fflush(stdout);dup2(sv,1);int fd=open(p,O_RDONLY);ssize_t r=read(fd,d,n);close(fd);return r<0?0:(size_t)r;}\nstatic long fails=0, cases=0;\n#define CHK(msg,...) do{ if(la!=lb||memcmp(ba,bb,la)||ra!=rb){fails++; if(fails<15){printf(\"MISMATCH %s ra=%d rb=%d\\n outA=<<%.*s>>\\n outB=<<%.*s>>\\n\",msg,ra,rb,(int)la,ba,(int)lb,bb);} } cases++; }while(0)\nint main(int argc,char**argv){\n  L A=ld(argv[1]), B=ld(argv[2]); sv=dup(1);\n  char fa[]=\"/tmp/exh_a\", fb[]=\"/tmp/exh_b\";\n  snprintf(fa,sizeof fa,\"%s\",\"exh_a\"); snprintf(fb,sizeof fb,\"%s\",\"exh_b\");\n  int ra,rb; char m[128];\n\n  /* 1. update_flags exhaustive: raw low 16 bits x param 0..63 and negatives */\n  for (unsigned raw=0; raw<65536; raw+=1) {\n    if ((raw & 0xFF) != raw && (raw % 257) != 0) continue; /* all 256 low bytes, plus sample of high */\n    for (int pi=0; pi<80; pi++) {\n      int p = (pi<64) ? pi : ((pi<72)? -(pi-63) : (int)(0x80000000u | (unsigned)(pi-72)));\n      unsigned rw = raw;\n      cb(fa); { PS*s=A.cs(0,64); memcpy(&s->flags,&rw,4); A.uf(s,p); unsigned f; memcpy(&f,&s->flags,4); ra=(int)f; A.ds(s);} la=ce(fa,ba,sizeof ba);\n      cb(fb); { PS*s=B.cs(0,64); memcpy(&s->flags,&rw,4); B.uf(s,p); unsigned f; memcpy(&f,&s->flags,4); rb=(int)f; B.ds(s);} lb=ce(fb,bb,sizeof bb);\n      snprintf(m,sizeof m,\"uf raw=%08X p=%d\",rw,p); CHK(m);\n    }\n  }\n  printf(\"after update_flags: cases=%ld fails=%ld\\n\",cases,fails);\n\n  /* 2. create_state exhaustive over capacity 0..64 x many initial_val */\n  { int ivs[]={0,1,-1,7,-7,10,-10,99,-99,100,-100,1000,-1000,12345,-12345,1078530011,-1078530011,2147483647,-2147483648,999999999,-999999999};\n    for (unsigned c=0;c<=64;c++) for (unsigned j=0;j<sizeof ivs/sizeof*ivs;j++){\n      cb(fa); { PS*s=A.cs(ivs[j],(int)c); if(!s) ra=-1; else { ra=0; if(c) { int n=strnlen(s->buffer,c); ra=n; for(int q=0;q<n;q++) ra=ra*31+s->buffer[q]; } A.ds(s);} } la=ce(fa,ba,sizeof ba);\n      cb(fb); { PS*s=B.cs(ivs[j],(int)c); if(!s) rb=-1; else { rb=0; if(c) { int n=strnlen(s->buffer,c); rb=n; for(int q=0;q<n;q++) rb=rb*31+s->buffer[q]; } B.ds(s);} } lb=ce(fb,bb,sizeof bb);\n      snprintf(m,sizeof m,\"cs iv=%d cap=%u\",ivs[j],c); CHK(m);\n    } }\n  printf(\"after create_state: cases=%ld fails=%ld\\n\",cases,fails);\n\n  /* 3. process_buffer exhaustive over all 256 target bytes x several buffers */\n  { const char* bufs[]={\"\",\"a\",\"A\",\"aa\",\"abcabc\",\"0123456789\",\"\\x01\\x02\\x03\",\"\\x80\\x81\\xff\\xfe\",\"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\",\"State:0:Mode:3\",\"\\xff\\xff\\xff\",\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"};\n    for (unsigned j=0;j<sizeof bufs/sizeof*bufs;j++) for (int t=-128;t<128;t++){\n      cb(fa); { PS*s=A.cs(0,128); strcpy(s->buffer,bufs[j]); ra=A.pb(s,(char)t); A.ds(s);} la=ce(fa,ba,sizeof ba);\n      cb(fb); { PS*s=B.cs(0,128); strcpy(s->buffer,bufs[j]); rb=B.pb(s,(char)t); B.ds(s);} lb=ce(fb,bb,sizeof bb);\n      snprintf(m,sizeof m,\"pb j=%u t=%d\",j,t); CHK(m);\n    } }\n  printf(\"after process_buffer: cases=%ld fails=%ld\\n\",cases,fails);\n\n  /* 4. confuse_types: op -6..6 x many data patterns (incl all 256 byte combos in b0/b1) */\n  { for (int op=-6;op<=6;op++) for (unsigned hi=0;hi<4;hi++) for (unsigned b1=0;b1<256;b1+=1) {\n      unsigned u = (b1<<8) | (b1^0x5A) | (hi<<24) | ((b1&0x7F)<<16);\n      cb(fa); { PS*s=A.cs(0,64); s->data.u=u; ra=A.ct(s,op); ra=ra*31+(int)s->data.u; A.ds(s);} la=ce(fa,ba,sizeof ba);\n      cb(fb); { PS*s=B.cs(0,64); s->data.u=u; rb=B.ct(s,op); rb=rb*31+(int)s->data.u; B.ds(s);} lb=ce(fb,bb,sizeof bb);\n      snprintf(m,sizeof m,\"ct op=%d u=%08X\",op,u); CHK(m);\n    } }\n  printf(\"after confuse_types: cases=%ld fails=%ld\\n\",cases,fails);\n  printf(\"TOTAL cases=%ld fails=%ld\\n\",cases,fails);\n  return fails!=0;\n}\nEOF\ncd $TMPDIR/audit && gcc -O2 -o exh exh.c -ldl 2>&1 | head && time ./exh ./libc_ref.so ./librs_opt.so 2>&1 | tail -30","uuid":"99b2f4ad-8280-491d-a45d-64a2d9e51d8b","session_id":"0d767b69-ab62-4fa8-8e41-e4011018e1f5"}
