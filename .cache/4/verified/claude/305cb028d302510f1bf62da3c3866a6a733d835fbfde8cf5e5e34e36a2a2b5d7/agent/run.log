255.0f;\n60\t///         r *= a;\n61\t///         g *= a;\n62\t///         b *= a;\n63\t///         data[i + 0] = (uint8_t)(r * 255.0f);\n64\t///         data[i + 1] = (uint8_t)(g * 255.0f);\n65\t///         data[i + 2] = (uint8_t)(b * 255.0f);\n66\t///     }\n67\t/// }\n68\t/// ```\n69\t///\n70\t/// Note: `stride` is computed with `size_t` arithmetic and then truncated back\n71\t/// to `int`, which is equivalent to a wrapping 32-bit multiplication by 4. The\n72\t/// loop bound `(int)stride * h` is likewise a 32-bit multiplication (reproduced\n73\t/// here with wrapping semantics). The alpha channel is intentionally left\n74\t/// untouched, exactly as in the original.\n75\t#[unsafe(no_mangle)]\n76\tpub unsafe extern \"C\" fn premultiply(img: *mut cp_image_t) {\n77\t    let w: c_int = (*img).w;\n78\t    let h: c_int = (*img).h;\n79\t    let stride: c_int = w.wrapping_mul(PIXEL_SIZE);\n80\t    let data: *mut u8 = (*img).pix as *mut u8;\n81\t\n82\t    let end: c_int = stride.wrapping_mul(h);\n83\t    let mut i: c_int = 0;\n84\t    while i < end {\n85\t        let idx = |off: c_int| -> *mut u8 { data.offset(i.wrapping_add(off) as isize) };\n86\t\n87\t        let a: f32 = f32::from(*idx(3)) / 255.0f32;\n88\t        let mut r: f32 = f32::from(*idx(0)) / 255.0f32;\n89\t        let mut g: f32 = f32::from(*idx(1)) / 255.0f32;\n90\t        let mut b: f32 = f32::from(*idx(2)) / 255.0f32;\n91\t\n92\t        r *= a;\n93\t        g *= a;\n94\t        b *= a;\n95\t\n96\t        *idx(0) = (r * 255.0f32) as u8;\n97\t        *idx(1) = (g * 255.0f32) as u8;\n98\t        *idx(2) = (b * 255.0f32) as u8;\n99\t\n100\t        i = i.wrapping_add(PIXEL_SIZE);\n101\t    }\n102\t}\n103\t"}]},"parent_tool_use_id":null,"session_id":"6a65eb01-3a90-4dd7-9913-8fac91b28eb5","uuid":"dcc6b996-ee79-4198-937b-b6c31f2d04d5","timestamp":"2026-08-19T14:09:39.429Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-3koaIi/translated_rust/src/lib.rs","content