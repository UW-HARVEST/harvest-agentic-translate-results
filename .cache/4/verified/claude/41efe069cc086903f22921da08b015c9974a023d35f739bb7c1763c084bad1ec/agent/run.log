{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01LuZLLXf7ZQPNXwZeLiwEgw","type":"tool_result","content":"1\t/*\n2\t * Copyright 2025 MIT Lincoln Laboratory\n3\t * Permission is hereby granted, free of charge,\n4\t * to any person obtaining a copy of this software\n5\t * and associated documentation files (the \"Software\"),\n6\t * to deal in the Software without restriction,\n7\t * including without limitation the rights to use, copy,\n8\t * modify, merge, publish, distribute, sublicense,\n9\t * and/or sell copies of the Software,\n10\t * and to permit persons to whom the Software is furnished to do so,\n11\t * subject to the following conditions:\n12\t *\n13\t * The above copyright notice and this permission notice\n14\t * shall be included in all copies or substantial portions of the Software.\n15\t *\n16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n18\t * THE WARRANTIES OF MERCHANTABILITY,\n19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n24\t */\n25\t\n26\t//! Faithful Rust translation of `c_src/src/lib.c`.\n27\t//!\n28\t//! Every routine reproduces the exact behaviour of the original C code,\n29\t//! including its quirks (e.g. `rotate_buffer` rotating left for small\n30\t//! offsets but right for large ones, and `compact_runs` being able to\n31\t//! *grow* the logical length when the threshold is 1 or 2).\n32\t//!\n33\t//! `memmove` is modelled with `slice::copy_within` (identical overlapping\n34\t//! copy semantics) and single byte `memmove`s are plain assignments.\n35\t\n36\t#![forbid(unsafe_code)]\n37\t\n38\t/// Main entrance function - processes buffer based on operation flags\n39\t///\n40\t/// * `buffer`  - Input/output buffer\n41\t/// * `length`  - Buffer length\n42\t/// * `flags`   - Bit flags:\n43\t///   * bit 0: rotate buffer\n44\t///   * bit 1: compact runs\n45\t///   * bit 2: remove duplicates\n46\t///   * bit 3: interleave halves\n47\t///   * bit 4: reverse segments\n48\t/// * `param1`  - Operation-specific parameter (rotation offset, run threshold, segment size)\n49\t/// * `param2`  - Secondary parameter (preserve order flag, etc)\n50\t///\n51\t/// Returns the new buffer length after processing.\n52\tpub fn process_buffer(\n53\t    buffer: &mut [u8],\n54\t    length: usize,\n55\t    flags: u32,\n56\t    param1: i32,\n57\t    param2: i32,\n58\t) -> usize {\n59\t    let mut new_len = length;\n60\t\n61\t    /* `buffer == NULL || length == 0` in the original */\n62\t    if buffer.is_empty() || length == 0 {\n63\t        return 0;\n64\t    }\n65\t\n66\t    /* Branch based on multiple flags - creates diverse control flow */\n67\t    if flags & 0x01 != 0 {\n68\t        /* Rotate */\n69\t        let offset = param1 % (length as i32);\n70\t        if offset != 0 {\n71\t            rotate_buffer(buffer, length, offset);\n72\t        }\n73\t    }\n74\t\n75\t    if flags & 0x02 != 0 {\n76\t        /* Compact runs */\n77\t        let threshold: u8 = if param1 > 0 && param1 <= 255 {\n78\t            param1 as u8\n79\t        } else {\n80\t            3\n81\t        };\n82\t        new_len = compact_runs(buffer, new_len, threshold);\n83\t    }\n84\t\n85\t    if flags & 0x04 != 0 {\n86\t        /* Remove duplicates */\n87\t        let preserve = param2 != 0;\n88\t        new_len = remove_duplicates(buffer, new_len, preserve);\n89\t    }\n90\t\n91\t    /* Conditional chaining based on length */\n92\t    if (flags & 0x08 != 0) && new_len >= 2 {\n93\t        /* Interleave */\n94\t        interleave_halves(buffer, new_len);\n95\t    }\n96\t\n97\t    if (flags & 0x10 != 0) && new_len >= 4 {\n98\t        /* Reverse segments */\n99\t        let seg_size: usize = if param1 > 0 { param1 as usize } else { 4 };\n100\t        if seg_size <= new_len {\n101\t            reverse_segments(buffer, new_len, seg_size);\n102\t        }\n103\t    }\n104\t\n105\t    new_len\n106\t}\n107\t\n108\t/// Rotate buffer by offset positions (positive = right, negative = left)\n109\t/// Uses multiple memmove operations with different patterns\n110\tfn rotate_buffer(buf: &mut [u8], len: usize, offset: i32) {\n111\t    if len <= 1 {\n112\t        return;\n113\t    }\n114\t\n115\t    /* Normalize offset */\n116\t    let mut offset = offset % (len as i32);\n117\t    if offset < 0 {\n118\t        /* C: `offset += len;` with `len` a size_t, truncated back to int */\n119\t        offset = offset.wrapping_add(len as i32);\n120\t    }\n121\t    if offset == 0 {\n122\t        return;\n123\t    }\n124\t\n125\t    /* Use reversal algorithm with memmove */\n126\t    let mut temp = [0u8; 256];\n127\t    let offset = offset as usize;\n128\t    let chunk: usize = if offset < 256 { offset } else { 256 };\n129\t\n130\t    if offset < len / 2 {\n131\t        /* Small offset: move prefix aside, shift main part, restore prefix */\n132\t        let mut i = 0usize;\n133\t        while i < offset {\n134\t            let copy_len = if offset - i < chunk { offset - i } else { chunk };\n135\t            temp[..copy_len].copy_from_slice(&buf[i..i + copy_len]);\n136\t            buf.copy_within(offset..offset + (len - offset), i);\n137\t            let dst = len - offset;\n138\t            buf[dst..dst + copy_len].copy_from_slice(&temp[..copy_len]);\n139\t            i += chunk;\n140\t        }\n141\t    } else {\n142\t        /* Large offset: work from the right */\n143\t        let shift = len - offset;\n144\t        temp[..shift].copy_from_slice(&buf[..shift]);\n145\t        buf.copy_within(shift..shift + offset, 0);\n146\t        buf[offset..offset + shift].copy_from_slice(&temp[..shift]);\n147\t    }\n148\t}\n149\t\n150\t/// Compact consecutive runs of same value if run length >= threshold\n151\t/// Complex nested loops with multiple data paths\n152\tfn compact_runs(buf: &mut [u8], len: usize, threshold: u8) -> usize {\n153\t    let mut len = len;\n154\t    let mut read = 0usize;\n155\t    let mut write = 0usize;\n156\t\n157\t    while read < len {\n158\t        let current = buf[read];\n159\t        let mut run_len = 1usize;\n160\t\n161\t        /* Count run length */\n162\t        while read + run_len < len && buf[read + run_len] == current {\n163\t            run_len += 1;\n164\t        }\n165\t\n166\t        if run_len >= threshold as usize {\n167\t            /* Compact to 2 elements: value, count */\n168\t            if run_len > 255 {\n169\t                run_len = 255; /* Cap at 255 */\n170\t            }\n171\t\n172\t            buf[write] = current;\n173\t            write += 1;\n174\t            buf[write] = run_len as u8;\n175\t            write += 1;\n176\t\n177\t            /* Shift remaining data if needed */\n178\t            if read + run_len < len {\n179\t                let remaining = len - (read + run_len);\n180\t                buf.copy_within((read + run_len)..(read + run_len + remaining), write);\n181\t            }\n182\t            len = write + (len - (read + run_len));\n183\t            read = write;\n184\t        } else {\n185\t            /* Keep run as-is, but may need to move it */\n186\t            if write != read {\n187\t                buf.copy_within(read..read + run_len, write);\n188\t            }\n189\t            write += run_len;\n190\t            read += run_len;\n191\t        }\n192\t    }\n193\t\n194\t    len\n195\t}\n196\t\n197\t/// Remove duplicate values - different paths for ordered/unordered\n198\tfn remove_duplicates(buf: &mut [u8], len: usize, preserve_order: bool) -> usize {\n199\t    if len <= 1 {\n200\t        return len;\n201\t    }\n202\t\n203\t    if preserve_order {\n204\t        /* Preserve order: O(n^2) but maintains sequence */\n205\t        let mut write = 1usize;\n206\t        for i in 1..len {\n207\t            let mut j = 0usize;\n208\t            while j < write {\n209\t                if buf[i] == buf[j] {\n210\t                    break;\n211\t                }\n212\t                j += 1;\n213\t            }\n214\t            if j == write {\n215\t                if write != i {\n216\t                    buf[write] = buf[i];\n217\t                }\n218\t                write += 1;\n219\t            }\n220\t        }\n221\t        write\n222\t    } else {\n223\t        /* Don't preserve order: sort-like approach with memmove */\n224\t        let mut seen = [0u8; 256];\n225\t        let mut write = 0usize;\n226\t\n227\t        for i in 0..len {\n228\t            if seen[buf[i] as usize] == 0 {\n229\t                seen[buf[i] as usize] = 1;\n230\t                if write != i {\n231\t                    /* Swap to front */\n232\t                    buf.swap(write, i);\n233\t                }\n234\t                write += 1;\n235\t            }\n236\t        }\n237\t        write\n238\t    }\n239\t}\n240\t\n241\t/// Interleave first and second halves of buffer\n242\t/// Complex memmove pattern with temporary storage\n243\tfn interleave_halves(buf: &mut [u8], len: usize) {\n244\t    if len < 2 {\n245\t        return;\n246\t    }\n247\t\n248\t    let half = len / 2;\n249\t    let odd = len % 2;\n250\t    let mut temp = [0u8; 512];\n251\t\n252\t    if half <= 256 {\n253\t        /* Use temp buffer for small sizes */\n254\t        temp[..half].copy_from_slice(&buf[..half]);\n255\t\n256\t        for i in 0..half {\n257\t            buf[i * 2 + 1] = buf[half + i];\n258\t            buf[i * 2] = temp[i];\n259\t        }\n260\t        if odd != 0 {\n261\t            buf[len - 1] = buf[half];\n262\t        }\n263\t    } else {\n264\t        /* In-place for large buffers - more complex */\n265\t        for i in 0..half {\n266\t            let src = half + i;\n267\t            let dst = i * 2 + 1;\n268\t            if dst < src {\n269\t                let val = buf[src];\n270\t                buf.copy_within(dst..dst + (src - dst), dst + 1);\n271\t                buf[dst] = val;\n272\t            }\n273\t        }\n274\t    }\n275\t}\n276\t\n277\t/// Reverse buffer in fixed-size segments\n278\t/// Nested loops with conditional memmove operations\n279\tfn reverse_segments(buf: &mut [u8], len: usize, seg_size: usize) {\n280\t    if seg_size <= 1 || len < seg_size {\n281\t        return;\n282\t    }\n283\t\n284\t    let num_segments = len / seg_size;\n285\t    let remainder = len % seg_size;\n286\t\n287\t    /* Process complete segments */\n288\t    for seg in 0..num_segments {\n289\t        let base = seg * seg_size;\n290\t\n291\t        /* Reverse within segment using memmove */\n292\t        for i in 0..(seg_size / 2) {\n293\t            let left = base + i;\n294\t            let right = base + seg_size - 1 - i;\n295\t\n296\t            buf.swap(left, right);\n297\t        }\n298\t    }\n299\t\n300\t    /* Handle remainder if exists and is > 1 */\n301\t    if remainder > 1 {\n302\t        let base = num_segments * seg_size;\n303\t        for i in 0..(remainder / 2) {\n304\t            buf.swap(base + i, base + remainder - 1 - i);\n305\t        }\n306\t    }\n307\t}\n308\t"}]},"parent_tool_use_id":null,"session_id":"9a37b61e-2eea-40bc-a926-01919fa87bad","uuid":"cc8d6f7f-eeeb-4c39-ad38-6e9f13a67e2f","timestamp":"2026-08-19T22:11:52.461Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-zyzD21/translated_rust/src/lib.rs","content":"/*\n * Copyright 2025 MIT Lincoln Laboratory\n * Permission is hereby granted, free of charge,\n * to any person obtaining a copy of this software\n * and associated documentation files (the \"Software\"),\n * to deal in the Software without restriction,\n * including without limitation the rights to use, copy,\n * modify, merge, publish, distribute, sublicense,\n * and/or sell