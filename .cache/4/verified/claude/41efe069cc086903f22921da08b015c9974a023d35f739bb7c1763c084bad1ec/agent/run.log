go test 2>&1 | grep -E 'test result|^error'; then","+        echo \"!!! TESTS FAILED against C built with $opt\"; FAILED=1","+    fi","+done","+"," if [ \"$FAILED\" = 0 ]; then","     echo \"ALL FEATURE COMBINATIONS OK\""," else"]}],"userModified":false,"replaceAll":false}}
