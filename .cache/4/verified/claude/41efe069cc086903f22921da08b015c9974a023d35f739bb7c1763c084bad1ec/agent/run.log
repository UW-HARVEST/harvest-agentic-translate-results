b'-')\n159\t        {\n160\t            negative = self.data[self.pos] == b'-';\n161\t            self.pos += 1;\n162\t        }\n163\t\n164\t        let digits_start = self.pos;\n165\t        while self.pos < self.data.len() && self.data[self.pos].is_ascii_digit() {\n166\t            self.pos += 1;\n167\t        }\n168\t        if self.pos == digits_start {\n169\t            /* Matching failure: the characters are pushed back. */\n170\t            self.pos = start;\n171\t            return None;\n172\t        }\n173\t\n174\t        let mut value: u64 = 0;\n175\t        let mut overflowed = false;\n176\t        for &d in &self.data[digits_start..self.pos] {\n177\t            let digit = u64::from(d - b'0');\n178\t            match value.checked_mul(10).and_then(|v| v.checked_add(digit)) {\n179\t                Some(v) => value = v,\n180\t                None => overflowed = true,\n181\t            }\n182\t        }\n183\t\n184\t        Some((negative, value, overflowed))\n185\t    }\n186\t\n187\t    /// `%u` / `%zu`: `strtoul` semantics (ULONG_MAX on overflow, wrapping\n188\t    /// negation for a leading `-`).\n189\t    fn scan_unsigned(&mut self) -> Option<u64> {\n190\t        let (negative, value, overflowed) = self.scan_token()?;\n191\t        if overflowed {\n192\t            return Some(u64::MAX);\n193\t        }\n194\t        Some(if negative { value.wrapping_neg() } else { value })\n195\t    }\n196\t\n197\t    /// `%d`: `strtol` semantics (saturating at LONG_MIN / LONG_MAX).\n198\t    fn scan_signed(&mut self) -> Option<i64> {\n199\t        let (negative, value, overflowed) = self.scan_token()?;\n200\t        if overflowed {\n201\t            return Some(if negative { i64::MIN } else { i64::MAX });\n202\t        }\n203\t        if negative {\n204\t            if value > (i64::MAX as u64) + 1 {\n205\t                Some(i64::MIN)\n206\t            } else {\n207\t                Some((value as i64).wrapping_neg())\n208\t            }\n209\t        } else if v