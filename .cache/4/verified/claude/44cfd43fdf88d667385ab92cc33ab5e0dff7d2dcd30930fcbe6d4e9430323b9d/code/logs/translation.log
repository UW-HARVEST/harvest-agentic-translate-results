int a = rc_c(x, y, r), b = rc_r(x, y, r);\n        n++;\n        if (a != b) { if (++bad <= 10) printf(\"DIFF-RND %a %a %a C=%d R=%d\\n\", x, y, r, a, b); }\n        else if (a >= 0 && a < 8) hist[a]++;\n    }\n\n    printf(\"reverse_collide: %ld inputs, %ld mismatches\\n\", n, bad);\n    printf(\"result histogram (all 8 return values must be exercised):\\n\");\n    for (int i = 0; i < 8; i++) printf(\"  result %d: %d\\n\", i, hist[i]);\n\n    /* c2MakeProxy with invalid enum -> C leaves the struct untouched */\n    long mpbad = 0;\n    for (int t = 0; t < 1000; t++) {\n        c2Proxy p1, p2;\n        memset(&p1, 0x00, sizeof p1); memset(&p2, 0x00, sizeof p2);\n        float shape[8]; for (int i = 0; i < 8; i++) shape[i] = (float)t + i;\n        int ty = 3 + (int)(rnd() % 1000);\n        mp_c(shape, ty, &p1); mp_r(shape, ty, &p2);\n        if (memcmp(&p1, &p2, sizeof p1)) mpbad++;\n        memset(&p1, 0x7F, sizeof p1); memset(&p2, 0x7F, sizeof p2);\n        mp_c(shape, -ty, &p1); mp_r(shape, -ty, &p2);\n        if (memcmp(&p1, &p2, sizeof p1)) mpbad++;\n    }\n    printf(\"c2MakeProxy invalid-type mismatches: %ld\\n\", mpbad);\n\n    printf(\"\\n%s\\n\", (bad == 0 && mpbad == 0) ? \"PASS\" : \"FAIL\");\n    return (bad || mpbad) != 0;\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
