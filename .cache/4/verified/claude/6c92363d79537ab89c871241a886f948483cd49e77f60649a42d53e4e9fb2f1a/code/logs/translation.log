self.node_count as usize {\n            let r = self.nodes[i];\n            self.delete_node(r);\n        }\n    }\n}\n","structuredPatch":[{"oldStart":13,"oldLines":6,"newStart":13,"newLines":7,"lines":[" //! allocator's book-keeping, so `strcmp()` against it never matches."," "," use crate::cio::{err, Out};","+use std::collections::VecDeque;"," "," pub const MAX_CITY_NAME: usize = 64;"," pub const MAX_EDGES: usize = 10;"]}],"userModified":false,"replaceAll":false}}
