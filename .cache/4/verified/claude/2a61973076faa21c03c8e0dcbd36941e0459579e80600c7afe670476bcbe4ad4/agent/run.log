, Ordering::SeqCst);\n        let op = dir.join(format!(\"main_out_{n}\"));\n        let ep = dir.join(format!(\"main_err_{n}\"));\n        let mut cstrs: Vec<Vec<u8>> = args\n            .iter()\n            .map(|a| {\n                let mut v = a.as_bytes().to_vec();\n                v.push(0);\n                v\n            })\n            .collect();\n        let mut argv: Vec<*mut c_char> = cstrs\n            .iter_mut()\n            .map(|v| v.as_mut_ptr() as *mut c_char)\n            .collect();\n        argv.push(std::ptr::null_mut());\n        let argc = args.len() as c_int;\n        let argv_ptr = if args.is_empty() {\n            std::ptr::null_mut()\n        } else {\n            argv.as_mut_ptr()\n        };\n\n        let rc = unsafe {\n            let mut opb = op.as_os_str().as_encoded_bytes().to_vec();\n            opb.push(0);\n            let mut epb = ep.as_os_str().as_encoded_bytes().to_vec();\n            epb.push(0);\n            fflush(std::ptr::null_mut());\n            let saved_out = dup(1);\n            let saved_err = dup(2);\n            let fo = open(opb.as_ptr() as *const c_char, O_RDWR | O_CREAT | O_TRUNC, 0o600);\n            let fe = open(epb.as_ptr() as *const c_char, O_RDWR | O_CREAT | O_TRUNC, 0o600);\n            assert!(fo >= 0 && fe >= 0, \"cannot open capture files\");\n            dup2(fo, 1);\n            dup2(fe, 2);\n            let rc = main_fn(argc, argv_ptr);\n            fflush(std::ptr::null_mut());\n            dup2(saved_out, 1);\n            dup2(saved_err, 2);\n            close(saved_out);\n            close(saved_err);\n            close(fo);\n            close(fe);\n            rc\n        };\n        MainOutcome {\n            rc,\n            stdout: std::fs::read(&op).unwrap_or_default(),\n            stderr: std::fs::read(&ep).unwrap_or_default(),\n        }\n    }\n}\nRUST_EOF\ncat >> /local/home/scheschb/.harvest/work/harvest-work-L0xaIW/translated_rust/tests/differential.rs <<'RUST_EOF'\n\n// ===========================================================================\n// Remaining surface: the exported `main` symbol, `steps` overflow, NULL label.\n// ===========================================================================\n\n/// The 19th exported symbol, called straight through the `.so` (not as a\n/// subprocess).  stdout/stderr are redirected to files for the duration.\n/// Runs single-threaded (fd juggling) -- see the `--test-threads` note in\n/// scripts/run_all.sh is not needed because each case restores the fds.\n#[test]\nfn err_main_symbol_via_dlopen() {\n    let (c, r) = fresh_pair(\"main_sym\");\n    let cases: Vec<Vec<&str>> = vec![\n        vec![],                       // argc == 0, argv == NULL\n        vec![\"./driver\"],             // no program -> rc 2\n        vec![\"./driver\", \"--help\"],   // usage on stderr, rc 0\n        vec![\"./driver\", \"0\", \"42\"],  // a real program\n        vec![\"./driver\", \"abc\"],      // skip message + no program\n        vec![\"./driver\", \"\"],         // empty arg pushes 0\n        vec![\"./driver\", \"9\", \"0\"],   // opcode 9 with m == 0\n        vec![\"./driver\", \"11\"],       // unknown opcode -> rc 99 in the output\n        vec![\"./driver\", \"0\", \"100\", \"3\", \"5\", \"8\", \"9\", \"2\", \"1\", \"10\"],\n    ];\n    for case in cases {\n        let co = c.call_main(&case);\n        let ro = r.call_main(&case);\n        assert_eq!(co.rc, ro.rc, \"main{case:?} exit code\");\n        assert_eq!(\n            String::from_utf8_lossy(&co.stdout),\n            String::from_utf8_lossy(&ro.stdout),\n            \"main{case:?} stdout\"\n        );\n        assert_eq!(\n            String::from_utf8_lossy(&co.stderr),\n            String::from_utf8_lossy(&ro.stderr),\n            \"main{case:?} stderr\"\n        );\n        assert_eq!(co, ro, \"main{case:?} bytes\");\n    }\n}\n\n/// `vm->steps++` overflows for a caller-supplied `steps` near INT_MAX (UB in C,\n/// wraps in practice -- the Rust must wrap the same way).\n#[test]\nfn cfg_engine_steps_overflow() {\n    for &imp in IMPLS.iter() {\n        let (c, r) = fresh_pair(&format!(\"steps{imp}\"));\n        for start in [\n            c_int::MAX,\n            c_int::MAX - 1,\n            c_int::MAX - 3,\n            c_int::MIN,\n            -1,\n            -5,\n        ] {\n            let code = vec![0, 5, 3, 5, 8, 3, 9, 2, 1, 10];\n            let mut cvm = c.new_vm();\n            let mut rvm = r.new_vm();\n            cvm.steps = start;\n            rvm.steps = start;\n            let crc = unsafe { (c.run_engine)(imp, code.as_ptr(), code.len(), &mut cvm) };\n            let rrc = unsafe { (r.run_engine)(imp, code.as_ptr(), code.len(), &mut rvm) };\n            assert_eq!(crc, rrc, \"steps={start} rc\");\n            assert_eq!(\n                c.snapshot_vm(&cvm),\n                r.snapshot_vm(&rvm),\n                \"steps={start} state (impl={imp})\"\n            );\n            assert_eq!(\n                c.print_vm_raw(\"S:\", &cvm),\n                r.print_vm_raw(\"S:\", &rvm),\n                \"steps={start} vm_print\"\n            );\n            unsafe {\n                (c.vm_free)(&mut cvm);\n                (r.vm_free)(&mut rvm);\n            }\n        }\n    }\n}\n\n/// ERRORS.md row G7 -- `vm_print` with a NULL label.  The C hands the pointer\n/// straight to `%s`; glibc prints \"(null)\".  The Rust must forward it unchanged.\n#[test]\nfn err_vm_print_null_label() {\n    let (c, r) = fresh_pair(\"null_label\");\n    let mut cvm = c.new_vm();\n    let mut rvm = r.new_vm();\n    for t in [0, 1, 2, 13] {\n        unsafe {\n            (c.vm_trace)(&mut cvm, t);\n            (r.vm_trace)(&mut rvm, t);\n        }\n    }\n    let co = c.print_vm_null_label(&cvm);\n    let ro = r.print_vm_null_label(&rvm);\n    assert_eq!(\n        String::from_utf8_lossy(&co),\n        String::from_utf8_lossy(&ro),\n        \"vm_print(NULL label)\"\n    );\n    unsafe {\n        (c.vm_free)(&mut cvm);\n        (r.vm_free)(&mut rvm);\n    }\n}\nRUST_EOF\necho appended","description":"Add main-via-dlopen, steps overflow, NULL label tests"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":953,"cache_read_input_tokens":238247,"cache_creation":{"ephemeral_5m_input_tokens":953,"ephemeral_1h_input_tokens":0},"output_tokens":10,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"3ae6ba8e-9c81-4b9f-bd39-3ec717477d24","uuid":"f1cc12fe-7c82-42a8-be3d-769eda473159","timestamp":"2026-08-20T00:51:35.123Z"}
