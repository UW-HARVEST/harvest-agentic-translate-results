dify, merge, publish, distribute, sublicense,\n     8\t// and/or sell copies of the Software,\n     9\t// and to permit persons to whom the Software is furnished to do so,\n    10\t// subject to the following conditions:\n    11\t// \n    12\t// The above copyright notice and this permission notice\n    13\t// shall be included in all copies or substantial portions of the Software.\n    14\t// \n    15\t// THE SOFTWARE IS PROVIDED “AS IS”, WITHOUT WARRANTY OF ANY KIND,\n    16\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    17\t// THE WARRANTIES OF MERCHANTABILITY,\n    18\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    19\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    20\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    21\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    22\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    23\t\n    24\t#ifndef UTIL_H\n    25\t#define UTIL_H\n    26\t#include <stddef.h>\n    27\t#include <stdbool.h>\n    28\t#include <stdio.h>\n    29\t\n    30\ttypedef struct {\n    31\t    int *data; size_t len, cap;\n    32\t} IntVec;\n    33\t\n    34\tvoid iv_init(IntVec *v);\n    35\tvoid iv_free(IntVec *v);\n    36\tbool iv_reserve(IntVec *v, size_t need);\n    37\tbool iv_push(IntVec *v, int x);\n    38\tbool iv_pop(IntVec *v, int *out);\n    39\tint  iv_peek(const IntVec *v, int def);\n    40\t\n    41\ttypedef struct {\n    42\t    const int *code; size_t n; size_t ip;\n    43\t} Program;\n    44\t\n    45\tvoid prog_init(Program *p, const int *code, size_t n);\n    46\tbool prog_fetch(Program *p, int *out);\n    47\t\n    48\ttypedef struct {\n    49\t    IntVec stack;\n    50\t    IntVec trace;\n    51\t    int    steps;\n    52\t} VM;\n    53\t\n    54\tvoid vm_init(VM *vm);\n    55\tvoid vm_free(VM *vm);\n    56\tvoid vm_trace(VM *vm, int t);\n    57\tvoid vm_print(FILE *fp, const char *label, const VM *vm);\n    58\t\n    59\tint run_engine(int impl_id, const int *code, size_t n, VM *vm);\n    60\t\n    61\t#endif\n===== c_src/src/main.c =====\n     1\t// Copyright 2025 MIT Lincoln Laboratory\n     2\t// Permission is hereby granted, free of charge,\n     3\t// to any person obtaining a copy of this software\n     4\t// and associated documentation files (the “Software”),\n     5\t// to deal in the Software without restriction,\n     6\t// including without limitation the rights to use, copy,\n     7\t// modify, merge, publish, distribute, sublicense,\n     8\t// and/or sell copies of the Software,\n     9\t// and to permit persons to whom the Software is furnished to do so,\n    10\t// subject to the following conditions:\n    11\t// \n    12\t// The above copyright notice and this permission notice\n    13\t// shall be included in all copies or substantial portions of the Software.\n    14\t// \n    15\t// THE SOFTWARE IS PROVIDED “AS IS”, WITHOUT WARRANTY OF ANY KIND,\n    16\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    17\t// THE WARRANTIES OF MERCHANTABILITY,\n    18\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    19\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    20\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    21\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    22\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    23\t\n    24\t#include <stdio.h>\n    25\t#include <stdlib.h>\n    26\t#include <string.h>\n    27\t#include <stdbool.h>\n    28\t#include \"../include/util.h\"\n    29\t#include \"../include/api.h\"\n    30\t\n    31\tint run_engine(int impl_id, const int *code, size_t n, VM *vm);\n    32\t\n    33\tstatic void usage(const char *p){\n    34\t    fprintf(stderr, \"Usage: %s [--stdin] [bytecodes...]\\n\"\n    35\t                    \"Bytecodes are integers forming a small VM program.\\n\", p);\n    36\t}\n    37\t\n    38\tstatic size_t read_stdin(IntVec *v){\n    39\t    char buf[4096];\n    40\t    size_t count=0;\n    41\t    while (fgets(buf, sizeof buf, stdin)) {\n    42\t        char *p = buf;\n    43\t        while (*p) {\n    44\t            char *q=p;\n    45\t            while (*q && *q!=' ' && *q!='\\t' && *q!='\\n' && *q!='\\r') ++q;\n    46\t            char save=*q; *q='\\0';\n    47\t            if (*p) {\n    48\t                char *e=NULL; long t=strtol(p,&e,10);\n    49\t                if (e && *e=='\\0') { iv_push(v,(int)t); count++; }\n    50\t            }\n    51\t            *q=save;\n    52\t            p = (*q? q+1 : q);\n    53\t        }\n    54\t    }\n    55\t    return count;\n    56\t}\n    57\t\n    58\tint main(int argc, char **argv){\n    59\t    bool use_stdin=false;\n    60\t    IntVec code; iv_init(&code);\n    61\t\n    62\t    for (int i=1;i<argc;i++){\n    63\t        if (!strcmp(argv[i],\"--help\")) { usage(argv[0]); iv_free(&code); return 0; }\n    64\t        else if (!strcmp(argv[i],\"--stdin\")) use_stdin=true;\n    65\t        else {\n    66\t            char *e=NULL; long t=strtol(argv[i],&e,10);\n    67\t            if (e && *e=='\\0') iv_push(&code,(int)t);\n    68\t            else fprintf(stderr,\"skip '%s'\\n\", argv[i]);\n    69\t        }\n    70\t    }\n    71\t    if (use_stdin) read_stdin(&code);\n    72\t    if (code.len==0) {\n    73\t        fprintf(stderr,\"no program\\n\");\n    74\t        iv_free(&code); return 2;\n    75\t    }\n    76\t\n    77\t    VM vmA, vmB, vmE;\n    78\t    vm_init(&vmA); vm_init(&vmB); vm_init(&vmE);\n    79\t\n    80\t    int rcA = run_engine(0, code.data, code.len, &vmA);\n    81\t    int rcB = run_engine(1, code.data, code.len, &vmB);\n    82\t    int rcE = run_engine(2, code.data, code.len, &vmE);\n    83\t\n    84\t    printf(\"RC:A=%d B=%d EXT=%d\\n\", rcA, rcB, rcE);\n    85\t    vm_print(stdout, \"A:\", &vmA);\n    86\t    vm_print(stdout, \"B:\", &vmB);\n    87\t    vm_print(stdout, \"EXT:\", &vmE);\n    88\t\n    89\t    vm_free(&vmA); vm_free(&vmB); vm_free(&vmE);\n    90\t    iv_free(&code);\n    91\t    return 0;\n    92\t}\n===== c_src/src/engine.c =====\n     1\t// Copyright 2025 MIT Lincoln Laboratory\n     2\t// Permission is hereby granted, free of charge,\n     3\t// to any person obtaining a copy of this software\n     4\t// and associated documentation files (the “Software”),\n     5\t// to deal in the Software without restriction,\n     6\t// including without limitation the rights to use, copy,\n     7\t// modify, merge, publish, distribute, sublicense,\n     8\t// and/or sell copies of the Software,\n     9\t// and to permit persons to whom the Software is furnished to do so,\n    10\t// subject to the following conditions:\n    11\t// \n    12\t// The above copyright notice and this permission notice\n    13\t// shall be included in all copies or substantial portions of the Software.\n    14\t// \n    15\t// THE SOFTWARE IS PROVIDED “AS IS”, WITHOUT WARRANTY OF ANY KIND,\n    16\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    17\t// THE WARRANTIES OF MERCHANTABILITY,\n    18\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    19\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    20\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    21\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    22\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    23\t\n    24\t#include \"../include/util.h\"\n    25\t#include \"../include/api.h\"\n    26\t#include <alloca.h>\n    27\t#include <string.h>\n    28\t\n    29\tint call_a_once(int x);\n    30\tint process_a_stream(const int *xs, size_t n);\n    31\tint call_b_once(int x);\n    32\tint process_b_stream(const int *xs, size_t n);\n    33\t\n    34\tstatic inline int inline_call(int (*f)(int), int x){ return f(x); }\n    35\t\n    36\t#define MAC_CALL(F,X) ((F)((X)+1))\n    37\t\n    38\tstatic int classify(int impl, int x){\n    39\t    if (impl==0) { extern int call_a_once(int); return inline_call(call_a_once, x); }\n    40\t    if (impl==1) { extern int call_b_once(int); return MAC_CALL(call_b_once, x); }\n    41\t    \n    42\t    return inline_call(&target, MAC_CALL(target, x));\n    43\t}\n    44\t\n    45\tstatic int process_stream(int impl, const int *buf, size_t n){\n    46\t    if (impl==0) return process_a_stream(buf, n);\n    47\t    if (impl==1) return process_b_stream(buf, n);\n    48\t    \n    49\t    int acc=0;\n    50\t    for(size_t i=0;i<n;i++){\n    51\t        int t = target(buf[i]);\n    52\t        if ((t&1)==0) acc += (t*2);\n    53\t        else          acc ^= (t+7);\n    54\t    }\n    55\t    return acc;\n    56\t}\n    57\t\n    58\tint run_engine(int impl_id, const int *code, size_t n, VM *vm){\n    59\t    Program p; prog_init(&p, code, n);\n    60\t    int op;\n    61\t    while (prog_fetch(&p, &op)) {\n    62\t        vm->steps++;\n    63\t        switch (op) {\n    64\t            case 0: { \n    65\t                int imm; if (!prog_fetch(&p, &imm)) return 1;\n    66\t                iv_push(&vm->stack, imm);\n    67\t                vm_trace(vm, 0);\n    68\t                break;\n    69\t            }\n    70\t            case 1: { \n    71\t                int a,b; if(!iv_pop(&vm->stack,&b)||!iv_pop(&vm->stack,&a)) return 2;\n    72\t                iv_push(&vm->stack, a+b);\n    73\t                vm_trace(vm, 1);\n    74\t                break;\n    75\t            }\n    76\t            case 2: { \n    77\t                int a,b; if(!iv_pop(&vm->stack,&b)||!iv_pop(&vm->stack,&a)) return 3;\n    78\t                iv_push(&vm->stack, a*b);\n    79\t                vm_trace(vm, 2);\n    80\t                break;\n    81\t            }\n    82\t            case 3: { \n    83\t                int a = iv_peek(&vm->stack, 0);\n    84\t                iv_push(&vm->stack, a);\n    85\t                vm_trace(vm, 3);\n    86\t                break;\n    87\t            }\n    88\t            case 4: { \n    89\t                int tmp; if(!iv_pop(&vm->stack,&tmp)) return 4;\n    90\t                vm_trace(vm, 4);\n    91\t                break;\n    92\t            }\n    93\t            case 5: { \n    94\t                int x = iv_peek(&vm->stack, 0);\n    95\t                int bucket = classify(impl_id, x);\n    96\t                iv_push(&vm->stack, bucket);\n    97\t                \n    98\t                switch (bucket) {\n    99\t                    case 0: vm_trace(vm, 5); break;\n   100\t                    case 1: vm_trace(vm, 6); break;\n   101\t                    case 2: vm_trace(vm, 7); break;\n   102\t                    case 3:;\n   103\t                    case 4: vm_trace(vm, 8); break;\n   104\t                    default: vm_trace(vm, 9); break;\n   105\t                }\n   106\t                break;\n   107\t            }\n   108\t            case 6: { \n   109\t                int k; if(!prog_fetch(&p,&k)) return 5;\n   110\t                int cond; if(!iv_pop(&vm->stack,&cond)) return 6;\n   111\t                if (cond) {\n   112\t                    \n   113\t                    if ((size_t)k > p.n - p.ip) return 7;\n   114\t                    p.ip += (size_t)k;\n   115\t                    vm_trace(vm, 10);\n   116\t                } else {\n   117\t                    vm_trace(vm, 11);\n   118\t                }\n   119\t                break;\n   120\t            }\n   121\t            case 7: { \n   122\t                int times; if(!prog_fetch(&p,&times)) return 8;\n   123\t                if (p.ip>=p.n) return 9;\n   124\t                size_t saved_ip = p.ip;\n   125\t                for (int i=0;i<times;i++){\n   126\t                    Program inner = p; inner.ip = saved_ip;\n   127\t                    int rc = run_engine(impl_id, inner.code + inner.ip, 1, vm);\n   128\t                    if (rc) { \n   129\t                        p.ip = saved_ip + 1; \n   130\t                        vm_trace(vm, 12);\n   131\t                        break;\n   132\t                    }\n   133\t                }\n   134\t                p.ip = saved_ip + 1;\n   135\t                break;\n   136\t            }\n   137\t            case 8: { \n   138\t                int x = iv_peek(&vm->stack, 0);\n   139\t                int y = classify(impl_id, x);\n   140\t                iv_push(&vm->stack, y);\n   141\t                vm_trace(vm, 13);\n   142\t                break;\n   143\t            }\n   144\t            case 9: { \n   145\t                int m; if(!prog_fetch(&p,&m)) return 10;\n   146\t                if (m<0 || (size_t)m > vm->stack.len) return 11;\n   147\t                int tmp[m];\n   148\t                for (int i=m-1;i>=0;i--) iv_pop(&vm->stack, &tmp[i]);\n   149\t                for (int i=m-1;i>=0;i--) iv_pop(&vm->stack, &tmp[i]);\n   150\t                int s = process_stream(impl_id, tmp, (size_t)m);\n   151\t                iv_push(&vm->stack, s);\n   152\t                vm_trace(vm, 14);\n   153\t                break;\n   154\t            }\n   155\t            case 10: return 0; \n   156\t            default: return 99;\n   157\t        }\n   158\t    }\n   159\t    return 0;\n   160\t}\n===== c_src/src/a.c =====\n     1\t// Copyright 2025 MIT Lincoln Laboratory\n     2\t// Permission is hereby granted, free of charge,\n     3\t// to any person obtaining a copy of this software\n     4\t// and associated documentation files (the “Software”),\n     5\t// to deal in the Software without restriction,\n     6\t// including without limitation the rights to use, copy,\n     7\t// modify, merge, publish, distribute, sublicense,\n     8\t// and/or sell copies of the Software,\n     9\t// and to permit persons to whom the Software is furnished to do so,\n    10\t// subject to the following conditions:\n    11\t// \n    12\t// The above copyright notice and this permission notice\n    13\t// shall be included in all copies or substantial portions of the Software.\n    14\t// \n    15\t// THE SOFTWARE IS PROVIDED “AS IS”, WITHOUT WARRANTY OF ANY KIND,\n    16\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    17\t// THE WARRANTIES OF MERCHANTABILITY,\n    18\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    19\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    20\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    21\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    22\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    23\t\n    24\t#include <stddef.h>\n    25\t\n    26\tstatic inline int a_bias_call(int (*fp)(int), int x) {\n    27\t    return fp((x ^ 0x55) + 7);\n    28\t}\n    29\t\n    30\tstatic int state_a;\n    31\t\n    32\tstatic int target(int code) {\n    33\t    if (code < 0) return (state_a & 1) ? 6 : 5;\n    34\t    state_a = state_a ^ (code<<1);\n    35\t    int k = ((code >> 2) ^ state_a) & 7;\n    36\t    switch (k) {\n    37\t        case 0: return 0;\n    38\t        case 1: return 2;\n    39\t        case 2: return 4;\n    40\t        case 3: return 1;\n    41\t        case 4: return 3;\n    42\t        case 5:;\n    43\t        case 6: return 5;\n    44\t        default: return 7;\n    45\t    }\n    46\t}\n    47\t\n    48\tstatic inline int wrap(int x){ return target(x-5); }\n    49\t#define A_MAC_CALL(F, X) a_bias_call((F), (X)) \n    50\t\n    51\tint call_a_once(int x){\n    52\t    int (*fp)(int) = &target;\n    53\t    int a = fp(x);\n    54\t    int b = wrap(a);\n    55\t    int c = target(b ^ 3);\n    56\t    int d = A_MAC_CALL(&target, b);\n    57\t    return a ^ (b << 1) ^ (c << 2) ^ (d << 3);\n    58\t}\n    59\t\n    60\tint process_a_stream(const int *xs, size_t n){\n    61\t    size_t acc=0;\n    62\t    for(size_t i=0;i<n;i++){\n    63\t        int v=xs[i];\n    64\t        for(int j=0;j<3;j++){\n    65\t            int t=target(v+j);\n    66\t            if ((t&1)==0) { acc += t; continue; }\n    67\t            acc ^= (t<<j);\n    68\t            if (t==5) break;\n    69\t        }\n    70\t    }\n    71\t    if (acc > 0x7fffffffLL) acc = 0x7fffffffLL;\n    72\t    if (acc < -0x80000000LL) acc = -0x80000000LL;\n    73\t    return (int)acc;\n    74\t}\n===== c_src/src/b.c =====\n     1\t// Copyright 2025 MIT Lincoln Laboratory\n     2\t// Permission is hereby granted, free of charge,\n     3\t// to any person obtaining a copy of this software\n     4\t// and associated documentation files (the “Software”),\n     5\t// to deal in the Software without restriction,\n     6\t// including without limitation the rights to use, copy,\n     7\t// modify, merge, publish, distribute, sublicense,\n     8\t// and/or sell copies of the Software,\n     9\t// and to permit persons to whom the Software is furnished to do so,\n    10\t// subject to the following conditions:\n    11\t// \n    12\t// The above copyright notice and this permission notice\n    13\t// shall be included in all copies or substantial portions of the Software.\n    14\t// \n    15\t// THE SOFTWARE IS PROVIDED “AS IS”, WITHOUT WARRANTY OF ANY KIND,\n    16\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    17\t// THE WARRANTIES OF MERCHANTABILITY,\n    18\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    19\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    20\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    21\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    22\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    23\t\n    24\t#include <stddef.h>\n    25\t\n    26\tstatic inline int b_twist_call(int (*fp)(int), int x) {\n    27\t    return fp(((x + 9) ^ 0x2222) - 17);\n    28\t}\n    29\t\n    30\tstatic int flipflop;\n    31\t\n    32\tstatic int target(int code){\n    33\t    flipflop ^= 1;\n    34\t    if (code < 0) return flipflop ? 2 : 6;\n    35\t    int z = (code ^ (flipflop? 0x7f:0x1f)) % 8;\n    36\t    if (z==0 || z==7) return 4;\n    37\t    if (z==1 || z==2) return 3;\n    38\t    if (z==3) return 1;\n    39\t    if (z==4) return 0;\n    40\t    if (z==5) return 5;\n    41\t    return 7;\n    42\t}\n    43\t\n    44\tstatic inline int w2(int x){ return target(x+9); }\n    45\t#define B_MAC_CALL(F, X) b_twist_call((F), (X))\n    46\t\n    47\tint call_b_once(int x){\n    48\t    int (*fp)(int) = &target;\n    49\t    int a = target(x);\n    50\t    int b = w2(a);\n    51\t    int c = B_MAC_CALL(&target, a);\n    52\t    int d = fp(c ^ x);\n    53\t    return (a << 1) ^ (b << 2) ^ (c << 3) ^ (d << 4);\n    54\t}\n    55\t\n    56\tint process_b_stream(const int *xs, size_t n){\n    57\t    int acc=1;\n    58\t    for(size_t i=0;i<n;i++){\n    59\t        int v=xs[i];\n    60\t        int iter=0;\n    61\t        while(++iter<=4){\n    62\t            int t = target(v-iter);\n    63\t            if (t==6) { acc -= t; break; }\n    64\t            if (t==3) { continue; }\n    65\t            acc = (acc * 3) ^ t;\n    66\t        }\n    67\t    }\n    68\t    return acc;\n    69\t}\n===== c_src/src/util.c =====\n     1\t// Copyright 2025 MIT Lincoln Laboratory\n     2\t// Permission is hereby granted, free of charge,\n     3\t// to any person obtaining a copy of this software\n     4\t// and associated documentation files (the “Software”),\n     5\t// to deal in the Software without restriction,\n     6\t// including without limitation the rights to use, copy,\n     7\t// modify, merge, publish, distribute, sublicense,\n     8\t// and/or sell copies of the Software,\n     9\t// and to permit persons to whom the Software is furnished to do so,\n    10\t// subject to the following conditions:\n    11\t// \n    12\t// The above copyright notice and this permission notice\n    13\t// shall be included in all copies or substantial portions of the Software.\n    14\t// \n    15\t// THE SOFTWARE IS PROVIDED “AS IS”, WITHOUT WARRANTY OF ANY KIND,\n    16\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    17\t// THE WARRANTIES OF MERCHANTABILITY,\n    18\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    19\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    20\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    21\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    22\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    23\t\n    24\t#include \"../include/util.h\"\n    25\t#include <stdlib.h>\n    26\t#include <string.h>\n    27\t#include <limits.h>\n    28\t#include <stdint.h>\n    29\t\n    30\tvoid iv_init(IntVec *v){ v->data=NULL; v->len=v->cap=0; }\n    31\tvoid iv_free(IntVec *v){ free(v->data); v->data=NULL; v->len=v->cap=0; }\n    32\t\n    33\tbool iv_reserve(IntVec *v, size_t need){\n    34\t    if (need <= v->cap) return true;\n    35\t    size_t nc = v->cap? v->cap:8;\n    36\t    while (nc < need) {\n    37\t        if (nc > (SIZE_MAX/2)) return false;\n    38\t        nc *= 2;\n    39\t    }\n    40\t    int *p = (int*)realloc(v->data, nc*sizeof(int));\n    41\t    if (!p) return false;\n    42\t    v->data = p; v->cap = nc; return true;\n    43\t}\n    44\tbool iv_push(IntVec *v,int x){ if(v->len==v->cap && !iv_reserve(v, v->cap? v->cap*2:8)) return false; v->data[v->len++]=x; return true; }\n    45\tbool iv_pop (IntVec *v,int *out){ if(!v->len) return false; if(out) *out=v->data[v->len-1]; v->len--; return true; }\n    46\tint  iv_peek(const IntVec *v,int def){ return v->len? v->data[v->len-1]: def; }\n    47\t\n    48\tvoid prog_init(Program *p, const int *code, size_t n){ p->code=code; p->n=n; p->ip=0; }\n    49\tbool prog_fetch(Program *p, int *out){ if(p->ip>=p->n) return false; *out=p->code[p->ip++]; return true; }\n    50\t\n    51\tvoid vm_init(VM *vm){ iv_init(&vm->stack); iv_init(&vm->trace); vm->steps=0; }\n    52\tvoid vm_free(VM *vm){ iv_free(&vm->stack); iv_free(&vm->trace); vm->steps=0; }\n    53\tvoid vm_trace(VM *vm, int t){ iv_push(&vm->trace, t); }\n    54\t\n    55\tvoid vm_print(FILE *fp, const char *label, const VM *vm){\n    56\t    fprintf(fp, \"%sSTACK_TOP=%d STEPS=%d TRACE=\", label, iv_peek(&vm->stack, -777), vm->steps);\n    57\t    for (size_t i=0;i<vm->trace.len;i++) fputc(\"abcdefghijklmnopqrstuvwxyz\"[(vm->trace.data[i])&25], fp);\n    58\t    fputc('\\n', fp);\n    59\t}\n===== c_src/src/lib.c =====\n     1\t// Copyright 2025 MIT Lincoln Laboratory\n     2\t// Permission is hereby granted, free of charge,\n     3\t// to any person obtaining a copy of this software\n     4\t// and associated documentation files (the “Software”),\n     5\t// to deal in the Software without restriction,\n     6\t// including without limitation the rights to use, copy,\n     7\t// modify, merge, publish, distribute, sublicense,\n     8\t// and/or sell copies of the Software,\n     9\t// and to permit persons to whom the Software is furnished to do so,\n    10\t// subject to the following conditions:\n    11\t// \n    12\t// The above copyright notice and this permission notice\n    13\t// shall be included in all copies or substantial portions of the Software.\n    14\t// \n    15\t// THE SOFTWARE IS PROVIDED “AS IS”, WITHOUT WARRANTY OF ANY KIND,\n    16\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    17\t// THE WARRANTIES OF MERCHANTABILITY,\n    18\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    19\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    20\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    21\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    22\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    23\t\n    24\t#include \"../include/api.h\"\n    25\t\n    26\tint target(int code) {\n    27\t    if (code < 0) return 7;\n    28\t    int m = code % 10;\n    29\t    if (m == 0) return 0;\n    30\t    if (m <= 3) return 1;\n    31\t    if (m <= 6) return 2;\n    32\t    if (m == 7) return 3;\n    33\t    return 4;\n    34\t}","is_error":false}]},"parent_tool_use_id":null,"session_id":"3ae6ba8e-9c81-4b9f-bd39-3ec717477d24","uuid":"ba16704f-305c-4b99-81b2-1bc1e6be6aa2","timestamp":"2026-08-20T00:15:29.066Z","tool_use_result":{"stdout":"===== c_src/include/api.h =====\n     1\t// Copyright 2025 MIT Lincoln Laboratory\n     2\t// Permission is hereby granted, free of charge,\n     3\t// to any person obtaining a copy of this software\n     4\t// and associated documentation files (the “Software”),\n     5\t// to deal in the Software without restriction,\n     6\t// including without limitation the rights to use, copy,\n     7\t// modify, merge, publish, distribute, sublicense,\n     8\t// and/or sell copies of the Software,\n     9\t// and to permit persons to whom the Software is furnished to do so,\n    10\t// subject to the following conditions:\n    11\t// \n    12\t// The above copyright notice and this permission notice\n    13\t// shall be included in all copies or substantial portions of the Software.\n    14\t// \n    15\t// THE SOFTWARE IS PROVIDED “AS IS”, WITHOUT WARRANTY OF ANY KIND,\n    16\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    17\t// THE WARRANTIES OF MERCHANTABILITY,\n    18\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    19\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    20\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    21\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    22\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    23\t\n    24\t#ifndef API_H\n    25\t#define API_H\n    26\tint target(int code);\n    27\t#endif\n===== c_src/include/util.h =====\n     1\t// Copyright 2025 MIT Lincoln Laboratory\n     2\t// Permission is hereby granted, free of charge,\n     3\t// to any person obtaining a copy of this software\n     4\t// and associated documentation files (the “Software”),\n     5\t// to deal in the Software without restriction,\n     6\t// including without limitation the rights to use, copy,\n     7\t// modify, merge, publish, distribute, sublicense,\n     8\t// and/or sell copies of the Software,\n     9\t// and to permit persons to whom the Software is furnished to do so,\n    10\t// subject to the following conditions:\n    11\t// \n    12\t// The above copyright notice and this permission notice\n    13\t// shall be included in all copies or substantial portions of the Software.\n    14\t// \n    15\t// THE SOFTWARE IS PROVIDED “AS IS”, WITHOUT WARRANTY OF ANY KIND,\n    16\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    17\t// THE WARRANTIES OF MERCHANTABILITY,\n    18\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    19\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    20\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    21\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    22\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    23\t\n    24\t#ifndef UTIL_H\n    25\t#define UTIL_H\n    26\t#include <stddef.h>\n    27\t#include <stdbool.h>\n    28\t#include <stdio.h>\n    29\t\n    30\ttypedef struct {\n    31\t    int *data; size_t len, cap;\n    32\t} IntVec;\n    33\t\n    34\tvoid iv_init(IntVec *v);\n    35\tvoid iv_free(IntVec *v);\n    36\tbool iv_reserve(IntVec *v, size_t need);\n    37\tbool iv_push(IntVec *v, int x);\n    38\tbool iv_pop(IntVec *v, int *out);\n    39\tint  iv_peek(const IntVec *v, int def);\n    40\t\n    41\ttypedef struct {\n    42\t    const int *code; size_t n; size_t ip;\n    43\t} Program;\n    44\t\n    45\tvoid prog_init(Program *p, const int *code, size_t n);\n    46\tbool prog_fetch(Program *p, int *out);\n    47\t\n    48\ttypedef struct {\n    49\t    IntVec stack;\n    50\t    IntVec trace;\n    51\t    int    steps;\n    52\t} VM;\n    53\t\n    54\tvoid vm_init(VM *vm);\n    55\tvoid vm_free(VM *vm);\n    56\tvoid vm_trace(VM *vm, int t);\n    57\tvoid vm_print(FILE *fp, const char *label, const VM *vm);\n    58\t\n    59\tint run_engine(int impl_id, const int *code, size_t n, VM *vm);\n    60\t\n    61\t#endif\n===== c_src/src/main.c =====\n     1\t// Copyright 2025 MIT Lincoln Laboratory\n     2\t// Permission is hereby granted, free of charge,\n     3\t// to any person obtaining a copy of this software\n     4\t// and associated documentation files (the “Software”),\n     5\t// to deal in the Software without restriction,\n     6\t// including without limitation the rights to use, copy,\n     7\t// modify, merge, publish, distribute, sublicense,\n     8\t// and/or sell copies of the Software,\n     9\t// and to permit persons to whom the Software is furnished to do so,\n    10\t// subject to the following conditions:\n    11\t// \n    12\t// The above copyright notice and this permission notice\n    13\t// shall be included in all copies or substantial portions of the Software.\n    14\t// \n    15\t// THE SOFTWARE IS PROVIDED “AS IS”, WITHOUT WARRANTY OF ANY KIND,\n    16\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    17\t// THE WARRANTIES OF MERCHANTABILITY,\n    18\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    19\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    20\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    21\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    22\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    23\t\n    24\t#include <stdio.h>\n    25\t#include <stdlib.h>\n    26\t#include <string.h>\n    27\t#include <stdbool.h>\n    28\t#include \"../include/util.h\"\n    29\t#include \"../include/api.h\"\n    30\t\n    31\tint run_engine(int impl_id, const int *code, size_t n, VM *vm);\n    32\t\n    33\tstatic void usage(const char *p){\n    34\t    fprintf(stderr, \"Usage: %s [--stdin] [bytecodes...]\\n\"\n    35\t                    \"Bytecodes are integers forming a small VM program.\\n\", p);\n    36\t}\n    37\t\n    38\tstatic size_t read_stdin(IntVec *v){\n    39\t    char buf[4096];\n    40\t    size_t count=0;\n    41\t    while (fgets(buf, sizeof buf, stdin)) {\n    42\t        char *p = buf;\n    43\t        while (*p) {\n    44\t            char *q=p;\n    45\t            while (*q && *q!=' ' && *q!='\\t' && *q!='\\n' && *q!='\\r') ++q;\n    46\t            char save=*q; *q='\\0';\n    47\t            if (*p) {\n    48\t                char *e=NULL; long t=strtol(p,&e,10);\n    49\t                if (e && *e=='\\0') { iv_push(v,(int)t); count++; }\n    50\t            }\n    51\t            *q=save;\n    52\t            p = (*q? q+1 : q);\n    53\t        }\n    54\t    }\n    55\t    return count;\n    56\t}\n    57\t\n    58\tint main(int argc, char **argv){\n    59\t    bool use_stdin=false;\n    60\t    IntVec code; iv_init(&code);\n    61\t\n    62\t    for (int i=1;i<argc;i++){\n    63\t        if (!strcmp(argv[i],\"--help\")) { usage(argv[0]); iv_free(&code); return 0; }\n    64\t        else if (!strcmp(argv[i],\"--stdin\")) use_stdin=true;\n    65\t        else {\n    66\t            char *e=NULL; long t=strtol(argv[i],&e,10);\n    67\t            if (e && *e=='\\0') iv_push(&code,(int)t);\n    68\t            else fprintf(stderr,\"skip '%s'\\n\", argv[i]);\n    69\t        }\n    70\t    }\n    71\t    if (use_stdin) read_stdin(&code);\n    72\t    if (code.len==0) {\n    73\t        fprintf(stderr,\"no program\\n\");\n    74\t        iv_free(&code); return 2;\n    75\t    }\n    76\t\n    77\t    VM vmA, vmB, vmE;\n    78\t    vm_init(&vmA); vm_init(&vmB); vm_init(&vmE);\n    79\t\n    80\t    int rcA = run_engine(0, code.data, code.len, &vmA);\n    81\t    int rcB = run_engine(1, code.data, code.len, &vmB);\n    82\t    int rcE = run_engine(2, code.data, code.len, &vmE);\n    83\t\n    84\t    printf(\"RC:A=%d B=%d EXT=%d\\n\", rcA, rcB, rcE);\n    85\t    vm_print(stdout, \"A:\", &vmA);\n    86\t    vm_print(stdout, \"B:\", &vmB);\n    87\t    vm_print(stdout, \"EXT:\", &vmE);\n    88\t\n    89\t    vm_free(&vmA); vm_free(&vmB); vm_free(&vmE);\n    90\t    iv_free(&code);\n    91\t    return 0;\n    92\t}\n===== c_src/src/engine.c =====\n     1\t// Copyright 2025 MIT Lincoln Laboratory\n     2\t// Permission is hereby granted, free of charge,\n     3\t// to any person obtaining a copy of this software\n     4\t// and associated documentation files (the “Software”),\n     5\t// to deal in the Software without restriction,\n     6\t// including without limitation the rights to use, copy,\n     7\t// modify, merge, publish, distribute, sublicense,\n     8\t// and/or sell copies of the Software,\n     9\t// and to permit persons to whom the Software is furnished to do so,\n    10\t// subject to the following conditions:\n    11\t// \n    12\t// The above copyright notice and this permission notice\n    13\t// shall be included in all copies or substantial portions of the Software.\n    14\t// \n    15\t// THE SOFTWARE IS PROVIDED “AS IS”, WITHOUT WARRANTY OF ANY KIND,\n    16\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    17\t// THE WARRANTIES OF MERCHANTABILITY,\n    18\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    19\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    20\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    21\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    22\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    23\t\n    24\t#include \"../include/util.h\"\n    25\t#include \"../include/api.h\"\n    26\t#include <alloca.h>\n    27\t#include <string.h>\n    28\t\n    29\tint call_a_once(int x);\n    30\tint process_a_stream(const int *xs, size_t n);\n    31\tint call_b_once(int x);\n    32\tint process_b_stream(const int *xs, size_t n);\n    33\t\n    34\tstatic inline int inline_call(int (*f)(int), int x){ return f(x); }\n    35\t\n    36\t#define MAC_CALL(F,X) ((F)((X)+1))\n    37\t\n    38\tstatic int classify(int impl, int x){\n    39\t    if (impl==0) { extern int call_a_once(int); return inline_call(call_a_once, x); }\n    40\t    if (impl==1) { extern int call_b_once(int); return MAC_CALL(call_b_once, x); }\n    41\t    \n    42\t    return inline_call(&target, MAC_CALL(target, x));\n    43\t}\n    44\t\n    45\tstatic int process_stream(int impl, const int *buf, size_t n){\n    46\t    if (impl==0) return process_a_stream(buf, n);\n    47\t    if (impl==1) return process_b_stream(buf, n);\n    48\t    \n    49\t    int acc=0;\n    50\t    for(size_t i=0;i<n;i++){\n    51\t        int t = target(buf[i]);\n    52\t        if ((t&1)==0) acc += (t*2);\n    53\t        else          acc ^= (t+7);\n    54\t    }\n    55\t    return acc;\n    56\t}\n    57\t\n    58\tint run_engine(int impl_id, const int *code, size_t n, VM *vm){\n    59\t    Program p; prog_init(&p, code, n);\n    60\t    int op;\n    61\t    while (prog_fetch(&p, &op)) {\n    62\t        vm->steps++;\n    63\t        switch (op) {\n    64\t            case 0: { \n    65\t                int imm; if (!prog_fetch(&p, &imm)) return 1;\n    66\t                iv_push(&vm->stack, imm);\n    67\t                vm_trace(vm, 0);\n    68\t                break;\n    69\t            }\n    70\t            case 1: { \n    71\t                int a,b; if(!iv_pop(&vm->stack,&b)||!iv_pop(&vm->stack,&a)) return 2;\n    72\t                iv_push(&vm->stack, a+b);\n    73\t                vm_trace(vm, 1);\n    74\t                break;\n    75\t            }\n    76\t            case 2: { \n    77\t                int a,b; if(!iv_pop(&vm->stack,&b)||!iv_pop(&vm->stack,&a)) return 3;\n    78\t                iv_push(&vm->stack, a*b);\n    79\t                vm_trace(vm, 2);\n    80\t                break;\n    81\t            }\n    82\t            case 3: { \n    83\t                int a = iv_peek(&vm->stack, 0);\n    84\t                iv_push(&vm->stack, a);\n    85\t                vm_trace(vm, 3);\n    86\t                break;\n    87\t            }\n    88\t            case 4: { \n    89\t                int tmp; if(!iv_pop(&vm->stack,&tmp)) return 4;\n    90\t                vm_trace(vm, 4);\n    91\t                break;\n    92\t            }\n    93\t            case 5: { \n    94\t                int x = iv_peek(&vm->stack, 0);\n    95\t                int bucket = classify(impl_id, x);\n    96\t                iv_push(&vm->stack, bucket);\n    97\t                \n    98\t                switch (bucket) {\n    99\t                    case 0: vm_trace(vm, 5); break;\n   100\t                    case 1: vm_trace(vm, 6); break;\n   101\t                    case 2: vm_trace(vm, 7); break;\n   102\t                    case 3:;\n   103\t                    case 4: vm_trace(vm, 8); break;\n   104\t                    default: vm_trace(vm, 9); break;\n   105\t                }\n   106\t                break;\n   107\t            }\n   108\t            case 6: { \n   109\t                int k; if(!prog_fetch(&p,&k)) return 5;\n   110\t                int cond; if(!iv_pop(&vm->stack,&cond)) return 6;\n   111\t                if (cond) {\n   112\t                    \n   113\t                    if ((size_t)k > p.n - p.ip) return 7;\n   114\t                    p.ip += (size_t)k;\n   115\t                    vm_trace(vm, 10);\n   116\t                } else {\n   117\t                    vm_trace(vm, 11);\n   118\t                }\n   119\t                break;\n   120\t            }\n   121\t            case 7: { \n   122\t                int times; if(!prog_fetch(&p,&times)) return 8;\n   123\t                if (p.ip>=p.n) return 9;\n   124\t                size_t saved_ip = p.ip;\n   125\t                for (int i=0;i<times;i++){\n   126\t                    Program inner = p; inner.ip = saved_ip;\n   127\t                    int rc = run_engine(impl_id, inner.code + inner.ip, 1, vm);\n   128\t                    if (rc) { \n   129\t                        p.ip = saved_ip + 1; \n   130\t                        vm_trace(vm, 12);\n   131\t                        break;\n   132\t                    }\n   133\t                }\n   134\t                p.ip = saved_ip + 1;\n   135\t                break;\n   136\t            }\n   137\t            case 8: { \n   138\t                int x = iv_peek(&vm->stack, 0);\n   139\t                int y = classify(impl_id, x);\n   140\t                iv_push(&vm->stack, y);\n   141\t                vm_trace(vm, 13);\n   142\t                break;\n   143\t            }\n   144\t            case 9: { \n   145\t                int m; if(!prog_fetch(&p,&m)) return 10;\n   146\t                if (m<0 || (size_t)m > vm->stack.len) return 11;\n   147\t                int tmp[m];\n   148\t                for (int i=m-1;i>=0;i--) iv_pop(&vm->stack, &tmp[i]);\n   149\t                for (int i=m-1;i>=0;i--) iv_pop(&vm->stack, &tmp[i]);\n   150\t                int s = process_stream(impl_id, tmp, (size_t)m);\n   151\t                iv_push(&vm->stack, s);\n   152\t                vm_trace(vm, 14);\n   153\t                break;\n   154\t            }\n   155\t            case 10: return 0; \n   156\t            default: return 99;\n   157\t        }\n   158\t    }\n   159\t    return 0;\n   160\t}\n===== c_src/src/a.c =====\n     1\t// Copyright 2025 MIT Lincoln Laboratory\n     2\t// Permission is hereby granted, free of charge,\n     3\t// to any person obtaining a copy of this software\n     4\t// and associated documentation files (the “Software”),\n     5\t// to deal in the Software without restriction,\n     6\t// including without limitation the rights to use, copy,\n     7\t// modify