fn row17_len_zero_prints_nothing() {\n    let mut rng = Rng::new(0x1111);\n    for i in 0..20 {\n        let n = rng.range_incl(1, 32) as usize;\n        let vals = rand_vals(&mut rng, n);\n        assert_driver_matches(&format!(\"row17#{i}\"), &vals, 0);\n\n        // and the output really is empty / the buffer really is untouched\n        let l = common::libs();\n        let mut buf = vals.clone();\n        let (_, out) = common::capture_stdout(\"c0\", || {\n            let f = l.c_driver();\n            unsafe { f(buf.as_mut_ptr(), 0) };\n        });\n        assert!(out.is_empty(), \"C driver printed {out:?} for len=0\");\n        assert_eq!(buf, vals, \"C driver mutated the buffer for len=0\");\n    }\n}\n\n#[test]\nfn row18_negative_len_prints_nothing() {\n    let mut rng = Rng::new(0x1212);\n    let lens: [c_int; 5] = [-1, -2, -100, c_int::MIN + 1, c_int::MIN];\n    for (i, &len) in lens.iter().enumerate() {\n        for j in 0..8 {\n            let n = rng.range_incl(1, 32) as usize;\n            let vals = rand_vals(&mut rng, n);\n            assert_driver_matches(&format!(\"row18#{i}.{j}(len={len})\"), &vals, len);\n\n            let l = common::libs();\n            let mut buf = vals.clone();\n            let (_, out) = common::capture_stdout(\"cneg\", || {\n                let f = l.c_driver();\n                unsafe { f(buf.as_mut_ptr(), len) };\n            });\n            assert!(out.is_empty(), \"C driver printed {out:?} for len={len}\");\n            assert_eq!(buf, vals, \"C driver mutated the buffer for len={len}\");\n        }\n    }\n}\n\n#[test]\nfn row19_len_one_random() {\n    let mut rng = Rng::new(0x1313);\n    for i in 0..ITERS {\n        let vals = rand_vals(&mut rng, 1);\n        assert_driver_matches(&format!(\"row19#{i}\"), &vals, 1);\n    }\n}\n\n#[test]\nfn row20_len_2_to_8_random() {\n    let mut rng = Rng::new(0x1414);\n    for i in 0..ITERS {\n        let len = rng.range_incl(2, 8) as c_int;\n        let vals = rand_vals(&mut rng, len as usize);\n        assert_driver_matches(&format!(\"row20#{i}\"), &vals, len);\n    }\n}\n\n#[test]\nfn row21_len_100_random() {\n    let mut rng = Rng::new(0x1515);\n    for i in 0..ITERS {\n        let vals = rand_vals(&mut rng, 100);\n        assert_driver_matches(&format!(\"row21#{i}\"), &vals, 100);\n    }\n}\n\n#[test]\nfn row22_len_1000_random() {\n    let mut rng = Rng::new(0x1616);\n    for i in 0..20 {\n        let vals = rand_vals(&mut rng, 1000);\n        assert_driver_matches(&format!(\"row22#{i}\"), &vals, 1000);\n    }\n}\n\n#[test]\nfn row23_extreme_values() {\n    let mut rng = Rng::new(0x1717);\n    // Every extreme value on its own first (printf(\"%d\") of INT_MIN etc).\n    for (i, &v) in EXTREMES.iter().enumerate() {\n        assert_driver_matches(&format!(\"row23-single#{i}\"), &[v], 1);\n    }\n    for i in 0..ITERS {\n        let len = rng.range_incl(1, 64) as c_int;\n        let vals: Vec<i32> = (0..len).map(|_| *rng.pick(EXTREMES)).collect();\n        assert_driver_matches(&format!(\"row23#{i}\"), &vals, len);\n    }\n}\n\n#[test]\nfn row24_small_values_no_overflow() {\n    let mut rng = Rng::new(0x1818);\n    for i in 0..ITERS {\n        let len = rng.range_incl(1, 64) as c_int;\n        let vals: Vec<i32> = (0..len).map(|_| rng.range_incl(-100, 100) as i32).collect();\n        assert_driver_matches(&format!(\"row24#{i}\"), &vals, len);\n    }\n}\n\n#[test]\nfn row25_driver_called_twice_on_same_buffer() {\n    let mut rng = Rng::new(0x1919);\n    for i in 0..ITERS {\n        let len = rng.range_incl(1, 32) as c_int;\n        let vals: Vec<i32> = (0..len)\n            .map(|_| if rng.bool() { rng.next_i32() } else { *rng.pick(EXTREMES) })\n            .collect();\n        assert_driver_twice_matches(&format!(\"row25#{i}\"), &vals, len);\n    }\n}\n","userModified":false}}
