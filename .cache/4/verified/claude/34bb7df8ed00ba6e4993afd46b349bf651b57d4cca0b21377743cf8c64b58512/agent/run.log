;\n56\t    cassert!(map.size() == 3);\n57\t    cassert!(vals[map.get(1).unwrap()] == 500);\n58\t\n59\t    // Test remove\n60\t    let removed = map.remove(2);\n61\t    cassert!(removed == Some(val2));\n62\t    cassert!(map.size() == 2);\n63\t    cassert!(map.get(2).is_none());\n64\t\n65\t    // Test contains\n66\t    cassert!(map.contains(1) == 1);\n67\t    cassert!(map.contains(2) == 0);\n68\t    cassert!(map.contains(3) == 1);\n69\t\n70\t    drop(map);\n71\t    test_pass!(\"test_hashmap_basic\");\n72\t}\n73\t\n74\tfn test_hashmap_collisions() {\n75\t    cprintf!(\"\\n=== Testing Hashmap Collisions ===\\n\");\n76\t\n77\t    let mut map: Hashmap<usize> = Hashmap::create();\n78\t\n79\t    // Add many items to force collisions\n80\t    let mut values = [0i32; 100];\n81\t    for i in 0..100usize {\n82\t        values[i] = (i as i32) * 10;\n83\t        cassert!(map.put(i as u64, i) == 0);\n84\t    }\n85\t\n86\t    cassert!(map.size() == 100);\n87\t\n88\t    // Verify all values\n89\t    for i in 0..100usize {\n90\t        let val = map.get(i as u64);\n91\t        cassert!(val.is_some());\n92\t        cassert!(values[val.unwrap()] == (i as i32) * 10);\n93\t    }\n94\t\n95\t    drop(map);\n96\t    test_pass!(\"test_hashmap_collisions\");\n97\t}\n98\t\n99\tfn test_tree_creation() {\n100\t    cprintf!(\"\\n=== Testing Tree Creation ===\\n\");\n101\t\n102\t    let tree = Tree::create();\n103\t    cassert!(tree.size() == 0);\n104\t    cassert!(tree.has_root == 0);\n105\t\n106\t    tree.delete();\n107\t    test_pass!(\"test_tree_creation\");\n108\t}\n109\t\n110\tfn test_tree_add_root() {\n111\t    cprintf!(\"\\n=== Testing Tree Add Root ===\\n\");\n112\t\n113\t    let mut tree = Tree::create();\n114\t\n115\t    // Add root node\n116\t    cassert!(tree.add_node(1, 0, Some(\"root\")) == 0);\n117\t    cassert!(tree.size() == 1);\n118\t    cassert!(tree.has_root == 1);\n119\t    cassert!(tree.root_id == 1);\n120\t\n121\t    let root = tree.get_node(1);\n122\t    cassert!(root.is_s