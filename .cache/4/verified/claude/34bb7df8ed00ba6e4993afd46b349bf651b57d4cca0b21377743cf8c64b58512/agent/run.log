;\n46\t    return load > HASHMAP_LOAD_FACTOR;\n47\t}\n48\t\n49\tstatic int hashmap_resize(hashmap_t *map) {\n50\t    size_t old_capacity = map->capacity;\n51\t    hashmap_entry_t *old_entries = map->entries;\n52\t    \n53\t    // Double capacity\n54\t    map->capacity *= 2;\n55\t    map->entries = calloc(map->capacity, sizeof(hashmap_entry_t));\n56\t    if (!map->entries) {\n57\t        map->entries = old_entries;\n58\t        map->capacity = old_capacity;\n59\t        return -1;\n60\t    }\n61\t    \n62\t    map->size = 0;\n63\t    map->deleted_count = 0;\n64\t    \n65\t    // Rehash all entries\n66\t    for (size_t i = 0; i < old_capacity; i++) {\n67\t        if (old_entries[i].occupied && !old_entries[i].deleted) {\n68\t            hashmap_put(map, old_entries[i].key, old_entries[i].value);\n69\t        }\n70\t    }\n71\t    \n72\t    free(old_entries);\n73\t    return 0;\n74\t}\n75\t\n76\thashmap_t* hashmap_create(void) {\n77\t    hashmap_t *map = malloc(sizeof(hashmap_t));\n78\t    if (!map) {\n79\t        return NULL;\n80\t    }\n81\t    \n82\t    map->capacity = HASHMAP_INITIAL_CAPACITY;\n83\t    map->size = 0;\n84\t    map->deleted_count = 0;\n85\t    map->entries = calloc(map->capacity, sizeof(hashmap_entry_t));\n86\t    \n87\t    if (!map->entries) {\n88\t        free(map);\n89\t        return NULL;\n90\t    }\n91\t    \n92\t    return map;\n93\t}\n94\t\n95\tvoid hashmap_destroy(hashmap_t *map) {\n96\t    if (map) {\n97\t        free(map->entries);\n98\t        free(map);\n99\t    }\n100\t}\n101\t\n102\tint hashmap_put(hashmap_t *map, tree_id_t key, void *value) {\n103\t    if (!map) {\n104\t        return -1;\n105\t    }\n106\t    \n107\t    if (should_resize(map)) {\n108\t        if (hashmap_resize(map) != 0) {\n109\t            return -1;\n110\t        }\n111\t    }\n112\t    \n113\t    uint64_t hash = hash_function(key);\n114\t    size_t index = hash % map->capacity;\n115\t    size_t probe = 0;\n116\t    \n117\t    // Linear probing\n118\t    while (probe < map->capacity) {\n119\t        size_t current = (index + probe) % map->capacity;\n120\t        \n121\t        if (!map->entries[current].occupied) {\n122\t            // Empty slot\n123\t            map->entries[current].key = key;\n124\t            map->entries[current].value = value;\n125\t            map->entries[current].occupied = 1;\n126\t            map->entries[current].deleted = 0;\n127\t            map->size++;\n128\t            return 0;\n129\t        } else if (map->entries[current].deleted) {\n130\t            // Reuse deleted slot\n131\t            map->entries[current].key = key;\n132\t            map->entries[current].value = value;\n133\t            map->entries[current].deleted = 0;\n134\t            map->size++;\n135\t            map->deleted_count--;\n136\t            return 0;\n137\t        } else if (map->entries[current].key == key) {\n138\t            // Update existing\n139\t            map->entries[current].value = value;\n140\t            return 0;\n141\t        }\n142\t        \n143\t        probe++;\n144\t    }\n145\t    \n146\t    return -1; // Map is full (shouldn't happen with resizing)\n147\t}\n148\t\n149\tvoid* hashmap_get(hashmap_t *map, tree_id_t key) {\n150\t    if (!map) {\n151\t        return NULL;\n152\t    }\n153\t    \n154\t    uint64_t hash = hash_function(key);\n155\t    size_t index = hash % map->capacity;\n156\t    size_t probe = 0;\n157\t    \n158\t    while (probe < map->capacity) {\n159\t        size_t current = (index + probe) % map->capacity;\n160\t        \n161\t        if (!map->entries[current].occupied) {\n162\t            return NULL;\n163\t        }\n164\t        \n165\t        if (!map->entries[current].deleted && map->entries[current].key == key) {\n166\t            return map->entries[current].value;\n167\t        }\n168\t        \n169\t        probe++;\n170\t    }\n171\t    \n172\t    return NULL;\n173\t}\n174\t\n175\tvoid* hashmap_remove(hashmap_t *map, tree_id_t key) {\n176\t    if (!map) {\n177\t 