(node) {\n52\t        free(node);\n53\t    }\n54\t}\n55\t\n56\tvoid tree_delete(tree_t *tree) {\n57\t    if (!tree) {\n58\t        return;\n59\t    }\n60\t    \n61\t    // Free all nodes in the hashmap\n62\t    for (size_t i = 0; i < tree->node_map->capacity; i++) {\n63\t        if (tree->node_map->entries[i].occupied && \n64\t            !tree->node_map->entries[i].deleted) {\n65\t            tree_free_node((tree_node_t *)tree->node_map->entries[i].value);\n66\t        }\n67\t    }\n68\t    \n69\t    hashmap_destroy(tree->node_map);\n70\t    free(tree);\n71\t}\n72\t\n73\tint tree_add_node(tree_t *tree, tree_id_t id, tree_id_t parent_id, const char *data) {\n74\t    if (!tree) {\n75\t        return -1;\n76\t    }\n77\t    \n78\t    // Check if node already exists\n79\t    if (tree_contains(tree, id)) {\n80\t        fprintf(stderr, \"Error: Node with ID %lu already exists\\n\", id);\n81\t        return -1;\n82\t    }\n83\t    \n84\t    // Allocate new node\n85\t    tree_node_t *node = malloc(sizeof(tree_node_t));\n86\t    if (!node) {\n87\t        fprintf(stderr, \"Error: Failed to allocate node\\n\");\n88\t        return -1;\n89\t    }\n90\t    \n91\t    node->id = id;\n92\t    node->parent_id = parent_id;\n93\t    node->child_count = 0;\n94\t    \n95\t    if (data) {\n96\t        strncpy(node->data, data, MAX_DATA_LENGTH - 1);\n97\t        node->data[MAX_DATA_LENGTH - 1] = '\\0';\n98\t    } else {\n99\t        node->data[0] = '\\0';\n100\t    }\n101\t    \n102\t    // If this is the first node, make it the root\n103\t    if (!tree->has_root) {\n104\t        tree->root_id = id;\n105\t        tree->has_root = 1;\n106\t        node->parent_id = 0; // Root has no parent\n107\t    } else {\n108\t        // Find parent and add this node as a child\n109\t        tree_node_t *parent = tree_get_node(tree, parent_id);\n110\t        if (!parent) {\n111\t            fprintf(stderr, \"Error: Parent node %lu not found\\n\", parent_id);\n112\t            free(node);\n113\t            return -1;\n114\t        }\n115\t        \n116\t        if (parent->child_count >= MAX_CHILDREN) {\n117\t            fprintf(stderr, \"Error: Parent has maximum children\\n\");\n118\t            free(node);\n119\t            return -1;\n120\t        }\n121\t        \n122\t        parent->child_ids[parent->child_count++] = id;\n123\t    }\n124\t    \n125\t    // Add to hashmap\n126\t    if (hashmap_put(tree->node_map, id, node) != 0) {\n127\t        fprintf(stderr, \"Error: Failed to add node to hashmap\\n\");\n128\t        free(node);\n129\t        return -1;\n130\t    }\n131\t    \n132\t    tree->node_count++;\n133\t    return 0;\n134\t}\n135\t\n136\tstatic int tree_remove_subtree(tree_t *tree, tree_id_t id) {\n137\t    tree_node_t *node = tree_get_node(tree, id);\n138\t    if (!node) {\n139\t        return -1;\n140\t    }\n141\t    \n142\t    // Recursively remove all children first\n143\t    for (int i = 0; i < node->child_count; i++) {\n144\t        tree_remove_subtree(tree, node->child_ids[i]);\n145\t    }\n146\t    \n147\t    // Remove this node from hashmap\n148\t    tree_node_t *removed = (tree_node_t *)hashmap_remove(tree->node_map, id);\n149\t    if (removed) {\n150\t        tree_free_node(removed);\n151\t        tree->node_count--;\n152\t    }\n153\t    \n154\t    return 0;\n155\t}\n156\t\n157\tint tree_remove_node(tree_t *tree, tree_id_t id) {\n158\t    if (!tree) {\n159\t        return -1;\n160\t    }\n161\t    \n162\t    tree_node_t *node = tree_get_node(tree, id);\n163\t    if (!node) {\n164\t        fprintf(stderr, \"Error: Node %lu not found\\n\", id);\n165\t        return -1;\n166\t    }\n167\t    \n168\t    // If removing root, tree becomes empty\n169\t    if (id == tree->root_id) {\n170\t        tree_remove_subtree(tree, id);\n171\t        tree->has_root = 0;\n172\t        tree->root_id = 0;\n173\t        return 0;\n174\t    }\n175\t    \n176\t    // Remove from parent's child list\n177\t    tree_node_t *parent = tree_get_node(tree, node->parent_id);\n178\t    if (parent) {\n179\t        for (int i = 0; i < parent->child_count; i++) {\n180\t            if (parent->child_ids[i] == id) {\n181\t                // Shift remaining children\n182\t                for (int j = i; j < parent->child_count - 1; j++) {\n183\t                    parent->child_ids[j] = parent->child_ids[j + 1];\n184\t                }\n185\t                parent->child_count--;\n186\t                break;\n187\t            }\n188\t        }\n189\t    }\n190\t    \n191\t    // Remove this node and all descendants\n192\t    tree_remove_subtree(tree, id);\n193\t    \n194\t    return 0;\n195\t}\n196\t\n197\ttree_node_t* tree_get_node(tree_t *tree, tree_id_t id) {\n198\t    if (!tree) {\n199\t        return NULL;\n200\t    }\n201\t    \n202\t    return (tree_node_t *)hashmap_get(tree->node_map, id);\n203\t}\n204\t\n205\tint tree_contains(tree_t *tree, tree_id_t id) {\n206\t    return tree_get_node(tree, id) != NULL;\n207\t}\n208\t\n209\tsize_t tree_size(tree_t *tree) {\n210\t    return tree ? tree->node_count : 0;\n211\t}\n212\t\n213\tstatic void tree_print_helper(tree_t *tree, tree_id_t id, int depth) {\n214\t    tree_node_t *node = tree_get_node(tree, id);\n215\t    if (!node) {\n216\t        return;\n217\t    }\n218\t    \n219\t    // Print indentation\n220\t    for (int i = 0; i < depth; i++) {\n221\t        printf(\"  \");\n222\t    }\n223\t    \n224\t    printf(\"[%lu] %s\\n\", node->id, node->data);\n225\t    \n226\t    // Print children\n227\t    for (int i = 0; i < node->child_count; i++) {\n228\t        tree_print_helper(tree, node->child_ids[i], depth + 1);\n229\t    }\n230\t}\n231\t\n232\tvoid tree_print(tree_t *tree) {\n233\t    if (!tree || !tree->has_root) {\n234\t        printf(\"(empty tree)\\n\");\n235\t        return;\n236\t    }\n237\t    \n238\t    tree_print_helper(tree, tree->root_id, 0);\n239\t}\n240\t\n241\tint tree_get_depth(tree_t *tree, tree_id_t id) {\n242\t    if (!tree || !tree_contains(tree, id)) {\n243\t        return -1;\n244\t    }\n245\t    \n246\t    int depth = 0;\n247\t    tree_id_t current_id = id;\n248\t    \n249\t    while (current_id != tree->root_id) {\n250\t        tree_node_t *node = tree_get_node(tree, current_id);\n251\t        if (!node) {\n252\t            return -1;\n253\t        }\n254\t        current_id = node->parent_id;\n255\t        depth++;\n256\t    }\n257\t    \n258\t    return depth;\n259\t}\n260\t\n261\tint tree_get_height(tree_t *tree, tree_id_t id) {\n262\t    tree_node_t *node = tree_get_node(tree, id);\n263\t    if (!node) {\n264\t        return -1;\n265\t    }\n266\t    \n267\t    if (node->child_count == 0) {\n268\t        return 0;\n269\t    }\n270\t    \n271\t    int max_height = 0;\n272\t    for (int i = 0; i < node->child_count; i++) {\n273\t        int child_height = tree_get_height(tree, node->child_ids[i]);\n274\t        if (child_height > max_height) {\n275\t            max_height = child_height;\n276\t        }\n277\t    }\n278\t    \n279\t    return max_height + 1;\n280\t}\n281\t\n282\tint tree_count_descendants(tree_t *tree, tree_id_t id) {\n283\t    tree_node_t *node = tree_get_node(tree, id);\n284\t    if (!node) {\n285\t        return -1;\n286\t    }\n287\t    \n288\t    int count = 0;\n289\t    for (int i = 0; i < node->child_count; i++) {\n290\t        count++; // Count the child\n291\t        count += tree_count_descendants(tree, node->child_ids[i]);\n292\t    }\n293\t    \n294\t    return count;\n295\t}\n296\t\n297\tint tree_find_path(tree_t *tree, tree_id_t id, tree_id_t *path, int max_length) {\n298\t    if (!tree || !path || !tree_contains(tree, id)) {\n299\t        return -1;\n300\t    }\n301\t    \n302\t    // Build path from node to root, then reverse\n303\t    tree_id_t temp_path[1000];\n304\t    int length = 0;\n305\t    tree_id_t current_id = id;\n306\t    \n307\t    while (length < 1000) {\n308\t        temp_path[length++] = current_id;\n309\t        \n310\t        if (current_id == tree->root_id) {\n311\t            break;\n312\t        }\n313\t        \n314\t        tree_node_t *node = tree_get_node(tree, current_id);\n315\t        if (!node) {\n316\t            return -1;\n317\t        }\n318\t        current_id = node->parent_id;\n319\t    }\n320\t    \n321\t    // Reverse into output path\n322\t    if (length > max_length) {\n323\t        length = max_length;\n324\t    }\n325\t    \n326\t    for (int i = 0; i < length; i++) {\n327\t        path[i] = temp_path[length - 1 - i];\n328\t    }\n329\t    \n330\t    return length;\n331\t}\n332\t"}]},"parent_tool_use_id":null,"session_id":"9135168b-ddb2-4629-80cd-b34a9b6f8618","uuid":"0f0a8aa3-2a70-4c20-80ba-bdc0737143f8","timestamp":"2026-08-19T20:37:26.262Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-kFE9jj/translated_rust/c_src/src/tree.c","content":"/*\n * Copyright 2025 MIT Lincoln Laboratory\n * Permission is hereby granted, free of charge,\n * to any person obtaining a copy of this software\n * and associated documentation files (the \"Software\"),\n * to deal in the Software without restriction,\n * including without limitation the rights to use, copy,\n * modify, merge, publish, distribute, sublicense,\n * and/or sell copies of the Software,\n * and to permit persons to whom the Software is furnished to do so,\n * subject to the following conditions:\n * \n * The above copyright notice and this permission notice\n * shall be included in all copies or substantial portions of the Software.\n * \n * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n * THE WARRANTIES OF MERCHANTABILITY,\n * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n */\n// tree.c\n#include \"tree.h\"\n#include <stdlib.h>\n#include <string.h>\n#include <stdio.h>\n\ntree_t* tree_create(void) {\n    tree_t *tree = malloc(sizeof(tree_t));\n    if (!tree) {\n        return NULL;\n    }\n    \n    tree->node_map = hashmap_create();\n    if (!tree->node_map) {\n        free(tree);\n        return NULL;\n    }\n    \n    tree->root_id = 0;\n    tree->has_root = 0;\n    tree->node_count = 0;\n    \n    return tree;\n}\n\nstatic void tree_free_node(tree_node_t *node) {\n    if (node) {\n        free(node);\n    }\n}\n\nvoid tree_delete(tree_t *tree) {\n    if (!tree) {\n        return;\n    }\n    \n    // Free all nodes in the hashmap\n    for (size_t i = 0; i < tree->node_map->capacity; i++) {\n        if (tree->node_map->entries[i].occupied && \n            !tree->node_map->entries[i].deleted) {\n            tree_free_node((tree_node_t *)tree->node_map->entries[i].value);\n        }\n    }\n    \n    hashmap_destroy(tree->node_map);\n    free(tree);\n}\n\nint tree_add_node(tree_t *tree, tree_id_t id, tree_id_t parent_id, const char *data) {\n    if (!tree) {\n        return -1;\n    }\n    \n    // Check if node already exists\n    if (tree_contains(tree, id)) {\n        fprintf(stderr, \"Error: Node with ID %lu already exists\\n\", id);\n        return -1;\n    }\n    \n    // Allocate new node\n    tree_node_t *node = malloc(sizeof(tree_node_t));\n    if (!node) {\n        fprintf(stderr, \"Error: Failed to allocate node\\n\");\n        return -1;\n    }\n    \n    node->id = id;\n    node->parent_id = parent_id;\n    node->child_count = 0;\n    \n    if (data) {\n        strncpy(node->data, data, MAX_DATA_LENGTH - 1);\n        node->data[MAX_DATA_LENGTH - 1] = '\\0';\n    } else {\n        node->data[0] = '\\0';\n    }\n    \n    // If this is the first node, make it the root\n    if (!tree->has_root) {\n        tree->root_id = id;\n        tree->has_root = 1;\n        node->parent_id = 0; // Root has no parent\n    } else {\n        // Find parent and add this node as a child\n        tree_node_t *parent = tree_get_node(tree, parent_id);\n        if (!parent) {\n            fprintf(stderr, \"Error: Parent node %lu not found\\n\", parent_id);\n            free(node);\n            return -1;\n        }\n        \n        if (parent->child_count >= MAX_CHILDREN) {\n            fprintf(stderr, \"Error: Parent has maximum children\\n\");\n            free(node);\n            return -1;\n        }\n        \n        parent->child_ids[parent->child_count++] = id;\n    }\n    \n    // Add to hashmap\n    if (hashmap_put(tree->node_map, id, node) != 0) {\n        fprintf(stderr, \"Error: Failed to add node to hashmap\\n\");\n        free(node);\n        return -1;\n    }\n    \n    tree->node_count++;\n    return 0;\n}\n\nstatic int tree_remove_subtree(tree_t *tree, tree_id_t id) {\n    tree_node_t *node = tree_get_node(tree, id);\n    if (!node) {\n        return -1;\n    }\n    \n    // Recursively remove all children first\n    for (int i = 0; i < node->child_count; i++) {\n        tree_remove_subtree(tree, node->child_ids[i]);\n    }\n    \n    // Remove this node from hashmap\n    tree_node_t *removed = (tree_node_t *)hashmap_remove(tree->node_map, id);\n    if (removed) {\n        tree_free_node(removed);\n        tree->node_count--;\n    }\n    \n    return 0;\n}\n\nint tree_remove_node(tree_t *tree, tree_id_t id) {\n    if (!tree) {\n        return -1;\n    }\n    \n    tree_node_t *node = tree_get_node(tree, id);\n    if (!node) {\n        fprintf(stderr, \"Error: Node %lu not found\\n\", id);\n        return -1;\n    }\n    \n    // If removing root, tree becomes empty\n    if (id == tree->root_id) {\n        tree_remove_subtree(tree, id);\n        tree->has_root = 0;\n        tree->root_id = 0;\n        return 0;\n    }\n    \n    // Remove from parent's child list\n    tree_node_t *parent = tree_get_node(tree, node->parent_id);\n    if (parent) {\n        for (int i = 0; i < parent->child_count; i++) {\n            if (parent->child_ids[i] == id) {\n                // Shift remaining children\n                for (int j = i; j < parent->child_count - 1; j++) {\n                    parent->child_ids[j] = parent->child_ids[j + 1];\n                }\n                parent->child_count--;\n                break;\n            }\n        }\n    }\n    \n    // Remove this node and all descendants\n    tree_remove_subtree(tree, id);\n    \n    return 0;\n}\n\ntree_node_t* tree_get_node(tree_t *tree, tree_id_t id) {\n    if (!tree) {\n        return NULL;\n    }\n    \n    return (tree_node_t *)hashmap_get(tree->node_map, id);\n}\n\nint tree_contains(tree_t *tree, tree_id_t id) {\n    return tree_get_node(tree, id) != NULL;\n}\n\nsize_t tree_size(tree_t *tree) {\n    return tree ? tree->node_count : 0;\n}\n\nstatic void tree_print_helper(tree_t *tree, tree_id_t id, int depth) {\n    tree_node_t *node = tree_get_node(tree, id);\n    if (!node) {\n        return;\n    }\n    \n    // Print indentation\n    for (int i = 0; i < depth; i++) {\n        printf(\"  \");\n    }\n    \n    printf(\"[%lu] %s\\n\", node->id, node->data);\n    \n    // Print children\n    for (int i = 0; i < node->child_count; i++) {\n        tree_print_helper(tree, node->child_ids[i], depth + 1);\n    }\n}\n\nvoid tree_print(tree_t *tree) {\n    if (!tree || !tree->has_root) {\n        printf(\"(empty tree)\\n\");\n        return;\n    }\n    \n    tree_print_helper(tree, tree->root_id, 0);\n}\n\nint tree_get_depth(tree_t *tree, tree_id_t id) {\n    if (!tree || !tree_contains(tree, id)) {\n        return -1;\n    }\n    \n    int depth = 0;\n    tree_id_t current_id = id;\n    \n    while (current_id != tree->root_id) {\n        tree_node_t *node = tree_get_node(tree, current_id);\n        if (!node) {\n            return -1;\n        }\n        current_id = node->parent_id;\n        depth++;\n    }\n    \n    return depth;\n}\n\nint tree_get_height(tree_t *tree, tree_id_t id) {\n    tree_node_t *node = tree_get_node(tree, id);\n    if (!node) {\n        return -1;\n    }\n    \n    if (node->child_count == 0) {\n        return 0;\n    }\n    \n    int max_height = 0;\n    for (int i = 0; i < node->child_count; i++) {\n        int child_height = tree_get_height(tree, node->child_ids[i]);\n        if (child_height > max_height) {\n            max_height = child_height;\n        }\n    }\n    \n    return max_height + 1;\n}\n\nint tree_count_descendants(tree_t *tree, tree_id_t id) {\n    tree_node_t *node = tree_get_node(tree, id);\n    if (!node) {\n        return -1;\n    }\n    \n    int count = 0;\n    for (int i = 0; i < node->child_count; i++) {\n        count++; // Count the child\n        count += tree_count_descendants(tree, node->child_ids[i]);\n    }\n    \n    return count;\n}\n\nint tree_find_path(tree_t *tree, tree_id_t id, tree_id_t *path, int max_length) {\n    if (!tree || !path || !tree_contains(tree, id)) {\n        return -1;\n    }\n    \n    // Build path from node to root, then reverse\n    tree_id_t temp_path[1000];\n    int length = 0;\n    tree_id_t current_id = id;\n    \n    while (length < 1000) {\n        temp_path[length++] = current_id;\n        \n        if (current_id == tree->root_id) {\n            break;\n        }\n        \n        tree_node_t *node = tree_get_node(tree, current_id);\n        if (!node) {\n            return -1;\n        }\n        current_id = node->parent_id;\n    }\n    \n    // Reverse into output path\n    if (length > max_length) {\n        length = max_length;\n    }\n    \n    for (int i = 0; i < length; i++) {\n        path[i] = temp_path[length - 1 - i];\n    }\n    \n    return length;\n}\n","numLines":332,"startLine":1,"totalLines":332}}}
