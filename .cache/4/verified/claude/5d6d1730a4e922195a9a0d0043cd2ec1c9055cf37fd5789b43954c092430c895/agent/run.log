nsafe { m() });\n        }''','''        if side == Side::Rust {\n            assert!(\n                unsafe { dup2(file.as_raw_fd(), 0) } >= 0,\n                \"dup2 onto 0 failed\"\n            );\n        }\n        for inp in inputs {\n            file.set_len(0).expect(\"truncate stdin file\");\n            if !inp.is_empty() {\n                file.write_all_at(inp, 0).expect(\"write stdin file\");\n            }\n            reset_stdin(side, &in_path);\n            rets.push(unsafe { m() });\n        }''')\nopen(p,'w').write(s)\nPYEOF\ntimeout 300 cargo build --offline --tests 2>&1 | grep -E \"^(error|warning)\" -A 6 | head -20; timeout 500 cargo test --offline --test ffi_main -- row_34 row_16 2>&1 | grep -E \"MISMATCH|^test|result:\" | head","description":"Use freopen per input for C side, verify"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":559,"cache_read_input_tokens":234427,"cache_creation":{"ephemeral_5m_input_tokens":559,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"c2690a3f-cb75-437d-9bda-108d7d432746","uuid":"05274e25-1595-4642-87e8-7b6504c3fbac","timestamp":"2026-08-18T13:55:15.004Z"}
