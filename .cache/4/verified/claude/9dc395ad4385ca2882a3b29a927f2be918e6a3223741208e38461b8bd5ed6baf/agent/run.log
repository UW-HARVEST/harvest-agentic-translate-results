      other => {","-                eprintln!(\"unknown symbol request: {other}\");","+                eprintln!(\"unknown mode: {other}\");","                 std::process::exit(2);","             }","         }"]}],"originalFile":"//! Differential-test helper: `call_symbol <library.so> main|driver [arg]`\n//!\n//! Loads the given shared library with `dlopen`, resolves the requested\n//! exported symbol with `dlsym`, and calls it. Used to invoke the exported\n//! `main` — which consumes stdin — in a fresh process per input, since each\n//! implementation buffers stdin internally and that buffer cannot be reset\n//! from the outside.\n//!\n//! The process exits with the value the called function returned, so the\n//! caller can compare return values as well as stdout.\n\nuse std::os::raw::{c_int, c_void};\n\nextern \"C\" {\n    /// `fflush(NULL)` drains every C stdio stream, so the loaded C library's\n    /// buffered `printf` output is written before this process exits.\n    fn fflush(stream: *mut c_void) -> c_int;\n}\n\nfn main() {\n    let args: Vec<String> = std::env::args().collect();\n    if args.len() < 3 {\n        eprintln!(\"usage: {} <library.so> main|driver [arg]\", args[0]);\n        std::process::exit(2);\n    }\n    let path = &args[1];\n    let symbol = &args[2];\n\n    let rc = unsafe {\n        let lib = match libloading::Library::new(path) {\n            Ok(l) => l,\n            Err(e) => {\n                eprintln!(\"dlopen {path}: {e}\");\n                std::process::exit(3);\n            }\n        };\n        match symbol.as_str() {\n            \"main\" => {\n                let f: libloading::Symbol<unsafe extern \"C\" fn() -> c_int> =\n                    match lib.get(b\"main\\0\") {\n                        Ok(f) => f,\n                        Err(e) => {\n                            eprintln!(\"dlsym main: {e}\");\n                            std::process::exit(4);\n                        }\n                    };\n                f()\n            }\n            \"driver\" => {\n                let arg: i32 = args\n                    .get(3)\n                    .expect(\"driver needs an argument\")\n                    .parse()\n                    .expect(\"driver argument must be an i32\");\n                let f: libloading::Symbol<unsafe extern \"C\" fn(c_int)> = match lib.get(b\"driver\\0\")\n                {\n                    Ok(f) => f,\n                    Err(e) => {\n                        eprintln!(\"dlsym driver: {e}\");\n                        std::process::exit(4);\n                    }\n                };\n                f(arg as c_int);\n                0\n            }\n            other => {\n                eprintln!(\"unknown symbol request: {other}\");\n                std::process::exit(2);\n            }\n        }\n    };\n\n    unsafe {\n        fflush(std::ptr::null_mut());\n    }\n    std::process::exit(rc);\n}\n","userModified":false}}
