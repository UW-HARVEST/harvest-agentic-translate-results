\"C9 baseline\");"," ","-    // Re-run in a different, interleaved order and after repeats; results must","-    // be unchanged in both libraries.","-    for round in 0..3 {","-        for (i, &v) in values.iter().enumerate().rev() {","-            let c = c_impl().driver(v);","-            let r = rust_impl().driver(v);","-            assert_eq!(c, r, \"C9 round {round}: driver({v}) diverged on repeat\");","-            assert_eq!(","-                c, baseline[i],","-                \"C9 round {round}: driver({v}) output changed across calls (state leak)\"","-            );","+    // Reversed order, with every value repeated three times in a row, plus a","+    // few values interleaved: each output must still equal its baseline.","+    let mut order: Vec<i64> = Vec::new();","+    let mut expect: Vec<usize> = Vec::new();","+    for (i, &v) in wide.iter().enumerate().rev() {","+        for _ in 0..3 {","+            order.push(v);","+            expect.push(i);","         }","-        // Same value twice in a row.","-        let a = assert_driver_same(values[round], \"C9 double-call a\");","-        let b = assert_driver_same(values[round], \"C9 double-call b\");","-        assert_eq!(a, b, \"C9: consecutive identical calls differ\");","+        order.push(wide[0]);","+        expect.push(0);","     }","+    let replay = assert_driver_batch_same(&order, false, \"C9 replay\");","+    for (k, &i) in expect.iter().enumerate() {","+        assert_eq!(","+            replay[k], baseline[i],","+            \"C9: driver({}) output changed across calls (state leak)\",","+            values[i]","+        );","+    }"," }"]}],"originalFile":"//! Phase B — valid-path differential tests for the lowest-level exported\n//! entry point, `void driver(int floors)`.\n//!\n//! Rows C1–C9 of CONFIGS.md. Every test calls the symbol in **both** shared\n//! libraries through `dlopen`/`dlsym` and compares the bytes written to\n//! stdout exactly.\n\nmod common;\n\nuse common::*;\n\n/// Independent model of the C output, used to prove the capture machinery is\n/// really observing `print_hex` and not comparing two empty buffers:\n/// `floors` (LE) `bedrooms = 3` (LE) `bathrooms = 2.0` (LE bits) then '\\n'.\nfn expected_line(floors: i32) -> String {\n    let mut s = String::new();\n    for b in floors.to_le_bytes() {\n        s.push_str(&format!(\"{b:02x}\"));\n    }\n    s.push_str(\"03000000\"); // bedrooms = 3\n    s.push_str(\"0000000000000040\"); // bathrooms = 2.0\n    s.push('\\n');\n    s\n}\n\n#[track_caller]\nfn check(floors: i32, ctx: &str) {\n    let out = assert_driver_same(floors, ctx);\n    assert_eq!(\n        String::from_utf8_lossy(&out),\n        expected_line(floors),\n        \"C output does not match the independent model for driver({floors})\"\n    );\n}\n\n/// C1 — `floors = 0`: every byte of the field is `0x00`.\n#[test]\nfn c1_floors_zero() {\n    check(0, \"C1\");\n}\n\n/// C2 — all bytes in `0x01..=0x0f`: exercises the zero padding of `%02x`\n/// (a plain `%x` would print \"1234\" instead of \"01020304\").\n#[test]\nfn c2_low_nibble_bytes_zero_padded() {\n    for v in [\n        0x0102_0304u32,\n        0x0f0f_0f0f,\n        0x0101_0101,\n        0x0001_0002,\n        0x0908_0706,\n        0x0000_000f,\n        0x0f00_0000,\n    ] {\n        check(v as i32, \"C2\");\n    }\n    // Every single low byte value in isolation, at every byte offset.\n    for byte in 0x00u32..=0x0f {\n        for shift in [0, 8, 16, 24] {\n            check((byte << shift) as i32, \"C2 per-offset\");\n        }\n    }\n}\n\n/// C3 — positive values whose bytes are all `>= 0x10`, high bit clear.\n#[test]\nfn c3_positive_high_bytes() {\n    for v in [\n        0x1234_5678u32,\n        0x7f7f_7f7f,\n        0x1010_1010,\n        0x7edc_ba98,\n        0x4040_4040,\n        0x1111_1111,\n    ] {\n        check(v as i32, \"C3\");\n    }\n}\n\n/// C4 — high bit set: `unsigned char` promotion must not sign-extend\n/// (`%02x` of `0xff` is \"ff\", never \"ffffffff\").\n#[test]\nfn c4_negative_high_bit_bytes() {\n    for v in [\n        0x8000_0000u32,\n        0xdead_beef,\n        0xffff_ffff,\n        0x8080_8080,\n        0xfefe_fefe,\n        0xf0f0_f0f0,\n        0xcafe_babe,\n    ] {\n        check(v as i32, \"C4\");\n    }\n    // Every high byte value in isolation, at every byte offset.\n    for byte in [0x80u32, 0x81, 0xa5, 0xf0, 0xfe, 0xff] {\n        for shift in [0, 8, 16, 24] {\n            check((byte << shift) as i32, \"C4 per-offset\");\n        }\n    }\n}\n\n/// C5 — the `int` extremes.\n#[test]\nfn c5_int_boundaries() {\n    for v in [\n        i32::MIN,\n        i32::MIN + 1,\n        -2,\n        -1,\n        0,\n        1,\n        2,\n        i32::MAX - 1,\n        i32::MAX,\n        i16::MIN as i32,\n        i16::MAX as i32,\n        u16::MAX as i32,\n        u8::MAX as i32,\n    ] {\n        check(v, \"C5\");\n    }\n}\n\n/// C6 — embedded `0x00` bytes inside a non-zero value.\n#[test]\nfn c6_embedded_zero_bytes() {\n    for v in [\n        0x00ff_00ffu32,\n        0xff00_00ff,\n        0x0000_0001,\n        0x0100_0000,\n        0x00ff_ff00,\n        0xff00_ff00,\n        0x0000_ff00,\n    ] {\n        check(v as i32, \"C6\");\n    }\n}\n\n/// C7 — bytes that are ASCII control characters: they must appear as hex\n/// digits, never as literal newlines/tabs in the output stream.\n#[test]\nfn c7_control_character_bytes() {\n    for v in [\n        0x0a0d_0920u32,\n        0x0a0a_0a0a,\n        0x0d0d_0d0d,\n        0x0000_000a,\n        0x0a00_0000,\n        0x0908_0b0c,\n        0x1b1b_1b1b,\n    ] {\n        let out = assert_driver_same(v as i32, \"C7\");\n        // Exactly one newline, at the very end.\n        assert_eq!(\n            out.iter().filter(|&&b| b == b'\\n').count(),\n            1,\n            \"control byte leaked into the output stream for {v:#010x}\"\n        );\n        assert_eq!(*out.last().unwrap(), b'\\n');\n        check(v as i32, \"C7 model\");\n    }\n}\n\n/// C8 — uniform random over the whole 32-bit range (fixed seed).\n#[test]\nfn c8_random_full_range() {\n    let mut rng = Rng::new(0xC8);\n    for i in 0..4096 {\n        let v = rng.next_i32();\n        check(v, &format!(\"C8 iteration {i}\"));\n    }\n}\n\n/// C9 — many calls into one loaded instance: `house_t house = {0}` must be\n/// re-initialized on every call, so output must depend only on the argument\n/// and never on the call history.\n#[test]\nfn c9_repeated_calls_no_state_leak() {\n    let mut rng = Rng::new(0xC9);\n    let values: Vec<i32> = (0..64).map(|_| rng.next_i32()).collect();\n\n    // Baseline for each value.\n    let baseline: Vec<Vec<u8>> = values\n        .iter()\n        .map(|&v| assert_driver_same(v, \"C9 baseline\"))\n        .collect();\n\n    // Re-run in a different, interleaved order and after repeats; results must\n    // be unchanged in both libraries.\n    for round in 0..3 {\n        for (i, &v) in values.iter().enumerate().rev() {\n            let c = c_impl().driver(v);\n            let r = rust_impl().driver(v);\n            assert_eq!(c, r, \"C9 round {round}: driver({v}) diverged on repeat\");\n            assert_eq!(\n                c, baseline[i],\n                \"C9 round {round}: driver({v}) output changed across calls (state leak)\"\n            );\n        }\n        // Same value twice in a row.\n        let a = assert_driver_same(values[round], \"C9 double-call a\");\n        let b = assert_driver_same(values[round], \"C9 double-call b\");\n        assert_eq!(a, b, \"C9: consecutive identical calls differ\");\n    }\n}\n","userModified":false}}
