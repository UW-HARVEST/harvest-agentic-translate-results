n            \"main\" => {\n                let f: libloading::Symbol<unsafe extern \"C\" fn() -> c_int> =\n                    match lib.get(b\"main\\0\") {\n                        Ok(f) => f,\n                        Err(e) => {\n                            eprintln!(\"dlsym main: {e}\");\n                            std::process::exit(4);\n                        }\n                    };\n                f()\n            }\n            \"driver\" => {\n                let arg: i32 = args\n                    .get(3)\n                    .expect(\"driver needs an argument\")\n                    .parse()\n                    .expect(\"driver argument must be an i32\");\n                let f: libloading::Symbol<unsafe extern \"C\" fn(c_int)> = match lib.get(b\"driver\\0\")\n                {\n                    Ok(f) => f,\n                    Err(e) => {\n                        eprintln!(\"dlsym driver: {e}\");\n                        std::process::exit(4);\n                    }\n                };\n                f(arg as c_int);\n                0\n            }\n            other => {\n                eprintln!(\"unknown symbol request: {other}\");\n                std::process::exit(2);\n            }\n        }\n    };\n\n    unsafe {\n        fflush(std::ptr::null_mut());\n    }\n    std::process::exit(rc);\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
