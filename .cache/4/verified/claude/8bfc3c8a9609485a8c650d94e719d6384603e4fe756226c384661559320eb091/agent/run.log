or level, which is\n# process-global; they therefore use custom (sequential) harnesses declared\n# explicitly below instead of libtest's parallel one.\nautotests = false\n\n[lib]\nname = \"String_Slice\"\ncrate-type = [\"cdylib\"]\npath = \"src/lib.rs\"\n\n[features]\n# The C library (see c_src/CMakeLists.txt) has no build-time configuration\n# knobs: no #ifdef / option() / target_compile_definitions of any kind.\n# There is therefore exactly ONE valid build configuration, and the Rust crate\n# mirrors that by defining no features (default = empty feature set).\ndefault = []\n\n[dev-dependencies]\nlibloading = \"0.8\"\n\n# Phase B: valid-path differential tests (one row per CONFIGS.md row).\n[[test]]\nname = \"differential\"\npath = \"tests/differential.rs\"\nharness = false\n\n# Phase C: error-path differential tests (one row per ERRORS.md row).\n[[test]]\nname = \"error_paths\"\npath = \"tests/error_paths.rs\"\nharness = false\n\n# The strlen > INT_MAX path (needs a 2 GiB string; set SKIP_HUGE_STRING=1 to skip).\n[[test]]\nname = \"huge_string\"\npath = \"tests/huge_string.rs\"\nharness = false\n\n[profile.release]\npanic = \"abort\"\n\n[workspace]","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
