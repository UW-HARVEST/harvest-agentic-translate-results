path = \"tests/differential.rs\"\nharness = false\n\n# Phase C: error-path differential tests (one row per ERRORS.md row).\n[[test]]\nname = \"error_paths\"\npath = \"tests/error_paths.rs\"\nharness = false\n\n[profile.release]\npanic = \"abort\"\n\n[workspace]\n","structuredPatch":[{"oldStart":34,"oldLines":6,"newStart":34,"newLines":12,"lines":[" path = \"tests/error_paths.rs\""," harness = false"," ","+# The strlen > INT_MAX path (needs a 2 GiB string; set SKIP_HUGE_STRING=1 to skip).","+[[test]]","+name = \"huge_string\"","+path = \"tests/huge_string.rs\"","+harness = false","+"," [profile.release]"," panic = \"abort\""," "]}],"userModified":false,"replaceAll":false}}
