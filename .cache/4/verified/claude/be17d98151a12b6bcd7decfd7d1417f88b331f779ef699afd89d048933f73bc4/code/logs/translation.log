ue if identical.\"\"\"\n    r = os.fork()\n    if r == 0:\n        code = 0\n        try:\n            c = load(C_SO); rs = load(R_SO)\n            a = run(c, data, out_size, in_off, out_off)\n            b = run(rs, data, out_size, in_off, out_off)\n            if a[0] != b[0]:\n                print(f\"MISMATCH ret {label}: C={a[0]} R={b[0]}\"); code = 1\n            if a[1] != b[1]:\n                for i, (x, y) in enumerate(zip(a[1], b[1])):\n                    if x != y:\n                        print(f\"MISMATCH out {label}: first diff at {i}: C={x} R={y}\"); break\n                code = 1\n            if a[2] != b[2]:\n                print(f\"MISMATCH err {label}: C={a[2]!r} R={b[2]!r}\"); code = 1\n            if globals_of(c) != globals_of(rs):\n                print(f\"MISMATCH globals {label}\"); code = 1\n        except Exception as e:\n            print(f\"EXC {label}: {e}\"); code = 2\n        os._exit(code)\n    pid, status = os.waitpid(r, 0)\n    if os.WIFSIGNALED(status):\n        return \"crash\"\n    return \"ok\" if os.WEXITSTATUS(status) == 0 else \"fail\"\n\ndef raw_deflate(payload, level=6, strategy=zlib.Z_DEFAULT_STRATEGY):\n    co = zlib.compressobj(level, zlib.DEFLATED, -15, 9, strategy)\n    return co.compress(payload) + co.flush()\n\nrandom.seed(1234)\ncases = []\npayloads = [\n    b\"\", b\"a\", b\"hello world\", b\"A\" * 1000, b\"ab\" * 5000,\n    bytes(range(256)) * 4,\n    b\"\".join(bytes([random.randrange(256)]) for _ in range(3000)),\n    (b\"The quick brown fox jumps over the lazy dog. \" * 100),\n    bytes(random.randrange(4) for _ in range(2000)),\n    os.urandom(10000),\n    b\"\\x00\" * 70000,\n]\nfor p in payloads:\n    for level in (0, 1, 6, 9):\n        for strat in (zlib.Z_DEFAULT_STRATEGY, zlib.Z_FIXED, zlib.Z_HUFFMAN_ONLY, zlib.Z_RLE):\n            d = raw_deflate(p, level, strat)\n            for in_off in range(4):\n                for out_off in (0, 1):\n                    cases.append((d, max(len(p), 1) + 4, in_off, out_off,\n                                  f\"valid L{level} S{strat} len{len(p)} io{in_off}{out_off}\"))\n            # truncated output buffer (error path)\n            if p:\n                cases.append((d, len(p) - 1, 0, 0, f\"tight L{level} S{strat} len{len(p)}\"))\n                cases.append((d, 1, 0, 0, f\"tiny L{level} S{strat} len{len(p)}\"))\n\n# truncated / corrupted streams\nbase = raw_deflate(b\"The quick brown fox jumps over the lazy dog. \" * 20)\nfor n in range(1, min(len(base), 60)):\n    cases.append((base[:n], 4096, 0, 0, f\"trunc{n}\"))\nfor i in range(200):\n    b = bytearray(base)\n    b[random.randrange(len(b))] ^= 1 << random.randrange(8)\n    cases.append((bytes(b), 4096, random.randrange(4), 0, f\"bitflip{i}\"))\n\n# stored blocks, hand made\ncases.append((b\"\\x01\\x05\\x00\\xfa\\xffhello\", 64, 0, 0, \"stored-ok\"))\ncases.append((b\"\\x01\\x05\\x00\\xfb\\xffhello\", 64, 0, 0, \"stored-badnlen\"))\ncases.append((b\"\\x00\\x03\\x00\\xfc\\xffabc\" + b\"\\x01\\x02\\x00\\xfd\\xffxy\", 64, 0, 0, \"stored-2blk\"))\n# btype == 3\ncases.append((b\"\\x07\\x00\\x00\\x00\", 64, 0, 0, \"btype3\"))\n# tiny/odd inputs of every length 0..12\nfor n in range(0, 13):\n    for in_off in range(4):\n        cases.append((bytes(random.randrange(256) for _ in range(n)), 256, in_off, 0, f\"rand{n}.{in_off}\"))\n# fully random small inputs\nfor i in range(400):\n    n = random.randrange(1, 40)\n    cases.append((os.urandom(n), 1024, random.randrange(4), 0, f\"urand{i}\"))\n\nstats = {\"ok\": 0, \"fail\": 0, \"crash\": 0}\nfails = []\nfor c in cases:\n    r = one_case(*c)\n    stats[r] += 1\n    if r == \"fail\":\n        fails.append(c[4])\nprint(f\"total={len(cases)} ok={stats['ok']} fail={stats['fail']} crash(both/either)={stats['crash']}\")\nif fails:\n    print(\"FAILING:\", fails[:20])\nsys.exit(1 if fails else 0)\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":576,"cache_read