 1))|val.checked_shr(n).unwrap_or(0)|\"\n  \"left shift masked to 5 bits instead of 6 ::: s|val << (n \\& (TFLAC_UINT_BITS - 1))|val << (n \\& 31)|\"\n  \"tot counter saturates instead of wrapping ::: s/read_unaligned(p_tot).wrapping_add(bits)/read_unaligned(p_tot).saturating_add(bits)/\"\n  \"bw->bits accumulation saturates ::: s/read_unaligned(p_bits).wrapping_add(b)/read_unaligned(p_bits).saturating_add(b)/\"\n  \"loop guard promoted to 64-bit (loses 32-bit wraparound) ::: s|while unsafe { read_unaligned(p_bits) }.wrapping_add(bits) >= TFLAC_UINT_BITS|while unsafe { read_unaligned(p_bits) } as u64 + bits as u64 >= TFLAC_UINT_BITS as u64|\"\n  \"loop guard uses > instead of >= ::: s|.wrapping_add(bits) >= TFLAC_UINT_BITS \\&\\& i < 100|.wrapping_add(bits) > TFLAC_UINT_BITS \\&\\& i < 100|\"\n  \"off-by-one dropped: b = 64 - bw->bits instead of 64 - bw->bits - 1 ::: s/^            \\.wrapping_sub(1);/            ;/\"\n  \"b computed from 63 instead of 64 (extra off-by-one) ::: s/let mut b: u32 = TFLAC_UINT_BITS/let mut b: u32 = (TFLAC_UINT_BITS - 1)/\"\n  \"loop cap removed entirely (would hang or over-apply) ::: s/\\&\\& i < 100//\"\n  \"loop cap reduced to 1 iteration ::: s/i < 100/i < 1/\"\n  \"loop cap reduced to 0 iterations (loop never runs) ::: s/i < 100/i < 0/\"\n  \"field access via aligned reference again (breaks a misaligned bw) ::: s|let p_val: \\*mut u64 = unsafe { addr_of_mut!((\\*bw).val) };|let p_val: *mut u64 = unsafe { \\&raw mut (**\\&bw).val };|\"\n  \"tail 'bw->val |= val >> bw->bits' dropped ::: s|write_unaligned(p_val, read_unaligned(p_val) | shr(val, cur_bits));\\$|write_unaligned(p_val, read_unaligned(p_val));|\"\n  \"in-loop 'bw->val \\&= mask' dropped ::: s|write_unaligned(p_val, read_unaligned(p_val) \\& MASK)|write_unaligned(p_val, read_unaligned(p_val))|\"\n  \"tail 'bw->bits += bits' dropped ::: s|write_unaligned(p_bits, read_unaligned(p_bits).wrapping_add(bits))|write_unaligned(p_bits, read_unaligned(p_bits))|\"\n  \"writes tot into the pos field (wrong offset) ::: s|addr_of_mut!((\\*bw).tot)|addr_of_mut!((*bw).pos)|\"\n  \"writes bits into the len field (wrong offset) ::: s|addr_of_mut!((\\*bw).bits)|addr_of_mut!((*bw).len)|\"\n  \"returns -1 instead of 0 ::: s/^    0\\$/    -1/\"\n)\n\n# --- mutations that provably CANNOT be detected ---------------------------\n#\n# Proof sketch (validated by brute force over 1.3M structured + 40M random\n# (bw->bits, bits) pairs — see CONFIGS.md):\n#\n#   The while-loop performs AT MOST ONE progressing iteration. Once `b == 0`\n#   the body reduces to\n#       bw->val = (bw->val | (val >> bw->bits)) & mask;   bw->bits += 0;\n#       val <<= 0;                                        bits    -= 0;\n#   whose operands never change, and `x = (x | y) & m` is idempotent. So spins\n#   2..100 cannot alter any observable state, and any cap >= 2 behaves alike.\n#\n#   `b > bits ? bits : b` and `b >= bits ? bits : b` differ only when\n#   `b == bits`, and there both arms evaluate to the same number.\nEQUIV_MUTANTS=(\n  \"loop cap 100 -> 101 (any cap >= 2 is unobservable) ::: s/i < 100/i < 101/\"\n  \"loop cap 100 -> 1000 (any cap >= 2 is unobservable) ::: s/i < 100/i < 1000/\"\n  \"loop cap 100 -> 2 (>= 1 progressing iter + 1 stall suffices) ::: s/i < 100/i < 2/\"\n  \"min() comparison b > bits -> b >= bits (arms equal at the tie) ::: s/if b > bits { bits } else { b }/if b >= bits { bits } else { b }/\"\n)\n\nCAUGHT=0; MISSED=0; NOTAPPLIED=0; EQ_OK=0; EQ_BAD=0\n\n# run_one <sed-expr> ; echoes: applied|notapplied|buildfail|caught|passed\nrun_one() {\n    local expr=$1\n    cp \"$BAK\" \"$SRC\"\n    sed -i \"$expr\" \"$SRC\" 2>/dev/null\n    if cmp -s \"$BAK\" \"$SRC\"; then echo notapplied; return; fi\n    if ! timeout 300 cargo build --offline >/dev/null 2>&1; then echo buildfail; return; fi\n    if timeout 600 cargo test --offline -- --test-threads=4 >/dev/null 2>&1; then\n        echo passed\n    else\n        echo caught\n    fi\n}\n\nprintf '\\n=== mutations that MUST be caught ===\\n'\nfor entry in \"${MUTATIONS[@]}\"; do\n    DESC=$(printf '%s' \"${entry%%:::*}\" | sed 's/[[:space:]]*$//')\n    EXPR=$(printf '%s' \"${entry#*:::}\" | sed 's/^[[:space:]]*//')\n    case $(run_one \"$EXPR\") in\n      notapplied) printf '\\033[33m[NOT APPLIED]\\033[0m %s\\n' \"$DESC\"; NOTAPPLIED=$((NOTAPPLIED+1));;\n      buildfail)  printf '\\033[33m[BUILD FAIL]\\033[0m  %s\\n' \"$DESC\"; NOTAPPLIED=$((NOTAPPLIED+1));;\n      caught)     printf '\\033[32m[caught]\\033[0m      %s\\n' \"$DESC\"; CAUGHT=$((CAUGHT+1));;\n      passed)     printf '\\033[31m[MISSED!]\\033[0m     %s\\n' \"$DESC\"; MISSED=$((MISSED+1));;\n    esac\ndone\n\nprintf '\\n=== provably equivalent mutants (must NOT be caught) ===\\n'\nfor entry in \"${EQUIV_MUTANTS[@]}\"; do\n    DESC=$(printf '%s' \"${entry%%:::*}\" | sed 's/[[:space:]]*$//')\n    EXPR=$(printf '%s' \"${entry#*:::}\" | sed 's/^[[:space:]]*//')\n    case $(run_one \"$EXPR\") in\n      notapplied|buildfail) printf '\\033[33m[NOT APPLIED]\\033[0m %s\\n' \"$DESC\"; NOTAPPLIED=$((NOTAPPLIED+1));;\n      passed)     printf '\\033[32m[equivalent, as proven]\\033[0m %s\\n' \"$DESC\"; EQ_OK=$((EQ_OK+1));;\n      caught)     printf '\\033[31m[PROOF WRONG - was caught]\\033[0m %s\\n' \"$DESC\"; EQ_BAD=$((EQ_BAD+1));;\n    esac\ndone\n\nrestore\ntimeout 300 cargo build --offline >/dev/null 2>&1\n\nprintf '\\nreal bugs caught: %d, MISSED: %d, not applied: %d\\n' \"$CAUGHT\" \"$MISSED\" \"$NOTAPPLIED\"\nprintf 'equivalent mutants confirmed equivalent: %d, proof violations: %d\\n' \"$EQ_OK\" \"$EQ_BAD\"\nif [ \"$MISSED\" -eq 0 ] && [ \"$EQ_BAD\" -eq 0 ] && [ \"$NOTAPPLIED\" -eq 0 ]; then\n    printf '\\033[32mNEGATIVE CONTROL PASSED\\033[0m\\n'; exit 0\nfi\nprintf '\\033[31mNEGATIVE CONTROL FAILED\\033[0m\\n'; exit 1\n","structuredPatch":[{"oldStart":2,"oldLines":67,"newStart":2,"newLines":115,"lines":[" # Negative control for the differential suite."," #"," # Injects deliberate bugs into src/lib.rs one at a time, rebu