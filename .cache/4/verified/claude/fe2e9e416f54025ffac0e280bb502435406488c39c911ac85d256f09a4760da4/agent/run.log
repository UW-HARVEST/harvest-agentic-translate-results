e { read_unaligned(p_bits) }.wrapping_add(bits) >= TFLAC_UINT_BITS|while unsafe { read_unaligned(p_bits) } as u64 + bits as u64 >= TFLAC_UINT_BITS as u64|\"\n  \"off-by-one dropped: b = 64 - bw->bits (no -1) ::: s/\\.wrapping_sub(unsafe { read_unaligned(p_bits) })\\n//\"\n  \"bw->bits accumulation saturates ::: s/read_unaligned(p_bits).wrapping_add(b)/read_unaligned(p_bits).saturating_add(b)/\"\n  \"field access uses an aligned reference again (breaks misaligned bw) ::: s|let p_val: \\*mut u64 = unsafe { addr_of_mut!((\\*bw).val) };|let p_val: *mut u64 = unsafe { \\&mut (*bw).val };|\"\n)\n\nCAUGHT=0\nMISSED=0\nNOTAPPLIED=0\n\nfor entry in \"${MUTATIONS[@]}\"; do\n    DESC=${entry%%:::*}\n    EXPR=${entry#*:::}\n    DESC=$(echo \"$DESC\" | sed 's/[[:space:]]*$//')\n    EXPR=$(echo \"$EXPR\" | sed 's/^[[:space:]]*//')\n\n    cp \"$BAK\" \"$SRC\"\n    sed -i \"$EXPR\" \"$SRC\" 2>/dev/null\n    if cmp -s \"$BAK\" \"$SRC\"; then\n        printf '\\033[33m[NOT APPLIED]\\033[0m %s\\n' \"$DESC\"\n        NOTAPPLIED=$((NOTAPPLIED + 1))\n        continue\n    fi\n\n    if ! timeout 300 cargo build --offline >/dev/null 2>&1; then\n        printf '\\033[33m[BUILD FAIL]\\033[0m %s\\n' \"$DESC\"\n        NOTAPPLIED=$((NOTAPPLIED + 1))\n        continue\n    fi\n\n    if timeout 600 cargo test --offline -- --test-threads=4 >/dev/null 2>&1; then\n        printf '\\033[31m[MISSED]\\033[0m   %s\\n' \"$DESC\"\n        MISSED=$((MISSED + 1))\n    else\n        printf '\\033[32m[caught]\\033[0m   %s\\n' \"$DESC\"\n        CAUGHT=$((CAUGHT + 1))\n    fi\ndone\n\nrestore\ntrap - EXIT\ntimeout 300 cargo build --offline >/dev/null 2>&1\n\nprintf '\\nmutations caught: %d, MISSED: %d, not applied: %d\\n' \"$CAUGHT\" \"$MISSED\" \"$NOTAPPLIED\"\n[ \"$MISSED\" -eq 0 ] || exit 1\n","structuredPatch":[],"originalFile":null,"userModified":false}}
