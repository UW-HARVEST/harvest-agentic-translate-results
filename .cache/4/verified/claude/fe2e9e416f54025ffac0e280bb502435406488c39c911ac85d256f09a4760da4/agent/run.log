s)/\"","-  \"loop guard promoted to 64-bit (no 32-bit wraparound) ::: s|while unsafe { read_unaligned(p_bits) }.wrapping_add(bits) >= TFLAC_UINT_BITS|while unsafe { read_unaligned(p_bits) } as u64 + bits as u64 >= TFLAC_UINT_BITS as u64|\"","-  \"off-by-one dropped: b = 64 - bw->bits (no -1) ::: s/\\.wrapping_sub(unsafe { read_unaligned(p_bits) })\\n//\"","   \"bw->bits accumulation saturates ::: s/read_unaligned(p_bits).wrapping_add(b)/read_unaligned(p_bits).saturating_add(b)/\"","-  \"field access uses an aligned reference again (breaks misaligned bw) ::: s|let p_val: \\*mut u64 = unsafe { addr_of_mut!((\\*bw).val) };|let p_val: *mut u64 = unsafe { \\&mut (*bw).val };|\"","+  \"loop guard promoted to 64-bit (loses 32-bit wraparound) ::: s|while unsafe { read_unaligned(p_bits) }.wrapping_add(bits) >= TFLAC_UINT_BITS|while unsafe { read_unaligned(p_bits) } as u64 + bits as u64 >= TFLAC_UINT_BITS as u64|\"","+  \"loop guard uses > instead of >= ::: s|.wrapping_add(bits) >= TFLAC_UINT_BITS \\&\\& i < 100|.wrapping_add(bits) > TFLAC_UINT_BITS \\&\\& i < 100|\"","+  \"off-by-one dropped: b = 64 - bw->bits instead of 64 - bw->bits - 1 ::: s/^            \\.wrapping_sub(1);/            ;/\"","+  \"b computed from 63 instead of 64 (extra off-by-one) ::: s/let mut b: u32 = TFLAC_UINT_BITS/let mut b: u32 = (TFLAC_UINT_BITS - 1)/\"","+  \"loop cap removed entirely (would hang or over-apply) ::: s/\\&\\& i < 100//\"","+  \"loop cap reduced to 1 iteration ::: s/i < 100/i < 1/\"","+  \"loop cap reduced to 0 iterations (loop never runs) ::: s/i < 100/i < 0/\"","+  \"field access via aligned reference again (breaks a misaligned bw) ::: s|let p_val: \\*mut u64 = unsafe { addr_of_mut!((\\*bw).val) };|let p_val: *mut u64 = unsafe { \\&raw mut (**\\&bw).val };|\"","+  \"tail 'bw->val |= val >> bw->bits' dropped ::: s|write_unaligned(p_val, read_unaligned(p_val) | shr(val, cur_bits));\\$|write_unaligned(p_val, read_unaligned(p_val));|\"","+  \"in-loop 'bw->val \\&= mask' dropped ::: s|write_unaligned(p_val, read_unaligned(p_val) \\& MASK)|write_unaligned(p_val, read_unaligned(p_val))|\"","+  \"tail 'bw->bits += bits' dropped ::: s|write_unaligned(p_bits, read_unaligned(p_bits).wrapping_add(bits))|write_unaligned(p_bits, read_unaligned(p_bits))|\"","+  \"writes tot into the pos field (wrong offset) ::: s|addr_of_mut!((\\*bw).tot)|addr_of_mut!((*bw).pos)|\"","+  \"writes bits into the len field (wrong offset) ::: s|addr_of_mut!((\\*bw).bits)|addr_of_mut!((*bw).len)|\"","+  \"returns -1 instead of 0 ::: s/^    0\\$/    -1/\""," )"," ","-CAUGHT=0","-MISSED=0","-NOTAPPLIED=0","+# --- mutations that provably CANNOT be detected ---------------------------","+#","+# Proof sketch (validated by brute force over 1.3M structured + 40M random","+# (bw->bits, bits) pairs — see CONFIGS.md):","+#","+#   The while-loop performs AT MOST ONE progressing iteration. Once `b == 0`","+#   the body reduces to","+#       bw->val = (bw->val | (val >> bw->bits)) & mask;   bw->bits += 0;","+#       val <<= 0;                                        bits    -= 0;","+#   whose operands never change, and `x = (x | y) & m` is idempotent. So spins","+#   2..100 cannot alter any observable state, and any cap >= 2 behaves alike.","+#","+#   `b > bits ? bits : b` and `b >= bits ? bits : b` differ only when","+#   `b == bits`, and there both arms evaluate to the same number.","+EQUIV_MUTANTS=(","+  \"loop cap 100 -> 101 (any cap >= 2 is unobservable) ::: s/i < 100/i < 101/\"","+  \"loop cap 100 -> 1000 (any cap >= 2 is unobservable) ::: s/i < 100/i < 1000/\"","+  \"loop cap 100 -> 2 (>= 1 progressing iter + 1 stall suffices) ::: s/i < 100/i < 2/\"","+  \"min() comparison b > bits -> b >= bits (arms equal at the tie) ::: s/if b > bits { bits } else { b }/if b >= bits { bits } else { b }/\"","+)"," ","-for entry in \"${MUTATIONS[@]}\"; do","-    DESC=${entry%%:::*}","-    EXPR=${entry#*:::}","-    DESC=$(echo \"$DESC\" | sed 's/[[:space:]]*$//')","-    EXPR=$(echo \"$EXPR\" | sed 's/^[[:space:]]*//')","+CAUGHT=0; MISSED=0; NOTAPPLIED=0; EQ_OK=0; EQ_BAD=0"," ","+# run_one <sed-expr> ; echoes: applied|notapplied|buildfail|caught|passed","+run_one() {","+    local expr=$1","     cp \"$BAK\" \"$SRC\"","-    sed -i \"$EXPR\" \"$SRC\" 2>/dev/null","-    if cmp -s \"$BAK\" \"$SRC\"; then","-        printf '\\033[33m[NOT APPLIED]\\033[0m %s\\n' \"$DESC\"","-        NOTAPPLIED=$((NOTAPPLIED + 1))","-        continue","-    fi","-","-    if ! timeout 300 cargo build --offline >/dev/null 2>&1; then","-        printf '\\033[33m[BUILD FAIL]\\033[0m %s\\n' \"$DESC\"","-        NOTAPPLIED=$((NOTAPPLIED + 1))","-        continue","-    fi","-","+    sed -i \"$expr\" \"$SRC\" 2>/dev/null","+    if cmp -s \"$BAK\" \"$SRC\"; then echo notapplied; return; fi","+    if ! timeout 300 cargo build --offline >/dev/null 2>&1; then echo buildfail; return; fi","     if timeout 600 cargo test --offline -- --test-threads=4 >/dev/null 2>&1; then","-        printf '\\033[31m[MISSED]\\033[0m   %s\\n' \"$DESC\"","-        MISSED=$((MISSED + 1))","+        echo passed","     else","-        printf '\\033[32m[caught]\\033[0m   %s\\n' \"$DESC\"","-        CAUGHT=$((CAUGHT + 1))","+        echo caught","     fi","+}","+","+printf '\\n=== mutations that MUST be caught ===\\n'","+for entry in \"${MUTATIONS[@]}\"; do","+    DESC=$(printf '%s' \"${entry%%:::*}\" | sed 's/[[:space:]]*$//')","+    EXPR=$(printf '%s' \"${entry#*:::}\" | sed 's/^[[:space:]]*//')","+    case $(run_one \"$EXPR\") in","+      notapplied) printf '\\033[33m[NOT APPLIED]\\033[0m %s\\n' \"$DESC\"; NOTAPPLIED=$((NOTAPPLIED+1));;","+      buildfail)  printf '\\033[33m[BUILD FAIL]\\033[0m  %s\\n' \"$DESC\"; NOTAPPLIED=$((NOTAPPLIED+1));;","+      caught)     printf '\\033[32m[caught]\\033[0m      %s\\n' \"$DESC\"; CAUGHT=$((CAUGHT+1));;","+      passed)     printf '\\033[31m[MISSED!]\\033[0m     %s\\n' \"$DESC\"; MISSED=$((MISSED+1));;","+    esac"," done"," ","+printf '\\n=== provably equivalent mutants (must NOT be caught) ===\\n'","+for entry in \"${EQUIV_MUTANTS[@]}\"; do","+    DESC=$(printf '%s' \"${entry%%:::*}\" | sed 's/[[:space:]]*$//')","+    EXPR=$(printf '%s' \"${entry#*:::}\" | sed 's/^[[:space:]]*//')","+    case $(run_one \"$EXPR\") in","+      notapplied|buildfail) printf '\\033[33m[NOT APPLIED]\\033[0m %s\\n' \"$DESC\"; NOTAPPLIED=$((NOTAPPLIED+1));;","+      passed)     printf '\\033[32m[equivalent, as proven]\\033[0m %s\\n' \"$DESC\"; EQ_OK=$((EQ_OK+1));;","+      caught)     printf '\\033[31m[PROOF WRONG - was caught]\\033[0m %s\\n' \"$DESC\"; EQ_BAD=$((EQ_BAD+1));;","+    esac","+done","+"," restore","-trap - EXIT"," timeout 300 cargo build --offline >/dev/null 2>&1"," ","-printf '\\nmutations caught: %d, MISSED: %d, not applied: %d\\n' \"$CAUGHT\" \"$MISSED\" \"$NOTAPPLIED\"","-[ \"$MISSED\" -eq 0 ] || exit 1","+printf '\\nreal bugs caught: %d, MISSED: %d, not applied: %d\\n' \"$CAUGHT\" \"$MISSED\" \"$NOTAPPLIED\"","+printf 'equivalent mutants confirmed equivalent: %d, proof violations: %d\\n' \"$EQ_OK\" \"$EQ_BAD\"","+if [ \"$MISSED\" -eq 0 ] && [ \"$EQ_BAD\" -eq 0 ] && [ \"$NOTAPPLIED\" -eq 0 ]; then","+    printf '\\033[32mNEGATIVE CONTROL PASSED\\033[0m\\n'; exit 0","+fi","+printf '\\033[31mNEGATIVE CONTROL FAILED\\033[0m\\n'; exit 1"]}],"originalFile":"#!/usr/bin/env bash\n# Negative control for the differential suite.\n#\n# Injects deliberate bugs into src/lib.rs one at a time, rebuilds the cdylib and\n# re-runs the tests. EVERY mutation must be caught (tests must FAIL), otherwise\n# the suite has a blind spot. src/lib.rs is always restored.\nset -uo pipefail\n\ncd \"$(dirname \"$0\")\" || exit 1\nSRC=src/lib.rs\nBAK=$(mktemp \"${TMPDIR:-/tmp}/lib.rs.orig.XXXXXX\")\ncp \"$SRC\" \"$BAK\"\nrestore() { cp \"$BAK\" \"$SRC\"; rm -f \"$BAK\"; }\ntrap restore EXIT\n\n# Each entry: description ::: sed-expression\nMUTATIONS=(\n  \"loop cap 100 -> 101 ::: s/i < 100/i < 101/\"\n  \"mask no longer clears bit 0 ::: s/const MASK: u64 = u64::MAX << 1;/const MASK: u64 = u64::MAX;/\"\n  \"left shift: C-UB-naive (>=64 yields 0) instead of hardware masking ::: s|val << (n \\& (TFLAC_UINT_BITS - 1))|val.checked_shl(n).unwrap_or(0)|\"\n  \"right shift: C-UB-naive (>=64 yields 0) instead of hardware masking ::: s|val >> (n \\& (TFLAC_UINT_BITS - 1))|val.checked_shr(n).unwrap_or(0)|\"\n  \"min() comparison b > bits -> b >= bits ::: s/if b > bits { bits } else { b }/if b >= bits { bits } else { b }/\"\n  \"tot counter saturates instead of wrapping ::: s/read_unaligned(p_tot).wrapping_add(bits)/read_unaligned(p_tot).saturating_add(bits)/\"\n  \"loop guard promoted to 64-bit (no 32-bit wraparound) ::: s|while unsafe { read_unaligned(p_bits) }.wrapping_add(bits) >= TFLAC_UINT_BITS|while unsafe { read_unaligned(p_bits) } as u64 + bits as u64 >= TFLAC_UINT_BITS as u64|\"\n  \"off-by-one dropped: b = 64 - bw->bits (no -1) ::: s/\\.wrapping_sub(unsafe { read_unaligned(p_bits) })\\n//\"\n  \"bw->bits accumulation saturates ::: s/read_unaligned(p_bits).wrapping_add(b)/read_unaligned(p_bits).saturating_add(b)/\"\n  \"field access uses an aligned reference again (breaks misaligned bw) ::: s|let p_val: \\*mut u64 = unsafe { addr_of_mut!((\\*bw).val) };|let p_val: *mut u64 = unsafe { \\&mut (*bw).val };|\"\n)\n\nCAUGHT=0\nMISSED=0\nNOTAPPLIED=0\n\nfor entry in \"${MUTATIONS[@]}\"; do\n    DESC=${entry%%:::*}\n    EXPR=${entry#*:::}\n    DESC=$(echo \"$DESC\" | sed 's/[[:space:]]*$//')\n    EXPR=$(echo \"$EXPR\" | sed 's/^[[:space:]]*//')\n\n    cp \"$BAK\" \"$SRC\"\n    sed -i \"$EXPR\" \"$SRC\" 2>/dev/null\n    if cmp -s \"$BAK\" \"$SRC\"; then\n        printf '\\033[33m[NOT APPLIED]\\033[0m %s\\n' \"$DESC\"\n        NOTAPPLIED=$((NOTAPPLIED + 1))\n        continue\n    fi\n\n    if ! timeout 300 cargo build --offline >/dev/null 2>&1; then\n        printf '\\033[33m[BUILD FAIL]\\033[0m %s\\n' \"$DESC\"\n        NOTAPPLIED=$((NOTAPPLIED + 1))\n        continue\n    fi\n\n    if timeout 600 cargo test --offline -- --test-threads=4 >/dev/null 2>&1; then\n        printf '\\033[31m[MISSED]\\033[0m   %s\\n' \"$DESC\"\n        MISSED=$((MISSED + 1))\n    else\n        printf '\\033[32m[caught]\\033[0m   %s\\n' \"$DESC\"\n        CAUGHT=$((CAUGHT + 1))\n    fi\ndone\n\nrestore\ntrap - EXIT\ntimeout 300 cargo build --offline >/dev/null 2>&1\n\nprintf '\\nmutations caught: %d, MISSED: %d, not applied: %d\\n' \"$CAUGHT\" \"$MISSED\" \"$NOTAPPLIED\"\n[ \"$MISSED\" -eq 0 ] || exit 1\n","userModified":false}}
