\n    );\n    Impl::open(&so, \"Rust\")\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1901,"cache_read_input_tokens":94044,"cache_creation":{"ephemeral_5m_input_tokens":1901,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"35dbed96-b4a4-4d8d-8740-1664d0d95d52","uuid":"39464103-e2b7-4957-9755-dd6c4fc5bf6e","timestamp":"2026-08-19T10:54:06.117Z"}
