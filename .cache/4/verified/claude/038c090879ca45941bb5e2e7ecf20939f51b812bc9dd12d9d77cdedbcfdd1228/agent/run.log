{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01JhaPTXjB7sVdc2h4YwQwtv","type":"tool_result","content":"1\t//! Raw C runtime bindings used by the translated stb_ds implementation.\n2\t//!\n3\t//! The original C code allocates through `realloc`/`free` (see the\n4\t//! `STBDS_REALLOC`/`STBDS_FREE` macros in `c_src/src/lib.c`), so the Rust\n5\t//! translation must use the very same allocator: blocks handed out by this\n6\t//! library may be released by callers with `free()` and vice versa.\n7\t\n8\tuse core::ffi::{c_char, c_int, c_uint, c_void};\n9\t\n10\tunsafe extern \"C\" {\n11\t    pub fn realloc(p: *mut c_void, size: usize) -> *mut c_void;\n12\t    pub fn free(p: *mut c_void);\n13\t    pub fn memset(dst: *mut c_void, c: c_int, n: usize) -> *mut c_void;\n14\t    pub fn memmove(dst: *mut c_void, src: *const c_void, n: usize) -> *mut c_void;\n15\t    pub fn memcpy(dst: *mut c_void, src: *const c_void, n: usize) -> *mut c_void;\n16\t    pub fn memcmp(a: *const c_void, b: *const c_void, n: usize) -> c_int;\n17\t    pub fn strlen(s: *const c_char) -> usize;\n18\t    pub fn strcmp(a: *const c_char, b: *const c_char) -> c_int;\n19\t    /// glibc/musl backend of the `assert()` macro.  `c_src/src/lib.c` is built\n20\t    /// without `NDEBUG`, so `STBDS_ASSERT` == `assert` is live and a failing\n21\t    /// check prints the canonical diagnostic and calls `abort()`.\n22\t    pub fn __assert_fail(\n23\t        assertion: *const c_char,\n24\t        file: *const c_char,\n25\t        line: c_uint,\n26\t        function: *const c_char,\n27\t    ) -> !;\n28\t}\n29\t\n30\t/// `__FILE__` as the C compiler sees it for `c_src/src/lib.c`.\n31\tpub const ASSERT_FILE: &str = concat!(env!(\"CARGO_MANIFEST_DIR\"), \"/c_src/src/lib.c\\0\");\n32\t\n33\t/// Reproduce a failing `assert()` exactly like the C build would.\n34\t///\n35\t/// `expr` and `func` must be NUL terminated.\n36\tpub unsafe fn assert_fail(expr: &str, line: u32, func: &str) -> ! {\n37\t    __assert_fail(\n38\t        expr.as_ptr() as *const c_char,\n39\t        ASSERT_FILE.as_ptr() as *const c_char,\n40\t        line as c_uint,\n41\t        func.as_ptr() as *const c_char,\n42\t    )\n43\t}\n44\t"}]},"parent_tool_use_id":null,"session_id":"b0a431b9-dd3c-4caf-92f8-2cde17342eee","uuid":"947e4542-fa65-4122-bd7f-b7fd1490c0cd","timestamp":"2026-08-20T10:51:10.890Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-ERIqk7/translated_rust/src/cffi.rs","content":"//! Raw C runtime bindings used by the translated stb_ds implementation.\n//!\n//! The original C code allocates through `realloc`/`free` (see the\n//! `STBDS_REALLOC`/`STBDS_FREE` macros in `c_src/src/lib.c`), so the Rust\n//! translation must use the very same allocator: blocks handed out by this\n//! library may be released by callers with `free()` and vice versa.\n\nuse core::ffi::{c_char, c_int, c_uint, c_void};\n\nunsafe extern \"C\" {\n    pub fn realloc(p: *mut c_void, size: usize) -> *mut c_void;\n    pub fn free(p: *mut c_void);\n    pub fn memset(dst: *mut c_void, c: c_int, n: usize) -> *mut c_void;\n    pub fn memmove(dst: *mut c_void, src: *const c_void, n: usize) -> *mut c_void;\n    pub fn memcpy(dst: *mut c_void, src: *const c_void, n: usize) -> *mut c_void;\n    pub fn memcmp(a: *const c_void, b: *const c_void, n: usize) -> c_int;\n    pub fn strlen(s: *const c_char) -> usize;\n    pub fn strcmp(a: *const c_char, b: *const c_char) -> c_int;\n    /// glibc/musl backend of the `assert()` macro.  `c_src/src/lib.c` is built\n    /// without `NDEBUG`, so `STBDS_ASSERT` == `assert` is live and a failing\n    /// check prints the canonical diagnostic and calls `abort()`.\n    pub fn __assert_fail(\n        assertion: *const c_char,\n        file: *const c_char,\n        line: c_uint,\n        function: *const c_char,\n    ) -> !;\n}\n\n/// `__FILE__` as the C compiler sees it for `c_src/src/lib.c`.\npub const ASSERT_FILE: &str = concat!(env!(\"CARGO_MANIFEST_DIR\"), \"/c_src/src/lib.c\\0\");\n\n/// Reproduce a failing `assert()` exactly like the C build would.\n///\n/// `expr` and `func` must be NUL terminated.\npub unsafe fn assert_fail(expr: &str, line: u32, func: &str) -> ! {\n    __assert_fail(\n        expr.as_ptr() as *const c_char,\n        ASSERT_FILE.as_ptr() as *const c_char,\n        line as c_uint,\n        func.as_ptr() as *const c_char,\n    )\n}\n","numLines":44,"startLine":1,"totalLines":44}}}
