{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01KcfoPM2H5JCp3GCDhPKDuH","type":"tool_result","content":"1\t//! Dynamic array growth helpers, translated from `c_src/src/lib.c`.\n2\t\n3\tuse core::ffi::{c_char, c_void};\n4\tuse core::ptr;\n5\t\n6\tuse crate::cffi::{free, realloc};\n7\tuse crate::types::*;\n8\t\n9\t/// ```c\n10\t/// void *stbds_arrgrowf(void *a, size_t elemsize, size_t addlen, size_t min_cap)\n11\t/// ```\n12\t#[unsafe(no_mangle)]\n13\tpub unsafe extern \"C\" fn stbds_arrgrowf(\n14\t    a: *mut c_void,\n15\t    elemsize: usize,\n16\t    addlen: usize,\n17\t    min_cap: usize,\n18\t) -> *mut c_void {\n19\t    // stbds_array_header temp={0}; (void) sizeof(temp);   -- unused in C\n20\t    let mut min_cap = min_cap;\n21\t    let b: *mut c_void;\n22\t    let min_len: usize = (stbds_arrlen(a) as usize).wrapping_add(addlen);\n23\t\n24\t    if min_len > min_cap {\n25\t        min_cap = min_len;\n26\t    }\n27\t\n28\t    if min_cap <= stbds_arrcap(a) {\n29\t        return a;\n30\t    }\n31\t\n32\t    if min_cap < 2usize.wrapping_mul(stbds_arrcap(a)) {\n33\t        min_cap = 2usize.wrapping_mul(stbds_arrcap(a));\n34\t    } else if min_cap < 4 {\n35\t        min_cap = 4;\n36\t    }\n37\t\n38\t    let old = if !a.is_null() {\n39\t        stbds_header(a) as *mut c_void\n40\t    } else {\n41\t        ptr::null_mut()\n42\t    };\n43\t    b = realloc(\n44\t        old,\n45\t        elemsize.wrapping_mul(min_cap).wrapping_add(HEADER_SIZE),\n46\t    );\n47\t    let b = (b as *mut c_char).wrapping_add(HEADER_SIZE) as *mut c_void;\n48\t    if a.is_null() {\n49\t        (*stbds_header(b)).length = 0;\n50\t        (*stbds_header(b)).hash_table = ptr::null_mut();\n51\t        (*stbds_header(b)).temp = 0;\n52\t    } else {\n53\t        // STBDS_STATS(++stbds_array_grow);  -- compiled out\n54\t    }\n55\t    (*stbds_header(b)).capacity = min_cap;\n56\t\n57\t    b\n58\t}\n59\t\n60\t/// ```c\n61\t/// void stbds_arrfreef(void *a) { STBDS_FREE(NULL, stbds_header(a)); }\n62\t/// ```\n63\t#[unsafe(no_mangle)]\n64\tpub unsafe extern \"C\" fn stbds_arrfreef(a: *mut c_void) {\n65\t    free(stbds_header(a) as *mut c_void);\n66\t}\n67\t"}]},"parent_tool_use_id":"toolu_bdrk_01HQSKqt7QTsaAuDELJmRc2h","session_id":"b0a431b9-dd3c-4caf-92f8-2cde17342eee","uuid":"0f3ce679-b593-4410-8c90-37eb7facfc8d","timestamp":"2026-08-20T11:30:25.323Z","subagent_type":"general-purpose","task_description":"Independent C-vs-Rust semantic audit"}
