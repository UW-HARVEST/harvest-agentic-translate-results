->n=(void*)dlsym(l->h,\"stbds_\" #n)\nstatic void load(lib*l,const char*p){\n  l->h=dlopen(p,RTLD_NOW|RTLD_LOCAL); if(!l->h){fprintf(stderr,\"%s\\n\",dlerror());exit(1);}\n  LD(hash_bytes);LD(rand_seed);LD(hmput_key);LD(hmget_key);LD(hmget_key_ts);LD(hmdel_key);\n  LD(hmput_default);LD(shmode_func);LD(hmfree_func);LD(stralloc);LD(strreset);\n  l->intput=(f_intput)dlsym(l->h,\"intput\"); l->strkey=(f_strkey)dlsym(l->h,\"strkey\");\n}\nstatic int fails=0;\n#define CK(c,...) do{ if(!(c)){ printf(\"MISMATCH \"); printf(__VA_ARGS__); printf(\"\\n\"); fails++; } }while(0)\n\n/* compare full observable state of a hash-map handle (hash-adjusted ptr) */\nstatic void cmp_state(const char*tag,void*ca,void*ra,size_t elem,int strmode){\n  CK((ca==NULL)==(ra==NULL),\"%s nullness %p %p\",tag,ca,ra);\n  if(!ca||!ra) return;\n  hdr *hc=(hdr*)((char*)ca-elem)-1, *hr=(hdr*)((char*)ra-elem)-1;\n  CK(hc->length==hr->length,\"%s length C=%zu R=%zu\",tag,hc->length,hr->length);\n  CK(hc->capacity==hr->capacity,\"%s capacity C=%zu R=%zu\",tag,hc->capacity,hr->capacity);\n  CK(hc->temp==hr->temp,\"%s temp C=%td R=%td\",tag,hc->temp,hr->temp);\n  CK((hc->hash_table==NULL)==(hr->hash_table==NULL),\"%s ht null\",tag);\n  if(hc->hash_table&&hr->hash_table){\n    hidx*tc=hc->hash_table,*tr=hr->hash_table;\n    CK(tc->slot_count==tr->slot_count,\"%s slot_count %zu %zu\",tag,tc->slot_count,tr->slot_count);\n    CK(tc->used_count==tr->used_count,\"%s used_count %zu %zu\",tag,tc->used_count,tr->used_count);\n    CK(tc->uct==tr->uct,\"%s uct %zu %zu\",tag,tc->uct,tr->uct);\n    CK(tc->ucst==tr->ucst,\"%s ucst %zu %zu\",tag,tc->ucst,tr->ucst);\n    CK(tc->tc==tr->tc,\"%s tombstone_count %zu %zu\",tag,tc->tc,tr->tc);\n    CK(tc->tct==tr->tct,\"%s tct %zu %zu\",tag,tc->tct,tr->tct);\n    CK(tc->seed==tr->seed,\"%s seed %#zx %#zx\",tag,tc->seed,tr->seed);\n    CK(tc->scl2==tr->scl2,\"%s scl2 %zu %zu\",tag,tc->scl2,tr->scl2);\n    CK(tc->string.remaining==tr->string.remaining,\"%s arena.remaining %zu %zu\