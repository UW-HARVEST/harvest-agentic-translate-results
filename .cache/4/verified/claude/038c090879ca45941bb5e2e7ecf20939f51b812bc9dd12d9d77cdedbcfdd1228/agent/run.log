t#[repr(C)]\n60\t#[derive(Copy, Clone)]\n61\tstruct IntMapEntry {\n62\t    key: c_int,\n63\t    value: c_int,\n64\t}\n65\t\n66\tconst INTMAP_ELEMSIZE: usize = core::mem::size_of::<IntMapEntry>();\n67\tconst INTMAP_KEYSIZE: usize = core::mem::size_of::<c_int>();\n68\t\n69\t/// `stbds_hmput(t, k, v)`:\n70\t/// ```c\n71\t/// ((t) = stbds_hmput_key((t), sizeof *(t), (void*) STBDS_ADDRESSOF((t)->key, (k)), sizeof (t)->key, 0),\n72\t///  (t)[stbds_temp((t)-1)].key = (k),\n73\t///  (t)[stbds_temp((t)-1)].value = (v))\n74\t/// ```\n75\tunsafe fn hmput(t: &mut *mut IntMapEntry, k: c_int, v: c_int) {\n76\t    let mut key_slot: c_int = k; // (int[1]){k}\n77\t    *t = stbds_hmput_key(\n78\t        *t as *mut c_void,\n79\t        INTMAP_ELEMSIZE,\n80\t        ptr::addr_of_mut!(key_slot) as *mut c_void,\n81\t        INTMAP_KEYSIZE,\n82\t        0,\n83\t    ) as *mut IntMapEntry;\n84\t    let idx = stbds_temp(stbds_hash_to_arr(*t as *mut c_void, INTMAP_ELEMSIZE));\n85\t    (*(*t).wrapping_offset(idx)).key = k;\n86\t    let idx = stbds_temp(stbds_hash_to_arr(*t as *mut c_void, INTMAP_ELEMSIZE));\n87\t    (*(*t).wrapping_offset(idx)).value = v;\n88\t}\n89\t\n90\t/// `stbds_hmget(t, k)` == `stbds_hmgetp(t,k)->value`, i.e.\n91\t/// ```c\n92\t/// ((t) = stbds_hmget_key((t), sizeof *(t), (void*) STBDS_ADDRESSOF((t)->key, (k)), sizeof (t)->key, STBDS_HM_BINARY),\n93\t///  &(t)[stbds_temp((t)-1)])->value\n94\t/// ```\n95\tunsafe fn hmget(t: &mut *mut IntMapEntry, k: c_int) -> c_int {\n96\t    let mut key_slot: c_int = k; // (int[1]){k}\n97\t    *t = stbds_hmget_key(\n98\t        *t as *mut c_void,\n99\t        INTMAP_ELEMSIZE,\n100\t        ptr::addr_of_mut!(key_slot) as *mut c_void,\n101\t        INTMAP_KEYSIZE,\n102\t        STBDS_HM_BINARY,\n103\t    ) as *mut IntMapEntry;\n104\t    let idx = stbds_temp(stbds_hash_to_arr(*t as *mut c_void, INTMAP_ELEMSIZE));\n105\t    (*(*t).wrapping_offset(idx)).value\n106\t}\n107\t\n108\t/// ```c\n109\t/// void intput(int num)\n110\t/// {\n111\t///  