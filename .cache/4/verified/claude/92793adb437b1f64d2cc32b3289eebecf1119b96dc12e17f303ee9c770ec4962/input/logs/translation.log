onst c_char, n: usize) -> *mut c_char;\n}\n\n/// `EXIT_FAILURE` from `<stdlib.h>`.\npub const EXIT_FAILURE: c_int = 1;\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":494,"cache_read_input_tokens":24072,"cache_creation":{"ephemeral_5m_input_tokens":494,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"0b6103d1-6d1f-46d6-9115-8f8504a8c6b5","uuid":"090ca24d-28d9-45ab-a192-6735ba6c5beb","timestamp":"2026-08-19T17:05:27.164Z"}
