{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_gvjmjr3waovwi2yij2zc4ftwdv4rgcfuxhinunx7n3kwg3o5zita","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_019T1Sh7NEaMYfgeGb7514BQ","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-a5p6E9/translated_rust/examples/oracle.rs","content":"//! Out-of-process differential oracle.\n//!\n//! Some rows of `ERRORS.md` cannot be exercised inside the test process:\n//!\n//!   * null-pointer dereferences (the C code has no null checks, so the process\n//!     is killed by `SIGSEGV` — the *termination signal* is the observable), and\n//!   * allocation failures, which are forced with `RLIMIT_AS` and therefore need\n//!     a process whose address space can be sacrificed.\n//!   * the \"never initialised\" logger state, which only exists in a brand-new\n//!     process (`static FILE *log_file == NULL`).\n//!\n//! Usage: `oracle <c|rust> <scenario>`\n//!\n//! The library under test is dlopen'd through `libloading`, exactly like the\n//! in-process tests, and the *exit code* carries the observation so that no\n//! allocation is needed after the heap has been exhausted:\n//!\n//! | exit code | meaning                                  |\n//! |-----------|------------------------------------------|\n//! | 70        | returned pointer was NULL                |\n//! | 71        | returned pointer was non-NULL            |\n//! | 80        | returned int 0                           |\n//! | 81        | returned int 1 (`EXIT_FAILURE`)          |\n//! | 82        | returned int -1                          |\n//! | 83        | returned some other int                  |\n//! | 90        | void scenario ran to completion          |\n//! | 64        | usage error / scenario not recognised     |\n//! | 65        | the scenario's own precondition failed   |\n//! | (signal)  | the library crashed — that is the result  |\n\nuse libloading::Library;\nuse std::ffi::{c_char, c_int, c_void};\nuse std::path::PathBuf;\n\nconst TASK_SIZE: usize = 260;\nconst TASKMANAGER_SIZE: usize = 16;\n\n#[repr(C)]\nstruct TaskManager {\n    tasks: *mut c_void,\n    max_tasks: c_int,\n    task_count: c_int,\n}\n\ntype FnInitializeLogger = unsafe extern \"C\" fn() -> c_int;\ntype FnLog = unsafe extern \"C\" fn(*const c_char);\ntype FnFinalizeLogger = unsafe extern \"C\" fn();\ntype FnCreate = unsafe extern \"C\" fn() -> *mut TaskManager;\ntype FnAddTask = unsafe extern \"C\" fn(*mut TaskManager, *const c_char, c_int);\ntype FnPrint = unsafe extern \"C\" fn(*const TaskManager);\ntype FnDestroy = unsafe extern \"C\" fn(*mut TaskManager);\ntype FnDriver = unsafe extern \"C\" fn(*const c_char) -> c_int;\n\nstruct Api {\n    _lib: Library,\n    initialize_logger: FnInitializeLogger,\n    log_info: FnLog,\n    log_warning: FnLog,\n    log_error: FnLog,\n    finalize_logger: FnFinalizeLogger,\n    create_task_manager: FnCreate,\n    add_task: FnAddTask,\n    print_tasks: FnPrint,\n    destroy_task_manager: FnDestroy,\n    driver: FnDriver,\n}\n\nfn load(which: &str) -> Api {\n    let path: PathBuf = match which {\n        \"c\" => std::env::var(\"C_DRIVER_SO\")\n            .expect(\"C_DRIVER_SO must be set\")\n            .into(),\n        \"rust\" => std::env::var(\"RUST_DRIVER_SO\")\n            .expect(\"RUST_DRIVER_SO must be set\")\n            .into(),\n        other => {\n            eprintln!(\"oracle: unknown implementation {other:?}\");\n            std::process::exit(64);\n        }\n    };\n    let lib = unsafe { Library::new(&path) }\n        .unwrap_or_else(|e| panic!(\"dlopen({}) failed: {e}\", path.display()));\n    macro_rules! sym {\n        ($n:literal, $t:ty) => {\n            *unsafe { lib.get::<$t>(concat!($n, \"\\0\").as_bytes()) }.expect(concat!(\"missing \", $n))\n        };\n    }\n    let a = Api {\n        initialize_logger: sym!(\"initialize_logger\", FnInitializeLogger),\n        log_info: sym!(\"log_info\", FnLog),\n        log_warning: sym!(\"log_warning\", FnLog),\n        log_error: sym!(\"log_error\", FnLog),\n        finalize_logger: sym!(\"finalize_logger\", FnFinalizeLogger),\n        create_task_manager: sym!(\"create_task_manager\", FnCreate),\n        add_task: sym!(\"add_task\", FnAddTask),\n        print_tasks: sym!(\"print_tasks\", FnPrint),\n        destroy_task_manager: sym!(\"destroy_task_manager\", FnDestroy),\n        driver: sym!(\"driver\", FnDriver),\n        _lib: lib,\n    };\n    a\n}\n\n/// `libc::exit` (not `std::process::exit`): it flushes glibc's streams — which\n/// is where the library's log file and `stdout` live — and needs no allocation,\n/// so it is safe to call after the heap has been deliberately exhausted.\nfn done(code: c_int) -> ! {\n    unsafe { libc::exit(code) }\n}\n\nfn ptr_code<T>(p: *const T) -> c_int {\n    if p.is_null() { 70 } else { 71 }\n}\n\nfn int_code(r: c_int) -> c_int {\n    match r {\n        0 => 80,\n        1 => 81,\n        -1 => 82,\n        _ => 83,\n    }\n}\n\n/// Current virtual-memory size in bytes, from /proc/self/statm.\nfn vm_size_bytes() -> usize {\n    let s = std::fs::read_to_string(\"/proc/self/statm\").expect(\"read statm\");\n    let pages: usize = s\n        .split_whitespace()\n        .next()\n        .and_then(|t| t.parse().ok())\n        .expect(\"parse statm\");\n    pages * 4096\n}\n\n/// Clamp the address space to \"what we use now + slack\", so that any further\n/// large allocation fails deterministically.\nfn clamp_address_space(slack: usize) {\n    let limit = vm_size_bytes() + slack;\n    let rl = libc::rlimit {\n        rlim_cur: limit as libc::rlim_t,\n        rlim_max: limit as libc::rlim_t,\n    };\n    let rc = unsafe { libc::setrlimit(libc::RLIMIT_AS, &rl) };\n    assert_eq!(rc, 0, \"setrlimit(RLIMIT_AS) failed\");\n}\n\n/// Allocate (and deliberately leak) until a 16-byte `malloc` fails, so that the\n/// very first allocation inside `create_task_manager` returns NULL.\nfn exhaust_heap() {\n    loop {\n        let p = unsafe { libc::malloc(16) };\n        if p.is_null() {\n            return;\n        }\n    }\n}\n\nfn main() {\n    let args: Vec<String> = std::env::args().collect();\n    if args.len() < 3 {\n        eprintln!(\"usage: oracle <c|rust> <scenario>\");\n        std::process::exit(64);\n    }\n    let api = load(&args[1]);\n    let scenario = args[2].as_str();\n\n    unsafe {\n        match scenario {\n            // -----------------------------------------------------------------\n            // Sanity check of the oracle plumbing itself.\n            // -----------------------------------------------------------------\n            \"ok_driver\" => {\n                let text = b\"alpha\\nbeta\\n\\0\";\n                let r = (api.driver)(text.as_ptr() as *const c_char);\n                done(int_code(r));\n            }\n\n            // -----------------------------------------------------------------\n            // ERRORS rows 5-8, in the genuinely-uninitialised state\n            // (`static FILE *log_file == NULL` in a brand-new process).\n            // -----------------------------------------------------------------\n            \"fresh_log_before_init\" => {\n                let m = b\"before init\\0\";\n                (api.log_info)(m.as_ptr() as *const c_char);\n                (api.log_warning)(m.as_ptr() as *const c_char);\n                (api.log_error)(m.as_ptr() as *const c_char);\n                // must not fclose anything and must not log \"Logger finalized.\"\n                (api.finalize_logger)();\n                done(90);\n            }\n\n            // -----------------------------------------------------------------\n            // ERRORS row 19 — add_task(NULL, ...) dereferences NULL.\n            // -----------------------------------------------------------------\n            \"null_add_task_manager\" => {\n                let d = b\"task\\0\";\n                (api.add_task)(\n                    std::ptr::null_mut(),\n                    d.as_ptr() as *const c_char,\n                    1,\n                );\n                done(90); // must not be reached\n            }\n\n            // -----------------------------------------------------------------\n            // ERRORS row 20 — add_task(m, NULL, p) with room left: strncpy reads\n            // from NULL.\n            // -----------------------------------------------------------------\n            \"null_add_task_desc\" => {\n                if (api.initialize_logger)() != 0 {\n                    done(65);\n                }\n                let m = (api.create_task_manager)();\n                if m.is_null() {\n                    done(65);\n                }\n                (api.add_task)(m, std::ptr::null(), 1);\n                done(90); // must not be reached\n            }\n\n            // -----------------------------------------------------------------\n            // ERRORS row 22 — print_tasks(NULL): \"Tasks:\\n\" is emitted first,\n            // then the dereference faults.\n            // -----------------------------------------------------------------\n            \"null_print_manager\" => {\n                (api.print_tasks)(std::ptr::null());\n                done(90); // must not be reached\n            }\n\n            // -----------------------------------------------------------------\n            // ERRORS row 23 — manager->tasks == NULL while task_count > 0.\n            // -----------------------------------------------------------------\n            \"null_print_tasks_array\" => {\n                let m = libc::malloc(TASKMANAGER_SIZE) as *mut TaskManager;\n                if m.is_null() {\n                    done(65);\n                }\n                (*m).tasks = std::ptr::null_mut();\n                (*m).max_tasks = 5;\n                (*m).task_count = 3;\n                (api.print_tasks)(m);\n                done(90); // must not be reached\n            }\n\n            // -----------------------------------------------------------------\n            // ERRORS row 25 — destroy_task_manager(NULL): free(manager->tasks)\n            // dereferences NULL.\n            // -----------------------------------------------------------------\n            \"null_destroy\" => {\n                (api.destroy_task_manager)(std::ptr::null_mut());\n                done(90); // must not be reached\n            }\n\n            // -----------------------------------------------------------------\n            // ERRORS row 30 — driver(NULL): the logger and manager are set up\n            // first, then `while (*start != '\\0')` faults.\n            // -----------------------------------------------------------------\n            \"null_driver\" => {\n                let r = (api.driver)(std::ptr::null());\n                done(int_code(r)); // must not be reached\n            }\n\n            // -----------------------------------------------------------------\n            // ERRORS row 10 — malloc(sizeof(TaskManager)) itself fails.\n            // -----------------------------------------------------------------\n            \"oom_create_manager\" => {\n                // Open the log before clamping so the FILE buffer already\n                // exists; `log_error` then needs no further allocation.\n                if (api.initialize_logger)() != 0 {\n                    done(65);\n                }\n                clamp_address_space(4 << 20);\n                exhaust_heap();\n                let m = (api.create_task_manager)();\n                done(ptr_code(m));\n            }\n\n            // -----------------------------------------------------------------\n            // ERRORS row 11/12 without an env var: tasks-array allocation fails\n            // while the manager allocation still succeeds.\n            // -----------------------------------------------------------------\n            \"oom_create_tasks_array\" => {\n                if (api.initialize_logger)() != 0 {\n                    done(65);\n                }\n                // MAX_TASKS is set by the parent to something enormous.\n                clamp_address_space(4 << 20);\n                let m = (api.create_task_manager)();\n                done(ptr_code(m));\n            }\n\n            // -----------------------------------------------------------------\n            // ERRORS row 29 — driver's per-line malloc(length + 1) fails.\n            //\n            // A 32 MiB single line is built *before* the address space is\n            // clamped to +2 MiB, so `fopen` and the 16 B + 2600 B manager\n            // allocations still succeed while the 32 MiB line copy cannot.\n            // -----------------------------------------------------------------\n            \"oom_driver_task_line\" => {\n                const LINE: usize = 32 << 20;\n                let buf = libc::malloc(LINE + 1) as *mut u8;\n                if buf.is_null() {\n                    done(65);\n                }\n                libc::memset(buf as *mut c_void, b'a' as c_int, LINE);\n                *buf.add(LINE) = 0;\n                clamp_address_space(2 << 20);\n                let r = (api.driver)(buf as *const c_char);\n                done(int_code(r));\n            }\n\n            other => {\n                eprintln!(\"oracle: unknown scenario {other:?}\");\n                std::process::exit(64);\n            }\n        }\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4976,"cache_read_input_tokens":152450,"cache_creation":{"ephemeral_5m_input_tokens":4976,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"c77f6ccd-7b54-400a-8f8a-127ae646384f","uuid":"7d7c2d55-8b09-4633-aa50-b1e786572073","timestamp":"2026-08-20T00:40:16.934Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_019T1Sh7NEaMYfgeGb7514BQ","type":"tool_result","content":"File created successfully at: /local/home/scheschb/.harvest/work/harvest-work-a5p6E9/translated_rust/examples/oracle.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"c77f6ccd-7b54-400a-8f8a-127ae646384f","uuid":"6cd3958d-a836-4c84-9b70-54c545d5bfef","timestamp":"2026-08-20T00:40:16.943Z","tool_use_result":{"type":"create","filePath":"/local/home/scheschb/.harvest/work/harvest-work-a5p6E9/translated_rust/examples/oracle.rs","content":"//! Out-of-process differential oracle.\n//!\n//! Some rows of `ERRORS.md` cannot be exercised inside the test process:\n//!\n//!   * null-pointer dereferences (the C code has no null checks, so the process\n//!     is killed by `SIGSEGV` — the *termination signal* is the observable), and\n//!   * allocation failures, which are forced with `RLIMIT_AS` and therefore need\n//!     a process whose address space can be sacrificed.\n//!   * the \"never initialised\" logger state, which only exists in a brand-new\n//!     process (`static FILE *log_file == NULL`).\n//!\n//! Usage: `oracle <c|rust> <scenario>`\n//!\n//! The library under test is dlopen'd through `libloading`, exactly like the\n//! in-process tests, and the *exit code* carries the observation so that no\n//! allocation is needed after the heap has been exhausted:\n//!\n//! | exit code | meaning                                  |\n//! |-----------|------------------------------------------|\n//! | 70        | returned pointer was NULL                |\n//! | 71        | returned pointer was non-NULL            |\n//! | 80        | returned int 0                           |\n//! | 81        | returned int 1 (`EXIT_FAILURE`)          |\n//! | 82        | returned int -1                          |\n//! | 83        | returned some other int                  |\n//! | 90        | void scenario ran to completion          |\n//! | 64        | usage error / scenario not recognised     |\n//! | 65        | the scenario's own precondition failed   |\n//! | (signal)  | the library crashed — that is the result  |\n\nuse libloading::Library;\nuse std::ffi::{c_char, c_int, c_void};\nuse std::path::PathBuf;\n\nconst TASK_SIZE: usize = 260;\nconst TASKMANAGER_SIZE: usize = 16;\n\n#[repr(C)]\nstruct TaskManager {\n    tasks: *mut c_void,\n    max_tasks: c_int,\n    task_count: c_int,\n}\n\ntype FnInitializeLogger = unsafe extern \"C\" fn() -> c_int;\ntype FnLog = unsafe extern \"C\" fn(*const c_char);\ntype FnFinalizeLogger = unsafe extern \"C\" fn();\ntype FnCreate = unsafe extern \"C\" fn() -> *mut TaskManager;\ntype FnAddTask = unsafe extern \"C\" fn(*mut TaskManager, *const c_char, c_int);\ntype FnPrint = unsafe extern \"C\" fn(*const TaskManager);\ntype FnDestroy = unsafe extern \"C\" fn(*mut TaskManager);\ntype FnDriver = unsafe extern \"C\" fn(*const c_char) -> c_int;\n\nstruct Api {\n    _lib: Library,\n    initialize_logger: FnInitializeLogger,\n    log_info: FnLog,\n    log_warning: FnLog,\n    log_error: FnLog,\n    finalize_logger: FnFinalizeLogger,\n    create_task_manager: FnCreate,\n    add_task: FnAddTask,\n    print_tasks: FnPrint,\n    destroy_task_manager: FnDestroy,\n    driver: FnDriver,\n}\n\nfn load(which: &str) -> Api {\n    let path: PathBuf = match which {\n        \"c\" => std::env::var(\"C_DRIVER_SO\")\n            .expect(\"C_DRIVER_SO must be set\")\n            .into(),\n        \"rust\" => std::env::var(\"RUST_DRIVER_SO\")\n            .expect(\"RUST_DRIVER_SO must be set\")\n            .into(),\n        other => {\n            eprintln!(\"oracle: unknown implementation {other:?}\");\n            std::process::exit(64);\n        }\n    };\n    let lib = unsafe { Library::new(&path) }\n        .unwrap_or_else(|e| panic!(\"dlopen({}) failed: {e}\", path.display()));\n    macro_rules! sym {\n        ($n:literal, $t:ty) => {\n            *unsafe { lib.get::<$t>(concat!($n, \"\\0\").as_bytes()) }.expect(concat!(\"missing \", $n))\n        };\n    }\n    let a = Api {\n        initialize_logger: sym!(\"initialize_logger\", FnInitializeLogger),\n        log_info: sym!(\"log_info\", FnLog),\n        log_warning: sym!(\"log_warning\", FnLog),\n        log_error: sym!(\"log_error\", FnLog),\n        finalize_logger: sym!(\"finalize_logger\", FnFinalizeLogger),\n        create_task_manager: sym!(\"create_task_manager\", FnCreate),\n        add_task: sym!(\"add_task\", FnAddTask),\n        print_tasks: sym!(\"print_tasks\", FnPrint),\n        destroy_task_manager: sym!(\"destroy_task_manager\", FnDestroy),\n        driver: sym!(\"driver\", FnDriver),\n        _lib: lib,\n    };\n    a\n}\n\n/// `libc::exit` (not `std::process::exit`): it flushes glibc's streams — which\n/// is where the library's log file and `stdout` live — and needs no allocation,\n/// so it is safe to call after the heap has been deliberately exhausted.\nfn done(code: c_int) -> ! {\n    unsafe { libc::exit(code) }\n}\n\nfn ptr_code<T>(p: *const T) -> c_int {\n    if p.is_null() { 70 } else { 71 }\n}\n\nfn int_code(r: c_int) -> c_int {\n    match r {\n        0 => 80,\n        1 => 81,\n        -1 => 82,\n        _ => 83,\n    }\n}\n\n/// Current virtual-memory size in bytes, from /proc/self/statm.\nfn vm_size_bytes() -> usize {\n    let s = std::fs::read_to_string(\"/proc/self/statm\").expect(\"read statm\");\n    let pages: usize = s\n        .split_whitespace()\n        .next()\n        .and_then(|t| t.parse().ok())\n        .expect(\"parse statm\");\n    pages * 4096\n}\n\n/// Clamp the address space to \"what we use now + slack\", so that any further\n/// large allocation fails deterministically.\nfn clamp_address_space(slack: usize) {\n    let limit = vm_size_bytes() + slack;\n    let rl = libc::rlimit {\n        rlim_cur: limit as libc::rlim_t,\n        rlim_max: limit as libc::rlim_t,\n    };\n    let rc = unsafe { libc::setrlimit(libc::RLIMIT_AS, &rl) };\n    assert_eq!(rc, 0, \"setrlimit(RLIMIT_AS) failed\");\n}\n\n/// Allocate (and deliberately leak) until a 16-byte `malloc` fails, so that the\n/// very first allocation inside `create_task_manager` returns NULL.\nfn exhaust_heap() {\n    loop {\n        let p = unsafe { libc::malloc(16) };\n        if p.is_null() {\n            return;\n        }\n    }\n}\n\nfn main() {\n    let args: Vec<String> = std::env::args().collect();\n    if args.len() < 3 {\n        eprintln!(\"usage: oracle <c|rust> <scenario>\");\n        std::process::exit(64);\n    }\n    let api = load(&args[1]);\n    let scenario = args[2].as_str();\n\n    unsafe {\n        match scenario {\n            // -----------------------------------------------------------------\n            // Sanity check of the oracle plumbing itself.\n            // -----------------------------------------------------------------\n            \"ok_driver\" => {\n                let text = b\"alpha\\nbeta\\n\\0\";\n                let r = (api.driver)(text.as_ptr() as *const c_char);\n                done(int_code(r));\n            }\n\n            // -----------------------------------------------------------------\n            // ERRORS rows 5-8, in the genuinely-uninitialised state\n            // (`static FILE *log_file == NULL` in a brand-new process).\n            // -----------------------------------------------------------------\n            \"fresh_log_before_init\" => {\n                let m = b\"before init\\0\";\n                (api.log_info)(m.as_ptr() as *const c_char);\n                (api.log_warning)(m.as_ptr() as *const c_char);\n                (api.log_error)(m.as_ptr() as *const c_char);\n                // must not fclose anything and must not log \"Logger finalized.\"\n                (api.finalize_logger)();\n                done(90);\n            }\n\n            // -----------------------------------------------------------------\n            // ERRORS row 19 — add_task(NULL, ...) dereferences NULL.\n            // -----------------------------------------------------------------\n            \"null_add_task_manager\" => {\n                let d = b\"task\\0\";\n                (api.add_task)(\n                    std::ptr::null_mut(),\n                    d.as_ptr() as *const c_char,\n                    1,\n                );\n                done(90); // must not be reached\n            }\n\n            // -----------------------------------------------------------------\n            // ERRORS row 20 — add_task(m, NULL, p) with room left: strncpy reads\n            // from NULL.\n            // -----------------------------------------------------------------\n            \"null_add_task_desc\" => {\n                if (api.initialize_logger)() != 0 {\n                    done(65);\n                }\n                let m = (api.create_task_manager)();\n                if m.is_null() {\n                    done(65);\n                }\n                (api.add_task)(m, std::ptr::null(), 1);\n                done(90); // must not be reached\n            }\n\n            // -----------------------------------------------------------------\n            // ERRORS row 22 — print_tasks(NULL): \"Tasks:\\n\" is emitted first,\n            // then the dereference faults.\n            // -----------------------------------------------------------------\n            \"null_print_manager\" => {\n                (api.print_tasks)(std::ptr::null());\n                done(90); // must not be reached\n            }\n\n            // -----------------------------------------------------------------\n            // ERRORS row 23 — manager->tasks == NULL while task_count > 0.\n            // -----------------------------------------------------------------\n            \"null_print_tasks_array\" => {\n                let m = libc::malloc(TASKMANAGER_SIZE) as *mut TaskManager;\n                if m.is_null() {\n                    done(65);\n                }\n                (*m).tasks = std::ptr::null_mut();\n                (*m).max_tasks = 5;\n                (*m).task_count = 3;\n                (api.print_tasks)(m);\n                done(90); // must not be reached\n            }\n\n            // -----------------------------------------------------------------\n            // ERRORS row 25 — destroy_task_manager(NULL): free(manager->tasks)\n            // dereferences NULL.\n            // -----------------------------------------------------------------\n            \"null_destroy\" => {\n                (api.destroy_task_manager)(std::ptr::null_mut());\n                done(90); // must not be reached\n            }\n\n            // -----------------------------------------------------------------\n            // ERRORS row 30 — driver(NULL): the logger and manager are set up\n            // first, then `while (*start != '\\0')` faults.\n            // -----------------------------------------------------------------\n            \"null_driver\" => {\n                let r = (api.driver)(std::ptr::null());\n                done(int_code(r)); // must not be reached\n            }\n\n            // -----------------------------------------------------------------\n            // ERRORS row 10 — malloc(sizeof(TaskManager)) itself fails.\n            // -----------------------------------------------------------------\n            \"oom_create_manager\" => {\n                // Open the log before clamping so the FILE buffer already\n                // exists; `log_error` then needs no further allocation.\n                if (api.initialize_logger)() != 0 {\n                    done(65);\n                }\n                clamp_address_space(4 << 20);\n                exhaust_heap();\n                let m = (api.create_task_manager)();\n                done(ptr_code(m));\n            }\n\n            // -----------------------------------------------------------------\n            // ERRORS row 11/12 without an env var: tasks-array allocation fails\n            // while the manager allocation still succeeds.\n            // -----------------------------------------------------------------\n            \"oom_create_tasks_array\" => {\n                if (api.initialize_logger)() != 0 {\n                    done(65);\n                }\n                // MAX_TASKS is set by the parent to something enormous.\n                clamp_address_space(4 << 20);\n                let m = (api.create_task_manager)();\n                done(ptr_code(m));\n            }\n\n            // -----------------------------------------------------------------\n            // ERRORS row 29 — driver's per-line malloc(length + 1) fails.\n            //\n            // A 32 MiB single line is built *before* the address space is\n            // clamped to +2 MiB, so `fopen` and the 16 B + 2600 B manager\n            // allocations still succeed while the 32 MiB line copy cannot.\n            // -----------------------------------------------------------------\n            \"oom_driver_task_line\" => {\n                const LINE: usize = 32 << 20;\n                let buf = libc::malloc(LINE + 1) as *mut u8;\n                if buf.is_null() {\n                    done(65);\n                }\n                libc::memset(buf as *mut c_void, b'a' as c_int, LINE);\n                *buf.add(LINE) = 0;\n                clamp_address_space(2 << 20);\n                let r = (api.driver)(buf as *const c_char);\n                done(int_code(r));\n            }\n\n            other => {\n                eprintln!(\"oracle: unknown scenario {other:?}\");\n                std::process::exit(64);\n            }\n        }\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
