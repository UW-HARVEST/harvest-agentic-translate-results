   assert_eq!(lines, 102, \"unexpected C record count\");\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2075,"cache_read_input_tokens":108055,"cache_creation":{"ephemeral_5m_input_tokens":2075,"ephemeral_1h_input_tokens":0},"output_tokens":7,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"c77f6ccd-7b54-400a-8f8a-127ae646384f","uuid":"5457ce5b-1ace-4ddf-9cf6-a0591a0ae2a7","timestamp":"2026-08-20T00:22:41.559Z"}
