k c;\n107\t                    }\n108\t                }\n109\t            }\n110\t        };\n111\t\n112\t        let mut negative = false;\n113\t        if c == b'-' || c == b'+' {\n114\t            negative = c == b'-';\n115\t            match self.getc() {\n116\t                None => {\n117\t                    // Only a sign was read: no number, matching failure.\n118\t                    return Conv::MatchFail;\n119\t                }\n120\t                Some(next) => c = next,\n121\t            }\n122\t        }\n123\t\n124\t        // Accumulate the digits the way glibc does: the value is computed as a\n125\t        // `long int` (saturating on overflow) and then truncated to `int`.\n126\t        let mut digits = 0usize;\n127\t        let mut mag: u128 = 0;\n128\t        let mut overflow = false;\n129\t        loop {\n130\t            if !c.is_ascii_digit() {\n131\t                self.ungetc();\n132\t                break;\n133\t            }\n134\t            digits += 1;\n135\t            if !overflow {\n136\t                mag = mag * 10 + u128::from(c - b'0');\n137\t                if mag > (i64::MAX as u128) + 1 {\n138\t                    overflow = true;\n139\t                }\n140\t            }\n141\t            match self.getc() {\n142\t                None => break,\n143\t                Some(next) => c = next,\n144\t            }\n145\t        }\n146\t\n147\t        if digits == 0 {\n148\t            return Conv::MatchFail;\n149\t        }\n150\t\n151\t        let as_long: i64 = if negative {\n152\t            if overflow || mag > (i64::MAX as u128) + 1 {\n153\t                i64::MIN\n154\t            } else {\n155\t                (-(mag as i128)) as i64\n156\t            }\n157\t        } else if overflow || mag > i64::MAX as u128 {\n158\t            i64::MAX\n159\t        } else {\n160\t            mag as i64\n161\t        };\n162\t\n163\t        // `long` -> `int` -> stored through an `unsigned int *`.\n164\t        *out = as_long as u32;\n165\t        Conv::Assigned\n166\t    }\n167\t\n168\t    /// `%<width>[...]` scan set conversion. `in_set` decides membership.\n169\t    fn scan_set<F>(&mut self, width: usize, in_set: F, out: &mut Vec<u8>) -> Conv\n170\t    where\n171\t        F: Fn(u8) -> bool,\n172\t    {\n173\t        // No leading whitespace is skipped for scan sets.\n174\t        let mut c = match self.getc() {\n175\t            None => return Conv::InputFail,\n176\t            Some(c) => c,\n177\t        };\n178\t\n179\t        let mut collected: Vec<u8> = Vec::new();\n180\t        loop {\n181\t            if !in_set(c) {\n182\t                self.ungetc();\n183\t                break;\n184\t            }\n185\t            collected.push(c);\n186\t            if collected.len() == width {\n187\t                // Width reached: no further character is consumed.\n188\t                break;\n189\t            }\n190\t            match self.getc() {\n191\t                None => break,\n192\t                Some(next) => c = next,\n193\t            }\n194\t        }\n195\t\n196\t        if collected.is_empty() {\n197\t            // Matching failure: the destination buffer is left untouched.\n198\t            return Conv::MatchFail;\n199\t        }\n200\t\n201\t        *out = collected;\n202\t        Conv::Assigned\n203\t    }\n204\t}\n205\t\n206\t/// `isspace()` in the \"C\" locale.\n207\tfn is_c_space(c: u8) -> bool {\n208\t    matches!(c, b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r')\n209\t}\n210\t\n211\tfn is_upper_alnum(c: u8) -> bool {\n212\t    c.is_ascii_uppercase() || c.is_ascii_digit()\n213\t}\n214\t\n215\tfn is_upper(c: u8) -> bool {\n216\t    c.is_ascii_uppercase()\n217\t}\n218\t\n219\t// scanf(\"%d \", &time_stamp)\n220\tfn scanf_time_stamp(sc: &mut Scanner, time_stamp: &mut u32) -> i32 {\n221\t    match sc.scan_d(time_stamp) {\n222\t        Conv::InputFail => return EOF,\n223\t        Conv::MatchFail => return 0,\n224\t        Conv::Assigned => {}\n225\t    }\n226\t    sc.skip_ws_directive();\n227\t    1\n228\t}\n229\t\n230\t// scanf(\"%8[A-Z0-9] %6[A-Z0-9] \", luggage_id, flight_id)\n231\tfn scanf_ids(sc: &mut Scanner, luggage_id: &mut Vec<u8>, flight_id: &mut Vec<u8>) -> i32 {\n232\t    let mut assigned = 0;\n233\t    match sc.scan_set(LUGGAGE_ID_LENGTH, is_upper_alnum, luggage_id) {\n234\t        Conv::InputFail => return EOF,\n235\t        Conv::MatchFail => return assigned,\n236\t        Conv::Assigned => assigned = 1,\n237\t    }\n238\t    sc.skip_ws_directive();\n239\t    match sc.scan_set(FLIGHT_ID_LENGTH, is_upper_alnum, flight_id) {\n240\t        Conv::InputFail => return assigned,\n241\t        Conv::MatchFail => return assigned,\n242\t        Conv::Assigned => assigned = 2,\n243\t    }\n244\t    sc.skip_ws_directive();\n245\t    assigned\n246\t}\n247\t\n248\t// scanf(\"%3[A-Z] %3[A-Z]\", departure, arrival)\n249\tfn scanf_airports(sc: &mut Scanner, departure: &mut Vec<u8>, arrival: &mut Vec<u8>) -> i32 {\n250\t    let mut assigned = 0;\n251\t    match sc.scan_set(AIRPORT_CODE_LENGTH, is_upper, departure) {\n252\t        Conv::InputFail => return EOF,\n253\t        Conv::MatchFail => return assigned,\n254\t        Conv::Assigned => assigned = 1,\n255\t    }\n256\t    sc.skip_ws_directive();\n257\t    match sc.scan_set(AIRPORT_CODE_LENGTH, is_upper, arrival) {\n258\t        Conv::InputFail => return assigned,\n259\t        Conv::MatchFail => return assigned,\n260\t        Conv::Assigned => assigned = 2,\n261\t    }\n262\t    assigned\n263\t}\n264\t\n265\t// scanf(\"%80[^\\n]\", comments)\n266\tfn scanf_comments(sc: &mut Scanner, comments: &mut Vec<u8>) -> i32 {\n267\t    match sc.scan_set(COMMENTS_LENGTH, |c| c != b'\\n', comments) {\n268\t        Conv::InputFail => EOF,\n269\t        Conv::MatchFail => 0,\n270\t        Conv::Assigned => 1,\n271\t    }\n272\t}\n273\t\n274\t// ---------------------------------------------------------------------------\n275\t// Routing directive list\n276\t// ---------------------------------------------------------------------------\n277\t\n278\tstruct RoutingDirective {\n279\t    time_stamp: u32,\n280\t    luggage_id: Vec<u8>,\n281\t    flight_id: Vec<u8>,\n282\t    departure: Vec<u8>,\n283\t    arrival: Vec<u8>,\n284\t    comments: Vec<u8>,\n285\t    next_directive: Option<usize>,\n286\t}\n287\t\n288\t/// The linked list is modelled with an arena; index 0 is the list head that the\n289\t/// C code keeps on the stack.\n290\tstruct Arena {\n291\t    nodes: Vec<RoutingDirective>,\n292\t}\n293\t\n294\timpl Arena {\n295\t    fn new() -> Self {\n296\t        Arena {\n297\t            nodes: vec![RoutingDirective {\n298\t                time_stamp: 0,\n299\t                luggage_id: Vec::new(),\n300\t                flight_id: Vec::new(),\n301\t                departure: Vec::new(),\n302\t                arrival: Vec::new(),\n303\t                comments: Vec::new(),\n304\t                next_directive: None,\n305\t            }],\n306\t        }\n307\t    }\n308\t}\n309\t\n310\tfn add_routing_directive_to_list(arena: &mut Arena, previous: usize, new_directive: usize) {\n311\t    let mut previous_directive = previous;\n312\t    loop {\n313\t        let next_directive = arena.nodes[previous_directive].next_directive;\n314\t        let insert_here = match next_directive {\n315\t            None => true,\n316\t            Some(n) => arena.nodes[n].time_stamp > arena.nodes[new_directive].time_stamp,\n317\t        };\n318\t        if insert_here {\n319\t            arena.nodes[new_directive].next_directive = next_directive;\n320\t            arena.nodes[previous_directive].next_directive = Some(new_directive);\n321\t            return;\n322\t        }\n323\t        previous_directive = next_directive.unwrap();\n324\t    }\n325\t}\n326\t\n327\tfn supersedes(arena: &Arena, directive: Option<usize>, luggage_id: &[u8], departure: &[u8]) -> bool {\n328\t    let mut current = directive;\n329\t    loop {\n330\t        let idx = match current {\n331\t            None => return false,\n332\t            Some(i) => i,\n333\t        };\n334\t        if !c_str_eq(&arena.nodes[idx].luggage_id, luggage_id) {\n335\t            current = arena.nodes[idx].next_directive;\n336\t            continue;\n337\t        }\n338\t        return c_str_eq(&arena.nodes[idx].departure, departure);\n339\t    }\n340\t}\n341\t\n342\tfn superseded(arena: &Arena, directive: usize) -> bool {\n343\t    let luggage_id = arena.nodes[directive].luggage_id.clone();\n344\t    let departure = arena.nodes[directive].departure.clone();\n345\t    supersedes(\n346\t        arena,\n347\t        arena.nodes[directive].next_directive,\n348\t        &luggage_id,\n349\t        &departure,\n350\t    )\n351\t}\n352\t\n353\tfn matches(expected: &[u8], actual: &[u8]) -> bool {\n354\t    // `expected[0] == '-'` in C reads the first byte of a NUL terminated\n355\t    // string, which is '\\0' for an empty argument.\n356\t    let first = expected.first().copied().unwrap_or(0);\n357\t    first == b'-' || c_str_eq(expected, actual)\n358\t}\n359\t\n360\tfn print_matching_directives(\n361\t    out: &mut impl Write,\n362\t    arena: &Arena,\n363\t    first_directive: Option<usize>,\n364\t    expected_luggage_id: &[u8],\n365\t    expected_flight_id: &[u8],\n366\t    expected_departure: &[u8],\n367\t    expected_arrival: &[u8],\n368\t) {\n369\t    let mut directive = first_directive;\n370\t    while let Some(idx) = directive {\n371\t        let node = &arena.nodes[idx];\n372\t        if !superseded(arena, idx)\n373\t            && matches(expected_luggage_id, &node.luggage_id)\n374\t            && matches(expected_flight_id, &node.flight_id)\n375\t            && matches(expected_departure, &node.departure)\n376\t            && matches(expected_arrival, &node.arrival)\n377\t        {\n378\t            // printf(\"%010u %s %s %s %s %s\\n\", ...)\n379\t            let mut line: Vec<u8> = Vec::new();\n380\t            line.extend_from_slice(format!(\"{:010}\", node.time_stamp).as_bytes());\n381\t            for field in [\n382\t                &node.luggage_id,\n383\t                &node.flight_id,\n384\t                &node.departure,\n385\t                &node.arrival,\n386\t                &node.comments,\n387\t            ] {\n388\t                line.push(b' ');\n389\t                line.extend_from_slice(&c_str(field));\n390\t            }\n391\t            line.push(b'\\n');\n392\t            let _ = out.write_all(&line);\n393\t        }\n394\t        directive = arena.nodes[idx].next_directive;\n395\t    }\n396\t}\n397\t\n398\t// ---------------------------------------------------------------------------\n399\t// main\n400\t// ---------------------------------------------------------------------------\n401\t\n402\tfn arg_bytes(arg: &std::ffi::OsString) -> Vec<u8> {\n403\t    #[cfg(unix)]\n404\t    {\n405\t        use std::os::unix::ffi::OsStrExt;\n406\t        arg.as_os_str().as_bytes().to_vec()\n407\t    }\n408\t    #[cfg(not(unix))]\n409\t    {\n410\t        arg.to_string_lossy().as_bytes().to_vec()\n411\t    }\n412\t}\n413\t\n414\tfn main() {\n415\t    let argv: Vec<std::ffi::OsString> = std::env::args_os().collect();\n416\t    let argc = argv.len();\n417\t\n418\t    if argc != 5 {\n419\t        let stderr = io::stderr();\n420\t        let mut stderr = stderr.lock();\n421\t        let _ = stderr.write_all(b\"Command line error: 4 arguments expected\\n\");\n422\t        let _ = stderr.flush();\n423\t        std::process::exit(1);\n424\t    }\n425\t\n426\t    let mut input = Vec::new();\n427\t    let _ = io::stdin().lock().read_to_end(&mut input);\n428\t    let mut sc = Scanner::new(input);\n429\t\n430\t    let mut arena = Arena::new();\n431\t    let directive_list_head = 0usize;\n432\t\n433\t    // The C code declares these inside the loop body; on a matching failure\n434\t    // scanf() leaves them untouched, so they keep whatever the previous\n435\t    // iteration left in that stack slot (zeroed on the first iteration).\n436\t    let mut time_stamp: u32 = 0;\n437\t    let mut luggage_id: Vec<u8> = Vec::new();\n438\t    let mut flight_id: Vec<u8> = Vec::new();\n439\t    let mut departure: Vec<u8> = Vec::new();\n440\t    let mut arrival: Vec<u8> = Vec::new();\n441\t    let mut comments: Vec<u8>;\n442\t\n443\t    loop {\n444\t        comments = Vec::new(); // comments[0] = 0; comments are optional.\n445\t\n446\t        if scanf_time_stamp(&mut sc, &mut time_stamp) == EOF {\n447\t            break;\n448\t        }\n449\t        if scanf_ids(&mut sc, &mut luggage_id, &mut flight_id) == EOF {\n450\t            break;\n451\t        }\n452\t        if scanf_airports(&mut sc, &mut departure, &mut arrival) == EOF {\n453\t            break;\n454\t        }\n455\t        if scanf_comments(&mut sc, &mut comments) == EOF {\n456\t            break;\n457\t        }\n458\t\n459\t        arena.nodes.push(RoutingDirective {\n460\t            time_stamp,\n461\t            luggage_id: c_str(&luggage_id),\n462\t            flight_id: c_str(&flight_id),\n463\t            departure: c_str(&departure),\n464\t            arrival: c_str(&arrival),\n465\t            comments: c_str(&comments),\n466\t            next_directive: None,\n467\t        });\n468\t        let new_directive = arena.nodes.len() - 1;\n469\t\n470\t        add_routing_directive_to_list(&mut arena, directive_list_head, new_directive);\n471\t    }\n472\t\n473\t    let stdout = io::stdout();\n474\t    let mut out = io::BufWriter::new(stdout.lock());\n475\t    print_matching_directives(\n476\t        &mut out,\n477\t        &arena,\n478\t        arena.nodes[directive_list_head].next_directive,\n479\t        &arg_bytes(&argv[1]),\n480\t        &arg_bytes(&argv[2]),\n481\t        &arg_bytes(&argv[3]),\n482\t        &arg_bytes(&argv[4]),\n483\t    );\n484\t    let _ = out.flush();\n485\t    std::process::exit(0);\n486\t}\n487\t"}]},"parent_tool_use_id":null,"session_id":"419e6be5-3675-4ebb-83ec-0c54728d00a3","uuid":"c4c095d3-97a9-4248-89a4-c295939610df","timestamp":"2026-08-20T18:03:01.292Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-N3x6p9/translated_rust/src/main.rs","content":"// Rust translation of c_src/src/luggage.c\n// Original C by Jan Wrobel <wrr@mixedbit.org>\n//\n// The translation reproduces the observable behaviour of the C program\n// byte-for-byte, including the quirks of the original `scanf()` usage\n// (buffers that keep stale values when a conversion fails, records that are\n// silently dropped when EOF is reached in the middle of a line, `%d` being\n// used for an `unsigned int`, ...).\n\nuse std::io::{self, Read, Write};\n\nconst LUGGAGE_ID_LENGTH: usize = 8;\nconst FLIGHT_ID_LENGTH: usize = 6;\nconst AIRPORT_CODE_LENGTH: usize = 3;\nconst COMMENTS_LENGTH: usize = 80;\n\n// ---------------------------------------------------------------------------\n// C string helpers\n// ---------------------------------------------------------------------------\n\n/// Emulates `strcpy()` from a scanf destination buffer: the C buffers are NUL\n/// terminated character arrays, so copying stops at the first NUL byte.\nfn c_str(bytes: &[u8]) -> Vec<u8> {\n    match bytes.iter().position(|&b| b == 0) {\n        Some(i) => bytes[..i].to_vec(),\n        None => bytes.to_vec(),\n    }\n}\n\n/// Emulates `strcmp(a, b) == 0` for NUL terminated strings.\nfn c_str_eq(a: &[u8], b: &[u8]) -> bool {\n    c_str(a) == c_str(b)\n}\n\n// ---------------------------------------------------------------------------\n// scanf() emulation\n// ---------------------------------------------------------------------------\n\n/// Result of a single conversion directive.\nenum Conv {\n    /// The conversion succeeded and a value was assigned.\n    Assigned,\n    /// Matching failure: nothing was assigned, the destination is untouched.\n    MatchFail,\n    /// Input failure: end of input was reached before anything was matched.\n    InputFail,\n}\n\n/// C's `EOF` value as returned by `scanf()`.\nconst EOF: i32 = -1;\n\nstruct Scanner {\n    data: Vec<u8>,\n    pos: usize,\n}\n\nimpl Scanner {\n    fn new(data: Vec<u8>) -> Self {\n        Scanner { data, pos: 0 }\n    }\n\n    /// `getc()`\n    fn getc(&mut self) -> Option<u8> {\n        if self.pos < self.data.len() {\n            let c = self.data[self.pos];\n            self.pos += 1;\n            Some(c)\n        } else {\n            // Keep pos at end; EOF is sticky for our purposes.\n            None\n        }\n    }\n\n    /// `ungetc()` of the character that was just read.\n    fn ungetc(&mut self) {\n        if self.pos > 0 {\n            self.pos -= 1;\n        }\n    }\n\n    /// A whitespace directive in the format string: consumes any amount of\n    /// whitespace (possibly none) and never fails, not even at end of input.\n    fn skip_ws_directive(&mut self) {\n        loop {\n            match self.getc() {\n                None => return,\n                Some(c) => {\n                    if !is_c_space(c) {\n                        self.ungetc();\n                        return;\n                    }\n                }\n            }\n        }\n    }\n\n    /// `%d` into an `unsigned int` (as the original C code does).\n    fn scan_d(&mut self, out: &mut u32) -> Conv {\n        // Leading whitespace is skipped as part of the conversion; reaching\n        // end of input while doing so is an input failure.\n        let mut c = loop {\n            match self.getc() {\n                None => return Conv::InputFail,\n                Some(c) => {\n                    if !is_c_space(c) {\n                        break c;\n                    }\n                }\n            }\n        };\n\n        let mut negative = false;\n        if c == b'-' || c == b'+' {\n            negative = c == b'-';\n            match self.getc() {\n                None => {\n                    // Only a sign was read: no number, matching failure.\n                    return Conv::MatchFail;\n                }\n                Some(next) => c = next,\n            }\n        }\n\n        // Accumulate the digits the way glibc does: the value is computed as a\n        // `long int` (saturating on overflow) and then truncated to `int`.\n        let mut digits = 0usize;\n        let mut mag: u128 = 0;\n        let mut overflow = false;\n        loop {\n            if !c.is_ascii_digit() {\n                self.ungetc();\n                break;\n            }\n            digits += 1;\n            if !overflow {\n                mag = mag * 10 + u128::from(c - b'0');\n                if mag > (i64::MAX as u128) + 1 {\n                    overflow = true;\n                }\n            }\n            match self.getc() {\n                None => break,\n                Some(next) => c = next,\n            }\n        }\n\n        if digits == 0 {\n            return Conv::MatchFail;\n        }\n\n        let as_long: i64 = if negative {\n            if overflow || mag > (i64::MAX as u128) + 1 {\n                i64::MIN\n            } else {\n                (-(mag as i128)) as i64\n            }\n        } else if overflow || mag > i64::MAX as u128 {\n            i64::MAX\n        } else {\n            mag as i64\n        };\n\n        // `long` -> `int` -> stored through an `unsigned int *`.\n        *out = as_long as u32;\n        Conv::Assigned\n    }\n\n    /// `%<width>[...]` scan set conversion. `in_set` decides membership.\n    fn scan_set<F>(&mut self, width: usize, in_set: F, out: &mut Vec<u8>) -> Conv\n    where\n        F: Fn(u8) -> bool,\n    {\n        // No leading whitespace is skipped for scan sets.\n        let mut c = match self.getc() {\n            None => return Conv::InputFail,\n            Some(c) => c,\n        };\n\n        let mut collected: Vec<u8> = Vec::new();\n        loop {\n            if !in_set(c) {\n                self.ungetc();\n                break;\n            }\n            collected.push(c);\n            if collected.len() == width {\n                // Width reached: no further character is consumed.\n                break;\n            }\n            match self.getc() {\n                None => break,\n                Some(next) => c = next,\n            }\n        }\n\n        if collected.is_empty() {\n            // Matching failure: the destination buffer is left untouched.\n            return Conv::MatchFail;\n        }\n\n        *out = collected;\n        Conv::Assigned\n    }\n}\n\n/// `isspace()` in the \"C\" locale.\nfn is_c_space(c: u8) -> bool {\n    matches!(c, b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r')\n}\n\nfn is_upper_alnum(c: u8) -> bool {\n    c.is_ascii_uppercase() || c.is_ascii_digit()\n}\n\nfn is_upper(c: u8) -> bool {\n    c.is_ascii_uppercase()\n}\n\n// scanf(\"%d \", &time_stamp)\nfn scanf_time_stamp(sc: &mut Scanner, time_stamp: &mut u32) -> i32 {\n    match sc.scan_d(time_stamp) {\n        Conv::InputFail => return EOF,\n        Conv::MatchFail => return 0,\n        Conv::Assigned => {}\n    }\n    sc.skip_ws_directive();\n    1\n}\n\n// scanf(\"%8[A-Z0-9] %6[A-Z0-9] \", luggage_id, flight_id)\nfn scanf_ids(sc: &mut Scanner, luggage_id: &mut Vec<u8>, flight_id: &mut Vec<u8>) -> i32 {\n    let mut assigned = 0;\n    match sc.scan_set(LUGGAGE_ID_LENGTH, is_upper_alnum, luggage_id) {\n        Conv::InputFail => return EOF,\n        Conv::MatchFail => return assigned,\n        Conv::Assigned => assigned = 1,\n    }\n    sc.skip_ws_directive();\n    match sc.scan_set(FLIGHT_ID_LENGTH, is_upper_alnum, flight_id) {\n        Conv::InputFail => return assigned,\n        Conv::MatchFail => return assigned,\n        Conv::Assigned => assigned = 2,\n    }\n    sc.skip_ws_directive();\n    assigned\n}\n\n// scanf(\"%3[A-Z] %3[A-Z]\", departure, arrival)\nfn scanf_airports(sc: &mut Scanner, departure: &mut Vec<u8>, arrival: &mut Vec<u8>) -> i32 {\n    let mut assigned = 0;\n    match sc.scan_set(AIRPORT_CODE_LENGTH, is_upper, departure) {\n        Conv::InputFail => return EOF,\n        Conv::MatchFail => return assigned,\n        Conv::Assigned => assigned = 1,\n    }\n    sc.skip_ws_directive();\n    match sc.scan_set(AIRPORT_CODE_LENGTH, is_upper, arrival) {\n        Conv::InputFail => return assigned,\n        Conv::MatchFail => return assigned,\n        Conv::Assigned => assigned = 2,\n    }\n    assigned\n}\n\n// scanf(\"%80[^\\n]\", comments)\nfn scanf_comments(sc: &mut Scanner, comments: &mut Vec<u8>) -> i32 {\n    match sc.scan_set(COMMENTS_LENGTH, |c| c != b'\\n', comments) {\n        Conv::InputFail => EOF,\n        Conv::MatchFail => 0,\n        Conv::Assigned => 1,\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Routing directive list\n// ---------------------------------------------------------------------------\n\nstruct RoutingDirective {\n    time_stamp: u32,\n    luggage_id: Vec<u8>,\n    flight_id: Vec<u8>,\n    departure: Vec<u8>,\n    arrival: Vec<u8>,\n    comments: Vec<u8>,\n    next_directive: Option<usize>,\n}\n\n/// The linked list is modelled with an arena; index 0 is the list head that the\n/// C code keeps on the stack.\nstruct Arena {\n    nodes: Vec<RoutingDirective>,\n}\n\nimpl Arena {\n    fn new() -> Self {\n        Arena {\n            nodes: vec![RoutingDirective {\n                time_stamp: 0,\n                luggage_id: Vec::new(),\n                flight_id: Vec::new(),\n                departure: Vec::new(),\n                arrival: Vec::new(),\n                comments: Vec::new(),\n                next_directive: None,\n            }],\n        }\n    }\n}\n\nfn add_routing_directive_to_list(arena: &mut Arena, previous: usize, new_directive: usize) {\n    let mut previous_directive = previous;\n    loop {\n        let next_directive = arena.nodes[previous_directive].next_directive;\n        let insert_here = match next_directive {\n            None => true,\n            Some(n) => arena.nodes[n].time_stamp > arena.nodes[new_directive].time_stamp,\n        };\n        if insert_here {\n            arena.nodes[new_directive].next_directive = next_directive;\n            arena.nodes[previous_directive].next_directive = Some(new_directive);\n            return;\n        }\n        previous_directive = next_directive.unwrap();\n    }\n}\n\nfn supersedes(arena: &Arena, directive: Option<usize>, luggage_id: &[u8], departure: &[u8]) -> bool {\n    let mut current = directive;\n    loop {\n        let idx = match current {\n            None => return false,\n            Some(i) => i,\n        };\n        if !c_str_eq(&arena.nodes[idx].luggage_id, luggage_id) {\n            current = arena.nodes[idx].next_directive;\n            continue;\n        }\n        return c_str_eq(&arena.nodes[idx].departure, departure);\n    }\n}\n\nfn superseded(arena: &Arena, directive: usize) -> bool {\n    let luggage_id = arena.nodes[directive].luggage_id.clone();\n    let departure = arena.nodes[directive].departure.clone();\n    supersedes(\n        arena,\n        arena.nodes[directive].next_directive,\n        &luggage_id,\n        &departure,\n    )\n}\n\nfn matches(expected: &[u8], actual: &[u8]) -> bool {\n    // `expected[0] == '-'` in C reads the first byte of a NUL terminated\n    // string, which is '\\0' for an empty argument.\n    let first = expected.first().copied().unwrap_or(0);\n    first == b'-' || c_str_eq(expected, actual)\n}\n\nfn print_matching_directives(\n    out: &mut impl Write,\n    arena: &Arena,\n    first_directive: Option<usize>,\n    expected_luggage_id: &[u8],\n    expected_flight_id: &[u8],\n    expected_departure: &[u8],\n    expected_arrival: &[u8],\n) {\n    let mut directive = first_directive;\n    while let Some(idx) = directive {\n        let node = &arena.nodes[idx];\n        if !superseded(arena, idx)\n            && matches(expected_luggage_id, &node.luggage_id)\n            && matches(expected_flight_id, &node.flight_id)\n            && matches(expected_departure, &node.departure)\n            && matches(expected_arrival, &node.arrival)\n        {\n            // printf(\"%010u %s %s %s %s %s\\n\", ...)\n            let mut line: Vec<u8> = Vec::new();\n            line.extend_from_slice(format!(\"{:010}\", node.time_stamp).as_bytes());\n            for field in [\n                &node.luggage_id,\n                &node.flight_id,\n                &node.departure,\n                &node.arrival,\n                &node.comments,\n            ] {\n                line.push(b' ');\n                line.extend_from_slice(&c_str(field));\n            }\n            line.push(b'\\n');\n            let _ = out.write_all(&line);\n        }\n        directive = arena.nodes[idx].next_directive;\n    }\n}\n\n// ---------------------------------------------------------------------------\n// main\n// ---------------------------------------------------------------------------\n\nfn arg_bytes(arg: &std::ffi::OsString) -> Vec<u8> {\n    #[cfg(unix)]\n    {\n        use std::os::unix::ffi::OsStrExt;\n        arg.as_os_str().as_bytes().to_vec()\n    }\n    #[cfg(not(unix))]\n    {\n        arg.to_string_lossy().as_bytes().to_vec()\n    }\n}\n\nfn main() {\n    let argv: Vec<std::ffi::OsString> = std::env::args_os().collect();\n    let argc = argv.len();\n\n    if argc != 5 {\n        let stderr = io::stderr();\n        let mut stderr = stderr.lock();\n        let _ = stderr.write_all(b\"Command line error: 4 arguments expected\\n\");\n        let _ = stderr.flush();\n        std::process::exit(1);\n    }\n\n    let mut input = Vec::new();\n    let _ = io::stdin().lock().read_to_end(&mut input);\n    let mut sc = Scanner::new(input);\n\n    let mut arena = Arena::new();\n    let directive_list_head = 0usize;\n\n    // The C code declares these inside the loop body; on a matching failure\n    // scanf() leaves them untouched, so they keep whatever the previous\n    // iteration left in that stack slot (zeroed on the first iteration).\n    let mut time_stamp: u32 = 0;\n    let mut luggage_id: Vec<u8> = Vec::new();\n    let mut flight_id: Vec<u8> = Vec::new();\n    let mut departure: Vec<u8> = Vec::new();\n    let mut arrival: Vec<u8> = Vec::new();\n    let mut comments: Vec<u8>;\n\n    loop {\n        comments = Vec::new(); // comments[0] = 0; comments are optional.\n\n        if scanf_time_stamp(&mut sc, &mut time_stamp) == EOF {\n            break;\n        }\n        if scanf_ids(&mut sc, &mut luggage_id, &mut flight_id) == EOF {\n            break;\n        }\n        if scanf_airports(&mut sc, &mut departure, &mut arrival) == EOF {\n            break;\n        }\n        if scanf_comments(&mut sc, &mut comments) == EOF {\n            break;\n        }\n\n        arena.nodes.push(RoutingDirective {\n            time_stamp,\n            luggage_id: c_str(&luggage_id),\n            flight_id: c_str(&flight_id),\n            departure: c_str(&departure),\n            arrival: c_str(&arrival),\n            comments: c_str(&comments),\n            next_directive: None,\n        });\n        let new_directive = arena.nodes.len() - 1;\n\n        add_routing_directive_to_list(&mut arena, directive_list_head, new_directive);\n    }\n\n    let stdout = io::stdout();\n    let mut out = io::BufWriter::new(stdout.lock());\n    print_matching_directives(\n        &mut out,\n        &arena,\n        arena.nodes[directive_list_head].next_directive,\n        &arg_bytes(&argv[1]),\n        &arg_bytes(&argv[2]),\n        &arg_bytes(&argv[3]),\n        &arg_bytes(&argv[4]),\n    );\n    let _ = out.flush();\n    std::process::exit(0);\n}\n","numLines":487,"startLine":1,"totalLines":487}}}
