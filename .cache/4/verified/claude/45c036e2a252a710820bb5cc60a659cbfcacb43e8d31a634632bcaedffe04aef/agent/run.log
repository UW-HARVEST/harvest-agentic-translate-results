5\tpub fn set(value: c_int) {\n    26\t    COUNTER.store(value, Ordering::Relaxed);\n    27\t}\n    28\t\n    29\t/// `int increment_counter(int value)` -- `counter += value; return counter;`\n    30\t#[unsafe(no_mangle)]\n    31\tpub extern \"C\" fn increment_counter(value: c_int) -> c_int {\n    32\t    let previous = COUNTER.fetch_add(value, Ordering::Relaxed);\n    33\t    previous.wrapping_add(value)\n    34\t}\n    35\t\n    36\t/// `int decrement_counter(int value)` -- `counter -= value; return counter;`\n    37\t#[unsafe(no_mangle)]\n    38\tpub extern \"C\" fn decrement_counter(value: c_int) -> c_int {\n    39\t    let previous = COUNTER.fetch_sub(value, Ordering::Relaxed);\n    40\t    previous.wrapping_sub(value)\n    41\t}\n    42\t\n    43\t/// `int multiply_counter(int value)` -- `counter *= value; return counter;`\n    44\t#[unsafe(no_mangle)]\n    45\tpub extern \"C\" fn multiply_counter(value: c_int) -> c_int {\n    46\t    let updated = COUNTER.load(Ordering::Relaxed).wrapping_mul(value);\n    47\t    COUNTER.store(updated, Ordering::Relaxed);\n    48\t    updated\n    49\t}\n    50\t\n    51\t/// `int reset_counter(int value)` -- `counter = value; return counter;`\n    52\t#[unsafe(no_mangle)]\n    53\tpub extern \"C\" fn reset_counter(value: c_int) -> c_int {\n    54\t    COUNTER.store(value, Ordering::Relaxed);\n    55\t    value\n    56\t}\n=========== src/helpers.rs ===========\n     1\t// Translation of the string / buffer / validation helpers, plus the function\n     2\t// pointer dispatcher. Every one of these is a non-static function in the C\n     3\t// source and therefore part of the exported ABI.\n     4\t\n     5\tuse core::ffi::{c_char, c_int};\n     6\tuse core::ptr;\n     7\t\n     8\tuse crate::cstd;\n     9\t\n    10\t/// `UINT16_MAX` from <stdint.h>. In C this macro has type `int` (65535 fits in\n    11\t/// an `int`), which is what the `>` comparison below is performed in.\n    12\tpub const UINT16_MAX: c_int = 65535;\n    13\t\n    14\t/// The `operation_func` typedef: `typedef int (*operation_func)(int);`\n    15\t///\n    16\t/// Modelled as `Option<...>` so a null pointer is representable, matching the\n    17\t/// `if (!op)` check in `apply_operation`.\n    18\tpub type OperationFunc = extern \"C\" fn(c_int) -> c_int;\n    19\t\n    20\t/// `int is_string_empty(const char *str)`\n    21\t///\n    22\t/// Returns 1 for a null pointer or an empty string, 0 otherwise.\n    23\t#[unsafe(no_mangle)]\n    24\tpub unsafe extern \"C\" fn is_string_empty(str: *const c_char) -> c_int {\n    25\t    if str.is_null() {\n    26\t        return 1;\n    27\t    }\n    28\t    // `if (*str)` -- non-zero first byte means non-empty.\n    29\t    if unsafe { *str } != 0 {\n    30\t        return 0;\n    31\t    }\n    32\t    1\n    33\t}\n    34\t\n    35\t/// `char *find_char_in_buffer(const char *buffer, size_t size, char target)`\n    36\t///\n    37\t/// Null buffer yields NULL, otherwise this is a straight `memchr`. `memchr`\n    38\t/// compares bytes as `unsigned char`, so `target` is reinterpreted through\n    39\t/// `u8` before being widened to the `int` parameter -- this matters on targets\n    40\t/// where plain `char` is signed and `target` is negative.\n    41\t#[unsafe(no_mangle)]\n    42\tpub unsafe extern \"C\" fn find_char_in_buffer(\n    43\t    buffer: *const c_char,\n    44\t    size: usize,\n    45\t    target: c_char,\n    46\t) -> *mut c_char {\n    47\t    if buffer.is_null() {\n    48\t        return ptr::null_mut();\n    49\t    }\n    50\t    unsafe { cstd::memchr(buffer.cast(), c_int::from(target as u8), size).cast() }\n    51\t}\n    52\t\n    53\t/// `char *create_buffer(const char *initial)`\n    54\t///\n    55\t/// Duplicates `initial` into a fresh `malloc` allocation. The C version does\n    56\t/// not free the allocation on success and leaves a failed `malloc` uncopied but\n    57\t/// still returned (as NULL); both behaviours are preserved. Because the result\n    58\t/// is handed back to the caller -- who frees it with `free` -- the allocation\n    59\t/// must come from the C allocator, not Rust's.\n    60\t#[unsafe(no_mangle)]\n    61\tpub unsafe extern \"C\" fn create_buffer(initial: *const c_char) -> *mut c_char {\n    62\t    if initial.is_null() {\n    63\t        return ptr::null_mut();\n    64\t    }\n    65\t\n    66\t    unsafe {\n    67\t        let len = cstd::strlen(initial);\n    68\t        let buffer = cstd::malloc(len + 1).cast::<c_char>();\n    69\t\n    70\t        if !buffer.is_null() {\n    71\t            cstd::strcpy(buffer, initial);\n    72\t        }\n    73\t\n    74\t        buffer\n    75\t    }\n    76\t}\n    77\t\n    78\t/// `int validate_uint16_range(int value)`\n    79\t///\n    80\t/// 1 when `0 <= value <= UINT16_MAX`, else 0. Check order preserved.\n    81\t#[unsafe(no_mangle)]\n    82\tpub extern \"C\" fn validate_uint16_range(value: c_int) -> c_int {\n    83\t    if value < 0 {\n    84\t        return 0;\n    85\t    }\n    86\t    if value > UINT16_MAX {\n    87\t        return 0;\n    88\t    }\n    89\t    1\n    90\t}\n    91\t\n    92\t/// `int apply_operation(operation_func op, int value)`\n    93\t///\n    94\t/// Returns -1 for a null callback, otherwise the callback's result.\n    95\t#[unsafe(no_mangle)]\n    96\tpub extern \"C\" fn apply_operation(op: Option<OperationFunc>, value: c_int) -> c_int {\n    97\t    match op {\n    98\t        None => -1,\n    99\t        Some(op) => op(value),\n   100\t    }\n   101\t}\n=========== src/charinbuf.rs ===========\n     1\t// Translation of `int charinbuf(int mode, int value, int opt1, int opt2)`, the\n     2\t// single function declared in include/lib.h and the library's demo driver.\n     3\t//\n     4\t// Every `printf` is forwarded to C's `printf` with the original format string\n     5\t// and argument types, so the emitted bytes -- and the interleaving with any\n     6\t// other C-side output -- match exactly.\n     7\t\n     8\tuse core::ffi::{c_char, c_int, c_uint};\n     9\tuse core::ptr;\n    10\t\n    11\tuse crate::counter;\n    12\tuse crate::cstd;\n    13\tuse crate::helpers::{\n    14\t    self, OperationFunc, UINT16_MAX, create_buffer, find_char_in_buffer, is_string_empty,\n    15\t    validate_uint16_range,\n    16\t};\n    17\t\n    18\t#[unsafe(no_mangle)]\n    19\tpub extern \"C\" fn charinbuf(mode: c_int, value: c_int, opt1: c_int, opt2: c_int) -> c_int {\n    20\t    let mut result: c_int = 0;\n    21\t    let mut buffer: *mut c_char = ptr::null_mut();\n    22\t    let found_pos: *mut c_char;\n    23\t    let test_string: *const c_char = c\"\".as_ptr();\n    24\t    let non_empty_string: *const c_char = c\"Hello, World!\".as_ptr();\n    25\t\n    26\t    // `operation_func current_op = NULL;` -- reassigned before every use.\n    27\t    let mut current_op: Option<OperationFunc>;\n    28\t\n    29\t    counter::set(0);\n    30\t\n    31\t    unsafe {\n    32\t        match mode {\n    33\t            0 => {\n    34\t                cstd::printf(c\"Mode 0: UINT16_MAX validation\\n\".as_ptr());\n    35\t                cstd::printf(\n    36\t                    c\"Checking if value %d is within uint16_t range...\\n\".as_ptr(),\n    37\t                    value,\n    38\t                );\n    39\t\n    40\t                if validate_uint16_range(value) != 0 {\n    41\t                    cstd::printf(\n    42\t                        c\"Value %d is valid (0 <= value <= %u)\\n\".as_ptr(),\n    43\t                        value,\n    44\t                        UINT16_MAX as c_uint,\n    45\t                    );\n    46\t                    result = value;\n    47\t                } else {\n    48\t                    cstd::printf(c\"Value %d is out of range for uint16_t\\n\".as_ptr(), value);\n    49\t                    result = -1;\n    50\t                }\n    51\t\n    52\t                cstd::printf(\n    53\t                    c\"UINT16_MAX constant value: %u\\n\".as_ptr(),\n    54\t                    UINT16_MAX as c_uint,\n    55\t                );\n    56\t            }\n    57\t\n    58\t            1 => {\n    59\t                cstd::printf(c\"Mode 1: String empty check by dereference\\n\".as_ptr());\n    60\t\n    61\t                if is_string_empty(test_string) != 0 {\n    62\t                    cstd::printf(c\"Test string is empty (checked with *string)\\n\".as_ptr());\n    63\t                    result = 0;\n    64\t                } else {\n    65\t                    cstd::printf(c\"Test string is not empty\\n\".as_ptr());\n    66\t                    result = 1;\n    67\t                }\n    68\t\n    69\t                if is_string_empty(non_empty_string) != 0 {\n    70\t                    cstd::printf(c\"Non-empty string check failed!\\n\".as_ptr());\n    71\t                } else {\n    72\t                    cstd::printf(c\"Non-empty string correctly identified\\n\".as_ptr());\n    73\t                    result += 10;\n    74\t                }\n    75\t            }\n    76\t\n    77\t            2 => {\n    78\t                cstd::printf(c\"Mode 2: Dynamic memory allocation and free\\n\".as_ptr());\n    79\t\n    80\t                buffer = create_buffer(c\"Testing malloc and free\".as_ptr());\n    81\t\n    82\t                if !buffer.is_null() {\n    83\t                    cstd::printf(c\"Buffer allocated: '%s'\\n\".as_ptr(), buffer);\n    84\t                    cstd::printf(c\"Buffer length: %zu\\n\".as_ptr(), cstd::strlen(buffer));\n    85\t                    result = cstd::strlen(buffer) as c_int;\n    86\t\n    87\t                    cstd::free(buffer.cast());\n    88\t                    cstd::printf(c\"Buffer freed successfully\\n\".as_ptr());\n    89\t                    buffer = ptr::null_mut();\n    90\t                } else {\n    91\t                    cstd::printf(c\"Failed to allocate buffer\\n\".as_ptr());\n    92\t                    result = -1;\n    93\t                }\n    94\t            }\n    95\t\n    96\t            3 => {\n    97\t                cstd::printf(c\"Mode 3: Function pointers with static counter\\n\".as_ptr());\n    98\t\n    99\t                current_op = Some(counter::reset_counter);\n   100\t                result = helpers::apply_operation(current_op, value);\n   101\t                cstd::printf(c\"Counter reset to: %d\\n\".as_ptr(), result);\n   102\t\n   103\t                current_op = Some(counter::increment_counter);\n   104\t                result = helpers::apply_operation(current_op, opt1);\n   105\t                cstd::printf(\n   106\t                    c\"Counter after increment by %d: %d\\n\".as_ptr(),\n   107\t                    opt1,\n   108\t                    result,\n   109\t                );\n   110\t\n   111\t                current_op = Some(counter::multiply_counter);\n   112\t                result = helpers::apply_operation(current_op, opt2);\n   113\t                cstd::printf(\n   114\t                    c\"Counter after multiply by %d: %d\\n\".as_ptr(),\n   115\t                    opt2,\n   116\t                    result,\n   117\t                );\n   118\t\n   119\t                current_op = Some(counter::decrement_counter);\n   120\t                result = helpers::apply_operation(current_op, 5);\n   121\t                cstd::printf(c\"Counter after decrement by 5: %d\\n\".as_ptr(), result);\n   122\t\n   123\t                cstd::printf(c\"Final static counter value: %d\\n\".as_ptr(), counter::get());\n   124\t            }\n   125\t\n   126\t            4 => {\n   127\t                cstd::printf(c\"Mode 4: Using memchr to find character\\n\".as_ptr());\n   128\t\n   129\t                buffer = create_buffer(c\"Search for character X in this buffer\".as_ptr());\n   130\t\n   131\t                if !buffer.is_null() {\n   132\t                    let buf_size = cstd::strlen(buffer);\n   133\t                    let search_char: c_char = b'