filter)(base, replacement) };\n    let r_null = rr.is_null();\n    let (rv, ru) = if r_null {\n        (Vec::new(), 0)\n    } else {\n        let v = unsafe { read_cstr(rr) };\n        let u = unsafe { libc::malloc_usable_size(rr as *mut libc::c_void) };\n        unsafe { libc::free(rr as *mut libc::c_void) };\n        (v, u)\n    };\n\n    assert_eq!(\n        c_null, r_null,\n        \"w_utf8_filter NULL-ness mismatch (replacement={replacement:#x}): C_null={c_null} Rust_null={r_null}\\n  input = [{}]\",\n        hex(buf)\n    );\n    assert_eq!(\n        cv.len(),\n        rv.len(),\n        \"w_utf8_filter output length mismatch (replacement={replacement:#x}): C={} Rust={}\\n  input   = [{}]\\n  C out   = [{}]\\n  Rust out= [{}]\",\n        cv.len(),\n        rv.len(),\n        hex(buf),\n        hex(&cv),\n        hex(&rv)\n    );\n    assert_eq!(\n        cv,\n        rv,\n        \"w_utf8_filter output mismatch (replacement={replacement:#x})\\n  input   = [{}]\\n  C out   = [{}]\\n  Rust out= [{}]\",\n        hex(buf),\n        hex(&cv),\n        hex(&rv)\n    );\n\n    assert_eq!(\n        cu,\n        ru,\n        \"w_utf8_filter allocation-size mismatch (replacement={replacement:#x}): \\\n         malloc_usable_size C={cu} Rust={ru} -- the internal `size` / `repl` \\\n         accounting diverges\\n  input = [{}]\\n  out   = [{}]\",\n        hex(buf),\n        hex(&cv)\n    );\n\n    FilterOutcome {\n        null: c_null,\n        bytes: cv,\n        usable: cu,\n    }\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"07e979d6-63d7-48dc-ac71-77490c70e46a","uuid":"22678b86-6b57-47ca-8149-6185e35af962","timestamp":"2026-08-20T17:24:41.219Z","tool_use_result":{"stdout":"253:pub struct FilterOutcome {\n272:pub fn cmp_filter(buf: &[u8], replacement: u32) -> FilterOutcome {\n339:    FilterOutcome {\n---\n    oc\n}\n\npub struct FilterOutcome {\n    pub null: bool,\n    pub bytes: Vec<u8>,\n    /// `malloc_usable_size()` of the returned buffer.\n    