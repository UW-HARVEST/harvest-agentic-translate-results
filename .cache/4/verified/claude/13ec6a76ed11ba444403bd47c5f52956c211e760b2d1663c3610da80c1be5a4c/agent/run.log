t/// The set of generators, addressed by index, so tests can sweep data characters.\n263\tpub const N_SHAPES: usize = 6;\n264\t\n265\tpub fn gen_shape(rng: &mut Rng, shape: usize, len: usize) -> Vec<u8> {\n266\t    match shape % N_SHAPES {\n267\t        0 => gen_random(rng, len),\n268\t        1 => gen_constant(len, rng.byte()),\n269\t        2 => {\n270\t            let period = rng.range(1, 40);\n271\t            gen_periodic(rng, len, period)\n272\t        }\n273\t        3 => gen_text(rng, len),\n274\t        4 => gen_mixed(rng, len),\n275\t        _ => gen_selfref(rng, len),\n276\t    }\n277\t}\n278\t\n279\tpub fn shape_name(shape: usize) -> &'static str {\n280\t    match shape % N_SHAPES {\n281\t        0 => \"random\",\n282\t        1 => \"constant\",\n283\t        2 => \"periodic\",\n284\t        3 => \"text\",\n285\t        4 => \"mixed\",\n286\t        _ => \"selfref\",\n287\t    }\n288\t}\n289\t\n290\t// ---------------------------------------------------------------------------\n291\t// Aligned scratch buffers\n292\t//\n293\t// `LZ4_initStream` / `LZ4_initStreamHC` reject insufficiently aligned buffers\n294\t// (returning NULL), and the `*_extState` entry points require a properly\n295\t// aligned state block, so tests need controllable alignment.\n296\t// ---------------------------------------------------------------------------\n297\t\n298\t/// A heap buffer with a guaranteed alignment, plus an optional byte offset so a\n299\t/// test can deliberately produce a MISALIGNED pointer.\n300\tpub struct AlignedBuf {\n301\t    ptr: *mut u8,\n302\t    layout: std::alloc::Layout,\n303\t    offset: usize,\n304\t    len: usize,\n305\t}\n306\t\n307\timpl AlignedBuf {\n308\t    /// Allocate `len` usable bytes at `align`-byte alignment, zero-filled.\n309\t    pub fn new(len: usize, align: usize) -> Self {\n310\t        Self::with_offset(len, align, 0)\n311\t    }\n312\t\n313\t    /// Allocate so that `as_mut_ptr()` is `align`-aligned **plus** `offset`\n314\t    ///