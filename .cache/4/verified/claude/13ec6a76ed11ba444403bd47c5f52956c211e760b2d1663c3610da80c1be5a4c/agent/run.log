================== */\n342\t\n343\tpub const LZ4F_OK_NoError: c_int = 0;\n344\tpub const LZ4F_ERROR_GENERIC: c_int = 1;\n345\tpub const LZ4F_ERROR_maxBlockSize_invalid: c_int = 2;\n346\tpub const LZ4F_ERROR_blockMode_invalid: c_int = 3;\n347\tpub const LZ4F_ERROR_parameter_invalid: c_int = 4;\n348\tpub const LZ4F_ERROR_compressionLevel_invalid: c_int = 5;\n349\tpub const LZ4F_ERROR_headerVersion_wrong: c_int = 6;\n350\tpub const LZ4F_ERROR_blockChecksum_invalid: c_int = 7;\n351\tpub const LZ4F_ERROR_reservedFlag_set: c_int = 8;\n352\tpub const LZ4F_ERROR_allocation_failed: c_int = 9;\n353\tpub const LZ4F_ERROR_srcSize_tooLarge: c_int = 10;\n354\tpub const LZ4F_ERROR_dstMaxSize_tooSmall: c_int = 11;\n355\tpub const LZ4F_ERROR_frameHeader_incomplete: c_int = 12;\n356\tpub const LZ4F_ERROR_frameType_unknown: c_int = 13;\n357\tpub const LZ4F_ERROR_frameSize_wrong: c_int = 14;\n358\tpub const LZ4F_ERROR_srcPtr_wrong: c_int = 15;\n359\tpub const LZ4F_ERROR_decompressionFailed: c_int = 16;\n360\tpub const LZ4F_ERROR_headerChecksum_invalid: c_int = 17;\n361\tpub const LZ4F_ERROR_contentChecksum_invalid: c_int = 18;\n362\tpub const LZ4F_ERROR_frameDecoding_alreadyStarted: c_int = 19;\n363\tpub const LZ4F_ERROR_compressionState_uninitialized: c_int = 20;\n364\tpub const LZ4F_ERROR_parameter_null: c_int = 21;\n365\tpub const LZ4F_ERROR_io_write: c_int = 22;\n366\tpub const LZ4F_ERROR_io_read: c_int = 23;\n367\tpub const LZ4F_ERROR_maxCode: c_int = 24;\n368\t\n369\tstatic LZ4F_errorStrings: [&[u8]; 25] = [\n370\t    b\"OK_NoError\\0\",\n371\t    b\"ERROR_GENERIC\\0\",\n372\t    b\"ERROR_maxBlockSize_invalid\\0\",\n373\t    b\"ERROR_blockMode_invalid\\0\",\n374\t    b\"ERROR_parameter_invalid\\0\",\n375\t    b\"ERROR_compressionLevel_invalid\\0\",\n376\t    b\"ERROR_headerVersion_wrong\\0\",\n377\t    b\"ERROR_blockChecksum_invalid\\0\",\n378\t    b\"ERROR_reservedFlag_set\\0\",\n379\t    b\"ERROR_allocation_failed\\0\",\n380\t    b\"ERROR_srcSize_tooLarge\\0\",\n381\t    b\"ERROR_dstMaxSize_tooSmall\\0\",\n382\t    b\"ERROR_frameHeader_incomplete\\0\",\n383\t    b\"ERROR_frameType_unknown\\0\",\n384\t    b\"ERROR_frameSize_wrong\\0\",\n385\t    b\"ERROR_srcPtr_wrong\\0\",\n386\t    b\"ERROR_decompressionFailed\\0\",\n387\t    b\"ERROR_headerChecksum_invalid\\0\",\n388\t    b\"ERROR_contentChecksum_invalid\\0\",\n389\t    b\"ERROR_frameDecoding_alreadyStarted\\0\",\n390\t    b\"ERROR_compressionState_uninitialized\\0\",\n391\t    b\"ERROR_parameter_null\\0\",\n392\t    b\"ERROR_io_write\\0\",\n393\t    b\"ERROR_io_read\\0\",\n394\t    b\"ERROR_maxCode\\0\",\n395\t];\n396\t\n397\tstatic codeError: &[u8] = b\"Unspecified error code\\0\";\n398\t\n399\t#[inline(always)]\n400\tpub fn lz4f_isError(code: LZ4F_errorCode_t) -> bool {\n401\t    code > (0usize).wrapping_sub(LZ4F_ERROR_maxCode as usize)\n402\t}\n403\t\n404\t#[unsafe(no_mangle)]\n405\tpub unsafe extern \"C\" fn LZ4F_isError(code: LZ4F_errorCode_t) -> u32 {\n406\t    lz4f_isError(code) as u32\n407\t}\n408\t\n409\t#[unsafe(no_mangle)]\n410\tpub unsafe extern \"C\" fn LZ4F_getErrorName(code: LZ4F_errorCode_t) -> *const c_char {\n411\t    if lz4f_isError(code) {\n412\t        let idx = (0i64).wrapping_sub(code as i64) as usize;\n413\t        return LZ4F_errorStrings[idx].as_ptr() as *const c_char;\n414\t    }\n415\t    codeError.as_ptr() as *const c_char\n416\t}\n417\t\n418\t#[unsafe(no_mangle)]\n419\tpub unsafe extern \"C\" fn LZ4F_getErrorCode(functionResult: usize) -> c_int {\n420\t    if !lz4f_isError(functionResult) {\n421\t        return LZ4F_OK_NoError;\n422\t    }\n423\t    (0isize).wrapping_sub(functionResult as isize) as c_int\n424\t}\n425\t\n426\t#[inline(always)]\n427\tfn LZ4F_returnErrorCode(code: c_int) -> LZ4F_errorCode_t {\n428\t    (0isize).wrapping_sub(code as isize) as usize\n429\t}\n430\t\n431\t#[unsafe(no_mangle)]\n432\tpub unsafe extern \"C\" fn LZ4F_getVersion() -> u32 {\n433\t    LZ4F_VERSION\n434\t}\n435\t\n436\t#[unsafe(no_mangle)]\n437\tpub unsafe extern \"C\" fn LZ4F_compressionLevel_max() -> c_int {\n438\t    LZ4HC_CLEVEL_MAX\n439\t}\n440\t\n441\t#[unsafe(no_mangle)]\n442\tpub unsafe extern \"C\" fn LZ4F_getBlockSize(mut blockSizeID: c_int) -> usize {\n443\t    static blockSizes: [usize; 4] = [64 * 1024, 256 * 1024, 1024 * 1024, 4 * 1024 * 1024];\n444\t\n445\t    if blockSizeID == 0 {\n446\t        blockSizeID = LZ4F_BLOCKSIZEID_DEFAULT;\n447\t    }\n448\t    if blockSizeID < LZ4F_max64KB || blockSizeID > LZ4F_max4MB {\n449\t        return LZ4F_returnErrorCode(LZ4F_ERROR_maxBlockSize_invalid);\n450\t    }\n451\t    let blockSizeIdx = (blockSizeID - LZ4F_max64KB) as usize;\n452\t    blockSizes[blockSizeIdx]\n453\t}\n454\t\n455\t/* ================================================================ *\n456\t *  Private functions\n457\t * ================================================================ */\n458\t\n459\t#[inline(always)]\n460\tfn MIN_usize(a: usize, b: usize) -> usize {"}]},"parent_tool_use_id":"toolu_bdrk_01KBd4WdpnxbaghnJyS6gKhH","session_id":"5bf83431-1376-4c81-bcb4-7fd267eb113b","uuid":"887e7949-ecf4-41ae-be97-d99696c09a7a","timestamp":"2026-08-23T08:17:58.977Z","subagent_type":"general-purpose","task_description":"Write lz4frame compression tests"}
