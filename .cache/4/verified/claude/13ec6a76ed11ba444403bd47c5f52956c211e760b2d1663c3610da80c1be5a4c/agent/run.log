  LZ4_read64(p)\n216\t}\n217\t#[inline(always)]\n218\tpub unsafe fn LZ4_writeLE16(p: *mut u8, v: u16) {\n219\t    LZ4_write16(p, v)\n220\t}\n221\t\n222\t/// A single 8-byte \"load then store\", exactly like `__builtin_memcpy(d,s,8)`.\n223\t#[inline(always)]\n224\tpub unsafe fn copy8(d: *mut u8, s: *const u8) {\n225\t    let v = ptr::read_unaligned(s as *const [u8; 8]);\n226\t    ptr::write_unaligned(d as *mut [u8; 8], v);\n227\t}\n228\t\n229\t/// A single 16-byte \"load then store\", exactly like `__builtin_memcpy(d,s,16)`.\n230\t#[inline(always)]\n231\tpub unsafe fn copy16(d: *mut u8, s: *const u8) {\n232\t    let v = ptr::read_unaligned(s as *const [u8; 16]);\n233\t    ptr::write_unaligned(d as *mut [u8; 16], v);\n234\t}\n235\t\n236\t#[inline(always)]\n237\tpub unsafe fn copy4(d: *mut u8, s: *const u8) {\n238\t    let v = ptr::read_unaligned(s as *const [u8; 4]);\n239\t    ptr::write_unaligned(d as *mut [u8; 4], v);\n240\t}\n241\t\n242\t#[inline(always)]\n243\tpub unsafe fn copy2(d: *mut u8, s: *const u8) {\n244\t    let v = ptr::read_unaligned(s as *const [u8; 2]);\n245\t    ptr::write_unaligned(d as *mut [u8; 2], v);\n246\t}\n247\t\n248\t/// customized variant of memcpy, which can overwrite up to 8 bytes beyond dstEnd\n249\t#[inline(always)]\n250\tpub unsafe fn LZ4_wildCopy8(dstPtr: *mut u8, srcPtr: *const u8, dstEnd: *mut u8) {\n251\t    let mut d = dstPtr;\n252\t    let mut s = srcPtr;\n253\t    loop {\n254\t        copy8(d, s);\n255\t        d = d.wrapping_add(8);\n256\t        s = s.wrapping_add(8);\n257\t        if !(d < dstEnd) {\n258\t            break;\n259\t        }\n260\t    }\n261\t}\n262\t\n263\t/// customized variant of memcpy, which can overwrite up to 32 bytes beyond dstEnd\n264\t#[inline(always)]\n265\tpub unsafe fn LZ4_wildCopy32(dstPtr: *mut u8, srcPtr: *const u8, dstEnd: *mut u8) {\n266\t    let mut d = dstPtr;\n267\t    let mut s = srcPtr;\n268\t    loop {\n269\t        copy16(d, s);\n270\t        copy16(d.wrapping_add(16), s.wrapping_add(16));\n271\t        d = d.wrapping_add(32);\n272\t        s = s.wrapping_add(32);\n273\t        if !(d < dstEnd) {\n274\t            break;\n275\t        }\n276\t    }\n277\t}\n278\t\n279\tpub static inc32table: [u32; 8] = [0, 1, 2, 1, 0, 4, 4, 4];\n280\tpub static dec64table: [i32; 8] = [0, 0, 0, -1, -4, 1, 2, 3];\n281\t\n282\t#[inline(always)]\n283\tpub unsafe fn LZ4_memcpy_using_offset_base(\n284\t    dstPtr: *mut u8,\n285\t    srcPtr: *const u8,\n286\t    dstEnd: *mut u8,\n287\t    offset: usize,\n288\t) {\n289\t    let mut dstPtr = dstPtr;\n290\t    let mut srcPtr = srcPtr;\n291\t    if offset < 8 {\n292\t        LZ4_write32(dstPtr, 0); /* silence an msan warning when offset==0 */\n293\t        *dstPtr.wrapping_add(0) = *srcPtr.wrapping_add(0);\n294\t        *dstPtr.wrapping_add(1) = *srcPtr.wrapping_add(1);\n295\t        *dstPtr.wrapping_add(2) = *srcPtr.wrapping_add(2);\n296\t        *dstPtr.wrapping_add(3) = *srcPtr.wrapping_add(3);\n297\t        srcPtr = srcPtr.wrapping_add(inc32table[offset] as usize);\n298\t        copy4(dstPtr.wrapping_add(4), srcPtr);\n299\t        srcPtr = srcPtr.wrapping_offset(-(dec64table[offset] as isize));\n300\t        dstPtr = dstPtr.wrapping_add(8);\n301\t    } else {\n302\t        copy8(dstPtr, srcPtr);\n303\t        dstPtr = dstPtr.wrapping_add(8);\n304\t        srcPtr = srcPtr.wrapping_add(8);\n305\t    }\n306\t    LZ4_wildCopy8(dstPtr, srcPtr, dstEnd);\n307\t}\n308\t\n309\t/// LZ4_memcpy_using_offset() presumes :\n310\t/// - dstEnd >= dstPtr + MINMATCH\n311\t/// - there is at least 12 bytes available to write after dstEnd\n312\t#[inline(always)]\n313\tpub unsafe fn LZ4_memcpy_using_offset(\n314\t    dstPtr: *mut u8,\n315\t    srcPtr: *const u8,\n316\t    dstEnd: *mut u8,\n317\t    offset: usize,\n318\t) {\n319\t    let mut v: [u8; 8] = [0; 8];\n320\t    let mut dstPtr = dstPtr;\n321\t\n322\t    match offset {\n323\t        1 => {\n324\t            MEM_INIT(v.as_mut_ptr(), *srcPtr as i32, 8);\n325\t        }\n326\t        2 =>