   for &(id, want) in &[\n        (0i32, 64 * 1024usize),\n        (4, 64 * 1024),\n        (5, 256 * 1024),\n        (6, 1024 * 1024),\n        (7, 4 * 1024 * 1024),\n    ] {\n        let (cv, rv) = unsafe { (c(id), r(id)) };\n        expect_ok(&format!(\"LZ4F_getBlockSize({})\", id), cv, rv);\n        assert_eq!(cv, want, \"LZ4F_getBlockSize({}) value\", id);\n    }\n}\n\n// ===========================================================================\n// Row 170 — LZ4F_compressFrame{,_usingCDict}: dstCapacity < frame bound\n// ===========================================================================\n\n/// ERRORS.md row 170: `dstCapacity < LZ4F_compressFrameBound(srcSize, &prefs)`\n/// (lz4frame.c:456) => `dstMaxSize_tooSmall`. Smallest reproduction named by the\n/// row is `srcSize == 0, dstCapacity == 0`.\n#[test]\nfn row_170_compress_frame_dst_too_small() {\n    let (cf, rf) = both::<FnCompressFrame>(\"LZ4F_compressFrame\");\n    let (ccd, rcd) = both::<FnCompressFrameCDict>(\"LZ4F_compressFrame_usingCDict\");\n    let (cfb, rfb) = both::<FnFrameBound>(\"LZ4F_compressFrameBound\");\n    let (cc, rc) = both::<FnCreateCctx>(\"LZ4F_createCctxOrFail_placeholder_unused\")\n        .clone_if_never_used();\n    let _ = (cc, rc);\n    unreachable!()\n}\n\n// The placeholder above is never built — see `row_170_compress_frame_dst_too_small_impl`.\ntrait NeverUsed {\n    fn clone_if_never_used(self) -> Self;\n}\nimpl<T> NeverUsed for T {\n    fn clone_if_never_used(self) -> Self {\n        self\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6490,"cache_read_input_tokens":179207,"cache_creation":{"ephemeral_5m_input_tokens":6490,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_01MKYk4UMDTn1UfVtVFpWvXe","session_id":"5bf83431-1376-4c81-bcb4-7fd267eb113b","uuid":"b3277f4d-fb3f-49f6-8b71-2a746a2e00c0","tim