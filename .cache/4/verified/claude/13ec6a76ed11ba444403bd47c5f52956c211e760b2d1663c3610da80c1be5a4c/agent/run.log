4096,\n            );\n            idx += 1;\n        }\n    }\n}\n\n#[test]\nfn compress_frame_block_boundaries_large_ids() {"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1448,"cache_read_input_tokens":202037,"cache_creation":{"ephemeral_5m_input_tokens":1448,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_01BFVP8uBwDpE2vBQE9jRXjX","session_id":"5bf83431-1376-4c81-bcb4-7fd267eb113b","uuid":"073f6170-7cbd-4e71-928b-e60b0ac81fac","timestamp":"2026-08-23T08:47:41.521Z","subagent_type":"general-purpose","task_description":"lz4frame one-shot + metadata tests"}
