={} cc={} bc={} csz={} shape={} len={} srcChunk={}\",\n                        bmode,\n                        cc,\n                        bc,\n                        csz,\n                        shape_name(shape),\n                        len,\n                        chunk\n                    );\n                    roundtrip(\n                        &spec,\n                        &data,\n                        &DecodeCfg::new(SrcPlan::Fixed(chunk), DstPlan::All),\n                        &label,\n                    );\n                }\n            }\n        }\n    }\n}''',\n'''                for &chunk in &[1usize, 2, 3, 4, 5, 6, 7, 8, 11, 16, 64, 1000] {\n                    let label = format!(\n                        \"chunkgran bsid={} bmode={} cc={} bc={} csz={} shape={} len={} srcChunk={}\",\n                        bsid,\n                        bmode,\n                        cc,\n                        bc,\n                        csz,\n                        shape_name(shape),\n                        len,\n                        chunk\n                    );\n                    roundtrip(\n                        &spec,\n                        &data,\n                        &DecodeCfg::new(SrcPlan::Fixed(chunk), DstPlan::All),\n                        &label,\n                    );\n                    roundtrip(\n                        &spec,\n                        &data,\n                        &DecodeCfg::new(SrcPlan::Fixed(chunk), DstPlan::Fixed(chunk)),\n                        &format!(\"{} [dst=src]\", label),\n                    );\n                }\n              }\n            }\n        }\n    }\n}''',\n 'gran-close')\n\n# ---- 9. cross product: bigger lengths and more granularities --------------\nrep('''        for &len in &[0usize, 1, 5, 130, 1500] {''',\n    '''        for &len in &[0usize, 1, 2, 5, 13, 130, 1500, 4000, 20_000] {''',\n    'cross-lens')\nrep('''                for &sc in &[1usize, 3, 5, 17, 1000, usize::MAX] {\n                    for &dc in &[1usize, 3, 17, 1000, usize::MAX] {''',\n    '''                for &sc in &[1usize, 2, 3, 4, 5, 17, 1000, usize::MAX] {\n                    for &dc in &[1usize, 2, 3, 4, 17, 1000, 70_000, usize::MAX] {\n                        if (sc < 6 || dc < 6) && len > 4000 {\n                            continue; // byte-at-a-time on 20 KB x 64 rows is wasteful\n                        }''',\n    'cross-granularities')\n\n# ---- 10. random chunking: many more iterations ----------------------------\nrep('    for iter in 0..150u64 {', '    for iter in 0..2500u64 {', 'randchunk-iters')\n\n# ---- 11. options: add more call patterns ---------------------------------\nrep('''                                for &(sp, dp) in &[\n                                    (SrcPlan::OneShot, DstPlan::All),\n                                    (SrcPlan::Fixed(3), DstPlan::Fixed(29)),\n                                    (SrcPlan::Fixed(700), DstPlan::Fixed(4096)),\n                                ] {''',\n    '''                                for &(sp, dp) in &[\n                                    (SrcPlan::OneShot, DstPlan::All),\n                                    (SrcPlan::Fixed(1), DstPlan::Fixed(1)),\n                                    (SrcPlan::Fixed(3), DstPlan::Fixed(29)),\n                                    (SrcPlan::Fixed(700), DstPlan::Fixed(4096)),\n                                    (SrcPlan::Hint, DstPlan::Fixed(333)),\n                                ] {\n                                    if len > 5000 && matches!(sp, SrcPlan::Fixed(1)) {\n                                        continue;\n                                    }''',\n    'opts-plans')\n\n# ---- 14. dict: restore the full cc x bc sweep ---------------------------\nrep('''                    let cc = (shape % 2) as c_int;\n                    let bc = ((shape / 2) % 2) as c_int;\n                    let prefs = prefs_of(''',\n    '''                  for &cc in &[0, 1] {\n                  for &bc in &[0, 1] {\n                    let prefs = prefs_of(''',\n    'dict-ccbc-open')\nrep('''                    let mut cfg = DecodeCfg::new(SrcPlan::Fixed(64), DstPlan::Fixed(1024));\n                    cfg.dict = Some(dict);\n                    cfg.opts = Some(dopts(0, 1));\n                    roundtrip(&spec, &data, &cfg, &format!(\"{} [skipChecksums]\", label));\n                }''',\n    '''                    let mut cfg = DecodeCfg::new(SrcPlan::Fixed(64), DstPlan::Fixed(1024));\n                    cfg.dict = Some(dict);\n                    cfg.opts = Some(dopts(0, 1));\n                    roundtrip(&spec, &data, &cfg, &format!(\"{} [skipChecksums]\", label));\n                  }\n                  }\n                }''',\n    'dict-ccbc-close')\n\n# ---- 15. uncompressed blocks: more sizes -------------------------------\nrep('''        for &len in &[0usize, 1, 4, 3000, 70_000] {\n            let data = gen_shape(&mut rng, shape, len);\n            for &bc in &[LZ4F_noBlockChecksum, LZ4F_blockChecksumEnabled] {''',\n    '''        for &len in &[0usize, 1, 2, 3, 4, 5, 999, 1000, 1001, 3000, 70_000] {\n            let data = gen_shape(&mut rng, shape, len);\n            for &bc in &[LZ4F_noBlockChecksum, LZ4F_blockChecksumEnabled] {''',\n    'uncomp-lens')\n\n# ---- 19. error paths: much more fuzzing --------------------------------\nrep('    for iter in 0..800u32 {', '    for iter in 0..12_000u32 {', 'fuzz-iters')\n\nopen(p,'w').write(s)\nPYEOF\ntimeout 600 cargo test --release --offline --test lz4frame_decompress_diff --no-run 2>&1 | tail -20"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7042,"cache_read_input_tokens":317804,"cache_creation":{"ephemeral_5m_input_tokens":7042,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_016UzAKZwKyMNJCsJYRtsyw8","ses