add((*state).memsize as usize),\n589\t            input,\n590\t            32 - (*state).memsize as usize,\n591\t        );\n592\t        let base = (*state).mem64.as_ptr() as *const u8;\n593\t        (*state).v1 = XXH64_round((*state).v1, XXH_readLE64(base));\n594\t        (*state).v2 = XXH64_round((*state).v2, XXH_readLE64(base.wrapping_add(8)));\n595\t        (*state).v3 = XXH64_round((*state).v3, XXH_readLE64(base.wrapping_add(16)));\n596\t        (*state).v4 = XXH64_round((*state).v4, XXH_readLE64(base.wrapping_add(24)));\n597\t        p = p.wrapping_add(32 - (*state).memsize as usize);\n598\t        (*state).memsize = 0;\n599\t    }\n600\t\n601\t    if p.wrapping_add(32) <= bEnd {\n602\t        let limit = bEnd.wrapping_sub(32);\n603\t        let mut v1 = (*state).v1;\n604\t        let mut v2 = (*state).v2;\n605\t        let mut v3 = (*state).v3;\n606\t        let mut v4 = (*state).v4;\n607\t\n608\t        loop {\n609\t            v1 = XXH64_round(v1, XXH_readLE64(p));\n610\t            p = p.wrapping_add(8);\n611\t            v2 = XXH64_round(v2, XXH_readLE64(p));\n612\t            p = p.wrapping_add(8);\n613\t            v3 = XXH64_round(v3, XXH_readLE64(p));\n614\t            p = p.wrapping_add(8);\n615\t            v4 = XXH64_round(v4, XXH_readLE64(p));\n616\t            p = p.wrapping_add(8);\n617\t            if !(p <= limit) {\n618\t                break;\n619\t            }\n620\t        }\n621\t\n622\t        (*state).v1 = v1;\n623\t        (*state).v2 = v2;\n624\t        (*state).v3 = v3;\n625\t        (*state).v4 = v4;\n626\t    }\n627\t\n628\t    if p < bEnd {\n629\t        memcpy(\n630\t            (*state).mem64.as_mut_ptr() as *mut u8,\n631\t            p,\n632\t            (bEnd as usize).wrapping_sub(p as usize),\n633\t        );\n634\t        (*state).memsize = (bEnd as usize).wrapping_sub(p as usize) as u32;\n635\t    }\n636\t\n637\t    XXH_OK\n638\t}\n639\t\n640\t#[unsafe(no_mangle)]\n641\tpub unsafe extern \"C\" fn LZ4_XXH64_digest(state: *const XXH64_state_t) -> u64 {\n642\t    let mut h64: u64;\n643\t\n644\t    if (*state).total_len >= 32 {\n645\t        let v1 = (*state).v1;\n646\t        let v2 = (*state).v2;\n647\t        let v3 = (*state).v3;\n648\t        let v4 = (*state).v4;\n649\t\n650\t        h64 = v1\n651\t            .rotate_left(1)\n652\t            .wrapping_add(v2.rotate_left(7))\n653\t            .wrapping_add(v3.rotate_left(12))\n654\t            .wrapping_add(v4.rotate_left(18));\n655\t        h64 = XXH64_mergeRound(h64, v1);\n656\t        h64 = XXH64_mergeRound(h64, v2);\n657\t        h64 = XXH64_mergeRound(h64, v3);\n658\t        h64 = XXH64_mergeRound(h64, v4);\n659\t    } else {\n660\t        h64 = (*state).v3.wrapping_add(PRIME64_5);\n661\t    }\n662\t\n663\t    h64 = h64.wrapping_add((*state).total_len);\n664\t\n665\t    XXH64_finalize(\n666\t        h64,\n667\t        (*state).mem64.as_ptr() as *const u8,\n668\t        (*state).total_len as usize,\n669\t    )\n670\t}\n671\t\n672\t#[unsafe(no_mangle)]\n673\tpub unsafe extern \"C\" fn LZ4_XXH64_canonicalFromHash(dst: *mut XXH64_canonical_t, hash: u64) {\n674\t    let h = hash.swap_bytes();\n675\t    memcpy(dst as *mut u8, &h as *const u64 as *const u8, 8);\n676\t}\n677\t\n678\t#[unsafe(no_mangle)]\n679\tpub unsafe extern \"C\" fn LZ4_XXH64_hashFromCanonical(src: *const XXH64_canonical_t) -> u64 {\n680\t    XXH_readBE64(src as *const u8)\n681\t}\n682\t\n683\t/* silence unused import warnings */\n684\t#[allow(dead_code)]\n685\tunsafe fn _unused(n: usize) -> *mut u8 {\n686\t    calloc(1, n)\n687\t}\n688\t"}]},"parent_tool_use_id":"toolu_bdrk_01HhghTocUcLcToJsT8dsA6c","session_id":"5bf83431-1376-4c81-bcb4-7fd267eb113b","uuid":"1264383c-6a91-4d21-be3f-3fb4a65f4cf2","timestamp":"2026-08-23T08:12:49.511Z","subagent_type":"general-purpose","task_description":"Write xxhash differential tests"}
