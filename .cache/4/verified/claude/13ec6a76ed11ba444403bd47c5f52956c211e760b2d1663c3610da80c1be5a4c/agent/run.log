{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_013Sa14ehuaz61WZZ1qVTNNx","type":"tool_result","content":"1\t//! Shared differential-test harness.\n2\t//!\n3\t//! Loads BOTH the C `.so` and the Rust `.so` via `libloading` and exposes their\n4\t//! exported symbols as raw `extern \"C\"` function pointers. Rust functions are\n5\t//! NEVER called directly — every call goes through the `.so` export table, so the\n6\t//! `#[no_mangle]` wrappers are exercised exactly as an external C caller would.\n7\t\n8\t#![allow(dead_code)]\n9\t#![allow(non_snake_case)]\n10\t#![allow(non_camel_case_types)]\n11\t#![allow(non_upper_case_globals)]\n12\t\n13\tuse libloading::Library;\n14\tuse std::os::raw::{c_char, c_int, c_uint, c_void};\n15\tuse std::sync::OnceLock;\n16\t\n17\t// ---------------------------------------------------------------------------\n18\t// Library loading\n19\t// ---------------------------------------------------------------------------\n20\t\n21\tpub struct Lib {\n22\t    lib: Library,\n23\t    pub tag: &'static str,\n24\t}\n25\t\n26\timpl Lib {\n27\t    /// Extract an exported symbol as a copyable value (function pointer).\n28\t    ///\n29\t    /// The returned value outlives the borrow because `Lib` is stored in a\n30\t    /// process-lifetime `OnceLock` and therefore never unloaded.\n31\t    pub fn sym<T: Copy>(&self, name: &str) -> T {\n32\t        unsafe {\n33\t            let s = self\n34\t                .lib\n35\t                .get::<T>(name.as_bytes())\n36\t                .unwrap_or_else(|e| panic!(\"{}: missing symbol `{}`: {}\", self.tag, name, e));\n37\t            *s\n38\t        }\n39\t    }\n40\t\n41\t    /// Returns `true` if the symbol is exported at all.\n42\t    pub fn has(&self, name: &str) -> bool {\n43\t        unsafe { self.lib.get::<*const c_void>(name.as_bytes()).is_ok() }\n44\t    }\n45\t}\n46\t\n47\tpub struct Pair {\n48\t    pub c: Lib,\n49\t    pub rust: Lib,\n50\t}\n51\t\n52\tfn crate_root() -> &'static str {\n53\t    env!(\"CARGO_MANIFEST_DIR\")\n54\t}\n55\t\n56\tfn rust_so_path() -> String {\n57\t    let profile = if cfg!(debug_assertions) { \"debug\" } else { \"release\" };\n58\t    format!(\"{}/target/{}/liblz4.so\", crate_root(), profile)\n59\t}\n60\t\n61\tfn c_so_path() -> String {\n62\t    format!(\"{}/c_src/build/liblz4.so\", crate_root())\n63\t}\n64\t\n65\tstatic LIBS: OnceLock<Pair> = OnceLock::new();\n66\t\n67\t/// The loaded pair of shared libraries (loaded once per test process).\n68\tpub fn libs() -> &'static Pair {\n69\t    LIBS.get_or_init(|| {\n70\t        let cp = c_so_path();\n71\t        let rp = rust_so_path();\n72\t        let c = unsafe { Library::new(&cp) }\n73\t            .unwrap_or_else(|e| panic!(\"cannot load C .so at {}: {}\\nDid you run cmake --build c_src/build ?\", cp, e));\n74\t        let rust = unsafe { Library::new(&rp) }\n75\t            .unwrap_or_else(|e| panic!(\"cannot load Rust .so at {}: {}\", rp, e));\n76\t        Pair {\n77\t            c: Lib { lib: c, tag: \"C\" },\n78\t            rust: Lib { lib: rust, tag: \"Rust\" },\n79\t        }\n80\t    })\n81\t}\n82\t\n83\t/// Fetch the same symbol from both libraries, returning `(c_fn, rust_fn)`.\n84\tpub fn both<T: Copy>(name: &str) -> (T, T) {\n85\t    let l = libs();\n86\t    (l.c.sym::<T>(name), l.rust.sym::<T>(name))\n87\t}\n88\t\n89\t// ---------------------------------------------------------------------------\n90\t// Deterministic PRNG (xoshiro256**) — no external crate, fully reproducible\n91\t// ---------------------------------------------------------------------------\n92\t\n93\tpub struct Rng {\n94\t    s: [u64; 4],\n95\t}\n96\t\n97\timpl Rng {\n98\t    pub fn new(seed: u64) -> Self {\n99\t        // SplitMix64 seeding\n100\t        let mut z = seed;\n101\t        let mut s = [0u64; 4];\n102\t        for slot in s.iter_mut() {\n103\t            z = z.wrapping_add(0x9E37_79B9_7F4A_7C15);\n104\t            let mut x = z;\n105\t            x = (x ^ (x >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);\n106\t            x = (x ^ (x >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);\n107\t            *slot = x ^ (x >> 31);\n108\t        }\n109\t        Rng { s }\n110\t    }\n111\t\n112\t    pub fn next_u64(&mut self) -> u64 {\n113\t        let result = self.s[1].wrapping_mul(5).rotate_left(7).wrapping_mul(9);\n114\t        let t = self.s[1] << 17;\n115\t        self.s[2] ^= self.s[0];\n116\t        self.s[3] ^= self.s[1];\n117\t        self.s[1] ^= self.s[2];\n118\t        self.s[0] ^= self.s[3];\n119\t        self.s[2] ^= t;\n120\t        self.s[3] = self.s[3].rotate_left(45);\n121\t        result\n122\t    }\n123\t\n124\t    pub fn next_u32(&mut self) -> u32 {\n125\t        (self.next_u64() >> 32) as u32\n126\t    }\n127\t\n128\t    pub fn byte(&mut self) -> u8 {\n129\t        (self.next_u64() >> 56) as u8\n130\t    }\n131\t\n132\t    /// Uniform in `[0, n)`. Returns 0 when `n == 0`.\n133\t    pub fn below(&mut self, n: usize) -> usize {\n134\t        if n == 0 {\n135\t            0\n136\t        } else {\n137\t            (self.next_u64() % (n as u64)) as usize\n138\t        }\n139\t    }\n140\t\n141\t    /// Uniform in `[lo, hi]` inclusive.\n142\t    pub fn range(&mut self, lo: usize, hi: usize) -> usize {\n143\t        if hi <= lo {\n144\t            lo\n145\t        } else {\n146\t            lo + self.below(hi - lo + 1)\n147\t        }\n148\t    }\n149\t\n150\t    pub fn bool(&mut self) -> bool {\n151\t        self.next_u64() & 1 == 1\n152\t    }\n153\t}\n154\t\n155\t// ---------------------------------------------------------------------------\n156\t// Input-shape generators\n157\t//\n158\t// These deliberately span the data characters the LZ4 encoder branches on:\n159\t// incompressible (long literal runs -> literal-length extension bytes),\n160\t// highly repetitive (long matches -> match-length extension bytes),\n161\t// and mixtures / structured text.\n162\t// ---------------------------------------------------------------------------\n163\t\n164\t/// Fully random bytes: incompressible, forces literal runs > 15 and hence the\n165\t/// literal-length 255-extension loop.\n166\tpub fn gen_random(rng: &mut Rng, len: usize) -> Vec<u8> {\n167\t    (0..len).map(|_| rng.byte()).collect()\n168\t}\n169\t\n170\t/// A single repeated byte: maximally compressible, forces very long matches and\n171\t/// hence multiple 0xFF match-length extension bytes.\n172\tpub fn gen_constant(len: usize, b: u8) -> Vec<u8> {\n173\t    vec![b; len]\n174\t}\n175\t\n176\t/// Repeating pattern of `period` bytes: long matches at a fixed small offset.\n177\tpub fn gen_periodic(rng: &mut Rng, len: usize, period: usize) -> Vec<u8> {\n178\t    let period = period.max(1);\n179\t    let base: Vec<u8> = (0..period).map(|_| rng.byte()).collect();\n180\t    (0..len).map(|i| base[i % period]).collect()\n181\t}\n182\t\n183\t/// Text-like data from a small alphabet with repeated words: realistic mix of\n184\t/// short and medium matches.\n185\tpub fn gen_text(rng: &mut Rng, len: usize) -> Vec<u8> {\n186\t    const WORDS: &[&[u8]] = &[\n187\t        b\"the \", b\"quick \", b\"brown \", b\"fox \", b\"jumps \", b\"over \", b\"lazy \", b\"dog \",\n188\t        b\"lz4 \", b\"compression \", b\"block \", b\"frame \", b\"checksum \", b\"dictionary \",\n189\t    ];\n190\t    let mut out = Vec::with_capacity(len + 16);\n191\t    while out.len() < len {\n192\t        out.extend_from_slice(WORDS[rng.below(WORDS.len())]);\n193\t    }\n194\t    out.truncate(len);\n195\t    out\n196\t}\n197\t\n198\t/// Random data interleaved with long runs: alternates the literal-extension and\n199\t/// match-extension paths within a single input.\n200\tpub fn gen_mixed(rng: &mut Rng, len: usize) -> Vec<u8> {\n201\t    let mut out = Vec::with_capacity(len + 512);\n202\t    while out.len() < len {\n203\t        if rng.bool() {\n204\t            let n = rng.range(1, 300);\n205\t            let b = rng.byte();\n206\t            out.extend(std::iter::repeat(b).take(n));\n207\t        } else {\n208\t            let n = rng.range(1, 64);\n209\t            for _ in 0..n {\n210\t                out.push(rng.byte());\n211\t            }\n212\t        }\n213\t    }\n214\t    out.truncate(len);\n215\t    out\n216\t}\n217\t\n218\t/// Data built by copying earlier windows of itself at controlled distances,\n219\t/// including distances near the 65535 maximum LZ4 offset.\n220\tpub fn gen_selfref(rng: &mut Rng, len: usize) -> Vec<u8> {\n221\t    let mut out: Vec<u8> = Vec::with_capacity(len + 256);\n222\t    // seed with some random bytes\n223\t    let seed_len = rng.range(16, 128).min(len.max(1));\n224\t    for _ in 0..seed_len {\n225\t        out.push(rng.byte());\n226\t    }\n227\t    while out.len() < len {\n228\t        let choice = rng.below(4);\n229\t        match choice {\n230\t            0 => {\n231\t                // literal noise\n232\t                let n = rng.range(1, 40);\n233\t                for _ in 0..n {\n234\t                    out.push(rng.byte());\n235\t                }\n236\t            }\n237\t            _ => {\n238\t                // copy from a previous window; bias distances toward 65535\n239\t                let maxdist = out.len().min(65535);\n240\t                let dist = match rng.below(3) {\n241\t                    0 => maxdist,\n242\t                    1 => rng.range(1, maxdist.max(1)),\n243\t                    _ => rng.range(1, maxdist.min(4096).max(1)),\n244\t                }\n245\t                .max(1);\n246\t                let n = rng.range(4, 600);\n247\t                let start = out.len() - dist;\n248\t                for k in 0..n {\n249\t                    let b = out[start + (k % dist)];\n250\t                    out.push(b);\n251\t                    if out.len() >= len + 600 {\n252\t                        break;\n253\t                    }\n254\t                }\n255\t            }\n256\t        }\n257\t    }\n258\t    out.truncate(len);\n259\t    out\n260\t}\n261\t\n262\t/// The set of generators, addressed by index, so tests can sweep data characters.\n263\tpub const N_SHAPES: usize = 6;\n264\t\n265\tpub fn gen_shape(rng: &mut Rng, shape: usize, len: usize) -> Vec<u8> {\n266\t    match shape % N_SHAPES {\n267\t        0 => gen_random(rng, len),\n268\t        1 => gen_constant(len, rng.byte()),\n269\t        2 => {\n270\t            let period = rng.range(1, 40);\n271\t            gen_periodic(rng, len, period)\n272\t        }\n273\t        3 => gen_text(rng, len),\n274\t        4 => gen_mixed(rng, len),\n275\t        _ => gen_selfref(rng, len),\n276\t    }\n277\t}\n278\t\n279\tpub fn shape_name(shape: usize) -> &'static str {\n280\t    match shape % N_SHAPES {\n281\t        0 => \"random\",\n282\t        1 => \"constant\",\n283\t        2 => \"periodic\",\n284\t        3 => \"text\",\n285\t        4 => \"mixed\",\n286\t        _ => \"selfref\",\n287\t    }\n288\t}\n289\t\n290\t// ---------------------------------------------------------------------------\n291\t// Aligned scratch buffers\n292\t//\n293\t// `LZ4_initStream` / `LZ4_initStreamHC` reject insufficiently aligned buffers\n294\t// (returning NULL), and the `*_extState` entry points require a properly\n295\t// aligned state block, so tests need controllable alignment.\n296\t// ---------------------------------------------------------------------------\n297\t\n298\t/// A heap buffer with a guaranteed alignment, plus an optional byte offset so a\n299\t/// test can deliberately produce a MISALIGNED pointer.\n300\tpub struct AlignedBuf {\n301\t    ptr: *mut u8,\n302\t    layout: std::alloc::Layout,\n303\t    offset: usize,\n304\t    len: usize,\n305\t}\n306\t\n307\timpl AlignedBuf {\n308\t    /// Allocate `len` usable bytes at `align`-byte alignment, zero-filled.\n309\t    pub fn new(len: usize, align: usize) -> Self {\n310\t        Self::with_offset(len, align, 0)\n311\t    }\n312\t\n313\t    /// Allocate so that `as_mut_ptr()` is `align`-aligned **plus** `offset`\n314\t    /// bytes — i.e. deliberately misaligned when `offset != 0`.\n315\t    pub fn with_offset(len: usize, align: usize, offset: usize) -> Self {\n316\t        let total = len + offset + align;\n317\t        let layout = std::alloc::Layout::from_size_align(total, align).unwrap();\n318\t        let ptr = unsafe { std::alloc::alloc_zeroed(layout) };\n319\t        assert!(!ptr.is_null(), \"allocation of {} bytes failed\", total);\n320\t        AlignedBuf { ptr, layout, offset, len }\n321\t    }\n322\t\n323\t    pub fn as_mut_ptr(&mut self) -> *mut u8 {\n324\t        unsafe { self.ptr.add(self.offset) }\n325\t    }\n326\t\n327\t    pub fn as_ptr(&self) -> *const u8 {\n328\t        unsafe { self.ptr.add(self.offset) }\n329\t    }\n330\t\n331\t    pub fn len(&self) -> usize {\n332\t        self.len\n333\t    }\n334\t\n335\t    pub fn as_slice(&self) -> &[u8] {\n336\t        unsafe { std::slice::from_raw_parts(self.as_ptr(), self.len) }\n337\t    }\n338\t\n339\t    pub fn zero(&mut self) {\n340\t        unsafe { std::ptr::write_bytes(self.ptr, 0, self.layout.size()) }\n341\t    }\n342\t}\n343\t\n344\timpl Drop for AlignedBuf {\n345\t    fn drop(&mut self) {\n346\t        unsafe { std::alloc::dealloc(self.ptr, self.layout) }\n347\t    }\n348\t}\n349\t\n350\t// ---------------------------------------------------------------------------\n351\t// Assertion helpers\n352\t// ---------------------------------------------------------------------------\n353\t\n354\tpub fn hexdump(b: &[u8], max: usize) -> String {\n355\t    let n = b.len().min(max);\n356\t    let mut s = String::new();\n357\t    for (i, x) in b[..n].iter().enumerate() {\n358\t        if i % 32 == 0 && i != 0 {\n359\t            s.push('\\n');\n360\t        }\n361\t        s.push_str(&format!(\"{:02x}\", x));\n362\t    }\n363\t    if b.len() > n {\n364\t        s.push_str(&format!(\" ...(+{} more)\", b.len() - n));\n365\t    }\n366\t    s\n367\t}\n368\t\n369\t/// Compare two byte slices and produce a precise diff message on mismatch.\n370\tpub fn assert_bytes_eq(ctx: &str, c: &[u8], r: &[u8]) {\n371\t    if c == r {\n372\t        return;\n373\t    }\n374\t    if c.len() != r.len() {\n375\t        panic!(\n376\t            \"{}\\n  length mismatch: C={} Rust={}\\n  C   : {}\\n  Rust: {}\",\n377\t            ctx,\n378\t            c.len(),\n379\t            r.len(),\n380\t            hexdump(c, 128),\n381\t            hexdump(r, 128)\n382\t        );\n383\t    }\n384\t    let idx = c.iter().zip(r.iter()).position(|(a, b)| a != b).unwrap();\n385\t    let lo = idx.saturating_sub(16);\n386\t    let hi = (idx + 16).min(c.len());\n387\t    panic!(\n388\t        \"{}\\n  first byte difference at offset {} (len {}): C=0x{:02x} Rust=0x{:02x}\\n  C   [{}..{}]: {}\\n  Rust[{}..{}]: {}\",\n389\t        ctx, idx, c.len(), c[idx], r[idx], lo, hi, hexdump(&c[lo..hi], 64), lo, hi, hexdump(&r[lo..hi], 64)\n390\t    );\n391\t}\n392\t\n393\t// ---------------------------------------------------------------------------\n394\t// FFI types mirroring the C headers\n395\t// ---------------------------------------------------------------------------\n396\t\n397\t#[repr(C)]\n398\t#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n399\tpub struct LZ4F_frameInfo_t {\n400\t    pub blockSizeID: c_int,\n401\t    pub blockMode: c_int,\n402\t    pub contentChecksumFlag: c_int,\n403\t    pub frameType: c_int,\n404\t    pub contentSize: u64,\n405\t    pub dictID: c_uint,\n406\t    pub blockChecksumFlag: c_int,\n407\t}\n408\t\n409\timpl Default for LZ4F_frameInfo_t {\n410\t    /// Mirrors `LZ4F_INIT_FRAMEINFO`.\n411\t    fn default() -> Self {\n412\t        LZ4F_frameInfo_t {\n413\t            blockSizeID: LZ4F_max64KB,\n414\t            blockMode: LZ4F_blockLinked,\n415\t            contentChecksumFlag: LZ4F_noContentChecksum,\n416\t            frameType: LZ4F_frame,\n417\t            contentSize: 0,\n418\t            dictID: 0,\n419\t            blockChecksumFlag: LZ4F_noBlockChecksum,\n420\t        }\n421\t    }\n422\t}\n423\t\n424\t#[repr(C)]\n425\t#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n426\tpub struct LZ4F_preferences_t {\n427\t    pub frameInfo: LZ4F_frameInfo_t,\n428\t    pub compressionLevel: c_int,\n429\t    pub autoFlush: c_uint,\n430\t    pub favorDecSpeed: c_uint,\n431\t    pub reserved: [c_uint; 3],\n432\t}\n433\t\n434\timpl Default for LZ4F_preferences_t {\n435\t    /// Mirrors `LZ4F_INIT_PREFERENCES`.\n436\t    fn default() -> Self {\n437\t        LZ4F_preferences_t {\n438\t            frameInfo: LZ4F_frameInfo_t::default(),\n439\t            compressionLevel: 0,\n440\t            autoFlush: 0,\n441\t            favorDecSpeed: 0,\n442\t            reserved: [0; 3],\n443\t        }\n444\t    }\n445\t}\n446\t\n447\t#[repr(C)]\n448\t#[derive(Clone, Copy, Debug, Default)]\n449\tpub struct LZ4F_compressOptions_t {\n450\t    pub stableSrc: c_uint,\n451\t    pub reserved: [c_uint; 3],\n452\t}\n453\t\n454\t#[repr(C)]\n455\t#[derive(Clone, Copy, Debug, Default)]\n456\tpub struct LZ4F_decompressOptions_t {\n457\t    pub stableDst: c_uint,\n458\t    pub skipChecksums: c_uint,\n459\t    pub reserved1: c_uint,\n460\t    pub reserved0: c_uint,\n461\t}\n462\t\n463\t#[repr(C)]\n464\t#[derive(Clone, Copy)]\n465\tpub struct LZ4F_CustomMem {\n466\t    pub customAlloc: Option<extern \"C\" fn(*mut c_void, usize) -> *mut c_void>,\n467\t    pub customCalloc: Option<extern \"C\" fn(*mut c_void, usize) -> *mut c_void>,\n468\t    pub customFree: Option<extern \"C\" fn(*mut c_void, *mut c_void)>,\n469\t    pub opaqueState: *mut c_void,\n470\t}\n471\t\n472\timpl Default for LZ4F_CustomMem {\n473\t    /// Mirrors `LZ4F_defaultCMem` — all NULL, defers to stdlib.\n474\t    fn default() -> Self {\n475\t        LZ4F_CustomMem {\n476\t            customAlloc: None,\n477\t            customCalloc: None,\n478\t            customFree: None,\n479\t            opaqueState: std::ptr::null_mut(),\n480\t        }\n481\t    }\n482\t}\n483\t\n484\t// ---------------------------------------------------------------------------\n485\t// Constants from the C headers\n486\t// ---------------------------------------------------------------------------\n487\t\n488\t// lz4.h\n489\tpub const LZ4_MAX_INPUT_SIZE: usize = 0x7E00_0000;\n490\tpub const LZ4_ACCELERATION_MAX: c_int = 65537;\n491\tpub const LZ4_ACCELERATION_DEFAULT: c_int = 1;\n492\tpub const LZ4_MEMORY_USAGE: usize = 14;\n493\t/// `static const int LZ4_64Klimit = ((64 KB) + (MFLIMIT-1));` (lz4.c:710).\n494\t/// Inputs `< LZ4_64Klimit` select `tableType == byU16`, `>=` selects `byU32`.\n495\tpub const LZ4_64Klimit: usize = 65536 + (MFLIMIT - 1); // 65547\n496\tpub const MFLIMIT: usize = 12;\n497\tpub const LASTLITERALS: usize = 5;\n498\tpub const MINMATCH: usize = 4;\n499\tpub const LZ4_DISTANCE_MAX: usize = 65535;\n500\t\n501\t// lz4hc.h\n502\tpub const LZ4HC_CLEVEL_MIN: c_int = 2;\n503\tpub const LZ4HC_CLEVEL_DEFAULT: c_int = 9;\n504\tpub const LZ4HC_CLEVEL_OPT_MIN: c_int = 10;\n505\tpub const LZ4HC_CLEVEL_MAX: c_int = 12;\n506\tpub const LZ4HC_DICTIONARY_LOGSIZE: usize = 16;\n507\tpub const LZ4HC_MAXD: usize = 1 << LZ4HC_DICTIONARY_LOGSIZE;\n508\t\n509\t// lz4frame.h — blockSizeID\n510\tpub const LZ4F_default: c_int = 0;\n511\tpub const LZ4F_max64KB: c_int = 4;\n512\tpub const LZ4F_max256KB: c_int = 5;\n513\tpub const LZ4F_max1MB: c_int = 6;\n514\tpub const LZ4F_max4MB: c_int = 7;\n515\t\n516\t// blockMode\n517\tpub const LZ4F_blockLinked: c_int = 0;\n518\tpub const LZ4F_blockIndependent: c_int = 1;\n519\t\n520\t// contentChecksum\n521\tpub const LZ4F_noContentChecksum: c_int = 0;\n522\tpub const LZ4F_contentChecksumEnabled: c_int = 1;\n523\t\n524\t// blockChecksum\n525\tpub const LZ4F_noBlockChecksum: c_int = 0;\n526\tpub const LZ4F_blockChecksumEnabled: c_int = 1;\n527\t\n528\t// frameType\n529\tpub const LZ4F_frame: c_int = 0;\n530\tpub const LZ4F_skippableFrame: c_int = 1;\n531\t\n532\tpub const LZ4F_VERSION: c_uint = 100;\n533\tpub const LZ4F_HEADER_SIZE_MIN: usize = 7;\n534\tpub const LZ4F_HEADER_SIZE_MAX: usize = 19;\n535\tpub const LZ4F_BLOCK_HEADER_SIZE: usize = 4;\n536\tpub const LZ4F_BLOCK_CHECKSUM_SIZE: usize = 4;\n537\tpub const LZ4F_CONTENT_CHECKSUM_SIZE: usize = 4;\n538\tpub const LZ4F_MAGICNUMBER: u32 = 0x184D2204;\n539\tpub const LZ4F_MAGIC_SKIPPABLE_START: u32 = 0x184D2A50;\n540\t\n541\t/// `LZ4F_errorCodes` — numeric values follow the `LZ4F_LIST_ERRORS` macro order.\n542\tpub mod err {\n543\t    pub const OK_NoError: i32 = 0;\n544\t    pub const ERROR_GENERIC: i32 = 1;\n545\t    pub const ERROR_maxBlockSize_invalid: i32 = 2;\n546\t    pub const ERROR_blockMode_invalid: i32 = 3;\n547\t    pub const ERROR_parameter_invalid: i32 = 4;\n548\t    pub const ERROR_compressionLevel_invalid: i32 = 5;\n549\t    pub const ERROR_headerVersion_wrong: i32 = 6;\n550\t    pub const ERROR_blockChecksum_invalid: i32 = 7;\n551\t    pub const ERROR_reservedFlag_set: i32 = 8;\n552\t    pub const ERROR_allocation_failed: i32 = 9;\n553\t    pub const ERROR_srcSize_tooLarge: i32 = 10;\n554\t    pub const ERROR_dstMaxSize_tooSmall: i32 = 11;\n555\t    pub const ERROR_frameHeader_incomplete: i32 = 12;\n556\t    pub const ERROR_frameType_unknown: i32 = 13;\n557\t    pub const ERROR_frameSize_wrong: i32 = 14;\n558\t    pub const ERROR_srcPtr_wrong: i32 = 15;\n559\t    pub const ERROR_decompressionFailed: i32 = 16;\n560\t    pub const ERROR_headerChecksum_invalid: i32 = 17;\n561\t    pub const ERROR_contentChecksum_invalid: i32 = 18;\n562\t    pub const ERROR_frameDecoding_alreadyStarted: i32 = 19;\n563\t    pub const ERROR_compressionState_uninitialized: i32 = 20;\n564\t    pub const ERROR_parameter_null: i32 = 21;\n565\t    pub const ERROR_io_write: i32 = 22;\n566\t    pub const ERROR_io_read: i32 = 23;\n567\t    pub const ERROR_maxCode: i32 = 24;\n568\t}\n569\t\n570\t// xxhash.h\n571\tpub const XXH_OK: c_int = 0;\n572\tpub const XXH_ERROR: c_int = 1;\n573\t\n574\t#[repr(C)]\n575\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n576\tpub struct XXH32_canonical_t {\n577\t    pub digest: [u8; 4],\n578\t}\n579\t\n580\t#[repr(C)]\n581\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n582\tpub struct XXH64_canonical_t {\n583\t    pub digest: [u8; 8],\n584\t}\n585\t\n586\t// ---------------------------------------------------------------------------\n587\t// Commonly used function-pointer type aliases\n588\t// ---------------------------------------------------------------------------\n589\t\n590\tpub type FnCompressDefault =\n591\t    unsafe extern \"C\" fn(*const c_char, *mut c_char, c_int, c_int) -> c_int;\n592\tpub type FnCompressFast =\n593\t    unsafe extern \"C\" fn(*const c_char, *mut c_char, c_int, c_int, c_int) -> c_int;\n594\tpub type FnDecompressSafe =\n595\t    unsafe extern \"C\" fn(*const c_char, *mut c_char, c_int, c_int) -> c_int;\n596\tpub type FnCompressBound = unsafe extern \"C\" fn(c_int) -> c_int;\n597\t\n598\t/// Returns `true` when a `size_t`-returning LZ4F function signalled an error,\n599\t/// replicating `LZ4F_isError()`.\n600\tpub fn lz4f_is_error(code: usize) -> bool {\n601\t    // LZ4F_isError: (code > (LZ4F_errorCode_t)(-LZ4F_ERROR_maxCode))\n602\t    code > (0usize.wrapping_sub(err::ERROR_maxCode as usize))\n603\t}\n604\t\n605\t/// Decode a `size_t` LZ4F return value into its `LZ4F_errorCodes` number,\n606\t/// replicating `LZ4F_getErrorCode()`. Returns 0 (`OK_NoError`) for successes.\n607\tpub fn lz4f_error_code(code: usize) -> i32 {\n608\t    if !lz4f_is_error(code) {\n609\t        0\n610\t    } else {\n611\t        (0usize.wrapping_sub(code)) as i32\n612\t    }\n613\t}\n614\t"}]},"parent_tool_use_id":"toolu_bdrk_01Qh5LpfswRHc3cj7snaSEFQ","session_id":"5bf83431-1376-4c81-bcb4-7fd267eb113b","uuid":"6c604323-29fa-46b5-92c9-2fa2df370ba6","timestamp":"2026-08-23T09:11:38.269Z","subagent_type":"general-purpose","task_description":"Phase C row tests for lz4hc + xxhash"}
