{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_r2qm734pxs6udastvjtymfxh5yptpgcbnerqnnuvmusvrlrcurha","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01ETyj9oASwSqPicMutN5iPu","name":"Edit","input":{"replace_all":false,"file_path":"/local/home/scheschb/.harvest/work/harvest-work-ieCE1Y/translated_rust/tests/lz4frame_oneshot_diff.rs","old_string":"/// Full \"good path\" case: compute the bound (asserting parity), compress with\n/// dstCapacity == bound and with dstCapacity == bound + slack, and (optionally)\n/// round-trip the C-produced frame through both libraries' decompressors.\nfn frame_good(label: &str, p: &P, src: &[u8], do_round_trip: bool) {\n    let prefs = p.to_prefs(src.len());\n    let bound = frame_bound(src.len(), &prefs as *const LZ4F_preferences_t);\n    assert!(\n        !lz4f_is_error(bound) && bound < 64 << 20,\n        \"{}: unexpected bound {} for {}\",\n        label,\n        bound,\n        p\n    );\n\n    let ctx = format!(\"{} [{}] srcSize={} cap=bound({})\", label, p, src.len(), bound);\n    let (n, buf) = frame_case(&ctx, &prefs, src, bound);\n    assert!(!lz4f_is_error(n), \"{}: compressFrame failed: {}\", ctx, err_str(n));\n\n    // A larger destination must produce exactly the same bytes and length.\n    let ctx2 = format!(\"{} [{}] srcSize={} cap=bound+37\", label, p, src.len());\n    let (n2, buf2) = frame_case(&ctx2, &prefs, src, bound + 37);\n    assert_eq!(n, n2, \"{}: length changed with a larger dst\", ctx2);\n    assert_bytes_eq(&format!(\"{} (vs exact-bound output)\", ctx2), &buf[..n], &buf2[..n2]);\n\n    if do_round_trip {\n        round_trip_both(&ctx, &buf[..n], src);\n    }\n}","new_string":"/// Full \"good path\" case: compute the bound (asserting parity), compress with\n/// dstCapacity == bound and (optionally) with dstCapacity == bound + slack, and\n/// (optionally) round-trip the C-produced frame through both decompressors.\nfn frame_good_opts(label: &str, p: &P, src: &[u8], do_round_trip: bool, also_larger_dst: bool) {\n    let prefs = p.to_prefs(src.len());\n    let bound = frame_bound(src.len(), &prefs as *const LZ4F_preferences_t);\n    assert!(\n        !lz4f_is_error(bound) && bound < 64 << 20,\n        \"{}: unexpected bound {} for {}\",\n        label,\n        bound,\n        p\n    );\n\n    let ctx = format!(\"{} [{}] srcSize={} cap=bound({})\", label, p, src.len(), bound);\n    let (n, buf) = frame_case(&ctx, &prefs, src, bound);\n    assert!(!lz4f_is_error(n), \"{}: compressFrame failed: {}\", ctx, err_str(n));\n\n    if also_larger_dst {\n        // A larger destination must produce exactly the same bytes and length.\n        let ctx2 = format!(\"{} [{}] srcSize={} cap=bound+37\", label, p, src.len());\n        let (n2, buf2) = frame_case(&ctx2, &prefs, src, bound + 37);\n        assert_eq!(n, n2, \"{}: length changed with a larger dst\", ctx2);\n        assert_bytes_eq(&format!(\"{} (vs exact-bound output)\", ctx2), &buf[..n], &buf2[..n2]);\n    }\n\n    if do_round_trip {\n        round_trip_both(&ctx, &buf[..n], src);\n    }\n}\n\nfn frame_good(label: &str, p: &P, src: &[u8], do_round_trip: bool) {\n    frame_good_opts(label, p, src, do_round_trip, true)\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1236,"cache_read_input_tokens":192707,"cache_creation":{"ephemeral_5m_input_tokens":1236,"ephemeral_1h_input_tokens":0},"output_tokens":9,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_01BFVP8uBwDpE2vBQE9jRXjX","session_id":"5bf83431-1376-4c81-bcb4-7fd267eb113b","uuid":"53734721-7472-487f-943b-2dc43078f4e3","timestamp":"2026-08-23T08:46:20.081Z","subagent_type":"general-purpose","task_description":"lz4frame one-shot + metadata tests"}
