_void,\n            &mut rdst,\n            bad.as_ptr() as *const c_void,\n            &mut rs,\n            std::ptr::null(),\n        );\n        assert_eq!(ret_str(cret), ret_str(rret), \"SELFCHECK hint\");\n        assert_eq!(cdst, rdst, \"SELFCHECK dstSize\");\n        assert_bytes_eq(\"SELFCHECK dst bytes\", &oc, &orr);\n        panic!(\"SELFCHECK never reached: divergence was NOT detected\");\n    }\n}\nEOF\ntimeout 600 cargo test --release --offline --test lz4frame_decompress_diff --no-run 2>&1 | tail -10"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3784,"cache_read_input_tokens":324846,"cache_creation":{"ephemeral_5m_input_tokens":3784,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_016UzAKZwKyMNJCsJYRtsyw8","session_id":"5bf83431-1376-4c81-bcb4-7fd267eb113b","uuid":"7e573c78-338c-400e-a9df-4e1f2875e38b","timestamp":"2026-08-23T08:48:25.786Z","subagent_type":"general-purpose","task_description":"Write lz4frame decompression tests"}
