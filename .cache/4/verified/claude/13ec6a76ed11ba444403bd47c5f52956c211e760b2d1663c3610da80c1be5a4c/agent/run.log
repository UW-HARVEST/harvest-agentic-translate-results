.wrapping_mul(PRIME64_1).wrapping_add(PRIME64_4);\n416\t    acc\n417\t}\n418\t\n419\t#[inline(always)]\n420\tfn XXH64_avalanche(mut h64: u64) -> u64 {\n421\t    h64 ^= h64 >> 33;\n422\t    h64 = h64.wrapping_mul(PRIME64_2);\n423\t    h64 ^= h64 >> 29;\n424\t    h64 = h64.wrapping_mul(PRIME64_3);\n425\t    h64 ^= h64 >> 32;\n426\t    h64\n427\t}\n428\t\n429\tunsafe fn XXH64_finalize(mut h64: u64, ptr_in: *const u8, len: usize) -> u64 {\n430\t    let mut p = ptr_in;\n431\t    let n = len & 31;\n432\t    let n8 = n / 8;\n433\t    let rem = n % 8;\n434\t    let n4 = rem / 4;\n435\t    let n1 = rem % 4;\n436\t\n437\t    for _ in 0..n8 {\n438\t        /* PROCESS8_64 */\n439\t        let k1 = XXH64_round(0, XXH_readLE64(p));\n440\t        p = p.wrapping_add(8);\n441\t        h64 ^= k1;\n442\t        h64 = h64\n443\t            .rotate_left(27)\n444\t            .wrapping_mul(PRIME64_1)\n445\t            .wrapping_add(PRIME64_4);\n446\t    }\n447\t    for _ in 0..n4 {\n448\t        /* PROCESS4_64 */\n449\t        h64 ^= (XXH_readLE32(p) as u64).wrapping_mul(PRIME64_1);\n450\t        p = p.wrapping_add(4);\n451\t        h64 = h64\n452\t            .rotate_left(23)\n453\t            .wrapping_mul(PRIME64_2)\n454\t            .wrapping_add(PRIME64_3);\n455\t    }\n456\t    for _ in 0..n1 {\n457\t        /* PROCESS1_64 */\n458\t        h64 ^= (*p as u64).wrapping_mul(PRIME64_5);\n459\t        p = p.wrapping_add(1);\n460\t        h64 = h64.rotate_left(11).wrapping_mul(PRIME64_1);\n461\t    }\n462\t    XXH64_avalanche(h64)\n463\t}\n464\t\n465\tunsafe fn XXH64_endian_align(input: *const u8, len: usize, seed: u64) -> u64 {\n466\t    let mut p = input;\n467\t    let bEnd = p.wrapping_add(len);\n468\t    let mut h64: u64;\n469\t\n470\t    if len >= 32 {\n471\t        let limit = bEnd.wrapping_sub(32);\n472\t        let mut v1 = seed.wrapping_add(PRIME64_1).wrapping_add(PRIME64_2);\n473\t        let mut v2 = seed.wrapping_add(PRIME64_2);\n474\t        let mut v3 = seed.wrapping_add(0)