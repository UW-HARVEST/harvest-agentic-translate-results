redSize) {\n            /* not enough space allocated */\n            LZ4F_free(cctx->lz4CtxPtr, cctx->cmem);\n            if (cctx->prefs.compressionLevel < LZ4HC_CLEVEL_MIN) {\n                /* must take ownership of memory allocation,\n                 * in order to respect custom allocator contract */\n                cctx->lz4CtxPtr = LZ4F_malloc(sizeof(LZ4_stream_t), cctx->cmem);\n                if (cctx->lz4CtxPtr)\n                    LZ4_initStream(cctx->lz4CtxPtr, sizeof(LZ4_stream_t));\n            } else {\n                cctx->lz4CtxPtr = LZ4F_malloc(sizeof(LZ4_streamHC_t), cctx->cmem);\n                if (cctx->lz4CtxPtr)\n                    LZ4_initStreamHC(cctx->lz4CtxPtr, sizeof(LZ4_streamHC_t));\n            }\n            RETURN_ERROR_IF(cctx->lz4CtxPtr == NULL, allocation_failed);\n            cctx->lz4CtxAlloc = ctxTypeID;\n            cctx->lz4CtxType = ctxTypeID;\n        } else if (cctx->lz4CtxType != ctxTypeID) {\n            /* otherwise, a sufficient buffer is already allocated,\n             * but we need to reset it to the correct context type */\n            if (cctx->prefs.compressionLevel < LZ4HC_CLEVEL_MIN) {\n                LZ4_initStream((LZ4_stream_t*)cctx->lz4CtxPtr, sizeof(LZ4_stream_t));\n            } else {\n                LZ4_initStreamHC((LZ4_streamHC_t*)cctx->lz4CtxPtr, sizeof(LZ4_streamHC_t));\n                LZ4_setCompressionLevel((LZ4_streamHC_t*)cctx->lz4CtxPtr, cctx->prefs.compressionLevel);\n            }\n            cctx->lz4CtxType = ctxTypeID;\n    }   }\n\n    /* Buffer Management */\n    if (cctx->prefs.frameInfo.blockSizeID == 0)\n        cctx->prefs.frameInfo.blockSizeID = LZ4F_BLOCKSIZEID_DEFAULT;\n    cctx->maxBlockSize = LZ4F_getBlockSize(cctx->prefs.frameInfo.blockSizeID);\n\n    {   size_t const requiredBuffSize = preferencesPtr->autoFlush ?\n                ((cctx->prefs.frameInfo.blockMode == LZ4F_blockLinked) ? 64 KB : 0) :  /* only needs past data up to window size */\n                cctx->maxBlockSize + ((cctx->prefs.frameInfo.blockMode == LZ4F_blockLinked) ? 128 KB : 0);\n\n        if (cctx->maxBufferSize < requiredBuffSize) {\n            cctx->maxBufferSize = 0;\n            LZ4F_free(cctx->tmpBuff, cctx->cmem);\n            cctx->tmpBuff = (BYTE*)LZ4F_malloc(requiredBuffSize, cctx->cmem);\n            RETURN_ERROR_IF(cctx->tmpBuff == NULL, allocation_failed);\n            cctx->maxBufferSize = requiredBuffSize;\n    }   }\n    cctx->tmpIn = cctx->tmpBuff;\n    cctx->tmpInSize = 0;\n    (void)XXH32_reset(&(cctx->xxh), 0);\n\n    /* context init */\n    cctx->cdict = cdict;\n    if (cctx->prefs.frameInfo.blockMode == LZ4F_blockLinked) {\n        /* frame init only for blockLinked : blockIndependent will be init at each block */\n        LZ4F_initStream(cctx->lz4CtxPtr, cdict, cctx->prefs.compressionLevel, LZ4F_blockLinked);\n    }\n    if (preferencesPtr->compressionLevel >= LZ4HC_CLEVEL_MIN) {\n        LZ4_favorDecompressionSpeed((LZ4_streamHC_t*)cctx->lz4CtxPtr, (int)preferencesPtr->favorDecSpeed);\n    }\n    if (dictBuffer) {\n        assert(cdict == NULL);\n        RETURN_ERROR_IF(dictSize > INT_MAX, parameter_invalid);\n        if (cctx->lz4CtxType == ctxFast) {\n            /* lz4 fast*/\n            LZ4_loadDict((LZ4_stream_t*)cctx->lz4CtxPtr, (const char*)dictBuffer, (int)dictSize);\n        } else {\n            /* lz4hc */\n            assert(cctx->lz4CtxType == ctxHC);\n            LZ4_loadDictHC((LZ4_streamHC_t*)cctx->lz4CtxPtr, (const char*)dictBuffer, (int)dictSize);\n        }\n    }\n\n    /* Stage 2 : Write Frame Header */\n\n    /* Magic Number */\n    LZ4F_writeLE32(dstPtr, LZ4F_MAGICNUMBER);\n    dstPtr += 4;\n    {   BYTE* const headerStart = dstPtr;\n\n        /* FLG Byte */\n        *dstPtr++ = (BYTE)(((1 & _2BITS) << 6)    /* Version('01') */\n            + ((cctx->prefs.frameInfo.blockMode & _1BIT ) << 5)\n            + ((cctx->prefs.frameInfo.blockChecksumFlag & _1BIT ) << 4)\n            + ((unsigned)(cctx->prefs.frameInfo.contentSize > 0) << 3)\n            + ((cctx->prefs.frameInfo.contentChecksumFlag & _1BIT ) << 2)\n            +  (cctx->prefs.frameInfo.dictID > 0) );\n        /* BD Byte */\n        *dstPtr++ = (BYTE)((cctx->prefs.frameInfo.blockSizeID & _3BITS) << 4);\n        /* Optional Frame content size field */\n        if (cctx->prefs.frameInfo.contentSize) {\n            LZ4F_writeLE64(dstPtr, cctx->prefs.frameInfo.contentSize);\n            dstPtr += 8;\n            cctx->totalInSize = 0;\n        }","is_error":false}]},"parent_tool_use_id":"toolu_bdrk_01MKYk4UMDTn1UfVtVFpWvXe","session_id":"5bf83431-1376-4c81-bcb4-7fd267eb113b","uuid":"0efcc319-e6ce-45cc-94a4-12f35fd7fdf1","timestamp":"2026-08-23T09:11:07.237Z","subagent_type":"general-purpose","task_description":"Phase C row tests for lz4frame"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Tf34xZekDktWsRPJ5E4Wxn","type":"tool_result","content":"1\t//! Differential tests for ALL SIX exported symbols of `lz4file.c`:\n2\t//! `LZ4F_writeOpen`, `LZ4F_write`, `LZ4F_writeClose`,\n3\t//! `LZ4F_readOpen`,  `LZ4F_read`,  `LZ4F_readClose`.\n4\t//!\n5\t//! Real temp files are used (under `$TMPDIR`), and `FILE*` handles come from\n6\t//! libc's `fopen`/`fclose`/`fflush`/`rewind`, declared here — libc is not the\n7\t//! library under test.\n8\t//!\n9\t//! Strategy\n10\t//! --------\n11\t//! *write side*: run the identical `writeOpen`/`write`.../`writeClose` sequence\n12\t//!   against the C library and against the Rust library, each into its own temp\n13\t//!   file, then compare every return value AND the two resulting files byte for\n14\t//!   byte.\n15\t//! *read side*:  take a reference `.lz4` file, read it with both libraries using\n16\t//!   the identical sequence of `LZ4F_read` sizes, and compare every return value,\n17\t//!   the 0xAA-prefilled destination buffers in full, and the decoded content\n18\t//!   against the original bytes.  Files produced by the C writer AND by the Rust\n19\t//!   writer are both used as inputs, in both directions.\n20\t\n21\t#![allow(non_snake_case)]\n22\t#![allow(non_upper_case_globals)]\n23\t#![allow(unused_imports)]\n24\t\n25\tmod common;\n26\t\n27\tuse common::*;\n28\tuse std::os::raw::{c_char, c_int, c_uint, c_void};\n29\tuse std::sync::OnceLock;\n30\t\n31\t// ---------------------------------------------------------------------------\n32\t// libc (NOT the library under test)\n33\t// ---------------------------------------------------------------------------\n34\textern \"C\" {\n35\t    fn fopen(path: *const c_char, mode: *const c_char) -> *mut c_void;\n36\t    fn fclose(fp: *mut c_void) -> c_int;\n37\t    fn fflush(fp: *mut c_void) -> c_int;\n38\t    fn rewind(fp: *mut c_void);\n39\t}\n40\t\n41\t// ---------------------------------------------------------------------------\n42\t// Signatures — verified against c_src/src/lz4file.c / c_src/include/lz4file.h\n43\t// ---------------------------------------------------------------------------\n44\ttype FnWriteOpen =\n45\t    unsafe extern \"C\" fn(*mut *mut c_void, *mut c_void, *const LZ4F_preferences_t) -> usize;\n46\ttype FnWrite = unsafe extern \"C\" fn(*mut c_void, *const c_void, usize) -> usize;\n47\ttype FnWriteClose = unsafe extern \"C\" fn(*mut c_void) -> usize;\n48\ttype FnReadOpen = unsafe extern \"C\" fn(*mut *mut c_void, *mut c_void) -> usize;\n49\ttype FnRead = unsafe extern \"C\" fn(*mut c_void, *mut c_void, usize) -> usize;\n50\ttype FnReadClose = unsafe extern \"C\" fn(*mut c_void) -> usize;\n51\t\n52\t// frame-level helpers used to build reference/corrupt inputs\n53\ttype FnCompressFrameBound = unsafe extern \"C\" fn(usize, *const LZ4F_preferences_t) -> usize;\n54\ttype FnCompressFrame = unsafe extern \"C\" fn(\n55\t    *mut c_void,\n56\t    usize,\n57\t    *const c_void,\n58\t    usize,\n59\t    *const LZ4F_preferences_t,\n60\t) -> usize;\n61\t\n62\tconst SENTINEL: u8 = 0xAA;\n63\t\n64\tstruct FileFns {\n65\t    write_open: FnWriteOpen,\n66\t    write: FnWrite,\n67\t    write_close: FnWriteClose,\n68\t    read_open: FnReadOpen,\n69\t    read: FnRead,\n70\t    read_close: FnReadClose,\n71\t    tag: &'static str,\n72\t}\n73\t\n74\tstruct Api {\n75\t    c: FileFns,\n76\t    r: FileFns,\n77\t    c_frame_bound: FnCompressFrameBound,\n78\t    c_frame: FnCompressFrame,\n79\t}\n80\t\n81\tfn api() -> &'static Api {\n82\t    static A: OnceLock<Api> = OnceLock::new();\n83\t    A.get_or_init(|| {\n84\t        let l = libs();\n85\t        let c = FileFns {\n86\t            write_open: l.c.sym(\"LZ4F_writeOpen\"),\n87\t            write: l.c.sym(\"LZ4F_write\"),\n88\t            write_close: l.c.sym(\"LZ4F_writeClose\"),\n89\t            read_open: l.c.sym(\"LZ4F_readOpen\"),\n90\t            read: l.c.sym(\"LZ4F_read\"),\n91\t            read_close: l.c.sym(\"LZ4F_readClose\"),\n92\t            tag: \"C\",\n93\t        };\n94\t        let r = FileFns {\n95\t            write_open: l.rust.sym(\"LZ4F_writeOpen\"),\n96\t            write: l.rust.sym(\"LZ4F_write\"),\n97\t            write_close: l.rust.sym(\"LZ4F_writeClose\"),\n98\t            read_open: l.rust.sym(\"LZ4F_readOpen\"),\n99\t            read: l.rust.sym(\"LZ4F_read\"),\n100\t            read_close: l.rust.sym(\"LZ4F_readClose\"),\n101\t            tag: \"Rust\",\n102\t        };\n103\t        // Sanity: the two libraries must be distinct code objects, otherwise the\n104\t        // whole differential setup would be vacuous.\n105\t        assert_ne!(\n106\t            c.write as usize, r.write as usize,\n107\t            \"C and Rust LZ4F_write resolved to the same address\"\n108\t        );\n109\t        assert_ne!(\n110\t            c.read as usize, r.read as usize,\n111\t            \"C and Rust LZ4F_read resolved to the same address\"\n112\t        );\n113\t        Api {\n114\t            c,\n115\t            r,\n116\t            c_frame_bound: l.c.sym(\"LZ4F_compressFrameBound\"),\n117\t            c_frame: l.c.sym(\"LZ4F_compressFrame\"),\n118\t        }\n119\t    })\n120\t}\n121\t\n122\tfn ret_str(r: usize) -> String {\n123\t    if lz4f_is_error(r) {\n124\t        format!(\"ERROR({})\", lz4f_error_code(r))\n125\t    } else {\n126\t        format!(\"{}\", r)\n127\t    }\n128\t}\n129\t\n130\t// ---------------------------------------------------------------------------\n131\t// Temp files\n132\t// ---------------------------------------------------------------------------\n133\t\n134\tstruct TmpFile {\n135\t    path: String,\n136\t    cpath: std::ffi::CString,\n137\t}\n138\t\n139\timpl TmpFile {\n140\t    fn new(name: &str) -> Self {\n141\t        let dir = std::env::var(\"TMPDIR\").unwrap_or_else(|_| \"/tmp\".to_string());\n142\t        let dir = dir.trim_end_matches('/').to_string();\n143\t        let path = format!(\"{}/lz4file_diff_{}_{}.lz4\", dir, std::process::id(), name);\n144\t        let _ = std::fs::remove_file(&path);\n145\t        let cpath = std::ffi::CString::new(path.clone()).unwrap();\n146\t        TmpFile { path, cpath }\n147\t    }\n148\t    fn open(&self, mode: &str) -> *mut c_void {\n149\t        let m = std::ffi::CString::new(mode).unwrap();\n150\t        let fp = unsafe { fopen(self.cpath.as_ptr(), m.as_ptr()) };\n151\t        assert!(!fp.is_null(), \"fopen({}, {}) failed\", self.path, mode);\n152\t        fp\n153\t    }\n154\t    fn bytes(&self) -> Vec<u8> {\n155\t        std::fs::read(&self.path).unwrap_or_else(|e| panic!(\"read {}: {}\", self.path, e))\n156\t    }\n157\t    fn put(&self, data: &[u8]) {\n158\t        std::fs::write(&self.path, data).unwrap_or_else(|e| panic!(\"write {}: {}\", self.path, e));\n159\t    }\n160\t}\n161\t\n162\timpl Drop for TmpFile {\n163\t    fn drop(&mut self) {\n164\t        let _ = std::fs::remove_file(&self.path);\n165\t    }\n166\t}\n167\t\n168\t// ---------------------------------------------------------------------------\n169\t// Write driver\n170\t// ---------------------------------------------------------------------------\n171\t\n172\tstruct WriteLog {\n173\t    open_ret: usize,\n174\t    write_rets: Vec<usize>,\n175\t    close_ret: usize,\n176\t    /// Whether the state pointer was NULL after `LZ4F_writeOpen`.\n177\t    state_null_after_open: bool,\n178\t    file: Vec<u8>,\n179\t}\n180\t\n181\t/// Run `writeOpen` / `write`* / `writeClose` on one library.\n182\tfn run_write(\n183\t    f: &FileFns,\n184\t    tmp: &TmpFile,\n185\t    mode: &str,\n186\t    prefs: Option<&LZ4F_preferences_t>,\n187\t    chunks: &[&[u8]],\n188\t) -> WriteLog {\n189\t    let fp = tmp.open(mode);\n190\t    let prefs_ptr = match prefs {\n191\t        Some(p) => p as *const LZ4F_preferences_t,\n192\t        None => std::ptr::null(),\n193\t    };\n194\t    unsafe {\n195\t        let mut st: *mut c_void = std::ptr::null_mut();\n196\t        let open_ret = (f.write_open)(&mut st, fp, prefs_ptr);\n197\t        let state_null_after_open = st.is_null();\n198\t        let mut write_rets = Vec::new();\n199\t        if !lz4f_is_error(open_ret) && !st.is_null() {\n200\t            for ch in chunks {\n201\t                let r = (f.write)(\n202\t                    st,\n203\t                    ch.as_ptr() as *const c_void,\n204\t                    ch.len(),\n205\t                );\n206\t                write_rets.push(r);\n207\t                if lz4f_is_error(r) {\n208\t                    break;\n209\t                }\n210\t            }\n211\t        }\n212\t        // LZ4F_writeClose frees the state (and tolerates NULL).\n213\t        let close_ret = (f.write_close)(st);\n214\t        fflush(fp);\n215\t        fclose(fp);\n216\t        WriteLog {\n217\t            open_ret,\n218\t            write_rets,\n219\t            close_ret,\n220\t            state_null_after_open,\n221\t            file: tmp.bytes(),\n222\t        }\n223\t    }\n224\t}\n225\t\n226\t/// Do the same write sequence on both libraries and require everything to match.\n227\tfn write_both(\n228\t    name: &str,\n229\t    prefs: Option<&LZ4F_preferences_t>,\n230\t    chunks: &[&[u8]],\n231\t    label: &str,\n232\t) -> Vec<u8> {\n233\t    let a = api();\n234\t    let tc = TmpFile::new(&format!(\"{}_c\", name));\n235\t    let tr = TmpFile::new(&format!(\"{}_r\", name));\n236\t    let lc = run_write(&a.c, &tc, \"wb\", prefs, chunks);\n237\t    let lr = run_write(&a.r, &tr, \"wb\", prefs, chunks);\n238\t\n239\t    assert_eq!(\n240\t        ret_str(lc.open_ret),\n241\t        ret_str(lr.open_ret),\n242\t        \"{}: LZ4F_writeOpen return\",\n243\t        label\n244\t    );\n245\t    assert_eq!(\n246\t        lc.state_null_after_open, lr.state_null_after_open,\n247\t        \"{}: state NULLness after LZ4F_writeOpen\",\n248\t        label\n249\t    );\n250\t    assert_eq!(\n251\t        lc.write_rets.len(),\n252\t        lr.write_rets.len(),\n253\t        \"{}: number of LZ4F_write calls made\",\n254\t        label\n255\t    );\n256\t    for (i, (c, r)) in lc.write_rets.iter().zip(lr.write_rets.iter()).enumerate() {\n257\t        assert_eq!(\n258\t            ret_str(*c),\n259\t            ret_str(*r),\n260\t            \"{}: LZ4F_write #{} return\",\n261\t            label,\n262\t            i\n263\t        );\n264\t    }\n265\t    assert_eq!(\n266\t        ret_str(lc.close_ret),\n267\t        ret_str(lr.close_ret),\n268\t        \"{}: LZ4F_writeClose return\",\n269\t        label\n270\t    );\n271\t    assert_bytes_eq(\n272\t        &format!(\"{}: written file contents\", label),\n273\t        &lc.file,\n274\t        &lr.file,\n275\t    );\n276\t    lc.file\n277\t}\n278\t\n279\t// ---------------------------------------------------------------------------\n280\t// Read driver\n281\t// ---------------------------------------------------------------------------\n282\t\n283\tstruct ReadLog {\n284\t    open_ret: usize,\n285\t    state_null_after_open: bool,\n286\t    read_rets: Vec<usize>,\n287\t    close_ret: usize,\n288\t    buf: Vec<u8>,\n289\t    produced: usize,\n290\t}\n291\t\n292\t/// Run `readOpen` / `read`* / `readClose` on one library, with `plan` cycled as\n293\t/// the requested read sizes.\n294\tfn run_read(f: &FileFns, tmp: &TmpFile, plan: &[usize], out_len: usize) -> ReadLog {\n295\t    let fp = tmp.open(\"rb\");\n296\t    unsafe {\n297\t        let mut st: *mut c_void = std::ptr::null_mut();\n298\t        let open_ret = (f.read_open)(&mut st, fp);\n299\t        let state_null_after_open = st.is_null();\n300\t        let mut buf = vec![SENTINEL; out_len];\n301\t        let mut read_rets = Vec::new();\n302\t        let mut produced = 0usize;\n303\t        if !lz4f_is_error(open_ret) && !st.is_null() {\n304\t            let mut i = 0usize;\n305\t            loop {\n306\t                assert!(i < 20_000_000, \"{}: runaway LZ4F_read loop\", f.tag);\n307\t                let want = plan[i % plan.len()].min(out_len - produced);\n308\t                if want == 0 {\n309\t                    break;\n310\t                }\n311\t                let r = (f.read)(st, buf.as_mut_ptr().add(produced) as *mut c_void, want);\n312\t                read_rets.push(r);\n313\t                if lz4f_is_error(r) || r == 0 {\n314\t                    break;\n315\t                }\n316\t                produced += r;\n317\t                i += 1;\n318\t            }\n319\t        } else {\n320\t            // exercise LZ4F_read on the NULL state too\n321\t            read_rets.push((f.read)(st, buf.as_mut_ptr() as *mut c_void, 16));\n322\t        }\n323\t        let close_ret = (f.read_close)(st);\n324\t        fclose(fp);\n325\t        ReadLog {\n326\t            open_ret,\n327\t            state_null_after_open,\n328\t            read_rets,\n329\t            close_ret,\n330\t            buf,\n331\t            produced,\n332\t        }\n333\t    }\n334\t}\n335\t\n336\t/// Read the same file with both libraries and require everything to match.\n337\t/// Returns the C log (identical to the Rust one by construction).\n338\tfn read_both(file: &[u8], plan: &[usize], out_len: usize, name: &str, label: &str) -> ReadLog {\n339\t    let a = api();\n340\t    let tc = TmpFile::new(&format!(\"{}_rc\", name));\n341\t    let tr = TmpFile::new(&format!(\"{}_rr\", name));\n342\t    tc.put(file);\n343\t    tr.put(file);\n344\t    let lc = run_read(&a.c, &tc, plan, out_len);\n345\t    let lr = run_read(&a.r, &tr, plan, out_len);\n346\t\n347\t    assert_eq!(\n348\t        ret_str(lc.open_ret),\n349\t        ret_str(lr.open_ret),\n350\t        \"{}: LZ4F_readOpen return\",\n351\t        label\n352\t    );\n353\t    assert_eq!(\n354\t        lc.state_null_after_open, lr.state_null_after_open,\n355\t        \"{}: state NULLness after LZ4F_readOpen\",\n356\t        label\n357\t    );\n358\t    assert_eq!(\n359\t        lc.read_rets.len(),\n360\t        lr.read_rets.len(),\n361\t        \"{}: number of LZ4F_read calls (C {:?} vs Rust {:?})\",\n362\t        label,\n363\t        lc.read_rets.iter().map(|r| ret_str(*r)).collect::<Vec<_>>(),\n364\t        lr.read_rets.iter().map(|r| ret_str(*r)).collect::<Vec<_>>()\n365\t    );\n366\t    for (i, (c, r)) in lc.read_rets.iter().zip(lr.read_rets.iter()).enumerate() {\n367\t        assert_eq!(\n368\t            ret_str(*c),\n369\t            ret_str(*r),\n370\t            \"{}: LZ4F_read #{} return\",\n371\t            label,\n372\t            i\n373\t        );\n374\t    }\n375\t    assert_eq!(\n376\t        ret_str(lc.close_ret),\n377\t        ret_str(lr.close_ret),\n378\t        \"{}: LZ4F_readClose return\",\n379\t        label\n380\t    );\n381\t    assert_eq!(lc.produced, lr.produced, \"{}: total bytes read\", label);\n382\t    assert_bytes_eq(&format!(\"{}: read buffer\", label), &lc.buf, &lr.buf);\n383\t    lc\n384\t}\n385\t\n386\t/// `LZ4F_readOpen` unconditionally does `fread(buf, 1, LZ4F_HEADER_SIZE_MAX, fp)`\n387\t/// and fails with `LZ4F_ERROR_io_read` unless it gets all 19 bytes — so any\n388\t/// `.lz4` file shorter than 19 bytes simply cannot be opened for reading.\n389\t/// This helper asserts the C-documented behaviour for both cases.\n390\tfn expect_readback(file: &[u8], plan: &[usize], data: &[u8], name: &str, label: &str) {\n391\t    let lc = read_both(file, plan, data.len() + 64, name, label);\n392\t    if file.len() >= LZ4F_HEADER_SIZE_MAX {\n393\t        assert_bytes_eq(\n394\t            &format!(\"{}: readback content\", label),\n395\t            data,\n396\t            &lc.buf[..lc.produced],\n397\t        );\n398\t    } else {\n399\t        assert_eq!(\n400\t            lz4f_error_code(lc.open_ret),\n401\t            err::ERROR_io_read,\n402\t            \"{}: a {}-byte file must fail LZ4F_readOpen with io_read\",\n403\t            label,\n404\t            file.len()\n405\t        );\n406\t        assert_eq!(lc.produced, 0, \"{}: nothing may be produced\", label);\n407\t    }\n408\t}\n409\t\n410\t#[allow(clippy::too_many_arguments)]\n411\tfn prefs_of(\n412\t    bsid: c_int,\n413\t    bmode: c_int,\n414\t    cc: c_int,\n415\t    bc: c_int,\n416\t    content_size: u64,\n417\t    dict_id: c_uint,\n418\t    level: c_int,\n419\t    auto_flush: c_uint,\n420\t) -> LZ4F_preferences_t {\n421\t    let mut p = LZ4F_preferences_t::default();\n422\t    p.frameInfo.blockSizeID = bsid;\n423\t    p.frameInfo.blockMode = bmode;\n424\t    p.frameInfo.contentChecksumFlag = cc;\n425\t    p.frameInfo.blockChecksumFlag = bc;\n426\t    p.frameInfo.contentSize = content_size;\n427\t    p.frameInfo.dictID = dict_id;\n428\t    p.frameInfo.frameType = LZ4F_frame;\n429\t    p.compressionLevel = level;\n430\t    p.autoFlush = auto_flush;\n431\t    p\n432\t}\n433\t\n434\t/// One-shot frame built with the C library (used as a canonical reader input).\n435\tfn c_compress_frame(data: &[u8], prefs: &LZ4F_preferences_t) -> Vec<u8> {\n436\t    let a = api();\n437\t    unsafe {\n438\t        let cap = (a.c_frame_bound)(data.len(), prefs as *const LZ4F_preferences_t);\n439\t        let mut buf = vec![0u8; cap.max(32)];\n440\t        let n = (a.c_frame)(\n441\t            buf.as_mut_ptr() as *mut c_void,\n442\t            buf.len(),\n443\t            data.as_ptr() as *const c_void,\n444\t            data.len(),\n445\t            prefs as *const LZ4F_preferences_t,\n446\t        );\n447\t        assert!(!lz4f_is_error(n), \"LZ4F_compressFrame: {}\", ret_str(n));\n448\t        buf.truncate(n);\n449\t        buf\n450\t    }\n451\t}\n452\t\n453\tfn skippable_frame(magic: u32, payload: &[u8]) -> Vec<u8> {\n454\t    let mut v = Vec::with_capacity(8 + payload.len());\n455\t    v.extend_from_slice(&magic.to_le_bytes());\n456\t    v.extend_from_slice(&(payload.len() as u32).to_le_bytes());\n457\t    v.extend_from_slice(payload);\n458\t    v\n459\t}\n460\t\n461\t// ===========================================================================\n462\t// 1. write side: full preferences matrix\n463\t// ===========================================================================\n464\t\n465\t#[test]\n466\tfn write_preferences_matrix() {\n467\t    let mut rng = Rng::new(0xF11E_0001);\n468\t    let mut n = 0usize;\n469\t\n470\t    for &bsid in &[0, 4, 5, 6, 7] {\n471\t        for &bmode in &[LZ4F_blockLinked, LZ4F_blockIndependent] {\n472\t            for &cc in &[LZ4F_noContentChecksum, LZ4F_contentChecksumEnabled] {\n473\t                for &bc in &[LZ4F_noBlockChecksum, LZ4F_blockChecksumEnabled] {\n474\t                    for &with_csz in &[false, true] {\n475\t                        for &did in &[0u32, 0x0BAD_F00Du32] {\n476\t                            for &af in &[0u32, 1u32] {\n477\t                                let shape = n % N_SHAPES;\n478\t                                let len = [0usize, 1, 2, 700, 5000, 40_000][n % 6];\n479\t                                let data = gen_shape(&mut rng, shape, len);\n480\t                                let prefs = prefs_of(\n481\t                                    bsid,\n482\t                                    bmode,\n483\t                                    cc,\n484\t                                    bc,\n485\t                                    if with_csz { data.len() as u64 } else { 0 },\n486\t                                    did,\n487\t                                    [0i32, 1, 3, 9, 12][n % 5],\n488\t                                    af,\n489\t                                );\n490\t                                let label = format!(\n491\t                                    \"writeprefs bsid={} bmode={} cc={} bc={} csz={} did={:#x} af={} shape={} len={}\",\n492\t                                    bsid, bmode, cc, bc, with_csz, did, af, shape_name(shape), len\n493\t                                );\n494\t                                let file =\n495\t                                    write_both(\"prefs\", Some(&prefs), &[&data[..]], &label);\n496\t                                // ... and the produced file must decode back.\n497\t                                expect_readback(\n498\t                                    &file,\n499\t                                    &[data.len().max(1) + 64],\n500\t                                    &data,\n501\t                                    \"prefs\",\n502\t                                    &format!(\"{} [readback]\", label),\n503\t                                );\n504\t                                n += 1;\n505\t                            }\n506\t                        }\n507\t                    }\n508\t                }\n509\t            }\n510\t        }\n511\t    }\n512\t    assert_eq!(n, 5 * 2 * 2 * 2 * 2 * 2 * 2);\n513\t\n514\t    // NULL prefsPtr => maxWriteSize defaults to 64 KB\n515\t    for shape in 0..N_SHAPES {\n516\t        for &len in &[0usize, 1, 100, 65_535, 65_536, 65_537, 200_000] {\n517\t            let data = gen_shape(&mut rng, shape, len);\n518\t            let label = format!(\"writeprefs NULL shape={} len={}\", shape_name(shape), len);\n519\t            let file = write_both(\"prefsnull\", None, &[&data[..]], &label);\n520\t            expect_readback(\n521\t                &file,\n522\t                &[64 * 1024],\n523\t                &data,\n524\t                \"prefsnull\",\n525\t                &format!(\"{} [readback]\", label),\n526\t            );\n527\t        }\n528\t    }\n529\t}\n530\t\n531\t// ===========================================================================\n532\t// 2. write side: call-size axes (the internal maxWriteSize chunk loop)\n533\t// ===========================================================================\n534\t\n535\t#[test]\n536\tfn write_call_size_axes() {\n537\t    let mut rng = Rng::new(0xF11E_0002);\n538\t\n539\t    // blockSizeID 4 => maxWriteSize == 64 KB, so writes bigger than that are\n540\t    // split by LZ4F_write's internal loop.\n541\t    for &bsid in &[4, 5] {\n542\t        let max_write = if bsid == 4 { 65_536usize } else { 262_144 };\n543\t        for &bmode in &[LZ4F_blockLinked, LZ4F_blockIndependent] {\n544\t            for &af in &[0u32, 1u32] {\n545\t                for shape in 0..N_SHAPES {\n546\t                    let total = max_write * 2 + 1234;\n547\t                    let data = gen_shape(&mut rng, shape, total);\n548\t                    for &step in &[\n549\t                        1usize,\n550\t                        2,\n551\t                        3,\n552\t                        7,\n553\t                        1000,\n554\t                        max_write - 1,\n555\t                        max_write,\n556\t                        max_write + 1,\n557\t                        total,\n558\t                    ] {\n559\t                        // byte-at-a-time writes of a 500 KB payload are too slow\n560\t                        if step < 1000 && total > 20_000 {\n561\t                            continue;\n562\t                        }\n563\t                        let chunks: Vec<&[u8]> = data.chunks(step).collect();\n564\t                        let label = format!(\n565\t                            \"writesize bsid={} bmode={} af={} shape={} total={} step={} nchunks={}\",\n566\t                            bsid,\n567\t                            bmode,\n568\t                            af,\n569\t                            shape_name(shape),\n570\t                            total,\n571\t                            step,\n572\t                            chunks.len()\n573\t                        );\n574\t                        let prefs = prefs_of(bsid, bmode, 1, 1, 0, 0, 0, af);\n575\t                        let file = write_both(\"wsize\", Some(&prefs), &chunks, &label);\n576\t                        expect_readback(\n577\t                            &file,\n578\t                            &[max_write],\n579\t                            &data,\n580\t                            \"wsize\",\n581\t                            &format!(\"{} [readback]\", label),\n582\t                        );\n583\t                    }\n584\t                }\n585\t            }\n586\t        }\n587\t    }\n588\t\n589\t    // Fine-grained writes on a small payload (covers step 1,2,3,7).\n590\t    for shape in 0..N_SHAPES {\n591\t        let data = gen_shape(&mut rng, shape, 3000);\n592\t        for &step in &[1usize, 2, 3, 7, 999] {\n593\t            for &af in &[0u32, 1u32] {\n594\t                let chunks: Vec<&[u8]> = data.chunks(step).collect();\n595\t                let prefs = prefs_of(4, LZ4F_blockLinked, 1, 1, 0, 0, 0, af);\n596\t                let label = format!(\n597\t                    \"writesize-small shape={} step={} af={}\",\n598\t                    shape_name(shape),\n599\t                    step,\n600\t                    af\n601\t                );\n602\t                let file = write_both(\"wsizes\", Some(&prefs), &chunks, &label);\n603\t                expect_readback(\n604\t                    &file,\n605\t                    &[4096],\n606\t                    &data,\n607\t                    \"wsizes\",\n608\t                    &format!(\"{} [readback]\", label),\n609\t                );\n610\t            }\n611\t        }\n612\t    }\n613\t\n614\t    // zero-length writes, interleaved with real ones\n615\t    for shape in 0..N_SHAPES {\n616\t        let data = gen_shape(&mut rng, shape, 5000);\n617\t        let empty: &[u8] = &[];\n618\t        let chunks: Vec<&[u8]> = vec![\n619\t            empty,\n620\t            &data[..0],\n621\t            &data[..1000],\n622\t            empty,\n623\t            &data[1000..1000],\n624\t            &data[1000..5000],\n625\t            empty,\n626\t        ];\n627\t        let prefs = prefs_of(4, LZ4F_blockLinked, 1, 0, data.len() as u64, 0, 0, 0);\n628\t        let label = format!(\"write zero-length interleaved shape={}\", shape_name(shape));\n629\t        let file = write_both(\"wzero\", Some(&prefs), &chunks, &label);\n630\t        expect_readback(\n631\t            &file,\n632\t            &[1024],\n633\t            &data,\n634\t            \"wzero\",\n635\t            &format!(\"{} [readback]\", label),\n636\t        );\n637\t    }\n638\t\n639\t    // no write at all: writeOpen immediately followed by writeClose\n640\t    for &bsid in &[0, 4, 5, 6, 7] {\n641\t        for &cc in &[0, 1] {\n642\t            let prefs = prefs_of(bsid, LZ4F_blockLinked, cc, 0, 0, 0, 0, 0);\n643\t            let label = format!(\"write empty frame bsid={} cc={}\", bsid, cc);\n644\t            let file = write_both(\"wempty\", Some(&prefs), &[], &label);\n645\t            expect_readback(&file, &[4096], &[], \"wempty\", &format!(\"{} [readback]\", label));\n646\t        }\n647\t    }\n648\t}\n649\t\n650\t// ===========================================================================\n651\t// 3. write side: contentSize enforcement (LZ4F_compressEnd -> frameSize_wrong)\n652\t// ===========================================================================\n653\t\n654\t#[test]\n655\tfn write_content_size_enforcement() {\n656\t    let mut rng = Rng::new(0xF11E_0003);\n657\t    let data = gen_shape(&mut rng, 3, 4321);\n658\t\n659\t    // exact => success\n660\t    let prefs = prefs_of(4, LZ4F_blockLinked, 1, 1, data.len() as u64, 0, 0, 1);\n661\t    let label = \"contentSize exact\";\n662\t    let file = write_both(\"csz_ok\", Some(&prefs), &[&data[..]], label);\n663\t    expect_readback(&file, &[8192], &data, \"csz_ok\", \"contentSize exact read\");\n664\t\n665\t    // mismatching => LZ4F_writeClose must report frameSize_wrong identically\n666\t    for &declared in &[1u64, (data.len() as u64) - 1, (data.len() as u64) + 1, 1 << 40] {\n667\t        let prefs = prefs_of(4, LZ4F_blockLinked, 1, 1, declared, 0, 0, 1);\n668\t        let label = format!(\"contentSize declared={} actual={}\", declared, data.len());\n669\t        let a = api();\n670\t        let tc = TmpFile::new(\"csz_bad_c\");\n671\t        let tr = TmpFile::new(\"csz_bad_r\");\n672\t        let lc = run_write(&a.c, &tc, \"wb\", Some(&prefs), &[&data[..]]);\n673\t        let lr = run_write(&a.r, &tr, \"wb\", Some(&prefs), &[&data[..]]);\n674\t        assert_eq!(\n675\t            ret_str(lc.open_ret),\n676\t            ret_str(lr.open_ret),\n677\t            \"{}: writeOpen\",\n678\t            label\n679\t        );\n680\t        assert_eq!(\n681\t            lc.write_rets.iter().map(|r| ret_str(*r)).collect::<Vec<_>>(),\n682\t            lr.write_rets.iter().map(|r| ret_str(*r)).collect::<Vec<_>>(),\n683\t            \"{}: write returns\",\n684\t            label\n685\t        );\n686\t        assert_eq!(\n687\t            ret_str(lc.close_ret),\n688\t            ret_str(lr.close_ret),\n689\t            \"{}: writeClose return\",\n690\t            label\n691\t        );\n692\t        assert_eq!(\n693\t            lz4f_error_code(lc.close_ret),\n694\t            err::ERROR_frameSize_wrong,\n695\t            \"{}: expected frameSize_wrong\",\n696\t            label\n697\t        );\n698\t        assert_bytes_eq(&format!(\"{}: file bytes\", label), &lc.file, &lr.file);\n699\t    }\n700\t}\n701\t\n702\t// ===========================================================================\n703\t// 4. read side: read-size axes over reference frames\n704\t// ===========================================================================\n705\t\n706\t#[test]\n707\tfn read_size_axes() {\n708\t    let mut rng = Rng::new(0xF11E_0004);\n709\t\n710\t    for &bsid in &[0, 4, 5, 6, 7] {\n711\t        for &bmode in &[LZ4F_blockLinked, LZ4F_blockIndependent] {\n712\t            for &cc in &[0, 1] {\n713\t                for &bc in &[0, 1] {\n714\t                    for shape in 0..N_SHAPES {\n715\t                        let len = [0usize, 1, 19, 500, 70_000][shape % 5];\n716\t                        let data = gen_shape(&mut rng, shape, len);\n717\t                        // reference file built with LZ4F_compressFrame (C)\n718\t                        let prefs =\n719\t                            prefs_of(bsid, bmode, cc, bc, data.len() as u64, 0x99, 0, 1);\n720\t                        let file = c_compress_frame(&data, &prefs);\n721\t                        for &plan in &[\n722\t                            &[1usize][..],\n723\t                            &[2][..],\n724\t                            &[3][..],\n725\t                            &[7][..],\n726\t                            &[100][..],\n727\t                            &[4096][..],\n728\t                            &[65_536][..],\n729\t                            &[1 << 20][..],\n730\t                            &[1, 2, 3, 4, 5, 100, 1][..],\n731\t                            &[7, 1, 4095, 2][..],\n732\t                        ] {\n733\t                            if plan[0] < 8 && len > 5000 {\n734\t                                continue;\n735\t                            }\n736\t                            let label = format!(\n737\t                                \"readsize bsid={} bmode={} cc={} bc={} shape={} len={} plan={:?}\",\n738\t                                bsid,\n739\t                                bmode,\n740\t                                cc,\n741\t                                bc,\n742\t                                shape_name(shape),\n743\t                                len,\n744\t                                plan\n745\t                            );\n746\t                            expect_readback(&file, plan, &data, \"rsize\", &label);\n747\t                        }\n748\t                    }\n749\t                }\n750\t            }\n751\t        }\n752\t    }\n753\t\n754\t    // randomised read sizes\n755\t    for iter in 0..60u32 {\n756\t        let shape = (iter as usize) % N_SHAPES;\n757\t        let len = rng.range(0, 120_000);\n758\t        let data = gen_shape(&mut rng, shape, len);\n759\t        let bsid = [0, 4, 5, 6, 7][(iter as usize) % 5];\n760\t        let prefs = prefs_of(\n761\t            bsid,\n762\t            if rng.bool() {\n763\t                LZ4F_blockLinked\n764\t            } else {\n765\t                LZ4F_blockIndependent\n766\t            },\n767\t            rng.bool() as c_int,\n768\t            rng.bool() as c_int,\n769\t            if rng.bool() { data.len() as u64 } else { 0 },\n770\t            rng.next_u32(),\n771\t            0,\n772\t            1,\n773\t        );\n774\t        let file = c_compress_frame(&data, &prefs);\n775\t        let mut plan: Vec<usize> = Vec::new();\n776\t        for _ in 0..12 {\n777\t            plan.push(rng.range(1, 20_000));\n778\t        }\n779\t        let label = format!(\n780\t            \"readrand iter={} shape={} len={} bsid={} plan={:?}\",\n781\t            iter,\n782\t            shape_name(shape),\n783\t            len,\n784\t            bsid,\n785\t            plan\n786\t        );\n787\t        expect_readback(&file, &plan, &data, \"rrand\", &label);\n788\t    }\n789\t}\n790\t\n791\t// ===========================================================================\n792\t// 5. cross: write with one library, read with the other\n793\t// ===========================================================================\n794\t\n795\t#[test]\n796\tfn write_read_cross_libraries() {\n797\t    let a = api();\n798\t    let mut rng = Rng::new(0xF11E_0005);\n799\t\n800\t    for &bsid in &[0, 4, 5, 6, 7] {\n801\t        for &bmode in &[LZ4F_blockLinked, LZ4F_blockIndependent] {\n802\t            for shape in 0..N_SHAPES {\n803\t                let data = gen_shape(&mut rng, shape, 60_000);\n804\t                let prefs = prefs_of(bsid, bmode, 1, 1, data.len() as u64, 0, 0, 0);\n805\t\n806\t                // written by C, then by Rust (files already asserted identical)\n807\t                let tc = TmpFile::new(\"cross_c\");\n808\t                let tr = TmpFile::new(\"cross_r\");\n809\t                let lc = run_write(&a.c, &tc, \"wb\", Some(&prefs), &[&data[..]]);\n810\t                let lr = run_write(&a.r, &tr, \"wb\", Some(&prefs), &[&data[..]]);\n811\t                let label = format!(\n812\t                    \"cross bsid={} bmode={} shape={}\",\n813\t                    bsid,\n814\t                    bmode,\n815\t                    shape_name(shape)\n816\t                );\n817\t                assert_eq!(\n818\t                    ret_str(lc.close_ret),\n819\t                    ret_str(lr.close_ret),\n820\t                    \"{}: writeClose\",\n821\t                    label\n822\t                );\n823\t                assert_bytes_eq(&format!(\"{}: files\", label), &lc.file, &lr.file);\n824\t\n825\t                // C writer file -> Rust reader, and Rust writer file -> C reader\n826\t                for &plan in &[&[7usize][..], &[4096][..], &[1 << 20][..], &[1, 3, 9999][..]] {\n827\t                    for (src_tag, src_file) in [(\"C-written\", &lc.file), (\"Rust-written\", &lr.file)]\n828\t                    {\n829\t                        expect_readback(\n830\t                            src_file,\n831\t                            plan,\n832\t                            &data,\n833\t                            \"cross\",\n834\t                            &format!(\"{} [{} plan={:?}]\", label, src_tag, plan),\n835\t                        );\n836\t                    }\n837\t                }\n838\t\n839\t                // Single FILE* re-used: write, rewind, read back with the same handle.\n840\t                for f in [&a.c, &a.r] {\n841\t                    let t = TmpFile::new(&format!(\"rewind_{}\", f.tag));\n842\t                    let fp = t.open(\"w+b\");\n843\t                    unsafe {\n844\t                        let mut st: *mut c_void = std::ptr::null_mut();\n845\t                        let o = (f.write_open)(&mut st, fp, &prefs as *const LZ4F_preferences_t);\n846\t                        assert!(!lz4f_is_error(o), \"{}: writeOpen\", f.tag);\n847\t                        let w = (f.write)(st, data.as_ptr() as *const c_void, data.len());\n848\t                        assert_eq!(w, data.len(), \"{}: write return\", f.tag);\n849\t                        let c = (f.write_close)(st);\n850\t                        assert!(!lz4f_is_error(c), \"{}: writeClose\", f.tag);\n851\t                        fflush(fp);\n852\t                        rewind(fp);\n853\t\n854\t                        let mut rst: *mut c_void = std::ptr::null_mut();\n855\t                        let ro = (f.read_open)(&mut rst, fp);\n856\t                        assert!(!lz4f_is_error(ro), \"{}: readOpen after rewind\", f.tag);\n857\t                        let mut buf = vec![SENTINEL; data.len() + 64];\n858\t                        let n = (f.read)(rst, buf.as_mut_ptr() as *mut c_void, buf.len());\n859\t                        assert!(!lz4f_is_error(n), \"{}: read after rewind\", f.tag);\n860\t                        assert_eq!(n, data.len(), \"{}: bytes read after rewind\", f.tag);\n861\t                        assert_bytes_eq(\n862\t                            &format!(\"{} rewind roundtrip content\", f.tag),\n863\t                            &data,\n864\t                            &buf[..n],\n865\t                        );\n866\t                        assert!(!lz4f_is_error((f.read_close)(rst)));\n867\t                        fclose(fp);\n868\t                    }\n869\t                }\n870\t            }\n871\t        }\n872\t    }\n873\t}\n874\t\n875\t// ===========================================================================\n876\t// 6. read side: multi-frame, skippable frames, short reads at EOF\n877\t// ===========================================================================\n878\t\n879\t#[test]\n880\tfn read_multiframe_skippable_and_eof() {\n881\t    let mut rng = Rng::new(0xF11E_0006);\n882\t\n883\t    for shape in 0..N_SHAPES {\n884\t        let d1 = gen_shape(&mut rng, shape, 5000);\n885\t        let d2 = gen_shape(&mut rng, (shape + 1) % N_SHAPES, 9000);\n886\t        let p1 = prefs_of(4, LZ4F_blockLinked, 1, 0, d1.len() as u64, 0, 0, 1);\n887\t        let p2 = prefs_of(5, LZ4F_blockIndependent, 0, 1, 0, 7, 0, 1);\n888\t        let f1 = c_compress_frame(&d1, &p1);\n889\t        let f2 = c_compress_frame(&d2, &p2);\n890\t\n891\t        // (a) two concatenated frames\n892\t        let mut cat = f1.clone();\n893\t        cat.extend_from_slice(&f2);\n894\t        let mut expect = d1.clone();\n895\t        expect.extend_from_slice(&d2);\n896\t        for &plan in &[&[1usize][..], &[100][..], &[1 << 20][..], &[7, 3, 5000][..]] {\n897\t            let label = format!(\"multiframe shape={} plan={:?}\", shape_name(shape), plan);\n898\t            expect_readback(&cat, plan, &expect, \"mf\", &label);\n899\t        }\n900\t\n901\t        // (b) skippable frame first\n902\t        let mut buf = skippable_frame(0x184D_2A53, &gen_random(&mut rng, 500));\n903\t        buf.extend_from_slice(&f1);\n904\t        for &plan in &[&[1usize][..], &[64][..], &[1 << 20][..]] {\n905\t            let label = format!(\"skippable+real shape={} plan={:?}\", shape_name(shape), plan);\n906\t            expect_readback(&buf, plan, &d1, \"sk\", &label);\n907\t        }\n908\t\n909\t        // (c) trailing skippable frame\n910\t        let mut buf = f1.clone();\n911\t        buf.extend_from_slice(&skippable_frame(0x184D_2A5F, &gen_random(&mut rng, 77)));\n912\t        for &plan in &[&[64usize][..], &[1 << 20][..]] {\n913\t            let label = format!(\"real+skippable shape={} plan={:?}\", shape_name(shape), plan);\n914\t            expect_readback(&buf, plan, &d1, \"sk2\", &label);\n915\t        }\n916\t\n917\t        // (d) reading far past EOF must simply return short/zero\n918\t        let label = format!(\"read past EOF shape={}\", shape_name(shape));\n919\t        expect_readback(&f1, &[d1.len() + 4096], &d1, \"eof\", &label);\n920\t    }\n921\t\n922\t    // (e) a file that is *only* a skippable frame: nothing to read\n923\t    {\n924\t        let buf = skippable_frame(0x184D_2A50, &gen_random(&mut rng, 300));\n925\t        for &plan in &[&[1usize][..], &[4096][..]] {\n926\t            let label = format!(\"only-skippable plan={:?}\", plan);\n927\t            let lc = read_both(&buf, plan, 4096, \"onlysk\", &label);\n928\t            assert_eq!(lc.produced, 0, \"{}: nothing should be produced\", label);\n929\t        }\n930\t    }\n931\t}\n932\t\n933\t// ===========================================================================\n934\t// 7. error paths\n935\t// ===========================================================================\n936\t\n937\t#[test]\n938\tfn lz4file_error_paths() {\n939\t    let a = api();\n940\t    let mut rng = Rng::new(0xF11E_0007);\n941\t    let data = gen_shape(&mut rng, 4, 30_000);\n942\t    let prefs = prefs_of(4, LZ4F_blockLinked, 1, 1, 0, 0, 0, 1);\n943\t    let good = c_compress_frame(&data, &prefs);\n944\t\n945\t    unsafe {\n946\t        // ---- NULL arguments -------------------------------------------------\n947\t        let t = TmpFile::new(\"err_null\");\n948\t        t.put(&good);\n949\t\n950\t        // writeOpen(NULL, fp, prefs) / writeOpen(&st, NULL, prefs)\n951\t        {\n952\t            let fp = t.open(\"wb\");\n953\t            let c = (a.c.write_open)(\n954\t                std::ptr::null_mut(),\n955\t                fp,\n956\t                &prefs as *const LZ4F_preferences_t,\n957\t            );\n958\t            let r = (a.r.write_open)(\n959\t                std::ptr::null_mut(),\n960\t                fp,\n961\t                &prefs as *const LZ4F_preferences_t,\n962\t            );\n963\t            assert_eq!(ret_str(c), ret_str(r), \"writeOpen(NULL statePtr)\");\n964\t            assert_eq!(lz4f_error_code(c), err::ERROR_parameter_null);\n965\t            fclose(fp);\n966\t        }\n967\t        {\n968\t            let mut cst: *mut c_void = std::ptr::null_mut();\n969\t            let mut rst: *mut c_void = std::ptr::null_mut();\n970\t            let c = (a.c.write_open)(\n971\t                &mut cst,\n972\t                std::ptr::null_mut(),\n973\t                &prefs as *const LZ4F_preferences_t,\n974\t            );\n975\t            let r = (a.r.write_open)(\n976\t                &mut rst,\n977\t                std::ptr::null_mut(),\n978\t                &prefs as *const LZ4F_preferences_t,\n979\t            );\n980\t            assert_eq!(ret_str(c), ret_str(r), \"writeOpen(NULL fp)\");\n981\t            assert_eq!(lz4f_error_code(c), err::ERROR_parameter_null);\n982\t            assert!(cst.is_null() && rst.is_null());\n983\t        }\n984\t        // readOpen(NULL, fp) / readOpen(&st, NULL)\n985\t        {\n986\t            let fp = t.open(\"rb\");\n987\t            let c = (a.c.read_open)(std::ptr::null_mut(), fp);\n988\t            let r = (a.r.read_open)(std::ptr::null_mut(), fp);\n989\t            assert_eq!(ret_str(c), ret_str(r), \"readOpen(NULL statePtr)\");\n990\t            assert_eq!(lz4f_error_code(c), err::ERROR_parameter_null);\n991\t            fclose(fp);\n992\t        }\n993\t        {\n994\t            let mut cst: *mut c_void = std::ptr::null_mut();\n995\t            let mut rst: *mut c_void = std::ptr::null_mut();\n996\t            let c = (a.c.read_open)(&mut cst, std::ptr::null_mut());\n997\t            let r = (a.r.read_open)(&mut rst, std::ptr::null_mut());\n998\t            assert_eq!(ret_str(c), ret_str(r), \"readOpen(NULL fp)\");\n999\t            assert_eq!(lz4f_error_code(c), err::ERROR_parameter_null);\n1000\t        }\n1001\t        // write / read / close with NULL state or NULL buffer\n1002\t        {\n1003\t            let mut b = [0u8; 32];\n1004\t            for &size in &[0usize, 1, 32] {\n1005\t                let c = (a.c.write)(std::ptr::null_mut(), b.as_ptr() as *const c_void, size);\n1006\t                let r = (a.r.write)(std::ptr::null_mut(), b.as_ptr() as *const c_void, size);\n1007\t                assert_eq!(ret_str(c), ret_str(r), \"write(NULL state, {})\", size);\n1008\t                assert_eq!(lz4f_error_code(c), err::ERROR_parameter_null);\n1009\t\n1010\t                let c = (a.c.read)(std::ptr::null_mut(), b.as_mut_ptr() as *mut c_void, size);\n1011\t                let r = (a.r.read)(std::ptr::null_mut(), b.as_mut_ptr() as *mut c_void, size);\n1012\t                assert_eq!(ret_str(c), ret_str(r), \"read(NULL state, {})\", size);\n1013\t                assert_eq!(lz4f_error_code(c), err::ERROR_parameter_null);\n1014\t            }\n1015\t            let c = (a.c.write_close)(std::ptr::null_mut());\n1016\t            let r = (a.r.write_close)(std::ptr::null_mut());\n1017\t            assert_eq!(ret_str(c), ret_str(r), \"writeClose(NULL)\");\n1018\t            assert_eq!(lz4f_error_code(c), err::ERROR_parameter_null);\n1019\t\n1020\t            let c = (a.c.read_close)(std::ptr::null_mut());\n1021\t            let r = (a.r.read_close)(std::ptr::null_mut());\n1022\t            assert_eq!(ret_str(c), ret_str(r), \"readClose(NULL)\");\n1023\t            assert_eq!(lz4f_error_code(c), err::ERROR_parameter_null);\n1024\t        }\n1025\t        // NULL buffer with a *valid* state\n1026\t        {\n1027\t            let tw = TmpFile::new(\"err_nullbuf_w\");\n1028\t            for f in [&a.c, &a.r] {\n1029\t                let fp = tw.open(\"wb\");\n1030\t                let mut st: *mut c_void = std::ptr::null_mut();\n1031\t                let o = (f.write_open)(&mut st, fp, &prefs as *const LZ4F_preferences_t);\n1032\t                assert!(!lz4f_is_error(o));\n1033\t                let w = (f.write)(st, std::ptr::null(), 16);\n1034\t                assert_eq!(\n1035\t                    lz4f_error_code(w),\n1036\t                    err::ERROR_parameter_null,\n1037\t                    \"{}: write(state, NULL buf)\",\n1038\t                    f.tag\n1039\t                );\n1040\t                let _ = (f.write_close)(st);\n1041\t                fclose(fp);\n1042\t            }\n1043\t            let tr2 = TmpFile::new(\"err_nullbuf_r\");\n1044\t            tr2.put(&good);\n1045\t            for f in [&a.c, &a.r] {\n1046\t                let fp = tr2.open(\"rb\");\n1047\t                let mut st: *mut c_void = std::ptr::null_mut();\n1048\t                let o = (f.read_open)(&mut st, fp);\n1049\t                assert!(!lz4f_is_error(o));\n1050\t                let n = (f.read)(st, std::ptr::null_mut(), 16);\n1051\t                assert_eq!(\n1052\t                    lz4f_error_code(n),\n1053\t                    err::ERROR_parameter_null,\n1054\t                    \"{}: read(state, NULL buf)\",\n1055\t                    f.tag\n1056\t                );\n1057\t                let _ = (f.read_close)(st);\n1058\t                fclose(fp);\n1059\t            }\n1060\t        }\n1061\t\n1062\t        // ---- writeOpen with an invalid blockSizeID -------------------------\n1063\t        for &bsid in &[-3i32, -1, 1, 2, 3, 8, 9, 100] {\n1064\t            let p = prefs_of(bsid, LZ4F_blockLinked, 0, 0, 0, 0, 0, 0);\n1065\t            let tc = TmpFile::new(\"err_bsid_c\");\n1066\t            let tr = TmpFile::new(\"err_bsid_r\");\n1067\t            let lc = run_write(&a.c, &tc, \"wb\", Some(&p), &[&data[..]]);\n1068\t            let lr = run_write(&a.r, &tr, \"wb\", Some(&p), &[&data[..]]);\n1069\t            assert_eq!(\n1070\t                ret_str(lc.open_ret),\n1071\t                ret_str(lr.open_ret),\n1072\t                \"writeOpen(blockSizeID={})\",\n1073\t                bsid\n1074\t            );\n1075\t            assert_eq!(\n1076\t                lz4f_error_code(lc.open_ret),\n1077\t                err::ERROR_maxBlockSize_invalid,\n1078\t                \"writeOpen(blockSizeID={}) should be maxBlockSize_invalid\",\n1079\t                bsid\n1080\t            );\n1081\t            assert!(lc.state_null_after_open && lr.state_null_after_open);\n1082\t            assert_eq!(\n1083\t                ret_str(lc.close_ret),\n1084\t                ret_str(lr.close_ret),\n1085\t                \"writeClose after failed writeOpen(blockSizeID={})\",\n1086\t                bsid\n1087\t            );\n1088\t            assert_eq!(lc.file.len(), 0, \"nothing should have been written\");\n1089\t            assert_eq!(lr.file.len(), 0, \"nothing should have been written\");\n1090\t        }\n1091\t\n1092\t        // ---- writeOpen / write into a READ-ONLY FILE* => io_write ----------\n1093\t        {\n1094\t            let t = TmpFile::new(\"err_ro\");\n1095\t            t.put(&good); // make sure the file exists so \"rb\" succeeds\n1096\t            let lc = run_write(&a.c, &t, \"rb\", Some(&prefs), &[&data[..]]);\n1097\t            let t2 = TmpFile::new(\"err_ro2\");\n1098\t            t2.put(&good);\n1099\t            let lr = run_write(&a.r, &t2, \"rb\", Some(&prefs), &[&data[..]]);\n1100\t            assert_eq!(\n1101\t                ret_str(lc.open_ret),\n1102\t                ret_str(lr.open_ret),\n1103\t                \"writeOpen on a read-only FILE*\"\n1104\t            );\n1105\t            assert_eq!(\n1106\t                lz4f_error_code(lc.open_ret),\n1107\t                err::ERROR_io_write,\n1108\t                \"writeOpen on a read-only FILE* must be io_write\"\n1109\t            );\n1110\t            assert_eq!(\n1111\t                lc.state_null_after_open, lr.state_null_after_open,\n1112\t                \"state NULLness after the io_write failure\"\n1113\t            );\n1114\t            assert_eq!(\n1115\t                ret_str(lc.close_ret),\n1116\t                ret_str(lr.close_ret),\n1117\t                \"writeClose after the io_write failure\"\n1118\t            );\n1119\t        }\n1120\t\n1121\t        // ---- readOpen on files that are too short / not frames -------------\n1122\t        for n in 0..=19usize {\n1123\t            let mut f = good.clone();\n1124\t            f.truncate(n);\n1125\t            let label = format!(\"readOpen on a {}-byte file\", n);\n1126\t            let tc = TmpFile::new(\"err_short_c\");\n1127\t            let tr = TmpFile::new(\"err_short_r\");\n1128\t            tc.put(&f);\n1129\t            tr.put(&f);\n1130\t            let lc = run_read(&a.c, &tc, &[64], 4096);\n1131\t            let lr = run_read(&a.r, &tr, &[64], 4096);\n1132\t            assert_eq!(\n1133\t                ret_str(lc.open_ret),\n1134\t                ret_str(lr.open_ret),\n1135\t                \"{}: readOpen\",\n1136\t                label\n1137\t            );\n1138\t            assert_eq!(\n1139\t                lc.state_null_after_open, lr.state_null_after_open,\n1140\t                \"{}: state NULLness\",\n1141\t                label\n1142\t            );\n1143\t            assert_eq!(\n1144\t                lc.read_rets.iter().map(|r| ret_str(*r)).collect::<Vec<_>>(),\n1145\t                lr.read_rets.iter().map(|r| ret_str(*r)).collect::<Vec<_>>(),\n1146\t                \"{}: read returns\",\n1147\t                label\n1148\t            );\n1149\t            assert_eq!(\n1150\t                ret_str(lc.close_ret),\n1151\t                ret_str(lr.close_ret),\n1152\t                \"{}: readClose\",\n1153\t                label\n1154\t            );\n1155\t            assert_bytes_eq(&format!(\"{}: buffer\", label), &lc.buf, &lr.buf);\n1156\t            if n < 19 {\n1157\t                assert_eq!(\n1158\t                    lz4f_error_code(lc.open_ret),\n1159\t                    err::ERROR_io_read,\n1160\t                    \"{}: a file shorter than LZ4F_HEADER_SIZE_MAX must be io_read\",\n1161\t                    label\n1162\t                );\n1163\t            }\n1164\t        }\n1165\t\n1166\t        // garbage / not-a-frame inputs of >= 19 bytes\n1167\t        let mut bad_inputs: Vec<(String, Vec<u8>)> = Vec::new();\n1168\t        for i in 0..30 {\n1169\t            let n = 19 + (i * 13) % 200;\n1170\t            bad_inputs.push((format!(\"garbage #{} ({}B)\", i, n), gen_random(&mut rng, n)));\n1171\t        }\n1172\t        for &delta in &[1u32, 0x10, 0x1000] {\n1173\t            let mut f = good.clone();\n1174\t            let m = u32::from_le_bytes([f[0], f[1], f[2], f[3]]).wrapping_add(delta);\n1175\t            f[..4].copy_from_slice(&m.to_le_bytes());\n1176\t            bad_inputs.push((format!(\"bad magic +{:#x}\", delta), f));\n1177\t        }\n1178\t        {\n1179\t            let mut f = good.clone();\n1180\t            f[4] |= 0x02;\n1181\t            bad_inputs.push((\"FLG reserved bit\".into(), f));\n1182\t        }\n1183\t        for &v in &[0u8, 2, 3] {\n1184\t            let mut f = good.clone();\n1185\t            f[4] = (f[4] & 0x3F) | (v << 6);\n1186\t            bad_inputs.push((format!(\"FLG version={}\", v), f));\n1187\t        }\n1188\t        for &bd in &[0x00u8, 0x10, 0x20, 0x30, 0x80] {\n1189\t            let mut f = good.clone();\n1190\t            f[5] = bd;\n1191\t            bad_inputs.push((format!(\"BD={:#04x}\", bd), f));\n1192\t        }\n1193\t        {\n1194\t            let mut f = good.clone();\n1195\t            f[6] ^= 0xFF; // header checksum byte for a 7-byte header\n1196\t            bad_inputs.push((\"bad header checksum\".into(), f));\n1197\t        }\n1198\t        {\n1199\t            // corrupt block payload -> LZ4F_read must surface the decode error\n1200\t            let mut f = good.clone();\n1201\t            f[30] ^= 0xFF;\n1202\t            bad_inputs.push((\"corrupt payload\".into(), f));\n1203\t        }\n1204\t        {\n1205\t            // corrupt the trailing content checksum\n1206\t            let mut f = good.clone();\n1207\t            let n = f.len();\n1208\t            f[n - 2] ^= 0xFF;\n1209\t            bad_inputs.push((\"corrupt content checksum\".into(), f));\n1210\t        }\n1211\t        for &t in &[20usize, 25, 40, 100, 1000, 5000] {\n1212\t            if t < good.len() {\n1213\t                bad_inputs.push((format!(\"truncated frame to {}\", t), good[..t].to_vec()));\n1214\t            }\n1215\t        }\n1216\t\n1217\t        for (name, f) in &bad_inputs {\n1218\t            for &plan in &[&[16usize][..], &[1][..], &[1 << 20][..]] {\n1219\t                let label = format!(\"readOpen/read [{}] plan={:?}\", name, plan);\n1220\t                let tc = TmpFile::new(\"err_bad_c\");\n1221\t                let tr = TmpFile::new(\"err_bad_r\");\n1222\t                tc.put(f);\n1223\t                tr.put(f);\n1224\t                let lc = run_read(&a.c, &tc, plan, 64 * 1024);\n1225\t                let lr = run_read(&a.r, &tr, plan, 64 * 1024);\n1226\t                assert_eq!(\n1227\t                    ret_str(lc.open_ret),\n1228\t                    ret_str(lr.open_ret),\n1229\t                    \"{}: readOpen\",\n1230\t                    label\n1231\t                );\n1232\t                assert_eq!(\n1233\t                    lc.state_null_after_open, lr.state_null_after_open,\n1234\t                    \"{}: state NULLness\",\n1235\t                    label\n1236\t                );\n1237\t                assert_eq!(\n1238\t                    lc.read_rets.iter().map(|r| ret_str(*r)).collect::<Vec<_>>(),\n1239\t                    lr.read_rets.iter().map(|r| ret_str(*r)).collect::<Vec<_>>(),\n1240\t                    \"{}: read returns\",\n1241\t                    label\n1242\t                );\n1243\t                assert_eq!(\n1244\t                    ret_str(lc.close_ret),\n1245\t                    ret_str(lr.close_ret),\n1246\t                    \"{}: readClose\",\n1247\t                    label\n1248\t                );\n1249\t                assert_eq!(lc.produced, lr.produced, \"{}: produced\", label);\n1250\t                assert_bytes_eq(&format!(\"{}: buffer\", label), &lc.buf, &lr.buf);\n1251\t            }\n1252\t        }\n1253\t\n1254\t        // randomly mutated frames\n1255\t        for iter in 0..2500u32 {\n1256\t            let mut f = good.clone();\n1257\t            let nmut = 1 + (iter as usize % 4);\n1258\t            for _ in 0..nmut {\n1259\t                let i = rng.below(f.len());\n1260\t                f[i] ^= 1u8 << rng.below(8);\n1261\t            }\n1262\t            if iter % 4 == 0 {\n1263\t                let cut = rng.range(0, f.len());\n1264\t                f.truncate(cut);\n1265\t            }\n1266\t            let plan = [rng.range(1, 40_000)];\n1267\t            let label = format!(\"read fuzz iter={} nmut={} plan={:?}\", iter, nmut, plan);\n1268\t            let tc = TmpFile::new(\"err_fuzz_c\");\n1269\t            let tr = TmpFile::new(\"err_fuzz_r\");\n1270\t            tc.put(&f);\n1271\t            tr.put(&f);\n1272\t            let lc = run_read(&a.c, &tc, &plan, 128 * 1024);\n1273\t            let lr = run_read(&a.r, &tr, &plan, 128 * 1024);\n1274\t            assert_eq!(\n1275\t                ret_str(lc.open_ret),\n1276\t                ret_str(lr.open_ret),\n1277\t                \"{}: readOpen\",\n1278\t                label\n1279\t            );\n1280\t            assert_eq!(\n1281\t                lc.read_rets.iter().map(|r| ret_str(*r)).collect::<Vec<_>>(),\n1282\t                lr.read_rets.iter().map(|r| ret_str(*r)).collect::<Vec<_>>(),\n1283\t                \"{}: read returns\",\n1284\t                label\n1285\t            );\n1286\t            assert_eq!(\n1287\t                ret_str(lc.close_ret),\n1288\t                ret_str(lr.close_ret),\n1289\t                \"{}: readClose\",\n1290\t                label\n1291\t            );\n1292\t            assert_eq!(lc.produced, lr.produced, \"{}: produced\", label);\n1293\t            assert_bytes_eq(&format!(\"{}: buffer\", label), &lc.buf, &lr.buf);\n1294\t        }\n1295\t    }\n1296\t}\n1297\t\n1298\t// ===========================================================================\n1299\t// 8. harness self-check: the comparison logic really does detect divergence\n1300\t// ===========================================================================\n1301\t\n1302\t#[test]\n1303\t#[should_panic(expected = \"SELFCHECK\")]\n1304\tfn harness_self_check_detects_divergence() {\n1305\t    let mut rng = Rng::new(0xF11E_5E1F);\n1306\t    let data = gen_shape(&mut rng, 3, 5000);\n1307\t    let prefs = prefs_of(4, LZ4F_blockLinked, 1, 1, 0, 0, 0, 1);\n1308\t    let good = c_compress_frame(&data, &prefs);\n1309\t    let mut bad = good.clone();\n1310\t    bad[40] ^= 0xFF;\n1311\t\n1312\t    let a = api();\n1313\t    let tc = TmpFile::new(\"selfcheck_c\");\n1314\t    let tr = TmpFile::new(\"selfcheck_r\");\n1315\t    tc.put(&good);\n1316\t    tr.put(&bad); // deliberately different input for the Rust side\n1317\t    let lc = run_read(&a.c, &tc, &[4096], data.len() + 64);\n1318\t    let lr = run_read(&a.r, &tr, &[4096], data.len() + 64);\n1319\t    assert_eq!(\n1320\t        lc.read_rets.iter().map(|r| ret_str(*r)).collect::<Vec<_>>(),\n1321\t        lr.read_rets.iter().map(|r| ret_str(*r)).collect::<Vec<_>>(),\n1322\t        \"SELFCHECK read returns\"\n1323\t    );\n1324\t    assert_bytes_eq(\"SELFCHECK buffer\", &lc.buf, &lr.buf);\n1325\t}\n1326\t\n1327\t// ===========================================================================\n1328\t// 9. LZ4F_readOpen sizes its src buffer from the FIRST frame header only, so a\n1329\t//    later frame with a much larger blockSizeID must still stream correctly.\n1330\t//    A leading skippable frame makes LZ4F_readOpen fall into its\n1331\t//    `LZ4F_default` case (frameInfo.blockSizeID == 0 => 64 KB src buffer).\n1332\t// ===========================================================================\n1333\t\n1334\t#[test]\n1335\tfn read_src_buffer_sizing_across_frames() {\n1336\t    let mut rng = Rng::new(0xF11E_0009);\n1337\t\n1338\t    // (first frame bsid, second frame bsid)\n1339\t    for &(b1, b2) in &[\n1340\t        (4i32, 7i32),\n1341\t        (4, 6),\n1342\t        (4, 5),\n1343\t        (7, 4),\n1344\t        (6, 5),\n1345\t        (5, 7),\n1346\t    ] {\n1347\t        let d1 = gen_shape(&mut rng, 2, 30_000);\n1348\t        let d2 = gen_shape(&mut rng, 5, 400_000);\n1349\t        let p1 = prefs_of(b1, LZ4F_blockLinked, 1, 1, d1.len() as u64, 0, 0, 1);\n1350\t        let p2 = prefs_of(b2, LZ4F_blockIndependent, 1, 0, 0, 0, 0, 1);\n1351\t        let mut cat = c_compress_frame(&d1, &p1);\n1352\t        cat.extend_from_slice(&c_compress_frame(&d2, &p2));\n1353\t        let mut expect = d1.clone();\n1354\t        expect.extend_from_slice(&d2);\n1355\t        for &plan in &[&[7usize][..], &[4096][..], &[1 << 20][..], &[3, 70_000][..]] {\n1356\t            let label = format!(\"srcbuf-sizing b1={} b2={} plan={:?}\", b1, b2, plan);\n1357\t            expect_readback(&cat, plan, &expect, \"sbs\", &label);\n1358\t        }\n1359\t    }\n1360\t\n1361\t    // leading skippable frame => frameInfo.blockSizeID stays 0 (LZ4F_default)\n1362\t    for &bsid in &[4i32, 5, 6, 7] {\n1363\t        let data = gen_shape(&mut rng, 4, 300_000);\n1364\t        let prefs = prefs_of(bsid, LZ4F_blockLinked, 1, 1, data.len() as u64, 0, 0, 1);\n1365\t        let mut cat = skippable_frame(0x184D_2A50, &gen_random(&mut rng, 1000));\n1366\t        cat.extend_from_slice(&c_compress_frame(&data, &prefs));\n1367\t        for &plan in &[&[19usize][..], &[4096][..], &[1 << 20][..]] {\n1368\t            let label = format!(\"srcbuf-default bsid={} plan={:?}\", bsid, plan);\n1369\t            expect_readback(&cat, plan, &data, \"sbd\", &label);\n1370\t        }\n1371\t    }\n1372\t\n1373\t    // three frames with alternating options through one reader\n1374\t    let mut cat = Vec::new();\n1375\t    let mut expect = Vec::new();\n1376\t    for k in 0..3usize {\n1377\t        let d = gen_shape(&mut rng, k, 50_000 * (k + 1));\n1378\t        let p = prefs_of(\n1379\t            [4i32, 6, 5][k],\n1380\t            if k % 2 == 0 {\n1381\t                LZ4F_blockLinked\n1382\t            } else {\n1383\t                LZ4F_blockIndependent\n1384\t            },\n1385\t            (k % 2) as c_int,\n1386\t            ((k + 1) % 2) as c_int,\n1387\t            if k == 1 { d.len() as u64 } 