= pIn.wrapping_add(STEPSIZE);\n380\t            pMatch = pMatch.wrapping_add(STEPSIZE);\n381\t            continue;\n382\t        }\n383\t        pIn = pIn.wrapping_add(LZ4_NbCommonBytes(diff) as usize);\n384\t        return (pIn as usize).wrapping_sub(pStart as usize) as u32;\n385\t    }\n386\t\n387\t    if (pIn < pInLimit.wrapping_sub(3)) && (LZ4_read32(pMatch) == LZ4_read32(pIn)) {\n388\t        pIn = pIn.wrapping_add(4);\n389\t        pMatch = pMatch.wrapping_add(4);\n390\t    }\n391\t    if (pIn < pInLimit.wrapping_sub(1)) && (LZ4_read16(pMatch) == LZ4_read16(pIn)) {\n392\t        pIn = pIn.wrapping_add(2);\n393\t        pMatch = pMatch.wrapping_add(2);\n394\t    }\n395\t    if (pIn < pInLimit) && (*pMatch == *pIn) {\n396\t        pIn = pIn.wrapping_add(1);\n397\t    }\n398\t    (pIn as usize).wrapping_sub(pStart as usize) as u32\n399\t}\n400\t\n401\t/* pointer distance helpers -------------------------------------- */\n402\t\n403\t#[inline(always)]\n404\tpub fn pdiff<T>(a: *const T, b: *const T) -> usize {\n405\t    (a as usize).wrapping_sub(b as usize)\n406\t}\n407\t\n408\t#[inline(always)]\n409\tpub fn pdiff_i<T>(a: *const T, b: *const T) -> isize {\n410\t    (a as isize).wrapping_sub(b as isize)\n411\t}\n412\t"}]},"parent_tool_use_id":"toolu_bdrk_01HhghTocUcLcToJsT8dsA6c","session_id":"5bf83431-1376-4c81-bcb4-7fd267eb113b","uuid":"c9bc4937-bafe-4f8c-b405-3868cb6a30e1","timestamp":"2026-08-23T08:13:31.314Z","subagent_type":"general-purpose","task_description":"Write xxhash differential tests"}
