electedIn) as usize;\n2535\t                    (*dctx).frameInfo.contentSize = SFrameSize as u64;\n2536\t                    (*dctx).tmpInTarget = SFrameSize;\n2537\t                    (*dctx).dStage = dstage_skipSkippable;\n2538\t                    break 'sw;\n2539\t                }\n2540\t            }\n2541\t\n2542\t            if pos == dstage_skipSkippable {\n2543\t                let skipSize: usize = MIN_usize((*dctx).tmpInTarget, pdiff(srcEnd, srcPtr));\n2544\t                srcPtr = srcPtr.wrapping_add(skipSize);\n2545\t                (*dctx).tmpInTarget -= skipSize;\n2546\t                doAnotherStage = 0;\n2547\t                nextSrcSizeHint = (*dctx).tmpInTarget;\n2548\t                if nextSrcSizeHint != 0 {\n2549\t                    break 'sw; /* still more to skip */\n2550\t                }\n2551\t                /* frame fully skipped : prepare context for a new frame */\n2552\t                LZ4F_resetDecompressionContext(dctx);\n2553\t                break 'sw;\n2554\t            }\n2555\t\n2556\t            /* unreachable */\n2557\t            break 'sw;\n2558\t        }\n2559\t    }\n2560\t\n2561\t    /* preserve history within tmpOut whenever necessary */\n2562\t    if ((*dctx).frameInfo.blockMode == LZ4F_blockLinked)\n2563\t        && ((*dctx).dict != (*dctx).tmpOutBuffer as *const u8)\n2564\t        && (!(*dctx).dict.is_null())\n2565\t        && ((*decompressOptionsPtr).stableDst == 0)\n2566\t        && (((*dctx).dStage as u32).wrapping_sub(2) < (dstage_getSuffix as u32).wrapping_sub(2))\n2567\t    {\n2568\t        if (*dctx).dStage == dstage_flushOut {\n2569\t            let preserveSize: usize =\n2570\t                pdiff((*dctx).tmpOut as *const u8, (*dctx).tmpOutBuffer as *const u8);\n2571\t            let mut copySize: usize = (64 * 1024usize).wrapping_sub((*dctx).tmpOutSize);\n2572\t            let oldDictEnd: *const u8 = (*dctx)\n2573\t                .dict\n2574\t                .wrapping_add((*dctx).dictSize)\n2575\t                .wrapping_sub((*dctx).tmpOutStart);\n2576\t            if (*dctx).tmpOutSize > 64 * 1024 {\n2577\t                copySize = 0;\n2578\t            }\n2579\t            if copySize > preserveSize {\n2580\t                copySize = preserveSize;\n2581\t            }\n2582\t\n2583\t            memcpy(\n2584\t                (*dctx)\n2585\t                    .tmpOutBuffer\n2586\t                    .wrapping_add(preserveSize)\n2587\t                    .wrapping_sub(copySize),\n2588\t                oldDictEnd.wrapping_sub(copySize),\n2589\t                copySize,\n2590\t            );\n2591\t\n2592\t            (*dctx).dict = (*dctx).tmpOutBuffer as *const u8;\n2593\t            (*dctx).dictSize = preserveSize + (*dctx).tmpOutStart;\n2594\t        } else {\n2595\t            let oldDictEnd: *const u8 = (*dctx).dict.wrapping_add((*dctx).dictSize);\n2596\t            let newDictSize: usize = MIN_usize((*dctx).dictSize, 64 * 1024);\n2597\t\n2598\t            memcpy(\n2599\t                (*dctx).tmpOutBuffer,\n2600\t                oldDictEnd.wrapping_sub(newDictSize),\n2601\t                newDictSize,\n2602\t            );\n2603\t\n2604\t            (*dctx).dict = (*dctx).tmpOutBuffer as *const u8;\n2605\t            (*dctx).dictSize = newDictSize;\n2606\t            (*dctx).tmpOut = (*dctx).tmpOutBuffer.wrapping_add(newDictSize);\n2607\t        }\n2608\t    }\n2609\t\n2610\t    *srcSizePtr = pdiff(srcPtr, srcStart);\n2611\t    *dstSizePtr = pdiff(dstPtr, dstStart);\n2612\t    nextSrcSizeHint\n2613\t}\n2614\t\n2615\t#[unsafe(no_mangle)]\n2616\tpub unsafe extern \"C\" fn LZ4F_decompress_usingDict(\n2617\t    dctx: *mut LZ4F_dctx,\n2618\t    dstBuffer: *mut c_void,\n2619\t    dstSizePtr: *mut usize,\n2620\t    srcBuffer: *const c_void,\n2621\t    srcSizePtr: *mut usize,\n2622\t    dict: *const c_void,\n2623\t    dictSize: usize,\n2624\t    decompressOptionsPtr: *const LZ4F_decompressOptions_t,\n2625\t) -> usize {\n2626\t    if (*dctx).dStage <= dstage