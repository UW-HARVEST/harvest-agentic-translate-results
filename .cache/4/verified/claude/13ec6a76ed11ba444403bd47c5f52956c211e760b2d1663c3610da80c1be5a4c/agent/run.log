f_is_error(n), \"{}: begin err {}\", which, lz4f_error_code(n));\n\n        let mut rng = Rng::new(0xD1A6);\n        for (i, op) in plan.iter().enumerate() {\n            let (sz, is_unc, is_flush) = match *op {\n                Op::Upd(n) => (n, false, false),\n                Op::Unc(n) => (n, true, false),\n                Op::Flush => (0, false, true),\n            };\n            let src = gen_shape(&mut rng, i % N_SHAPES, sz);\n            let cap = bound(sz, prefs).max(sz) + 16;\n            let mut buf = vec![0xAAu8; cap];\n            eprintln!(\"  {} step {} {:?} cap={}\", which, i, op, cap);\n            let r = if is_flush {\n                flush(ctx, buf.as_mut_ptr() as *mut c_void, cap, ptr::null())\n            } else if is_unc {\n                unc(ctx, buf.as_mut_ptr() as *mut c_void, cap,\n                    src.as_ptr() as *const c_void, sz, ptr::null())\n            } else {\n                upd(ctx, buf.as_mut_ptr() as *mut c_void, cap,\n                    src.as_ptr() as *const c_void, sz, ptr::null())\n            };\n            eprintln!(\"    -> ret={} (err={})\", r as i64, lz4f_error_code(r));\n        }\n        free(ctx);\n        eprintln!(\"  {} plan finished cleanly\", which);\n    }\n}\n\nfn plans(bs: usize) -> Vec<(&'static str, Vec<Op>)> {\n    vec![\n        (\"unc-only\",     vec![Op::Unc(bs), Op::Unc(bs), Op::Unc(777)]),\n        (\"upd-then-unc\", vec![Op::Upd(1000), Op::Unc(2000), Op::Unc(10)]),\n        (\"unc-then-upd\", vec![Op::Unc(1000), Op::Upd(2000), Op::Upd(10)]),\n        (\"alternating\",  vec![Op::Upd(bs - 10), Op::Unc(20), Op::Upd(30),\n                              Op::Unc(bs), Op::Upd(5), Op::Flush, Op::Unc(5)]),\n        (\"unc-zeros\",    vec![Op::Unc(0), Op::Unc(100), Op::Unc(0), Op::Upd(0), Op::Unc(100)]),\n        (\"unc-flush\",    vec![Op::Unc(500), Op::Flush, Op::Flush, Op::Unc(500), Op::Flush]),\n    ]\n}\n\n#[test]\nfn bisect_c_side() {\n    let bs = 65536usize;\n    for af in [0u32, 1] {\n        for (name, plan) in plans(bs) {\n            let mut p = LZ4F_preferences_t::default();\n            p.frameInfo.blockSizeID = LZ4F_max64KB;\n            p.frameInfo.blockMode = LZ4F_blockIndependent;\n            p.compressionLevel = 1;\n            p.autoFlush = af;\n            eprintln!(\"=== C plan '{}' autoFlush={} ===\", name, af);\n            run(\"C\", &p, &plan);\n        }\n    }\n}\n\n#[test]\nfn bisect_rust_side() {\n    let bs = 65536usize;\n    for af in [0u32, 1] {\n        for (name, plan) in plans(bs) {\n            let mut p = LZ4F_preferences_t::default();\n            p.frameInfo.blockSizeID = LZ4F_max64KB;\n            p.frameInfo.blockMode = LZ4F_blockIndependent;\n            p.compressionLevel = 1;\n            p.autoFlush = af;\n            eprintln!(\"=== Rust plan '{}' autoFlush={} ===\", name, af);\n            run(\"Rust\", &p, &plan);\n        }\n    }\n}\nEOF\ntimeout 300 cargo test --release --offline --test diag_unc bisect_c_side -- --exact --nocapture 2>&1 | grep -E '^===|plan finished|step|-> ret|corrupted|Abort|error:' | tail -40","description":"Bisect the C side"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2723,"cache_read_input_tokens":293749,"cache_creation":{"ephemeral_5m_input_tokens":2723,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"5bf83431-1376-4c81-bcb4-7fd267eb113b","uuid":"061a0ab4-6c44-4017-b088-a7989908ccd9","timestamp":"2026-08-23T09:01:41.255Z"}
