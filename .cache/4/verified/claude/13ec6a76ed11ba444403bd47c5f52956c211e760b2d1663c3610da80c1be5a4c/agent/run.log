{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01WX3RbgAnxR1yVDqwSpRxoi","type":"tool_result","content":"1\t//! Translation of xxhash.c (xxHash 0.6.5), namespaced with `XXH_NAMESPACE=LZ4_`.\n2\t//!\n3\t//! On x86_64 `XXH_FORCE_ALIGN_CHECK` is 0 and the CPU is little endian, so all\n4\t//! reads go through the unaligned + little-endian path.\n5\t\n6\tuse crate::common::{calloc, free, malloc, memcpy, memset};\n7\tuse core::ffi::c_void;\n8\tuse core::ptr;\n9\t\n10\tpub const XXH_VERSION_MAJOR: u32 = 0;\n11\tpub const XXH_VERSION_MINOR: u32 = 6;\n12\tpub const XXH_VERSION_RELEASE: u32 = 5;\n13\tpub const XXH_VERSION_NUMBER: u32 =\n14\t    XXH_VERSION_MAJOR * 100 * 100 + XXH_VERSION_MINOR * 100 + XXH_VERSION_RELEASE;\n15\t\n16\t/* XXH_errorcode */\n17\tpub const XXH_OK: i32 = 0;\n18\tpub const XXH_ERROR: i32 = 1;\n19\t\n20\t#[repr(C)]\n21\t#[derive(Clone, Copy)]\n22\tpub struct XXH32_state_t {\n23\t    pub total_len_32: u32,\n24\t    pub large_len: u32,\n25\t    pub v1: u32,\n26\t    pub v2: u32,\n27\t    pub v3: u32,\n28\t    pub v4: u32,\n29\t    pub mem32: [u32; 4],\n30\t    pub memsize: u32,\n31\t    pub reserved: u32,\n32\t}\n33\t\n34\t#[repr(C)]\n35\t#[derive(Clone, Copy)]\n36\tpub struct XXH64_state_t {\n37\t    pub total_len: u64,\n38\t    pub v1: u64,\n39\t    pub v2: u64,\n40\t    pub v3: u64,\n41\t    pub v4: u64,\n42\t    pub mem64: [u64; 4],\n43\t    pub memsize: u32,\n44\t    pub reserved: [u32; 2],\n45\t}\n46\t\n47\t#[repr(C)]\n48\tpub struct XXH32_canonical_t {\n49\t    pub digest: [u8; 4],\n50\t}\n51\t\n52\t#[repr(C)]\n53\tpub struct XXH64_canonical_t {\n54\t    pub digest: [u8; 8],\n55\t}\n56\t\n57\timpl XXH32_state_t {\n58\t    pub const fn zeroed() -> Self {\n59\t        XXH32_state_t {\n60\t            total_len_32: 0,\n61\t            large_len: 0,\n62\t            v1: 0,\n63\t            v2: 0,\n64\t            v3: 0,\n65\t            v4: 0,\n66\t            mem32: [0; 4],\n67\t            memsize: 0,\n68\t            reserved: 0,\n69\t        }\n70\t    }\n71\t}\n72\t\n73\timpl XXH64_state_t {\n74\t    pub const fn zeroed() -> Self {\n75\t        XXH64_state_t {\n76\t            total_len: 0,\n77\t            v1: 0,\n78\t            v2: 0,\n79\t            v3: 0,\n80\t            v4: 0,\n81\t            mem64: [0; 4],\n82\t            memsize: 0,\n83\t            reserved: [0; 2],\n84\t        }\n85\t    }\n86\t}\n87\t\n88\t#[inline(always)]\n89\tunsafe fn XXH_read32(p: *const u8) -> u32 {\n90\t    ptr::read_unaligned(p as *const u32)\n91\t}\n92\t#[inline(always)]\n93\tunsafe fn XXH_read64(p: *const u8) -> u64 {\n94\t    ptr::read_unaligned(p as *const u64)\n95\t}\n96\t#[inline(always)]\n97\tunsafe fn XXH_readLE32(p: *const u8) -> u32 {\n98\t    XXH_read32(p)\n99\t}\n100\t#[inline(always)]\n101\tunsafe fn XXH_readLE64(p: *const u8) -> u64 {\n102\t    XXH_read64(p)\n103\t}\n104\t#[inline(always)]\n105\tunsafe fn XXH_readBE32(p: *const u8) -> u32 {\n106\t    XXH_read32(p).swap_bytes()\n107\t}\n108\t#[inline(always)]\n109\tunsafe fn XXH_readBE64(p: *const u8) -> u64 {\n110\t    XXH_read64(p).swap_bytes()\n111\t}\n112\t\n113\t/* ============================================================== *\n114\t *  32-bit hash functions\n115\t * ============================================================== */\n116\tconst PRIME32_1: u32 = 2654435761;\n117\tconst PRIME32_2: u32 = 2246822519;\n118\tconst PRIME32_3: u32 = 3266489917;\n119\tconst PRIME32_4: u32 = 668265263;\n120\tconst PRIME32_5: u32 = 374761393;\n121\t\n122\t#[inline(always)]\n123\tfn XXH32_round(seed: u32, input: u32) -> u32 {\n124\t    let mut seed = seed.wrapping_add(input.wrapping_mul(PRIME32_2));\n125\t    seed = seed.rotate_left(13);\n126\t    seed = seed.wrapping_mul(PRIME32_1);\n127\t    seed\n128\t}\n129\t\n130\t#[inline(always)]\n131\tfn XXH32_avalanche(mut h32: u32) -> u32 {\n132\t    h32 ^= h32 >> 15;\n133\t    h32 = h32.wrapping_mul(PRIME32_2);\n134\t    h32 ^= h32 >> 13;\n135\t    h32 = h32.wrapping_mul(PRIME32_3);\n136\t    h32 ^= h32 >> 16;\n137\t    h32\n138\t}\n139\t\n140\tunsafe fn XXH32_finalize(mut h32: u32, ptr_in: *const u8, len: usize) -> u32 {\n141\t    let mut p = ptr_in;\n142\t    let n = len & 15;\n143\t    let n4 = n / 4;\n144\t    let n1 = n % 4;\n145\t\n146\t    for _ in 0..n4 {\n147\t        /* PROCESS4 */\n148\t        h32 = h32.wrapping_add(XXH_readLE32(p).wrapping_mul(PRIME32_3));\n149\t        p = p.wrapping_add(4);\n150\t        h32 = h32.rotate_left(17).wrapping_mul(PRIME32_4);\n151\t    }\n152\t    for _ in 0..n1 {\n153\t        /* PROCESS1 */\n154\t        h32 = h32.wrapping_add((*p as u32).wrapping_mul(PRIME32_5));\n155\t        p = p.wrapping_add(1);\n156\t        h32 = h32.rotate_left(11).wrapping_mul(PRIME32_1);\n157\t    }\n158\t    XXH32_avalanche(h32)\n159\t}\n160\t\n161\tunsafe fn XXH32_endian_align(input: *const u8, len: usize, seed: u32) -> u32 {\n162\t    let mut p = input;\n163\t    let bEnd = p.wrapping_add(len);\n164\t    let mut h32: u32;\n165\t\n166\t    if len >= 16 {\n167\t        let limit = bEnd.wrapping_sub(15);\n168\t        let mut v1 = seed.wrapping_add(PRIME32_1).wrapping_add(PRIME32_2);\n169\t        let mut v2 = seed.wrapping_add(PRIME32_2);\n170\t        let mut v3 = seed.wrapping_add(0);\n171\t        let mut v4 = seed.wrapping_sub(PRIME32_1);\n172\t\n173\t        loop {\n174\t            v1 = XXH32_round(v1, XXH_readLE32(p));\n175\t            p = p.wrapping_add(4);\n176\t            v2 = XXH32_round(v2, XXH_readLE32(p));\n177\t            p = p.wrapping_add(4);\n178\t            v3 = XXH32_round(v3, XXH_readLE32(p));\n179\t            p = p.wrapping_add(4);\n180\t            v4 = XXH32_round(v4, XXH_readLE32(p));\n181\t            p = p.wrapping_add(4);\n182\t            if !(p < limit) {\n183\t                break;\n184\t            }\n185\t        }\n186\t\n187\t        h32 = v1\n188\t            .rotate_left(1)\n189\t            .wrapping_add(v2.rotate_left(7))\n190\t            .wrapping_add(v3.rotate_left(12))\n191\t            .wrapping_add(v4.rotate_left(18));\n192\t    } else {\n193\t        h32 = seed.wrapping_add(PRIME32_5);\n194\t    }\n195\t\n196\t    h32 = h32.wrapping_add(len as u32);\n197\t\n198\t    XXH32_finalize(h32, p, len & 15)\n199\t}\n200\t\n201\t#[inline]\n202\tpub unsafe fn xxh32(input: *const u8, len: usize, seed: u32) -> u32 {\n203\t    XXH32_endian_align(input, len, seed)\n204\t}\n205\t\n206\t#[unsafe(no_mangle)]\n207\tpub unsafe extern \"C\" fn LZ4_XXH_versionNumber() -> u32 {\n208\t    XXH_VERSION_NUMBER\n209\t}\n210\t\n211\t#[unsafe(no_mangle)]\n212\tpub unsafe extern \"C\" fn LZ4_XXH32(input: *const c_void, len: usize, seed: u32) -> u32 {\n213\t    XXH32_endian_align(input as *const u8, len, seed)\n214\t}\n215\t\n216\t#[unsafe(no_mangle)]\n217\tpub unsafe extern \"C\" fn LZ4_XXH32_createState() -> *mut XXH32_state_t {\n218\t    malloc(core::mem::size_of::<XXH32_state_t>()) as *mut XXH32_state_t\n219\t}\n220\t\n221\t#[unsafe(no_mangle)]\n222\tpub unsafe extern \"C\" fn LZ4_XXH32_freeState(statePtr: *mut XXH32_state_t) -> i32 {\n223\t    free(statePtr as *mut u8);\n224\t    XXH_OK\n225\t}\n226\t\n227\t#[unsafe(no_mangle)]\n228\tpub unsafe extern \"C\" fn LZ4_XXH32_copyState(\n229\t    dstState: *mut XXH32_state_t,\n230\t    srcState: *const XXH32_state_t,\n231\t) {\n232\t    memcpy(\n233\t        dstState as *mut u8,\n234\t        srcState as *const u8,\n235\t        core::mem::size_of::<XXH32_state_t>(),\n236\t    );\n237\t}\n238\t\n239\tpub unsafe fn xxh32_reset(statePtr: *mut XXH32_state_t, seed: u32) -> i32 {\n240\t    let mut state = XXH32_state_t::zeroed();\n241\t    memset(\n242\t        &mut state as *mut XXH32_state_t as *mut u8,\n243\t        0,\n244\t        core::mem::size_of::<XXH32_state_t>(),\n245\t    );\n246\t    state.v1 = seed.wrapping_add(PRIME32_1).wrapping_add(PRIME32_2);\n247\t    state.v2 = seed.wrapping_add(PRIME32_2);\n248\t    state.v3 = seed.wrapping_add(0);\n249\t    state.v4 = seed.wrapping_sub(PRIME32_1);\n250\t    /* do n