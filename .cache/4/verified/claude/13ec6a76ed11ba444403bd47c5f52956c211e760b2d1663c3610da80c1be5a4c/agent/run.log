{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01QmcrvahYsTNC2nE2HuQWXK","type":"tool_result","content":"475\t * ================================================================ */\n476\t\n477\tfn LZ4F_optimalBSID(requestedBSID: c_int, srcSize: usize) -> c_int {\n478\t    let mut proposedBSID: c_int = LZ4F_max64KB;\n479\t    let mut maxBlockSize: usize = 64 * 1024;\n480\t    /* Both operands have C type LZ4F_blockSizeID_t, an enum whose enumerators are\n481\t     * all non-negative, so its compatible type is `unsigned int`: this comparison\n482\t     * is UNSIGNED in the C. Out-of-range (negative when viewed as int) IDs\n483\t     * arriving through the ABI must therefore compare as large values. */\n484\t    while (requestedBSID as u32) > (proposedBSID as u32) {\n485\t        if srcSize <= maxBlockSize {\n486\t            return proposedBSID;\n487\t        }\n488\t        proposedBSID += 1;\n489\t        maxBlockSize <<= 2;\n490\t    }\n491\t    requestedBSID\n492\t}\n493\t\n494\tunsafe fn LZ4F_compressBound_internal(\n495\t    srcSize: usize,\n496\t    preferencesPtr: *const LZ4F_preferences_t,\n497\t    alreadyBuffered: usize,\n498\t) -> usize {\n499\t    let mut prefsNull = LZ4F_preferences_t::init();\n500\t    prefsNull.frameInfo.contentChecksumFlag = LZ4F_contentChecksumEnabled;\n501\t    prefsNull.frameInfo.blockChecksumFlag = LZ4F_blockChecksumEnabled;\n502\t    {\n503\t        let prefsPtr: *const LZ4F_preferences_t = if preferencesPtr.is_null() {\n504\t            &prefsNull as *const LZ4F_preferences_t\n505\t        } else {\n506\t            preferencesPtr\n507\t        };\n508\t        let flush: u32 = (*prefsPtr).autoFlush | ((srcSize == 0) as u32);\n509\t        let blockID: c_int = (*prefsPtr).frameInfo.blockSizeID;\n510\t        let blockSize: usize = LZ4F_getBlockSize(blockID);\n511\t        let maxBuffered: usize = blockSize.wrapping_sub(1);\n512\t        let bufferedSize: usize = MIN_usize(alreadyBuffered, maxBuffered);\n513\t        let maxSrcSize: usize = srcSize.wrapping_add(bufferedSize);\n514\t        let nbFullBlocks: u32 = (maxSrcSize / blockSize) as u32;\n515\t        let partialBlockSize: usize = maxSrcSize & (blockSize.wrapping_sub(1));\n516\t        let lastBlockSize: usize = if flush != 0 { partialBlockSize } else { 0 };\n517\t        let nbBlocks: u32 = nbFullBlocks.wrapping_add((lastBlockSize > 0) as u32);\n518\t\n519\t        /* blockChecksumFlag / contentChecksumFlag have C enum types whose\n520\t         * enumerators are all non-negative, hence a compatible type of\n521\t         * `unsigned int`: these products ZERO-extend the 32-bit field, they do not\n522\t         * sign-extend it. */\n523\t        let blockCRCSize: usize =\n524\t            BFSize.wrapping_mul((*prefsPtr).frameInfo.blockChecksumFlag as u32 as usize);\n525\t        let frameEnd: usize = BHSize.wrapping_add(\n526\t            ((*prefsPtr).frameInfo.contentChecksumFlag as u32 as usize).wrapping_mul(BFSize),\n527\t        );\n528\t\n529\t        ((BHSize + blockCRCSize).wrapping_mul(nbBlocks as usize))\n530\t            .wrapping_add(blockSize.wrapping_mul(nbFullBlocks as usize))\n531\t            .wrapping_add(lastBlockSize)\n532\t            .wrapping_add(frameEnd)\n533\t    }\n534\t}"}]},"parent_tool_use_id":"toolu_bdrk_01BFVP8uBwDpE2vBQE9jRXjX","session_id":"5bf83431-1376-4c81-bcb4-7fd267eb113b","uuid":"6e0145e2-97c6-490f-a17c-5adb886cc0dc","timestamp":"2026-08-23T08:49:06.468Z","subagent_type":"general-purpose","task_description":"lz4frame one-shot + metadata tests"}
