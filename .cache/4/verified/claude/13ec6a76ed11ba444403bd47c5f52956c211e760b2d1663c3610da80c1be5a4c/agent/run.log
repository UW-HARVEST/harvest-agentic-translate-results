e-endian helpers\n296\t * ================================================================ */\n297\t#[inline(always)]\n298\tunsafe fn LZ4F_readLE32(src: *const u8) -> u32 {\n299\t    let mut value32: u32 = *src as u32;\n300\t    value32 |= (*src.wrapping_add(1) as u32) << 8;"}]},"parent_tool_use_id":"toolu_bdrk_016UzAKZwKyMNJCsJYRtsyw8","session_id":"5bf83431-1376-4c81-bcb4-7fd267eb113b","uuid":"770b2c21-53a7-4c81-b0d6-605cc2ea5588","timestamp":"2026-08-23T08:18:27.428Z","subagent_type":"general-purpose","task_description":"Write lz4frame decompression tests"}
