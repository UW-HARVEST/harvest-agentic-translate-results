lf {\n        DecodeCfg {\n            src,\n            dst: DstPlan::Fixed(buf),\n            opts: None,\n            dict: None,\n            recycle: true,\n        }\n    }\n}''','decodecfg')\n\nrep('''    let a = api();\n    let mut out_c = vec![SENTINEL; out_len];\n    let mut out_r = vec![SENTINEL; out_len];\n\n    let opt_ptr''',\n'''    let a = api();\n    let buf_len = if cfg.recycle {\n        match cfg.dst {\n            DstPlan::All => out_len,\n            DstPlan::Fixed(n) => n.max(1),\n        }\n    } else {\n        out_len\n    };\n    let mut out_c = vec![SENTINEL; buf_len];\n    let mut out_r = vec![SENTINEL; buf_len];\n    let mut acc_c: Vec<u8> = Vec::new();\n    let mut acc_r: Vec<u8> = Vec::new();\n\n    let opt_ptr''','bufsetup')\n\nrep('''            let src_len = want.min(frame.len() - consumed);\n            let room = out_len - produced;\n            if room == 0 {\n                // The frame decoded to more than the caller predicted (only\n                // possible for deliberately corrupted frames).\n                break;\n            }\n            let dst_len = match cfg.dst {\n                DstPlan::All => room,\n                DstPlan::Fixed(n) => n.min(room),\n            };''',\n'''            let src_len = want.min(frame.len() - consumed);\n            let (off, dst_len) = if cfg.recycle {\n                assert!(\n                    produced < 512 << 20,\n                    \"{}: recycled-dst decode produced absurdly much output\",\n                    label\n                );\n                (0usize, buf_len)\n            } else {\n                let room = buf_len - produced;\n                if room == 0 {\n                    // The frame decoded to more than the caller predicted (only\n                    // possible for deliberately corrupted frames).\n                    break;\n                }\n                (\n                    produced,\n                    match cfg.dst {\n                        DstPlan::All => room,\n                        DstPlan::Fixed(n) => n.min(room),\n                    },\n                )\n            };''','dstlen')\n\nrep('''            let src_at = frame.as_ptr().add(consumed) as *const c_void;\n            let c_dst_at = out_c.as_mut_ptr().add(produced) as *mut c_void;\n            let r_dst_at = out_r.as_mut_ptr().add(produced) as *mut c_void;''',\n'''            let src_at = frame.as_ptr().add(consumed) as *const c_void;\n            let c_dst_at = out_c.as_mut_ptr().add(off) as *mut c_void;\n            let r_dst_at = out_r.as_mut_ptr().add(off) as *mut c_void;''','ptrs')\n\nrep('''            // Window just written (+ sentinel margin). The FULL buffers are\n            // compared once the loop ends.\n            let lo = produced;\n            let hi = (produced + c_dst + 64).min(out_len);\n            if out_c[lo..hi] != out_r[lo..hi] {''',\n'''            // Window just written (+ sentinel margin). The FULL buffers are\n            // compared once the loop ends.\n            let lo = off;\n            let hi = if cfg.recycle {\n                buf_len\n            } else {\n                (off + c_dst + 64).min(buf_len)\n            };\n            if out_c[lo..hi] != out_r[lo..hi] {''','window')\n\nrep('''            consumed += c_src;\n            produced += c_dst;\n\n            if c_src == 0 && c_dst == 0 {''',\n'''            consumed += c_src;\n            produced += c_dst;\n            if cfg.recycle {\n                acc_c.extend_from_slice(&out_c[..c_dst]);\n                acc_r.extend_from_slice(&out_r[..c_dst]);\n            }\n\n            if c_src == 0 && c_dst == 0 {''','accumulate')\n\nrep('''    assert_bytes_eq(&format!(\"{}: full dst buffer\", label), &out_c, &out_r);\n    out_c.truncate(produced);\n    DriveResult {\n        out: out_c,''',\n'''    assert_bytes_eq(&format!(\"{}: full dst buffer\", label), &out_c, &out_r);\n    let out = if cfg.recycle {\n        assert_bytes_eq(\n            &format!(\"{}: accumulated output\", label),\n            &acc_c,\n            &acc_r,\n        );\n        acc_c\n    } else {\n        out_c.truncate(produced);\n        out_c\n    };\n    DriveResult {\n        out,''','result')\n\nopen(p,'w').write(s)\nPYEOF\ntimeout 600 cargo test --release --offline --test lz4frame_decompress_diff --no-run 2>&1 | tail -20"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":859,"cache_read_input_tokens":330040,"cache_creation":{"ephemeral_5m_input_tokens":859,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_016UzAKZwKyMNJCsJYRtsyw8","session_id":"5bf83431-1376-4c81-bcb4-7fd267eb113b","uuid":"99fcda6a-0df0-464c-afaf-8aa9fab6d785","timestamp":"2026-08-23T08:50:16.789Z","subagent_type":"general-purpose","task_description":"Write lz4frame decompression tests"}
