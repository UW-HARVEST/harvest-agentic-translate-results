{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01VMkGuFecTofetKXfopJi7a","type":"tool_result","content":"1\t//! Shared differential-test harness.\n2\t//!\n3\t//! Loads BOTH the C `.so` and the Rust `.so` via `libloading` and exposes their\n4\t//! exported symbols as raw `extern \"C\"` function pointers. Rust functions are\n5\t//! NEVER called directly — every call goes through the `.so` export table, so the\n6\t//! `#[no_mangle]` wrappers are exercised exactly as an external C caller would.\n7\t\n8\t#![allow(dead_code)]\n9\t#![allow(non_snake_case)]\n10\t#![allow(non_camel_case_types)]\n11\t\n12\tuse libloading::Library;\n13\tuse std::os::raw::{c_char, c_int, c_uint, c_void};\n14\tuse std::sync::OnceLock;\n15\t\n16\t// ---------------------------------------------------------------------------\n17\t// Library loading\n18\t// ---------------------------------------------------------------------------\n19\t\n20\tpub struct Lib {\n21\t    lib: Library,\n22\t    pub tag: &'static str,\n23\t}\n24\t\n25\timpl Lib {\n26\t    /// Extract an exported symbol as a copyable value (function pointer).\n27\t    ///\n28\t    /// The returned value outlives the borrow because `Lib` is stored in a\n29\t    /// process-lifetime `OnceLock` and therefore never unloaded.\n30\t    pub fn sym<T: Copy>(&self, name: &str) -> T {\n31\t        unsafe {\n32\t            let s = self\n33\t                .lib\n34\t                .get::<T>(name.as_bytes())\n35\t                .unwrap_or_else(|e| panic!(\"{}: missing symbol `{}`: {}\", self.tag, name, e));\n36\t            *s\n37\t        }\n38\t    }\n39\t\n40\t    /// Returns `true` if the symbol is exported at all.\n41\t    pub fn has(&self, name: &str) -> bool {\n42\t        unsafe { self.lib.get::<*const c_void>(name.as_bytes()).is_ok() }\n43\t    }\n44\t}\n45\t\n46\tpub struct Pair {\n47\t    pub c: Lib,\n48\t    pub rust: Lib,\n49\t}\n50\t\n51\tfn crate_root() -> &'static str {\n52\t    env!(\"CARGO_MANIFEST_DIR\")\n53\t}\n54\t\n55\tfn rust_so_path() -> String {\n56\t    let profile = if cfg!(debug_assertions) { \"debug\" } else { \"release\" };\n57\t    format!(\"{}/target/{}/liblz4.so\", crate_root(), profile)\n58\t}\n59\t\n60\tfn c_so_path() -> String {\n61\t    format!(\"{}/c_src/build/liblz4.so\", crate_root())\n62\t}\n63\t\n64\tstatic LIBS: OnceLock<Pair> = OnceLock::new();\n65\t\n66\t/// The loaded pair of shared libraries (loaded once per test process).\n67\tpub fn libs() -> &'static Pair {\n68\t    LIBS.get_or_init(|| {\n69\t        let cp = c_so_path();\n70\t        let rp = rust_so_path();\n71\t        let c = unsafe { Library::new(&cp) }\n72\t            .unwrap_or_else(|e| panic!(\"cannot load C .so at {}: {}\\nDid you run cmake --build c_src/build ?\", cp, e));\n73\t        let rust = unsafe { Library::new(&rp) }\n74\t            .unwrap_or_else(|e| panic!(\"cannot load Rust .so at {}: {}\", rp, e));\n75\t        Pair {\n76\t            c: Lib { lib: c, tag: \"C\" },\n77\t            rust: Lib { lib: rust, tag: \"Rust\" },\n78\t        }\n79\t    })\n80\t}\n81\t\n82\t/// Fetch the same symbol from both libraries, returning `(c_fn, rust_fn)`.\n83\tpub fn both<T: Copy>(name: &str) -> (T, T) {\n84\t    let l = libs();\n85\t    (l.c.sym::<T>(name), l.rust.sym::<T>(name))\n86\t}\n87\t\n88\t// ---------------------------------------------------------------------------\n89\t// Deterministic PRNG (xoshiro256**) — no external crate, fully reproducible\n90\t// ---------------------------------------------------------------------------\n91\t\n92\tpub struct Rng {\n93\t    s: [u64; 4],\n94\t}\n95\t\n96\timpl Rng {\n97\t    pub fn new(seed: u64) -> Self {\n98\t        // SplitMix64 seeding\n99\t        let mut z = seed;\n100\t        let mut s = [0u64; 4];\n101\t        for slot in s.iter_mut() {\n102\t            z = z.wrapping_add(0x9E37_79B9_7F4A_7C15);\n103\t            let mut x = z;\n104\t            x = (x ^ (x >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);\n105\t            x = (x ^ (x >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);\n106\t            *slot = x ^ (x >> 31);\n107\t        }\n108\t        Rng { s }\n109\t    }\n110\t\n111\t    pub fn next_u64(&mut self) -> u64 {\n112\t        let result = self.s[1].wrapping_mul(5).rotate_left(7).wrapping_mul(9);\n113\t        let t = self.s[1] << 17;\n114\t        self.s[2] ^= self.s[0];\n115\t        self.s[3] ^= self.s[1];\n116\t        self.s[1] ^= self.s[2];\n117\t        self.s[0] ^= self.s[3];\n118\t        self.s[2] ^= t;\n119\t        self.s[3] = self.s[3].rotate_left(45);\n120\t        result\n121\t    }\n122\t\n123\t    pub fn next_u32(&mut self) -> u32 {\n124\t        (self.next_u64() >> 32) as u32\n125\t    }\n126\t\n127\t    pub fn byte(&mut self) -> u8 {\n128\t        (self.next_u64() >> 56) as u8\n129\t    }\n130\t\n131\t    /// Uniform in `[0, n)`. Returns 0 when `n == 0`.\n132\t    pub fn below(&mut self, n: usize) -> usize {\n133\t        if n == 0 {\n134\t            0\n135\t        } else {\n136\t            (self.next_u64() % (n as u64)) as usize\n137\t        }\n138\t    }\n139\t\n140\t    /// Uniform in `[lo, hi]` inclusive.\n141\t    pub fn range(&mut self, lo: usize, hi: usize) -> usize {\n142\t        if hi <= lo {\n143\t            lo\n144\t        } else {\n145\t            lo + self.below(hi - lo + 1)\n146\t        }\n147\t    }\n148\t\n149\t    pub fn bool(&mut self) -> bool {\n150\t        self.next_u64() & 1 == 1\n151\t    }\n152\t}\n153\t\n154\t// ---------------------------------------------------------------------------\n155\t// Input-shape generators\n156\t//\n157\t// These deliberately span the data characters the LZ4 encoder branches on:\n158\t// incompressible (long literal runs -> literal-length extension bytes),\n159\t// highly repetitive (long matches -> match-length extension bytes),\n160\t// and mixtures / structured text.\n161\t// ---------------------------------------------------------------------------\n162\t\n163\t/// Fully random bytes: incompressible, forces literal runs > 15 and hence the\n164\t/// literal-length 255-extension loop.\n165\tpub fn gen_random(rng: &mut Rng, len: usize) -> Vec<u8> {\n166\t    (0..len).map(|_| rng.byte()).collect()\n167\t}\n168\t\n169\t/// A single repeated byte: maximally compressible, forces very long matches and\n170\t/// hence multiple 0xFF match-length extension bytes.\n171\tpub fn gen_constant(len: usize, b: u8) -> Vec<u8> {\n172\t    vec![b; len]\n173\t}\n174\t\n175\t/// Repeating pattern of `period` bytes: long matches at a fixed small offset.\n176\tpub fn gen_periodic(rng: &mut Rng, len: usize, period: usize) -> Vec<u8> {\n177\t    let period = period.max(1);\n178\t    let base: Vec<u8> = (0..period).map(|_| rng.byte()).collect();\n179\t    (0..len).map(|i| base[i % period]).collect()\n180\t}\n181\t\n182\t/// Text-like data from a small alphabet with repeated words: realistic mix of\n183\t/// short and medium matches.\n184\tpub fn gen_text(rng: &mut Rng, len: usize) -> Vec<u8> {\n185\t    const WORDS: &[&[u8]] = &[\n186\t        b\"the \", b\"quick \", b\"brown \", b\"fox \", b\"jumps \", b\"over \", b\"lazy \", b\"dog \",\n187\t        b\"lz4 \", b\"compression \", b\"block \", b\"frame \", b\"checksum \", b\"dictionary \",\n188\t    ];\n189\t    let mut out = Vec::with_capacity(len + 16);\n190\t    while out.len() < len {\n191\t        out.extend_from_slice(WORDS[rng.below(WORDS.len())]);\n192\t    }\n193\t    out.truncate(len);\n194\t    out\n195\t}\n196\t\n197\t/// Random data interleaved with long runs: alternates the literal-extension and\n198\t/// match-extension paths within a single input.\n199\tpub fn gen_mixed(rng: &mut Rng, len: usize) -> Vec<u8> {\n200\t    let mut out = Vec::with_capacity(len + 512);\n201\t    while out.len() < len {\n202\t        if rng.bool() {\n203\t            let n = rng.range(1, 300);\n204\t            let b = rng.byte();\n205\t            out.extend(std::iter::repeat(b).take(n));\n206\t        } else {\n207\t            let n = rng.range(1, 64);\n208\t            for _ in 0..n {\n209\t                out.push(rng.byte());\n210\t            }\n211\t        }\n212\t    }\n213\t    out.truncate(len);\n214\t    out\n215\t}\n216\t\n217\t/// Data built by copying earlier windows of itself at controlled distances,\n218\t/// including distances near the 65535 maximum LZ4 offset.\n219\tpub fn gen_selfref(rng: &mut Rng, len: usize) -> Vec<u8> {\n220\t    let mut out: Vec<u8> = Vec::with_capacity(len + 256);\n221\t    // seed with some random bytes\n222\t    let seed_len = rng.range(16, 128).min(len.max(1));\n223\t    for _ in 0..seed_len {\n224\t        out.push(rng.byte());\n225\t    }\n226\t    while out.len() < len {\n227\t        let choice = rng.below(4);\n228\t        match choice {\n229\t            0 => {\n230\t                // literal noise\n231\t                let n = rng.range(1, 40);\n232\t                for _ in 0..n {\n233\t                    out.push(rng.byte());\n234\t                }\n235\t            }\n236\t            _ => {\n237\t                // copy from a previous window; bias distances toward 65535\n238\t                let maxdist = out.len().min(65535);\n239\t                let dist = match rng.below(3) {\n240\t                    0 => maxdist,\n241\t                    1 => rng.range(1, maxdist.max(1)),\n242\t                    _ => rng.range(1, maxdist.min(4096).max(1)),\n243\t                }\n244\t                .max(1);\n245\t                let n = rng.range(4, 600);\n246\t                let start = out.len() - dist;\n247\t                for k in 0..n {\n248\t                    let b = out[start + (k % dist)];\n249\t                    out.push(b);\n250\t                    if out.len() >= len + 600 {\n251\t                        break;\n252\t                    }\n253\t                }\n254\t            }\n255\t        }\n256\t    }\n257\t    out.truncate(len);\n258\t    out\n259\t}\n260\t\n261\t/// The set of generators, addressed by index, so tests can sweep data characters.\n262\tpub const N_SHAPES: usize = 6;\n263\t\n264\tpub fn gen_shape(rng: &mut Rng, shape: usize, len: usize) -> Vec<u8> {\n265\t    match shape % N_SHAPES {\n266\t        0 => gen_random(rng, len),\n267\t        1 => gen_constant(len, rng.byte()),\n268\t        2 => {\n269\t            let period = rng.range(1, 40);\n270\t            gen_periodic(rng, len, period)\n271\t        }\n272\t        3 => gen_text(rng, len),\n273\t        4 => gen_mixed(rng, len),\n274\t        _ => gen_selfref(rng, len),\n275\t    }\n276\t}\n277\t\n278\tpub fn shape_name(shape: usize) -> &'static str {\n279\t    match shape % N_SHAPES {\n280\t        0 => \"random\",\n281\t        1 => \"constant\",\n282\t        2 => \"periodic\",\n283\t        3 => \"text\",\n284\t        4 => \"mixed\",\n285\t        _ => \"selfref\",\n286\t    }\n287\t}\n288\t\n289\t// ---------------------------------------------------------------------------\n290\t// Aligned scratch buffers\n291\t//\n292\t// `LZ4_initStream` / `LZ4_initStreamHC` reject insufficiently aligned buffers\n293\t// (returning NULL), and the `*_extState` entry points require a properly\n294\t// aligned state block, so tests need controllable alignment.\n295\t// ---------------------------------------------------------------------------\n296\t\n297\t/// A heap buffer with a guaranteed alignment, plus an optional byte offset so a\n298\t/// test can deliberately produce a MISALIGNED pointer.\n299\tpub struct AlignedBuf {\n300\t    ptr: *mut u8,\n301\t    layout: std::alloc::Layout,\n302\t    offset: usize,\n303\t    len: usize,\n304\t}\n305\t\n306\timpl AlignedBuf {\n307\t    /// Allocate `len` usable bytes at `align`-byte alignment, zero-filled.\n308\t    pub fn new(len: usize, align: usize) -> Self {\n309\t        Self::with_offset(len, align, 0)\n310\t    }\n311\t\n312\t    /// Allocate so that `as_mut_ptr()` is `align`-aligned **plus** `offset`\n313\t    /// bytes — i.e. deliberately misaligned when `offset != 0`.\n314\t    pub fn with_offset(len: usize, align: usize, offset: usize) -> Self {\n315\t        let total = len + offset + align;\n316\t        let layout = std::alloc::Layout::from_size_align(total, align).unwrap();\n317\t        let ptr = unsafe { std::alloc::alloc_zeroed(layout) };\n318\t        assert!(!ptr.is_null(), \"allocation of {} bytes failed\", total);\n319\t        AlignedBuf { ptr, layout, offset, len }\n320\t    }\n321\t\n322\t    pub fn as_mut_ptr(&mut self) -> *mut u8 {\n323\t        unsafe { self.ptr.add(self.offset) }\n324\t    }\n325\t\n326\t    pub fn as_ptr(&self) -> *const u8 {\n327\t        unsafe { self.ptr.add(self.offset) }\n328\t    }\n329\t\n330\t    pub fn len(&self) -> usize {\n331\t        self.len\n332\t    }\n333\t\n334\t    pub fn as_slice(&self) -> &[u8] {\n335\t        unsafe { std::slice::from_raw_parts(self.as_ptr(), self.len) }\n336\t    }\n337\t\n338\t    pub fn zero(&mut self) {\n339\t        unsafe { std::ptr::write_bytes(self.ptr, 0, self.layout.size()) }\n340\t    }\n341\t}\n342\t\n343\timpl Drop for AlignedBuf {\n344\t    fn drop(&mut self) {\n345\t        unsafe { std::alloc::dealloc(self.ptr, self.layout) }\n346\t    }\n347\t}\n348\t\n349\t// ---------------------------------------------------------------------------\n350\t// Assertion helpers\n351\t// ---------------------------------------------------------------------------\n352\t\n353\tpub fn hexdump(b: &[u8], max: usize) -> String {\n354\t    let n = b.len().min(max);\n355\t    let mut s = String::new();\n356\t    for (i, x) in b[..n].iter().enumerate() {\n357\t        if i % 32 == 0 && i != 0 {\n358\t            s.push('\\n');\n359\t        }\n360\t        s.push_str(&format!(\"{:02x}\", x));\n361\t    }\n362\t    if b.len() > n {\n363\t        s.push_str(&format!(\" ...(+{} more)\", b.len() - n));\n364\t    }\n365\t    s\n366\t}\n367\t\n368\t/// Compare two byte slices and produce a precise diff message on mismatch.\n369\tpub fn assert_bytes_eq(ctx: &str, c: &[u8], r: &[u8]) {\n370\t    if c == r {\n371\t        return;\n372\t    }\n373\t    if c.len() != r.len() {\n374\t        panic!(\n375\t            \"{}\\n  length mismatch: C={} Rust={}\\n  C   : {}\\n  Rust: {}\",\n376\t            ctx,\n377\t            c.len(),\n378\t            r.len(),\n379\t            hexdump(c, 128),\n380\t            hexdump(r, 128)\n381\t        );\n382\t    }\n383\t    let idx = c.iter().zip(r.iter()).position(|(a, b)| a != b).unwrap();\n384\t    let lo = idx.saturating_sub(16);\n385\t    let hi = (idx + 16).min(c.len());\n386\t    panic!(\n387\t        \"{}\\n  first byte difference at offset {} (len {}): C=0x{:02x} Rust=0x{:02x}\\n  C   [{}..{}]: {}\\n  Rust[{}..{}]: {}\",\n388\t        ctx, idx, c.len(), c[idx], r[idx], lo, hi, hexdump(&c[lo..hi], 64), lo, hi, hexdump(&r[lo..hi], 64)\n389\t    );\n390\t}\n391\t\n392\t// ---------------------------------------------------------------------------\n393\t// FFI types mirroring the C headers\n394\t// ---------------------------------------------------------------------------\n395\t\n396\t#[repr(C)]\n397\t#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n398\tpub struct LZ4F_frameInfo_t {\n399\t    pub blockSizeID: c_int,\n400\t    pub blockMode: c_int,\n401\t    pub contentChecksumFlag: c_int,\n402\t    pub frameType: c_int,\n403\t    pub contentSize: u64,\n404\t    pub dictID: c_uint,\n405\t    pub blockChecksumFlag: c_int,\n406\t}\n407\t\n408\timpl Default for LZ4F_frameInfo_t {\n409\t    /// Mirrors `LZ4F_INIT_FRAMEINFO`.\n410\t    fn default() -> Self {\n411\t        LZ4F_frameInfo_t {\n412\t            blockSizeID: LZ4F_max64KB,\n413\t            blockMode: LZ4F_blockLinked,\n414\t            contentChecksumFlag: LZ4F_noContentChecksum,\n415\t            frameType: LZ4F_frame,\n416\t            contentSize: 0,\n417\t            dictID: 0,\n418\t            blockChecksumFlag: LZ4F_noBlockChecksum,\n419\t        }\n420\t    }\n421\t}\n422\t\n423\t#[repr(C)]\n424\t#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n425\tpub struct LZ4F_preferences_t {\n426\t    pub frameInfo: LZ4F_frameInfo_t,\n427\t    pub compressionLevel: c_int,\n428\t    pub autoFlush: c_uint,\n429\t    pub favorDecSpeed: c_uint,\n430\t    pub reserved: [c_uint; 3],\n431\t}\n432\t\n433\timpl Default for LZ4F_preferences_t {\n434\t    /// Mirrors `LZ4F_INIT_PREFERENCES`.\n435\t    fn default() -> Self {\n436\t        LZ4F_preferences_t {\n437\t            frameInfo: LZ4F_frameInfo_t::default(),\n438\t            compressionLevel: 0,\n439\t            autoFlush: 0,\n440\t            favorDecSpeed: 0,\n441\t            reserved: [0; 3],\n442\t        }\n443\t    }\n444\t}\n445\t\n446\t#[repr(C)]\n447\t#[derive(Clone, Copy, Debug, Default)]\n448\tpub struct LZ4F_compressOptions_t {\n449\t    pub stableSrc: c_uint,\n450\t    pub reserved: [c_uint; 3],\n451\t}\n452\t\n453\t#[repr(C)]\n454\t#[derive(Clone, Copy, Debug, Default)]\n455\tpub struct LZ4F_decompressOptions_t {\n456\t    pub stableDst: c_uint,\n457\t    pub skipChecksums: c_uint,\n458\t    pub reserved1: c_uint,\n459\t    pub reserved0: c_uint,\n460\t}\n461\t\n462\t#[repr(C)]\n463\t#[derive(Clone, Copy)]\n464\tpub struct LZ4F_CustomMem {\n465\t    pub customAlloc: Option<extern \"C\" fn(*mut c_void, usize) -> *mut c_void>,\n466\t    pub customCalloc: Option<extern \"C\" fn(*mut c_void, usize) -> *mut c_void>,\n467\t    pub customFree: Option<extern \"C\" fn(*mut c_void, *mut c_void)>,\n468\t    pub opaqueState: *mut c_void,\n469\t}\n470\t\n471\timpl Default for LZ4F_CustomMem {\n472\t    /// Mirrors `LZ4F_defaultCMem` — all NULL, defers to stdlib.\n473\t    fn default() -> Self {\n474\t        LZ4F_CustomMem {\n475\t            customAlloc: None,\n476\t            customCalloc: None,\n477\t            customFree: None,\n478\t            opaqueState: std::ptr::null_mut(),\n479\t        }\n480\t    }\n481\t}\n482\t\n483\t// ---------------------------------------------------------------------------\n484\t// Constants from the C headers\n485\t// ---------------------------------------------------------------------------\n486\t\n487\t// lz4.h\n488\tpub const LZ4_MAX_INPUT_SIZE: usize = 0x7E00_0000;\n489\tpub const LZ4_ACCELERATION_MAX: c_int = 65537;\n490\tpub const LZ4_ACCELERATION_DEFAULT: c_int = 1;\n491\tpub const LZ4_MEMORY_USAGE: usize = 14;\n492\t/// `static const int LZ4_64Klimit = ((64 KB) + (MFLIMIT-1));` (lz4.c:710).\n493\t/// Inputs `< LZ4_64Klimit` select `tableType == byU16`, `>=` selects `byU32`.\n494\tpub const LZ4_64Klimit: usize = 65536 + (MFLIMIT - 1); // 65547\n495\tpub const MFLIMIT: usize = 12;\n496\tpub const LASTLITERALS: usize = 5;\n497\tpub const MINMATCH: usize = 4;\n498\tpub const LZ4_DISTANCE_MAX: usize = 65535;\n499\t\n500\t// lz4hc.h\n501\tpub const LZ4HC_CLEVEL_MIN: c_int = 2;\n502\tpub const LZ4HC_CLEVEL_DEFAULT: c_int = 9;\n503\tpub const LZ4HC_CLEVEL_OPT_MIN: c_int = 10;\n504\tpub const LZ4HC_CLEVEL_MAX: c_int = 12;\n505\tpub const LZ4HC_DICTIONARY_LOGSIZE: usize = 16;\n506\tpub const LZ4HC_MAXD: usize = 1 << LZ4HC_DICTIONARY_LOGSIZE;\n507\t\n508\t// lz4frame.h — blockSizeID\n509\tpub const LZ4F_default: c_int = 0;\n510\tpub const LZ4F_max64KB: c_int = 4;\n511\tpub const LZ4F_max256KB: c_int = 5;\n512\tpub const LZ4F_max1MB: c_int = 6;\n513\tpub const LZ4F_max4MB: c_int = 7;\n514\t\n515\t// blockMode\n516\tpub const LZ4F_blockLinked: c_int = 0;\n517\tpub const LZ4F_blockIndependent: c_int = 1;\n518\t\n519\t// contentChecksum\n520\tpub const LZ4F_noContentChecksum: c_int = 0;\n521\tpub const LZ4F_contentChecksumEnabled: c_int = 1;\n522\t\n523\t// blockChecksum\n524\tpub const LZ4F_noBlockChecksum: c_int = 0;\n525\tpub const LZ4F_blockChecksumEnabled: c_int = 1;\n526\t\n527\t// frameType\n528\tpub const LZ4F_frame: c_int = 0;\n529\tpub const LZ4F_skippableFrame: c_int = 1;\n530\t\n531\tpub const LZ4F_VERSION: c_uint = 100;\n532\tpub const LZ4F_HEADER_SIZE_MIN: usize = 7;\n533\tpub const LZ4F_HEADER_SIZE_MAX: usize = 19;\n534\tpub const LZ4F_BLOCK_HEADER_SIZE: usize = 4;\n535\tpub const LZ4F_BLOCK_CHECKSUM_SIZE: usize = 4;\n536\tpub const LZ4F_CONTENT_CHECKSUM_SIZE: usize = 4;\n537\tpub const LZ4F_MAGICNUMBER: u32 = 0x184D2204;\n538\tpub const LZ4F_MAGIC_SKIPPABLE_START: u32 = 0x184D2A50;\n539\t\n540\t/// `LZ4F_errorCodes` — numeric values follow the `LZ4F_LIST_ERRORS` macro order.\n541\tpub mod err {\n542\t    pub const OK_NoError: i32 = 0;\n543\t    pub const ERROR_GENERIC: i32 = 1;\n544\t    pub const ERROR_maxBlockSize_invalid: i32 = 2;\n545\t    pub const ERROR_blockMode_invalid: i32 = 3;\n546\t    pub const ERROR_parameter_invalid: i32 = 4;\n547\t    pub const ERROR_compressionLevel_invalid: i32 = 5;\n548\t    pub const ERROR_headerVersion_wrong: i32 = 6;\n549\t    pub const ERROR_blockChecksum_invalid: i32 = 7;\n550\t    pub const ERROR_reservedFlag_set: i32 = 8;\n551\t    pub const ERROR_allocation_failed: i32 = 9;\n552\t    pub const ERROR_srcSize_tooLarge: i32 = 10;\n553\t    pub const ERROR_dstMaxSize_tooSmall: i32 = 11;\n554\t    pub const ERROR_frameHeader_incomplete: i32 = 12;\n555\t    pub const ERROR_frameType_unknown: i32 = 13;\n556\t    pub const ERROR_frameSize_wrong: i32 = 14;\n557\t    pub const ERROR_srcPtr_wrong: i32 = 15;\n558\t    pub const ERROR_decompressionFailed: i32 = 16;\n559\t    pub const ERROR_headerChecksum_invalid: i32 = 17;\n560\t    pub const ERROR_contentChecksum_invalid: i32 = 18;\n561\t    pub const ERROR_frameDecoding_alreadyStarted: i32 = 19;\n562\t    pub const ERROR_compressionState_uninitialized: i32 = 20;\n563\t    pub const ERROR_parameter_null: i32 = 21;\n564\t    pub const ERROR_io_write: i32 = 22;\n565\t    pub const ERROR_io_read: i32 = 23;\n566\t    pub const ERROR_maxCode: i32 = 24;\n567\t}\n568\t\n569\t// xxhash.h\n570\tpub const XXH_OK: c_int = 0;\n571\tpub const XXH_ERROR: c_int = 1;\n572\t\n573\t#[repr(C)]\n574\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n575\tpub struct XXH32_canonical_t {\n576\t    pub digest: [u8; 4],\n577\t}\n578\t\n579\t#[re