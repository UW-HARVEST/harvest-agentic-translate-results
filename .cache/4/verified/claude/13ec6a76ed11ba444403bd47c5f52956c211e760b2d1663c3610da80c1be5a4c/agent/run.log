{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01JMJM7tXa5158mksq6CzHk7","type":"tool_result","content":"1\t//! Shared definitions extracted from lz4.c (the parts included by lz4hc.c via\n2\t//! `LZ4_COMMONDEFS_ONLY`), plus the shared public structure layouts.\n3\t\n4\tuse core::ptr;\n5\t\n6\t/* ---------------------------------------------------------------- *\n7\t *  libc bindings (the C sources use malloc/calloc/free/mem*)\n8\t * ---------------------------------------------------------------- */\n9\textern \"C\" {\n10\t    pub fn malloc(size: usize) -> *mut u8;\n11\t    pub fn calloc(n: usize, size: usize) -> *mut u8;\n12\t    pub fn free(p: *mut u8);\n13\t    pub fn memcpy(dst: *mut u8, src: *const u8, n: usize) -> *mut u8;\n14\t    pub fn memmove(dst: *mut u8, src: *const u8, n: usize) -> *mut u8;\n15\t    pub fn memset(dst: *mut u8, c: i32, n: usize) -> *mut u8;\n16\t}\n17\t\n18\t/* ---------------------------------------------------------------- *\n19\t *  Common constants\n20\t * ---------------------------------------------------------------- */\n21\tpub const MINMATCH: usize = 4;\n22\tpub const WILDCOPYLENGTH: usize = 8;\n23\tpub const LASTLITERALS: usize = 5;\n24\tpub const MFLIMIT: usize = 12;\n25\tpub const MATCH_SAFEGUARD_DISTANCE: usize = (2 * WILDCOPYLENGTH) - MINMATCH; /* 12 */\n26\tpub const FASTLOOP_SAFE_DISTANCE: usize = 64;\n27\tpub const LZ4_minLength: i32 = (MFLIMIT + 1) as i32; /* 13 */\n28\t\n29\tpub const LZ4_DISTANCE_ABSOLUTE_MAX: u32 = 65535;\n30\tpub const LZ4_DISTANCE_MAX: u32 = 65535;\n31\t\n32\tpub const ML_BITS: u32 = 4;\n33\tpub const ML_MASK: u32 = (1u32 << ML_BITS) - 1;\n34\tpub const RUN_BITS: u32 = 8 - ML_BITS;\n35\tpub const RUN_MASK: u32 = (1u32 << RUN_BITS) - 1;\n36\t\n37\tpub const STEPSIZE: usize = 8; /* sizeof(reg_t) on x86_64 */\n38\t\n39\t/* from lz4.h */\n40\tpub const LZ4_MEMORY_USAGE: u32 = 14;\n41\tpub const LZ4_HASHLOG: u32 = LZ4_MEMORY_USAGE - 2; /* 12 */\n42\tpub const LZ4_HASHTABLESIZE: usize = 1usize << LZ4_MEMORY_USAGE; /* bytes */\n43\tpub const LZ4_HASH_SIZE_U32: usize = 1usize << LZ4_HASHLOG; /* 4096 */\n44\tpub const LZ4_MAX_INPUT_SIZE: i32 = 0x7E00_0000;\n45\tpub const LZ4_STREAM_MINSIZE: usize = (1usize << LZ4_MEMORY_USAGE) + 32; /* 16416 */\n46\tpub const LZ4_STREAMDECODE_MINSIZE: usize = 32;\n47\t\n48\tpub const LZ4_VERSION_MAJOR: i32 = 1;\n49\tpub const LZ4_VERSION_MINOR: i32 = 10;\n50\tpub const LZ4_VERSION_RELEASE: i32 = 0;\n51\tpub const LZ4_VERSION_NUMBER: i32 =\n52\t    LZ4_VERSION_MAJOR * 100 * 100 + LZ4_VERSION_MINOR * 100 + LZ4_VERSION_RELEASE;\n53\tpub const LZ4_VERSION_STRING: &[u8] = b\"1.10.0\\0\";\n54\t\n55\t/* from lz4hc.h */\n56\tpub const LZ4HC_CLEVEL_MIN: i32 = 2;\n57\tpub const LZ4HC_CLEVEL_DEFAULT: i32 = 9;\n58\tpub const LZ4HC_CLEVEL_OPT_MIN: i32 = 10;\n59\tpub const LZ4HC_CLEVEL_MAX: i32 = 12;\n60\t\n61\tpub const LZ4HC_DICTIONARY_LOGSIZE: u32 = 16;\n62\tpub const LZ4HC_MAXD: usize = 1usize << LZ4HC_DICTIONARY_LOGSIZE;\n63\tpub const LZ4HC_MAXD_MASK: usize = LZ4HC_MAXD - 1;\n64\tpub const LZ4HC_HASH_LOG: u32 = 15;\n65\tpub const LZ4HC_HASHTABLESIZE: usize = 1usize << LZ4HC_HASH_LOG;\n66\tpub const LZ4HC_HASH_MASK: usize = LZ4HC_HASHTABLESIZE - 1;\n67\tpub const LZ4_STREAMHC_MINSIZE: usize = 262200;\n68\t\n69\t/* limitedOutput_directive */\n70\tpub const notLimited: i32 = 0;\n71\tpub const limitedOutput: i32 = 1;\n72\tpub const fillOutput: i32 = 2;\n73\t\n74\t/* tableType_t */\n75\tpub const clearedTable: u32 = 0;\n76\tpub const byPtr: u32 = 1;\n77\tpub const byU32: u32 = 2;\n78\tpub const byU16: u32 = 3;\n79\t\n80\t/* dict_directive */\n81\tpub const noDict: i32 = 0;\n82\tpub const withPrefix64k: i32 = 1;\n83\tpub const usingExtDict: i32 = 2;\n84\tpub const usingDictCtx: i32 = 3;\n85\t\n86\t/* dictIssue_directive */\n87\tpub const noDictIssue: i32 = 0;\n88\tpub const dictSmall: i32 = 1;\n89\t\n90\t/* earlyEnd_directive */\n91\tpub const decode_full_block: i32 = 0;\n92\tpub const partial_decode: i32 = 1;\n93\t\n