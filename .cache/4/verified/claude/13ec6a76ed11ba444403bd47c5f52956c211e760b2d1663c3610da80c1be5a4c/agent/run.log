b contentChecksumFlag: c_int,\n105\t    pub frameType: c_int,\n106\t    pub contentSize: u64,\n107\t    pub dictID: u32,\n108\t    pub blockChecksumFlag: c_int,\n109\t}\n110\t\n111\timpl LZ4F_frameInfo_t {\n112\t    const fn zeroed() -> Self {\n113\t        LZ4F_frameInfo_t {\n114\t            blockSizeID: 0,\n115\t            blockMode: 0,\n116\t            contentChecksumFlag: 0,\n117\t            frameType: 0,\n118\t            contentSize: 0,\n119\t            dictID: 0,\n120\t            blockChecksumFlag: 0,\n121\t        }\n122\t    }\n123\t    const fn init() -> Self {\n124\t        /* LZ4F_INIT_FRAMEINFO */\n125\t        LZ4F_frameInfo_t {\n126\t            blockSizeID: LZ4F_max64KB,\n127\t            blockMode: LZ4F_blockLinked,\n128\t            contentChecksumFlag: LZ4F_noContentChecksum,\n129\t            frameType: LZ4F_frame,\n130\t            contentSize: 0,\n131\t            dictID: 0,\n132\t            blockChecksumFlag: LZ4F_noBlockChecksum,\n133\t        }\n134\t    }\n135\t}\n136\t\n137\t#[repr(C)]\n138\t#[derive(Clone, Copy)]\n139\tpub struct LZ4F_preferences_t {\n140\t    pub frameInfo: LZ4F_frameInfo_t,\n141\t    pub compressionLevel: c_int,\n142\t    pub autoFlush: u32,\n143\t    pub favorDecSpeed: u32,\n144\t    pub reserved: [u32; 3],\n145\t}\n146\t\n147\timpl LZ4F_preferences_t {\n148\t    const fn zeroed() -> Self {\n149\t        LZ4F_preferences_t {\n150\t            frameInfo: LZ4F_frameInfo_t::zeroed(),\n151\t            compressionLevel: 0,\n152\t            autoFlush: 0,\n153\t            favorDecSpeed: 0,\n154\t            reserved: [0, 0, 0],\n155\t        }\n156\t    }\n157\t    const fn init() -> Self {\n158\t        /* LZ4F_INIT_PREFERENCES */\n159\t        LZ4F_preferences_t {\n160\t            frameInfo: LZ4F_frameInfo_t::init(),\n161\t            compressionLevel: 0,\n162\t            autoFlush: 0,\n163\t            favorDecSpeed: 0,\n164\t            reserved: [0, 0, 0],\n165\t        }\n166\t    }\n167\t}\n168\t\n169\t#[re