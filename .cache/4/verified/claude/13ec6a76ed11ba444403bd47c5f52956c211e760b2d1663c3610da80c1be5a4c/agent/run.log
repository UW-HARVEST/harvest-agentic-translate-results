{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_012JVog3isB7xRTTTdCqtnui","type":"tool_result","content":"1\t//! Phase C — error-path differential tests for lz4.c.\n2\t//!\n3\t//! One test (or one clearly-labelled block) per row of the `lz4.c` section of\n4\t//! `ERRORS.md`. Every case asserts that C and Rust return the SAME error\n5\t//! code / sentinel — not merely that both \"failed somehow\".\n6\t//!\n7\t//! Rows that are NOT covered are documented inline with the reason\n8\t//! (compile-time `#error`s, un-forceable allocation failures, and rows the C\n9\t//! itself documents as undefined behaviour, which would segfault both\n10\t//! libraries identically and tell us nothing).\n11\t\n12\tmod common;\n13\t\n14\tuse common::*;\n15\tuse std::os::raw::{c_char, c_int, c_void};\n16\t\n17\tconst SENTINEL: u8 = 0xAA;\n18\t\n19\ttype FnBound = unsafe extern \"C\" fn(c_int) -> c_int;\n20\ttype FnRingBuf = unsafe extern \"C\" fn(c_int) -> c_int;\n21\ttype FnCompDefault = unsafe extern \"C\" fn(*const c_char, *mut c_char, c_int, c_int) -> c_int;\n22\ttype FnCompFast = unsafe extern \"C\" fn(*const c_char, *mut c_char, c_int, c_int, c_int) -> c_int;\n23\ttype FnCompFastExt =\n24\t    unsafe extern \"C\" fn(*mut c_void, *const c_char, *mut c_char, c_int, c_int, c_int) -> c_int;\n25\ttype FnCompDestSize = unsafe extern \"C\" fn(*const c_char, *mut c_char, *mut c_int, c_int) -> c_int;\n26\ttype FnCompDestSizeExt =\n27\t    unsafe extern \"C\" fn(*mut c_void, *const c_char, *mut c_char, *mut c_int, c_int, c_int) -> c_int;\n28\ttype FnDecompSafe = unsafe extern \"C\" fn(*const c_char, *mut c_char, c_int, c_int) -> c_int;\n29\ttype FnDecompPartial =\n30\t    unsafe extern \"C\" fn(*const c_char, *mut c_char, c_int, c_int, c_int) -> c_int;\n31\ttype FnDecompFast = unsafe extern \"C\" fn(*const c_char, *mut c_char, c_int) -> c_int;\n32\ttype FnDecompUsingDict =\n33\t    unsafe extern \"C\" fn(*const c_char, *mut c_char, c_int, c_int, *const c_char, c_int) -> c_int;\n34\ttype FnDecompPartialUsingDict =\n35\t    unsafe extern \"C\" fn(*const c_char, *mut c_char, c_int, c_int, c_int, *const c_char, c_int) -> c_int;\n36\ttype FnDecompFastUsingDict =\n37\t    unsafe extern \"C\" fn(*const c_char, *mut c_char, c_int, *const c_char, c_int) -> c_int;\n38\ttype FnCreateStream = unsafe extern \"C\" fn() -> *mut c_void;\n39\ttype FnFreeStream = unsafe extern \"C\" fn(*mut c_void) -> c_int;\n40\ttype FnInitStream = unsafe extern \"C\" fn(*mut c_void, usize) -> *mut c_void;\n41\ttype FnLoadDict = unsafe extern \"C\" fn(*mut c_void, *const c_char, c_int) -> c_int;\n42\ttype FnLoadDictInternal =\n43\t    unsafe extern \"C\" fn(*mut c_void, *const c_char, c_int, c_int) -> c_int;\n44\ttype FnAttachDict = unsafe extern \"C\" fn(*mut c_void, *const c_void);\n45\ttype FnSaveDict = unsafe extern \"C\" fn(*mut c_void, *mut c_char, c_int) -> c_int;\n46\ttype FnCompContinue =\n47\t    unsafe extern \"C\" fn(*mut c_void, *const c_char, *mut c_char, c_int, c_int, c_int) -> c_int;\n48\ttype FnCreateStreamDecode = unsafe extern \"C\" fn() -> *mut c_void;\n49\ttype FnFreeStreamDecode = unsafe extern \"C\" fn(*mut c_void) -> c_int;\n50\ttype FnSetStreamDecode = unsafe extern \"C\" fn(*mut c_void, *const c_char, c_int) -> c_int;\n51\ttype FnDecompSafeContinue =\n52\t    unsafe extern \"C\" fn(*mut c_void, *const c_char, *mut c_char, c_int, c_int) -> c_int;\n53\ttype FnDecompFastContinue =\n54\t    unsafe extern \"C\" fn(*mut c_void, *const c_char, *mut c_char, c_int) -> c_int;\n55\ttype FnSizeofState = unsafe extern \"C\" fn() -> c_int;\n56\ttype FnResetStreamState = unsafe extern \"C\" fn(*mut c_void, *mut c_char) -> c_int;\n57\t\n58\tfn stream_size() -> usize {\n59\t    let (c, r) = both::<FnSizeofState>(\"LZ4_sizeofStreamState\");\n60\t    let cs = unsafe { c() } as usize;\n61\t    assert_eq!(cs, unsafe { r() } as usize, \"LZ4_sizeofStreamState\");\n62\t    cs\n63\t}\n64\t\n65\t/// Compress `src` with C, returning the compressed bytes (used to build valid\n66\t/// inputs that are then corrupted).\n67\tfn compress_c(src: &[u8]) -> Vec<u8> {\n68\t    let (cb, _) = both::<FnBound>(\"LZ4_compressBound\");\n69\t    let (cc, _) = both::<FnCompDefault>(\"LZ4_compress_default\");\n70\t    let bound = unsafe { cb(src.len() as c_int) }.max(1) as usize;\n71\t    let mut dst = vec![0u8; bound];\n72\t    let n = unsafe {\n73\t        cc(\n74\t            src.as_ptr() as *const c_char,\n75\t            dst.as_mut_ptr() as *mut c_char,\n76\t            src.len() as c_int,\n77\t            bound as c_int,\n78\t        )\n79\t    };\n80\t    assert!(n > 0, \"helper compression failed\");\n81\t    dst.truncate(n as usize);\n82\t    dst\n83\t}\n84\t\n85\t// ===========================================================================\n86\t// ERRORS.md rows 1-2 — LZ4_compressBound rejects out-of-range sizes\n87\t// ===========================================================================\n88\t\n89\t#[test]\n90\tfn row_01_02_compress_bound_out_of_range() {\n91\t    let (c, r) = both::<FnBound>(\"LZ4_compressBound\");\n92\t    // row 1: isize < 0 -> 0 ; row 2: isize > LZ4_MAX_INPUT_SIZE -> 0\n93\t    let cases: Vec<c_int> = vec![\n94\t        c_int::MIN,\n95\t        -1000,\n96\t        -1,                                  // row 1\n97\t        LZ4_MAX_INPUT_SIZE as c_int + 1,     // row 2\n98\t        0x7E00_0001,\n99\t        0x7FFF_FFFF,\n100\t        c_int::MAX,\n101\t        // accept boundary for contrast\n102\t        0,\n103\t        1,\n104\t        LZ4_MAX_INPUT_SIZE as c_int,\n105\t    ];\n106\t    for &v in &cases {\n107\t        let cv = unsafe { c(v) };\n108\t        let rv = unsafe { r(v) };\n109\t        assert_eq!(cv, rv, \"LZ4_compressBound({}) C={} Rust={}\", v, cv, rv);\n110\t    }\n111\t    // Explicitly pin the documented values.\n112\t    assert_eq!(unsafe { c(-1) }, 0, \"row 1: negative must give 0\");\n113\t    assert_eq!(\n114\t        unsafe { c(LZ4_MAX_INPUT_SIZE as c_int + 1) },\n115\t        0,\n116\t        \"row 2: oversized must give 0\"\n117\t    );\n118\t}\n119\t\n120\t// ===========================================================================\n121\t// ERRORS.md rows 3-8 — srcSize / dstCapacity rejection in LZ4_compress_generic\n122\t// ===========================================================================\n123\t\n124\t#[test]\n125\tfn row_03_08_compress_srcsize_and_dstcapacity_rejection() {\n126\t    let (cd, rd) = both::<FnCompDefault>(\"LZ4_compress_default\");\n127\t    let (cf, rf) = both::<FnCompFast>(\"LZ4_compress_fast\");\n128\t    let (cb, _) = both::<FnBound>(\"LZ4_compressBound\");\n129\t\n130\t    let src = vec![7u8; 4096];\n131\t    let bound = unsafe { cb(4096) } as usize;\n132\t    let mut cdst = vec![SENTINEL; bound];\n133\t    let mut rdst = vec![SENTINEL; bound];\n134\t\n135\t    // rows 3 & 4: srcSize < 0, and srcSize > LZ4_MAX_INPUT_SIZE.\n136\t    // NOTE: we pass a LYING srcSize with a real (small) buffer. This is safe\n137\t    // because the C rejects the size BEFORE touching `src` (lz4.c:1360).\n138\t    let bad_sizes: Vec<c_int> = vec![\n139\t        c_int::MIN,\n140\t        -1_000_000,\n141\t        -1,                              // row 3\n142\t        LZ4_MAX_INPUT_SIZE as c_int + 1, // row 4\n143\t        0x7FFF_FFFF,\n144\t        c_int::MAX,\n145\t    ];\n146\t    for &n in &bad_sizes {\n147\t        let cv = unsafe {\n148\t            cd(\n149\t                src.as_ptr() as *const c_char,\n150\t                cdst.as_mut_ptr() as *mut c_char,\n151\t                n,\n152\t                bound as c_int,\n153\t            )\n154\t        };\n155\t        let rv = unsafe {\n156\t            rd(\n157\t                src.as_ptr() as *const c_char,\n158\t                rdst.as_mut_ptr() as *mut c_char,\n159\t                n,\n160\t                bound as c_int,\n161\t            )\n162\t        };\n163\t        assert_eq!(cv, rv, \"LZ4_compress_default srcSize={}\", n);\n164\t        assert_eq!(cv, 0, \"rows 3/4: srcSize={} must return 0\", n);\n165\t        assert_bytes_eq(\n166\t            &format!(\"rows 3/4 dst untouched srcSize={}\", n),\n167\t            &cdst,\n168\t            &rdst,\n169\t        );\n170\t    }\n171\t\n172\t    // row 7: srcSize == 0 AND dstCapacity <= 0  -> 0\n173\t    for &cap in &[c_int::MIN, -1, 0] {\n174\t        let cv = unsafe {\n175\t            cd(\n176\t                src.as_ptr() as *const c_char,\n177\t                cdst.as_mut_ptr() as *mut c_char,\n178\t                0,\n179\t                cap,\n180\t            )\n181\t        };\n182\t        let rv = unsafe {\n183\t            rd(\n184\t                src.as_ptr() as *const c_char,\n185\t                rdst.as_mut_ptr() as *mut c_char,\n186\t                0,\n187\t                cap,\n188\t            )\n189\t        };\n190\t        assert_eq!(cv, rv, \"row 7: srcSize=0 dstCapacity={}\", cap);\n191\t        assert_eq!(cv, 0, \"row 7: srcSize=0 dstCapacity={} must return 0\", cap);\n192\t    }\n193\t\n194\t    // row 8: srcSize == 0 with dstCapacity >= 1 -> returns 1 (writes one 0 byte)\n195\t    let mut cdst1 = vec![SENTINEL; 8];\n196\t    let mut rdst1 = vec![SENTINEL; 8];\n197\t    let cv = unsafe {\n198\t        cd(\n199\t            src.as_ptr() as *const c_char,\n200\t            cdst1.as_mut_ptr() as *mut c_char,\n201\t            0,\n202\t            1,\n203\t        )\n204\t    };\n205\t    let rv = unsafe {\n206\t        rd(\n207\t            src.as_ptr() as *const c_char,\n208\t            rdst1.as_mut_ptr() as *mut c_char,\n209\t            0,\n210\t            1,\n211\t        )\n212\t    };\n213\t    assert_eq!(cv, rv, \"row 8: srcSize=0 dstCapacity=1 return\");\n214\t    assert_eq!(cv, 1, \"row 8: must return 1\");\n215\t    assert_bytes_eq(\"row 8: emitted empty block\", &cdst1, &rdst1);\n216\t\n217\t    // Same rejections through LZ4_compress_fast (rows 3/4/7 share the branch).\n218\t    for &n in &bad_sizes {\n219\t        for &acc in &[1i32, 7] {\n220\t            let cv = unsafe {\n221\t                cf(\n222\t                    src.as_ptr() as *const c_char,\n223\t                    cdst.as_mut_ptr() as *mut c_char,\n224\t                    n,\n225\t                    bound as c_int,\n226\t                    acc,\n227\t                )\n228\t            };\n229\t            let rv = unsafe {\n230\t                rf(\n231\t                    src.as_ptr() as *const c_char,\n232\t                    rdst.as_mut_ptr() as *mut c_char,\n233\t                    n,\n234\t                    bound as c_int,\n235\t                    acc,\n236\t                )\n237\t            };\n238\t            assert_eq!(cv, rv, \"LZ4_compress_fast srcSize={} accel={}\", n, acc);\n239\t            assert_eq!(cv, 0, \"rows 3/4 via fast: srcSize={}\", n);\n240\t        }\n241\t    }\n242\t}\n243\t\n244\t#[test]\n245\tfn row_05_compress_fast_continue_bad_input_size() {\n246\t    // row 5: inputSize < 0 or > LZ4_MAX_INPUT_SIZE via the streaming entry.\n247\t    let (c_cs, r_cs) = both::<FnCreateStream>(\"LZ4_createStream\");\n248\t    let (c_fs, r_fs) = both::<FnFreeStream>(\"LZ4_freeStream\");\n249\t    let (c_cc, r_cc) = both::<FnCompContinue>(\"LZ4_compress_fast_continue\");\n250\t    let (cb, _) = both::<FnBound>(\"LZ4_compressBound\");\n251\t\n252\t    let src = vec![3u8; 8192];\n253\t    let bound = unsafe { cb(8192) } as usize;\n254\t    unsafe {\n255\t        let cst = c_cs();\n256\t        let rst = r_cs();\n257\t        for &n in &[\n258\t            c_int::MIN,\n259\t            -1,\n260\t            LZ4_MAX_INPUT_SIZE as c_int + 1,\n261\t            c_int::MAX,\n262\t        ] {\n263\t            let mut cdst = vec![SENTINEL; bound];\n264\t            let mut rdst = vec![SENTINEL; bound];\n265\t            let cv = c_cc(\n266\t                cst,\n267\t                src.as_ptr() as *const c_char,\n268\t                cdst.as_mut_ptr() as *mut c_char,\n269\t                n,\n270\t                bound as c_int,\n271\t                1,\n272\t            );\n273\t            let rv = r_cc(\n274\t                rst,\n275\t                src.as_ptr() as *const c_char,\n276\t                rdst.as_mut_ptr() as *mut c_char,\n277\t                n,\n278\t                bound as c_int,\n279\t                1,\n280\t            );\n281\t            assert_eq!(cv, rv, \"row 5: compress_fast_continue inputSize={}\", n);\n282\t            assert_eq!(cv, 0, \"row 5: inputSize={} must return 0\", n);\n283\t            assert_bytes_eq(&format!(\"row 5 dst inputSize={}\", n), &cdst, &rdst);\n284\t        }\n285\t        assert_eq!(c_fs(cst), r_fs(rst));\n286\t    }\n287\t}\n288\t\n289\t#[test]\n290\tfn row_06_09_23_compress_destsize_rejections() {\n291\t    let (cc, rc) = both::<FnCompDestSize>(\"LZ4_compress_destSize\");\n292\t    let src = vec![9u8; 4096];\n293\t\n294\t    // row 6: *srcSizePtr < 0 or > LZ4_MAX_INPUT_SIZE\n295\t    for &n in &[\n296\t        c_int::MIN,\n297\t        -1,\n298\t        LZ4_MAX_INPUT_SIZE as c_int + 1,\n299\t        c_int::MAX,\n300\t    ] {\n301\t        let mut c_ss = n;\n302\t        let mut r_ss = n;\n303\t        let mut cdst = vec![SENTINEL; 4096];\n304\t        let mut rdst = vec![SENTINEL; 4096];\n305\t        let cv = unsafe {\n306\t            cc(\n307\t                src.as_ptr() as *const c_char,\n308\t                cdst.as_mut_ptr() as *mut c_char,\n309\t                &mut c_ss,\n310\t                4096,\n311\t            )\n312\t        };\n313\t        let rv = unsafe {\n314\t            rc(\n315\t                src.as_ptr() as *const c_char,\n316\t                rdst.as_mut_ptr() as *mut c_char,\n317\t                &mut r_ss,\n318\t                4096,\n319\t            )\n320\t        };\n321\t        assert_eq!(cv, rv, \"row 6: destSize srcSize={}\", n);\n322\t        assert_eq!(c_ss, r_ss, \"row 6: srcSize out-param for {}\", n);\n323\t        assert_bytes_eq(&format!(\"row 6 dst srcSize={}\", n), &cdst, &rdst);\n324\t    }\n325\t\n326\t    // row 9: targetDstSize < 1 while *srcSizePtr >= 1 -> 0\n327\t    for &target in &[c_int::MIN, -5, 0] {\n328\t        let mut c_ss = 4096;\n329\t        let mut r_ss = 4096;\n330\t        let mut cdst = vec![SENTINEL; 64];\n331\t        let mut rdst = vec![SENTINEL; 64];\n332\t        let cv = unsafe {\n333\t            cc(\n334\t                src.as_ptr() as *const c_char,\n335\t                cdst.as_mut_ptr() as *mut c_char,\n336\t                &mut c_ss,\n337\t                target,\n338\t            )\n339\t        };\n340\t        let rv = unsafe {\n341\t            rc(\n342\t                src.as_ptr() as *const c_char,\n343\t                rdst.as_mut_ptr() as *mut c_char,\n344\t                &mut r_ss,\n345\t                target,\n346\t            )\n347\t        };\n348\t        assert_eq!(cv, rv, \"row 9: targetDstSize={}\", target);\n349\t        assert_eq!(cv, 0, \"row 9: targetDstSize={} must return 0\", target);\n350\t        assert_eq!(c_ss, r_ss, \"row 9: srcSize out-param target={}\", target);\n351\t    }\n352\t\n353\t    // row 23: targetDstSize < compressBound -> silently truncates the input and\n354\t    // rewrites *srcSizePtr. Assert both libraries truncate identically.\n355\t    let mut rng = Rng::new(0x2317);\n356\t    for shape in 0..N_SHAPES {\n357\t        let s = gen_shape(&mut rng, shape, 30000);\n358\t        for &target in &[1usize, 2, 5, 17, 100, 1000, 5000] {\n359\t            let mut c_ss = s.len() as c_int;\n360\t            let mut r_ss = s.len() as c_int;\n361\t            let mut cdst = vec![SENTINEL; target + 16];\n362\t            let mut rdst = vec![SENTINEL; target + 16];\n363\t            let cv = unsafe {\n364\t                cc(\n365\t                    s.as_ptr() as *const c_char,\n366\t                    cdst.as_mut_ptr() as *mut c_char,\n367\t                    &mut c_ss,\n368\t                    target as c_int,\n369\t                )\n370\t            };\n371\t            let rv = unsafe {\n372\t                rc(\n373\t                    s.as_ptr() as *const c_char,\n374\t                    rdst.as_mut_ptr() as *mut c_char,\n375\t                    &mut r_ss,\n376\t                    target as c_int,\n377\t                )\n378\t            };\n379\t            let l = format!(\"row 23: shape={} target={}\", shape_name(shape), target);\n380\t            assert_eq!(cv, rv, \"{}: return\", l);\n381\t            assert_eq!(c_ss, r_ss, \"{}: truncated srcSize\", l);\n382\t            assert_bytes_eq(&l, &cdst, &rdst);\n383\t            assert!(\n384\t                c_ss <= s.len() as c_int,\n385\t                \"{}: srcSize must not grow ({} > {})\",\n386\t                l,\n387\t                c_ss,\n388\t                s.len()\n389\t            );\n390\t        }\n391\t    }\n392\t}\n393\t\n394\t// ===========================================================================\n395\t// ERRORS.md rows 10-12 — limitedOutput dstCapacity exhaustion returns 0\n396\t// ===========================================================================\n397\t\n398\t#[test]\n399\tfn row_10_12_limited_output_capacity_exhaustion() {\n400\t    // Sweep EVERY dstCapacity from 0 up to just past the true compressed size,\n401\t    // for every data shape. This necessarily crosses all three overflow checks\n402\t    // (literal length, match length, and last-literal run).\n403\t    let (cd, rd) = both::<FnCompDefault>(\"LZ4_compress_default\");\n404\t    let mut rng = Rng::new(0x1012);\n405\t\n406\t    for shape in 0..N_SHAPES {\n407\t        for &len in &[13usize, 40, 100, 300, 1000, 5000] {\n408\t            let src = gen_shape(&mut rng, shape, len);\n409\t            let real = compress_c(&src).len();\n410\t            for cap in 0..=(real + 4) {\n411\t                let mut cdst = vec![SENTINEL; cap.max(1)];\n412\t                let mut rdst = vec![SENTINEL; cap.max(1)];\n413\t                let cv = unsafe {\n414\t                    cd(\n415\t                        src.as_ptr() as *const c_char,\n416\t                        cdst.as_mut_ptr() as *mut c_char,\n417\t                        len as c_int,\n418\t                        cap as c_int,\n419\t                    )\n420\t                };\n421\t                let rv = unsafe {\n422\t                    rd(\n423\t                        src.as_ptr() as *const c_char,\n424\t                        rdst.as_mut_ptr() as *mut c_char,\n425\t                        len as c_int,\n426\t                        cap as c_int,\n427\t                    )\n428\t                };\n429\t                let l = format!(\n430\t                    \"rows 10-12: shape={} len={} cap={} (real={})\",\n431\t                    shape_name(shape),\n432\t                    len,\n433\t                    cap,\n434\t                    real\n435\t                );\n436\t                assert_eq!(cv, rv, \"{}: return\", l);\n437\t                assert_bytes_eq(&l, &cdst, &rdst);\n438\t                if cap < real {\n439\t                    assert_eq!(cv, 0, \"{}: undersized capacity must return 0\", l);\n440\t                }\n441\t            }\n442\t        }\n443\t    }\n444\t}\n445\t\n446\t// ===========================================================================\n447\t// ERRORS.md rows 15-20 — acceleration clamping (silent \"rejection\")\n448\t// ===========================================================================\n449\t\n450\t#[test]\n451\tfn row_15_20_acceleration_clamping() {\n452\t    let (cf, rf) = both::<FnCompFast>(\"LZ4_compress_fast\");\n453\t    let (cx, rx) = both::<FnCompFastExt>(\"LZ4_compress_fast_extState\");\n454\t    let (cxf, rxf) = both::<FnCompFastExt>(\"LZ4_compress_fast_extState_fastReset\");\n455\t    let (c_cs, r_cs) = both::<FnCreateStream>(\"LZ4_createStream\");\n456\t    let (c_fs, r_fs) = both::<FnFreeStream>(\"LZ4_freeStream\");\n457\t    let (c_cc, r_cc) = both::<FnCompContinue>(\"LZ4_compress_fast_continue\");\n458\t    let (cb, _) = both::<FnBound>(\"LZ4_compressBound\");\n459\t    let ssz = stream_size();\n460\t\n461\t    let mut rng = Rng::new(0x1520);\n462\t    let src = gen_shape(&mut rng, 4, 20000);\n463\t    let bound = unsafe { cb(src.len() as c_int) } as usize;\n464\t\n465\t    // Compress once at the clamp TARGET to obtain the reference output.\n466\t    let reference = |acc: c_int| -> Vec<u8> {\n467\t        let mut d = vec![SENTINEL; bound];\n468\t        let n = unsafe {\n469\t            cf(\n470\t                src.as_ptr() as *const c_char,\n471\t                d.as_mut_ptr() as *mut c_char,\n472\t                src.len() as c_int,\n473\t                bound as c_int,\n474\t                acc,\n475\t            )\n476\t        };\n477\t        d.truncate(n.max(0) as usize);\n478\t        d\n479\t    };\n480\t    let ref_1 = reference(1);\n481\t    let ref_max = reference(LZ4_ACCELERATION_MAX);\n482\t\n483\t    // rows 15/16 on LZ4_compress_fast\n484\t    for &acc in &[c_int::MIN, -12345, -1, 0] {\n485\t        let mut cdst = vec![SENTINEL; bound];\n486\t        let mut rdst = vec![SENTINEL; bound];\n487\t        let cv = unsafe {\n488\t            cf(\n489\t                src.as_ptr() as *const c_char,\n490\t                cdst.as_mut_ptr() as *mut c_char,\n491\t                src.len() as c_int,\n492\t                bound as c_int,\n493\t                acc,\n494\t            )\n495\t        };\n496\t        let rv = unsafe {\n497\t            rf(\n498\t                src.as_ptr() as *const c_char,\n499\t                rdst.as_mut_ptr() as *mut c_char,\n500\t                src.len() as c_int,\n501\t                bound as c_int,\n502\t                acc,\n503\t            )\n504\t        };\n505\t        assert_eq!(cv, rv, \"row 15: accel={}\", acc);\n506\t        assert_bytes_eq(&format!(\"row 15: accel={}\", acc), &cdst, &rdst);\n507\t        assert_eq!(\n508\t            &cdst[..cv as usize],\n509\t            &ref_1[..],\n510\t            \"row 15: accel={} must behave exactly like accel=1\",\n511\t            acc\n512\t        );\n513\t    }\n514\t    for &acc in &[LZ4_ACCELERATION_MAX + 1, 1_000_000, c_int::MAX] {\n515\t        let mut cdst = vec![SENTINEL; bound];\n516\t        let mut rdst = vec![SENTINEL; bound];\n517\t        let cv = unsafe {\n518\t            cf(\n519\t                src.as_ptr() as *const c_char,\n520\t                cdst.as_mut_ptr() as *mut c_char,\n521\t                src.len() as c_int,\n522\t                bound as c_int,\n523\t                acc,\n524\t            )\n525\t        };\n526\t        let rv = unsafe {\n527\t            rf(\n528\t                src.as_ptr() as *const c_char,\n529\t                rdst.as_mut_ptr() as *mut c_char,\n530\t                src.len() as c_int,\n531\t                bound as c_int,\n532\t                acc,\n533\t            )\n534\t        };\n535\t        assert_eq!(cv, rv, \"row 16: accel={}\", acc);\n536\t        assert_bytes_eq(&format!(\"row 16: accel={}\", acc), &cdst, &rdst);\n537\t        assert_eq!(\n538\t            &cdst[..cv as usize],\n539\t            &ref_max[..],\n540\t            \"row 16: accel={} must behave exactly like accel=LZ4_ACCELERATION_MAX\",\n541\t            acc\n542\t        );\n543\t    }\n544\t\n545\t    // rows 17/18 on LZ4_compress_fast_extState_fastReset, plus extState itself\n546\t    for (name, cfn, rfn) in [\n547\t        (\"LZ4_compress_fast_extState\", cx, rx),\n548\t        (\"LZ4_compress_fast_extState_fastReset\", cxf, rxf),\n549\t    ] {\n550\t        for &acc in &[\n551\t            c_int::MIN,\n552\t            -1,\n553\t            0,\n554\t            1,\n555\t            LZ4_ACCELERATION_MAX,\n556\t            LZ4_ACCELERATION_MAX + 1,\n557\t            c_int::MAX,\n558\t        ] {\n559\t            let mut cstate = AlignedBuf::new(ssz, 64);\n560\t            let mut rstate = AlignedBuf::new(ssz, 64);\n561\t            let mut cdst = vec![SENTINEL; bound];\n562\t            let mut rdst = vec![SENTINEL; bound];\n563\t            let cv = unsafe {\n564\t                cfn(\n565\t                    cstate.as_mut_ptr() as *mut c_void,\n566\t                    src.as_ptr() as *const c_char,\n567\t                    cdst.as_mut_ptr() as *mut c_char,\n568\t                    src.len() as c_int,\n569\t                    bound as c_int,\n570\t                    acc,\n571\t                )\n572\t            };\n573\t            let rv = unsafe {\n574\t                rfn(\n575\t                    rstate.as_mut_ptr() as *mut c_void,\n576\t                    src.as_ptr() as *const c_char,\n577\t                    rdst.as_mut_ptr() as *mut c_char,\n578\t                    src.len() as c_int,\n579\t                    bound as c_int,\n580\t                    acc,\n581\t                )\n582\t            };\n583\t            assert_eq!(cv, rv, \"rows 17/18: {} accel={}\", name, acc);\n584\t            assert_bytes_eq(&format!(\"rows 17/18: {} accel={}\", name, acc), &cdst, &rdst);\n585\t        }\n586\t    }\n587\t\n588\t    // rows 19/20 on LZ4_compress_fast_continue\n589\t    unsafe {\n590\t        for &acc in &[\n591\t            c_int::MIN,\n592\t            -1,\n593\t            0,\n594\t            1,\n595\t            LZ4_ACCELERATION_MAX,\n596\t            LZ4_ACCELERATION_MAX + 1,\n597\t            c_int::MAX,\n598\t        ] {\n599\t            let cst = c_cs();\n600\t            let rst = r_cs();\n601\t            let mut cdst = vec![SENTINEL; bound];\n602\t            let mut rdst = vec![SENTINEL; bound];\n603\t            let cv = c_cc(\n604\t                cst,\n605\t                src.as_ptr() as *const c_char,\n606\t                cdst.as_mut_ptr() as *mut c_char,\n607\t                src.len() as c_int,\n608\t                bound as c_int,\n609\t                acc,\n610\t            );\n611\t            let rv = r_cc(\n612\t                rst,\n613\t                src.as_ptr() as *const c_char,\n614\t                rdst.as_mut_ptr() as *mut c_char,\n615\t                src.len() as c_int,\n616\t                bound as c_int,\n617\t                acc,\n618\t            );\n619\t            assert_eq!(cv, rv, \"rows 19/20: continue accel={}\", acc);\n620\t            assert_bytes_eq(&format!(\"rows 19/20: accel={}\", acc), &cdst, &rdst);\n621\t            assert_eq!(c_fs(cst), r_fs(rst));\n622\t        }\n623\t    }\n624\t}\n625\t\n626\t// ===========================================================================\n627\t// ERRORS.md rows 26-28 — LZ4_initStream rejects NULL / too small / misaligned\n628\t// ===========================================================================\n629\t\n630\t#[test]\n631\tfn row_26_28_init_stream_rejections() {\n632\t    let (c_is, r_is) = both::<FnInitStream>(\"LZ4_initStream\");\n633\t    let ssz = stream_size();\n634\t\n635\t    unsafe {\n636\t        // row 26: buffer == NULL -> NULL\n637\t        for &sz in &[0usize, 1, ssz, ssz * 2] {\n638\t            let cp = c_is(std::ptr::null_mut(), sz);\n639\t            let rp = r_is(std::ptr::null_mut(), sz);\n640\t            assert!(cp.is_null(), \"row 26: C must return NULL for NULL buffer\");\n641\t            assert_eq!(\n642\t                cp.is_null(),\n643\t                rp.is_null(),\n644\t                \"row 26: NULL buffer size={} nullness\",\n645\t                sz\n646\t            );\n647\t        }\n648\t\n649\t        // row 27: size < sizeof(LZ4_stream_t) -> NULL\n650\t        let mut buf = AlignedBuf::new(ssz, 64);\n651\t        for &sz in &[0usize, 1, 8, ssz / 2, ssz - 1] {\n652\t            let cp = c_is(buf.as_mut_ptr() as *mut c_void, sz);\n653\t            let rp = r_is(buf.as_mut_ptr() as *mut c_void, sz);\n654\t            assert!(cp.is_null(), \"row 27: C must reject size={} (< {})\", sz, ssz);\n655\t            assert_eq!(\n656\t                cp.is_null(),\n657\t                rp.is_null(),\n658\t                \"row 27: size={} nullness (C={:?} Rust={:?})\",\n659\t                sz,\n660\t                cp,\n661\t                rp\n662\t            );\n663\t        }\n664\t        // accept boundary\n665\t        let cp = c_is(buf.as_mut_ptr() as *mut c_void, ssz);\n666\t        let rp = r_is(buf.as_mut_ptr() as *mut c_void, ssz);\n667\t        assert!(!cp.is_null(), \"row 27: size == sizeof must be accepted\");\n668\t        assert_eq!(cp.is_null(), rp.is_null(), \"row 27: accept boundary\");\n669\t\n670\t        // row 28: misaligned buffer -> NULL. Try every offset 1..=7 from an\n671\t        // 8-byte-aligned base (LZ4_stream_t requires natural alignment).\n672\t        for off in 1..8usize {\n673\t            let mut mb = AlignedBuf::with_offset(ssz + 8, 64, off);\n674\t            let cp = c_is(mb.as_mut_ptr() as *mut c_void, ssz);\n675\t            let rp = r_is(mb.as_mut_ptr() as *mut c_void, ssz);\n676\t            assert_eq!(\n677\t                cp.is_null(),\n678\t                rp.is_null(),\n679\t                \"row 28: misalign offset={} nullness (C={:?} Rust={:?})\",\n680\t                off,\n681\t                cp,\n682\t                rp\n683\t            );\n684\t        }\n685\t    }\n686\t}\n687\t\n688\t// ===========================================================================\n689\t// ERRORS.md rows 30, 86 — free-on-NULL is supported and returns 0\n690\t// ===========================================================================\n691\t\n692\t#[test]\n693\tfn row_30_86_free_null_pointers() {\n694\t    let (c_fs, r_fs) = both::<FnFreeStream>(\"LZ4_freeStream\");\n695\t    let (c_fd, r_fd) = both::<FnFreeStreamDecode>(\"LZ4_freeStreamDecode\");\n696\t    unsafe {\n697\t        // row 30\n698\t        let cv = c_fs(std::ptr::null_mut());\n699\t        let rv = r_fs(std::ptr::null_mut());\n700\t        assert_eq!(cv, rv, \"row 30: LZ4_freeStream(NULL)\");\n701\t        assert_eq!(cv, 0, \"row 30: LZ4_freeStream(NULL) must return 0\");\n702\t        // row 86\n703\t        let cv = c_fd(std::ptr::null_mut());\n704\t        let rv = r_fd(std::ptr::null_mut());\n705\t        assert_eq!(cv, rv, \"row 86: LZ4_freeStreamDecode(NULL)\");\n706\t        assert_eq!(cv, 0, \"row 86: LZ4_freeStreamDecode(NULL) must return 0\");\n707\t    }\n708\t}\n709\t\n710\t// ===========================================================================\n711\t// ERRORS.md rows 31-32 — LZ4_loadDict / LZ4_loadDictSlow size handling\n712\t// ===========================================================================\n713\t\n714\t#[test]\n715\tfn row_31_32_load_dict_size_handling() {\n716\t    let (c_cs, r_cs) = both::<FnCreateStream>(\"LZ4_createStream\");\n717\t    let (c_fs, r_fs) = both::<FnFreeStream>(\"LZ4_freeStream\");\n718\t    let ssz = stream_size();\n719\t\n720\t    let dict = vec![0x5Au8; 100_000];\n721\t\n722\t    for name in [\"LZ4_loadDict\", \"LZ4_loadDictSlow\"] {\n723\t        let (c_ld, r_ld) = both::<FnLoadDict>(name);\n724\t        unsafe {\n725\t            // row 31: dictSize < HASH_UNIT (8 on 64-bit), incl. 0 and negative\n726\t            //         -> returns 0, no dictionary registered\n727\t            for &n in &[c_int::MIN, -100, -1, 0, 1, 2, 3, 4, 5, 6, 7] {\n728\t                let cst = c_cs();\n729\t                let rst = r_cs();\n730\t                let cv = c_ld(cst, dict.as_ptr() as *const c_char, n);\n731\t                let rv = r_ld(rst, dict.as_ptr() as *const c_char, n);\n732\t                assert_eq!(cv, rv, \"row 31: {}(dictSize={})\", name, n);\n733\t                assert_eq!(cv, 0, \"row 31: {}(dictSize={}) must return 0\", name, n);\n734\t                assert_bytes_eq(\n735\t                    &format!(\"row 31: {} state dictSize={}\", name, n),\n736\t                    std::slice::from_raw_parts(cst as *const u8, ssz),\n737\t                    std::slice::from_raw_parts(rst as *const u8, ssz),\n738\t                );\n739\t                assert_eq!(c_fs(cst), r_fs(rst));\n740\t            }\n741\t            // accept boundary: exactly HASH_UNIT\n742\t            for &n in &[8i32, 9, 16] {\n743\t                let cst = c_cs();\n744\t                let rst = r_cs();\n745\t                let cv = c_ld(cst, dict.as_ptr() as *const c_char, n);\n746\t                let rv = r_ld(rst, dict.as_ptr() as *const c_char, n);\n747\t                assert_eq!(cv, rv, \"row 31 boundary: {}(dictSize={})\", name, n);\n748\t                assert_eq!(c_fs(cst), r_fs(rst));\n749\t            }\n750\t            // row 32: dictSize > 64 KB -> retains only the LAST 64 KB, returns 65536\n751\t            for &n in &[65536i32 + 1, 70000, 100_000] {\n752\t                let cst = c_cs();\n753\t                let rst = r_cs();\n754\t                let cv = c_ld(cst, dict.as_ptr() as *const c_char, n);\n755\t                let rv = r_ld(rst, dict.as_ptr() as *const c_char, n);\n756\t                assert_eq!(cv, rv, \"row 32: {}(dictSize={})\", name, n);\n757\t                assert_eq!(\n758\t                    cv, 65536,\n759\t                    \"row 32: {}(dictSize={}) must return 65536\",\n760\t                    name, n\n761\t                );\n762\t                assert_bytes_eq(\n763\t                    &format!(\"row 32: {} state dictSize={}\", name, n),\n764\t                    std::slice::from_raw_parts(cst as *const u8, ssz),\n765\t                    std::slice::from_raw_parts(rst as *const u8, ssz),\n766\t                );\n767\t                assert_eq!(c_fs(cst), r_fs(rst));\n768\t            }\n769\t            // NULL dictionary with size 0 is the documented \"reset\" usage.\n770\t            let cst = c_cs();\n771\t            let rst = r_cs();\n772\t            let cv = c_ld(cst, std::ptr::null(), 0);\n773\t            let rv = r_ld(rst, std::ptr::null(), 0);\n774\t            assert_eq!(cv, rv, \"row 31: {}(NULL, 0)\", name);\n775\t            assert_eq!(c_fs(cst), r_fs(rst));\n776\t        }\n777\t    }\n778\t}\n779\t\n780\t#[test]\n781\tfn load_dict_internal_out_of_range_enum() {\n782\t    // `LZ4_loadDict_internal`'s 4th parameter is a C enum\n783\t    // `LoadDict_mode_e { _ld_fast = 0, _ld_slow = 1 }`. A C enum accepts ANY\n784\t    // int across the FFI boundary, so values with no valid variant are real\n785\t    // inputs that the C handles (its only test is `if (_ld == _ld_slow)`).\n786\t    // The Rust must handle them identically.\n787\t    let (c_ld, r_ld) = both::<FnLoadDictInternal>(\"LZ4_loadDict_internal\");\n788\t    let (c_cs, r_cs) = both::<FnCreateStream>(\"LZ4_createStream\");\n789\t    let (c_fs, r_fs) = both::<FnFreeStream>(\"LZ4_freeStream\");\n790\t    let ssz = stream_size();\n791\t    let dict = vec![0x33u8; 40000];\n792\t\n793\t    unsafe {\n794\t        for &mode in &[\n795\t            c_int::MIN,\n796\t            -2,\n797\t            -1,\n798\t            0, // _ld_fast\n799\t            1, // _ld_slow\n800\t            2, // out of range\n801\t            3,\n802\t            7,\n803\t            255,\n804\t            256,\n805\t            65535,\n806\t            c_int::MAX,\n807\t        ] {\n808\t            for &dsz in &[0i32, 8, 4096, 40000] {\n809\t                let cst = c_cs();\n810\t                let rst = r_cs();\n811\t                let cv = c_ld(cst, dict.as_ptr() as *const c_char, dsz, mode);\n812\t                let rv = r_ld(rst, dict.as_ptr() as *const c_char, dsz, mode);\n813\t                assert_eq!(\n814\t                    cv, rv,\n815\t                    \"LZ4_loadDict_internal(mode={}, dictSize={}) return\",\n816\t                    mode, dsz\n817\t                );\n818\t                assert_bytes_eq(\n819\t                    &format!(\n820\t                        \"LZ4_loadDict_internal(mode={}, dictSize={}) STATE\",\n821\t                        mode, dsz\n822\t                    ),\n823\t                    std::slice::from_raw_parts(cst as *const u8, ssz),\n824\t                    std::slice::from_raw_parts(rst as *const u8, ssz),\n825\t                );\n826\t                assert_eq!(c_fs(cst), r_fs(rst));\n827\t            }\n828\t        }\n829\t    }\n830\t}\n831\t\n832\t// ===========================================================================\n833\t// ERRORS.md rows 33-34 — LZ4_attach_dictionary silent detach\n834\t// ===========================================================================\n835\t\n836\t#[test]\n837\tfn row_33_34_attach_dictionary_edge_cases() {\n838\t    let (c_cs, r_cs) = both::<FnCreateStream>(\"LZ4_createStream\");\n839\t    let (c_fs, r_fs) = both::<FnFreeStream>(\"LZ4_freeStream\");\n840\t    let (c_ad, r_ad) = both::<FnAttachDict>(\"LZ4_attach_dictionary\");\n841\t    let (c_ld, r_ld) = both::<FnLoadDict>(\"LZ4_loadDict\");\n842\t    let (c_cc, r_cc) = both::<FnCompContinue>(\"LZ4_compress_fast_continue\");\n843\t    let (cb, _) = both::<FnBound>(\"LZ4_compressBound\");\n844\t    let ssz = stream_size();\n845\t\n846\t    let mut rng = Rng::new(0x3334);\n847\t    let src = gen_shape(&mut rng, 5, 20000);\n848\t    let bound = unsafe { cb(src.len() as c_int) } as usize;\n849\t\n850\t    unsafe {\n851\t        // row 33: dictionaryStream == NULL -> silently detaches\n852\t        let cst = c_cs();\n853\t        let rst = r_cs();\n854\t        c_ad(cst, std::ptr::null());\n855\t        r_ad(rst, std::ptr::null());\n856\t        assert_bytes_eq(\n857\t            \"row 33: attach_dictionary(NULL) STATE\",\n858\t            std::slice::from_raw_parts(cst as *const u8, ssz),\n859\t            std::slice::from_raw_parts(rst as *const u8, ssz),\n860\t        );\n861\t        let mut cdst = vec![SENTINEL; bound];\n862\t        let mut rdst = vec![SENTINEL; bound];\n863\t        let cv = c_cc(\n864\t            cst,\n865\t            src.as_ptr() as *const c_char,\n866\t            cdst.as_mut_ptr() as *mut c_char,\n867\t            src.len() as c_int,\n868\t            bound as c_int,\n869\t            1,\n870\t        );\n871\t        let rv = r_cc(\n872\t            rst,\n873\t            src.as_ptr() as *const c_char,\n874\t            rdst.as_mut_ptr() as *mut c_char,\n875\t            src.len() as c_int,\n876\t            bound as c_int,\n877\t            1,\n878\t        );\n879\t        assert_eq!(cv, rv, \"row 33: compress after NULL attach\");\n880\t        assert_bytes_eq(\"row 33: output after NULL attach\", &cdst, &rdst);\n881\t        assert_eq!(c_fs(cst), r_fs(rst));\n882\t\n883\t        // row 34: dictionary stream whose dictSize == 0 -> NOT attached.\n884\t        // Build it by loading a dict too small to register (see row 31).\n885\t        let dict = vec![0x77u8; 4];\n886\t        for &tiny in &[0i32, 1, 4, 7] {\n887\t            let cdict = c_cs();\n888\t            let rdict = r_cs();\n889\t            assert_eq!(\n890\t                c_ld(cdict, dict.as_ptr() as *const c_char, tiny.min(4)),\n891\t                r_ld(rdict, dict.as_ptr() as *const c_char, tiny.min(4)),\n892\t                \"row 34: loadDict tiny={}\",\n893\t                tiny\n894\t            );\n895\t            let cst = c_cs();\n896\t            let rst = r_cs();\n897\t            c_ad(cst, cdict as *const c_void);\n898\t            r_ad(rst, rdict as *const c_void);\n899\t            assert_bytes_eq(\n900\t                &format!(\"row 34: STATE after attach of empty dict (tiny={})\", tiny),\n901\t                std::slice::from_raw_parts(cst as *const u8, ssz),\n902\t                std::slice::from_raw_parts(rst as *const u8, ssz),\n903\t            );\n904\t            let mut cdst = vec![SENTINEL; bound];\n905\t            let mut rdst = vec![SENTINEL; bound];\n906\t            let cv = c_cc(\n907\t                cst,\n908\t                src.as_ptr() as *const c_char,\n909\t                cdst.as_mut_ptr() as *mut c_char,\n910\t                src.len() as c_int,\n911\t                bound as c_int,\n912\t                1,\n913\t            );\n914\t            let rv = r_cc(\n915\t                rst,\n916\t                src.as_ptr() as *const c_char,\n917\t                rdst.as_mut_ptr() as *mut c_char,\n918\t                src.len() as c_int,\n919\t                bound as c_int,\n920\t                1,\n921\t            );\n922\t            assert_eq!(cv, rv, \"row 34: compress return tiny={}\", tiny);\n923\t            assert_bytes_eq(&format!(\"row 34: output tiny={}\", tiny), &cdst, &rdst);\n924\t            assert_eq!(c_fs(cst), r_fs(rst));\n925\t            assert_eq!(c_fs(cdict), r_fs(rdict));\n926\t        }\n927\t    }\n928\t}\n929\t\n930\t// ===========================================================================\n931\t// ERRORS.md rows 35-36 — LZ4_saveDict clamping\n932\t// ===========================================================================\n933\t\n934\t#[test]\n935\tfn row_35_36_save_dict_clamping() {\n936\t    let (c_cs, r_cs) = both::<FnCreateStream>(\"LZ4_createStream\");\n937\t    let (c_fs, r_fs) = both::<FnFreeStream>(\"LZ4_freeStream\");\n938\t    let (c_ld, r_ld) = both::<FnLoadDict>(\"LZ4_loadDict\");\n939\t    let (c_cc, r_cc) = both::<FnCompContinue>(\"LZ4_compress_fast_continue\");\n940\t    let (c_sv, r_sv) = both::<FnSaveDict>(\"LZ4_saveDict\");\n941\t    let (cb, _) = both::<FnBound>(\"LZ4_compressBound\");\n942\t\n943\t    let mut rng = Rng::new(0x3536);\n944\t    let dict = gen_shape(&mut rng, 3, 100_000);\n945\t\n946\t    // Build streams with differing amounts of retained history so that both\n947\t    // clamp branches (64 KB cap, and \"more than exists\") are hit.\n948\t    for &(dict_len, blk_len) in &[\n949\t        (0usize, 100usize),\n950\t        (8, 100),\n951\t        (1000, 100),\n952\t        (65536, 100),\n953\t        (100_000, 100),\n954\t        (0, 70000),\n955\t        (1000, 70000),\n956\t    ] {\n957\t        let blk = gen_shape(&mut rng, 4, blk_len);\n958\t        // row 35: dictSize > 64 KB (and negative -> huge U32) -> clamp to 65536\n959\t        // row 36: dictSize > available history -> clamp to available\n960\t        for &want in &[\n961\t            c_int::MIN,\n962\t            -100_000,\n963\t            -1,\n964\t            0,\n965\t            1,\n966\t            8,\n967\t            100,\n968\t            1000,\n969\t            65535,\n970\t            65536,\n971\t            65537,\n972\t            100_000,\n973\t            c_int::MAX,\n974\t        ] {\n975\t            unsafe {\n976\t                let cst = c_cs();\n977\t                let rst = r_cs();\n978\t                let dptr = if dict_len == 0 {\n979\t                    std::ptr::null()\n980\t                } else {\n981\t                    dict.as_ptr() as *const c_char\n982\t                };\n983\t                assert_eq!(\n984\t                    c_ld(cst, dptr, dict_len as c_int),\n985\t                    r_ld(rst, dptr, dict_len as c_int),\n986\t                    \"rows 35/36: loadDict {}\",\n987\t                    dict_len\n988\t                );\n989\t                let bound = cb(blk_len as c_int) as usize;\n990\t                let mut cd = vec![SENTINEL; bound];\n991\t                let mut rd = vec![SENTINEL; bound];\n992\t                assert_eq!(\n993\t                    c_cc(\n994\t                        cst,\n995\t                        blk.as_ptr() as *const c_char,\n996\t                        cd.as_mut_ptr() as *mut c_char,\n997\t                        blk_len as c_int,\n998\t                        bound as c_int,\n999\t                        1\n1000\t                    ),\n1001\t                    r_cc(\n1002\t                        rst,\n1003\t                        blk.as_ptr() as *const c_char,\n1004\t                        rd.as_mut_ptr() as *mut c_char,\n1005\t                        blk_len as c_int,\n1006\t                        bound as c_int,\n1007\t                        1\n1008\t                    ),\n1009\t                    \"rows 35/36: compress\"\n1010\t                );\n1011\t\n1012\t                // A generously sized safe buffer so a clamp cannot overflow it.\n1013\t                let safe_len = 200_000usize;\n1014\t                let mut csafe = vec![SENTINEL; safe_len];\n1015\t                let mut rsafe = vec![SENTINEL; safe_len];\n1016\t                let cv = c_sv(cst, csafe.as_mut_ptr() as *mut c_char, want);\n1017\t                let rv = r_sv(rst, rsafe.as_mut_ptr() as *mut c_char, want);\n1018\t                let l = format!(\n1019\t                    \"rows 35/36: dict={} blk={} maxDictSize={}\",\n1020\t                    dict_len, blk_len, want\n1021\t                );\n1022\t                assert_eq!(cv, rv, \"{}: return\", l);\n1023\t                assert!(\n1024\t                    cv >= 0 && cv <= 65536,\n1025\t                    \"{}: saveDict must return 0..=65536, got {}\",\n1026\t                    l,\n1027\t                    cv\n1028\t                );\n1029\t                assert_bytes_eq(&l, &csafe, &rsafe);\n1030\t                assert_eq!(c_fs(cst), r_fs(rst));\n1031\t            }\n1032\t        }\n1033\t    }\n1034\t}\n1035\t\n1036\t// ===========================================================================\n1037\t// ERRORS.md rows 38-39 — silent dictionary discard / shrink in continue\n1038\t// ===========================================================================\n1039\t\n1040\t#[test]\n1041\tfn row_38_39_continue_dictionary_discard_and_overlap() {\n1042\t    let (c_cs, r_cs) = both::<FnCreateStream>(\"LZ4_createStream\");\n1043\t    let (c_fs, r_fs) = both::<FnFreeStream>(\"LZ4_freeStream\");\n1044\t    let (c_ld, r_ld) = both::<FnLoadDict>(\"LZ4_loadDict\");\n1045\t    let (c_cc, r_cc) = both::<FnCompContinue>(\"LZ4_compress_fast_continue\");\n1046\t    let (cb, _) = both::<FnBound>(\"LZ4_compressBound\");\n1047\t    let ssz = stream_size();\n1048\t\n1049\t    let mut rng = Rng::new(0x3839);\n1050\t\n1051\t    // row 38: registered dictSize < 4 -> dictionary silently discarded.\n1052\t    // (loadDict already refuses < 8, so drive it via a tiny saved history.)\n1053\t    for &dsz in &[0i32, 1, 2, 3, 8, 9] {\n1054\t        let dict = gen_shape(&mut rng, 2, 64);\n1055\t        let src = gen_shape(&mut rng, 2, 5000);\n1056\t        let bound = unsafe { cb(src.len() as c_int) } as usize;\n1057\t        unsafe {\n1058\t            let cst = c_cs();\n1059\t            let rst = r_cs();\n1060\t            assert_eq!(\n1061\t                c_ld(cst, dict.as_ptr() as *const c_char, dsz),\n1062\t                r_ld(rst, dict.as_ptr() as *const c_char, dsz),\n1063\t                \"row 38: loadDict {}\",\n1064\t                dsz\n1065\t            );\n1066\t            let mut cd = vec![SENTINEL; bound];\n1067\t            let mut rd = vec![SENTINEL; bound];\n1068\t            let cv = c_cc(\n1069\t                cst,\n1070\t                src.as_ptr() as *const c_char,\n1071\t                cd.as_mut_ptr() as *mut c_char,\n1072\t                src.len() as c_int,\n1073\t                bound as c_int,\n1074\t                1,\n1075\t            );\n1076\t            let rv = r_cc(\n1077\t                rst,\n1078\t                src.as_ptr() as *const c_char,\n1079\t                rd.as_mut_ptr() as *mut c_char,\n1080\t                src.len() as c_int,\n1081\t                bound as c_int,\n1082\t                1,\n1083\t            );\n1084\t            assert_eq!(cv, rv, \"row 38: dictSize={} return\", dsz);\n1085\t            assert_bytes_eq(&format!(\"row 38: dictSize={}\", dsz), &cd, &rd);\n1086\t            assert_bytes_eq(\n1087\t                &format!(\"row 38: dictSize={} STATE\", dsz),\n1088\t                std::slice::from_raw_parts(cst as *const u8, ssz),\n1089\t                std::slice::from_raw_parts(rst as *const u8, ssz),\n1090\t            );\n1091\t            assert_eq!(c_fs(cst), r_fs(rst));\n1092\t        }\n1093\t    }\n1094\t\n1095\t    // row 39: the new source OVERLAPS the registered dictionary. Achieved by\n1096\t    // loading a dictionary from one buffer, then compressing from a region of\n1097\t    // that SAME buffer that starts inside the dictionary range.\n1098\t    let buf = gen_shape(&mut rng, 5, 200_000);\n1099\t    for &(dict_off, dict_len, src_off, src_len) in &[\n1100\t        (0usize, 65536usize, 30000usize, 20000usize), // src starts inside dict\n1101\t        (0, 65536, 65000, 20000),                     // src straddles dict end\n1102\t        (0, 65536, 65536, 20000),                     // src starts exactly at dict end\n1103\t        (0, 65536, 65540, 20000),                     // src starts just past dict end\n1104\t        (0, 20000, 10000, 5000),                      // small dict, deep overlap\n1105\t        (0, 20000, 19999, 5000),\n1106\t        (10000, 30000, 15000, 30000),\n1107\t    ] {\n1108\t        let bound = unsafe { cb(src_len as c_int) } as usize;\n1109\t        unsafe {\n1110\t            let cst = c_cs();\n1111\t            let rst = r_cs();\n1112\t            let dptr = buf.as_ptr().add(dict_off) as *const c_char;\n1113\t            assert_eq!(\n1114\t                c_ld(cst, dptr, dict_len as c_int),\n1115\t                r_ld(rst, dptr, dict_len as c_int),\n1116\t                \"row 39: loadDict\"\n1117\t            );\n1118\t            let sptr = buf.as_ptr().add(src_off) as *const c_char;\n1119\t            let mut cd = vec![SENTINEL; bound];\n1120\t            let mut rd = vec![SENTINEL; bound];\n1121\t            let cv = c_cc(\n1122\t                cst,\n1123\t                sptr,\n1124\t                cd.as_mut_ptr() as *mut c_char,\n1125\t                src_len as c_int,\n1126\t                bound as c_int,\n1127\t                1,\n1128\t            );\n1129\t            let rv = r_cc(\n1130\t                rst,\n1131\t                sptr,\n1132\t                rd.as_mut_ptr() as *mut c_char,\n1133\t                src_len as c_int,\n1134\t                bound as c_int,\n1135\t                1,\n1136\t            );\n1137\t            let l = format!(\n1138\t                \"row 39: dict[{}..+{}] src[{}..+{}]\",\n1139\t                dict_off, dict_len, src_off, src_len\n1140\t            );\n1141\t            assert_eq!(cv, rv, \"{}: return\", l);\n1142\t            assert_bytes_eq(&l, &cd, &rd);\n1143\t            assert_bytes_eq(\n1144\t                &format!(\"{} STATE\", l),\n1145\t                std::slice::from_raw_parts(cst as *const u8, ssz),\n1146\t                std::slice::from_raw_parts(rst as *const u8, ssz),\n1147\t            );\n1148\t            assert_eq!(c_fs(cst), r_fs(rst));\n1149\t        }\n1150\t    }\n1151\t}\n1152\t\n1153\t// ===========================================================================\n1154\t// ERRORS.md rows 42-44 — LZ4_decoderRingBufferSize\n1155\t// ===========================================================================\n1156\t\n1157\t#[test]\n1158\tfn row_42_44_decoder_ring_buffer_size() {\n1159\t    let (c, r) = both::<FnRingBuf>(\"LZ4_decoderRingBufferSize\");\n1160\t    unsafe {\n1161\t        // row 42: maxBlockSize < 0 -> 0\n1162\t        for &v in &[c_int::MIN, -1_000_000, -1] {\n1163\t            let cv = c(v);\n1164\t            let rv = r(v);\n1165\t            assert_eq!(cv, rv, \"row 42: ringBufferSize({})\", v);\n1166\t            assert_eq!(cv, 0, \"row 42: ringBufferSize({}) must be 0\", v);\n1167\t        }\n1168\t        // row 43: maxBlockSize > LZ4_MAX_INPUT_SIZE -> 0\n1169\t        for &v in &[\n1170\t            LZ4_MAX_INPUT_SIZE as c_int + 1,\n1171\t            0x7FFF_FFFF,\n1172\t            c_int::MAX,\n1173\t        ] {\n1174\t            let cv = c(v);\n1175\t            let rv = r(v);\n1176\t            assert_eq!(cv, rv, \"row 43: ringBufferSize({})\", v);\n1177\t            assert_eq!(cv, 0, \"row 43: ringBufferSize({}) must be 0\", v);\n1178\t        }\n1179\t        // row 44: 0 <= maxBlockSize < 16 -> clamps to 16 -> 65566\n1180\t        for v in 0..16i32 {\n1181\t            let cv = c(v);\n1182\t            let rv = r(v);\n1183\t            assert_eq!(cv, rv, \"row 44: ringBufferSize({})\", v);\n1184\t            assert_eq!(\n1185\t                cv, 65566,\n1186\t                \"row 44: ringBufferSize({}) must clamp to 65566\",\n1187\t                v\n1188\t            );\n1189\t        }\n1190\t        // just past the clamp\n1191\t        for v in 16..24i32 {\n1192\t            assert_eq!(c(v), r(v), \"row 44 boundary: ringBufferSize({})\", v);\n1193\t        }\n1194\t    }\n1195\t}\n1196\t\n1197\t// ===========================================================================\n1198\t// ERRORS.md rows 45-51 — decompress_safe input validation\n1199\t// ===========================================================================\n1200\t\n1201\t#[test]\n1202\tfn row_45_51_decompress_safe_input_validation() {\n1203\t    let (cds, rds) = both::<FnDecompSafe>(\"LZ4_decompress_safe\");\n1204\t    let (cdp, rdp) = both::<FnDecompPartial>(\"LZ4_decompress_safe_partial\");\n1205\t    let (cuu, ruu) = both::<FnDecompSafe>(\"LZ4_uncompress_unknownOutputSize\");\n1206\t\n1207\t    let src = vec![0x42u8; 1000];\n1208\t    let comp = compress_c(&src);\n1209\t    let mut cout = vec![SENTINEL; 4096];\n1210\t    let mut rout = vec![SENTINEL; 4096];\n1211\t\n1212\t    unsafe {\n1213\t        // row 45: source == NULL -> -1\n1214\t        for &cap in &[1i32, 100, 4096] {\n1215\t            for &csz in &[0i32, 1, 100] {\n1216\t                let cv = cds(\n1217\t                    std::ptr::null(),\n1218\t                    cout.as_mut_ptr() as *mut c_char,\n1219\t                    csz,\n1220\t                    cap,\n1221\t                );\n1222\t                let rv = rds(\n1223\t                    std::ptr::null(),\n1224\t                    rout.as_mut_ptr() as *mut c_char,\n1225\t                    csz,\n1226\t                    cap,\n1227\t                );\n1228\t                assert_eq!(cv, rv, \"row 45: NULL src csz={} cap={}\", csz, cap);\n1229\t                assert_eq!(cv, -1, \"row 45: NULL src must give -1\");\n1230\t            }\n1231\t        }\n1232\t        // same branch via the obsolete alias\n1233\t        let cv = cuu(std::ptr::null(), cout.as_mut_ptr() as *mut c_char, 10, 100);\n1234\t        let rv = ruu(std::ptr::null(), rout.as_mut_ptr() as *mut c_char, 10, 100);\n1235\t        assert_eq!(cv, rv, \"row 45: NULL src via LZ4_uncompress_unknownOutputSize\");\n1236\t        assert_eq!(cv, -1);\n1237\t\n1238\t        // row 46: maxDecompressedSize < 0 -> -1\n1239\t        for &cap in &[c_int::MIN, -1_000_000, -1] {\n1240\t            let cv = cds(\n1241\t                comp.as_ptr() as *const c_char,\n1242\t                cout.as_mut_ptr() as *mut c_char,\n1243\t                comp.len() as c_int,\n1244\t                cap,\n1245\t            );\n1246\t            let rv = rds(\n1247\t                comp.as_ptr() as *const c_char,\n1248\t                rout.as_mut_ptr() as *mut c_char,\n1249\t                comp.len() as c_int,\n1250\t                cap,\n1251\t            );\n1252\t            assert_eq!(cv, rv, \"row 46: negative dstCapacity={}\", cap);\n1253\t            assert_eq!(cv, -1, \"row 46: negative dstCapacity must give -1\");\n1254\t        }\n1255\t\n1256\t        // row 47: targetOutputSize < 0 or dstCapacity < 0 in the partial API\n1257\t        for &t in &[c_int::MIN, -1, 0, 10] {\n1258\t            for &cap in &[c_int::MIN, -1, 0, 10] {\n1259\t                let cv = cdp(\n1260\t                    comp.as_ptr() as *const c_char,\n1261\t                    cout.as_mut_ptr() as *mut c_char,\n1262\t                    comp.len() as c_int,\n1263\t                    t,\n1264\t                    cap,\n1265\t                );\n1266\t                let rv = rdp(\n1267\t                    comp.as_ptr() as *const c_char,\n1268\t                    rout.as_mut_ptr() as *mut c_char,\n1269\t                    comp.len() as c_int,\n1270\t                    t,\n1271\t                    cap,\n1272\t                );\n1273\t                assert_eq!(cv, rv, \"row 47/50: partial target={} cap={}\", t, cap);\n1274\t                if t < 0 || cap < 0 {\n1275\t                    assert_eq!(\n1276\t                        cv, -1,\n1277\t                        \"row 47: partial target={} cap={} must give -1\",\n1278\t                        t, cap\n1279\t                    );\n1280\t                } else if t == 0 || cap == 0 {\n1281\t                    // row 50: partialDecoding with a zero limit returns 0, never -1\n1282\t                    assert_eq!(\n1283\t                        cv, 0,\n1284\t                        \"row 50: partial target={} cap={} must give 0\",\n1285\t                        t, cap\n1286\t                    );\n1287\t                }\n1288\t            }\n1289\t        }\n1290\t\n1291\t        // row 48: dstCapacity == 0 and input is NOT the 1-byte empty block -> -1\n1292\t        // row 49: dstCapacity == 0 with compressedSize==1 and src[0]==0 -> 0\n1293\t        let empty_block = [0u8];\n1294\t        let cv = cds(\n1295\t            empty_block.as_ptr() as *const c_char,\n1296\t            cout.as_mut_ptr() as *mut c_char,\n1297\t            1,\n1298\t            0,\n1299\t        );\n1300\t        let rv = rds(\n1301\t            empty_block.as_ptr() as *const c_char,\n1302\t            rout.as_mut_ptr() as *mut c_char,\n1303\t            1,\n1304\t            0,\n1305\t        );\n1306\t        assert_eq!(cv, rv, \"row 49: empty block with cap 0\");\n1307\t        assert_eq!(cv, 0, \"row 49: must return 0\");\n1308\t\n1309\t        for (desc, bytes) in [\n1310\t            (\"srcSize=1 but non-zero byte\", vec![1u8]),\n1311\t            (\"srcSize=1 byte 0xFF\", vec![0xFFu8]),\n1312\t            (\"srcSize=2\", vec![0u8, 0u8]),\n1313\t            (\"srcSize=3\", vec![0u8, 1, 2]),\n1314\t            (\"full valid frame\", comp.clone()),\n1315\t        ] {\n1316\t            let cv = cds(\n1317\t                bytes.as_ptr() as *const c_char,\n1318\t                cout.as_mut_ptr() as *mut c_char,\n1319\t                bytes.len() as c_int,\n1320\t                0,\n1321\t            );\n1322\t            let rv = rds(\n1323\t                bytes.as_ptr() as *const c_char,\n1324\t                rout.as_mut_ptr() as *mut c_char,\n1325\t                bytes.len() as c_int,\n1326\t                0,\n1327\t            );\n1328\t            assert_eq!(cv, rv, \"row 48: cap=0 {}\", desc);\n1329\t            assert_eq!(cv, -1, \"row 48: cap=0 {} must give -1\", desc);\n1330\t        }\n1331\t\n1332\t        // row 51: compressedSize == 0 with dstCapacity > 0 -> -1\n1333\t        for &cap in &[1i32, 10, 4096] {\n1334\t            let cv = cds(\n1335\t                comp.as_ptr() as *const c_char,\n1336\t                cout.as_mut_ptr() as *mut c_char,\n1337\t                0,\n1338\t                cap,\n1339\t            );\n1340\t            let rv = rds(\n1341\t                comp.as_ptr() as *const c_char,\n1342\t                rout.as_mut_ptr() as *mut c_char,\n1343\t                0,\n1344\t                cap,\n1345\t            );\n1346\t            assert_eq!(cv, rv, \"row 51: compressedSize=0 cap={}\", cap);\n1347\t            assert_eq!(cv, -1, \"row 51: compressedSize=0 cap={} must give -1\", cap);\n1348\t        }\n1349\t    }\n1350\t}\n1351\t\n1352\t// ===========================================================================\n1353\t// ERRORS.md rows 52-72 — malformed / truncated / corrupted compressed input\n1354\t//\n1355\t// Rather than hand-crafting one input per branch (several branches are only\n1356\t// reachable through very specific token/length/offset combinations), this\n1357\t// drives BOTH libraries with a large corpus of systematically corrupted and\n1358\t// truncated blocks and requires bit-exact agreement on the returned value AND\n1359\t// on every byte of the destination buffer. That covers rows 52-67 (all the\n1360\t// `_output_error` paths) plus 68-72 (the partial-mode clamping paths).\n1361\t//\n1362\t// Only the *safe* decoders are used here: row 78 documents that\n1363\t// LZ4_decompress_fast performs NO input-side bounds checks at all, so feeding\n1364\t// it malformed input reads past the source buffer (undefined behaviour in both\n1365\t// libraries). Those are covered separately in `row_73_77_*` using valid blocks\n1366\t// with undersized output.\n1367\t// ===========================================================================\n1368\t\n1369\t#[test]\n1370\tfn row_52_72_corrupted_input_differential() {\n1371\t    let (cds, rds) = both::<FnDecompSafe>(\"LZ4_decompress_safe\");\n1372\t    let (cdp, rdp) = both::<FnDecompPartial>(\"LZ4_decompress_safe_partial\");\n1373\t    let (cud, rud) = both::<FnDecompUsingDict>(\"LZ4_decompress_safe_usingDict\");\n1374\t    let (cpd, rpd) =\n1375\t        both::<FnDecompPartialUsingDict>(\"LZ4_decompress_safe_partial_usingDict\");\n1376\t\n1377\t    let mut rng = Rng::new(0x5272);\n1378\t    let dict = gen_shape(&mut rng, 3, 8192);\n1379\t\n1380\t    let mut corpus: Vec<(String, Vec<u8>)> = Vec::new();\n1381\t\n1382\t    // 1. Truncations of valid blocks at EVERY length.\n1383\t    for shape in 0..N_SHAPES {\n1384\t        for &len in &[13usize, 60, 200, 1000] {\n1385\t            let src = gen_shape(&mut rng, shape, len);\n1386\t            let comp = compress_c(&src);\n1387\t            for t in 0..=comp.len() {\n1388\t                corpus.push((\n1389\t                    format!(\"truncate shape={} len={} to {}\", shape_name(shape), len, t),\n1390\t                    comp[..t].to_vec(),\n1391\t                ));\n1392\t            }\n1393\t        }\n1394\t    }\n1395\t\n1396\t    // 2. Single-byte mutations of valid blocks (every position x several values).\n1397\t    for shape in 0..N_SHAPES {\n1398\t        let src = gen_shape(&mut rng, shape, 300);\n1399\t        let comp = compress_c(&src);\n1400\t        for pos in 0..comp.len() {\n1401\t            for &v in &[0x00u8, 0x0F, 0xF0, 0xFF, 0x10, 0x01] {\n1402\t                let mut m = comp.clone();\n1403\t                m[pos] = v;\n1404\t                corpus.push((format!(\"mutate shape={} pos={} -> {:#04x}\", shape_name(shape), pos, v), m));\n1405\t            }\n1406\t        }\n1407\t    }\n1408\t\n1409\t    // 3. Fully random byte strings (arbitrary token/length/offset sequences,\n1410\t    //    including offset == 0 which row 62 says is NOT rejected).\n1411\t    for n in 0..3000usize {\n1412\t        let len = rng.range(1, 80);\n1413\t        corpus.push((format!(\"random#{} len={}\", n, len), gen_random(&mut rng, len)));\n1414\t    }\n1415\t\n1416\t    // 4. Hand-built blocks aimed at specific branches: offset == 0, maximal\n1417\t    //    offsets, 15/255 length extensions, and short last-literal runs.\n1418\t    let handmade: Vec<(&str, Vec<u8>)> = vec![\n1419\t        (\"offset0: 4 lits then match offset 0\", vec![0x40, 1, 2, 3, 4, 0x00, 0x00]),\n1420\t        (\"offset0 then last literals\", vec![0x40, 1, 2, 3, 4, 0x00, 0x00, 0x50, 9, 9, 9, 9, 9]),\n1421\t        (\"offset0 long match\", vec![0x4F, 1, 2, 3, 4, 0x00, 0x00, 0xFF, 0xFF, 0x10]),\n1422\t        (\"lit len 15 no ext byte\", vec![0xF0]),\n1423\t        (\"lit len 15 ext 255 truncated\", vec![0xF0, 0xFF]),\n1424\t        (\"lit len 15 ext 255,255 truncated\", vec![0xF0, 0xFF, 0xFF]),\n1425\t        (\"match len 15 no ext\", vec![0x0F, 0x01, 0x00]),\n1426\t        (\"match len ext truncated\", vec![0x0F, 0x01, 0x00, 0xFF]),\n1427\t        (\"offset beyond output\", vec![0x40, 1, 2, 3, 4, 0xFF, 0xFF]),\n1428\t        (\"offset max 65535\", vec![0x40, 1, 2, 3, 4, 0xFF, 0xFF, 0x50, 5, 5, 5, 5, 5]),\n1429\t        (\"only token 0\", vec![0x00]),\n1430\t        (\"token 0x10 (match, no lits)\", vec![0x10, 0x01, 0x00]),\n1431\t        (\"lastlit run of 4 (< LASTLITERALS)\", vec![0x40, 1, 2, 3, 4]),\n1432\t        (\"lastlit run of 5\", vec![0x50, 1, 2, 3, 4, 5]),\n1433\t        (\"huge lit ext\", vec![0xF0, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x01]),\n1434\t        (\"huge match ext\", vec![0x0F, 0x01, 0x00, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x01]),\n1435\t    ];\n1436\t    for (n, b) in handmade {\n1437\t        corpus.push((n.to_string(), b));\n1438\t    }\n1439\t\n1440\t    // Destination capacities spanning zero, tiny, and generous.\n1441\t    let caps: [usize; 7] = [0, 1, 2, 5, 16, 300, 4096];\n1442\t\n1443\t    for (name, input) in &corpus {\n1444\t        for &cap in &caps {\n1445\t            let mut cout = vec![SENTINEL; cap + 8];\n1446\t            let mut rout = vec![SENTINEL; cap + 8];\n1447\t            unsafe {\n1448\t                // --- LZ4_decompress_safe (rows 52-67)\n1449\t                let cv = cds(\n1450\t                    input.as_ptr() as *const c_char,\n1451\t                    cout.as_mut_ptr() as *mut c_char,\n1452\t                    input.len() as c_int,\n1453\t                    cap as c_int,\n1454\t                );\n1455\t                let rv = rds(\n1456\t                    input.as_ptr() as *const c_char,\n1457\t                    rout.as_mut_ptr() as *mut c_char,\n1458\t                    input.len() as c_int,\n1459\t                    cap as c_int,\n1460\t                );\n1461\t                assert_eq!(cv, rv, \"safe [{}] cap={}\", name, cap);\n1462\t                assert_bytes_eq(&format!(\"safe [{}] cap={}\", name, cap), &cout, &rout);\n1463\t\n1464\t                // --- LZ4_decompress_safe_partial (rows 68-72)\n1465\t                for &t in &[0usize, 1, cap / 2, cap, cap + 1] {\n1466\t                    let mut cout = vec![SENTINEL; cap + 8];\n1467\t                    let mut rout = vec![SENTINEL; cap + 8];\n1468\t                    let cv = cdp(\n1469\t                        input.as_ptr() as *const c_char,\n1470\t                        cout.as_mut_ptr() as *mut c_char,\n1471\t                        input.len() as c_int,\n1472\t                        t as c_int,\n1473\t                        cap as c_int,\n1474\t                    );\n1475\t                    let rv = rdp(\n1476\t                        input.as_ptr() as *const c_char,\n1477\t                        rout.as_mut_ptr() as *mut c_char,\n1478\t                        input.len() as c_int,\n1479\t                        t as c_int,\n1480\t                        cap as c_int,\n1481\t                    );\n1482\t                    assert_eq!(cv, rv, \"partial [{}] cap={} target={}\", name, cap, t);\n1483\t                    assert_bytes_eq(\n1484\t                        &format!(\"partial [{}] cap={} target={}\", name, cap, t),\n1485\t                        &cout,\n1486\t                        &rout,\n1487\t                    );\n1488\t                }\n1489\t\n1490\t                // --- extDict variants (rows 66-67, 70)\n1491\t                for &dsz in &[0usize, 8, 8192] {\n1492\t                    let dptr = if dsz == 0 {\n1493\t                        std::ptr::null()\n1494\t                    } else {\n1495\t                        dict.as_ptr() as *const c_char\n1496\t                    };\n1497\t                    let mut cout = vec![SENTINEL; cap + 8];\n1498\t                    let mut rout = vec![SENTINEL; cap + 8];\n1499\t                    let cv = cud(\n1500\t                        input.as_ptr() as *const c_char,\n1501\t                        cout.as_mut_ptr() as *mut c_char,\n1502\t                        input.len() as c_int,\n1503\t                        cap as c_int,\n1504\t                        dptr,\n1505\t                        dsz as c_int,\n1506\t                    );\n1507\t                    let rv = rud(\n1508\t                        input.as_ptr() as *const c_char,\n1509\t                        rout.as_mut_ptr() as *mut c_char,\n1510\t                        input.len() as c_int,\n1511\t                        cap as c_int,\n1512\t                        dptr,\n1513\t                        dsz as c_int,\n1514\t                    );\n1515\t                    assert_eq!(cv, rv, \"usingDict [{}] cap={} dict={}\", name, cap, dsz);\n1516\t                    assert_bytes_eq(\n1517\t                        &format!(\"usingDict [{}] cap={} dict={}\", name, cap, dsz),\n1518\t                        &cout,\n1519\t                        &rout,\n1520\t                    );\n1521\t\n1522\t                    let mut cout = vec![SENTINEL; cap + 8];\n1523\t                    let mut rout = vec![SENTINEL; cap + 8];\n1524\t                    let cv = cpd(\n1525\t                        input.as_ptr() as *const c_char,\n1526\t                        cout.as_mut_ptr() as *mut c_char,\n1527\t                        input.len() as c_int,\n1528\t                        cap as c_int,\n1529\t                        cap as c_int,\n1530\t                        dptr,\n1531\t                        dsz as c_int,\n1532\t                    );\n1533\t                    let rv = rpd(\n1534\t                        input.as_ptr() as *const c_char,\n1535\t                        rout.as_mut_ptr() as *mut c_char,\n1536\t                        input.len() as c_int,\n1537\t                        cap as c_int,\n1538\t                        cap as c_int,\n1539\t                        dptr,\n1540\t                        dsz as c_int,\n1541\t                    );\n1542\t                    assert_eq!(\n1543\t                        cv, rv,\n1544\t                        \"partial_usingDict [{}] cap={} dict={}\",\n1545\t                        name, cap, dsz\n1546\t                    );\n1547\t                    assert_bytes_eq(\n1548\t                        &format!(\"partial_usingDict [{}] cap={} dict={}\", name, cap, dsz),\n1549\t                        &cout,\n1550\t                        &rout,\n1551\t                    );\n1552\t                }\n1553\t            }\n1554\t        }\n1555\t    }\n1556\t}\n1557\t\n1558\t// ===========================================================================\n1559\t// ERRORS.md rows 73-77 — LZ4_decompress_fast output-side checks\n1560\t//\n1561\t// These are the ONLY validations the unsafe decoder performs. They are reached\n1562\t// with a VALID compressed block plus an `originalSize` SMALLER than the true\n1563\t// decompressed size, so the input is never over-read.\n1564\t// ===========================================================================\n1565\t\n1566\t#[test]\n1567\tfn row_73_77_decompress_fast_output_checks() {\n1568\t    let (cdf, rdf) = both::<FnDecompFast>(\"LZ4_decompress_fast\");\n1569\t    let (cun, run) = both::<FnDecompFast>(\"LZ4_uncompress\");\n1570\t    let (cfd, rfd) = both::<FnDecompFastUsingDict>(\"LZ4_decompress_fast_usingDict\");\n1571\t\n1572\t    let mut rng = Rng::new(0x7377);\n1573\t    for shape in 0..N_SHAPES {\n1574\t        for &len in &[13usize, 60, 200, 1000, 5000] {\n1575\t            let src = gen_shape(&mut rng, shape, len);\n1576\t            let comp = compress_c(&src);\n1577\t            // Every understated originalSize from 0 to len-1 must be rejected\n1578\t            // identically (rows 73/74/75/77), and `len` itself must succeed.\n1579\t            for out in 0..=len {\n1580\t                let mut cout = vec![SENTINEL; len + 64];\n1581\t                let mut rout = vec![SENTINEL; len + 64];\n1582\t                unsafe {\n1583\t                    let cv = cdf(\n1584\t                        comp.as_ptr() as *const c_char,\n1585\t                        cout.as_mut_ptr() as *mut c_char,\n1586\t                        out as c_int,\n1587\t                    );\n1588\t                    let rv = rdf(\n1589\t                        comp.as_ptr() as *const c_char,\n1590\t                        rout.as_mut_ptr() as *mut c_char,\n1591\t                        out as c_int,\n1592\t                    );\n1593\t                    let l = format!(\n1594\t                        \"rows 73-77: shape={} len={} originalSize={}\",\n1595\t                        shape_name(shape),\n1596\t                        len,\n1597\t                        out\n1598\t                    );\n1599\t                    assert_eq!(cv, rv, \"{}: return\", l);\n1600\t                    assert_bytes_eq(&l, &cout, &rout);\n1601\t                    // The differential equality above IS the test. We do NOT\n1602\t                    // assert our own guess about WHICH understated sizes are\n1603\t                    // rejected: `LZ4_decompress_unsafe_generic` only checks the\n1604\t                    // OUTPUT bound, so a short `originalSize` that happens to\n1605\t                    // land exactly at the end of a literal run succeeds and\n1606\t                    // returns the bytes consumed (e.g. len=13 constant data,\n1607\t                    // originalSize=1 -> 2). Only the exact-size case has a\n1608\t                    // value we can legitimately predict.\n1609\t                    if out == len {\n1610\t                        assert_eq!(cv, comp.len() as c_int, \"{}: exact size must succeed\", l);\n1611\t                    } else {\n1612\t                        assert!(\n1613\t                            cv == -1 || cv > 0,\n1614\t                            \"{}: expected -1 or a positive consumed count, got {}\",\n1615\t                            l,\n1616\t                            cv\n1617\t                        );\n1618\t                    }\n1619\t                }\n1620\t            }\n1621\t            // Same branch through the obsolete alias and the usingDict variant.\n1622\t            for &out in &[0usize, len / 2, len] {\n1623\t                let mut cout = vec![SENTINEL; len + 64];\n1624\t                let mut rout = vec![SENTINEL; len + 64];\n1625\t                unsafe {\n1626\t                    let cv = cun(\n1627\t                        comp.as_ptr() as *const c_char,\n1628\t                        cout.as_mut_ptr() as *mut c_char,\n1629\t                        out as c_int,\n1630\t                    );\n1631\t                    let rv = run(\n1632\t                        comp.as_ptr() as *const c_char,\n1633\t                        rout.as_mut_ptr() as *mut c_char,\n1634\t                        out as c_int,\n1635\t                    );\n1636\t                    assert_eq!(cv, rv, \"row 73: LZ4_uncompress out={}\", out);\n1637\t                    assert_bytes_eq(&format!(\"row 73: LZ4_uncompress out={}\", out), &cout, &rout);\n1638\t\n1639\t                    let mut cout = vec![SENTINEL; len + 64];\n1640\t                    let mut rout = vec![SENTINEL; len + 64];\n1641\t                    let cv = cfd(\n1642\t                        comp.as_ptr() as *const c_char,\n1643\t                        cout.as_mut_ptr() as *mut c_char,\n1644\t                        out as c_int,\n1645\t                        std::ptr::null(),\n1646\t                        0,\n1647\t                    );\n1648\t                    let rv = rfd(\n1649\t                        comp.as_ptr() as *const c_char,\n1650\t                        rout.as_mut_ptr() as *mut c_char,\n1651\t                        out as c_int,\n1652\t                        std::ptr::null(),\n1653\t                        0,\n1654\t                    );\n1655\t                    assert_eq!(cv, rv, \"row 76: fast_usingDict out={}\", out);\n1656\t                    assert_bytes_eq(\n1657\t                        &format!(\"row 76: fast_usingDict out={}\", out),\n1658\t                        &cout,\n1659\t                        &rout,\n1660\t                    );\n1661\t                }\n1662\t            }\n1663\t        }\n1664\t    }\n1665\t}\n1666\t\n1667\t// ===========================================================================\n1668\t// ERRORS.md rows 79-80 — *_continue propagates the underlying failure\n1669\t// ===========================================================================\n1670\t\n1671\t#[test]\n1672\tfn row_79_80_decompress_continue_error_propagation() {\n1673\t    let (c_cd, r_cd) = both::<FnCreateStreamDecode>(\"LZ4_createStreamDecode\");\n1674\t    let (c_fd, r_fd) = both::<FnFreeStreamDecode>(\"LZ4_freeStreamDecode\");\n1675\t    let (c_sd, r_sd) = both::<FnSetStreamDecode>(\"LZ4_setStreamDecode\");\n1676\t    let (c_dc, r_dc) = both::<FnDecompSafeContinue>(\"LZ4_decompress_safe_continue\");\n1677\t    let (c_df, r_df) = both::<FnDecompFastContinue>(\"LZ4_decompress_fast_continue\");\n1678\t\n1679\t    let mut rng = Rng::new(0x7980);\n1680\t    let src = gen_shape(&mut rng, 4, 2000);\n1681\t    let comp = compress_c(&src);\n1682\t\n1683\t    unsafe {\n1684\t        // row 79: safe_continue with a too-small dst, and with corrupted input.\n1685\t        for &cap in &[0usize, 1, 5, 100, 1999, 2000] {\n1686\t            let cds = c_cd();\n1687\t            let rds = r_cd();\n1688\t            assert_eq!(\n1689\t                c_sd(cds, std::ptr::null(), 0),\n1690\t                r_sd(rds, std::ptr::null(), 0),\n1691\t                \"row 83: setStreamDecode(NULL,0)\"\n1692\t            );\n1693\t            let mut cout = vec![SENTINEL; cap + 16];\n1694\t            let mut rout = vec![SENTINEL; cap + 16];\n1695\t            let cv = c_dc(\n1696\t                cds,\n1697\t                comp.as_ptr() as *const c_char,\n1698\t                cout.as_mut_ptr() as *mut c_char,\n1699\t                comp.len() as c_int,\n1700\t                cap as c_int,\n1701\t            );\n1702\t            let rv = r_dc(\n1703\t                rds,\n1704\t                comp.as_ptr() as *const c_char,\n1705\t                rout.as_mut_ptr() as *mut c_char,\n1706\t                comp.len() as c_int,\n1707\t                cap as c_int,\n1708\t            );\n1709\t            assert_eq!(cv, rv, \"row 79: safe_continue cap={}\", cap);\n1710\t            assert_eq!(c_fd(cds), r_fd(rds));\n1711\t        }\n1712\t\n1713\t        // corrupted / truncated input through safe_continue\n1714\t        for t in 0..comp.len() {\n1715\t            let cds = c_cd();\n1716\t            let rds = r_cd();\n1717\t            c_sd(cds, std::ptr::null(), 0);\n1718\t            r_sd(rds, std::ptr::null(), 0);\n1719\t            let mut cout = vec![SENTINEL; 2048];\n1720\t            let mut rout = vec![SENTINEL; 2048];\n1721\t            let cv = c_dc(\n1722\t                cds,\n1723\t                comp.as_ptr() as *const c_char,\n1724\t                cout.as_mut_ptr() as *mut c_char,\n1725\t                t as c_int,\n1726\t                2048,\n1727\t            );\n1728\t            let rv = r_dc(\n1729\t                rds,\n1730\t                comp.as_ptr() as *const c_char,\n1731\t                rout.as_mut_ptr() as *mut c_char,\n1732\t                t as c_int,\n1733\t                2048,\n1734\t            );\n1735\t            assert_eq!(cv, rv, \"row 79: safe_continue truncated to {}\", t);\n1736\t            assert_bytes_eq(\n1737\t                &format!(\"row 79: safe_continue truncated to {}\", t),\n1738\t                &cout,\n1739\t                &rout,\n1740\t            );\n1741\t            assert_eq!(c_fd(cds), r_fd(rds));\n1742\t        }\n1743\t\n1744\t        // row 80: fast_continue with an understated originalSize\n1745\t        for &out in &[0usize, 1, 100, 1999, 2000] {\n1746\t            let cds = c_cd();\n1747\t            let rds = r_cd();\n1748\t            c_sd(cds, std::ptr::null(), 0);\n1749\t            r_sd(rds, std::ptr::null(), 0);\n1750\t            let mut cout = vec![SENTINEL; 2100];\n1751\t            let mut rout = vec![SENTINEL; 2100];\n1752\t            let cv = c_df(\n1753\t                cds,\n1754\t                comp.as_ptr() as *const c_char,\n1755\t                cout.as_mut_ptr() as *mut c_char,\n1756\t                out as c_int,\n1757\t            );\n1758\t            let rv = r_df(\n1759\t                rds,\n1760\t                comp.as_ptr() as *const c_char,\n1761\t                rout