{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01BV59ieWRQypRRV4FcGmQaR","type":"tool_result","content":"1\t//! Shared differential-test harness.\n2\t//!\n3\t//! Both the C `.so` and the Rust `.so` are loaded with `libloading` and every\n4\t//! call goes through the `jumpnode` dynamic symbol. The Rust implementation is\n5\t//! *never* called directly, so the `#[unsafe(no_mangle)] extern \"C\"` export\n6\t//! wrapper is exercised exactly as an external consumer would exercise it.\n7\t\n8\t#![allow(dead_code)]\n9\t\n10\tuse libloading::{Library, Symbol};\n11\tuse std::os::raw::c_int;\n12\tuse std::path::{Path, PathBuf};\n13\tuse std::sync::OnceLock;\n14\t\n15\tpub type JumpnodeFn = unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int;\n16\t\n17\tfn manifest_dir() -> PathBuf {\n18\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n19\t}\n20\t\n21\t/// `c_src/CMakeLists.txt` does not link `m`, so the C `.so` has an unresolved\n22\t/// `U sqrt`. Publish libm globally before opening it so `RTLD_NOW` resolves.\n23\tfn preload_libm() {\n24\t    static ONCE: OnceLock<()> = OnceLock::new();\n25\t    ONCE.get_or_init(|| {\n26\t        #[cfg(unix)]\n27\t        {\n28\t            use libloading::os::unix::{Library as UnixLibrary, RTLD_GLOBAL, RTLD_NOW};\n29\t            for name in [\"libm.so.6\", \"libm.so\"] {\n30\t                if let Ok(lib) = unsafe { UnixLibrary::open(Some(name), RTLD_NOW | RTLD_GLOBAL) } {\n31\t                    // Leak on purpose: the symbols must stay resolvable forever.\n32\t                    std::mem::forget(lib);\n33\t                    break;\n34\t                }\n35\t            }\n36\t        }\n37\t    });\n38\t}\n39\t\n40\tfn c_so_path() -> PathBuf {\n41\t    let base = manifest_dir().join(\"c_src\").join(\"build\");\n42\t    let candidates = [\n43\t        \"libtranslated_rust.so\",\n44\t        \"libc_src.so\",\n45\t        \"libtranslated_rust.dylib\",\n46\t    ];\n47\t    for c in candidates {\n48\t        let p = base.join(c);\n49\t        if p.is_file() {\n50\t            return p;\n51\t        }\n52\t    }\n53\t    // Fall back to any single .so produced by the CMake build.\n54\t    if let Ok(rd) = std::fs::read_dir(&base) {\n55\t        for e in rd.flatten() {\n56\t            let p = e.path();\n57\t            if p.extension().and_then(|s| s.to_str()) == Some(\"so\") {\n58\t                return p;\n59\t            }\n60\t        }\n61\t    }\n62\t    panic!(\n63\t        \"C shared library not found under {}. Build it with:\\n  \\\n64\t         cd c_src && mkdir -p build && cd build && \\\n65\t         cmake .. -DCMAKE_POSITION_INDEPENDENT_CODE=ON && cmake --build .\",\n66\t        base.display()\n67\t    );\n68\t}\n69\t\n70\tfn newest(a: Option<PathBuf>, b: Option<PathBuf>) -> Option<PathBuf> {\n71\t    fn mtime(p: &Path) -> std::time::SystemTime {\n72\t        std::fs::metadata(p)\n73\t            .and_then(|m| m.modified())\n74\t            .unwrap_or(std::time::UNIX_EPOCH)\n75\t    }\n76\t    match (a, b) {\n77\t        (Some(x), Some(y)) => Some(if mtime(&x) >= mtime(&y) { x } else { y }),\n78\t        (Some(x), None) => Some(x),\n79\t        (None, Some(y)) => Some(y),\n80\t        (None, None) => None,\n81\t    }\n82\t}\n83\t\n84\tfn rust_so_path() -> PathBuf {\n85\t    // Prefer the artifact belonging to the profile the tests were built with,\n86\t    // then fall back to whichever of debug/release is newer.\n87\t    let target_root = std::env::var_os(\"CARGO_TARGET_DIR\")\n88\t        .map(PathBuf::from)\n89\t        .unwrap_or_else(|| manifest_dir().join(\"target\"));\n90\t\n91\t    let mut found: Option<PathBuf> = None;\n92\t    for profile in [\"debug\", \"release\"] {\n93\t        let p = target_root.join(profile).join(\"libjumpnode_lib.so\");\n94\t        if p.is_file() {\n95\t            found = newest(found, Some(p));\n96\t        }\n97\t    }\n98\t    found.unwrap_or_else(|| {\n99\t        panic!(\n100\t            \"Rust cdylib libjumpnode_lib.so not found under {}. Build it with `cargo build`.\",\n101\t            target_root.display()\n102\t        )\n103\t    })\n104\t}\n105\t"}]},"parent_tool_use_id":null,"session_id":"e461a750-ed58-43d6-b465-7c25340d872d","uuid":"e3857996-6ba0-4012-9736-88400630c505","timestamp":"2026-08-19T21:20:57.370Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-9PVsDv/translated_rust/tests/common/mod.rs","content":"//! Shared differential-test harness.\n//!\n//! Both the C `.so` and the Rust `.so` are loaded with `libloading` and every\n//! call goes through the `jumpnode` dynamic symbol. The Rust implementation is\n//! *never* called directly, so the `#[unsafe(no_mangle)] extern \"C\"` export\n//! wrapper is exercised exactly as an external consumer would exercise it.\n\n#![allow(dead_code)]\n\nuse libloading::{Library, Symbol};\nuse std::os::raw::c_int;\nuse std::path::{Path, PathBuf};\nuse std::sync::OnceLock;\n\npub type JumpnodeFn = unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int;\n\nfn manifest_dir() -> PathBuf {\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n}\n\n/// `c_src/CMakeLists.txt` does not link `m`, so the C `.so` has an unresolved\n/// `U sqrt`. Publish libm globally before opening it so `RTLD_NOW` resolves.\nfn preload_libm() {\n    static ONCE: OnceLock<()> = OnceLock::new();\n    ONCE.get_or_init(|| {\n        #[cfg(unix)]\n        {\n            use libloading::os::unix::{Library as UnixLibrary, RTLD_GLOBAL, RTLD_NOW};\n            for name in [\"libm.so.6\", \"libm.so\"] {\n                if let Ok(lib) = unsafe { UnixLibrary::open(Some(name), RTLD_NOW | RTLD_GLOBAL) } {\n                    // Leak on purpose: the symbols must stay resolvable forever.\n                    std::mem::forget(lib);\n                    break;\n                }\n            }\n        }\n    });\n}\n\nfn c_so_path() -> PathBuf {\n    let base = manifest_dir().join(\"c_src\").join(\"build\");\n    let candidates = [\n        \"libtranslated_rust.so\",\n        \"libc_src.so\",\n        \"libtranslated_rust.dylib\",\n    ];\n    for c in candidates {\n        let p = base.join(c);\n        if p.is_file() {\n            return p;\n        }\n    }\n    // Fall back to any single .so produced by the CMake build.\n    if let Ok(rd) = std::fs::read_dir(&base) {\n        for e in rd.flatten() {\n            let p = e.path();\n            if p.extension().and_then(|s| s.to_str()) == Some(\"so\") {\n                return p;\n            }\n        }\n    }\n    panic!(\n        \"C shared library not found under {}. Build it with:\\n  \\\n         cd c_src && mkdir -p build && cd build && \\\n         cmake .. -DCMAKE_POSITION_INDEPENDENT_CODE=ON && cmake --build .\",\n        base.display()\n    );\n}\n\nfn newest(a: Option<PathBuf>, b: Option<PathBuf>) -> Option<PathBuf> {\n    fn mtime(p: &Path) -> std::time::SystemTime {\n        std::fs::metadata(p)\n            .and_then(|m| m.modified())\n            .unwrap_or(std::time::UNIX_EPOCH)\n    }\n    match (a, b) {\n        (Some(x), Some(y)) => Some(if mtime(&x) >= mtime(&y) { x } else { y }),\n        (Some(x), None) => Some(x),\n        (None, Some(y)) => Some(y),\n        (None, None) => None,\n    }\n}\n\nfn rust_so_path() -> PathBuf {\n    // Prefer the artifact belonging to the profile the tests were built with,\n    // then fall back to whichever of debug/release is newer.\n    let target_root = std::env::var_os(\"CARGO_TARGET_DIR\")\n        .map(PathBuf::from)\n        .unwrap_or_else(|| manifest_dir().join(\"target\"));\n\n    let mut found: Option<PathBuf> = None;\n    for profile in [\"debug\", \"release\"] {\n        let p = target_root.join(profile).join(\"libjumpnode_lib.so\");\n        if p.is_file() {\n            found = newest(found, Some(p));\n        }\n    }\n    found.unwrap_or_else(|| {\n        panic!(\n            \"Rust cdylib libjumpnode_lib.so not found under {}. Build it with `cargo build`.\",\n            target_root.display()\n        )\n    })\n}\n","numLines":105,"startLine":1,"totalLines":396}}}
