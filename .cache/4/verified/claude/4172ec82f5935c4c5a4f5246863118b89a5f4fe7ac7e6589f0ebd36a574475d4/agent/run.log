(*slot).value = value;\n117\t\n118\t    (*slot).data[0] = 0o100;\n119\t    (*slot).data[1] = 0o200;\n120\t    (*slot).data[2] = 0o300;\n121\t    (*slot).data[3] = 0o400;\n122\t\n123\t    node_count_set(count + 1);\n124\t    STATUS_OK\n125\t}\n126\t\n127\t// static int process_backward(int *array, size_t size, int start_offset)\n128\tunsafe fn process_backward(array: *mut c_int, size: usize, start_offset: c_int) -> c_int {\n129\t    let mut sum: c_int = 0;\n130\t\n131\t    let mut p: *mut c_int = array.add(size);\n132\t    let start: *mut c_int = array.offset(start_offset as isize);\n133\t\n134\t    while p > start {\n135\t        p = p.offset(-1);\n136\t        sum = sum.wrapping_add(*p);\n137\t    }\n138\t\n139\t    sum\n140\t}\n141\t\n142\t// static int compute_size_metric(const char *str)\n143\tfn compute_size_metric(bytes: &[u8]) -> c_int {\n144\t    // size_t len = strlen(str);\n145\t    let len: usize = match bytes.iter().position(|&b| b == 0) {\n146\t        Some(n) => n,\n147\t        None => bytes.len(),\n148\t    };\n149\t\n150\t    // metric = (int)len;\n151\t    let mut metric: c_int = len as u32 as c_int;\n152\t\n153\t    // metric = metric * 2 + 010;\n154\t    metric = metric.wrapping_mul(2).wrapping_add(0o10);\n155\t\n156\t    metric\n157\t}\n158\t\n159\t/// Reproduces the x86-64 semantics of a C `(int)` cast from `double`\n160\t/// (truncation toward zero; `cvttsd2si` yields INT_MIN for NaN / out-of-range).\n161\t#[inline]\n162\tfn c_cast_double_to_int(value: c_double) -> c_int {\n163\t    if value.is_nan() {\n164\t        return c_int::MIN;\n165\t    }\n166\t    let t = value.trunc();\n167\t    if t >= 2147483648.0 || t < -2147483648.0 {\n168\t        return c_int::MIN;\n169\t    }\n170\t    t as c_int\n171\t}\n172\t\n173\t// static int safe_double_to_int(double value)\n174\tfn safe_double_to_int(mut value: c_double) -> c_int {\n175\t    if value > 2147483647.0 {\n176\t        value = 2147483647.0;\n177\t    }\n178\t    if value < -2147483648.0 {\n179\t        value = -2147483648.0;\n180\t    }\n181\t\n182\t    c_cast_double_to_int(value)\n183\t}\n184\t\n185\t// int jumpnode(int operation_mode, int node_id, int depth, int flags)\n186\t#[unsafe(no_mangle)]\n187\tpub unsafe extern \"C\" fn jumpnode(\n188\t    operation_mode: c_int,\n189\t    node_id: c_int,\n190\t    depth: c_int,\n191\t    flags: c_int,\n192\t) -> c_int {\n193\t    let mut current_node: *mut Node;\n194\t    let mut parent_node: *mut Node;\n195\t    #[allow(unused_assignments)]\n196\t    let mut result: c_int = 0;\n197\t    let mut i: c_int;\n198\t    let mut accumulated_value: c_double;\n199\t    // int temp_array[20];\n200\t    let mut temp_array: [c_int; 20] = [0; 20];\n201\t    let array_size: usize;\n202\t    // char buffer[50];\n203\t    let mut buffer: [u8; 50] = [0; 50];\n204\t\n205\t    match operation_mode {\n206\t        // case 0001:\n207\t        0o0001 => {\n208\t            current_node = find_node_by_id(node_id);\n209\t            if current_node.is_null() {\n210\t                return STATUS_ERROR | 0o020;\n211\t            }\n212\t\n213\t            accumulated_value = (*current_node).value;\n214\t\n215\t            i = 0;\n216\t            while i < depth && (*current_node).parent_id != -1 {\n217\t                parent_node = find_node_by_id((*current_node).parent_id);\n218\t                if parent_node.is_null() {\n219\t                    break;\n220\t                }\n221\t\n222\t                accumulated_value += (*parent_node).value * 1.5;\n223\t                current_node = parent_node;\n224\t\n225\t                i += 1;\n226\t            }\n227\t\n228\t            result = safe_double_to_int(accumulated_value);\n229\t        }\n230\t\n231\t        // case 0002:\n232\t        0o0002 => {\n233\t            current_node = find_node_by_id(node_id);\n234\t            if current_node.is_null() {\n235\t                return STATUS_ERROR | 0o040;\n236\t            }\n237\t\n238\t            i = 0;\n239\t            while i < 4 {\n240\t                temp_array[i as usize] = (*current_node).data[i as usize];\n241\t                i += 1;\n242\t            }\n243\t\n244\t            i = 4;\n245\t            while i < 0o20 {\n246\t                temp_array[i as usize] = i.wrapping_mul(0o007);\n247\t                i += 1;\n248\t            }\n249\t\n250\t            array_size = 0o20;\n251\t\n252\t            result = process_backward(temp_array.as_mut_ptr(), array_size, depth);\n253\t\n254\t            result = result.wrapping_add((array_size as u32 as c_int).wrapping_mul(flags));\n255\t        }\n256\t\n257\t        // case 0003:\n258\t        0o0003 => {\n259\t            // sprintf(buffer, \"Node_%d_Depth_%d\", node_id, depth);\n260\t            sprintf_node_depth(&mut buffer, node_id, depth);\n261\t\n262\t            result = compute_size_metric(&buffer[..]);\n263\t\n264\t            // result += (flags & 0177);\n265\t            result = result.wrapping_add(flags & 0o177);\n266\t        }\n267\t\n268\t        // case 0004:\n269\t        0o0004 => {\n270\t            current_node = find_node_by_id(node_id);\n271\t            if current_node.is_null() {\n272\t                return STATUS_ERROR | 0o100;\n273\t            }\n274\t\n275\t            accumulated_value = 0.0;\n276\t            i = 0;\n277\t            while i < 4 {\n278\t                accumulated_value +=\n279\t                    ((*current_node).data[i as usize] as c_double).sqrt() * 2.718281828;\n280\t                i += 1;\n281\t            }\n282\t\n283\t            accumulated_value *= 1.0 + (depth as c_double) * 0.1;\n284\t\n285\t            result = safe_double_to_int(accumulated_value);\n286\t\n287\t            let count = node_count_get();\n288\t            if count > 2 {\n289\t                let base = node_storage_base();\n290\t                let end_ptr: *mut Node = base.offset(count as isize);\n291\t                let mut iter: *mut Node = end_ptr;\n292\t                let mut backward_sum: c_int = 0;\n293\t\n294\t                i = 0;\n295\t                while i < 3 && iter > base {\n296\t                    iter = iter.offset(-1);\n297\t                    backward_sum = backward_sum.wrapping_add(safe_double_to_int((*iter).value));\n298\t                    i += 1;\n299\t                }\n300\t\n301\t                result = result.wrapping_add(backward_sum);\n302\t            }\n303\t        }\n304\t\n305\t        // default:\n306\t        _ => {\n307\t            result = STATUS_ERROR | 0o200;\n308\t        }\n309\t    }\n310\t\n311\t    result\n312\t}\n313\t\n314\t/// Emulates `sprintf(buffer, \"Node_%d_Depth_%d\", node_id, depth)` into a\n315\t/// fixed-size C character buffer (NUL terminated).\n316\tfn sprintf_node_depth(buffer: &mut [u8; 50], node_id: c_int, depth: c_int) {\n317\t    let mut out: usize = 0;\n318\t\n319\t    let put = |buf: &mut [u8; 50], pos: &mut usize, b: u8| {\n320\t        if *pos < buf.len() {\n321\t            buf[*pos] = b;\n322\t        }\n323\t        *pos += 1;\n324\t    };\n325\t\n326\t    for &b in b\"Node_\" {\n327\t        put(buffer, &mut out, b);\n328\t    }\n329\t    for &b in fmt_int(node_id).as_bytes() {\n330\t        put(buffer, &mut out, b);\n331\t    }\n332\t    for &b in b\"_Depth_\" {\n333\t        put(buffer, &mut out, b);\n334\t    }\n335\t    for &b in fmt_int(depth).as_bytes() {\n336\t        put(buffer, &mut out, b);\n337\t    }\n338\t    put(buffer, &mut out, 0);\n339\t}\n340\t\n341\t/// Formats a `c_int` exactly as printf's `%d` does.\n342\tfn fmt_int(v: c_int) -> IntStr {\n343\t    let mut buf = [0u8; 12];\n344\t    let mut len = 0usize;\n345\t\n346\t    let negative = v < 0;\n347\t    // Use the unsigned magnitude so that INT_MIN is handled correctly.\n348\t    let mut mag: u32 = if negative {\n349\t        (v as i64).unsigned_abs() as u32\n350\t    } else {\n351\t        v as u32\n352\t    };\n353\t\n354\t    if mag == 0 {\n355\t        buf[0] = b'0';\n356\t        len = 1;\n357\t    } else {\n358\t        let mut tmp = [0u8; 12];\n359\t        let mut n = 0usize;\n360\t        while mag > 0 {\n361\t            tmp[n] = b'0' + (mag % 10) as u8;\n362\t            mag /= 10;\n363\t            n += 1;\n364\t        }\n365\t        if negative {\n366\t            buf[len] = b'-';\n367\t            len += 1;\n368\t        }\n369\t        while n > 0 {\n370\t            n -= 1;\n371\t            buf[len] = tmp[n];\n372\t            len += 1;\n373\t        }\n374\t        return IntStr { buf, len };\n375\t    }\n376\t\n377\t    if negative {\n378\t        // Unreachable for mag == 0, kept for structural fidelity.\n379\t        buf[1] = b'0';\n380\t        buf[0] = b'-';\n381\t        len = 2;\n382\t    }\n383\t\n384\t    IntStr { buf, len }\n385\t}\n386\t\n387\tstruct IntStr {\n388\t    buf: [u8; 12],\n389\t    len: usize,\n390\t}\n391\t\n392\timpl IntStr {\n393\t    fn as_bytes(&self) -> &[u8] {\n394\t        &self.buf[..self.len]\n395\t    }\n396\t}\n397\t\n398\t// static void initialize_test_data(void)\n399\t//\n400\t// Present in the C source but never called (it is `static` and unused), so the\n401\t// node storage stays empty at run time.  Kept for completeness / fidelity.\n402\tunsafe fn initialize_test_data() {\n403\t    node_count_set(0);\n404\t\n405\t    add_node(1, -1, 100.5);\n406\t    add_node(2, 1, 50.25);\n407\t    add_node(3, 1, 75.75);\n408\t    add_node(4, 2, 25.125);\n409\t    add_node(5, 2, 30.875);\n410\t    add_node(6, 3, 40.0625);\n411\t    add_node(7, 4, 12.5);\n412\t}\n413\t"}]},"parent_tool_use_id":null,"session_id":"e461a750-ed58-43d6-b465-7c25340d872d","uuid":"8e46ec29-f397-4008-a4bd-98e5e423da36","timestamp":"2026-08-19T21:02:51.631Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-9PVsDv/translated_rust/src/lib.rs","content":"// Rust translation of c_src/src/lib.c\n//\n// Copyright 2025 MIT Lincoln Laboratory\n// Permission is hereby granted, free of charge,\n// to any person 