-","+","+struct Run {","+    stdout: Vec<u8>,","+    stderr: Vec<u8>,","+    code: Option<i32>,","+}","+","+fn run_exe(which: &str, args: &[&str]) -> Run {","+    // Both executables are named `driver` and are invoked as `./driver` from","+    // their own directory so that `argv[0]` is byte-identical.","+    let dir = artifact_dir().join(which);","+    let out = Command::new(\"./driver\")","+        .args(args)","+        .current_dir(&dir)","+        .output()","+        .unwrap_or_else(|e| panic!(\"spawn {}/driver: {e}\", dir.display()));","+    Run {","+        stdout: out.stdout,","+        stderr: out.stderr,","+        code: out.status.code(),","+    }","+}","+","+#[track_caller]","+fn diff_exe(args: &[&str]) {","+    let c = run_exe(\"cbin\", args);","+    let r = run_exe(\"rbin\", args);","+    let ctx = format!(\"driver {args:?}\");","+    assert_stdout_eq(&ctx, &c.stdout, &r.stdout);","+    assert_stdout_eq(&format!(\"{ctx} (stderr)\"), &c.stderr, &r.stderr);","+    assert_eq!(","+        c.code,","+        r.code,","+        \"{} {}: exit status differs\",","+        cfg_tag(),","+        ctx","+    );","+}","+","+","+// ---------------------------------------------------------------------------"," // Deterministic PRNG (xorshift64*) -- fixed seed per test for reproducibility."," // ---------------------------------------------------------------------------"," "]}],"userModified":false,"replaceAll":false}}
