42\t}\n43\t\n44\t/// C: `int op_mul(int a,int b){ return a * b; }`\n45\t#[unsafe(no_mangle)]\n46\tpub extern \"C\" fn op_mul(a: c_int, b: c_int) -> c_int {\n47\t    a.wrapping_mul(b)\n48\t}\n49\t\n50\t/// C: `OP_FN(OP)` -- the `op_<OP>` function picked by the build configuration.\n51\tpub const OP_FN: extern \"C\" fn(c_int, c_int) -> c_int = match OP {\n52\t    Op::Add => op_add,\n53\t    Op::Sub => op_sub,\n54\t    Op::Mul => op_mul,\n55\t};\n56\t\n57\t/* ---------- Macro-generated accumulator for the selected OP ----------\n58\t * C: DEFINE_ACCUM(OP) expands to\n59\t *      static int accum_<OP>(int n) {\n60\t *          int acc = INIT_FOR(OP);\n61\t *          DISPATCH_REP(OP, acc, n);\n62\t *          return acc;\n63\t *      }\n64\t * Note that DISPATCH_REP only handles n in 0..=6; anything else (7, negatives)\n65\t * falls through `default: break;` and returns the untouched initial value.\n66\t */\n67\tfn accum_op(n: c_int) -> c_int {\n68\t    let acc = init_for_op();\n69\t    dispatch_rep(acc, n)\n70\t}\n71\t\n72\t/* ---------- Global macro uses at file scope ---------- */\n73\t\n74\t/// C: `int (*G_OP)(int,int) = OP_FN(OP);`\n75\t#[unsafe(no_mangle)]\n76\tpub static G_OP: extern \"C\" fn(c_int, c_int) -> c_int = OP_FN;\n77\t\n78\t/// Wrapper making a raw `const char *` usable as an exported static.\n79\t#[repr(transparent)]\n80\tpub struct OpNamePtr(pub *const c_char);\n81\t// The pointer targets a `'static` read-only string, so sharing it is sound.\n82\tunsafe impl Sync for OpNamePtr {}\n83\t\n84\t/// C: `const char *G_OP_NAME = STR(OP);`\n85\t#[unsafe(no_mangle)]\n86\tpub static G_OP_NAME: OpNamePtr = OpNamePtr(OP_NAME_CSTR.as_ptr() as *const c_char);\n87\t\n88\t/* ---------- Helpers ---------- */\n89\t\n90\t/// C:\n91\t/// ```c\n92\t/// int helper_call(int a, int b) {\n93\t///     int r = (OP_FN(OP))(a, b);\n94\t///     int acc = INIT_FOR(OP);\n95\t///     RUN_LOOP(OP, acc, REPEAT);\n96\t///     printf(\"helper.call=%d helper.acc=%d\\n\", r, acc);\n97\t///     return r + acc;\n98\t/// }\n99\t/// ```\n100\t#[unsafe(no_mangle)]\n101\tpub extern \"C\" fn helper_call(a: c_int, b: c_int) -> c_int {\n102\t    let r = (OP_FN)(a, b);\n103\t    let acc = run_loop(init_for_op());\n104\t    print!(\"helper.call={} helper.acc={}\\n\", r, acc);\n105\t    r.wrapping_add(acc)\n106\t}\n107\t\n108\t/// C:\n109\t/// ```c\n110\t/// int helper_ptr(int a, int b) {\n111\t///     int (*fp)(int,int) = OP_FN(OP);\n112\t///     int r = fp(a, b);\n113\t///     printf(\"helper.ptr=%d\\n\", r);\n114\t///     return r;\n115\t/// }\n116\t/// ```\n117\t#[unsafe(no_mangle)]\n118\tpub extern \"C\" fn helper_ptr(a: c_int, b: c_int) -> c_int {\n119\t    let fp: extern \"C\" fn(c_int, c_int) -> c_int = OP_FN;\n120\t    let r = fp(a, b);\n121\t    print!(\"helper.ptr={}\\n\", r);\n122\t    r\n123\t}\n124\t\n125\t/// C:\n126\t/// ```c\n127\t/// int use_generated(int n) {\n128\t///     int r = (ACCUM_FN(OP))(n);\n129\t///     printf(\"gen.acc=%d\\n\", r);\n130\t///     return r;\n131\t/// }\n132\t/// ```\n133\t#[unsafe(no_mangle)]\n134\tpub extern \"C\" fn use_generated(n: c_int) -> c_int {\n135\t    let r = accum_op(n);\n136\t    print!(\"gen.acc={}\\n\", r);\n137\t    r\n138\t}\n139\t"}]},"parent_tool_use_id":null,"session_id":"70a99c7d-b458-4bc3-9410-f85c2d2f8dd4","uuid":"d3b47428-ee80-4efb-a601-6d195793ef99","timestamp":"2026-08-20T01:06:52.810Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-CvPi6s/translated_rust/src/mdcore.rs","content":"// Copyright 2025 MIT Lincoln Laboratory\n// Permission is hereby granted, free of charge,\n// to any person obtaining a copy of this software\n// and associated documentation files (the \"Software\"),\n// to deal in the Software without restriction,\n// including without limitation the rights to use, copy,\n// modify, merge, publish, distribute, sublicense,\n// and/or sell copies of the Software,\n// and to permit persons to whom the Software is furnished to do