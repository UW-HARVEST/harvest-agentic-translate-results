\n41\t    use std::os::unix::ffi::OsStrExt;\n42\t    arg.as_os_str().as_bytes().to_vec()\n43\t}\n44\t\n45\t#[cfg(not(unix))]\n46\tfn arg_bytes(arg: &OsString) -> Vec<u8> {\n47\t    arg.to_string_lossy().into_owned().into_bytes()\n48\t}\n49\t\n50\t/// Emulates glibc's `atoi`, which is `(int)strtol(nptr, NULL, 10)`:\n51\t/// leading whitespace is skipped, an optional sign is honoured, digits are\n52\t/// consumed until a non-digit, out-of-range values saturate at `LONG_MIN` /\n53\t/// `LONG_MAX` and the result is then truncated to `int`.\n54\tfn c_atoi(s: &[u8]) -> c_int {\n55\t    let mut i = 0usize;\n56\t    while i < s.len() && matches!(s[i], b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r') {\n57\t        i += 1;\n58\t    }\n59\t\n60\t    let mut negative = false;\n61\t    if i < s.len() && (s[i] == b'+' || s[i] == b'-') {\n62\t        negative = s[i] == b'-';\n63\t        i += 1;\n64\t    }\n65\t\n66\t    let mut acc: i64 = 0;\n67\t    let mut overflowed = false;\n68\t    while i < s.len() && s[i].is_ascii_digit() {\n69\t        let digit = i64::from(s[i] - b'0');\n70\t        if !overflowed {\n71\t            match acc.checked_mul(10).and_then(|v| v.checked_add(digit)) {\n72\t                Some(v) => acc = v,\n73\t                None => overflowed = true,\n74\t            }\n75\t        }\n76\t        i += 1;\n77\t    }\n78\t\n79\t    let value: i64 = if overflowed {\n80\t        if negative {\n81\t            i64::MIN\n82\t        } else {\n83\t            i64::MAX\n84\t        }\n85\t    } else if negative {\n86\t        -acc\n87\t    } else {\n88\t        acc\n89\t    };\n90\t\n91\t    value as c_int\n92\t}\n93\t\n94\tfn main() -> ExitCode {\n95\t    let args: Vec<OsString> = std::env::args_os().collect();\n96\t    let argc = args.len();\n97\t\n98\t    if argc < 3 {\n99\t        let prog = args\n100\t            .first()\n101\t            .map(|a| a.to_string_lossy().into_owned())\n102\t            .unwrap_or_default();\n103\t        eprint!(\"usage: {} A B\\