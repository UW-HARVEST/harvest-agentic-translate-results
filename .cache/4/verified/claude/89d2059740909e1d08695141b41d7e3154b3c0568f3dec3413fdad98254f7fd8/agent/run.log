{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_017WqTkeH4CU7VhmhvhY9EUK","type":"tool_result","content":"1\t/*\n2\t * Copyright 2025 MIT Lincoln Laboratory\n3\t * Permission is hereby granted, free of charge,\n4\t * to any person obtaining a copy of this software\n5\t * and associated documentation files (the \"Software\"),\n6\t * to deal in the Software without restriction,\n7\t * including without limitation the rights to use, copy,\n8\t * modify, merge, publish, distribute, sublicense,\n9\t * and/or sell copies of the Software,\n10\t * and to permit persons to whom the Software is furnished to do so,\n11\t * subject to the following conditions:\n12\t *\n13\t * The above copyright notice and this permission notice\n14\t * shall be included in all copies or substantial portions of the Software.\n15\t *\n16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n18\t * THE WARRANTIES OF MERCHANTABILITY,\n19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n24\t */\n25\t//! main.rs -- translation of main.c\n26\t\n27\t/// `printf`-alike: writes to the buffered stdout handle and, like `printf`,\n28\t/// silently ignores write errors instead of panicking.\n29\tmacro_rules! cprintf {\n30\t    ($out:expr, $($arg:tt)*) => {{\n31\t        let _ = std::io::Write::write_fmt($out, format_args!($($arg)*));\n32\t    }};\n33\t}\n34\t\n35\tmod generic_containers;\n36\tmod inventory;\n37\t\n38\tuse std::io::{BufReader, BufWriter, Read, Stdin, Write};\n39\t\n40\tuse generic_containers::{Array, List};\n41\tuse inventory::{\n42\t    calculate_inventory_stats, calculate_order_stats, create_item, create_order,\n43\t    find_items_by_category, print_item, print_order, ItemT, OrderT,\n44\t};\n45\t\n46\t/// `void print_menu(void)`\n47\tfn print_menu(out: &mut dyn Write) {\n48\t    cprintf!(out, \"\\n\");\n49\t    cprintf!(out, \"========================================\\n\");\n50\t    cprintf!(out, \"  GENERIC FOR_EACH MACRO DEMO\\n\");\n51\t    cprintf!(out, \"========================================\\n\");\n52\t    cprintf!(out, \"1. Demo: Integer Containers\\n\");\n53\t    cprintf!(out, \"2. Demo: Double Containers\\n\");\n54\t    cprintf!(out, \"3. Demo: Inventory Array\\n\");\n55\t    cprintf!(out, \"4. Demo: Order List\\n\");\n56\t    cprintf!(out, \"5. Demo: Mixed Operations\\n\");\n57\t    cprintf!(out, \"6. Run All Demos\\n\");\n58\t    cprintf!(out, \"7. Exit\\n\");\n59\t    cprintf!(out, \"========================================\\n\");\n60\t    cprintf!(out, \"Choice: \");\n61\t}\n62\t\n63\t/// `void demo_integer_containers(void)`\n64\tfn demo_integer_containers(out: &mut dyn Write) {\n65\t    cprintf!(out, \"\\n\");\n66\t    cprintf!(out, \"========================================\\n\");\n67\t    cprintf!(out, \"  DEMO 1: Integer Containers\\n\");\n68\t    cprintf!(out, \"========================================\\n\");\n69\t\n70\t    // Create integer array\n71\t    let mut int_array: Array<i32> = Array::create(10);\n72\t    cprintf!(out, \"\\n--- Integer Array ---\\n\");\n73\t    cprintf!(out, \"Adding integers: 10, 20, 30, 40, 50\\n\");\n74\t    int_array.push(10);\n75\t    int_array.push(20);\n76\t    int_array.push(30);\n77\t    int_array.push(40);\n78\t    int_array.push(50);\n79\t\n80\t    cprintf!(out, \"Array contents: \");\n81\t    for val in int_array.iter() {\n82\t        cprintf!(out, \"{} \", val);\n83\t    }\n84\t    cprintf!(out, \"\\n\");\n85\t\n86\t    // Calculate sum using ARRAY_FOREACH\n87\t    let mut sum: i32 = 0;\n88\t    for val in int_array.iter() {\n89\t        sum = sum.wrapping_add(*val);\n90\t    }\n91\t    cprintf!(out, \"Sum: {}\\n\", sum);\n92\t    cprintf!(\n93\t        out,\n94\t        \"Average: {:.2}\\n\",\n95\t        (sum as f64) / (int_array.size() as f64)\n96\t    );\n97\t\n98\t    // Create integer list\n99\t    let mut int_list: List<i32> = List::create();\n100\t    cprintf!(out, \"\\n--- Integer List ---\\n\");\n101\t    cprintf!(out, \"Adding integers: 100, 200, 300, 400, 500\\n\");\n102\t    int_list.append(100);\n103\t    int_list.append(200);\n104\t    int_list.append(300);\n105\t    int_list.append(400);\n106\t    int_list.append(500);\n107\t\n108\t    cprintf!(out, \"List contents: \");\n109\t    for val in int_list.iter() {\n110\t        cprintf!(out, \"{} \", val);\n111\t    }\n112\t    cprintf!(out, \"\\n\");\n113\t\n114\t    // Calculate product using LIST_FOREACH\n115\t    let mut product: i64 = 1;\n116\t    for val in int_list.iter() {\n117\t        product = product.wrapping_mul(*val as i64);\n118\t    }\n119\t    cprintf!(out, \"Product: {}\\n\", product);\n120\t}\n121\t\n122\t/// `void demo_double_containers(void)`\n123\tfn demo_double_containers(out: &mut dyn Write) {\n124\t    cprintf!(out, \"\\n\");\n125\t    cprintf!(out, \"========================================\\n\");\n126\t    cprintf!(out, \"  DEMO 2: Double Containers\\n\");\n127\t    cprintf!(out, \"========================================\\n\");\n128\t\n129\t    // Create double array\n130\t    let mut double_array: Array<f64> = Array::create(5);\n131\t    cprintf!(out, \"\\n--- Double Array (Temperatures in Celsius) ---\\n\");\n132\t\n133\t    let temps: [f64; 7] = [23.5, 25.0, 22.8, 26.3, 24.1, 21.9, 27.5];\n134\t    let num_temps: i32 = temps.len() as i32;\n135\t\n136\t    cprintf!(out, \"Adding temperatures: \");\n137\t    for i in 0..num_temps {\n138\t        double_array.push(temps[i as usize]);\n139\t        cprintf!(out, \"{:.1} \", temps[i as usize]);\n140\t    }\n141\t    cprintf!(out, \"\\n\");\n142\t\n143\t    // Find min, max, average using ARRAY_FOREACH\n144\t    let mut min_temp: f64 = temps[0];\n145\t    let mut max_temp: f64 = temps[0];\n146\t    let mut sum_temp: f64 = 0.0;\n147\t\n148\t    for temp in double_array.iter() {\n149\t        if *temp < min_temp {\n150\t            min_temp = *temp;\n151\t        }\n152\t        if *temp > max_temp {\n153\t            max_temp = *temp;\n154\t        }\n155\t        sum_temp += *temp;\n156\t    }\n157\t\n158\t    cprintf!(out, \"Minimum: {:.1}\\u{b0}C\\n\", min_temp);\n159\t    cprintf!(out, \"Maximum: {:.1}\\u{b0}C\\n\", max_temp);\n160\t    cprintf!(\n161\t        out,\n162\t        \"Average: {:.1}\\u{b0}C\\n\",\n163\t        sum_temp / (double_array.size() as f64)\n164\t    );\n165\t\n166\t    // Create double list\n167\t    let mut price_list: List<f64> = List::create();\n168\t    cprintf!(out, \"\\n--- Double List (Product Prices) ---\\n\");\n169\t\n170\t    let prices: [f64; 6] = [9.99, 14.50, 7.25, 22.00, 5.99, 18.75];\n171\t    let num_prices: i32 = prices.len() as i32;\n172\t\n173\t    cprintf!(out, \"Adding prices: \");\n174\t    for i in 0..num_prices {\n175\t        price_list.append(prices[i as usize]);\n176\t        cprintf!(out, \"${:.2} \", prices[i as usize]);\n177\t    }\n178\t    cprintf!(out, \"\\n\");\n179\t\n180\t    // Calculate total and find items under $10 using LIST_FOREACH\n181\t    let mut total: f64 = 0.0;\n182\t    let mut count_under_10: i32 = 0;\n183\t\n184\t    for temp in price_list.iter() {\n185\t        total += *temp;\n186\t        if *temp < 10.0 {\n187\t            count_under_10 += 1;\n188\t        }\n189\t    }\n190\t\n191\t    cprintf!(out, \"Total cost: ${:.2}\\n\", total);\n192\t    cprintf!(out, \"Items under $10: {}\\n\", count_under_10);\n193\t}\n194\t\n195\t/// `void demo_inventory_array(void)`\n196\tfn demo_inventory_array(out: &mut dyn Write) {\n197\t    cprintf!(out, \"\\n\");\n198\t    cprintf!(out, \"========================================\\n\");\n199\t    cprintf!(out, \"  DEMO 3: Inventory Array (Items)\\n\");\n200\t    cprintf!(out, \"========================================\\n\");\n201\t\n202\t    // Create inventory array\n203\t    let mut inventory: Array<ItemT> = Array::create(20);\n204\t\n205\t    // Add items\n206\t    cprintf!(out, \"\\n--- Adding Items to Inventory ---\\n\");\n207\t    inventory.push(create_item(1, \"Laptop\", \"Electronics\", 899.99, 15));\n208\t    inventory.push(create_item(2, \"Mouse\", \"Electronics\", 24.99, 50));\n209\t    inventory.push(create_item(3, \"Keyboard\", \"Electronics\", 79.99, 30));\n210\t    inventory.push(create_item(4, \"Monitor\", \"Electronics\", 299.99, 20));\n211\t    inventory.push(create_item(5, \"Desk Chair\", \"Furniture\", 199.99, 10));\n212\t    inventory.push(create_item(6, \"Desk\", \"Furniture\", 349.99, 8));\n213\t    inventory.push(create_item(7, \"Notebook\", \"Office\", 4.99, 100));\n214\t    inventory.push(create_item(8, \"Pen Set\", \"Office\", 12.99, 75));\n215\t    inventory.push(create_item(9, \"USB Cable\", \"Electronics\", 9.99, 60));\n216\t    inventory.push(create_item(10, \"Bookshelf\", \"Furniture\", 149.99, 12));\n217\t\n218\t    cprintf!(out, \"Added {} items to inventory\\n\", inventory.size());\n219\t\n220\t    // Display all items using ARRAY_FOREACH\n221\t    cprintf!(out, \"\\n--- All Inventory Items ---\\n\");\n222\t    for item in inventory.iter() {\n223\t        print_item(out, item);\n224\t        cprintf!(out, \"\\n\");\n225\t    }\n226\t\n227\t    // Calculate statistics\n228\t    calculate_inventory_stats(out, &inventory);\n229\t\n230\t    // Find items by category\n231\t    find_items_by_category(out, &inventory, \"Electronics\");\n232\t    find_items_by_category(out, &inventory, \"Furniture\");\n233\t\n234\t    // Find low stock items using ARRAY_FOREACH\n235\t    cprintf!(out, \"\\n--- Low Stock Items (< 20) ---\\n\");\n236\t    let mut low_stock_count: i32 = 0;\n237\t    for item in inventory.iter() {\n238\t        if item.quantity < 20 {\n239\t            print_item(out, item);\n240\t            low_stock_count += 1;\n241\t        }\n242\t    }\n243\t    cprintf!(out, \"Total low stock items: {}\\n\", low_stock_count);\n244\t}\n245\t\n246\t/// `void demo_order_list(void)`\n247\tfn demo_order_list(out: &mut dyn Write) {\n248\t    cprintf!(out, \"\\n\");\n249\t    cprintf!(out, \"========================================\\n\");\n250\t    cprintf!(out, \"  DEMO 4: Order List (Orders)\\n\");\n251\t    cprintf!(out, \"========================================\\n\");\n252\t\n253\t    // Create order list\n254\t    let mut orders: List<OrderT> = List::create();\n255\t\n256\t    // Add orders\n257\t    cprintf!(out, \"\\n--- Adding Orders ---\\n\");\n258\t    orders.append(create_order(1001, \"Alice Johnson\", 1249.95));\n259\t    orders.append(create_order(1002, \"Bob Smith\", 89.99));\n260\t    orders.append(create_order(1003, \"Carol White\", 549.98));\n261\t    orders.append(create_order(1004, \"David Brown\", 24.99));\n262\t    orders.append(create_order(1005, \"Eve Davis\", 899.99));\n263\t    orders.append(create_order(1006, \"Frank Miller\", 374.97));\n264\t    orders.append(create_order(1007, \"Grace Lee\", 159.98));\n265\t    orders.append(create_order(1008, \"Henry Wilson\", 1099.99));\n266\t\n267\t    cprintf!(out, \"Added {} orders\\n\", orders.size());\n268\t\n269\t    // Display all orders using LIST_FOREACH\n270\t    cprintf!(out, \"\\n--- All Orders ---\\n\");\n271\t    for order in orders.iter() {\n272\t        print_order(out, order);\n273\t    }\n274\t\n275\t    // Calculate statistics\n276\t    calculate_order_stats(out, &orders);\n277\t\n278\t    // Find large orders using LIST_FOREACH\n279\t    cprintf!(out, \"\\n--- Large Orders (> $500) ---\\n\");\n280\t    let mut large_order_count: i32 = 0;\n281\t    let mut large_order_total: f64 = 0.0;\n282\t\n283\t    for order in orders.iter() {\n284\t        if order.total_amount > 500.0 {\n285\t            print_order(out, order);\n286\t            large_order_count += 1;\n287\t            large_order_total += order.total_amount;\n288\t        }\n289\t    }\n290\t\n291\t    cprintf!(out, \"Total large orders: {}\\n\", large_order_count);\n292\t    cprintf!(\n293\t        out,\n294\t        \"Revenue from large orders: ${:.2}\\n\",\n295\t        large_order_total\n296\t    );\n297\t}\n298\t\n299\t/// `void demo_mixed_operations(void)`\n300\tfn demo_mixed_operations(out: &mut dyn Write) {\n301\t    cprintf!(out, \"\\n\");\n302\t    cprintf!(out, \"========================================\\n\");\n303\t    cprintf!(out, \"  DEMO 5: Mixed Operations\\n\");\n304\t    cprintf!(out, \"========================================\\n\");\n305\t\n306\t    // Create both array and list with items\n307\t    let mut array_inventory: Array<ItemT> = Array::create(10);\n308\t    let mut list_inventory: List<ItemT> = List::create();\n309\t\n310\t    cprintf!(out, \"\\n--- Populating both Array and List ---\\n\");\n311\t\n312\t    // Add same items to both\n313\t    let items: [ItemT; 5] = [\n314\t        create_item(1, \"Smartphone\", \"Electronics\", 699.99, 25),\n315\t        create_item(2, \"Tablet\", \"Electronics\", 449.99, 18),\n316\t        create_item(3, \"Headphones\", \"Electronics\", 149.99, 40),\n317\t        create_item(4, \"Smart Watch\", \"Electronics\", 299.99, 22),\n318\t        create_item(5, \"Power Bank\", \"Electronics\", 39.99, 55),\n319\t    ];\n320\t\n321\t    let num_items: i32 = items.len() as i32;\n322\t\n323\t    for i in 0..num_items {\n324\t        array_inventory.push(items[i as usize]);\n325\t        list_inventory.append(items[i as usize]);\n326\t    }\n327\t\n328\t    cprintf!(out, \"Added {} items to both containers\\n\", num_items);\n329\t\n330\t    // Compare iteration performance (conceptually)\n331\t    cprintf!(out, \"\\n--- Iterating through Array ---\\n\");\n332\t    let mut array_count: i32 = 0;\n333\t    for _item in array_inventory.iter() {\n334\t        array_count += 1;\n335\t    }\n336\t    cprintf!(out, \"Array iteration count: {}\\n\", array_count);\n337\t\n338\t    cprintf!(out, \"\\n--- Iterating through List ---\\n\");\n339\t    let mut list_count: i32 = 0;\n340\t    for _item in list_inventory.iter() {\n341\t        list_count += 1;\n342\t    }\n343\t    cprintf!(out, \"List iteration count: {}\\n\", list_count);\n344\t\n345\t    // Find items above certain price in both\n346\t    let price_threshold: f64 = 200.0;\n347\t\n348\t    cprintf!(\n349\t        out,\n350\t        \"\\n--- Items above ${:.2} (Array) ---\\n\",\n351\t        price_threshold\n352\t    );\n353\t    for item in array_inventory.iter() {\n354\t        if item.price >= price_threshold {\n355\t            cprintf!(\n356\t                out,\n357\t                \"  {}: ${:.2}\\n\",\n358\t                String::from_utf8_lossy(c_str(&item.name)),\n359\t                item.price\n360\t            );\n361\t        }\n362\t    }\n363\t\n364\t    cprintf!(\n365\t        out,\n366\t        \"\\n--- Items above ${:.2} (List) ---\\n\",\n367\t        price_threshold\n368\t    );\n369\t    for item in list_inventory.iter() {\n370\t        if item.price >= price_threshold {\n371\t            cprintf!(\n372\t                out,\n373\t                \"  {}: ${:.2}\\n\",\n374\t                String::from_utf8_lossy(c_str(&item.name)),\n375\t                item.price\n376\t            );\n377\t        }\n378\t    }\n379\t}\n380\t\n381\t/// Bytes of a NUL-terminated fixed buffer, as `printf(\"%s\", ...)` sees them.\n382\tfn c_str(buf: &[u8]) -> &[u8] {\n383\t    let end = buf.iter().position(|&b| b == 0).unwrap_or(buf.len());\n384\t    &buf[..end]\n385\t}\n386\t\n387\t/// `fgets(input, size, stdin)`: reads at most `size - 1` bytes, stopping after a\n388\t/// newline (which is kept) or at EOF. Returns `None` for the `NULL` result,\n389\t/// i.e. when nothing at all could be read.\n390\tfn fgets(reader: &mut BufReader<Stdin>, size: usize) -> Option<Vec<u8>> {\n391\t    let max = size - 1;\n392\t    let mut buf: Vec<u8> = Vec::new();\n393\t    while buf.len() < max {\n394\t        let mut byte = [0u8; 1];\n395\t        match reader.read(&mut byte) {\n396\t            Ok(0) => break,\n397\t            Ok(_) => {\n398\t                buf.push(byte[0]);\n399\t                if byte[0] == b'\\n' {\n400\t                    break;\n401\t                }\n402\t            }\n403\t            Err(_) => return None,\n404\t        }\n405\t    }\n406\t    if buf.is_empty() {\n407\t        None\n408\t    } else {\n409\t        Some(buf)\n410\t    }\n411\t}\n412\t\n413\t/// `sscanf(input, \"%d\", &choice)`: `Some(value)` when the conversion succeeds\n414\t/// (return value 1), `None` for a matching failure or input failure.\n415\t///\n416\t/// Reproduces glibc's behavior of accumulating into a `long` (saturating at\n417\t/// `LONG_MIN`/`LONG_MAX`) and then storing the truncated `int`.\n418\tfn sscanf_d(input: &[u8]) -> Option<i32> {\n419\t    // A C string ends at the first NUL byte.\n420\t    let s = {\n421\t        let end = input.iter().position(|&b| b == 0).unwrap_or(input.len());\n422\t        &input[..end]\n423\t    };\n424\t\n425\t    let mut i = 0usize;\n426\t    while i < s.len() && matches!(s[i], b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r') {\n427\t        i += 1;\n428\t    }\n429\t\n430\t    let mut negative = false;\n431\t    if i < s.len() && (s[i] == b'+' || s[i] == b'-') {\n432\t        negative = s[i] == b'-';\n433\t        i += 1;\n434\t    }\n435\t\n436\t    let start_digits = i;\n437\t    let mut acc: i64 = 0;\n438\t    while i < s.len() && s[i].is_ascii_digit() {\n439\t        let digit = (s[i] - b'0') as i64;\n440\t        acc = if negative {\n441\t            acc.saturating_mul(10).saturating_sub(digit)\n442\t        } else {\n443\t            acc.saturating_mul(10).saturating_add(digit)\n444\t        };\n445\t        i += 1;\n446\t    }\n447\t\n448\t    if i == start_digits {\n449\t        // No digits: matching failure (0) or, if the input was exhausted while\n450\t        // skipping whitespace, an input failure (EOF). Neither equals 1.\n451\t        return None;\n452\t    }\n453\t\n454\t    Some(acc as i32)\n455\t}\n456\t\n457\tfn main() {\n458\t    let stdout = std::io::stdout();\n459\t    let mut out = BufWriter::new(stdout.lock());\n460\t    let out: &mut dyn Write = &mut out;\n461\t\n462\t    cprintf!(out, \"\\u{2554}{}\\u{2557}\\n\", \"\\u{2550}\".repeat(40));\n463\t    cprintf!(out, \"\\u{2551}   GENERIC FOR_EACH MACRO DEMO         \\u{2551}\\n\");\n464\t    cprintf!(out, \"\\u{2551}   Demonstrating Generic Containers    \\u{2551}\\n\");\n465\t    cprintf!(out, \"\\u{255a}{}\\u{255d}\\n\", \"\\u{2550}\".repeat(40));\n466\t\n467\t    let mut reader = BufReader::new(std::io::stdin());\n468\t\n469\t    loop {\n470\t        print_menu(out);\n471\t\n472\t        // Show the prompt before blocking on input (glibc flushes line-buffered\n473\t        // stdout when reading from an interactive stdin).\n474\t        let _ = out.flush();\n475\t\n476\t        let input = match fgets(&mut reader, 256) {\n477\t            Some(line) => line,\n478\t            None => break,\n479\t        };\n480\t\n481\t        let choice = match sscanf_d(&input) {\n482\t            Some(value) => value,\n483\t            None => {\n484\t                cprintf!(out, \"Invalid input\\n\");\n485\t                continue;\n486\t            }\n487\t        };\n488\t\n489\t        match choice {\n490\t            1 => demo_integer_containers(out),\n491\t\n492\t            2 => demo_double_containers(out),\n493\t\n494\t            3 => demo_inventory_array(out),\n495\t\n496\t            4 => demo_order_list(out),\n497\t\n498\t            5 => demo_mixed_operations(out),\n499\t\n500\t            6 => {\n501\t                cprintf!(out, \"\\n=== Running All Demos ===\\n\");\n502\t                demo_integer_containers(out);\n503\t                demo_double_containers(out);\n504\t                demo_inventory_array(out);\n505\t                demo_order_list(out);\n506\t                demo_mixed_operations(out);\n507\t                cprintf!(out, \"\\n========================================\\n\");\n508\t                cprintf!(out, \"  All demos completed successfully!\\n\");\n509\t                cprintf!(out, \"========================================\\n\");\n510\t            }\n511\t\n512\t            7 => {\n513\t                cprintf!(out, \"\\nGoodbye!\\n\");\n514\t                let _ = out.flush();\n515\t                std::process::exit(0);\n516\t            }\n517\t\n518\t            _ => {\n519\t                cprintf!(out, \"Invalid choice\\n\");\n520\t            }\n521\t        }\n522\t    }\n523\t\n524\t    let _ = out.flush();\n525\t    std::process::exit(0);\n526\t}\n527\t"}]},"parent_tool_use_id":null,"session_id":"d399b7ab-efa0-48e3-8602-3102beab604c","uuid":"702a86b7-554f-4a52-851c-ce3b1717c3f4","timestamp":"2026-08-19T19:54:58.554Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-ma0vr7/translated_rust/src/main.rs","content":"/*\n * Copyright 2025 MIT Lincoln Laboratory\n * Permission is hereby granted, free of charge,\n * to any person obtaining a copy of this software\n * and associated documentation files (the \"Software\"),\n * to deal in the Software without restriction,\n * including without limitation the rights to use, copy,\n * modify, merge, publish, distribute, sublicense,\n * and/or sell copies of the Software,\n * and to permit persons to whom the Software is furnished to do so,\n * subject to the following conditions:\n *\n * The above copyright notice and this permission notice\n * shall be included in all copies or substantial portions of the Software.\n *\n * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n * THE WARRANTIES OF MERCHANTABILITY,\n * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n */\n//! main.rs -- translation of main.c\n\n/// `printf`-alike: writes to the buffered stdout handle and, like `printf`,\n/// silently ignores write errors instead of panicking.\nmacro_rules! cprintf {\n    ($out:expr, $($arg:tt)*) => {{\n        let _ = std::io::Write::write_fmt($out, format_args!($($arg)*));\n    }};\n}\n\nmod generic_containers;\nmod inventory;\n\nuse std::io::{BufReader, BufWriter, Read, Stdin, Write};\n\nuse generic_containers::{Array, List};\nuse inventory::{\n    calculate_inventory_stats, calculate_order_stats, create_item, create_order,\n    find_items_by_category, print_item, print_order, ItemT, OrderT,\n};\n\n/// `void print_menu(void)`\nfn print_menu(out: &mut dyn Write) {\n    cprintf!(out, \"\\n\");\n    cprintf!(out, \"========================================\\n\");\n    cprintf!(out, \"  GENERIC FOR_EACH MACRO DEMO\\n\");\n    cprintf!(out, \"========================================\\n\");\n    cprintf!(out, \"1. Demo: Integer Containers\\n\");\n    cprintf!(out, \"2. Demo: Double Containers\\n\");\n    cprintf!(out, \"3. Demo: Inventory Array\\n\");\n    cprintf!(out, \"4. Demo: Order List\\n\");\n    cprintf!(out, \"5. Demo: Mixed Operations\\n\");\n    cprintf!(out, \"6. Run All Demos\\n\");\n    cprintf!(out, \"7. Exit\\n\");\n    cprintf!(out, \"========================================\\n\");\n    cprintf!(out, \"Choice: \");\n}\n\n/// `void demo_integer_containers(void)`\nfn demo_integer_containers(out: &mut dyn Write) {\n    cprintf!(out, \"\\n\");\n    cprintf!(out, \"========================================\\n\");\n    cprintf!(out, \"  DEMO 1: Integer Containers\\n\");\n    cprintf!(out, \"========================================\\n\");\n\n    // Create integer array\n    let mut int_array: Array<i32> = Array::create(10);\n    cprintf!(out, \"\\n--- Integer Array ---\\n\");\n    cprintf!(out, \"Adding integers: 10, 20, 30, 40, 50\\n\");\n    int_array.push(10);\n    int_array.push(20);\n    int_array.push(30);\n    int_array.push(40);\n    int_array.push(50);\n\n    cprintf!(out, \"Array contents: \");\n    for val in int_array.iter() {\n        cprintf!(out, \"{} \", val);\n    }\n    cprintf!(out, \"\\n\");\n\n    // Calculate sum using ARRAY_FOREACH\n    let mut sum: i32 = 0;\n    for val in int_array.iter() {\n        sum = sum.wrapping_add(*val);\n    }\n    cprintf!(out, \"Sum: {}\\n\", sum);\n    cprintf!(\n        out,\n        \"Average: {:.2}\\n\",\n        (sum as f64) / (int_array.size() as f64)\n    );\n\n    // Create integer list\n    let mut int_list: List<i32> = List::create();\n    cprintf!(out, \"\\n--- Integer List ---\\n\");\n    cprintf!(out, \"Adding integers: 100, 200, 300, 400, 500\\n\");\n    int_list.append(100);\n    int_list.append(200);\n    int_list.append(300);\n    int_list.append(400);\n    int_list.append(500);\n\n    cprintf!(out, \"List contents: \");\n    for val in int_list.iter() {\n        cprintf!(out, \"{} \", val);\n    }\n    cprintf!(out, \"\\n\");\n\n    // Calculate product using LIST_FOREACH\n    let mut product: i64 = 1;\n    for val in int_list.iter() {\n        product = product.wrapping_mul(*val as i64);\n    }\n    cprintf!(out, \"Product: {}\\n\", product);\n}\n\n/// `void demo_double_containers(void)`\nfn demo_double_containers(out: &mut dyn Write) {\n    cprintf!(out, \"\\n\");\n    cprintf!(out, \"========================================\\n\");\n    cprintf!(out, \"  DEMO 2: Double Containers\\n\");\n    cprintf!(out, \"========================================\\n\");\n\n    // Create double array\n    let mut double_array: Array<f64> = Array::create(5);\n    cprintf!(out, \"\\n--- Double Array (Temperatures in Celsius) ---\\n\");\n\n    let temps: [f64; 7] = [23.5, 25.0, 22.8, 26.3, 24.1, 21.9, 27.5];\n    let num_temps: i32 = temps.len() as i32;\n\n    cprintf!(out, \"Adding temperatures: \");\n    for i in 0..num_temps {\n        double_array.push(temps[i as usize]);\n        cprintf!(out, \"{:.1} \", temps[i as usize]);\n    }\n    cprintf!(out, \"\\n\");\n\n    // Find min, max, average using ARRAY_FOREACH\n    let mut min_temp: f64 = temps[0];\n    let mut max_temp: f64 = temps[0];\n    let mut sum_temp: f64 = 0.0;\n\n    for temp in double_array.iter() {\n        if *temp < min_temp {\n            min_temp = *temp;\n        }\n        if *temp > max_temp {\n            max_temp = *temp;\n        }\n        sum_temp += *temp;\n    }\n\n    cprintf!(out, \"Minimum: {:.1}\\u{b0}C\\n\", min_temp);\n    cprintf!(out, \"Maximum: {:.1}\\u{b0}C\\n\", max_temp);\n    cprintf!(\n        out,\n        \"Average: {:.1}\\u{b0}C\\n\",\n        sum_temp / (double_array.size() as f64)\n    );\n\n    // Create double list\n    let mut price_list: List<f64> = List::create();\n    cprintf!(out, \"\\n--- Double List (Product Prices) ---\\n\");\n\n    let prices: [f64; 6] = [9.99, 14.50, 7.25, 22.00, 5.99, 18.75];\n    let num_prices: i32 = prices.len() as i32;\n\n    cprintf!(out, \"Adding prices: \");\n    for i in 0..num_prices {\n        price_list.append(prices[i as usize]);\n        cprintf!(out, \"${:.2} \", prices[i as usize]);\n    }\n    cprintf!(out, \"\\n\");\n\n    // Calculate total and find items under $10 using LIST_FOREACH\n    let mut total: f64 = 0.0;\n    let mut count_under_10: i32 = 0;\n\n    for temp in price_list.iter() {\n        total += *temp;\n        if *temp < 10.0 {\n            count_under_10 += 1;\n        }\n    }\n\n    cprintf!(out, \"Total cost: ${:.2}\\n\", total);\n    cprintf!(out, \"Items under $10: {}\\n\", count_under_10);\n}\n\n/// `void demo_inventory_array(void)`\nfn demo_inventory_array(out: &mut dyn Write) {\n    cprintf!(out, \"\\n\");\n    cprintf!(out, \"========================================\\n\");\n    cprintf!(out, \"  DEMO 3: Inventory Array (Items)\\n\");\n    cprintf!(out, \"========================================\\n\");\n\n    // Create inventory array\n    let mut inventory: Array<ItemT> = Array::create(20);\n\n    // Add items\n    cprintf!(out, \"\\n--- Adding Items to Inventory ---\\n\");\n    inventory.push(create_item(1, \"Laptop\", \"Electronics\", 899.99, 15));\n    inventory.push(create_item(2, \"Mouse\", \"Electronics\", 24.99, 50));\n    inventory.push(create_item(3, \"Keyboard\", \"Electronics\", 79.99, 30));\n    inventory.push(create_item(4, \"Monitor\", \"Electronics\", 299.99, 20));\n    inventory.push(create_item(5, \"Desk Chair\", \"Furniture\", 199.99, 10));\n    inventory.push(create_item(6, \"Desk\", \"Furniture\", 349.99, 8));\n    inventory.push(create_item(7, \"Notebook\", \"Office\", 4.99, 100));\n    inventory.push(create_item(8, \"Pen Set\", \"Office\", 12.99, 75));\n    inventory.push(create_item(9, \"USB Cable\", \"Electronics\", 9.99, 60));\n    inventory.push(create_item(10, \"Bookshelf\", \"Furniture\", 149.99, 12));\n\n    cprintf!(out, \"Added {} items to inventory\\n\", inventory.size());\n\n    // Display all items using ARRAY_FOREACH\n    cprintf!(out, \"\\n--- All Inventory Items ---\\n\");\n    for item in inventory.iter() {\n        print_item(out, item);\n        cprintf!(out, \"\\n\");\n    }\n\n    // Calculate statistics\n    calculate_inventory_stats(out, &inventory);\n\n    // Find items by category\n    find_items_by_category(out, &inventory, \"Electronics\");\n    find_items_by_category(out, &inventory, \"Furniture\");\n\n    // Find low stock items using ARRAY_FOREACH\n    cprintf!(out, \"\\n--- Low Stock Items (< 20) ---\\n\");\n    let mut low_stock_count: i32 = 0;\n    for item in inventory.iter() {\n        if item.quantity < 20 {\n            print_item(out, item);\n            low_stock_count += 1;\n        }\n    }\n    cprintf!(out, \"Total low stock items: {}\\n\", low_stock_count);\n}\n\n/// `void demo_order_list(void)`\nfn demo_order_list(out: &mut dyn Write) {\n    cprintf!(out, \"\\n\");\n    cprintf!(out, \"========================================\\n\");\n    cprintf!(out, \"  DEMO 4: Order List (Orders)\\n\");\n    cprintf!(out, \"========================================\\n\");\n\n    // Create order list\n    let mut orders: List<OrderT> = List::create();\n\n    // Add orders\n    cprintf!(out, \"\\n--- Adding Orders ---\\n\");\n    orders.append(create_order(1001, \"Alice Johnson\", 1249.95));\n    orders.append(create_order(1002, \"Bob Smith\", 89.99));\n    orders.append(create_order(1003, \"Carol White\", 549.98));\n    orders.append(create_order(1004, \"David Brown\", 24.99));\n    orders.append(create_order(1005, \"Eve Davis\", 899.99));\n    orders.append(create_order(1006, \"Frank Miller\", 374.97));\n    orders.append(create_order(1007, \"Grace Lee\", 159.98));\n    orders.append(create_order(1008, \"Henry Wilson\", 1099.99));\n\n    cprintf!(out, \"Added {} orders\\n\", orders.size());\n\n    // Display all orders using LIST_FOREACH\n    cprintf!(out, \"\\n--- All Orders ---\\n\");\n    for order in orders.iter() {\n        print_order(out, order);\n    }\n\n    // Calculate statistics\n    calculate_order_stats(out, &orders);\n\n    // Find large orders using LIST_FOREACH\n    cprintf!(out, \"\\n--- Large Orders (> $500) ---\\n\");\n    let mut large_order_count: i32 = 0;\n    let mut large_order_total: f64 = 0.0;\n\n    for order in orders.iter() {\n        if order.total_amount > 500.0 {\n            print_order(out, order);\n            large_order_count += 1;\n            large_order_total += order.total_amount;\n        }\n    }\n\n    cprintf!(out, \"Total large orders: {}\\n\", large_order_count);\n    cprintf!(\n        out,\n        \"Revenue from large orders: ${:.2}\\n\",\n        large_order_total\n    );\n}\n\n/// `void demo_mixed_operations(void)`\nfn demo_mixed_operations(out: &mut dyn Write) {\n    cprintf!(out, \"\\n\");\n    cprintf!(out, \"========================================\\n\");\n    cprintf!(out, \"  DEMO 5: Mixed Operations\\n\");\n    cprintf!(out, \"========================================\\n\");\n\n    // Create both array and list with items\n    let mut array_inventory: Array<ItemT> = Array::create(10);\n    let mut list_inventory: List<ItemT> = List::create();\n\n    cprintf!(out, \"\\n--- Populating both Array and List ---\\n\");\n\n    // Add same items to both\n    let items: [ItemT; 5] = [\n        create_item(1, \"Smartphone\", \"Electronics\", 699.99, 25),\n        create_item(2, \"Tablet\", \"Electronics\", 449.99, 18),\n        create_item(3, \"Headphones\", \"Electronics\", 149.99, 40),\n        create_item(4, \"Smart Watch\", \"Electronics\", 299.99, 22),\n        create_item(5, \"Power Bank\", \"Electronics\", 39.99, 55),\n    ];\n\n    let num_items: i32 = items.len() as i32;\n\n    for i in 0..num_items {\n        array_inventory.push(items[i as usize]);\n        list_inventory.append(items[i as usize]);\n    }\n\n    cprintf!(out, \"Added {} items to both containers\\n\", num_items);\n\n    // Compare iteration performance (conceptually)\n    cprintf!(out, \"\\n--- Iterating through Array ---\\n\");\n    let mut array_count: i32 = 0;\n    for _item in array_inventory.iter() {\n        array_count += 1;\n    }\n    cprintf!(out, \"Array iteration count: {}\\n\", array_count);\n\n    cprintf!(out, \"\\n--- Iterating through List ---\\n\");\n    let mut list_count: i32 = 0;\n    for _item in list_inventory.iter() {\n        list_count += 1;\n    }\n    cprintf!(out, \"List iteration count: {}\\n\", list_count);\n\n    // Find items above certain price in both\n    let price_threshold: f64 = 200.0;\n\n    cprintf!(\n        out,\n        \"\\n--- Items above ${:.2} (Array) ---\\n\",\n        price_threshold\n    );\n    for item in array_inventory.iter() {\n        if item.price >= price_threshold {\n            cprintf!(\n                out,\n                \"  {}: ${:.2}\\n\",\n                String::from_utf8_lossy(c_str(&item.name)),\n                item.price\n            );\n        }\n    }\n\n    cprintf!(\n        out,\n        \"\\n--- Items above ${:.2} (List) ---\\n\",\n        price_threshold\n    );\n    for item in list_inventory.iter() {\n        if item.price >= price_threshold {\n            cprintf!(\n                out,\n                \"  {}: ${:.2}\\n\",\n                String::from_utf8_lossy(c_str(&item.name)),\n                item.price\n            );\n        }\n    }\n}\n\n/// Bytes of a NUL-terminated fixed buffer, as `printf(\"%s\", ...)` sees them.\nfn c_str(buf: &[u8]) -> &[u8] {\n    let end = buf.iter().position(|&b| b == 0).unwrap_or(buf.len());\n    &buf[..end]\n}\n\n/// `fgets(input, size, stdin)`: reads at most `size - 1` bytes, stopping after a\n/// newline (which is kept) or at EOF. Returns `None` for the `NULL` result,\n/// i.e. when nothing at all could be read.\nfn fgets(reader: &mut BufReader<Stdin>, size: usize) -> Option<Vec<u8>> {\n    let max = size - 1;\n    let mut buf: Vec<u8> = Vec::new();\n    while buf.len() < max {\n        let mut byte = [0u8; 1];\n        match reader.read(&mut byte) {\n            Ok(0) => break,\n            Ok(_) => {\n                buf.push(byte[0]);\n                if byte[0] == b'\\n' {\n                    break;\n                }\n            }\n            Err(_) => return None,\n        }\n    }\n    if buf.is_empty() {\n        None\n    } else {\n        Some(buf)\n    }\n}\n\n/// `sscanf(input, \"%d\", &choice)`: `Some(value)` when the conversion succeeds\n/// (return value 1), `None` for a matching failure or input failure.\n///\n/// Reproduces glibc's behavior of accumulating into a `long` (saturating at\n/// `LONG_MIN`/`LONG_MAX`) and then storing the truncated `int`.\nfn sscanf_d(input: &[u8]) -> Option<i32> {\n    // A C string ends at the first NUL byte.\n    let s = {\n        let end = input.iter().position(|&b| b == 0).unwrap_or(input.len());\n        &input[..end]\n    };\n\n    let mut i = 0usize;\n    while i < s.len() && matches!(s[i], b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r') {\n        i += 1;\n    }\n\n    let mut negative = false;\n    if i < s.len() && (s[i] == b'+' || s[i] == b'-') {\n        negative = s[i] == b'-';\n        i += 1;\n    }\n\n    let start_digits = i;\n    let mut acc: i64 = 0;\n    while i < s.len() && s[i].is_ascii_digit() {\n        let digit = (s[i] - b'0') as i64;\n        acc = if negative {\n            acc.saturating_mul(10).saturating_sub(digit)\n        } else {\n            acc.saturating_mul(10).saturating_add(digit)\n        };\n        i += 1;\n    }\n\n    if i == start_digits {\n        // No digits: matching failure (0) or, if the input was exhausted while\n        // skipping whitespace, an input failure (EOF). Neither equals 1.\n        return None;\n    }\n\n    Some(acc as i32)\n}\n\nfn main() {\n    let stdout = std::io::stdout();\n    let mut out = BufWriter::new(stdout.lock());\n    let out: &mut dyn Write = &mut out;\n\n    cprintf!(out, \"\\u{2554}{}\\u{2557}\\n\", \"\\u{2550}\".repeat(40));\n    cprintf!(out, \"\\u{2551}   GENERIC FOR_EACH MACRO DEMO         \\u{2551}\\n\");\n    cprintf!(out, \"\\u{2551}   Demonstrating Generic Containers    \\u{2551}\\n\");\n    cprintf!(out, \"\\u{255a}{}\\u{255d}\\n\", \"\\u{2550}\".repeat(40));\n\n    let mut reader = BufReader::new(std::io::stdin());\n\n    loop {\n        print_menu(out);\n\n        // Show the prompt before blocking on input (glibc flushes line-buffered\n        // stdout when reading from an interactive stdin).\n        let _ = out.flush();\n\n        let input = match fgets(&mut reader, 256) {\n            Some(line) => line,\n            None => break,\n        };\n\n        let choice = match sscanf_d(&input) {\n            Some(value) => value,\n            None => {\n                cprintf!(out, \"Invalid input\\n\");\n                continue;\n            }\n        };\n\n        match choice {\n            1 => demo_integer_containers(out),\n\n            2 => demo_double_containers(out),\n\n            3 => demo_inventory_array(out),\n\n            4 => demo_order_list(out),\n\n            5 => demo_mixed_operations(out),\n\n            6 => {\n                cprintf!(out, \"\\n=== Running All Demos ===\\n\");\n                demo_integer_containers(out);\n                demo_double_containers(out);\n                demo_inventory_array(out);\n                demo_order_list(out);\n                demo_mixed_operations(out);\n                cprintf!(out, \"\\n========================================\\n\");\n                cprintf!(out, \"  All demos completed successfully!\\n\");\n                cprintf!(out, \"========================================\\n\");\n            }\n\n            7 => {\n                cprintf!(out, \"\\nGoodbye!\\n\");\n                let _ = out.flush();\n                std::process::exit(0);\n            }\n\n            _ => {\n                cprintf!(out, \"Invalid choice\\n\");\n            }\n        }\n    }\n\n    let _ = out.flush();\n    std::process::exit(0);\n}\n","numLines":527,"startLine":1,"totalLines":527}}}
