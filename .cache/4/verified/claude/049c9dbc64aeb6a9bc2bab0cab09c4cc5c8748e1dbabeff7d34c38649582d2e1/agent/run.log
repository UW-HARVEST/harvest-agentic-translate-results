-                .any(|w| w == b\"Error: Failed to all\"));","-        }","     }","-    let _ = seen_minus_one;","-","-    // Neither library ever emits the allocation-failure diagnostic on a healthy","-    // allocator.","-    let (_, out) = capture(|| {","-        c().checkshift(1, 2, 3, 4);","-        r().checkshift(1, 2, 3, 4);","-    });","-    assert!(!out","-        .windows(43)","-        .any(|w| w == b\"Error: Failed to allocate memory for state\\n\"));"," }"," "," // ==========================================================================="]}],"userModified":false,"replaceAll":false}}
