{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01SnmYHEARq7aJsFL1NA3VJx","type":"tool_result","content":"1\t// Copyright 2025 MIT Lincoln Laboratory\n2\t// Permission is hereby granted, free of charge,\n3\t// to any person obtaining a copy of this software\n4\t// and associated documentation files (the \"Software\"),\n5\t// to deal in the Software without restriction,\n6\t// including without limitation the rights to use, copy,\n7\t// modify, merge, publish, distribute, sublicense,\n8\t// and/or sell copies of the Software,\n9\t// and to permit persons to whom the Software is furnished to do so,\n10\t// subject to the following conditions:\n11\t//\n12\t// The above copyright notice and this permission notice\n13\t// shall be included in all copies or substantial portions of the Software.\n14\t//\n15\t// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n16\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n17\t// THE WARRANTIES OF MERCHANTABILITY,\n18\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n19\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n20\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n21\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n22\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n23\t\n24\t//! Translation of `ComputeState` and its helpers (`compute_checksum`,\n25\t//! `init_state`, `apply_operation`) from `c_src/src/lib.c`.\n26\t\n27\tuse core::ffi::{c_int, c_uint};\n28\t\n29\tuse crate::cio::{print_i, print_lit};\n30\tuse crate::ops::OperationFunc;\n31\t\n32\t/// `#define MAGIC_NUMBER 0xDEADBEEF`\n33\tconst MAGIC_NUMBER: c_uint = 0xDEAD_BEEF;\n34\t/// `#define MASK_LOWER 0x0000FFFF`\n35\tconst MASK_LOWER: c_uint = 0x0000_FFFF;\n36\t\n37\t/// ```c\n38\t/// typedef struct {\n39\t///     int accumulator;\n40\t///     int operation_count;\n41\t///     unsigned int checksum;\n42\t/// } ComputeState;\n43\t/// ```\n44\t#[repr(C)]\n45\t#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n46\tpub struct ComputeState {\n47\t    pub accumulator: c_int,\n48\t    pub operation_count: c_int,\n49\t    pub checksum: c_uint,\n50\t}\n51\t\n52\t/// `unsigned int compute_checksum(int* values, int count)`\n53\t///\n54\t/// Copies up to the first four `int`s into a byte buffer, folds them into a\n55\t/// rotating checksum, mixes in `MAGIC_NUMBER` and returns the low 16 bits.\n56\t///\n57\t/// Note that the fold walks the raw object representation of the `int`s, so the\n58\t/// result depends on the host byte order exactly as the C version does. When\n59\t/// `values` is null or `count <= 0` nothing is folded and the result is `0`.\n60\t///\n61\t/// # Safety\n62\t///\n63\t/// If `values` is non-null and `count > 0`, `values` must be readable for\n64\t/// `min(count, 4)` `int`s.\n65\t#[unsafe(no_mangle)]\n66\tpub unsafe extern \"C\" fn compute_checksum(values: *mut c_int, count: c_int) -> c_uint {\n67\t    let mut checksum: c_uint = 0;\n68\t    // `unsigned char buffer[sizeof(int) * 4];` - left uninitialised in C, but\n69\t    // only the freshly copied prefix is ever read.\n70\t    let mut buffer = [0u8; core::mem::size_of::<c_int>() * 4];\n71\t\n72\t    if !values.is_null() && count > 0 {\n73\t        let copy_count = if count > 4 { 4 } else { count } as usize;\n74\t        let byte_len = core::mem::size_of::<c_int>() * copy_count;\n75\t\n76\t        // memcpy(buffer, values, sizeof(int) * copy_count);\n77\t        // SAFETY: the caller guarantees `values` holds at least `copy_count`\n78\t        // readable `int`s, and `byte_len <= buffer.len()`.\n79\t        unsafe {\n80\t            core::ptr::copy_nonoverlapping(values as *const u8, buffer.as_mut_ptr(), byte_len);\n81\t        }\n82\t\n83\t        for &byte in &buffer[..byte_len] {\n84\t            checksum = (checksum << 1) ^ c_uint::from(byte);\n85\t        }\n86\t\n87\t        checksum ^= MAGIC_NUMBER;\n88\t    }\n89\t\n90\t    checksum & MASK_LOWER\n91\t}\n92\t\n93\t/// `void init_state(ComputeState* state, int initial_value)`\n94\t///\n95\t/// Overwrites `*state` with `{initial_value, 0, 0}` and logs the accumulator.\n96\t/// A null `state` reports an error and returns.\n97\t///\n98\t/// # Safety\n99\t///\n100\t/// `state` must be null or point to a writable `ComputeState`.\n101\t#[unsafe(no_mangle)]\n102\tpub unsafe extern \"C\" fn init_state(state: *mut ComputeState, initial_value: c_int) {\n103\t    if state.is_null() {\n104\t        print_lit(b\"Error: state pointer is NULL in init_state\\n\\0\");\n105\t        return;\n106\t    }\n107\t\n108\t    let template = ComputeState {\n109\t        accumulator: initial_value,\n110\t        operation_count: 0,\n111\t        checksum: 0x0000,\n112\t    };\n113\t\n114\t    // memcpy(state, &template, sizeof(ComputeState));\n115\t    // SAFETY: `state` is non-null and, per the contract, points to a writable\n116\t    // `ComputeState`.\n117\t    unsafe { core::ptr::write(state, template) };\n118\t\n119\t    // SAFETY: `state` was just fully initialised above.\n120\t    print_i(\n121\t        b\"State initialized with accumulator = %d\\n\\0\",\n122\t        unsafe { (*state).accumulator },\n123\t    );\n124\t}\n125\t\n126\t/// `void apply_operation(ComputeState* state, int value, operation_func func)`\n127\t///\n128\t/// Folds `value` into `state->accumulator` using `func` and bumps\n129\t/// `state->operation_count`. A null `state` or `func` reports an error and\n130\t/// leaves the state untouched.\n131\t///\n132\t/// # Safety\n133\t///\n134\t/// `state` must be null or point to an initialised, writable `ComputeState`;\n135\t/// `func` must be null or callable.\n136\t#[unsafe(no_mangle)]\n137\tpub unsafe extern \"C\" fn apply_operation(\n138\t    state: *mut ComputeState,\n139\t    value: c_int,\n140\t    func: OperationFunc,\n141\t) {\n142\t    if state.is_null() {\n143\t        print_lit(b\"Error: state pointer is NULL in apply_operation\\n\\0\");\n144\t        return;\n145\t    }\n146\t\n147\t    let Some(func) = func else {\n148\t        print_lit(b\"Error: operation function pointer is NULL in apply_operation\\n\\0\");\n149\t        return;\n150\t    };\n151\t\n152\t    // SAFETY: `state` is non-null and points to an initialised `ComputeState`.\n153\t    unsafe {\n154\t        (*state).accumulator = func((*state).accumulator, value);\n155\t        (*state).operation_count = (*state).operation_count.wrapping_add(1);\n156\t    }\n157\t}\n158\t"}]},"parent_tool_use_id":null,"session_id":"b67cf027-de35-46ba-8757-83b8d3207f66","uuid":"f03eb76f-4b21-40f7-90ed-2066af4eb8fe","timestamp":"2026-08-19T17:57:58.200Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-JilLTL/translated_rust/src/state.rs","content":"// Copyright 2025 MIT Lincoln Laboratory\n// Permission is hereby granted, free of charge,\n// to any person obtaining a copy of this software\n// and associated documentation files (the \"Software\"),\n// to deal in the Software without restriction,\n// including without limitation the rights to use, copy,\n// modify, merge, publish, distribute, sublicense,\n// and/or sell copies of the Software,\n// and to permit persons to whom the Software is furnished to do so,\n// subject to the following conditions:\n//\n// The above copyright notice and this permission notice\n// shall be included in all copies or substantial portions of the Software.\n//\n// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n// THE WARRANTIES OF MERCHANTABILITY,\n// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n\n//! Translation of `ComputeState` and its helpers (`compute_checksum`,\n//! `init_state`, `apply_operation`) from `c_src/src/lib.c`.\n\nuse core::ffi::{c_int, c_uint};\n\nuse crate::cio::{print_i, print_lit};\nuse crate::ops::OperationFunc;\n\n/// `#define MAGIC_NUMBER 0xDEADBEEF`\nconst MAGIC_NUMBER: c_uint = 0xDEAD_BEEF;\n/// `#define MASK_LOWER 0x0000FFFF`\nconst MASK_LOWER: c_uint = 0x0000_FFFF;\n\n/// ```c\n/// typedef struct {\n///     int accumulator;\n///     int operation_count;\n///     unsigned int checksum;\n/// } ComputeState;\n/// ```\n#[repr(C)]\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub struct ComputeState {\n    pub accumulator: c_int,\n    pub operation_count: c_int,\n    pub checksum: c_uint,\n}\n\n/// `unsigned int compute_checksum(int* values, int count)`\n///\n/// Copies up to the first four `int`s into a byte buffer, folds them into a\n/// rotating checksum, mixes in `MAGIC_NUMBER` and returns the low 16 bits.\n///\n/// Note that the fold walks the raw object representation of the `int`s, so the\n/// result depends on the host byte order exactly as the C version does. When\n/// `values` is null or `count <= 0` nothing is folded and the result is `0`.\n///\n/// # Safety\n///\n/// If `values` is non-null and `count > 0`, `values` must be readable for\n/// `min(count, 4)` `int`s.\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn compute_checksum(values: *mut c_int, count: c_int) -> c_uint {\n    let mut checksum: c_uint = 0;\n    // `unsigned char buffer[sizeof(int) * 4];` - left uninitialised in C, but\n    // only the freshly copied prefix is ever read.\n    let mut buffer = [0u8; core::mem::size_of::<c_int>() * 4];\n\n    if !values.is_null() && count > 0 {\n        let copy_count = if count > 4 { 4 } else { count } as usize;\n        let byte_len = core::mem::size_of::<c_int>() * copy_count;\n\n        // memcpy(buffer, values, sizeof(int) * copy_count);\n        // SAFETY: the caller guarantees `values` holds at least `copy_count`\n        // readable `int`s, and `byte_len <= buffer.len()`.\n        unsafe {\n            core::ptr::copy_nonoverlapping(values as *const u8, buffer.as_mut_ptr(), byte_len);\n        }\n\n        for &byte in &buffer[..byte_len] {\n            checksum = (checksum << 1) ^ c_uint::from(byte);\n        }\n\n        checksum ^= MAGIC_NUMBER;\n    }\n\n    checksum & MASK_LOWER\n}\n\n/// `void init_state(ComputeState* state, int initial_value)`\n///\n/// Overwrites `*state` with `{initial_value, 0, 0}` and logs the accumulator.\n/// A null `state` reports an error and returns.\n///\n/// # Safety\n///\n/// `state` must be null or point to a writable `ComputeState`.\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn init_state(state: *mut ComputeState, initial_value: c_int) {\n    if state.is_null() {\n        print_lit(b\"Error: state pointer is NULL in init_state\\n\\0\");\n        return;\n    }\n\n    let template = ComputeState {\n        accumulator: initial_value,\n        operation_count: 0,\n        checksum: 0x0000,\n    };\n\n    // memcpy(state, &template, sizeof(ComputeState));\n    // SAFETY: `state` is non-null and, per the contract, points to a writable\n    // `ComputeState`.\n    unsafe { core::ptr::write(state, template) };\n\n    // SAFETY: `state` was just fully initialised above.\n    print_i(\n        b\"State initialized with accumulator = %d\\n\\0\",\n        unsafe { (*state).accumulator },\n    );\n}\n\n/// `void apply_operation(ComputeState* state, int value, operation_func func)`\n///\n/// Folds `value` into `state->accumulator` using `func` and bumps\n/// `state->operation_count`. A null `state` or `func` reports an error and\n/// leaves the state untouched.\n///\n/// # Safety\n///\n/// `state` must be null or point to an initialised, writable `ComputeState`;\n/// `func` must be null or callable.\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn apply_operation(\n    state: *mut ComputeState,\n    value: c_int,\n    func: OperationFunc,\n) {\n    if state.is_null() {\n        print_lit(b\"Error: state pointer is NULL in apply_operation\\n\\0\");\n        return;\n    }\n\n    let Some(func) = func else {\n        print_lit(b\"Error: operation function pointer is NULL in apply_operation\\n\\0\");\n        return;\n    };\n\n    // SAFETY: `state` is non-null and points to an initialised `ComputeState`.\n    unsafe {\n        (*state).accumulator = func((*state).accumulator, value);\n        (*state).operation_count = (*state).operation_count.wrapping_add(1);\n    }\n}\n","numLines":158,"startLine":1,"totalLines":158}}}
