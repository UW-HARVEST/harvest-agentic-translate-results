r\n   296\t}\r\n   297\t\r\n   298\tint c2Support(const c2v *verts, int count, c2v d) {\r\n   299\t\tint imax = 0;\r\n   300\t\tfloat dmax = c2Dot(verts[0], d);\r\n   301\t\tfor (int i = 1; i < count; ++i) {\r\n   302\t\t\tfloat dot = c2Dot(verts[i], d);\r\n   303\t\t\tif (dot > dmax) {\r\n   304\t\t\t\timax = i;\r\n   305\t\t\t\tdmax = dot;\r\n   306\t\t\t}\r\n   307\t\t}\r\n   308\t\treturn imax;\r\n   309\t}\r\n   310\t\r\n   311\tvoid c2Witness(c2Simplex *s, c2v *a, c2v *b) {\r\n   312\t\tfloat den = 1.0f / s->div;\r\n   313\t\tswitch (s->count) {\r\n   314\t\t\tcase 1:\r\n   315\t\t\t\t*a = s->a.sA;\r\n   316\t\t\t\t*b = s->a.sB;\r\n   317\t\t\t\tbreak;\r\n   318\t\t\tcase 2:\r\n   319\t\t\t\t*a = c2Add(c2Mulvs(s->a.sA, (den * s->a.u)),\r\n   320\t\t\t\t\t\tc2Mulvs(s->b.sA, (den * s->b.u)));\r\n   321\t\t\t\t*b = c2Add(c2Mulvs(s->a.sB, (den * s->a.u)),\r\n   322\t\t\t\t\t\tc2Mulvs(s->b.sB, (den * s->b.u)));\r\n   323\t\t\t\tbreak;\r\n   324\t\t\tcase 3:\r\n   325\t\t\t\t*a = c2Add(c2Add(c2Mulvs(s->a.sA, (den * s->a.u)),\r\n   326\t\t\t\t\t\t\tc2Mulvs(s->b.sA, (den * s->b.u))),\r\n   327\t\t\t\t\t\tc2Mulvs(s->c.sA, (den * s->c.u)));\r\n   328\t\t\t\t*b = c2Add(c2Add(c2Mulvs(s->a.sB, (den * s->a.u)),\r\n   329\t\t\t\t\t\t\tc2Mulvs(s->b.sB, (den * s->b.u))),\r\n   330\t\t\t\t\t\tc2Mulvs(s->c.sB, (den * s->c.u)));\r\n   331\t\t\t\tbreak;\r\n   332\t\t\tdefault:\r\n   333\t\t\t\t*a = c2V(0, 0);\r\n   334\t\t\t\t*b = c2V(0, 0);\r\n   335\t\t}\r\n   336\t}\r\n   337\t\r\n   338\tc2v c2Div(c2v a, float b) {\r\n   339\t\treturn c2Mulvs(a, 1.0f / b);\r\n   340\t}\r\n   341\t\r\n   342\tc2v c2Norm(c2v a) {\r\n   343\t\treturn c2Div(a, c2Len(a));\r\n   344\t}\r\n   345\t\r\n   346\tc2v c2L(c2Simplex *s) {\r\n   347\t    float den = 1.0f / s->div;\r\n   348\t    switch (s->count) {\r\n   349\t    case 1:\r\n   350\t        return s->a.p;\r\n   351\t    case 2:\r\n   352\t        return c2Add(c2Mulvs(s->a.p, (den * s->a.u)),\r\n   353\t                     c2Mulvs(s->b.p, (d