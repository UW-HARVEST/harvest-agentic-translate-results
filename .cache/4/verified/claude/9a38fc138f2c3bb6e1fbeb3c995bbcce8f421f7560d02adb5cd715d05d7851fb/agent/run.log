ell-formed inputs behave\n132\t/// exactly like the C original while malformed ones cannot corrupt memory or\n133\t/// panic across the FFI boundary.\n134\t#[inline]\n135\tfn ix(i: c_int, n: c_int) -> usize {\n136\t    if i < 0 {\n137\t        0\n138\t    } else if i >= n {\n139\t        (n - 1) as usize\n140\t    } else {\n141\t        i as usize\n142\t    }\n143\t}\n144\t\n145\t// ---------------------------------------------------------------------------\n146\t// Basic math\n147\t// ---------------------------------------------------------------------------\n148\t\n149\t#[unsafe(no_mangle)]\n150\tpub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n151\t    let mut a = c2v { x: 0.0, y: 0.0 };\n152\t    a.x = x;\n153\t    a.y = y;\n154\t    a\n155\t}\n156\t\n157\t#[unsafe(no_mangle)]\n158\tpub extern \"C\" fn c2Mulvs(mut a: c2v, b: f32) -> c2v {\n159\t    a.x *= b;\n160\t    a.y *= b;\n161\t    a\n162\t}\n163\t\n164\t#[unsafe(no_mangle)]\n165\tpub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n166\t    c2V(\n167\t        if a.x > b.x { a.x } else { b.x },\n168\t        if a.y > b.y { a.y } else { b.y },\n169\t    )\n170\t}\n171\t\n172\t#[unsafe(no_mangle)]\n173\tpub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n174\t    c2V(\n175\t        if a.x < b.x { a.x } else { b.x },\n176\t        if a.y < b.y { a.y } else { b.y },\n177\t    )\n178\t}\n179\t\n180\t#[unsafe(no_mangle)]\n181\tpub extern \"C\" fn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n182\t    c2Maxv(lo, c2Minv(a, hi))\n183\t}\n184\t\n185\t#[unsafe(no_mangle)]\n186\tpub extern \"C\" fn c2Sub(mut a: c2v, b: c2v) -> c2v {\n187\t    a.x -= b.x;\n188\t    a.y -= b.y;\n189\t    a\n190\t}\n191\t\n192\t#[unsafe(no_mangle)]\n193\tpub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n194\t    a.x * b.x + a.y * b.y\n195\t}\n196\t\n197\t#[unsafe(no_mangle)]\n198\tpub extern \"C\" fn c2RotIdentity() -> c2r {\n199\t    let mut r = c2r { c: 0.0, s: 0.0 };\n200\t    r.c = 1.0f32;\n201\t    r.s = 0.0;\n202\t    r\n203\t}\n204\t\n205\t#[unsafe(no_mangle)]\n206\tpub extern \"C\" fn c2xIdentity() -> c2x {\n207\t    let mut x = c2x {\n208\t        p: c2v { x: 0.0, y: 0.0 },\n209\t        r: c2r { c: 0.0, s: 0.0 },\n210\t    };\n211\t    x.p = c2V(0.0, 0.0);\n212\t    x.r = c2RotIdentity();\n213\t    x\n214\t}\n215\t\n216\t// ---------------------------------------------------------------------------\n217\t// Proxies\n218\t// ---------------------------------------------------------------------------\n219\t\n220\t#[unsafe(no_mangle)]\n221\tpub unsafe extern \"C\" fn c2BBVerts(out: *mut c2v, bb: *mut c2AABB) {\n222\t    unsafe {\n223\t        let bb = &*bb;\n224\t        *out.add(0) = bb.min;\n225\t        *out.add(1) = c2V(bb.max.x, bb.min.y);\n226\t        *out.add(2) = bb.max;\n227\t        *out.add(3) = c2V(bb.min.x, bb.max.y);\n228\t    }\n229\t}\n230\t\n231\t#[unsafe(no_mangle)]\n232\tpub unsafe extern \"C\" fn c2MakeProxy(shape: *const c_void, type_: c_int, p: *mut c2Proxy) {\n233\t    unsafe {\n234\t        let p = &mut *p;\n235\t        match type_ {\n236\t            C2_TYPE_CIRCLE => {\n237\t                let c = &*(shape as *const c2Circle);\n238\t                p.radius = c.r;\n239\t                p.count = 1;\n240\t                p.verts[0] = c.p;\n241\t            }\n242\t            C2_TYPE_AABB => {\n243\t                let bb = shape as *mut c2AABB;\n244\t                p.radius = 0.0;\n245\t                p.count = 4;\n246\t                c2BBVerts(p.verts.as_mut_ptr(), bb);\n247\t            }\n248\t            C2_TYPE_CAPSULE => {\n249\t                let c = &*(shape as *const c2Capsule);\n250\t                p.radius = c.r;\n251\t                p.count = 2;\n252\t                p.verts[0] = c.a;\n253\t                p.verts[1] = c.b;\n254\t            }\n255\t            // No `default` label in the C switch: nothing happens.\n256\t            _ => {}\n257\t        }\n258\t    }\n259\t}\n260\t\n261\t// ---------------------------------------------------------------------------\n262\t// More math\n263\t// ---------------------------------------------------------------------------\n264\t\n265\t#[unsafe(no_mangle)]\n266\tpub extern \"C\" fn c2Len(a: c2v) -> f32 {\n267\t    c2Dot(a, a).sqrt()\n268\t}\n269\t\n270\t#[unsafe(no_mangle)]\n271\tpub extern \"C\" fn c2Det2(a: c2v, b: c2v) -> f32 {\n272\t    a.x * b.y - a.y * b.x\n273\t}\n274\t\n275\t#[unsafe(no_mangle)]\n276\tpub unsafe extern \"C\" fn c2GJKSimplexMetric(s: *mut c2Simplex) -> f32 {\n277\t    let s = unsafe { &*s };\n278\t    match s.count {\n279\t        2 => c2Len(c2Sub(s.b().p, s.a().p)),\n280\t        3 => c2Det2(c2Sub(s.b().p, s.a().p), c2Sub(s.c().p, s.a().p)),\n281\t        // `default:` falls through to `case 1:` which returns 0.\n282\t        _ => 0.0,\n283\t    }\n284\t}\n285\t\n286\t#[unsafe(no_mangle)]\n287\tpub extern \"C\" fn c2Mulrv(a: c2r, b: c2v) -> c2v {\n288\t    c2V(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)\n289\t}\n290\t\n291\t#[unsafe(no_mangle)]\n292\tpub extern \"C\" fn c2Add(mut a: c2v, b: c2v) -> c2v {\n293\t    a.x += b.x;\n294\t    a.y += b.y;\n295\t    a\n296\t}\n297\t\n298\t#[unsafe(no_mangle)]\n299\tpub extern \"C\" fn c2Mulxv(a: c2x, b: c2v) -> c2v {\n300\t    c2Add(c2Mulrv(a.r, b), a.p)\n301\t}\n302\t\n303\t// ---------------------------------------------------------------------------\n304\t// Simplex solvers\n305\t// ---------------------------------------------------------------------------\n306\t\n307\t#[unsafe(no_mangle)]\n308\tpub unsafe extern \"C\" fn c22(s: *mut c2Simplex) {\n309\t    let s = unsafe { &mut *s };\n310\t    let a = s.a().p;\n311\t    let b = s.b().p;\n312\t    let u = c2Dot(b, c2Sub(b, a));\n313\t    let v = c2Dot(a, c2Sub(a, b));\n314\t    if v <= 0.0 {\n315\t        s.verts[0].u = 1.0f32;\n316\t        s.div = 1.0f32;\n317\t        s.count = 1;\n318\t    } else if u <= 0.0 {\n319\t        s.verts[0] = s.b();\n320\t        s.verts[0].u = 1.0f32;\n321\t        s.div = 1.0f32;\n322\t        s.count = 1;\n323\t    } else {\n324\t        s.verts[0].u = u;\n325\t        s.verts[1].u = v;\n326\t        s.div = u + v;\n327\t        s.count = 2;\n328\t    }\n329\t}\n330\t\n331\t#[unsafe(no_mangle)]\n332\tpub unsafe extern \"C\" fn c23(s: *mut c2Simplex) {\n333\t    let s = unsafe { &mut *s };\n334\t    let a = s.a().p;\n335\t    let b = s.b().p;\n336\t    let c = s.c().p;\n337\t    let uAB = c2Dot(b, c2Sub(b, a));\n338\t    let vAB = c2Dot(a, c2Sub(a, b));\n339\t    let uBC = c2Dot(c, c2Sub(c, b));\n340\t    let vBC = c2Dot(b, c2Sub(b, c));\n341\t    let uCA = c2Dot(a, c2Sub(a, c));\n342\t    let vCA = c2Dot(c, c2Sub(c, a));\n343\t    let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n344\t    let uABC = c2Det2(b, c) * area;\n345\t    let vABC = c2Det2(c, a) * area;\n346\t    let wABC = c2Det2(a, b) * area;\n347\t    if vAB <= 0.0 && uCA <= 0.0 {\n348\t        s.verts[0].u = 1.0f32;\n349\t        s.div = 1.0f32;\n350\t        s.count = 1;\n351\t    } else if uAB <= 0.0 && vBC <= 0.0 {\n352\t        s.verts[0] = s.b();\n353\t        s.verts[0].u = 1.0f32;\n354\t        s.div = 1.0f32;\n355\t        s.count = 1;\n356\t    } else if uBC <= 0.0 && vCA <= 0.0 {\n357\t        s.verts[0] = s.c();\n358\t        s.verts[0].u = 1.0f32;\n359\t        s.div = 1.0f32;\n360\t        s.count = 1;\n361\t    } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n362\t        s.verts[0].u = uAB;\n363\t        s.verts[1].u = vAB;\n364\t        s.div = uAB + vAB;\n365\t        s.count = 2;\n366\t    } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n367\t        s.verts[0] = s.b();\n368\t        s.verts[1] = s.c();\n369\t        s.verts[0].u = uBC;\n370\t        s.verts[1].u = vBC;\n371\t        s.div = uBC + vBC;\n372\t        s.count = 2;\n373\t    } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n374\t        s.verts[1] = s.a();\n375\t        s.verts[0] = s.c();\n376\t        s.verts[0].u = uCA;\n377\t        s.verts[1].u = vCA;\n378\t        s.div = uCA + vCA;\n379\t        s.count = 2;\n380\t    } else {\n381\t        s.verts[0].u = uABC;\n382\t        s.verts[1].u = vABC;\n383\t        s.verts[2].u = wABC;\n384\t        s.div = uABC + vABC + wABC;\n385\t        s.count = 3;\n386\t    }\n387\t}\n388\t\n389\t#[unsafe(no_mangle)]\n390\tpub extern \"C\" fn c2Neg(a: c2v) -> c2v {\n391\t    c2V(-a.x, -a.y)\n392\t}\n393\t\n394\t#[unsafe(no_mangle)]\n395\tpub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n396\t    let mut b = c2v { x: 0.0, y: 0.0 };\n397\t    b.x = -a.y;\n398\t    b.y = a.x;\n399\t    b\n400\t}\n401\t\n402\t#[unsafe(no_mangle)]\n403\tpub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n404\t    let mut b = c2v { x: 0.0, y: 0.0 };\n405\t    b.x = a.y;\n406\t    b.y = -a.x;\n407\t    b\n408\t}\n409\t\n410\t#[unsafe(no_mangle)]\n411\tpub unsafe extern \"C\" fn c2D(s: *mut c2Simplex) -> c2v {\n412\t    let s = unsafe { &*s };\n413\t    match s.count {\n414\t        1 => c2Neg(s.a().p),\n415\t        2 => {\n416\t            let ab = c2Sub(s.b().p, s.a().p);\n417\t            if c2Det2(ab, c2Neg(s.a().p)) > 0.0 {\n418\t                return c2Skew(ab);\n419\t            }\n420\t            c2CCW90(ab)\n421\t        }\n422\t        // case 3 and default\n423\t        _ => c2V(0.0, 0.0),\n424\t    }\n425\t}\n426\t\n427\t#[unsafe(no_mangle)]\n428\tpub unsafe extern \"C\" fn c2Support(verts: *const c2v, count: c_int, d: c2v) -> c_int {\n429\t    unsafe {\n430\t        let mut imax: c_int = 0;\n431\t        let mut dmax = c2Dot(*verts.add(0), d);\n432\t        let mut i: c_int = 1;\n433\t        while i < count {\n434\t            let dot = c2Dot(*verts.offset(i as isize), d);\n435\t            if dot > dmax {\n436\t                imax = i;\n437\t                dmax = dot;\n438\t            }\n439\t            i += 1;\n440\t        }\n441\t        imax\n442\t    }\n443\t}\n444\t\n445\t#[unsafe(no_mangle)]\n446\tpub unsafe extern \"C\" fn c2Witness(s: *mut c2Simplex, a: *mut c2v, b: *mut c2v) {\n447\t    unsafe {\n448\t        let s = &*s;\n449\t        let den = 1.0f32 / s.div;\n450\t        match s.count {\n451\t            1 => {\n452\t                *a = s.a().sA;\n453\t                *b = s.a().sB;\n454\t            }\n455\t            2 => {\n456\t                *a = c2Add(\n457\t                    c2Mulvs(s.a().sA, den * s.a().u),\n458\t                    c2Mulvs(s.b().sA, den * s.b().u),\n459\t                );\n460\t                *b = c2Add(\n461\t                    c2Mulvs(s.a().sB, den * s.a().u),\n462\t                    c2Mulvs(s.b().sB, den * s.b().u),\n463\t                );\n464\t            }\n465\t            3 => {\n466\t                *a = c2Add(\n467\t                    c2Add(\n468\t                        c2Mulvs(s.a().sA, den * s.a().u),\n469\t                        c2Mulvs(s.b().sA, den * s.b().u),\n470\t                    ),\n471\t                    c2Mulvs(s.c().sA, den * s.c().u),\n472\t                );\n473\t                *b = c2Add(\n474\t                    c2Add(\n475\t                        c2Mulvs(s.a().sB, den * s.a().u),\n476\t                        c2Mulvs(s.b().sB, den * s.b().u),\n477\t                    ),\n478\t                    c2Mulvs(s.c().sB, den * s.c().u),\n479\t                );\n480\t            }\n481\t            _ => {\n482\t                *a = c2V(0.0, 0.0);\n483\t                *b = c2V(0.0, 0.0);\n484\t            }\n485\t        }\n486\t    }\n487\t}\n488\t\n489\t#[unsafe(no_mangle)]\n490\tpub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n491\t    c2Mulvs(a, 1.0f32 / b)\n492\t}\n493\t\n494\t#[unsafe(no_mangle)]\n495\tpub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n496\t    c2Div(a, c2Len(a))\n497\t}\n498\t\n499\t#[unsafe(no_mangle)]\n500\tpub unsafe extern \"C\" fn c2L(s: *mut c2Simplex) -> c2v {\n501\t    let s = unsafe { &*s };\n502\t    let den = 1.0f32 / s.div;\n503\t    match s.count {\n504\t        1 => s.a().p,\n505\t        2 => c2Add(\n506\t            c2Mulvs(s.a().p, den * s.a().u),\n507\t            c2Mulvs(s.b().p, den * s.b().u),\n508\t        ),\n509\t        _ => c2V(0.0, 0.0),\n510\t    }\n511\t}\n512\t\n513\t#[unsafe(no_mangle)]\n514\tpub extern \"C\" fn c2MulrvT(a: c2r, b: c2v) -> c2v {\n515\t    c2V(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y)\n516\t}\n517\t\n518\t// ---------------------------------------------------------------------------\n519\t// GJK\n520\t// ---------------------------------------------------------------------------\n521\t\n522\t#[unsafe(no_mangle)]\n523\tpub unsafe extern \"C\" fn c2GJK(\n524\t    A: *const c_void,\n525\t    typeA: c_int,\n526\t    ax_ptr: *const c2x,\n527\t    B: *const c_void,\n528\t    typeB: c_int,\n529\t    bx_ptr: *const c2x,\n530\t    outA: *mut c2v,\n531\t    outB: *mut c2v,\n532\t    use_radius: c_int,\n533\t    iterations: *mut c_int,\n534\t    cache: *mut c2GJKCache,\n535\t) -> f32 {\n536\t    unsafe {\n537\t        let ax: c2x = if ax_ptr.is_null() {\n538\t            c2xIdentity()\n539\t        } else {\n540\t            *ax_ptr\n541\t        };\n542\t        let bx: c2x = if bx_ptr.is_null() {\n543\t            c2xIdentity()\n544\t        } else {\n545\t            *bx_ptr\n546\t        };\n547\t\n548\t        let mut pA = c2Proxy::default();\n549\t        let mut pB = c2Proxy::default();\n550\t        c2MakeProxy(A, typeA, &mut pA);\n551\t        c2MakeProxy(B, typeB, &mut pB);\n552\t\n553\t        let mut s = c2Simplex::default();\n554\t        let mut cache_was_read: c_int = 0;\n555\t        if !cache.is_null() {\n556\t            let cache_ref = &mut *cache;\n557\t            let cache_was_good = cache_ref.count != 0;\n558\t            if cache_was_good {\n559\t                let n = if cache_ref.count > 3 { 3 } else { cache_ref.count };\n560\t                let mut i: c_int = 0;\n561\t                while i < n {\n562\t                    let k = i as usize;\n563\t                    let iA = cache_ref.iA[k];\n564\t                    let iB = cache_ref.iB[k];\n565\t                    let sA = c2Mulxv(ax, pA.verts[ix(