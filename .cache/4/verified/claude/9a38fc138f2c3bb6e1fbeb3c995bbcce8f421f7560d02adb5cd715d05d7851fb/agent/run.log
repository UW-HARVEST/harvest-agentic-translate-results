rbatim.\n\n#![allow(non_snake_case)]\n#![allow(non_camel_case_types)]\n#![allow(non_upper_case_globals)]\n\nuse std::ffi::{c_int, c_void};\n\n// ---------------------------------------------------------------------------\n// FLT_MAX / FLT_EPSILON, exactly as spelled in the C source.\n// ---------------------------------------------------------------------------\nconst C2_FLT_MAX: f32 = 3.402_823_466_385_288_598_117_041_834_845_169_25e+38;\nconst C2_FLT_EPSILON: f32 = 1.192_092_895_507_812_5e-7;\n\n// ---------------------------------------------------------------------------\n// Types\n// ---------------------------------------------------------------------------\n\npub const C2_TYPE_CIRCLE: c_int = 0;\npub const C2_TYPE_AABB: c_int = 1;\npub const C2_TYPE_CAPSULE: c_int = 2;\n\n#[repr(C)]\n#[derive(Clone, Copy, Default, Debug)]\npub struct c2v {\n    pub x: f32,\n    pub y: f32,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Default, Debug)]\npub struct c2r {\n    pub c: f32,\n    pub s: f32,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Default, Debug)]\npub struct c2x {\n    pub p: c2v,\n    pub r: c2r,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Default, Debug)]\npub struct c2Circle {\n    pub p: c2v,\n    pub r: f32,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Default, Debug)]\npub struct c2AABB {\n    pub min: c2v,\n    pub max: c2v,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Default, Debug)]\npub struct c2Capsule {\n    pub a: c2v,\n    pub b: c2v,\n    pub r: f32,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Default, Debug)]\npub struct c2GJKCache {\n    pub metric: f32,\n    pub count: c_int,\n    pub iA: [c_int; 3],\n    pub iB: [c_int; 3],\n    pub div: f32,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Default, Debug)]\npub struct c2Proxy {\n    pub radius: f32,\n    pub count: c_int,\n    pub verts: [c2v; 8],\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Default, Debug)]\npub struct c2sv {\n    pub sA: c2v,\n    pub sB: c2v,\n    pub p: c2v,\n    pub u: f32,\n    pub iA: c_int,\n    pub iB: c_int,\n}\n\n/// The C declaration is\n/// `typedef struct { c2sv a, b, c, d; float div; int count; } c2Simplex;`\n/// `a`, `b`, `c` and `d` are contiguous (the C code walks them via\n/// `c2sv* verts = &s->a;`), so an array of four elements has identical layout.\n#[repr(C)]\n#[derive(Clone, Copy, Default, Debug)]\npub struct c2Simplex {\n    pub verts: [c2sv; 4],\n    pub div: f32,\n    pub count: c_int,\n}\n\nimpl c2Simplex {\n    #[inline]\n    fn a(&self) -> c2sv {\n        self.verts[0]\n    }\n    #[inline]\n    fn b(&self) -> c2sv {\n        self.verts[1]\n    }\n    #[inline]\n    fn c(&self) -> c2sv {\n        self.verts[2]\n    }\n}\n\n/// Index helper used only where the original C code would perform an\n/// out-of-bounds access (i.e. where the C behaviour is already undefined).\n/// For every in-range value it is the identity, so well-formed inputs behave\n/// exactly like the C original while malformed ones cannot corrupt memory or\n/// panic across the FFI boundary.\n#[inline]\nfn ix(i: c_int, n: c_int) -> usize {\n    if i < 0 {\n        0\n    } else if i >= n {\n        (n - 1) as usize\n    } else {\n        i as usize\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Basic math\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n    let mut a = c2v { x: 0.0, y: 0.0 };\n    a.x = x;\n    a.y = y;\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulvs(mut a: c2v, b: f32) -> c2v {\n    a.x *= b;\n    a.y *= b;\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n    c2V(\n        if a.x > b.x { a.x } else { b.x },\n        if a.y > b.y { a.y } else { b.y },\n    )\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n    c2V(\n        if a.x < b.x { a.x } else { b.x },\n        if a.y < b.y { a.y } else { b.y },\n    )\n}\n\n#[unsafe(no_