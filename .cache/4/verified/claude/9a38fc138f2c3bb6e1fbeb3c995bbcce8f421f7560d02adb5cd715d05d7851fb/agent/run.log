          *iterations = iter;\n730\t        }\n731\t        dist\n732\t    }\n733\t}\n734\t\n735\t// ---------------------------------------------------------------------------\n736\t// Boolean collision routines\n737\t// ---------------------------------------------------------------------------\n738\t\n739\t#[unsafe(no_mangle)]\n740\tpub extern \"C\" fn c2AABBtoAABB(A: c2AABB, B: c2AABB) -> c_int {\n741\t    let d0 = (B.max.x < A.min.x) as c_int;\n742\t    let d1 = (A.max.x < B.min.x) as c_int;\n743\t    let d2 = (B.max.y < A.min.y) as c_int;\n744\t    let d3 = (A.max.y < B.min.y) as c_int;\n745\t    ((d0 | d1 | d2 | d3) == 0) as c_int\n746\t}\n747\t\n748\t#[unsafe(no_mangle)]\n749\tpub extern \"C\" fn c2AABBtoCapsule(A: c2AABB, B: c2Capsule) -> c_int {\n750\t    let a = A;\n751\t    let b = B;\n752\t    let r = unsafe {\n753\t        c2GJK(\n754\t            &a as *const c2AABB as *const c_void,\n755\t            C2_TYPE_AABB,\n756\t            std::ptr::null(),\n757\t            &b as *const c2Capsule as *const c_void,\n758\t            C2_TYPE_CAPSULE,\n759\t            std::ptr::null(),\n760\t            std::ptr::null_mut(),\n761\t            std::ptr::null_mut(),\n762\t            1,\n763\t            std::ptr::null_mut(),\n764\t            std::ptr::null_mut(),\n765\t        )\n766\t    };\n767\t    if r != 0.0 {\n768\t        return 0;\n769\t    }\n770\t    1\n771\t}\n772\t\n773\t#[unsafe(no_mangle)]\n774\tpub extern \"C\" fn c2CapsuletoCapsule(A: c2Capsule, B: c2Capsule) -> c_int {\n775\t    let a = A;\n776\t    let b = B;\n777\t    let r = unsafe {\n778\t        c2GJK(\n779\t            &a as *const c2Capsule as *const c_void,\n780\t            C2_TYPE_CAPSULE,\n781\t            std::ptr::null(),\n782\t            &b as *const c2Capsule as *const c_void,\n783\t            C2_TYPE_CAPSULE,\n784\t            std::ptr::null(),\n785\t            std::ptr::null_mut(),\n786\t            std::ptr::null_mut(),\n787\t            1,\n788\t            std::ptr::nul