tect|if bin_pos >= bin_maxlen {|if bin_pos > bin_maxlen {\"\n\"strchr no longer matches the NUL terminator|detect|        if b == c {|        if b == c \\&\\& b != 0 {\"\n\"classifier ignores the alpha class|detect|if (c_num0 | c_alpha0) == 0 {|if (c_num0) == 0 {\"\n\"case folding mask ~32 -> ~16|detect|((c as u32) \\& !32u32)|((c as u32) \\& !16u32)\"\n\"strict-mode unconsumed-input check removed|detect|} else if hex_pos != hex_len {|} else if false {\"\n\"stored byte perturbed (| 1)|detect|*bin.wrapping_add(bin_pos) = c_acc | c_val;|*bin.wrapping_add(bin_pos) = c_acc | c_val | 1;\"\n\"hex_end reported one byte too far|detect|*hex_end_p = hex.wrapping_add(hex_pos);|*hex_end_p = hex.wrapping_add(hex_pos.wrapping_add(1));\"\n\"digit XOR constant 48 -> 49|detect|((c as u32) ^ 48u32) as u8|((c as u32) ^ 49u32) as u8\"\n\"alpha range upper bound 16 -> 17|detect|.wrapping_sub(16u32)|.wrapping_sub(17u32)\"\n\"alpha range lower bound 10 -> 11|detect|((c_alpha as u32).wrapping_sub(10u32))|((c_alpha as u32).wrapping_sub(11u32))\"\n\"c_val loses the num class|detect|(c_num0 \\& c_num) | (c_alpha0 \\& c_alpha)|(c_alpha0 \\& c_alpha)\"\n\"state toggle uses ^1 instead of ~|equivalent|state = !state;|state = state ^ 1;\"\n\"dead store bin_pos = 0 changed to 1|equivalent|        bin_pos = 0;|        bin_pos = 1;\"\n)\n\nok=0\nbad=0\nfor entry in \"${MUTANTS[@]}\"; do\n    IFS='|' read -r name expect from to <<< \"$entry\"\n    # `|` is the field separator, so patterns encode it as `\\&`-escaped pieces:\n    from=${from//\\\\&/&}\n    to=${to//\\\\&/&}\n    restore\n    if ! mutate \"$from\" \"$to\" 2>\"${TMPDIR:-/tmp}/mut_err\"; then\n        echo \"ERROR  cannot apply mutant: $name  ($(cat \"${TMPDIR:-/tmp}/mut_err\"))\"\n        bad=$((bad+1))\n        continue\n    fi\n    out=$(run_suite)\n    if echo \"$out\" | grep -q \"__BUILDFAIL__\"; then\n        echo \"ERROR  mutant does not compile: $name\"\n        bad=$((bad+1))\n        continue\n    fi\n    if echo \"$out\" | grep -q \"STALE SHARED OBJECT\"; then\n        echo \"ERROR  stale .so while testing: $name\"\n        bad=$((bad+1))\n        continue\n    fi\n    if echo \"$out\" | grep -q \"test result: FAILED\"; then\n        got=detect\n    else\n        got=equivalent\n    fi\n    if [ \"$got\" = \"$expect\" ]; then\n        echo \"PASS   [$expect] $name\"\n        ok=$((ok+1))\n    else\n        echo \"FAIL   expected=$expect got=$got : $name\"\n        bad=$((bad+1))\n    fi\ndone\nrestore\ntimeout 600 cargo build --no-default-features > /dev/null 2>&1\necho \"---- $ok/${#MUTANTS[@]} mutants behaved as expected ($bad unexpected) ----\"\n[ \"$bad\" -eq 0 ]\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":716,"cache_read_input_tokens":106440,"cache_creation":{"ephemeral_5m_input_tokens":716,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"50d36bc7-360c-4640-8993-4d9186dc09e4","uuid":"5acbe266-972e-4ec9-a792-48599247fba1","timestamp":"2026-08-19T12:50:37.695Z"}
