check\"\n  \"strchr does not match the NUL terminator\"\n  \"state toggle uses ^1 instead of ~\"\n)\ndeclare -a FROM=(\n  \"c_val.wrapping_mul(16)\"\n  \"!ignore.is_null() && state == 0 &&\"\n  \"hex_pos = hex_pos.wrapping_sub(1);\"\n  \"if bin_pos >= bin_maxlen {\"\n  \"        if b == c {\"\n  \"state = !state;\"\n)\ndeclare -a TO=(\n  \"c_val.wrapping_mul(17)\"\n  \"!ignore.is_null() &&\"\n  \"hex_pos = hex_pos.wrapping_sub(0);\"\n  \"if bin_pos > bin_maxlen {\"\n  \"        if b == c && b != 0 {\"\n  \"state = state ^ 1;\"\n)\n\nfails=0\nfor i in \"${!NAMES[@]}\"; do\n    restore\n    mutate \"${FROM[$i]}\" \"${TO[$i]}\" || { echo \"SKIP  ${NAMES[$i]} (pattern missing)\"; continue; }\n    out=$(timeout 600 cargo test --no-default-features 2>&1)\n    if echo \"$out\" | grep -q \"test result: FAILED\"; then\n        n=$(echo \"$out\" | grep -c \"DIVERGENCE\")\n        echo \"PASS  mutation detected: ${NAMES[$i]}\"\n        fails=$((fails+1))\n    else\n        echo \"FAIL  mutation NOT detected: ${NAMES[$i]}  <-- harness blind spot\"\n        echo \"$out\" | tail -5\n    fi\ndone\nrestore\necho \"---- ${fails}/${#NAMES[@]} mutations detected ----\"\n[ \"$fails\" -eq \"${#NAMES[@]}\" ]\n","structuredPatch":[{"oldStart":50,"oldLines":7,"newStart":50,"newLines":14,"lines":[" for i in \"${!NAMES[@]}\"; do","     restore","     mutate \"${FROM[$i]}\" \"${TO[$i]}\" || { echo \"SKIP  ${NAMES[$i]} (pattern missing)\"; continue; }","+    # `cargo test` does NOT rebuild a cdylib-only lib target, so build first;","+    # the harness additionally refuses to run against a stale .so.","+    timeout 600 cargo build --no-default-features > /dev/null 2>&1","     out=$(timeout 600 cargo test --no-default-features 2>&1)","+    if echo \"$out\" | grep -q \"STALE SHARED OBJECT\"; then","+        echo \"FAIL  stale .so while testing ${NAMES[$i]}\"","+        continue","+    fi","     if echo \"$out\" | grep -q \"test result: FAILED\"; then","         n=$(echo \"$out\" | grep -c \"DIVER