clamped))'\n\nmutate \"0.5 * sum operand order swapped\" \\\n    'fmul(HALF, fadd(fadd(dy2, dx2), fsqrt(clamped)))' \\\n    'fmul(fadd(fadd(dy2, dx2), fsqrt(clamped)), HALF)'\n\nmutate \"clamp uses f32::max (normalises NaN and -0.0)\" \\\n    'let clamped = if flt(sqd, ZERO) { ZERO } else { sqd };' \\\n    'let clamped = f32::from_bits(sqd).max(0.0).to_bits();'\n\nmutate \"clamp comparison non-strict\" \\\n    'if flt(sqd, ZERO) { ZERO } else { sqd }' \\\n    'if !flt(ZERO, sqd) { ZERO } else { sqd }'\n\nmutate \"fresh NaN uses 0x7fc00000 instead of the x86 indefinite\" \\\n    'const INDEFINITE: u32 = 0xffc0_0000;' \\\n    'const INDEFINITE: u32 = 0x7fc0_0000;'\n\nmutate \"sqrt of a negative returns +qNaN\" \\\n    'return INDEFINITE;\n    }\n    v.sqrt().to_bits()' \\\n    'return 0x7fc0_0000;\n    }\n    v.sqrt().to_bits()'\n\nmutate \"NaN propagation prefers the source operand\" \\\n    'if is_nan_bits(a) {\n        Some(quiet(a))\n    } else if is_nan_bits(b) {\n        Some(quiet(b))' \\\n    'if is_nan_bits(b) {\n        Some(quiet(b))\n    } else if is_nan_bits(a) {\n        Some(quiet(a))'\n\nmutate \"NaN operands are not quieted\" \\\n    'fn quiet(x: u32) -> u32 {\n    x | QUIET_BIT' \\\n    'fn quiet(x: u32) -> u32 {\n    x'\n\nmutate \"branch guard is <= instead of <\" \\\n    'fn flt(a: u32, b: u32) -> bool {\n    !is_nan_bits(a) && !is_nan_bits(b) && f32::from_bits(a) < f32::from_bits(b)' \\\n    'fn flt(a: u32, b: u32) -> bool {\n    !is_nan_bits(a) && !is_nan_bits(b) && f32::from_bits(a) <= f32::from_bits(b)'\n\nmutate \"branch guard treats NaN as ordered\" \\\n    '!is_nan_bits(a) && !is_nan_bits(b) && f32::from_bits(a) < f32::from_bits(b)' \\\n    'f32::from_bits(a) < f32::from_bits(b)'\n\nmutate \"if/else arms swap their dest slots\" \\\n    '(fsub(dx2, l), dxy)' \\\n    '(dxy, fsub(dx2, l))'\n\nmutate \"else arm reuses the if arm's parameter binding\" \\\n    'let (dy2, dx2, dxy) = (s0, s1, s2);' \\\n    'let (dx2, dy2, dxy) = (s0, s1, s2);'\n\n