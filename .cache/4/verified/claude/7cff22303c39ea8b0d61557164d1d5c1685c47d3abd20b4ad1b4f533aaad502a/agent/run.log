     for (k, (_, p)) in conds.iter().enumerate() {","+            if p(&t) {","+                hits[k] += 1;","+                if first[k].is_none() {","+                    first[k] = Some((a, b, c));","+                }","             }","-        } else if bits == 0 {","-            poszero += 1;","-        } else if t.sqd < 0.0 {","-            neg += 1;","-            if neg <= 4 {","-                println!(\"  sqd<0 example: {a:#010x} {b:#010x} {c:#010x} -> {:e}\", t.sqd);","+        }","+    }","+    // Plus the exhaustive specials sweep.","+    for &a in SPECIALS {","+        for &b in SPECIALS {","+            for &c in SPECIALS {","+                let t = trace(a, b, c);","+                for (k, (_, p)) in conds.iter().enumerate() {","+                    if p(&t) {","+                        hits[k] += 1;","+                        if first[k].is_none() {","+                            first[k] = Some((a, b, c));","+                        }","+                    }","+                }","             }","         }","     }","-    println!(\"neg={neg} negzero={negzero} poszero={poszero} nan={nan} inf={inf}\");","-    println!(\"negzero examples: {examples:?}\");","+    for (k, (name, _)) in conds.iter().enumerate() {","+        println!(\"{:40} hits={:>9}  first={:?}\", name, hits[k], first[k]);","+    }"," }"]}],"originalFile":"//! Reachability probe (temporary/diagnostic): which `sqd` classes can actually\n//! be produced through the public API?\n\nmod common;\nuse common::*;\n\n#[test]\nfn probe_sqd_classes() {\n    // Constructed candidate for `sqd < 0` (underflow asymmetry):\n    // x = 0.75 * 2^-75  =>  x*x underflows to 0 but (x+x)*x rounds to 2^-149.\n    let x = (0.75f64 * 2f64.powi(-75)) as f32;\n    let t = trace(x.to_bits(), x.to_bits(), 0.0f32.to_bits());\n    println!(\n        \"constructed: x={:e} dy2_sq={:e} two={:e} dx2_sq={:e} term4={:e} sqd={:e} clamp={}\",\n        x, t.dy2_sq, t.two_dx2_dy2, t.dx2_sq, t.term4, t.sqd, t.sqd < 0.0\n    );\n\n    let mut rng = Rng::new(1);\n    let mut neg = 0usize;\n    let mut negzero = 0usize;\n    let mut poszero = 0usize;\n    let mut nan = 0usize;\n    let mut inf = 0usize;\n    let mut examples: Vec<(u32, u32, u32, f32)> = Vec::new();\n    for _ in 0..4_000_000 {\n        let (a, b, c) = match rng.below(4) {\n            0 => (rng.pool_f32(), rng.pool_f32(), rng.pool_f32()),\n            1 => (rng.next_u32(), rng.next_u32(), rng.next_u32()),\n            2 => {\n                // tiny magnitudes near the underflow boundary\n                let e = 30 + rng.below(50);\n                let s = |r: &mut Rng| {\n                    let v = (r.unit() * 2.0 - 1.0) * 2f64.powi(-(e as i32));\n                    (v as f32).to_bits()\n                };\n                (s(&mut rng), s(&mut rng), s(&mut rng))\n            }\n            _ => {\n                // nearly equal operands (catastrophic cancellation)\n                let base = rng.normal_f32();\n                let jitter = |r: &mut Rng, v: u32| {\n                    let d = r.below(9) as i64 - 4;\n                    ((v as i64 + d) as u32) & 0xffff_ffff\n                };\n                (base, jitter(&mut rng, base), rng.pool_f32())\n            }\n        };\n        let t = trace(a, b, c);\n        let bits = t.sqd.to_bits();\n        if t.sqd.is_nan() {\n            nan += 1;\n        } else if t.sqd.is_infinite() {\n            inf += 1;\n        } else if bits == 0x8000_0000 {\n            negzero += 1;\n            if examples.len() < 4 {\n                examples.push((a, b, c, t.sqd));\n            }\n        } else if bits == 0 {\n            poszero += 1;\n        } else if t.sqd < 0.0 {\n            neg += 1;\n            if neg <= 4 {\n                println!(\"  sqd<0 example: {a:#010x} {b:#010x} {c:#010x} -> {:e}\", t.sqd);\n            }\n        }\n    }\n    println!(\"neg={neg} negzero={negzero} poszero={poszero} nan={nan} inf={inf}\");\n    println!(\"negzero examples: {examples:?}\");\n}\n","userModified":false}}
