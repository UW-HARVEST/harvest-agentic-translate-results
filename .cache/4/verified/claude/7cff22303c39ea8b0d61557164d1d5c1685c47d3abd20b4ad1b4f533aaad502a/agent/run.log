{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_w24lds5d3poddnxth6dcgdqca4h5ysdh3z7kw3hltvagfwzaoovq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_0188mh9cKEfjKE8kBtNHTht8","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-tEkLcs/translated_rust/tests/probe.rs","content":"//! Reachability probe (temporary/diagnostic).\n\nmod common;\nuse common::*;\n\nfn gen(rng: &mut Rng) -> (u32, u32, u32) {\n    match rng.below(6) {\n        0 => (rng.pool_f32(), rng.pool_f32(), rng.pool_f32()),\n        1 => (rng.next_u32(), rng.next_u32(), rng.next_u32()),\n        2 => {\n            let e = 30 + rng.below(50);\n            let s = |r: &mut Rng| {\n                let v = (r.unit() * 2.0 - 1.0) * 2f64.powi(-(e as i32));\n                (v as f32).to_bits()\n            };\n            (s(rng), s(rng), s(rng))\n        }\n        3 => {\n            let base = rng.normal_f32();\n            let d = rng.below(9) as i64 - 4;\n            let j = ((base as i64 + d) as u32) & 0xffff_ffff;\n            (base, j, rng.pool_f32())\n        }\n        4 => {\n            let pick = |r: &mut Rng| {\n                let v = [\n                    0x7f80_0000u32,\n                    0xff80_0000,\n                    0x0000_0000,\n                    0x8000_0000,\n                    0x3f80_0000,\n                    0xbf80_0000,\n                    0x7f7f_ffff,\n                    0xff7f_ffff,\n                    0x5f00_0000,\n                    0xdf00_0000,\n                ];\n                v[r.below(v.len())]\n            };\n            (pick(rng), pick(rng), pick(rng))\n        }\n        _ => {\n            let e = 60 + rng.below(70);\n            let s = |r: &mut Rng| {\n                let v = (r.unit() * 2.0 - 1.0) * 2f64.powi(e as i32);\n                (v as f32).to_bits()\n            };\n            (s(rng), s(rng), s(rng))\n        }\n    }\n}\n\n#[test]\nfn probe_reachability() {\n    let conds: Vec<(&str, fn(&Trace) -> bool)> = vec![\n        (\"R19 dy2_sq overflow\", |t| {\n            t.dy2_sq.is_infinite() && t.dy2.is_finite()\n        }),\n        (\"R20 inf-inf in after_sub\", |t| {\n            t.dy2_sq.is_infinite()\n                && t.two_dx2_dy2.is_infinite()\n                && t.dy2_sq.is_sign_positive() == t.two_dx2_dy2.is_sign_positive()\n        }),\n        (\"R21a 0*inf in two_dx2_dy2\", |t| {\n            !t.dx2.is_nan()\n                && !t.dy2.is_nan()\n                && t.two_dx2_dy2.is_nan()\n        }),\n        (\"R21b 0*inf in term4\", |t| !t.dxy.is_nan() && t.term4.is_nan()),\n        (\"R22 inf+-inf in dy2+dx2\", |t| {\n            t.dy2.is_infinite() && t.dx2.is_infinite() && (t.dy2 + t.dx2).is_nan()\n        }),\n        (\"R26 dx2-lambda both inf same sign\", |t| {\n            t.dx2.is_infinite()\n                && t.lambda.is_infinite()\n                && t.dx2.is_sign_positive() == t.lambda.is_sign_positive()\n        }),\n        (\"R13 sqd<0 clamp\", |t| t.sqd < 0.0),\n        (\"R14 sqd NaN\", |t| t.sqd.is_nan()),\n        (\"R15 sqd == -0.0\", |t| t.sqd.to_bits() == 0x8000_0000),\n        (\"R16 sqd == +0.0\", |t| t.sqd.to_bits() == 0),\n        (\"R17 sqd == 0x80000001\", |t| t.sqd.to_bits() == 0x8000_0001),\n        (\"R18 sqd == 0x00000001\", |t| t.sqd.to_bits() == 0x0000_0001),\n        (\"sqd subnormal positive\", |t| {\n            t.sqd.to_bits() != 0 && t.sqd.to_bits() < 0x0080_0000\n        }),\n        (\"sqd subnormal negative\", |t| {\n            t.sqd.to_bits() > 0x8000_0000 && t.sqd.to_bits() < 0x8080_0000\n        }),\n        (\"root == inf\", |t| t.root.is_infinite()),\n        (\"lambda == +inf\", |t| t.lambda == f32::INFINITY),\n        (\"lambda == -inf\", |t| t.lambda == f32::NEG_INFINITY),\n        (\"sum NaN from non-NaN\", |t| {\n            !t.dy2.is_nan() && !t.dx2.is_nan() && !t.root.is_nan() && t.sum.is_nan()\n        }),\n        (\"if-arm taken\", |t| t.arm_if),\n        (\"else-arm taken\", |t| !t.arm_if),\n    ];\n    let mut hits = vec![0usize; conds.len()];\n    let mut first: Vec<Option<(u32, u32, u32)>> = vec![None; conds.len()];\n\n    let mut rng = Rng::new(7);\n    for _ in 0..3_000_000 {\n        let (a, b, c) = gen(&mut rng);\n        let t = trace(a, b, c);\n        for (k, (_, p)) in conds.iter().enumerate() {\n            if p(&t) {\n                hits[k] += 1;\n                if first[k].is_none() {\n                    first[k] = Some((a, b, c));\n                }\n            }\n        }\n    }\n    // Plus the exhaustive specials sweep.\n    for &a in SPECIALS {\n        for &b in SPECIALS {\n            for &c in SPECIALS {\n                let t = trace(a, b, c);\n                for (k, (_, p)) in conds.iter().enumerate() {\n                    if p(&t) {\n                        hits[k] += 1;\n                        if first[k].is_none() {\n                            first[k] = Some((a, b, c));\n                        }\n                    }\n                }\n            }\n        }\n    }\n    for (k, (name, _)) in conds.iter().enumerate() {\n        println!(\"{:40} hits={:>9}  first={:?}\", name, hits[k], first[k]);\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":612,"cache_read_input_tokens":68271,"cache_creation":{"ephemeral_5m_input_tokens":612,"ephemeral_1h_input_tokens":0},"output_tokens":10,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"188fe3ed-21de-4d11-9f80-120acb59131f","uuid":"86a1984a-ee5f-41cf-8650-73b1c60637e4","timestamp":"2026-08-19T14:54:18.499Z"}
