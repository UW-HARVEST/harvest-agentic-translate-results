m_utf8_lossy(&out2.bytes));","     }","-    // what does /proc/self/statm say vs. what the process really maps?","-    let maps = std::fs::read_to_string(\"/proc/self/maps\").unwrap();","-    let total: u64 = maps","-        .lines()","-        .filter_map(|l| {","-            let r = l.split_whitespace().next()?;","-            let (a, b) = r.split_once('-')?;","-            Some(u64::from_str_radix(b, 16).ok()? - u64::from_str_radix(a, 16).ok()?)","-        })","-        .sum();","-    println!(\"sum(/proc/self/maps) = {} MiB, statm = {} MiB\", total >> 20, vs >> 20);"," }"]}],"originalFile":"//! Temporary diagnostic: is RLIMIT_AS effective inside the test binary?\nmod harness;\n\nfn vm_size() -> u64 {\n    let s = std::fs::read_to_string(\"/proc/self/statm\").unwrap();\n    let pages: u64 = s.split_whitespace().next().unwrap().parse().unwrap();\n    pages * unsafe { libc::sysconf(libc::_SC_PAGESIZE) as u64 }\n}\n\nfn fork_run(child: impl FnOnce() -> i32) -> i32 {\n    unsafe {\n        let pid = libc::fork();\n        assert!(pid >= 0);\n        if pid == 0 {\n            let c = child();\n            libc::_exit(c);\n        }\n        let mut st = 0;\n        libc::waitpid(pid, &mut st, 0);\n        if libc::WIFEXITED(st) { libc::WEXITSTATUS(st) } else { -libc::WTERMSIG(st) }\n    }\n}\n\n#[test]\nfn probe() {\n    const BIG: usize = 24 * 1024 * 1024;\n    let keep = vec![b'N'; BIG + 1];\n    println!(\"keep ptr = {:p}\", keep.as_ptr());\n    let vs = vm_size();\n    println!(\"vsize = {} MiB\", vs >> 20);\n    for slack_mb in [1u64, 2, 4, 8] {\n        let limit = vs + (slack_mb << 20);\n        let code = fork_run(move || unsafe {\n            let rl = libc::rlimit { rlim_cur: limit, rlim_max: limit };\n            if libc::setrlimit(libc::RLIMIT_AS, &rl) != 0 {\n                return 90;\n            }\n            let mut back = libc::rlimit { rlim_cur: 0, rlim_max: 0 };\n            if libc::getrlimit(libc::RLIMIT_AS, &mut back) != 0 {\n                return 91;\n            }\n            if back.rlim_cur != limit {\n                return 92;\n            }\n            let p = libc::malloc(BIG + 1);\n            if p.is_null() { 0 } else { 1 }\n        });\n        println!(\"slack={slack_mb}MiB -> child code {code} (0=malloc NULL, 1=malloc ok, 9x=setup)\");\n    }\n    // what does /proc/self/statm say vs. what the process really maps?\n    let maps = std::fs::read_to_string(\"/proc/self/maps\").unwrap();\n    let total: u64 = maps\n        .lines()\n        .filter_map(|l| {\n            let r = l.split_whitespace().next()?;\n            let (a, b) = r.split_once('-')?;\n            Some(u64::from_str_radix(b, 16).ok()? - u64::from_str_radix(a, 16).ok()?)\n        })\n        .sum();\n    println!(\"sum(/proc/self/maps) = {} MiB, statm = {} MiB\", total >> 20, vs >> 20);\n}\n","userModified":false}}
