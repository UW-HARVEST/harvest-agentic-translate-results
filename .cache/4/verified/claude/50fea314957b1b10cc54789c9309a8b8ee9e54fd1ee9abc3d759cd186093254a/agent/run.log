{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_44ogpdwevspnb6rjkkssu4k73neg6etczql4t4jn4pmxr5kzrnsq","type":"message","role":"assistant","content":[{"type":"text","text":"The harness works. Now Phase B — differential tests for the low-level vector helpers (CONFIGS rows 1–19):"}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":353,"cache_read_input_tokens":89763,"cache_creation":{"ephemeral_5m_input_tokens":353,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"f8eef8cc-b596-45c4-9391-2a80d287efb6","uuid":"dcaa9fde-416c-475e-9f4f-773b17ac6a06","timestamp":"2026-08-20T09:23:00.307Z"}
{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_44ogpdwevspnb6rjkkssu4k73neg6etczql4t4jn4pmxr5kzrnsq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01BDjo4VGyUnrs54FBYDj65a","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-0NMgaL/translated_rust/tests/vectors.rs","content":"//! Phase B — CONFIGS.md rows 1..19: the lowest-level entry points\n//! (vector helpers and proxy construction), driven through both `.so`s.\n\nmod common;\nuse common::*;\n\nconst N: usize = 4096;\n\n// ---------------------------------------------------------------------------\n// Row 1: c2V\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row01_c2v() {\n    let p = pair();\n    let mut rng = Rng::new(0x0101);\n    unsafe {\n        for i in 0..N {\n            let (x, y) = (rng.nasty(), rng.nasty());\n            eq_v(&format!(\"row01[{i}] c2V({x:?},{y:?})\"), (p.c.c2V)(x, y), (p.r.c2V)(x, y));\n        }\n        // Raw bit patterns, incl. signalling NaNs.\n        for i in 0..N {\n            let (x, y) = (rng.bits_f32(), rng.bits_f32());\n            eq_v(&format!(\"row01-bits[{i}]\"), (p.c.c2V)(x, y), (p.r.c2V)(x, y));\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 2: c2Mulvs\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row02_c2mulvs() {\n    let p = pair();\n    let mut rng = Rng::new(0x0202);\n    let scalars = [0.0f32, -0.0, 1.0, -1.0, 0.5, f32::INFINITY, f32::NEG_INFINITY, f32::NAN,\n                   f32::MAX, f32::MIN_POSITIVE];\n    unsafe {\n        for (j, &s) in scalars.iter().enumerate() {\n            for i in 0..256 {\n                let v = rng.vec_nasty();\n                eq_v(\n                    &format!(\"row02 fixed[{j}][{i}] v={v:?} s={s:?}\"),\n                    (p.c.c2Mulvs)(v, s),\n                    (p.r.c2Mulvs)(v, s),\n                );\n            }\n        }\n        for i in 0..N {\n            let v = rng.vec_nasty();\n            let s = rng.nasty();\n            eq_v(&format!(\"row02 rand[{i}] v={v:?} s={s:?}\"), (p.c.c2Mulvs)(v, s), (p.r.c2Mulvs)(v, s));\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 3: c2Add / c2Sub\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row03_c2add_c2sub() {\n    let p = pair();\n    let mut rng = Rng::new(0x0303);\n    unsafe {\n        for i in 0..N {\n            let a = rng.vec_nasty();\n            let b = rng.vec_nasty();\n            eq_v(&format!(\"row03 add[{i}] {a:?} {b:?}\"), (p.c.c2Add)(a, b), (p.r.c2Add)(a, b));\n            eq_v(&format!(\"row03 sub[{i}] {a:?} {b:?}\"), (p.c.c2Sub)(a, b), (p.r.c2Sub)(a, b));\n            // exact cancellation\n            eq_v(&format!(\"row03 sub-self[{i}]\"), (p.c.c2Sub)(a, a), (p.r.c2Sub)(a, a));\n            eq_v(&format!(\"row03 add-self[{i}]\"), (p.c.c2Add)(a, a), (p.r.c2Add)(a, a));\n        }\n        // inf - inf and inf + -inf\n        let inf = c2v { x: f32::INFINITY, y: f32::NEG_INFINITY };\n        eq_v(\"row03 inf-inf\", (p.c.c2Sub)(inf, inf), (p.r.c2Sub)(inf, inf));\n        eq_v(\"row03 inf+inf\", (p.c.c2Add)(inf, inf), (p.r.c2Add)(inf, inf));\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 4: c2Dot\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row04_c2dot() {\n    let p = pair();\n    let mut rng = Rng::new(0x0404);\n    unsafe {\n        for i in 0..N {\n            let a = rng.vec_nasty();\n            let b = rng.vec_nasty();\n            eq_f32(&format!(\"row04[{i}] {a:?}.{b:?}\"), (p.c.c2Dot)(a, b), (p.r.c2Dot)(a, b));\n        }\n        // orthogonal / antiparallel / overflow\n        for i in 0..N {\n            let a = rng.vec_scaled(1e30);\n            let orth = c2v { x: -a.y, y: a.x };\n            eq_f32(&format!(\"row04 orth[{i}]\"), (p.c.c2Dot)(a, orth), (p.r.c2Dot)(a, orth));\n            let anti = c2v { x: -a.x, y: -a.y };\n            eq_f32(&format!(\"row04 anti[{i}]\"), (p.c.c2Dot)(a, anti), (p.r.c2Dot)(a, anti));\n            eq_f32(&format!(\"row04 self[{i}]\"), (p.c.c2Dot)(a, a), (p.r.c2Dot)(a, a));\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 5: c2Det2\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row05_c2det2() {\n    let p = pair();\n    let mut rng = Rng::new(0x0505);\n    unsafe {\n        for i in 0..N {\n            let a = rng.vec_nasty();\n            let b = rng.vec_nasty();\n            eq_f32(&format!(\"row05[{i}]\"), (p.c.c2Det2)(a, b), (p.r.c2Det2)(a, b));\n        }\n        for i in 0..N {\n            // collinear -> det == 0 (and the sign of that zero matters)\n            let a = rng.vec_scaled(rng.scale_choice());\n            let k = rng.scaled(4.0);\n            let b = c2v { x: a.x * k, y: a.y * k };\n            eq_f32(&format!(\"row05 collinear[{i}]\"), (p.c.c2Det2)(a, b), (p.r.c2Det2)(a, b));\n            eq_f32(&format!(\"row05 self[{i}]\"), (p.c.c2Det2)(a, a), (p.r.c2Det2)(a, a));\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 6: c2Len\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row06_c2len() {\n    let p = pair();\n    let mut rng = Rng::new(0x0606);\n    unsafe {\n        for i in 0..N {\n            let a = rng.vec_nasty();\n            eq_f32(&format!(\"row06[{i}] {a:?}\"), (p.c.c2Len)(a), (p.r.c2Len)(a));\n        }\n        for v in [\n            c2v { x: 0.0, y: 0.0 },\n            c2v { x: -0.0, y: -0.0 },\n            c2v { x: 1e30, y: 1e30 },        // c2Dot overflows to +inf\n            c2v { x: f32::MAX, y: f32::MAX },\n            c2v { x: f32::from_bits(1), y: 0.0 },\n            c2v { x: f32::NAN, y: 0.0 },\n            c2v { x: f32::INFINITY, y: f32::NEG_INFINITY },\n            c2v { x: 3.0, y: 4.0 },\n        ] {\n            eq_f32(&format!(\"row06 fixed {v:?}\"), (p.c.c2Len)(v), (p.r.c2Len)(v));\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 7: c2Maxv / c2Minv (NaN asymmetry)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row07_c2maxv_c2minv() {\n    let p = pair();\n    let mut rng = Rng::new(0x0707);\n    unsafe {\n        for i in 0..N {\n            let a = rng.vec_nasty();\n            let b = rng.vec_nasty();\n            eq_v(&format!(\"row07 max[{i}] {a:?} {b:?}\"), (p.c.c2Maxv)(a, b), (p.r.c2Maxv)(a, b));\n            eq_v(&format!(\"row07 min[{i}] {a:?} {b:?}\"), (p.c.c2Minv)(a, b), (p.r.c2Minv)(a, b));\n            // equal components (tie -> takes b in both)\n            eq_v(&format!(\"row07 max-eq[{i}]\"), (p.c.c2Maxv)(a, a), (p.r.c2Maxv)(a, a));\n            eq_v(&format!(\"row07 min-eq[{i}]\"), (p.c.c2Minv)(a, a), (p.r.c2Minv)(a, a));\n        }\n        // Explicit NaN-position matrix: NaN in a only, b only, both.\n        let nan = c2v { x: f32::NAN, y: f32::NAN };\n        let ord = c2v { x: 1.0, y: -1.0 };\n        let zpos = c2v { x: 0.0, y: 0.0 };\n        let zneg = c2v { x: -0.0, y: -0.0 };\n        for (n, (a, b)) in [(nan, ord), (ord, nan), (nan, nan), (zpos, zneg), (zneg, zpos)]\n            .iter()\n            .enumerate()\n        {\n            eq_v(&format!(\"row07 special-max[{n}]\"), (p.c.c2Maxv)(*a, *b), (p.r.c2Maxv)(*a, *b));\n            eq_v(&format!(\"row07 special-min[{n}]\"), (p.c.c2Minv)(*a, *b), (p.r.c2Minv)(*a, *b));\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 8: c2Clampv, incl. the inverted lo>hi range\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row08_c2clampv() {\n    let p = pair();\n    let mut rng = Rng::new(0x0808);\n    unsafe {\n        for i in 0..N {\n            let a = rng.vec_nasty();\n            // lo < hi\n            let (l, h) = (rng.vec_scaled(10.0), rng.vec_scaled(10.0));\n            let lo = c2v { x: l.x.min(h.x), y: l.y.min(h.y) };\n            let hi = c2v { x: l.x.max(h.x), y: l.y.max(h.y) };\n            eq_v(\n                &format!(\"row08 ordered[{i}]\"),\n                (p.c.c2Clampv)(a, lo, hi),\n                (p.r.c2Clampv)(a, lo, hi),\n            );\n            // lo == hi\n            eq_v(&format!(\"row08 equal[{i}]\"), (p.c.c2Clampv)(a, lo, lo), (p.r.c2Clampv)(a, lo, lo));\n            // inverted: lo > hi\n            eq_v(\n                &format!(\"row08 inverted[{i}]\"),\n                (p.c.c2Clampv)(a, hi, lo),\n                (p.r.c2Clampv)(a, hi, lo),\n            );\n            // fully nasty\n            let (nl, nh) = (rng.vec_nasty(), rng.vec_nasty());\n            eq_v(&format!(\"row08 nasty[{i}]\"), (p.c.c2Clampv)(a, nl, nh), (p.r.c2Clampv)(a, nl, nh));\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 9: c2Neg / c2Skew / c2CCW90\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row09_c2neg_skew_ccw90() {\n    let p = pair();\n    let mut rng = Rng::new(0x0909);\n    unsafe {\n        for i in 0..N {\n            let a = rng.vec_nasty();\n            eq_v(&format!(\"row09 neg[{i}] {a:?}\"), (p.c.c2Neg)(a), (p.r.c2Neg)(a));\n            eq_v(&format!(\"row09 skew[{i}] {a:?}\"), (p.c.c2Skew)(a), (p.r.c2Skew)(a));\n            eq_v(&format!(\"row09 ccw90[{i}] {a:?}\"), (p.c.c2CCW90)(a), (p.r.c2CCW90)(a));\n        }\n        // signed zero: -0.0 vs +0.0 must round-trip identically\n        for v in [\n            c2v { x: 0.0, y: 0.0 },\n            c2v { x: -0.0, y: 0.0 },\n            c2v { x: 0.0, y: -0.0 },\n            c2v { x: -0.0, y: -0.0 },\n        ] {\n            eq_v(&format!(\"row09 zero-neg {v:?}\"), (p.c.c2Neg)(v), (p.r.c2Neg)(v));\n            eq_v(&format!(\"row09 zero-skew {v:?}\"), (p.c.c2Skew)(v), (p.r.c2Skew)(v));\n            eq_v(&format!(\"row09 zero-ccw {v:?}\"), (p.c.c2CCW90)(v), (p.r.c2CCW90)(v));\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 10: c2Div (incl. divide-by-zero -> inf/NaN)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row10_c2div() {\n    let p = pair();\n    let mut rng = Rng::new(0x0a0a);\n    let divisors = [1.0f32, -1.0, 0.0, -0.0, f32::INFINITY, f32::NEG_INFINITY, f32::NAN,\n                    f32::MIN_POSITIVE, f32::MAX, 2.0, 1e-30, 1e30];\n    unsafe {\n        for (j, &d) in divisors.iter().enumerate() {\n            for i in 0..256 {\n                let a = rng.vec_nasty();\n                eq_v(\n                    &format!(\"row10 fixed[{j}][{i}] a={a:?} d={d:?}\"),\n                    (p.c.c2Div)(a, d),\n                    (p.r.c2Div)(a, d),\n                );\n            }\n        }\n        for i in 0..N {\n            let a = rng.vec_nasty();\n            let d = rng.nasty();\n            eq_v(&format!(\"row10 rand[{i}] a={a:?} d={d:?}\"), (p.c.c2Div)(a, d), (p.r.c2Div)(a, d));\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 11: c2Norm (incl. the zero vector -> NaN)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row11_c2norm() {\n    let p = pair();\n    let mut rng = Rng::new(0x0b0b);\n    unsafe {\n        for i in 0..N {\n            let a = rng.vec_nasty();\n            eq_v(&format!(\"row11 nasty[{i}] {a:?}\"), (p.c.c2Norm)(a), (p.r.c2Norm)(a));\n            let b = rng.vec_scaled(rng.scale_choice());\n            eq_v(&format!(\"row11 scaled[{i}] {b:?}\"), (p.c.c2Norm)(b), (p.r.c2Norm)(b));\n        }\n        for v in [\n            c2v { x: 0.0, y: 0.0 },\n            c2v { x: -0.0, y: 0.0 },\n            c2v { x: 3.0, y: 4.0 },\n            c2v { x: 1e30, y: 1e30 },\n            c2v { x: f32::from_bits(1), y: 0.0 },\n            c2v { x: f32::INFINITY, y: 1.0 },\n            c2v { x: f32::NAN, y: 1.0 },\n        ] {\n            eq_v(&format!(\"row11 fixed {v:?}\"), (p.c.c2Norm)(v), (p.r.c2Norm)(v));\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 12: c2RotIdentity / c2xIdentity\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row12_identities() {\n    let p = pair();\n    unsafe {\n        for _ in 0..64 {\n            eq_r(\"row12 rot\", (p.c.c2RotIdentity)(), (p.r.c2RotIdentity)());\n            eq_x(\"row12 x\", (p.c.c2xIdentity)(), (p.r.c2xIdentity)());\n        }\n        // Exact expected constants from the C source.\n        let r = (p.r.c2RotIdentity)();\n        assert_eq!((r.c.to_bits(), r.s.to_bits()), (1.0f32.to_bits(), 0.0f32.to_bits()));\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 13: c2Mulrv / c2MulrvT\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row13_c2mulrv_transpose() {\n    let p = pair();\n    let mut rng = Rng::new(0x0d0d);\n    unsafe {\n        for i in 0..N {\n            let v = rng.vec_scaled(rng.scale_choice());\n            // normalised rotation\n            let ang = rng.unit() * std::f32::consts::PI;\n            let rn = c2r { c: ang.cos(), s: ang.sin() };\n            eq_v(&format!(\"row13 norm-fwd[{i}]\"), (p.c.c2Mulrv)(rn, v), (p.r.c2Mulrv)(rn, v));\n            eq_v(&format!(\"row13 norm-tr[{i}]\"), (p.c.c2MulrvT)(rn, v), (p.r.c2MulrvT)(rn, v));\n            // un-normalised\n            let ru = c2r { c: rng.scaled(3.0), s: rng.scaled(3.0) };\n            eq_v(&format!(\"row13 unnorm-fwd[{i}]\"), (p.c.c2Mulrv)(ru, v), (p.r.c2Mulrv)(ru, v));\n            eq_v(&format!(\"row13 unnorm-tr[{i}]\"), (p.c.c2MulrvT)(ru, v), (p.r.c2MulrvT)(ru, v));\n            // nasty\n            let rx = c2r { c: rng.nasty(), s: rng.nasty() };\n            let vx = rng.vec_nasty();\n            eq_v(&format!(\"row13 nasty-fwd[{i}]\"), (p.c.c2Mulrv)(rx, vx), (p.r.c2Mulrv)(rx, vx));\n            eq_v(&format!(\"row13 nasty-tr[{i}]\"), (p.c.c2MulrvT)(rx, vx), (p.r.c2MulrvT)(rx, vx));\n        }\n        // identity and all-zero rotation\n        let id = c2r { c: 1.0, s: 0.0 };\n        let zero = c2r { c: 0.0, s: 0.0 };\n        for i in 0..64 {\n            let v = rng.vec_scaled(100.0);\n            eq_v(&format!(\"row13 id[{i}]\"), (p.c.c2Mulrv)(id, v), (p.r.c2Mulrv)(id, v));\n            eq_v(&format!(\"row13 zero[{i}]\"), (p.c.c2Mulrv)(zero, v), (p.r.c2Mulrv)(zero, v));\n            eq_v(&format!(\"row13 id-t[{i}]\"), (p.c.c2MulrvT)(id, v), (p.r.c2MulrvT)(id, v));\n            eq_v(&format!(\"row13 zero-t[{i}]\"), (p.c.c2MulrvT)(zero, v), (p.r.c2MulrvT)(zero, v));\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 14: c2Mulxv\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row14_c2mulxv() {\n    let p = pair();\n    let mut rng = Rng::new(0x0e0e);\n    unsafe {\n        for i in 0..N {\n            let v = rng.vec_scaled(rng.scale_choice());\n            let x1 = rand_transform(&mut rng, 100.0);\n            eq_v(&format!(\"row14 norm[{i}]\"), (p.c.c2Mulxv)(x1, v), (p.r.c2Mulxv)(x1, v));\n            let x2 = rand_transform_unnorm(&mut rng, 100.0);\n            eq_v(&format!(\"row14 unnorm[{i}]\"), (p.c.c2Mulxv)(x2, v), (p.r.c2Mulxv)(x2, v));\n            let x3 = c2x { p: rng.vec_nasty(), r: c2r { c: rng.nasty(), s: rng.nasty() } };\n            let vn = rng.vec_nasty();\n            eq_v(&format!(\"row14 nasty[{i}]\"), (p.c.c2Mulxv)(x3, vn), (p.r.c2Mulxv)(x3, vn));\n        }\n        // identity transform must be a no-op in both\n        let id = unsafe { (p.c.c2xIdentity)() };\n        for i in 0..256 {\n            let v = rng.vec_nasty();\n            eq_v(&format!(\"row14 identity[{i}]\"), (p.c.c2Mulxv)(id, v), (p.r.c2Mulxv)(id, v));\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 15: c2BBVerts\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row15_c2bbverts() {\n    let p = pair();\n    let mut rng = Rng::new(0x0f0f);\n    unsafe {\n        // The out buffer is 8 wide (as inside c2Proxy) and poisoned, so that\n        // \"wrote exactly 4 verts\" is verified too.\n        let poison = c2v { x: f32::from_bits(0xAAAA_AAAA), y: f32::from_bits(0x5555_5555) };\n        let mut cases: Vec<c2AABB> = Vec::new();\n        for _ in 0..N {\n            cases.push(rand_aabb(&mut rng, rng.scale_choice()));\n        }\n        // degenerate / inverted / extreme\n        cases.push(c2AABB { min: c2v { x: 0.0, y: 0.0 }, max: c2v { x: 0.0, y: 0.0 } });\n        cases.push(c2AABB { min: c2v { x: 5.0, y: 5.0 }, max: c2v { x: -5.0, y: -5.0 } });\n        cases.push(c2AABB { min: c2v { x: -0.0, y: 0.0 }, max: c2v { x: 0.0, y: -0.0 } });\n        cases.push(c2AABB {\n            min: c2v { x: f32::NEG_INFINITY, y: f32::NAN },\n            max: c2v { x: f32::INFINITY, y: 1.0 },\n        });\n        cases.push(c2AABB {\n            min: c2v { x: -f32::MAX, y: -f32::MAX },\n            max: c2v { x: f32::MAX, y: f32::MAX },\n        });\n        for _ in 0..256 {\n            cases.push(c2AABB { min: rng.vec_nasty(), max: rng.vec_nasty() });\n        }\n\n        for (i, bb) in cases.iter().enumerate() {\n            let mut oc = [poison; 8];\n            let mut or = [poison; 8];\n            let mut bc = *bb;\n            let mut br = *bb;\n            (p.c.c2BBVerts)(oc.as_mut_ptr(), &mut bc);\n            (p.r.c2BBVerts)(or.as_mut_ptr(), &mut br);\n            eq_bytes(&format!(\"row15[{i}] out {bb:?}\"), &oc, &or);\n            // the input AABB must not be modified by either\n            eq_bytes(&format!(\"row15[{i}] in\"), &bc, &br);\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Rows 16..19: c2MakeProxy for each type, into a poisoned proxy\n// ---------------------------------------------------------------------------\n\nfn poisoned_proxy(byte: u8) -> c2Proxy {\n    let mut pr = c2Proxy::default();\n    unsafe {\n        std::ptr::write_bytes(&mut pr as *mut c2Proxy as *mut u8, byte, std::mem::size_of::<c2Proxy>());\n    }\n    pr\n}\n\n#[test]\nfn row16_makeproxy_circle() {\n    let p = pair();\n    let mut rng = Rng::new(0x1010);\n    unsafe {\n        for i in 0..N {\n            let c = match rng.below(5) {\n                0 => c2Circle { p: c2v { x: 0.0, y: 0.0 }, r: 0.0 },\n                1 => c2Circle { p: rng.vec_scaled(100.0), r: -rng.scaled(10.0).abs() },\n                2 => c2Circle { p: rng.vec_nasty(), r: rng.nasty() },\n                _ => rand_circle(&mut rng, rng.scale_choice()),\n            };\n            let mut pc = poisoned_proxy(0xAA);\n            let mut pr2 = poisoned_proxy(0xAA);\n            (p.c.c2MakeProxy)(&c as *const c2Circle as *const _, C2_TYPE_CIRCLE, &mut pc);\n            (p.r.c2MakeProxy)(&c as *const c2Circle as *const _, C2_TYPE_CIRCLE, &mut pr2);\n            eq_proxy(&format!(\"row16[{i}] {c:?}\"), &pc, &pr2);\n            // structural expectations from the C source\n            eq_i(\"row16 count\", pc.count, 1);\n            // verts[1..8] must still be poison in BOTH\n            for k in 1..8 {\n                assert_eq!(pc.verts[k].x.to_bits(), 0xAAAA_AAAA, \"C clobbered verts[{k}]\");\n                assert_eq!(pr2.verts[k].x.to_bits(), 0xAAAA_AAAA, \"Rust clobbered verts[{k}]\");\n            }\n        }\n    }\n}\n\n#[test]\nfn row17_makeproxy_aabb() {\n    let p = pair();\n    let mut rng = Rng::new(0x1111);\n    unsafe {\n        for i in 0..N {\n            let bb = match rng.below(5) {\n                0 => c2AABB { min: c2v { x: 0.0, y: 0.0 }, max: c2v { x: 0.0, y: 0.0 } },\n                1 => c2AABB { min: c2v { x: 9.0, y: 9.0 }, max: c2v { x: -9.0, y: -9.0 } },\n                2 => c2AABB { min: rng.vec_nasty(), max: rng.vec_nasty() },\n                _ => rand_aabb(&mut rng, rng.scale_choice()),\n            };\n            let mut pc = poisoned_proxy(0xAA);\n            let mut pr2 = poisoned_proxy(0xAA);\n            (p.c.c2MakeProxy)(&bb as *const c2AABB as *const _, C2_TYPE_AABB, &mut pc);\n            (p.r.c2MakeProxy)(&bb as *const c2AABB as *const _, C2_TYPE_AABB, &mut pr2);\n            eq_proxy(&format!(\"row17[{i}] {bb:?}\"), &pc, &pr2);\n            eq_i(\"row17 count\", pc.count, 4);\n            eq_f32(\"row17 radius\", pc.radius, 0.0);\n            for k in 4..8 {\n                assert_eq!(pc.verts[k].x.to_bits(), 0xAAAA_AAAA, \"C clobbered verts[{k}]\");\n                assert_eq!(pr2.verts[k].x.to_bits(), 0xAAAA_AAAA, \"Rust clobbered verts[{k}]\");\n            }\n        }\n    }\n}\n\n#[test]\nfn row18_makeproxy_capsule() {\n    let p = pair();\n    let mut rng = Rng::new(0x1212);\n    unsafe {\n        for i in 0..N {\n            let cap = match rng.below(5) {\n                0 => {\n                    let a = rng.vec_scaled(100.0);\n                    c2Capsule { a, b: a, r: 0.0 } // zero-length, zero radius\n                }\n                1 => c2Capsule {\n                    a: rng.vec_scaled(100.0),\n                    b: rng.vec_scaled(100.0),\n                    r: -rng.scaled(10.0).abs(),\n                },\n                2 => c2Capsule { a: rng.vec_nasty(), b: rng.vec_nasty(), r: rng.nasty() },\n                _ => rand_capsule(&mut rng, rng.scale_choice()),\n            };\n            let mut pc = poisoned_proxy(0xAA);\n            let mut pr2 = poisoned_proxy(0xAA);\n            (p.c.c2MakeProxy)(&cap as *const c2Capsule as *const _, C2_TYPE_CAPSULE, &mut pc);\n            (p.r.c2MakeProxy)(&cap as *const c2Capsule as *const _, C2_TYPE_CAPSULE, &mut pr2);\n            eq_proxy(&format!(\"row18[{i}] {cap:?}\"), &pc, &pr2);\n            eq_i(\"row18 count\", pc.count, 2);\n            for k in 2..8 {\n                assert_eq!(pc.verts[k].x.to_bits(), 0xAAAA_AAAA, \"C clobbered verts[{k}]\");\n                assert_eq!(pr2.verts[k].x.to_bits(), 0xAAAA_AAAA, \"Rust clobbered verts[{k}]\");\n            }\n        }\n    }\n}\n\n#[test]\nfn row19_makeproxy_poison_patterns() {\n    // Same shapes written into proxies pre-filled with several different byte\n    // patterns: verifies exactly which bytes each switch arm writes.\n    let p = pair();\n    let mut rng = Rng::new(0x1313);\n    unsafe {\n        for pat in [0x00u8, 0xFF, 0xAA, 0x55, 0x7F, 0x80] {\n            for i in 0..256 {\n                let shape = rand_shape_of(&mut rng, rng.below(3) as i32, rng.scale_choice());\n                let mut pc = poisoned_proxy(pat);\n                let mut pr2 = poisoned_proxy(pat);\n                (p.c.c2MakeProxy)(shape.as_ptr(), shape.ty(), &mut pc);\n                (p.r.c2MakeProxy)(shape.as_ptr(), shape.ty(), &mut pr2);\n                eq_proxy(&format!(\"row19 pat={pat:#02x}[{i}] {shape:?}\"), &pc, &pr2);\n            }\n        }\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":353,"cache_read_input_tokens":89763,"cache_creation":{"ephemeral_5m_input_tokens":353,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"f8eef8cc-b596-45c4-9391-2a80d287efb6","uuid":"bb5dcb5b-1f75-4a7d-b0df-80738a704073","timestamp":"2026-08-20T09:24:30.177Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01BDjo4VGyUnrs54FBYDj65a","type":"tool_result","content":"File created successfully at: /local/home/scheschb/.harvest/work/harvest-work-0NMgaL/translated_rust/tests/vectors.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"f8eef8cc-b596-45c4-9391-2a80d287efb6","uuid":"a0603f78-42d4-43a4-95a4-2a023b29bbb5","timestamp":"2026-08-20T09:24:30.187Z","tool_use_result":{"type":"create","filePath":"/local/home/scheschb/.harvest/work/harvest-work-0NMgaL/translated_rust/tests/vectors.rs","content":"//! Phase B — CONFIGS.md rows 1..19: the lowest-level entry points\n//! (vector helpers and proxy construction), driven through both `.so`s.\n\nmod common;\nuse common::*;\n\nconst N: usize = 4096;\n\n// ---------------------------------------------------------------------------\n// Row 1: c2V\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row01_c2v() {\n    let p = pair();\n    let mut rng = Rng::new(0x0101);\n    unsafe {\n        for i in 0..N {\n            let (x, y) = (rng.nasty(), rng.nasty());\n            eq_v(&format!(\"row01[{i}] c2V({x:?},{y:?})\"), (p.c.c2V)(x, y), (p.r.c2V)(x, y));\n        }\n        // Raw bit patterns, incl. signalling NaNs.\n        for i in 0..N {\n            let (x, y) = (rng.bits_f32(), rng.bits_f32());\n            eq_v(&format!(\"row01-bits[{i}]\"), (p.c.c2V)(x, y), (p.r.c2V)(x, y));\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 2: c2Mulvs\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row02_c2mulvs() {\n    let p = pair();\n    let mut rng = Rng::new(0x0202);\n    let scalars = [0.0f32, -0.0, 1.0, -1.0, 0.5, f32::INFINITY, f32::NEG_INFINITY, f32::NAN,\n                   f32::MAX, f32::MIN_POSITIVE];\n    unsafe {\n        for (j, &s) in scalars.iter().enumerate() {\n            for i in 0..256 {\n                let v = rng.vec_nasty();\n                eq_v(\n                    &format!(\"row02 fixed[{j}][{i}] v={v:?} s={s:?}\"),\n                    (p.c.c2Mulvs)(v, s),\n                    (p.r.c2Mulvs)(v, s),\n                );\n            }\n        }\n        for i in 0..N {\n            let v = rng.vec_nasty();\n            let s = rng.nasty();\n            eq_v(&format!(\"row02 rand[{i}] v={v:?} s={s:?}\"), (p.c.c2Mulvs)(v, s), (p.r.c2Mulvs)(v, s));\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 3: c2Add / c2Sub\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row03_c2add_c2sub() {\n    let p = pair();\n    let mut rng = Rng::new(0x0303);\n    unsafe {\n        for i in 0..N {\n            let a = rng.vec_nasty();\n            let b = rng.vec_nasty();\n            eq_v(&format!(\"row03 add[{i}] {a:?} {b:?}\"), (p.c.c2Add)(a, b), (p.r.c2Add)(a, b));\n            eq_v(&format!(\"row03 sub[{i}] {a:?} {b:?}\"), (p.c.c2Sub)(a, b), (p.r.c2Sub)(a, b));\n            // exact cancellation\n            eq_v(&format!(\"row03 sub-self[{i}]\"), (p.c.c2Sub)(a, a), (p.r.c2Sub)(a, a));\n            eq_v(&format!(\"row03 add-self[{i}]\"), (p.c.c2Add)(a, a), (p.r.c2Add)(a, a));\n        }\n        // inf - inf and inf + -inf\n        let inf = c2v { x: f32::INFINITY, y: f32::NEG_INFINITY };\n        eq_v(\"row03 inf-inf\", (p.c.c2Sub)(inf, inf), (p.r.c2Sub)(inf, inf));\n        eq_v(\"row03 inf+inf\", (p.c.c2Add)(inf, inf), (p.r.c2Add)(inf, inf));\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 4: c2Dot\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row04_c2dot() {\n    let p = pair();\n    let mut rng = Rng::new(0x0404);\n    unsafe {\n        for i in 0..N {\n            let a = rng.vec_nasty();\n            let b = rng.vec_nasty();\n            eq_f32(&format!(\"row04[{i}] {a:?}.{b:?}\"), (p.c.c2Dot)(a, b), (p.r.c2Dot)(a, b));\n        }\n        // orthogonal / antiparallel / overflow\n        for i in 0..N {\n            let a = rng.vec_scaled(1e30);\n            let orth = c2v { x: -a.y, y: a.x };\n            eq_f32(&format!(\"row04 orth[{i}]\"), (p.c.c2Dot)(a, orth), (p.r.c2Dot)(a, orth));\n            let anti = c2v { x: -a.x, y: -a.y };\n            eq_f32(&format!(\"row04 anti[{i}]\"), (p.c.c2Dot)(a, anti), (p.r.c2Dot)(a, anti));\n            eq_f32(&format!(\"row04 self[{i}]\"), (p.c.c2Dot)(a, a), (p.r.c2Dot)(a, a));\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 5: c2Det2\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row05_c2det2() {\n    let p = pair();\n    let mut rng = Rng::new(0x0505);\n    unsafe {\n        for i in 0..N {\n            let a = rng.vec_nasty();\n            let b = rng.vec_nasty();\n            eq_f32(&format!(\"row05[{i}]\"), (p.c.c2Det2)(a, b), (p.r.c2Det2)(a, b));\n        }\n        for i in 0..N {\n            // collinear -> det == 0 (and the sign of that zero matters)\n            let a = rng.vec_scaled(rng.scale_choice());\n            let k = rng.scaled(4.0);\n            let b = c2v { x: a.x * k, y: a.y * k };\n            eq_f32(&format!(\"row05 collinear[{i}]\"), (p.c.c2Det2)(a, b), (p.r.c2Det2)(a, b));\n            eq_f32(&format!(\"row05 self[{i}]\"), (p.c.c2Det2)(a, a), (p.r.c2Det2)(a, a));\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 6: c2Len\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row06_c2len() {\n    let p = pair();\n    let mut rng = Rng::new(0x0606);\n    unsafe {\n        for i in 0..N {\n            let a = rng.vec_nasty();\n            eq_f32(&format!(\"row06[{i}] {a:?}\"), (p.c.c2Len)(a), (p.r.c2Len)(a));\n        }\n        for v in [\n            c2v { x: 0.0, y: 0.0 },\n            c2v { x: -0.0, y: -0.0 },\n            c2v { x: 1e30, y: 1e30 },        // c2Dot overflows to +inf\n            c2v { x: f32::MAX, y: f32::MAX },\n            c2v { x: f32::from_bits(1), y: 0.0 },\n            c2v { x: f32::NAN, y: 0.0 },\n            c2v { x: f32::INFINITY, y: f32::NEG_INFINITY },\n            c2v { x: 3.0, y: 4.0 },\n        ] {\n            eq_f32(&format!(\"row06 fixed {v:?}\"), (p.c.c2Len)(v), (p.r.c2Len)(v));\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 7: c2Maxv / c2Minv (NaN asymmetry)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row07_c2maxv_c2minv() {\n    let p = pair();\n    let mut rng = Rng::new(0x0707);\n    unsafe {\n        for i in 0..N {\n            let a = rng.vec_nasty();\n            let b = rng.vec_nasty();\n            eq_v(&format!(\"row07 max[{i}] {a:?} {b:?}\"), (p.c.c2Maxv)(a, b), (p.r.c2Maxv)(a, b));\n            eq_v(&format!(\"row07 min[{i}] {a:?} {b:?}\"), (p.c.c2Minv)(a, b), (p.r.c2Minv)(a, b));\n            // equal components (tie -> takes b in both)\n            eq_v(&format!(\"row07 max-eq[{i}]\"), (p.c.c2Maxv)(a, a), (p.r.c2Maxv)(a, a));\n            eq_v(&format!(\"row07 min-eq[{i}]\"), (p.c.c2Minv)(a, a), (p.r.c2Minv)(a, a));\n        }\n        // Explicit NaN-position matrix: NaN in a only, b only, both.\n        let nan = c2v { x: f32::NAN, y: f32::NAN };\n        let ord = c2v { x: 1.0, y: -1.0 };\n        let zpos = c2v { x: 0.0, y: 0.0 };\n        let zneg = c2v { x: -0.0, y: -0.0 };\n        for (n, (a, b)) in [(nan, ord), (ord, nan), (nan, nan), (zpos, zneg), (zneg, zpos)]\n            .iter()\n            .enumerate()\n        {\n            eq_v(&format!(\"row07 special-max[{n}]\"), (p.c.c2Maxv)(*a, *b), (p.r.c2Maxv)(*a, *b));\n            eq_v(&format!(\"row07 special-min[{n}]\"), (p.c.c2Minv)(*a, *b), (p.r.c2Minv)(*a, *b));\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 8: c2Clampv, incl. the inverted lo>hi range\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row08_c2clampv() {\n    let p = pair();\n    let mut rng = Rng::new(0x0808);\n    unsafe {\n        for i in 0..N {\n            let a = rng.vec_nasty();\n            // lo < hi\n            let (l, h) = (rng.vec_scaled(10.0), rng.vec_scaled(10.0));\n            let lo = c2v { x: l.x.min(h.x), y: l.y.min(h.y) };\n            let hi = c2v { x: l.x.max(h.x), y: l.y.max(h.y) };\n            eq_v(\n                &format!(\"row08 ordered[{i}]\"),\n                (p.c.c2Clampv)(a, lo, hi),\n                (p.r.c2Clampv)(a, lo, hi),\n            );\n            // lo == hi\n            eq_v(&format!(\"row08 equal[{i}]\"), (p.c.c2Clampv)(a, lo, lo), (p.r.c2Clampv)(a, lo, lo));\n            // inverted: lo > hi\n            eq_v(\n                &format!(\"row08 inverted[{i}]\"),\n                (p.c.c2Clampv)(a, hi, lo),\n                (p.r.c2Clampv)(a, hi, lo),\n            );\n            // fully nasty\n            let (nl, nh) = (rng.vec_nasty(), rng.vec_nasty());\n            eq_v(&format!(\"row08 nasty[{i}]\"), (p.c.c2Clampv)(a, nl, nh), (p.r.c2Clampv)(a, nl, nh));\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 9: c2Neg / c2Skew / c2CCW90\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row09_c2neg_skew_ccw90() {\n    let p = pair();\n    let mut rng = Rng::new(0x0909);\n    unsafe {\n        for i in 0..N {\n            let a = rng.vec_nasty();\n            eq_v(&format!(\"row09 neg[{i}] {a:?}\"), (p.c.c2Neg)(a), (p.r.c2Neg)(a));\n            eq_v(&format!(\"row09 skew[{i}] {a:?}\"), (p.c.c2Skew)(a), (p.r.c2Skew)(a));\n            eq_v(&format!(\"row09 ccw90[{i}] {a:?}\"), (p.c.c2CCW90)(a), (p.r.c2CCW90)(a));\n        }\n        // signed zero: -0.0 vs +0.0 must round-trip identically\n        for v in [\n            c2v { x: 0.0, y: 0.0 },\n            c2v { x: -0.0, y: 0.0 },\n            c2v { x: 0.0, y: -0.0 },\n            c2v { x: -0.0, y: -0.0 },\n        ] {\n            eq_v(&format!(\"row09 zero-neg {v:?}\"), (p.c.c2Neg)(v), (p.r.c2Neg)(v));\n            eq_v(&format!(\"row09 zero-skew {v:?}\"), (p.c.c2Skew)(v), (p.r.c2Skew)(v));\n            eq_v(&format!(\"row09 zero-ccw {v:?}\"), (p.c.c2CCW90)(v), (p.r.c2CCW90)(v));\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 10: c2Div (incl. divide-by-zero -> inf/NaN)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row10_c2div() {\n    let p = pair();\n    let mut rng = Rng::new(0x0a0a);\n    let divisors = [1.0f32, -1.0, 0.0, -0.0, f32::INFINITY, f32::NEG_INFINITY, f32::NAN,\n                    f32::MIN_POSITIVE, f32::MAX, 2.0, 1e-30, 1e30];\n    unsafe {\n        for (j, &d) in divisors.iter().enumerate() {\n            for i in 0..256 {\n                let a = rng.vec_nasty();\n                eq_v(\n                    &format!(\"row10 fixed[{j}][{i}] a={a:?} d={d:?}\"),\n                    (p.c.c2Div)(a, d),\n                    (p.r.c2Div)(a, d),\n                );\n            }\n        }\n        for i in 0..N {\n            let a = rng.vec_nasty();\n            let d = rng.nasty();\n            eq_v(&format!(\"row10 rand[{i}] a={a:?} d={d:?}\"), (p.c.c2Div)(a, d), (p.r.c2Div)(a, d));\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 11: c2Norm (incl. the zero vector -> NaN)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row11_c2norm() {\n    let p = pair();\n    let mut rng = Rng::new(0x0b0b);\n    unsafe {\n        for i in 0..N {\n            let a = rng.vec_nasty();\n            eq_v(&format!(\"row11 nasty[{i}] {a:?}\"), (p.c.c2Norm)(a), (p.r.c2Norm)(a));\n            let b = rng.vec_scaled(rng.scale_choice());\n            eq_v(&format!(\"row11 scaled[{i}] {b:?}\"), (p.c.c2Norm)(b), (p.r.c2Norm)(b));\n        }\n        for v in [\n            c2v { x: 0.0, y: 0.0 },\n            c2v { x: -0.0, y: 0.0 },\n            c2v { x: 3.0, y: 4.0 },\n            c2v { x: 1e30, y: 1e30 },\n            c2v { x: f32::from_bits(1), y: 0.0 },\n            c2v { x: f32::INFINITY, y: 1.0 },\n            c2v { x: f32::NAN, y: 1.0 },\n        ] {\n            eq_v(&format!(\"row11 fixed {v:?}\"), (p.c.c2Norm)(v), (p.r.c2Norm)(v));\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 12: c2RotIdentity / c2xIdentity\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row12_identities() {\n    let p = pair();\n    unsafe {\n        for _ in 0..64 {\n            eq_r(\"row12 rot\", (p.c.c2RotIdentity)(), (p.r.c2RotIdentity)());\n            eq_x(\"row12 x\", (p.c.c2xIdentity)(), (p.r.c2xIdentity)());\n        }\n        // Exact expected constants from the C source.\n        let r = (p.r.c2RotIdentity)();\n        assert_eq!((r.c.to_bits(), r.s.to_bits()), (1.0f32.to_bits(), 0.0f32.to_bits()));\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 13: c2Mulrv / c2MulrvT\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row13_c2mulrv_transpose() {\n    let p = pair();\n    let mut rng = Rng::new(0x0d0d);\n    unsafe {\n        for i in 0..N {\n            let v = rng.vec_scaled(rng.scale_choice());\n            // normalised rotation\n            let ang = rng.unit() * std::f32::consts::PI;\n            let rn = c2r { c: ang.cos(), s: ang.sin() };\n            eq_v(&format!(\"row13 norm-fwd[{i}]\"), (p.c.c2Mulrv)(rn, v), (p.r.c2Mulrv)(rn, v));\n            eq_v(&format!(\"row13 norm-tr[{i}]\"), (p.c.c2MulrvT)(rn, v), (p.r.c2MulrvT)(rn, v));\n            // un-normalised\n            let ru = c2r { c: rng.scaled(3.0), s: rng.scaled(3.0) };\n            eq_v(&format!(\"row13 unnorm-fwd[{i}]\"), (p.c.c2Mulrv)(ru, v), (p.r.c2Mulrv)(ru, v));\n            eq_v(&format!(\"row13 unnorm-tr[{i}]\"), (p.c.c2MulrvT)(ru, v), (p.r.c2MulrvT)(ru, v));\n            // nasty\n            let rx = c2r { c: rng.nasty(), s: rng.nasty() };\n            let vx = rng.vec_nasty();\n            eq_v(&format!(\"row13 nasty-fwd[{i}]\"), (p.c.c2Mulrv)(rx, vx), (p.r.c2Mulrv)(rx, vx));\n            eq_v(&format!(\"row13 nasty-tr[{i}]\"), (p.c.c2MulrvT)(rx, vx), (p.r.c2MulrvT)(rx, vx));\n        }\n        // identity and all-zero rotation\n        let id = c2r { c: 1.0, s: 0.0 };\n        let zero = c2r { c: 0.0, s: 0.0 };\n        for i in 0..64 {\n            let v = rng.vec_scaled(100.0);\n            eq_v(&format!(\"row13 id[{i}]\"), (p.c.c2Mulrv)(id, v), (p.r.c2Mulrv)(id, v));\n            eq_v(&format!(\"row13 zero[{i}]\"), (p.c.c2Mulrv)(zero, v), (p.r.c2Mulrv)(zero, v));\n            eq_v(&format!(\"row13 id-t[{i}]\"), (p.c.c2MulrvT)(id, v), (p.r.c2MulrvT)(id, v));\n            eq_v(&format!(\"row13 zero-t[{i}]\"), (p.c.c2MulrvT)(zero, v), (p.r.c2MulrvT)(zero, v));\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 14: c2Mulxv\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row14_c2mulxv() {\n    let p = pair();\n    let mut rng = Rng::new(0x0e0e);\n    unsafe {\n        for i in 0..N {\n            let v = rng.vec_scaled(rng.scale_choice());\n            let x1 = rand_transform(&mut rng, 100.0);\n            eq_v(&format!(\"row14 norm[{i}]\"), (p.c.c2Mulxv)(x1, v), (p.r.c2Mulxv)(x1, v));\n            let x2 = rand_transform_unnorm(&mut rng, 100.0);\n            eq_v(&format!(\"row14 unnorm[{i}]\"), (p.c.c2Mulxv)(x2, v), (p.r.c2Mulxv)(x2, v));\n            let x3 = c2x { p: rng.vec_nasty(), r: c2r { c: rng.nasty(), s: rng.nasty() } };\n            let vn = rng.vec_nasty();\n            eq_v(&format!(\"row14 nasty[{i}]\"), (p.c.c2Mulxv)(x3, vn), (p.r.c2Mulxv)(x3, vn));\n        }\n        // identity transform must be a no-op in both\n        let id = unsafe { (p.c.c2xIdentity)() };\n        for i in 0..256 {\n            let v = rng.vec_nasty();\n            eq_v(&format!(\"row14 identity[{i}]\"), (p.c.c2Mulxv)(id, v), (p.r.c2Mulxv)(id, v));\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Row 15: c2BBVerts\n// ---------------------------------------------------------------------------\n\n#[test]\nfn row15_c2bbverts() {\n    let p = pair();\n    let mut rng = Rng::new(0x0f0f);\n    unsafe {\n        // The out buffer is 8 wide (as inside c2Proxy) and poisoned, so that\n        // \"wrote exactly 4 verts\" is verified too.\n        let poison = c2v { x: f32::from_bits(0xAAAA_AAAA), y: f32::from_bits(0x5555_5555) };\n        let mut cases: Vec<c2AABB> = Vec::new();\n        for _ in 0..N {\n            cases.push(rand_aabb(&mut rng, rng.scale_choice()));\n        }\n        // degenerate / inverted / extreme\n        cases.push(c2AABB { min: c2v { x: 0.0, y: 0.0 }, max: c2v { x: 0.0, y: 0.0 } });\n        cases.push(c2AABB { min: c2v { x: 5.0, y: 5.0 }, max: c2v { x: -5.0, y: -5.0 } });\n        cases.push(c2AABB { min: c2v { x: -0.0, y: 0.0 }, max: c2v { x: 0.0, y: -0.0 } });\n        cases.push(c2AABB {\n            min: c2v { x: f32::NEG_INFINITY, y: f32::NAN },\n            max: c2v { x: f32::INFINITY, y: 1.0 },\n        });\n        cases.push(c2AABB {\n            min: c2v { x: -f32::MAX, y: -f32::MAX },\n            max: c2v { x: f32::MAX, y: f32::MAX },\n        });\n        for _ in 0..256 {\n            cases.push(c2AABB { min: rng.vec_nasty(), max: rng.vec_nasty() });\n        }\n\n        for (i, bb) in cases.iter().enumerate() {\n            let mut oc = [poison; 8];\n            let mut or = [poison; 8];\n            let mut bc = *bb;\n            let mut br = *bb;\n            (p.c.c2BBVerts)(oc.as_mut_ptr(), &mut bc);\n            (p.r.c2BBVerts)(or.as_mut_ptr(), &mut br);\n            eq_bytes(&format!(\"row15[{i}] out {bb:?}\"), &oc, &or);\n            // the input AABB must not be modified by either\n            eq_bytes(&format!(\"row15[{i}] in\"), &bc, &br);\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Rows 16..19: c2MakeProxy for each type, into a poisoned proxy\n// ---------------------------------------------------------------------------\n\nfn poisoned_proxy(byte: u8) -> c2Proxy {\n    let mut pr = c2Proxy::default();\n    unsafe {\n        std::ptr::write_bytes(&mut pr as *mut c2Proxy as *mut u8, byte, std::mem::size_of::<c2Proxy>());\n    }\n    pr\n}\n\n#[test]\nfn row16_makeproxy_circle() {\n    let p = pair();\n    let mut rng = Rng::new(0x1010);\n    unsafe {\n        for i in 0..N {\n            let c = match rng.below(5) {\n                0 => c2Circle { p: c2v { x: 0.0, y: 0.0 }, r: 0.0 },\n                1 => c2Circle { p: rng.vec_scaled(100.0), r: -rng.scaled(10.0).abs() },\n                2 => c2Circle { p: rng.vec_nasty(), r: rng.nasty() },\n                _ => rand_circle(&mut rng, rng.scale_choice()),\n            };\n            let mut pc = poisoned_proxy(0xAA);\n            let mut pr2 = poisoned_proxy(0xAA);\n            (p.c.c2MakeProxy)(&c as *const c2Circle as *const _, C2_TYPE_CIRCLE, &mut pc);\n            (p.r.c2MakeProxy)(&c as *const c2Circle as *const _, C2_TYPE_CIRCLE, &mut pr2);\n            eq_proxy(&format!(\"row16[{i}] {c:?}\"), &pc, &pr2);\n            // structural expectations from the C source\n            eq_i(\"row16 count\", pc.count, 1);\n            // verts[1..8] must still be poison in BOTH\n            for k in 1..8 {\n                assert_eq!(pc.verts[k].x.to_bits(), 0xAAAA_AAAA, \"C clobbered verts[{k}]\");\n                assert_eq!(pr2.verts[k].x.to_bits(), 0xAAAA_AAAA, \"Rust clobbered verts[{k}]\");\n            }\n        }\n    }\n}\n\n#[test]\nfn row17_makeproxy_aabb() {\n    let p = pair();\n    let mut rng = Rng::new(0x1111);\n    unsafe {\n        for i in 0..N {\n            let bb = match rng.below(5) {\n                0 => c2AABB { min: c2v { x: 0.0, y: 0.0 }, max: c2v { x: 0.0, y: 0.0 } },\n                1 => c2AABB { min: c2v { x: 9.0, y: 9.0 }, max: c2v { x: -9.0, y: -9.0 } },\n                2 => c2AABB { min: rng.vec_nasty(), max: rng.vec_nasty() },\n                _ => rand_aabb(&mut rng, rng.scale_choice()),\n            };\n            let mut pc = poisoned_proxy(0xAA);\n            let mut pr2 = poisoned_proxy(0xAA);\n            (p.c.c2MakeProxy)(&bb as *const c2AABB as *const _, C2_TYPE_AABB, &mut pc);\n            (p.r.c2MakeProxy)(&bb as *const c2AABB as *const _, C2_TYPE_AABB, &mut pr2);\n            eq_proxy(&format!(\"row17[{i}] {bb:?}\"), &pc, &pr2);\n            eq_i(\"row17 count\", pc.count, 4);\n            eq_f32(\"row17 radius\", pc.radius, 0.0);\n            for k in 4..8 {\n                assert_eq!(pc.verts[k].x.to_bits(), 0xAAAA_AAAA, \"C clobbered verts[{k}]\");\n                assert_eq!(pr2.verts[k].x.to_bits(), 0xAAAA_AAAA, \"Rust clobbered verts[{k}]\");\n            }\n        }\n    }\n}\n\n#[test]\nfn row18_makeproxy_capsule() {\n    let p = pair();\n    let mut rng = Rng::new(0x1212);\n    unsafe {\n        for i in 0..N {\n            let cap = match rng.below(5) {\n                0 => {\n                    let a = rng.vec_scaled(100.0);\n                    c2Capsule { a, b: a, r: 0.0 } // zero-length, zero radius\n                }\n                1 => c2Capsule {\n                    a: rng.vec_scaled(100.0),\n                    b: rng.vec_scaled(100.0),\n                    r: -rng.scaled(10.0).abs(),\n                },\n                2 => c2Capsule { a: rng.vec_nasty(), b: rng.vec_nasty(), r: rng.nasty() },\n                _ => rand_capsule(&mut rng, rng.scale_choice()),\n            };\n            let mut pc = poisoned_proxy(0xAA);\n            let mut pr2 = poisoned_proxy(0xAA);\n            (p.c.c2MakeProxy)(&cap as *const c2Capsule as *const _, C2_TYPE_CAPSULE, &mut pc);\n            (p.r.c2MakeProxy)(&cap as *const c2Capsule as *const _, C2_TYPE_CAPSULE, &mut pr2);\n            eq_proxy(&format!(\"row18[{i}] {cap:?}\"), &pc, &pr2);\n            eq_i(\"row18 count\", pc.count, 2);\n            for k in 2..8 {\n                assert_eq!(pc.verts[k].x.to_bits(), 0xAAAA_AAAA, \"C clobbered verts[{k}]\");\n                assert_eq!(pr2.verts[k].x.to_bits(), 0xAAAA_AAAA, \"Rust clobbered verts[{k}]\");\n            }\n        }\n    }\n}\n\n#[test]\nfn row19_makeproxy_poison_patterns() {\n    // Same shapes written into proxies pre-filled with several different byte\n    // patterns: verifies exactly which bytes each switch arm writes.\n    let p = pair();\n    let mut rng = Rng::new(0x1313);\n    unsafe {\n        for pat in [0x00u8, 0xFF, 0xAA, 0x55, 0x7F, 0x80] {\n            for i in 0..256 {\n                let shape = rand_shape_of(&mut rng, rng.below(3) as i32, rng.scale_choice());\n                let mut pc = poisoned_proxy(pat);\n                let mut pr2 = poisoned_proxy(pat);\n                (p.c.c2MakeProxy)(shape.as_ptr(), shape.ty(), &mut pc);\n                (p.r.c2MakeProxy)(shape.as_ptr(), shape.ty(), &mut pr2);\n                eq_proxy(&format!(\"row19 pat={pat:#02x}[{i}] {shape:?}\"), &pc, &pr2);\n            }\n        }\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
