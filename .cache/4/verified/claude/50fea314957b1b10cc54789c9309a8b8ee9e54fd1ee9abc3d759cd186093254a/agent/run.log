{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01VgH4fSCN7uMuVSVN7ob5og","type":"tool_result","content":"The file /local/home/scheschb/.harvest/work/harvest-work-0NMgaL/translated_rust/src/lib.rs has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"f8eef8cc-b596-45c4-9391-2a80d287efb6","uuid":"7c32af24-eb6b-47f0-ac73-32bf98ba84c5","timestamp":"2026-08-20T09:50:49.005Z","tool_use_result":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-0NMgaL/translated_rust/src/lib.rs","oldString":"    let mut imax: c_int = 0;\n    let mut dmax = c2Dot(*verts.offset(0), d);\n    let mut i: c_int = 1;","newString":"    let mut imax: c_int = 0;\n    // The C evaluates `c2Dot(verts[0], d)` UNCONDITIONALLY, before the loop\n    // guard ever looks at `count`. When `count <= 0` the value is unused, and an\n    // optimising build would happily delete the load -- which would silently\n    // turn a C segfault (`verts == NULL`, `count == 0`) into a quiet `return 0`.\n    // A volatile read pins the dereference so the observable behaviour matches.\n    let mut dmax = c2Dot(core::ptr::read_volatile(verts), d);\n    let mut i: c_int = 1;","originalFile":"//! Faithful Rust translation of c_src/src/lib.c (a slice of cute_c2 / tinyc2 GJK).\n//!\n//! Every function in the C translation unit has external linkage, therefore\n//! every one of them is part of the public ABI and is re-exported here with\n//! `#[unsafe(no_mangle)] extern \"C\"`.\n//!\n//! Semantics are reproduced literally, including the odd cache-validation\n//! condition in `c2GJK` and the fact that `gjk_cache` never writes through its\n//! `a9` / `b9` out-parameters.\n\n#![allow(non_snake_case)]\n#![allow(non_camel_case_types)]\n#![allow(unused_variables)]\n#![allow(unused_assignments)]\n\nuse std::ffi::{c_char, c_int, c_void};\n\n// ---------------------------------------------------------------------------\n// C2_TYPE\n// ---------------------------------------------------------------------------\n\npub const C2_TYPE_CIRCLE: c_int = 0;\npub const C2_TYPE_AABB: c_int = 1;\npub const C2_TYPE_CAPSULE: c_int = 2;\n\n/// `typedef enum { ... } C2_TYPE;` — passed as an `int` in the SysV ABI.\npub type C2_TYPE = c_int;\n\n// ---------------------------------------------------------------------------\n// Public POD types (layout-compatible with the C definitions)\n// ---------------------------------------------------------------------------\n\n#[repr(C)]\n#[derive(Copy, Clone, Default)]\npub struct c2v {\n    pub x: f32,\n    pub y: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Default)]\npub struct c2r {\n    pub c: f32,\n    pub s: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Default)]\npub struct c2x {\n    pub p: c2v,\n    pub r: c2r,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Default)]\npub struct c2Circle {\n    pub p: c2v,\n    pub r: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Default)]\npub struct c2AABB {\n    pub min: c2v,\n    pub max: c2v,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Default)]\npub struct c2Capsule {\n    pub a: c2v,\n    pub b: c2v,\n    pub r: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Default)]\npub struct c2GJKCache {\n    pub metric: f32,\n    pub count: c_int,\n    pub iA: [c_int; 3],\n    pub iB: [c_int; 3],\n    pub div: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct c2Proxy {\n    pub radius: f32,\n    pub count: c_int,\n    pub verts: [c2v; 8],\n}\n\nimpl Default for c2Proxy {\n    fn default() -> Self {\n        c2Proxy {\n            radius: 0.0,\n            count: 0,\n            verts: [c2v::default(); 8],\n        }\n    }\n}\n\n#[repr(C)]\n#[derive(Copy, Clone, Default)]\npub struct c2sv {\n    pub sA: c2v,\n    pub sB: c2v,\n    pub p: c2v,\n    pub u: f32,\n    pub iA: c_int,\n    pub iB: c_int,\n}\n\n/// `struct { c2sv a, b, c, d; float div; int count; }`\n///\n/// The four `c2sv` members are stored as an array so that the C idiom\n/// `c2sv* verts = &s->a; verts[i]` translates directly while keeping an\n/// identical memory layout.\n#[repr(C)]\n#[derive(Copy, Clone, Default)]\npub struct c2Simplex {\n    pub verts: [c2sv; 4],\n    pub div: f32,\n    pub count: c_int,\n}\n\n// ---------------------------------------------------------------------------\n// Constants used verbatim by the C source\n// ---------------------------------------------------------------------------\n\n/// 3.40282346638528859811704183484516925e+38F (FLT_MAX)\nconst C2_FLT_MAX: f32 = 3.402_823_466_385_288_598_117_041_834_845_169_25e+38;\n/// 1.19209289550781250000000000000000000e-7F (FLT_EPSILON)\nconst C2_FLT_EPSILON: f32 = 1.192_092_895_507_812_5e-7;\n\n// ---------------------------------------------------------------------------\n// Vector helpers\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n    c2v { x, y }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulvs(a: c2v, b: f32) -> c2v {\n    let mut a = a;\n    a.x *= b;\n    a.y *= b;\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n    // Reproduce the C ternaries exactly (NaN falls through to `b`).\n    c2V(\n        if a.x > b.x { a.x } else { b.x },\n        if a.y > b.y { a.y } else { b.y },\n    )\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n    c2V(\n        if a.x < b.x { a.x } else { b.x },\n        if a.y < b.y { a.y } else { b.y },\n    )\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n    c2Maxv(lo, c2Minv(a, hi))\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Sub(a: c2v, b: c2v) -> c2v {\n    let mut a = a;\n    a.x -= b.x;\n    a.y -= b.y;\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n    a.x * b.x + a.y * b.y\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2RotIdentity() -> c2r {\n    c2r { c: 1.0f32, s: 0.0 }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2xIdentity() -> c2x {\n    c2x {\n        p: c2V(0.0, 0.0),\n        r: c2RotIdentity(),\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2BBVerts(out: *mut c2v, bb: *mut c2AABB) {\n    let bb = &*bb;\n    *out.add(0) = bb.min;\n    *out.add(1) = c2V(bb.max.x, bb.min.y);\n    *out.add(2) = bb.max;\n    *out.add(3) = c2V(bb.min.x, bb.max.y);\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2MakeProxy(shape: *const c_void, type_: C2_TYPE, p: *mut c2Proxy) {\n    match type_ {\n        C2_TYPE_CIRCLE => {\n            let c = shape as *const c2Circle;\n            (*p).radius = (*c).r;\n            (*p).count = 1;\n            (*p).verts[0] = (*c).p;\n        }\n        C2_TYPE_AABB => {\n            let bb = shape as *mut c2AABB;\n            (*p).radius = 0.0;\n            (*p).count = 4;\n            c2BBVerts((*p).verts.as_mut_ptr(), bb);\n        }\n        C2_TYPE_CAPSULE => {\n            let c = shape as *const c2Capsule;\n            (*p).radius = (*c).r;\n            (*p).count = 2;\n            (*p).verts[0] = (*c).a;\n            (*p).verts[1] = (*c).b;\n        }\n        // No `default:` label in the C switch: nothing happens.\n        _ => {}\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Len(a: c2v) -> f32 {\n    c2Dot(a, a).sqrt()\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Det2(a: c2v, b: c2v) -> f32 {\n    a.x * b.y - a.y * b.x\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2GJKSimplexMetric(s: *mut c2Simplex) -> f32 {\n    let s = &*s;\n    match s.count {\n        2 => c2Len(c2Sub(s.verts[1].p, s.verts[0].p)),\n        3 => c2Det2(\n            c2Sub(s.verts[1].p, s.verts[0].p),\n            c2Sub(s.verts[2].p, s.verts[0].p),\n        ),\n        // `default:` falls through into `case 1:` in the C source.\n        _ => 0.0,\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulrv(a: c2r, b: c2v) -> c2v {\n    c2V(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Add(a: c2v, b: c2v) -> c2v {\n    let mut a = a;\n    a.x += b.x;\n    a.y += b.y;\n    a\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulxv(a: c2x, b: c2v) -> c2v {\n    c2Add(c2Mulrv(a.r, b), a.p)\n}\n\n// ---------------------------------------------------------------------------\n// Simplex solvers\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c22(s: *mut c2Simplex) {\n    let s = &mut *s;\n    let a = s.verts[0].p;\n    let b = s.verts[1].p;\n    let u = c2Dot(b, c2Sub(b, a));\n    let v = c2Dot(a, c2Sub(a, b));\n    if v <= 0.0 {\n        s.verts[0].u = 1.0f32;\n        s.div = 1.0f32;\n        s.count = 1;\n    } else if u <= 0.0 {\n        s.verts[0] = s.verts[1];\n        s.verts[0].u = 1.0f32;\n        s.div = 1.0f32;\n        s.count = 1;\n    } else {\n        s.verts[0].u = u;\n        s.verts[1].u = v;\n        s.div = u + v;\n        s.count = 2;\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c23(s: *mut c2Simplex) {\n    let s = &mut *s;\n    let a = s.verts[0].p;\n    let b = s.verts[1].p;\n    let c = s.verts[2].p;\n    let uAB = c2Dot(b, c2Sub(b, a));\n    let vAB = c2Dot(a, c2Sub(a, b));\n    let uBC = c2Dot(c, c2Sub(c, b));\n    let vBC = c2Dot(b, c2Sub(b, c));\n    let uCA = c2Dot(a, c2Sub(a, c));\n    let vCA = c2Dot(c, c2Sub(c, a));\n    let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n    let uABC = c2Det2(b, c) * area;\n    let vABC = c2Det2(c, a) * area;\n    let wABC = c2Det2(a, b) * area;\n    if vAB <= 0.0 && uCA <= 0.0 {\n        s.verts[0].u = 1.0f32;\n        s.div = 1.0f32;\n        s.count = 1;\n    } else if uAB <= 0.0 && vBC <= 0.0 {\n        s.verts[0] = s.verts[1];\n        s.verts[0].u = 1.0f32;\n        s.div = 1.0f32;\n        s.count = 1;\n    } else if uBC <= 0.0 && vCA <= 0.0 {\n        s.verts[0] = s.verts[2];\n        s.verts[0].u = 1.0f32;\n        s.div = 1.0f32;\n        s.count = 1;\n    } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n        s.verts[0].u = uAB;\n        s.verts[1].u = vAB;\n        s.div = uAB + vAB;\n        s.count = 2;\n    } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n        s.verts[0] = s.verts[1];\n        s.verts[1] = s.verts[2];\n        s.verts[0].u = uBC;\n        s.verts[1].u = vBC;\n        s.div = uBC + vBC;\n        s.count = 2;\n    } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n        s.verts[1] = s.verts[0];\n        s.verts[0] = s.verts[2];\n        s.verts[0].u = uCA;\n        s.verts[1].u = vCA;\n        s.div = uCA + vCA;\n        s.count = 2;\n    } else {\n        s.verts[0].u = uABC;\n        s.verts[1].u = vABC;\n        s.verts[2].u = wABC;\n        s.div = uABC + vABC + wABC;\n        s.count = 3;\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Neg(a: c2v) -> c2v {\n    c2V(-a.x, -a.y)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n    c2v { x: -a.y, y: a.x }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n    c2v { x: a.y, y: -a.x }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2D(s: *mut c2Simplex) -> c2v {\n    let s = &*s;\n    match s.count {\n        1 => c2Neg(s.verts[0].p),\n        2 => {\n            let ab = c2Sub(s.verts[1].p, s.verts[0].p);\n            if c2Det2(ab, c2Neg(s.verts[0].p)) > 0.0 {\n                return c2Skew(ab);\n            }\n            c2CCW90(ab)\n        }\n        // case 3 / default\n        _ => c2V(0.0, 0.0),\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2Support(verts: *const c2v, count: c_int, d: c2v) -> c_int {\n    let mut imax: c_int = 0;\n    let mut dmax = c2Dot(*verts.offset(0), d);\n    let mut i: c_int = 1;\n    while i < count {\n        let dot = c2Dot(*verts.offset(i as isize), d);\n        if dot > dmax {\n            imax = i;\n            dmax = dot;\n        }\n        i += 1;\n    }\n    imax\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2Witness(s: *mut c2Simplex, a: *mut c2v, b: *mut c2v) {\n    let s = &*s;\n    let den = 1.0f32 / s.div;\n    match s.count {\n        1 => {\n            *a = s.verts[0].sA;\n            *b = s.verts[0].sB;\n        }\n        2 => {\n            *a = c2Add(\n                c2Mulvs(s.verts[0].sA, den * s.verts[0].u),\n                c2Mulvs(s.verts[1].sA, den * s.verts[1].u),\n            );\n            *b = c2Add(\n                c2Mulvs(s.verts[0].sB, den * s.verts[0].u),\n                c2Mulvs(s.verts[1].sB, den * s.verts[1].u),\n            );\n        }\n        3 => {\n            *a = c2Add(\n                c2Add(\n                    c2Mulvs(s.verts[0].sA, den * s.verts[0].u),\n                    c2Mulvs(s.verts[1].sA, den * s.verts[1].u),\n                ),\n                c2Mulvs(s.verts[2].sA, den * s.verts[2].u),\n            );\n            *b = c2Add(\n                c2Add(\n                    c2Mulvs(s.verts[0].sB, den * s.verts[0].u),\n                    c2Mulvs(s.verts[1].sB, den * s.verts[1].u),\n                ),\n                c2Mulvs(s.verts[2].sB, den * s.verts[2].u),\n            );\n        }\n        _ => {\n            *a = c2V(0.0, 0.0);\n            *b = c2V(0.0, 0.0);\n        }\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n    c2Mulvs(a, 1.0f32 / b)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n    c2Div(a, c2Len(a))\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2L(s: *mut c2Simplex) -> c2v {\n    let s = &*s;\n    let den = 1.0f32 / s.div;\n    match s.count {\n        1 => s.verts[0].p,\n        2 => c2Add(\n            c2Mulvs(s.verts[0].p, den * s.verts[0].u),\n            c2Mulvs(s.verts[1].p, den * s.verts[1].u),\n        ),\n        _ => c2V(0.0, 0.0),\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2MulrvT(a: c2r, b: c2v) -> c2v {\n    c2V(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y)\n}\n\n// ---------------------------------------------------------------------------\n// GJK\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2GJK(\n    A: *const c_void,\n    typeA: C2_TYPE,\n    ax_ptr: *const c2x,\n    B: *const c_void,\n    typeB: C2_TYPE,\n    bx_ptr: *const c2x,\n    outA: *mut c2v,\n    outB: *mut c2v,\n    use_radius: c_int,\n    iterations: *mut c_int,\n    cache: *mut c2GJKCache,\n) -> f32 {\n    let ax: c2x;\n    let bx: c2x;\n    if ax_ptr.is_null() {\n        ax = c2xIdentity();\n    } else {\n        ax = *ax_ptr;\n    }\n    if bx_ptr.is_null() {\n        bx = c2xIdentity();\n    } else {\n        bx = *bx_ptr;\n    }\n\n    let mut pA = c2Proxy::default();\n    let mut pB = c2Proxy::default();\n    c2MakeProxy(A, typeA, &mut pA);\n    c2MakeProxy(B, typeB, &mut pB);\n\n    // The C declares a bare `c2Simplex s;` local. Its cache-read loop writes\n    // `verts[i]` for `i < cache->count`, so a caller-supplied `count >= 5`\n    // writes past the end of the struct into the rest of the C stack frame,\n    // where it is harmless. Backing the simplex with a padded allocation\n    // reproduces that: the overflow lands in `_pad` instead of corrupting live\n    // Rust locals, while `div`/`count` are still clobbered exactly as in C.\n    #[repr(C)]\n    struct SimplexPad {\n        s: c2Simplex,\n        _pad: [u8; 128],\n    }\n    let mut spad = SimplexPad { s: c2Simplex::default(), _pad: [0u8; 128] };\n    let sp: *mut c2Simplex = &raw mut spad.s;\n    let s: &mut c2Simplex = &mut *sp;\n\n    // C: `c2sv* verts = &s.a;`\n    //\n    // Every index below (`cache->count`, `cache->iA[i]`, `cache->iB[i]`) comes\n    // from the *caller's* cache and is never validated by the C. Using Rust\n    // slice indexing here would turn C's non-trapping out-of-range read into a\n    // panic/abort, so all of these accesses mirror the C's raw pointer\n    // arithmetic instead. See ERRORS.md rows 35-38.\n    let verts: *mut c2sv = (*sp).verts.as_mut_ptr();\n    let pa_verts: *const c2v = pA.verts.as_ptr();\n    let pb_verts: *const c2v = pB.verts.as_ptr();\n\n    let mut cache_was_read: c_int = 0;\n    if !cache.is_null() {\n        let cache_was_good = (*cache).count != 0;\n        if cache_was_good {\n            let cache_iA: *const c_int = (*cache).iA.as_ptr();\n            let cache_iB: *const c_int = (*cache).iB.as_ptr();\n            let mut i: c_int = 0;\n            while i < (*cache).count {\n                let iA = *cache_iA.offset(i as isize);\n                let iB = *cache_iB.offset(i as isize);\n                let sA = c2Mulxv(ax, *pa_verts.offset(iA as isize));\n                let sB = c2Mulxv(bx, *pb_verts.offset(iB as isize));\n                let v = &mut *verts.offset(i as isize);\n                v.iA = iA;\n                v.sA = sA;\n                v.iB = iB;\n                v.sB = sB;\n                v.p = c2Sub(v.sB, v.sA);\n                v.u = 0.0;\n                i += 1;\n            }\n            s.count = (*cache).count;\n            s.div = (*cache).div;\n            let metric_old = (*cache).metric;\n            let metric = c2GJKSimplexMetric(sp);\n            let min_metric = if metric < metric_old { metric } else { metric_old };\n            let max_metric = if metric > metric_old { metric } else { metric_old };\n            if !(min_metric < max_metric * 2.0f32 && metric < -1.0e8f32) {\n                cache_was_read = 1;\n            }\n        }\n    }\n\n    if cache_was_read == 0 {\n        s.verts[0].iA = 0;\n        s.verts[0].iB = 0;\n        s.verts[0].sA = c2Mulxv(ax, *pa_verts);\n        s.verts[0].sB = c2Mulxv(bx, *pb_verts);\n        s.verts[0].p = c2Sub(s.verts[0].sB, s.verts[0].sA);\n        s.verts[0].u = 1.0f32;\n        s.div = 1.0f32;\n        s.count = 1;\n    }\n\n    // C: `int saveA[3], saveB[3];` — the C writes `saveA[i]` / `saveB[i]` for\n    // `i < s.count`, which overruns both arrays when a bogus cache pushed\n    // `count` above 3. gcc lays the two arrays out contiguously, so in C\n    // `saveA[3]` simply aliases `saveB[0]` and nothing live is harmed. A pair of\n    // separate Rust arrays would instead clobber an unrelated live local (that\n    // corrupted `verts` and segfaulted), so they are allocated as ONE padded\n    // buffer with `saveB` starting at index 3, reproducing the C frame layout.\n    let mut save_store: [c_int; 16] = [0; 16];\n    let save_a: *mut c_int = save_store.as_mut_ptr();\n    let save_b: *mut c_int = save_store.as_mut_ptr().add(3);\n    let mut save_count: c_int = 0;\n    let mut d0 = C2_FLT_MAX;\n    let mut d1 = C2_FLT_MAX;\n    let mut iter: c_int = 0;\n    let mut hit: c_int = 0;\n\n    while iter < 20 {\n        save_count = s.count;\n        let mut i: c_int = 0;\n        while i < save_count {\n            *save_a.offset(i as isize) = (*verts.offset(i as isize)).iA;\n            *save_b.offset(i as isize) = (*verts.offset(i as isize)).iB;\n            i += 1;\n        }\n\n        match s.count {\n            1 => {}\n            2 => c22(sp),\n            3 => c23(sp),\n            _ => {}\n        }\n\n        if s.count == 3 {\n            hit = 1;\n            break;\n        }\n\n        let p = c2L(sp);\n        d1 = c2Dot(p, p);\n        if d1 > d0 {\n            break;\n        }\n        d0 = d1;\n\n        let d = c2D(sp);\n        if c2Dot(d, d) < C2_FLT_EPSILON * C2_FLT_EPSILON {\n            break;\n        }\n\n        let iA = c2Support(pa_verts, pA.count, c2MulrvT(ax.r, c2Neg(d)));\n        let sA = c2Mulxv(ax, *pa_verts.offset(iA as isize));\n        let iB = c2Support(pb_verts, pB.count, c2MulrvT(bx.r, d));\n        let sB = c2Mulxv(bx, *pb_verts.offset(iB as isize));\n        {\n            // C: `c2sv* v = verts + s.count;`\n            let v = &mut *verts.offset(s.count as isize);\n            v.iA = iA;\n            v.sA = sA;\n            v.iB = iB;\n            v.sB = sB;\n            v.p = c2Sub(v.sB, v.sA);\n        }\n\n        let mut dup = 0;\n        let mut i: c_int = 0;\n        while i < save_count {\n            if iA == *save_a.offset(i as isize) && iB == *save_b.offset(i as isize) {\n                dup = 1;\n                break;\n            }\n            i += 1;\n        }\n        if dup != 0 {\n            break;\n        }\n\n        s.count += 1;\n        iter += 1;\n    }\n\n    let mut a = c2v::default();\n    let mut b = c2v::default();\n    c2Witness(sp, &mut a, &mut b);\n    let mut dist = c2Len(c2Sub(a, b));\n\n    if hit != 0 {\n        a = b;\n        dist = 0.0;\n    } else if use_radius != 0 {\n        let rA = pA.radius;\n        let rB = pB.radius;\n        if dist > rA + rB && dist > C2_FLT_EPSILON {\n            dist -= rA + rB;\n            let n = c2Norm(c2Sub(b, a));\n            a = c2Add(a, c2Mulvs(n, rA));\n            b = c2Sub(b, c2Mulvs(n, rB));\n            if a.x == b.x && a.y == b.y {\n                dist = 0.0;\n            }\n        } else {\n            let p = c2Mulvs(c2Add(a, b), 0.5f32);\n            a = p;\n            b = p;\n            dist = 0.0;\n        }\n    }\n\n    if !cache.is_null() {\n        (*cache).metric = c2GJKSimplexMetric(sp);\n        (*cache).count = s.count;\n        // As in the read loop: `s.count` can exceed 3 if the caller supplied a\n        // bogus cache, and the C writes past `iA[3]` without complaint.\n        let cache_iA: *mut c_int = (*cache).iA.as_mut_ptr();\n        let cache_iB: *mut c_int = (*cache).iB.as_mut_ptr();\n        let mut i: c_int = 0;\n        while i < s.count {\n            let v = &*verts.offset(i as isize);\n            *cache_iA.offset(i as isize) = v.iA;\n            *cache_iB.offset(i as isize) = v.iB;\n            i += 1;\n        }\n        (*cache).div = s.div;\n    }\n\n    if !outA.is_null() {\n        *outA = a;\n    }\n    if !outB.is_null() {\n        *outB = b