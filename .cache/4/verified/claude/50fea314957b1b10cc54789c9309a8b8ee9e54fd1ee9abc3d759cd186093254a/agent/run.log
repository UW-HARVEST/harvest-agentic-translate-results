 cute_c2 / tinyc2 GJK).\n     2\t//!\n     3\t//! Every function in the C translation unit has external linkage, therefore\n     4\t//! every one of them is part of the public ABI and is re-exported here with\n     5\t//! `#[unsafe(no_mangle)] extern \"C\"`.\n     6\t//!\n     7\t//! Semantics are reproduced literally, including the odd cache-validation\n     8\t//! condition in `c2GJK` and the fact that `gjk_cache` never writes through its\n     9\t//! `a9` / `b9` out-parameters.\n    10\t\n    11\t#![allow(non_snake_case)]\n    12\t#![allow(non_camel_case_types)]\n    13\t#![allow(unused_variables)]\n    14\t#![allow(unused_assignments)]\n    15\t\n    16\tuse std::ffi::{c_char, c_int, c_void};\n    17\t\n    18\t// ---------------------------------------------------------------------------\n    19\t// C2_TYPE\n    20\t// ---------------------------------------------------------------------------\n    21\t\n    22\tpub const C2_TYPE_CIRCLE: c_int = 0;\n    23\tpub const C2_TYPE_AABB: c_int = 1;\n    24\tpub const C2_TYPE_CAPSULE: c_int = 2;\n    25\t\n    26\t/// `typedef enum { ... } C2_TYPE;` — passed as an `int` in the SysV ABI.\n    27\tpub type C2_TYPE = c_int;\n    28\t\n    29\t// ---------------------------------------------------------------------------\n    30\t// Public POD types (layout-compatible with the C definitions)\n    31\t// ---------------------------------------------------------------------------\n    32\t\n    33\t#[repr(C)]\n    34\t#[derive(Copy, Clone, Default)]\n    35\tpub struct c2v {\n    36\t    pub x: f32,\n    37\t    pub y: f32,\n    38\t}\n    39\t\n    40\t#[repr(C)]\n    41\t#[derive(Copy, Clone, Default)]\n    42\tpub struct c2r {\n    43\t    pub c: f32,\n    44\t    pub s: f32,\n    45\t}\n    46\t\n    47\t#[repr(C)]\n    48\t#[derive(Copy, Clone, Default)]\n    49\tpub struct c2x {\n    50\t    pub p: c2v,\n    51\t    pub r: c2r,\n    52\t}\n    53\t\n    54\t#[repr(C)]\n    55\t#[derive(Copy, Clone, Default)]\n    56\tpub struct c2Circle {\n    57\t    pub p: c2v,\n    58\t    pub r: f32,\n    59\t}\n    60\t\n    61\t#[repr(C)]\n    62\t#[derive(Copy, Clone, Default)]\n    63\tpub struct c2AABB {\n    64\t    pub min: c2v,\n    65\t    pub max: c2v,\n    66\t}\n    67\t\n    68\t#[repr(C)]\n    69\t#[derive(Copy, Clone, Default)]\n    70\tpub struct c2Capsule {\n    71\t    pub a: c2v,\n    72\t    pub b: c2v,\n    73\t    pub r: f32,\n    74\t}\n    75\t\n    76\t#[repr(C)]\n    77\t#[derive(Copy, Clone, Default)]\n    78\tpub struct c2GJKCache {\n    79\t    pub metric: f32,\n    80\t    pub count: c_int,\n    81\t    pub iA: [c_int; 3],\n    82\t    pub iB: [c_int; 3],\n    83\t    pub div: f32,\n    84\t}\n    85\t\n    86\t#[repr(C)]\n    87\t#[derive(Copy, Clone)]\n    88\tpub struct c2Proxy {\n    89\t    pub radius: f32,\n    90\t    pub count: c_int,\n    91\t    pub verts: [c2v; 8],\n    92\t}\n    93\t\n    94\timpl Default for c2Proxy {\n    95\t    fn default() -> Self {\n    96\t        c2Proxy {\n    97\t            radius: 0.0,\n    98\t            count: 0,\n    99\t            verts: [c2v::default(); 8],\n   100\t        }\n   101\t    }\n   102\t}\n   103\t\n   104\t#[repr(C)]\n   105\t#[derive(Copy, Clone, Default)]\n   106\tpub struct c2sv {\n   107\t    pub sA: c2v,\n   108\t    pub sB: c2v,\n   109\t    pub p: c2v,\n   110\t    pub u: f32,\n   111\t    pub iA: c_int,\n   112\t    pub iB: c_int,\n   113\t}\n   114\t\n   115\t/// `struct { c2sv a, b, c, d; float div; int count; }`\n   116\t///\n   117\t/// The four `c2sv` members are stored as an array so that the C idiom\n   118\t/// `c2sv* verts = &s->a; verts[i]` translates directly while keeping an\n   119\t/// identical memory layout.\n   120\t#[repr(C)]\n   121\t#[derive(Copy, Clone, Default)]\n   122\tpub struct c2Simplex {\n   123\t    pub verts: [c2sv; 4],\n   124\t    pub div: f32,\n   125\t    pub count: c_int,\n   126\t}\n   127\t\n   128\t// ---------------------------------------------------------------------------\n   129\t// Constants used verbatim by the C source\n   130\t// ---------------------------------------------------------------------------\n   131\t\n   132\t/// 3.40282346638528859811704183484516925e+38F (FLT_MAX)\n   133\tconst C2_FLT_MAX: f32 = 3.402_823_466_385_288_598_117_041_834_845_169_25e+38;\n   134\t/// 1.19209289550781250000000000000000000e-7F (FLT_EPSILON)\n   135\tconst C2_FLT_EPSILON: f32 = 1.192_092_895_507_812_5e-7;\n   136\t\n   137\t// ---------------------------------------------------------------------------\n   138\t// Vector helpers\n   139\t// ---------------------------------------------------------------------------\n   140\t\n   141\t#[unsafe(no_mangle)]\n   142\tpub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n   143\t    c2v { x, y }\n   144\t}\n   145\t\n   146\t#[unsafe(no_mangle)]\n   147\tpub extern \"C\" fn c2Mulvs(a: c2v, b: f32) -> c2v {\n   148\t    let mut a = a;\n   149\t    a.x *= b;\n   150\t    a.y *= b;\n   151\t    a\n   152\t}\n   153\t\n   154\t#[unsafe(no_mangle)]\n   155\tpub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n   156\t    // Reproduce the C ternaries exactly (NaN falls through to `b`).\n   157\t    c2V(\n   158\t        if a.x > b.x { a.x } else { b.x },\n   159\t        if a.y > b.y { a.y } else { b.y },\n   160\t    )\n   161\t}\n   162\t\n   163\t#[unsafe(no_mangle)]\n   164\tpub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n   165\t    c2V(\n   166\t        if a.x < b.x { a.x } else { b.x },\n   167\t        if a.y < b.y { a.y } else { b.y },\n   168\t    )\n   169\t}\n   170\t\n   171\t#[unsafe(no_mangle)]\n   172\tpub extern \"C\" fn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n   173\t    c2Maxv(lo, c2Minv(a, hi))\n   174\t}\n   175\t\n   176\t#[unsafe(no_mangle)]\n   177\tpub extern \"C\" fn c2Sub(a: c2v, b: c2v) -> c2v {\n   178\t    let mut a = a;\n   179\t    a.x -= b.x;\n   180\t    a.y -= b.y;\n   181\t    a\n   182\t}\n   183\t\n   184\t#[unsafe(no_mangle)]\n   185\tpub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n   186\t    a.x * b.x + a.y * b.y\n   187\t}\n   188\t\n   189\t#[unsafe(no_mangle)]\n   190\tpub extern \"C\" fn c2RotIdentity() -> c2r {\n   191\t    c2r { c: 1.0f32, s: 0.0 }\n   192\t}\n   193\t\n   194\t#[unsafe(no_mangle)]\n   195\tpub extern \"C\" fn c2xIdentity() -> c2x {\n   196\t    c2x {\n   197\t        p: c2V(0.0, 0.0),\n   198\t        r: c2RotIdentity(),\n   199\t    }\n   200\t}\n   201\t\n   202\t#[unsafe(no_mangle)]\n   203\tpub unsafe extern \"C\" fn c2BBVerts(out: *mut c2v, bb: *mut c2AABB) {\n   204\t    let bb = &*bb;\n   205\t    *out.add(0) = bb.min;\n   206\t    *out.add(1) = c2V(bb.max.x, bb.min.y);\n   207\t    *out.add(2) = bb.max;\n   208\t    *out.add(3) = c2V(bb.min.x, bb.max.y);\n   209\t}\n   210\t\n   211\t#[unsafe(no_mangle)]\n   212\tpub unsafe extern \"C\" fn c2MakeProxy(shape: *const c_void, type_: C2_TYPE, p: *mut c2Proxy) {\n   213\t    match type_ {\n   214\t        C2_TYPE_CIRCLE => {\n   215\t            let c = shape as *const c2Circle;\n   216\t            (*p).radius = (*c).r;\n   217\t            (*p).count = 1;\n   218\t            (*p).verts[0] = (*c).p;\n   219\t        }\n   220\t        C2_TYPE_AABB => {\n   221\t            let bb = shape as *mut c2AABB;\n   222\t            (*p).radius = 0.0;\n   223\t            (*p).count = 4;\n   224\t            c2BBVerts((*p).verts.as_mut_ptr(), bb);\n   225\t        }\n   226\t        C2_TYPE_CAPSULE => {\n   227\t            let c = shape as *const c2Capsule;\n   228\t            (*p).radius = (*c).r;\n   229\t            (*p).count = 2;\n   230\t            (*p).verts[0] = (*c).a;\n   231\t            (*p).verts[1] = (*c).b;\n   232\t        }\n   233\t        // No `default:` label in the C switch: nothing happens.\n   234\t        _ => {}\n   235\t    }\n   236\t}\n   237\t\n   238\t#[unsafe(no_mangle)]\n   239\tpub extern \"C\" fn c2Len(a: c2v) -> f32 {\n   240\t    c2Dot(a, a).sqrt()\n   241\t}\n   242\t\n   243\t#[unsafe(no_mangle)]\n   244\tpub extern \"C\" fn c2Det2(a: c2v, b: c2v) -> f32 {\n   245\t    a.x * b.y - a.y * b.x\n   246\t}\n   247\t\n   248\t#[unsafe(no_mangle)]\n   249\tpub unsafe extern \"C\" fn c2GJKSimplexMetric(s: *mut c2Simplex) -> f32 {\n   250\t    let s = &*s;\n   251\t    match s.count {\n   252\t        2 => c2Len(c2Sub(s.verts[1].p, s.verts[0].p)),\n   253\t        3 => c2Det2(\n   254\t            c2Sub(s.verts[1].p, s.verts[0].p),\n   255\t            c2Sub(s.verts[2].p, s.verts[0].p),\n   256\t        ),\n   257\t        // `default:` falls through into `case 1:` in the C source.\n   258\t        _ => 0.0,\n   259\t    }\n   260\t}\n   261\t\n   262\t#[unsafe(no_mangle)]\n   263\tpub extern \"C\" fn c2Mulrv(a: c2r, b: c2v) -> c2v {\n   264\t    c2V(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)\n   265\t}\n   266\t\n   267\t#[unsafe(no_mangle)]\n   268\tpub extern \"C\" fn c2Add(a: c2v, b: c2v) -> c2v {\n   269\t    let mut a = a;\n   270\t    a.x += b.x;\n   271\t    a.y += b.y;\n   272\t    a\n   273\t}\n   274\t\n   275\t#[unsafe(no_mangle)]\n   276\tpub extern \"C\" fn c2Mulxv(a: c2x, b: c2v) -> c2v {\n   277\t    c2Add(c2Mulrv(a.r, b), a.p)\n   278\t}\n   279\t\n   280\t// ---------------------------------------------------------------------------\n   281\t// Simplex solvers\n   282\t// ---------------------------------------------------------------------------\n   283\t\n   284\t#[unsafe(no_mangle)]\n   285\tpub unsafe extern \"C\" fn c22(s: *mut c2Simplex) {\n   286\t    let s = &mut *s;\n   287\t    let a = s.verts[0].p;\n   288\t    let b = s.verts[1].p;\n   289\t    let u = c2Dot(b, c2Sub(b, a));\n   290\t    let v = c2Dot(a, c2Sub(a, b));\n   291\t    if v <= 0.0 {\n   292\t        s.verts[0].u = 1.0f32;\n   293\t        s.div = 1.0f32;\n   294\t        s.count = 1;\n   295\t    } else if u <= 0.0 {\n   296\t        s.verts[0] = s.verts[1];\n   297\t        s.verts[0].u = 1.0f32;\n   298\t        s.div = 1.0f32;\n   299\t        s.count = 1;\n   300\t    } else {\n   301\t        s.verts[0].u = u;\n   302\t        s.verts[1].u = v;\n   303\t        s.div = u + v;\n   304\t        s.count = 2;\n   305\t    }\n   306\t}\n   307\t\n   308\t#[unsafe(no_mangle)]\n   309\tpub unsafe extern \"C\" fn c23(s: *mut c2Simplex) {\n   310\t    let s = &mut *s;\n   311\t    let a = s.verts[0].p;\n   312\t    let b = s.verts[1].p;\n   313\t    let c = s.verts[2].p;\n   314\t    let uAB = c2Dot(b, c2Sub(b, a));\n   315\t    let vAB = c2Dot(a, c2Sub(a, b));\n   316\t    let uBC = c2Dot(c, c2Sub(c, b));\n   317\t    let vBC = c2Dot(b, c2Sub(b, c));\n   318\t    let uCA = c2Dot(a, c2Sub(a, c));\n   319\t    let vCA = c2Dot(c, c2Sub(c, a));\n   320\t    let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n   321\t    let uABC = c2Det2(b, c) * area;\n   322\t    let vABC = c2Det2(c, a) * area;\n   323\t    let wABC = c2Det2(a, b) * area;\n   324\t    if vAB <= 0.0 && uCA <= 0.0 {\n   325\t        s.verts[0].u = 1.0f32;\n   326\t        s.div = 1.0f32;\n   327\t        s.count = 1;\n   328\t    } else if uAB <= 0.0 && vBC <= 0.0 {\n   329\t        s.verts[0] = s.verts[1];\n   330\t        s.verts[0].u = 1.0f32;\n   331\t        s.div = 1.0f32;\n   332\t        s.count = 1;\n   333\t    } else if uBC <= 0.0 && vCA <= 0.0 {\n   334\t        s.verts[0] = s.verts[2];\n   335\t        s.verts[0].u = 1.0f32;\n   336\t        s.div = 1.0f32;\n   337\t        s.count = 1;\n   338\t    } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n   339\t        s.verts[0].u = uAB;\n   340\t        s.verts[1].u = vAB;\n   341\t        s.div = uAB + vAB;\n   342\t        s.count = 2;\n   343\t    } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n   344\t        s.verts[0] = s.verts[1];\n   345\t        s.verts[1] = s.verts[2];\n   346\t        s.verts[0].u = uBC;\n   347\t        s.verts[1].u = vBC;\n   348\t        s.div = uBC + vBC;\n   349\t        s.count = 2;\n   350\t    } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n   351\t        s.verts[1] = s.verts[0];\n   352\t        s.verts[0] = s.verts[2];\n   353\t        s.verts[0].u = uCA;\n   354\t        s.verts[1].u = vCA;\n   355\t        s.div = uCA + vCA;\n   356\t        s.count = 2;\n   357\t    } else {\n   358\t        s.verts[0].u = uABC;\n   359\t        s.verts[1].u = vABC;\n   360\t        s.verts[2].u = wABC;\n   361\t        s.div = uABC + vABC + wABC;\n   362\t        s.count = 3;\n   363\t    }\n   364\t}\n   365\t\n   366\t#[unsafe(no_mangle)]\n   367\tpub extern \"C\" fn c2Neg(a: c2v) -> c2v {\n   368\t    c2V(-a.x, -a.y)\n   369\t}\n   370\t\n   371\t#[unsafe(no_mangle)]\n   372\tpub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n   373\t    c2v { x: -a.y, y: a.x }\n   374\t}\n   375\t\n   376\t#[unsafe(no_mangle)]\n   377\tpub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n   378\t    c2v { x: a.y, y: -a.x }\n   379\t}\n   380\t\n   381\t#[unsafe(no_mangle)]\n   382\tpub unsafe extern \"C\" fn c2D(s: *mut c2Simplex) -> c2v {\n   383\t    let s = &*s;\n   384\t    match s.count {\n   385\t        1 => c2Neg(s.verts[0].p),\n   386\t        2 => {\n   387\t            let ab = c2Sub(s.verts[1].p, s.verts[0].p);\n   388\t            if c2Det2(ab, c2Neg(s.verts[0].p)) > 0.0 {\n   389\t                return c2Skew(ab);\n   390\t            }\n   391\t            c2CCW90(ab)\n   392\t        }\n   393\t        // case 3 / default\n   394\t        _ => c2V(0.0, 0.0),\n   395\t    }\n   396\t}\n   397\t\n   398\t#[unsafe(no_mangle)]\n   399\tpub unsafe extern \"C\" fn c2Support(verts: *const c2v, count: c_int, d: c2v) -> c_int {\n   400\t    let mut imax: c_int = 0;\n   401\t    let mut dmax = c2Dot(*verts.offset(0), d);\n   402\t    let mut i: c_int = 1;\n   403\t    while i < count {\n   404\t        let dot = c2Dot(*verts.offset(i as isize), d);\n   405\t        if dot > dmax {\n   406\t            imax = i;\n   407\t            dmax = dot;\n   408\t        }\n   409\t        i += 1;\n   410\t    }\n   411\t    imax\n   412\t}\n   413\t\n   414\t#[unsafe(no_mangle)]\n   415\tpub unsafe extern \"C\" fn c2Witness(s: *mut c2Simplex, a: *mut c2v, b: *mut c2v) {\n   416\t    let s = &*s;\n   417\t    let den = 1.0f32 / s.div;\n   418\t    match s.count {\n   419\t        1 => {\n   420\t            *a = s.verts[0].sA;\n   421\t            *b = s.verts[0].sB;\n   422\t        }\n   423\t        2 => {\n   424\t            *a = c2Add(\n   425\t                c2Mulvs(s.verts[0].sA, den * s.verts[0].u),\n   426\t                c2Mulvs(s.verts[1].sA, den * s.verts[1].u),\n   427\t            );\n   428\t            *b = c2Add(\n   429\t                c2Mulvs(s.verts[0].sB, den * s.verts[0].u),\n   430\t                c2Mulvs(s.verts[1].sB, den * s.verts[1].u),\n   431\t            );\n   432\t        }\n   433\t        3 => {\n   434\t            *a = c2Add(\n   435\t                c2Add(\n   436\t                    c2Mulvs(s.verts[0].sA, den * s.verts[0].u),\n   437\t                    c2Mulvs(s.verts[1].sA, den * s.verts[1].u),\n   438\t                ),\n   439\t                c2Mulvs(s.verts[2].sA, den * s.verts[2].u),\n   440\t            );\n   441\t            *b = c2Add(\n   442\t                c2Add(\n   443\t                    c2Mulvs(s.verts[0].sB, den * s.verts[0].u),\n   444\t                    c2Mulvs(s.verts[1].sB, den * s.verts[1].u),\n   445\t                ),\n   446\t                c2Mulvs(s.verts[2].sB, den * s.verts[2].u),\n   447\t            );\n   448\t        }\n   449\t        _ => {\n   450\t            *a = c2V(0.0, 0.0);\n   451\t            *b = c2V(0.0, 0.0);\n   452\t        }\n   453\t    }\n   454\t}\n   455\t\n   456\t#[unsafe(no_mangle)]\n   457\tpub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n   458\t    c2Mulvs(a, 1.0f32 / b)\n   459\t}\n   460\t\n   461\t#[unsafe(no_mangle)]\n   462\tpub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n   463\t    c2Div(a, c2Len(a))\n   464\t}\n   465\t\n   466\t#[unsafe(no_mangle)]\n   467\tpub unsafe extern \"C\" fn c2L(s: *mut c2Simplex) -> c2v {\n   468\t    let s = &*s;\n   469\t    let den = 1.0f32 / s.div;\n   470\t    match s.count {\n   471\t        1 => s.verts[0].p,\n   472\t        2 => c2Add(\n   473\t            c2Mulvs(s.verts[0].p, den * s.verts[0].u),\n   474\t            c2Mulvs(s.verts[1].p, den * s.verts[1].u),\n   475\t        ),\n   476\t        _ => c2V(0.0, 0.0),\n   477\t    }\n   478\t}\n   479\t\n   480\t#[unsafe(no_mangle)]\n   481\tpub extern \"C\" fn c2MulrvT(a: c2r, b: c2v) -> c2v {\n   482\t    c2V(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y)\n   483\t}\n   484\t\n   485\t// ---------------------------------------------------------------------------\n   486\t// GJK\n   487\t// ---------------------------------------------------------------------------\n   488\t\n   489\t#[unsafe(no_mangle)]\n   490\tpub unsafe extern \"C\" fn c2GJK(\n   491\t    A: *const c_void,\n   492\t    typeA: C2_TYPE,\n   493\t    ax_ptr: *const c2x,\n   494\t    B: *const c_void,\n   495\t    typeB: C2_TYPE,\n   496\t    bx_ptr: *const c2x,\n   497\t    outA: *mut c2v,\n   498\t    outB: *mut c2v,\n   499\t    use_radius: c_int,\n   500\t    iterations: *mut c_int,\n   501\t    cache: *mut c2GJKCache,\n   502\t) -> f32 {\n   503\t    let ax: c2x;\n   504\t    let bx: c2x;\n   505\t    if ax_ptr.is_null() {\n   506\t        ax = c2xIdentity();\n   507\t    } else {\n   508\t        ax = *ax_ptr;\n   509\t    }\n   510\t    if bx_ptr.is_null() {\n   511\t        bx = c2xIdentity();\n   512\t    } else {\n   513\t        bx = *bx_ptr;\n   514\t    }\n   515\t\n   516\t    let mut pA = c2Proxy::default();\n   517\t    let mut pB = c2Proxy::default();\n   518\t    c2MakeProxy(A, typeA, &mut pA);\n   519\t    c2MakeProxy(B, typeB, &mut pB);\n   520\t\n   521\t    let mut s = c2Simplex::default();\n   522\t    let sp: *mut c2Simplex = &mut s;\n   523\t\n   524\t    let mut cache_was_read: c_int = 0;\n   525\t    if !cache.is_null() {\n   526\t        let cache_was_good = (*cache).count != 0;\n   