r\n   149\t\tint count;\r\n   150\t} c2Simplex;\r\n   151\t\r\n   152\tfloat c2Len(c2v a) {\r\n   153\t\treturn sqrtf(c2Dot(a, a));\r\n   154\t}\r\n   155\t\r\n   156\tfloat c2Det2(c2v a, c2v b) {\r\n   157\t\treturn a.x * b.y - a.y * b.x;\r\n   158\t}\r\n   159\t\r\n   160\tfloat c2GJKSimplexMetric(c2Simplex *s) {\r\n   161\t\tswitch (s->count) {\r\n   162\t\t\tdefault:\r\n   163\t\t\tcase 1:\r\n   164\t\t\t\treturn 0;\r\n   165\t\t\tcase 2:\r\n   166\t\t\t\treturn c2Len(c2Sub(s->b.p, s->a.p));\r\n   167\t\t\tcase 3:\r\n   168\t\t\t\treturn c2Det2(c2Sub(s->b.p, s->a.p), c2Sub(s->c.p, s->a.p));\r\n   169\t\t}\r\n   170\t}\r\n   171\t\r\n   172\tc2v c2Mulrv(c2r a, c2v b) {\r\n   173\t\treturn c2V(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y);\r\n   174\t}\r\n   175\t\r\n   176\tc2v c2Add(c2v a, c2v b) {\r\n   177\t\ta.x += b.x;\r\n   178\t\ta.y += b.y;\r\n   179\t\treturn a;\r\n   180\t}\r\n   181\t\r\n   182\tc2v c2Mulxv(c2x a, c2v b) {\r\n   183\t\treturn c2Add(c2Mulrv(a.r, b), a.p);\r\n   184\t}\r\n   185\t\r\n   186\tvoid c22(c2Simplex *s) {\r\n   187\t\tc2v a = s->a.p;\r\n   188\t\tc2v b = s->b.p;\r\n   189\t\tfloat u = c2Dot(b, c2Sub(b, a));\r\n   190\t\tfloat v = c2Dot(a, c2Sub(a, b));\r\n   191\t\tif (v <= 0) {\r\n   192\t\t\ts->a.u = 1.0f;\r\n   193\t\t\ts->div = 1.0f;\r\n   194\t\t\ts->count = 1;\r\n   195\t\t} else if (u <= 0) {\r\n   196\t\t\ts->a = s->b;\r\n   197\t\t\ts->a.u = 1.0f;\r\n   198\t\t\ts->div = 1.0f;\r\n   199\t\t\ts->count = 1;\r\n   200\t\t} else {\r\n   201\t\t\ts->a.u = u;\r\n   202\t\t\ts->b.u = v;\r\n   203\t\t\ts->div = u + v;\r\n   204\t\t\ts->count = 2;\r\n   205\t\t}\r\n   206\t}\r\n   207\t\r\n   208\tvoid c23(c2Simplex *s) {\r\n   209\t\tc2v a = s->a.p;\r\n   210\t\tc2v b = s->b.p;\r\n   211\t\tc2v c = s->c.p;\r\n   212\t\tfloat uAB = c2Dot(b, c2Sub(b, a));\r\n   213\t\tfloat vAB = c2Dot(a, c2Sub(a, b));\r\n   214\t\tfloat uBC = c2Dot(c, c2Sub(c, b));\r\n   215\t\tfloat vBC = c2Dot(b, c2Sub(b, c));\r\n   216\t\tfloat uCA = c2Dot(a, c2Sub(a, c));\r\n   217\t\tfloat vCA = c2Dot(c, c2Sub(c, a));\r\n   218\t\tfloat area = c2Det2(c2Sub(b, a), c2Sub(c, a));\r\n   219\t\tfloat uABC = c2Det2(b, c) * area;\r\n   220\t\tfloat vABC = c2Det2(c, a) * area;\r\n   221\t\tfloat wABC = c2Det2(a, b) * area;\r\n   222\t\tif (vAB <= 0 && uCA <= 0) {\r\n   223\t\t\ts->a.u = 1.0f;\r\n   224\t\t\ts->div = 1.0f;\r\n   225\t\t\ts->count = 1;\r\n   226\t\t} else if (uAB <= 0 && vBC <= 0) {\r\n   227\t\t\ts->a = s->b;\r\n   228\t\t\ts->a.u = 1.0f;\r\n   229\t\t\ts->div = 1.0f;\r\n   230\t\t\ts->count = 1;\r\n   231\t\t} else if (uBC <= 0 && vCA <= 0) {\r\n   232\t\t\ts->a = s->c;\r\n   233\t\t\ts->a.u = 1.0f;\r\n   234\t\t\ts->div = 1.0f;\r\n   235\t\t\ts->count = 1;\r\n   236\t\t} else if (uAB > 0 && vAB > 0 && wABC <= 0) {\r\n   237\t\t\ts->a.u = uAB;\r\n   238\t\t\ts->b.u = vAB;\r\n   239\t\t\ts->div = uAB + vAB;\r\n   240\t\t\ts->count = 2;\r\n   241\t\t} else if (uBC > 0 && vBC > 0 && uABC <= 0) {\r\n   242\t\t\ts->a = s->b;\r\n   243\t\t\ts->b = s->c;\r\n   244\t\t\ts->a.u = uBC;\r\n   245\t\t\ts->b.u = vBC;\r\n   246\t\t\ts->div = uBC + vBC;\r\n   247\t\t\ts->count = 2;\r\n   248\t\t} else if (uCA > 0 && vCA > 0 && vABC <= 0) {\r\n   249\t\t\ts->b = s->a;\r\n   250\t\t\ts->a = s->c;\r\n   251\t\t\ts->a.u = uCA;\r\n   252\t\t\ts->b.u = vCA;\r\n   253\t\t\ts->div = uCA + vCA;\r\n   254\t\t\ts->count = 2;\r\n   255\t\t} else {\r\n   256\t\t\ts->a.u = uABC;\r\n   257\t\t\ts->b.u = vABC;\r\n   258\t\t\ts->c.u = wABC;\r\n   259\t\t\ts->div = uABC + vABC + wABC;\r\n   260\t\t\ts->count = 3;\r\n   261\t\t}\r\n   262\t}\r\n   263\t\r\n   264\tc2v c2Neg(c2v a) {\r\n   265\t\treturn c2V(-a.x, -a.y);\r\n   266\t}\r\n   267\t\r\n   268\tc2v c2Skew(c2v a) {\r\n   269\t\tc2v b;\r\n   270\t\tb.x = -a.y;\r\n   271\t\tb.y = a.x;\r\n   272\t\treturn b;\r\n   273\t}\r\n   274\t\r\n   275\tc2v c2CCW90(c2v a) {\r\n   276\t\tc2v b;\r\n   277\t\tb.x = a.y;\r\n   278\t\tb.y = -a.x;\r\n   279\t\treturn b;\r\n   280\t}\r\n   281\t\r\n   282\tc2v c2D(c2Simplex *s) {\r\n   283\t\tswitch (s->count) {\r\n   284\t\t\tcase 1:\r\n   285\t\t\t\treturn c2Neg(s->a.p);\r\n   286\t\t\tcase 2: {\r\n   287\t\t\t\t\tc2v ab = c2Sub(s->b.p, s->a.p);\r\n   288\t\t\t\t\tif (c2Det2(ab, c2Neg(s->a.p)) > 0)\r\n   289\t\t\t\t\t\treturn c2Skew(ab);\r\n   290\t\t\t\t\treturn c2CCW90(ab);\r\n   291\t\t\t\t}\r\n   292\t\t\tcase 3:\r\n   293\t\t\tdefault:\r\n   294\t\t\t\treturn c2V(0, 0);\r\n   295\t\t}\r\n   296\t}\r\n   297\t\r\n   298\tint c2Support(const c2v *verts, int count, c2v d) {\r\n   299\t\tint imax = 0;\r\n   300\t\tfloat dmax = c2Dot(verts[0], d);\r\n   301\t\tfor (int i = 1; i < count; ++i) {\r\n   302\t\t\tfloat dot = c2Dot(verts[i], d);\r\n   303\t\t\tif (dot > dmax) {\r\n   304\t\t\t\timax = i;\r\n   305\t\t\t\tdmax = dot;\r\n   306\t\t\t}\r\n   307\t\t}\r\n   308\t\treturn imax;\r\n   309\t}\r\n   310\t\r\n   311\tvoid c2Witness(c2Simplex *s, c2v *a, c2v *b) {\r\n   312\t\tfloat den = 1.0f / s->div;\r\n   313\t\tswitch (s->count) {\r\n   314\t\t\tcase 1:\r\n   315\t\t\t\t*a = s->a.sA;\r\n   316\t\t\t\t*b = s->a.sB;\r\n   317\t\t\t\tbreak;\r\n   318\t\t\tcase 2:\r\n   319\t\t\t\t*a = c2Add(c2Mulvs(s->a.sA, (den * s->a.u)),\r\n   320\t\t\t\t\t\tc2Mulvs(s->b.sA, (den * s->b.u)));\r\n   321\t\t\t\t*b = c2Add(c2Mulvs(s->a.sB, (den * s->a.u)),\r\n   322\t\t\t\t\t\tc2Mulvs(s->b.sB, (den * s->b.u)));\r\n   323\t\t\t\tbreak;\r\n   324\t\t\tcase 3:\r\n   325\t\t\t\t*a = c2Add(c2Add(c2Mulvs(s->a.sA, (den * s->a.u)),\r\n   326\t\t\t\t\t\t\tc2Mulvs(s->b.sA, (den * s->b.u))),\r\n   327\t\t\t\t\t\tc2Mulvs(s->c.sA, (den * s->c.u)));\r\n   328\t\t\t\t*b = c2Add(c2Add(c2Mulvs(s->a.sB, (den * s->a.u)),\r\n   329\t\t\t\t\t\t\tc2Mulvs(s->b.sB, (den * s->b.u))),\r\n   330\t\t\t\t\t\tc2Mulvs(s->c.sB, (den * s->c.u)));\r\n   331\t\t\t\tbreak;\r\n   332\t\t\tdefault:\r\n   333\t\t\t\t*a = c2V(0, 0);\r\n   334\t\t\t\t*b = c2V(0, 0);\r\n   335\t\t}\r\n   336\t}\r\n   337\t\r\n   338\tc2v c2Div(c2v a, float b) {\r\n   339\t\treturn c2Mulvs(a, 1.0f / b);\r\n   340\t}\r\n   341\t\r\n   342\tc2v c2Norm(c2v a) {\r\n   343\t\treturn c2Div(a, c2Len(a));\r\n   344\t}\r\n   345\t\r\n   346\tc2v c2L(c2Simplex *s) {\r\n   347\t    float den = 1.0f / s->div;\r\n   348\t    switch (s->count) {\r\n   349\t    case 1:\r\n   350\t        return s->a.p;\r\n   351\t    case 2:\r\n   352\t        return c2Add(c2Mulvs(s->a.p, (den * s->a.u)),\r\n   353\t                     c2Mulvs(s->b.p, (den * s->b.u)));\r\n   354\t    default:\r\n   355\t        return c2V(0, 0);\r\n   356\t    }\r\n   357\t}\r\n   358\t\r\n   359\tc2v c2MulrvT(c2r a, c2v b) {\r\n   360\t    return c2V(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y);\r\n   361\t}\r\n   362\t\r\n   363\tfloat c2GJK(const void *A, C2_TYPE typeA, const c2x *ax_ptr, const void *B,\r\n   364\t\t\tC2_TYPE typeB, const c2x *bx_ptr, c2v *outA, c2v *outB,\r\n   365\t\t\tint use_radius, int *iterations, c2GJKCache *cache) {\r\n   366\t\tc2x ax;\r\n   367\t\tc2x bx;\r\n   368\t\tif (!ax_ptr)\r\n   369\t\t\tax = c2xIdentity();\r\n   370\t\telse\r\n   371\t\t\tax = *ax_ptr;\r\n   372\t\tif (!bx_ptr)\r\n   373\t\t\tbx = c2xIdentity();\r\n   374\t\telse\r\n   375\t\t\tbx = *bx_ptr;\r\n   376\t\tc2Proxy pA;\r\n   377\t\tc2Proxy pB;\r\n   378\t\tc2MakeProxy(A, typeA, &pA);\r\n   379\t\tc2MakeProxy(B, typeB, &pB);\r\n   380\t\tc2Simplex s;\r\n   381\t\tc2sv *verts = &s.a;\r\n   382\t\tint cache_was_read = 0;\r\n   383\t\tif (cache) {\r\n   384\t\t\tint cache_was_good = !!cache->count;\r\n   385\t\t\tif (cache_was_good) {\r\n   386\t\t\t\tfor (int i = 0; i < cache->count; ++i) {\r\n   387\t\t\t\t\tint iA = cache->iA[i];\r\n   388\t\t\t\t\tint iB = cache->iB[i];\r\n   389\t\t\t\t\tc2v sA = c2Mulxv(ax, pA.verts[iA]);\r\n   390\t\t\t\t\tc2v sB = c2Mulxv(bx, pB.verts[iB]);\r\n   391\t\t\t\t\tc2sv *v = verts + i;\r\n   392\t\t\t\t\tv->iA = iA;\r\n   393\t\t\t\t\tv->sA = sA;\r\n   394\t\t\t\t\tv->iB = iB;\r\n   395\t\t\t\t\tv->sB = sB;\r\n   396\t\t\t\t\tv->p = c2Sub(v->sB, v->sA);\r