in`\n/// is one of its exported symbols; it is mirrored here for symbol parity.\n#[no_mangle]\npub extern \"C\" fn main() -> c_int {\n    driver::c_main()\n}\n","structuredPatch":[{"oldStart":146,"oldLines":6,"newStart":146,"newLines":12,"lines":[" ///"," /// The C translation unit is compiled into the shared object as-is, so `main`"," /// is one of its exported symbols; it is mirrored here for symbol parity.","+///","+/// `#[cfg(not(test))]`: when the library target is compiled as a *test*","+/// harness, that harness generates its own entry point and the linker would","+/// reject the duplicate `main`.  The `cdylib` (what the tests dlopen) is always","+/// built without `test`, so it does export the symbol.","+#[cfg(not(test))]"," #[no_mangle]"," pub extern \"C\" fn main() -> c_int {","     driver::c_main()"]}],"userModified":false,"replaceAll":false}}
