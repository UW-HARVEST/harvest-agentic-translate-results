"i\"]),(\"stb_perlin_fbm_noise3\",[\"f\"]*5+[\"i\"]),(\"stb_perlin_turbulence_noise3\",[\"f\"]*5+[\"i\"])]:\n    cf=geti(C,name,params); rf=geti(R,name,params)\n    d2=[]\n    for i in range(20000):\n        args=[]\n        for p in params[:-1]:\n            k=random.randrange(5)\n            if k==0: args.append(f32(random.choice(nan_pats)))\n            elif k==1: args.append(f32(random.getrandbits(32)))\n            elif k==2: args.append(random.uniform(-4,4))\n            elif k==3: args.append(random.choice([0.0,1.0,2.0,0.5,-2.0,1e30]))\n            else: args.append(float(random.randrange(-50,50))+0.25)\n        oc=random.choice([0,1,2,3,6,8,-1,17])\n        cv=cf(*args,oc); rv=rf(*args,oc)\n        if bits(cv)!=bits(rv): d2.append((tuple(hex(bits(a)) for a in args),oc,hex(bits(cv)),hex(bits(rv))))\n    print(f\"{name}: {len(d2)}/20000 diffs\")\n    for d in d2[:6]: print(\"  \",d)\nEOF","description":"Re-sweep NaN cases after fix"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4828,"cache_read_input_tokens":183795,"cache_creation":{"ephemeral_5m_input_tokens":4828,"ephemeral_1h_input_tokens":0},"output_tokens":20,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"eab2f7b9-57d5-4ef1-afe3-e4bea75ae637","uuid":"38382996-030a-4938-a320-8a444cb4e4c3","timestamp":"2026-08-19T09:39:14.552Z"}
