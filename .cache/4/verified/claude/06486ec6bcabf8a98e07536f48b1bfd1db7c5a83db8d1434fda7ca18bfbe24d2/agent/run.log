 = (d.rs.json_vpack_ex)(std::ptr::null_mut(), 0, root_fmt.as_ptr(), ra.build());\n        for f in [\" \", \",\", \"{!\", \"[!\", \"{s:\", \"@\"] {\n            let fmt = cs(f);\n            let mut ce = json_error_t::new();\n            let mut re = json_error_t::new();\n            let mut out: i32 = 0;\n            let mut cv = VaArgs::new().ptr(k.as_ptr()).ptr_mut(&mut out as *mut i32);\n            let cr = (d.c.json_vunpack_ex)(croot, &mut ce, 0, fmt.as_ptr(), cv.build());\n            let mut rv = VaArgs::new().ptr(k.as_ptr()).ptr_mut(&mut out as *mut i32);\n            let rr = (d.rs.json_vunpack_ex)(rroot, &mut re, 0, fmt.as_ptr(), rv.build());\n            println!(\n                \"unpack {:?}: c={} r={}\\n  C   text={:?}\\n  RUST text={:?}\\n  same_raw={}\",\n                f,\n                cr,\n                rr,\n                &ce.text[..40],\n                &re.text[..40],\n                ce.raw() == re.raw()\n            );\n        }\n        decref(&d.c, croot);\n        decref(&d.rs, rroot);\n    }\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
