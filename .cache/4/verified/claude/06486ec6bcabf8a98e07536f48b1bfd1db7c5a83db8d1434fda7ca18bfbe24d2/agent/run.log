{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01W3YLjTUAxhUK8kdfRyJMJu","type":"tool_result","content":"1\t//! Minimal declarations of the C library functions used by the translation.\n2\t//! Using the platform C library guarantees byte-identical formatting and\n3\t//! numeric conversion behaviour.\n4\t#![allow(dead_code)]\n5\t#![allow(non_camel_case_types)]\n6\t\n7\tuse std::ffi::{c_char, c_int, c_long, c_void};\n8\t\n9\t#[repr(C)]\n10\tpub struct FILE {\n11\t    _private: [u8; 0],\n12\t}\n13\t\n14\t/* x86-64 SysV va_list */\n15\t#[repr(C)]\n16\t#[derive(Copy, Clone)]\n17\tpub struct VaListTag {\n18\t    pub gp_offset: u32,\n19\t    pub fp_offset: u32,\n20\t    pub overflow_arg_area: *mut c_void,\n21\t    pub reg_save_area: *mut c_void,\n22\t}\n23\t\n24\tpub type va_list = *mut VaListTag;\n25\t\n26\t#[inline]\n27\tpub unsafe fn va_arg_gp<T: Copy>(ap: va_list) -> T {\n28\t    debug_assert!(std::mem::size_of::<T>() <= 8);\n29\t    let p: *mut u8;\n30\t    if (*ap).gp_offset <= 48 - 8 {\n31\t        p = ((*ap).reg_save_area as *mut u8).add((*ap).gp_offset as usize);\n32\t        (*ap).gp_offset += 8;\n33\t    } else {\n34\t        p = (*ap).overflow_arg_area as *mut u8;\n35\t        (*ap).overflow_arg_area = p.add(8) as *mut c_void;\n36\t    }\n37\t    std::ptr::read_unaligned(p as *const T)\n38\t}\n39\t\n40\t#[inline]\n41\tpub unsafe fn va_arg_fp(ap: va_list) -> f64 {\n42\t    let p: *mut u8;\n43\t    if (*ap).fp_offset <= 176 - 16 {\n44\t        p = ((*ap).reg_save_area as *mut u8).add((*ap).fp_offset as usize);\n45\t        (*ap).fp_offset += 16;\n46\t    } else {\n47\t        p = (*ap).overflow_arg_area as *mut u8;\n48\t        (*ap).overflow_arg_area = p.add(8) as *mut c_void;\n49\t    }\n50\t    std::ptr::read_unaligned(p as *const f64)\n51\t}\n52\t\n53\t/* A copy of a va_list value (C's va_copy on x86-64 copies the struct). */\n54\t#[inline]\n55\tpub unsafe fn va_copy(ap: va_list, dst: *mut VaListTag) -> va_list {\n56\t    *dst = *ap;\n57\t    dst\n58\t}\n59\t\n60\textern \"C\" {\n61\t    pub fn malloc(size: usize) -> *mut c_void;\n62\t    pub fn realloc(ptr: *mut c_void, size: usize) -> *mut c_void;\n63\t    pub fn free(ptr: *mut c_void);\n64\t\n65\t    pub fn memcpy(dst: *mut c_void, src: *const c_void, n: usize) -> *mut c_void;\n66\t    pub fn memmove(dst: *mut c_void, src: *const c_void, n: usize) -> *mut c_void;\n67\t    pub fn memcmp(a: *const c_void, b: *const c_void, n: usize) -> c_int;\n68\t    pub fn memchr(s: *const c_void, c: c_int, n: usize) -> *mut c_void;\n69\t    pub fn memset(s: *mut c_void, c: c_int, n: usize) -> *mut c_void;\n70\t    pub fn strlen(s: *const c_char) -> usize;\n71\t    pub fn strcmp(a: *const c_char, b: *const c_char) -> c_int;\n72\t    pub fn strchr(s: *const c_char, c: c_int) -> *mut c_char;\n73\t    pub fn strncpy(dst: *mut c_char, src: *const c_char, n: usize) -> *mut c_char;\n74\t    pub fn strerror(errnum: c_int) -> *mut c_char;\n75\t    pub fn strtoll(s: *const c_char, endptr: *mut *mut c_char, base: c_int) -> i64;\n76\t    pub fn strtod(s: *const c_char, endptr: *mut *mut c_char) -> f64;\n77\t\n78\t    pub fn snprintf(buf: *mut c_char, size: usize, fmt: *const c_char, ...) -> c_int;\n79\t    pub fn sprintf(buf: *mut c_char, fmt: *const c_char, ...) -> c_int;\n80\t    pub fn vsnprintf(buf: *mut c_char, size: usize, fmt: *const c_char, ap: va_list) -> c_int;\n81\t\n82\t    pub fn fopen(path: *const c_char, mode: *const c_char) -> *mut FILE;\n83\t    pub fn fclose(f: *mut FILE) -> c_int;\n84\t    pub fn fwrite(ptr: *const c_void, size: usize, nmemb: usize, f: *mut FILE) -> usize;\n85\t    pub fn fgetc(f: *mut FILE) -> c_int;\n86\t\n87\t    pub fn read(fd: c_int, buf: *mut c_void, count: usize) -> isize;\n88\t    pub fn write(fd: c_int, buf: *const c_void, count: usize) -> isize;\n89\t    pub fn open(path: *const c_char, flags: c_int, ...) -> c_int;\n90\t    pub fn close(fd: c_int) -> c_int;\n91\t\n92\t    pub fn qsort(\n93\t        base: *mut c_void,\n94\t        nmemb: usize,\n95\t        size: usize,\n96\t        compar: unsafe extern \"C\" fn(*const c_void, *const c_void) -> c_int,\n97\t    );\n98\t\n99\t    pub fn getpid() -> c_int;\n100\t    pub fn sched_yield() -> c_int;\n101\t    pub fn gettimeofday(tv: *mut timeval, tz: *mut c_void) -> c_int;\n102\t\n103\t    pub fn __errno_location() -> *mut c_int;\n104\t\n105\t    pub static stdin: *mut FILE;\n106\t}\n107\t\n108\t#[repr(C)]\n109\tpub struct timeval {\n110\t    pub tv_sec: c_long,\n111\t    pub tv_usec: c_long,\n112\t}\n113\t\n114\tpub const EOF: c_int = -1;\n115\tpub const ERANGE: c_int = 34;\n116\tpub const O_RDONLY: c_int = 0;\n117\tpub const STDIN_FILENO: c_int = 0;\n118\tpub const HUGE_VAL: f64 = f64::INFINITY;\n119\t\n120\t#[inline]\n121\tpub unsafe fn errno() -> c_int {\n122\t    *__errno_location()\n123\t}\n124\t\n125\t#[inline]\n126\tpub unsafe fn set_errno(v: c_int) {\n127\t    *__errno_location() = v;\n128\t}\n129\t"}]},"parent_tool_use_id":null,"session_id":"0aaf00f6-473d-4ae1-b7a7-2a8b9811f369","uuid":"a319ffe7-aaea-433d-a307-437b83f44e72","timestamp":"2026-08-23T00:25:58.325Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-hjHD91/translated_rust/src/libc.rs","content":"//! Minimal declarations of the C library functions used by the translation.\n//! Using the platform C library guarantees byte-identical formatting and\n//! numeric conversion behaviour.\n#![allow(dead_code)]\n#![allow(non_camel_case_types)]\n\nuse std::ffi::{c_char, c_int, c_long, c_void};\n\n#[repr(C)]\npub struct FILE {\n    _private: [u8; 0],\n}\n\n/* x86-64 SysV va_list */\n#[repr(C)]\n#[derive(Copy, Clone)]\npub struct VaListTag {\n    pub gp_offset: u32,\n    pub fp_offset: u32,\n    pub overflow_arg_area: *mut c_void,\n    pub reg_save_area: *mut c_void,\n}\n\npub type va_list = *mut VaListTag;\n\n#[inline]\npub unsafe fn va_arg_gp<T: Copy>(ap: va_list) -> T {\n    debug_assert!(std::mem::size_of::<T>() <= 8);\n    let p: *mut u8;\n    if (*ap).gp_offset <= 48 - 8 {\n        p = ((*ap).reg_save_area as *mut u8).add((*ap).gp_offset as usize);\n        (*ap).gp_offset += 8;\n    } else {\n        p = (*ap).overflow_arg_area as *mut u8;\n        (*ap).overflow_arg_area = p.add(8) as *mut c_void;\n    }\n    std::ptr::read_unaligned(p as *const T)\n}\n\n#[inline]\npub unsafe fn va_arg_fp(ap: va_list) -> f64 {\n    let p: *mut u8;\n    if (*ap).fp_offset <= 176 - 16 {\n        p = ((*ap).reg_save_area as *mut u8).add((*ap).fp_offset as usize);\n        (*ap).fp_offset += 16;\n    } else {\n        p = (*ap).overflow_arg_area as *mut u8;\n        (*ap).overflow_arg_area = p.add(8) as *mut c_void;\n    }\n    std::ptr::read_unaligned(p as *const f64)\n}\n\n/* A copy of a va_list value (C's va_copy on x86-64 copies the struct). */\n#[inline]\npub unsafe fn va_copy(ap: va_list, dst: *mut VaListTag) -> va_list {\n    *dst = *ap;\n    dst\n}\n\nextern \"C\" {\n    pub fn malloc(size: usize) -> *mut c_void;\n    pub fn realloc(ptr: *mut c_void, size: usize) -> *mut c_void;\n    pub fn free(ptr: *mut c_void);\n\n    pub fn memcpy(dst: *mut c_void, src: *const c_void, n: usize) -> *mut c_void;\n    pub fn memmove(dst: *mut c_void, src: *const c_void, n: usize) -> *mut c_void;\n    pub fn memcmp(a: *const c_void, b: *const c_void, n: usize) -> c_int;\n    pub fn memchr(s: *const c_void, c: c_int, n: usize) -> *mut c_void;\n    pub fn memset(s: *mut c_void, c: c_int, n: usize) -> *mut c_void;\n    pub fn strlen(s: *const c_char) -> usize;\n    pub fn strcmp(a: *const c_char, b: *const c_char) -> c_int;\n    pub fn strchr(s: *const c_char, c: c_int) -> *mut c_char;\n    pub fn strncpy(dst: *mut c_char, src: *const c_char, n: usize) -> *mut c_char;\n    pub fn strerror(errnum: c_int) -> *mut c_char;\n    pub fn strtoll(s: *const c_char, endptr: *mut *mut c_char, base: c_int) -> i64;\n    pub fn strtod(s: *const c_char, endptr: *mut *mut c_char) -> f64;\n\n    pub fn snprintf(buf: *mut c_char, size: usize, fmt: *const c_char, ...) -> c_int;\n    pub fn sprintf(buf: *mut c_char, fmt: *const c_char, ...) -> c_int;\n    pub fn vsnprintf(buf: *mut c_char, size: usize, fmt: *const c_char, ap: va_list) -> c_int;\n\n    pub fn fopen(path: *const c_char, mode: *const c_char) -> *mut FILE;\n    pub fn fclose(f: *mut FILE) -> c_int;\n    pub fn fwrite(ptr: *const c_void, size: usize, nmemb: usize, f: *mut FILE) -> usize;\n    pub fn fgetc(f: *mut FILE) -> c_int;\n\n    pub fn read(fd: c_int, buf: *mut c_void, count: usize) -> isize;\n    pub fn write(fd: c_int, buf: *const c_void, count: usize) -> isize;\n    pub fn open(path: *const c_char, flags: c_int, ...) -> c_int;\n    pub fn close(fd: c_int) -> c_int;\n\n    pub fn qsort(\n        base: *mut c_void,\n        nmemb: usize,\n        size: usize,\n        compar: unsafe extern \"C\" fn(*const c_void, *const c_void) -> c_int,\n    );\n\n    pub fn getpid() -> c_int;\n    pub fn sched_yield() -> c_int;\n    pub fn gettimeofday(tv: *mut timeval, tz: *mut c_void) -> c_int;\n\n    pub fn __errno_location() -> *mut c_int;\n\n    pub static stdin: *mut FILE;\n}\n\n#[repr(C)]\npub struct timeval {\n    pub tv_sec: c_long,\n    pub tv_usec: c_long,\n}\n\npub const EOF: c_int = -1;\npub const ERANGE: c_int = 34;\npub const O_RDONLY: c_int = 0;\npub const STDIN_FILENO: c_int = 0;\npub const HUGE_VAL: f64 = f64::INFINITY;\n\n#[inline]\npub unsafe fn errno() -> c_int {\n    *__errno_location()\n}\n\n#[inline]\npub unsafe fn set_errno(v: c_int) {\n    *__errno_location() = v;\n}\n","numLines":129,"startLine":1,"totalLines":129}}}
