let mut tv = libc::timeval {\n64\t        tv_sec: 0,\n65\t        tv_usec: 0,\n66\t    };\n67\t    libc::gettimeofday(&mut tv, std::ptr::null_mut());\n68\t    *seed = (tv.tv_sec as u32) ^ (tv.tv_usec as u32);\n69\t\n70\t    *seed ^= libc::getpid() as u32;\n71\t\n72\t    0\n73\t}\n74\t\n75\tunsafe fn generate_seed() -> u32 {\n76\t    let mut seed: u32 = 0;\n77\t    let mut done = 0;\n78\t\n79\t    if seed_from_urandom(&mut seed) == 0 {\n80\t        done = 1;\n81\t    }\n82\t\n83\t    if done == 0 {\n84\t        /* Fall back to timestamp and PID if no better randomness is available */\n85\t        seed_from_timestamp_and_pid(&mut seed);\n86\t    }\n87\t\n88\t    /* Make sure the seed is never zero */\n89\t    if seed == 0 {\n90\t        seed = 1;\n91\t    }\n92\t\n93\t    seed\n94\t}\n95\t\n96\t#[unsafe(no_mangle)]\n97\tpub unsafe extern \"C\" fn json_object_seed(seed: usize) {\n98\t    let mut new_seed = seed as u32;\n99\t\n100\t    if get_hashtable_seed() == 0 {\n101\t        if seed_initialized_atomic().swap(1, Ordering::Relaxed) == 0 {\n102\t            /* Do the seeding ourselves */\n103\t            if new_seed == 0 {\n104\t                new_seed = generate_seed();\n105\t            }\n106\t\n107\t            seed_atomic().store(new_seed, Ordering::Release);\n108\t        } else {\n109\t            /* Wait for another thread to do the seeding */\n110\t            loop {\n111\t                libc::sched_yield();\n112\t                if seed_atomic().load(Ordering::Acquire) != 0 {\n113\t                    break;\n114\t                }\n115\t            }\n116\t        }\n117\t    }\n118\t}\n119\t"}]},"parent_tool_use_id":"toolu_bdrk_01EKktdTFVDzSmnHvauf8Hi4","session_id":"0aaf00f6-473d-4ae1-b7a7-2a8b9811f369","uuid":"733c032c-3304-4980-94cd-ccd40c8e48f9","timestamp":"2026-08-23T00:46:42.681Z","subagent_type":"general-purpose","task_description":"Write memory/error/version tests"}
