acter '%c'\\0\",\n664\t                token(s) as c_int\n665\t            );\n666\t            (*s).has_error = 1;\n667\t            std::ptr::null_mut()\n668\t        }\n669\t    }\n670\t}\n671\t\n672\tunsafe fn unpack_object(s: *mut scanner_t, root: *mut json_t, ap: va_list) -> c_int {\n673\t    let mut ret: c_int = -1;\n674\t    let mut strict: c_int = 0;\n675\t    let mut gotopt: c_int = 0;\n676\t\n677\t    /* Use a set (emulated by a hashtable) to check that all object\n678\t    keys are accessed. Checking that the correct number of keys\n679\t    were accessed is not enough, as the same key can be unpacked\n680\t    multiple times.\n681\t    */\n682\t    let mut key_set = hashtable_t::new();\n683\t\n684\t    if hashtable_init(&mut key_set) != 0 {\n685\t        set_error!(\n686\t            s,\n687\t            b\"<internal>\\0\",\n688\t            json_error_out_of_memory,\n689\t            b\"Out of memory\\0\"\n690\t        );\n691\t        return -1;\n692\t    }\n693\t\n694\t    'out: {\n695\t        if !root.is_null() && !json_is_object(root) {\n696\t            set_error!(\n697\t                s,\n698\t                b\"<validation>\\0\",\n699\t                json_error_wrong_type,\n700\t                b\"Expected object, got %s\\0\",\n701\t                type_name(root)\n702\t            );\n703\t            break 'out;\n704\t        }\n705\t        next_token(s);\n706\t\n707\t        while token(s) != b'}' as c_char {\n708\t            let key: *const c_char;\n709\t            let key_len: usize;\n710\t            let value: *mut json_t;\n711\t            let mut opt: c_int = 0;\n712\t\n713\t            if strict != 0 {\n714\t                set_error!(\n715\t                    s,\n716\t                    b\"<format>\\0\",\n717\t                    json_error_invalid_format,\n718\t                    b\"Expected '}' after '%c', got '%c'\\0\",\n719\t                    (if strict == 1 { b'!' } else { b'*' }) as c_int,\n720\t                    to