oken.line) {\n63\t        s->token = s->next_token;\n64\t        s->next_token.line = 0;\n65\t        return;\n66\t    }\n67\t\n68\t    if (!token(s) && !*s->fmt)\n69\t        return;\n70\t\n71\t    t = s->fmt;\n72\t    s->column++;\n73\t    s->pos++;\n74\t\n75\t    /* skip space and ignored chars */\n76\t    while (*t == ' ' || *t == '\\t' || *t == '\\n' || *t == ',' || *t == ':') {\n77\t        if (*t == '\\n') {\n78\t            s->line++;\n79\t            s->column = 1;\n80\t        } else\n81\t            s->column++;\n82\t\n83\t        s->pos++;\n84\t        t++;\n85\t    }\n86\t\n87\t    s->token.token = *t;\n88\t    s->token.line = s->line;\n89\t    s->token.column = s->column;\n90\t    s->token.pos = s->pos;\n91\t\n92\t    if (*t)\n93\t        t++;\n94\t    s->fmt = t;\n95\t}\n96\t\n97\tstatic void prev_token(scanner_t *s) {\n98\t    s->next_token = s->token;\n99\t    s->token = s->prev_token;\n100\t}\n101\t\n102\tstatic void set_error(scanner_t *s, const char *source, enum json_error_code code,\n103\t                      const char *fmt, ...) {\n104\t    va_list ap;\n105\t    va_start(ap, fmt);\n106\t\n107\t    jsonp_error_vset(s->error, s->token.line, s->token.column, s->token.pos, code, fmt,\n108\t                     ap);\n109\t\n110\t    jsonp_error_set_source(s->error, source);\n111\t\n112\t    va_end(ap);\n113\t}\n114\t\n115\tstatic json_t *pack(scanner_t *s, va_list *ap);\n116\t\n117\t/* ours will be set to 1 if jsonp_free() must be called for the result\n118\t   afterwards */\n119\tstatic char *read_string(scanner_t *s, va_list *ap, const char *purpose, size_t *out_len,\n120\t                         int *ours, int optional) {\n121\t    char t;\n122\t    strbuffer_t strbuff;\n123\t    const char *str;\n124\t    size_t length;\n125\t\n126\t    next_token(s);\n127\t    t = token(s);\n128\t    prev_token(s);\n129\t\n130\t    *ours = 0;\n131\t    if (t != '#' && t != '%' && t != '+') {\n132\t        /* Optimize the simple case */\n133\t        str = va_arg(*ap, const char *);\n134\t\n135\t        if (!str) {\n136\t            if (!optional) {\n137\t                set_error(s, \"<args>\", json_error_null_value, \"NULL %s\", purpose);\n138\t                s->has_error = 1;\n139\t            }\n140\t            return NULL;\n141\t        }\n142\t\n143\t        length = strlen(str);\n144\t\n145\t        if (!utf8_check_string(str, length)) {\n146\t            set_error(s, \"<args>\", json_error_invalid_utf8, \"Invalid UTF-8 %s\", purpose);\n147\t            s->has_error = 1;\n148\t            return NULL;\n149\t        }\n150\t\n151\t        *out_len = length;\n152\t        return (char *)str;\n153\t    } else if (optional) {\n154\t        set_error(s, \"<format>\", json_error_invalid_format,\n155\t                  \"Cannot use '%c' on optional strings\", t);\n156\t        s->has_error = 1;\n157\t\n158\t        return NULL;\n159\t    }\n160\t\n161\t    if (strbuffer_init(&strbuff)) {\n162\t        set_error(s, \"<internal>\", json_error_out_of_memory, \"Out of memory\");\n163\t        s->has_error = 1;\n164\t    }\n165\t\n166\t    while (1) {\n167\t        str = va_arg(*ap, const char *);\n168\t        if (!str) {\n169\t            set_error(s, \"<args>\", json_error_null_value, \"NULL %s\", purpose);\n170\t            s->has_error = 1;\n171\t        }\n172\t\n173\t        next_token(s);\n174\t\n175\t        if (token(s) == '#') {\n176\t            length = va_arg(*ap, int);\n177\t        } else if (token(s) == '%') {\n178\t            length = va_arg(*ap, size_t);\n179\t        } else {\n180\t            prev_token(s);\n181\t            length = s->has_error ? 0 : strlen(str);\n182\t        }\n183\t\n184\t        if (!s->has_error && strbuffer_append_bytes(&strbuff, str, length) == -1) {\n185\t            set_error(s, \"<internal>\", json_error_out_of_memory, \"Out of memory\");\n186\t            s->has_error = 1;\n187\t        }\n188\t\n189\t        next_token(s);\n190\t        if (token(s) != '+') {\n191\t    