{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_016RRmwqtr5jaDuvVNAtZoAi","type":"tool_result","content":"1\t//! Translation of c_src/src/pack_unpack.c\n2\t#![allow(dead_code)]\n3\t\n4\tuse crate::error::{jsonp_error_init, jsonp_error_set_1s, jsonp_error_set_source};\n5\tuse crate::hashtable::{hashtable_close, hashtable_get, hashtable_init, hashtable_set, hashtable_t};\n6\tuse crate::jansson::*;\n7\tuse crate::libc;\n8\tuse crate::libc::{va_arg_fp, va_arg_gp, va_list, VaListTag};\n9\tuse crate::memory::jsonp_free;\n10\tuse crate::strbuffer::*;\n11\tuse crate::utf::utf8_check_string;\n12\tuse crate::value::*;\n13\tuse std::ffi::{c_char, c_int, c_void};\n14\t\n15\t#[repr(C)]\n16\t#[derive(Copy, Clone)]\n17\tstruct token_t {\n18\t    line: c_int,\n19\t    column: c_int,\n20\t    pos: usize,\n21\t    token: c_char,\n22\t}\n23\t\n24\timpl token_t {\n25\t    const fn zero() -> token_t {\n26\t        token_t {\n27\t            line: 0,\n28\t            column: 0,\n29\t            pos: 0,\n30\t            token: 0,\n31\t        }\n32\t    }\n33\t}\n34\t\n35\t#[repr(C)]\n36\tstruct scanner_t {\n37\t    start: *const c_char,\n38\t    fmt: *const c_char,\n39\t    prev_token: token_t,\n40\t    token: token_t,\n41\t    next_token: token_t,\n42\t    error: *mut json_error_t,\n43\t    flags: usize,\n44\t    line: c_int,\n45\t    column: c_int,\n46\t    pos: usize,\n47\t    has_error: c_int,\n48\t}\n49\t\n50\t#[inline]\n51\tunsafe fn token(s: *const scanner_t) -> c_char {\n52\t    (*s).token.token\n53\t}\n54\t\n55\tstatic TYPE_NAMES: [&[u8]; 8] = [\n56\t    b\"object\\0\",\n57\t    b\"array\\0\",\n58\t    b\"string\\0\",\n59\t    b\"integer\\0\",\n60\t    b\"real\\0\",\n61\t    b\"true\\0\",\n62\t    b\"false\\0\",\n63\t    b\"null\\0\",\n64\t];\n65\t\n66\t#[inline]\n67\tunsafe fn type_name(x: *const json_t) -> *const c_char {\n68\t    TYPE_NAMES[json_typeof(x) as usize].as_ptr() as *const c_char\n69\t}\n70\t\n71\tstatic UNPACK_VALUE_STARTERS: &[u8; 12] = b\"{[siIbfFOon\\0\";\n72\t\n73\t/// Reproduces the json_object_keylen_foreach() macro from jansson.h.\n74\tmacro_rules! json_object_keylen_foreach {\n75\t    ($object:expr, $key:ident, $key_len:ident, $value:ident, $body:block) => {{\n76\t        let __obj = $object;\n77\t        #[allow(unused_mut)]\n78\t        let mut $key = json_object_iter_key(json_object_iter(__obj));\n79\t        #[allow(unused_mut)]\n80\t        let mut $key_len = json_object_iter_key_len(json_object_key_to_iter($key));\n81\t        #[allow(unused_mut, unused_assignments)]\n82\t        let mut $value: *mut json_t = std::ptr::null_mut();\n83\t        while !$key.is_null()\n84\t            && {\n85\t                $value = json_object_iter_value(json_object_key_to_iter($key));\n86\t                !$value.is_null()\n87\t            }\n88\t        {\n89\t            $body\n90\t            $key = json_object_iter_key(json_object_iter_next(\n91\t                __obj,\n92\t                json_object_key_to_iter($key),\n93\t            ));\n94\t            $key_len = json_object_iter_key_len(json_object_key_to_iter($key));\n95\t        }\n96\t    }};\n97\t}\n98\t\n99\tunsafe fn scanner_init(\n100\t    s: *mut scanner_t,\n101\t    error: *mut json_error_t,\n102\t    flags: usize,\n103\t    fmt: *const c_char,\n104\t) {\n105\t    (*s).error = error;\n106\t    (*s).flags = flags;\n107\t    (*s).start = fmt;\n108\t    (*s).fmt = fmt;\n109\t    (*s).prev_token = token_t::zero();\n110\t    (*s).token = token_t::zero();\n111\t    (*s).next_token = token_t::zero();\n112\t    (*s).line = 1;\n113\t    (*s).column = 0;\n114\t    (*s).pos = 0;\n115\t    (*s).has_error = 0;\n116\t}\n117\t\n118\tunsafe fn next_token(s: *mut scanner_t) {\n119\t    let mut t: *const c_char;\n120\t    (*s).prev_token = (*s).token;\n121\t\n122\t    if (*s).next_token.line != 0 {\n123\t        (*s).token = (*s).next_token;\n124\t        (*s).next_token.line = 0;\n125\t        return;\n126\t    }\n127\t\n128\t    if token(s) == 0 && *(*s).fmt == 0 {\n129\t        return;\n130\t    }\n131\t\n132\t    t = (*s).fmt;\n133\t    (*s).column += 1;\n134\t    (*s).pos += 1;\n135\t\n136\t    /* skip space and ignored chars */\n137\t    while *t == b' ' as c_char\n138\t        || *t == b'\\t' as c_char\n139\t        || *t == b'\\n' as c_char\n140\t        || *t == b',' as c_char\n141\t        || *t == b':' as c_char\n142\t    {\n143\t        if *t == b'\\n' as c_char {\n144\t            (*s).line += 1;\n145\t            (*s).column = 1;\n146\t        } else {\n147\t            (*s).column += 1;\n148\t        }\n149\t\n150\t        (*s).pos += 1;\n151\t        t = t.add(1);\n152\t    }\n153\t\n154\t    (*s).token.token = *t;\n155\t    (*s).token.line = (*s).line;\n156\t    (*s).token.column = (*s).column;\n157\t    (*s).token.pos = (*s).pos;\n158\t\n159\t    if *t != 0 {\n160\t        t = t.add(1);\n161\t    }\n162\t    (*s).fmt = t;\n163\t}\n164\t\n165\tunsafe fn prev_token(s: *mut scanner_t) {\n166\t    (*s).next_token = (*s).token;\n167\t    (*s).token = (*s).prev_token;\n168\t}\n169\t\n170\t/* set_error(): formats the message exactly like vsnprintf() into the error\n171\t   struct, then sets the source. */\n172\tmacro_rules! set_error {\n173\t    ($s:expr, $source:expr, $code:expr, $fmt:expr $(, $arg:expr)*) => {{\n174\t        let __s = $s;\n175\t        let mut __buf: [c_char; 512] = [0; 512];\n176\t        libc::snprintf(\n177\t            __buf.as_mut_ptr(),\n178\t            512,\n179\t            $fmt.as_ptr() as *const c_char\n180\t            $(, $arg)*\n181\t        );\n182\t        jsonp_error_set_1s(\n183\t            (*__s).error,\n184\t            (*__s).token.line,\n185\t            (*__s).token.column,\n186\t            (*__s).token.pos,\n187\t            $code,\n188\t            __buf.as_ptr(),\n189\t        );\n190\t        jsonp_error_set_source((*__s).error, $source.as_ptr() as *const c_char);\n191\t    }};\n192\t}\n193\t\n194\t/* ours will be set to 1 if jsonp_free() must be called for the result\n195\tafterwards */\n196\tunsafe fn read_string(\n197\t    s: *mut scanner_t,\n198\t    ap: va_list,\n199\t    purpose: *const c_char,\n200\t    out_len: *mut usize,\n201\t    ours: *mut c_int,\n202\t    optional: c_int,\n203\t) -> *mut c_char {\n204\t    let t: c_char;\n205\t    let mut strbuff = strbuffer_t::new();\n206\t    let mut str_: *const c_char;\n207\t    let mut length: usize;\n208\t\n209\t    next_token(s);\n210\t    t = token(s);\n211\t    prev_token(s);\n212\t\n213\t    *ours = 0;\n214\t    if t != b'#' as c_char && t != b'%' as c_char && t != b'+' as c_char {\n215\t        /* Optimize the simple case */\n216\t        str_ = va_arg_gp::<*const c_char>(ap);\n217\t\n218\t        if str_.is_null() {\n219\t            if optional == 0 {\n220\t                set_error!(\n221\t                    s,\n222\t                    b\"<args>\\0\",\n223\t                    json_error_null_value,\n224\t                    b\"NULL %s\\0\",\n225\t                    purpose\n226\t                );\n227\t                (*s).has_error = 1;\n228\t            }\n229\t            return std::ptr::null_mut();\n230\t        }\n231\t\n232\t        length = libc::strlen(str_);\n233\t\n234\t        if utf8_check_string(str_, length) == 0 {\n235\t            set_error!(\n236\t                s,\n237\t                b\"<args>\\0\",\n238\t                json_error_invalid_utf8,\n239\t                b\"Invalid UTF-8 %s\\0\",\n240\t                purpose\n241\t            );\n242\t            (*s).has_error = 1;\n243\t            return std::ptr::null_mut();\n244\t        }\n245\t\n246\t        *out_len = length;\n247\t        return str_ as *mut c_char;\n248\t    } else if optional != 0 {\n249\t        set_error!(\n250\t            s,\n251\t            b\"<format>\\0\",\n252\t            json_error_invalid_format,\n253\t            b\"Cannot use '%c' on optional strings\\0\",\n254\t            t as c_int\n255\t        );\n256\t        (*s).has_error = 1;