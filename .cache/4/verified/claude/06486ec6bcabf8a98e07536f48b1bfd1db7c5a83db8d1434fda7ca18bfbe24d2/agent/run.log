":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-hjHD91/translated_rust/tests/t08_pack.rs","content":"#[test]\nfn pack_every_single_byte_format() {\n    let d = duo();\n    let _g = lock();\n    // Provide args that are simultaneously safe for every specifier:\n    //   - a valid `const char*` (also a valid json_t of type JSON_NULL,\n    //     refcount (size_t)-1, i.e. immortal, so o/O are safe)\n    // The `#`, `%` and `+` modifiers are covered by dedicated tests; here they\n    // would consume a length from a pointer-shaped slot.\n    for b in 1u8..0x80 {\n        let ch = b as char;\n        if \"#%+\".contains(ch) {\n            continue;\n        }\n        let fmt = format!(\"{}\", ch);\n        let args = vec![\n            A::S(b\"v\".to_vec()),\n            A::S(b\"v\".to_vec()),\n            A::S(b\"v\".to_vec()),\n        ];\n        // `o`/`O` would read arg[0] as a json_t*, which a plain string is not,\n        // so route those through the dedicated JNull case instead.\n        if ch == 'o' || ch == 'O' {\n            cmp_pack(d, \"single-byte\", &fmt, &[A::JNull], 0);\n            cmp_pack(d, \"single-byte\", &fmt, &[A::JO(\"1\")], 0);\n            continue;\n        }\n        cmp_pack(d, \"single-byte\", &fmt, &args, 0);\n    }\n}\n\n/// Randomized format strings. The alphabet excludes `#`, `%` and `+` (which\n/// consume a length from the next slot) and every slot is a pointer to an\n/// immortal `json_t{JSON_NULL, (size_t)-1}` that is ALSO the 1-byte C string\n/// \"\\x07\", so it is simultaneously safe as `const char*`, `json_t*`, `int`,","numLines":35,"startLine":700,"totalLines":1672}}}
