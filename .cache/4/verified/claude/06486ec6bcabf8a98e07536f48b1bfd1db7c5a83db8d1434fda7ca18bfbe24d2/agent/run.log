{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01TSvQWvDCQTQaadLtxN5yYm","type":"tool_result","content":"1\t//! Harness smoke test + symbol parity (Phase A / Phase D).\n2\tmod common;\n3\tuse common::*;\n4\tuse std::ffi::c_void;\n5\t\n6\t#[test]\n7\tfn both_libraries_load_and_seed_identically() {\n8\t    let d = duo();\n9\t    unsafe {\n10\t        let cs: u32 = d.c.data(\"hashtable_seed\");\n11\t        let rs: u32 = d.rs.data(\"hashtable_seed\");\n12\t        eq(\"hashtable_seed\", cs, rs);\n13\t    }\n14\t}\n15\t\n16\t#[test]\n17\tfn version_symbols() {\n18\t    let d = duo();\n19\t    unsafe {\n20\t        eq_bytes(\n21\t            \"jansson_version_str\",\n22\t            &cstr_bytes((d.c.jansson_version_str)()),\n23\t            &cstr_bytes((d.rs.jansson_version_str)()),\n24\t        );\n25\t        for (a, b, c) in [\n26\t            (2, 15, 0),\n27\t            (2, 15, 1),\n28\t            (2, 14, 0),\n29\t            (3, 0, 0),\n30\t            (1, 99, 99),\n31\t            (0, 0, 0),\n32\t            (-1, -1, -1),\n33\t            (i32::MIN, 0, 0),\n34\t            (i32::MAX, i32::MAX, i32::MAX),\n35\t            (2, 15, i32::MIN),\n36\t        ] {\n37\t            eq(\n38\t                &format!(\"jansson_version_cmp({},{},{})\", a, b, c),\n39\t                (d.c.jansson_version_cmp)(a, b, c),\n40\t                (d.rs.jansson_version_cmp)(a, b, c),\n41\t            );\n42\t        }\n43\t    }\n44\t}\n45\t\n46\t#[test]\n47\tfn dtoa_divmax_data_symbol() {\n48\t    let d = duo();\n49\t    unsafe {\n50\t        let cv: i32 = d.c.data(\"dtoa_divmax\");\n51\t        let rv: i32 = d.rs.data(\"dtoa_divmax\");\n52\t        eq(\"dtoa_divmax\", cv, rv);\n53\t        eq(\"dtoa_divmax initial value\", cv, 2);\n54\t    }\n55\t}\n56\t\n57\t/// Phase D: every symbol exported by the C `.so` must also be exported by the\n58\t/// Rust `.so`, with the exact same name.\n59\t#[test]\n60\tfn symbol_parity_nm() {\n61\t    let c = c_so_path();\n62\t    let r = rust_so_path();\n63\t    let syms = |p: &std::path::Path| -> Vec<String> {\n64\t        let out = std::process::Command::new(\"nm\")\n65\t            .args([\"-D\", \"--defined-only\", p.to_str().unwrap()])\n66\t            .output()\n67\t            .expect(\"nm\");\n68\t        assert!(out.status.success(), \"nm failed on {}\", p.display());\n69\t        let mut v: Vec<String> = String::from_utf8_lossy(&out.stdout)\n70\t            .lines()\n71\t            .filter_map(|l| l.split_whitespace().nth(2).map(|s| s.to_string()))\n72\t            .collect();\n73\t        v.sort();\n74\t        v.dedup();\n75\t        v\n76\t    };\n77\t    let cs = syms(&c);\n78\t    let rs = syms(&r);\n79\t    let missing: Vec<&String> = cs.iter().filter(|s| !rs.contains(s)).collect();\n80\t    assert!(\n81\t        missing.is_empty(),\n82\t        \"{} symbol(s) exported by the C .so are MISSING from the Rust .so: {:?}\",\n83\t        missing.len(),\n84\t        missing\n85\t    );\n86\t    let extra: Vec<&String> = rs.iter().filter(|s| !cs.contains(s)).collect();\n87\t    assert!(\n88\t        extra.is_empty(),\n89\t        \"{} extra symbol(s) in the Rust .so: {:?}\",\n90\t        extra.len(),\n91\t        extra\n92\t    );\n93\t    assert!(cs.len() >= 130, \"expected >= 130 C symbols, got {}\", cs.len());\n94\t}\n95\t\n96\t#[test]\n97\tfn smoke_roundtrip() {\n98\t    let d = duo();\n99\t    unsafe {\n100\t        let src = cs(r#\"{\"a\":[1,2.5,true,false,null,\"x\"],\"b\":{\"c\":3}}\"#);\n101\t        let cj = (d.c.json_loads)(src.as_ptr(), 0, std::ptr::null_mut());\n102\t        let rj = (d.rs.json_loads)(src.as_ptr(), 0, std::ptr::null_mut());\n103\t        assert!(!cj.is_null() && !rj.is_null());\n104\t        eq(\"describe\", describe(&d.c, cj), describe(&d.rs, rj));\n105\t        let (cd, rd) = dumps_both(d, cj, rj, 0);\n106\t        eq_bytes(\"dumps\", cd.as_deref().unwrap(), rd.as_deref().unwrap());\n107\t        decref(&d.c, cj);\n108\t        decref(&d.rs, rj);\n109\t    }\n110\t}\n111\t\n112\t/// The `va_list` construction used throughout the error-path tests must work\n113\t/// against both libraries.\n114\t#[test]\n115\tfn valist_construction_works() {\n116\t    let d = duo();\n117\t    unsafe {\n118\t        let fmt = cs(\"{s:i,s:f,s:s}\");\n119\t        let k1 = cs(\"i\");\n120\t        let k2 = cs(\"f\");\n121\t        let k3 = cs(\"s\");\n122\t        let v3 = cs(\"hello\");\n123\t        for l in d.both() {\n124\t            let mut va = VaArgs::new()\n125\t                .ptr(k1.as_ptr())\n126\t                .int(42)\n127\t                .ptr(k2.as_ptr())\n128\t                .f64(1.5)\n129\t                .ptr(k3.as_ptr())\n130\t                .ptr(v3.as_ptr());\n131\t            let ap = va.build();\n132\t            let j = (l.json_vpack_ex)(std::ptr::null_mut(), 0, fmt.as_ptr(), ap);\n133\t            assert!(!j.is_null(), \"{}: json_vpack_ex returned NULL\", l.which);\n134\t            let s = (l.json_dumps)(j, JSON_SORT_KEYS);\n135\t            assert!(!s.is_null());\n136\t            eq_bytes(\n137\t                &format!(\"{} vpack\", l.which),\n138\t                br#\"{\"f\": 1.5, \"i\": 42, \"s\": \"hello\"}\"#,\n139\t                &cstr_bytes(s),\n140\t            );\n141\t            (l.jsonp_free)(s as *mut c_void);\n142\t            decref(l, j);\n143\t        }\n144\t    }\n145\t}\n146\t"}]},"parent_tool_use_id":"toolu_bdrk_01G48FDujCVrhaGFRBQ9pnpq","session_id":"0aaf00f6-473d-4ae1-b7a7-2a8b9811f369","uuid":"6e61319d-eead-401d-9874-556f9a6f702a","timestamp":"2026-08-23T00:29:40.734Z","subagent_type":"general-purpose","task_description":"Write utf.c differential tests"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01ELhfxmd9QtB4psey5cDta6","type":"tool_result","content":"1\t//! Differential-test harness: loads BOTH the C `.so` and the Rust `.so` via\n2\t//! `libloading` and exposes every exported symbol as a function pointer so the\n3\t//! two implementations can be driven identically through the FFI boundary.\n4\t//!\n5\t//! Rust functions are NEVER called directly — everything goes through\n6\t//! `dlsym` on `target/<profile>/libjansson.so`, exactly like an external\n7\t//! consumer, which also exercises the `#[no_mangle]` export wrappers.\n8\t#![allow(dead_code)]\n9\t#![allow(non_camel_case_types)]\n10\t#![allow(non_snake_case)]\n11\t#![allow(non_upper_case_globals)]\n12\t\n13\tuse libloading::{Library, Symbol};\n14\tuse std::ffi::{c_char, c_int, c_uint, c_void, CString};\n15\tuse std::path::PathBuf;\n16\t\n17\t// ---------------------------------------------------------------------------\n18\t// C types\n19\t// ---------------------------------------------------------------------------\n20\t\n21\tpub const JSON_OBJECT: c_int = 0;\n22\tpub const JSON_ARRAY: c_int = 1;\n23\tpub const JSON_STRING: c_int = 2;\n24\tpub const JSON_INTEGER: c_int = 3;\n25\tpub const JSON_REAL: c_int = 4;\n26\tpub const JSON_TRUE: c_int = 5;\n27\tpub const JSON_FALSE: c_int = 6;\n28\tpub const JSON_NULL: c_int = 7;\n29\t\n30\t// decode flags\n31\tpub const JSON_REJECT_DUPLICATES: usize = 0x1;\n32\tpub const JSON_DISABLE_EOF_CHECK: usize = 0x2;\n33\tpub const JSON_DECODE_ANY: usize = 0x4;\n34\tpub const JSON_DECODE_INT_AS_REAL: usize = 0x8;\n35\tpub const JSON_ALLOW_NUL: usize = 0x10;\n36\t\n37\t// encode flags\n38\tpub const JSON_MAX_INDENT: usize = 0x1F;\n39\tpub const JSON_COMPACT: usize = 0x20;\n40\tpub const JSON_ENSURE_ASCII: usize = 0x40;\n41\tpub const JSON_SORT_KEYS: usize = 0x80;\n42\tpub const JSON_PRESERVE_ORDER: usize = 0x100;\n43\tpub const JSON_ENCODE_ANY: usize = 0x200;\n44\tpub const JSON_ESCAPE_SLASH: usize = 0x400;\n45\tpub const JSON_EMBED: usize = 0x10000;\n46\t\n47\tpub fn json_indent(n: usize) -> usize {\n48\t    n & JSON_MAX_INDENT\n49\t}\n50\tpub fn json_real_precision(n: usize) -> usize {\n51\t    (n & 0x1F) << 11\n52\t}\n53\t\n54\t// pack/unpack flags\n55\tpub const JSON_VALIDATE_ONLY: usize = 0x1;\n56\tpub const JSON_STRICT: usize = 0x2;\n57\t\n58\tpub const JSON_ERROR_TEXT_LENGTH: usize = 160;\n59\tpub const JSON_ERROR_SOURCE_LENGTH: usize = 80;\n60\t\n61\t// json_error_code\n62\tpub const json_error_unknown: c_int = 0;\n63\tpub const json_error_out_of_memory: c_int = 1;\n64\tpub const json_error_stack_overflow: c_int = 2;\n65\tpub const json_error_cannot_open_file: c_int = 3;\n66\tpub const json_error_invalid_argument: c_int = 4;\n67\tpub const json_error_invalid_utf8: c_int = 5;\n68\tpub const json_error_premature_end_of_input: c_int = 6;\n69\tpub const json_error_end_of_input_expected: c_int = 7;\n70\tpub const json_error_invalid_syntax: c_int = 8;\n71\tpub const json_error_invalid_format: c_int = 9;\n72\tpub const json_error_wrong_type: c_int = 10;\n73\tpub const json_error_null_character: c_int = 11;\n74\tpub const json_error_null_value: c_int = 12;\n75\tpub const json_error_null_byte_in_key: c_int = 13;\n76\tpub const json_error_duplicate_key: c_int = 14;\n77\tpub const json_error_numeric_overflow: c_int = 15;\n78\tpub const json_error_item_not_found: c_int = 16;\n79\tpub const json_error_index_out_of_range: c_int = 17;\n80\t\n81\t#[repr(C)]\n82\t#[derive(Copy, Clone, Debug, PartialEq, Eq)]\n83\tpub struct json_t {\n84\t    pub type_: c_int,\n85\t    pub refcount: usize,\n86\t}\n87\t\n88\t#[repr(C)]\n89\t#[derive(Copy, Clone)]\n90\tpub struct json_error_t {\n91\t    pub line: c_int,\n92\t    pub column: c_int,\n93\t    pub position: c_int,\n94\t    pub source: [c_char; JSON_ERROR_SOURCE_LENGTH],\n95\t    pub text: [c_char; JSON_ERROR_TEXT_LENGTH],\n96\t}\n97\t\n98\timpl json_error_t {\n99\t    pub fn new() -> json_error_t {\n100\t        json_error_t {\n101\t            line: 0,\n102\t            column: 0,\n103\t            position: 0,\n104\t            source: [0; JSON_ERROR_SOURCE_LENGTH],\n105\t            text: [0; JSON_ERROR_TEXT_LENGTH],\n106\t        }\n107\t    }\n108\t    /// The `enum json_error_code` byte the C stores in `text[159]`.\n109\t    pub fn code(&self) -> c_int {\n110\t        self.text[JSON_ERROR_TEXT_LENGTH - 1] as c_int\n111\t    }\n112\t    pub fn text_str(&self) -> String {\n113\t        cstr_to_string_lossy(self.text.as_ptr())\n114\t    }\n115\t    pub fn source_str(&self) -> String {\n116\t        cstr_to_string_lossy(self.source.as_ptr())\n117\t    }\n118\t    /// Everything an external caller can observe, in one comparable value.\n119\t    pub fn snapshot(&self) -> (c_int, c_int, c_int, String, String, i32) {\n120\t        (\n121\t            self.line,\n122\t            self.column,\n123\t            self.position,\n124\t            self.source_str(),\n125\t            self.text_str(),\n126\t            self.code(),\n127\t        )\n128\t    }\n129\t    /// Raw bytes of the whole 252-byte struct (byte-for-byte comparison).\n130\t    pub fn raw(&self) -> Vec<u8> {\n131\t        let p = self as *const json_error_t as *const u8;\n132\t        unsafe { std::slice::from_raw_parts(p, std::mem::size_of::<json_error_t>()) }.to_vec()\n133\t    }\n134\t}\n135\t\n136\timpl std::fmt::Debug for json_error_t {\n137\t    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n138\t        write!(\n139\t            f,\n140\t            \"json_error_t {{ line: {}, column: {}, position: {}, source: {:?}, text: {:?}, code: {} }}\",\n141\t            self.line, self.column, self.position, self.source_str(), self.text_str(), self.code()\n142\t        )\n143\t    }\n144\t}\n145\t\n146\t#[repr(C)]\n147\t#[derive(Copy, Clone, Debug)]\n148\tpub struct hashtable_list {\n149\t    pub prev: *mut hashtable_list,\n150\t    pub next: *mut hashtable_list,\n151\t}\n152\t\n153\t#[repr(C)]\n154\t#[derive(Copy, Clone, Debug)]\n155\tpub struct hashtable_t {\n156\t    pub size: usize,\n157\t    pub buckets: *mut c_void,\n158\t    pub order: usize,\n159\t    pub list: hashtable_list,\n160\t    pub ordered_list: hashtable_list,\n161\t}\n162\t\n163\timpl hashtable_t {\n164\t    pub fn zeroed() -> hashtable_t {\n165\t        unsafe { std::mem::zeroed() }\n166\t    }\n167\t}\n168\t\n169\t#[repr(C)]\n170\t#[derive(Copy, Clone, Debug)]\n171\tpub struct strbuffer_t {\n172\t    pub value: *mut c_char,\n173\t    pub length: usize,\n174\t    pub size: usize,\n175\t}\n176\t\n177\timpl strbuffer_t {\n178\t    pub fn zeroed() -> strbuffer_t {\n179\t        strbuffer_t {\n180\t            value: std::ptr::null_mut(),\n181\t            length: 0,\n182\t            size: 0,\n183\t        }\n184\t    }\n185\t}\n186\t\n187\t/// `dtoa.c`'s `U` union — a double aliased with two 32-bit words.\n188\t#[repr(C)]\n189\t#[derive(Copy, Clone)]\n190\tpub union U {\n191\t    pub d: f64,\n192\t    pub L: [u32; 2],\n193\t}\n194\t\n195\timpl U {\n196\t    pub fn zero() -> U {\n197\t        U { d: 0.0 }\n198\t    }\n199\t    pub fn bits(&self) -> u64 {\n200\t        unsafe { self.d.to_bits() }\n201\t    }\n202\t}\n203\t\n204\t/// x86-64 SysV `va_list`. Passing `*mut VaListTag` matches the C ABI, where\n205\t/// `va_list` is an array of one such struct and therefore decays to a pointer.\n206\t#[repr(C)]\n207\t#[derive(Copy, Clone)]\n208\tpub struct VaListTag {\n209\t    pub gp_offset: c_uint,\n210\t    pub fp_offset: c_uint,\n211\t    pub overflow_arg_area: *mut c_void,\n212\t    pub reg_save_area: *mut c_void,\n213\t}\n214\t\n215\t/// Builds a real `va_list` whose arguments all live in the overflow area, so a\n216\t/// flat array of 8-byte slots is consumed in order. `gp_offset = 48` and\n217\t/// `fp_offset = 176` are past the register save area, which forces every\n218\t/// `va_arg` (integer *and* SSE) down the `overflow_arg_area` path.\n219\tpub struct VaArgs {\n220\t    words: Vec<u64>,\n221\t    tag: VaListTag,\n222\t}\n223\t\n224\timpl VaArgs {\n225\t    pub fn new() -> VaArgs {\n226\t        VaArgs {\n227\t            words: Vec::new(),\n228\t            tag: VaListTag {\n229\t                gp_offset: 48,\n230\t                fp_offset: 176,\n231\t                overflow_arg_area: std::ptr::null_mut(),\n232\t                reg_save_area: std::ptr::null_mut(),\n233\t            },\n234\t        }\n235\t    }\n236\t    pub fn int(mut self, v: c_int) -> Self {\n237\t        self.words.push(v as u32 as u64);\n238\t        self\n239\t    }\n240\t    pub fn i64(mut self, v: i64) -> Self {\n241\t        self.words.push(v as u64);\n242\t        self\n243\t    }\n244\t    pub fn usize(mut self, v: usize) -> Self {\n245\t        self.words.push(v as u64);\n246\t        self\n247\t    }\n248\t    pub fn f64(mut self, v: f64) -> Self {\n249\t        self.words.push(v.to_bits());\n250\t        self\n251\t    }\n252\t    pub fn ptr<T>(mut self, v: *const T) -> Self {\n253\t        self.words.push(v as usize as u64);\n254\t        self\n255\t    }\n256\t    pub fn ptr_mut<T>(mut self, v: *mut T) -> Self {\n257\t        self.words.push(v as usize as u64);\n258\t        self\n259\t    }\n260\t    /// Finalise: returns a `va_list` pointer valid while `self` is alive.\n261\t    /// Extra trailing slots guard against a format string reading too far.\n262\t    pub fn build(&mut self) -> *mut VaListTag {\n263\t        for _ in 0..8 {\n264\t            self.words.push(0);\n265\t        }\n266\t        self.tag.overflow_arg_area = self.words.as_mut_ptr() as *mut c_void;\n267\t        self.tag.reg_save_area = std::ptr::null_mut();\n268\t        &mut self.tag as *mut VaListTag\n269\t    }\n270\t}\n271\t\n272\t// ---------------------------------------------------------------------------\n273\t// helpers\n274\t// ---------------------------------------------------------------------------\n275\t\n276\tpub fn cstr_to_string_lossy(p: *const c_char) -> String {\n277\t    if p.is_null() {\n278\t        return String::from(\"<null>\");\n279\t    }\n280\t    let mut v = Vec::new();\n281\t    let mut i = 0isize;\n282\t    unsafe {\n283\t        while *p.offset(i) != 0 {\n284\t            v.push(*p.offset(i) as u8);\n285\t            i += 1;\n286\t            if i > 1 << 22 {\n287\t                break;\n288\t            }\n289\t        }\n290\t    }\n291\t    String::from_utf8_lossy(&v).into_owned()\n292\t}\n293\t\n294\tpub fn cstr_bytes(p: *const c_char) -> Vec<u8> {\n295\t    if p.is_null() {\n296\t        return Vec::new();\n297\t    }\n298\t    let mut v = Vec::new();\n299\t    let mut i = 0isize;\n300\t    unsafe {\n301\t        while *p.offset(i) != 0 {\n302\t            v.push(*p.offset(i) as u8);\n303\t            i += 1;\n304\t            if i > 1 << 24 {\n305\t                break;\n306\t            }\n307\t        }\n308\t    }\n309\t    v\n310\t}\n311\t\n312\tpub fn cs(s: &str) -> CString {\n313\t    CString::new(s.as_bytes()).expect(\"no interior NUL\")\n314\t}\n315\t\n316\t/// A NUL-terminated byte buffer that may contain interior NULs.\n317\tpub fn cbuf(bytes: &[u8]) -> Vec<u8> {\n318\t    let mut v = bytes.to_vec();\n319\t    v.push(0);\n320\t    v\n321\t}\n322\t\n323\t// ---------------------------------------------------------------------------\n324\t// Function pointer types\n325\t// ---------------------------------------------------------------------------\n326\t\n327\tpub type FnVoidToPtr = unsafe extern \"C\" fn() -> *mut json_t;\n328\tpub type FnStrToPtr = unsafe extern \"C\" fn(*const c_char) -> *mut json_t;\n329\tpub type FnStrLenToPtr = unsafe extern \"C\" fn(*const c_char, usize) -> *mut json_t;\n330\tpub type FnI64ToPtr = unsafe extern \"C\" fn(i64) -> *mut json_t;\n331\tpub type FnF64ToPtr = unsafe extern \"C\" fn(f64) -> *mut json_t;\n332\tpub type FnPtrToVoid = unsafe extern \"C\" fn(*mut json_t);\n333\tpub type FnPtrToUsize = unsafe extern \"C\" fn(*const json_t) -> usize;\n334\tpub type FnPtrToInt = unsafe extern \"C\" fn(*const json_t) -> c_int;\n335\tpub type FnPtrToI64 = unsafe extern \"C\" fn(*const json_t) -> i64;\n336\tpub type FnPtrToF64 = unsafe extern \"C\" fn(*const json_t) -> f64;\n337\tpub type FnPtrToCStr = unsafe extern \"C\" fn(*const json_t) -> *const c_char;\n338\tpub type FnMutPtrToInt = unsafe extern \"C\" fn(*mut json_t) -> c_int;\n339\t\n340\tpub type FnDumpCallback = unsafe extern \"C\" fn(*const c_char, usize, *mut c_void) -> c_int;\n341\tpub type FnLoadCallback = unsafe extern \"C\" fn(*mut c_void, usize, *mut c_void) -> usize;\n342\t\n343\tmacro_rules! define_lib {\n344\t    ( $( $name:ident : $ty:ty ),* $(,)? ) => {\n345\t        /// One loaded shared object with every exported function resolved.\n346\t        pub struct Lib {\n347\t            pub which: &'static str,\n348\t            pub path: PathBuf,\n349\t            $( pub $name: $ty, )*\n350\t            _lib: Library,\n351\t        }\n352\t\n353\t        impl Lib {\n354\t            pub fn open(which: &'static str, path: PathBuf) -> Lib {\n355\t                unsafe {\n356\t                    let lib = Library::new(&path)\n357\t                        .unwrap_or_else(|e| panic!(\"cannot dlopen {}: {}\", path.display(), e));\n358\t                    $(\n359\t                        let $name: $ty = {\n360\t                            let mut nm: Vec<u8> = stringify!($name).as_bytes().to_vec();\n361\t                            nm.push(0);\n362\t                            let s: Symbol<$ty> = lib.get(&nm).unwrap_or_else(|e| {\n363\t                                panic!(\"{}: missing symbol {}: {}\", which, stringify!($name), e)\n364\t                            });\n365\t                            *s\n366\t                        };\n367\t                    )*\n368\t                    Lib { which, path, $( $name, )* _lib: lib }\n369\t                }\n370\t            }\n371\t\n372\t            /// Read a `static`/`extern` data symbol.\n373\t            pub unsafe fn data<T: Copy>(&self, name: &str) -> T {\n374\t                let mut nm = name.as_bytes().to_vec();\n375\t                nm.push(0);\n376\t                let s: Symbol<*mut T> = self\n377\t                    ._lib\n378\t                    .get(&nm)\n379\t                    .unwrap_or_else(|e| panic!(\"{}: missing data symbol {}: {}\", self.which, name, e));\n380\t                **s\n381\t            }\n382\t\n383\t            pub unsafe fn data_ptr<T>(&self, name: &str) -> *mut T {\n384\t                let mut nm = name.as_bytes().to_vec();\n385\t                nm.push(0);\n386\t                let s: Symbol<*mut T> = self\n387\t                    ._lib\n388\t                    .get(&nm)\n389\t                    .unwrap_or_else(|e| panic!(\"{}: missing data symbol {}: {}\", self.which, name, e));\n390\t                *s\n391\t            }\n392\t\n393\t            pub fn has_symbol(&self, name: &str) -> bool {\n394\t                let mut nm = name.as_bytes().to_vec();\n395\t                nm.push(0);\n396\t                unsafe { self._lib.get::<*mut c_void>(&nm).is_ok() }\n397\t            }\n398\t        }\n399\t    };\n400\t}\n401\t\n402\tdefine_lib! {\n403\t    // ---- value.c: construction / refcounting -------------------------------\n404\t    json_object: FnVoidToPtr,\n405\t    json_array: FnVoidToPtr,\n406\t    json_string: FnStrToPtr,\n407\t    json_stringn: FnStrLenToPtr,\n408\t    json_string_nocheck: FnStrToPtr,\n409\t    json_stringn_nocheck: FnStrLenToPtr,\n410\t    json_integer: FnI64ToPtr,\n411\t    json_real: FnF64ToPtr,\n412\t    json_true: FnVoidToPtr,\n413\t    json_false: FnVoidToPtr,\n414\t    json_null: FnVoidToPtr,\n415\t    json_delete: FnPtrToVoid,\n416\t\n417\t    // ---- object -----------------------------------------------------------\n418\t    json_object_seed: unsafe extern \"C\" fn(usize),\n419\t    json_object_size: FnPtrToUsize,\n420\t    json_object_get: unsafe extern \"C\" fn(*const json_t, *const c_char) -> *mut json_t,\n421\t    json_object_getn: unsafe extern \"C\" fn(*const json_t, *const c_char, usize) -> *mut json_t,\n422\t    json_object_set_new: unsafe extern \"C\" fn(*mut json_t, *const c_char, *mut json_t) -> c_int,\n423\t    json_object_setn_new:\n424\t        unsafe extern \"C\" fn(*mut json_t, *const c_char, usize, *mut json_t) -> c_int,\n425\t    json_object_set_new_nocheck:\n426\t        unsafe extern \"C\" fn(*mut json_t, *const c_char, *mut json_t) -> c_int,\n427\t    json_object_setn_new_nocheck:\n428\t        unsafe extern \"C\" fn(*mut json_t, *const c_char, usize, *mut json_t) -> c_int,\n429\t    json_object_del: unsafe extern \"C\" fn(*mut json_t, *const c_char) -> c_int,\n430\t    json_object_deln: unsafe extern \"C\" fn(*mut json_t, *const c_char, usize) -> c_int,\n431\t    json_object_clear: FnMutPtrToInt,\n432\t    json_object_update: unsafe extern \"C\" fn(*mut json_t, *mut json_t) -> c_int,\n433\t    json_object_update_existing: unsafe extern \"C\" fn(*mut json_t, *mut json_t) -> c_int,\n434\t    json_object_update_missing: unsafe extern \"C\" fn(*mut json_t, *mut json_t) -> c_int,\n435\t    json_object_update_recursive: unsafe extern \"C\" fn(*mut json_t, *mut json_t) -> c_int,\n436\t    do_object_update_recursive:\n437\t        unsafe extern \"C\" fn(*mut json_t, *mut json_t, *mut hashtable_t) -> c_int,\n438\t    json_object_iter: unsafe extern \"C\" fn(*mut json_t) -> *mut c_void,\n439\t    json_object_iter_at: unsafe extern \"C\" fn(*mut json_t, *const c_char) -> *mut c_void,\n440\t    json_object_key_to_iter: unsafe extern \"C\" fn(*const c_char) -> *mut c_void,\n441\t    json_object_iter_next: unsafe extern \"C\" fn(*mut json_t, *mut c_void) -> *mut c_void,\n442\t    json_object_iter_key: unsafe extern \"C\" fn(*mut c_void) -> *const c_char,\n443\t    json_object_iter_key_len: unsafe extern \"C\" fn(*mut c_void) -> usize,\n444\t    json_object_iter_value: unsafe extern \"C\" fn(*mut c_void) -> *mut json_t,\n445\t    json_object_iter_set_new:\n446\t        unsafe extern \"C\" fn(*mut json_t, *mut c_void, *mut json_t) -> c_int,\n447\t\n448\t    // ---- array ------------------------------------------------------------\n449\t    json_array_size: FnPtrToUsize,\n450\t    json_array_get: unsafe extern \"C\" fn(*const json_t, usize) -> *mut json_t,\n451\t    json_array_set_new: unsafe extern \"C\" fn(*mut json_t, usize, *mut json_t) -> c_int,\n452\t    json_array_append_new: unsafe extern \"C\" fn(*mut json_t, *mut json_t) -> c_int,\n453\t    json_array_insert_new: unsafe extern \"C\" fn(*mut json_t, usize, *mut json_t) -> c_int,\n454\t    json_array_remove: unsafe extern \"C\" fn(*mut json_t, usize) -> c_int,\n455\t    json_array_clear: FnMutPtrToInt,\n456\t    json_array_extend: unsafe extern \"C\" fn(*mut json_t, *mut json_t) -> c_int,\n457\t\n458\t    // ---- scalars ----------------------------------------------------------\n459\t    json_string_value: FnPtrToCStr,\n460\t    json_string_length: FnPtrToUsize,\n461\t    json_integer_value: FnPtrToI64,\n462\t    json_real_value: FnPtrToF64,\n463\t    json_number_value: FnPtrToF64,\n464\t    json_string_set: unsafe extern \"C\" fn(*mut json_t, *const c_char) -> c_int,\n465\t    json_string_setn: unsafe extern \"C\" fn(*mut json_t, *const c_char, usize) -> c_int,\n466\t    json_string_set_nocheck: unsafe extern \"C\" fn(*mut json_t, *const c_char) -> c_int,\n467\t    json_string_setn_nocheck: unsafe extern \"C\" fn(*mut json_t, *const c_char, usize) -> c_int,\n468\t    json_integer_set: unsafe extern \"C\" fn(*mut json_t, i64) -> c_int,\n469\t    json_real_set: unsafe extern \"C\" fn(*mut json_t, f64) -> c_int,\n470\t\n471\t    // ---- equality / copying ----------------------------------------------\n472\t    json_equal: unsafe extern \"C\" fn(*const json_t, *const json_t) -> c_int,\n473\t    json_copy: unsafe extern \"C\" fn(*mut json_t) -> *mut json_t,\n474\t    json_deep_copy: unsafe extern \"C\" fn(*const json_t) -> *mut json_t,\n475\t    do_deep_copy: unsafe extern \"C\" fn(*const json_t, *mut hashtable_t) -> *mut json_t,\n476\t\n477\t    // ---- pack / unpack / sprintf -----------------------------------------\n478\t    json_pack: unsafe extern \"C\" fn(*const c_char, ...) -> *mut json_t,\n479\t    json_pack_ex: unsafe extern \"C\" fn(*mut json_error_t, usize, *const c_char, ...) -> *mut json_t,\n480\t    json_vpack_ex:\n481\t        unsafe extern \"C\" fn(*mut json_error_t, usize, *const c_char, *mut VaListTag) -> *mut json_t,\n482\t    json_unpack: unsafe extern \"C\" fn(*mut json_t, *const c_char, ...) -> c_int,\n483\t    json_unpack_ex:\n484\t        unsafe extern \"C\" fn(*mut json_t, *mut json_error_t, usize, *const c_char, ...) -> c_int,\n485\t    json_vunpack_ex: unsafe extern \"C\" fn(\n486\t        *mut json_t,\n487\t        *mut json_error_t,\n488\t        usize,\n489\t        *const c_char,\n490\t        *mut VaListTag,\n491\t    ) -> c_int,\n492\t    json_sprintf: unsafe extern \"C\" fn(*const c_char, ...) -> *mut json_t,\n493\t    json_vsprintf: unsafe extern \"C\" fn(*const c_char, *mut VaListTag) -> *mut json_t,\n494\t\n495\t    // ---- load.c -----------------------------------------------------------\n496\t    json_loads: unsafe extern \"C\" fn(*const c_char, usize, *mut json_error_t) -> *mut json_t,\n497\t    json_loadb:\n498\t        unsafe extern \"C\" fn(*const c_char, usize, usize, *mut json_error_t) -> *mut json_t,\n499\t    json_loadf: unsafe extern \"C\" fn(*mut c_void, usize, *mut json_error_t) -> *mut json_t,\n500\t    json_loadfd: unsafe extern \"C\" fn(c_int, usize, *mut json_error_t) -> *mut json_t,\n501\t    json_load_file: unsafe extern \"C\" fn(*const c_char, usize, *mut json_error_t) -> *mut json_t,\n502\t    json_load_callback: unsafe extern \"C\" fn(\n503\t        Option<FnLoadCallback>,\n504\t        *mut c_void,\n505\t        usize,\n506\t        *mut json_error_t,\n507\t    ) -> *mut json_t,\n508\t\n509\t    // ---- dump.c -----------------------------------------------------------\n510\t    json_dumps: unsafe extern \"C\" fn(*const json_t, usize) -> *mut c_char,\n511\t    json_dumpb: unsafe extern \"C\" fn(*const json_t, *mut c_char, usize, usize) -> usize,\n512\t    json_dumpf: unsafe extern \"C\" fn(*const json_t, *mut c_void, usize) -> c_int,\n513\t    json_dumpfd: unsafe extern \"C\" fn(*const json_t, c_int, usize) -> c_int,\n514\t    json_dump_file: unsafe extern \"C\" fn(*const json_t, *const c_char, usize) -> c_int,\n515\t    json_dump_callback: unsafe extern \"C\" fn(\n516\t        *const json_t,\n517\t        Option<FnDumpCallback>,\n518\t        *mut c_void,\n519\t        usize,\n520\t    ) -> c_int,\n521\t\n522\t    // ---- memory.c ---------------------------------------------------------\n523\t    json_set_alloc_funcs: unsafe extern \"C\" fn(\n524\t        Option<unsafe extern \"C\" fn(usize) -> *mut c_void>,\n525\t        Option<unsafe extern \"C\" fn(*mut c_void)>,\n526\t    ),\n527\t    json_get_alloc_funcs: unsafe extern \"C\" fn(*mut *mut c_void, *mut *mut c_void),\n528\t    json_set_alloc_funcs2: unsafe extern \"C\" fn(\n529\t        Option<unsafe extern \"C\" fn(usize) -> *mut c_void>,\n530\t        Option<unsafe extern \"C\" fn(*mut c_void, usize) -> *mut c_void>,\n531\t        Option<unsafe extern \"C\" fn(*mut c_void)>,\n532\t    ),\n533\t    json_get_alloc_funcs2:\n534\t        unsafe extern \"C\" fn(*mut *mut c_void, *mut *mut c_void, *mut *mut c_void),\n535\t    jsonp_malloc: unsafe extern \"C\" fn(usize) -> *mut c_void,\n536\t    jsonp_free: unsafe extern \"C\" fn(*mut c_void),\n537\t    jsonp_realloc: unsafe extern \"C\" fn(*mut c_void, usize, usize) -> *mut c_void,\n538\t    jsonp_strndup: unsafe extern \"C\" fn(*const c_char, usize) -> *mut c_char,\n539\t\n540\t    // ---- version.c --------------------------------------------------------\n541\t    jansson_version_str: unsafe extern \"C\" fn() -> *const c_char,\n542\t    jansson_version_cmp: unsafe extern \"C\" fn(c_int, c_int, c_int) -> c_int,\n543\t\n544\t    // ---- error.c ----------------------------------------------------------\n545\t    jsonp_error_init: unsafe extern \"C\" fn(*mut json_error_t, *const c_char),\n546\t    jsonp_error_set_source: unsafe extern \"C\" fn(*mut json_error_t, *const c_char),\n547\t    jsonp_error_set:\n548\t        unsafe extern \"C\" fn(*mut json_error_t, c_int, c_int, usize, c_int, *const c_char, ...),\n549\t    jsonp_error_vset: unsafe extern \"C\" fn(\n550\t        *mut json_error_t,\n551\t        c_int,\n552\t        c_int,\n553\t        usize,\n554\t        c_int,\n555\t        *const c_char,\n556\t        *mut VaListTag,\n557\t    ),\n558\t\n559\t    // ---- strbuffer.c ------------------------------------------------------\n560\t    strbuffer_init: unsafe extern \"C\" fn(*mut strbuffer_t) -> c_int,\n561\t    strbuffer_close: unsafe extern \"C\" fn(*mut strbuffer_t),\n562\t    strbuffer_clear: unsafe extern \"C\" fn(*mut strbuffer_t),\n563\t    strbuffer_value: unsafe extern \"C\" fn(*const strbuffer_t) -> *const c_char,\n564\t    strbuffer_steal_value: unsafe extern \"C\" fn(*mut strbuffer_t) -> *mut c_char,\n565\t    strbuffer_append_byte: unsafe extern \"C\" fn(*mut strbuffer_t, c_char) -> c_int,\n566\t    strbuffer_append_bytes: unsafe extern \"C\" fn(*mut strbuffer_t, *const c_char, usize) -> c_int,\n567\t    strbuffer_pop: unsafe extern \"C\" fn(*mut strbuffer_t) -> c_char,\n568\t\n569\t    // ---- utf.c ------------------------------------------------------------\n570\t    utf8_encode: unsafe extern \"C\" fn(i32, *mut c_char, *mut usize) -> c_int,\n571\t    utf8_check_first: unsafe extern \"C\" fn(c_char) -> usize,\n572\t    utf8_check_full: unsafe extern \"C\" fn(*const c_char, usize, *mut i32) -> usize,\n573\t    utf8_iterate: unsafe extern \"C\" fn(*const c_char, usize, *mut i32) -> *const c_char,\n574\t    utf8_check_string: unsafe extern \"C\" fn(*const c_char, usize) -> c_int,\n575\t\n576\t    // ---- hashtable.c ------------------------------------------------------\n577\t    hashtable_init: unsafe extern \"C\" fn(*mut hashtable_t) -> c_int,\n578\t    hashtable_close: unsafe extern \"C\" fn(*mut hashtable_t),\n579\t    hashtable_set:\n580\t        unsafe extern \"C\" fn(*mut hashtable_t, *const c_char, usize, *mut json_t) -> c_int,\n581\t    hashtable_get: unsafe extern \"C\" fn(*mut hashtable_t, *const c_char, usize) -> *mut c_void,\n582\t    hashtable_del: unsafe extern \"C\" fn(*mut hashtable_t, *const c_char, usize) -> c_int,\n583\t    hashtable_clear: unsafe extern \"C\" fn(*mut hashtable_t),\n584\t    hashtable_iter: unsafe extern \"C\" fn(*mut hashtable_t) -> *mut c_void,\n585\t    hashtable_iter_at:\n586\t        unsafe extern \"C\" fn(*mut hashtable_t, *const c_char, usize) -> *mut c_void,\n587\t    hashtable_iter_next: unsafe extern \"C\" fn(*mut hashtable_t, *mut c_void) -> *mut c_void,\n588\t    hashtable_iter_key: unsafe extern \"C\" fn(*mut c_void) -> *mut c_char,\n589\t    hashtable_iter_key_len: unsafe extern \"C\" fn(*mut c_void) -> usize,\n590\t    hashtable_iter_value: unsafe extern \"C\" fn(*mut c_void) -> *mut c_void,\n591\t    hashtable_iter_set: unsafe extern \"C\" fn(*mut c_void, *mut json_t),\n592\t\n593\t    // ---- strconv.c --------------------------------------------------------\n594\t    jsonp_strtod: unsafe extern \"C\" fn(*mut strbuffer_t, *mut f64) -> c_int,\n595\t    jsonp_dtostr: unsafe extern \"C\" fn(*mut c_char, usize, f64, c_int) -> c_int,\n596\t\n597\t    // ---- value.c private --------------------------------------------------\n598\t    jsonp_stringn_nocheck_own: FnStrLenToPtr,\n599\t    jsonp_loop_check:\n600\t        unsafe extern \"C\" fn(*mut hashtable_t, *const json_t, *mut c_char, usize, *mut usize) -> c_int,\n601\t\n602\t    // ---- dtoa.c -----------------------------------------------------------\n603\t    dtoa: unsafe extern \"C\" fn(\n604\t        f64, c_int, c_int, *mut c_int, *mut c_int, *mut *mut c_char,\n605\t    ) -> *mut c_char,\n606\t    dtoa_r: unsafe extern \"C\" fn(\n607\t        f64, c_int, c_int, *mut c_int, *mut c_int, *mut *mut c_char, *mut c_char, usize,\n608\t    ) -> *mut c_char,\n609\t    freedtoa: unsafe extern \"C\" fn(*mut c_char),\n610\t    gethex: unsafe extern \"C\" fn(*mut *const c_char, *mut U, c_int, c_int),\n611\t    strtod__unused: unsafe extern \"C\" fn(*const c_char, *mut *mut c_char) -> f64,\n612\t}\n613\t\n614\t// ---------------------------------------------------------------------------\n615\t// Locating the two shared objects\n616\t// ---------------------------------------------------------------------------\n617\t\n618\tpub fn manifest_dir() -> PathBuf {\n619\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n620\t}\n621\t\n622\tpub fn c_so_path() -> PathBuf {\n623\t    manifest_dir().join(\"c_src/build/libjansson.so\")\n624\t}\n625\t\n626\tpub fn rust_so_path() -> PathBuf {\n627\t    // current_exe() == target/<profile>/deps/<test>-<hash>\n628\t    if let Ok(exe) = std::env::current_exe() {\n629\t        if let Some(deps) = exe.parent() {\n630\t            if let Some(profile) = deps.parent() {\n631\t                let p = profile.join(\"libjansson.so\");\n632\t                if p.exists() {\n633\t                    return p;\n634\t                }\n635\t            }\n636\t        }\n637\t    }\n638\t    for p in [\"target/debug/libjansson.so\", \"target/release/libjansson.so\"] {\n639\t        let p = manifest_dir().join(p);\n640\t        if p.exists() {\n641\t            return p;\n642\t        }\n643\t    }\n644\t    panic!(\"cannot find the Rust libjansson.so — run `cargo build` first\");\n645\t}\n646\t\n647\t/// The deterministic hashtable seed used by every test. Both libraries are\n648\t/// seeded with the same value so that bucket assignment, and therefore object\n649\t/// iteration order and `JSON_SORT_KEYS`-free dump order, is identical.\n650\tpub const TEST_SEED: usize = 0x5eed_1234;\n651\t\n652\t/// Both loaded libraries, seeded identically.\n653\tpub struct Duo {\n654\t    pub c: Lib,\n655\t    pub rs: Lib,\n656\t}\n657\t\n658\timpl Duo {\n659\t    pub fn load() -> Duo {\n660\t        let c = Lib::open(\"C\", c_so_path());\n661\t        let rs = Lib::open(\"RUST\", rust_so_path());\n662\t        // Seed BEFORE anything creates an object (json_object() auto-seeds).\n663\t        unsafe {\n664\t            (c.json_object_seed)(TEST_SEED);\n665\t            (rs.json_object_seed)(TEST_SEED);\n666\t            let cs: u32 = c.data(\"hashtable_seed\");\n667\t            let rss: u32 = rs.data(\"hashtable_seed\");\n668\t            assert_eq!(cs, rss, \"hashtable_seed differs after identical seeding\");\n669\t            assert_ne!(cs, 0, \"hashtable_seed must be non-zero after seeding\");\n670\t        }\n671\t        Duo { c, rs }\n672\t    }\n673\t\n674\t    pub fn both(&self) -> [&Lib; 2] {\n675\t        [&self.c, &self.rs]\n676\t    }\n677\t}\n678\t\n679\t/// Process-wide singleton: `dlopen`ing the same object twice per test binary is\n680\t/// wasteful and the libraries hold mutable global state (allocator hooks, seed).\n681\tpub fn duo() -> &'static Duo {\n682\t    use std::sync::OnceLock;\n683\t    static D: OnceLock<Duo> = OnceLock::new();\n684\t    D.get_or_init(Duo::load)\n685\t}\n686\t\n687\tunsafe impl Send for Duo {}\n688\tunsafe impl Sync for Duo {}\n689\t\n690\t// ---------------------------------------------------------------------------\n691\t// Deterministic PRNG (xorshift64*) — fixed seed, reproducible\n692\t// ---------------------------------------------------------------------------\n693\t\n694\tpub struct Rng(u64);\n695\t\n696\timpl Rng {\n697\t    pub fn new(seed: u64) -> Rng {\n698\t        Rng(if seed == 0 { 0x9E3779B97F4A7C15 } else { seed })\n699\t    }\n700\t    pub fn next_u64(&mut self) -> u64 {\n701\t        let mut x = self.0;\n702\t        x ^= x >> 12;\n703\t        x ^= x << 25;\n704\t        x ^= x >> 27;\n705\t        self.0 = x;\n706\t        x.wrapping_mul(0x2545_F491_4F6C_DD1D)\n707\t    }\n708\t    pub fn next_u32(&mut self) -> u32 {\n709\t        (self.next_u64() >> 32) as u32\n710\t    }\n711\t    /// Uniform in `0..n`.\n712\t    pub fn below(&mut self, n: usize) -> usize {\n713\t        if n == 0 {\n714\t            0\n715\t        } else {\n716\t            (self.next_u64() % n as u64) as usize\n717\t        }\n718\t    }\n719\t    pub fn range_i64(&mut self, lo: i64, hi: i64) -> i64 {\n720\t        if hi <= lo {\n721\t            return lo;\n722\t        }\n723\t        lo + (self.next_u64() % ((hi - lo) as u64)) as i64\n724\t    }\n725\t    pub fn bool(&mut self) -> bool {\n726\t        self.next_u64() & 1 == 1\n727\t    }\n728\t    /// A finite `f64` drawn from a wide range of magnitudes.\n729\t    pub fn finite_f64(&mut self) -> f64 {\n730\t        loop {\n731\t            let bits = self.next_u64();\n732\t            let v = f64::from_bits(bits);\n733\t            if v.is_finite() {\n734\t                return v;\n735\t            }\n736\t        }\n737\t    }\n738\t    /// A \"reasonable\" f64: mantissa * 10^exp with exp in -30..30.\n739\t    pub fn tame_f64(&mut self) -> f64 {\n740\t        let m = (self.next_u64() % 2_000_000_000) as f64 - 1_000_000_000.0;\n741\t        let e = self.range_i64(-30, 30) as i32;\n742\t        let v = m * 10f64.powi(e);\n743\t        if v.is_finite() {\n744\t            v\n745\t        } else {\n746\t            0.0\n747\t        }\n748\t    }\n749\t    pub fn ascii_string(&mut self, len: usize) -> Vec<u8> {\n750\t        (0..len)\n751\t            .map(|_| {\n752\t                let c = b\" !#$%&'()*+,-./0123456789:;<=>?@ABCXYZ[]^_`abcxyz{|}~\";\n753\t                c[self.below(c.len())]\n754\t            })\n755\t            .collect()\n756\t    }\n757\t    pub fn random_bytes(&mut self, len: usize) -> Vec<u8> {\n758\t        (0..len).map(|_| (self.next_u32() & 0xFF) as u8).collect()\n759\t    }\n760\t    /// A valid UTF-8 string mixing 1-, 2-, 3- and 4-byte sequences.\n761\t    pub fn utf8_string(&mut self, chars: usize) -> Vec<u8> {\n762\t        let mut out = Vec::new();\n763\t        for _ in 0..chars {\n764\t            let cp: u32 = match self.below(4) {\n765\t                0 => 0x20 + self.below(0x5F) as u32,\n766\t                1 => 0x80 + self.below(0x780) as u32,\n767\t                2 => loop {\n768\t                    let c = 0x800 + self.below(0xF800) as u32;\n769\t                    if !(0xD800..=0xDFFF).contains(&c) {\n770\t                        break c;\n771\t                    }\n772\t                },\n773\t                _ => 0x10000 + self.below(0x100000) as u32,\n774\t            };\n775\t            let mut b = [0u8; 4];\n776\t            out.extend_from_slice(char::from_u32(cp).unwrap().encode_utf8(&mut b).as_bytes());\n777\t        }\n778\t        out\n779\t    }\n780\t}\n781\t\n782\t// ---------------------------------------------------------------------------\n783\t// Assertion helpers\n784\t// ---------------------------------------------------------------------------\n785\t\n786\t#[track_caller]\n787\tpub fn eq<T: PartialEq + std::fmt::Debug>(what: &str, cv: T, rv: T) {\n788\t    assert_eq!(cv, rv, \"C vs RUST divergence in {}\", what);\n789\t}\n790\t\n791\t#[track_caller]\n792\tpub fn eq_bytes(what: &str, cv: &[u8], rv: &[u8]) {\n793\t    if cv != rv {\n794\t        panic!(\n795\t            \"C vs RUST divergence in {}\\n  C   ({:>4} bytes): {:?}\\n  RUST({:>4} bytes): {:?}\",\n796\t            what,\n797\t            cv.len(),\n798\t            String::from_utf8_lossy(cv),\n799\t            rv.len(),\n800\t            String::from_utf8_lossy(rv),\n801\t        );\n802\t    }\n803\t}\n804\t\n805\t#[track_caller]\n806\tpub fn eq_err(what: &str, ce: &json_error_t, re: &json_error_t) {\n807\t    if ce.raw() != re.raw() {\n808\t        panic!(\n809\t            \"C vs RUST json_error_t divergence in {}\\n  C   : {:?}\\n  RUST: {:?}\",\n810\t            what, ce, re\n811\t        );\n812\t    }\n813\t}\n814\t\n815\t/// `json_dumps` on both libraries; returns the two byte strings (freed).\n816\tpub fn dumps_both(d: &Duo, cj: *mut json_t, rj: *mut json_t, flags: usize) -> (Option<Vec<u8>>, Option<Vec<u8>>) {\n817\t    unsafe {\n818\t        let cp = (d.c.json_dumps)(cj, flags);\n819\t        let rp = (d.rs.json_dumps)(rj, flags);\n820\t        let cv = if cp.is_null() { None } else { Some(cstr_bytes(cp)) };\n821\t        let rv = if rp.is_null() { None } else { Some(cstr_bytes(rp)) };\n822\t        if !cp.is_null() {\n823\t            (d.c.jsonp_free)(cp as *mut c_void);\n824\t        }\n825\t        if !rp.is_null() {\n826\t            (d.rs.jsonp_free)(rp as *mut c_void);\n827\t        }\n828\t        (cv, rv)\n829\t    }\n830\t}\n831\t\n832\t/// Fully-observable snapshot of a value tree, produced only through public\n833\t/// getters, so it can be compared between the two libraries.\n834\tpub fn describe(l: &Lib, j: *const json_t) -> String {\n835\t    let mut s = String::new();\n836\t    describe_into(l, j, &mut s, 0);\n837\t    s\n838\t}\n839\t\n840\tfn describe_into(l: &Lib, j: *const json_t, out: &mut String, depth: usize) {\n841\t    if j.is_null() {\n842\t        out.push_str(\"NULL\");\n843\t        return;\n844\t    }\n845\t    if depth > 64 {\n846\t        out.push_str(\"<deep>\");\n847\t        return;\n848\t    }\n849\t    let ty = unsafe { (*j).type_ };\n850\t    let rc = unsafe { (*j).refcount };\n851\t    match ty {\n852\t        JSON_OBJECT => unsafe {\n853\t            out.push_str(&format!(\"obj(rc={},n={}){{\", rc, (l.json_object_size)(j)));\n854\t            let mut it = (l.json_object_iter)(j as *mut json_t);\n855\t            while !it.is_null() {\n856\t                let k = (l.json_object_iter_key)(it);\n857\t                let kl = (l.json_object_iter_key_len)(it);\n858\t                let kb = std::slice::from_raw_parts(k as *const u8, kl);\n859\t                out.push_str(&format!(\"{:?}=\", String::from_utf8_lossy(kb)));\n860\t                describe_into(l, (l.json_object_iter_value)(it), out, depth + 1);\n861\t                out.push(',');\n862\t                it = (l.json_object_iter_next)(j as *mut json_t, it);\n863\t            }\n864\t            out.push('}');\n865\t        },\n866\t        JSON_ARRAY => unsafe {\n867\t            let n = (l.json_array_size)(j);\n868\t            out.push_str(&format!(\"arr(rc={},n={})[\", rc, n));\n869\t            for i in 0..n {\n870\t                describe_into(l, (l.json_array_get)(j, i), out, depth + 1);\n871\t                out.push(',');\n872\t            }\n873\t            out.push(']');\n874\t        },\n875\t        JSON_STRING => unsafe {\n876\t            let p = (l.json_string_value)(j);\n877\t            let n = (l.json_string_length)(j);\n878\t            let b = if p.is_null() {\n879\t                &[][..]\n880\t            } else {\n881\t                std::slice::from_raw_parts(p as *const u8, n)\n882\t            };\n883\t            out.push_str(&format!(\"str(rc={},{})={:?}\", rc, n, b));\n884\t        },\n885\t        JSON_INTEGER => unsafe {\n886\t            out.push_str(&format!(\"int(rc={})={}\", rc, (l.json_integer_value)(j)));\n887\t        },\n888\t        JSON_REAL => unsafe {\n889\t            out.push_str(&format!(\n890\t                \"real(rc={})={:#018x}\",\n891\t                rc,\n892\t                (l.json_real_value)(j).to_bits()\n893\t            ));\n894\t        },\n895\t        JSON_TRUE => out.push_str(&format!(\"true(rc={})\", rc)),\n896\t        JSON_FALSE => out.push_str(&format!(\"false(rc={})\", rc)),\n897\t        JSON_NULL => out.push_str(&format!(\"null(rc={})\", rc)),\n898\t        other => out.push_str(&format!(\"<type {}>(rc={})\", other, rc)),\n899\t    }\n900\t}\n901\t\n902\t/// Drop a value on its own library (handles the immortal singletons).\n903\tpub fn decref(l: &Lib, j: *mut json_t) {\n904\t    if j.is_null() {\n905\t        return;\n906\t    }\n907\t    unsafe {\n908\t        if (*j).refcount == usize::MAX {\n909\t            return;\n910\t        }\n911\t        (*j).refcount -= 1;\n912\t        if (*j).refcount == 0 {\n913\t            (l.json_delete)(j);\n914\t        }\n915\t    }\n916\t}\n917\t\n918\tpub fn incref(j: *mut json_t) -> *mut json_t {\n919\t    if !j.is_null() {\n920\t        unsafe {\n921\t            if (*j).refcount != usize::MAX {\n922\t                (*j).refcount += 1;\n923\t            }\n924\t        }\n925\t    }\n926\t    j\n927\t}\n928\t"}]},"parent_tool_use_id":"toolu_bdrk_01G48FDujCVrhaGFRBQ9pnpq","session_id":"0aaf00f6-473d-4ae1-b7a7-2a8b9811f369","uuid":"82d6be0f-4f63-4bb8-ba55-9b41cee972d3","timestamp":"2026-08-23T00:29:41.141Z","subagent_type":"general-purpose","task_description":"Write utf.c differential tests"}
