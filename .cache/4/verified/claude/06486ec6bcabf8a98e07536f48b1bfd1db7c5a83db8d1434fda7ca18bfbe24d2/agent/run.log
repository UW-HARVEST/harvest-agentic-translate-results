{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01W7chAQNLW31vAUZp7vj2Hk","type":"tool_result","content":"1093\t        }\n1094\t        close_both(d, &t);\n1095\t    }\n1096\t}\n1097\t\n1098\t// ---------------------------------------------------------------------------\n1099\t// 12. ERRORS 231 — init_pair's overflow guard\n1100\t// ---------------------------------------------------------------------------\n1101\t//\n1102\t// `hashtable_set` hashes the key (`hash_str(key, key_len)`) *before* it ever\n1103\t// reaches `init_pair`, so a `key_len` at/above the overflow threshold makes\n1104\t// `hashlittle()` walk off the end of the buffer and the process dies long\n1105\t// before the `-1` can be returned. The guard is therefore not observable\n1106\t// in-process; the probe is run in a forked child so the two libraries'\n1107\t// behaviour can still be compared.\n1108\t\n1109\t#[repr(C)]\n1110\tstruct RLimit {\n1111\t    cur: u64,\n1112\t    max: u64,\n1113\t}\n1114\t\n1115\textern \"C\" {\n1116\t    fn fork() -> c_int;\n1117\t    fn waitpid(pid: c_int, status: *mut c_int, options: c_int) -> c_int;\n1118\t    fn _exit(code: c_int) -> !;\n1119\t    fn setrlimit(resource: c_int, rl: *const RLimit) -> c_int;\n1120\t}\n1121\t\n1122\tconst RLIMIT_CORE: c_int = 4;\n1123\t\n1124\t#[derive(PartialEq, Eq, Debug, Clone, Copy)]\n1125\tenum Probe {\n1126\t    /// `hashtable_set` returned; the payload is its return value.\n1127\t    Returned(c_int),\n1128\t    /// The child died from a signal.\n1129\t    Signaled(c_int),\n1130\t    ForkFailed,\n1131\t    Other(c_int),\n1132\t}\n1133\t\n1134\t/// Run `hashtable_set(ht, key, key_len, value)` in a forked child so a crash\n1135\t/// does not take the test process with it.\n1136\tfn probe_set(\n1137\t    l: &Lib,\n1138\t    ht: *mut hashtable_t,\n1139\t    key: *const c_char,\n1140\t    key_len: usize,\n1141\t    value: *mut json_t,\n1142\t) -> Probe {\n1143\t    unsafe {\n1144\t        let pid = fork();\n1145\t        if pid < 0 {\n1146\t            return Probe::ForkFailed;\n1147\t        }\n1148\t        if pid == 0 {\n1149\t            let rl = RLimit { cur: 0, max: 0 };\n1150\t            setrlimit(RLIMIT_CORE, &rl);\n1151\t            let rv = (l.hashtable_set)(ht, key, key_len, value);\n1152\t            // 100 == returned 0, 101 == returned -1, 102 == anything else\n1153\t            _exit(match rv {\n1154\t                0 => 100,\n1155\t                -1 => 101,\n1156\t                _ => 102,\n1157\t            });\n1158\t        }\n1159\t        let mut st: c_int = 0;\n1160\t        if waitpid(pid, &mut st, 0) < 0 {\n1161\t            return Probe::Other(-1);\n1162\t        }\n1163\t        if st & 0x7f == 0 {\n1164\t            match (st >> 8) & 0xff {\n1165\t                100 => Probe::Returned(0),\n1166\t                101 => Probe::Returned(-1),\n1167\t                other => Probe::Other(other),\n1168\t            }\n1169\t        } else if (st & 0x7f) != 0x7f {\n1170\t            Probe::Signaled(st & 0x7f)\n1171\t        } else {\n1172\t            Probe::Other(st)\n1173\t        }\n1174\t    }\n1175\t}\n1176\t\n1177\t#[test]\n1178\tfn long_key_rejection() {\n1179\t    let d = duo();\n1180\t    let t = init_both(d);\n1181\t    // a few ordinary entries so the \"snapshot unchanged\" check has content\n1182\t    for i in 0..10usize {\n1183\t        set_both(d, &t, &key_n(i), i as i64);\n1184\t    }\n1185\t    check(d, &t, || \"before long-key probes\".to_string());\n1186\t    let before_c = snap(&d.c, t.c);\n1187\t\n1188\t    // A short, perfectly valid key buffer; only `key_len` is absurd.\n1189\t    let buf = kbuf(b\"key\");\n1190\t\n1191\t    for &key_len in &[usize::MAX, usize::MAX - 8, usize::MAX - 56, usize::MAX - 57] {\n1192\t        unsafe {\n1193\t            let cv = (d.c.json_integer)(1);\n1194\t            let rv = (d.rs.json_integer)(1);\n1195\t            let cp = probe_set(&d.c, t.c, buf.as_ptr() as *const c_char, key_len, cv);\n1196\t            let rp = probe_set(&d.rs, t.rs, buf.as_ptr() as *const c_char, key_len, rv);\n1197\t            eq_rv(\n1198\t                || format!(\"hashtable_set with key_len = SIZE_MAX-{}\", usize::MAX - key_len),\n1199\t                cp,\n1200\t                rp,\n1201\t            );\n1202\t            // hashtable_set never took ownership in *this* process (the call\n1203\t            // happened in a child), so the values are ours to release.\n1204\t            decref(&d.c, cv);\n1205\t            decref(&d.rs, rv);\n1206\t        }\n1207\t    }\n1208\t\n1209\t    // the parent's tables are untouched\n1210\t    check(d, &t, || \"after long-key probes\".to_string());\n1211\t    eq_rv(\n1212\t        || \"C table unchanged by long-key probes\".to_string(),\n1213\t        before_c,\n1214\t        snap(&d.c, t.c),\n1215\t    );\n1216\t    close_both(d, &t);\n1217\t}\n1218\t"}]},"parent_tool_use_id":"toolu_bdrk_01TfJ2ptRDhUxQLatYnis5yh","session_id":"0aaf00f6-473d-4ae1-b7a7-2a8b9811f369","uuid":"75b1132c-d54c-4bb3-b571-bf09f11ec6cd","timestamp":"2026-08-23T00:39:57.329Z","subagent_type":"general-purpose","task_description":"Write hashtable differential tests"}
