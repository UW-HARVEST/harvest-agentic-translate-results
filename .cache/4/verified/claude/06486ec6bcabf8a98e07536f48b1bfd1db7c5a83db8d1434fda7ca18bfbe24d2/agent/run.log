{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_011hYiYhhQ39do1piwcueBbx","type":"tool_result","content":"1\t//! C-variadic entry points.\n2\t//!\n3\t//! Rust cannot (on stable) *define* C-variadic functions, so the six variadic\n4\t//! functions of the library are provided as naked functions that build an\n5\t//! x86-64 SysV `va_list` exactly like a C compiler would and then tail-call the\n6\t//! corresponding `v*` implementation.\n7\t#![allow(dead_code)]\n8\t\n9\tuse std::ffi::{c_char, c_int};\n10\t\n11\tuse crate::jansson::{json_error_t, json_t};\n12\t\n13\t/*\n14\t * Frame layout (rbp-relative), identical to what GCC emits:\n15\t *\n16\t *   [rbp-208 .. rbp-185]   va_list: gp_offset, fp_offset,\n17\t *                                   overflow_arg_area, reg_save_area\n18\t *   [rbp-176 .. rbp-129]   general purpose register save area (rdi..r9)\n19\t *   [rbp-128 .. rbp-1]     xmm0..xmm7 save area\n20\t *   [rbp+16 .. ]           incoming stack arguments (overflow_arg_area)\n21\t */\n22\t\n23\tmacro_rules! va_prologue {\n24\t    () => {\n25\t        concat!(\n26\t            \"push rbp\\n\",\n27\t            \"mov rbp, rsp\\n\",\n28\t            \"sub rsp, 224\\n\",\n29\t            \"mov qword ptr [rbp - 176], rdi\\n\",\n30\t            \"mov qword ptr [rbp - 168], rsi\\n\",\n31\t            \"mov qword ptr [rbp - 160], rdx\\n\",\n32\t            \"mov qword ptr [rbp - 152], rcx\\n\",\n33\t            \"mov qword ptr [rbp - 144], r8\\n\",\n34\t            \"mov qword ptr [rbp - 136], r9\\n\",\n35\t            \"test al, al\\n\",\n36\t            \"je 2f\\n\",\n37\t            \"movaps xmmword ptr [rbp - 128], xmm0\\n\",\n38\t            \"movaps xmmword ptr [rbp - 112], xmm1\\n\",\n39\t            \"movaps xmmword ptr [rbp - 96], xmm2\\n\",\n40\t            \"movaps xmmword ptr [rbp - 80], xmm3\\n\",\n41\t            \"movaps xmmword ptr [rbp - 64], xmm4\\n\",\n42\t            \"movaps xmmword ptr [rbp - 48], xmm5\\n\",\n43\t            \"movaps xmmword ptr [rbp - 32], xmm6\\n\",\n44\t            \"movaps xmmword ptr [rbp - 16], xmm7\\n\",\n45\t            \"2:\\n\",\n46\t            \"mov dword ptr [rbp - 204], 48\\n\",\n47\t            \"lea rax, [rbp + 16]\\n\",\n48\t            \"mov qword ptr [rbp - 200], rax\\n\",\n49\t            \"lea rax, [rbp - 176]\\n\",\n50\t            \"mov qword ptr [rbp - 192], rax\\n\",\n51\t        )\n52\t    };\n53\t}\n54\t\n55\t/* json_t *json_pack(const char *fmt, ...)\n56\t *     -> json_vpack_ex(NULL, 0, fmt, ap) */\n57\t#[unsafe(naked)]\n58\t#[unsafe(no_mangle)]\n59\tpub unsafe extern \"C\" fn json_pack(fmt: *const c_char) -> *mut json_t {\n60\t    core::arch::naked_asm!(\n61\t        va_prologue!(),\n62\t        \"mov dword ptr [rbp - 208], 8\",\n63\t        \"mov rdx, rdi\",\n64\t        \"xor edi, edi\",\n65\t        \"xor esi, esi\",\n66\t        \"lea rcx, [rbp - 208]\",\n67\t        \"call {f}\",\n68\t        \"leave\",\n69\t        \"ret\",\n70\t        f = sym crate::pack_unpack::json_vpack_ex,\n71\t    )\n72\t}\n73\t\n74\t/* json_t *json_pack_ex(json_error_t *error, size_t flags, const char *fmt, ...)\n75\t *     -> json_vpack_ex(error, flags, fmt, ap) */\n76\t#[unsafe(naked)]\n77\t#[unsafe(no_mangle)]\n78\tpub unsafe extern \"C\" fn json_pack_ex(\n79\t    error: *mut json_error_t,\n80\t    flags: usize,\n81\t    fmt: *const c_char,\n82\t) -> *mut json_t {\n83\t    core::arch::naked_asm!(\n84\t        va_prologue!(),\n85\t        \"mov dword ptr [rbp - 208], 24\",\n86\t        \"lea rcx, [rbp - 208]\",\n87\t        \"call {f}\",\n88\t        \"leave\",\n89\t        \"ret\",\n90\t        f = sym crate::pack_unpack::json_vpack_ex,\n91\t    )\n92\t}\n93\t\n94\t/* int json_unpack(json_t *root, const char *fmt, ...)\n95\t *     -> json_vunpack_ex(root, NULL, 0, fmt, ap) */\n96\t#[unsafe(naked)]\n97\t#[unsafe(no_mangle)]\n98\tpub unsafe extern \"C\" fn json_unpack(root: *mut json_t, fmt: *const c_char) -> c_int {\n99\t    core::arch::naked_asm!(\n100\t        va_prologue!(),\n101\t        \"mov dword ptr [rbp - 208], 16\",\n102\t        \"mov rcx, rsi\",\n103\t        \"xor esi, esi\",\n104\t        \"xor edx, edx\",\n105\t        \"lea r8, [rbp - 208]\",\n106\t        \"call {f}\",\n107\t        \"leave\",\n108\t        \"ret\",\n109\t        f = sym crate::pack_unpack::json_vunpack_ex,\n110\t    )\n111\t}\n112\t\n113\t/* int json_unpack_ex(json_t *root, json_error_t *error, size_t flags,\n114\t *                    const char *fmt, ...)\n115\t *     -> json_vunpack_ex(root, error, flags, fmt, ap) */\n116\t#[unsafe(naked)]\n117\t#[unsafe(no_mangle)]\n118\tpub unsafe extern \"C\" fn json_unpack_ex(\n119\t    root: *mut json_t,\n120\t    error: *mut json_error_t,\n121\t    flags: usize,\n122\t    fmt: *const c_char,\n123\t) -> c_int {\n124\t    core::arch::naked_asm!(\n125\t        va_prologue!(),\n126\t        \"mov dword ptr [rbp - 208], 32\",\n127\t        \"lea r8, [rbp - 208]\",\n128\t        \"call {f}\",\n129\t        \"leave\",\n130\t        \"ret\",\n131\t        f = sym crate::pack_unpack::json_vunpack_ex,\n132\t    )\n133\t}\n134\t\n135\t/* json_t *json_sprintf(const char *fmt, ...)\n136\t *     -> json_vsprintf(fmt, ap) */\n137\t#[unsafe(naked)]\n138\t#[unsafe(no_mangle)]\n139\tpub unsafe extern \"C\" fn json_sprintf(fmt: *const c_char) -> *mut json_t {\n140\t    core::arch::naked_asm!(\n141\t        va_prologue!(),\n142\t        \"mov dword ptr [rbp - 208], 8\",\n143\t        \"lea rsi, [rbp - 208]\",\n144\t        \"call {f}\",\n145\t        \"leave\",\n146\t        \"ret\",\n147\t        f = sym crate::value::json_vsprintf,\n148\t    )\n149\t}\n150\t\n151\t/* void jsonp_error_set(json_error_t *error, int line, int column,\n152\t *                      size_t position, enum json_error_code code,\n153\t *                      const char *msg, ...)\n154\t *     -> jsonp_error_vset(error, line, column, position, code, msg, ap) */\n155\t#[unsafe(naked)]\n156\t#[unsafe(no_mangle)]\n157\tpub unsafe exte