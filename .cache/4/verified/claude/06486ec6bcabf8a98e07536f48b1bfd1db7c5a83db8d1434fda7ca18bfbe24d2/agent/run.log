{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01EBRqnbGXfmwiQnVgUVXCoj","type":"tool_result","content":"1\t//! Differential tests for `value.c` — CONFIGS.md rows 36-70, ERRORS.md rows 1-95.\n2\tmod common;\n3\tuse common::*;\n4\tuse std::ffi::{c_char, c_int, c_void};\n5\tuse std::ptr;\n6\t\n7\t// ---------------------------------------------------------------------------\n8\t// A library-independent description of a value tree, so the *same* tree can be\n9\t// built in the C `.so` and in the Rust `.so`.\n10\t// ---------------------------------------------------------------------------\n11\t\n12\t#[derive(Clone, Debug)]\n13\tpub enum V {\n14\t    Obj(Vec<(Vec<u8>, V)>),\n15\t    Arr(Vec<V>),\n16\t    /// built with `json_stringn` (UTF-8 checked)\n17\t    Str(Vec<u8>),\n18\t    /// built with `json_stringn_nocheck` (no UTF-8 check, may hold NULs)\n19\t    StrRaw(Vec<u8>),\n20\t    Int(i64),\n21\t    Real(f64),\n22\t    True,\n23\t    False,\n24\t    Null,\n25\t}\n26\t\n27\tpub fn build(l: &Lib, v: &V) -> *mut json_t {\n28\t    unsafe {\n29\t        match v {\n30\t            V::Obj(kv) => {\n31\t                let o = (l.json_object)();\n32\t                assert!(!o.is_null());\n33\t                for (k, val) in kv {\n34\t                    let child = build(l, val);\n35\t                    let r = (l.json_object_setn_new_nocheck)(\n36\t                        o,\n37\t                        k.as_ptr() as *const c_char,\n38\t                        k.len(),\n39\t                        child,\n40\t                    );\n41\t                    assert_eq!(r, 0, \"{}: setn_new_nocheck failed\", l.which);\n42\t                }\n43\t                o\n44\t            }\n45\t            V::Arr(items) => {\n46\t                let a = (l.json_array)();\n47\t                assert!(!a.is_null());\n48\t                for it in items {\n49\t                    let child = build(l, it);\n50\t                    let r = (l.json_array_append_new)(a, child);\n51\t                    assert_eq!(r, 0, \"{}: append_new failed\", l.which);\n52\t                }\n53\t                a\n54\t            }\n55\t            V::Str(b) => (l.json_stringn)(b.as_ptr() as *const c_char, b.len()),\n56\t            V::StrRaw(b) => (l.json_stringn_nocheck)(b.as_ptr() as *const c_char, b.len()),\n57\t            V::Int(i) => (l.json_integer)(*i),\n58\t            V::Real(f) => (l.json_real)(*f),\n59\t            V::True => (l.json_true)(),\n60\t            V::False => (l.json_false)(),\n61\t            V::Null => (l.json_null)(),\n62\t        }\n63\t    }\n64\t}\n65\t\n66\t/// Build the same tree in both libraries.\n67\tpub fn build2(d: &Duo, v: &V) -> (*mut json_t, *mut json_t) {\n68\t    (build(&d.c, v), build(&d.rs, v))\n69\t}\n70\t\n71\tpub fn free2(d: &Duo, cj: *mut json_t, rj: *mut json_t) {\n72\t    decref(&d.c, cj);\n73\t    decref(&d.rs, rj);\n74\t}\n75\t\n76\t/// Compare two trees through the public getters only.\n77\t#[track_caller]\n78\tpub fn same(d: &Duo, what: &str, cj: *const json_t, rj: *const json_t) {\n79\t    eq(what, describe(&d.c, cj), describe(&d.rs, rj));\n80\t}\n81\t\n82\t// ---------------------------------------------------------------------------\n83\t// Random corpus\n84\t// ---------------------------------------------------------------------------\n85\t\n86\tpub fn rand_value(rng: &mut Rng, depth: usize) -> V {\n87\t    let leaf = depth == 0 || rng.below(100) < 40;\n88\t    if leaf {\n89\t        match rng.below(8) {\n90\t            0 => { let n = rng.below(8); V::Str(rng.utf8_string(n)) }\n91\t            1 => { let n = rng.below(12); V::Str(rng.ascii_string(n)) }\n92\t            2 => V::Int(match rng.below(4) {\n93\t                0 => 0,\n94\t                1 => rng.next_u64() as i64,\n95\t                2 => rng.range_i64(-1000, 1000),\n96\t                _ => {\n97\t                    if rng.bool() {\n98\t                        i64::MAX\n99\t                    } else {\n100\t                        i64::MIN\n101\t                    }\n102\t                }\n103\t            }),\n104\t            3 => V::Real(rng.tame_f64()),\n105\t            4 => V::Real(rng.finite_f64()),\n106\t            5 => V::True,\n107\t            6 => V::False,\n108\t            _ => V::Null,\n109\t        }\n110\t    } else if rng.bool() {\n111\t        let n = rng.below(6);\n112\t        V::Arr((0..n).map(|_| rand_value(rng, depth - 1)).collect())\n113\t    } else {\n114\t        let n = rng.below(6);\n115\t        let mut kv = Vec::new();\n116\t        for i in 0..n {\n117\t            let kn = 1 + rng.below(4);\n118\t            let mut k = rng.utf8_string(kn);\n119\t            if rng.below(10) == 0 {\n120\t                k = format!(\"dup{}\", i % 2).into_bytes();\n121\t            }\n122\t            kv.push((k, rand_value(rng, depth - 1)));\n123\t        }\n124\t        V::Obj(kv)\n125\t    }\n126\t}\n127\t\n128\tpub fn corpus(n: usize, seed: u64, depth: usize) -> Vec<V> {\n129\t    let mut rng = Rng::new(seed);\n130\t    (0..n).map(|_| rand_value(&mut rng, depth)).collect()\n131\t}\n132\t\n133\t/// A fabricated `json_t` with an out-of-range `json_type`, to test the C's\n134\t/// `default:` branches across the FFI boundary.\n135\tpub fn bogus(ty: c_int) -> Box<json_t> {\n136\t    Box::new(json_t {\n137\t        type_: ty,\n138\t        refcount: usize::MAX,\n139\t    })\n140\t}\n141\t\n142\t// ===========================================================================\n143\t// CONFIGS 36-47, ERRORS 1-39 — objects\n144\t// ===========================================================================\n145\t\n146\t#[test]\n147\tfn object_empty_and_delete() {\n148\t    let d = duo();\n149\t    unsafe {\n150\t        let (c, r) = (( d.c.json_object)(), (d.rs.json_object)());\n151\t        assert!(!c.is_null() && !r.is_null());\n152\t        eq(\"type\", (*c).type_, (*r).type_);\n153\t        eq(\"type is JSON_OBJECT\", (*c).type_, JSON_OBJECT);\n154\t        eq(\"refcount\", (*c).refcount, (*r).refcount);\n155\t        eq(\n156\t            \"size\",\n157\t            (d.c.json_object_size)(c),\n158\t            (d.rs.json_object_size)(r),\n159\t        );\n160\t        same(d, \"empty object\", c, r);\n161\t        free2(d, c, r);\n162\t    }\n163\t}\n164\t\n165\t#[test]\n166\tfn object_set_get_del_counts() {\n167\t    let d = duo();\n168\t    unsafe {\n169\t        for n in [1usize, 7, 8, 9, 64, 200] {\n170\t            let (c, r) = ((d.c.json_object)(), (d.rs.json_object)());\n171\t            for i in 0..n {\n172\t                let k = cs(&format!(\"k{}\", i));\n173\t                let cv = (d.c.json_integer)(i as i64);\n174\t                let rv = (d.rs.json_integer)(i as i64);\n175\t                eq(\n176\t                    &format!(\"set_new n={} i={}\", n, i),\n177\t                    (d.c.json_object_set_new)(c, k.as_ptr(), cv),\n178\t                    (d.rs.json_object_set_new)(r, k.as_ptr(), rv),\n179\t                );\n180\t                same(d, &format!(\"object after set n={} i={}\", n, i), c, r);\n181\t            }\n182\t            // get every key, present and absent\n183\t            for i in 0..n + 5 {\n184\t                let k = cs(&format!(\"k{}\", i));\n185\t                let cg = (d.c.json_object_get)(c, k.as_ptr());\n186\t                let rg = (d.rs.json_object_get)(r, k.as_ptr());\n187\t                eq(&format!(\"get null n={} i={}\", n, i), cg.is_null(), rg.is_null());\n188\t                if !cg.is_null() {\n189\t                    same(d, &format!(\"get value n={} i={}\", n, i), cg, rg);\n190\t                }\n191\t            }\n192\t            // delete all in a shuffled order\n193\t            let mut order: Vec<usize> = (0..n).collect();\n194\t            let mut rng = Rng::new(0xD3_1000 + n as u64);\n195\t            for i in (1..order.len()).rev() {\n196\t                let j = rng.below(i + 1);\n197\t                order.swap(i, j);\n198\t            }\n199\t            for &i in &order {\n200\t                let k = cs(&format!(\"k{}\", i));\n201\t                eq(\n202\t                    &format!(\"del n={} i={}\", n, i),\n203\t                    (d.c.json_object_del)(c, k.as_ptr()),\n204\t                    (d.rs.json_object_del)(r, k.as_ptr()),\n205\t                );\n206\t                // second delete: must be -1 in both\n207\t                eq(\n208\t                    &format!(\"del again n={} i={}\", n, i),\n209\t                    (d.c.json_object_del)(c, k.as_ptr()),\n210\t                    (d.rs.json_object_del)(r, k.as_ptr()),\n211\t                );\n212\t                same(d, &format!(\"object after del n={} i={}\", n, i), c, r);\n213\t            }\n214\t            free2(d, c, r);\n215\t        }\n216\t    }\n217\t}\n218\t\n219\t#[test]\n220\tfn object_setn_key_shapes() {\n221\t    let d = duo();\n222\t    unsafe {\n223\t        let (c, r) = ((d.c.json_object)(), (d.rs.json_object)());\n224\t        // key_len shorter than strlen, empty key, embedded NUL, long key\n225\t        let cases: Vec<(Vec<u8>, usize)> = vec![\n226\t            (b\"\".to_vec(), 0),\n227\t            (b\"a\".to_vec(), 1),\n228\t            (b\"abcdef\".to_vec(), 3),\n229\t            (b\"ab\\0cd\".to_vec(), 5),\n230\t            (b\"\\0\".to_vec(), 1),\n231\t            (vec![b'x'; 255], 255),\n232\t            (vec![b'y'; 1000], 1000),\n233\t            (\"ünïcødé\".as_bytes().to_vec(), \"ünïcødé\".len()),\n234\t            (\"𝄞𝄢\".as_bytes().to_vec(), \"𝄞𝄢\".len()),\n235\t        ];\n236\t        for (i, (k, kl)) in cases.iter().enumerate() {\n237\t            // Pad every key buffer so that `key_len + 1` stays in bounds (the C\n238\t            // hashes exactly `key_len` bytes) and so an EMPTY key still has a\n239\t            // real, dereferenceable pointer rather than Vec's dangling one.\n240\t            let mut pad = k.clone();\n241\t            pad.extend_from_slice(&[0xEEu8; 8]);\n242\t            let kp = pad.as_ptr() as *const c_char;\n243\t\n244\t            let cv = (d.c.json_integer)(i as i64);\n245\t            let rv = (d.rs.json_integer)(i as i64);\n246\t            eq(\n247\t                &format!(\"setn_new key={:?}\", k),\n248\t                (d.c.json_object_setn_new)(c, kp, *kl, cv),\n249\t                (d.rs.json_object_setn_new)(r, kp, *kl, rv),\n250\t            );\n251\t            same(d, &format!(\"object after setn key={:?}\", k), c, r);\n252\t            // getn with the exact len, one shorter and one longer\n253\t            for dl in [0isize, -1, 1] {\n254\t                let l2 = (*kl as isize + dl).max(0) as usize;\n255\t                let cg = (d.c.json_object_getn)(c, kp, l2);\n256\t                let rg = (d.rs.json_object_getn)(r, kp, l2);\n257\t                eq(\n258\t                    &format!(\"getn key={:?} len={}\", k, l2),\n259\t                    cg.is_null(),\n260\t                    rg.is_null(),\n261\t                );\n262\t                if !cg.is_null() {\n263\t                    same(d, \"getn value\", cg, rg);\n264\t                }\n265\t            }\n266\t            // and the nocheck variant with the same shapes\n267\t            let cv = (d.c.json_integer)(1000 + i as i64);\n268\t            let rv = (d.rs.json_integer)(1000 + i as i64);\n269\t            eq(\n270\t                &format!(\"setn_new_nocheck key={:?}\", k),\n271\t                (d.c.json_object_setn_new_nocheck)(c, kp, *kl, cv),\n272\t                (d.rs.json_object_setn_new_nocheck)(r, kp, *kl, rv),\n273\t            );\n274\t            same(d, &format!(\"object after setn_nocheck key={:?}\", k), c, r);\n275\t            // deln with the exact len and one shorter\n276\t            for dl in [1isize, 0] {\n277\t                let l2 = (*kl as isize + dl).max(0) as usize;\n278\t                eq(\n279\t                    &format!(\"deln key={:?} len={}\", k, l2),\n280\t                    (d.c.json_object_deln)(c, kp, l2),\n281\t                    (d.rs.json_object_deln)(r, kp, l2),\n282\t                );\n283\t                same(d, &format!(\"object after deln key={:?} len={}\", k, l2), c, r);\n284\t            }\n285\t        }\n286\t        free2(d, c, r);\n287\t    }\n288\t}\n289\t\n290\t#[test]\n291\tfn object_setn_new_rejects_invalid_utf8_but_nocheck_accepts() {\n292\t    let d = duo();\n293\t    unsafe {\n294\t        let bad: Vec<Vec<u8>> = vec![\n295\t            vec![0x80],\n296\t            vec![0xC0, 0x80],\n297\t            vec![0xC1, 0xBF],\n298\t            vec![0xE0, 0x80, 0x80],\n299\t            vec![0xED, 0xA0, 0x80],\n300\t            vec![0xF5, 0x80, 0x80, 0x80],\n301\t            vec![0xC2],\n302\t            vec![b'a', 0xE2, 0x82],\n303\t        ];\n304\t        for k in &bad {\n305\t            let (c, r) = ((d.c.json_object)(), (d.rs.json_object)());\n306\t            // checked: rejected, value decref'd\n307\t            let cv = (d.c.json_integer)(1);\n308\t            let rv = (d.rs.json_integer)(1);\n309\t            eq(\n310\t                &format!(\"setn_new invalid utf8 {:?}\", k),\n311\t                (d.c.json_object_setn_new)(c, k.as_ptr() as *const c_char, k.len(), cv),\n312\t                (d.rs.json_object_setn_new)(r, k.as_ptr() as *const c_char, k.len(), rv),\n313\t            );\n314\t            same(d, \"object unchanged after reject\", c, r);\n315\t            // nocheck: accepted\n316\t            let cv = (d.c.json_integer)(2);\n317\t            let rv = (d.rs.json_integer)(2);\n318\t            eq(\n319\t                &format!(\"setn_new_nocheck invalid utf8 {:?}\", k),\n320\t                (d.c.json_object_setn_new_nocheck)(c, k.as_ptr() as *const c_char, k.len(), cv),\n321\t                (d.rs.json_object_setn_new_nocheck)(r, k.as_ptr() as *const c_char, k.len(), rv),\n322\t            );\n323\t            same(d, \"object after nocheck accept\", c, r);\n324\t            free2(d, c, r);\n325\t        }\n326\t    }\n327\t}\n328\t\n329\t#[test]\n330\tfn object_clear_and_reuse() {\n331\t    let d = duo();\n332\t    unsafe {\n333\t        for n in [0usize, 1, 64] {\n334\t            let (c, r) = ((d.c.json_object)(), (d.rs.json_object)());\n335\t            for i in 0..n {\n336\t                let k = cs(&format!(\"k{}\", i));\n337\t                (d.c.json_object_set_new)(c, k.as_ptr(), (d.c.json_integer)(i as i64));\n338\t                (d.rs.json_object_set_new)(r, k.as_ptr(), (d.rs.json_integer)(i as i64));\n339\t            }\n340\t            eq(\n341\t                &format!(\"clear n={}\", n),\n342\t                (d.c.json_object_clear)(c),\n343\t                (d.rs.json_object_clear)(r),\n344\t            );\n345\t            same(d, &format!(\"after clear n={}\", n), c, r);\n346\t            for i in 0..20 {\n347\t                let k = cs(&format!(\"z{}\", i));\n348\t                (d.c.json_object_set_new)(c, k.as_ptr(), (d.c.json_integer)(i as i64));\n349\t                (d.rs.json_object_set_new)(r, k.as_ptr(), (d.rs.json_integer)(i as i64));\n350\t                same(d, &format!(\"after reuse n={} i={}\", n, i), c, r);\n351\t            }\n352\t            free2(d, c, r);\n353\t        }\n354\t    }\n355\t}\n356\t\n357\t#[test]\n358\tfn object_update_variants() {\n359\t    let d = duo();\n360\t    let base = V::Obj(vec![\n361\t        (b\"a\".to_vec(), V::Int(1)),\n362\t        (b\"b\".to_vec(), V::Int(2)),\n363\t        (b\"c\".to_vec(), V::Obj(vec![(b\"x\".to_vec(), V::Int(9))])),\n364\t    ]);\n365\t    let others = vec![\n366\t        V::Obj(vec![]),\n367\t        V::Obj(vec![(b\"d\".to_vec(), V::Int(4))]),\n368\t        V::Obj(vec![(b\"a\".to_vec(), V::Int(100))]),\n369\t        V::Obj(vec![\n370\t            (b\"a\".to_vec(), V::Int(100)),\n371\t            (b\"d\".to_vec(), V::Int(4)),\n372\t        ]),\n373\t        V::Obj(vec![(\n374\t            b\"c\".to_vec(),\n375\t            V::Obj(vec![(b\"y\".to_vec(), V::Int(8))]),\n376\t        )]),\n377\t        V::Obj(vec![(b\"c\".to_vec(), V::Int(0))]),\n378\t    ];\n379\t    unsafe {\n380\t        let fns: [(&str, unsafe extern \"C\" fn(*mut json_t, *mut json_t) -> c_int, unsafe extern \"C\" fn(*mut json_t, *mut json_t) -> c_int); 4] = [\n381\t            (\"update\", d.c.json_object_update, d.rs.json_object_update),\n382\t            (\n383\t                \"update_existing\",\n384\t                d.c.json_object_update_existing,\n385\t                d.rs.json_object_update_existing,\n386\t            ),\n387\t            (\n388\t                \"update_missing\",\n389\t                d.c.json_object_update_missing,\n390\t                d.rs.json_object_update_missing,\n391\t            ),\n392\t            (\n393\t                \"update_recursive\",\n394\t                d.c.json_object_update_recursive,\n395\t                d.rs.json_object_update_recursive,\n396\t            ),\n397\t        ];\n398\t        for (name, cf, rf) in fns {\n399\t            for (i, other) in others.iter().enumerate() {\n400\t                let (c, r) = build2(d, &base);\n401\t                let (co, ro) = build2(d, other);\n402\t                eq(&format!(\"{} #{}\", name, i), cf(c, co), rf(r, ro));\n403\t                same(d, &format!(\"{} #{} result\", name, i), c, r);\n404\t                same(d, &format!(\"{} #{} other\", name, i), co, ro);\n405\t                free2(d, co, ro);\n406\t                free2(d, c, r);\n407\t            }\n408\t            // other == object (self-update)\n409\t            let (c, r) = build2(d, &base);\n410\t            eq(&format!(\"{} self\", name), cf(c, c), rf(r, r));\n411\t            same(d, &format!(\"{} self result\", name), c, r);\n412\t            free2(d, c, r);\n413\t        }\n414\t    }\n415\t}\n416\t\n417\t#[test]\n418\tfn object_update_recursive_deep_and_cycle() {\n419\t    let d = duo();\n420\t    unsafe {\n421\t        let deep = V::Obj(vec![(\n422\t            b\"l1\".to_vec(),\n423\t            V::Obj(vec![(\n424\t                b\"l2\".to_vec(),\n425\t                V::Obj(vec![(b\"l3\".to_vec(), V::Int(1))]),\n426\t            )]),\n427\t        )]);\n428\t        let patch = V::Obj(vec![(\n429\t            b\"l1\".to_vec(),\n430\t            V::Obj(vec![(\n431\t                b\"l2\".to_vec(),\n432\t                V::Obj(vec![(b\"l4\".to_vec(), V::Int(2))]),\n433\t            )]),\n434\t        )]);\n435\t        let (c, r) = build2(d, &deep);\n436\t        let (cp, rp) = build2(d, &patch);\n437\t        eq(\n438\t            \"update_recursive deep\",\n439\t            (d.c.json_object_update_recursive)(c, cp),\n440\t            (d.rs.json_object_update_recursive)(r, rp),\n441\t        );\n442\t        same(d, \"update_recursive deep result\", c, r);\n443\t        free2(d, cp, rp);\n444\t        free2(d, c, r);\n445\t\n446\t        // ERRORS 24: `jsonp_loop_check` hit — a cycle in `other`.\n447\t        //\n448\t        // Note `json_object_setn_new_nocheck` refuses `json == value`, so a direct\n449\t        // self-reference is impossible; the cycle must go through a second object.\n450\t        // `do_object_update_recursive` only recurses when BOTH the value in `other`\n451\t        // and the value already in `object` are objects, so `object` needs a\n452\t        // matching 3-level shape for the recursion to revisit `other`:\n453\t        //\n454\t        //     other = { a: inner }, inner = { b: other }\n455\t        //     target = { a: t1 },   t1 = { b: t2 },   t2 = {}\n456\t        //\n457\t        //   do_recursive(target, other) : parents={other}\n458\t        //     do_recursive(t1,   inner) : parents={other,inner}\n459\t        //       do_recursive(t2,  other) : `other` already in parents -> -1\n460\t        let mut rcs = Vec::new();\n461\t        for l in d.both() {\n462\t            let other = (l.json_object)();\n463\t            let inner = (l.json_object)();\n464\t            (l.json_object_set_new)(other, cs(\"a\").as_ptr(), incref(inner));\n465\t            (l.json_object_set_new)(inner, cs(\"b\").as_ptr(), incref(other));\n466\t\n467\t            let target = (l.json_object)();\n468\t            let t1 = (l.json_object)();\n469\t            let t2 = (l.json_object)();\n470\t            (l.json_object_set_new)(t1, cs(\"b\").as_ptr(), t2);\n471\t            (l.json_object_set_new)(target, cs(\"a\").as_ptr(), t1);\n472\t\n473\t            let rc = (l.json_object_update_recursive)(target, other);\n474\t            rcs.push(rc);\n475\t            assert_eq!(rc, -1, \"{}: expected -1 for a cyclic `other`\", l.which);\n476\t\n477\t            // `target` now also holds a reference to `other` (t2.b was set before\n478\t            // the cycle was detected); break every cycle before dropping.\n479\t            (l.json_object_clear)(t2);\n480\t            (l.json_object_del)(inner, cs(\"b\").as_ptr());\n481\t            decref(l, inner);\n482\t            decref(l, other);\n483\t            decref(l, target);\n484\t        }\n485\t        eq(\"update_recursive cycle return\", rcs[0], rcs[1]);\n486\t    }\n487\t}\n488\t\n489\t#[test]\n490\tfn object_iteration_and_iter_set() {\n491\t    let d = duo();\n492\t    unsafe {\n493\t        for n in [0usize, 1, 8, 64] {\n494\t            let (c, r) = ((d.c.json_object)(), (d.rs.json_object)());\n495\t            for i in 0..n {\n496\t                let k = cs(&format!(\"key-{}\", i));\n497\t                (d.c.json_object_set_new)(c, k.as_ptr(), (d.c.json_integer)(i as i64));\n498\t                (d.rs.json_object_set_new)(r, k.as_ptr(), (d.rs.json_integer)(i as i64));\n499\t            }\n500\t            // full traversal, comparing key / key_len / value at every step\n501\t            let mut ci = (d.c.json_object_iter)(c);\n502\t            let mut ri = (d.rs.json_object_iter)(r);\n503\t            let mut steps = 0;\n504\t            loop {\n505\t                eq(&format!(\"iter null n={}\", n), ci.is_null(), ri.is_null());\n506\t                if ci.is_null() {\n507\t                    break;\n508\t                }\n509\t                let ck = (d.c.json_object_iter_key)(ci);\n510\t                let rk = (d.rs.json_object_iter_key)(ri);\n511\t                let ckl = (d.c.json_object_iter_key_len)(ci);\n512\t                let rkl = (d.rs.json_object_iter_key_len)(ri);\n513\t                eq(&format!(\"iter_key_len n={} s={}\", n, steps), ckl, rkl);\n514\t                eq_bytes(\n515\t                    &format!(\"iter_key n={} s={}\", n, steps),\n516\t                    std::slice::from_raw_parts(ck as *const u8, ckl),\n517\t                    std::slice::from_raw_parts(rk as *const u8, rkl),\n518\t                );\n519\t                same(\n520\t                    d,\n521\t                    &format!(\"iter_value n={} s={}\", n, steps),\n522\t                    (d.c.json_object_iter_value)(ci),\n523\t                    (d.rs.json_object_iter_value)(ri),\n524\t                );\n525\t                // key_to_iter must round-trip\n526\t                let ci2 = (d.c.json_object_key_to_iter)(ck);\n527\t                let ri2 = (d.rs.json_object_key_to_iter)(rk);\n528\t                eq(\n529\t                    &format!(\"key_to_iter key_len n={} s={}\", n, steps),\n530\t                    (d.c.json_object_iter_key_len)(ci2),\n531\t                    (d.rs.json_object_iter_key_len)(ri2),\n532\t                );\n533\t                ci = (d.c.json_object_iter_next)(c, ci);\n534\t                ri = (d.rs.json_object_iter_next)(r, ri);\n535\t                steps += 1;\n536\t                assert!(steps <= n + 1);\n537\t            }\n538\t            eq(&format!(\"iteration length n={}\", n), steps, n);\n539\t\n540\t            // iter_at at each key, then traverse to the end\n541\t            for i in 0..n {\n542\t                let k = cs(&format!(\"key-{}\", i));\n543\t                let mut ci = (d.c.json_object_iter_at)(c, k.as_ptr());\n544\t                let mut ri = (d.rs.json_object_iter_at)(r, k.as_ptr());\n545\t                let mut cseq: Vec<Vec<u8>> = Vec::new();\n546\t                let mut rseq: Vec<Vec<u8>> = Vec::new();\n547\t                while !ci.is_null() {\n548\t                    let kl = (d.c.json_object_iter_key_len)(ci);\n549\t                    cseq.push(\n550\t                        std::slice::from_raw_parts(\n551\t                            (d.c.json_object_iter_key)(ci) as *const u8,\n552\t                            kl,\n553\t                        )\n554\t                        .to_vec(),\n555\t                    );\n556\t                    ci = (d.c.json_object_iter_next)(c, ci);\n557\t                }\n558\t                while !ri.is_null() {\n559\t                    let kl = (d.rs.json_object_iter_key_len)(ri);\n560\t                    rseq.push(\n561\t                        std::slice::from_raw_parts(\n562\t                            (d.rs.json_object_iter_key)(ri) as *const u8,\n563\t                            kl,\n564\t                        )\n565\t                        .to_vec(),\n566\t                    );\n567\t                    ri = (d.rs.json_object_iter_next)(r, ri);\n568\t                }\n569\t                eq(&format!(\"iter_at seq n={} i={}\", n, i), cseq, rseq);\n570\t            }\n571\t\n572\t            // iter_set_new at every position\n573\t            let mut ci = (d.c.json_object_iter)(c);\n574\t            let mut ri = (d.rs.json_object_iter)(r);\n575\t            let mut k = 0i64;\n576\t            while !ci.is_null() {\n577\t                eq(\n578\t                    &format!(\"iter_set_new n={} k={}\", n, k),\n579\t                    (d.c.json_object_iter_set_new)(c, ci, (d.c.json_integer)(1000 + k)),\n580\t                    (d.rs.json_object_iter_set_new)(r, ri, (d.rs.json_integer)(1000 + k)),\n581\t                );\n582\t                ci = (d.c.json_object_iter_next)(c, ci);\n583\t                ri = (d.rs.json_object_iter_next)(r, ri);\n584\t                k += 1;\n585\t            }\n586\t            same(d, &format!(\"after iter_set_new n={}\", n), c, r);\n587\t            free2(d, c, r);\n588\t        }\n589\t    }\n590\t}\n591\t\n592\t// ===========================================================================\n593\t// CONFIGS 48-55, ERRORS 40-58 — arrays\n594\t// ===========================================================================\n595\t\n596\t#[test]\n597\tfn array_append_grow() {\n598\t    let d = duo();\n599\t    unsafe {\n600\t        for n in [0usize, 1, 8, 9, 100, 1000] {\n601\t            let (c, r) = ((d.c.json_array)(), (d.rs.json_array)());\n602\t            for i in 0..n {\n603\t                eq(\n604\t                    &format!(\"append n={} i={}\", n, i),\n605\t                    (d.c.json_array_append_new)(c, (d.c.json_integer)(i as i64)),\n606\t                    (d.rs.json_array_append_new)(r, (d.rs.json_integer)(i as i64)),\n607\t                );\n608\t            }\n609\t            eq(\n610\t                &format!(\"size n={}\", n),\n611\t                (d.c.json_array_size)(c),\n612\t                (d.rs.json_array_size)(r),\n613\t            );\n614\t            same(d, &format!(\"array n={}\", n), c, r);\n615\t            // every index plus two past the end\n616\t            for i in 0..n + 2 {\n617\t                let cg = (d.c.json_array_get)(c, i);\n618\t                let rg = (d.rs.json_array_get)(r, i);\n619\t                eq(&format!(\"get n={} i={}\", n, i), cg.is_null(), rg.is_null());\n620\t                if !cg.is_null() {\n621\t                    same(d, \"get value\", cg, rg);\n622\t                }\n623\t            }\n624\t            for i in [usize::MAX, usize::MAX - 1, n.wrapping_sub(1)] {\n625\t                let cg = (d.c.json_array_get)(c, i);\n626\t                let rg = (d.rs.json_array_get)(r, i);\n627\t                eq(&format!(\"get oob n={} i={}\", n, i), cg.is_null(), rg.is_null());\n628\t            }\n629\t            free2(d, c, r);\n630\t        }\n631\t    }\n632\t}\n633\t\n634\t#[test]\n635\tfn array_insert_set_remove_positions() {\n636\t    let d = duo();\n637\t    unsafe {\n638\t        for n in 0usize..11 {\n639\t            for idx in 0..n + 3 {\n640\t                // insert\n641\t                let (c, r) = ((d.c.json_array)(), (d.rs.json_array)());\n642\t                for i in 0..n {\n643\t                    (d.c.json_array_append_new)(c, (d.c.json_integer)(i as i64));\n644\t                    (d.rs.json_array_append_new)(r, (d.rs.json_integer)(i as i64));\n645\t                }\n646\t                eq(\n647\t                    &format!(\"insert n={} idx={}\", n, idx),\n648\t                    (d.c.json_array_insert_new)(c, idx, (d.c.json_integer)(-1)),\n649\t                    (d.rs.json_array_insert_new)(r, idx, (d.rs.json_integer)(-1)),\n650\t                );\n651\t                same(d, &format!(\"after insert n={} idx={}\", n, idx), c, r);\n652\t                // set\n653\t                eq(\n654\t                    &format!(\"set n={} idx={}\", n, idx),\n655\t                    (d.c.json_array_set_new)(c, idx, (d.c.json_integer)(-2)),\n656\t                    (d.rs.json_array_set_new)(r, idx, (d.rs.json_integer)(-2)),\n657\t                );\n658\t                same(d, &format!(\"after set n={} idx={}\", n, idx), c, r);\n659\t                // remove\n660\t                eq(\n661\t                    &format!(\"remove n={} idx={}\", n, idx),\n662\t                    (d.c.json_array_remove)(c, idx),\n663\t                    (d.rs.json_array_remove)(r, idx),\n664\t                );\n665\t                same(d, &format!(\"after remove n={} idx={}\", n, idx), c, r);\n666\t                free2(d, c, r);\n667\t            }\n668\t        }\n669\t        // out-of-range indices\n670\t        for idx in [usize::MAX, usize::MAX - 1, usize::MAX / 2] {\n671\t            let (c, r) = ((d.c.json_array)(), (d.rs.json_array)());\n672\t            (d.c.json_array_append_new)(c, (d.c.json_integer)(0));\n673\t            (d.rs.json_array_append_new)(r, (d.rs.json_integer)(0));\n674\t            eq(\n675\t                &format!(\"set oob idx={}\", idx),\n676\t                (d.c.json_array_set_new)(c, idx, (d.c.json_integer)(1)),\n677\t                (d.rs.json_array_set_new)(r, idx, (d.rs.json_integer)(1)),\n678\t            );\n679\t            eq(\n680\t                &format!(\"insert oob idx={}\", idx),\n681\t                (d.c.json_array_insert_new)(c, idx, (d.c.json_integer)(1)),\n682\t                (d.rs.json_array_insert_new)(r, idx, (d.rs.json_integer)(1)),\n683\t            );\n684\t            eq(\n685\t                &format!(\"remove oob idx={}\", idx),\n686\t                (d.c.json_array_remove)(c, idx),\n687\t                (d.rs.json_array_remove)(r, idx),\n688\t            );\n689\t            same(d, \"array unchanged after oob\", c, r);\n690\t            free2(d, c, r);\n691\t        }\n692\t    }\n693\t}\n694\t\n695\t#[test]\n696\tfn array_clear_and_extend() {\n697\t    let d = duo();\n698\t    unsafe {\n699\t        for n in [0usize, 1, 100] {\n700\t            let (c, r) = ((d.c.json_array)(), (d.rs.json_array)());\n701\t            for i in 0..n {\n702\t                (d.c.json_array_append_new)(c, (d.c.json_integer)(i as i64));\n703\t                (d.rs.json_array_append_new)(r, (d.rs.json_integer)(i as i64));\n704\t            }\n705\t            eq(\n706\t                &format!(\"clear n={}\", n),\n707\t                (d.c.json_array_clear)(c),\n708\t                (d.rs.json_array_clear)(r),\n709\t            );\n710\t            same(d, &format!(\"after clear n={}\", n), c, r);\n711\t            for i in 0..5 {\n712\t                (d.c.json_array_append_new)(c, (d.c.json_integer)(i));\n713\t                (d.rs.json_array_append_new)(r, (d.rs.json_integer)(i));\n714\t            }\n715\t            same(d, &format!(\"after clear+reuse n={}\", n), c, r);\n716\t            free2(d, c, r);\n717\t        }\n718\t        // extend: empty+empty, empty+N, N+empty, N+M\n719\t        for (n, m) in [(0usize, 0usize), (0, 5), (5, 0), (3, 3), (8, 8), (5, 100)] {\n720\t            let (c, r) = ((d.c.json_array)(), (d.rs.json_array)());\n721\t            let (co, ro) = ((d.c.json_array)(), (d.rs.json_array)());\n722\t            for i in 0..n {\n723\t                (d.c.json_array_append_new)(c, (d.c.json_integer)(i as i64));\n724\t                (d.rs.json_array_append_new)(r, (d.rs.json_integer)(i as i64));\n725\t            }\n726\t            for i in 0..m {\n727\t                (d.c.json_array_append_new)(co, (d.c.json_integer)(1000 + i as i64));\n728\t                (d.rs.json_array_append_new)(ro, (d.rs.json_integer)(1000 + i as i64));\n729\t            }\n730\t            eq(\n731\t                &format!(\"extend {}+{}\", n, m),\n732\t                (d.c.json_array_extend)(c, co),\n733\t                (d.rs.json_array_extend)(r, ro),\n734\t            );\n735\t            same(d, &format!(\"extend {}+{} result\", n, m), c, r);\n736\t            same(d, &format!(\"extend {}+{} other\", n, m), co, ro);\n737\t            free2(d, co, ro);\n738\t            free2(d, c, r);\n739\t        }\n740\t        // other == array (self-extend)\n741\t        let (c, r) = ((d.c.json_array)(), (d.rs.json_array)());\n742\t        for i in 0..3 {\n743\t            (d.c.json_array_append_new)(c, (d.c.json_integer)(i));\n744\t            (d.rs.json_array_append_new)(r, (d.rs.json_integer)(i));\n745\t        }\n746\t        eq(\n747\t            \"extend self\",\n748\t            (d.c.json_array_extend)(c, c),\n749\t            (d.rs.json_array_extend)(r, r),\n750\t        );\n751\t        same(d, \"extend self result\", c, r);\n752\t        free2(d, c, r);\n753\t    }\n754\t}\n755\t\n756\t// ===========================================================================\n757\t// CONFIGS 56-64, ERRORS 59-85 — scalars\n758\t// ===========================================================================\n759\t\n760\t#[test]\n761\tfn string_construction_shapes() {\n762\t    let d = duo();\n763\t    let mut rng = Rng::new(0x57_1234);\n764\t    unsafe {\n765\t        let mut cases: Vec<Vec<u8>> = vec![\n766\t            vec![],\n767\t            b\"a\".to_vec(),\n768\t            b\"hello world\".to_vec(),\n769\t            \"ü\".as_bytes().to_vec(),\n770\t            \"€\".as_bytes().to_vec(),\n771\t            \"𝄞\".as_bytes().to_vec(),\n772\t            vec![0x7F],\n773\t            vec![0x00],\n774\t            b\"a\\0b\".to_vec(),\n775\t            vec![0x80],\n776\t            vec![0xC0, 0x80],\n777\t            vec![0xED, 0xA0, 0x80],\n778\t            vec![0xF5, 0x80, 0x80, 0x80],\n779\t            vec![b'x'; 1000],\n780\t        ];\n781\t        for _ in 0..400 {\n782\t            let a = rng.below(20); cases.push(rng.utf8_string(a));\n783\t            let b = rng.below(20); cases.push(rng.random_bytes(b));\n784\t        }\n785\t        for b in &cases {\n786\t            let z = cbuf(b);\n787\t            // json_string (NUL-terminated, checked)\n788\t            let cj = (d.c.json_string)(z.as_ptr() as *const c_char);\n789\t            let rj = (d.rs.json_string)(z.as_ptr() as *const c_char);\n790\t            eq(&format!(\"json_string null {:?}\", b), cj.is_null(), rj.is_null());\n791\t            if !cj.is_null() {\n792\t                same(d, \"json_string\", cj, rj);\n793\t            }\n794\t            free2(d, cj, rj);\n795\t            // json_string_nocheck\n796\t            let cj = (d.c.json_string_nocheck)(z.as_ptr() as *const c_char);\n797\t            let rj = (d.rs.json_string_nocheck)(z.as_ptr() as *const c_char);\n798\t            eq(\"json_string_nocheck null\", cj.is_null(), rj.is_null());\n799\t            if !cj.is_null() {\n800\t                same(d, \"json_string_nocheck\", cj, rj);\n801\t            }\n802\t            free2(d, cj, rj);\n803\t            // json_stringn / json_stringn_nocheck with the exact len, len-1 and len+1\n804\t            for l in [b.len(), b.len().saturating_sub(1), b.len() + 1] {\n805\t                if l > z.len() {\n806\t                    continue;\n807\t                }\n808\t                let cj = (d.c.json_stringn)(z.as_ptr() as *const c_char, l);\n809\t                let rj = (d.rs.json_stringn)(z.as_ptr() as *const c_char, l);\n810\t                eq(\n811\t                    &format!(\"json_stringn null {:?} l={}\", b, l),\n812\t                    cj.is_null(),\n813\t                    rj.is_null(),\n814\t                );\n815\t                if !cj.is_null() {\n816\t                    same(d, \"json_stringn\", cj, rj);\n817\t                }\n818\t                free2(d, cj, rj);\n819\t\n820\t                let cj = (d.c.json_stringn_nocheck)(z.as_ptr() as *const c_char, l);\n821\t                let rj = (d.rs.json_stringn_nocheck)(z.as_ptr() as *const c_char, l);\n822\t                eq(\"json_stringn_nocheck null\", cj.is_null(), rj.is_null());\n823\t                if !cj.is_null() {\n824\t                    same(d, \"json_stringn_nocheck\", cj, rj);\n825\t                }\n826\t                free2(d, cj, rj);\n827\t            }\n828\t        }\n829\t    }\n830\t}\n831\t\n832\t#[test]\n833\tfn string_setters() {\n834\t    let d = duo();\n835\t    let mut rng = Rng::new(0x57_5555);\n836\t    unsafe {\n837\t        let mut cases: Vec<Vec<u8>> = vec![\n838\t            vec![],\n839\t            b\"x\".to_vec(),\n840\t            b\"longer string value\".to_vec(),\n841\t            \"ü€𝄞\".as_bytes().to_vec(),\n842\t            vec![0x80],\n843\t            vec![0xC0, 0x80],\n844\t            b\"a\\0b\".to_vec(),\n845\t            vec![b'q'; 500],\n846\t        ];\n847\t        for _ in 0..200 {\n848\t            let a = rng.below(12); cases.push(rng.utf8_string(a));\n849\t            let b = rng.below(12); cases.push(rng.random_bytes(b));\n850\t        }\n851\t        for b in &cases {\n852\t            let z = cbuf(b);\n853\t            for which in 0..4 {\n854\t                let (c, r) = (\n855\t                    (d.c.json_stringn_nocheck)(b\"seed\\0\".as_ptr() as *const c_char, 4),\n856\t                    (d.rs.json_stringn_nocheck)(b\"seed\\0\".as_ptr() as *const c_char, 4),\n857\t                );\n858\t                let (cv, rv) = match which {\n859\t                    0 => (\n860\t                        (d.c.json_string_set)(c, z.as_ptr() as *const c_char),\n861\t                        (d.rs.json_string_set)(r, z.as_ptr() as *const c_char),\n862\t                    ),\n863\t                    1 => (\n864\t                        (d.c.json_string_setn)(c, z.as_ptr() as *const c_char, b.len()),\n865\t                        (d.rs.json_string_setn)(r, z.as_ptr() as *const c_char, b.len()),\n866\t                    ),\n867\t                    2 => (\n868\t                        (d.c.json_string_set_nocheck)(c, z.as_ptr() as *const c_char),\n869\t                        (d.rs.json_string_set_nocheck)(r, z.as_ptr() as *const c_char),\n870\t                    ),\n871\t                    _ => (\n872\t                        (d.c.json_string_setn_nocheck)(c, z.as_ptr() as *const c_char, b.len()),\n873\t                        (d.rs.json_string_setn_nocheck)(r, z.as_ptr() as *const c_char, b.len()),\n874\t                    ),\n875\t                };\n876\t                eq(&format!(\"string set#{} {:?}\", which, b), cv, rv);\n877\t                same(d, &format!(\"string after set#{}\", which), c, r);\n878\t                free2(d, c, r);\n879\t            }\n880\t        }\n881\t    }\n882\t}\n883\t\n884\t#[test]\n885\tfn integer_and_real_values() {\n886\t    let d = duo();\n887\t    let mut rng = Rng::new(0x1E_4444);\n888\t    unsafe {\n889\t        let mut ints: Vec<i64> = vec![0, 1, -1, i64::MIN, i64::MAX, i64::MIN + 1, i64::MAX - 1];\n890\t        for _ in 0..2000 {\n891\t            ints.push(rng.next_u64() as i64);\n892\t        }\n893\t        for &i in &ints {\n894\t            let (c, r) = ((d.c.json_integer)(i), (d.rs.json_integer)(i));\n895\t            same(d, &format!(\"json_integer {}\", i), c, r);\n896\t            eq(\n897\t                \"integer_value\",\n898\t                (d.c.json_integer_value)(c),\n899\t                (d.rs.json_integer_value)(r),\n900\t            );\n901\t            eq(\n902\t                \"number_value\",\n903\t                (d.c.json_number_value)(c).to_bits(),\n904\t                (d.rs.json_number_value)(r).to_bits(),\n905\t            );\n906\t            for &j in &[0i64, -7, i64::MIN, i64::MAX] {\n907\t                eq(\n908\t                    \"integer_set\",\n909\t                    (d.c.json_integer_set)(c, j),\n910\t                    (d.rs.json_integer_set)(r, j),\n911\t                );\n912\t                same(d, \"after integer_set\", c, r);\n913\t            }\n914\t            free2(d, c, r);\n915\t        }\n916\t\n917\t        let mut reals: Vec<f64> = vec![\n918\t            0.0,\n919\t            -0.0,\n920\t            1.0,\n921\t            -1.0,\n922\t            0.5,\n923\t            f64::MIN,\n924\t            f64::MAX,\n925\t            f64::MIN_POSITIVE,\n926\t            1e-323,\n927\t            f64::NAN,\n928\t            -f64::NAN,\n929\t            f64::INFINITY,\n930\t            f64::NEG_INFINITY,\n931\t        ];\n932\t        for _ in 0..2000 {\n933\t            reals.push(rng.tame_f64());\n934\t            reals.push(rng.finite_f64());\n935\t        }\n936\t        for &f in &reals {\n937\t            let (c, r) = ((d.c.json_real)(f), (d.rs.json_real)(f));\n938\t            eq(\n939\t                &format!(\"json_real null {:#018x}\", f.to_bits()),\n940\t                c.is_null(),\n941\t                r.is_null(),\n942\t            );\n943\t            if c.is_null() {\n944\t                continue;\n945\t            }\n946\t            same(d, \"json_real\", c, r);\n947\t            eq(\n948\t                \"real_value\",\n949\t                (d.c.json_real_value)(c).to_bits(),\n950\t                (d.rs.json_real_value)(r).to_bits(),\n951\t            );\n952\t            eq(\n953\t                \"number_value\",\n954\t                (d.c.json_number_value)(c).to_bits(),\n955\t                (d.rs.json_number_value)(r).to_bits(),\n956\t            );\n957\t            for &g in &[0.0f64, -0.0, 1.5, f64::NAN, f64::INFINITY, f64::NEG_INFINITY] {\n958\t                eq(\n959\t                    &format!(\"real_set {:#018x}\", g.to_bits()),\n960\t                    (d.c.json_real_set)(c, g),\n961\t                    (d.rs.json_real_set)(r, g),\n962\t                );\n963\t                same(d, \"after real_set\", c, r);\n964\t            }\n965\t            free2(d, c, r);\n966\t        }\n967\t    }\n968\t}\n969\t\n970\t#[test]\n971\tfn singletons() {\n972\t    let d = duo();\n973\t    unsafe {\n974\t        for (name, cf, rf) in [\n975\t            (\"json_true\", d.c.json_true, d.rs.json_true),\n976\t            (\"json_false\", d.c.json_false, d.rs.json_false),\n977\t            (\"json_null\", d.c.json_null, d.rs.json_null),\n978\t        ] {\n979\t            let c = cf();\n980\t            let r = rf();\n981\t            eq(&format!(\"{} type\", name), (*c).type_, (*r).type_);\n982\t            eq(&format!(\"{} refcount\", name), (*c).refcount, (*r).refcount);\n983\t            eq(\n984\t                &format!(\"{} refcount is (size_t)-1\", name),\n985\t                (*c).refcount,\n986\t                usize::MAX,\n987\t            );\n988\t            // repeated calls must return the same pointer within one library\n989\t            eq(&format!(\"{} identity C\", name), cf() as usize, c as usize);\n990\t            eq(&format!(\"{} identity RUST\", name), rf() as usize, r as usize);\n991\t            // json_delete on a singleton is a no-op in both\n992\t            (d.c.json_delete)(c);\n993\t            (d.rs.json_delete)(r);\n994\t            eq(&format!(\"{} type after delete\", name), (*c).type_, (*r).type_);\n995\t        }\n996\t    }\n997\t}\n998\t\n999\t// ===========================================================================\n1000\t// CONFIGS 65-69, ERRORS 86-95 — equality / copying / loop check\n1001\t// ===========================================================================\n1002\t\n1003\t#[test]\n1004\tfn equality_all_type_pairs_and_randomized() {\n1005\t    let d = duo();\n1006\t    unsafe {\n1007\t        let vals = vec![\n1008\t            V::Obj(vec![]),\n1009\t            V::Obj(vec![(b\"a\".to_vec(), V::Int(1))]),\n1010\t            V::Obj(vec![(b\"a\".to_vec(), V::Int(2))]),\n1011\t            V::Obj(vec![\n1012\t                (b\"a\".to_vec(), V::Int(1)),\n1013\t                (b\"b\".to_vec(), V::Int(2)),\n1014\t            ]),\n1015\t            // same content, opposite insertion order -> must still be equal\n1016\t            V::Obj(vec![\n1017\t                (b\"b\".to_vec(), V::Int(2)),\n1018\t                (b\"a\".to_vec(), V::Int(1)),\n1019\t            ]),\n1020\t            V::Arr(vec![]),\n1021\t            V::Arr(vec![V::Int(1)]),\n1022\t            V::Arr(vec![V::Int(1), V::Int(2)]),\n1023\t            V::Arr(vec![V::Int(2), V::Int(1)]),\n1024\t            V::Str(b\"\".to_vec()),\n1025\t            V::Str(b\"a\".to_vec()),\n1026\t            V::StrRaw(b\"a\\0b\".to_vec()),\n1027\t            V::StrRaw(b\"a\\0c\".to_vec()),\n1028\t            V::Int(0),\n1029\t            V::Int(1),\n1030\t            V::Real(0.0),\n1031\t            V::Real(-0.0),\n1032\t            V::Real(1.0),\n1033\t            V::True,\n1034\t            V::False,\n1035\t            V::Null,\n1036\t        ];\n1037\t        let cs_: Vec<*mut json_t> = vals.iter().map(|v| build(&d.c, v)).collect();\n1038\t        let rs_: Vec<*mut json_t> = vals.iter().map(|v| build(&d.rs, v)).collect();\n1039\t        for i in 0..vals.len() {\n1040\t            for j in 0..vals.len() {\n1041\t                eq(\n1042\t                    &format!(\"json_equal {} vs {}\", i, j),\n1043\t                    (d.c.json_equal)(cs_[i], cs_[j]),\n1044\t                    (d.rs.json_equal)(rs_[i], rs_[j]),\n1045\t                );\n1046\t            }\n1047\t            // NULL operands (ERRORS 86, 87)\n1048\t            eq(\n1049\t                &format!(\"json_equal NULL,{}\", i),\n1050\t                (d.c.json_equal)(ptr::null(), cs_[i]),\n1051\t                (d.rs.json_equal)(ptr::null(), rs_[i]),\n1052\t            );\n1053\t            eq(\n1054\t                &format!(\"json_equal {},NULL\", i),\n1055\t                (d.c.json_equal)(cs_[i], ptr::null()),\n1056\t                (d.rs.json_equal)(rs_[i], ptr::null()),\n1057\t            );\n1058\t        }\n1059\t        eq(\n1060\t            \"json_equal NULL,NULL\",\n1061\t            (d.c.json_equal)(ptr::null(), ptr::null()),\n1062\t            (d.rs.json_equal)(ptr::null(), ptr::null()),\n1063\t        );\n1064\t        for (c, r) in cs_.iter().zip(rs_.iter()) {\n1065\t            decref(&d.c, *c);\n1066\t            decref(&d.rs, *r);\n1067\t        }\n1068\t\n1069\t        // randomized trees\n1070\t        for (i, v) in corpus(400, 0xE0_1177u64, 4).iter().enumerate() {\n1071\t            let (c1, r1) = build2(d, v);\n1072\t            let (c2, r2) = build2(d, v);\n1073\t            eq(\n1074\t                &format!(\"json_equal same-content #{}\", i),\n1075\t                (d.c.json_equal)(c1, c2),\n1076\t                (d.rs.json_equal)(r1, r2),\n1077\t            );\n1078\t            free2(d, c1, r1);\n1079\t            free2(d, c2, r2);\n1080\t        }\n1081\t    }\n1082\t}\n1083\t\n1084\t#[test]\n1085\tfn copy_and_deep_copy() {\n1086\t    let d = duo();\n1087\t    unsafe {\n1088\t        let mut vals = vec![\n1089\t            V::Obj(vec![]),\n1090\t            V::Arr(vec![]),\n1091\t            V::Str(b\"s\".to_vec()),\n1092\t            V::StrRaw(b\"a\\0b\".to_vec()),\n1093\t            V::Int(7),\n1094\t            V::Real(1.25),\n1095\t            V::True,\n1096\t            V::False,\n1097\t            V::Null,\n1098\t            V::Obj(vec![(\n1099\t                b\"deep\".to_vec(),\n1100\t                V::Arr(vec![\n1101\t                    V::Obj(vec![(b\"x\".to_vec(), V::Arr(vec![V::Int(1), V::Null]))]),\n1102\t                    V::Real(-0.5),\n1103\t                ]),\n1104\t            )]),\n1105\t        ];\n1106\t        vals.extend(corpus(300, 0xC0_9911, 4));\n1107\t        for (i, v) in vals.iter().enumerate() {\n1108\t            let (c, r) = build2(d, v);\n1109\t\n1110\t            let cc = (d.c.json_copy)(c);\n1111\t            let rc = (d.rs.json_copy)(r);\n1112\t            eq(&format!(\"json_copy null #{}\", i), cc.is_null(), rc.is_null());\n1113\t            if !cc.is_null() {\n1114\t                same(d, &format!(\"json_copy #{}\", i), cc, rc);\n1115\t                // shallow: for containers the children are the SAME objects\n1116\t                eq(\n1117\t                    &format!(\"json_copy shallow-identity #{}\", i),\n1118\t                    (*c).type_ == JSON_ARRAY\n1119\t                        && (d.c.json_array_size)(c) > 0\n1120\t                        && (d.c.json_array_get)(cc, 0) == (d.c.json_array_get)(c, 0),\n1121\t                    (*r).type_ == JSON_ARRAY\n1122\t                        && (d.rs.json_array_size)(r) > 0\n1123\t                        && (d.rs.json_array_get)(rc, 0) == (d.rs.json_array_get)(r, 0),\n1124\t                );\n1125\t            }\n1126\t            free2(d, cc, rc);\n1127\t\n1128\t            let cd = (d.c.json_deep_copy)(c);\n1129\t            let rd = (d.rs.json_deep_copy)(r);\n1130\t            eq(\n1131\t                &format!(\"json_deep_copy null #{}\", i),\n1132\t                cd.is_null(),\n1133\t                rd.is_null(),\n1134\t            );\n1135\t            if !cd.is_null() {\n1136\t                same(d, &format!(\"json_deep_copy #{}\", i), cd, rd);\n1137\t                eq(\n1138\t                    &format!(\"deep copy is equal to source #{}\", i),\n1139\t                    (d.c.json_equal)(c, cd),\n1140\t                    (d.rs.json_equal)(r, rd),\n1141\t                );\n1142\t            }\n1143\t            free2(d, cd, rd);\n1144\t            free2(d, c, r);\n1145\t        }\n1146\t        // NULL input (ERRORS 90, 92)\n1147\t        eq(\n1148\t            \"json_copy(NULL)\",\n1149\t            (d.c.json_copy)(ptr::null_mut()).is_null(),\n1150\t            (d.rs.json_copy)(ptr::null_mut()).is_null(),\n1151\t        );\n1152\t        eq(\n1153\t            \"json_deep_copy(NULL)\",\n1154\t            (d.c.json_deep_copy)(ptr::null()).is_null(),\n1155\t            (d.rs.json_deep_copy)(ptr::null()).is_null(),\n1156\t        );\n1157\t    }\n1158\t}\n1159\t\n1160\t#[test]\n1161\tfn deep_copy_detects_cycles() {\n1162\t    let d = duo();\n1163\t    unsafe {\n1164\t        // `json_array_append_new` / `json_object_setn_new_nocheck` reject\n1165\t        // `json == value`, so every cycle has to go through a second container.\n1166\t\n1167\t        // array cycle: a = [b], b = [a]   (ERRORS 95)\n1168\t        let mut rets = Vec::new();\n1169\t        for l in d.both() {\n1170\t            let a = (l.json_array)();\n1171\t            let b = (l.json_array)();\n1172\t            eq_i(\n1173\t                \"append b into a\",\n1174\t                (l.json_array_append_new)(a, incref(b)),\n1175\t                0,\n1176\t            );\n1177\t            eq_i(\n1178\t                \"append a into b\",\n1179\t                (l.json_array_append_new)(b, incref(a)),\n1180\t                0,\n1181\t            );\n1182\t            let cp = (l.json_deep_copy)(a);\n1183\t            rets.push(cp.is_null());\n1184\t            assert!(\n1185\t                cp.is_null(),\n1186\t                \"{}: deep_copy of a cyclic array must be NULL\",\n1187\t                l.which\n1188\t            );\n1189\t            // also from the other end\n1190\t            assert!((l.json_deep_copy)(b).is_null(), \"{}\", l.which);\n1191\t            (l.json_array_clear)(a);\n1192\t            (l.json_array_clear)(b);\n1193\t            decref(l, a);\n1194\t            decref(l, b);\n1195\t        }\n1196\t        eq(\"array-cycle deep_copy NULL-ness\", rets[0], rets[1]);\n1197\t\n1198\t        // object cycle: o1.x = o2, o2.y = o1   (ERRORS 94)\n1199\t        let mut rets = Vec::new();\n1200\t        for l in d.both() {\n1201\t            let o1 = (l.json_object)();\n1202\t            let o2 = (l.json_object)();\n1203\t            eq_i(\n1204\t                \"set o2 into o1\",\n1205\t                (l.json_object_set_new)(o1, cs(\"x\").as_ptr(), incref(o2)),\n1206\t                0,\n1207\t            );\n1208\t            eq_i(\n1209\t                \"set o1 into o2\",\n1210\t                (l.json_object_set_new)(o2, cs(\"y\").as_ptr(), incref(o1)),\n1211\t                0,\n1212\t            );\n1213\t            let cp = (l.json_deep_copy)(o1);\n1214\t            rets.push(cp.is_null());\n1215\t            assert!(\n1216\t                cp.is_null(),\n1217\t                \"{}: deep_copy of a cyclic object must be NULL\",\n1218\t                l.which\n1219\t            );\n1220\t            assert!((l.json_deep_copy)(o2).is_null(), \"{}\", l.which);\n1221\t            (l.json_object_clear)(o1);\n1222\t            (l.json_object_clear)(o2);\n1223\t            decref(l, o1);\n1224\t            decref(l, o2);\n1225\t        }\n1226\t        eq(\"object-cycle deep_copy NULL-ness\", rets[0], rets[1]);\n1227\t\n1228\t        // mixed 3-hop cycle: arr -> obj -> arr\n1229\t        let mut rets = Vec::new();\n1230\t        for l in d.both() {\n1231\t            let a = (l.json_array)();\n1232\t            let o = (l.json_object)();\n1233\t            let a2 = (l.json_array)();\n1234\t            (l.json_array_append_new)(a, incref(o));\n1235\t            (l.json_object_set_new)(o, cs(\"k\").as_ptr(), incref(a2));\n1236\t            (l.json_array_append_new)(a2, incref(a));\n1237\t            let cp = (l.json_deep_copy)(a);\n1238\t            rets.push(cp.is_null());\n1239\t            assert!(cp.is_null(), \"{}: 3-hop cycle must be NULL\", l.which);\n1240\t            (l.json_array_clear)(a);\n1241\t            (l.json_object_clear)(o);\n1242\t            (l.json_array_clear)(a2);\n1243\t            decref(l, a);\n1244\t            decref(l, o);\n1245\t            decref(l, a2);\n1246\t        }\n1247\t        eq(\"3-hop-cycle deep_copy NULL-ness\", rets[0], rets[1]);\n1248\t\n1249\t        // A DAG (same node reachable twice, but no cycle) must SUCCEED.\n1250\t        let mut dumps = Vec::new();\n1251\t        for l in d.both() {\n1252\t            let shared = (l.json_array)();\n1253\t            (l.json_array_append_new)(shared, (l.json_integer)(7));\n1254\t            let a = (l.json_array)();\n1255\t            (l.json_array_append_new)(a, incref(shared));\n1256\t            (l.json_array_append_new)(a, incref(shared));\n1257\t            let cp = (l.json_deep_copy)(a);\n1258\t            assert!(!cp.is_null(), \"{}: DAG deep_copy must succeed\", l.which);\n1259\t            let s = (l.json_dumps)(cp, 0);\n1260\t            dumps.push(cstr_bytes(s));\n1261\t            (l.jsonp_free)(s as *mut c_void);\n1262\t            decref(l, cp);\n1263\t            decref(l, a);\n1264\t            decref(l, shared);\n1265\t        }\n1266\t        eq_bytes(\"DAG deep_copy dump\", &dumps[0], &dumps[1]);\n1267\t    }\n1268\t}\n1269\t\n1270\t#[track_caller]\n1271\tfn eq_i(what: &str, got: c_int, want: c_int) {\n1272\t    assert_eq!(got, want, \"{}\", what);\n1273\t}\n1274\t\n1275\t#[test]\n1276\tfn do_deep_copy_and_loop_check_low_level() {\n1277\t    let d = duo();\n1278\t    unsafe {\n1279\t        // CONFIGS 68: jsonp_loop_check with a caller-supplied hashtable\n1280\t        for l in d.both() {\n1281\t            let mut ht = hashtable_t::zeroed();\n1282\t            assert_eq!((l.hashtable_init)(&mut ht), 0);\n1283\t            let v = (l.json_integer)(1);\n1284\t            let mut key = [0u8; 32];\n1285\t            let mut klen: usize = usize::MAX;\n1286\t            let r1 = (l.jsonp_loop_check)(\n1287\t                &mut ht,\n1288\t                v,\n1289\t                key.as_mut_ptr() as *mut c_char,\n1290\t                key.len(),\n1291\t                &mut klen,\n1292\t            );\n1293\t            assert_eq!(r1, 0, \"{}: first loop_check must succeed\", l.which);\n1294\t            assert_eq!(klen, cstr_bytes(key.as_ptr() as *const c_char).len());\n1295\t            let r2 = (l.jsonp_loop_check)(\n1296\t                &mut ht,\n1297\t                v,\n1298\t                key.as_mut_ptr() as *mut c_char,\n1299\t                key.len(),\n1300\t                ptr::null_mut(),\n1301\t            );\n1302\t            assert_eq!(r2, -1, \"{}: second loop_check must return -1\", l.which);\n1303\t            (l.hashtable_close)(&mut ht);\n1304\t            decref(l, v);\n1305\t        }\n1306\t        // both libraries must agree on the key length written for the same pointer\n1307\t        // shape (the pointer value itself differs, so compare only the length range)\n1308\t        // CONFIGS 69: do_deep_copy / do_object_update_recursive called directly\n1309\t        let v = V::Obj(vec![\n1310\t            (b\"a\".to_vec(), V::Arr(vec![V::Int(1), V::Str(b\"s\".to_vec())])),\n1311\t            (b\"b\".to_vec(), V::Real(2.5)),\n1312\t        ]);\n1313\t        let (c, r) = build2(d, &v);\n1314\t        let mut cht = hashtable_t::zeroed();\n1315\t        let mut rht = hashtable_t::zeroed();\n1316\t        assert_eq!((d.c.hashtable_init)(&mut cht), 0);\n1317\t        assert_eq!((d.rs.hashtable_init)(&mut rht), 0);\n1318\t        let cc = (d.c.do_deep_copy)(c, &mut cht);\n1319\t        let rc = (d.rs.do_deep_copy)(r, &mut rht);\n1320\t        eq(\"do_deep_copy null\", cc.is_null(), rc.is_null());\n1321\t        same(d, \"do_deep_copy\", cc, rc);\n1322\t        eq(\"parents table drained C\", cht.size, 0);\n1323\t        eq(\"parents table drained RUST\", rht.size, 0);\n1324\t        free2(d, cc, rc);\n1325\t        (d.c.hashtable_close)(&mut cht);\n1326\t        (d.rs.hashtable_close)(&mut rht);\n1327\t\n1328\t        // do_object_update_recursive with an external table\n1329\t        let patch = V::Obj(vec![(b\"b\".to_vec(), V::Int(9))]);\n1330\t        let (cp, rp) = build2(d, &patch);\n1331\t        let mut cht = hashtable_t::zeroed();\n1332\t        let mut rht = hashtable_t::zeroed();\n1333\t        assert_eq!((d.c.hashtable_init)(&mut cht), 0);\n1334\t        assert_eq!((d.rs.hashtable_init)(&mut rht), 0);\n1335\t        eq(\n1336\t            \"do_object_update_recursive\",\n1337\t            (d.c.do_object_update_recursive)(c, cp, &mut cht),\n1338\t            (d.rs.do_object_update_recursive)(r, rp, &mut rht),\n1339\t        );\n1340\t        same(d, \"do_object_update_recursive result\", c, r);\n1341\t        (d.c.hashtable_close)(&mut cht);\n1342\t        (d.rs.hashtable_close)(&mut rht);\n1343\t        free2(d, cp, rp);\n1344\t        free2(d, c, r);\n1345\t    }\n1346\t}\n1347\t\n1348\t// ===========================================================================\n1349\t// CONFIGS 70 — json_sprintf / json_vsprintf\n1350\t// ===========================================================================\n1351\t\n1352\t#[test]\n1353\tfn sprintf_variants() {\n1354\t    let d = duo();\n1355\t    unsafe {\n1356\t        // json_vsprintf with a hand-built va_list, and json_sprintf variadically\n1357\t        let long = \"x\".repeat(2000);\n1358\t        let cases: Vec<(&str, Vec<u64>)> = vec![\n1359\t            (\"\", vec![]),\n1360\t            (\"plain\", vec![]),\n1361\t            (\"%d\", vec![42u32 as u64]),\n1362\t            (\"%d-%d\", vec![7u32 as u64, (-7i32) as u32 as u64]),\n1363\t            (\"%%\", vec![]),\n1364\t            (\"%5d|\", vec![3u32 as u64]),\n1365\t            (\"%c\", vec![b'A' as u64]),\n1366\t            (\"%x\", vec![0xdeadbeefu32 as u64]),\n1367\t        ];\n1368\t        for (fmt, words) in &cases {\n1369\t            let f = cs(fmt);\n1370\t            let mut cv = VaArgs::new();\n1371\t            for w in words {\n1372\t                cv = cv.i64(*w as i64);\n1373\t            }\n1374\t            let ap = cv.build();\n1375\t            let cj = (d.c.json_vsprintf)(f.as_ptr(), ap);\n1376\t            let mut rv = VaArgs::new();\n1377\t            for w in words {\n1378\t                rv = rv.i64(*w as i64);\n1379\t            }\n1380\t            let ap = rv.build();\n1381\t            let rj = (d.rs.json_vsprintf)(f.as_ptr(), ap);\n1382\t            eq(\n1383\t                &format!(\"json_vsprintf null {:?}\", fmt),\n1384\t                cj.is_null(),\n1385\t                rj.is_null(),\n1386\t            );\n1387\t            if !cj.is_null() {\n1388\t                same(d, &format!(\"json_vsprintf {:?}\", fmt), cj, rj);\n1389\t            }\n1390\t            free2(d, cj, rj);\n1391\t        }\n1392\t        // %s and %f need pointer / double slots\n1393\t        let s = cs(\"héllo\");\n1394\t        let f = cs(\"%s\");\n1395\t        for l in d.both() {\n1396\t            let mut va = VaArgs::new().ptr(s.as_ptr());\n1397\t            let ap = va.build();\n1398\t            let j = (l.json_vsprintf)(f.as_ptr(), ap);\n1399\t            assert!(!j.is_null());\n1400\t            let p = (l.json_string_value)(j);\n1401\t            eq_bytes(&format!(\"{} vsprintf %s\", l.which), \"héllo\".as_bytes(), &cstr_bytes(p));\n1402\t            decref(l, j);\n1403\t        }\n1404\t        let f = cs(\"%.3f\");\n1405\t        let cj;\n1406\t        let rj;\n1407\t        {\n1408\t            let mut va = VaArgs::new().f64(1.0 / 3.0);\n1409\t            cj = (d.c.json_vsprintf)(f.as_ptr(), va.build());\n1410\t        }\n1411\t        {\n1412\t            let mut va = VaArgs::new().f64(1.0 / 3.0);\n1413\t            rj = (d.rs.json_vsprintf)(f.as_ptr(), va.build());\n1414\t        }\n1415\t        same(d, \"json_vsprintf %.3f\", cj, rj);\n1416\t        free2(d, cj, rj);\n1417\t\n1418\t        // long (> 1 KiB) result\n1419\t        let f = cs(\"%s\");\n1420\t        let ls = cs(&long);\n1421\t        let cj;\n1422\t        let rj;\n1423\t        {\n1424\t            let mut va = VaArgs::new().ptr(ls.as_ptr());\n1425\t            cj = (d.c.json_vsprintf)(f.as_ptr(), va.build());\n1426\t        }\n1427\t        {\n1428\t            let mut va = VaArgs::new().ptr(ls.as_ptr());\n1429\t            rj = (d.rs.json_vsprintf)(f.as_ptr(), va.build());\n1430\t        }\n1431\t        same(d, \"json_vsprintf long\", cj, rj);\n1432\t        free2(d, cj, rj);\n1433\t\n1434\t        // invalid UTF-8 in the formatted result -> NULL (ERRORS 73)\n1435\t        let bad = [0x80u8, 0x00];\n1436\t        let f = cs(\"%s\");\n1437\t        let cj;\n1438\t        let rj;\n1439\t        {\n1440\t            let mut va = VaArgs::new().ptr(bad.as_ptr());\n1441\t            cj = (d.c.json_vsprintf)(f.as_ptr(), va.build());\n1442\t        }\n1443\t        {\n1444\t            let mut va = VaArgs::new().ptr(bad.as_ptr());\n1445\t            rj = (d.rs.json_vsprintf)(f.as_ptr(), va.build());\n1446\t        }\n1447\t        eq(\"json_vsprintf invalid utf8\", cj.is_null(), rj.is_null());\n1448\t        assert!(cj.is_null(), \"C must reject invalid UTF-8\");\n1449\t        free2(d, cj, rj);\n1450\t\n1451\t        // empty result -> json_string(\"\") (ERRORS 74)\n1452\t        let f = cs(\"\");\n1453\t        let cj;\n1454\t        let rj;\n1455\t        {\n1456\t            let mut va = VaArgs::new();\n1457\t            cj = (d.c.json_vsprintf)(f.as_ptr(), va.build());\n1458\t        }\n1459\t        {\n1460\t            let mut va = VaArgs::new();\n1461\t            rj = (d.rs.json_vsprintf)(f.as_ptr(), va.build());\n1462\t        }\n1463\t        same(d, \"json_vsprintf empty\", cj, rj);\n1464\t        eq(\"empty is a string\", (*cj).type_, JSON_STRING);\n1465\t        free2(d, cj, rj);\n1466\t\n1467\t        // the variadic wrapper (exercises the naked-asm export)\n1468\t        let f = cs(\"%d/%s/%d\");\n1469\t        let s = cs(\"mid\");\n1470\t        let cj = (d.c.json_sprintf)(f.as_ptr(), 11i32, s.as_ptr(), 22i32);\n1471\t        let rj = (d.rs.json_sprintf)(f.as_ptr(), 11i32, s.as_ptr(), 22i32);\n1472\t        same(d, \"json_sprintf variadic\", cj, rj);\n1473\t        free2(d, cj, rj);\n1474\t    }\n1475\t}\n1476\t\n1477\t// ===========================================================================\n1478\t// ERRORS: NULL / wrong-type / out-of-range-enum rejection matrix\n1479\t// ===========================================================================\n1480\t\n1481\t#[test]\n1482\tfn wrong_type_and_null_rejection_matrix() {\n1483\t    let d = duo();\n1484\t    unsafe {\n1485\t        // one value of every type in each library, plus NULL and a fabricated\n1486\t        // json_t with an out-of-range json_type (ERRORS 85, 89, 91, 93, 256)\n1487\t        let mut b42 = bogus(42);\n1488\t        let mut bneg = bogus(-1);\n1489\t        let mut b8 = bogus(8);\n1490\t        let types = vec![\n1491\t            V::Obj(vec![(b\"k\".to_vec(), V::Int(1))]),\n1492\t            V::Arr(vec![V::Int(1)]),\n1493\t            V::Str(b\"s\".to_vec()),\n1494\t            V::Int(1),\n1495\t            V::Real(1.0),\n1496\t            V::True,\n1497\t            V::False,\n1498\t            V::Null,\n1499\t        ];\n1500\t        let mut cvals: Vec<*mut json_t> = types.iter().map(|v| build(&d.c, v)).collect();\n1501\t        let mut rvals: Vec<*mut json_t> = types.iter().map(|v| build(&d.rs, v)).collect();\n1502\t        // NULL and the bogus values are shared between the libraries (they are\n1503\t        // plain memory, not owned by either allocator)\n1504\t        for extra in [\n1505\t            ptr::null_mut(),\n1506\t            &mut *b42 as *mut json_t,\n1507\t            &mut *bneg as *mut json_t,\n1508\t            &mut *b8 as *mut json_t,\n1509\t        ] {\n1510\t            cvals.push(extra);\n1511\t            rvals.push(extra);\n1512\t        }\n1513\t\n1514\t        let key = cs(\"k\");\n1515\t        let absent = cs(\"nope\");\n1516\t        for i in 0..cvals.len() {\n1517\t            let (c, r) = (cvals[i], rvals[i]);\n1518\t            let tag = format!(\"#{}\", i);\n1519\t\n1520\t            eq(\n1521\t                &format!(\"object_size {}\", tag),\n1522\t                (d.c.json_object_size)(c),\n1523\t                (d.rs.json_object_size)(r),\n1524\t            );\n1525\t            eq(\n1526\t                &format!(\"object_get {}\", tag),\n1527\t                (d.c.json_object_get)(c, key.as_ptr()).is_null(),\n1528\t                (d.rs.json_object_get)(r, key.as_ptr()).is_null(),\n1529\t            );\n1530\t            eq(\n1531\t                &format!(\"object_get NULL key {}\", tag),\n1532\t                (d.c.json_object_get)(c, ptr::null()).is_null(),\n1533\t                (d.rs.json_object_get)(r, ptr::null()).is_null(),\n1534\t            );\n1535\t            eq(\n1536\t                &format!(\"object_getn NULL key {}\", tag),\n1537\t                (d.c.json_object_getn)(c, ptr::null(), 0).is_null(),\n1538\t                (d.rs.json_object_getn)(r, ptr::null(), 0).is_null(),\n1539\t            );\n1540\t            eq(\n1541\t                &format!(\"object_del {}\", tag),\n1542\t                (d.c.json_object_del)(c, absent.as_ptr()),\n1543\t                (d.rs.json_object_del)(r, absent.as_ptr()),\n1544\t            );\n1545\t            eq(\n1546\t                &format!(\"object_del NULL key {}\", tag),\n1547\t                (d.c.json_object_del)(c, ptr::null()),\n1548\t                (d.rs.json_object_del)(r, ptr::null()),\n1549\t            );\n1550\t            eq(\n1551\t                &format!(\"object_deln NULL key {}\", tag),\n1552\t                (d.c.json_object_deln)(c, ptr::null(), 0),\n1553\t                (d.rs.json_object_deln)(r, ptr::null(), 0),\n1554\t            );\n1555\t            eq(\n1556\t                &format!(\"object_clear {}\", tag),\n1557\t                (d.c.json_object_clear)(c),\n1558\t                (d.rs.json_object_clear)(r),\n1559\t            );\n1560\t            eq(\n1561\t                &format!(\"object_iter {}\", tag),\n1562\t                (d.c.json_object_iter)(c).is_null(),\n1563\t                (d.rs.json_object_iter)(r).is_null(),\n1564\t            );\n1565\t            eq(\n1566\t                &format!(\"object_iter_at {}\", tag),\n1567\t                (d.c.json_object_iter_at)(c, absent.as_ptr()).is_null(),\n1568\t                (d.rs.json_object_iter_at)(r, absent.as_ptr()).is_null(),\n1569\t            );\n1570\t            eq(\n1571\t                &format!(\"object_iter_at NULL key {}\", tag),\n1572\t                (d.c.json_object_iter_at)(c, ptr::null()).is_null(),\n1573\t                (d.rs.json_object_iter_at)(r, ptr::null()).is_null(),\n1574\t            );\n1575\t            eq(\n1576\t                &format!(\"object_iter_next NULL iter {}\", tag),\n1577\t                (d.c.json_object_iter_next)(c, ptr::null_mut()).is_null(),\n1578\t                (d.rs.json_object_iter_next)(r, ptr::null_mut()).is_null(),\n1579\t            );\n1580\t            eq(\n1581\t                &format!(\"object_iter_set_new NULL iter {}\", tag),\n1582\t                (d.c.json_object_iter_set_new)(c, ptr::null_mut(), (d.c.json_integer)(1)),\n1583\t                (d.rs.json_object_iter_set_new)(r, ptr::null_mut(), (d.rs.json_integer)(1)),\n1584\t            );\n1585\t            eq(\n1586\t                &format!(\"object_iter_set_new NULL value {}\", tag),\n1587\t                (d.c.json_object_iter_set_new)(c, 1usize as *mut c_void, ptr::null_mut()),\n1588\t                (d.rs.json_object_iter_set_new)(r, 1usize as *mut c_void, ptr::null_mut()),\n1589\t            );\n1590\t\n1591\t            eq(\n1592\t                &format!(\"array_size {}\", tag),\n1593\t                (d.c.json_array_size)(c),\n1594\t                (d.rs.json_array_size)(r),\n1595\t            );\n1596\t            for idx in [0usize, 1, usize::MAX] {\n1597\t                eq(\n1598\t                    &format!(\"array_get {} idx={}\", tag, idx),\n1599\t                    (d.c.json_array_get)(c, idx).is_null(),\n1600\t                    (d.rs.json_array_get)(r, idx).is_null(),\n1601\t                );\n1602\t                eq(\n1603\t                    &format!(\"array_remove {} idx={}\", tag, idx),\n1604\t                    (d.c.json_array_remove)(c, idx),\n1605\t                    (d.rs.json_array_remove)(r, idx),\n1606\t                );\n1607\t                eq(\n1608\t                    &format!(\"array_set_new NULL value {} idx={}\", tag, idx),\n1609\t                    (d.c.json_array_set_new)(c, idx, ptr::null_mut()),\n1610\t                    (d.rs.json_array_set_new)(r, idx, ptr::null_mut()),\n1611\t                );\n1612\t                eq(\n1613\t                    &format!(\"array_insert_new NULL value {} idx={}\", tag, idx),\n1614\t                    (d.c.json_array_insert_new)(c, idx, ptr::null_mut()),\n1615\t                    (d.rs.json_array_insert_new)(r, idx, ptr::null_mut()),\n1616\t                );\n1617\t            }\n1618\t            eq(\n1619\t                &format!(\"array_clear {}\", tag),\n1620\t                (d.c.json_array_clear)(c),\n1621\t                (d.rs.json_array_clear)(r),\n1622\t            );\n1623\t            eq(\n1624\t                &format!(\"array_append_new NULL value {}\", tag),\n1625\t                (d.c.json_array_append_new)(c, ptr::null_mut()),\n1626\t                (d.rs.json_array_append_new)(r, ptr::null_mut()),\n1627\t            );\