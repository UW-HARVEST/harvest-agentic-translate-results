{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01PxEJeYG6BjT6NehJ5Uv7sZ","type":"tool_result","content":"1\t//! Translation of c_src/src/memory.c\n2\tuse crate::jansson::{json_free_t, json_malloc_t, json_realloc_t};\n3\tuse crate::libc;\n4\tuse std::ffi::{c_char, c_void};\n5\t\n6\t/* The C source initialises these to the C library's malloc/realloc/free. */\n7\tstatic mut DO_MALLOC: json_malloc_t = Some(libc::malloc);\n8\tstatic mut DO_REALLOC: json_realloc_t = Some(libc::realloc);\n9\tstatic mut DO_FREE: json_free_t = Some(libc::free);\n10\t\n11\t#[unsafe(no_mangle)]\n12\tpub unsafe extern \"C\" fn jsonp_malloc(size: usize) -> *mut c_void {\n13\t    if size == 0 {\n14\t        return std::ptr::null_mut();\n15\t    }\n16\t\n17\t    (DO_MALLOC.unwrap())(size)\n18\t}\n19\t\n20\t#[unsafe(no_mangle)]\n21\tpub unsafe extern \"C\" fn jsonp_free(ptr: *mut c_void) {\n22\t    if ptr.is_null() {\n23\t        return;\n24\t    }\n25\t\n26\t    (DO_FREE.unwrap())(ptr)\n27\t}\n28\t\n29\t#[unsafe(no_mangle)]\n30\tpub unsafe extern \"C\" fn jsonp_realloc(\n31\t    ptr: *mut c_void,\n32\t    original_size: usize,\n33\t    new_size: usize,\n34\t) -> *mut c_void {\n35\t    let new_memory: *mut c_void;\n36\t\n37\t    if let Some(f) = DO_REALLOC {\n38\t        return f(ptr, new_size);\n39\t    }\n40\t\n41\t    // realloc emulation using malloc and free\n42\t    if new_size == 0 {\n43\t        if !ptr.is_null() {\n44\t            (DO_FREE.unwrap())(ptr);\n45\t        }\n46\t\n47\t        std::ptr::null_mut()\n48\t    } else {\n49\t        new_memory = (DO_MALLOC.unwrap())(new_size);\n50\t\n51\t        if !new_memory.is_null() && !ptr.is_null() {\n52\t            libc::memcpy(\n53\t                new_memory,\n54\t                ptr,\n55\t                if original_size < new_size {\n56\t                    original_size\n57\t                } else {\n58\t                    new_size\n59\t                },\n60\t            );\n61\t\n62\t            (DO_FREE.unwrap())(ptr);\n63\t        }\n64\t\n65\t        new_memory\n66\t    }\n67\t}\n68\t\n69\t#[unsafe(no_mangle)]\n70\tpub unsafe extern \"C\" fn jsonp_strndup(str_: *const c_char, len: usize) -> *mut c_char {\n71\t    let new_str: *mut c_char;\n72\t\n73\t    new_str = jsonp_malloc(len + 1) as *mut c_char;\n74\t    if new_str.is_null() {\n75\t        return std::ptr::null_mut();\n76\t    }\n77\t\n78\t    libc::memcpy(new_str as *mut c_void, str_ as *const c_void, len);\n79\t    *new_str.add(len) = 0;\n80\t    new_str\n81\t}\n82\t\n83\t#[unsafe(no_mangle)]\n84\tpub unsafe extern \"C\" fn json_set_alloc_funcs(malloc_fn: json_malloc_t, free_fn: json_free_t) {\n85\t    DO_MALLOC = malloc_fn;\n86\t    DO_REALLOC = None;\n87\t    DO_FREE = free_fn;\n88\t}\n89\t\n90\t#[unsafe(no_mangle)]\n91\tpub unsafe extern \"C\" fn json_set_alloc_funcs2(\n92\t    malloc_fn: json_malloc_t,\n93\t    realloc_fn: json_realloc_t,\n94\t    free_fn: json_free_t,\n95\t) {\n96\t    DO_MALLOC = malloc_fn;\n97\t    DO_REALLOC = realloc_fn;\n98\t    DO_FREE = free_fn;\n99\t}\n100\t\n101\t#[unsafe(no_mangle)]\n102\tpub unsafe extern \"C\" fn json_get_alloc_funcs(\n103\t    malloc_fn: *mut json_malloc_t,\n104\t    free_fn: *mut json_free_t,\n105\t) {\n106\t    if !malloc_fn.is_null() {\n107\t        *malloc_fn = DO_MALLOC;\n108\t    }\n109\t    if !free_fn.is_null() {\n110\t        *free_fn = DO_FREE;\n111\t    }\n112\t}\n113\t\n114\t#[unsafe(no_mangle)]\n115\tpub unsafe extern \"C\" fn json_get_alloc_funcs2(\n116\t    malloc_fn: *mut json_malloc_t,\n117\t    realloc_fn: *mut json_realloc_t,\n118\t    free_fn: *mut json_free_t,\n119\t) {\n120\t    if !malloc_fn.is_null() {\n121\t        *malloc_fn = DO_MALLOC;\n122\t    }\n123\t    if !realloc_fn.is_null() {\n124\t        *realloc_fn = DO_REALLOC;\n125\t    }\n126\t    if !free_fn.is_null() {\n127\t        *free_fn = DO_FREE;\n128\t    }\n129\t}\n130\t"}]},"parent_tool_use_id":"toolu_bdrk_01WcvaMYNMfrR18TTx6dMBBY","session_id":"0aaf00f6-473d-4ae1-b7a