---------------------------------------\n38\textern \"C\" {\n39\t    fn malloc(size: usize) -> *mut c_void;\n40\t    fn free(ptr: *mut c_void);\n41\t    fn printf(fmt: *const c_char, ...) -> c_int;\n42\t}\n43\t\n44\t/// `UINT16_MAX` from <stdint.h>.\n45\tconst UINT16_MAX: c_int = 65535;\n46\t\n47\t/// #define LOG_MSG(level, msg) printf(\"[\" #level \"] \" msg \"\\n\")\n48\t///\n49\t/// The C preprocessor stringizes `level` and concatenates the literals, so the\n50\t/// resulting call is `printf(\"[<LEVEL>] <msg>\\n\")`.  The message never contains\n51\t/// a `%`, so passing it as the format string is faithful to the original.\n52\tmacro_rules! log_msg {\n53\t    ($level:ident, $msg:expr) => {{\n54\t        // Build the concatenated, NUL terminated literal at compile time.\n55\t        const S: &str = concat!(\"[\", stringify!($level), \"] \", $msg, \"\\n\\0\");\n56\t        unsafe {\n57\t            printf(S.as_ptr() as *const c_char);\n58\t        }\n59\t    }};\n60\t}\n61\t\n62\t// typedef int (*operation_fn)(int value, int unused_param, void *unused_context);\n63\ttype operation_fn = Option<unsafe extern \"C\" fn(c_int, c_int, *mut c_void) -> c_int>;\n64\t\n65\t// typedef struct { ... } ProcessorState;\n66\t#[repr(C)]\n67\tstruct ProcessorState {\n68\t    results: *mut c_int,\n69\t    capacity: usize,\n70\t    count: usize,\n71\t    operation: operation_fn,\n72\t    status: c_char,\n73\t}\n74\t\n75\t// static bool is_valid_state(ProcessorState *state)\n76\tunsafe fn is_valid_state(state: *mut ProcessorState) -> bool {\n77\t    if (*state).status != 0 {\n78\t        return (*state).count < (*state).capacity;\n79\t    }\n80\t    false\n81\t}\n82\t\n83\t// static bool check_char_flag(char flag)\n84\tfn check_char_flag(flag: c_char) -> bool {\n85\t    flag != 0\n86\t}\n87\t\n88\t// int process_value(int value, int unused_param, void *unused_context)\n89\t#[unsafe(no_mangle)]\n90\tpub unsafe extern \"C\" fn process_value(\n91\t    value: c_int,\n92\t    _unused_param: c_int,\n93\t    _unused_context: *mut c_void,\n94\t) -> c_int {\n95\t    value.wrapping_add(10)\n96\t}\n97\t\n98\t// int double_value(int value, int unused_param, void *unused_context)\n99\t#[unsafe(no_mangle)]\n100\tpub unsafe extern \"C\" fn double_value(\n101\t    value: c_int,\n102\t    _unused_param: c_int,\n103\t    _unused_context: *mut c_void,\n104\t) -> c_int {\n105\t    value.wrapping_mul(2)\n106\t}\n107\t\n108\t// int triple_value(int value, int unused_param, void *unused_context)\n109\t#[unsafe(no_mangle)]\n110\tpub unsafe extern \"C\" fn triple_value(\n111\t    value: c_int,\n112\t    _unused_param: c_int,\n113\t    _unused_context: *mut c_void,\n114\t) -> c_int {\n115\t    value.wrapping_mul(3)\n116\t}\n117\t\n118\t// static ProcessorState* init_processor(size_t capacity, operation_fn op)\n119\tunsafe fn init_processor(capacity: usize, op: operation_fn) -> *mut ProcessorState {\n120\t    let state = malloc(core::mem::size_of::<ProcessorState>()) as *mut ProcessorState;\n121\t    if state.is_null() {\n122\t        return core::ptr::null_mut();\n123\t    }\n124\t\n125\t    let results = malloc(capacity.wrapping_mul(core::mem::size_of::<c_int>())) as *mut c_int;\n126\t    core::ptr::write(core::ptr::addr_of_mut!((*state).results), results);\n127\t    if results.is_null() {\n128\t        free(state as *mut c_void);\n129\t        return core::ptr::null_mut();\n130\t    }\n131\t\n132\t    (*state).capacity = capacity;\n133\t    (*state).count = 0;\n134\t    (*state).operation = op;\n135\t    (*state).status = 1;\n136\t\n137\t    state\n138\t}\n139\t\n140\t// static void cleanup_processor(ProcessorState *state)\n141\tunsafe fn cleanup_processor(state: *mut ProcessorState) {\n142\t    if !state.is_null() {\n143\t        if !(*state).results.is_null() {\n144\t            free((*state).results as *mut c_void);\n145\t        }\n146\t        free(state as *mut c_void);\n147\t    }\n148\t}\n149\t\n150\t// int gotomach(int iterations, int seed, int mode, int threshold)\n151\t#[unsafe(no_mangle)]\n152\tpub unsafe extern \"C\" fn gotomach(\n153\t    iterations: c_int,\n154\t    seed: c_int,\n155\t    mode: c_int,\n156\t    threshold: c_int,\n157\t) -> c_int {\n158\t    let mut state: *mut ProcessorState = core::ptr::null_mut();\n159\t    let mut temp_buffer: *mut c_int = core::ptr::null_mut();\n160\t    let mut result: c_int = 0;\n161\t    #[allow(unused_assignments)]\n162\t    let mut selected_op: operation_fn = None;\n163\t\n164\t    log_msg!(INFO, \"Starting gotomach function\");\n165\t\n166\t    // Replicates the `goto cleanup` control flow of the C original: every\n167\t    // early exit falls through to the shared cleanup block below.\n168\t    'cleanup: loop {\n169\t        if iterations < 0 || iterations > UINT16_MAX {\n170\t            log_msg!(ERROR, \"Invalid iteration count\");\n171\t            result = -1;\n172\t            break 'cleanup;\n173\t        }\n174\t\n175\t        if seed < 0 || seed > UINT16_MAX {\n176\t            log_msg!(ERROR, \"Invalid seed value\");\n177\t            result = -2;\n178\t            break 'cleanup;\n179\t        }\n180\t\n181\t        match mode {\n182\t            0 => {\n183\t                selected_op = Some(process_value);\n184\t            }\n185\t            1 => {\n186\t                selected_op = Some(double_value);\n187\t            }\n188\t            2 => {\n189\t                selected_op = Some(triple_value);\n190\t            }\n191\t            _ => {\n192\t                log_msg!(WARNING, \"Invalid mode, using default\");\n193\t                selected_op = Some(process_value);\n194\t            }\n195\t        }\n196\t\n197\t        state = init_processor(iterations as usize, selected_op);\n198\t        if state.is_null() {\n199\t            log_msg!(ERROR, \"Failed to initialize processor\");\n200\t            result = -3;\n201\t            break 'cleanup;\n202\t        }\n203\t\n204\t        temp_buffer =\n205\t            malloc((iterations as usize).wrapping_mul(core::mem::size_of::<c_int>())) as *mut c_int;\n206\t        if temp_buffer.is_null() {\n207\t            log_msg!(ERROR, \"Failed to allocate temporary buffer\");\n208\t            result = -4;\n209\t            break 'cleanup;\n210\t        }\n211\t\n212\t        if !check_char_flag((*state).status) {\n213\t            log_msg!(ERROR, \"Invalid state status\");\n214\t            result = -5;\n215\t            break 'cleanup;\n216\t        }\n217\t\n218\t        let mut current_value: c_int = seed;\n219\t        let mut broke_out = false;\n220\t        let mut i: c_int = 0;\n221\t        while i < iterations {\n222\t            if !is_valid_state(state) {\n223\t                log_msg!(ERROR, \"State became invalid during processing\");\n224\t                result = -6;\n225\t                broke_out = true;\n226\t                break;\n227\t            }\n228\t\n229\t            let op = (*state).operation.unwrap();\n230\t            let produced = op(current_value, 0, core::ptr::null_mut());\n231\t            *temp_buffer.offset(i as isize) = produced;\n232\t\n233\t            if produced < threshold {\n234\t                let count = (*state).count;\n235\t                *(*state).results.add(count) = produced;\n236\t                (*state).count = count + 1;\n237\t            }\n238\t\n239\t            current_value = produced % 1000;\n240\t\n241\t            if (*state).count >= UINT16_MAX as usize {\n242\t                log_msg!(WARNING, \"Reached maximum count\");\n243\t                break;\n244\t            }\n245\t\n246\t            i += 1;\n247\t        }\n248\t\n249\t        if broke_out {\n250\t            break 'cleanup;\n251\t        }\n252\t\n253\t        result = 0;\n254\t        let count = (*state).count;\n255\t        let mut j: usize = 0;\n256\t        while j < count {\n257\t            result = result.wrapping_add(*(*state).results.add(j));\n258\t            j += 1;\n259\t        }\n260\t\n261\t        log_msg!(INFO, \"Processing completed successfully\");\n262\t        break 'cleanup;\n263\t    }\n264\t\n265\t    // cleanup:\n266\t    if !temp_buffer.is_null() {\n267\t        free(temp_buffer as *mut c_void);\n268\t    }\n269\t    cleanup_processor(state);\n270\t\n271\t    result\n272\t}\n273\t"}]},"parent_tool_use_id":null,"session_id":"6136b9ea-c933-4b26-9cc6-f91d0068bdc5","uuid":"afa7268e-fc02-429b-bf3d-1fdbde22b357","timestamp":"2026-08-19T20:21:57.124Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-DnxgbL/translated_rust/src/lib.rs","content":"// Rust translation of c_src/src/lib.c\n//\n// Copyright 2025 MIT Lincoln Laboratory\n// Permission is hereby granted, free of charge,\n// to any person obtaining a copy of this software\n// and associated documentation files (the \"Software\"),\n// to deal in the Software without restriction,\n// including without limitation the rights to use, copy,\n// modify, merge, publish, distribute, sublicense,\n// and/or sell copies of the Software,\n// and to permit persons to whom the Software is furnished to do so,\n// subject to the following conditions:\n//\n// The above copyright notice and this permission notice\n// shall be included in all copies or substantial portions of the Software.\n//\n// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n// THE WARRANTIES OF MERCHANTABILITY,\n// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n\n#![allow(non_camel_case_types)]\n\nuse std::ffi::{c_char, c_int, c_void};\n\n// ---------------------------------------------------------------------------\n// libc bindings.\n//\n// We deliberately go through the platform C library for allocation and for\n// printing so that the observable behaviour (including malloc(0) returning a\n// non-NULL pointer, and stdout buffering / interleaving with any C code in the\n// same process) is byte-for-byte identical to the original C library.\n// ---------------------------------------------------------------------------\nextern \"C\" {\n    fn malloc(size: usize) -> *mut c_void;\n    fn free(ptr: *mut c_void);\n    fn printf(fmt: *const c_char, ...) -> c_int;\n}\n\n/// `UINT16_MAX` from <stdint.h>.\nconst UINT16_MAX: c_int = 65535;\n\n/// #define LOG_MSG(level, msg) printf(\"[\" #level \"] \" msg \"\\n\")\n///\n/// The C preprocessor stringizes `level` and concatenates the literals, so the\n/// resulting call is `printf(\"[<LEVEL>] <msg>\\n\")`.  The message never contains\n/// a `%`, so passing it as the format string is faithful to the original.\nmacro_rules! log_msg {\n    ($level:ident, $msg:expr) => {{\n        // Build the concatenated, NUL terminated literal at compile time.\n        const S: &str = concat!(\"[\", stringify!($level), \"] \", $msg, \"\\n\\0\");\n        unsafe {\n            printf(S.as_ptr() as *const c_char);\n        }\n    }};\n}\n\n// typedef int (*operation_fn)(int value, int unused_param, void *unused_context);\ntype operation_fn = Option<unsafe extern \"C\" fn(c_int, c_int, *mut c_void) -> c_int>;\n\n// typedef struct { ... } ProcessorState;\n#[repr(C)]\nstruct ProcessorState {\n    results: *mut c_int,\n    capacity: usize,\n    count: usize,\n    operation: operation_fn,\n    status: c_char,\n}\n\n// static bool is_valid_state(ProcessorState *state)\nunsafe fn is_valid_state(state: *mut ProcessorState) -> bool {\n    if (*state).status != 0 {\n        return (*state).count < (*state).capacity;\n    }\n    false\n}\n\n// static bool check_char_flag(char flag)\nfn check_char_flag(flag: c_char) -> bool {\n    flag != 0\n}\n\n// int process_value(int value, int unused_param, void *unused_context)\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn process_value(\n    value: c_int,\n    _unused_param: c_int,\n    _unused_context: *mut c_void,\n) -> c_int {\n    value.wrapping_add(10)\n}\n\n// int double_value(int value, int unused_param, void *unused_context)\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn double_value(\n    value: c_int,\n    _unused_param: c_int,\n    _unused_context: *mut c_void,\n) -> c_int {\n    value.wrapping_mul(2)\n}\n\n// int triple_value(int value, int unused_param, void *unused_context)\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn triple_value(\n    value: c_int,\n    _unused_param: c_int,\n    _unused_context: *mut c_void,\n) -> c_int {\n    value.wrapping_mul(3)\n}\n\n// static ProcessorState* init_processor(size_t capacity, operation_fn op)\nunsafe fn init_processor(capacity: usize, op: operation_fn) -> *mut ProcessorState {\n    let state = malloc(core::mem::size_of::<ProcessorState>()) as *mut ProcessorState;\n    if state.is_null() {\n        return core::ptr::null_mut();\n    }\n\n    let results = malloc(capacity.wrapping_mul(core::mem::size_of::<c_int>())) as *mut c_int;\n    core::ptr::write(core::ptr::addr_of_mut!((*state).results), results);\n    if results.is_null() {\n        free(state as *mut c_void);\n        return core::ptr::null_mut();\n    }\n\n    (*state).capacity = capacity;\n    (*state).count = 0;\n    (*state).operation = op;\n    (*state).status = 1;\n\n    state\n}\n\n// static void cleanup_processor(ProcessorState *state)\nunsafe fn cleanup_processor(state: *mut ProcessorState) {\n    if !state.is_null() {\n        if !(*state).results.is_null() {\n            free((*state).results as *mut c_void);\n        }\n        free(state as *mut c_void);\n    }\n}\n\n// int gotomach(int iterations, int seed, int mode, int threshold)\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn gotomach(\n    iterations: c_int,\n    seed: c_int,\n    mode: c_int,\n    threshold: c_int,\n) -> c_int {\n    let mut state: *mut ProcessorState = core::ptr::null_mut();\n    let mut temp_buffer: *mut c_int = core::ptr::null_mut();\n    let mut result: c_int = 0;\n    #[allow(unused_assignments)]\n    let mut selected_op: operation_fn = None;\n\n    log_msg!(INFO, \"Starting gotomach function\");\n\n    // Replicates the `goto cleanup` control flow of the C original: every\n    // early exit falls through to the shared cleanup block below.\n    'cleanup: loop {\n        if iterations < 0 || iterations > UINT16_MAX {\n            log_msg!(ERROR, \"Invalid iteration count\");\n            result = -1;\n            break 'cleanup;\n        }\n\n        if seed < 0 || seed > UINT16_MAX {\n            log_msg!(ERROR, \"Invalid seed value\");\n            result = -2;\n            break 'cleanup;\n        }\n\n        match mode {\n            0 => {\n                selected_op = Some(process_value);\n            }\n            1 => {\n                selected_op = Some(double_value);\n            }\n            2 => {\n                selected_op = Some(triple_value);\n            }\n            _ => {\n                log_msg!(WARNING, \"Invalid mode, using default\");\n                selected_op = Some(process_value);\n            }\n        }\n\n        state = init_processor(iterations as usize, selected_op);\n        if state.is_null() {\n            log_msg!(ERROR, \"Failed to initialize processor\");\n            result = -3;\n            break 'cleanup;\n        }\n\n        temp_buffer =\n            malloc((iterations as usize).wrapping_mul(core::mem::size_of::<c_int>())) as *mut c_int;\n        if temp_buffer.is_null() {\n            log_msg!(ERROR, \"Failed to allocate temporary buffer\");\n            result = -4;\n            break 'cleanup;\n        }\n\n        if !check_char_flag((*state).status) {\n            log_msg!(ERROR, \"Invalid state status\");\n            result = -5;\n            break 'cleanup;\n        }\n\n        let mut current_value: c_int = seed;\n        let mut broke_out = false;\n        let mut i: c_int = 0;\n        while i < iterations {\n            if !is_valid_state(state) {\n                log_msg!(ERROR, \"State became invalid during processing\");\n                result = -6;\n                broke_out = true;\n                break;\n            }\n\n            let op = (*state).operation.unwrap();\n            let produced = op(current_value, 0, core::ptr::null_mut());\n            *temp_buffer.offset(i as isize) = produced;\n\n            if produced < threshold {\n                let count = (*state).count;\n                *(*state).results.add(count) = produced;\n                (*state).count = count + 1;\n            }\n\n            current_value = produced % 1000;\n\n            if (*state).count >= UINT16_MAX as usize {\n                log_msg!(WARNING, \"Reached maximum count\");\n                break;\n            }\n\n            i += 1;\n        }\n\n        if broke_out {\n            break 'cleanup;\n        }\n\n        result = 0;\n        let count = (*state).count;\n        let mut j: usize = 0;\n        while j < count {\n            result = result.wrapping_add(*(*state).results.add(j));\n            j += 1;\n        }\n\n        log_msg!(INFO, \"Processing completed successfully\");\n        break 'cleanup;\n    }\n\n    // cleanup:\n    if !temp_buffer.is_null() {\n        free(temp_buffer as *mut c_void);\n    }\n    cleanup_processor(state);\n\n    result\n}\n","numLines":273,"startLine":1,"totalLines":273}}}
