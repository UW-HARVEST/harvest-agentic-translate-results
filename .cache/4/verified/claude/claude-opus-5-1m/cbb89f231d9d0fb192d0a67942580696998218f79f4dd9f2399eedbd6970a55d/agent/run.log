 bits set","+            0x3f80_0000, // 1.0","+            0xbf80_0000, // -1.0","+            0x4b7f_ffff, // 16777215.0","+            0x4b80_0000, // 16777216.0","+        ];","+        for bits in named {","+            check(bits, true);","+        }","+        // NaNs with arbitrary payloads must not be canonicalised anywhere.","+        let mut rng = Rng::new(0x5EED_0002);","+        for _ in 0..3000 {","+            let payload = rng.next_u32() & 0x007f_ffff;","+            if payload != 0 {","+                check(0x7f80_0000 | payload, false);","+                check(0xff80_0000 | payload, false);","             }","         }","-    }","-    drop(tap);","-    assert!(fails.is_empty(), \"driver() diverged:\\n{}\", fails.join(\"\\n\"));","-}"," ","-/// ERRORS.md row 22 -- the output is always 4 bytes wide (8 lowercase hex","-/// digits + '\\n'), because `driver` hard-codes `sizeof(float)`.","-#[test]","-fn output_is_always_four_bytes_wide() {","-    let (c, r) = driver_syms();","-    let mut rng = Rng::new(0x5EED_0003);","-    let mut fails = Vec::new();","-    let mut tap = StdoutTap::new();","-    let mut widths = Vec::new();","-    for _ in 0..500 {","-        let bits = rng.next_u32();","-        let (cout, _) = check_bits(&mut tap, &c, &r, bits, &mut fails);","-        widths.push((bits, cout));","+        // -- CONFIGS.md row 3: every exponent field x corner mantissas -------","+        for ef in 0u32..=255 {","+            for mant in [0u32, 1, 0x0000_00ff, 0x0040_0000, 0x007f_fffe, 0x007f_ffff] {","+                for sign in [0u32, 0x8000_0000] {","+                    check(sign | (ef << 23) | mant, false);","+                }","+            }","+        }","     }","-    drop(tap);","-    assert!(fails.is_empty(), \"driver() diverged:\\n{}\", fails.join(\"\\n\"));","-    for (bits, out) in widths {","-        assert_eq!(out.len(), 9, \"unexpected width for bits={bits:#010x}\");","-        assert_eq!(*out.last().unwrap(), b'\\n');","+","+    assert!(","+        fails.is_empty(),","+        \"driver() diverged for {} of {checked} bit patterns:\\n{}\",","+        fails.len(),","+        fails.join(\"\\n\")","+    );","+    eprintln!(\"FFI driver(): {checked} bit patterns matched\");","+","+    // -- ERRORS.md row 22: output shape ------------------------------------","+    // `driver` hard-codes `sizeof(float)`, so the output is always 8 lowercase","+    // hex digits followed by '\\n' -- and it is a byte-exact echo of the input","+    // pattern in native (little-endian) order, with no NaN canonicalisation.","+    for case in &kept {","+        assert_eq!(case.out.len(), 9, \"width for bits={:#010x}\", case.bits);","+        assert_eq!(*case.out.last().unwrap(), b'\\n');","         assert!(","-            out[..8]","+            case.out[..8]","                 .iter()","                 .all(|b| b.is_ascii_hexdigit() && !b.is_ascii_uppercase()),","             \"not lowercase hex: {:?}\",","-            String::from_utf8_lossy(&out)","+            String::from_utf8_lossy(&case.out)","         );","+        let expect: String = f32::from_bits(case.bits)","+            .to_ne_bytes()","+            .iter()","+            .map(|b| format!(\"{b:02x}\"))","+            .collect::<String>()","+            + \"\\n\";","+        assert_eq!(","+            String::from_utf8_lossy(&case.out),","+            expect,","+            \"byte order / echo for bits={:#010x}\",","+            case.bits","+        );","     }","-}"," ","-/// CONFIGS.md row 4 -- the exported `main` symbol of both libraries, driven","-/// through a redirected stdin.  Each `main` is called once per library because","-/// C `stdio` and Rust's `Stdin` both keep a persistent buffer.","-#[test]","-fn exported_main_symbol_matches() {","-    let l = libs();","+    // -- CONFIGS.md row 4: the exported `main` symbol -----------------------","+    // Called once per library: C `stdio` and Rust's `Stdin` both keep a","+    // persistent buffer, so a second call would not re-read the file.","     let input = b\"  \\n\\t -3.5e-2 leftover\";","-    let (cret, cout) = unsafe {","-        let m: Symbol<MainFn> = l.c.get(b\"main\\0\").expect(\"dlsym main in C .so\");","-        capture_with_stdin(input, || m())","+    let (cret, cout) = {","+        let m: Symbol<MainFn> = unsafe { c_lib.get(b\"main\\0\") }.expect(\"dlsym main in C .so\");","+        capture_with_stdin(input, || unsafe { m() })","     };","-    let (rret, rout) = unsafe {","-        let m: Symbol<MainFn> = l.r.get(b\"main\\0\").expect(\"dlsym main in Rust .so\");","-        capture_with_stdin(input, || m())","+    let (rret, rout) = {","+        let m: Symbol<MainFn> = unsafe { r_lib.get(b\"main\\0\") }.expect(\"dlsym main in Rust .so\");","+        capture_with_stdin(input, || unsafe { m() })","     };","     assert_eq!(cret, 0, \"C main should return 0\");","     assert_eq!(rret, cret, \"main return value\");"]},{"oldStart":197,"oldLines":7,"newStart":172,"newLines":12,"lines":["         String::from_utf8_lossy(&rout),","         \"main stdout\"","     );","-    // Sanity check against the executables, which take the same path.","+    // Cross-check the FFI path against the standalone executables.","     let via_exe = common::c_run(input);","-    assert_eq!(cout, via_exe.stdout, \"FFI main vs C executable\");","+    assert_eq!(","+        String::from_utf8_lossy(&cout),","+        String::from_utf8_lossy(&via_exe.stdout),","+        \"FFI main vs C executable\"","+    );","+    eprintln!(\"FFI main(): matched ({})\", String::from_utf8_lossy(&cout).trim());"," }"]}],"originalFile":"//! Phase B/C -- differential tests that go through the C ABI of **both**\n//! shared libraries via `libloading`.\n//!\n//! `CONFIGS.md` rows 1-4 and `ERRORS.md` rows 20-22.\n//!\n//! Nothing here calls a Rust function directly: `driver` and `main` are looked\n//! up with `dlsym` in `target/<prof>/libdriver.so` exactly as an external C\n//! caller would, which also exercises the `#[no_mangle]` export wrappers.\n\nmod common;\n\nuse common::{capture_with_stdin, Rng, StdoutTap};\nuse libloading::{Library, Symbol};\nuse std::os::raw::c_int;\nuse std::sync::OnceLock;\n\ntype DriverFn = unsafe extern \"C\" fn(f32);\ntype MainFn = unsafe extern \"C\" fn() -> c_int;\n\nstruct Libs {\n    c: Library,\n    r: Library,\n}\n\nfn libs() -> &'static Libs {\n    static L: OnceLock<Libs> = OnceLock::new();\n    L.get_or_init(|| unsafe {\n        let c = Library::new(common::c_shared_lib()).expect(\"dlopen C .so\");\n        let r = Library::new(common::rust_shared_lib()).expect(\"dlopen Rust .so\");\n        Libs { c, r }\n    })\n}\n\nfn driver_syms() -> (Symbol<'static, DriverFn>, Symbol<'static, DriverFn>) {\n    let l = libs();\n    unsafe {\n        let c: Symbol<DriverFn> = l.c.get(b\"driver\\0\").expect(\"dlsym driver in C .so\");\n        let r: Symbol<DriverFn> = l.r.get(b\"driver\\0\").expect(\"dlsym driver in Rust .so\");\n        (c, r)\n    }\n}\n\n/// Calls `driver(bits as f32)` in both libraries through the FFI boundary and\n/// records any divergence.\nfn check_bits(\n    tap: &mut StdoutTap,\n    c: &Symbol<'static, DriverFn>,\n    r: &Symbol<'static, DriverFn>,\n    bits: u32,\n    fails: &mut Vec<String>,\n) -> (Vec<u8>, Vec<u8>) {\n    let x = f32::from_bits(bits);\n    let ((), cout) = tap.run(|| unsafe { c(x) });\n    let ((), rout) = tap.run(|| unsafe { r(x) });\n    if cout != rout && fails.len() < 25 {\n        fails.push(format!(\n            \"bits={bits:#010x}: C={:?} Rust={:?}\",\n            String::from_utf8_lossy(&cout),\n            String::from_utf8_lossy(&rout)\n        ));\n    }\n    (cout, rout)\n}\n\n/// CONFIGS.md row 1 -- exhaustive low bit patterns plus a large random sweep.\n#[test]\nfn exhaustive_low_and_random_bit_patterns() {\n    let (c, r) = driver_syms();\n    let mut tap = StdoutTap::new();\n    let mut fails = Vec::new();\n    // Exhaustive over the low 17 bits: +0 and the whole first block of\n    // subnormals (exponent field 0).\n    for bits in 0u32..=0x0001_0000 {\n        check_bits(&mut tap, &c, &r, bits, &mut fails);\n    }\n    // Randomized over the full 32-bit space: normals, subnormals, inf, every\n    // NaN payload, both signs.\n    let mut rng = Rng::new(0x00C0_FFEE_1234_5678);\n    for _ in 0..80_000 {\n        let bits = rng.next_u32();\n        check_bits(&mut tap, &c, &r, bits, &mut fails);\n    }\n    drop(tap);\n    assert!(fails.is_empty(), \"driver() diverged:\\n{}\", fails.join(\"\\n\"));\n}\n\n/// CONFIGS.md row 2 / ERRORS.md rows 20-21 -- named special values and NaNs\n/// with arbitrary payloads (nothing may be canonicalised).\n#[test]\nfn special_float_bit_patterns() {\n    let (c, r) = driver_syms();\n    let mut fails = Vec::new();\n    let mut named: Vec<u32> = vec![\n        0x0000_0000, // +0\n        0x8000_0000, // -0\n        0x0000_0001, // +FLT_TRUE_MIN\n        0x8000_0001, // -FLT_TRUE_MIN\n        0x0080_0000, // +FLT_MIN\n        0x8080_0000, // -FLT_MIN\n        0x007f_ffff, // largest subnormal\n        0x7f7f_ffff, // +FLT_MAX\n        0xff7f_ffff, // -FLT_MAX\n        0x7f80_0000, // +inf\n        0xff80_0000, // -inf\n        0x7fc0_0000, // +qNaN\n        0xffc0_0000, // -qNaN\n        0x7fa0_0000, // +sNaN\n        0xffa0_0000, // -sNaN\n        0x7f80_0001, // smallest sNaN payload\n        0x7fff_ffff, // NaN, all payload bits set\n        0x3f80_0000, // 1.0\n        0xbf80_0000, // -1.0\n        0x4b7f_ffff, // 16777215.0\n        0x4b80_0000, // 16777216.0\n    ];\n    let mut rng = Rng::new(0x5EED_0002);\n    for _ in 0..2000 {\n        let payload = rng.next_u32() & 0x007f_ffff;\n        if payload != 0 {\n            named.push(0x7f80_0000 | payload);\n            named.push(0xff80_0000 | payload);\n        }\n    }\n    let mut tap = StdoutTap::new();\n    for bits in named {\n        check_bits(&mut tap, &c, &r, bits, &mut fails);\n    }\n    drop(tap);\n    assert!(fails.is_empty(), \"driver() diverged:\\n{}\", fails.join(\"\\n\"));\n}\n\n/// CONFIGS.md row 3 -- every exponent field crossed with corner mantissas.\n#[test]\nfn every_exponent_field_times_corner_mantissas() {\n    let (c, r) = driver_syms();\n    let mut fails = Vec::new();\n    let mut tap = StdoutTap::new();\n    for ef in 0u32..=255 {\n        for mant in [0u32, 1, 0x0000_00ff, 0x0040_0000, 0x007f_fffe, 0x007f_ffff] {\n            for sign in [0u32, 0x8000_0000] {\n                check_bits(&mut tap, &c, &r, sign | (ef << 23) | mant, &mut fails);\n            }\n        }\n    }\n    drop(tap);\n    assert!(fails.is_empty(), \"driver() diverged:\\n{}\", fails.join(\"\\n\"));\n}\n\n/// ERRORS.md row 22 -- the output is always 4 bytes wide (8 lowercase hex\n/// digits + '\\n'), because `driver` hard-codes `sizeof(float)`.\n#[test]\nfn output_is_always_four_bytes_wide() {\n    let (c, r) = driver_syms();\n    let mut rng = Rng::new(0x5EED_0003);\n    let mut fails = Vec::new();\n    let mut tap = StdoutTap::new();\n    let mut widths = Vec::new();\n    for _ in 0..500 {\n        let bits = rng.next_u32();\n        let (cout, _) = check_bits(&mut tap, &c, &r, bits, &mut fails);\n        widths.push((bits, cout));\n    }\n    drop(tap);\n    assert!(fails.is_empty(), \"driver() diverged:\\n{}\", fails.join(\"\\n\"));\n    for (bits, out) in widths {\n        assert_eq!(out.len(), 9, \"unexpected width for bits={bits:#010x}\");\n        assert_eq!(*out.last().unwrap(), b'\\n');\n        assert!(\n            out[..8]\n                .iter()\n                .all(|b| b.is_ascii_hexdigit() && !b.is_ascii_uppercase()),\n            \"not lowercase hex: {:?}\",\n            String::from_utf8_lossy(&out)\n        );\n    }\n}\n\n/// CONFIGS.md row 4 -- the exported `main` symbol of both libraries, driven\n/// through a redirected stdin.  Each `main` is called once per library because\n/// C `stdio` and Rust's `Stdin` both keep a persistent buffer.\n#[test]\nfn exported_main_symbol_matches() {\n    let l = libs();\n    let input = b\"  \\n\\t -3.5e-2 leftover\";\n    let (cret, cout) = unsafe {\n        let m: Symbol<MainFn> = l.c.get(b\"main\\0\").expect(\"dlsym main in C .so\");\n        capture_with_stdin(input, || m())\n    };\n    let (rret, rout) = unsafe {\n        let m: Symbol<MainFn> = l.r.get(b\"main\\0\").expect(\"dlsym main in Rust .so\");\n        capture_with_stdin(input, || m())\n    };\n    assert_eq!(cret, 0, \"C main should return 0\");\n    assert_eq!(rret, cret, \"main return value\");\n    assert_eq!(\n        String::from_utf8_lossy(&cout),\n        String::from_utf8_lossy(&rout),\n        \"main stdout\"\n    );\n    // Sanity check against the executables, which take the same path.\n    let via_exe = common::c_run(input);\n    assert_eq!(cout, via_exe.stdout, \"FFI main vs C executable\");\n}\n","userModified":false}}
