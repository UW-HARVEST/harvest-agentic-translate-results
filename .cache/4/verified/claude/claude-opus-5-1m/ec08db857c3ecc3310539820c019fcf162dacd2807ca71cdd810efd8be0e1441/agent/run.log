d::os::raw::c_int;\n\n/// `int main()` from `c_src/src/main.c`.\n///\n/// Reads one line from `stdin` and either runs the house twice or prints the\n/// error message; always returns `0`.\n#[no_mangle]\npub extern \"C\" fn main() -> c_int {\n    driver::c_main()\n}\n\n/// `void run(int extra_bedrooms)` from `c_src/src/main.c`.\n///\n/// Operates on this object's own copy of the process-global `the_house`, exactly\n/// like the C `.so` operates on its own `static house_t the_house`.\n#[no_mangle]\npub extern \"C\" fn run(extra_bedrooms: c_int) {\n    driver::run_global(extra_bedrooms);\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":816,"cache_read_input_tokens":74146,"cache_creation":{"ephemeral_5m_input_tokens":816,"ephemeral_1h_input_tokens":0},"output_tokens":17,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"256b8717-e7f2-4f66-90f3-0cc283d3f62d","uuid":"144d4f1a-801c-4f1f-8cfa-a6b0627e7ebb","timestamp":"2026-08-18T05:39:07.111Z"}
