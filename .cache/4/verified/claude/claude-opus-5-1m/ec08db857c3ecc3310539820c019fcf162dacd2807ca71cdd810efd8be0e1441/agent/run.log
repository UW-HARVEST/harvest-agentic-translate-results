YRIGHT HOLDERS BE LIABLE\n// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n\n//! ```c\n//! int main() {\n//!     char in[100] = \"\";\n//!     fgets(in, sizeof(in), stdin);\n//!     int x;\n//!     if (parse_val(in, &x)) {\n//!         run(x);\n//!         run(x);\n//!     } else {\n//!         printf(\"An error occurred\\n\");\n//!     }\n//!     return 0;\n//! }\n//! ```\n\nuse std::io::Write;\n\nfn main() {\n    // The C program inherits the default SIGPIPE disposition; Rust's runtime\n    // installs SIG_IGN, so undo that before writing anything.\n    driver::restore_default_sigpipe();\n\n    // char in[100] = \"\"; fgets(in, sizeof(in), stdin);\n    let input = driver::fgets_line(100);\n\n    // int x; if (parse_val(in, &x)) { run(x); run(x); } else { ... }\n    match driver::parse_val(&input) {\n        Some(x) => {\n            driver::run(x);\n            driver::run(x);\n        }\n        None => {\n            let stdout = std::io::stdout();\n            let mut out = stdout.lock();\n            let _ = write!(out, \"An error occurred\\n\");\n            let _ = out.flush();\n        }\n    }\n\n    // return 0;\n}\n","userModified":false}}
