 unresolved symbols (untranslated code?): {unresolved:?}\"","-    );","+    // Belt and braces: no *Rust*-mangled name may be left undefined, which is","+    // what a partially translated crate would look like.","+    for so in [&c_so, &r_so] {","+        let dangling: Vec<String> = undefined_dyn_symbols(so)","+            .into_iter()","+            .filter(|s| s.starts_with(\"_ZN\") || s.starts_with(\"_RNv\"))","+            .collect();","+        assert!(","+            dangling.is_empty(),","+            \"{} has undefined Rust symbols: {dangling:?}\",","+            so.display()","+        );","+    }"," }"," "," #[test]"]}],"userModified":false,"replaceAll":false}}
