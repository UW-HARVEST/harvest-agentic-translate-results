ne forked call."," #[derive(Debug, PartialEq, Eq)]"," pub struct Run {","     pub stdout: Vec<u8>,","-    /// Value returned by `main` (as an exit status), or `None` if the child was","-    /// killed by a signal.","+    /// Exit status of the child (the value returned by `main`), or `None` when","+    /// the child was killed by a signal.","     pub status: Option<i32>,","     pub signal: Option<i32>,"," }"," ","-/// How the child's stdin should be set up before `main()` is called.","-#[derive(Clone, Copy)]","-pub enum Stdin<'a> {","-    /// Read from a regular file pre-filled with these bytes.","-    Bytes(&'a [u8]),","-    /// fd 0 closed before the call.","-    Closed,","-}","+/// Forks, wires up fd 0 / fd 1, runs `body` in the child and exits with the","+/// value it returns.","+fn fork_run<F>(stdin: In<'_>, stdout: Out, body: F) -> Run","+where","+    F: FnOnce() -> i32,","+{","+    let _guard = fork_lock();"," ","-/// Calls the exported `main` of `lib` in a freshly forked child.","-///","-/// A fresh process is required because `main` consumes `stdin` through the","-/// process-wide stdio state (glibc's `FILE *stdin` / Rust's global `Stdin`),","-/// which cannot be reset between calls; forking also isolates a `main` that","-/// dies from a signal.","-fn run_main(lib: &'static Library, stdin: Stdin<'_>, close_stdout: bool) -> Run {","-    let f = main_sym(lib);","-    let _guard = fd_lock();","-","-    let out_path = temp_path(\"main-out\");","-    let out_file = fs::File::create(&out_path).expect(\"create child stdout file\");","-    let in_path = temp_path(\"main-in\");","+    let out_path = temp_path(\"out\");","+    let in_path = temp_path(\"in\");","+    let out_file = match stdout {","+        Out::File => Some(fs::File::create(&out_path).expect(\"create child stdout file\")),","+        _ => None,","+    };","     let in_file = match stdin {","-        Stdin::Bytes(b) => {","+        In::Bytes(b) => {","             fs::write(&in_path, b).expect(\"write