 ((hdr[2] >> 2) & 3) + (((hdr[1] >> 3) & 1) + ((hdr[1] >> 4) & 1)) * 3;\n    return sr - (sr != 0);\n}\n\nint main(int argc, char **argv) {\n    if (argc < 3) {\n        fprintf(stderr, \"usage: %s <c.so> <rust.so> [iters]\\n\", argv[0]);\n        return 2;\n    }\n    long iters = (argc > 3) ? atol(argv[3]) : 200000;\n\n    void *hc = dlopen(argv[1], RTLD_NOW);\n    if (!hc) { fprintf(stderr, \"dlopen C: %s\\n\", dlerror()); return 2; }\n    void *hr = dlopen(argv[2], RTLD_NOW);\n    if (!hr) { fprintf(stderr, \"dlopen rust: %s\\n\", dlerror()); return 2; }\n\n    fn_t fc = (fn_t)dlsym(hc, \"read_side_info\");\n    fn_t fr = (fn_t)dlsym(hr, \"read_side_info\");\n    if (!fc || !fr) { fprintf(stderr, \"dlsym failed\\n\"); return 2; }\n\n    long mismatch = 0, checked = 0, oob = 0, ret_neg1 = 0, ret_ok = 0;\n\n    // Padding on both sides of the logical buffer: get_bits can read past the\n    // limit, and the C does so too, so give it real memory to touch.\n    static uint8_t buf[BUFSZ + 4096];\n\n    for (long it = 0; it < iters; it++) {\n        uint8_t hdr[4];\n        for (int i = 0; i < 4; i++) hdr[i] = (uint8_t)rnd(256);\n        // Bias toward realistic MP3 headers half the time.\n        if (it % 2 == 0) {\n            hdr[1] = (uint8_t)((rnd(2) ? 0x18 : 0x10) | (rnd(2) ? 0x8 : 0x0) | 0x02);\n            hdr[2] = (uint8_t)((rnd(3) << 2) | (rnd(16) << 4));  // sr idx 0..2\n        }\n        for (size_t i = 0; i < sizeof(buf); i++) buf[i] = (uint8_t)rnd(256);\n\n        int limit = (int)rnd(BUFSZ * 8);\n        int pos = (int)rnd(limit > 0 ? (uint32_t)limit + 1 : 1);\n\n        // Seed the gr arrays with a recognizable pattern so that fields the\n        // library leaves untouched (e.g. region_count[2] on the short-block\n        // path) are compared too.\n        L3_gr_info_t grc[NGR], grr[NGR];\n        for (int i = 0; i < NGR; i++) {\n            memset(&grc[i], 0xA5 + i, sizeof(L3_gr_info_t));\n            memset(&grr[i], 0xA5 + i, sizeof(L3_gr_info_t));\n            grc[i].sfbtab = NULL;\n            grr[i].sfbtab = NULL;\n        }\n\n        bs_t bc = {buf, pos, limit};\n        bs_t br = {buf, pos, limit};\n\n        int rc = fc(&bc, grc, hdr);\n        int rr = fr(&br, grr, hdr);\n\n        checked++;\n        if (rc == -1) ret_neg1++; else ret_ok++;\n\n        int bad = 0;\n        if (rc != rr) bad = 1;\n        if (bc.pos != br.pos || bc.limit != br.limit || bc.buf != br.buf) bad = 1;\n\n        int sr_idx = calc_sr_idx(hdr);\n        int is_oob = (sr_idx == 8);\n        if (is_oob) oob++;\n\n        for (int i = 0; i < NGR && !bad; i++) {\n            // Compare every scalar field (i.e. the whole struct except the\n            // sfbtab pointer, whose numeric value legitimately differs).\n            const unsigned char *a = (const unsigned char *)&grc[i];\n            const unsigned char *b = (const unsigned char *)&grr[i];\n            if (memcmp(a + sizeof(const uint8_t *), b + sizeof(const uint8_t *),\n                       sizeof(L3_gr_info_t) - sizeof(const uint8_t *)) != 0)\n                bad = 1;\n\n            // Compare the table contents that sfbtab points at. Skip the\n            // sr_idx==8 case: there the C itself reads outside its tables, so\n            // its result is not well defined.\n            if (!bad && grc[i].sfbtab && grr[i].sfbtab && !is_oob) {\n                int n = grc[i].n_long_sfb + grc[i].n_short_sfb;\n                if (n > 0 && memcmp(grc[i].sfbtab, grr[i].sfbtab, (size_t)n) != 0)\n                    bad = 1;\n            }\n        }\n\n        if (bad) {\n            if (mismatch < 10) {\n                printf(\"MISMATCH it=%ld hdr=%02x%02x%02x%02x pos=%d limit=%d \"\n                       \"rc=%d rr=%d bcpos=%d brpos=%d sr_idx=%d\\n\",\n                       it, hdr[0], hdr[1], hdr[2], hdr[3], pos, limit, rc, rr,\n                       bc.pos, br.pos, sr_idx);\n                for (int i = 0; i < NGR; i++) {\n                    printf(\"  gr[%d] C: p23=%u bv=%u sfc=%u gg=%u bt=%u mbf=%u nl=%u ns=%u \"\n                           \"ts=%u,%u,%u rc=%u,%u,%u sg=%u,%u,%u pf=%u ss=%u c1=%u scfsi=%u\\n\",\n                           i, grc[i].part_23_length, grc[i].big_values, grc[i].scalefac_compress,\n                           grc[i].global_gain, grc[i].block_type, grc[i].mixed_block_flag,\n                           grc[i].n_long_sfb, grc[i].n_short_sfb,\n                           grc[i].table_select[0], grc[i].table_select[1], grc[i].table_select[2],\n                           grc[i].region_count[0], grc[i].region_count[1], grc[i].region_count[2],\n                           grc[i].subblock_gain[0], grc[i].subblock_gain[1], grc[i].subblock_gain[2],\n                           grc[i].preflag, grc[i].scalefac_scale, grc[i].count1_table, grc[i].scfsi);\n                    printf(\"  gr[%d] R: p23=%u bv=%u sfc=%u gg=%u bt=%u mbf=%u nl=%u ns=%u \"\n                           \"ts=%u,%u,%u rc=%u,%u,%u sg=%u,%u,%u pf=%u ss=%u c1=%u scfsi=%u\\n\",\n                           i, grr[i].part_23_length, grr[i].big_values, grr[i].scalefac_compress,\n                           grr[i].global_gain, grr[i].block_type, grr[i].mixed_block_flag,\n                           grr[i].n_long_sfb, grr[i].n_short_sfb,\n                           grr[i].table_select[0], grr[i].table_select[1], grr[i].table_select[2],\n                           grr[i].region_count[0], grr[i].region_count[1], grr[i].region_count[2],\n                           grr[i].subblock_gain[0], grr[i].subblock_gain[1], grr[i].subblock_gain[2],\n                           grr[i].preflag, grr[i].scalefac_scale, grr[i].count1_table, grr[i].scfsi);\n                }\n            }\n            mismatch++;\n        }\n    }\n\n    printf(\"checked=%ld mismatch=%ld  (ret==-1: %ld, ret>=0: %ld, sr_idx==8 cases: %ld)\\n\",\n           checked, mismatch, ret_neg1, ret_ok, oob);\n    return mismatch ? 1 : 0;\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
