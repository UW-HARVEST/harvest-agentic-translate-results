t % 2 == 0) {\n            hdr[1] = (uint8_t)((rnd(2) ? 0x18 : 0x10) | (rnd(2) ? 0x8 : 0x0) | 0x02);\n            hdr[2] = (uint8_t)((rnd(3) << 2) | (rnd(16) << 4));  // sr idx 0..2\n        }\n        // Three input regimes:\n        //  0: fully random bytes / random pos+limit (mostly early -1 returns)\n        //  1: sparse buffer + generous limit -> small part_23_length, so the\n        //     final length check passes and the full success path is exercised\n        //  2: like 1 but with pos deliberately near/over the limit\n        int mode = (int)(it % 3);\n        int limit, pos;\n        if (mode == 0) {\n            for (size_t i = 0; i < sizeof(buf); i++) buf[i] = (uint8_t)rnd(256);\n            limit = (int)rnd(BUFSZ * 8);\n            pos = (int)rnd(limit > 0 ? (uint32_t)limit + 1 : 1);\n        } else {\n            // Mostly-zero bytes keep the 12-bit part_23_length values tiny.\n            for (size_t i = 0; i < sizeof(buf); i++)\n                buf[i] = rnd(4) ? 0 : (uint8_t)rnd(256);\n            limit = BUFSZ * 8;\n            pos = (mode == 1) ? (int)rnd(64) : limit - (int)rnd(96);\n        }\n\n        // Seed the gr arrays with a recognizable pattern so that fields the\n        // library leaves untouched (e.g. region_count[2] on the short-block\n        // path) are compared too.\n        L3_gr_info_t grc[NGR], grr[NGR];\n        for (int i = 0; i < NGR; i++) {\n            memset(&grc[i], 0xA5 + i, sizeof(L3_gr_info_t));\n            memset(&grr[i], 0xA5 + i, sizeof(L3_gr_info_t));\n            grc[i].sfbtab = NULL;\n            grr[i].sfbtab = NULL;\n        }\n\n        bs_t bc = {buf, pos, limit};\n        bs_t br = {buf, pos, limit};\n\n        int rc = fc(&bc, grc, hdr);\n        int rr = fr(&br, grr, hdr);\n\n        checked++;\n        if (rc == -1) ret_neg1++; else ret_ok++;\n\n        int bad = 0;\n        if (rc != rr) bad = 1;\n        if (bc.pos != br.pos || bc.limit != br.limit || bc.buf != br.buf) bad = 1;\n\n        int sr_idx = calc_sr_idx(hdr);\n        int is_oob = (sr_idx == 8);\n        if (is_oob) oob++;\n\n        for (int i = 0; i < NGR && !bad; i++) {\n            // Compare every scalar field (i.e. the whole struct except the\n            // sfbtab pointer, whose numeric value legitimately differs).\n            const unsigned char *a = (const unsigned char *)&grc[i];\n            const unsigned char *b = (const unsigned char *)&grr[i];\n            if (memcmp(a + sizeof(const uint8_t *), b + sizeof(const uint8_t *),\n                       sizeof(L3_gr_info_t) - sizeof(const uint8_t *)) != 0)\n                bad = 1;\n\n            // Compare the table contents that sfbtab points at. Skip the\n            // sr_idx==8 case: there the C itself reads outside its tables, so\n            // its result is not well defined.\n            if (!bad && grc[i].sfbtab && grr[i].sfbtab && !is_oob) {\n                int n = grc[i].n_long_sfb + grc[i].n_short_sfb;\n                if (n > 0 && memcmp(grc[i].sfbtab, grr[i].sfbtab, (size_t)n) != 0)\n                    bad = 1;\n            }\n        }\n\n        if (bad) {\n            if (mismatch < 10) {\n                printf(\"MISMATCH it=%ld hdr=%02x%02x%02x%02x pos=%d limit=%d \"\n                       \"rc=%d rr=%d bcpos=%d brpos=%d sr_idx=%d\\n\",\n                       it, hdr[0], hdr[1], hdr[2], hdr[3], pos, limit, rc, rr,\n                       bc.pos, br.pos, sr_idx);\n                for (int i = 0; i < NGR; i++) {\n                    printf(\"  gr[%d] C: p23=%u bv=%u sfc=%u gg=%u bt=%u mbf=%u nl=%u ns=%u \"\n                           \"ts=%u,%u,%u rc=%u,%u,%u sg=%u,%u,%u pf=%u ss=%u c1=%u scfsi=%u\\n\",\n                           i, grc[i].part_23_length, grc[i].big_values, grc[i].scalefac_compress,\n                           grc[i].global_gain, grc[i].block_type, grc[i].mixed_block_flag,\n                           grc[i].n_long_sfb, grc[i].n_short_sfb,\n                           grc[i].table_select[0], grc[i].tabl