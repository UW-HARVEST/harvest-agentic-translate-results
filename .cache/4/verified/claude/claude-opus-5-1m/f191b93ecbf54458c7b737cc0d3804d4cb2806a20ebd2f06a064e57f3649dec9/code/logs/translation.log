 sample-rate index == 3.\n        hdr[1] = (uint8_t)(0x18 | (uint8_t)(rng() & 0x07));\n        hdr[2] = (uint8_t)(0x0C | (uint8_t)(rng() & 0xF3));\n        hdr[3] = (uint8_t)rng();\n        for (size_t i = 0; i < sizeof(buf); i++) buf[i] = (rng() % 4) ? 0 : (uint8_t)rng();\n\n        L3_gr_info_t gc[4], gr[4];\n        memset(gc, 0, sizeof gc); memset(gr, 0, sizeof gr);\n        bs_t bc = {buf, 0, BUFSZ * 8}, br = {buf, 0, BUFSZ * 8};\n        int rc = fc(&bc, gc, hdr), rr = fr(&br, gr, hdr);\n        if (rc != rr || rc == -1) continue;\n\n        for (int i = 0; i < 4; i++) {\n            int n = gc[i].n_long_sfb + gc[i].n_short_sfb;\n            if (n <= 0 || !gc[i].sfbtab || !gr[i].sfbtab) continue;\n            int diff = memcmp(gc[i].sfbtab, gr[i].sfbtab, (size_t)n) != 0;\n            if (gc[i].n_short_sfb == 39)      { n_short++; m_short += diff; }\n            else if (gc[i].n_short_sfb == 30) { n_mixed++; m_mixed += diff; }\n            else                              { n_long++;  m_long  += diff; }\n        }\n    }\n    printf(\"sr_idx==8 table-byte comparison (C vs Rust):\\n\");\n    printf(\"  g_scf_short[8]: %ld cases, %ld differ\\n\", n_short, m_short);\n    printf(\"  g_scf_mixed[8]: %ld cases, %ld differ\\n\", n_mixed, m_mixed);\n    printf(\"  g_scf_long[8] : %ld cases, %ld differ   (C reads .eh_frame_hdr here)\\n\", n_long, m_long);\n    return 0;\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1467,"cache_read_input_tokens":63078,"cache_creation":{"ephemeral_5m_input_tokens":1467,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"2d1d9535-4689-4dbb-a7fc-d25181a2e752","uuid":"0f531f88-99cd-4a0d-9197-71d34135361b","timestamp":"2026-08-19T10:35:29.979Z"}
