ulated C's discipline with an explicit buffer gated on `IsTerminal`, and confirmed both cases match (pipe: empty output; PTY via `script`: `fgets() failed.` emitted before the crash)."}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":252,"cache_read_input_tokens":33152,"cache_creation":{"ephemeral_5m_input_tokens":252,"ephemeral_1h_input_tokens":0},"output_tokens":9,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"87d1bc3f-52dd-4e09-9efd-f5d2bbcc281c","uuid":"30d63062-b65a-42ac-abba-411047e0c238","timestamp":"2026-08-17T20:34:19.462Z"}
