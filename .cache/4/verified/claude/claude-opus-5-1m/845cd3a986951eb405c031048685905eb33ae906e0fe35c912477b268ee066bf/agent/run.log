{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01JVpY57ej1TLj4ouKrryVNd","type":"tool_result","content":"240\t    out().flush_all();\n241\t}\n242\t\n243\t// ---------------------------------------------------------------------------\n244\t// Helpers\n245\t// ---------------------------------------------------------------------------\n246\t\n247\t/// The bytes of a C string, or `None` for a NULL pointer.\n248\tunsafe fn cstr<'a>(p: *const c_char) -> Option<&'a [u8]> {\n249\t    if p.is_null() {\n250\t        return None;\n251\t    }\n252\t    let mut len = 0usize;\n253\t    while *p.add(len) != 0 {\n254\t        len += 1;\n255\t    }\n256\t    Some(core::slice::from_raw_parts(p as *const u8, len))\n257\t}\n258\t\n259\t// ---------------------------------------------------------------------------\n260\t// tokenizer.c\n261\t// ---------------------------------------------------------------------------\n262\t\n263\t#[no_mangle]\n264\tpub extern \"C\" fn tokenizer_next_token() -> CToken {\n265\t    CToken::from_token(&tokenizer().next_token())\n266\t}\n267\t\n268\t#[no_mangle]\n269\tpub extern \"C\" fn tokenizer_peek_token() -> CToken {\n270\t    CToken::from_token(&tokenizer().peek_token())\n271\t}\n272\t\n273\t#[no_mangle]\n274\tpub extern \"C\" fn tokenizer_reset() {\n275\t    tokenizer().reset();\n276\t}\n277\t\n278\t#[no_mangle]\n279\tpub extern \"C\" fn tokenizer_load_text(text: *const c_char) -> c_int {\n280\t    let bytes = match unsafe { cstr(text) } {\n281\t        None => return -1,\n282\t        Some(b) => b,\n283\t    };\n284\t    tokenizer().load_text(bytes)\n285\t}\n286\t\n287\t#[no_mangle]\n288\tpub extern \"C\" fn tokenizer_get_stats(lines: *mut usize, tokens: *mut usize, chars: *mut usize) {\n289\t    let (l, t, c) = tokenizer().get_stats();\n290\t    unsafe {\n291\t        if !lines.is_null() {\n292\t            *lines = l;\n293\t        }\n294\t        if !tokens.is_null() {\n295\t            *tokens = t;\n296\t        }\n297\t        if !chars.is_null() {\n298\t            *chars = c;\n299\t        }\n300\t    }\n301\t}\n302\t\n303\t#[no_mangle]\n304\tpub extern \"C\" fn get_tokenizer_ops() -> CTokenizerOps {\n305\t    CTokenizerOps {\n306\t        next_token: Some(tokenizer_next_token),\n307\t        peek_token: Some(tokenizer_peek_token),\n308\t        reset: Some(tokenizer_reset),\n309\t        load_text: Some(tokenizer_load_text),\n310\t        get_stats: Some(tokenizer_get_stats),\n311\t    }\n312\t}\n313\t\n314\t// ---------------------------------------------------------------------------\n315\t// analyzer.c\n316\t// ---------------------------------------------------------------------------\n317\t\n318\t#[no_mangle]\n319\tpub extern \"C\" fn analyzer_init(ops: CTokenizerOps) {\n320\t    *OPS.get() = ops;\n321\t    analyzer().init();\n322\t}\n323\t\n324\t#[no_mangle]\n325\tpub extern \"C\" fn analyze_text(text: *const c_char) -> CAnalysisResult {\n326\t    let mut result = AnalysisResult::default();\n327\t\n328\t    if !analyzer().is_initialized() {\n329\t        err(b\"Error: Analyzer not initialized\\n\");\n330\t        return result.into();\n331\t    }\n332\t\n333\t    let ops = *OPS.get();\n334\t\n335\t    // Load text using function pointer\n336\t    let load_text = match ops.load_text {\n337\t        Some(f) => f,\n338\t        None => null_ops_member(),\n339\t    };\n340\t    if load_text(text) != 0 {\n341\t        err(b\"Error: Failed to load text\\n\");\n342\t        return result.into();\n343\t    }\n344\t\n345\t    // Process all tokens using function pointers\n346\t    let next_token = match ops.next_token {\n347\t        Some(f) => f,\n348\t        None => null_ops_member(),\n349\t    };\n350\t    loop {\n351\t        let token = next_token();\n352\t        if token.ttype == TokenType::Eof as c_int {\n353\t            break;\n354\t        }\n355\t        let value = token.value_bytes();\n356\t        analyzer().account_token(token.ttype, &value, &mut result);\n