let token = tok.next_token();\n            if token.ttype == TokenType::Eof {\n                break;\n            }\n            if strstr(&token.value, pattern) {\n                let _ = write!(out, \"Line {}, Column {}: \", token.line, token.column);\n                out.put(&token.value);\n                out.puts(\"\\n\");\n                count += 1;\n            }\n        }\n\n        let _ = write!(out, \"Found {} occurrences\\n\", count);\n    }\n}\n","structuredPatch":[{"oldStart":77,"oldLines":6,"newStart":77,"newLines":53,"lines":["         }","     }"," ","+    /// The body of the `while` loop of `analyze_text`: bump","+    /// `token_type_counts[token.type]` and the matching result counter.","+    ///","+    /// `ttype_raw` is the raw `int` value of `token.type`, because when the","+    /// analyzer is driven through `tokenizer_ops_t` function pointers the token","+    /// type is whatever the callback returned.","+    pub(crate) fn account_token(","+        &mut self,","+        ttype_raw: i32,","+        value: &[u8],","+        result: &mut AnalysisResult,","+    ) {","+        // Update counts.  The C code indexes a 20-element array with","+        // `token.type`; out-of-range values are undefined behaviour there, so","+        // they are simply not counted here.","+        if ttype_raw >= 0 && (ttype_raw as usize) < self.token_type_counts.len() {","+            self.token_type_counts[ttype_raw as usize] += 1;","+        }","+","+        match ttype_raw {","+            // TOKEN_WORD, TOKEN_IDENTIFIER","+            x if x == TokenType::Word as i32 || x == TokenType::Identifier as i32 => {","+                result.word_count += 1;","+                self.track_word(value);","+            }","+            x if x == TokenType::Number as i32 => {","+                result.number_count += 1;","+            }","+            x if x == TokenType::Keyword as i32 => {","+                result.keyword_count += 1;","+            }","+            x if x == TokenType::Operator as i32 => {","+                result.operator_count += 1;","+            }","+            x if x == TokenType::Comment as i32 => {","+                result.comment_count += 1;","+            }","+            x if x == TokenType::Str as i32 => {","+                result.string_count += 1;","+            }","+            x if x == TokenType::Newline as i32 => {","+                result.line_count += 1;","+            }","+            _ => {}","+        }","+    }","+","     pub fn analyze_text(&mut self, tok: &mut Tokenizer, text: &[u8]) -> AnalysisResult {","         let mut result = AnalysisResult::default();"," "]},{"oldStart":98,"oldLines":35,"newStart":145,"newLines":8,"lines":["                 break;","             }"," ","-            // Update counts","-            self.token_type_counts[token.ttype.index()] += 1;","-","-            match token.ttype {","-                TokenType::Word | TokenType::Identifier => {","-                    result.word_count += 1;","-                    let value = token.value.clone();","-                    self.track_word(&value);","-                }","-                TokenType::Number => {","-                    result.number_count += 1;","-                }","-                TokenType::Keyword => {","-                    result.keyword_count += 1;","-                }","-                TokenType::Operator => {","-                    result.operator_count += 1;","-                }","-                TokenType::Comment => {","-                    result.comment_count += 1;","-                }","-                TokenType::Str => {","-                    result.string_count += 1;","-                }","-                TokenType::Newline => {","-                    result.line_count += 1;","-                }","-                _ => {}","-            }","+            let value = token.value.clone();","+            self.account_token(token.ttype as i32, &value, &mut result);","         }"," ","  