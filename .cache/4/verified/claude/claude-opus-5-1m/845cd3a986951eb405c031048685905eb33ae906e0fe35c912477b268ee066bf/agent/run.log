{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01LyUu2vVUHJqShnqyiAzt6r","type":"tool_result","content":"1\t//! Translation of c_src/src/tokenizer.c\n2\t//!\n3\t//! The C file keeps its state in file-scope `static` variables; here that state\n4\t//! lives in a single `Tokenizer` value that is threaded through the program.\n5\t\n6\tuse crate::cio::{c_isalnum, c_isalpha, c_isdigit, c_isspace, err, up_to_nul};\n7\t\n8\tpub const MAX_TOKEN_LENGTH: usize = 256;\n9\tpub const MAX_BUFFER_SIZE: usize = 8192;\n10\t\n11\t#[derive(Clone, Copy, PartialEq, Eq, Debug)]\n12\t#[allow(dead_code)] // mirrors the C enum; some variants are never produced\n13\tpub enum TokenType {\n14\t    Eof = 0,\n15\t    Word = 1,\n16\t    Number = 2,\n17\t    Punctuation = 3,\n18\t    Whitespace = 4,\n19\t    Newline = 5,\n20\t    Identifier = 6,\n21\t    Keyword = 7,\n22\t    Operator = 8,\n23\t    Str = 9,\n24\t    Comment = 10,\n25\t    Error = 11,\n26\t}\n27\t\n28\timpl TokenType {\n29\t    pub fn index(self) -> usize {\n30\t        self as usize\n31\t    }\n32\t}\n33\t\n34\t#[derive(Clone)]\n35\tpub struct Token {\n36\t    pub ttype: TokenType,\n37\t    /// C string contents of `token.value` (no NUL terminator).\n38\t    pub value: Vec<u8>,\n39\t    #[allow(dead_code)] // mirrors token_t.length\n40\t    pub length: usize,\n41\t    pub line: i32,\n42\t    pub column: i32,\n43\t}\n44\t\n45\tstatic KEYWORDS: [&[u8]; 31] = [\n46\t    b\"if\",\n47\t    b\"else\",\n48\t    b\"while\",\n49\t    b\"for\",\n50\t    b\"return\",\n51\t    b\"int\",\n52\t    b\"char\",\n53\t    b\"float\",\n54\t    b\"double\",\n55\t    b\"void\",\n56\t    b\"struct\",\n57\t    b\"typedef\",\n58\t    b\"const\",\n59\t    b\"static\",\n60\t    b\"extern\",\n61\t    b\"auto\",\n62\t    b\"register\",\n63\t    b\"sizeof\",\n64\t    b\"break\",\n65\t    b\"continue\",\n66\t    b\"switch\",\n67\t    b\"case\",\n68\t    b\"default\",\n69\t    b\"do\",\n70\t    b\"goto\",\n71\t    b\"enum\",\n72\t    b\"union\",\n73\t    b\"signed\",\n74\t    b\"unsigned\",\n75\t    b\"long\",\n76\t    b\"short\",\n77\t];\n78\t\n79\tfn is_keyword(s: &[u8]) -> bool {\n80\t    KEYWORDS.iter().any(|k| *k == s)\n81\t}\n82\t\n83\tconst OPERATOR_CHARS: &[u8] = b\"+-*/%=<>!&|^~?:\";\n84\tconst PUNCTUATION_CHARS: &[u8] = b\"(){}[];,.\";\n85\t\n86\tpub struct Tokenizer {\n87\t    input_buffer: Vec<u8>,\n88\t    buffer_length: usize,\n89\t    current_position: usize,\n90\t    current_line: i32,\n91\t    current_column: i32,\n92\t    total_tokens_processed: usize,\n93\t    total_lines_processed: usize,\n94\t    total_chars_processed: usize,\n95\t    lookahead_token: Option<Token>,\n96\t}\n97\t\n98\timpl Tokenizer {\n99\t    pub fn new() -> Tokenizer {\n100\t        Tokenizer {\n101\t            input_buffer: vec![0u8; MAX_BUFFER_SIZE],\n102\t            buffer_length: 0,\n103\t            current_position: 0,\n104\t            current_line: 1,\n105\t            current_column: 1,\n106\t            total_tokens_processed: 0,\n107\t            total_lines_processed: 0,\n108\t            total_chars_processed: 0,\n109\t            lookahead_token: None,\n110\t        }\n111\t    }\n112\t\n113\t    fn peek_char(&self) -> u8 {\n114\t        if self.current_position >= self.buffer_length {\n115\t            return 0;\n116\t        }\n117\t        self.input_buffer[self.current_position]\n118\t    }\n119\t\n120\t    fn advance_char(&mut self) -> u8 {\n121\t        if self.current_position >= self.buffer_length {\n122\t            return 0;\n123\t        }\n124\t\n125\t        let c = self.input_buffer[self.current_position];\n126\t        self.current_position += 1;\n127\t        self.total_chars_processed += 1;\n128\t\n129\t        if c == b'\\n' {\n130\t            self.current_line = self.current_line.wrapping_add(1);\n131\t            self.current_column = 1;\n132\t            self.total_lines_processed += 1;\n133\t        } else {\n134\t            self.current_column = self.current_column.wrapping_add(1);\n135\t        }\n136\t\n137\t        c\n138\t    }\n139\t\n140\t    fn skip_whitespace(&mut self) {\n141\t        while self.peek_char() != 0 && c_isspace(self.peek_char()) && self.peek_char() != b'\\n' {\n142\t            self.advance_char();\n143\t        }\n144\t    }\n145\t\n146\t    fn create_token(&mut self, ttype: TokenType, value: &[u8], length: usize) -> Token {\n147\t        let len = if length < MAX_TOKEN_LENGTH {\n148\t            length\n149\t        } else {\n150\t            MAX_TOKEN_LENGTH - 1\n151\t        };\n152\t        // strncpy(token.value, value, len) followed by value[len] = '\\0'\n153\t        let mut v: Vec<u8> = Vec::with_capacity(len);\n154\t        let src = up_to_nul(value);\n155\t        let copied = if src.len() < len { src.len() } else { len };\n156\t        v.extend_from_slice(&src[..copied]);\n157\t        // strncpy zero-pads, so the C string ends at `copied` bytes anyway.\n158\t\n159\t        // `current_column - token.length`: size_t arithmetic truncated back to\n160\t        // int, i.e. wrapping 32-bit subtraction.\n161\t        let column = self.current_column.wrapping_sub(len as i32);\n162\t\n163\t        self.total_tokens_processed += 1;\n164\t\n165\t        Token {\n166\t            ttype,\n167\t            value: v,\n168\t            length: len,\n169\t            line: self.current_line,\n170\t            column,\n171\t        }\n172\t    }\n173\t\n174\t    fn scan_word(&mut self) -> Token {\n175\t        let mut buffer: Vec<u8> = Vec::new();\n176\t\n177\t        while self.peek_char() != 0\n178\t            && (c_isalnum(self.peek_char()) || self.peek_char() == b'_')\n179\t            && buffer.len() < MAX_TOKEN_LENGTH - 1\n180\t        {\n181\t            let c = self.advance_char();\n182\t            buffer.push(c);\n183\t        }\n184\t\n185\t        let length = buffer.len();\n186\t        if is_keyword(&buffer) {\n187\t            return self.create_token(TokenType::Keyword, &buffer, length);\n188\t        }\n189\t\n190\t        self.create_token(TokenType::Identifier, &buffer, length)\n191\t    }\n192\t\n193\t    fn scan_number(&mut self) -> Token {\n194\t        let mut buffer: Vec<u8> = Vec::new();\n195\t        let mut has_decimal = false;\n196\t\n197\t        while self.peek_char() != 0\n198\t            && (c_isdigit(self.peek_char()) || self.peek_char() == b'.')\n199\t            && buffer.len() < MAX_TOKEN_LENGTH - 1\n200\t        {\n201\t            if self.peek_char() == b'.' {\n202\t                if has_decimal {\n203\t                    break; // Second decimal point\n204\t                }\n205\t                has_decimal = true;\n206\t            }\n207\t\n208\t            let c = self.advance_char();\n209\t            buffer.push(c);\n210\t        }\n211\t\n212\t        let length = buffer.len();\n213\t        self.create_token(TokenType::Number, &buffer, length)\n214\t    }\n215\t\n216\t    fn scan_string(&mut self) -> Token {\n217\t        let mut buffer: Vec<u8> = Vec::new();\n218\t        let quote = self.advance_char(); // Consume opening quote\n219\t\n220\t        buffer.push(quote);\n221\t\n222\t        while self.peek_char() != 0\n223\t            && self.peek_char() != quote\n224\t            && self.peek_char() != b'\\n'\n225\t            && buffer.len() < MAX_TOKEN_LENGTH - 2\n226\t        {\n227\t            if self.peek_char() == b'\\\\' {\n228\t                let c = self.advance_char(); // Escape character\n229\t                buffer.push(c);\n230\t                if self.peek_char() != 0 {\n231\t                    let c2 = self.advance_char(); // Escaped character\n232\t                    buffer.push(c2);\n233\t                }\n234\t            } else {\n235\t                let c = self.advance_char();\n236\t                buffer.push(c);\n237\t            }\n238\t        }\n239\t\n240\t        if self.peek_char() == quote {\n241\t            let c = self.advance_char(); // Closing quote\n242\t            buffer.push(c);\n243\t        }\n244\t\n245\t        let length = buffer.len();\n246\t        self.create_token(TokenType::Str, &buffer, length)\n247\t    }\n248\t\n249\t    fn scan_comment(&mut self) -> Token {\n250\t        let mut buffer: Vec<u8> = Vec::new();\n251\t\n252\t        // Assume we've seen '/'\n253\t        let c = self.advance_char(); // First '/'\n254\t        buffer.push(c);\n255\t\n256\t        if self.peek_char() == b'/' {\n257\t            // Single-line comment\n258\t            let c = self.advance_char(); // Second '/'\n259\t            buffer.push(c);\n260\t\n261\t            while self.peek_char() != 0\n262\t                && self.peek_char() != b'\\n'\n263\t                && buffer.len() < MAX_TOKEN_LENGTH - 1\n264\t            {\n265\t                let c = self.advance_char();\n266\t                buffer.push(c);\n267\t            }\n268\t        } else if self.peek_char() == b'*' {\n269\t            // Multi-line comment\n270\t            let c = self.advance_char(); // '*'\n271\t            buffer.push(c);\n272\t\n273\t            while self.peek_char() != 0 && buffer.len() < MAX_TOKEN_LENGTH - 2 {\n274\t                if self.peek_char() == b'*' {\n275\t                    let c = self.advance_char();\n276\t                    buffer.push(c);\n277\t                    if self.peek_char() == b'/' {\n278\t                        let c = self.advance_char();\n279\t                        buffer.push(c);\n280\t                        break;\n281\t                    }\n282\t                } else {\n283\t                    let c = self.advance_char();\n284\t                    buffer.push(c);\n285\t                }\n286\t            }\n287\t        }\n288\t\n289\t        let length = buffer.len();\n290\t        self.create_token(TokenType::Comment, &buffer, length)\n291\t    }\n292\t\n293\t    fn scan_operator(&mut self) -> Token {\n294\t        let mut buffer: Vec<u8> = Vec::new();\n295\t        let c = self.peek_char();\n296\t\n297\t        let first = self.advance_char();\n298\t        buffer.push(first);\n299\t\n300\t        // Check for two-character operators\n301\t        let next = self.peek_char();\n302\t        if (c == b'=' && next == b'=')\n303\t            || (c == b'!' && next == b'=')\n304\t            || (c == b'<' && next == b'=')\n305\t            || (c == b'>' && next == b'=')\n306\t            || (c == b'&' && next == b'&')\n307\t            || (c == b'|' && next == b'|')\n308\t            || (c == b'+' && next == b'+')\n309\t            || (c == b'-' && next == b'-')\n310\t            || (c == b'-' && next == b'>')\n311\t            || (c == b'<' && next == b'<')\n312\t            || (c == b'>' && next == b'>')\n313\t        {\n314\t            let c2 = self.advance_char();\n315\t            buffer.push(c2);\n316\t        }\n317\t\n318\t        let length = buffer.len();\n319\t        self.create_token(TokenType::Operator, &buffer, length)\n320\t    }\n321\t\n322\t    pub fn next_token(&mut self) -> Token {\n323\t        // Check if we have a lookahead token\n324\t        if let Some(tok) = self.lookahead_token.take() {\n325\t            return tok;\n326\t        }\n327\t\n328\t        self.skip_whitespace();\n329\t\n330\t        if self.current_position >= self.buffer_length {\n331\t            return self.create_token(TokenType::Eof, b\"\", 0);\n332\t        }\n333\t\n334\t        let c = self.peek_char();\n335\t\n336\t        // Newline\n337\t        if c == b'\\n' {\n338\t            let nl = self.advance_char();\n339\t            return self.create_token(TokenType::Newline, &[nl], 1);\n340\t        }\n341\t\n342\t        // Identifier or keyword\n343\t        if c_isalpha(c) || c == b'_' {\n344\t            return self.scan_word();\n345\t        }\n346\t\n347\t        // Number\n348\t        if c_isdigit(c) {\n349\t            return self.scan_number();\n350\t        }\n351\t\n352\t        // String\n353\t        if c == b'\"' || c == b'\\'' {\n354\t            return self.scan_string();\n355\t        }\n356\t\n357\t        // Comment\n358\t        // NOTE: the C source compares `peek_char()` (== c) against '/' and '*',\n359\t        // so any '/' takes this branch. Preserved as-is.\n360\t        if c == b'/' && (self.peek_char() == b'/' || self.peek_char() == b'*') {\n361\t            return self.scan_comment();\n362\t        }\n363\t\n364\t        // Operator\n365\t        if OPERATOR_CHARS.contains(&c) {\n366\t            return self.scan_operator();\n367\t        }\n368\t\n369\t        // Punctuation\n370\t        if PUNCTUATION_CHARS.contains(&c) {\n371\t            let p = self.advance_char();\n372\t            return self.create_token(TokenType::Punctuation, &[p], 1);\n373\t        }\n374\t\n375\t        // Unknown character\n376\t        let u = self.advance_char();\n377\t        self.create_token(TokenType::Error, &[u], 1)\n378\t    }\n379\t\n380\t    #[allow(dead_code)]\n381\t    pub fn peek_token(&mut self) -> Token {\n382\t        if self.lookahead_token.is_none() {\n383\t            let tok = self.next_token();\n384\t            self.lookahead_token = Some(tok);\n385\t        }\n386\t        self.lookahead_token.clone().unwrap()\n387\t    }\n388\t\n389\t    pub fn reset(&mut self) {\n390\t        self.current_position = 0;\n391\t        self.current_line = 1;\n392\t        self.current_column = 1;\n393\t        self.lookahead_token = None;\n394\t        // Note: We don't reset total statistics\n395\t    }\n396\t\n397\t    /// `tokenizer_load_text`: returns 0 on success, -1 on failure.\n398\t    pub fn load_text(&mut self, text: &[u8]) -> i32 {\n399\t        // The C code checks for a NULL pointer; callers never pass one.\n400\t        let s = up_to_nul(text);\n401\t        let length = s.len();\n402\t        if length >= MAX_BUFFER_SIZE {\n403\t            err(b\"Error: Input text too large\\n\");\n404\t            return -1;\n405\t        }\n406\t\n407\t        for b in self.input_buffer.iter_mut() {\n408\t            *b