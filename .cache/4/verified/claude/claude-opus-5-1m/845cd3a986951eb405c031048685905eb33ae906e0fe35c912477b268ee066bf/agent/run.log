t    int line;\n53\t    int column;\n54\t} token_t;\n55\t\n56\t// Function pointer types for tokenizer operations\n57\ttypedef token_t (*tokenizer_next_fn)(void);\n58\ttypedef token_t (*tokenizer_peek_fn)(void);\n59\ttypedef void (*tokenizer_reset_fn)(void);\n60\ttypedef int (*tokenizer_load_fn)(const char *text);\n61\ttypedef void (*tokenizer_get_stats_fn)(size_t *lines, size_t *tokens, size_t *chars);\n62\t\n63\t// Tokenizer operations structure\n64\ttypedef struct {\n65\t    tokenizer_next_fn next_token;\n66\t    tokenizer_peek_fn peek_token;\n67\t    tokenizer_reset_fn reset;\n68\t    tokenizer_load_fn load_text;\n69\t    tokenizer_get_stats_fn get_stats;\n70\t} tokenizer_ops_t;\n71\t\n72\t// Get tokenizer operations (returns function pointers)\n73\ttokenizer_ops_t get_tokenizer_ops(void);\n74\t\n75\t// Individual functions (can also be called directly)\n76\ttoken_t tokenizer_next_token(void);\n77\ttoken_t tokenizer_peek_token(void);\n78\tvoid tokenizer_reset(void);\n79\tint tokenizer_load_text(const char *text);\n80\tvoid tokenizer_get_stats(size_t *lines, size_t *tokens, size_t *chars);\n81\t\n82\t#endif // TOKENIZER_H\n83\t"}]},"parent_tool_use_id":null,"session_id":"a5a5c366-7b13-48c9-a820-e7aa27b1e5c6","uuid":"1a2b35d7-484e-43ef-be24-cf9aed5cbc5d","timestamp":"2026-08-19T23:10:48.018Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-GvqiYm/translated_rust/c_src/include/tokenizer.h","content":"/*\n * Copyright 2025 MIT Lincoln Laboratory\n * Permission is hereby granted, free of charge,\n * to any person obtaining a copy of this software\n * and associated documentation files (the \"Software\"),\n * to deal in the Software without restriction,\n * including without limitation the rights to use, copy,\n * modify, merge, publish, distribute, sublicense,\n * and/or sell copies of the Software,\n * and to permit persons to whom the Software is furnished to do so,\n * subject to the following conditions:\n * \n