           \"result\" => {\n                let n: Vec<usize> = it.map(|x| x.parse().expect(\"number\")).collect();\n                assert_eq!(n.len(), 8, \"result needs 8 numbers\");\n                (api.print_analysis_result)(CResult {\n                    word_count: n[0],\n                    number_count: n[1],\n                    keyword_count: n[2],\n                    operator_count: n[3],\n                    comment_count: n[4],\n                    string_count: n[5],\n                    line_count: n[6],\n                    char_count: n[7],\n                });\n            }\n            \"interactive\" => (api.interactive_tokenizer)((api.get_tokenizer_ops)()),\n            \"interactive_badload\" => {\n                unsafe { STUB_LOAD_RC = -1 };\n                (api.interactive_tokenizer)(stub_ops());\n            }\n            other => panic!(\"unknown command {:?}\", other),\n        }\n        let _ = err.flush();\n    }\n\n    // Drain whatever the library still holds buffered, exactly like the\n    // process-exit flush of the C build.\n    api.flush();\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1740,"cache_read_input_tokens":175789,"cache_creation":{"ephemeral_5m_input_tokens":1740,"ephemeral_1h_input_tokens":0},"output_tokens":17,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"a5a5c366-7b13-48c9-a820-e7aa27b1e5c6","uuid":"eadbb268-4bc4-48dd-afa8-aaf55d66e43d","timestamp":"2026-08-19T23:33:32.842Z"}
