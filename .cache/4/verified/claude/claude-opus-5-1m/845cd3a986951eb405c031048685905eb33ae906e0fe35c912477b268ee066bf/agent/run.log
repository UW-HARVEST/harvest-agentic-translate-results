{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01HWmTdQftMFatgvRNxBXN64","type":"tool_result","content":"1\t/*\n2\t * Copyright 2025 MIT Lincoln Laboratory\n3\t * Permission is hereby granted, free of charge,\n4\t * to any person obtaining a copy of this software\n5\t * and associated documentation files (the \"Software\"),\n6\t * to deal in the Software without restriction,\n7\t * including without limitation the rights to use, copy,\n8\t * modify, merge, publish, distribute, sublicense,\n9\t * and/or sell copies of the Software,\n10\t * and to permit persons to whom the Software is furnished to do so,\n11\t * subject to the following conditions:\n12\t * \n13\t * The above copyright notice and this permission notice\n14\t * shall be included in all copies or substantial portions of the Software.\n15\t * \n16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n18\t * THE WARRANTIES OF MERCHANTABILITY,\n19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n24\t */\n25\t#include \"tokenizer.h\"\n26\t#include <stdio.h>\n27\t#include <stdlib.h>\n28\t#include <string.h>\n29\t#include <ctype.h>\n30\t\n31\t// Static global variables (file-local scope)\n32\tstatic char input_buffer[MAX_BUFFER_SIZE];\n33\tstatic size_t buffer_length = 0;\n34\tstatic size_t current_position = 0;\n35\tstatic int current_line = 1;\n36\tstatic int current_column = 1;\n37\tstatic size_t total_tokens_processed = 0;\n38\tstatic size_t total_lines_processed = 0;\n39\tstatic size_t total_chars_processed = 0;\n40\tstatic token_t lookahead_token;\n41\tstatic int lookahead_valid = 0;\n42\t\n43\t// Static keywords for recognition\n44\tstatic const char *keywords[] = {\n45\t    \"if\", \"else\", \"while\", \"for\", \"return\", \"int\", \"char\", \n46\t    \"float\", \"double\", \"void\", \"struct\", \"typedef\", \"const\",\n47\t    \"static\", \"extern\", \"auto\", \"register\", \"sizeof\", \"break\",\n48\t    \"continue\", \"switch\", \"case\", \"default\", \"do\", \"goto\",\n49\t    \"enum\", \"union\", \"signed\", \"unsigned\", \"long\", \"short\"\n50\t};\n51\tstatic const int num_keywords = sizeof(keywords) / sizeof(keywords[0]);\n52\t\n53\t// Static helper functions (internal to this file)\n54\tstatic int is_keyword(const char *str) {\n55\t    for (int i = 0; i < num_keywords; i++) {\n56\t        if (strcmp(str, keywords[i]) == 0) {\n57\t            return 1;\n58\t        }\n59\t    }\n60\t    return 0;\n61\t}\n62\t\n63\tstatic char peek_char(void) {\n64\t    if (current_position >= buffer_length) {\n65\t        return '\\0';\n66\t    }\n67\t    return input_buffer[current_position];\n68\t}\n69\t\n70\tstatic char advance_char(void) {\n71\t    if (current_position >= buffer_length) {\n72\t        return '\\0';\n73\t    }\n74\t    \n75\t    char c = input_buffer[current_position++];\n76\t    total_chars_processed++;\n77\t    \n78\t    if (c == '\\n') {\n79\t        current_line++;\n80\t        current_column = 1;\n81\t        total_lines_processed++;\n82\t    } else {\n83\t        current_column++;\n84\t    }\n85\t    \n86\t    return c;\n87\t}\n88\t\n89\tstatic void skip_whitespace(void) {\n90\t    while (peek_char() != '\\0' && isspace(peek_char()) && peek_char() != '\\n') {\n91\t        advance_char();\n92\t    }\n93\t}\n94\t\n95\tstatic token_t create_token(token_type_t type, const char *value, size_t length) {\n96\t    token_t token;\n97\t    token.type = type;\n98\t    token.length = length < MAX_TOKEN_LENGTH ? length : MAX_TOKEN_LENGTH - 1;\n99\t    strncpy(token.value, value, token.length);\n100\t    token.value[token.length] = '\\0';\n101\t    token.line =