{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Y1s46uMxo4wWMevfcvkM86","type":"tool_result","content":"1\t//! C standard-I/O emulation helpers: buffered stdout (matching glibc's\n2\t//! block/line buffering behaviour), unbuffered stderr, `fgets`, `sscanf(\"%d\")`,\n3\t//! `strncat`, `strstr` and the `<ctype.h>` classification functions for the\n4\t//! \"C\" locale.\n5\t\n6\tuse std::io::{self, IsTerminal, Read, Write};\n7\t\n8\t// ---------------------------------------------------------------------------\n9\t// ctype.h (C locale)\n10\t// ---------------------------------------------------------------------------\n11\t\n12\tpub fn c_isspace(c: u8) -> bool {\n13\t    matches!(c, b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r')\n14\t}\n15\t\n16\tpub fn c_isalpha(c: u8) -> bool {\n17\t    c.is_ascii_alphabetic()\n18\t}\n19\t\n20\tpub fn c_isdigit(c: u8) -> bool {\n21\t    c.is_ascii_digit()\n22\t}\n23\t\n24\tpub fn c_isalnum(c: u8) -> bool {\n25\t    c.is_ascii_alphanumeric()\n26\t}\n27\t\n28\t// ---------------------------------------------------------------------------\n29\t// C string helpers\n30\t// ---------------------------------------------------------------------------\n31\t\n32\t/// The portion of `s` that a C string function would see (up to the first NUL).\n33\tpub fn up_to_nul(s: &[u8]) -> &[u8] {\n34\t    match s.iter().position(|&b| b == 0) {\n35\t        Some(i) => &s[..i],\n36\t        None => s,\n37\t    }\n38\t}\n39\t\n40\t/// `strncat(dst, src, n)` where `dst`/`src` are NUL-terminated C strings.\n41\tpub fn strncat(dst: &mut Vec<u8>, src: &[u8], n: usize) {\n42\t    let s = up_to_nul(src);\n43\t    let take = if s.len() < n { s.len() } else { n };\n44\t    dst.extend_from_slice(&s[..take]);\n45\t}\n46\t\n47\t/// `strstr(haystack, needle) != NULL` (an empty needle always matches).\n48\tpub fn strstr(haystack: &[u8], needle: &[u8]) -> bool {\n49\t    if needle.is_empty() {\n50\t        return true;\n51\t    }\n52\t    if needle.len() > haystack.len() {\n53\t        return false;\n54\t    }\n55\t    haystack\n56\t        .windows(needle.len())\n57\t        .any(|w| w == needle)\n58\t}\n59\t\n60\t/// `s[strcspn(s, \"\\n\")] = 0` -- truncate the C string at the first newline.\n61\tpub fn truncate_at_newline(s: &[u8]) -> Vec<u8> {\n62\t    let s = up_to_nul(s);\n63\t    match s.iter().position(|&b| b == b'\\n') {\n64\t        Some(i) => s[..i].to_vec(),\n65\t        None => s.to_vec(),\n66\t    }\n67\t}\n68\t\n69\t/// `sscanf(s, \"%d\", &out)`: returns `Some(value)` when one item was assigned.\n70\t///\n71\t/// Mirrors glibc: the value is accumulated as a `long`, saturating at\n72\t/// `LONG_MAX`/`LONG_MIN` on overflow, and then truncated to `int`.\n73\tpub fn sscanf_int(s: &[u8]) -> Option<i32> {\n74\t    let s = up_to_nul(s);\n75\t    let mut i = 0usize;\n76\t\n77\t    while i < s.len() && c_isspace(s[i]) {\n78\t        i += 1;\n79\t    }\n80\t\n81\t    let mut negative = false;\n82\t    if i < s.len() && (s[i] == b'+' || s[i] == b'-') {\n83\t        negative = s[i] == b'-';\n84\t        i += 1;\n85\t    }\n86\t\n87\t    let start = i;\n88\t    let mut acc: i64 = 0;\n89\t    let mut overflow = false;\n90\t    while i < s.len() && c_isdigit(s[i]) {\n91\t        let d = i64::from(s[i] - b'0');\n92\t        match acc.checked_mul(10).and_then(|v| v.checked_add(d)) {\n93\t            Some(v) => acc = v,\n94\t            None => overflow = true,\n95\t        }\n96\t        i += 1;\n97\t    }\n98\t\n99\t    if i == start {\n100\t        // Matching failure (0) or input failure (EOF); neither assigns.\n101\t        return None;\n102\t    }\n103\t\n104\t    let value: i64 = if overflow {\n105\t        if negative {\n106\t            i64::MIN\n107\t        } else {\n108\t            i64::MAX\n109\t        }\n110\t    } else if negative {\n111\t        -acc\n112\t    } else {\n113\t        acc\n114\t    };\n115\t\n116\t    // Assignment to an `int` truncates the low 32 bits.\n117\t    Some(value as i32)\n118\t}\n119\t\n120\t// ---------------------------------------------------------------------------\n121\t// stdout / stderr\n122\t// ---------------------------------------------------------------------------\n123\t\n124\t/// Emulates a C `FILE *` for stdout: line buffered on a terminal, otherwise\n125\t/// block buffered with a 4096-byte buffer (glibc's usual pipe/file block size).\n126\tpub struct Out {\n127\t    buf: Vec<u8>,\n128\t    cap: usize,\n129\t    line_buffered: bool,\n130\t}\n131\t\n132\timpl Out {\n133\t    pub fn new() -> Out {\n134\t        let line_buffered = io::stdout().is_terminal();\n135\t        Out {\n136\t            buf: Vec::with_capacity(4096),\n137\t            cap: 4096,\n138\t            line_buffered,\n139\t        }\n140\t    }\n141\t\n142\t    fn emit(chunk: &[u8]) {\n143\t        let stdout = io::stdout();\n144\t        let mut lock = stdout.lock();\n145\t        let _ = lock.write_all(chunk);\n146\t        let _ = lock.flush();\n147\t    }\n148\t\n149\t    pub fn put(&mut self, data: &[u8]) {\n150\t        self.buf.extend_from_slice(data);\n151\t        if self.line_buffered {\n152\t            if let Some(pos) = self.buf.iter().rposition(|&b| b == b'\\n') {\n153\t                let chunk: Vec<u8> = self.buf.drain(..=pos).collect();\n154\t                Out::emit(&chunk);\n155\t            }\n156\t        } else {\n157\t            while self.buf.len() >= self.cap {\n158\t                let chunk: Vec<u8> = self.buf.drain(..self.cap).collect();\n159\t                Out::emit(&chunk);\n160\t            }\n161\t        }\n162\t    }\n163\t\n164\t    pub fn puts(&mut self, s: &str) {\n165\t        self.put(s.as_bytes());\n166\t    }\n167\t\n168\t    pub fn flush_all(&mut self) {\n169\t        if !self.buf.is_empty() {\n170\t            let chunk: Vec<u8> = self.buf.drain(..).collect();\n171\t            Out::emit(&chunk);\n172\t        }\n173\t    }\n174\t}\n175\t\n176\timpl Write for Out {\n177\t    fn write(&mut self, data: &[u8]) -> io::Result<usize> {\n178\t        self.put(data);\n179\t        Ok(data.len())\n180\t    }\n181\t\n182\t    fn flush(&mut self) -> io::Result<()> {\n183\t        self.flush_all();\n184\t        Ok(())\n185\t    }\n186\t}\n187\t\n188\t/// `fprintf(stderr, ...)` -- stderr is unbuffered in C.\n189\tpub fn err(data: &[u8]) {\n190\t    let stderr = io::stderr();\n191\t    let mut lock = stderr.lock();\n192\t    let _ = lock.write_all(data);\n193\t    let _ = lock.flush();\n194\t}\n195\t\n196\t// ---------------------------------------------------------------------------\n197\t// stdin\n198\t// ---------------------------------------------------------------------------\n199\t\n200\t/// Emulates `fgets` on stdin, including its buffer-size truncation behaviour.\n201\tpub struct In {\n202\t    inner: io::Stdin,\n203\t    buf: Vec<u8>,\n204\t    pos: usize,\n205\t    eof: bool,\n206\t}\n207\t\n208\timpl In {\n209\t    pub fn new() -> In {\n210\t        In {\n211\t            inner: io::stdin(),\n212\t            buf: Vec::new(),\n213\t            pos: 0,\n214\t            eof: false,\n215\t        }\n216\t    }\n217\t\n218\t    fn fill(&mut self) -> bool {\n219\t        if self.pos < self.buf.len() {\n220\t            return true;\n221\t        }\n222\t        if self.eof {\n223\t            return false;\n224\t        }\n225\t        let mut chunk = [0u8; 4096];\n226\t        loop {\n227\t            match self.inner.read(&mut chunk) {\n228\t                Ok(0) => {\n229\t                    self.eof = true;\n230\t                    return false;\n231\t                }\n232\t                Ok(n) => {\n233\t                    self.buf.clear();\n234\t                    self.buf.extend_from_slice(&chunk[..n]);\n235\t                    self.pos = 0;\n236\t                    return true;\n237\t                }\n238\t                Err(ref e) if e.kind() == io::ErrorKind::Interrupted => continue,\n239\t                Err(_) => {\n240\t                    self.eof = true;\n241\t                    return false;\n242\t                }\n243\t            }\n244\t        }\n245\t    }\n246\t\n247\t    fn next_byte(&mut self) -> Option<u8> {\n248\t        if !self.fill() {\n249\t            return None;\n250\t        }\n251\t        let b = self.buf[self.pos];\n252\t        self.pos += 1;\n253\t        Some(b)\n254\t    }\n255\t\n256\t    /// `fgets(buf, size, stdin)`: reads at most `size - 1` bytes, stopping\n257\t    /// after a newline. Returns `None` on immediate EOF (C returns NULL).\n258\t    /// The returned vector is the C string contents (no NUL terminator).\n259\t    pub fn fgets(&mut self, size: usize) -> Option<Vec<u8>> {\n260\t        if size <= 1 {\n261\t            return None;\n262\t        }\n263\t        let mut out: Vec<u8> = Vec::new();\n264\t        while out.len() < size - 1 {\n265\t            match self.next_byte() {\n266\t                Some(b) => {\n267\t                    out.push(b);\n268\t                    if b == b'\\n' {\n269\t                        break;\n270\t                    }\n271\t                }\n272\t                None => break,\n273\t            }\n274\t        }\n275\t        if out.is_empty() {\n276\t            None\n277\t        } else {\n278\t            Some(out)\n279\t        }\n280\t    }\n281\t}\n282\t"}]},"parent_tool_use_id":null,"session_id":"a5a5c366-7b13-48c9-a820-e7aa27b1e5c6","uuid":"b6bd335c-27b3-4800-b822-6cc0c732ced0","timestamp":"2026-08-19T23:11:04.542Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-GvqiYm/translated_rust/src/cio.rs","content":"//! C standard-I/O emulation helpers: buffered stdout (matching glibc's\n//! block/line buffering behaviour), unbuffered stderr, `fgets`, `sscanf(\"%d\")`,\n//! `strncat`, `strstr` and the `<ctype.h>` classification functions for the\n//! \"C\" locale.\n\nuse std::io::{self, IsTerminal, Read, Write};\n\n// ---------------------------------------------------------------------------\n// ctype.h (C locale)\n// ---------------------------------------------------------------------------\n\npub fn c_isspace(c: u8) -> bool {\n    matches!(c, b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r')\n}\n\npub fn c_isalpha(c: u8) -> bool {\n    c.is_ascii_alphabetic()\n}\n\npub fn c_isdigit(c: u8) -> bool {\n    c.is_ascii_digit()\n}\n\npub fn c_isalnum(c: u8) -> bool {\n    c.is_ascii_alphanumeric()\n}\n\n// ---------------------------------------------------------------------------\n// C string helpers\n// ---------------------------------------------------------------------------\n\n/// The portion of `s` that a C string function would see (up to the first NUL).\npub fn up_to_nul(s: &[u8]) -> &[u8] {\n    match s.iter().position(|&b| b == 0) {\n        Some(i) => &s[..i],\n        None => s,\n    }\n}\n\n/// `strncat(dst, src, n)` where `dst`/`src` are NUL-terminated C strings.\npub fn strncat(dst: &mut Vec<u8>, src: &[u8], n: usize) {\n    let s = up_to_nul(src);\n    let take = if s.len() < n { s.len() } else { n };\n    dst.extend_from_slice(&s[..take]);\n}\n\n/// `strstr(haystack, needle) != NULL` (an empty needle always matches).\npub fn strstr(haystack: &[u8], needle: &[u8]) -> bool {\n    if needle.is_empty() {\n        return true;\n    }\n    if needle.len() > haystack.len() {\n        return false;\n    }\n    haystack\n        .windows(needle.len())\n        .any(|w| w == needle)\n}\n\n/// `s[strcspn(s, \"\\n\")] = 0` -- truncate the C string at the first newline.\npub fn truncate_at_newline(s: &[u8]) -> Vec<u8> {\n    let s = up_to_nul(s);\n    match s.iter().position(|&b| b == b'\\n') {\n        Some(i) => s[..i].to_vec(),\n        None => s.to_vec(),\n    }\n}\n\n/// `sscanf(s, \"%d\", &out)`: returns `Some(value)` when one item was assigned.\n///\n/// Mirrors glibc: the value is accumulated as a `long`, saturating at\n/// `LONG_MAX`/`LONG_MIN` on overflow, and then truncated to `int`.\npub fn sscanf_int(s: &[u8]) -> Option<i32> {\n    let s = up_to_nul(s);\n    let mut i = 0usize;\n\n    while i < s.len() && c_isspace(s[i]) {\n        i += 1;\n    }\n\n    let mut negative = false;\n    if i < s.len() && (s[i] == b'+' || s[i] == b'-') {\n        negative = s[i] == b'-';\n        i += 1;\n    }\n\n    let start = i;\n    let mut acc: i64 = 0;\n    let mut overflow = false;\n    while i < s.len() && c_isdigit(s[i]) {\n        let d = i64::from(s[i] - b'0');\n        match acc.checked_mul(10).and_then(|v| v.checked_add(d)) {\n            Some(v) => acc = v,\n            None => overflow = true,\n        }\n        i += 1;\n    }\n\n    if i == start {\n        // Matching failure (0) or input failure (EOF); neither assigns.\n        return None;\n    }\n\n    let value: i64 = if overflow {\n        if negative {\n            i64::MIN\n        } else {\n            i64::MAX\n        }\n    } else if negative {\n        -acc\n    } else {\n        acc\n    };\n\n    // Assignment to an `int` truncates the low 32 bits.\n    Some(value as i32)\n}\n\n// ---------------------------------------------------------------------------\n// stdout / stderr\n// ---------------------------------------------------------------------------\n\n/// Emulates a C `FILE *` for stdout: line buffered on a terminal, otherwise\n/// block buffered with a 4096-byte buffer (glibc's usual pipe/file block size).\npub struct Out {\n    buf: Vec<u8>,\n    cap: usize,\n    line_buffered: bool,\n}\n\nimpl Out {\n    pub fn new() -> Out {\n        let line_buffered = io::stdout().is_terminal();\n        Out {\n            buf: Vec::with_capacity(4096),\n            cap: 4096,\n            line_buffered,\n        }\n    }\n\n    fn emit(chunk: &[u8]) {\n        let stdout = io::stdout();\n        let mut lock = stdout.lock();\n        let _ = lock.write_all(chunk);\n        let _ = lock.flush();\n    }\n\n    pub fn put(&mut self, data: &[u8]) {\n        self.buf.extend_from_slice(data);\n        if self.line_buffered {\n            if let Some(pos) = self.buf.iter().rposition(|&b| b == b'\\n') {\n                let chunk: Vec<u8> = self.buf.drain(..=pos).collect();\n                Out::emit(&chunk);\n            }\n        } else {\n            while self.buf.len() >= self.cap {\n                let chunk: Vec<u8> = self.buf.drain(..self.cap).collect();\n                Out::emit(&chunk);\n            }\n        }\n    }\n\n    pub fn puts(&mut self, s: &str) {\n        self.put(s.as_bytes());\n    }\n\n    pub fn flush_all(&mut self) {\n        if !self.buf.is_empty() {\n            let chunk: Vec<u8> = self.buf.drain(..).collect();\n            Out::emit(&chunk);\n        }\n    }\n}\n\nimpl Write for Out {\n    fn write(&mut self, data: &[u8]) -> io::Result<usize> {\n        self.put(data);\n        Ok(data.len())\n    }\n\n    fn flush(&mut self) -> io::Result<()> {\n        self.flush_all();\n        Ok(())\n    }\n}\n\n/// `fprintf(stderr, ...)` -- stderr is unbuffered in C.\npub fn err(data: &[u8]) {\n    let stderr = io::stderr();\n    let mut lock = stderr.lock();\n    let _ = lock.write_all(data);\n    let _ = lock.flush();\n}\n\n// ---------------------------------------------------------------------------\n// stdin\n// ---------------------------------------------------------------------------\n\n/// Emulates `fgets` on stdin, including its buffer-size truncation behaviour.\npub struct In {\n    inner: io::Stdin,\n    buf: Vec<u8>,\n    pos: usize,\n    eof: bool,\n}\n\nimpl In {\n    pub fn new() -> In {\n        In {\n            inner: io::stdin(),\n            buf: Vec::new(),\n            pos: 0,\n            eof: false,\n        }\n    }\n\n    fn fill(&mut self) -> bool {\n        if self.pos < self.buf.len() {\n            return true;\n        }\n        if self.eof {\n            return false;\n        }\n        let mut chunk = [0u8; 4096];\n        loop {\n            match self.inner.read(&mut chunk) {\n                Ok(0) => {\n                    self.eof = true;\n                    return false;\n                }\n                Ok(n) => {\n                    self.buf.clear();\n                    self.buf.extend_from_slice(&chunk[..n]);\n                    self.pos = 0;\n                    return true;\n                }\n                Err(ref e) if e.kind() == io::ErrorKind::Interrupted => continue,\n                Err(_) => {\n                    self.eof = true;\n                    return false;\n                }\n            }\n        }\n    }\n\n    fn next_byte(&mut self) -> Option<u8> {\n        if !self.fill() {\n            return None;\n        }\n        let b = self.buf[self.pos];\n        self.pos += 1;\n        Some(b)\n    }\n\n    /// `fgets(buf, size, stdin)`: reads at most `size - 1` bytes, stopping\n    /// after a newline. Returns `None` on immediate EOF (C returns NULL).\n    /// The returned vector is the C string contents (no NUL terminator).\n    pub fn fgets(&mut self, size: usize) -> Option<Vec<u8>> {\n        if size <= 1 {\n            return None;\n        }\n        let mut out: Vec<u8> = Vec::new();\n        while out.len() < size - 1 {\n            match self.next_byte() {\n                Some(b) => {\n                    out.push(b);\n                    if b == b'\\n' {\n                        break;\n                    }\n                }\n                None => break,\n            }\n        }\n        if out.is_empty() {\n            None\n        } else {\n            Some(out)\n        }\n    }\n}\n","numLines":282,"startLine":1,"totalLines":282}}}
