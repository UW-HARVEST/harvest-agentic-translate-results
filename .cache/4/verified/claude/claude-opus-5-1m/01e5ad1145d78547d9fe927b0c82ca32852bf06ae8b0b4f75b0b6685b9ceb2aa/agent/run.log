n_lines(Some(b as usize)));\n        expected.extend_from_slice(b\"Finished bad()\\n\");\n        for lib in [c_lib(), rust_lib()] {\n            let out = capture_inproc(|| run_op(lib, &op));\n            assert_eq!(out, expected, \"{} lib driver({g},{b})\", lib.name);\n        }\n    }\n}\n\n/// ERRORS row 19 — only `bad`'s check rejects.\n#[test]\nfn err_19_driver_only_bad_rejects() {\n    for (g, b) in [(0i32, -1i32), (7, i32::MIN), (9, -12345)] {\n        let op = Op::Driver(g, b);\n        assert_same_forked(&op);\n        let mut expected = Vec::new();\n        expected.extend_from_slice(b\"Calling good()...\\n\");\n        expected.extend_from_slice(&ten_lines(Some(7)));\n        expected.extend_from_slice(&ten_lines(Some(g as usize)));\n        expected.extend_from_slice(b\"Finished good()\\n\");\n        expected.extend_from_slice(b\"Calling bad()...\\n\");\n        expected.extend_from_slice(ERR_NEGATIVE);\n        expected.extend_from_slice(b\"Finished bad()\\n\");\n        for lib in [c_lib(), rust_lib()] {\n            let out = capture_inproc(|| run_op(lib, &op));\n            assert_eq!(out, expected, \"{} lib driver({g},{b})\", lib.name);\n        }\n    }\n}\n\n/// ERRORS row 20 — extreme ints for both parameters across the FFI boundary.\n#[test]\nfn err_20_driver_int_min_both() {\n    for (g, b) in [\n        (i32::MIN, i32::MIN),\n        (i32::MIN + 1, i32::MIN + 1),\n        (i32::MAX, i32::MIN),\n    ] {\n        assert_same_forked(&Op::Driver(g, b));\n    }\n}\n\n/// ERRORS row 21 — non-NULL pointer to an immediate NUL: prints just \"\\n\".\n#[test]\nfn err_21_print_line_empty() {\n    assert_same_forked(&Op::PrintLine(vec![]));\n    for lib in [c_lib(), rust_lib()] {\n        let out = capture_inproc(|| run_op(lib, &Op::PrintLine(vec![])));\n        assert_eq!(out, b\"\\n\", \"{} lib\", lib.name);\n    }\n}\n\n/// ERRORS row 22 — interior pointer / embedded NUL truncation.\n#[test]\nfn err_22_print_line_embedded_nul() {\n    let buf = b\"abc