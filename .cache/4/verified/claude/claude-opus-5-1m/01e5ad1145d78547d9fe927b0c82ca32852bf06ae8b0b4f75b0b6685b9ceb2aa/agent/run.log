{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01QShbTWcxBpyyeY8wsdNWca","type":"tool_result","content":"File created successfully at: /local/home/scheschb/.harvest/work/harvest-work-Nxrkg1/translated_rust/tests/error_paths.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"0af81b2f-19bc-46ab-9c71-7e73412f8759","uuid":"47bccac5-adb6-4f10-840a-a70165904d2b","timestamp":"2026-08-18T00:25:27.355Z","tool_use_result":{"type":"create","filePath":"/local/home/scheschb/.harvest/work/harvest-work-Nxrkg1/translated_rust/tests/error_paths.rs","content":"//! Phase C — error-path differential tests.\n//!\n//! One test per row of `ERRORS.md`.  Every function in this C library is `void`\n//! and there is no `errno`/error-code/enum, so \"the same error/rejection\" means\n//! \"the same rejection message bytes on stdout and nothing else\", which is what\n//! each test asserts — against the C `.so`, against the Rust `.so`, and against\n//! the message text taken verbatim from `c_src/src/driver.c`.\n\nmod common;\nuse common::*;\n\n/// ERRORS row 1 — `printLine(NULL)`: `if(line != NULL)` fails ⇒ nothing at all.\n#[test]\nfn err_01_print_line_null() {\n    assert_same_forked(&Op::PrintLineNull);\n    for lib in [c_lib(), rust_lib()] {\n        let out = capture_inproc(|| run_op(lib, &Op::PrintLineNull));\n        assert!(\n            out.is_empty(),\n            \"{} lib printed {:?} for printLine(NULL)\",\n            lib.name,\n            String::from_utf8_lossy(&out)\n        );\n    }\n}\n\n/// ERRORS row 2 — `bad(-1)` ⇒ \"ERROR: Array index is negative.\".\n#[test]\nfn err_02_bad_negative_one() {\n    assert_same_forked(&Op::Bad(-1));\n    for lib in [c_lib(), rust_lib()] {\n        let out = capture_inproc(|| run_op(lib, &Op::Bad(-1)));\n        assert_eq!(out, ERR_NEGATIVE, \"{} lib\", lib.name);\n    }\n}\n\n/// ERRORS row 3 — `bad(INT_MIN)`.\n#[test]\nfn err_03_bad_int_min() {\n    assert_same_forked(&Op::Bad(i32::MIN));\n    for lib in [c_lib(), rust_lib()] {\n        let out = capture_inproc(|| run_op(lib, &Op::Bad(i32::MIN)));\n        assert_eq!(out, ERR_NEGATIVE, \"{} lib\", lib.name);\n    }\n}\n\n/// ERRORS row 4 — randomised negative `data`, 200 values.\n#[test]\nfn err_04_bad_negative_random() {\n    let mut rng = Rng::new(0xE770_0004);\n    let mut values = vec![-1, -2, -10, i32::MIN, i32::MIN + 1, -1000000];\n    for _ in 0..200 {\n        values.push(rng.range_i32(i32::MIN, -1));\n    }\n    for d in values {\n        assert_same(&Op::Bad(d));\n        let out = capture_inproc(|| run_op(rust_lib(), &Op::Bad(d)));\n        assert_eq!(out, ERR_NEGATIVE, \"bad({d})\");\n    }\n}\n\n/// ERRORS row 5 — `data >= 10` is *not* rejected (the injected flaw): the store\n/// is out of bounds, yet the ten in-bounds elements are still printed unchanged.\n#[test]\nfn err_05_bad_oob_not_rejected() {\n    for d in [10, 11, 13, 16, 20, 33, 64, 1000] {\n        let (c, r) = diff_forked(&Op::Bad(d));\n        assert_eq!(\n            c.stdout,\n            ten_lines(None),\n            \"C lib: bad({d}) should print ten zeros (OOB store misses the array)\"\n        );\n        assert_eq!(\n            r.stdout, c.stdout,\n            \"Rust lib diverged from C for bad({d})\"\n        );\n        assert!(\n            !c.stdout.starts_with(ERR_NEGATIVE),\n            \"C lib must NOT reject bad({d})\"\n        );\n    }\n}\n\n/// ERRORS row 6 — `bad(10)`, the very first out-of-range index.\n#[test]\nfn err_06_bad_oob_first() {\n    assert_same_stdout_forked(&Op::Bad(10));\n    let (c, _) = diff_forked(&Op::Bad(10));\n    assert_eq!(c.stdout, ten_lines(None));\n}\n\n/// ERRORS row 7 — `bad(INT_MAX)`: accepted by `data >= 0`, store far off-stack.\n#[test]\nfn err_07_bad_int_max() {\n    assert_same_stdout_forked(&Op::Bad(i32::MAX));\n    assert_same_stdout_forked(&Op::Bad(i32::MAX - 1));\n}\n\n/// ERRORS row 8 — `good(-1)` ⇒ goodG2B block + \"out-of-bounds\" message.\n#[test]\nfn err_08_good_negative() {\n    assert_same_forked(&Op::Good(-1));\n    let mut expected = ten_lines(Some(7));\n    expected.extend_from_slice(ERR_OOB);\n    for lib in [c_lib(), rust_lib()] {\n        let out = capture_inproc(|| run_op(lib, &Op::Good(-1)));\n        assert_eq!(out, expected, \"{} lib\", lib.name);\n    }\n}\n\n/// ERRORS row 9 — `good(INT_MIN)`.\n#[test]\nfn err_09_good_int_min() {\n    assert_same_forked(&Op::Good(i32::MIN));\n    let mut expected = ten_lines(Some(7));\n    expected.extend_from_slice(ERR_OOB);\n    for lib in [c_lib(), rust_lib()] {\n        let out = capture_inproc(|| run_op(lib, &Op::Good(i32::MIN)));\n        assert_eq!(out, expected, \"{} lib\", lib.name);\n    }\n}\n\n/// ERRORS row 10 — `good(10)`: first value failing `data < (10)`.\n#[test]\nfn err_10_good_ten() {\n    assert_same_forked(&Op::Good(10));\n    let mut expected = ten_lines(Some(7));\n    expected.extend_from_slice(ERR_OOB);\n    for lib in [c_lib(), rust_lib()] {\n        let out = capture_inproc(|| run_op(lib, &Op::Good(10)));\n        assert_eq!(out, expected, \"{} lib\", lib.name);\n    }\n    // one step inside the range is accepted, one step outside is rejected\n    for lib in [c_lib(), rust_lib()] {\n        let inside = capture_inproc(|| run_op(lib, &Op::Good(9)));\n        assert!(!inside.ends_with(ERR_OOB), \"{} lib rejected good(9)\", lib.name);\n    }\n}\n\n/// ERRORS row 11 — `good(INT_MAX)`.\n#[test]\nfn err_11_good_int_max() {\n    assert_same_forked(&Op::Good(i32::MAX));\n    let mut expected = ten_lines(Some(7));\n    expected.extend_from_slice(ERR_OOB);\n    for lib in [c_lib(), rust_lib()] {\n        let out = capture_inproc(|| run_op(lib, &Op::Good(i32::MAX)));\n        assert_eq!(out, expected, \"{} lib\", lib.name);\n    }\n}\n\n/// ERRORS row 12 — randomised out-of-range `data` for `goodB2G`, 200 values.\n#[test]\nfn err_12_good_out_of_range_random() {\n    let mut rng = Rng::new(0xE770_0012);\n    let mut expected