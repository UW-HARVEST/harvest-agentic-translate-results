mut values = vec![-1, 0, 7, 9, 10, i32::MIN, i32::MAX];\n    for _ in 0..100 {\n        values.push(rng.next_i32());\n    }\n    for d in values {\n        for lib in [c_lib(), rust_lib()] {\n            let out = capture_inproc(|| run_op(lib, &Op::Good(d)));\n            assert!(\n                !contains(&out, ERR_NEGATIVE),\n                \"{} lib printed the goodG2B 'negative' message for good({d})\",\n                lib.name\n            );\n            // the goodG2B block (index 7 set) always comes first\n            assert!(\n                out.starts_with(&ten_lines(Some(7))),\n                \"{} lib: good({d}) did not start with goodG2B's fixed block\",\n                lib.name\n            );\n        }\n        assert_same(&Op::Good(d));\n    }\n}\n\nfn contains(hay: &[u8], needle: &[u8]) -> bool {\n    hay.windows(needle.len()).any(|w| w == needle)\n}\n\n/// ERRORS row 17 — `driver` with both error branches taken at once.\n#[test]\nfn err_17_driver_both_error_branches() {\n    let op = Op::Driver(-5, -9);\n    assert_same_forked(&op);\n    let mut expected = Vec::new();\n    expected.extend_from_slice(b\"Calling good()...\\n\");\n    expected.extend_from_slice(&ten_lines(Some(7)));\n    expected.extend_from_slice(ERR_OOB);\n    expected.extend_from_slice(b\"Finished good()\\n\");\n    expected.extend_from_slice(b\"Calling bad()...\\n\");\n    expected.extend_from_slice(ERR_NEGATIVE);\n    expected.extend_from_slice(b\"Finished bad()\\n\");\n    for lib in [c_lib(), rust_lib()] {\n        let out = capture_inproc(|| run_op(lib, &op));\n        assert_eq!(out, expected, \"{} lib\", lib.name);\n    }\n}\n\n/// ERRORS row 18 — only `good`'s check rejects.\n#[test]\nfn err_18_driver_only_good_rejects() {\n    for (g, b) in [(10i32, 4i32), (-3, 0), (i32::MAX, 9), (i32::MIN, 5)] {\n        let op = Op::Driver(g, b);\n        assert_same_forked(&op);\n        let mut expected = Vec::new();\n        expected.extend_from_slice(b\"Calling good()...\\n\");\