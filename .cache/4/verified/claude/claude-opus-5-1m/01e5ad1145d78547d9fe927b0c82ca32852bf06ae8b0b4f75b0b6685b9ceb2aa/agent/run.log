::fs::read(&path).expect(\"read temp file\");","-    let _ = std::fs::remove_file(&path);","+    drop(out_file);","+    drop(off_file);","+    let full = std::fs::read(&out_path).expect(\"read output temp file\");","+    let offs_raw = std::fs::read(&off_path).expect(\"read offsets temp file\");","+    let _ = std::fs::remove_file(&out_path);","+    let _ = std::fs::remove_file(&off_path);","+","+    let mut outputs = Vec::new();","+    let mut prev = 0usize;","+    for chunk in offs_raw.chunks_exact(8) {","+        let end = i64::from_le_bytes(chunk.try_into().unwrap()).max(0) as usize;","+        let end = end.min(full.len());","+        outputs.push(full[prev.min(end)..end].to_vec());","+        prev = end;","+    }","+    let partial = full[prev.min(full.len())..].to_vec();","     let exit = if status & 0x7f == 0 {","         Exit::Code((status >> 8) & 0xff)","     } else {","         Exit::Signal(status & 0x7f)","     };","-    ForkResult {","-        stdout: stdout_bytes,","+    BatchResult {","+        outputs,","+        partial,","+        full,","         exit,","     }"," }"," ","+/// Per-call outputs of one library, requiring a clean run (used for the","+/// model-based cross-checks).  Panics if the child did not finish every call.","+pub fn outputs(d: &Driver, ops: &[Op]) -> Vec<Vec<u8>> {","+    let r = run_batch(d, ops, Buffering::Block);","+    assert_eq!(","+        r.exit,","+        Exit::Code(0),","+        \"{} lib terminated abnormally ({:?}) while running {:?}\",","+        d.name,","+        r.exit,","+        ops.iter().map(Op::describe).collect::<Vec<_>>()","+    );","+    assert_eq!(","+        r.completed(),","+        ops.len(),","+        \"{} lib only completed {}/{} calls\",","+        d.name,","+        r.completed(),","+        ops.len()","+    );","+    r.outputs","+}","+","+/// Output of a single call against one library (clean run required).","+pub fn output(d: &Driver, op: &Op) -> Vec<u8> {","+    outputs(d, std::slice::from_ref(op)).pop().unwrap()","+}","+"," // ---------------------------------------------------------------------------"," // Differential assertions"," // ---------------------------------------------------------------------------"," ","-/// Run `op` against both libraries in-process and assert byte-identical stdout.","-pub fn assert_same(op: &Op) {","-    let c = capture_inproc(|| run_op(c_lib(), op));","-    let r = capture_inproc(|| run_op(rust_lib(), op));","-    assert_eq!(","-        c,","-        r,","-        \"output mismatch for {}\\n  C   : {:?}\\n  Rust: {:?}\",","-        op.describe(),","-        String::from_utf8_lossy(&c),","-        String::from_utf8_lossy(&r)","-    );","+fn show(b: &[u8]) -> String {","+    String::from_utf8_lossy(b).escape_debug().to_string()"," }"," ","-/// Run `op` against both libraries, each in its own process, and assert","-/// identical stdout *and* identical termination status.","-pub fn assert_same_forked(op: &Op) {","-    let (c, r) = diff_forked(op);","+/// Run `ops` against both libraries (one child each) and assert that every call","+/// produced byte-identical output and that both children terminated identically.","+///","+/// `ops` must not contain UB calls (see [`Op::is_ub`]); those go through","+/// [`assert_same_stdout_ub`].","+pub fn assert_same_batch(ops: &[Op]) {","+    assert_same_batch_buffered(ops, Buffering::Block);","+}","+","+pub fn assert_same_batch_buffered(ops: &[Op], buffering: Buffering) {","+    for op in ops {","+        assert!(","+            !op.is_ub(),","+            \"{} is an undefined-behaviour call; use assert_same_stdout_ub\",","+            op.describe()","+        );","+    }","+    let c = run_batch(c_lib(), ops, buffering);","+    let r = run_batch(rust_lib(), ops, buffering);","+    let n = c.outputs.len().min(r.outputs.len());","+    for i in 0..n {","+        assert_eq!(","+            c.outputs[i],","+            r.outputs[i],","+            \"output mismatch for {}\\n  C   : \\\"{}\\\"\\n  Rust: \\\"{}\\\"\",","+            ops[i].describe(),","+            show(&c.outputs[i]),","+            show(&r.outputs[i])","+        );","+    }","     assert_eq!(","-        c.stdout,","-        r.stdout,","-        \"output mismatch for {}\\n  C   : {:?}\\n  Rust: {:?}\",","-        op.describe(),","-        String::from_utf8_lossy(&c.stdout),","-        String::from_utf8_lossy(&r.stdout)","+        c.exit,","+        Exit::Code(0),","+        \"C lib terminated abnormally after {} of {} calls (last: {})\",","+        c.completed(),","+        ops.len(),","+        ops.get(c.completed()).map(Op::describe).unwrap_or_default()","     );","     assert_eq!(","-        c.exit,","         r.exit,","-        \"termination mismatch for {}: C {:?} vs Rust {:?}\",","-        op.describe(),","-        c.exit,","-        r.exit","+        Exit::Code(0),","+        \"Rust lib terminated abnormally after {} of {} calls (last: {})\",","+        r.completed(),","+        ops.len(),","+        ops.get(r.completed()).map(Op::describe).unwrap_or_default()","     );","+    assert_eq!(c.completed(), ops.len(), \"C lib did not run every call\");","+    assert_eq!(r.completed(), ops.len(), \"Rust lib did not run every call\");","+    assert_eq!(","+        c.full,","+        r.full,","+        \"whole-transcript mismatch\\n  C   : \\\"{}\\\"\\n  Rust: \\\"{}\\\"\",","+        show(&c.full),","+        show(&r.full)","+    );"," }"," ","-/// Run `op` against both libraries in separate processes and assert identical","-/// stdout, *without* requiring identical termination status.","-///","-/// Used only for the rows of `ERRORS.md` / `CONFIGS.md` that trip the C code's","-/// deliberate out-of-bounds stack store (`bad(data)` with `data >= 10`).  The","-/// bytes written to stdout are fully determined by the C source (the ten","-/// in-bounds elements are never modified by the OOB store), but *whether* the","-/// smashed frame kills the process depends on the compiler's stack layout, so","-/// that part cannot be required to match.","-pub fn assert_same_stdout_forked(op: &Op) {","-    let (c, r) = diff_forked(op);","+/// Single non-UB call.","+pub fn assert_same(op: &Op) {","+    assert_same_batch(std::slice::from_ref(op));","+}","+","+/// Compare one UB call (`bad(data)` with `data >= 10`, directly or through","+/// `driver`).  stdout is fully determined by the C source and is compared","+/// byte-for-byte; process *termination* depends on the compiler's stack layout","+/// once the frame has been smashed, so it is only reported.","+pub fn assert_same_stdout_ub(op: &Op) {","+    let ops = std::slice::from_ref(op);","+    let c = run_batch(c_lib(), ops, Buffering::Unbuffered);","+    let r = run_batch(rust_lib(), ops, Buffering::Unbuffered);","     assert_eq!(","-        c.stdout,","-        r.stdout,","-        \"output mismatch for {} (UB row)\\n  C   : {:?}\\n  Rust: {:?}\",","+        c.full,","+        r.full,","+        \"output mismatch for {} (UB row)\\n  C   : \\\"{}\\\"\\n  Rust: \\\"{}\\\"\",","         op.describe(),","-        String::from_utf8_lossy(&c.stdout),","-        String::from_utf8_lossy(&r.stdout)","+        show(&c.full),","+        show(&r.full)","     );","     if c.exit != r.exit {","         println!("]},{"oldStart":368,"oldLines":80,"newStart":475,"newLines":17,"lines":["     }"," }"," ","-/// Run a whole sequence of calls inside a single capture (one stdout stream) and","-/// compare the two libraries' complete transcripts.","-pub fn assert_same_seq(ops: &[Op]) {","-    let c = capture_inproc(|| {","-        let l = c_lib();","-        for op in ops {","-            run_op(l, op);","-        }","-    });","-    let r = capture_inproc(|| {","-        let l = rust_lib();","-        for op in ops {","-            run_op(l, op);","-        }","-    });","-    assert_eq!(","-        c,","-        r,","-        \"transcript mismatch for sequence {:?}\\n  C   : {:?}\\n  Rust: {:?}\",","-        ops.iter().map(Op::describe).collect::<Vec<_>>(),","-        String::from_utf8_lossy(&c),","-        String::from_utf8_lossy(&r)","-    );","+/// Whole stdout stream of one UB call against one library.","+pub fn ub_stream(d: &Driver, op: &Op) -> Vec<u8> {","+    run_batch(d, std::slice::from_ref(op), Buffering::Unbuffered).full"," }"," ","-/// As [`assert_same_seq`] but each library runs in its own forked child with","-/// stdout unbuffered, and the termination status is compared too.","-pub fn assert_same_seq_forked(ops: &[Op]) {","-    let (cl, rl) = (c_lib(), rust_lib());","-    let c = capture_forked(|| {","-        for op in ops {","-            run_op(cl, op);","-        }","-    });","-    let r = capture_forked(|| {","-        for op in ops {","-            run_op(rl, op);","-        }","-    });","-    assert_eq!(","-        c.stdout,","-        r.stdout,","-        \"transcript mismatch (unbuffered) for {:?}\\n  C   : {:?}\\n  Rust: {:?}\",","-        ops.iter().map(Op::describe).collect::<Vec<_>>(),","-        String::from_utf8_lossy(&c.stdout),","-        String::from_utf8_lossy(&r.stdout)","-    );","-    assert_eq!(c.exit, r.exit, \"termination mismatch for {ops:?}\");","-}","-","-/// Capture one library's transcript for a sequence of calls.","-pub fn transcript(d: &Driver, ops: &[Op]) -> Vec<u8> {","-    capture_inproc(|| {","-        for op in ops {","-            run_op(d, op);","-        }","-    })","-}","-","-/// Run `op` against both libraries, each in its own forked process.","-pub fn diff_forked(op: &Op) -> (ForkResult, ForkResult) {","-    // Make sure both libraries are already mapped in the parent so the two","-    // children do identical amounts of work.","-    let (cl, rl) = (c_lib(), rust_lib());","-    let c = capture_forked(|| run_op(cl, op));","-    let r = capture_forked(|| run_op(rl, op));","-    (c, r)","-}","-"," // ---------------------------------------------------------------------------","-// Expected-output model of the C source (used as a third opinion)","+// Expected-output model taken from the C source"," // ---------------------------------------------------------------------------"," ","-/// The ten `printIntLine` lines a `buffer[10]` with `buffer[idx] = 1` prints.","+/// The ten `printIntLine` lines printed for a `buffer[10]` in which","+/// `buffer[idx] = 1` (or nothing, when `idx` is out of bounds ⇒ `None`)."," pub fn ten_lines(idx: Option<usize>) -> Vec<u8> {","     let mut s = Vec::new();","     for i in 0..10usize {"]},{"oldStart":453,"oldLines":20,"newStart":497,"newLines":18,"lines":[" pub const ERR_NEGATIVE: &[u8] = b\"ERROR: Array index is negative.\\n\";"," pub const ERR_OOB: &[u8] = b\"ERROR: Array index is out-of-bounds\\n\";"," ","-/// Deterministic 64-bit LCG/xorshift PRNG so every randomised test is","-/// reproducible from a fixed seed.","+/// Deterministic PRNG (splitmix64) so every randomised test is reproducible."," pub struct Rng(u64);"," "," impl Rng {","     pub fn new(seed: u64) -> Rng {","-        Rng(seed ^ 0x9E3779B97F4A7C15)","+        Rng(seed ^ 0x9E37_79B9_7F4A_7C15)","     }","     pub fn next_u64(&mut self) -> u64 {","-        // splitmix64","-        self.0 = self.0.wrapping_add(0x9E3779B97F4A7C15);","+        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);","         let mut z = self.0;","-        z = (z ^ (z >> 30)).wrapping_mul(0xBF58476D1CE4E5B9);","-        z = (z ^ (z >> 27)).wrapping_mul(0x94D049BB133111EB);","+        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);","+        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);","         z ^ (z >> 31)","     }","     pub fn next_u32(&mut self) -> u32 {"]}],"originalFile":"//! Shared differential-testing harness.\n//!\n//! Both the C shared object (`c_src/build/libdriver.so`) and the Rust shared\n//! object (`target/<profile>/libdriver.so`) are loaded with `libloading` and\n//! driven exclusively through their exported C symbols, so the `#[no_mangle]`\n//! wrappers are part of what is under test.\n//!\n//! The library under test writes to `stdout` through the C runtime's `printf`,\n//! so \"output\" is captured at the *file-descriptor* level (fd 1), not through\n//! Rust's `std::io`.  Two capture strategies are provided:\n//!\n//! * [`capture_inproc`] – redirect fd 1 to a temp file, run, restore.  Fast,\n//!   used for every input in the well-defined domain.\n//! * [`capture_forked`] – same, but inside a `fork()`ed child, so an input that\n//!   makes the library crash (the C code under test contains a deliberate\n//!   out-of-bounds stack write) cannot take the test process down.  The child\n//!   also switches `stdout` to unbuffered so that output produced *before* a\n//!   crash is not lost in libc's buffer.\n//!\n//! All captures are serialised through a global mutex because the fd-1\n//! redirection is process-wide.\n\n#![allow(dead_code)]\n\nuse libloading::os::unix::{Library, Symbol};\nuse std::ffi::{c_char, c_int, c_void};\nuse std::os::fd::AsRawFd;\nuse std::path::{Path, PathBuf};\nuse std::sync::{Mutex, OnceLock};\n\n// ---------------------------------------------------------------------------\n// libc bits we need (declared directly to avoid an extra dependency)\n// ---------------------------------------------------------------------------\n\nunsafe extern \"C\" {\n    fn fflush(stream: *mut c_void) -> c_int;\n    fn dup(fd: c_int) -> c_int;\n    fn dup2(oldfd: c_int, newfd: c_int) -> c_int;\n    fn close(fd: c_int) -> c_int;\n    fn fork() -> c_int;\n    fn waitpid(pid: c_int, status: *mut c_int, options: c_int) -> c_int;\n    fn _exit(status: c_int) -> !;\n    fn setvbuf(stream: *mut c_void, buf: *mut c_char, mode: c_int, size: usize) -> c_int;\n    static stdout: *mut c_void;\n}\n\nconst IONBF: c_int = 2; // _IONBF\n\n// RTLD flags: resolve now, keep the symbols out of the global namespace so the\n// two libraries can never satisfy each other's `printLine`/`printIntLine`\n// relocations.\nconst RTLD_NOW: c_int = 0x2;\nconst RTLD_LOCAL: c_int = 0;\n\n// ---------------------------------------------------------------------------\n// Library handles\n// ---------------------------------------------------------------------------\n\n/// One loaded `libdriver.so` (either the C or the Rust one) with every exported\n/// symbol resolved through `dlsym`.\npub struct Driver {\n    pub name: &'static str,\n    pub path: PathBuf,\n    pub print_line: Symbol<unsafe extern \"C\" fn(*const c_char)>,\n    pub print_int_line: Symbol<unsafe extern \"C\" fn(c_int)>,\n    pub bad: Symbol<unsafe extern \"C\" fn(c_int)>,\n    pub good: Symbol<unsafe extern \"C\" fn(c_int)>,\n    pub driver: Symbol<unsafe extern \"C\" fn(c_int, c_int)>,\n    _lib: Library,\n}\n\nimpl Driver {\n    fn load(name: &'static str, path: PathBuf) -> Driver {\n        assert!(\n            path.exists(),\n            \"shared object {} does not exist (build it first)\",\n            path.display()\n        );\n        let lib = unsafe { Library::open(Some(&path), RTLD_NOW | RTLD_LOCAL) }\n            .unwrap_or_else(|e| panic!(\"dlopen({}) failed: {e}\", path.display()));\n        macro_rules! sym {\n            ($n:literal) => {\n                unsafe { lib.get($n) }.unwrap_or_else(|e| {\n                    panic!(\n                        \"dlsym({}, {}) failed: {e}\",\n                        path.display(),\n                        std::str::from_utf8($n).unwrap()\n                    )\n                })\n            };\n        }\n        Driver {\n            name,\n            print_line: sym!(b\"printLine\\0\"),\n            print_int_line: sym!(b\"printIntLine\\0\"),\n            bad: sym!(b\"bad\\0\"),\n            good: sym!(b\"good\\0\"),\n            driver: sym!(b\"driver\\0\"),\n            path,\n            _lib: lib,\n        }\n    }\n}\n\npub fn manifest_dir() -> PathBuf {\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n}\n\n/// `c_src/build/libdriver.so`, built on demand with cmake if absent.\npub fn c_so_path() -> PathBuf {\n    let build = manifest_dir().join(\"c_src/build\");\n    let so = build.join(\"libdriver.so\");\n    if !so.exists() {\n        std::fs::create_dir_all(&build).expect(\"mkdir c_src/build\");\n        let cfg = std::process::Command::new(\"cmake\")\n            .current_dir(&build)\n            .args([\"..\", \"-DCMAKE_POSITION_INDEPENDENT_CODE=ON\"])\n            .output()\n            .expect(\"run cmake\");\n        assert!(cfg.status.success(), \"cmake configure failed: {cfg:?}\");\n        let bld = std::process::Command::new(\"cmake\")\n            .current_dir(&build)\n            .args([\"--build\", \".\"])\n            .output()\n            .expect(\"run cmake --build\");\n        assert!(bld.status.success(), \"cmake build failed: {bld:?}\");\n    }\n    so\n}\n\n/// `target/<profile>/libdriver.so`, derived from the test binary's own location\n/// (`target/<profile>/deps/<test>-<hash>`).\npub fn rust_so_path() -> PathBuf {\n    let exe = std::env::current_exe().expect(\"current_exe\");\n    let profile_dir: &Path = exe\n        .parent()\n        .and_then(|deps| deps.parent())\n        .expect(\"target/<profile>\");\n    profile_dir.join(\"libdriver.so\")\n}\n\nstatic C_LIB: OnceLock<Driver> = OnceLock::new();\nstatic RUST_LIB: OnceLock<Driver> = OnceLock::new();\n\npub fn c_lib() -> &'static Driver {\n    C_LIB.get_or_init(|| Driver::load(\"C\", c_so_path()))\n}\n\npub fn rust_lib() -> &'static Driver {\n    RUST_LIB.get_or_init(|| Driver::load(\"Rust\", rust_so_path()))\n}\n\n// ---------------------------------------------------------------------------\n// Operations (the public API surface)\n// ---------------------------------------------------------------------------\n\n/// One call into the library's public API.\n#[derive(Clone, Debug, PartialEq, Eq)]\npub enum Op {\n    /// `printLine(NULL)`\n    PrintLineNull,\n    /// `printLine(<bytes>)` – bytes are NUL terminated by the harness.\n    PrintLine(Vec<u8>),\n    /// `printLine(p)` where `p` points at the interior of a larger buffer.\n    PrintLineRaw(Vec<u8>, usize),\n    /// `printIntLine(n)`\n    PrintIntLine(c_int),\n    /// `bad(data)`\n    Bad(c_int),\n    /// `good(data)`\n    Good(c_int),\n    /// `driver(goodData, badData)`\n    Driver(c_int, c_int),\n}\n\nimpl Op {\n    pub fn describe(&self) -> String {\n        match self {\n            Op::PrintLineNull => \"printLine(NULL)\".to_string(),\n            Op::PrintLine(b) => format!(\"printLine({:?})\", String::from_utf8_lossy(b)),\n            Op::PrintLineRaw(b, off) => {\n                format!(\"printLine(buf+{off}) buf={:?}\", String::from_utf8_lossy(b))\n            }\n            Op::PrintIntLine(n) => format!(\"printIntLine({n})\"),\n            Op::Bad(d) => format!(\"bad({d})\"),\n            Op::Good(d) => format!(\"good({d})\"),\n            Op::Driver(g, b) => format!(\"driver({g}, {b})\"),\n        }\n    }\n}\n\n/// Perform `op` against `d`.  Output goes to fd 1 (redirect it first).\npub fn run_op(d: &Driver, op: &Op) {\n    unsafe {\n        match op {\n            Op::PrintLineNull => (d.print_line)(std::ptr::null()),\n            Op::PrintLine(bytes) => {\n                let mut z = bytes.clone();\n                z.push(0);\n                (d.print_line)(z.as_ptr() as *const c_char);\n            }\n            Op::PrintLineRaw(bytes, off) => {\n                (d.print_line)(bytes.as_ptr().add(*off) as *const c_char);\n            }\n            Op::PrintIntLine(n) => (d.print_int_line)(*n),\n            Op::Bad(v) => (d.bad)(*v),\n            Op::Good(v) => (d.good)(*v),\n            Op::Driver(g, b) => (d.driver)(*g, *b),\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// stdout capture\n// ---------------------------------------------------------------------------\n\nstatic CAPTURE_LOCK: Mutex<()> = Mutex::new(());\nstatic COUNTER: Mutex<u64> = Mutex::new(0);\n\nfn temp_path(tag: &str) -> PathBuf {\n    let mut c = COUNTER.lock().unwrap();\n    *c += 1;\n    let dir = std::env::var_os(\"TMPDIR\")\n        .map(PathBuf::from)\n        .unwrap_or_else(std::env::temp_dir);\n    dir.join(format!(\"driver_diff_{}_{}_{}.out\", std::process::id(), tag, *c))\n}\n\n/// Run `f` with fd 1 redirected to a temp file; return everything written.\npub fn capture_inproc<F: FnOnce()>(f: F) -> Vec<u8> {\n    let _g = CAPTURE_LOCK.lock().unwrap();\n    let path = temp_path(\"ip\");\n    let out = std::fs::File::create(&path).expect(\"create temp file\");\n    let bytes = unsafe {\n        fflush(std::ptr::null_mut());\n        let saved = dup(1);\n        assert!(saved >= 0, \"dup(1) failed\");\n        assert!(dup2(out.as_raw_fd(), 1) >= 0, \"dup2 failed\");\n        f();\n        fflush(std::ptr::null_mut());\n        assert!(dup2(saved, 1) >= 0, \"restore dup2 failed\");\n        close(saved);\n        drop(out);\n        std::fs::read(&path).expect(\"read temp file\")\n    };\n    let _ = std::fs::remove_file(&path);\n    bytes\n}\n\n/// How a forked child terminated.\n#[derive(Clone, Debug, PartialEq, Eq)]\npub enum Exit {\n    Code(i32),\n    Signal(i32),\n}\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct ForkResult {\n    pub stdout: Vec<u8>,\n    pub exit: Exit,\n}\n\n/// Run `f` in a forked child with fd 1 redirected to a temp file and libc\n/// `stdout` unbuffered, so a crash cannot lose already-produced output nor kill\n/// the test process.\npub fn capture_forked<F: FnOnce()>(f: F) -> ForkResult {\n    let _g = CAPTURE_LOCK.lock().unwrap();\n    let path = temp_path(\"fk\");\n    let out = std::fs::File::create(&path).expect(\"create temp file\");\n    let fd = out.as_raw_fd();\n    unsafe { fflush(std::ptr::null_mut()) };\n    let pid = unsafe { fork() };\n    assert!(pid >= 0, \"fork() failed\");\n    if pid == 0 {\n        // ---- child ----\n        unsafe {\n            dup2(fd, 1);\n            setvbuf(stdout, std::ptr::null_mut(), IONBF, 0);\n            f();\n            fflush(std::ptr::null_mut());\n            _exit(0);\n        }\n    }\n    let mut status: c_int = 0;\n    let r = unsafe { waitpid(pid, &mut status, 0) };\n    assert_eq!(r, pid, \"waitpid failed\");\n    drop(out);\n    let stdout_bytes = std::fs::read(&path).expect(\"read temp file\");\n    let _ = std::fs::remove_file(&path);\n    let exit = if status & 0x7f == 0 {\n        Exit::Code((status >> 8) & 0xff)\n    } else {\n        Exit::Signal(status & 0x7f)\n    };\n    ForkResult {\n        stdout: stdout_bytes,\n        exit,\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Differential assertions\n// ---------------------------------------------------------------------------\n\n/// Run `op` against both libraries in-process and assert byte-identical stdout.\npub fn assert_same(op: &Op) {\n    let c = capture_inproc(|| run_op(c_lib(), op));\n    let r = capture_inproc(|| run_op(rust_lib(), op));\n    assert_eq!(\n        c,\n        r,\n        \"output mismatch for {}\\n  C   : {:?}\\n  Rust: {:?}\",\n        op.describe(),\n        String::from_utf8_lossy(&c),\n        String::from_utf8_lossy(&r)\n    );\n}\n\n/// Run `op` against both libraries, each in its own process, and assert\n/// identical stdout *and* identical termination status.\npub fn assert_same_forked(op: &Op) {\n    let (c, r) = diff_forked(op);\n    assert_eq!(\n        c.stdout,\n        r.stdout,\n        \"output mismatch for {}\\n  C   : {:?}\\n  Rust: {:?}\",\n        op.describe(),\n        String::from_utf8_lossy(&c.stdout),\n        String::from_utf8_lossy(&r.stdout)\n    );\n    assert_eq!(\n        c.exit,\n        r.exit,\n        \"termination mismatch for {}: C {:?} vs Rust {:?}\",\n        op.describe(),\n        c.exit,\n        r.exit\n    );\n}\n\n/// Run `op` against both libraries in separate processes and assert identical\n/// stdout, *without* requiring identical termination status.\n///\n/// Used only for the rows of `ERRORS.md` / `CONFIGS.md` that trip the C code's\n/// deliberate out-of-bounds stack store (`bad(data)` with `data >= 10`).  The\n/// bytes written to stdout are fully determined by the C source (the ten\n/// in-bounds elements are never modified by the OOB store), but *whether* the\n/// smashed frame kills the process depends on the compiler's stack layout, so\n/// that part cannot be required to match.\npub fn assert_same_stdout_forked(op: &Op) {\n    let (c, r) = diff_forked(op);\n    assert_eq!(\n        c.stdout,\n        r.stdout,\n        \"output mismatch for {} (UB row)\\n  C   : {:?}\\n  Rust: {:?}\",\n        op.describe(),\n        String::from_utf8_lossy(&c.stdout),\n        String::from_utf8_lossy(&r.stdout)\n    );\n    if c.exit != r.exit {\n        println!(\n            \"note: {} — stdout identical; termination differs (C {:?} vs Rust {:?}) \\\n             because the C store is out of bounds (UB, stack-layout dependent)\",\n            op.describe(),\n            c.exit,\n            r.exit\n        );\n    }\n}\n\n/// Run a whole sequence of calls inside a single capture (one stdout stream) and\n/// compare the two libraries' complete transcripts.\npub fn assert_same_seq(ops: &[Op]) {\n    let c = capture_inproc(|| {\n        let l = c_lib();\n        for op in ops {\n            run_op(l, op);\n        }\n    });\n    let r = capture_inproc(|| {\n        let l = rust_lib();\n        for op in ops {\n            run_op(l, op);\n        }\n    });\n    assert_eq!(\n        c,\n        r,\n        \"transcript mismatch for sequence {:?}\\n  C   : {:?}\\n  Rust: {:?}\",\n        ops.iter().map(Op::describe).collect::<Vec<_>>(),\n        String::from_utf8_lossy(&c),\n        String::from_utf8_lossy(&r)\n    );\n}\n\n/// As [`assert_same_seq`] but each library runs in its own forked child with\n/// stdout unbuffered, and the termination status is compared too.\npub fn assert_same_seq_forked(ops: &[Op]) {\n    let (cl, rl) = (c_lib(), rust_lib());\n    let c = capture_forked(|| {\n        for op in ops {\n            run_op(cl, op);\n        }\n    });\n    let r = capture_forked(|| {\n        for op in ops {\n            run_op(rl, op);\n        }\n    });\n    assert_eq!(\n        c.stdout,\n        r.stdout,\n        \"transcript mismatch (unbuffered) for {:?}\\n  C   : {:?}\\n  Rust: {:?}\",\n        ops.iter().map(Op::describe).collect::<Vec<_>>(),\n        String::from_utf8_lossy(&c.stdout),\n        String::from_utf8_lossy(&r.stdout)\n    );\n    assert_eq!(c.exit, r.exit, \"termination mismatch for {ops:?}\");\n}\n\n/// Capture one library's transcript for a sequence of calls.\npub fn transcript(d: &Driver, ops: &[Op]) -> Vec<u8> {\n    capture_inproc(|| {\n        for op in ops {\n            run_op(d, op);\n        }\n    })\n}\n\n/// Run `op` against both libraries, each in its own forked process.\npub fn diff_forked(op: &Op) -> (ForkResult, ForkResult) {\n    // Make sure both libraries are already mapped in the parent so the two\n    // children do identical amounts of work.\n    let (cl, rl) = (c_lib(), rust_lib());\n    let c = capture_forked(|| run_op(cl, op));\n    let r = capture_forked(|| run_op(rl, op));\n    (c, r)\n}\n\n// ---------------------------------------------------------------------------\n// Expected-output model of the C source (used as a third opinion)\n// ---------------------------------------------------------------------------\n\n/// The ten `printIntLine` lines a `buffer[10]` with `buffer[idx] = 1` prints.\npub fn ten_lines(idx: Option<usize>) -> Vec<u8> {\n    let mut s = Vec::new();\n    for i in 0..10usize {\n        s.extend_from_slice(if Some(i) == idx { b\"1\\n\" } else { b\"0\\n\" });\n    }\n    s\n}\n\npub const ERR_NEGATIVE: &[u8] = b\"ERROR: Array index is negative.\\n\";\npub const ERR_OOB: &[u8] = b\"ERROR: Array index is out-of-bounds\\n\";\n\n/// Deterministic 64-bit LCG/xorshift PRNG so every randomised test is\n/// reproducible from a fixed seed.\npub struct Rng(u64);\n\nimpl Rng {\n    pub fn new(seed: u64) -> Rng {\n        Rng(seed ^ 0x9E3779B97F4A7C15)\n    }\n    pub fn next_u64(&mut self) -> u64 {\n        // splitmix64\n        self.0 = self.0.wrapping_add(0x9E3779B97F4A7C15);\n        let mut z = self.0;\n        z = (z ^ (z >> 30)).wrapping_mul(0xBF58476D1CE4E5B9);\n        z = (z ^ (z >> 27)).wrapping_mul(0x94D049BB133111EB);\n        z ^ (z >> 31)\n    }\n    pub fn next_u32(&mut self) -> u32 {\n        (self.next_u64() >> 32) as u32\n    }\n    pub fn next_i32(&mut self) -> i32 {\n        self.next_u32() as i32\n    }\n    /// Uniform in `[lo, hi]` inclusive.\n    pub fn range_i32(&mut self, lo: i32, hi: i32) -> i32 {\n        let span = (hi as i64 - lo as i64 + 1) as u64;\n        (lo as i64 + (self.next_u64() % span) as i64) as i32\n    }\n    pub fn next_byte(&mut self) -> u8 {\n        (self.next_u64() >> 24) as u8\n    }\n}\n","userModified":false}}
{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_ojscfglu3dcmtnuedfg4zs76p2juodfwdmh4gwssnrq2m746uama","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11455,"cache_read_input_tokens":85015,"cache_creation":{"ephemeral_5m_input_tokens":11455,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"0af81b2f-19bc-46ab-9c71-7e73412f8759","uuid":"eb8e7d5a-a2e0-47b9-b52e-54db2db26fac","timestamp":"2026-08-18T00:28:08.434Z"}
{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_ojscfglu3dcmtnuedfg4zs76p2juodfwdmh4gwssnrq2m746uama","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_017rEPdiutZNAhbd2iqSDLgY","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-Nxrkg1/translated_rust/tests/valid_paths.rs","content":"//! Phase B — valid-path differential tests.\n//!\n//! One test per row of `CONFIGS.md`.  Every test loads BOTH shared objects with\n//! `libloading` and calls them only through their exported C symbols, then\n//! compares the stdout bytes produced by each individual call.\n//!\n//! Order follows the call hierarchy: the lowest-level entry points first\n//! (`printLine`, `printIntLine`), then `bad` / `good` (the latter drives the two\n//! `static` helpers), then the composed `driver` pipeline, then sequencing,\n//! statelessness, composition and randomised mixed-call programs.\n\nmod common;\nuse common::*;\n\n// ---------------------------------------------------------------------------\n// Rows 1–8: printLine (lowest level)\n// ---------------------------------------------------------------------------\n\n/// CONFIGS row 1 — empty string.\n#[test]\nfn cfg_01_print_line_empty() {\n    assert_same(&Op::PrintLine(vec![]));\n}\n\n/// CONFIGS row 2 — every single non-NUL byte value.\n#[test]\nfn cfg_02_print_line_single_byte_all_values() {\n    let ops: Vec<Op> = (1u8..=255).map(|b| Op::PrintLine(vec![b])).collect();\n    assert_same_batch(&ops);\n}\n\n/// CONFIGS row 3 — randomised printable ASCII, length 1..=64.\n#[test]\nfn cfg_03_print_line_random_ascii() {\n    let mut rng = Rng::new(0x5EED_0003);\n    let ops: Vec<Op> = (0..400)\n        .map(|_| {\n            let len = 1 + (rng.next_u32() % 64) as usize;\n            Op::PrintLine((0..len).map(|_| 0x20 + rng.next_byte() % 0x5f).collect())\n        })\n        .collect();\n    assert_same_batch(&ops);\n}\n\n/// CONFIGS row 4 — randomised arbitrary non-NUL bytes (invalid UTF-8 included).\n#[test]\nfn cfg_04_print_line_random_bytes() {\n    let mut rng = Rng::new(0x5EED_0004);\n    let ops: Vec<Op> = (0..400)\n        .map(|_| {\n            let len = 1 + (rng.next_u32() % 256) as usize;\n            Op::PrintLine(\n                (0..len)\n                    .map(|_| {\n                        let b = rng.next_byte();\n                        if b == 0 { 1 } else { b }\n                    })\n                    .collect(),\n            )\n        })\n        .collect();\n    assert_same_batch(&ops);\n}\n\n/// CONFIGS row 5 — the payload looks like a printf format string.\n#[test]\nfn cfg_05_print_line_format_specifiers() {\n    let ops: Vec<Op> = [\n        &b\"%s\"[..],\n        b\"%d\",\n        b\"%n\",\n        b\"%%\",\n        b\"%s%s%s%s%s%s%s%s\",\n        b\"%n%n%n%n\",\n        b\"100%% done: %p %x %lf %999999999d\",\n        b\"ERROR: %s is negative.\",\n    ]\n    .iter()\n    .map(|s| Op::PrintLine(s.to_vec()))\n    .collect();\n    assert_same_batch(&ops);\n}\n\n/// CONFIGS row 6 — embedded newlines / CR / tabs / control bytes.\n#[test]\nfn cfg_06_print_line_embedded_newlines() {\n    let ops: Vec<Op> = [\n        &b\"\\n\"[..],\n        b\"a\\nb\",\n        b\"\\n\\n\\n\",\n        b\"line1\\nline2\\n\",\n        b\"\\r\\n\",\n        b\"tab\\there\",\n        b\"trailing\\n\",\n        b\"\\x0b\\x0c\\x1b[31m\",\n    ]\n    .iter()\n    .map(|s| Op::PrintLine(s.to_vec()))\n    .collect();\n    assert_same_batch(&ops);\n}\n\n/// CONFIGS row 7 — lengths straddling libc's stdout buffer size.\n#[test]\nfn cfg_07_print_line_buffer_boundary_lengths() {\n    let ops: Vec<Op> = [\n        1usize, 2, 63, 64, 127, 128, 511, 512, 1023, 1024, 4095, 4096, 4097, 8190, 8191, 8192,\n        8193, 16384, 65536,\n    ]\n    .iter()\n    .map(|&len| Op::PrintLine((0..len).map(|i| b'a' + (i % 26) as u8).collect()))\n    .collect();\n    assert_same_batch(&ops);\n    // and again with stdout unbuffered, so the flush points differ\n    assert_same_batch_buffered(&ops, Buffering::Unbuffered);\n}\n\n/// CONFIGS row 8 — interior pointer + embedded NUL truncation.\n#[test]\nfn cfg_08_print_line_interior_pointer() {\n    let buf = b\"HEAD\\0TAIL\\0more\\0\".to_vec();\n    let mut ops: Vec<Op> = [0usize, 1, 4, 5, 9, 10, 14]\n        .iter()\n        .map(|&off| Op::PrintLineRaw(buf.clone(), off))\n        .collect();\n    // A long buffer whose NUL is far from the start, addressed from the middle.\n    let mut long = vec![b'z'; 5000];\n    long[4000] = 0;\n    long.push(0);\n    for off in [0usize, 1, 2500, 3999, 4000, 4001] {\n        ops.push(Op::PrintLineRaw(long.clone(), off));\n    }\n    assert_same_batch(&ops);\n}\n\n// ---------------------------------------------------------------------------\n// Rows 9–11: printIntLine (lowest level)\n// ---------------------------------------------------------------------------\n\n/// CONFIGS row 9 — fixed integer shapes.\n#[test]\nfn cfg_09_print_int_line_fixed_shapes() {\n    let ops: Vec<Op> = [\n        0i32,\n        1,\n        -1,\n        9,\n        -9,\n        10,\n        -10,\n        99999,\n        -99999,\n        i32::MAX,\n        i32::MIN,\n        i32::MIN + 1,\n        i32::MAX - 1,\n    ]\n    .iter()\n    .map(|&n| Op::PrintIntLine(n))\n    .collect();\n    assert_same_batch(&ops);\n}\n\n/// CONFIGS row 10 — uniformly random ints across the whole 32-bit range.\n#[test]\nfn cfg_10_print_int_line_random_full_range() {\n    let mut rng = Rng::new(0x5EED_0010);\n    let ops: Vec<Op> = (0..3000).map(|_| Op::PrintIntLine(rng.next_i32())).collect();\n    assert_same_batch(&ops);\n}\n\n/// CONFIGS row 11 — one value per decimal digit width, both signs.\n#[test]\nfn cfg_11_print_int_line_digit_widths() {\n    let mut ops = Vec::new();\n    let mut v = 1i64;\n    for _ in 0..10 {\n        let n = v.min(i32::MAX as i64) as i32;\n        ops.push(Op::PrintIntLine(n));\n        ops.push(Op::PrintIntLine(-n));\n        ops.push(Op::PrintIntLine(n.wrapping_sub(1)));\n        v *= 10;\n    }\n    assert_same_batch(&ops);\n}\n\n// ---------------------------------------------------------------------------\n// Rows 12–15: bad()\n// ---------------------------------------------------------------------------\n\n/// CONFIGS row 12 — every in-bounds index, exhaustively.\n#[test]\nfn cfg_12_bad_all_in_bounds() {\n    let ops: Vec<Op> = (0..10).map(Op::Bad).collect();\n    assert_same_batch(&ops);\n    // cross-check both libraries against the model of the C source\n    for lib in [c_lib(), rust_lib()] {\n        for (i, out) in outputs(lib, &ops).iter().enumerate() {\n            assert_eq!(out, &ten_lines(Some(i)), \"{} lib bad({i})\", lib.name);\n        }\n    }\n}\n\n/// CONFIGS row 13 — randomised negative `data` (the rejecting branch).\n#[test]\nfn cfg_13_bad_random_negative() {\n    let mut rng = Rng::new(0x5EED_0013);\n    let ops: Vec<Op> = (0..300)\n        .map(|_| Op::Bad(rng.range_i32(i32::MIN, -1)))\n        .collect();\n    assert_same_batch(&ops);\n}\n\n/// CONFIGS row 14 — out-of-bounds sweep 10..=64 (deliberate UB store).\n#[test]\nfn cfg_14_bad_oob_sweep() {\n    for d in 10..=64 {\n        assert_same_stdout_ub(&Op::Bad(d));\n    }\n}\n\n/// CONFIGS row 15 — randomised large out-of-bounds indices (deliberate UB).\n#[test]\nfn cfg_15_bad_oob_random() {\n    let mut rng = Rng::new(0x5EED_0015);\n    for _ in 0..60 {\n        assert_same_stdout_ub(&Op::Bad(rng.range_i32(10, i32::MAX)));\n    }\n    for d in [10, 11, 1 << 20, i32::MAX - 1, i32::MAX] {\n        assert_same_stdout_ub(&Op::Bad(d));\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Rows 16–18: good() (drives the two `static` helpers)\n// ---------------------------------------------------------------------------\n\n/// CONFIGS row 16 — every accepted index, exhaustively.\n#[test]\nfn cfg_16_good_all_in_bounds() {\n    let ops: Vec<Op> = (0..10).map(Op::Good).collect();\n    assert_same_batch(&ops);\n    for lib in [c_lib(), rust_lib()] {\n        for (i, out) in outputs(lib, &ops).iter().enumerate() {\n            let mut expected = ten_lines(Some(7)); // goodG2B: data == 7\n            expected.extend_from_slice(&ten_lines(Some(i))); // goodB2G: data == i\n            assert_eq!(out, &expected, \"{} lib good({i})\", lib.name);\n        }\n    }\n}\n\n/// CONFIGS row 17 — rejected `data` values, fixed and randomised.\n#[test]\nfn cfg_17_good_out_of_range() {\n    let mut ops: Vec<Op> = [\n        -1,\n        i32::MIN,\n        i32::MIN + 1,\n        10,\n        11,\n        12,\n        100,\n        i32::MAX - 1,\n        i32::MAX,\n    ]\n    .iter()\n    .map(|&d| Op::Good(d))\n    .collect();\n    let mut rng = Rng::new(0x5EED_0017);\n    for _ in 0..300 {\n        let d = if rng.next_u64() & 1 == 0 {\n            rng.range_i32(i32::MIN, -1)\n        } else {\n            rng.range_i32(10, i32::MAX)\n        };\n        ops.push(Op::Good(d));\n    }\n    assert_same_batch(&ops);\n}\n\n/// CONFIGS row 18 — randomised over the whole int range (mixes both classes).\n#[test]\nfn cfg_18_good_random_full_range() {\n    let mut rng = Rng::new(0x5EED_0018);\n    let ops: Vec<Op> = (0..600)\n        .map(|_| {\n            // bias towards the interesting window while still covering everything\n            Op::Good(match rng.next_u64() % 4 {\n                0 => rng.range_i32(-12, 12),\n                1 => rng.range_i32(-1000, 1000),\n                _ => rng.next_i32(),\n            })\n        })\n        .collect();\n    assert_same_batch(&ops);\n}\n\n// ---------------------------------------------------------------------------\n// Rows 19–22: driver() (composed pipeline)\n// ---------------------------------------------------------------------------\n\nconst GOOD_VALUES: [i32; 8] = [-1, i32::MIN, 0, 1, 7, 9, 10, i32::MAX];\nconst BAD_SAFE_VALUES: [i32; 8] = [-1, i32::MIN, i32::MIN + 1, 0, 1, 5, 7, 9];\n\n/// CONFIGS row 19 — full cross product over the well-defined domain.\n#[test]\nfn cfg_19_driver_cross_product() {\n    let mut ops = Vec::new();\n    for g in GOOD_VALUES {\n        for b in BAD_SAFE_VALUES {\n            ops.push(Op::Driver(g, b));\n        }\n    }\n    assert_same_batch(&ops);\n}\n\n/// CONFIGS row 20 — cross product with out-of-bounds `badData` (UB store).\n#[test]\nfn cfg_20_driver_cross_product_oob_bad() {\n    for g in GOOD_VALUES {\n        for b in [10, 11, 12, 20, 40, i32::MAX] {\n            assert_same_stdout_ub(&Op::Driver(g, b));\n        }\n    }\n}\n\n/// CONFIGS row 21 — randomised, both arguments in the accepted range.\n#[test]\nfn cfg_21_driver_random_valid() {\n    let mut rng = Rng::new(0x5EED_0021);\n    let ops: Vec<Op> = (0..300)\n        .map(|_| Op::Driver(rng.range_i32(0, 9), rng.range_i32(0, 9)))\n        .collect();\n    assert_same_batch(&ops);\n}\n\n/// CONFIGS row 22 — randomised over the whole int range for `goodData`, and over\n/// the well-defined domain for `badData` (`badData >= 10` is row 20).\n#[test]\nfn cfg_22_driver_random_full_range() {\n    let mut rng = Rng::new(0x5EED_0022);\n    let ops: Vec<Op> = (0..400)\n        .map(|_| {\n            let g = match rng.next_u64() % 3 {\n                0 => rng.range_i32(-12, 12),\n                1 => rng.range_i32(-100_000, 100_000),\n                _ => rng.next_i32(),\n            };\n            let b = match rng.next_u64() % 3 {\n                0 => rng.range_i32(-12, 9),\n                1 => rng.range_i32(i32::MIN, -1),\n                _ => rng.range_i32(0, 9),\n            };\n            Op::Driver(g, b)\n        })\n        .collect();\n    assert_same_batch(&ops);\n}\n\n// ---------------------------------------------------------------------------\n// Rows 23–27: sequencing, buffering, statelessness, composition, fuzz\n// ---------------------------------------------------------------------------\n\nfn mixed_sequence() -> Vec<Op> {\n    vec![\n        Op::PrintLine(b\"header\".to_vec()),\n        Op::PrintIntLine(-42),\n        Op::Bad(3),\n        Op::Good(9),\n        Op::PrintLineNull,\n        Op::Bad(-7),\n        Op::Good(-1),\n        Op::PrintIntLine(i32::MIN),\n        Op::Driver(4, 8),\n        Op::PrintLine(b\"footer\".to_vec()),\n    ]\n}\n\n/// CONFIGS row 23 — interleaved calls, one stdout stream, block buffered.\n#[test]\nfn cfg_23_interleaved_sequence_block_buffered() {\n    assert_same_batch_buffered(&mixed_sequence(), Buffering::Block);\n}\n\n/// CONFIGS row 24 — the same sequence with stdout unbuffered.\n#[test]\nfn cfg_24_interleaved_sequence_unbuffered() {\n    assert_same_batch_buffered(&mixed_sequence(), Buffering::Unbuffered);\n}\n\n/// CONFIGS row 25 — no residual state between calls: the same call repeated 50×\n/// produces 50 identical blocks in both libraries.\n#[test]\nfn cfg_25_repeated_invocation_no_state() {\n    for op in [\n        Op::Bad(5),\n        Op::Good(2),\n        Op::Driver(7, 7),\n        Op::PrintIntLine(123),\n        Op::PrintLine(b\"x\".to_vec()),\n    ] {\n        let seq: Vec<Op> = std::iter::repeat_n(op.clone(), 50).collect();\n        assert_same_batch(&seq);\n        for lib in [c_lib(), rust_lib()] {\n            let blocks = outputs(lib, &seq);\n            let first = blocks[0].clone();\n            for (i, b) in blocks.iter().enumerate() {\n                assert_eq!(\n                    b,\n                    &first,\n                    \"{} lib: call #{i} of {} differs from the first — state leaked\",\n                    lib.name,\n                    op.describe()\n                );\n            }\n        }\n    }\n}\n\n/// CONFIGS row 26 — `driver()` must equal the hand-composed pipeline in *both*\n/// libraries (verifies the composed order of the low-level calls, not just the\n/// wrapper's own output).\n#[test]\nfn cfg_26_driver_equals_composition() {\n    let mut rng = Rng::new(0x5EED_0026);\n    let mut cases: Vec<(i32, i32)> = vec![(7, 3), (-1, -1), (10, 0), (0, 9), (i32::MIN, i32::MIN)];\n    for _ in 0..40 {\n        cases.push((rng.range_i32(-20, 20), rng.range_i32(-20, 9)));\n    }\n    for (g, b) in cases {\n        let whole = vec![Op::Driver(g, b)];\n        let composed = vec![\n            Op::PrintLine(b\"Calling good()...\".to_vec()),\n            Op::Good(g),\n            Op::PrintLine(b\"Finished good()\".to_vec()),\n            Op::PrintLine(b\"Calling bad()...\".to_vec()),\n            Op::Bad(b),\n            Op::PrintLine(b\"Finished bad()\".to_vec()),\n        ];\n        for lib in [c_lib(), rust_lib()] {\n            let a = output(lib, &whole[0]);\n            let parts = outputs(lib, &composed).concat();\n            assert_eq!(\n                a, parts,\n                \"{} lib: driver({g},{b}) != composition of its parts\",\n                lib.name\n            );\n        }\n        assert_same_batch(&whole);\n        assert_same_batch(&composed);\n    }\n}\n\n/// CONFIGS row 27 — property-style fuzz: random programs of mixed calls over all\n/// five entry points.\n#[test]\nfn cfg_27_random_call_program() {\n    let mut rng = Rng::new(0x5EED_0027);\n    for _ in 0..150 {\n        let n = 1 + (rng.next_u32() % 12) as usize;\n        let mut ops = Vec::with_capacity(n);\n        for _ in 0..n {\n            ops.push(match rng.next_u64() % 6 {\n                0 => Op::PrintLineNull,\n                1 => {\n                    let len = (rng.next_u32() % 40) as usize;\n                    Op::PrintLine(\n                        (0..len)\n                            .map(|_| {\n                                let b = rng.next_byte();\n                                if b == 0 { b'.' } else { b }\n                            })\n                            .collect(),\n                    )\n                }\n                2 => Op::PrintIntLine(rng.next_i32()),\n                3 => Op::Bad(rng.range_i32(i32::MIN, 9)),\n                4 => Op::Good(rng.next_i32()),\n                _ => Op::Driver(rng.next_i32(), rng.range_i32(-20, 9)),\n            });\n        }\n        assert_same_batch(&ops);\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11455,"cache_read_input_tokens":85015,"cache_creation":{"ephemeral_5m_input_tokens":11455,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"0af81b2f-19bc-46ab-9c71-7e73412f8759","uuid":"4a256a6f-ad58-4db8-80fe-3b830c40d62d","timestamp":"2026-08-18T00:29:03.021Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_017rEPdiutZNAhbd2iqSDLgY","type":"tool_result","content":"The file /local/home/scheschb/.harvest/work/harvest-work-Nxrkg1/translated_rust/tests/valid_paths.rs has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"0af81b2f-19bc-46ab-9c71-7e73412f8759","uuid":"220d82a8-7d24-4ec1-b5fc-2e63be66f778","timestamp":"2026-08-18T00:29:03.048Z","tool_use_result":{"type":"update","filePath":"/local/home/scheschb/.harvest/work/harvest-work-Nxrkg1/translated_rust/tests/valid_paths.rs","content":"//! Phase B — valid-path differential tests.\n//!\n//! One test per row of `CONFIGS.md`.  Every test loads BOTH shared objects with\n//! `libloading` and calls them only through their exported C symbols, then\n//! compares the stdout bytes produced by each individual call.\n//!\n//! Order follows the call hierarchy: the lowest-level entry points first\n//! (`printLine`, `printIntLine`), then `bad` / `good` (the latter drives the two\n//! `static` helpers), then the composed `driver` pipeline, then sequencing,\n//! statelessness, composition and randomised mixed-call programs.\n\nmod common;\nuse common::*;\n\n// ---------------------------------------------------------------------------\n// Rows 1–8: printLine (lowest level)\n// ---------------------------------------------------------------------------\n\n/// CONFIGS row 1 — empty string.\n#[test]\nfn cfg_01_print_line_empty() {\n    assert_same(&Op::PrintLine(vec![]));\n}\n\n/// CONFIGS row 2 — every single non-NUL byte value.\n#[test]\nfn cfg_02_print_line_single_byte_all_values() {\n    let ops: Vec<Op> = (1u8..=255).map(|b| Op::PrintLine(vec![b])).collect();\n    assert_same_batch(&ops);\n}\n\n/// CONFIGS row 3 — randomised printable ASCII, length 1..=64.\n#[test]\nfn cfg_03_print_line_random_ascii() {\n    let mut rng = Rng::new(0x5EED_0003);\n    let ops: Vec<Op> = (0..400)\n        .map(|_| {\n            let len = 1 + (rng.next_u32() % 64) as usize;\n            Op::PrintLine((0..len).map(|_| 0x20 + rng.next_byte() % 0x5f).collect())\n        })\n        .collect();\n    assert_same_batch(&ops);\n}\n\n/// CONFIGS row 4 — randomised arbitrary non-NUL bytes (invalid UTF-8 included).\n#[test]\nfn cfg_04_print_line_random_bytes() {\n    let mut rng = Rng::new(0x5EED_0004);\n    let ops: Vec<Op> = (0..400)\n        .map(|_| {\n            let len = 1 + (rng.next_u32() % 256) as usize;\n            Op::PrintLine(\n                (0..len)\n                    .map(|_| {\n                        let b = rng.next_byte();\n                        if b == 0 { 1 } else { b }\n                    })\n                    .collect(),\n            )\n        })\n        .collect();\n    assert_same_batch(&ops);\n}\n\n/// CONFIGS row 5 — the payload looks like a printf format string.\n#[test]\nfn cfg_05_print_line_format_specifiers() {\n    let ops: Vec<Op> = [\n        &b\"%s\"[..],\n        b\"%d\",\n        b\"%n\",\n        b\"%%\",\n        b\"%s%s%s%s%s%s%s%s\",\n        b\"%n%n%n%n\",\n        b\"100%% done: %p %x %lf %999999999d\",\n        b\"ERROR: %s is negative.\",\n    ]\n    .iter()\n    .map(|s| Op::PrintLine(s.to_vec()))\n    .collect();\n    assert_same_batch(&ops);\n}\n\n/// CONFIGS row 6 — embedded newlines / CR / tabs / control bytes.\n#[test]\nfn cfg_06_print_line_embedded_newlines() {\n    let ops: Vec<Op> = [\n        &b\"\\n\"[..],\n        b\"a\\nb\",\n        b\"\\n\\n\\n\",\n        b\"line1\\nline2\\n\",\n        b\"\\r\\n\",\n        b\"tab\\there\",\n        b\"trailing\\n\",\n        b\"\\x0b\\x0c\\x1b[31m\",\n    ]\n    .iter()\n    .map(|s| Op::PrintLine(s.to_vec()))\n    .collect();\n    assert_same_batch(&ops);\n}\n\n/// CONFIGS row 7 — lengths straddling libc's stdout buffer size.\n#[test]\nfn cfg_07_print_line_buffer_boundary_lengths() {\n    let ops: Vec<Op> = [\n        1usize, 2, 63, 64, 127, 128, 511, 512, 1023, 1024, 4095, 4096, 4097, 8190, 8191, 8192,\n        8193, 16384, 65536,\n    ]\n    .iter()\n    .map(|&len| Op::PrintLine((0..len).map(|i| b'a' + (i % 26) as u8).collect()))\n    .collect();\n    assert_same_batch(&ops);\n    // and again with stdout unbuffered, so the flush points differ\n    assert_same_batch_buffered(&ops, Buffering::Unbuffered);\n}\n\n/// CONFIGS row 8 — interior pointer + embedded NUL truncation.\n#[test]\nfn cfg_08_print_line_interior_pointer() {\n    let buf = b\"HEAD\\0TAIL\\0more\\0\".to_vec();\n    let mut ops: Vec<Op> = [0usize, 1, 4, 5, 9, 10, 14]\n        .iter()\n        .map(|&off| Op::PrintLineRaw(buf.clone(), off))\n        .collect();\n    // A long buffer whose NUL is far from the start, addressed from the middle.\n    let mut long = vec![b'z'; 5000];\n    long[4000] = 0;\n    long.push(0);\n    for off in [0usize, 1, 2500, 3999, 4000, 4001] {\n        ops.push(Op::PrintLineRaw(long.clone(), off));\n    }\n    assert_same_batch(&ops);\n}\n\n// ---------------------------------------------------------------------------\n// Rows 9–11: printIntLine (lowest level)\n// ---------------------------------------------------------------------------\n\n/// CONFIGS row 9 — fixed integer shapes.\n#[test]\nfn cfg_09_print_int_line_fixed_shapes() {\n    let ops: Vec<Op> = [\n        0i32,\n        1,\n        -1,\n        9,\n        -9,\n        10,\n        -10,\n        99999,\n        -99999,\n        i32::MAX,\n        i32::MIN,\n        i32::MIN + 1,\n        i32::MAX - 1,\n    ]\n    .iter()\n    .map(|&n| Op::PrintIntLine(n))\n    .collect();\n    assert_same_batch(&ops);\n}\n\n/// CONFIGS row 10 — uniformly random ints across the whole 32-bit range.\n#[test]\nfn cfg_10_print_int_line_random_full_range() {\n    let mut rng = Rng::new(0x5EED_0010);\n    let ops: Vec<Op> = (0..3000).map(|_| Op::PrintIntLine(rng.next_i32())).collect();\n    assert_same_batch(&ops);\n}\n\n/// CONFIGS row 11 — one value per decimal digit width, both signs.\n#[test]\nfn cfg_11_print_int_line_digit_widths() {\n    let mut ops = Vec::new();\n    let mut v = 1i64;\n    for _ in 0..10 {\n        let n = v.min(i32::MAX as i64) as i32;\n        ops.push(Op::PrintIntLine(n));\n        ops.push(Op::PrintIntLine(-n));\n        ops.push(Op::PrintIntLine(n.wrapping_sub(1)));\n        v *= 10;\n    }\n    assert_same_batch(&ops);\n}\n\n// ---------------------------------------------------------------------------\n// Rows 12–15: bad()\n// ---------------------------------------------------------------------------\n\n/// CONFIGS row 12 — every in-bounds index, exhaustively.\n#[test]\nfn cfg_12_bad_all_in_bounds() {\n    let ops: Vec<Op> = (0..10).map(Op::Bad).collect();\n    assert_same_batch(&ops);\n    // cross-check both libraries against the model of the C source\n    for lib in [c_lib(), rust_lib()] {\n        for (i, out) in outputs(lib, &ops).iter().enumerate() {\n            assert_eq!(out, &ten_lines(Some(i)), \"{} lib bad({i})\", lib.name);\n        }\n    }\n}\n\n/// CONFIGS row 13 — randomised negative `data` (the rejecting branch).\n#[test]\nfn cfg_13_bad_random_negative() {\n    let mut rng = Rng::new(0x5EED_0013);\n    let ops: Vec<Op> = (0..300)\n        .map(|_| Op::Bad(rng.range_i32(i32::MIN, -1)))\n        .collect();\n    assert_same_batch(&ops);\n}\n\n/// CONFIGS row 14 — out-of-bounds sweep 10..=64 (deliberate UB store).\n#[test]\nfn cfg_14_bad_oob_sweep() {\n    for d in 10..=64 {\n        assert_same_stdout_ub(&Op::Bad(d));\n    }\n}\n\n/// CONFIGS row 15 — randomised large out-of-bounds indices (deliberate UB).\n#[test]\nfn cfg_15_bad_oob_random() {\n    let mut rng = Rng::new(0x5EED_0015);\n    for _ in 0..60 {\n        assert_same_stdout_ub(&Op::Bad(rng.range_i32(10, i32::MAX)));\n    }\n    for d in [10, 11, 1 << 20, i32::MAX - 1, i32::MAX] {\n        assert_same_stdout_ub(&Op::Bad(d));\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Rows 16–18: good() (drives the two `static` helpers)\n// ---------------------------------------------------------------------------\n\n/// CONFIGS row 16 — every accepted index, exhaustively.\n#[test]\nfn cfg_16_good_all_in_bounds() {\n    let ops: Vec<Op> = (0..10).map(Op::Good).collect();\n    assert_same_batch(&ops);\n    for lib in [c_lib(), rust_lib()] {\n        for (i, out) in outputs(lib, &ops).iter().enumerate() {\n            let mut expected = ten_lines(Some(7)); // goodG2B: data == 7\n            expected.extend_from_slice(&ten_lines(Some(i))); // goodB2G: data == i\n            assert_eq!(out, &expected, \"{} lib good({i})\", lib.name);\n        }\n    }\n}\n\n/// CONFIGS row 17 — rejected `data` values, fixed and randomised.\n#[test]\nfn cfg_17_good_out_of_range() {\n    let mut ops: Vec<Op> = [\n        -1,\n        i32::MIN,\n        i32::MIN + 1,\n        10,\n        11,\n        12,\n        100,\n        i32::MAX - 1,\n        i32::MAX,\n    ]\n    .iter()\n    .map(|&d| Op::Good(d))\n    .collect();\n    let mut rng = Rng::new(0x5EED_0017);\n    for _ in 0..300 {\n        let d = if rng.next_u64() & 1 == 0 {\n            rng.range_i32(i32::MIN, -1)\n        } else {\n            rng.range_i32(10, i32::MAX)\n        };\n        ops.push(Op::Good(d));\n    }\n    assert_same_batch(&ops);\n}\n\n/// CONFIGS row 18 — randomised over the whole int range (mixes both classes).\n#[test]\nfn cfg_18_good_random_full_range() {\n    let mut rng = Rng::new(0x5EED_0018);\n    let ops: Vec<Op> = (0..600)\n        .map(|_| {\n            // bias towards the interesting window while still covering everything\n            Op::Good(match rng.next_u64() % 4 {\n                0 => rng.range_i32(-12, 12),\n                1 => rng.range_i32(-1000, 1000),\n                _ => rng.next_i32(),\n            })\n        })\n        .collect();\n    assert_same_batch(&ops);\n}\n\n// ---------------------------------------------------------------------------\n// Rows 19–22: driver() (composed pipeline)\n// ---------------------------------------------------------------------------\n\nconst GOOD_VALUES: [i32; 8] = [-1, i32::MIN, 0, 1, 7, 9, 10, i32::MAX];\nconst BAD_SAFE_VALUES: [i32; 8] = [-1, i32::MIN, i32::MIN + 1, 0, 1, 5, 7, 9];\n\n/// CONFIGS row 19 — full cross product over the well-defined domain.\n#[test]\nfn cfg_19_driver_cross_product() {\n    let mut ops = Vec::new();\n    for g in GOOD_VALUES {\n        for b in BAD_SAFE_VALUES {\n            ops.push(Op::Driver(g, b));\n        }\n    }\n    assert_same_batch(&ops);\n}\n\n/// CONFIGS row 20 — cross product with out-of-bounds `badData` (UB store).\n#[test]\nfn cfg_20_driver_cross_product_oob_bad() {\n    for g in GOOD_VALUES {\n        for b in [10, 11, 12, 20, 40, i32::MAX] {\n            assert_same_stdout_ub(&Op::Driver(g, b));\n        }\n    }\n}\n\n/// CONFIGS row 21 — randomised, both arguments in the accepted range.\n#[test]\nfn cfg_21_driver_random_valid() {\n    let mut rng = Rng::new(0x5EED_0021);\n    let ops: Vec<Op> = (0..300)\n        .map(|_| Op::Driver(rng.range_i32(0, 9), rng.range_i32(0, 9)))\n        .collect();\n    assert_same_batch(&ops);\n}\n\n/// CONFIGS row 22 — randomised over the whole int range for `goodData`, and over\n/// the well-defined domain for `badData` (`badData >= 10` is row 20).\n#[test]\nfn cfg_22_driver_random_full_range() {\n    let mut rng = Rng::new(0x5EED_0022);\n    let ops: Vec<Op> = (0..400)\n        .map(|_| {\n            let g = match rng.next_u64() % 3 {\n                0 => rng.range_i32(-12, 12),\n                1 => rng.range_i32(-100_000, 100_000),\n                _ => rng.next_i32(),\n            };\n            let b = match rng.next_u64() % 3 {\n                0 => rng.range_i32(-12, 9),\n                1 => rng.range_i32(i32::MIN, -1),\n                _ => rng.range_i32(0, 9),\n            };\n            Op::Driver(g, b)\n        })\n        .collect();\n    assert_same_batch(&ops);\n}\n\n// ---------------------------------------------------------------------------\n// Rows 23–27: sequencing, buffering, statelessness, composition, fuzz\n// ---------------------------------------------------------------------------\n\nfn mixed_sequence() -> Vec<Op> {\n    vec![\n        Op::PrintLine(b\"header\".to_vec()),\n        Op::PrintIntLine(-42),\n        Op::Bad(3),\n        Op::Good(9),\n        Op::PrintLineNull,\n        Op::Bad(-7),\n        Op::Good(-1),\n        Op::PrintIntLine(i32::MIN),\n        Op::Driver(4, 8),\n        Op::PrintLine(b\"footer\".to_vec()),\n    ]\n}\n\n/// CONFIGS row 23 — interleaved calls, one stdout stream, block buffered.\n#[test]\nfn cfg_23_interleaved_sequence_block_buffered() {\n    assert_same_batch_buffered(&mixed_sequence(), Buffering::Block);\n}\n\n/// CONFIGS row 24 — the same sequence with stdout unbuffered.\n#[test]\nfn cfg_24_interleaved_sequence_unbuffered() {\n    assert_same_batch_buffered(&mixed_sequence(), Buffering::Unbuffered);\n}\n\n/// CONFIGS row 25 — no residual state between calls: the same call repeated 50×\n/// produces 50 identical blocks in both libraries.\n#[test]\nfn cfg_25_repeated_invocation_no_state() {\n    for op in [\n        Op::Bad(5),\n        Op::Good(2),\n        Op::Driver(7, 7),\n        Op::PrintIntLine(123),\n        Op::PrintLine(b\"x\".to_vec()),\n    ] {\n        let seq: Vec<Op> = std::iter::repeat_n(op.clone(), 50).collect();\n        assert_same_batch(&seq);\n        for lib in [c_lib(), rust_lib()] {\n            let blocks = outputs(lib, &seq);\n            let first = blocks[0].clone();\n            for (i, b) in blocks.iter().enumerate() {\n                assert_eq!(\n                    b,\n                    &first,\n                    \"{} lib: call #{i} of {} differs from the first — state leaked\",\n                    lib.name,\n                    op.describe()\n                );\n            }\n        }\n    }\n}\n\n/// CONFIGS row 26 — `driver()` must equal the hand-composed pipeline in *both*\n/// libraries (verifies the composed order of the low-level calls, not just the\n/// wrapper's own output).\n#[test]\nfn cfg_26_driver_equals_composition() {\n    let mut rng = Rng::new(0x5EED_0026);\n    let mut cases: Vec<(i32, i32)> = vec![(7, 3), (-1, -1), (10, 0), (0, 9), (i32::MIN, i32::MIN)];\n    for _ in 0..40 {\n        cases.push((rng.range_i32(-20, 20), rng.range_i32(-20, 9)));\n    }\n    for (g, b) in cases {\n        let whole = vec![Op::Driver(g, b)];\n        let composed = vec![\n            Op::PrintLine(b\"Calling good()...\".to_vec()),\n            Op::Good(g),\n            Op::PrintLine(b\"Finished good()\".to_vec()),\n            Op::PrintLine(b\"Calling bad()...\".to_vec()),\n            Op::Bad(b),\n            Op::PrintLine(b\"Finished bad()\".to_vec()),\n        ];\n        for lib in [c_lib(), rust_lib()] {\n            let a = output(lib, &whole[0]);\n            let parts = outputs(lib, &composed).concat();\n            assert_eq!(\n                a, parts,\n                \"{} lib: driver({g},{b}) != composition of its parts\",\n                lib.name\n            );\n        }\n        assert_same_batch(&whole);\n        assert_same_batch(&composed);\n    }\n}\n\n/// CONFIGS row 27 — property-style fuzz: random programs of mixed calls over all\n/// five entry points.\n#[test]\nfn cfg_27_random_call_program() {\n    let mut rng = Rng::new(0x5EED_0027);\n    for _ in 0..150 {\n        let n = 1 + (rng.next_u32() % 12) as usize;\n        let mut ops = Vec::with_capacity(n);\n        for _ in 0..n {\n            ops.push(match rng.next_u64() % 6 {\n                0 => Op::PrintLineNull,\n                1 => {\n                    let len = (rng.next_u32() % 40) as usize;\n                    Op::PrintLine(\n                        (0..len)\n                            .map(|_| {\n                                let b = rng.next_byte();\n                                if b == 0 { b'.' } else { b }\n                            })\n                            .collect(),\n                    )\n                }\n                2 => Op::PrintIntLine(rng.next_i32()),\n                3 => Op::Bad(rng.range_i32(i32::MIN, 9)),\n                4 => Op::Good(rng.next_i32()),\n                _ => Op::Driver(rng.next_i32(), rng.range_i32(-20, 9)),\n            });\n        }\n        assert_same_batch(&ops);\n    }\n}\n","structuredPatch":[{"oldStart":2,"oldLines":11,"newStart":2,"newLines":12,"lines":[" //!"," //! One test per row of `CONFIGS.md`.  Every test loads BOTH shared objects with"," //! `libloading` and calls them only through their exported C symbols, then","-//! compares the stdout bytes they produce.","+//! compares the stdout bytes produced by each individual call."," //!","-//! Tests start at the lowest-level entry points (`printLine`, `printIntLine`),","-//! then the mid-level `bad`/`good` (which drives the two `static` helpers), then","-//! the composed `driver` pipeline, then randomised mixed call programs.","+//! Order follows the call hierarchy: the lowest-level entry points first","+//! (`printLine`, `printIntLine`), then `bad` / `good` (the latter drives the two","+//! `static` helpers), then the composed `driver` pipeline, then sequencing,","+//! statelessness, composition and randomised mixed-call programs."," "," mod common;"," use common::*;"]},{"oldStart":24,"oldLines":42,"newStart":25,"newLines":47,"lines":[" /// CONFIGS row 2 — every single non-NUL byte value."," #[test]"," fn cfg_02_print_line_single_byte_all_values() {","-    for b in 1u8..=255 {","-        assert_same(&Op::PrintLine(vec![b]));","-    }","+    let ops: Vec<Op> = (1u8..=255).map(|b| Op::PrintLine(vec![b])).collect();","+    assert_same_batch(&ops);"," }"," "," /// CONFIGS row 3 — randomised printable ASCII, length 1..=64."," #[test]"," fn cfg_03_print_line_random_ascii() {","     let mut rng = Rng::new(0x5EED_0003);","-    for _ in 0..300 {","-        let len = 1 + (rng.next_u32() % 64) as usize;","-        let s: Vec<u8> = (0..len).map(|_| 0x20 + rng.next_byte() % 0x5f).collect();","-        assert_same(&Op::PrintLine(s));","-    }","+    let ops: Vec<Op> = (0..400)","+        .map(|_| {","+            let len = 1 + (rng.next_u32() % 64) as usize;","+            Op::PrintLine((0..len).map(|_| 0x20 + rng.next_byte() % 0x5f).collect())","+        })","+        .collect();","+    assert_same_batch(&ops);"," }"," "," /// CONFIGS row 4 — randomised arbitrary non-NUL bytes (invalid UTF-8 included)."," #[test]"," fn cfg_04_print_line_random_bytes() {","     let mut rng = Rng::new(0x5EED_0004);","-    for _ in 0..300 {","-        let len = 1 + (rng.next_u32() % 256) as usize;","-        let s: Vec<u8> = (0..len)","-            .map(|_| {","-                let b = rng.next_byte();","-                if b == 0 { 1 } else { b }","-            })","-            .collect();","-        assert_same(&Op::PrintLine(s));","-    }","+    let ops: Vec<Op> = (0..400)","+        .map(|_| {","+            let len = 1 + (rng.next_u32() % 256) as usize;","+            Op::PrintLine(","+                (0..len)","+                    .map(|_| {","+                        let b = rng.next_byte();","+                        if b == 0 { 1 } else { b }","+                    })","+                    .collect(),","+            )","+        })","+        .collect();","+    assert_same_batch(&ops);"," }"," "," /// CONFIGS row 5 — the payload looks like a printf format string."," #[test]"," fn cfg_05_print_line_format_specifiers() {","-    for s in [","+    let ops: Vec<Op> = [","         &b\"%s\"[..],","         b\"%d\",","         b\"%n\","]},{"oldStart":68,"oldLines":15,"newStart":74,"newLines":17,"lines":["         b\"%n%n%n%n\",","         b\"100%% done: %p %x %lf %999999999d\",","         b\"ERROR: %s is negative.\",","-    ] {","-        assert_same(&Op::PrintLine(s.to_vec()));","-    }","+    ]","+    .iter()","+    .map(|s| Op::PrintLine(s.to_vec()))","+    .collect();","+    assert_same_batch(&ops);"," }"," ","-/// CONFIGS row 6 — embedded newlines / CR / tabs.","+/// CONFIGS row 6 — embedded newlines / CR / tabs / control bytes."," #[test]"," fn cfg_06_print_line_embedded_newlines() {","-    for s in [","+    let ops: Vec<Op> = [","         &b\"\\n\"[..],","         b\"a\\nb\",","         b\"\\n\\n\\n\","]},{"oldStart":85,"oldLines":37,"newStart":93,"newLines":44,"lines":["         b\"tab\\there\",","         b\"trailing\\n\",","         b\"\\x0b\\x0c\\x1b[31m\",","-    ] {","-        assert_same(&Op::PrintLine(s.to_vec()));","-    }","+    ]","+    .iter()","+    .map(|s| Op::PrintLine(s.to_vec()))","+    .collect();","+    assert_same_batch(&ops);"," }"," "," /// CONFIGS row 7 — lengths straddling libc's stdout buffer size."," #[test]"," fn cfg_07_print_line_buffer_boundary_lengths() {","-    for len in [","+    let ops: Vec<Op> = [","         1usize, 2, 63, 64, 127, 128, 511, 512, 1023, 1024, 4095, 4096, 4097, 8190, 8191, 8192,","         8193, 16384, 65536,","-    ] {","-        let s: Vec<u8> = (0..len).map(|i| b'a' + (i % 26) as u8).collect();","-        assert_same(&Op::PrintLine(s));","-    }","+    ]","+    .iter()","+    .map(|&len| Op::PrintLine((0..len).map(|i| b'a' + (i % 26) as u8).collect()))","+    .collect();","+    assert_same_batch(&ops);","+    // and again with stdout unbuffered, so the flush points differ","+    assert_same_batch_buffered(&ops, Buffering::Unbuffered);"," }"," "," /// CONFIGS row 8 — interior pointer + embedded NUL truncation."," #[test]"," fn cfg_08_print_line_interior_pointer() {","     let buf = b\"HEAD\\0TAIL\\0more\\0\".to_vec();","-    for off in [0usize, 1, 4, 5, 9, 10, 14] {","-        assert_same(&Op::PrintLineRaw(buf.clone(), off));","-    }","+    let mut ops: Vec<Op> = [0usize, 1, 4, 5, 9, 10, 14]","+        .iter()","+        .map(|&off| Op::PrintLineRaw(buf.clone(), off))","+        .collect();","     // A long buffer whose NUL is far from the start, addressed from the middle.","     let mut long = vec![b'z'; 5000];","     long[4000] = 0;","     long.push(0);","     for off in [0usize, 1, 2500, 3999, 4000, 4001] {","-        assert_same(&Op::PrintLineRaw(long.clone(), off));","+        ops.push(Op::PrintLineRaw(long.clone(), off));","     }","+    assert_same_batch(&ops);"," }"," "," // ---------------------------------------------------------------------------"]},{"oldStart":125,"oldLines":7,"newStart":140,"newLines":7,"lines":[" /// CONFIGS row 9 — fixed integer shapes."," #[test]"," fn cfg_09_print_int_line_fixed_shapes() {","-    for n in [","+    let ops: Vec<Op> = [","         0i32,","         1,","         -1,"]},{"oldStart":139,"oldLines":31,"newStart":154,"newLines":34,"lines":["         i32::MIN,","         i32::MIN + 1,","         i32::MAX - 1,","-    ] {","-        assert_same(&Op::PrintIntLine(n));","-    }","+    ]","+    .iter()","+    .map(|&n| Op::PrintIntLine(n))","+    .collect();","+    assert_same_batch(&ops);"," }"," "," /// CONFIGS row 10 — uniformly random ints across the whole 32-bit range."," #[test]"," fn cfg_10_print_int_line_random_full_range() {","     let mut rng = Rng::new(0x5EED_0010);","-    for _ in 0..2000 {","-        assert_same(&Op::PrintIntLine(rng.next_i32()));","-    }","+    let ops: Vec<Op> = (0..3000).map(|_| Op::PrintIntLine(rng.next_i32())).collect();","+    assert_same_batch(&ops);"," }"," "," /// CONFIGS row 11 — one value per decimal digit width, both signs."," #[test]"," fn cfg_11_print_int_line_digit_widths() {","+    let mut ops = Vec::new();","     let mut v = 1i64;","     for _ in 0..10 {","         let n = v.min(i32::MAX as i64) as i32;","-        assert_same(&Op::PrintIntLine(n));","-        assert_same(&Op::PrintIntLine(-n));","-        assert_same(&Op::PrintIntLine(n.wrapping_sub(1)));","+        ops.push(Op::PrintIntLine(n));","+        ops.push(Op::PrintIntLine(-n));","+        ops.push(Op::PrintIntLine(n.wrapping_sub(1)));","         v *= 10;","     }","+    assert_same_batch(&ops);"," }"," "," // ---------------------------------------------------------------------------"]},{"oldStart":173,"oldLines":11,"newStart":191,"newLines":13,"lines":[" /// CONFIGS row 12 — every in-bounds index, exhaustively."," #[test]"," fn cfg_12_bad_all_in_bounds() {","-    for d in 0..10 {","-        assert_same_forked(&Op::Bad(d));","-        // cross-check against the model of the C source","-        let out = capture_inproc(|| run_op(c_lib(), &Op::Bad(d)));","-        assert_eq!(out, ten_lines(Some(d as usize)));","+    let ops: Vec<Op> = (0..10).map(Op::Bad).collect();","+    assert_same_batch(&ops);","+    // cross-check both libraries against the model of the C source","+    for lib in [c_lib(), rust_lib()] {","+        for (i, out) in outputs(lib, &ops).iter().enumerate() {","+            assert_eq!(out, &ten_lines(Some(i)), \"{} lib bad({i})\", lib.name);","+        }","     }"," }"," "]},{"oldStart":185,"oldLines":17,"newStart":205,"newLines":17,"lines":[" #[test]"," fn cfg_13_bad_random_negative() {","     let mut rng = Rng::new(0x5EED_0013);","-    for _ in 0..200 {","-        let d = rng.range_i32(i32::MIN, -1);","-        assert_same(&Op::Bad(d));","-    }","+    let ops: Vec<Op> = (0..300)","+        .map(|_| Op::Bad(rng.range_i32(i32::MIN, -1)))","+        .collect();","+    assert_same_batch(&ops);"," }"," "," /// CONFIGS row 14 — out-of-bounds sweep 10..=64 (deliberate UB store)."," #[test]"," fn cfg_14_bad_oob_sweep() {","     for d in 10..=64 {","-        assert_same_stdout_forked(&Op::Bad(d));","+        assert_same_stdout_ub(&Op::Bad(d));","     }"," }"," "]},{"oldStart":204,"oldLines":11,"newStart":224,"newLines":10,"lines":[" fn cfg_15_bad_oob_random() {","     let mut rng = Rng::new(0x5EED_0015);","     for _ in 0..60 {","-        let d = rng.range_i32(10, i32::MAX);","-        assert_same_stdout_forked(&Op::Bad(d));","+        assert_same_stdout_ub(&Op::Bad(rng.range_i32(10, i32::MAX)));","     }","-    for d in [10, 11, i32::MAX - 1, i32::MAX]