push(Op::Good(d));","     }","+    assert_same_batch(&ops);"," }"," "," /// CONFIGS row 18 — randomised over the whole int range (mixes both classes)."," #[test]"," fn cfg_18_good_random_full_range() {","     let mut rng = Rng::new(0x5EED_0018);","-    for _ in 0..500 {","-        // bias towards the interesting window while still covering everything","-        let d = match rng.next_u64() % 4 {","-            0 => rng.range_i32(-12, 12),","-            1 => rng.range_i32(-1000, 1000),","-            _ => rng.next_i32(),","-        };","-        assert_same(&Op::Good(d));","-    }","+    let ops: Vec<Op> = (0..600)","+        .map(|_| {","+            // bias towards the interesting window while still covering everything","+            Op::Good(match rng.next_u64() % 4 {","+                0 => rng.range_i32(-12, 12),","+                1 => rng.range_i32(-1000, 1000),","+                _ => rng.next_i32(),","+            })","+        })","+        .collect();","+    assert_same_batch(&ops);"," }"," "," // ---------------------------------------------------------------------------"]},{"oldStart":270,"oldLines":11,"newStart":305,"newLines":13,"lines":[" /// CONFIGS row 19 — full cross product over the well-defined domain."," #[test]"," fn cfg_19_driver_cross_product() {","+    let mut ops = Vec::new();","     for g in GOOD_VALUES {","         for b in BAD_SAFE_VALUES {","-            assert_same_forked(&Op::Driver(g, b));","+            ops.push(Op::Driver(g, b));","         }","     }","+    assert_same_batch(&ops);"," }"," "," /// CONFIGS row 20 — cross product with out-of-bounds `badData` (UB store)."]},{"oldStart":282,"oldLines":7,"newStart":319,"newLines":7,"lines":[" fn cfg_20_driver_cross_product_oob_bad() {","     for g in GOOD_VALUES {","         for b in [10, 11, 12, 20, 40, i32::MAX] {","-            assert_same_stdout_forked(&Op::Driver(g, b));","+            assert_same_stdout_ub(&Op::Driver(g, b));","         }","     }"," }"]},{"oldStart":291,"oldLines":32,"newStart":328,"newLines":33,"lines":[" #[test]"," fn cfg_21_driver_random_valid() {","     let mut rng = Rng::new(0x5EED_0021);","-    for _ in 0..200 {","-        let g = rng.range_i32(0, 9);","-        let b = rng.range_i32(0, 9);","-        assert_same(&Op::Driver(g, b));","-    }","+    let ops: Vec<Op> = (0..300)","+        .map(|_| Op::Driver(rng.range_i32(0, 9), rng.range_i32(0, 9)))","+        .collect();","+    assert_same_batch(&ops);"," }"," "," /// CONFIGS row 22 — randomised over the whole int range for `goodData`, and over","-/// the non-UB domain for `badData` (`badData >= 10` is covered by row 20 with","-/// stdout-only comparison).","+/// the well-defined domain for `badData` (`badData >= 10` is row 20)."," #[test]"," fn cfg_22_driver_random_full_range() {","     let mut rng = Rng::new(0x5EED_0022);","-    for _ in 0..300 {","-        let g = match rng.next_u64() % 3 {","-            0 => rng.range_i32(-12, 12),","-            1 => rng.range_i32(-100000, 100000),","-            _ => rng.next_i32(),","-        };","-        let b = match rng.next_u64() % 3 {","-            0 => rng.range_i32(-12, 9),","-            1 => rng.range_i32(i32::MIN, -1),","-            _ => rng.range_i32(0, 9),","-        };","-        assert_same(&Op::Driver(g, b));","-    }","+    let ops: Vec<Op> = (0..400)","+        .map(|_| {","+            let g = match rng.next_u64() % 3 {","+                0 => rng.range_i32(-12, 12),","+                1 => rng.range_i32(-100_000, 100_000),","+                _ => rng.next_i32(),","+            };","+            let b = match rng.next_u64() % 3 {","+                0 => rng.range_i32(-12, 9),","+                1 => rng.range_i32(i32::MIN, -1),","+                _ => rng.range_i32(0, 9),","+            };","+            Op::Driver(g, b)","+        })","+        .collect();","+    assert_same_batch(&ops);"," }"," "," // ---------------------------------------------------------------------------"]},{"oldStart":341,"oldLines":33,"newStart":379,"newLines":47,"lines":[" /// CONFIGS row 23 — interleaved calls, one stdout stream, block buffered."," #[test]"," fn cfg_23_interleaved_sequence_block_buffered() {","-    assert_same_seq(&mixed_sequence());","+    assert_same_batch_buffered(&mixed_sequence(), Buffering::Block);"," }"," ","-/// CONFIGS row 24 — the same sequence with stdout unbuffered, in a child","-/// process, comparing termination status as well.","+/// CONFIGS row 24 — the same sequence with stdout unbuffered."," #[test]"," fn cfg_24_interleaved_sequence_unbuffered() {","-    assert_same_seq_forked(&mixed_sequence());","+    assert_same_batch_buffered(&mixed_sequence(), Buffering::Unbuffered);"," }"," "," /// CONFIGS row 25 — no residual state between calls: the same call repeated 50×","-/// must produce 50 identical blocks in both libraries.","+/// produces 50 identical blocks in both libraries."," #[test]"," fn cfg_25_repeated_invocation_no_state() {","-    for op in [Op::Bad(5), Op::Good(2), Op::Driver(7, 7), Op::PrintIntLine(123)] {","+    for op in [","+        Op::Bad(5),","+        Op::Good(2),","+        Op::Driver(7, 7),","+        Op::PrintIntLine(123),","+        Op::PrintLine(b\"x\".to_vec()),","+    ] {","         let seq: Vec<Op> = std::iter::repeat_n(op.clone(), 50).collect();","-        assert_same_seq(&seq);","-        // and every repetition is identical to a single invocation","-        let one = capture_inproc(|| run_op(rust_lib(), &op));","-        let many = transcript(rust_lib(), &seq);","-        assert_eq!(many, one.repeat(50), \"state leaked between calls: {}\", op.describe());","+        assert_same_batch(&seq);","+        for lib in [c_lib(), rust_lib()] {","+            let blocks = outputs(lib, &seq);","+            let first = blocks[0].clone();","+            for (i, b) in blocks.iter().enumerate() {","+                assert_eq!(","+                    b,","+                    &first,","+                    \"{} lib: call #{i} of {} differs from the first — state leaked\",","+                    lib.name,","+                    op.describe()","+                );","+            }","+        }","     }"," }"," "," /// CONFIGS row 26 — `driver()` must equal the hand-composed pipeline in *both*"," /// libraries (verifies the composed order of the low-level calls, not just the","-/// convenience wrapper's own output).","+/// wrapper's own output)."," #[test]"," fn cfg_26_driver_equals_composition() {","     let mut rng = Rng::new(0x5EED_0026);"]},{"oldStart":376,"oldLines":6,"newStart":428,"newLines":7,"lines":["         cases.push((rng.range_i32(-20, 20), rng.range_i32(-20, 9)));","     }","     for (g, b) in cases {","+        let whole = vec![Op::Driver(g, b)];","         let composed = vec![","             Op::PrintLine(b\"Calling good()...\".to_vec()),","             Op::Good(g),"]},{"oldStart":385,"oldLines":16,"newStart":438,"newLines":16,"lines":["             Op::PrintLine(b\"Finished bad()\".to_vec()),","         ];","         for lib in [c_lib(), rust_lib()] {","-            let whole = capture_inproc(|| run_op(lib, &Op::Driver(g, b)));","-            let parts = transcript(lib, &composed);","+            let a = output(lib, &whole[0]);","+            let parts = outputs(lib, &composed).concat();","             assert_eq!(","-                whole,","-                parts,","+                a, parts,","                 \"{} lib: driver({g},{b}) != composition of its parts\",","                 lib.name","             );","         }","-        assert_same(&Op::Driver(g, b));","+        assert_same_batch(&whole);","+        assert_same_batch(&composed);","     }"," }"," "]},{"oldStart":426,"oldLines":6,"newStart":479,"newLines":6,"lines":["                 _ => Op::Driver(rng.next_i32(), rng.range_i32(-20, 9)),","             });","         }","-        assert_same_seq(&ops);","+        assert_same_batch(&ops);","     }"," }"]}],"originalFile":"//! Phase B — valid-path differential tests.\n//!\n//! One test per row of `CONFIGS.md`.  Every test loads BOTH shared objects with\n//! `libloading` and calls them only through their exported C symbols, then\n//! compares the stdout bytes they produce.\n//!\n//! Tests start at the lowest-level entry points (`printLine`, `printIntLine`),\n//! then the mid-level `bad`/`good` (which drives the two `static` helpers), then\n//! the composed `driver` pipeline, then randomised mixed call programs.\n\nmod common;\nuse common::*;\n\n// ---------------------------------------------------------------------------\n// Rows 1–8: printLine (lowest level)\n// ---------------------------------------------------------------------------\n\n/// CONFIGS row 1 — empty string.\n#[test]\nfn cfg_01_print_line_empty() {\n    assert_same(&Op::PrintLine(vec![]));\n}\n\n/// CONFIGS row 2 — every single non-NUL byte value.\n#[test]\nfn cfg_02_print_line_single_byte_all_values() {\n    for b in 1u8..=255 {\n        assert_same(&Op::PrintLine(vec![b]));\n    }\n}\n\n/// CONFIGS row 3 — randomised printable ASCII, length 1..=64.\n#[test]\nfn cfg_03_print_line_random_ascii() {\n    let mut rng = Rng::new(0x5EED_0003);\n    for _ in 0..300 {\n        let len = 1 + (rng.next_u32() % 64) as usize;\n        let s: Vec<u8> = (0..len).map(|_| 0x20 + rng.next_byte() % 0x5f).collect();\n        assert_same(&Op::PrintLine(s));\n    }\n}\n\n/// CONFIGS row 4 — randomised arbitrary non-NUL bytes (invalid UTF-8 included).\n#[test]\nfn cfg_04_print_line_random_bytes() {\n    let mut rng = Rng::new(0x5EED_0004);\n    for _ in 0..300 {\n        let len = 1 + (rng.next_u32() % 256) as usize;\n        let s: Vec<u8> = (0..len)\n            .map(|_| {\n                let b = rng.next_byte();\n                if b == 0 { 1 } else { b }\n            })\n            .collect();\n        assert_same(&Op::PrintLine(s));\n    }\n}\n\n/// CONFIGS row 5 — the payload looks like a printf format string.\n#[test]\nfn cfg_05_print_line_format_specifiers() {\n    for s in [\n        &b\"%s\"[..],\n        b\"%d\",\n        b\"%n\",\n        b\"%%\",\n        b\"%s%s%s%s%s%s%s%s\",\n        b\"%n%n%n%n\",\n        b\"100%% done: %p %x %lf %999999999d\",\n        b\"ERROR: %s is negative.\",\n    ] {\n        assert_same(&Op::PrintLine(s.to_vec()));\n    }\n}\n\n/// CONFIGS row 6 — embedded newlines / CR / tabs.\n#[test]\nfn cfg_06_print_line_embedded_newlines() {\n    for s in [\n        &b\"\\n\"[..],\n        b\"a\\nb\",\n        b\"\\n\\n\\n\",\n        b\"line1\\nline2\\n\",\n        b\"\\r\\n\",\n        b\"tab\\there\",\n        b\"trailing\\n\",\n        b\"\\x0b\\x0c\\x1b[31m\",\n    ] {\n        assert_same(&Op::PrintLine(s.to_vec()));\n    }\n}\n\n/// CONFIGS row 7 — lengths straddling libc's stdout buffer size.\n#[test]\nfn cfg_07_print_line_buffer_boundary_lengths() {\n    for len in [\n        1usize, 2, 63, 64, 127, 128, 511, 512, 1023, 1024, 4095, 4096, 4097, 8190, 8191, 8192,\n        8193, 16384, 65536,\n    ] {\n        let s: Vec<u8> = (0..len).map(|i| b'a' + (i % 26) as u8).collect();\n        assert_same(&Op::PrintLine(s));\n    }\n}\n\n/// CONFIGS row 8 — interior pointer + embedded NUL truncation.\n#[test]\nfn cfg_08_print_line_interior_pointer() {\n    let buf = b\"HEAD\\0TAIL\\0more\\0\".to_vec();\n    for off in [0usize, 1, 4, 5, 9, 10, 14] {\n        assert_same(&Op::PrintLineRaw(buf.clone(), off));\n    }\n    // A long buffer whose NUL is far from the start, addressed from the middle.\n    let mut long = vec![b'z'; 5000];\n    long[4000] = 0;\n    long.push(0);\n    for off in [0usize, 1, 2500, 3999, 4000, 4001] {\n        assert_same(&Op::PrintLineRaw(long.clone(), off));\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Rows 9–11: printIntLine (lowest level)\n// ---------------------------------------------------------------------------\n\n/// CONFIGS row 9 — fixed integer shapes.\n#[test]\nfn cfg_09_print_int_line_fixed_shapes() {\n    for n in [\n        0i32,\n        1,\n        -1,\n        9,\n        -9,\n        10,\n        -10,\n        99999,\n        -99999,\n        i32::MAX,\n        i32::MIN,\n        i32::MIN + 1,\n        i32::MAX - 1,\n    ] {\n        assert_same(&Op::PrintIntLine(n));\n    }\n}\n\n/// CONFIGS row 10 — uniformly random ints across the whole 32-bit range.\n#[test]\nfn cfg_10_print_int_line_random_full_range() {\n    let mut rng = Rng::new(0x5EED_0010);\n    for _ in 0..2000 {\n        assert_same(&Op::PrintIntLine(rng.next_i32()));\n    }\n}\n\n/// CONFIGS row 11 — one value per decimal digit width, both signs.\n#[test]\nfn cfg_11_print_int_line_digit_widths() {\n    let mut v = 1i64;\n    for _ in 0..10 {\n        let n = v.min(i32::MAX as i64) as i32;\n        assert_same(&Op::PrintIntLine(n));\n        assert_same(&Op::PrintIntLine(-n));\n        assert_same(&Op::PrintIntLine(n.wrapping_sub(1)));\n        v *= 10;\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Rows 12–15: bad()\n// ---------------------------------------------------------------------------\n\n/// CONFIGS row 12 — every in-bounds index, exhaustively.\n#[test]\nfn cfg_12_bad_all_in_bounds() {\n    for d in 0..10 {\n        assert_same_forked(&Op::Bad(d));\n        // cross-check against the model of the C source\n        let out = capture_inproc(|| run_op(c_lib(), &Op::Bad(d)));\n        assert_eq!(out, ten_lines(Some(d as usize)));\n    }\n}\n\n/// CONFIGS row 13 — randomised negative `data` (the rejecting branch).\n#[test]\nfn cfg_13_bad_random_negative() {\n    let mut rng = Rng::new(0x5EED_0013);\n    for _ in 0..200 {\n        let d = rng.range_i32(i32::MIN, -1);\n        assert_same(&Op::Bad(d));\n    }\n}\n\n/// CONFIGS row 14 — out-of-bounds sweep 10..=64 (deliberate UB store).\n#[test]\nfn cfg_14_bad_oob_sweep() {\n    for d in 10..=64 {\n        assert_same_stdout_forked(&Op::Bad(d));\n    }\n}\n\n/// CONFIGS row 15 — randomised large out-of-bounds indices (deliberate UB).\n#[test]\nfn cfg_15_bad_oob_random() {\n    let mut rng = Rng::new(0x5EED_0015);\n    for _ in 0..60 {\n        let d = rng.range_i32(10, i32::MAX);\n        assert_same_stdout_forked(&Op::Bad(d));\n    }\n    for d in [10, 11, i32::MAX - 1, i32::MAX] {\n        assert_same_stdout_forked(&Op::Bad(d));\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Rows 16–18: good() (drives the two `static` helpers)\n// ---------------------------------------------------------------------------\n\n/// CONFIGS row 16 — every accepted index, exhaustively.\n#[test]\nfn cfg_16_good_all_in_bounds() {\n    for d in 0..10 {\n        assert_same_forked(&Op::Good(d));\n        let mut expected = ten_lines(Some(7)); // goodG2B, data == 7\n        expected.extend_from_slice(&ten_lines(Some(d as usize))); // goodB2G\n        let out = capture_inproc(|| run_op(c_lib(), &Op::Good(d)));\n        assert_eq!(out, expected);\n    }\n}\n\n/// CONFIGS row 17 — rejected `data` values, fixed and randomised.\n#[test]\nfn cfg_17_good_out_of_range() {\n    for d in [-1, i32::MIN, i32::MIN + 1, 10, 11, 12, 100, i32::MAX - 1, i32::MAX] {\n        assert_same_forked(&Op::Good(d));\n    }\n    let mut rng = Rng::new(0x5EED_0017);\n    for _ in 0..200 {\n        let d = if rng.next_u64() & 1 == 0 {\n            rng.range_i32(i32::MIN, -1)\n        } else {\n            rng.range_i32(10, i32::MAX)\n        };\n        assert_same(&Op::Good(d));\n    }\n}\n\n/// CONFIGS row 18 — randomised over the whole int range (mixes both classes).\n#[test]\nfn cfg_18_good_random_full_range() {\n    let mut rng = Rng::new(0x5EED_0018);\n    for _ in 0..500 {\n        // bias towards the interesting window while still covering everything\n        let d = match rng.next_u64() % 4 {\n            0 => rng.range_i32(-12, 12),\n            1 => rng.range_i32(-1000, 1000),\n            _ => rng.next_i32(),\n        };\n        assert_same(&Op::Good(d));\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Rows 19–22: driver() (composed pipeline)\n// ---------------------------------------------------------------------------\n\nconst GOOD_VALUES: [i32; 8] = [-1, i32::MIN, 0, 1, 7, 9, 10, i32::MAX];\nconst BAD_SAFE_VALUES: [i32; 8] = [-1, i32::MIN, i32::MIN + 1, 0, 1, 5, 7, 9];\n\n/// CONFIGS row 19 — full cross product over the well-defined domain.\n#[test]\nfn cfg_19_driver_cross_product() {\n    for g in GOOD_VALUES {\n        for b in BAD_SAFE_VALUES {\n            assert_same_forked(&Op::Driver(g, b));\n        }\n    }\n}\n\n/// CONFIGS row 20 — cross product with out-of-bounds `badData` (UB store).\n#[test]\nfn cfg_20_driver_cross_product_oob_bad() {\n    for g in GOOD_VALUES {\n        for b in [10, 11, 12, 20, 40, i32::MAX] {\n            assert_same_stdout_forked(&Op::Driver(g, b));\n        }\n    }\n}\n\n/// CONFIGS row 21 — randomised, both arguments in the accepted range.\n#[test]\nfn cfg_21_driver_random_valid() {\n    let mut rng = Rng::new(0x5EED_0021);\n    for _ in 0..200 {\n        let g = rng.range_i32(0, 9);\n        let b = rng.range_i32(0, 9);\n        assert_same(&Op::Driver(g, b));\n    }\n}\n\n/// CONFIGS row 22 — randomised over the whole int range for `goodData`, and over\n/// the non-UB domain for `badData` (`badData >= 10` is covered by row 20 with\n/// stdout-only comparison).\n#[test]\nfn cfg_22_driver_random_full_range() {\n    let mut rng = Rng::new(0x5EED_0022);\n    for _ in 0..300 {\n        let g = match rng.next_u64() % 3 {\n            0 => rng.range_i32(-12, 12),\n            1 => rng.range_i32(-100000, 100000),\n            _ => rng.next_i32(),\n        };\n        let b = match rng.next_u64() % 3 {\n            0 => rng.range_i32(-12, 9),\n            1 => rng.range_i32(i32::MIN, -1),\n            _ => rng.range_i32(0, 9),\n        };\n        assert_same(&Op::Driver(g, b));\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Rows 23–27: sequencing, buffering, statelessness, composition, fuzz\n// ---------------------------------------------------------------------------\n\nfn mixed_sequence() -> Vec<Op> {\n    vec![\n        Op::PrintLine(b\"header\".to_vec()),\n        Op::PrintIntLine(-42),\n        Op::Bad(3),\n        Op::Good(9),\n        Op::PrintLineNull,\n        Op::Bad(-7),\n        Op::Good(-1),\n        Op::PrintIntLine(i32::MIN),\n        Op::Driver(4, 8),\n        Op::PrintLine(b\"footer\".to_vec()),\n    ]\n}\n\n/// CONFIGS row 23 — interleaved calls, one stdout stream, block buffered.\n#[test]\nfn cfg_23_interleaved_sequence_block_buffered() {\n    assert_same_seq(&mixed_sequence());\n}\n\n/// CONFIGS row 24 — the same sequence with stdout unbuffered, in a child\n/// process, comparing termination status as well.\n#[test]\nfn cfg_24_interleaved_sequence_unbuffered() {\n    assert_same_seq_forked(&mixed_sequence());\n}\n\n/// CONFIGS row 25 — no residual state between calls: the same call repeated 50×\n/// must produce 50 identical blocks in both libraries.\n#[test]\nfn cfg_25_repeated_invocation_no_state() {\n    for op in [Op::Bad(5), Op::Good(2), Op::Driver(7, 7), Op::PrintIntLine(123)] {\n        let seq: Vec<Op> = std::iter::repeat_n(op.clone(), 50).collect();\n        assert_same_seq(&seq);\n        // and every repetition is identical to a single invocation\n        let one = capture_inproc(|| run_op(rust_lib(), &op));\n        let many = transcript(rust_lib(), &seq);\n        assert_eq!(many, one.repeat(50), \"state leaked between calls: {}\", op.describe());\n    }\n}\n\n/// CONFIGS row 26 — `driver()` must equal the hand-composed pipeline in *both*\n/// libraries (verifies the composed order of the low-level calls, not just the\n/// convenience wrapper's own output).\n#[test]\nfn cfg_26_driver_equals_composition() {\n    let mut rng = Rng::new(0x5EED_0026);\n    let mut cases: Vec<(i32, i32)> = vec![(7, 3), (-1, -1), (10, 0), (0, 9), (i32::MIN, i32::MIN)];\n    for _ in 0..40 {\n        cases.push((rng.range_i32(-20, 20), rng.range_i32(-20, 9)));\n    }\n    for (g, b) in cases {\n        let composed = vec![\n            Op::PrintLine(b\"Calling good()...\".to_vec()),\n            Op::Good(g),\n            Op::PrintLine(b\"Finished good()\".to_vec()),\n            Op::PrintLine(b\"Calling bad()...\".to_vec()),\n            Op::Bad(b),\n            Op::PrintLine(b\"Finished bad()\".to_vec()),\n        ];\n        for lib in [c_lib(), rust_lib()] {\n            let whole = capture_inproc(|| run_op(lib, &Op::Driver(g, b)));\n            let parts = transcript(lib, &composed);\n            assert_eq!(\n                whole,\n                parts,\n                \"{} lib: driver({g},{b}) != composition of its parts\",\n                lib.name\n            );\n        }\n        assert_same(&Op::Driver(g, b));\n    }\n}\n\n/// CONFIGS row 27 — property-style fuzz: random programs of mixed calls over all\n/// five entry points.\n#[test]\nfn cfg_27_random_call_program() {\n    let mut rng = Rng::new(0x5EED_0027);\n    for _ in 0..150 {\n        let n = 1 + (rng.next_u32() % 12) as usize;\n        let mut ops = Vec::with_capacity(n);\n        for _ in 0..n {\n            ops.push(match rng.next_u64() % 6 {\n                0 => Op::PrintLineNull,\n                1 => {\n                    let len = (rng.next_u32() % 40) as usize;\n                    Op::PrintLine(\n                        (0..len)\n                            .map(|_| {\n                                let b = rng.next_byte();\n                                if b == 0 { b'.' } else { b }\n                            })\n                            .collect(),\n                    )\n                }\n                2 => Op::PrintIntLine(rng.next_i32()),\n                3 => Op::Bad(rng.range_i32(i32::MIN, 9)),\n                4 => Op::Good(rng.next_i32()),\n                _ => Op::Driver(rng.next_i32(), rng.range_i32(-20, 9)),\n            });\n        }\n        assert_same_seq(&ops);\n    }\n}\n","userModified":false}}
