);","-        assert!(dup2(out.as_raw_fd(), 1) >= 0, \"dup2 failed\");","-        f();","-        fflush(std::ptr::null_mut());","-        assert!(dup2(saved, 1) >= 0, \"restore dup2 failed\");","-        close(saved);","-        drop(out);","-        std::fs::read(&path).expect(\"read temp file\")","-    };","-    let _ = std::fs::remove_file(&path);","-    bytes","+/// stdout buffering mode used inside the child.","+#[derive(Copy, Clone, Debug, PartialEq, Eq)]","+pub enum Buffering {","+    /// libc default for a regular file: fully buffered.","+    Block,","+    /// `setvbuf(stdout, NULL, _IONBF, 0)`.","+    Unbuffered,"," }"," ","-/// How a forked child terminated.","+/// How a child terminated."," #[derive(Clone, Debug, PartialEq, Eq)]"," pub enum Exit {","     Code(i32),","     Signal(i32),"," }"," ","-#[derive(Clone, Debug, PartialEq, Eq)]","-pub struct ForkResult {","-    pub stdout: Vec<u8>,","+/// Result of running a batch of calls against one library in one child process.","+#[derive(Clone, Debug)]","+pub struct BatchResult {","+    /// Bytes produced by each call that ran to completion.","+    pub outputs: Vec<Vec<u8>>,","+    /// Bytes produced after the last completed call (non-empty only if the child","+    /// died in the middle of a call).","+    pub partial: Vec<u8>,","+    /// The whole stdout stream.","+    pub full: Vec<u8>,","     pub exit: Exit,"," }"," ","-/// Run `f` in a forked child with fd 1 redirected to a temp file and libc","-/// `stdout` unbuffered, so a crash cannot lose already-produced output nor kill","-/// the test process.","-pub fn capture_forked<F: FnOnce()>(f: F) -> ForkResult {","-    let _g = CAPTURE_LOCK.lock().unwrap();","-    let path = temp_path(\"fk\");","-    let out = std::fs::File::create(&path).expect(\"create temp file\");","-    let fd = out.as_raw_fd();","+impl BatchResult {","+    pub fn completed(&self) -> usize {","+        self.outputs.len()","+    }","+}","+","+/// Run every op in `ops` against `d` inside a