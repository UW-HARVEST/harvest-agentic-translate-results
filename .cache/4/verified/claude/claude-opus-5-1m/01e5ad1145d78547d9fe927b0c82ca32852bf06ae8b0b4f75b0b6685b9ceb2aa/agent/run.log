ollect();\n        assert_same(&Op::PrintLine(s));\n    }\n}\n\n/// CONFIGS row 4 — randomised arbitrary non-NUL bytes (invalid UTF-8 included).\n#[test]\nfn cfg_04_print_line_random_bytes() {\n    let mut rng = Rng::new(0x5EED_0004);\n    for _ in 0..300 {\n        let len = 1 + (rng.next_u32() % 256) as usize;\n        let s: Vec<u8> = (0..len)\n            .map(|_| {\n                let b = rng.next_byte();\n                if b == 0 { 1 } else { b }\n            })\n            .collect();\n        assert_same(&Op::PrintLine(s));\n    }\n}\n\n/// CONFIGS row 5 — the payload looks like a printf format string.\n#[test]\nfn cfg_05_print_line_format_specifiers() {\n    for s in [\n        &b\"%s\"[..],\n        b\"%d\",\n        b\"%n\",\n        b\"%%\",\n        b\"%s%s%s%s%s%s%s%s\",\n        b\"%n%n%n%n\",\n        b\"100%% done: %p %x %lf %999999999d\",\n        b\"ERROR: %s is negative.\",\n    ] {\n        assert_same(&Op::PrintLine(s.to_vec()));\n    }\n}\n\n/// CONFIGS row 6 — embedded newlines / CR / tabs.\n#[test]\nfn cfg_06_print_line_embedded_newlines() {\n    for s in [\n        &b\"\\n\"[..],\n        b\"a\\nb\",\n        b\"\\n\\n\\n\",\n        b\"line1\\nline2\\n\",\n        b\"\\r\\n\",\n        b\"tab\\there\",\n        b\"trailing\\n\",\n        b\"\\x0b\\x0c\\x1b[31m\",\n    ] {\n        assert_same(&Op::PrintLine(s.to_vec()));\n    }\n}\n\n/// CONFIGS row 7 — lengths straddling libc's stdout buffer size.\n#[test]\nfn cfg_07_print_line_buffer_boundary_lengths() {\n    for len in [\n        1usize, 2, 63, 64, 127, 128, 511, 512, 1023, 1024, 4095, 4096, 4097, 8190, 8191, 8192,\n        8193, 16384, 65536,\n    ] {\n        let s: Vec<u8> = (0..len).map(|i| b'a' + (i % 26) as u8).collect();\n        assert_same(&Op::PrintLine(s));\n    }\n}\n\n/// CONFIGS row 8 — interior pointer + embedded NUL truncation.\n#[test]\nfn cfg_08_print_line_interior_pointer() {\n    let buf = b\"HEAD\\0TAIL\\0more\\0\".to_vec();\n    for off in [0usize, 1, 4, 5, 9, 10, 14] {\n        assert_same(&Op::PrintLineRaw(buf.clone(), off));\n    }\n    // A long buffer whose NUL is far from the start, addressed from the middle.\n    let mut long = vec![b'z'; 5000];\n    long[4000] = 0;\n    long.push(0);\n    for off in [0usize, 1, 2500, 3999, 4000, 4001] {\n        assert_same(&Op::PrintLineRaw(long.clone(), off));\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Rows 9–11: printIntLine (lowest level)\n// ---------------------------------------------------------------------------\n\n/// CONFIGS row 9 — fixed integer shapes.\n#[test]\nfn cfg_09_print_int_line_fixed_shapes() {\n    for n in [\n        0i32,\n        1,\n        -1,\n        9,\n        -9,\n        10,\n        -10,\n        99999,\n        -99999,\n        i32::MAX,\n        i32::MIN,\n        i32::MIN + 1,\n        i32::MAX - 1,\n    ] {\n        assert_same(&Op::PrintIntLine(n));\n    }\n}\n\n/// CONFIGS row 10 — uniformly random ints across the whole 32-bit range.\n#[test]\nfn cfg_10_print_int_line_random_full_range() {\n    let mut rng = Rng::new(0x5EED_0010);\n    for _ in 0..2000 {\n        assert_same(&Op::PrintIntLine(rng.next_i32()));\n    }\n}\n\n/// CONFIGS row 11 — one value per decimal digit width, both signs.\n#[test]\nfn cfg_11_print_int_line_digit_widths() {\n    let mut v = 1i64;\n    for _ in 0..10 {\n        let n = v.min(i32::MAX as i64) as i32;\n        assert_same(&Op::PrintIntLine(n));\n        assert_same(&Op::PrintIntLine(-n));\n        assert_same(&Op::PrintIntLine(n.wrapping_sub(1)));\n        v *= 10;\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Rows 12–15: bad()\n// ---------------------------------------------------------------------------\n\n/// CONFIGS row 12 — every in-bounds index, exhaustively.\n#[test]\nfn cfg_12_bad_all_in_bounds() {\n    for d in 0..10 {\n        assert_same_forked(&Op::Bad(d));\n        // cross-check against the model of the C source\n        let out = capture_inproc(|| run_op(c_lib(), &Op::Bad(d)));\n        assert_eq!(out, ten_lines(Some(d as usize)));\n    }\n}\n\n/// CONFIGS row 13 — randomised negative `data` (the rejecting branch).\n#[test]\nfn cfg_13_bad_random_negative() {\n    let mut rng = Rng::new(0x5EED_0013);\n    for _ in 0..200 {\n        let d = rng.range_i32(i32::MIN, -1);\n        assert_same(&Op::Bad(d));\n    }\n}\n\n/// CONFIGS row 14 — out-of-bounds sweep 10..=64 (deliberate UB store).\n#[test]\nfn cfg_14_bad_oob_sweep() {\n    for d in 10..=64 {\n        assert_same_stdout_forked(&Op::Bad(d));\n    }\n}\n\n/// CONFIGS row 15 — randomised large out-of-bounds indices (deliberate UB).\n#[test]\nfn cfg_15_bad_oob_random() {\n    let mut rng = Rng::new(0x5EED_0015);\n    for _ in 0..60 {\n        let d = rng.range_i32(10, i32::MAX);\n        assert_same_stdout_forked(&Op::Bad(d));\n    }\n    for d in [10, 11, i32::MAX - 1, i32::MAX] {\n        assert_same_stdout_forked(&Op::Bad(d));\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Rows 16–18: good() (drives the two `static` helpers)\n// ---------------------------------------------------------------------------\n\n/// CONFIGS row 16 — every accepted index, exhaustively.\n#[test]\nfn cfg_16_good_all_in_bounds() {\n    for d in 0..10 {\n        assert_same_forked(&Op::Good(d));\n        let mut expected = ten_lines(Some(7)); // goodG2B, data == 7\n        expected.extend_from_slice(&ten_lines(Some(d as usize))); // goodB2G\n        let out = capture_inproc(|| run_op(c_lib(), &Op::Good(d)));\n        assert_eq!(out, expected);\n    }\n}\n\n/// CONFIGS row 17 — rejected `data` values, fixed and randomised.\n#[test]\nfn cfg_17_good_out_of_range() {\n    for d in [-1, i32::MIN, i32::MIN + 1, 10, 11, 12, 100, i32::MAX - 1, i32::MAX] {\n        assert_same_forked(&Op::Good(d));\n    }\n    let mut rng = Rng::new(0x5EED_0017);\n    for _ in 0..200 {\n        let d = if rng.next_u64() & 1 == 0 {\n            rng.range_i32(i32::MIN, -1)\n        } else {\n            rng.range_i32(10, i32::MAX)\n        };\n        assert_same(&Op::Good(d));\n    }\n}\n\n/// CONFIGS row 18 — randomised over the whole int range (mixes both classes).\n#[test]\nfn cfg_18_good_random_full_range() {\n    let mut rng = Rng::new(0x5EED_0018);\n    for _ in 0..500 {\n        // bias towards the interesting window while still covering everything\n        let d = match rng.next_u64() % 4 {\n            0 => rng.range_i32(-12, 12),\n            1 => rng.range_i32(-1000, 1000),\n            _ => rng.next_i32(),\n        };\n        assert_same(&Op::Good(d));\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Rows 19–22: driver() (composed pipeline)\n// ---------------------------------------------------------------------------\n\nconst GOOD_VALUES: [i32; 8] = [-1, i32::MIN, 0, 1, 7, 9, 10, i32::MAX];\nconst BAD_SAFE_VALUES: [i32; 8] = [-1, i32::MIN, i32::MIN + 1, 0, 1, 5, 7, 9];\n\n/// CONFIGS row 19 — full cross product over the well-defined domain.\n#[test]\nfn cfg_19_driver_cross_product() {\n    for g in GOOD_VALUES {\n        for b in BAD_SAFE_VALUES {\n            assert_same_forked(&Op::Driver(g, b));\n        }\n    }\n}\n\n/// CONFIGS row 20 — cross product with out-of-bounds `badData` (UB store).\n#[test]\nfn cfg_20_driver_cross_product_oob_bad() {\n    for g in GOOD_VALUES {\n        for b in [10, 11, 12, 20, 40, i32::MAX] {\n            assert_same_stdout_forked(&Op::Driver(g, b));\n        }\n    }\n}\n\n/// CONFIGS row 21 — randomised, both arguments in the accepted range.\n#[test]\nfn cfg_21_driver_random_valid() {\n    let mut rng = Rng::new(0x5EED_0021);\n    for _ in 0..200 {\n        let g = rng.range_i32(0, 9);\n        let b = rng.range_i32(0, 9);\n        assert_same(&Op::Driver(g, b));\n    }\n}\n\n/// CONFIGS row 22 — randomised over the whole int range for `goodData`, and over\n/// the non-UB domain for `badData` (`badData >= 10` is covered by row 20 with\n/// stdout-only comparison).\n#[test]\nfn cfg_22_driver_random_full_range() {\n    let mut rng = Rng::new(0x5EED_0022);\n    for _ in 0..300 {\n        let g = match rng.next_u64() % 3 {\n            0 => rng.range_i32(-12, 12),\n            1 => rng.range_i32(-100000, 100000),\n            _ => rng.next_i32(),\n        };\n        let b = match rng.next_u64() % 3 {\n            0 => rng.range_i32(-12, 9),\n            1 => rng.range_i32(i32::MIN, -1),\n            _ => rng.range_i32(0, 9),\n        };\n        assert_same(&Op::Driver(g, b));\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Rows 23–27: sequencing, buffering, statelessness, composition, fuzz\n// ---------------------------------------------------------------------------\n\nfn mixed_sequence() -> Vec<Op> {\n    vec![\n        Op::PrintLine(b\"header\".to_vec()),\n        Op::PrintIntLine(-42),\n        Op::Bad(3),\n        Op::Good(9),\n        Op::PrintLineNull,\n        Op::Bad(-7),\n        Op::Good(-1),\n        Op::PrintIntLine(i32::MIN),\n        Op::Driver(4, 8),\n        Op::PrintLine(b\"footer\".to_vec()),\n    ]\n}\n\n/// CONFIGS row 23 — interleaved calls, one stdout stream, block buffered.\n#[test]\nfn cfg_23_interleaved_sequence_block_buffered() {\n    assert_same_seq(&mixed_sequence());\n}\n\n/// CONFIGS row 24 — the same sequence with stdout unbuffered, in a child\n/// process, comparing termination status as well.\n#[test]\nfn cfg_24_interleaved_sequence_unbuffered() {\n    assert_same_seq_forked(&mixed_sequence());\n}\n\n/// CONFIGS row 25 — no residual state between calls: the same call repeated 50×\n/// must produce 50 identical blocks in both libraries.\n#[test]\nfn cfg_25_repeated_invocation_no_state() {\n    for op in [Op::Bad(5), Op::Good(2), Op::Driver(7, 7), Op::PrintIntLine(123)] {\n        let seq: Vec<Op> = std::iter::repeat_n(op.clone(), 50).collect();\n        assert_same_seq(&seq);\n        // and every repetition is identical to a single invocation\n        let one = capture_inproc(|| run_op(rust_lib(), &op));\n        let many = transcript(rust_lib(), &seq);\n        assert_eq!(many, one.repeat(50), \"state leaked between calls: {}\", op.describe());\n    }\n}\n\n/// CONFIGS row 26 — `driver()` must equal the hand-composed pipeline in *both*\n/// libraries (verifies the composed order of the low-level calls, not just the\n/// convenience wrapper's own output).\n#[test]\nfn cfg_26_driver_equals_composition() {\n    let mut rng = Rng::new(0x5EED_0026);\n    let mut cases: Vec<(i32, i32)> = vec![(7, 3), (-1, -1), (10, 0), (0, 9), (i32::MIN, i32::MIN)];\n    for _ in 0..40 {\n        cases.push((rng.range_i32(-20, 20), rng.range_i32(-20, 9)));\n    }\n    for (g, b) in cases {\n        let composed = vec![\n            Op::PrintLine(b\"Calling good()...\".to_vec()),\n            Op::Good(g),\n            Op::PrintLine(b\"Finished good()\".to_vec()),\n            Op::PrintLine(b\"Calling bad()...\".to_vec()),\n            Op::Bad(b),\n            Op::PrintLine(b\"Finished bad()\".to_vec()),\n        ];\n        for lib in [c_lib(), rust_lib()] {\n            let whole = capture_inproc(|| run_op(lib, &Op::Driver(g, b)));\n            let parts = transcript(lib, &composed);\n            assert_eq!(\n                whole,\n                parts,\n                \"{} lib: driver({g},{b}) != composition of its parts\",\n                lib.name\n            );\n        }\n        assert_same(&Op::Driver(g, b));\n    }\n}\n\n/// CONFIGS row 27 — property-style fuzz: random programs of mixed calls over all\n/// five entry points.\n#[test]\nfn cfg_27_random_call_program() {\n    let mut rng = Rng::new(0x5EED_0027);\n    for _ in 0..150 {\n        let n = 1 + (rng.next_u32() % 12) as usize;\n        let mut ops = Vec::with_capacity(n);\n        for _ in 0..n {\n            ops.push(match rng.next_u64() % 6 {\n                0 => Op::PrintLineNull,\n                1 => {\n                    let len = (rng.next_u32() % 40) as usize;\n                    Op::PrintLine(\n                        (0..len)\n                            .map(|_| {\n                                let b = rng.next_byte();\n                                if b == 0 { b'.' } else { b }\n                            })\n                            .collect(),\n                    )\n                }\n                2 => Op::PrintIntLine(rng.next_i32()),\n                3 => Op::Bad(rng.range_i32(i32::MIN, 9)),\n                4 => Op::Good(rng.next_i32()),\n                _ => Op::Driver(rng.next_i32(), rng.range_i32(-20, 9)),\n            });\n        }\n        assert_same_seq(&ops);\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_4fqqil2ln2ttkkp3t3tz7fo222lmhym5yd23iunsxgip4igza2kq","type":"message","role":"assistant","content":[{"type":"text","text":"Now the Phase C error-path tests:"}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6403,"cache_read_input_tokens":67672,"cache_creation":{"ephemeral_5m_input_tokens":6403,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"0af81b2f-19bc-46ab-9c71-7e73412f8759","uuid":"bc913766-c691-4137-8a60-a845835d8963","timestamp":"2026-08-18T00:24:32.287Z"}
{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_4fqqil2ln2ttkkp3t3tz7fo222lmhym5yd23iunsxgip4igza2kq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01QShbTWcxBpyyeY8wsdNWca","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-Nxrkg1/translated_rust/tests/error_paths.rs","content":"//! Phase C — error-path differential tests.\n//!\n//! One test per row of `ERRORS.md`.  Every function in this C library is `void`\n//! and there is no `errno`/error-code/enum, so \"the same error/rejection\" means\n//! \"the same rejection message bytes on stdout and nothing else\", which is what\n//! each test asserts — against the C `.so`, against the Rust `.so`, and against\n//! the message text taken verbatim from `c_src/src/driver.c`.\n\nmod common;\nuse common::*;\n\n/// ERRORS row 1 — `printLine(NULL)`: `if(line != NULL)` fails ⇒ nothing at all.\n#[test]\nfn err_01_print_line_null() {\n    assert_same_forked(&Op::PrintLineNull);\n    for lib in [c_lib(), rust_lib()] {\n        let out = capture_inproc(|| run_op(lib, &Op::PrintLineNull));\n        assert!(\n            out.is_empty(),\n            \"{} lib printed {:?} for printLine(NULL)\",\n            lib.name,\n            String::from_utf8_lossy(&out)\n        );\n    }\n}\n\n/// ERRORS row 2 — `bad(-1)` ⇒ \"ERROR: Array index is negative.\".\n#[test]\nfn err_02_bad_negative_one() {\n    assert_same_forked(&Op::Bad(-1));\n    for lib in [c_lib(), rust_lib()] {\n        let out = capture_inproc(|| run_op(lib, &Op::Bad(-1)));\n        assert_eq!(out, ERR_NEGATIVE, \"{} lib\", lib.name);\n    }\n}\n\n/// ERRORS row 3 — `bad(INT_MIN)`.\n#[test]\nfn err_03_bad_int_min() {\n    assert_same_forked(&Op::Bad(i32::MIN));\n    for lib in [c_lib(), rust_lib()] {\n        let out = capture_inproc(|| run_op(lib, &Op::Bad(i32::MIN)));\n        assert_eq!(out, ERR_NEGATIVE, \"{} lib\", lib.name);\n    }\n}\n\n/// ERRORS row 4 — randomised negative `data`, 200 values.\n#[test]\nfn err_04_bad_negative_random() {\n    let mut rng = Rng::new(0xE770_0004);\n    let mut values = vec![-1, -2, -10, i32::MIN, i32::MIN + 1, -1000000];\n    for _ in 0..200 {\n        values.push(rng.range_i32(i32::MIN, -1));\n    }\n    for d in values {\n        assert_same(&Op::Bad(d));\n        let out = capture_inproc(|| run_op(rust_lib(), &Op::Bad(d)));\n        assert_eq!(out, ERR_NEGATIVE, \"bad({d})\");\n    }\n}\n\n/// ERRORS row 5 — `data >= 10` is *not* rejected (the injected flaw): the store\n/// is out of bounds, yet the ten in-bounds elements are still printed unchanged.\n#[test]\nfn err_05_bad_oob_not_rejected() {\n    for d in [10, 11, 13, 16, 20, 33, 64, 1000] {\n        let (c, r) = diff_forked(&Op::Bad(d));\n        assert_eq!(\n            c.stdout,\n            ten_lines(None),\n            \"C lib: bad({d}) should print ten zeros (OOB store misses the array)\"\n        );\n        assert_eq!(\n            r.stdout, c.stdout,\n            \"Rust lib diverged from C for bad({d})\"\n        );\n        assert!(\n            !c.stdout.starts_with(ERR_NEGATIVE),\n            \"C lib must NOT reject bad({d})\"\n        );\n    }\n}\n\n/// ERRORS row 6 — `bad(10)`, the very first out-of-range index.\n#[test]\nfn err_06_bad_oob_first() {\n    assert_same_stdout_forked(&Op::Bad(10));\n    let (c, _) = diff_forked(&Op::Bad(10));\n    assert_eq!(c.stdout, ten_lines(None));\n}\n\n/// ERRORS row 7 — `bad(INT_MAX)`: accepted by `data >= 0`, store far off-stack.\n#[test]\nfn err_07_bad_int_max() {\n    assert_same_stdout_forked(&Op::Bad(i32::MAX));\n    assert_same_stdout_forked(&Op::Bad(i32::MAX - 1));\n}\n\n/// ERRORS row 8 — `good(-1)` ⇒ goodG2B block + \"out-of-bounds\" message.\n#[test]\nfn err_08_good_negative() {\n    assert_same_forked(&Op::Good(-1));\n    let mut expected = ten_lines(Some(7));\n    expected.extend_from_slice(ERR_OOB);\n    for lib in [c_lib(), rust_lib()] {\n        let out = capture_inproc(|| run_op(lib, &Op::Good(-1)));\n        assert_eq!(out, expected, \"{} lib\", lib.name);\n    }\n}\n\n/// ERRORS row 9 — `good(INT_MIN)`.\n#[test]\nfn err_09_good_int_min() {\n    assert_same_forked(&Op::Good(i32::MIN));\n    let mut expected = ten_lines(Some(7));\n    expected.extend_from_slice(ERR_OOB);\n    for lib in [c_lib(), rust_lib()] {\n        let out = capture_inproc(|| run_op(lib, &Op::Good(i32::MIN)));\n        assert_eq!(out, expected, \"{} lib\", lib.name);\n    }\n}\n\n/// ERRORS row 10 — `good(10)`: first value failing `data < (10)`.\n#[test]\nfn err_10_good_ten() {\n    assert_same_forked(&Op::Good(10));\n    let mut expected = ten_lines(Some(7));\n    expected.extend_from_slice(ERR_OOB);\n    for lib in [c_lib(), rust_lib()] {\n        let out = capture_inproc(|| run_op(lib, &Op::Good(10)));\n        assert_eq!(out, expected, \"{} lib\", lib.name);\n    }\n    // one step inside the range is accepted, one step outside is rejected\n    for lib in [c_lib(), rust_lib()] {\n        let inside = capture_inproc(|| run_op(lib, &Op::Good(9)));\n        assert!(!inside.ends_with(ERR_OOB), \"{} lib rejected good(9)\", lib.name);\n    }\n}\n\n/// ERRORS row 11 — `good(INT_MAX)`.\n#[test]\nfn err_11_good_int_max() {\n    assert_same_forked(&Op::Good(i32::MAX));\n    let mut expected = ten_lines(Some(7));\n    expected.extend_from_slice(ERR_OOB);\n    for lib in [c_lib(), rust_lib()] {\n        let out = capture_inproc(|| run_op(lib, &Op::Good(i32::MAX)));\n        assert_eq!(out, expected, \"{} lib\", lib.name);\n    }\n}\n\n/// ERRORS row 12 — randomised out-of-range `data` for `goodB2G`, 200 values.\n#[test]\nfn err_12_good_out_of_range_random() {\n    let mut rng = Rng::new(0xE770_0012);\n    let mut expected = ten_lines(Some(7));\n    expected.extend_from_slice(ERR_OOB);\n    for i in 0..200 {\n        let d = if i % 2 == 0 {\n            rng.range_i32(i32::MIN, -1)\n        } else {\n            rng.range_i32(10, i32::MAX)\n        };\n        assert_same(&Op::Good(d));\n        let out = capture_inproc(|| run_op(rust_lib(), &Op::Good(d)));\n        assert_eq!(out, expected, \"good({d})\");\n    }\n}\n\n/// ERRORS row 13 — `good(9)` is the last accepted value.\n#[test]\nfn err_13_good_nine_accepted() {\n    assert_same_forked(&Op::Good(9));\n    let mut expected = ten_lines(Some(7));\n    expected.extend_from_slice(&ten_lines(Some(9)));\n    for lib in [c_lib(), rust_lib()] {\n        let out = capture_inproc(|| run_op(lib, &Op::Good(9)));\n        assert_eq!(out, expected, \"{} lib\", lib.name);\n    }\n}\n\n/// ERRORS row 14 — `good(0)` is the lower boundary and is accepted.\n#[test]\nfn err_14_good_zero_accepted() {\n    assert_same_forked(&Op::Good(0));\n    let mut expected = ten_lines(Some(7));\n    expected.extend_from_slice(&ten_lines(Some(0)));\n    for lib in [c_lib(), rust_lib()] {\n        let out = capture_inproc(|| run_op(lib, &Op::Good(0)));\n        assert_eq!(out, expected, \"{} lib\", lib.name);\n    }\n}\n\n/// ERRORS row 15 — `bad(0)` / `bad(9)`: the boundaries the missing upper-bound\n/// check would have used are accepted and in bounds.\n#[test]\nfn err_15_bad_boundaries_accepted() {\n    for (d, idx) in [(0i32, 0usize), (9, 9)] {\n        assert_same_forked(&Op::Bad(d));\n        for lib in [c_lib(), rust_lib()] {\n            let out = capture_inproc(|| run_op(lib, &Op::Bad(d)));\n            assert_eq!(out, ten_lines(Some(idx)), \"{} lib bad({d})\", lib.name);\n        }\n    }\n}\n\n/// ERRORS row 16 — `goodG2B`'s \"negative\" branch is unreachable (`data` == 7), so\n/// neither library may ever print that message from `good`/`driver`.\n#[test]\nfn err_16_goodg2b_error_branch_unreachable() {\n    let mut rng = Rng::new(0xE770_0016);\n    let mut values = vec![-1, 0, 7, 9, 10, i32::MIN, i32::MAX];\n    for _ in 0..100 {\n        values.push(rng.next_i32());\n    }\n    for d in values {\n        for lib in [c_lib(), rust_lib()] {\n            let out = capture_inproc(|| run_op(lib, &Op::Good(d)));\n       