       for (int j = 0; j < w; ++j) {\n55\t///             cp_pixel_t t = *a;\n56\t///             *a = *b;\n57\t///             *b = t;\n58\t///             ++a;\n59\t///             ++b;\n60\t///         }\n61\t///     }\n62\t/// }\n63\t/// ```\n64\t#[unsafe(no_mangle)]\n65\tpub unsafe extern \"C\" fn flip_horizontal(img: *mut cp_image_t) {\n66\t    // The C code unconditionally dereferences `img`; no NULL check is added.\n67\t    let pix: *mut cp_pixel_t = unsafe { (*img).pix };\n68\t    let w: c_int = unsafe { (*img).w };\n69\t    let h: c_int = unsafe { (*img).h };\n70\t\n71\t    // C integer division truncates toward zero, as does Rust's `/`.\n72\t    let flips: c_int = h / 2;\n73\t\n74\t    let mut i: c_int = 0;\n75\t    while i < flips {\n76\t        let mut a: *mut cp_pixel_t = unsafe { pix.offset(elem_offset(w, i)) };\n77\t        let mut b: *mut cp_pixel_t =\n78\t            unsafe { pix.offset(elem_offset(w, h.wrapping_sub(i).wrapping_sub(1))) };\n79\t\n80\t        let mut j: c_int = 0;\n81\t        while j < w {\n82\t            // Copy-through swap, matching the C temporary exactly (and\n83\t            // therefore also matching its behaviour should `a == b`).\n84\t            unsafe {\n85\t                let t: cp_pixel_t = a.read();\n86\t                a.write(b.read());\n87\t                b.write(t);\n88\t                a = a.add(1);\n89\t                b = b.add(1);\n90\t            }\n91\t            j += 1;\n92\t        }\n93\t\n94\t        i += 1;\n95\t    }\n96\t}\n97\t"}]},"parent_tool_use_id":null,"session_id":"c6b563dc-7211-46b6-8fa6-c3286c140108","uuid":"08b3e5b2-02b4-46e4-9b41-353f5568c093","timestamp":"2026-08-19T11:58:46.138Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-cmxSNS/translated_rust/src/lib.rs","content":"//! Rust translation of the C library in `c_src/`.\n//!\n//! Public ABI (from `nm -D` on the C shared object):\n//!   * `flip_horizontal`\n//!\n//! Behaviour is re