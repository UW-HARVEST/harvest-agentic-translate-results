duced `os_version` — pipeline state carried across entry points | [x] |\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6271,"cache_read_input_tokens":39597,"cache_creation":{"ephemeral_5m_input_tokens":6271,"ephemeral_1h_input_tokens":0},"output_tokens":20,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"4da87fc6-9527-451e-a988-a5d3a3a9961a","uuid":"abfeee39-4028-4f70-a450-293d275a0f92","timestamp":"2026-08-20T12:30:18.927Z"}
