{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01PCMPjRsJX9KjJi2W9qJpMm","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/`.\n2\t//!\n3\t//! The library exposes three public symbols (as verified with `nm -D` on the C\n4\t//! shared object):\n5\t//!\n6\t//! ```text\n7\t//! T get_os_arch\n8\t//! T w_regexec\n9\t//! T parse_uname_string\n10\t//! ```\n11\t//!\n12\t//! The translation is byte-for-byte behaviour preserving: it performs the very\n13\t//! same in-place mutations on the caller supplied buffers, allocates its result\n14\t//! strings with the platform `malloc`/`strdup` (so the caller can `free()`\n15\t//! them), and uses the very same POSIX regular expression engine (glibc\n16\t//! `regcomp`/`regexec`) as the original code. Buggy behaviour of the original\n17\t//! implementation (such as writing a NUL byte one octet *before* the start of\n18\t//! an empty string) is faithfully reproduced instead of being fixed.\n19\t\n20\t#![allow(non_camel_case_types)]\n21\t#![allow(non_snake_case)]\n22\t\n23\tuse core::ffi::{c_char, c_int, c_void, CStr};\n24\tuse core::mem::MaybeUninit;\n25\t\n26\t// ---------------------------------------------------------------------------\n27\t// libc / POSIX declarations\n28\t// ---------------------------------------------------------------------------\n29\t\n30\t/// Opaque stand-in for `FILE`.\n31\tpub type FILE = c_void;\n32\t\n33\t/// POSIX `regoff_t` (a plain `int` in glibc).\n34\tpub type regoff_t = c_int;\n35\t\n36\t/// POSIX `regmatch_t`, layout compatible with `<regex.h>`.\n37\t#[repr(C)]\n38\t#[derive(Clone, Copy)]\n39\tpub struct regmatch_t {\n40\t    pub rm_so: regoff_t,\n41\t    pub rm_eo: regoff_t,\n42\t}\n43\t\n44\t/// Opaque, over-sized stand-in for `regex_t`.\n45\t///\n46\t/// glibc's `regex_t` is 64 bytes with an alignment of 8; the buffer below is\n47\t/// deliberately larger so that the storage is always sufficient, regardless of\n48\t/// the C library in use. `regcomp()` only ever touches `sizeof(regex_t)` bytes.\n49\t#[repr(C, align(16))]\n50\tstruct regex_t {\n51\t    _opaque: [u8; 256],\n52\t}\n53\t\n54\t/// `REG_EXTENDED` from `<regex.h>`.\n55\tconst REG_EXTENDED: c_int = 1;\n56\t\n57\textern \"C\" {\n58\t    static mut stderr: *mut FILE;\n59\t\n60\t    fn fprintf(stream: *mut FILE, format: *const c_char, ...) -> c_int;\n61\t    fn snprintf(s: *mut c_char, n: usize, format: *const c_char, ...) -> c_int;\n62\t\n63\t    fn malloc(size: usize) -> *mut c_void;\n64\t    fn free(ptr: *mut c_void);\n65\t    fn strdup(s: *const c_char) -> *mut c_char;\n66\t    fn strlen(s: *const c_char) -> usize;\n67\t    fn strstr(haystack: *const c_char, needle: *const c_char) -> *mut c_char;\n68\t\n69\t    fn regcomp(preg: *mut regex_t, pattern: *const c_char, cflags: c_int) -> c_int;\n70\t    fn regexec(\n71\t        preg: *const regex_t,\n72\t        string: *const c_char,\n73\t        nmatch: usize,\n74\t        pmatch: *mut regmatch_t,\n75\t        eflags: c_int,\n76\t    ) -> c_int;\n77\t    fn regfree(preg: *mut regex_t);\n78\t}\n79\t\n80\t// ---------------------------------------------------------------------------\n81\t// Public types\n82\t// ---------------------------------------------------------------------------\n83\t\n84\t/// Mirrors `os_data` from `include/lib.h`.\n85\t#[repr(C)]\n86\tpub struct os_data {\n87\t    pub os_name: *mut c_char,\n88\t    pub os_version: *mut c_char,\n89\t    pub os_major: *mut c_char,\n90\t    pub os_minor: *mut c_char,\n91\t    pub os_codename: *mut c_char,\n92\t    pub os_platform: *mut c_char,\n93\t    pub os_build: *mut c_char,\n94\t    pub os_uname: *mut c_char,\n95\t    pub os_arch: *mut c_char,\n96\t}\n97\t\n98\t// ---------------------------------------------------------------------------\n99\t// Helpers that mirror the C pointer idioms\n100\t// ---------------------------------------------------------------------------\n101\t\n102\t/// `*(s + strlen(s) - 1) = '\\0';`\n103\t///\n104\t/// Note that the original C code performs this unconditionally, so for an empty\n105\t/// string the NUL byte is written *one byte before* the buffer. That exact\n106\t/// (out-of-bounds) behaviour is reproduced here on purpose.\n107\t#[inline]\n108\tunsafe fn strip_last_char(s: *mut c_char) {\n109\t    let len = strlen(s);\n110\t    *s.wrapping_offset(len as isize).wrapping_offset(-1) = 0;\n111\t}\n112\t\n113\t/// `dst = malloc(n + 1); snprintf(dst, n + 1, \"%.*s\", n, src);`\n114\t#[inline]\n115\tunsafe fn dup_match(match_size: c_int, src: *const c_char) -> *mut c_char {\n116\t    let buf = malloc((match_size + 1) as usize) as *mut c_char;\n117\t    snprintf(\n118\t        buf,\n119\t        (match_size + 1) as usize,\n120\t        c\"%.*s\".as_ptr(),\n121\t        match_size,\n122\t        src,\n123\t    );\n124\t    buf\n125\t}\n126\t\n127\t// ---------------------------------------------------------------------------\n128\t// get_os_arch\n129\t// ---------------------------------------------------------------------------\n130\t\n131\t/// Architectures recognised by [`get_os_arch`], in the exact order of the C\n132\t/// `ARCHS` table (the trailing `NULL` sentinel is implicit here).\n133\tconst ARCHS: [&CStr; 12] = [\n134\t    c\"x86_64\",\n135\t    c\"i386\",\n136\t    c\"i686\",\n137\t    c\"sparc\",\n138\t    c\"amd64\",\n139\t    c\"i86pc\",\n140\t    c\"ia64\",\n141\t    c\"AIX\",\n142\t    c\"armv6\",\n143\t    c\"armv7\",\n144\t    c\"aarch64\",\n145\t    c\"arm64\",\n146\t];\n147\t\n148\t/// Looks for the OS architecture in a string.\n149\t///\n150\t/// Returns a `strdup`'d copy of the first architecture found (searched in table\n151\t/// order) or `NULL` when none matches. The caller owns the returned memory.\n152\t#[unsafe(no_mangle)]\n153\tpub unsafe extern \"C\" fn get_os_arch(os_header: *mut c_char) -> *mut c_char {\n154\t    let mut os_arch: *mut c_char = core::ptr::null_mut();\n155\t\n156\t    for arch in ARCHS.iter() {\n157\t        if !strs