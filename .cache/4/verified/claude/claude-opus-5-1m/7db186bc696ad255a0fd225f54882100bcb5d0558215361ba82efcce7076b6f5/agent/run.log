n55\t * @param[in] osd An os_data structure to be filled with the os's data.\n56\t */\n57\tvoid parse_uname_string (char *uname,\n58\t                         os_data *osd)\n59\t{\n60\t    char *str_tmp = NULL;\n61\t    regmatch_t match[2] = {{.rm_so = 0}};\n62\t    int match_size = 0;\n63\t    \n64\t    if (!osd)\n65\t        return;\n66\t\n67\t    // [Ver: os_major.os_minor.os_build]\n68\t    if (str_tmp = strstr(uname, \" [Ver: \"), str_tmp) {\n69\t        *str_tmp = '\\0';\n70\t        str_tmp += 7;\n71\t        osd->os_name = strdup(uname);\n72\t        *(str_tmp + strlen(str_tmp) - 1) = '\\0';\n73\t\n74\t        // Get os_major\n75\t        if (w_regexec(\"^([0-9]+)\\\\.*\", str_tmp, 2, match)) {\n76\t            match_size = match[1].rm_eo - match[1].rm_so;\n77\t            osd->os_major = malloc(match_size +1);\n78\t            snprintf (osd->os_major, match_size + 1, \"%.*s\", match_size, str_tmp + match[1].rm_so);\n79\t        }\n80\t\n81\t        // Get os_minor\n82\t        if (w_regexec(\"^[0-9]+\\\\.([0-9]+)\\\\.*\", str_tmp, 2, match)) {\n83\t            match_size = match[1].rm_eo - match[1].rm_so;\n84\t            osd->os_minor = malloc(match_size +1);\n85\t            snprintf(osd->os_minor, match_size + 1, \"%.*s\", match_size, str_tmp + match[1].rm_so);\n86\t        }\n87\t\n88\t        // Get os_build\n89\t        if (w_regexec(\"^[0-9]+\\\\.[0-9]+\\\\.([0-9]+(\\\\.[0-9]+)*)\\\\.*\", str_tmp, 2, match)) {\n90\t            match_size = match[1].rm_eo - match[1].rm_so;\n91\t            osd->os_build = malloc(match_size +1);\n92\t            snprintf(osd->os_build, match_size + 1, \"%.*s\", match_size, str_tmp + match[1].rm_so);\n93\t        }\n94\t\n95\t        osd->os_version = strdup(str_tmp);\n96\t        osd->os_platform = strdup(\"windows\");\n97\t    } else {\n98\t        if (str_tmp = strstr(uname, \" [\"), str_tmp) {\n99\t            *str_tmp = '\\0';\n100\t            str_tmp += 2;\n101\t            osd->os_name = strdup(str_tmp);\n102\t 