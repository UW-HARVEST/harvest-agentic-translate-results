{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01WDrMaVyAT4gYQndThyAAVy","type":"tool_result","content":"1\t//! Shared plumbing for the C-vs-Rust differential tests.\n2\t//!\n3\t//! Both implementations are loaded as shared objects through `libloading` and\n4\t//! driven through their exported C ABI symbols (`driver`, `main`) — the Rust\n5\t//! functions are never called directly, so the `#[no_mangle]` wrappers are part\n6\t//! of what is under test.\n7\t//!\n8\t//! * the C `.so` is built with `gcc -shared -fPIC c_src/src/main.c`\n9\t//! * the Rust `.so` is built with `rustc --crate-type cdylib src/lib.rs`\n10\t//!   (flags selected by the `RUST_SO_PROFILE` env var: `dev` or `release`)\n11\t#![allow(dead_code)]\n12\t\n13\tuse std::ffi::c_void;\n14\tuse std::fs;\n15\tuse std::io::{self, Read, Write};\n16\tuse std::os::raw::c_int;\n17\tuse std::os::unix::io::AsRawFd;\n18\tuse std::path::{Path, PathBuf};\n19\tuse std::process::Command;\n20\tuse std::sync::atomic::{AtomicU64, Ordering};\n21\tuse std::sync::{Mutex, MutexGuard, OnceLock};\n22\t\n23\t/// Redirecting fd 1 and `fork()`ing are process-global operations, so every\n24\t/// capture has to be serialised even though libtest runs tests on several\n25\t/// threads.\n26\tfn capture_lock() -> MutexGuard<'static, ()> {\n27\t    static L: OnceLock<Mutex<()>> = OnceLock::new();\n28\t    match L.get_or_init(|| Mutex::new(())).lock() {\n29\t        Ok(g) => g,\n30\t        // A previous test panicked while holding the lock; fd 1 was restored by\n31\t        // then, so the guard is still usable.\n32\t        Err(poisoned) => poisoned.into_inner(),\n33\t    }\n34\t}\n35\t\n36\t// ---------------------------------------------------------------------------\n37\t// libc bits we need.  Declared directly (std already links libc) so the test\n38\t// harness needs no dependency beyond libloading.\n39\t// ---------------------------------------------------------------------------\n40\textern \"C\" {\n41\t    fn dup(oldfd: c_int) -> c_int;\n42\t    fn dup2(oldfd: c_int, newfd: c_int) -> c_int;\n43\t    fn close(fd: c_int) -> c_int;\n44\t    fn pipe(fds: *mut c_int) -> c_int;\n45\t    fn fork() -> c_int;\n46\t    fn waitpid(pid: c_int, status: *mut c_int, options: c_int) -> c_int;\n47\t    fn _exit(code: c_int) -> !;\n48\t    fn fflush(stream: *mut c_void) -> c_int;\n49\t    fn signal(signum: c_int, handler: usize) -> usize;\n50\t    fn write(fd: c_int, buf: *const u8, count: usize) -> isize;\n51\t    fn posix_openpt(flags: c_int) -> c_int;\n52\t    fn grantpt(fd: c_int) -> c_int;\n53\t    fn unlockpt(fd: c_int) -> c_int;\n54\t    fn ptsname(fd: c_int) -> *mut i8;\n55\t    fn open(path: *const i8, flags: c_int) -> c_int;\n56\t}\n57\t\n58\tconst O_RDWR: c_int = 2;\n59\tconst O_NOCTTY: c_int = 0o400;\n60\t\n61\t/// A freshly allocated pseudo-terminal, as `(master, slave)`.  Used to give a\n62\t/// child a stdout that really is a character device, which is the only case\n63\t/// where glibc line-buffers instead of fully buffering.\n64\tpub fn make_pty() -> (c_int, c_int) {\n65\t    unsafe {\n66\t        let master = posix_openpt(O_RDWR | O_NOCTTY);\n67\t        assert!(master >= 0, \"posix_openpt failed\");\n68\t        assert_eq!(grantpt(master), 0, \"grantpt failed\");\n69\t        assert_eq!(unlockpt(master), 0, \"unlockpt failed\");\n70\t        let name = ptsname(master);\n71\t        assert!(!name.is_null(), \"ptsname failed\");\n72\t        let slave = open(name, O_RDWR | O_NOCTTY);\n73\t        assert!(slave >= 0, \"opening the pty slave failed\");\n74\t        (master, slave)\n75\t    }\n76\t}\n77\t\n78\tconst SIGPIPE: c_int = 13;\n79\tconst SIG_DFL: usize = 0;\n80\t\n81\t// ---------------------------------------------------------------------------\n82\t// Paths / builds\n83\t// ---------------------------------------------------------------------------\n84\t\n85\tpub fn manifest_dir() -> PathBuf {\n86\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n87\t}\n88\t\n89\tpub fn tmp_dir() -> PathBuf {\n90\t    let d = PathBuf::from(env!(\"CARGO_TARGET_TMPDIR\"));\n91\t    fs::create_dir_all(&d).unwrap();\n92\t    d\n93\t}\n94\t\n95\tfn c_source() -> PathBuf {\n96\t    manifest_dir().join(\"c_src/src/main.c\")\n97\t}\n98\t\n99\tfn unique(name: &str) -> PathBuf {\n100\t    tmp_dir().join(format!(\"{}.{}\", name, std::process::id()))\n101\t}\n102\t\n103\tfn run_tool(what: &str, cmd: &mut Command) {\n104\t    let out = cmd\n105\t        .output()\n106\t        .unwrap_or_else(|e| panic!(\"failed to spawn {what}: {e}\"));\n107\t    if !out.status.success() {\n108\t        panic!(\n109\t            \"{what} failed ({:?})\\n--- stdout ---\\n{}\\n--- stderr ---\\n{}\",\n110\t            out.status,\n111\t            String::from_utf8_lossy(&out.stdout),\n112\t            String::from_utf8_lossy(&out.stderr)\n113\t        );\n114\t    }\n115\t}\n116\t\n117\t/// `gcc -shared -fPIC -o libdriver_c.so c_src/src/main.c`\n118\tpub fn c_so_path() -> &'static Path {\n119\t    static P: OnceLock<PathBuf> = OnceLock::new();\n120\t    P.get_or_init(|| {\n121\t        let out = unique(\"libdriver_c.so\");\n122\t        run_tool(\n123\t            \"gcc (C shared object)\",\n124\t            Command::new(\"gcc\")\n125\t                .arg(\"-shared\")\n126\t                .arg(\"-fPIC\")\n127\t                .arg(\"-o\")\n128\t                .arg(&out)\n129\t                .arg(c_source()),\n130\t        );\n131\t        out\n132\t    })\n133\t    .as_path()\n134\t}\n135\t\n136\t/// The C executable.  Prefers the CMake build (`c_src/build/driver`, the build\n137\t/// the task prescribes) and falls back to a plain `gcc -o` build, which uses the\n138\t/// same flags CMake does without a `CMAKE_BUILD_TYPE`.\n139\tpub fn c_exe_path() -> &'static Path {\n140\t    static P: OnceLock<PathBuf> = OnceLock::new();\n141\t    P.get_or_init(|| {\n142\t        let cmake = manifest_dir().join(\"c_src/build/driver\");\n143\t        if cmake.is_file() {\n144\t            return cmake;\n145\t        }\n146\t        let out = unique(\"driver_c\");\n147\t        run_tool(\n148\t            \"gcc (C executable)\",\n149\t            Command::new(\"gcc\").arg(\"-o\").arg(&out).arg(c_source()),\n150\t        );\n151\t        out\n152\t    })\n153\t    .as_path()\n154\t}\n155\t\n156\t/// The cargo-built Rust executable.\n157\tpub fn rust_exe_path() -> &'static Path {\n158\t    Path::new(env!(\"CARGO_BIN_EXE_driver\"))\n159\t}\n160\t\n161\t/// Which flags to build the Rust cdylib with.  `dev` mirrors the default cargo\n162\t/// profile, `release` mirrors `[profile.release]` (`panic = \"abort\"`, optimised).\n163\tpub fn rust_so_profile() -> String {\n164\t    std::env::var(\"RUST_SO_PROFILE\").unwrap_or_else(|_| \"dev\".to_string())\n165\t}\n166\t\n167\t/// `rustc --crate-type cdylib -o libdriver_rs.so src/lib.rs`\n168\tpub fn rust_so_path() -> &'static Path {\n169\t    static P: OnceLock<PathBuf> = OnceLock::new();\n170\t    P.get_or_init(|| {\n171\t        let profile = rust_so_profile();\n172\t        let out = unique(&format!(\"libdriver_rs_{profile}.so\"));\n173\t        let mut cmd = Command::new(\"rustc\");\n174\t        cmd.arg(\"--edition\")\n175\t            .arg(\"2021\")\n176\t            .arg(\"--crate-type\")\n177\t            .arg(\"cdylib\")\n178\t            .arg(\"--crate-name\")\n179\t            .arg(\"driver\")\n180\t            .arg(\"-A\")\n181\t            .arg(\"warnings\");\n182\t        match profile.as_str() {\n183\t            \"dev\" => {\n184\t                cmd.arg(\"-C\").arg(\"opt-level=0\");\n185\t                cmd.arg(\"-C\").arg(\"debug-assertions=on\");\n186\t                cmd.arg(\"-C\").arg(\"overflow-checks=on\");\n187\t            }\n188\t            \"release\" => {\n189\t                cmd.arg(\"-C\").arg(\"opt-level=3\");\n190\t                cmd.arg(\"-C\").arg(\"debug-assertions=off\");\n191\t                cmd.arg(\"-C\").arg(\"overflow-checks=off\");\n192\t                cmd.arg(\"-C\").arg(\"panic=abort\");\n193\t            }\n194\t            other => panic!(\"unknown RUST_SO_PROFILE {other:?} (expected dev|release)\"),\n195\t        }\n196\t        cmd.arg(\"-o\").arg(&out).arg(manifest_dir().join(\"src/lib.rs\"));\n197\t        run_tool(\"rustc (Rust cdylib)\", &mut cmd);\n198\t        out\n199\t    })\n200\t    .as_path()\n201\t}\n202\t\n203\t// ---------------------------------------------------------------------------\n204\t// The two implementations, loaded through libloading\n205\t// ---------------------------------------------------------------------------\n206\t\n207\tpub type DriverFn = unsafe extern \"C\" fn(c_int);\n208\tpub type DriverWideFn = unsafe extern \"C\" fn(i64);\n209\tpub type MainFn = unsafe extern \"C\" fn() -> c_int;\n210\t\n211\tpub struct Impl {\n212\t    pub name: &'static str,\n213\t    _lib: libloading::Library,\n214\t    pub driver: DriverFn,\n215\t    /// The very same `driver` symbol, but declared as taking a 64-bit argument\n216\t    /// so the tests can push out-of-range values across the ABI boundary.\n217\t    pub driver_wide: DriverWideFn,\n218\t    pub main: MainFn,\n219\t}\n220\t\n221\timpl Impl {\n222\t    fn load(name: &'static str, path: &Path) -> Impl {\n223\t        unsafe {\n224\t            let lib = libloading::Library::new(path)\n225\t                .unwrap_or_else(|e| panic!(\"dlopen({}) failed: {e}\", path.display()));\n226\t            // Inner scope so the `Symbol` borrows of `lib` end before `lib` is\n227\t            // moved into the struct; the extracted values are plain fn pointers.\n228\t            let (driver, driver_wide, main) = {\n229\t                let d: libloading::Symbol<DriverFn> = lib\n230\t                    .get(b\"driver\\0\")\n231\t                    .unwrap_or_else(|e| panic!(\"{name}: no `driver` symbol: {e}\"));\n232\t                let w: libloading::Symbol<DriverWideFn> = lib.get(b\"driver\\0\").unwrap();\n233\t                let m: libloading::Symbol<MainFn> = lib\n234\t                    .get(b\"main\\0\")\n235\t                    .unwrap_or_else(|e| panic!(\"{name}: no `main` symbol: {e}\"));\n236\t                (*d, *w, *m)\n237\t            };\n238\t            Impl {\n239\t                name,\n240\t                _lib: lib,\n241\t                driver,\n242\t                driver_wide,\n243\t                main,\n244\t            }\n245\t        }\n246\t    }\n247\t}\n248\t\n249\t/// Both implementations, loaded once per test process.\n250\tpub struct Pair {\n251\t    pub c: Impl,\n252\t    pub rs: Impl,\n253\t}\n254\t\n255\tpub fn pair() -> &'static Pair {\n256\t    static P: OnceLock<Pair> = OnceLock::new();\n257\t    P.get_or_init(|| {\n258\t        let p = Pair {\n259\t            c: Impl::load(\"C\", c_so_path()),\n260\t            rs: Impl::load(\"Rust\", rust_so_path()),\n261\t        };\n262\t        // Warm both libraries up (lazy statics, stdio buffers) before any\n263\t        // fork(), so the forked children inherit fully initialised state.\n264\t        let _ = capture_in_process(|| unsafe { (p.c.driver)(0) });\n265\t        let _ = capture_in_process(|| unsafe { (p.rs.driver)(0) });\n266\t        p\n267\t    })\n268\t}\n269\t\n270\t// ---------------------------------------------------------------------------\n271\t// Capturing fd 1\n272\t// ---------------------------------------------------------------------------\n273\t\n274\tfn next_id() -> u64 {\n275\t    static N: AtomicU64 = AtomicU64::new(0);\n276\t    N.fetch_add(1, Ordering::SeqCst)\n277\t}\n278\t\n279\t/// A unique scratch path (unique per process *and* per call, so tests running\n280\t/// on different threads never collide).\n281\tpub fn scratch_file(tag: &str) -> PathBuf {\n282\t    tmp_dir().join(format!(\n283\t        \"{tag}.{}.{}.bin\",\n284\t        std::process::id(),\n285\t        next_id()\n286\t    ))\n287\t}\n288\t\n289\t/// Run `f` with fd 1 redirected to a fresh regular file and return everything\n290\t/// that was written (after flushing C stdio, which `printf` buffers).\n291\t///\n292\t/// NOTE: fd 1 is process-global and libtest also writes its progress lines\n293\t/// there from another thread, so this in-process variant is only used for the\n294\t/// one-off warm-up in [`pair`].  Everything that is compared goes through\n295\t/// [`capture_child`], which redirects fd 1 in a forked child and therefore\n296\t/// cannot pick up the harness's own output.\n297\tfn capture_in_process(f: impl FnOnce()) -> Vec<u8> {\n298\t    let _guard = capture_lock();\n299\t    let path = scratch_file(\"capture\");\n300\t    let bytes = {\n301\t        let file = fs::File::create(&path).unwrap();\n302\t        let _ = io::stdout().flush();\n303\t        unsafe {\n304\t            fflush(std::ptr::null_mut());\n305\t        }\n306\t        let saved = unsafe { dup(1) };\n307\t        assert!(saved >= 0, \"dup(1) failed\");\n308\t        assert!(unsafe { dup2(file.as_raw_fd(), 1) } >= 0, \"dup2 failed\");\n309\t        f();\n310\t        unsafe {\n311\t            fflush(std::ptr::null_mut());\n312\t        }\n313\t        let _ = io::stdout().flush();\n314\t        assert!(unsafe { dup2(saved, 1) } >= 0, \"dup2 restore failed\");\n315\t        unsafe {\n316\t            close(saved);\n317\t        }\n318\t        drop(file);\n319\t        fs::read(&path).unwrap()\n320\t    };\n321\t    let _ = fs::remove_file(&path);\n322\t    bytes\n323\t}\n324\t\n325\t/// Run `f` in a forked child whose fd 1 is a fresh regular file, and return\n326\t/// what it wrote plus how the child terminated.\n327\tpub fn capture_child(f: impl FnOnce()) -> Run {\n328\t    run_child(Stdin::Inherit, Stdout::File, || {\n329\t        f();\n330\t        0\n331\t    })\n332\t}\n333\t\n334\t/// Same, but the child's fd 1 is a pipe (stdio picks a different buffering mode\n335\t/// for non-seekable streams).\n336\tpub fn capture_child_piped(f: impl FnOnce()) -> Run {\n337\t    run_child(Stdin::Inherit, Stdout::Pipe, || {\n338\t        f();\n339\t        0\n340\t    })\n341\t}\n342\t\n343\t/// `pipe(2)`, returning `(read_end, write_end)`.\n344\tpub fn make_pipe() -> (c_int, c_int) {\n345\t    let mut fds = [0 as c_int; 2];\n346\t    assert_eq!(unsafe { pipe(fds.as_mut_ptr()) }, 0, \"pipe() failed\");\n347\t    (fds[0], fds[1])\n348\t}\n349\t\n350\t/// `close(2)`.\n351\tpub fn close_fd(fd: c_int) {\n352\t    unsafe {\n353\t        close(fd);\n354\t    }\n355\t}\n356\t\n357\t// ---------------------------------------------------------------------------\n358\t// Running the exported `main` in a forked child\n359\t// ---------------------------------------------------------------------------\n360\t\n361\t#[derive(Debug, PartialEq, Eq, Clone, Copy)]\n362\tpub enum Status {\n363\t    Exited(i32),\n364\t    Signaled(i32),\n365\t}\n366\t\n367\tfn decode_status(st: c_int) -> Status {\n368\t    if st & 0x7f == 0 {\n369\t        Status::Exited((st >> 8) & 0xff)\n370\t    } else {\n371\t        Status::Signaled(st & 0x7f)\n372\t    }\n373\t}\n374\t\n375\t#[derive(Debug, PartialEq, Eq, Clone)]\n376\tpub struct Run {\n377\t    pub out: Vec<u8>,\n378\t    pub status: Status,\n379\t}\n380\t\n381\t/// How the child's stdin is provided.\n382\t#[derive(Clone, Copy, PartialEq, Eq, Debug)]\n383\tpub enum Stdin<'a> {\n384\t    /// A regular (seekable) file holding these bytes.\n385\t    File(&'a [u8]),\n386\t    /// A pipe pre-filled with these bytes (must fit in the pipe buffer).\n387\t    Pipe(&'a [u8]),\n388\t    /// A pipe that stays empty until the parent writes these bytes two seconds\n389\t    /// after the child started, so the child blocks in `read`.\n390\t    SlowPipe(&'a [u8]),\n391\t    /// fd 0 closed.\n392\t    Closed,\n393\t    /// fd 0 open on a directory.\n394\t    Directory,\n395\t    /// Leave the parent's fd 0 in place.\n396\t    Inherit,\n397\t}\n398\t\n399\t/// How the child's stdout is provided.\n400\t#[derive(Clone, Copy, PartialEq, Eq, Debug)]\n401\tpub enum Stdout {\n402\t    /// A regular file whose contents are returned.\n403\t    File,\n404\t    /// A pipe drained by the parent.\n405\t    Pipe,\n406\t    /// A pipe whose read end is closed before the call (EPIPE / SIGPIPE).\n407\t    ClosedPipe,\n408\t    /// fd 1 closed (EBADF).\n409\t    Closed,\n410\t    /// `/dev/full` (ENOSPC on flush).\n411\t    DevFull,\n412\t    /// A pseudo-terminal, drained by the parent (glibc line-buffers this one).\n413\t    Tty,\n414\t}\n415\t\n416\t/// Fork, wire up fd 0 / fd 1 as requested, run `f` in the child, and collect\n417\t/// its output and exit status.  `f` only calls into a `dlopen`ed library, so the\n418\t/// child does essentially no work of its own; its return value becomes the\n419\t/// child's exit code.\n420\tpub fn run_child(stdin: Stdin<'_>, stdout: Stdout, f: impl FnOnce() -> c_int) -> Run {\n421\t    // Serialised together with the fd-1 captures: `fork()` must not race with\n422\t    // another thread that is temporarily pointing fd 1 somewhere else.\n423\t    let _guard = capture_lock();\n424\t    // ---- set up stdin ----\n425\t    let mut in_file: Option<fs::File> = None;\n426\t    let mut in_pipe: Option<(c_int, c_int)> = None;\n427\t    let in_fd: Option<c_int> = match stdin {\n428\t        Stdin::File(data) => {\n429\t            let p = scratch_file(\"stdin\");\n430\t            fs::write(&p, data).unwrap();\n431\t            let f = fs::File::open(&p).unwrap();\n432\t            let fd = f.as_raw_fd();\n433\t            in_file = Some(f);\n434\t            let _ = fs::remove_file(&p);\n435\t            Some(fd)\n436\t        }\n437\t        Stdin::Pipe(data) => {\n438\t            assert!(\n439\t                data.len() < 60_000,\n440\t                \"pipe-backed stdin must fit in the pipe buffer ({} bytes)\",\n441\t                data.len()\n442\t            );\n443\t            let mut fds = [0 as c_int; 2];\n444\t            assert_eq!(unsafe { pipe(fds.as_mut_ptr()) }, 0);\n445\t            let mut off = 0usize;\n446\t            while off < data.len() {\n447\t                let n = unsafe { write(fds[1], data[off..].as_ptr(), data.len() - off) };\n448\t                assert!(n > 0, \"short write to pipe\");\n449\t                off += n as usize;\n450\t            }\n451\t            unsafe {\n452\t                close(fds[1]);\n453\t            }\n454\t            in_pipe = Some((fds[0], -1));\n455\t            Some(fds[0])\n456\t        }\n457\t        Stdin::SlowPipe(_) => {\n458\t            let (rd, wr) = make_pipe();\n459\t            in_pipe = Some((rd, wr));\n460\t            Some(rd)\n461\t        }\n462\t        Stdin::Closed => Some(-2), // sentinel: close fd 0 in the child\n463\t        Stdin::Directory => {\n464\t            let f = fs::File::open(manifest_dir()).unwrap();\n465\t            let fd = f.as_raw_fd();\n466\t            in_file = Some(f);\n467\t            Some(fd)\n468\t        }\n469\t        Stdin::Inherit => None,\n470\t    };\n471\t\n472\t    // ---- set up stdout ----\n473\t    let out_path = scratch_file(\"stdout\");\n474\t    let mut out_file: Option<fs::File> = None;\n475\t    let mut out_pipe: Option<(c_int, c_int)> = None;\n476\t    let mut out_pty: Option<(c_int, c_int)> = None;\n477\t    let out_fd: c_int = match stdout {\n478\t        Stdout::File => {\n479\t            let f = fs::File::create(&out_path).unwrap();\n480\t            let fd = f.as_raw_fd();\n481\t            out_file = Some(f);\n482\t            fd\n483\t        }\n484\t        Stdout::Pipe | Stdout::ClosedPipe => {\n485\t            let mut fds = [0 as c_int; 2];\n486\t            assert_eq!(unsafe { pipe(fds.as_mut_ptr()) }, 0);\n487\t            if stdout == Stdout::ClosedPipe {\n488\t                unsafe {\n489\t                    close(fds[0]);\n490\t                }\n491\t                out_pipe = Some((-1, fds[1]));\n492\t            } else {\n493\t                out_pipe = Some((fds[0], fds[1]));\n494\t            }\n495\t            fds[1]\n496\t        }\n497\t        Stdout::Closed => -2, // sentinel: close fd 1 in the child\n498\t        Stdout::DevFull => {\n499\t            let f = fs::OpenOptions::new().write(true).open(\"/dev/full\").unwrap();\n500\t            let fd = f.as_raw_fd();\n501\t            out_file = Some(f);\n502\t            fd\n503\t        }\n504\t        Stdout::Tty => {\n505\t            let (master, slave) = make_pty();\n506\t            out_pty = Some((master, slave));\n507\t            slave\n508\t        }\n509\t    };\n510\t\n511\t    let _ = io::stdout().flush();\n512\t    unsafe {\n513\t        fflush(std::ptr::null_mut());\n514\t    }\n515\t\n516\t    let pid = unsafe { fork() };\n517\t    assert!(pid >= 0, \"fork() failed\");\n518\t    if pid == 0 {\n519\t        // ---------------- child ----------------\n520\t        unsafe {\n521\t            match in_fd {\n522\t                Some(-2) => {\n523\t                    close(0);\n524\t                }\n525\t                Some(fd) => {\n526\t                    dup2(fd, 0);\n527\t                }\n528\t                None => {}\n529\t            }\n530\t            if out_fd == -2 {\n531\t                close(1);\n532\t            } else {\n533\t                dup2(out_fd, 1);\n534\t            }\n535\t            // A C program starts with SIGPIPE at SIG_DFL; the Rust test harness\n536\t            // set it to SIG_IGN, so restore the C default for both sides.\n537\t            signal(SIGPIPE, SIG_DFL);\n538\t            let rc = f();\n539\t            fflush(std::ptr::null_mut());\n540\t            _exit(rc & 0xff);\n541\t        }\n542\t    }\n543\t\n544\t    // ---------------- parent ----------------\n545\t    if let Stdin::SlowPipe(data) = stdin {\n546\t        // Let the child block in `read` first, then deliver the bytes.  Writing\n547\t        // may fail with EPIPE if the child already gave up; that is fine.\n548\t        let wr = in_pipe.map(|(_, w)| w).unwrap_or(-1);\n549\t        std::thread::sleep(std::time::Duration::from_secs(2));\n550\t        let mut off = 0usize;\n551\t        while off < data.len() {\n552\t            let n = unsafe { write(wr, data[off..].as_ptr(), data.len() - off) };\n553\t            if n <= 0 {\n554\t                break;\n555\t            }\n556\t            off += n as usize;\n557\t        }\n558\t        unsafe {\n559\t            close(wr);\n560\t        }\n561\t    }\n562\t    // Close our copies of the write ends so reads see EOF.\n563\t    if let Some((_, wr)) = out_pipe {\n564\t        if wr >= 0 {\n565\t            unsafe {\n566\t                close(wr);\n567\t            }\n568\t        }\n569\t    }\n570\t    let pty_out = out_pty.map(|(master, slave)| {\n571\t        // Our copy of the slave must go, otherwise the master never sees EOF.\n572\t        unsafe {\n573\t            close(slave);\n574\t        }\n575\t        let mut buf = Vec::new();\n576\t        let mut f = unsafe { <fs::File as std::os::unix::io::FromRawFd>::from_raw_fd(master) };\n577\t        // A pty master reports EIO (not EOF) once the last slave closes.\n578\t        let mut chunk = [0u8; 256];\n579\t        loop {\n580\t            match f.read(&mut chunk) {\n581\t                Ok(0) => break,\n582\t                Ok(n) => buf.extend_from_slice(&chunk[..n]),\n583\t                Err(_) => break,\n584\t            }\n585\t        }\n586\t        buf\n587\t    });\n588\t    let piped_out = out_pipe.and_then(|(rd, _)| {\n589\t        if rd < 0 {\n590\t            None\n591\t        } else {\n592\t            let mut buf = Vec::new();\n593\t            let mut f = unsafe { <fs::File as std::os::unix::io::FromRawFd>::from_raw_fd(rd) };\n594\t            f.read_to_end(&mut buf).unwrap();\n595\t            Some(buf)\n596\t        }\n597\t    });\n598\t\n599\t    let mut st: c_int = 0;\n600\t    let w = unsafe { waitpid(pid, &mut st, 0) };\n601\t    assert_eq!(w, pid, \"waitpid failed\");\n602\t    let status = decode_status(st);\n603\t\n604\t    let out = match stdout {\n605\t        Stdout::File => fs::read(&out_path).unwrap_or_default(),\n606\t        Stdout::Pipe => piped_out.unwrap_or_default(),\n607\t        Stdout::Tty => pty_out.unwrap_or_default(),\n608\t        _ => Vec::new(),\n609\t    };\n610\t\n611\t    // cleanup\n612\t    drop(out_file);\n613\t    drop(in_file);\n614\t    if let Some((rd, wr)) = in_pipe {\n615\t        if rd >= 0 {\n616\t            unsafe {\n617\t                close(rd);\n618\t            }\n619\t        }\n620\t        if wr >= 0 && !matches!(stdin, Stdin::SlowPipe(_)) {\n621\t            unsafe {\n622\t                close(wr);\n623\t            }\n624\t        }\n625\t    }\n626\t    let _ = fs::remove_file(&out_path);\n627\t\n628\t    Run { out, status }\n629\t}\n630\t\n631\t/// Run the exported `main` of both implementations on the same stdin/stdout\n632\t/// wiring and assert the results are identical.\n633\t#[track_caller]\n634\tpub fn diff_main(stdin: Stdin<'_>, stdout: Stdout, label: &str) -> Run {\n635\t    let p = pair();\n636\t    let c = run_child(stdin, stdout, || unsafe { (p.c.main)() });\n637\t    let r = run_child(stdin, stdout, || unsafe { (p.rs.main)() });\n638\t    assert_eq!(\n639\t        (as_text(&c.out), c.status),\n640\t        (as_text(&r.out), r.status),\n641\t        \"`main` diverged for {label} (stdin={:?}, stdout={:?})\",\n642\t        Preview(stdin),\n643\t        stdout\n644\t    );\n645\t    c\n646\t}\n647\t\n648\t/// Run the exported `main` of both implementations against the same input bytes\n649\t/// (regular-file stdin, regular-file stdout) and assert equality.\n650\t#[track_caller]\n651\tpub fn diff_main_input(input: &[u8]) -> Run {\n652\t    diff_main(Stdin::File(input), Stdout::File, &preview(input))\n653\t}\n654\t\n655\t// ---------------------------------------------------------------------------\n656\t// driver differential helpers\n657\t// ---------------------------------------------------------------------------\n658\t\n659\t/// Call `driver` once per value in one forked child per implementation and\n660\t/// compare the two output streams.\n661\t#[track_caller]\n662\tpub fn diff_driver_batch(values: &[i32], label: &str) {\n663\t    let p = pair();\n664\t    let c = capture_child(|| {\n665\t        for &v in values {\n666\t            unsafe { (p.c.driver)(v) }\n667\t        }\n668\t    });\n669\t    let r = capture_child(|| {\n670\t        for &v in values {\n671\t            unsafe { (p.rs.driver)(v) }\n672\t        }\n673\t    });\n674\t    assert_eq!(\n675\t        (c.status, r.status),\n676\t        (Status::Exited(0), Status::Exited(0)),\n677\t        \"`driver` child terminated abnormally for {label}\"\n678\t    );\n679\t    assert_batch_eq(&c.out, &r.out, values, label);\n680\t}\n681\t\n682\t/// Same, through a pipe rather than a regular file.\n683\t#[track_caller]\n684\tpub fn diff_driver_batch_piped(values: &[i32], label: &str) {\n685\t    let p = pair();\n686\t    let c = capture_child_piped(|| {\n687\t        for &v in values {\n688\t            unsafe { (p.c.driver)(v) }\n689\t        }\n690\t    });\n691\t    let r = capture_child_piped(|| {\n692\t        for &v in values {\n693\t            unsafe { (p.rs.driver)(v) }\n694\t        }\n695\t    });\n696\t    assert_eq!(\n697\t        (c.status, r.status),\n698\t        (Status::Exited(0), Status::Exited(0)),\n699\t        \"`driver` child terminated abnormally for {label}\"\n700\t    );\n701\t    assert_batch_eq(&c.out, &r.out, values, label);\n702\t}\n703\t\n704\t/// The same `driver` symbol called with a 64-bit argument (out-of-range input\n705\t/// across the FFI boundary).\n706\t#[track_caller]\n707\tpub fn diff_driver_batch_wide(values: &[i64], label: &str) {\n708\t    let p = pair();\n709\t    let c = capture_child(|| {\n710\t        for &v in values {\n711\t            unsafe { (p.c.driver_wide)(v) }\n712\t        }\n713\t    });\n714\t    let r = capture_child(|| {\n715\t        for &v in values {\n716\t            unsafe { (p.rs.driver_wide)(v) }\n717\t        }\n718\t    });\n719\t    assert_eq!(\n720\t        (c.status, r.status),\n721\t        (Status::Exited(0), Status::Exited(0)),\n722\t        \"`driver` (wide) child terminated abnormally for {label}\"\n723\t    );\n724\t    let (c, r) = (c.out, r.out);\n725\t    assert_eq!(\n726\t        as_text(&c),\n727\t        as_text(&r),\n728\t        \"`driver` (wide argument) diverged for {label}; first values {:?}\",\n729\t        &values[..values.len().min(8)]\n730\t    );\n731\t    assert_eq!(c.len(), values.len() * 9, \"unexpected C output length\");\n732\t}\n733\t\n734\t#[track_caller]\n735\tfn assert_batch_eq(c: &[u8], r: &[u8], values: &[i32], label: &str) {\n736\t    if c != r {\n737\t        // Pin-point the first differing record for a useful message.\n738\t        let mut detail = String::new();\n739\t        for (i, v) in values.iter().enumerate() {\n740\t            let (a, b) = (\n741\t                c.get(i * 9..i * 9 + 9).unwrap_or(b\"<missing>\"),\n742\t                r.get(i * 9..i * 9 + 9).unwrap_or(b\"<missing>\"),\n743\t            );\n744\t            if a != b {\n745\t                detail = format!(\n746\t                    \"first divergence at index {i} (x = {v} / {:#010x}): C {:?} vs Rust {:?}\",\n747\t                    *v as u32,\n748\t                    String::from_utf8_lossy(a),\n749\t                    String::from_utf8_lossy(b)\n750\t                );\n751\t                break;\n752\t            }\n753\t        }\n754\t        panic!(\"`driver` diverged for {label}: {detail}\");\n755\t    }\n756\t    assert_eq!(\n757\t        c.len(),\n758\t        values.len() * 9,\n759\t        \"unexpected output length for {label}\"\n760\t    );\n761\t}\n762\t\n763\t// ---------------------------------------------------------------------------\n764\t// Process-level (executable) differential helper\n765\t// ---------------------------------------------------------------------------\n766\t\n767\t#[derive(Debug, PartialEq, Eq)]\n768\tpub struct ProcOut {\n769\t    pub out: Vec<u8>,\n770\t    pub status: Option<i32>,\n771\t    pub signal: Option<i32>,\n772\t}\n773\t\n774\tpub fn run_exe_with_file_stdin(exe: &Path, input: &[u8]) -> ProcOut {\n775\t    let p = scratch_file(\"exe-stdin\");\n776\t    fs::write(&p, input).unwrap();\n777\t    let f = fs::File::open(&p).unwrap();\n778\t    let out = Command::new(exe)\n779\t        .stdin(std::process::Stdio::from(f))\n780\t        .output()\n781\t        .unwrap();\n782\t    let _ = fs::remove_file(&p);\n783\t    use std::os::unix::process::ExitStatusExt;\n784\t    ProcOut {\n785\t        out: out.stdout,\n786\t        status: out.status.code(),\n787\t        signal: out.status.signal(),\n788\t    }\n789\t}\n790\t\n791\tpub fn run_exe_with_pipe_stdin(exe: &Path, input: &[u8]) -> ProcOut {\n792\t    use std::os::unix::process::ExitStatusExt;\n793\t    let mut child = Command::new(exe)\n794\t        .stdin(std::process::Stdio::piped())\n795\t        .stdout(std::process::Stdio::piped())\n796\t        .spawn()\n797\t        .unwrap();\n798\t    {\n799\t        let mut si = child.stdin.take().unwrap();\n800\t        // A separate thread keeps large inputs from dead-locking on the pipe.\n801\t        let data = input.to_vec();\n802\t        std::thread::spawn(move || {\n803\t            let _ = si.write_all(&data);\n804\t        });\n805\t    }\n806\t    let out = child.wait_with_output().unwrap();\n807\t    ProcOut {\n808\t        out: out.stdout,\n809\t        status: out.status.code(),\n810\t        signal: out.status.signal(),\n811\t    }\n812\t}\n813\t\n814\t#[track_caller]\n815\tpub fn diff_exe_file_stdin(input: &[u8]) {\n816\t    let c = run_exe_with_file_stdin(c_exe_path(), input);\n817\t    let r = run_exe_with_file_stdin(rust_exe_path(), input);\n818\t    assert_eq!(\n819\t        (as_text(&c.out), c.status, c.signal),\n820\t        (as_text(&r.out), r.status, r.signal),\n821\t        \"executables diverged for input {}\",\n822\t        preview(input)\n823\t    );\n824\t}\n825\t\n826\t#[track_caller]\n827\tpub fn diff_exe_pipe_stdin(input: &[u8]) {\n828\t    let c = run_exe_with_pipe_stdin(c_exe_path(), input);\n829\t    let r = run_exe_with_pipe_stdin(rust_exe_path(), input);\n830\t    assert_eq!(\n831\t        (as_text(&c.out), c.status, c.signal),\n832\t        (as_text(&r.out), r.status, r.signal),\n833\t        \"executables diverged (pipe stdin) for input {}\",\n834\t        preview(input)\n835\t    );\n836\t}\n837\t\n838\t// ---------------------------------------------------------------------------\n839\t// misc\n840\t// ---------------------------------------------------------------------------\n841\t\n842\tpub fn as_text(b: &[u8]) -> String {\n843\t    String::from_utf8_lossy(b).into_owned()\n844\t}\n845\t\n846\tpub fn preview(input: &[u8]) -> String {\n847\t    let shown: Vec<u8> = input.iter().copied().take(64).collect();\n848\t    let mut s = String::new();\n849\t    for b in shown {\n850\t        match b {\n851\t            b'\\n' => s.push_str(\"\\\\n\"),\n852\t            b'\\r' => s.push_str(\"\\\\r\"),\n853\t            b'\\t' => s.push_str(\"\\\\t\"),\n854\t            0x0b => s.push_str(\"\\\\v\"),\n855\t            0x0c => s.push_str(\"\\\\f\"),\n856\t            0x20..=0x7e => s.push(b as char),\n857\t            _ => s.push_str(&format!(\"\\\\x{b:02x}\")),\n858\t        }\n859\t    }\n860\t    format!(\"\\\"{s}\\\"{}\", if input.len() > 64 {\n861\t        format!(\" (+{} more bytes, {} total)\", input.len() - 64, input.len())\n862\t    } else {\n863\t        String::new()\n864\t    })\n865\t}\n866\t\n867\tstruct Preview<'a>(Stdin<'a>);\n868\timpl std::fmt::Debug for Preview<'_> {\n869\t    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n870\t        match self.0 {\n871\t            Stdin::File(d) => write!(f, \"File({})\", preview(d)),\n872\t            Stdin::Pipe(d) => write!(f, \"Pipe({})\", preview(d)),\n873\t            Stdin::SlowPipe(d) => write!(f, \"SlowPipe({})\", preview(d)),\n874\t            other => write!(f, \"{other:?}\"),\n875\t        }\n876\t    }\n877\t}\n878\t\n879\t/// SplitMix64 — fixed seed, so every \"randomised\" row is reproducible.\n880\tpub struct Rng(u64);\n881\t\n882\timpl Rng {\n883\t    pub fn new(seed: u64) -> Rng {\n884\t        Rng(seed)\n885\t    }\n886\t    pub fn next_u64(&mut self) -> u64 {\n887\t        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);\n888\t        let mut z = self.0;\n889\t        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);\n890\t        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);\n891\t        z ^ (z >> 31)\n892\t    }\n893\t    pub fn next_i32(&mut self) -> i32 {\n894\t        self.next_u64() as u32 as i32\n895\t    }\n896\t    /// Uniform in `0..n`.\n897\t    pub fn below(&mut self, n: u64) -> u64 {\n898\t        assert!(n > 0);\n899\t        self.next_u64() % n\n900\t    }\n901\t    pub fn pick<T: Copy>(&mut self, xs: &[T]) -> T {\n902\t        xs[self.below(xs.len() as u64) as usize]\n903\t    }\n904\t    pub fn digits(&mut self, n: usize) -> String {\n905\t        (0..n)\n906\t            .map(|i| {\n907\t                // Avoid a leading zero unless the caller wants one.\n908\t                let lo: u64 = if i == 0 && n > 1 { 1 } else { 0 };\n909\t                (b'0' + (lo + self.below(10 - lo)) as u8) as char\n910\t            })\n911\t            .collect()\n912\t    }\n913\t}\n914\t"}]},"parent_tool_use_id":"toolu_bdrk_014BZJRV9mTTLmVbbGcubu9U","session_id":"64daaee6-dfd8-4ebc-87be-dd6361eb86bc","uuid":"6219caea-e208-44fe-a327-5dc4ad9342b4","timestamp":"2026-08-18T10:37:10.422Z","subagent_type":"general-purpose","task_description":"Re-audit artifacts after fixes"}
