{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01TH1LycHpWvEYYzwY2sJfow","type":"tool_result","content":"1\t//! Shared plumbing for the C-vs-Rust differential tests.\n2\t//!\n3\t//! Both implementations are loaded as shared objects through `libloading` and\n4\t//! driven through their exported C ABI symbols (`driver`, `main`) — the Rust\n5\t//! functions are never called directly, so the `#[no_mangle]` wrappers are part\n6\t//! of what is under test.\n7\t//!\n8\t//! * the C `.so` is built with `gcc -shared -fPIC c_src/src/main.c`\n9\t//! * the Rust `.so` is built with `rustc --crate-type cdylib src/lib.rs`\n10\t//!   (flags selected by the `RUST_SO_PROFILE` env var: `dev` or `release`)\n11\t#![allow(dead_code)]\n12\t\n13\tuse std::ffi::c_void;\n14\tuse std::fs;\n15\tuse std::io::{self, Read, Write};\n16\tuse std::os::raw::c_int;\n17\tuse std::os::unix::io::AsRawFd;\n18\tuse std::path::{Path, PathBuf};\n19\tuse std::process::Command;\n20\tuse std::sync::atomic::{AtomicU64, Ordering};\n21\tuse std::sync::{Mutex, MutexGuard, OnceLock};\n22\t\n23\t/// Redirecting fd 1 and `fork()`ing are process-global operations, so every\n24\t/// capture has to be serialised even though libtest runs tests on several\n25\t/// threads.\n26\tfn capture_lock() -> MutexGuard<'static, ()> {\n27\t    static L: OnceLock<Mutex<()>> = OnceLock::new();\n28\t    match L.get_or_init(|| Mutex::new(())).lock() {\n29\t        Ok(g) => g,\n30\t        // A previous test panicked while holding the lock; fd 1 was restored by\n31\t        // then, so the guard is still usable.\n32\t        Err(poisoned) => poisoned.into_inner(),\n33\t    }\n34\t}\n35\t\n36\t// ---------------------------------------------------------------------------\n37\t// libc bits we need.  Declared directly (std already links libc) so the test\n38\t// harness needs no dependency beyond libloading.\n39\t// ---------------------------------------------------------------------------\n40\textern \"C\" {\n41\t    fn dup(oldfd: c_int) -> c_int;\n42\t    fn dup2(oldfd: c_int, newfd: c_int) -> c_int;\n43\t    fn close(fd: c_int) -> c_int;\n44\t    fn pipe(fds: *mut c_int) -> c_int;\n45\t    fn fork() -> c_int;\n46\t    fn waitpid(pid: c_int, status: *mut c_int, options: c_int) -> c_int;\n47\t    fn _exit(code: c_int) -> !;\n48\t    fn fflush(stream: *mut c_void) -> c_int;\n49\t    fn signal(signum: c_int, handler: usize) -> usize;\n50\t    fn write(fd: c_int, buf: *const u8, count: usize) -> isize;\n51\t}\n52\t\n53\tconst SIGPIPE: c_int = 13;\n54\tconst SIG_DFL: usize = 0;\n55\t\n56\t// ---------------------------------------------------------------------------\n57\t// Paths / builds\n58\t// ---------------------------------------------------------------------------\n59\t\n60\tpub fn manifest_dir() -> PathBuf {\n61\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n62\t}\n63\t\n64\tpub fn tmp_dir() -> PathBuf {\n65\t    let d = PathBuf::from(env!(\"CARGO_TARGET_TMPDIR\"));\n66\t    fs::create_dir_all(&d).unwrap();\n67\t    d\n68\t}\n69\t\n70\tfn c_source() -> PathBuf {\n71\t    manifest_dir().join(\"c_src/src/main.c\")\n72\t}\n73\t\n74\tfn unique(name: &str) -> PathBuf {\n75\t    tmp_dir().join(format!(\"{}.{}\", name, std::process::id()))\n76\t}\n77\t\n78\tfn run_tool(what: &str, cmd: &mut Command) {\n79\t    let out = cmd\n80\t        .output()\n81\t        .unwrap_or_else(|e| panic!(\"failed to spawn {what}: {e}\"));\n82\t    if !out.status.success() {\n83\t        panic!(\n84\t            \"{what} failed ({:?})\\n--- stdout ---\\n{}\\n--- stderr ---\\n{}\",\n85\t            out.status,\n86\t            String::from_utf8_lossy(&out.stdout),\n87\t            String::from_utf8_lossy(&out.stderr)\n88\t        );\n89\t    }\n90\t}\n91\t\n92\t/// `gcc -shared -fPIC -o libdriver_c.so c_src/src/main.c`\n93\tpub fn c_so_path() -> &'static Path {\n94\t    static P: OnceLock<PathBuf> = OnceLock::new();\n95\t    P.get_or_init(|| {\n96\t        let out = unique(\"libdriver_c.so\");\n97\t        run_tool(\n98\t            \"gcc (C shared object)\",\n99\t            Command::new(\"gcc\")\n100\t                .arg(\"-shared\")\n101\t                .arg(\"-fPIC\")\n102\t                .arg(\"-o\")\n103\t                .arg(&out)\n104\t                .arg(c_source()),\n105\t        );\n106\t        out\n107\t    })\n108\t    .as_path()\n109\t}\n110\t\n111\t/// The C executable.  Prefers the CMake build (`c_src/build/driver`, the build\n112\t/// the task prescribes) and falls back to a plain `gcc -o` build, which uses the\n113\t/// same flags CMake does without a `CMAKE_BUILD_TYPE`.\n114\tpub fn c_exe_path() -> &'static Path {\n115\t    static P: OnceLock<PathBuf> = OnceLock::new();\n116\t    P.get_or_init(|| {\n117\t        let cmake = manifest_dir().join(\"c_src/build/driver\");\n118\t        if cmake.is_file() {\n119\t            return cmake;\n120\t        }\n121\t        let out = unique(\"driver_c\");\n122\t        run_tool(\n123\t            \"gcc (C executable)\",\n124\t            Command::new(\"gcc\").arg(\"-o\").arg(&out).arg(c_source()),\n125\t        );\n126\t        out\n127\t    })\n128\t    .as_path()\n129\t}\n130\t\n131\t/// The cargo-built Rust executable.\n132\tpub fn rust_exe_path() -> &'static Path {\n133\t    Path::new(env!(\"CARGO_BIN_EXE_driver\"))\n134\t}\n135\t\n136\t/// Which flags to build the Rust cdylib with.  `dev` mirrors the default cargo\n137\t/// profile, `release` mirrors `[profile.release]` (`panic = \"abort\"`, optimised).\n138\tpub fn rust_so_profile() -> String {\n139\t    std::env::var(\"RUST_SO_PROFILE\").unwrap_or_else(|_| \"dev\".to_string())\n140\t}\n141\t\n142\t/// `rustc --crate-type cdylib -o libdriver_rs.so src/lib.rs`\n143\tpub fn rust_so_path() -> &'static Path {\n144\t    static P: OnceLock<PathBuf> = OnceLock::new();\n145\t    P.get_or_init(|| {\n146\t        let profile = rust_so_profile();\n147\t        let out = unique(&format!(\"libdriver_rs_{profile}.so\"));\n148\t        let mut cmd = Command::new(\"rustc\");\n149\t        cmd.arg(\"--edition\")\n150\t            .arg(\"2021\")\n151\t            .arg(\"--crate-type\")\n152\t            .arg(\"cdylib\")\n153\t            .arg(\"--crate-name\")\n154\t            .arg(\"driver\")\n155\t            .arg(\"-A\")\n156\t            .arg(\"warnings\");\n157\t        match profile.as_str() {\n158\t            \"dev\" => {\n159\t                cmd.arg(\"-C\").arg(\"opt-level=0\");\n160\t                cmd.arg(\"-C\").arg(\"debug-assertions=on\");\n161\t                cmd.arg(\"-C\").arg(\"overflow-checks=on\");\n162\t            }\n163\t            \"release\" => {\n164\t                cmd.arg(\"-C\").arg(\"opt-level=3\");\n165\t                cmd.arg(\"-C\").arg(\"debug-assertions=off\");\n166\t                cmd.arg(\"-C\").arg(\"overflow-checks=off\");\n167\t                cmd.arg(\"-C\").arg(\"panic=abort\");\n168\t            }\n169\t            other => panic!(\"unknown RUST_SO_PROFILE {other:?} (expected dev|release)\"),\n170\t        }\n171\t        cmd.arg(\"-o\").arg(&out).arg(manifest_dir().join(\"src/lib.rs\"));\n172\t        run_tool(\"rustc (Rust cdylib)\", &mut cmd);\n173\t        out\n174\t    })\n175\t    .as_path()\n176\t}\n177\t\n178\t// ---------------------------------------------------------------------------\n179\t// The two implementations, loaded through libloading\n180\t// ---------------------------------------------------------------------------\n181\t\n182\tpub type DriverFn = unsafe extern \"C\" fn(c_int);\n183\tpub type DriverWideFn = unsafe extern \"C\" fn(i64);\n184\tpub type MainFn = unsafe extern \"C\" fn() -> c_int;\n185\t\n186\tpub struct Impl {\n187\t    pub name: &'static str,\n188\t    _lib: libloading::Library,\n189\t    pub driver: DriverFn,\n190\t    /// The very same `driver` symbol, but declared as taking a 64-bit argument\n191\t    /// so the tests can push out-of-range values across the ABI boundary.\n192\t    pub driver_wide: DriverWideFn,\n193\t    pub main: MainFn,\n194\t}\n195\t\n196\timpl Impl {\n197\t    fn load(name: &'static str, path: &Path) -> Impl {\n198\t        unsafe {\n199\t            let lib = libloading::Library::new(path)\n200\t                .unwrap_or_else(|e| panic!(\"dlopen({}) failed: {e}\", path.display()));\n201\t            // Inner scope so the `Symbol` borrows of `lib` end before `lib` is\n202\t            // moved into the struct; the extracted values are plain fn pointers.\n203\t            let (driver, driver_wide, main) = {\n204\t                let d: libloading::Symbol<DriverFn> = lib\n205\t                    .get(b\"driver\\0\")\n206\t                    .unwrap_or_else(|e| panic!(\"{name}: no `driver` symbol: {e}\"));\n207\t                let w: libloading::Symbol<DriverWideFn> = lib.get(b\"driver\\0\").unwrap();\n208\t                let m: libloading::Symbol<MainFn> = lib\n209\t                    .get(b\"main\\0\")\n210\t                    .unwrap_or_else(|e| panic!(\"{name}: no `main` symbol: {e}\"));\n211\t                (*d, *w, *m)\n212\t            };\n213\t            Impl {\n214\t                name,\n215\t                _lib: lib,\n216\t                driver,\n217\t                driver_wide,\n218\t                main,\n219\t            }\n220\t        }\n221\t    }\n222\t}\n223\t\n224\t/// Both implementations, loaded once per test process.\n225\tpub struct Pair {\n226\t    pub c: Impl,\n227\t    pub rs: Impl,\n228\t}\n229\t\n230\tpub fn pair() -> &'static Pair {\n231\t    static P: OnceLock<Pair> = OnceLock::new();\n232\t    P.get_or_init(|| {\n233\t        let p = Pair {\n234\t            c: Impl::load(\"C\", c_so_path()),\n235\t            rs: Impl::load(\"Rust\", rust_so_path()),\n236\t        };\n237\t        // Warm both libraries up (lazy statics, stdio buffers) before any\n238\t        // fork(), so the forked children inherit fully initialised state.\n239\t        let _ = capture_in_process(|| unsafe { (p.c.driver)(0) });\n240\t        let _ = capture_in_process(|| unsafe { (p.rs.driver)(0) });\n241\t        p\n242\t    })\n243\t}\n244\t\n245\t// ---------------------------------------------------------------------------\n246\t// Capturing fd 1\n247\t// ---------------------------------------------------------------------------\n248\t\n249\tfn next_id() -> u64 {\n250\t    static N: AtomicU64 = AtomicU64::new(0);\n251\t    N.fetch_add(1, Ordering::SeqCst)\n252\t}\n253\t\n254\tfn scratch_file(tag: &str) -> PathBuf {\n255\t    tmp_dir().join(format!(\n256\t        \"{tag}.{}.{}.bin\",\n257\t        std::process::id(),\n258\t        next_id()\n259\t    ))\n260\t}\n261\t\n262\t/// Run `f` with fd 1 redirected to a fresh regular file and return everything\n263\t/// that was written (after flushing C stdio, which `printf` buffers).\n264\t///\n265\t/// NOTE: fd 1 is process-global and libtest also writes its progress lines\n266\t/// there from another thread, so this in-process variant is only used for the\n267\t/// one-off warm-up in [`pair`].  Everything that is compared goes through\n268\t/// [`capture_child`], which redirects fd 1 in a forked child and therefore\n269\t/// cannot pick up the harness's own output.\n270\tfn capture_in_process(f: impl FnOnce()) -> Vec<u8> {\n271\t    let _guard = capture_lock();\n272\t    let path = scratch_file(\"capture\");\n273\t    let bytes = {\n274\t        let file = fs::File::create(&path).unwrap();\n275\t        let _ = io::stdout().flush();\n276\t        unsafe {\n277\t            fflush(std::ptr::null_mut());\n278\t        }\n279\t        let saved = unsafe { dup(1) };\n280\t        assert!(saved >= 0, \"dup(1) failed\");\n281\t        assert!(unsafe { dup2(file.as_raw_fd(), 1) } >= 0, \"dup2 failed\");\n282\t        f();\n283\t        unsafe {\n284\t            fflush(std::ptr::null_mut());\n285\t        }\n286\t        let _ = io::stdout().flush();\n287\t        assert!(unsafe { dup2(saved, 1) } >= 0, \"dup2 restore failed\");\n288\t        unsafe {\n289\t            close(saved);\n290\t        }\n291\t        drop(file);\n292\t        fs::read(&path).unwrap()\n293\t    };\n294\t    let _ = fs::remove_file(&path);\n295\t    bytes\n296\t}\n297\t\n298\t/// Run `f` in a forked child whose fd 1 is a fresh regular file, and return\n299\t/// what it wrote plus how the child terminated.\n300\tpub fn capture_child(f: impl FnOnce()) -> Run {\n301\t    run_child(Stdin::Inherit, Stdout::File, || {\n302\t        f();\n303\t        0\n304\t    })\n305\t}\n306\t\n307\t/// Same, but the child's fd 1 is a pipe (stdio picks a different buffering mode\n308\t/// for non-seekable streams).\n309\tpub fn capture_child_piped(f: impl FnOnce()) -> Run {\n310\t    run_child(Stdin::Inherit, Stdout::Pipe, || {\n311\t        f();\n312\t        0\n313\t    })\n314\t}\n315\t\n316\t/// `pipe(2)`, returning `(read_end, write_end)`.\n317\tpub fn make_pipe() -> (c_int, c_int) {\n318\t    let mut fds = [0 as c_int; 2];\n319\t    assert_eq!(unsafe { pipe(fds.as_mut_ptr()) }, 0, \"pipe() failed\");\n320\t    (fds[0], fds[1])\n321\t}\n322\t\n323\t/// `close(2)`.\n324\tpub fn close_fd(fd: c_int) {\n325\t    unsafe {\n326\t        close(fd);\n327\t    }\n328\t}\n329\t\n330\t// ---------------------------------------------------------------------------\n331\t// Running the exported `main` in a forked child\n332\t// ---------------------------------------------------------------------------\n333\t\n334\t#[derive(Debug, PartialEq, Eq, Clone, Copy)]\n335\tpub enum Status {\n336\t    Exited(i32),\n337\t    Signaled(i32),\n338\t}\n339\t\n340\tfn decode_status(st: c_int) -> Status {\n341\t    if st & 0x7f == 0 {\n342\t        Status::Exited((st >> 8) & 0xff)\n343\t    } else {\n344\t        Status::Signaled(st & 0x7f)\n345\t    }\n346\t}\n347\t\n348\t#[derive(Debug, PartialEq, Eq, Clone)]\n349\tpub struct Run {\n350\t    pub out: Vec<u8>,\n351\t    pub status: Status,\n352\t}\n353\t\n354\t/// How the child's stdin is provided.\n355\t#[derive(Clone, Copy, PartialEq, Eq, Debug)]\n356\tpub enum Stdin<'a> {\n357\t    /// A regular (seekable) file holding these bytes.\n358\t    File(&'a [u8]),\n359\t    /// A pipe pre-filled with these bytes (must fit in the pipe buffer).\n360\t    Pipe(&'a [u8]),\n361\t    /// fd 0 closed.\n362\t    Closed,\n363\t    /// fd 0 open on a directory.\n364\t    Directory,\n365\t    /// Leave the parent's fd 0 in place.\n366\t    Inherit,\n367\t}\n368\t\n369\t/// How the child's stdout is provided.\n370\t#[derive(Clone, Copy, PartialEq, Eq, Debug)]\n371\tpub enum Stdout {\n372\t    /// A regular file whose contents are returned.\n373\t    File,\n374\t    /// A pipe drained by the parent.\n375\t    Pipe,\n376\t    /// A pipe whose read end is closed before the call (EPIPE / SIGPIPE).\n377\t    ClosedPipe,\n378\t    /// fd 1 closed (EBADF).\n379\t    Closed,\n380\t    /// `/dev/full` (ENOSPC on flush).\n381\t    DevFull,\n382\t}\n383\t\n384\t/// Fork, wire up fd 0 / fd 1 as requested, run `f` in the child, and collect\n385\t/// its output and exit status.  `f` only calls into a `dlopen`ed library, so the\n386\t/// child does essentially no work of its own; its return value becomes the\n387\t/// child's exit code.\n388\tpub fn run_child(stdin: Stdin<'_>, stdout: Stdout, f: impl FnOnce() -> c_int) -> Run {\n389\t    // Serialised together with the fd-1 captures: `fork()` must not race with\n390\t    // another thread that is temporarily pointing fd 1 somewhere else.\n391\t    let _guard = capture_lock();\n392\t    // ---- set up stdin ----\n393\t    let mut in_file: Option<fs::File> = None;\n394\t    let mut in_pipe: Option<(c_int, c_int)> = None;\n395\t    let in_fd: Option<c_int> = match stdin {\n396\t        Stdin::File(data) => {\n397\t            let p = scratch_file(\"stdin\");\n398\t            fs::write(&p, data).unwrap();\n399\t            let f = fs::File::open(&p).unwrap();\n400\t            let fd = f.as_raw_fd();\n401\t            in_file = Some(f);\n402\t            let _ = fs::remove_file(&p);\n403\t            Some(fd)\n404\t        }\n405\t        Stdin::Pipe(data) => {\n406\t            assert!(\n407\t                data.len() < 60_000,\n408\t                \"pipe-backed stdin must fit in the pipe buffer ({} bytes)\",\n409\t                data.len()\n410\t            );\n411\t            let mut fds = [0 as c_int; 2];\n412\t            assert_eq!(unsafe { pipe(fds.as_mut_ptr()) }, 0);\n413\t            let mut off = 0usize;\n414\t            while off < data.len() {\n415\t                let n = unsafe { write(fds[1], data[off..].as_ptr(), data.len() - off) };\n416\t                assert!(n > 0, \"short write to pipe\");\n417\t                off += n as usize;\n418\t            }\n419\t            unsafe {\n420\t                close(fds[1]);\n421\t            }\n422\t            in_pipe = Some((fds[0], -1));\n423\t            Some(fds[0])\n424\t        }\n425\t        Stdin::Closed => Some(-2), // sentinel: close fd 0 in the child\n426\t        Stdin::Directory => {\n427\t            let f = fs::File::open(manifest_dir()).unwrap();\n428\t            let fd = f.as_raw_fd();\n429\t            in_file = Some(f);\n430\t            Some(fd)\n431\t        }\n432\t        Stdin::Inherit => None,\n433\t    };\n434\t\n435\t    // ---- set up stdout ----\n436\t    let out_path = scratch_file(\"stdout\");\n437\t    let mut out_file: Option<fs::File> = None;\n438\t    let mut out_pipe: Option<(c_int, c_int)> = None;\n439\t    let out_fd: c_int = match stdout {\n440\t        Stdout::File => {\n441\t            let f = fs::File::create(&out_path).unwrap();\n442\t            let fd = f.as_raw_fd();\n443\t            out_file = Some(f);\n444\t            fd\n445\t        }\n446\t        Stdout::Pipe | Stdout::ClosedPipe => {\n447\t            let mut fds = [0 as c_int; 2];\n448\t            assert_eq!(unsafe { pipe(fds.as_mut_ptr()) }, 0);\n449\t            if stdout == Stdout::ClosedPipe {\n450\t                unsafe {\n451\t                    close(fds[0]);\n452\t                }\n453\t                out_pipe = Some((-1, fds[1]));\n454\t            } else {\n455\t                out_pipe = Some((fds[0], fds[1]));\n456\t            }\n457\t            fds[1]\n458\t        }\n459\t        Stdout::Closed => -2, // sentinel: close fd 1 in the child\n460\t        Stdout::DevFull => {\n461\t            let f = fs::OpenOptions::new().write(true).open(\"/dev/full\").unwrap();\n462\t            let fd = f.as_raw_fd();\n463\t            out_file = Some(f);\n464\t            fd\n465\t        }\n466\t    };\n467\t\n468\t    let _ = io::stdout().flush();\n469\t    unsafe {\n470\t        fflush(std::ptr::null_mut());\n471\t    }\n472\t\n473\t    let pid = unsafe { fork() };\n474\t    assert!(pid >= 0, \"fork() failed\");\n475\t    if pid == 0 {\n476\t        // ---------------- child ----------------\n477\t        unsafe {\n478\t            match in_fd {\n479\t                Some(-2) => {\n480\t                    close(0);\n481\t                }\n482\t                Some(fd) => {\n483\t                    dup2(fd, 0);\n484\t                }\n485\t                None => {}\n486\t            }\n487\t            if out_fd == -2 {\n488\t                close(1);\n489\t            } else {\n490\t                dup2(out_fd, 1);\n491\t            }\n492\t            // A C program starts with SIGPIPE at SIG_DFL; the Rust test harness\n493\t            // set it to SIG_IGN, so restore the C default for both sides.\n494\t            signal(SIGPIPE, SIG_DFL);\n495\t            let rc = f();\n496\t            fflush(std::ptr::null_mut());\n497\t            _exit(rc & 0xff);\n498\t        }\n499\t    }\n500\t\n501\t    // ---------------- parent ----------------\n502\t    // Close our copies of the write ends so reads see EOF.\n503\t    if let Some((_, wr)) = out_pipe {\n504\t        if wr >= 0 {\n505\t            unsafe {\n506\t                close(wr);\n507\t            }\n508\t        }\n509\t    }\n510\t    let piped_out = out_pipe.and_then(|(rd, _)| {\n511\t        if rd < 0 {\n512\t            None\n513\t        } else {\n514\t            let mut buf = Vec::new();\n515\t            let mut f = unsafe { <fs::File as std::os::unix::io::FromRawFd>::from_raw_fd(rd) };\n516\t            f.read_to_end(&mut buf).unwrap();\n517\t            Some(buf)\n518\t        }\n519\t    });\n520\t\n521\t    let mut st: c_int = 0;\n522\t    let w = unsafe { waitpid(pid, &mut st, 0) };\n523\t    assert_eq!(w, pid, \"waitpid failed\");\n524\t    let status = decode_status(st);\n525\t\n526\t    let out = match stdout {\n527\t        Stdout::File => fs::read(&out_path).unwrap_or_default(),\n528\t        Stdout::Pipe => piped_out.unwrap_or_default(),\n529\t        _ => Vec::new(),\n530\t    };\n531\t\n532\t    // cleanup\n533\t    drop(out_file);\n534\t    drop(in_file);\n535\t    if let Some((rd, _)) = in_pipe {\n536\t        if rd >= 0 {\n537\t            unsafe {\n538\t                close(rd);\n539\t            }\n540\t        }\n541\t    }\n542\t    let _ = fs::remove_file(&out_path);\n543\t\n544\t    Run { out, status }\n545\t}\n546\t\n547\t/// Run the exported `main` of both implementations on the same stdin/stdout\n548\t/// wiring and assert the results are identical.\n549\t#[track_caller]\n550\tpub fn diff_main(stdin: Stdin<'_>, stdout: Stdout, label: &str) -> Run {\n551\t    let p = pair();\n552\t    let c = run_child(stdin, stdout, || unsafe { (p.c.main)() });\n553\t    let r = run_child(stdin, stdout, || unsafe { (p.rs.main)() });\n554\t    assert_eq!(\n555\t        (as_text(&c.out), c.status),\n556\t        (as_text(&r.out), r.status),\n557\t        \"`main` diverged for {label} (stdin={:?}, stdout={:?})\",\n558\t        Preview(stdin),\n559\t        stdout\n560\t    );\n561\t    c\n562\t}\n563\t\n564\t/// Run the exported `main` of both implementations against the same input bytes\n565\t/// (regular-file stdin, regular-file stdout) and assert equality.\n566\t#[track_caller]\n567\tpub fn diff_main_input(input: &[u8]) -> Run {\n568\t    diff_main(Stdin::File(input), Stdout::File, &preview(input))\n569\t}\n570\t\n571\t// ---------------------------------------------------------------------------\n572\t// driver differential helpers\n573\t// ---------------------------------------------------------------------------\n574\t\n575\t/// Call `driver` once per value in one forked child per implementation and\n576\t/// compare the two output streams.\n577\t#[track_caller]\n578\tpub fn diff_driver_batch(values: &[i32], label: &str) {\n579\t    let p = pair();\n580\t    let c = capture_child(|| {\n581\t        for &v in values {\n582\t            unsafe { (p.c.driver)(v) }\n583\t        }\n584\t    });\n585\t    let r = capture_child(|| {\n586\t        for &v in values {\n587\t            unsafe { (p.rs.driver)(v) }\n588\t        }\n589\t    });\n590\t    assert_eq!(\n591\t        (c.status, r.status),\n592\t        (Status::Exited(0), Status::Exited(0)),\n593\t        \"`driver` child terminated abnormally for {label}\"\n594\t    );\n595\t    assert_batch_eq(&c.out, &r.out, values, label);\n596\t}\n597\t\n598\t/// Same, through a pipe rather than a regular file.\n599\t#[track_caller]\n600\tpub fn diff_driver_batch_piped(values: &[i32], label: &str) {\n601\t    let p = pair();\n602\t    let c = capture_child_piped(|| {\n603\t        for &v in values {\n604\t            unsafe { (p.c.driver)(v) }\n605\t        }\n606\t    });\n607\t    let r = capture_child_piped(|| {\n608\t        for &v in values {\n609\t            unsafe { (p.rs.driver)(v) }\n610\t        }\n611\t    });\n612\t    assert_eq!(\n613\t        (c.status, r.status),\n614\t        (Status::Exited(0), Status::Exited(0)),\n615\t        \"`driver` child terminated abnormally for {label}\"\n616\t    );\n617\t    assert_batch_eq(&c.out, &r.out, values, label);\n618\t}\n619\t\n620\t/// The same `driver` symbol called with a 64-bit argument (out-of-range input\n621\t/// across the FFI boundary).\n622\t#[track_caller]\n623\tpub fn diff_driver_batch_wide(values: &[i64], label: &str) {\n624\t    let p = pair();\n625\t    let c = capture_child(|| {\n626\t        for &v in values {\n627\t            unsafe { (p.c.driver_wide)(v) }\n628\t        }\n629\t    });\n630\t    let r = capture_child(|| {\n631\t        for &v in values {\n632\t            unsafe { (p.rs.driver_wide)(v) }\n633\t        }\n634\t    });\n635\t    assert_eq!(\n636\t        (c.status, r.status),\n637\t        (Status::Exited(0), Status::Exited(0)),\n638\t        \"`driver` (wide) child terminated abnormally for {label}\"\n639\t    );\n640\t    let (c, r) = (c.out, r.out);\n641\t    assert_eq!(\n642\t        as_text(&c),\n643\t        as_text(&r),\n644\t        \"`driver` (wide argument) diverged for {label}; first values {:?}\",\n645\t        &values[..values.len().min(8)]\n646\t    );\n647\t    assert_eq!(c.len(), values.len() * 9, \"unexpected C output length\");\n648\t}\n649\t\n650\t#[track_caller]\n651\tfn assert_batch_eq(c: &[u8], r: &[u8], values: &[i32], label: &str) {\n652\t    if c != r {\n653\t        // Pin-point the first differing record for a useful message.\n654\t        let mut detail = String::new();\n655\t        for (i, v) in values.iter().enumerate() {\n656\t            let (a, b) = (\n657\t                c.get(i * 9..i * 9 + 9).unwrap_or(b\"<missing>\"),\n658\t                r.get(i * 9..i * 9 + 9).unwrap_or(b\"<missing>\"),\n659\t            );\n660\t            if a != b {\n661\t                detail = format!(\n662\t                    \"first divergence at index {i} (x = {v} / {:#010x}): C {:?} vs Rust {:?}\",\n663\t                    *v as u32,\n664\t                    String::from_utf8_lossy(a),\n665\t                    String::from_utf8_lossy(b)\n666\t                );\n667\t                break;\n668\t            }\n669\t        }\n670\t        panic!(\"`driver` diverged for {label}: {detail}\");\n671\t    }\n672\t    assert_eq!(\n673\t        c.len(),\n674\t        values.len() * 9,\n675\t        \"unexpected output length for {label}\"\n676\t    );\n677\t}\n678\t\n679\t// ---------------------------------------------------------------------------\n680\t// Process-level (executable) differential helper\n681\t// ---------------------------------------------------------------------------\n682\t\n683\t#[derive(Debug, PartialEq, Eq)]\n684\tpub struct ProcOut {\n685\t    pub out: Vec<u8>,\n686\t    pub status: Option<i32>,\n687\t    pub signal: Option<i32>,\n688\t}\n689\t\n690\tpub fn run_exe_with_file_stdin(exe: &Path, input: &[u8]) -> ProcOut {\n691\t    let p = scratch_file(\"exe-stdin\");\n692\t    fs::write(&p, input).unwrap();\n693\t    let f = fs::File::open(&p).unwrap();\n694\t    let out = Command::new(exe)\n695\t        .stdin(std::process::Stdio::from(f))\n696\t        .output()\n697\t        .unwrap();\n698\t    let _ = fs::remove_file(&p);\n699\t    use std::os::unix::process::ExitStatusExt;\n700\t    ProcOut {\n701\t        out: out.stdout,\n702\t        status: out.status.code(),\n703\t        signal: out.status.signal(),\n704\t    }\n705\t}\n706\t\n707\tpub fn run_exe_with_pipe_stdin(exe: &Path, input: &[u8]) -> ProcOut {\n708\t    use std::os::unix::process::ExitStatusExt;\n709\t    let mut child = Command::new(exe)\n710\t        .stdin(std::process::Stdio::piped())\n711\t        .stdout(std::process::Stdio::piped())\n712\t        .spawn()\n713\t        .unwrap();\n714\t    {\n715\t        let mut si = child.stdin.take().unwrap();\n716\t        // A separate thread keeps large inputs from dead-locking on the pipe.\n717\t        let data = input.to_vec();\n718\t        std::thread::spawn(move || {\n719\t            let _ = si.write_all(&data);\n720\t        });\n721\t    }\n722\t    let out = child.wait_with_output().unwrap();\n723\t    ProcOut {\n724\t        out: out.stdout,\n725\t        status: out.status.code(),\n726\t        signal: out.status.signal(),\n727\t    }\n728\t}\n729\t\n730\t#[track_caller]\n731\tpub fn diff_exe_file_stdin(input: &[u8]) {\n732\t    let c = run_exe_with_file_stdin(c_exe_path(), input);\n733\t    let r = run_exe_with_file_stdin(rust_exe_path(), input);\n734\t    assert_eq!(\n735\t        (as_text(&c.out), c.status, c.signal),\n736\t        (as_text(&r.out), r.status, r.signal),\n737\t        \"executables diverged for input {}\",\n738\t        preview(input)\n739\t    );\n740\t}\n741\t\n742\t#[track_caller]\n743\tpub fn diff_exe_pipe_stdin(input: &[u8]) {\n744\t    let c = run_exe_with_pipe_stdin(c_exe_path(), input);\n745\t    let r = run_exe_with_pipe_stdin(rust_exe_path(), input);\n746\t    assert_eq!(\n747\t        (as_text(&c.out), c.status, c.signal),\n748\t        (as_text(&r.out), r.status, r.signal),\n749\t        \"executables diverged (pipe stdin) for input {}\",\n750\t        preview(input)\n751\t    );\n752\t}\n753\t\n754\t// ---------------------------------------------------------------------------\n755\t// misc\n756\t// ---------------------------------------------------------------------------\n757\t\n758\tpub fn as_text(b: &[u8]) -> String {\n759\t    String::from_utf8_lossy(b).into_owned()\n760\t}\n761\t\n762\tpub fn preview(input: &[u8]) -> String {\n763\t    let shown: Vec<u8> = input.iter().copied().take(64).collect();\n764\t    let mut s = String::new();\n765\t    for b in shown {\n766\t        match b {\n767\t            b'\\n' => s.push_str(\"\\\\n\"),\n768\t            b'\\r' => s.push_str(\"\\\\r\"),\n769\t            b'\\t' => s.push_str(\"\\\\t\"),\n770\t            0x0b => s.push_str(\"\\\\v\"),\n771\t            0x0c => s.push_str(\"\\\\f\"),\n772\t            0x20..=0x7e => s.push(b as char),\n773\t            _ => s.push_str(&format!(\"\\\\x{b:02x}\")),\n774\t        }\n775\t    }\n776\t    format!(\"\\\"{s}\\\"{}\", if input.len() > 64 {\n777\t        format!(\" (+{} more bytes, {} total)\", input.len() - 64, input.len())\n778\t    } else {\n779\t        String::new()\n780\t    })\n781\t}\n782\t\n783\tstruct Preview<'a>(Stdin<'a>);\n784\timpl std::fmt::Debug for Preview<'_> {\n785\t    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n786\t        match self.0 {\n787\t            Stdin::File(d) => write!(f, \"File({})\", preview(d)),\n788\t            Stdin::Pipe(d) => write!(f, \"Pipe({})\", preview(d)),\n789\t            other => write!(f, \"{other:?}\"),\n790\t        }\n791\t    }\n792\t}\n793\t\n794\t/// SplitMix64 — fixed seed, so every \"randomised\" row is reproducible.\n795\tpub struct Rng(u64);\n796\t\n797\timpl Rng {\n798\t    pub fn new(seed: u64) -> Rng {\n799\t        Rng(seed)\n800\t    }\n801\t    pub fn next_u64(&mut self) -> u64 {\n802\t        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);\n803\t        let mut z = self.0;\n804\t        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);\n805\t        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);\n806\t        z ^ (z >> 31)\n807\t    }\n808\t    pub fn next_i32(&mut self) -> i32 {\n809\t        self.next_u64() as u32 as i32\n810\t    }\n811\t    /// Uniform in `0..n`.\n812\t    pub fn below(&mut self, n: u64) -> u64 {\n813\t        assert!(n > 0);\n814\t        self.next_u64() % n\n815\t    }\n816\t    pub fn pick<T: Copy>(&mut self, xs: &[T]) -> T {\n817\t        xs[self.below(xs.len() as u64) as usize]\n818\t    }\n819\t    pub fn digits(&mut self, n: usize) -> String {\n820\t        (0..n)\n821\t            .map(|i| {\n822\t                // Avoid a leading zero unless the caller wants one.\n823\t                let lo: u64 = if i == 0 && n > 1 { 1 } else { 0 };\n824\t                (b'0' + (lo + self.below(10 - lo)) as u8) as char\n825\t            })\n826\t            .collect()\n827\t    }\n828\t}\n829\t"}]},"parent_tool_use_id":"toolu_bdrk_01WWzRbn7bLfFQz47QHjaCxx","session_id":"64daaee6-dfd8-4ebc-87be-dd6361eb86bc","uuid":"28e80a09-a344-4748-81d6-d24f7811fc78","timestamp":"2026-08-18T09:48:37.070Z","subagent_type":"general-purpose","task_description":"Audit verification artifacts"}
