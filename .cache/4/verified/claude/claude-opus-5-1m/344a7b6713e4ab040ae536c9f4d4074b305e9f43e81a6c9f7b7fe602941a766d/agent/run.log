**32-1, 2**32,\n          2**32+1, 2**63-1, 2**63, 2**63+1, 2**64-1, 2**64, 2**64+1, 10**19, 10**20,\n          10**39, 10**40, 123456789, 4294967295, 4294967296, 9223372036854775807,\n          9223372036854775808, 18446744073709551615, 18446744073709551616]\nfor v in bounds:\n    for sgn in (\"\", \"-\", \"+\"):\n        for suffix in (b\"\", b\"\\n\", b\"\\r\\n\", b\" \", b\"x\", b\"junk\\n\", b\"\\n\\n\", b\"\\0\"):\n            cases.append((\"bound\", (sgn + str(v)).encode() + suffix))\n            cases.append((\"bound2\", (sgn + str(-v if v > 0 else v)).encode() + suffix))\n\n# 3. whitespace mixes\nws = [b\" \", b\"\\t\", b\"\\n\", b\"\\x0b\", b\"\\x0c\", b\"\\r\"]\nfor k in range(1, 4):\n    for combo in itertools.product(ws, repeat=k):\n        pre = b\"\".join(combo)\n        cases.append((\"ws\", pre + b\"42\"))\n        cases.append((\"ws_only\", pre))\n        cases.append((\"ws_mid\", b\"4\" + pre + b\"2\"))\n        cases.append((\"ws_sign\", pre + b\"-\" + b\"42\"))\n        cases.append((\"sign_ws\", b\"-\" + pre + b\"42\"))\n\n# 4. junk / signs / empties\njunk = [b\"\", b\"\\n\", b\"abc\", b\"-\", b\"+\", b\"--1\", b\"+-1\", b\"-+1\", b\"++1\", b\".\", b\".5\", b\"0x10\",\n        b\"0X10\", b\"010\", b\"1.5\", b\"1e5\", b\"1E5\", b\" - 1\", b\"-\\n1\", b\"\\0\", b\"\\x001\", b\"1\\x002\",\n        b\"inf\", b\"nan\", b\"NaN\", b\"INF\", b\"0b101\", b\"1_000\", b\"1,000\", b\"\\xff\", b\"\\xff\\xfe\",\n        b\"\\x80\\x81\", b\"1\\xff\", b\"\\xc3\\xa9\", b\"\\xe2\\x82\\xac\", b\"12x34\", b\"12-34\", b\"12+34\",\n        b\"1 2 3\", b\"junk\", b\"-0\", b\"+0\", b\"-00000\", b\"0\", b\"00\", b\"000000000000000000000\",\n        b\"9\" * 100, b\"-\" + b\"9\" * 100, b\"0\" * 5000 + b\"7\", b\"0\" * 4095 + b\"7\",\n        b\"0\" * 4096 + b\"7\", b\"0\" * 4097 + b\"7\", b\"0\" * 8191 + b\"7\", b\"0\" * 8192 + b\"7\",\n        b\"0\" * 8193 + b\"7\", b\" \" * 4095 + b\"7\", b\" \" * 4096 + b\"7\", b\" \" * 4097 + b\"7\",\n        b\" \" * 8191 + b\"7\", b\" \" * 8192 + b\"7\", b\" \" * 8193 + b\"7\",\n        b\"\\n\" * 4096 + b\"-7\", b\"\\t\" * 8192 + b\"+7\",\n        b\"9\" * 4095 + b\"\\n\", b\"9\" * 4096 + b\"\\n\", b\"9\" * 4097 + b\"\\n\",\n        b\"1\" * 4095 + b\"2\", b\"1\" * 4096 + b\"2\",\n        b\"\\x0b\\x0c 12\", b\"\\r\\n12\", b\"12\\r\", b\"12\\r\\n\", b\"12\\n\\r\",\n        b\"\\x1f\", b\"\\x7f\", b\"/\", b\":\", b\";\", b\"@\", b\"A\", b\"Z\", b\"a\", b\"z\",\n        b\"2147483647\", b\"2147483648\", b\"-2147483648\", b\"-2147483649\",\n        b\"4294967296\", b\"-4294967296\", b\"99999999999999999999\",\n        b\"-99999999999999999999\", b\"9223372036854775807\", b\"9223372036854775808\",\n        b\"-9223372036854775808\", b\"-9223372036854775809\",\n        b\"18446744073709551616\", b\"-18446744073709551616\",\n        b\"1\" + b\"0\" * 40, b\"-1\" + b\"0\" * 40,\n        ]\nfor j in junk:\n    cases.append((\"junk\", j))\n\n# 5. offsets: interesting byte exactly at 4095/4096/4097/8191/8192/8193\nfor off in (4094, 4095, 4096, 4097, 4098, 8190, 8191, 8192, 8193, 8194, 65535, 65536):\n    for filler, tail in ((b\" \", b\"123\"), (b\"0\", b\"5\"), (b\"\\n\", b\"-9\"), (b\"9\", b\"x\")):\n        cases.append((\"off%d\" % off, filler * off + tail))\n\nfor name, data in cases:\n    check(data, name)\n\n# 6. random ASCII / random bytes\nrandom.seed(0xC0FFEE)\nfor i in range(3000):\n    L = random.randint(0, 40)\n    check(bytes(random.choice(b\"0123456789+- \\t\\n\\r\\x0b\\x0cxX.,eE\\0abz\") for _ in range(L)),\n          \"randascii%d\" % i)\nfor i in range(3000):\n    L = random.randint(0, 40)\n    check(bytes(random.randrange(256) for _ in range(L)), \"randbytes%d\" % i)\nfor i in range(400):\n    L = random.randint(0, 200)\n    check(bytes(random.randrange(256) for _ in range(L)), \"randbig%d\" % i)\n\n# 7. multi-MB inputs\ncheck(b\" \" * (1 << 21) + b\"777\", \"mb_ws\")\ncheck(b\"0\" * (1 << 21) + b\"7\", \"mb_zeros\")\ncheck(b\"9\" * (1 << 21), \"mb_nines\")\ncheck(b\"1\" * (1 << 20) + b\"x\" + b\"junk\" * 1000, \"mb_junktail\")\ncheck(b\"\\n\" * (1 << 20) + b\"-5\\n\" + b\"A\" * (1 << 20), \"mb_nl\")\n\nprint(\"TOTAL cases: %d, mismatches: %d\" % (n, len(mismatches)))\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":921,"cache_read_input_tokens":31609,"cache_creation":{"ephemeral_5m_input_tokens":921,"ephemeral_1h_input_tokens":0},"output_tokens":6,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_014gkGHEagq3hVbvtNZNxU7K","session_id":"64daaee6-dfd8-4ebc-87be-dd6361eb86bc","uuid":"cf0166f1-9b8c-46d7-a2be-1f91dd834645","timestamp":"2026-08-18T09:50:10.554Z","subagent_type":"general-purpose","task_description":"Hunt for C/Rust divergences"}
