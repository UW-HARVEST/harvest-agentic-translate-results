ls.append(int.from_bytes(b, 'little', signed=True))\n    return vals, junk\n\n\nfor nt in [2, 4, 8]:\n    for trial in range(4):\n        for tag, so in SOS:\n            out, rc = run(so, 'main', nt, NTOK // nt, data)\n            vals, junk = decode(out)\n            c = collections.Counter(vals)\n            # tokens are 10..99; a value outside that range (except 0) proves a split\n            bogus = {v: n for v, n in c.items() if not (10 <= v <= 99)}\n            print('  nt=%d %-2s trial%d rc=%s recs=%d malformed=%d distinct=%d '\n                  'out_of_range=%s'\n                  % (nt, tag, trial, rc, len(vals), junk, len(c),\n                     dict(list(bogus.items())[:8])))\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1370,"cache_read_input_tokens":132262,"cache_creation":{"ephemeral_5m_input_tokens":1370,"ephemeral_1h_input_tokens":0},"output_tokens":21,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_01RBZxyASGUZ53uMKCoS83gM","session_id":"64daaee6-dfd8-4ebc-87be-dd6361eb86bc","uuid":"8e4fe152-6bda-4e46-822c-252a63c454dd","timestamp":"2026-08-18T10:55:05.570Z","subagent_type":"general-purpose","task_description":"Hunt divergences in new stream code"}
