{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01UxbjcCbJ3vrNo5odGKeK6S","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# Full verification matrix for the C-to-Rust translation.\n3\t#\n4\t#   * enumerates every cargo feature combination (the powerset of [features]),\n5\t#   * `cargo check`s each one,\n6\t#   * builds the C shared object and the C executable,\n7\t#   * runs the differential test suite for each feature combination against a\n8\t#     Rust cdylib built with the dev *and* the release flag set\n9\t#     (`[profile.release]` sets panic = \"abort\"), and in the release cargo\n10\t#     profile as well.\n11\t#\n12\t# Usage: scripts/verify_all.sh [--quick]\n13\tset -uo pipefail\n14\t\n15\tcd \"$(dirname \"$0\")/..\" || exit 1\n16\tROOT=$(pwd)\n17\tCARGO_FLAGS=(--offline)\n18\tFAILED=0\n19\tSUMMARY=()\n20\t\n21\tlog()  { printf '\\n\\033[1m== %s\\033[0m\\n' \"$*\"; }\n22\tnote() { printf '   %s\\n' \"$*\"; }\n23\t\n24\trecord() { # record <ok|FAIL> <description>\n25\t  SUMMARY+=(\"$1 $2\")\n26\t  [ \"$1\" = FAIL ] && FAILED=$((FAILED + 1))\n27\t  return 0\n28\t}\n29\t\n30\trun() { # run <description> <cmd...>\n31\t  local desc=$1; shift\n32\t  note \"\\$ $*\"\n33\t  if timeout 600 \"$@\" > \"${TMPDIR:-/tmp}/verify.log\" 2>&1; then\n34\t    record ok \"$desc\"\n35\t  else\n36\t    record FAIL \"$desc\"\n37\t    tail -n 40 \"${TMPDIR:-/tmp}/verify.log\"\n38\t  fi\n39\t}\n40\t\n41\t# ---------------------------------------------------------------------------\n42\t# 1. enumerate feature combinations (powerset of [features], minus \"default\")\n43\t# ---------------------------------------------------------------------------\n44\tmapfile -t FEATURES < <(\n45\t  awk '\n46\t    /^\\[features\\]/ { inside = 1; next }\n47\t    /^\\[/           { inside = 0 }\n48\t    inside && /^[A-Za-z0-9_-]+[ \\t]*=/ {\n49\t      split($0, a, \"=\");\n50\t      gsub(/[ \\t]/, \"\", a[1]);\n51\t      if (a[1] != \"default\") print a[1];\n52\t    }\n53\t  ' Cargo.toml\n54\t)\n55\tlog \"feature axes\"\n56\tif [ \"${#FEATURES[@]}\" -eq 0 ]; then\n57\t  note \"Cargo.toml declares no [features]; the only combination is the empty one\"\n58\telse\n59\t  note \"features: ${FEATURES[*]}\"\n60\tfi\n61\t\n62\tCOMBOS=(\"\")                        # the empty combination\n63\tn=${#FEATURES[@]}\n64\tif [ \"$n\" -gt 0 ]; then\n65\t  for ((mask = 1; mask < (1 << n); mask++)); do\n66\t    combo=\"\"\n67\t    for ((i = 0; i < n; i++)); do\n68\t      if (( (mask >> i) & 1 )); then combo=\"${combo:+$combo,}${FEATURES[i]}\"; fi\n69\t    done\n70\t    COMBOS+=(\"$combo\")\n71\t  done\n72\tfi\n73\tnote \"${#COMBOS[@]} combination(s) to verify\"\n74\t\n75\t# ---------------------------------------------------------------------------\n76\t# 2. cargo check every combination (plus the default-features build)\n77\t# ---------------------------------------------------------------------------\n78\tlog \"cargo check\"\n79\trun \"check (default features)\" cargo check \"${CARGO_FLAGS[@]}\" --all-targets\n80\tfor combo in \"${COMBOS[@]}\"; do\n81\t  if [ -z \"$combo\" ]; then\n82\t    run \"check --no-default-features\" \\\n83\t      cargo check \"${CARGO_FLAGS[@]}\" --no-default-features --all-targets\n84\t  else\n85\t    run \"check --no-default-features --features $combo\" \\\n86\t      cargo check \"${CARGO_FLAGS[@]}\" --no-default-features --features \"$combo\" --all-targets\n87\t  fi\n88\tdone\n89\t\n90\t# ---------------------------------------------------------------------------\n91\t# 3. build the C artefacts (CMake executable + shared object)\n92\t# ---------------------------------------------------------------------------\n93\tlog \"C build\"\n94\tmkdir -p c_src/build\n95\t( cd c_src/build && cmake .. -DCMAKE_POSITION_INDEPENDENT_CODE=ON && cmake --build . ) \\\n96\t  > \"${TMPDIR:-/tmp}/cmake.log\" 2>&1 \\\n97\t  && record ok \"cmake build (C executable)\" \\\n98\t  || { record FAIL \"cmake build (C executable)\"; tail -n 20 \"${TMPDIR:-/tmp}/cmake.log\"; }\n99\tmkdir -p build_c\n100\trun \"gcc -shared (C shared object)\" \\\n101\t  gcc -shared -fPIC -o build_c/libdriver_c.so c_src/src/main.c\n102\t\n103\t# ---------------------------------------------------------------------------\n104\t# 4. build the cargo artefacts so the symbol test sees them, then run the suite\n105\t#    for every combination x every Rust cdylib flag set.\n106\t# ---------------------------------------------------------------------------\n107\tlog \"cargo build (both profiles, so target/{debug,release}/libdriver.so exist)\"\n108\trun \"build (dev)\"     cargo build \"${CARGO_FLAGS[@]}\"\n109\trun \"build (release)\" cargo build \"${CARGO_FLAGS[@]}\" --release\n110\t\n111\tlog \"differential test suite\"\n112\tfor combo in \"${COMBOS[@]}\"; do\n113\t  for so_profile in dev release; do\n114\t    for cargo_profile in dev release; do\n115\t      args=(test \"${CARGO_FLAGS[@]}\")\n116\t      desc=\"tests\"\n117\t      if [ -z \"$combo\" ]; then\n118\t        args+=(--no-default-features); desc=\"$desc [no-default-features]\"\n119\t      else\n120\t        args+=(--no-default-features --features \"$combo\"); desc=\"$desc [features=$combo]\"\n121\t      fi\n122\t      [ \"$cargo_profile\" = release ] && { args+=(--release); }\n123\t      desc=\"$desc cargo=$cargo_profile so=$so_profile\"\n124\t      note \"\\$ RUST_SO_PROFILE=$so_profile cargo ${args[*]} -- --test-threads=1\"\n125\t      if RUST_SO_PROFILE=$so_profile timeout 600 cargo \"${args[@]}\" -- --test-threads=1 \\\n126\t           > \"${TMPDIR:-/tmp}/verify.log\" 2>&1; then\n127\t        record ok \"$desc\"\n128\t        grep -E \"^test result:\" \"${TMPDIR:-/tmp}/verify.log\" | sed 's/^/     /'\n129\t      else\n130\t        record FAIL \"$desc\"\n131\t        tail -n 40 \"${TMPDIR:-/tmp}/verify.log\"\n132\t      fi\n133\t    done\n134\t  done\n135\tdone\n136\t\n137\t# also once with the default feature set, in parallel-test mode\n138\tlog \"default feature set, parallel tests\"\n139\trun \"tests [default features] parallel\" cargo test \"${CARGO_FLAGS[@]}\"\n140\t\n141\t# ---------------------------------------------------------------------------\n142\t# 5. summary\n143\t# ---------------------------------------------------------------------------\n144\tlog \"summary\"\n145\tfor line in \"${SUMMARY[@]}\"; do\n146\t  case \"$line\" in\n147\t    ok*)   printf '   \\033[32m%s\\033[0m\\n' \"$line\" ;;\n148\t    FAIL*) printf '   \\033[31m%s\\033[0m\\n' \"$line\" ;;\n149\t  esac\n150\tdone\n151\tif [ \"$FAILED\" -eq 0 ]; then\n152\t  printf '\\n\\033[32mALL %d STEPS PASSED\\033[0m\\n' \"${#SUMMARY[@]}\"\n153\telse\n154\t  printf '\\n\\033[31m%d of %d STEPS FAILED\\033[0m\\n' \"$FAILED\" \"${#SUMMARY[@]}\"\n155\tfi\n156\texit \"$FAILED\"\n157\t"}]},"parent_tool_use_id":"toolu_bdrk_01WWzRbn7bLfFQz47QHjaCxx","session_id":"64daaee6-dfd8-4ebc-87be-dd6361eb86bc","uuid":"0cad5512-d051-4927-b252-4e14f4dbb391","timestamp":"2026-08-18T09:48:13.712Z","subagent_type":"general-purpose","task_description":"Audit verification artifacts"}
