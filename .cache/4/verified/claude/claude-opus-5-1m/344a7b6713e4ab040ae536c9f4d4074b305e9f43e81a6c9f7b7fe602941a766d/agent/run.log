t            }\n249\t            // Every failed `read` — `EINTR` included — makes glibc's\n250\t            // `_IO_new_file_underflow` set the stream's error indicator and\n251\t            // report end of input; it never retries.\n252\t            Err(_) => {\n253\t                self.eof = true;\n254\t                None\n255\t            }\n256\t        }\n257\t    }\n258\t\n259\t    /// Consume the next byte. Every call site peeks first, so the byte is\n260\t    /// already cached; peeking again keeps this correct regardless.\n261\t    fn bump(&mut self) {\n262\t        if self.peeked.is_none() {\n263\t            let _ = self.peek();\n264\t        }\n265\t        self.peeked = None;\n266\t    }\n267\t}\n268\t\n269\t/// C `isspace` for the default \"C\" locale (note: includes vertical tab, which\n270\t/// Rust's `u8::is_ascii_whitespace` omits).\n271\tfn c_isspace(b: u8) -> bool {\n272\t    matches!(b, b' ' | b'\\t' | b'\\n' | 0x0b | b'\\x0c' | b'\\r')\n273\t}\n274\t\n275\t/// Emulates `scanf(\"%d\", &x)`: leading whitespace (including newlines) is\n276\t/// skipped, then an optional sign followed by decimal digits is consumed.\n277\t/// Returns `None` on input failure or matching failure, in which case the\n278\t/// caller's variable is left untouched (as in C).\n279\t///\n280\t/// On overflow glibc's `%d` saturates at `LONG_MAX`/`LONG_MIN` (its internal\n281\t/// `strtol` behavior) and then truncates the result to `int`; that is\n282\t/// reproduced here.\n283\tpub fn scan_i32<R: Read>(sc: &mut Scanner<R>) -> Option<i32> {\n284\t    // Skip leading whitespace; EOF here is an input failure.\n285\t    loop {\n286\t        match sc.peek() {\n287\t            Some(b) if c_isspace(b) => sc.bump(),\n288\t            Some(_) => break,\n289\t            None => return None,\n290\t        }\n291\t    }\n292\t\n293\t    let mut negative = false;\n294\t    match sc.peek() {\n295\t        Some(b'+') => sc.bump(),\n296\t        Some(b'-') => {\n297\t            negati