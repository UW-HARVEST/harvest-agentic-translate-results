ntf(\"confusion(%d,%d,%d,%d) = %d\\n\", vals[i],vals[j],vals[k],vals[m], r);\n    }\n\n    /* ---- 2. direct API exercise, incl. NULL / edge capacities ---- */\n    printf(\"-- null handling --\\n\");\n    printf(\"process_buffer(NULL,'a') = %d\\n\", process_buffer(NULL,'a'));\n    update_flags(NULL, 12345);\n    printf(\"confuse_types(NULL,0) = %d\\n\", confuse_types(NULL,0));\n    destroy_state(NULL);\n\n    printf(\"-- negative / huge capacity --\\n\");\n    void* bad = create_state(42, -1);\n    printf(\"create_state(42,-1) null? %d\\n\", bad==NULL);\n    bad = create_state(42, -1000000);\n    printf(\"create_state(42,-1000000) null? %d\\n\", bad==NULL);\n\n    printf(\"-- tiny capacities --\\n\");\n    for (int cap=1; cap<=20; cap++) {\n        void* s = create_state(123456, cap);\n        if (!s) { printf(\"cap=%d -> NULL\\n\", cap); continue; }\n        printf(\"cap=%d buffer=\\\"%s\\\" capacity=%d\\n\", cap, *(char**)((char*)s+8), *(int*)((char*)s+16));\n        printf(\"  pb('3')=%d pb('0')=%d pb('e')=%d pb('\\\\0')=%d\\n\",\n               process_buffer(s,'3'), process_buffer(s,'0'),\n               process_buffer(s,'e'), process_buffer(s,'\\0'));\n        destroy_state(s);\n    }\n\n    printf(\"-- struct bytes after create_state --\\n\");\n    for (int iv=-3; iv<=3; iv++) {\n        unsigned char* s = (unsigned char*)create_state(iv*1000, 64);\n        printf(\"iv=%d flagword=%08x data=%08x cap=%d\\n\", iv*1000,\n               *(unsigned int*)s, *(unsigned int*)(s+4), *(int*)(s+16));\n        destroy_state(s);\n    }\n\n    printf(\"-- update_flags sweep + flag word --\\n\");\n    for (int p=-40; p<=40; p++) {\n        unsigned char* s = (unsigned char*)create_state(7, 64);\n        for (int rep=0; rep<3; rep++) update_flags(s, p+rep);\n        printf(\"p=%d flagword=%08x\\n\", p, *(unsigned int*)s);\n        destroy_state(s);\n    }\n    printf(\"-- counter wraparound (40 updates) --\\n\");\n    { unsigned char* s = (unsigned char*)create_state(1, 64);\n      for (int rep=0; rep<40; rep++) { update_flags(s, rep); printf(\"  rep=%d flagword=%08x\\n\", rep, *(unsigned int*)s); }\n      destroy_state(s); }\n\n    printf(\"-- confuse_types all operations x many int_val bit patterns --\\n\");\n    unsigned int pats[] = {0u,1u,2u,0x7Fu,0x80u,0xFFu,0x100u,0x7FFFu,0x8000u,0xFFFFu,\n        0x40490FDBu,0x3F800000u,0x40000000u,0x4F000000u,0x4EFFFFFFu,0x7F800000u,\n        0xFF800000u,0x7FC00000u,0x7FFFFFFFu,0x80000000u,0xCF000000u,0xCF000001u,\n        0xBF800000u,0x00000001u,0x00800000u,0x477FFF00u,0x4B7FFFFFu,0x4B800000u,\n        0x4F7FFFFFu,0xFFFFFFFFu,0x80808080u,0x7F7FFFFFu,0x4C000000u,0xCC000000u};\n    int np = sizeof(pats)/sizeof(pats[0]);\n    for (int i=0;i<np;i++) {\n        for (int op=-2; op<=6; op++) {\n            unsigned char* s = (unsigned char*)create_state(0, 64);\n            *(unsigned int*)(s+4) = pats[i];            /* plant the union bits */\n            int r = confuse_types(s, op);\n            printf(\"pat=%08x op=%d -> %d (data now %08x)\\n\", pats[i], op, r, *(unsigned int*)(s+4));\n            destroy_state(s);\n        }\n    }\n\n    printf(\"-- process_buffer over crafted buffers --\\n\");\n    const char* samples[] = {\"\", \"a\", \"aaaa\", \"abcabcabc\", \"0123456789\",\n        \"\\x01\\x02\\x03\\x7f\", \"\\x80\\x81\\xfe\\xff\", \"xx\\xffxx\\xff\", \"State:0:Mode:3\"};\n    for (int i=0;i<9;i++) {\n        unsigned char* s = (unsigned char*)create_state(0, 64);\n        strcpy(*(char**)(s+8), samples[i]);\n        for (int ch=-128; ch<128; ch++) {\n            int r = process_buffer(s, (char)ch);\n            if (r) printf(\"sample=%d ch=%d -> %d\\n\", i, ch, r);\n        }\n        printf(\"sample=%d done\\n\", i);\n        destroy_state(s);\n    }\n\n    printf(\"-- all-in-one repeated sequences --\\n\");\n    for (int seed=0; seed<50; seed++) {\n        unsigned char* s = (unsigned char*)create_state(seed*7919-100000, 128);\n        update_flags(s, seed*13);\n        printf(\"  pb=