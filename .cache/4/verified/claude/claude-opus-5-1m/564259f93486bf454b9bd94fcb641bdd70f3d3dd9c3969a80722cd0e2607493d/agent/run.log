mbing_reports_clean_exit() {\n    let h = Harness::new();\n    let s1 = b\"hello\\0\";\n    let s2 = b\"lo\\0\";\n    let out = h.assert_same_outcome(\n        \"clean call in child\",\n        s1.as_ptr() as *const std::ffi::c_char,\n        s2.as_ptr() as *const std::ffi::c_char,\n    );\n    assert!(out.exited && out.exit_status == 0, \"child should exit cleanly: {out:?}\");\n    assert_eq!(out.printed, b\"3\\n\", \"strcspn(\\\"hello\\\",\\\"lo\\\") == 3\");\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
