         newest = Some((p, t));\n                    }\n                }\n            }\n        }\n    }\n\n    if let Some((src, src_mtime)) = newest {\n        assert!(\n            so_mtime >= src_mtime,\n            \"STALE ARTIFACT: {} is older than {}.\\n\\\n             The differential tests would be comparing the C library against an \\\n             out-of-date Rust build, so they could not detect ANY divergence.\\n\\\n             Rebuild with `cargo build --no-default-features` (and keep \\\n             crate-type = [\\\"lib\\\", \\\"cdylib\\\"] so cargo does this automatically).\",\n            so.display(),\n            src.display()\n        );\n    }\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1815,"cache_read_input_tokens":93200,"cache_creation":{"ephemeral_5m_input_tokens":1815,"ephemeral_1h_input_tokens":0},"output_tokens":17,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"f5095bf2-f73b-46dc-a5a6-800abd6dde4f","uuid":"798a182a-6658-4f4f-90dc-87d8c57de7a1","timestamp":"2026-08-19T18:36:41.922Z"}
