{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01HSS5ZCnU6UAUWCyaqptKVB","type":"tool_result","content":"1\t//! Translation of `c_src/src/lib.c` / `c_src/include/dag_lib.h`.\n2\t//!\n3\t//! The C code identifies nodes by their heap address and keeps dangling\n4\t//! pointers in `graph->nodes[]` after `delete_node()` frees a node.  To model\n5\t//! that faithfully (including the fact that a subsequent `malloc()` of the very\n6\t//! same size class hands the freed chunk back out, so the \"old\" pointer and the\n7\t//! \"new\" pointer alias) nodes live in an arena and are referenced by index; the\n8\t//! free lists below reproduce the order in which glibc recycles the chunks.\n9\t//!\n10\t//! A node whose storage has been released keeps its payload (there is nothing\n11\t//! deterministic to put there instead) but it can no longer be found by name:\n12\t//! in the real program the first 16 bytes of `city_name` are overwritten by the\n13\t//! allocator's book-keeping, so `strcmp()` against it never matches.\n14\t//!\n15\t//! The `!graph` / `!city_name` / `!node` guards of the C functions are omitted\n16\t//! where the caller can never pass a null pointer; the remaining checks keep\n17\t//! their original order.\n18\t\n19\tuse crate::cio::{die_abort, die_signal, err, Out};\n20\tuse std::collections::VecDeque;\n21\t\n22\tpub const MAX_CITY_NAME: usize = 64;\n23\tpub const MAX_EDGES: usize = 10;\n24\tpub const MAX_NODES: usize = 100;\n25\t\n26\t/// `node_t *` equivalent: an index into `Graph::arena`.\n27\tpub type NodeRef = usize;\n28\t\n29\t#[derive(Clone, Copy)]\n30\tpub struct Edge {\n31\t    pub destination: NodeRef,\n32\t    pub distance: i32,\n33\t}\n34\t\n35\timpl Edge {\n36\t    const fn zeroed() -> Edge {\n37\t        Edge {\n38\t            destination: usize::MAX,\n39\t            distance: 0,\n40\t        }\n41\t    }\n42\t}\n43\t\n44\tpub struct Node {\n45\t    /// Contents of `char city_name[MAX_CITY_NAME]` up to the terminating NUL.\n46\t    pub city_name: Vec<u8>,\n47\t    pub ref_count: i32,\n48\t    pub edges: [Edge; MAX_EDGES],\n49\t    pub edge_count: i32,\n50\t    /// True while the node's storage is on the allocator's free list.\n51\t    pub freed: bool,\n52\t}\n53\t\n54\tpub struct Graph {\n55\t    /// `node_t *nodes[MAX_NODES]` (only the first `node_count` are meaningful).\n56\t    pub nodes: Vec<NodeRef>,\n57\t    pub node_count: i32,\n58\t    /// Backing storage for every node ever allocated.\n59\t    arena: Vec<Node>,\n60\t    /// Freed chunks held in the allocator's per-size-class cache (LIFO, at most\n61\t    /// `TCACHE_COUNT` entries, like glibc's tcache).\n62\t    tcache: Vec<NodeRef>,\n63\t    /// Freed chunks that did not fit in the cache; they are handed back out in\n64\t    /// the order they were released (glibc's unsorted bin behaviour).\n65\t    unsorted: VecDeque<NodeRef>,\n66\t}\n67\t\n68\t/// glibc's default `mp_.tcache_count`.\n69\tconst TCACHE_COUNT: usize = 7;\n70\t\n71\timpl Graph {\n72\t    /// `create_graph()`\n73\t    pub fn create_graph() -> Graph {\n74\t        Graph {\n75\t            nodes: vec![usize::MAX; MAX_NODES],\n76\t            node_count: 0,\n77\t            arena: Vec::new(),\n78\t            tcache: Vec::new(),\n79\t            unsorted: VecDeque::new(),\n80\t        }\n81\t    }\n82\t\n83\t    pub fn node(&self, r: NodeRef) -> &Node {\n84\t        &self.arena[r]\n85\t    }\n86\t\n87\t    fn node_mut(&mut self, r: NodeRef) -> &mut Node {\n88\t        &mut self.arena[r]\n89\t    }\n90\t\n91\t    /// `malloc(sizeof(node_t))`: hands back the most recently freed chunk if\n92\t    /// there is one, otherwise fresh storage.\n93\t    fn alloc_node(&mut self, city_name: &[u8]) -> NodeRef {\n94\t        // strncpy(node->city_name, city_name, MAX_CITY_NAME - 1);\n95\t        // node->city_name[MAX_CITY_NAME - 1] = '\\0';\n96\t        let copied = city_name.len().min(MAX_CITY_NAME - 1);\n97\t        let name: Vec<u8> = city_name[..copied].to_vec();\n98\t        let recycled = self.tcache.pop().or_else(|| self.unsorted.pop_front());\n99\t        match recycled {\n100\t            Some(r) => {\n101\t                let node = &mut self.arena[r];\n102\t                node.city_name = name;\n103\t                node.ref_count = 1;\n104\t                node.edge_count = 0;\n105\t                node.freed = false;\n106\t                r\n107\t            }\n108\t            None => {\n109\t                self.arena.push(Node {\n110\t                    city_name: name,\n111\t                    ref_count: 1,\n112\t                    edges: [Edge::zeroed(); MAX_EDGES],\n113\t                    edge_count: 0,\n114\t                    freed: false,\n115\t                });\n116\t                self.arena.len() - 1\n117\t            }\n118\t        }\n119\t    }\n120\t\n121\t    /// `add_node()`\n122\t    pub fn add_node(&mut self, city_name: &[u8]) -> Option<NodeRef> {\n123\t        if self.node_count >= MAX_NODES as i32 {\n124\t            err(format!(\"Error: Graph is full (max {} nodes)\\n\", MAX_NODES).as_bytes());\n125\t            return None;\n126\t        }\n127\t\n128\t        // Check if node already exists\n129\t        for i in 0..self.node_count as usize {\n130\t            let r = self.nodes[i];\n131\t            let node = &self.arena[r];\n132\t            if !node.freed && node.city_name.as_slice() == city_name {\n133\t                err(b\"Error: Node '\");\n134\t                err(city_name);\n135\t                err(b\"' already exists\\n\");\n136\t                return None;\n137\t            }\n138\t        }\n139\t\n140\t        let r = self.alloc_node(city_name);\n141\t\n142\t        // Add to graph\n143\t        let idx = self.node_count as usize;\n144\t        self.nodes[idx] = r;\n145\t        self.node_count += 1;\n146\t\n147\t        Some(r)\n148\t    }\n149\t\n150\t    /// `add_edge()`\n151\t    pub fn add_edge(&mut self, from: NodeRef, to: NodeRef, distance: i32) -> i32 {\n152\t        if self.arena[from].edge_count >= MAX_EDGES as i32 {\n153\t            err(b\"Error: Node '\");\n154\t            let name = self.arena[from].city_name.clone();\n155\t            err(&name);\n156\t            err(b\"' has maximum edges\\n\");\n157\t            return -1;\n158\t        }\n159\t\n160\t        if distance < 0 {\n161\t            err(b\"Error: Negative distance not allowed\\n\");\n162\t            return -1;\n163\t        }\n164\t\n165\t        // Check for duplicate edge\n166\t        for i in 0..self.arena[from].edge_count as usize {\n167\t            if self.arena[from].edges[i].destination == to {\n168\t                err(b\"Error: Edge already exists\\n\");\n169\t                return -1;\n170\t            }\n171\t        }\n172\t\n173\t        // Add edge\n174\t        let node = self.node_mut(from);\n175\t        let slot = node.edge_count as usize;\n176\t        node.edges[slot] = Edge {\n177\t            destination: to,\n178\t            distance,\n179\t        };\n180\t        node.edge_count += 1;\n181\t\n182\t        0\n183\t    }\n184\t\n185\t    /// `delete_node()`\n186\t    pub fn delete_node(&mut self, r: NodeRef) {\n187\t        let node = &mut self.arena[r];\n188\t        node.ref_count = node.ref_count.wrapping_sub(1);\n189\t\n190\t        if node.ref_count == 0 {\n191\t            // glibc notices a chunk that is still sitting in the per-size-class\n192\t            // cache being handed to free() a second time and aborts.\n193\t            if self.tcache.contains(&r) {\n194\t                err(b\"free(): double free detected in tcache 2\\n\");\n195\t                die_abort();\n196\t            }\n197\t            self.arena[r].freed = true;\n198\t            if self.tcache.len() < TCACHE_COUNT {\n199\t                self.tcache.push(r);\n200\t            } else {\n201\t                self.unsorted.push_back(r);\n202\t            }\n203\t        }\n204\t    }\n205\t\n206\t    /// `increment_refs_recursive()`\n207\t    fn increment_refs_recursive(&mut self, r: NodeRef, visited: &mut Vec<NodeRef>) {\n208\t        // Check if already visited\n209\t        for i in 0..visited.len() {\n210\t            if visited[i] == r {\n211\t                return;\n212\t            }\n213\t        }\n214\t\n215\t        // Mark as visited\n216\t        if visited.len() < MAX_NODES {\n217\t            visited.push(r);\n218\t        }\n219\t\n220\t        // Increment ref count\n221\t        {\n222\t            let node = &mut self.arena[r];\n223\t            node.ref_count = node.ref_count.wrapping_add(1);\n224\t        }\n225\t\n226\t        // Recursively process all connected nodes\n227\t        for i in 0..self.arena[r].edge_count as usize {\n228\t            let dest = self.arena[r].edges[i].destination;\n229\t            self.increment_refs_recursive(dest, visited);\n230\t        }\n231\t    }\n232\t\n233\t    /// `shallow_copy()`\n234\t    pub fn shallow_copy(&mut self, start: NodeRef) -> Option<NodeRef> {\n235\t        let mut visited: Vec<NodeRef> = Vec::new();\n236\t        self.increment_refs_recursive(start, &mut visited);\n237\t        Some(start)\n238\t    }\n239\t\n240\t    /// `find_shortest_path()`.  Returns the path and its length; the length is\n241\t    /// set to 0 when no path exists (mirroring `*path_length = 0`).\n242\t    pub fn find_shortest_path(&self, start: NodeRef, end: NodeRef) -> (Option<Vec<NodeRef>>, i32) {\n243\t        struct DijkstraNode {\n244\t            node: NodeRef,\n245\t            distance: i32,\n246\t            previous: Option<NodeRef>,\n247\t            visited: bool,\n248\t        }\n249\t\n250\t        let mut state: Vec<DijkstraNode> = Vec::with_capacity(MAX_NODES);\n251\t\n252\t        // Add start node\n253\t        state.push(DijkstraNode {\n254\t            node: start,\n255\t            distance: 0,\n256\t            previous: None,\n257\t            visited: false,\n258\t        });\n259\t\n260\t        let mut current: Option<NodeRef> = Some(start);\n261\t\n262\t        while let Some(cur) = current {\n263\t            // Find current node in state\n264\t            let mut current_idx: i32 = -1;\n265\t            for i in 0..state.len() {\n266\t                if state[i].node == cur {\n267\t                    current_idx = i as i32;\n268\t                    break;\n269\t                }\n270\t            }\n271\t\n272\t            if current_idx == -1 {\n273\t                break;\n274\t            }\n275\t            let current_idx = current_idx as usize;\n276\t\n277\t            state[current_idx].visited = true;\n278\t\n279\t            // Check if we reached the end\n280\t            if cur == end {\n281\t                break;\n282\t            }\n283\t\n284\t            // Update distances for neighbors\n285\t            for i in 0..self.arena[cur].edge_count as usize {\n286\t                let neighbor = self.arena[cur].edges[i].destination;\n287\t                let new_distance = state[current_idx]\n288\t                    .distance\n289\t                    .wrapping_add(self.arena[cur].edges[i].distance);\n290\t\n291\t                // Find or add neighbor in state\n292\t                let mut neighbor_idx: i32 = -1;\n293\t                for j in 0..state.len() {\n294\t                    if state[j].node == neighbor {\n295\t                        neighbor_idx = j as i32;\n296\t                        break;\n297\t                    }\n298\t                }\n299\t\n300\t                if neighbor_idx == -1 && state.len() < MAX_NODES {\n301\t                    // Add new neighbor\n302\t                    neighbor_idx = state.len() as i32;\n303\t                    state.push(DijkstraNode {\n304\t                        node: neighbor,\n305\t                        distance: i32::MAX,\n306\t                        previous: None,\n307\t                        visited: false,\n308\t                    });\n309\t                }\n310\t\n311\t                if neighbor_idx != -1 && new_distance < state[neighbor_idx as usize].distance {\n312\t                    let ni = neighbor_idx as usize;\n313\t                    state[ni].distance = new_distance;\n314\t                    state[ni].previous = Some(cur);\n315\t                }\n316\t            }\n317\t\n318\t            // Find next unvisited node with minimum distance\n319\t            let mut min_distance = i32::MAX;\n320\t            current = None;\n321\t            for i in 0..state.len() {\n322\t                if !state[i].visited && state[i].distance < min_distance {\n323\t                    min_distance = state[i].distance;\n324\t                    current = Some(state[i].node);\n325\t                }\n326\t            }\n327\t        }\n328\t\n329\t        // Find end node in state\n330\t        let mut end_idx: i32 = -1;\n331\t        for i in 0..state.len() {\n332\t            if state[i].node == end {\n333\t                end_idx = i as i32;\n334\t                break;\n335\t            }\n336\t        }\n337\t\n338\t        if end_idx == -1 || state[end_idx as usize].distance == i32::MAX {\n339\t            err(b\"No path found\\n\");\n340\t            return (None, 0);\n341\t        }\n342\t\n343\t        // Reconstruct path.\n344\t        //\n345\t        // `node_t *path[MAX_NODES]` is a fixed size array on the stack and the\n346\t        // `previous` links are not guaranteed to be acyclic (a distance\n347\t        // computation that overflows can make a node its own predecessor), so\n348\t        // this loop can write past the end of the array.  In the compiled\n349\t        // program `path[MAX_NODES]` is exactly `state[0].node`, i.e. the writes\n350\t        // walk over the Dijkstra state array that follows it on the stack:\n351\t        //\n352\t        //   path[100 + 4*k + 0] -> state[k].node\n353\t        //   path[100 + 4*k + 1] -> state[k].distance (+ padding)\n354\t        //   path[100 + 4*k + 2] -> state[k].previous\n355\t        //   path[100 + 4*k + 3] -> state[k].visited  (+ padding)\n356\t        //\n357\t        // Only `node` and `previous` are read again, so the clobbering of the\n358\t        // other two fields is invisible.  Past `state` come a few unused slots\n359\t        // and finally `count` itself (`path[507]`), and once that holds a heap\n360\t        // address the next write lands far outside the stack and the process\n361\t        // dies from a fatal signal.\n362\t        const STATE_SLOTS: usize = 4 * MAX_NODES;\n363\t        const COUNT_SLOT: usize = 507;\n364\t\n365\t        let mut path: Vec<NodeRef> = Vec::with_capacity(MAX_NODES);\n366\t        let mut current_node: Option<NodeRef> = Some(end);\n367\t\n368\t        while let Some(cn) = current_node {\n369\t            let slot = path.len();\n370\t            path.push(cn);\n371\t\n372\t            if slot >= MAX_NODES {\n373\t                let offset = slot - MAX_NODES;\n374\t                if offset < STATE_SLOTS {\n375\t                    let k = offset / 4;\n376\t                    let field = offset % 4;\n377\t                    if k < state.len() {\n378\t                        match field {\n379\t                            0 => state[k].node = cn,\n380\t                            2 => state[k].previous = Some(cn),\n381\t                            _ => {}\n382\t                        }\n383\t                    }\n384\t                } else if slot >= COUNT_SLOT {\n385\t                    die_signal();\n386\t                }\n387\t            }\n388\t\n389\t            // Find previous node\n390\t            let mut current_state_idx: i32 = -1;\n391\t            for i in 0..state.len() {\n392\t                if state[i].node == cn {\n393\t                    current_state_idx = i as i32;\n394\t                    break;\n395\t                }\n396\t            }\n397\t\n398\t            if current_state_idx == -1 {\n399\t                break;\n400\t            }\n401\t\n402\t            current_node = state[current_state_idx as usize].previous;\n403\t        }\n404\t\n405\t        // Reverse path\n406\t        let count = path.len();\n407\t        if count > MAX_NODES + STATE_SLOTS {\n408\t            // The entries stored beyond the state array read back as leftover\n409\t            // stack contents, which are not reproducible.\n410\t            die_signal();\n411\t        }\n412\t        let mut result: Vec<NodeRef> = Vec::with_capacity(count);\n413\t        for i in 0..count {\n414\t            result.push(path[count - 1 - i]);\n415\t        }\n416\t\n417\t        (Some(result), count as i32)\n418\t    }\n419\t\n420\t    /// `get_node_by_name()`\n421\t    pub fn get_node_by_name(&self, city_name: &[u8]) -> Option<NodeRef> {\n422\t        for i in 0..self.node_count as usize {\n423\t            let r = self.nodes[i];\n424\t            let node = &self.arena[r];\n425\t            if !node.freed && node.city_name.as_slice() == city_name {\n426\t                return Some(r);\n427\t            }\n428\t        }\n429\t\n430\t        None\n431\t    }\n432\t\n433\t    /// `print_node()`\n434\t    pub fn print_node(&self, out: &mut Out, r: NodeRef) {\n435\t        let node = &self.arena[r];\n436\t        out.s(\"City: \");\n437\t        out.write(&node.city_name);\n438\t        out.write(format!(\" (ref_count: {})\\n\", node.ref_count).as_bytes());\n439\t        out.s(\"  Edges:\\n\");\n440\t        for i in 0..node.edge_count as usize {\n441\t            let edge = node.edges[i];\n442\t            out.s(\"    -> \");\n443\t            out.write(&self.arena[edge.destination].city_name);\n444\t            out.write(format!(\" (distance: {})\\n\", edge.distance).as_bytes());\n445\t        }\n446\t    }\n447\t\n448\t    /// `print_graph()`\n449\t    pub fn print_graph(&self, out: &mut Out) {\n450\t        out.write(format!(\"Graph with {} nodes:\\n\", self.node_count).as_bytes());\n451\t        for i in 0..self.node_count as usize {\n452\t            self.print_node(out, self.nodes[i]);\n453\t        }\n454\t    }\n455\t\n456\t    /// `free_graph()`\n457\t    pub fn free_graph(&mut self) {\n458\t        // Decrement ref count for all nodes\n459\t        for i in 0..self.node_count as usize {\n460\t            let r = self.nodes[i];\n461\t            self.delete_node(r);\n462\t        }\n463\t    }\n464\t}\n465\t"}]},"parent_tool_use_id":null,"session_id":"7cbe813c-19c2-47a8-af02-55481fb2fa53","uuid":"3043182a-5ce8-4130-918b-042dc3f3f3b5","timestamp":"2026-08-19T22:42:27.552Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-IfPF80/translated_rust/src/dag_lib.rs","content":"//! Translation of `c_src/src/lib.c` / `c_src/include/dag_lib.h`.\n//!\n//! The C code identifies nodes by their heap address and keeps dangling\n//! pointers in `graph->nodes[]` after `delete_node()` frees a node.  To model\n//! that faithfully (including the fact that a subsequent `malloc()` of the very\n//! same size class hands the freed chunk back out, so the \"old\" pointer and the\n//! \"new\" pointer alias) nodes live in an arena and are referenced by index; the\n//! free lists below reproduce the order in which glibc recycles the chunks.\n//!\n//! A node whose storage has been released keeps its payload (there is nothing\n//! deterministic to put there instead) but it can no longer be found by name:\n//! in the real program the first 16 bytes of `city_name` are overwritten by the\n//! allocator's book-keeping, so `strcmp()` against it never matches.\n//!\n//! The `!graph` / `!city_name` / `!node` guards of the C functions are omitted\n//! where the caller can never pass a null pointer; the remaining checks keep\n//! their original order.\n\nuse crate::cio::{die_abort, die_signal, err, Out};\nuse std::collections::VecDeque;\n\npub const MAX_CITY_NAME: usize = 64;\npub const MAX_EDGES: usize = 10;\npub const MAX_NODES: usize = 100;\n\n/// `node_t *` equivalent: an index into `Graph::arena`.\npub type NodeRef = usize;\n\n#[derive(Clone, Copy)]\npub struct Edge {\n    pub destination: NodeRef,\n    pub distance: i32,\n}\n\nimpl Edge {\n    const fn zeroed() -> Edge {\n        Edge {\n            destination: usize::MAX,\n            distance: 0,\n        }\n    }\n}\n\npub struct Node {\n    /// Contents of `char city_name[MAX_CITY_NAME]` up to the terminating NUL.\n    pub city_name: Vec<u8>,\n    pub ref_count: i32,\n    pub edges: [Edge; MAX_EDGES],\n    pub edge_count: i32,\n    /// True while the node's storage is on the allocator's free list.\n    pub freed: bool,\n}\n\npub struct Graph {\n    /// `node_t *nodes[MAX_NODES]` (only the first `node_count` are meaningful).\n    pub nodes: Vec<NodeRef>,\n    pub node_count: i32,\n    /// Backing storage for every node ever allocated.\n    arena: Vec<Node>,\n    /// Freed chunks held in the allocator's per-size-class cache (LIFO, at most\n    /// `TCACHE_COUNT` entries, like glibc's tcache).\n    tcache: Vec<NodeRef>,\n    /// Freed chunks that did not fit in the cache; they are handed back out in\n    /// the order they were released (glibc's unsorted bin behaviour).\n    unsorted: VecDeque<NodeRef>,\n}\n\n/// glibc's default `mp_.tcache_count`.\nconst TCACHE_COUNT: usize = 7;\n\nimpl Graph {\n    /// `create_graph()`\n    pub fn create_graph() -> Graph {\n        Graph {\n            nodes: vec![usize::MAX; MAX_NODES],\n            node_count: 0,\n            arena: Vec::new(),\n            tcache: Vec::new(),\n            unsorted: VecDeque::new(),\n        }\n    }\n\n    pub fn node(&self, r: NodeRef) -> &Node {\n        &self.arena[r]\n    }\n\n    fn node_mut(&mut self, r: NodeRef) -> &mut Node {\n        &mut self.arena[r]\n    }\n\n    /// `malloc(sizeof(node_t))`: hands back the most recently freed chunk if\n    /// there is one, otherwise fresh storage.\n    fn alloc_node(&mut self, city_name: &[u8]) -> NodeRef {\n        // strncpy(node->city_name, city_name, MAX_CITY_NAME - 1);\n        // node->city_name[MAX_CITY_NAME - 1] = '\\0';\n        let copied = city_name.len().min(MAX_CITY_NAME - 1);\n        let name: Vec<u8> = city_name[..copied].to_vec();\n        let recycled = self.tcache.pop().or_else(|| self.unsorted.pop_front());\n        match recycled {\n            Some(r) => {\n                let node = &mut self.arena[r];\n                node.city_name = name;\n                node.ref_count = 1;\n                node.edge_count = 0;\n                node.freed = false;\n                r\n            }\n            None => {\n                self.arena.push(Node {\n                    city_name: name,\n                    ref_count: 1,\n                    edges: [Edge::zeroed(); MAX_EDGES],\n                    edge_count: 0,\n                    freed: false,\n                });\n                self.arena.len() - 1\n            }\n        }\n    }\n\n    /// `add_node()`\n    pub fn add_node(&mut self, city_name: &[u8]) -> Option<NodeRef> {\n        if self.node_count >= MAX_NODES as i32 {\n            err(format!(\"Error: Graph is full (max {} nodes)\\n\", MAX_NODES).as_bytes());\n            return None;\n        }\n\n        // Check if node already exists\n        for i in 0..self.node_count as usize {\n            let r = self.nodes[i];\n            let node = &self.arena[r];\n            if !node.freed && node.city_name.as_slice() == city_name {\n                err(b\"Error: Node '\");\n                err(city_name);\n                err(b\"' already exists\\n\");\n                return None;\n            }\n        }\n\n        let r = self.alloc_node(city_name);\n\n        // Add to graph\n        let idx = self.node_count as usize;\n        self.nodes[idx] = r;\n        self.node_count += 1;\n\n        Some(r)\n    }\n\n    /// `add_edge()`\n    pub fn add_edge(&mut self, from: NodeRef, to: NodeRef, distance: i32) -> i32 {\n        if self.arena[from].edge_count >= MAX_EDGES as i32 {\n            err(b\"Error: Node '\");\n            let name = self.arena[from].city_name.clone();\n            err(&name);\n            err(b\"' has maximum edges\\n\");\n            return -1;\n        }\n\n        if distance < 0 {\n            err(b\"Error: Negative distance not allowed\\n\");\n            return -1;\n        }\n\n        // Check for duplicate edge\n        for i in 0..self.arena[from].edge_count as usize {\n            if self.arena[from].edges[i].destination == to {\n                err(b\"Error: Edge already exists\\n\");\n                return -1;\n            }\n        }\n\n        // Add edge\n        let node = self.node_mut(from);\n        let slot = node.edge_count as usize;\n        node.edges[slot] = Edge {\n            destination: to,\n            distance,\n        };\n        node.edge_count += 1;\n\n        0\n    }\n\n    /// `delete_node()`\n    pub fn delete_node(&mut self, r: NodeRef) {\n        let node = &mut self.arena[r];\n        node.ref_count = node.ref_count.wrapping_sub(1);\n\n        if node.ref_count == 0 {\n            // glibc notices a chunk that is still sitting in the per-size-class\n            // cache being handed to free() a second time and aborts.\n            if self.tcache.contains(&r) {\n                err(b\"free(): double free detected in tcache 2\\n\");\n                die_abort();\n            }\n            self.arena[r].freed = true;\n            if self.tcache.len() < TCACHE_COUNT {\n                self.tcache.push(r);\n            } else {\n                self.unsorted.push_back(r);\n            }\n        }\n    }\n\n    /// `increment_refs_recursive()`\n    fn increment_refs_recursive(&mut self, r: NodeRef, visited: &mut Vec<NodeRef>) {\n        // Check if already visited\n        for i in 0..visited.len() {\n            if visited[i] == r {\n                return;\n            }\n        }\n\n        // Mark as visited\n        if visited.len() < MAX_NODES {\n            visited.push(r);\n        }\n\n        // Increment ref count\n        {\n            let node = &mut self.arena[r];\n            node.ref_count = node.ref_count.wrapping_add(1);\n        }\n\n        // Recursively process all connected nodes\n        for i in 0..self.arena[r].edge_count as usize {\n            let dest = self.arena[r].edges[i].destination;\n            self.increment_refs_recursive(dest, visited);\n        }\n    }\n\n    /// `shallow_copy()`\n    pub fn shallow_copy(&mut self, start: NodeRef) -> Option<NodeRef> {\n        let mut visited: Vec<NodeRef> = Vec::new();\n        self.increment_refs_recursive(start, &mut visited);\n        Some(start)\n    }\n\n    /// `find_shortest_path()`.  Returns the path and its length; the length is\n    /// set to 0 when no path exists (mirroring `*path_length = 0`).\n    pub fn find_shortest_path(&self, start: NodeRef, end: NodeRef) -> (Option<Vec<NodeRef>>, i32) {\n        struct DijkstraNode {\n            node: NodeRef,\n            distance: i32,\n            previous: Option<NodeRef>,\n            visited: bool,\n        }\n\n        let mut state: Vec<DijkstraNode> = Vec::with_capacity(MAX_NODES);\n\n        // Add start node\n        state.push(DijkstraNode {\n            node: start,\n            distance: 0,\n            previous: None,\n            visited: false,\n        });\n\n        let mut current: Option<NodeRef> = Some(start);\n\n        while let Some(cur) = current {\n            // Find current node in state\n            let mut current_idx: i32 = -1;\n            for i in 0..state.len() {\n                if state[i].node == cur {\n                    current_idx = i as i32;\n                    break;\n                }\n            }\n\n            if current_idx == -1 {\n                break;\n            }\n            let current_idx = current_idx as usize;\n\n            state[current_idx].visited = true;\n\n            // Check if we reached the end\n            if cur == end {\n                break;\n            }\n\n            // Update distances for neighbors\n            for i in 0..self.arena[cur].edge_count as usize {\n                let neighbor = self.arena[cur].edges[i].destination;\n                let new_distance = state[current_idx]\n                    .distance\n                    .wrapping_add(self.arena[cur].edges[i].distance);\n\n                // Find or add neighbor in state\n                let mut neighbor_idx: i32 = -1;\n                for j in 0..state.len() {\n                    if state[j].node == neighbor {\n                        neighbor_idx = j as i32;\n                        break;\n                    }\n                }\n\n                if neighbor_idx == -1 && state.len() < MAX_NODES {\n                    // Add new neighbor\n                    neighbor_idx = state.len() as i32;\n                    state.push(DijkstraNode {\n                        node: neighbor,\n                        distance: i32::MAX,\n                        previous: None,\n                        visited: false,\n                    });\n                }\n\n                if neighbor_idx != -1 && new_distance < state[neighbor_idx as usize].distance {\n                    let ni = neighbor_idx as usize;\n                    state[ni].distance = new_distance;\n                    state[ni].previous = Some(cur);\n                }\n            }\n\n            // Find next unvisited node with minimum distance\n            let mut min_distance = i32::MAX;\n            current = None;\n            for i in 0..state.len() {\n                if !state[i].visited && state[i].distance < min_distance {\n                    min_distance = state[i].distance;\n                    current = Some(state[i].node);\n                }\n            }\n        }\n\n        // Find end node in state\n        let mut end_idx: i32 = -1;\n        for i in 0..state.len() {\n            if state[i].node == end {\n                end_idx = i as i32;\n                break;\n            }\n        }\n\n        if end_idx == -1 || state[end_idx as usize].distance == i32::MAX {\n            err(b\"No path found\\n\");\n            return (None, 0);\n        }\n\n        // Reconstruct path.\n        //\n        // `node_t *path[MAX_NODES]` is a fixed size array on the stack and the\n        // `previous` links are not guaranteed to be acyclic (a distance\n        // computation that overflows can make a node its own predecessor), so\n        // this loop can write past the end of the array.  In the compiled\n        // program `path[MAX_NODES]` is exactly `state[0].node`, i.e. the writes\n        // walk over the Dijkstra state array that follows it on the stack:\n        //\n        //   path[100 + 4*k + 0] -> state[k].node\n        //   path[100 + 4*k + 1] -> state[k].distance (+ padding)\n        //   path[100 + 4*k + 2] -> state[k].previous\n        //   path[100 + 4*k + 3] -> state[k].visited  (+ padding)\n        //\n        // Only `node` and `previous` are read again, so the clobbering of the\n        // other two fields is invisible.  Past `state` come a few unused slots\n        // and finally `count` itself (`path[507]`), and once that holds a heap\n        // address the next write lands far outside the stack and the process\n        // dies from a fatal signal.\n        const STATE_SLOTS: usize = 4 * MAX_NODES;\n        const COUNT_SLOT: usize = 507;\n\n        let mut path: Vec<NodeRef> = Vec::with_capacity(MAX_NODES);\n        let mut current_node: Option<NodeRef> = Some(end);\n\n        while let Some(cn) = current_node {\n            let slot = path.len();\n            path.push(cn);\n\n            if slot >= MAX_NODES {\n                let offset = slot - MAX_NODES;\n                if offset < STATE_SLOTS {\n                    let k = offset / 4;\n                    let field = offset % 4;\n                    if k < state.len() {\n                        match field {\n                            0 => state[k].node = cn,\n                            2 => state[k].previous = Some(cn),\n                            _ => {}\n                        }\n                    }\n                } else if slot >= COUNT_SLOT {\n                    die_signal();\n                }\n            }\n\n            // Find previous node\n            let mut current_state_idx: i32 = -1;\n            for i in 0..state.len() {\n                if state[i].node == cn {\n                    current_state_idx = i as i32;\n                    break;\n                }\n            }\n\n            if current_state_idx == -1 {\n                break;\n            }\n\n            current_node = state[current_state_idx as usize].previous;\n        }\n\n        // Reverse path\n        let count = path.len();\n        if count > MAX_NODES + STATE_SLOTS {\n            // The entries stored beyond the state array read back as leftover\n            // stack contents, which are not reproducible.\n            die_signal();\n        }\n        let mut result: Vec<NodeRef> = Vec::with_capacity(count);\n        for i in 0..count {\n            result.push(path[count - 1 - i]);\n        }\n\n        (Some(result), count as i32)\n    }\n\n    /// `get_node_by_name()`\n    pub fn get_node_by_name(&self, city_name: &[u8]) -> Option<NodeRef> {\n        for i in 0..self.node_count as usize {\n            let r = self.nodes[i];\n            let node = &self.arena[r];\n            if !node.freed && node.city_name.as_slice() == city_name {\n                return Some(r);\n            }\n        }\n\n        None\n    }\n\n    /// `print_node()`\n    pub fn print_node(&self, out: &mut Out, r: NodeRef) {\n        let node = &self.arena[r];\n        out.s(\"City: \");\n        out.write(&node.city_name);\n        out.write(format!(\" (ref_count: {})\\n\", node.ref_count).as_bytes());\n        out.s(\"  Edges:\\n\");\n        for i in 0..node.edge_count as usize {\n            let edge = node.edges[i];\n            out.s(\"    -> \");\n            out.write(&self.arena[edge.destination].city_name);\n            out.write(format!(\" (distance: {})\\n\", edge.distance).as_bytes());\n        }\n    }\n\n    /// `print_graph()`\n    pub fn print_graph(&self, out: &mut Out) {\n        out.write(format!(\"Graph with {} nodes:\\n\", self.node_count).as_bytes());\n        for i in 0..self.node_count as usize {\n            self.print_node(out, self.nodes[i]);\n        }\n    }\n\n    /// `free_graph()`\n    pub fn free_graph(&mut self) {\n        // Decrement ref count for all nodes\n        for i in 0..self.node_count as usize {\n            let r = self.nodes[i];\n            self.delete_node(r);\n        }\n    }\n}\n","numLines":465,"startLine":1,"totalLines":465}}}
