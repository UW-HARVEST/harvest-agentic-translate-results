t a = rng.below(node_count);\n                        let b = rng.below(node_count);\n                        ops.push(Op::AddEdge(a, b, rng.range_i32(0, 100_000)));\n                    }\n                }\n                5 => {\n                    if node_count >= 1 {\n                        let a = rng.below(node_count);\n                        ops.push(Op::ShallowCopy(a));\n                        // every reachable node gets +1; tracking the exact set\n                        // is unnecessary, the log comparison does that\n                        for r in extra_refs.iter_mut() {\n                            *r += 1;\n                        }\n                    }\n                }\n                6 => {\n                    if node_count >= 1 {\n                        ops.push(Op::FindShortestPath(\n                            rng.below(node_count),\n                            rng.below(node_count),\n                        ));\n                    }\n                }\n                7 => {\n                    let n = if rng.bool() && !names.is_empty() {\n                        names[rng.below(names.len())].clone()\n                    } else {\n                        rng.name(70)\n                    };\n                    ops.push(Op::GetNodeByName(0, n));\n                }\n                8 => {\n                    if node_count >= 1 {\n                        ops.push(Op::PrintNode(rng.below(node_count)));\n                    }\n                }\n                9 => ops.push(Op::PrintGraph(0)),\n                _ => {\n                    // delete only where the reference count provably stays > 0\n                    if node_count >= 1 {\n                        let a = rng.below(node_count);\n                        if extra_refs[a] > 0 {\n                            extra_refs[a] -= 1;\n                            ops.push(Op::DeleteNode(a));\n                        }\n                    }\n                }\n            }\n    