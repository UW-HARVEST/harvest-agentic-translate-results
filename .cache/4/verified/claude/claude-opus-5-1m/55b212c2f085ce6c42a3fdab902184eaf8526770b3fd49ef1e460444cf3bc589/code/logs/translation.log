{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01EK8gksVgaBQAQZHbhDxwq1","type":"tool_result","content":"1\t//! Translation of `src/error.c`.\n2\t//!\n3\t//! `jsonp_error_set` itself is variadic and lives in `vararg.rs`; everything\n4\t//! else is here.\n5\t\n6\tuse crate::types::*;\n7\tuse core::ffi::{c_char, c_int, c_void};\n8\t\n9\t#[unsafe(no_mangle)]\n10\tpub unsafe extern \"C\" fn jsonp_error_init(error: *mut json_error_t, source: *const c_char) {\n11\t    if !error.is_null() {\n12\t        (*error).text[0] = 0;\n13\t        (*error).line = -1;\n14\t        (*error).column = -1;\n15\t        (*error).position = 0;\n16\t        if !source.is_null() {\n17\t            jsonp_error_set_source(error, source);\n18\t        } else {\n19\t            (*error).source[0] = 0;\n20\t        }\n21\t    }\n22\t}\n23\t\n24\t#[unsafe(no_mangle)]\n25\tpub unsafe extern \"C\" fn jsonp_error_set_source(error: *mut json_error_t, source: *const c_char) {\n26\t    let length: usize;\n27\t\n28\t    if error.is_null() || source.is_null() {\n29\t        return;\n30\t    }\n31\t\n32\t    length = strlen(source);\n33\t    if length < JSON_ERROR_SOURCE_LENGTH {\n34\t        /* strncpy(error->source, source, length + 1) */\n35\t        memcpy(\n36\t            (*error).source.as_mut_ptr() as *mut c_void,\n37\t            source as *const c_void,\n38\t            length + 1,\n39\t        );\n40\t    } else {\n41\t        let extra = length - JSON_ERROR_SOURCE_LENGTH + 4;\n42\t        memcpy(\n43\t            (*error).source.as_mut_ptr() as *mut c_void,\n44\t            b\"...\\0\".as_ptr() as *const c_void,\n45\t            3,\n46\t        );\n47\t        memcpy(\n48\t            (*error).source.as_mut_ptr().add(3) as *mut c_void,\n49\t            source.add(extra) as *const c_void,\n50\t            length - extra + 1,\n51\t        );\n52\t    }\n53\t}\n54\t\n55\t#[unsafe(no_mangle)]\n56\tpub unsafe extern \"C\" fn jsonp_error_vset(\n57\t    error: *mut json_error_t,\n58\t    line: c_int,\n59\t    column: c_int,\n60\t    position: usize,\n61\t    code: c_int,\n62\t    msg: *const c_char,\n63\t    ap: va_list,\n64\t) {\n65\t    if error.is_null() {\n66\t        return;\n67\t    }\n68\t\n69\t    if (*error).text[0] != 0 {\n70\t        /* error already set */\n71\t        return;\n72\t    }\n73\t\n74\t    (*error).line = line;\n75\t    (*error).column = column;\n76\t    (*error).position = position as c_int;\n77\t\n78\t    vsnprintf(\n79\t        (*error).text.as_mut_ptr(),\n80\t        JSON_ERROR_TEXT_LENGTH - 1,\n81\t        msg,\n82\t        ap,\n83\t    );\n84\t    (*error).text[JSON_ERROR_TEXT_LENGTH - 2] = 0;\n85\t    (*error).text[JSON_ERROR_TEXT_LENGTH - 1] = code as c_char;\n86\t}\n87\t\n88\t/// Internal equivalent of `jsonp_error_set(error, ..., \"%s\", msg)` for a\n89\t/// message that has already been formatted into a byte buffer.\n90\t///\n91\t/// `msg` is the raw byte sequence produced by the C `vsnprintf` call; the `%s`\n92\t/// conversion in the C code stops at the first NUL byte, which is emulated\n93\t/// here.\n94\tpub unsafe fn jsonp_error_set_msg(\n95\t    error: *mut json_error_t,\n96\t    line: c_int,\n97\t    column: c_int,\n98\t    position: usize,\n99\t    code: c_int,\n100\t    msg: &[u8],\n101\t) {\n102\t    if error.is_null() {\n103\t        return;\n104\t    }\n105\t    if (*error).text[0] != 0 {\n106\t        return;\n107\t    }\n108\t\n109\t    (*error).line = line;\n110\t    (*error).column = column;\n111\t    (*error).position = position as c_int;\n112\t\n113\t    /* vsnprintf(text, 159, \"%s\", msg) */\n114\t    let n = cstr_len(msg);\n115\t    let n = core::cmp::min(n, JSON_ERROR_TEXT_LENGTH - 2);\n116\t    let dst = (*error).text.as_mut_ptr() as *mut u8;\n117\t    core::ptr::copy_nonoverlapping(msg.as_ptr(), dst, n);\n118\t    *dst.add(n) = 0;\n119\t    (*error).text[JSON_ERROR_TEXT_LENGTH - 2] = 0;\n120\t    (*error).text[JSON_ERROR_TEXT_LENGTH - 1] = code as c_char;\n121\t}\n122\t\n123\t/// Like [`jsonp_error_set_msg`] but keeps embedded NUL bytes, reproducing what\n124\t/// `vsnprintf` writes when a `%c` conversion receives `'\\0'`.\n125\tpub unsafe fn jsonp_error_set_raw(\n126\t    error: *mut json_error_t,\n127\t    line: c_int,\n128\t    column: c_int,\n129\t    position: usize,\n130\t    code: c_int,\n131\t    msg: &[u8],\n132\t) {\n133\t    if error.is_null() {\n134\t        return;\n135\t    }\n136\t    if (*error).text[0] != 0 {\n137\t        return;\n138\t    }\n139\t\n140\t    (*error).line = line;\n141\t    (*error).column = column;\n142\t    (*error).position = position as c_int;\n143\t\n144\t    let n = core::cmp::min(msg.len(), JSON_ERROR_TEXT_LENGTH - 2);\n145\t    let dst = (*error).text.as_mut_ptr() as *mut u8;\n146\t    core::ptr::copy_nonoverlapping(msg.as_ptr(), dst, n);\n147\t    *dst.add(n) = 0;\n148\t    (*error).text[JSON_ERROR_TEXT_LENGTH - 2] = 0;\n149\t    (*error).text[JSON_ERROR_TEXT_LENGTH - 1] = code as c_char;\n150\t}\n151\t"}]},"parent_tool_use_id":"toolu_bdrk_01C4ayQA9ifV3u3997GFA6vW","session_id":"e94907f6-9286-4b26-9780-21e7bb4d5fee","uuid":"8b604d25-c429-4537-b22c-cb940df5dc00","timestamp":"2026-08-22T14:32:08.655Z","subagent_type":"general-purpose","task_description":"Verify remaining translated modules"}
