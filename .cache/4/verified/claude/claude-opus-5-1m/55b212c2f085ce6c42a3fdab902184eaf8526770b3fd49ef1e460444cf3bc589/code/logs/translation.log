5\t    }\n136\t    core::slice::from_raw_parts(p as *const u8, n)\n137\t}\n138\t\n139\tunsafe fn error_set(error: *mut json_error_t, lex: *const lex_t, code_in: c_int, msg: &[u8]) {\n140\t    let mut code = code_in;\n141\t    let mut msg_text = [0u8; JSON_ERROR_TEXT_LENGTH];\n142\t    let mut msg_with_context = [0u8; JSON_ERROR_TEXT_LENGTH];\n143\t\n144\t    let mut line: c_int = -1;\n145\t    let mut col: c_int = -1;\n146\t    let mut pos: usize = 0;\n147\t    let mut use_context = false;\n148\t\n149\t    if error.is_null() {\n150\t        return;\n151\t    }\n152\t\n153\t    /* vsnprintf(msg_text, JSON_ERROR_TEXT_LENGTH, msg, ap) */\n154\t    copy_trunc(&mut msg_text, msg);\n155\t    msg_text[JSON_ERROR_TEXT_LENGTH - 1] = 0;\n156\t    let msg_len = cstr_len(&msg_text);\n157\t\n158\t    if !lex.is_null() {\n159\t        let saved_text = (*lex).saved_text.value;\n160\t\n161\t        line = (*lex).stream.line;\n162\t        col = (*lex).stream.column;\n163\t        pos = (*lex).stream.position;\n164\t\n165\t        if !saved_text.is_null() && *saved_text != 0 {\n166\t            if (*lex).saved_text.length <= 20 {\n167\t                /* snprintf(msg_with_context, N, \"%s near '%s'\", msg_text, saved_text) */\n168\t                let mut tmp: Vec<u8> = Vec::with_capacity(msg_len + 32);\n169\t                tmp.extend_from_slice(&msg_text[..msg_len]);\n170\t                tmp.extend_from_slice(b\" near '\");\n171\t                tmp.extend_from_slice(cstr_bytes(saved_text, 64));\n172\t                tmp.push(b'\\'');\n173\t                copy_trunc(&mut msg_with_context, &tmp);\n174\t                msg_with_context[JSON_ERROR_TEXT_LENGTH - 1] = 0;\n175\t                use_context = true;\n176\t            }\n177\t        } else {\n178\t            if code == JSON_ERROR_INVALID_SYNTAX {\n179\t                /* More specific error code for premature end of file. */\n180\t                code = JSON_ERROR_PREMATURE_END_OF_INPUT;\n181\t            }\n182\t      