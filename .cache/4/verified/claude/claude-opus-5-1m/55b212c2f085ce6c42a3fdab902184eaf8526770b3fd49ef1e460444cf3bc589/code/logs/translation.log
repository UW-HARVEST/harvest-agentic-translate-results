mp_to_buffer, (void *)&buf, flags))\n452\t        return 0;\n453\t\n454\t    return buf.used;\n455\t}\n456\t\n457\tint json_dumpf(const json_t *json, FILE *output, size_t flags) {\n458\t    return json_dump_callback(json, dump_to_file, (void *)output, flags);\n459\t}\n460\t\n461\tint json_dumpfd(const json_t *json, int output, size_t flags) {\n462\t    return json_dump_callback(json, dump_to_fd, (void *)&output, flags);\n463\t}\n464\t\n465\tint json_dump_file(const json_t *json, const char *path, size_t flags) {\n466\t    int result;\n467\t\n468\t    FILE *output = fopen(path, \"w\");\n469\t    if (!output)\n470\t        return -1;\n471\t\n472\t    result = json_dumpf(json, output, flags);\n473\t\n474\t    if (fclose(output) != 0)\n475\t        return -1;\n476\t\n477\t    return result;\n478\t}\n479\t\n480\tint json_dump_callback(const json_t *json, json_dump_callback_t callback, void *data,\n481\t                       size_t flags) {\n482\t    int res;\n483\t    hashtable_t parents_set;\n484\t\n485\t    if (!(flags & JSON_ENCODE_ANY)) {\n486\t        if (!json_is_array(json) && !json_is_object(json))\n487\t            return -1;\n488\t    }\n489\t\n490\t    if (hashtable_init(&parents_set))\n491\t        return -1;\n492\t    res = do_dump(json, flags, 0, &parents_set, callback, data);\n493\t    hashtable_close(&parents_set);\n494\t\n495\t    return res;\n496\t}\n497\t"}]},"parent_tool_use_id":null,"session_id":"e94907f6-9286-4b26-9780-21e7bb4d5fee","uuid":"32257708-bf0c-448a-9870-4d38a7b58058","timestamp":"2026-08-22T13:31:36.918Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-translate-3BnTUb/translated_rust/c_src/src/dump.c","content":"/*\n * Copyright (c) 2009-2016 Petri Lehtinen <petri@digip.org>\n *\n * Jansson is free software; you can redistribute it and/or modify\n * it under the terms of the MIT license. See LICENSE for details.\n */\n\n#ifndef _GNU_SOURCE\n#define _GNU_SOURCE\n#endif\n\n#include \"jansson