         }\n183\t\n184\t                text = seq;\n185\t                break;\n186\t            }\n187\t        }\n188\t\n189\t        if (dump(text, length, data))\n190\t            return -1;\n191\t\n192\t        str = pos = end;\n193\t    }\n194\t\n195\t    return dump(\"\\\"\", 1, data);\n196\t}\n197\t\n198\tstruct key_len {\n199\t    const char *key;\n200\t    int len;\n201\t};\n202\t\n203\tstatic int compare_keys(const void *key1, const void *key2) {\n204\t    const struct key_len *k1 = key1;\n205\t    const struct key_len *k2 = key2;\n206\t    const size_t min_size = k1->len < k2->len ? k1->len : k2->len;\n207\t    int res = memcmp(k1->key, k2->key, min_size);\n208\t\n209\t    if (res)\n210\t        return res;\n211\t\n212\t    return k1->len - k2->len;\n213\t}\n214\t\n215\tstatic int do_dump(const json_t *json, size_t flags, int depth, hashtable_t *parents,\n216\t                   json_dump_callback_t dump, void *data) {\n217\t    int embed = flags & JSON_EMBED;\n218\t\n219\t    flags &= ~JSON_EMBED;\n220\t\n221\t    if (!json)\n222\t        return -1;\n223\t\n224\t    switch (json_typeof(json)) {\n225\t        case JSON_NULL:\n226\t            return dump(\"null\", 4, data);\n227\t\n228\t        case JSON_TRUE:\n229\t            return dump(\"true\", 4, data);\n230\t\n231\t        case JSON_FALSE:\n232\t            return dump(\"false\", 5, data);\n233\t\n234\t        case JSON_INTEGER: {\n235\t            char buffer[MAX_INTEGER_STR_LENGTH];\n236\t            int size;\n237\t\n238\t            size = snprintf(buffer, MAX_INTEGER_STR_LENGTH, \"%\" JSON_INTEGER_FORMAT,\n239\t                            json_integer_value(json));\n240\t            if (size < 0 || size >= MAX_INTEGER_STR_LENGTH)\n241\t                return -1;\n242\t\n243\t            return dump(buffer, size, data);\n244\t        }\n245\t\n246\t        case JSON_REAL: {\n247\t            char buffer[MAX_REAL_STR_LENGTH];\n248\t            int size;\n249\t            double value = json_real_value(json);\n250\t\n251\t            size = jsonp_dtostr(buffer, MAX_REAL_STR_LENGTH, value,\n252\t                                FLAGS_TO_PRECISION(flags));\n253\t            if (size < 0)\n254\t                return -1;\n255\t\n256\t            return dump(buffer, size, data);\n257\t        }\n258\t\n259\t        case JSON_STRING:\n260\t            return dump_string(json_string_value(json), json_string_length(json), dump,\n261\t                               data, flags);\n262\t\n263\t        case JSON_ARRAY: {\n264\t            size_t n;\n265\t            size_t i;\n266\t            /* Space for \"0x\", double the sizeof a pointer for the hex and a\n267\t             * terminator. */\n268\t            char key[2 + (sizeof(json) * 2) + 1];\n269\t            size_t key_len;\n270\t\n271\t            /* detect circular references */\n272\t            if (jsonp_loop_check(parents, json, key, sizeof(key), &key_len))\n273\t                return -1;\n274\t\n275\t            n = json_array_size(json);\n276\t\n277\t            if (!embed && dump(\"[\", 1, data))\n278\t                return -1;\n279\t            if (n == 0) {\n280\t                hashtable_del(parents, key, key_len);\n281\t                return embed ? 0 : dump(\"]\", 1, data);\n282\t            }\n283\t            if (dump_indent(flags, depth + 1, 0, dump, data))\n284\t                return -1;\n285\t\n286\t            for (i = 0; i < n - 1; ++i) {\n287\t                if (do_dump(json_array_get(json, i), flags, depth + 1, parents, dump,\n288\t                            data))\n289\t                    return -1;\n290\t\n291\t                if (dump(\",\", 1, data) || dump_indent(flags, depth + 1, 1, dump, data))\n292\t                    return -1;\n293\t            }\n294\t\n295\t            if (do_dump(json_array_get(json, i), flags, depth + 1, parents, dump, data))\n296\t                return -1;\n297\t            if (dump_indent(flags, depth, 0, dump, data))\n298\t                return -1;\n299\t\n300\t            hashtable_del(parents, key, key_len);\n301\t            return embed ? 0 : dump(\"]\", 1, data);\n302\t        }\n303\t\n304\t        case JSON_OBJECT: {\n305\t            void *iter;\n306\t            const char *separator;\n307\t            int separator_length;\n308\t            char loop_key[LOOP_KEY_LEN];\n309\t            size_t loop_key_len;\n310\t\n311\t            if (flags & JSON_COMPACT) {\n312\t                separator = \":\";\n313\t                separator_length = 1;\n314\t            } else {\n315\t                separator = \": \";\n316\t                separator_length = 2;\n317\t            }\n318\t\n319\t            /* detect circular references */\n320\t            if (jsonp_loop_check(parents, json, loop_key, sizeof(loop_key),\n321\t                                 &loop_key_len))\n322\t                return -1;\n323\t\n324\t            if (!embed && dump(\"{\", 1, data))\n325\t                return -1;\n326\t\n327\t            iter = json_object_iter((json_t *)json);\n328\t            if (!iter) {\n329\t                hashtable_del(parents, loop_key, loop_key_len);\n330\t                return embed ? 0 : dump(\"}\", 1, data);\n331\t            }\n332\t            if (dump_indent(flags, depth + 1, 0, dump, data))\n333\t                return -1;\n334\t\n335\t            if (flags & JSON_SORT_KEYS) {\n336\t                struct key_len *keys;\n337\t                size_t size, i;\n338\t\n339\t                size = json_object_size(json);\n340\t                keys = jsonp_malloc(size * sizeof(struct key_len));\n341\t                if (!keys)\n342\t                    return -1;\n343\t\n344\t                i = 0;\n345\t                while (iter) {\n346\t                    struct key_len *keylen = &keys[i];\n347\t\n348\t                    keylen->key = json_object_iter_key(iter);\n349\t                    keylen->len = json_object_iter_key_len(iter);\n350\t\n351\t                    iter = json_object