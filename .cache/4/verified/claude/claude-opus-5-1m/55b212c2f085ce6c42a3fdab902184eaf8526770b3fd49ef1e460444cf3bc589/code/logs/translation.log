"s\\\":\\\"v%d\\\"}\", i?\",\":\"\", i, i*1.5, i);\n        k += snprintf(big+k, 200000-k, \"],\\\"end\\\":true}\");\n        for (size_t chunk = 1; chunk <= 4096; chunk *= 3) {\n            cbs c = { big, strlen(big), chunk };\n            json_error_t e;\n            json_t *j = json_load_callback(cb, &c, 0, &e);\n            if (j) { char *s = json_dumps(j, JSON_COMPACT|JSON_SORT_KEYS);\n                printf(\"cb[%zu]=%zu %u\\n\", chunk, s?strlen(s):0, s?(unsigned)s[100]:0); free(s); json_decref(j); }\n            else printf(\"cb[%zu]=ERR %s\\n\", chunk, e.text);\n        }\n        /* also loadb/loads of the whole thing and re-dump */\n        json_error_t e; json_t *j = json_loads(big, 0, &e);\n        if (j) { char *s = json_dumps(j, JSON_INDENT(1)|JSON_SORT_KEYS);\n            printf(\"bigdump=%zu\\n\", strlen(s));\n            unsigned long h = 0; for (char *p = s; *p; p++) h = h*131 + (unsigned char)*p;\n            printf(\"bighash=%lu\\n\", h); free(s); json_decref(j); }\n        else printf(\"bigload=ERR %s\\n\", e.text);\n        free(big);\n    }\n    /* INT_AS_REAL with big integers */\n    { const char *ins[] = {\"[1]\", \"[9223372036854775807]\", \"[-9223372036854775808]\",\n        \"[123456789012345678901234567890]\", \"[0]\", \"[-0]\", \"[1000000000000000000000]\"};\n      for (unsigned i = 0; i < sizeof(ins)/sizeof(ins[0]); i++) {\n        json_error_t e;\n        json_t *j = json_loads(ins[i], JSON_DECODE_INT_AS_REAL, &e);\n        if (j) { char *s = json_dumps(j, JSON_ENCODE_ANY); printf(\"iar[%u]=%s\\n\", i, s); free(s); json_decref(j); }\n        else printf(\"iar[%u]=ERR %s %d\\n\", i, e.text, json_error_code(&e)); } }\n    printf(\"DONE6\\n\");\n    return 0;\n}\nCEOF\nSRC=/local/home/scheschb/.harvest/work/harvest-translate-3BnTUb/translated_rust/c_src && gcc -O1 -w -I$SRC/include -DHAVE_CONFIG_H t6.c -o t6_c -L./cl -ljansson -Wl,-rpath,'$ORIGIN/cl' && gcc -O1 -w -I$SRC/include -DHAVE_CONFIG_H t6.c -o t6_r -L./rl -ljansson -Wl,-rpath,'