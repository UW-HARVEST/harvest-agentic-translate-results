ject\n   137\t * @key: The key that the iterator should point to\n   138\t * @key_len: The length of key\n   139\t *\n   140\t * Like hashtable_iter() but returns an iterator pointing to a\n   141\t * specific key.\n   142\t */\n   143\tvoid *hashtable_iter_at(hashtable_t *hashtable, const char *key, size_t key_len);\n   144\t\n   145\t/**\n   146\t * hashtable_iter_next - Advance an iterator\n   147\t *\n   148\t * @hashtable: The hashtable object\n   149\t * @iter: The iterator\n   150\t *\n   151\t * Returns a new iterator pointing to the next element in the\n   152\t * hashtable or NULL if the whole hastable has been iterated over.\n   153\t */\n   154\tvoid *hashtable_iter_next(hashtable_t *hashtable, void *iter);\n   155\t\n   156\t/**\n   157\t * hashtable_iter_key - Retrieve the key pointed by an iterator\n   158\t *\n   159\t * @iter: The iterator\n   160\t */\n   161\tvoid *hashtable_iter_key(void *iter);\n   162\t\n   163\t/**\n   164\t * hashtable_iter_key_len - Retrieve the key length pointed by an iterator\n   165\t *\n   166\t * @iter: The iterator\n   167\t */\n   168\tsize_t hashtable_iter_key_len(void *iter);\n   169\t\n   170\t/**\n   171\t * hashtable_iter_value - Retrieve the value pointed by an iterator\n   172\t *\n   173\t * @iter: The iterator\n   174\t */\n   175\tvoid *hashtable_iter_value(void *iter);\n   176\t\n   177\t/**\n   178\t * hashtable_iter_set - Set the value pointed by an iterator\n   179\t *\n   180\t * @iter: The iterator\n   181\t * @value: The value to set\n   182\t */\n   183\tvoid hashtable_iter_set(void *iter, json_t *value);\n   184\t\n   185\t#endif\n=========== src/strbuffer.h\n     1\t/*\n     2\t * Copyright (c) 2009-2016 Petri Lehtinen <petri@digip.org>\n     3\t *\n     4\t * Jansson is free software; you can redistribute it and/or modify\n     5\t * it under the terms of the MIT license. See LICENSE for details.\n     6\t */\n     7\t\n     8\t#ifndef STRBUFFER_H\n     9\t#define STRBUFFER_H\n    10\t\n    11\t#