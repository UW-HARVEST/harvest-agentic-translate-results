n404\t                    lex,\n405\t                    JSON_ERROR_PREMATURE_END_OF_INPUT,\n406\t                    b\"premature end of input\",\n407\t                );\n408\t                break 'out;\n409\t            } else if (0..=0x1F).contains(&c) {\n410\t                /* control character */\n411\t                lex_unget_unsave(lex, c);\n412\t                if c == '\\n' as c_int {\n413\t                    error_set(error, lex, JSON_ERROR_INVALID_SYNTAX, b\"unexpected newline\");\n414\t                } else {\n415\t                    let msg = format!(\"control character 0x{:x}\", c);\n416\t                    error_set(error, lex, JSON_ERROR_INVALID_SYNTAX, msg.as_bytes());\n417\t                }\n418\t                break 'out;\n419\t            } else if c == '\\\\' as c_int {\n420\t                c = lex_get_save(lex, error);\n421\t                if c == 'u' as c_int {\n422\t                    c = lex_get_save(lex, error);\n423\t                    i = 0;\n424\t                    while i < 4 {\n425\t                        if !l_isxdigit(c) {\n426\t                            error_set(error, lex, JSON_ERROR_INVALID_SYNTAX, b\"invalid escape\");\n427\t                            break 'out;\n428\t                        }\n429\t                        c = lex_get_save(lex, error);\n430\t                        i += 1;\n431\t                    }\n432\t                } else if c == '\"' as c_int\n433\t                    || c == '\\\\' as c_int\n434\t                    || c == '/' as c_int\n435\t                    || c == 'b' as c_int\n436\t                    || c == 'f' as c_int\n437\t                    || c == 'n' as c_int\n438\t                    || c == 'r' as c_int\n439\t                    || c == 't' as c_int\n440\t                {\n441\t                    c = lex_get_save(lex, error);\n442\t                } else {\n443\t                    error_set(error, lex, JSON_ERROR_INVALID_SYNTAX, b\"invalid escape\");\n444\t      