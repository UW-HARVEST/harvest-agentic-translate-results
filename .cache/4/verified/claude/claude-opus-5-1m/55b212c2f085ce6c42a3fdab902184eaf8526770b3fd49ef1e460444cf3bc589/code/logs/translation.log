te aligned on entry):\n//!\n//! ```text\n//!   rbp+16 .. : incoming stack arguments  (overflow_arg_area)\n//!   rbp-176   : register save area, 6 GP quadwords then 8 XMM oct-words\n//!   rbp-208   : the __va_list_tag itself\n//! ```\n\n#![allow(dead_code)]\n\n#[cfg(target_arch = \"x86_64\")]\ncore::arch::global_asm!(\n    r#\"\n    .text\n\n/* ---- common prologue ------------------------------------------------ *\n *  \\gp  = initial gp_offset (8 * number of fixed integer arguments)\n *  \\fsz = total frame size\n */\n.macro JANSSON_VA_PROLOGUE gp, fsz\n    pushq   %rbp\n    movq    %rsp, %rbp\n    subq    $\\fsz, %rsp\n    movq    %rdi, -176(%rbp)\n    movq    %rsi, -168(%rbp)\n    movq    %rdx, -160(%rbp)\n    movq    %rcx, -152(%rbp)\n    movq    %r8,  -144(%rbp)\n    movq    %r9,  -136(%rbp)\n    testb   %al, %al\n    je      1f\n    movaps  %xmm0, -128(%rbp)\n    movaps  %xmm1, -112(%rbp)\n    movaps  %xmm2, -96(%rbp)\n    movaps  %xmm3, -80(%rbp)\n    movaps  %xmm4, -64(%rbp)\n    movaps  %xmm5, -48(%rbp)\n    movaps  %xmm6, -32(%rbp)\n    movaps  %xmm7, -16(%rbp)\n1:\n    movl    $\\gp, -208(%rbp)\n    movl    $48, -204(%rbp)\n    leaq    16(%rbp), %rax\n    movq    %rax, -200(%rbp)\n    leaq    -176(%rbp), %rax\n    movq    %rax, -192(%rbp)\n.endm\n\n/* ------------------------------------------------------ jsonp_error_set */\n    .globl  jsonp_error_set\n    .type   jsonp_error_set,@function\njsonp_error_set:\n    JANSSON_VA_PROLOGUE 48, 240\n    /* first six arguments are still live in their registers */\n    leaq    -208(%rbp), %rax\n    movq    %rax, -240(%rbp)          /* 7th argument goes on the stack */\n    xorl    %eax, %eax\n    call    jsonp_error_vset\n    leave\n    ret\n    .size   jsonp_error_set, .-jsonp_error_set\n\n/* ------------------------------------------------------------ json_pack */\n    .globl  json_pack\n    .type   json_pack,@function\njson_pack:\n    JANSSON_VA_PROLOGUE 8, 224\n    movq    -176(%rbp), %rdx          /* fmt */\n 