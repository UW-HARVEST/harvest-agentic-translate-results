{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_016C7TsSZmQcqnZkwxeC7nE1","type":"tool_result","content":"1\t//! Core public types and libc bindings shared by the whole crate.\n2\t//!\n3\t//! Layouts mirror the C declarations in `jansson.h`, `jansson_private.h`,\n4\t//! `hashtable.h` and `strbuffer.h` exactly.\n5\t\n6\t#![allow(non_camel_case_types)]\n7\t\n8\tuse core::ffi::{c_char, c_int, c_uint, c_void};\n9\t\n10\tpub type json_int_t = i64; /* long long (JSON_INTEGER_IS_LONG_LONG == 1) */\n11\t\n12\t/* ---------------------------------------------------------------- json_type */\n13\t\n14\tpub const JSON_OBJECT: c_int = 0;\n15\tpub const JSON_ARRAY: c_int = 1;\n16\tpub const JSON_STRING: c_int = 2;\n17\tpub const JSON_INTEGER: c_int = 3;\n18\tpub const JSON_REAL: c_int = 4;\n19\tpub const JSON_TRUE: c_int = 5;\n20\tpub const JSON_FALSE: c_int = 6;\n21\tpub const JSON_NULL: c_int = 7;\n22\t\n23\t/* -------------------------------------------------------- error code enum */\n24\t\n25\tpub const JSON_ERROR_UNKNOWN: c_int = 0;\n26\tpub const JSON_ERROR_OUT_OF_MEMORY: c_int = 1;\n27\tpub const JSON_ERROR_STACK_OVERFLOW: c_int = 2;\n28\tpub const JSON_ERROR_CANNOT_OPEN_FILE: c_int = 3;\n29\tpub const JSON_ERROR_INVALID_ARGUMENT: c_int = 4;\n30\tpub const JSON_ERROR_INVALID_UTF8: c_int = 5;\n31\tpub const JSON_ERROR_PREMATURE_END_OF_INPUT: c_int = 6;\n32\tpub const JSON_ERROR_END_OF_INPUT_EXPECTED: c_int = 7;\n33\tpub const JSON_ERROR_INVALID_SYNTAX: c_int = 8;\n34\tpub const JSON_ERROR_INVALID_FORMAT: c_int = 9;\n35\tpub const JSON_ERROR_WRONG_TYPE: c_int = 10;\n36\tpub const JSON_ERROR_NULL_CHARACTER: c_int = 11;\n37\tpub const JSON_ERROR_NULL_VALUE: c_int = 12;\n38\tpub const JSON_ERROR_NULL_BYTE_IN_KEY: c_int = 13;\n39\tpub const JSON_ERROR_DUPLICATE_KEY: c_int = 14;\n40\tpub const JSON_ERROR_NUMERIC_OVERFLOW: c_int = 15;\n41\tpub const JSON_ERROR_ITEM_NOT_FOUND: c_int = 16;\n42\tpub const JSON_ERROR_INDEX_OUT_OF_RANGE: c_int = 17;\n43\t\n44\t/* ------------------------------------------------------------------- flags */\n45\t\n46\tpub const JSON_VALIDATE_ONLY: usize = 0x1;\n47\tpub const JSON_STRICT: usize = 0x2;\n48\t\n49\tpub const JSON_REJECT_DUPLICATES: usize = 0x1;\n50\tpub const JSON_DISABLE_EOF_CHECK: usize = 0x2;\n51\tpub const JSON_DECODE_ANY: usize = 0x4;\n52\tpub const JSON_DECODE_INT_AS_REAL: usize = 0x8;\n53\tpub const JSON_ALLOW_NUL: usize = 0x10;\n54\t\n55\tpub const JSON_COMPACT: usize = 0x20;\n56\tpub const JSON_ENSURE_ASCII: usize = 0x40;\n57\tpub const JSON_SORT_KEYS: usize = 0x80;\n58\tpub const JSON_PRESERVE_ORDER: usize = 0x100;\n59\tpub const JSON_ENCODE_ANY: usize = 0x200;\n60\tpub const JSON_ESCAPE_SLASH: usize = 0x400;\n61\tpub const JSON_EMBED: usize = 0x10000;\n62\t\n63\tpub const JSON_ERROR_TEXT_LENGTH: usize = 160;\n64\tpub const JSON_ERROR_SOURCE_LENGTH: usize = 80;\n65\t\n66\tpub const JSON_PARSER_MAX_DEPTH: usize = 2048;\n67\t\n68\t/* `LOOP_KEY_LEN` from jansson_private.h: 2 + sizeof(json_t *) * 2 + 1 */\n69\tpub const LOOP_KEY_LEN: usize = 2 + (core::mem::size_of::<*mut json_t>() * 2) + 1;\n70\t\n71\t/* ------------------------------------------------------------------ json_t */\n72\t\n73\t#[repr(C)]\n74\tpub struct json_t {\n75\t    pub type_: c_int,\n76\t    pub refcount: usize, /* volatile size_t */\n77\t}\n78\t\n79\t#[repr(C)]\n80\tpub struct json_error_t {\n81\t    pub line: c_int,\n82\t    pub column: c_int,\n83\t    pub position: c_int,\n84\t    pub source: [c_char; JSON_ERROR_SOURCE_LENGTH],\n85\t    pub text: [c_char; JSON_ERROR_TEXT_LENGTH],\n86\t}\n87\t\n88\t/* ------------------------------------------------------------- hashtable_t */\n89\t\n90\t#[repr(C)]\n91\t#[derive(Clone, Copy)]\n92\tpub struct hashtable_list {\n93\t    pub prev: *mut hashtable_list,\n94\t    pub next: *mut hashtable_list,\n95\t}\n96\t\n97\t#[repr(C)]\n98\tpub struct hashtable_pair {\n99\t    pub list: hashtable_list,\n100\t    pub ordered_list: hashtable_list,\n101\t    pub hash: usize,\n102\t    pub value: *mut json_t,\n103\t    pub key_len: usize,\n104\t    pub key: [c_char; 1],\n105\t}\n106\t\n107\t#[repr(C)]\n108\t#[derive(Clone, Copy)]\n109\tpub struct hashtable_bucket {\n110\t    pub first: *mut hashtable_list,\n111\t    pub last: *mut hashtable_list,\n112\t}\n113\t\n114\t#[repr(C)]\n115\tpub struct hashtable_t {\n116\t    pub size: usize,\n117\t    pub buckets: *mut hashtable_bucket,\n118\t    pub order: usize,\n119\t    pub list: hashtable_list,\n120\t    pub ordered_list: hashtable_list,\n121\t}\n122\t\n123\t/* offsetof(struct hashtable_pair, key) */\n124\tpub const PAIR_KEY_OFFSET: usize = 56;\n125\t\n126\t/* ------------------------------------------------------------ strbuffer_t */\n127\t\n128\t#[repr(C)]\n129\tpub struct strbuffer_t {\n130\t    pub value: *mut c_char,\n131\t    pub length: usize,\n132\t    pub size: usize,\n133\t}\n134\t\n135\t/* ------------------------------------------------- private value structs */\n136\t\n137\t#[repr(C)]\n138\tpub struct json_object_t {\n139\t    pub json: json_t,\n140\t    pub hashtable: hashtable_t,\n141\t}\n142\t\n143\t#[repr(C)]\n144\tpub struct json_array_t {\n145\t    pub json: json_t,\n146\t    pub size: usize,\n147\t    pub entries: usize,\n148\t    pub table: *mut *mut json_t,\n149\t}\n150\t\n151\t#[repr(C)]\n152\tpub struct json_string_t {\n153\t    pub json: json_t,\n154\t    pub value: *mut c_char,\n155\t    pub length: usize,\n156\t}\n157\t\n158\t#[repr(C)]\n159\tpub struct json_real_t {\n160\t    pub json: json_t,\n161\t    pub value: f64,\n162\t}\n163\t\n164\t#[repr(C)]\n165\tpub struct json_integer_t {\n166\t    pub json: json_t,\n167\t    pub value: json_int_t,\n168\t}\n169\t\n170\t/* ------------------------------------------------------- callback types */\n171\t\n172\tpub type json_load_callback_t =\n173\t    Option<unsafe extern \"C\" fn(buffer: *mut c_void, buflen: usize, data: *mut c_void) -> usize>;\n174\tpub type json_dump_callback_t =\n175\t    Option<unsafe extern \"C\" fn(buffer: *const c_char, size: usize, data: *mut c_void) -> c_int>;\n176\t\n177\tpub type json_malloc_t = Option<unsafe extern \"C\" fn(usize) -> *mut c_void>;\n178\tpub type json_realloc_t = Option<unsafe extern \"C\" fn(*mut c_void, usize) -> *mut c_void>;\n179\tpub type json_free_t = Option<unsafe extern \"C\" fn(*mut c_void)>;\n180\t\n181\t/* ---------------------------------------------------- inline C helpers */\n182\t\n183\t#[inline]\n184\tpub unsafe fn json_typeof(json: *const json_t) -> c_int {\n185\t    (*json).type_\n186\t}\n187\t\n188\t#[inline]\n189\tpub unsafe fn json_is_object(json: *const json_t) -> bool {\n190\t    !json.is_null() && json_typeof(json) == JSON_OBJECT\n191\t}\n192\t\n193\t#[inline]\n194\tpub unsafe fn json_is_array(json: *const json_t) -> bool {\n195\t    !json.is_null() && json_typeof(json) == JSON_ARRAY\n196\t}\n197\t\n198\t#[inline]\n199\tpub unsafe fn json_is_string(json: *const json_t) -> bool {\n200\t    !json.is_null() && json_typeof(json) == JSON_STRING\n201\t}\n202\t\n203\t#[inline]\n204\tpub unsafe fn json_is_integer(json: *const json_t) -> bool {\n205\t    !json.is_null() && json_typeof(json) == JSON_INTEGER\n206\t}\n207\t\n208\t#[inline]\n209\tpub unsafe fn json_is_real(json: *const json_t) -> bool {\n210\t    !json.is_null() && json_typeof(json) == JSON_REAL\n211\t}\n212\t\n213\t#[inline]\n214\tpub unsafe fn json_is_number(json: *const json_t) -> bool {\n215\t    json_is_integer(json) || json_is_real(json)\n216\t}\n217\t\n218\t#[inline]\n219\tpub unsafe fn json_is_true(json: *const json_t) -> bool {\n220\t    !json.is_null() && json_typeof(json) == JSON_TRUE\n221\t}\n222\t\n223\t#[inline]\n224\tpub unsafe fn json_is_false(json: *const json_t) -> bool {\n225\t    !json.is_null() && json_typeof(json) == JSON_FALSE\n226\t}\n227\t\n228\t#[inline]\n229\tpub unsafe fn json_is_boolean(json: *const json_t) -> bool {\n230\t    json_is_true(json) || json_is_false(json)\n231\t}\n232\t\n233\t#[inline]\n234\tpub unsafe fn json_is_null(json: *const json_t) -> bool {\n235\t    !json.is_null() && json_typeof(json) == JSON_NULL\n236\t}\n237\t\n238\t/// `json_incref` from jansson.h (non-atomic variant: `++json->refcount`).\n239\t#[inline]\n240\tpub unsafe fn json_incref(json: *mut json_t) -> *mut json_t {\n241\t    if !json.is_null() && (*json).refcount != usize::MAX {\n242\t        (*json).refcount = (*json).refcount.wrapping_add(1);\n243\t    }\n244\t    json\n245\t}\n246\t\n247\t/// `json_decref` from jansson.h (non-atomic variant: `--json->refcount`).\n248\t#[inline]\n249\tpub unsafe fn json_decref(json: *mut json_t) {\n250\t    if !json.is_null() && (*json).refcount != usize::MAX {\n251\t        (*json).refcount = (*json).refcount.wrapping_sub(1);\n252\t        if (*json).refcount == 0 {\n253\t            crate::value::json_delete(json);\n254\t        }\n255\t    }\n256\t}\n257\t\n258\t/* --------------------------------------------------------------- libc FFI */\n259\t\n260\tpub type FILE = c_void;\n261\t\n262\textern \"C\" {\n263\t    pub fn malloc(size: usize) -> *mut c_void;\n264\t    pub fn realloc(ptr: *mut c_void, size: usize) -> *mut c_void;\n265\t    pub fn free(ptr: *mut c_void);\n266\t    pub fn memcpy(dst: *mut c_void, src: *const c_void, n: usize) -> *mut c_void;\n267\t    pub fn memmove(dst: *mut c_void, src: *const c_void, n: usize) -> *mut c_void;\n268\t    pub fn memset(dst: *mut c_void, c: c_int, n: usize) -> *mut c_void;\n269\t    pub fn memcmp(a: *const c_void, b: *const c_void, n: usize) -> c_int;\n270\t    pub fn memchr(s: *const c_void, c: c_int, n: usize) -> *mut c_void;\n271\t    pub fn strlen(s: *const c_char) -> usize;\n272\t    pub fn strcmp(a: *const c_char, b: *const c_char) -> c_int;\n273\t    pub fn strchr(s: *const c_char, c: c_int) -> *mut c_char;\n274\t    pub fn strerror(errnum: c_int) -> *mut c_char;\n275\t    pub fn strtod(s: *const c_char, endptr: *mut *mut c_char) -> f64;\n276\t    pub fn strtoll(s: *const c_char, endptr: *mut *mut c_char, base: 