ic json_t *pack_real(scanner_t *s, double value) {\n400\t    /* Allocate without setting value so we can identify OOM error. */\n401\t    json_t *json = json_real(0.0);\n402\t\n403\t    if (!json) {\n404\t        set_error(s, \"<internal>\", json_error_out_of_memory, \"Out of memory\");\n405\t        s->has_error = 1;\n406\t\n407\t        return NULL;\n408\t    }\n409\t\n410\t    if (json_real_set(json, value)) {\n411\t        json_decref(json);\n412\t\n413\t        set_error(s, \"<args>\", json_error_numeric_overflow,\n414\t                  \"Invalid floating point value\");\n415\t        s->has_error = 1;\n416\t\n417\t        return NULL;\n418\t    }\n419\t\n420\t    return json;\n421\t}\n422\t\n423\tstatic json_t *pack(scanner_t *s, va_list *ap) {\n424\t    switch (token(s)) {\n425\t        case '{':\n426\t            return pack_object(s, ap);\n427\t\n428\t        case '[':\n429\t            return pack_array(s, ap);\n430\t\n431\t        case 's': /* string */\n432\t            return pack_string(s, ap);\n433\t\n434\t        case 'n': /* null */\n435\t            return json_null();\n436\t\n437\t        case 'b': /* boolean */\n438\t            return va_arg(*ap, int) ? json_true() : json_false();\n439\t\n440\t        case 'i': /* integer from int */\n441\t            return pack_integer(s, va_arg(*ap, int));\n442\t\n443\t        case 'I': /* integer from json_int_t */\n444\t            return pack_integer(s, va_arg(*ap, json_int_t));\n445\t\n446\t        case 'f': /* real */\n447\t            return pack_real(s, va_arg(*ap, double));\n448\t\n449\t        case 'O': /* a json_t object; increments refcount */\n450\t            return pack_object_inter(s, ap, 1);\n451\t\n452\t        case 'o': /* a json_t object; doesn't increment refcount */\n453\t            return pack_object_inter(s, ap, 0);\n454\t\n455\t        default:\n456\t            set_error(s, \"<format>\", json_error_invalid_format,\n457\t                      \"Unexpected format character '%c'\", token(s));\n458\t            s->has_error = 1;\n459\t            return NULL;\n460\t    }\n461\t}\n462\t\n463\tstatic int unpack(scanner_t *s, json_t *root, va_list *ap);\n464\t\n465\tstatic int unpack_object(scanner_t *s, json_t *root, va_list *ap) {\n466\t    int ret = -1;\n467\t    int strict = 0;\n468\t    int gotopt = 0;\n469\t\n470\t    /* Use a set (emulated by a hashtable) to check that all object\n471\t       keys are accessed. Checking that the correct number of keys\n472\t       were accessed is not enough, as the same key can be unpacked\n473\t       multiple times.\n474\t    */\n475\t    hashtable_t key_set;\n476\t\n477\t    if (hashtable_init(&key_set)) {\n478\t        set_error(s, \"<internal>\", json_error_out_of_memory, \"Out of memory\");\n479\t        return -1;\n480\t    }\n481\t\n482\t    if (root && !json_is_object(root)) {\n483\t        set_error(s, \"<validation>\", json_error_wrong_type, \"Expected object, got %s\",\n484\t                  type_name(root));\n485\t        goto out;\n486\t    }\n487\t    next_token(s);\n488\t\n489\t    while (token(s) != '}') {\n490\t        const char *key;\n491\t        size_t key_len;\n492\t        json_t *value;\n493\t        int opt = 0;\n494\t\n495\t        if (strict != 0) {\n496\t            set_error(s, \"<format>\", json_error_invalid_format,\n497\t                      \"Expected '}' after '%c', got '%c'\", (strict == 1 ? '!' : '*'),\n498\t                      token(s));\n499\t            goto out;\n500\t        }\n501\t\n502\t        if (!token(s)) {\n503\t            set_error(s, \"<format>\", json_error_invalid_format,\n504\t                      \"Unexpected end of format string\");\n505\t            goto out;\n506\t        }\n507\t\n508\t        if (token(s) == '!' || token(s) == '*') {\n509\t            strict = (token(s) == '!' ? 1 : -1);\n510\t            next_token(s);\n511\t            continue;\n512\t        }\n513\t\n514\t        if (token(s) != 's') {\n515\t            set_error(s, \"<format>\", json_error_invalid_format,\n516\t                      \"Expected format 's', got '%c'\", token(s));\n517\t            goto out;\n518\t        }\n519\t\n520\t        key = va_arg(*ap, const char *);\n521\t        if (!key) {\n522\t            set_error(s, \"<args>\", json_error_null_value, \"NULL object key\");\n523\t            goto out;\n524\t        }\n525\t        key_len = strlen(key);\n526\t\n527\t        next_token(s);\n528\t\n529\t        if (token(s) == '?') {\n530\t            opt = gotopt = 1;\n531\t            next_token(s);\n532\t        }\n533\t\n534\t        if (!root) {\n535\t            /* skipping */\n536\t            value = NULL;\n537\t        } else {\n538\t            value = json_object_getn(root, key, key_len);\n539\t            if (!value && !opt) {\n540\t                set_error(s, \"<validation>\", json_error_item_not_found,\n541\t                          \"Object item not found: %s\", key);\n542\t                goto out;\n543\t            }\n544\t        }\n545\t\n546\t        if (unpack(s, value, ap))\n547\t            goto out;\n548\t\n549\t        hashtable_set(&key_set, key, key_len, json_null());\n550\t        next_token(s);\n551\t    }\n552\t\n553\t    if (strict == 0 && (s->flags & JSON_STRICT))\n554\t        strict = 1;\n555\t\n556\t    if (root && strict == 1) {\n557\t        /* We need to check that all non optional items have been parsed */\n558\t        const char *key;\n559\t        size_t key_len;\n560\t        /* keys_res is 1 for uninitialized, 0 for success, -1 for error. */\n561\t        int keys_res = 1;\n562\t        strbuffer_t unrecognized_keys;\n563\t        json_t *value;\n564\t        long unpacked = 0;\n565\t\n566\t        if (gotopt || json_object_size(root) != key_set.size) {\n567\t            json_object_keylen_foreach(root, key, key_len, value) {\n568\t                if (!hashtable_get(&key_set, key, key_len)) {\n569\t                    unpacked++;\n570\t\n571\t                    /* Save unrecognized keys for the error message */\n572\t                    if (keys_res == 1) {\n573\t                        keys_res = strbuffer_init(&unrecognized_keys);\n574\t                    } else if (!keys_res) {\n575\t                        keys_res = strbuffer_append_bytes(&unrecognized_keys, \", \", 2);\n576\t                    }\n577\t\n578\t                    if (!keys_res)\n579\t                        keys_res =\n580\t                            strbuffer_append_bytes(&unrecognized_keys, key, key_len);\n581\t                }\n582\t            }\n583\t        }\n584\t        if (unpacked) {\n585\t            set_error(s, \"<validation>\", json_error_end_of_input_expected,\n586\t                      \"%li object item(s) left unpacked: %s\", unpacked,\n587\t                      keys_res ? \"<unknown>\" : strbuffer_value(&unrecognized_keys));\n588\t            strbuffer_close(&unrecognized_keys);\n589\t            goto out;\n590\t        }\n591\t    }\n592\t\n593\t    ret = 0;\n594\t\n595\tout:\n596\t    hashtable_close(&key_set);\n597\t    return ret;\n598\t}\n599\t\n600\tstatic int unpack_array(scanner_t *s, json_t *root, va_list *ap) {\n601\t    size_t i = 0;\n602\t    int strict = 0;\n603\t\n604\t    if (root && !json_is_array(root)) {\n605\t        set_error(s, \"<validation>\", json_error_wrong_type, \"Expected array, got %s\",\n606\t                  type_name(root));\n607\t        return -1;\n608\t    }\n609\t    next_token(s);\n610\t\n611\t    while (token(s) != ']') {\n612\t        json_t *value;\n613\t\n614\t        if (strict != 0) {\n615\t            set_error(s, \"<format>\", json_error_invalid_format,\n616\t                      \"Expected ']' after '%c', got '%c'\", (strict == 1 ? '!' : '*'),\n617\t                      token(s));\n618\t            return -1;\n619\t        }\n620\t\n621\t        if (!token(s)) {\n622\t            set_error(s, \"<format>\", json_error_invalid_format,\n623\t                      \"Unexpected end of format string\");\n624\t            return -1;\n625\t        }\n626\t\n627\t        if (token(s) == '!' || token(s) == '*') {\n628\t            strict = (token(s) == '!' ? 1 : -1);\n629\t            next_token(s);\n630\t            continue;\n631\t        }\n632\t\n633\t        if (!strchr(unpack_value_starters, token(s))) {\n634\t            set_error(s, \"<format>\", json_error_invalid_format,\n635\t                      \"Unexpected format character '%c'\", token(s));\n636\t            return -1;\n637\t        }\n638\t\n639\t        if (!root) {\n640\t            /* skipping */\n641\t            value = NULL;\n642\t        } else {\n643\t            value = json_array_get(root, i);\n644\t            if (!value) {\n645\t                set_error(s, \"<validation>\", json_error_index_out_of_range,\n646\t                          \"Array index %lu out of range\", (unsigned long)i);\n647\t                return -1;\n648\t            }\n649\t        }\n650\t\n651\t        if (unpack(s, value, ap))\n652\t            return -1;\n653\t\n654\t        next_token(s);\n655\t        i++;\n656\t    }\n657\t\n658\t    if (strict == 0 && (s->flags & JSON_STRICT))\n659\t        strict = 1;\n660\t\n661\t    if (root && strict == 1 && i != json_array_size(root)) {\n662\t        long diff = (long)json_array_size(root) - (long)i;\n663\t        set_error(s, \"<validation>\", json_error_end_of_input_expected,\n664\t                  \"%li array item(s) left unpacked\", diff);\n665\t        return -1;\n666\t    }\n667\t\n668\t    return 0;\n669\t}\n670\t\n671\tstatic int unpack(scanner_t *s, json_t *root, va_list *ap) {\n672\t    switch (token(s)) {\n673\t        case '{':\n674\t            return unpack_object(s, root, ap);\n675\t\n676\t        case '[':\n677\t            return unpack_array(s, root, ap);\n678\t\n679\t        case 's':\n680\t            if (root && !json_is_string(root)) {\n681\t                set_error(s, \"<validation>\", json_error_wrong_type,\n682\t                          \"Expected string, got %s\", type_name(root));\n683\t                return -1;\n684\t            }\n685\t\n686\t            if (!(s->flags & JSON_VALIDATE_ONLY)) {\n687\t                const char **str_target;\n688\t                size_t *len_target = NULL;\n689\t\n690\t                str_target = va_arg(*ap, const char **);\n691\t                if (!str_target) {\n692\t                    set_error(s, \"<args>\", json_error_null_value, \"NULL string argument\");\n693\t                    return -1;\n694\t                }\n695\t\n696\t                next_token(s);\n697\t\n698\t                if (token(s) == '%') {\n699\t                    len_target = va_arg(*ap, size_t *);\n700\t                    if (!len_target) {\n701\t                        set_error(s, \"<args>\", json_error_null_value,\n702\t                                  \"NULL string length argument\");\n703\t                        return -1;\n704\t                    }\n705\t                } else\n706\t                    prev_token(s);\n707\t\n708\t                if (root) {\n709\t                    *str_target = json_string_value(root);\n710\t                    if (len_target)\n711\t                        *len_target = json_string_length(root);\n712\t                }\n713\t            }\n714\t            return 0;\n715\t\n716\t        case 'i':\n717\t            if (root && !json_is_integer(root)) {\n718\t                set_error(s, \"<validation>\", json_error_wrong_type,\n719\t                          \"Expected integer, got %s\", type_name(root));\n720\t                return -1;\n721\t            }\n722\t\n723\t            if (!(s->flags & JSON_VALIDATE_ONLY)) {\n724\t                int *target = va_arg(*ap, int *);\n725\t                if (root)\n726\t                    *target = (int)json_integer_value(root);\n727\t            }\n728\t\n729\t            return 0;\n730\t\n731\t        case 'I':\n732\t            if (root && !json_is_integer(root)) {\n733\t                set_error(s, \"<validation>\", json_error_wrong_type,\n734\t                          \"Expected integer, got %s\", type_name(root));\n735\t                return -1;\n736\t            }\n737\t\n738\t            if (!(s->flags & JSON_VALIDATE_ONLY)) {\n739\t                json_int_t *target = va_arg(*ap, json_int_t *);\n740\t                if (root)\n741\t                    *target = json_integer_value(root);\n742\t            }\n743\t\n744\t            return 0;\n745\t\n746\t        case 'b':\n747\t            if (root && !json_is_boolean(root)) {\n748\t                set_error(s, \"<validation>\", json_error_wrong_type,\n749\t                          \"Expected true or false, got %s\", type_name(root));\n750\t                return -1;\n751\t            }\n752\t\n753\t            if (!(s->flags & JSON_VALIDATE_ONLY)) {\n754\t                int *target = va_arg(*ap, int *);\n755\t                if (root)\n756\t                    *target = json_is_true(root);\n757\t            }\n758\t\n759\t            return 0;\n760\t\n761\t        case 'f':\n762\t            if (root && !json_is_real(root)) {\n763\t                set_error(s, \"<validation>\", json_error_wrong_type,\n764\t                          \"Expected real, got %s\", type_name(root));\n765\t                return -1;\n766\t            }\n767\t\n768\t            if (!(s->flags & JSON_VALIDATE_ONLY)) {\n769\t                double *target = va_arg(*ap, double *);\n770\t                if (root)\n771\t                    *target = json_real_value(root);\n772\t            }\n773\t\n774\t            return 0;\n775\t\n776\t        case 'F':\n777\t            if (root && !json_is_number(root)) {\n778\t                set_error(s, \"<validation>\", json_error_wrong_type,\n779\t                          \"Expected real or integer, got %s\", type_name(root));\n780\t                return -1;\n781\t            }\n782\t\n783\t            if (!(s->flags & JSON_VALIDATE_ONLY)) {\n784\t                double *target = va_arg(*ap, double *);\n785\t                if (root)\n786\t                    *target = json_number_value(root);\n787\t            }\n788\t\n789\t            return 0;\n790\t\n791\t        case 'O':\n792\t            if (root && !(s->flags & JSON_VALIDATE_ONLY))\n793\t                json_incref(root);\n794\t            /* Fall through */\n795\t\n796\t        case 'o':\n797\t            if (!(s->flags & JSON_VALIDATE_ONLY)) {\n798\t                json_t **target = va_arg(*ap, json_t **);\n799\t                if (root)\n800\t                    *target = root;\n801\t            }\n802\t\n803\t            return 0;\n804\t\n805\t        case 'n':\n806\t            /* Never assign, just validate */\n807\t            if (root && !json_is_null(root)) {\n808\t                set_error(s, \"<validation>\", json_error_wrong_type,\n809\t                          \"Expected null, got %s\", type_name(root));\n810\t                return -1;\n811\t            }\n812\t            return 0;\n813\t\n814\t        default:\n815\t            set_error(s, \"<format>\", json_error_invalid_format,\n816\t                      \"Unexpected format character '%c'\", token(s));\n817\t            return -1;\n818\t    }\n819\t}\n820\t\n821\tjson_t *json_vpack_ex(json_error_t *error, size_t flags, const char *fmt, va_list ap) {\n822\t    scanner_t s;\n823\t    va_list ap_copy;\n824\t    json_t *value;\n825\t\n826\t    if (!fmt || !*fmt) {\n827\t        jsonp_error_init(error, \"<format>\");\n828\t        jsonp_error_set(error, -1, -1, 0, json_error_invalid_argument,\n829\t                        \"NULL or empty format string\");\n830\t        return NULL;\n831\t    }\n832\t    jsonp_error_init(error, NULL);\n833\t\n834\t    scanner_init(&s, error, flags, fmt);\n835\t    next_token(&s);\n836\t\n837\t    va_copy(ap_copy, ap);\n838\t    value = pack(&s, &ap_copy);\n839\t    va_end(ap_copy);\n840\t\n841\t    /* This will cover all situations where s.has_error is true */\n842\t    if (!value)\n843\t        return NULL;\n844\t\n845\t    next_token(&s);\n846\t    if (token(&s)) {\n847\t        json_decref(value);\n848\t        set_error(&s, \"<format>\", json_error_invalid_format,\n849\t                  \"Garbage after format string\");\n850\t        return NULL;\n851\t    }\n852\t\n853\t    return value;\n854\t}\n855\t\n856\tjson_t *json_pack_ex(json_error_t *error, size_t flags, const char *fmt, ...) {\n857\t    json_t *value;\n858\t    va_list ap;\n859\t\n860\t    va_start(ap, fmt);\n861\t    value = json_vpack_ex(error, flags, fmt, ap);\n862\t    va_end(ap);\n863\t\n864\t    return value;\n865\t}\n866\t\n867\tjson_t *json_pack(const char *fmt, ...) {\n868\t    json_t *value;\n869\t    va_list ap;\n870\t\n871\t    va_start(ap, fmt);\n872\t    value = json_vpack_ex(NULL, 0, fmt, ap);\n873\t    va_end(ap);\n874\t\n875\t    return value;\n876\t}\n877\t\n878\tint json_vunpack_ex(json_t *root, json_error_t *error, size_t flags, const char *fmt,\n879\t                    va_list ap) {\n880\t    scanner_t s;\n881\t    va_list ap_copy;\n882\t\n883\t    if (!root) {\n884\t        jsonp_error_init(error, \"<root>\");\n885\t        jsonp_error_set(error, -1, -1, 0, json_error_null_value, \"NULL root value\");\n886\t        return -1;\n887\t    }\n888\t\n889\t    if (!fmt || !*fmt) {\n890\t        jsonp_error_init(error, \"<format>\");\n891\t        jsonp_error_set(error, -1, -1, 0, json_error_invalid_argument,\n892\t                        \"NULL or empty format string\");\n893\t        return -1;\n894\t    }\n895\t    jsonp_error_init(error, NULL);\n896\t\n897\t    scanner_init(&s, error, flags, fmt);\n898\t    next_token(&s);\n899\t\n900\t    va_copy(ap_copy, ap);\n901\t    if (unpack(&s, root, &ap_copy)) {\n902\t        va_end(ap_copy);\n903\t        return -1;\n904\t    }\n905\t    va_end(ap_copy);\n906\t\n907\t    next_token(&s);\n908\t    if (token(&s)) {\n909\t        set_error(&s, \"<format>\", json_error_invalid_format,\n910\t                  \"Garbage after format string\");\n911\t        return -1;\n912\t    }\n913\t\n914\t    return 0;\n915\t}\n916\t\n917\tint json_unpack_ex(json_t *root, json_error_t *error, size_t flags, const char *fmt,\n918\t                   ...) {\n919\t    int ret;\n920\t    va_list ap;\n921\t\n922\t    va_start(ap, fmt);\n923\t    ret = json_vunpack_ex(root, error, flags, fmt, ap);\n924\t    va_end(ap);\n925\t\n926\t    return ret;\n927\t}\n928\t\n929\tint json_unpack(json_t *root, const char *fmt, ...) {\n930\t    int ret;\n931\t    va_list ap;\n932\t\n933\t    va_start(ap, fmt);\n934\t    ret = json_vunpack_ex(root, NULL, 0, fmt, ap);\n935\t    va_end(ap);\n936\t\n937\t    return ret;\n938\t}\n939\t"}]},"parent_tool_use_id":null,"session_id":"d4cf60c4-25a5-4fee-b0fc-0b215e8b9320","uuid":"b22c312e-2912-468c-ab88-85adbe4242b7","timestamp":"2026-08-22T17:55:36.928Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-JHBtwp/translated_rust/c_src/src/pack_unpack.c","content":"/*\n * Copyright (c) 2009-2016 Petri Lehtinen <petri@digip.org>\n * Copyright (c) 2011-2012 Graeme Smecher <graeme.smecher@mail.mcgill.ca>\n *\n * Jansson is free software; you can redistribute it and/or modify\n * it under the terms of the MIT license. See LICENSE for details.\n */\n\n#include \"jansson.h\"\n#include \"jansson_private.h\"\n#include \"utf.h\"\n#include <string.h>\n\ntypedef struct {\n    int line;\n    int column;\n    size_t pos;\n    char token;\n} token_t;\n\ntypedef struct {\n    const char *start;\n    const char *fmt;\n    token_t prev_token;\n    token_t token;\n    token_t next_token;\n    json_error_t *error;\n    size_t flags;\n    int line;\n    int column;\n    size_t pos;\n    int has_error;\n} scanner_t;\n\n#define token(scanner) ((scanner)->token.token)\n\nstatic const char *const type_names[] = {\"object\", \"array\", \"string\", \"integer\",\n                                         \"real\",   \"true\",  \"false\",  \"null\"};\n\n#define type_name(x) type_names[json_typeof(x)]\n\nstatic const char unpack_value_starters[] = \"{[siIbfFOon\";\n\nstatic void scanner_init(scanner_t *s, json_error_t *error, size_t flags,\n                         const char *fmt) {\n    s->error = error;\n    s->flags = flags;\n    s->fmt = s->start = fmt;\n    memset(&s->prev_token, 0, sizeof(token_t));\n    memset(&s->token, 0, sizeof(token_t));\n    memset(&s->next_token, 0, sizeof(token_t));\n    s->line = 1;\n    s->column = 0;\n    s->pos = 0;\n    s->has_error = 0;\n}\n\nstatic void next_token(scanner_t *s) {\n    const char *t;\n    s->prev_token = s->token;\n\n    if (s->next_token.line) {\n        s->token = s->next_token;\n        s->next_token.line = 0;\n        return;\n    }\n\n    if (!token(s) && !*s->fmt)\n        return;\n\n    t = s->fmt;\n    s->column++;\n    s->pos++;\n\n    /* skip space and ignored chars */\n    while (*t == ' ' || *t == '\\t' || *t == '\\n' || *t == ',' || *t == ':') {\n        if (*t == '\\n') {\n            s->line++;\n            s->column = 1;\n        } else\n            s->column++;\n\n        s->pos++;\n        t++;\n    }\n\n    s->token.token = *t;\n    s->token.line = s->line;\n    s->token.column = s->column;\n    s->token.pos = s->pos;\n\n    if (*t)\n        t++;\n    s->fmt = t;\n}\n\nstatic void prev_token(scanner_t *s) {\n    s->next_token = s->token;\n    s->token = s->prev_token;\n}\n\nstatic void set_error(scanner_t *s, const char *source, enum json_error_code code,\n                      const char *fmt, ...) {\n    va_list ap;\n    va_start(ap, fmt);\n\n    jsonp_error_vset(s->error, s->token.line, s->token.column, s->token.pos, code, fmt,\n                     ap);\n\n    jsonp_error_set_source(s->error, source);\n\n    va_end(ap);\n}\n\nstatic json_t *pack(scanner_t *s, va_list *ap);\n\n/* ours will be set to 1 if jsonp_free() must be called for the result\n   afterwards */\nstatic char *read_string(scanner_t *s, va_list *ap, const char *purpose, size_t