::read(mul1.offset(idx));\n        let b = std::ptr::read(mul2.offset(idx));\n        let c = std::ptr::read(add.offset(idx));\n        std::ptr::write(out.offset(idx), a.wrapping_mul(b).wrapping_add(c));","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
