\n520\t\t\tv->iB = iB;\n521\t\t\tv->sB = sB;\n522\t\t\tv->p = c2Sub(v->sB, v->sA);\n523\t\t\tint dup = 0;\n524\t\t\tfor (int i = 0; i < save_count; ++i) {\n525\t\t\t\tif (iA == saveA[i] && iB == saveB[i]) {\n526\t\t\t\t\tdup = 1;\n527\t\t\t\t\tbreak;\n528\t\t\t\t}\n529\t\t\t}\n530\t\t\tif (dup)\n531\t\t\t\tbreak;\n532\t\t\t++s.count;\n533\t\t\t++iter;\n534\t\t}\n535\t\tc2v a, b;\n536\t\tc2Witness(&s, &a, &b);\n537\t\tfloat dist = c2Len(c2Sub(a, b));\n538\t\tif (hit) {\n539\t\t\ta = b;\n540\t\t\tdist = 0;\n541\t\t} else if (use_radius) {\n542\t\t\tfloat rA = pA.radius;\n543\t\t\tfloat rB = pB.radius;\n544\t\t\tif (dist > rA + rB &&\n545\t\t\t\t\tdist > 1.19209289550781250000000000000000000e-7F) {\n546\t\t\t\tdist -= rA + rB;\n547\t\t\t\tc2v n = c2Norm(c2Sub(b, a));\n548\t\t\t\ta = c2Add(a, c2Mulvs(n, rA));\n549\t\t\t\tb = c2Sub(b, c2Mulvs(n, rB));\n550\t\t\t\tif (a.x == b.x && a.y == b.y)\n551\t\t\t\t\tdist = 0;\n552\t\t\t} else {\n553\t\t\t\tc2v p = c2Mulvs(c2Add(a, b), 0.5f);\n554\t\t\t\ta = p;\n555\t\t\t\tb = p;\n556\t\t\t\tdist = 0;\n557\t\t\t}\n558\t\t}\n559\t\tif (cache) {\n560\t\t\tcache->metric = c2GJKSimplexMetric(&s);\n561\t\t\tcache->count = s.count;\n562\t\t\tfor (int i = 0; i < s.count; ++i) {\n563\t\t\t\tc2sv *v = verts + i;\n564\t\t\t\tcache->iA[i] = v->iA;\n565\t\t\t\tcache->iB[i] = v->iB;\n566\t\t\t}\n567\t\t\tcache->div = s.div;\n568\t\t}\n569\t\tif (outA)\n570\t\t\t*outA = a;\n571\t\tif (outB)\n572\t\t\t*outB = b;\n573\t\tif (iterations)\n574\t\t\t*iterations = iter;\n575\t\treturn dist;\n576\t}\n577\t\n578\tc2v c2Absv(c2v a) {\n579\t    return c2V(((a.x) < 0 ? -(a.x) : (a.x)), ((a.y) < 0 ? -(a.y) : (a.y)));\n580\t}\n581\t\n582\tvoid c2CircletoCircleManifold(c2Circle A, c2Circle B, c2Manifold *m) {\n583\t    m->count = 0;\n584\t    c2v d = c2Sub(B.p, A.p);\n585\t    float d2 = c2Dot(d, d);\n586\t    float r = A.r + B.r;\n587\t    if (d2 < r * r) {\n588\t        float l = sqrtf(d2);\n589\t        c2v n = l != 0 ? c2Mulvs(d, 1.0f / l) : c2V(0, 1.0f);