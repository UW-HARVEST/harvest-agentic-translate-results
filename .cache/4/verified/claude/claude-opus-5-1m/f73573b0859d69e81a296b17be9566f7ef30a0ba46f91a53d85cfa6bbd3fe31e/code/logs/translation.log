mt_int(out: &mut Vec<u8>, value: c_int) {\n    let mut tmp = [0u8; 11];\n    let negative = value < 0;\n    // Use the unsigned magnitude so that INT_MIN is handled correctly.\n    let mut mag: u32 = if negative {\n        (value as i64).unsigned_abs() as u32\n    } else {\n        value as u32\n    };\n\n    let mut idx = tmp.len();\n    if mag == 0 {\n        idx -= 1;\n        tmp[idx] = b'0';\n    } else {\n        while mag > 0 {\n            idx -= 1;\n            tmp[idx] = b'0' + (mag % 10) as u8;\n            mag /= 10;\n        }\n    }\n\n    if negative {\n        out.push(b'-');\n    }\n    out.extend_from_slice(&tmp[idx..]);\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1367,"cache_read_input_tokens":17045,"cache_creation":{"ephemeral_5m_input_tokens":1367,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"5b648193-1fce-4605-b1a6-14489c4da22a","uuid":"fa8072be-92d1-4d0c-9f24-c7b3a8fb9ec9","timestamp":"2026-08-19T16:34:47.358Z"}
