r the full char range ---\n    printf(\"[is_valid_operation]\\n\");\n    for (int c = -128; c <= 127; c++) printf(\"%d:%d \", c, (int)is_valid_operation((char)c));\n    printf(\"\\n\");\n\n    // --- get_operation_priority ---\n    printf(\"[get_operation_priority]\\n\");\n    int prio_in[] = {0,1,2,3,4,5,6,-1,-7,1000,INT_MAX,INT_MIN,214748365,-214748365};\n    for (unsigned i=0;i<sizeof(prio_in)/sizeof(int);i++) printf(\"%d->%d \", prio_in[i], get_operation_priority(prio_in[i]));\n    printf(\"\\n\");\n\n    // --- arithmetic ops (incl. overflow + div/mod by zero + negatives) ---\n    printf(\"[arith]\\n\");\n    int vals[] = {0,1,-1,2,-2,7,-7,3,-3,100,-100,INT_MAX,INT_MIN,65536,-65536};\n    int n = sizeof(vals)/sizeof(int);\n    for (int i=0;i<n;i++) for (int j=0;j<n;j++) {\n        int a=vals[i], b=vals[j];\n        printf(\"%d,%d|%d %d %d\", a,b, add_operation(a,b,999), multiply_operation(a,b,-5), subtract_operation(a,b,0));\n        // skip INT_MIN / -1 : genuine SIGFPE in the C original\n        if (!(a==INT_MIN && b==-1)) printf(\" %d %d\", divide_operation(a,b,1), modulo_operation(a,b,2));\n        else printf(\" SKIP SKIP\");\n        printf(\"\\n\");\n    }\n\n    // --- select_operation: identify which symbol is returned ---\n    printf(\"[select_operation]\\n\");\n    for (int op=-3; op<=9; op++) {\n        MathOp f = select_operation(op);\n        const char* nm = f==add_operation?\"add\":f==multiply_operation?\"mul\":\n                         f==subtract_operation?\"sub\":f==divide_operation?\"div\":\n                         f==modulo_operation?\"mod\":\"UNKNOWN\";\n        printf(\"%d->%s(%d) \", op, nm, f(20,6,0));\n    }\n    printf(\"\\n\");\n\n    // --- get_computation_timestamp ---\n    printf(\"[timestamp] %ld\\n\", (long)get_computation_timestamp());\n\n    // --- allocate_results: zero-init, sizes, overflow/negative counts ---\n    printf(\"[allocate_results]\\n\");\n    int counts[] = {0,1,10,100,-1,-10};\n    for (unsigned i=0;i<sizeof(counts)/sizeof(int);i++) {\n        CR* p = allocate_results(counts[i]);\n        printf(\"count=%d null=%d\", counts[i], p==NULL);\n        if (p && counts[i] > 0) {\n            int zeroed = 1;\n            for (int k=0;k<counts[i];k++)\n                if (p[k].value||p[k].timestamp||p[k].status) zeroed = 0;\n            printf(\" zeroed=%d\", zeroed);\n        }\n        printf(\"\\n\");\n        free(p);\n    }\n\n    // --- perform_computation_with_history: NULL-init path + 10-entry cap ---\n    printf(\"[perform_computation_with_history]\\n\");\n    CR* hist = NULL; int hc = 0;\n    for (int i=0;i<14;i++) {\n        int r = perform_computation_with_history(i*3-5, (i%4)-1, (i%7)-1, &hist, &hc);\n        printf(\"i=%d r=%d hc=%d\", i, r, hc);\n        if (hist && hc>0) printf(\" last{v=%d,ts=%ld,st=%d}\", hist[hc-1].value,(long)hist[hc-1].timestamp,hist[hc-1].status);\n        printf(\"\\n\");\n    }\n    // full dump of the history block\n    for (int k=0;k<10;k++) printf(\"  slot%d v=%d ts=%ld st=%d\\n\", k, hist[k].value, (long)hist[k].timestamp, hist[k].status);\n    free(hist);\n\n    // pre-existing non-NULL history with count already at 10 (no-op path)\n    CR* h2 = allocate_results(10); int hc2 = 10;\n    printf(\"capped r=%d hc=%d\\n\", perform_computation_with_history(5,5,1,&h2,&hc2), hc2);\n    free(h2);\n\n    // --- mathop: stateful sequence, exercises the static history saturation ---\n    printf(\"[mathop]\\n\");\n    int mp[][4] = {\n        {0,0,0,0},{1,2,3,4},{49,7,1,1},{50,3,2,2},{-5,-3,-1,-2},{100,0,4,0},\n        {7,-2,3,9},{INT_MAX,1,2,3},{INT_MIN,-1,0,4},{255,128,5,5},{53,11,-7,-9},\n        {12345,678,10,20},{-99999,3,-3,-4},{2,2,2,2},{1,1,1,1},{0,-1,-2,-3}\n    };\n    for (unsigned i=0;i<sizeof(mp)/sizeof(mp[0]);i++) {\n        printf(\"--- call %u args %d %d %d %d\\n\", i, mp[i][0],mp[i][1],mp[i][2],mp[i][3]);\n        printf(\"ret=%d\\n\", mathop(mp[i][0],mp[i][1],mp[i][2],mp[i][3]));\n    }\n    fflush(stdout);\n    return 0;\n}\nEOF