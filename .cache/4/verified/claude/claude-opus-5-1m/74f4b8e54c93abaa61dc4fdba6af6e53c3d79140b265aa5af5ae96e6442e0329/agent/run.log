|| true)\"\necho \"${UNRESOLVED:-<none>}\"\n\nrc=0\nif [ -s \"$tmp/missing.txt\" ]; then\n    echo \"FAIL: Rust .so is missing $(wc -l < \"$tmp/missing.txt\") C symbol(s)\"\n    rc=1\nfi\nif [ -n \"$UNRESOLVED\" ]; then\n    echo \"FAIL: unresolved symbols in the Rust .so\"\n    rc=1\nfi\n[ $rc -eq 0 ] && echo \"PASS: symbol parity ($PROFILE)\"\nexit $rc\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":562,"cache_read_input_tokens":94694,"cache_creation":{"ephemeral_5m_input_tokens":562,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"fac44ee6-b778-4862-a8e1-a47947e5f656","uuid":"93aff353-d4a6-4fd8-8875-80e64a8e7543","timestamp":"2026-08-18T01:57:58.368Z"}
