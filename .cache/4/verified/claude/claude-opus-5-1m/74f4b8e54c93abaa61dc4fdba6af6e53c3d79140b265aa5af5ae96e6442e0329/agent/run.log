2\"\n\n[profile.release]\npanic = \"abort\"\n\n[workspace]\n","structuredPatch":[{"oldStart":13,"oldLines":6,"newStart":13,"newLines":12,"lines":[" name = \"driver\""," path = \"src/lib.rs\""," crate-type = [\"cdylib\"]","+# The cdylib exports a `main` symbol (a `-shared` build of main.c exports one","+# too), which would clash with the Rust-generated entry point of a libtest","+# harness, so the lib has no test target of its own; all testing happens in","+# tests/ through the `.so` exports.","+test = false","+doctest = false"," "," [[bin]]"," name = \"driver\""]}],"userModified":false,"replaceAll":false}}
