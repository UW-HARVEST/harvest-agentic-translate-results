i = 0; i < 30; ++i) {\n    bmap k;\n    memset(&k, 0, sizeof k);\n    k.key[0] = 0xff80000000000000ll | i;\n    k.key[1] = -(long long) i * 0x0102030405060708ll;\n    h = (bmap *) P_hmget_key(h, sizeof *h, k.key, sizeof k.key, STBDS_HM_BINARY);\n    ptrdiff_t idx = table_temp(h, sizeof *h);\n    printf(\"gets(%d) = %d idx=%td\\n\", i, idx >= 0 ? h[idx].value : -999, idx);\n  }\n  for (int i = 0; i < 30; i += 2) {\n    bmap k;\n    memset(&k, 0, sizeof k);\n    k.key[0] = 0xff80000000000000ll | i;\n    k.key[1] = -(long long) i * 0x0102030405060708ll;\n    h = (bmap *) P_hmdel_key(h, sizeof *h, k.key, sizeof k.key, offsetof(bmap, key), STBDS_HM_BINARY);\n    printf(\"del(%d) = %d\\n\", i, h ? (int) table_temp(h, sizeof *h) : 0);\n  }","originalFile":"/* Differential driver: dlopen a .so exporting the stb_ds ABI and exercise it. */\n#define _GNU_SOURCE\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stddef.h>\n#include <assert.h>\n#include <dlfcn.h>\n#include <limits.h>\n\n/* function pointers resolved from the library under test */\nstatic void  *(*P_arrgrowf)(void*,size_t,size_t,size_t);\nstatic void   (*P_arrfreef)(void*);\nstatic void   (*P_rand_seed)(size_t);\nstatic size_t (*P_hash_bytes)(void*,size_t,size_t);\nstatic size_t (*P_hash_string)(char*,size_t);\nstatic void   (*P_hmfree_func)(void*,size_t);\nstatic void  *(*P_hmget_key)(void*,size_t,void*,size_t,int);\nstatic void  *(*P_hmget_key_ts)(void*,size_t,void*,size_t,ptrdiff_t*,int);\nstatic void  *(*P_hmput_default)(void*,size_t);\nstatic void  *(*P_hmput_key)(void*,size_t,void*,size_t,int);\nstatic void  *(*P_hmdel_key)(void*,size_t,void*,size_t,size_t,int);\nstatic void  *(*P_shmode_func)(size_t,int);\nstatic char  *(*P_stralloc)(void*,char*);\nstatic void   (*P_strreset)(void*);\nstatic char  *(*P_strkey)(int);\nstatic void   (*P_helxo)(char);\n\n#include \"stbds_part.h\"\n\n/* route the macros through the dlsym'd entry points */\n#define stbds_arrgrowf_wrapper(a,b,c,d)        P_arrgrowf(a,b,c,d)\n#define stbds_hmget_key_wrapper(a,b,c,d,e)     P_hmget_key(a,b,c,d,e)\n#define stbds_hmget_key_ts_wrapper(a,b,c,d,e,f) P_hmget_key_ts(a,b,c,d,e,f)\n#define stbds_hmput_default_wrapper(a,b)       P_hmput_default(a,b)\n#define stbds_hmput_key_wrapper(a,b,c,d,e)     P_hmput_key(a,b,c,d,e)\n#define stbds_hmdel_key_wrapper(a,b,c,d,e,f)   P_hmdel_key(a,b,c,d,e,f)\n#define stbds_shmode_func_wrapper(t,e,m)       P_shmode_func(e,m)\n#define stbds_hmfree_func(p,e)                 P_hmfree_func(p,e)\n\n/* internal structures, copied verbatim from the C source, so the driver can\n   inspect table state (all of it is deterministic). */\ntypedef struct {\n   size_t    hash [8];\n   ptrdiff_t index[8];\n} t_hash_bucket;\n\ntypedef struct {\n  char * temp_key;\n  size_t slot_count;\n  size_t used_count;\n  size_t used_count_threshold;\n  size_t used_count_shrink_threshold;\n  size_t tombstone_count;\n  size_t tombstone_count_threshold;\n  size_t seed;\n  size_t slot_count_log2;\n  stbds_string_arena string;\n  t_hash_bucket *storage;\n} t_hash_index;\n\nstatic void dump_table(const char *tag, void *hash_ptr, size_t elemsize)\n{\n  char *raw = (char *) hash_ptr - elemsize;\n  stbds_array_header *h = (stbds_array_header *) raw - 1;\n  t_hash_index *t = (t_hash_index *) h->hash_table;\n  printf(\"[%s] arr len=%zu cap=%zu temp=%td\\n\", tag, h->length, h->capacity, h->temp);\n  if (!t) { printf(\"[%s] table=NULL\\n\", tag); return; }\n  printf(\"[%s] slots=%zu log2=%zu used=%zu thr=%zu shrink=%zu tomb=%zu tombthr=%zu seed=%016zx mode=%u block=%u remaining=%zu\\n\",\n         tag, t->slot_count, t->slot_count_log2, t->used_count, t->used_count_threshold,\n         t->used_count_shrink_threshold, t->tombstone_count, t->tombstone_count_threshold,\n         t->seed, (unsigned) t->string.mode, (unsigned) t->string.block, t->string.remaining);\n  for (size_t i = 0; i < (t->slot_count >> 3); ++i) {\n    printf(\"[%s]  bucket %zu:\", tag, i);\n    for (int j = 0; j < 8; ++j) printf(\" %016zx/%td\", t->storage[i].hash[j], t->storage[i].index[j]);\n    printf(\"\\n\");\n  }\n}\n\n/* ------------------------------------------------------------------ tests */\n\ntypedef struct { int key; int value; } imap;\ntypedef struct { char *key; char value; } smap;\ntypedef struct { long long key[2]; int value; } bmap;\ntypedef struct { char *key; int value; } strmap;\n\nstatic void test_strkey(void)\n{\n  printf(\"== strkey ==\\n\");\n  int ns[] = { 0, 1, -5, 12345, 999999, INT_MAX, INT_MIN };\n  for (unsigned i = 0; i < sizeof(ns)/sizeof(ns[0]); ++i) {\n    char *p = P_strkey(ns[i]);\n    printf(\"strkey(%d) = '%s' len=%zu\\n\", ns[i], p, strlen(p));\n  }\n  /* the returned pointer is a single static buffer */\n  char *a = P_strkey(7);\n  char *b = P_strkey(8);\n  printf(\"same buffer: %d, content '%s'\\n\", a == b, a);\n}\n\nstatic void test_helxo(void)\n{\n  printf(\"== helxo ==\\n\");\n  P_helxo('l');\n  P_helxo('a');\n  P_helxo('Z');\n  P_helxo('\\0');\n  P_helxo((char) 200);\n  fflush(stdout);\n}\n\nstatic void test_hash_string(void)\n{\n  printf(\"== hash_string ==\\n\");\n  static char *strs[] = { \"\", \"a\", \"ab\", \"abc\", \"abcdefgh\", \"abcdefghi\",\n                          \"the quick brown fox jumps over the lazy dog\",\n                          \"\\xff\\xfe\\x80\\x7f\", \"test_0\", \"test_100000\" };\n  size_t seeds[] = { 0, 1, 0x31415926u, (size_t) -1, 0x123456789abcdefull };\n  for (unsigned i = 0; i < sizeof(strs)/sizeof(strs[0]); ++i)\n    for (unsigned s = 0; s < sizeof(seeds)/sizeof(seeds[0]); ++s)\n      printf(\"hash_string(%u,%u) = %016zx\\n\", i, s, P_hash_string(strs[i], seeds[s]));\n}\n\nstatic void test_hash_bytes(void)\n{\n  printf(\"== hash_bytes ==\\n\");\n  unsigned char buf[64];\n  size_t seeds[] = { 0, 1, 0x31415926u, (size_t) -1 };\n  /* patterns that hit the signed-shift sign extension in the byte loader */\n  for (int pat = 0; pat < 5; ++pat) {\n    for (int i = 0; i < 64; ++i) {\n      switch (pat) {\n        case 0: buf[i] = (unsigned char) i; break;\n        case 1: buf[i] = 0xff; break;\n        case 2: buf[i] = (i % 4 == 3) ? 0x80 : 0x01; break;\n        case 3: buf[i] = (unsigned char) (i * 37 + 11); break;\n        default: buf[i] = 0; break;\n      }\n    }\n    for (size_t len = 0; len <= 40; ++len)\n      for (unsigned s = 0; s < sizeof(seeds)/sizeof(seeds[0]); ++s)\n        printf(\"hash_bytes(pat%d,len%zu,seed%u) = %016zx\\n\", pat, len, s, P_hash_bytes(buf, len, seeds[s]));\n  }\n}\n\nstatic void test_arrays(void)\n{\n  printf(\"== arrays ==\\n\");\n  int *a = NULL;\n  printf(\"len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n  for (int i = 0; i < 40; ++i) {\n    arrput(a, i * i);\n    printf(\"put %d -> len=%td cap=%zu last=%d\\n\", i, arrlen(a), arrcap(a), arrlast(a));\n  }\n  arrins(a, 3, 999);\n  arrins(a, 0, -1);\n  printf(\"after ins len=%td cap=%zu a[0]=%d a[4]=%d\\n\", arrlen(a), arrcap(a), a[0], a[4]);\n  arrdel(a, 1);\n  arrdeln(a, 5, 3);\n  arrdelswap(a, 2);\n  printf(\"after del len=%td cap=%zu:\", arrlen(a), arrcap(a));\n  for (int i = 0; i < arrlen(a); ++i) printf(\" %d\", a[i]);\n  printf(\"\\n\");\n  printf(\"pop=%d len=%td\\n\", arrpop(a), arrlen(a));\n  arrsetlen(a, 5);\n  printf(\"setlen 5 -> len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n  arrsetcap(a, 100);\n  printf(\"setcap 100 -> len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n  arrsetlen(a, 60);\n  printf(\"setlen 60 -> len=%td cap=%zu\\n\", arrlen(a), arrcap(a));\n  int *p = arraddnptr(a, 7);\n  printf(\"addnptr off=%td len=%td cap=%zu\\n\", (ptrdiff_t) (p - a), arrlen(a), arrcap(a));\n  ptrdiff_t idx = arraddnindex(a, 3);\n  printf(\"addnindex=%td len=%td cap=%zu\\n\", idx, arrlen(a), arrcap(a));\n  arrfree(a);\n  printf(\"after free ptr null=%d len=%td\\n\", a == NULL, arrlen(a));\n\n  /* arrgrowf / arrfreef used directly */\n  void *g = P_arrgrowf(NULL, 4, 0, 3);\n  stbds_array_header *h = (stbds_array_header *) g - 1;\n  printf(\"grow(NULL,4,0,3): len=%zu cap=%zu ht=%d temp=%td\\n\", h->length, h->capacity, h->hash_table == NULL, h->temp);\n  g = P_arrgrowf(g, 4, 5, 0);\n  h = (stbds_array_header *) g - 1;\n  printf(\"grow(+5): len=%zu cap=%zu\\n\", h->length, h->capacity);\n  g = P_arrgrowf(g, 4, 0, 2);\n  h = (stbds_array_header *) g - 1;\n  printf(\"grow(min2): len=%zu cap=%zu\\n\", h->length, h->capacity);\n  g = P_arrgrowf(g, 4, 0, 500);\n  h = (stbds_array_header *) g - 1;\n  printf(\"grow(min500): len=%zu cap=%zu\\n\", h->length, h->capacity);\n  P_arrfreef(g);\n}\n\nstatic void test_intmap(void)\n{\n  printf(\"== int map ==\\n\");\n  imap *h = NULL;\n  hmdefault(h, -7);\n  dump_table(\"imap-default\", h, sizeof *h);\n  for (int i = 0; i < 40; ++i) {\n    hmput(h, i * 7, i);\n  }\n  dump_table(\"imap-40\", h, sizeof *h);\n  printf(\"len=%td\\n\", hmlen(h));\n  for (int i = 0; i < 45; ++i)\n    printf(\"get %d -> %d (i=%td)\\n\", i * 7, hmget(h, i * 7), hmgeti(h, i * 7));\n  printf(\"missing -> %d\\n\", hmget(h, 123456));\n  printf(\"getp_null(999)=%d getp_null(14)=%d\\n\", hmgetp_null(h, 999) == NULL, hmgetp_null(h, 14) == NULL);\n  ptrdiff_t tmp;\n  printf(\"get_ts(21)=%d temp=%td\\n\", hmget_ts(h, 21, tmp), tmp);\n  for (int i = 0; i < 40; i += 3)\n    printf(\"del %d -> %d\\n\", i * 7, (int) hmdel(h, i * 7));\n  dump_table(\"imap-deleted\", h, sizeof *h);\n  printf(\"contents:\");\n  for (int i = 0; i < hmlen(h); ++i) printf(\" (%d,%d)\", h[i].key, h[i].value);\n  printf(\"\\n\");\n  for (int i = 0; i < 40; ++i)\n    printf(\"re-get %d -> %d (i=%td)\\n\", i * 7, hmget(h, i * 7), hmgeti(h, i * 7));\n  /* delete everything to trigger shrink paths */\n  for (int i = 0; i < 40; ++i) {\n    hmdel(h, i * 7);\n  }\n  dump_table(\"imap-empty\", h, sizeof *h);\n  printf(\"len now %td\\n\", hmlen(h));\n  hmfree(h);\n  printf(\"freed null=%d\\n\", h == NULL);\n}\n\nstatic void test_bigkeymap(void)\n{\n  printf(\"== 16-byte key map ==\\n\");\n  bmap *h = NULL;\n  for (int i = 0; i < 30; ++i) {\n    bmap e;\n    memset(&e, 0, sizeof e);\n    e.ke