ber_item, &global_hooks, false))\n2154\t    {\n2155\t        return number_item;\n2156\t    }\n2157\t\n2158\t    cJSON_Delete(number_item);\n2159\t    return NULL;\n2160\t}\n2161\t\n2162\tCJSON_PUBLIC(cJSON*) cJSON_AddStringToObject(cJSON * const object, const char * const name, const char * const string)\n2163\t{\n2164\t    cJSON *string_item = cJSON_CreateString(string);\n2165\t    if (add_item_to_object(object, name, string_item, &global_hooks, false))\n2166\t    {\n2167\t        return string_item;\n2168\t    }\n2169\t\n2170\t    cJSON_Delete(string_item);\n2171\t    return NULL;\n2172\t}\n2173\t\n2174\tCJSON_PUBLIC(cJSON*) cJSON_AddRawToObject(cJSON * const object, const char * const name, const char * const raw)\n2175\t{\n2176\t    cJSON *raw_item = cJSON_CreateRaw(raw);\n2177\t    if (add_item_to_object(object, name, raw_item, &global_hooks, false))\n2178\t    {\n2179\t        return raw_item;\n2180\t    }\n2181\t\n2182\t    cJSON_Delete(raw_item);\n2183\t    return NULL;\n2184\t}\n2185\t\n2186\tCJSON_PUBLIC(cJSON*) cJSON_AddObjectToObject(cJSON * const object, const char * const name)\n2187\t{\n2188\t    cJSON *object_item = cJSON_CreateObject();\n2189\t    if (add_item_to_object(object, name, object_item, &global_hooks, false))\n2190\t    {\n2191\t        return object_item;\n2192\t    }\n2193\t\n2194\t    cJSON_Delete(object_item);\n2195\t    return NULL;\n2196\t}\n2197\t\n2198\tCJSON_PUBLIC(cJSON*) cJSON_AddArrayToObject(cJSON * const object, const char * const name)\n2199\t{\n2200\t    cJSON *array = cJSON_CreateArray();\n2201\t    if (add_item_to_object(object, name, array, &global_hooks, false))\n2202\t    {\n2203\t        return array;\n2204\t    }\n2205\t\n2206\t    cJSON_Delete(array);\n2207\t    return NULL;\n2208\t}\n2209\t\n2210\tCJSON_PUBLIC(cJSON *) cJSON_DetachItemViaPointer(cJSON *parent, cJSON * const item)\n2211\t{\n2212\t    if ((parent == NULL) || (item == NULL) || (item != parent->child && item->prev == NULL))\n2213\t    {\n2214\t        return NULL;\n2215\t    }\n2216\t\n2217\t    if (item != parent->child)\n2218\t    {\n2219\t        /* not the first element */\n2220\t        item->prev->next = item->next;\n2221\t    }\n2222\t    if (item->next != NULL)\n2223\t    {\n2224\t        /* not the last element */\n2225\t        item->next->prev = item->prev;\n2226\t    }\n2227\t\n2228\t    if (item == parent->child)\n2229\t    {\n2230\t        /* first element */\n2231\t        parent->child = item->next;\n2232\t    }\n2233\t    else if (item->next == NULL)\n2234\t    {\n2235\t        /* last element */\n2236\t        parent->child->prev = item->prev;\n2237\t    }\n2238\t\n2239\t    /* make sure the detached item doesn't point anywhere anymore */\n2240\t    item->prev = NULL;\n2241\t    item->next = NULL;\n2242\t\n2243\t    return item;\n2244\t}\n2245\t\n2246\tCJSON_PUBLIC(cJSON *) cJSON_DetachItemFromArray(cJSON *array, int which)\n2247\t{\n2248\t    if (which < 0)\n2249\t    {\n2250\t        return NULL;\n2251\t    }\n2252\t\n2253\t    return cJSON_DetachItemViaPointer(array, get_array_item(array, (size_t)which));\n2254\t}\n2255\t\n2256\tCJSON_PUBLIC(void) cJSON_DeleteItemFromArray(cJSON *array, int which)\n2257\t{\n2258\t    cJSON_Delete(cJSON_DetachItemFromArray(array, which));\n2259\t}\n2260\t\n2261\tCJSON_PUBLIC(cJSON *) cJSON_DetachItemFromObject(cJSON *object, const char *string)\n2262\t{\n2263\t    cJSON *to_detach = cJSON_GetObjectItem(object, string);\n2264\t\n2265\t    return cJSON_DetachItemViaPointer(object, to_detach);\n2266\t}\n2267\t\n2268\tCJSON_PUBLIC(cJSON *) cJSON_DetachItemFromObjectCaseSensitive(cJSON *object, const char *string)\n2269\t{\n2270\t    cJSON *to_detach = cJSON_GetObjectItemCaseSensitive(object, string);\n2271\t\n2272\t    return cJSON_DetachItemViaPointer(object, to_detach);\n2273\t}\n2274\t\n2275\tCJSON_PUBLIC(void) cJSON_DeleteItemFromObject(cJSON *object, const char *string)\n2276\t{\n2277\t    cJSON_Delete(cJSON_DetachItemFromObject(object, string));\n2278\t}\n2279\t\n2280\tCJSON_PUBLIC(void) cJSON_DeleteItemFromObjectCaseSensitive(cJSON *object, const char *string)\n2281\t{\n2282\t    cJSON_Delete(cJSON_DetachItemFromObjectCaseSensitive(object, string));\n2283\t}\n2284\t\n2285\t/* Replace array/object items with new ones. */\n2286\tCJSON_PUBLIC(cJSON_bool) cJSON_InsertItemInArray(cJSON *array, int which, cJSON *newitem)\n2287\t{\n2288\t    cJSON *after_inserted = NULL;\n2289\t\n2290\t    if (which < 0 || newitem == NULL)\n2291\t    {\n2292\t        return false;\n2293\t    }\n2294\t\n2295\t    after_inserted = get_array_item(array, (size_t)which);\n2296\t    if (after_inserted == NULL)\n2297\t    {\n2298\t        return add_item_to_array(array, newitem);\n2299\t    }\n2300\t\n2301\t    if (after_inserted != array->child && after_inserted->prev == NULL) {\n2302\t        /* return false if after_inserted is a corrupted array item */\n2303\t        return false;\n2304\t    }\n2305\t\n2306\t    newitem->next = after_inserted;\n2307\t    newitem->prev = after_inserted->prev;\n2308\t    after_inserted->prev = newitem;\n2309\t    if (after_inserted == array->child)\n2310\t    {\n2311\t        array->child = newitem;\n2312\t    }\n2313\t    else\n2314\t    {\n2315\t        newitem->prev->next = newitem;\n2316\t    }\n2317\t    return true;\n2318\t}\n2319\t\n2320\tCJSON_PUBLIC(cJSON_bool) cJSON_ReplaceItemViaPointer(cJSON * const parent, cJSON * const item, cJSON * replacement)\n2321\t{\n2322\t    if ((parent == NULL) || (parent->child == NULL) || (replacement == NULL) || (item == NULL))\n2323\t    {\n2324\t        return false;\n2325\t    }\n2326\t\n2327\t    if (replacement == item)\n2328\t    {\n2329\t        return true;\n2330\t    }\n2331\t\n2332\t    replacement->next = item->next;\n2333\t    replacement->prev = item->prev;\n2334\t\n2335\t    if (replacement->next != NULL)\n2336\t    {\n2337\t        replacement->next->prev = replacement;\n2338\t    }\n2339\t    if (parent->child == item)\n2340\t    {\n2341\t        if (parent->child->prev == parent->child)\n2342\t        {\n2343\t            replacement->prev = replacement;\n2344\t        }\n2345\t        parent->child = replacement;\n2346\t    }\n2347\t    else\n2348\t    {   /*\n2349\t         * To find the last item in array quickly, we use prev in array.\n2350\t         * We can't modify the last item's next pointer where this item was the parent's child\n2351\t         */\n2352\t        if (replacement->prev != NULL)\n2353\t        {\n2354\t            replacement->prev->next = replacement;\n2355\t        }\n2356\t        if (replacement->next == NULL)\n2357\t        {\n2358\t            parent->child->prev = replacement;\n2359\t        }\n2360\t    }\n2361\t\n2362\t    item->next = NULL;\n2363\t    item->prev = NULL;\n2364\t    cJSON_Delete(item);\n2365\t\n2366\t    return true;\n2367\t}\n2368\t\n2369\tCJSON_PUBLIC(cJSON_bool) cJSON_ReplaceItemInArray(cJSON *array, int which, cJSON *newitem)\n2370\t{\n2371\t    if (which < 0)\n2372\t    {\n2373\t        return false;\n2374\t    }\n2375\t\n2376\t    return cJSON_ReplaceItemViaPointer(array, get_array_item(array, (size_t)which), newitem);\n2377\t}\n2378\t\n2379\tstatic cJSON_bool replace_item_in_object(cJSON *object, const char *string, cJSON *replacement, cJSON_bool case_sensitive)\n2380\t{\n2381\t    if ((replacement == NULL) || (string == NULL))\n2382\t    {\n2383\t        return false;\n2384\t    }\n2385\t\n2386\t    /* replace the name in the replacement */\n2387\t    if (!(replacement->type & cJSON_StringIsConst) && (replacement->string != NULL))\n2388\t    {\n2389\t        cJSON_free(replacement->string);\n2390\t    }\n2391\t    replacement->string = (char*)cJSON_strdup((const unsigned char*)string, &global_hooks);\n2392\t    if (replacement->string == NULL)\n2393\t    {\n2394\t        return false;\n2395\t    }\n2396\t\n2397\t    replacement->type &= ~cJSON_StringIsConst;\n2398\t\n2399\t    return cJSON_ReplaceItemViaPointer(object, get_object_item(object, string, case_sensitive), replacement);\n2400\t}\n2401\t\n2402\tCJSON_PUBLIC(cJSON_bool) cJSON_ReplaceItemInObject(cJSON *object, const char *string, cJSON *newitem)\n2403\t{\n2404\t    return replace_item_in_object(object, string, newitem, false);\n2405\t}\n2406\t\n2407\tCJSON_PUBLIC(cJSON_bool) cJSON_ReplaceItemInObjectCaseSensitive(cJSON *object, const char *string, cJSON *newitem)\n2408\t{\n2409\t    return replace_item_in_object(object, string, newitem, true);\n2410\t}\n2411\t\n2412\t/* Create basic types: */\n2413\tCJSON_PUBLIC(cJSON *) cJSON_CreateNull(void)\n2414\t{\n2415\t    cJSON *item = cJSON_New_Item(&global_hooks);\n2416\t    if(item)\n2417\t    {\n2418\t        item->type = cJSON_NULL;\n2419\t    }\n2420\t\n2421\t    return item;\n2422\t}\n2423\t\n2424\tCJSON_PUBLIC(cJSON *) cJSON_CreateTrue(void)\n2425\t{\n2426\t    cJSON *item = cJSON_New_Item(&global_hooks);\n2427\t    if(item)\n2428\t    {\n2429\t        item->type = cJSON_True;\n2430\t    }\n2431\t\n2432\t    return item;\n2433\t}\n2434\t\n2435\tCJSON_PUBLIC(cJSON *) cJSON_CreateFalse(void)\n2436\t{\n2437\t    cJSON *item = cJSON_New_Item(&global_hooks);\n2438\t    if(item)\n2439\t    {\n2440\t        item->type = cJSON_False;\n2441\t    }\n2442\t\n2443\t    return item;\n2444\t}\n2445\t\n2446\tCJSON_PUBLIC(cJSON *) cJSON_CreateBool(cJSON_bool boolean)\n2447\t{\n2448\t    cJSON *item = cJSON_New_Item(&global_hooks);\n2449\t    if(item)\n2450\t    {\n2451\t        item->type = boolean ? cJSON_True : cJSON_False;\n2452\t    }\n2453\t\n2454\t    return item;\n2455\t}\n2456\t\n2457\tCJSON_PUBLIC(cJSON *) cJSON_CreateNumber(double num)\n2458\t{\n2459\t    cJSON *item = cJSON_New_Item(&global_hooks);\n2460\t    if(item)\n2461\t    {\n2462\t        item->type = cJSON_Number;\n2463\t        item->valuedouble = num;\n2464\t\n2465\t        /* use saturation in case of overflow */\n2466\t        if (num >= INT_MAX)\n2467\t        {\n2468\t            item->valueint = INT_MAX;\n2469\t        }\n2470\t        else if (num <= (double)INT_MIN)\n2471\t        {\n2472\t            item->valueint = INT_MIN;\n2473\t        }\n2474\t        else\n2475\t        {\n2476\t            item->valueint = (int)num;\n2477\t        }\n2478\t    }\n2479\t\n2480\t    return item;\n2481\t}\n2482\t\n2483\tCJSON_PUBLIC(cJSON *) cJSON_CreateString(const char *string)\n2484\t{\n2485\t    cJSON *item = cJSON_New_Item(&global_hooks);\n2486\t    if(item)\n2487\t    {\n2488\t        item->type = cJSON_String;\n2489\t        item->valuestring = (char*)cJSON_strdup((const unsigned char*)string, &global_hooks);\n2490\t        if(!item->valuestring)\n2491\t        {\n2492\t            cJSON_Delete(item);\n2493\t            return NULL;\n2494\t        }\n2495\t    }\n2496\t\n2497\t    return item;\n2498\t}\n2499\t\n2500\tCJSON_PUBLIC(cJSON *) cJSON_CreateStringReference(const char *string)\n2501\t{\n2502\t    cJSON *item = cJSON_New_Item(&global_hooks);\n2503\t    if (item != NULL)\n2504\t    {\n2505\t        item->type = cJSON_String | cJSON_IsReference;\n2506\t        item->valuestring = (char*)cast_away_const(string);\n2507\t    }\n2508\t\n2509\t    return item;\n2510\t}\n2511\t\n2512\tCJSON_PUBLIC(cJSON *) cJSON_CreateObjectReference(const cJSON *child)\n2513\t{\n2514\t    cJSON *item = cJSON_New_Item(&global_hooks);\n2515\t    if (item != NULL) {\n2516\t        item->type = cJSON_Object | cJSON_IsReference;\n2517\t        item->child = (cJSON*)cast_away_const(child);\n2518\t    }\n2519\t\n2520\t    return item;\n2521\t}\n2522\t\n2523\tCJSON_PUBLIC(cJSON *) cJSON_CreateArrayReference(const cJSON *child) {\n2524\t    cJSON *item = cJSON_New_Item(&global_hooks);\n2525\t    if (item != NULL) {\n2526\t        item->type = cJSON_Array | cJSON_IsReference;\n2527\t        item->child = (cJSON*)cast_away_const(child);\n2528\t    }\n2529\t\n2530\t    return item;\n2531\t}\n2532\t\n2533\tCJSON_PUBLIC(cJSON *) cJSON_CreateRaw(const char *raw)\n2534\t{\n2535\t    cJSON *item = cJSON_New_Item(&global_hooks);\n2536\t    if(item)\n2537\t    {\n2538\t        item->type = cJSON_Raw;\n2539\t        item->valuestring = (char*)cJSON_strdup((const unsigned char*)raw, &global_hooks);\n2540\t        if(!item->valuestring)\n2541\t        {\n2542\t            cJSON_Delete(item);\n2543\t            return NULL;\n2544\t        }\n2545\t    }\n2546\t\n2547\t    return item;\n2548\t}\n2549\t\n2550\tCJSON_PUBLIC(cJSON *) cJSON_CreateArray(void)\n2551\t{\n2552\t    cJSON *item = cJSON_New_Item(&global_hooks);\n2553\t    if(item)\n2554\t    {\n2555\t        item->type=cJSON_Array;\n2556\t    }\n2557\t\n2558\t    return item;\n2559\t}\n2560\t\n2561\tCJSON_PUBLIC(cJSON *) cJSON_CreateObject(void)\n2562\t{\n2563\t    cJSON *item = cJSON_New_Item(&global_hooks);\n2564\t    if (item)\n2565\t    {\n2566\t        item->type = cJSON_Object;\n2567\t    }\n2568\t\n2569\t    return item;\n2570\t}\n2571\t\n2572\t/* Create Arrays: */\n2573\tCJSON_PUBLIC(cJSON *) cJSON_CreateIntArray(const int *numbers, int count)\n2574\t{\n2575\t    size_t i = 0;\n2576\t    cJSON *n = NULL;\n2577\t    cJSON *p = NULL;\n2578\t    cJSON *a = NULL;\n2579\t\n2580\t    if ((count < 0) || (numbers == NULL))\n2581\t    {\n2582\t        return NULL;\n2583\t    }\n2584\t\n2585\t    a = cJSON_CreateArray();\n2586\t\n2587\t    for(i = 0; a && (i < (size_t)count); i++)\n2588\t    {\n2589\t        n = cJSON_CreateNumber(numbers[i]);\n2590\t        if (!n)\n2591\t        {\n2592\t            cJSON_Delete(a);\n2593\t            return NULL;\n2594\t        }\n2595\t        if(!i)\n2596\t        {\n2597\t            a->child = n;\n2598\t        }\n2599\t        else\n2600\t        {\n2601\t            suffix_object(p, n);\n2602\t        }\n2603\t        p = n;\n2604\t    }\n2605\t\n2606\t    if (a && a->child) {\n2607\t        a->child->prev = n;\n2608\t    }\n2609\t\n2610\t    return a;\n2611\t}\n2612\t\n2613\tCJSON_PUBLIC(cJSON *) cJSON_CreateFloatArray(const float *numbers, int count)\n2614\t{\n2615\t    size_t i = 0;\n2616\t    cJSON *n = NULL;\n2617\t    cJSON *p = NULL;\n2618\t    cJSON *a = NULL;\n2619\t\n2620\t    if ((count < 0) || (numbers == NULL))\n2621\t    {\n2622\t        return NULL;\n2623\t    }\n2624\t\n2625\t    a = cJSON_CreateArray();\n2626\t\n2627\t    for(i = 0; a && (i < (size_t)count); i++)\n2628\t    {\n2629\t        n = cJSON_CreateNumber((double)numbers[i]);\n2630\t        if(!n)\n2631\t        {\n2632\t            cJSON_Delete(a);\n2633\t            return NULL;\n2634\t        }\n2635\t        if(!i)\n2636\t        {\n2637\t            a->child = n;\n2638\t        }\n2639\t        else\n2640\t        {\n2641\t            suffix_object(p, n);\n2642\t        }\n2643\t        p = n;\n2644\t    }\n2645\t\n2646\t    if (a && a->child) {\n2647\t        a->child->prev = n;\n2648\t    }\n2649\t\n2650\t    return a;\n2651\t}\n2652\t\n2653\tCJSON_PUBLIC(cJSON *) cJSON_CreateDoubleArray(const double *numbers, int count)\n2654\t{\n2655\t    size_t i = 0;\n2656\t    cJSON *n = NULL;\n2657\t    cJSON *p = NULL;\n2658\t    cJSON *a = NULL;\n2659\t\n2660\t    if ((count < 0) || (numbers == NULL))\n2661\t    {\n2662\t        return NULL;\n2663\t    }\n2664\t\n2665\t    a = cJSON_CreateArray();\n2666\t\n2667\t    for(i = 0; a && (i < (size_t)count); i++)\n2668\t    {\n2669\t        n = cJSON_CreateNumber(numbers[i]);\n2670\t        if(!n)\n2671\t        {\n2672\t            cJSON_Delete(a);\n2673\t            return NULL;\n2674\t        }\n2675\t        if(!i)\n2676\t        {\n2677\t            a->child = n;\n2678\t        }\n2679\t        else\n2680\t        {\n2681\t            suffix_object(p, n);\n2682\t        }\n2683\t        p = n;\n2684\t    }\n2685\t\n2686\t    if (a && a->child) {\n2687\t        a->child->prev = n;\n2688\t    }\n2689\t\n2690\t    return a;\n2691\t}\n2692\t\n2693\tCJSON_PUBLIC(cJSON *) cJSON_CreateStringArray(const char *const *strings, int count)\n2694\t{\n2695\t    size_t i = 0;\n2696\t    cJSON *n = NULL;\n2697\t    cJSON *p = NULL;\n2698\t    cJSON *a = NULL;\n2699\t\n2700\t    if ((count < 0) || (strings == NULL))\n2701\t    {\n2702\t        return NULL;\n2703\t    }\n2704\t\n2705\t    a = cJSON_CreateArray();\n2706\t\n2707\t    for (i = 0; a && (i < (size_t)count); i++)\n2708\t    {\n2709\t        n = cJSON_CreateString(strings[i]);\n2710\t        if(!n)\n2711\t        {\n2712\t            cJSON_Delete(a);\n2713\t            return NULL;\n2714\t        }\n2715\t        if(!i)\n2716\t        {\n2717\t            a->child = n;\n2718\t        }\n2719\t        else\n2720\t        {\n2721\t            suffix_object(p,n);\n2722\t        }\n2723\t        p = n;\n2724\t    }\n2725\t\n2726\t    if (a && a->child) {\n2727\t        a->child->prev = n;\n2728\t    }\n2729\t\n2730\t    return a;\n2731\t}\n2732\t\n2733\t/* Duplication */\n2734\tcJSON * cJSON_Duplicate_rec(const cJSON *item, size_t depth, cJSON_bool recurse);\n2735\t\n2736\tCJSON_PUBLIC(cJSON *) cJSON_Duplicate(const cJSON *item, cJSON_bool recurse)\n2737\t{\n2738\t    return cJSON_Duplicate_rec(item, 0, recurse );\n2739\t}\n2740\t\n2741\tcJSON * cJSON_Duplicate_rec(const cJSON *item, size_t depth, cJSON_bool recurse)\n2742\t{\n2743\t    cJSON *newitem = NULL;\n2744\t    cJSON *child = NULL;\n2745\t    cJSON *next = NULL;\n2746\t    cJSON *newchild = NULL;\n2747\t\n2748\t    /* Bail on bad ptr */\n2749\t    if (!item)\n2750\t    {\n2751\t        goto fail;\n2752\t    }\n2753\t    /* Create new item */\n2754\t    newitem = cJSON_New_Item(&global_hooks);\n2755\t    if (!newitem)\n2756\t    {\n2757\t        goto fail;\n2758\t    }\n2759\t    /* Copy over all vars */\n2760\t    newitem->type = item->type & (~cJSON_IsReference);\n2761\t    newitem->valueint = item->valueint;\n2762\t    newitem->valuedouble = item->valuedouble;\n2763\t    if (item->valuestring)\n2764\t    {\n2765\t        newitem->valuestring = (char*)cJSON_strdup((unsigned char*)item->valuestring, &global_hooks);\n2766\t        if (!newitem->valuestring)\n2767\t        {\n2768\t            goto fail;\n2769\t        }\n2770\t    }\n2771\t    if (item->string)\n2772\t    {\n2773\t        newitem->string = (item->type&cJSON_StringIsConst) ? item->string : (char*)cJSON_strdup((unsigned char*)item->string, &global_hooks);\n2774\t        if (!newitem->string)\n2775\t        {\n2776\t            goto fail;\n2777\t        }\n2778\t    }\n2779\t    /* If non-recursive, then we're done! */\n2780\t    if (!recurse)\n2781\t    {\n2782\t        return newitem;\n2783\t    }\n2784\t    /* Walk the ->next chain for the child. */\n2785\t    child = item->child;\n2786\t    while (child != NULL)\n2787\t    {\n2788\t        if(depth >= CJSON_CIRCULAR_LIMIT) {\n2789\t            goto fail;\n2790\t        }\n2791\t        newchild = cJSON_Duplicate_rec(child, depth + 1, true); /* Duplicate (with recurse) each item in the ->next chain */\n2792\t        if (!newchild)\n2793\t        {\n2794\t            goto fail;\n2795\t        }\n2796\t        if (next != NULL)\n2797\t        {\n2798\t            /* If newitem->child already set, then crosswire ->prev and ->next and move on */\n2799\t            next->next = newchild;\n2800\t            newchild->prev = next;\n2801\t            next = newchild;\n2802\t        }\n2803\t        else\n2804\t        {\n2805\t            /* Set newitem->child and move to it */\n2806\t            newitem->child = newchild;\n2807\t            next = newchild;\n2808\t        }\n2809\t        child = child->next;\n2810\t    }\n2811\t    if (newitem && newitem->child)\n2812\t    {\n2813\t        newitem->child->prev = newchild;\n2814\t    }\n2815\t\n2816\t    return newitem;\n2817\t\n2818\tfail:\n2819\t    if (newitem != NULL)\n2820\t    {\n2821\t        cJSON_Delete(newitem);\n2822\t    }\n2823\t\n2824\t    return NULL;\n2825\t}\n2826\t\n2827\tstatic void skip_oneline_comment(char **input)\n2828\t{\n2829\t    *input += static_strlen(\"//\");\n2830\t\n2831\t    for (; (*input)[0] != '\\0'; ++(*input))\n2832\t    {\n2833\t        if ((*input)[0] == '\\n') {\n2834\t            *input += static_strlen(\"\\n\");\n2835\t            return;\n2836\t        }\n2837\t    }\n2838\t}\n2839\t\n2840\tstatic void skip_multiline_comment(char **input)\n2841\t{\n2842\t    *input += static_strlen(\"/*\");\n2843\t\n2844\t    for (; (*input)[0] != '\\0'; ++(*input))\n2845\t    {\n2846\t        if (((*input)[0] == '*') && ((*input)[1] == '/'))\n2847\t        {\n2848\t            *input += static_strlen(\"*/\");\n2849\t            return;\n2850\t        }\n2851\t    }\n2852\t}\n2853\t\n2854\tstatic void minify_string(char **input, char **output) {\n2855\t    (*output)[0] = (*input)[0];\n2856\t    *input += static_strlen(\"\\\"\");\n2857\t    *output += static_strlen(\"\\\"\");\n2858\t\n2859\t\n2860\t    for (; (*input)[0] != '\\0'; (void)++(*input), ++(*output)) {\n2861\t        (*output)[0] = (*input)[0];\n2862\t\n2863\t        if ((*input)[0] == '\\\"') {\n2864\t            (*output)[0] = '\\\"';\n2865\t            *input += static_strlen(\"\\\"\");\n2866\t            *output += static_strlen(\"\\\"\");\n2867\t            return;\n2868\t        } else if (((*input)[0] == '\\\\') && ((*input)[1] == '\\\"')) {\n2869\t            (*output)[1] = (*input)[1];\n2870\t            *input += static_strlen(\"\\\"\");\n2871\t            *output += static_strlen(\"\\\"\");\n2872\t        }\n2873\t    }\n2874\t}\n2875\t\n2876\tCJSON_PUBLIC(void) cJSON_Minify(char *json)\n2877\t{\n2878\t    char *into = json;\n2879\t\n2880\t    if (json == NULL)\n2881\t    {\n2882\t        return;\n2883\t    }\n2884\t\n2885\t    while (json[0] != '\\0')\n2886\t    {\n2887\t        switch (json[0])\n2888\t        {\n2889\t            case ' ':\n2890\t            case '\\t':\n2891\t            case '\\r':\n2892\t            case '\\n':\n2893\t                json++;\n2894\t                break;\n2895\t\n2896\t            case '/':\n2897\t                if (json[1] == '/')\n2898\t                {\n2899\t                    skip_oneline_comment(&json);\n2900\t                }\n2901\t     