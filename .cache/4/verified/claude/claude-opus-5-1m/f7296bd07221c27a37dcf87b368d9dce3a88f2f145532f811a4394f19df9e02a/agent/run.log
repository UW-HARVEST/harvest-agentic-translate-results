ect).valuestring = copy;\n493\t\n494\t    copy\n495\t}\n496\t\n497\t/* ------------------------------------------------------------------------- */\n498\t/* print buffer                                                              */\n499\t/* ------------------------------------------------------------------------- */\n500\t\n501\tstruct printbuffer {\n502\t    buffer: *mut c_uchar,\n503\t    length: usize,\n504\t    offset: usize,\n505\t    depth: usize,\n506\t    noalloc: cJSON_bool,\n507\t    format: cJSON_bool,\n508\t    hooks: internal_hooks,\n509\t}\n510\t\n511\tconst EMPTY_PRINTBUFFER: printbuffer = printbuffer {\n512\t    buffer: null_mut(),\n513\t    length: 0,\n514\t    offset: 0,\n515\t    depth: 0,\n516\t    noalloc: 0,\n517\t    format: 0,\n518\t    hooks: NULL_HOOKS,\n519\t};\n520\t\n521\t/* realloc printbuffer if necessary to have at least \"needed\" bytes more */\n522\tunsafe fn ensure(p: *mut printbuffer, mut needed: usize) -> *mut c_uchar {\n523\t    let newbuffer: *mut c_uchar;\n524\t    let newsize: usize;\n525\t\n526\t    if p.is_null() || (*p).buffer.is_null() {\n527\t        return null_mut();\n528\t    }\n529\t\n530\t    if ((*p).length > 0) && ((*p).offset >= (*p).length) {\n531\t        /* make sure that offset is valid */\n532\t        return null_mut();\n533\t    }\n534\t\n535\t    if needed > c_int::MAX as usize {\n536\t        /* sizes bigger than INT_MAX are currently not supported */\n537\t        return null_mut();\n538\t    }\n539\t\n540\t    needed = needed.wrapping_add((*p).offset).wrapping_add(1);\n541\t    if needed <= (*p).length {\n542\t        return (*p).buffer.wrapping_add((*p).offset);\n543\t    }\n544\t\n545\t    if (*p).noalloc != FALSE {\n546\t        return null_mut();\n547\t    }\n548\t\n549\t    /* calculate new buffer size */\n550\t    if needed > (c_int::MAX as usize / 2) {\n551\t        /* overflow of int, use INT_MAX if possible */\n552\t        if needed <= c_int::MAX as usize {\n553\t            newsize = c_int