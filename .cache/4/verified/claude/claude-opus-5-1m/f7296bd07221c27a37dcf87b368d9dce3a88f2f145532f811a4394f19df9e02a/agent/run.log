{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_017Q7B5LLDBjN78UJ8qPZ4sY","type":"tool_result","content":"1\t//! Translation of `c_src/test.c`.\n2\t//!\n3\t//! Exports the `driver` symbol (the C source declares it as\n4\t//! `int CJSON_CDECL CJSON_PUBLIC(driver)(...)`, which expands to the plain\n5\t//! linker name `driver`).\n6\t\n7\tuse core::ffi::{c_char, c_int, c_void};\n8\tuse core::ptr::null_mut;\n9\t\n10\tuse crate::ffi::*;\n11\tuse crate::*;\n12\t\n13\t/* Used by some code below as an example datatype. */\n14\t#[repr(C)]\n15\tpub struct record {\n16\t    pub precision: *const c_char,\n17\t    pub lat: f64,\n18\t    pub lon: f64,\n19\t    pub address: *const c_char,\n20\t    pub city: *const c_char,\n21\t    pub state: *const c_char,\n22\t    pub zip: *const c_char,\n23\t    pub country: *const c_char,\n24\t}\n25\t\n26\t/* Create a bunch of objects as demonstration. */\n27\tunsafe fn print_preallocated(root: *mut cJSON) -> c_int {\n28\t    /* declarations */\n29\t    let out: *mut c_char;\n30\t    let buf: *mut c_char;\n31\t    let buf_fail: *mut c_char;\n32\t    let len: usize;\n33\t    let len_fail: usize;\n34\t\n35\t    /* formatted print */\n36\t    out = cJSON_Print(root);\n37\t\n38\t    /* create buffer to succeed */\n39\t    /* the extra 5 bytes are because of inaccuracies when reserving memory */\n40\t    len = strlen(out) + 5;\n41\t    buf = malloc(len) as *mut c_char;\n42\t    if buf.is_null() {\n43\t        printf(c\"Failed to allocate memory.\\n\".as_ptr());\n44\t        exit(1);\n45\t    }\n46\t\n47\t    /* create buffer to fail */\n48\t    len_fail = strlen(out);\n49\t    buf_fail = malloc(len_fail) as *mut c_char;\n50\t    if buf_fail.is_null() {\n51\t        printf(c\"Failed to allocate memory.\\n\".as_ptr());\n52\t        exit(1);\n53\t    }\n54\t\n55\t    /* Print to buffer */\n56\t    if cJSON_PrintPreallocated(root, buf, len as c_int, 1) == 0 {\n57\t        printf(c\"cJSON_PrintPreallocated failed!\\n\".as_ptr());\n58\t        if strcmp(out, buf) != 0 {\n59\t            printf(c\"cJSON_PrintPreallocated not the same as cJSON_Print!\\n\".as_ptr());\n60\t            printf(c\"cJSON_Print result:\\n%s\\n\".as_ptr(), out);\n61\t            printf(c\"cJSON_PrintPreallocated result:\\n%s\\n\".as_ptr(), buf);\n62\t        }\n63\t        free(out as *mut c_void);\n64\t        free(buf_fail as *mut c_void);\n65\t        free(buf as *mut c_void);\n66\t        return -1;\n67\t    }\n68\t\n69\t    /* success */\n70\t    printf(c\"%s\\n\".as_ptr(), buf);\n71\t\n72\t    /* force it to fail */\n73\t    if cJSON_PrintPreallocated(root, buf_fail, len_fail as c_int, 1) != 0 {\n74\t        printf(c\"cJSON_PrintPreallocated failed to show error with insufficient memory!\\n\".as_ptr());\n75\t        printf(c\"cJSON_Print result:\\n%s\\n\".as_ptr(), out);\n76\t        printf(c\"cJSON_PrintPreallocated result:\\n%s\\n\".as_ptr(), buf_fail);\n77\t        free(out as *mut c_void);\n78\t        free(buf_fail as *mut c_void);\n79\t        free(buf as *mut c_void);\n80\t        return -1;\n81\t    }\n82\t\n83\t    free(out as *mut c_void);\n84\t    free(buf_fail as *mut c_void);\n85\t    free(buf as *mut c_void);\n86\t    0\n87\t}\n88\t\n89\t/* Create a bunch of objects as demonstration. */\n90\tunsafe fn create_objects(\n91\t    strings: *const *const c_char,\n92\t    numbers: *const [c_int; 3],\n93\t    ids: *const c_int,\n94\t    fields: *const record,\n95\t) {\n96\t    /* declare a few. */\n97\t    let mut root: *mut cJSON;\n98\t    let fmt: *mut cJSON;\n99\t    let img: *mut cJSON;\n100\t    let thm: *mut cJSON;\n101\t    let mut fld: *mut cJSON;\n102\t    let mut i: c_int;\n103\t\n104\t    let zero: f64 = 0.0;\n105\t\n106\t    /* Here we construct some JSON standards, from the JSON site. */\n107\t\n108\t    /* Our \"Video\" datatype: */\n109\t    root = cJSON_CreateObject();\n110\t    cJSON_AddItemToObject(\n111\t        root,\n112\t        c\"name\".as_ptr(),\n113\t        cJSON_CreateString(c\"Jack (\\\"Bee\\\") Nimble\".as_ptr()),\n114\t    );\n115\t    fmt = cJSON_CreateObject();\n116\t    cJSON_AddItemToObject(root, c\"format\".as_ptr(), fmt);\n117\t    cJSON_AddStringToObject(fmt, c\"type\".as_ptr(), c\"rect\".as_ptr());\n118\t    cJSON_AddNumberToObject(fmt, c\"width\".as_ptr(), 1920.0);\n119\t    cJSON_AddNumberToObject(fmt, c\"height\".as_ptr(), 1080.0);\n120\t    cJSON_AddFalseToObject(fmt, c\"interlace\".as_ptr());\n121\t    cJSON_AddNumberToObject(fmt, c\"frame rate\".as_ptr(), 24.0);\n122\t\n123\t    /* Print to text */\n124\t    if print_preallocated(root) != 0 {\n125\t        cJSON_Delete(root);\n126\t        exit(1);\n127\t    }\n128\t    cJSON_Delete(root);\n129\t\n130\t    /* Our \"days of the week\" array: */\n131\t    root = cJSON_CreateStringArray(strings, 7);\n132\t\n133\t    if print_preallocated(root) != 0 {\n134\t        cJSON_Delete(root);\n135\t        exit(1);\n136\t    }\n137\t    cJSON_Delete(root);\n138\t\n139\t    /* Our matrix: */\n140\t    root = cJSON_CreateArray();\n141\t    i = 0;\n142\t    while i < 3 {\n143\t        cJSON_AddItemToArray(\n144\t            root,\n145\t            cJSON_CreateIntArray((*numbers.offset(i as isize)).as_ptr(), 3),\n146\t        );\n147\t        i += 1;\n148\t    }\n149\t\n150\t    /* cJSON_ReplaceItemInArray(root, 1, cJSON_CreateString(\"Replacement\")); */\n151\t\n152\t    if print_preallocated(root) != 0 {\n153\t        cJSON_Delete(root);\n154\t        exit(1);\n155\t    }\n156\t    cJSON_Delete(root);\n157\t\n158\t    /* Our \"gallery\" item: */\n159\t    root = cJSON_CreateObject();\n160\t    img = cJSON_CreateObject();\n161\t    cJSON_AddItemToObject(root, c\"Image\".as_ptr(), img);\n162\t    cJSON_AddNumberToObject(img, c\"Width\".as_ptr(), 800.0);\n163\t    cJSON_AddNumberToObject(img, c\"Height\".as_ptr(), 600.0);\n164\t    cJSON_AddStringToObject(img, c\"Title\".as_ptr(), c\"View from 15th Floor\".as_ptr());\n165\t    thm = cJSON_CreateObject();\n166\t    cJSON_AddItemToObject(img, c\"Thumbnail\".as_ptr(), thm);\n167\t    cJSON_AddStringToObject(\n168\t        thm,\n169\t        c\"Url\".as_ptr(),\n170\t        c\"http:/*www.example.com/image/481989943\".as_ptr(),\n171\t    );\n172\t    cJSON_AddNumberToObject(thm, c\"Height\".as_ptr(), 125.0);\n173\t    cJSON_AddStringToObject(thm, c\"Width\".as_ptr(), c\"100\".as_ptr());\n174\t    cJSON_AddItemToObject(img, c\"IDs\".as_ptr(), cJSON_CreateIntArray(ids, 4));\n175\t\n176\t    if print_preallocated(root) != 0 {\n177\t        cJSON_Delete(root);\n178\t        exit(1);\n179\t    }\n180\t    cJSON_Delete(root);\n181\t\n182\t    /* Our array of \"records\": */\n183\t    root = cJSON_CreateArray();\n184\t    i = 0;\n185\t    while i < 2 {\n186\t        let f = fields.offset(i as isize);\n187\t        fld = cJSON_CreateObject();\n188\t        cJSON_AddItemToArray(root, fld);\n189\t        cJSON_AddStringToObject(fld, c\"precision\".as_ptr(), (*f).precision);\n190\t        cJSON_AddNumberToObject(fld, c\"Latitude\".as_ptr(), (*f).lat);\n191\t        cJSON_AddNumberToObject(fld, c\"Longitude\".as_ptr(), (*f).lon);\n192\t        cJSON_AddStringToObject(fld, c\"Address\".as_ptr(), (*f).address);\n193\t        cJSON_AddStringToObject(fld, c\"City\".as_ptr(), (*f).city);\n194\t        cJSON_AddStringToObject(fld, c\"State\".as_ptr(), (*f).state);\n195\t        cJSON_AddStringToObject(fld, c\"Zip\".as_ptr(), (*f).zip);\n196\t        cJSON_AddStringToObject(fld, c\"Country\".as_ptr(), (*f).country);\n197\t        i += 1;\n198\t    }\n199\t\n200\t    /* cJSON_ReplaceItemInObject(cJSON_GetArrayItem(root, 1), \"City\", cJSON_CreateIntArray(ids, 4)); */\n201\t\n202\t    if print_preallocated(root) != 0 {\n203\t        cJSON_Delete(root);\n204\t        exit(1);\n205\t    }\n206\t    cJSON_Delete(root);\n207\t\n208\t    root = cJSON_CreateObject();\n209\t    let volatile_zero = core::ptr::read_volatile(&zero as *const f64);\n210\t    cJSON_AddNumberToObject(root, c\"number\".as_ptr(), 1.0 / volatile_zero);\n211\t\n212\t    if print_preallocated(root) != 0 {\n213\t        cJSON_Delete(root);\n214\t        exit(1);\n215\t    }\n216\t    cJSON_Delete(root);\n217\t\n218\t    let _ = null_mut::<cJSON>();\n219\t}\n220\t\n221\t#[unsafe(no_mangle)]\n222\tpub unsafe extern \"C\" fn driver(\n223\t    strings: *const *const c_char,\n224\t    numbers: *const [c_int; 3],\n225\t    ids: *const c_int,\n226\t    fields: *const record,\n227\t) -> c_int {\n228\t    /* print the version */\n229\t    printf(c\"Version: %s\\n\".as_ptr(), cJSON_Version());\n230\t\n231\t    /* Now some samplecode for building objects concisely: */\n232\t    create_objects(strings, numbers, ids, fields);\n233\t\n234\t    0\n235\t}\n236\t"}]},"parent_tool_use_id":"toolu_bdrk_013AcLyvrPJ6FtmffU4vbBrs","session_id":"99d8c152-90eb-46f7-8482-a09fedc8e20a","uuid":"be9e520f-3242-4d59-b090-f10546ae1f13","timestamp":"2026-08-20T07:19:09.601Z","subagent_type":"general-purpose","task_description":"Review C vs Rust part 2"}
