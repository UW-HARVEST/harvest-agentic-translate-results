e_sensitive)\n1914\t    {\n1915\t        while ((current_element != NULL) && (current_element->string != NULL) && (strcmp(name, current_element->string) != 0))\n1916\t        {\n1917\t            current_element = current_element->next;\n1918\t        }\n1919\t    }\n1920\t    else\n1921\t    {\n1922\t        while ((current_element != NULL) && (case_insensitive_strcmp((const unsigned char*)name, (const unsigned char*)(current_element->string)) != 0))\n1923\t        {\n1924\t            current_element = current_element->next;\n1925\t        }\n1926\t    }\n1927\t\n1928\t    if ((current_element == NULL) || (current_element->string == NULL)) {\n1929\t        return NULL;\n1930\t    }\n1931\t\n1932\t    return current_element;\n1933\t}\n1934\t\n1935\tCJSON_PUBLIC(cJSON *) cJSON_GetObjectItem(const cJSON * const object, const char * const string)\n1936\t{\n1937\t    return get_object_item(object, string, false);\n1938\t}\n1939\t\n1940\tCJSON_PUBLIC(cJSON *) cJSON_GetObjectItemCaseSensitive(const cJSON * const object, const char * const string)\n1941\t{\n1942\t    return get_object_item(object, string, true);\n1943\t}\n1944\t\n1945\tCJSON_PUBLIC(cJSON_bool) cJSON_HasObjectItem(const cJSON *object, const char *string)\n1946\t{\n1947\t    return cJSON_GetObjectItem(object, string) ? 1 : 0;\n1948\t}\n1949\t\n1950\t/* Utility for array list handling. */\n1951\tstatic void suffix_object(cJSON *prev, cJSON *item)\n1952\t{\n1953\t    prev->next = item;\n1954\t    item->prev = prev;\n1955\t}\n1956\t\n1957\t/* Utility for handling references. */\n1958\tstatic cJSON *create_reference(const cJSON *item, const internal_hooks * const hooks)\n1959\t{\n1960\t    cJSON *reference = NULL;\n1961\t    if (item == NULL)\n1962\t    {\n1963\t        return NULL;\n1964\t    }\n1965\t\n1966\t    reference = cJSON_New_Item(hooks);\n1967\t    if (reference == NULL)\n1968\t    {\n1969\t        return NULL;\n1970\t    }\n1971\t\n1972\t    memcpy(reference, item, sizeof(cJSON));\n1973\t    reference->string = NULL;\n1974\t    reference->type |= cJSON_IsReference;\n1975\t    reference->next = reference->prev = NULL;\n1976\t    return reference;\n1977\t}\n1978\t\n1979\tstatic cJSON_bool add_item_to_array(cJSON *array, cJSON *item)\n1980\t{\n1981\t    cJSON *child = NULL;\n1982\t\n1983\t    if ((item == NULL) || (array == NULL) || (array == item))\n1984\t    {\n1985\t        return false;\n1986\t    }\n1987\t\n1988\t    child = array->child;\n1989\t    /*\n1990\t     * To find the last item in array quickly, we use prev in array\n1991\t     */\n1992\t    if (child == NULL)\n1993\t    {\n1994\t        /* list is empty, start new one */\n1995\t        array->child = item;\n1996\t        item->prev = item;\n1997\t        item->next = NULL;\n1998\t    }\n1999\t    else\n2000\t    {\n2001\t        /* append to the end */\n2002\t        if (child->prev)\n2003\t        {\n2004\t            suffix_object(child->prev, item);\n2005\t            array->child->prev = item;\n2006\t        }\n2007\t    }\n2008\t\n2009\t    return true;\n2010\t}\n2011\t\n2012\t/* Add item to array/object. */\n2013\tCJSON_PUBLIC(cJSON_bool) cJSON_AddItemToArray(cJSON *array, cJSON *item)\n2014\t{\n2015\t    return add_item_to_array(array, item);\n2016\t}\n2017\t\n2018\t#if defined(__clang__) || (defined(__GNUC__)  && ((__GNUC__ > 4) || ((__GNUC__ == 4) && (__GNUC_MINOR__ > 5))))\n2019\t    #pragma GCC diagnostic push\n2020\t#endif\n2021\t#ifdef __GNUC__\n2022\t#pragma GCC diagnostic ignored \"-Wcast-qual\"\n2023\t#endif\n2024\t/* helper function to cast away const */\n2025\tstatic void* cast_away_const(const void* string)\n2026\t{\n2027\t    return (void*)string;\n2028\t}\n2029\t#if defined(__clang__) || (defined(__GNUC__)  && ((__GNUC__ > 4) || ((__GNUC__ == 4) && (__GNUC_MINOR__ > 5))))\n2030\t    #pragma GCC diagnostic pop\n2031\t#endif\n2032\t\n2033\t\n2034\tstatic cJSON_bool add_item_to_object(cJSON * const object, const char * const string, cJSON * const item, const internal_hooks * const hooks, const cJSON_bool constant_key)\n2035\t{\n2036\t    char *new_key = NULL;\n2037\t    int new_type = cJSON_Invalid;\n2038\t\n2039\t    if ((object == NULL) || (string == NULL) || (item == NULL) || (object == item))\n2040\t    {\n2041\t        return false;\n2042\t    }\n2043\t\n2044\t    if (constant_key)\n2045\t    {\n2046\t        new_key = (char*)cast_away_const(string);\n2047\t        new_type = item->type | cJSON_StringIsConst;\n2048\t    }\n2049\t    else\n2050\t    {\n2051\t        new_key = (char*)cJSON_strdup((const unsigned char*)string, hooks);\n2052\t        if (new_key == NULL)\n2053\t        {\n2054\t            return false;\n2055\t        }\n2056\t\n2057\t        new_type = item->type & ~cJSON_StringIsConst;\n2058\t    }\n2059\t\n2060\t    if (!(item->type & cJSON_StringIsConst) && (item->string != NULL))\n2061\t    {\n2062\t        hooks->deallocate(item->string);\n2063\t    }\n2064\t\n2065\t    item->string = new_key;\n2066\t    item->type = new_type;\n2067\t\n2068\t    return add_item_to_array(object, item);\n2069\t}\n2070\t\n2071\tCJSON_PUBLIC(cJSON_bool) cJSON_AddItemToObject(cJSON *object, const char *string, cJSON *item)\n2072\t{\n2073\t    return add_item_to_object(object, string, item, &global_hooks, false);\n2074\t}\n2075\t\n2076\t/* Add an item to an object with constant string as key */\n2077\tCJSON_PUBLIC(cJSON_bool) cJSON_AddItemToObjectCS(cJSON *object, const char *string, cJSON *item)\n2078\t{\n2079\t    return add_item_to_object(object, string, item, &global_hooks, true);\n2080\t}\n2081\t\n2082\tCJSON_PUBLIC(cJSON_bool) cJSON_AddItemReferenceToArray(cJSON *array, cJSON *item)\n2083\t{\n2084\t    if (array == NULL)\n2085\t    {\n2086\t        return false;\n2087\t    }\n2088\t\n2089\t    return add_item_to_array(array, create_reference(item, &global_hooks));\n2090\t}\n2091\t\n2092\tCJSON_PUBLIC(cJSON_bool) cJSON_AddItemReferenceToObject(cJSON *object, const char *string, cJSON *item)\n2093\t{\n2094\t    if ((object == NULL) || 