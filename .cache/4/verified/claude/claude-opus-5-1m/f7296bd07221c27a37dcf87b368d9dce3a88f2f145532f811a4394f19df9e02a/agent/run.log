{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01UvhiG1vVjyBUWuMMqaXA8S","type":"tool_result","content":"1\t//! Rust translation of cJSON 1.7.19 (`c_src/cJSON.c`) plus the `driver`\n2\t//! entry point from `c_src/test.c`.\n3\t//!\n4\t//! The translation is intentionally literal: pointer arithmetic, evaluation\n5\t//! order, error-check ordering and even the original quirks/bugs are\n6\t//! reproduced so that the resulting shared object is a drop-in replacement for\n7\t//! the C build and produces byte-identical output.\n8\t\n9\t#![allow(non_snake_case)]\n10\t#![allow(non_camel_case_types)]\n11\t#![allow(non_upper_case_globals)]\n12\t#![allow(static_mut_refs)]\n13\t#![allow(unused_assignments)]\n14\t#![allow(clippy::missing_safety_doc)]\n15\t\n16\tmod ffi;\n17\tmod test_driver;\n18\t\n19\tuse core::ffi::{c_char, c_int, c_uchar, c_void};\n20\tuse core::ptr::{null, null_mut};\n21\t\n22\tuse ffi::*;\n23\t\n24\t/* ------------------------------------------------------------------------- */\n25\t/* Public types                                                              */\n26\t/* ------------------------------------------------------------------------- */\n27\t\n28\tpub const cJSON_Invalid: c_int = 0;\n29\tpub const cJSON_False: c_int = 1 << 0;\n30\tpub const cJSON_True: c_int = 1 << 1;\n31\tpub const cJSON_NULL: c_int = 1 << 2;\n32\tpub const cJSON_Number: c_int = 1 << 3;\n33\tpub const cJSON_String: c_int = 1 << 4;\n34\tpub const cJSON_Array: c_int = 1 << 5;\n35\tpub const cJSON_Object: c_int = 1 << 6;\n36\tpub const cJSON_Raw: c_int = 1 << 7;\n37\t\n38\tpub const cJSON_IsReference: c_int = 256;\n39\tpub const cJSON_StringIsConst: c_int = 512;\n40\t\n41\tpub const CJSON_NESTING_LIMIT: usize = 1000;\n42\tpub const CJSON_CIRCULAR_LIMIT: usize = 10000;\n43\t\n44\tpub const CJSON_VERSION_MAJOR: c_int = 1;\n45\tpub const CJSON_VERSION_MINOR: c_int = 7;\n46\tpub const CJSON_VERSION_PATCH: c_int = 19;\n47\t\n48\tpub type cJSON_bool = c_int;\n49\t\n50\tconst TRUE: cJSON_bool = 1;\n51\tconst FALSE: cJSON_bool = 0;\n52\t\n53\t/// The value of cJSON's own `NAN` fallback macro (`0.0/0.0`) as evaluated on\n54\t/// x86-64: the quiet \"floating-point indefinite\", which has its sign bit set.\n55\t/// See `cJSON_GetNumberValue`.\n56\tconst NAN_0_DIV_0: f64 = f64::from_bits(0xFFF8_0000_0000_0000u64);\n57\t\n58\t#[repr(C)]\n59\tpub struct cJSON {\n60\t    pub next: *mut cJSON,\n61\t    pub prev: *mut cJSON,\n62\t    pub child: *mut cJSON,\n63\t    pub type_: c_int,\n64\t    pub valuestring: *mut c_char,\n65\t    pub valueint: c_int,\n66\t    pub valuedouble: f64,\n67\t    pub string: *mut c_char,\n68\t}\n69\t\n70\tpub type MallocFn = unsafe extern \"C\" fn(usize) -> *mut c_void;\n71\tpub type FreeFn = unsafe extern \"C\" fn(*mut c_void);\n72\tpub type ReallocFn = unsafe extern \"C\" fn(*mut c_void, usize) -> *mut c_void;\n73\t\n74\t#[repr(C)]\n75\tpub struct cJSON_Hooks {\n76\t    pub malloc_fn: Option<MallocFn>,\n77\t    pub free_fn: Option<FreeFn>,\n78\t}\n79\t\n80\t/* ------------------------------------------------------------------------- */\n81\t/* Internal types & globals                                                  */\n82\t/* ------------------------------------------------------------------------- */\n83\t\n84\t#[derive(Clone, Copy)]\n85\tstruct Error {\n86\t    json: *const c_uchar,\n87\t    position: usize,\n88\t}\n89\t\n90\tstatic mut global_error: Error = Error {\n91\t    json: null(),\n92\t    position: 0,\n93\t};\n94\t\n95\t#[derive(Clone, Copy)]\n96\tstruct internal_hooks {\n97\t    allocate: Option<MallocFn>,\n98\t    deallocate: Option<FreeFn>,\n99\t    reallocate: Option<ReallocFn>,\n100\t}\n101\t\n102\tconst NULL_HOOKS: internal_hooks = internal_hooks {\n103\t    allocate: None,\n104\t    deallocate: None,\n105\t    reallocate: None,\n106\t};\n107\t\n108\tstatic mut global_hooks: internal_hooks = internal_hooks {\n109\t    allocate: Some(malloc),\n110\t    deallocate: Some(free),\n111\t    reallocate: Some(realloc),\n112\t};\n113\t\n114\t#[inline]\n115\tunsafe fn hooks_allocate(hooks: *const internal_hooks, size: usize) -> *mut c_void {\n116\t    match (*hooks).allocate {\n117\t        Some(f) => f(size),\n118\t        None => null_mut(),\n119\t    }\n120\t}\n121\t\n122\t#[inline]\n123\tunsafe fn hooks_deallocate(hooks: *const internal_hooks, pointer: *mut c_void) {\n124\t    if let Some(f) = (*hooks).deallocate {\n125\t        f(pointer);\n126\t    }\n127\t}\n128\t\n129\t#[inline]\n130\tfn fn_addr_alloc(f: Option<MallocFn>) -> usize {\n131\t    match f {\n132\t        Some(f) => f as usize,\n133\t        None => 0,\n134\t    }\n135\t}\n136\t\n137\t#[inline]\n138\tfn fn_addr_free(f: Option<FreeFn>) -> usize {\n139\t    match f {\n140\t        Some(f) => f as usize,\n141\t        None => 0,\n142\t    }\n143\t}\n144\t\n145\t/* ------------------------------------------------------------------------- */\n146\t/* Small helpers                                                             */\n147\t/* ------------------------------------------------------------------------- */\n148\t\n149\t/// Reproduce the C semantics of casting a `double` to `int` on x86-64 for the\n150\t/// values that can actually reach the cast.  Ranges are guarded by the callers;\n151\t/// only NaN can escape, and hardware truncation yields `INT_MIN` for it.\n152\t#[inline]\n153\tfn double_to_int(d: f64) -> c_int {\n154\t    if d.is_nan() {\n155\t        c_int::MIN\n156\t    } else {\n157\t        d as c_int\n158\t    }\n159\t}\n160\t\n161\t#[inline]\n162\tfn cjson_min(a: usize, b: usize) -> usize {\n163\t    if a < b {\n164\t        a\n165\t    } else {\n166\t        b\n167\t    }\n168\t}\n169\t\n170\t/* ------------------------------------------------------------------------- */\n171\t/* Error pointer / value accessors                                           */\n172\t/* ------------------------------------------------------------------------- */\n173\t\n174\t#[unsafe(no_mangle)]\n175\tpub unsafe extern \"C\" fn cJSON_GetErrorPtr() -> *const c_char {\n176\t    (global_error.json as *const c_char).wrapping_add(global_error.position)\n177\t}\n178\t\n179\t#[unsafe(no_mangle)]\n180\tpub unsafe extern \"C\" fn cJSON_GetStringValue(item: *const cJSON) -> *mut c_char {\n181\t    if cJSON_IsString(item) == FALSE {\n182\t        return null_mut();\n183\t    }\n184\t\n185\t    (*item).valuestring\n186\t}\n187\t\n188\t#[unsafe(no_mangle)]\n189\tpub unsafe extern \"C\" fn cJSON_GetNumberValue(item: *const cJSON) -> f64 {\n190\t    if cJSON_IsNumber(item) == FALSE {\n191\t        /* `cJSON.c` returns `(double) NAN`.  The reference build compiles with\n192\t         * `-std=c89`, so glibc's <math.h> does not expose the C99 `NAN` macro\n193\t         * and cJSON's own fallback `#define NAN 0.0/0.0` is what gets used.\n194\t         * On x86-64 `0.0/0.0` is the \"floating-point indefinite\" quiet NaN,\n195\t         * i.e. the sign bit is SET (0xFFF8000000000000) - unlike Rust's\n196\t         * `f64::NAN` (0x7FF8000000000000). */\n197\t        return NAN_0_DIV_0;\n198\t    }\n199\t\n200\t    (*item).valuedouble\n201\t}\n202\t\n203\tstatic mut version_buffer: [c_char; 15] = [0; 15];\n204\t\n205\t#[unsafe(no_mangle)]\n206\tpub unsafe extern \"C\" fn cJSON_Version() -> *const c_char {\n207\t    snprintf(\n208\t        version_buffer.as_mut_ptr(),\n209\t        15,\n210\t        c\"%i.%i.%i\".as_ptr(),\n211\t        CJSON_VERSION_MAJOR,\n212\t        CJSON_VERSION_MINOR,\n213\t        CJSON_VERSION_PATCH,\n214\t    );\n215\t\n216\t    version_buffer.as_ptr()\n217\t}\n218\t\n219\t/* Case insensitive string comparison, doesn't consider two NULL pointers equal though */\n220\tunsafe fn case_insensitive_strcmp(mut string1: *const c_uchar, mut string2: *const c_uchar) -> c_int {\n221\t    if string1.is_null() || string2.is_null() {\n222\t        return 1;\n223\t    }\n224\t\n225\t    if string1 == string2 {\n226\t        return 0;\n227\t    }\n228\t\n229\t    while tolower(*string1 as c_int) == tolower(*string2 as c_int) {\n230\t        if *string1 == b'\\0' {\n231\t            return 0;\n232\t        }\n233\t        string1 = string1.add(1);\n234\t        string2 = string2.add(1);\n235\t    }\n236\t\n237\t    tolower(*string1 as c_int) - tolower(*string2 as c_int)\n238\t}\n239\t\n240\tunsafe fn cJSON_strdup(string: *const c_uchar, hooks: *const internal_hooks) -> *mut c_uchar {\n241\t    let length: usize;\n242\t    let copy: *mut c_uchar;\n243\t\n244\t    if string.is_null() {\n245\t        return null_mut();\n246\t    }\n247\t\n248\t    length = strlen(string as *const c_char) + 1;\n249\t    copy = hooks_allocate(hooks, length) as *mut c_uchar;\n250\t    if copy.is_null() {\n251\t        return null_mut();\n252\t    }\n253\t    memcpy(copy as *mut c_void, string as *const c_void, length);\n254\t\n255\t    copy\n256\t}\n257\t\n258\t#[unsafe(no_mangle)]\n259\tpub unsafe extern \"C\" fn cJSON_InitHooks(hooks: *mut cJSON_Hooks) {\n260\t    if hooks.is_null() {\n261\t        /* Reset hooks */\n262\t        global_hooks.allocate = Some(malloc);\n263\t        global_hooks.deallocate = Some(free);\n264\t        global_hooks.reallocate = Some(realloc);\n265\t        return;\n266\t    }\n267\t\n268\t    global_hooks.allocate = Some(malloc);\n269\t    if (*hooks).malloc_fn.is_some() {\n270\t        global_hooks.allocate = (*hooks).malloc_fn;\n271\t    }\n272\t\n273\t    global_hooks.deallocate = Some(free);\n274\t    if (*hooks).free_fn.is_some() {\n275\t        global_hooks.deallocate = (*hooks).free_fn;\n276\t    }\n277\t\n278\t    /* use realloc only if both free and malloc are used */\n279\t    global_hooks.reallocate = None;\n280\t    if (fn_addr_alloc(global_hooks.allocate) == (malloc as MallocFn) as usize)\n281\t        && (fn_addr_free(global_hooks.deallocate) == (free as FreeFn) as usize)\n282\t    {\n283\t        global_hooks.reallocate = Some(realloc);\n284\t    }\n285\t}\n286\t\n287\t/* Internal constructor. */\n288\tunsafe fn cJSON_New_Item(hooks: *const internal_hooks) -> *mut cJSON {\n289\t    let node = hooks_allocate(hooks, core::mem::size_of::<cJSON>()) as *mut cJSON;\n290\t    if !node.is_null() {\n291\t        memset(node as *mut c_void, b'\\0' as c_int, core::mem::size_of::<cJSON>());\n292\t    }\n293\t\n294\t    node\n295\t}\n296\t\n297\t/* Delete a cJSON structure. */\n298\t#[unsafe(no_mangle)]\n299\tpub unsafe extern \"C\" fn cJSON_Delete(mut item: *mut cJSON) {\n300\t    let mut next: *mut cJSON;\n301\t    while !item.is_null() {\n302\t        next = (*item).next;\n303\t        if ((*item).type_ & cJSON_IsReference) == 0 && !(*item).child.is_null() {\n304\t            cJSON_Delete((*item).child);\n305\t        }\n306\t        if ((*item).type_ & cJSON_IsReference) == 0 && !(*item).valuestring.is_null() {\n307\t            hooks_deallocate(&global_hooks, (*item).valuestring as *mut c_void);\n308\t            (*item).valuestring = null_mut();\n309\t        }\n310\t        if ((*item).type_ & cJSON_StringIsConst) == 0 && !(*item).string.is_null() {\n311\t            hooks_deallocate(&global_hooks, (*item).string as *mut c_void);\n312\t            (*item).string = null_mut();\n313\t        }\n314\t        hooks_deallocate(&global_hooks, item as *mut c_void);\n315\t        item = next;\n316\t    }\n317\t}\n318\t\n319\t/* get the decimal point character of the current locale */\n320\tunsafe fn get_decimal_point() -> c_uchar {\n321\t    /* ENABLE_LOCALES is defined by the reference CMake build */\n322\t    let lconv = localeconv();\n323\t    *(*lconv).decimal_point as c_uchar\n324\t}\n325\t\n326\t/* ------------------------------------------------------------------------- */\n327\t/* parse buffer                                                              */\n328\t/* ------------------------------------------------------------------------- */\n329\t\n330\t#[derive(Clone, Copy)]\n331\tstruct parse_buffer {\n332\t    content: *const c_uchar,\n333\t    length: usize,\n334\t    offset: usize,\n335\t    depth: usize,\n336\t    hooks: internal_hooks,\n337\t}\n338\t\n339\t#[inline]\n340\tunsafe fn can_read(buffer: *const parse_buffer, size: usize) -> bool {\n341\t    !buffer.is_null() && ((*buffer).offset.wrapping_add(size) <= (*buffer).length)\n342\t}\n343\t\n344\t#[inline]\n345\tunsafe fn can_access_at_index(buffer: *const parse_buffer, index: usize) -> bool {\n346\t    !buffer.is_null() && ((*buffer).offset.wrapping_add(index) < (*buffer).length)\n347\t}\n348\t\n349\t#[inline]\n350\tunsafe fn cannot_access_at_index(buffer: *const parse_buffer, index: usize) -> bool {\n351\t    !can_access_at_index(buffer, index)\n352\t}\n353\t\n354\t#[inline]\n355\tunsafe fn buffer_at_offset(buffer: *const parse_buffer) -> *const c_uchar {\n356\t    (*buffer).content.wrapping_add((*buffer).offset)\n357\t}\n358\t\n359\t/* Parse the input text to generate a number, and populate the result into item. */\n360\tunsafe fn parse_number(item: *mut cJSON, input_buffer: *mut parse_buffer) -> cJSON_bool {\n361\t    let number: f64;\n362\t    let mut after_end: *mut c_char = null_mut();\n363\t    let number_c_string: *mut c_uchar;\n364\t    let decimal_point = get_decimal_point();\n365\t    let mut i: usize = 0;\n366\t    let mut number_string_length: usize = 0;\n367\t    let mut has_decimal_point: cJSON_bool = FALSE;\n368\t\n369\t    if input_buffer.is_null() || (*input_buffer).content.is_null() {\n370\t        return FALSE;\n371\t    }\n372\t\n373\t    /* copy the number into a temporary buffer and replace '.' with the decimal point\n374\t     * of the current locale (for strtod)\n375\t     * This also takes care of '\\0' not necessarily being available for marking the end of the input */\n376\t    i = 0;\n377\t    while can_access_at_index(input_buffer, i) {\n378\t        match *buffer_at_offset(input_buffer).wrapping_add(i) {\n379\t            b'0' | b'1' | b'2' | b'3' | b'4' | b'5' | b'6' | b'7' | b'8' | b'9' | b'+' | b'-'\n380\t            | b'e' | b'E' => {\n381\t                number_string_length += 1;\n382\t            }\n383\t\n384\t            b'.' => {\n385\t                number_string_length += 1;\n386\t                has_decimal_point = TRUE;\n387\t            }\n388\t\n389\t            _ => break,\n390\t        }\n391\t        i += 1;\n392\t    }\n393\t\n394\t    /* malloc for temporary buffer, add 1 for '\\0' */\n395\t    number_c_string =\n396\t        hooks_allocate(&(*input_buffer).hooks, number_string_length + 1) as *mut c_uchar;\n397\t    if number_c_string.is_null() {\n398\t        return FALSE; /* allocation failure */\n399\t    }\n400\t\n401\t    memcpy(\n402\t        number_c_string as *mut c_void,\n403\t        buffer_at_offset(input_buffer) as *const c_void,\n404\t        number_string_length,\n405\t    );\n406\t    *number_c_string.add(number_string_length) = b'\\0';\n407\t\n408\t    if has_decimal_point != FALSE {\n409\t        i = 0;\n410\t        while i < number_string_length {\n411\t            if *number_c_string.add(i) == b'.' {\n412\t                /* replace '.' with the decimal point of the current locale (for strtod) */\n413\t                *number_c_string.add(i) = decimal_point;\n414\t            }\n415\t            i += 1;\n416\t        }\n417\t    }\n418\t\n419\t    number = strtod(number_c_string as *const c_char, &mut after_end as *mut *mut c_char);\n420\t    if number_c_string as *const c_char == after_end as *const c_char {\n421\t        /* free the temporary buffer */\n422\t        hooks_deallocate(&(*input_buffer).hooks, number_c_string as *mut c_void);\n423\t        return FALSE; /* parse_error */\n424\t    }\n425\t\n426\t    (*item).valuedouble = number;\n427\t\n428\t    /* use saturation in case of overflow */\n429\t    if number >= c_int::MAX as f64 {\n430\t        (*item).valueint = c_int::MAX;\n431\t    } else if number <= c_int::MIN as f64 {\n432\t        (*item).valueint = c_int::MIN;\n433\t    } else {\n434\t        (*item).valueint = double_to_int(number);\n435\t    }\n436\t\n437\t    (*item).type_ = cJSON_Number;\n438\t\n439\t    (*input_buffer).offset = (*input_buffer)\n440\t        .offset\n441\t        .wrapping_add((after_end as usize).wrapping_sub(number_c_string as usize));\n442\t    /* free the temporary buffer */\n443\t    hooks_deallocate(&(*input_buffer).hooks, number_c_string as *mut c_void);\n444\t    TRUE\n445\t}\n446\t\n447\t/* don't ask me, but the original cJSON_SetNumberValue returns an integer or double */\n448\t#[unsafe(no_mangle)]\n449\tpub unsafe extern \"C\" fn cJSON_SetNumberHelper(object: *mut cJSON, number: f64) -> f64 {\n450\t    if number >= c_int::MAX as f64 {\n451\t        (*object).valueint = c_int::MAX;\n452\t    } else if number <= c_int::MIN as f64 {\n453\t        (*object).valueint = c_int::MIN;\n454\t    } else {\n455\t        (*object).valueint = double_to_int(number);\n456\t    }\n457\t\n458\t    (*object).valuedouble = number;\n459\t    (*object).valuedouble\n460\t}\n461\t\n462\t/* Note: when passing a NULL valuestring, cJSON_SetValuestring treats this as an error and return NULL */\n463\t#[unsafe(no_mangle)]\n464\tpub unsafe extern \"C\" fn cJSON_SetValuestring(\n465\t    object: *mut cJSON,\n466\t    valuestring: *const c_char,\n467\t) -> *mut c_char {\n468\t    let copy: *mut c_char;\n469\t    let v1_len: usize;\n470\t    let v2_len: usize;\n471\t    /* if object's type is not cJSON_String or is cJSON_IsReference, it should not set valuestring */\n472\t    if object.is_null()\n473\t        || ((*object).type_ & cJSON_String) == 0\n474\t        || ((*object).type_ & cJSON_IsReference) != 0\n475\t    {\n476\t        return null_mut();\n477\t    }\n478\t    /* return NULL if the object is corrupted or valuestring is NULL */\n479\t    if (*object).valuestring.is_null() || valuestring.is_null() {\n480\t        return null_mut();\n481\t    }\n482\t\n483\t    v1_len = strlen(valuestring);\n484\t    v2_len = strlen((*object).valuestring);\n485\t\n486\t    if v1_len <= v2_len {\n487\t        /* str