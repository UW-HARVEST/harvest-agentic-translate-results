[2147483647,2147483648,-2147483648,-2147483649]\",\n    \"[1.0,2.00,3.000]\",\n    \"\\xEF\\xBB\\xBF{\\\"a\\\":1}\",\n    \"[\\\"\\\\u0000\\\"]\",\n    \"  \", \"\", \"   \\t\\n  \",\n    \"[[[[[[[[[[1]]]]]]]]]]\",\n};\n#define NJSONS (sizeof(jsons)/sizeof(jsons[0]))\n\nstatic void scen_parse_print(lib *L, sbuf *s) {\n    size_t i;\n    for (i = 0; i < NJSONS; i++) {\n        cJSON *root = L->Parse(jsons[i]);\n        sb_add(s, \"P%zu ptr=%d\", i, root != NULL);\n        if (root) {\n            char *f = L->Print(root);\n            char *u = L->PrintUnformatted(root);\n            sb_add(s, \" fmt=[%s] unf=[%s] size=%d type=%d\",\n                   f?f:\"(null)\", u?u:\"(null)\", L->GetArraySize(root), root->type);\n            sb_add(s, \" isarr=%d isobj=%d isnum=%d isstr=%d isnull=%d istrue=%d isfalse=%d isbool=%d israw=%d isinv=%d\",\n                   L->IsArray(root), L->IsObject(root), L->IsNumber(root), L->IsString(root),\n                   L->IsNull(root), L->IsTrue(root), L->IsFalse(root), L->IsBool(root),\n                   L->IsRaw(root), L->IsInvalid(root));\n            /* preallocated print, exact and one-short */\n            if (f) {\n                size_t len = strlen(f);\n                char *b1 = calloc(len + 8, 1);\n                char *b2 = calloc(len + 8, 1);\n                int r1 = L->PrintPreallocated(root, b1, (int)len + 1, 1);\n                int r2 = L->PrintPreallocated(root, b2, (int)len, 1);\n                sb_add(s, \" pre1=%d[%s] pre2=%d[%s]\", r1, b1, r2, b2);\n                free(b1); free(b2);\n            }\n            /* duplicate */\n            cJSON *d = L->Duplicate(root, 1);\n            char *df = d ? L->PrintUnformatted(d) : NULL;\n            sb_add(s, \" dup=[%s] cmp=%d cmpcs=%d\", df?df:\"(null)\",\n                   L->Compare(root, d, 0), L->Compare(root, d, 1));\n            if (df) L->cfree(df);\n            if (d) L->Delete(d);\n            cJSON *d0 = L->Duplicate(root, 0);\n            char *d0f =