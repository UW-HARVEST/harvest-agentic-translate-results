nsitive_strcmp */\n  {\n    const char *json = \"{\\\"Abc\\\":1,\\\"aBC\\\":2,\\\"\\\":3,\\\"\\xc3\\x89t\\\":4,\\\"\\xe9t\\\":5,\\\"ABCD\\\":6}\";\n    const char *keys[] = {\"abc\",\"ABC\",\"Abc\",\"aBc\",\"\",\"\\xc3\\xa9t\",\"\\xc3\\x89T\",\"\\xe9t\",\"\\xc9T\",\"abcd\",\"ABCDE\",\"a\",\"AB\",NULL,\"\\x7f\",\"\\x80\"};\n    size_t k;\n    cJSON *ci=C.Parse(json), *ri=R.Parse(json);\n    if(!ci||!ri){printf(\"parse failed\\n\");return 2;}\n    for(k=0;k<sizeof(keys)/sizeof(keys[0]);k++){\n      cJSON *a=C.GetObjectItem(ci,keys[k]), *b=R.GetObjectItem(ri,keys[k]);\n      int av = a?a->valueint:-1, bv = b?b->valueint:-1;\n      if(av!=bv){printf(\"DIFF GetObjectItem key=<%s>: C=%d R=%d\\n\", keys[k]?keys[k]:\"NULL\", av, bv); fails++;}\n      a=C.GetObjectItemCaseSensitive(ci,keys[k]); b=R.GetObjectItemCaseSensitive(ri,keys[k]);\n      av=a?a->valueint:-1; bv=b?b->valueint:-1;\n      if(av!=bv){printf(\"DIFF GetObjectItemCS key=<%s>: C=%d R=%d\\n\", keys[k]?keys[k]:\"NULL\", av, bv); fails++;}\n      if(C.HasObjectItem(ci,keys[k])!=R.HasObjectItem(ri,keys[k])){printf(\"DIFF HasObjectItem <%s>\\n\",keys[k]?keys[k]:\"NULL\");fails++;}\n    }\n    C.Delete(ci); R.Delete(ri);\n  }\n  /* large / deep to exercise ensure() growth many times */\n  {\n    size_t N;\n    for (N = 1; N <= 4096; N = N*2+1) {\n      char *big = malloc(N*8+64); size_t k; char *p = big;\n      *p++='[';\n      for(k=0;k<N;k++){ p += sprintf(p, \"%s%zu\", k?\",\":\"\", k%1000); }\n      *p++=']'; *p=0;\n      { cJSON *ci=C.Parse(big), *ri=R.Parse(big);\n        char *cp,*rp;\n        if((ci==NULL)!=(ri==NULL)){printf(\"DIFF big parse N=%zu\\n\",N);fails++;}\n        if(ci&&ri){\n          cp=C.Print(ci); rp=R.Print(ri);\n          if((cp==NULL)!=(rp==NULL)||(cp&&rp&&strcmp(cp,rp))){printf(\"DIFF big Print N=%zu\\n\",N);fails++;}\n          if(cp)C.free(cp); if(rp)R.free(rp);\n          cp=C.PrintUnformatted(ci); rp=R.PrintUnformatted(ri);\n          if((cp==NULL)!=(rp==NULL)||(cp&&rp&&strcmp(cp,rp)