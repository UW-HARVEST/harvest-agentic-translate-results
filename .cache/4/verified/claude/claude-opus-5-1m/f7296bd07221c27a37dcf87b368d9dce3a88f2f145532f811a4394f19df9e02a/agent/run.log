R=<%s>\\n\",len,cp?cp:\"N\",rp?rp:\"N\"); fails++;\n            }\n            if(cp)C.free(cp); if(rp)R.free(rp);\n            { char cb[256],rb[256]; int L;\n              for(L=0;L<24;L++){ memset(cb,0xAA,sizeof cb); memset(rb,0xAA,sizeof rb);\n                int x=C.PrintPreallocated(ci,cb,L,1), y=R.PrintPreallocated(ri,rb,L,1);\n                if(x!=y||memcmp(cb,rb,sizeof cb)){printf(\"DIFF prealloc L=%d len=%zu\\n\",L,len);fails++;} } }\n        }\n        if(ci)C.Delete(ci); if(ri)R.Delete(ri);\n    }\n}\n\nint main(int argc, char **argv){\n    char buf[64];\n    long iter = argc>1?atol(argv[1]):200000;\n    long i;\n    const char *loc = argc>2?argv[2]:NULL;\n    load(&C,\"./libcjson.so\"); load(&R,\"./librust.so\");\n    if (loc) { if(!setlocale(LC_ALL,loc)) { printf(\"locale %s unavailable\\n\",loc); return 0; } printf(\"locale=%s decimal=%s\\n\", loc, localeconv()->decimal_point); }\n    for(i=0;i<iter;i++){\n        size_t len = 1 + rnd()%20;\n        size_t k;\n        for(k=0;k<len;k++) buf[k]=alphabet[rnd()%(sizeof(alphabet)-1)];\n        buf[len]=0;\n        one(buf,len);\n        one(buf,len+1);\n    }\n    /* number round-trip fuzz in current locale */\n    for(i=0;i<20000;i++){\n        union { uint64_t u; double d; } v;\n        v.u = ((uint64_t)rnd()<<32) | rnd();\n        cJSON *cn=C.CreateNumber(v.d), *rn=R.CreateNumber(v.d);\n        char *cp=C.PrintUnformatted(cn), *rp=R.PrintUnformatted(rn);\n        if((cp==NULL)!=(rp==NULL)||(cp&&rp&&strcmp(cp,rp))){\n            printf(\"DIFF num %016lx (%.20g): C=%s R=%s\\n\",(unsigned long)v.u, v.d, cp?cp:\"N\", rp?rp:\"N\"); fails++; }\n        if(cp)C.free(cp); if(rp)R.free(rp);\n        if(cn&&cn->valueint!=rn->valueint){printf(\"DIFF valueint %016lx: %d vs %d\\n\",(unsigned long)v.u,cn->valueint,rn->valueint);fails++;}\n        C.Delete(cn); R.Delete(rn);\n    }\n    /* InitHooks: default reset -> realloc should be used (observable via large prints) */\n    { cJSON_Hooks h; h.malloc_fn = malloc; 