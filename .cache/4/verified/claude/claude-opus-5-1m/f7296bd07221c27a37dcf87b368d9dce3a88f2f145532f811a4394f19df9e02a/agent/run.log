{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Uf8GJNhFETCD6kSRS7qu3r","type":"tool_result","content":"1\t/*\n2\t  Copyright (c) 2009-2017 Dave Gamble and cJSON contributors\n3\t\n4\t  Permission is hereby granted, free of charge, to any person obtaining a copy\n5\t  of this software and associated documentation files (the \"Software\"), to deal\n6\t  in the Software without restriction, including without limitation the rights\n7\t  to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n8\t  copies of the Software, and to permit persons to whom the Software is\n9\t  furnished to do so, subject to the following conditions:\n10\t\n11\t  The above copyright notice and this permission notice shall be included in\n12\t  all copies or substantial portions of the Software.\n13\t\n14\t  THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n15\t  IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n16\t  FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n17\t  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n18\t  LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n19\t  OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN\n20\t  THE SOFTWARE.\n21\t*/\n22\t\n23\t#include <stdio.h>\n24\t#include <stdlib.h>\n25\t#include <string.h>\n26\t#include \"cJSON.h\"\n27\t\n28\t/* Used by some code below as an example datatype. */\n29\tstruct record\n30\t{\n31\t    const char *precision;\n32\t    double lat;\n33\t    double lon;\n34\t    const char *address;\n35\t    const char *city;\n36\t    const char *state;\n37\t    const char *zip;\n38\t    const char *country;\n39\t};\n40\t\n41\tint CJSON_CDECL CJSON_PUBLIC(driver)(const char *strings[7], int numbers[3][3], int ids[4], struct record fields[2]);\n42\t\n43\t/* Create a bunch of objects as demonstration. */\n44\tstatic int print_preallocated(cJSON *root)\n45\t{\n46\t    /* declarations */\n47\t    char *out = NULL;\n48\t    char *buf = NULL;\n49\t    char *buf_fail = NULL;\n50\t    size_t len = 0;\n51\t    size_t len_fail = 0;\n52\t\n53\t    /* formatted print */\n54\t    out = cJSON_Print(root);\n55\t\n56\t    /* create buffer to succeed */\n57\t    /* the extra 5 bytes are because of inaccuracies when reserving memory */\n58\t    len = strlen(out) + 5;\n59\t    buf = (char*)malloc(len);\n60\t    if (buf == NULL)\n61\t    {\n62\t        printf(\"Failed to allocate memory.\\n\");\n63\t        exit(1);\n64\t    }\n65\t\n66\t    /* create buffer to fail */\n67\t    len_fail = strlen(out);\n68\t    buf_fail = (char*)malloc(len_fail);\n69\t    if (buf_fail == NULL)\n70\t    {\n71\t        printf(\"Failed to allocate memory.\\n\");\n72\t        exit(1);\n73\t    }\n74\t\n75\t    /* Print to buffer */\n76\t    if (!cJSON_PrintPreallocated(root, buf, (int)len, 1)) {\n77\t        printf(\"cJSON_PrintPreallocated failed!\\n\");\n78\t        if (strcmp(out, buf) != 0) {\n79\t            printf(\"cJSON_PrintPreallocated not the same as cJSON_Print!\\n\");\n80\t            printf(\"cJSON_Print result:\\n%s\\n\", out);\n81\t            printf(\"cJSON_PrintPreallocated result:\\n%s\\n\", buf);\n82\t        }\n83\t        free(out);\n84\t        free(buf_fail);\n85\t        free(buf);\n86\t        return -1;\n87\t    }\n88\t\n89\t    /* success */\n90\t    printf(\"%s\\n\", buf);\n91\t\n92\t    /* force it to fail */\n93\t    if (cJSON_PrintPreallocated(root, buf_fail, (int)len_fail, 1)) {\n94\t        printf(\"cJSON_PrintPreallocated failed to show error with insufficient memory!\\n\");\n95\t        printf(\"cJSON_Print result:\\n%s\\n\", out);\n96\t        printf(\"cJSON_PrintPreallocated result:\\n%s\\n\", buf_fail);\n97\t        free(out);\n98\t        free(buf_fail);\n99\t        free(buf);\n100\t        return -1;\n101\t    }\n102\t\n103\t    free(out);\n104\t    free(buf_fail);\n105\t    free(buf);\n106\t    return 0;\n107\t}\n108\t\n109\t/* Create a bunch of objects as demonstration. */\n110\tstatic void create_objects(const char *strings[7], int numbers[3][3], int ids[4], struct record fields[2])\n111\t{\n112\t    /* declare a few. */\n113\t    cJSON *root = NULL;\n114\t    cJSON *fmt = NULL;\n115\t    cJSON *img = NULL;\n116\t    cJSON *thm = NULL;\n117\t    cJSON *fld = NULL;\n118\t    int i = 0;\n119\t\n120\t    volatile double zero = 0.0;\n121\t\n122\t    /* Here we construct some JSON standards, from the JSON site. */\n123\t\n124\t    /* Our \"Video\" datatype: */\n125\t    root = cJSON_CreateObject();\n126\t    cJSON_AddItemToObject(root, \"name\", cJSON_CreateString(\"Jack (\\\"Bee\\\") Nimble\"));\n127\t    cJSON_AddItemToObject(root, \"format\", fmt = cJSON_CreateObject());\n128\t    cJSON_AddStringToObject(fmt, \"type\", \"rect\");\n129\t    cJSON_AddNumberToObject(fmt, \"width\", 1920);\n130\t    cJSON_AddNumberToObject(fmt, \"height\", 1080);\n131\t    cJSON_AddFalseToObject (fmt, \"interlace\");\n132\t    cJSON_AddNumberToObject(fmt, \"frame rate\", 24);\n133\t\n134\t    /* Print to text */\n135\t    if (print_preallocated(root) != 0) {\n136\t        cJSON_Delete(root);\n137\t        exit(EXIT_FAILURE);\n138\t    }\n139\t    cJSON_Delete(root);\n140\t\n141\t    /* Our \"days of the week\" array: */\n142\t    root = cJSON_CreateStringArray(strings, 7);\n143\t\n144\t    if (print_preallocated(root) != 0) {\n145\t        cJSON_Delete(root);\n146\t        exit(EXIT_FAILURE);\n147\t    }\n148\t    cJSON_Delete(root);\n149\t\n150\t    /* Our matrix: */\n151\t    root = cJSON_CreateArray();\n152\t    for (i = 0; i < 3; i++)\n153\t    {\n154\t        cJSON_AddItemToArray(root, cJSON_CreateIntArray(numbers[i], 3));\n155\t    }\n156\t\n157\t    /* cJSON_ReplaceItemInArray(root, 1, cJSON_CreateString(\"Replacement\")); */\n158\t\n159\t    if (print_preallocated(root) != 0) {\n160\t        cJSON_Delete(root);\n161\t        exit(EXIT_FAILURE);\n162\t    }\n163\t    cJSON_Delete(root);\n164\t\n165\t    /* Our \"gallery\" item: */\n166\t    root = cJSON_CreateObject();\n167\t    cJSON_AddItemToObject(root, \"Image\", img = cJSON_CreateObject());\n168\t    cJSON_AddNumberToObject(img, \"Width\", 800);\n169\t    cJSON_AddNumberToObject(img, \"Height\", 600);\n170\t    cJSON_AddStringToObject(img, \"Title\", \"View from 15th Floor\");\n171\t    cJSON_AddItemToObject(img, \"Thumbnail\", thm = cJSON_CreateObject());\n172\t    cJSON_AddStringToObject(thm, \"Url\", \"http:/*www.example.com/image/481989943\");\n173\t    cJSON_AddNumberToObject(thm, \"Height\", 125);\n174\t    cJSON_AddStringToObject(thm, \"Width\", \"100\");\n175\t    cJSON_AddItemToObject(img, \"IDs\", cJSON_CreateIntArray(ids, 4));\n176\t\n177\t    if (print_preallocated(root) != 0) {\n178\t        cJSON_Delete(root);\n179\t        exit(EXIT_FAILURE);\n180\t    }\n181\t    cJSON_Delete(root);\n182\t\n183\t    /* Our array of \"records\": */\n184\t    root = cJSON_CreateArray();\n185\t    for (i = 0; i < 2; i++)\n186\t    {\n187\t        cJSON_AddItemToArray(root, fld = cJSON_CreateObject());\n188\t        cJSON_AddStringToObject(fld, \"precision\", fields[i].precision);\n189\t        cJSON_AddNumberToObject(fld, \"Latitude\", fields[i].lat);\n190\t        cJSON_AddNumberToObject(fld, \"Longitude\", fields[i].lon);\n191\t        cJSON_AddStringToObject(fld, \"Address\", fields[i].address);\n192\t        cJSON_AddStringToObject(fld, \"City\", fields[i].city);\n193\t        cJSON_AddStringToObject(fld, \"State\", fields[i].state);\n194\t        cJSON_AddStringToObject(fld, \"Zip\", fields[i].zip);\n195\t        cJSON_AddStringToObject(fld, \"Country\", fields[i].country);\n196\t    }\n197\t\n198\t    /* cJSON_ReplaceItemInObject(cJSON_GetArrayItem(root, 1), \"City\", cJSON_CreateIntArray(ids, 4)); */\n199\t\n200\t    if (print_preallocated(root) != 0) {\n201\t        cJSON_Delete(root);\n202\t        exit(EXIT_FAILURE);\n203\t    }\n204\t    cJSON_Delete(root);\n205\t\n206\t    root = cJSON_CreateObject();\n207\t    cJSON_AddNumberToObject(root, \"number\", 1.0 / zero);\n208\t\n209\t    if (print_preallocated(root) != 0) {\n210\t        cJSON_Delete(root);\n211\t        exit(EXIT_FAILURE);\n212\t    }\n213\t    cJSON_Delete(root);\n214\t}\n215\t\n216\tint CJSON_CDECL CJSON_PUBLIC(driver)(const char *strings[7], int numbers[3][3], int ids[4], struct record fields[2])\n217\t{\n218\t    /* print the version */\n219\t    printf(\"Version: %s\\n\", cJSON_Version());\n220\t\n221\t    /* Now some samplecode for building objects concisely: */\n222\t    create_objects(strings, numbers, ids, fields);\n223\t\n224\t    return 0;\n225\t}\n226\t"}]},"parent_tool_use_id":"toolu_bdrk_013AcLyvrPJ6FtmffU4vbBrs","session_id":"99d8c152-90eb-46f7-8482-a09fedc8e20a","uuid":"1beebfbe-89b7-4ff4-b720-98c529b477c5","timestamp":"2026-08-20T07:18:21.026Z","subagent_type":"general-purpose","task_description":"Review C vs Rust part 2"}
