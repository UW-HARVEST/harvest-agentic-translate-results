  }\n242\t    memcpy(copy as *mut c_void, string as *const c_void, length);\n243\t\n244\t    copy\n245\t}\n246\t\n247\t#[unsafe(no_mangle)]\n248\tpub unsafe extern \"C\" fn cJSON_InitHooks(hooks: *mut cJSON_Hooks) {\n249\t    if hooks.is_null() {\n250\t        /* Reset hooks */\n251\t        global_hooks.allocate = Some(malloc);\n252\t        global_hooks.deallocate = Some(free);\n253\t        global_hooks.reallocate = Some(realloc);\n254\t        return;\n255\t    }\n256\t\n257\t    global_hooks.allocate = Some(malloc);\n258\t    if (*hooks).malloc_fn.is_some() {\n259\t        global_hooks.allocate = (*hooks).malloc_fn;\n260\t    }\n261\t\n262\t    global_hooks.deallocate = Some(free);\n263\t    if (*hooks).free_fn.is_some() {\n264\t        global_hooks.deallocate = (*hooks).free_fn;\n265\t    }\n266\t\n267\t    /* use realloc only if both free and malloc are used */\n268\t    global_hooks.reallocate = None;\n269\t    if (fn_addr_alloc(global_hooks.allocate) == (malloc as MallocFn) as usize)\n270\t        && (fn_addr_free(global_hooks.deallocate) == (free as FreeFn) as usize)\n271\t    {\n272\t        global_hooks.reallocate = Some(realloc);\n273\t    }\n274\t}\n275\t\n276\t/* Internal constructor. */\n277\tunsafe fn cJSON_New_Item(hooks: *const internal_hooks) -> *mut cJSON {\n278\t    let node = hooks_allocate(hooks, core::mem::size_of::<cJSON>()) as *mut cJSON;\n279\t    if !node.is_null() {\n280\t        memset(node as *mut c_void, b'\\0' as c_int, core::mem::size_of::<cJSON>());\n281\t    }\n282\t\n283\t    node\n284\t}\n285\t\n286\t/* Delete a cJSON structure. */\n287\t#[unsafe(no_mangle)]\n288\tpub unsafe extern \"C\" fn cJSON_Delete(mut item: *mut cJSON) {\n289\t    let mut next: *mut cJSON;\n290\t    while !item.is_null() {\n291\t        next = (*item).next;\n292\t        if ((*item).type_ & cJSON_IsReference) == 0 && !(*item).child.is_null() {\n293\t            cJSON_Delete((*item).child);\n294\t        }\n295\t        if ((*item).type_ & cJSON_IsReference) == 0 && !(*item).valuestring.is_null() {\n296\t            hooks_deallocate(&global_hooks, (*item).valuestring as *mut c_void);\n297\t            (*item).valuestring = null_mut();\n298\t        }\n299\t        if ((*item).type_ & cJSON_StringIsConst) == 0 && !(*item).string.is_null() {\n300\t            hooks_deallocate(&global_hooks, (*item).string as *mut c_void);\n301\t            (*item).string = null_mut();\n302\t        }\n303\t        hooks_deallocate(&global_hooks, item as *mut c_void);\n304\t        item = next;\n305\t    }\n306\t}\n307\t\n308\t/* get the decimal point character of the current locale */\n309\tunsafe fn get_decimal_point() -> c_uchar {\n310\t    /* ENABLE_LOCALES is defined by the reference CMake build */\n311\t    let lconv = localeconv();\n312\t    *(*lconv).decimal_point as c_uchar\n313\t}\n314\t\n315\t/* ------------------------------------------------------------------------- */\n316\t/* parse buffer                                                              */\n317\t/* ------------------------------------------------------------------------- */\n318\t\n319\t#[derive(Clone, Copy)]\n320\tstruct parse_buffer {\n321\t    content: *const c_uchar,\n322\t    length: usize,\n323\t    offset: usize,\n324\t    depth: usize,\n325\t    hooks: internal_hooks,\n326\t}\n327\t\n328\t#[inline]\n329\tunsafe fn can_read(buffer: *const parse_buffer, size: usize) -> bool {\n330\t    !buffer.is_null() && ((*buffer).offset.wrapping_add(size) <= (*buffer).length)\n331\t}\n332\t\n333\t#[inline]\n334\tunsafe fn can_access_at_index(buffer: *const parse_buffer, index: usize) -> bool {\n335\t    !buffer.is_null() && ((*buffer).offset.wrapping_add(index) < (*buffer).length)\n336\t}\n337\t\n338\t#[inline]\n339\tunsafe fn cannot_access_at_index(buffer: *const parse_buffer, index: usize) -> bool {\n340\t    !can_access_at_index(buffer, index)\n341\t}\n342\t\n343\t#[inline]\n344\tunsafe fn buffer_at_offset(buffer: *const parse_buffer) -> *const c_uchar {\n345\t   