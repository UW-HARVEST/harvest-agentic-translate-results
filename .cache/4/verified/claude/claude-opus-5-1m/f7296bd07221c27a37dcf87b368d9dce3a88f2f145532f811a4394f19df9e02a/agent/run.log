ke sure that offset is valid */\n543\t        return null_mut();\n544\t    }\n545\t\n546\t    if needed > c_int::MAX as usize {\n547\t        /* sizes bigger than INT_MAX are currently not supported */\n548\t        return null_mut();\n549\t    }\n550\t\n551\t    needed = needed.wrapping_add((*p).offset).wrapping_add(1);\n552\t    if needed <= (*p).length {\n553\t        return (*p).buffer.wrapping_add((*p).offset);\n554\t    }\n555\t\n556\t    if (*p).noalloc != FALSE {\n557\t        return null_mut();\n558\t    }\n559\t\n560\t    /* calculate new buffer size */\n561\t    if needed > (c_int::MAX as usize / 2) {\n562\t        /* overflow of int, use INT_MAX if possible */\n563\t        if needed <= c_int::MAX as usize {\n564\t            newsize = c_int::MAX as usize;\n565\t        } else {\n566\t            return null_mut();\n567\t        }\n568\t    } else {\n569\t        newsize = needed * 2;\n570\t    }\n571\t\n572\t    if (*p).hooks.reallocate.is_some() {\n573\t        /* reallocate with realloc if available */\n574\t        newbuffer = ((*p).hooks.reallocate.unwrap())((*p).buffer as *mut c_void, newsize)\n575\t            as *mut c_uchar;\n576\t        if newbuffer.is_null() {\n577\t            hooks_deallocate(&(*p).hooks, (*p).buffer as *mut c_void);\n578\t            (*p).length = 0;\n579\t            (*p).buffer = null_mut();\n580\t\n581\t            return null_mut();\n582\t        }\n583\t    } else {\n584\t        /* otherwise reallocate manually */\n585\t        newbuffer = hooks_allocate(&(*p).hooks, newsize) as *mut c_uchar;\n586\t        if newbuffer.is_null() {\n587\t            hooks_deallocate(&(*p).hooks, (*p).buffer as *mut c_void);\n588\t            (*p).length = 0;\n589\t            (*p).buffer = null_mut();\n590\t\n591\t            return null_mut();\n592\t        }\n593\t\n594\t        memcpy(\n595\t            newbuffer as *mut c_void,\n596\t            (*p).buffer as *const c_void,\n597\t            (*p).offset + 1,\n598\t        );\n599\t        hooks_deallocate(&(*p).hooks, (*p).buffer as *mut c_void);\n600\t    }\n601\t    (*p).length = newsize;\n602\t    (*p).buffer = newbuffer;\n603\t\n604\t    newbuffer.wrapping_add((*p).offset)\n605\t}\n606\t\n607\t/* calculate the new length of the string in a printbuffer and update the offset */\n608\tunsafe fn update_offset(buffer: *mut printbuffer) {\n609\t    let buffer_pointer: *const c_uchar;\n610\t    if buffer.is_null() || (*buffer).buffer.is_null() {\n611\t        return;\n612\t    }\n613\t    buffer_pointer = (*buffer).buffer.wrapping_add((*buffer).offset);\n614\t\n615\t    (*buffer).offset = (*buffer)\n616\t        .offset\n617\t        .wrapping_add(strlen(buffer_pointer as *const c_char));\n618\t}\n619\t\n620\t/* securely comparison of floating-point variables */\n621\tfn compare_double(a: f64, b: f64) -> cJSON_bool {\n622\t    let max_val = if a.abs() > b.abs() { a.abs() } else { b.abs() };\n623\t    if (a - b).abs() <= max_val * f64::EPSILON {\n624\t        TRUE\n625\t    } else {\n626\t        FALSE\n627\t    }\n628\t}\n629\t\n630\t/* Render the number nicely from the given item into a string. */\n631\tunsafe fn print_number(item: *const cJSON, output_buffer: *mut printbuffer) -> cJSON_bool {\n632\t    let output_pointer: *mut c_uchar;\n633\t    let d = (*item).valuedouble;\n634\t    let mut length: c_int;\n635\t    let mut i: usize = 0;\n636\t    let mut number_buffer: [c_uchar; 26] = [0; 26]; /* temporary buffer to print the number into */\n637\t    let decimal_point = get_decimal_point();\n638\t    let mut test: f64 = 0.0;\n639\t\n640\t    if output_buffer.is_null() {\n641\t        return FALSE;\n642\t    }\n643\t\n644\t    /* This checks for NaN and Infinity */\n645\t    if d.is_nan() || d.is_infinite() {\n646\t        length = snprintf(\n647\t            number_buffer.as_mut_ptr() as *mut c_char,\n648\t            26,\n649\t            c\"null\".as_ptr(),\n650\t        );\n651\t    } else if d == (*item).valueint as f64 {\n652\t        length = snprintf(\n653\t            number_buffer.as_mut_ptr() as *mut c_char,\n654\t            26,\n655\t            c\"%d\".as_ptr(),\n656\t            (*item).valueint,\n657\t        );\n658\t    } else {\n659\t        /* Try 15 decimal places of precision to avoid nonsignificant nonzero digits */\n660\t        length = snprintf(\n661\t            number_buffer.as_mut_ptr() as *mut c_char,\n662\t            26,\n663\t            c\"%1.15g\".as_ptr(),\n664\t            d,\n665\t        );\n666\t\n667\t        /* Check whether the original double can be recovered */\n668\t        if (sscanf(\n669\t            number_buffer.as_ptr() as *const c_char,\n670\t            c\"%lg\".as_ptr(),\n671\t            &mut test as *mut f64,\n672\t        ) != 1)\n673\t            || (compare_double(test, d) == FALSE)\n674\t        {\n675\t            /* If not, print with 17 decimal places of precision */\n676\t            length = snprintf(\n677\t                number_buffer.as_mut_ptr() as *mut c_char,\n678\t                26,\n679\t                c\"%1.17g\".as_ptr(),\n680\t                d,\n681\t            );\n682\t        }\n683\t    }\n684\t\n685\t    /* sprintf failed or buffer overrun occurred */\n686\t    if (length < 0) || (length > (core::mem::size_of_val(&number_buffer) - 1) as c_int) {\n687\t        return FALSE;\n688\t    }\n689\t\n690\t    /* reserve appropriate space in the output */\n691\t    output_pointer = ensure(output_buffer, length as usize + 1);\n692\t    if output_pointer.is_null() {\n693\t        return FALSE;\n694\t    }\n695\t\n696\t    /* copy the printed number to the output and replace locale\n697\t     * dependent decimal point with '.' */\n698\t    i = 0;\n699\t    while i < length as usize {\n700\t        if number_buffer[i] == decimal_point {\n701\t            *output_pointer.add(i) = b'.';\n702\t            i += 1;\n703\t            continue;\n704\t        }\n705\t\n706\t        *output_pointer.add(i) = number_buffer[i];\n707\t        i += 1;\n708\t    }\n709\t    *output_pointer.add(i) = b'\\0';\n710\t\n711\t    (*output_buffer).offset = (*output_buffer).offset.wrapping_add(length as usize);\n712\t\n713\t    TRUE\n714\t}\n715\t\n716\t/* parse 4 digit hexadecimal number */\n717\tunsafe fn parse_hex4(input: *const c_uchar) -> u32 {\n718\t    let mut h: u32 = 0;\n719\t    let mut i: usize = 0;\n720\t\n721\t    while i < 4 {\n722\t        let c = *input.add(i);\n723\t        /* parse digit */\n724\t        if (c >= b'0') && (c <= b'9') {\n725\t            h = h.wrapping_add((c as u32).wrapping_sub(b'0' as u32));\n726\t        } else if (c >= b'A') && (c <= b'F') {\n727\t            h = h.wrapping_add(10u32.wrapping_add(c as u32).wrapping_sub(b'A' as u32));\n728\t        } else if (c >= b'a') && (c <= b'f') {\n729\t            h = h.wrapping_add(10u32.wrapping_add(c as u32).wrapping_sub(b'a' as u32));\n730\t        } else {\n731\t            /* invalid */\n732\t            return 0;\n733\t        }\n734\t\n735\t        if i < 3 {\n736\t            /* shift left to make place for the next nibble */\n737\t            h <<= 4;\n738\t        }\n739\t\n740\t        i += 1;\n741\t    }\n742\t\n743\t    h\n744\t}\n745\t\n746\t/* converts a UTF-16 literal to UTF-8\n747\t * A literal can be one or two sequences of the form \\uXXXX */\n748\tunsafe fn utf16_literal_to_utf8(\n749\t    input_pointer: *const c_uchar,\n750\t    input_end: *const c_uchar,\n751\t    output_pointer: *mut *mut c_uchar,\n752\t) -> c_uchar {\n753\t    let mut codepoint: u64 = 0;\n754\t    let first_code: u32;\n755\t    let first_sequence: *const c_uchar = input_pointer;\n756\t    let utf8_length: c_uchar;\n757\t    let mut utf8_position: c_uchar;\n758\t    let sequence_length: c_uchar;\n759\t    let mut first_byte_mark: c_uchar = 0;\n760\t\n761\t    if (input_end as isize - first_sequence as isize) < 6 {\n762\t        /* input ends unexpectedly */\n763\t        return 0;\n764\t    }\n765\t\n766\t    /* get the first utf16 sequence */\n767\t    first_code = parse_hex4(first_sequence.add(2));\n768\t\n769\t    /* check that the code is valid */\n770\t    if (first_code >= 0xDC00) && (first_code <= 0xDFFF) {\n771\t        return 0;\n772\t    }\n773\t\n774\t    /* UTF16 surrogate pair */\n775\t    if (first_code >= 0xD800) && (first_code <= 0xDBFF) {\n776\t        let second_sequence: *const c_uchar = first_sequence.add(6);\n777\t        let second_code: u32;\n778\t        sequence_length = 12; /* \\uXXXX\\uXXXX */\n779\t\n780\t        if (input_end as isize - second_sequence as isize) < 6 {\n781\t            /* input ends unexpectedly */\n782\t            return 0;\n783\t        }\n784\t\n785\t        if (*second_sequence != b'\\\\') || (*second_sequence.add(1) != b'u') {\n786\t            /* missing second half of the surrogate pair */\n787\t            return 0;\n788\t        }\n789\t\n790\t        /* get the second utf16 sequence */\n791\t        second_code = parse_hex4(second_sequence.add(2));\n792\t        /* check that the code is valid */\n793\t        if (second_code < 0xDC00) || (second_code > 0xDFFF) {\n794\t            /* invalid second half of the surrogate pair */\n795\t            return 0;\n796\t        }\n797\t\n798\t        /* calculate the unicode codepoint from the surrogate pair */\n799\t        codepoint = 0x10000 + ((((first_code & 0x3FF) << 10) | (second_code & 0x3FF)) as u64);\n800\t    } else {\n801\t        sequence_length = 6; /* \\uXXXX */\n802\t        codepoint = first_code as u64;\n803\t    }\n804\t\n805\t    /* encode as UTF-8\n806\t     * takes at maximum 4 bytes to encode:\n807\t     * 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx */\n808\t    if codepoint < 0x80 {\n809\t        /* normal ascii, encoding 0xxxxxxx */\n810\t        utf8_length = 1;\n811\t    } else if codepoint < 0x800 {\n812\t        /* two bytes, encoding 110xxxxx 10xxxxxx */\n813\t        utf8_length = 2;\n814\t        first_byte_mark = 0xC0; /* 11000000 */\n815\t    } else if codepoint < 0x10000 {\n816\t        /* three bytes, encoding 1110xxxx 10xxxxxx 10xxxxxx */\n817\t        utf8_length = 3;\n818\t        first_byte_mark = 0xE0; /* 11100000 */\n819\t    } else if codepoint <= 0x10FFFF {\n820\t        /* four bytes, encoding 1110xxxx 10xxxxxx 10xxxxxx 10xxxxxx */\n821\t        utf8_length = 4;\n822\t        first_byte_mark = 0xF0; /* 11110000 */\n823\t    } else {\n824\t        /* invalid unicode codepoint */\n825\t        return 0;\n826\t    }\n827\t\n828\t    /* encode as utf8 */\n829\t    utf8_position = utf8_length.wrapping_sub(1);\n830\t    while utf8_position > 0 {\n831\t        /* 10xxxxxx */\n832\t        *(*output_pointer).add(utf8_position as usize) = ((codepoint | 0x80) & 0xBF) as c_uchar;\n833\t        codepoint >>= 6;\n834\t        utf8_position -= 1;\n835\t    }\n836\t    /* encode first byte */\n837\t    if utf8_length > 1 {\n838\t        *(*output_pointer) = ((codepoint | first_byte_mark as u64) & 0xFF) as c_uchar;\n839\t    } else {\n840\t        *(*output_pointer) = (codepoint & 0x7F) as c_uchar;\n841\t    }\n842\t\n843\t    *output_pointer = (*output_pointer).add(utf8_length as usize);\n844\t\n845\t    sequence_length\n846\t}\n847\t\n848\t/* Parse the input text into an unescaped cinput, and populate item. */\n849\tunsafe fn parse_string(item: *mut cJSON, input_buffer: *mut parse_buffer) -> cJSON_bool {\n850\t    let mut input_pointer: *const c_uchar = buffer_at_offset(input_buffer).wrapping_add(1);\n851\t    let mut input_end: *const c_uchar = buffer_at_offset(input_buffer).wrapping_add(1);\n852\t    let mut output_pointer: *mut c_uchar;\n853\t    let mut output: *mut c_uchar = null_mut();\n854\t\n855\t    'fail: {\n856\t        /* not a string */\n857\t        if *buffer_at_offset(input_buffer) != b'\\\"' {\n858\t            break 'fail;\n859\t        }\n860\t\n861\t        {\n862\t            /* calculate approximate size of the output (overestimate) */\n863\t            let allocation_length: usize;\n864\t            let mut skipped_bytes: usize