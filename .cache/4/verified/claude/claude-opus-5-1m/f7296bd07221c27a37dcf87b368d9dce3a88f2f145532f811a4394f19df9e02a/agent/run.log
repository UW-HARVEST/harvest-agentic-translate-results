eturn false;\n2979\t    }\n2980\t\n2981\t    return (item->type & 0xFF) == cJSON_Number;\n2982\t}\n2983\t\n2984\tCJSON_PUBLIC(cJSON_bool) cJSON_IsString(const cJSON * const item)\n2985\t{\n2986\t    if (item == NULL)\n2987\t    {\n2988\t        return false;\n2989\t    }\n2990\t\n2991\t    return (item->type & 0xFF) == cJSON_String;\n2992\t}\n2993\t\n2994\tCJSON_PUBLIC(cJSON_bool) cJSON_IsArray(const cJSON * const item)\n2995\t{\n2996\t    if (item == NULL)\n2997\t    {\n2998\t        return false;\n2999\t    }\n3000\t\n3001\t    return (item->type & 0xFF) == cJSON_Array;\n3002\t}\n3003\t\n3004\tCJSON_PUBLIC(cJSON_bool) cJSON_IsObject(const cJSON * const item)\n3005\t{\n3006\t    if (item == NULL)\n3007\t    {\n3008\t        return false;\n3009\t    }\n3010\t\n3011\t    return (item->type & 0xFF) == cJSON_Object;\n3012\t}\n3013\t\n3014\tCJSON_PUBLIC(cJSON_bool) cJSON_IsRaw(const cJSON * const item)\n3015\t{\n3016\t    if (item == NULL)\n3017\t    {\n3018\t        return false;\n3019\t    }\n3020\t\n3021\t    return (item->type & 0xFF) == cJSON_Raw;\n3022\t}\n3023\t\n3024\tCJSON_PUBLIC(cJSON_bool) cJSON_Compare(const cJSON * const a, const cJSON * const b, const cJSON_bool case_sensitive)\n3025\t{\n3026\t    if ((a == NULL) || (b == NULL) || ((a->type & 0xFF) != (b->type & 0xFF)))\n3027\t    {\n3028\t        return false;\n3029\t    }\n3030\t\n3031\t    /* check if type is valid */\n3032\t    switch (a->type & 0xFF)\n3033\t    {\n3034\t        case cJSON_False:\n3035\t        case cJSON_True:\n3036\t        case cJSON_NULL:\n3037\t        case cJSON_Number:\n3038\t        case cJSON_String:\n3039\t        case cJSON_Raw:\n3040\t        case cJSON_Array:\n3041\t        case cJSON_Object:\n3042\t            break;\n3043\t\n3044\t        default:\n3045\t            return false;\n3046\t    }\n3047\t\n3048\t    /* identical objects are equal */\n3049\t    if (a == b)\n3050\t    {\n3051\t        return true;\n3052\t    }\n3053\t\n3054\t    switch (a->type & 0xFF)\n3055\t    {\n3056\t        /* in these cases and equal type is enough */\n3057\t        case cJSON_False:\n3058\t        case cJSON_True:\n3059\t        case cJSON_NULL:\n3060\t            return true;\n3061\t\n3062\t        case cJSON_Number:\n3063\t            if (compare_double(a->valuedouble, b->valuedouble))\n3064\t            {\n3065\t                return true;\n3066\t            }\n3067\t            return false;\n3068\t\n3069\t        case cJSON_String:\n3070\t        case cJSON_Raw:\n3071\t            if ((a->valuestring == NULL) || (b->valuestring == NULL))\n3072\t            {\n3073\t                return false;\n3074\t            }\n3075\t            if (strcmp(a->valuestring, b->valuestring) == 0)\n3076\t            {\n3077\t                return true;\n3078\t            }\n3079\t\n3080\t            return false;\n3081\t\n3082\t        case cJSON_Array:\n3083\t        {\n3084\t            cJSON *a_element = a->child;\n3085\t            cJSON *b_element = b->child;\n3086\t\n3087\t            for (; (a_element != NULL) && (b_element != NULL);)\n3088\t            {\n3089\t                if (!cJSON_Compare(a_element, b_element, case_sensitive))\n3090\t                {\n3091\t                    return false;\n3092\t                }\n3093\t\n3094\t                a_element = a_element->next;\n3095\t                b_element = b_element->next;\n3096\t            }\n3097\t\n3098\t            /* one of the arrays is longer than the other */\n3099\t            if (a_element != b_element) {\n3100\t                return false;\n3101\t            }\n3102\t\n3103\t            return true;\n3104\t        }\n3105\t\n3106\t        case cJSON_Object:\n3107\t        {\n3108\t            cJSON *a_element = NULL;\n3109\t            cJSON *b_element = NULL;\n3110\t            cJSON_ArrayForEach(a_element, a)\n3111\t            {\n3112\t                /* TODO This has O(n^2) runtime, which is horrible! */\n3113\t                b_element = get_object_item(b, a_element->string, case_sensitive);\n3114\t                if (b_element == NULL)\n3115\t                {\n3116\t                    return false;\n3117\t                }\n3118\t\n3119\t                if (!cJSON_Compare(a_element, b_element, case_sensitive))\n3120\t                {\n3121\t                    return false;\n3122\t                }\n3123\t            }\n3124\t\n3125\t            /* doing this twice, once on a and b to prevent true comparison if a subset of b\n3126\t             * TODO: Do this the proper way, this is just a fix for now */\n3127\t            cJSON_ArrayForEach(b_element, b)\n3128\t            {\n3129\t                a_element = get_object_item(a, b_element->string, case_sensitive);\n3130\t                if (a_element == NULL)\n3131\t                {\n3132\t                    return false;\n3133\t                }\n3134\t\n3135\t                if (!cJSON_Compare(b_element, a_element, case_sensitive))\n3136\t                {\n3137\t                    return false;\n3138\t                }\n3139\t            }\n3140\t\n3141\t            return true;\n3142\t        }\n3143\t\n3144\t        default:\n3145\t            return false;\n3146\t    }\n3147\t}\n3148\t\n3149\tCJSON_PUBLIC(void *) cJSON_malloc(size_t size)\n3150\t{\n3151\t    return global_hooks.allocate(size);\n3152\t}\n3153\t\n3154\tCJSON_PUBLIC(void) cJSON_free(void *object)\n3155\t{\n3156\t    global_hooks.deallocate(object);\n3157\t    object = NULL;\n3158\t}\n3159\t"}]},"parent_tool_use_id":"toolu_bdrk_013AcLyvrPJ6FtmffU4vbBrs","session_id":"99d8c152-90eb-46f7-8482-a09fedc8e20a","uuid":"a0c2fce9-d0e6-4ed3-bbc1-b7d059937873","timestamp":"2026-08-20T07:18:16.414Z","subagent_type":"general-purpose","task_description":"Review C vs Rust part 2"}
