{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Rezk6g77z2jTfinCyYmeCW","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/` (tinyc2-style 2D collision\n2\t//! routines).\n3\t//!\n4\t//! The C build globs all of `c_src/` into a single shared library; every public\n5\t//! symbol exported by that `.so` is reproduced here with an identical name,\n6\t//! signature and ABI.\n7\t//!\n8\t//! Exported symbols (from `nm -D` on the C `.so`):\n9\t//!   c2V, c2Mulvs, c2Maxv, c2Minv, c2Clampv, c2Sub, c2Dot,\n10\t//!   c2CircletoCircle, c2CircletoAABB, c2CircletoCapsule,\n11\t//!   c2Collided, circle_collide\n12\t//!\n13\t//! Behaviour is reproduced exactly, including the original C code's quirks\n14\t//! (e.g. `c2Collided` always reinterpreting `A` as a `c2Circle` regardless of\n15\t//! any type tag, and the `?:`-based min/max NaN semantics).\n16\t\n17\t#![allow(non_snake_case)]\n18\t#![allow(non_camel_case_types)]\n19\t\n20\tuse std::ffi::c_int;\n21\tuse std::os::raw::c_void;\n22\t\n23\t// ---------------------------------------------------------------------------\n24\t// Types\n25\t// ---------------------------------------------------------------------------\n26\t\n27\t/// `typedef enum { C2_TYPE_CIRCLE, C2_TYPE_AABB, C2_TYPE_CAPSULE } C2_TYPE;`\n28\t///\n29\t/// A C enum whose values all fit in `int` is passed as `int` in the SysV ABI,\n30\t/// so the FFI boundary uses `c_int` and these constants are compared against\n31\t/// it.\n32\tpub const C2_TYPE_CIRCLE: c_int = 0;\n33\tpub const C2_TYPE_AABB: c_int = 1;\n34\tpub const C2_TYPE_CAPSULE: c_int = 2;\n35\t\n36\t/// `typedef struct c2v { float x; float y; } c2v;`\n37\t#[repr(C)]\n38\t#[derive(Clone, Copy, Debug, Default)]\n39\tpub struct c2v {\n40\t    pub x: f32,\n41\t    pub y: f32,\n42\t}\n43\t\n44\t/// `typedef struct c2Circle { c2v p; float r; } c2Circle;`\n45\t#[repr(C)]\n46\t#[derive(Clone, Copy, Debug, Default)]\n47\tpub struct c2Circle {\n48\t    pub p: c2v,\n49\t    pub r: f32,\n50\t}\n51\t\n52\t/// `typedef struct c2AABB { c2v min; c2v max; } c2AABB;`\n53\t#[repr(C)]\n54\t#[derive(Clone, Copy, Debug, Default)]\n55\tpub struct c2AABB {\n56\t    pub min: c2v,\n57\t    pub max: c2v,\n58\t}\n59\t\n60\t/// `typedef struct c2Capsule { c2v a; c2v b; float r; } c2Capsule;`\n61\t#[repr(C)]\n62\t#[derive(Clone, Copy, Debug, Default)]\n63\tpub struct c2Capsule {\n64\t    pub a: c2v,\n65\t    pub b: c2v,\n66\t    pub r: f32,\n67\t}\n68\t\n69\t// ---------------------------------------------------------------------------\n70\t// Vector helpers\n71\t// ---------------------------------------------------------------------------\n72\t\n73\t/// `c2v c2V(float x, float y)`\n74\t#[unsafe(no_mangle)]\n75\tpub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n76\t    let mut a = c2v::default();\n77\t    a.x = x;\n78\t    a.y = y;\n79\t    a\n80\t}\n81\t\n82\t/// `c2v c2Mulvs(c2v a, float b)`\n83\t#[unsafe(no_mangle)]\n84\tpub extern \"C\" fn c2Mulvs(a: c2v, b: f32) -> c2v {\n85\t    let mut a = a;\n86\t    a.x *= b;\n87\t    a.y *= b;\n88\t    a\n89\t}\n90\t\n91\t/// `c2v c2Maxv(c2v a, c2v b)`\n92\t///\n93\t/// The C code expands to `(a.x) > (b.x) ? (a.x) : (b.x)`, which selects `b`\n94\t/// whenever the comparison is false (including when either operand is NaN).\n95\t/// `f32::max` would instead ignore NaN, so the ternary is reproduced literally.\n96\t#[unsafe(no_mangle)]\n97\tpub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n98\t    c2V(\n99\t        if a.x > b.x { a.x } else { b.x },\n100\t        if a.y > b.y { a.y } else { b.y },\n101\t    )\n102\t}\n103\t\n104\t/// `c2v c2Minv(c2v a, c2v b)`\n105\t///\n106\t/// As with [`c2Maxv`], the `?:` selection semantics (including NaN behaviour)\n107\t/// are reproduced exactly rather than using `f32::min`.\n108\t#[unsafe(no_mangle)]\n109\tpub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n110\t    c2V(\n111\t        if a.x < b.x { a.x } else { b.x },\n112\t        if a.y < b.y { a.y } else { b.y },\n113\t    )\n114\t}\n115\t\n116\t/// `c2v c2Clampv(c2v a, c2v lo, c2v hi)`\n117\t#[unsafe(no_mangle)]\n118\tpub extern \"C\" fn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n119\t    c2Maxv(lo, c2Minv(a, hi))\n120\t}\n121\t\n122\t/// `c2v c2Sub(c2v a, c2v b)`\n123\t#[unsafe(no_mangle)]\n124\tpub extern \"C\" fn c2Sub(a: c2v, b: c2v) -> c2v {\n125\t    let mut a = a;\n126\t    a.x -= b.x;\n127\t    a.y -= b.y;\n128\t    a\n129\t}\n130\t\n131\t/// Quiets a NaN the way x86-64 SSE does: set the quiet bit, keep the sign and\n132\t/// the rest of the payload.\n133\t#[inline]\n134\tfn quiet_nan(v: f32) -> f32 {\n135\t    f32::from_bits(v.to_bits() | 0x0040_0000)\n136\t}\n137\t\n138\t/// A binary float op that reproduces the exact NaN payload the C build\n139\t/// propagates.\n140\t///\n141\t/// `mulss`/`addss` return the destination operand (quieted) when it is NaN, and\n142\t/// otherwise the source operand (quieted) — so the payload only depends on\n143\t/// operand ordering when *both* inputs are NaN. `keep_rhs` says which side the\n144\t/// C code's destination register held in that case, as measured against the\n145\t/// compiled C library. Every non-NaN input takes the plain arithmetic path, so\n146\t/// this is bit-identical to `lhs op rhs` for ordinary values.\n147\t#[inline]\n148\tfn nan_ordered(lhs: f32, rhs: f32, keep_rhs: bool, op: impl Fn(f32, f32) -> f32) -> f32 {\n149\t    if lhs.is_nan() && rhs.is_nan() {\n150\t        return quiet_nan(if keep_rhs { rhs } else { lhs });\n151\t    }\n152\t    op(lhs, rhs)\n153\t}\n154\t\n155\t/// `float c2Dot(c2v a, c2v b)`\n156\t///\n157\t/// The expression is `a.x * b.x + a.y * b.y`. For the products, the C code\n158\t/// keeps the left payload for the `x` term and the right payload for the `y`\n159\t/// term; the sum keeps the right (second product's) payload. Ordinary values\n160\t/// are unaffected by this bookkeeping.\n161\t#[unsafe(no_mangle)]\n162\tpub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n163\t    let px = nan_ordered(a.x, b.x, false, |l, r| l * r);\n164\t    let py = nan_ordered(a.y, b.y, true, |l, r| l * r);\n165\t    nan_ordered(px, py, true, |l, r| l + r)\n166\t}\n167\t\n168\t// ---------------------------------------------------------------------------\n169\t// Collision tests\n170\t// ---------------------------------------------------------------------------\n171\t\n172\t/// `int c2CircletoCircle(c2Circle A, c2Circle B)`\n173\t#[unsafe(no_mangle)]\n174\tpub extern \"C\" fn c2CircletoCircle(A: c2Circle, B: c2Circle) -> c_int {\n175\t    let c = c2Sub(B.p, A.p);\n176\t    let d2 = c2Dot(c, c);\n177\t    let mut r2 = A.r + B.r;\n178\t    r2 = r2 * r2;\n179\t    (d2 < r2) as c_int\n180\t}\n181\t\n182\t/// `int c2CircletoAABB(c2Circle A, c2AABB B)`\n183\t#[unsafe(no_mangle)]\n184\tpub extern \"C\" fn c2CircletoAABB(A: c2Circle, B: c2AABB) -> c_int {\n185\t    let L = c2Clampv(A.p, B.min, B.max);\n186\t    let ab = c2Sub(A.p, L);\n187\t    let d2 = c2Dot(ab, ab);\n188\t    let r2 = A.r * A.r;\n189\t    (d2 < r2) as c_int\n190\t}\n191\t\n192\t/// `int c2CircletoCapsule(c2Circle A, c2Capsule B)`\n193\t#[unsafe(no_mangle)]\n194\tpub extern \"C\" fn c2CircletoCapsule(A: c2Circle, B: c2Capsule) -> c_int {\n195\t    let n = c2Sub(B.b, B.a);\n196\t    let ap = c2Sub(A.p, B.a);\n197\t    let da = c2Dot(ap, n);\n198\t    let d2;\n199\t    if da < 0.0 {\n200\t        d2 = c2Dot(ap, ap);\n201\t    } else {\n202\t        let db = c2Dot(c2Sub(A.p, B.b), n);\n203\t        if db < 0.0 {\n204\t            let e = c2Sub(ap, c2Mulvs(n, da / c2Dot(n, n)));\n205\t            d2 = c2Dot(e, e);\n206\t        } else {\n207\t            let bp = c2Sub(A.p, B.b);\n208\t            d2 = c2Dot(bp, bp);\n209\t        }\n210\t    }\n211\t    let r = A.r + B.r;\n212\t    (d2 < r * r) as c_int\n213\t}\n214\t\n215\t/// `int c2Collided(const void *A, const void *B, C2_TYPE typeB)`\n216\t///\n217\t/// Note that, exactly as in the C original, `A` is always dereferenced as a\n218\t/// `c2Circle` — only `B` is dispatched on `typeB`. Unknown tags return 0.\n219\t///\n220\t/// # Safety\n221\t///\n222\t/// `A` and `B` must point to appropriately-sized, initialised objects\n223\t/// (`c2Circle` for `A`; the type selected by `typeB` for `B`), just as the C\n224\t/// function requires.\n225\t#[unsafe(no_mangle)]\n226\tpub unsafe extern \"C\" fn c2Collided(A: *const c_void, B: *const c_void, typeB: c_int) -> c_int {\n227\t    match typeB {\n228\t        C2_TYPE_CIRCLE => c2CircletoCircle(\n229\t            unsafe { *(A as *const c2Circle) },\n230\t            unsafe { *(B as *const c2Circle) },\n231\t        ),\n232\t        C2_TYPE_AABB => c2CircletoAABB(\n233\t            unsafe { *(A as *const c2Circle) },\n234\t            unsafe { *(B as *const c2AABB) },\n235\t        ),\n236\t        C2_TYPE_CAPSULE => c2CircletoCapsule(\n237\t            unsafe { *(A as *const c2Circle) },\n238\t            unsafe { *(B as *const c2Capsule) },\n239\t        ),\n240\t        _ => 0,\n241\t    }\n242\t}\n243\t\n244\t// ---------------------------------------------------------------------------\n245\t// Public entry point\n246\t// ---------------------------------------------------------------------------\n247\t\n248\t/// `int circle_collide(float x, float y, float r)`\n249\t///\n250\t/// Tests the given circle against a fixed circle, AABB and capsule, packing\n251\t/// the three results into bits 0, 1 and 2 of the return value.\n252\t#[unsafe(no_mangle)]\n253\tpub extern \"C\" fn circle_collide(x: f32, y: f32, r: f32) -> c_int {\n254\t    let mut result: c_int = 0;\n255\t\n256\t    let mut circle_in = c2Circle::default();\n257\t    circle_in.p = c2V(x, y);\n258\t    circle_in.r = r;\n259\t\n260\t    let mut circle = c2Circle::default();\n261\t    circle.p = c2V(-70.0f32, 0.0);\n262\t    circle.r = 20.0f32;\n263\t\n264\t    let mut aabb = c2AABB::default();\n265\t    aabb.min = c2V(-40.0f32, -40.0f32);\n266\t    aabb.max = c2V(-15.0f32, -15.0f32);\n267\t\n268\t    let mut capsule = c2Capsule::default();\n269\t    capsule.a = c2V(-40.0f32, 40.0f32);\n270\t    capsule.b = c2V(-20.0f32, 100.0f32);\n271\t    capsule.r = 10.0f32;\n272\t\n273\t    let circle_in_p = &circle_in as *const c2Circle as *const c_void;\n274\t\n275\t    result += unsafe {\n276\t        c2Collided(\n277\t            circle_in_p,\n278\t            &circle as *const c2Circle as *const c_void,\n279\t            C2_TYPE_CIRCLE,\n280\t        )\n281\t    };\n282\t\n283\t    result += unsafe {\n284\t        c2Collided(\n285\t            circle_in_p,\n286\t            &aabb as *const c2AABB as *const c_void,\n287\t            C2_TYPE_AABB,\n288\t        )\n289\t    } << 1;\n290\t\n291\t    result += unsafe {\n292\t        c2Collided(\n293\t            circle_in_p,\n294\t            &capsule as *const c2Capsule as *const c_void,\n295\t            C2_TYPE_CAPSULE,\n296\t        )\n297\t    } << 2;\n298\t\n299\t    result\n300\t}\n301\t"}]},"parent_tool_use_id":null,"session_id":"d235e1c2-2bf1-4dc7-9b50-d06c32800d87","uuid":"ab898cb1-71cc-47ef-bd82-91f0809c1941","timestamp":"2026-08-20T07:42:32.001Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-adnHUg/translated_rust/src/lib.rs","content":"//! Rust translation of the C library in `c_src/` (tinyc2-style 2D collision\n//! routines).\n//!\n//! The C build globs all of `c_src/` into a single shared library; every public\n//! symbol exported by that `.so` is reproduced here with an identical name,\n//! signature and ABI.\n//!\n//! Exported symbols (from `nm -D` on the C `.so`):\n//!   c2V, c2Mulvs, c2Maxv, c2Minv, c2Clampv, c2Sub, c2Dot,\n//!   c2CircletoCircle, c2CircletoAABB, c2CircletoCapsule,\n//!   c2Collided, circle_collide\n//!\n//! Behaviour is reproduced exactly, including the original C code's quirks\n//! (e.g. `c2Collided` always reinterpreting `A` as a `c2Circle` regardless of\n//! any type tag, and the `?:`-based min/max NaN semantics).\n\n#![allow(non_snake_case)]\n#![allow(non_camel_case_types)]\n\nuse std::ffi::c_int;\nuse std::os::raw::c_void;\n\n// ---------------------------------------------------------------------------\n// Types\n// ---------------------------------------------------------------------------\n\n/// `typedef enum { C2_TYPE_CIRCLE, C2_TYPE_AABB, C2_TYPE_CAPSULE } C2_TYPE;`\n///\n/// A C enum whose values all fit in `int` is passed as `int` in the SysV ABI,\n/// so the FFI boundary uses `c_int` and these constants are compared against\n/// it.\npub const C2_TYPE_CIRCLE: c_int = 0;\npub const C2_TYPE_AABB: c_int = 1;\npub const C2_TYPE_CAPSULE: c_int = 2;\n\n/// `typedef struct c2v { float x; float y; } c2v;`\n#[repr(C)]\n#[derive(Clone, Copy, Debug, Default)]\npub struct c2v {\n    pub x: f32,\n    pub y: f32,\n}\n\n/// `typedef struct c2Circle { c2v p; float r; } c2Circle;`\n#[repr(C)]\n#[derive(Clone, Copy, Debug, Default)]\npub struct c2Circle {\n    pub p: c2v,\n    pub r: f32,\n}\n\n/// `typedef struct c2AABB { c2v min; c2v max; } c2AABB;`\n#[repr(C)]\n#[derive(Clone, Copy, Debug, Default)]\npub struct c2AABB {\n    pub min: c2v,\n    pub max: c2v,\n}\n\n/// `typedef struct c2Capsule { c2v a; c2v b; float r; } c2Capsule;`\n#[repr(C)]\n#[derive(Clone, Copy, Debug, Default)]\npub struct c2Capsule {\n    pub a: c2v,\n    pub b: c2v,\n    pub r: f32,\n}\n\n// ---------------------------------------------------------------------------\n// Vector helpers\n// ---------------------------------------------------------------------------\n\n/// `c2v c2V(float x, float y)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n    let mut a = c2v::default();\n    a.x = x;\n    a.y = y;\n    a\n}\n\n/// `c2v c2Mulvs(c2v a, float b)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Mulvs(a: c2v, b: f32) -> c2v {\n    let mut a = a;\n    a.x *= b;\n    a.y *= b;\n    a\n}\n\n/// `c2v c2Maxv(c2v a, c2v b)`\n///\n/// The C code expands to `(a.x) > (b.x) ? (a.x) : (b.x)`, which selects `b`\n/// whenever the comparison is false (including when either operand is NaN).\n/// `f32::max` would instead ignore NaN, so the ternary is reproduced literally.\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n    c2V(\n        if a.x > b.x { a.x } else { b.x },\n        if a.y > b.y { a.y } else { b.y },\n    )\n}\n\n/// `c2v c2Minv(c2v a, c2v b)`\n///\n/// As with [`c2Maxv`], the `?:` selection semantics (including NaN behaviour)\n/// are reproduced exactly rather than using `f32::min`.\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n    c2V(\n        if a.x < b.x { a.x } else { b.x },\n        if a.y < b.y { a.y } else { b.y },\n    )\n}\n\n/// `c2v c2Clampv(c2v a, c2v lo, c2v hi)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n    c2Maxv(lo, c2Minv(a, hi))\n}\n\n/// `c2v c2Sub(c2v a, c2v b)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Sub(a: c2v, b: c2v) -> c2v {\n    let mut a = a;\n    a.x -= b.x;\n    a.y -= b.y;\n    a\n}\n\n/// Quiets a NaN the way x86-64 SSE does: set the quiet bit, keep the sign and\n/// the rest of the payload.\n#[inline]\nfn quiet_nan(v: f32) -> f32 {\n    f32::from_bits(v.to_bits() | 0x0040_0000)\n}\n\n/// A binary float op that reproduces the exact NaN payload the C build\n/// propagates.\n///\n/// `mulss`/`addss` return the destination operand (quieted) when it is NaN, and\n/// otherwise the source operand (quieted) — so the payload only depends on\n/// operand ordering when *both* inputs are NaN. `keep_rhs` says which side the\n/// C code's destination register held in that case, as measured against the\n/// compiled C library. Every non-NaN input takes the plain arithmetic path, so\n/// this is bit-identical to `lhs op rhs` for ordinary values.\n#[inline]\nfn nan_ordered(lhs: f32, rhs: f32, keep_rhs: bool, op: impl Fn(f32, f32) -> f32) -> f32 {\n    if lhs.is_nan() && rhs.is_nan() {\n        return quiet_nan(if keep_rhs { rhs } else { lhs });\n    }\n    op(lhs, rhs)\n}\n\n/// `float c2Dot(c2v a, c2v b)`\n///\n/// The expression is `a.x * b.x + a.y * b.y`. For the products, the C code\n/// keeps the left payload for the `x` term and the right payload for the `y`\n/// term; the sum keeps the right (second product's) payload. Ordinary values\n/// are unaffected by this bookkeeping.\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n    let px = nan_ordered(a.x, b.x, false, |l, r| l * r);\n    let py = nan_ordered(a.y, b.y, true, |l, r| l * r);\n    nan_ordered(px, py, true, |l, r| l + r)\n}\n\n// ---------------------------------------------------------------------------\n// Collision tests\n// ---------------------------------------------------------------------------\n\n/// `int c2CircletoCircle(c2Circle A, c2Circle B)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CircletoCircle(A: c2Circle, B: c2Circle) -> c_int {\n    let c = c2Sub(B.p, A.p);\n    let d2 = c2Dot(c, c);\n    let mut r2 = A.r + B.r;\n    r2 = r2 * r2;\n    (d2 < r2) as c_int\n}\n\n/// `int c2CircletoAABB(c2Circle A, c2AABB B)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CircletoAABB(A: c2Circle, B: c2AABB) -> c_int {\n    let L = c2Clampv(A.p, B.min, B.max);\n    let ab = c2Sub(A.p, L);\n    let d2 = c2Dot(ab, ab);\n    let r2 = A.r * A.r;\n    (d2 < r2) as c_int\n}\n\n/// `int c2CircletoCapsule(c2Circle A, c2Capsule B)`\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2CircletoCapsule(A: c2Circle, B: c2Capsule) -> c_int {\n    let n = c2Sub(B.b, B.a);\n    let ap = c2Sub(A.p, B.a);\n    let da = c2Dot(ap, n);\n    let d2;\n    if da < 0.0 {\n        d2 = c2Dot(ap, ap);\n    } else {\n        let db = c2Dot(c2Sub(A.p, B.b), n);\n        if db < 0.0 {\n            let e = c2Sub(ap, c2Mulvs(n, da / c2Dot(n, n)));\n            d2 = c2Dot(e, e);\n        } else {\n            let bp = c2Sub(A.p, B.b);\n            d2 = c2Dot(bp, bp);\n        }\n    }\n    let r = A.r + B.r;\n    (d2 < r * r) as c_int\n}\n\n/// `int c2Collided(const void *A, const void *B, C2_TYPE typeB)`\n///\n/// Note that, exactly as in the C original, `A` is always dereferenced as a\n/// `c2Circle` — only `B` is dispatched on `typeB`. Unknown tags return 0.\n///\n/// # Safety\n///\n/// `A` and `B` must point to appropriately-sized, initialised objects\n/// (`c2Circle` for `A`; the type selected by `typeB` for `B`), just as the C\n/// function requires.\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn c2Collided(A: *const c_void, B: *const c_void, typeB: c_int) -> c_int {\n    match typeB {\n        C2_TYPE_CIRCLE => c2CircletoCircle(\n            unsafe { *(A as *const c2Circle) },\n            unsafe { *(B as *const c2Circle) },\n        ),\n        C2_TYPE_AABB => c2CircletoAABB(\n            unsafe { *(A as *const c2Circle) },\n            unsafe { *(B as *const c2AABB) },\n        ),\n        C2_TYPE_CAPSULE => c2CircletoCapsule(\n            unsafe { *(A as *const c2Circle) },\n            unsafe { *(B as *const c2Capsule) },\n        ),\n        _ => 0,\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Public entry point\n// ---------------------------------------------------------------------------\n\n/// `int circle_collide(float x, float y, float r)`\n///\n/// Tests the given circle against a fixed circle, AABB and capsule, packing\n/// the three results into bits 0, 1 and 2 of the return value.\n#[unsafe(no_mangle)]\npub extern \"C\" fn circle_collide(x: f32, y: f32, r: f32) -> c_int {\n    let mut result: c_int = 0;\n\n    let mut circle_in = c2Circle::default();\n    circle_in.p = c2V(x, y);\n    circle_in.r = r;\n\n    let mut circle = c2Circle::default();\n    circle.p = c2V(-70.0f32, 0.0);\n    circle.r = 20.0f32;\n\n    let mut aabb = c2AABB::default();\n    aabb.min = c2V(-40.0f32, -40.0f32);\n    aabb.max = c2V(-15.0f32, -15.0f32);\n\n    let mut capsule = c2Capsule::default();\n    capsule.a = c2V(-40.0f32, 40.0f32);\n    capsule.b = c2V(-20.0f32, 100.0f32);\n    capsule.r = 10.0f32;\n\n    let circle_in_p = &circle_in as *const c2Circle as *const c_void;\n\n    result += unsafe {\n        c2Collided(\n            circle_in_p,\n            &circle as *const c2Circle as *const c_void,\n            C2_TYPE_CIRCLE,\n        )\n    };\n\n    result += unsafe {\n        c2Collided(\n            circle_in_p,\n            &aabb as *const c2AABB as *const c_void,\n            C2_TYPE_AABB,\n        )\n    } << 1;\n\n    result += unsafe {\n        c2Collided(\n            circle_in_p,\n            &capsule as *const c2Capsule as *const c_void,\n            C2_TYPE_CAPSULE,\n        )\n    } << 2;\n\n    result\n}\n","numLines":301,"startLine":1,"totalLines":301}}}
