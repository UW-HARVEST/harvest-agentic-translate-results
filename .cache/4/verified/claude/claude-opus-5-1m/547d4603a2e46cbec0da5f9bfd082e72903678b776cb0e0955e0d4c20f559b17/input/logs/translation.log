  };\n    /* fill placeholders with inf / nan combos */\n    fixed[14].v[0] = inf;\n    fixed[15].v[0] = nan; fixed[15].v[1] = 1.0f;\n    fixed[16].v[0] = inf; fixed[16].v[1] = -inf; fixed[16].v[2] = 1.0f;\n\n    int nfixed = (int)(sizeof(fixed)/sizeof(fixed[0]));\n    for (int k = 0; k < nfixed; k++) {\n        int n = fixed[k].n;\n        /* case A: separate dest, dest pre-filled with sentinel */\n        for (int i = 0; i < n; i++) src[i] = fixed[k].v[i];\n        for (int i = 0; i < MAXN; i++) dst[i] = -7.5f;\n        normalize(dst, src, n);\n        emit(o, dst, n + 2);   /* +2 to catch out-of-range writes */\n        /* case B: in-place (dest == src) */\n        for (int i = 0; i < n; i++) src[i] = fixed[k].v[i];\n        normalize(src, src, n);\n        emit(o, src, n);\n    }\n\n    /* dest == src with negative size (safe: memset branch skipped) */\n    for (int i = 0; i < 8; i++) src[i] = 0.0f;\n    normalize(src, src, -1);\n    emit(o, src, 8);\n    normalize(src, src, -12345);\n    emit(o, src, 8);\n\n    /* --- randomized vectors over many magnitudes and sizes --- */\n    for (int trial = 0; trial < 20000; trial++) {\n        int n = (int)(nxt() % 64) + 1;\n        int expo = (int)(nxt() % 80) - 40;   /* scale 1e-40 .. 1e39 */\n        for (int i = 0; i < n; i++) {\n            uint32_t r = nxt();\n            float m = (float)((double)r / 4294967296.0) * 2.0f - 1.0f;\n            src[i] = m * powf(10.0f, (float)expo);\n            if ((nxt() & 63) == 0) src[i] = 0.0f;\n        }\n        for (int i = 0; i < MAXN; i++) dst[i] = -7.5f;\n        normalize(dst, src, n);\n        emit(o, dst, n + 2);\n        normalize(src, src, n);   /* in-place */\n        emit(o, src, n);\n    }\n\n    /* --- large sizes to exercise any vectorized loops --- */\n    for (int trial = 0; trial < 200; trial++) {\n        int n = 1000 + (int)(nxt() % 3000);\n        for (int i = 0; i < n; i++) {\n            uint32_t r = nxt();\n            src[i] = (float)((double)r / 4294967296.0) - 0.5f;\n        }\n        for (int i = 0; i < MAXN; i++) dst[i] = -7.5f;\n        normalize(dst, src, n);\n        emit(o, dst, n);\n    }\n\n    /* --- raw-bitpattern fuzz (includes NaNs/infs/denormals) --- */\n    for (int trial = 0; trial < 20000; trial++) {\n        int n = (int)(nxt() % 16) + 1;\n        for (int i = 0; i < n; i++) {\n            uint32_t r = nxt() ^ (nxt() << 11);\n            memcpy(&src[i], &r, 4);\n        }\n        for (int i = 0; i < MAXN; i++) dst[i] = -7.5f;\n        normalize(dst, src, n);\n        emit(o, dst, n + 2);\n    }\n\n    fclose(o);\n    dlclose(h);\n    return 0;\n}\nEOF\ngcc -O2 -o $TMPDIR/diff/driver $TMPDIR/diff/driver.c -ldl -lm && echo \"driver built OK\"","description":"Build differential test driver"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":440,"cache_read_input_tokens":18271,"cache_creation":{"ephemeral_5m_input_tokens":440,"ephemeral_1h_input_tokens":0},"output_tokens":10,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"9ef0e340-86af-4252-8440-3404a5e176dd","uuid":"5d0a932d-8af7-40e0-a7e1-8723dd140928","timestamp":"2026-08-19T10:25:44.583Z"}
