{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Gwcfqf4xpaF5JEA4KAyNiE","type":"tool_result","content":"1\t/*\n2\t * Copyright 2025 MIT Lincoln Laboratory\n3\t * Permission is hereby granted, free of charge,\n4\t * to any person obtaining a copy of this software\n5\t * and associated documentation files (the \"Software\"),\n6\t * to deal in the Software without restriction,\n7\t * including without limitation the rights to use, copy,\n8\t * modify, merge, publish, distribute, sublicense,\n9\t * and/or sell copies of the Software,\n10\t * and to permit persons to whom the Software is furnished to do so,\n11\t * subject to the following conditions:\n12\t *\n13\t * The above copyright notice and this permission notice\n14\t * shall be included in all copies or substantial portions of the Software.\n15\t *\n16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n18\t * THE WARRANTIES OF MERCHANTABILITY,\n19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n24\t */\n25\t\n26\t//! Faithful Rust translation of the C \"command interpreter\" driver.\n27\t//!\n28\t//! The original C program keeps its state in fixed-size `char` arrays inside\n29\t//! plain C structs and copies into them with `strcpy`, which happily overruns\n30\t//! the individual members.  To reproduce the original byte-for-byte output --\n31\t//! including the overflow artifacts -- the global tables are modelled here as\n32\t//! flat byte buffers laid out exactly like the C structs.\n33\t\n34\tuse std::io::{BufRead, BufReader, Read, Write};\n35\t\n36\t// ---------------------------------------------------------------------------\n37\t// #define constants\n38\t// ---------------------------------------------------------------------------\n39\t\n40\tconst MAX_INPUT: usize = 256;\n41\tconst MAX_COMMAND: usize = 64;\n42\tconst MAX_ARGS: usize = 10;\n43\tconst MAX_FILES: usize = 20;\n44\tconst MAX_USERS: usize = 10;\n45\tconst MAX_VARIABLES: usize = 20;\n46\t\n47\t// ---------------------------------------------------------------------------\n48\t// struct layouts (x86-64 SysV, as produced by the reference compiler)\n49\t//\n50\t//   typedef struct { char name[32]; char password[32];\n51\t//                    int permission_level; int logged_in; } user_t;   // 72\n52\t//   typedef struct { char filename[64]; char content[512];\n53\t//                    char owner[32]; int permissions; } file_t;       // 612\n54\t//   typedef struct { char name[32]; char value[128]; } variable_t;    // 160\n55\t// ---------------------------------------------------------------------------\n56\t\n57\tconst USER_SIZE: usize = 72;\n58\tconst U_NAME: usize = 0;\n59\tconst U_PASSWORD: usize = 32;\n60\tconst U_PERM_LEVEL: usize = 64;\n61\tconst U_LOGGED_IN: usize = 68;\n62\t\n63\tconst FILE_SIZE: usize = 612;\n64\tconst F_FILENAME: usize = 0;\n65\tconst F_CONTENT: usize = 64;\n66\tconst F_OWNER: usize = 576;\n67\tconst F_PERMISSIONS: usize = 608;\n68\t\n69\tconst VAR_SIZE: usize = 160;\n70\tconst V_NAME: usize = 0;\n71\tconst V_VALUE: usize = 32;\n72\t\n73\t/// Extra slack so that `strcpy` overruns past the end of a table (which the C\n74\t/// program performs into whatever `.bss` object follows) never panic.\n75\tconst SLACK: usize = 512;\n76\t\n77\t// ---------------------------------------------------------------------------\n78\t// C string helpers operating on flat byte buffers\n79\t// ---------------------------------------------------------------------------\n80\t\n81\t/// `strcpy(buf + off, src)` -- writes `src` followed by a NUL terminator.\n82\tfn c_strcpy(buf: &mut [u8], off: usize, src: &[u8]) {\n83\t    let mut i = 0;\n84\t    while i < src.len() {\n85\t        if off + i >= buf.len() {\n86\t            return;\n87\t        }\n88\t        buf[off + i] = src[i];\n89\t        i += 1;\n90\t    }\n91\t    if off + i < buf.len() {\n92\t        buf[off + i] = 0;\n93\t    }\n94\t}\n95\t\n96\t/// Reads the NUL-terminated string that starts at `buf + off`.\n97\tfn c_str(buf: &[u8], off: usize) -> Vec<u8> {\n98\t    let mut out = Vec::new();\n99\t    let mut i = off;\n100\t    while i < buf.len() && buf[i] != 0 {\n101\t        out.push(buf[i]);\n102\t        i += 1;\n103\t    }\n104\t    out\n105\t}\n106\t\n107\t/// Reads a little-endian `int` from `buf + off`.\n108\tfn c_int(buf: &[u8], off: usize) -> i32 {\n109\t    let mut b = [0u8; 4];\n110\t    for k in 0..4 {\n111\t        if off + k < buf.len() {\n112\t            b[k] = buf[off + k];\n113\t        }\n114\t    }\n115\t    i32::from_le_bytes(b)\n116\t}\n117\t\n118\t/// Writes a little-endian `int` to `buf + off`.\n119\tfn c_set_int(buf: &mut [u8], off: usize, v: i32) {\n120\t    let b = v.to_le_bytes();\n121\t    for k in 0..4 {\n122\t        if off + k < buf.len() {\n123\t            buf[off + k] = b[k];\n124\t        }\n125\t    }\n126\t}\n127\t\n128\t/// Copies `len` raw bytes from `src_off` to `dst_off` (struct assignment).\n129\tfn c_struct_copy(buf: &mut [u8], dst_off: usize, src_off: usize, len: usize) {\n130\t    for k in 0..len {\n131\t        if dst_off + k < buf.len() && src_off + k < buf.len() {\n132\t            buf[dst_off + k] = buf[src_off + k];\n133\t        }\n134\t    }\n135\t}\n136\t\n137\t/// glibc `strcmp`: returns the difference of the first differing bytes,\n138\t/// interpreted as `unsigned char`.\n139\tfn c_strcmp(a: &[u8], b: &[u8]) -> i32 {\n140\t    let n = a.len().min(b.len());\n141\t    for i in 0..n {\n142\t        if a[i] != b[i] {\n143\t            return a[i] as i32 - b[i] as i32;\n144\t        }\n145\t    }\n146\t    if a.len() == b.len() {\n147\t        0\n148\t    } else if a.len() < b.len() {\n149\t        // a ran out: implicit NUL vs b[a.len()]\n150\t        -(b[a.len()] as i32)\n151\t    } else {\n152\t        a[b.len()] as i32\n153\t    }\n154\t}\n155\t\n156\t/// glibc `strncmp` with the same \"byte difference\" return convention.\n157\tfn c_strncmp(a: &[u8], b: &[u8], n: usize) -> i32 {\n158\t    let mut i: usize = 0;\n159\t    while i < n {\n160\t        let ca = if i < a.len() { a[i] } else { 0 };\n161\t        let cb = if i < b.len() { b[i] } else { 0 };\n162\t        if ca != cb {\n163\t            return ca as i32 - cb as i32;\n164\t        }\n165\t        if ca == 0 {\n166\t            return 0;\n167\t        }\n168\t        i += 1;\n169\t    }\n170\t    0\n171\t}\n172\t\n173\t/// `strstr(haystack, needle) != NULL`\n174\tfn c_strstr_found(haystack: &[u8], needle: &[u8]) -> bool {\n175\t    if needle.is_empty() {\n176\t        return true;\n177\t    }\n178\t    if needle.len() > haystack.len() {\n179\t        return false;\n180\t    }\n181\t    haystack\n182\t        .windows(needle.len())\n183\t        .any(|w| w == needle)\n184\t}\n185\t\n186\t/// glibc `atoi` == `(int)strtol(s, NULL, 10)`, including the LONG_MAX /\n187\t/// LONG_MIN saturation before the truncating cast to `int`.\n188\tfn c_atoi(s: &[u8]) -> i32 {\n189\t    let mut i = 0;\n190\t    while i < s.len() && matches!(s[i], b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r') {\n191\t        i += 1;\n192\t    }\n193\t    let mut negative = false;\n194\t    if i < s.len() && (s[i] == b'+' || s[i] == b'-') {\n195\t        negative = s[i] == b'-';\n196\t        i += 1;\n197\t    }\n198\t    let mut acc: u128 = 0;\n199\t    let mut overflow = false;\n200\t    let cutoff: u128 = if negative {\n201\t        1u128 << 63 // |LONG_MIN|\n202\t    } else {\n203\t        (1u128 << 63) - 1 // LONG_MAX\n204\t    };\n205\t    while i < s.len() && s[i].is_ascii_digit() {\n206\t        if !overflow {\n207\t            acc = acc * 10 + (s[i] - b'0') as u128;\n208\t            if acc > cutoff {\n209\t                overflow = true;\n210\t            }\n211\t        }\n212\t        i += 1;\n213\t    }\n214\t    let as_long: i64 = if overflow {\n215\t        if negative {\n216\t            i64::MIN\n217\t        } else {\n218\t            i64::MAX\n219\t        }\n220\t    } else if negative {\n221\t        (acc as i64).wrapping_neg()\n222\t    } else {\n223\t        acc as i64\n224\t    };\n225\t    as_long as i32\n226\t}\n227\t\n228\t// ---------------------------------------------------------------------------\n229\t// printf(\"%s\"/\"%d\") emulation over raw bytes\n230\t// ---------------------------------------------------------------------------\n231\t\n232\t#[derive(Clone, Copy)]\n233\tenum A<'a> {\n234\t    S(&'a [u8]),\n235\t    I(i32),\n236\t}\n237\t\n238\tfn cfmt(fmt: &str, args: &[A]) -> Vec<u8> {\n239\t    let f = fmt.as_bytes();\n240\t    let mut out: Vec<u8> = Vec::with_capacity(f.len() + 16);\n241\t    let mut ai = 0usize;\n242\t    let mut i = 0usize;\n243\t    while i < f.len() {\n244\t        if f[i] == b'%' && i + 1 < f.len() {\n245\t            match f[i + 1] {\n246\t                b's' => {\n247\t                    if let Some(A::S(s)) = args.get(ai) {\n248\t                        out.extend_from_slice(s);\n249\t                    }\n250\t                    ai += 1;\n251\t                    i += 2;\n252\t                }\n253\t                b'd' => {\n254\t                    if let Some(A::I(v)) = args.get(ai) {\n255\t                        out.extend_from_slice(v.to_string().as_bytes());\n256\t                    }\n257\t                    ai += 1;\n258\t                    i += 2;\n259\t                }\n260\t                b'%' => {\n261\t                    out.push(b'%');\n262\t                    i += 2;\n263\t                }\n264\t                _ => {\n265\t                    out.push(f[i]);\n266\t                    i += 1;\n267\t                }\n268\t            }\n269\t        } else {\n270\t            out.push(f[i]);\n271\t            i += 1;\n272\t        }\n273\t    }\n274\t    out\n275\t}\n276\t\n277\tmacro_rules! pf {\n278\t    ($st:expr, $fmt:expr) => {{\n279\t        $st.emit($fmt.as_bytes());\n280\t    }};\n281\t    ($st:expr, $fmt:expr, $($a:expr),+ $(,)?) => {{\n282\t        let __tmp = cfmt($fmt, &[$($a),+]);\n283\t        $st.emit(&__tmp);\n284\t    }};\n285\t}\n286\t\n287\t// ---------------------------------------------------------------------------\n288\t// Global state\n289\t// ---------------------------------------------------------------------------\n290\t\n291\tstruct State {\n292\t    users: Vec<u8>,\n293\t    user_count: usize,\n294\t    current_user: Option<usize>, // index into `users`\n295\t\n296\t    files: Vec<u8>,\n297\t    file_count: usize,\n298\t\n299\t    variables: Vec<u8>,\n300\t    variable_count: usize,\n301\t\n302\t    debug_mode: i32,\n303\t    verbose_mode: i32,\n304\t\n305\t    out: Vec<u8>,\n306\t}\n307\t\n308\timpl State {\n309\t    fn new() -> State {\n310\t        State {\n311\t            users: vec![0u8; MAX_USERS * USER_SIZE + SLACK],\n312\t            user_count: 0,\n313\t            current_user: None,\n314\t            files: vec![0u8; MAX_FILES * FILE_SIZE + SLACK],\n315\t            file_count: 0,\n316\t            variables: vec![0u8; MAX_VARIABLES * VAR_SIZE + SLACK],\n317\t            variable_count: 0,\n318\t            debug_mode: 0,\n319\t            verbose_mode: 0,\n320\t            out: Vec::with_capacity(1 << 16),\n321\t        }\n322\t    }\n323\t\n324\t    fn emit(&mut self, bytes: &[u8]) {\n325\t        self.out.extend_from_slice(bytes);\n326\t        if self.out.len() >= (1 << 16) {\n327\t            self.flush();\n328\t        }\n329\t    }\n330\t\n331\t    fn flush(&mut self) {\n332\t        if !self.out.is_empty() {\n333\t            let stdout = std::io::stdout();\n334\t            let mut lock = stdout.lock();\n335\t            let _ = lock.write_all(&self.out);\n336\t            let _ = lock.flush();\n337\t            self.out.clear();\n338\t        }\n339\t    }\n340\t\n341\t    // --- accessors -------------------------------------------------------\n342\t\n343\t    fn user_name(&self, i: usize) -> Vec<u8> {\n344\t        c_str(&self.users, i * USER_SIZE + U_NAME)\n345\t    }\n346\t    fn user_password(&self, i: usize) -> Vec<u8> {\n347\t        c_str(&self.users, i * USER_SIZE + U_PASSWORD)\n348\t    }\n349\t    fn user_perm(&self, i: usize) -> i32 {\n350\t        c_int(&self.users, i * USER_SIZE + U_PERM_LEVEL)\n351\t    }\n352\t    fn user_logged_in(&self, i: usize) -> i32 {\n353\t        c_int(&self.users, i * USER_SIZE + U_LOGGED_IN)\n354\t    }\n355\t\n356\t    fn file_name(&self, i: usize) -> Vec<u8> {\n357\t        c_str(&self.files, i * FILE_SIZE + F_FILENAME)\n358\t    }\n359\t    fn file_content(&self, i: usize) -> Vec<u8> {\n360\t        c_str(&self.files, i * FILE_SIZE + F_CONTENT)\n361\t    }\n362\t    fn file_owner(&self, i: usize) -> Vec<u8> {\n363\t        c_str(&self.files, i * FILE_SIZE + F_OWNER)\n364\t    }\n365\t    fn file_perm(&self, i: usize) -> i32 {\n366\t        c_int(&self.files, i * FILE_SIZE + F_PERMISSIONS)\n367\t    }\n368\t\n369\t    fn var_name(&self, i: usize) -> Vec<u8> {\n370\t        c_str(&self.variables, i * VAR_SIZE + V_NAME)\n371\t    }\n372\t    fn var_value(&self, i: usize) -> Vec<u8> {\n373\t        c_str(&self.variables, i * VAR_SIZE + V_VALUE)\n374\t    }\n375\t\n376\t    /// `current_user && current_user->logged_in`\n377\t    fn logged_in_user(&self) -> Option<usize> {\n378\t        match self.current_user {\n379\t            Some(i) if self.user_logged_in(i) != 0 => Some(i),\n380\t            _ => None,\n381\t        }\n382\t    }\n383\t\n384\t    // --- user management -------------------------------------------------\n385\t\n386\t    fn cmd_adduser(&mut self, args: &[Vec<u8>], arg_count: usize) {\n387\t        if arg_count < 2 {\n388\t            pf!(self, \"Usage: adduser <username> <password> [permission_level]\\n\");\n389\t            return;\n390\t        }\n391\t\n392\t        if self.user_count >= MAX_USERS {\n393\t            pf!(self, \"Error: Maximum users reached\\n\");\n394\t            return;\n395\t        }\n396\t\n397\t        for i in 0..self.user_count {\n398\t            if c_strcmp(&self.user_name(i), &args[0]) == 0 {\n399\t                pf!(self, \"Error: User '%s' already exists\\n\", A::S(&args[0]));\n400\t                return;\n401\t            }\n402\t        }\n403\t\n404\t        let base = self.user_count * USER_SIZE;\n405\t        c_strcpy(&mut self.users, base + U_NAME, &args[0]);\n406\t        c_strcpy(&mut self.users, base + U_PASSWORD, &args[1]);\n407\t        let level = if arg_count >= 3 { c_atoi(&args[2]) } else { 1 };\n408\t        c_set_int(&mut self.users, base + U_PERM_LEVEL, level);\n409\t        c_set_int(&mut self.users, base + U_LOGGED_IN, 0);\n410\t        self.user_count += 1;\n411\t\n412\t        let shown = self.user_perm(self.user_count - 1);\n413\t        pf!(\n414\t            self,\n415\t            \"User '%s' added with permission level %d\\n\",\n416\t            A::S(&args[0]),\n417\t            A::I(shown)\n418\t        );\n419\t    }\n420\t\n421\t    fn cmd_login(&mut self, args: &[Vec<u8>], arg_count: usize) {\n422\t        if arg_count < 2 {\n423\t            pf!(self, \"Usage: login <username> <password>\\n\");\n424\t            return;\n425\t        }\n426\t\n427\t        if let Some(cu) = self.logged_in_user() {\n428\t            let name = self.user_name(cu);\n429\t            pf!(\n430\t                self,\n431\t                \"Error: User '%s' already logged in. Use 'logout' first.\\n\",\n432\t                A::S(&name)\n433\t            );\n434\t            return;\n435\t        }\n436\t\n437\t        for i in 0..self.user_count {\n438\t            if c_strcmp(&self.user_name(i), &args[0]) == 0 {\n439\t                if c_strcmp(&self.user_password(i), &args[1]) == 0 {\n440\t                    c_set_int(&mut self.users, i * USER_SIZE + U_LOGGED_IN, 1);\n441\t                    self.current_user = Some(i);\n442\t                    let name = self.user_name(i);\n443\t                    pf!(self, \"Login successful. Welcome, %s!\\n\", A::S(&name));\n444\t                    return;\n445\t                } else {\n446\t                    pf!(self, \"Error: Incorrect password\\n\");\n447\t                    return;\n448\t                }\n449\t            }\n450\t        }\n451\t\n452\t        pf!(self, \"Error: User not found\\n\");\n453\t    }\n454\t\n455\t    fn cmd_logout(&mut self) {\n456\t        let cu = match self.logged_in_user() {\n457\t            Some(i) => i,\n458\t            None => {\n459\t                pf!(self, \"Error: No user logged in\\n\");\n460\t                return;\n461\t            }\n462\t        };\n463\t\n464\t        let name = self.user_name(cu);\n465\t        pf!(self, \"Goodbye, %s!\\n\", A::S(&name));\n466\t        c_set_int(&mut self.users, cu * USER_SIZE + U_LOGGED_IN, 0);\n467\t        self.current_user = None;\n468\t    }\n469\t\n470\t    fn cmd_whoami(&mut self) {\n471\t        let cu = match self.logged_in_user() {\n472\t            Some(i) => i,\n473\t            None => {\n474\t                pf!(self, \"Not logged in\\n\");\n475\t                return;\n476\t            }\n477\t        };\n478\t\n479\t        let name = self.user_name(cu);\n480\t        let perm = self.user_perm(cu);\n481\t        pf!(self, \"Current user: %s\\n\", A::S(&name));\n482\t        pf!(self, \"Permission level: %d\\n\", A::I(perm));\n483\t    }\n484\t\n485\t    fn cmd_listusers(&mut self) {\n486\t        if self.user_count == 0 {\n487\t            pf!(self, \"No users registered\\n\");\n488\t            return;\n489\t        }\n490\t\n491\t        pf!(self, \"Registered users:\\n\");\n492\t        for i in 0..self.user_count {\n493\t            let name = self.user_name(i);\n494\t            let perm = self.user_perm(i);\n495\t            let flag: &[u8] = if self.user_logged_in(i) != 0 {\n496\t                b\"[logged in]\"\n497\t            } else {\n498\t                b\"\"\n499\t            };\n500\t            pf!(\n501\t                self,\n502\t                \"  %s (level %d) %s\\n\",\n503\t                A::S(&name),\n504\t                A::I(perm),\n505\t                A::S(flag)\n506\t            );\n507\t        }\n508\t    }\n509\t\n510\t    // --- file management -------------------------------------------------\n511\t\n512\t    fn cmd_createfile(&mut self, args: &[Vec<u8>], arg_count: usize) {\n513\t        let cu = match self.logged_in_user() {\n514\t            Some(i) => i,\n515\t            None => {\n516\t                pf!(self, \"Error: Must be logged in\\n\");\n517\t                return;\n518\t            }\n519\t        };\n520\t\n521\t        if arg_count < 1 {\n522\t            pf!(self, \"Usage: createfile <filename> [content]\\n\");\n523\t            return;\n524\t        }\n525\t\n526\t        if self.file_count >= MAX_FILES {\n527\t            pf!(self, \"Error: Maximum files reached\\n\");\n528\t            return;\n529\t        }\n530\t\n531\t        for i in 0..self.file_count {\n532\t            if c_strcmp(&self.file_name(i), &args[0]) == 0 {\n533\t                pf!(self, \"Error: File '%s' already exists\\n\", A::S(&args[0]));\n534\t                return;\n535\t            }\n536\t        }\n537\t\n538\t        let base = self.file_count * FILE_SIZE;\n539\t        let owner = self.user_name(cu);\n540\t        c_strcpy(&mut self.files, base + F_FILENAME, &args[0]);\n541\t        c_strcpy(&mut self.files, base + F_OWNER, &owner);\n542\t        c_set_int(&mut self.files, base + F_PERMISSIONS, 755);\n543\t\n544\t        if arg_count >= 2 {\n545\t            c_strcpy(&mut self.files, base + F_CONTENT, &args[1]);\n546\t        } else if base + F_CONTENT < self.files.len() {\n547\t            self.files[base + F_CONTENT] = 0;\n548\t        }\n549\t\n550\t        self.file_count += 1;\n551\t        pf!(self, \"File '%s' created\\n\", A::S(&args[0]));\n552\t    }\n553\t\n554\t    fn cmd_readfile(&mut self, args: &[Vec<u8>], arg_count: usize) {\n555\t        if arg_count < 1 {\n556\t            pf!(self, \"Usage: readfile <filename>\\n\");\n557\t            return;\n558\t        }\n559\t\n560\t        for i in 0..self.file_count {\n561\t            if c_strcmp(&self.file_name(i), &args[0]) == 0 {\n562\t                let name = self.file_name(i);\n563\t                let owner = self.file_owner(i);\n564\t                let perm = self.file_perm(i);\n565\t                let content = self.file_content(i);\n566\t                pf!(self, \"=== %s ===\\n\", A::S(&name));\n567\t                pf!(self, \"Owner: %s\\n\", A::S(&owner));\n568\t                pf!(self, \"Permissions: %d\\n\", A::I(perm));\n569\t                pf!(self, \"Content: %s\\n\", A::S(&content));\n570\t                return;\n571\t            }\n572\t        }\n573\t\n574\t        pf!(self, \"Error: File '%s' not found\\n\", A::S(&args[0]));\n575\t    }\n576\t\n577\t    fn cmd_writefile(&mut self, args: &[Vec<u8>], arg_count: usize) {\n578\t        let cu = match self.logged_in_user() {\n579\t            Some(i) => i,\n580\t            None => {\n581\t                pf!(self, \"Error: Must be logged in\\n\");\n582\t                return;\n583\t            }\n584\t        };\n585\t\n586\t        if arg_count < 2 {\n587\t            pf!(self, \"Usage: writefile <filename> <content>\\n\");\n588\t            return;\n589\t        }\n590\t\n591\t        for i in 0..self.file_count {\n592\t            if c_strcmp(&self.file_name(i), &args[0]) == 0 {\n593\t                let cu_name = self.user_name(cu);\n594\t                if c_strcmp(&self.file_owner(i), &cu_name) == 0 || self.user_perm(cu) >= 5 {\n595\t                    c_strcpy(&mut self.files, i * FILE_SIZE + F_CONTENT, &args[1]);\n596\t                    pf!(self, \"File '%s' updated\\n\", A::S(&args[0]));\n597\t                    return;\n598\t                } else {\n599\t                    pf!(self, \"Error: Permission denied\\n\");\n600\t                    return;\n601\t                }\n602\t            }\n603\t        }\n604\t\n605\t        pf!(self, \"Error: File '%s' not found\\n\", A::S(&args[0]));\n606\t    }\n607\t\n608\t    fn cmd_deletefile(&mut self, args: &[Vec<u8>], arg_count: usize) {\n609\t        let cu = match self.logged_in_user() {\n610\t            Some(i) => i,\n611\t            None => {\n612\t                pf!(self, \"Error: Must be logged in\\n\");\n613\t                return;\n614\t            }\n615\t        };\n616\t\n617\t        if arg_count < 1 {\n618\t            pf!(self, \"Usage: deletefile <filename>\\n\");\n619\t            return;\n620\t        }\n621\t\n622\t        for i in 0..self.file_count {\n623\t            if c_strcmp(&self.file_name(i), &args[0]) == 0 {\n624\t                let cu_name = self.user_name(cu);\n625\t                if c_strcmp(&self.file_owner(i), &cu_name) == 0 || self.user_perm(cu) >= 9 {\n626\t                    for j in i..self.file_count - 1 {\n627\t                        c_struct_copy(\n628\t                            &mut self.files,\n629\t                            j * FILE_SIZE,\n630\t                            (j + 1) * FILE_SIZE,\n631\t                            FILE_SIZE,\n632\t                        );\n633\t                    }\n634\t                    self.file_count -= 1;\n635\t                    pf!(self, \"File '%s' deleted\\n\", A::S(&args[0]));\n636\t                    return;\n637\t                } else {\n638\t                    pf!(self, \"Error: Permission denied\\n\");\n639\t                    return;\n640\t                }\n641\t            }\n642\t        }\n643\t\n644\t        pf!(self, \"Error: File '%s' not found\\n\", A::S(&args[0]));\n645\t    }\n646\t\n647\t    fn cmd_listfiles(&mut self) {\n648\t        if self.file_count == 0 {\n649\t            pf!(self, \"No files\\n\");\n650\t            return;\n651\t        }\n652\t\n653\t        pf!(self, \"Files:\\n\");\n654\t        for i in 0..self.file_count {\n655\t            let name = self.file_name(i);\n656\t            let owner = self.file_owner(i);\n657\t            let perm = self.file_perm(i);\n658\t            pf!(\n659\t                self,\n660\t                \"  %s (owner: %s, perm: %d)\\n\",\n661\t                A::S(&name),\n662\t                A::S(&owner),\n663\t                A::I(perm)\n664\t            );\n665\t        }\n666\t    }\n667\t\n668\t    // --- variables -------------------------------------------------------\n669\t\n670\t    fn cmd_set(&mut self, args: &[Vec<u8>], arg_count: usize) {\n671\t        if arg_count < 2 {\n672\t            pf!(self, \"Usage: set <name> <value>\\n\");\n673\t            return;\n674\t        }\n675\t\n676\t        for i in 0..self.variable_count {\n677\t            if c_strcmp(&self.var_name(i), &args[0]) == 0 {\n678\t                c_strcpy(&mut self.variables, i * VAR_SIZE + V_VALUE, &args[1]);\n679\t                pf!(self, \"Variable '%s' updated\\n\", A::S(&args[0]));\n680\t                return;\n681\t            }\n682\t        }\n683\t\n684\t        if self.variable_count >= MAX_VARIABLES {\n685\t            pf!(self, \"Error: Maximum variables reached\\n\");\n686\t            return;\n687\t        }\n688\t\n689\t        let base = self.variable_count * VAR_SIZE;\n690\t        c_strcpy(&mut self.variables, base + V_NAME, &args[0]);\n691\t        c_strcpy(&mut self.variables, base + V_VALUE, &args[1]);\n692\t        self.variable_count += 1;\n693\t        pf!(self, \"Variable '%s' set\\n\", A::S(&args[0]));\n694\t    }\n695\t\n696\t    fn cmd_get(&mut self, args: &[Vec<u8>], arg_count: usize) {\n697\t        if arg_count < 1 {\n698\t            pf!(self, \"Usage: get <name>\\n\");\n699\t            return;\n700\t        }\n701\t\n702\t        for i in 0..self.variable_count {\n703\t            if c_strcmp(&self.var_name(i), &args[0]) == 0 {\n704\t                let name = self.var_name(i);\n705\t                let value = self.var_value(i);\n706\t                pf!(self, \"%s = %s\\n\", A::S(&name), A::S(&value));\n707\t                return;\n708\t            }\n709\t        }\n710\t\n711\t        pf!(self, \"Error: Variable '%s' not found\\n\", A::S(&args[0]));\n712\t    }\n713\t\n714\t    fn cmd_unset(&mut self, args: &[Vec<u8>], arg_count: usize) {\n715\t        if arg_count < 1 {\n716\t            pf!(self, \"Usage: unset <name>\\n\");\n717\t            return;\n718\t        }\n719\t\n720\t        for i in 0..self.variable_count {\n721\t            if c_strcmp(&self.var_name(i), &args[0]) == 0 {\n722\t                for j in i..self.variable_count - 1 {\n723\t                    c_struct_copy(\n724\t                        &mut self.variables,\n725\t                        j * VAR_SIZE,\n726\t                        (j + 1) * VAR_SIZE,\n727\t                        VAR_SIZE,\n728\t                    );\n729\t                }\n730\t                self.variable_count -= 1;\n731\t                pf!(self, \"Variable '%s' unset\\n\", A::S(&args[0]));\n732\t                return;\n733\t            }\n734\t        }\n735\t\n736\t        pf!(self, \"Error: Variable '%s' not found\\n\", A::S(&args[0]));\n737\t    }\n738\t\n739\t    fn cmd_listvars(&mut self) {\n740\t        if self.variable_count == 0 {\n741\t            pf!(self, \"No variables set\\n\");\n742\t            return;\n743\t        }\n744\t\n745\t        pf!(self, \"Variables:\\n\");\n746\t        for i in 0..self.variable_count {\n747\t            let name = self.var_name(i);\n748\t            let value = self.var_value(i);\n749\t            pf!(self, \"  %s = %s\\n\", A::S(&name), A::S(&value));\n750\t        }\n751\t    }\n752\t\n753\t    // --- string comparison ----------------------------------------------\n754\t\n755\t    fn cmd_compare(&mut self, args: &[Vec<u8>], arg_count: usize) {\n756\t        if arg_count < 2 {\n757\t            pf!(self, \"Usage: compare <string1> <string2>\\n\");\n758\t            return;\n759\t        }\n760\t\n761\t        let result = c_strcmp(&args[0], &args[1]);\n762\t\n763\t        pf!(\n764\t            self,\n765\t            \"strcmp('%s', '%s') = %d\\n\",\n766\t            A::S(&args[0]),\n767\t            A::S(&args[1]),\n768\t            A::I(result)\n769\t        );\n770\t\n771\t        if result == 0 {\n772\t            pf!(self, \"Strings are equal\\n\");\n773\t        } else if result < 0 {\n774\t            pf!(self, \"'%s' < '%s'\\n\", A::S(&args[0]), A::S(&args[1]));\n775\t        } else {\n776\t            pf!(self, \"'%s' > '%s'\\n\", A::S(&args[0]), A::S(&args[1]));\n777\t        }\n778\t    }\n779\t\n780\t    fn cmd_compare_n(&mut self, args: &[Vec<u8>], arg_count: usize) {\n781\t        if arg_count < 3 {\n782\t            pf!(self, \"Usage: compareN <string1> <string2> <n>\\n\");\n783\t            return;\n784\t        }\n785\t\n786\t        let n = c_atoi(&args[2]);\n787\t        // `int` -> `size_t` conversion (sign extension on LP64).\n788\t        let result = c_strncmp(&args[0], &args[1], n as isize as usize);\n789\t\n790\t        pf!(\n791\t            self,\n792\t            \"strncmp('%s', '%s', %d) = %d\\n\",\n793\t            A::S(&args[0]),\n794\t            A::S(&args[1]),\n795\t            A::I(n),\n796\t            A::I(result)\n797\t        );\n798\t\n799\t        if result == 0 {\n800\t            pf!(self, \"First %d characters are equal\\n\", A::I(n));\n801\t        } else if result < 0 {\n802\t            pf!(\n803\t                self,\n804\t                \"'%s' < '%s' (first %d chars)\\n\",\n805\t                A::S(&args[0]),\n806\t                A::S(&args[1]),\n807\t                A::I(n)\n808\t            );\n809\t        } else {\n810\t            pf!(\n811\t                self,\n812\t                \"'%s' > '%s' (first %d chars)\\n\",\n813\t                A::S(&args[0]),\n814\t                A::S(&args[1]),\n815\t                A::I(n)\n816\t            );\n817\t        }\n818\t    }\n819\t\n820\t    fn cmd_startswith(&mut self, args: &[Vec<u8>], arg_count: usize) {\n821\t        if arg_count < 2 {\n822\t            pf!(self, \"Usage: startswith <string> <prefix>\\n\");\n823\t            return;\n824\t        }\n825\t\n826\t        let prefix_len = args[1].len();\n827\t\n828\t        if c_strncmp(&args[0], &args[1], prefix_len) == 0 {\n829\t            pf!(\n830\t                self,\n831\t                \"'%s' starts with '%s'\\n\",\n832\t                A::S(&args[0]),\n833\t                A::S(&args[1])\n834\t            );\n835\t        } else {\n836\t            pf!(\n837\t                self,\n838\t                \"'%s' does not start with '%s'\\n\",\n839\t                A::S(&args[0]),\n840\t                A::S(&args[1])\n841\t            );\n842\t        }\n843\t    }\n844\t\n845\t    fn cmd_match(&mut self, args: &[Vec<u8>], arg_count: usize) {\n846\t        if arg_count < 2 {\n847\t            pf!(self, \"Usage: match <pattern> <string1> [string2] ...\\n\");\n848\t            return;\n849\t        }\n850\t\n851\t        pf!(self, \"Matching pattern '%s':\\n\", A::S(&args[0]));\n852\t        let mut matches = 0i32;\n853\t\n854\t        for i in 1..arg_count {\n855\t            if c_strcmp(&args[0], &args[i]) == 0 {\n856\t                pf!(self, \"  '%s' - EXACT MATCH\\n\", A::S(&args[i]));\n857\t                matches += 1;\n858\t            } else if c_strstr_found(&args[i], &args[0]) {\n859\t                pf!(self, \"  '%s' - contains pattern\\n\", A::S(&args[i]));\n860\t                matches += 1;\n861\t            } else {\n862\t                pf!(self, \"  '%s' - no match\\n\", A::S(&args[i]));\n863\t            }\n864\t        }\n865\t\n866\t        pf!(self, \"Total matches: %d\\n\", A::I(matches));\n867\t    }\n868\t\n869\t    // --- system ----------------------------------------------------------\n870\t\n871\t    fn cmd_help(&mut self) {\n872\t        pf!(self, \"\\n=== Command Interpreter Help ===\\n\");\n873\t        pf!(self, \"User Management:\\n\");\n874\t        pf!(self, \"  adduser <user> <pass> [level] - Add new user\\n\");\n875\t        pf!(self, \"  login <user> <pass>            - Login as user\\n\");\n876\t        pf!(self, \"  logout                         - Logout current user\\n\");\n877\t        pf!(self, \"  whoami                         - Show current user\\n\");\n878\t        pf!(self, \"  listusers                      - List all users\\n\");\n879\t        pf!(self, \"\\nFile Management:\\n\");\n880\t        pf!(self, \"  createfile <name> [content]    - Create file\\n\");\n881\t        pf!(self, \"  readfile <name>                - Read file\\n\");\n882\t        pf!(self, \"  writefile <name> <content>     - Write to file\\n\");\n883\t        pf!(self, \"  deletefile <name>              - Delete file\\n\");\n884\t        pf!(self, \"  listfiles                      - List all files\\n\");\n885\t        pf!(self, \"\\nVariable Management:\\n\");\n886\t        pf!(self, \"  set <name> <value>             - Set variable\\n\");\n887\t        pf!(self, \"  get <name>                     - Get variable\\n\");\n888\t        pf!(self, \"  unset <name>                   - Unset variable\\n\");\n889\t        pf!(self, \"  listvars                       - List all variables\\n\");\n890\t        pf!(self, \"\\nString Operations:\\n\");\n891\t        pf!(self, \"  compare <str1> <str2>          - Compare strings\\n\");\n892\t        pf!(self, \"  compareN <str1> <str2> <n>     - Compare first N chars\\n\");\n893\t        pf!(self, \"  startswith <str> <prefix>      - Check if starts with\\n\");\n894\t        pf!(self, \"  match <pattern> <str> ...      - Match pattern\\n\");\n895\t        pf!(self, \"\\nSystem:\\n\");\n896\t        pf!(self, \"  debug [on|off]                 - Toggle debug mode\\n\");\n897\t        pf!(self, \"  verbose [on|off]               - Toggle verbose mode\\n\");\n898\t        pf!(self, \"  status                         - Show system status\\n\");\n899\t        pf!(self, \"  time                           - Show current time\\n\");\n900\t        pf!(self, \"  help                           - Show this help\\n\");\n901\t        pf!(self, \"  exit                           - Exit program\\n\");\n902\t    }\n903\t\n904\t    fn cmd_debug(&mut self, args: &[Vec<u8>], arg_count: usize) {\n905\t        if arg_count < 1 {\n906\t            let s: &[u8] = if self.debug_mode != 0 { b\"ON\" } else { b\"OFF\" };\n907\t            pf!(self, \"Debug mode: %s\\n\", A::S(s));\n908\t            return;\n909\t        }\n910\t\n911\t        if c_strcmp(&args[0], b\"on\") == 0 {\n912\t            self.debug_mode = 1;\n913\t            pf!(self, \"Debug mode enabled\\n\");\n914\t        } else if c_strcmp(&args[0], b\"off\") == 0 {\n915\t            self.debug_mode = 0;\n916\t            pf!(self, \"Debug mode disabled\\n\");\n917\t        } else {\n918\t            pf!(self, \"Usage: debug [on|off]\\n\");\n919\t        }\n920\t    }\n921\t\n922\t    fn cmd_verbose(&mut self, args: &[Vec<u8>], arg_count: usize) {\n923\t        if arg_count < 1 {\n924\t            let s: &[u8] = if self.verbose_mode != 0 { b\"ON\" } else { b\"OFF\" };\n925\t            pf!(self, \"Verbose mode: %s\\n\", A::S(s));\n926\t            return;\n927\t        }\n928\t\n929\t        if c_strcmp(&args[0], b\"on\") == 0 {\n930\t            self.verbose_mode = 1;\n931\t            pf!(self, \"Verbose mode enabled\\n\");\n932\t        } else if c_strcmp(&args[0], b\"off\") == 0 {\n933\t            self.verbose_mode = 0;\n934\t            pf!(self, \"Verbose mode disabled\\n\");\n935\t        } else {\n936\t            pf!(self, \"Usage: verbose [on|off]\\n\");\n937\t        }\n938\t    }\n939\t\n940\t    fn cmd_status(&mut self) {\n941\t        pf!(self, \"\\n=== System Status ===\\n\");\n942\t        let (uc, fc, vc) = (\n943\t            self.user_count as i32,\n944\t            self.file_count as i32,\n945\t            self.variable_count as i32,\n946\t        );\n947\t        pf!(self, \"Users: %d/%d\\n\", A::I(uc), A::I(MAX_USERS as i32));\n948\t        pf!(self, \"Files: %d/%d\\n\", A::I(fc), A::I(MAX_FILES as i32));\n949\t        pf!(\n950\t            self,\n951\t            \"Variables: %d/%d\\n\",\n952\t            A::I(vc),\n953\t            A::I(MAX_VARIABLES as i32)\n954\t        );\n955\t        let cur = match self.logged_in_user() {\n956\t            Some(i) => self.user_name(i),\n957\t            None => b\"none\".to_vec(),\n958\t        };\n959\t        pf!(self, \"Current user: %s\\n\", A::S(&cur));\n960\t        let d: &[u8] = if self.debug_mode != 0 { b\"ON\" } else { b\"OFF\" };\n961\t        pf!(self, \"Debug mode: %s\\n\", A::S(d));\n962\t        let v: &[u8] = if self.verbose_mode != 0 { b\"ON\" } else { b\"OFF\" };\n963\t        pf!(self, \"Verbose mode: %s\\n\", A::S(v));\n964\t    }\n965\t\n966\t    fn cmd_time(&mut self) {\n967\t        let now: i64 = unsafe { libc_time(std::ptr::null_mut()) };\n968\t        let p = unsafe { libc_ctime(&now as *const i64) };\n969\t        let text: Vec<u8> = if p.is_null() {\n970\t            b\"(null)\".to_vec()\n971\t        } else {\n972\t            let mut v = Vec::new();\n973\t            let mut i: isize = 0;\n974\t            unsafe {\n975\t                while *p.offset(i) != 0 {\n976\t                    v.push(*p.offset(i) as u8);\n977\t                    i += 1;\n978\t                }\n979\t            }\n980\t            v\n981\t        };\n982\t        pf!(self, \"Current time: %s\", A::S(&text));\n983\t    }\n984\t\n985\t    // --- dispatch --------------------------------------------------------\n986\t\n987\t    fn process_command(&mut self, input: &[u8]) {\n988\t        let (command, args) = parse_command(input);\n989\t        let arg_count = args.len();\n990\t\n991\t        if command.is_empty() {\n992\t            return;\n993\t        }\n994\t\n995\t        if self.debug_mode != 0 {\n996\t            pf!(\n997\t                self,\n998\t                \"[DEBUG] Command: '%s', Args: %d\\n\",\n999\t                A::S(&command),\n1000\t                A::I(arg_count as i32)\n1001\t            );\n1002\t        }\n1003\t\n1004\t        let c = &command[..];\n1005\t\n1006\t        // User commands\n1007\t        if c_strcmp(c, b\"adduser\") == 0 {\n1008\t            self.cmd_adduser(&args, arg_count);\n1009\t        } else if c_strcmp(c, b\"login\") == 0 {\n1010\t            self.cmd_login(&args, arg_count);\n1011\t        } else if c_strcmp(c, b\"logout\") == 0 {\n1012\t            self.cmd_logout();\n1013\t        } else if c_strcmp(c, b\"whoami\") == 0 {\n1014\t            self.cmd_whoami();\n1015\t        } else if c_strcmp(c, b\"listusers\") == 0 || c_strcmp(c, b\"users\") == 0 {\n1016\t            self.cmd_listusers();\n1017\t        }\n1018\t        // File commands\n1019\t        else if c_strcmp(c, b\"createfile\") == 0 || c_strcmp(c, b\"touch\") == 0 {\n1020\t            self.cmd_createfile(&args, arg_count);\n1021\t        } else if c_strcmp(c, b\"readfile\") == 0 || c_strcmp(c, b\"cat\") == 0 {\n1022\t            self.cmd_readfile(&args, arg_count);\n1023\t        } else if c_strcmp(c, b\"writefile\") == 0 || c_strcmp(c, b\"write\") == 0 {\n1024\t            self.cmd_writefile(&args, arg_count);\n1025\t        } else if c_strcmp(c, b\"deletefile\") == 0 || c_strcmp(c, b\"rm\") == 0 {\n1026\t            self.cmd_deletefile(&args, arg_count);\n1027\t        } else if c_strcmp(c, b\"listfiles\") == 0 || c_strcmp(c, b\"ls\") == 0 {\n1028\t            self.cmd_listfiles();\n1029\t        }\n1030\t        // Variable commands\n1031\t        else if c_strcmp(c, b\"set\") == 0 {\n1032\t            self.cmd_set(&args, arg_count);\n1033\t        } else if c_strcmp(c, b\"get\") == 0 {\n1034\t            self.cmd_get(&args, arg_count);\n1035\t        } else if c_strcmp(c, b\"unset\") == 0 {\n1036\t            self.cmd_unset(&args, arg_count);\n1037\t        } else if c_strcmp(c, b\"listvars\") == 0 || c_strcmp(c, b\"vars\") == 0 {\n1038\t            self.cmd_listvars();\n1039\t        }\n1040\t        // String comparison commands\n1041\t        else if c_strcmp(c, b\"compare\") == 0 || c_strcmp(c, b\"cmp\") == 0 {\n1042\t            self.cmd_compare(&args, arg_count);\n1043\t        } else if c_strcmp(c, b\"compareN\") == 0 || c_strcmp(c, b\"cmpn\") == 0 {\n1044\t            self.cmd_compare_n(&args, arg_count);\n1045\t        } else if c_strcmp(c, b\"startswith\") == 0 {\n1046\t            self.cmd_startswith(&args, arg_count);\n1047\t        } else if c_strcmp(c, b\"match\") == 0 {\n1048\t            self.cmd_match(&args, arg_count);\n1049\t        }\n1050\t        // System commands\n1051\t        else if c_strcmp(c, b\"debug\") == 0 {\n1052\t            self.cmd_debug(&args, arg_count);\n1053\t        } else if c_strcmp(c, b\"verbose\") == 0 {\n1054\t            self.cmd_verbose(&args, arg_count);\n1055\t        } else if c_strcmp(c, b\"status\") == 0 {\n1056\t            self.cmd_status();\n1057\t        } else if c_strcmp(c, b\"time\") == 0 {\n1058\t            self.cmd_time();\n1059\t        } else if c_strcmp(c, b\"help\") == 0 || c_strcmp(c, b\"?\") == 0 {\n1060\t            self.cmd_help();\n1061\t        } else if c_strcmp(c, b\"exit\") == 0 || c_strcmp(c, b\"quit\") == 0 {\n1062\t            pf!(self, \"Goodbye!\\n\");\n1063\t            self.flush();\n1064\t            std::process::exit(0);\n1065\t        }\n1066\t        // Check for partial matches using strncmp\n1067\t        else if c_strncmp(c, b\"add\", 3) == 0 {\n1068\t            pf!(self, \"Did you mean 'adduser'?\\n\");\n1069\t        } else if c_strncmp(c, b\"log\", 3) == 0 {\n1070\t            pf!(self, \"Did you mean 'login' or 'logout'?\\n\");\n1071\t        } else if c_strncmp(c, b\"list\", 4) == 0 {\n1072\t            pf!(self, \"Did you mean 'listusers', 'listfiles', or 'listvars'?\\n\");\n1073\t        } else if c_strncmp(c, b\"create\", 6) == 0 {\n1074\t            pf!(self, \"Did you mean 'createfile'?\\n\");\n1075\t        } else if c_strncmp(c, b\"read\", 4) == 0 {\n1076\t            pf!(self, \"Did you mean 'readfile'?\\n\");\n1077\t        } else if c_strncmp(c, b\"write\", 5) == 0 {\n1078\t            pf!(self, \"Did you mean 'writefile'?\\n\");\n1079\t        } else if c_strncmp(c, b\"delete\", 6) == 0 {\n1080\t            pf!(self, \"Did you mean 'deletefile'?\\n\");\n1081\t        } else {\n1082\t            pf!(\n1083\t                self,\n1084\t                \"Unknown command: '%s'. Type 'help' for available commands.\\n\",\n1085\t                A::S(c)\n1086\t            );\n1087\t        }\n1088\t    }\n1089\t}\n1090\t\n1091\t// ---------------------------------------------------------------------------\n1092\t// libc bindings needed for the (locale/timezone dependent) `time` command\n1093\t// ---------------------------------------------------------------------------\n1094\t\n1095\textern \"C\" {\n1096\t    #[link_name = \"time\"]\n1097\t    fn libc_time(t: *mut i64) -> i64;\n1098\t    #[link_name = \"ctime\"]\n1099\t    fn libc_ctime(t: *const i64) -> *const std::os::raw::c_char;\n1100\t}\n1101\t\n1102\t// ---------------------------------------------------------------------------\n1103\t// Tokenizer (strtok on \" \\t\")\n1104\t// ---------------------------------------------------------------------------\n1105\t\n1106\tfn parse_command(input: &[u8]) -> (Vec<u8>, Vec<Vec<u8>>) {\n1107\t    // char temp[MAX_INPUT]; strncpy(temp, input, MAX_INPUT - 1);\n1108\t    // temp[MAX_INPUT - 1] = '\\0';\n1109\t    let limit = input.len().min(MAX_INPUT - 1);\n1110\t    let temp = &input[..limit];\n1111\t\n1112\t    let mut cmd: Vec<u8> = Vec::new();\n1113\t    let mut args: Vec<Vec<u8>> = Vec::new();\n1114\t\n1115\t    let mut tokens = temp\n1116\t        .split(|&c| c == b' ' || c == b'\\t')\n1117\t        .filter(|t| !t.is_empty());\n1118\t\n1119\t    if let Some(tok) = tokens.next() {\n1120\t        let n = tok.len().min(MAX_COMMAND - 1);\n1121\t        cmd.extend_from_slice(&tok[..n]);\n1122\t\n1123\t        for tok in tokens {\n1124\t            if args.len() >= MAX_ARGS {\n1125\t                break;\n1126\t            }\n1127\t            let n = tok.len().min(MAX_COMMAND - 1);\n1128\t            args.push(tok[..n].to_vec());\n1129\t        }\n1130\t    }\n1131\t\n1132\t    (cmd, args)\n1133\t}\n1134\t\n1135\t// ---------------------------------------------------------------------------\n1136\t// fgets emulation\n1137\t// ---------------------------------------------------------------------------\n1138\t\n1139\t/// `fgets(buf, size, stdin)` -- returns the bytes read (newline included) or\n1140\t/// `None` at end-of-file with nothing read.\n1141\tfn fgets<R: BufRead>(r: &mut R, size: usize) -> Option<Vec<u8>> {\n1142\t    let mut out: Vec<u8> = Vec::new();\n1143\t    loop {\n1144\t        if out.len() + 1 >= size {\n1145\t            return Some(out);\n1146\t        }\n1147\t        let (chunk, had_nl) = {\n1148\t            let buf = match r.fill_buf() {\n1149\t                Ok(b) => b,\n1150\t                Err(_) => {\n1151\t                    return if out.is_empty() { None } else { Some(out) };\n1152\t                }\n1153\t            };\n1154\t            if buf.is_empty() {\n1155\t                return if out.is_empty() { None } else { Some(out) };\n1156\t            }\n1157\t            let remaining = size - 1 - out.len();\n1158\t            let take = buf.len().min(remaining);\n1159\t            let slice = &buf[..take];\n1160\t            match slice.iter().position(|&c| c == b'\\n') {\n1161\t                Some(p) => (slice[..=p].to_vec(), true),\n1162\t                None => (slice.to_vec(), false),\n1163\t            }\n1164\t        };\n1165\t        let n = chunk.len();\n1166\t        out.extend_from_slice(&chunk);\n1167\t        r.consume(n);\n1168\t        if had_nl {\n1169\t            return Some(out);\n1170\t        }\n1171\t    }\n1172\t}\n1173\t\n1174\t// ---------------------------------------------------------------------------\n1175\t// main\n1176\t// ---------------------------------------------------------------------------\n1177\t\n1178\tfn main() {\n1179\t    let mut st = State::new();\n1180\t\n1181\t    pf!(st, \"|----------------------------------------|\\n\");\n1182\t    pf!(st, \"|   COMMAND INTERPRETER                  |\\n\");\n1183\t    pf!(st, \"|   strcmp/strncmp demonstration         |\\n\");\n1184\t    pf!(st, \"|----------------------------------------|\\n\");\n1185\t    pf!(st, \"Type 'help' for available commands\\n\\n\");\n1186\t\n1187\t    let stdin = std::io::stdin();\n1188\t    let mut reader = BufReader::new(StdinRead(stdin));\n1189\t\n1190\t    loop {\n1191\t        pf!(st, \"> \");\n1192\t\n1193\t        let raw = match fgets(&mut reader, MAX_INPUT) {\n1194\t            Some(v) => v,\n1195\t            None => break,\n1196\t        };\n1197\t\n1198\t        // input[strcspn(input, \"\\n\")] = 0;\n1199\t        let cut = raw\n1200\t            .iter()\n1201\t            .position(|&c| c == b'\\n' || c == 0)\n1202\t            .unwrap_or(raw.len());\n1203\t        let input = &raw[..cut];\n1204\t\n1205\t        if st.verbose_mode != 0 {\n1206\t            pf!(st, \"[VERBOSE] Processing: '%s'\\n\", A::S(input));\n1207\t        }\n1208\t\n1209\t        let owned = input.to_vec();\n1210\t        st.process_command(&owned);\n1211\t    }\n1212\t\n1213\t    st.flush();\n1214\t}\n1215\t\n1216\t/// Thin `Read` adapter so `BufReader` owns the stdin handle.\n1217\tstruct StdinRead(std::io::Stdin);\n1218\t\n1219\timpl Read for StdinRead {\n1220\t    fn read(&mut self, buf: &mut [u8]) -> std::io::Result<usize> {\n1221\t        self.0.lock().read(buf)\n1222\t    }\n1223\t}\n1224\t"}]},"parent_tool_use_id":null,"session_id":"8414a394-b54a-4582-aae8-c81f9c4a1ffc","uuid":"a1dc14d5-3ae0-4bea-aaed-b2566efed196","timestamp":"2026-08-19T23:15:01.289Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-K4LqH9/translated_rust/src/main.rs","content":"/*\n * Copyright 2025 MIT Lincoln Laboratory\n * Permission is hereby granted, free of charge,\n * to any person obtaining a copy of this software\n * and associated documentation files (the \"Software\"),\n * to deal in the Software without restriction,\n * including without limitation the rights to use, copy,\n * modify, merge, publish, distribute, sublicense,\n * and/or sell copies of the Software,\n * and to permit persons to whom the Software is furnished to do so,\n * subject to the following conditions:\n *\n * The above copyright notice and this permission notice\n * shall be included in all copies or substantial portions of the Software.\n *\n * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n * THE WARRANTIES OF MERCHANTABILITY,\n * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n */\n\n//! Faithful Rust translation of the C \"command interpreter\" driver.\n//!\n//! The original C program keeps its state in fixed-size `char` arrays inside\n//! plain C structs and copies into them with `strcpy`, which happily overruns\n//! the individual members.  To reproduce the original byte-for-byte output --\n//! including the overflow artifacts -- the global tables are modelled here as\n//! flat byte buffers laid out exactly like the C structs.\n\nuse std::io::{BufRead, BufReader, Read, Write};\n\n// ---------------------------------------------------------------------------\n// #define constants\n// ---------------------------------------------------------------------------\n\nconst MAX_INPUT: usize = 256;\nconst MAX_COMMAND: usize = 64;\nconst MAX_ARGS: usize = 10;\nconst MAX_FILES: usize = 20;\nconst MAX_USERS: usize = 10;\nconst MAX_VARIABLES: usize = 20;\n\n// ---------------------------------------------------------------------------\n// struct layouts (x86-64 SysV, as produced by the reference compiler)\n//\n//   typedef struct { char name[32]; char password[32];\n//                    int permission_level; int logged_in; } user_t;   // 72\n//   typedef struct { char filename[64]; char content[512];\n//                    char owner[32]; int permissions; } file_t;       // 612\n//   typedef struct { char name[32]; char value[128]; } variable_t;    // 160\n// ---------------------------------------------------------------------------\n\nconst USER_SIZE: usize = 72;\nconst U_NAME: usize = 0;\nconst U_PASSWORD: usize = 32;\nconst U_PERM_LEVEL: usize = 64;\nconst U_LOGGED_IN: usize = 68;\n\nconst FILE_SIZE: usize = 612;\nconst F_FILENAME: usize = 0;\nconst F_CONTENT: usize = 64;\nconst F_OWNER: usize = 576;\nconst F_PERMISSIONS: usize = 608;\n\nconst VAR_SIZE: usize = 160;\nconst V_NAME: usize = 0;\nconst V_VALUE: usize = 32;\n\n/// Extra slack so that `strcpy` overruns past the end of a table (which the C\n/// program performs into whatever `.bss` object follows) never panic.\nconst SLACK: usize = 512;\n\n// ---------------------------------------------------------------------------\n// C string helpers operating on flat byte buffers\n// ---------------------------------------------------------------------------\n\n/// `strcpy(buf + off, src)` -- writes `src` followed by a NUL terminator.\nfn c_strcpy(buf: &mut [u8], off: usize, src: &[u8]) {\n    let mut i = 0;\n    while i < src.len() {\n        if off + i >= buf.len() {\n            return;\n        }\n        buf[off + i] = src[i];\n        i += 1;\n    }\n    if off + i < buf.len() {\n        buf[off + i] = 0;\n    }\n}\n\n/// Reads the NUL-terminated string that starts at `buf + off`.\nfn c_str(buf: &[u8], off: usize) -> Vec<u8> {\n    let mut out = Vec::new();\n    let mut i = off;\n    while i < buf.len() && buf[i] != 0 {\n        out.push(buf[i]);\n        i += 1;\n    }\n    out\n}\n\n/// Reads a little-endian `int` from `buf + off`.\nfn c_int(buf: &[u8], off: usize) -> i32 {\n    let mut b = [0u8; 4];\n    for k in 0..4 {\n        if off + k < buf.len() {\n            b[k] = buf[off + k];\n        }\n    }\n    i32::from_le_bytes(b)\n}\n\n/// Writes a little-endian `int` to `buf + off`.\nfn c_set_int(buf: &mut [u8], off: usize, v: i32) {\n    let b = v.to_le_bytes();\n    for k in 0..4 {\n        if off + k < buf.len() {\n            buf[off + k] = b[k];\n        }\n    }\n}\n\n/// Copies `len` raw bytes from `src_off` to `dst_off` (struct assignment).\nfn c_struct_copy(buf: &mut [u8], dst_off: usize, src_off: usize, len: usize) {\n    for k in 0..len {\n        if dst_off + k < buf.len() && src_off + k < buf.len() {\n            buf[dst_off + k] = buf[src_off + k];\n        }\n    }\n}\n\n/// glibc `strcmp`: returns the difference of the first differing bytes,\n/// interpreted as `unsigned char`.\nfn c_strcmp(a: &[u8], b: &[u8]) -> i32 {\n    let n = a.len().min(b.len());\n    for i in 0..n {\n        if a[i] != b[i] {\n            return a[i] as i32 - b[i] as i32;\n        }\n    }\n    if a.len() == b.len() {\n        0\n    } else if a.len() < b.len() {\n        // a ran out: implicit NUL vs b[a.len()]\n        -(b[a.len()] as i32)\n    } else {\n        a[b.len()] as i32\n    }\n}\n\n/// glibc `strncmp` with the same \"byte difference\" return convention.\nfn c_strncmp(a: &[u8], b: &[u8], n: usize) -> i32 {\n    let mut i: usize = 0;\n    while i < n {\n        let ca = if i < a.len() { a[i] } else { 0 };\n        let cb = if i < b.len() { b[i] } else { 0 };\n        if ca != cb {\n            return ca as i32 - cb as i32;\n        }\n        if ca == 0 {\n            return 0;\n        }\n        i += 1;\n    }\n    0\n}\n\n/// `strstr(haystack, needle) != NULL`\nfn c_strstr_found(haystack: &[u8], needle: &[u8]) -> bool {\n    if needle.is_empty() {\n        return true;\n    }\n    if needle.len() > haystack.len() {\n        return false;\n    }\n    haystack\n        .windows(needle.len())\n        .any(|w| w == needle)\n}\n\n/// glibc `atoi` == `(int)strtol(s, NULL, 10)`, including the LONG_MAX /\n/// LONG_MIN saturation before the truncating cast to `int`.\nfn c_atoi(s: &[u8]) -> i32 {\n    let mut i = 0;\n    while i < s.len() && matches!(s[i], b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r') {\n        i += 1;\n    }\n    let mut negative = false;\n    if i < s.len() && (s[i] == b'+' || s[i] == b'-') {\n        negative = s[i] == b'-';\n        i += 1;\n    }\n    let mut acc: u128 = 0;\n    let mut overflow = false;\n    let cutoff: u128 = if negative {\n        1u128 << 63 // |LONG_MIN|\n    } else {\n        (1u128 << 63) - 1 // LONG_MAX\n    };\n    while i < s.len() && s[i].is_ascii_digit() {\n        if !overflow {\n            acc = acc * 10 + (s[i] - b'0') as u128;\n            if acc > cutoff {\n                overflow = true;\n            }\n        }\n        i += 1;\n    }\n    let as_long: i64 = if overflow {\n        if negative {\n            i64::MIN\n        } else {\n            i64::MAX\n        }\n    } else if negative {\n        (acc as i64).wrapping_neg()\n    } else {\n        acc as i64\n    };\n    as_long as i32\n}\n\n// ---------------------------------------------------------------------------\n// printf(\"%s\"/\"%d\") emulation over raw bytes\n// ---------------------------------------------------------------------------\n\n#[derive(Clone, Copy)]\nenum A<'a> {\n    S(&'a [u8]),\n    I(i32),\n}\n\nfn cfmt(fmt: &str, args: &[A]) -> Vec<u8> {\n    let f = fmt.as_bytes();\n    let mut out: Vec<u8> = Vec::with_capacity(f.len() + 16);\n    let mut ai = 0usize;\n    let mut i = 0usize;\n    while i < f.len() {\n        if f[i] == b'%' && i + 1 < f.len() {\n            match f[i + 1] {\n                b's' => {\n                    if let Some(A::S(s)) = args.get(ai) {\n                        out.extend_from_slice(s);\n                    }\n                    ai += 1;\n                    i += 2;\n                }\n                b'd' => {\n                    if let Some(A::I(v)) = args.get(ai) {\n                        out.extend_from_slice(v.to_string().as_bytes());\n                    }\n                    ai += 1;\n                    i += 2;\n                }\n                b'%' => {\n                    out.push(b'%');\n                    i += 2;\n                }\n                _ => {\n                    out.push(f[i]);\n                    i += 1;\n                }\n            }\n        } else {\n            out.push(f[i]);\n            i += 1;\n        }\n    }\n    out\n}\n\nmacro_rules! pf {\n    ($st:expr, $fmt:expr) => {{\n        $st.emit($fmt.as_bytes());\n    }};\n    ($st:expr, $fmt:expr, $($a:expr),+ $(,)?) => {{\n        let __tmp = cfmt($fmt, &[$($a),+]);\n        $st.emit(&__tmp);\n    }};\n}\n\n// ---------------------------------------------------------------------------\n// Global state\n// ---------------------------------------------------------------------------\n\nstruct State {\n    users: Vec<u8>,\n    user_count: usize,\n    current_user: Option<usize>, // index into `users`\n\n    files: Vec<u8>,\n    file_count: usize,\n\n    variables: Vec<u8>,\n    variable_count: usize,\n\n    debug_mode: i32,\n    verbose_mode: i32,\n\n    out: Vec<u8>,\n}\n\nimpl State {\n    fn new() -> State {\n        State {\n            users: vec![0u8; MAX_USERS * USER_SIZE + SLACK],\n            user_count: 0,\n            current_user: None,\n            files: vec![0u8; MAX_FILES * FILE_SIZE + SLACK],\n            file_count: 0,\n            variables: vec![0u8; MAX_VARIABLES * VAR_SIZE + SLACK],\n            variable_count: 0,\n            debug_mode: 0,\n            verbose_mode: 0,\n            out: Vec::with_capacity(1 << 16),\n        }\n    }\n\n    fn emit(&mut self, bytes: &[u8]) {\n        self.out.extend_from_slice(bytes);\n        if self.out.len() >= (1 << 16) {\n            self.flush();\n        }\n    }\n\n    fn flush(&mut self) {\n        if !self.out.is_empty() {\n            let stdout = std::io::stdout();\n            let mut lock = stdout.lock();\n            let _ = lock.write_all(&self.out);\n            let _ = lock.flush();\n            self.out.clear();\n        }\n    }\n\n    // --- accessors -------------------------------------------------------\n\n    fn user_name(&self, i: usize) -> Vec<u8> {\n        c_str(&self.users, i * USER_SIZE + U_NAME)\n    }\n    fn user_password(&self, i: usize) -> Vec<u8> {\n        c_str(&self.users, i * USER_SIZE + U_PASSWORD)\n    }\n    fn user_perm(&self, i: usize) -> i32 {\n        c_int(&self.users, i * USER_SIZE + U_PERM_LEVEL)\n    }\n    fn user_logged_in(&self, i: usize) -> i32 {\n        c_int(&self.users, i * USER_SIZE + U_LOGGED_IN)\n    }\n\n    fn file_name(&self, i: usize) -> Vec<u8> {\n        c_str(&self.files, i * FILE_SIZE + F_FILENAME)\n    }\n    fn file_content(&self, i: usize) -> Vec<u8> {\n        c_str(&self.files, i * FILE_SIZE + F_CONTENT)\n    }\n    fn file_owner(&self, i: usize) -> Vec<u8> {\n        c_str(&self.files, i * FILE_SIZE + F_OWNER)\n    }\n    fn file_perm(&self, i: usize) -> i32 {\n        c_int(&self.files, i * FILE_SIZE + F_PERMISSIONS)\n    }\n\n    fn var_name(&self, i: usize) -> Vec<u8> {\n        c_str(&self.variables, i * VAR_SIZE + V_NAME)\n    }\n    fn var_value(&self, i: usize) -> Vec<u8> {\n        c_str(&self.variables, i * VAR_SIZE + V_VALUE)\n    }\n\n    /// `current_user && current_user->logged_in`\n    fn logged_in_user(&self) -> Option<usize> {\n        match self.current_user {\n            Some(i) if self.user_logged_in(i) != 0 => Some(i),\n            _ => None,\n        }\n    }\n\n    // --- user management -------------------------------------------------\n\n    fn cmd_adduser(&mut self, args: &[Vec<u8>], arg_count: usize) {\n        if arg_count < 2 {\n            pf!(self, \"Usage: adduser <username> <password> [permission_level]\\n\");\n            return;\n        }\n\n        if self.user_count >= MAX_USERS {\n            pf!(self, \"Error: Maximum users reached\\n\");\n            return;\n        }\n\n        for i in 0..self.user_count {\n            if c_strcmp(&self.user_name(i), &args[0]) == 0 {\n                pf!(self, \"Error: User '%s' already exists\\n\", A::S(&args[0]));\n                return;\n            }\n        }\n\n        let base = self.user_count * USER_SIZE;\n        c_strcpy(&mut self.users, base + U_NAME, &args[0]);\n        c_strcpy(&mut self.users, base + U_PASSWORD, &args[1]);\n        let level = if arg_count >= 3 { c_atoi(&args[2]) } else { 1 };\n        c_set_int(&mut self.users, base + U_PERM_LEVEL, level);\n        c_set_int(&mut self.users, base + U_LOGGED_IN, 0);\n        self.user_count += 1;\n\n        let shown = self.user_perm(self.user_count - 1);\n        pf!(\n            self,\n            \"User '%s' added with permission level %d\\n\",\n            A::S(&args[0]),\n            A::I(shown)\n        );\n    }\n\n    fn cmd_login(&mut self, args: &[Vec<u8>], arg_count: usize) {\n        if arg_count < 2 {\n            pf!(self, \"Usage: login <username> <password>\\n\");\n            return;\n        }\n\n        if let Some(cu) = self.logged_in_user() {\n            let name = self.user_name(cu);\n            pf!(\n                self,\n                \"Error: User '%s' already logged in. Use 'logout' first.\\n\",\n                A::S(&name)\n            );\n            return;\n        }\n\n        for i in 0..self.user_count {\n            if c_strcmp(&self.user_name(i), &args[0]) == 0 {\n                if c_strcmp(&self.user_password(i), &args[1]) == 0 {\n                    c_set_int(&mut self.users, i * USER_SIZE + U_LOGGED_IN, 1);\n                    self.current_user = Some(i);\n                    let name = self.user_name(i);\n                    pf!(self, \"Login successful. Welcome, %s!\\n\", A::S(&name));\n                    return;\n                } else {\n                    pf!(self, \"Error: Incorrect password\\n\");\n                    return;\n                }\n            }\n        }\n\n        pf!(self, \"Error: User not found\\n\");\n    }\n\n    fn cmd_logout(&mut self) {\n        let cu = match self.logged_in_user() {\n            Some(i) => i,\n            None => {\n                pf!(self, \"Error: No user logged in\\n\");\n                return;\n            }\n        };\n\n        let name = self.user_name(cu);\n        pf!(self, \"Goodbye, %s!\\n\", A::S(&name));\n        c_set_int(&mut self.users, cu * USER_SIZE + U_LOGGED_IN, 0);\n        self.current_user = None;\n    }\n\n    fn cmd_whoami(&mut self) {\n        let cu = match self.logged_in_user() {\n            Some(i) => i,\n            None => {\n                pf!(self, \"Not logged in\\n\");\n                return;\n            }\n        };\n\n        let name = self.user_name(cu);\n        let perm = self.user_perm(cu);\n        pf!(self, \"Current user: %s\\n\", A::S(&name));\n        pf!(self, \"Permission level: %d\\n\", A::I(perm));\n    }\n\n    fn cmd_listusers(&mut self) {\n        if self.user_count == 0 {\n            pf!(self, \"No users registered\\n\");\n            return;\n        }\n\n        pf!(self, \"Registered users:\\n\");\n        for i in 0..self.user_count {\n            let name = self.user_name(i);\n            let perm = self.user_perm(i);\n            let flag: &[u8] = if self.user_logged_in(i) != 0 {\n                b\"[logged in]\"\n            } else {\n                b\"\"\n            };\n            pf!(\n                self,\n                \"  %s (level %d) %s\\n\",\n                A::S(&name),\n                A::I(perm),\n                A::S(flag)\n            );\n        }\n    }\n\n    // --- file management -------------------------------------------------\n\n    fn cmd_createfile(&mut self, args: &[Vec<u8>], arg_count: usize) {\n        let cu = match self.logged_in_user() {\n            Some(i) => i,\n            None => {\n                pf!(self, \"Error: Must be logged in\\n\");\n                return;\n            }\n        };\n\n        if arg_count < 1 {\n            pf!(self, \"Usage: createfile <filename> [content]\\n\");\n            return;\n        }\n\n        if self.file_count >= MAX_FILES {\n            pf!(self, \"Error: Maximum files reached\\n\");\n            return;\n        }\n\n        for i in 0..self.file_count {\n            if c_strcmp(&self.file_name(i), &args[0]) == 0 {\n                pf!(self, \"Error: File '%s' already exists\\n\", A::S(&args[0]));\n                return;\n            }\n        }\n\n        let base = self.file_count * FILE_SIZE;\n        let owner = self.user_name(cu);\n        c_strcpy(&mut self.files, base + F_FILENAME, &args[0]);\n        c_strcpy(&mut self.files, base + F_OWNER, &owner);\n        c_set_int(&mut self.files, base + F_PERMISSIONS, 755);\n\n        if arg_count >= 2 {\n            c_strcpy(&mut self.files, base + F_CONTENT, &args[1]);\n        } else if base + F_CONTENT < self.files.len() {\n            self.files[base + F_CONTENT] = 0;\n        }\n\n        self.file_count += 1;\n        pf!(self, \"File '%s' created\\n\", A::S(&args[0]));\n    }\n\n    fn cmd_readfile(&mut self, args: &[Vec<u8>], arg_count: usize) {\n        if arg_count < 1 {\n            pf!(self, \"Usage: readfile <filename>\\n\");\n            return;\n        }\n\n        for i in 0..self.file_count {\n            if c_strcmp(&self.file_name(i), &args[0]) == 0 {\n                let name = self.file_name(i);\n                let owner = self.file_owner(i);\n                let perm = self.file_perm(i);\n                let content = self.file_content(i);\n                pf!(self, \"=== %s ===\\n\", A::S(&name));\n                pf!(self, \"Owner: %s\\n\", A::S(&owner));\n                pf!(self, \"Permissions: %d\\n\", A::I(perm));\n                pf!(self, \"Content: %s\\n\", A::S(&content));\n                return;\n            }\n        }\n\n        pf!(self, \"Error: File '%s' not found\\n\", A::S(&args[0]));\n    }\n\n    fn cmd_writefile(&mut self, args: &[Vec<u8>], arg_count: usize) {\n        let cu = match self.logged_in_user() {\n            Some(i) => i,\n            None => {\n                pf!(self, \"Error: Must be logged in\\n\");\n                return;\n            }\n        };\n\n        if arg_count < 2 {\n            pf!(self, \"Usage: writefile <filename> <content>\\n\");\n            return;\n        }\n\n        for i in 0..self.file_count {\n            if c_strcmp(&self.file_name(i), &args[0]) == 0 {\n                let cu_name = self.user_name(cu);\n                if c_strcmp(&self.file_owner(i), &cu_name) == 0 || self.user_perm(cu) >= 5 {\n                    c_strcpy(&mut self.files, i * FILE_SIZE + F_CONTENT, &args[1]);\n                    pf!(self, \"File '%s' updated\\n\", A::S(&args[0]));\n                    return;\n                } else {\n                    pf!(self, \"Error: Permission denied\\n\");\n                    return;\n                }\n            }\n        }\n\n        pf!(self, \"Error: File '%s' not found\\n\", A::S(&args[0]));\n    }\n\n    fn cmd_deletefile(&mut self, args: &[Vec<u8>], arg_count: usize) {\n        let cu = match self.logged_in_user() {\n            Some(i) => i,\n            None => {\n                pf!(self, \"Error: Must be logged in\\n\");\n                return;\n            }\n        };\n\n        if arg_count < 1 {\n            pf!(self, \"Usage: deletefile <filename>\\n\");\n            return;\n        }\n\n        for i in 0..self.file_count {\n            if c_strcmp(&self.file_name(i), &args[0]) == 0 {\n                let cu_name = self.user_name(cu);\n                if c_strcmp(&self.file_owner(i), &cu_name) == 0 || self.user_perm(cu) >= 9 {\n                    for j in i..self.file_count - 1 {\n                        c_struct_copy(\n                            &mut self.files,\n                            j * FILE_SIZE,\n                            (j + 1) * FILE_SIZE,\n                            FILE_SIZE,\n                        );\n                    }\n                    self.file_count -= 1;\n                    pf!(self, \"File '%s' deleted\\n\", A::S(&args[0]));\n                    return;\n                } else {\n                    pf!(self, \"Error: Permission denied\\n\");\n                    return;\n                }\n            }\n        }\n\n        pf!(self, \"Error: File '%s' not found\\n\", A::S(&args[0]));\n    }\n\n    fn cmd_listfiles(&mut self) {\n        if self.file_count == 0 {\n            pf!(self, \"No files\\n\");\n            return;\n        }\n\n        pf!(self, \"Files:\\n\");\n        for i in 0..self.file_count {\n            let name = self.file_name(i);\n            let owner = self.file_owner(i);\n            let perm = self.file_perm(i);\n            pf!(\n                self,\n                \"  %s (owner: %s, perm: %d)\\n\",\n                A::S(&name),\n                A::S(&owner),\n                A::I(perm)\n            );\n        }\n    }\n\n    // --- variables -------------------------------------------------------\n\n    fn cmd_set(&mut self, args: &[Vec<u8>], arg_count: usize) {\n        if arg_count < 2 {\n            pf!(self, \"Usage: set <name> <value>\\n\");\n            return;\n        }\n\n        for i in 0..self.variable_count {\n            if c_strcmp(&self.var_name(i), &args[0]) == 0 {\n                c_strcpy(&mut self.variables, i * VAR_SIZE + V_VALUE, &args[1]);\n                pf!(self, \"Variable '%s' updated\\n\", A::S(&args[0]));\n                return;\n            }\n        }\n\n        if self.variable_count >= MAX_VARIABLES {\n            pf!(self, \"Error: Maximum variables reached\\n\");\n            return;\n        }\n\n        let base = self.variable_count * VAR_SIZE;\n        c_strcpy(&mut self.variables, base + V_NAME, &args[0]);\n        c_strcpy(&mut self.variables, base + V_VALUE, &args[1]);\n        self.variable_count += 1;\n        pf!(self, \"Variable '%s' set\\n\", A::S(&args[0]));\n    }\n\n    fn cmd_get(&mut self, args: &[Vec<u8>], arg_count: usize) {\n        if arg_count < 1 {\n            pf!(self, \"Usage: get <name>\\n\");\n            return;\n        }\n\n        for i in 0..self.variable_count {\n            if c_strcmp(&self.var_name(i), &args[0]) == 0 {\n                let name = self.var_name(i);\n                let value = self.var_value(i);\n                pf!(self, \"%s = %s\\n\", A::S(&name), A::S(&value));\n                return;\n            }\n        }\n\n        pf!(self, \"Error: Variable '%s' not found\\n\", A::S(&args[0]));\n    }\n\n    fn cmd_unset(&mut self, args: &[Vec<u8>], arg_count: usize) {\n        if arg_count < 1 {\n            pf!(self, \"Usage: unset <name>\\n\");\n            return;\n        }\n\n        for i in 0..self.variable_count {\n            if c_strcmp(&self.var_name(i), &args[0]) == 0 {\n                for j in i..self.variable_count - 1 {\n                    c_struct_copy(\n                        &mut self.variables,\n                        j * VAR_SIZE,\n                        (j + 1) * VAR_SIZE,\n                        VAR_SIZE,\n                    );\n                }\n                self.variable_count -= 1;\n                pf!(self, \"Variable '%s' unset\\n\", A::S(&args[0]));\n                return;\n            }\n        }\n\n        pf!(self, \"Error: Variable '%s' not found\\n\", A::S(&args[0]));\n    }\n\n    fn cmd_listvars(&mut self) {\n        if self.variable_count == 0 {\n            pf!(self, \"No variables set\\n\");\n            return;\n        }\n\n        pf!(self, \"Variables:\\n\");\n        for i in 0..self.variable_count {\n            let name = self.var_name(i);\n            let value = self.var_value(i);\n            pf!(self, \"  %s = %s\\n\", A::S(&name), A::S(&value));\n        }\n    }\n\n    // --- string comparison ----------------------------------------------\n\n    fn cmd_compare(&mut self, args: &[Vec<u8>], arg_count: usize) {\n        if arg_count < 2 {\n            pf!(self, \"Usage: compare <string1> <string2>\\n\");\n            return;\n        }\n\n        let result = c_strcmp(&args[0], &args[1]);\n\n        pf!(\n            self,\n            \"strcmp('%s', '%s') = %d\\n\",\n            A::S(&args[0]),\n            A::S(&args[1]),\n            A::I(result)\n        );\n\n        if result == 0 {\n            pf!(self, \"Strings are equal\\n\");\n        } else if result < 0 {\n            pf!(self, \"'%s' < '%s'\\n\", A::S(&args[0]), A::S(&args[1]));\n        } else {\n            pf!(self, \"'%s' > '%s'\\n\", A::S(&args[0]), A::S(&args[1]));\n        }\n    }\n\n    fn cmd_compare_n(&mut self, args: &[Vec<u8>], arg_count: usize) {\n        if arg_count < 3 {\n            pf!(self, \"Usage: compareN <string1> <string2> <n>\\n\");\n            return;\n        }\n\n        let n = c_atoi(&args[2]);\n        // `int` -> `size_t` conversion (sign extension on LP64).\n        let result = c_strncmp(&args[0], &args[1], n as isize as usize);\n\n        pf!(\n            self,\n            \"strncmp('%s', '%s', %d) = %d\\n\",\n            A::S(&args[0]),\n            A::S(&args[1]),\n            A::I(n),\n            A::I(result)\n        );\n\n        if result == 0 {\n            pf!(self, \"First %d characters are equal\\n\", A::I(n));\n        } else if result < 0 {\n            pf!(\n                self,\n                \"'%s' < '%s' (first %d chars)\\n\",\n                A::S(&args[0]),\n                A::S(&args[1]),\n                A::I(n)\n            );\n        } else {\n            pf!(\n                self,\n                \"'%s' > '%s' (first %d chars)\\n\",\n                A::S(&args[0]),\n                A::S(&args[1]),\n                A::I(n)\n            );\n        }\n    }\n\n    fn cmd_startswith(&mut self, args: &[Vec<u8>], arg_count: usize) {\n        if arg_count < 2 {\n            pf!(self, \"Usage: startswith <string> <prefix>\\n\");\n            return;\n        }\n\n        let prefix_len = args[1].len();\n\n        if c_strncmp(&args[0], &args[1], prefix_len) == 0 {\n            pf!(\n                self,\n                \"'%s' starts with '%s'\\n\",\n                A::S(&args[0]),\n                A::S(&args[1])\n            );\n        } else {\n            pf!(\n                self,\n                \"'%s' does not start with '%s'\\n\",\n                A::S(&args[0]),\n                A::S(&args[1])\n            );\n        }\n    }\n\n    fn cmd_match(&mut self, args: &[Vec<u8>], arg_count: usize) {\n        if arg_count < 2 {\n            pf!(self, \"Usage: match <pattern> <string1> [string2] ...\\n\");\n            return;\n        }\n\n        pf!(self, \"Matching pattern '%s':\\n\", A::S(&args[0]));\n        let mut matches = 0i32;\n\n        for i in 1..arg_count {\n            if c_strcmp(&args[0], &args[i]) == 0 {\n                pf!(self, \"  '%s' - EXACT MATCH\\n\", A::S(&args[i]));\n                matches += 1;\n            } else if c_strstr_found(&args[i], &args[0]) {\n                pf!(self, \"  '%s' - contains pattern\\n\", A::S(&args[i]));\n                matches += 1;\n            } else {\n                pf!(self, \"  '%s' - no match\\n\", A::S(&args[i]));\n            }\n        }\n\n        pf!(self, \"Total matches: %d\\n\", A::I(matches));\n    }\n\n    // --- system ----------------------------------------------------------\n\n    fn cmd_help(&mut self) {\n        pf!(self, \"\\n=== Command Interpreter Help ===\\n\");\n        pf!(self, \"User Management:\\n\");\n        pf!(self, \"  adduser <user> <pass> [level] - Add new user\\n\");\n        pf!(self, \"  login <user> <pass>            - Login as user\\n\");\n        pf!(self, \"  logout                         - Logout current user\\n\");\n        pf!(self, \"  whoami                         - Show current user\\n\");\n        pf!(self, \"  listusers                      - List all users\\n\");\n        pf!(self, \"\\nFile Management:\\n\");\n        pf!(self, \"  createfile <name> [content]    - Create file\\n\");\n        pf!(self, \"  readfile <name>                - Read file\\n\");\n        pf!(self, \"  writefile <name> <content>     - Write to file\\n\");\n        pf!(self, \"  deletefile <name>              - Delete file\\n\");\n        pf!(self, \"  listfiles                      - List all files\\n\");\n        pf!(self, \"\\nVariable Management:\\n\");\n        pf!(self, \"  set <name> <value>             - Set variable\\n\");\n        pf!(self, \"  get <name>                     - Get variable\\n\");\n        pf!(self, \"  unset <name>                   - Unset variable\\n\");\n        pf!(self, \"  listvars                       - List all variables\\n\");\n        pf!(self, \"\\nString Operations:\\n\");\n        pf!(self, \"  compare <str1> <str2>          - Compare strings\\n\");\n        pf!(self, \"  compareN <str1> <str2> <n>     - Compare first N chars\\n\");\n        pf!(self, \"  startswith <str> <prefix>      - Check if starts with\\n\");\n        pf!(self, \"  match <pattern> <str> ...      - Match pattern\\n\");\n        pf!(self, \"\\nSystem:\\n\");\n        pf!(self, \"  debug [on|off]                 - Toggle debug mode\\n\");\n        pf!(self, \"  verbose [on|off]               - Toggle verbose mode\\n\");\n        pf!(self, \"  status                         - Show system status\\n\");\n        pf!(self, \"  time                           - Show current time\\n\");\n        pf!(self, \"  help                           - Show this help\\n\");\n        pf!(self, \"  exit                           - Exit program\\n\");\n    }\n\n    fn cmd_debug(&mut self, args: &[Vec<u8>], arg_count: usize) {\n        if arg_count < 1 {\n            let s: &[u8] = if self.debug_mode != 0 { b\"ON\" } else { b\"OFF\" };\n            pf!(self, \"Debug mode: %s\\n\", A::S(s));\n            return;\n        }\n\n        if c_strcmp(&args[0], b\"on\") == 0 {\n            self.debug_mode = 1;\n            pf!(self, \"Debug mode enabled\\n\");\n        } else if c_strcmp(&args[0], b\"off\") == 0 {\n            self.debug_mode = 0;\n            pf!(self, \"Debug mode disabled\\n\");\n        } else {\n            pf!(self, \"Usage: debug [on|off]\\n\");\n        }\n    }\n\n    fn cmd_verbose(&mut self, args: &[Vec<u8>], arg_count: usize) {\n        if arg_count < 1 {\n            let s: &[u8] = if self.verbose_mode != 0 { b\"ON\" } else { b\"OFF\" };\n            pf!(self, \"Verbose mode: %s\\n\", A::S(s));\n            return;\n        }\n\n        if c_strcmp(&args[0], b\"on\") == 0 {\n            self.verbose_mode = 1;\n            pf!(self, \"Verbose mode enabled\\n\");\n        } else if c_strcmp(&args[0], b\"off\") == 0 {\n            self.verbose_mode = 0;\n            pf!(self, \"Verbose mode disabled\\n\");\n        } else {\n            pf!(self, \"Usage: verbose [on|off]\\n\");\n        }\n    }\n\n    fn cmd_status(&mut self) {\n        pf!(self, \"\\n=== System Status ===\\n\");\n        let (uc, fc, vc) = (\n            self.user_count as i32,\n            self.file_count as i32,\n            self.variable_count as i32,\n        );\n        pf!(self, \"Users: %d/%d\\n\", A::I(uc), A::I(MAX_USERS as i32));\n        pf!(self, \"Files: %d/%d\\n\", A::I(fc), A::I(MAX_FILES as i32));\n        pf!(\n            self,\n            \"Variables: %d/%d\\n\",\n            A::I(vc),\n            A::I(MAX_VARIABLES as i32)\n        );\n        let cur = match self.logged_in_user() {\n            Some(i) => self.user_name(i),\n            None => b\"none\".to_vec(),\n        };\n        pf!(self, \"Current user: %s\\n\", A::S(&cur));\n        let d: &[u8] = if self.debug_mode != 0 { b\"ON\" } else { b\"OFF\" };\n        pf!(self, \"Debug mode: %s\\n\", A::S(d));\n        let v: &[u8] = if self.verbose_mode != 0 { b\"ON\" } else { b\"OFF\" };\n        pf!(self, \"Verbose mode: %s\\n\", A::S(v));\n    }\n\n    fn cmd_time(&mut self) {\n        let now: i64 = unsafe { libc_time(std::ptr::null_mut()) };\n        let p = unsafe { libc_ctime(&now as *const i64) };\n        let text: Vec<u8> = if p.is_null() {\n            b\"(null)\".to_vec()\n        } else {\n            let mut v = Vec::new();\n            let mut i: isize = 0;\n            unsafe {\n                while *p.offset(i) != 0 {\n                    v.push(*p.offset(i) as u8);\n                    i += 1;\n                }\n            }\n            v\n        };\n        pf!(self, \"Current time: %s\", A::S(&text));\n    }\n\n    // --- dispatch --------------------------------------------------------\n\n    fn process_command(&mut self, input: &[u8]) {\n        let (command, args) = parse_command(input);\n        let arg_count = args.len();\n\n        if command.is_empty() {\n            return;\n        }\n\n        if self.debug_mode != 0 {\n            pf!(\n                self,\n                \"[DEBUG] Command: '%s', Args: %d\\n\",\n                A::S(&command),\n                A::I(arg_count as i32)\n            );\n        }\n\n        let c = &command[..];\n\n        // User commands\n        if c_strcmp(c, b\"adduser\") == 0 {\n            self.cmd_adduser(&args, arg_count);\n        } else if c_strcmp(c, b\"login\") == 0 {\n            self.cmd_login(&args, arg_count);\n        } else if c_strcmp(c, b\"logout\") == 0 {\n            self.cmd_logout();\n        } else if c_strcmp(c, b\"whoami\") == 0 {\n            self.cmd_whoami();\n        } else if c_strcmp(c, b\"listusers\") == 0 || c_strcmp(c, b\"users\") == 0 {\n            self.cmd_listusers();\n        }\n        // File commands\n        else if c_strcmp(c, b\"createfile\") == 0 || c_strcmp(c, b\"touch\") == 0 {\n            self.cmd_createfile(&args, arg_count);\n        } else if c_strcmp(c, b\"readfile\") == 0 || c_strcmp(c, b\"cat\") == 0 {\n            self.cmd_readfile(&args, arg_count);\n        } else if c_strcmp(c, b\"writefile\") == 0 || c_strcmp(c, b\"write\") == 0 {\n            self.cmd_writefile(&args, arg_count);\n        } else if c_strcmp(c, b\"deletefile\") == 0 || c_strcmp(c, b\"rm\") == 0 {\n            self.cmd_deletefile(&args, arg_count);\n        } else if c_strcmp(c, b\"listfiles\") == 0 || c_strcmp(c, b\"ls\") == 0 {\n            self.cmd_listfiles();\n        }\n        // Variable commands\n        else if c_strcmp(c, b\"set\") == 0 {\n            self.cmd_set(&args, arg_count);\n        } else if c_strcmp(c, b\"get\") == 0 {\n            self.cmd_get(&args, arg_count);\n        } else if c_strcmp(c, b\"unset\") == 0 {\n            self.cmd_unset(&args, arg_count);\n        } else if c_strcmp(c, b\"listvars\") == 0 || c_strcmp(c, b\"vars\") == 0 {\n            self.cmd_listvars();\n        }\n        // String comparison commands\n        else if c_strcmp(c, b\"compare\") == 0 || c_strcmp(c, b\"cmp\") == 0 {\n            self.cmd_compare(&args, arg_count);\n        } else if c_strcmp(c, b\"compareN\") == 0 || c_strcmp(c, b\"cmpn\") == 0 {\n            self.cmd_compare_n(&args, arg_count);\n        } else if c_strcmp(c, b\"startswith\") == 0 {\n            self.cmd_startswith(&args, arg_count);\n        } else if c_strcmp(c, b\"match\") == 0 {\n            self.cmd_match(&args, arg_count);\n        }\n        // System commands\n        else if c_strcmp(c, b\"debug\") == 0 {\n            self.cmd_debug(&args, arg_count);\n        } else if c_strcmp(c, b\"verbose\") == 0 {\n            self.cmd_verbose(&args, arg_count);\n        } else if c_strcmp(c, b\"status\") == 0 {\n            self.cmd_status();\n        } else if c_strcmp(c, b\"time\") == 0 {\n            self.cmd_time();\n        } else if c_strcmp(c, b\"help\") == 0 || c_strcmp(c, b\"?\") == 0 {\n            self.cmd_help();\n        } else if c_strcmp(c, b\"exit\") == 0 || c_strcmp(c, b\"quit\") == 0 {\n            pf!(self, \"Goodbye!\\n\");\n            self.flush();\n            std::process::exit(0);\n        }\n        // Check for partial matches using strncmp\n        else if c_strncmp(c, b\"add\", 3) == 0 {\n            pf!(self, \"Did you mean 'adduser'?\\n\");\n        } else if c_strncmp(c, b\"log\", 3) == 0 {\n            pf!(self, \"Did you mean 'login' or 'logout'?\\n\");\n        } else if c_strncmp(c, b\"list\", 4) == 0 {\n            pf!(self, \"Did you mean 'listusers', 'listfiles', or 'listvars'?\\n\");\n        } else if c_strncmp(c, b\"create\", 6) == 0 {\n            pf!(self, \"Did you mean 'createfile'?\\n\");\n        } else if c_strncmp(c, b\"read\", 4) == 0 {\n            pf!(self, \"Did you mean 'readfile'?\\n\");\n        } else if c_strncmp(c, b\"write\", 5) == 0 {\n            pf!(self, \"Did you mean 'writefile'?\\n\");\n        } else if c_strncmp(c, b\"delete\", 6) == 0 {\n            pf!(self, \"Did you mean 'deletefile'?\\n\");\n        } else {\n            pf!(\n                self,\n                \"Unknown command: '%s'. Type 'help' for available commands.\\n\",\n                A::S(c)\n            );\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// libc bindings needed for the (locale/timezone dependent) `time` command\n// ---------------------------------------------------------------------------\n\nextern \"C\" {\n    #[link_name = \"time\"]\n    fn libc_time(t: *mut i64) -> i64;\n    #[link_name = \"ctime\"]\n    fn libc_ctime(t: *const i64) -> *const std::os::raw::c_char;\n}\n\n// ---------------------------------------------------------------------------\n// Tokenizer (strtok on \" \\t\")\n// ---------------------------------------------------------------------------\n\nfn parse_command(input: &[u8]) -> (Vec<u8>, Vec<Vec<u8>>) {\n    // char temp[MAX_INPUT]; strncpy(temp, input, MAX_INPUT - 1);\n    // temp[MAX_INPUT - 1] = '\\0';\n    let limit = input.len().min(MAX_INPUT - 1);\n    let temp = &input[..limit];\n\n    let mut cmd: Vec<u8> = Vec::new();\n    let mut args: Vec<Vec<u8>> = Vec::new();\n\n    let mut tokens = temp\n        .split(|&c| c == b' ' || c == b'\\t')\n        .filter(|t| !t.is_empty());\n\n    if let Some(tok) = tokens.next() {\n        let n = tok.len().min(MAX_COMMAND - 1);\n        cmd.extend_from_slice(&tok[..n]);\n\n        for tok in tokens {\n            if args.len() >= MAX_ARGS {\n                break;\n            }\n            let n = tok.len().min(MAX_COMMAND - 1);\n            args.push(tok[..n].to_vec());\n        }\n    }\n\n    (cmd, args)\n}\n\n// ---------------------------------------------------------------------------\n// fgets emulation\n// ---------------------------------------------------------------------------\n\n/// `fgets(buf, size, stdin)` -- returns the bytes read (newline included) or\n/// `None` at end-of-file with nothing read.\nfn fgets<R: BufRead>(r: &mut R, size: usize) -> Option<Vec<u8>> {\n    let mut out: Vec<u8> = Vec::new();\n    loop {\n        if out.len() + 1 >= size {\n            return Some(out);\n        }\n        let (chunk, had_nl) = {\n            let buf = match r.fill_buf() {\n                Ok(b) => b,\n                Err(_) => {\n                    return if out.is_empty() { None } else { Some(out) };\n                }\n            };\n            if buf.is_empty() {\n                return if out.is_empty() { None } else { Some(out) };\n            }\n            let remaining = size - 1 - out.len();\n            let take = buf.len().min(remaining);\n            let slice = &buf[..take];\n            match slice.iter().position(|&c| c == b'\\n') {\n                Some(p) => (slice[..=p].to_vec(), true),\n                None => (slice.to_vec(), false),\n            }\n        };\n        let n = chunk.len();\n        out.extend_from_slice(&chunk);\n        r.consume(n);\n        if had_nl {\n            return Some(out);\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// main\n// ---------------------------------------------------------------------------\n\nfn main() {\n    let mut st = State::new();\n\n    pf!(st, \"|----------------------------------------|\\n\");\n    pf!(st, \"|   COMMAND INTERPRETER                  |\\n\");\n    pf!(st, \"|   strcmp/strncmp demonstration         |\\n\");\n    pf!(st, \"|----------------------------------------|\\n\");\n    pf!(st, \"Type 'help' for available commands\\n\\n\");\n\n    let stdin = std::io::stdin();\n    let mut reader = BufReader::new(StdinRead(stdin));\n\n    loop {\n        pf!(st, \"> \");\n\n        let raw = match fgets(&mut reader, MAX_INPUT) {\n            Some(v) => v,\n            None => break,\n        };\n\n        // input[strcspn(input, \"\\n\")] = 0;\n        let cut = raw\n            .iter()\n            .position(|&c| c == b'\\n' || c == 0)\n            .unwrap_or(raw.len());\n        let input = &raw[..cut];\n\n        if st.verbose_mode != 0 {\n            pf!(st, \"[VERBOSE] Processing: '%s'\\n\", A::S(input));\n        }\n\n        let owned = input.to_vec();\n        st.process_command(&owned);\n    }\n\n    st.flush();\n}\n\n/// Thin `Read` adapter so `BufReader` owns the stdin handle.\nstruct StdinRead(std::io::Stdin);\n\nimpl Read for StdinRead {\n    fn read(&mut self, buf: &mut [u8]) -> std::io::Result<usize> {\n        self.0.lock().read(buf)\n    }\n}\n","numLines":1224,"startLine":1,"totalLines":1224}}}
