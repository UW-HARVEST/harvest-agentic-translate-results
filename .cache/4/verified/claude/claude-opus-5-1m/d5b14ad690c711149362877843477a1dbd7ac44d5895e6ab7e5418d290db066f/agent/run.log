\n53\t    char name[32];\n54\t    char value[128];\n55\t} variable_t;\n56\t\n57\t// Global state\n58\tstatic user_t users[MAX_USERS];\n59\tstatic int user_count = 0;\n60\tstatic user_t *current_user = NULL;\n61\t\n62\tstatic file_t files[MAX_FILES];\n63\tstatic int file_count = 0;\n64\t\n65\tstatic variable_t variables[MAX_VARIABLES];\n66\tstatic int variable_count = 0;\n67\t\n68\tstatic int debug_mode = 0;\n69\tstatic int verbose_mode = 0;\n70\t\n71\t// Parse command and arguments\n72\tvoid parse_command(const char *input, char *cmd, char args[][MAX_COMMAND], int *arg_count) {\n73\t    char temp[MAX_INPUT];\n74\t    strncpy(temp, input, MAX_INPUT - 1);\n75\t    temp[MAX_INPUT - 1] = '\\0';\n76\t    \n77\t    *arg_count = 0;\n78\t    char *token = strtok(temp, \" \\t\");\n79\t    \n80\t    if (token) {\n81\t        strncpy(cmd, token, MAX_COMMAND - 1);\n82\t        cmd[MAX_COMMAND - 1] = '\\0';\n83\t        \n84\t        while ((token = strtok(NULL, \" \\t\")) && *arg_count < MAX_ARGS) {\n85\t            strncpy(args[*arg_count], token, MAX_COMMAND - 1);\n86\t            args[*arg_count][MAX_COMMAND - 1] = '\\0';\n87\t            (*arg_count)++;\n88\t        }\n89\t    }\n90\t}\n91\t\n92\t// User management commands\n93\tvoid cmd_adduser(char args[][MAX_COMMAND], int arg_count) {\n94\t    if (arg_count < 2) {\n95\t        printf(\"Usage: adduser <username> <password> [permission_level]\\n\");\n96\t        return;\n97\t    }\n98\t    \n99\t    if (user_count >= MAX_USERS) {\n100\t        printf(\"Error: Maximum users reached\\n\");\n101\t        return;\n102\t    }\n103\t    \n104\t    // Check if user already exists using strcmp\n105\t    for (int i = 0; i < user_count; i++) {\n106\t        if (strcmp(users[i].name, args[0]) == 0) {\n107\t            printf(\"Error: User '%s' already exists\\n\", args[0]);\n108\t            return;\n109\t        }\n110\t    }\n111\t    \n112\t    strcpy(users[user_count].name, args[0]);\n113\t    strcpy(users[user_count].password, args[1]);\n114\t    users[user_count].permission_level = (arg_count >= 3) ? atoi(args[2]) : 1;\n115\t    users[user_count].logged_in = 0;\n116\t    user_count++;\n117\t    \n118\t    printf(\"User '%s' added with permission level %d\\n\", \n119\t           args[0], users[user_count - 1].permission_level);\n120\t}\n121\t\n122\tvoid cmd_login(char args[][MAX_COMMAND], int arg_count) {\n123\t    if (arg_count < 2) {\n124\t        printf(\"Usage: login <username> <password>\\n\");\n125\t        return;\n126\t    }\n127\t    \n128\t    if (current_user && current_user->logged_in) {\n129\t        printf(\"Error: User '%s' already logged in. Use 'logout' first.\\n\", \n130\t               current_user->name);\n131\t        return;\n132\t    }\n133\t    \n134\t    // Find user and verify password using strcmp\n135\t    for (int i = 0; i < user_count; i++) {\n136\t        if (strcmp(users[i].name, args[0]) == 0) {\n137\t            if (strcmp(users[i].password, args[1]) == 0) {\n138\t                users[i].logged_in = 1;\n139\t                current_user = &users[i];\n140\t                printf(\"Login successful. Welcome, %s!\\n\", current_user->name);\n141\t                return;\n142\t            } else {\n143\t                printf(\"Error: Incorrect password\\n\");\n144\t                return;\n145\t            }\n146\t        }\n147\t    }\n148\t    \n149\t    printf(\"Error: User not found\\n\");\n150\t}\n151\t\n152\tvoid cmd_logout(void) {\n153\t    if (!current_user || !current_user->logged_in) {\n154\t        printf(\"Error: No user logged in\\n\");\n155\t        return;\n156\t    }\n157\t    \n158\t    printf(\"Goodbye, %s!\\n\", current_user->name);\n159\t    current_user->logged_in = 0;\n160\t    current_user = NULL;\n161\t}\n162\t\n163\tvoid cmd_whoami(void) {\n164\t    if (!current_user || !current_user->logged_in) {\n165\t        printf(\"Not logged in\\n\");\n166\t        return;\n167\t    }\n168\t    \n169\t    printf(\"Current user: %s\\n\", current_user->name);\n170\t    printf(\"Permission level: %d\\n\", current_user->permission_level);\n171\t}\n172\t\n173\tvoid cmd_listusers(void) {\n174\t    if (user_count == 0) {\n175\t        printf(\"No users registered\\n\");\n176\t        return;\n177\t    }\n178\t    \n179\t    printf(\"Registered users:\\n\");\n180\t    for (int i = 0; i < user_count; i++) {\n181\t        printf(\"  %s (level %d) %s\\n\", \n182\t               users[i].name, \n183\t               users[i].permission_level,\n184\t               users[i].logged_in ? \"[logged in]\" : \"\");\n185\t    }\n186\t}\n187\t\n188\t// File management commands\n189\tvoid cmd_createfile(char args[][MAX_COMMAND], int arg_count) {\n190\t    if (!current_user || !current_user->logged_in) {\n191\t        printf(\"Error: Must be logged in\\n\");\n192\t        return;\n193\t    }\n194\t    \n195\t    if (arg_count < 1) {\n196\t        printf(\"Usage: createfile <filename> [content]\\n\");\n197\t        return;\n198\t    }\n199\t    \n200\t    if (file_count >= MAX_FILES) {\n201\t        printf(\"Error: Maximum files reached\\n\");\n202\t        return;\n203\t    }\n204\t    \n205\t    // Check if file exists using strcmp\n206\t    for (int i = 0; i < file_count; i++) {\n207\t        if (strcmp(files[i].filename, args[0]) == 0) {\n208\t            printf(\"Error: File '%s' already exists\\n\", args[0]);\n209\t            return;\n210\t        }\n211\t    }\n212\t    \n213\t    strcpy(files[file_count].filename, args[0]);\n214\t    strcpy(files[file_count].owner, current_user->name);\n215\t    files[file_count].permissions = 755;\n216\t    \n217\t    if (arg_count >= 2) {\n218\t        strcpy(files[file_count].content, args[1]);\n219\t    } else {\n220\t        files[file_count].content[0] = '\\0';\n221\t    }\n222\t    \n223\t    file_count++;\n224\t    printf(\"File '%s' created\\n\", args[0]);\n225\t}\n226\t\n227\tvoid cmd_readfile(char args[][MAX_COMMAND], int arg_count) {\n228\t    if (arg_count < 1) {\n229\t        printf(\"Usage: readfile <filename>\\n\");\n230\t        return;\n231\t    }\n232\t    \n233\t    // Find file using strcmp\n234\t    for (int i = 0; i < file_count; i++) {\n235\t        if (strcmp(files[i].filename, args[0]) == 0) {\n236\t            printf(\"=== %s ===\\n\", files[i].filename);\n237\t            printf(\"Owner: %s\\n\", files[i].owner);\n238\t            printf(\"Permissions: %d\\n\", files[i].permissions);\n239\t            printf(\"Content: %s\\n\", files[i].content);\n240\t            return;\n241\t        }\n242\t    }\n243\t    \n244\t    printf(\"Error: File '%s' not found\\n\", args[0]);\n245\t}\n246\t\n247\tvoid cmd_writefile(char args[][MAX_COMMAND], int arg_count) {\n248\t    if (!current_user || !current_user->logged_in) {\n249\t        printf(\"Error: Must be logged in\\n\");\n250\t        return;\n251\t    }\n252\t    \n253\t    if (arg_count < 2) {\n254\t        printf(\"Usage: writefile <filename> <content>\\n\");\n255\t        return;\n256\t    }\n257\t    \n258\t    // Find file and check ownership\n259\t    for (int i = 0; i < file_count; i++) {\n260\t        if (strcmp(files[i].filename, args[0]) == 0) {\n261\t            // Check if current user owns the file\n262\t            if (strcmp(files[i].owner, current_user->name) == 0 || \n263\t                current_user->permission_level >= 5) {\n264\t                strcpy(files[i].content, args[1]);\n265\t                printf(\"File '%s' updated\\n\", args[0]);\n266\t                return;\n267\t            } else {\n268\t                printf(\"Error: Permission denied\\n\");\n269\t                return;\n270\t            }\n271\t        }\n272\t    }\n273\t    \n274\t    printf(\"Error: File '%s' not found\\n\", args[0]);\n275\t}\n276\t\n277\tvoid cmd_deletefile(char args[][MAX_COMMAND], int arg_count) {\n278\t    if (!current_user || !current_user->logged_in) {\n279\t        printf(\"Error: Must be logged in\\n\");\n280\t        return;\n281\t    }\n282\t    \n283\t    if (arg_count < 1) {\n284\t        printf(\"Usage: deletefile <filename>\\n\");\n285\t        return;\n286\t    }\n287\t    \n288\t    // Find and delete file\n289\t    for (int i = 0; i < file_count; i++) {\n290\t        if (strcmp(files[i].filename, args[0]) == 0) {\n291\t            if (strcmp(files[i].owner, current_user->name) == 0 || \n292\t                current_user->permission_level >= 9) {\n293\t                // Shift remaining files\n294\t                for (int j = i; j < file_count - 1; j++) {\n295\t                    files[j] = files[j + 1];\n296\t                }\n297\t                file_count--;\n298\t                printf(\"File '%s' deleted\\n\", args[0]);\n299\t                return;\n300\t            } else {\n301\t                printf(\"Error: Permission denied\\n\");\n302\t                return;\n303\t            }\n304\t        }\n305\t    }\n306\t    \n307\t    printf(\"Error: File '%s' not found\\n\", args[0]);\n308\t}\n309\t\n310\tvoid cmd_listfiles(void) {\n311\t    if (file_count == 0) {\n312\t        printf(\"No files\\n\");\n313\t        return;\n314\t    }\n315\t    \n316\t    printf(\"Files:\\n\");\n317\t    for (int i = 0; i < file_count; i++) {\n318\t        printf(\"  %s (owner: %s, perm: %d)\\n\", \n319\t               files[i].filename, files[i].owner, files[i].permissions);\n320\t    }\n321\t}\n322\t\n323\t// Variable commands\n324\tvoid cmd_set(char args[][MAX_COMMAND], int arg_count) {\n325\t    if (arg_count < 2) {\n326\t        printf(\"Usage: set <name> <value>\\n\");\n327\t        return;\n328\t    }\n329\t    \n330\t    // Check if variable exists\n331\t    for (int i = 0; i < variable_count; i++) {\n332\t        if (strcmp(variables[i].name, args[0]) == 0) {\n333\t            strcpy(variables[i].value, args[1]);\n334\t            printf(\"Variable '%s' updated\\n\", args[0]);\n335\t            return;\n336\t        }\n337\t    }\n338\t    \n339\t    // Create new variable\n340\t    if (variable_count >= MAX_VARIABLES) {\n341\t        printf(\"Error: Maximum variables reached\\n\");\n342\t        return;\n343\t    }\n344\t    \n345\t    strcpy(variables[variable_count].name, args[0]);\n346\t    strcpy(variables[variable_count].value, args[1]);\n347\t    variable_count++;\n348\t    printf(\"Variable '%s' set\\n\", args[0]);\n349\t}\n350\t\n351\tvoid cmd_get(char args[][MAX_COMMAND], int arg_count) {\n352\t    if (arg_count < 1) {\n353\t        printf(\"Usage: get <name>\\n\");\n354\t        return;\n355\t    }\n356\t    \n357\t    for (int i = 0; i < variable_count; i++) {\n358\t        if (strcmp(variables[i].name, args[0]) == 0) {\n359\t            printf(\"%s = %s\\n\", variables[i].name, variables[i].value);\n360\t            return;\n361\t        }\n362\t    }\n363\t    \n364\t    printf(\"Error: Variable '%s' not found\\n\", args[0]);\n365\t}\n366\t\n367\tvoid cmd_unset(char args[][MAX_COMMAND], int arg_count) {\n368\t    if (arg_count < 1) {\n369\t        printf(\"Usage: unset <name>\\n\");\n370\t        return;\n371\t    }\n372\t    \n373\t    for (int i = 0; i < variable_count; i++) {\n374\t        if (strcmp(variables[i].name, args[0]) == 0) {\n375\t            for (int j = i; j < variable_count - 1; j++) {\n376\t                variables[j] = variables[j + 1];\n377\t            }\n378\t            variable_count--;\n379\t            printf(\"Variable '%s' unset\\n\", args[0]);\n380\t            return;\n381\t        }\n382\t    }\n383\t    \n384\t    printf(\"Error: Variable '%s' not found\\n\", args[0]);\n385\t}\n386\t\n387\tvoid cmd_listvars(void) {\n388\t    if (variable_count == 0) {\n389\t        printf(\"No variables set\\n\");\n390\t        return;\n391\t    }\n392\t    \n393\t    printf(\"Variables:\\n\");\n394\t    for (int i = 0; i < variable_count; i++) {\n395\t        printf(\"  %s = %s\\n\", variables[i].name, variables[i].value);\n396\t    }\n397\t}\n398\t\n399\t// String comparison commands\n400\tvoid cmd_compare(char args[][MAX_COMMAND], int arg_count) {\n401\t    if (arg_count < 2) {\n402\t        printf(\"Usage: compare <string1> <string2>\\n\");\n403\t        return;\n404\t    }\n405\t    \n406\t    int result = strcmp(args[0], args[1]);\n407\t    \n408\t    printf(\"strcmp('%s', '%s') = %d\\n\", args[0], args[1], result);\n409\t    \n410\t    if (result == 0) {\n411\t        printf(\"Strings are equal\\n\");\n412\t    } else if (result < 0) {\n413\t        printf(\"'%s' < '%s'\\n\", args[0], args[1]);\n414\t    } else {\n415\t        printf(\"'%s' > '%s'\\n\", args[0], args[1]);\n416\t    }\n417\t}\n418\t\n419\tvoid cmd_compareN(char args[][MAX_COMMAND], int arg_count) {\n420\t    if (arg_count < 3) {\n421\t        printf(\"Usage: compareN <string1> <string2> <n>\\n\");\n422\t        return;\n423\t    }\n424\t    \n425\t    int n = atoi(args[2]);\n426\t    int result = strncmp(args[0], args[1], n);\n427\t    \n428\t    printf(\"strncmp('%s', '%s', %d) = %d\\n\", args[0], args[1], n, result);\n429\t    \n430\t    if (result == 0) {\n431\t        printf(\"First %d characters are equal\\n\", n);\n432\t    } else if (result < 0) {\n433\t        printf(\"'%s' < '%s' (first %d chars)\\n\", args[0], args[1], n);\n434\t    } else {\n435\t        printf(\"'%s' > '%s' (first %d chars)\\n\", args[0], args[1], n);\n436\t    }\n437\t}\n438\t\n439\tvoid cmd_startswith(char args[][MAX_COMMAND], int arg_count) {\n440\t    if (arg_count < 2) {\n441\t        printf(\"Usage: startswith <string> <prefix>\\n\");\n442\t        return;\n443\t    }\n444\t    \n445\t    size_t prefix_len = strlen(args[1]);\n446\t    \n447\t    if (strncmp(args[0], args[1], prefix_len) == 0) {\n448\t        printf(\"'%s' starts with '%s'\\n\", args[0], args[1]);\n449\t    } else {\n450\t        printf(\"'%s' does not start with '%s'\\n\", args[0], args[1]);\n451\t    }\n452\t}\n453\t\n454\tvoid cmd_match(char args[][MAX_COMMAND], int arg_count) {\n455\t    if (arg_count < 2) {\n456\t        printf(\"Usage: match <pattern> <string1> [string2] ...\\n\");\n457\t        return;\n458\t    }\n459\t    \n460\t    printf(\"Matching pattern '%s':\\n\", args[0]);\n461\t    int matches = 0;\n462\t    \n463\t    for (int i = 1; i < arg_count; i++) {\n464\t        if (strcmp(args[0], args[i]) == 0) {\n465\t            printf(\"  '%s' - EXACT MATCH\\n\", args[i]);\n466\t            matches++;\n467\t        } else if (strstr(args[i], args[0]) != NULL) {\n468\t            printf(\"  '%s' - contains pattern\\n\", args[i]);\n469\t            matches++;\n470\t        } else {\n471\t            printf(\"  '%s' - no match\\n\", args[i]);\n472\t        }\n473\t    }\n474\t    \n475\t    printf(\"Total matches: %d\\n\", matches);\n476\t}\n477\t\n478\t// System commands\n479\tvoid cmd_help(void) {\n480\t    printf(\"\\n=== Command Interpreter Help ===\\n\");\n481\t    printf(\"User Management:\\n\");\n482\t    printf(\"  adduser <user> <pass> [level] - Add new user\\n\");\n483\t    printf(\"  login <user> <pass>            - Login as user\\n\");\n484\t    printf(\"  logout                         - Logout current user\\n\");\n485\t    printf(\"  whoami                         - Show current user\\n\");\n486\t    printf(\"  listusers                      - List all users\\n\");\n487\t    printf(\"\\nFile Management:\\n\");\n488\t    printf(\"  createfile <name> [content]    - Create file\\n\");\n489\t    printf(\"  readfile <name>                - Read file\\n\");\n490\t    printf(\"  writefile <name> <content>     - Write to file\\n\");\n491\t    printf(\"  deletefile <name>              - Delete file\\n\");\n492\t    printf(\"  listfiles                      - List all files\\n\");\n493\t    printf(\"\\nVariable Management:\\n\");\n494\t    printf(\"  set <name> <value>             - Set variable\\n\");\n495\t    printf(\"  get <name>                     - Get variable\\n\");\n496\t    printf(\"  unset <name>                   - Unset variable\\n\");\n497\t    printf(\"  listvars                       - List all variables\\n\");\n498\t    printf(\"\\nString Operations:\\n\");\n499\t    printf(\"  compare <str1> <str2>          - Compare strings\\n\");\n500\t    printf(\"  compareN <str1> <str2> <n>     - Compare first N chars\\n\");\n501\t    printf(\"  startswith <str> <prefix>      - Check if starts with\\n\");\n502\t    printf(\"  match <pattern> <str> ...      - Match pattern\\n\");\n503\t    printf(\"\\nSystem:\\n\");\n504\t    printf(\"  debug [on|off]                 - Toggle debug mode\\n\");\n505\t    printf(\"  verbose [on|off]               - Toggle verbose mode\\n\");\n506\t    printf(\"  status                         - Show system status\\n\");\n507\t    printf(\"  time                           - Show current time\\n\");\n508\t    printf(\"  help                           - Show this help\\n\");\n509\t    printf(\"  exit                           - Exit program\\n\");\n510\t}\n511\t\n512\tvoid cmd_debug(char args[][MAX_COMMAND], int arg_count) {\n513\t    if (arg_count < 1) {\n514\t        printf(\"Debug mode: %s\\n\", debug_mode ? \"ON\" : \"OFF\");\n515\t        return;\n516\t    }\n517\t    \n518\t    if (strcmp(args[0], \"on\") == 0) {\n519\t        debug_mode = 1;\n520\t        printf(\"Debug mode enabled\\n\");\n521\t    } else if (strcmp(args[0], \"off\") == 0) {\n522\t        debug_mode = 0;\n523\t        printf(\"Debug mode disabled\\n\");\n524\t    } else {\n525\t        printf(\"Usage: debug [on|off]\\n\");\n526\t    }\n527\t}\n528\t\n529\tvoid cmd_verbose(char args[][MAX_COMMAND], int arg_count) {\n530\t    if (arg_count < 1) {\n531\t        printf(\"Verbose mode: %s\\n\", verbose_mode ? \"ON\" : \"OFF\");\n532\t        return;\n533\t    }\n534\t    \n535\t    if (strcmp(args[0], \"on\") == 0) {\n536\t        verbose_mode = 1;\n537\t        printf(\"Verbose mode enabled\\n\");\n538\t    } else if (strcmp(args[0], \"off\") == 0) {\n539\t        verbose_mode = 0;\n540\t        printf(\"Verbose mode disabled\\n\");\n541\t    } else {\n542\t        printf(\"Usage: verbose [on|off]\\n\");\n543\t    }\n544\t}\n545\t\n546\tvoid cmd_status(void) {\n547\t    printf(\"\\n=== System Status ===\\n\");\n548\t    printf(\"Users: %d/%d\\n\", user_count, MAX_USERS);\n549\t    printf(\"Files: %d/%d\\n\", file_count, MAX_FILES);\n550\t    printf(\"Variables: %d/%d\\n\", variable_count, MAX_VARIABLES);\n551\t    printf(\"Current user: %s\\n\", \n552\t           (current_user && current_user->logged_in) ? current_user->name : \"none\");\n553\t    printf(\"Debug mode: %s\\n\", debug_mode ? \"ON\" : \"OFF\");\n554\t    printf(\"Verbose mode: %s\\n\", verbose_mode ? \"ON\" : \"OFF\");\n555\t}\n556\t\n557\tvoid cmd_time(void) {\n558\t    time_t now = time(NULL);\n559\t    printf(\"Current time: %s\", ctime(&now));\n560\t}\n561\t\n562\t// Main command processor using extensive strcmp/strncmp\n563\tvoid process_command(const char *input) {\n564\t    char command[MAX_COMMAND];\n565\t    char args[MAX_ARGS][MAX_COMMAND];\n566\t    int arg_count = 0;\n567\t    \n568\t    parse_command(input, command, args, &arg_count);\n569\t    \n570\t    if (strlen(command) == 0) {\n571\t        return;\n572\t    }\n573\t    \n574\t    if (debug_mode) {\n575\t        printf(\"[DEBUG] Command: '%s', Args: %d\\n\", command, arg_count);\n576\t    }\n577\t    \n578\t    // Command routing using strcmp and strncmp\n579\t    // User commands\n580\t    if (strcmp(command, \"adduser\") == 0) {\n581\t        cmd_adduser(args, arg_count);\n582\t    } else if (strcmp(command, \"login\") == 0) {\n583\t        cmd_login(args, arg_count);\n584\t    } else if (strcmp(command, \"logout\") == 0) {\n585\t        cmd_logout();\n586\t    } else if (strcmp(command, \"whoami\") == 0) {\n587\t        cmd_whoami();\n588\t    } else if (strcmp(command, \"listusers\") == 0 || strcmp(command, \"users\") == 0) {\n589\t        cmd_listusers();\n590\t    }\n591\t    // File commands\n592\t    else if (strcmp(command, \"createfile\") == 0 || strcmp(command, \"touch\") == 0) {\n593\t        cmd_createfile(args, arg_count);\n594\t    } else if (strcmp(command, \"readfile\") == 0 || strcmp(command, \"cat\") == 0) {\n595\t        cmd_readfile(args, arg_count);\n596\t    } else if (strcmp(command, \"writefile\") == 0 || strcmp(command, \"write\") == 0) {\n597\t        cmd_writefile(args, arg_count);\n598\t    } else if (strcmp(command, \"deletefile\") == 0 || strcmp(command, \"rm\") == 0) {\n599\t        cmd_deletefile(args, arg_count);\n600\t    } else if (strcmp(command, \"listfiles\") == 0 || strcmp(command, \"ls\") == 0) {\n601\t        cmd_listfiles();\n602\t    }\n603\t    // Variable commands\n604\t    else if (strcmp(command, \"set\") == 0) {\n605\t        cmd_set(args, arg_count);\n606\t    } else if (strcmp(command, \"get\") == 0) {\n607\t        cmd_get(args, arg_count);\n608\t    } else if (strcmp(command, \"unset\") == 0) {\n609\t        cmd_unset(args, arg_count);\n610\t    } else if (strcmp(command, \"listvars\") == 0 || strcmp(command, \"vars\") == 0) {\n611\t        cmd_listvars();\n612\t    }\n613\t    // String comparison commands\n614\t    else if (strcmp(command, \"compare\") == 0 || strcmp(command, \"cmp\") == 0) {\n615\t        cmd_compare(args, arg_count);\n616\t    } else if (strcmp(command, \"compareN\") == 0 || strcmp(command, \"cmpn\") == 0) {\n617\t        cmd_compareN(args, arg_count);\n618\t    } else if (strcmp(command, \"startswith\") == 0) {\n619\t        cmd_startswith(args, arg_count);\n620\t    } else if (strcmp(command, \"match\") == 0) {\n621\t        cmd_match(args, arg_count);\n622\t    }\n623\t    // System commands\n624\t    else if (strcmp(command, \"debug\") == 0) {\n625\t        cmd_debug(args, arg_count);\n626\t    } else if (strcmp(command, \"verbose\") == 0) {\n627\t        cmd_verbose(args, arg_count);\n628\t    } else if (strcmp(command, \"status\") == 0) {\n629\t        cmd_status();\n630\t    } else if (strcmp(command, \"time\") == 0) {\n631\t        cmd_time();\n632\t    } else if (strcmp(command, \"help\") == 0 || strcmp(command, \"?\") == 0) {\n633\t        cmd_help();\n634\t    } else if (strcmp(command, \"exit\") == 0 || strcmp(command, \"quit\") == 0) {\n635\t        printf(\"Goodbye!\\n\");\n636\t        exit(0);\n637\t    }\n638\t    // Check for partial matches using strncmp\n639\t    else if (strncmp(command, \"add\", 3) == 0) {\n640\t        printf(\"Did you mean 'adduser'?\\n\");\n641\t    } else if (strncmp(command, \"log\", 3) == 0) {\n642\t        printf(\"Did you mean 'login' or 'logout'?\\n\");\n643\t    } else if (strncmp(command, \"list\", 4) == 0) {\n644\t        printf(\"Did you mean 'listusers', 'listfiles', or 'listvars'?\\n\");\n645\t    } else if (strncmp(command, \"create\", 6) == 0) {\n646\t        printf(\"Did you mean 'createfile'?\\n\");\n647\t    } else if (strncmp(command, \"read\", 4) == 0) {\n648\t        printf(\"Did you mean 'readfile'?\\n\");\n649\t    } else if (strncmp(command, \"write\", 5) == 0) {\n650\t        printf(\"Did you mean 'writefile'?\\n\");\n651\t    } else if (strncmp(command, \"delete\", 6) == 0) {\n652\t        printf(\"Did you mean 'deletefile'?\\n\");\n653\t    } else {\n654\t        printf(\"Unknown command: '%s'. Type 'help' for available commands.\\n\", command);\n655\t    }\n656\t}\n657\t\n658\tint main(void) {\n659\t    printf(\"|----------------------------------------|\\n\");\n660\t    printf(\"|   COMMAND INTERPRETER                  |\\n\");\n661\t    printf(\"|   strcmp/strncmp demonstration         |\\n\");\n662\t    printf(\"|----------------------------------------|\\n\");\n663\t    printf(\"Type 'help' for available commands\\n\\n\");\n664\t    \n665\t    char input[MAX_INPUT];\n666\t    \n667\t    while (1) {\n668\t        printf(\"> \");\n669\t        \n670\t        if (fgets(input, MAX_INPUT, stdin) == NULL) {\n671\t            break;\n672\t        }\n673\t        \n674\t        // Remove newline\n675\t        input[strcspn(input, \"\\n\")] = 0;\n676\t        \n677\t        if (verbose_mode) {\n678\t            printf(\"[VERBOSE] Processing: '%s'\\n\", input);\n679\t        }\n680\t        \n681\t        process_command(input);\n682\t    }\n683\t    \n684\t    return 0;\n685\t}\n686\t"}]},"parent_tool_use_id":null,"session_id":"8414a394-b54a-4582-aae8-c81f9c4a1ffc","uuid":"9e7166ac-5cf4-4f5e-9f60-c3e69cf1d7a4","timestamp":"2026-08-19T23:14:53.995Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-K4LqH9/translated_rust/c_src/src/main.c","content":"/*\n * Copyright 2025 MIT Lincoln Laboratory\n * Permission is hereby granted, free of charge,\n * to any person obtaining a copy of this software\n * and associated documentation files (the \"Software\"),\n * to deal in the Software without restriction,\n * including without limitation the rights to use, copy,\n * modify, merge, publish, distribute, sublicense,\n * and/or sell copies of the Software,\n * and to permit persons to whom the Software is furnished to do so,\n * subject to the following conditions:\n * \n * The above copyright notice and this permission notice\n * shall be included in all copies or substantial portions of the Software.\n * \n * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n * THE WARRANTIES OF MERCHANTABILITY,\n * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n */\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <ctype.h>\n#include <time.h>\n\n#define MAX_INPUT 256\n#define MAX_COMMAND 64\n#define MAX_ARGS 10\n#define MAX_FILES 20\n#define MAX_USERS 10\n#define MAX_VARIABLES 20\n\ntypedef struct {\n    char name[32];\n    char password[32];\n    int permission_level;\n    int logged_in;\n} user_t;\n\ntypedef struct {\n    char filename[64];\n    char content[512];\n    char owner[32];\n    int permissions;\n} file_t;\n\ntypedef struct {\n    char name[32];\n    char value[128];\n} variable_t;\n\n// Global state\nstatic user_t users[MAX_USERS];\nstatic int user_count = 0;\nstatic user_t *current_user = NULL;\n\nstatic file_t files[MAX_FILES];\nstatic int file_count = 0;\n\nstatic variable_t variables[MAX_VARIABLES];\nstatic int variable_count = 0;\n\nstatic int debug_mode = 0;\nstatic int verbose_mode = 0;\n\n// Parse command and arguments\nvoid parse_command(const char *input, char *cmd, char args[][MAX_COMMAND], int *arg_count) {\n    char temp[MAX_INPUT];\n    strncpy(temp, input, MAX_INPUT - 1);\n    temp[MAX_INPUT - 1] = '\\0';\n    \n    *arg_count = 0;\n    char *token = strtok(temp, \" \\t\");\n    \n    if (token) {\n        strncpy(cmd, token, MAX_COMMAND - 1);\n        cmd[MAX_COMMAND - 1] = '\\0';\n        \n        while ((token = strtok(NULL, \" \\t\")) && *arg_count < MAX_ARGS) {\n            strncpy(args[*arg_count], token, MAX_COMMAND - 1);\n            args[*arg_count][MAX_COMMAND - 1] = '\\0';\n            (*arg_count)++;\n        }\n    }\n}\n\n// User management commands\nvoid cmd_adduser(char args[][MAX_COMMAND], int arg_count) {\n    if (arg_count < 2) {\n        printf(\"Usage: adduser <username> <password> [permission_level]\\n\");\n        return;\n    }\n    \n    if (user_count >= MAX_USERS) {\n        printf(\"Error: Maximum users reached\\n\");\n        return;\n    }\n    \n    // Check if user already exists using strcmp\n    for (int i = 0; i < user_count; i++) {\n        if (strcmp(users[i].name, args[0]) == 0) {\n            printf(\"Error: User '%s' already exists\\n\", args[0]);\n            return;\n        }\n    }\n    \n    strcpy(users[user_count].name, args[0]);\n    strcpy(users[user_count].password, args[1]);\n    users[user_count].permission_level = (arg_count >= 3) ? atoi(args[2]) : 1;\n    users[user_count].logged_in = 0;\n    user_count++;\n    \n    printf(\"User '%s' added with permission level %d\\n\", \n           args[0], users[user_count - 1].permission_level);\n}\n\nvoid cmd_login(char args[][MAX_COMMAND], int arg_count) {\n    if (arg_count < 2) {\n        printf(\"Usage: login <username> <password>\\n\");\n        return;\n    }\n    \n    if (current_user && current_user->logged_in) {\n        printf(\"Error: User '%s' already logged in. Use 'logout' first.\\n\", \n               current_user->name);\n        return;\n    }\n    \n    // Find user and verify password using strcmp\n    for (int i = 0; i < user_count; i++) {\n        if (strcmp(users[i].name, args[0]) == 0) {\n            if (strcmp(users[i].password, args[1]) == 0) {\n                users[i].logged_in = 1;\n                current_user = &users[i];\n                printf(\"Login successful. Welcome, %s!\\n\", current_user->name);\n                return;\n            } else {\n                printf(\"Error: Incorrect password\\n\");\n                return;\n            }\n        }\n    }\n    \n    printf(\"Error: User not found\\n\");\n}\n\nvoid cmd_logout(void) {\n    if (!current_user || !current_user->logged_in) {\n        printf(\"Error: No user logged in\\n\");\n        return;\n    }\n    \n    printf(\"Goodbye, %s!\\n\", current_user->name);\n    current_user->logged_in = 0;\n    current_user = NULL;\n}\n\nvoid cmd_whoami(void) {\n    if (!current_user || !current_user->logged_in) {\n        printf(\"Not logged in\\n\");\n        return;\n    }\n    \n    printf(\"Current user: %s\\n\", current_user->name);\n    printf(\"Permission level: %d\\n\", current_user->permission_level);\n}\n\nvoid cmd_listusers(void) {\n    if (user_count == 0) {\n        printf(\"No users registered\\n\");\n        return;\n    }\n    \n    printf(\"Registered users:\\n\");\n    for (int i = 0; i < user_count; i++) {\n        printf(\"  %s (level %d) %s\\n\", \n               users[i].name, \n               users[i].permission_level,\n               users[i].logged_in ? \"[logged in]\" : \"\");\n    }\n}\n\n// File management commands\nvoid cmd_createfile(char args[][MAX_COMMAND], int arg_count) {\n    if (!current_user || !current_user->logged_in) {\n        printf(\"Error: Must be logged in\\n\");\n        return;\n    }\n    \n    if (arg_count < 1) {\n        printf(\"Usage: createfile <filename> [content]\\n\");\n        return;\n    }\n    \n    if (file_count >= MAX_FILES) {\n        printf(\"Error: Maximum files reached\\n\");\n        return;\n    }\n    \n    // Check if file exists using strcmp\n    for (int i = 0; i < file_count; i++) {\n        if (strcmp(files[i].filename, args[0]) == 0) {\n            printf(\"Error: File '%s' already exists\\n\", args[0]);\n            return;\n        }\n    }\n    \n    strcpy(files[file_count].filename, args[0]);\n    strcpy(files[file_count].owner, current_user->name);\n    files[file_count].permissions = 755;\n    \n    if (arg_count >= 2) {\n        strcpy(files[file_count].content, args[1]);\n    } else {\n        files[file_count].content[0] = '\\0';\n    }\n    \n    file_count++;\n    printf(\"File '%s' created\\n\", args[0]);\n}\n\nvoid cmd_readfile(char args[][MAX_COMMAND], int arg_count) {\n    if (arg_count < 1) {\n        printf(\"Usage: readfile <filename>\\n\");\n        return;\n    }\n    \n    // Find file using strcmp\n    for (int i = 0; i < file_count; i++) {\n        if (strcmp(files[i].filename, args[0]) == 0) {\n            printf(\"=== %s ===\\n\", files[i].filename);\n            printf(\"Owner: %s\\n\", files[i].owner);\n            printf(\"Permissions: %d\\n\", files[i].permissions);\n            printf(\"Content: %s\\n\", files[i].content);\n            return;\n        }\n    }\n    \n    printf(\"Error: File '%s' not found\\n\", args[0]);\n}\n\nvoid cmd_writefile(char args[][MAX_COMMAND], int arg_count) {\n    if (!current_user || !current_user->logged_in) {\n        printf(\"Error: Must be logged in\\n\");\n        return;\n    }\n    \n    if (arg_count < 2) {\n        printf(\"Usage: writefile <filename> <content>\\n\");\n        return;\n    }\n    \n    // Find file and check ownership\n    for (int i = 0; i < file_count; i++) {\n        if (strcmp(files[i].filename, args[0]) == 0) {\n            // Check if current user owns the file\n            if (strcmp(files[i].owner, current_user->name) == 0 || \n                current_user->permission_level >= 5) {\n                strcpy(files[i].content, args[1]);\n                printf(\"File '%s' updated\\n\", args[0]);\n                return;\n            } else {\n                printf(\"Error: Permission denied\\n\");\n                return;\n            }\n        }\n    }\n    \n    printf(\"Error: File '%s' not found\\n\", args[0]);\n}\n\nvoid cmd_deletefile(char args[][MAX_COMMAND], int arg_count) {\n    if (!current_user || !current_user->logged_in) {\n        printf(\"Error: Must be logged in\\n\");\n        return;\n    }\n    \n    if (arg_count < 1) {\n        printf(\"Usage: deletefile <filename>\\n\");\n        return;\n    }\n    \n    // Find and delete file\n    for (int i = 0; i < file_count; i++) {\n        if (strcmp(files[i].filename, args[0]) == 0) {\n            if (strcmp(files[i].owner, current_user->name) == 0 || \n                current_user->permission_level >= 9) {\n                // Shift remaining files\n                for (int j = i; j < file_count - 1; j++) {\n                    files[j] = files[j + 1];\n                }\n                file_count--;\n                printf(\"File '%s' deleted\\n\", args[0]);\n                return;\n            } else {\n                printf(\"Error: Permission denied\\n\");\n                return;\n            }\n        }\n    }\n    \n    printf(\"Error: File '%s' not found\\n\", args[0]);\n}\n\nvoid cmd_listfiles(void) {\n    if (file_count == 0) {\n        printf(\"No files\\n\");\n        return;\n    }\n    \n    printf(\"Files:\\n\");\n    for (int i = 0; i < file_count; i++) {\n        printf(\"  %s (owner: %s, perm: %d)\\n\", \n               files[i].filename, files[i].owner, files[i].permissions);\n    }\n}\n\n// Variable commands\nvoid cmd_set(char args[][MAX_COMMAND], int arg_count) {\n    if (arg_count < 2) {\n        printf(\"Usage: set <name> <value>\\n\");\n        return;\n    }\n    \n    // Check if variable exists\n    for (int i = 0; i < variable_count; i++) {\n        if (strcmp(variables[i].name, args[0]) == 0) {\n            strcpy(variables[i].value, args[1]);\n            printf(\"Variable '%s' updated\\n\", args[0]);\n            return;\n        }\n    }\n    \n    // Create new variable\n    if (variable_count >= MAX_VARIABLES) {\n        printf(\"Error: Maximum variables reached\\n\");\n        return;\n    }\n    \n    strcpy(variables[variable_count].name, args[0]);\n    strcpy(variables[variable_count].value, args[1]);\n    variable_count++;\n    printf(\"Variable '%s' set\\n\", args[0]);\n}\n\nvoid cmd_get(char args[][MAX_COMMAND], int arg_count) {\n    if (arg_count < 1) {\n        printf(\"Usage: get <name>\\n\");\n        return;\n    }\n    \n    for (int i = 0; i < variable_count; i++) {\n        if (strcmp(variables[i].name, args[0]) == 0) {\n            printf(\"%s = %s\\n\", variables[i].name, variables[i].value);\n            return;\n        }\n    }\n    \n    printf(\"Error: Variable '%s' not found\\n\", args[0]);\n}\n\nvoid cmd_unset(char args[][MAX_COMMAND], int arg_count) {\n    if (arg_count < 1) {\n        printf(\"Usage: unset <name>\\n\");\n        return;\n    }\n    \n    for (int i = 0; i < variable_count; i++) {\n        if (strcmp(variables[i].name, args[0]) == 0) {\n            for (int j = i; j < variable_count - 1; j++) {\n                variables[j] = variables[j + 1];\n            }\n            variable_count--;\n            printf(\"Variable '%s' unset\\n\", args[0]);\n            return;\n        }\n    }\n    \n    printf(\"Error: Variable '%s' not found\\n\", args[0]);\n}\n\nvoid cmd_listvars(void) {\n    if (variable_count == 0) {\n        printf(\"No variables set\\n\");\n        return;\n    }\n    \n    printf(\"Variables:\\n\");\n    for (int i = 0; i < variable_count; i++) {\n        printf(\"  %s = %s\\n\", variables[i].name, variables[i].value);\n    }\n}\n\n// String comparison commands\nvoid cmd_compare(char args[][MAX_COMMAND], int arg_count) {\n    if (arg_count < 2) {\n        printf(\"Usage: compare <string1> <string2>\\n\");\n        return;\n    }\n    \n    int result = strcmp(args[0], args[1]);\n    \n    printf(\"strcmp('%s', '%s') = %d\\n\", args[0], args[1], result);\n    \n    if (result == 0) {\n        printf(\"Strings are equal\\n\");\n    } else if (result < 0) {\n        printf(\"'%s' < '%s'\\n\", args[0], args[1]);\n    } else {\n        printf(\"'%s' > '%s'\\n\", args[0], args[1]);\n    }\n}\n\nvoid cmd_compareN(char args[][MAX_COMMAND], int arg_count) {\n    if (arg_count < 3) {\n        printf(\"Usage: compareN <string1> <string2> <n>\\n\");\n        return;\n    }\n    \n    int n = atoi(args[2]);\n    int result = strncmp(args[0], args[1], n);\n    \n    printf(\"strncmp('%s', '%s', %d) = %d\\n\", args[0], args[1], n, result);\n    \n    if (result == 0) {\n        printf(\"First %d characters are equal\\n\", n);\n    } else if (result < 0) {\n        printf(\"'%s' < '%s' (first %d chars)\\n\", args[0], args[1], n);\n    } else {\n        printf(\"'%s' > '%s' (first %d chars)\\n\", args[0], args[1], n);\n    }\n}\n\nvoid cmd_startswith(char args[][MAX_COMMAND], int arg_count) {\n    if (arg_count < 2) {\n        printf(\"Usage: startswith <string> <prefix>\\n\");\n        return;\n    }\n    \n    size_t prefix_len = strlen(args[1]);\n    \n    if (strncmp(args[0], args[1], prefix_len) == 0) {\n        printf(\"'%s' starts with '%s'\\n\", args[0], args[1]);\n    } else {\n        printf(\"'%s' does not start with '%s'\\n\", args[0], args[1]);\n    }\n}\n\nvoid cmd_match(char args[][MAX_COMMAND], int arg_count) {\n    if (arg_count < 2) {\n        printf(\"Usage: match <pattern> <string1> [string2] ...\\n\");\n        return;\n    }\n    \n    printf(\"Matching pattern '%s':\\n\", args[0]);\n    int matches = 0;\n    \n    for (int i = 1; i < arg_count; i++) {\n        if (strcmp(args[0], args[i]) == 0) {\n            printf(\"  '%s' - EXACT MATCH\\n\", args[i]);\n            matches++;\n        } else if (strstr(args[i], args[0]) != NULL) {\n            printf(\"  '%s' - contains pattern\\n\", args[i]);\n            matches++;\n        } else {\n            printf(\"  '%s' - no match\\n\", args[i]);\n        }\n    }\n    \n    printf(\"Total matches: %d\\n\", matches);\n}\n\n// System commands\nvoid cmd_help(void) {\n    printf(\"\\n=== Command Interpreter Help ===\\n\");\n    printf(\"User Management:\\n\");\n    printf(\"  adduser <user> <pass> [level] - Add new user\\n\");\n    printf(\"  login <user> <pass>            - Login as user\\n\");\n    printf(\"  logout                         - Logout current user\\n\");\n    printf(\"  whoami                         - Show current user\\n\");\n    printf(\"  listusers                      - List all users\\n\");\n    printf(\"\\nFile Management:\\n\");\n    printf(\"  createfile <name> [content]    - Create file\\n\");\n    printf(\"  readfile <name>                - Read file\\n\");\n    printf(\"  writefile <name> <content>     - Write to file\\n\");\n    printf(\"  deletefile <name>              - Delete file\\n\");\n    printf(\"  listfiles                      - List all files\\n\");\n    printf(\"\\nVariable Management:\\n\");\n    printf(\"  set <name> <value>             - Set variable\\n\");\n    printf(\"  get <name>                     - Get variable\\n\");\n    printf(\"  unset <name>                   - Unset variable\\n\");\n    printf(\"  listvars                       - List all variables\\n\");\n    printf(\"\\nString Operations:\\n\");\n    printf(\"  compare <str1> <str2>          - Compare strings\\n\");\n    printf(\"  compareN <str1> <str2> <n>     - Compare first N chars\\n\");\n    printf(\"  startswith <str> <prefix>      - Check if starts with\\n\");\n    printf(\"  match <pattern> <str> ...      - Match pattern\\n\");\n    printf(\"\\nSystem:\\n\");\n    printf(\"  debug [on|off]                 - Toggle debug mode\\n\");\n    printf(\"  verbose [on|off]               - Toggle verbose mode\\n\");\n    printf(\"  status                         - Show system status\\n\");\n    printf(\"  time                           - Show current time\\n\");\n    printf(\"  help                           - Show this help\\n\");\n    printf(\"  exit                           - Exit program\\n\");\n}\n\nvoid cmd_debug(char args[][MAX_COMMAND], int arg_count) {\n    if (arg_count < 1) {\n        printf(\"Debug mode: %s\\n\", debug_mode ? \"ON\" : \"OFF\");\n        return;\n    }\n    \n    if (strcmp(args[0], \"on\") == 0) {\n        debug_mode = 1;\n        printf(\"Debug mode enabled\\n\");\n    } else if (strcmp(args[0], \"off\") == 0) {\n        debug_mode = 0;\n        printf(\"Debug mode disabled\\n\");\n    } else {\n        printf(\"Usage: debug [on|off]\\n\");\n    }\n}\n\nvoid cmd_verbose(char args[][MAX_COMMAND], int arg_count) {\n    if (arg_count < 1) {\n        printf(\"Verbose mode: %s\\n\", verbose_mode ? \"ON\" : \"OFF\");\n        return;\n    }\n    \n    if (strcmp(args[0], \"on\") == 0) {\n        verbose_mode = 1;\n        printf(\"Verbose mode enabled\\n\");\n    } else if (strcmp(args[0], \"off\") == 0) {\n        verbose_mode = 0;\n        printf(\"Verbose mode disabled\\n\");\n    } else {\n        printf(\"Usage: verbose [on|off]\\n\");\n    }\n}\n\nvoid cmd_status(void) {\n    printf(\"\\n=== System Status ===\\n\");\n    printf(\"Users: %d/%d\\n\", user_count, MAX_USERS);\n    printf(\"Files: %d/%d\\n\", file_count, MAX_FILES);\n   