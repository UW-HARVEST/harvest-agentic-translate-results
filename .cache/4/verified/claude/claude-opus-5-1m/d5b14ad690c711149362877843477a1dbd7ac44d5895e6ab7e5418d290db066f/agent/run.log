   }\"\"\",\"\"\"        Mach {\n            mem: vec![0u8; REGION_SIZE as usize],\n            out: Vec::with_capacity(STDIO_BUFSIZ * 2),\n            stdin_dead: false,\n            exit_dead: false,\n        }\"\"\")\n\n# 3. replace writable() with a checked-write helper\ns=s.replace(\"\"\"    /// Writes below `users` land in `.data`/`.got`/`stdin`; the reference\n    /// program cannot survive them (the next PLT call or `fgets` faults), so\n    /// they are treated as fatal.\n    fn writable(addr: i64, len: i64) -> bool {\n        Mach::readable(addr, len) && addr >= A_USERS\n    }\"\"\",\"\"\"    /// Prepares a write of `len` bytes at `addr`: faults when it leaves the\n    /// mapping, and records the delayed failure modes of the ranges that hold\n    /// linker/libc state rather than program data.  (`.data`, `completed.0`\n    /// and the inter-object padding are plain data and survive.)\n    fn begin_write(&mut self, addr: i64, len: i64) -> usize {\n        if !Mach::readable(addr, len) {\n            self.segv();\n        }\n        if addr < A_GOT_HI && addr + len > A_GOT_LO {\n            // the next PLT call jumps to the clobbered slot\n            self.segv();\n        }\n        if addr < A_STDIN_HI && addr + len > A_STDIN_LO {\n            self.stdin_dead = true;\n        }\n        if addr < A_DYNAMIC_HI && addr + len > A_DYNAMIC_LO {\n            self.exit_dead = true;\n        }\n        (addr - REGION_BASE) as usize\n    }\"\"\")\n\n# 4. rewrite wb / wi / wp to use begin_write\ns=s.replace(\"\"\"    fn wb(&mut self, addr: i64, v: u8) {\n        if !Mach::writable(addr, 1) {\n            self.segv();\n        }\n        self.mem[(addr - REGION_BASE) as usize] = v;\n    }\"\"\",\"\"\"    fn wb(&mut self, addr: i64, v: u8) {\n        let o = self.begin_write(addr, 1);\n        self.mem[o] = v;\n    }\"\"\")\ns=s.replace(\"\"\"    fn wi(&mut self, addr: i64, v: i32) {\n        if !Mach::writable(addr, 4) {\n            self.segv();\n        }\n        let o = (addr - REGION_BASE) as usize;\n        self.mem[o..o + 4].copy_from_slice(&v.to_le_bytes());\n    }\"\"\",\"\"\"    fn wi(&mut self, addr: i64, v: i32) {\n        let o = self.begin_write(addr, 4);\n        self.mem[o..o + 4].copy_from_slice(&v.to_le_bytes());\n    }\"\"\")\ns=s.replace(\"\"\"    fn wp(&mut self, addr: i64, v: i64) {\n        if !Mach::writable(addr, 8) {\n            self.segv();\n        }\n        let o = (addr - REGION_BASE) as usize;\n        self.mem[o..o + 8].copy_from_slice(&v.to_le_bytes());\n    }\"\"\",\"\"\"    fn wp(&mut self, addr: i64, v: i64) {\n        let o = self.begin_write(addr, 8);\n        self.mem[o..o + 8].copy_from_slice(&v.to_le_bytes());\n    }\"\"\")\n\n# 5. exit paths honour exit_dead\ns=s.replace(\"\"\"    /// `fflush(stdout)` as performed by `exit()` / returning from `main`.\n    fn flush(&mut self) {\"\"\",\"\"\"    /// `exit(0)` / returning from `main`: the `.fini_array` destructors run\n    /// before stdio is flushed, so a clobbered `.fini_array` loses the buffer.\n    fn exit_flush(&mut self) {\n        if self.exit_dead {\n            self.segv();\n        }\n        self.flush();\n    }\n\n    /// `fflush(stdout)` as performed by `exit()` / returning from `main`.\n    fn flush(&mut self) {\"\"\")\ns=s.replace(\"\"\"            pf!(self, \"Goodbye!\\\\n\");\n            self.flush();\n            std::process::exit(0);\"\"\",\"\"\"            pf!(self, \"Goodbye!\\\\n\");\n            self.exit_flush();\n            std::process::exit(0);\"\"\")\ns=s.replace(\"\"\"        let owned = input.to_vec();\n        st.process_command(&owned);\n    }\n\n    st.flush();\"\"\",\"\"\"        let owned = input.to_vec();\n        st.process_command(&owned);\n    }\n\n    st.exit_flush();\"\"\")\n\n# 6. fgets faults when the stdin pointer was clobbered\ns=s.replace(\"\"\"    loop {\n        pf!(st, \"> \");\n\n        let raw = match fgets(&mut reader, MAX_INPUT) {\"\"\",\"\"\"    loop {\n        pf!(st, \"> \");\n\n