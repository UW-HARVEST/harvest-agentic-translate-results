nc);\n            f(\n                inb.ptr() as *mut c_void,\n                1,\n                outb.ptr() as *mut c_void,\n                4096,\n            );\n            libc::_exit(0);\n        }\n        let mut st = 0;\n        libc::waitpid(pid, &mut st, 0);\n        assert!(libc::WIFSIGNALED(st) && libc::WTERMSIG(st) == libc::SIGABRT);\n        libc::close(fd);\n    }\n    let s = std::fs::read_to_string(&path).unwrap_or_default();\n    let _ = std::fs::remove_file(&path);\n    s\n}\n\n#[test]\nfn assert_message_prefix_matches() {\n    let (c, r) = libs();\n    let a = raw_assert_message(c.cp_inflate, \"c\");\n    let b = raw_assert_message(r.cp_inflate, \"rust\");\n    eprintln!(\"C    raw = {a:?}\");\n    eprintln!(\"Rust raw = {b:?}\");\n\n    // 1. the `<progname>: ` prefix must be identical (glibc uses __progname,\n    //    src/cassert.rs uses basename(argv[0]))\n    let pa = a.split(\": \").next().unwrap();\n    let pb = b.split(\": \").next().unwrap();\n    assert_eq!(pa, pb, \"program-name prefix differs\");\n    assert!(!pa.is_empty(), \"empty program name\");\n\n    // 2. everything from `lib.c` onwards must be identical; only the __FILE__\n    //    path differs (CMake compiles with an absolute path).\n    let ta = &a[a.rfind(\"lib.c:\").unwrap()..];\n    let tb = &b[b.rfind(\"lib.c:\").unwrap()..];\n    assert_eq!(ta, tb);\n    assert_eq!(\n        ta,\n        \"lib.c:115: cp_consume_bits: Assertion `s->count >= num_bits_to_read' failed.\\n\"\n    );\n\n    // 3. the only difference is the __FILE__ path\n    let fa = &a[pa.len() + 2..a.rfind(\"lib.c:\").unwrap()];\n    let fb = &b[pb.len() + 2..b.rfind(\"lib.c:\").unwrap()];\n    eprintln!(\"C    __FILE__ prefix = {fa:?}\");\n    eprintln!(\"Rust __FILE__ prefix = {fb:?}\");\n    assert!(\n        fa.ends_with(\"c_src/src/\") || fa.is_empty(),\n        \"unexpected C __FILE__ prefix {fa:?}\"\n    );\n    assert_eq!(fb, \"c_src/src/\");\n}\n","structuredPatch":[{"oldStart":1,"oldLines":64,"newStart":1,"newLines":88,"lines":[" //! One-off check that glibc's `__assert_fail` prefix (`<progname>: `) is"," //! reproduced byte-for-byte by `src/cassert.rs`, i.e. that the *whole* assertion","-//! message matches, not only the normalised tail.","+//! message matches and not merely the path-normalised tail that the differential","+//! harness compares."," mod common;","-use common::{libs, run_inflate_forked, GuardedBuf, Runner};"," ","+use common::{libs, GuardedBuf};","+use std::ffi::c_void;","+use std::os::unix::io::IntoRawFd;","+","+/// Fork, run `cp_inflate(in, 1, out, 4096)` on the 1-byte stream `[0x03]`","+/// (BFINAL=1, BTYPE=01, truncated ⇒ abort at `lib.c:115`) and return the child's","+/// raw stderr.","+fn raw_assert_message(f: common::InflateFn, tag: &str) -> String {","+    let dir = std::env::var(\"TMPDIR\").unwrap_or_else(|_| \"/tmp\".into());","+    let path = std::path::PathBuf::from(dir).join(format!(\"cdiff-raw-{}-{tag}\", std::process::id()));","+    let fd = std::fs::File::create(&path).unwrap().into_raw_fd();","+","+    let inb = GuardedBuf::new(4096);","+    let outb = GuardedBuf::new(4096);","+    inb.fill(0);","+    inb.write_at(0, &[0x03]);","+","+    unsafe {","+        let pid = libc::fork();","+        assert!(pid >= 0);","+        if pid == 0 {","+            libc::dup2(fd, 2);","+            libc::prctl(libc::PR_SET_DUMPABLE, 0, 0, 0, 0);","+            let nc = libc::rlimit {","+                rlim_cur: 1,","+                rlim_max: 1,","+            };","+            libc::setrlimit(libc::RLIMIT_CORE, &nc);","+            f(","+                inb.ptr() as *mut c_void,","+                1,","+                outb.ptr() as *mut c_void,","+                4096,","+            );","+            libc::_exit(0);","+        }","+        let mut st = 0;","+        libc::waitpid(pid, &mut st, 0);","+        assert!(libc::WIFSIGNALED(st) && libc::WTERMSIG(st) == libc::SIGABRT);","+        libc::close(fd);","+    }","+    let s = std::fs::read_to_string(&path).unwrap_or_default();","+    let _ = std::fs::remove_file(&path);","+    s","+}","+"," #[test]"," fn assert_message_prefix_matches() {","     let (c, r) = libs();","-    let runner = Runner::new(\"progname\");","-    let inb = GuardedBuf::new(4096);","-    let oc = GuardedBuf::new(4096);","-    let or = GuardedBuf::new(4096);","-    inb.fill(0);","-    inb.write_at(0, &[0x03]); // BFINAL=1 BTYPE=01, truncated -> abort at lib.c:115","-    let a = run_inflate_forked(c, &runner, inb.ptr(), 1, &oc, 4096, 0xA5);","-    let b = run_inflate_forked(r, &runner, inb.ptr(), 1, &or, 4096, 0xA5);","-    eprintln!(\"C    stderr (normalised) = {:?}\", a.stderr);","-    eprintln!(\"Rust stderr (normalised) = {:?}\", b.stderr);","-    assert_eq!(a.stderr, b.stderr);","-    assert!(a.stderr.starts_with(\"lib.c:115: cp_consume_bits: Assertion\"));","+    let a = raw_assert_message(c.cp_inflate, \"c\");","+    let b = raw_assert_message(r.cp_inflate, \"rust\");","+    eprintln!(\"C    raw = {a:?}\");","+    eprintln!(\"Rust raw = {b:?}\");"," ","-    // Now the raw (un-normalised) text, read straight from the capture files.","-    let raw_c = raw_stderr(c.cp_error_reason, || {","-        run_inflate_forked(c, &runner, inb.ptr(), 1, &oc, 4096, 0xA5)","-    });","-    let raw_r = raw_stderr(r.cp_error_reason, || {","-        run_inflate_forked(r, &runner, inb.ptr(), 1, &or, 4096, 0xA5)","-    });","-    eprintln!(\"C    raw = {raw_c:?}\");","-    eprintln!(\"Rust raw = {raw_r:?}\");","-    let pc = raw_c.split(':').next().unwrap();","-    let pr = raw_r.split(':').next().unwrap();","+    // 1. the `<progname>: ` prefix must be identical (glibc uses __progname,","+    //    src/cassert.rs uses basename(argv[0]))","+    let pa = a.split(\": \").next().unwrap();","+    let pb = b.split(\": \").next().unwrap();","+    assert_eq!(pa, pb, \"program-name prefix differs\");","+    assert!(!pa.is_empty(), \"empty program name\");","+","+    // 2. everything from `lib.c` onwards must be identical; only the __FILE__","+    //    path differs (CMake compiles with an absolute path).","+    let ta = &a[a.rfind(\"lib.c:\").unwrap()..];","+    let tb = &b[b.rfind(\"lib.c:\").unwrap()..];","+    assert_eq!(ta, tb);","     assert_eq!(","-        pc, pr,","-        \"program-name prefix differs: glibc uses __progname, cassert.rs uses \\","-         basename(argv[0])\"","+        ta,","+        \"lib.c:115: cp_consume_bits: Assertion `s->count >= num_bits_to_read' failed.\\n\"","     );","-}"," ","-/// The `Outcome::stderr` is normalised; re-read the underlying text.","-fn raw_stderr(_e: *mut std::os::raw::c_char, f: impl FnOnce() -> common::Outcome) -> String {","-    // `Runner` normalises, but the raw text only differs in the __FILE__ path;","-    // reconstruct the prefix from the normalised value plus the capture file.","-    let o = f();","-    // the prefix is everything the normaliser removed, so read it back from the","-    // capture: the file still holds the full message after the call.","-    let dir = std::env::var(\"TMPDIR\").unwrap_or_else(|_| \"/tmp\".into());","-    let mut best = String::new();","-    if let Ok(rd) = std::fs::read_dir(&dir) {","-        for e in rd.flatten() {","-            let n = e.file_name().to_string_lossy().into_owned();","-            if n.starts_with(&format!(\"cdiff-stderr-{}-progname\", std::process::id())) {","-                if let Ok(s) = std::fs::read_to_string(e.path()) {","-                    if !s.is_empty() {","-                        best = s;","-                    }","-                }","-            }","-        }","-    }","-    let _ = o;","-    best","+    // 3. the only difference is the __FILE__ path","+    let fa = &a[pa.len() + 2..a.rfind(\"lib.c:\").unwrap()];","+    let fb = &b[pb.len() + 2..b.rfind(\"lib.c:\").unwrap()];","+    eprintln!(\"C    __FILE__ prefix = {fa:?}\");","+    eprintln!(\"Rust __FILE__ prefix = {fb:?}\");","+    assert!(","+        fa.ends_with(\"c_src/src/\") || fa.is_empty(),","+        \"unexpected C __FILE__ prefix {fa:?}\"","+    );","+    assert_eq!(fb, \"c_src/src/\");"," }"]}],"originalFile":"//! One-off check that glibc's `__assert_fail` prefix (`<progname>: `) is\n//! reproduced byte-for-byte by `src/cassert.rs`, i.e. that the *whole* assertion\n//! message matches, not only the normalised tail.\nmod common;\nuse common::{libs, run_inflate_forked, GuardedBuf, Runner};\n\n#[test]\nfn assert_message_prefix_matches() {\n    let (c, r) = libs();\n    let runner = Runner::new(\"progname\");\n    let inb = GuardedBuf::new(4096);\n    let oc = GuardedBuf::new(4096);\n    let or = GuardedBuf::new(4096);\n    inb.fill(0);\n    inb.write_at(0, &[0x03]); // BFINAL=1 BTYPE=01, truncated -> abort at lib.c:115\n    let a = run_inflate_forked(c, &runner, inb.ptr(), 1, &oc, 4096, 0xA5);\n    let b = run_inflate_forked(r, &runner, inb.ptr(), 1, &or, 4096, 0xA5);\n    eprintln!(\"C    stderr (normalised) = {:?}\", a.stderr);\n    eprintln!(\"Rust stderr (normalised) = {:?}\", b.stderr);\n    assert_eq!(a.stderr, b.stderr);\n    assert!(a.stderr.starts_with(\"lib.c:115: cp_consume_bits: Assertion\"));\n\n    // Now the raw (un-normalised) text, read straight from the capture files.\n    let raw_c = raw_stderr(c.cp_error_reason, || {\n        run_inflate_forked(c, &runner, inb.ptr(), 1, &oc, 4096, 0xA5)\n    });\n    let raw_r = raw_stderr(r.cp_error_reason, || {\n        run_inflate_forked(r, &runner, inb.ptr(), 1, &or, 4096, 0xA5)\n    });\n    eprintln!(\"C    raw = {raw_c:?}\");\n    eprintln!(\"Rust raw = {raw_r:?}\");\n    let pc = raw_c.split(':').next().unwrap();\n    let pr = raw_r.split(':').next().unwrap();\n    assert_eq!(\n        pc, pr,\n        \"program-name prefix differs: glibc uses __progname, cassert.rs uses \\\n         basename(argv[0])\"\n    );\n}\n\n/// The `Outcome::stderr` is normalised; re-read the underlying text.\nfn raw_stderr(_e: *mut std::os::raw::c_char, f: impl FnOnce() -> common::Outcome) -> String {\n    // `Runner` normalises, but the raw text only differs in the __FILE__ path;\n    // reconstruct the prefix from the normalised value plus the capture file.\n    let o = f();\n    // the prefix is everything the normaliser removed, so read it back from the\n    // capture: the file still holds the full message after the call.\n    let dir = std::env::var(\"TMPDIR\").unwrap_or_else(|_| \"/tmp\".into());\n    let mut best = String::new();\n    if let Ok(rd) = std::fs::read_dir(&dir) {\n        for e in rd.flatten() {\n            let n = e.file_name().to_string_lossy().into_owned();\n            if n.starts_with(&format!(\"cdiff-stderr-{}-progname\", std::process::id())) {\n                if let Ok(s) = std::fs::read_to_string(e.path()) {\n                    if !s.is_empty() {\n                        best = s;\n                    }\n                }\n            }\n        }\n    }\n    let _ = o;\n    best\n}\n","userModified":false}}
