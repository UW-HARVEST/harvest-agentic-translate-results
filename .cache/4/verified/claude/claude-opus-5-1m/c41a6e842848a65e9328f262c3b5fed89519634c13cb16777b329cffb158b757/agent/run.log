{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_013YySBSjUUSYG5CidUiGbjw","type":"tool_result","content":"=================== src/lib.rs\n     1\t//! Rust translation of the C library in `c_src/` (a cut-down `cute_png`\n     2\t//! derivative: DEFLATE inflate + PNG scanline unfiltering).\n     3\t//!\n     4\t//! The shared library exports exactly the same public ABI as the C build:\n     5\t//!\n     6\t//! ```text\n     7\t//! FUNC   cp_inflate\n     8\t//! FUNC   unfilter\n     9\t//! OBJECT cp_error_reason\n    10\t//! OBJECT cp_fixed_table\n    11\t//! OBJECT cp_permutation_order\n    12\t//! OBJECT cp_len_extra_bits\n    13\t//! OBJECT cp_len_base\n    14\t//! OBJECT cp_dist_extra_bits\n    15\t//! OBJECT cp_dist_base\n    16\t//! ```\n    17\t//!\n    18\t//! Behaviour (including the bugs and the `assert()`s, which are live because\n    19\t//! the CMake build never defines `NDEBUG`) is reproduced as-is.\n    20\t\n    21\t#![allow(non_upper_case_globals)]\n    22\t#![allow(clippy::missing_safety_doc)]\n    23\t\n    24\t#[macro_use]\n    25\tmod cassert;\n    26\t\n    27\tmod inflate;\n    28\tmod misc;\n    29\tmod tables;\n    30\tmod unfilter;\n    31\t\n    32\t// Re-exported so that the `#[unsafe(no_mangle)]` items are unmistakably part of\n    33\t// the crate's surface.\n    34\tpub use inflate::cp_inflate;\n    35\tpub use tables::{\n    36\t    cp_dist_base, cp_dist_extra_bits, cp_error_reason, cp_fixed_table, cp_len_base,\n    37\t    cp_len_extra_bits, cp_permutation_order,\n    38\t};\n    39\tpub use unfilter::unfilter;\n=================== src/cassert.rs\n     1\t//! Faithful emulation of C's `assert()` (asserts are *enabled* in the C build:\n     2\t//! the CMake project sets no build type, so `NDEBUG` is never defined).\n     3\t//!\n     4\t//! glibc's `__assert_fail` writes\n     5\t//!   `<progname>: <file>:<line>: <func>: Assertion `<expr>' failed.\\n`\n     6\t//! to stderr and then raises `SIGABRT` via `abort()`.\n     7\t\n     8\tuse std::io::Write;\n     9\t\n    10\t/// The `__FILE__` string as seen by the original translation unit.\n    11\tconst C_FILE: &str = \"c_src/src/lib.c\";\n    12\t\n    13\t#[cold]\n    14\t#[inline(never)]\n    15\tpub fn assert_fail(expr: &str, func: &str, line: u32) -> ! {\n    16\t    let prog = std::env::args_os()\n    17\t        .next()\n    18\t        .and_then(|a| {\n    19\t            std::path::Path::new(&a)\n    20\t                .file_name()\n    21\t                .map(|f| f.to_string_lossy().into_owned())\n    22\t        })\n    23\t        .unwrap_or_default();\n    24\t    let msg = format!(\n    25\t        \"{}: {}:{}: {}: Assertion `{}' failed.\\n\",\n    26\t        prog, C_FILE, line, func, expr\n    27\t    );\n    28\t    let _ = std::io::stderr().write_all(msg.as_bytes());\n    29\t    let _ = std::io::stderr().flush();\n    30\t    std::process::abort()\n    31\t}\n    32\t\n    33\t/// `assert(cond)` where `expr_text` is the stringified expression, `func` is\n    34\t/// the enclosing function name and `line` the source line in `lib.c`.\n    35\tmacro_rules! c_assert {\n    36\t    ($cond:expr, $expr_text:expr, $func:expr, $line:expr) => {\n    37\t        if !($cond) {\n    38\t            crate::cassert::assert_fail($expr_text, $func, $line);\n    39\t        }\n    40\t    };\n    41\t}\n=================== src/misc.rs\n     1\t//! Remaining declarations of `lib.c`. These are `static` (internal linkage) in\n     2\t//! C and hence not part of the exported ABI, but they are translated here so\n     3\t//! that the port covers the whole translation unit.\n     4\t\n     5\tuse core::ffi::{c_char, c_int};\n     6\t\n     7\t/// ```c\n     8\t/// struct cp_pixel_t { uint8_t r, g, b, a; };\n     9\t/// ```\n    10\t#[repr(C)]\n    11\t#[derive(Copy, Clone)]\n    12\tpub struct CpPixel {\n    13\t    pub r: u8,\n    14\t    pub g: u8,\n    15\t    pub b: u8,\n    16\t    pub a: u8,\n    17\t}\n    18\t\n  