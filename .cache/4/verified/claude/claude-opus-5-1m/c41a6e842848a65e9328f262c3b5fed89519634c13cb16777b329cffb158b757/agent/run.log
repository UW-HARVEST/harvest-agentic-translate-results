c_int = p.wrapping_sub(c as c_int).wrapping_abs();\n    28\t    if pa <= pb && pa <= pc {\n    29\t        a\n    30\t    } else if pb <= pc {\n    31\t        b\n    32\t    } else {\n    33\t        c\n    34\t    }\n    35\t}\n    36\t\n    37\t/// ```c\n    38\t/// int unfilter(int w, int h, int bpp, uint8_t *raw);\n    39\t/// ```\n    40\t#[unsafe(no_mangle)]\n    41\tpub unsafe extern \"C\" fn unfilter(\n    42\t    w: c_int,\n    43\t    h: c_int,\n    44\t    bpp: c_int,\n    45\t    raw: *mut u8,\n    46\t) -> c_int {\n    47\t    let len: c_int = w.wrapping_mul(bpp);\n    48\t    let mut prev: *mut u8;\n    49\t    let mut x: c_int;\n    50\t    let mut raw = raw;\n    51\t\n    52\t    #[inline(always)]\n    53\t    unsafe fn get(p: *mut u8, i: c_int) -> u8 {\n    54\t        *p.wrapping_offset(i as isize)\n    55\t    }\n    56\t    #[inline(always)]\n    57\t    unsafe fn add(p: *mut u8, i: c_int, v: c_int) {\n    58\t        let q = p.wrapping_offset(i as isize);\n    59\t        *q = (*q as c_int).wrapping_add(v) as u8;\n    60\t    }\n    61\t\n    62\t    if h > 0 {\n    63\t        let filter = *raw;\n    64\t        raw = raw.wrapping_offset(1);\n    65\t        match filter {\n    66\t            0 => {}\n    67\t            1 => {\n    68\t                x = bpp;\n    69\t                while x < len {\n    70\t                    add(raw, x, get(raw, x.wrapping_sub(bpp)) as c_int);\n    71\t                    x += 1;\n    72\t                }\n    73\t            }\n    74\t            2 => {}\n    75\t            3 => {\n    76\t                x = bpp;\n    77\t                while x < len {\n    78\t                    add(raw, x, get(raw, x.wrapping_sub(bpp)) as c_int / 2);\n    79\t                    x += 1;\n    80\t                }\n    81\t            }\n    82\t            4 => {\n    83\t                x = bpp;\n    84\t                while x < len {\n    85\t                    let v = cp_paeth(get(raw, x.wrapping_sub(bpp))