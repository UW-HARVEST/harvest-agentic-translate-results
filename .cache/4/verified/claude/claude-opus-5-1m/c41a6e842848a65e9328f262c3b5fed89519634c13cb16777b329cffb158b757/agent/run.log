   34\t/// the enclosing function name and `line` the source line in `lib.c`.\n    35\tmacro_rules! c_assert {\n    36\t    ($cond:expr, $expr_text:expr, $func:expr, $line:expr) => {\n    37\t        if !($cond) {\n    38\t            crate::cassert::assert_fail($expr_text, $func, $line);\n    39\t        }\n    40\t    };\n    41\t}\n=================== src/misc.rs\n     1\t//! Remaining declarations of `lib.c`. These are `static` (internal linkage) in\n     2\t//! C and hence not part of the exported ABI, but they are translated here so\n     3\t//! that the port covers the whole translation unit.\n     4\t\n     5\tuse core::ffi::{c_char, c_int};\n     6\t\n     7\t/// ```c\n     8\t/// struct cp_pixel_t { uint8_t r, g, b, a; };\n     9\t/// ```\n    10\t#[repr(C)]\n    11\t#[derive(Copy, Clone)]\n    12\tpub struct CpPixel {\n    13\t    pub r: u8,\n    14\t    pub g: u8,\n    15\t    pub b: u8,\n    16\t    pub a: u8,\n    17\t}\n    18\t\n    19\t/// ```c\n    20\t/// struct cp_image_t { int w; int h; cp_pixel_t *pix; };\n    21\t/// ```\n    22\t#[repr(C)]\n    23\t#[allow(dead_code)]\n    24\tpub struct CpImage {\n    25\t    pub w: c_int,\n    26\t    pub h: c_int,\n    27\t    pub pix: *mut CpPixel,\n    28\t}\n    29\t\n    30\t/// ```c\n    31\t/// static cp_pixel_t cp_make_pixel_a(uint8_t r, uint8_t g, uint8_t b, uint8_t a);\n    32\t/// ```\n    33\t#[allow(dead_code)]\n    34\tpub fn cp_make_pixel_a(r: u8, g: u8, b: u8, a: u8) -> CpPixel {\n    35\t    CpPixel { r, g, b, a }\n    36\t}\n    37\t\n    38\t/// ```c\n    39\t/// static cp_pixel_t cp_make_pixel(uint8_t r, uint8_t g, uint8_t b);\n    40\t/// ```\n    41\t#[allow(dead_code)]\n    42\tpub fn cp_make_pixel(r: u8, g: u8, b: u8) -> CpPixel {\n    43\t    CpPixel { r, g, b, a: 0xFF }\n    44\t}\n    45\t\n    46\t/// ```c\n    47\t/// typedef struct cp_raw_png_t { const uint8_t *p; const uint8_t *end; } cp_raw_png_t;\n    48\t/// ```\n    49\t#[repr(C)]\n    50\tpub struct CpRawPng {\n    51\t    pub p: *const u8,\n    52\t    pub end: *const u8,\n    53\t}\n    54\t\n    55\t/// ```c\n    56\t/// static uint32_t cp_make32(const uint8_t *s) {\n    57\t///   return (s[0] << 24) | (s[1] << 16) | (s[2] << 8) | s[3];\n    58\t/// }\n    59\t/// ```\n    60\t#[allow(dead_code)]\n    61\tpub unsafe fn cp_make32(s: *const u8) -> u32 {\n    62\t    (((*s.wrapping_offset(0) as c_int) << 24)\n    63\t        | ((*s.wrapping_offset(1) as c_int) << 16)\n    64\t        | ((*s.wrapping_offset(2) as c_int) << 8)\n    65\t        | (*s.wrapping_offset(3) as c_int)) as u32\n    66\t}\n    67\t\n    68\t/// ```c\n    69\t/// static const uint8_t *cp_chunk(cp_raw_png_t *png, const char *chunk, uint32_t minlen) { ... }\n    70\t/// ```\n    71\t#[allow(dead_code)]\n    72\tpub unsafe fn cp_chunk(png: *mut CpRawPng, chunk: *const c_char, minlen: u32) -> *const u8 {\n    73\t    let len = cp_make32((*png).p);\n    74\t    let start = (*png).p;\n    75\t    if memcmp4(start.wrapping_offset(4), chunk as *const u8) == 0 && len >= minlen {\n    76\t        let offset = len.wrapping_add(12) as c_int;\n    77\t        if (*png).p.wrapping_offset(offset as isize) as usize <= (*png).end as usize {\n    78\t            (*png).p = (*png).p.wrapping_offset(offset as isize);\n    79\t            return start.wrapping_offset(8);\n    80\t        }\n    81\t    }\n    82\t    core::ptr::null()\n    83\t}\n    84\t\n    85\t/// ```c\n    86\t/// static const uint8_t *cp_find(cp_raw_png_t *png, const char *chunk, uint32_t minlen) { ... }\n    87\t/// ```\n    88\t#[allow(dead_code)]\n    89\tpub unsafe fn cp_find(png: *mut CpRawPng, chunk: *const c_char, minlen: u32) -> *const u8 {\n    90\t    while ((*png).p as usize) < ((*png).end as usize) {\n    91\t        let len = cp_make32((*png).p);\n    92\t        let start = (*png).p;\n    93\t        (*png).p = (*png).p.wrapping_offset(len.wrapping_add(12) as c_int as isize);\n    94\t        if memcmp4(start.wrapping_offset(4), chunk as *const u8) == 0\n    95\t            && len >= minlen\n    96\t            && (*png).p as usize <= (*png).end as usize\n    97\t        {\n    98\t            return start.wrapping_offset(8);\n    99\t        }\n   100\t    }\n   101\t    core::ptr::null()\n   102\t}\n   103\t\n   104\t/// `memcmp(a, b, 4)`\n   105\t#[allow(dead_code)]\n   106\tunsafe fn memcmp4(a: *const u8, b: *const u8) -> c_int {\n   107\t    let mut i = 0isize;\n   108\t    while i < 4 {\n   109\t        let av = *a.wrapping_offset(i);\n   110\t        let bv = *b.wrapping_offset(i);\n   111\t        if av != bv {\n   112\t            return av as c_int - bv as c_int;\n   113\t        }\n   114\t        i += 1;\n   115\t    }\n   116\t    0\n   117\t}\n=================== src/tables.rs\n     1\t//! Global (exported) data objects of the C library.\n     2\t//!\n     3\t//! These are non-`static` file-scope objects in `lib.c` and therefore part of\n     4\t//! the public ABI of the shared library:\n     5\t//!\n     6\t//! ```text\n     7\t//! const char *cp_error_reason;\n     8\t//! uint8_t  cp_fixed_table[288 + 32];\n     9\t//! uint8_t  cp_permutation_order[19];\n    10\t//! uint8_t  cp_len_extra_bits[29 + 2];\n    11\t//! uint32_t cp_len_base[29 + 2];\n    12\t//! uint8_t  cp_dist_extra_bits[30 + 2];\n    13\t//! uint32_t cp_dist_base[30 + 2];\n    14\t//! ```\n    15\t\n    16\tuse core::ffi::c_char;\n    17\t\n    18\t/// `const char *cp_error_reason;` (lives in `.bss`, i.e. initially NULL)\n    19\t#[unsafe(no_mangle)]\n    20\tpub static mut cp_error_reason: *const c_char = core::ptr::null();\n    21\t\n    22\t/// `uint8_t cp_fixed_table[288 + 32]`\n    23\t#[unsafe(no_mangle)]\n    24\tpub static mut cp_fixed_table: [u8; 288 + 32] = [\n    25\t    8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8,\n    26\t    8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8,\n    27\t    8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8