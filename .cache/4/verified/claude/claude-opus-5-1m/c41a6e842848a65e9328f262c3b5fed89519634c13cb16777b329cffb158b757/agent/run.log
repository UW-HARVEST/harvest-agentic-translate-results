/// ```\n#[repr(C)]\n#[allow(dead_code)]\npub struct CpImage {\n    pub w: c_int,\n    pub h: c_int,\n    pub pix: *mut CpPixel,\n}\n\n/// ```c\n/// static cp_pixel_t cp_make_pixel_a(uint8_t r, uint8_t g, uint8_t b, uint8_t a);\n/// ```\n#[allow(dead_code)]\npub fn cp_make_pixel_a(r: u8, g: u8, b: u8, a: u8) -> CpPixel {\n    CpPixel { r, g, b, a }\n}\n\n/// ```c\n/// static cp_pixel_t cp_make_pixel(uint8_t r, uint8_t g, uint8_t b);\n/// ```\n#[allow(dead_code)]\npub fn cp_make_pixel(r: u8, g: u8, b: u8) -> CpPixel {\n    CpPixel { r, g, b, a: 0xFF }\n}\n\n/// ```c\n/// typedef struct cp_raw_png_t { const uint8_t *p; const uint8_t *end; } cp_raw_png_t;\n/// ```\n#[repr(C)]\npub struct CpRawPng {\n    pub p: *const u8,\n    pub end: *const u8,\n}\n\n/// ```c\n/// static uint32_t cp_make32(const uint8_t *s) {\n///   return (s[0] << 24) | (s[1] << 16) | (s[2] << 8) | s[3];\n/// }\n/// ```\n#[allow(dead_code)]\npub unsafe fn cp_make32(s: *const u8) -> u32 {\n    (((*s.wrapping_offset(0) as c_int) << 24)\n        | ((*s.wrapping_offset(1) as c_int) << 16)\n        | ((*s.wrapping_offset(2) as c_int) << 8)\n        | (*s.wrapping_offset(3) as c_int)) as u32\n}\n\n/// ```c\n/// static const uint8_t *cp_chunk(cp_raw_png_t *png, const char *chunk, uint32_t minlen) { ... }\n/// ```\n#[allow(dead_code)]\npub unsafe fn cp_chunk(png: *mut CpRawPng, chunk: *const c_char, minlen: u32) -> *const u8 {\n    let len = cp_make32((*png).p);\n    let start = (*png).p;\n    if memcmp4(start.wrapping_offset(4), chunk as *const u8) == 0 && len >= minlen {\n        let offset = len.wrapping_add(12) as c_int;\n        if (*png).p.wrapping_offset(offset as isize) as usize <= (*png).end as usize {\n            (*png).p = (*png).p.wrapping_offset(offset as isize);\n            return start.wrapping_offset(8);\n        }\n    }\n    core::ptr::null()\n}\n\n/// ```c\n/// static const uint8_t *cp_find(cp_raw_png_t *png, const char *chunk, uint32_t minlen) { ... }\n/// ```\n#[allow(dead_code)]\npub unsafe fn cp_find(png: *mut CpRawPng, chunk: *const c_char, minlen: u32) -> *const u8 {\n    while ((*png).p as usize) < ((*png).end as usize) {\n        let len = cp_make32((*png).p);\n        let start = (*png).p;\n        (*png).p = (*png).p.wrapping_offset(len.wrapping_add(12) as c_int as isize);\n        if memcmp4(start.wrapping_offset(4), chunk as *const u8) == 0\n            && len >= minlen\n            && (*png).p as usize <= (*png).end as usize\n        {\n            return start.wrapping_offset(8);\n        }\n    }\n    core::ptr::null()\n}\n\n/// `memcmp(a, b, 4)`\n#[allow(dead_code)]\nunsafe fn memcmp4(a: *const u8, b: *const u8) -> c_int {\n    let mut i = 0isize;\n    while i < 4 {\n        let av = *a.wrapping_offset(i);\n        let bv = *b.wrapping_offset(i);\n        if av != bv {\n            return av as c_int - bv as c_int;\n        }\n        i += 1;\n    }\n    0\n}\n","structuredPatch":[{"oldStart":90,"oldLines":7,"newStart":90,"newLines":12,"lines":["     while ((*png).p as usize) < ((*png).end as usize) {","         let len = cp_make32((*png).p);","         let start = (*png).p;","-        (*png).p = (*png).p.wrapping_offset(len.wrapping_add(12) as c_int as isize);","+        // `png->p += len + 12;` — the addend keeps type `uint32_t` here (unlike","+        // `cp_chunk`, which first stores it in an `int`), so it is *zero*-extended","+        // for the pointer arithmetic.","+        (*png).p = (*png)","+            .p","+            .wrapping_add(len.wrapping_add(12) as usize);","         if memcmp4(start.wrapping_offset(4), chunk as *const u8) == 0","             && len >= minlen","             && (*png).p as usize <= (*png).end as usize"]}],"userModified":false,"replaceAll":false}}
{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_e3mb4qvmrkpsmsttuoqrr7koku6dll6ee46juhccdpz24a5mc5lq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01Snw6ar5w96nNPcjQh22qyY","name":"Bash","input":{"command":"cat > tests/zz_progname.rs <<'EOF'\n//! One-off check that glibc's `__assert_fail` prefix (`<progname>: `) is\n//! reproduced byte-for-byte by `src/cassert.rs`, i.e. that the *whole* assertion\n//! message matches, not only the normalised tail.\nmod common;\nuse common::{libs, run_inflate_forked, GuardedBuf, Runner};\n\n#[test]\nfn assert_message_prefix_matches() {\n    let (c, r) = libs();\n    let runner = Runner::new(\"progname\");\n    let inb = GuardedBuf::new(4096);\n    let oc = GuardedBuf::new(4096);\n    let or = GuardedBuf::new(4096);\n    inb.fill(0);\n    inb.write_at(0, &[0x03]); // BFINAL=1 BTYPE=01, truncated -> abort at lib.c:115\n    let a = run_inflate_forked(c, &runner, inb.ptr(), 1, &oc, 4096, 0xA5);\n    let b = run_inflate_forked(r, &runner, inb.ptr(), 1, &or, 4096, 0xA5);\n    eprintln!(\"C    stderr (normalised) = {:?}\", a.stderr);\n    eprintln!(\"Rust stderr (normalised) = {:?}\", b.stderr);\n    assert_eq!(a.stderr, b.stderr);\n    assert!(a.stderr.starts_with(\"lib.c:115: cp_consume_bits: Assertion\"));\n\n    // Now the raw (un-normalised) text, read straight from the capture files.\n    let raw_c = raw_stderr(c.cp_error_reason, || {\n        run_inflate_forked(c, &runner, inb.ptr(), 1, &oc, 4096, 0xA5)\n    });\n    let raw_r = raw_stderr(r.cp_error_reason, || {\n        run_inflate_forked(r, &runner, inb.ptr(), 1, &or, 4096, 0xA5)\n    });\n    eprintln!(\"C    raw = {raw_c:?}\");\n    eprintln!(\"Rust raw = {raw_r:?}\");\n    let pc = raw_c.split(':').next().unwrap();\n    let pr = raw_r.split(':').next().unwrap();\n    assert_eq!(\n        pc, pr,\n        \"program-name prefix differs: glibc uses __progname, cassert.rs uses \\\n         basename(argv[0])\"\n    );\n}\n\n/// The `Outcome::stderr` is normalised; re-read the underlying text.\nfn raw_stderr(_e: *mut std::os::raw::c_char, f: impl FnOnce() -> common::Outcome) -> String {\n    // `Runner` normalises, but the raw text only differs in the __FILE__ path;\n    // reconstruct the prefix from the normalised value plus the capture file.\n    let o = f();\n    // the prefix is everything the normaliser removed, so read it back from the\n    // capture: the file still holds the full message after the call.\n    let dir = std::env::var(\"TMPDIR\").unwrap_or_else(|_| \"/tmp\".into());\n    let mut best = String::new();\n    if let Ok(rd) = std::fs::read_dir(&dir) {\n        for e in rd.flatten() {\n            let n = e.file_name().to_string_lossy().into_owned();\n            if n.starts_with(&format!(\"cdiff-stderr-{}-progname\", std::process::id())) {\n                if let Ok(s) = std::fs::read_to_string(e.path()) {\n                    if !s.is_empty() {\n                        best = s;\n                    }\n                }\n            }\n        }\n    }\n    let _ = o;\n    best\n}\nEOF\ntimeout 300 cargo build --offline 2>&1|tail -2 && timeout 300 cargo test --offline --test zz_progname -- --nocapture 2>&1 | tail -20","description":"Check assert message program-name prefix"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2488,"cache_read_input_tokens":405579,"cache_creation":{"ephemeral_5m_input_tokens":2488,"ephemeral_1h_input_tokens":0},"output_tokens":20,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"11c90248-8d1c-40fd-9984-20406bde7194","uuid":"8894338b-57e1-409e-9088-9be9ded81306","timestamp":"2026-08-20T17:57:58.817Z"}
