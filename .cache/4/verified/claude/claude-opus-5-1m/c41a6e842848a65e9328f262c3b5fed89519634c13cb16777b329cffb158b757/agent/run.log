        assert nb<=32, \"A123\"\n        assert nb>=0, \"A124\"\n        assert self.bits_left>0, (\"A125\", self.bits_left)\n        assert self.count<=64, \"A126\"\n        assert (self.bits_left+self.count)-nb>=0, (\"A127\", self.bits_left,self.count,nb)\n        self.peak(nb)\n        return self.consume(nb)\n\ndef rev16(a):\n    a=((a&0xAAAA)>>1)|((a&0x5555)<<1)\n    a=((a&0xCCCC)>>2)|((a&0x3333)<<2)\n    a=((a&0xF0F0)>>4)|((a&0x0F0F)<<4)\n    a=((a&0xFF00)>>8)|((a&0x00FF)<<8)\n    return a&M32\n\ndef build(s, tree, lens, sym_count):\n    counts=[0]*32\n    for n in range(sym_count):\n        counts[lens[n]]+=1\n    codes=[0]*16; first=[0]*16\n    counts[0]=0; codes[0]=0; first[0]=0\n    for n in range(1,16):\n        codes[n]=(codes[n-1]+counts[n-1])<<1\n        first[n]=first[n-1]+counts[n-1]\n    if s is not None:\n        s.lookup=[0]*512\n    for i in range(sym_count):\n        l=lens[i]\n        if l!=0:\n            assert l<16, (\"A154\", l)\n            code=codes[l]; codes[l]+=1\n            slot=first[l]; first[l]+=1\n            while len(tree)<=slot: tree.append(0)\n            tree[slot]=((code<<(32-l))|(i<<4)|l)&M32\n            if s is not None and l<=9:\n                j=rev16(code)>>(16-l)\n                while j<512:\n                    s.lookup[j]=((l<<9)|i)&0xFFFF\n                    j+= (1<<l)\n    return first[15]\n\ndef decode(s, tree, hi):\n    bits=s.peak(16)\n    search=((rev16(bits&M32)<<16)|0xFFFF)&M32\n    lo=0\n    while lo<hi:\n        g=(lo+hi)>>1\n        if search < tree[g]: hi=g\n        else: lo=g+1\n    key=tree[lo-1] if lo-1>=0 else (\"OOB\",)\n    if isinstance(key,tuple): raise Exception(\"tree[-1] read\")\n    l=(32-(key&0xF))&0xFFFFFFFF\n    a=(search>>(l&31))&M32; b=(key>>(l&31))&M32\n    assert a==b, (\"A217\", hex(search),hex(key),l)\n    s.consume(key&0xF)\n    return (key>>4)&0xFFF\n\ns=S(data,len(data))\nbfinal=s.read(1); btype=s.read(2)\nprint(\"bfinal\",bfinal,\"btype\",btype)\nnlit=257+s.read(5); ndst=1+s.