{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01WPqVf9zpLc9sTgTFnTsRja","type":"tool_result","content":"1\t// Copyright 2025 MIT Lincoln Laboratory\n2\t// Permission is hereby granted, free of charge,\n3\t// to any person obtaining a copy of this software\n4\t// and associated documentation files (the \"Software\"),\n5\t// to deal in the Software without restriction,\n6\t// including without limitation the rights to use, copy,\n7\t// modify, merge, publish, distribute, sublicense,\n8\t// and/or sell copies of the Software,\n9\t// and to permit persons to whom the Software is furnished to do so,\n10\t// subject to the following conditions:\n11\t//\n12\t// The above copyright notice and this permission notice\n13\t// shall be included in all copies or substantial portions of the Software.\n14\t//\n15\t// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n16\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n17\t// THE WARRANTIES OF MERCHANTABILITY,\n18\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n19\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n20\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n21\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n22\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n23\t\n24\t//! Faithful Rust translation of `c_src/src/main.c`.\n25\t//!\n26\t//! The C program is a CWE-190 (integer overflow) demonstration driver. It reads\n27\t//! a single integer with `scanf(\"%d\", &x)` and then either exercises the buggy\n28\t//! (`bad`) or the fixed (`good`) code path. Byte-for-byte output compatibility\n29\t//! with the original (glibc / x86-64 Linux, where `char` is signed) is required,\n30\t//! including the signed-char-to-`int` promotion that makes `printf(\"%02x\")`\n31\t//! print a sign extended 32-bit value.\n32\t\n33\tuse std::io::{Read, Write};\n34\t\n35\t/// `CHAR_MAX` for platforms where `char` is signed (x86-64 Linux).\n36\tconst CHAR_MAX: i8 = i8::MAX;\n37\t\n38\t/// Equivalent of C's `printLine`.\n39\t///\n40\t/// The C version guards against a NULL pointer; `Option<&str>` models that,\n41\t/// though every call site in this program passes a real string literal.\n42\tfn print_line(line: Option<&str>) {\n43\t    if let Some(line) = line {\n44\t        println!(\"{}\", line);\n45\t    }\n46\t}\n47\t\n48\t/// Equivalent of C's `printHexCharLine`.\n49\t///\n50\t/// In C the `char` argument is promoted to `int` for the variadic call, and\n51\t/// `%02x` then reinterprets those 32 bits as an `unsigned int`. So a negative\n52\t/// char such as `-2` prints as `fffffffe`, not `fe`.\n53\tfn print_hex_char_line(char_hex: i8) {\n54\t    let promoted = char_hex as i32; // default argument promotion (sign extend)\n55\t    println!(\"{:02x}\", promoted as u32); // %02x reinterprets as unsigned int\n56\t}\n57\t\n58\t/// Equivalent of C's `bad`: `CHAR_MAX * 2` overflows the `char` result.\n59\tfn bad() {\n60\t    let data: i8;\n61\t    data = CHAR_MAX;\n62\t    if data > 0 {\n63\t        // `data * 2` is computed in `int` then truncated back into a `char`.\n64\t        let result: i8 = ((data as i32) * 2) as i8;\n65\t        print_hex_char_line(result);\n66\t    }\n67\t}\n68\t\n69\t/// Equivalent of C's `goodG2B`: a small value that cannot overflow.\n70\tfn good_g2b() {\n71\t    let data: i8;\n72\t    data = 2;\n73\t    if data > 0 {\n74\t        let result: i8 = ((data as i32) * 2) as i8;\n75\t        print_hex_char_line(result);\n76\t    }\n77\t}\n78\t\n79\t/// Equivalent of C's `goodB2G`: range-checks before doubling.\n80\t#[allow(unused_assignments)] // the dead store to `data` exists in the C source\n81\tfn good_b2g() {\n82\t    let mut data: i8;\n83\t    data = b' ' as i8;\n84\t    data = CHAR_MAX;\n85\t    if data > 0 {\n86\t        // CHAR_MAX / 2 is integer division => 63.\n87\t        if (data as i32) < (CHAR_MAX as i32) / 2 {\n88\t            let result: i8 = ((data as i32) * 2) as i8;\n89\t            print_hex_char_line(result);\n90\t        } else {\n91\t            print_line(Some(\n92\t                \"data value is too large to perform arithmetic safely.\",\n93\t            ));\n94\t        }\n95\t    }\n96\t}\n97\t\n98\t/// Equivalent of C's `good`.\n99\tfn good() {\n100\t    good_g2b();\n101\t    good_b2g();\n102\t}\n103\t\n104\t/// Minimal stdin byte source that only consumes what `scanf` would consume.\n105\tstruct Stdin {\n106\t    inner: std::io::Stdin,\n107\t    peeked: Option<u8>,\n108\t}\n109\t\n110\timpl Stdin {\n111\t    fn new() -> Self {\n112\t        Stdin {\n113\t            inner: std::io::stdin(),\n114\t            peeked: None,\n115\t        }\n116\t    }\n117\t\n118\t    /// Reads one byte, or `None` at EOF / on error (matching `getc` -> EOF).\n119\t    fn next_byte(&mut self) -> Option<u8> {\n120\t        if let Some(b) = self.peeked.take() {\n121\t            return Some(b);\n122\t        }\n123\t        let mut buf = [0u8; 1];\n124\t        match self.inner.read(&mut buf) {\n125\t            Ok(1) => Some(buf[0]),\n126\t            _ => None,\n127\t        }\n128\t    }\n129\t\n130\t    /// Pushes a byte back, like `ungetc`.\n131\t    fn unread(&mut self, b: u8) {\n132\t        self.peeked = Some(b);\n133\t    }\n134\t}\n135\t\n136\t/// Emulates glibc's `scanf(\"%d\", &x)`.\n137\t///\n138\t/// Returns `Some(value)` on a successful conversion and `None` on a matching\n139\t/// failure or input failure (in which case the C code leaves `x` untouched).\n140\t///\n141\t/// glibc parses the digits with `strtol` semantics: out-of-range values saturate\n142\t/// to `LONG_MAX` / `LONG_MIN` (64-bit here) and the result is then truncated\n143\t/// into the `int` object, so e.g. `99999999999999999999` yields `-1` and\n144\t/// `4294967296` yields `0`.\n145\tfn scanf_i32(input: &mut Stdin) -> Option<i32> {\n146\t    // %d first skips any amount of leading whitespace.\n147\t    let mut cur = loop {\n148\t        match input.next_byte() {\n149\t            Some(b) if (b as char).is_ascii_whitespace() => continue,\n150\t            Some(b) => break b,\n151\t            None => return None, // input failure (EOF before any conversion)\n152\t        }\n153\t    };\n154\t\n155\t    let mut negative = false;\n156\t    if cur == b'+' || cur == b'-' {\n157\t        negative = cur == b'-';\n158\t        match input.next_byte() {\n159\t            Some(b) => cur = b,\n160\t            None => return None, // sign with nothing after it: no conversion\n161\t        }\n162\t    }\n163\t\n164\t    if !cur.is_ascii_digit() {\n165\t        input.unread(cur);\n166\t        return None; // matching failure\n167\t    }\n168\t\n169\t    // Accumulate the magnitude, keeping it bounded so arbitrarily long digit\n170\t    // runs cannot overflow the accumulator itself.\n171\t    const CAP: u128 = (i64::MAX as u128) + 2; // anything >= this saturates\n172\t    let mut magnitude: u128 = 0;\n173\t    loop {\n174\t        magnitude = magnitude * 10 + u128::from(cur - b'0');\n175\t        if magnitude > CAP {\n176\t            magnitude = CAP;\n177\t        }\n178\t        match input.next_byte() {\n179\t            Some(b) if b.is_ascii_digit() => cur = b,\n180\t            Some(b) => {\n181\t                input.unread(b);\n182\t                break;\n183\t            }\n184\t            None => break,\n185\t        }\n186\t    }\n187\t\n188\t    // strtol-style saturation into `long`, then truncation into `int`.\n189\t    let as_long: i64 = if negative {\n190\t        if magnitude > (i64::MAX as u128) + 1 {\n191\t            i64::MIN\n192\t        } else {\n193\t            (-(magnitude as i128)) as i64\n194\t        }\n195\t    } else if magnitude > i64::MAX as u128 {\n196\t        i64::MAX\n197\t    } else {\n198\t        magnitude as i64\n199\t    };\n200\t\n201\t    Some(as_long as i32)\n202\t}\n203\t\n204\tfn main() {\n205\t    let mut x: i32 = 0;\n206\t    let mut input = Stdin::new();\n207\t    if let Some(v) = scanf_i32(&mut input) {\n208\t        x = v;\n209\t    }\n210\t\n211\t    if x != 0 {\n212\t        good();\n213\t    } else {\n214\t        bad();\n215\t    }\n216\t\n217\t    // Match C's flush-at-exit behavior for stdout.\n218\t    let _ = std::io::stdout().flush();\n219\t}\n220\t"}]},"parent_tool_use_id":null,"session_id":"3cf9f6fa-bd36-4506-9e35-ca148f30a049","uuid":"75940d8c-79e1-4326-90d2-98a7d15b3dd7","timestamp":"2026-08-18T03:27:13.360Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-kL7Mf2/translated_rust/src/main.rs","content":"// Copyright 2025 MIT Lincoln Laboratory\n// Permission is hereby granted, free of charge,\n// to any person obtaining a copy of this software\n// and associated documentation files (the \"Software\"),\n// to deal in the Software without restriction,\n// including without limitation the rights to use, copy,\n// modify, merge, publish, distribute, sublicense,\n// and/or sell copies of the Software,\n// and to permit persons to whom the Software is furnished to do so,\n// subject to the following conditions:\n//\n// The above copyright notice and this permission notice\n// shall be included in all copies or substantial portions of the Software.\n//\n// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n// THE WARRANTIES OF MERCHANTABILITY,\n// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n\n//! Faithful Rust translation of `c_src/src/main.c`.\n//!\n//! The C program is a CWE-190 (integer overflow) demonstration driver. It reads\n//! a single integer with `scanf(\"%d\", &x)` and then either exercises the buggy\n//! (`bad`) or the fixed (`good`) code path. Byte-for-byte output compatibility\n//! with the original (glibc / x86-64 Linux, where `char` is signed) is required,\n//! including the signed-char-to-`int` promotion that makes `printf(\"%02x\")`\n//! print a sign extended 32-bit value.\n\nuse std::io::{Read, Write};\n\n/// `CHAR_MAX` for platforms where `char` is signed (x86-64 Linux).\nconst CHAR_MAX: i8 = i8::MAX;\n\n/// Equivalent of C's `printLine`.\n///\n/// The C version guards against a NULL pointer; `Option<&str>` models that,\n/// though every call site in this program passes a real string literal.\nfn print_line(line: Option<&str>) {\n    if let Some(line) = line {\n        println!(\"{}\", line);\n    }\n}\n\n/// Equivalent of C's `printHexCharLine`.\n///\n/// In C the `char` argument is promoted to `int` for the variadic call, and\n/// `%02x` then reinterprets those 32 bits as an `unsigned int`. So a negative\n/// char such as `-2` prints as `fffffffe`, not `fe`.\nfn print_hex_char_line(char_hex: i8) {\n    let promoted = char_hex as i32; // default argument promotion (sign extend)\n    println!(\"{:02x}\", promoted as u32); // %02x reinterprets as unsigned int\n}\n\n/// Equivalent of C's `bad`: `CHAR_MAX * 2` overflows the `char` result.\nfn bad() {\n    let data: i8;\n    data = CHAR_MAX;\n    if data > 0 {\n        // `data * 2` is computed in `int` then truncated back into a `char`.\n        let result: i8 = ((data as i32) * 2) as i8;\n        print_hex_char_line(result);\n    }\n}\n\n/// Equivalent of C's `goodG2B`: a small value that cannot overflow.\nfn good_g2b() {\n    let data: i8;\n    data = 2;\n    if data > 0 {\n        let result: i8 = ((data as i32) * 2) as i8;\n        print_hex_char_line(result);\n    }\n}\n\n/// Equivalent of C's `goodB2G`: range-checks before doubling.\n#[allow(unused_assignments)] // the dead store to `data` exists in the C source\nfn good_b2g() {\n    let mut data: i8;\n    data = b' ' as i8;\n    data = CHAR_MAX;\n    if data > 0 {\n        // CHAR_MAX / 2 is integer division => 63.\n        if (data as i32) < (CHAR_MAX as i32) / 2 {\n            let result: i8 = ((data as i32) * 2) as i8;\n            print_hex_char_line(result);\n        } else {\n            print_line(Some(\n                \"data value is too large to perform arithmetic safely.\",\n            ));\n        }\n    }\n}\n\n/// Equivalent of C's `good`.\nfn good() {\n    good_g2b();\n    good_b2g();\n}\n\n/// Minimal stdin byte source that only consumes what `scanf` would consume.\nstruct Stdin {\n    inner: std::io::Stdin,\n    peeked: Option<u8>,\n}\n\nimpl Stdin {\n    fn new() -> Self {\n        Stdin {\n            inner: std::io::stdin(),\n            peeked: None,\n        }\n    }\n\n    /// Reads one byte, or `None` at EOF / on error (matching `getc` -> EOF).\n    fn next_byte(&mut self) -> Option<u8> {\n        if let Some(b) = self.peeked.take() {\n            return Some(b);\n        }\n        let mut buf = [0u8; 1];\n        match self.inner.read(&mut buf) {\n            Ok(1) => Some(buf[0]),\n            _ => None,\n        }\n    }\n\n    /// Pushes a byte back, like `ungetc`.\n    fn unread(&mut self, b: u8) {\n        self.peeked = Some(b);\n    }\n}\n\n/// Emulates glibc's `scanf(\"%d\", &x)`.\n///\n/// Returns `Some(value)` on a successful conversion and `None` on a matching\n/// failure or input failure (in which case the C code leaves `x` untouched).\n///\n/// glibc parses the digits with `strtol` semantics: out-of-range values saturate\n/// to `LONG_MAX` / `LONG_MIN` (64-bit here) and the result is then truncated\n/// into the `int` object, so e.g. `99999999999999999999` yields `-1` and\n/// `4294967296` yields `0`.\nfn scanf_i32(input: &mut Stdin) -> Option<i32> {\n    // %d first skips any amount of leading whitespace.\n    let mut cur = loop {\n        match input.next_byte() {\n            Some(b) if (b as char).is_ascii_whitespace() => continue,\n            Some(b) => break b,\n            None => return None, // input failure (EOF before any conversion)\n        }\n    };\n\n    let mut negative = false;\n    if cur == b'+' || cur == b'-' {\n        negative = cur == b'-';\n        match input.next_byte() {\n            Some(b) => cur = b,\n            None => return None, // sign with nothing after it: no conversion\n        }\n    }\n\n    if !cur.is_ascii_digit() {\n        input.unread(cur);\n        return None; // matching failure\n    }\n\n    // Accumulate the magnitude, keeping it bounded so arbitrarily long digit\n    // runs cannot overflow the accumulator itself.\n    const CAP: u128 = (i64::MAX as u128) + 2; // anything >= this saturates\n    let mut magnitude: u128 = 0;\n    loop {\n        magnitude = magnitude * 10 + u128::from(cur - b'0');\n        if magnitude > CAP {\n            magnitude = CAP;\n        }\n        match input.next_byte() {\n            Some(b) if b.is_ascii_digit() => cur = b,\n            Some(b) => {\n                input.unread(b);\n                break;\n            }\n            None => break,\n        }\n    }\n\n    // strtol-style saturation into `long`, then truncation into `int`.\n    let as_long: i64 = if negative {\n        if magnitude > (i64::MAX as u128) + 1 {\n            i64::MIN\n        } else {\n            (-(magnitude as i128)) as i64\n        }\n    } else if magnitude > i64::MAX as u128 {\n        i64::MAX\n    } else {\n        magnitude as i64\n    };\n\n    Some(as_long as i32)\n}\n\nfn main() {\n    let mut x: i32 = 0;\n    let mut input = Stdin::new();\n    if let Some(v) = scanf_i32(&mut input) {\n        x = v;\n    }\n\n    if x != 0 {\n        good();\n    } else {\n        bad();\n    }\n\n    // Match C's flush-at-exit behavior for stdout.\n    let _ = std::io::stdout().flush();\n}\n","numLines":220,"startLine":1,"totalLines":220}}}
