n//\n// Public ABI (matches `nm -D` on the C shared library):\n//   * fma_array\n//   * driver\n//\n// `inner` is `static` in the C source and therefore is NOT exported here.\n\nuse core::ffi::{c_char, c_int, c_void};\n\nunsafe extern \"C\" {\n    /// C standard library `printf`, used so that stdout buffering behavior\n    /// (and therefore the exact byte stream produced) matches the C library.\n    fn printf(fmt: *const c_char, ...) -> c_int;\n\n    /// C standard library `memcpy`, used so that `driver`'s copy has exactly\n    /// the same semantics (including for degenerate lengths) as the C source.\n    fn memcpy(dest: *mut c_void, src: *const c_void, n: usize) -> *mut c_void;\n}\n\n/// Format string used by the `printf(\"%d\\n\", ...)` call in the C source.\nconst FMT_D_NL: &[u8; 4] = b\"%d\\n\\0\";\n\n/// ```c\n/// void fma_array(int *out, const int *mul1, const int *mul2, const int *add, int len) {\n///     for (int i = 0; i < len; i++) {\n///         out[i] = mul1[i] * mul2[i] + add[i];\n///     }\n/// }\n/// ```\n///\n/// The C callers pass fully aliasing pointers (`out == mul1 == mul2 == add`),\n/// so raw pointer accesses are used here instead of slices.\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn fma_array(\n    out: *mut c_int,\n    mul1: *const c_int,\n    mul2: *const c_int,\n    add: *const c_int,\n    len: c_int,\n) {\n    let mut i: c_int = 0;\n    while i < len {\n        let idx = i as isize;\n        let a = unsafe { *mul1.offset(idx) };\n        let b = unsafe { *mul2.offset(idx) };\n        let c = unsafe { *add.offset(idx) };\n        // C signed overflow is UB; reproduce the two's-complement wrapping\n        // behavior emitted by the C compiler on the target hardware.\n        let v = a.wrapping_mul(b).wrapping_add(c);\n        unsafe { *out.offset(idx) = v };\n        i += 1;\n    }\n}\n\n/// ```c\n/// static void inner(int *out, int len) {\n///     fma_array(out, out, out, out, len);\n///     for (int i = 0; i < len; i++) {\n///         printf(\"%d\\n\", out[i]);\n///     }\n/// }\n/// ```\nunsafe fn inner(out: *mut c_int, len: c_int) {\n    unsafe { fma_array(out, out, out, out, len) };\n    let mut i: c_int = 0;\n    while i < len {\n        let v = unsafe { *out.offset(i as isize) };\n        unsafe { printf(FMT_D_NL.as_ptr() as *const c_char, v) };\n        i += 1;\n    }\n}\n\n/// ```c\n/// void driver(const int *data, int len) {\n///     int out[len];\n///     memcpy(out, data, len * sizeof(int));\n///     inner(out, len);\n/// }\n/// ```\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn driver(data: *const c_int, len: c_int) {\n    // `len * sizeof(int)` in C: `int` is converted to `size_t`, so a negative\n    // length becomes an enormous unsigned byte count (the original UB is\n    // reproduced rather than \"fixed\"). `black_box` keeps the optimizer from\n    // reasoning about (and deleting) that out-of-range copy.\n    let nbytes = core::hint::black_box((len as usize).wrapping_mul(core::mem::size_of::<c_int>()));\n\n    // ---- `int out[len];` ---------------------------------------------------\n    //\n    // gcc lowers a variable-length array to a bare `rsp -= nbytes`: there is no\n    // stack probe, no size validation and no failure path, so the VLA simply\n    // *is* the `nbytes` bytes below the current stack pointer whether or not\n    // that memory is usable. As a result the C library dies with `SIGSEGV` --\n    // faulting on the VLA's *first* byte, which is where the `memcpy` below\n    // starts writing -- as soon as `nbytes` exceeds the stack space left in the\n    // running thread. That happens for oversized positive lengths (e.g.\n    // `len == INT_MAX` asks for 8 GiB) and for every negative length (whose\n    // wrapped byte count can never fit).\n    //\n    // Rust has no VLA. `vla_base` below is the address the C VLA's first byte\n    // would live at -- `rsp - nbytes`, computed off a local so that it tracks the\n    // real stack pointer.\n    let mut anchor: c_int = 0;\n    let vla_base: *mut u8 = core::hint::black_box(\n        core::hint::black_box(&mut anchor as *mut c_int)\n            .cast::<u8>()\n            .wrapping_sub(nbytes),\n    );\n\n    // Touching that byte reproduces the C VLA's *fault behaviour* exactly: where\n    // the C would have got away with the allocation this is a harmless read of\n    // stack scratch space, and where the C would not (an oversized `nbytes`, or\n    // any negative `len` whose wrapped `nbytes` puts the VLA outside the stack)\n    // it faults with the same signal at the same fault address, at the same point\n    // in the call sequence -- before anything has been printed.\n    core::hint::black_box(unsafe { core::ptr::read_volatile(vla_base as *const u8) });\n\n    if len >= 0 {\n        // Stand-in for the C variable length array `int out[len]`. The storage\n        // cannot be placed below the stack pointer the way the C VLA is, because\n        // the `printf` frames that `inner` creates would clobber it; the values\n        // and the printed bytes are unaffected by where the buffer lives.\n        let mut out: Vec<c_int> = vec![0; len as usize];\n        unsafe {\n            memcpy(out.as_mut_ptr().cast::<c_void>(), data.cast::<c_void>(), nbytes);\n            inner(out.as_mut_ptr(), len);\n        }\n    } else {\n        // Negative length. `(size_t)(len * sizeof(int))` is enormous, so\n        // `rsp -= nbytes` moves the stack pointer *up*: the C VLA's base address\n        // is `rsp + |len| * sizeof(int)`, i.e. it points into the caller's frames,\n        // and the `memcpy` then writes there with the same enormous count. Which\n        // memory that clobbers -- and therefore whether the process survives the\n        // return -- depends on the exact address, so the copy is performed at the\n        // very same address the C uses (`vla_base`) rather than into a local.\n        //\n        // Nothing else runs on the corrupted stack: `inner` skips both of its\n        // loops for a negative `len`, so it prints nothing, exactly as in the C.\n        let dst = vla_base.cast::<c_int>();\n        unsafe {\n            memcpy(dst.cast::<c_void>(), data.cast::<c_void>(), nbytes);\n            inner(dst, len);\n        }\n    }\n}\n","structuredPatch":[{"oldStart":99,"oldLines":13,"newStart":99,"newLines":23,"lines":["     // wrapped byte count can never fit).","     //","     // Rust has no VLA. `vla_base` below is the address the C VLA's first byte","-    // would live at -- `rsp - nbytes`, computed off a local so that it tracks the","-    // real stack pointer.","+    // would live at, computed off a local so that it tracks the real stack","+    // pointer. gcc reserves the size rounded *up* to a 16-byte multiple and then","+    // rounds the resulting pointer up to a 4-byte boundary, i.e. exactly","+    //","+    //     rax = (int64)len * 4;  rax = (rax + 15) / 16 * 16;  rsp -= rax;","+    //     out = ((rsp + 3) >> 2) << 2;","+    //","+    // (all unsigned, all wrapping - see the `driver` disassembly of the C `.so`).","+    let vla_size = core::hint::black_box(nbytes.wrapping_add(15) / 16 * 16);","     let mut anchor: c_int = 0;","     let vla_base: *mut u8 = core::hint::black_box(","-        core::hint::black_box(&mut anchor as *mut c_int)","+        (core::hint::black_box(&mut anchor as *mut c_int)","             .cast::<u8>()","-            .wrapping_sub(nbytes),","+            .wrapping_sub(vla_size) as usize","+            + 3","+            >> 2","+            << 2) as *mut u8,","     );"," ","     // Touching that byte reproduces the C VLA's *fault behaviour* exactly: where"]}],"userModified":false,"replaceAll":false}}
{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_xibgocikj25bqezdcwreiswv6grgowlisjbiq43ryvbhbztn77mq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01Nu22iUFHMLxnHD1PFWiQ97","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-ERuUF0/translated_rust/tests/diag_negative_len.rs","content":"// Diagnostic (not a gate): tabulates how the C `.so` and the Rust `.so` behave\n// for negative / oversized `driver` lengths, and demonstrates that the C\n// library's own outcome for a negative length depends on the *caller's* stack\n// frame. Run with:\n//\n//     cargo test --test diag_negative_len -- --ignored --nocapture\n\nmod common;\n\nuse common::*;\nuse std::ffi::c_int;\n\nfn disp_pair(data: &[c_int], len: c_int) -> (Disposition, usize) {\n    let p = data.as_ptr();\n    let (d, o) = run_in_child_capturing(|| unsafe { (c_lib().driver)(p, len) });\n    (d, o.len())\n}\n\nfn disp_pair_rust(data: &[c_int], len: c_int) -> (Disposition, usize) {\n    let p = data.as_ptr();\n    let (d, o) = run_in_child_capturing(|| unsafe { (rust_lib().driver)(p, len) });\n    (d, o.len())\n}\n\n// Four call sites at different stack depths, to show frame dependence.\n#[inline(never)]\nfn depth1(data: &[c_int], len: c_int) -> Disposition {\n    let p = data.as_ptr();\n    run_in_child(|| unsafe { (c_lib().driver)(p, len) })\n}\n#[inline(never)]\nfn depth2(data: &[c_int], len: c_int) -> Disposition {\n    let _pad = [0u64; 16];\n    let p = data.as_ptr();\n    let d = run_in_child(|| unsafe { (c_lib().driver)(p, len) });\n    std::hint::black_box(&_pad);\n    d\n}\n#[inline(never)]\nfn depth3(data: &[c_int], len: c_int) -> Disposition {\n    let _pad = [0u64; 64];\n    let p = data.as_ptr();\n    let d = run_in_child(|| unsafe { (c_lib().driver)(p, len) });\n    std::hint::black_box(&_pad);\n    d\n}\n\n#[test]\n#[ignore = \"diagnostic; prints a table instead of asserting\"]\nfn diag_table() {\n    let data: Vec<c_int> = (0..4096).collect();\n    let mut lens: Vec<c_int> = vec![-1, -2, -3, -4, -5, -6, -7, -8, -12, -16, -20, -32, -64, -128];\n    for k in 8..31 {\n        lens.push(-(1 << k));\n    }\n    lens.push(INT_MIN);\n    println!(\"{:>12} | {:>26} | {:>26}\", \"len\", \"C\", \"Rust\");\n    for &len in &lens {\n        let (cd, cn) = disp_pair(&data, len);\n        let (rd, rn) = disp_pair_rust(&data, len);\n        let flag = if cd == rd { \"\" } else { \"   <== DIFFERS\" };\n        println!(\"{len:>12} | {:>18} {cn:>6} | {:>18} {rn:>6}{flag}\", cd.to_string(), rd.to_string());\n    }\n}\n\n#[test]\n#[ignore = \"diagnostic; prints a table instead of asserting\"]\nfn diag_c_is_caller_frame_dependent() {\n    let data: Vec<c_int> = (0..4096).collect();\n    println!(\"C library `driver(data, len)` outcome by caller frame depth:\");\n    println!(\"{:>12} | {:>12} | {:>12} | {:>12}\", \"len\", \"depth1\", \"depth2\", \"depth3\");\n    let mut differing = 0;\n    let mut lens: Vec<c_int> = vec![-1, -2, -4, -8, -16, -32, -64, -128, -256, -512, -1024];\n    for k in 11..24 {\n        lens.push(-(1 << k));\n    }\n    for &len in &lens {\n        let a = depth1(&data, len);\n        let b = depth2(&data, len);\n        let c = depth3(&data, len);\n        let flag = if a == b && b == c { \"\" } else { \"   <== frame dependent\" };\n        if !(a == b && b == c) {\n            differing += 1;\n        }\n        println!(\n            \"{len:>12} | {:>12} | {:>12} | {:>12}{flag}\",\n            a.to_string(),\n            b.to_string(),\n            c.to_string()\n        );\n    }\n    println!(\"\\n{differing} of the tested negative lengths give the *C library* a different \\\n              outcome purely because the caller's frame changed.\");\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6755,"cache_read_input_tokens":146596,"cache_creation":{"ephemeral_5m_input_tokens":6755,"ephem