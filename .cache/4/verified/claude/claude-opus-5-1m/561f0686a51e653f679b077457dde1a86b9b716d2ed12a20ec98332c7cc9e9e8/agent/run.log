rent stack pointer whether or not\n    // that memory is usable. As a result the C library dies with `SIGSEGV` --\n    // faulting on the VLA's *first* byte, which is where the `memcpy` below\n    // starts writing -- as soon as `nbytes` exceeds the stack space left in the\n    // running thread. That happens for oversized positive lengths (e.g.\n    // `len == INT_MAX` asks for 8 GiB) and for every negative length (whose\n    // wrapped byte count can never fit).\n    //\n    // Rust has no VLA, and the storage cannot simply be placed below the stack\n    // pointer because the `printf` frames that `inner` creates would clobber it.\n    // The storage is therefore taken from elsewhere, and the *fault behaviour*\n    // of the C VLA is reproduced explicitly by touching the exact address the\n    // VLA's first byte would occupy: where the C would have got away with it\n    // this is a harmless read of stack scratch space, and where the C would have\n    // faulted this faults identically -- same signal, same fault address, at the\n    // same point in the call sequence (before anything has been printed).\n    let anchor: c_int = 0;\n    let vla_base = core::hint::black_box(\n        core::hint::black_box(&anchor as *const c_int)\n            .cast::<u8>()\n            .wrapping_sub(nbytes),\n    );\n    core::hint::black_box(unsafe { core::ptr::read_volatile(vla_base) });\n\n    if len >= 0 {\n        // Stand-in for the C variable length array `int out[len]`.\n        let mut out: Vec<c_int> = vec![0; len as usize];\n        unsafe {\n            memcpy(out.as_mut_ptr().cast::<c_void>(), data.cast::<c_void>(), nbytes);\n            inner(out.as_mut_ptr(), len);\n        }\n    } else {"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":544,"cache_read_input_tokens":119311,"cache_creation":{"ephemeral_5m_input_tokens":544,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},