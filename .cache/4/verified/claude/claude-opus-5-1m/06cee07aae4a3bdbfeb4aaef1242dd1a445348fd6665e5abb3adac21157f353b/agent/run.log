Debug)]\npub struct PcmBuf {\n    pub data: Vec<i16>,\n    pub base: usize,\n}\n\nimpl PcmBuf {\n    /// Buffer large enough for `pcm[0]` and `pcm[16 * nch]`, prefilled with a\n    /// recognisable poison value so that stray writes are visible.\n    pub fn for_nch(nch: c_int) -> Self {\n        let off = 16i32.wrapping_mul(nch) as isize;\n        let base = if off < 0 { (-off) as usize + 8 } else { 8 };\n        let span = base as isize + off;\n        let len = (base + 8).max(span as usize + 8);\n        PcmBuf {\n            data: vec![0x5A5Au16 as i16; len],\n            base,\n        }\n    }\n\n    pub fn ptr(&mut self) -> *mut i16 {\n        unsafe { self.data.as_mut_ptr().add(self.base) }\n    }\n}\n\n/// Run one differential call: identical inputs to both libraries, returning the\n/// two resulting PCM buffers.\npub fn run_pair(nch: c_int, z: &[f32]) -> (Vec<i16>, Vec<i16>) {\n    assert!(\n        z.len() >= Z_LEN,\n        \"z must have at least {Z_LEN} elements, got {}\",\n        z.len()\n    );\n    let mut c_buf = PcmBuf::for_nch(nch);\n    let mut r_buf = c_buf.clone();\n\n    let c = c_synth_pair();\n    let r = rust_synth_pair();\n    unsafe {\n        c(c_buf.ptr(), nch, z.as_ptr());\n        r(r_buf.ptr(), nch, z.as_ptr());\n    }\n    (c_buf.data, r_buf.data)\n}\n\n/// Assert byte-identical PCM output for one configuration.\npub fn assert_same(label: &str, nch: c_int, z: &[f32]) {\n    let (c_out, r_out) = run_pair(nch, z);\n    if c_out != r_out {\n        let base = PcmBuf::for_nch(nch).base;\n        let off = 16i32.wrapping_mul(nch) as isize;\n        let diffs: Vec<String> = c_out\n            .iter()\n            .zip(r_out.iter())\n            .enumerate()\n            .filter(|(_, (a, b))| a != b)\n            .map(|(i, (a, b))| format!(\"  [{i}] C={a} RUST={b}\"))\n            .collect();\n        panic!(\n            \"{label}: PCM mismatch (nch={nch}, base={base}, second-store offset={off})\\n\\\n             taps: {}\\n{}\",\n            describe_taps(z),\n            diffs.join(\"\\n\")\n        );\n    }\n}\n\nfn describe_taps(z: &[f32]) -> String {\n    let mut v = Vec::new();\n    for i in 0..15 {\n        v.push(format!(\"z[{}*64]={:e}\", i, z[i * 64]));\n    }\n    for i in 0..15 {\n        v.push(format!(\"z[2+{}*64]={:e}\", i, z[2 + i * 64]));\n    }\n    v.join(\" \")\n}\n\n// ---------------------------------------------------------------------------\n// Deterministic PRNG (SplitMix64) -- fixed seeds keep every failure reproducible\n// ---------------------------------------------------------------------------\n\npub struct Rng(u64);\n\nimpl Rng {\n    pub fn new(seed: u64) -> Self {\n        Rng(seed)\n    }\n\n    pub fn next_u64(&mut self) -> u64 {\n        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);\n        let mut z = self.0;\n        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);\n        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);\n        z ^ (z >> 31)\n    }\n\n    pub fn next_u32(&mut self) -> u32 {\n        (self.next_u64() >> 32) as u32\n    }\n\n    /// Uniform in `[0, 1)`.\n    pub fn unit(&mut self) -> f32 {\n        (self.next_u32() >> 8) as f32 / (1u32 << 24) as f32\n    }\n\n    /// Uniform in `[-m, m]`.\n    pub fn sym(&mut self, m: f32) -> f32 {\n        (self.unit() * 2.0 - 1.0) * m\n    }\n\n    /// Any bit pattern -- includes NaN, infinities and subnormals.\n    pub fn any_bits_f32(&mut self) -> f32 {\n        f32::from_bits(self.next_u32())\n    }\n\n    /// Random sign, log-uniform magnitude in `[10^lo, 10^hi]`.\n    pub fn log_uniform(&mut self, lo: f32, hi: f32) -> f32 {\n        let e = lo + self.unit() * (hi - lo);\n        let m = 10f32.powf(e);\n        if self.next_u64() & 1 == 0 { m } else { -m }\n    }\n\n    pub fn below(&mut self, n: usize) -> usize {\n        (self.next_u64() % n as u64) as usize\n    }\n}\n\n// ---------------------------------------------------------------------------\n// z-buffer builders\n// ---------------------------------------------------------------------------\n\n/// Indices of `z` that the C code actually reads, in source order.\npub fn read_indices() -> Vec<usize> {\n    let mut v: Vec<usize> = (0..15).map(|i| i * 64).collect();\n    v.extend((0..15).map(|i| 2 + i * 64));\n    v\n}\n\n/// A `z` buffer whose *unread* slots are poisoned with NaN.  Any indexing\n/// mistake in the translation turns into an immediate, loud divergence because\n/// a NaN tap collapses the accumulator to 0 while the C result does not.\npub fn poisoned_z() -> Vec<f32> {\n    vec![f32::NAN; Z_LEN + 64]\n}\n\n/// Fill every read tap using `f`, leaving unread slots poisoned.\npub fn z_from(mut f: impl FnMut(usize) -> f32) -> Vec<f32> {\n    let mut z = poisoned_z();\n    for idx in read_indices() {\n        z[idx] = f(idx);\n    }\n    z\n}\n\n/// All read taps set to `v`.\npub fn z_const(v: f32) -> Vec<f32> {\n    z_from(|_| v)\n}\n\n/// Every tap zero except one, which is set to `v`.\npub fn z_single(index: usize, v: f32) -> Vec<f32> {\n    let mut z = z_from(|_| 0.0);\n    z[index] = v;\n    z\n}\n\n/// The first output tap weights, in source order (index -> coefficient sign is\n/// embedded in the C expression; these are the raw multipliers).\npub const W_LO: [(usize, f32); 8] = [\n    (14 * 64, 29.0),\n    (1 * 64, 213.0),\n    (12 * 64, 459.0),\n    (3 * 64, 2037.0),\n    (10 * 64, 5153.0),\n    (5 * 64, 6574.0),\n    (8 * 64, 37489.0),\n    (7 * 64, 75038.0),\n];\n\n/// The second output tap weights (relative to `z + 2`).\npub const W_HI: [(usize, f32); 8] = [\n    (14 * 64, 104.0),\n    (12 * 64, 1567.0),\n    (10 * 64, 9727.0),\n    (8 * 64, 64019.0),\n    (6 * 64, -9975.0),\n    (4 * 64, -45.0),\n    (2 * 64, 146.0),\n    (0, -5.0),\n];\n","structuredPatch":[],"originalFile":null,"userModified":false}}
