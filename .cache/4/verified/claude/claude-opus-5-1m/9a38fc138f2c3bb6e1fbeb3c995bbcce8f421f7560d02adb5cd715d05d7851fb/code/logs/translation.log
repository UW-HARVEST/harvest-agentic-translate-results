(*F_ff_v)(float, float);\n    typedef c2v (*F_vf_v)(c2v, float);\n    typedef c2v (*F_vv_v)(c2v, c2v);\n    typedef c2v (*F_vvv_v)(c2v, c2v, c2v);\n    typedef c2v (*F_v_v)(c2v);\n    typedef float (*F_vv_f)(c2v, c2v);\n    typedef float (*F_v_f)(c2v);\n    typedef c2r (*F_void_r)(void);\n    typedef c2x (*F_void_x)(void);\n    typedef void (*F_bbverts)(c2v *, c2AABB *);\n    typedef void (*F_makeproxy)(const void *, C2_TYPE, c2Proxy *);\n    typedef float (*F_simp_f)(c2Simplex *);\n    typedef c2v (*F_rv_v)(c2r, c2v);\n    typedef c2v (*F_xv_v)(c2x, c2v);\n    typedef void (*F_simp)(c2Simplex *);\n    typedef c2v (*F_simp_v)(c2Simplex *);\n    typedef int (*F_support)(const c2v *, int, c2v);\n    typedef void (*F_witness)(c2Simplex *, c2v *, c2v *);\n    typedef float (*F_gjk)(const void *, C2_TYPE, const c2x *, const void *, C2_TYPE,\n                           const c2x *, c2v *, c2v *, int, int *, c2GJKCache *);\n    typedef int (*F_aabb2)(c2AABB, c2AABB);\n    typedef int (*F_aabbcap)(c2AABB, c2Capsule);\n    typedef int (*F_cap2)(c2Capsule, c2Capsule);\n    typedef int (*F_cc)(c2Circle, c2Circle);\n    typedef int (*F_caabb)(c2Circle, c2AABB);\n    typedef int (*F_ccap)(c2Circle, c2Capsule);\n    typedef int (*F_collided)(const void *, C2_TYPE, const void *, C2_TYPE);\n    typedef int (*F_capsule)(float, float, float, float, float);\n\n    P2(c2V, F_ff_v); P2(c2Mulvs, F_vf_v); P2(c2Maxv, F_vv_v); P2(c2Minv, F_vv_v);\n    P2(c2Clampv, F_vvv_v); P2(c2Sub, F_vv_v); P2(c2Dot, F_vv_f);\n    P2(c2RotIdentity, F_void_r); P2(c2xIdentity, F_void_x);\n    P2(c2BBVerts, F_bbverts); P2(c2MakeProxy, F_makeproxy);\n    P2(c2Len, F_v_f); P2(c2Det2, F_vv_f); P2(c2GJKSimplexMetric, F_simp_f);\n    P2(c2Mulrv, F_rv_v); P2(c2Add, F_vv_v); P2(c2Mulxv, F_xv_v);\n    P2(c22, F_simp); P2(c23, F_simp);\n    P2(c2Neg, F_v_v); P2(c2Skew, F_v_v); P2(c2CCW90, F_v_v);\n    P2(c2D, F_simp_v); P2(c2Support, F_support); P2(c2Witness, F_witness);\n    P2(c2Div, F_vf_v); P2(c2Norm, F_v_v); P2(c2L, F_simp_v); P2(c2MulrvT, F_rv_v);\n    P2(c2GJK, F_gjk);\n    P2(c2AABBtoAABB, F_aabb2); P2(c2AABBtoCapsule, F_aabbcap);\n    P2(c2CapsuletoCapsule, F_cap2); P2(c2CircletoCircle, F_cc);\n    P2(c2CircletoAABB, F_caabb); P2(c2CircletoCapsule, F_ccap);\n    P2(c2Collided, F_collided); P2(capsule, F_capsule);\n\n    /* scalar / vector math */\n    for (int t = 0; t < 60000; ++t) {\n        float f1 = rfw(), f2 = rfw();\n        c2v a = rv(), b = rv(), c = rv();\n        c2r rot = rr();\n        c2x xf = rx();\n        c2v o1, o2;\n        o1 = c2V_c(f1, f2); o2 = c2V_r(f1, f2); cmp(\"c2V\", &o1, &o2, sizeof o1);\n        o1 = c2Mulvs_c(a, f1); o2 = c2Mulvs_r(a, f1); cmp(\"c2Mulvs\", &o1, &o2, sizeof o1);\n        o1 = c2Maxv_c(a, b); o2 = c2Maxv_r(a, b); cmp(\"c2Maxv\", &o1, &o2, sizeof o1);\n        o1 = c2Minv_c(a, b); o2 = c2Minv_r(a, b); cmp(\"c2Minv\", &o1, &o2, sizeof o1);\n        o1 = c2Clampv_c(a, b, c); o2 = c2Clampv_r(a, b, c); cmp(\"c2Clampv\", &o1, &o2, sizeof o1);\n        o1 = c2Sub_c(a, b); o2 = c2Sub_r(a, b); cmp(\"c2Sub\", &o1, &o2, sizeof o1);\n        o1 = c2Add_c(a, b); o2 = c2Add_r(a, b); cmp(\"c2Add\", &o1, &o2, sizeof o1);\n        o1 = c2Neg_c(a); o2 = c2Neg_r(a); cmp(\"c2Neg\", &o1, &o2, sizeof o1);\n        o1 = c2Skew_c(a); o2 = c2Skew_r(a); cmp(\"c2Skew\", &o1, &o2, sizeof o1);\n        o1 = c2CCW90_c(a); o2 = c2CCW90_r(a); cmp(\"c2CCW90\", &o1, &o2, sizeof o1);\n        o1 = c2Div_c(a, f1); o2 = c2Div_r(a, f1); cmp(\"c2Div\", &o1, &o2, sizeof o1);\n        o1 = c2Norm_c(a); o2 = c2Norm_r(a); cmp(\"c2Norm\", &o1, &o2, sizeof o1);\n        o1 = c2Mulrv_c(rot, a); o2 = c2Mulrv_r(rot, a); cmp(\"c2Mulrv\", &o1, &o2, sizeof o1);\n        o1 = c2MulrvT_c(rot, a); o2 = c2MulrvT_r(rot, a); cmp(\"c2MulrvT\", &o1, &o2, sizeof o1);\n        o1 = c2Mulxv_c(xf, a); o2 = c2Mulxv_r(xf, a); cmp(\"c2Mulxv\", &o1, &o2, sizeof o1);\n        float g1, g2;\n        g1 = c2Dot_c(a, b); g2 = c2Dot_r(a, b); cmp(\"c2Dot\", &g1, &g2, sizeof g1);\n        g1 = c2Len_c(a); g2 = c2Len_r(a); cmp(\"c2Len\", &g1, &g2, sizeof g1);\n        g1 = c2Det2_c(a, b); g2 = c2Det2_r(a, b); cmp(\"c2Det2\", &g1, &g2, sizeof g1);\n        c2r r1 = c2RotIdentity_c(), r2 = c2RotIdentity_r();\n        cmp(\"c2RotIdentity\", &r1, &r2, sizeof r1);\n        c2x x1 = c2xIdentity_c(), x2 = c2xIdentity_r();\n        cmp(\"c2xIdentity\", &x1, &x2, sizeof x1);\n    }\n\n    /* c2BBVerts / c2MakeProxy */\n    for (int t = 0; t < 20000; ++t) {\n        c2AABB bb = rab();\n        c2v v1[4], v2[4];\n        memset(v1, 0xAB, sizeof v1); memset(v2, 0xAB, sizeof v2);\n        c2BBVerts_c(v1, &bb); c2BBVerts_r(v2, &bb);\n        cmp(\"c2BBVerts\", v1, v2, sizeof v1);\n\n        c2Proxy p1, p2;\n        memset(&p1, 0, sizeof p1); memset(&p2, 0, sizeof p2);\n        int which = rnd() % 4;\n        c2Circle ci = rc(); c2Capsule cp = rcap();\n        const void *shape = which == 0 ? (const void *)&ci : which == 1 ? (const void *)&bb\n                          : (const void *)&cp;\n        C2_TYPE ty = (C2_TYPE)which; /* 3 == out of range */\n        c2MakeProxy_c(shape, ty, &p1); c2MakeProxy_r(shape, ty, &p2);\n        cmp(\"c2MakeProxy\", &p1, &p2, sizeof p1);\n    }\n\n    /* c2Support */\n    for (int t = 0; t < 20000; ++t) {\n        c2v verts[8];\n        for (int i = 0; i < 8; ++i) verts[i] = rv();\n        int count = 1 + (int)(rnd() % 8);\n        c2v d = rv();\n        int i1 = c2Support_c(verts, count, d), i2 = c2Support_r(verts, count, d);\n        cmp(\"c2Support\", &i1, &i2, sizeof i1);\n    }\n\n    /* simplex funcs */\n    for (int t = 0; t < 40000; ++t) {\n        int count = 1 + (int)(rnd() % 3);\n        c2Simplex base = rsimp(count);\n        c2Simplex s1 = base, s2 = base;\n        float m1 = c2GJKSimplexMetric_c(&s1), m2 = c2GJKSimplexMetric_r(&s2);\n        cmp(\"c2GJKSimplexMetric\", &m1, &m2, sizeof m1);\n        cmp(\"c2GJKSimplexMetric/state\", &s1, &s2, sizeof s1);\n\n        s1 = base; s2 = base;\n        c2v d1 = c2D_c(&s1), d2 = c2D_