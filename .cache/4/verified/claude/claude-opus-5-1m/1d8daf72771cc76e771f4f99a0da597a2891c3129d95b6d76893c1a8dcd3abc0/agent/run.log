{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_3mgx3pifyxa63jqzx4a4eu4nr4bmqwjdcadgf2lrrlzarkkb2iua","type":"message","role":"assistant","content":[{"type":"text","text":"The release-profile run exposed that my `/proc`-based AS budgeting is heap-state dependent (the probes correctly reported \"inconclusive\" rather than falsely passing). Let me replace it with a robust, self-validating ballast design:"}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":939,"cache_read_input_tokens":97270,"cache_creation":{"ephemeral_5m_input_tokens":939,"ephemeral_1h_input_tokens":0},"output_tokens":7,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"c199c1a9-b8ce-4fd8-b611-969766e92ee3","uuid":"ce28e18b-3c68-452c-bc92-941739a6fbdb","timestamp":"2026-08-20T08:08:51.395Z"}
{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_3mgx3pifyxa63jqzx4a4eu4nr4bmqwjdcadgf2lrrlzarkkb2iua","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_015w4RSo3ZHPG3gmbi8k1Krn","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-0mm2yS/translated_rust/tests/alloc_failure.rs","content":"//! Phase C — the allocation-failure rejection branches of the C\n//! (`ERRORS.md` rows 3, 3b and 4).\n//!\n//! * row 3  — `calloc` fails                        -> `return NULL`\n//! * row 3b — `int l = strlen(src) + 1` overflows, so `l + 13` converts to a\n//!            huge `size_t` and `calloc` fails       -> `return NULL`\n//! * row 4  — `calloc` succeeds but `malloc` fails   -> `free(dest); return NULL`\n//!\n//! Rows 3 and 4 are reproduced inside a forked child (so the parent's heap is\n//! never disturbed and every attempt starts from an identical heap image):\n//!\n//!   1. `RLIMIT_AS` is lowered to `vsize + n * cap`, i.e. only `n` more\n//!      destination-sized mappings may ever be created;\n//!   2. a *ballast* loop then allocates `cap`-sized blocks until allocation\n//!      fails, which consumes both that budget and any pre-existing free chunk\n//!      big enough to serve the library's request (`RLIMIT_AS` alone cannot\n//!      prevent reuse of an existing hole — this is what makes a naive\n//!      \"just set a small limit\" test unreliable);\n//!   3. for row 4 exactly one ballast block is released, so precisely one\n//!      destination-sized allocation can still be served and the following\n//!      `malloc(l)` cannot;\n//!   4. **probe allocations then prove which allocation the budget makes fail**\n//!      before `decode_base64` is called at all. If the window is not the\n//!      intended one the child reports \"inconclusive\" and the parent retries\n//!      another strategy instead of silently passing.\n//!\n//! `cap` is 64 MiB + 14, i.e. always above glibc's maximum mmap threshold\n//! (32 MiB), so every block involved is served by its own `mmap` and the\n//! address-space accounting is exact.\n\nmod common;\n\nuse common::{diff_null, DecodeFn};\nuse std::ffi::{c_char, c_int, c_void};\n\nconst RLIMIT_AS: c_int = 9; // Linux\nconst WNOHANG: c_int = 1;\n\n#[repr(C)]\nstruct RLimit {\n    cur: u64,\n    max: u64,\n}\n\nunsafe extern \"C\" {\n    fn fork() -> i32;\n    fn waitpid(pid: i32, status: *mut c_int, options: c_int) -> i32;\n    fn kill(pid: i32, sig: c_int) -> c_int;\n    fn getrlimit(resource: c_int, rlim: *mut RLimit) -> c_int;\n    fn setrlimit(resource: c_int, rlim: *const RLimit) -> c_int;\n    fn _exit(code: c_int) -> !;\n    fn calloc(n: usize, sz: usize) -> *mut c_void;\n    fn malloc(sz: usize) -> *mut c_void;\n    fn free(p: *mut c_void);\n}\n\nfn vsize_bytes() -> u64 {\n    let s = std::fs::read_to_string(\"/proc/self/statm\").expect(\"read statm\");\n    let pages: u64 = s\n        .split_whitespace()\n        .next()\n        .unwrap()\n        .parse()\n        .expect(\"parse statm\");\n    pages * 4096\n}\n\nfn mem_available_bytes() -> u64 {\n    let s = std::fs::read_to_string(\"/proc/meminfo\").unwrap_or_default();\n    for line in s.lines() {\n        if let Some(rest) = line.strip_prefix(\"MemAvailable:\") {\n            if let Some(kb) = rest.split_whitespace().next() {\n                if let Ok(v) = kb.parse::<u64>() {\n                    return v * 1024;\n                }\n            }\n        }\n    }\n    0\n}\n\n/// Which allocation inside `decode_base64` the budget must starve.\n#[derive(Copy, Clone, PartialEq, Debug)]\nenum Expect {\n    /// `calloc(1, l + 13)` itself fails (row 3)\n    CallocFails,\n    /// `calloc` succeeds, the following `malloc(l)` fails (row 4)\n    MallocFails,\n}\n\n// child exit codes\nconst OK: c_int = 0;\nconst BOTH_SUCCEEDED: c_int = 10;\nconst RUST_NOT_NULL: c_int = 11;\nconst RUST_NULL_ONLY: c_int = 12;\nconst SETRLIMIT_FAILED: c_int = 20;\nconst PROBE_CALLOC_FAILED: c_int = 21;\nconst PROBE_MALLOC_SUCCEEDED: c_int = 22;\nconst PROBE_CALLOC_SUCCEEDED: c_int = 23;\nconst NO_BALLAST: c_int = 24;\n\n/// A ballast strategy: address-space budget in multiples of `cap`, plus which\n/// ballast block to release (row 4 only).\n#[derive(Copy, Clone, Debug)]\nstruct Strategy {\n    caps: u64,\n    free_which: u8, // 0 = middle, 1 = first, 2 = last\n}\n\n/// Runs one attempt in a forked child; returns the child's exit code.\n#[allow(clippy::too_many_arguments)]\nfn run_child(\n    f_c: DecodeFn,\n    f_r: DecodeFn,\n    src: *const c_char,\n    cap: usize,\n    l: usize,\n    vsize: u64,\n    expect: Expect,\n    st: Strategy,\n) -> i32 {\n    let pid = unsafe { fork() };\n    assert!(pid >= 0, \"fork() failed\");\n    if pid == 0 {\n        // ------- child: raw libc only, no Rust allocation, no panicking -------\n        unsafe {\n            let mut orig = RLimit { cur: 0, max: 0 };\n            if getrlimit(RLIMIT_AS, &mut orig) != 0 {\n                _exit(SETRLIMIT_FAILED);\n            }\n            let rl = RLimit {\n                cur: vsize + st.caps * cap as u64,\n                max: orig.max, // keep the hard limit, only squeeze the soft one\n            };\n            if setrlimit(RLIMIT_AS, &rl) != 0 {\n                _exit(SETRLIMIT_FAILED);\n            }\n\n            // ---- ballast: consume the budget *and* every reusable hole ----\n            // The list is threaded through the blocks themselves, so no\n            // additional allocation is needed to track it.\n            let mut head: *mut c_void = std::ptr::null_mut();\n            let mut count: usize = 0;\n            loop {\n                let p = malloc(cap);\n                if p.is_null() {\n                    break;\n                }\n                *(p as *mut *mut c_void) = head;\n                head = p;\n                count += 1;\n                if count > 4096 {\n                    break; // safety valve\n                }\n            }\n\n            if expect == Expect::MallocFails {\n                if count == 0 {\n                    _exit(NO_BALLAST);\n                }\n                // pick the block to release\n                let idx = match st.free_which {\n                    1 => 0,\n                    2 => count - 1,\n                    _ => count / 2,\n                };\n                let mut prev: *mut c_void = std::ptr::null_mut();\n                let mut cur = head;\n                let mut i = 0usize;\n                while i < idx {\n                    prev = cur;\n                    cur = *(cur as *mut *mut c_void);\n                    i += 1;\n                }\n                let next = *(cur as *mut *mut c_void);\n                if prev.is_null() {\n                    head = next;\n                } else {\n                    *(prev as *mut *mut c_void) = next;\n                }\n                free(cur);\n            }\n\n            // ---- probes: prove the intended allocation is the failing one ----\n            let p1 = calloc(1, cap);\n            match expect {\n                Expect::CallocFails => {\n                    if !p1.is_null() {\n                        free(p1);\n                        _exit(PROBE_CALLOC_SUCCEEDED);\n                    }\n                }\n                Expect::MallocFails => {\n                    if p1.is_null() {\n                        _exit(PROBE_CALLOC_FAILED);\n                    }\n                    let p2 = malloc(l);\n                    if !p2.is_null() {\n                        free(p2);\n                        free(p1);\n                        _exit(PROBE_MALLOC_SUCCEEDED);\n                    }\n                    free(p1);\n                }\n            }\n\n            // ---------------- the actual differential call ----------------\n            let a = f_c(src);\n            let b = f_r(src);\n            let an = a.is_null();\n            let bn = b.is_null();\n            if !an {\n                free(a as *mut c_void);\n            }\n            if !bn {\n                free(b as *mut c_void);\n            }\n            let _ = head; // ballast is released by process exit\n            match (an, bn) {\n                (true, true) => _exit(OK),\n                (true, false) => _exit(RUST_NOT_NULL),\n                (false, true) => _exit(RUST_NULL_ONLY),\n                (false, false) => _exit(BOTH_SUCCEEDED),\n            }\n        }\n    }\n    // ------------------------------- parent -------------------------------\n    let mut status: c_int = 0;\n    let deadline = std::time::Instant::now() + std::time::Duration::from_secs(60);\n    loop {\n        let r = unsafe { waitpid(pid, &mut status, WNOHANG) };\n        if r == pid {\n            break;\n        }\n        assert!(r == 0, \"waitpid failed: {r}\");\n        if std::time::Instant::now() > deadline {\n            unsafe { kill(pid, 9) };\n            let _ = unsafe { waitpid(pid, &mut status, 0) };\n            panic!(\"child hung for 60s under RLIMIT_AS\");\n        }\n        std::thread::sleep(std::time::Duration::from_millis(20));\n    }\n    assert!(\n        status & 0x7f == 0,\n        \"child was killed by signal {} (status 0x{status:x}) — a crash under \\\n         allocation failure is itself a divergence from the C\",\n        status & 0x7f\n    );\n    (status >> 8) & 0xff\n}\n\n/// `true` if the attempt verified the row, `false` if it was inconclusive.\nfn interpret(code: i32, what: &str) -> bool {\n    match code {\n        OK => true,\n        RUST_NOT_NULL => {\n            panic!(\"{what}: DIVERGENCE — C returned NULL, Rust returned a non-NULL pointer\")\n        }\n        RUST_NULL_ONLY => {\n            panic!(\"{what}: DIVERGENCE — C returned a non-NULL pointer, Rust returned NULL\")\n        }\n        BOTH_SUCCEEDED | PROBE_CALLOC_FAILED | PROBE_MALLOC_SUCCEEDED | PROBE_CALLOC_SUCCEEDED\n        | NO_BALLAST => false,\n        SETRLIMIT_FAILED => panic!(\"{what}: getrlimit/setrlimit(RLIMIT_AS) failed in the child\"),\n        other => panic!(\"{what}: unexpected child exit code {other}\"),\n    }\n}\n\nfn verify_row(label: &str, input: &[u8], expect: Expect) {\n    let a = common::api();\n    let src = input.as_ptr() as *const c_char;\n    let l = input.len(); // == strlen(src) + 1\n    let cap = l + 13; // == calloc(1, l + 13)\n    let mut last = -1;\n    for caps in [4u64, 2, 1, 8, 16] {\n        for free_which in [0u8, 1, 2] {\n            let st = Strategy { caps, free_which };\n            let vsize = vsize_bytes();\n            let code = run_child(a.c, a.rust, src, cap, l, vsize, expect, st);\n            last = code;\n            if interpret(code, label) {\n                eprintln!(\"{label}: VERIFIED (strategy {st:?}, {expect:?})\");\n                return;\n            }\n            eprintln!(\"{label}: inconclusive (child code {code}, strategy {st:?}), retrying\");\n            if expect == Expect::CallocFails {\n                break; // free_which is irrelevant for this row\n            }\n        }\n    }\n    panic!(\n        \"{label}: could not create the required allocation window \\\n         (last child exit code {last}); the branch was NOT verified\"\n    );\n}\n\n/// 64 MiB of valid base64 — `cap` is then always above glibc's maximum mmap\n/// threshold, so every allocation involved gets its own mapping.\nfn big_input() -> Vec<u8> {\n    let n = 64 * 1024 * 1024usize;\n    assert!(\n        mem_available_bytes() > 512 * 1024 * 1024,\n        \"not enough free memory for the allocation-failure tests\"\n    );\n    let mut v = vec![b'A'; n];\n    v.push(0);\n    v\n}\n\n/// ERRORS.md row 3 — `calloc(sizeof(char), l + 13)` returns NULL -> `return NULL`.\n#[test]\nfn e3_calloc_fails_under_rlimit() {\n    let input = big_input();\n    verify_row(\n        \"ERRORS row 3 (calloc fails)\",\n        &input,\n        Expect::CallocFails,\n    );\n}\n\n/// ERRORS.md row 4 — `calloc` succeeds, `malloc(l)` returns NULL, so the C\n/// frees `dest` and returns NULL.\n#[test]\nfn e4_malloc_fails_after_calloc_succeeds() {\n    let input = big_input();\n    verify_row(\n        \"ERRORS row 4 (malloc fails after calloc)\",\n        &input,\n        Expect::MallocFails,\n    );\n}\n\n/// ERRORS.md row 3b — `int l = strlen(src) + 1` overflows `int`, so `l + 13`\n/// converts to a huge `size_t` and `calloc` fails. Two lengths:\n///   * `strlen == INT_MAX`      -> `l` wraps to `INT_MIN`\n///   * `strlen == INT_MAX - 12` -> `l + 13` overflows to `INT_MIN + 1`\n#[test]\nfn e3b_int_overflow_makes_calloc_fail() {\n    let int_max = i32::MAX as usize; // 2147483647\n    let need = int_max as u64 + 4096;\n    assert!(\n        mem_available_bytes() >= need + (1 << 30),\n        \"not enough free memory ({} MiB available) for the 2 GiB oversized-input test\",\n        mem_available_bytes() >> 20\n    );\n    // One 2 GiB buffer reused for both lengths (the NUL is moved around).\n    let mut buf = vec![b'A'; int_max + 1];\n    for (name, len) in [\n        (\"strlen == INT_MAX\", int_max),\n        (\"strlen == INT_MAX - 12\", int_max - 12),\n    ] {\n        buf[len] = 0;\n        let label = format!(\"ERRORS row 3b ({name})\");\n        diff_null(buf.as_ptr() as *const c_char, &label);\n        buf[len] = b'A';\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":939,"cache_read_input_tokens":97270,"cache_creation":{"ephemeral_5m_input_tokens":939,"ephemeral_1h_input_tokens":0},"output_tokens":7,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"c199c1a9-b8ce-4fd8-b611-969766e92ee3","uuid":"9602b7fc-b81d-48ea-a085-d51e51b2d0eb","timestamp":"2026-08-20T08:09:38.954Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_015w4RSo3ZHPG3gmbi8k1Krn","type":"tool_result","content":"The file /local/home/scheschb/.harvest/work/harvest-work-0mm2yS/translated_rust/tests/alloc_failure.rs has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"c199c1a9-b8ce-4fd8-b611-969766e92ee3","uuid":"c983d340-37e2-46cf-abcc-503ec4eeb5a2","timestamp":"2026-08-20T08:09:38.979Z","tool_use_result":{"type":"update","filePath":"/local/home/scheschb/.harvest/work/harvest-work-0mm2yS/translated_rust/tests/alloc_failure.rs","content":"//! Phase C — the allocation-failure rejection branches of the C\n//! (`ERRORS.md` rows 3, 3b and 4).\n//!\n//! * row 3  — `calloc` fails                        -> `return NULL`\n//! * row 3b — `int l = strlen(src) + 1` overflows, so `l + 13` converts to a\n//!            huge `size_t` and `calloc` fails       -> `return NULL`\n//! * row 4  — `calloc` succeeds but `malloc` fails   -> `free(dest); return NULL`\n//!\n//! Rows 3 and 4 are reproduced inside a forked child (so the parent's heap is\n//! never disturbed and every attempt starts from an identical heap image):\n//!\n//!   1. `RLIMIT_AS` is lowered to `vsize + n * cap`, i.e. only `n` more\n//!      destination-sized mappings may ever be created;\n//!   2. a *ballast* loop then allocates `cap`-sized blocks until allocation\n//!      fails, which consumes both that budget and any pre-existing free chunk\n//!      big enough to serve the library's request (`RLIMIT_AS` alone cannot\n//!      prevent reuse of an existing hole — this is what makes a naive\n//!      \"just set a small limit\" test unreliable);\n//!   3. for row 4 exactly one ballast block is released, so precisely one\n//!      destination-sized allocation can still be served and the following\n//!      `malloc(l)` cannot;\n//!   4. **probe allocations then prove which allocation the budget makes fail**\n//!      before `decode_base64` is called at all. If the window is not the\n//!      intended one the child reports \"inconclusive\" and the parent retries\n//!      another strategy instead of silently passing.\n//!\n//! `cap` is 64 MiB + 14, i.e. always above glibc's maximum mmap threshold\n//! (32 MiB), so every block involved is served by its own `mmap` and the\n//! address-space accounting is exact.\n\nmod common;\n\nuse common::{diff_null, DecodeFn};\nuse std::ffi::{c_char, c_int, c_void};\n\nconst RLIMIT_AS: c_int = 9; // Linux\nconst WNOHANG: c_int = 1;\n\n#[repr(C)]\nstruct RLimit {\n    cur: u64,\n    max: u64,\n}\n\nunsafe extern \"C\" {\n    fn fork() -> i32;\n    fn waitpid(pid: i32, status: *mut c_int, options: c_int) -> i32;\n    fn kill(pid: i32, sig: c_int) -> c_int;\n    fn getrlimit(resource: c_int, rlim: *mut RLimit) -> c_int;\n    fn setrlimit(resource: c_int, rlim: *const RLimit) -> c_int;\n    fn _exit(code: c_int) -> !;\n    fn calloc(n: usize, sz: usize) -> *mut c_void;\n    fn malloc(sz: usize) -> *mut c_void;\n    fn free(p: *mut c_void);\n}\n\nfn vsize_bytes() -> u64 {\n    let s = std::fs::read_to_string(\"/proc/self/statm\").expect(\"read statm\");\n    let pages: u64 = s\n        .split_whitespace()\n        .next()\n        .unwrap()\n        .parse()\n        .expect(\"parse statm\");\n    pages * 4096\n}\n\nfn mem_available_bytes() -> u64 {\n    let s = std::fs::read_to_string(\"/proc/meminfo\").unwrap_or_default();\n    for line in s.lines() {\n        if let Some(rest) = line.strip_prefix(\"MemAvailable:\") {\n            if let Some(kb) = rest.split_whitespace().next() {\n                if let Ok(v) = kb.parse::<u64>() {\n                    return v * 1024;\n                }\n            }\n        }\n    }\n    0\n}\n\n/// Which allocation inside `decode_base64` the budget must starve.\n#[derive(Copy, Clone, PartialEq, Debug)]\nenum Expect {\n    /// `calloc(1, l + 13)` itself fails (row 3)\n    CallocFails,\n    /// `calloc` succeeds, the following `malloc(l)` fails (row 4)\n    MallocFails,\n}\n\n// child exit codes\nconst OK: c_int = 0;\nconst BOTH_SUCCEEDED: c_int = 10;\nconst RUST_NOT_NULL: c_int = 11;\nconst RUST_NULL_ONLY: c_int = 12;\nconst SETRLIMIT_FAILED: c_int = 20;\nconst PROBE_CALLOC_FAILED: c_int = 21;\nconst PROBE_MALLOC_SUCCEEDED: c_int = 22;\nconst PROBE_CALLOC_SUCCEEDED: c_int = 23;\nconst NO_BALLAST: c_int = 24;\n\n/// A ballast strategy: address-space budget in multiples of `cap`, plus which\n/// ballast block to release (row 4 only).\n#[derive(Copy, Clone, Debug)]\nstruct Strategy {\n    caps: u64,\n    free_which: u8, // 0 = middle, 1 = first, 2 = last\n}\n\n/// Runs one attempt in a forked child; returns the child's exit code.\n#[allow(clippy::too_many_arguments)]\nfn run_child(\n    f_c: DecodeFn,\n    f_r: DecodeFn,\n    src: *const c_char,\n    cap: usize,\n    l: usize,\n    vsize: u64,\n    expect: Expect,\n    st: Strategy,\n) -> i32 {\n    let pid = unsafe { fork() };\n    assert!(pid >= 0, \"fork() failed\");\n    if pid == 0 {\n        // ------- child: raw libc only, no Rust allocation, no panicking -------\n        unsafe {\n            let mut orig = RLimit { cur: 0, max: 0 };\n            if getrlimit(RLIMIT_AS, &mut orig) != 0 {\n                _exit(SETRLIMIT_FAILED);\n            }\n            let rl = RLimit {\n                cur: vsize + st.caps * cap as u64,\n                max: orig.max, // keep the hard limit, only squeeze the soft one\n            };\n            if setrlimit(RLIMIT_AS, &rl) != 0 {\n                _exit(SETRLIMIT_FAILED);\n            }\n\n            // ---- ballast: consume the budget *and* every reusable hole ----\n            // The list is threaded through the blocks themselves, so no\n            // additional allocation is needed to track it.\n            let mut head: *mut c_void = std::ptr::null_mut();\n            let mut count: usize = 0;\n            loop {\n                let p = malloc(cap);\n                if p.is_null() {\n                    break;\n                }\n                *(p as *mut *mut c_void) = head;\n                head = p;\n                count += 1;\n                if count > 4096 {\n                    break; // safety valve\n                }\n            }\n\n            if expect == Expect::MallocFails {\n                if count == 0 {\n                    _exit(NO_BALLAST);\n                }\n                // pick the block to release\n                let idx = match st.free_which {\n                    1 => 0,\n                    2 => count - 1,\n                    _ => count / 2,\n                };\n                let mut prev: *mut c_void = std::ptr::null_mut();\n                let mut cur = head;\n                let mut i = 0usize;\n                while i < idx {\n                    prev = cur;\n                    cur = *(cur as *mut *mut c_void);\n                    i += 1;\n                }\n                let next = *(cur as *mut *mut c_void);\n                if prev.is_null() {\n                    head = next;\n                } else {\n                    *(prev as *mut *mut c_void) = next;\n                }\n                free(cur);\n            }\n\n            // ---- probes: prove the intended allocation is the failing one ----\n            let p1 = calloc(1, cap);\n            match expect {\n                Expect::CallocFails => {\n                    if !p1.is_null() {\n                        free(p1);\n                        _exit(PROBE_CALLOC_SUCCEEDED);\n                    }\n                }\n                Expect::MallocFails => {\n                    if p1.is_null() {\n                        _exit(PROBE_CALLOC_FAILED);\n                    }\n                    let p2 = malloc(l);\n                    if !p2.is_null() {\n                        free(p2);\n                        free(p1);\n                        _exit(PROBE_MALLOC_SUCCEEDED);\n                    }\n                    free(p1);\n                }\n            }\n\n            // ---------------- the actual differential call ----------------\n            let a = f_c(src);\n            let b = f_r(src);\n            let an = a.is_null();\n            let bn = b.is_null();\n            if !an {\n                free(a as *mut c_void);\n            }\n            if !bn {\n                free(b as *mut c_void);\n            }\n            let _ = head; // ballast is released by process exit\n            match (an, bn) {\n                (true, true) => _exit(OK),\n                (true, false) => _exit(RUST_NOT_NULL),\n                (false, true) => _exit(RUST_NULL_ONLY),\n                (false, false) => _exit(BOTH_SUCCEEDED),\n            }\n        }\n    }\n    // ------------------------------- parent -------------------------------\n    let mut status: c_int = 0;\n    let deadline = std::time::Instant::now() + std::time::Duration::from_secs(60);\n    loop {\n        let r = unsafe { waitpid(pid, &mut status, WNOHANG) };\n        if r == pid {\n            break;\n        }\n        assert!(r == 0, \"waitpid failed: {r}\");\n        if std::time::Instant::now() > deadline {\n            unsafe { kill(pid, 9) };\n            let _ = unsafe { waitpid(pid, &mut status, 0) };\n            panic!(\"child hung for 60s under RLIMIT_AS\");\n        }\n        std::thread::sleep(std::time::Duration::from_millis(20));\n    }\n    assert!(\n        status & 0x7f == 0,\n        \"child was killed by signal {} (status 0x{status:x}) — a crash under \\\n         allocation failure is itself a divergence from the C\",\n        status & 0x7f\n    );\n    (status >> 8) & 0xff\n}\n\n/// `true` if the attempt verified the row, `false` if it was inconclusive.\nfn interpret(code: i32, what: &str) -> bool {\n    match code {\n        OK => true,\n        RUST_NOT_NULL => {\n            panic!(\"{what}: DIVERGENCE — C returned NULL, Rust returned a non-NULL pointer\")\n        }\n        RUST_NULL_ONLY => {\n            panic!(\"{what}: DIVERGENCE — C returned a non-NULL pointer, Rust returned NULL\")\n        }\n        BOTH_SUCCEEDED | PROBE_CALLOC_FAILED | PROBE_MALLOC_SUCCEEDED | PROBE_CALLOC_SUCCEEDED\n        | NO_BALLAST => false,\n        SETRLIMIT_FAILED => panic!(\"{what}: getrlimit/setrlimit(RLIMIT_AS) failed in the child\"),\n        other => panic!(\"{what}: unexpected child exit code {other}\"),\n    }\n}\n\nfn verify_row(label: &str, input: &[u8], expect: Expect) {\n    let a = common::api();\n    let src = input.as_ptr() as *const c_char;\n    let l = input.len(); // == strlen(src) + 1\n    let cap = l + 13; // == calloc(1, l + 13)\n    let mut last = -1;\n    for caps in [4u64, 2, 1, 8, 16] {\n        for free_which in [0u8, 1, 2] {\n            let st = Strategy { caps, free_which };\n            let vsize = vsize_bytes();\n            let code = run_child(a.c, a.rust, src, cap, l, vsize, expect, st);\n            last = code;\n            if interpret(code, label) {\n                eprintln!(\"{label}: VERIFIED (strategy {st:?}, {expect:?})\");\n                return;\n            }\n            eprintln!(\"{label}: inconclusive (child code {code}, strategy {st:?}), retrying\");\n            if expect == Expect::CallocFails {\n                break; // free_which is irrelevant for this row\n            }\n        }\n    }\n    panic!(\n        \"{label}: could not create the required allocation window \\\n         (last child exit code {last}); the branch was NOT verified\"\n    );\n}\n\n/// 64 MiB of valid base64 — `cap` is then always above glibc's maximum mmap\n/// threshold, so every allocation involved gets its own mapping.\nfn big_input() -> Vec<u8> {\n    let n = 64 * 1024 * 1024usize;\n    assert!(\n        mem_available_bytes() > 512 * 1024 * 1024,\n        \"not enough free memory for the allocation-failure tests\"\n    );\n    let mut v = vec![b'A'; n];\n    v.push(0);\n    v\n}\n\n/// ERRORS.md row 3 — `calloc(sizeof(char), l + 13)` returns NULL -> `return NULL`.\n#[test]\nfn e3_calloc_fails_under_rlimit() {\n    let input = big_input();\n    verify_row(\n        \"ERRORS row 3 (calloc fails)\",\n        &input,\n        Expect::CallocFails,\n    );\n}\n\n/// ERRORS.md row 4 — `calloc` succeeds, `malloc(l)` returns NULL, so the C\n/// frees `dest` and returns NULL.\n#[test]\nfn e4_malloc_fails_after_calloc_succeeds() {\n    let input = big_input();\n    verify_row(\n        \"ERRORS row 4 (malloc fails after calloc)\",\n        &input,\n        Expect::MallocFails,\n    );\n}\n\n/// ERRORS.md row 3b — `int l = strlen(src) + 1` overflows `int`, so `l + 13`\n/// converts to a huge `size_t` and `calloc` fails. Two lengths:\n///   * `strlen == INT_MAX`      -> `l` wraps to `INT_MIN`\n///   * `strlen == INT_MAX - 12` -> `l + 13` overflows to `INT_MIN + 1`\n#[test]\nfn e3b_int_overflow_makes_calloc_fail() {\n    let int_max = i32::MAX as usize; // 2147483647\n    let need = int_max as u64 + 4096;\n    assert!(\n        mem_available_bytes() >= need + (1 << 30),\n        \"not enough free memory ({} MiB available) for the 2 GiB oversized-input test\",\n        mem_available_bytes() >> 20\n    );\n    // One 2 GiB buffer reused for both lengths (the NUL is moved around).\n    let mut buf = vec![b'A'; int_max + 1];\n    for (name, len) in [\n        (\"strlen == INT_MAX\", int_max),\n        (\"strlen == INT_MAX - 12\", int_max - 12),\n    ] {\n        buf[len] = 0;\n        let label = format!(\"ERRORS row 3b ({name})\");\n        diff_null(buf.as_ptr() as *const c_char, &label);\n        buf[len] = b'A';\n    }\n}\n","structuredPatch":[{"oldStart":1,"oldLines":14,"newStart":1,"newLines":32,"lines":["-//! Phase C — the two allocation-failure rejection branches of the C","+//! Phase C — the allocation-failure rejection branches of the C"," //! (`ERRORS.md` rows 3, 3b and 4)."," //!","-//! * row 3  — `calloc` fails  -> `return NULL`","-//! * row 3b — `int l = strlen(src)+1` overflows, so `l + 13` converts to a huge","-//!            `size_t` and `calloc` fails  -> `return NULL`","-//! * row 4  — `calloc` succeeds but `malloc` fails -> `free(dest); return NULL`","+//! * row 3  — `calloc` fails                        -> `return NULL`","+//! * row 3b — `int l = strlen(src) + 1` overflows, so `l + 13` converts to a","+//!            huge `size_t` and `calloc` fails       -> `return NULL`","+//! * row 4  — `calloc` succeeds but `malloc` fails   -> `free(dest); return NULL`"," //!","-//! Rows 3 and 4 are reproduced by constraining `RLIMIT_AS` inside a forked","-//! child, with probe allocations proving *which* of the two allocations the","-//! budget makes fail before the library is called.","+//! Rows 3 and 4 are reproduced inside a forked child (so the parent's heap is","+//! never disturbed and every attempt starts from an identical heap image):","+//!","+//!   1. `RLIMIT_AS` is lowered to `vsize + n * cap`, i.e. only `n` more","+//!      destination-sized mappings may ever be created;","+//!   2. a *ballast* loop then allocates `cap`-sized blocks until allocation","+//!      fails, which consumes both that budget and any pre-existing free chunk","+//!      big enough to serve the library's request (`RLIMIT_AS` alone cannot","+//!      prevent reuse of an existing hole — this is what makes a naive","+//!      \"just set a small limit\" test unreliable);","+//!   3. for row 4 exactly one ballast block is released, so precisely one","+//!      destination-sized allocation can still be served and the following","+//!      `malloc(l)` cannot;","+//!   4. **probe allocations then prove which allocation the budget makes fail**","+//!      before `decode_base64` is called at all. If the window is not the","+//!      intended one the child reports \"inconclusive\" and the parent retries","+//!      another strategy instead of silently passing.","+//!","+//! `cap` is 64 MiB + 14, i.e. always above glibc's maximum mmap threshold","+//! (32 MiB), so every block involved is served by its own `mmap` and the","+//! address-space accounting is exact."," "," mod common;"," "]},{"oldStart":28,"oldLines":6,"newStart":46,"newLines":7,"lines":["     fn fork() -> i32;","     fn waitpid(pid: i32, status: *mut c_int, options: c_int) -> i32;","     fn kill(pid: i32, sig: c_int) -> c_int;","+    fn getrlimit(resource: c_int, rlim: *mut RLimit) -> c_int;","     fn setrlimit(resource: c_int, rlim: *const RLimit) -> c_int;","     fn _exit(code: c_int) -> !;","     fn calloc(n: usize, sz: usize) -> *mut c_void;"]},{"oldStart":60,"oldLines":61,"newStart":79,"newLines":132,"lines":["     0"," }"," ","-/// What the constrained child is expected to observe.","-#[derive(Copy, Clone, PartialEq)]","+/// Which allocation inside `decode_base64` the budget must starve.","+#[derive(Copy, Clone, PartialEq, Debug)]"," enum Expect {","-    /// budget so tight that `calloc(1, l+13)` itself fails (row 3)","+    /// `calloc(1, l + 13)` itself fails (row 3)","     CallocFails,","-    /// budget that lets `calloc(1, l+13)` through but starves `malloc(l)` (row 4)","+    /// `calloc` succeeds, the following `malloc(l)` fails (row 4)","     MallocFails,"," }"," ","-/// Run the two implementations under `RLIMIT_AS == limit` in a forked child.","-/// Returns the child's exit code.","+// child exit codes","+const OK: c_int = 0;","+const BOTH_SUCCEEDED: c_int = 10;","+const RUST_NOT_NULL: c_int = 11;","+const RUST_NULL_ONLY: c_int = 12;","+const SETRLIMIT_FAILED: c_int = 20;","+const PROBE_CALLOC_FAILED: c_int = 21;","+const PROBE_MALLOC_SUCCEEDED: c_int = 22;","+const PROBE_CALLOC_SUCCEEDED: c_int = 23;","+const NO_BALLAST: c_int = 24;","+","+/// A ballast strategy: address-space budget in multiples of `cap`, plus which","+/// ballast block to release (row 4 only).","+#[derive(Copy, Clone, Debug)]","+struct Strategy {","+    caps: u64,","+    free_which: u8, // 0 = middle, 1 = first, 2 = last","+}","+","+/// Runs one attempt in a forked child; returns the child's exit code.","+#[allow(clippy::too_many_arguments)]"," fn run_child(","     f_c: DecodeFn,","     f_r: DecodeFn,","     src: *const c_char,","     cap: usize,","     l: usize,","-    limit: u64,","+    vsize: u64,","     expect: Expect,","+    st: Strategy,"," ) -> i32 {","     let pid = unsafe { fork() };","     assert!(pid >= 0, \"fork() failed\");","     if pid == 0 {","-        // ---- child: no Rust allocation, no panicking, raw syscalls only ----","+        // ------- child: raw libc only, no Rust allocation, no panicking -------","         unsafe {","+            let mut orig = RLimit { cur: 0, max: 0 };","+            if getrlimit(RLIMIT_AS, &mut orig) != 0 {","+                _exit(SETRLIMIT_FAILED);","+            }","             let rl = RLimit {","-                cur: limit,","-                max: limit,","+                cur: vsize + st.caps * cap as u64,","+                max: orig.max, // keep the hard limit, only squeeze the soft one","             };","             if setrlimit(RLIMIT_AS, &rl) != 0 {","-                _exit(20);","+                _exit(SETRLIMIT_FAILED);","             }","-            // Probe that the budget really makes the intended allocation fail.","+","+            // ---- ballast: consume the budget *and* every reusable hole ----","+            // The list is threaded through the blocks themselves, so no","+            // additional allocation is needed to track it.","+            let mut head: *mut c_void = std::ptr::null_mut();","+            let mut count: usize = 0;","+            loop {","+                let p = malloc(cap);","+                if p.is_null() {","+                    break;","+                }","+                *(p as *mut *mut c_void) = head;","+                head = p;","+                count += 1;","+                if count > 4096 {","+                    break; // safety valve","+                }","+            }","+","+            if expect == Expect::MallocFails {","+                if count == 0 {","+                    _exit(NO_BALLAST);","+                }","+                // pick the block to release","+                let idx = match st.free_which {","+                    1 => 0,","+                    2 => count - 1,","+                    _ => count / 2,","+                };","+                let mut prev: *mut c_void = std::ptr::null_mut();","+                let mut cur = head;","+                let mut i = 0usize;","+                while i < idx {","+                    prev = cur;","+                    cur = *(cur as *mut *mut c_void);","+                    i += 1;","+                }","+                let next = *(cur as *mut *mut c_void);","+                if prev.is_null() {","+                    head = next;","+                } else {","+                    *(prev as *mut *mut c_void) = next;","+                }","+                free(cur);","+            }","+","+            // ---- probes: prove the intended allocation is the failing one ----","             let p1 = calloc(1, cap);","             match expect {","                 Expect::CallocFails => {","                     if !p1.is_null() {","                         free(p1);","-                        _exit(23);","+                        _exit(PROBE_CALLOC_SUCCEEDED);","                     }","                 }","                 Expect::MallocFails => {","                     if p1.is_null() {","-                        _exit(21);","+                        _exit(PROBE_CALLOC_FAILED);","                     }","                     let p2 = malloc(l);","                     if !p2.is_null() {","                         free(p2);","                         free(p1);","-                        _exit(22);","+                        _exit(PROBE_MALLOC_SUCCEEDED);","                     }","                     free(p1);","                 }","             }","-            // ---- the actual differential call ----","+","+            // ---------------- the actual differential call ----------------","             let a = f_c(src);","             let b = f_r(src);","             let an = a.is_null();"]},{"oldStart":125,"oldLines":15,"newStart":215,"newLines":16,"lines":["             if !bn {","                 free(b as *mut c_void);","             }","+            let _ = head; // ballast is released by process exit","             match (an, bn) {","-                (true, true) => _exit(0),","-                (true, false) => _exit(11),","-                (false, true) => _exit(12),","-                (false, false) => _exit(10),","+                (true, true) => _exit(OK),","+                (true, false) => _exit(RUST_NOT_NULL),","+                (false, true) => _exit(RUST_NULL_ONLY),","+                (false, false) => _exit(BOTH_SUCCEEDED),","             }","         }","     }","-    // ---- parent ----","+    // ------------------------------- parent -------------------------------","     let mut status: c_int = 0;","     let deadline = std::time::Instant::now() + std::time::Duration::from_secs(60);","     loop {"]},{"oldStart":151,"oldLines":110,"newStart":242,"newLines":108,"lines":["     }","     assert!(","         status & 0x7f == 0,","-        \"child did not exit normally (status 0x{status:x}) — it was killed by \\","-         signal {}\",","+        \"child was killed by signal {} (status 0x{status:x}) — a crash under \\","+         allocation failure is itself a divergence from the C\",","         status & 0x7f","     );","     (status >> 8) & 0xff"," }"," ","+/// `true` if the attempt verified the row, `false` if it was inconclusive."," fn interpret(code: i32, what: &str) -> bool {","     match code {","-        0 => true,","-        11 => panic!(\"{what}: DIVERGENCE — C returned NULL but Rust returned a non-NULL pointer\"),","-        12 => panic!(\"{what}: DIVERGENCE — C returned a non-NULL pointer but Rust returned NULL\"),","-        10 => false, // both succeeded: budget too generous, retry","-        21 | 22 | 23 => false, // probe says the budget is not in the intended window, retry","-        20 => panic!(\"{what}: setrlimit(RLIMIT_AS) failed in the child\"),","+        OK => true,","+        RUST_NOT_NULL => {","+            panic!(\"{what}: DIVERGENCE — C returned NULL, Rust returned a non-NULL pointer\")","+        }","+        RUST_NULL_ONLY => {","+            panic!(\"{what}: DIVERGENCE — C returned a non-NULL pointer, Rust returned NULL\")","+        }","+        BOTH_SUCCEEDED | PROBE_CALLOC_FAILED | PROBE_MALLOC_SUCCEEDED | PROBE_CALLOC_SUCCEEDED","+        | NO_BALLAST => false,","+        SETRLIMIT_FAILED => panic!(\"{what}: getrlimit/setrlimit(RLIMIT_AS) failed in the child\"),","         other => panic!(\"{what}: unexpected child exit code {other}\"),","     }"," }"," ","-fn try_margins(","-    label: &str,","-    input: &[u8],","-    expect: Expect,","-    margins: &[u64],","-    limit_for: &dyn Fn(u64, u64, usize) -> u64,","-) {","+fn verify_row(label: &str, input: &[u8], expect: Expect) {","     let a = common::api();","     let src = input.as_ptr() as *const c_char;","-    let l = input.len(); // strlen(src) + 1","-    let cap = l + 13;","+    let l = input.len(); // == strlen(src) + 1","+    let cap = l + 13; // == calloc(1, l + 13)","     let mut last = -1;","-    for &margin in margins {","-        let vs = vsize_bytes();","-        let limit = limit_for(vs, margin, cap);","-        let code = run_child(a.c, a.rust, src, cap, l, limit, expect);","-        last = code;","-        if interpret(code, label) {","-            eprintln!(\"{label}: verified with RLIMIT_AS margin {margin} bytes\");","-            return;","+    for caps in [4u64, 2, 1, 8, 16] {","+        for free_which in [0u8, 1, 2] {","+            let st = Strategy { caps, free_which };","+            let vsize = vsize_bytes();","+            let code = run_child(a.c, a.rust, src, cap, l, vsize, expect, st);","+            last = code;","+            if interpret(code, label) {","+                eprintln!(\"{label}: VERIFIED (strategy {st:?}, {expect:?})\");","+                return;","+            }","+            eprintln!(\"{label}: inconclusive (child code {code}, strategy {st:?}), retrying\");","+            if expect == Expect::CallocFails {","+                break; // free_which is irrelevant for this row","+            }","         }","-        eprintln!(\"{label}: inconclusive with margin {margin} (child code {code}), retrying\");","     }","     panic!(","-        \"{label}: could not put the process in the required allocation window \\","+        \"{label}: could not create the required allocation window \\","          (last child exit code {last}); the branch was NOT verified\"","     );"," }"," ","-/// ERRORS.md row 3 — `calloc(sizeof(char), l + 13)` returns NULL.","+/// 64 MiB of valid base64 — `cap` is then always above glibc's maximum mmap","+/// threshold, so every allocation involved gets its own mapping.","+fn big_input() -> Vec<u8> {","+    let n = 64 * 1024 * 1024usize;","+    assert!(","+        mem_available_bytes() > 512 * 1024 * 1024,","+        \"not enough free memory for the allocation-failure tests\"","+    );","+    let mut v = vec![b'A'; n];","+    v.push(0);","+    v","+}","+","+/// ERRORS.md row 3 — `calloc(sizeof(char), l + 13)` returns NULL -> `return NULL`."," #[test]"," fn e3_calloc_fails_under_rlimit() {","-    let n = 64 * 1024 * 1024usize; // 64 MiB of valid base64","-    if mem_available_bytes() < 512 * 1024 * 1024 {","-        panic!(\"not enough free memory to run the calloc-failure test\");","-    }","-    let mut input = vec![b'A'; n];","-    input.push(0);","-    // budget = current address space + margin, with margin << 64 MiB so the","-    // destination allocation cannot be served.","-    try_margins(","+    let input = big_input();","+    verify_row(","         \"ERRORS row 3 (calloc fails)\",","         &input,","         Expect::CallocFails,","-        &[8 << 20, 4 << 20, 16 << 20, 2 << 20],","-        &|vs, margin, _cap| vs + margin,","     );"," }"," ","-/// ERRORS.md row 4 — `calloc` succeeds, then `malloc(l)` returns NULL, so the C","+/// ERRORS.md row 4 — `calloc` succeeds, `malloc(l)` returns NULL, so the C"," /// frees `dest` and returns NULL."," #[test]"," fn e4_malloc_fails_after_calloc_succeeds() {","-    let n = 1024 * 1024 * 1024usize; // 1 GiB","-    if mem_available_bytes() < 4 * 1024 * 1024 * 1024u64 {","-        panic!(\"not enough free memory to run the malloc-failure test\");","-    }","-    let mut input = vec![b'A'; n];","-    input.push(0);","-    // budget = address space + one destination buffer + margin, so `calloc`","-    // fits but the following `malloc(l)` (another ~1 GiB) cannot.","-    try_margins(","+    let input = big_input();","+    verify_row(","         \"ERRORS row 4 (malloc fails after calloc)\",","         &input,","         Expect::MallocFails,","-        &[32 << 20, 64 << 20, 128 << 20, 16 << 20, 256 << 20],","-        &|vs, margin, cap| vs + cap as u64 + margin,","     );"," }"," "," /// ERRORS.md row 3b — `int l = strlen(src) + 1` overflows `int`, so `l + 13`"," /// converts to a huge `size_t` and `calloc` fails. Two lengths:","-///   * `strlen == INT_MAX`     -> `l` wraps to `INT_MIN`","+///   * `strlen == INT_MAX`      -> `l` wraps to `INT_MIN`"," ///   * `strlen == INT_MAX - 12` -> `l + 13` overflows to `INT_MIN + 1`"," #[test]"," fn e3b_int_overflow_makes_calloc_fail() {","     let int_max = i32::MAX as usize; // 2147483647","     let need = int_max as u64 + 4096;","-    if mem_available_bytes() < need + (1 << 30) {","-        panic!(","-            \"not enough free memory ({} MiB available) for the 2 GiB oversized-input test\",","-            mem_available_bytes() >> 20","-        );","-    }","-    // One 2 GiB buffer reused for both lengths (NUL moved around).","+    assert!(","+        mem_available_bytes() >= need + (1 << 30),","+        \"not enough free memory ({} MiB available) for the 2 GiB oversized-input test\",","+        mem_available_bytes() >> 20","+    );","+    // One 2 GiB buffer reused for both lengths (the NUL is moved around).","     let mut buf = vec![b'A'; int_max + 1];","     for (name, len) in [","         (\"strlen == INT_MAX\", int_max),"]}],"originalFile":"//! Phase C — the two allocation-failure rejection branches of the C\n//! (`ERRORS.md` rows 3, 3b and 4).\n//!\n//! * row 3  — `calloc` fails  -> `return NULL`\n//! * row 3b — `int l = strlen(src)+1` overflows, so `l + 13` converts to a huge\n//!            `size_t` and `calloc` fails  -> `return NULL`\n//! * row 4  — `calloc` succeeds but `malloc` fails -> `free(dest); return NULL`\n//!\n//! Rows 3 and 4 are reproduced by constraining `RLIMIT_AS` inside a forked\n//! child, with probe allocations proving *which* of the two allocations the\n//! budget makes fail before the library is called.\n\nmod common;\n\nuse common::{diff_null, DecodeFn};\nuse std::ffi::{c_char, c_int, c_void};\n\nconst RLIMIT_AS: c_int = 9; // Linux\nconst WNOHANG: c_int = 1;\n\n#[repr(C)]\nstruct RLimit {\n    cur: u64,\n    max: u64,\n}\n\nunsafe extern \"C\" {\n    fn fork() -> i32;\n    fn waitpid(pid: i32, status: *mut c_int, options: c_int) -> i32;\n    fn kill(pid: i32, sig: c_int) -> c_int;\n    fn setrlimit(resource: c_int, rlim: *const RLimit) -> c_int;\n    fn _exit(code: c_int) -> !;\n    fn calloc(n: usize, sz: usize) -> *mut c_void;\n    fn malloc(sz: usize) -> *mut c_void;\n    fn free(p: *mut c_void);\n}\n\nfn vsize_bytes() -> u64 {\n    let s = std::fs::read_to_string(\"/proc/self/statm\").expect(\"read statm\");\n    let pages: u64 = s\n        .split_whitespace()\n        .next()\n        .unwrap()\n        .parse()\n        .expect(\"parse statm\");\n    pages * 4096\n}\n\nfn mem_available_bytes() -> u64 {\n    let s = std::fs::read_to_string(\"/proc/meminfo\").unwrap_or_default();\n    for line in s.lines() {\n        if let Some(rest) = line.strip_prefix(\"MemAvailable:\") {\n            if let Some(kb) = rest.split_whitespace().next() {\n                if let Ok(v) = kb.parse::<u64>() {\n                    return v * 1024;\n                }\n            }\n        }\n    }\n    0\n}\n\n/// What the constrained child is expected to observe.\n#[derive(Copy, Clone, PartialEq)]\nenum Expect {\n    /// budget so tight that `calloc(1, l+13)` itself fails (row 3)\n    CallocFails,\n    /// budget that lets `calloc(1, l+13)` through but starves `malloc(l)` (row 4)\n    MallocFails,\n}\n\n/// Run the two implementations under `RLIMIT_AS == limit` in a forked child.\n/// Returns the child's exit code.\nfn run_child(\n    f_c: DecodeFn,\n    f_r: DecodeFn,\n    src: *const c_char,\n    cap: usize,\n    l: usize,\n    limit: u64,\n    expect: Expect,\n) -> i32 {\n    let pid = unsafe { fork() };\n    assert!(pid >= 0, \"fork() failed\");\n    if pid == 0 {\n        // ---- child: no Rust allocation, no panicking, raw syscalls only ----\n        unsafe {\n            let rl = RLimit {\n                cur: limit,\n                max: limit,\n            };\n            if setrlimit(RLIMIT_AS, &rl) != 0 {\n                _exit(20);\n            }\n            // Probe that the budget really makes the intended allocation fail.\n            let p1 = calloc(1, cap);\n            match expect {\n                Expect::CallocFails => {\n                    if !p1.is_null() {\n                        free(p1);\n                        _exit(23);\n                    }\n                }\n                Expect::MallocFails => {\n                    if p1.is_null() {\n                        _exit(21);\n                    }\n                    let p2 = malloc(l);\n                    if !p2.is_null() {\n                        free(p2);\n                        free(p1);\n                        _exit(22);\n                    }\n                    free(p1);\n                }\n            }\n            // ---- the actual differential call ----\n            let a = f_c(src);\n            let b = f_r(src);\n            let an = a.is_null();\n            let bn = b.is_null();\n            if !an {\n                free(a as *mut c_void);\n            }\n            if !bn {\n                free(b as *mut c_void);\n            }\n            match (an, bn) {\n                (true, true) => _exit(0),\n                (true, false) => _exit(11),\n                (false, true) => _exit(12),\n                (false, false) => _exit(10),\n            }\n        }\n    }\n    // ---- parent ----\n    let mut status: c_int = 0;\n    let deadline = std::time::Instant::now() + std::time::Duration::from_secs(60);\n    loop {\n        let r = unsafe { waitpid(pid, &mut status, WNOHANG) };\n        if r == pid {\n            break;\n        }\n        assert!(r == 0, \"waitpid failed: {r}\");\n        if std::time::Instant::now() > deadline {\n            unsafe { kill(pid, 9) };\n            let _ = unsafe { waitpid(pid, &mut status, 0) };\n            panic!(\"child hung for 60s under RLIMIT_AS\");\n        }\n        std::thread::sleep(std::time::Duration::from_millis(20));\n    }\n    assert!(\n        status & 0x7f == 0,\n        \"child did not exit normally (status 0x{status:x}) — it was killed by \\\n         signal {}\",\n        status & 0x7f\n    );\n    (status >> 8) & 0xff\n}\n\nfn interpret(code: i32, what: &str) -> bool {\n    match code {\n        0 => true,\n        11 => panic!(\"{what}: DIVERGENCE — C returned NULL but Rust returned a non-NULL pointer\"),\n        12 => panic!(\"{what}: DIVERGENCE — C returned a non-NULL pointer but Rust returned NULL\"),\n        10 => false, // both succeeded: budget too generous, retry\n        21 | 22 | 23 => false, // probe says the budget is not in the intended window, retry\n        20 => panic!(\"{what}: setrlimit(RLIMIT_AS) failed in the child\"),\n        other => panic!(\"{what}: unexpected child exit code {other}\"),\n    }\n}\n\nfn try_margins(\n    label: &str,\n    input: &[u8],\n    expect: Expect,\n    margins: &[u64],\n    limit_for: &dyn Fn(u64, u64, usize) -> u64,\n) {\n    let a = common::api();\n    let src = input.as_ptr() as *const c_char;\n    let l = input.len(); // strlen(src) + 1\n    let cap = l + 13;\n    let mut last = -1;\n    for &margin in margins {\n        let vs = vsize_bytes();\n        let limit = limit_for(vs, margin, cap);\n        let code = run_child(a.c, a.rust, src, cap, l, limit, expect);\n        last = code;\n        if interpret(code, label) {\n            eprintln!(\"{label}: verified with RLIMIT_AS margin {margin} bytes\");\n            return;\n        }\n        eprintln!(\"{label}: inconclusive with margin {margin} (child code {code}), retrying\");\n    }\n    panic!(\n        \"{label}: could not put the process in the required allocation window \\\n         (last child exit code {last}); the branch was NOT verified\"\n    );\n}\n\n/// ERRORS.md row 3 — `calloc(sizeof(char), l + 13)` returns NULL.\n#[test]\nfn e3_calloc_fails_under_rlimit() {\n    let n = 64 * 1024 * 1024usize; // 64 MiB of valid base64\n    if mem_available_bytes() < 512 * 1024 * 1024 {\n        panic!(\"not enough free memory to run the calloc-failure test\");\n    }\n    let mut input = vec![b'A'; n];\n    input.push(0);\n    // budget = current address space + margin, with margin << 64 MiB so the\n    // destination allocation cannot be served.\n    try_margins(\n        \"ERRORS row 3 (calloc fails)\",\n        &input,\n        Expect::CallocFails,\n        &[8 << 20, 4 << 20, 16 << 20, 2 << 20],\n        &|vs, margin, _cap| vs + margin,\n    );\n}\n\n/// ERRORS.md row 4 — `calloc` succeeds, then `malloc(l)` returns NULL, so the C\n/// frees `dest` and returns NULL.\n#[test]\nfn e4_malloc_fails_after_calloc_succeeds() {\n    let n = 1024 * 1024 * 1024usize; // 1 GiB\n    if mem_available_bytes() < 4 * 1024 * 1024 * 1024u64 {\n        panic!(\"not enough free memory to run the malloc-failure test\");\n    }\n    let mut input = vec![b'A'; n];\n    input.push(0);\n    // budget = address space + one destination buffer + margin, so `calloc`\n    // fits but the following `malloc(l)` (another ~1 GiB) cannot.\n    try_margins(\n        \"ERRORS row 4 (malloc fails after calloc)\",\n        &input,\n        Expect::MallocFails,\n        &[32 << 20, 64 << 20, 128 << 20, 16 << 20, 256 << 20],\n        &|vs, margin, cap| vs + cap as u64 + margin,\n    );\n}\n\n/// ERRORS.md row 3b — `int l = strlen(src) + 1` overflows `int`, so `l + 13`\n/// converts to a huge `size_t` and `calloc` fails. Two lengths:\n///   * `strlen == INT_MAX`     -> `l` wraps to `INT_MIN`\n///   * `strlen == INT_MAX - 12` -> `l + 13` overflows to `INT_MIN + 1`\n#[test]\nfn e3b_int_overflow_makes_calloc_fail() {\n    let int_max = i32::MAX as usize; // 2147483647\n    let need = int_max as u64 + 4096;\n    if mem_available_bytes() < need + (1 << 30) {\n        panic!(\n            \"not enough free memory ({} MiB available) for the 2 GiB oversized-input test\",\n            mem_available_bytes() >> 20\n        );\n    }\n    // One 2 GiB buffer reused for both lengths (NUL moved around).\n    let mut buf = vec![b'A'; int_max + 1];\n    for (name, len) in [\n        (\"strlen == INT_MAX\", int_max),\n        (\"strlen == INT_MAX - 12\", int_max - 12),\n    ] {\n        buf[len] = 0;\n        let label = format!(\"ERRORS row 3b ({name})\");\n        diff_null(buf.as_ptr() as *const c_char, &label);\n        buf[len] = b'A';\n    }\n}\n","userModified":false}}
