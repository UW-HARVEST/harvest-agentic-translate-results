                \"if c4 != b'=' as c_char {\", \"if true {\", FAST, True),\n (\"byte 2: b3 >> 2 -> b3 >> 1\",                 \"((b3 as i32) >> 2)\", \"((b3 as i32) >> 1)\", FAST, True),\n (\"byte 1: b2 >> 4 -> b2 >> 3\",                 \"(b2 as i32) >> 4\", \"(b2 as i32) >> 3\", FAST, True),\n (\"byte 3: b3 & 0x3 -> b3 & 0x7\",               \"(b3 as i32 & 0x3)\", \"(b3 as i32 & 0x7)\", FAST, True),\n (\"loop step k += 4 -> k += 3\",                 \"            k += 4;\", \"            k += 3;\", FAST, True),\n (\"NULL check dropped\",                         \"if !src.is_null() && unsafe { *src } != 0 {\", \"if unsafe { *src } != 0 {\", FAST, True),\n (\"empty-string check dropped\",                 \"if !src.is_null() && unsafe { *src } != 0 {\", \"if !src.is_null() {\", FAST, True),\n (\"dest size l+13 -> l+12\",                     \"l.wrapping_add(13) as isize as usize\", \"l.wrapping_add(12) as isize as usize\", FAST, True),\n (\"l = strlen+1 -> strlen\",                     \"(unsafe { strlen(src) } as c_int).wrapping_add(1)\", \"(unsafe { strlen(src) } as c_int)\", FAST, True),\n (\"calloc-null check dropped\",                  \"        if dest.is_null() {\\n            return std::ptr::null_mut();\\n        }\", \"        if false {\\n            return std::ptr::null_mut();\\n        }\", ALLOC, True),\n (\"malloc-null check dropped\",                  \"        if buf.is_null() {\", \"        if false {\", ALLOC, True),\n (\"dest size: 64-bit add, no int wraparound\",   \"calloc(1, l.wrapping_add(13) as isize as usize)\", \"calloc(1, ((l as i64) + 13) as usize)\", ALLOC, True),\n (\"buf size: negative l zero-extended (u32)\",   \"malloc(l as isize as usize)\", \"malloc((l as u32) as usize)\", ALLOC, True),\n (\"buf size: negative l clamped to 0\",          \"malloc(l as isize as usize)\", \"malloc(if l < 0 { 0 } else { l as usize })\", ALLOC, True),\n (\"l: +1 added in 64-bit before truncation\",    \"(unsafe { strlen(src) } as c_int).wrapping_add(1)\", \"((unsafe { strlen(src) } + 1) as i64) as c_int\", ALLOC, True),\n # controls: semantics preserving, MUST NOT be detected\n (\"CONTROL calloc(1,n) -> calloc(n,1)\",         \"calloc(1, l.wrapping_add(13) as isize as usize)\", \"calloc(l.wrapping_add(13) as isize as usize, 1)\", FAST, False),\n (\"CONTROL 63 written as 0x3f\",                 \"    63\\n}\", \"    0x3f\\n}\", FAST, False),\n]\n\nok = True\nfor name, f, t, tests, expect_detect in MUTS:\n    if f not in ORIG:\n        print(f\"  ??  {name}: PATTERN NOT FOUND\"); ok = False; continue\n    open('src/lib.rs','w').write(ORIG.replace(f, t, 1))\n    b = subprocess.run(['cargo','build','--offline'], capture_output=True, text=True)\n    if b.returncode:\n        print(f\"  ??  {name}: mutated source does not compile\"); ok = False; continue\n    r = subprocess.run(['cargo','test','--offline'] + tests + ['--','--test-threads=1'],\n                       capture_output=True, text=True)\n    detected = r.returncode != 0\n    good = (detected == expect_detect)\n    ok &= good\n    print(f\"  {'OK ' if good else 'BAD'} {name}: {'detected' if detected else 'not detected'} \"\n          f\"(expected {'detected' if expect_detect else 'NOT detected'})\")\nopen('src/lib.rs','w').write(ORIG)\nsubprocess.run(['cargo','build','--offline'], capture_output=True)\nprint(\"MUTATION STUDY:\", \"all as expected\" if ok else \"PROBLEM - see BAD lines above\")\nPY\ntimeout 600 python3 \"$TMPDIR/mutate_all.py\" \"$TMPDIR/lib.rs.orig\" 2>&1 | tail -35","description":"Run comprehensive mutation study"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2185,"cache_read_input_tokens":176288,"cache_creation":{"ephemeral_5m_input_tokens":2185,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"c199c1a9-b8ce-4fd8-b611-969766e92ee3","uuid":"f48b4e9a-4a48-4fcd-abf1-99c9fa025034",