{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_016NEYfKMAaX4HeHSRKqLUad","type":"tool_result","content":"1\t// Rust translation of c_src/src/lib.c\n2\t//\n3\t// Copyright 2025 MIT Lincoln Laboratory\n4\t// Permission is hereby granted, free of charge,\n5\t// to any person obtaining a copy of this software\n6\t// and associated documentation files (the \"Software\"),\n7\t// to deal in the Software without restriction,\n8\t// including without limitation the rights to use, copy,\n9\t// modify, merge, publish, distribute, sublicense,\n10\t// and/or sell copies of the Software,\n11\t// and to permit persons to whom the Software is furnished to do so,\n12\t// subject to the following conditions:\n13\t//\n14\t// The above copyright notice and this permission notice\n15\t// shall be included in all copies or substantial portions of the Software.\n16\t//\n17\t// THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n18\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n19\t// THE WARRANTIES OF MERCHANTABILITY,\n20\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n21\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n22\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n23\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n24\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n25\t\n26\t#![allow(clippy::missing_safety_doc)]\n27\t\n28\tuse std::ffi::{c_char, c_int, c_void};\n29\tuse std::ptr;\n30\t\n31\t// ---------------------------------------------------------------------------\n32\t// libc bindings.\n33\t//\n34\t// The C translation unit uses malloc/realloc/free for the StringBuffer that it\n35\t// hands back to callers across the public ABI, and stdio's printf for its\n36\t// output. We bind those directly rather than using Rust's allocator / Rust's\n37\t// `println!` so that:\n38\t//\n39\t//   * a caller may `free()` a pointer obtained from `create_buffer`, and\n40\t//     `destroy_buffer` may `free()` a pointer obtained from `malloc`, exactly\n41\t//     as with the C library;\n42\t//   * `buffapp`'s output shares the C `stdout` buffer, so ordering and\n43\t//     flush-at-exit behaviour (and therefore the captured bytes) are identical.\n44\t// ---------------------------------------------------------------------------\n45\tunsafe extern \"C\" {\n46\t    fn malloc(size: usize) -> *mut c_void;\n47\t    fn realloc(ptr: *mut c_void, size: usize) -> *mut c_void;\n48\t    fn free(ptr: *mut c_void);\n49\t\n50\t    fn strlen(s: *const c_char) -> usize;\n51\t    fn strcpy(dst: *mut c_char, src: *const c_char) -> *mut c_char;\n52\t    fn strcmp(a: *const c_char, b: *const c_char) -> c_int;\n53\t\n54\t    #[link_name = \"sprintf\"]\n55\t    fn c_sprintf(buf: *mut c_char, fmt: *const c_char, ...) -> c_int;\n56\t    #[link_name = \"printf\"]\n57\t    fn c_printf(fmt: *const c_char, ...) -> c_int;\n58\t}\n59\t\n60\t/// typedef struct { char *data; int capacity; int length; } StringBuffer;\n61\t///\n62\t/// Opaque to C callers (it is declared inside lib.c, not in lib.h), but the\n63\t/// layout must match byte for byte: `char*` at offset 0, `int` at 8, `int` at\n64\t/// 12, size 16, align 8.\n65\t#[repr(C)]\n66\tpub struct StringBuffer {\n67\t    pub data: *mut c_char,\n68\t    pub capacity: c_int,\n69\t    pub length: c_int,\n70\t}\n71\t\n72\t// ---------------------------------------------------------------------------\n73\t// Static, NUL-terminated string literals mirroring the C string constants.\n74\t// ---------------------------------------------------------------------------\n75\tmacro_rules! cstr {\n76\t    ($s:expr) => {\n77\t        concat!($s, \"\\0\").as_ptr() as *const c_char\n78\t    };\n79\t}\n80\t\n81\tconst OP_ADD: *const c_char = cstr!(\"add\");\n82\tconst OP_SUBTRACT: *const c_char = cstr!(\"subtract\");\n83\tconst OP_MULTIPLY: *const c_char = cstr!(\"multiply\");\n84\tconst OP_DIVIDE: *const c_char = cstr!(\"divide\");\n85\tconst OP_UNKNOWN: *const c_char = cstr!(\"unknown\");\n86\t\n87\tconst FMT_STARTING: *const c_char = cstr!(\"Starting computation with %d parameters\\n\");\n88\tconst FMT_OP1: *const c_char = cstr!(\"Operation 1: %s(%d, %d)\\n\");\n89\tconst FMT_OP2: *const c_char = cstr!(\"Operation 2: %s(%d, %d)\\n\");\n90\tconst FMT_OP3: *const c_char = cstr!(\"Operation 3: %s(%d, %d)\\n\");\n91\tconst FMT_FINAL: *const c_char = cstr!(\"Final result: %d\\n\");\n92\tconst FMT_LOG: *const c_char = cstr!(\"Computation Log:\\n%s\\n\");\n93\t\n94\t// ---------------------------------------------------------------------------\n95\t// StringBuffer* create_buffer(int initial_capacity)\n96\t// ---------------------------------------------------------------------------\n97\t#[unsafe(no_mangle)]\n98\tpub unsafe extern \"C\" fn create_buffer(initial_capacity: c_int) -> *mut StringBuffer {\n99\t    unsafe {\n100\t        let buffer = malloc(size_of::<StringBuffer>()) as *mut StringBuffer;\n101\t        if buffer.is_null() {\n102\t            return ptr::null_mut();\n103\t        }\n104\t\n105\t        // `malloc(initial_capacity)`: the int argument is converted to size_t,\n106\t        // which sign-extends. A negative capacity therefore becomes a huge\n107\t        // request and malloc fails, exactly as in C. `as usize` on i32\n108\t        // sign-extends too.\n109\t        (*buffer).data = malloc(initial_capacity as usize) as *mut c_char;\n110\t        if (*buffer).data.is_null() {\n111\t            free(buffer as *mut c_void);\n112\t            return ptr::null_mut();\n113\t        }\n114\t\n115\t        (*buffer).capacity = initial_capacity;\n116\t        (*buffer).length = 0;\n117\t        // buffer->data[0] = '\\0';\n118\t        *(*buffer).data = 0;\n119\t\n120\t        buffer\n121\t    }\n122\t}\n123\t\n124\t// ---------------------------------------------------------------------------\n125\t// int append_to_buffer(StringBuffer *buffer, const char *str)\n126\t// ---------------------------------------------------------------------------\n127\t#[unsafe(no_mangle)]\n128\tpub unsafe extern \"C\" fn append_to_buffer(buffer: *mut StringBuffer, str_: *const c_char) -> c_int {\n129\t    unsafe {\n130\t        // `int str_len = strlen(str);` truncates size_t to int.\n131\t        let str_len = strlen(str_) as c_int;\n132\t        let required_capacity = (*buffer)\n133\t            .length\n134\t            .wrapping_add(str_len)\n135\t            .wrapping_add(1);\n136\t\n137\t        if required_capacity > (*buffer).capacity {\n138\t            let new_capacity = required_capacity.wrapping_mul(2);\n139\t            let new_data =\n140\t                realloc((*buffer).data as *mut c_void, new_capacity as usize) as *mut c_char;\n141\t\n142\t            if new_data.is_null() {\n143\t                return -1;\n144\t            }\n145\t\n146\t            (*buffer).data = new_data;\n147\t            (*buffer).capacity = new_capacity;\n148\t        }\n149\t\n150\t        strcpy((*buffer).data.offset((*buffer).length as isize), str_);\n151\t        (*buffer).length = (*buffer).length.wrapping_add(str_len);\n152\t\n153\t        0\n154\t    }\n155\t}\n156\t\n157\t// ---------------------------------------------------------------------------\n158\t// void destroy_buffer(StringBuffer *buffer)\n159\t// ---------------------------------------------------------------------------\n160\t#[unsafe(no_mangle)]\n161\tpub unsafe extern \"C\" fn destroy_buffer(buffer: *mut StringBuffer) {\n162\t    unsafe {\n163\t        if !buffer.is_null() {\n164\t            if !(*buffer).data.is_null() {\n165\t                free((*buffer).data as *mut c_void);\n166\t            }\n167\t            free(buffer as *mut c_void);\n168\t        }\n169\t    }\n170\t}\n171\t\n172\t// ---------------------------------------------------------------------------\n173\t// const char* get_operation_name(int op_code)\n174\t// ----------------------------------------