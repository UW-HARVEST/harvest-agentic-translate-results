ffer, run in a fresh process each time.\n747\t#[test]\n748\tfn b06_main_via_so_lengths() {\n749\t    let mut rng = Rng::new(0x5eed_1234_5678_90ab);\n750\t    let mut inputs: Vec<Vec<u8>> = vec![\n751\t        b\"\".to_vec(),\n752\t        b\"A\".to_vec(),\n753\t        b\"x\".to_vec(),\n754\t        b\"Ax\\n\".to_vec(),\n755\t        b\"hello\\nworld\\n\".to_vec(),\n756\t    ];\n757\t    for len in [1usize, 2, 500, 998, 999, 1001, 1002, 2000, 5000] {\n758\t        let mut v = Vec::with_capacity(len);\n759\t        for _ in 0..len {\n760\t            v.push(rng.pick(b\"AaxXB \\n\"));\n761\t        }\n762\t        inputs.push(v);\n763\t    }\n764\t    for input in &inputs {\n765\t        let c = run_child(\"main\", c_so_path(), Some(input));\n766\t        let r = run_child(\"main\", rust_so_path(), Some(input));\n767\t        assert_eq!(c, r, \"main(.so) mismatch for input len {}\", input.len());\n768\t        let truncated = &input[..input.len().min(1000)];\n769\t        assert_eq!(\n770\t            c.stdout,\n771\t            expected(count(truncated, b'A'), count(truncated, b'x')),\n772\t            \"unexpected C output\"\n773\t        );\n774\t        assert_eq!(c.code, Some(0));\n775\t    }\n776\t}\n777\t\n778\t/// CONFIGS row 18: embedded NUL bytes — the C string ends at the first NUL, so\n779\t/// everything behind it is invisible even though `fread` read it.\n780\t#[test]\n781\tfn b07_main_via_so_embedded_nul() {\n782\t    let inputs: Vec<Vec<u8>> = vec![\n783\t        b\"\\x00\".to_vec(),\n784\t        b\"\\x00AAAxxx\".to_vec(),\n785\t        b\"AAx\\x00AAAA\".to_vec(),\n786\t        b\"AAx\\x00xxxx\\x00AA\".to_vec(),\n787\t        {\n788\t            let mut v = vec![b'A'; 1000];\n789\t            v[500] = 0;\n790\t            v\n791\t        },\n792\t        {\n793\t            let mut v = vec![b'x'; 1200];\n794\t            v[999] = 0;\n795\t            v\n796\t        },\n797\t    ];\n798\t    for input in &inputs {\n799\t        let c = run_child(\"main\", c_so_path(), Some(input));\n800\t        let r = run_child(\"main\", rust_so_path(), Some(input));\n801\t        assert_eq!(c, r, \"main(.so) mismatch for embedded-NUL input\");\n802\t        let truncated = &input[..input.len().min(1000)];\n803\t        assert_eq!(c.stdout, expected(count(truncated, b'A'), count(truncated, b'x')));\n804\t    }\n805\t}\n806\t\n807\t/// CONFIGS rows 19-20: the two executables end to end, randomized inputs\n808\t/// (binary-safe, including NULs and bytes >= 0x80).\n809\t#[test]\n810\tfn b08_executables_random() {\n811\t    let mut rng = Rng::new(0xabcd_ef01_2345_6789);\n812\t    for iter in 0..150 {\n813\t        let len = rng.below(1500);\n814\t        let input: Vec<u8> = (0..len)\n815\t            .map(|_| {\n816\t                if iter % 4 == 0 {\n817\t                    // binary, may contain NUL\n818\t                    (rng.next_u64() & 0xff) as u8\n819\t                } else {\n820\t                    rng.pick(b\"AaxX \\n\\t\\xff\")\n821\t                }\n822\t            })\n823\t            .collect();\n824\t        let c = run_exe(c_exe_path(), &input);\n825\t        let r = run_exe(rust_exe_path(), &input);\n826\t        if c != r {\n827\t            let p = artifacts_dir().join(\"b08_fail.bin\");\n828\t            fs::write(&p, &input).unwrap();\n829\t            panic!(\"exe mismatch for len {len} (iter {iter}), input dumped to {p:?}\\nC={c:?}\\nR={r:?}\");"}]},"parent_tool_use_id":null,"session_id":"7d8e16f2-9420-49d7-b670-3c5da0a13acc","uuid":"a576b852-dbc4-4430-98f5-6879890b2957","timestamp":"2026-08-18T06:30:26.909Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-I5NRig/translated_rust/tests/differential.rs","content":"            r,\n            \"driver mismatch for {:?}: C={:?} Rust={:?}\",\n            String::from_utf8_lossy(&s),\n            String::from_utf8_lossy(&c),\n            String::from_utf8_lossy(&r)\n        );\n        assert_eq!(c, expected(count(&s, b'A'), count(&s, b'x')));\n    }\n}\n\n/// CONFIGS rows 12-14: `driver` over the distinct shapes it distinguishes —\n/// only 'A', only 'x', both, neither, wrong case, non-ASCII, and long inputs.\n#[test]\nfn b05_driver_shapes() {\n    let mut cases: Vec<Vec<u8>> = vec![\n        b\"\".to_vec(),\n        b\"A\".to_vec(),\n        b\"x\".to_vec(),\n        b\"Ax\".to_vec(),\n        b\"xA\".to_vec(),\n        b\"aX\".to_vec(),\n        b\"hello world\".to_vec(),\n        b\"AAAAxxxx\".to_vec(),\n        b\"AxAxAxAxAx\".to_vec(),\n        b\"\\xc3\\xa4\\xc3\\xb6A\\xffx\".to_vec(),\n        b\"no matches here!\".to_vec(),\n        b\"\\n\\t\\r A x\".to_vec(),\n    ];\n    for len in [1usize, 999, 1000, 1001, 2000] {\n        cases.push(vec![b'A'; len]);\n        cases.push(vec![b'x'; len]);\n        let mut alt = vec![b'A'; len];\n        for (i, b) in alt.iter_mut().enumerate() {\n            if i % 2 == 1 {\n                *b = b'x';\n            }\n        }\n        cases.push(alt);\n    }\n    let c = driver_batch(c_so_path(), &cases);\n    let r = driver_batch(rust_so_path(), &cases);\n    assert_eq!(c, r, \"driver shape mismatch\");\n    assert_eq!(c.stdout, expected_batch(&cases), \"C output disagrees with reference model\");\n}\n\n/// CONFIGS rows 15-17: the `main` export through the .so, over the input-length\n/// boundaries of the 1000-byte buffer, run in a fresh process each time.\n#[test]\nfn b06_main_via_so_lengths() {\n    let mut rng = Rng::new(0x5eed_1234_5678_90ab);\n    let mut inputs: Vec<Vec<u8>> = vec![\n        b\"\".to_vec(),\n        b\"A\".to_vec(),\n        b\"x\".to_vec(),\n        b\"Ax\\n\".to_vec(),\n        b\"hello\\nworld\\n\".to_vec(),\n    ];\n    for len in [1usize, 2, 500, 998, 999, 1001, 1002, 2000, 5000] {\n        let mut v = Vec::with_capacity(len);\n        for _ in 0..len {\n            v.push(rng.pick(b\"AaxXB \\n\"));\n        }\n        inputs.push(v);\n    }\n    for input in &inputs {\n        let c = run_child(\"main\", c_so_path(), Some(input));\n        let r = run_child(\"main\", rust_so_path(), Some(input));\n        assert_eq!(c, r, \"main(.so) mismatch for input len {}\", input.len());\n        let truncated = &input[..input.len().min(1000)];\n        assert_eq!(\n            c.stdout,\n            expected(count(truncated, b'A'), count(truncated, b'x')),\n            \"unexpected C output\"\n        );\n        assert_eq!(c.code, Some(0));\n    }\n}\n\n/// CONFIGS row 18: embedded NUL bytes — the C string ends at the first NUL, so\n/// everything behind it is invisible even though `fread` read it.\n#[test]\nfn b07_main_via_so_embedded_nul() {\n    let inputs: Vec<Vec<u8>> = vec![\n        b\"\\x00\".to_vec(),\n        b\"\\x00AAAxxx\".to_vec(),\n        b\"AAx\\x00AAAA\".to_vec(),\n        b\"AAx\\x00xxxx\\x00AA\".to_vec(),\n        {\n            let mut v = vec![b'A'; 1000];\n            v[500] = 0;\n            v\n        },\n        {\n            let mut v = vec![b'x'; 1200];\n            v[999] = 0;\n            v\n        },\n    ];\n    for input in &inputs {\n        let c = run_child(\"main\", c_so_path(), Some(input));\n        let r = run_child(\"main\", rust_so_path(), Some(input));\n        assert_eq!(c, r, \"main(.so) mismatch for embedded-NUL input\");\n        let truncated = &input[..input.len().min(1000)];\n        assert_eq!(c.stdout, expected(count(truncated, b'A'), count(truncated, b'x')));\n    }\n}\n\n/// CONFIGS rows 19-20: the two executables end to end, randomized inputs\n/// (binary-safe, including NULs and bytes >= 0x80).\n#[test]\nfn b08_executables_random() {\n    let mut rng = Rng::new(0xabcd_ef01_2345_6789);\n    for iter in 0..150 {\n        let len = rng.below(1500);\n        let input: Vec<u8> = (0..len)\n            .map(|_| {\n                if iter % 4 == 0 {\n                    // binary, may contain NUL\n                    (rng.next_u64() & 0xff) as u8\n                } else {\n                    rng.pick(b\"A