$ORIG\" \"$SRC\"; then\n    echo \"SKIP  $name (mutation did not apply)\"\n    revert\n    return\n  fi\n  local out\n  # MUST rebuild: cargo test alone does not regenerate a cdylib-only target.\n  if ! out=$(timeout 600 cargo build --no-default-features 2>&1); then\n    echo \"CAUGHT   $name  (compile error)\"\n    pass=$((pass+1)); revert; timeout 600 cargo build --no-default-features >/dev/null 2>&1; return\n  fi\n  out=$(timeout 600 cargo test --no-default-features --test \"$which\" 2>&1)\n  if echo \"$out\" | grep -qE \"test result: FAILED|panicked|error\\[E\"; then\n    echo \"CAUGHT   $name  (via $which)\"\n    pass=$((pass+1))\n  else\n    echo \"SURVIVED $name  (via $which)  <-- BLIND SPOT\"\n    echo \"$out\" | tail -5\n    fail=$((fail+1))\n  fi\n  revert\n  timeout 600 cargo build --no-default-features >/dev/null 2>&1\n}\n\n# 1. double->int out-of-range: saturate (Rust default) instead of x86 indefinite.\nmutate \"convert: saturating instead of 0x80000000\" \\\n  's/if truncated >= 2147483648\\.0 \\|\\| truncated < -2147483648\\.0 \\{\\n        return i32::MIN;\\n    \\}/if false { return i32::MIN; }/' \\\n  phase_c_errors\n\n# 2. double->int NaN: return 0 instead of 0x80000000.\nmutate \"convert: NaN -> 0\" \\\n  's/if value\\.is_nan\\(\\) \\{\\n        return i32::MIN;\\n    \\}/if value.is_nan() { return 0; }/' \\\n  phase_c_errors\n\n# 3. convert: floor instead of truncate-toward-zero.\nmutate \"convert: floor instead of trunc\" \\\n  's/let truncated = value\\.trunc\\(\\);/let truncated = value.floor();/' \\\n  phase_b_valid\n\n# 4. create_numeric_buffer: Euclidean modulus instead of C remainder.\nmutate \"create_numeric_buffer: rem_euclid\" \\\n  's/\\.wrapping_rem\\(256\\);\\n        unsafe \\{/.rem_euclid(256);\\n        unsafe {/' \\\n  phase_c_errors\n\n# 5. create_numeric_buffer: stride 7 -> 6 (breaks the permutation property).\nmutate \"create_numeric_buffer: stride 6\" \\\n  's/i\\.wrapping_mul\\(7\\)/i.wrapping_mul(6)/' \\\n  phase_b_valid\n\n# 6. create_numeric_buffer: off-by-one loop bound.\nmutate \"create_numeric_buffer: i <= size\" \\\n  's/while i < size \\{/while i <= size {/' \\\n  phase_b_valid\n\n# 7. calculate_with_doubles: Euclidean modulus for the pow exponent.\nmutate \"calculate_with_doubles: rem_euclid(10)\" \\\n  's/c\\.wrapping_rem\\(10\\)/c.rem_euclid(10)/' \\\n  phase_c_errors\n\n# 8. calculate_with_doubles: drop the b != 0 guard sense.\nmutate \"calculate_with_doubles: b == 0 branch inverted\" \\\n  's/if b != 0 \\{\\n        result = \\(a as f64\\) \\/ \\(b as f64\\);/if b == 0 { result = 1.0;/' \\\n  phase_c_errors\n\n# 9. find_value_in_buffer: return 0 instead of -1 when absent.\nmutate \"find_value_in_buffer: absent -> 0\" \\\n  's/    -1\\n\\}/    0\\n}/' \\\n  phase_c_errors\n\n# 10. find_value_in_buffer: search unsigned-widened value (no (char) narrowing\n#     is observable, but widening to i32 without masking is).\nmutate \"find_value_in_buffer: no byte narrowing\" \\\n  's/let target: i8 = search_val as i8;/let target: i32 = search_val;/;s/target as c_int, size/target, size/' \\\n  phase_c_errors\n\n# 11. process_negation: & 1 instead of != 0.\nmutate \"process_negation: & 1\" \\\n  's/let var2: c_int = if var1 != 0 \\{ 1 \\} else \\{ 0 \\};/let var2: c_int = var1 \\& 1;/' \\\n  phase_c_errors\n\n# 12. doubleneg: %e -> %g in the calculated-double line (stdout-only divergence).\nmutate \"doubleneg: %e -> %g (stdout only)\" \\\n  's/Calculated double value: %e/Calculated double value: %g/' \\\n  phase_b_doubleneg\n\n# 13. doubleneg: drop the leading newline of a section header (stdout only).\nmutate \"doubleneg: missing newline in header (stdout only)\" \\\n  's/\\\\\\\\n--- Combined Feature Test ---/--- Combined Feature Test ---/' \\\n  phase_b_doubleneg\n\n# 14. doubleneg: accumulate 1 instead of 10 for the first !! result.\nmutate \"doubleneg: *10 -> *1\" \\\n  's/negation_result\\.wrapping_mul\\(10\\)/negation_result.wrapping_mul(1)/' \\\n  phase_b_doubleneg\n\n# 15. doubleneg: pow(2,40) -> pow(2,30) (changes converted_neg, in range now).\nmutate \"doubleneg: pow(2,40) -> pow(2,30)\" \\\n  's/c_pow\\(2\\.0, 40\\.0\\)/c_pow(2.0, 30.0)/' \\\n  phase_c_doubleneg_errors\n\n# 16. doubleneg: swap the search_values order (position sums differ).\nmutate \"doubleneg: search_values order swapped\" \\\n  's/param2\\.wrapping_rem\\(256\\),\\n        param3\\.wrapping_rem\\(256\\),/param3.wrapping_rem(256),\\n        param2.wrapping_rem(256),/' \\\n  phase_b_doubleneg\n\n# 17. doubleneg: loop 9 times instead of 10.\nmutate \"doubleneg: combined loop 9 iterations\" \\\n  's/while j < 10 \\{/while j < 9 {/' \\\n  phase_b_doubleneg\n\n# 18. doubleneg: %ld -> %d for the pointer offset.\nmutate \"doubleneg: %ld -> %d (stdout only)\" \\\n  's/at offset: %ld/at offset: %d/' \\\n  phase_b_doubleneg\n\nrevert\necho\necho \"=== mutation summary: caught=$pass survived=$fail ===\"\ncmp -s \"$ORIG\" \"$SRC\" && echo \"src/lib.rs restored to original\" || echo \"WARNING: src/lib.rs NOT restored\"\n[ \"$fail\" -eq 0 ]\n","structuredPatch":[{"oldStart":29,"oldLines":14,"newStart":29,"newLines":15,"lines":["     echo \"CAUGHT   $name  (compile error)\"","     pass=$((pass+1)); revert; timeout 600 cargo build --no-default-features >/dev/null 2>&1; return","   fi","-  out=$(timeout 600 cargo test --no-default-features --test \"$which\" 2>&1)","-  if echo \"$out\" | grep -qE \"test result: FAILED|panicked|error\\[E\"; then","-    echo \"CAUGHT   $name  (via $which)\"","-    pass=$((pass+1))","-  else","+  # Detect failure by EXIT STATUS, not by grepping text: a panic raised while","+  # fd 1 is redirected used to hide libtest's output entirely.","+  if out=$(timeout 600 cargo test --no-default-features --test \"$which\" 2>&1); then","     echo \"SURVIVED $name  (via $which)  <-- BLIND SPOT\"","     echo \"$out\" | tail -5","     fail=$((fail+1))","+  else","+    echo \"CAUGHT   $name  (via $which)\"","+    pass=$((pass+1))","   fi","   revert","   timeout 600 cargo build --no-default-features >/dev/null 2>&1"]}],"userModified":false,"replaceAll":false}}
