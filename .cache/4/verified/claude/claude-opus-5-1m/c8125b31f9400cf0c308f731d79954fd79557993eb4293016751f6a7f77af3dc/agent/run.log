utate \"process_negation: & 1\" \\\n  's/let var2: c_int = if var1 != 0 \\{ 1 \\} else \\{ 0 \\};/let var2: c_int = var1 \\& 1;/' \\\n  phase_c_errors\n\n# 12. doubleneg: %e -> %g in the calculated-double line (stdout-only divergence).\nmutate \"doubleneg: %e -> %g (stdout only)\" \\\n  's/Calculated double value: %e/Calculated double value: %g/' \\\n  phase_b_doubleneg\n\n# 13. doubleneg: drop the leading newline of a section header (stdout only).\nmutate \"doubleneg: missing newline in header (stdout only)\" \\\n  's/\\\\\\\\n--- Combined Feature Test ---/--- Combined Feature Test ---/' \\\n  phase_b_doubleneg\n\n# 14. doubleneg: accumulate 1 instead of 10 for the first !! result.\nmutate \"doubleneg: *10 -> *1\" \\\n  's/negation_result\\.wrapping_mul\\(10\\)/negation_result.wrapping_mul(1)/' \\\n  phase_b_doubleneg\n\n# 15. doubleneg: pow(2,40) -> pow(2,30) (changes converted_neg, in range now).\nmutate \"doubleneg: pow(2,40) -> pow(2,30)\" \\\n  's/c_pow\\(2\\.0, 40\\.0\\)/c_pow(2.0, 30.0)/' \\\n  phase_c_doubleneg_errors\n\n# 16. doubleneg: swap the search_values order (position sums differ).\nmutate \"doubleneg: search_values order swapped\" \\\n  's/param2\\.wrapping_rem\\(256\\),\\n        param3\\.wrapping_rem\\(256\\),/param3.wrapping_rem(256),\\n        param2.wrapping_rem(256),/' \\\n  phase_b_doubleneg\n\n# 17. doubleneg: loop 9 times instead of 10.\nmutate \"doubleneg: combined loop 9 iterations\" \\\n  's/while j < 10 \\{/while j < 9 {/' \\\n  phase_b_doubleneg\n\n# 18. doubleneg: %ld -> %d for the pointer offset.\nmutate \"doubleneg: %ld -> %d (stdout only)\" \\\n  's/at offset: %ld/at offset: %d/' \\\n  phase_b_doubleneg\n\nrevert\necho\necho \"=== mutation summary: caught=$pass survived=$fail ===\"\ncmp -s \"$ORIG\" \"$SRC\" && echo \"src/lib.rs restored to original\" || echo \"WARNING: src/lib.rs NOT restored\"\n[ \"$fail\" -eq 0 ]\n","structuredPatch":[],"originalFile":null,"userModified":false}}
