\nmutate \"convert: floor instead of trunc\" \\\n  's/let truncated = value\\.trunc\\(\\);/let truncated = value.floor();/' \\\n  phase_b_valid\n\n# 4. create_numeric_buffer: Euclidean modulus instead of C remainder.\nmutate \"create_numeric_buffer: rem_euclid\" \\\n  's/\\.wrapping_rem\\(256\\);\\n        unsafe \\{/.rem_euclid(256);\\n        unsafe {/' \\\n  phase_c_errors\n\n# 5. create_numeric_buffer: stride 7 -> 6 (breaks the permutation property).\nmutate \"create_numeric_buffer: stride 6\" \\\n  's/i\\.wrapping_mul\\(7\\)/i.wrapping_mul(6)/' \\\n  phase_b_valid\n\n# 6. create_numeric_buffer: off-by-one loop bound.\nmutate \"create_numeric_buffer: i <= size\" \\\n  's/while i < size \\{/while i <= size {/' \\\n  phase_b_valid\n\n# 7. calculate_with_doubles: Euclidean modulus for the pow exponent.\nmutate \"calculate_with_doubles: rem_euclid(10)\" \\\n  's/c\\.wrapping_rem\\(10\\)/c.rem_euclid(10)/' \\\n  phase_c_errors\n\n# 8. calculate_with_doubles: drop the b != 0 guard sense.\nmutate \"calculate_with_doubles: b == 0 branch inverted\" \\\n  's/if b != 0 \\{\\n        result = \\(a as f64\\) \\/ \\(b as f64\\);/if b == 0 { result = 1.0;/' \\\n  phase_c_errors\n\n# 9. find_value_in_buffer: return 0 instead of -1 when absent.\nmutate \"find_value_in_buffer: absent -> 0\" \\\n  's/    -1\\n\\}/    0\\n}/' \\\n  phase_c_errors\n\n# 10. find_value_in_buffer: search unsigned-widened value (no (char) narrowing\n#     is observable, but widening to i32 without masking is).\nmutate \"find_value_in_buffer: no byte narrowing\" \\\n  's/let target: i8 = search_val as i8;/let target: i32 = search_val;/;s/target as c_int, size/target, size/' \\\n  phase_c_errors\n\n# 11. process_negation: & 1 instead of != 0.\nmutate \"process_negation: & 1\" \\\n  's/let var2: c_int = if var1 != 0 \\{ 1 \\} else \\{ 0 \\};/let var2: c_int = var1 \\& 1;/' \\\n  phase_c_errors\n\n# 12. doubleneg: %e -> %g in the calculated-double line (stdout-only divergence).\nmutate \"doubleneg: %e -> %g