----------------------------------------------------------------------\n# 1. Enumerate feature combinations from Cargo.toml (power set of [features],\n#    excluding the \"default\" meta-feature).\n# ---------------------------------------------------------------------------\nmapfile -t FEATURES < <(\n  awk '\n    /^\\[features\\]/ { inf = 1; next }\n    /^\\[/           { inf = 0 }\n    inf && /^[A-Za-z0-9_-]+[[:space:]]*=/ {\n      split($0, a, \"=\"); gsub(/[[:space:]]/, \"\", a[1]);\n      if (a[1] != \"default\") print a[1]\n    }\n  ' Cargo.toml\n)\n\nCOMBOS=()\nn=${#FEATURES[@]}\nif [ \"$n\" -eq 0 ]; then\n  COMBOS=(\"\")            # no features exist -> exactly one configuration\nelse\n  for ((mask = 0; mask < (1 << n); mask++)); do\n    combo=\"\"\n    for ((i = 0; i < n; i++)); do\n      if (((mask >> i) & 1)); then\n        combo=\"${combo:+$combo,}${FEATURES[$i]}\"\n      fi\n    done\n    COMBOS+=(\"$combo\")\n  done\nfi\n\necho \"Discovered ${#FEATURES[@]} feature(s): ${FEATURES[*]:-<none>}\"\necho \"Feature combinations to verify: ${#COMBOS[@]}\"\n\n# ---------------------------------------------------------------------------\n# 2. Build the C reference library.\n# ---------------------------------------------------------------------------\necho\necho \"=== Building C reference .so ===\"\nmkdir -p c_src/build\n(cd c_src/build \\\n  && cmake .. -DCMAKE_POSITION_INDEPENDENT_CODE=ON > cmake.log 2>&1 \\\n  && cmake --build . >> cmake.log 2>&1) \\\n  || { echo \"C build FAILED\"; tail -30 c_src/build/cmake.log; exit 1; }\nls -l c_src/build/*.so\n\n# ---------------------------------------------------------------------------\n# 3. For each combination: check, build the .so, run every test binary.\n# ---------------------------------------------------------------------------\nrc=0\nfor combo in \"${COMBOS[@]}\"; do\n  if [ -z \"$combo\" ]; then\n    label=\"<no features>\"\n    fargs=(--no-default-features)\n  else\n    label=\"$combo\"\n    fargs=(--no-default-features --features \"$combo\")\n  fi\n\n  echo\n  echo \"############################################################\"\n  echo \"# feature combination: $label\"\n  echo \"############################################################\"\n\n  echo \"--- cargo check ---\"\n  if ! timeout 600 cargo check \"${fargs[@]}\" 2>&1 | tail -5; then\n    echo \"CHECK FAILED for $label\"; rc=1; continue\n  fi\n\n  echo \"--- cargo build (emits the cdylib the tests dlopen) ---\"\n  if ! timeout 600 cargo build \"${fargs[@]}\" 2>&1 | tail -5; then\n    echo \"BUILD FAILED for $label\"; rc=1; continue\n  fi\n\n  echo \"--- cargo test ---\"\n  if ! timeout 600 cargo test \"${fargs[@]}\" 2>&1 | tail -45; then\n    echo \"TESTS FAILED for $label\"; rc=1\n  fi\ndone\n\necho\nif [ \"$rc\" -eq 0 ]; then\n  echo \"=== ALL feature combinations passed ===\"\nelse\n  echo \"=== FAILURES present ===\"\nfi\nexit \"$rc\"\n","structuredPatch":[{"oldStart":83,"oldLines":9,"newStart":83,"newLines":20,"lines":["   fi"," ","   echo \"--- cargo test ---\"","-  if ! timeout 600 cargo test \"${fargs[@]}\" 2>&1 | tail -45; then","-    echo \"TESTS FAILED for $label\"; rc=1","+  log=\"$(mktemp \"${TMPDIR:-/tmp}/dnf-test-XXXXXX.log\")\"","+  if timeout 600 cargo test \"${fargs[@]}\" > \"$log\" 2>&1; then","+    # Show every test binary and its verdict (never truncate the summary).","+    grep -E \"^\\s*Running |^test result:\" \"$log\" | sed 's/^/    /'","+    bins=$(grep -c \"^test result:\" \"$log\")","+    tests=$(grep -oP \"^test result: ok\\. \\K[0-9]+\" \"$log\" | paste -sd+ - | bc)","+    echo \"    => $bins test binaries, ${tests:-0} test functions, all passed\"","+  else","+    echo \"TESTS FAILED for $label\"","+    grep -E \"^\\s*Running |^test result:|^failures:|panicked|^error\" \"$log\" | sed 's/^/    /'","+    sed -n '/^failures:/,$p' \"$log\" | head -60","+    rc=1","   fi","+  rm -f \"$log\""," done"," "," echo"]}],"userModified":false,"replaceAll":false}}
