32) -> f32 {\n51\t    // Rust's `%` on floats lowers to `frem`, i.e. fmodf semantics.\n52\t    x % y\n53\t}\n54\t\n55\t/// `floorf`\n56\t#[inline]\n57\tfn floorf(x: f32) -> f32 {\n58\t    x.floor()\n59\t}\n60\t\n61\t// --- Single-precision arithmetic with x86 SSE NaN-propagation semantics ------\n62\t//\n63\t// C compilers are free to reassociate/commute `a - b*c` style expressions,\n64\t// which changes *which* NaN operand is propagated (and hence the resulting NaN\n65\t// sign/payload).  LLVM performs such canonicalisations aggressively, so plain\n66\t// Rust `a - b * c` can end up propagating the other NaN than the C build does.\n67\t//\n68\t// These helpers pin the operand order to the order written in the C source and\n69\t// implement the x86 `addss`/`subss`/`mulss`/`divss` rule:\n70\t//   * if the destination operand is a NaN, the result is that NaN, quieted;\n71\t//   * else if the source operand is a NaN, the result is that NaN, quieted;\n72\t//   * otherwise the ordinary IEEE-754 single-precision result.\n73\t// For non-NaN operands they are plain hardware ops, so finite/infinite results\n74\t// (including the invalid-operation default NaN) are bit-identical either way.\n75\t\n76\t/// Quiet a NaN the way x86 does (set the most significant mantissa bit).\n77\t#[inline(always)]\n78\tfn quiet_nan(x: f32) -> f32 {\n79\t    f32::from_bits(x.to_bits() | 0x0040_0000)\n80\t}\n81\t\n82\t#[inline(always)]\n83\tfn ss_add(dst: f32, src: f32) -> f32 {\n84\t    if dst.is_nan() {\n85\t        quiet_nan(dst)\n86\t    } else if src.is_nan() {\n87\t        quiet_nan(src)\n88\t    } else {\n89\t        dst + src\n90\t    }\n91\t}\n92\t\n93\t#[inline(always)]\n94\tfn ss_sub(dst: f32, src: f32) -> f32 {\n95\t    if dst.is_nan() {\n96\t        quiet_nan(dst)\n97\t    } else if src.is_nan() {\n98\t        quiet_nan(src)\n99\t    } else {\n100\t        dst - src\n101\t    }\n102\t}\n103\t\n104\t#[inline(always)]\n105\tfn ss_mul(dst: f32, src: f32) -> f32 {\n106\t    if dst.is_nan() {\n107\t        quiet_nan(dst)\n108\t    } else if src.is_nan() {\n109\t        quiet_nan(src)\n110\t    } else {\n111\t        dst * src\n112\t    }\n113\t}\n114\t\n115\t#[inline(always)]\n116\tfn ss_div(dst: f32, src: f32) -> f32 {\n117\t    if dst.is_nan() {\n118\t        quiet_nan(dst)\n119\t    } else if src.is_nan() {\n120\t        quiet_nan(src)\n121\t    } else {\n122\t        dst / src\n123\t    }\n124\t}\n125\t\n126\t// ---------------------------------------------------------------------------\n127\t// C2 types\n128\t// ---------------------------------------------------------------------------\n129\t\n130\t/// `typedef enum { C2_TYPE_CIRCLE, C2_TYPE_AABB } C2_TYPE;`\n131\tpub const C2_TYPE_CIRCLE: c_int = 0;\n132\t/// `typedef enum { C2_TYPE_CIRCLE, C2_TYPE_AABB } C2_TYPE;`\n133\tpub const C2_TYPE_AABB: c_int = 1;\n134\t\n135\t/// `typedef struct c2v { float x; float y; } c2v;`\n136\t#[repr(C)]\n137\t#[derive(Copy, Clone)]\n138\tpub struct c2v {\n139\t    pub x: f32,\n140\t    pub y: f32,\n141\t}\n142\t\n143\t/// `typedef struct c2Circle { c2v p; float r; } c2Circle;`\n144\t#[repr(C)]\n145\t#[derive(Copy, Clone)]\n146\tpub struct c2Circle {\n147\t    pub p: c2v,\n148\t    pub r: f32,\n149\t}\n150\t\n151\t/// `typedef struct c2AABB { c2v min; c2v max; } c2AABB;`\n152\t#[repr(C)]\n153\t#[derive(Copy, Clone)]\n154\tpub struct c2AABB {\n155\t    pub min: c2v,\n156\t    pub max: c2v,\n157\t}\n158\t\n159\t// ---------------------------------------------------------------------------\n160\t// c2 vector helpers (public in C, hence exported)\n161\t// ---------------------------------------------------------------------------\n162\t\n163\t#[unsafe(no_mangle)]\n164\tpub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n165\t    let mut a = c2v { x: 0.0, y: 0.0 };\n166\t    a.x = x;\n167\t    a.y = y;\n168\t    a\n169\t}\n170\t\n171\t#[unsafe(no_mangle)]\n172\tpub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n173\t    c2V(\n174\t        if a.x > b.x { a.x } else { b.x },\n175\t        if a.y > b.y { a.y } else { b.y },\n176\t    )\n177\t}\n178\t\n179\t#[unsafe(no_mangle)]\n180\tpub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n181\t    c2V(\n182\t        if a.x < b.x { a.x } else { b.x },\n183\t        if a.y < b.y { a.y } else { b.y },\n184\t    )\n185\t}\n186\t\n187\t#[unsafe(no_mangle)]\n188\tpub extern \"C\" fn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n189\t    c2Maxv(lo, c2Minv(a, hi))\n190\t}\n191\t\n192\t#[unsafe(no_mangle)]\n193\tpub extern \"C\" fn c2Sub(a: c2v, b: c2v) -> c2v {\n194\t    let mut a = a;\n195\t    a.x = ss_sub(a.x, b.x);\n196\t    a.y = ss_sub(a.y, b.y);\n197\t    a\n198\t}\n199\t\n200\t#[unsafe(no_mangle)]\n201\tpub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n202\t    // `a.x * b.x + a.y * b.y`.  gcc evaluates the second product first into the\n203\t    // accumulator, so the emitted code is `mulss` with dst = b.y and the final\n204\t    // `addss` with dst = the y term.  Reproduced here so that NaN propagation\n205\t    // (which operand's payload survives) is identical.\n206\t    let xterm = ss_mul(a.x, b.x);\n207\t    let yterm = ss_mul(b.y, a.y);\n208\t    ss_add(yterm, xterm)\n209\t}\n210\t\n211\t#[unsafe(no_mangle)]\n212\tpub extern \"C\" fn c2CircletoCircle(A: c2Circle, B: c2Circle) -> c_int {\n213\t    let c = c2Sub(B.p, A.p);\n214\t    let d2 = c2Dot(c, c);\n215\t    let mut r2 = ss_add(A.r, B.r);\n216\t    r2 = ss_mul(r2, r2);\n217\t    (d2 < r2) as c_int\n218\t}\n219\t\n220\t#[unsafe(no_mangle)]\n221\tpub extern \"C\" fn c2CircletoAABB(A: c2Circle, B: c2AABB) -> c_int {\n222\t    let L = c2Clampv(A.p, B.min, B.max);\n223\t    let ab = c2Sub(A.p, L);\n224\t    let d2 = c2Dot(ab, ab);\n225\t    let r2 = ss_mul(A.r, A.r);\n226\t    (d2 < r2) as c_int\n227\t}\n228\t\n229\t#[unsafe(no_mangle)]\n230\tpub extern \"C\" fn c2AABBtoAABB(A: c2AABB, B: c2AABB) -> c_int {\n231\t    let d0 = (B.max.x < A.min.x) as c_int;\n232\t    let d1 = (A.max.x < B.min.x) as c_int;\n233\t    let d2 = (B.max.y < A.min.y) as c_int;\n234\t    let d3 = (A.max.y < B.min.y) as c_int;\n235\t    ((d0 | d1 | d2 | d3) == 0) as c_int\n236\t}\n237\t\n238\t// ---------------------------------------------------------------------------\n239\t// f2 — collision dispatch\n240\t// ---------------------------------------------------------------------------\n241\t\n242\t#[unsafe(no_mangle)]\n243\tpub unsafe extern \"C\" fn f2(\n244\t    A: *const c_void,\n245\t    typeA: c_int,\n246\t    B: *const c_void,\n247\t    typeB: c_int,\n248\t) -> c_int {\n249\t    unsafe {\n250\t        match typeA {\n251\t            C2_TYPE_CIRCLE => match typeB {\n252\t                C2_TYPE_CIRCLE => c2CircletoCircle(\n253\t                    core::ptr::read_unaligned(A as *const c2Circle),\n254\t                    core::ptr::read_unaligned(B as *const c2Circle),\n255\t                ),\n256\t                C2_TYPE_AABB => c2CircletoAABB(\n257\t                    core::ptr::read_unaligned(A as *const c2Circle),\n258\t                    core::ptr::read_unaligned(B as *const c2AABB),\n259\t                ),\n260\t                _ => 0,\n261\t            },\n262\t            C2_TYPE_AABB => match typeB {\n263\t                C2_TYPE_CIRCLE => c2CircletoAABB(\n264\t                    core::ptr::read_unaligned(B as *const c2Circle),\n265\t                    core::ptr::read_unaligned(A as *const c2AABB),\n266\t                ),\n267\t                C2_TYPE_AABB => c2AABBtoAABB(\n268\t                    core::ptr::read_unaligned(A as *const c2AABB),\n269\t                    core::ptr::read_unaligned(B as *const c2AABB),\n270\t                ),\n271\t                _ => 0,\n272\t            },\n273\t            _ => 0,\n274\t        }\n275\t    }\n276\t}\n277\t\n278\t// ---------------------------------------------------------------------------\n279\t// f3 — floor division\n280\t// ---------------------------------------------------------------------------\n281\t\n282\t#[unsafe(no_mangle)]\n283\tpub extern \"C\" fn f3(v1: c_int, v2: c_int) -> c_int {\n284\t    if v2 == 0 {\n285\t        return 0;\n286\t    }\n287\t    let q: c_int;\n288\t    let r: c_int;\n289\t    if v1 >= 0 {\n290\t        if v2 >= 0 {\n291\t            return v1.wrapping_div(v2);\n292\t        } else if v2 != C_INT_MIN {\n293\t            q = v1.wrapping_div(v2.wrapping_neg()).wrapping_neg();\n294\t            r = v1.wrapping_rem(v2.wrapping_neg());\n295\t        } else {\n296\t            q = 0;\n297\t            r = v1;\n298\t        }\n299\t    } else if v1 != C_INT_MIN {\n300\t        if v2 >= 0 {\n301\t            q = v1.wrapping_neg().wrapping_div(v2).wrapping_neg();\n302\t            r = v1.wrapping_neg().wrapping_rem(v2).wrapping_neg();\n303\t        } else if v2 != C_INT_MIN {\n304\t            q = v1.wrapping_neg().wrapping_div(v2.wrapping_neg());\n305\t            r = v1\n306\t                .wrapping_neg()\n307\t                .wrapping_rem(v2.wrapping_neg())\n308\t                .wrapping_neg();\n309\t        } else {\n310\t            q = 1;\n311\t            r = v1.wrapping_sub(q.wrapping_mul(v2));\n312\t        }\n313\t    } else if v2 >= 0 {\n314\t        q = v1\n315\t            .wrapping_add(v2)\n316\t            .wrapping_neg()\n317\t            .wrapping_div(v2)\n318\t            .wrapping_neg()\n319\t            .wrapping_sub(1);\n320\t        r = v1\n321\t            .wrapping_add(v2)\n322\t            .wrapping_neg()\n323\t            .wrapping_rem(v2)\n324\t            .wrapping_neg();\n325\t    } else if v2 != C_INT_MIN {\n326\t        q = v1\n327\t            .wrapping_sub(v2)\n328\t            .wrapping_neg()\n329\t            .wrapping_div(v2.wrapping_neg())\n330\t            .wrapping_add(1);\n331\t        r = v1\n332\t            .wrapping_sub(v2)\n333\t            .wrapping_neg()\n334\t            .wrapping_rem(v2.wrapping_neg())\n335\t            .wrapping_neg();\n336\t    } else {\n337\t        q = 1;\n338\t        r = 0;\n339\t    }\n340\t    if r >= 0 {\n341\t        q\n342\t    } else {\n343\t        q.wrapping_add(if v2 > 0 { -1 } else { 1 })\n344\t    }\n345\t}\n346\t\n347\t// ---------------------------------------------------------------------------\n348\t// f4 — xorshift128+ derived double in [0, 1)\n349\t// ---------------------------------------------------------------------------\n350\t\n351\t/// `typedef struct cn_rnd_t { uint64_t state[2]; } cn_rnd_t;`\n352\t#[repr(C)]\n353\t#[derive(Copy, Clone)]\n354\tpub struct cn_rnd_t {\n355\t    pub state: [u64; 2],\n356\t}\n357\t\n358\tfn cn_rnd_next(rnd: &mut cn_rnd_t) -> u64 {\n359\t    let mut x = rnd.state[0];\n360\t    let y = rnd.state[1];\n361\t    rnd.state[0] = y;\n362\t    x ^= x << 23;\n363\t    x ^= x >> 17;\n364\t    x ^= y ^ (y >> 26);\n365\t    rnd.state[1] = x;\n366\t    x.wrapping_add(y)\n367\t}\n368\t\n369\t#[unsafe(no_mangle)]\n370\tpub unsafe extern \"C\" fn f4(rnd: *mut cn_rnd_t) -> f64 {\n371\t    let value = cn_rnd_next(unsafe { &mut *rnd });\n372\t    let exponent: u64 = 1023;\n373\t    let mantissa: u64 = value >> 12;\n374\t    let result: u64 = (exponent << 52) | mantissa;\n375\t    f64::from_bits(result) - 1.0\n376\t}\n377\t\n378\t// ---------------------------------------------------------------------------\n379\t// f5 — 16-bit reverse\n380\t// ---------------------------------------------------------------------------\n381\t\n382\t#[unsafe(no_mangle)]\n383\tpub extern \"C\" fn f5(a: u32) -> u32 {\n384\t    let mut a = a;\n385\t    a = ((a & 0xAAAA) >> 1) | ((a & 0x5555) << 1);\n386\t    a = ((a & 0xCCCC) >> 2) | ((a & 0x3333) << 2);\n387\t    a = ((a & 0xF0F0) >> 4) | ((a & 0x0F0F) << 4);\n388\t    a = ((a & 0xFF00) >> 8) | ((a & 0x00FF) << 8);\n389\t    a\n390\t}\n391\t\n392\t// ---------------------------------------------------------------------------\n393\t// tflac\n394\t// ---------------------------------------------------------------------------\n395\t\n396\t/// `typedef uint8_t tflac_u8;`\n397\tpub type tflac_u8 = u8;\n398\t/// `typedef uint16_t tflac_u16;`\n399\tpub type tflac_u16 = u16;\n400\t/// `typedef uint32_t tflac_u32;`\n401\tpub type tflac_u32 = u32;\n402\t\n403\t#[unsafe(no_mangle)]\n404\tpub extern \"C\" fn f7(blocksize: tflac_u32, channels: tflac_u32, bitdepth: tflac_u32) -> tflac_u32 {\n405\t    let ne2 = (channels != 2) as tflac_u32;\n406\t    let eq2 = (channels == 2) as tflac_u32;\n407\t    let bd_ne32 = (bitdepth != 32) as tflac_u32;\n408\t\n409\t    let t1 = blocksize\n410\t        .wrapping_mul(bitdepth)\n411\t        .wrapping_mul(channels.wrapping_mul(ne2));\n412\t    let t2 = blocksize.wrapping_mul(bitdepth).wrapping_mul(eq2);\n413\t    let t3 = blocksize\n414\t        .wrapping_mul(bitdepth.wrapping_add(bd_ne32))\n415\t        .wrapping_mul(eq2);\n416\t\n417\t    18u32\n418\t        .wrapping_add(channels)\n419\t        .wrapping_add(\n420\t            t1.wrapping_add(t2)\n421\t                .wrapping_add(t3)\n422\t                .wrapping_add(7)\n423\t                / 8,\n424\t        )\n425\t}\n426\t\n427\t// ---------------------------------------------------------------------------\n428\t// lightmapper — barycentric coordinates\n429\t// ---------------------------------------------------------------------------\n430\t\n431\t/// `typedef struct lm_vec2 { float x, y; } lm_vec2;`\n432\t#[repr(C)]\n433\t#[derive(Copy, Clone)]\n434\tpub struct lm_vec2 {\n435\t    pub x: f32,\n436\t    pub y: f32,\n437\t}\n438\t\n439\tfn lm_v2(x: f32, y: f32) -> lm_vec2 {\n440\t    lm_vec2 { x, y }\n441\t}\n442\t\n443\tfn lm_sub2(a: lm_vec2, b: lm_vec2) -> lm_vec2 {\n444\t    lm_v2(ss_sub(a.x, b.x), ss_sub(a.y, b.y))\n445\t}\n446\t\n447\tfn lm_dot2(a: lm_vec2, b: lm_vec2) -> f32 {\n448\t    // Same operand ordering as `c2Dot` (identical C expression, identical\n449\t    // gcc codegen).\n450\t    let xterm = ss_mul(a.x, b.x);\n451\t    let yterm = ss_mul(b.y, a.y);\n452\t    ss_add(yterm, xterm)\n453\t}\n454\t\n455\t#[unsafe(no_mangle)]\n456\tpub extern \"C\" fn f9(p1: lm_vec2, p2: lm_vec2, p3: lm_vec2, p: lm_vec2) -> lm_vec2 {\n457\t    let v0 = lm_sub2(p3, p1);\n458\t    let v1 = lm_sub2(p2, p1);\n459\t    let v2 = lm_sub2(p, p1);\n460\t    let dot00 = lm_dot2(v0, v0);\n461\t    let dot01 = lm_dot2(v0, v1);\n462\t    let dot02 = lm_dot2(v0, v2);\n463\t    let dot11 = lm_dot2(v1, v1);\n464\t    let dot12 = lm_dot2(v1, v2);\n465\t    let invDenom = ss_div(\n466\t        1.0f32,\n467\t        ss_sub(ss_mul(dot00, dot11), ss_mul(dot01, dot01)),\n468\t    );\n469\t    let u = ss_mul(ss_sub(ss_mul(dot11, dot02), ss_mul(dot01, dot12)), invDenom);\n470\t    let v = ss_mul(ss_sub(ss_mul(dot00, dot12), ss_mul(dot01, dot02)), invDenom);\n471\t    lm_v2(u, v)\n472\t}\n473\t\n474\t// ---------------------------------------------------------------------------\n475\t// f10 — half-float to float\n476\t// ---------------------------------------------------------------------------\n477\t\n478\t#[unsafe(no_mangle)]\n479\tpub extern \"C\" fn f10(h: u16) -> f32 {\n480\t    let n = (h >> 10) as usize;\n481\t    let num = M_MANTISSA[((h & 0x3ff) as usize) + (M_OFFSET[n] as usize)]\n482\t        .wrapping_add(M_EXPONENT[n]);\n483\t    f32::from_bits(num)\n484\t}\n485\t\n486\t// ---------------------------------------------------------------------------\n487\t// f11 — HSL to RGB\n488\t// ---------------------------------------------------------------------------\n489\t\n490\t#[unsafe(no_mangle)]\n491\tpub unsafe extern \"C\" fn f11(dest: *mut f32, src: *const f32) {\n492\t    unsafe {\n493\t        let h = *src.add(0);\n494\t        let s = *src.add(1);\n495\t        let l = *src.add(2);\n496\t        let c: f32;\n497\t        let m: f32;\n498\t        let x: f32;\n499\t        if s == 0.0 {\n500\t            *dest.add(0) = l;\n501\t            *dest.add(1) = l;\n502\t            *dest.add(2) = l;\n503\t            return;\n504\t        }\n505\t        c = ss_mul(\n506\t            ss_sub(1.0f32, fabsf(ss_sub(ss_mul(2.0f32, l), 1.0f32))),\n507\t            s,