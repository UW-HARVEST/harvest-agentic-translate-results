  }\n553\t}\n554\t\n555\t// ---------------------------------------------------------------------------\n556\t// f12 — HSV to RGB\n557\t// ---------------------------------------------------------------------------\n558\t\n559\t#[unsafe(no_mangle)]\n560\tpub unsafe extern \"C\" fn f12(dest: *mut f32, src: *const f32) {\n561\t    unsafe {\n562\t        let r: f32;\n563\t        let g: f32;\n564\t        let b: f32;\n565\t        let f: f32;\n566\t        let p: f32;\n567\t        let q: f32;\n568\t        let t: f32;\n569\t        let mut h = *src.add(0);\n570\t        let s = *src.add(1);\n571\t        let v = *src.add(2);\n572\t        let i: c_int;\n573\t        if s == 0.0 {\n574\t            *dest.add(0) = v;\n575\t            *dest.add(1) = v;\n576\t            *dest.add(2) = v;\n577\t            return;\n578\t        }\n579\t        h = ss_div(h, 60.0f32);\n580\t        i = c_float_to_int(floorf(h));\n581\t        f = ss_sub(h, i as f32);\n582\t        // As in f11, gcc emits `mulss` with the parenthesised sub-expression\n583\t        // as the destination operand.\n584\t        p = ss_mul(ss_sub(1.0f32, s), v);\n585\t        q = ss_mul(ss_sub(1.0f32, ss_mul(s, f)), v);\n586\t        t = ss_mul(ss_sub(1.0f32, ss_mul(s, ss_sub(1.0f32, f))), v);\n587\t        match i {\n588\t            0 => {\n589\t                r = v;\n590\t                g = t;\n591\t                b = p;\n592\t            }\n593\t            1 => {\n594\t                r = q;\n595\t                g = v;\n596\t                b = p;\n597\t            }\n598\t            2 => {\n599\t                r = p;\n600\t                g = v;\n601\t                b = t;\n602\t            }\n603\t            3 => {\n604\t                r = p;\n605\t                g = q;\n606\t                b = v;\n607\t            }\n608\t            4 => {\n609\t                r = t;\n610\t                g = p;\n611\t                b = v;\n612\t            }\n613\t            _ => {\n614\t                r = v;\n615\t                g = p;\n616\t                b = q;\n617\t            }\n618\t        }\n619\t        *dest.add(0) = r;\n620\t        *dest.add(1) = g;\n621\t        *dest.add(2) = b;\n622\t    }\n623\t}\n624\t\n625\t// ---------------------------------------------------------------------------\n626\t// f13 — RGB to HSV\n627\t// ---------------------------------------------------------------------------\n628\t\n629\t#[unsafe(no_mangle)]\n630\tpub unsafe extern \"C\" fn f13(dest: *mut f32, src: *const f32) {\n631\t    unsafe {\n632\t        let r = *src.add(0);\n633\t        let g = *src.add(1);\n634\t        let b = *src.add(2);\n635\t        let mut h: f32 = 0.0;\n636\t        let mut s: f32 = 0.0;\n637\t        let v: f32;\n638\t        let mut min = r;\n639\t        let mut max = r;\n640\t        let delta: f32;\n641\t        min = if min < g { min } else { g };\n642\t        min = if min < b { min } else { b };\n643\t        max = if max > g { max } else { g };\n644\t        max = if max > b { max } else { b };\n645\t        delta = ss_sub(max, min);\n646\t        v = max;\n647\t        if delta == 0.0 || max == 0.0 {\n648\t            *dest.add(0) = h;\n649\t            *dest.add(1) = s;\n650\t            *dest.add(2) = v;\n651\t            return;\n652\t        }\n653\t        s = ss_div(delta, max);\n654\t        if r == max {\n655\t            h = ss_div(ss_sub(g, b), delta);\n656\t        } else if g == max {\n657\t            h = ss_add(2.0f32, ss_div(ss_sub(b, r), delta));\n658\t        } else {\n659\t            h = ss_add(4.0f32, ss_div(ss_sub(r, g), delta));\n660\t        }\n661\t        h = ss_mul(h, 60.0f32);\n662\t        if h < 0.0 {\n663\t            h = ss_add(h, 360.0f32);\n664\t        }\n665\t        *dest.add(0) = h;\n666\t        *dest.add(1) = s;\n667\t        *dest.add(2) = v;\n668\t    }\n669\t}\n670\t\n671\t// ---------------------------------------------------------------------------\n672\t// agglom — the aggregate entry p