boundary(&t, &t, bins, &format!(\"row45 identical shape={shape:?}\"));\n            }\n        }\n    }\n}\n\n#[test]\nfn cfg_row45b_match_boundary_scaled_copies() {\n    // The realistic case: same spectrum at a different gain. The boundary is\n    // then the contrast itself (the gate ratio is far away), so this compares\n    // the internal `spectral_contrast` result to the last bit.\n    for bins in [2, 3, 16, 17, 33, 64, 257] {\n        for k in 0..32u64 {\n            let mut rng = Rng::new(0x45B0 ^ (bins as u64) << 24 ^ k);\n            let r = gen_f64_bits(F64Shape::Peaked, bins as usize, &mut rng);\n            for scale in [1.0f64, 0.5, 2.0, 8.0, 1.0e6] {\n                let t: Vec<u64> =\n                    r.iter().map(|&x| (f64::from_bits(x) * scale).to_bits()).collect();\n                diff_match_boundary(&t, &r, bins, &format!(\"row45b scale={scale}\"));\n            }\n        }\n    }\n}\n\n// ===========================================================================\n// Rows 41-44: NaN *payload* propagation order."}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1591,"cache_read_input_tokens":163981,"cache_creation":{"ephemeral_5m_input_tokens":1591,"ephemeral_1h_input_tokens":0},"output_tokens":21,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"e16882f1-1517-4c47-9de0-01acc9cd491e","uuid":"747eb967-5961-4d75-be66-8f1ffe8764a4","timestamp":"2026-08-20T16:55:36.920Z"}
