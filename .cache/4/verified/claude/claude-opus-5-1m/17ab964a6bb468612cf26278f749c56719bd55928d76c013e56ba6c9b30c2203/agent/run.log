NT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    24\t */\n    25\t\n    26\t//! Translation of `c_src/src/matrix.c`.\n    27\t\n    28\t#![allow(non_camel_case_types)]\n    29\t\n    30\tuse core::ffi::{c_char, c_int, c_void};\n    31\tuse core::mem::size_of;\n    32\tuse core::ptr;\n    33\t\n    34\tuse crate::cffi::{\n    35\t    atoi, fprintf, free, int_to_size, malloc, perror, snprintf, stderr_stream, strcat, strdup,\n    36\t    strtok_r,\n    37\t};\n    38\t\n    39\t/// Mirror of the `matrix_t` type declared in `include/matrix.h`.\n    40\t///\n    41\t/// ```c\n    42\t/// typedef struct {\n    43\t///     int** matrix;\n    44\t///     int width;\n    45\t///     int height;\n    46\t/// } matrix_t;\n    47\t/// ```\n    48\t#[repr(C)]\n    49\tpub struct matrix_t {\n    50\t    pub matrix: *mut *mut c_int,\n    51\t    pub width: c_int,\n    52\t    pub height: c_int,\n    53\t}\n    54\t\n    55\t/// `mat->matrix[i]` – the pointer to row `i`.\n    56\t#[inline]\n    57\tunsafe fn row_ptr(mat: *mut matrix_t, i: c_int) -> *mut c_int {\n    58\t    unsafe { *(*mat).matrix.offset(i as isize) }\n    59\t}\n    60\t\n    61\t/// `&mat->matrix[i]` – the slot holding the pointer to row `i`.\n    62\t#[inline]\n    63\tunsafe fn row_slot(mat: *mut matrix_t, i: c_int) -> *mut *mut c_int {\n    64\t    unsafe { (*mat).matrix.offset(i as isize) }\n    65\t}\n    66\t\n    67\t/// `&mat->matrix[i][j]` – the element at row `i`, column `j`.\n    68\t#[inline]\n    69\tunsafe fn elem_ptr(mat: *mut matrix_t, i: c_int, j: c_int) -> *mut c_int {\n    70\t    unsafe { row_ptr(mat, i).offset(j as isize) }\n    71\t}\n    72\t\n    73\t#[unsafe(no_mangle)]\n    74\tpub unsafe extern \"C\" fn allocate_matrix(width: c_int, height: c_int) -> *mut matrix_t {\n    75\t    unsafe {\n    76\t        let mat = malloc(size_of::<matrix_t>() as u64) as *mut matrix_t;\n    77\t        if mat.is_null() {\n    78\t            perror(c\"Failed to allocate memory for matrix struct\".as_ptr());\n    79\t            return ptr::null_mut();\n    80\t        }\n    81\t\n    82\t        (*mat).width = width;\n    83\t        (*mat).height = height;\n    84\t\n    85\t        (*mat).matrix = malloc(\n    86\t            int_to_size(height).wrapping_mul(size_of::<*mut c_int>() as u64),\n    87\t        ) as *mut *mut c_int;\n    88\t        if (*mat).matrix.is_null() {\n    89\t            perror(c\"Failed to allocate memory for matrix rows\".as_ptr());\n    90\t            free(mat as *mut c_void);\n    91\t            return ptr::null_mut();\n    92\t        }\n    93\t\n    94\t        let mut i: c_int = 0;\n    95\t        while i < height {\n    96\t            *row_slot(mat, i) =\n    97\t                malloc(int_to_size(width).wrapping_mul(size_of::<c_int>() as u64)) as *mut c_int;\n    98\t            if row_ptr(mat, i).is_null() {\n    99\t                perror(c\"Failed to allocate memory for matrix columns\".as_ptr());\n   100\t                let mut j: c_int = 0;\n   101\t                while j <= i {\n   102\t                    free(row_ptr(mat, j) as *mut c_void);\n   103\t                    j += 1;\n   104\t                }\n   105\t                free((*mat).matrix as *mut c_void);\n   106\t                free(mat as *mut c_void);\n   107\t                return ptr::null_mut();\n   108\t            }\n   109\t            i += 1;\n   110\t        }\n   111\t\n   112\t        mat\n   113\t    }\n   114\t}\n   115\t\n   116\t#[unsafe(no_mangle)]\n   117\tpub unsafe extern \"C\" fn free_matrix(mat: *mut matrix_t) {\n   118\t    unsafe {\n   119\t        if mat.is_null() {\n   120\t            return;\n   121\t        }\n   122\t\n   123\t        let mut i: c_int = 0;\n   124\t        while i < (*mat).height {\n   125\t            free(row_ptr(mat, i) as *mut c_void);\n   126\t            i += 1;\n   127\t        }\n   128\t        free((*mat).matrix as *mut c_void);\n   129\t        free(mat as *mut c_void);\n   130\t    }\n   131\t}\n   132\t\n   133\t#[unsafe(no_mangle)]\n   134\tpub unsafe extern \"C\" fn initialize_matrix_from_string(\n   135\t    input: *const c_char,\n   136\t    width: c_int,\n   137\t    height: c_int,\n   138\t) -> *mut matrix_t {\n   139\t    unsafe {\n   140\t        let mat = allocate_matrix(width, height);\n   141\t\n   142\t        let input_copy = strdup(input);\n   143\t        if input_copy.is_null() {\n   144\t            perror(c\"Failed to duplicate input string\".as_ptr());\n   145\t            free_matrix(mat);\n   146\t            return ptr::null_mut();\n   147\t        }\n   148\t\n   149\t        let mut saveptr_row: *mut c_char = ptr::null_mut();\n   150\t        let mut row_token = strtok_r(input_copy, c\"\\n\".as_ptr(), &mut saveptr_row);\n   151\t        let mut i: c_int = 0;\n   152\t        while i < height {\n   153\t            if row_token.is_null() {\n   154\t                fprintf(\n   155\t                    stderr_stream(),\n   156\t                    c\"Insufficient rows in input string.\\n\".as_ptr(),\n   157\t                );\n   158\t                free(input_copy as *mut c_void);\n   159\t                free_matrix(mat);\n   160\t                return ptr::null_mut();\n   161\t            }\n   162\t\n   163\t            let mut saveptr_col: *mut c_char = ptr::null_mut();\n   164\t            let mut col_token = strtok_r(row_token, c\" \".as_ptr(), &mut saveptr_col);\n   165\t            let mut j: c_int = 0;\n   166\t            while j < width {\n   167\t                if col_token.is_null() {\n   168\t                    fprintf(\n   169\t                        stderr_stream(),\n   170\t                        c\"Insufficient columns in row %d.\\n\".as_ptr(),\n   171\t                        i + 1,\n   172\t                    );\n   173\t                    free(input_copy as *mut c_void);\n   174\t                    free_matrix(mat);\n   175\t                    return ptr::null_mut();\n   176\t                }\n   177\t                *elem_ptr(mat, i, j) = atoi(col_token);\n   178\t                col_token = strtok_r(ptr::null_mut(), c\" \".as_ptr(), &mut saveptr_col);\n   179\t                j += 1;\n   180\t            }\n   181\t\n   182\t            row_token = strtok_r(ptr::null_mut(), c\"\\n\".as_ptr(), &mut saveptr_row);\n   183\t            i += 1;\n   184\t        }\n   185\t\n   186\t        free(input_copy as *mut c_void);\n   187\t        mat\n   188\t    }\n   189\t}\n   190\t\n   191\t#[unsafe(no_mangle)]\n   192\tpub unsafe extern \"C\" fn multiply_matrices(\n   193\t    mat_a: *mut matrix_t,\n   194\t    mat_b: *mut matrix_t,\n   195\t) -> *mut matrix_t {\n   196\t    unsafe {\n   197\t        if (*mat_a).width != (*mat_b).height {\n   198\t            fprintf(\n   199\t                stderr_stream(),\n   200\t                c\"Matrix dimensions do not allow multiplication.\\n\".as_ptr(),\n   201\t            );\n   202\t            return ptr::null_mut();\n   203\t        }\n   204\t\n   205\t        let result = allocate_matrix((*mat_b).width, (*mat_a).height);\n   206\t        let mut i: c_int = 0;\n   207\t        while i < (*mat_a).height {\n   208\t            let mut j: c_int = 0;\n   209\t            while j < (*mat_b).width {\n   210\t                *elem_ptr(result, i, j) = 0;\n   211\t                let mut k: c_int = 0;\n   212\t                while k < (*mat_a).width {\n   213\t                    let product =\n   214\t                        (*elem_ptr(mat_a, i, k)).wrapping_mul(*elem_ptr(mat_b, k, j));\n   215\t                    let slot = elem_ptr(result, i, j);\n   216\t                    *slot = (*slot).wrapping_add(product);\n   217\t                    k += 1;\n   218\t                }\n   219\t                j += 1;\n   220\t            }\n   221\t            i += 1;\n   222\t        }\n   223\t\n   224\t        result\n   225\t    }\n   226\t}\n   227\t\n   228\t#[unsafe(no_mangle)]\n   229\tpub unsafe extern \"C\" fn matrix_to_string(mat: *mut matrix_t) -> *mut c_char {\n   230\t    unsafe {\n   231\t        if mat.is_null() {\n   232\t            fprintf(stderr_stream(), c\"Error: Matrix is NULL.\\n\".as_ptr());\n   233\t            return ptr::null_mut();\n   234\t        }\n   235\t\n   236\t        let width = (*mat).width;\n   237\t        let height = (*mat).height;\n   238\t\n   239\t        // int buffer_size = mat->height * (mat->width * 10 + mat->width)\n   240\t        //                   + mat->height + 1;\n   241\t        let buffer_size: c_int = height\n   242\t            .wrapping_mul(width.wrapping_mul(10).wrapping_add(width))\n   243\t            .wrapping_add(height)\n   244\t            .wrapping_add(1);\n   245\t\n   246\t        let result = malloc(int_to_size(buffer_size)) as *mut c_char;\n   247\t        if result.is_null() {\n   248\t            perror(c\"Failed to allocate memory for matrix string\".as_ptr());\n   249\t            return ptr::null_mut();\n   250\t        }\n   251\t\n   252\t        *result = 0;\n   253\t\n   254\t        let mut i: c_int = 0;\n   255\t        while i < height {\n   256\t            let mut j: c_int = 0;\n   257\t            while j < width {\n   258\t                let mut buffer = [0 as c_char; 12];\n   259\t                snprintf(\n   260\t                    buffer.as_mut_ptr(),\n   261\t                    buffer.len() as u64,\n   262\t                    c\"%d\".as_ptr(),\n   263\t                    *elem_ptr(mat, i, j),\n   264\t                );\n   265\t                strcat(result, buffer.as_ptr());\n   266\t\n   267\t                if j < width.wrapping_sub(1) {\n   268\t                    strcat(result, c\" \".as_ptr());\n   269\t                }\n   270\t                j += 1;\n   271\t            }\n   272\t            strcat(result, c\"\\n\".as_ptr());\n   273\t            i += 1;\n   274\t        }\n   275\t\n   276\t        result\n   277\t    }\n   278\t}\n===== src/write.rs =====\n     1\t/*\n     2\t * Copyright 2025 MIT Lincoln Laboratory\n     3\t * Permission is hereby granted, free of charge,\n     4\t * to any person obtaining a copy of this software\n     5\t * and associated documentation files (the \"Software\"),\n     6\t * to deal in the Software without restriction,\n     7\t * including without limitation the rights to use, copy,\n     8\t * modify, merge, publish, distribute, sublicense,\n     9\t * and/or sell copies of the Software,\n    10\t * and to permit persons to whom the Software is furnished to do so,\n    11\t * subject to the following conditions:\n    12\t *\n    13\t * The above copyright notice and this permission notice\n    14\t * shall be included in all copies or substantial portions of the Software.\n    15\t *\n    16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    18\t * THE WARRANTIES OF MERCHANTABILITY,\n    19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    24\t */\n    25\t\n    26\t//! Translation of `c_src/src/write.c`.\n    27\t\n    28\tuse core::ffi::{c_char, c_int};\n    29\t\n    30\tuse crate::cffi::{\n    31\t    errno, fclose, fopen, fprintf, stderr_stream, strerror, EINVAL,\n    32\t};\n    33\t\n    34\t#[unsafe(no_mangle)]\n    35\tpub unsafe extern \"C\" fn write_to_file(filename: *const c_char, content: *const c_char) -> c_int {\n    36\t    unsafe {\n    37\t        if content.is_null() {\n    38\t            fprintf(stderr_stream(), c\"Error: Content is NULL.\\n\".as_ptr());\n    39\t            return EINVAL;\n    40\t        }\n    41\t\n    42\t        let file = fopen(filename, c\"w\".as_ptr());\n    43\t        if file.is_null() {\n    44\t            fprintf(\n    45\t                stderr_stream(),\n    46\t                c\"Error opening file '%s': %s\\n\".as_ptr(),\n    47\t                filename,\n    48\t                strerror(errno()),\n    49\t            );\n    50\t            return errno();\n    51\t        }\n    52\t\n    53\t        if fprintf(file, c\"%s\".as_ptr(), content) < 0 {\n    54\t            fprintf(\n    55\t                stderr_stream(),\n    56\t                c\"Error writing to file '%s': %s\\n\".as_ptr(),\n    57\t                filename,\n    58\t                strerror(errno()),\n    59\t            );\n    60\t            fclose(file);\n    61\t            return errno();\n    62\t        }\n    63\t\n    64\t        if fclose(file) != 0 {\n    65\t            fprintf(\n    66\t                stderr_stream(),\n    67\t                c\"Error closing file '%s': %s\\n\".as_ptr(),\n    68\t                filename,\n    69\t                strerror(errno()),\n    70\t            );\n    71\t            return errno();\n    72\t        }\n    73\t\n    74\t        0\n    75\t    }\n    76\t}\n===== src/driver.rs =====\n     1\t/*\n     2\t * Copyright 2025 MIT Lincoln Laboratory\n     3\t * Permission is hereby granted, free of charge,\n     4\t * to any person obtaining a copy of this software\n     5\t * and associated documentation files (the \"Software\"),\n     6\t * to deal in the Software without restriction,\n     7\t * including without limitation the rights to use, copy,\n     8\t * modify, merge, publish, distribute, sublicense,\n     9\t * and/or sell copies of the Software,\n    10\t * and to permit persons to whom the Software is furnished to do so,\n    11\t * subject to the following conditions:\n    12\t *\n    13\t * The above copyright notice and this permission notice\n    14\t * shall be included in all copies or substantial portions of the Software.\n    15\t *\n    16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    18\t * THE WARRANTIES OF MERCHANTABILITY,\n    19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    24\t */\n    25\t\n    26\t//! Translation of `c_src/src/driver.c`.\n    27\t\n    28\tuse core::ffi::{c_char, c_int, c_void};\n    29\t\n    30\tuse crate::cffi::{free, EXIT_FAILURE, EXIT_SUCCESS};\n    31\tuse crate::matrix::{free_matrix, initialize_matrix_from_string, matrix_to_string, multiply_matrices};\n    32\tuse crate::write::write_to_file;\n    33\t\n    34\t/// `#define OUT_FILE \"matrix.txt\"`\n    35\tconst OUT_FILE: &core::ffi::CStr = c\"matrix.txt\";\n    36\t\n    37\t#[unsafe(no_mangle)]\n    38\tpub unsafe extern \"C\" fn driver(\n    39\t    width_a: c_int,\n    40\t    height_a: c_int,\n    41\t    matrix_a: *const c_char,\n    42\t    width_b: c_int,\n    43\t    height_b: c_int,\n    44\t    matrix_b: *const c_char,\n    45\t) -> c_int {\n    46\t    unsafe {\n    47\t        let mat_a = initialize_matrix_from_string(matrix_a, width_a, height_a);\n    48\t        if mat_a.is_null() {\n    49\t            return EXIT_FAILURE;\n    50\t        }\n    51\t        let mat_b = initialize_matrix_from_string(matrix_b, width_b, height_b);\n    52\t        if mat_b.is_null() {\n    53\t            free_matrix(mat_a);\n    54\t            return EXIT_FAILURE;\n    55\t        }\n    56\t\n    57\t        let res = multiply_matrices(mat_a, mat_b);\n    58\t        if res.is_null() {\n    59\t            free_matrix(mat_a);\n    60\t            free_matrix(mat_b);\n    61\t            return EXIT_FAILURE;\n    62\t        }\n    63\t        let res_str = matrix_to_string(res);\n    64\t        if res_str.is_null() {\n    65\t            free_matrix(mat_a);\n    66\t            free_matrix(mat_b);\n    67\t            // NOTE: the original C code releases only the `matrix_t` struct\n    68\t            // here (`free(res)`), leaking the row allocations.  Reproduced\n    69\t            // verbatim.\n    70\t            free(res as *mut c_void);\n    71\t            return EXIT_FAILURE;\n    72\t        }\n    73\t\n    74\t        let res_write = write_to_file(OUT_FILE.as_ptr(), res_str);\n    75\t\n    76\t        free_matrix(mat_a);\n    77\t        free_matrix(mat_b);\n    78\t        free_matrix(res);\n    79\t        free(res_str as *mut c_void);\n    80\t\n    81\t        if res_write != 0 {\n    82\t            return EXIT_FAILURE;\n    83\t        }\n    84\t\n    85\t        EXIT_SUCCESS\n    86\t    }\n    87\t}","is_error":false}]},"parent_tool_use_id":null,"session_id":"0ac7619d-9520-4925-a201-0b56279db839","uuid":"ba8a7e32-8894-4626-a0b6-bd55ea762400","timestamp":"2026-08-19T21:23:50.337Z","tool_use_result":{"stdout":"===== src/lib.rs =====\n     1\t/*\n     2\t * Copyright 2025 MIT Lincoln Laboratory\n     3\t * Permission is hereby granted, free of charge,\n     4\t * to any person obtaining a copy of this software\n     5\t * and associated documentation files (the \"Software\"),\n     6\t * to deal in the Software without restriction,\n     7\t * including without limitation the rights to use, copy,\n     8\t * modify, merge, publish, distribute, sublicense,\n     9\t * and/or sell copies of the Software,\n    10\t * and to permit persons to whom the Software is furnished to do so,\n    11\t * subject to the following conditions:\n    12\t *\n    13\t * The above copyright notice and this permission notice\n    14\t * shall be included in all copies or substantial portions of the Software.\n    15\t *\n    16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    18\t * THE WARRANTIES OF MERCHANTABILITY,\n    19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    24\t */\n    25\t\n    26\t//! Rust translation of the `driver` C shared library found in `c_src/`.\n    27\t//!\n    28\t//! The library exports the following public ABI (identical to the symbols\n    29\t//! exported by `libdriver.so` built from the C sources):\n    30\t//!\n    31\t//! * `allocate_matrix`\n    32\t//! * `free_matrix`\n    33\t//! * `initialize_matrix_from_string`\n    34\t//! * `multiply_matrices`\n    35\t//! * `matrix_to_string`\n    36\t//! * `write_to_file`\n    37\t//! * `driver`\n    38\t\n    39\tpub mod cffi;\n    40\tpub mod driver;\n    41\tpub mod matrix;\n    42\tpub mod write;\n    43\t\n    44\tpub use crate::driver::driver;\n    45\tpub use crate::matrix::{\n    46\t    allocate_matrix, free_matrix, initialize_matrix_from_string, matrix_to_string,\n    47\t    multiply_matrices, matrix_t,\n    48\t};\n    49\tpub use crate::write::write_to_file;\n===== src/cffi.rs =====\n     1\t/*\n     2\t * Copyright 2025 MIT Lincoln Laboratory\n     3\t * Permission is hereby granted, free of charge,\n     4\t * to any person obtaining a copy of this software\n     5\t * and associated documentation files (the \"Software\"),\n     6\t * to deal in the Software without restriction,\n     7\t * including without limitation the rights to use, copy,\n     8\t * modify, merge, publish, distribute, sublicense,\n     9\t * and/or sell copies of the Software,\n    10\t * and to permit persons to whom the Software is furnished to do so,\n    11\t * subject to the following conditions:\n    12\t *\n    13\t * The above copyright notice and this permission notice\n    14\t * shall be included in all copies or substantial portions of the Software.\n    15\t *\n    16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    18\t * THE WARRANTIES OF MERCHANTABILITY,\n    19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    24\t */\n    25\t\n    26\t//! Minimal bindings to the C runtime functions used by the original C library.\n    27\t//!\n    28\t//! The original library allocates every object it hands back to its callers\n    29\t//! with `malloc()` and it emits all of its diagnostics through the C `stdio`\n    30\t//! streams.  In order to stay byte-for-byte and ABI compatible (callers are\n    31\t//! allowed to `free()` the returned pointers, and the diagnostics have to be\n    32\t//! interleaved with the rest of the process' C `stdio` output in exactly the\n    33\t//! same way), the translation keeps using the very same C runtime entry points\n    34\t//! instead of the Rust standard library equivalents.\n    35\t\n    36\t#![allow(non_camel_case_types)]\n    37\t\n    38\tuse core::ffi::{c_char, c_int, c_long, c_ulong, c_void};\n    39\t\n    40\t/// Opaque stand-in for the C `FILE` type.\n    41\t#[repr(C)]\n    42\tpub struct FILE {\n    43\t    _opaque: [u8; 0],\n    44\t}\n    45\t\n    46\tunsafe extern \"C\" {\n    47\t    // <stdlib.h>\n    48\t    pub fn malloc(size: c_ulong) -> *mut c_void;\n    49\t    pub fn free(ptr: *mut c_void);\n    50\t    pub fn atoi(nptr: *const c_char) -> c_int;\n    51\t\n    52\t    // <string.h>\n    53\t    pub fn strdup(s: *const c_char) -> *mut c_char;\n    54\t    pub fn strcat(dest: *mut c_char, src: *const c_char) -> *mut c_char;\n    55\t    pub fn strtok_r(\n    56\t        s: *mut c_char,\n    57\t        delim: *const c_char,\n    58\t        save_ptr: *mut *mut c_char,\n    59\t    ) -> *mut c_char;\n    60\t    pub fn strerror(errnum: c_int) -> *mut c_char;\n    61\t\n    62\t    // <stdio.h>\n    63\t    pub static mut stderr: *mut FILE;\n    64\t    pub fn fopen(pathname: *const c_char, mode: *const c_char) -> *mut FILE;\n    65\t    pub fn fclose(stream: *mut FILE) -> c_int;\n    66\t    pub fn fprintf(stream: *mut FILE, format: *const c_char, ...) -> c_int;\n    67\t    pub fn snprintf(str_: *mut c_char, size: c_ulong, format: *const c_char, ...) -> c_int;\n    68\t    pub fn perror(s: *const c_char);\n    69\t\n    70\t    // <errno.h>\n    71\t    fn __errno_location() -> *mut c_int;\n    72\t}\n    73\t\n    74\t/// `EINVAL` as defined by Linux' `<errno.h>`.\n    75\tpub const EINVAL: c_int = 22;\n    76\t\n    77\t/// `EXIT_SUCCESS` from `<stdlib.h>`.\n    78\tpub const EXIT_SUCCESS: c_int = 0;\n    79\t\n    80\t/// `EXIT_FAILURE` from `<stdlib.h>`.\n    81\tpub const EXIT_FAILURE: c_int = 1;\n    82\t\n    83\t/// Reads the current value of the C `errno` variable.\n    84\t#[inline]\n    85\tpub fn errno() -> c_int {\n    86\t    unsafe { *__errno_location() }\n    87\t}\n    88\t\n    89\t/// Returns the `FILE*` for the C `stderr` stream.\n    90\t#[inline]\n    91\tpub fn stderr_stream() -> *mut FILE {\n    92\t    unsafe { stderr }\n    93\t}\n    94\t\n    95\t/// Emulates C's implicit conversion of an `int` to `size_t` (sign extension on\n    96\t/// LP64 followed by a reinterpretation of the bit pattern as unsigned).\n    97\t#[inline]\n    98\tpub fn int_to_size(value: c_int) -> c_ulong {\n    99\t    value as c_long as c_ulong\n   100\t}\n===== src/matrix.rs =====\n     1\t/*\n     2\t * Copyright 2025 MIT Lincoln Laboratory\n     3\t * Permission is hereby granted, free of charge,\n     4\t * to any person obtaining a copy of this software\n     5\t * and associated documentation files (the \"Software\"),\n     6\t * to deal in the Software without restriction,\n     7\t * including without limitation the rights to use, copy,\n     8\t * modify, merge, publish, distribute, sublicense,\n     9\t * and/or sell copies of the Software,\n    10\t * and to permit persons to whom the Software is furnished to do so,\n    11\t * subject to the following conditions:\n    12\t *\n    13\t * The above copyright notice and this permission notice\n    14\t * shall be included in all copies or substantial portions of the Software.\n    15\t *\n    16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    18\t * THE WARRANTIES OF MERCHANTABILITY,\n    19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    24\t */\n    25\t\n    26\t//! Translation of `c_src/src/matrix.c`.\n    27\t\n    28\t#![allow(non_camel_case_types)]\n    29\t\n    30\tuse core::ffi::{c_char, c_int, c_void};\n    31\tuse core::mem::size_of;\n    32\tuse core::ptr;\n    33\t\n    34\tuse crate::cffi::{\n    35\t    atoi, fprintf, free, int_to_size, malloc, perror, snprintf, stderr_stream, strcat, strdup,\n    36\t    strtok_r,\n    37\t};\n    38\t\n    39\t/// Mirror of the `matrix_t` type declared in `include/matrix.h`.\n    40\t///\n    41\t/// ```c\n    42\t/// typedef struct {\n    43\t///     int** matrix;\n    44\t///     int width;\n    45\t///     int height;\n    46\t/// } matrix_t;\n    47\t/// ```\n    48\t#[repr(C)]\n    49\tpub struct matrix_t {\n    50\t    pub matrix: *mut *mut c_int,\n    51\t    pub width: c_int,\n    52\t    pub height: c_int,\n    53\t}\n    54\t\n    55\t/// `mat->matrix[i]` – the pointer to row `i`.\n    56\t#[inline]\n    57\tunsafe fn row_ptr(mat: *mut matrix_t, i: c_int) -> *mut c_int {\n    58\t    unsafe { *(*mat).matrix.offset(i as isize) }\n    59\t}\n    60\t\n    61\t/// `&mat->matrix[i]` – the slot holding the pointer to row `i`.\n    62\t#[inline]\n    63\tunsafe fn row_slot(mat: *mut matrix_t, i: c_int) -> *mut *mut c_int {\n    64\t    unsafe { (*mat).matrix.offset(i as isize) }\n    65\t}\n    66\t\n    67\t/// `&mat->matrix[i][j]` – the element at row `i`, column `j`.\n    68\t#[inline]\n    69\tunsafe fn elem_ptr(mat: *mut matrix_t, i: c_int, j: c_int) -> *mut c_int {\n    70\t    unsafe { row_ptr(mat, i).offset(j as isize) }\n    71\t}\n    72\t\n    73\t#[unsafe(no_mangle)]\n    74\tpub unsafe extern \"C\" fn allocate_matrix(width: c_int, height: c_int) -> *mut matrix_t {\n    75\t    unsafe {\n    76\t        let mat = malloc(size_of::<matrix_t>() as u64) as *mut matrix_t;\n    77\t        if mat.is_null() {\n    78\t            perror(c\"Failed to allocate memory for matrix struct\".as_ptr());\n    79\t            return ptr::null_mut();\n    80\t        }\n    81\t\n    82\t        (*mat).width = width;\n    83\t        (*mat).height = height;\n    84\t\n    85\t        (*mat).matrix = malloc(\n    86\t            int_to_size(height).wrapping_mul(size_of::<*mut c_int>() as u64),\n    87\t        ) as *mut *mut c_int;\n    88\t        if (*mat).matrix.is_null() {\n    89\t            perror(c\"Failed to allocate memory for matrix rows\".as_ptr());\n    90\t            free(mat as *mut c_void);\n    91\t            return ptr::null_mut();\n    92\t        }\n    93\t\n    94\t        let mut i: c_int = 0;\n    95\t        while i < height {\n    96\t            *row_slot(mat, i) =\n    97\t                malloc(int_to_size(width).wrapping_mul(size_of::<c_int>() as u64)) as *mut c_int;\n    98\t            if row_ptr(mat, i).is_null() {\n    99\t                perror(c\"Failed to allocate memory for matrix columns\".as_ptr());\n   100\t                let mut j: c_int = 0;\n   101\t                while j <= i {\n   102\t                    free(row_ptr(mat, j) as *mut c_void);\n   103\t                    j += 1;\n   104\t                }\n   105\t                free((*mat).matrix as *mut c_void);\n   106\t                free(mat as *mut c_void);\n   107\t                return ptr::null_mut();\n   108\t            }\n   109\t            i += 1;\n   110\t        }\n   111\t\n   112\t        mat\n   113\t    }\n   114\t}\n   115\t\n   116\t#[unsafe(no_mangle)]\n   117\tpub unsafe extern \"C\" fn free_matrix(mat: *mut matrix_t) {\n   118\t    unsafe {\n   119\t        if mat.is_null() {\n   120\t            return;\n   121\t        }\n   122\t\n   123\t        let mut i: c_int = 0;\n   124\t        while i < (*mat).height {\n   125\t            free(row_ptr(mat, i) as *mut c_void);\n   126\t            i += 1;\n   127\t        }\n   128\t        free((*mat).matrix as *mut c_void);\n   129\t        free(mat as *mut c_void);\n   130\t    }\n   131\t}\n   132\t\n   133\t#[unsafe(no_mangle)]\n   134\tpub unsafe extern \"C\" fn initialize_matrix_from_string(\n   135\t    input: *const c_char,\n   136\t    width: c_int,\n   137\t    height: c_int,\n   138\t) -> *mut matrix_t {\n   139\t    unsafe {\n   140\t        let mat = allocate_matrix(width, height);\n   141\t\n   142\t        let input_copy = strdup(input);\n   143\t        if input_copy.is_null() {\n   144\t            perror(c\"Failed to duplicate input string\".as_ptr());\n   145\t            free_matrix(mat);\n   146\t            return ptr::null_mut();\n   147\t        }\n   148\t\n   149\t        let mut saveptr_row: *mut c_char = ptr::null_mut();\n   150\t        let mut row_token = strtok_r(input_copy, c\"\\n\".as_ptr(), &mut saveptr_row);\n   151\t        let mut i: c_int = 0;\n   152\t        while i < height {\n   153\t            if row_token.is_null() {\n   154\t                fprintf(\n   155\t                    stderr_stream(),\n   156\t                    c\"Insufficient rows in input string.\\n\".as_ptr(),\n   157\t                );\n   158\t                free(input_copy as *mut c_void);\n   159\t                free_matrix(mat);\n   160\t                return ptr::null_mut();\n   161\t            }\n   162\t\n   163\t            let mut saveptr_col: *mut c_char = ptr::null_mut();\n   164\t            let mut col_token = strtok_r(row_token, c\" \".as_ptr(), &mut saveptr_col);\n   165\t            let mut j: c_int = 0;\n   166\t            while j < width {\n   167\t                if col_token.is_null() {\n   168\t                    fprintf(\n   169\t                        stderr_stream(),\n   170\t                        c\"Insufficient columns in row %d.\\n\".as_ptr(),\n   171\t                        i + 1,\n   172\t                    );\n   173\t                    free(input_copy as *mut c_void);\n   174\t                    free_matrix(mat);\n   175\t                    return ptr::null_mut();\n   176\t                }\n   177\t                *elem_ptr(mat, i, j) = atoi(col_token);\n   178\t                col_token = strtok_r(ptr::null_mut(), c\" \".as_ptr(), &mut saveptr_col);\n   179\t                j += 1;\n   180\t            }\n   181\t\n   182\t            row_token = strtok_r(ptr::null_mut(), c\"\\n\".as_ptr(), &mut saveptr_row);\n   183\t            i += 1;\n   184\t        }\n   185\t\n   186\t        free(input_copy as *mut c_void);\n   187\t        mat\n   188\t    }\n   189\t}\n   190\t\n   191\t#[unsafe(no_mangle)]\n   192\tpub unsafe extern \"C\" fn multiply_matrices(\n   193\t    mat_a: *mut matrix_t,\n   194\t    mat_b: *mut matrix_t,\n   195\t) -> *mut matrix_t {\n   196\t    unsafe {\n   197\t        if (*mat_a).width != (*mat_b).height {\n   198\t            fprintf(\n   199\t                stderr_stream(),\n   200\t                c\"Matrix dimensions do not allow multiplication.\\n\".as_ptr(),\n   201\t            );\n   202\t            return ptr::null_mut();\n   203\t        }\n   204\t\n   205\t        let result = allocate_matrix((*mat_b).width, (*mat_a).height);\n   206\t        let mut i: c_int = 0;\n   207\t        while i < (*mat_a).height {\n   208\t            let mut j: c_int = 0;\n   209\t            while j < (*mat_b).width {\n   210\t                *elem_ptr(result, i, j) = 0;\n   211\t                let mut k: c_int = 0;\n   212\t                while k < (*mat_a).width {\n   213\t                    let product =\n   214\t                        (*elem_ptr(mat_a, i, k)).wrapping_mul(*elem_ptr(mat_b, k, j));\n   215\t                    let slot = elem_ptr(result, i, j);\n   216\t                    *slot = (*slot).wrapping_add(product);\n   217\t                    k += 1;\n   218\t                }\n   219\t                j += 1;\n   220\t            }\n   221\t            i += 1;\n   222\t        }\n   223\t\n   224\t        result\n   225\t    }\n   226\t}\n   227\t\n   228\t#[unsafe(no_mangle)]\n   229\tpub unsafe extern \"C\" fn matrix_to_string(mat: *mut matrix_t) -> *mut c_char {\n   230\t    unsafe {\n   231\t        if mat.is_null() {\n   232\t            fprintf(stderr_stream(), c\"Error: Matrix is NULL.\\n\".as_ptr());\n   233\t            return ptr::null_mut();\n   234\t        }\n   235\t\n   236\t        let width = (*mat).width;\n   237\t        let height = (*mat).height;\n   238\t\n   239\t        // int buffer_size = mat->height * (mat->width * 10 + mat->width)\n   240\t        //                   + mat->height + 1;\n   241\t        let buffer_size: c_int = height\n   242\t            .wrapping_mul(width.wrapping_mul(10).wrapping_add(width))\n   243\t            .wrapping_add(height)\n   244\t            .wrapping_add(1);\n   245\t\n   246\t        let result = malloc(int_to_size(buffer_size)) as *mut c_char;\n   247\t        if result.is_null() {\n   248\t            perror(c\"Failed to allocate memory for matrix string\".as_ptr());\n   249\t            return ptr::null_mut();\n   250\t        }\n   251\t\n   252\t        *result = 0;\n   253\t\n   254\t        let mut i: c_int = 0;\n   255\t        while i < height {\n   256\t            let mut j: c_int = 0;\n   257\t            while j < width {\n   258\t                let mut buffer = [0 as c_char; 12];\n   259\t                snprintf(\n   260\t                    buffer.as_mut_ptr(),\n   261\t                    buffer.len() as u64,\n   262\t                    c\"%d\".as_ptr(),\n   263\t                    *elem_ptr(mat, i, j),\n   264\t                );\n   265\t                strcat(result, buffer.as_ptr());\n   266\t\n   267\t                if j < width.wrapping_sub(1) {\n   268\t                    strcat(result, c\" \".as_ptr());\n   269\t                }\n   270\t                j += 1;\n   271\t            }\n   272\t            strcat(result, c\"\\n\".as_ptr());\n   273\t            i += 1;\n   274\t        }\n   275\t\n   276\t        result\n   277\t    }\n   278\t}\n===== src/write.rs =====\n     1\t/*\n     2\t * Copyright 2025 MIT Lincoln Laboratory\n     3\t * Permission is hereby granted, free of charge,\n     4\t * to any person obtaining a copy of this software\n     5\t * and associated documentation files (the \"Software\"),\n     6\t * to deal in the Software without restriction,\n     7\t * including without limitation the rights to use, copy,\n     8\t * modify, merge, publish, distribute, sublicense,\n     9\t * and/or sell copies of the Software,\n    10\t * and to permit persons to whom the Software is furnished to do s