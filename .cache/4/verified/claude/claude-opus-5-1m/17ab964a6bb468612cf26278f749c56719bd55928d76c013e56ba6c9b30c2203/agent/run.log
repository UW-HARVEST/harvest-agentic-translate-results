{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01S1chaxSBgYE6rG4EzkeRqr","type":"tool_result","content":"1\t/*\n2\t * Copyright 2025 MIT Lincoln Laboratory\n3\t * Permission is hereby granted, free of charge,\n4\t * to any person obtaining a copy of this software\n5\t * and associated documentation files (the \"Software\"),\n6\t * to deal in the Software without restriction,\n7\t * including without limitation the rights to use, copy,\n8\t * modify, merge, publish, distribute, sublicense,\n9\t * and/or sell copies of the Software,\n10\t * and to permit persons to whom the Software is furnished to do so,\n11\t * subject to the following conditions:\n12\t *\n13\t * The above copyright notice and this permission notice\n14\t * shall be included in all copies or substantial portions of the Software.\n15\t *\n16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n18\t * THE WARRANTIES OF MERCHANTABILITY,\n19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n24\t */\n25\t\n26\t//! Translation of `c_src/src/matrix.c`.\n27\t\n28\t#![allow(non_camel_case_types)]\n29\t\n30\tuse core::ffi::{c_char, c_int, c_void};\n31\tuse core::mem::size_of;\n32\tuse core::ptr;\n33\t\n34\tuse crate::cffi::{\n35\t    atoi, fprintf, free, int_to_size, malloc, perror, snprintf, stderr_stream, strcat, strdup,\n36\t    strtok_r,\n37\t};\n38\t\n39\t/// Mirror of the `matrix_t` type declared in `include/matrix.h`.\n40\t///\n41\t/// ```c\n42\t/// typedef struct {\n43\t///     int** matrix;\n44\t///     int width;\n45\t///     int height;\n46\t/// } matrix_t;\n47\t/// ```\n48\t#[repr(C)]\n49\tpub struct matrix_t {\n50\t    pub matrix: *mut *mut c_int,\n51\t    pub width: c_int,\n52\t    pub height: c_int,\n53\t}\n54\t\n55\t/// `mat->matrix[i]` – the pointer to row `i`.\n56\t#[inline]\n57\tunsafe fn row_ptr(mat: *mut matrix_t, i: c_int) -> *mut c_int {\n58\t    unsafe { *(*mat).matrix.offset(i as isize) }\n59\t}\n60\t\n61\t/// `&mat->matrix[i]` – the slot holding the pointer to row `i`.\n62\t#[inline]\n63\tunsafe fn row_slot(mat: *mut matrix_t, i: c_int) -> *mut *mut c_int {\n64\t    unsafe { (*mat).matrix.offset(i as isize) }\n65\t}\n66\t\n67\t/// `&mat->matrix[i][j]` – the element at row `i`, column `j`.\n68\t#[inline]\n69\tunsafe fn elem_ptr(mat: *mut matrix_t, i: c_int, j: c_int) -> *mut c_int {\n70\t    unsafe { row_ptr(mat, i).offset(j as isize) }\n71\t}\n72\t\n73\t#[unsafe(no_mangle)]\n74\tpub unsafe extern \"C\" fn allocate_matrix(width: c_int, height: c_int) -> *mut matrix_t {\n75\t    unsafe {\n76\t        let mat = malloc(size_of::<matrix_t>() as u64) as *mut matrix_t;\n77\t        if mat.is_null() {\n78\t            perror(c\"Failed to allocate memory for matrix struct\".as_ptr());\n79\t            return ptr::null_mut();\n80\t        }\n81\t\n82\t        (*mat).width = width;\n83\t        (*mat).height = height;\n84\t\n85\t        (*mat).matrix = malloc(\n86\t            int_to_size(height).wrapping_mul(size_of::<*mut c_int>() as u64),\n87\t        ) as *mut *mut c_int;\n88\t        if (*mat).matrix.is_null() {\n89\t            perror(c\"Failed to allocate memory for matrix rows\".as_ptr());\n90\t            free(mat as *mut c_void);\n91\t            return ptr::null_mut();\n92\t        }\n93\t\n94\t        let mut i: c_int = 0;\n95\t        while i < height {\n96\t            *row_slot(mat, i) =\n97\t                malloc(int_to_size(width).wrapping_mul(size_of::<c_int>() as u64)) as *mut c_int;\n98\t            if row_ptr(mat, i).is_null() {\n99\t                perror(c\"Failed to allocate memory for matrix columns\".as_ptr());\n100\t                let mut j: c_int = 0;\n101\t                while j <= i {\n102\t                    free(row_ptr(mat, j) as *mut c_void);\n103\t                    j += 1;\n104\t                }\n105\t                free((*mat).matrix as *mut c_void);\n106\t                free(mat as *mut c_void);\n107\t                return ptr::null_mut();\n108\t            }\n109\t            i += 1;\n110\t        }\n111\t\n112\t        mat\n113\t    }\n114\t}\n115\t\n116\t#[unsafe(no_mangle)]\n117\tpub unsafe extern \"C\" fn free_matrix(mat: *mut matrix_t) {\n118\t    unsafe {\n119\t        if mat.is_null() {\n120\t            return;\n121\t        }\n122\t\n123\t        let mut i: c_int = 0;\n124\t        while i < (*mat).height {\n125\t            free(row_ptr(mat, i) as *mut c_void);\n126\t            i += 1;\n127\t        }\n128\t        free((*mat).matrix as *mut c_void);\n129\t        free(mat as *mut c_void);\n130\t    }\n131\t}\n132\t\n133\t#[unsafe(no_mangle)]\n134\tpub unsafe extern \"C\" fn initialize_matrix_from_string(\n135\t    input: *const c_char,\n136\t    width: c_int,\n137\t    height: c_int,\n138\t) -> *mut matrix_t {\n139\t    unsafe {\n140\t        let mat = allocate_matrix(width, height);\n141\t\n142\t        let input_copy = strdup(input);\n143\t        if input_copy.is_null() {\n144\t            perror(c\"Failed to duplicate input string\".as_ptr());\n145\t            free_matrix(mat);\n146\t            return ptr::null_mut();\n147\t        }\n148\t\n149\t        let mut saveptr_row: *mut c_char = ptr::null_mut();\n150\t        let mut row_token = strtok_r(input_copy, c\"\\n\".as_ptr(), &mut saveptr_row);\n151\t        let mut i: c_int = 0;\n152\t        while i < height {\n153\t            if row_token.is_null() {\n154\t                fprintf(\n155\t                    stderr_stream(),\n156\t                    c\"Insufficient rows in input string.\\n\".as_ptr(),\n157\t                );\n158\t                free(input_copy as *mut c_void);\n159\t                free_matrix(mat);\n160\t                return ptr::null_mut();\n161\t            }\n162\t\n163\t            let mut saveptr_col: *mut c_char = ptr::null_mut();\n164\t            let mut col_token = strtok_r(row_token, c\" \".as_ptr(), &mut saveptr_col);\n165\t            let mut j: c_int = 0;\n166\t            while j < width {\n167\t                if col_token.is_null() {\n168\t                    fprintf(\n169\t                        stderr_stream(),\n170\t                        c\"Insufficient columns in row %d.\\n\".as_ptr(),\n171\t                        i + 1,\n172\t                    );\n173\t                    free(input_copy as *mut c_void);\n174\t                    free_matrix(mat);\n175\t                    return ptr::null_mut();\n176\t                }\n177\t                *elem_ptr(mat, i, j) = atoi(col_token);\n178\t                col_token = strtok_r(ptr::null_mut(), c\" \".as_ptr(), &mut saveptr_col);\n179\t                j += 1;\n180\t            }\n181\t\n182\t            row_token = strtok_r(ptr::null_mut(), c\"\\n\".as_ptr(), &mut saveptr_row);\n183\t            i += 1;\n184\t        }\n185\t\n186\t        free(input_copy as *mut c_void);\n187\t        mat\n188\t    }\n189\t}\n190\t\n191\t#[unsafe(no_mangle)]\n192\tpub unsafe extern \"C\" fn multiply_matrices(\n193\t    mat_a: *mut matrix_t,\n194\t    mat_b: *mut matrix_t,\n195\t) -> *mut matrix_t {\n196\t    unsafe {\n197\t        if (*mat_a).width != (*mat_b).height {\n198\t            fprintf(\n199\t                stderr_stream(),\n200\t                c\"Matrix dimensions do not allow multiplication.\\n\".as_ptr(),\n201\t            );\n202\t            return ptr::null_mut();\n203\t        }\n204\t\n205\t        let result = allocate_matrix((*mat_b).width, (*mat_a).height);\n206\t        let mut i: c_int = 0;\n207\t        while i < (*mat_a).height {\n208\t            let mut j: c_int = 0;\n209\t            while j < (*mat_b).width {\n210\t                *elem_ptr(result, i, j) = 0;\n211\t                let mut k: c_int = 0;\n212\t                while k < (*mat_a).width {\n213\t                    let product =\n214\t                        (*elem_ptr(mat_a, i, k)).wrapping_mul(*elem_ptr(mat_b, k, j));\n215\t                    let slot = elem_ptr(result, i, j);\n216\t                    *slot = (*slot).wrapping_add(product);\n217\t                    k += 1;\n218\t                }\n219\t                j += 1;\n220\t            }\n221\t            i += 1;\n222\t        }\n223\t\n224\t        result\n225\t    }\n226\t}\n227\t\n228\t#[unsafe(no_mangle)]\n229\tpub unsafe extern \"C\" fn matrix_to_string(mat: *mut matrix_t) -> *mut c_char {\n230\t    unsafe {\n231\t        if mat.is_null() {\n232\t            fprintf(stderr_stream(), c\"Error: Matrix is NULL.\\n\".as_ptr());\n233\t            return ptr::null_mut();\n234\t        }\n235\t\n236\t        let width = (*mat).width;\n237\t        let height = (*mat).height;\n238\t\n239\t        // int buffer_size = mat->height * (mat->width * 10 + mat->width)\n240\t        //                   + mat->height + 1;\n241\t        let buffer_size: c_int = height\n242\t            .wrapping_mul(width.wrapping_mul(10).wrapping_add(width))\n243\t            .wrapping_add(height)\n244\t            .wrapping_add(1);\n245\t\n246\t        let result = malloc(int_to_size(buffer_size)) as *mut c_char;\n247\t        if result.is_null() {\n248\t            perror(c\"Failed to allocate memory for matrix string\".as_ptr());\n249\t            return ptr::null_mut();\n250\t        }\n251\t\n252\t        *result = 0;\n253\t\n254\t        let mut i: c_int = 0;\n255\t        while i < height {\n256\t            let mut j: c_int = 0;\n257\t            while j < width {\n258\t                let mut buffer = [0 as c_char; 12];\n259\t                snprintf(\n260\t                    buffer.as_mut_ptr(),\n261\t                    buffer.len() as u64,\n262\t                    c\"%d\".as_ptr(),\n263\t                    *elem_ptr(mat, i, j),\n264\t                );\n265\t                strcat(result, buffer.as_ptr());\n266\t\n267\t                if j < width.wrapping_sub(1) {\n268\t                    strcat(result, c\" \".as_ptr());\n269\t                }\n270\t                j += 1;\n271\t            }\n272\t            strcat(result, c\"\\n\".as_ptr());\n273\t            i += 1;\n274\t        }\n275\t\n276\t        result\n277\t    }\n278\t}\n279\t"}]},"parent_tool_use_id":"toolu_bdrk_013SiNz3cwPLN7JxpqJG3kt6","session_id":"0ac7619d-9520-4925-a201-0b56279db839","uuid":"ebfdc1b4-d0d2-48d3-b469-1f83d87e9b43","timestamp":"2026-08-19T21:44:33.478Z","subagent_type":"general-purpose","task_description":"Audit C vs Rust translation"}
