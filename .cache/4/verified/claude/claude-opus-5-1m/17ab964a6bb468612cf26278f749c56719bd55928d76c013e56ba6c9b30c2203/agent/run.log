  let ctx = format!(\"E17 {w}x{h}\");\n        let out = diff_to_string(&mut m, &ctx);\n        // Whatever the C library does, the Rust library must do the same; for\n        // these shapes buffer_size is negative, so both must return NULL.\n        assert!(out.is_none(), \"{ctx}: expected NULL, got {out:?}\");\n    }'''\nnew = '''    // (width, height, buffer_size wraps NEGATIVE ⇒ malloc must fail)\n    let cases: &[(c_int, c_int, bool)] = &[\n        (1, 200_000_000, true),\n        (2, 100_000_000, true),\n        (11, 20_000_000, true),\n        (1, i32::MAX, true),\n        (-1, 1, true),\n        (1, -1, true),\n        (i32::MIN, 1, true),\n        // buffer_size wraps back to a small POSITIVE value: malloc succeeds and,\n        // because height <= 0, the C code emits an empty string without ever\n        // touching a row pointer.  The Rust port must do exactly the same.\n        (-1, -1, false),\n        (1, i32::MIN, false),\n    ];\n    for (w, h, expect_null) in cases {\n        let mut m = fake_matrix(*w, *h);\n        let ctx = format!(\"E17 {w}x{h}\");\n        let out = diff_to_string(&mut m, &ctx);\n        if *expect_null {\n            assert!(out.is_none(), \"{ctx}: expected NULL, got {out:?}\");\n        } else {\n            assert_eq!(out.as_deref(), Some(&b\"\"[..]), \"{ctx}\");\n        }\n    }'''\nassert old in s\ns = s.replace(old, new)\n\n# --- guard E32 multiply combos that would dereference the NULL row array ---\nold = '''    for k in [-1, 0, 1] {\n        for ha in [-1, 0, 1] {\n            for wb in [-1, 0, 1] {\n                let mut a = fake_matrix(k, ha);\n                let mut b = fake_matrix(wb, k);\n                diff_multiply(\n                    &mut a,\n                    &mut b,\n                    &format!(\"E32 multiply k={k} ha={ha} wb={wb}\"),\n                );\n            }\n        }\n    }'''\nnew = '''    for k in [-1, 0, 1] {\n        for ha in [-1, 0, 1] {\n            for wb in [-1, 0, 1] {\n    