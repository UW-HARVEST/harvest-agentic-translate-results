st = Some((t, src));\n            }\n        }\n    }\n    if let Some((t, src)) = newest {\n        assert!(\n            t <= lib_mtime,\n            \"{name} shared library {} is OLDER than {} — rebuild it first \\\\\n             (`cargo build` for the Rust .so, `cmake --build c_src/build` for the C .so)\",\n            path.display(),\n            src.display()\n        );\n    }\n}\n\nfn load(name: &'static str, path: PathBuf) -> Api {\n    assert!(\n        path.exists(),'''\nassert old in s\ns = s.replace(old, new)\n\nold = '''    // Leaked on purpose: the symbols are used for the whole lifetime of the\n    // test process.'''\nnew = '''    assert_not_stale(name, &path);\n    // Leaked on purpose: the symbols are used for the whole lifetime of the\n    // test process.'''\nassert old in s\ns = s.replace(old, new)\nopen(p,'w').write(s)\nprint('common patched')\nPYEOF\npython3 - <<'PYEOF'\np='tests/oom_parity.rs'\ns=open(p).read()\nold = '''            const S: usize = 600 * 1024 * 1024;\n            limit_address_space(1000 * 1024 * 1024);'''\nnew = '''            const S: u64 = 600 * 1024 * 1024;\n            // Measure the current address-space footprint instead of guessing:\n            // base + S must fit, base + 2*S must not.\n            let statm = std::fs::read_to_string(\"/proc/self/statm\").expect(\"statm\");\n            let pages: u64 = statm\n                .split_whitespace()\n                .next()\n                .and_then(|f| f.parse().ok())\n                .expect(\"statm size\");\n            let base = pages * 4096;\n            limit_address_space(base + S + S / 2);\n            let s = S as usize;'''\nassert old in s\ns = s.replace(old, new)\ns = s.replace('''            let mut bytes: Vec<u8> = Vec::with_capacity(S + 1);\n            let pattern = b\"1 2\\\\n3 4\\\\n\";\n            while bytes.len() < S {''','''            let mut bytes: Vec<u8> = Vec::with_capacity(s + 1);\n            let pattern = b\"1 2\\\\n3 4\\\\n\";\n            while bytes.len() < s {''')\nopen(p,'w').write(s)\nprint('oom patched')\nPYEOF\ntimeout 600 cargo build --offline > \"$TMPDIR/rebuild.log\" 2>&1; echo \"build exit=$?\"; timeout 600 cargo test --offline --test oom_parity -- --test-threads=1 > \"$TMPDIR/oom3.log\" 2>&1; echo \"test exit=$?\"; grep -E \"^test |^test result|left:|right:\" \"$TMPDIR/oom3.log\" | head -20","description":"Add stale-lib guard, fix OOM sizing, rebuild and rerun"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5693,"cache_read_input_tokens":253584,"cache_creation":{"ephemeral_5m_input_tokens":5693,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"0ac7619d-9520-4925-a201-0b56279db839","uuid":"17f66284-0c1a-4478-be32-b058dfc4f6c5","timestamp":"2026-08-19T22:04:23.287Z"}
