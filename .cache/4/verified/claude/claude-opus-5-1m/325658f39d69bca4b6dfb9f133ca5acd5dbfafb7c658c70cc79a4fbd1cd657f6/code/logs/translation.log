||memcmp(ga,gb,sizeof ga)||memcmp(&sa,&sb,sizeof sa)){\n        if(fail<8) fprintf(stderr,\"MISMATCH ba=%d align=%d gs=%d tb=%d lim=%d | ret %d/%d pos %d/%d\\n\",\n            ba,align,gs,tb,limsel,rc,rr,A.pos,B.pos);\n        fail++;\n      }\n  }\n  printf(\"grid cases=%ld mismatches=%ld\\n\",cases,fail);\n  return fail?1:0;\n}\nEOF\ngcc -O1 -o \"$TMPDIR/dt/grid\" \"$TMPDIR/dt/grid.c\" -ldl && for o in O0 O2 O3; do printf \"%-4s \" \"$o\"; \"$TMPDIR/dt/grid\" \"$TMPDIR/cbuild/lib_$o.so\" \"$(pwd)/target/release/liblib.so\"; done","task_type":"local_bash","uuid":"4ce322e3-5e8f-4756-8a6b-ee1df5d9f7d8","session_id":"8d78d929-1df5-4333-bbb0-844342eb9b68"}
