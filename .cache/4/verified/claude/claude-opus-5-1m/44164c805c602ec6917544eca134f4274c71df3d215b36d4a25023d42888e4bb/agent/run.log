+[[:space:]]*=/ {\n      split($0, a, \"=\"); gsub(/[[:space:]]/, \"\", a[1]);\n      if (a[1] != \"default\") print a[1]\n    }' Cargo.toml\n)\n\nCOMBOS=()\nN=${#OPTIONAL[@]}\nfor (( mask = 0; mask < (1 << N); mask++ )); do\n  combo=\"\"\n  for (( b = 0; b < N; b++ )); do\n    if (( mask & (1 << b) )); then\n      combo=\"${combo:+$combo,}${OPTIONAL[b]}\"\n    fi\n  done\n  COMBOS+=(\"$combo\")\ndone\n# The `default` feature set is a valid configuration in its own right.\nif grep -qE '^default[[:space:]]*=' Cargo.toml; then\n  COMBOS+=(\"default\")\nfi\n\necho\necho \"== feature combinations (${#COMBOS[@]}) ==\"\nfor c in \"${COMBOS[@]}\"; do echo \"    '${c}'\"; done\n\n# ---------------------------------------------------------------------------\n# 3. cargo check + build + test for each combination.\n# ---------------------------------------------------------------------------\nFAILED=0\nfor combo in \"${COMBOS[@]}\"; do\n  if [ -z \"$combo\" ]; then\n    FEAT=()\n    label=\"<none>\"\n  else\n    FEAT=(--features \"$combo\")\n    label=\"$combo\"\n  fi\n  echo\n  echo \"############################################################\"\n  echo \"# features: $label\"\n  echo \"############################################################\"\n\n  for step in check build; do\n    if ! timeout 600 cargo \"$step\" \"${CARGO_ARGS[@]}\" --no-default-features \"${FEAT[@]}\" 2>&1 | tail -3; then\n      echo \"!! cargo $step FAILED for features '$label'\"\n      FAILED=1\n    fi\n  done\n\n  if ! timeout 600 cargo test \"${CARGO_ARGS[@]}\" --no-default-features \"${FEAT[@]}\" -- --test-threads=4 2>&1 | tail -45; then\n    echo \"!! cargo test FAILED for features '$label'\"\n    FAILED=1\n  fi\ndone\n\n# ---------------------------------------------------------------------------\n# 4. Implicit-default invocation (what a plain `cargo test` does).\n# ---------------------------------------------------------------------------\necho\necho \"############################################################\"\necho \"# implicit default (plain cargo test)\"\necho \"############################################################\"\nif ! timeout 600 cargo test \"${CARGO_ARGS[@]}\" 2>&1 | tail -45; then\n  echo \"!! plain cargo test FAILED\"\n  FAILED=1\nfi\n\necho\nif [ \"$FAILED\" -eq 0 ]; then\n  echo \"ALL FEATURE COMBINATIONS PASSED\"\nelse\n  echo \"SOME FEATURE COMBINATIONS FAILED\"\nfi\nexit \"$FAILED\"\n","structuredPatch":[],"originalFile":null,"userModified":false}}
