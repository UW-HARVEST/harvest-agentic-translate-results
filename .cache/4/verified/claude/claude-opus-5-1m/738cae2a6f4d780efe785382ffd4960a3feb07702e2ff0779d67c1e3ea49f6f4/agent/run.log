ead()\n        return p.returncode, p.stdout, p.stderr, files\n    except subprocess.TimeoutExpired as e:\n        return \"TIMEOUT\", e.stdout or b\"\", e.stderr or b\"\", {}\n    finally:\n        shutil.rmtree(d, ignore_errors=True)\n\n\ndef norm(b):\n    \"\"\"Replace each distinct pointer with a stable id based on first use, so\n    pointer *identity* relationships are still compared.\"\"\"\n    seen = {}\n\n    def sub(m):\n        key = m.group(0)\n        if key not in seen:\n            seen[key] = b\"0xPTR%d\" % len(seen)\n        return seen[key]\n\n    return PTR.sub(sub, b)\n\n\nCASES = {\n    \"exit_only\": (b\"12\\n\", None),\n    \"empty\": (b\"\", None),\n    \"view_shapes\": (b\"1\\n12\\n\", None),\n    \"no_newline_end\": (b\"1\", None),\n    \"invalid_choice\": (b\"0\\n13\\n99\\n-5\\n12\\n\", None),\n    \"invalid_input\": (b\"abc\\n\\n   \\nx1\\n12\\n\", None),\n    \"create_scenes\": (b\"2\\nMy Scene\\n2\\nOther\\n6\\n12\\n\", None),\n    \"create_empty_name\": (b\"2\\n\\n6\\n12\\n\", None),\n    \"add_shapes\": (b\"2\\nA\\n3\\n0\\n0\\n3\\n0\\n9\\n5\\n0\\n12\\n\", None),\n    \"add_invalid\": (b\"3\\n2\\nA\\n3\\n5\\n0\\n3\\n0\\n99\\n3\\n0\\n-1\\n3\\n0\\nzz\\n12\\n\", None),\n    \"remove_shapes\": (\n        b\"2\\nA\\n3\\n0\\n7\\n3\\n0\\n2\\n4\\n0\\n1\\n4\\n0\\n5\\n4\\n0\\n0\\n5\\n0\\n12\\n\",\n        None,\n    ),\n    \"remove_empty\": (b\"2\\nA\\n4\\n0\\n12\\n\", None),\n    \"remove_no_scene\": (b\"4\\n12\\n\", None),\n    \"view_no_scene\": (b\"5\\n12\\n\", None),\n    \"view_bad_idx\": (b\"2\\nA\\n5\\n7\\n5\\n-1\\n5\\n0\\n12\\n\", None),\n    \"list_empty\": (b\"6\\n12\\n\", None),\n    \"save_load\": (\n        b\"2\\nScene1\\n3\\n0\\n0\\n3\\n0\\n7\\n7\\n0\\nout.txt\\n8\\nout.txt\\n5\\n1\\n6\\n12\\n\",\n        None,\n    ),\n    \"save_no_scene\": (b\"7\\n12\\n\", None),\n    \"save_bad_file\": (b\"2\\nA\\n7\\n0\\n/nonexistent_dir/x/y.txt\\n12\\n\", None),\n    \"save_empty_name\": (b\"2\\nA\\n7\\n0\\n\\n12\\n\", None),\n    \"load_mi