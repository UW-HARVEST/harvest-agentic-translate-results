rgo $cmd $combo > \"$log\" 2>&1; then\n            echo \"OK\"\n            grep -E \"^test [a-z_]+ \\.\\.\\.\" \"$log\" | sed 's/^/      /'\n        else\n            echo \"FAILED\"\n            fail=1\n            tail -n 40 \"$log\" | sed 's/^/      /'\n        fi\n    done\ndone\nrm -f \"$log\"\n\nif [ \"$fail\" -ne 0 ]; then\n    echo \"SOME COMBINATIONS FAILED\"\n    exit 1\nfi\necho \"ALL FEATURE COMBINATIONS OK\"\n","structuredPatch":[{"oldStart":4,"oldLines":21,"newStart":4,"newLines":20,"lines":[" #"," # The crate has no `[features]` section and no optional dependencies (and the C"," # side has no `option()` / `#ifdef` either - see CONFIGS.md), so the complete","-# matrix is the three equivalent ways of spelling \"the one configuration\".","+# matrix is the three equivalent ways of spelling \"the one configuration\".  The","+# feature list is read out of Cargo.toml mechanically, so the matrix grows by","+# itself if a feature is ever added."," set -u","-cd \"$(dirname \"$0\")\"","+cd \"$(dirname \"$0\")\" || exit 1"," ","-# Enumerate the feature names declared in Cargo.toml (mechanically, so that the","-# matrix grows automatically if a feature is ever added)."," features=$(awk '/^\\[features\\]/{f=1;next} /^\\[/{f=0} f && /=/{sub(/ *=.*/,\"\");print}' Cargo.toml)"," if [ -n \"$features\" ]; then","-    echo \"declared features: $features\"","+    echo \"declared features: $(echo \"$features\" | paste -sd' ')\""," else","     echo \"declared features: (none)\""," fi"," "," combos=(\"\" \"--no-default-features\" \"--all-features\")","-# Every individual feature and the full set, should features ever be added."," for f in $features; do","     combos+=(\"--no-default-features --features $f\")"," done"]},{"oldStart":28,"oldLines":24,"newStart":27,"newLines":24,"lines":[" "," ./build_c_lib.sh > /dev/null || exit 1"," ","+log=$(mktemp)"," fail=0"," for combo in \"${combos[@]}\"; do","     label=\"${combo:-<default features>}\"","-    for cmd in check build; do"