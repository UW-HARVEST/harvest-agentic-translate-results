{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01X45VRKL6LP48CgZPwMgo6m","type":"tool_result","content":"1\t//! Translation of `scene.c` / `scene.h`.\n2\t\n3\tuse std::fs::File;\n4\tuse std::io::Write;\n5\tuse std::os::unix::ffi::OsStrExt;\n6\tuse std::path::Path;\n7\t\n8\tuse crate::cio::{self, CReader, Out};\n9\tuse crate::p;\n10\tuse crate::shape::{fmt_ptr, shape_equals, ShapeManager, ShapeRef};\n11\t\n12\tpub const MAX_SHAPES_IN_SCENE: usize = 50;\n13\tpub const MAX_SCENE_NAME: usize = 64;\n14\t\n15\tpub struct Scene {\n16\t    /// `char name[MAX_SCENE_NAME]`, stored as the raw bytes of the C string.\n17\t    pub name: Vec<u8>,\n18\t    /// `shape_t *shapes[MAX_SHAPES_IN_SCENE]` + `shape_count`.\n19\t    pub shapes: Vec<ShapeRef>,\n20\t}\n21\t\n22\timpl Scene {\n23\t    pub fn shape_count(&self) -> i32 {\n24\t        self.shapes.len() as i32\n25\t    }\n26\t}\n27\t\n28\t/// `scene_create`\n29\tpub fn scene_create(name: Option<&[u8]>) -> Option<Scene> {\n30\t    let name = match name {\n31\t        Some(n) => cio::truncate_to_buffer(n, MAX_SCENE_NAME),\n32\t        None => b\"Untitled Scene\".to_vec(),\n33\t    };\n34\t    Some(Scene {\n35\t        name,\n36\t        shapes: Vec::new(),\n37\t    })\n38\t}\n39\t\n40\t/// `scene_add_shape`\n41\tpub fn scene_add_shape(scene: &mut Scene, shape: Option<ShapeRef>) -> i32 {\n42\t    let shape = match shape {\n43\t        Some(s) => s,\n44\t        None => return -1,\n45\t    };\n46\t\n47\t    if scene.shapes.len() >= MAX_SHAPES_IN_SCENE {\n48\t        cio::err_str(\"Error: Scene is full\\n\");\n49\t        return -1;\n50\t    }\n51\t\n52\t    scene.shapes.push(shape);\n53\t    0\n54\t}\n55\t\n56\t/// `scene_remove_shape`\n57\tpub fn scene_remove_shape(scene: &mut Scene, index: i32) -> i32 {\n58\t    if index < 0 || index >= scene.shape_count() {\n59\t        return -1;\n60\t    }\n61\t\n62\t    scene.shapes.remove(index as usize);\n63\t    0\n64\t}\n65\t\n66\t/// `scene_print`\n67\tpub fn scene_print(out: &mut Out, mgr: &ShapeManager, scene: &Scene) {\n68\t    out.s(\"\\n=== Scene: \");\n69\t    out.b(&scene.name);\n70\t    out.s(\" ===\\n\");\n71\t    p!(out, \"Contains {} shape(s)\\n\\n\", scene.shape_count());\n72\t\n73\t    for i in 0..scene.shape_count() {\n74\t        p!(out, \"Shape #{}:\\n\", i + 1);\n75\t        mgr.print(out, Some(scene.shapes[i as usize]));\n76\t        out.s(\"\\n\");\n77\t    }\n78\t}\n79\t\n80\t/// `scene_equals`\n81\tpub fn scene_equals(s1: &Scene, s2: &Scene) -> i32 {\n82\t    if s1.shape_count() != s2.shape_count() {\n83\t        return 0;\n84\t    }\n85\t\n86\t    let mut matched = [0i32; MAX_SHAPES_IN_SCENE];\n87\t\n88\t    for i in 0..s1.shape_count() as usize {\n89\t        let mut found = 0;\n90\t        for j in 0..s2.shape_count() as usize {\n91\t            if matched[j] == 0 && shape_equals(s1.shapes[i], s2.shapes[j]) != 0 {\n92\t                matched[j] = 1;\n93\t                found = 1;\n94\t                break;\n95\t            }\n96\t        }\n97\t        if found == 0 {\n98\t            return 0;\n99\t        }\n100\t    }\n101\t\n102\t    1\n103\t}\n104\t\n105\t/// `scene_save`\n106\tpub fn scene_save(out: &mut Out, mgr: &ShapeManager, scene: &Scene, filename: &[u8]) -> i32 {\n107\t    let path = Path::new(std::ffi::OsStr::from_bytes(filename));\n108\t    let file = match File::create(path) {\n109\t        Ok(f) => f,\n110\t        Err(_) => {\n111\t            cio::err_bytes(&[\n112\t                b\"Error: Could not open file '\",\n113\t                filename,\n114\t                b\"' for writing\\n\",\n115\t            ]);\n116\t            return -1;\n117\t        }\n118\t    };\n119\t    let mut file = std::io::BufWriter::new(file);\n120\t\n121\t    // Write scene name\n122\t    let _ = file.write_all(&scene.name);\n123\t    let _ = file.write_all(b\"\\n\");\n124\t\n125\t    // Write shape count\n126\t    let _ = file.write_all(format!(\"{}\\n\", scene.shape_count()).as_bytes());\n127\t\n128\t    // Write shape types (not the shapes themselves, just their types)\n129\t    for i in 0..scene.shape_count() as usize {\n130\t        let kind = mgr.shape(scene.shapes[i]).kind;\n131\t        let _ = file.write_all(format!(\"{}\\n\", kind).as_bytes());\n132\t    }\n133\t\n134\t    let _ = file.flush();\n135\t    drop(file);\n136\t\n137\t    out.s(\"Scene saved to '\");\n138\t    out.b(filename);\n139\t    out.s(\"'\\n\");\n140\t    0\n141\t}\n142\t\n143\t/// `scene_load`\n144\tpub fn scene_load(out: &mut Out, mgr: &ShapeManager, filename: &[u8]) -> Option<Scene> {\n145\t    let path = Path::new(std::ffi::OsStr::from_bytes(filename));\n146\t    let file = match File::open(path) {\n147\t        Ok(f) => f,\n148\t        Err(_) => {\n149\t            cio::err_bytes(&[\n150\t                b\"Error: Could not open file '\",\n151\t                filename,\n152\t                b\"' for reading\\n\",\n153\t            ]);\n154\t            return None;\n155\t        }\n156\t    };\n157\t    let mut file = CReader::new(file);\n158\t\n159\t    let name = match file.fgets(MAX_SCENE_NAME) {\n160\t        Some(line) => line,\n161\t        None => return None,\n162\t    };\n163\t\n164\t    // Remove newline\n165\t    let name = cio::strip_newline(&name);\n166\t\n167\t    let mut scene = match scene_create(Some(&name)) {\n168\t        Some(s) => s,\n169\t        None => return None,\n170\t    };\n171\t\n172\t    let shape_count = match file.scan_int() {\n173\t        Some(v) => {\n174\t            file.skip_format_space();\n175\t            v\n176\t        }\n177\t        None => return None,\n178\t    };\n179\t\n180\t    for _ in 0..shape_count {\n181\t        let shape_type = match file.scan_int() {\n182\t            Some(v) => {\n183\t                file.skip_format_space();\n184\t                v\n185\t            }\n186\t            None => return None,\n187\t        };\n188\t\n189\t        let shape = mgr.get(shape_type);\n190\t        if shape.is_some() {\n191\t            scene_add_shape(&mut scene, shape);\n192\t        }\n193\t    }\n194\t\n195\t    out.s(\"Scene loaded from '\");\n196\t    out.b(filename);\n197\t    out.s(\"'\\n\");\n198\t    Some(scene)\n199\t}\n200\t\n201\t/// `scene_list_shapes`\n202\tpub fn scene_list_shapes(out: &mut Out, mgr: &ShapeManager, scene: &Scene) {\n203\t    out.s(\"\\nScene: \");\n204\t    out.b(&scene.name);\n205\t    out.s(\"\\n\");\n206\t    p!(out, \"Shapes ({}):\\n\", scene.shape_count());\n207\t\n208\t    for i in 0..scene.shape_count() as usize {\n209\t        let r = scene.shapes[i];\n210\t        p!(\n211\t            out,\n212\t            \"  {}. {} (ptr: {})\\n\",\n213\t            i + 1,\n214\t            mgr.name(r),\n215\t            fmt_ptr(mgr.addr(r))\n216\t        );\n217\t    }\n218\t}\n219\t"}]},"parent_tool_use_id":null,"session_id":"1a5152e0-686b-4b1f-b4ba-e422e6bc8db0","uuid":"773ccc56-0521-4600-a299-af3bad801e25","timestamp":"2026-08-19T22:54:52.058Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-dYHEnA/translated_rust/src/scene.rs","content":"//! Translation of `scene.c` / `scene.h`.\n\nuse std::fs::File;\nuse std::io::Write;\nuse std::os::unix::ffi::OsStrExt;\nuse std::path::Path;\n\nuse crate::cio::{self, CReader, Out};\nuse crate::p;\nuse crate::shape::{fmt_ptr, shape_equals, ShapeManager, ShapeRef};\n\npub const MAX_SHAPES_IN_SCENE: usize = 50;\npub const MAX_SCENE_NAME: usize = 64;\n\npub struct Scene {\n    /// `char name[MAX_SCENE_NAME]`, stored as the raw bytes of the C string.\n    pub name: Vec<u8>,\n    /// `shape_t *shapes[MAX_SHAPES_IN_SCENE]` + `shape_count`.\n    pub shapes: Vec<ShapeRef>,\n}\n\nimpl Scene {\n    pub fn shape_count(&self) -> i32 {\n        self.shapes.len() as i32\n    }\n}\n\n/// `scene_create`\npub fn scene_create(name: Option<&[u8]>) -> Option<Scene> {\n    let name = match name {\n        Some(n) => cio::truncate_to_buffer(n, MAX_SCENE_NAME),\n        None => b\"Untitled Scene\".to_vec(),\n    };\n    Some(Scene {\n        name,\n        shapes: Vec::new(),\n    })\n}\n\n/// `scene_add_shape`\npub fn scene_add_shape(scene: &mut Scene, shape: Option<ShapeRef>) -> i32 {\n    let shape = match shape {\n        Some(s) => s,\n        None => return -1,\n    };\n\n    if scene.shapes.len() >= MAX_SHAPES_IN_SCENE {\n        cio::err_str(\"Error: Scene is full\\n\");\n        return -1;\n    }\n\n    scene.shapes.push(shape);\n    0\n}\n\n/// `scene_remove_shape`\npub fn scene_remove_shape(scene: &mut Scene, index: i32) -> i32 {\n    if index < 0 || index >= scene.shape_count() {\n        return -1;\n    }\n\n    scene.shapes.remove(index as usize);\n    0\n}\n\n/// `scene_print`\npub fn scene_print(out: &mut Out, mgr: &ShapeManager, scene: &Scene) {\n    out.s(\"\\n=== Scene: \");\n    out.b(&scene.name);\n    out.s(\" ===\\n\");\n    p!(out, \"Contains {} shape(s)\\n\\n\", scene.shape_count());\n\n    for i in 0..scene.shape_count() {\n        p!(out, \"Shape #{}:\\n\", i + 1);\n        mgr.print(out, Some(scene.shapes[i as usize]));\n        out.s(\"\\n\");\n    }\n}\n\n/// `scene_equals`\npub fn scene_equals(s1: &Scene, s2: &Scene) -> i32 {\n    if s1.shape_count() != s2.shape_count() {\n        return 0;\n    }\n\n    let mut matched = [0i32; MAX_SHAPES_IN_SCENE];\n\n    for i in 0..s1.shape_count() as usize {\n        let mut found = 0;\n        for j in 0..s2.shape_count() as usize {\n            if matched[j] == 0 && shape_equals(s1.shapes[i], s2.shapes[j]) != 0 {\n                matched[j] = 1;\n                found = 1;\n                break;\n            }\n        }\n        if found == 0 {\n            return 0;\n        }\n    }\n\n    1\n}\n\n/// `scene_save`\npub fn scene_save(out: &mut Out, mgr: &ShapeManager, scene: &Scene, filename: &[u8]) -> i32 {\n    let path = Path::new(std::ffi::OsStr::from_bytes(filename));\n    let file = match File::create(path) {\n        Ok(f) => f,\n        Err(_) => {\n            cio::err_bytes(&[\n                b\"Error: Could not open file '\",\n                filename,\n                b\"' for writing\\n\",\n            ]);\n            return -1;\n        }\n    };\n    let mut file = std::io::BufWriter::new(file);\n\n    // Write scene name\n    let _ = file.write_all(&scene.name);\n    let _ = file.write_all(b\"\\n\");\n\n    // Write shape count\n    let _ = file.write_all(format!(\"{}\\n\", scene.shape_count()).as_bytes());\n\n    // Write shape types (not the shapes themselves, just their types)\n    for i in 0..scene.shape_count() as usize {\n        let kind = mgr.shape(scene.shapes[i]).kind;\n        let _ = file.write_all(format!(\"{}\\n\", kind).as_bytes());\n    }\n\n    let _ = file.flush();\n    drop(file);\n\n    out.s(\"Scene saved to '\");\n    out.b(filename);\n    out.s(\"'\\n\");\n    0\n}\n\n/// `scene_load`\npub fn scene_load(out: &mut Out, mgr: &ShapeManager, filename: &[u8]) -> Option<Scene> {\n    let path = Path::new(std::ffi::OsStr::from_bytes(filename));\n    let file = match File::open(path) {\n        Ok(f) => f,\n        Err(_) => {\n            cio::err_bytes(&[\n                b\"Error: Could not open file '\",\n                filename,\n                b\"' for reading\\n\",\n            ]);\n            return None;\n        }\n    };\n    let mut file = CReader::new(file);\n\n    let name = match file.fgets(MAX_SCENE_NAME) {\n        Some(line) => line,\n        None => return None,\n    };\n\n    // Remove newline\n    let name = cio::strip_newline(&name);\n\n    let mut scene = match scene_create(Some(&name)) {\n        Some(s) => s,\n        None => return None,\n    };\n\n    let shape_count = match file.scan_int() {\n        Some(v) => {\n            file.skip_format_space();\n            v\n        }\n        None => return None,\n    };\n\n    for _ in 0..shape_count {\n        let shape_type = match file.scan_int() {\n            Some(v) => {\n                file.skip_format_space();\n                v\n            }\n            None => return None,\n        };\n\n        let shape = mgr.get(shape_type);\n        if shape.is_some() {\n            scene_add_shape(&mut scene, shape);\n        }\n    }\n\n    out.s(\"Scene loaded from '\");\n    out.b(filename);\n    out.s(\"'\\n\");\n    Some(scene)\n}\n\n/// `scene_list_shapes`\npub fn scene_list_shapes(out: &mut Out, mgr: &ShapeManager, scene: &Scene) {\n    out.s(\"\\nScene: \");\n    out.b(&scene.name);\n    out.s(\"\\n\");\n    p!(out, \"Shapes ({}):\\n\", scene.shape_count());\n\n    for i in 0..scene.shape_count() as usize {\n        let r = scene.shapes[i];\n        p!(\n            out,\n            \"  {}. {} (ptr: {})\\n\",\n            i + 1,\n            mgr.name(r),\n            fmt_ptr(mgr.addr(r))\n        );\n    }\n}\n","numLines":219,"startLine":1,"totalLines":219}}}
