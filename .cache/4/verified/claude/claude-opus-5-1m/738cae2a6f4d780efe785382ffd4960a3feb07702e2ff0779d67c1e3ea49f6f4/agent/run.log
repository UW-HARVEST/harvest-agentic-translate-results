{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_012Ya8iCv8oXpptkgXjCVE4d","type":"tool_result","content":"1\t//! Small C-stdio compatibility layer.\n2\t//!\n3\t//! The goal of this module is to reproduce, byte for byte, the observable\n4\t//! behaviour of the C standard library calls used by the original program:\n5\t//!\n6\t//!  * `printf` to a *fully buffered* `stdout` (the usual case when stdout is a\n7\t//!    pipe or a file) or a *line buffered* `stdout` (when stdout is a tty),\n8\t//!  * `fgets`, `getchar`, `fscanf(\"%d\")` / `scanf(\"%d\")` and `sscanf(\"%d\")`.\n9\t\n10\tuse std::io::{self, IsTerminal, Read, Write};\n11\t\n12\t/// glibc's default buffer size for a fully buffered stream.\n13\tconst BUFSIZ: usize = 4096;\n14\t\n15\t// ---------------------------------------------------------------------------\n16\t// Output\n17\t// ---------------------------------------------------------------------------\n18\t\n19\t/// A `FILE*`-like buffered writer for stdout.\n20\t///\n21\t/// glibc fills its buffer completely before issuing a `write(2)`, so the exact\n22\t/// same byte stream (and the same chunking) is produced here.  Nothing is\n23\t/// flushed before reading from stdin, exactly like a fully buffered C stream.\n24\tpub struct Out {\n25\t    buf: Vec<u8>,\n26\t    line_buffered: bool,\n27\t}\n28\t\n29\timpl Out {\n30\t    pub fn new() -> Out {\n31\t        let line_buffered = io::stdout().is_terminal();\n32\t        Out {\n33\t            buf: Vec::with_capacity(BUFSIZ),\n34\t            line_buffered,\n35\t        }\n36\t    }\n37\t\n38\t    /// `fwrite` of raw bytes (used for strings that came from user input and\n39\t    /// therefore are not guaranteed to be valid UTF-8).\n40\t    pub fn b(&mut self, data: &[u8]) {\n41\t        let has_newline = self.line_buffered && data.contains(&b'\\n');\n42\t        let mut rest = data;\n43\t        while !rest.is_empty() {\n44\t            let space = BUFSIZ - self.buf.len();\n45\t            let n = if space < rest.len() { space } else { rest.len() };\n46\t            self.buf.extend_from_slice(&rest[..n]);\n47\t            rest = &rest[n..];\n48\t            if self.buf.len() == BUFSIZ {\n49\t                self.flush();\n50\t            }\n51\t        }\n52\t        if has_newline {\n53\t            self.flush();\n54\t        }\n55\t    }\n56\t\n57\t    /// `fputs`/`printf` of an already formatted UTF-8 string.\n58\t    pub fn s(&mut self, text: &str) {\n59\t        self.b(text.as_bytes());\n60\t    }\n61\t\n62\t    pub fn flush(&mut self) {\n63\t        if !self.buf.is_empty() {\n64\t            let stdout = io::stdout();\n65\t            let mut lock = stdout.lock();\n66\t            let _ = lock.write_all(&self.buf);\n67\t            let _ = lock.flush();\n68\t            self.buf.clear();\n69\t        }\n70\t    }\n71\t}\n72\t\n73\t/// `printf`-style helper: `p!(out, \"fmt\", args...)`.\n74\t#[macro_export]\n75\tmacro_rules! p {\n76\t    ($out:expr, $($arg:tt)*) => {\n77\t        $out.s(&format!($($arg)*))\n78\t    };\n79\t}\n80\t\n81\t/// `fprintf(stderr, ...)`: stderr is unbuffered in C.\n82\tpub fn err_bytes(parts: &[&[u8]]) {\n83\t    let stderr = io::stderr();\n84\t    let mut lock = stderr.lock();\n85\t    for part in parts {\n86\t        let _ = lock.write_all(part);\n87\t    }\n88\t    let _ = lock.flush();\n89\t}\n90\t\n91\tpub fn err_str(text: &str) {\n92\t    err_bytes(&[text.as_bytes()]);\n93\t}\n94\t\n95\t// ---------------------------------------------------------------------------\n96\t// Input\n97\t// ---------------------------------------------------------------------------\n98\t\n99\t/// A `FILE*`-like buffered reader (used for both stdin and files opened by the\n100\t/// program).  The EOF indicator is sticky, just like a C stream: once EOF has\n101\t/// been seen, `getchar` keeps returning EOF without touching the fd again.\n102\tpub struct CReader<R: Read> {\n103\t    src: R,\n104\t    buf: Vec<u8>,\n105\t    pos: usize,\n106\t    eof: bool,\n107\t}\n108\t\n109\timpl<R: Read> CReader<R> {\n110\t    pub fn new(src: R) -> CReader<R> {\n111\t        CReader {\n112\t            src,\n113\t            buf: Vec::new(),\n114\t            pos: 0,\n115\t            eof: false,\n116\t        }\n117\t    }\n118\t\n119\t    fn fill(&mut self) -> bool {\n120\t        if self.pos < self.buf.len() {\n121\t            return true;\n122\t        }\n123\t        if self.eof {\n124\t            return false;\n125\t        }\n126\t        self.buf.clear();\n127\t        self.pos = 0;\n128\t        let mut chunk = [0u8; BUFSIZ];\n129\t        loop {\n130\t            match self.src.read(&mut chunk) {\n131\t                Ok(0) => {\n132\t                    self.eof = true;\n133\t                    return false;\n134\t                }\n135\t                Ok(n) => {\n136\t                    self.buf.extend_from_slice(&chunk[..n]);\n137\t                    return true;\n138\t                }\n139\t                Err(ref e) if e.kind() == io::ErrorKind::Interrupted => continue,\n140\t                Err(_) => {\n141\t                    self.eof = true;\n142\t                    return false;\n143\t                }\n144\t            }\n145\t        }\n146\t    }\n147\t\n148\t    /// `getc`: `None` means EOF.\n149\t    pub fn getchar(&mut self) -> Option<u8> {\n150\t        if self.fill() {\n151\t            let c = self.buf[self.pos];\n152\t            self.pos += 1;\n153\t            Some(c)\n154\t        } else {\n155\t            None\n156\t        }\n157\t    }\n158\t\n159\t    /// Peek at the next byte without consuming it (`getc` + `ungetc`).\n160\t    pub fn peek(&mut self) -> Option<u8> {\n161\t        if self.fill() {\n162\t            Some(self.buf[self.pos])\n163\t        } else {\n164\t            None\n165\t        }\n166\t    }\n167\t\n168\t    /// `fgets(buf, size, stream)`.\n169\t    ///\n170\t    /// Reads at most `size - 1` bytes, stopping after a newline (which is kept\n