\t                    from_c(l.js_tryrepr(j, -1, ERRSTR))\n2346\t                ));\n2347\t                l.js_pop(j, 1);\n2348\t                l.js_getglobal(j, N_GV);\n2349\t                r.push_str(&format!(\" after={}\", from_c(l.js_tryrepr(j, -1, ERRSTR))));\n2350\t                l.js_pop(j, 1);\n2351\t                // the C-API write path: js_setglobal on a JS_READONLY global\n2352\t                // throws in strict mode, so go through a protected frame again\n2353\t                l.js_newcfunction(j, Some(cf_setgv), cn!(\"setgv\"), 0);\n2354\t                l.js_pushundefined(j);\n2355\t                let rc3 = l.js_pcall(j, 0);\n2356\t                r.push_str(&format!(\n2357\t                    \" set_rc={rc3} set={}\",\n2358\t                    from_c(l.js_tryrepr(j, -1, ERRSTR))\n2359\t                ));\n2360\t                l.js_pop(j, 1);\n2361\t                // and js_delglobal, which also throws in strict mode\n2362\t                l.js_newcfunction(j, Some(cf_delgv), cn!(\"delgv\"), 0);\n2363\t                l.js_pushundefined(j);\n2364\t                let rc4 = l.js_pcall(j, 0);\n2365\t                r.push_str(&format!(\n2366\t                    \" del_rc={rc4} del={}\",\n2367\t                    from_c(l.js_tryrepr(j, -1, ERRSTR))\n2368\t                ));\n2369\t                l.js_pop(j, 1);\n2370\t                let t = l.js_gettop(j);\n2371\t                r.push_str(&format!(\" finaltop={t}\"));\n2372\t                l.js_pop(j, t);\n2373\t                l.js_freestate(j);\n2374\t                r\n2375\t            });\n2376\t        }\n2377\t    }\n2378\t}\n2379\t\n2380\t/* ====================================================================== */\n2381\t/*  Rows 190-195: js_gc                                                    */\n2382\t/* ====================================================================== */\n2383\t\n2384\t#[test]\n2385\tfn t_gc_report() {\n2386\t    // Rows 190, 191, 192: report 0 vs 1, repeated collections, live vs dead\n2387\t    let scripts = [\n2388\t        \"1+1\",\n2389\t        \"var a = {}; a.b = {c:{d:1}}; 1\",\n2390\t        \"var arr = []; for (var i=0;i<100;++i) arr.push({i:i}); arr.length\",\n2391\t        \"(function(){ var s=''; for (var i=0;i<50;++i) s+='xyzzy'+i; return s.length })()\",\n2392\t        \"var f = function(){ return function(){ return 1 } }; f()()\",\n2393\t        \"for (var i=0;i<50;++i) ({dead:i}); 0\",\n2394\t        \"var re = /a(b)c/g; re.exec('abcabc'); 0\",\n2395\t        \"var d = new Date(0); d.getTime()\",\n2396\t        \"JSON.parse('{\\\"a\\\":[1,2,3]}').a.length\",\n2397\t    ];\n2398\t    let mut saw_report = 0usize;\n2399\t    for src in scripts {\n2400\t        let t = diff2(&format!(\"gc report {src:?}\"), move |l| unsafe {\n2401\t            let j = new_state(l, 0);\n2402\t            let mut r = String::new();\n2403\t            // silent collection first (row 190)\n2404\t            l.js_gc(j, 0);\n2405\t            l.js_gc(j, 0);\n2406\t            let cs = cstr(src);\n2407\t            let rc = l.js_dostring(j, cs.as_ptr());\n2408\t            r.push_str(&format!(\"rc={rc} \"));\n2409\t            // reporting collections; gcmark alternates 1 -> 2 -> 1 (row 192)\n2410\t            for _ in 0..5 {\n2411\t                l.js_gc(j, 1);\n2412\t            }\n2413\t            l.js_gc(j, 0);\n2414\t            l.js_gc(j, 1);\n2415\t            // a second script run reuses the grown gcthresh\n2416\t            let rc2 = l.js_dostring(j, cs.as_ptr());\n2417\t            r.push_str(&format!(\"rc2={rc2} \"));\n2418\t            l.js_gc(j, 1);\n2419\t            r.push_str(&format!(\"top={}\", l.js_gettop(j)));\n2420\t            l.js_freestate(j);\n2421\t            r\n2422\t        });\n2423\t        saw_report += t.matches(\"[report] garbage collected (\").count();\n2424\t        assert!(\n2425\t            t.contains(\"[report] garbage collected (\"),\n2426\t            \"js_gc(J,1) produced no summary for {src:?}: {t}\"\n2427\t        );\n2428\t        assert!(\n2429\t            t.contains(\"envs,\") && t.contains(\"funs,\") && t.contains(\"objs,\")\n2430\t                && t.contains(\"props,\") && t.contains(\"strs\"),\n2431\t            \"unexpected gc summary shape for {src:?}: {t}\"\n2432\t        );\n2433\t    }\n2434\t    assert!(saw_report >= 7 * scripts.len(), \"only {saw_report} summaries\");\n2435\t}\n2436\t\n2437\t#[test]\n2438\tfn t_gc_many_objects() {\n2439\t    // gcthresh growth: create far more objects than the initial threshold\n2440\t    for n in [10, 100, 1000, 5000] {\n2441\t        diff2(&format!(\"gc growth n={n}\"), move |l| unsafe {\n2442\t            let j = new_state(l, 0);\n2443\t            let src = format!(\n2444\t                \"var keep=[]; for (var i=0;i<{n};++i) {{ keep.push({{i:i,s:'value'+i}}); ({{dead:i}}); }} keep.length\"\n2445\t            );\n2446\t            let cs = cstr(&src);\n2447\t            let rc = l.js_dostring(j, cs.as_ptr());\n2448\t            let mut r = format!(\"rc={rc} \");\n2449\t            l.js_gc(j, 1);\n2450\t            l.js_gc(j, 1);\n2451\t            let cs2 = cstr(\"keep = null; 0\");\n2452\t            let rc2 = l.js_dostring(j, cs2.as_ptr());\n2453\t            r.push_str(&format!(\"rc2={rc2} \"));\n2454\t            l.js_gc(j, 1);\n2455\t            l.js_gc(j, 1);\n2456\t            r.push_str(&format!(\"top={}\", l.js_gettop(j)));\n2457\t            l.js_freestate(j);\n2458\t            r\n2459\t        });\n2460\t    }\n2461\t}\n2462\t\n2463\t#[test]\n2464\tfn t_gc_finalizers() {\n2465\t    // Row 193: unreachable JS_CUSERDATA / js_newcfunctionx run their finalizers\n2466\t    // from jsG_freeobject during the sweep; row 195: js_freestate runs the rest.\n2467\t    for keep in [false, true] {\n2468\t        diff2(&format!(\"gc finalizers keep={keep}\"), move |l| unsafe {\n2469\t            let j = new_state(l, 0);\n2470\t            let mut r = String::new();\n2471\t            for i in 0..6 {\n2472\t                l.js_newobject(j);\n2473\t                l.js_newuserdata(j, N_TAG, PAYLOAD as *mut c_void, Some(fin_cb));\n2474\t                if keep && i % 2 == 0 {\n2475\t                    l.js_setglobal(j, N_UD);\n2476\t                } else {\n2477\t                    l.js_pop(j, 1);\n2478\t                }\n2479\t                l.js_newcfunctionx(\n2480\t                    j,\n2481\t                    Some(cf_void),\n2482\t                    N_VOIDF,\n2483\t                    0,\n2484\t                    PAYLOAD as *mut c_void,\n2485\t                    Some(fin_cb),\n2486\t                );\n2487\t                if keep && i % 2 == 1 {\n2488\t                    l.js_setglobal(j, N_VOIDF);\n2489\t                } else {\n2490\t                    l.js_pop(j, 1);\n2491\t                }\n2492\t            }\n2493\t            out_push(b\"--gc1--\\n\");\n2494\t            l.js_gc(j, 1);\n2495\t            out_push(b\"--gc2--\\n\");\n2496\t            l.js_gc(j, 1);\n2497\t            out_push(b\"--free--\\n\");\n2498\t            r.push_str(&format!(\"top={}\", l.js_gettop(j)));\n2499\t            l.js_freestate(j);\n2500\t            r\n2501\t        });\n2502\t    }\n2503\t}\n2504\t\n2505\t#[test]\n2506\tfn t_gc_roots() {\n2507\t    // Row 194: values reachable only from the value stack, only from the\n2508\t    // environments, or only from J->R / J->G\n2509\t    diff2(\"gc roots\", |l| unsafe {\n2510\t        let j = new_state(l, 0);\n2511\t        let mut r = String::new();\n2512\t\n2513\t        // (a) only from the value stack\n2514\t        l.js_newobject(j);\n2515\t        l.js_pushstring(j, cn!(\"stack-only-string-value\"));\n2516\t        l.js_setproperty(j, -2, N_X);\n2517\t        l.js_gc(j, 1);\n2518\t        l.js_getproperty(j, -1, N_X);\n2519\t        r.push_str(&format!(\"stack={} \", from_c(l.js_tryrepr(j, -1, ERRSTR))));\n2520\t        l.js_pop(j, 1);\n2521\t\n2522\t        // (b) only from J->R\n2523\t        l.js_newobject(j);\n2524\t        l.js_pushstring(j, cn!(\"registry-only-string-value\"));\n2525\t        l.js_setproperty(j, -2, N_X);\n2526\t        l.js_setregistry(j, cn!(\"keeper\"));\n2527\t        l.js_gc(j, 1);\n2528\t        l.js_getregistry(j, cn!(\"keeper\"));\n2529\t        l.js_getproperty(j, -1, N_X);\n2530\t        r.push_str(&format!(\"registry={} \", from_c(l.js_tryrepr(j, -1, ERRSTR))));\n2531\t        l.js_pop(j, 2);\n2532\t\n2533\t        // (c) only from J->G\n2534\t        l.js_newobject(j);\n2535\t        l.js_pushstring(j, cn!(\"global-only-string-value\"));\n2536\t        l.js_setproperty(j, -2, N_X);\n2537\t        l.js_setglobal(j, cn!(\"keeper2\"));\n2538\t        l.js_gc(j, 1);\n2539\t        l.js_getglobal(j, cn!(\"keeper2\"));\n2540\t        l.js_getproperty(j, -1, N_X);\n2541\t        r.push_str(&format!(\"global={} \", from_c(l.js_tryrepr(j, -1, ERRSTR))));\n2542\t        l.js_pop(j, 2);\n2543\t\n2544\t        // (d) only from J->E / GE (a var binding), collected mid-run\n2545\t        let cs = cstr(\n2546\t            \"var envkeep = {s:'env-only-string-value'};\\n\\\n2547\t             (function(){ var inner = {t:'closure-only'}; return function(){ return inner.t } })();\\n\\\n2548\t             envkeep.s\",\n2549\t        );\n2550\t        let rc = l.js_dostring(j, cs.as_ptr());\n2551\t        l.js_gc(j, 1);\n2552\t        l.js_gc(j, 1);\n2553\t        let cs2 = cstr(\"print(envkeep.s)\");\n2554\t        let rc2 = l.js_dostring(j, cs2.as_ptr());\n2555\t        r.push_str(&format!(\"rc={rc} rc2={rc2} top={} \", l.js_gettop(j)));\n2556\t\n2557\t        // (e) after dropping every root the objects go away\n2558\t        l.js_delregistry(j, cn!(\"keeper\"));\n2559\t        l.js_delglobal(j, cn!(\"keeper2\"));\n2560\t        l.js_pop(j, l.js_gettop(j));\n2561\t        l.js_gc(j, 1);\n2562\t        l.js_gc(j, 1);\n2563\t        r.push_str(&format!(\"end={}\", l.js_gettop(j)));\n2564\t        l.js_freestate(j);\n2565\t        r\n2566\t    });\n2567\t}\n2568\t\n2569\t/// A randomised walk over the operations that move objects in and out of the\n2570\t/// GC roots, comparing the exact `js_gc(J, 1)` summary (env / fun / obj / prop /\n2571\t/// str counts and the percentage) after every step.  This is the sharpest check\n2572\t/// on the GC bookkeeping: any difference in how many objects, properties or\n2573\t/// interned strings the two implementations create shows up immediately.\n2574\t#[test]\n2575\tfn t_gc_random_walk() {\n2576\t    const WNAMES: [*const c_char; 8] = [\n2577\t        cn!(\"w0\"),\n2578\t        cn!(\"w1\"),\n2579\t        cn!(\"w2\"),\n2580\t        cn!(\"w3\"),\n2581\t        cn!(\"w4\"),\n2582\t        cn!(\"w5\"),\n2583\t        cn!(\"w6\"),\n2584\t        cn!(\"w7\"),\n2585\t    ];\n2586\t    const WSRC: [&str; 8] = [\n2587\t        \"var q = {a:1,b:[1,2,3]}; 0\",\n2588\t        \"(function(){ var c = {x:'y'}; return function(){ return c.x } })()\",\n2589\t        \"var s=''; for (var i=0;i<20;++i) s += 'chunk'+i; s.length\",\n2590\t        \"var re = /a(b+)c/g; re.exec('abbbc'); 0\",\n2591\t        \"for (var i=0;i<30;++i) ({dead:i}); 0\",\n2592\t        \"q = null; 0\",\n2593\t        \"JSON.stringify({z:[1,2,3,'four']})\",\n2594\t        \"new Date(0).getTime()\",\n2595\t    ];\n2596\t    let mut rng = Rng::new(0xFEED_FACE);\n2597\t    let mut nreports = 0usize;\n2598\t    for round in 0..24 {\n2599\t        let ops: Vec<u32> = (0..48).map(|_| rng.next_u32()).collect();\n2600\t        let t = diff2(&format!(\"gc walk {round}\"), move |l| unsafe {\n2601\t            let j = new_state(l, 0);\n2602\t            let mut nstack = 0i32;\n2603\t            let mut r = String::new();\n2604\t            for (i, op) in ops.iter().enumerate() {\n2605\t                let name = WNAMES[i % WNAMES.len()];\n2606\t                match op % 14 {\n2607\t                    0 => {\n2608\t                        l.js_newobject(j);\n2609\t                        nstack += 1;\n2610\t                    }\n2611\t                    1 => {\n2612\t                        l.js_newarray(j);\n2613\t                        nstack += 1;\n2614\t                    }\n2615\t                    2 => {\n2616\t                        l.js_pushstring(j, cn!(\"a heap string longer than fifteen bytes\"));\n2617\t                        nstack += 1;\n2618\t                    }\n2619\t                    3 => {\n2620\t                        l.js_pushnumber(j, i as f64);\n2621\t                        nstack += 1;\n2622\t                    }\n2623\t                    4 => {\n2624\t                        if nstack > 0 {\n2625\t                            l.js_pop(j, 1);\n2626\t                            nstack -= 1;\n2627\t                        }\n2628\t                    }\n2629\t                    5 => l.js_gc(j, 1),\n2630\t                    6 => l.js_gc(j, 0),\n2631\t                    7 => {\n2632\t                        let cs = cstr(WSRC[(op / 14) as usize % WSRC.len()]);\n2633\t                        let rc = l.js_dostring(j, cs.as_ptr());\n2634\t                        r.push_str(&format!(\"do{i}={rc} \"));\n2635\t                    }\n2636\t                    8 => {\n2637\t                        if nstack > 0 {\n2638\t                            l.js_setglobal(j, name);\n2639\t                            nstack -= 1;\n2640\t                        }\n2641\t                    }\n2642\t                    9 => l.js_delglobal(j, name),\n2643\t                    10 => {\n2644\t                        if nstack > 0 {\n2645\t                            l.js_setregistry(j, name);\n2646\t                            nstack -= 1;\n2647\t                        }\n2648\t                    }\n2649\t                    11 => l.js_delregistry(j, name),\n2650\t                    12 => {\n2651\t                        l.js_newobject(j);\n2652\t                        l.js_newuserdata(j, N_TAG, PAYLOAD as *mut c_void, Some(fin_cb));\n2653\t                        nstack += 1;\n2654\t                    }\n2655\t                    _ => {\n2656\t                        l.js_newcfunctionx(\n2657\t                            j,\n2658\t                            Some(cf_void),\n2659\t                            N_VOIDF,\n2660\t                            0,\n2661\t                            PAYLOAD as *mut c_void,\n2662\t                            Some(fin_cb),\n2663\t                        );\n2664\t                        nstack += 1;\n2665\t                    }\n2666\t                }\n2667\t                r.push_str(&format!(\"{}:{} \", i, l.js_gettop(j)));\n2668\t            }\n2669\t            drain_to(l, j, 0);\n2670\t            l.js_gc(j, 1);\n2671\t            l.js_gc(j, 1);\n2672\t            r.push_str(&format!(\"end={}\", l.js_gettop(j)));\n2673\t            l.js_freestate(j);\n2674\t            r\n2675\t        });\n2676\t        nreports += t.matches(\"garbage collected (\").count();\n2677\t    }\n2678\t    assert!(nreports > 100, \"only {nreports} gc summaries in the walk\");\n2679\t}\n2680\t\n2681\t/// The report hook must receive the message pointer verbatim, whatever bytes it\n2682\t/// holds (`js_defaultreport` only does `fputs`).\n2683\t#[test]\n2684\tfn t_report_raw_bytes() {\n2685\t    let p = libs();\n2686\t    let mut rng = Rng::new(0x00FF_1234);\n2687\t    for _ in 0..60 {\n2688\t        let mut msg = rng.raw_bytes(60);\n2689\t        msg.push(0);\n2690\t        let mut got = vec![];\n2691\t        for l in [&p.c, &p.rs] {\n2692\t            out_clear();\n2693\t            unsafe {\n2694\t                set_cur(l);\n2695\t                let j = new_state(l, 0);\n2696\t                l.js_report(j, msg.as_ptr() as *const c_char);\n2697\t                l.js_setreport(j, None);\n2698\t                l.js_report(j, msg.as_ptr() as *const c_char);\n2699\t                l.js_freestate(j);\n2700\t            }\n2701\t            got.push(out_take());\n2702\t        }\n2703\t        assert_eq!(got[0], got[1], \"raw report divergence for {msg:?}\");\n2704\t        // exactly one delivery: the second js_report is a no-op\n2705\t        assert_eq!(got[0].matches(\"[report] \").count(), 1, \"{:?}\", got[0]);\n2706\t    }\n2707\t}\n2708\t\n2709\t/* ====================================================================== */\n2710\t/*  Rows 20, 196, 197: the try stack                                       */\n2711\t/* ====================================================================== */\n2712\t\n2713\t#[test]\n2714\tfn t_trylimit_savetry() {\n2715\t    // Row 196: js_savetry at depth 0..JS_TRYLIMIT-1 is fine.  We never push a\n2716\t    // 65th frame (that would throw into a jmp_buf we never setjmp'd), we go to\n2717\t    // exactly 64 and then use the protected entry points, whose js_ptry guard\n2718\t    // returns without throwing (rows 20 and the js_dostring/js_trystring twins).\n2719\t    for depth in [0, 1, 2, 32, 62, 63, 64] {\n2720\t        diff2(&format!(\"savetry depth={depth}\"), move |l| unsafe {\n2721\t            let j = new_state(l, 0);\n2722\t            for _ in 0..depth {\n2723\t                let b = l.js_savetry(j);\n2724\t                assert!(!b.is_null(), \"{}: js_savetry returned NULL\", l.name);\n2725\t            }\n2726\t            let mut r = String::new();\n2727\t            let good = cstr(\"1+2*3\");\n2728\t            let bad = cstr(\"this is ((( not js\");\n2729\t\n2730\t            let base = l.js_gettop(j);\n2731\t            let rc = l.js_ploadstring(j, FILENAME, good.as_ptr());\n2732\t            r.push_str(&format!(\"load_good={rc} {} \", safeview(l, j)));\n2733\t            drain_to(l, j, base);\n2734\t\n2735\t            let rc = l.js_ploadstring(j, FILENAME, bad.as_ptr());\n2736\t            r.push_str(&format!(\"load_bad={rc} {} \", safeview(l, j)));\n2737\t            drain_to(l, j, base);\n2738\t\n2739\t            let rc = l.js_dostring(j, good.as_ptr());\n2740\t            r.push_str(&format!(\"do_good={rc} top={} \", l.js_gettop(j)));\n2741\t            drain_to(l, j, base);\n2742\t            let rc = l.js_dostring(j, bad.as_ptr());\n2743\t            r.push_str(&format!(\"do_bad={rc} top={} \", l.js_gettop(j)));\n2744\t            drain_to(l, j, base);\n2745\t\n2746\t            // js_trystring / js_trynumber / js_tryinteger / js_tryboolean all\n2747\t            // carry the js_ptry guard, and that guard *pops* one value before\n2748\t            // returning the caller's default.\n2749\t            l.js_newobject(j);\n2750\t            let s = from_c(l.js_trystring(j, -1, cn!(\"DEFAULT\")));\n2751\t            r.push_str(&format!(\"trystring={s} d={} \", l.js_gettop(j) - base));\n2752\t            drain_to(l, j, base);\n2753\t\n2754\t            l.js_newobject(j);\n2755\t            let n = l.js_trynumber(j, -1, -1.0);\n2756\t            r.push_str(&format!(\n2757\t                \"trynumber={} d={} \",\n2758\t                fbits(n),\n2759\t                l.js_gettop(j) - base\n2760\t            ));\n2761\t            drain_to(l, j, base);\n2762\t\n2763\t            l.js_newobject(j);\n2764\t            let i = l.js_tryinteger(j, -1, -1);\n2765\t            r.push_str(&format!(\"tryint={i} d={} \", l.js_gettop(j) - base));\n2766\t            drain_to(l, j, base);\n2767\t\n2768\t            l.js_newobject(j);\n2769\t            let b = l.js_tryboolean(j, -1, -1);\n2770\t            r.push_str(&format!(\"trybool={b} d={} \", l.js_gettop(j) - base));\n2771\t            drain_to(l, j, base);\n2772\t\n2773\t            r.push_str(&format!(\"top={} \", l.js_gettop(j)));\n2774\t            for _ in 0..depth {\n2775\t                l.js_endtry(j);\n2776\t            }\n2777\t            // and everything works again once the frames are gone\n2778\t            let rc = l.js_dostring(j, good.as_ptr());\n2779\t            r.push_str(&format!(\"after={rc} top={}\", l.js_gettop(j)));\n2780\t            l.js_freestate(j);\n2781\t            r\n2782\t        });\n2783\t    }\n2784\t}\n2785\t\n2786\t#[test]\n2787\tfn t_trylimit_nested_js() {\n2788\t    with_big_stack(body_t_trylimit_nested_js);\n2789\t}\n2790\t\n2791\tfn body_t_trylimit_nested_js() {\n2792\t    // Row 196 second half: js_savetrypc at trytop == JS_TRYLIMIT calls\n2793\t    // js_trystackoverflow, which pushes the bare literal\n2794\t    // \"exception stack overflow\" and throws into the enclosing frame.\n2795\t    for n in [1usize, 2, 10, 32, 60, 62, 63, 64, 65, 66, 70, 80, 120, 200] {\n2796\t        let t = diff2(&format!(\"nested try n={n}\"), move |l| unsafe {\n2797\t            let j = new_state(l, 0);\n2798\t            let mut src = String::new();\n2799\t            for _ in 0..n {\n2800\t                src.push_str(\"try { \");\n2801\t            }\n2802\t            src.push_str(\"print('inner reached')\");\n2803\t            for i in 0..n {\n2804\t                src.push_str(&format!(\" }} catch (e{i}) {{ print('catch {i}', e{i}) }}\"));\n2805\t            }\n2806\t            let cs = cstr(&src);\n2807\t            let rc = l.js_dostring(j, cs.as_ptr());\n2808\t            let r = format!(\"rc={rc} top={}\", l.js_gettop(j));\n2809\t            l.js_freestate(j);\n2810\t            r\n2811\t        });\n2812\t        // js_dostring already holds one try frame, so the script itself only\n2813\t        // has JS_TRYLIMIT-1 = 63 left before js_savetrypc hits the limit.\n2814\t        if n <= 63 {\n2815\t            assert!(\n2816\t                t.contains(\"inner reached\") && !t.contains(\"exception stack overflow\"),\n2817\t                \"n={n} should stay under the try limit: {t}\"\n2818\t            );\n2819\t        } else {\n2820\t            assert!(\n2821\t                t.contains(\"exception stack overflow\"),\n2822\t                \"n={n} should have overflowed the try stack: {t}\"\n2823\t            );\n2824\t        }\n2825\t    }\n2826\t}\n2827\t\n2828\t#[test]\n2829\tfn t_trylimit_nested_pcall() {\n2830\t    with_big_stack(body_t_trylimit_nested_pcall);\n2831\t}\n2832\t\n2833\tfn body_t_trylimit_nested_pcall() {\n2834\t    // Each js_pcall level adds one try frame, so at level 65 js_savetry hits the\n2835\t    // limit and throws into level 64.  Reaching exactly 64 lets js_ploadstring /\n2836\t    // js_dostring see trytop == JS_TRYLIMIT (rows 20, 196).\n2837\t    for target in [1i32, 2, 32, 63, 64, 65, 70] {\n2838\t        let t = diff2(&format!(\"nested pcall target={target}\"), move |l| unsafe {\n2839\t            let j = new_state(l, 0);\n2840\t            REC_TARGET.with(|c| c.set(target));\n2841\t            REC_DEPTH.with(|c| c.set(0));\n2842\t            l.js_newcfunction(j, Some(cf_rec), N_REC, 0);\n2843\t            l.js_setglobal(j, N_REC);\n2844\t            l.js_getglobal(j, N_REC);\n2845\t            l.js_pushundefined(j);\n2846\t            let rc = l.js_pcall(j, 0);\n2847\t            let r = format!(\n2848\t                \"rc={rc} {} depth_left={}\",\n2849\t                snap(l, j),\n2850\t                REC_DEPTH.with(|c| c.get())\n2851\t            );\n2852\t            l.js_pop(j, 1);\n2853\t            l.js_freestate(j);\n2854\t            r\n2855\t        });\n2856\t        if target <= 64 {\n2857\t            assert!(\n2858\t                t.contains(&format!(\"at depth {target}: ploadstring\")),\n2859\t                \"target={target} never reached the innermost frame: {t}\"\n2860\t            );\n2861\t        }\n2862\t        if target == 64 {\n2863\t            // js_ptry fires: rc=1 and the bare literal is pushed\n2864\t            assert!(\n2865\t                t.contains(\"ploadstring rc=1\") && t.contains(\"exception stack overflow\"),\n2866\t                \"target=64 should hit the js_ptry guard: {t}\"\n2867\t            );\n2868\t        }\n2869\t        if target == 65 || target == 70 {\n2870\t            assert!(\n2871\t                t.contains(\"exception stack overflow\"),\n2872\t                \"target={target} should overflow the try stack: {t}\"\n2873\t            );\n2874\t        }\n2875\t    }\n2876\t}\n2877\t\n2878\t/// A randomised walk over `js_savetry` / `js_endtry` interleaved with the\n2879\t/// protected entry points.  The walk never asks for a 65th frame (no `setjmp`\n2880\t/// stands behind these frames) and never calls `js_endtry` at depth 0 (that\n2881\t/// raises js_error \"endtry: exception stack underflow\" with `trytop == 0`, which\n2882\t/// would panic and abort).\n2883\t#[test]\n2884\tfn t_savetry_random_walk() {\n2885\t    let mut rng = Rng::new(0x7175_5259);\n2886\t    for round in 0..40 {\n2887\t        let ops: Vec<u32> = (0..90).map(|_| rng.next_u32()).collect();\n2888\t        diff2(&format!(\"savetry walk {round}\"), move |l| unsafe {\n2889\t            let j = new_state(l, 0);\n2890\t            let good = cstr(\"var wv = 1; wv + 2\");\n2891\t            let bad = cstr(\"nope ((( nope\");\n2892\t            let mut depth = 0i32;\n2893\t            let mut r = String::new();\n2894\t            for (i, op) in ops.iter().enumerate() {\n2895\t                let base = l.js_gettop(j);\n2896\t                match op % 10 {\n2897\t                    0 => {\n2898\t                        if depth < 64 {\n2899\t                            let b = l.js_savetry(j);\n2900\t                            assert!(!b.is_null());\n2901\t                            depth += 1;\n2902\t                        }\n2903\t                    }\n2904\t                    1 => {\n2905\t                        if depth > 0 {\n2906\t                            l.js_endtry(j);\n2907\t                            depth -= 1;\n2908\t                        }\n2909\t                    }\n2910\t                    2 => {\n2911\t                        let rc = l.js_ploadstring(j, FILENAME, good.as_ptr());\n2912\t                        r.push_str(&format!(\"{i}:lg={rc},{} \", safeview(l, j)));\n2913\t                        drain_to(l, j, base);\n2914\t                    }\n2915\t                    3 => {\n2916\t                        let rc = l.js_ploadstring(j, FILENAME, bad.as_ptr());\n2917\t                        r.push_str(&format!(\"{i}:lb={rc},{} \", safeview(l, j)));\n2918\t                        drain_to(l, j, base);\n2919\t                    }\n2920\t                    4 => {\n2921\t                        let rc = l.js_dostring(j, good.as_ptr());\n2922\t                        r.push_str(&format!(\"{i}:dg={rc},{} \", l.js_gettop(j) - base));\n2923\t                        drain_to(l, j, base);\n2924\t                    }\n2925\t                    5 => {\n2926\t                        let rc = l.js_dostring(j, bad.as_ptr());\n2927\t                        r.push_str(&format!(\"{i}:db={rc},{} \", l.js_gettop(j) - base));\n2928\t                        drain_to(l, j, base);\n2929\t                    }\n2930\t                    6 => {\n2931\t                        l.js_newobject(j);\n2932\t                        let v = from_c(l.js_trystring(j, -1, cn!(\"DEF\")));\n2933\t                        r.push_str(&format!(\"{i}:ts={v},{} \", l.js_gettop(j) - base));\n2934\t                        drain_to(l, j, base);\n2935\t                    }\n2936\t                    7 => {\n2937\t                        l.js_newarray(j);\n2938\t                        let v = l.js_tryinteger(j, -1, -9);\n2939\t                        r.push_str(&format!(\"{i}:ti={v},{} \", l.js_gettop(j) - base));\n2940\t                        drain_to(l, j, base);\n2941\t                    }\n2942\t                    8 => l.js_gc(j, 1),\n2943\t                    _ => {\n2944\t                        l.js_pushstring(j, cn!(\"a value that lives on the stack\"));\n2945\t                        drain_to(l, j, base);\n2946\t                    }\n2947\t                }\n2948\t                r.push_str(&format!(\"d{depth} \"));\n2949\t            }\n2950\t            for _ in 0..depth {\n2951\t                l.js_endtry(j);\n2952\t            }\n2953\t            drain_to(l, j, 0);\n2954\t            let rc = l.js_dostring(j, good.as_ptr());\n2955\t            r.push_str(&format!(\"final={rc} top={}\", l.js_gettop(j)));\n2956\t            l.js_freestate(j);\n2957\t            r\n2958\t        });\n2959\t    }\n2960\t}\n2961\t\n2962\t/// Deep native recursion: the trace stack (`JS_ENVLIMIT` = 1024) and the try\n2963\t/// stack (`JS_TRYLIMIT` = 64) run out at very different depths, and both errors\n2964\t/// have to be reported identically.\n2965\t#[test]\n2966\tfn t_deep_recursion() {\n2967\t    with_big_stack(body_t_deep_recursion);\n2968\t}\n2969\t\n2970\tfn body_t_deep_recursion() {\n2971\t    let srcs = [\n2972\t        // bounded recursion, well under every limit\n2973\t        \"function r(n){ return n<=0 ? 0 : r(n-1)+1 } print(r(100))\",\n2974\t        \"function r(n){ return n<=0 ? 0 : r(n-1)+1 } print(r(500))\",\n2975\t        // unbounded recursion -> \"call stack overflow\" from jsR_pushtrace\n2976\t        \"function r(n){ return r(n+1) } try { r(0) } catch (e) { print('caught', e) }\",\n2977\t        // one try frame per level -> \"exception stack overflow\" first\n2978\t        \"function r(n){ try { return r(n+1) } catch (e) { return 'c'+n+':'+e } } print(r(0))\",\n2979\t        \"function r(n){ try { return r(n+1) } finally { } } try { print(r(0)) } catch (e) { print('caught', e) }\",\n2980\t        // and mutual recursion through a cfunction boundary\n2981\t        \"function r(n){ return n<=0 ? [] : r(n-1).concat([n]) } print(r(60).length)\",\n2982\t        // deep expression nesting inside a try\n2983\t        \"try { print(eval('1' + '+1'.repeat(200))) } catch (e) { print('caught', e) }\",\n2984\t    ];\n2985\t    for flags in [0, JS_STRICT] {\n2986\t        for src in srcs {\n2987\t            diff_dostring(flags, src);\n2988\t            diff_eval(flags, src);\n2989\t        }\n2990\t    }\n2991\t    // the same, but with the recursion happening under N pre-existing try frames\n2992\t    for depth in [0, 30, 60, 63, 64] {\n2993\t        diff2(&format!(\"deep under {depth} frames\"), move |l| unsafe {\n2994\t            let j = new_state(l, 0);\n2995\t            for _ in 0..depth {\n2996\t                l.js_savetry(j);\n2997\t            }\n2998\t            let cs = cstr(\"function r(n){ try { return r(n+1) } catch (e) { return 'c'+n } } r(0)\");\n2999\t            let rc = l.js_dostring(j, cs.as_ptr());\n3000\t            let mut r = format!(\"rc={rc} top={}\", l.js_gettop(j));\n3001\t            drain_to(l, j, 0);\n3002\t            for _ in 0..depth {\n3003\t                l.js_endtry(j);\n3004\t            }\n3005\t            let rc2 = l.js_dostring(j, cs.as_ptr());\n3006\t            r.push_str(&format!(\" rc2={rc2} top={}\", l.js_gettop(j)));\n3007\t            l.js_freestate(j);\n3008\t            r\n3009\t        });\n3010\t    }\n3011\t}\n3012\t\n3013\t#[test]\n3014\tfn t_throw_restores_strict() {\n3015\t    // Row 197: js_throw restores strict / top / bot / E / envtop / tracetop from\n3016\t    // the frame, so a strict-mode switch made by the aborted call is rolled back\n3017\t    let srcs = [\n3018\t        \"function f(){ 'use strict'; throw new Error('x') }\\n\\\n3019\t         try { f() } catch (e) { print('caught', e) }\\n\\\n3020\t         zz = 1; print('nonstrict still works', zz)\",\n3021\t        \"function f(){ 'use strict'; undeclared_in_strict = 1 }\\n\\\n3022\t         try { f() } catch (e) { print('caught', e) }\\n\\\n3023\t         zz2 = 2; print(zz2)\",\n3024\t        \"function g(){ 'use strict'; return (function(){ throw 'deep' })() }\\n\\\n3025\t         try { g() } catch (e) { print('caught', e) }\\n\\\n3026\t         print(typeof this, (function(){ return typeof this })())\",\n3027\t        \"try { (function(){ 'use strict'; (function(){ 'use strict'; throw 1 })() })() }\\n\\\n3028\t         catch (e) { print('c', e) }\\n\\\n3029\t         zz3 = 3; print(zz3)\",\n3030\t        \"var log=[];\\n\\\n3031\t         function h(n){ log.push(n); if (n>3) { 'use strict'; throw new Error('deep'+n) } return h(n+1) }\\n\\\n3032\t         try { h(0) } catch (e) { print('caught', e) }\\n\\\n3033\t         print(log.join(','));\\n\\\n3034\t         zz4 = 4; print(zz4)\",\n3035\t    ];\n3036\t    for flags in [0, JS_STRICT] {\n3037\t        for src in srcs {\n3038\t            diff_dostring(flags, src);\n3039\t            diff_eval(flags, src);\n3040\t        }\n3041\t    }\n3042\t}\n3043\t\n3044\t/* ====================================================================== */\n3045\t/*  Row 195: js_freestate                                                  */\n3046\t/* ====================================================================== */\n3047\t\n3048\t#[test]\n3049\tfn t_freestate_runs_everything() {\n3050\t    let p = libs();\n3051\t    let scripts = [\n3052\t        \"1+1\",\n3053\t        \"var a=[]; for (var i=0;i<500;++i) a.push({i:i,s:'value'+i}); a.length\",\n3054\t        \"var re=/(a+)(b+)/g; re.exec('aaabbb'); 0\",\n3055\t        \"var s = new String('a string that is definitely longer than fifteen bytes'); s.length\",\n3056\t        \"var it = {a:1,b:2}; var n=0; for (var k in it) ++n; n\",\n3057\t        \"new Date(12345).toString().length > 0\",\n3058\t        \"JSON.stringify({a:[1,2,{b:'c'}]})\",\n3059\t    ];\n3060\t    for src in scripts {\n3061\t        for l in [&p.c, &p.rs] {\n3062\t            let mut cx = Actx::new(0);\n3063\t            let ap = &mut *cx as *mut Actx as *mut c_void;\n3064\t            unsafe {\n3065\t                out_clear();\n3066\t                set_cur(l);\n3067\t                let j = l.js_newstate(Some(tracking_alloc), ap, 0);\n3068\t                assert!(!j.is_null());\n3069\t                l.js_setreport(j, Some(report_cb));\n3070\t                // a userdata and a cfunctionx whose finalizers must run\n3071\t                l.js_newobject(j);\n3072\t                l.js_newuserdata(j, N_TAG, PAYLOAD as *mut c_void, Some(fin_cb));\n3073\t                l.js_set