o_rules! jsC_error {\n193\t    ($J:expr, $node:expr, $($a:expr),*) => {{\n194\t        jsfmt256!(buf__, $($a),*);\n195\t        crate::jscompile::jsC_error_str($J, $node, buf__.as_ptr())\n196\t    }};\n197\t}\n198\t\n199\t\n200\t/// `setjmp(js_savetry(J))`\n201\tmacro_rules! js_try {\n202\t    ($J:expr) => {\n203\t        crate::jsi::_setjmp(crate::jsrun::js_savetry($J) as *mut crate::jsi::jmp_buf) != 0\n204\t    };\n205\t}\n206\t\n207\t/// `setjmp(js_savetrypc(J, PC))`\n208\tmacro_rules! js_trypc {\n209\t    ($J:expr, $pc:expr) => {\n210\t        crate::jsi::_setjmp(crate::jsrun::js_savetrypc($J, $pc) as *mut crate::jsi::jmp_buf) != 0\n211\t    };\n212\t}\n213\t\n214\t/* ================================================================ *\n215\t * Modules -- one per C source file.\n216\t * ================================================================ */\n217\t\n218\tpub mod jsarray;\n219\tpub mod jsboolean;\n220\tpub mod jsbuiltin;\n221\tpub mod jscompile;\n222\tpub mod jsdate;\n223\tpub mod jsdtoa;\n224\tpub mod jserror;\n225\tpub mod jsfunction;\n226\tpub mod jsgc;\n227\tpub mod jsintern;\n228\tpub mod jslex;\n229\tpub mod jsmath;\n230\tpub mod jsnumber;\n231\tpub mod jsobject;\n232\tpub mod json;\n233\tpub mod jsparse;\n234\tpub mod jsproperty;\n235\tpub mod jsregexp;\n236\tpub mod jsrepr;\n237\tpub mod jsrun;\n238\tpub mod jsstate;\n239\tpub mod jsstring;\n240\tpub mod jsvalue;\n241\tpub mod regexp;\n242\tpub mod utf;\n243\tpub mod utfdata;\n244\t\n245\t/// Everything that is a non-static function in the C sources, flattened into\n246\t/// one namespace so that translated modules can call each other exactly the\n247\t/// way the C code does.\n248\tpub mod prelude {\n249\t    pub use crate::jsarray::*;\n250\t    pub use crate::jsboolean::*;\n251\t    pub use crate::jsbuiltin::*;\n252\t    pub use crate::jscompile::*;\n253\t    pub use crate::jsdate::*;\n254\t    pub use crate::jsdtoa::*;\n255\t    pub use crate::jserror::*;\n256\t    pub use crate::jsfunction::