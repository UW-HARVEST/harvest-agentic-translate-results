{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01UB6SRwaaPhDjyBie2uWZAU","type":"tool_result","content":"1\t//! Differential test harness: loads BOTH the C `libmujs.so` and the Rust\n2\t//! `libmujs.so` through `libloading` and calls every entry point purely\n3\t//! through the exported FFI symbols.\n4\t#![allow(dead_code, non_snake_case, non_camel_case_types)]\n5\t\n6\tuse libloading::{Library, Symbol};\n7\tuse std::cell::{Cell, RefCell};\n8\tuse std::ffi::{c_char, c_int, c_short, c_uint, c_ushort, c_void, CStr, CString};\n9\tuse std::path::PathBuf;\n10\t\n11\tpub type JS = *mut c_void; // js_State *\n12\tpub type Rune = c_int;\n13\t\n14\tpub type js_Alloc = Option<unsafe extern \"C\" fn(*mut c_void, *mut c_void, c_int) -> *mut c_void>;\n15\tpub type js_CFunction = Option<unsafe extern \"C\" fn(JS)>;\n16\tpub type js_Finalize = Option<unsafe extern \"C\" fn(JS, *mut c_void)>;\n17\tpub type js_Report = Option<unsafe extern \"C\" fn(JS, *const c_char)>;\n18\tpub type js_Panic = Option<unsafe extern \"C\" fn(JS)>;\n19\tpub type js_HasProperty = Option<unsafe extern \"C\" fn(JS, *mut c_void, *const c_char) -> c_int>;\n20\tpub type js_Put = Option<unsafe extern \"C\" fn(JS, *mut c_void, *const c_char) -> c_int>;\n21\tpub type js_Delete = Option<unsafe extern \"C\" fn(JS, *mut c_void, *const c_char) -> c_int>;\n22\t\n23\t/* ------------------------------------------------------------ constants */\n24\t\n25\tpub const JS_STRICT: c_int = 1;\n26\t\n27\tpub const JS_REGEXP_G: c_int = 1;\n28\tpub const JS_REGEXP_I: c_int = 2;\n29\tpub const JS_REGEXP_M: c_int = 4;\n30\t\n31\tpub const JS_READONLY: c_int = 1;\n32\tpub const JS_DONTENUM: c_int = 2;\n33\tpub const JS_DONTCONF: c_int = 4;\n34\t\n35\tpub const JS_ISUNDEFINED: c_int = 0;\n36\tpub const JS_ISNULL: c_int = 1;\n37\tpub const JS_ISBOOLEAN: c_int = 2;\n38\tpub const JS_ISNUMBER: c_int = 3;\n39\tpub const JS_ISSTRING: c_int = 4;\n40\tpub const JS_ISFUNCTION: c_int = 5;\n41\tpub const JS_ISOBJECT: c_int = 6;\n42\t\n43\tpub const REG_ICASE: c_int = 1;\n44\tpub const REG_NEWLINE: c_int = 2;\n45\tpub const REG_NOTBOL: c_int = 4;\n46\t\n47\tpub const REG_MAXSUB: usize = 16;\n48\t\n49\t#[repr(C)]\n50\t#[derive(Clone, Copy)]\n51\tpub struct ResubSub {\n52\t    pub sp: *const c_char,\n53\t    pub ep: *const c_char,\n54\t}\n55\t\n56\t#[repr(C)]\n57\t#[derive(Clone, Copy)]\n58\tpub struct Resub {\n59\t    pub nsub: c_int,\n60\t    pub sub: [ResubSub; REG_MAXSUB],\n61\t}\n62\t\n63\timpl Default for Resub {\n64\t    fn default() -> Self {\n65\t        Resub {\n66\t            nsub: 0,\n67\t            sub: [ResubSub {\n68\t                sp: std::ptr::null(),\n69\t                ep: std::ptr::null(),\n70\t            }; REG_MAXSUB],\n71\t        }\n72\t    }\n73\t}\n74\t\n75\t/* --------------------------------------------------------------- paths */\n76\t\n77\tfn crate_root() -> PathBuf {\n78\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n79\t}\n80\t\n81\tpub fn c_so_path() -> PathBuf {\n82\t    crate_root().join(\"c_src/build/libmujs.so\")\n83\t}\n84\t\n85\t/// The Rust cdylib. We deliberately load it through `libloading` rather than\n86\t/// linking it, so every call goes through the real `#[no_mangle]` exports.\n87\tpub fn rust_so_path() -> PathBuf {\n88\t    // OUT_DIR-free discovery: the test binary lives in target/<profile>/deps/\n89\t    let exe = std::env::current_exe().expect(\"current_exe\");\n90\t    let mut dir = exe.parent().unwrap().to_path_buf();\n91\t    if dir.ends_with(\"deps\") {\n92\t        dir.pop();\n93\t    }\n94\t    let p = dir.join(\"libmujs.so\");\n95\t    let p = if p.exists() {\n96\t        p\n97\t    } else {\n98\t        // fall back to the usual debug location\n99\t        crate_root().join(\"target/debug/libmujs.so\")\n100\t    };\n101\t    assert_stale_free(&p);\n102\t    p\n103\t}\n104\t\n105\t/// GUARD AGAINST FALSE PASSES.\n106\t///\n107\t/// `cargo test` does NOT rebuild the cdylib: the integration-test targets do not\n108\t/// depend on the `mujs` lib target (they reach it only through `dlopen`), so\n109\t/// cargo has no reason to rebuild `target/debug/libmujs.so`. Without this check,\n110\t/// editing `src/*.rs` and running `cargo test` silently tests the PREVIOUS\n111\t/// build, and every test passes no matter how broken the new code is.\n112\t///\n113\t/// Always run `cargo build` (or `cargo build && cargo test`) first. This\n114\t/// assertion turns a silent false pass into a loud failure.\n115\tfn assert_stale_free(so: &PathBuf) {\n116\t    let so_mtime = std::fs::metadata(so)\n117\t        .unwrap_or_else(|e| panic!(\"{}: {e}\\nRun `cargo build` first.\", so.display()))\n118\t        .modified()\n119\t        .expect(\"mtime\");\n120\t    let mut newest: Option<(PathBuf, std::time::SystemTime)> = None;\n121\t    let src = crate_root().join(\"src\");\n122\t    for e in std::fs::read_dir(&src).expect(\"read src/\") {\n123\t        let e = e.expect(\"dir entry\");\n124\t        let path = e.path();\n125\t        if path.extension().and_then(|s| s.to_str()) != Some(\"rs\") {\n126\t            continue;\n127\t        }\n128\t        let m = e.metadata().expect(\"metadata\").modified().expect(\"mtime\");\n129\t        if newest.as_ref().is_none_or(|(_, t)| m > *t) {\n130\t            newest = Some((path, m));\n131\t        }\n132\t    }\n133\t    let (newest_path, newest_mtime) = newest.expect(\"no .rs files in src/\");\n134\t    assert!(\n135\t        newest_mtime <= so_mtime,\n136\t        \"STALE Rust cdylib: {} is newer than {}.\\n\\\n137\t         `cargo test` does not rebuild the cdylib, so this run would have tested \\\n138\t         the previous build and passed vacuously.\\n\\\n139\t         Run ./run_tests.sh (or `cargo build --no-default-features`) first.\",\n140\t        newest_path.display(),\n141\t        so.display()\n142\t    );\n143\t\n144\t    // mtime alone is not enough: a tool that rewrites src/ with BACKDATED mtimes\n145\t    // (e.g. shutil.copytree, tar -p, git checkout) leaves the .so newer than the\n146\t    // sources while being built from different code. `run_tests.sh` stamps a\n147\t    // content hash right after `cargo build`; require it to match.\n148\t    let stamp = so.parent().unwrap().join(\".src_hash\");\n149\t    if let Ok(recorded) = std::fs::read_to_string(&stamp) {\n150\t        let actual = src_hash();\n151\t        assert_eq!(\n152\t            recorded.trim(),\n153\t            actual,\n154\t            \"STALE Rust cdylib: the recorded build hash in {} does not match the \\\n155\t             current contents of src/*.rs.\\n\\\n156\t             The .so was built from DIFFERENT source than what is on disk, so this \\\n157\t             run would have passed vacuously.\\n\\\n158\t             Run ./run_tests.sh to rebuild and re-stamp.\",\n159\t            stamp.display()\n160\t        );\n161\t    }\n162\t}\n163\t\n164\t/// FNV-1a 64 over every `src/*.rs`, sorted by file name, hashing\n165\t/// `name \\0 len \\0 bytes`. `run_tests.sh` computes the identical value.\n166\tpub fn src_hash() -> String {\n167\t    let src = crate_root().join(\"src\");\n168\t    let mut names: Vec<String> = std::fs::read_dir(&src)\n169\t        .expect(\"read src/\")\n170\t        .filter_map(|e| {\n171\t            let p = e.ok()?.path();\n172\t            if p.extension().and_then(|s| s.to_str()) == Some(\"rs\") {\n173\t                Some(p.file_name()?.to_str()?.to_string())\n174\t            } else {\n175\t                None\n176\t            }\n177\t        })\n178\t        .collect();\n179\t    names.sort();\n180\t    let mut h: u64 = 0xcbf2_9ce4_8422_2325;\n181\t    let mut feed = |bytes: &[u8]| {\n182\t        for b in bytes {\n183\t            h ^= *b as u64;\n184\t            h = h.wrapping_mul(0x100_0000_01b3);\n185\t        }\n186\t    };\n187\t    for n in &names {\n188\t        let bytes = std::fs::read(src.join(n)).expect(\"read src file\");\n189\t        feed(n.as_bytes());\n190\t        feed(b\"\\0\");\n191\t        feed(bytes.len().to_string().as_bytes());\n192\t        feed(b\"\\0\");\n193\t        feed(&bytes);\n194\t    }\n195\t    format!(\"{h:016x}\")\n196\t}\n197\t\n198\t/* --------------------------------------------------------------- Lib */\n199\t\n200\tpub struct Lib {\n201\t    pub name: &'static str,\n202\t    lib: Library,\n203\t}\n204\t\n205\tmacro_rules! sym {\n206\t    ($self:expr, $name:literal, $t:ty) => {{\n207\t        let s: Symbol<$t> = $self\n208\t            .lib\n209\t            .get(concat!($name, \"\\0\").as_bytes())\n210\t            .unwrap_or_else(|e| panic!(\"{}: missing symbol {}: {}\", $self.name, $name, e));\n211\t        *s\n212\t    }};\n213\t}\n214\t\n215\t/// The C `libmujs.so` produced by CMakeLists.txt is not linked against libm\n216\t/// (`ceil`, `floor`, `fmod`, `sqrt` are undefined in it), so we must make libm\n217\t/// globally visible before dlopen'ing it. `c_src/` is read-only, so this has to\n218\t/// happen here in the harness.\n219\tfn preload_libm() {\n220\t    use libloading::os::unix::Library as UnixLibrary;\n221\t    use std::sync::OnceLock;\n222\t    static M: OnceLock<()> = OnceLock::new();\n223\t    M.get_or_init(|| {\n224\t        const RTLD_NOW: i32 = 0x2;\n225\t        const RTLD_GLOBAL: i32 = 0x100;\n226\t        for cand in [\"libm.so.6\", \"libm.so\"] {\n227\t            if let Ok(l) = unsafe { UnixLibrary::open(Some(cand), RTLD_NOW | RTLD_GLOBAL) } {\n228\t                // must never be dlclose()d, or it leaves the global scope again\n229\t                std::mem::forget(l);\n230\t                return;\n231\t            }\n232\t        }\n233\t        panic!(\"cannot preload libm\");\n234\t    });\n235\t}\n236\t\n237\timpl Lib {\n238\t    pub fn open(name: &'static str, path: &PathBuf) -> Lib {\n239\t        preload_libm();\n240\t        let lib = unsafe { Library::new(path) }\n241\t            .unwrap_or_else(|e| panic!(\"cannot dlopen {}: {}\", path.display(), e));\n242\t        Lib { name, lib }\n243\t    }\n244\t\n245\t    pub fn has(&self, name: &str) -> bool {\n246\t        let mut b = name.as_bytes().to_vec();\n247\t        b.push(0);\n248\t        unsafe { self.lib.get::<*mut c_void>(&b) }.is_ok()\n249\t    }\n250\t\n251\t    /// Generic symbol fetch for the handful of entry points whose signatures\n252\t    /// don't fit the helper families above (e.g. `js_pushvalue`, which takes a\n253\t    /// 16-byte `js_Value` by value).\n254\t    pub unsafe fn raw2<T: Copy>(&self, name: &str) -> T {\n255\t        let mut b = name.as_bytes().to_vec();\n256\t        b.push(0);\n257\t        let s: Symbol<T> = self\n258\t            .lib\n259\t            .get(&b)\n260\t            .unwrap_or_else(|e| panic!(\"{}: missing {}: {}\", self.name, name, e));\n261\t        *s\n262\t    }\n263\t}\n264\t\n265\t/* Every wrapper below is `unsafe` and looks the symbol up on each call. */\n266\timpl Lib {\n267\t    /* ---------------- state ---------------- */\n268\t    pub unsafe fn js_newstate(&self, alloc: js_Alloc, actx: *mut c_void, flags: c_int) -> JS {\n269\t        sym!(self, \"js_newstate\", unsafe extern \"C\" fn(js_Alloc, *mut c_void, c_int) -> JS)(\n270\t            alloc, actx, flags,\n271\t        )\n272\t    }\n273\t    pub unsafe fn js_freestate(&self, j: JS) {\n274\t        sym!(self, \"js_freestate\", unsafe extern \"C\" fn(JS))(j)\n275\t    }\n276\t    pub unsafe fn js_setcontext(&self, j: JS, u: *mut c_void) {\n277\t        sym!(self, \"js_setcontext\", unsafe extern \"C\" fn(JS, *mut c_void))(j, u)\n278\t    }\n279\t    pub unsafe fn js_getcontext(&self, j: JS) -> *mut c_void {\n280\t        sym!(self, \"js_getcontext\", unsafe extern \"C\" fn(JS) -> *mut c_void)(j)\n281\t    }\n282\t    pub unsafe fn js_setreport(&self, j: JS, r: js_Report) {\n283\t        sym!(self, \"js_setreport\", unsafe extern \"C\" fn(JS, js_Report))(j, r)\n284\t    }\n285\t    pub unsafe fn js_atpanic(&self, j: JS, p: js_Panic) -> js_Panic {\n286\t        sym!(self, \"js_atpanic\", unsafe extern \"C\" fn(JS, js_Panic) -> js_Panic)(j, p)\n287\t    }\n288\t    pub unsafe fn js_report(&self, j: JS, m: *const c_char) {\n289\t        sym!(self, \"js_report\", unsafe extern \"C\" fn(JS, *const c_char))(j, m)\n290\t    }\n291\t    pub unsafe fn js_gc(&self, j: JS, report: c_int) {\n292\t        sym!(self, \"js_gc\", unsafe extern \"C\" fn(JS, c_int))(j, report)\n293\t    }\n294\t    pub unsafe fn js_setlimit(&self, j: JS, runlimit: c_int, memlimit: c_int) {\n295\t        sym!(self, \"js_setlimit\", unsafe extern \"C\" fn(JS, c_int, c_int))(j, runlimit, memlimit)\n296\t    }\n297\t    pub unsafe fn js_dostring(&self, j: JS, src: *const c_char) -> c_int {\n298\t        sym!(self, \"js_dostring\", unsafe extern \"C\" fn(JS, *const c_char) -> c_int)(j, src)\n299\t    }\n300\t    pub unsafe fn js_ploadstring(&self, j: JS, f: *const c_char, s: *const c_char) -> c_int {\n301\t        sym!(\n302\t            self,\n303\t            \"js_ploadstring\",\n304\t            unsafe extern \"C\" fn(JS, *const c_char, *const c_char) -> c_int\n305\t        )(j, f, s)\n306\t    }\n307\t    pub unsafe fn js_pcall(&self, j: JS, n: c_int) -> c_int {\n308\t        sym!(self, \"js_pcall\", unsafe extern \"C\" fn(JS, c_int) -> c_int)(j, n)\n309\t    }\n310\t    pub unsafe fn js_pconstruct(&self, j: JS, n: c_int) -> c_int {\n311\t        sym!(self, \"js_pconstruct\", unsafe extern \"C\" fn(JS, c_int) -> c_int)(j, n)\n312\t    }\n313\t    pub unsafe fn js_call(&self, j: JS, n: c_int) {\n314\t        sym!(self, \"js_call\", unsafe extern \"C\" fn(JS, c_int))(j, n)\n315\t    }\n316\t    pub unsafe fn js_construct(&self, j: JS, n: c_int) {\n317\t        sym!(self, \"js_construct\", unsafe extern \"C\" fn(JS, c_int))(j, n)\n318\t    }\n319\t    pub unsafe fn js_eval(&self, j: JS) {\n320\t        sym!(self, \"js_eval\", unsafe extern \"C\" fn(JS))(j)\n321\t    }\n322\t    pub unsafe fn js_loadstring(&self, j: JS, f: *const c_char, s: *const c_char) {\n323\t        sym!(\n324\t            self,\n325\t            \"js_loadstring\",\n326\t            unsafe extern \"C\" fn(JS, *const c_char, *const c_char)\n327\t        )(j, f, s)\n328\t    }\n329\t    pub unsafe fn js_loadeval(&self, j: JS, f: *const c_char, s: *const c_char) {\n330\t        sym!(\n331\t            self,\n332\t            \"js_loadeval\",\n333\t            unsafe extern \"C\" fn(JS, *const c_char, *const c_char)\n334\t        )(j, f, s)\n335\t    }\n336\t    pub unsafe fn js_endtry(&self, j: JS) {\n337\t        sym!(self, \"js_endtry\", unsafe extern \"C\" fn(JS))(j)\n338\t    }\n339\t    pub unsafe fn js_savetry(&self, j: JS) -> *mut c_void {\n340\t        sym!(self, \"js_savetry\", unsafe extern \"C\" fn(JS) -> *mut c_void)(j)\n341\t    }\n342\t    pub unsafe fn js_throw(&self, j: JS) {\n343\t        sym!(self, \"js_throw\", unsafe extern \"C\" fn(JS))(j)\n344\t    }\n345\t\n346\t    /* ---------------- refs / registry / globals ---------------- */\n347\t    pub unsafe fn js_ref(&self, j: JS) -> *const c_char {\n348\t        sym!(self, \"js_ref\", unsafe extern \"C\" fn(JS) -> *const c_char)(j)\n349\t    }\n350\t    pub unsafe fn js_unref(&self, j: JS, r: *const c_char) {\n351\t        sym!(self, \"js_unref\", unsafe extern \"C\" fn(JS, *const c_char))(j, r)\n352\t    }\n353\t    pub unsafe fn js_getregistry(&self, j: JS, n: *const c_char) {\n354\t        sym!(self, \"js_getregistry\", unsafe extern \"C\" fn(JS, *const c_char))(j, n)\n355\t    }\n356\t    pub unsafe fn js_setregistry(&self, j: JS, n: *const c_char) {\n357\t        sym!(self, \"js_setregistry\", unsafe extern \"C\" fn(JS, *const c_char))(j, n)\n358\t    }\n359\t    pub unsafe fn js_delregistry(&self, j: JS, n: *const c_char) {\n360\t        sym!(self, \"js_delregistry\", unsafe extern \"C\" fn(JS, *const c_char))(j, n)\n361\t    }\n362\t    pub unsafe fn js_getglobal(&self, j: JS, n: *const c_char) {\n363\t        sym!(self, \"js_getglobal\", unsafe extern \"C\" fn(JS, *const c_char))(j, n)\n364\t    }\n365\t    pub unsafe fn js_setglobal(&self, j: JS, n: *const c_char) {\n366\t        sym!(self, \"js_setglobal\", unsafe extern \"C\" fn(JS, *const c_char))(j, n)\n367\t    }\n368\t    pub unsafe fn js_defglobal(&self, j: JS, n: *const c_char, atts: c_int) {\n369\t        sym!(\n370\t            self,\n371\t            \"js_defglobal\",\n372\t            unsafe extern \"C\" fn(JS, *const c_char, c_int)\n373\t        )(j, n, atts)\n374\t    }\n375\t    pub unsafe fn js_delglobal(&self, j: JS, n: *const c_char) {\n376\t        sym!(self, \"js_delglobal\", unsafe extern \"C\" fn(JS, *const c_char))(j, n)\n377\t    }\n378\t\n379\t    /* ---------------- properties ---------------- */\n380\t    pub unsafe fn js_hasproperty(&self, j: JS, idx: c_int, n: *const c_char) -> c_int {\n381\t        sym!(\n382\t            self,\n383\t            \"js_hasproperty\",\n384\t            unsafe extern \"C\" fn(JS, c_int, *const c_char) -> c_int\n385\t        )(j, idx, n)\n386\t    }\n387\t    pub unsafe fn js_getproperty(&self, j: JS, idx: c_int, n: *const c_char) {\n388\t        sym!(\n389\t            self,\n390\t            \"js_getproperty\",\n391\t            unsafe extern \"C\" fn(JS, c_int, *const c_char)\n392\t        )(j, idx, n)\n393\t    }\n394\t    pub unsafe fn js_setproperty(&self, j: JS, idx: c_int, n: *const c_char) {\n395\t        sym!(\n396\t            self,\n397\t            \"js_setproperty\",\n398\t            unsafe extern \"C\" fn(JS, c_int, *const c_char)\n399\t        )(j, idx, n)\n400\t    }\n401\t    pub unsafe fn js_defproperty(&self, j: JS, idx: c_int, n: *const c_char, atts: c_int) {\n402\t        sym!(\n403\t            self,\n404\t            \"js_defproperty\",\n405\t            unsafe extern \"C\" fn(JS, c_int, *const c_char, c_int)\n406\t        )(j, idx, n, atts)\n407\t    }\n408\t    pub unsafe fn js_delproperty(&self, j: JS, idx: c_int, n: *const c_char) {\n409\t        sym!(\n410\t            self,\n411\t            \"js_delproperty\",\n