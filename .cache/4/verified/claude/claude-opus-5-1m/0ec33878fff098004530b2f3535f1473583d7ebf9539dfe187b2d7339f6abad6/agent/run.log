ts.sh --test gaps 2>&1 | grep -E 'test result' | tail -1; done","description":"Filter libtest noise and verify stability","timeout":600000}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":707,"cache_read_input_tokens":283630,"cache_creation":{"ephemeral_5m_input_tokens":707,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"a62d17ad-8528-487e-8b6a-23ad0ded9ac2","uuid":"6ff5bdd0-02df-4ebd-9824-5ee26ad17103","timestamp":"2026-08-23T10:06:53.300Z"}
