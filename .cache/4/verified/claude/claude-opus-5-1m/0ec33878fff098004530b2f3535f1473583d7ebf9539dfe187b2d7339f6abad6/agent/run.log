{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01T71Gb28bbotKTQBSLmANfF","type":"tool_result","content":"1\t//! Differential test harness: loads BOTH the C `libmujs.so` and the Rust\n2\t//! `libmujs.so` through `libloading` and calls every entry point purely\n3\t//! through the exported FFI symbols.\n4\t#![allow(dead_code, non_snake_case, non_camel_case_types)]\n5\t\n6\tuse libloading::{Library, Symbol};\n7\tuse std::cell::{Cell, RefCell};\n8\tuse std::ffi::{c_char, c_int, c_short, c_uint, c_ushort, c_void, CStr, CString};\n9\tuse std::path::PathBuf;\n10\t\n11\tpub type JS = *mut c_void; // js_State *\n12\tpub type Rune = c_int;\n13\t\n14\tpub type js_Alloc = Option<unsafe extern \"C\" fn(*mut c_void, *mut c_void, c_int) -> *mut c_void>;\n15\tpub type js_CFunction = Option<unsafe extern \"C\" fn(JS)>;\n16\tpub type js_Finalize = Option<unsafe extern \"C\" fn(JS, *mut c_void)>;\n17\tpub type js_Report = Option<unsafe extern \"C\" fn(JS, *const c_char)>;\n18\tpub type js_Panic = Option<unsafe extern \"C\" fn(JS)>;\n19\tpub type js_HasProperty = Option<unsafe extern \"C\" fn(JS, *mut c_void, *const c_char) -> c_int>;\n20\tpub type js_Put = Option<unsafe extern \"C\" fn(JS, *mut c_void, *const c_char) -> c_int>;\n21\tpub type js_Delete = Option<unsafe extern \"C\" fn(JS, *mut c_void, *const c_char) -> c_int>;\n22\t\n23\t/* ------------------------------------------------------------ constants */\n24\t\n25\tpub const JS_STRICT: c_int = 1;\n26\t\n27\tpub const JS_REGEXP_G: c_int = 1;\n28\tpub const JS_REGEXP_I: c_int = 2;\n29\tpub const JS_REGEXP_M: c_int = 4;\n30\t\n31\tpub const JS_READONLY: c_int = 1;\n32\tpub const JS_DONTENUM: c_int = 2;\n33\tpub const JS_DONTCONF: c_int = 4;\n34\t\n35\tpub const JS_ISUNDEFINED: c_int = 0;\n36\tpub const JS_ISNULL: c_int = 1;\n37\tpub const JS_ISBOOLEAN: c_int = 2;\n38\tpub const JS_ISNUMBER: c_int = 3;\n39\tpub const JS_ISSTRING: c_int = 4;\n40\tpub const JS_ISFUNCTION: c_int = 5;\n41\tpub const JS_ISOBJECT: c_int = 6;\n42\t\n43\tpub const REG_ICASE: c_int = 1;\n44\tpub const REG_NEWLINE: c_int = 2;\n45\tpub const REG_NOTBOL: c_int = 4;\n46\t\n47\tpub const REG_MAXSUB: usize = 16;\n48\t\n49\t#[repr(C)]\n50\t#[derive(Clone, Copy)]\n51\tpub struct ResubSub {\n52\t    pub sp: *const c_char,\n53\t    pub ep: *const c_char,\n54\t}\n55\t\n56\t#[repr(C)]\n57\t#[derive(Clone, Copy)]\n58\tpub struct Resub {\n59\t    pub nsub: c_int,\n60\t    pub sub: [ResubSub; REG_MAXSUB],\n61\t}\n62\t\n63\timpl Default for Resub {\n64\t    fn default() -> Self {\n65\t        Resub {\n66\t            nsub: 0,\n67\t            sub: [ResubSub {\n68\t                sp: std::ptr::null(),\n69\t                ep: std::ptr::null(),\n70\t            }; REG_MAXSUB],\n71\t        }\n72\t    }\n73\t}\n74\t\n75\t/* --------------------------------------------------------------- paths */\n76\t\n77\tfn crate_root() -> PathBuf {\n78\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n79\t}\n80\t\n81\tpub fn c_so_path() -> PathBuf {\n82\t    crate_root().join(\"c_src/build/libmujs.so\")\n83\t}\n84\t\n85\t/// The Rust cdylib. We deliberately load it through `libloading` rather than\n86\t/// linking it, so every call goes through the real `#[no_mangle]` exports.\n87\tpub fn rust_so_path() -> PathBuf {\n88\t    // OUT_DIR-free discovery: the test binary lives in target/<profile>/deps/\n89\t    let exe = std::env::current_exe().expect(\"current_exe\");\n90\t    let mut dir = exe.parent().unwrap().to_path_buf();\n91\t    if dir.ends_with(\"deps\") {\n92\t        dir.pop();\n93\t    }\n94\t    let p = dir.join(\"libmujs.so\");\n95\t    if p.exists() {\n96\t        return p;\n97\t    }\n98\t    // fall back to the usual debug location\n99\t    crate_root().join(\"target/debug/libmujs.so\")\n100\t}\n101\t\n102\t/* --------------------------------------------------------------- Lib */\n103\t\n104\tpub struct Lib {\n105\t    pub name: &'static str,\n106\t    lib: Library,\n107\t}\n108\t\n109\tmacro_rules! sym {\n110\t    ($self:expr, $name:literal, $t:ty) => {{\n111\t        let s: Symbol<$t> = $self\n112\t            .lib\n113\t            .get(concat!($name, \"\\0\").as_bytes())\n114\t            .unwrap_or_else(|e| panic!(\"{}: missing symbol {}: {}\", $self.name, $name, e));\n115\t        *s\n116\t    }};\n117\t}\n118\t\n119\t/// The C `libmujs.so` produced by CMakeLists.txt is not linked against libm\n120\t/// (`ceil`, `floor`, `fmod`, `sqrt` are undefined in it), so we must make libm\n121\t/// globally visible before dlopen'ing it. `c_src/` is read-only, so this has to\n122\t/// happen here in the harness.\n123\tfn preload_libm() {\n124\t    use libloading::os::unix::Library as UnixLibrary;\n125\t    use std::sync::OnceLock;\n126\t    static M: OnceLock<()> = OnceLock::new();\n127\t    M.get_or_init(|| {\n128\t        const RTLD_NOW: i32 = 0x2;\n129\t        const RTLD_GLOBAL: i32 = 0x100;\n130\t        for cand in [\"libm.so.6\", \"libm.so\"] {\n131\t            if let Ok(l) = unsafe { UnixLibrary::open(Some(cand), RTLD_NOW | RTLD_GLOBAL) } {\n132\t                // must never be dlclose()d, or it leaves the global scope again\n133\t                std::mem::forget(l);\n134\t                return;\n135\t            }\n136\t        }\n137\t        panic!(\"cannot preload libm\");\n138\t    });\n139\t}\n140\t\n141\timpl Lib {\n142\t    pub fn open(name: &'static str, path: &PathBuf) -> Lib {\n143\t        preload_libm();\n144\t        let lib = unsafe { Library::new(path) }\n145\t            .unwrap_or_else(|e| panic!(\"cannot dlopen {}: {}\", path.display(), e));\n146\t        Lib { name, lib }\n147\t    }\n148\t\n149\t    pub fn has(&self, name: &str) -> bool {\n150\t        let mut b = name.as_bytes().to_vec();\n151\t        b.push(0);\n152\t        unsafe { self.lib.get::<*mut c_void>(&b) }.is_ok()\n153\t    }\n154\t}\n155\t\n156\t/* Every wrapper below is `unsafe` and looks the symbol up on each call. */\n157\timpl Lib {\n158\t    /* ---------------- state ---------------- */\n159\t    pub unsafe fn js_newstate(&self, alloc: js_Alloc, actx: *mut c_void, flags: c_int) -> JS {\n160\t        sym!(self, \"js_newstate\", unsafe extern \"C\" fn(js_Alloc, *mut c_void, c_int) -> JS)(\n161\t            alloc, actx, flags,\n162\t        )\n163\t    }\n164\t    pub unsafe fn js_freestate(&self, j: JS) {\n165\t        sym!(self, \"js_freestate\", unsafe extern \"C\" fn(JS))(j)\n166\t    }\n167\t    pub unsafe fn js_setcontext(&self, j: JS, u: *mut c_void) {\n168\t        sym!(self, \"js_setcontext\", unsafe extern \"C\" fn(JS, *mut c_void))(j, u)\n169\t    }\n170\t    pub unsafe fn js_getcontext(&self, j: JS) -> *mut c_void {\n171\t        sym!(self, \"js_getcontext\", unsafe extern \"C\" fn(JS) -> *mut c_void)(j)\n172\t    }\n173\t    pub unsafe fn js_setreport(&self, j: JS, r: js_Report) {\n174\t        sym!(self, \"js_setreport\", unsafe extern \"C\" fn(JS, js_Report))(j, r)\n175\t    }\n176\t    pub unsafe fn js_atpanic(&self, j: JS, p: js_Panic) -> js_Panic {\n177\t        sym!(self, \"js_atpanic\", unsafe extern \"C\" fn(JS, js_Panic) -> js_Panic)(j, p)\n178\t    }\n179\t    pub unsafe fn js_report(&self, j: JS, m: *const c_char) {\n180\t        sym!(self, \"js_report\", unsafe extern \"C\" fn(JS, *const c_char))(j, m)\n181\t    }\n182\t    pub unsafe fn js_gc(&self, j: JS, report: c_int) {\n183\t        sym!(self, \"js_gc\", unsafe extern \"C\" fn(JS, c_int))(j, report)\n184\t    }\n185\t    pub unsafe fn js_setlimit(&self, j: JS, runlimit: c_int, memlimit: c_int) {\n186\t        sym!(self, \"js_setlimit\", unsafe extern \"C\" fn(JS, c_int, c_int))(j, runlimit, memlimit)\n187\t    }\n188\t    pub unsafe fn js_dostring(&self, j: JS, src: *const c_char) -> c_int {\n189\t        sym!(self, \"js_dostring\", unsafe extern \"C\" fn(JS, *const c_char) -> c_int)(j, src)\n190\t    }\n191\t    pub unsafe fn js_ploadstring(&self, j: JS, f: *const c_char, s: *const c_char) -> c_int {\n192\t        sym!(\n193\t            self,\n194\t            \"js_ploadstring\",\n195\t            unsafe extern \"C\" fn(JS, *const c_char, *const c_char) -> c_int\n196\t        )(j, f, s)\n197\t    }\n198\t    pub unsafe fn js_pcall(&self, j: JS, n: c_int) -> c_int {\n199\t        sym!(self, \"js_pcall\", unsafe extern \"C\" fn(JS, c_int) -> c_int)(j, n)\n200\t    }\n201\t    pub unsafe fn js_pconstruct(&self, j: JS, n: c_int) -> c_int {\n202\t        sym!(self, \"js_pconstruct\", unsafe extern \"C\" fn(JS, c_int) -> c_int)(j, n)\n203\t    }\n204\t    pub unsafe fn js_call(&self, j: JS, n: c_int) {\n205\t        sym!(self, \"js_call\", unsafe extern \"C\" fn(JS, c_int))(j, n)\n206\t    }\n207\t    pub unsafe fn js_construct(&self, j: JS, n: c_int) {\n208\t        sym!(self, \"js_construct\", unsafe extern \"C\" fn(JS, c_int))(j, n)\n209\t    }\n210\t    pub unsafe fn js_eval(&self, j: JS) {\n211\t        sym!(self, \"js_eval\", unsafe extern \"C\" fn(JS))(j)\n212\t    }\n213\t    pub unsafe fn js_loadstring(&self, j: JS, f: *const c_char, s: *const c_char) {\n214\t        sym!(\n215\t            self,\n216\t            \"js_loadstring\",\n217\t            unsafe extern \"C\" fn(JS, *const c_char, *const c_char)\n218\t        )(j, f, s)\n219\t    }\n220\t    pub unsafe fn js_loadeval(&self, j: JS, f: *const c_char, s: *const c_char) {\n221\t        sym!(\n222\t            self,\n223\t            \"js_loadeval\",\n224\t            unsafe extern \"C\" fn(JS, *const c_char, *const c_char)\n225\t        )(j, f, s)\n226\t    }\n227\t    pub unsafe fn js_endtry(&self, j: JS) {\n228\t        sym!(self, \"js_endtry\", unsafe extern \"C\" fn(JS))(j)\n229\t    }\n230\t    pub unsafe fn js_savetry(&self, j: JS) -> *mut c_void {\n231\t        sym!(self, \"js_savetry\", unsafe extern \"C\" fn(JS) -> *mut c_void)(j)\n232\t    }\n233\t    pub unsafe fn js_throw(&self, j: JS) {\n234\t        sym!(self, \"js_throw\", unsafe extern \"C\" fn(JS))(j)\n235\t    }\n236\t\n237\t    /* ---------------- refs / registry / globals ---------------- */\n238\t    pub unsafe fn js_ref(&self, j: JS) -> *const c_char {\n239\t        sym!(self, \"js_ref\", unsafe extern \"C\" fn(JS) -> *const c_char)(j)\n240\t    }\n241\t    pub unsafe fn js_unref(&self, j: JS, r: *const c_char) {\n242\t        sym!(self, \"js_unref\", unsafe extern \"C\" fn(JS, *const c_char))(j, r)\n243\t    }\n244\t    pub unsafe fn js_getregistry(&self, j: JS, n: *const c_char) {\n245\t        sym!(self, \"js_getregistry\", unsafe extern \"C\" fn(JS, *const c_char))(j, n)\n246\t    }\n247\t    pub unsafe fn js_setregistry(&self, j: JS, n: *const c_char) {\n248\t        sym!(self, \"js_setregistry\", unsafe extern \"C\" fn(JS, *const c_char))(j, n)\n249\t    }\n250\t    pub unsafe fn js_delregistry(&self, j: JS, n: *const c_char) {\n251\t        sym!(self, \"js_delregistry\", unsafe extern \"C\" fn(JS, *const c_char))(j, n)\n252\t    }\n253\t    pub unsafe fn js_getglobal(&self, j: JS, n: *const c_char) {\n254\t        sym!(self, \"js_getglobal\", unsafe extern \"C\" fn(JS, *const c_char))(j, n)\n255\t    }\n256\t    pub unsafe fn js_setglobal(&self, j: JS, n: *const c_char) {\n257\t        sym!(self, \"js_setglobal\", unsafe extern \"C\" fn(JS, *const c_char))(j, n)\n258\t    }\n259\t    pub unsafe fn js_defglobal(&self, j: JS, n: *const c_char, atts: c_int) {\n260\t        sym!(\n261\t            self,\n262\t            \"js_defglobal\",\n263\t            unsafe extern \"C\" fn(JS, *const c_char, c_int)\n264\t        )(j, n, atts)\n265\t    }\n266\t    pub unsafe fn js_delglobal(&self, j: JS, n: *const c_char) {\n267\t        sym!(self, \"js_delglobal\", unsafe extern \"C\" fn(JS, *const c_char))(j, n)\n268\t    }\n269\t\n270\t    /* ---------------- properties ---------------- */\n271\t    pub unsafe fn js_hasproperty(&self, j: JS, idx: c_int, n: *const c_char) -> c_int {\n272\t        sym!(\n273\t            self,\n274\t            \"js_hasproperty\",\n275\t            unsafe extern \"C\" fn(JS, c_int, *const c_char) -> c_int\n276\t        )(j, idx, n)\n277\t    }\n278\t    pub unsafe fn js_getproperty(&self, j: JS, idx: c_int, n: *const c_char) {\n279\t        sym!(\n280\t            self,\n281\t            \"js_getproperty\",\n282\t            unsafe extern \"C\" fn(JS, c_int, *const c_char)\n283\t        )(j, idx, n)\n284\t    }\n285\t    pub unsafe fn js_setproperty(&self, j: JS, idx: c_int, n: *const c_char) {\n286\t        sym!(\n287\t            self,\n288\t            \"js_setproperty\",\n289\t            unsafe extern \"C\" fn(JS, c_int, *const c_char)\n290\t        )(j, idx, n)\n291\t    }\n292\t    pub unsafe fn js_defproperty(&self, j: JS, idx: c_int, n: *const c_char, atts: c_int) {\n293\t        sym!(\n294\t            self,\n295\t            \"js_defproperty\",\n296\t            unsafe extern \"C\" fn(JS, c_int, *const c_char, c_int)\n297\t        )(j, idx, n, atts)\n298\t    }\n299\t    pub unsafe fn js_delproperty(&self, j: JS, idx: c_int, n: *const c_char) {\n300\t        sym!(\n301\t            self,\n302\t            \"js_delproperty\",\n303\t            unsafe extern \"C\" fn(JS, c_int, *const c_char)\n304\t        )(j, idx, n)\n305\t    }\n306\t    pub unsafe fn js_defaccessor(&self, j: JS, idx: c_int, n: *const c_char, atts: c_int) {\n307\t        sym!(\n308\t            self,\n309\t            \"js_defaccessor\",\n310\t            unsafe extern \"C\" fn(JS, c_int, *const c_char, c_int)\n311\t        )(j, idx, n, atts)\n312\t    }\n313\t    pub unsafe fn js_getlength(&self, j: JS, idx: c_int) -> c_int {\n314\t        sym!(self, \"js_getlength\", unsafe extern \"C\" fn(JS, c_int) -> c_int)(j, idx)\n315\t    }\n316\t    pub unsafe fn js_setlength(&self, j: JS, idx: c_int, len: c_int) {\n317\t        sym!(self, \"js_setlength\", unsafe extern \"C\" fn(JS, c_int, c_int))(j, idx, len)\n318\t    }\n319\t    pub unsafe fn js_hasindex(&self, j: JS, idx: c_int, i: c_int) -> c_int {\n320\t        sym!(\n321\t            self,\n322\t            \"js_hasindex\",\n323\t            unsafe extern \"C\" fn(JS, c_int, c_int) -> c_int\n324\t        )(j, idx, i)\n325\t    }\n326\t    pub unsafe fn js_getindex(&self, j: JS, idx: c_int, i: c_int) {\n327\t        sym!(self, \"js_getindex\", unsafe extern \"C\" fn(JS, c_int, c_int))(j, idx, i)\n328\t    }\n329\t    pub unsafe fn js_setindex(&self, j: JS, idx: c_int, i: c_int) {\n330\t        sym!(self, \"js_setindex\", unsafe extern \"C\" fn(JS, c_int, c_int))(j, idx, i)\n331\t    }\n332\t    pub unsafe fn js_delindex(&self, j: JS, idx: c_int, i: c_int) {\n333\t        sym!(self, \"js_delindex\", unsafe extern \"C\" fn(JS, c_int, c_int))(j, idx, i)\n334\t    }\n335\t\n336\t    /* ---------------- push / new ---------------- */\n337\t    pub unsafe fn js_currentfunction(&self, j: JS) {\n338\t        sym!(self, \"js_currentfunction\", unsafe extern \"C\" fn(JS))(j)\n339\t    }\n340\t    pub unsafe fn js_currentfunctiondata(&self, j: JS) -> *mut c_void {\n341\t        sym!(\n342\t            self,\n343\t            \"js_currentfunctiondata\",\n344\t            unsafe extern \"C\" fn(JS) -> *mut c_void\n345\t        )(j)\n346\t    }\n347\t    pub unsafe fn js_pushglobal(&self, j: JS) {\n348\t        sym!(self, \"js_pushglobal\", unsafe extern \"C\" fn(JS))(j)\n349\t    }\n350\t    pub unsafe fn js_pushundefined(&self, j: JS) {\n351\t        sym!(self, \"js_pushundefined\", unsafe extern \"C\" fn(JS))(j)\n352\t    }\n353\t    pub unsafe fn js_pushnull(&self, j: JS) {\n354\t        sym!(self, \"js_pushnull\", unsafe extern \"C\" fn(JS))(j)\n355\t    }\n356\t    pub unsafe fn js_pushboolean(&self, j: JS, v: c_int) {\n357\t        sym!(self, \"js_pushboolean\", unsafe extern \"C\" fn(JS, c_int))(j, v)\n358\t    }\n359\t    pub unsafe fn js_pushnumber(&self, j: JS, v: f64) {\n360\t        sym!(self, \"js_pushnumber\", unsafe extern \"C\" fn(JS, f64))(j, v)\n361\t    }\n362\t    pub unsafe fn js_pushstring(&self, j: JS, v: *const c_char) {\n363\t        sym!(self, \"js_pushstring\", unsafe extern \"C\" fn(JS, *const c_char))(j, v)\n364\t    }\n365\t    pub unsafe fn js_pushlstring(&self, j: JS, v: *const c_char, n: c_int) {\n366\t        sym!(\n367\t            self,\n368\t            \"js_pushlstring\",\n369\t            unsafe extern \"C\" fn(JS, *const c_char, c_int)\n370\t        )(j, v, n)\n371\t    }\n372\t    pub unsafe fn js_pushliteral(&self, j: JS, v: *const c_char) {\n373\t        sym!(self, \"js_pushliteral\", unsafe extern \"C\" fn(JS, *const c_char))(j, v)\n374\t    }\n375\t    pub unsafe fn js_newobjectx(&self, j: JS) {\n376\t        sym!(self, \"js_newobjectx\", unsafe extern \"C\" fn(JS))(j)\n377\t    }\n378\t    pub unsafe fn js_newobject(&self, j: JS) {\n379\t        sym!(self, \"js_newobject\", unsafe extern \"C\" fn(JS))(j)\n380\t    }\n381\t    pub unsafe fn js_newarray(&self, j: JS) {\n382\t        sym!(self, \"js_newarray\", unsafe extern \"C\" fn(JS))(j)\n383\t    }\n384\t    pub unsafe fn js_newboolean(&self, j: JS, v: c_int) {\n385\t        sym!(self, \"js_newboolean\", unsafe extern \"C\" fn(JS, c_int))(j, v)\n386\t    }\n387\t    pub unsafe fn js_newnumber(&self, j: JS, v: f64) {\n388\t        sym!(self, \"js_newnumber\", unsafe extern \"C\" fn(JS, f64))(j, v)\n389\t    }\n390\t    pub unsafe fn js_newstring(&self, j: JS, v: *const c_char) {\n391\t        sym!(self, \"js_newstring\", unsafe extern \"C\" fn(JS, *const c_char))(j, v)\n392\t    }\n393\t    pub unsafe fn js_newcfunction(\n394\t        &self,\n395\t        j: JS,\n396\t        f: js_CFunction,\n397\t        name: *const c_char,\n398\t        length: c_int,\n399\t    ) {\n400\t        sym!(\n401\t            self,\n402\t            \"js_newcfunction\",\n403\t            unsafe extern \"C\" fn(JS, js_CFunction, *const c_char, c_int)\n404\t        )(j, f, name, length)\n405\t    }\n406\t    pub unsafe fn js_newcfunctionx(\n407\t        &self,\n408\t        j: JS,\n409\t        f: js_CFunction,\n410\t        name: *const c_char,\n411\t        length: c_int,\n412\t        data: *mut c_void,\n413\