nue;\n                }\n                if let Some(c) = char::from_u32(r) {\n                    s.push(c);\n                    break;\n                }\n            }\n        }\n        s\n    }\n}\n","structuredPatch":[{"oldStart":128,"oldLines":7,"newStart":128,"newLines":9,"lines":["         const RTLD_NOW: i32 = 0x2;","         const RTLD_GLOBAL: i32 = 0x100;","         for cand in [\"libm.so.6\", \"libm.so\"] {","-            if unsafe { UnixLibrary::open(Some(cand), RTLD_NOW | RTLD_GLOBAL) }.is_ok() {","+            if let Ok(l) = unsafe { UnixLibrary::open(Some(cand), RTLD_NOW | RTLD_GLOBAL) } {","+                // must never be dlclose()d, or it leaves the global scope again","+                std::mem::forget(l);","                 return;","             }","         }"]}],"userModified":false,"replaceAll":false}}
