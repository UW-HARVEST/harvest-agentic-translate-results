{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Vd8TraLA1p2eooFyDL86dq","type":"tool_result","content":"1\t//! mujs 1.3.8 -- a direct Rust transliteration of the C library in c_src/.\n2\t//!\n3\t//! The crate is a cdylib that exports the exact same public ABI as the C build.\n4\t\n5\t#![allow(non_snake_case)]\n6\t#![allow(non_camel_case_types)]\n7\t#![allow(non_upper_case_globals)]\n8\t#![allow(unused_parens)]\n9\t#![allow(unused_mut)]\n10\t#![allow(unused_variables)]\n11\t#![allow(unused_assignments)]\n12\t#![allow(unused_unsafe)]\n13\t#![allow(dead_code)]\n14\t#![allow(unreachable_code)]\n15\t#![allow(unused_imports)]\n16\t#![allow(unused_labels)]\n17\t\n18\tuse std::arch::naked_asm;\n19\t\n20\tpub mod jsi;\n21\t\n22\tuse crate::jsi::*;\n23\t\n24\t/* ================================================================ *\n25\t * Variadic entry points.\n26\t *\n27\t * The public API exposes printf-style variadic functions.  Stable Rust\n28\t * cannot define C variadic functions, so each one is a naked assembly\n29\t * trampoline that builds an x86-64 SysV va_list and forwards to a normal\n30\t * Rust function.\n31\t * ================================================================ */\n32\t\n33\tmacro_rules! va_trampoline {\n34\t    ($name:ident => $target:path, gp = $gp:expr, nargs = 2) => {\n35\t        #[unsafe(naked)]\n36\t        #[unsafe(no_mangle)]\n37\t        pub unsafe extern \"C\" fn $name() {\n38\t            naked_asm!(\n39\t                \"push %rbp\",\n40\t                \"mov %rsp, %rbp\",\n41\t                \"sub $208, %rsp\",\n42\t                \"movq %rdi, 0(%rsp)\",\n43\t                \"movq %rsi, 8(%rsp)\",\n44\t                \"movq %rdx, 16(%rsp)\",\n45\t                \"movq %rcx, 24(%rsp)\",\n46\t                \"movq %r8, 32(%rsp)\",\n47\t                \"movq %r9, 40(%rsp)\",\n48\t                \"testb %al, %al\",\n49\t                \"je 91f\",\n50\t                \"movaps %xmm0, 48(%rsp)\",\n51\t                \"movaps %xmm1, 64(%rsp)\",\n52\t                \"movaps %xmm2, 80(%rsp)\",\n53\t                \"movaps %xmm3, 96(%rsp)\",\n54\t                \"movaps %xmm4, 112(%rsp)\",\n55\t                \"movaps %xmm5, 128(%rsp)\",\n56\t                \"movaps %xmm6, 144(%rsp)\",\n57\t                \"movaps %xmm7, 160(%rsp)\",\n58\t                \"91:\",\n59\t                concat!(\"movl $\", $gp, \", 176(%rsp)\"),\n60\t                \"movl $48, 180(%rsp)\",\n61\t                \"leaq 16(%rbp), %rax\",\n62\t                \"movq %rax, 184(%rsp)\",\n63\t                \"movq %rsp, %rax\",\n64\t                \"movq %rax, 192(%rsp)\",\n65\t                \"movq 0(%rsp), %rdi\",\n66\t                \"movq 8(%rsp), %rsi\",\n67\t                \"leaq 176(%rsp), %rdx\",\n68\t                \"xorl %eax, %eax\",\n69\t                \"call {target}\",\n70\t                \"movq %rbp, %rsp\",\n71\t                \"pop %rbp\",\n72\t                \"ret\",\n73\t                target = sym $target,\n74\t                options(att_syntax)\n75\t            )\n76\t        }\n77\t    };\n78\t    ($name:ident => $target:path, gp = $gp:expr, nargs = 3) => {\n79\t        #[unsafe(naked)]\n80\t        #[unsafe(no_mangle)]\n81\t        pub unsafe extern \"C\" fn $name() {\n82\t            naked_asm!(\n83\t                \"push %rbp\",\n84\t                \"mov %rsp, %rbp\",\n85\t                \"sub $208, %rsp\",\n86\t                \"movq %rdi, 0(%rsp)\",\n87\t                \"movq %rsi, 8(%rsp)\",\n88\t                \"movq %rdx, 16(%rsp)\",\n89\t                \"movq %rcx, 24(%rsp)\",\n90\t                \"movq %r8, 32(%rsp)\",\n91\t                \"movq %r9, 40(%rsp)\",\n92\t                \"testb %al, %al\",\n93\t                \"je 91f\",\n94\t                \"movaps %xmm0, 48(%rsp)\",\n95\t                \"movaps %xmm1, 64(%rsp)\",\n96\t                \"movaps %xmm2, 80(%rsp)\",\n97\t                \"movaps %xmm3, 96(%rsp)\",\n98\