{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_018kPNTcV1pmC7Br9UG2N9TT","type":"tool_result","content":"1\t//! Phase B/C: differential tests for the utf.c entry points.\n2\t//! CONFIGS rows 159-179; ERRORS rows for utf.c.\n3\tmod common;\n4\tuse common::*;\n5\tuse std::ffi::{c_char, c_int};\n6\t\n7\tfn boundary_runes() -> Vec<i32> {\n8\t    let mut v = vec![\n9\t        0, 1, 0x1f, 0x20, 0x7e, 0x7f, 0x80, 0x81, 0x7fe, 0x7ff, 0x800, 0x801, 0xd7ff, 0xd800,\n10\t        0xdbff, 0xdc00, 0xdfff, 0xe000, 0xfffd, 0xfffe, 0xffff, 0x10000, 0x10001, 0x10fffe,\n11\t        0x10ffff, 0x110000, 0x110001, 0x1fffff, 0x200000, 0x7fffffff, -1, -2, -0x80000000,\n12\t        0x41, 0x61, 0xc0, 0xe0, 0x131, 0x130, 0x1e9e, 0xdf, 0x3a3, 0x3c2, 0x3c3, 0xfb00,\n13\t        0x1f88, 0x2126, 0x212a, 0x212b, 0x10400, 0x10428,\n14\t    ];\n15\t    // sweep every rune in the interesting Unicode ranges\n16\t    for r in 0..0x300 {\n17\t        v.push(r);\n18\t    }\n19\t    for r in 0x1000..0x1200 {\n20\t        v.push(r);\n21\t    }\n22\t    for r in 0x2100..0x2200 {\n23\t        v.push(r);\n24\t    }\n25\t    for r in 0xff00..0xff80 {\n26\t        v.push(r);\n27\t    }\n28\t    for r in 0x10400..0x10500 {\n29\t        v.push(r);\n30\t    }\n31\t    for r in 0x1e900..0x1e980 {\n32\t        v.push(r);\n33\t    }\n34\t    v\n35\t}\n36\t\n37\t#[test]\n38\tfn t_runelen() {\n39\t    let p = libs();\n40\t    unsafe {\n41\t        for c in boundary_runes() {\n42\t            let a = p.c.jsU_runelen(c);\n43\t            let b = p.rs.jsU_runelen(c);\n44\t            assert_eq!(a, b, \"runelen({c:#x})\");\n45\t        }\n46\t        let mut rng = Rng::new(11);\n47\t        for _ in 0..20000 {\n48\t            let c = rng.next_u32() as i32;\n49\t            assert_eq!(p.c.jsU_runelen(c), p.rs.jsU_runelen(c), \"runelen({c:#x})\");\n50\t        }\n51\t    }\n52\t}\n53\t\n54\t#[test]\n55\tfn t_runetochar() {\n56\t    let p = libs();\n57\t    unsafe {\n58\t        let check = |c: i32| {\n59\t            let mut ba = [0i8; 32];\n60\t            let mut bb = [0i8; 32];\n61\t            let r = c as Rune;\n62\t            let na = p.c.jsU_runetochar(ba.as_mut_ptr(), &r);\n63\t            let nb = p.rs.jsU_runetochar(bb.as_mut_ptr(), &r);\n64\t            assert_eq!(na, nb, \"runetochar({c:#x}) return\");\n65\t            assert_eq!(ba, bb, \"runetochar({c:#x}) bytes\");\n66\t        };\n67\t        for c in boundary_runes() {\n68\t            check(c);\n69\t        }\n70\t        let mut rng = Rng::new(12);\n71\t        for _ in 0..20000 {\n72\t            check((rng.next_u32() & 0x1f_ffff) as i32);\n73\t        }\n74\t        for _ in 0..5000 {\n75\t            check(rng.next_u32() as i32);\n76\t        }\n77\t    }\n78\t}\n79\t\n80\t#[test]\n81\tfn t_chartorune() {\n82\t    let p = libs();\n83\t    unsafe {\n84\t        let check = |bytes: &[u8], label: &str| {\n85\t            // NUL-terminate; chartorune reads until it has enough bytes\n86\t            let mut buf: Vec<u8> = bytes.to_vec();\n87\t            buf.push(0);\n88\t            buf.push(0);\n89\t            buf.push(0);\n90\t            buf.push(0);\n91\t            let mut ra: Rune = -12345;\n92\t            let mut rb: Rune = -12345;\n93\t            let na = p\n94\t                .c\n95\t                .jsU_chartorune(&mut ra, buf.as_ptr() as *const c_char);\n96\t            let nb = p\n97\t                .rs\n98\t                .jsU_chartorune(&mut rb, buf.as_ptr() as *const c_char);\n99\t            assert_eq!((na, ra), (nb, rb), \"chartorune({label}) {bytes:02x?}\");\n100\t        };\n101\t        // every single byte\n102\t        for b in 0u16..=255 {\n103\t            check(&[b as u8], \"single\");\n104\t        }\n105\t        // every 2-byte pair with a lead byte\n106\t        for lead in 0xc0u16..=0xffu16 {\n107\t            for second in [0u8, 0x1, 0x3f, 0x40, 0x7f, 0x80, 0x81, 0xbf, 0xc0, 0xff] {\n108\t                check(&[lead as u8, second], \"pair\");\n109\t            }\n110\t        }\n111\t        // canonical encodings of every boundary rune\n112\t        for c in boundary_runes() {\n113\t            let mut tmp = [0i8; 8];\n114\t            let r = c as Rune;\n115\t            let n = p.c.jsU_runetochar(tmp.as_mut_ptr(), &r);\n116\t            let bytes: Vec<u8> = (0..n as usize).map(|i| tmp[i] as u8).collect();\n117\t            check(&bytes, \"canonical\");\n118\t            // and truncations of it\n119\t            for k in 1..bytes.len() {\n120\t                check(&bytes[..k], \"truncated\");\n121\t            }\n122\t        }\n123\t        // overlong / random sequences\n124\t        let mut rng = Rng::new(13);\n125\t        for _ in 0..30000 {\n126\t            let n = 1 + rng.below(5) as usize;\n127\t            let bytes: Vec<u8> = (0..n).map(|_| (rng.next_u32() & 0xff) as u8).collect();\n128\t            check(&bytes, \"random\");\n129\t        }\n130\t        // sequences biased to be structurally plausible utf-8\n131\t        for _ in 0..30000 {\n132\t            let lead = match rng.below(4) {\n133\t                0 => 0xc0 | (rng.below(0x20) as u8),\n134\t                1 => 0xe0 | (rng.below(0x10) as u8),\n135\t                2 => 0xf0 | (rng.below(0x08) as u8),\n136\t                _ => rng.below(0x80) as u8,\n137\t            };\n138\t            let mut bytes = vec![lead];\n139\t            for _ in 0..3 {\n140\t                bytes.push(0x80 | (rng.below(0x40) as u8));\n141\t            }\n142\t            check(&bytes, \"plausible\");\n143\t        }\n144\t    }\n145\t}\n146\t\n147\t#[test]\n148\tfn t_rune_predicates_and_case() {\n149\t    let p = libs();\n150\t    unsafe {\n151\t        for name in [\"jsU_isalpharune\", \"jsU_islowerrune\", \"jsU_isupperrune\"] {\n152\t            for c in boundary_runes() {\n153\t                assert_eq!(\n154\t                    p.c.rune_pred(name, c),\n155\t                    p.rs.rune_pred(name, c),\n156\t                    \"{name}({c:#x})\"\n157\t                );\n158\t            }\n159\t        }\n160\t        for name in [\"jsU_tolowerrune\", \"jsU_toupperrune\"] {\n161\t            for c in boundary_runes() {\n162\t                assert_eq!(\n163\t                    p.c.rune_pred(name, c),\n164\t                    p.rs.rune_pred(name, c),\n165\t                    \"{name}({c:#x})\"\n166\t                );\n167\t            }\n168\t        }\n169\t        // exhaustive sweep of the whole BMP + a chunk of astral for the tables\n170\t        for c in 0..0x11000 {\n171\t            for name in [\n172\t                \"jsU_isalpharune\",\n173\t                \"jsU_islowerrune\",\n174\t                \"jsU_isupperrune\",\n175\t                \"jsU_tolowerrune\",\n176\t                \"jsU_toupperrune\",\n177\t            ] {\n178\t                let a = p.c.rune_pred(name, c);\n179\t                let b = p.rs.rune_pred(name, c);\n180\t                assert_eq!(a, b, \"{name}({c:#x})\");\n181\t            }\n182\t        }\n183\t        let mut rng = Rng::new(14);\n184\t        for _ in 0..5000 {\n185\t            let c = rng.next_u32() as i32;\n186\t            for name in [\n187\t                \"jsU_isalpharune\",\n188\t                \"jsU_islowerrune\",\n189\t                \"jsU_isupperrune\",\n190\t                \"jsU_tolowerrune\",\n191\t                \"jsU_toupperrune\",\n192\t            ] {\n193\t                assert_eq!(\n194\t                    p.c.rune_pred(name, c),\n195\t                    p.rs.rune_pred(name, c),\n196\t                    \"{name}({c:#x})\"\n197\t                );\n198\t            }\n199\t        }\n200\t    }\n201\t}\n202\t\n203\t#[test]\n204\tfn t_rune_full_case() {\n205\t    let p = libs();\n206\t    unsafe {\n207\t        let read = |lib: &Lib, name: &'static str, c: Rune| -> Option<Vec<Rune>> {\n208\t            let ptr = lib.rune_full(name, c);\n209\t            if ptr.is_null() {\n210\t                None\n211\t            } else {\n212\t                // the tables are NUL/0-terminated sequences of runes\n213\t                let mut v = vec![];\n214\t                let mut i = 0isize;\n215\t                loop {\n216\t                    let r = *ptr.offset(i);\n217\t                    if r == 0 || i > 8 {\n218\t                        break;\n219\t                    }\n220\t                    v.push(r);\n221\t                    i += 1;\n222\t                }\n223\t                Some(v)\n224\t            }\n225\t        };\n226\t        for name in [\"jsU_tolowerrune_full\", \"jsU_toupperrune_full\"] {\n227\t            for c in 0..0x11000 {\n228\t                let a = read(&p.c, name, c);\n229\t                let b = read(&p.rs, name, c);\n230\t                assert_eq!(a, b, \"{name}({c:#x})\");\n231\t            }\n232\t            for c in boundary_runes() {\n233\t                assert_eq!(\n234\t                    read(&p.c, name, c),\n235\t                    read(&p.rs, name, c),\n236\t                    \"{name}({c:#x})\"\n237\t                );\n238\t            }\n239\t        }\n240\t    }\n241\t}\n242\t\n243\t#[test]\n244\tfn t_utflen_and_ptrtoidx() {\n245\t    let p = libs();\n246\t    unsafe {\n247\t        let mut rng = Rng::new(15);\n248\t        let mut cases: Vec<Vec<u8>> = vec![\n249\t            vec![],\n250\t            b\"a\".to_vec(),\n251\t            b\"abc\".to_vec(),\n252\t            \"\\u{80}\".as_bytes().to_vec(),\n253\t            \"\\u{7ff}\\u{800}\\u{ffff}\\u{10000}\\u{10ffff}\".as_bytes().to_vec(),\n254\t            vec![0x80],             // stray continuation\n255\t            vec![0xc0],             // truncated\n256\t            vec![0xf4, 0x8f],       // truncated\n257\t            vec![0xff, 0xfe, 0xfd], // invalid\n258\t        ];\n259\t        for _ in 0..2000 {\n260\t            cases.push(rng.unicode_string(12).into_bytes());\n261\t        }\n262\t        for _ in 0..2000 {\n263\t            cases.push(rng.raw_bytes(12));\n264\t        }\n265\t        for bytes in &cases {\n266\t            let mut buf = bytes.clone();\n267\t            buf.push(0);\n268\t            let sp = buf.as_ptr() as *const c_char;\n269\t            let a = p.c.js_utflen(sp);\n270\t            let b = p.rs.js_utflen(sp);\n271\t            assert_eq!(a, b, \"js_utflen({bytes:02x?})\");\n272\t            for off in 0..=bytes.len() {\n273\t                let pp = sp.add(off);\n274\t                let a = p.c.js_utfptrtoidx(sp, pp);\n275\t                let b = p.rs.js_utfptrtoidx(sp, pp);\n276\t                assert_eq!(a, b, \"js_utfptrtoidx({bytes:02x?}, +{off})\");\n277\t            }\n278\t        }\n279\t    }\n280\t}\n281\t\n282\t#[test]\n283\tfn t_runeat() {\n284\t    let p = libs();\n285\t    unsafe {\n286\t        let jc = new_state(&p.c, 0);\n287\t        set_cur(&p.rs);\n288\t        let jr = new_state(&p.rs, 0);\n289\t        let mut rng = Rng::new(16);\n290\t        let mut cases: Vec<Vec<u8>> = vec![\n291\t            vec![],\n292\t            b\"a\".to_vec(),\n293\t            b\"hello\".to_vec(),\n294\t            \"\\u{80}\\u{7ff}\\u{800}\\u{10000}\".as_bytes().to_vec(),\n295\t            vec![0x80, 0x80],\n296\t            vec![0xc2],\n297\t        ];\n298\t        for _ in 0..800 {\n299\t            cases.push(rng.unicode_string(8).into_bytes());\n300\t        }\n301\t        for _ in 0..800 {\n302\t            cases.push(rng.raw_bytes(8));\n303\t        }\n304\t        for bytes in &cases {\n305\t            let mut buf = bytes.clone();\n306\t            buf.push(0);\n307\t            let sp = buf.as_ptr() as *const c_char;\n308\t            for i in -2..(bytes.len() as c_int + 3) {\n309\t                set_cur(&p.c);\n310\t                let a = p.c.js_runeat(jc, sp, i);\n311\t                set_cur(&p.rs);\n312\t                let b = p.rs.js_runeat(jr, sp, i);\n313\t                assert_eq!(a, b, \"js_runeat({bytes:02x?}, {i})\");\n314\t            }\n315\t        }\n316\t        set_cur(&p.c);\n317\t        p.c.js_freestate(jc);\n318\t        set_cur(&p.rs);\n319\t        p.rs.js_freestate(jr);\n320\t    }\n321\t}\n322\t"}]},"parent_tool_use_id":"toolu_bdrk_014EJrrhqixnoaGuQ4YBud4x","session_id":"a62d17ad-8528-487e-8b6a-23ad0ded9ac2","uuid":"93beb054-16b6-4d51-abed-bbbcf18480a7","timestamp":"2026-08-23T12:56:10.495Z","subagent_type":"general-purpose","task_description":"Phase C error tests: regexp/json/date"}
