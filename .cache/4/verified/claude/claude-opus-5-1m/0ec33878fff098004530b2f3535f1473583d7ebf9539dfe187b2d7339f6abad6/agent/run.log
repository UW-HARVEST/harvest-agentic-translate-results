{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01N6r95Cjb7wExpRXDTvMo25","type":"tool_result","content":"1\t//! Differential test harness: loads BOTH the C `libmujs.so` and the Rust\n2\t//! `libmujs.so` through `libloading` and calls every entry point purely\n3\t//! through the exported FFI symbols.\n4\t#![allow(dead_code, non_snake_case, non_camel_case_types)]\n5\t\n6\tuse libloading::{Library, Symbol};\n7\tuse std::cell::{Cell, RefCell};\n8\tuse std::ffi::{c_char, c_int, c_short, c_uint, c_ushort, c_void, CStr, CString};\n9\tuse std::path::PathBuf;\n10\t\n11\tpub type JS = *mut c_void; // js_State *\n12\tpub type Rune = c_int;\n13\t\n14\tpub type js_Alloc = Option<unsafe extern \"C\" fn(*mut c_void, *mut c_void, c_int) -> *mut c_void>;\n15\tpub type js_CFunction = Option<unsafe extern \"C\" fn(JS)>;\n16\tpub type js_Finalize = Option<unsafe extern \"C\" fn(JS, *mut c_void)>;\n17\tpub type js_Report = Option<unsafe extern \"C\" fn(JS, *const c_char)>;\n18\tpub type js_Panic = Option<unsafe extern \"C\" fn(JS)>;\n19\tpub type js_HasProperty = Option<unsafe extern \"C\" fn(JS, *mut c_void, *const c_char) -> c_int>;\n20\tpub type js_Put = Option<unsafe extern \"C\" fn(JS, *mut c_void, *const c_char) -> c_int>;\n21\tpub type js_Delete = Option<unsafe extern \"C\" fn(JS, *mut c_void, *const c_char) -> c_int>;\n22\t\n23\t/* ------------------------------------------------------------ constants */\n24\t\n25\tpub const JS_STRICT: c_int = 1;\n26\t\n27\tpub const JS_REGEXP_G: c_int = 1;\n28\tpub const JS_REGEXP_I: c_int = 2;\n29\tpub const JS_REGEXP_M: c_int = 4;\n30\t\n31\tpub const JS_READONLY: c_int = 1;\n32\tpub const JS_DONTENUM: c_int = 2;\n33\tpub const JS_DONTCONF: c_int = 4;\n34\t\n35\tpub const JS_ISUNDEFINED: c_int = 0;\n36\tpub const JS_ISNULL: c_int = 1;\n37\tpub const JS_ISBOOLEAN: c_int = 2;\n38\tpub const JS_ISNUMBER: c_int = 3;\n39\tpub const JS_ISSTRING: c_int = 4;\n40\tpub const JS_ISFUNCTION: c_int = 5;\n41\tpub const JS_ISOBJECT: c_int = 6;\n42\t\n43\tpub const REG_ICASE: c_int = 1;\n44\tpub const REG_NEWLINE: c_int = 2;\n45\tpub const REG_NOTBOL: c_int = 4;\n46\t\n47\tpub const REG_MAXSUB: usize = 16;\n48\t\n49\t#[repr(C)]\n50\t#[derive(Clone, Copy)]\n51\tpub struct ResubSub {\n52\t    pub sp: *const c_char,\n53\t    pub ep: *const c_char,\n54\t}\n55\t\n56\t#[repr(C)]\n57\t#[derive(Clone, Copy)]\n58\tpub struct Resub {\n59\t    pub nsub: c_int,\n60\t    pub sub: [ResubSub; REG_MAXSUB],\n61\t}\n62\t\n63\timpl Default for Resub {\n64\t    fn default() -> Self {\n65\t        Resub {\n66\t            nsub: 0,\n67\t            sub: [ResubSub {\n68\t                sp: std::ptr::null(),\n69\t                ep: std::ptr::null(),\n70\t            }; REG_MAXSUB],\n71\t        }\n72\t    }\n73\t}\n74\t\n75\t/* --------------------------------------------------------------- paths */\n76\t\n77\tfn crate_root() -> PathBuf {\n78\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n79\t}\n80\t\n81\tpub fn c_so_path() -> PathBuf {\n82\t    crate_root().join(\"c_src/build/libmujs.so\")\n83\t}\n84\t\n85\t/// The Rust cdylib. We deliberately load it through `libloading` rather than\n86\t/// linking it, so every call goes through the real `#[no_mangle]` exports.\n87\tpub fn rust_so_path() -> PathBuf {\n88\t    // OUT_DIR-free discovery: the test binary lives in target/<profile>/deps/\n89\t    let exe = std::env::current_exe().expect(\"current_exe\");\n90\t    let mut dir = exe.parent().unwrap().to_path_buf();\n91\t    if dir.ends_with(\"deps\") {\n92\t        dir.pop();\n93\t    }\n94\t    let p = dir.join(\"libmujs.so\");\n95\t    if p.exists() {\n96\t        return p;\n97\t    }\n98\t    // fall back to the usual debug location\n99\t    crate_root().join(\"target/debug/libmujs.so\")\n100\t}\n101\t\n102\t/* --------------------------------------------------------------- Lib */\n103\t\n104\tpub struct Lib {\n105\t    pub name: &'static str,\n106\t    lib: Library,\n107\t}\n108\t\n109\tmacro_rules! sym {\n110\t    ($self:expr, $name:literal, $t:ty) => {{\n111\t        let s: Symbol<$t> = $self\n112\t            .lib\n113\t            .get(concat!($name, \"\\0\").as_bytes())\n114\t            .unwrap_or_else(|e| panic!(\"{}: missing symbol {}: {}\", $self.name, $name, e));\n115\t        *s\n116\t    }};\n117\t}\n118\t\n119\t/// The C `libmujs.so` produced by CMakeLists.txt is not linked against libm\n120\t/// (`ceil`, `floor`, `fmod`, `sqrt` are undefined in it), so we must make libm\n121\t/// globally visible before dlopen'ing it. `c_src/` is read-only, so this has to\n122\t/// happen here in the harness.\n123\tfn preload_libm() {\n124\t    use libloading::os::unix::Library as UnixLibrary;\n125\t    use std::sync::OnceLock;\n126\t    static M: OnceLock<()> = OnceLock::new();\n127\t    M.get_or_init(|| {\n128\t        const RTLD_NOW: i32 = 0x2;\n129\t        const RTLD_GLOBAL: i32 = 0x100;\n130\t        for cand in [\"libm.so.6\", \"libm.so\"] {\n131\t            if let Ok(l) = unsafe { UnixLibrary::open(Some(cand), RTLD_NOW | RTLD_GLOBAL) } {\n132\t                // must never be dlclose()d, or it leaves the global scope again\n133\t                std::mem::forget(l);\n134\t                return;\n135\t            }\n136\t        }\n137\t        panic!(\"cannot preload libm\");\n138\t    });\n139\t}\n140\t\n141\timpl Lib {\n142\t    pub fn open(name: &'static str, path: &PathBuf) -> Lib {\n143\t        preload_libm();\n144\t        let lib = unsafe { Library::new(path) }\n145\t            .unwrap_or_else(|e| panic!(\"cannot dlopen {}: {}\", path.display(), e));\n146\t        Lib { name, lib }\n147\t    }\n148\t\n149\t    pub fn has(&self, name: &str) -> bool {\n150\t        let mut b = name.as_bytes().to_vec();\n151\t        b.push(0);\n152\t        unsafe { self.lib.get::<*mut c_void>(&b) }.is_ok()\n153\t    }\n154\t}\n155\t\n156\t/* Every wrapper below is `unsafe` and looks the symbol up on each call. */\n157\timpl Lib {\n158\t    /* ---------------- state ---------------- */\n159\t    pub unsafe fn js_newstate(&self, alloc: js_Alloc, actx: *mut c_void, flags: c_int) -> JS {\n160\t        sym!(self, \"js_newstate\", unsafe extern \"C\" fn(js_Alloc, *mut c_void, c_int) -> JS)(\n161\t            alloc, actx, flags,\n162\t        )\n163\t    }\n164\t    pub unsafe fn js_freestate(&self, j: JS) {\n165\t        sym!(self, \"js_freestate\", unsafe extern \"C\" fn(JS))(j)\n166\t    }\n167\t    pub unsafe fn js_setcontext(&self, j: JS, u: *mut c_void) {\n168\t        sym!(self, \"js_setcontext\", unsafe extern \"C\" fn(JS, *mut c_void))(j, u)\n169\t    }\n170\t    pub unsafe fn js_getcontext(&self, j: JS) -> *mut c_void {\n171\t        sym!(self, \"js_getcontext\", unsafe extern \"C\" fn(JS) -> *mut c_void)(j)\n172\t    }\n173\t    pub unsafe fn js_setreport(&self, j: JS, r: js_Report) {\n174\t        sym!(self, \"js_setreport\", unsafe extern \"C\" fn(JS, js_Report))(j, r)\n175\t    }\n176\t    pub unsafe fn js_atpanic(&self, j: JS, p: js_Panic) -> js_Panic {\n177\t        sym!(self, \"js_atpanic\", unsafe extern \"C\" fn(JS, js_Panic) -> js_Panic)(j, p)\n178\t    }\n179\t    pub unsafe fn js_report(&self, j: JS, m: *const c_char) {\n180\t        sym!(self, \"js_report\", unsafe extern \"C\" fn(JS, *const c_char))(j, m)\n181\t    }\n182\t    pub unsafe fn js_gc(&self, j: JS, report: c_int) {\n183\t        sym!(self, \"js_gc\", unsafe extern \"C\" fn(JS, c_int))(j, report)\n184\t    }\n185\t    pub unsafe fn js_setlimit(&self, j: JS, runlimit: c_int, memlimit: c_int) {\n186\t        sym!(self, \"js_setlimit\", unsafe extern \"C\" fn(JS, c_int, c_int))(j, runlimit, memlimit)\n187\t    }\n188\t    pub unsafe fn js_dostring(&self, j: JS, src: *const c_char) -> c_int {\n189\t        sym!(self, \"js_dostring\", unsafe extern \"C\" fn(JS, *const c_char) -> c_int)(j, src)\n190\t    }\n191\t    pub unsafe fn js_ploadstring(&self, j: JS, f: *const c_char, s: *const c_char) -> c_int {\n192\t        sym!(\n193\t            self,\n194\t      