or pat in [\"a*b\", \"a+b\", \"(a)*b\"] {\n1272\t        let mut flip_c = None;\n1273\t        for n in 4080..=4110usize {\n1274\t            let text = \"a\".repeat(n);\n1275\t            let rc = diff_exec(pat, 0, &[(text.as_str(), 0)])[0].rc;\n1276\t            if rc == -1 && flip_c.is_none() {\n1277\t                flip_c = Some(n);\n1278\t            }\n1279\t            if flip_c.is_some() {\n1280\t                assert_eq!(rc, -1, \"{pat:?} n={n} should stay at -1 once it flips\");\n1281\t            } else {\n1282\t                assert_eq!(rc, 1, \"{pat:?} n={n} should be plain no-match\");\n1283\t            }\n1284\t        }\n1285\t        assert!(\n1286\t            flip_c.is_some(),\n1287\t            \"{pat:?} never reached REG_MAXREC in 4080..4110\"\n1288\t        );\n1289\t    }\n1290\t    // row 767 (I_PLA) and row 769 (I_NLA) propagating -1: put the deep\n1291\t    // repetition INSIDE a lookahead so the -1 must cross that frame.\n1292\t    for n in [4096usize, 4200, 5000] {\n1293\t        let text = \"a\".repeat(n);\n1294\t        for pat in [\"(?=a*b)\", \"(?!a*b)\", \"(?=a*b)a\", \"(?:(?=a*b))\", \"x|(?=a*b)\"] {\n1295\t            diff_exec(pat, 0, &[(text.as_str(), 0)]);\n1296\t        }"}]},"parent_tool_use_id":"toolu_bdrk_014EJrrhqixnoaGuQ4YBud4x","session_id":"a62d17ad-8528-487e-8b6a-23ad0ded9ac2","uuid":"5719d913-47d5-4108-b7b0-225aeb7ab417","timestamp":"2026-08-23T13:50:30.075Z","subagent_type":"general-purpose","task_description":"Phase C error tests: regexp/json/date"}
