{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01GjCqgJYTG2Fenkmi7M243T","type":"tool_result","content":"1\t//! Differential tests for the state / call / registry / GC surface of the\n2\t//! public API.  Covers CONFIGS.md rows 1-40 and 183-197.\n3\t//!\n4\t//! Everything goes through the two `.so` exports via `tests/common/mod.rs`.\n5\t//!\n6\t//! Rows that are deliberately *not* driven, with the reason:\n7\t//!\n8\t//! * `jsrun.c:1400` `js_pconstruct` computes `savetop = TOP - n - 2` while\n9\t//!   `js_construct` wants the callee at `-n-1`, i.e. `savetop` names the slot\n10\t//!   *below* the callee.  Calling `js_pconstruct` with the callee as the very\n11\t//!   first stack slot therefore makes the error path write `STACK[-1]`, an\n12\t//!   out-of-bounds write.  Every `js_pconstruct` test below keeps a sentinel\n13\t//!   value underneath the callee so that slot is in range.\n14\t//! * `jsgc.c:254` divides by `ntot` (`100*gtot/ntot`).  `ntot` is only 0 for a\n15\t//!   state with no environments, functions, objects, properties and strings at\n16\t//!   all, which `js_newstate` can never produce, so the division is safe for\n17\t//!   every state reachable through the public API and is exercised below.\n18\t//! * `jsrun.c:1465` `js_throw` with `trytop == 0` runs the panic hook and then\n19\t//!   `abort()`s.  That cannot be observed in-process, so it is driven in a\n20\t//!   forked copy of this test binary (`t_panic_default_vs_custom`).\n21\t//! * `jsrun.c:1446` `js_savetry` at `trytop == JS_TRYLIMIT` calls\n22\t//!   `js_trystackoverflow`, which throws into `trybuf[trytop-1]`.  The tests\n23\t//!   below never push a 65th frame with `js_savetry` directly (there is no\n24\t//!   `setjmp` behind those frames), they reach the limit and then use the\n25\t//!   *protected* entry points (`js_ploadstring`, `js_dostring`, `js_trystring`)\n26\t//!   whose `js_ptry` guard returns without throwing.  The `js_trystackoverflow`\n27\t//!   path itself is driven through nested JS `try` blocks and nested\n28\t//!   `js_pcall`s, where a real `setjmp` frame is always underneath.\n29\t//! * `jsrepr.c:275` `js_tryrepr` is the one `js_try*` helper *without* a\n30\t//!   `js_ptry` guard, so at `trytop == JS_TRYLIMIT` it throws instead of\n31\t//!   returning the caller's default.  The try-limit tests therefore inspect\n32\t//!   values with `safeview()` (`js_type` / `js_typeof` / `js_tostring` on a\n33\t//!   value already known to be a string), none of which can throw.\n34\t//! * `jsbuiltin.c:205` stores `js_regcompx(...)` into\n35\t//!   `RegExp_prototype->u.r.prog` without a NULL check, and `regexp.c:903`\n36\t//!   turns an allocation failure into a NULL return rather than a throw.  An\n37\t//!   allocator that fails during that one compile therefore yields a *usable*\n38\t//!   state with a NULL prog, so `t_newstate_alloc_fails` compares the C and\n39\t//!   Rust decision for every failing allocation index instead of insisting on\n40\t//!   a NULL state.\n41\t\n42\tmod common;\n43\tuse common::*;\n44\tuse std::cell::Cell;\n45\tuse std::ffi::{c_char, c_int, c_void};\n46\tuse std::ptr::null_mut;\n47\t\n48\t/* ------------------------------------------------------------------ libc */\n49\t\n50\textern \"C\" {\n51\t    fn realloc(p: *mut c_void, n: usize) -> *mut c_void;\n52\t    fn free(p: *mut c_void);\n53\t    fn pipe(fds: *mut c_int) -> c_int;\n54\t    fn dup(fd: c_int) -> c_int;\n55\t    fn dup2(a: c_int, b: c_int) -> c_int;\n56\t    fn close(fd: c_int) -> c_int;\n57\t    fn read(fd: c_int, buf: *mut c_void, n: usize) -> isize;\n58\t    fn write(fd: c_int, buf: *const c_void, n: usize) -> isize;\n59\t}\n60\t\n61\t/* ----------------------------------------------------------- name literals */\n62\t\n63\tmacro_rules! cn {\n64\t    ($s:literal) => {\n65\t        concat!($s, \"\\0\").as_ptr() as *const c_char\n66\t    };\n67\t}\n68\t\n69\tconst N_GV: *const c_char = cn!(\"gv\");\n70\tconst N_X: *const c_char = cn!(\"x\");\n71\tconst N_UD: *const c_char = cn!(\"ud\");\n72\tconst N_TAG: *const c_char = cn!(\"mytag\");\n73\tconst N_INNER: *const c_char = cn!(\"inner\");\n74\tconst N_PROBE: *const c_char = cn!(\"probe\");\n75\tconst N_CTOR: *const c_char = cn!(\"Ctor\");\n76\tconst N_VOIDF: *const c_char = cn!(\"voidf\");\n77\tconst N_THREE: *const c_char = cn!(\"three\");\n78\tconst N_DATAF: *const c_char = cn!(\"dataf\");\n79\tconst N_REC: *const c_char = cn!(\"rec\");\n80\tconst PAYLOAD: *const c_char = cn!(\"payload-A\");\n81\t\n82\t/* ------------------------------------------------------- tracking allocator */\n83\t\n84\tconst ACTX_MAGIC: u64 = 0x5a5a_1234_dead_beef;\n85\t\n86\t#[repr(C)]\n87\t#[derive(Default)]\n88\tstruct Actx {\n89\t    magic: u64,\n90\t    live: i64,\n91\t    nalloc: u64,\n92\t    nrealloc: u64,\n93\t    nfree: u64,\n94\t    ncalls: u64,\n95\t    fail_at: u64,\n96\t    failed: u64,\n97\t    bad_actx: u64,\n98\t}\n99\t\n100\timpl Actx {\n101\t    fn new(fail_at: u64) -> Box<Actx> {\n102\t        Box::new(Actx {\n103\t            magic: ACTX_MAGIC,\n104\t            fail_at,\n105\t            ..Default::default()\n106\t        })\n107\t    }\n108\t}\n109\t\n110\t/// A `js_Alloc` that (a) proves `actx` is threaded through untouched,\n111\t/// (b) counts every allocating / freeing call so leaks can be compared, and\n112\t/// (c) can be made to return NULL on exactly the Nth allocating call.\n113\tunsafe extern \"C\" fn tracking_alloc(\n114\t    actx: *mut c_void,\n115\t    ptr: *mut c_void,\n116\t    size: c_int,\n117\t) -> *mut c_void {\n118\t    if actx.is_null() {\n119\t        // cannot record anything; fall back to plain realloc semantics\n120\t        if size == 0 {\n121\t            free(ptr);\n122\t            return null_mut();\n123\t        }\n124\t        return realloc(ptr, size as usize);\n125\t    }\n126\t    let cx = &mut *(actx as *mut Actx);\n127\t    if cx.magic != ACTX_MAGIC {\n128\t        cx.bad_actx += 1;\n129\t    }\n130\t    if size == 0 {\n131\t        if !ptr.is_null() {\n132\t            cx.nfree += 1;\n133\t            cx.live -= 1;\n134\t        }\n135\t        free(ptr);\n136\t        return null_mut();\n137\t    }\n138\t    cx.ncalls += 1;\n139\t    if cx.fail_at != 0 && cx.ncalls == cx.fail_at {\n140\t        cx.failed += 1;\n141\t        return null_mut();\n142\t    }\n143\t    let p = realloc(ptr, size as usize);\n144\t    if !p.is_null() {\n145\t        if ptr.is_null() {\n146\t            cx.nalloc += 1;\n147\t            cx.live += 1;\n148\t        } else {\n149\t            cx.nrealloc += 1;\n150\t        }\n151\t    }\n152\t    p\n153\t}\n154\t\n155\t/* ------------------------------------------------------------- diff driver */\n156\t\n157\t/// Run `f` against the C library and then the Rust library, wrapping each run\n158\t/// in a fresh output buffer, and assert the two transcripts are byte-identical.\n159\tfn diff2(tag: &str, f: impl Fn(&Lib) -> String) -> String {\n160\t    let p = libs();\n161\t    let a = {\n162\t        out_clear();\n163\t        set_cur(&p.c);\n164\t        let r = f(&p.c);\n165\t        format!(\"{r}\\n--out--\\n{}\", out_take())\n166\t    };\n167\t    let b = {\n168\t        out_clear();\n169\t        set_cur(&p.rs);\n170\t        let r = f(&p.rs);\n171\t        format!(\"{r}\\n--out--\\n{}\", out_take())\n172\t    };\n173\t    assert_eq!(a, b, \"divergence in [{tag}]\");\n174\t    a\n175\t}\n176\t\n177\t/// Snapshot of the top of the stack plus the frame size.\n178\tunsafe fn snap(l: &Lib, j: JS) -> String {\n179\t    format!(\n180\t        \"top={} v={} ty={}\",\n181\t        l.js_gettop(j),\n182\t        from_c(l.js_tryrepr(j, -1, ERRSTR)),\n183\t        from_c(l.js_typeof(j, -1))\n184\t    )\n185\t}\n186\t\n187\t/// Describe the top of the stack without going through any `js_try`-based\n188\t/// helper.  `js_tryrepr` (jsrepr.c:275) has *no* `js_ptry` guard, so calling it\n189\t/// at `trytop == JS_TRYLIMIT` throws into the enclosing frame; the try-limit\n190\t/// tests must therefore inspect values with these non-throwing accessors only.\n191\tunsafe fn safeview(l: &Lib, j: JS) -> String {\n192\t    let mut s = format!(\n193\t        \"type={} ty={}\",\n194\t        l.js_type(j, -1),\n195\t        from_c(l.js_typeof(j, -1))\n196\t    );\n197\t    if l.pred(\"js_isstring\", j, -1) != 0 {\n198\t        s.push_str(&format!(\" s={:?}\", from_c(l.js_tostring(j, -1))));\n199\t    }\n200\t    s\n201\t}\n202\t\n203\t/// `js_ref` renders an object as `\"%p\"` of its address (jsrun.c:949), which is\n204\t/// necessarily different in the two processes' heaps.  Replace it with a stable\n205\t/// token so the rest of the transcript can still be compared byte-for-byte.\n206\tfn norm_ref(name: &str) -> String {\n207\t    if name.starts_with(\"0x\") || name == \"(nil)\" {\n208\t        \"<ptr>\".to_string()\n209\t    } else {\n210\t        name.to_string()\n211\t    }\n212\t}\n213\t\n214\t/// Pop back down to `base` without ever asking `js_pop` for more than there is\n215\t/// (`js_pop` past the frame raises js_error \"stack underflow!\").\n216\tunsafe fn drain_to(l: &Lib, j: JS, base: c_int) {\n217\t    let t = l.js_gettop(j);\n218\t    if t > base {\n219\t        l.js_pop(j, t - base);\n220\t    }\n221\t}\n222\t\n223\t/// `js_ploadstring` + `js_pcall` of an expression, leaving its value on the\n224\t/// stack.  Returns the composite return code.\n225\tunsafe fn push_expr(l: &Lib, j: JS, src: &str) -> c_int {\n226\t    let cs = cstr(src);\n227\t    let rc = l.js_ploadstring(j, FILENAME, cs.as_ptr());\n228\t    if rc != 0 {\n229\t        return 100 + rc;\n230\t    }\n231\t    l.js_pushundefined(j);\n232\t    l.js_pcall(j, 0)\n233\t}\n234\t\n235\t/* ---------------------------------------------------------- C callbacks */\n236\t\n237\t/// Records the frame it was called in, then returns a string.\n238\tunsafe extern \"C\" fn cf_probe(j: JS) {\n239\t    let l = cur();\n240\t    let top = l.js_gettop(j);\n241\t    let mut s = format!(\"[probe top={top} this={}\", from_c(l.js_typeof(j, 0)));\n242\t    for i in 1..top {\n243\t        s.push_str(&format!(\n244\t            \" a{i}={}:{}\",\n245\t            from_c(l.js_typeof(j, i)),\n246\t            from_c(l.js_tryrepr(j, i, ERRSTR))\n247\t        ));\n248\t    }\n249\t    s.push_str(\"]\\n\");\n250\t    out_push(s.as_bytes());\n251\t    l.js_pushstring(j, cn!(\"probe-result\"));\n252\t}\n253\t\n254\t/// Pushes nothing at all (row 26: TOP == save_top -> undefined result).\n255\tunsafe extern \"C\" fn cf_void(j: JS) {\n256\t    let l = cur();\n257\t    out_push(format!(\"[void top={}]\\n\", l.js_gettop(j)).as_bytes());\n258\t}\n259\t\n260\t/// Pushes three values (row 26: only the topmost survives).\n261\tunsafe extern \"C\" fn cf_three(j: JS) {\n262\t    let l = cur();\n263\t    out_push(format!(\"[three top={}]\\n\", l.js_gettop(j)).as_bytes());\n264\t    l.js_pushnumber(j, 1.0);\n265\t    l.js_pushstring(j, cn!(\"two\"));\n266\t    l.js_pushboolean(j, 1);\n267\t}\n268\t\n269\t/// A C constructor body: `this` is null, it builds its own object.\n270\tunsafe extern \"C\" fn cc_probe(j: JS) {\n271\t    let l = cur();\n272\t    let top = l.js_gettop(j);\n273\t    out_push(\n274\t        format!(\n275\t            \"[cc top={top} this={}:{}]\\n\",\n276\t            from_c(l.js_typeof(j, 0)),\n277\t            from_c(l.js_tryrepr(j, 0, ERRSTR))\n278\t        )\n279\t        .as_bytes(),\n280\t    );\n281\t    l.js_newobject(j);\n282\t    l.js_pushnumber(j, top as f64);\n283\t    l.js_setproperty(j, -2, cn!(\"n\"));\n284\t}\n285\t\n286\t/// Row 56 / 79: js_currentfunction + js_currentfunctiondata inside a frame.\n287\tunsafe extern \"C\" fn cf_data(j: JS) {\n288\t    let l = cur();\n289\t    let d = l.js_currentfunctiondata(j);\n290\t    let ds = if d.is_null() {\n291\t        \"<NULL>\".to_string()\n292\t    } else {\n293\t        from_c(d as *const c_char)\n294\t    };\n295\t    l.js_currentfunction(j);\n296\t    out_push(\n297\t        format!(\n298\t            \"[data={ds} fn={} callable={} same={}]\\n\",\n299\t            from_c(l.js_typeof(j, -1)),\n300\t            l.pred(\"js_iscallable\", j, -1),\n301\t            (d == PAYLOAD as *mut c_void) as i32\n302\t        )\n303\t        .as_bytes(),\n304\t    );\n305\t    l.js_pop(j, 1);\n306\t    l.js_pushstring(j, cn!(\"dataf-ok\"));\n307\t}\n308\t\n309\tthread_local! {\n310\t    static REDEF_ATTS: Cell<c_int> = const { Cell::new(0) };\n311\t    static FIN_LIMIT: Cell<c_int> = const { Cell::new(0) };\n312\t}\n313\t\n314\t/// Row 79 / row 12: `js_newcfunctionx` wraps its object construction in a\n315\t/// `js_try` whose handler runs `finalize(J, data)` and then rethrows.  The only\n316\t/// way to reach it through the public API is to run out of memory, so squeeze\n317\t/// `js_setlimit`'s memlimit shut first.  Must be called in a protected frame.\n318\tunsafe extern \"C\" fn cf_oom_cfunctionx(j: JS) {\n319\t    let l = cur();\n320\t    l.js_setlimit(j, 0, FIN_LIMIT.with(|c| c.get()));\n321\t    l.js_newcfunctionx(\n322\t        j,\n323\t        Some(cf_void),\n324\t        N_VOIDF,\n325\t        0,\n326\t        PAYLOAD as *mut c_void,\n327\t        Some(fin_cb),\n328\t    );\n329\t}\n330\t\n331\t/// The same for `js_newuserdatax` (jsvalue.c:548).\n332\tunsafe extern \"C\" fn cf_oom_userdatax(j: JS) {\n333\t    let l = cur();\n334\t    l.js_newobject(j); // prototype, allocated before the limit closes\n335\t    l.js_setlimit(j, 0, FIN_LIMIT.with(|c| c.get()));\n336\t    l.js_newuserdatax(\n337\t        j,\n338\t        N_TAG,\n339\t        PAYLOAD as *mut c_void,\n340\t        Some(ud_has),\n341\t        Some(ud_put),\n342\t        Some(ud_del),\n343\t        Some(fin_cb),\n344\t    );\n345\t}\n346\t\n347\t/// Protected `js_defglobal` re-definition (row 189): jsR_defproperty raises a\n348\t/// typeerror when the existing property carries JS_DONTCONF.\n349\tunsafe extern \"C\" fn cf_redef(j: JS) {\n350\t    let l = cur();\n351\t    l.js_pushstring(j, cn!(\"second\"));\n352\t    l.js_defglobal(j, N_GV, REDEF_ATTS.with(|c| c.get()));\n353\t    l.js_getglobal(j, N_GV);\n354\t}\n355\t\n356\t/// Protected `js_setglobal` (throws for a JS_READONLY global in strict mode).\n357\tunsafe extern \"C\" fn cf_setgv(j: JS) {\n358\t    let l = cur();\n359\t    l.js_pushnumber(j, 123.0);\n360\t    l.js_setglobal(j, N_GV);\n361\t    l.js_getglobal(j, N_GV);\n362\t}\n363\t\n364\t/// Protected `js_delglobal` (throws for a JS_DONTCONF global in strict mode).\n365\tunsafe extern \"C\" fn cf_delgv(j: JS) {\n366\t    let l = cur();\n367\t    l.js_delglobal(j, N_GV);\n368\t    l.js_getglobal(j, N_GV);\n369\t}\n370\t\n371\tunsafe extern \"C\" fn fin_cb(_j: JS, data: *mut c_void) {\n372\t    let ds = if data.is_null() {\n373\t        \"<NULL>\".to_string()\n374\t    } else {\n375\t        from_c(data as *const c_char)\n376\t    };\n377\t    out_push(format!(\"[finalize {ds}]\\n\").as_bytes());\n378\t}\n379\t\n380\t/* ------------------------------------------------------ userdata hooks */\n381\t\n382\tunsafe extern \"C\" fn ud_has(j: JS, data: *mut c_void, name: *const c_char) -> c_int {\n383\t    let n = from_c(name);\n384\t    out_push(format!(\"[has {} {}]\\n\", from_c(data as *const c_char), n).as_bytes());\n385\t    if n.starts_with(\"magic\") {\n386\t        cur().js_pushnumber(j, 42.0);\n387\t        return 1;\n388\t    }\n389\t    0\n390\t}\n391\t\n392\tunsafe extern \"C\" fn ud_put(_j: JS, data: *mut c_void, name: *const c_char) -> c_int {\n393\t    let n = from_c(name);\n394\t    out_push(format!(\"[put {} {}]\\n\", from_c(data as *const c_char), n).as_bytes());\n395\t    n.starts_with(\"ro\") as c_int\n396\t}\n397\t\n398\tunsafe extern \"C\" fn ud_del(_j: JS, data: *mut c_void, name: *const c_char) -> c_int {\n399\t    let n = from_c(name);\n400\t    out_push(format!(\"[del {} {}]\\n\", from_c(data as *const c_char), n).as_bytes());\n401\t    n.starts_with(\"del\") as c_int\n402\t}\n403\t\n404\t/* --------------------------------------------- js_call / js_construct thunk */\n405\t\n406\tthread_local! {\n407\t    /// 0 = js_call, 1 = js_construct\n408\t    static INNER_MODE: Cell<i32> = const { Cell::new(0) };\n409\t    /// depth at which the recursive js_pcall driver stops\n410\t    static REC_TARGET: Cell<i32> = const { Cell::new(0) };\n411\t    static REC_DEPTH: Cell<i32> = const { Cell::new(0) };\n412\t    /// source handed to the js_loadeval / js_eval thunks\n413\t    static EVAL_SRC: Cell<*const c_char> = const { Cell::new(std::ptr::null()) };\n414\t}\n415\t\n416\t/// `inner(callee, a1, a2, ...)` -- performs the *unprotected* `js_call` or\n417\t/// `js_construct` from inside a protected cfunction frame.\n418\tunsafe extern \"C\" fn cf_inner(j: JS) {\n419\t    let l = cur();\n420\t    let top = l.js_gettop(j);\n421\t    let nargs = if top >= 2 { top - 2 } else { 0 };\n422\t    l.js_copy(j, 1); // callee\n423\t    let mode = INNER_MODE.with(|m| m.get());\n424\t    if mode == 0 {\n425\t        l.js_pushundefined(j); // this\n426\t    }\n427\t    for i in 0..nargs {\n428\t        l.js_copy(j, 2 + i);\n429\t    }\n430\t    if mode == 0 {\n431\t        l.js_call(j, nargs);\n432\t    } else {\n433\t        l.js_construct(j, nargs);\n434\t    }\n435\t}\n436\t\n437\t/// `rec()` -- recursively `js_pcall`s itself so that `trytop` grows by one per\n438\t/// level, then exercises the protected entry points at the limit.\n439\tunsafe extern \"C\" fn cf_rec(j: JS) {\n440\t    let l = cur();\n441\t    let d = REC_DEPTH.with(|c| {\n442\t        let v = c.get() + 1;\n443\t        c.set(v);\n444\t        v\n445\t    });\n446\t    if d >= REC_TARGET.with(|c| c.get()) {\n447\t        let base = l.js_gettop(j);\n448\t        let src = cstr(\"1+1\");\n449\t        let rc = l.js_ploadstring(j, FILENAME, src.as_ptr());\n450\t        out_push(\n451\t            format!(\n452\t                \"[at depth {d}: ploadstring rc={rc} {}]\\n\",\n453\t                safeview(l, j)\n454\t            )\n455\t            .as_bytes(),\n456\t        );\n457\t        drain_to(l, j, base);\n458\t        let rc2 = l.js_dostring(j, src.as_ptr());\n459\t        out_push(format!(\"[at depth {d}: dostring rc={rc2}]\\n\").as_bytes());\n460\t        drain_to(l, j, base);\n461\t        l.js_pushnumber(j, d as f64);\n462\t    } else {\n463\t        l.js_getglobal(j, N_REC);\n464\t        l.js_pushundefined(j);\n465\t        let rc = l.js_pcall(j, 0);\n466\t        if rc != 0 {\n467\t            out_push(format!(\"[depth {d}: pcall rc={rc} {}]\\n\", safeview(l, j)).as_bytes());\n468\t        }\n469\t    }\n470\t    REC_DEPTH.with(|c| c.set(c.get() - 1));\n471\t}\n472\t\n473\t/// Protected `js_loadeval` + `js_call` thunk (rows 17/18/34).\n474\tunsafe extern \"C\" fn cf_loadeval(j: JS) {\n475\t    let l = cur();\n476\t    let src = EVAL_SRC.with(|c| c.get());\n477\t    l.js_loadeval(j, cn!(\"(loadeval)\"), src);\n478\t    let scriptty = from_c(l.js_typeof(j, -1));\n479\t    l.js_pushundefined(j);\n480\t    l.js_call(j, 0);\n481\t    out_push(\n482\t        format!(\n483\t            \"[loadeval script={scriptty} result={}]\\n\",\n484\t            from_c(l.js_tryrepr(j, -1, ERRSTR))\n485\t        )\n486\t        .as_bytes(),\n487\t    );\n488\t}\n489\t\n490\t/// Protected `js_eval` thunk (row 22).  Argument 1 is copied to the top and\n491\t/// `js_eval` is invoked on it.\n492\tunsafe extern \"C\" fn cf_eval(j: JS) {\n493\t    let l = cur();\n494\t    let before = l.js_gettop(j);\n495\t    l.js_copy(j, 1);\n496\t    l.js_eval(j);\n497\t    out_push(\n498\t        format!(\n499\t            \"[eval before={before} after={} v={}]\\n\",\n500\t            l.js_gettop(j),\n501\t            from_c(l.js_tryrepr(j, -1, ERRSTR))\n502\t        )\n503\t        .as_bytes(),\n504\t    );\n505\t}\n506\t\n507\t/// Report hook that writes straight to fd 2 (used by the forked panic child).\n508\tunsafe extern \"C\" fn stderr_report(_j: JS, msg: *const c_char) {\n509\t    let s = format!(\"REPORT:{}\\n\", from_c(msg));\n510\t    write(2, s.as_ptr() as *const c_void, s.len());\n511\t}\n512\t\n513\tunsafe extern \"C\" fn custom_panic(_j: JS) {\n514\t    let s = \"CUSTOMPANIC\\n\";\n515\t    write(2, s.as_ptr() as *const c_void, s.len());\n516\t}\n517\t\n518\t/* --------------------------------------------------------- stderr capture */\n519\t\n520\tstatic STDERR_LOCK: std::sync::Mutex<()> = std::sync::Mutex::new(());\n521\t\n522\t/// Redirect fd 2 into a pipe for the duration of `f` and return what was\n523\t/// written.  Used to observe `js_defaultreport`, which writes to stderr.\n524\tfn capture_stderr(f: impl FnOnce()) -> String {\n525\t    let _g = STDERR_LOCK.lock().unwrap_or_else(|e| e.into_inner());\n526\t    unsafe {\n527\t        let mut fds = [0 as c_int; 2];\n528\t        if pipe(fds.as_mut_ptr()) != 0 {\n529\t            f();\n530\t            return \"<pipe failed>\".into();\n531\t        }\n532\t        let saved = dup(2);\n533\t        dup2(fds[1], 2);\n534\t        close(fds[1]);\n535\t        f();\n536\t        dup2(saved, 2);\n537\t        close(saved);\n538\t        let mut buf = vec![0u8; 1 << 16];\n539\t        let n = read(fds[0], buf.as_mut_ptr() as *mut c_void, buf.len());\n540\t        close(fds[0]);\n541\t        let n = if n < 0 { 0 } else { n as usize };\n542\t        String::from_utf8_lossy(&buf[..n]).into_owned()\n543\t    }\n544\t}\n545\t\n546\t/* ====================================================================== */\n547\t/*  Rows 1, 2, 4: js_newstate flags                                        */\n548\t/* ====================================================================== */\n549\t\n550\t#[test]\n551\tfn t_newstate_flags() {\n552\t    // strictness is observable through undeclared assignment, `delete` of a\n553\t    // binding, duplicate parameters, octal literals and `with`.\n554\t    let probes = [\n555\t        \"zz = 1; print(zz)\",\n556\t        \"var a = 1; print(delete a)\",\n557\t        \"print((function(){ return typeof this })())\",\n558\t        \"print((function(a,a){ return a })(1,2))\",\n559\t        \"print(function(){ return 010 }())\",\n560\t        \"var o={p:1}; with(o) print(p)\",\n561\t        \"print(typeof arguments)\",\n562\t        \"function f(){ return this } print(typeof f())\",\n563\t        \"print((function(){ 'use strict'; return typeof this })())\",\n564\t        \"eval('yy = 3'); print(typeof yy)\",\n565\t    ];\n566\t    // flags 0 / JS_STRICT / extra bits above JS_STRICT (row 4)\n567\t    for flags in [0, JS_STRICT, 0x6, 0x7, -1, 0x1000_0000] {\n568\t        for src in probes {\n569\t            diff_dostring(flags, src);\n570\t            diff_eval(flags, src);\n571\t        }\n572\t    }\n573\t}\n574\t\n575\t/* ====================================================================== */\n576\t/*  Row 3: custom js_Alloc with a non-NULL actx                            */\n577\t/* ====================================================================== */\n578\t\n579\t#[test]\n580\tfn t_newstate_custom_alloc() {\n581\t    let p = libs();\n582\t    let mut rng = Rng::new(0xA110_C8);\n583\t    let scripts = [\n584\t        \"print(1+1)\",\n585\t        \"var a=[]; for (var i=0;i<200;++i) a.push('s'+i); print(a.length, a[199])\",\n586\t        \"print(JSON.stringify({a:[1,2,3],b:'x'}))\",\n587\t        \"print('abcdefghijklmnopqrstuvwxyz'.toUpperCase())\",\n588\t        \"print(/(a+)(b+)/.exec('xaaabbbz'))\",\n589\t        \"print(new Date(0).getTime())\",\n590\t    ];\n591\t    for src in scripts {\n592\t        let mut recs = vec![];\n593\t        for l in [&p.c, &p.rs] {\n594\t            out_clear();\n595\t            let mut cx = Actx::new(0);\n596\t            let ap = &mut *cx as *mut Actx as *mut c_void;\n597\t            unsafe {\n598\t                set_cur(l);\n599\t                let j = l.js_newstate(Some(tracking_alloc), ap, 0);\n600\t                assert!(!j.is_null(), \"{}: newstate w/ custom alloc\", l.name);\n601\t                l.js_setreport(j, Some(report_cb));\n602\t                l.js_newcfunction(j, Some(print_cb), PRINT, 1);\n603\t                l.js_setglobal(j, PRINT);\n604\t                let cs = cstr(src);\n605\t                let rc = l.js_dostring(j, cs.as_ptr());\n606\t                let top = l.js_gettop(j);\n607\t                l.js_freestate(j);\n608\t                recs.push(format!(\n609\t                    \"rc={rc} top={top} live={} bad={} out={}\",\n610\t                    cx.live,\n611\t                    cx.bad_actx,\n612\t                    out_take()\n613\t                ));\n614\t            }\n615\t            // the custom allocator must have been used for everything, and\n616\t            // js_freestate must have handed every block back\n617\t            assert_eq!(cx.live, 0, \"{}: {} live blocks leaked\", l.name, cx.live);\n618\t            assert_eq!(cx.bad_actx, 0, \"{}: actx was corrupted\", l.name);\n619\t            assert!(cx.nalloc > 100, \"{}: only {} allocs\", l.name, cx.nalloc);\n620\t        }\n621\t        assert_eq!(recs[0], recs[1], \"custom-alloc divergence for {src}\");\n622\t    }\n623\t\n624\t    // random actx pointers must be handed back verbatim; actx is independent of\n625\t    // js_setcontext's uctx (row 5)\n626\t    for _ in 0..8 {\n627\t        let tagbits = rng.next_u64();\n628\t        let mut cx = Actx::new(0);\n629\t        cx.live = 0;\n630\t        let ap = &mut *cx as *mut Actx as *mut c_void;\n631\t        for l in [&p.c, &p.rs] {\n632\t            unsafe {\n633\t                set_cur(l);\n634\t                let j = l.js_newstate(Some(tracking_alloc), ap, 0);\n635\t                assert!(!j.is_null());\n636\t                let u = tagbits as usize as *mut c_void;\n637\t                l.js_setcontext(j, u);\n638\t                assert_eq!(l.js_getcontext(j), u, \"{}: uctx round-trip\", l.name);\n639\t                l.js_freestate(j);\n640\t            }\n641\t        }\n642\t        assert_eq!(cx.live, 0);\n643\t        assert_eq!(cx.bad_actx, 0);\n644\t    }\n645\t}\n646\t\n647\t/* ====================================================================== */\n648\t/*  Row 3 / \"js_newstate returns NULL\": allocator failing on the Nth call  */\n649\t/* ====================================================================== */\n650\t\n651\t#[test]\n652\tfn t_newstate_alloc_fails() {\n653\t    let p = libs();\n654\t\n655\t    // 1st allocating call is the js_State itself, 2nd is the value stack.\n656\t    // Both must be handled without touching the allocator again except to free.\n657\t    for n in [1u64, 2] {\n658\t        for l in [&p.c, &p.rs] {\n659\t            let mut cx = Actx::new(n);\n660\t            let ap = &mut *cx as *mut Actx as *mut c_void;\n661\t            unsafe {\n662\t                let j = l.js_newstate(Some(tracking_alloc), ap, 0);\n663\t                assert!(j.is_null(), \"{}: newstate must fail at alloc #{n}\", l.name);\n664\t            }\n665\t            assert_eq!(cx.failed, 1, \"{}: fail_at={n} not hit\", l.name);\n666\t            assert_eq!(cx.live, 0, \"{}: fail_at={n} leaked\", l.name);\n667\t        }\n668\t    }\n669\t\n670\t    // Every later failure happens inside jsB_init, where js_malloc raises\n671\t    // \"out of memory\" and longjmps back to js_newstate's own js_try, which\n672\t    // js_freestate()s and returns NULL.  Sweep a wide range of N.\n673\t    let mut ncalls = vec![];\n674\t    for l in [&p.c, &p.rs] {\n675\t        let mut cx = Actx::new(0);\n676\t        let ap = &mut *cx as *mut Actx as *mut c_void;\n677\t        unsafe {\n678\t            let j = l.js_newstate(Some(tracking_alloc), ap, 0);\n679\t            assert!(!j.is_null());\n680\t            l.js_freestate(j);\n681\t        }\n682\t        assert_eq!(cx.live, 0);\n683\t        ncalls.push(cx.ncalls);\n684\t    }\n685\t    assert_eq!(\n686\t        ncalls[0], ncalls[1],\n687\t        \"js_newstate performs a different number of allocations in C ({}) and Rust ({})\",\n688\t        ncalls[0], ncalls[1]\n689\t    );\n690\t    let total = ncalls[0];\n691\t    assert!(total > 300, \"expected many allocations, got {total}\");\n692\t\n693\t    let mut rng = Rng::new(0xDEAD_10);\n694\t    let mut probes: Vec<u64> = (3..40).collect();\n695\t    probes.extend([total / 4, total / 2, total - 2, total - 1, total]);\n696\t    for _ in 0..40 {\n697\t        probes.push(3 + (rng.next_u64() % (total - 3)));\n698\t    }\n699\t    probes.sort_unstable();\n700\t    probes.dedup();\n701\t    // NOTE: not every failing allocation aborts construction. jsbuiltin.c:205\n702\t    // assigns `js_regcompx(...)` to RegExp_prototype->u.r.prog without checking\n703\t    // for NULL, and regexp.c:903 turns an allocation failure into a plain NULL\n704\t    // return rather than a throw, so a failure inside the \"(?:)\" compile leaves\n705\t    // a usable state with a NULL prog.  What must match is the *decision*, so\n706\t    // compare C against Rust for every N instead of demanding NULL.\n707\t    let mut nnull = 0;\n708\t    for n in &probes {\n709\t        let n = *n;\n710\t        let mut res = vec![];\n711\t        for l in [&p.c, &p.rs] {\n712\t            let mut cx = Actx::new(n);\n713\t            let ap = &mut *cx as *mut Actx as *mut c_void;\n714\t            let isnull = unsafe {\n715\t                let j = l.js_newstate(Some(tracking_alloc), ap, 0);\n716\t                let r = j.is_null();\n717\t                if !r {\n718\t                    l.js_freestate(j);\n719\t                }\n720\t                r\n721\t            };\n722\t            res.push(format!(\n723\t                \"null={isnull} failed={} live={}\",\n724\t                cx.failed, cx.live\n725\t            ));\n726\t        }\n727\t        assert_eq!(res[0], res[1], \"alloc failure at call #{n} diverges\");\n728\t        assert!(\n729\t            res[0].ends_with(\"live=0\"),\n730\t            \"alloc failure at call #{n} leaked: {}\",\n731\t            res[0]\n732\t        );\n733\t        if res[0].starts_with(\"null=true\") {\n734\t            nnull += 1;\n735\t        }\n736\t    }\n737\t    assert!(\n738\t        nnull > probes.len() / 2,\n739\t        \"only {nnull}/{} failing allocations produced a NULL state\",\n740\t        probes.len()\n741\t    );\n742\t\n743\t    // Beyond the total number of allocations the state must come up fine.\n744\t    for n in [total + 1, total + 5, u32::MAX as u64] {\n745\t        for l in [&p.c, &p.rs] {\n746\t            let mut cx = Actx::new(n);\n747\t            let ap = &mut *cx as *mut Actx as *mut c_void;\n748\t            unsafe {\n749\t                let j = l.js_newstate(Some(tracking_alloc), ap, 0);\n750\t                assert!(!j.is_null(), \"{}: fail_at={n} should not fail\", l.name);\n751\t                l.js_freestate(j);\n752\t            }\n753\t            assert_eq!(cx.live, 0);\n754\t        }\n755\t    }\n756\t}\n757\t\n758\t/* ====================================================================== */\n759\t/*  Row 5: js_setcontext / js_getcontext                                   */\n760\t/* ====================================================================== */\n761\t\n762\t#[test]\n763\tfn t_setcontext_getcontext() {\n764\t    let p = libs();\n765\t    let mut rng = Rng::new(0xC0FFEE);\n766\t    let mut vals: Vec<usize> = vec![0, 1, usize::MAX, 8, 0x1000];\n767\t    for _ in 0..64 {\n768\t        vals.push(rng.next_u64() as usize);\n769\t    }\n770\t    for l in [&p.c, &p.rs] {\n771\t        unsafe {\n772\t            set_cur(l);\n773\t            let j = new_state(l, 0);\n774\t            // fresh state: uctx is NULL (memset)\n775\t            assert!(l.js_getcontext(j).is_null(), \"{}: initial uctx\", l.name);\n776\t            for v in &vals {\n777\t                let ptr = *v as *mut c_void;\n778\t                l.js_setcontext(j, ptr);\n779\t                assert_eq!(l.js_getcontext(j), ptr, \"{}: uctx {v:#x}\", l.name);\n780\t            }\n781\t            // setting it back to NULL works too\n782\t            l.js_setcontext(j, null_mut());\n783\t            assert!(l.js_getcontext(j).is_null());\n784\t            l.js_freestate(j);\n785\t        }\n786\t    }\n787\t}\n788\t\n789\t/* ====================================================================== */\n790\t/*  Rows 6, 7: js_setreport with default / custom / NULL                   */\n791\t/* ====================================================================== */\n792\t\n793\t#[test]\n794\tfn t_setreport() {\n795\t    let p = libs();\n796\t    let mut rng = Rng::new(0x5EE7);\n797\t\n798\t    // (a) the js_newstate default hook writes \"<message>\\n\" to stderr\n799\t    let mut msgs: Vec<String> = vec![\n800\t        String::new(),\n801\t        \"x\".into(),\n802\t        \"hello report\".into(),\n803\t        \"line1\\nline2\".into(),\n804\t    ];\n805\t    for _ in 0..20 {\n806\t        msgs.push(rng.ascii_string(40));\n807\t    }\n808\t    for m in &msgs {\n809\t        let mut got = vec![];\n810\t        for l in [&p.c, &p.rs] {\n811\t            let cs = cstr(m);\n812\t            let text = capture_stderr(|| unsafe {\n813\t                set_cur(l);\n814\t                let j = l.js_newstate(None, null_mut(), 0);\n815\t                assert!(!j.is_null());\n816\t                l.js_report(j, cs.as_ptr());\n817\t                l.js_freestate(j);\n818\t            });\n819\t            got.push(text);\n820\t        }\n821\t        assert_eq!(got[0], got[1], \"default report divergence for {m:?}\");\n822\t        assert_eq!(got[0], format!(\"{}\\n\", m.replace('\\0', \"\")));\n823\t    }\n824\t\n825\t    // (b) custom hook receives the message verbatim\n826\t    for m in &msgs {\n827\t        diff2(&format!(\"custom report {m:?}\"), |l| unsafe {\n828\t            let j = new_state(l, 0);\n829\t            let cs = cstr(m);\n830\t            l.js_report(j, cs.as_ptr());\n831\t            l.js_report(j, cs.as_ptr());\n832\t            let s = snap(l, j);\n833\t            l.js_freestate(j);\n834\t            s\n835\t        });\n836\t    }\n837\t\n838\t    // (c) js_setreport(J, NULL): every js_report becomes a silent no-op, and\n839\t    //     js_gc(J, 1) formats its summary and drops it (row 7 / row 191)\n840\t    for m in &msgs {\n841\t        let mut got = vec![];\n842\t        for l in [&p.c, &p.rs] {\n843\t            let cs = cstr(m);\n844\t            out_clear();\n845\t            let text = capture_stderr(|| unsafe {\n846\t                set_cur(l);\n847\t                let j = new_state(l, 0);\n848\t                l.js_setreport(j, None);\n849\t                l.js_report(j, cs.as_ptr());\n850\t                l.js_gc(j, 1);\n851\t                l.js_gc(j, 0);\n852\t                l.js_report(j, cs.as_ptr());\n853\t                let d = cstr(\"var a = {}; a.b = [1,2,3]; throw new Error('e')\");\n854\t                let rc = l.js_dostring(j, d.as_ptr());\n855\t                out_push(format!(\"dostring rc={rc}\\n\").as_bytes());\n856\t                l.js_freestate(j);\n857\t            });\n858\t            got.push(format!(\"stderr={text:?} buf={:?}\", out_take()));\n859\t        }\n860\t        assert_eq!(got[0], got[1], \"NULL report divergence for {m:?}\");\n861\t        assert!(\n862\t            got[0].starts_with(\"stderr=\\\"\\\"\"),\n863\t            \"NULL report hook still wrote to stderr: {}\",\n864\t            got[0]\n865\t        );\n866\t    }\n867\t\n868\t    // (d) report never called at all\n869\t    diff2(\"report never called\", |l| unsafe {\n870\t        let j = new_state(l, 0);\n871\t        let s = cstr(\"print('ok'); 1+1\");\n872\t        let rc = l.js_dostring(j, s.as_ptr());\n873\t        let r = format!(\"rc={rc} {}\", snap(l, j));\n874\t        l.js_freestate(j);\n875\t        r\n876\t    });\n877\t}\n878\t\n879\t/* ====================================================================== */\n880\t/*  Rows 8, 9: js_atpanic                                                  */\n881\t/* ====================================================================== */\n882\t\n883\t#[test]\n884\tfn t_atpanic_roundtrip() {\n885\t    let p = libs();\n886\t    for l in [&p.c, &p.rs] {\n887\t        unsafe {\n888\t            set_cur(l);\n889\t            let j = new_state(l, 0);\n890\t            // the default handler installed by js_newstate must be non-NULL\n891\t            let default = l.js_atpanic(j, Some(custom_panic));\n892\t            assert!(\n893\t                default.is_some(),\n894\t                \"{}: js_atpanic returned NULL for the default handler\",\n895\t                l.name\n896\t            );\n897\t            // installing again returns exactly what we put in\n898\t            let prev = l.js_atpanic(j, None);\n899\t            assert_eq!(\n900\t                prev.map(|f| f as *const () as usize),\n901\t                Some(custom_panic as *const () as usize),\n902\t                \"{}: js_atpanic did not return the previous handler\",\n903\t                l.name\n904\t            );\n905\t            // and NULL round-trips\n906\t            let prev2 = l.js_atpanic(j, default);\n907\t            assert!(prev2.is_none(), \"{}: expected NULL back\", l.name);\n908\t            let prev3 = l.js_atpanic(j, Some(custom_panic));\n909\t            assert_eq!(\n910\t                prev3.map(|f| f as *const () as usize),\n911\t                default.map(|f| f as *const () as usize),\n912\t                \"{}: default handler not restored\",\n913\t                l.name\n914\t            );\n915\t            l.js_atpanic(j, default);\n916\t            l.js_freestate(j);\n917\t        }\n918\t    }\n919\t}\n920\t\n921\t/// Row 8/9: the panic hook only runs for a `js_throw` with `trytop == 0`, which\n922\t/// ends in `abort()`.  Drive it in a forked copy of this binary.\n923\t#[test]\n924\tfn t_panic_child() {\n925\t    let Ok(spec) = std::env::var(\"MUJS_PANIC_CHILD\") else {\n926\t        return;\n927\t    };\n928\t    let (which, mode) = spec.split_once(':').expect(\"spec\");\n929\t    let p = libs();\n930\t    let l = if which == \"c\" { &p.c } else { &p.rs };\n931\t    unsafe {\n932\t        set_cur(l);\n933\t        let j = l.js_newstate(None, null_mut(), 0);\n934\t        assert!(!j.is_null());\n935\t        l.js_setreport(j, Some(stderr_report));\n936\t        if mode == \"custom\" {\n937\t            let old = l.js_atpanic(j, Some(custom_panic));\n938\t            assert!(old.is_some());\n939\t        }\n940\t        l.js_pushstring(j, cn!(\"thrown-value\"));\n941\t        l.js_throw(j); // trytop == 0 -> panic hook -> abort()\n942\t    }\n943\t    unreachable!(\"js_throw at trytop==0 must not return\");\n944\t}\n945\t\n946\t#[test]\n947\tfn t_panic_default_vs_custom() {\n948\t    if std::env::var_os(\"MUJS_PANIC_CHILD\").is_some() {\n949\t        return;\n950\t    }\n951\t    use std::os::unix::process::{CommandExt, ExitStatusExt};\n952\t    let exe = std::env::current_exe().expect(\"current_exe\");\n953\t    for mode in [\"default\", \"custom\"] {\n954\t        let mut res = vec![];\n955\t        for which in [\"c\", \"rs\"] {\n956\t            let mut cmd = std::process::Command::new(&exe);\n957\t            cmd.args([\"t_panic_child\", \"--exact\", \"--nocapture\", \"--test-threads=1\"])\n958\t                .env(\"MUJS_PANIC_CHILD\", format!(\"{which}:{mode}\"))\n959\t                .env(\"RUST_BACKTRACE\", \"0\");\n960\t            unsafe {\n961\t                cmd.pre_exec(|| {\n962\t                    // no multi-megabyte core dumps for the deliberate abort()\n963\t                    #[repr(C)]\n964\t                    struct RLimit {\n965\t                        cur: u64,\n966\t                        max: u64,\n967\t                    }\n968\t                    extern \"C\" {\n969\t                        fn setrlimit(res: c_int, l: *const RLimit) -> c_int;\n970\t                    }\n971\t                    let rl = RLimit { cur: 0, max: 0 };\n972\t                    setrlimit(4 /* RLIMIT_CORE */, &rl);\n973\t                    Ok(())\n974\t                });\n975\t            }\n976\t            let out = cmd.output().expect(\"spawn child\");\n977\t            let err = String::from_utf8_lossy(&out.stderr).into_owned();\n978\t            let marks: Vec<&str> = err\n979\t                .lines()\n980\t                .filter(|l| l.starts_with(\"REPORT:\") || l.starts_with(\"CUSTOMPANIC\"))\n981\t                .collect();\n982\t            res.push(format!(\"signal={:?} marks={:?}\", out.status.signal(), marks));\n983\t        }\n984\t        assert_eq!(res[0], res[1], \"panic ({mode}) divergence\");\n985\t        assert!(\n986\t            res[0].contains(\"signal=Some(6)\"),\n987\t            \"expected SIGABRT for panic ({mode}): {}\",\n988\t            res[0]\n989\t        );\n990\t        if mode == \"default\" {\n991\t            assert!(\n992\t                res[0].contains(\"REPORT:uncaught exception\"),\n993\t                \"default panic must report: {}\",\n994\t                res[0]\n995\t            );\n996\t        } else {\n997\t            assert!(\n998\t                res[0].contains(\"CUSTOMPANIC\"),\n999\t                \"custom panic must run: {}\",\n1000\t                res[0]\n1001\t            );\n1002\t        }\n1003\t    }\n1004\t}\n1005\t\n1006\t/* ====================================================================== */\n1007\t/*  Rows 10-13: js_setlimit                                                */\n1008\t/* ====================================================================== */\n1009\t\n1010\tfn limited(l: &Lib, flags: c_int, runlimit: c_int, memlimit: c_int, src: &str) -> String {\n1011\t    unsafe {\n1012\t        let j = new_state(l, flags);\n1013\t        l.js_setlimit(j, runlimit, memlimit);\n1014\t        let cs = cstr(src);\n1015\t        let rc = l.js_dostring(j, cs.as_ptr());\n1016\t        let top = l.js_gettop(j);\n1017\t        l.js_freestate(j);\n1018\t        format!(\"rc={rc} top={top}\")\n1019\t    }\n1020\t}\n1021\t\n1022\t#[test]\n1023\tfn t_setlimit_offswitch() {\n1024\t    // Row 10: both checks are `> 0`, so 0 and every negative value is unlimited\n1025\t    let mut rng = Rng::new(0x1111_2222);\n1026\t    let mut pairs: Vec<(c_int, c_int)> = vec![\n1027\t        (0, 0),\n1028\t        (0, -1),\n1029\t        (-1, 0),\n1030\t        (-1, -1),\n1031\t        (i32::MIN, i32::MIN),\n1032\t        (i32::MAX, i32::MAX),\n1033\t        (0, i32::MAX),\n1034\t        (i32::MAX, 0),\n1035\t    ];\n1036\t    for _ in 0..24 {\n1037\t        pairs.push((\n1038\t            -(rng.below(1 << 20) as c_int),\n1039\t            -(rng.below(1 << 20) as c_int),\n1040\t        ));\n1041\t    }\n1042\t    let srcs = [\n1043\t        \"var s=0; for (var i=0;i<500;++i) s+=i; print(s)\",\n1044\t        \"print([1,2,3].concat([4,5]).join(','))\",\n1045\t        \"print('x'.repeat ? 'has' : 'none')\",\n1046\t        \"var o={}; for (var i=0;i<100;++i) o['k'+i]=i; print(Object.keys(o).length)\",\n1047\t    ];\n1048\t    for (r, m) in pairs {\n1049\t        for src in srcs {\n1050\t            diff2(&format!(\"setlimit({r},{m}) {src}\"), |l| {\n1051\t                limited(l, 0, r, m, src)\n1052\t            });\n1053\t        }\n1054\t    }\n1055\t}\n1056\t\n1057\t#[test]\n1058\tfn t_setlimit_runlimit() {\n1059\t    // Row 11: one decrement per VM instruction, thrown as \"script ran too long\"\n1060\t    let mut rng = Rng::new(0x3333_4444);\n1061\t    let mut lims: Vec<c_int> = (1..=140).collect();\n1062\t    lims.extend([200, 400, 1000, 5000, 20000, 100000]);\n1063\t    for _ in 0..120 {\n1064\t        lims.push(1 + rng.below(6000) as c_int);\n1065\t    }\n1066\t    let srcs = [\n1067\t        \"1+1\",\n1068\t        \"print('hi')\",\n1069\t        \"var s=0; for (var i=0;i<200;++i) s+=i; print(s)\",\n1070\t        \"function f(n){ return n<=1?1:n*f(n-1) } print(f(10))\",\n1071\t        \"try { var s=0; for(;;) ++s } catch (e) { print('caught', e) }\",\n1072\t    ];\n1073\t    for lim in &lims {\n1074\t        for src in srcs {\n1075\t            diff2(&format!(\"runlimit({lim}) {src}\"), |l| {\n1076\t                limited(l, 0, *lim, 0, src)\n1077\t            });\n1078\t        }\n1079\t    }\n1080\t\n1081\t    // the message must actually be \"script ran too long\", and pure C-API\n1082\t    // sequences must never consume any budget\n1083\t    diff2(\"runlimit=1 message\", |l| unsafe {\n1084\t        let j = new_state(l, 0);\n1085\t        l.js_setlimit(j, 1, 0);\n1086\t        // no VM instruction runs here, so nothing is charged\n1087\t        for i in 0..50 {\n1088\t            l.js_pushnumber(j, i as f64);\n1089\t            l.js_newobject(j);\n1090\t            l.js_newarray(j);\n1091\t            l.js_pushstring(j, cn!(\"a fairly long string value here\"));\n1092\t            l.js_pop(j, 4);\n1093\t        }\n1094\t        let mid = l.js_gettop(j);\n1095\t        let cs = cstr(\"1+1\");\n1096\t        let rc = l.js_dostring(j, cs.as_ptr());\n1097\t        let r = format!(\"mid={mid} rc={rc} top={}\", l.js_gettop(j));\n1098\t        l.js_freestate(j);\n1099\t        r\n1100\t    });\n1101\t    let (rc, out) = {\n1102\t        let p = libs();\n1103\t        let a = unsafe {\n1104\t            out_clear();\n1105\t            let j = new_state(&p.c, 0);\n1106\t            p.c.js_setlimit(j, 1, 0);\n1107\t            let cs = cstr(\"1+1\");\n1108\t            let rc = p.c.js_dostring(j, cs.as_ptr());\n1109\t            p.c.js_freestate(j);\n1110\t            (rc, out_take())\n1111\t        };\n1112\t        a\n1113\t    };\n1114\t    assert_eq!(rc, 1);\n1115\t    assert_eq!(out, \"[report] script ran too long\\n\");\n1116\t}\n1117\t\n1118\t#[test]\n1119\tfn t_setlimit_memlimit() {\n1120\t    // Row 12: every js_malloc/js_realloc subtracts `size`; js_free credits\n1121\t    // nothing back, so the budget only shrinks.\n1122\t    let mut rng = Rng::new(0x5555_6666);\n1123\t    let mut lims: Vec<c_int> = (1..=96).collect();\n1124\t    lims.extend([128, 192, 256, 384, 512, 1024, 2048, 4096, 1 << 14, 1 << 16, 1 << 18]);\n1125\t    for _ in 0..140 {\n1126\t        lims.push(1 + rng.below(1 << 17) as c_int);\n1127\t    }\n1128\t    let srcs = [\n1129\t        \"1+1\",\n1130\t        \"print('hello world')\",\n1131\t        \"var a=[]; for (var i=0;i<300;++i) a.push('str'+i); print(a.length)\",\n1132\t        \"print(JSON.stringify({a:1,b:[1,2,3]}))\",\n1133\t        \"var s=''; for (var i=0;i<200;++i) s+='abcdefgh'; print(s.length)\",\n1134\t        \"print(/(a+)(b+)c?/.exec('xxaaabbbz'))\",\n1135\t        \"print(new Date(86400000).toUTCString())\",\n1136\t        \"print(JSON.parse('{\\\"k\\\":[1,2,{\\\"m\\\":\\\"v\\\"}]}').k.length)\",\n1137\t        \"print(encodeURIComponent('a b/c?d=e&f'))\",\n1138\t        \"print([5,3,1,4,2].sort().join('-'))\",\n1139\t        \"function f(n){ return n<2?n:f(n-1)+f(n-2) } print(f(12))\",\n1140\t        \"print('abcdef'.replace(/b(c)d/, '[$1]'))\",\n1141\t        \"try { throw new TypeError('t') } catch (e) { print(e.name, e.message) }\",\n1142\t    ];\n1143\t    for lim in &lims {\n1144\t        for src in srcs {\n1145\t            diff2(&format!(\"memlimit({lim}) {src}\"), |l| {\n1146\t                limited(l, 0, 0, *lim, src)\n1147\t            });\n1148\t        }\n1149\t    }\n1150\t\n1151\t    // small memlimit + the C API: js_pushstring of a >15 byte string allocates\n1152\t    for lim in [1, 2, 8, 17, 32] {\n1153\t        diff2(&format!(\"memlimit({lim}) api\"), |l| unsafe {\n1154\t            let j = new_state(l, 0);\n1155\t            l.js_setlimit(j, 0, lim);\n1156\t            // js_dostring is protected, so the out-of-memory throw is caught\n1157\t            let cs = cstr(\"var q = 'aaaaaaaaaaaaaaaaaaaaaaaaaaaa'; print(q.length)\");\n1158\t            let rc = l.js_dostring(j, cs.as_ptr());\n1159\t            let r = format!(\"rc={rc} top={}\", l.js_gettop(j));\n1160\t            l.js_freestate(j);\n1161\t            r\n1162\t        });\n1163\t    }\n1164\t\n1165\t    let mut got = None;\n1166\t    for lim in [1, 2, 3] {\n1167\t        let p = libs();\n1168\t        out_clear();\n1169\t        let a = unsafe {\n1170\t            let j = new_state(&p.c, 0);\n1171\t            p.c.js_setlimit(j, 0, lim);\n1172\t            let cs = cstr(\"1+1\");\n1173\t            let rc = p.c.js_dostring(j, cs.as_ptr());\n1174\t            p.c.js_freestate(j);\n1175\t            (rc, out_take())\n1176\t        };\n1177\t        if a.0 == 1 {\n1178\t            got = Some(a);\n1179\t            break;\n1180\t        }\n1181\t    }\n1182\t    let (rc, out) = got.expect(\"memlimit never triggered\");\n1183\t    assert_eq!(rc, 1);\n1184\t    assert_eq!(out, \"[report] out of memory\\n\");\n1185\t}\n1186\t\n1187\t/// After a memlimit-driven \"out of memory\" throw the budget stays exhausted, so\n1188\t/// every later allocation throws too. The state must still be collectable and\n1189\t/// freeable, and both libraries must agree on the exact gc summary.\n1190\t#[test]\n1191\tfn t_setlimit_memlimit_then_gc() {\n1192\t    let mut rng = Rng::new(0xAA55_AA55);\n1193\t    let mut lims: Vec<c_int> = (1..=48).collect();\n1194\t    lims.extend([64, 128, 512, 4096, 1 << 15]);\n1195\t    for _ in 0..60 {\n1196\t        lims.push(1 + rng.below(1 << 16) as c_int);\n1197\t    }\n1198\t    for lim in lims {\n1199\t        diff2(&format!(\"memlimit then gc {lim}\"), move |l| unsafe {\n1200\t            let j = new_state(l, 0);\n1201\t            let pre = cstr(\"var live = {a:1,b:'a string longer than fifteen bytes'}; 0\");\n1202\t            let rc0 = l.js_dostring(j, pre.as_ptr());\n1203\t            l.js_setlimit(j, 0, lim);\n1204\t            let cs = cstr(\"var big=[]; for (var i=0;i<200;++i) big.push('item'+i); big.length\");\n1205\t            let rc = l.js_dostring(j, cs.as_ptr());\n1206\t            // js_free credits nothing back, so the budget is still gone\n1207\t            let rc2 = l.js_dostring(j, cs.as_ptr());\n1208\t            let mut r = format!(\"rc0={rc0} rc={rc} rc2={rc2} top={}\", l.js_gettop(j));\n1209\t            // js_gc only frees, so it can always run\n1210\t            l.js_gc(j, 1);\n1211\t            l.js_gc(j, 1);\n1212\t            let rc3 = l.js_dostring(j, cs.as_ptr());\n1213\t            r.push_str(&format!(\" rc3={rc3} \"));\n1214\t            // lifting the limit again makes the state usable\n1215\t            l.js_setlimit(j, 0, 0);\n1216\t            let rc4 = l.js_dostring(j, cs.as_ptr());\n1217\t            r.push_str(&format!(\"rc4={rc4} top={}\", l.js_gettop(j)));\n1218\t            l.js_gc(j, 1);\n1219\t            l.js_freestate(j);\n1220\t            r\n1221\t        });\n1222\t    }\n1223\t}\n1224\t\n1225\t#[test]\n1226\tfn t_setlimit_both() {\n1227\t    // Row 13: two independent counters\n1228\t    let mut rng = Rng::new(0x7777_8888);\n1229\t    let mut pairs: Vec<(c_int, c_int)> = vec![\n1230\t        (1, 1),\n1231\t        (1, 1 << 20),\n1232\t        (1 << 20, 1),\n1233\t        (10, 100),\n1234\t        (100, 10),\n1235\t        (5000, 1 << 16),\n1236\t        (1 << 16, 5000),\n1237\t    ];\n1238\t    for _ in 0..48 {\n1239\t        pairs.push((\n1240\t            1 + rng.below(3000) as c_int,\n1241\t            1 + rng.below(1 << 16) as c_int,\n1242\t        ));\n1243\t    }\n1244\t    let srcs = [\n1245\t        \"var s=0; for (var i=0;i<100;++i) s+=('x'+i).length; print(s)\",\n1246\t        \"print([1,2,3,4,5].map ? 'map' : 'nomap')\",\n1247\t        \"var o={}; for (var i=0;i<50;++i) o['key'+i]={v:i}; print(Object.keys(o).length)\",\n1248\t    ];\n1249\t    for (r, m) in pairs {\n1250\t        for src in srcs {\n1251\t            diff2(&format!(\"setlimit({r},{m}) {src}\"), |l| {\n1252\t                limited(l, 0, r, m, src)\n1253\t            });\n1254\t        }\n1255\t    }\n1256\t}\n1257\t\n1258\t/* ====================================================================== */\n1259\t/*  Rows 14-22: loadstring / loadeval / ploadstring / dostring / eval       */\n1260\t/* ====================================================================== */\n1261\t\n1262\tconst LOAD_SRCS: &[&str] = &[\n1263\t    \"1+1\",\n1264\t    \"var x = 1; x\",\n1265\t    \"'use strict'; var x = 1; x\",\n1266\t    \"\\\"use strict\\\"\\nzz = 1; zz\",\n1267\t    \"'use strict'; function f(a,a){return a} f(1,2)\",\n1268\t    \"function g(){ return typeof this } g()\",\n1269\t    \"yy = 5; yy\",\n1270\t    \"var a = 1; delete a\",\n1271\t    \"010\",\n1272\t    \"'use strict'; 010\",\n1273\t    \"print('side effect'); 7\",\n1274\t    \"syntax ((( error\",\n1275\t    \"\",\n1276\t    \"   \",\n1277\t    \"// only a comment\",\n1278\t    \"throw new Error('boom')\",\n1279\t    \"eval('var e1 = 1'); typeof e1\",\n1280\t    \"'use strict'; eval('var e2 = 1'); typeof e2\",\n1281\t    \"function h(){ eval('var e3 = 1'); return typeof e3 } h() + ':' + typeof e3\",\n1282\t    \"function h(){ 'use strict'; eval('var e4 = 1'); return typeof e4 } h() + ':' + typeof e4\",\n1283\t    \"var ev = eval; ev('1')\",\n1284\t    \"(0, eval)('1')\",\n1285\t    \"this.eval\",\n1286\t];\n1287\t\n1288\t#[test]\n1289\tfn t_loadstring_and_ploadstring() {\n1290\t    // Rows 14, 15, 16, 19, 21\n1291\t    for flags in [0, JS_STRICT] {\n1292\t        for src in LOAD_SRCS {\n1293\t            let s = src.to_string();\n1294\t            diff2(&format!(\"ploadstring flags={flags} {src:?}\"), move |l| unsafe {\n1295\t                let j = new_state(l, flags);\n1296\t                let cs = cstr(&s);\n1297\t                let load_rc = l.js_ploadstring(j, FILENAME, cs.as_ptr());\n1298\t                let mut r = format!(\"load={load_rc} {}\", snap(l, j));\n1299\t                if load_rc == 0 {\n1300\t                    // the script object is on the stack (row 19)\n1301\t                    r.push_str(&format!(\n1302\t                        \" isscript={} callable={}\",\n1303\t                        l.js_type(j, -1),\n1304\t                        l.pred(\"js_iscallable\", j, -1)\n1305\t                    ));\n1306\t                    l.js_pushundefined(j);\n1307\t                    let call_rc = l.js_pcall(j, 0);\n1308\t                    r.push_str(&format!(\" call={call_rc} {}\", snap(l, j)));\n1309\t                }\n1310\t                l.js_pop(j, 1);\n1311\t                r.push_str(&format!(\" end={}\", l.js_gettop(j)));\n1312\t                l.js_freestate(j);\n1313\t                r\n1314\t            });\n1315\t\n1316\t            // Row 21: js_dostring\n1317\t            diff_dostring(flags, src);\n1318\t        }\n1319\t    }\n1320\t}\n1321\t\n1322\t#[test]\n1323\tfn t_loadeval() {\n1324\t    // Rows 17, 18, 34: iseval=1 with J->strict 0 (scope NULL) and 1 (scope E)\n1325\t    for flags in [0, JS_STRICT] {\n1326\t        for src in LOAD_SRCS {\n1327\t            let s = src.to_string();\n1328\t            diff2(&format!(\"loadeval flags={flags} {src:?}\"), move |l| unsafe {\n1329\t                let j = new_state(l, flags);\n1330\t                let cs = cstr(&s);\n1331\t                EVAL_SRC.with(|c| c.set(cs.as_ptr()));\n1332\t                l.js_newcfunction(j, Some(cf_loadeval), cn!(\"le\"), 0);\n1333\t                l.js_pushundefined(j);\n1334\t                let rc = l.js_pcall(j, 0);\n1335\t                let mut r = format!(\"rc={rc} {}\", snap(l, j));\n1336\t                l.js_pop(j, 1);\n1337\t                // and again from inside a strict JS function, so J->strict==1\n1338\t                l.js_newcfunction(j, Some(cf_loadeval), cn!(\"le\"), 0);\n1339\t                l.js_setglobal(j, cn!(\"le\"));\n1340\t                let d = cstr(\"function w(){ 'use strict'; return le() } print(w())\");\n1341\t                let rc2 = l.js_dostring(j, d.as_ptr());\n1342\t                r.push_str(&format!(\" strictrc={rc2} top={}\", l.js_gettop(j)));\n1343\t                l.js_freestate(j);\n1344\t                EVAL_SRC.with(|c| c.set(std::ptr::null()));\n1345\t                r\n1346\t            });\n1347\t        }\n1348\t    }\n1349\t}\n1350\t\n1351\t#[test]\n1352\tfn t_js_eval() {\n1353\t    // Row 22: a string on top vs a non-string on top (early return)\n1354\t    let mut rng = Rng::new(0x9999_AAAA);\n1355\t    let mut cases: Vec<String> = LOAD_SRCS.iter().map(|s| s.to_string()).collect();\n1356\t    for _ in 0..24 {\n1357\t        cases.push(rng.ascii_string(24));\n1358\t    }\n1359\t    for flags in [0, JS_STRICT] {\n1360\t        for src in &cases {\n1361\t            let s = src.clone();\n1362\t            diff2(&format!(\"js_eval flags={flags} {s:?}\"), move |l| unsafe {\n1363\t                let j = new_state(l, flags);\n1364\t                l.js_newcfunction(j, Some(cf_eval), cn!(\"ev\"), 1);\n1365\t                l.js_pushundefined(j);\n1366\t                let cs = cstr(&s);\n1367\t                l.js_pushstring(j, cs.as_ptr());\n1368\t                let rc = l.js_pcall(j, 1);\n1369\t                let r = format!(\"str rc={rc} {}\", snap(l, j));\n1370\t                l.js_pop(j, 1);\n1371\t                l.js_freestate(j);\n1372\t                r\n1373\t            });\n1374\t        }\n1375\t        // non-string tops: js_eval returns immediately, stack untouched\n1376\t        diff2(&format!(\"js_eval nonstring flags={flags}\"), |l| unsafe {\n1377\t            let j = new_state(l, flags);\n1378\t            let mut r = String::new();\n1379\t            for k in 0..6 {\n1380\t                l.js_newcfunction(j, Some(cf_eval), cn!(\"ev\"), 1);\n1381\t                l.js_pushundefined(j);\n1382\t                match k {\n1383\t                    0 => l.js_pushundefined(j),\n1384\t                    1 => l.js_pushnull(j),\n1385\t                    2 => l.js_pushboolean(j, 1),\n1386\t                    3 => l.js_pushnumber(j, 42.5),\n1387\t                    4 => l.js_newobject(j),\n1388\t                    _ => l.js_newarray(j),\n1389\t                }\n1390\t                let rc = l.js_pcall(j, 1);\n1391\t                r.push_str(&format!(\"k={k} rc={rc} {} | \", snap(l, j)));\n1392\t                l.js_pop(j, 1);\n1393\t            }\n1394\t            l.js_freestate(j);\n1395\t            r\n1396\t        });\n1397\t    }\n1398\t}\n1399\t\n1400\t/// The `iseval` axis in detail: `eval(\"var x=1\")` picks `J->strict` and captures\n1401\t/// `J->E` (or NULL when non-strict), while a plain script picks\n1402\t/// `J->default_strict` and always captures `J->GE`.  Indirect uses of `eval` are\n1403\t/// rejected by the compiler with js_evalerror \"invalid use of 'eval'\".\n1404\t#[test]\n1405\tfn t_eval_axis() {\n1406\t    let direct = [\n1407\t        // eval declaring a var, at top level and inside a function\n1408\t        \"eval('var x = 1'); print(typeof x, x)\",\n1409\t        \"function f(){ eval('var x = 1'); return typeof x } print(f(), typeof x)\",\n1410\t        \"function f(){ 'use strict'; eval('var x = 1'); return typeof x } print(f(), typeof x)\",\n1411\t        \"'use strict'; eval('var x = 1'); print(typeof x)\",\n1412\t        // the same thing as a plain script (var goes to the global env)\n1413\t        \"var x = 1; print(typeof x, x)\",\n1414\t        \"function f(){ var x = 1; return typeof x } print(f(), typeof x)\",\n1415\t        // eval seeing and mutating the caller's scope\n1416\t        \"function f(){ var y = 2; eval('y = 3'); return y } print(f())\",\n1417\t        \"function f(){ 'use strict'; var y = 2; eval('y = 3'); return y } print(f())\",\n1418\t        // eval inheriting / not inheriting strictness\n1419\t        \"print(eval('typeof this'))\",\n1420\t        \"'use strict'; print(eval('typeof this'))\",\n1421\t        \"function f(){ return eval('zzz = 1') } try { print(f()) } catch (e) { print('E', e) }\",\n1422\t        \"function f(){ 'use strict'; return eval('zzz = 1') } try { print(f()) } catch (e) { print('E', e) }\",\n1423\t        \"print(eval('010'))\",\n1424\t        \"'use strict'; try { print(eval('010')) } catch (e) { print('E', e) }\",\n1425\t        // eval returning the value of its last expression\n1426\t        \"print(eval('1+1'), eval('\\'s\\''), eval(''), eval('var q'), typeof eval(1))\",\n1427\t        // nested eval\n1428\t        \"print(eval('eval(\\'1+2\\')'))\",\n1429\t        \"function f(){ return eval('eval(\\'typeof this\\')') } print(f())\",\n1430\t    ];\n1431\t    let indirect = [\n1432\t        \"var ev = eval; print(ev('1'))\",\n1433\t        \"(0, eval)('1')\",\n1434\t        \"print(this.eval)\",\n1435\t        \"var o = {eval: 1}; print(o.eval)\",\n1436\t        \"function eval(){} \",\n1437\t        \"'use strict'; var ev = eval;\",\n1438\t        \"try { eval = 1 } catch (e) { print('E', e) }\",\n1439\t        \"print(typeof eval)\",\n1440\t    ];\n1441\t    let mut sawevalerror = 0;\n1442\t    for flags in [0, JS_STRICT] {\n1443\t        for src in direct.iter().chain(indirect.iter()) {\n1444\t            diff_dostring(flags, src);\n1445\t            diff_eval(flags, src);\n1446\t            let t = diff2(&format!(\"eval axis flags={flags} {src:?}\"), move |l| unsafe {\n1447\t                let j = new_state(l, flags);\n1448\t                let cs = cstr(src);\n1449\t                let rc = l.js_dostring(j, cs.as_ptr());\n1450\t                let r = format!(\"rc={rc} top={}\", l.js_gettop(j));\n1451\t                l.js_freestate(j);\n1452\t                r\n1453\t            });\n1454\t            if t.contains(\"invalid use of 'eval'\") {\n1455\t                sawevalerror += 1;\n1456\t            }\n1457\t        }\n1458\t    }\n1459\t    assert!(\n1460\t        sawevalerror >= 4,\n1461\t        \"the indirect-eval compile error never fired ({sawevalerror})\"\n1462\t    );\n1463\t}\n1464\t\n1465\t/* ====================================================================== */\n1466\t/*  Rows 23-40: js_call / js_pcall / js_construct / js_pconstruct           */\n1467\t/* ====================================================================== */\n1468\t\n1469\t/// Sources whose *value* is the callee.  `None` means \"built natively\".\n1470\tconst JS_CALLEES: &[&str] = &[\n1471\t    \"(function(){ return 1 })\",                                       // 0 params\n1472\t    \"(function(a,b){ return String(a)+'/'+String(b) })\",              // lightweight, 2 params\n1473\t    \"(function(a){ return arguments.length + ':' + String(a) })\",     // arguments, non-strict\n1474\t    \"(function(a){ 'use strict'; return arguments.length+':'+String(a) })\",\n1475\t    \"(function(a){ var h = function(){ return a }; return h() })\",    // closure -> heavyweight\n1476\t    \"(function(){ throw new Error('boom') })\",                        // throwing callee\n1477\t    \"(function(a,b,c,d,e){ return [a,b,c,d,e].join(',') })\",          // arity 5\n1478\t    \"(function(){ return this === undefined ? 'undef' : typeof this })\",\n1479\t    \"(function(){ 'use strict'; return this === undefined ? 'undef' : typeof this })\",\n1480\t    \"(function(){ return {tag:'obj'} })\",                             // ctor returning object\n1481\t    \"(function(){ return 5 })\",                                       // ctor returning primitive\n1482\t    \"(function(){ this.k = 1 })\",                                     // ctor mutating this\n1483\t    \"(function(){})\",                                                 // ctor returning nothing\n1484\t    \"42\",\n1485\t    \"'not callable'\",\n1486\t    \"({})\",\n1487\t    \"undefined\",\n1488\t    \"null\",\n1489\t    \"[1,2,3]\",\n1490\t    \"Object\",\n1491\t    \"Array\",\n1492\t    \"Error\",\n1493\t    \"(function F(){ this.p = 1 })\",\n1494\t];\n1495\t\n1496\t/// Pushes callee number `k` onto the stack.  `k >= JS_CALLEES.len()` selects a\n1497\t/// natively built callee.\n1498\tunsafe fn push_callee(l: &Lib, j: JS, k: usize) -> String {\n1499\t    if k < JS_CALLEES.len() {\n1500\t        let rc = push_expr(l, j, JS_CALLEES[k]);\n1501\t        return format!(\"callee{k}=js({rc})\");\n1502\t    }\n1503\t    match k - JS_CALLEES.len() {\n1504\t        0 => {\n1505\t            l.js_newcfunction(j, Some(cf_probe), N_PROBE, 0);\n1506\t            \"callee=cf0\".into()\n1507\t        }\n1508\t        1 => {\n1509\t            l.js_newcfunction(j, Some(cf_probe), N_PROBE, 2);\n1510\t            \"callee=cf2\".into()\n1511\t        }\n1512\t        2 => {\n1513\t            l.js_newcfunction(j, Some(cf_probe), N_PROBE, 5);\n1514\t            \"callee=cf5\".into()\n1515\t        }\n1516\t        3 => {\n1517\t            l.js_newcfunction(j, Some(cf_void), N_VOIDF, 0);\n1518\t            \"callee=cfvoid\".into()\n1519\t        }\n1520\t        4 => {\n1521\t            l.js_newcfunction(j, Some(cf_three), N_THREE, 1);\n1522\t            \"callee=cfthree\".into()\n1523\t        }\n1524\t        5 => {\n1525\t            l.js_newobject(j);\n1526\t            l.js_newcconstructor(j, Some(cf_probe), Some(cc_probe), N_CTOR, 1);\n1527\t            \"callee=cctor\".into()\n1528\t        }\n1529\t        6 => {\n1530\t            // js_newcfunction: u.c.constructor == NULL (row 37)\n1531\t            l.js_newcfunction(j, Some(cf_probe), N_PROBE, 1);\n1532\t            \"callee=cfnoctor\".into()\n1533\t        }\n1534\t        7 => {\n1535\t            // a JS function whose 'prototype' is not an object (row 38)\n1536\t            let rc = push_expr(l, j, \"(function(){ var f=function(){}; f.prototype=5; return f })()\");\n1537\t            format!(\"callee=protonum({rc})\")\n1538\t        }\n1539\t        8 => {\n1540\t            // script object, scope == J->GE (row 33)\n1541\t            let cs = cstr(\"var sv = 1; 'script-ran'\");\n1542\t            let rc = l.js_ploadstring(j, FILENAME, cs.as_ptr());\n1543\t            format!(\"callee=script({rc})\")\n1544\t        }\n1545\t        9 => {\n1546\t            l.js_newcfunctionx(j, Some(cf_data), N_DATAF, 1, PAYLOAD as *mut c_void, Some(fin_cb));\n1547\t            \"callee=cfdata\".into()\n1548\t        }\n1549\t        _ => {\n1550\t            l.js_newobject(j);\n1551\t            l.js_newuserdata(j, N_TAG, PAYLOAD as *mut c_void, Some(fin_cb));\n1552\t            \"callee=userdata\".into()\n1553\t        }\n1554\t    }\n1555\t}\n1556\t\n1557\tconst NCALLEES: usize = JS_CALLEES.len() + 11;\n1558\t\n1559\t/// Runs one (entry point, callee, argc) configuration and returns a transcript.\n1560\t/// Pushes argument `kind` (a randomised mix of value tags).\n1561\tunsafe fn push_arg(l: &Lib, j: JS, kind: u32, x: f64) {\n1562\t    match kind % 8 {\n1563\t        0 => l.js_pushnumber(j, x),\n1564\t        1 => l.js_pushundefined(j),\n1565\t        2 => l.js_pushnull(j),\n1566\t        3 => l.js_pushboolean(j, (x != 0.0) as c_int),\n1567\t        4 => l.js_pushstring(j, cn!(\"short\")),\n1568\t        5 => l.js_pushstring(j, cn!(\"a string well over fifteen bytes long\")),\n1569\t        6 => l.js_newobject(j),\n1570\t        _ => l.js_newarray(j),\n1571\t    }\n1572\t}\n1573\t\n1574\tfn call_case(l: &Lib, flags: c_int, ep: u8, k: usize, n: c_int, args: &[(u32, f64)]) -> String {\n1575\t    unsafe {\n1576\t        let j = new_state(l, flags);\n1577\t        // sentinel: keeps js_pconstruct's savetop = TOP-n-2 inside the stack\n1578\t        l.js_pushnumber(j, -777.0);\n1579\t        let mut r = String::new();\n1580\t        INNER_MODE.with(|m| m.set(if ep == 2 { 1 } else { 0 }));\n1581\t        match ep {\n1582\t            0 | 2 => {\n1583\t                l.js_newcfunction(j, Some(cf_inner), N_INNER, 1);\n1584\t                l.js_pushundefined(j);\n1585\t                r.push_str(&push_callee(l, j, k));\n1586\t                for i in 0..n {\n1587\t                    let (kd, x) = args[i as usize % args.len()];\n1588\t                    push_arg(l, j, kd, x);\n1589\t                }\n1590\t                let rc = l.js_pcall(j, n + 1);\n1591\t                r.push_str(&format!(\" rc={rc} {}\", snap(l, j)));\n1592\t            }\n1593\t            1 => {\n1594\t                r.push_str(&push_callee(l, j, k));\n1595\t                l.js_pushundefined(j);\n1596\t                for i in 0..n {\n1597\t                    let (kd, x) = args[i as usize % args.len()];\n1598\t                    push_arg(l, j, kd, x);\n1599\t                }\n1600\t                let rc = l.js_pcall(j, n);\n1601\t                r.push_str(&format!(\" rc={rc} {}\", snap(l, j)));\n1602\t            }\n1603\t            _ => {\n1604\t                r.push_str(&push_callee(l, j, k));\n1605\t                for i in 0..n {\n1606\t                    let (kd, x) = args[i as usize % args.len()];\n1607\t                    push_arg(l, j, kd, x);\n1608\t                }\n1609\t                let rc = l.js_pconstruct(j, n);\n1610\t                r.push_str(&format!(\" rc={rc} {}\", snap(l, j)));\n1611\t            }\n1612\t        }\n1613\t        // fully drain and check the sentinel survived where expected\n1614\t        let top = l.js_gettop(j);\n1615\t        r.push_str(&format!(\" finaltop={top} bottom={}\", from_c(l.js_tryrepr(j, 0, ERRSTR))));\n1616\t        l.js_pop(j, top);\n1617\t        r.push_str(&format!(\" drained={}\", l.js_gettop(j)));\n1618\t        l.js_freestate(j);\n1619\t        r\n1620\t    }\n1621\t}\n1622\t\n1623\t#[test]\n1624\tfn t_call_matrix() {\n1625\t    with_big_stack(body_t_call_matrix);\n1626\t}\n1627\t\n1628\tfn body_t_call_matrix() {\n1629\t    let mut rng = Rng::new(0x0BAD_F00D);\n1630\t    let argpool = [0.0, 1.0, -1.5, 2.0, 1e21, f64::NAN, 1234.5, -0.0];\n1631\t    let mut seen_ok = 0usize;\n1632\t    let mut seen_err = 0usize;\n1633\t    let mut marks = std::collections::BTreeSet::new();\n1634\t    for flags in [0, JS_STRICT] {\n1635\t        for ep in 0u8..4 {\n1636\t            for k in 0..NCALLEES {\n1637\t                for n in [0, 1, 2, 3, 5, 7, 12, 33] {\n1638\t                    let mut args = vec![];\n1639\t                    for _ in 0..8 {\n1640\t                        args.push((\n1641\t                            rng.next_u32(),\n1642\t                            argpool[rng.below(argpool.len() as u32) as usize],\n1643\t                        ));\n1644\t                    }\n1645\t                    let a = args.clone();\n1646\t                    let t = diff2(\n1647\t                        &format!(\"call ep={ep} callee={k} n={n} flags={flags}\"),\n1648\t                        move |l| call_case(l, flags, ep, k, n, &a),\n1649\t                    );\n1650\t                    if t.contains(\" rc=0 \") {\n1651\t                        seen_ok += 1;\n1652\t                    }\n1653\t                    if t.contains(\" rc=1 \") {\n1654\t                        seen_err += 1;\n1655\t                    }\n1656\t                    for m in [\n1657\t                        \"[probe \", \"[cc \", \"[void \", \"[three \", \"[data=\", \"is not callable\",\n1658\t                        \"probe-result\", \"script-ran\",\n1659\t                    ] {\n1660\t                        if t.contains(m) {\n1661\t                            marks.insert(m);\n1662\t                        }\n1663\t                    }\n1664\t                }\n1665\t            }\n1666\t        }\n1667\t    }\n1668\t    // make sure the matrix really reached all the interesting shapes\n1669\t    assert!(seen_ok > 100, \"only {seen_ok} successful calls\");\n1670\t    assert!(seen_err > 100, \"only {seen_err} throwing calls\");\n1671\t    assert_eq!(\n1672\t        marks.len(),\n1673\t        8,\n1674\t        \"the call matrix never reached: {:?}\",\n1675\t        [\n1676\t            \"[probe \", \"[cc \", \"[void \", \"[three \", \"[data=\", \"is not callable\", \"probe-result\",\n1677\t            \"script-ran\"\n1678\t        ]\n1679\t        .iter()\n1680\t        .filter(|m| !marks.contains(*m))\n1681\t        .collect::<Vec<_>>()\n1682\t    );\n1683\t}\n1684\t\n1685\t/// `js_call(J, n)` with n < 0 raises js_rangeerror \"number of arguments cannot\n1686\t/// be negative\", which is only observable through js_pcall.\n1687\t///\n1688\t/// UNDEFINED BEHAVIOUR, deliberately not tested: `js_pcall` (jsrun.c:1416) and\n1689\t/// `js_pconstruct` (jsrun.c:1402) compute `savetop = TOP - n - 2` *before* `n`\n1690\t/// is validated, and their error handlers then write `STACK[savetop]`. For\n1691\t/// n <= -2 that slot is above TOP, so the handler publishes uninitialised\n1692\t/// js_Values and TOP jumps by |n|+1; for a large positive n with a nearly empty\n1693\t/// stack `savetop` goes negative and the handler writes *before* `J->stack`.\n1694\t/// Both are out-of-bounds accesses in the C, so only n == -1 (savetop == TOP-1,\n1695\t/// exactly the slot the error legitimately lands in) is driven here, and every\n1696\t/// other test in this file keeps `savetop` inside the frame.\n1697\t#[test]\n1698\tfn t_call_negative_and_big_n() {\n1699\t    for n in [-1] {\n1700\t        diff2(&format!(\"pcall n={n}\"), move |l| unsafe {\n1701\t            let j = new_state(l, 0);\n1702\t            for i in 0..8 {\n1703\t                l.js_pushnumber(j, i as f64);\n1704\t            }\n1705\t            let rc = push_expr(l, j, \"(function(){ return 'x' })\");\n1706\t            l.js_pushundefined(j);\n1707\t            let rc2 = l.js_pcall(j, n);\n1708\t            let r = format!(\"pushrc={rc} rc={rc2} {}\", snap(l, j));\n1709\t            let t = l.js_gettop(j);\n1710\t            l.js_pop(j, t);\n1711\t            l.js_freestate(j);\n1712\t            r\n1713\t        });\n1714\t    }\n1715\t    // n larger than the number of pushed arguments, but still with savetop\n1716\t    // inside the frame: stackidx() clamps to the shared static `undefined`, so\n1717\t    // `js_iscallable(J, -n-2)` is false and the typeerror path runs.\n1718\t    for n in [1, 2, 3, 8, 20] {\n1719\t        diff2(&format!(\"pcall short n={n}\"), move |l| unsafe {\n1720\t            let j = new_state(l, 0);\n1721\t            // enough padding that savetop = TOP - n - 2 >= 0\n1722\t            for i in 0..40 {\n1723\t                l.js_pushnumber(j, i as f64);\n1724\t            }\n1725\t            let rc = l.js_pcall(j, n);\n1726\t            let r = format!(\"rc={rc} {}\", snap(l, j));\n1727\t            let t = l.js_gettop(j);\n1728\t            l.js_pop(j, t);\n1729\t            l.js_freestate(j);\n1730\t            r\n1731\t        });\n1732\t    }\n1733\t    // and the same for js_pconstruct\n1734\t    for n in [0, 1, 2, 3, 8, 20] {\n1735\t        diff2(&format!(\"pconstruct short n={n}\"), move |l| unsafe {\n1736\t            let j = new_state(l, 0);\n1737\t            for i in 0..40 {\n1738\t                l.js_pushnumber(j, i as f64);\n1739\t            }\n1740\t            let rc = l.js_pconstruct(j, n);\n1741\t            let r = format!(\"rc={rc} {}\", snap(l, j));\n1742\t            let t = l.js_gettop(j);\n1743\t            l.js_pop(j, t);\n1744\t            l.js_freestate(j);\n1745\t            r\n1746\t        });\n1747\t    }\n1748\t}\n1749\t\n1750\t/* ====================================================================== */\n1751\t/*  Rows 56, 79: js_currentfunction / js_currentfunctiondata               */\n1752\t/* ====================================================================== */\n1753\t\n1754\t#[test]\n1755\tfn t_currentfunction() {\n1756\t    diff2(\"currentfunction at top level\", |l| unsafe {\n1757\t        let j = new_state(l, 0);\n1758\t        // BOT == 0: undefined is pushed, and the data pointer is NULL\n1759\t        let d = l.js_currentfunctiondata(j);\n1760\t        l.js_currentfunction(j);\n1761\t        let r = format!(\n1762\t            \"data_null={} {} \",\n1763\t            d.is_null(),\n1764\t            snap(l, j)\n1765\t        );\n1766\t        l.js_pop(j, 1);\n1767\t        l.js_freestate(j);\n1768\t        r\n1769\t    });\n1770\t\n1771\t    for withfin in [false, true] {\n1772\t        let t = diff2(&format!(\"cfunctionx data fin={withfin}\"), move |l| unsafe {\n1773\t            let j = new_state(l, 0);\n1774\t            l.js_newcfunctionx(\n1775\t                j,\n1776\t                Some(cf_data),\n1777\t                N_DATAF,\n1778\t                1,\n1779\t                PAYLOAD as *mut c_void,\n1780\t                if withfin { Some(fin_cb) } else { None },\n1781\t            );\n1782\t            l.js_setglobal(j, N_DATAF);\n1783\t            let cs = cstr(\"print(dataf(), dataf(1,2,3), dataf.length, typeof dataf.prototype)\");\n1784\t            let rc = l.js_dostring(j, cs.as_ptr());\n1785\t            let r = format!(\"rc={rc} top={}\", l.js_gettop(j));\n1786\t            // js_gc must not free the still-reachable function\n1787\t            l.js_gc(j, 0);\n1788\t            l.js_delglobal(j, N_DATAF);\n1789\t            l.js_gc(j, 0); // now unreachable -> finalizer runs (row 193)\n1790\t            l.js_freestate(j); // and again for anything left (row 195)\n1791\t            r\n1792\t        });\n1793\t        assert!(\n1794\t            t.contains(\"[data=payload-A fn=function callable=1 same=1]\"),\n1795\t            \"js_currentfunctiondata did not surface the data pointer: {t}\"\n1796\t        );\n1797\t        assert_eq!(\n1798\t            t.matches(\"[finalize payload-A]\").count(),\n1799\t            if withfin { 1 } else { 0 },\n1800\t            \"wrong number of finalizer runs (fin={withfin}): {t}\"\n1801\t        );\n1802\t    }\n1803\t\n1804\t    // js_newcfunctionx with data but no finalizer, called through js_construct\n1805\t    diff2(\"cfunctionx construct\", |l| unsafe {\n1806\t        let j = new_state(l, 0);\n1807\t        l.js_pushnumber(j, -1.0); // sentinel under the callee\n1808\t        l.js_newcfunctionx(j, Some(cf_data), N_DATAF, 1, PAYLOAD as *mut c_void, None);\n1809\t        let rc = l.js_pconstruct(j, 0);\n1810\t        let r = format!(\"rc={rc} {}\", snap(l, j));\n1811\t        let t = l.js_gettop(j);\n1812\t        l.js_pop(j, t);\n1813\t        l.js_freestate(j);\n1814\t        r\n1815\t    });\n1816\t}\n1817\t\n1818\t/* ====================================================================== */\n1819\t/*  Rows 81-84: js_newuserdata / js_newuserdatax hooks                     */\n1820\t/* ====================================================================== */\n1821\t\n1822\t#[test]\n1823\tfn t_userdata_hooks() {\n1824\t    let probe = \"\\\n1825\tprint(u.magic1, u.magic2, u.plain);\\n\\\n1826\tu.rox = 1; u.keep = 2;\\n\\\n1827\tprint(u.keep, u.rox);\\n\\\n1828\tprint(delete u.delz, delete u.keep, delete u.other);\\n\\\n1829\tprint('magic3' in u, 'nope' in u);\\n\\\n1830\tprint(typeof u, u.magicX);\\n\";\n1831\t\n1832\t    // (a) js_newuserdata: has/put/delete all NULL -> generic property tree\n1833\t    for protoobj in [false, true] {\n1834\t        diff2(&format!(\"newuserdata proto={protoobj}\"), move |l| unsafe {\n1835\t            let j = new_state(l, 0);\n1836\t            if protoobj {\n1837\t                l.js_newobject(j);\n1838\t                l.js_pushnumber(j, 9.0);\n1839\t                l.js_setproperty(j, -2, cn!(\"inherited\"));\n1840\t            } else {\n1841\t                l.js_pushnumber(j, 7.0); // non-object -> prototype NULL\n1842\t            }\n1843\t            l.js_newuserdata(j, N_TAG, PAYLOAD as *mut c_void, Some(fin_cb));\n1844\t            let isud = l.js_isuserdata(j, -1, N_TAG);\n1845\t            let isother = l.js_isuserdata(j, -1, cn!(\"othertag\"));\n1846\t            l.js_setglobal(j, N_UD);\n1847\t            let cs = cstr(\"print(u.magic1, u.plain, u.inherited); u.k=1; print(u.k, delete u.k)\");\n1848\t            let rc = l.js_dostring(j, cs.as_ptr());\n1849\t            let r = format!(\"isud={isud} isother={isother} rc={rc} top={}\", l.js_gettop(j));\n1850\t            l.js_freestate(j);\n1851\t            r\n1852\t        });\n1853\t    }\n1854\t\n1855\t    // (b) js_newuserdatax with all four hooks\n1856\t    let mut hookmarks: std::collections::BTreeSet<&str> = Default::default();\n1857\t    for mask in 0..16u32 {\n1858\t        let src = probe.to_string();\n1859\t        let t = diff2(&format!(\"newuserdatax mask={mask}\"), move |l| unsafe {\n1860\t            let j = new_state(l, 0);\n1861\t            l.js_newobject(j);\n1862\t            l.js_newuserdatax(\n1863\t                j,\n1864\t                N_TAG,\n1865\t                PAYLOAD as *mut c_void,\n1866\t                if mask & 1 != 0 { Some(ud_has) } else { None },\n1867\t                if mask & 2 != 0 { Some(ud_put) } else { None },\n1868\t                if mask & 4 != 0 { Some(ud_del) } else { None },\n1869\t                if mask & 8 != 0 { Some(fin_cb) } else { None },\n1870\t            );\n1871\t            l.js_setglobal(j, N_UD);\n1872\t            let cs = cstr(&src);\n1873\t            let rc = l.js_dostring(j, cs.as_ptr());\n1874\t            let mut r = format!(\"rc={rc} top={}\", l.js_gettop(j));\n1875\t            // the C API side of the same hooks\n1876\t            r.push_str(&format!(\n1877\t                \" api_has={} \",\n1878\t                {\n1879\t                    l.js_pushglobal(j);\n1880\t                    let h = l.js_hasproperty(j, -1, cn!(\"magicAPI\"));\n1881\t                    let s = format!(\"{h}/{}\", from_c(l.js_tryrepr(j, -1, ERRSTR)));\n1882\t                    if h != 0 {\n1883\t                        l.js_pop(j, 1);\n1884\t                    }\n1885\t                    l.js_pop(j, 1);\n1886\t                    s\n1887\t                }\n1888\t            ));\n1889\t            l.js_getglobal(j, N_UD);\n1890\t            let h2 = l.js_hasproperty(j, -1, cn!(\"magicAPI\"));\n1891\t            if h2 != 0 {\n1892\t                r.push_str(&format!(\" hasval={}\", from_c(l.js_tryrepr(j, -1, ERRSTR))));\n1893\t                l.js_pop(j, 1);\n1894\t            }\n1895\t            l.js_pushnumber(j, 3.0);\n1896\t            l.js_setproperty(j, -2, cn!(\"roAPI\"));\n1897\t            l.js_delproperty(j, -1, cn!(\"delAPI\"));\n1898\t            l.js_pop(j, 1);\n1899\t            r.push_str(&format!(\" end={}\", l.js_gettop(j)));\n1900\t            l.js_freestate(j);\n1901\t            r\n1902\t        });\n1903\t        for m in [\"[has \", \"[put \", \"[del \", \"[finalize \"] {\n1904\t            if t.contains(m) {\n1905\t                hookmarks.insert(m);\n1906\t            }\n1907\t        }\n1908\t        // a hook that was not installed must never appear\n1909\t        for (bit, m) in [(1u32, \"[has \"), (2, \"[put \"), (4, \"[del \"), (8, \"[finalize \")] {\n1910\t            if mask & bit == 0 {\n1911\t                assert!(!t.contains(m), \"mask={mask} fired {m} anyway: {t}\");\n1912\t            } else {\n1913\t                assert!(t.contains(m), \"mask={mask} never fired {m}: {t}\");\n1914\t            }\n1915\t        }\n1916\t    }\n1917\t    assert_eq!(hookmarks.len(), 4, \"not every userdata hook fired: {hookmarks:?}\");\n1918\t\n1919\t    // (c) strict mode changes what a rejected write does\n1920\t    for flags in [0, JS_STRICT] {\n1921\t        let src = probe.to_string();\n1922\t        diff2(&format!(\"userdatax strict flags={flags}\"), move |l| unsafe {\n1923\t            let j = new_state(l, flags);\n1924\t            l.js_newobject(j);\n1925\t            l.js_newuserdatax(\n1926\t                j,\n1927\t                N_TAG,\n1928\t                PAYLOAD as *mut c_void,\n1929\t                Some(ud_has),\n1930\t                Some(ud_put),\n1931\t                Some(ud_del),\n1932\t                Some(fin_cb),\n1933\t            );\n1934\t            l.js_setglobal(j, N_UD);\n1935\t            let cs = cstr(&src);\n1936\t            let rc = l.js_dostring(j, cs.as_ptr());\n1937\t            let r = format!(\"rc={rc} top={}\", l.js_gettop(j));\n1938\t            l.js_freestate(j);\n1939\t            r\n1940\t        });\n1941\t    }\n1942\t}\n1943\t\n1944\t/// Row 79: the `js_newcfunctionx` / `js_newuserdatax` finalizer must run before\n1945\t/// the exception is rethrown when construction itself throws.\n1946\t#[test]\n1947\tfn t_finalizer_on_construction_failure() {\n1948\t    let mut rng = Rng::new(0x0F1E_2D3C);\n1949\t    let mut lims: Vec<c_int> = (1..=80).collect();\n1950\t    lims.extend([100, 160, 256, 1024, 1 << 16, 0]);\n1951\t    for _ in 0..40 {\n1952\t        lims.push(rng.below(4096) as c_int);\n1953\t    }\n1954\t    let mut nfin = 0usize;\n1955\t    let mut nok = 0usize;\n1956\t    for lim in lims {\n1957\t        for which in 0..2 {\n1958\t            let t = diff2(\n1959\t                &format!(\"oom finalizer lim={lim} which={which}\"),\n1960\t                move |l| unsafe {\n1961\t                    let j = new_state(l, 0);\n1962\t                    FIN_LIMIT.with(|c| c.set(lim));\n1963\t                    l.js_newcfunction(\n1964\t                        j,\n1965\t                        Some(if which == 0 {\n1966\t                            cf_oom_cfunctionx\n1967\t                        } else {\n1968\t                            cf_oom_userdatax\n1969\t                        }),\n1970\t                        cn!(\"oom\"),\n1971\t                        0,\n1972\t                    );\n1973\t                    l.js_pushundefined(j);\n1974\t                    let rc = l.js_pcall(j, 0);\n1975\t                    // lift the limit again so the teardown is unconstrained\n1976\t                    l.js_setlimit(j, 0, 0);\n1977\t                    let r = format!(\"rc={rc} {}\", safeview(l, j));\n1978\t                    drain_to(l, j, 0);\n1979\t                    l.js_freestate(j);\n1980\t                    r\n1981\t                },\n1982\t            );\n1983\t            if t.contains(\"rc=1\") && t.contains(\"[finalize payload-A]\") {\n1984\t                nfin += 1;\n1985\t            }\n1986\t            if t.contains(\"rc=0\") {\n1987\t                nok += 1;\n1988\t            }\n1989\t        }\n1990\t    }\n1991\t    assert!(\n1992\t        nfin > 10,\n1993\t        \"the construction-failure finalizer path never ran ({nfin})\"\n1994\t    );\n1995\t    assert!(nok > 0, \"no successful construction at all\");\n1996\t}\n1997\t\n1998\t/* ====================================================================== */\n1999\t/*  Rows 183-187: js_ref / js_unref / registry                             */\n2000\t/* ====================================================================== */\n2001\t\n2002\t#[test]\n2003\tfn t_ref_fixed_names() {\n2004\t    // Row 183: undefined / null / true / false get fixed names\n2005\t    diff2(\"ref fixed names\", |l| unsafe {\n2006\t        let j = new_state(l, 0);\n2007\t        let mut r = String::new();\n2008\t        for k in 0..6 {\n2009\t            match k {\n2010\t                0 => l.js_pushundefined(j),\n2011\t                1 => l.js_pushnull(j),\n2012\t                2 => l.js_pushboolean(j, 1),\n2013\t                3 => l.js_pushboolean(j, 0),\n2014\t                4 => l.js_pushboolean(j, 42), // normalised to !!v\n2015\t                _ => l.js_pushboolean(j, -7),\n2016\t            }\n2017\t            let name = from_c(l.js_ref(j));\n2018\t            // js_ref popped the value via js_setregistry\n2019\t            l.js_getregistry(j, cstr(&name).as_ptr());\n2020\t            r.push_str(&format!(\n2021\t                \"k={k} ref={name} back={} top={} | \",\n2022\t                from_c(l.js_tryrepr(j, -1, ERRSTR)),\n2023\t                l.js_gettop(j)\n2024\t            ));\n2025\t            l.js_pop(j, 1);\n2026\t        }\n2027\t        l.js_freestate(j);\n2028\t        r\n2029\t    });\n2030\t}\n2031\t\n2032\t#[test]\n2033\tfn t_ref_objects() {\n2034\t    // Row 184: \"%p\" of the object pointer, interned.  The pointer value itself\n2035\t    // is not comparable between the two libraries, so compare the *structure*:\n2036\t    // shape of the string, stability per object, and uniqueness across objects.\n2037\t    let p = libs();\n2038\t    for l in [&p.c, &p.rs] {\n2039\t        unsafe {\n2040\t            set_cur(l);\n2041\t            let j = new_state(l, 0);\n2042\t            let mut names = vec![];\n2043\t            for i in 0..24 {\n2044\t                if i % 3 == 0 {\n2045\t                    l.js_newobject(j);\n2046\t                } else if i % 3 == 1 {\n2047\t                    l.js_newarray(j);\n2048\t                } else {\n2049\t                    l.js_newcfunction(j, Some(cf_void), N_VOIDF, 0);\n2050\t                }\n2051\t                l.nullary(\"js_dup\", j);\n2052\t                let a = from_c(l.js_ref(j));\n2053\t                let b = from_c(l.js_ref(j)); // same object -> same ref\n2054\t                assert_eq!(a, b, \"{}: js_ref not stable for one object\", l.name);\n2055\t                assert!(\n2056\t                    a.starts_with(\"0x\") || a.starts_with(\"(nil)\"),\n2057\t                    \"{}: js_ref(object) = {a:?} is not a %p rendering\",\n2058\t                    l.name\n2059\t                );\n2060\t                names.push(a);\n2061\t            }\n2062\t            let uniq: std::collections::BTreeSet<_> = names.iter().collect();\n2063\t            assert_eq!(\n2064\t                uniq.len(),\n2065\t                names.len(),\n2066\t                \"{}: distinct objects shared a ref name\",\n2067\t                l.name\n2068\t            );\n2069\t            // and each one still resolves to an object in the registry\n2070\t            for n in &names {\n2071\t                let cs = cstr(n);\n2072\t                l.js_getregistry(j, cs.as_ptr());\n2073\t                assert_eq!(l.pred(\"js_isobject\", j, -1), 1, \"{}: {n} lost\", l.name);\n2074\t                l.js_pop(j, 1);\n2075\t            }\n2076\t            l.js_freestate(j);\n2077\t        }\n2078\t    }\n2079\t}\n2080\t\n2081\t#[test]\n2082\tfn t_ref_sequential() {\n2083\t    // Row 185: numbers and strings get J->nextref, so equal values still get\n2084\t    // fresh (and byte-identical between the two libraries) names.\n2085\t    let mut rng = Rng::new(0xBEEF_1234);\n2086\t    let mut vals: Vec<String> = vec![];\n2087\t    for _ in 0..40 {\n2088\t        vals.push(rng.ascii_string(20));\n2089\t    }\n2090\t    diff2(\"ref sequential\", move |l| unsafe {\n2091\t        let j = new_state(l, 0);\n2092\t        let mut r = String::new();\n2093\t        for i in 0..12 {\n2094\t            l.js_pushnumber(j, 7.0); // same value every time\n2095\t            r.push_str(&from_c(l.js_ref(j)));\n2096\t            r.push(',');\n2097\t            let _ = i;\n2098\t        }\n2099\t        for v in &vals {\n2100\t            let cs = cstr(v);\n2101\t            l.js_pushstring(j, cs.as_ptr());\n2102\t            let n = from_c(l.js_ref(j));\n2103\t            let cn = cstr(&n);\n2104\t            l.js_getregistry(j, cn.as_ptr());\n2105\t            r.push_str(&format!(\n2106\t                \"{n}={} \",\n2107\t                from_c(l.js_tryrepr(j, -1, ERRSTR))\n2108\t            ));\n2109\t            l.js_pop(j, 1);\n2110\t        }\n2111\t        r.push_str(&format!(\" top={}\", l.js_gettop(j)));\n2112\t        l.js_freestate(j);\n2113\t        r\n2114\t    });\n2115\t}\n2116\t\n2117\t/// `J->nextref` is a plain `int` formatted with `\"%d\"` and then interned, so a\n2118\t/// long run of `js_ref` calls also exercises the intern table's growth.\n2119\t#[test]\n2120\tfn t_ref_many() {\n2121\t    for n in [64usize, 1000, 5000] {\n2122\t        diff2(&format!(\"ref many n={n}\"), move |l| unsafe {\n2123\t            let j = new_state(l, 0);\n2124\t            let mut first = String::new();\n2125\t            let mut last = String::new();\n2126\t            let mut lastraw = String::new();\n2127\t            for i in 0..n {\n2128\t                if i % 5 == 4 {\n2129\t                    l.js_newobject(j);\n2130\t                } else {\n2131\t                    l.js_pushnumber(j, (i % 7) as f64);\n2132\t                }\n2133\t                let name = from_c(l.js_ref(j));\n2134\t                if i == 0 {\n2135\t                    first = norm_ref(&name);\n2136\t                }\n2137\t                lastraw = name.clone();\n2138\t                last = norm_ref(&name);\n2139\t            }\n2140\t            let mut r = format!(\"first={first} last={last} top={}\", l.js_gettop(j));\n2141\t            l.js_gc(j, 1);\n2142\t            // every ref is still reachable from J->R\n2143\t            l.js_getregistry(j, cstr(&lastraw).as_ptr());\n2144\t            r.push_str(&format!(\" back={}\", from_c(l.js_typeof(j, -1))));\n2145\t            l.js_pop(j, 1);\n2146\t            l.js_freestate(j);\n2147\t            r\n2148\t        });\n2149\t    }\n2150\t}\n2151\t\n2152\t#[test]\n2153\tfn t_registry_roundtrip() {\n2154\t    // Rows 186, 187\n2155\t    let mut rng = Rng::new(0x1357_9BDF);\n2156\t    let mut names: Vec<String> = vec![\n2157\t        \"a\".into(),\n2158\t        \"\".into(),\n2159\t        \"_Undefined\".into(),\n2160\t        \"0\".into(),\n2161\t        \"a very long registry key name indeed\".into(),\n2162\t    ];\n2163\t    for _ in 0..40 {\n2164\t        let s = rng.ascii_string(18);\n2165\t        if !s.is_empty() {\n2166\t            names.push(s);\n2167\t        }\n2168\t    }\n2169\t    for _ in 0..40 {\n2170\t        let s = rng.unicode_string(10);\n2171\t        if !s.is_empty() {\n2172\t            names.push(s);\n2173\t        }\n2174\t    }\n2175\t    names.push(\"x\".repeat(300));\n2176\t    names.push(\"\\u{10FFFF}\\u{7f}\\u{80}\\u{7ff}\\u{800}\".to_string());\n2177\t    diff2(\"registry roundtrip\", move |l| unsafe {\n2178\t        let j = new_state(l, 0);\n2179\t        let mut r = String::new();\n2180\t        for (i, n) in names.iter().enumerate() {\n2181\t            let cs = cstr(n);\n2182\t            // get before set -> undefined\n2183\t            l.js_getregistry(j, cs.as_ptr());\n2184\t            r.push_str(&format!(\"pre={} \