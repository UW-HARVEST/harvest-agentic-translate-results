86\t    }\n787\t    pub unsafe fn throwerror_s(&self, name: &'static str, j: JS, fmt: *const c_char, a: *const c_char) {\n788\t        let mut b = name.as_bytes().to_vec();\n789\t        b.push(0);\n790\t        let s: Symbol<unsafe extern \"C\" fn(JS, *const c_char, *const c_char)> = self\n791\t            .lib\n792\t            .get(&b)\n793\t            .unwrap_or_else(|e| panic!(\"{}: missing {}: {}\", self.name, name, e));\n794\t        (*s)(j, fmt, a)\n795\t    }\n796\t    pub unsafe fn throwerror_d(&self, name: &'static str, j: JS, fmt: *const c_char, a: c_int) {\n797\t        let mut b = name.as_bytes().to_vec();\n798\t        b.push(0);\n799\t        let s: Symbol<unsafe extern \"C\" fn(JS, *const c_char, c_int)> = self\n800\t            .lib\n801\t            .get(&b)\n802\t            .unwrap_or_else(|e| panic!(\"{}: missing {}: {}\", self.name, name, e));\n803\t        (*s)(j, fmt, a)\n804\t    }\n805\t\n806\t    /* ---------------- low level: numbers ---------------- */\n807\t    pub unsafe fn js_itoa(&self, buf: *mut c_char, a: c_int) -> *const c_char {\n808\t        sym!(\n809\t            self,\n810\t            \"js_itoa\",\n811\t            unsafe extern \"C\" fn(*mut c_char, c_int) -> *const c_char\n812\t        )(buf, a)\n813\t    }\n814\t    pub unsafe fn js_strtod(&self, s: *const c_char, ep: *mut *mut c_char) -> f64 {\n815\t        sym!(\n816\t            self,\n817\t            \"js_strtod\",\n818\t            unsafe extern \"C\" fn(*const c_char, *mut *mut c_char) -> f64\n819\t        )(s, ep)\n820\t    }\n821\t    pub unsafe fn js_strtol(&self, s: *const c_char, ep: *mut *mut c_char, radix: c_int) -> f64 {\n822\t        sym!(\n823\t            self,\n824\t            \"js_strtol\",\n825\t            unsafe extern \"C\" fn(*const c_char, *mut *mut c_char, c_int) -> f64\n826\t        )(s, ep, radix)\n827\t    }\n828\t    pub unsafe fn js_stringtofloat(&self, s: *const c_char, ep: *mut *mut c_char) -> f64 {\n829\t        sym!(\n830\t            self,\n831\t            \"js_stringtofloat\",\n832\t            unsafe extern \"C\" fn(*const c_char, *mut *mut c_char) -> f64\n833\t        )(s, ep)\n834\t    }\n835\t    pub unsafe fn js_grisu2(&self, v: f64, buf: *mut c_char, k: *mut c_int) -> c_int {\n836\t        sym!(\n837\t            self,\n838\t            \"js_grisu2\",\n839\t            unsafe extern \"C\" fn(f64, *mut c_char, *mut c_int) -> c_int\n840\t        )(v, buf, k)\n841\t    }\n842\t    pub unsafe fn js_fmtexp(&self, p: *mut c_char, e: c_int) {\n843\t        sym!(self, \"js_fmtexp\", unsafe extern \"C\" fn(*mut c_char, c_int))(p, e)\n844\t    }\n845\t    pub unsafe fn jsV_numbertointeger(&self, n: f64) -> c_int {\n846\t        sym!(self, \"jsV_numbertointeger\", unsafe extern \"C\" fn(f64) -> c_int)(n)\n847\t    }\n848\t    pub unsafe fn jsV_numbertoint32(&self, n: f64) -> c_int {\n849\t        sym!(self, \"jsV_numbertoint32\", unsafe extern \"C\" fn(f64) -> c_int)(n)\n850\t    }\n851\t    pub unsafe fn jsV_numbertouint32(&self, n: f64) -> c_uint {\n852\t        sym!(self, \"jsV_numbertouint32\", unsafe extern \"C\" fn(f64) -> c_uint)(n)\n853\t    }\n854\t    pub unsafe fn jsV_numbertoint16(&self, n: f64) -> c_short {\n855\t        sym!(self, \"jsV_numbertoint16\", unsafe extern \"C\" fn(f64) -> c_short)(n)\n856\t    }\n857\t    pub unsafe fn jsV_numbertouint16(&self, n: f64) -> c_ushort {\n858\t        sym!(\n859\t            self,\n860\t            \"jsV_numbertouint16\",\n861\t            unsafe extern \"C\" fn(f64) -> c_ushort\n862\t        )(n)\n863\t    }\n864\t    pub unsafe fn jsV_numbertostring(&self, j: JS, buf: *mut c_char, n: f64) -> *const c_char {\n865\t        sym!(\n866\t            self,\n867\t            \"jsV_numbertostring\",\n868\t            unsafe extern \"C\" fn(JS, *mut c_char, f64) -> *const c_char\n869\t        )(j, buf, n)\n870\t    }\n871\t    pub unsafe fn jsV_stringtonumber(&self, j: JS, s: *const c_char) -> f64 {\n872\t        sym!(\n873\t            self,\n874\t            \"jsV_stringtonumber\",\n875\t            unsafe extern \"C\" fn(JS, *const c_char) -> f64\n876\t        )(j, s)\n877\t    }\n878\t\n879\t    /* ---------------- low level: utf ---------------- */\n880\t    pub unsafe fn jsU_chartorune(&self, rune: *mut Rune, s: *const c_char) -> c_int {\n881\t        sym!(\n882\t            self,\n883\t            \"jsU_chartorune\",\n884\t            unsafe extern \"C\" fn(*mut Rune, *const c_char) -> c_int\n885\t        )(rune, s)\n886\t    }\n887\t    pub unsafe fn jsU_runetochar(&self, s: *mut c_char, rune: *const Rune) -> c_int {\n888\t        sym!(\n889\t            self,\n890\t            \"jsU_runetochar\",\n891\t            unsafe extern \"C\" fn(*mut c_char, *const Rune) -> c_int\n892\t        )(s, rune)\n893\t    }\n894\t    pub unsafe fn jsU_runelen(&self, c: c_int) -> c_int {\n895\t        sym!(self, \"jsU_runelen\", unsafe extern \"C\" fn(c_int) -> c_int)(c)\n896\t    }\n897\t    pub unsafe fn rune_pred(&self, name: &'static str, c: Rune) -> c_int {\n898\t        let mut b = name.as_bytes().to_vec();\n899\t        b.push(0);\n900\t        let s: Symbol<unsafe extern \"C\" fn(Rune) -> c_int> = self\n901\t            .lib\n902\t            .get(&b)\n903\t            .unwrap_or_else(|e| panic!(\"{}: missing {}: {}\", self.name, name, e));\n904\t        (*s)(c)\n905\t    }\n906\t    pub unsafe fn rune_full(&self, name: &'static str, c: Rune) -> *const Rune {\n907\t        let mut b = name.as_bytes().to_vec();\n908\t        b.push(0);\n909\t        let s: Symbol<unsafe extern \"C\" fn(Rune) -> *const Rune> = self\n910\t            .lib\n911\t            .get(&b)\n912\t            .unwrap_or_else(|e| panic!(\"{}: missing {}: {}\", self.name, name, e));\n913\t        (*s)(c)\n914\t    }\n915\t    pub unsafe fn js_utflen(&self, s: *const c_char) -> c_int {\n916\t        sym!(self, \"js_utflen\", unsafe extern \"C\" fn(*const c_char) -> c_int)(s)\n917\t    }\n918\t    pub unsafe fn js_utfptrtoidx(&self, s: *const c_char, p: *const c_char) -> c_int {\n919\t        sym!(\n920\t            self,\n921\t            \"js_utfptrtoidx\",\n922\t            unsafe extern \"C\" fn(*const c_char, *const c_char) -> c_int\n923\t        )(s, p)\n924\t    }\n925\t    pub unsafe fn js_runeat(&self, j: JS, s: *const c_char, i: c_int) -> c_int {\n926\t        sym!(\n927\t            self,\n928\t            \"js_runeat\",\n929\t            unsafe extern \"C\" fn(JS, *const c_char, c_int) -> c_int\n930\t        )(j, s, i)\n931\t    }\n932\t    pub unsafe fn js_isarrayindex(&self, j: JS, s: *const c_char, idx: *mut c_int) -> c_int {\n933\t        sym!(\n934\t            self,\n935\t            \"js_isarrayindex\",\n936\t            unsafe extern \"C\" fn(JS, *const c_char, *mut c_int) -> c_int\n937\t        )(j, s, idx)\n938\t    }\n939\t\n940\t    /* ---------------- low level: lexer helpers ---------------- */\n941\t    pub unsafe fn int_pred(&self, name: &'static str, c: c_int) -> c_int {\n942\t        let mut b = name.as_bytes().to_vec();\n943\t        b.push(0);\n944\t        let s: Symbol<unsafe extern \"C\" fn(c_int) -> c_int> = self\n945\t            .lib\n946\t            .get(&b)\n947\t            .unwrap_or_else(|e| panic!(\"{}: missing {}: {}\", self.name, name, e));\n948\t        (*s)(c)\n949\t    }\n950\t    pub unsafe fn jsY_tokenstring(&self, t: c_int) -> *const c_char {\n951\t        sym!(\n952\t            self,\n953\t            \"jsY_tokenstring\",\n954\t            unsafe extern \"C\" fn(c_int) -> *const c_char\n955\t        )(t)\n956\t    }\n957\t    pub unsafe fn jsY_findword(\n958\t        &self,\n959\t        s: *const c_char,\n960\t        list: *const *const c_char,\n961\t        num: c_int,\n962\t    ) -> c_int {\n963\t        sym!(\n964\t            self,\n965\t            \"jsY_findword\",\n966\t            unsafe extern \"C\" fn(*const c_char, *const *const c_char, c_int) -> c_int\n967\t        )(s, list, num)\n968\t    }\n969\t\n970\t    /* ---------------- low level: regexp ---------------- */\n971\t    pub unsafe fn js_regcomp(\n972\t        &self,\n973\t        pattern: *const c_char,\n974\t        cflags: c_int,\n975\t        errorp: *mut *const c_char,\n976\t    ) -> *mut c_void {\n977\t        sym!(\n978\t            self,\n979\t            \"js_regcomp\",\n980\t            unsafe extern \"C\" fn(*const c_char, c_int, *mut *const c_char) -> *mut c_void\n981\t        )(pattern, cflags, errorp)\n982\t    }\n983\t    pub unsafe fn js_regexec(\n984\t        &self,\n985\t        prog: *mut c_void,\n986\t        s: *const c_char,\n987\t        sub: *mut Resub,\n988\t        eflags: c_int,\n989\t    ) -> c_int {\n990\t        sym!(\n991\t            self,\n992\t            \"js_regexec\",\n993\t            unsafe extern \"C\" fn(*mut c_void, *const c_char, *mut Resub, c_int) -> c_int\n994\t        )(prog, s, sub, eflags)\n995\t    }\n996\t    pub unsafe fn js_regfree(&self, prog: *mut c_void) {\n997\t        sym!(self, \"js_regfree\", unsafe extern \"C\" fn(*mut c_void))(prog)\n998\t    }\n999\t    pub unsafe fn js_regcompx(\n1000\t        &self,\n1001\t        alloc: js_Alloc,\n1002\t        ctx: *mut c_void,\n1003\t        pattern: *const c_char,\n1004\t        cflags: c_int,\n1005\t        errorp: *mut *const c_char,\n1006\t    ) -> *mut c_void {\n1007\t        sym!(\n1008\t            self,\n1009\t            \"js_regcompx\",\n1010\t            unsafe extern \"C\" fn(\n1011\t                js_Alloc,\n1012\t                *mut c_void,\n1013\t                *const c_char,\n1014\t                c_int,\n1015\t                *mut *const c_char,\n1016\t            ) -> *mut c_void\n1017\t        )(alloc, ctx, pattern, cflags, errorp)\n1018\t    }\n1019\t    pub unsafe fn js_regfreex(&self, alloc: js_Alloc, ctx: *mut c_void, prog: *mut c_void) {\n1020\t        sym!(\n1021\t            self,\n1022\t            \"js_regfreex\",\n1023\t            unsafe extern \"C\" fn(js_Alloc, *mut c_void, *mut c_void)\n1024\t        )(alloc, ctx, prog)\n1025\t    }\n1026\t\n1027\t    /* ---------------- low level: intern / memory ---------------- */\n1028\t    pub unsafe fn js_intern(&self, j: JS, s: *const c_char) -> *const c_char {\n1029\t        sym!(\n1030\t            self,\n1031\t            \"js_intern\",\n1032\t            unsafe extern \"C\" fn(JS, *const c_char) -> *const c_char\n1033\t        )(j, s)\n1034\t    }\n1035\t    pub unsafe fn js_strdup(&self, j: JS, s: *const c_char) -> *mut c_char {\n1036\t        sym!(\n1037\t            self,\n1038\t            \"js_strdup\",\n1039\t            unsafe extern \"C\" fn(JS, *const c_char) -> *mut c_char\n1040\t        )(j, s)\n1041\t    }\n1042\t    pub unsafe fn js_malloc(&self, j: JS, n: c_int) -> *mut c_void {\n1043\t        sym!(self, \"js_malloc\", unsafe extern \"C\" fn(JS, c_int) -> *mut c_void)(j, n)\n1044\t    }\n1045\t    pub unsafe fn js_realloc(&self, j: JS, p: *mut c_void, n: c_int) -> *mut c_void {\n1046\t        sym!(\n1047\t            self,\n1048\t            \"js_realloc\",\n1049\t            unsafe extern \"C\" fn(JS, *mut c_void, c_int) -> *mut c_void\n1050\t        )(j, p, n)\n1051\t    }\n1052\t    pub unsafe fn js_free(&self, j: JS, p: *mut c_void) {\n1053\t        sym!(self, \"js_free\", unsafe extern \"C\" fn(JS, *mut c_void))(j, p)\n1054\t    }\n1055\t    pub unsafe fn jsS_dumpstrings(&self, j: JS) {\n1056\t        sym!(self, \"jsS_dumpstrings\", unsafe extern \"C\" fn(JS))(j)\n1057\t    }\n1058\t}\n1059\t\n1060\t/* ------------------------------------------------------- the two libs */\n1061\t\n1062\tpub struct Pair {\n1063\t    pub c: Lib,\n1064\t    pub rs: Lib,\n1065\t}\n1066\t\n1067\tpub fn libs() -> &'static Pair {\n1068\t    use std::sync::OnceLock;\n1069\t    static P: OnceLock<Pair> = OnceLock::new();\n1070\t    P.get_or_init(|| Pair {\n1071\t        c: Lib::open(\"C\", &c_so_path()),\n1072\t        rs: Lib::open(\"RUST\", &rust_so_path()),\n1073\t    })\n1074\t}\n1075\t\n1076\t/* --------------------------------------------- current-library context */\n1077\t\n1078\tthread_local! {\n1079\t    static CUR: Cell<*const Lib> = const { Cell::new(std::ptr::null()) };\n1080\t    static OUT: RefCell<Vec<u8>> = const { RefCell::new(Vec::new()) };\n1081\t}\n1082\t\n1083\tpub fn cur() -> &'static Lib {\n1084\t    let p = CUR.with(|c| c.get());\n1085\t    assert!(!p.is_null(), \"no current library set\");\n1086\t    unsafe { &*p }\n1087\t}\n1088\t\n1089\tpub fn set_cur(l: &Lib) {\n1090\t    CUR.with(|c| c.set(l as *const Lib));\n1091\t}\n1092\t\n1093\tpub fn out_clear() {\n1094\t    OUT.with(|o| o.borrow_mut().clear());\n1095\t}\n1096\t\n1097\tpub fn out_push(s: &[u8]) {\n1098\t    OUT.with(|o| o.borrow_mut().extend_from_slice(s));\n1099\t}\n1100\t\n1101\tpub fn out_take() -> String {\n1102\t    OUT.with(|o| {\n1103\t        let v = std::mem::take(&mut *o.borrow_mut());\n1104\t        String::from_utf8_lossy(&v).into_owned()\n1105\t    })\n1106\t}\n1107\t\n1108\tpub fn cstr(s: &str) -> CString {\n1109\t    CString::new(s.replace('\\0', \"\")).unwrap()\n1110\t}\n1111\t\n1112\tpub unsafe fn from_c(p: *const c_char) -> String {\n1113\t    if p.is_null() {\n1114\t        \"<NULL>\".to_string()\n1115\t    } else {\n1116\t        String::from_utf8_lossy(CStr::from_ptr(p).to_bytes()).into_owned()\n1117\t    }\n1118\t}\n1119\t\n1120\t/// Format a double the way a test comparison wants it: exact bits, so that\n1121\t/// -0.0 / NaN payloads / every last mantissa bit is compared.\n1122\tpub fn fbits(x: f64) -> u64 {\n1123\t    x.to_bits()\n1124\t}\n1125\t\n1126\t/* ------------------------------------------------------- script drivers */\n1127\t\n1128\tpub unsafe extern \"C\" fn report_cb(_j: JS, msg: *const c_char) {\n1129\t    out_push(b\"[report] \");\n1130\t    if !msg.is_null() {\n1131\t        out_push(CStr::from_ptr(msg).to_bytes());\n1132\t    } else {\n1133\t        out_push(b\"<NULL>\");\n1134\t    }\n1135\t    out_push(b\"\\n\");\n1136\t}\n1137\t\n1138\t/// `print(...)` - joins arguments with a space using js_tostring.\n1139\tpub unsafe extern \"C\" fn print_cb(j: JS) {\n1140\t    let l = cur();\n1141\t    let top = l.js_gettop(j);\n1142\t    for i in 1..top {\n1143\t        if i > 1 {\n1144\t            out_push(b\" \");\n1145\t        }\n1146\t        let s = l.js_tostring(j, i);\n1147\t        if s.is_null() {\n1148\t            out_push(b\"<NULL>\");\n1149\t        } else {\n1150\t            out_push(CStr::from_ptr(s).to_bytes());\n1151\t        }\n1152\t    }\n1153\t    out_push(b\"\\n\");\n1154\t    l.js_pushundefined(j);\n1155\t}\n1156\t\n1157\t/// `repr(x)` - pushes the js_torepr of argument 1 (used to compare values).\n1158\tpub unsafe extern \"C\" fn repr_cb(j: JS) {\n1159\t    let l = cur();\n1160\t    let s = l.js_torepr(j, 1);\n1161\t    l.js_pushstring(j, s);\n1162\t}\n1163\t\n1164\t/// `dump(...)` - like print but uses js_torepr for exact value shape.\n1165\tpub unsafe extern \"C\" fn dump_cb(j: JS) {\n1166\t    let l = cur();\n1167\t    let top = l.js_gettop(j);\n1168\t    for i in 1..top {\n1169\t        if i > 1 {\n1170\t            out_push(b\" \");\n1171\t        }\n1172\t        let s = l.js_torepr(j, i);\n1173\t        if s.is_null() {\n1174\t            out_push(b\"<NULL>\");\n1175\t        } else {\n1176\t            out_push(CStr::from_ptr(s).to_bytes());\n1177\t        }\n1178\t    }\n1179\t    out_push(b\"\\n\");\n1180\t    l.js_pushundefined(j);\n1181\t}\n1182\t\n1183\tpub const PRINT: *const c_char = b\"print\\0\".as_ptr() as *const c_char;\n1184\tpub const DUMP: *const c_char = b\"dump\\0\".as_ptr() as *const c_char;\n1185\tpub const ERRSTR: *const c_char = b\"<throw>\\0\".as_ptr() as *const c_char;\n1186\tpub const FILENAME: *const c_char = b\"test.js\\0\".as_ptr() as *const c_char;\n1187\t\n1188\t/// Create a fresh state with `print` / `dump` installed and the report hook\n1189\t/// pointing into the per-thread output buffer.\n1190\tpub unsafe fn new_state(l: &Lib, flags: c_int) -> JS {\n1191\t    set_cur(l);\n1192\t    let j = l.js_newstate(None, std::ptr::null_mut(), flags);\n1193\t    assert!(!j.is_null(), \"{}: js_newstate returned NULL\", l.name);\n1194\t    l.js_setreport(j, Some(report_cb));\n1195\t    l.js_newcfunction(j, Some(print_cb), PRINT, 1);\n1196\t    l.js_setglobal(j, PRINT);\n1197\t    l.js_newcfunction(j, Some(dump_cb), DUMP, 1);\n1198\t    l.js_setglobal(j, DUMP);\n1199\t    j\n1200\t}\n1201\t\n1202\t#[derive(Debug, PartialEq, Eq, Clone)]\n1203\tpub struct EvalResult {\n1204\t    pub load_rc: c_int,\n1205\t    pub call_rc: c_int,\n1206\t    pub result: String,\n1207\t    pub out: String,\n1208\t    pub top: c_int,\n1209\t}\n1210\t\n1211\t/// Full pipeline through the low level entry points:\n1212\t/// js_ploadstring -> js_pushundefined -> js_pcall -> js_tryrepr\n1213\tpub fn eval(l: &Lib, flags: c_int, src: &str) -> EvalResult {\n1214\t    unsafe {\n1215\t        out_clear();\n1216\t        let j = new_state(l, flags);\n1217\t        let cs = cstr(src);\n1218\t        let load_rc = l.js_ploadstring(j, FILENAME, cs.as_ptr());\n1219\t        let mut call_rc = -999;\n1220\t        let result;\n1221\t        if load_rc == 0 {\n1222\t            l.js_pushundefined(j);\n1223\t            call_rc = l.js_pcall(j, 0);\n1224\t            result = from_c(l.js_tryrepr(j, -1, ERRSTR));\n1225\t            l.js_pop(j, 1);\n1226\t        } else {\n1227\t            result = from_c(l.js_tryrepr(j, -1, ERRSTR));\n1228\t            l.js_pop(j, 1);\n1229\t        }\n1230\t        let top = l.js_gettop(j);\n1231\t        l.js_freestate(j);\n1232\t        EvalResult {\n1233\t            load_rc,\n1234\t            call_rc,\n1235\t            result,\n1236\t            out: out_take(),\n1237\t            top,\n1238\t        }\n1239\t    }\n1240\t}\n1241\t\n1242\t/// The convenience one-shot wrapper.\n1243\tpub fn dostring(l: &Lib, flags: c_int, src: &str) -> (c_int, String) {\n1244\t    unsafe {\n1245\t        out_clear();\n1246\t        let j = new_state(l, flags);\n1247\t        let cs = cstr(src);\n1248\t        let rc = l.js_dostring(j, cs.as_ptr());\n1249\t        l.js_freestate(j);\n1250\t        (rc, out_take())\n1251\t    }\n1252\t}\n1253\t\n1254\t/// Differential assertion for a JS snippet through the low level pipeline.\n1255\tpub fn diff_eval(flags: c_int, src: &str) {\n1256\t    let p = libs();\n1257\t    let a = eval(&p.c, flags, src);\n1258\t    let b = eval(&p.rs, flags, src);\n1259\t    assert_eq!(a, b, \"eval divergence (flags={flags})\\nsrc: {src}\");\n1260\t}\n1261\t\n1262\t/// Differential assertion for js_dostring.\n1263\tpub fn diff_dostring(flags: c_int, src: &str) {\n1264\t    let p = libs();\n1265\t    let a = dostring(&p.c, flags, src);\n1266\t    let b = dostring(&p.rs, flags, src);\n1267\t    assert_eq!(a, b, \"dostring divergence (flags={flags})\\nsrc: {src}\");\n1268\t}\n1269\t\n1270\t/* ---------------------------------------------------- tiny prng (xorshift) */\n1271\t\n1272\tpub struct Rng(pub u64);\n1273\t\n1274\timpl Rng {\n1275\t    pub fn new(seed: u64) -> Rng {\n1276\t        Rng(seed | 1)\n1277\t    }\n1278\t    pub fn next_u64(&mut self) -> u64 {\n1279\t        let mut x = self.0;\n1280\t        x ^= x << 13;\n1281\t        x ^= x >> 7;\n1282\t        x ^= x << 17;\n1283\t        self.0 = x;\n1284\t        x\n1285\t    }\n1286\t    pub fn next_u32(&mut self) -> u32 {\n1287\t        (self.next_u64() >> 32) as u32\n1288\t    }\n1289\t    pub fn below(&mut self, n: u32) -> u32 {\n1290\t        if n == 0 {\n1291\t            0\n1292\t        } else {\n1293\t            self.next_u32() % n\n1294\t        }\n1295\t    }\n1296\t    pub fn range(&mut self, lo: i64, hi: i64) -> i64 {\n1297\t        if hi <= lo {\n1298\t            lo\n1299\t        } else {\n1300\t            lo + (self.next_u64() % ((hi - lo) as u64)) as i64\n1301\t        }\n1302\t    }\n1303\t    /// arbitrary f64 including subnormals / inf / nan\n1304\t    pub fn f64_any(&mut self) -> f64 {\n1305\t        f64::from_bits(self.next_u64())\n1306\t    }\n1307\t    /// \"reasonable\" f64 in a range\n1308\t    pub fn f64_sane(&mut self) -> f64 {\n1309\t        let k = self.below(12);\n1310\t        match k {\n1311\t            0 => 0.0,\n1312\t            1 => -0.0,\n1313\t            2 => f64::INFINITY,\n1314\t            3 => f64::NEG_INFINITY,\n1315\t            4 => f64::NAN,\n1316\t            5 => (self.next_u32() as i32) as f64,\n1317\t            6 => (self.next_u64() as i64) as f64,\n1318\t            7 => self.next_u32() as f64 / 4096.0,\n1319\t            8 => self.f64_any(),\n1320\t            9 => (self.range(-1000, 1000)) as f64,\n1321\t            10 => (self.range(-1000, 1000)) as f64 + 0.5,\n1322\t            _ => {\n1323\t                let m = self.next_u64() & ((1u64 << 52) - 1);\n1324\t                let e = self.range(-40, 40) as i32;\n1325\t                (m as f64) * 2f64.powi(e)\n1326\t            }\n1327\t        }\n1328\t    }\n1329\t    pub fn ascii_string(&mut self, maxlen: usize) -> String {\n1330\t        let n = self.below(maxlen as u32 + 1) as usize;\n1331\t        (0..n)\n1332\t            .map(|_| {\n1333\t                let c = 0x20u8 + (self.below(0x5f) as u8);\n1334\t                c as char\n1335\t            })\n1336\t            .collect()\n1337\t    }\n1338\t    /// bytes that may or may not be valid utf-8 (never NUL)\n1339\t    pub fn raw_bytes(&mut self, maxlen: usize) -> Vec<u8> {\n1340\t        let n = self.below(maxlen as u32 + 1) as usize;\n1341\t        (0..n)\n1342\t            .map(|_| {\n1343\t                let b = (self.next_u32() & 0xff) as u8;\n1344\t                if b == 0 {\n1345\t                    1\n1346\t                } else {\n1347\t                    b\n1348\t                }\n1349\t            })\n1350\t            .collect()\n1351\t    }\n1352\t    pub fn unicode_string(&mut self, maxlen: usize) -> String {\n1353\t        let n = self.below(maxlen as u32 + 1) as usize;\n1354\t        let mut s = String::new();\n1355\t        for _ in 0..n {\n1356\t            loop {\n1357\t                let r = match self.below(5) {\n1358\t                    0 => self.below(0x80),\n1359\t                    1 => 0x80 + self.below(0x780),\n1360\t                    2 => 0x800 + self.below(0xf800),\n1361\t                    3 => 0x10000 + self.below(0x100000),\n1362\t                    _ => 0x20 + self.below(0x5f),\n1363\t                };\n1364\t                if r == 0 {\n1365\t                    continue;\n1366\t                }\n1367\t                if let Some(c) = char::from_u32(r) {\n1368\t                    s.push(c);\n1369\t                    break;\n1370\t                }\n1371\t            }\n1372\t        }\n1373\t        s\n1374\t    }\n1375\t}\n1376\t\n1377\t/* --------------------------------------------------- big-stack test runner */\n1378\t\n1379\t/// Both libraries use deep native recursion (`regexp.c` `match()` up to\n1380\t/// `REG_MAXREC` = 4096 frames, `jsparse.c` up to `JS_ASTLIMIT` = 400, and\n1381\t/// `jsrun.c` for nested calls). An unoptimised Rust build has considerably\n1382\t/// larger frames than the C build, so tests that drive those paths must run on\n1383\t/// a thread with a generous stack; otherwise the harness itself overflows\n1384\t/// before the library's own limit is reached.\n1385\tpub fn with_big_stack<F: FnOnce() + Send + 'static>(f: F) {\n1386\t    let h = std::thread::Builder::new()\n1387\t        .stack_size(512 * 1024 * 1024)\n1388\t        .spawn(f)\n1389\t        .expect(\"spawn big-stack thread\");\n1390\t    h.join().expect(\"big-stack thread panicked\");\n1391\t}\n1392\t"}]},"parent_tool_use_id":"toolu_bdrk_01VmbNeb2udNwZDvRGXHnnSV","session_id":"a62d17ad-8528-487e-8b6a-23ad0ded9ac2","uuid":"21e44bb4-a68c-4e26-a59b-b2945fbedab0","timestamp":"2026-08-23T11:34:08.236Z","subagent_type":"general-purpose","task_description":"Phase C error tests: runtime core"}
