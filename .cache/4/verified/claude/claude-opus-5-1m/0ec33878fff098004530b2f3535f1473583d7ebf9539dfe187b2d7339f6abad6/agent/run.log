t        )(j, idx, err)\n656\t    }\n657\t\n658\t    /* ---------------- error constructors (non-throwing) ---------------- */\n659\t    pub unsafe fn newerror(&self, name: &'static str, j: JS, msg: *const c_char) {\n660\t        let mut b = name.as_bytes().to_vec();\n661\t        b.push(0);\n662\t        let s: Symbol<unsafe extern \"C\" fn(JS, *const c_char)> = self\n663\t            .lib\n664\t            .get(&b)\n665\t            .unwrap_or_else(|e| panic!(\"{}: missing {}: {}\", self.name, name, e));\n666\t        (*s)(j, msg)\n667\t    }\n668\t    /// varargs error thrower - only safe inside a protected call\n669\t    pub unsafe fn throwerror(&self, name: &'static str, j: JS, fmt: *const c_char) {\n670\t        let mut b = name.as_bytes().to_vec();\n671\t        b.push(0);\n672\t        let s: Symbol<unsafe extern \"C\" fn(JS, *const c_char)> = self\n673\t            .lib\n674\t            .get(&b)\n675\t            .unwrap_or_else(|e| panic!(\"{}: missing {}: {}\", self.name, name, e));\n676\t        (*s)(j, fmt)\n677\t    }\n678\t    pub unsafe fn throwerror_s(&self, name: &'static str, j: JS, fmt: *const c_char, a: *const c_char) {\n679\t        let mut b = name.as_bytes().to_vec();\n680\t        b.push(0);\n681\t        let s: Symbol<unsafe extern \"C\" fn(JS, *const c_char, *const c_char)> = self\n682\t            .lib\n683\t            .get(&b)\n684\t            .unwrap_or_else(|e| panic!(\"{}: missing {}: {}\", self.name, name, e));\n685\t        (*s)(j, fmt, a)\n686\t    }\n687\t    pub unsafe fn throwerror_d(&self, name: &'static str, j: JS, fmt: *const c_char, a: c_int) {\n688\t        let mut b = name.as_bytes().to_vec();\n689\t        b.push(0);\n690\t        let s: Symbol<unsafe extern \"C\" fn(JS, *const c_char, c_int)> = self\n691\t            .lib\n692\t            .get(&b)\n693\t            .unwrap_or_else(|e| panic!(\"{}: missing {}: {}\", self.name, name, e));\n694\t        (*s)(j, fmt, a)\n695\t    }\n696\t\n697\t    /* ---------------- low level: numbers ---------------- */\n698\t    pub unsafe fn js_itoa(&self, buf: *mut c_char, a: c_int) -> *const c_char {\n699\t        sym!(\n700\t            self,\n701\t            \"js_itoa\",\n702\t            unsafe extern \"C\" fn(*mut c_char, c_int) -> *const c_char\n703\t        )(buf, a)\n704\t    }\n705\t    pub unsafe fn js_strtod(&self, s: *const c_char, ep: *mut *mut c_char) -> f64 {\n706\t        sym!(\n707\t            self,\n708\t            \"js_strtod\",\n709\t            unsafe extern \"C\" fn(*const c_char, *mut *mut c_char) -> f64\n710\t        )(s, ep)\n711\t    }\n712\t    pub unsafe fn js_strtol(&self, s: *const c_char, ep: *mut *mut c_char, radix: c_int) -> f64 {\n713\t        sym!(\n714\t            self,\n715\t            \"js_strtol\",\n716\t            unsafe extern \"C\" fn(*const c_char, *mut *mut c_char, c_int) -> f64\n717\t        )(s, ep, radix)\n718\t    }\n719\t    pub unsafe fn js_stringtofloat(&self, s: *const c_char, ep: *mut *mut c_char) -> f64 {\n720\t        sym!(\n721\t            self,\n722\t            \"js_stringtofloat\",\n723\t            unsafe extern \"C\" fn(*const c_char, *mut *mut c_char) -> f64\n724\t        )(s, ep)\n725\t    }\n726\t    pub unsafe fn js_grisu2(&self, v: f64, buf: *mut c_char, k: *mut c_int) -> c_int {\n727\t        sym!(\n728\t            self,\n729\t            \"js_grisu2\",\n730\t            unsafe extern \"C\" fn(f64, *mut c_char, *mut c_int) -> c_int\n731\t        )(v, buf, k)\n732\t    }\n733\t    pub unsafe fn js_fmtexp(&self, p: *mut c_char, e: c_int) {\n734\t        sym!(self, \"js_fmtexp\", unsafe extern \"C\" fn(*mut c_char, c_int))(p, e)\n735\t    }\n736\t    pub unsafe fn jsV_numbertointeger(&self, n: f64) -> c_int {\n737\t        sym!(self, \"jsV_numbertointeger\", unsafe extern \"C\" fn(f64) -> c_int)(n)\n738\t    }\n739\t    pub unsafe fn jsV_numbertoint32(&self, n: f64) -> c_int {\n740\t        sym!(self, \"jsV_numbertoint32\", unsafe extern \"C\" fn(f64) -> c_int)(n)\n741\t    }\n742\t    pub unsafe fn jsV_numbertouint32(&self, n: f64) -> c_uint {\n743\t        sym!(self, \"jsV_numbertouint32\", unsafe extern \"C\" fn(f64) -> c_uint)(n)\n744\t    }\n745\t    pub unsafe fn jsV_numbertoint16(&self, n: f64) -> c_short {\n746\t        sym!(self, \"jsV_numbertoint16\", unsafe extern \"C\" fn(f64) -> c_short)(n)\n747\t    }\n748\t    pub unsafe fn jsV_numbertouint16(&self, n: f64) -> c_ushort {\n749\t        sym!(\n750\t            self,\n751\t            \"jsV_numbertouint16\",\n752\t            unsafe extern \"C\" fn(f64) -> c_ushort\n753\t        )(n)\n754\t    }\n755\t    pub unsafe fn jsV_numbertostring(&self, j: JS, buf: *mut c_char, n: f64) -> *const c_char {\n756\t        sym!(\n757\t            self,\n758\t            \"jsV_numbertostring\",\n759\t            unsafe extern \"C\" fn(JS, *mut c_char, f64) -> *const c_char\n760\t        )(j, buf, n)\n761\t    }\n762\t    pub unsafe fn jsV_stringtonumber(&self, j: JS, s: *const c_char) -> f64 {\n763\t        sym!(\n764\t            self,\n765\t            \"jsV_stringtonumber\",\n766\t            unsafe extern \"C\" fn(JS, *const c_char) -> f64\n767\t        )(j, s)\n768\t    }\n769\t\n770\t    /* ---------------- low level: utf ---------------- */\n771\t    pub unsafe fn jsU_chartorune(&self, rune: *mut Rune, s: *const c_char) -> c_int {\n772\t        sym!(\n773\t            self,\n774\t            \"jsU_chartorune\",\n775\t            unsafe extern \"C\" fn(*mut Rune, *const c_char) -> c_int\n776\t        )(rune, s)\n777\t    }\n778\t    pub unsafe fn jsU_runetochar(&self, s: *mut c_char, rune: *const Rune) -> c_int {\n779\t        sym!(\n780\t            self,\n781\t            \"jsU_runetochar\",\n782\t            unsafe extern \"C\" fn(*mut c_char, *const Rune) -> c_int\n783\t        )(s, rune)\n784\t    }\n785\t    pub unsafe fn jsU_runelen(&self, c: c_int) -> c_int {\n786\t        sym!(self, \"jsU_runelen\", unsafe extern \"C\" fn(c_int) -> c_int)(c)\n787\t    }\n788\t    pub unsafe fn rune_pred(&self, name: &'static str, c: Rune) -> c_int {\n789\t        let mut b = name.as_bytes().to_vec();\n790\t        b.push(0);\n791\t        let s: Symbol<unsafe extern \"C\" fn(Rune) -> c_int> = self\n792\t            .lib\n793\t            .get(&b)\n794\t            .unwrap_or_else(|e| panic!(\"{}: missing {}: {}\", self.name, name, e));\n795\t        (*s)(c)\n796\t    }\n797\t    pub unsafe fn rune_full(&self, name: &'static str, c: Rune) -> *const Rune {\n798\t        let mut b = name.as_bytes().to_vec();\n799\t        b.push(0);\n800\t        let s: Symbol<unsafe extern \"C\" fn(Rune) -> *const Rune> = self\n801\t            .lib\n802\t            .get(&b)\n803\t            .unwrap_or_else(|e| panic!(\"{}: missing {}: {}\", self.name, name, e));\n804\t        (*s)(c)\n805\t    }\n806\t    pub unsafe fn js_utflen(&self, s: *const c_char) -> c_int {\n807\t        sym!(self, \"js_utflen\", unsafe extern \"C\" fn(*const c_char) -> c_int)(s)\n808\t    }\n809\t    pub unsafe fn js_utfptrtoidx(&self, s: *const c_char, p: *const c_char) -> c_int {\n810\t        sym!(\n811\t            self,\n812\t            \"js_utfptrtoidx\",\n813\t            unsafe extern \"C\" fn(*const c_char, *const c_char) -> c_int\n814\t        )(s, p)\n815\t    }\n816\t    pub unsafe fn js_runeat(&self, j: JS, s: *const c_char, i: c_int) -> c_int {\n817\t        sym!(\n818\t            self,\n819\t            \"js_runeat\",\n820\t            unsafe extern \"C\" fn(JS, *const c_char, c_int) -> c_int\n821\t        )(j, s, i)\n822\t    }\n823\t    pub unsafe fn js_isarrayindex(&self, j: JS, s: *const c_char, idx: *mut c_int) -> c_int {\n824\t        sym!(\n825\t            self,\n826\t            \"js_isarrayindex\",\n827\t            unsafe extern \"C\" fn(JS, *const c_char, *mut c_int) -> c_int\n828\t        )(j, s, idx)\n829\t    }\n830\t\n831\t    /* ---------------- low level: lexer helpers ---------------- */\n832\t    pub unsafe fn int_pred(&self, name: &'static str, c: c_int) -> c_int {\n833\t        let mut b = name.as_bytes().to_vec();\n834\t        b.push(0);\n835\t        let s: Symbol<unsafe extern \"C\" fn(c_int) -> c_int> = self\n836\t            .lib\n837\t            .get(&b)\n838\t            .unwrap_or_else(|e| panic!(\"{}: missing {}: {}\", self.name, name, e));\n839\t        (*s)(c)\n840\t    }\n841\t    pub unsafe fn jsY_tokenstring(&self, t: c_int) -> *const c_char {\n842\t        sym!(\n843\t            self,\n844\t            \"jsY_tokenstring\",\n845\t            unsafe extern \"C\" fn(c_int) -> *const c_char\n846\t        )(t)\n847\t    }\n848\t    pub unsafe fn jsY_findword(\n849\t        &self,\n850\t        s: *const c_char,\n851\t        list: *const *const c_char,\n852\t        num: c_int,\n853\t    ) -> c_int {\n854\t        sym!(\n855\t            self,\n856\t            \"jsY_findword\",\n857\t            unsafe extern \"C\" fn(*const c_char, *const *const c_char, c_int) -> c_int\n858\t        )(s, list, num)\n859\t    }\n860\t\n861\t    /* ---------------- low level: regexp ---------------- */\n862\t    pub unsafe fn js_regcomp(\n863\t        &self,\n864\t        pattern: *const c_char,\n865\t        cflags: c_int,\n866\t        errorp: *mut *const c_char,\n867\t    ) -> *mut c_void {\n868\t        sym!(\n869\t            self,\n870\t            \"js_regcomp\",\n871\t            unsafe extern \"C\" fn(*const c_char, c_int, *mut *const c_char) -> *mut c_void\n872\t        )(pattern, cflags, errorp)\n873\t    }\n874\t    pub unsafe fn js_regexec(\n875\t        &self,\n876\t        prog: *mut c_void,\n877\t        s: *const c_char,\n878\t        sub: *mut Resub,\n879\t        eflags: c_int,\n880\t    ) -> c_int {\n881\t        sym!(\n882\t            self,\n883\t            \"js_regexec\",\n884\t            unsafe extern \"C\" fn(*mut c_void, *const c_char, *mut Resub, c_int) -> c_int\n885\t        )(prog, s, sub, eflags)\n886\t    }\n887\t    pub unsafe fn js_regfree(&self, prog: *mut c_void) {\n888\t        sym!(self, \"js_regfree\", unsafe extern \"C\" fn(*mut c_void))(prog)\n889\t    }\n890\t    pub unsafe fn js_regcompx(\n891\t        &self,\n892\t        alloc: js_Alloc,\n893\t        ctx: *mut c_void,\n894\t        pattern: *const c_char,\n895\t        cflags: c_int,\n896\t        errorp: *mut *const c_char,\n897\t    ) -> *mut c_void {\n898\t        sym!(\n899\t            self,\n900\t            \"js_regcompx\",\n901\t            unsafe extern \"C\" fn(\n902\t                js_Alloc,\n903\t                *mut c_void,\n904\t                *const c_char,\n905\t                c_int,\n906\t                *mut *const c_char,\n907\t            ) -> *mut c_void\n908\t        )(alloc, ctx, pattern, cflags, errorp)\n909\t    }\n910\t    pub unsafe fn js_regfreex(&self, alloc: js_Alloc, ctx: *mut c_void, prog: *mut c_void) {\n911\t        sym!(\n912\t            self,\n913\t            \"js_regfreex\",\n914\t            unsafe extern \"C\" fn(js_Alloc, *mut c_void, *mut c_void)\n915\t        )(alloc, ctx, prog)\n916\t    }\n917\t\n918\t    /* ---------------- low level: intern / memory ---------------- */\n919\t    pub unsafe fn js_intern(&self, j: JS, s: *const c_char) -> *const c_char {\n920\t        sym!(\n921\t            self,\n922\t            \"js_intern\",\n923\t            unsafe extern \"C\" fn(JS, *const c_char) -> *const c_char\n924\t        )(j, s)\n925\t    }\n926\t    pub unsafe fn js_strdup(&self, j: JS, s: *const c_char) -> *mut c_char {\n927\t        sym!(\n928\t            self,\n929\t            \"js_strdup\",\n930\t            unsafe extern \"C\" fn(JS, *const c_char) -> *mut c_char\n931\t        )(j, s)\n932\t    }\n933\t    pub unsafe fn js_malloc(&self, j: JS, n: c_int) -> *mut c_void {\n934\t        sym!(self, \"js_malloc\", unsafe extern \"C\" fn(JS, c_int) -> *mut c_void)(j, n)\n935\t    }\n936\t    pub unsafe fn js_realloc(&self, j: JS, p: *mut c_void, n: c_int) -> *mut c_void {\n937\t        sym!(\n938\t            self,\n939\t            \"js_realloc\",\n940\t            unsafe extern \"C\" fn(JS, *mut c_void, c_int) -> *mut c_void\n941\t        )(j, p, n)\n942\t    }\n943\t    pub unsafe fn js_free(&self, j: JS, p: *mut c_void) {\n944\t        sym!(self, \"js_free\", unsafe extern \"C\" fn(JS, *mut c_void))(j, p)\n945\t    }\n946\t    pub unsafe fn jsS_dumpstrings(&self, j: JS) {\n947\t        sym!(self, \"jsS_dumpstrings\", unsafe extern \"C\" fn(JS))(j)\n948\t    }\n949\t}\n950\t\n951\t/* ------------------------------------------------------- the two libs */\n952\t\n953\tpub struct Pair {\n954\t    pub c: Lib,\n955\t    pub rs: Lib,\n956\t}\n957\t\n958\tpub fn libs() -> &'static Pair {\n959\t    use std::sync::OnceLock;\n960\t    static P: OnceLock<Pair> = OnceLock::new();\n961\t    P.get_or_init(|| Pair {\n962\t        c: Lib::open(\"C\", &c_so_path()),\n963\t        rs: Lib::open(\"RUST\", &rust_so_path()),\n964\t    })\n965\t}\n966\t\n967\t/* --------------------------------------------- current-library context */\n968\t\n969\tthread_local! {\n970\t    static CUR: Cell<*const Lib> = const { Cell::new(std::ptr::null()) };\n971\t    static OUT: RefCell<Vec<u8>> = const { RefCell::new(Vec::new()) };\n972\t}\n973\t\n974\tpub fn cur() -> &'static Lib {\n975\t    let p = CUR.with(|c| c.get());\n976\t    assert!(!p.is_null(), \"no current library set\");\n977\t    unsafe { &*p }\n978\t}\n979\t\n980\tpub fn set_cur(l: &Lib) {\n981\t    CUR.with(|c| c.set(l as *const Lib));\n982\t}\n983\t\n984\tpub fn out_clear() {\n985\t    OUT.with(|o| o.borrow_mut().clear());\n986\t}\n987\t\n988\tpub fn out_push(s: &[u8]) {\n989\t    OUT.with(|o| o.borrow_mut().extend_from_slice(s));\n990\t}\n991\t\n992\tpub fn out_take() -> String {\n993\t    OUT.with(|o| {\n994\t        let v = std::mem::take(&mut *o.borrow_mut());\n995\t        String::from_utf8_lossy(&v).into_owned()\n996\t    })\n997\t}\n998\t\n999\tpub fn cstr(s: &str) -> CString {\n1000\t    CString::new(s.replace('\\0', \"\")).unwrap()\n1001\t}\n1002\t\n1003\tpub unsafe fn from_c(p: *const c_char) -> String {\n1004\t    if p.is_null() {\n1005\t        \"<NULL>\".to_string()\n1006\t    } else {\n1007\t        String::from_utf8_lossy(CStr::from_ptr(p).to_bytes()).into_owned()\n1008\t    }\n1009\t}\n1010\t\n1011\t/// Format a double the way a test comparison wants it: exact bits, so that\n1012\t/// -0.0 / NaN payloads / every last mantissa bit is compared.\n1013\tpub fn fbits(x: f64) -> u64 {\n1014\t    x.to_bits()\n1015\t}\n1016\t\n1017\t/* ------------------------------------------------------- script drivers */\n1018\t\n1019\tpub unsafe extern \"C\" fn report_cb(_j: JS, msg: *const c_char) {\n1020\t    out_push(b\"[report] \");\n1021\t    if !msg.is_null() {\n1022\t        out_push(CStr::from_ptr(msg).to_bytes());\n1023\t    } else {\n1024\t        out_push(b\"<NULL>\");\n1025\t    }\n1026\t    out_push(b\"\\n\");\n1027\t}\n1028\t\n1029\t/// `print(...)` - joins arguments with a space using js_tostring.\n1030\tpub unsafe extern \"C\" fn print_cb(j: JS) {\n1031\t    let l = cur();\n1032\t    let top = l.js_gettop(j);\n1033\t    for i in 1..top {\n1034\t        if i > 1 {\n1035\t            out_push(b\" \");\n1036\t        }\n1037\t        let s = l.js_tostring(j, i);\n1038\t        if s.is_null() {\n1039\t            out_push(b\"<NULL>\");\n1040\t        } else {\n1041\t            out_push(CStr::from_ptr(s).to_bytes());\n1042\t        }\n1043\t    }\n1044\t    out_push(b\"\\n\");\n1045\t    l.js_pushundefined(j);\n1046\t}\n1047\t\n1048\t/// `repr(x)` - pushes the js_torepr of argument 1 (used to compare values).\n1049\tpub unsafe extern \"C\" fn repr_cb(j: JS) {\n1050\t    let l = cur();\n1051\t    let s = l.js_torepr(j, 1);\n1052\t    l.js_pushstring(j, s);\n1053\t}\n1054\t\n1055\t/// `dump(...)` - like print but uses js_torepr for exact value shape.\n1056\tpub unsafe extern \"C\" fn dump_cb(j: JS) {\n1057\t    let l = cur();\n1058\t    let top = l.js_gettop(j);\n1059\t    for i in 1..top {\n1060\t        if i > 1 {\n1061\t            out_push(b\" \");\n1062\t        }\n1063\t        let s = l.js_torepr(j, i);\n1064\t        if s.is_null() {\n1065\t            out_push(b\"<NULL>\");\n1066\t        } else {\n1067\t            out_push(CStr::from_ptr(s).to_bytes());\n1068\t        }\n1069\t    }\n1070\t    out_push(b\"\\n\");\n1071\t    l.js_pushundefined(j);\n1072\t}\n1073\t\n1074\tpub const PRINT: *const c_char = b\"print\\0\".as_ptr() as *const c_char;\n1075\tpub const DUMP: *const c_char = b\"dump\\0\".as_ptr() as *const c_char;\n1076\tpub const ERRSTR: *const c_char = b\"<throw>\\0\".as_ptr() as *const c_char;\n1077\tpub const FILENAME: *const c_char = b\"test.js\\0\".as_ptr() as *const c_char;\n1078\t\n1079\t/// Create a fresh state with `print` / `dump` installed and the report hook\n1080\t/// pointing into the per-thread output buffer.\n1081\tpub unsafe fn new_state(l: &Lib, flags: c_int) -> JS {\n1082\t    set_cur(l);\n1083\t    let j = l.js_newstate(None, std::ptr::null_mut(), flags);\n1084\t    assert!(!j.is_null(), \"{}: js_newstate returned NULL\", l.name);\n1085\t    l.js_setreport(j, Some(report_cb));\n1086\t    l.js_newcfunction(j, Some(print_cb), PRINT, 1);\n1087\t    l.js_setglobal(j, PRINT);\n1088\t    l.js_newcfunction(j, Some(dump_cb), DUMP, 1);\n1089\t    l.js_setglobal(j, DUMP);\n1090\t    j\n1091\t}\n1092\t\n1093\t#[derive(Debug, PartialEq, Eq, Clone)]\n1094\tpub struct EvalResult {\n1095\t    pub load_rc: c_int,\n1096\t    pub call_rc: c_int,\n1097\t    pub result: String,\n1098\t    pub out: String,\n1099\t    pub top: c_int,\n1100\t}\n1101\t\n1102\t/// Full pipeline through the low level entry points:\n1103\t/// js_ploadstring -> js_pushundefined -> js_pcall -> js_tryrepr\n1104\tpub fn eval(l: &Lib, flags: c_int, src: &str) -> EvalResult {\n1105\t    unsafe {\n1106\t        out_clear();\n1107\t        let j = new_state(l, flags);\n1108\t        let cs = cstr(src);\n1109\t        let load_rc = l.js_ploadstring(j, FILENAME, cs.as_ptr());\n1110\t        let mut call_rc = -999;\n1111\t        let result;\n1112\t        if load_rc == 0 {\n1113\t            l.js_pushundefined(j);\n1114\t            call_rc = l.js_pcall(j, 0);\n1115\t            result = from_c(l.js_tryrepr(j, -1, ERRSTR));\n1116\t            l.js_pop(j, 1);\n1117\t        } else {\n1118\t            result = from_c(l.js_tryrepr(j, -1, ERRSTR));\n1119\t            l.js_pop(j, 1);\n1120\t        }\n1121\t        let top = l.js_gettop(j);\n1122\t        l.js_freestate(j);\n1123\t        EvalResult {\n1124\t            load_rc,\n1125\t            call_rc,\n1126\t            result,\n1127\t            out: out_take(),\n1128\t            top,\n1129\t        }\n1130\t    }\n1131\t}\n1132\t\n1133\t/// The convenience one-shot wrapper.\n1134\tpub fn dostring(l: &Lib, flags: c_int, src: &str) -> (c_int, String) {\n1135\t    unsafe {\n1136\t        out_clear();\n1137\t        let j = new_state(l, flags);\n1138\t        let cs = cstr(src);\n1139\t        let rc = l.js_dostring(j, cs.as_ptr());\n1140\t        l.js_freestate(j);\n1141\t        (rc, out_take())\n1142\t    }\n1143\t}\n1144\t\n1145\t/// Differential assertion for a JS snippet through the low level pipeline.\n1146\tpub fn diff_eval(flags: c_int, src: &str) {\n1147\t    let p = libs();\n1148\t    let a = eval(&p.c, flags, src);\n1149\t    let b = eval(&p.rs, flags, src);\n1150\t    assert_eq!(a, b, \"eval divergence (flags={flags})\\nsrc: {src}\");\n1151\t}\n1152\t\n1153\t/// Differential assertion for js_dostring.\n1154\tpub fn diff_dostring(flags: c_int, src: &str) {\n1155\t    let p = libs();\n1156\t    let a = dostring(&p.c, flags, src);\n1157\t    let b = dostring(&p.rs, flags, src);\n1158\t    assert_eq!(a, b, \"dostring divergence (flags={flags})\\nsrc: {src}\");\n1159\t}\n1160\t\n1161\t/* ---------------------------------------------------- tiny prng (xorshift) */\n1162\t\n1163\tpub struct Rng(pub u64);\n1164\t\n1165\timpl Rng {\n1166\t    pub fn new(seed: u64) -> Rng {\n1167\t        Rng(seed | 1)\n1168\t    }\n1169\t    pub fn next_u64(&mut self) -> u64 {\n1170\t        let mut x = self.0;\n1171\t        x ^= x << 13;\n1172\t        x ^= x >> 7;\n1173\t        x ^= x << 17;\n1174\t        self.0 = x;\n1175\t        x\n1176\t    }\n1177\t    pub fn next_u32(&mut self) -> u32 {\n1178\t        (self.next_u64() >> 32) as u32\n1179\t    }\n1180\t    pub fn below(&mut self, n: u32) -> u32 {\n1181\t        if n == 0 {\n1182\t            0\n1183\t        } else {\n1184\t            self.next_u32() % n\n1185\t        }\n1186\t    }\n1187\t    pub fn range(&mut self, lo: i64, hi: i64) -> i64 {\n1188\t        if hi <= lo {\n1189\t            lo\n1190\t        } else {\n1191\t            lo + (self.next_u64() % ((hi - lo) as u64)) as i64\n1192\t        }\n1193\t    }\n1194\t    /// arbitrary f64 including subnormals / inf / nan\n1195\t    pub fn f64_any(&mut self) -> f64 {\n1196\t        f64::from_bits(self.next_u64())\n1197\t    }\n1198\t    /// \"reasonable\" f64 in a range\n1199\t    pub fn f64_sane(&mut self) -> f64 {\n1200\t        let k = self.below(12);\n1201\t        match k {\n1202\t            0 => 0.0,\n1203\t            1 => -0.0,\n1204\t            2 => f64::INFINITY,\n1205\t            3 => f64::NEG_INFINITY,\n1206\t            4 => f64::NAN,\n1207\t            5 => (self.next_u32() as i32) as f64,\n1208\t            6 => (self.next_u64() as i64) as f64,\n1209\t            7 => self.next_u32() as f64 / 4096.0,\n1210\t            8 => self.f64_any(),\n1211\t            9 => (self.range(-1000, 1000)) as f64,\n1212\t            10 => (self.range(-1000, 1000)) as f64 + 0.5,\n1213\t            _ => {\n1214\t                let m = self.next_u64() & ((1u64 << 52) - 1);\n1215\t                let e = self.range(-40, 40) as i32;\n1216\t                (m as f64) * 2f64.powi(e)\n1217\t            }\n1218\t        }\n1219\t    }\n1220\t    pub fn ascii_string(&mut self, maxlen: usize) -> String {\n1221\t        let n = self.below(maxlen as u32 + 1) as usize;\n1222\t        (0..n)\n1223\t            .map(|_| {\n1224\t                let c = 0x20u8 + (self.below(0x5f) as u8);\n1225\t                c as char\n1226\t            })\n1227\t            .collect()\n1228\t    }\n1229\t    /// bytes that may or may not be valid utf-8 (never NUL)\n1230\t    pub fn raw_bytes(&mut self, maxlen: usize) -> Vec<u8> {\n1231\t        let n = self.below(maxlen as u32 + 1) as usize;\n1232\t        (0..n)\n1233\t            .map(|_| {\n1234\t                let b = (self.next_u32() & 0xff) as u8;\n1235\t                if b == 0 {\n1236\t                    1\n1237\t                } else {\n1238\t                    b\n1239\t                }\n1240\t            })\n1241\t            .collect()\n1242\t    }\n1243\t    pub fn unicode_string(&mut self, maxlen: usize) -> String {\n1244\t        let n = self.below(maxlen as u32 + 1) as usize;\n1245\t        let mut s = String::new();\n1246\t        for _ in 0..n {\n1247\t            loop {\n1248\t                let r = match self.below(5) {\n1249\t                    0 => self.below(0x80),\n1250\t                    1 => 0x80 + self.below(0x780),\n1251\t                    2 => 0x800 + self.below(0xf800),\n1252\t                    3 => 0x10000 + self.below(0x100000),\n1253\t                    _ => 0x20 + self.below(0x5f),\n1254\t                };\n1255\t                if r == 0 {\n1256\t                    continue;\n1257\t                }\n1258\t                if let Some(c) = char::from_u32(r) {\n1259\t                    s.push(c);\n1260\t                    break;\n1261\t                }\n1262\t            }\n1263\t        }\n1264\t        s\n1265\t    }\n1266\t}\n1267\t\n1268\t/* --------------------------------------------------- big-stack test runner */\n1269\t\n1270\t/// Both libraries use deep native recursion (`regexp.c` `match()` up to\n1271\t/// `REG_MAXREC` = 4096 frames, `jsparse.c` up to `JS_ASTLIMIT` = 400, and\n1272\t/// `jsrun.c` for nested calls). An unoptimised Rust build has considerably\n1273\t/// larger frames than the C build, so tests that drive those paths must run on\n1274\t/// a thread with a generous stack; otherwise the harness itself overflows\n1275\t/// before the library's own limit is reached.\n1276\tpub fn with_big_stack<F: FnOnce() + Send + 'static>(f: F) {\n1277\t    let h = std::thread::Builder::new()\n1278\t        .stack_size(512 * 1024 * 1024)\n1279\t        .spawn(f)\n1280\t        .expect(\"spawn big-stack thread\");\n1281\t    h.join().expect(\"big-stack thread panicked\");\n1282\t}\n1283\t"}]},"parent_tool_use_id":"toolu_bdrk_01SSnq5WCrbjCp3GLxjJr9Qz","session_id":"a62d17ad-8528-487e-8b6a-23ad0ded9ac2","uuid":"df9d2e24-d49e-49d1-968d-772fa1e7edfa","timestamp":"2026-08-23T09:11:22.627Z","subagent_type":"general-purpose","task_description":"Write js_builtins differential tests"}
