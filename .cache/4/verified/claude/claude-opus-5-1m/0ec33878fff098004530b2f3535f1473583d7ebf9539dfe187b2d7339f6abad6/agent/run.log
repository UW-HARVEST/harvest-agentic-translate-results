{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01GBsMh7VBo5dxpdb2VVLckG","type":"tool_result","content":"1\t//! Phase B/C: differential tests for the exported jslex.c helpers and the two\n2\t//! lexer modes, plus js_intern / js_isarrayindex / js_strdup / js_malloc.\n3\t//! CONFIGS rows 180-206; ERRORS rows 1-64 of the jslex.c group.\n4\tmod common;\n5\tuse common::*;\n6\tuse std::ffi::{c_char, c_int, c_void, CStr};\n7\t\n8\t#[test]\n9\tfn t_char_classifiers() {\n10\t    let p = libs();\n11\t    unsafe {\n12\t        // C enums / int params accept any int, so sweep well past the ASCII range\n13\t        let mut vals: Vec<c_int> = (-300..600).collect();\n14\t        vals.extend([\n15\t            i32::MIN,\n16\t            i32::MIN + 1,\n17\t            -1,\n18\t            0,\n19\t            0x7f,\n20\t            0x80,\n21\t            0xff,\n22\t            0x100,\n23\t            0x2028,\n24\t            0x2029,\n25\t            0xa0,\n26\t            0xfeff,\n27\t            0x10ffff,\n28\t            i32::MAX,\n29\t            i32::MAX - 1,\n30\t        ]);\n31\t        for c in vals {\n32\t            for name in [\"jsY_iswhite\", \"jsY_isnewline\", \"jsY_ishex\", \"jsY_tohex\"] {\n33\t                assert_eq!(\n34\t                    p.c.int_pred(name, c),\n35\t                    p.rs.int_pred(name, c),\n36\t                    \"{name}({c})\"\n37\t                );\n38\t            }\n39\t        }\n40\t    }\n41\t}\n42\t\n43\t#[test]\n44\tfn t_tokenstring() {\n45\t    let p = libs();\n46\t    unsafe {\n47\t        // token ids run 0..~157; out-of-range must give the same \"<unknown>\"\n48\t        let mut vals: Vec<c_int> = (-50..600).collect();\n49\t        vals.extend([i32::MIN, i32::MAX, -1, 0, 255, 256, 1000, 65536]);\n50\t        for t in vals {\n51\t            let a = from_c(p.c.jsY_tokenstring(t));\n52\t            let b = from_c(p.rs.jsY_tokenstring(t));\n53\t            assert_eq!(a, b, \"jsY_tokenstring({t})\");\n54\t        }\n55\t    }\n56\t}\n57\t\n58\t#[test]\n59\tfn t_findword() {\n60\t    let p = libs();\n61\t    unsafe {\n62\t        // jsY_findword does a binary search over a sorted NUL-terminated list\n63\t        let words: Vec<&str> = vec![\n64\t            \"alpha\", \"bravo\", \"charlie\", \"delta\", \"echo\", \"foxtrot\", \"golf\", \"hotel\",\n65\t        ];\n66\t        let cs: Vec<std::ffi::CString> = words.iter().map(|w| cstr(w)).collect();\n67\t        let list: Vec<*const c_char> = cs.iter().map(|c| c.as_ptr()).collect();\n68\t        let mut probes: Vec<String> = words.iter().map(|s| s.to_string()).collect();\n69\t        probes.extend(\n70\t            [\n71\t                \"\", \"a\", \"z\", \"aa\", \"alph\", \"alphaa\", \"india\", \"Alpha\", \"ALPHA\", \"bravo \",\n72\t                \" bravo\", \"hotel\", \"hotels\", \"hote\",\n73\t            ]\n74\t            .iter()\n75\t            .map(|s| s.to_string()),\n76\t        );\n77\t        let mut rng = Rng::new(0x1e77);\n78\t        for _ in 0..3000 {\n79\t            probes.push(rng.ascii_string(8));\n80\t        }\n81\t        for probe in &probes {\n82\t            let ps = cstr(probe);\n83\t            // vary the list length, including 0 and 1 (empty / one / many)\n84\t            for n in 0..=list.len() {\n85\t                let a = p.c.jsY_findword(ps.as_ptr(), list.as_ptr(), n as c_int);\n86\t                let b = p.rs.jsY_findword(ps.as_ptr(), list.as_ptr(), n as c_int);\n87\t                assert_eq!(a, b, \"jsY_findword({probe:?}, n={n})\");\n88\t            }\n89\t        }\n90\t    }\n91\t}\n92\t\n93\t/// Drive both lexer modes end-to-end by parsing sources; the token stream is\n94\t/// observable through the resulting behaviour and the syntax-error messages.\n95\tfn lex_sources() -> Vec<String> {\n96\t    let mut v: Vec<String> = vec![];\n97\t    for s in [\n98\t        // numeric literal forms\n99\t        \"0\", \"1\", \"007\", \"0x1f\", \"0X1F\", \"0xdeadBEEF\", \"1e5\", \"1E5\", \"1e+5\", \"1e-5\",\n100\t        \".5\", \"5.\", \"5.5\", \"0.0\", \"1.e3\", \".5e3\", \"1_0\", \"0b11\", \"0o17\", \"09\", \"08.5\",\n101\t        \"0xg\", \"1e\", \"1e+\", \"0x\", \"1..2\", \"1.2.3\", \"3in\", \"3 in [3]\",\n102\t        // string literal forms and every escape\n103\t        \"'a'\", \"\\\"a\\\"\", \"''\", \"\\\"\\\"\", \"'\\\\n'\", \"'\\\\r'\", \"'\\\\t'\", \"'\\\\b'\", \"'\\\\f'\",\n104\t        \"'\\\\v'\", \"'\\\\0'\", \"'\\\\x41'\", \"'\\\\u0041'\", \"'\\\\u{41}'\", \"'\\\\\\\\'\", \"'\\\\''\",\n105\t        \"'\\\\\\\"'\", \"'\\\\a'\", \"'\\\\1'\", \"'\\\\8'\", \"'\\\\x'\", \"'\\\\xg1'\", \"'\\\\u12'\", \"'\\\\uzzzz'\",\n106\t        \"'a\\\\\\nb'\", \"'unterminated\", \"\\\"unterminated\", \"'a\\nb'\",\n107\t        // regexp literal vs division\n108\t        \"/a/\", \"/a/g\", \"/a/gi\", \"/a/gim\", \"/a/x\", \"/a/gg\", \"1/2\", \"a/b/c\",\n109\t        \"var re = /a/; 1/2\", \"/[/]/\", \"/\\\\//\", \"/a\", \"/*/\", \"//\", \"/ /\",\n110\t        \"x = y / z / w\", \"(1)/2/3\",\n111\t        // comments\n112\t        \"// line\", \"/* block */\", \"/* multi\\nline */\", \"/* unterminated\",\n113\t        \"1 // trailing\", \"1 /* c */ + 2\", \"<!-- html comment\", \"--> not a comment\",\n114\t        // operators, all multi-char forms\n115\t        \"a<=b\", \"a>=b\", \"a==b\", \"a!=b\", \"a===b\", \"a!==b\", \"a<<b\", \"a>>b\", \"a>>>b\",\n116\t        \"a+=b\", \"a-=b\", \"a*=b\", \"a/=b\", \"a%=b\", \"a<<=b\", \"a>>=b\", \"a>>>=b\",\n117\t        \"a&=b\", \"a|=b\", \"a^=b\", \"a&&b\", \"a||b\", \"a++\", \"a--\", \"++a\", \"--a\",\n118\t        \"a?b:c\", \"a,b\", \"a.b\", \"a[b]\", \"~a\", \"!a\", \"a%b\", \"a^b\", \"a&b\", \"a|b\",\n119\t        // keywords / reserved / future reserved\n120\t        \"var x\", \"function f(){}\", \"if(1){}else{}\", \"for(;;)break\", \"while(0);\",\n121\t        \"do;while(0)\", \"switch(1){case 1:break;default:}\", \"try{}catch(e){}\",\n122\t        \"try{}finally{}\", \"throw 1\", \"return\", \"new Object\", \"delete x\", \"void 0\",\n123\t        \"typeof x\", \"instanceof\", \"in\", \"this\", \"null\", \"true\", \"false\",\n124\t        \"with({}){}\", \"debugger\", \"class\", \"const\", \"enum\", \"export\", \"extends\",\n125\t        \"import\", \"super\", \"implements\", \"interface\", \"let\", \"package\", \"private\",\n126\t        \"protected\", \"public\", \"static\", \"yield\",\n127\t        // line terminators and whitespace\n128\t        \"1\\n2\", \"1\\r2\", \"1\\r\\n2\", \"1\\u{2028}2\", \"1\\u{2029}2\", \"1\\u{a0}2\",\n129\t        \"1\\u{feff}2\", \"1\\t2\", \"1\\u{b}2\", \"1\\u{c}2\",\n130\t        // identifiers\n131\t        \"abc\", \"_abc\", \"$abc\", \"a1\", \"\\u{e9}\", \"a\\u{e9}b\", \"\\\\u0041\", \"\\u{4e2d}\",\n132\t        // ASI cases\n133\t        \"return\\n1\", \"a=1\\nb=2\", \"a\\n++b\", \"throw\\n1\",\n134\t        // JSON mode (via JSON.parse)\n135\t        \"JSON.parse('1')\", \"JSON.parse('\\\"a\\\"')\", \"JSON.parse('[1,2]')\",\n136\t        \"JSON.parse('{\\\"a\\\":1}')\", \"JSON.parse('true')\", \"JSON.parse('false')\",\n137\t        \"JSON.parse('null')\", \"JSON.parse('-1.5e3')\", \"JSON.parse('\\\"\\\\\\\\u0041\\\"')\",\n138\t        \"JSON.parse('\\\"\\\\\\\\n\\\"')\", \"JSON.parse('01')\", \"JSON.parse('+1')\",\n139\t        \"JSON.parse('.5')\", \"JSON.parse('1.')\", \"JSON.parse(\\\"'a'\\\")\",\n140\t        \"JSON.parse('{a:1}')\", \"JSON.parse('[1,]')\", \"JSON.parse('{\\\"a\\\":1,}')\",\n141\t        \"JSON.parse('')\", \"JSON.parse('nul')\", \"JSON.parse('tru')\",\n142\t        \"JSON.parse('fals')\", \"JSON.parse('NaN')\", \"JSON.parse('Infinity')\",\n143\t        \"JSON.parse('\\\"\\\\\\\\x41\\\"')\", \"JSON.parse('\\\"\\\\\\\\uzzzz\\\"')\",\n144\t        \"JSON.parse('\\\"\\\\\\\\u00\\\"')\", \"JSON.parse('[')\", \"JSON.parse('{')\",\n145\t        \"JSON.parse('}')\", \"JSON.parse(']')\", \"JSON.parse('1 2')\",\n146\t        \"JSON.parse('\\\"unterminated')\",\n147\t    ] {\n148\t        v.push(s.to_string());\n149\t        v.push(format!(\"print({s})\"));\n150\t    }\n151\t    v\n152\t}\n153\t\n154\t#[test]\n155\tfn t_lexer_modes() {\n156\t    for src in lex_sources() {\n157\t        diff_dostring(0, &src);\n158\t        diff_dostring(JS_STRICT, &src);\n159\t        diff_eval(0, &src);\n160\t        diff_eval(JS_STRICT, &src);\n161\t    }\n162\t}\n163\t\n164\t#[test]\n165\tfn t_lexer_fuzz() {\n166\t    let mut rng = Rng::new(0x1E7F_1234_5678_9ABD);\n167\t    let toks = [\n168\t        \"1\", \"0x1f\", \"'s'\", \"\\\"s\\\"\", \"a\", \"+\", \"-\", \"*\", \"/\", \"%\", \"(\", \")\", \"{\", \"}\",\n169\t        \"[\", \"]\", \";\", \",\", \".\", \"?\", \":\", \"=\", \"==\", \"===\", \"!\", \"<\", \">\", \"<=\", \">=\",\n170\t        \"&&\", \"||\", \"++\", \"--\", \"~\", \"&\", \"|\", \"^\", \"<<\", \">>\", \">>>\", \"var\", \"function\",\n171\t        \"if\", \"else\", \"for\", \"while\", \"return\", \"new\", \"typeof\", \"delete\", \"void\", \"in\",\n172\t        \"instanceof\", \"this\", \"null\", \"true\", \"false\", \"/re/\", \"//c\\n\", \"/*c*/\", \"\\n\",\n173\t        \" \", \"\\t\", \"\\\\u0041\", \"$\", \"_\",\n174\t    ];\n175\t    for _ in 0..4000 {\n176\t        let n = 1 + rng.below(10) as usize;\n177\t        let src: String = (0..n)\n178\t            .map(|_| toks[rng.below(toks.len() as u32) as usize])\n179\t            .collect::<Vec<_>>()\n180\t            .join(\"\");\n181\t        diff_dostring(0, &src);\n182\t        diff_dostring(JS_STRICT, &src);\n183\t    }\n184\t}\n185\t\n186\t#[test]\n187\tfn t_intern_and_arrayindex() {\n188\t    let p = libs();\n189\t    unsafe {\n190\t        let jc = new_state(&p.c, 0);\n191\t        set_cur(&p.rs);\n192\t        let jr = new_state(&p.rs, 0);\n193\t        let mut names: Vec<String> = vec![\n194\t            \"\".into(),\n195\t            \"0\".into(),\n196\t            \"1\".into(),\n197\t            \"-1\".into(),\n198\t            \"+1\".into(),\n199\t            \"00\".into(),\n200\t            \"01\".into(),\n201\t            \"0.0\".into(),\n202\t            \"1.0\".into(),\n203\t            \" 1\".into(),\n204\t            \"1 \".into(),\n205\t            \"1e3\".into(),\n206\t            \"0x10\".into(),\n207\t            \"length\".into(),\n208\t            \"abc\".into(),\n209\t            \"4294967294\".into(),\n210\t            \"4294967295\".into(),\n211\t            \"4294967296\".into(),\n212\t            \"2147483647\".into(),\n213\t            \"2147483648\".into(),\n214\t            \"2147483649\".into(),\n215\t            \"9999999999\".into(),\n216\t            \"99999999999999999999\".into(),\n217\t            \"1e21\".into(),\n218\t            \"-0\".into(),\n219\t            \"NaN\".into(),\n220\t            \"Infinity\".into(),\n221\t        ];\n222\t        let mut rng = Rng::new(0xAB1E);\n223\t        for _ in 0..4000 {\n224\t            names.push(format!(\"{}\", rng.next_u32()));\n225\t        }\n226\t        for _ in 0..2000 {\n227\t            names.push(rng.ascii_string(12));\n228\t        }\n229\t        for _ in 0..500 {\n230\t            names.push(\"9\".repeat(1 + rng.below(24) as usize));\n231\t        }\n232\t        for name in &names {\n233\t            let cs = cstr(name);\n234\t            // js_isarrayindex\n235\t            let mut ia: c_int = -12345;\n236\t            let mut ib: c_int = -12345;\n237\t            set_cur(&p.c);\n238\t            let ra = p.c.js_isarrayindex(jc, cs.as_ptr(), &mut ia);\n239\t            set_cur(&p.rs);\n240\t            let rb = p.rs.js_isarrayindex(jr, cs.as_ptr(), &mut ib);\n241\t            assert_eq!((ra, ia), (rb, ib), \"js_isarrayindex({name:?})\");\n242\t            // js_intern must return equal *contents* and be idempotent\n243\t            set_cur(&p.c);\n244\t            let sa = p.c.js_intern(jc, cs.as_ptr());\n245\t            let sa2 = p.c.js_intern(jc, cs.as_ptr());\n246\t            set_cur(&p.rs);\n247\t            let sb = p.rs.js_intern(jr, cs.as_ptr());\n248\t            let sb2 = p.rs.js_intern(jr, cs.as_ptr());\n249\t            assert_eq!(from_c(sa), from_c(sb), \"js_intern({name:?})\");\n250\t            assert_eq!(sa, sa2, \"C js_intern not idempotent for {name:?}\");\n251\t            assert_eq!(sb, sb2, \"RUST js_intern not idempotent for {name:?}\");\n252\t        }\n253\t        set_cur(&p.c);\n254\t        p.c.js_freestate(jc);\n255\t        set_cur(&p.rs);\n256\t        p.rs.js_freestate(jr);\n257\t    }\n258\t}\n259\t\n260\t#[test]\n261\tfn t_strdup_malloc_realloc_free() {\n262\t    let p = libs();\n263\t    unsafe {\n264\t        for l in [&p.c, &p.rs] {\n265\t            set_cur(l);\n266\t            let j = new_state(l, 0);\n267\t            // js_strdup\n268\t            for s in [\"\", \"a\", \"hello\", &\"x\".repeat(1000)] {\n269\t                let cs = cstr(s);\n270\t                let d = l.js_strdup(j, cs.as_ptr());\n271\t                assert!(!d.is_null());\n272\t                assert_eq!(\n273\t                    CStr::from_ptr(d).to_bytes(),\n274\t                    cs.as_bytes(),\n275\t                    \"{}: js_strdup({s:?})\",\n276\t                    l.name\n277\t                );\n278\t                l.js_free(j, d as *mut c_void);\n279\t            }\n280\t            // js_malloc / js_realloc / js_free\n281\t            for n in [1, 8, 16, 4096, 65536] {\n282\t                let m = l.js_malloc(j, n);\n283\t                assert!(!m.is_null(), \"{}: js_malloc({n})\", l.name);\n284\t                let m2 = l.js_realloc(j, m, n * 2);\n285\t                assert!(!m2.is_null(), \"{}: js_realloc({n})\", l.name);\n286\t                l.js_free(j, m2);\n287\t            }\n288\t            // js_free(NULL) must be a no-op\n289\t            l.js_free(j, std::ptr::null_mut());\n290\t            // js_realloc(NULL, n) behaves like malloc\n291\t            let m = l.js_realloc(j, std::ptr::null_mut(), 32);\n292\t            assert!(!m.is_null());\n293\t            l.js_free(j, m);\n294\t            l.js_freestate(j);\n295\t        }\n296\t    }\n297\t}\n298\t\n299\t/// js_freestate(NULL) is an explicit no-op (ERRORS row 258).\n300\t#[test]\n301\tfn t_freestate_null() {\n302\t    let p = libs();\n303\t    unsafe {\n304\t        p.c.js_freestate(std::ptr::null_mut());\n305\t        p.rs.js_freestate(std::ptr::null_mut());\n306\t    }\n307\t}\n308\t"}]},"parent_tool_use_id":"toolu_bdrk_01AYMMGss6NtEjS6jc3DmLxb","session_id":"a62d17ad-8528-487e-8b6a-23ad0ded9ac2","uuid":"5ae410bc-9c9a-4b42-bfc6-7ad08bf0e53f","timestamp":"2026-08-23T11:35:03.268Z","subagent_type":"general-purpose","task_description":"Phase C error tests: parser/compiler"}
