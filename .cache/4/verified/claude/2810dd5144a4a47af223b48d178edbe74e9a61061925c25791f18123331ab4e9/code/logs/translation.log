" fn float2half(flt: f32) -> u16 {{\n    // Equivalent to the C union of `float` and `uint32_t`.\n    let n: u32 = flt.to_bits();\n    let j: u32 = (n >> 23) & 0x1ff;\n    let j = j as usize;\n\n    let base = M_BASE[j] as u32;\n    let mantissa = (n & 0x007f_ffff) >> M_SHIFT[j];\n\n    base.wrapping_add(mantissa) as u16\n}}\n'''.format(base=fmt(base,4,9), shift=fmt(shift,2,12))\n\nimport os\nos.makedirs('src', exist_ok=True)\nopen('src/lib.rs','w').write(rust)\nprint(\"wrote src/lib.rs\")\nEOF","description":"Extract C lookup tables and generate src/lib.rs"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":360,"cache_read_input_tokens":22366,"cache_creation":{"ephemeral_5m_input_tokens":360,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"4077f296-0fe8-47ae-b2a3-34d905ed7280","uuid":"cf7dc991-b14d-4e0e-b81c-005bde671ce6","timestamp":"2026-08-19T10:11:41.556Z"}
