micU64::new(u64::MAX);\n\n    std::thread::scope(|scope| {\n        for t in 0..threads {\n            let checked = &checked;\n            let first_bad = &first_bad;\n            scope.spawn(move || {\n                let start = t * chunk;\n                let end = ((t + 1) * chunk).min(DOMAIN);\n                let mut n = 0u64;\n                let mut bad = u64::MAX;\n                let mut i = start;\n                // Align each worker's start onto the stride grid.\n                if stride > 1 && i % stride != 0 {\n                    i += stride - (i % stride);\n                }\n                while i < end {\n                    let bits = i as u32;\n                    let x = f32::from_bits(bits);\n                    let c = unsafe { c_fn(x) };\n                    let r = unsafe { r_fn(x) };\n                    if c != r && bad == u64::MAX {\n                        bad = i;\n                    }\n                    n += 1;\n                    i += stride;\n                }\n                checked.fetch_add(n, Ordering::Relaxed);\n                if bad != u64::MAX {\n                    first_bad.fetch_min(bad, Ordering::Relaxed);\n                }\n            });\n        }\n    });\n\n    let bad = first_bad.load(Ordering::Relaxed);\n    if bad != u64::MAX {\n        let bits = bad as u32;\n        let x = f32::from_bits(bits);\n        let c = unsafe { c_fn(x) };\n        let r = unsafe { r_fn(x) };\n        panic!(\n            \"EXHAUSTIVE MISMATCH at bits=0x{bits:08X} (j={}, mant=0x{:06X}): \\\n             C=0x{c:04X} Rust=0x{r:04X}\",\n            (bits >> 23) & 0x1ff,\n            bits & 0x007f_ffff\n        );\n    }\n\n    let n = checked.load(Ordering::Relaxed);\n    let expected = if stride == 1 {\n        DOMAIN\n    } else {\n        DOMAIN / stride\n    };\n    assert_eq!(n, expected, \"exhaustive sweep did not cover the whole domain\");\n    eprintln!(\n        \"exhaustive: {n} inputs agreed bit-for-bit (stride={strid