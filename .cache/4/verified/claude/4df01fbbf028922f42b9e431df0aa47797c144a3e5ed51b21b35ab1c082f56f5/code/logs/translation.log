  return bad;\n}\n\nint main(int argc, char **argv) {\n    void *hc = dlopen(argv[1], RTLD_NOW), *hr = dlopen(argv[2], RTLD_NOW);\n    if (!hc || !hr) { printf(\"dlopen failed: %s\\n\", dlerror()); return 2; }\n    fn_t fc = (fn_t)dlsym(hc, \"flip_horizontal\");\n    fn_t fr = (fn_t)dlsym(hr, \"flip_horizontal\");\n    if (!fc || !fr) { printf(\"dlsym failed\\n\"); return 2; }\n\n    int fails = 0, cases = 0;\n    /* exhaustive small grid, incl. zero and negative dimensions */\n    for (int w = -3; w <= 12; ++w)\n        for (int h = -3; h <= 12; ++h) { fails += run_case(fc, fr, w, h, \"grid\"); cases++; }\n    /* larger / odd shapes */\n    int dims[][2] = {{1,1},{1,2},{2,1},{1,1000},{1000,1},{3,7},{7,3},{64,64},{65,63},{128,1},{255,17},{333,11},{16,4096}};\n    for (unsigned k = 0; k < sizeof(dims)/sizeof(dims[0]); ++k) { fails += run_case(fc, fr, dims[k][0], dims[k][1], \"shape\"); cases++; }\n    /* randomized */\n    for (int t = 0; t < 3000; ++t) {\n        int w = (int)(rnd() % 40), h = (int)(rnd() % 40);\n        fails += run_case(fc, fr, w, h, \"rand\"); cases++;\n    }\n    /* NULL pix with h<=1 or w<=0 => no dereference happens in C */\n    { cp_image_t a={0,0,NULL}, b={0,0,NULL}; fc(&a); fr(&b); cases++; }\n    { cp_image_t a={5,1,NULL}, b={5,1,NULL}; fc(&a); fr(&b); cases++; }\n    { cp_image_t a={0,10,NULL}, b={0,10,NULL}; fc(&a); fr(&b); cases++; }\n\n    printf(\"%d cases, %d mismatches -> %s\\n\", cases, fails, fails ? \"FAIL\" : \"ALL IDENTICAL\");\n    return fails != 0;\n}\nEOF\ncd /local/home/scheschb/.harvest/work/harvest-translate-OnA5Oy/translated_rust\ngcc -O2 -o \"$TMPDIR/cbuild/diff_test\" \"$TMPDIR/cbuild/diff_test.c\" -ldl && \"$TMPDIR/cbuild/diff_test\" \"$TMPDIR/cbuild/libc_ref.so\" ./target/release/libtranslated_rust.so","description":"Run differential test comparing C and Rust behavior"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":671,"cache_read_input_tokens":