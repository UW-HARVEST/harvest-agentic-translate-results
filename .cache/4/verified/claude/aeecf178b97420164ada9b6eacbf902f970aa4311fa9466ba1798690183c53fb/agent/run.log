elta = cv[i].wrapping_sub(base);","+                assert!(","+                    HASHES.contains(&delta),","+                    \"{label}: betagamma({}, {}, {}, {}) = {} but the model predicts \\","+                     {base} + hash; residual {delta} is not a valid compute_hash value\",","+                    q[0],","+                    q[1],","+                    q[2],","+                    q[3],","+                    cv[i]","+                );","+            }","+        }","     }","     cv"," }"]}],"userModified":false,"replaceAll":false}}
