name}\"\n    open('src/lib.rs','w').write(orig.replace(a,b,1))\n    build = subprocess.run(['cargo','build','--release'],capture_output=True,text=True)\n    if build.returncode != 0:\n        print(f\"{name:38s} BUILD-FAIL (mutation invalid)\"); continue\n    r = subprocess.run(['cargo','test','--release','--no-fail-fast'],capture_output=True,text=True)\n    fails = sorted(set(re.findall(r'^    (\\w+)$', r.stdout, re.M)))\n    print(f\"{name:38s} -> {'CAUGHT' if fails else '*** NOT CAUGHT ***'} by {len(fails)} tests: {fails[:5]}\")\nopen('src/lib.rs','w').write(orig)\nsubprocess.run(['cargo','build','--release'],capture_output=True)\nPY","description":"Mutation-test the differential suite"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1553,"cache_read_input_tokens":73500,"cache_creation":{"ephemeral_5m_input_tokens":1553,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"911e6967-59be-4797-86b8-7efd65a0dadb","uuid":"dc651f6c-539d-475e-b77a-f8c0cfa8de5f","timestamp":"2026-08-19T19:35:32.320Z"}
