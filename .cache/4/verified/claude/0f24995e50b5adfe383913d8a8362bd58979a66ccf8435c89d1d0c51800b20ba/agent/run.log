32\t    assert!(core::mem::size_of::<c2GJKCache>() == 36);\n133\t    assert!(core::mem::size_of::<c2Proxy>() == 72);\n134\t    assert!(core::mem::size_of::<c2sv>() == 36);\n135\t    assert!(core::mem::size_of::<c2Simplex>() == 152);\n136\t    assert!(core::mem::align_of::<c2Simplex>() == 4);\n137\t};\n138\t\n139\t// Constants spelled out in the C source.\n140\tconst C2_FLT_MAX: f32 = 3.402_823_466_385_288_598_117_041_834_845_169_25e+38;\n141\tconst C2_EPSILON: f32 = 1.192_092_895_507_812_5e-7;\n142\t\n143\textern \"C\" {\n144\t    fn malloc(size: usize) -> *mut c_void;\n145\t}\n146\t\n147\t// ---------------------------------------------------------------------------\n148\t// Bit-exact scalar arithmetic helpers\n149\t// ---------------------------------------------------------------------------\n150\t//\n151\t// IEEE-754 addition and multiplication are commutative for every operand pair\n152\t// except when *both* operands are NaN: x86 `addss`/`mulss` then return the\n153\t// destination operand (quieted).  The C compiler therefore fixes which NaN is\n154\t// propagated by its choice of destination register.  To be byte-identical with\n155\t// the reference C build we pin that choice explicitly instead of letting LLVM\n156\t// pick a (possibly commuted) operand order.\n157\t//\n158\t// `fmul(a, b)` / `fadd(a, b)` == `mulss a, b` / `addss a, b`, i.e. `a` is the\n159\t// destination and hence the preferred NaN.\n160\t\n161\t#[cfg(target_arch = \"x86_64\")]\n162\t#[inline(always)]\n163\tfn fmul(a: f32, b: f32) -> f32 {\n164\t    let mut d = a;\n165\t    unsafe {\n166\t        core::arch::asm!(\n167\t            \"mulss {d}, {s}\",\n168\t            d = inout(xmm_reg) d,\n169\t            s = in(xmm_reg) b,\n170\t            options(pure, nomem, nostack, preserves_flags),\n171\t        );\n172\t    }\n173\t    d\n174\t}\n175\t\n176\t#[cfg(target_arch = \"x86_64\")]\n177\t#[inline(always)]\n178\tfn fadd(a: f32, b: f32) -> f32 {\n179\t    let mut d = a;\n180\t    unsafe {\n181\t        core::arch::asm!(\n182\t            \"addss {d}, {s}\",\n183\t            d = inout(xmm_reg) d,\n184\t            s = in(xmm_reg) b,\n185\t            options(pure, nomem, nostack, preserves_flags),\n186\t        );\n187\t    }\n188\t    d\n189\t}\n190\t\n191\t#[cfg(not(target_arch = \"x86_64\"))]\n192\t#[inline(always)]\n193\tfn fmul(a: f32, b: f32) -> f32 {\n194\t    a * b\n195\t}\n196\t\n197\t#[cfg(not(target_arch = \"x86_64\"))]\n198\t#[inline(always)]\n199\tfn fadd(a: f32, b: f32) -> f32 {\n200\t    a + b\n201\t}\n202\t\n203\t// ---------------------------------------------------------------------------\n204\t// Vector / rotation / transform helpers\n205\t// ---------------------------------------------------------------------------\n206\t\n207\t#[unsafe(no_mangle)]\n208\tpub extern \"C\" fn c2V(x: f32, y: f32) -> c2v {\n209\t    c2v { x, y }\n210\t}\n211\t\n212\t#[unsafe(no_mangle)]\n213\tpub extern \"C\" fn c2Mulvs(mut a: c2v, b: f32) -> c2v {\n214\t    // `a.x *= b;` / `a.y *= b;`  (mulss dst = a.x / a.y)\n215\t    a.x = fmul(a.x, b);\n216\t    a.y = fmul(a.y, b);\n217\t    a\n218\t}\n219\t\n220\t#[unsafe(no_mangle)]\n221\tpub extern \"C\" fn c2Maxv(a: c2v, b: c2v) -> c2v {\n222\t    c2V(\n223\t        if a.x > b.x { a.x } else { b.x },\n224\t        if a.y > b.y { a.y } else { b.y },\n225\t    )\n226\t}\n227\t\n228\t#[unsafe(no_mangle)]\n229\tpub extern \"C\" fn c2Minv(a: c2v, b: c2v) -> c2v {\n230\t    c2V(\n231\t        if a.x < b.x { a.x } else { b.x },\n232\t        if a.y < b.y { a.y } else { b.y },\n233\t    )\n234\t}\n235\t\n236\t#[unsafe(no_mangle)]\n237\tpub extern \"C\" fn c2Clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n238\t    c2Maxv(lo, c2Minv(a, hi))\n239\t}\n240\t\n241\t#[unsafe(no_mangle)]\n242\tpub extern \"C\" fn c2Sub(mut a: c2v, b: c2v) -> c2v {\n243\t    a.x -= b.x;\n244\t    a.y -= b.y;\n245\t    a\n246\t}\n247\t\n248\t#[unsafe(no_mangle)]\n249\tpub extern \"C\" fn c2Dot(a: c2v, b: c2v) -> f32 {\n250\t    // `a.x * b.x + a.y * b.y`\n251\t    let p1 = fmul(a.x, b.x); // mulss dst = a.x\n252\t    let p2 = fmul(b.y, a.y); // mulss dst = b.y\n253\t    fadd(p2, p1) // addss dst = a.y * b.y term\n254\t}\n255\t\n256\t#[unsafe(no_mangle)]\n257\tpub extern \"C\" fn c2RotIdentity() -> c2r {\n258\t    c2r { c: 1.0f32, s: 0.0 }\n259\t}\n260\t\n261\t#[unsafe(no_mangle)]\n262\tpub extern \"C\" fn c2xIdentity() -> c2x {\n263\t    c2x {\n264\t        p: c2V(0.0, 0.0),\n265\t        r: c2RotIdentity(),\n266\t    }\n267\t}\n268\t\n269\t#[unsafe(no_mangle)]\n270\tpub unsafe extern \"C\" fn c2BBVerts(out: *mut c2v, bb: *mut c2AABB) {\n271\t    let bb = &*bb;\n272\t    *out.add(0) = bb.min;\n273\t    *out.add(1) = c2V(bb.max.x, bb.min.y);\n274\t    *out.add(2) = bb.max;\n275\t    *out.add(3) = c2V(bb.min.x, bb.max.y);\n276\t}\n277\t\n278\t#[unsafe(no_mangle)]\n279\tpub unsafe extern \"C\" fn c2MakeProxy(shape: *const c_void, type_: C2_TYPE, p: *mut c2Proxy) {\n280\t    match type_ {\n281\t        C2_TYPE_CIRCLE => {\n282\t            let c = shape as *mut c2Circle;\n283\t            (*p).radius = (*c).r;\n284\t            (*p).count = 1;\n285\t            (*p).verts[0] = (*c).p;\n286\t        }\n287\t        C2_TYPE_AABB => {\n288\t            let bb = shape as *mut c2AABB;\n289\t            (*p).radius = 0.0;\n290\t            (*p).count = 4;\n291\t            c2BBVerts((*p).verts.as_mut_ptr(), bb);\n292\t        }\n293\t        C2_TYPE_CAPSULE => {\n294\t            let c = shape as *mut c2Capsule;\n295\t            (*p).radius = (*c).r;\n296\t            (*p).count = 2;\n297\t            (*p).verts[0] = (*c).a;\n298\t            (*p).verts[1] = (*c).b;\n299\t        }\n300\t        // No `default` label in the C switch: nothing happens.\n301\t        _ => {}\n302\t    }\n303\t}\n304\t\n305\t#[unsafe(no_mangle)]\n306\tpub extern \"C\" fn c2Len(a: c2v) -> f32 {\n307\t    // sqrtf()\n308\t    c2Dot(a, a).sqrt()\n309\t}\n310\t\n311\t#[unsafe(no_mangle)]\n312\tpub extern \"C\" fn c2Det2(a: c2v, b: c2v) -> f32 {\n313\t    // `a.x * b.y - a.y * b.x`\n314\t    let t1 = fmul(b.y, a.x); // mulss dst = b.y\n315\t    let t2 = fmul(b.x, a.y); // mulss dst = b.x\n316\t    t1 - t2\n317\t}\n318\t\n319\t#[unsafe(no_mangle)]\n320\tpub unsafe extern \"C\" fn c2GJKSimplexMetric(s: *mut c2Simplex) -> f32 {\n321\t    let s = &*s;\n322\t    match s.count {\n323\t        2 => c2Len(c2Sub(s.verts[1].p, s.verts[0].p)),\n324\t        3 => c2Det2(\n325\t            c2Sub(s.verts[1].p, s.verts[0].p),\n326\t            c2Sub(s.verts[2].p, s.verts[0].p),\n327\t        ),\n328\t        // `default:` falls through to `case 1:` which returns 0.\n329\t        _ => 0.0,\n330\t    }\n331\t}\n332\t\n333\t#[unsafe(no_mangle)]\n334\tpub extern \"C\" fn c2Mulrv(a: c2r, b: c2v) -> c2v {\n335\t    // `c2V(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)`\n336\t    let x = fmul(b.x, a.c) - fmul(b.y, a.s);\n337\t    let y = fadd(fmul(a.s, b.x), fmul(b.y, a.c));\n338\t    c2V(x, y)\n339\t}\n340\t\n341\t#[unsafe(no_mangle)]\n342\tpub extern \"C\" fn c2Add(mut a: c2v, b: c2v) -> c2v {\n343\t    // `a.x += b.x;` / `a.y += b.y;`  (addss dst = b.x / b.y)\n344\t    a.x = fadd(b.x, a.x);\n345\t    a.y = fadd(b.y, a.y);\n346\t    a\n347\t}\n348\t\n349\t#[unsafe(no_mangle)]\n350\tpub extern \"C\" fn c2Mulxv(a: c2x, b: c2v) -> c2v {\n351\t    c2Add(c2Mulrv(a.r, b), a.p)\n352\t}\n353\t\n354\t// ---------------------------------------------------------------------------\n355\t// Simplex solvers\n356\t// ---------------------------------------------------------------------------\n357\t\n358\t#[unsafe(no_mangle)]\n359\tpub unsafe extern \"C\" fn c22(s: *mut c2Simplex) {\n360\t    let s = &mut *s;\n361\t    let a = s.verts[0].p;\n362\t    let b = s.verts[1].p;\n363\t    let u = c2Dot(b, c2Sub(b, a));\n364\t    let v = c2Dot(a, c2Sub(a, b));\n365\t    if v <= 0.0 {\n366\t        s.verts[0].u = 1.0f32;\n367\t        s.div = 1.0f32;\n368\t        s.count = 1;\n369\t    } else if u <= 0.0 {\n370\t        s.verts[0] = s.verts[1];\n371\t        s.verts[0].u = 1.0f32;\n372\t        s.div = 1.0f32;\n373\t        s.count = 1;\n374\t    } else {\n375\t        s.verts[0].u = u;\n376\t        s.verts[1].u = v;\n377\t        s.div = fadd(u, v); // addss dst = u\n378\t        s.count = 2;\n379\t    }\n380\t}\n381\t\n382\t#[unsafe(no_mangle)]\n383\tpub unsafe extern \"C\" fn c23(s: *mut c2Simplex) {\n384\t    let s = &mut *s;\n385\t    let a = s.verts[0].p;\n386\t    let b = s.verts[1].p;\n387\t    let c = s.verts[2].p;\n388\t    let uAB = c2Dot(b, c2Sub(b, a));\n389\t    let vAB = c2Dot(a, c2Sub(a, b));\n390\t    let uBC = c2Dot(c, c2Sub(c, b));\n391\t    let vBC = c2Dot(b, c2Sub(b, c));\n392\t    let uCA = c2Dot(a, c2Sub(a, c));\n393\t    let vCA = c2Dot(c, c2Sub(c, a));\n394\t    let area = c2Det2(c2Sub(b, a), c2Sub(c, a));\n395\t    // `c2Det2(..) * area`  (mulss dst = the c2Det2 result)\n396\t    let uABC = fmul(c2Det2(b, c), area);\n397\t    let vABC = fmul(c2Det2(c, a), area);\n398\t    let wABC = fmul(c2Det2(a, b), area);\n399\t    if vAB <= 0.0 && uCA <= 0.0 {\n400\t        s.verts[0].u = 1.0f32;\n401\t        s.div = 1.0f32;\n402\t        s.count = 1;\n403\t    } else if uAB <= 0.0 && vBC <= 0.0 {\n404\t        s.verts[0] = s.verts[1];\n405\t        s.verts[0].u = 1.0f32;\n406\t        s.div = 1.0f32;\n407\t        s.count = 1;\n408\t    } else if uBC <= 0.0 && vCA <= 0.0 {\n409\t        s.verts[0] = s.verts[2];\n410\t        s.verts[0].u = 1.0f32;\n411\t        s.div = 1.0f32;\n412\t        s.count = 1;\n413\t    } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {\n414\t        s.verts[0].u = uAB;\n415\t        s.verts[1].u = vAB;\n416\t        s.div = fadd(uAB, vAB); // addss dst = uAB\n417\t        s.count = 2;\n418\t    } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {\n419\t        s.verts[0] = s.verts[1];\n420\t        s.verts[1] = s.verts[2];\n421\t        s.verts[0].u = uBC;\n422\t        s.verts[1].u = vBC;\n423\t        s.div = fadd(uBC, vBC); // addss dst = uBC\n424\t        s.count = 2;\n425\t    } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {\n426\t        s.verts[1] = s.verts[0];\n427\t        s.verts[0] = s.verts[2];\n428\t        s.verts[0].u = uCA;\n429\t        s.verts[1].u = vCA;\n430\t        s.div = fadd(uCA, vCA); // addss dst = uCA\n431\t        s.count = 2;\n432\t    } else {\n433\t        s.verts[0].u = uABC;\n434\t        s.verts[1].u = vABC;\n435\t        s.verts[2].u = wABC;\n436\t        s.div = fadd(fadd(uABC, vABC), wABC); // left-to-right, addss dst = lhs\n437\t        s.count = 3;\n438\t    }\n439\t}\n440\t\n441\t#[unsafe(no_mangle)]\n442\tpub extern \"C\" fn c2Neg(a: c2v) -> c2v {\n443\t    c2V(-a.x, -a.y)\n444\t}\n445\t\n446\t#[unsafe(no_mangle)]\n447\tpub extern \"C\" fn c2Skew(a: c2v) -> c2v {\n448\t    c2v { x: -a.y, y: a.x }\n449\t}\n450\t\n451\t#[unsafe(no_mangle)]\n452\tpub extern \"C\" fn c2CCW90(a: c2v) -> c2v {\n453\t    c2v { x: a.y, y: -a.x }\n454\t}\n455\t\n456\t#[unsafe(no_mangle)]\n457\tpub unsafe extern \"C\" fn c2D(s: *mut c2Simplex) -> c2v {\n458\t    let s = &*s;\n459\t    match s.count {\n460\t        1 => c2Neg(s.verts[0].p),\n461\t        2 => {\n462\t            let ab = c2Sub(s.verts[1].p, s.verts[0].p);\n463\t            if c2Det2(ab, c2Neg(s.verts[0].p)) > 0.0 {\n464\t                return c2Skew(ab);\n465\t            }\n466\t            c2CCW90(ab)\n467\t        }\n468\t        // case 3 / default\n469\t        _ => c2V(0.0, 0.0),\n470\t    }\n471\t}\n472\t\n473\t#[unsafe(no_mangle)]\n474\tpub unsafe extern \"C\" fn c2Support(verts: *const c2v, count: c_int, d: c2v) -> c_int {\n475\t    let mut imax: c_int = 0;\n476\t    let mut dmax = c2Dot(*verts.add(0), d);\n477\t    let mut i: c_int = 1;\n478\t    while i < count {\n479\t        let dot = c2Dot(*verts.offset(i as isize), d);\n480\t        if dot > dmax {\n481\t            imax = i;\n482\t            dmax = dot;\n483\t        }\n484\t        i += 1;\n485\t    }\n486\t    imax\n487\t}\n488\t\n489\t#[unsafe(no_mangle)]\n490\tpub unsafe extern \"C\" fn c2Witness(s: *mut c2Simplex, a: *mut c2v, b: *mut c2v) {\n491\t    let s = &*s;\n492\t    let den = 1.0f32 / s.div;\n493\t    match s.count {\n494\t        1 => {\n495\t            *a = s.verts[0].sA;\n496\t            *b = s.verts[0].sB;\n497\t        }\n498\t        2 => {\n499\t            *a = c2Add(\n500\t                c2Mulvs(s.verts[0].sA, fmul(s.verts[0].u, den)),\n501\t                c2Mulvs(s.verts[1].sA, fmul(s.verts[1].u, den)),\n502\t            );\n503\t            *b = c2Add(\n504\t                c2Mulvs(s.verts[0].sB, fmul(s.verts[0].u, den)),\n505\t                c2Mulvs(s.verts[1].sB, fmul(s.verts[1].u, den)),\n506\t            );\n507\t        }\n508\t        3 => {\n509\t            *a = c2Add(\n510\t                c2Add(\n511\t                    c2Mulvs(s.verts[0].sA, fmul(s.verts[0].u, den)),\n512\t                    c2Mulvs(s.verts[1].sA, fmul(s.verts[1].u, den)),\n513\t                ),\n514\t                c2Mulvs(s.verts[2].sA, fmul(s.verts[2].u, den)),\n515\t            );\n516\t            *b = c2Add(\n517\t                c2Add(\n518\t                    c2Mulvs(s.verts[0].sB, fmul(s.verts[0].u, den)),\n519\t                    c2Mulvs(s.verts[1].sB, fmul(s.verts[1].u, den)),\n520\t                ),\n521\t                c2Mulvs(s.verts[2].sB, fmul(s.verts[2].u, den)),\n522\t            );\n523\t        }\n524\t        _ => {\n525\t            *a = c2V(0.0, 0.0);\n526\t            *b = c2V(0.0, 0.0);\n527\t        }\n528\t    }\n529\t}\n530\t\n531\t#[unsafe(no_mangle)]\n532\tpub extern \"C\" fn c2Div(a: c2v, b: f32) -> c2v {\n533\t    c2Mulvs(a, 1.0f32 / b)\n534\t}\n535\t\n536\t#[unsafe(no_mangle)]\n537\tpub extern \"C\" fn c2Norm(a: c2v) -> c2v {\n538\t    c2Div(a, c2Len(a))\n539\t}\n540\t\n541\t#[unsafe(no_mangle)]\n542\tpub unsafe extern \"C\" fn c2L(s: *mut c2Simplex) -> c2v {\n543\t    let s = &*s;\n544\t    let den = 1.0f32 / s.div;\n545\t    match s.count {\n546\t        1 => s.verts[0].p,\n547\t        2 => c2Add(\n548\t            c2Mulvs(s.verts[0].p, fmul(s.verts[0].u, den)),\n549\t            c2Mulvs(s.verts[1].p, fmul(s.verts[1].u, den)),\n550\t        ),\n551\t        _ => c2V(0.0, 0.0),\n552\t    }\n553\t}\n554\t\n555\t#[unsafe(no_mangle)]\n556\tpub extern \"C\" fn c2MulrvT(a: c2r, b: c2v) -> c2v {\n557\t    // `c2V(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y)`\n558\t    let x = fadd(fmul(a.c, b.x), fmul(b.y, a.s));\n559\t    let y = fadd(fmul(-a.s, b.x), fmul(b.y, a.c));\n560\t    c2V(x, y)\n561\t}\n562\t\n563\t// ---------------------------------------------------------------------------\n564\t// GJK\n565\t// ---------------------------------------------------------------------------\n566\t\n567\t#[unsafe(no_mangle)]\n568\tpub unsafe extern \"C\" fn c2GJK(\n569\t    A: *const c_void,\n570\t    typeA: C2_TYPE,\n571\t    ax_ptr: *const c2x,\n572\t    B: *const c_void,\n573\t    typeB: C2_TYPE,\n574\t    bx_ptr: *const c2x,\n575\t    outA: *mut c2v,\n576\t    outB: *mut c2v,\n577\t    use_radius: c_int,\n578\t    iterations: *mut c_int,\n579\t    cache: *mut c2GJKCache,\n580\t) -> f32 {\n581\t    let ax: c2x;\n582\t    let bx: c2x;\n583\t    if ax_ptr.is_null() {\n584\t        ax = c2xIdentity();\n585\t    } else {\n586\t        ax = *ax_ptr;\n587\t    }\n588\t    if bx_ptr.is_null() {\n589\t        bx = c2xIdentity();\n590\t    } else {\n591\t        bx = *bx_ptr;\n592\t    }\n593\t    let mut pA = c2Proxy::default();\n594\t    let mut pB = c2Proxy::default();\n595\t    c2MakeProxy(A, typeA, &mut pA);\n596\t    c2MakeProxy(B, typeB, &mut pB);\n597\t    let mut s = c2Simplex::default();\n598\t    // `c2sv* verts = &s.a;` -- raw pointer into the simplex, indexed exactly\n599\t    // like the C code does (unchecked).\n600\t    let verts: *mut c2sv = s.verts.as_mut_ptr();\n601\t    let mut cache_was_read: c_int = 0;\n602\t    if !cache.is_null() {\n603\t        let cache_was_good: c_int = ((*cache).count != 0) as c_int;\n604\t        if cache_was_good != 0 {\n605\t            let mut i: c_int = 0;\n606\t            while i < (*cache).count {\n607\t                let iA = *(*cache).iA.as_ptr().offset(i as isize);\n608\t                let iB = *(*cache).iB.as_ptr().offset(i as isize);\n609\t                let sA = c2Mulxv(ax, *pA.verts.as_ptr().offset(iA as isize));\n610\t                let sB = c2Mulxv(bx, *pB.verts.as_ptr().offset(iB as isize));\n611\t                let v: *mut c2sv = verts.offset(i as isize);\n612\t                (*v).iA = iA;\n613\t                (*v).sA = sA;\n614\t                (*v).iB = iB;\n615\t                (*v).sB = sB;\n616\t                (*v).p = c2Sub((*v).sB, (*v).sA);\n617\t                (*v).u = 0.0;\n618\t                i += 1;\n619\t            }\n620\t            s.count = (*cache).count;\n621\t            s.div = (*cache).div;\n622\t            let metric_old = (*cache).metric;\n623\t            let metric = c2GJKSimplexMetric(&mut s);\n624\t            let min_metric = if metric < metric_old { metric } else { metric_old };\n625\t            let max_metric = if metric > metric_old { metric } else { metric_old };\n626\t            if !(min_metric < fadd(max_metric, max_metric) && metric < -1.0e8f32) {\n627\t                cache_was_read = 1;\n628\t            }\n629\t        }\n630\t    }\n631\t    if cache_was_read == 0 {\n632\t        s.verts[0].iA = 0;\n633\t        s.verts[0].iB = 0;\n634\t        s.verts[0].sA = c2Mulxv(ax, pA.verts[0]);\n635\t        s.verts[0].sB = c2Mulxv(bx, pB.verts[0]);\n636\t        s.verts[0].p = c2Sub(s.verts[0].sB, s.verts[0].sA);\n637\t        s.verts[0].u = 1.0f32;\n638\t        s.div = 1.0f32;\n639\t        s.count = 1;\n640\t    }\n641\t    let mut saveA: [c_int; 3] = [0; 3];\n642\t    let mut saveB: [c_int; 3] = [0; 3];\n643\t    let mut save_count: c_int = 0;\n644\t    let mut d0: f32 = C2_FLT_MAX;\n645\t    let mut d1: f32 = C2_FLT_MAX;\n646\t    let mut iter: c_int = 0;\n647\t    let mut hit: c_int = 0;\n648\t    while iter < 20 {\n649\t        save_count = s.count;\n650\t        let mut i: c_int = 0;\n651\t        while i < save_count {\n652\t            *saveA.as_mut_ptr().offset(i as isize) = (*verts.offset(i as isize)).iA;\n653\t            *saveB.as_mut_ptr().offset(i as isize) = (*verts.offset(i as isize)).iB;\n654\t            i += 1;\n655\t        }\n656\t        match s.count {\n657\t            1 => {}\n658\t            2 => c22(&mut s),\n659\t            3 => c23(&mut s),\n660\t            _ => {}\n661\t        }\n662\t        if s.count == 3 {\n663\t            hit = 1;\n664\t            break;\n665\t        }\n666\t        let p = c2L(&mut s);\n667\t        d1 = c2Dot(p, p);\n668\t        if d1 > d0 {\n669\t            break;\n670\t        }\n671\t        d0 = d1;\n672\t        let d = c2D(&mut s);\n673\t        if c2Dot(d, d) < C2_EPSILON * C2_EPSILON {\n674\t            break;\n675\t        }\n676\t        let iA = c2Support(pA.verts.as_ptr(), pA.count, c2MulrvT(ax.r, c2Neg(d)));\n677\t        let sA = c2Mulxv(ax, *pA.verts.as_ptr().offset(iA as isize));\n678\t        let iB = c2Support(pB.verts.as_ptr(), pB.count, c2MulrvT(bx.r, d));\n679\t        let sB = c2Mulxv(bx, *pB.verts.as_ptr().offset(iB as isize));\n680\t        let v: *mut c2sv = verts.offset(s.count as isize);\n681\t        (*v).iA = iA;\n682\t        (*v).sA = sA;\n683\t        (*v).iB = iB;\n684\t        (*v).sB = sB;\n685\t        (*v).p = c2Sub((*v).sB, (*v).sA);\n686\t        let mut dup: c_int = 0;\n687\t        let mut i: c_int = 0;\n688\t        while i < save_count {\n689\t            if iA == *saveA.as_ptr().offset(i as isize) && iB == *saveB.as_ptr().offset(i as isize) {\n690\t                dup = 1;\n691\t                break;\n692\t            }\n693\t            i += 1;\n694\t        }\n695\t        if dup != 0 {\n696\t            break;\n697\t        }\n698\t        s.count += 1;\n699\t        iter += 1;\n700\t    }\n701\t    // Silence \"assigned but never read\" style dead stores; these mirror the