\t}\n    43\t\n    44\tstatic void print_house(house_t *house) {\n    45\t    printf(\"The house has %d floors, %d bedrooms, and %.1f bathrooms\\n\", house->floors, house->bedrooms, house->bathrooms);\n    46\t}\n    47\t\n    48\tvoid run(house_t *the_house, int extra_bedrooms) {\n    49\t    print_house(the_house);\n    50\t    add_floor(the_house);\n    51\t    print_house(the_house);\n    52\t    the_house->bathrooms += 1.0;\n    53\t    print_house(the_house);\n    54\t    add_bedrooms(the_house, extra_bedrooms);\n    55\t    print_house(the_house);\n    56\t}\n    57\t\n    58\tstatic bool parse_val(const char *str, int *val) {\n    59\t    errno = 0;\n    60\t    char *endp = (char *)str;\n    61\t    long tmp = strtol(str, &endp, 10);\n    62\t    if (endp != str && errno == 0 && tmp >= INT_MIN && tmp <= INT_MAX) {\n    63\t        *val = tmp;\n    64\t        return true;\n    65\t    } else {\n    66\t        return false;\n    67\t    }\n    68\t}\n    69\t\n    70\tint main() {\n    71\t    char in[100] = \"\";\n    72\t    fgets(in, sizeof(in), stdin);\n    73\t    int x;\n    74\t    if (parse_val(in, &x)) {\n    75\t        house_t the_house = {.floors = 2, .bedrooms = 5, .bathrooms = 2.5};\n    76\t        run(&the_house, x);\n    77\t        run(&the_house, x);\n    78\t    } else {\n    79\t        printf(\"An error occurred\\n\");\n    80\t    }\n    81\t    return 0;\n    82\t}\n","exit_code":0,"status":"completed"}}
