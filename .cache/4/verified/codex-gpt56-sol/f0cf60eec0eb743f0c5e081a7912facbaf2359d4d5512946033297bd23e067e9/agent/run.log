c2V(x: f32, y: f32) -> C2v {\n    83\t    C2v { x, y }\n    84\t}\n    85\t\n    86\t#[unsafe(no_mangle)]\n    87\tpub extern \"C\" fn c2Dot(a: C2v, b: C2v) -> f32 {\n    88\t    a.x * b.x + a.y * b.y\n    89\t}\n    90\t\n    91\t#[unsafe(no_mangle)]\n    92\tpub extern \"C\" fn c2Len(a: C2v) -> f32 {\n    93\t    c2Dot(a, a).sqrt()\n    94\t}\n    95\t\n    96\t#[unsafe(no_mangle)]\n    97\tpub extern \"C\" fn c2Add(mut a: C2v, b: C2v) -> C2v {\n    98\t    a.x += b.x;\n    99\t    a.y += b.y;\n   100\t    a\n   101\t}\n   102\t\n   103\t#[unsafe(no_mangle)]\n   104\tpub extern \"C\" fn c2Sub(mut a: C2v, b: C2v) -> C2v {\n   105\t    a.x -= b.x;\n   106\t    a.y -= b.y;\n   107\t    a\n   108\t}\n   109\t\n   110\t#[unsafe(no_mangle)]\n   111\tpub extern \"C\" fn c2Mulvs(mut a: C2v, b: f32) -> C2v {\n   112\t    a.x *= b;\n   113\t    a.y *= b;\n   114\t    a\n   115\t}\n   116\t\n   117\t#[unsafe(no_mangle)]\n   118\tpub extern \"C\" fn c2Div(a: C2v, b: f32) -> C2v {\n   119\t    c2Mulvs(a, 1.0 / b)\n   120\t}\n   121\t\n   122\t#[unsafe(no_mangle)]\n   123\tpub extern \"C\" fn c2Norm(a: C2v) -> C2v {\n   124\t    c2Div(a, c2Len(a))\n   125\t}\n   126\t\n   127\t#[unsafe(no_mangle)]\n   128\tpub extern \"C\" fn c2Minv(a: C2v, b: C2v) -> C2v {\n   129\t    c2V(\n   130\t        if a.x < b.x { a.x } else { b.x },\n   131\t        if a.y < b.y { a.y } else { b.y },\n   132\t    )\n   133\t}\n   134\t\n   135\t#[unsafe(no_mangle)]\n   136\tpub extern \"C\" fn c2Maxv(a: C2v, b: C2v) -> C2v {\n   137\t    c2V(\n   138\t        if a.x > b.x { a.x } else { b.x },\n   139\t        if a.y > b.y { a.y } else { b.y },\n   140\t    )\n   141\t}\n   142\t\n   143\t#[unsafe(no_mangle)]\n   144\tpub extern \"C\" fn c2Skew(a: C2v) -> C2v {\n   145\t    C2v { x: -a.y, y: a.x }\n   146\t}\n   147\t\n   148\t#[unsafe(no_mangle)]\n   149\tpub extern \"C\" fn c2Absv(a: C2v) -> C2v {\n   150\t    c2V(c2_abs(a.x), c2_abs(a.y))\n   151\t}\n   152\t\n   153\t#[unsafe(no_mangle)]\n   154\tpub extern \"C\" fn c2RaytoCircle(a: C2Ray, b: C2Circle, out: *mut C2Raycast) -> c_int {\n   155\t    let p = b.p;\n   156\t    let m = c2Sub(a.p, p);\n   157\t    let c = c2Dot(m, m) - b.r * b.r;\n   158\t    let projection = c2Dot(m, a.d);\n   159\t    let disc = projection * projection - c;\n   160\t    if disc < 0.0 {\n   161\t        return 0;\n   162\t    }\n   163\t    let t = -projection - disc.sqrt();\n   164\t    if t >= 0.0 && t <= a.t {\n   165\t        let impact = c2Add(a.p, c2Mulvs(a.d, t));\n   166\t        unsafe {\n   167\t            (*out).t = t;\n   168\t            (*out).n = c2Norm(c2Sub(impact, p));\n   169\t        }\n   170\t        return 1;\n   171\t    }\n   172\t    0\n   173\t}\n   174\t\n   175\t#[unsafe(no_mangle)]\n   176\tpub extern \"C\" fn c2AABBtoAABB(a: C2Aabb, b: C2Aabb) -> c_int {\n   177\t    let d0 = b.max.x < a.min.x;\n   178\t    let d1 = a.max.x < b.min.x;\n   179\t    let d2 = b.max.y < a.min.y;\n   180\t    let d3 = a.max.y < b.min.y;\n   181\t    (!(d0 | d1 | d2 | d3)) as c_int\n   182\t}\n   183\t\n   184\t#[inline]\n   185\tfn c2_signed_dist_point_to_plane_one_dimensional(p: f32, n: f32, d: f32) -> f32 {\n   186\t    p * n - d * n\n   187\t}\n   188\t\n   189\t#[inline]\n   190\tfn c2_ray_to_plane_one_dimensional(da: f32, db: f32) -> f32 {\n   191\t    if da < 0.0 {\n   192\t        0.0\n   193\t    } else if da * db > 0.0 {\n   194\t        1.0\n   195\t    } else {\n   196\t        let d = da - db;\n   197\t        if d != 0.0 { da / d } else { 0.0 }\n   198\t    }\n   199\t}\n   200\t\n   201\t#[unsafe(no_mangle)]\n   202\tpub extern \"C\" fn c2RaytoAABB(a: C2Ray, b: C2Aabb, out: *mut C2Raycast) -> c_int {\n   203\t    let p0 = a.p;\n   204\t    let p1 = c2Add(a.p, c2Mulvs(a.d, a.t));\n   205\t    let a_box = C2Aabb {\n   206\t        min: c2Minv(p0, p1),\n   207\t        max: c2Maxv(p0, p1),\n   208\t    };\n   209\t    if c2AABBtoAABB(a_box, b) == 0 {\n   210\t        return 0;\n   211\t    }\n   212\t    let ab = c2Sub(p1, p0);\n   213\t    let n = c2Skew(ab);\n   214\t    let abs_n = c2Absv(n);\n   215\t    let half_extents = c2Mulvs(c2Sub(b.max, b.min), 0.5);\n   216\t    let center_of_b_box = c2Mulvs(c2Add(b.min, b.max), 0.5);\n   217\t    let plane_dot = c2Dot(n, c2Sub(p0, center_of_b_box));\n   218\t    let d = c2_abs(plane_dot) - c2Dot(abs_n, half_extents);\n   219\t    if d > 0.0 {\n   220\t        return 0;\n   221\t    }\n   222\t    let da0 = c2_signed_dist_point_to_plane_one_dimensional(p0.x, -1.0, b.min.x);\n   223\t    let db0 = c2_signed_dist_point_to_plane_one_dimensional(p1.x, -1.0, b.min.x);\n   224\t    let da1 = c2_signed_dist_point_to_plane_one_dimensional(p0.x, 1.0, b.max.x);\n   225\t    let db1 = c2_signed_dist_point_to_plane_one_dimensional(p1.x, 1.0, b.max.x);\n   226\t    let da2 = c2_signed_dist_point_to_plane_one_dimensional(p0.y, -1.0, b.min.y);\n   227\t    let db2 = c2_signed_dist_point_to_plane_one_dimensional(p1.y, -1.0, b.min.y);\n   228\t    let da3 = c2_signed_dist_point_to_plane_one_dimensional(p0.y, 1.0, b.max.y);\n   229\t    let db3 = c2_signed_dist_point_to_plane_one_dimensional(p1.y, 1.0, b.max.y);\n   230\t    let mut t0 = c2_ray_to_plane_one_dimensional(da0, db0);\n   231\t    let mut t1 = c2_ray_to_plane_one_dimensional(da1, db1);\n   232\t    let mut t2 = c2_ray_to_plane_one_dimensional(da2, db2);\n   233\t    let mut t3 = c2_ray_to_plane_one_dimensional(da3, db3);\n   234\t    let hit0 = t0 <= 1.0;\n   235\t    let hit1 = t1 <= 1.0;\n   236\t    let hit2 = t2 <= 1.0;\n   237\t    let hit3 = t3 <= 1.0;\n   238\t    if hit0 | hit1 | hit2 | hit3 {\n   239\t        t0 = (hit0 as c_int) as f32 * t0;\n   240\t        t1 = (hit1 as c_int) as f32 * t1;\n   241\t        t2 = (hit2 as c_int) as f32 * t2;\n   242\t        t3 = (hit3 as c_int) as f32 * t3;\n   243\t        unsafe {\n   244\t            if t0 >= t1 && t0 >= t2 && t0 >= t3 {\n   245\t                (*out).t = t0 * a.t;\n   246\t                (*out).n = c2V(-1.0, 0.0);\n   247\t            } else if t1 >= t0 && t1 >= t2 && t1 >= t3 {\n   248\t                (*out).t = t1 * a.t;\n   249\t                (*out).n = c2V(1.0, 0.0);\n   250\t            } else if t2 >= t0 && t2 >= t1 && t2 >= t3 {\n   251\t                (*out).t = t2 * a.t;\n   252\t                (*out).n = c2V(0.0, -1.0);\n   253\t            } else {\n   254\t                (*out).t = t3 * a.t;\n   255\t                (*out).n = c2V(0.0, 1.0);\n   256\t            }\n   257\t        }\n   258\t        return 1;\n   259\t    }\n   260\t    0\n   261\t}\n   262\t\n   263\t#[unsafe(no_mangle)]\n   264\tpub extern \"C\" fn c2CCW90(a: C2v) -> C2v {\n   265\t    C2v { x: a.y, y: -a.x }\n   266\t}\n   267\t\n   268\t#[unsafe(no_mangle)]\n   269\tpub extern \"C\" fn c2MulmvT(a: C2m, b: C2v) -> C2v {\n   270\t    C2v {\n   271\t        x: a.x.x * b.x + a.x.y * b.y,\n   272\t        y: a.y.x * b.x + a.y.y * b.y,\n   273\t    }\n   274\t}\n   275\t\n   276\t#[unsafe(no_mangle)]\n   277\tpub extern \"C\" fn c2AABBtoPoint(a: C2Aabb, b: C2v) -> c_int {\n   278\t    let d0 = b.x < a.min.x;\n   279\t    let d1 = b.y < a.min.y;\n   280\t    let d2 = b.x > a.max.x;\n   281\t    let d3 = b.y > a.max.y;\n   282\t    (!(d0 | d1 | d2 | d3)) as c_int\n   283\t}\n   284\t\n   285\t#[unsafe(no_mangle)]\n   286\tpub extern \"C\" fn c2CircleToPoint(a: C2Circle, b: C2v) -> c_int {\n   287\t    let n = c2Sub(a.p, b);\n   288\t    let d2 = c2Dot(n, n);\n   289\t    (d2 < a.r * a.r) as c_int\n   290\t}\n   291\t\n   292\t#[unsafe(no_mangle)]\n   293\tpub extern \"C\" fn c2RaytoCapsule(a: C2Ray, b: C2Capsule, out: *mut C2Raycast) -> c_int {\n   294\t    let mut transform = C2m {\n   295\t        x: C2v { x: 0.0, y: 0.0 },\n   296\t        y: c2Norm(c2Sub(b.b, b.a)),\n   297\t    };\n   298\t    transform.x = c2CCW90(transform.y);\n   299\t    let cap_n = c2Sub(b.b, b.a);\n   300\t    let y_bb = c2MulmvT(transform, cap_n);\n   301\t    let y_ap = c2MulmvT(transform, c2Sub(a.p, b.a));\n   302\t    let y_ad = c2MulmvT(transform, a.d);\n   303\t    let y_ae = c2Add(y_ap, c2Mulvs(y_ad, a.t));\n   304\t    let capsule_bb = C2Aabb {\n   305\t        min: c2V(-b.r, 0.0),\n   306\t        max: c2V(b.r, y_bb.y),\n   307\t    };\n   308\t    unsafe {\n   309\t        (*out).n = c2Norm(cap_n);\n   310\t        (*out).t = 0.0;\n   311\t    }\n   312\t    if c2AABBtoPoint(capsule_bb, y_ap) != 0 {\n   313\t        return 1;\n   314\t    }\n   315\t\n   316\t    let capsule_a = C2Circle { p: b.a, r: b.r };\n   317\t    let capsule_b = C2Circle { p: b.b, r: b.r };\n   318\t    if c2CircleToPoint(capsule_a, a.p) != 0 {\n   319\t        return 1;\n   320\t    } else if c2CircleToPoint(capsule_b, a.p) != 0 {\n   321\t        return 1;\n   322\t    }\n   323\t\n   324\t    let min_abs_x = if c2_abs(y_ae.x) < c2_abs(y_ap.x) {\n   325\t        c2_abs(y_ae.x)\n   326\t    } else {\n   327\t        c2_abs(y_ap.x)\n   328\t    };\n   329\t    if y_ae.x * y_ap.x < 0.0 || min_abs_x < b.r {\n   330\t        let ca = C2Circle { p: b.a, r: b.r };\n   331\t        let cb = C2Circle { p: b.b, r: b.r };\n   332\t        if c2_abs(y_ap.x) < b.r {\n   333\t            if y_ap.y < 0.0 {\n   334\t                return c2RaytoCircle(a, ca, out);\n   335\t            }\n   336\t            return c2RaytoCircle(a, cb, out);\n   337\t        }\n   338\t\n   339\t        let c = if y_ap.x > 0.0 { b.r } else { -b.r };\n   340\t        let d = y_ae.x - y_ap.x;\n   341\t        let t = (c - y_ap.x) / d;\n   342\t        let y = y_ap.y + (y_ae.y - y_ap.y) * t;\n   343\t        if y <= 0.0 {\n   344\t            return c2RaytoCircle(a, ca, out);\n   345\t        }\n   346\t        if y >= y_bb.y {\n   347\t            return c2RaytoCircle(a, cb, out);\n   348\t        }\n   349\t        unsafe {\n   350\t            (*out).n = if c > 0.0 {\n   351\t                transform.x\n   352\t            } else {\n   353\t                c2Skew(transform.y)\n   354\t            };\n   355\t            (*out).t = t * a.t;\n   356\t        }\n   357\t        return 1;\n   358\t    }\n   359\t    0\n   360\t}\n   361\t\n   362\t#[unsafe(no_mangle)]\n   363\tpub extern \"C\" fn c2RotIdentity() -> C2r {\n   364\t    C2r { c: 1.0, s: 0.0 }\n   365\t}\n   366\t\n   367\t#[unsafe(no_mangle)]\n   368\tpub extern \"C\" fn c2xIdentity() -> C2x {\n   369\t    C2x {\n   370\t        p: c2V(0.0, 0.0),\n   371\t        r: c2RotIdentity(),\n   372\t    }\n   373\t}\n   374\t\n   375\t#[unsafe(no_mangle)]\n   376\tpub extern \"C\" fn c2Mulrv(a: C2r, b: C2v) -> C2v {\n   377\t    c2V(a.c * b.x - a.s * b.y, a.s * b.x + a.c * b.y)\n   378\t}\n   379\t\n   380\t#[unsafe(no_mangle)]\n   381\tpub extern \"C\" fn c2MulrvT(a: C2r, b: C2v) -> C2v {\n   382\t    c2V(a.c * b.x + a.s * b.y, -a.s * b.x + a.c * b.y)\n   383\t}\n   384\t\n   385\t#[unsafe(no_mangle)]\n   386\tpub extern \"C\" fn c2MulxvT(a: C2x, b: C2v) -> C2v {\n   387\t    c2MulrvT(a.r, c2Sub(b, a.p))\n   388\t}\n   389\t\n   390\t#[unsafe(no_mangle)]\n   391\tpub extern \"C\" fn c2RaytoPoly(\n   392\t    a: C2Ray,\n   393\t    b: *const C2Poly,\n   394\t    bx_ptr: *const C2x,\n   395\t    out: *mut C2Raycast,\n   396\t) -> c_int {\n   397\t    let bx = if bx_ptr.is_null() {\n   398\t        c2xIdentity()\n   399\t    } else {\n   400\t        unsafe { *bx_ptr }\n   401\t    };\n   402\t    let p = c2MulxvT(bx, a.p);\n   403\t    let d = c2MulrvT(bx.r, a.d);\n   404\t    let mut lo = 0.0;\n   405\t    let mut hi = a.t;\n   406\t    let mut index: c_int = !0;\n   407\t    let count = unsafe { (*b).count };\n   408\t    let mut i: c_int = 0;\n   409\t    while i < count {\n   410\t        let vertex = unsafe { *(*b).verts.as_ptr().offset(i as isize) };\n   411\t        let norm = unsafe { *(*b).norms.as_ptr().offset(i as isize) };\n   412\t        let num = c2Dot(norm, c2Sub(vertex, p));\n   413\t        let den = c2Dot(norm, d);\n   414\t        if den == 0.0 && num < 0.0 {\n   415\t            return 0;\n   416\t        } else {\n   417\t            if den < 0.0 && num < lo * den {\n   418\t                lo = num / den;\n   419\t                index = i;\n   420\t            } else if den > 0.0 && num < hi * den {\n   421\t                hi = num / den;\n   422\t            }\n   423\t        }\n   424\t        if hi < lo {\n   425\t            return 0;\n   426\t        }\n   427\t        i += 1;\n   428\t    }\n   429\t    if index != !0 {\n   430\t        let norm = unsafe { *(*b).norms.as_ptr().offset(index as isize) };\n   431\t        unsafe {\n   432\t            (*out).t = lo;\n   433\t            (*out).n = c2Mulrv(bx.r, norm);\n   434\t        }\n   435\t        return 1;\n   436\t    }\n   437\t    0\n   438\t}\n   439\t\n   440\t#[unsafe(no_mangle)]\n   441\tpub extern \"C\" fn c2CastRay(\n   442\t    a: C2Ray,\n   443\t    b: *const c_void,\n   444\t    bx: *const C2x,\n   445\t    type_b: c_int,\n   446\t    out: *mut C2Raycast,\n   447\t) -> c_int {\n   448\t    unsafe {\n   449\t        match type_b {\n   450\t            0 => c2RaytoCircle(a, *(b.cast::<C2Circle>()), out),\n   451\t            1 => c2RaytoAABB(a, *(b.cast::<C2Aabb>()), out),\n   452\t            2 => c2RaytoCapsule(a, *(b.cast::<C2Capsule>()), out),\n   453\t            3 => c2RaytoPoly(a, b.cast::<C2Poly>(), bx, out),\n   454\t            _ => 0,\n   455\t        }\n   456\t    }\n   457\t}\n   458\t\n   459\t#[unsafe(no_mangle)]\n   460\tpub extern \"C\" fn poly_ray(cast1: *mut C2Raycast, cast2: *mut C2Raycast) -> c_int {\n   461\t    let mut poly = C2Poly {\n   462\t        count: 4,\n   463\t        verts: [C2v { x: 0.0, y: 0.0 }; 8],\n   464\t        norms: [C2v { x: 0.0, y: 0.0 }; 8],\n   465\t    };\n   466\t    poly.verts[0] = c2V(0.875, -11.5);\n   467\t    poly.verts[1] = c2V(0.875, 11.5);\n   468\t    poly.verts[2] = c2V(-0.875, 11.5);\n   469\t    poly.verts[3] = c2V(-0.875, -11.5);\n   470\t    poly.norms[0] = c2V(1.0, 0.0);\n   471\t    poly.norms[1] = c2V(0.0, 1.0);\n   472\t    poly.nor