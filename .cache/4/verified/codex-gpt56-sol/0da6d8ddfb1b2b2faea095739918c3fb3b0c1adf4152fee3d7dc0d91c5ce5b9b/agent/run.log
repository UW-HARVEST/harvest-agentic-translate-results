e core::arch::x86_64::{_mm_cvttss_si32, _mm_set_ss};\n    55\t        _mm_cvttss_si32(_mm_set_ss(value))\n    56\t    }\n    57\t\n    58\t    #[cfg(not(any(target_arch = \"x86\", target_arch = \"x86_64\")))]\n    59\t    {\n    60\t        value as i32\n    61\t    }\n    62\t}\n","exit_code":0,"status":"completed"}}
