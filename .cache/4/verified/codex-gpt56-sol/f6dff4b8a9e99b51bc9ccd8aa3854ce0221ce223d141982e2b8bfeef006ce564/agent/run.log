ks_env = getenv(\"MAX_TASKS\");\n    40\t    manager->max_tasks = max_tasks_env ? atoi(max_tasks_env) : 10;\n    41\t    manager->task_count = 0;\n    42\t    manager->tasks = (Task *)malloc(manager->max_tasks * sizeof(Task));\n    43\t    if (!manager->tasks) {\n    44\t        log_error(\"Failed to allocate memory for tasks.\");\n    45\t        free(manager);\n    46\t        return NULL;\n    47\t    }\n    48\t\n    49\t    log_info(\"TaskManager created successfully.\");\n    50\t    return manager;\n    51\t}\n    52\t\n    53\tvoid add_task(TaskManager *manager, const char *description, int priority) {\n    54\t    if (manager->task_count >= manager->max_tasks) {\n    55\t        log_warning(\"Cannot add task: Maximum task limit reached.\");\n    56\t        return;\n    57\t    }\n    58\t\n    59\t    Task *task = &manager->tasks[manager->task_count++];\n    60\t    strncpy(task->description, description, sizeof(task->description) - 1);\n    61\t    task->description[sizeof(task->description) - 1] = '\\0';\n    62\t    task->priority = priority;\n    63\t\n    64\t    log_info(\"Task added successfully.\");\n    65\t}\n    66\t\n    67\tvoid print_tasks(const TaskManager *manager) {\n    68\t    printf(\"Tasks:\\n\");\n    69\t    for (int i = 0; i < manager->task_count; i++) {\n    70\t        printf(\"  [%d] %s (Priority: %d)\\n\", i + 1, manager->tasks[i].description, manager->tasks[i].priority);\n    71\t    }\n    72\t}\n    73\t\n    74\tvoid destroy_task_manager(TaskManager *manager) {\n    75\t    free(manager->tasks);\n    76\t    free(manager);\n    77\t    log_info(\"TaskManager destroyed successfully.\");\n    78\t}\n","exit_code":0,"status":"completed"}}
