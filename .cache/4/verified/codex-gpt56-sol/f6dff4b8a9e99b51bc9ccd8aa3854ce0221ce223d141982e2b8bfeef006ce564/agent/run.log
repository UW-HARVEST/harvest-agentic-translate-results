for tasks.\\0\";\n    44\tconst MANAGER_CREATED: &[u8] = b\"TaskManager created successfully.\\0\";\n    45\tconst TASK_LIMIT_REACHED: &[u8] = b\"Cannot add task: Maximum task limit reached.\\0\";\n    46\tconst TASK_ADDED: &[u8] = b\"Task added successfully.\\0\";\n    47\tconst MANAGER_DESTROYED: &[u8] = b\"TaskManager destroyed successfully.\\0\";\n    48\t\n    49\t/// # Safety\n    50\t///\n    51\t/// Calls that access the global logger must be externally synchronized.\n    52\t#[unsafe(no_mangle)]\n    53\tpub unsafe extern \"C\" fn initialize_logger() -> c_int {\n    54\t    let log_file_env = unsafe { getenv(LOG_FILE_ENV.as_ptr().cast()) };\n    55\t    let log_file_path = if log_file_env.is_null() {\n    56\t        DEFAULT_LOG_FILE.as_ptr().cast()\n    57\t    } else {\n    58\t        log_file_env.cast_const()\n    59\t    };\n    60\t\n    61\t    unsafe {\n    62\t        LOG_FILE = fopen(log_file_path, APPEND_MODE.as_ptr().cast());\n    63\t        if LOG_FILE.is_null() {\n    64\t            fprintf(\n    65\t                stderr,\n    66\t                c\"Failed to open log file: %s\\n\".as_ptr(),\n    67\t                log_file_path,\n    68\t            );\n    69\t            return -1;\n    70\t        }\n    71\t        log_info(LOGGER_INITIALIZED.as_ptr().cast());\n    72\t    }\n    73\t    0\n    74\t}\n    75\t\n    76\t/// # Safety\n    77\t///\n    78\t/// `message` must point to a valid NUL-terminated string. Logger access must be synchronized.\n    79\t#[unsafe(no_mangle)]\n    80\tpub unsafe extern \"C\" fn log_info(message: *const c_char) {\n    81\t    unsafe {\n    82\t        if !LOG_FILE.is_null() {\n    83\t            fprintf(LOG_FILE, c\"[INFO] %s\\n\".as_ptr(), message);\n    84\t        }\n    85\t    }\n    86\t}\n    87\t\n    88\t/// # Safety\n    89\t///\n    90\t/// `message` must point to a valid NUL-terminated string. Logger access must be synchronized.\n    91\t#[unsafe(no_mangle)]\n    92\tpub unsafe extern \"C