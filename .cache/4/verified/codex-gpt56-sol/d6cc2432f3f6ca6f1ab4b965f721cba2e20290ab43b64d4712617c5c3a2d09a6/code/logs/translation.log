1;\r\n    36\t    unsigned int flag3 : 1;\r\n    37\t    unsigned int counter : 5;\r\n    38\t    unsigned int mode : 3;\r\n    39\t    unsigned int status : 5;\r\n    40\t    unsigned int reserved : 16;\r\n    41\t} PackedFlags;\r\n    42\t\r\n    43\ttypedef union {\r\n    44\t    int int_val;\r\n    45\t    float float_val;\r\n    46\t    unsigned int uint_val;\r\n    47\t    char bytes[4];\r\n    48\t} TypeConfusion;\r\n    49\t\r\n    50\ttypedef struct {\r\n    51\t    PackedFlags flags;\r\n    52\t    TypeConfusion data;\r\n    53\t    char* buffer;\r\n    54\t    int capacity;\r\n    55\t} ProcessState;\r\n    56\t\r\n    57\tProcessState* create_state(int initial_val, int capacity) {\r\n    58\t    ProcessState* state = (ProcessState*)malloc(sizeof(ProcessState));\r\n    59\t\r\n    60\t    if (state == NULL) {\r\n    61\t        printf(\"Error: Failed to allocate memory for state\\n\");\r\n    62\t        return NULL;\r\n    63\t    }\r\n    64\t\r\n    65\t    state->flags.flag1 = 1;\r\n    66\t    state->flags.flag2 = 0;\r\n    67\t    state->flags.flag3 = 1;\r\n    68\t    state->flags.counter = 0;\r\n    69\t    state->flags.mode = 3;\r\n    70\t    state->flags.status = 15;\r\n    71\t    state->flags.reserved = 0;\r\n    72\t\r\n    73\t    state->data.int_val = initial_val;\r\n    74\t\r\n    75\t    state->capacity = capacity;\r\n    76\t    state->buffer = (char*)malloc(capacity);\r\n    77\t\r\n    78\t    if (state->buffer == NULL) {\r\n    79\t        printf(\"Error: Failed to allocate buffer\\n\");\r\n    80\t        free(state);\r\n    81\t        return NULL;\r\n    82\t    }\r\n    83\t\r\n    84\t    snprintf(state->buffer, capacity, \"State:%d:Mode:%d\",\r\n    85\t             initial_val, state->flags.mode);\r\n    86\t\r\n    87\t    return state;\r\n    88\t}\r\n    89\t\r\n    90\tvoid destroy_state(ProcessState* state) {\r\n    91\t    if (state != NULL) {\r\n    92\t        if (state->buffer != NULL) {\r\n    93\t            free(state->buffer);\r\n    94\t        }\r\n    95\t        free(state);\r\n    96\t    }\r\n    97\t}\r\n    98\t\r\n    99\tint process_buffer(ProcessState* state, char target) {\r\n   100\t    if (state == NULL || state->buffer == NULL) {\r\n   101\t        printf(\"Error: Null pointer in process_buffer\\n\");\r\n   102\t        return -1;\r\n   103\t    }\r\n   104\t\r\n   105\t    int count = 0;\r\n   106\t    char* ptr = state->buffer;\r\n   107\t    size_t remaining = strlen(state->buffer);\r\n   108\t\r\n   109\t    while (remaining > 0) {\r\n   110\t        char* found = (char*)memchr(ptr, target, remaining);\r\n   111\t\r\n   112\t        if (found == NULL) {\r\n   113\t            break;\r\n   114\t        }\r\n   115\t\r\n   116\t        count++;\r\n   117\t        LOG_OPERATION(memchr_found, count);\r\n   118\t\r\n   119\t        remaining -= (found - ptr + 1);\r\n   120\t        ptr = found + 1;\r\n   121\t    }\r\n   122\t\r\n   123\t    return count;\r\n   124\t}\r\n   125\t\r\n   126\tvoid update_flags(ProcessState* state, int param) {\r\n   127\t    if (state == NULL) {\r\n   128\t        return;\r\n   129\t    }\r\n   130\t\r\n   131\t    state->flags.counter = (state->flags.counter + 1) & 0x1F; // 5-bit counter\r\n   132\t    state->flags.flag1 = (param & 1);\r\n   133\t    state->flags.flag2 = (param & 2) >> 1;\r\n   134\t    state->flags.flag3 = (param & 4) >> 2;\r\n   135\t    state->flags.mode = (param >> 3) & 0x7;\r\n   136\t\r\n   137\t    DEBUG_VAR(state->flags.counter);\r\n   138\t    printf(\"Bit fields - flag1:%d flag2:%d flag3:%d mode:%d\\n\",\r\n   139\t           state->flags.flag1, state->flags.flag2,\r\n   140\t           state->flags.flag3, state->flags.mode);\r\n   141\t}\r\n   142\t\r\n   143\tint confuse_types(ProcessState* state, int operation) {\r\n   144\t    if (state == NULL) {\r\n   145\t        return 0;\r\n   146\t    }\r\n   147\t\r\n   148\t    int result = 0;\r\n   149\t\r\n   150\t    switch (operation) {\r\n   151\t    