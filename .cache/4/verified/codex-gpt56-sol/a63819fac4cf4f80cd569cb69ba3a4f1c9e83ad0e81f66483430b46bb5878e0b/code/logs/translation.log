{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes\nimport json\nimport struct\nimport zlib\nfrom pathlib import Path\n\nROOT = Path.cwd()\nLIBS = {\n    'c': ROOT / 'c_reference_build/libtranslated_rust.so',\n    'rust': ROOT / 'target/release/libtranslated_rust.so',\n}\nTABLES = {\n    'cp_fixed_table': (ctypes.c_uint8, 320),\n    'cp_permutation_order': (ctypes.c_uint8, 19),\n    'cp_len_extra_bits': (ctypes.c_uint8, 31),\n    'cp_len_base': (ctypes.c_uint32, 31),\n    'cp_dist_extra_bits': (ctypes.c_uint8, 32),\n    'cp_dist_base': (ctypes.c_uint32, 32),\n}\n\nclass Pixel(ctypes.Structure):\n    _fields_ = [('r', ctypes.c_uint8), ('g', ctypes.c_uint8), ('b', ctypes.c_uint8), ('a', ctypes.c_uint8)]\n\nclass Image(ctypes.Structure):\n    _fields_ = [('w', ctypes.c_int), ('h', ctypes.c_int), ('pix', ctypes.POINTER(Pixel))]\n\nlibc = ctypes.CDLL(None)\nlibc.free.argtypes = [ctypes.c_void_p]\n\ndef load(path):\n    lib = ctypes.CDLL(str(path), mode=ctypes.RTLD_LOCAL)\n    lib.cp_inflate.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_void_p, ctypes.c_int]\n    lib.cp_inflate.restype = ctypes.c_int\n    lib.load_png_mem.argtypes = [ctypes.POINTER(ctypes.c_uint8), ctypes.c_int]\n    lib.load_png_mem.restype = Image\n    return lib\n\ndef error(lib):\n    p = ctypes.c_void_p.in_dll(lib, 'cp_error_reason').value\n    return ctypes.string_at(p).decode() if p else None\n\ndef deflate(data, level=6, strategy=zlib.Z_DEFAULT_STRATEGY):\n    obj = zlib.compressobj(level, zlib.DEFLATED, -15, 8, strategy)\n    return obj.compress(data) + obj.flush()\n\ndef zstream(raw, level=6, strategy=zlib.Z_DEFAULT_STRATEGY):\n    obj = zlib.compressobj(level, zlib.DEFLATED, 15, 8, strategy)\n    return obj.compress(raw) + obj.flush()\n\ndef paeth(a, b, c):\n    p = a + b - c\n    pa, pb, pc = abs(p-a), abs(p-b), abs(p-c)\n    return a if pa <= pb and pa <= pc else b if pb <= pc else c\n\ndef filtered(rows, bpp, filters):\n    out = bytearray()\n    prev = bytes(len(rows[0]))\n    for row, f in zip(rows, filters):\n        encoded = bytearray(len(row))\n        for x, value in enumerate(row):\n            left = row[x-bpp] if x >= bpp else 0\n            up = prev[x]\n            ul = prev[x-bpp] if x >= bpp else 0\n            predictor = [0, left, up, (left+up)//2, paeth(left, up, ul)][f]\n            encoded[x] = (value - predictor) & 255\n        out.append(f)\n        out.extend(encoded)\n        prev = row\n    return bytes(out)\n\ndef chunk(name, payload):\n    return struct.pack('>I', len(payload)) + name + payload + struct.pack('>I', zlib.crc32(name + payload) & 0xffffffff)\n\ndef png(width, height, color, raw, level=6, strategy=zlib.Z_DEFAULT_STRATEGY, palette=None, trns=None, splits=1,\n        bit_depth=8, compression=0, filter_method=0, interlace=0):\n    ihdr = struct.pack('>IIBBBBB', width, height, bit_depth, color, compression, filter_method, interlace)\n    stream = zstream(raw, level, strategy)\n    parts = []\n    if splits == 1:\n        segments = [stream]\n    else:\n        points = [len(stream)*i//splits for i in range(splits+1)]\n        segments = [stream[points[i]:points[i+1]] for i in range(splits)]\n    parts.append(chunk(b'IHDR', ihdr))\n    if palette is not None:\n        parts.append(chunk(b'PLTE', palette))\n    if trns is not None:\n        parts.append(chunk(b'tRNS', trns))\n    parts.extend(chunk(b'IDAT', segment) for segment in segments)\n    parts.append(chunk(b'IEND', b''))\n    return b'\\\\x89PNG\\\\r\\\\n\\\\x1a\\\\n' + b''.join(parts)\n\ndef expected_pixels(rows, color, palette=None, trns=None):\n    result = bytearray()\n    bpp = {0:1, 2:3, 3:1, 4:2, 6:4}[color]\n    for row in rows:\n        for x in range(0, len(row), bpp):\n            v = row[x:x+bpp]\n            if color == 0: result.extend((v[0],v[0],v[0],255))\n            elif color == 2: result.extend((v[0],v[1],v[2],255))\n            elif color == 3:\n                i=v[0]; result.extend((palette[3*i],palette[3*i+1],palette[3*i+2],trns[i] if trns and i < len(trns) else 255))\n            elif color == 4: result.extend((v[0],v[0],v[0],v[1]))\n            else: result.extend(v)\n    return bytes(result)\n\n# Find deterministic data that zlib actually encodes as a dynamic block.\ndynamic_payload = None\nfor n in (200, 1000, 5000, 20000):\n    candidate = (b'the quick brown fox jumps over the lazy dog ' * n) + bytes(range(256)) * 3\n    encoded = deflate(candidate)\n    if ((encoded[0] >> 1) & 3) == 2:\n        dynamic_payload = candidate\n        break\nassert dynamic_payload is not None\n\ninflate_cases = [\n    ('stored', bytes(range(251))*2, 0, zlib.Z_DEFAULT_STRATEGY),\n    ('fixed', b'fixed huffman payload ' * 80, 6, zlib.Z_FIXED),\n    ('dynamic', dynamic_payload, 6, zlib.Z_DEFAULT_STRATEGY),\n    ('empty-fixed', b'', 6, zlib.Z_FIXED),\n]\n\npalette = bytes([255,0,0, 0,255,0, 0,0,255, 90,80,70])\ntrns = bytes([0, 64, 128])\npng_cases = []\nfor color, bpp in [(0,1),(2,3),(3,1),(4,2),(6,4)]:\n    width, height = 7, 5\n    rows = [bytes(((x*29 + y*47 + color*11) & 255) for x in range(width*bpp)) for y in range(height)]\n    if color == 3:\n        rows = [bytes((x+y) % 4 for x in range(width)) for y in range(height)]\n    raw = filtered(rows, bpp, [0,1,2,3,4])\n    blob = png(width, height, color, raw, palette=palette if color==3 else None,\n               trns=trns if color==3 else None, splits=3)\n    png_cases.append((f'color-{color}-filters', blob, expected_pixels(rows,color,palette,trns)))\n\n# Additional compression modes through the complete PNG path.\nrows = [bytes((x*13+y*7)&255 for x in range(32*4)) for y in range(6)]\nraw = filtered(rows, 4, [0,1,2,3,4,0])\npng_cases.append(('png-fixed', png(32,6,6,raw,strategy=zlib.Z_FIXED), expected_pixels(rows,6)))\npng_cases.append(('png-stored', png(32,6,6,raw,level=0), expected_pixels(rows,6)))\n\nbad_cases = []\nbad_cases.append(('signature', b'not png\"'!'\"'))\nbase_raw = b'\\\\x00\\\\x11'\nbad_cases.append(('bit-depth', png(1,1,0,base_raw,bit_depth=4)))\nbad_cases.append(('color-type', png(1,1,1,base_raw)))\nbad_cases.append(('compression', png(1,1,0,base_raw,compression=1)))\nbad_cases.append(('filter-method', png(1,1,0,base_raw,filter_method=1)))\nbad_cases.append(('interlace', png(1,1,0,base_raw,interlace=1)))\nbad_cases.append(('bad-filter-byte', png(1,1,0,b'\\\\x05\\\\x11')))\nbad_cases.append(('palette-missing', png(1,1,3,b'\\\\x00\\\\x00')))\n\nresults = {}\nfor label, path in LIBS.items():\n    lib = load(path)\n    result = {'tables': {}, 'inflate': {}, 'png': {}, 'bad': {}}\n    for name, (typ, count) in TABLES.items():\n        result['tables'][name] = bytes((typ*count).in_dll(lib,name)).hex()\n    for name, payload, level, strategy in inflate_cases:\n        compressed = deflate(payload, level, strategy)\n        per_alignment = []\n        for alignment in range(4):\n            inbuf = (ctypes.c_uint8 * (len(compressed)+4))()\n            ctypes.memmove(ctypes.addressof(inbuf)+alignment, compressed, len(compressed))\n            outbuf = (ctypes.c_uint8 * (len(payload)+32))(*([0xa5]*(len(payload)+32)))\n            rc = lib.cp_inflate(ctypes.addressof(inbuf)+alignment, len(compressed), outbuf, len(payload)+32)\n            per_alignment.append((rc, bytes(outbuf).hex(), error(lib)))\n        result['inflate'][name] = per_alignment\n    for name, blob, expected in png_cases:\n        buf = (ctypes.c_uint8 * len(blob)).from_buffer_copy(blob)\n        image = lib.load_png_mem(buf, len(blob))\n        pixels = ctypes.string_at(image.pix, image.w*image.h*4) if image.pix else b''\n        result['png'][name] = (image.w, image.h, bool(image.pix), pixels.hex(), pixels == expected, error(lib))\n        if image.pix: libc.free(image.pix)\n    for name, blob in bad_cases:\n        buf = (ctypes.c_uint8 * max(len(blob),8))()\n        ctypes.memmove(buf, blob, len(blob))\n        image = lib.load_png_mem(buf, len(blob))\n        result['bad'][name] = (image.w, image.h, bool(image.pix), error(lib))\n        if image.pix: libc.free(image.pix)\n    results[label] = result\n\nif results['c'] \"'!= results['\"'rust']:\n    for section in ('tables','inflate','png','bad'):\n        if results['c'][section] \"'!= results['\"'rust'][section]:\n            print('MISMATCH', section)\n            ckeys=set(results['c'][section]); rkeys=set(results['rust'][section])\n            for key in sorted(ckeys|rkeys):\n                if results['c'][section].get(key) \"'!= results['\"'rust'][section].get(key):\n                    print(key, 'C=', results['c'][section].get(key), 'R=', results['rust'][section].get(key))\n    raise SystemExit(1)\nfor name, value in results['c']['png'].items():\n    assert value[4], (name, value)\nprint('table objects compared:', len(TABLES))\nprint('inflate cases compared:', len(inflate_cases), 'x 4 alignments')\nprint('PNG success cases compared:', len(png_cases))\nprint('PNG failure cases compared:', len(bad_cases))\nprint('all differential results identical')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
