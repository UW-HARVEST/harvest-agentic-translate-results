(img, \"IDs\", cJSON_CreateIntArray(ids, 4));\n   176\t\n   177\t    if (print_preallocated(root) != 0) {\n   178\t        cJSON_Delete(root);\n   179\t        exit(EXIT_FAILURE);\n   180\t    }\n   181\t    cJSON_Delete(root);\n   182\t\n   183\t    /* Our array of \"records\": */\n   184\t    root = cJSON_CreateArray();\n   185\t    for (i = 0; i < 2; i++)\n   186\t    {\n   187\t        cJSON_AddItemToArray(root, fld = cJSON_CreateObject());\n   188\t        cJSON_AddStringToObject(fld, \"precision\", fields[i].precision);\n   189\t        cJSON_AddNumberToObject(fld, \"Latitude\", fields[i].lat);\n   190\t        cJSON_AddNumberToObject(fld, \"Longitude\", fields[i].lon);\n   191\t        cJSON_AddStringToObject(fld, \"Address\", fields[i].address);\n   192\t        cJSON_AddStringToObject(fld, \"City\", fields[i].city);\n   193\t        cJSON_AddStringToObject(fld, \"State\", fields[i].state);\n   194\t        cJSON_AddStringToObject(fld, \"Zip\", fields[i].zip);\n   195\t        cJSON_AddStringToObject(fld, \"Country\", fields[i].country);\n   196\t    }\n   197\t\n   198\t    /* cJSON_ReplaceItemInObject(cJSON_GetArrayItem(root, 1), \"City\", cJSON_CreateIntArray(ids, 4)); */\n   199\t\n   200\t    if (print_preallocated(root) != 0) {\n   201\t        cJSON_Delete(root);\n   202\t        exit(EXIT_FAILURE);\n   203\t    }\n   204\t    cJSON_Delete(root);\n   205\t\n   206\t    root = cJSON_CreateObject();\n   207\t    cJSON_AddNumberToObject(root, \"number\", 1.0 / zero);\n   208\t\n   209\t    if (print_preallocated(root) != 0) {\n   210\t        cJSON_Delete(root);\n   211\t        exit(EXIT_FAILURE);\n   212\t    }\n   213\t    cJSON_Delete(root);\n   214\t}\n   215\t\n   216\tint CJSON_CDECL CJSON_PUBLIC(driver)(const char *strings[7], int numbers[3][3], int ids[4], struct record fields[2])\n   217\t{\n   218\t    /* print the version */\n   219\t    printf(\"Version: %s\\n\", cJSON_Version());\n   220\t\n   221\t    /* Now some samplecode for building ob