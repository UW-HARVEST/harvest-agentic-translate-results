{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,80p' Cargo.toml && sed -n '1,340p' tests/differential.rs\"","aggregated_output":"[package]\nname = \"driver\"\nversion = \"0.1.0\"\nedition = \"2024\"\n\n[lib]\ncrate-type = [\"cdylib\"]\nname = \"driver\"\n\n[profile.release]\npanic = \"abort\"\n\n[dev-dependencies]\nlibloading = \"0.8\"\n\n[workspace]\nuse libloading::{Library, Symbol};\nuse std::ffi::{CString, c_char, c_int, c_void};\nuse std::fs::File;\nuse std::io::Read;\nuse std::os::fd::FromRawFd;\nuse std::path::{Path, PathBuf};\nuse std::sync::Mutex;\nuse std::thread;\n\nconst STDOUT_FILENO: c_int = 1;\nconst C_LIBRARY: &str = \"c_src/build/libdriver.so\";\nconst RUST_LIBRARY: &str = \"target/release/libdriver.so\";\nconst SYMBOLS: &[&[u8]] = &[\n    b\"bad\\0\",\n    b\"driver\\0\",\n    b\"good\\0\",\n    b\"printIntLine\\0\",\n    b\"printLine\\0\",\n];\n\nstatic STDOUT_LOCK: Mutex<()> = Mutex::new(());\n\nunsafe extern \"C\" {\n    fn close(fd: c_int) -> c_int;\n    fn dup(fd: c_int) -> c_int;\n    fn dup2(old_fd: c_int, new_fd: c_int) -> c_int;\n    fn fflush(stream: *mut c_void) -> c_int;\n    fn pipe(pipe_fds: *mut c_int) -> c_int;\n}\n\nstruct Libraries {\n    c: Library,\n    rust: Library,\n}\n\nimpl Libraries {\n    fn load() -> Self {\n        Self {\n            c: load_library(C_LIBRARY),\n            rust: load_library(RUST_LIBRARY),\n        }\n    }\n}\n\nstruct FixedRng(u64);\n\nimpl FixedRng {\n    fn new(seed: u64) -> Self {\n        Self(seed)\n    }\n\n    fn next_u64(&mut self) -> u64 {\n        let mut value = self.0;\n        value ^= value >> 12;\n        value ^= value << 25;\n        value ^= value >> 27;\n        self.0 = value;\n        value.wrapping_mul(0x2545_f491_4f6c_dd1d)\n    }\n}\n\nfn crate_path(relative: &str) -> PathBuf {\n    Path::new(env!(\"CARGO_MANIFEST_DIR\")).join(relative)\n}\n\nfn load_library(relative: &str) -> Library {\n    let path = crate_path(relative);\n    assert!(path.is_file(), \"shared library is missing: {}\", path.display());\n    unsafe { Library::new(path).expect(\"failed to load shared library\") }\n}\n\nfn system_call_succeeded(result: c_int, operation: &str) -> c_int {\n    assert!(\n        result >= 0,\n        \"{operation} failed: {}\",\n        std::io::Error::last_os_error()\n    );\n    result\n}\n\nfn capture_stdout(call: impl FnOnce()) -> Vec<u8> {\n    let _guard = STDOUT_LOCK.lock().expect(\"stdout lock was poisoned\");\n\n    unsafe {\n        assert_eq!(fflush(std::ptr::null_mut()), 0, \"fflush failed\");\n    }\n\n    let mut pipe_fds = [-1; 2];\n    unsafe {\n        system_call_succeeded(pipe(pipe_fds.as_mut_ptr()), \"pipe\");\n    }\n    let saved_stdout =\n        unsafe { system_call_succeeded(dup(STDOUT_FILENO), \"dup(stdout)\") };\n    unsafe {\n        system_call_succeeded(dup2(pipe_fds[1], STDOUT_FILENO), \"dup2(pipe, stdout)\");\n        system_call_succeeded(close(pipe_fds[1]), \"close(pipe writer)\");\n    }\n\n    let reader = thread::spawn(move || {\n        let mut output = Vec::new();\n        let mut file = unsafe { File::from_raw_fd(pipe_fds[0]) };\n        file.read_to_end(&mut output)\n            .expect(\"failed to read captured stdout\");\n        output\n    });\n\n    call();\n\n    unsafe {\n        assert_eq!(fflush(std::ptr::null_mut()), 0, \"fflush failed\");\n        system_call_succeeded(dup2(saved_stdout, STDOUT_FILENO), \"restore stdout\");\n        system_call_succeeded(close(saved_stdout), \"close(saved stdout)\");\n    }\n\n    reader.join().expect(\"stdout reader thread panicked\")\n}\n\nfn call_print_line(library: &Library, inputs: &[*const c_char]) -> Vec<u8> {\n    let function: Symbol<unsafe extern \"C\" fn(*const c_char)> =\n        unsafe { library.get(b\"printLine\\0\").expect(\"missing printLine\") };\n    capture_stdout(|| {\n        for input in inputs {\n            unsafe {\n                function(*input);\n            }\n        }\n    })\n}\n\nfn call_print_int_line(library: &Library, inputs: &[c_int]) -> Vec<u8> {\n    let function: Symbol<unsafe extern \"C\" fn(c_int)> =\n        unsafe { library.get(b\"printIntLine\\0\").expect(\"missing printIntLine\") };\n    capture_stdout(|| {\n        for input in inputs {\n            unsafe {\n                function(*input);\n            }\n        }\n    })\n}\n\nfn call_no_args(library: &Library, symbol: &[u8]) -> Vec<u8> {\n    let function: Symbol<unsafe extern \"C\" fn()> =\n        unsafe { library.get(symbol).expect(\"missing no-argument symbol\") };\n    capture_stdout(|| unsafe {\n        function();\n    })\n}\n\n#[test]\nfn symbols_all_c_exports_are_loadable_from_both_libraries() {\n    let libraries = Libraries::load();\n    for symbol in SYMBOLS {\n        unsafe {\n            libraries\n                .c\n                .get::<*const c_void>(symbol)\n                .expect(\"C library is missing an expected symbol\");\n            libraries\n                .rust\n                .get::<*const c_void>(symbol)\n                .expect(\"Rust library is missing an expected symbol\");\n        }\n    }\n}\n\n#[test]\nfn configs_row_1_print_line_non_null_randomized() {\n    let libraries = Libraries::load();\n    let mut rng = FixedRng::new(0x9d1f_2a33_e84c_761b);\n    let mut strings = vec![\n        CString::new(\"\").unwrap(),\n        CString::new(\"plain text\").unwrap(),\n        CString::new(\"100% literal\").unwrap(),\n        CString::new(\"two\\nlines\").unwrap(),\n    ];\n\n    for _ in 0..512 {\n        let length = (rng.next_u64() % 257) as usize;\n        let bytes = (0..length)\n            .map(|_| ((rng.next_u64() % 255) + 1) as u8)\n            .collect::<Vec<_>>();\n        strings.push(CString::new(bytes).unwrap());\n    }\n\n    let pointers = strings.iter().map(|value| value.as_ptr()).collect::<Vec<_>>();\n    let c_output = call_print_line(&libraries.c, &pointers);\n    let rust_output = call_print_line(&libraries.rust, &pointers);\n    assert_eq!(rust_output, c_output);\n}\n\n#[test]\nfn configs_row_2_print_int_line_randomized_full_range() {\n    let libraries = Libraries::load();\n    let mut rng = FixedRng::new(0x42a9_0ec7_b551_10d3);\n    let mut inputs = vec![c_int::MIN, c_int::MIN + 1, -1, 0, 1, c_int::MAX - 1, c_int::MAX];\n    inputs.extend((0..2048).map(|_| rng.next_u64() as u32 as c_int));\n\n    let c_output = call_print_int_line(&libraries.c, &inputs);\n    let rust_output = call_print_int_line(&libraries.rust, &inputs);\n    assert_eq!(rust_output, c_output);\n}\n\n#[test]\nfn configs_row_3_bad_direct_call() {\n    let libraries = Libraries::load();\n    let c_output = call_no_args(&libraries.c, b\"bad\\0\");\n    let rust_output = call_no_args(&libraries.rust, b\"bad\\0\");\n    assert_eq!(rust_output, c_output);\n    assert_eq!(c_output, b\"0\\n0\\n\");\n}\n\n#[test]\nfn configs_row_4_good_direct_call() {\n    let libraries = Libraries::load();\n    let c_output = call_no_args(&libraries.c, b\"good\\0\");\n    let rust_output = call_no_args(&libraries.rust, b\"good\\0\");\n    assert_eq!(rust_output, c_output);\n    assert_eq!(c_output, b\"0\\n2\\n\");\n}\n\n#[test]\nfn configs_row_5_driver_composed_call() {\n    let libraries = Libraries::load();\n    let c_output = call_no_args(&libraries.c, b\"driver\\0\");\n    let rust_output = call_no_args(&libraries.rust, b\"driver\\0\");\n    assert_eq!(rust_output, c_output);\n    assert_eq!(\n        c_output,\n        b\"Calling good()...\\n0\\n2\\nFinished good()\\nCalling bad()...\\n0\\n0\\nFinished bad()\\n\"\n    );\n}\n\n#[test]\nfn errors_row_1_print_line_null_writes_nothing() {\n    let libraries = Libraries::load();\n    let inputs = [std::ptr::null()];\n    let c_output = call_print_line(&libraries.c, &inputs);\n    let rust_output = call_print_line(&libraries.rust, &inputs);\n    assert_eq!(rust_output, c_output);\n    assert!(c_output.is_empty());\n}\n","exit_code":0,"status":"completed"}}
