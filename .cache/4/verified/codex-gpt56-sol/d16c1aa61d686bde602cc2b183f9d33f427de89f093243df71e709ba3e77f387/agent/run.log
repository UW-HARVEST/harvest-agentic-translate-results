by granted, free of charge,\n     3\t// to any person obtaining a copy of this software\n     4\t// and associated documentation files (the “Software”),\n     5\t// to deal in the Software without restriction,\n     6\t// including without limitation the rights to use, copy,\n     7\t// modify, merge, publish, distribute, sublicense,\n     8\t// and/or sell copies of the Software,\n     9\t// and to permit persons to whom the Software is furnished to do so,\n    10\t// subject to the following conditions:\n    11\t// \n    12\t// The above copyright notice and this permission notice\n    13\t// shall be included in all copies or substantial portions of the Software.\n    14\t// \n    15\t// THE SOFTWARE IS PROVIDED “AS IS”, WITHOUT WARRANTY OF ANY KIND,\n    16\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    17\t// THE WARRANTIES OF MERCHANTABILITY,\n    18\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    19\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    20\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    21\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    22\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    23\t\n    24\t#include \"../include/util.h\"\n    25\t#include <stdlib.h>\n    26\t#include <string.h>\n    27\t#include <limits.h>\n    28\t#include <stdint.h>\n    29\t\n    30\tvoid iv_init(IntVec *v){ v->data=NULL; v->len=v->cap=0; }\n    31\tvoid iv_free(IntVec *v){ free(v->data); v->data=NULL; v->len=v->cap=0; }\n    32\t\n    33\tbool iv_reserve(IntVec *v, size_t need){\n    34\t    if (need <= v->cap) return true;\n    35\t    size_t nc = v->cap? v->cap:8;\n    36\t    while (nc < need) {\n    37\t        if (nc > (SIZE_MAX/2)) return false;\n    38\t        nc *= 2;\n    39\t    }\n    40\t    int *p = (int*)realloc(v->data, nc*sizeof(int));\n    41\t    if (!p) return false;\n    42\t    v->data = p; v->cap = nc; return true;\n    43\t}\n    44\tbool iv_push(IntVec *v,int x){ if(v->len==v->cap && !iv_reserve(v, v->cap? v->cap*2:8)) return false; v->data[v->len++]=x; return true; }\n    45\tbool iv_pop (IntVec *v,int *out){ if(!v->len) return false; if(out) *out=v->data[v->len-1]; v->len--; return true; }\n    46\tint  iv_peek(const IntVec *v,int def){ return v->len? v->data[v->len-1]: def; }\n    47\t\n    48\tvoid prog_init(Program *p, const int *code, size_t n){ p->code=code; p->n=n; p->ip=0; }\n    49\tbool prog_fetch(Program *p, int *out){ if(p->ip>=p->n) return false; *out=p->code[p->ip++]; return true; }\n    50\t\n    51\tvoid vm_init(VM *vm){ iv_init(&vm->stack); iv_init(&vm->trace); vm->steps=0; }\n    52\tvoid vm_free(VM *vm){ iv_free(&vm->stack); iv_free(&vm->trace); vm->steps=0; }\n    53\tvoid vm_trace(VM *vm, int t){ iv_push(&vm->trace, t); }\n    54\t\n    55\tvoid vm_print(FILE *fp, const char *label, const VM *vm){\n    56\t    fprintf(fp, \"%sSTACK_TOP=%d STEPS=%d TRACE=\", label, iv_peek(&vm->stack, -777), vm->steps);\n    57\t    for (size_t i=0;i<vm->trace.len;i++) fputc(\"abcdefghijklmnopqrstuvwxyz\"[(vm->trace.data[i])&25], fp);\n    58\t    fputc('\\n', fp);\n    59\t}\n\n### src/main.c\n     1\t// Copyright 2025 MIT Lincoln Laboratory\n     2\t// Permission is hereby granted, free of charge,\n     3\t// to any person obtaining a copy of this software\n     4\t// and associated documentation files (the “Software”),\n     5\t// to deal in the Software without restriction,\n     6\t// including without limitation the rights to use, copy,\n     7\t// modify, merge, publish, distribute, sublicense,\n     8\t// and/or sell copies of the Software,\n     9\t// and to permit persons to whom the Software is furnished to do so,\n    10\t// subject to the following conditions:\n    11\t// \n    12\t// The above copyright notice and this permission notice\n    13\t// shall be included in all copies or substantial portions of the Software.\n    14\t// \n    15\t// THE SOFTWARE IS PROVIDED “AS IS”, WITHOUT WARRANTY OF ANY KIND,\n    16\t// EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    17\t// THE WARRANTIES OF MERCHANTABILITY,\n    18\t// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    19\t// IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    20\t// FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    21\t// TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    22\t// OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    23\t\n    24\t#include <stdio.h>\n    25\t#include <stdlib.h>\n    26\t#include <string.h>\n    27\t#include <stdbool.h>\n    28\t#include \"../include/util.h\"\n    29\t#include \"../include/api.h\"\n    30\t\n    31\tint run_engine(int impl_id, const int *code, size_t n, VM *vm);\n    32\t\n    33\tstatic void usage(const char *p){\n    34\t    fprintf(stderr, \"Usage: %s [--stdin] [bytecodes...]\\n\"\n    35\t                    \"Bytecodes are integers forming a small VM program.\\n\", p);\n    36\t}\n    37\t\n    38\tstatic size_t read_stdin(IntVec *v){\n    39\t    char buf[4096];\n    40\t    size_t count=0;\n    41\t    while (fgets(buf, sizeof buf, stdin)) {\n    42\t        char *p = buf;\n    43\t        while (*p) {\n    44\t            char *q=p;\n    45\t            while (*q && *q!=' ' && *q!='\\t' && *q!='\\n' && *q!='\\r') ++q;\n    46\t            char save=*q; *q='\\0';\n    47\t            if (*p) {\n    48\t                char *e=NULL; long t=strtol(p,&e,10);\n    49\t                if (e && *e=='\\0') { iv_push(v,(int)t); count++; }\n    50\t            }\n    51\t            *q=save;\n    52\t            p = (*q? q+1 : q);\n    53\t        }\n    54\t    }\n    55\t    return count;\n    56\t}\n    57\t\n    58\tint main(int argc, char **argv){\n    59\t    bool use_stdin=false;\n    60\t    IntVec code; iv_init(&code);\n    61\t\n    62\t    for (int i=1;i<argc;i++){\n    63\t        if (!strcmp(argv[i],\"--help\")) { usage(argv[0]); iv_free(&code); return 0; }\n    64\t        else if (!strcmp(argv[i],\"--stdin\")) use_stdin=true;\n    65\t        else {\n    66\t            char *e=NULL; long t=strtol(argv[i],&e,10);\n    67\t            if (e && *e=='\\0') iv_push(&code,(int)t);\n    68\t            else fprintf(stderr,\"skip '%s'\\n\", argv[i]);\n    69\t        }\n    70\t    }\n    71\t    if (use_stdin) read_stdin(&code);\n    72\t    if (code.len==0) {\n    73\t        fprintf(stderr,\"no program\\n\");\n    74\t        iv_free(&code); return 2;\n    75\t    }\n    76\t\n    77\t    VM vmA, vmB, vmE;\n    78\t    vm_init(&vmA); vm_init(&vmB); vm_init(&vmE);\n    79\t\n    80\t    int rcA = run_engine(0, code.data, code.len, &vmA);\n    81\t    int rcB = run_engine(1, code.data, code.len, &vmB);\n    82\t    int rcE = run_engine(2, code.data, code.len, &vmE);\n    83\t\n    84\t    printf(\"RC:A=%d B=%d EXT=%d\\n\", rcA, rcB, rcE);\n    85\t    vm_print(stdout, \"A:\", &vmA);\n    86\t    vm_print(stdout, \"B:\", &vmB);\n    87\t    vm_print(stdout, \"EXT:\", &vmE);\n    88\t\n    89\t    vm_free(&vmA); vm_free(&vmB); vm_free(&vmE);\n    90\t    iv_free(&code);\n    91\t    return 0;\n    92\t}\n","exit_code":0,"status":"completed"}}
