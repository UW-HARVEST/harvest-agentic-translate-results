{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/main.rs | sed -n '1,220p'\"","aggregated_output":"     1\tuse std::io::{self, Read, Write};\n     2\tuse std::process::ExitCode;\n     3\t\n     4\tconst MAX_BUFFER_LENGTH: usize = 256;\n     5\t\n     6\t#[derive(Clone)]\n     7\tstruct Buffer {\n     8\t    data: [u8; MAX_BUFFER_LENGTH],\n     9\t    length: usize,\n    10\t    checksum: u32,\n    11\t}\n    12\t\n    13\timpl Default for Buffer {\n    14\t    fn default() -> Self {\n    15\t        Self {\n    16\t            data: [0; MAX_BUFFER_LENGTH],\n    17\t            length: 0,\n    18\t            checksum: 0,\n    19\t        }\n    20\t    }\n    21\t}\n    22\t\n    23\tstruct Scanner {\n    24\t    input: Vec<u8>,\n    25\t    position: usize,\n    26\t}\n    27\t\n    28\timpl Scanner {\n    29\t    fn from_stdin() -> Self {\n    30\t        let mut input = Vec::new();\n    31\t        let _ = io::stdin().read_to_end(&mut input);\n    32\t        Self { input, position: 0 }\n    33\t    }\n    34\t\n    35\t    // Match scanf(\"%d\"): skip C whitespace, accept a sign, and stop at the\n    36\t    // first non-decimal byte without requiring the rest of a token to be valid.\n    37\t    fn read_i32(&mut self) -> Option<i32> {\n    38\t        while self\n    39\t            .input\n    40\t            .get(self.position)\n    41\t            .is_some_and(|byte| is_c_whitespace(*byte))\n    42\t        {\n    43\t            self.position += 1;\n    44\t        }\n    45\t\n    46\t        let start = self.position;\n    47\t        let negative = match self.input.get(self.position) {\n    48\t            Some(b'-') => {\n    49\t                self.position += 1;\n    50\t                true\n    51\t            }\n    52\t            Some(b'+') => {\n    53\t                self.position += 1;\n    54\t                false\n    55\t            }\n    56\t            _ => false,\n    57\t        };\n    58\t\n    59\t        let digits_start = self.position;\n    60\t        let mut magnitude = 0_u64;\n    61\t        let mut overflowed = false;\n    62\t        while let Some(byte @ b'0'..=b'9') = self.input.get(self.position) {\n    63\t            if !overflowed {\n    64\t                if let Some(value) = magnitude\n    65\t                    .checked_mul(10)\n    66\t                    .and_then(|value| value.checked_add(u64::from(*byte - b'0')))\n    67\t                {\n    68\t                    magnitude = value;\n    69\t                } else {\n    70\t                    overflowed = true;\n    71\t                }\n    72\t            }\n    73\t            self.position += 1;\n    74\t        }\n    75\t\n    76\t        if self.position == digits_start {\n    77\t            self.position = start;\n    78\t            return None;\n    79\t        }\n    80\t\n    81\t        let value = if negative {\n    82\t            if overflowed || magnitude >= (1_u64 << 63) {\n    83\t                i64::MIN\n    84\t            } else {\n    85\t                -(magnitude as i64)\n    86\t            }\n    87\t        } else if overflowed || magnitude > i64::MAX as u64 {\n    88\t            i64::MAX\n    89\t        } else {\n    90\t            magnitude as i64\n    91\t        };\n    92\t        Some(value as i32)\n    93\t    }\n    94\t}\n    95\t\n    96\tfn is_c_whitespace(byte: u8) -> bool {\n    97\t    matches!(byte, b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r')\n    98\t}\n    99\t\n   100\tfn calculate_checksum(data: &[u8]) -> u32 {\n   101\t    data.iter()\n   102\t        .fold(0_u32, |sum, byte| sum.wrapping_shl(3) ^ u32::from(*byte))\n   103\t}\n   104\t\n   105\tfn validate_buffer(buffer: &Buffer) -> bool {\n   106\t    if buffer.length > MAX_BUFFER_LENGTH {\n   107\t        eprintln!(\"Error: Buffer length {} exceeds maximum 256\", buffer.length);\n   108\t        return false;\n   109\t    }\n   110\t\n   111\t    let expected = calculate_checksum(&buffer.data[..buffer.length]);\n   112\t    if buffer.checksum != expected {\n   113\t        eprintln!(\n   114\t            \"Warning: Checksum mismatch. Expected {}, got {}\",\n   115\t            expected, buffer.checksum\n   116\t        );\n   117\t    }\n   118\t    true\n   119\t}\n   120\t\n   121\tfn buffer_copy(source: &Buffer, destination: &mut Buffer) -> i32 {\n   122\t    if !validate_buffer(source) {\n   123\t        return -1;\n   124\t    }\n   125\t\n   126\t    destination.data[..source.length].copy_from_slice(&source.data[..source.length]);\n   127\t    destination.length = source.length;\n   128\t    destination.checksum = calculate_checksum(&destination.data[..destination.length]);\n   129\t    0\n   130\t}\n   131\t\n   132\tfn buffer_reverse(buffer: &mut Buffer) -> i32 {\n   133\t    if buffer.length == 0 {\n   134\t        return 0;\n   135\t    }\n   136\t\n   137\t    buffer.data[..buffer.length].reverse();\n   138\t    buffer.checksum = calculate_checksum(&buffer.data[..buffer.length]);\n   139\t    0\n   140\t}\n   141\t\n   142\tfn buffer_merge(source1: &Buffer, source2: &Buffer, destination: &mut Buffer) -> i32 {\n   143\t    if source1.length + source2.length > MAX_BUFFER_LENGTH {\n   144\t        eprintln!(\n   145\t            \"Error: Merged length {} exceeds maximum\",\n   146\t            source1.length + source2.length\n   147\t        );\n   148\t        return -1;\n   149\t    }\n   150\t\n   151\t    destination.data[..source1.length].copy_from_slice(&source1.data[..source1.length]);\n   152\t    destination.data[source1.length..source1.length + source2.length]\n   153\t        .copy_from_slice(&source2.data[..source2.length]);\n   154\t    destination.length = source1.length + source2.length;\n   155\t    destination.checksum = calculate_checksum(&destination.data[..destination.length]);\n   156\t    0\n   157\t}\n   158\t\n   159\tfn buffer_split(\n   160\t    source: &Buffer,\n   161\t    split_position: usize,\n   162\t    destination1: &mut Buffer,\n   163\t    destination2: &mut Buffer,\n   164\t) -> i32 {\n   165\t    if split_position > source.length {\n   166\t        eprintln!(\n   167\t            \"Error: Split position {} exceeds length {}\",\n   168\t            split_position, source.length\n   169\t        );\n   170\t        return -1;\n   171\t    }\n   172\t\n   173\t    if split_position > 0 {\n   174\t        destination1.data[..split_position].copy_from_slice(&source.data[..split_position]);\n   175\t    }\n   176\t    destination1.length = split_position;\n   177\t    destination1.checksum = calculate_checksum(&destination1.data[..destination1.length]);\n   178\t\n   179\t    let remaining = source.length - split_position;\n   180\t    if remaining > 0 {\n   181\t        destination2.data[..remaining].copy_from_slice(&source.data[split_position..source.length]);\n   182\t    }\n   183\t    destination2.length = remaining;\n   184\t    destination2.checksum = calculate_checksum(&destination2.data[..destination2.length]);\n   185\t    0\n   186\t}\n   187\t\n   188\tfn buffer_interleave(source1: &Buffer, source2: &Buffer, destination: &mut Buffer) -> i32 {\n   189\t    let max_length = source1.length.max(source2.length);\n   190\t    if source1.length + source2.length > MAX_BUFFER_LENGTH {\n   191\t        eprintln!(\"Error: Interleaved length exceeds maximum\");\n   192\t        return -1;\n   193\t    }\n   194\t\n   195\t    let mut destination_position = 0;\n   196\t    for index in 0..max_length {\n   197\t        if index < source1.length {\n   198\t            destination.data[destination_position] = source1.data[index];\n   199\t            destination_position += 1;\n   200\t        }\n   201\t        if index < source2.length {\n   202\t            destination.data[destination_position] = source2.data[index];\n   203\t            destination_position += 1;\n   204\t        }\n   205\t    }\n   206\t\n   207\t    destination.length = destination_position;\n   208\t    destination.checksum = calculate_checksum(&destination.data[..destination.length]);\n   209\t    0\n   210\t}\n   211\t\n   212\tfn buffer_rotate(buffer: &mut Buffer, mut positions: i32) -> i32 {\n   213\t    if buffer.length == 0 || positions == 0 {\n   214\t        return 0;\n   215\t    }\n   216\t\n   217\t    positions %= buffer.length as i32;\n   218\t    if positions < 0 {\n   219\t        positions += buffer.length as i32;\n   220\t    }\n","exit_code":0,"status":"completed"}}
