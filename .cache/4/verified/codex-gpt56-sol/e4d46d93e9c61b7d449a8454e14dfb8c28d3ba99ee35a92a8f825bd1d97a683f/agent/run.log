in(int argc, char *argv[]) {\n   438\t    int operation;\n   439\t    int buffer_count;\n   440\t    \n   441\t    // Read operation type\n   442\t    if (scanf(\"%d\", &operation) != 1) {\n   443\t        fprintf(stderr, \"Error: Failed to read operation\\n\");\n   444\t        return 1;\n   445\t    }\n   446\t    \n   447\t    // Read buffer count\n   448\t    if (scanf(\"%d\", &buffer_count) != 1) {\n   449\t        fprintf(stderr, \"Error: Failed to read buffer count\\n\");\n   450\t        return 1;\n   451\t    }\n   452\t    \n   453\t    if (buffer_count <= 0 || buffer_count > 100) {\n   454\t        fprintf(stderr, \"Error: Invalid buffer count %d\\n\", buffer_count);\n   455\t        return 1;\n   456\t    }\n   457\t    \n   458\t    // Allocate buffer array\n   459\t    buffer_array_t *buffers = init_buffer_array(buffer_count);\n   460\t    if (!buffers) {\n   461\t        return 1;\n   462\t    }\n   463\t    \n   464\t    // Read all buffers\n   465\t    for (int i = 0; i < buffer_count; i++) {\n   466\t        if (read_buffer(&buffers->buffers[i]) != 0) {\n   467\t            free_buffer_array(buffers);\n   468\t            return 1;\n   469\t        }\n   470\t        buffers->count++;\n   471\t    }\n   472\t    \n   473\t    // Execute operation based on type\n   474\t    int result = 0;\n   475\t    switch (operation) {\n   476\t        case OP_COPY:\n   477\t            if (buffer_count >= 2) {\n   478\t                buffer_t temp;\n   479\t                result = buffer_copy(&buffers->buffers[0], &temp);\n   480\t                if (result == 0) {\n   481\t                    write_buffer(&temp);\n   482\t                }\n   483\t            } else {\n   484\t                fprintf(stderr, \"Error: Copy needs at least 2 buffers\\n\");\n   485\t                result = -1;\n   486\t            }\n   487\t            break;\n   488\t            \n   489\t        case OP_REVERSE:\n   490\t            for (int i = 0; i < buffer_count; i++) {\n   491\t                result = buffer_reverse(&buffers->buffers[i]);\n   492\t                if (result != 0) break;\n   493\t                write_buffer(&buffers->buffers[i]);\n   494\t            }\n   495\t            break;\n   496\t            \n   497\t        case OP_MERGE:\n   498\t            if (buffer_count >= 2) {\n   499\t                buffer_t merged;\n   500\t                result = buffer_merge(&buffers->buffers[0], &buffers->buffers[1], &merged);\n   501\t                if (result == 0) {\n   502\t                    write_buffer(&merged);\n   503\t                }\n   504\t            } else {\n   505\t                fprintf(stderr, \"Error: Merge needs at least 2 buffers\\n\");\n   506\t                result = -1;\n   507\t            }\n   508\t            break;\n   509\t            \n   510\t        case OP_SPLIT: {\n   511\t            if (buffer_count >= 1) {\n   512\t                int split_pos;\n   513\t                if (scanf(\"%d\", &split_pos) != 1) {\n   514\t                    fprintf(stderr, \"Error: Failed to read split position\\n\");\n   515\t                    result = -1;\n   516\t                } else {\n   517\t                    buffer_t part1, part2;\n   518\t                    result = buffer_split(&buffers->buffers[0], split_pos, &part1, &part2);\n   519\t                    if (result == 0) {\n   520\t                        write_buffer(&part1);\n   521\t                        write_buffer(&part2);\n   522\t                    }\n   523\t                }\n   524\t            }\n   525\t            break;\n   526\t        }\n   527\t            \n   528\t        case OP_INTERLEAVE:\n   529\t            if (buffer_count >= 2) {\n   530\t                buffer_t interleaved;\n   531\t                result = buffer_interleave(&buffers->buffers[0], &buffers->buffers[1], &interleaved);\n   532\t                if (result == 0) {\n   533\t                    write_buffer(&interleaved);\n   534\t                }\n   535\t            } else {\n   536\t                fprintf(stderr, \"Error: Interleave needs at least 2 buffers\\n\");\n   537\t                result = -1;\n   538\t            }\n   539\t            break;\n   540\t            \n   541\t        case OP_ROTATE: {\n   542\t            int positions;\n   543\t            if (scanf(\"%d\", &positions) != 1) {\n   544\t                fprintf(stderr, \"Error: Failed to read rotation amount\\n\");\n   545\t                result = -1;\n   546\t            } else {\n   547\t                for (int i = 0; i < buffer_count; i++) {\n   548\t                    result = buffer_rotate(&buffers->buffers[i], positions);\n   549\t                    if (result != 0) break;\n   550\t                    write_buffer(&buffers->buffers[i]);\n   551\t                }\n   552\t            }\n   553\t            break;\n   554\t        }\n   555\t            \n   556\t        case OP_CHECKSUM:\n   557\t            for (int i = 0; i < buffer_count; i++) {\n   558\t                printf(\"%u\\n\", buffers->buffers[i].checksum);\n   559\t            }\n   560\t            break;\n   561\t            \n   562\t        default:\n   563\t            fprintf(stderr, \"Error: Unknown operation %d\\n\", operation);\n   564\t            result = -1;\n   565\t            break;\n   566\t    }\n   567\t    \n   568\t    free_buffer_array(buffers);\n   569\t    return result != 0 ? 1 : 0;\n   570\t}\n","exit_code":0,"status":"completed"}}
