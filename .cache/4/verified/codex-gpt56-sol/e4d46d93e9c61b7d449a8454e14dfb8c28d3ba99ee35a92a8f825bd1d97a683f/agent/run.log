e(buffer_count) = scanner.read_i32() else {\n   270\t        eprintln!(\"Error: Failed to read buffer count\");\n   271\t        return 1;\n   272\t    };\n   273\t\n   274\t    if buffer_count <= 0 || buffer_count > 100 {\n   275\t        eprintln!(\"Error: Invalid buffer count {}\", buffer_count);\n   276\t        return 1;\n   277\t    }\n   278\t\n   279\t    let mut buffers = vec![Buffer::default(); buffer_count as usize];\n   280\t    for buffer in &mut buffers {\n   281\t        if read_buffer(&mut scanner, buffer) != 0 {\n   282\t            return 1;\n   283\t        }\n   284\t    }\n   285\t\n   286\t    let mut result = 0;\n   287\t    match operation {\n   288\t        0 => {\n   289\t            if buffer_count >= 2 {\n   290\t                let mut temporary = Buffer::default();\n   291\t                result = buffer_copy(&buffers[0], &mut temporary);\n   292\t                if result == 0 {\n   293\t                    write_buffer(&mut output, &temporary);\n   294\t                }\n   295\t            } else {\n   296\t                eprintln!(\"Error: Copy needs at least 2 buffers\");\n   297\t                result = -1;\n   298\t            }\n   299\t        }\n   300\t        1 => {\n   301\t            for buffer in &mut buffers {\n   302\t                result = buffer_reverse(buffer);\n   303\t                if result != 0 {\n   304\t                    break;\n   305\t                }\n   306\t                write_buffer(&mut output, buffer);\n   307\t            }\n   308\t        }\n   309\t        2 => {\n   310\t            if buffer_count >= 2 {\n   311\t                let mut merged = Buffer::default();\n   312\t                result = buffer_merge(&buffers[0], &buffers[1], &mut merged);\n   313\t                if result == 0 {\n   314\t                    write_buffer(&mut output, &merged);\n   315\t                }\n   316\t            } else {\n   317\t                eprintln!(\"Error: Merge needs at least 2 buffers\");\n   318\t                result = -1;\n   319\t            }\n   320\t        }\n   321\t        3 => {\n   322\t            if buffer_count >= 1 {\n   323\t                if let Some(split_position) = scanner.read_i32() {\n   324\t                    let mut part1 = Buffer::default();\n   325\t                    let mut part2 = Buffer::default();\n   326\t                    result =\n   327\t                        buffer_split(&buffers[0], split_position as usize, &mut part1, &mut part2);\n   328\t                    if result == 0 {\n   329\t                        write_buffer(&mut output, &part1);\n   330\t                        write_buffer(&mut output, &part2);\n   331\t                    }\n   332\t                } else {\n   333\t                    eprintln!(\"Error: Failed to read split position\");\n   334\t                    result = -1;\n   335\t                }\n   336\t            }\n   337\t        }\n   338\t        4 => {\n   339\t            if buffer_count >= 2 {\n   340\t                let mut interleaved = Buffer::default();\n   341\t                result = buffer_interleave(&buffers[0], &buffers[1], &mut interleaved);\n   342\t                if result == 0 {\n   343\t                    write_buffer(&mut output, &interleaved);\n   344\t                }\n   345\t            } else {\n   346\t                eprintln!(\"Error: Interleave needs at least 2 buffers\");\n   347\t                result = -1;\n   348\t            }\n   349\t        }\n   350\t        5 => {\n   351\t            if let Some(positions) = scanner.read_i32() {\n   352\t                for buffer in &mut buffers {\n   353\t                    result = buffer_rotate(buffer, positions);\n   354\t                    if result != 0 {\n   355\t                        break;\n   356\t                    }\n   357\t                    write_buffer(&mut output, buffer);\n   358\t                }\n   359\t            } else {\n   360\t                eprintln!(\"