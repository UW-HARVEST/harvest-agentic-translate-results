{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes,itertools,random,struct,sys\nclass V(ctypes.Structure): _fields_=[('x',ctypes.c_float),('y',ctypes.c_float)]\nclass XRot(ctypes.Structure): _fields_=[('c',ctypes.c_float),('s',ctypes.c_float)]\nclass X(ctypes.Structure): _fields_=[('p',V),('r',XRot)]\nclass Circle(ctypes.Structure): _fields_=[('p',V),('r',ctypes.c_float)]\nclass AABB(ctypes.Structure): _fields_=[('min',V),('max',V)]\nclass Capsule(ctypes.Structure): _fields_=[('a',V),('b',V),('r',ctypes.c_float)]\nclass Cache(ctypes.Structure): _fields_=[('metric',ctypes.c_float),('count',ctypes.c_int),('iA',ctypes.c_int*3),('iB',ctypes.c_int*3),('div',ctypes.c_float)]\nlibs=[ctypes.CDLL('./.reference-build/libreference.so'),ctypes.CDLL('./target/release/libtranslated_rust.so')]\nfor l in libs:\n l.c2GJK.argtypes=[ctypes.c_void_p,ctypes.c_int,ctypes.POINTER(X),ctypes.c_void_p,ctypes.c_int,ctypes.POINTER(X),ctypes.POINTER(V),ctypes.POINTER(V),ctypes.c_int,ctypes.POINTER(ctypes.c_int),ctypes.POINTER(Cache)]\n l.c2GJK.restype=ctypes.c_float\n\ndef bits(x):return struct.pack('f',x)\ndef raw(x):return ctypes.string_at(ctypes.byref(x),ctypes.sizeof(x))\ndef shape(t,r):\n if t==0:\n  x,y=r.uniform(-10,10),r.uniform(-10,10); return Capsule(V(x,y),V(x+r.uniform(-4,4),y+r.uniform(-4,4)),r.uniform(.01,3))\n if t==1:return Circle(V(r.uniform(-10,10),r.uniform(-10,10)),r.uniform(.01,3))\n x,y=r.uniform(-10,10),r.uniform(-10,10);return AABB(V(x,y),V(x+r.uniform(.01,5),y+r.uniform(.01,5)))\ndef invoke(l,A,t,B,u,use,with_cache):\n a=V(123,456);b=V(789,321);it=ctypes.c_int(0x12345678);cache=Cache();ctypes.memset(ctypes.byref(cache),0,ctypes.sizeof(cache))\n d=l.c2GJK(ctypes.byref(A),t,None,ctypes.byref(B),u,None,ctypes.byref(a),ctypes.byref(b),use,ctypes.byref(it),ctypes.byref(cache) if with_cache else None)\n return bits(d)+raw(a)+raw(b)+raw(it)+(raw(cache) if with_cache else b'')\nr=random.Random(0xBAD5EED);n=0\nfor t,u in itertools.product(range(3),repeat=2):\n for _ in range(1000):\n  A,B=shape(t,r),shape(u,r)\n  for use in [0,1]:\n   for cache in [False,True]:\n    a=invoke(libs[0],A,t,B,u,use,cache);b=invoke(libs[1],A,t,B,u,use,cache);n+=1\n    if a\"'!=b:\n     print('\"'MISMATCH',t,u,use,cache,a.hex(),b.hex());sys.exit(1)\nprint('byte-identical GJK cases:',n)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
