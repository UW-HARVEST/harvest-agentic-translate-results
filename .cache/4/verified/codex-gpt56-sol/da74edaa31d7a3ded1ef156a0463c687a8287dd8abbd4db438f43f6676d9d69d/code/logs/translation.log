{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes, itertools, random, struct, sys\n\nclass V(ctypes.Structure):\n    _fields_=[('x',ctypes.c_float),('y',ctypes.c_float)]\nclass M(ctypes.Structure):\n    _fields_=[('count',ctypes.c_int),('depths',ctypes.c_float*2),('points',V*2),('n',V)]\n\nlibs=[ctypes.CDLL('./.reference-build/libreference.so'),ctypes.CDLL('./target/release/libtranslated_rust.so')]\nfor lib in libs:\n    f=lib.omni_manifold\n    f.argtypes=[ctypes.POINTER(M),ctypes.c_int,*([ctypes.c_float]*5),ctypes.c_int,*([ctypes.c_float]*5)]\n    f.restype=None\n\ndef raw(m): return ctypes.string_at(ctypes.byref(m),ctypes.sizeof(m))\ndef run(lib,t1,a,t2,b):\n    m=M()\n    ctypes.memset(ctypes.byref(m),0x5a,ctypes.sizeof(m))\n    lib.omni_manifold(ctypes.byref(m),t1,*a,t2,*b)\n    return raw(m)\n\ndef shape(t):\n    if t==0:\n        x=random.uniform(-5,5); y=random.uniform(-5,5)\n        return [x,y,x+random.uniform(-3,3),y+random.uniform(-3,3),random.uniform(0.05,3)]\n    if t==1:\n        return [random.uniform(-5,5),random.uniform(-5,5),random.uniform(0.05,3),0,0]\n    x=random.uniform(-5,5); y=random.uniform(-5,5)\n    return [x,y,x+random.uniform(0.05,5),y+random.uniform(0.05,5),0]\n\nrandom.seed(0xC2)\nchecked=0\nfor t1,t2 in itertools.product(range(3),repeat=2):\n    for i in range(1000):\n        a,b=shape(t1),shape(t2)\n        c=run(libs[0],t1,a,t2,b)\n        r=run(libs[1],t1,a,t2,b)\n        checked += 1\n        if c \"'!= r:\n            print('\"'MISMATCH',t1,t2,i,a,b)\n            print('C   ',c.hex())\n            print('Rust',r.hex())\n            sys.exit(1)\nprint(f'byte-identical omni_manifold cases: {checked}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
