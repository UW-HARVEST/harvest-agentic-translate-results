N_USE(x)  ((x) >= 0)\n   349\t\n   350\t#define STBDS_HASH_EMPTY      0\n   351\t#define STBDS_HASH_DELETED    1\n   352\t\n   353\tstatic size_t stbds_hash_seed=0x31415926;\n   354\t\n   355\tvoid stbds_rand_seed(size_t seed)\n   356\t{\n   357\t  stbds_hash_seed = seed;\n   358\t}\n   359\t\n   360\t#define stbds_load_32_or_64(var, temp, v32, v64_hi, v64_lo)                                          \\\n   361\t  temp = v64_lo ^ v32, temp <<= 16, temp <<= 16, temp >>= 16, temp >>= 16,                           \\\n   362\t  var = v64_hi, var <<= 16, var <<= 16,                                                              \\\n   363\t  var ^= temp ^ v32\n   364\t\n   365\t#define STBDS_SIZE_T_BITS           ((sizeof (size_t)) * 8)\n   366\t\n   367\tstatic size_t stbds_probe_position(size_t hash, size_t slot_count, size_t slot_log2)\n   368\t{\n   369\t  size_t pos;\n   370\t  STBDS_NOTUSED(slot_log2);\n   371\t  pos = hash & (slot_count-1);\n   372\t  return pos;\n   373\t}\n   374\t\n   375\tstatic size_t stbds_log2(size_t slot_count)\n   376\t{\n   377\t  size_t n=0;\n   378\t  while (slot_count > 1) {\n   379\t    slot_count >>= 1;\n   380\t    ++n;\n   381\t  }\n   382\t  return n;\n   383\t}\n   384\t\n   385\tstatic stbds_hash_index *stbds_make_hash_index(size_t slot_count, stbds_hash_index *ot)\n   386\t{\n   387\t  stbds_hash_index *t;\n   388\t  t = (stbds_hash_index *) STBDS_REALLOC(NULL,0,(slot_count >> STBDS_BUCKET_SHIFT) * sizeof(stbds_hash_bucket) + sizeof(stbds_hash_index) + STBDS_CACHE_LINE_SIZE-1);\n   389\t  t->storage = (stbds_hash_bucket *) STBDS_ALIGN_FWD((size_t) (t+1), STBDS_CACHE_LINE_SIZE);\n   390\t  t->slot_count = slot_count;\n   391\t  t->slot_count_log2 = stbds_log2(slot_count);\n   392\t  t->tombstone_count = 0;\n   393\t  t->used_count = 0;\n   394\t\n   395\t  t->used_count_threshold        = slot_count - (slot_count>>2);\n   396\t  t->tombstone_count_threshold   = (slot_count>>3) + (slot_count>>4);\n   397\t  t->used_count_shrink_t