NGTH];\r\n    86\t\r\n    87\t    entries = (DataEntry*)malloc(count * sizeof(DataEntry));\r\n    88\t\r\n    89\t    if (entries == NULL || count <= 0) {\r\n    90\t        return NULL;\r\n    91\t    }\r\n    92\t\r\n    93\t    for (i = 0; i < count; i++) {\r\n    94\t        entries[i].id = base_id + i;\r\n    95\t        entries[i].value = (base_id + i) * 10;\r\n    96\t\r\n    97\t        sprintf(temp_name, \"Entry_%d\", base_id + i);\r\n    98\t\r\n    99\t        strcpy(entries[i].name, temp_name);\r\n   100\t    }\r\n   101\t\r\n   102\t    return entries;\r\n   103\t}\r\n   104\t\r\n   105\tstatic int modify_entries(DataEntry* entries, int count, int multiplier) {\r\n   106\t    DataEntry* current;\r\n   107\t    DataEntry* last;\r\n   108\t    int total = 0;\r\n   109\t    int temp_value;\r\n   110\t\r\n   111\t    if (entries == NULL) {\r\n   112\t        return -1;\r\n   113\t    }\r\n   114\t\r\n   115\t    current = entries;\r\n   116\t    last = entries + count;\r\n   117\t\r\n   118\t    while (current < last) {\r\n   119\t        if ((temp_value = current->value)) {\r\n   120\t            current->value = temp_value * multiplier;\r\n   121\t            total += current->value;\r\n   122\t        }\r\n   123\t        current++;\r\n   124\t    }\r\n   125\t\r\n   126\t    return total;\r\n   127\t}\r\n   128\t\r\n   129\tint dataentry(int mode, int param1, int param2, int param3) {\r\n   130\t    DataEntry* entries = NULL;\r\n   131\t    DataEntry* found = NULL;\r\n   132\t    int result = 0;\r\n   133\t    int count;\r\n   134\t    int lookup_result;\r\n   135\t    char buffer[NAME_LENGTH];\r\n   136\t    int i;\r\n   137\t\r\n   138\t    buffer[0] = 'T';\r\n   139\t    buffer[1] = '\\0';\r\n   140\t\r\n   141\t    switch (mode) {\r\n   142\t        case 1:\r\n   143\t            count = param1 > 0 ? param1 : 5;\r\n   144\t            entries = create_entries(count, 100);\r\n   145\t\r\n   146\t            if (entries == NULL || count == 0) {\r\n   147\t                result = -1;\r\n   148\t                break;\r\n   149\t            }\r\n   150\t\r\n   151\t            found = find_entry(entries, count, 100 + param2);\r\n   152\t\r\n   153\t            if (found == NULL || found->id == 0) {\r\n   154\t                result = -2;\r\n   155\t            } else {\r\n   156\t                result = found->value;\r\n   157\t\r\n   158\t                strcpy(buffer, found->name);\r\n   159\t            }\r\n   160\t\r\n   161\t            free(entries);\r\n   162\t            break;\r\n   163\t\r\n   164\t        case 2:\r\n   165\t            count = param1 > 0 ? param1 : 3;\r\n   166\t            entries = create_entries(count, 200);\r\n   167\t\r\n   168\t            if (entries == NULL) {\r\n   169\t                result = -1;\r\n   170\t                break;\r\n   171\t            }\r\n   172\t\r\n   173\t            if ((result = modify_entries(entries, count, param2))) {\r\n   174\t                result += param3;\r\n   175\t            }\r\n   176\t\r\n   177\t            free(entries);\r\n   178\t            break;\r\n   179\t\r\n   180\t        case 3:\r\n   181\t            if (param1 >= 0 && param1 < 4 && param2 >= 0 && param2 < 3) {\r\n   182\t                if ((result = calculate_lookup(param1, param2, &lookup_result))) {\r\n   183\t                    result = lookup_result + param3;\r\n   184\t                }\r\n   185\t            }\r\n   186\t            break;\r\n   187\t\r\n   188\t        default:\r\n   189\t            strcpy(buffer, \"Default\");\r\n   190\t            result = process_name(buffer, \"TestName\", NAME_LENGTH);\r\n   191\t\r\n   192\t            if ((count = strlen(buffer))) {\r\n   193\t                result = count * param1;\r\n   194\t            }\r\n   195\t            break;\r\n   196\t    }\r\n   197\t\r\n   198\t    return result;\r\n   199\t}\r\n","exit_code":0,"status":"completed"}}
