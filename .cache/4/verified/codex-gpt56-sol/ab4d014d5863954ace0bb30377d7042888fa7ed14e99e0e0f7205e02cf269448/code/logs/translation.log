    {\n        unsafe {\n            *parsed = temporary as c_int;\n        }\n        true\n    } else {\n        false\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn driver(input: *const c_char) {\n    let mut value = 0;\n    if unsafe { parse_val(input, &mut value) } {\n        unsafe {\n            run(value);\n            run(value);\n        }\n    } else {\n        unsafe {\n            printf(ERROR_MESSAGE.as_ptr().cast());\n        }\n    }\n}\n","exit_code":0,"status":"completed"}}
