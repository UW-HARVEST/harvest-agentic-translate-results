(64 * sizeof(char));\r\n    40\t    if (str == NULL) {\r\n    41\t        return NULL;\r\n    42\t    }\r\n    43\t    snprintf(str, 64, \"Operation: %s, Value: %d\", op, val);\r\n    44\t    return str;\r\n    45\t}\r\n    46\t\r\n    47\tint check_permissions(int perms, int required) {\r\n    48\t    return (perms & required) == required;\r\n    49\t}\r\n    50\t\r\n    51\tint safe_add(int a, int b, int perms) {\r\n    52\t    if (!check_permissions(perms, READ_PERM | WRITE_PERM)) {\r\n    53\t        printf(\"Insufficient permissions for addition\\n\");\r\n    54\t        return 0;\r\n    55\t    }\r\n    56\t    return a + b;\r\n    57\t}\r\n    58\t\r\n    59\tint multiply_with_log(int a, int b, char** log_msg) {\r\n    60\t    *log_msg = create_result_string(\"multiply\", a * b);\r\n    61\t    if (*log_msg == NULL) {\r\n    62\t        return 0;\r\n    63\t    }\r\n    64\t    return a * b;\r\n    65\t}\r\n    66\t\r\n    67\tint copy_and_sum(int* src, int count) {\r\n    68\t    if (src == NULL) {\r\n    69\t        printf(\"Source pointer is NULL\\n\");\r\n    70\t        return -1;\r\n    71\t    }\r\n    72\t\r\n    73\t    int* dest = (int*)malloc(count * sizeof(int));\r\n    74\t    if (dest == NULL) {\r\n    75\t        printf(\"Memory allocation failed\\n\");\r\n    76\t        return -1;\r\n    77\t    }\r\n    78\t\r\n    79\t    memcpy(dest, src, count * sizeof(int));\r\n    80\t\r\n    81\t    int sum = 0;\r\n    82\t    for (int i = 0; i < count; i++) {\r\n    83\t        sum += dest[i];\r\n    84\t    }\r\n    85\t\r\n    86\t    free(dest);\r\n    87\t    return sum;\r\n    88\t}\r\n    89\t\r\n    90\tint compare_operations(const char* op1, const char* op2) {\r\n    91\t    if (op1 == NULL || op2 == NULL) {\r\n    92\t        printf(\"One or both operation strings are NULL\\n\");\r\n    93\t        return -1;\r\n    94\t    }\r\n    95\t\r\n    96\t    return strcmp(op1, op2);\r\n    97\t}\r\n    98\t\r\n    99\tint complexmode(int mode, int value1, int value2, int value3) {\r\n   100\t    int result = 0;\r\n   101\t    char* log_message = NULL;\r\n   102\t\r\n   103\t    int permissions = 0644;  // rw-r--r--\r\n   104\t\r\n   105\t    Result* res_tracker = (Result*)malloc(sizeof(Result));\r\n   106\t    if (res_tracker == NULL) {\r\n   107\t        printf(\"Failed to allocate result tracker\\n\");\r\n   108\t        return -1;\r\n   109\t    }\r\n   110\t\r\n   111\t    res_tracker->value = 0;\r\n   112\t    res_tracker->permissions = permissions;\r\n   113\t    strcpy(res_tracker->operation, \"none\");\r\n   114\t\r\n   115\t    switch (mode) {\r\n   116\t        case 1: {\r\n   117\t            strcpy(res_tracker->operation, \"addition\");\r\n   118\t            result = safe_add(value1, value2, permissions);\r\n   119\t            res_tracker->value = result;\r\n   120\t\r\n   121\t            printf(\"Mode 1: Addition\\n\");\r\n   122\t            printf(\"Result: %d\\n\", result);\r\n   123\t            break;\r\n   124\t        }\r\n   125\t\r\n   126\t        case 2: {\r\n   127\t            strcpy(res_tracker->operation, \"multiplication\");\r\n   128\t            result = multiply_with_log(value1, value2, &log_message);\r\n   129\t            res_tracker->value = result;\r\n   130\t\r\n   131\t            if (log_message == NULL || strcmp(log_message, \"\") == 0) {\r\n   132\t                printf(\"Log message creation failed\\n\");\r\n   133\t            } else {\r\n   134\t                printf(\"Mode 2: %s\\n\", log_message);\r\n   135\t                free(log_message);\r\n   136\t            }\r\n   137\t            break;\r\n   138\t        }\r\n   139\t\r\n   140\t        case 3: {\r\n   141\t            strcpy(res_tracker->operation, \"array_sum\");\r\n   142\t            int values[3] = {value1, value2, value3};\r\n   143\t            result = copy_and_sum(values, 3);\r\n   144\t            res_tracker->value = result;\r\n   145\t\r\n   146\t            printf(\"Mode 3: Array Sum\\