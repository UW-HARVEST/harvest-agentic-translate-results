{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/main.rs'","aggregated_output":"     1\tuse std::ffi::{c_char, c_double, c_int, OsStr};\n     2\tuse std::os::unix::ffi::OsStrExt;\n     3\tuse std::process::ExitCode;\n     4\tuse std::{env, ptr};\n     5\t\n     6\tconst EDOM: c_int = 33;\n     7\tconst ERANGE: c_int = 34;\n     8\t\n     9\t#[repr(C)]\n    10\tstruct CFile {\n    11\t    _private: [u8; 0],\n    12\t}\n    13\t\n    14\tunsafe extern \"C\" {\n    15\t    static mut stderr: *mut CFile;\n    16\t\n    17\t    fn __errno_location() -> *mut c_int;\n    18\t    fn fprintf(stream: *mut CFile, format: *const c_char, ...) -> c_int;\n    19\t    fn printf(format: *const c_char, ...) -> c_int;\n    20\t    fn strtod(input: *const c_char, end: *mut *mut c_char) -> c_double;\n    21\t}\n    22\t\n    23\t#[link(name = \"m\")]\n    24\tunsafe extern \"C\" {\n    25\t    fn pow(base: c_double, exponent: c_double) -> c_double;\n    26\t}\n    27\t\n    28\tfn as_c_argument(argument: &OsStr) -> Vec<u8> {\n    29\t    let mut bytes = argument.as_bytes().to_vec();\n    30\t    bytes.push(0);\n    31\t    bytes\n    32\t}\n    33\t\n    34\tfn errno() -> c_int {\n    35\t    // SAFETY: libc provides a valid thread-local errno pointer.\n    36\t    unsafe { *__errno_location() }\n    37\t}\n    38\t\n    39\tfn set_errno(value: c_int) {\n    40\t    // SAFETY: libc provides a valid thread-local errno pointer.\n    41\t    unsafe {\n    42\t        *__errno_location() = value;\n    43\t    }\n    44\t}\n    45\t\n    46\tfn convert(argument: &[u8]) -> (c_double, c_int, bool) {\n    47\t    let mut end = ptr::null_mut();\n    48\t    set_errno(0);\n    49\t\n    50\t    // SAFETY: argument is NUL-terminated and end points to writable storage.\n    51\t    let value = unsafe { strtod(argument.as_ptr().cast(), &mut end) };\n    52\t    let conversion_errno = errno();\n    53\t    // SAFETY: strtod sets end to a location within the live argument buffer.\n    54\t    let has_trailing_input = unsafe { *end != 0 };\n    55\t\n    56\t    (value, conversion_errno, has_trailing_input)\n    57\t}\n    58\t\n    59\tfn run() -> u8 {\n    60\t    let arguments: Vec<Vec<u8>> = env::args_os()\n    61\t        .map(|argument| as_c_argument(&argument))\n    62\t        .collect();\n    63\t\n    64\t    if arguments.len() != 3 {\n    65\t        let program: *const c_char = arguments\n    66\t            .first()\n    67\t            .map_or(ptr::null(), |argument| argument.as_ptr().cast());\n    68\t        // SAFETY: the format is NUL-terminated and program is a C string or NULL.\n    69\t        unsafe {\n    70\t            fprintf(stderr, c\"Usage: %s base exponent\\n\".as_ptr(), program);\n    71\t        }\n    72\t        return 1;\n    73\t    }\n    74\t\n    75\t    let (base, base_errno, base_has_trailing_input) = convert(&arguments[1]);\n    76\t    if base_errno == ERANGE {\n    77\t        // SAFETY: the format and argument are NUL-terminated C strings.\n    78\t        unsafe {\n    79\t            fprintf(\n    80\t                stderr,\n    81\t                c\"Range error while converting base '%s'\\n\".as_ptr(),\n    82\t                arguments[1].as_ptr(),\n    83\t            );\n    84\t        }\n    85\t        return 1;\n    86\t    } else if base_has_trailing_input {\n    87\t        // SAFETY: the format and argument are NUL-terminated C strings.\n    88\t        unsafe {\n    89\t            fprintf(\n    90\t                stderr,\n    91\t                c\"Invalid numeric input for base: '%s'\\n\".as_ptr(),\n    92\t                arguments[1].as_ptr(),\n    93\t            );\n    94\t        }\n    95\t        return 1;\n    96\t    }\n    97\t\n    98\t    let (exponent, exponent_errno, exponent_has_trailing_input) = convert(&arguments[2]);\n    99\t    if exponent_errno == ERANGE {\n   100\t        // SAFETY: the format and argument are NUL-terminated C strings.\n   101\t        unsafe {\n   102\t            fprintf(\n   103\t                stderr,\n   104\t                c\"Range error while converting exponent '%s'\\n\".as_ptr(),\n   105\t                arguments[2].as_ptr(),\n   106\t            );\n   107\t        }\n   108\t        return 1;\n   109\t    } else if exponent_has_trailing_input {\n   110\t        // SAFETY: the format and argument are NUL-terminated C strings.\n   111\t        unsafe {\n   112\t            fprintf(\n   113\t                stderr,\n   114\t                c\"Invalid numeric input for exponent: '%s'\\n\".as_ptr(),\n   115\t                arguments[2].as_ptr(),\n   116\t            );\n   117\t        }\n   118\t        return 1;\n   119\t    }\n   120\t\n   121\t    set_errno(0);\n   122\t    // SAFETY: pow accepts every pair of double values.\n   123\t    let result = unsafe { pow(base, exponent) };\n   124\t    let power_errno = errno();\n   125\t    if power_errno == EDOM {\n   126\t        // SAFETY: the format is NUL-terminated and both values are doubles.\n   127\t        unsafe {\n   128\t            fprintf(\n   129\t                stderr,\n   130\t                c\"Domain error: pow(%.2f, %.2f) is undefined in the real number domain.\\n\".as_ptr(),\n   131\t                base,\n   132\t                exponent,\n   133\t            );\n   134\t        }\n   135\t        return 1;\n   136\t    } else if power_errno == ERANGE {\n   137\t        // SAFETY: the format is NUL-terminated and both values are doubles.\n   138\t        unsafe {\n   139\t            fprintf(\n   140\t                stderr,\n   141\t                c\"Range error: pow(%.2f, %.2f) caused overflow or underflow.\\n\".as_ptr(),\n   142\t                base,\n   143\t                exponent,\n   144\t            );\n   145\t        }\n   146\t        return 1;\n   147\t    }\n   148\t\n   149\t    // SAFETY: the format is NUL-terminated and result is a double.\n   150\t    unsafe {\n   151\t        printf(c\"Result: %.2f\\n\".as_ptr(), result);\n   152\t    }\n   153\t    0\n   154\t}\n   155\t\n   156\tfn main() -> ExitCode {\n   157\t    ExitCode::from(run())\n   158\t}\n","exit_code":0,"status":"completed"}}
