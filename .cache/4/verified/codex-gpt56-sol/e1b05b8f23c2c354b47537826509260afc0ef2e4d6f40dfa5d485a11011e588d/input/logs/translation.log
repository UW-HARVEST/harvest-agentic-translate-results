{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes\nimport random\n\npaths = [\n    '.reference-c-build/libtranslated_rust_c.so',\n    'target/release/libtranslated_rust.so',\n]\nfuncs = []\nfor path in paths:\n    lib = ctypes.CDLL(path)\n    fn = lib.wcscat\n    fn.argtypes = [ctypes.POINTER(ctypes.c_int32), ctypes.c_size_t, ctypes.POINTER(ctypes.c_int32)]\n    fn.restype = ctypes.c_int\n    funcs.append(fn)\n\ndef invoke(fn, dst_values, n, src_values=None):\n    dst_type = ctypes.c_int32 * len(dst_values)\n    dst = dst_type(*dst_values)\n    if src_values is None:\n        src = None\n    else:\n        src_type = ctypes.c_int32 * len(src_values)\n        src = src_type(*src_values)\n    result = fn(dst, n, src)\n    return result, bytes(dst)\n\ndef compare(dst, n, src):\n    got = [invoke(fn, dst, n, src) for fn in funcs]\n    assert got[0] == got[1], (dst, n, src, got)\n\nfixed = [\n    ([1, 2, 3], 0, [4, 0]),\n    ([1, 2, 0, 9], 4, None),\n    ([1, 2, 0, 9, 9], 5, [3, 4, 0]),\n    ([0, 9, 9], 3, [7, 0]),\n    ([1, 2, 3, 4], 4, [5, 0]),\n    ([1, 0, 9], 3, [2, 3, 0]),\n    ([1, 0, 9, 9], 4, [2, 3, 0]),\n]\nfor case in fixed:\n    compare(*case)\n\nfor _ in range(10000):\n    size = random.randint(1, 32)\n    n = random.randint(0, size)\n    dst = [random.randint(-20, 20) or 1 for _ in range(size)]\n    if random.random() < 0.75:\n        dst[random.randrange(size)] = 0\n    if random.random() < 0.02:\n        src = None\n    else:\n        src = [random.randint(-20, 20) or 1 for _ in range(size + 2)]\n        if random.random() < 0.8:\n            src[random.randrange(size + 1)] = 0\n        src[-1] = 0\n    compare(dst, n, src)\n\nfor fn in funcs:\n    assert fn(None, 8, None) == 22\n\nprint(f'differential cases passed: {len(fixed) + 10000 + 1}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
