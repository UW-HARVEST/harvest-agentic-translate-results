\n    67\t    char data;\n    68\t    data = ' ';\n    69\t    data = CHAR_MAX;\n    70\t    if(data > 0)\n    71\t    {\n    72\t        if (data < (CHAR_MAX/2))\n    73\t        {\n    74\t            char result = data * 2;\n    75\t            printHexCharLine(result);\n    76\t        }\n    77\t        else\n    78\t        {\n    79\t            printLine(\"data value is too large to perform arithmetic safely.\");\n    80\t        }\n    81\t    }\n    82\t}\n    83\t\n    84\tvoid good()\n    85\t{\n    86\t    goodG2B();\n    87\t    goodB2G();\n    88\t}\n    89\t\n    90\tvoid driver(int useGood) {\n    91\t    if (useGood)\n    92\t    {\n    93\t        good();\n    94\t    }\n    95\t    else\n    96\t    {\n    97\t        bad();\n    98\t    }\n    99\t}\n","exit_code":0,"status":"completed"}}
