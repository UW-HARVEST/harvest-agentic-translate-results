int::from(d2 < r2)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn c2AABBtoAABB(a: C2Aabb, b: C2Aabb) -> c_int {\n    let d0 = c_int::from(b.max.x < a.min.x);\n    let d1 = c_int::from(a.max.x < b.min.x);\n    let d2 = c_int::from(b.max.y < a.min.y);\n    let d3 = c_int::from(a.max.y < b.min.y);\n    c_int::from((d0 | d1 | d2 | d3) == 0)\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn collided(\n    a: *const c_void,\n    type_a: c_int,\n    b: *const c_void,\n    type_b: c_int,\n) -> c_int {\n    match type_a {\n        C2_TYPE_CIRCLE => match type_b {\n            C2_TYPE_CIRCLE => {\n                // These loads have the same validity requirements as the C struct dereferences.\n                unsafe { c2CircletoCircle(*a.cast::<C2Circle>(), *b.cast::<C2Circle>()) }\n            }\n            C2_TYPE_AABB => unsafe {\n                c2CircletoAABB(*a.cast::<C2Circle>(), *b.cast::<C2Aabb>())\n            },\n            _ => 0,\n        },\n        C2_TYPE_AABB => match type_b {\n            C2_TYPE_CIRCLE => unsafe {\n                c2CircletoAABB(*b.cast::<C2Circle>(), *a.cast::<C2Aabb>())\n            },\n            C2_TYPE_AABB => unsafe {\n                c2AABBtoAABB(*a.cast::<C2Aabb>(), *b.cast::<C2Aabb>())\n            },\n            _ => 0,\n        },\n        _ => 0,\n    }\n}\n","exit_code":0,"status":"completed"}}
