{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc 'nl -ba c_src/src/lib.c'","aggregated_output":"     1\t#include \"lib.h\"\r\n     2\t\r\n     3\ttypedef enum {\r\n     4\t    C2_TYPE_CIRCLE,\r\n     5\t    C2_TYPE_AABB,\r\n     6\t    C2_TYPE_CAPSULE,\r\n     7\t} C2_TYPE;\r\n     8\t\r\n     9\ttypedef struct c2v {\r\n    10\t\tfloat x;\r\n    11\t\tfloat y;\r\n    12\t} c2v;\r\n    13\t\r\n    14\ttypedef struct c2Circle {\r\n    15\t\tc2v p;\r\n    16\t\tfloat r;\r\n    17\t} c2Circle;\r\n    18\t\r\n    19\ttypedef struct c2AABB {\r\n    20\t\tc2v min;\r\n    21\t\tc2v max;\r\n    22\t} c2AABB;\r\n    23\t\r\n    24\ttypedef struct c2Capsule {\r\n    25\t\tc2v a;\r\n    26\t\tc2v b;\r\n    27\t\tfloat r;\r\n    28\t} c2Capsule;\r\n    29\t\r\n    30\tc2v c2V(float x, float y) {\r\n    31\t\tc2v a;\r\n    32\t\ta.x = x;\r\n    33\t\ta.y = y;\r\n    34\t\treturn a;\r\n    35\t}\r\n    36\t\r\n    37\tc2v c2Mulvs(c2v a, float b) {\r\n    38\t\ta.x *= b;\r\n    39\t\ta.y *= b;\r\n    40\t\treturn a;\r\n    41\t}\r\n    42\t\r\n    43\tc2v c2Maxv(c2v a, c2v b) {\r\n    44\t\treturn c2V(((a.x) > (b.x) ? (a.x) : (b.x)),\r\n    45\t\t\t\t((a.y) > (b.y) ? (a.y) : (b.y)));\r\n    46\t}\r\n    47\t\r\n    48\tc2v c2Minv(c2v a, c2v b) {\r\n    49\t\treturn c2V(((a.x) < (b.x) ? (a.x) : (b.x)),\r\n    50\t\t\t\t((a.y) < (b.y) ? (a.y) : (b.y)));\r\n    51\t}\r\n    52\t\r\n    53\tc2v c2Clampv(c2v a, c2v lo, c2v hi) {\r\n    54\t\treturn c2Maxv(lo, c2Minv(a, hi));\r\n    55\t}\r\n    56\t\r\n    57\tc2v c2Sub(c2v a, c2v b) {\r\n    58\t\ta.x -= b.x;\r\n    59\t\ta.y -= b.y;\r\n    60\t\treturn a;\r\n    61\t}\r\n    62\t\r\n    63\tfloat c2Dot(c2v a, c2v b) {\r\n    64\t\treturn a.x * b.x + a.y * b.y;\r\n    65\t}\r\n    66\t\r\n    67\tint c2CircletoCircle(c2Circle A, c2Circle B) {\r\n    68\t\tc2v c = c2Sub(B.p, A.p);\r\n    69\t\tfloat d2 = c2Dot(c, c);\r\n    70\t\tfloat r2 = A.r + B.r;\r\n    71\t\tr2 = r2 * r2;\r\n    72\t\treturn d2 < r2;\r\n    73\t}\r\n    74\t\r\n    75\tint c2CircletoAABB(c2Circle A, c2AABB B) {\r\n    76\t\tc2v L = c2Clampv(A.p, B.min, B.max);\r\n    77\t\tc2v ab = c2Sub(A.p, L);\r\n    78\t\tfloat d2 = c2Dot(ab, ab);\r\n    79\t\tfloat r2 = A.r * A.r;\r\n    80\t\treturn d2 < r2;\r\n    81\t}\r\n    82\t\r\n    83\tint c2CircletoCapsule(c2Circle A, c2Capsule B) {\r\n    84\t\tc2v n = c2Sub(B.b, B.a);\r\n    85\t\tc2v ap = c2Sub(A.p, B.a);\r\n    86\t\tfloat da = c2Dot(ap, n);\r\n    87\t\tfloat d2;\r\n    88\t\tif (da < 0)\r\n    89\t\t\td2 = c2Dot(ap, ap);\r\n    90\t\telse {\r\n    91\t\t\tfloat db = c2Dot(c2Sub(A.p, B.b), n);\r\n    92\t\t\tif (db < 0) {\r\n    93\t\t\t\tc2v e = c2Sub(ap, c2Mulvs(n, (da / c2Dot(n, n))));\r\n    94\t\t\t\td2 = c2Dot(e, e);\r\n    95\t\t\t} else {\r\n    96\t\t\t\tc2v bp = c2Sub(A.p, B.b);\r\n    97\t\t\t\td2 = c2Dot(bp, bp);\r\n    98\t\t\t}\r\n    99\t\t}\r\n   100\t\tfloat r = A.r + B.r;\r\n   101\t\treturn d2 < r * r;\r\n   102\t}\r\n   103\t\r\n   104\tint c2Collided(const void *A, const void *B, C2_TYPE typeB) {\r\n   105\t\tswitch (typeB) {\r\n   106\t\t\tcase C2_TYPE_CIRCLE:\r\n   107\t\t\t\treturn c2CircletoCircle(*(c2Circle *)A, *(c2Circle *)B);\r\n   108\t\t\tcase C2_TYPE_AABB:\r\n   109\t\t\t\treturn c2CircletoAABB(*(c2Circle *)A, *(c2AABB *)B);\r\n   110\t\t\tcase C2_TYPE_CAPSULE:\r\n   111\t\t\t\treturn c2CircletoCapsule(*(c2Circle *)A, *(c2Capsule *)B);\r\n   112\t\t\tdefault:\r\n   113\t\t\t\treturn 0;\r\n   114\t\t}\r\n   115\t}\r\n   116\t\r\n   117\tint circle_collide(float x, float y, float r) {\r\n   118\t\tint result = 0;\r\n   119\t\r\n   120\t\tc2Circle circle_in;\r\n   121\t\tcircle_in.p = c2V(x, y);\r\n   122\t\tcircle_in.r = r;\r\n   123\t\r\n   124\t\tc2Circle circle;\r\n   125\t\tcircle.p = c2V(-70.0f, 0);\r\n   126\t\tcircle.r = 20.0f;\r\n   127\t\r\n   128\t\tc2AABB aabb;\r\n   129\t\taabb.min = c2V(-40.0f, -40.0f);\r\n   130\t\taabb.max = c2V(-15.0f, -15.0f);\r\n   131\t\r\n   132\t\tc2Capsule