\t                    break 'search;\n   691\t                } else if tombstone < 0 && (*bucket).index[item] == INDEX_DELETED {\n   692\t                    tombstone = ((position & !BUCKET_MASK) + item) as isize;\n   693\t                }\n   694\t            }\n   695\t        }\n   696\t\n   697\t        let limit = position & BUCKET_MASK;\n   698\t        for item in 0..limit {\n   699\t            unsafe {\n   700\t                if (*bucket).hash[item] == item_hash {\n   701\t                    if is_key_equal(\n   702\t                        raw_hash_array,\n   703\t                        element_size,\n   704\t                        key,\n   705\t                        key_size,\n   706\t                        0,\n   707\t                        mode,\n   708\t                        (*bucket).index[item] as usize,\n   709\t                    ) {\n   710\t                        (*header(array)).temp = (*bucket).index[item];\n   711\t                        return array_to_hash(array, element_size);\n   712\t                    }\n   713\t                } else if (*bucket).hash[item] == HASH_EMPTY {\n   714\t                    position = (position & !BUCKET_MASK) + item;\n   715\t                    break 'search;\n   716\t                } else if tombstone < 0 && (*bucket).index[item] == INDEX_DELETED {\n   717\t                    tombstone = ((position & !BUCKET_MASK) + item) as isize;\n   718\t                }\n   719\t            }\n   720\t        }\n   721\t\n   722\t        position = position.wrapping_add(step);\n   723\t        step = step.wrapping_add(BUCKET_LENGTH);\n   724\t        position &= unsafe { (*table).slot_count - 1 };\n   725\t    }\n   726\t\n   727\t    unsafe {\n   728\t        if tombstone >= 0 {\n   729\t            position = tombstone as usize;\n   730\t            (*table).tombstone_count -= 1;\n   731\t        }\n   732\t        (*table).used_count += 1;\n   733\t\n   734\t        let item_index = array_length(array) as isize;\n   735\t        if item_index as usize + 1 > array_capacity(array) {\n   736\t            array = stbds_arrgrowf(array, element_size, 1, 0);\n   737\t        }\n   738\t        assert!(item_index as usize + 1 <= array_capacity(array));\n   739\t        (*header(array)).length = item_index as usize + 1;\n   740\t        let bucket = (*table).storage.add(position >> BUCKET_SHIFT);\n   741\t        (*bucket).hash[position & BUCKET_MASK] = item_hash;\n   742\t        (*bucket).index[position & BUCKET_MASK] = item_index - 1;\n   743\t        (*header(array)).temp = item_index - 1;\n   744\t\n   745\t        let item_key = (array as *mut u8)\n   746\t            .add(element_size.wrapping_mul(item_index as usize))\n   747\t            .cast::<*mut c_char>();\n   748\t        match (*table).string.mode {\n   749\t            SH_STRDUP => {\n   750\t                let stored = duplicate_string(key.cast());\n   751\t                *item_key = stored;\n   752\t                (*table).temp_key = stored;\n   753\t            }\n   754\t            SH_ARENA => {\n   755\t                let stored = stbds_stralloc(ptr::addr_of_mut!((*table).string), key.cast());\n   756\t                *item_key = stored;\n   757\t                (*table).temp_key = stored;\n   758\t            }\n   759\t            SH_DEFAULT => {\n   760\t                let stored = key.cast::<c_char>();\n   761\t                *item_key = stored;\n   762\t                (*table).temp_key = stored;\n   763\t            }\n   764\t            _ => {\n   765\t                ptr::copy_nonoverlapping(key.cast::<u8>(), item_key.cast::<u8>(), key_size);\n   766\t            }\n   767\t        }\n   768\t        array_to_hash(array, element_size)\n   769\t    }\n   770\t}\n   771\t\n   772\t#[unsafe(no_mangle)]\n   773\tpub unsafe extern \"C\" fn stbds_shmode_func(element_size: usize, mode: c_int) -> *mut c_void {\n   774\t    let array = unsafe { stbds_arrgrowf(ptr::null_mut(), element_siz