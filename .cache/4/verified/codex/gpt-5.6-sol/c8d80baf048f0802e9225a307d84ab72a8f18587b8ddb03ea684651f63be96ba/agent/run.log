{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/lib.rs'","aggregated_output":"     1\t/// Converts an IEEE 754 binary16 bit pattern to binary32.\n     2\t#[unsafe(no_mangle)]\n     3\tpub extern \"C\" fn half2float(h: u16) -> f32 {\n     4\t    let sign = u32::from(h & 0x8000) << 16;\n     5\t    let exponent = (h >> 10) & 0x1f;\n     6\t    let fraction = u32::from(h & 0x03ff);\n     7\t\n     8\t    let bits = match exponent {\n     9\t        0 if fraction == 0 => sign,\n    10\t        0 => {\n    11\t            let shift = fraction.leading_zeros() - 21;\n    12\t            let normalized_fraction = (fraction << shift) & 0x03ff;\n    13\t            let normalized_exponent = 113 - shift;\n    14\t            sign | (normalized_exponent << 23) | (normalized_fraction << 13)\n    15\t        }\n    16\t        31 => sign | 0x7f80_0000 | (fraction << 13),\n    17\t        _ => sign | (u32::from(exponent + 112) << 23) | (fraction << 13),\n    18\t    };\n    19\t\n    20\t    f32::from_bits(bits)\n    21\t}\n    22\t\n    23\t#[cfg(test)]\n    24\tmod tests {\n    25\t    use super::half2float;\n    26\t\n    27\t    fn reference_bits(h: u16) -> u32 {\n    28\t        let sign = u32::from(h & 0x8000) << 16;\n    29\t        let exponent = u32::from((h >> 10) & 0x1f);\n    30\t        let fraction = u32::from(h & 0x03ff);\n    31\t\n    32\t        if exponent == 0 {\n    33\t            if fraction == 0 {\n    34\t                return sign;\n    35\t            }\n    36\t\n    37\t            let mut mantissa = fraction;\n    38\t            let mut output_exponent = 113_u32;\n    39\t            while mantissa & 0x0400 == 0 {\n    40\t                mantissa <<= 1;\n    41\t                output_exponent -= 1;\n    42\t            }\n    43\t            sign | (output_exponent << 23) | ((mantissa & 0x03ff) << 13)\n    44\t        } else if exponent == 31 {\n    45\t            sign | 0x7f80_0000 | (fraction << 13)\n    46\t        } else {\n    47\t            sign | ((exponent + 112) << 23) | (fraction << 13)\n    48\t        }\n    49\t    }\n    50\t\n    51\t    #[test]\n    52\t    fn matches_reference_for_every_input() {\n    53\t        for h in u16::MIN..=u16::MAX {\n    54\t            assert_eq!(half2float(h).to_bits(), reference_bits(h), \"input {h:#06x}\");\n    55\t        }\n    56\t    }\n    57\t}\n","exit_code":0,"status":"completed"}}
