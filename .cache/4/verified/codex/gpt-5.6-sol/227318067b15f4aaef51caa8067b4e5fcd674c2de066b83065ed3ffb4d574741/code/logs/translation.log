    return counter;\r\n    42\t}\r\n    43\t\r\n    44\tint multiply_counter(int value) {\r\n    45\t    counter *= value;\r\n    46\t    return counter;\r\n    47\t}\r\n    48\t\r\n    49\tint reset_counter(int value) {\r\n    50\t    counter = value;\r\n    51\t    return counter;\r\n    52\t}\r\n    53\t\r\n    54\tint is_string_empty(const char *str) {\r\n    55\t    if (!str) return 1;\r\n    56\t    if (*str) {\r\n    57\t        return 0;\r\n    58\t    }\r\n    59\t    return 1;\r\n    60\t}\r\n    61\t\r\n    62\tchar* find_char_in_buffer(const char *buffer, size_t size, char target) {\r\n    63\t    if (!buffer) return NULL;\r\n    64\t    return (char*)memchr(buffer, target, size);\r\n    65\t}\r\n    66\t\r\n    67\tchar* create_buffer(const char *initial) {\r\n    68\t    if (!initial) return NULL;\r\n    69\t\r\n    70\t    size_t len = strlen(initial);\r\n    71\t    char *buffer = (char*)malloc(len + 1);\r\n    72\t\r\n    73\t    if (buffer) {\r\n    74\t        strcpy(buffer, initial);\r\n    75\t    }\r\n    76\t\r\n    77\t    return buffer;\r\n    78\t}\r\n    79\t\r\n    80\tint validate_uint16_range(int value) {\r\n    81\t    if (value < 0) return 0;\r\n    82\t    if (value > UINT16_MAX) return 0;\r\n    83\t    return 1;\r\n    84\t}\r\n    85\t\r\n    86\tint apply_operation(operation_func op, int value) {\r\n    87\t    if (!op) return -1;\r\n    88\t    return op(value);\r\n    89\t}\r\n    90\t\r\n    91\t// TODO: lib test stdout\r\n    92\tint charinbuf(int mode, int value, int opt1, int opt2) {\r\n    93\t    int result = 0;\r\n    94\t    char *buffer = NULL;\r\n    95\t    char *found_pos = NULL;\r\n    96\t    const char *test_string = \"\";\r\n    97\t    const char *non_empty_string = \"Hello, World!\";\r\n    98\t\r\n    99\t    operation_func current_op = NULL;\r\n   100\t\r\n   101\t    counter = 0;\r\n   102\t\r\n   103\t    switch (mode) {\r\n   104\t        case 0:\r\n   105\t            printf(\"Mode 0: UINT16_MAX validati