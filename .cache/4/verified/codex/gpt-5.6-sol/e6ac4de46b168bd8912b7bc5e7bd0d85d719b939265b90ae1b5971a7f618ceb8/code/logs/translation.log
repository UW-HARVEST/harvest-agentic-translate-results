} else {\r\n    90\t        result = (val1 * flags->log_level) + (val2 / 2);\r\n    91\t    }\r\n    92\t\r\n    93\t    if (flags->debug) {\r\n    94\t        printf(\"Debug: operation_mode = %o (octal)\\n\", operation_mode);\r\n    95\t        printf(\"Debug: result before adjustment = %d\\n\", result);\r\n    96\t    }\r\n    97\t\r\n    98\t    return result;\r\n    99\t}\r\n   100\t\r\n   101\tint apply_bit_operations(int value, struct ConfigFlags* flags) {\r\n   102\t    int adjusted = value;\r\n   103\t\r\n   104\t    if (flags->verbose) {\r\n   105\t        adjusted = adjusted << 1;\r\n   106\t    }\r\n   107\t\r\n   108\t    if (flags->cache_enabled) {\r\n   109\t        adjusted = adjusted | 0x0F;\r\n   110\t    }\r\n   111\t\r\n   112\t    return adjusted;\r\n   113\t}\r\n   114\t\r\n   115\tint envy(int param1, int param2, int param3, int param4) {\r\n   116\t    struct ProcessState state;\r\n   117\t    struct ProcessState state_backup;\r\n   118\t    char buffer[BUFFER_SIZE];\r\n   119\t    int result = 0;\r\n   120\t\r\n   121\t    init_config_from_env(&state.flags);\r\n   122\t\r\n   123\t    int base_offset = parse_env_numeric(\"PROG_BASE_OFFSET\", 0100);\r\n   124\t    int multiplier = parse_env_numeric(\"PROG_MULTIPLIER\", 012);\r\n   125\t\r\n   126\t    if (state.flags.verbose) {\r\n   127\t        printf(\"Verbose mode enabled\\n\");\r\n   128\t        printf(\"Base offset: %d (from octal 0100)\\n\", base_offset);\r\n   129\t        printf(\"Multiplier: %d (from octal 012)\\n\", multiplier);\r\n   130\t    }\r\n   131\t\r\n   132\t    state.base_value = param1;\r\n   133\t    state.multiplier = multiplier;\r\n   134\t    state.operation = '+';\r\n   135\t\r\n   136\t    memcpy(&state_backup, &state, sizeof(struct ProcessState));\r\n   137\t\r\n   138\t    if (state.flags.debug) {\r\n   139\t        printf(\"Debug: Created state backup using memcpy\\n\");\r\n   140\t        printf(\"Debug: Backup base_value = %d\\n\", state_backup.base_value);\r