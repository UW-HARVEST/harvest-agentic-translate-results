{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"nl -ba c_src/include/lib.h; printf '%s\\\\n' '--- lib.c ---'; nl -ba c_src/src/lib.c\"","aggregated_output":"     1\t#include <stdint.h>\n     2\t\n     3\ttypedef struct cp_pixel_t {\n     4\t    uint8_t r;\n     5\t    uint8_t g;\n     6\t    uint8_t b;\n     7\t    uint8_t a;\n     8\t} cp_pixel_t;\n     9\t\n    10\ttypedef struct cp_image_t {\n    11\t    int w;\n    12\t    int h;\n    13\t    cp_pixel_t *pix;\n    14\t} cp_image_t;\n    15\t\n    16\tvoid flip_horizontal(cp_image_t *img);\n--- lib.c ---\n     1\t#include \"lib.h\"\r\n     2\t\r\n     3\tvoid flip_horizontal(cp_image_t *img) {\r\n     4\t    cp_pixel_t *pix = img->pix;\r\n     5\t    int w = img->w;\r\n     6\t    int h = img->h;\r\n     7\t    int flips = h / 2;\r\n     8\t    for (int i = 0; i < flips; ++i) {\r\n     9\t        cp_pixel_t *a = pix + w * i;\r\n    10\t        cp_pixel_t *b = pix + w * (h - i - 1);\r\n    11\t        for (int j = 0; j < w; ++j) {\r\n    12\t            cp_pixel_t t = *a;\r\n    13\t            *a = *b;\r\n    14\t            *b = t;\r\n    15\t            ++a;\r\n    16\t            ++b;\r\n    17\t        }\r\n    18\t    }\r\n    19\t}\r\n","exit_code":0,"status":"completed"}}
