{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/main.rs'","aggregated_output":"     1\tuse std::env;\n     2\tuse std::fmt::Write as FmtWrite;\n     3\tuse std::io::{self, Read, Write};\n     4\tuse std::os::unix::ffi::OsStrExt;\n     5\tuse std::process;\n     6\t\n     7\tconst LUGGAGE_ID_LENGTH: usize = 8;\n     8\tconst FLIGHT_ID_LENGTH: usize = 6;\n     9\tconst AIRPORT_CODE_LENGTH: usize = 3;\n    10\tconst COMMENTS_LENGTH: usize = 80;\n    11\t\n    12\tstruct RoutingDirective {\n    13\t    time_stamp: u32,\n    14\t    luggage_id: Vec<u8>,\n    15\t    flight_id: Vec<u8>,\n    16\t    departure: Vec<u8>,\n    17\t    arrival: Vec<u8>,\n    18\t    comments: Vec<u8>,\n    19\t}\n    20\t\n    21\tstruct Scanner {\n    22\t    input: Vec<u8>,\n    23\t    position: usize,\n    24\t}\n    25\t\n    26\timpl Scanner {\n    27\t    fn new(input: Vec<u8>) -> Self {\n    28\t        Self { input, position: 0 }\n    29\t    }\n    30\t\n    31\t    fn skip_whitespace(&mut self) {\n    32\t        while self\n    33\t            .input\n    34\t            .get(self.position)\n    35\t            .is_some_and(|byte| is_c_whitespace(*byte))\n    36\t        {\n    37\t            self.position += 1;\n    38\t        }\n    39\t    }\n    40\t\n    41\t    fn scan_timestamp(&mut self, value: &mut u32) -> i32 {\n    42\t        self.skip_whitespace();\n    43\t        if self.position == self.input.len() {\n    44\t            return -1;\n    45\t        }\n    46\t\n    47\t        let start = self.position;\n    48\t        let negative = match self.input[self.position] {\n    49\t            b'-' => {\n    50\t                self.position += 1;\n    51\t                true\n    52\t            }\n    53\t            b'+' => {\n    54\t                self.position += 1;\n    55\t                false\n    56\t            }\n    57\t            _ => false,\n    58\t        };\n    59\t        let digits_start = self.position;\n    60\t        let mut magnitude = 0_u128;\n    61\t        while let Some(byte @ b'0'..=b'9') = self.input.get(self.position).copied() {\n    62\t            magnitude = magnitude\n    63\t                .saturating_mul(10)\n    64\t                .saturating_add(u128::from(byte - b'0'));\n    65\t            self.position += 1;\n    66\t        }\n    67\t\n    68\t        if self.position == digits_start {\n    69\t            self.position = start;\n    70\t            return 0;\n    71\t        }\n    72\t\n    73\t        let signed = if negative {\n    74\t            if magnitude >= (i64::MAX as u128) + 1 {\n    75\t                i64::MIN\n    76\t            } else {\n    77\t                -(magnitude as i64)\n    78\t            }\n    79\t        } else if magnitude > i64::MAX as u128 {\n    80\t            i64::MAX\n    81\t        } else {\n    82\t            magnitude as i64\n    83\t        };\n    84\t        *value = signed as u32;\n    85\t\n    86\t        // The whitespace at the end of \"%d \" consumes across line boundaries.\n    87\t        self.skip_whitespace();\n    88\t        1\n    89\t    }\n    90\t\n    91\t    fn scan_set<F>(&mut self, maximum: usize, output: &mut Vec<u8>, accepts: F) -> i32\n    92\t    where\n    93\t        F: Fn(u8) -> bool,\n    94\t    {\n    95\t        if self.position == self.input.len() {\n    96\t            return -1;\n    97\t        }\n    98\t        if !accepts(self.input[self.position]) {\n    99\t            return 0;\n   100\t        }\n   101\t\n   102\t        output.clear();\n   103\t        while output.len() < maximum {\n   104\t            let Some(&byte) = self.input.get(self.position) else {\n   105\t                break;\n   106\t            };\n   107\t            if !accepts(byte) {\n   108\t                break;\n   109\t            }\n   110\t            output.push(byte);\n   111\t            self.position += 1;\n   112\t        }\n   113\t        1\n   114\t    }\n   115\t\n   116\t    fn scan_ids(&mut self, luggage_id: &mut Vec<u8>, flight_id: &mut Vec<u8>) -> i32 {\n   117\t        let first = self.scan_set(LUGGAGE_ID_LENGTH, luggage_id, is_uppercase_or_digit);\n   118\t        if first <= 0 {\n   119\t            return first;\n   120\t        }\n   121\t\n   122\t        self.skip_whitespace();\n   123\t        let second = self.scan_set(FLIGHT_ID_LENGTH, flight_id, is_uppercase_or_digit);\n   124\t        if second <= 0 {\n   125\t            return 1;\n   126\t        }\n   127\t\n   128\t        self.skip_whitespace();\n   129\t        2\n   130\t    }\n   131\t\n   132\t    fn scan_airports(&mut self, departure: &mut Vec<u8>, arrival: &mut Vec<u8>) -> i32 {\n   133\t        let first = self.scan_set(AIRPORT_CODE_LENGTH, departure, is_uppercase);\n   134\t        if first <= 0 {\n   135\t            return first;\n   136\t        }\n   137\t\n   138\t        self.skip_whitespace();\n   139\t        let second = self.scan_set(AIRPORT_CODE_LENGTH, arrival, is_uppercase);\n   140\t        if second <= 0 {\n   141\t            return 1;\n   142\t        }\n   143\t        2\n   144\t    }\n   145\t\n   146\t    fn scan_comments(&mut self, comments: &mut Vec<u8>) -> i32 {\n   147\t        self.scan_set(COMMENTS_LENGTH, comments, |byte| byte != b'\\n')\n   148\t    }\n   149\t}\n   150\t\n   151\tfn is_c_whitespace(byte: u8) -> bool {\n   152\t    matches!(byte, b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r')\n   153\t}\n   154\t\n   155\tfn is_uppercase(byte: u8) -> bool {\n   156\t    byte.is_ascii_uppercase()\n   157\t}\n   158\t\n   159\tfn is_uppercase_or_digit(byte: u8) -> bool {\n   160\t    byte.is_ascii_uppercase() || byte.is_ascii_digit()\n   161\t}\n   162\t\n   163\tfn as_c_string(bytes: &[u8]) -> Vec<u8> {\n   164\t    bytes\n   165\t        .iter()\n   166\t        .copied()\n   167\t        .take_while(|byte| *byte != 0)\n   168\t        .collect()\n   169\t}\n   170\t\n   171\tfn add_routing_directive_to_list(\n   172\t    directives: &mut Vec<RoutingDirective>,\n   173\t    new_directive: RoutingDirective,\n   174\t) {\n   175\t    let insertion_point = directives\n   176\t        .iter()\n   177\t        .position(|directive| directive.time_stamp > new_directive.time_stamp)\n   178\t        .unwrap_or(directives.len());\n   179\t    directives.insert(insertion_point, new_directive);\n   180\t}\n   181\t\n   182\tfn superseded(directives: &[RoutingDirective], index: usize) -> bool {\n   183\t    let directive = &directives[index];\n   184\t    for later in &directives[index + 1..] {\n   185\t        if later.luggage_id == directive.luggage_id {\n   186\t            return later.departure == directive.departure;\n   187\t        }\n   188\t    }\n   189\t    false\n   190\t}\n   191\t\n   192\tfn matches(expected: &[u8], actual: &[u8]) -> bool {\n   193\t    expected.first() == Some(&b'-') || expected == actual\n   194\t}\n   195\t\n   196\tfn main() {\n   197\t    let arguments: Vec<_> = env::args_os().collect();\n   198\t    if arguments.len() != 5 {\n   199\t        let _ = io::stderr().write_all(b\"Command line error: 4 arguments expected\\n\");\n   200\t        process::exit(1);\n   201\t    }\n   202\t    let expected: Vec<&[u8]> = arguments[1..]\n   203\t        .iter()\n   204\t        .map(|argument| argument.as_os_str().as_bytes())\n   205\t        .collect();\n   206\t\n   207\t    let mut input = Vec::new();\n   208\t    let _ = io::stdin().read_to_end(&mut input);\n   209\t    let mut scanner = Scanner::new(input);\n   210\t    let mut directives = Vec::new();\n   211\t\n   212\t    loop {\n   213\t        let mut time_stamp = 0_u32;\n   214\t        let mut luggage_id = Vec::new();\n   215\t        let mut flight_id = Vec::new();\n   216\t        let mut departure = Vec::new();\n   217\t        let mut arrival = Vec::new();\n   218\t        let mut comments = Vec::new();\n   219\t\n   220\t        if scanner.scan_timestamp(&mut time_stamp) == -1 {\n   221\t            break;\n   222\t        }\n   223\t        if scanner.scan_ids(&mut luggage_id, &mut flight_id) == -1 {\n   224\t            break;\n   225\t        }\n   226\t        if scanner.scan_airports(&mut departure, &mut arrival) == -1 {\n   227\t            break;\n   228\t        }\n   229\t        if scanner.scan_comments(&mut comments) == -1 {\n   230\t            break;\n   231\t        }\n   232\t\n   233\t        add_routing_directive_to_list(\n   234\t            &mut directives,\n   235\t            RoutingDirective {\n   236\t                time_stamp,\n   237\t                luggage_id: as_c_string(&luggage_id),\n   238\t                flight_id: as_c_string(&flight_id),\n   239\t                departure: as_c_string(&departure),\n   240\t                arrival: as_c_string(&arrival),\n   241\t                comments: as_c_string(&comments),\n   242\t            },\n   243\t        );\n   244\t    }\n   245\t\n   246\t    let mut output = Vec::new();\n   247\t    for (index, directive) in directives.iter().enumerate() {\n   248\t        if !superseded(&directives, index)\n   249\t            && matches(expected[0], &directive.luggage_id)\n   250\t            && matches(expected[1], &directive.flight_id)\n   251\t            && matches(expected[2], &directive.departure)\n   252\t            && matches(expected[3], &directive.arrival)\n   253\t        {\n   254\t            let mut timestamp = String::new();\n   255\t            write!(&mut timestamp, \"{:010}\", directive.time_stamp).unwrap();\n   256\t            output.extend_from_slice(timestamp.as_bytes());\n   257\t            output.push(b' ');\n   258\t            output.extend_from_slice(&directive.luggage_id);\n   259\t            output.push(b' ');\n   260\t            output.extend_from_slice(&directive.flight_id);\n   261\t            output.push(b' ');\n   262\t            output.extend_from_slice(&directive.departure);\n   263\t            output.push(b' ');\n   264