  179\t            size_t j;\n   180\t            for (j = 0; j < write; j++) {\n   181\t                if (buf[i] == buf[j]) break;\n   182\t            }\n   183\t            if (j == write) {\n   184\t                if (write != i) {\n   185\t                    buf[write] = buf[i];\n   186\t                }\n   187\t                write++;\n   188\t            }\n   189\t        }\n   190\t        return write;\n   191\t    } else {\n   192\t        /* Don't preserve order: sort-like approach with memmove */\n   193\t        uint8_t seen[256] = {0};\n   194\t        size_t write = 0;\n   195\t        \n   196\t        for (size_t i = 0; i < len; i++) {\n   197\t            if (!seen[buf[i]]) {\n   198\t                seen[buf[i]] = 1;\n   199\t                if (write != i) {\n   200\t                    /* Swap to front */\n   201\t                    uint8_t temp = buf[write];\n   202\t                    buf[write] = buf[i];\n   203\t                    buf[i] = temp;\n   204\t                }\n   205\t                write++;\n   206\t            }\n   207\t        }\n   208\t        return write;\n   209\t    }\n   210\t}\n   211\t\n   212\t/**\n   213\t * Interleave first and second halves of buffer\n   214\t * Complex memmove pattern with temporary storage\n   215\t */\n   216\tstatic void interleave_halves(uint8_t *buf, size_t len) {\n   217\t    if (len < 2) return;\n   218\t    \n   219\t    size_t half = len / 2;\n   220\t    size_t odd = len % 2;\n   221\t    uint8_t temp[512];\n   222\t    \n   223\t    if (half <= 256) {\n   224\t        /* Use temp buffer for small sizes */\n   225\t        memmove(temp, buf, half);\n   226\t        \n   227\t        for (size_t i = 0; i < half; i++) {\n   228\t            memmove(buf + i * 2 + 1, buf + half + i, 1);\n   229\t            buf[i * 2] = temp[i];\n   230\t        }\n   231\t        if (odd) {\n   232\t            buf[len - 1] = buf[half];\n   233\t        }\n   234\t    } else {\n   235\t      