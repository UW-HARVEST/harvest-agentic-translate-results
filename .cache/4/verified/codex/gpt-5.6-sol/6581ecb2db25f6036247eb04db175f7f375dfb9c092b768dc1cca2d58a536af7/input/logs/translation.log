len, size_t seg_size);\n    35\t\n    36\t/**\n    37\t * Main entrance function - processes buffer based on operation flags\n    38\t * \n    39\t * @param buffer Input/output buffer\n    40\t * @param length Buffer length\n    41\t * @param flags Bit flags: \n    42\t *              bit 0: rotate buffer\n    43\t *              bit 1: compact runs\n    44\t *              bit 2: remove duplicates\n    45\t *              bit 3: interleave halves\n    46\t *              bit 4: reverse segments\n    47\t * @param param1 Operation-specific parameter (rotation offset, run threshold, segment size)\n    48\t * @param param2 Secondary parameter (preserve order flag, etc)\n    49\t * @return New buffer length after processing\n    50\t */\n    51\tsize_t process_buffer(uint8_t *buffer, size_t length, uint32_t flags, \n    52\t                     int param1, int param2) {\n    53\t    size_t new_len = length;\n    54\t    \n    55\t    if (buffer == NULL || length == 0) {\n    56\t        return 0;\n    57\t    }\n    58\t    \n    59\t    /* Branch based on multiple flags - creates diverse control flow */\n    60\t    if (flags & 0x01) {  /* Rotate */\n    61\t        int offset = param1 % (int)length;\n    62\t        if (offset != 0) {\n    63\t            rotate_buffer(buffer, length, offset);\n    64\t        }\n    65\t    }\n    66\t    \n    67\t    if (flags & 0x02) {  /* Compact runs */\n    68\t        uint8_t threshold = (param1 > 0 && param1 <= 255) ? (uint8_t)param1 : 3;\n    69\t        new_len = compact_runs(buffer, new_len, threshold);\n    70\t    }\n    71\t    \n    72\t    if (flags & 0x04) {  /* Remove duplicates */\n    73\t        int preserve = (param2 != 0);\n    74\t        new_len = remove_duplicates(buffer, new_len, preserve);\n    75\t    }\n    76\t    \n    77\t    /* Conditional chaining based on length */\n    78\t    if ((flags & 0x08) && new_len >= 2) {  /* Interleave */\n    79\t        interleave_halves(buffer, new_len);\n    80\t    }\n    81\t    \n    82\t    if ((flags & 0x10) && new_len >= 4) {  /* Reverse segments */\n    83\t        size_t seg_size = (param1 > 0) ? (size_t)param1 : 4;\n    84\t        if (seg_size <= new_len) {\n    85\t            reverse_segments(buffer, new_len, seg_size);\n    86\t        }\n    87\t    }\n    88\t    \n    89\t    return new_len;\n    90\t}\n    91\t\n    92\t/**\n    93\t * Rotate buffer by offset positions (positive = right, negative = left)\n    94\t * Uses multiple memmove operations with different patterns\n    95\t */\n    96\tstatic void rotate_buffer(uint8_t *buf, size_t len, int offset) {\n    97\t    if (len <= 1) return;\n    98\t    \n    99\t    /* Normalize offset */\n   100\t    offset = offset % (int)len;\n   101\t    if (offset < 0) offset += len;\n   102\t    if (offset == 0) return;\n   103\t    \n   104\t    /* Use reversal algorithm with memmove */\n   105\t    uint8_t temp[256];\n   106\t    size_t chunk = (offset < 256) ? offset : 256;\n   107\t    \n   108\t    if ((size_t)offset < len / 2) {\n   109\t        /* Small offset: move prefix aside, shift main part, restore prefix */\n   110\t        size_t i;\n   111\t        for (i = 0; i < (size_t)offset; i += chunk) {\n   112\t            size_t copy_len = ((size_t)offset - i < chunk) ? (size_t)offset - i : chunk;\n   113\t            memmove(temp, buf + i, copy_len);\n   114\t            memmove(buf + i, buf + offset, len - offset);\n   115\t            memmove(buf + len - offset, temp, copy_len);\n   116\t        }\n   117\t    } else {\n   118\t        /* Large offset: work from the right */\n   119\t        size_t shift = len - offset;\n   120\t        memmove(temp, buf, shift);\n   121\t        memmove(buf, buf + shift, offset);\n   122\t        memmove(buf + offset, temp, shift);\n   123\t    }\n   124\t}\n   125\t\n   126\t/**\n   127\t * Compact consecutive runs of same value if run length >= threshold\n   128\t * Complex nested loops with multiple data paths\n   129\t