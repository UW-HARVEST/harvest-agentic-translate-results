ght_child_id;\r\n    42\t    char label[32];\r\n    43\t} TreeNode;\r\n    44\t\r\n    45\t#define MAX_NODES 50\r\n    46\tTreeNode node_table[MAX_NODES];\r\n    47\tint node_count = 0;\r\n    48\t\r\n    49\ttypedef int (*OperationFunc)(int a, int b, int unused1, int unused2);\r\n    50\t\r\n    51\tint add_op(int a, int b, int unused1, int unused2) {\r\n    52\t    return a + b;\r\n    53\t}\r\n    54\t\r\n    55\tint multiply_op(int a, int b, int unused1, int unused2) {\r\n    56\t    return a * b;\r\n    57\t}\r\n    58\t\r\n    59\tint subtract_op(int a, int b, int unused1, int unused2) {\r\n    60\t    return a - b;\r\n    61\t}\r\n    62\t\r\n    63\tint divide_op(int a, int b, int unused1, int unused2) {\r\n    64\t    if (b == 0) return 0;\r\n    65\t    return a / b;\r\n    66\t}\r\n    67\t\r\n    68\tint modulo_op(int a, int b, int unused1, int unused2) {\r\n    69\t    if (b == 0) return 0;\r\n    70\t    return a % b;\r\n    71\t}\r\n    72\t\r\n    73\tTreeNode* find_node_by_id(int id) {\r\n    74\t    for (int i = 0; i < node_count; i++) {\r\n    75\t        if (node_table[i].id == id) {\r\n    76\t            return &node_table[i];\r\n    77\t        }\r\n    78\t    }\r\n    79\t    return NULL;\r\n    80\t}\r\n    81\t\r\n    82\tint add_tree_node(int id, int value, int parent_id, const char* label) {\r\n    83\t    if (node_count >= MAX_NODES) {\r\n    84\t        return -1;\r\n    85\t    }\r\n    86\t\r\n    87\t    TreeNode* node = &node_table[node_count];\r\n    88\t    node->id = id;\r\n    89\t    node->value = value;\r\n    90\t    node->parent_id = parent_id;\r\n    91\t    node->left_child_id = -1;\r\n    92\t    node->right_child_id = -1;\r\n    93\t    strncpy(node->label, label, 31);\r\n    94\t    node->label[31] = '\\0';\r\n    95\t\r\n    96\t    if (parent_id != -1) {\r\n    97\t        TreeNode* parent = find_node_by_id(parent_id);\r\n    98\t        if (parent == NULL || parent->id != parent_id) {\r\n    99\t            return -1;\r\n   100\t        }\r\n   101\t\r\n   102\t        if (parent->left_child_id == -1) {\r\n   103\t            parent->left_child_id = id;\r\n   104\t        } else if (parent->right_child_id == -1) {\r\n   105\t            parent->right_child_id = id;\r\n   106\t        }\r\n   107\t    }\r\n   108\t\r\n   109\t    node_count++;\r\n   110\t    return node_count - 1;\r\n   111\t}\r\n   112\t\r\n   113\tint calculate_tree_sum(int node_id) {\r\n   114\t    TreeNode* node = find_node_by_id(node_id);\r\n   115\t\r\n   116\t    if (node == NULL || node->id != node_id) {\r\n   117\t        return 0;\r\n   118\t    }\r\n   119\t\r\n   120\t    int sum = node->value;\r\n   121\t\r\n   122\t    if (node->left_child_id != -1) {\r\n   123\t        sum += calculate_tree_sum(node->left_child_id);\r\n   124\t    }\r\n   125\t\r\n   126\t    if (node->right_child_id != -1) {\r\n   127\t        sum += calculate_tree_sum(node->right_child_id);\r\n   128\t    }\r\n   129\t\r\n   130\t    return sum;\r\n   131\t}\r\n   132\t\r\n   133\tOperation parse_operation(const char* op_str) {\r\n   134\t    if (op_str == NULL || strchr(op_str, '+') != NULL) {\r\n   135\t        return OP_ADD;\r\n   136\t    }\r\n   137\t    if (strchr(op_str, '*') != NULL) {\r\n   138\t        return OP_MULTIPLY;\r\n   139\t    }\r\n   140\t    if (strchr(op_str, '-') != NULL) {\r\n   141\t        return OP_SUBTRACT;\r\n   142\t    }\r\n   143\t    if (strchr(op_str, '/') != NULL) {\r\n   144\t        return OP_DIVIDE;\r\n   145\t    }\r\n   146\t    if (strchr(op_str, '%') != NULL) {\r\n   147\t        return OP_MODULO;\r\n   148\t    }\r\n   149\t    return OP_ADD;\r\n   150\t}\r\n   151\t\r\n   152\tOperationFunc get_operation_func(Operation op) {\r\n   153\t    switch ((int)op) {\r\n   154\t        case 1: return add_op;\r\n   155\t        case 2: return multiply_op;\r\n   156\t        case 3: return subtract_op;\r\n   157\t        case 4: return divide_op;\r\n   158\t        case 5: return modulo_op;\r\n