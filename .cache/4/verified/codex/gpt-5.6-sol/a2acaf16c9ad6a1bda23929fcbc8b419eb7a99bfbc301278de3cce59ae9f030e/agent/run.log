#[test]
fn null_label_probe() {
    let Ok(implementation) = std::env::var("INREFTREE_NULL_LABEL_PROBE") else {
        return;
    };
    let path = match implementation.as_str() {
        "c" => c_library_path(),
        "rust" => rust_library_path(),
        other => panic!("unknown null-label probe implementation: {other}"),
    };
    let api = unsafe { Api::load(&path) };
    unsafe {
        api.reset();
        (api.add_tree_node)(1, 1, -1, ptr::null());
    }
    panic!("{implementation} add_tree_node unexpectedly returned for a null label");
}
