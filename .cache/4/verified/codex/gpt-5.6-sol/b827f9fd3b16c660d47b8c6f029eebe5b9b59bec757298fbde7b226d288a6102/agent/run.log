{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/lib.rs'","aggregated_output":"     1\tuse std::ffi::c_int;\n     2\t\n     3\t#[link(name = \"m\")]\n     4\tunsafe extern \"C\" {\n     5\t    fn sqrtf(value: f32) -> f32;\n     6\t}\n     7\t\n     8\ttype Sqrtf = unsafe extern \"C\" fn(f32) -> f32;\n     9\t\n    10\tstatic SQRTF: Sqrtf = sqrtf;\n    11\t\n    12\t#[inline(never)]\n    13\tfn add(left: f32, right: f32) -> f32 {\n    14\t    left + right\n    15\t}\n    16\t\n    17\t#[inline(never)]\n    18\tfn subtract(left: f32, right: f32) -> f32 {\n    19\t    left - right\n    20\t}\n    21\t\n    22\t#[inline(never)]\n    23\tfn multiply(left: f32, right: f32) -> f32 {\n    24\t    left * right\n    25\t}\n    26\t\n    27\t#[inline(never)]\n    28\tfn nonnegative(value: f32) -> f32 {\n    29\t    if 0.0_f32 > value {\n    30\t        0.0\n    31\t    } else {\n    32\t        value\n    33\t    }\n    34\t}\n    35\t\n    36\t#[inline(never)]\n    37\tfn square_root(value: f32) -> f32 {\n    38\t    unsafe {\n    39\t        let function = std::ptr::read_volatile(&SQRTF);\n    40\t        function(value)\n    41\t    }\n    42\t}\n    43\t\n    44\t#[unsafe(no_mangle)]\n    45\tpub extern \"C\" fn tfm(mut dest: *mut f32, mut src: *const f32, count: c_int) {\n    46\t    let mut i = 0;\n    47\t\n    48\t    while i < count {\n    49\t        unsafe {\n    50\t            if *src < *src.add(1) {\n    51\t                let dx2 = *src;\n    52\t                let dy2 = *src.add(1);\n    53\t                let dxy = *src.add(2);\n    54\t                let doubled_dx2 = add(dx2, dx2);\n    55\t                let mixed = multiply(dy2, doubled_dx2);\n    56\t                let partial = add(subtract(multiply(dy2, dy2), mixed), multiply(dx2, dx2));\n    57\t                let dxy_term = multiply(multiply(dxy, 4.0_f32), dxy);\n    58\t                let sqd = add(partial, dxy_term);\n    59\t                let lambda = multiply(add(square_root(nonnegative(sqd)), add(dy2, dx2)), 0.5_f32);\n    60\t\n    61\t                *dest = subtract(dx2, lambda);\n    62\t                *dest.add(1) = dxy;\n    63\t            } else {\n    64\t                let dy2 = *src;\n    65\t                let dx2 = *src.add(1);\n    66\t                let dxy = *src.add(2);\n    67\t                let doubled_dx2 = add(dx2, dx2);\n    68\t                let mixed = multiply(doubled_dx2, dy2);\n    69\t                let partial = add(subtract(multiply(dy2, dy2), mixed), multiply(dx2, dx2));\n    70\t                let dxy_term = multiply(multiply(dxy, 4.0_f32), dxy);\n    71\t                let sqd = add(dxy_term, partial);\n    72\t                let lambda = multiply(add(square_root(nonnegative(sqd)), add(dy2, dx2)), 0.5_f32);\n    73\t\n    74\t                *dest = dxy;\n    75\t                *dest.add(1) = subtract(dx2, lambda);\n    76\t            }\n    77\t\n    78\t            src = src.add(3);\n    79\t            dest = dest.add(2);\n    80\t        }\n    81\t\n    82\t        i += 1;\n    83\t    }\n    84\t}\n","exit_code":0,"status":"completed"}}
