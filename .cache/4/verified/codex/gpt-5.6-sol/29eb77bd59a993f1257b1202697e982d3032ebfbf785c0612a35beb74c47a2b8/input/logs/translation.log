{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes\nimport random\nfrom pathlib import Path\n\nroot = Path.cwd()\nc_lib = ctypes.CDLL(str(root / \\\"c_build_baseline/libtranslated_rust.so\\\"))\nrust_lib = ctypes.CDLL(str(root / \\\"target/release/libtranslated_rust.so\\\"))\nprototype = [ctypes.POINTER(ctypes.c_uint8), ctypes.c_uint32, ctypes.c_uint16]\nfor lib in (c_lib, rust_lib):\n    lib.crc16.argtypes = prototype\n    lib.crc16.restype = ctypes.c_uint16\n\nassert ctypes.cast(c_lib.crc16, ctypes.c_void_p).value \"'!= ctypes.cast(rust_lib.crc16, ctypes.c_void_p).value\ncalls = 0\n\ndef evaluate(lib, payload, initial):\n    if payload:\n        data = (ctypes.c_uint8 * len(payload)).from_buffer_copy(payload)\n        return lib.crc16(data, len(payload), initial)\n    return lib.crc16(None, 0, initial)\n\ndef compare(payload, initial):\n    global calls\n    expected = evaluate(c_lib, payload, initial)\n    actual = evaluate(rust_lib, payload, initial)\n    calls += 1\n    if actual != expected:\n        raise AssertionError(\n            f\"mismatch len={len(payload)} initial={initial:#06x}: \"\n            f\"C={expected:#06x} Rust={actual:#06x} data={payload.hex()}\"\n        )\n\n# Empty-input behavior, including a null data pointer.\nfor initial in (0, 1, 0x00ff, 0xff00, 0xffff, 0xa5c3):\n    compare(b\"\", initial)\n\n# Isolate all 256 values in each of the eight slicing tables.\nfor table in range(8):\n    for value in range(256):\n        payload = bytearray(8)\n        initial = 0\n        if table == 7:\n            initial = value << 8\n        elif table == 6:\n            initial = value\n        else:\n            payload[7 - table] = value\n        compare(bytes(payload), initial)\n\n# Cover loop boundaries and arbitrary combinations deterministically.\nrng = random.Random(0xC16)\nfor length in list(range(0, 40)) + [63, 64, 65, 127, 128, 129, 255, 256, 257, 1024, 4096]:\