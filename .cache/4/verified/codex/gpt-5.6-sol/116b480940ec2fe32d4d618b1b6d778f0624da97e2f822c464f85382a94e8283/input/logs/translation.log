<math.h> /* sqrt */\n     2\t\n     3\tstatic double dot_product(float_t *a, float_t *b, int length) {\n     4\t    double sum = 0;\n     5\t    int i;\n     6\t    for(i = 0; i < length; i++) sum += a[i] * b[i];\n     7\t    return sum;\n     8\t}\n     9\t\n    10\tstatic void normalize(float_t *v, int length) {\n    11\t    double magnitude = sqrt(dot_product(v, v, length));\n    12\t    int i;\n    13\t    for(i = 0; i < length; i++) v[i] /= magnitude;\n    14\t}\n    15\t\n    16\tdouble spectral_contrast(float_t *a, float_t *b, int length) {\n    17\t    normalize(a, length);\n    18\t    normalize(b, length);\n    19\t    return dot_product(a, b, length);\n    20\t}\n","exit_code":0,"status":"completed"}}
