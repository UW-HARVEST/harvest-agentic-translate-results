{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes\nimport itertools\nimport random\n\nclass Tflac(ctypes.Structure):\n    _fields_ = [\n        (\\\"samplerate\\\", ctypes.c_uint32),\n        (\\\"channels\\\", ctypes.c_uint32),\n        (\\\"bitdepth\\\", ctypes.c_uint32),\n        (\\\"channel_mode\\\", ctypes.c_uint8),\n        (\\\"frame_header\\\", ctypes.c_uint32),\n        (\\\"cur_blocksize\\\", ctypes.c_uint32),\n    ]\n\nassert ctypes.sizeof(Tflac) == 24\nassert [getattr(Tflac, name).offset for name, _ in Tflac._fields_] == [0, 4, 8, 12, 16, 20]\n\nc_lib = ctypes.CDLL(\\\"./c_ref_build/libtranslated_rust.so\\\")\nrust_lib = ctypes.CDLL(\\\"./target/release/libtranslated_rust.so\\\")\nfor lib in (c_lib, rust_lib):\n    lib.update_frame_header.argtypes = [ctypes.POINTER(Tflac)]\n    lib.update_frame_header.restype = None\n\ndef check(raw, label):\n    c_value = Tflac.from_buffer_copy(raw)\n    rust_value = Tflac.from_buffer_copy(raw)\n    c_lib.update_frame_header(ctypes.byref(c_value))\n    rust_lib.update_frame_header(ctypes.byref(rust_value))\n    c_bytes = bytes(c_value)\n    rust_bytes = bytes(rust_value)\n    if c_bytes \"'!= rust_bytes:\n        raise AssertionError(\n            f\"mismatch for {label}: input={raw.hex()} c={c_bytes.hex()} rust={rust_bytes.hex()}\"\n        )\n\nblocks = [0, 1, 191, 192, 193, 255, 256, 257, 512, 576, 1024, 1152, 2048,\n          2304, 4096, 4608, 8192, 16384, 32768, 32769, 0xffffffff]\nrates = [0, 1, 999, 1000, 8000, 16000, 22050, 24000, 32000, 44100, 48000,\n         65535, 65536, 65540, 96000, 176400, 192000, 254000, 255000, 256000,\n         655350, 655359, 655360, 882000, 0xffffffff]\nchannels = [0, 1, 2, 8, 0x10000001, 0xffffffff]\nbitdepths = [0, 8, 12, 16, 20, 24, 32, 0xffffffff]\nmodes = [0, 1, 2, 3, 4, 255]\n\ncount = 0\nfor block, rate, channels_value, bitdepth, mode in itertools.product(\n    blocks, rates, channels, bitdepths,