{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes, os, random\nlibpath=os.path.abspath('c_src/build/libtranslated_rust.so')\nrng=random.Random(1234)\nfound={}\nfor i in range(3000):\n    n=rng.randrange(0,20)\n    data=rng.randbytes(n)\n    rd,wr=os.pipe()\n    pid=os.fork()\n    if pid==0:\n        os.close(rd);os.dup2(wr,2);os.close(wr)\n        lib=ctypes.CDLL(libpath)\n        lib.pinflate.argtypes=[ctypes.c_void_p,ctypes.c_int,ctypes.c_void_p,ctypes.c_int]\n        inp=ctypes.create_string_buffer(data or b'\\\\0')\n        out=ctypes.create_string_buffer(256)\n        lib.pinflate(inp, n, out, 256)\n        os._exit(0)\n    os.close(wr)\n    chunks=[]\n    while True:\n        b=os.read(rd,4096)\n        if not b:break\n        chunks.append(b)\n    os.close(rd);_,status=os.waitpid(pid,0)\n    err=b''.join(chunks).decode('utf8','replace')\n    if 'Assertion' in err:\n        expr=err.strip().split('Assertion \"'`'\"')[-1].split(\\\"' failed\\\")[0]\n        if expr not in found:\n            found[expr]=(i,data.hex(),err.strip())\n            print(expr, i, data.hex())\nprint('found',len(found))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
