dd(1);\n    40\t        print_the_house(house);\n    41\t        (*house).bathrooms += 1.0;\n    42\t        print_the_house(house);\n    43\t        (*house).bedrooms = (*house).bedrooms.wrapping_add(extra_bedrooms);\n    44\t        print_the_house(house);\n    45\t    }\n    46\t}\n    47\t\n    48\t#[no_mangle]\n    49\tpub extern \"C\" fn main() -> c_int {\n    50\t    let mut x: c_int = 0;\n    51\t\n    52\t    unsafe {\n    53\t        scanf(INTEGER_FORMAT.as_ptr().cast(), &raw mut x);\n    54\t    }\n    55\t    run(x);\n    56\t    run(x);\n    57\t    0\n    58\t}\n--- tests\n     1\tuse libloading::{Library, Symbol};\n     2\tuse std::env;\n     3\tuse std::ffi::{c_int, c_void};\n     4\tuse std::fs::{self, File};\n     5\tuse std::io::Write;\n     6\tuse std::os::fd::AsRawFd;\n     7\tuse std::path::{Path, PathBuf};\n     8\tuse std::process::{Command, Stdio};\n     9\tuse std::sync::atomic::{AtomicU64, Ordering};\n    10\tuse std::sync::OnceLock;\n    11\t\n    12\tconst CHILD_MARKER: &str = \"DRIVER_FFI_CHILD\";\n    13\tconst LIBRARY_PATH: &str = \"DRIVER_FFI_LIBRARY\";\n    14\tconst ACTION: &str = \"DRIVER_FFI_ACTION\";\n    15\tconst OUTPUT_PATH: &str = \"DRIVER_FFI_OUTPUT\";\n    16\t\n    17\tstatic C_LIBRARY: OnceLock<PathBuf> = OnceLock::new();\n    18\tstatic NEXT_OUTPUT: AtomicU64 = AtomicU64::new(0);\n    19\t\n    20\tunsafe extern \"C\" {\n    21\t    fn close(fd: c_int) -> c_int;\n    22\t    fn dup(fd: c_int) -> c_int;\n    23\t    fn dup2(old_fd: c_int, new_fd: c_int) -> c_int;\n    24\t    fn fflush(stream: *mut c_void) -> c_int;\n    25\t}\n    26\t\n    27\tfn manifest_dir() -> PathBuf {\n    28\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n    29\t}\n    30\t\n    31\tfn c_library() -> &'static Path {\n    32\t    C_LIBRARY\n    33\t        .get_or_init(|| {\n    34\t            let output_dir = manifest_dir().join(\"target/c-reference\");\n    35\t            fs::create_dir_all(&output_dir).expect(\"create C reference directory\");\n    36\t            let output = output_dir.join(\"libdriver_c.so\");\n    37\t            let source = manifest_dir().join(\"c_src/src/main.c\");\n    38\t            let result = Command::new(\"cc\")\n    39\t                .args([\"-shared\", \"-fPIC\", \"-O0\", \"-o\"])\n    40\t                .arg(&output)\n    41\t                .arg(source)\n    42\t                .output()\n    43\t                .expect(\"run C compiler\");\n    44\t            assert!(\n    45\t                result.status.success(),\n    46\t                \"C shared-library build failed:\\n{}\",\n    47\t                String::from_utf8_lossy(&result.stderr)\n    48\t            );\n    49\t            output\n    50\t        })\n    51\t        .as_path()\n    52\t}\n    53\t\n    54\tfn rust_library() -> PathBuf {\n    55\t    let test_executable = env::current_exe().expect(\"locate integration-test executable\");\n    56\t    let deps_dir = test_executable\n    57\t        .parent()\n    58\t        .expect(\"integration-test executable directory\");\n    59\t    let profile_dir = deps_dir.parent().expect(\"Cargo profile directory\");\n    60\t    let candidates = [\n    61\t        profile_dir.join(\"libdriver.so\"),\n    62\t        deps_dir.join(\"libdriver.so\"),\n    63\t    ];\n    64\t\n    65\t    candidates\n    66\t        .into_iter()\n    67\t        .find(|candidate| candidate.is_file())\n    68\t        .unwrap_or_else(|| {\n    69\t            panic!(\n    70\t                \"Rust cdylib not found; expected {}\",\n    71\t                profile_dir.join(\"libdriver.so\").display()\n    72\t            )\n    73\t        })\n    74\t}\n    75\t\n    76\tfn child_output_path() -> PathBuf {\n    77\t    let sequence = NEXT_OUTPUT.fetch_add(1, Ordering::Relaxed);\n    78\t    env::temp_dir().join(format!(\n    79\t        \"driver-differential-{}-{sequence}.out\",\n    80\t        std::process::id()\n    81\t    ))\n    82\t}\n    83\t\n    84\tfn invoke(library: &Path, action: &str, input: &[u8]) -> Vec<u8> {\n    85\t    let output_path = child_output_path();\n    86\t    let mut child = Command::new(env::current_exe().expect(\"locate test executable\"))\n    87\t        .args([\"--exact\", \"ffi_child\", \"--nocapture\"])\n    88\t        .env(CHILD_MARKER, \"1\")\n    89\t        .env(LIBRARY_PATH, library)\n    90\t        .env(ACTION, action)\n    91\t        .env(OUTPUT_PATH, &output_path)\n    92\t        .stdin(Stdio::piped())\n    93\t        .stdout(Stdio::null())\n    94\t        .stderr(Stdio::piped())\n    95\t        .spawn()\n    96\t        .expect(\"spawn FFI child\");\n    97\t\n    98\t    child\n    99\t        .stdin\n   100\t        .take()\n   101\t        .expect(\"open child stdin\")\n   102\t        .write_all(input)\n   103\t        .expect(\"write child stdin\");\n   104\t\n   105\t    let result = child.wait_with_output().expect(\"wait for FFI child\");\n   106\t    assert!(\n   107\t        result.status.success(),\n   108\t        \"FFI child failed for {} ({action}):\\n{}\",\n   109\t        library.display(),\n   110\t        String::from_utf8_lossy(&result.stderr)\n   111\t    );\n   112\t\n   113\t    let output = fs::read(&output_path).expect(\"read redirected library output\");\n   114\t    fs::remove_file(output_path).expect(\"remove redirected output\");\n   115\t    output\n   116\t}\n   117\t\n   118\tfn compare(action: &str, input: &[u8]) {\n   119\t    let c_output = invoke(c_library(), action, input);\n   120\t    let rust_path = rust_library();\n   121\t    let rust_output = invoke(&rust_path, action, input);\n   122\t    assert_eq!(\n   123\t        c_output,\n   124\t        rust_output,\n   125\t        \"output mismatch for action {action:?} and input {:?}\",\n   126\t        String::from_utf8_lossy(input)\n   127\t    );\n   128\t}\n   129\t\n   130\tfn randomized_i32s(count: usize) -> Vec<i32> {\n   131\t    let mut values = vec![\n   132\t        i32::MIN,\n   133\t        i32::MIN + 1,\n   134\t        -1_000_000,\n   135\t        -1,\n   136\t        0,\n   137\t        1,\n   138\t        1_000_000,\n   139\t        i32::MAX - 1,\n   140\t        i32::MAX,\n   141\t    ];\n   142\t    let mut state = 0x6a09_e667_f3bc_c909_u64;\n   143\t\n   144\t    while values.len() < count {\n   145\t        state ^= state << 13;\n   146\t        state ^= state >> 7;\n   147\t        state ^= state << 17;\n   148\t        values.push(state as i32);\n   149\t    }\n   150\t    values\n   151\t}\n   152\t\n   153\t#[test]\n   154\tfn ffi_child() {\n   155\t    if env::var_os(CHILD_MARKER).is_none() {\n   156\t        return;\n   157\t    }\n   158\t\n   159\t    let output_path = env::var_os(OUTPUT_PATH).expect(\"child output path\");\n   160\t    let output = File::create(output_path).expect(\"create child output\");\n   161\t    let saved_stdout = unsafe { dup(1) };\n   162\t    assert!(saved_stdout >= 0, \"duplicate stdout\");\n   163\t    assert_eq!(unsafe { dup2(output.as_raw_fd(), 1) }, 1, \"redirect stdout\");\n   164\t\n   165\t    let library_path = env::var_os(LIBRARY_PATH).expect(\"child library path\");\n   166\t    let action = env::var(ACTION).expect(\"child action\");\n   167\t    let library = unsafe { Library::new(library_path) }.expect(\"load shared library\");\n   168\t\n   169\t    unsafe {\n   170\t        if let Some(arguments) = action.strip_prefix(\"run:\") {\n   171\t            let run: Symbol<unsafe extern \"C\" fn(c_int)> =\n   172\t                library.get(b\"run\\0\").expect(\"resolve run\");\n   173\t            for argument in arguments.split(',') {\n   174\t                run(argument.parse().expect(\"parse run argument\"));\n   175\t            }\n   176\t        } else {\n   177\t            assert_eq!(action, \"main\");\n   178\t            let main: Symbol<unsafe extern \"C\" fn() -> c_int> =\n   179\t                library.get(b\"main\\0\").expect(\"resolve main\");\n   180\t            assert_eq!(main(), 0);\n   181\t        }\n   182\t\n   183\t        assert_eq!(fflush(std::ptr::null_mut()), 0, \"flush library output\");\n   184\t        assert_eq!(dup2(saved_stdout, 1), 1, \"restore stdout\");\n   185\t        assert_eq!(close(saved_stdout), 0, \"close saved stdout\");\n   186\t    }\n   187\t}\n   188\t\n   189\t#[test]\n   190\tfn config_1_run_from_fresh_state() {\n   191\t    for value in randomized_i32s(40) {\n   192\t        compare(&format!(\"run:{value}\"), b\"\");\n   193\t    }\n   194\t}\n   195\t\n   196\t#[test]\n   197\tfn config_2_run_accumulates_global_state() {\n   198\t    let values = randomized_i32s(128);\n   199\t    let arguments = values\n   200\t        .iter()\n   201\t        .map(i32::to_string)\n   202\t        .collect::<Vec<_>>()\n   203\t        .join(\",\");\n   204\t    compare(&format!(\"run:{arguments}\"), b\"\");\n   205\t}\n   206\t\n   207\t#[test]\n   208\tfn config_3_main_successful_decimal_conversion() {\n   209\t    for (index, value) in randomized_i32s(40).into_iter().enumerate() {\n   210\t        let input = match (index % 4, value >= 0) {\n   211\t            (0, _) => format!(\"{value}\\n\"),\n   212\t            (1, true) => format!(\" \\t+{value}\\r\\n\"),\n   213\t            (1, false) => format!(\" \\t{value}\\r\\n\"),\n   214\t            (2, _) => format!(\"\\x0b\\x0c{value} \"),\n   215\t            _ => format!(\"000{value}\\n\"),\n   216\t        };\n   217\t        compare(\"main\", input.as_bytes());\n   218\t    }\n   219\t}\n   220\t\n   221\t#[test]\n   222\tfn config_4_main_accepts_decimal_prefix() {\n   223\t    for (index, value) in randomized_i32s(40).into_iter().enumerate() {\n   224\t        let input = format!(\" \\t{value}suffix_{index}\\n\");\n   225\t        compare(\"main\", input.as_bytes());\n   226\t    }\n   227\t}\n   228\t\n   229\t#[test]\n   230\tfn config_5_main_failed_conversion_retains_zero() {\n   231\t    let mut inputs = vec![\n   232\t        Vec::new(),\n   233\t        b\"not-a-number\\n\".to_vec(),\n   234\t        b\" \\t\\r\\n\".to_vec(),\n   235\t        b\"+\".to_vec(),\n   236\t        b\"-\".to_vec(),\n   237\t    ];\n   238\t    let mut state = 0xbb67_ae85_84ca_a73b_u64;\n   239\t\n   240\t    while inputs.len() < 40 {\n   241\t        state ^= state << 13;\n   242\t        state ^= state >> 7;\n   243\t        state ^= state << 17;\n   244\t        inputs.push(format!(\"q{state:x}\\n\").into_bytes());\n   245\t    }\n   246\t\n   247\t    for input in inputs {\n   248\t        compare(\"main\", &input);\n   249\t    }\n   250\t}\n","exit_code":0,"status":"completed"}}
