 {\r\n    39\t    STATUS_SUCCESS = 0,\r\n    40\t    STATUS_ERROR = -1,\r\n    41\t    STATUS_WARNING = 1\r\n    42\t} StatusCode;\r\n    43\t\r\n    44\ttypedef struct {\r\n    45\t    int value;\r\n    46\t    time_t timestamp;\r\n    47\t    StatusCode status;\r\n    48\t} ComputationResult;\r\n    49\t\r\n    50\ttypedef int (*MathOperation)(int, int, int);\r\n    51\t\r\n    52\tbool is_valid_operation(char op_char) {\r\n    53\t    char valid = op_char && (op_char >= '1' && op_char <= '5');\r\n    54\t    return valid;\r\n    55\t}\r\n    56\t\r\n    57\tint get_operation_priority(Operation op) {\r\n    58\t    int priority = op * 10;\r\n    59\t    return priority;\r\n    60\t}\r\n    61\t\r\n    62\tint add_operation(int a, int b, int unused_param) {\r\n    63\t    return a + b;\r\n    64\t}\r\n    65\t\r\n    66\tint multiply_operation(int a, int b, int unused_param) {\r\n    67\t    return a * b;\r\n    68\t}\r\n    69\t\r\n    70\tint subtract_operation(int a, int b, int unused_param) {\r\n    71\t    return a - b;\r\n    72\t}\r\n    73\t\r\n    74\tint divide_operation(int a, int b, int unused_param) {\r\n    75\t    if (b == 0) {\r\n    76\t        return 0;\r\n    77\t    }\r\n    78\t    return a / b;\r\n    79\t}\r\n    80\t\r\n    81\tint modulo_operation(int a, int b, int unused_param) {\r\n    82\t    if (b == 0) {\r\n    83\t        return 0;\r\n    84\t    }\r\n    85\t    return a % b;\r\n    86\t}\r\n    87\t\r\n    88\tMathOperation select_operation(Operation op) {\r\n    89\t    switch (op) {\r\n    90\t        case OP_ADD:\r\n    91\t            return add_operation;\r\n    92\t        case OP_MULTIPLY:\r\n    93\t            return multiply_operation;\r\n    94\t        case OP_SUBTRACT:\r\n    95\t            return subtract_operation;\r\n    96\t        case OP_DIVIDE:\r\n    97\t            return divide_operation;\r\n    98\t        case OP_MODULO:\r\n    99\t            return modulo_operation;\r\n   100\t        default:\r\n   101\t            return add_operation;\r\n   102\t    }\r\n   103\t}\r\n   104\t\r\n   105\ttime_t get_computation_timestamp() {\r\n   106\t    time_t current_time;\r\n   107\t    time(&current_time);\r\n   108\t    current_time = current_time >> 29;\r\n   109\t    return current_time;\r\n   110\t}\r\n   111\t\r\n   112\tComputationResult* allocate_results(int count) {\r\n   113\t    ComputationResult* results = (ComputationResult*)calloc(count, sizeof(ComputationResult));\r\n   114\t    return results;\r\n   115\t}\r\n   116\t\r\n   117\tint perform_computation_with_history(int a, int b, Operation op, ComputationResult** history, int* history_count) {\r\n   118\t    MathOperation math_func = select_operation(op);\r\n   119\t\r\n   120\t    int result = math_func(a, b, 0);\r\n   121\t\r\n   122\t    if (*history == NULL) {\r\n   123\t        *history = allocate_results(10);\r\n   124\t        *history_count = 0;\r\n   125\t    }\r\n   126\t\r\n   127\t    if (*history_count < 10) {\r\n   128\t        (*history)[*history_count].value = result;\r\n   129\t        (*history)[*history_count].timestamp = get_computation_timestamp();\r\n   130\t        (*history)[*history_count].status = STATUS_SUCCESS;\r\n   131\t        (*history_count)++;\r\n   132\t    }\r\n   133\t\r\n   134\t    return result;\r\n   135\t}\r\n   136\t\r\n   137\tint mathop(int param1, int param2, int param3, int param4) {\r\n   138\t    static ComputationResult* computation_history = NULL;\r\n   139\t    static int history_count = 0;\r\n   140\t\r\n   141\t    char validation_char = (char)(param1 % 128);\r\n   142\t    bool is_valid = is_valid_operation(validation_char);\r\n   143\t\r\n   144\t    if (!is_valid) {\r\n   145\t        validation_char = '1';\r\n   146\t    }\r\n   147\t\r\n   148\t    Operation selected_op = (Operation)((param3 % 5) + 1);\r\n   149\t\r\n   150\t    int operation_priority = get_operation_priority(selected_op);\r\n   151\t\r\n   152\t    int intermediate_result = perform_computation_with_history(\r\n   153\t        param1, param2, selected_op, &computation_history, &history_count\r\n   154\t    );\r\n   155\t\r\n   156\t    Operation second_op = (Operation)(((param4 + 1) % 5) + 1);\r\n   157\t    int final_result = perform_computation_with_history(\r\n   158\t        intermediate_result, param4, second_op, &computation_history, &history_count\r\n   159\t    );\r\n   160\t\r\n   161\t    final_result += operation_priority;\r\n   162\t\r\n   163\t    time_t computation_time = get_computation_timestamp();\r\n   164\t\r\n   165\t    int time_modifier = (int)(computation_time % 100);\r\n   166\t    final_result += time_modifier;\r\n   167\t\r\n   168\t    printf(\"Computation performed at timestamp: %ld\\n\", (long)computation_time);\r\n   169\t    printf(\"Operation priority: %d\\n\", operation_priority);\r\n   170\t    printf(\"History entries: %d\\n\", history_count);\r\n   171\t    printf(\"Final result: %d\\n\", final_result);\r\n   172\t\r\n   173\t    return final_result;\r\n   174\t}\r\n","exit_code":0,"status":"completed"}}
