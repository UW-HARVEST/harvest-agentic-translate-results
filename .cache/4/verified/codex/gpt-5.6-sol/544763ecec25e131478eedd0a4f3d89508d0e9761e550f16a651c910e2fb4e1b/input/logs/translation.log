{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes\nimport random\nimport struct\n\nclass RGB(ctypes.Structure):\n    _fields_ = [('R', ctypes.c_ubyte), ('G', ctypes.c_ubyte), ('B', ctypes.c_ubyte)]\n\npaths = [\n    '/tmp/harvest-translate-NRgdN9-c-build-20260824-a/libtranslated_rust.so',\n    'target/release/libtranslated_rust.so',\n]\nfuncs = []\nfor path in paths:\n    library = ctypes.CDLL(path)\n    function = library.contrast_ratio\n    function.argtypes = [RGB, RGB]\n    function.restype = ctypes.c_float\n    funcs.append((library, function))\n\ndef bits(value):\n    return struct.pack('=f', value)\n\ncases = []\nvalues = [0, 1, 2, 3, 10, 11, 12, 13, 127, 128, 254, 255]\nfor ar in values:\n    for ag in values:\n        for ab in values:\n            for br in values:\n                cases.append((RGB(ar, ag, ab), RGB(br, 255 - br, (br * 17) & 255)))\n\nrng = random.Random(0xC0DEC0DE)\nfor _ in range(1_000_000):\n    cases.append((RGB(rng.randrange(256), rng.randrange(256), rng.randrange(256)),\n                  RGB(rng.randrange(256), rng.randrange(256), rng.randrange(256))))\n\nfor index, (a, b) in enumerate(cases):\n    c_value = funcs[0][1](a, b)\n    rust_value = funcs[1][1](a, b)\n    if bits(c_value) \"'!= bits(rust_value):\n        print('\"'mismatch', index, (a.R, a.G, a.B), (b.R, b.G, b.B),\n              bits(c_value).hex(), bits(rust_value).hex(), c_value, rust_value)\n        raise SystemExit(1)\nprint(f'bit-identical cases: {len(cases)}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
