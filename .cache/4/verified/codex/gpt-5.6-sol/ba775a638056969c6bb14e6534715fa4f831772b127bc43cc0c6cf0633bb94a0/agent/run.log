{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc 'nl -ba c_src/src/inventory.c && nl -ba c_src/src/main.c'","aggregated_output":"     1\t/*\n     2\t * Copyright 2025 MIT Lincoln Laboratory\n     3\t * Permission is hereby granted, free of charge,\n     4\t * to any person obtaining a copy of this software\n     5\t * and associated documentation files (the \"Software\"),\n     6\t * to deal in the Software without restriction,\n     7\t * including without limitation the rights to use, copy,\n     8\t * modify, merge, publish, distribute, sublicense,\n     9\t * and/or sell copies of the Software,\n    10\t * and to permit persons to whom the Software is furnished to do so,\n    11\t * subject to the following conditions:\n    12\t * \n    13\t * The above copyright notice and this permission notice\n    14\t * shall be included in all copies or substantial portions of the Software.\n    15\t * \n    16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    18\t * THE WARRANTIES OF MERCHANTABILITY,\n    19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    24\t */\n    25\t// inventory.c\n    26\t#include \"inventory.h\"\n    27\t\n    28\t// Define the container implementations\n    29\tDEFINE_ARRAY(int)\n    30\tDEFINE_ARRAY(double)\n    31\tDEFINE_ARRAY(item_t)\n    32\tDEFINE_ARRAY(order_t)\n    33\t\n    34\tDEFINE_LIST(int)\n    35\tDEFINE_LIST(double)\n    36\tDEFINE_LIST(item_t)\n    37\tDEFINE_LIST(order_t)\n    38\t\n    39\tvoid print_item(item_t item) {\n    40\t    printf(\"  [%d] %s\\n\", item.id, item.name);\n    41\t    printf(\"      Category: %s\\n\", item.category);\n    42\t    printf(\"      Price: $%.2f\\n\", item.price);\n    43\t    printf(\"      Quantity: %d\\n\", item.quantity);\n    44\t}\n    45\t\n    46\tvoid print_order(order_t order) {\n    47\t    printf(\"  Order - Customer ID: %d, Name: %s\\n\", \n    48\t           order.customer_id, order.customer_name);\n    49\t    printf(\"          Total: $%.2f\\n\", order.total_amount);\n    50\t}\n    51\t\n    52\titem_t create_item(int id, const char *name, const char *category, \n    53\t                   double price, int quantity) {\n    54\t    item_t item;\n    55\t    item.id = id;\n    56\t    strncpy(item.name, name, MAX_NAME_LENGTH - 1);\n    57\t    item.name[MAX_NAME_LENGTH - 1] = '\\0';\n    58\t    strncpy(item.category, category, MAX_CATEGORY_LENGTH - 1);\n    59\t    item.category[MAX_CATEGORY_LENGTH - 1] = '\\0';\n    60\t    item.price = price;\n    61\t    item.quantity = quantity;\n    62\t    return item;\n    63\t}\n    64\t\n    65\torder_t create_order(int customer_id, const char *customer_name, \n    66\t                     double total_amount) {\n    67\t    order_t order;\n    68\t    order.customer_id = customer_id;\n    69\t    strncpy(order.customer_name, customer_name, MAX_NAME_LENGTH - 1);\n    70\t    order.customer_name[MAX_NAME_LENGTH - 1] = '\\0';\n    71\t    order.total_amount = total_amount;\n    72\t    return order;\n    73\t}\n    74\t\n    75\tvoid calculate_inventory_stats(array_item_t_t *items) {\n    76\t    if (!items || items->size == 0) {\n    77\t        printf(\"No items in inventory\\n\");\n    78\t        return;\n    79\t    }\n    80\t    \n    81\t    printf(\"\\n=== Inventory Statistics (Array) ===\\n\");\n    82\t    \n    83\t    double total_value = 0.0;\n    84\t    int total_items = 0;\n    85\t    double max_price = 0.0;\n    86\t    double min_price = items->data[0].price;\n    87\t    \n    88\t    // Use ARRAY_FOREACH macro\n    89\t    item_t item;\n    90\t    ARRAY_FOREACH(item_t, item, items) {\n    91\t        total_value += item.price * item.quantity;\n    92\t        total_items += item.quantity;\n    93\t        if (item.price > max_price) max_price = item.price;\n    94\t        if (item.price < min_price) min_price = item.price;\n    95\t    }\n    96\t    \n    97\t    printf(\"Total unique items: %zu\\n\", items->size);\n    98\t    printf(\"Total item count: %d\\n\", total_items);\n    99\t    printf(\"Total inventory value: $%.2f\\n\", total_value);\n   100\t    printf(\"Average item price: $%.2f\\n\", total_value / total_items);\n   101\t    printf(\"Most expensive item: $%.2f\\n\", max_price);\n   102\t    printf(\"Least expensive item: $%.2f\\n\", min_price);\n   103\t}\n   104\t\n   105\tvoid calculate_order_stats(list_order_t_t *orders) {\n   106\t    if (!orders || orders->size == 0) {\n   107\t        printf(\"No orders to analyze\\n\");\n   108\t        return;\n   109\t    }\n   110\t    \n   111\t    printf(\"\\n=== Order Statistics (List) ===\\n\");\n   112\t    \n   113\t    double total_revenue = 0.0;\n   114\t    double max_order = 0.0;\n   115\t    double min_order = -1.0;\n   116\t    \n   117\t    // Use LIST_FOREACH macro\n   118\t    order_t order;\n   119\t    LIST_FOREACH(order_t, order, orders) {\n   120\t        total_revenue += order.total_amount;\n   121\t        if (order.total_amount > max_order) {\n   122\t            max_order = order.total_amount;\n   123\t        }\n   124\t        if (min_order < 0 || order.total_amount < min_order) {\n   125\t            min_order = order.total_amount;\n   126\t        }\n   127\t    }\n   128\t    \n   129\t    printf(\"Total orders: %zu\\n\", orders->size);\n   130\t    printf(\"Total revenue: $%.2f\\n\", total_revenue);\n   131\t    printf(\"Average order value: $%.2f\\n\", total_revenue / orders->size);\n   132\t    printf(\"Largest order: $%.2f\\n\", max_order);\n   133\t    printf(\"Smallest order: $%.2f\\n\", min_order);\n   134\t}\n   135\t\n   136\tvoid find_items_by_category(array_item_t_t *items, const char *category) {\n   137\t    if (!items || !category) return;\n   138\t    \n   139\t    printf(\"\\n=== Items in category '%s' ===\\n\", category);\n   140\t    \n   141\t    int found = 0;\n   142\t    item_t item;\n   143\t    \n   144\t    // Use ARRAY_FOREACH to iterate\n   145\t    ARRAY_FOREACH(item_t, item, items) {\n   146\t        if (strcmp(item.category, category) == 0) {\n   147\t            print_item(item);\n   148\t            found++;\n   149\t        }\n   150\t    }\n   151\t    \n   152\t    if (found == 0) {\n   153\t        printf(\"No items found in this category\\n\");\n   154\t    } else {\n   155\t        printf(\"Found %d items\\n\", found);\n   156\t    }\n   157\t}\n   158\t\n   159\tvoid find_expensive_items(list_item_t_t *items, double min_price) {\n   160\t    if (!items) return;\n   161\t    \n   162\t    printf(\"\\n=== Items priced above $%.2f ===\\n\", min_price);\n   163\t    \n   164\t    int found = 0;\n   165\t    item_t item;\n   166\t    \n   167\t    // Use LIST_FOREACH to iterate\n   168\t    LIST_FOREACH(item_t, item, items) {\n   169\t        if (item.price >= min_price) {\n   170\t            print_item(item);\n   171\t            found++;\n   172\t        }\n   173\t    }\n   174\t    \n   175\t    if (found == 0) {\n   176\t        printf(\"No items found above this price\\n\");\n   177\t    } else {\n   178\t        printf(\"Found %d items\\n\", found);\n   179\t    }\n   180\t}\n     1\t/*\n     2\t * Copyright 2025 MIT Lincoln Laboratory\n     3\t * Permission is hereby granted, free of charge,\n     4\t * to any person obtaining a copy of this software\n     5\t * and associated documentation files (the \"Software\"),\n     6\t * to deal in the Software without restriction,\n     7\t * including without limitation the rights to use, copy,\n     8\t * modify, merge, publish, distribute, sublicense,\n     9\t * and/or sell copies of the Software,\n    10\t * and to permit persons to whom the Software is furnished to do so,\n    11\t * subject to the following conditions:\n    12\t * \n    13\t * The above copyright notice and this permission notice\n    14\t * shall be included in all copies or substantial portions of the Software.\n    15\t * \n    16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    18\t * THE WARRANTIES OF MERCHANTABILITY,\n    19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    24\t */\n    25\t#include <stdio.h>\n    26\t#include <stdlib.h>\n    27\t#include <string.h>\n    28\t#include <stddef.h>\n    29\t#include \"inventory.h\"\n    30\t\n    31\tvoid print_menu(void) {\n    32\t    printf(\"\\n\");\n    33\t    printf(\"========================================\\n\");\n    34\t    printf(\"  GENERIC FOR_EACH MACRO DEMO\\n\");\n    35\t    printf(\"========================================\\n\");\n    36\t    printf(\"1. Demo: Integer Containers\\n\");\n    37\t    printf(\"2. Demo: Double Containers\\n\");\n    38\t    printf(\"3. Demo: Inventory Array\\n\");\n    39\t    printf(\"4. Demo: Order List\\n\");\n    40\t    printf(\"5. Demo: Mixed Operations\\n\");\n    41\t    printf(\"6. Run All Demos\\n\");\n    42\t    printf(\"7. Exit\\n\");\n    43\t    printf(\"========================================\\n\");\n    44\t    printf(\"Choice: \");\n    45\t}\n    46\t\n    47\tvoid demo_integer_containers(void) {\n    48\t    printf(\"\\n\");\n    49\t    printf(\"========================================\\n\");\n    50\t    printf(\"  DEMO 1: Integer Containers\\n\");\n    51\t    printf(\"========================================\\n\");\n    52\t    \n    53\t    // Create integer array\n    54\t    array_int_t *int_array = array_int_create(10);\n    55\t    printf(\"\\n--- Integer Array ---\\n\");\n    56\t    printf(\"Adding integers: 10, 20, 30, 40, 50\\n\");\n    57\t    array_int_push(int_array, 10);\n    58\t    array_int_push(int_array, 20);\n    59\t    array_int_push(int_array, 30);\n    60\t    array_int_push(int_array, 40);\n    61\t    array_int_push(int_array, 50);\n    62\t    \n    63\t    printf(\"Array contents: \");\n    64\t    int val;\n    65\t    ARRAY_FOREACH(int, val, int_array) {\n    66\t        printf(\"%d \", val);\n    67\t    }\n    68\t    printf(\"\\n\");\n    69\t    \n    70\t    // Calculate sum using ARRAY_FOREACH\n    71\t    int sum = 0;\n    72\t    ARRAY_FOREACH(int, val, int_array) {\n    73\t        sum += val;\n    74\t    }\n    75\t    printf(\"Sum: %d\\n\", sum);\n    76\t    printf(\"Average: %.2f\\n\", (double)sum / int_array->size);\n    77\t    \n    78\t    // Create integer list\n    79\t    list_int_t *int_list = list_int_create();\n    80\t    printf(\"\\n--- Integer List ---\\n\");\n    81\t    printf(\"Adding integers: 100, 200, 300, 400, 500\\n\");\n    82\t    list_int_append(int_list, 100);\n    83\t    list_int_append(int_list, 200);\n    84\t    list_int_append(int_list, 300);\n    85\t    list_int_append(int_list, 400);\n    86\t    list_int_append(int_list, 500);\n    87\t    \n    88\t    printf(\"List contents: \");\n    89\t    LIST_FOREACH(int, val, int_list) {\n    90\t        printf(\"%d \", val);\n    91\t    }\n    92\t    printf(\"\\n\");\n    93\t    \n    94\t    // Calculate product using LIST_FOREACH\n    95\t    long long product = 1;\n    96\t    LIST_FOREACH(int, val, int_list) {\n    97\t        product *= val;\n    98\t    }\n    99\t    printf(\"Product: %lld\\n\", product);\n   100\t    \n   101\t    // Cleanup\n   102\t    array_int_destroy(int_array);\n   103\t    list_int_destroy(int_list);\n   104\t}\n   105\t\n   106\tvoid demo_double_containers(void) {\n   107\t    printf(\"\\n\");\n   108\t    printf(\"========================================\\n\");\n   109\t    printf(\"  DEMO 2: Double Containers\\n\");\n   110\t    printf(\"========================================\\n\");\n   111\t    \n   112\t    // Create double array\n   113\t    array_double_t *double_array = array_double_create(5);\n   114\t    printf(\"\\n--- Double Array (Temperatures in Celsius) ---\\n\");\n   115\t    \n   116\t    double temps[] = {23.5, 25.0, 22.8, 26.3, 24.1, 21.9, 27.5};\n   117\t    int num_temps = sizeof(temps) / sizeof(temps[0]);\n   118\t    \n   119\t    printf(\"Adding temperatures: \");\n   120\t    for (int i = 0; i < num_temps; i++) {\n   121\t        array_double_push(double_array, temps[i]);\n   122\t        printf(\"%.1f \", temps[i]);\n   123\t    }\n   124\t    printf(\"\\n\");\n   125\t    \n   126\t    // Find min, max, average using ARRAY_FOREACH\n   127\t    double min_temp = temps[0];\n   128\t    double max_temp = temps[0];\n   129\t    double sum_temp = 0.0;\n   130\t    double temp;\n   131\t    \n   132\t    ARRAY_FOREACH(double, temp, double_array) {\n   133\t        if (temp < min_temp) min_temp = temp;\n   134\t        if (temp > max_temp) max_temp = temp;\n   135\t        sum_temp += temp;\n   136\t    }\n   137\t    \n   138\t    printf(\"Minimum: %.1f°C\\n\", min_temp);\n   139\t    printf(\"Maximum: %.1f°C\\n\", max_temp);\n   140\t    printf(\"Average: %.1f°C\\n\", sum_temp / double_array->size);\n   141\t    \n   142\t    // Create double list\n   143\t    list_double_t *price_list = list_double_create();\n   144\t    printf(\"\\n--- Double List (Product Prices) ---\\n\");\n   145\t    \n   146\t    double prices[] = {9.99, 14.50, 7.25, 22.00, 5.99, 18.75};\n   147\t    int num_prices = sizeof(prices) / sizeof(prices[0]);\n   148\t    \n   149\t    printf(\"Adding prices: \");\n   150\t    for (int i = 0; i < num_prices; i++) {\n   151\t        list_double_append(price_list, prices[i]);\n   152\t        printf(\"$%.2f \", prices[i]);\n   153\t    }\n   154\t    printf(\"\\n\");\n   155\t    \n   156\t    // Calculate total and find items under $10 using LIST_FOREACH\n   157\t    double total = 0.0;\n   158\t    int count_under_10 = 0;\n   159\t    \n   160\t    LIST_FOREACH(double, temp, price_list) {\n   161\t        total += temp;\n   162\t        if (temp < 10.0) count_under_10++;\n   163\t    }\n   164\t    \n   165\t    printf(\"Total cost: $%.2f\\n\", total);\n   166\t    printf(\"Items under $10: %d\\n\", count_under_10);\n   167\t    \n   168\t    // Cleanup\n   169\t    array_double_destroy(double_array);\n   170\t    list_double_destroy(price_list);\n   171\t}\n   172\t\n   173\tvoid demo_inventory_array(void) {\n   174\t    printf(\"\\n\");\n   175\t    printf(\"========================================\\n\");\n   176\t    printf(\"  DEMO 3: Inventory Array (Items)\\n\");\n   177\t    printf(\"========================================\\n\");\n   178\t    \n   179\t    // Create inventory array\n   180\t    array_item_t_t *inventory = array_item_t_create(20);\n   181\t    \n   182\t    // Add items\n   183\t    printf(\"\\n--- Adding Items to Inventory ---\\n\");\n   184\t    array_item_t_push(inventory, create_item(1, \"Laptop\", \"Electronics\", 899.99, 15));\n   185\t    array_item_t_push(inventory, create_item(2, \"Mouse\", \"Electronics\", 24.99, 50));\n   186\t    array_item_t_push(inventory, create_item(3, \"Keyboard\", \"Electronics\", 79.99, 30));\n   187\t    array_item_t_push(inventory, create_item(4, \"Monitor\", \"Electronics\", 299.99, 20));\n   188\t    array_item_t_push(inventory, create_item(5, \"Desk Chair\", \"Furniture\", 199.99, 10));\n   189\t    array_item_t_push(inventory, create_item(6, \"Desk\", \"Furniture\", 349.99, 8));\n   190\t    array_item_t_push(inventory, create_item(7, \"Notebook\", \"Office\", 4.99, 100));\n   191\t    array_item_t_push(inventory, create_item(8, \"Pen Set\", \"Office\", 12.99, 75));\n   192\t    array_item_t_push(inventory, create_item(9, \"USB Cable\", \"Electronics\", 9.99, 60));\n   193\t    array_item_t_push(inventory, create_item(10, \"Bookshelf\", \"Furniture\", 149.99, 12));\n   194\t    \n   195\t    printf(\"Added %zu items to inventory\\n\", inventory->size);\n   196\t    \n   197\t    // Display all items using ARRAY_FOREACH\n   198\t    printf(\"\\n--- All Inventory Items ---\\n\");\n   199\t    item_t item;\n   200\t    ARRAY_FOREACH(item_t, item, inventory) {\n   201\t        print_item(item);\n   202\t        printf(\"\\n\");\n   203\t    }\n   204\t    \n   205\t    // Calculate statistics\n   206\t    calculate_inventory_stats(inventory);\n   207\t    \n   208\t    // Find items by category\n   209\t    find_items_by_category(inventory, \"Electronics\");\n   210\t    find_items_by_category(inventory, \"Furniture\");\n   211\t    \n   212\t    // Find low stock items using ARRAY_FOREACH\n   213\t    printf(\"\\n--- Low Stock Items (< 20) ---\\n\");\n   214\t    int low_stock_count = 0;\n   215\t    ARRAY_FOREACH(item_t, item, inventory) {\n   216\t        if (item.quantity < 20) {\n   217\t            print_item(item);\n   218\t            low_stock_count++;\n   219\t        }\n   220\t    }\n   221\t    printf(\"Total low stock items: %d\\n\", low_stock_count);\n   222\t    \n   223\t    // Cleanup\n   224\t    array_item_t_destroy(inventory);\n   225\t}\n   226\t\n   227\tvoid demo_order_list(void) {\n   228\t    printf(\"\\n\");\n   229\t    printf(\"========================================\\n\");\n   230\t    printf(\"  DEMO 4: Order List (Orders)\\n\");\n   231\t    printf(\"========================================\\n\");\n   232\t    \n   233\t    // Create order list\n   234\t    list_order_t_t *orders = list_order_t_create();\n   235\t    \n   236\t    // Add orders\n   237\t    printf(\"\\n--- Adding Orders ---\\n\");\n   238\t    list_order_t_append(orders, create_order(1001, \"Alice Johnson\", 1249.95));\n   239\t    list_order_t_append(orders, create_order(1002, \"Bob Smith\", 89.99));\n   240\t    list_order_t_append(orders, create_order(1003, \"Carol White\", 549.98));\n   241\t    list_order_t_append(orders, create_order(1004, \"David Brown\", 24.99));\n   242\t    list_order_t_append(orders, create_order(1005, \"Eve Davis\", 899.99));\n   243\t    list_order_t_append(orders, create_order(1006, \"Frank Miller\", 374.97));\n   244\t    list_order_t_append(orders, create_order(1007, \"Grace Lee\", 159.98));\n   245\t    list_order_t_append(orders, create_order(1008, \"Henry Wilson\", 1099.99));\n   246\t    \n   247\t    printf(\"Added %zu orders\\n\", orders->size);\n   248\t    \n   249\t    // Display all orders using LIST_FOREACH\n   250\t    printf(\"\\n--- All Orders ---\\n\");\n   251\t    order_t order;\n   252\t    LIST_FOREACH(order_t, order, orders) {\n   253\t        print_order(order);\n   254\t    }\n   255\t    \n   256\t    // Calculate statistics\n   257\t    calculate_order_stats(orders);\n   258\t    \n   259\t    // Find large orders using LIST_FOREACH\n   260\t    printf(\"\\n--- Large Orders (> $500) ---\\n\");\n   261\t    int large_order_count = 0;\n   262\t    double large_order_total = 0.0;\n   263\t    \n   264\t    LIST_FOREACH(order_t, order, orders) {\n   265\t        if (order.total_amount > 500.0) {\n   266\t            print_order(order);\n   267\t            large_order_count++;\n   268\t            large_order_total += order.total_amount;\n   269\t        }\n   270\t    }\n   271\t    \n   272\t    printf(\"Total large orders: %d\\n\", large_order_count);\n   273\t    printf(\"Revenue from large orders: $%.2f\\n\", large_order_total);\n   274\t    \n   275\t    // Cleanup\n   276\t    list_order_t_destroy(orders);\n   277\t}\n   278\t\n   279\tvoid demo_mixed_operations(void) {\n   280\t    printf(\"\\n\");\n   281\t    printf(\"========================================\\n\");\n   282\t    printf(\"  DEMO 5: Mixed Operations\\n\");\n   283\t    printf(\"========================================\\n\");\n   284\t    \n   285\t    // Create both array and list with items\n   286\t    array_item_t_t *array_inventory = array_item_t_create(10);\n   287\t    list_item_t_t *list_inventory = list_item_t_create();\n   288\t    \n   289\t    printf(\"\\n--- Populating both Array and List ---\\n\");\n   290\t    \n   291\t    // Add same items to both\n   292\t    item_t items[] = {\n   293\t        create_item(1, \"Smartphone\", \"Electronics\", 699.99, 25),\n   294\t        create_item(2, \"Tablet\", \"Electronics\", 449.99, 18),\n   295\t        create_item(3, \"Headphones\", \"Electronics\", 149.99, 40),\n   296\t        create_item(4, \"Smart Watch\", \"Electronics\", 299.99, 22),\n   297\t        create_item(5, \"Power Bank\", \"Electronics\", 39.99, 55)\n   298\t    };\n   299\t    \n   300\t    int num_items = sizeof(items) / sizeof(items[0]);\n   301\t    \n   302\t    for (int i = 0; i < num_items; i++) {\n   303\t        array_item_t_push(array_inventory, items[i]);\n   304\t        list_item_t_append(list_inventory, items[i]);\n   305\t    }\n   306\t    \n   307\t    printf(\"Added %d items to both containers\\n\", num_items);\n   308\t    \n   309\t    // Compare iteration performance (conceptually)\n   310\t    printf(\"\\n--- Iterating through Array ---\\n\");\n   311\t    int array_count = 0;\n   312\t    item_t item;\n   313\t    ARRAY_FOREACH(item_t, item, array_inventory) {\n   314\t        array_count++;\n   315\t    }\n   316\t    printf(\"Array iteration count: %d\\n\", array_count);\n   317\t    \n   318\t    printf(\"\\n--- Iterating through List ---\\n\");\n   319\t    int list_count = 0;\n   320\t    LIST_FOREACH(item_t, item, list_inventory) {\n   321\t        list_count++;\n   322\t    }\n   323\t    printf(\"List iteration count: %d\\n\", list_count);\n   324\t    \n   325\t    // Find items above certain price in both\n   326\t    double price_threshold = 200.0;\n   327\t    \n   328\t    printf(\"\\n--- Items above $%.2f (Array) ---\\n\", price_threshold);\n   329\t    ARRAY_FOREACH(item_t, item, array_inventory) {\n   330\t        if (item.price >= price_threshold) {\n   331\t            printf(\"  %s: $%.2f\\n\", item.name, item.price);\n   332\t        }\n   333\t    }\n   334\t    \n   335\t    printf(\"\\n--- Items above $%.2f (List) ---\\n\", price_threshold);\n   336\t    LIST_FOREACH(item_t, item, list_inventory) {\n   337\t        if (item.price >= price_threshold) {\n   338\t            printf(\"  %s: $%.2f\\n\", item.name, item.price);\n   339\t        }\n   340\t    }\n   341\t    \n   342\t    // Cleanup\n   343\t    array_item_t_destroy(array_inventory);\n   344\t    list_item_t_destroy(list_inventory);\n   345\t}\n   346\t\n   347\tint main(void) {\n   348\t    printf(\"╔════════════════════════════════════════╗\\n\");\n   349\t    printf(\"║   GENERIC FOR_EACH MACRO DEMO         ║\\n\");\n   350\t    printf(\"║   Demonstrating Generic Containers    ║\\n\");\n   351\t    printf(\"╚════════════════════════════════════════╝\\n\");\n   352\t    \n   353\t    char input[256];\n   354\t    int choice;\n   355\t    \n   356\t    while (1) {\n   357\t        print_menu();\n   358\t        \n   359\t        if (!fgets(input, sizeof(input), stdin)) {\n   360\t            break;\n   361\t        }\n   362\t        \n   363\t        if (sscanf(input, \"%d\", &choice) != 1) {\n   364\t            printf(\"Invalid input\\n\");\n   365\t            continue;\n   366\t        }\n   367\t        \n   368\t        switch (choice) {\n   369\t            case 1:\n   370\t                demo_integer_containers();\n   371\t                break;\n   372\t                \n   373\t            case 2:\n   374\t                demo_double_containers();\n   375\t                break;\n   376\t                \n   377\t            case 3:\n   378\t                demo_inventory_array();\n   379\t                break;\n   380\t                \n   381\t            case 4:\n   382\t                demo_order_list();\n   383\t                break;\n   384\t                \n   385\t            case 5:\n   386\t                demo_mixed_operations();\n   387\t                break;\n   388\t                \n   389\t            case 6:\n   390\t                printf(\"\\n=== Running All Demos ===\\n\");\n   391\t                demo_integer_containers();\n   392\t                demo_double_containers();\n   393\t                demo_inventory_array();\n   394\t                demo_order_list();\n   395\t                demo_mixed_operations();\n   396\t                printf(\"\\n========================================\\n\");\n   397\t                printf(\"  All demos completed successfully!\\n\");\n   398\t                printf(\"========================================\\n\");\n   399\t                break;\n   400\t                \n   401\t            case 7:\n   402\t                printf(\"\\nGoodbye!\\n\");\n   403\t                return 0;\n   404\t                \n   405\t            default:\n   406\t                printf(\"Invalid choice\\n\");\n   407\t                break;\n   408\t        }\n   409\t    }\n   410\t    \n   411\t    return 0;\n   412\t}\n","exit_code":0,"status":"completed"}}
