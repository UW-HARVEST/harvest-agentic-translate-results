;\n    40\t} item_t;\n    41\t\n    42\ttypedef struct {\n    43\t    int customer_id;\n    44\t    char customer_name[MAX_NAME_LENGTH];\n    45\t    double total_amount;\n    46\t} order_t;\n    47\t\n    48\t// Declare containers for different types\n    49\tDECLARE_ARRAY(int)\n    50\tDECLARE_ARRAY(double)\n    51\tDECLARE_ARRAY(item_t)\n    52\tDECLARE_ARRAY(order_t)\n    53\t\n    54\tDECLARE_LIST(int)\n    55\tDECLARE_LIST(double)\n    56\tDECLARE_LIST(item_t)\n    57\tDECLARE_LIST(order_t)\n    58\t\n    59\t// Inventory management functions\n    60\tvoid print_item(item_t item);\n    61\tvoid print_order(order_t order);\n    62\titem_t create_item(int id, const char *name, const char *category, \n    63\t                   double price, int quantity);\n    64\torder_t create_order(int customer_id, const char *customer_name, \n    65\t                     double total_amount);\n    66\t\n    67\t// Statistics functions\n    68\tvoid calculate_inventory_stats(array_item_t_t *items);\n    69\tvoid calculate_order_stats(list_order_t_t *orders);\n    70\tvoid find_items_by_category(array_item_t_t *items, const char *category);\n    71\tvoid find_expensive_items(list_item_t_t *items, double min_price);\n    72\t\n    73\t#endif // INVENTORY_H\n     1\t/*\n     2\t * Copyright 2025 MIT Lincoln Laboratory\n     3\t * Permission is hereby granted, free of charge,\n     4\t * to any person obtaining a copy of this software\n     5\t * and associated documentation files (the \"Software\"),\n     6\t * to deal in the Software without restriction,\n     7\t * including without limitation the rights to use, copy,\n     8\t * modify, merge, publish, distribute, sublicense,\n     9\t * and/or sell copies of the Software,\n    10\t * and to permit persons to whom the Software is furnished to do so,\n    11\t * subject to the following conditions:\n    12\t * \n    13\t * The above copyright notice and this permission notice\n    14\t * shall be included in all copies or substantial portions of the Software.\n    15\t * \n    16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND,\n    17\t * EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    18\t * THE WARRANTIES OF MERCHANTABILITY,\n    19\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    20\t * IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    21\t * FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    22\t * TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    23\t * OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    24\t */\n    25\t// generic_containers.h\n    26\t#ifndef GENERIC_CONTAINERS_H\n    27\t#define GENERIC_CONTAINERS_H\n    28\t\n    29\t#include <stddef.h>\n    30\t#include <stdlib.h>\n    31\t#include <string.h>\n    32\t#include <stdio.h>\n    33\t\n    34\t// ============================================================================\n    35\t// GENERIC DYNAMIC ARRAY\n    36\t// ============================================================================\n    37\t\n    38\t#define DECLARE_ARRAY(TYPE) \\\n    39\t    typedef struct { \\\n    40\t        TYPE *data; \\\n    41\t        size_t size; \\\n    42\t        size_t capacity; \\\n    43\t    } array_##TYPE##_t; \\\n    44\t    \\\n    45\t    array_##TYPE##_t* array_##TYPE##_create(size_t initial_capacity); \\\n    46\t    void array_##TYPE##_destroy(array_##TYPE##_t *arr); \\\n    47\t    int array_##TYPE##_push(array_##TYPE##_t *arr, TYPE value); \\\n    48\t    TYPE array_##TYPE##_get(array_##TYPE##_t *arr, size_t index); \\\n    49\t    size_t array_##TYPE##_size(array_##TYPE##_t *arr); \\\n    50\t    void array_##TYPE##_clear(array_##TYPE##_t *arr);\n    51\t\n    52\t#define DEFINE_ARRAY(TYPE) \\\n    53\t    array_##TYPE##_t* array_##TYPE##_create(size_t initial_capacity) { \\\n    54\t        array_##TYPE##_t *arr = malloc(sizeof(array_##TYPE##_t)); \\\n    55\t        if (!arr) return NULL; \\\n    56\t        arr->capacity = initial_capacity > 0 ? initial_capacity : 16; \\\n    57\t        arr->size = 0; \\\n    58\t        arr->data = malloc(sizeof(TYPE) * arr->capacity); \\\n    59\t        if (!arr->data) { \\\n    60\t            free(arr); \\\n    61\t            return NULL; \\\n    62\t        } \\\n    63\t        return arr; \\\n    64\t    } \\\n    65\t    \\\n    66\t    void array_##TYPE##_destroy(array_##TYPE##_t *arr) { \\\n    67\t        if (arr) { \\\n    68\t            free(arr->data); \\\n    69\t            free(arr); \\\n    70\t        } \\\n    71\t    } \\\n    72\t    \\\n    73\t    int array_##TYPE##_push(array_##TYPE##_t *arr, TYPE value) { \\\n    74\t        if (!arr) return -1; \\\n    75\t        if (arr->size >= arr->capacity) { \\\n    76\t            size_t new_capacity = arr->capacity * 2; \\\n    77\t            TYPE *new_data = realloc(arr->data, sizeof(TYPE) * new_capacity); \\\n    78\t            if (!new_data) return -1; \\\n    79\t            arr->data = new_data; \\\n    80\t            arr->capacity = new_capacity; \\\n    81\t        } \\\n    82\t        arr->data[arr->size++] = value; \\\n    83\t        return 0; \\\n    84\t    } \\\n    85\t    \\\n    86\t    TYPE array_##TYPE##_get(array_##TYPE##_t *arr, size_t index) { \\\n    87\t        return arr->data[index]; \\\n    88\t    } \\\n    89\t    \\\n    90\t    size_t array_##TYPE##_size(array_##TYPE##_t *arr) { \\\n    91\t        return arr ? arr->size : 0; \\\n    92\t    } \\\n    93\t    \\\n    94\t    void array_##TYPE##_clear(array_##TYPE##_t *arr) { \\\n    95\t        if (arr) arr->size = 0; \\\n    96\t    }\n    97\t\n    98\t// FOR_EACH macro for arrays\n    99\t#define ARRAY_FOREACH(TYPE, var, arr) \\\n   100\t    for (size_t _i = 0; _i < (arr)->size && (var = (arr)->data[_i], 1); _i++)\n   101\t\n   102\t// ============================================================================\n   103\t// GENERIC LINKED LIST\n   104\t// ============================================================================\n   105\t\n   106\t#define DECLARE_LIST(TYPE) \\\n   107\t    typedef struct list_node_##TYPE { \\\n   108\t        TYPE data; \\\n   109\t        struct list_node_##TYPE *next; \\\n   110\t    } list_node_##TYPE##_t; \\\n   111\t    \\\n   112\t    typedef struct { \\\n   113\t        list_node_##TYPE##_t *head; \\\n   114\t        list_node_##TYPE##_t *tail; \\\n   115\t        size_t size; \\\n   116\t    } list_##TYPE##_t; \\\n   117\t    \\\n   118\t    list_##TYPE##_t* list_##TYPE##_create(void); \\\n   119\t    void list_##TYPE##_destroy(list_##TYPE##_t *list); \\\n   120\t    int list_##TYPE##_append(list_##TYPE##_t *list, TYPE value); \\\n   121\t    int list_##TYPE##_prepend(list_##TYPE##_t *list, TYPE value); \\\n   122\t    size_t list_##TYPE##_size(list_##TYPE##_t *list); \\\n   123\t    void list_##TYPE##_clear(list_##TYPE##_t *list);\n   124\t\n   125\t#define DEFINE_LIST(TYPE) \\\n   126\t    list_##TYPE##_t* list_##TYPE##_create(void) { \\\n   127\t        list_##TYPE##_t *list = malloc(sizeof(list_##TYPE##_t)); \\\n   128\t        if (!list) return NULL; \\\n   129\t        list->head = NULL; \\\n   130\t        list->tail = NULL; \\\n   131\t        list->size = 0; \\\n   132\t        return list; \\\n   133\t    } \\\n   134\t    \\\n   135\t    void list_##TYPE##_destroy(list_##TYPE##_t *list) { \\\n   136\t        if (!list) return; \\\n   137\t        list_node_##TYPE##_t *current = list->head; \\\n   138\t        while (current) { \\\n   139\t            list_node_##TYPE##_t *next = current->next; \\\n   140\t            free(current); \\\n   141\t            current = next; \\\n   142\t        } \\\n   143\t        free(list); \\\n   144\t    } \\\n   145\t    \\\n   146\t    int list_##TYPE##_append(list_##TYPE##_t *list, TYPE value) { \\\n   147\t        if (!list) return -1; \\\n   148\t        list_node_##TYPE##_t *node = malloc(sizeof(list_node_##TYPE##_t)); \\\n   149\t        if (!node) return -1; \\\n   150\t        node->data = value; \\\n   151\t        node->next = NULL; \\\n   152\t        if (!list->head) { \\\n   153\t            list->head = list->tail = node; \\\n   154\t        } else { \\\n   155\t            list->tail->next = node; \\\n   156\t            list->tail = node; \\\n   157\t        } \\\n   158\t        list->size++; \\\n   159\t        return 0; \\\n   160\t    } \\\n   161\t    \\\n   162\t    int list_##TYPE##_prepend(list_##TYPE##_t *list, TYPE value) { \\\n   163\t        if (!list) return -1; \\\n   164\t        list_node_##TYPE##_t *node = malloc(sizeof(list_node_##TYPE##_t)); \\\n   165\t        if (!node) return -1; \\\n   166\t        node->data = value; \\\n   167\t        node->next = list->head; \\\n   168\t        list->head = node; \\\n   169\t        if (!list->tail) { \\\n   170\t            list->tail = node; \\\n   171\t        } \\\n   172\t        list->size++; \\\n   173\t        return 0; \\\n   174\t    } \\\n   175\t    \\\n   176\t    size_t list_##TYPE##_size(list_##TYPE##_t *list) { \\\n   177\t        return list ? list->size : 0; \\\n   178\t    } \\\n   179\t    \\\n   180\t    void list_##TYPE##_clear(list_##TYPE##_t *list) { \\\n   181\t        if (!list) return; \\\n   182\t        list_node_##TYPE##_t *current = list->head; \\\n   183\t        while (current) { \\\n   184\t            list_node_##TYPE##_t *next = current->next; \\\n   185\t            free(current); \\\n   186\t            current = next; \\\n   187\t        } \\\n   188\t        list->head = list->tail = NULL; \\\n   189\t        list->size = 0; \\\n   190\t    }\n   191\t\n   192\t// FOR_EACH macro for linked lists\n   193\t#define LIST_FOREACH(TYPE, var, list) \\\n   194\t    for (list_node_##TYPE##_t *_node = (list)->head; \\\n   195\t         _node && (var = _node->data, 1); \\\n   196\t         _node = _node->next)\n   197\t\n   198\t#endif // GENERIC_CONTAINERS_H\n     1\t# Copyright 2025 MIT Lincoln Laboratory\n     2\t# Permission is hereby granted, free of charge,\n     3\t# to any person obtaining a copy of this software\n     4\t# and associated documentation files (the “Software”),\n     5\t# to deal in the Software without restriction,\n     6\t# including without limitation the rights to use, copy,\n     7\t# modify, merge, publish, distribute, sublicense,\n     8\t# and/or sell copies of the Software,\n     9\t# and to permit persons to whom the Software is furnished to do so,\n    10\t# subject to the following conditions:\n    11\t# \n    12\t# The above copyright notice and this permission notice\n    13\t# shall be included in all copies or substantial portions of the Software.\n    14\t# \n    15\t# THE SOFTWARE IS PROVIDED “AS IS”, WITHOUT WARRANTY OF ANY KIND,\n    16\t# EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO\n    17\t# THE WARRANTIES OF MERCHANTABILITY,\n    18\t# FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.\n    19\t# IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE\n    20\t# FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT,\n    21\t# TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE\n    22\t# OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.\n    23\t\n    24\tcmake_minimum_required(VERSION 3.10)\n    25\tproject(driver)\n    26\tadd_executable(driver src/main.c src/inventory.c)\n    27\ttarget_include_directories(driver PUBLIC include)\n","exit_code":0,"status":"completed"}}
