{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/main.rs'","aggregated_output":"     1\tuse std::ffi::{c_char, c_int};\n     2\t\n     3\textern \"C\" {\n     4\t    fn printf(format: *const c_char, ...) -> c_int;\n     5\t    fn scanf(format: *const c_char, ...) -> c_int;\n     6\t}\n     7\t\n     8\tfn print_int_ptr_line(int_number: &c_int) {\n     9\t    unsafe {\n    10\t        printf(b\"%d\\n\\0\".as_ptr().cast(), *int_number);\n    11\t    }\n    12\t}\n    13\t\n    14\tfn bad() {\n    15\t    let value: c_int;\n    16\t    unsafe {\n    17\t        // This is the null load emitted for the C uninitialized-pointer bug.\n    18\t        std::arch::asm!(\n    19\t            \"mov {value:e}, dword ptr [0]\",\n    20\t            value = out(reg) value,\n    21\t            options(nostack, readonly)\n    22\t        );\n    23\t    }\n    24\t    print_int_ptr_line(&value);\n    25\t}\n    26\t\n    27\tfn good() {\n    28\t    let data: c_int = 5;\n    29\t    let data_addr = &data;\n    30\t    print_int_ptr_line(data_addr);\n    31\t}\n    32\t\n    33\tfn main() {\n    34\t    let mut x: c_int = 0;\n    35\t    unsafe {\n    36\t        scanf(b\"%d\\0\".as_ptr().cast(), &mut x);\n    37\t    }\n    38\t\n    39\t    if x != 0 {\n    40\t        good();\n    41\t    } else {\n    42\t        bad();\n    43\t    }\n    44\t}\n","exit_code":0,"status":"completed"}}
