{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc 'nl -ba c_src/src/read-alert.c'","aggregated_output":"     1\t/* Copyright (C) 2015, Wazuh Inc.\n     2\t * Copyright (C) 2009 Trend Micro Inc.\n     3\t * All right reserved.\n     4\t *\n     5\t * This program is free software; you can redistribute it\n     6\t * and/or modify it under the terms of the GNU General Public\n     7\t * License (version 2) as published by the FSF - Free Software\n     8\t * Foundation\n     9\t */\n    10\t\n    11\t/* File monitoring functions */\n    12\t\n    13\t#include \"read-alert.h\"\n    14\t#include \"shared.h\"\n    15\t\n    16\t#include <stdlib.h>\n    17\t#include <stdio.h>\n    18\t#include <string.h>\n    19\t\n    20\t/* ** Alert xyz: email active-response ** */\n    21\t\n    22\t#define ALERT_BEGIN     \"** Alert\"\n    23\t#define ALERT_BEGIN_SZ  8\n    24\t#define RULE_BEGIN      \"Rule: \"\n    25\t#define RULE_BEGIN_SZ   6\n    26\t#define SRCIP_BEGIN     \"Src IP: \"\n    27\t#define SRCIP_BEGIN_SZ  8\n    28\t#define SRCPORT_BEGIN     \"Src Port: \"\n    29\t#define SRCPORT_BEGIN_SZ  10\n    30\t#define DSTIP_BEGIN     \"Dst IP: \"\n    31\t#define DSTIP_BEGIN_SZ  8\n    32\t#define DSTPORT_BEGIN     \"Dst Port: \"\n    33\t#define DSTPORT_BEGIN_SZ  10\n    34\t#define USER_BEGIN      \"User: \"\n    35\t#define USER_BEGIN_SZ   6\n    36\t#define ALERT_MAIL      \"mail\"\n    37\t#define ALERT_MAIL_SZ   4\n    38\t#define OLDMD5_BEGIN      \"Old md5sum was: \"\n    39\t#define OLDMD5_BEGIN_SZ   16\n    40\t#define NEWMD5_BEGIN      \"New md5sum is : \"\n    41\t#define NEWMD5_BEGIN_SZ   16\n    42\t#define OLDSHA1_BEGIN     \"Old sha1sum was: \"\n    43\t#define OLDSHA1_BEGIN_SZ  17\n    44\t#define NEWSHA1_BEGIN     \"New sha1sum is : \"\n    45\t#define NEWSHA1_BEGIN_SZ  17\n    46\t#define OLDSHA256_BEGIN     \"Old sha256sum was: \"\n    47\t#define OLDSHA256_BEGIN_SZ  19\n    48\t#define NEWSHA256_BEGIN     \"New sha256sum is : \"\n    49\t#define NEWSHA256_BEGIN_SZ  19\n    50\t/* \"9/19/2016 - Sivakumar Nellurandi - parsing additions\" */\n    51\t#define SIZE_BEGIN        \"Size changed from \"\n    52\t#define SIZE_BEGIN_SZ     18\n    53\t#define OWNER_BEGIN        \"Ownership was \"\n    54\t#define OWNER_BEGIN_SZ     14\n    55\t#define GROUP_BEGIN        \"Group ownership was \"\n    56\t#define GROUP_BEGIN_SZ     20\n    57\t#define PERM_BEGIN        \"Permissions changed from \"\n    58\t#define PERM_BEGIN_SZ     25\n    59\t\n    60\t#define LOG_LIMIT      100\n    61\t/* \"9/19/2016 - Sivakumar Nellurandi - parsing additions\" */\n    62\t\n    63\t\n    64\tvoid FreeAlertData(alert_data *al_data) {\n    65\t    char **p;\n    66\t    os_free(al_data->alertid);\n    67\t    os_free(al_data->date);\n    68\t    os_free(al_data->location);\n    69\t    os_free(al_data->comment);\n    70\t    os_free(al_data->group);\n    71\t    os_free(al_data->srcip);\n    72\t    os_free(al_data->dstip);\n    73\t    os_free(al_data->user);\n    74\t    os_free(al_data->filename);\n    75\t\n    76\t/* \"9/19/2016 - Sivakumar Nellurandi - parsing additions\" */\n    77\t    // if (al_data->log) {\n    78\t    //     p = al_data->log;\n    79\t    //\n    80\t    //     while (*(p)) {\n    81\t    //         os_free(*(p));\n    82\t    //         p++;\n    83\t    //     }\n    84\t    //     os_free(al_data->log);\n    85\t    // }\n    86\t\n    87\t    // al_data can't be NULL\n    88\t    free(al_data);\n    89\t    al_data = NULL;\n    90\t}\n    91\t\n    92\t/* Return alert data for the file specified */\n    93\talert_data *GetAlertData(int flag, FILE *fp) {\n    94\t\n    95\t    alert_data *al_data;\n    96\t    al_data = os_calloc(1, sizeof(alert_data));\n    97\t\n    98\t    int _r = 0, issyscheck = 0;\n    99\t    size_t log_size = 0;\n   100\t    char *p;\n   101\t    char str[OS_MAXSTR + 1];\n   102\t    str[OS_MAXSTR] = '\\0';\n   103\t\n   104\t    while (fgets(str, OS_MAXSTR, fp) != NULL) {\n   105\t        /* End of alert */\n   106\t        if (strncmp(ALERT_BEGIN, str, ALERT_BEGIN_SZ) == 0) {\n   107\t            char *m;\n   108\t            size_t z = 0;\n   109\t            /* End of the alert. */\n   110\t            if (_r == 2) {\n   111\t                if (fseek(fp, -strlen(str), SEEK_CUR) != -1) {\n   112\t                    return (al_data);\n   113\t                } else {\n   114\t                    goto l_error;\n   115\t                }\n   116\t            }\n   117\t\n   118\t            p = str + ALERT_BEGIN_SZ + 1;\n   119\t\n   120\t            m = strstr(p, \":\");\n   121\t            if (!m) {\n   122\t                continue;\n   123\t            }\n   124\t\n   125\t            z = strlen(p) - strlen(m);\n   126\t            al_data->alertid = os_realloc(al_data->alertid, (z + 1) * sizeof(char));\n   127\t            strncpy(al_data->alertid, p, z);\n   128\t            al_data->alertid[z] = '\\0';\n   129\t\n   130\t            /* Search for email flag */\n   131\t            p = strchr(p, ' ');\n   132\t            if (!p) {\n   133\t                continue;\n   134\t            }\n   135\t\n   136\t            p++;\n   137\t\n   138\t            /* Check for the flags */\n   139\t            if ((flag & CRALERT_MAIL_SET) &&\n   140\t                    (strncmp(ALERT_MAIL, p, ALERT_MAIL_SZ) != 0)) {\n   141\t                continue;\n   142\t            }\n   143\t\n   144\t            p = strchr(p, '-');\n   145\t            if (p) {\n   146\t                p++;\n   147\t                /* Skip leading spaces */\n   148\t                while (*p == ' ') {\n   149\t                        p++;\n   150\t                }\n   151\t                os_free(al_data->group);\n   152\t                al_data->group = os_strdup(p);\n   153\t\n   154\t                /* Clean newline from group */\n   155\t                os_clearnl(al_data->group, p);\n   156\t                if (al_data->group != NULL && strstr(al_data->group, \"syscheck\") != NULL) {\n   157\t                    issyscheck = 1;\n   158\t                }\n   159\t            }\n   160\t\n   161\t            /* Search for active-response flag */\n   162\t            _r = 1;\n   163\t            continue;\n   164\t        }\n   165\t\n   166\t        if (_r < 1) {\n   167\t            continue;\n   168\t        }\n   169\t\n   170\t        /*** Extract information from the event ***/\n   171\t\n   172\t        /* r1 means: 2006 Apr 13 16:15:17 /var/log/auth.log */\n   173\t        if (_r == 1) {\n   174\t            /* Clear newline */\n   175\t            os_clearnl(str, p);\n   176\t\n   177\t            p = strchr(str, ':');\n   178\t            if (p) {\n   179\t                p = strchr(p, ' ');\n   180\t                if (p) {\n   181\t                    *p = '\\0';\n   182\t                    p++;\n   183\t                } else {\n   184\t                    /* If p is null it is because strchr failed */\n   185\t                    perror(\"date of location not NULL\");\n   186\t                    goto l_error;\n   187\t                }\n   188\t            }\n   189\t\n   190\t            /* If not, str is date and p is the location */\n   191\t            if (al_data->date || al_data->location || !p) {\n   192\t                perror(\"date or location not NULL or p is NULL\");\n   193\t                goto l_error;\n   194\t            }\n   195\t\n   196\t            al_data->date = os_strdup(str);\n   197\t            al_data->location = os_strdup(p);\n   198\t            _r = 2;\n   199\t            log_size = 0;\n   200\t            continue;\n   201\t        } else if (_r == 2) {\n   202\t            /* Rule begin */\n   203\t            if (strncmp(RULE_BEGIN, str, RULE_BEGIN_SZ) == 0) {\n   204\t                os_clearnl(str, p);\n   205\t\n   206\t                p = str + RULE_BEGIN_SZ;\n   207\t                al_data->rule = atoi(p);\n   208\t\n   209\t                p = strchr(p, ' ');\n   210\t                if (p) {\n   211\t                    p++;\n   212\t                    p = strchr(p, ' ');\n   213\t                    if (p) {\n   214\t                        p++;\n   215\t                    }\n   216\t                }\n   217\t\n   218\t                if (!p) {\n   219\t                    goto l_error;\n   220\t                }\n   221\t\n   222\t                al_data->level = atoi(p);\n   223\t\n   224\t                /* Get the comment */\n   225\t                p = strchr(p, '\\'');\n   226\t                if (!p) {\n   227\t                    goto l_error;\n   228\t                }\n   229\t\n   230\t                p++;\n   231\t                os_free(al_data->comment);\n   232\t                al_data->comment = os_strdup(p);\n   233\t\n   234\t                /* Must have the closing \\' */\n   235\t                p = strrchr(al_data->comment, '\\'');\n   236\t                if (p) {\n   237\t                    *p = '\\0';\n   238\t                } else {\n   239\t                    goto l_error;\n   240\t                }\n   241\t            }\n   242\t\n   243\t            /* srcip */\n   244\t            else if (strncmp(SRCIP_BEGIN, str, SRCIP_BEGIN_SZ) == 0) {\n   245\t                os_clearnl(str, p);\n   246\t\n   247\t                p = str + SRCIP_BEGIN_SZ;\n   248\t                os_free(al_data->srcip);\n   249\t                al_data->srcip = os_strdup(p);\n   250\t            }\n   251\t            /* srcport */\n   252\t            else if (strncmp(SRCPORT_BEGIN, str, SRCPORT_BEGIN_SZ) == 0) {\n   253\t                os_clearnl(str, p);\n   254\t\n   255\t                p = str + SRCPORT_BEGIN_SZ;\n   256\t                al_data->srcport = atoi(p);\n   257\t            }\n   258\t            /* dstip */\n   259\t            else if (strncmp(DSTIP_BEGIN, str, DSTIP_BEGIN_SZ) == 0) {\n   260\t                os_clearnl(str, p);\n   261\t\n   262\t                p = str + DSTIP_BEGIN_SZ;\n   263\t                os_free(al_data->dstip);\n   264\t                al_data->dstip = os_strdup(p);\n   265\t            }\n   266\t            /* dstport */\n   267\t            else if (strncmp(DSTPORT_BEGIN, str, DSTPORT_BEGIN_SZ) == 0) {\n   268\t                os_clearnl(str, p);\n   269\t\n   270\t                p = str + DSTPORT_BEGIN_SZ;\n   271\t                al_data->dstport = atoi(p);\n   272\t            }\n   273\t            /* username */\n   274\t            else if (strncmp(USER_BEGIN, str, USER_BEGIN_SZ) == 0) {\n   275\t                os_clearnl(str, p);\n   276\t\n   277\t                p = str + USER_BEGIN_SZ;\n   278\t                os_free(al_data->user);\n   279\t                al_data->user = os_strdup(p);\n   280\t            }\n   281\t\n   282\t         /* \"9/19/2016 - Sivakumar Nellurandi - parsing additions\" */\n   283\t            /* It is a log message */\n   284\t            else if (log_size < LOG_LIMIT) {\n   285\t                os_clearnl(str, p);\n   286\t                if (issyscheck == 1) {\n   287\t                    if (strncmp(str, \"Integrity checksum changed for: '\", 33) == 0) {\n   288\t                        al_data->filename = strdup(str + 33);\n   289\t                        if (al_data->filename) {\n   290\t                            al_data->filename[strlen(al_data->filename) - 1] = '\\0';\n   291\t                        }\n   292\t                    }\n   293\t                    issyscheck = 0;\n   294\t                }\n   295\t\n   296\t                // al_data->log = os_realloc(al_data->log, (log_size + 2) * sizeof(char *));\n   297\t                // al_data->log[log_size] = os_strdup(str);\n   298\t                // log_size++;\n   299\t                // al_data->log[log_size] = NULL;\n   300\t            }\n   301\t        }\n   302\t    }\n   303\t\n   304\t    // We reached the end of the alert and the information is saved.\n   305\t    if (feof(fp) && _r == 2) {\n   306\t        return al_data;\n   307\t    }\n   308\t\n   309\tl_error:\n   310\t    /* Free the memory */\n   311\t    FreeAlertData(al_data);\n   312\t    /* We need to clean end of file before returning */\n   313\t    clearerr(fp);\n   314\t    return (NULL);\n   315\t}\n","exit_code":0,"status":"completed"}}
