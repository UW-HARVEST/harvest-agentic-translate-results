lude/\n    38\t    DESTINATION include)\n     1\t#ifndef SHARED_H\n     2\t#define SHARED_H\n     3\t\n     4\t#include <stdlib.h>\n     5\t#include <stdio.h>\n     6\t#include <string.h>\n     7\t\n     8\t#define OS_MAXSTR 1024\n     9\t\n    10\t#define os_free(x) if(x){free(x);x=NULL;};\n    11\t#define os_clearnl(x,p) if((p = strrchr(x, '\\n')))*p = '\\0';\n    12\t\n    13\tvoid *os_calloc(size_t num, size_t size) {\n    14\t    void *out = calloc(num, size);\n    15\t    if (!out) {\n    16\t        fprintf(stderr, \"Memory allocation failed in os_calloc\");\n    17\t        exit(EXIT_FAILURE);\n    18\t    }\n    19\t    return out;\n    20\t}\n    21\t\n    22\tvoid *os_realloc(void *ptr, size_t new_size) {\n    23\t    void *out = realloc(ptr, new_size);\n    24\t    if (!out) {\n    25\t        fprintf(stderr, \"Memory allocation failed in os_realloc\");\n    26\t        exit(EXIT_FAILURE);\n    27\t    }\n    28\t    return out;\n    29\t}\n    30\t\n    31\tchar *os_strdup(const char *str) {\n    32\t    if (!str) {\n    33\t        fprintf(stderr, \"NULL string passed to os_strdup\");\n    34\t        exit(EXIT_FAILURE);\n    35\t    }\n    36\t    char *dup = strdup(str);\n    37\t    if (!dup) {\n    38\t        fprintf(stderr, \"Memory allocation failed in os_strdup\");\n    39\t        exit(EXIT_FAILURE);\n    40\t    }\n    41\t    return dup;\n    42\t}\n    43\t\n    44\t#endif\n     1\t/* Copyright (C) 2015, Wazuh Inc.\n     2\t * Copyright (C) 2009 Trend Micro Inc.\n     3\t * All right reserved.\n     4\t *\n     5\t * This program is free software; you can redistribute it\n     6\t * and/or modify it under the terms of the GNU General Public\n     7\t * License (version 2) as published by the FSF - Free Software\n     8\t * Foundation\n     9\t */\n    10\t\n    11\t#ifndef CFQUEUE_H\n    12\t#define CFQUEUE_H\n    13\t\n    14\t#include <stdio.h>\n    15\t#include <time.h>\n    16\t#include <sys/stat.h>\n    17\t\n    18\t#define MAX_FQUEUE