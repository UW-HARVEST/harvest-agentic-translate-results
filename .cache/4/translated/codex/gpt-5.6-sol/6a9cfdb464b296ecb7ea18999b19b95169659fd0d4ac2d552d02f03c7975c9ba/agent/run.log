{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc 'nl -ba c_src/src/file-queue.c'","aggregated_output":"     1\t/* Copyright (C) 2015, Wazuh Inc.\n     2\t * Copyright (C) 2009 Trend Micro Inc.\n     3\t * All right reserved.\n     4\t *\n     5\t * This program is free software; you can redistribute it\n     6\t * and/or modify it under the terms of the GNU General Public\n     7\t * License (version 2) as published by the FSF - Free Software\n     8\t * Foundation\n     9\t */\n    10\t\n    11\t/* File monitoring functions */\n    12\t\n    13\t#include \"file-queue.h\"\n    14\t#include \"read-alert.h\"\n    15\t\n    16\t#include <stdio.h>\n    17\t#include <string.h>\n    18\t#include <sys/time.h>\n    19\t#include <errno.h>\n    20\t\n    21\t#define FSTAT_ERROR   \"(1118): Could not retrieve information of file '%s' due to [(%d)-(%s)].\"\n    22\t#define FSEEK_ERROR   \"(1116): Could not set position in file '%s' due to [(%d)-(%s)].\"\n    23\t\n    24\tvoid merror(const char *err_template, const char *file_name, int err, const char *err_msg) {\n    25\t    char buffer[256];\n    26\t    snprintf(buffer, sizeof(buffer), err_template, file_name, err, err_msg);\n    27\t    fprintf(stderr, \"%s\\n\", buffer);\n    28\t}\n    29\t\n    30\tstatic void file_sleep(void);\n    31\tstatic void GetFile_Queue(file_queue *fileq) __attribute__((nonnull));\n    32\tstatic int Handle_Queue(file_queue *fileq, int flags) __attribute__((nonnull));\n    33\t\n    34\t/* To translate between month (int) to month (char) */\n    35\tstatic const char *(s_month[]) = {\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\",\n    36\t                                  \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"\n    37\t                                 };\n    38\t\n    39\t\n    40\tstatic void file_sleep() {\n    41\t\n    42\t    struct timeval fp_timeout;\n    43\t\n    44\t    fp_timeout.tv_sec = FQ_TIMEOUT;\n    45\t    fp_timeout.tv_usec = 0;\n    46\t\n    47\t    /* Wait for the select timeout */\n    48\t    select(0, NULL, NULL, NULL, &fp_timeout);\n    49\t\n    50\t    return;\n    51\t}\n    52\t\n    53\t/* Get the file queue for that specific hour */\n    54\tstatic void GetFile_Queue(file_queue *fileq)\n    55\t{\n    56\t    /* Create the logfile name */\n    57\t    fileq->file_name[0] = '\\0';\n    58\t    fileq->file_name[MAX_FQUEUE] = '\\0';\n    59\t\n    60\t    snprintf(fileq->file_name, MAX_FQUEUE, \"%s\", fileq->flags & CRALERT_FP_SET ? \"<stdin>\" : ALERTS_DAILY);\n    61\t}\n    62\t\n    63\t/* Re Handle the file queue */\n    64\tstatic int Handle_Queue(file_queue *fileq, int flags)\n    65\t{\n    66\t    /* Close if it is open */\n    67\t    if (!(flags & CRALERT_FP_SET)) {\n    68\t        if (fileq->fp) {\n    69\t            fclose(fileq->fp);\n    70\t            fileq->fp = NULL;\n    71\t        }\n    72\t\n    73\t        /* We must be able to open the file, fseek and get the\n    74\t         * time of change from it.\n    75\t         */\n    76\t        fileq->fp = fopen(fileq->file_name, \"r\");\n    77\t        if (!fileq->fp) {\n    78\t            /* Queue not available */\n    79\t            return (0);\n    80\t        }\n    81\t    }\n    82\t\n    83\t    /* Seek to the end of the file */\n    84\t    if (!(flags & CRALERT_READ_ALL)) {\n    85\t        if (!fileq->fp) {\n    86\t            return (0);\n    87\t        }\n    88\t\n    89\t        if (fseek(fileq->fp, 0, SEEK_END) < 0) {\n    90\t            merror(FSEEK_ERROR, fileq->file_name, errno, strerror(errno));\n    91\t            fclose(fileq->fp);\n    92\t            fileq->fp = NULL;\n    93\t            return (-1);\n    94\t        }\n    95\t    }\n    96\t\n    97\t    /* File change time */\n    98\t    if (fileq->fp) {\n    99\t        if (fstat(fileno(fileq->fp), &fileq->f_status) < 0) {\n   100\t            merror(FSTAT_ERROR, fileq->file_name, errno, strerror(errno));\n   101\t            fclose(fileq->fp);\n   102\t            fileq->fp = NULL;\n   103\t            return (-1);\n   104\t        }\n   105\t    }\n   106\t\n   107\t    fileq->last_change = fileq->f_status.st_mtime;\n   108\t\n   109\t    return (1);\n   110\t}\n   111\t\n   112\t/* Initiates the file monitoring */\n   113\tint Init_FileQueue(file_queue *fileq, const struct tm *p, int flags)\n   114\t{\n   115\t    /* Initialize file_queue fields */\n   116\t    if (!(flags & CRALERT_FP_SET)) {\n   117\t        fileq->fp = NULL;\n   118\t    }\n   119\t    fileq->last_change = 0;\n   120\t    fileq->flags = 0;\n   121\t\n   122\t    fileq->day = p->tm_mday;\n   123\t    fileq->year = p->tm_year + 1900;\n   124\t\n   125\t    strncpy(fileq->mon, s_month[p->tm_mon], 3);\n   126\t    memset(fileq->file_name, '\\0', MAX_FQUEUE + 1);\n   127\t\n   128\t    /* Set the supplied flags */\n   129\t    fileq->flags = flags;\n   130\t\n   131\t    /* Get latest file */\n   132\t    GetFile_Queue(fileq);\n   133\t\n   134\t    /* Always seek to the end when starting the queue */\n   135\t    if (Handle_Queue(fileq, fileq->flags) < 0) {\n   136\t        return (-1);\n   137\t    }\n   138\t\n   139\t    return (0);\n   140\t}\n   141\t\n   142\t/* Reads from the monitored file */\n   143\talert_data *Read_FileMon(file_queue *fileq, const struct tm *p, unsigned int timeout)\n   144\t{\n   145\t    unsigned int i = 0;\n   146\t    alert_data *al_data;\n   147\t\n   148\t    /* If the file queue is not available, try to access it */\n   149\t    if (!fileq->fp) {\n   150\t        if (Handle_Queue(fileq, 0) != 1) {\n   151\t            file_sleep();\n   152\t            return (NULL);\n   153\t        }\n   154\t    }\n   155\t\n   156\t    if(!fileq->fp){\n   157\t        return (NULL);\n   158\t    }\n   159\t\n   160\t    if (al_data = GetAlertData(fileq->flags, fileq->fp), al_data) {\n   161\t        return al_data;\n   162\t    }\n   163\t\n   164\t    fileq->day = p->tm_mday;\n   165\t    fileq->year = p->tm_year + 1900;\n   166\t    strncpy(fileq->mon, s_month[p->tm_mon], 3);\n   167\t\n   168\t    /* Get latest file */\n   169\t    GetFile_Queue(fileq);\n   170\t\n   171\t    if (Handle_Queue(fileq, 0) != 1) {\n   172\t        file_sleep();\n   173\t        return (NULL);\n   174\t    }\n   175\t\n   176\t    /* Try up to timeout times to get an event */\n   177\t    while (i < timeout) {\n   178\t        al_data = GetAlertData(fileq->flags, fileq->fp);\n   179\t        if (al_data) {\n   180\t            return (al_data);\n   181\t        }\n   182\t\n   183\t        i++;\n   184\t        file_sleep();\n   185\t    }\n   186\t\n   187\t    /* Return NULL if timeout expires */\n   188\t    return (NULL);\n   189\t}\n","exit_code":0,"status":"completed"}}
