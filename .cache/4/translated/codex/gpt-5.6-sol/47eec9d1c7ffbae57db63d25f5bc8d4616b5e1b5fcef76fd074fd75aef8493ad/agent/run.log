{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes\nimport itertools\nimport random\nimport struct\n\nFloat = ctypes.c_float\nPtr = ctypes.POINTER(Float)\n\ndef load(path):\n    lib = ctypes.CDLL(path, mode=ctypes.RTLD_LOCAL)\n    fn = lib.colourblind\n    fn.argtypes = [ctypes.c_int, Ptr, Ptr, Ptr]\n    fn.restype = None\n    return fn\n\nc_fn = load('./c_reference/libtranslated_rust.so')\nr_fn = load('./target/release/libtranslated_rust.so')\n\ndef f32(bits):\n    return Float.from_buffer_copy(struct.pack('=I', bits)).value\n\ndef bits(value):\n    return struct.unpack('=I', struct.pack('=f', value))[0]\n\ndef run_separate(fn, impairment, values):\n    cells = [Float(value) for value in values]\n    fn(impairment, *(ctypes.byref(cell) for cell in cells))\n    return tuple(bits(cell.value) for cell in cells)\n\nedge_bits = [\n    0x00000000, 0x80000000, 0x00000001, 0x007fffff,\n    0x00800000, 0x3f000000, 0x3f800000, 0x40000000,\n    0x7f7fffff, 0x7f800000, 0xff800000, 0x7fc00000,\n    0x7fa00001, 0xffc12345,\n]\nchecked = 0\nfor impairment in range(3):\n    for raw in itertools.product(edge_bits, repeat=3):\n        values = tuple(f32(value) for value in raw)\n        c_out = run_separate(c_fn, impairment, values)\n        r_out = run_separate(r_fn, impairment, values)\n        if c_out \"'!= r_out:\n            raise SystemExit(f'\"'edge mismatch impairment={impairment} input={raw} C={c_out} Rust={r_out}')\n        checked += 1\n\nrng = random.Random(0xC010B11D)\nfor impairment in range(3):\n    for _ in range(200_000):\n        raw = tuple(rng.getrandbits(32) for _ in range(3))\n        values = tuple(f32(value) for value in raw)\n        c_out = run_separate(c_fn, impairment, values)\n        r_out = run_separate(r_fn, impairment, values)\n        if c_out \"'!= r_out:\n            raise SystemExit(f'\"'random mismatch impairment={impairment} input={raw} C={c_out} Rust={r_out}')\n        checked += 1\n\n# Exercise all pointer alias partitions using indices into a three-float array.\nfor impairment in range(3):\n    for mapping in itertools.product(range(3), repeat=3):\n        for _ in range(2_000):\n            raw = [rng.getrandbits(32) for _ in range(3)]\n            c_cells = (Float * 3)(*(f32(value) for value in raw))\n            r_cells = (Float * 3)(*(f32(value) for value in raw))\n            c_ptrs = [ctypes.cast(ctypes.byref(c_cells, i * ctypes.sizeof(Float)), Ptr) for i in mapping]\n            r_ptrs = [ctypes.cast(ctypes.byref(r_cells, i * ctypes.sizeof(Float)), Ptr) for i in mapping]\n            c_fn(impairment, *c_ptrs)\n            r_fn(impairment, *r_ptrs)\n            c_out = tuple(bits(value) for value in c_cells)\n            r_out = tuple(bits(value) for value in r_cells)\n            if c_out \"'!= r_out:\n                raise SystemExit(f'\"'alias mismatch impairment={impairment} mapping={mapping} input={raw} C={c_out} Rust={r_out}')\n            checked += 1\n\nfor impairment in (-2**31, -1, 3, 99, 2**31 - 1):\n    before = (0x01234567, 0x89abcdef, 0x7fc12345)\n    values = tuple(f32(value) for value in before)\n    c_out = run_separate(c_fn, impairment, values)\n    r_out = run_separate(r_fn, impairment, values)\n    if c_out \"'!= before or r_out != before:\n        raise SystemExit(f'\"'invalid-enum mutation impairment={impairment} C={c_out} Rust={r_out}')\n    c_fn(impairment, None, None, None)\n    r_fn(impairment, None, None, None)\n    checked += 1\n\nprint(f'byte-identical differential cases: {checked}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
