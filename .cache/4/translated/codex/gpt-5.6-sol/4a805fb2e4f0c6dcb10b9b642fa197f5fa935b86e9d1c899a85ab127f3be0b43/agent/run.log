TER(Simplex)],V),'c2MulrvT':([R,V],V),\n'c2GJK':([C.c_void_p,C.c_int,C.POINTER(X),C.c_void_p,C.c_int,C.POINTER(X),C.POINTER(V),C.POINTER(V),C.c_int,C.POINTER(C.c_int),C.POINTER(Cache)],C.c_float),\n'c2AABBtoAABB':([AABB,AABB],C.c_int),'c2AABBtoCapsule':([AABB,Capsule],C.c_int),\n'c2CapsuletoCapsule':([Capsule,Capsule],C.c_int),'c2CircletoCircle':([Circle,Circle],C.c_int),\n'c2CircletoAABB':([Circle,AABB],C.c_int),'c2CircletoCapsule':([Circle,Capsule],C.c_int),\n'c2Collided':([C.c_void_p,C.c_int,C.c_void_p,C.c_int],C.c_int),\n'reverse_collide':([C.c_float,C.c_float,C.c_float],C.c_int)}\nfor lib in libs:\n    for name,(args,ret) in protos.items():\n        f=getattr(lib,name); f.argtypes=args; f.restype=ret\n\ndef raw(x):\n    if isinstance(x,float): return struct.pack('f',x)\n    if isinstance(x,int): return struct.pack('i',x)\n    return bytes(x)\ndef eq(name,a,b):\n    if raw(a)\"'!=raw(b): raise AssertionError(f'\"'{name}: {raw(a).hex()} \"'!= {raw(b).hex()}'\"')\ndef cp(x): return type(x).from_buffer_copy(bytes(x))\ndef pair(name,*args):\n    aa=[cp(x) if isinstance(x,C.Structure) else x for x in args]\n    bb=[cp(x) if isinstance(x,C.Structure) else x for x in args]\n    a=getattr(libs[0],name)(*aa); b=getattr(libs[1],name)(*bb); eq(name,a,b)\n\nrng=random.Random(0xC2)\nvals=[-100.0,-10.0,-1.0,-0.0,0.0,0.125,1.0,3.5,100.0]\nvecs=[V(x,y) for x in vals for y in vals]\nfor _ in range(300): vecs.append(V(rng.uniform(-100,100),rng.uniform(-100,100)))\nfor v in vecs:\n    pair('c2V',v.x,v.y); pair('c2Neg',v); pair('c2Skew',v); pair('c2CCW90',v); pair('c2Len',v)\n    if v.x\"'!=0 or v.y!=0: pair('\"'c2Norm',v)\nfor _ in range(500):\n    a,b=rng.choice(vecs),rng.choice(vecs); s=rng.choice(vals[1:])\n    for n,args in [('c2Mulvs',(a,s)),('c2Maxv',(a,b)),('c2Minv',(a,b)),('c2Sub',(a,b)),('c2Dot',(a,b)),('c2Det2',(a,b)),('c2Add',(a,b)),('c2Div',(a,s))]: pair(n,*args)\n    lo=V(min(a.x,b.x),min(a.y,b.y)); hi=V(max(a.x,b.x),max(a.y,b.y)); pair('c2Clampv',rng.choice(vecs),lo,