{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes\nimport os\nimport random\nimport zlib\n\nroot = os.getcwd()\npaths = {\n    \\\"c\\\": os.path.join(root, \\\"reference_c/libtranslated_rust.so\\\"),\n    \\\"rust\\\": os.path.join(root, \\\"target/release/libtranslated_rust.so\\\"),\n}\nlibs = {name: ctypes.CDLL(path) for name, path in paths.items()}\nfor lib in libs.values():\n    lib.pinflate.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_void_p, ctypes.c_int]\n    lib.pinflate.restype = ctypes.c_int\n\narray_specs = {\n    \\\"cp_fixed_table\\\": (ctypes.c_uint8, 320),\n    \\\"cp_permutation_order\\\": (ctypes.c_uint8, 19),\n    \\\"cp_len_extra_bits\\\": (ctypes.c_uint8, 31),\n    \\\"cp_len_base\\\": (ctypes.c_uint32, 31),\n    \\\"cp_dist_extra_bits\\\": (ctypes.c_uint8, 32),\n    \\\"cp_dist_base\\\": (ctypes.c_uint32, 32),\n}\nfor symbol, (typ, count) in array_specs.items():\n    values = {name: bytes((typ * count).in_dll(lib)) for name, lib in libs.items()}\n    assert values[\\\"c\\\"] == values[\\\"rust\\\"], symbol\n\n\ndef raw_deflate(data, level=6, strategy=zlib.Z_DEFAULT_STRATEGY):\n    obj = zlib.compressobj(level=level, wbits=-15, strategy=strategy)\n    return obj.compress(data) + obj.flush()\n\n\ndef invoke(lib, compressed, out_size, alignment):\n    storage = ctypes.create_string_buffer(len(compressed) + 8)\n    base = ctypes.addressof(storage)\n    offset = next(i for i in range(8) if (base + i) % 4 == alignment)\n    ctypes.memmove(base + offset, compressed, len(compressed))\n    output = (ctypes.c_ubyte * max(out_size, 1))()\n    ctypes.memset(output, 0xA5, max(out_size, 1))\n    result = lib.pinflate(base + offset, len(compressed), output, out_size)\n    reason_ptr = ctypes.c_void_p.in_dll(lib, \\\"cp_error_reason\\\").value\n    reason = ctypes.string_at(reason_ptr) if reason_ptr else None\n    return result, bytes(output), reason\n\nrandom.seed(123456)\npayloads = [\n    b\\\"\\\",\n    b\\\"a\\\",\n    b\\\"hello world\\\",\n    b\\\"A\\\" * 4096,\n    bytes(range(256)) * 8,\n    (b\\\"the quick brown fox jumps over the lazy dog\\\\n\\\" * 300),\n]\nfor size in [2, 3, 7, 15, 31, 63, 127, 255, 511, 1023, 4097]:\n    payloads.append(random.randbytes(size))\n\ncases = []\nfor payload in payloads:\n    cases.append((\\\"dynamic\\\", payload, raw_deflate(payload, 6)))\n    cases.append((\\\"fixed\\\", payload, raw_deflate(payload, 6, zlib.Z_FIXED)))\n    cases.append((\\\"stored\\\", payload, raw_deflate(payload, 0)))\n\nvalid_calls = 0\nfor kind, payload, compressed in cases:\n    for alignment in range(4):\n        for extra in (0, 17):\n            out_size = len(payload) + extra\n            got = {name: invoke(lib, compressed, out_size, alignment) for name, lib in libs.items()}\n            assert got[\\\"c\\\"] == got[\\\"rust\\\"], (kind, len(payload), alignment, extra, got)\n            result, output, _ = got[\\\"rust\\\"]\n            assert result == 1, (kind, len(payload), alignment, result)\n            assert output[:len(payload)] == payload, (kind, len(payload), alignment)\n            assert output[len(payload):out_size] == b\\\"\\\\xA5\\\" * extra\n            valid_calls += 1\n\n# Exercise both output-capacity checks and compare partial output exactly.\nfor payload in [b\\\"abcdef\\\", b\\\"A\\\" * 100, bytes(range(100))]:\n    for strategy in (zlib.Z_DEFAULT_STRATEGY, zlib.Z_FIXED):\n        compressed = raw_deflate(payload, 6, strategy)\n        for out_size in range(len(payload)):\n            got = {name: invoke(lib, compressed, out_size, 0) for name, lib in libs.items()}\n            assert got[\\\"c\\\"] == got[\\\"rust\\\"], (len(payload), strategy, out_size, got)\n            assert got[\\\"rust\\\"][0] == 0\n\ninvalid_cases = [\n    b\\\"\\\\x07\\\",  # final block with reserved type\n    b\\\"\\\\x01\\\\x01\\\\x00\\\\x00\\\\x00X\\\",  # bad stored-block complement\n    b\\\"\\\\x01\\\\x01\\