 f32;\n        let mut h = *src.add(0);\n        let s = *src.add(1);\n        let v = *src.add(2);\n        let i: c_int;\n        if s == 0.0 {\n            *dest.add(0) = v;\n            *dest.add(1) = v;\n            *dest.add(2) = v;\n            return;\n        }\n        h /= 60.0f32;\n        i = c_float_to_int(floorf(h));\n        f = h - (i as f32);\n        p = v * (1.0f32 - s);\n        q = v * (1.0f32 - s * f);\n        t = v * (1.0f32 - s * (1.0f32 - f));\n        match i {\n            0 => {\n                r = v;\n                g = t;\n                b = p;\n            }\n            1 => {\n                r = q;\n                g = v;\n                b = p;\n            }\n            2 => {\n                r = p;\n                g = v;\n                b = t;\n            }\n            3 => {\n                r = p;\n                g = q;\n                b = v;\n            }\n            4 => {\n                r = t;\n                g = p;\n                b = v;\n            }\n            _ => {\n                r = v;\n                g = p;\n                b = q;\n            }\n        }\n        *dest.add(0) = r;\n        *dest.add(1) = g;\n        *dest.add(2) = b;\n    }\n}\n\n// ---------------------------------------------------------------------------\n// f13 — RGB to HSV\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn f13(dest: *mut f32, src: *const f32) {\n    unsafe {\n        let r = *src.add(0);\n        let g = *src.add(1);\n        let b = *src.add(2);\n        let mut h: f32 = 0.0;\n        let mut s: f32 = 0.0;\n        let v: f32;\n        let mut min = r;\n        let mut max = r;\n        let delta: f32;\n        min = if min < g { min } else { g };\n        min = if min < b { min } else { b };\n        max = if max > g { max } else { g };\n        max = if max > b { max } else { b };\n        delta = max - min;\n        v =