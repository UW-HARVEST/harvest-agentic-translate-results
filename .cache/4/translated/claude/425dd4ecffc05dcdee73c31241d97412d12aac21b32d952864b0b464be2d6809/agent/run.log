{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_015zYznCLRuqr3PrUg9MjiNd","type":"tool_result","content":"1\t//! Rust translation of the C library in `c_src/`.\n2\t//!\n3\t//! This crate reproduces the complete public ABI of the shared library built\n4\t//! from `c_src/src/lib.c` (see `c_src/CMakeLists.txt`), and is intended to be\n5\t//! byte-for-byte behaviourally identical to the original C code — including any\n6\t//! bugs or questionable constructs present in the original.\n7\t//!\n8\t//! Original C library: Maratis Tiny C library, Copyright (c) 2015 Anael Seghezzi.\n9\t\n10\t#![allow(non_snake_case)]\n11\t#![allow(non_camel_case_types)]\n12\t#![allow(non_upper_case_globals)]\n13\t\n14\tmod tables;\n15\t\n16\tuse core::ffi::{c_int, c_void};\n17\t\n18\tuse tables::{M_EXPONENT, M_MANTISSA, M_OFFSET};\n19\t\n20\t// ---------------------------------------------------------------------------\n21\t// Helpers reproducing exact C semantics\n22\t// ---------------------------------------------------------------------------\n23\t\n24\t/// `INT_MIN` as spelled in the C source (`-0x7fffffff - 1`).\n25\tconst C_INT_MIN: c_int = -0x7fff_ffff - 1;\n26\t\n27\t/// Reproduces a C `(int)` cast from `float` on x86-64 (SSE `cvttss2si`).\n28\t///\n29\t/// The C standard leaves out-of-range / NaN conversions undefined; on x86-64\n30\t/// the hardware yields the \"integer indefinite\" value `0x80000000`.\n31\t#[inline]\n32\tfn c_float_to_int(v: f32) -> c_int {\n33\t    if v.is_nan() || v >= 2147483648.0f32 || v < -2147483648.0f32 {\n34\t        C_INT_MIN\n35\t    } else {\n36\t        // In-range: `as` performs the same truncation-toward-zero as C.\n37\t        v as c_int\n38\t    }\n39\t}\n40\t\n41\t/// `fabsf`\n42\t#[inline]\n43\tfn fabsf(x: f32) -> f32 {\n44\t    // f32::abs() is a bit-twiddle on the sign bit, exactly like fabsf().\n45\t    f32::from_bits(x.to_bits() & 0x7fff_ffff)\n46\t}\n47\t\n48\t/// `fmodf`\n49\t#[inline]\n50\tfn fmodf(x: f32, y: f32) -> f32 {\n51\t    // Rust's `%` on floats lowers to `frem`, i.e. fmodf semantics.\n52\t    x % y\n53\t}\n54\t\n55\t/// `floorf`\n56\t#[inline]\n57\tfn floorf(x: f32) -> f32 {\n58\t    x.floor()\n59\t}\n60\t"}]},"parent_tool_use_id":null,"session_id":"9abf1984-e81e-4f9d-82b7-7abb1c6f6e38","uuid":"058cad86-0c9e-4605-b981-21326241b27b","timestamp":"2026-08-20T02:19:21.885Z","tool_use_result":{"type":"text","file":{"filePath":"/local/home/scheschb/.harvest/work/harvest-translate-Sr1LXj/translated_rust/src/lib.rs","content":"//! Rust translation of the C library in `c_src/`.\n//!\n//! This crate reproduces the complete public ABI of the shared library built\n//! from `c_src/src/lib.c` (see `c_src/CMakeLists.txt`), and is intended to be\n//! byte-for-byte behaviourally identical to the original C code — including any\n//! bugs or questionable constructs present in the original.\n//!\n//! Original C library: Maratis Tiny C library, Copyright (c) 2015 Anael Seghezzi.\n\n#![allow(non_snake_case)]\n#![allow(non_camel_case_types)]\n#![allow(non_upper_case_globals)]\n\nmod tables;\n\nuse core::ffi::{c_int, c_void};\n\nuse tables::{M_EXPONENT, M_MANTISSA, M_OFFSET};\n\n// ---------------------------------------------------------------------------\n// Helpers reproducing exact C semantics\n// ---------------------------------------------------------------------------\n\n/// `INT_MIN` as spelled in the C source (`-0x7fffffff - 1`).\nconst C_INT_MIN: c_int = -0x7fff_ffff - 1;\n\n/// Reproduces a C `(int)` cast from `float` on x86-64 (SSE `cvttss2si`).\n///\n/// The C standard leaves out-of-range / NaN conversions undefined; on x86-64\n/// the hardware yields the \"integer indefinite\" value `0x80000000`.\n#[inline]\nfn c_float_to_int(v: f32) -> c_int {\n    if v.is_nan() || v >= 2147483648.0f32 || v < -2147483648.0f32 {\n        C_INT_MIN\n    } else {\n        // In-range: `as` performs the same truncation-toward-zero as C.\n        v as c_int\n    }\n}\n\n/// `fabsf`\n#[inline]\nfn fabsf(x: f32) -> f32 {\n    // f32::abs() is a bit-twiddle on the sign bit, exactly like fabsf().\n    f32::from_bits(x.to_bits() & 0x7fff_ffff)\n}\n\n/// `fmodf`\n#[inline]\nfn fmodf(x: f32, y: f32) -> f32 {\n    // Rust's `%` on floats lowers to `frem`, i.e. fmodf semantics.\n    x % y\n}\n\n/// `floorf`\n#[inline]\nfn floorf(x: f32) -> f32 {\n    x.floor()\n}\n","numLines":60,"startLine":1,"totalLines":718}}}
