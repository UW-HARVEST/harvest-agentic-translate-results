dot01 * dot02) * invDenom;\n    lm_v2(u, v)\n}\n\n// ---------------------------------------------------------------------------\n// f10 — half-float to float\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn f10(h: u16) -> f32 {\n    let n = (h >> 10) as usize;\n    let num = M_MANTISSA[((h & 0x3ff) as usize) + (M_OFFSET[n] as usize)]\n        .wrapping_add(M_EXPONENT[n]);\n    f32::from_bits(num)\n}\n\n// ---------------------------------------------------------------------------\n// f11 — HSL to RGB\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn f11(dest: *mut f32, src: *const f32) {\n    unsafe {\n        let h = *src.add(0);\n        let s = *src.add(1);\n        let l = *src.add(2);\n        let c: f32;\n        let m: f32;\n        let x: f32;\n        if s == 0.0 {\n            *dest.add(0) = l;\n            *dest.add(1) = l;\n            *dest.add(2) = l;\n            return;\n        }\n        c = (1.0f32 - fabsf(2.0f32 * l - 1.0f32)) * s;\n        m = 1.0f32 * (l - 0.5f32 * c);\n        x = c * (1.0f32 - fabsf(fmodf(h / 60.0f32, 2.0f32) - 1.0f32));\n        if h >= 0.0f32 && h < 60.0f32 {\n            *dest.add(0) = c + m;\n            *dest.add(1) = x + m;\n            *dest.add(2) = m;\n        } else if h >= 60.0f32 && h < 120.0f32 {\n            *dest.add(0) = x + m;\n            *dest.add(1) = c + m;\n            *dest.add(2) = m;\n        } else if h < 120.0f32 && h < 180.0f32 {\n            // NOTE: reproduces the original C code verbatim (`h < 120.0f`\n            // instead of `h >= 120.0f`).\n            *dest.add(0) = m;\n            *dest.add(1) = c + m;\n            *dest.add(2) = x + m;\n        } else if h >= 180.0f32 && h < 240.0f32 {\n            *dest.add(0) = m;\n            *dest.add(1) = x + m;\n            *dest.add(2) = c + m;\n        } else if h >= 240.0f32 && h < 300.0f32 {\n            *dest.add(0) = x + m;\n            *dest.add(1) = m;\n            *dest.add(2) = c + m;\n        } else if h >= 300.0f32 && h < 360.0f32 {\n            *dest.add(0) = c + m;\n            *dest.add(1) = m;\n            *dest.add(2) = x + m;\n        } else {\n            *dest.add(0) = m;\n            *dest.add(1) = m;\n            *dest.add(2) = m;\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// f12 — HSV to RGB\n// ---------------------------------------------------------------------------\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn f12(dest: *mut f32, src: *const f32) {\n    unsafe {\n        let r: f32;\n        let g: f32;\n        let b: f32;\n        let f: f32;\n        let p: f32;\n        let q: f32;\n        let t: f32;\n        let mut h = *src.add(0);\n        let s = *src.add(1);\n        let v = *src.add(2);\n        let i: c_int;\n        if s == 0.0 {\n            *dest.add(0) = v;\n            *dest.add(1) = v;\n            *dest.add(2) = v;\n            return;\n        }\n        h /= 60.0f32;\n        i = c_float_to_int(floorf(h));\n        f = h - (i as f32);\n        p = v * (1.0f32 - s);\n        q = v * (1.0f32 - s * f);\n        t = v * (1.0f32 - s * (1.0f32 - f));\n        match i {\n            0 => {\n                r = v;\n                g = t;\n                b = p;\n            }\n            1 => {\n                r = q;\n                g = v;\n                b = p;\n            }\n            2 => {\n                r = p;\n                g = v;\n                b = t;\n            }\n            3 => {\n                r = p;\n                g = q;\n                b = v;\n            }\n            4 => {\n                r = t;\n                g = p;\n                b = v;\n            }\n            _ => {\n                r = v;\n                g = p;\n                b = q;\n            }\n        }\n        *dest.add(0) = r;\n        