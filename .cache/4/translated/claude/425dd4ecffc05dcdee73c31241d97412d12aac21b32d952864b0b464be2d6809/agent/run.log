{\n        quiet_nan(src)\n    } else {\n        dst - src\n    }\n}\n\n#[inline(always)]\nfn ss_mul(dst: f32, src: f32) -> f32 {\n    if dst.is_nan() {\n        quiet_nan(dst)\n    } else if src.is_nan() {\n        quiet_nan(src)\n    } else {\n        dst * src\n    }\n}\n\n#[inline(always)]\nfn ss_div(dst: f32, src: f32) -> f32 {\n    if dst.is_nan() {\n        quiet_nan(dst)\n    } else if src.is_nan() {\n        quiet_nan(src)\n    } else {\n        dst / src\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5420,"cache_read_input_tokens":100045,"cache_creation":{"ephemeral_5m_input_tokens":5420,"ephemeral_1h_input_tokens":0},"output_tokens":17,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"9abf1984-e81e-4f9d-82b7-7abb1c6f6e38","uuid":"80a24bad-dbf4-4f32-a4d2-9c57ccb282c3","timestamp":"2026-08-20T02:19:34.709Z"}
