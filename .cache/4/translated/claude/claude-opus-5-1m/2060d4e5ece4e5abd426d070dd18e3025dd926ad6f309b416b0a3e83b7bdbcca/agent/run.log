& (*F).start_match == (*mb).start_subject.add((*mb).start_offset)))\n123\t        {\n124\t            rrc = MATCH_NOMATCH;\n125\t            lbl = LBL_RETURN_SWITCH;\n126\t            continue 'sw;\n127\t        }\n128\t\n129\t        /* Fail if PCRE2_ENDANCHORED is set and the end of the match is not\n130\t        the end of the subject. After (*ACCEPT) we fail the entire match (at this\n131\t        position) but backtrack if we've reached the end of the pattern. This\n132\t        applies whether or not we are in a recursion. */\n133\t\n134\t        if (*F).eptr < (*mb).end_subject\n135\t            && (((*mb).moptions | (*mb).poptions) & PCRE2_ENDANCHORED) != 0\n136\t        {\n137\t            if (*F).op as u32 == OP_END {\n138\t                rrc = MATCH_NOMATCH;\n139\t                lbl = LBL_RETURN_SWITCH;\n140\t                continue 'sw;\n141\t            }\n142\t\n143\t            return MATCH_NOMATCH; /* (*ACCEPT) */\n144\t        }\n145\t\n146\t        /* Fail if we detect that the start position was moved to be either after\n147\t        the end position (\\K in lookahead) or before the start offset (\\K in\n148\t        lookbehind). If this occurs, the pattern must have used \\K in a somewhat\n149\t        sneaky way (e.g. by pattern recursion), because if the \\K is actually\n150\t        syntactically inside the lookaround, it's blocked at compile-time. */\n151\t\n152\t        if (*F).start_match < (*mb).start_subject.add((*mb).start_offset)\n153\t            || (*F).start_match > (*F).eptr\n154\t        {\n155\t            /* PCRE2_ASSERT(mb->hasbsk); */\n156\t\n157\t            if (*mb).allowlookaroundbsk == FALSE {\n158\t                return PCRE2_ERROR_BAD_BACKSLASH_K;\n159\t            }\n160\t        }\n161\t\n162\t        /* We have a successful match of the whole pattern. Record the result and\n163\t        then do a direct return from the function. If there is space in the offset\n164\t        vector, set any pairs that follow the highest-numbered captured string but\n165\t        are less than the number of capturing groups in the pattern to PCRE2_UNSET.\n166\t        It is documented that this happens. \"Gaps\" are set to PCRE2_UNSET\n167\t        dynamically. It is only those at the end that need setting here. */\n168\t\n169\t        (*mb).end_match_ptr = (*F).eptr; /* Record where we ended */\n170\t        (*mb).end_offset_top = (*F).offset_top; /* and how many extracts were taken */\n171\t        (*mb).mark = (*F).mark; /* and the last success mark */\n172\t        if (*F).eptr > (*mb).last_used_ptr {\n173\t            (*mb).last_used_ptr = (*F).eptr;\n174\t        }\n175\t\n176\t        let md_ovector: *mut PCRE2_SIZE =\n177\t            core::ptr::addr_of_mut!((*match_data).ovector) as *mut PCRE2_SIZE;\n178\t        *md_ovector.add(0) =\n179\t            (*F).start_match.offset_from((*mb).start_subject) as PCRE2_SIZE;\n180\t        *md_ovector.add(1) = (*F).eptr.offset_from((*mb).start_subject) as PCRE2_SIZE;\n181\t\n182\t        /* Set i to the smaller of the sizes of the external and frame ovectors. */\n183\t\n184\t        i = 2u32.wrapping_mul(\n185\t            if (top_bracket as c_int + 1) > (*match_data).oveccount as c_int {\n186\t                (*match_data).oveccount as u32\n187\t            } else {\n188\t                (top_bracket as u32).wrapping_add(1)\n189\t            },\n190\t        );\n191\t        memcpy(\n192\t            md_ovector.add(2) as *mut c_void,\n193\t            ovec(F) as *const c_void,\n194\t            (i as usize).wrapping_sub(2) * core::mem::size_of::<PCRE2_SIZE>(),\n195\t        );\n196\t        loop {\n197\t            i = i.wrapping_sub(1);\n198\t            if !((i as PCRE2_SIZE) >= (*F).offset_top + 2) {\n199\t                break;\n200\t            }\n201\t            *md_ovector.add(i as usize) = PCRE2_UNSET;\n202\t        }\n203\t        return MATCH_MATCH; /* Note: NOT RRETURN */\n204\t    }\n205\t\n206\t    /*===================================================================== */\n207\t    /* Match any single character type except newline; have to take care with\n208\t    CRLF newlines and partial matching. */\n209\t\n210\t    /* case OP_ANY: (C 1061) / case OP_ALLANY: (C 1076) */\n211\t    OP_ANY | OP_ALLANY => {\n212\t        if (*F).op as u32 == OP_ANY {\n213\t            /* IS_NEWLINE(Feptr) */\n214\t            let is_nl: bool = if (*mb).nltype != NLTYPE_FIXED {\n215\t                (*F).eptr < (*mb).end_subject\n216\t                    && crate::newline::_pcre2_is_newline_8(\n217\t                        (*F).eptr,\n218\t                        (*mb).nltype,\n219\t                        (*mb).end_subject,\n220\t                        &mut (*mb).nllen,\n221\t                        utf,\n222\t                    ) != FALSE\n223\t            } else {\n224\t                (*F).eptr <= (*mb).end_subject.wrapping_sub((*mb).nllen as usize)\n225\t                    && *(*F).eptr as u32 == (*mb).nl[0] as u32\n226\t                    && ((*mb).nllen == 1 || *(*F).eptr.add(1) as u32 == (*mb).nl[1] as u32)\n227\t            };\n228\t            if is_nl {\n229\t                rrc = MATCH_NOMATCH;\n230\t                lbl = LBL_RETURN_SWITCH;\n231\t                continue 'sw;\n232\t            }\n233\t            if (*mb).partial != 0\n234\t                && (*F).eptr == (*mb).end_subject.wrapping_sub(1)\n235\t                && (*mb).nltype == NLTYPE_FIXED\n236\t                && (*mb).nllen == 2\n237\t                && *(*F).eptr as u32 == (*mb).nl[0] as u32\n238\t            {\n239\t                (*mb).hitend = TRUE;\n240\t                if (*mb).partial > 1 {\n241\t                    return PCRE2_ERROR_PARTIAL;\n242\t                }\n243\t            }\n244\t        }\n245\t\n246\t        /* Match any single character whatsoever. */\n247\t\n248\t        if (*F).eptr >= (*mb).end_subject\n249\t        /* DO NOT merge the Feptr++ here; it must */\n250\t        {\n251\t            /* not be updated before SCHECK_PARTIAL. */\n252\t            /* SCHECK_PARTIAL() */\n253\t            if (*mb).partial != 0\n254\t                && ((*F).eptr > (*mb).start_used_ptr || (*mb).allowemptypartial != FALSE)\n255\t            {\n256\t                (*mb).hitend = TRUE;\n257\t                if (*mb).partial > 1 {\n258\t                    return PCRE2_ERROR_PARTIAL;\n259\t                }\n260\t            }\n261\t            rrc = MATCH_NOMATCH;\n262\t            lbl = LBL_RETURN_SWITCH;\n263\t            continue 'sw;\n264\t        }\n265\t        (*F).eptr = (*F).eptr.add(1);\n266\t        if utf != FALSE {\n267\t            /* ACROSSCHAR(Feptr < mb->end_subject, Feptr, Feptr++) */\n268\t            while (*F).eptr < (*mb).end_subject && (*(*F).eptr as u32 & 0xc0) == 0x80 {\n269\t                (*F).eptr = (*F).eptr.add(1);\n270\t            }\n271\t        }\n272\t        (*F).ecode = (*F).ecode.add(1);\n273\t        lbl = LBL_TOP_OF_LOOP;\n274\t        continue 'sw;\n275\t    }\n276\t\n277\t    /* ===================================================================== */\n278\t    /* Match a single code unit, even in UTF mode. This opcode really does\n279\t    match any code unit, even newline. (It really should be called ANYCODEUNIT,\n280\t    of course - the byte name is from pre-16 bit days.) */\n281\t\n282\t    /* case OP_ANYBYTE: (C 1095) */\n283\t    OP_ANYBYTE => {\n284\t        if (*F).eptr >= (*mb).end_subject\n285\t        /* DO NOT merge the Feptr++ here; it must */\n286\t        {\n287\t            /* not be updated before SCHECK_PARTIAL. */\n288\t            /* SCHECK_PARTIAL() */\n289\t            if (*mb).partial != 0\n290\t                && ((*F).eptr > (*mb).start_used_ptr || (*mb).allowemptypartial != FALSE)\n291\t            {\n292\t                (*mb).hitend = TRUE;\n293\t                if (*mb).partial > 1 {\n294\t                    return PCRE2_ERROR_PARTIAL;\n295\t                }\n296\t            }\n297\t            rrc = MATCH_NOMATCH;\n298\t            lbl = LBL_RETURN_SWITCH;\n299\t            continue 'sw;\n300\t        }\n301\t        (*F).eptr = (*F).eptr.add(1);\n302\t        (*F).ecode = (*F).ecode.add(1);\n303\t        lbl = LBL_TOP_OF_LOOP;\n304\t        continue 'sw;\n305\t    }\n306\t\n307\t    /* ===================================================================== */\n308\t    /* Match a single character, casefully */\n309\t\n310\t    /* case OP_CHAR: (C 1109) */\n311\t    OP_CHAR => {\n312\t        if utf != FALSE {\n313\t            length = 1;\n314\t            (*F).ecode = (*F).ecode.add(1);\n315\t            /* GETCHARLEN(fc, Fecode, length) */\n316\t            fc = *(*F).ecode as u32;\n317\t            if fc >= 0xc0 {\n318\t                length += utf8_extra(fc);\n319\t                fc = getutf8(fc, (*F).ecode);\n320\t            }\n321\t            if length > ((*mb).end_subject.offset_from((*F).eptr) as PCRE2_SIZE) {\n322\t                /* CHECK_PARTIAL() -- Not SCHECK_PARTIAL() */\n323\t                if (*F).eptr >= (*mb).end_subject {\n324\t                    if (*mb).partial != 0\n325\t                        && ((*F).eptr > (*mb).start_used_ptr\n326\t                            || (*mb).allowemptypartial != FALSE)\n327\t                    {\n328\t                        (*mb).hitend = TRUE;\n329\t                        if (*mb).partial > 1 {\n330\t                            return PCRE2_ERROR_PARTIAL;\n331\t                        }\n332\t                    }\n333\t                }\n334\t                rrc = MATCH_NOMATCH;\n335\t                lbl = LBL_RETURN_SWITCH;\n336\t                continue 'sw;\n337\t            }\n338\t            while length > 0 {\n339\t                let ec = *(*F).ecode;\n340\t                (*F).ecode = (*F).ecode.add(1);\n341\t                let sc = *(*F).eptr;\n342\t                (*F).eptr = (*F).eptr.add(1);\n343\t                if ec != sc {\n344\t                    rrc = MATCH_NOMATCH;\n345\t                    lbl = LBL_RETURN_SWITCH;\n346\t                    continue 'sw;\n347\t                }\n348\t                length -= 1;\n349\t            }\n350\t        } else {\n351\t            /* Not UTF mode */\n352\t            if (*mb).end_subject.offset_from((*F).eptr) < 1 {\n353\t                /* This one can use SCHECK_PARTIAL() */\n354\t                if (*mb).partial != 0\n355\t                    && ((*F).eptr > (*mb).start_used_ptr || (*mb).allowemptypartial != FALSE)\n356\t                {\n357\t                    (*mb).hitend = TRUE;\n358\t                    if (*mb).partial > 1 {\n359\t                        return PCRE2_ERROR_PARTIAL;\n360\t                    }\n361\t                }\n362\t                rrc = MATCH_NOMATCH;\n363\t                lbl = LBL_RETURN_SWITCH;\n364\t                continue 'sw;\n365\t            }\n366\t            let sc = *(*F).eptr;\n367\t            (*F).eptr = (*F).eptr.add(1);\n368\t            if *(*F).ecode.add(1) != sc {\n369\t                rrc = MATCH_NOMATCH;\n370\t                lbl = LBL_RETURN_SWITCH;\n371\t                continue 'sw;\n372\t            }\n373\t            (*F).ecode = (*F).ecode.add(2);\n374\t        }\n375\t        lbl = LBL_TOP_OF_LOOP;\n376\t        continue 'sw;\n377\t    }\n378\t\n379\t    /* ===================================================================== */\n380\t    /* Match a single character, caselessly. If we are at the end of the\n381\t    subject, give up immediately. We get here only when the pattern character\n382\t    has at most one other case. Characters with more than two cases are coded\n383\t    as OP_PROP with the pseudo-property PT_CLIST. */\n384\t\n385\t    /* case OP_CHARI: (C 1148) */\n386\t    OP_CHARI => {\n387\t        if (*F).eptr >= (*mb).end_subject {\n388\t            /* SCHECK_PARTIAL() */\n389\t            if (*mb).partial != 0\n390\t                && ((*F).eptr > (*mb).start_used_ptr || (*mb).allowemptypartial != FALSE)\n391\t            {\n392\t                (*mb).hitend = TRUE;\n393\t                if (*mb).partial > 1 {\n394\t                    return PCRE2_ERROR_PARTIAL;\n395\t                }\n396\t            }\n397\t            rrc = MATCH_NOMATCH;\n398\t            lbl = LBL_RETURN_SWITCH;\n399\t            continue 'sw;\n400\t        }\n401\t\n402\t        if utf != FALSE {\n403\t            length = 1;\n404\t            (*F).ecode = (*F).ecode.add(1);\n405\t            /* GETCHARLEN(fc, Fecode, length) */\n406\t            fc = *(*F).ecode as u32;\n407\t            if fc >= 0xc0 {\n408\t                length += utf8_extra(fc);\n409\t                fc = getutf8(fc, (*F).ecode);\n410\t            }\n411\t\n412\t            /* If the pattern character's value is < 128, we know that its other case\n413\t            (if any) is also < 128 (and therefore only one code unit long in all\n414\t            code-unit widths), so we can use the fast lookup table. We checked above\n415\t            that there is at least one character left in the subject. */\n416\t\n417\t            if fc < 128 {\n418\t                let cc: u32 = *(*F).eptr as u32;\n419\t                if *(*mb).lcc.add(fc as usize) as u32 != TABLE_GET(cc, (*mb).lcc, cc) {\n420\t                    rrc = MATCH_NOMATCH;\n421\t                    lbl = LBL_RETURN_SWITCH;\n422\t                    continue 'sw;\n423\t                }\n424\t                (*F).ecode = (*F).ecode.add(1);\n425\t                (*F).eptr = (*F).eptr.add(1);\n426\t            }\n427\t            /* Otherwise we must pick up the subject character and use Unicode\n428\t            property support to test its other case. Note that we cannot use the\n429\t            value of \"length\" to check for sufficient bytes left, because the other\n430\t            case of the character may have more or fewer code units. */\n431\t            else {\n432\t                /* GETCHARINC(dc, Feptr) */\n433\t                let mut dc: u32 = *(*F).eptr as u32;\n434\t                (*F).eptr = (*F).eptr.add(1);\n435\t                if dc >= 0xc0 {\n436\t                    let r = getutf8inc(dc, (*F).eptr);\n437\t                    dc = r.0;\n438\t                    (*F).eptr = r.1;\n439\t                }\n440\t                (*F).ecode = (*F).ecode.add(length);\n441\t                if dc != fc && dc != UCD_OTHERCASE(fc) {\n442\t                    rrc = MATCH_NOMATCH;\n443\t                    lbl = LBL_RETURN_SWITCH;\n444\t                    continue 'sw;\n445\t                }\n446\t            }\n447\t        }\n448\t        /* If UCP is set without UTF we must do the same as above, but with one\n449\t        character per code unit. */\n450\t        else if ucp != FALSE {\n451\t            let cc: u32 = *(*F).eptr as u32;\n452\t            fc = *(*F).ecode.add(1) as u32;\n453\t            if fc < 128 {\n454\t                if *(*mb).lcc.add(fc as usize) as u32 != TABLE_GET(cc, (*mb).lcc, cc) {\n455\t                    rrc = MATCH_NOMATCH;\n456\t                    lbl = LBL_RETURN_SWITCH;\n457\t                    continue 'sw;\n458\t                }\n459\t            } else {\n460\t                if cc != fc && cc != UCD_OTHERCASE(fc) {\n461\t                    rrc = MATCH_NOMATCH;\n462\t                    lbl = LBL_RETURN_SWITCH;\n463\t                    continue 'sw;\n464\t                }\n465\t            }\n466\t            (*F).eptr = (*F).eptr.add(1);\n467\t            (*F).ecode = (*F).ecode.add(2);\n468\t        }\n469\t        /* Not UTF or UCP mode; use the table for characters < 256. */\n470\t        else {\n471\t            if TABLE_GET(\n472\t                *(*F).ecode.add(1) as u32,\n473\t                (*mb).lcc,\n474\t                *(*F).ecode.add(1) as u32,\n475\t            ) != TABLE_GET(*(*F).eptr as u32, (*mb).lcc, *(*F).eptr as u32)\n476\t            {\n477\t                rrc = MATCH_NOMATCH;\n478\t                lbl = LBL_RETURN_SWITCH;\n479\t                continue 'sw;\n480\t            }\n481\t            (*F).eptr = (*F).eptr.add(1);\n482\t            (*F).ecode = (*F).ecode.add(2);\n483\t        }\n484\t        lbl = LBL_TOP_OF_LOOP;\n485\t        continue 'sw;\n486\t    }\n487\t\n488\t    /* ===================================================================== */\n489\t    /* Match not a single character. */\n490\t\n491\t    /* case OP_NOT: (C 1224) / case OP_NOTI: (C 1225) */\n492\t    OP_NOT | OP_NOTI => {\n493\t        if (*F).eptr >= (*mb).end_subject {\n494\t            /* SCHECK_PARTIAL() */\n495\t            if (*mb).partial != 0\n496\t                && ((*F).eptr > (*mb).start_used_ptr || (*mb).allowemptypartial != FALSE)\n497\t            {\n498\t                (*mb).hitend = TRUE;\n499\t                if (*mb).partial > 1 {\n500\t                    return PCRE2_ERROR_PARTIAL;\n501\t                }\n502\t            }\n503\t            rrc = MATCH_NOMATCH;\n504\t            lbl = LBL_RETURN_SWITCH;\n505\t            continue 'sw;\n506\t        }\n507\t\n508\t        if utf != FALSE {\n509\t            let mut ch: u32;\n510\t            (*F).ecode = (*F).ecode.add(1);\n511\t            /* GETCHARINC(ch, Fecode) */\n512\t            ch = *(*F).ecode as u32;\n513\t            (*F).ecode = (*F).ecode.add(1);\n514\t            if ch >= 0xc0 {\n515\t                let r = getutf8inc(ch, (*F).ecode);\n516\t                ch = r.0;\n517\t                (*F).ecode = r.1;\n518\t            }\n519\t            /* GETCHARINC(fc, Feptr) */\n520\t            fc = *(*F).eptr as u32;\n521\t            (*F).eptr = (*F).eptr.add(1);\n522\t            if fc >= 0xc0 {\n523\t                let r = getutf8inc(fc, (*F).eptr);\n524\t                fc = r.0;\n525\t                (*F).eptr = r.1;\n526\t            }\n527\t            if ch == fc {\n528\t                rrc = MATCH_NOMATCH; /* Caseful match */\n529\t                lbl = LBL_RETURN_SWITCH;\n530\t                continue 'sw;\n531\t            } else if (*F).op as u32 == OP_NOTI\n532\t            /* If caseless */\n533\t            {\n534\t                if ch > 127 {\n535\t                    ch = UCD_OTHERCASE(ch);\n536\t                } else {\n537\t                    ch = *(*mb).fcc.add(ch as usize) as u32;\n538\t                }\n539\t                if ch == fc {\n540\t                    rrc = MATCH_NOMATCH;\n541\t                    lbl = LBL_RETURN_SWITCH;\n542\t                    continue 'sw;\n543\t                }\n544\t            }\n545\t        }\n546\t        /* UCP without UTF is as above, but with one character per code unit. */\n547\t        else if ucp != FALSE {\n548\t            let mut ch: u32;\n549\t            fc = *(*F).eptr as u32;\n550\t            (*F).eptr = (*F).eptr.add(1);\n551\t            ch = *(*F).ecode.add(1) as u32;\n552\t            (*F).ecode = (*F).ecode.add(2);\n553\t\n554\t            if ch == fc {\n555\t                rrc = MATCH_NOMATCH; /* Caseful match */\n556\t                lbl = LBL_RETURN_SWITCH;\n557\t                continue 'sw;\n558\t            } else if (*F).op as u32 == OP_NOTI\n559\t            /* If caseless */\n560\t            {\n561\t                if ch > 127 {\n562\t                    ch = UCD_OTHERCASE(ch);\n563\t                } else {\n564\t                    ch = *(*mb).fcc.add(ch as usize) as u32;\n565\t                }\n566\t                if ch == fc {\n567\t                    rrc = MATCH_NOMATCH;\n568\t                    lbl = LBL_RETURN_SWITCH;\n569\t                    continue 'sw;\n570\t                }\n571\t            }\n572\t        }\n573\t        /* Neither UTF nor UCP is set */\n574\t        else {\n575\t            let ch: u32 = *(*F).ecode.add(1) as u32;\n576\t            fc = *(*F).eptr as u32;\n577\t            (*F).eptr = (*F).eptr.add(1);\n578\t            if ch == fc\n579\t                || ((*F).op as u32 == OP_NOTI && TABLE_GET(ch, (*mb).fcc, ch) == fc)\n580\t            {\n581\t                rrc = MATCH_N