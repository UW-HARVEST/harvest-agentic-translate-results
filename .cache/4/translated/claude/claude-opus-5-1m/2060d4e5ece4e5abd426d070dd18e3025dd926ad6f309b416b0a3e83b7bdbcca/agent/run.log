s. */\n729\t\n730\t        if length > 1 {\n731\t            let mut othercase: u32 = 0;\n732\t\n733\t            if (*F).op as u32 >= OP_STARI /* Caseless */\n734\t                && ({\n735\t                    othercase = UCD_OTHERCASE(fc);\n736\t                    othercase != fc\n737\t                })\n738\t            {\n739\t                (*F).byte2 = crate::ord2utf::_pcre2_ord2utf_8(\n740\t                    othercase,\n741\t                    core::ptr::addr_of_mut!((*F).fields.char_repeat.oc.occu) as *mut PCRE2_UCHAR,\n742\t                ) as u8;\n743\t            } else {\n744\t                (*F).byte2 = 0;\n745\t            }\n746\t\n747\t            i = 1;\n748\t            while i <= (*F).fields.char_repeat.min {\n749\t                if (*F).eptr <= (*mb).end_subject.wrapping_sub(length)\n750\t                    && memcmp(\n751\t                        (*F).eptr as *const c_void,\n752\t                        (*F).fields.char_repeat.charptr as *const c_void,\n753\t                        CU2BYTES(length),\n754\t                    ) == 0\n755\t                {\n756\t                    (*F).eptr = (*F).eptr.add(length);\n757\t                } else if (*F).byte2 > 0\n758\t                    && (*F).eptr <= (*mb).end_subject.wrapping_sub((*F).byte2 as usize)\n759\t                    && memcmp(\n760\t                        (*F).eptr as *const c_void,\n761\t                        core::ptr::addr_of!((*F).fields.char_repeat.oc.occu) as *const c_void,\n762\t                        CU2BYTES((*F).byte2 as usize),\n763\t                    ) == 0\n764\t                {\n765\t                    (*F).eptr = (*F).eptr.add((*F).byte2 as usize);\n766\t                } else {\n767\t                    /* CHECK_PARTIAL() */\n768\t                    if (*F).eptr >= (*mb).end_subject {\n769\t                        if (*mb).partial != 0\n770\t                            && ((*F).eptr > (*mb).start_used_ptr\n771\t                                || (*mb).allowemptypartial != FALSE)\n772\t                        {\n773\t                            (*mb).hitend = TRUE;\n774\t                            if (*mb).partial > 1 {\n775\t                                return PCRE2_ERROR_PARTIAL;\n776\t                            }\n777\t                        }\n778\t                    }\n779\t                    rrc = MATCH_NOMATCH;\n780\t                    lbl = LBL_RETURN_SWITCH;\n781\t                    continue 'sw;\n782\t                }\n783\t                i = i.wrapping_add(1);\n784\t            }\n785\t\n786\t            if (*F).fields.char_repeat.min == (*F).fields.char_repeat.max {\n787\t                lbl = LBL_TOP_OF_LOOP;\n788\t                continue 'sw;\n789\t            }\n790\t\n791\t            if reptype == REPTYPE_MIN {\n792\t                /* for (;;) { RMATCH(Fecode, RM202); ... } */\n793\t                start_ecode = (*F).ecode;\n794\t                (*F).return_id = RM202;\n795\t                lbl = LBL_MATCH_RECURSE;\n796\t                continue 'sw;\n797\t            } else\n798\t            /* Maximize */\n799\t            {\n800\t                (*F).fields.char_repeat.start_eptr = (*F).eptr;\n801\t                i = (*F).fields.char_repeat.min;\n802\t                while i < (*F).fields.char_repeat.max {\n803\t                    if (*F).eptr <= (*mb).end_subject.wrapping_sub((*F).byte1 as usize)\n804\t                        && memcmp(\n805\t                            (*F).eptr as *const c_void,\n806\t                            (*F).fields.char_repeat.charptr as *const c_void,\n807\t                            CU2BYTES((*F).byte1 as usize),\n808\t                        ) == 0\n809\t                    {\n810\t                        (*F).eptr = (*F).eptr.add((*F).byte1 as usize);\n811\t                    } else if (*F).byte2 > 0\n812\t                        && (*F).eptr <= (*mb).end_subject.wrapping_sub((*F).byte2 as usize)\n813\t                        && memcmp(\n814\t                            (*F).eptr as *const c_void,\n815\t                            core::ptr::addr_of!((*F).fields.char_repeat.oc.occu)\n816\t                                as *const c_void,\n817\t                            CU2BYTES((*F).byte2 as usize),\n818\t                        ) == 0\n819\t                    {\n820\t                        (*F).eptr = (*F).eptr.add((*F).byte2 as usize);\n821\t                    } else {\n822\t                        /* CHECK_PARTIAL() */\n823\t                        if (*F).eptr >= (*mb).end_subject {\n824\t                            if (*mb).partial != 0\n825\t                                && ((*F).eptr > (*mb).start_used_ptr\n826\t                                    || (*mb).allowemptypartial != FALSE)\n827\t                            {\n828\t                                (*mb).hitend = TRUE;\n829\t                                if (*mb).partial > 1 {\n830\t                                    return PCRE2_ERROR_PARTIAL;\n831\t                                }\n832\t                            }\n833\t                        }\n834\t                        break;\n835\t                    }\n836\t                    i = i.wrapping_add(1);\n837\t                }\n838\t\n839\t                /* After \\C in UTF mode, Lstart_eptr might be in the middle of a\n840\t                Unicode character. Use <= Lstart_eptr to ensure backtracking doesn't\n841\t                go too far. */\n842\t\n843\t                if reptype != REPTYPE_POS {\n844\t                    loop {\n845\t                        if (*F).eptr <= (*F).fields.char_repeat.start_eptr {\n846\t                            break;\n847\t                        }\n848\t                        start_ecode = (*F).ecode;\n849\t                        (*F).return_id = RM203;\n850\t                        lbl = LBL_MATCH_RECURSE;\n851\t                        continue 'sw;\n852\t                    }\n853\t                }\n854\t            }\n855\t            lbl = LBL_TOP_OF_LOOP; /* End of repeated wide character handling */\n856\t            continue 'sw;\n857\t        }\n858\t\n859\t        /* Length of UTF character is 1. Put it into the preserved variable and\n860\t        fall through to the non-UTF code. */\n861\t\n862\t        (*F).fields.char_repeat.c = fc;\n863\t    } else {\n864\t        /* When not in UTF mode, load a single-code-unit character. Then proceed as\n865\t        above, using Unicode casing if either UTF or UCP is set. */\n866\t\n867\t        (*F).fields.char_repeat.c = *(*F).ecode as u32;\n868\t        (*F).ecode = (*F).ecode.add(1);\n869\t    }\n870\t\n871\t    /* Caseless comparison */\n872\t\n873\t    if (*F).op as u32 >= OP_STARI {\n874\t        if ucp != FALSE && utf == FALSE && (*F).fields.char_repeat.c > 127 {\n875\t            (*F).fields.char_repeat.oc.oc = UCD_OTHERCASE((*F).fields.char_repeat.c);\n876\t        } else {\n877\t            /* Lc will be < 128 in UTF-8 mode. */\n878\t            (*F).fields.char_repeat.oc.oc =\n879\t                *(*mb).fcc.add((*F).fields.char_repeat.c as usize) as u32;\n880\t        }\n881\t\n882\t        i = 1;\n883\t        while i <= (*F).fields.char_repeat.min {\n884\t            let cc: u32; /* Faster than PCRE2_UCHAR */\n885\t            if (*F).eptr >= (*mb).end_subject {\n886\t                /* SCHECK_PARTIAL() */\n887\t                if (*mb).partial != 0\n888\t                    && ((*F).eptr > (*mb).start_used_ptr || (*mb).allowemptypartial != FALSE)\n889\t                {\n890\t                    (*mb).hitend = TRUE;\n891\t                    if (*mb).partial > 1 {\n892\t                        return PCRE2_ERROR_PARTIAL;\n893\t                    }\n894\t                }\n895\t                rrc = MATCH_NOMATCH;\n896\t                lbl = LBL_RETURN_SWITCH;\n897\t                continue 'sw;\n898\t            }\n899\t            cc = *(*F).eptr as u32;\n900\t            if (*F).fields.char_repeat.c != cc && (*F).fi