allout_ovector.add(1);\n186\t    rc = ((*mb).callout.unwrap())(cb, (*mb).callout_data);\n187\t    *callout_ovector.add(0) = save0;\n188\t    *callout_ovector.add(1) = save1;\n189\t    (*cb).callout_flags = 0;\n190\t    rc\n191\t}\n192\t\n193\t/*************************************************\n194\t*          Match a back-reference                *\n195\t*************************************************/\n196\t\n197\t/* This function is called only when it is known that the offset lies within\n198\tthe offsets that have so far been used in the match. Note that in caseless\n199\tUTF-8 mode, the number of subject bytes matched may be different to the number\n200\tof reference bytes.\n201\t\n202\tArguments:\n203\t  offset      index into the offset vector\n204\t  caseless    TRUE if caseless\n205\t  caseopts    bitmask of REFI_FLAG_XYZ values\n206\t  F           the current backtracking frame pointer\n207\t  mb          points to match block\n208\t  lengthptr   pointer for returning the length matched\n209\t\n210\tReturns:      = 0 sucessful match; number of code units matched is set\n211\t              < 0 no match\n212\t              > 0 partial match\n213\t*/\n214\t\n215\tpub(crate) unsafe fn match_ref(\n216\t    offset: PCRE2_SIZE,\n217\t    caseless: BOOL,\n218\t    caseopts: c_int,\n219\t    F: *mut heapframe,\n220\t    mb: *mut match_block,\n221\t    lengthptr: *mut PCRE2_SIZE,\n222\t) -> c_int {\n223\t    let mut p: PCRE2_SPTR;\n224\t    let mut length: PCRE2_SIZE;\n225\t    let mut eptr: PCRE2_SPTR;\n226\t    let eptr_start: PCRE2_SPTR;\n227\t\n228\t    /* Deal with an unset group. The default is no match, but there is an option to\n229\t    match an empty string. */\n230\t\n231\t    if offset >= (*F).offset_top || *ovec(F).add(offset) == PCRE2_UNSET {\n232\t        if ((*mb).poptions & PCRE2_MATCH_UNSET_BACKREF) != 0 {\n233\t            *lengthptr = 0;\n234\t            return 0; /* Match */\n235\t        } else {\n236\t            return -1; /* No match */\n