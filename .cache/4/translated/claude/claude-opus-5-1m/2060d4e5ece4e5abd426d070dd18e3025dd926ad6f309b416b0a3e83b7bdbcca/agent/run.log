b ignore_skip_arg: u32,\n1050\t    pub nltype: u32,\n1051\t    pub nllen: u32,\n1052\t    pub nl: [PCRE2_UCHAR; 4],\n1053\t    pub cb: *mut pcre2_callout_block,\n1054\t    pub callout_data: *mut c_void,\n1055\t    pub callout: CalloutFn,\n1056\t}\n1057\t\n1058\t#[repr(C)]\n1059\tpub struct dfa_match_block {\n1060\t    pub memctl: pcre2_memctl,\n1061\t    pub start_code: PCRE2_SPTR,\n1062\t    pub start_subject: PCRE2_SPTR,\n1063\t    pub end_subject: PCRE2_SPTR,\n1064\t    pub start_used_ptr: PCRE2_SPTR,\n1065\t    pub last_used_ptr: PCRE2_SPTR,\n1066\t    pub tables: *const u8,\n1067\t    pub start_offset: PCRE2_SIZE,\n1068\t    pub heap_limit: u32,\n1069\t    pub heap_used: PCRE2_SIZE,\n1070\t    pub match_limit: u32,\n1071\t    pub match_limit_depth: u32,\n1072\t    pub match_call_count: u32,\n1073\t    pub moptions: u32,\n1074\t    pub poptions: u32,\n1075\t    pub nltype: u32,\n1076\t    pub nllen: u32,\n1077\t    pub allowemptypartial: BOOL,\n1078\t    pub nl: [PCRE2_UCHAR; 4],\n1079\t    pub bsr_convention: u16,\n1080\t    pub cb: *mut pcre2_callout_block,\n1081\t    pub callout_data: *mut c_void,\n1082\t    pub callout: CalloutFn,\n1083\t    pub recursive: *mut dfa_recursion_info,\n1084\t}\n1085\t\n1086\t/* eclass_op_info from pcre2_compile.h */\n1087\t#[repr(C)]\n1088\t#[derive(Copy, Clone)]\n1089\tpub struct eclass_op_info {\n1090\t    pub code_start: *mut PCRE2_UCHAR,\n1091\t    pub length: PCRE2_SIZE,\n1092\t    pub op_single_type: u8,\n1093\t    pub bits: class_bits_storage,\n1094\t}\n1095\t\n1096\t/* ---------------- libc bindings (mirror the C code exactly) ---------------- */\n1097\t\n1098\textern \"C\" {\n1099\t    pub fn malloc(size: usize) -> *mut c_void;\n1100\t    pub fn free(ptr: *mut c_void);\n1101\t    pub fn memcpy(d: *mut c_void, s: *const c_void, n: usize) -> *mut c_void;\n1102\t    pub fn memmove(d: *mut c_void, s: *const c_void, n: usize) -> *mut c_void;\n1103\t    pub fn memset(d: *mut c_void, c: c_int, n: usize) -> *mut c_void;\n1104\t    pub fn memchr(s: *const c_void, c: c_int, n: usize) -> *mut c_void;\n1105\t    pub fn memcmp(a: *const c_void, b: *const c_void, n: usize) -> c_int;\n1106\t    pub fn strlen(s: *const c_char) -> usize;\n1107\t}\n1108\t\n1109\t/* ---------------- Helper wrapper for Sync statics ---------------- */\n1110\t\n1111\t#[repr(transparent)]\n1112\tpub struct SyncPtr(pub *const c_char);\n1113\tunsafe impl Sync for SyncPtr {}\n1114\t\n1115\t/* ---------------- UTF-8 / GET / PUT helpers ---------------- */\n1116\t\n1117\t#[inline(always)]\n1118\tpub unsafe fn GET(a: *const u8, n: usize) -> u32 {\n1119\t    ((*a.add(n) as u32) << 8) | (*a.add(n + 1) as u32)\n1120\t}\n1121\t\n1122\t#[inline(always)]\n1123\tpub unsafe fn PUT(a: *mut u8, n: usize, d: u32) {\n1124\t    *a.add(n) = (d >> 8) as u8;\n1125\t    *a.add(n + 1) = (d & 255) as u8;\n1126\t}\n1127\t\n1128\t#[inline(always)]\n1129\tpub unsafe fn GET2(a: *const u8, n: usize) -> u32 {\n1130\t    ((*a.add(n) as u32) << 8) | (*a.add(n + 1) as u32)\n1131\t}\n1132\t\n1133\t#[inline(always)]\n1134\tpub unsafe fn PUT2(a: *mut u8, n: usize, d: u32) {\n1135\t    *a.add(n) = (d >> 8) as u8;\n1136\t    *a.add(n + 1) = (d & 255) as u8;\n1137\t}\n1138\t\n1139\t#[inline(always)]\n1140\tpub fn CU2BYTES(x: usize) -> usize {\n1141\t    x\n1142\t}\n1143\t#[inline(always)]\n1144\tpub fn BYTES2CU(x: usize) -> usize {\n1145\t    x\n1146\t}\n1147\t\n1148\t#[inline(always)]\n1149\tpub fn HASUTF8EXTRALEN(c: u32) -> bool {\n1150\t    c >= 0xc0\n1151\t}\n1152\t#[inline(always)]\n1153\tpub fn HAS_EXTRALEN(c: u32) -> bool {\n1154\t    c >= 0xc0\n1155\t}\n1156\t#[inline(always)]\n1157\tpub fn NOT_FIRSTCU(c: u32) -> bool {\n1158\t    (c & 0xc0) == 0x80\n1159\t}\n1160\t#[inline(always)]\n1161\tpub fn GET_EXTRALEN(c: u32) -> u32 {\n1162\t    crate::tables::_pcre2_utf8_table4[(c & 0x3f) as usize] as u32\n1163\t}\n1164\t\n1165\t#[inline(always)]\n1166\tpub fn MAX_255(_c: u32) -> bool {\n1167\t    true\n1168\t}\n1169\t#[inline(always)]\n1170\tpub fn CHMAX_255(c: u32) -> bool {\n1171\t    c <= 255\n1172\t}\n1173\t#[inline(always)]\n1174\tpub unsafe fn TABLE_GET(c: u32, table: *const u8, _default: u32) -> u32 {\n1175\t    *table.add(c as usize) as u32\n1176\t}\n1177\t\n1178\t/* GETUTF8 family: returns the decoded char given first byte c and pointer eptr\n1179\t(pointing at the first byte). */\n1180\t#[inline(always)]\n1181\tpub unsafe fn getutf8(c: u32, eptr: PCRE2_SPTR) -> u32 {\n1182\t    if (c & 0x20) == 0 {\n1183\t        ((c & 0x1f) << 6) | (*eptr.add(1) as u32 & 0x3f)\n1184\t    } else if (c & 0x10) == 0 {\n1185\t        ((c & 0x0f) << 12) | ((*eptr.add(1) as u32 & 0x3f) << 6) | (*eptr.add(2) as u32 & 0x3f)\n1186\t    } else if (c & 0x08) == 0 {\n1187\t        ((c & 0x07) << 18)\n1188\t            | ((*eptr.add(1) as u32 & 0x3f) << 12)\n1189\t            | ((*eptr.add(2) as u32 & 0x3f) << 6)\n1190\t            | (*eptr.add(3) as u32 & 0x3f)\n1191\t    } else if (c & 0x04) == 0 {\n1192\t        ((c & 0x03) << 24)\n1193\t            | ((*eptr.add(1) as u32 & 0x3f) << 18)\n1194\t            | ((*eptr.add(2) as u32 & 0x3f) << 12)\n1195\t            | ((*eptr.add(3) as u32 & 0x3f) << 6)\n1196\t            | (*eptr.add(4) as u32 & 0x3f)\n1197\t    } else {\n1198\t        ((c & 0x01) << 30)\n1199\t            | ((*eptr.add(1) as u32 & 0x3f) << 24)\n1200\t            | ((*eptr.add(2) as u32 & 0x3f) << 18)\n1201\t            | ((*eptr.add(3) as u32 & 0x3f) << 12)\n1202\t            | ((*eptr.add(4) as u32 & 0x3f) << 6)\n1203\t            | (*eptr.add(5) as u32 & 0x3f)\n1204\t    }\n1205\t}\n1206\t\n1207\t/* Number of extra bytes consumed by getutf8 for a leading byte c. */\n1208\t#[inline(always)]\n1209\tpub fn utf8_extra(c: u32) -> usize {\n1210\t    if (c & 0x20) == 0 {\n1211\t        1\n1212\t    } else if (c & 0x10) == 0 {\n1213\t        2\n1214\t    } else if (c & 0x08) == 0 {\n1215\t        3\n1216\t    } else if (c & 0x04) == 0 {\n1217\t        4\n1218\t    } else {\n1219\t        5\n1220\t    }\n1221\t}\n1222\t\n1223\t/* GETUTF8INC: c is the already-consumed first byte, eptr points just past it.\n1224\tReturns (char, new_eptr). */\n1225\t#[inline(always)]\n1226\tpub unsafe fn getutf8inc(c: u32, eptr: PCRE2_SPTR) -> (u32, PCRE2_SPTR) {\n1227\t    if (c & 0x20) == 0 {\n1228\t        (((c & 0x1f) << 6) | (*eptr as u32 & 0x3f), eptr.add(1))\n1229\t    } else if (c & 0x10) == 0 {\n1230\t        (\n1231\t            ((c & 0x0f) << 12) | ((*eptr as u32 & 0x3f) << 6) | (*eptr.add(1) as u32 & 0x3f),\n1232\t            eptr.add(2),\n1233\t        )\n1234\t    } else if (c & 0x08) == 0 {\n1235\t        (\n1236\t            ((c & 0x07) << 18)\n1237\t                | ((*eptr as u32 & 0x3f) << 12)\n1238\t                | ((*eptr.add(1) as u32 & 0x3f) << 6)\n1239\t                | (*eptr.add(2) as u32 & 0x3f),\n1240\t            eptr.add(3),\n1241\t        )\n1242\t    } else if (c & 0x04) == 0 {\n1243\t        (\n1244\t            ((c & 0x03) << 24)\n1245\t                | ((*eptr as u32 & 0x3f) << 18)\n1246\t                | ((*eptr.add(1) as u32 & 0x3f) << 12)\n1247\t                | ((*eptr.add(2) as u32 & 0x3f) << 6)\n1248\t                | (*eptr.add(3) as u32 & 0x3f),\n1249\t            eptr.add(4),\n1250\t        )\n1251\t    } else {\n1252\t        (\n1253\t            ((c & 0x01) << 30)\n1254\t                | ((*eptr as u32 & 0x3f) << 24)\n1255\t                | ((*eptr.add(1) as u32 & 0x3f) << 18)\n1256\t                | ((*eptr.add(2) as u32 & 0x3f) << 12)\n1257\t                | ((*eptr.add(3) as u32 & 0x3f) << 6)\n1258\t                | (*eptr.add(4) as u32 & 0x3f),\n1259\t            eptr.add(5),\n1260\t        )\n1261\t    }\n1262\t}\n1263\t\n1264\t/* PUTCHAR */\n1265\t#[inline(always)]\n1266\tpub unsafe fn PUTCHAR(utf: bool, c: u32, p: *mut PCRE2_UCHAR) -> usize {\n1267\t    if utf && c > MAX_UTF_SINGLE_CU {\n1268\t        crate::ord2utf::_pcre2_ord2utf_8(c, p) as usize\n1269\t    } else {\n1270\t        *p = c as u8;\n1271\t        1\n1272\t    }\n1273\t}\n1274\t\n1275\t/* UCD access */\n1276\t#[inline(always)]\n1277\tpub fn GET_UCD(ch: u32) -> &'static ucd_record {\n1278\t    let idx = crate::ucd_data::_pcre2_ucd_stage2_8[(crate::ucd_data::_pcre2_ucd_stage1_8\n1279\t        [(ch as usize) / UCD_BLOCK_SIZE] as usize)\n1280\t        * UCD_BLOCK_SIZE\n1281\t        + (ch as usize) % UCD_BLOCK_SIZE] as usize;\n1282\t    &crate::ucd_data::_pcre2_ucd_records_8[idx]\n1283\t}\n1284\t\n1285\t#[inline(always)]\n1286\tpub fn UCD_SCRIPTX_PROP(p: &ucd_record) -> u32 {\n1287\t    (p.scriptx_bidiclass & UCD_SCRIPTX_MASK) as u32\n1288\t}\n1289\t#[inline(always)]\n1290\tpub fn UCD_BIDICLASS_PROP(p: &ucd_record) -> u32 {\n1291\t    (p.scriptx_bidiclass >> UCD_BIDICLASS_SHIFT) as u32\n1292\t}\n1293\t#[inline(always)]\n1294\tpub fn UCD_BPROPS_PROP(p: &ucd_record) -> u32 {\n1295\t    (p.bprops & UCD_BPROPS_MASK) as u32\n1296\t}\n1297\t#[inline(always)]\n1298\tpub fn UCD_CHARTYPE(ch: u32) -> u32 {\n1299\t    GET_UCD(ch).chartype as u32\n1300\t}\n1301\t#[inline(always)]\n1302\tpub fn UCD_SCRIPT(ch: u32) -> u32 {\n1303\t    GET_UCD(ch).script as u32\n1304\t}\n1305\t#[inline(always)]\n1306\tpub fn UCD_CATEGORY(ch: u32) -> u32 {\n1307\t    crate::tables::_pcre2_ucp_gentype_8[UCD_CHARTYPE(ch) as usize]\n1308\t}\n1309\t#[inline(always)]\n1310\tpub fn UCD_GRAPHBREAK(ch: u32) -> u32 {\n1311\t    GET_UCD(ch).gbprop as u32\n1312\t}\n1313\t#[inline(always)]\n1314\tpub fn UCD_CASESET(ch: u32) -> u32 {\n1315\t    GET_UCD(ch).caseset as u32\n1316\t}\n1317\t#[inline(always)]\n1318\tpub fn UCD_OTHERCASE(ch: u32) -> u32 {\n1319\t    ((ch as i32).wrapping_add(GET_UCD(ch).other_case)) as u32\n1320\t}\n1321\t#[inline(always)]\n1322\tpub fn UCD_SCRIPTX(ch: u32) -> u32 {\n1323\t    UCD_SCRIPTX_PROP(GET_UCD(ch))\n1324\t}\n1325\t#[inline(always)]\n1326\tpub fn UCD_BPROPS(ch: u32) -> u32 {\n1327\t    UCD_BPROPS_PROP(GET_UCD(ch))\n1328\t}\n1329\t#[inline(always)]\n1330\tpub fn UCD_BIDICLASS(ch: u32) -> u32 {\n1331\t    UCD_BIDICLASS_PROP(GET_UCD(ch))\n1332\t}\n1333\t#[inline(always)]\n1334\tpub fn UCD_ANY_I(ch: u32) -> bool {\n1335\t    (ch | 0x20) == 0x69 || (ch | 1) == 0x0131\n1336\t}\n1337\t#[inline(always)]\n1338\tpub fn UCD_DOTTED_I(ch: u32) -> bool {\n1339\t    ch == 0x69 || ch == 0x0130\n1340\t}\n1341\t#[inline(always)]\n1342\tpub fn UCD_FOLD_I_TURKISH(ch: u32) -> u32 {\n1343\t    if ch == 0x0130 {\n1344\t        0x69\n1345\t    } else if ch == 0x49 {\n1346\t        0x0131\n1347\t    } else {\n1348\t        ch\n1349\t    }\n1350\t}\n1351\t\n1352\t#[inline(always)]\n1353\tpub fn MAPBIT(map: &[u32], n: u32) -> u32 {\n1354\t    map[(n / 32) as usize] & (1u32 << (n % 32))\n1355\t}\n1356\t\n1357\t/* Slice-based accessor for script/boolprop sets which are indexed with an\n1358\toffset into the big global vectors. */\n1359\t#[inline(always)]\n1360\tpub fn script_set_bit(offset: usize, n: u32) -> bool {\n1361\t    let m = &crate::ucd_data::_pcre2_ucd_script_sets_8;\n1362\t    (m[offset + (n / 32) as usize] & (1u32 << (n % 32))) != 0\n1363\t}\n1364\t\n1365\t#[inline(always)]\n1366\tpub fn boolprop_set_bit(offset: usize, n: u32) -> bool {\n1367\t    let m = &crate::ucd_data::_pcre2_ucd_boolprop_sets_8;\n1368\t    (m[offset + (n / 32) as usize] & (1u32 << (n % 32))) != 0\n1369\t}\n1370\t\n1371\t#[inline(always)]\n1372\tpub unsafe fn SETBIT(a: *mut u8, b: u32) {\n1373\t    *a.add((b >> 3) as usize) |= 1u8 << (b & 0x7);\n1374\t}\n1375\t\n1376\t/* CLIST_ALIGN_TO */\n1377\t#[inline(always)]\n1378\tpub fn CLIST_ALIGN_TO(base: usize, align: usize) -> usize {\n1379\t    (base + (align - 1)) & !(align - 1)\n1380\t}\n1381\t"}]},"parent_tool_use_id":"toolu_bdrk_01HQgU2ZotDBWiJ2andUgkAj","session_id":"f5816e8b-06f7-42e5-8076-26746ab24d9f","uuid":"a4b1d51a-f72e-4d7d-9966-fa5f98962ea4","timestamp":"2026-08-22T15:38:18.675Z","subagent_type":"general-purpose","task_description":"Translate substring.c and pattern_info.c"}
