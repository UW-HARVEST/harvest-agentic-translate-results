(order) {\n        case 0: seq[0]=DESC; seq[1]=PAKT; break;\n        case 1: seq[0]=PAKT; seq[1]=DESC; break;\n        case 2: seq[0]=DESC; seq[1]=PAKT; break;\n        case 3: seq[0]=PAKT; seq[1]=DESC; break;\n        case 4: seq[0]=DESC; seq[1]=PAKT; break;\n        default: seq[0]=PAKT; seq[1]=DESC; break;\n    }\n    seq[2] = DATA;\n\n    // Optional leading filler chunk with a random payload size.\n    if (rnd() & 1) {\n        uint64_t fsz = rnd() % 40;\n        put_be32(buf + off, 0x66726565u); off += 4;   // 'free'\n        off += 4;                                      // padding\n        put_be64(buf + off, fsz); off += 8;\n        for (uint64_t i = 0; i < fsz; i++) buf[off + i] = (uint8_t)rnd();\n        off += fsz;\n    }\n\n    for (int s = 0; s < 3; s++) {\n        uint32_t t = seq[s];\n        if (t == DESC) {\n            put_be32(buf + off, t); off += 4;\n            off += 4;\n            // desc payload is 32 bytes, but the declared chunk size may be\n            // larger (extra trailing bytes) -- exercise both.\n            uint64_t extra = (rnd() % 3) * 8;\n            put_be64(buf + off, 32 + extra); off += 8;\n            // sample_rate: 8 fully random bytes to exercise the buggy\n            // double->u64 conversion across all its branches.\n            for (int i = 0; i < 8; i++) buf[off + i] = (uint8_t)rnd();\n            off += 8;\n            uint32_t fmt = 0x696d6134u;                      // 'ima4'\n            if (variant == 3) fmt = 0x696d6135u;             // bad format\n            put_be32(buf + off, fmt); off += 4;\n            put_be32(buf + off, (uint32_t)rnd()); off += 4;   // format_flags\n            put_be32(buf + off, (uint32_t)rnd()); off += 4;   // bytes_per_packet\n            put_be32(buf + off, (uint32_t)rnd()); off += 4;   // frames_per_packet\n            put_be32(buf + off, (uint32_t)rnd()); off += 4;   // channels_per_frame\n            put_be32(buf + off, (uint32_t)rnd()); off += 4;   // bits_per_channel\n      