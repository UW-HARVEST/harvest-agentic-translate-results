\nstatic void* (*f_hmget_key_ts)(void*,size_t,void*,size_t,ptrdiff_t*,int);\nstatic void* (*f_hmput_default)(void*,size_t);\nstatic void* (*f_hmput_key)(void*,size_t,void*,size_t,int);\nstatic void* (*f_hmdel_key)(void*,size_t,void*,size_t,size_t,int);\nstatic void* (*f_shmode_func)(size_t,int);\nstatic char* (*f_strkey)(int);\nstatic void  (*f_hm_geti)(int);\n\n/* ---------------- dumping helpers ---------------- */\n\nstatic void dump_table(idx_t *ix)\n{\n  if (!ix) { printf(\" table=NULL\"); return; }\n  printf(\" sc=%zu used=%zu uct=%zu ucst=%zu tomb=%zu tct=%zu seed=%zu log2=%zu\",\n      ix->slot_count, ix->used_count, ix->used_count_threshold,\n      ix->used_count_shrink_threshold, ix->tombstone_count,\n      ix->tombstone_count_threshold, ix->seed, ix->slot_count_log2);\n  printf(\" smode=%u sblk=%u srem=%zu align=%d\",\n      ix->string.mode, ix->string.block, ix->string.remaining,\n      (int)(((size_t)ix->storage % 64) == 0));\n  for (size_t s = 0; s < ix->slot_count; ++s) {\n    bucket_t *b = &ix->storage[s >> 3];\n    printf(\" [%zu:%zu/%td]\", s, b->hash[s & 7], b->index[s & 7]);\n  }\n}\n\n/* int-key map: struct { int key; int value; }, elemsize 8 */\nstatic void dump_imap(const char *tag, void *t)\n{\n  printf(\"%s:\", tag);\n  if (!t) { printf(\" NULL\\n\"); return; }\n  void *raw = (char*)t - 8;\n  hdr_t *h = HDR(raw);\n  printf(\" len=%zu cap=%zu temp=%td\", h->length, h->capacity, h->temp);\n  dump_table((idx_t*)h->hash_table);\n  for (size_t e = 0; e < h->length; ++e) {\n    int *ip = (int*)((char*)raw + 8*e);\n    printf(\" {%d,%d}\", ip[0], ip[1]);\n  }\n  printf(\"\\n\");\n}\n\n/* string-key map: struct { char *key; int value; }, elemsize 16 */\nstatic void dump_smap(const char *tag, void *t)\n{\n  printf(\"%s:\", tag);\n  if (!t) { printf(\" NULL\\n\"); return; }\n  void *raw = (char*)t - 16;\n  hdr_t *h = HDR(raw);\n  printf(\" len=%zu cap=%zu temp=%td\", h->length, h->capacity, h->temp);\n  idx_t *ix = (idx_t*)h->hash_table;\n  dump_table(ix);\n  if (ix) printf(\" tempkey=%s\", ix->temp_key ? ix->temp_key : \"(nil)\");\n  for (size_t e = 0; e < h->length; ++e) {\n    char **kp = (char**)((char*)raw + 16*e);\n    int v = *(int*)((char*)raw + 16*e + 8);\n    printf(\" {%s,%d}\", (e == 0 || *kp == NULL) ? \"(nil)\" : *kp, v);\n  }\n  printf(\"\\n\");\n}\n\nstatic void dump_arena(const char *tag, arena_t *a)\n{\n  size_t n = 0;\n  for (sb_t *x = a->storage; x; x = x->next) ++n;\n  printf(\"%s: blocks=%zu remaining=%zu block=%u mode=%u\\n\", tag, n, a->remaining, a->block, a->mode);\n}\n\n/* ---------------- macro emulation ---------------- */\n\nstatic ptrdiff_t itemp(void *t) { return HDR((char*)t - 8)->temp; }\nstatic ptrdiff_t stemp(void *t) { return HDR((char*)t - 16)->temp; }\n\nstatic void *imap_put(void *t, int k, int v)\n{\n  int kk = k;\n  t = f_hmput_key(t, 8, &kk, 4, HM_BINARY);\n  *(int*)((char*)t + 8*itemp(t))     = k;\n  *(int*)((char*)t + 8*itemp(t) + 4) = v;\n  return t;\n}\nstatic void *imap_geti(void *t, int k, ptrdiff_t *out)\n{\n  int kk = k;\n  t = f_hmget_key(t, 8, &kk, 4, HM_BINARY);\n  *out = itemp(t);\n  return t;\n}\nstatic void *imap_geti_ts(void *t, int k, ptrdiff_t *out)\n{\n  int kk = k;\n  t = f_hmget_key_ts(t, 8, &kk, 4, out, HM_BINARY);\n  return t;\n}\nstatic void *imap_del(void *t, int k, ptrdiff_t *out)\n{\n  int kk = k;\n  t = f_hmdel_key(t, 8, &kk, 4, 0, HM_BINARY);\n  *out = t ? itemp(t) : 0;\n  return t;\n}\n\nstatic void *smap_put(void *t, char *k, int v, int mode)\n{\n  t = f_hmput_key(t, 16, (void*)k, 8, mode);\n  *(int*)((char*)t + 16*stemp(t) + 8) = v;\n  return t;\n}\nstatic void *smap_geti(void *t, char *k, ptrdiff_t *out)\n{\n  t = f_hmget_key(t, 16, (void*)k, 8, HM_STRING);\n  *out = stemp(t);\n  return t;\n}\nstatic void *smap_del(void *t, char *k, ptrdiff_t *out)\n{\n  t = f_hmdel_key(t, 16, (void*)k, 8, 0, HM_STRING);\n  *out = t ? stemp(t) : 0;\n  return t;\n}\n\n/* ---------------- tests ---------------- */\n\nstatic void test_hashes(void)\n{\n  unsigned char buf[64];\n  printf(\"== hash_bytes ==\\n\");\n  for (int pat = 0; pat < 4; ++pat) {\n    for (int i = 0; i < 64; ++i) {\n      switch (pat) {\n        case 0: buf[i] = (unsigned char)i; break;\n        case 1: buf[i] = (unsigned char)(255 - i); break;\n        case 2: buf[i] = (unsigned char)(i * 37 + 129); break;\n        default: buf[i] = (unsigned char)(i & 1 ? 0xff : 0x00); break;\n      }\n    }\n    for (size_t len = 0; len <= 40; ++len) {\n      size_t seeds[4] = { 0, 1, 0x31415926u, (size_t)-1 };\n      for (int s = 0; s < 4; ++s)\n        printf(\"hb pat=%d len=%zu s=%d -> %zu\\n\", pat, len, s, f_hash_bytes(buf, len, seeds[s]));\n    }\n  }\n  printf(\"== hash_string ==\\n\");\n  const char *strs[] = { \"\", \"a\", \"ab\", \"abc\", \"test_0\", \"test_123456\",\n                         \"\\xff\\xfe\\x80 high\", \"the quick brown fox jumps over the lazy dog\",\n                         \"\\x01\\x02\\x03\\x04\\x05\\x06\\x07\\x08\\x09\" };\n  for (unsigned i = 0; i < sizeof(strs)/sizeof(strs[0]); ++i) {\n    size_t seeds[5] = { 0, 1, 0x31415926u, 0xdeadbeefcafe1234ull, (size_t)-1 };\n    for (int s = 0; s < 5; ++s)\n      printf(\"hs %u s=%d -> %zu\\n\", i, s, f_hash_string((char*)strs[i], seeds[s]));\n  }\n  printf(\"== hash_bytes of ints ==\\n\");\n  for (int v = -8; v <= 8; ++v) printf(\"hbi %d -> %zu\\n\", v, f_hash_bytes(&v, sizeof v, 7));\n  for (int k = 0; k < 24; ++k) {\n    long long lv = ((long long)k << 56) | (k * 0x0101010101010101ll);\n    printf(\"hbl %d -> %zu\\n\", k, f_hash_bytes(&lv, sizeof lv, 0));\n  }\n}\n\nstatic void test_arr(void)\n{\n  printf(\"== arrgrowf ==\\n\");\n  for (size_t elemsize = 1; elemsize <= 16; elemsize *= 2) {\n    void *a = NULL;\n    for (int step = 0; step < 12; ++step) {\n      a = f_arrgrowf(a, elemsize, (size_t)step, 0);\n      hdr_t *h = HDR(a);\n      printf(\"grow es=%zu step=%d len=%zu cap=%zu temp=%td ht=%d\\n\",\n             elemsize, step, h->length, h->capacity, h->temp, h->hash_table != NULL);\n      h->length += step;\n    }\n    f_arrfreef(a);\n  }\n  /* explicit min_cap requests */\n  void *a = NULL;\n  size_t caps[] = { 0, 1, 3, 4, 5, 8, 9, 100, 7, 512, 513 };\n  for (unsigned i = 0; i < sizeof(caps)/sizeof(caps[0]); ++i) {\n    a = f_arrgrowf(a, 4, 0, caps[i]);\n    printf(\"setcap %zu -> len=%zu cap=%zu\\n\", caps[i], HDR(a)->length, HDR(a)->capacity);\n  }\n  /* store and read back to prove the payload area is usable */\n  HDR(a)->length = 100;\n  int *ip = (int*)a;\n  for (int i = 0; i < 100; ++i) ip[i] = i * i - 7;\n  size_t sum = 0;\n  for (int i = 0; i < 100; ++i) sum += (size_t)ip[i];\n  printf(\"payload sum=%zu len=%zu cap=%zu\\n\", sum, HDR(a)->length, HDR(a)->capacity);\n  f_arrfreef(a);\n  /* addlen driven growth */\n  void *b = NULL;\n  size_t adds[] = { 1, 1, 2, 5, 1, 40, 3, 1000 };\n  for (unsigned i = 0; i < sizeof(adds)/sizeof(adds[0]); ++i) {\n    b = f_arrgrowf(b, 12, adds[i], 0);\n    HDR(b)->length += adds[i];\n    printf(\"addn %zu -> len=%zu cap=%zu\\n\", adds[i], HDR(b)->length, HDR(b)->capacity);\n  }\n  f_arrfreef(b);\n}\n\nstatic void test_imap(int n)\n{\n  printf(\"== imap n=%d ==\\n\", n);\n  void *t = NULL;\n  ptrdiff_t idx;\n  t = imap_geti(t, 5, &idx);\n  printf(\"miss idx=%td\\n\", idx);\n  dump_imap(\"after-miss\", t);\n  t = f_hmput_default(t, 8);\n  *(int*)((char*)t - 8 + 4) = -2;\n  dump_imap(\"after-default\", t);\n  for (int i = 0; i < n; ++i) {\n    t = imap_put(t, i * 3, i);\n    if (i < 6 || i % 17 == 0) dump_imap(\"put\", t);\n  }\n  dump_imap(\"after-puts\", t);\n  for (int i = -2; i < n + 2; ++i) {\n    t = imap_geti(t, i * 3, &idx);\n    ptrdiff_t idx2;\n    t = imap_geti_ts(t, i * 3, &idx2);\n    printf(\"get %d -> %td/%td val=%d\\n\", i * 3, idx, idx2,\n           *(int*)((char*)t + 8*idx + 4));\n  }\n  /* overwrite */\n  for (int i = 0; i < n; i += 2) t = imap_put(t, i * 3, 1000 + i);\n  dump_imap(\"after-overwrite\", t);\n  /* delete a third of them */\n  for (int i = 0; i < n; i += 3) {\n    t = imap_del(t, i * 3, &idx);\n    printf(\"del %d -> %td\\n\", i * 3, idx);\n    if (i < 9) dump_imap(\"del\", t);\n  }\n  dump_imap(\"after-dels\", t);\n  /* delete missing */\n  t = imap_del(t, 999999, &idx);\n  printf(\"del-missing -> %td\\n\", idx);\n  /* re-add */\n  for (int i = 0; i < n; ++i) t = imap_put(t, i * 3, i * 7);\n  dump_imap(\"after-readd\", t);\n  /* delete everything */\n  for (int i = n - 1; i >= 0; --i) t = imap_del(t, i * 3, &idx);\n  dump_imap(\"after-delall\", t);\n  f_hmfree_func((char*)t - 8, 8);\n  printf(\"freed\\n\");\n}\n\nstatic char keys[300][32];\n\nstatic void test_smap(int mode, int n)\n{\n  printf(\"== smap mode=%d n=%d ==\\n\", mode, n);\n  for (int i = 0; i < n && i < 300; ++i) sprintf(keys[i], \"key_%d_%s\", i, i & 1 ? \"odd\" : \"even\");\n  void *t = NULL;\n  ptrdiff_t idx;\n  if (mode == SH_ARENA || mode == SH_STRDUP) t = f_shmode_func(16, mode);\n  dump_smap(\"init\", t);\n  for (int i = 0; i < n; ++i) {\n    t = smap_put(t, keys[i], i * 11, HM_STRING);\n    if (i < 4) dump_smap(\"put\", t);\n  }\n  dump_smap(\"after-puts\", t);\n  for (int i = 0; i < n; ++i) {\n    t = smap_geti(t, keys[i], &idx);\n    printf(\"get %s -> %td val=%d key=%s\\n\", keys[i], idx,\n           *(int*)((char*)t + 16*idx + 8), *(char**)((char*)t + 16*idx));\n  }\n  t = smap_geti(t, \"no_such_key\", &idx);\n  printf(\"get-missing -> %td\\n\", idx);\n  ptrdiff_t tsidx;\n  t = f_hmget_key_ts(t, 16, (void*)keys[0], 8, &tsidx, HM_STRING);\n  printf(\"get_ts %s -> %td\\n\", keys[0], tsidx);\n  /* overwrite existing keys */\n  for (int i = 0; i < n; i += 2) t = smap_put(t, keys[i], -i, HM_STRING);\n  dump_smap(\"after-overwrite\", t);\n  for (int i = 0; i < n; i += 3) {\n    t = smap_del(t, keys[i], &idx);\n    printf(\"del %s -> %td\\n\", keys[i], idx);\n  }\n  dump_smap(\"after-dels\", t);\n  for (int i = 0; i < n; ++i) t = smap_put(t, keys[i], i, HM_STRING);\n  dump_smap(\"after-readd\", t);\n  f_hmfree_func((char*)t - 16, 16);\n  printf(\"freed\\n\");\n}\n\nstatic void test_arena(void)\n{\n  printf(\"== arena ==\\n\");\n  arena_t a;\n  memset(&a, 0, sizeof a);\n  char tmp[4096];\n  for (int i = 0; i < 60; ++i) {\n    size_t len = (size_t)(i * i * 3 + 1) % 3000 + 1;\n    memset(tmp, 'a' + (i % 26), len);\n    tmp[len] = 0;\n    char *p = f_stralloc(&a, tmp);\n    printf(\"alloc %d len=%zu ok=%d rem=%zu blk=%u atstart=%d\\n\", i, len,\n           strcmp(p, tmp) == 0, a.remaining, a.block,\n           (int)(p == (char*)a.storage->storage + a.remaining));\n  }\n  dump_arena(\"arena-before-reset\", &a);\n  f_strreset(&a);\n  dump_arena(\"arena-after-reset\", &a);\n  /* second round: force the huge-block path first */\n  memset(&a, 0, sizeof a);\n  memset(tmp, 'z', 2000); tmp[2000] = 0;\n  char *p = f_stralloc(&a, tmp);\n  printf(\"huge ok=%d rem=%zu blk=%u\\n\", strcmp(p, tmp) == 0, a.remaining, a.block);\n  for (int i = 0; i < 10; ++i) {\n    char s[64];\n    sprintf(s, \"small-%d\", i);\n    char *q = f_stralloc(&a, s);\n    printf(\"small %d ok=%d rem=%zu blk=%u\\n\", i, strcmp(q, s) == 0, a.remaining, a.block);\n  }\n  dump_arena(\"arena2\", &a);\n  f_strreset(&a);\n  dump_arena(\"arena2-after-reset\", &a);\n}\n\nstatic void test_seed_and_misc(void)\n{\n  printf(\"== strkey ==\\n\");\n  int vals[] = { 0, 1, -1, 7, 42, 12345, -98765, 2147483647, -2147483648 };\n  for (unsigned i = 0; i < sizeof(vals)/sizeof(vals[0]); ++i) {\n    char *p = f_strkey(vals[i]);\n    printf(\"strkey %d -> '%s' len=%zu\\n\", vals[i], p, strlen(p));\n  }\n  printf(\"== seed evolution ==\\n\");\n  for (int i = 0; i < 6; ++i) {\n    void *t = NULL;\n    int k = 1;\n    t = f_hmput_key(t, 8, &k, 4, HM_BINARY);\n    idx_t *ix = (idx_t*)HDR((char*)t - 8)->hash_table;\n    printf(\"table seed=%zu\\n\", ix->seed);\n    f_hmfree_func((char*)t - 8, 8);\n  }\n  printf(\"== rand_seed ==\\n\");\n  size_t seeds[] = { 0, 1, 12345, 0xffffffffffffffffull, 0x31415926u };\n  for (unsigned i = 0; i < sizeof(seeds)/sizeof(seeds[0]); ++i) {\n    f_rand_seed(seeds[i]);\n    void *t = NULL;\n    int k = 3;\n    t = f_hmput_key(t, 8, &k, 4, HM_BINARY);\n    idx_t *ix = (idx_t*)HDR((char*)t - 8)->hash_table;\n    printf(\"after rand_seed %zu table seed=%zu\\n\", seeds[i], ix->seed);\n    /* grow the table a few times so make_hash_index(ot) is exercised */\n    for (int j = 0; j < 40; ++j) t = imap_put(t, j, j);\n    dump_imap(\"seeded\", t);\n    f_hmfree_func((char*)t - 8, 8);\n  }\n  f_rand_seed(0x31415926u);\n  printf(\"== hmput_default ==\\n\");\n  void *t = NULL;\n  t = f_hmput_default(t, 8);\n  dump_imap(\"default1\", t);\n  t = f_hmput_default(t, 8);\n  dump_imap(\"default2\", t);\n  *(int*)((char*)t - 8 + 4) = 77;\n  ptrdiff_t idx;\n  t = imap_geti(t, 4, &idx);\n  printf(\"default get -> %td val=%d\\n\", idx, *(int*)((char*)t + 8*idx + 4));\n  f_hmfree_func((char*)t - 8, 8);\n  printf(\"== hmfree_func(NULL) ==\\n\");\n  f_hmfree_func(NULL, 8);\n  printf(\"== hmdel_key(NULL) ==\\n\");\n  int kk = 1;\n  printf(\"del null -> %d\\n\", f_hmdel_key(NULL, 8, &kk, 4, 0, HM_BINARY) == NULL);\n  printf(\"== hmget_key(NULL) ==\\n\");\n  void *g = f_hmget_key(NULL, 8, &kk, 4, HM_BINARY);\n  dump_imap(\"get-null\", g);\n  f_hmfree_func((char*)g - 8, 8);\n  printf(\"== shmode_func ==\\n\");\n  for (int m = 0; m <= 3; ++m) {\n    void *s = f_shmode_func(16, m);\n    dump_smap(\"shmode\", s);\n    f_hmfree_func((char*)s - 16, 16);\n  }\n}\n\nstatic void test_hm_geti(void)\n{\n  printf(\"== hm_geti ==\\n\");\n  int ns[] = { 0, 1, 2, 3, 4, 5, 8, 17, 64, 100, 257, 1000 };\n  for (unsigned i = 0; i < sizeof(ns)/sizeof(ns[0]); ++i) {\n    f_hm_geti(ns[i]);\n    printf(\"hm_geti(%d) ok\\n\", ns[i]);\n    /* observe the global seed after the run */\n    void *t = NULL;\n    int k = 1;\n    t = f_hmput_key(t, 8, &k, 4, HM_BINARY);\n    printf(\"  seed now %zu\\n\", ((idx_t*)HDR((char*)t - 8)->hash_table)->seed);\n    f_hmfree_func((char*)t - 8, 8);\n  }\n}\n\n#define SYM(v, n) do { *(void**)&v = dlsym(h, n); if (!v) { fprintf(stderr, \"missing %s\\n\", n); exit(1); } } while (0)\n\nint main(int argc, char **argv)\n{\n  if (argc < 2) { fprintf(stderr, \"usage: %s lib.so\\n\", argv[0]); return 2; }\n  void *h = dlopen(argv[1], RTLD_NOW);\n  if (!h) { fprintf(stderr, \"dlopen: %s\\n\", dlerror()); return 2; }\n  SYM(f_rand_seed, \"stbds_rand_seed\");\n  SYM(f_hash_bytes, \"stbds_hash_bytes\");\n  SYM(f_hash_string, \"stbds_hash_string\");\n  SYM(f_stralloc, \"stbds_stralloc\");\n  SYM(f_strreset, \"stbds_strreset\");\n  SYM(f_arrgrowf, \"stbds_arrgrowf\");\n  SYM(f_arrfreef, \"stbds_arrfreef\");\n  SYM(f_hmfree_func, \"stbds_hmfree_func\");\n  SYM(f_hmget_key, \"stbds_hmget_key\");\n  SYM(f_hmget_key_ts, \"stbds_hmget_key_ts\");\n  SYM(f_hmput_default, \"stbds_hmput_default\");\n  SYM(f_hmput_key, \"stbds_hmput_key\");\n  SYM(f_hmdel_key, \"stbds_hmdel_key\");\n  SYM(f_shmode_func, \"stbds_shmode_func\");\n  SYM(f_strkey, \"strkey\");\n  SYM(f_hm_geti, \"hm_geti\");\n\n  test_hashes();\n  test_arr();\n  test_imap(0);\n  test_imap(1);\n  test_imap(2);\n  test_imap(7);\n  test_imap(33);\n  test_imap(200);\n  test_smap(SH_DEFAULT, 1);\n  test_smap(SH_DEFAULT, 40);\n  test_smap(SH_STRDUP, 40);\n  test_smap(SH_ARENA, 40);\n  test_smap(SH_NONE, 12);\n  test_arena();\n  test_seed_and_misc();\n  test_hm_geti();\n  printf(\"DONE\\n\");\n  return 0;\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
