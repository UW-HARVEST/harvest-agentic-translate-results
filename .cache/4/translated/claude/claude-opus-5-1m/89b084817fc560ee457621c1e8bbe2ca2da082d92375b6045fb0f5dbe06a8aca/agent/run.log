or()); return 2; }\n  SYM(f_rand_seed, \"stbds_rand_seed\");\n  SYM(f_hash_bytes, \"stbds_hash_bytes\");\n  SYM(f_hash_string, \"stbds_hash_string\");\n  SYM(f_stralloc, \"stbds_stralloc\");\n  SYM(f_strreset, \"stbds_strreset\");\n  SYM(f_arrgrowf, \"stbds_arrgrowf\");\n  SYM(f_arrfreef, \"stbds_arrfreef\");\n  SYM(f_hmfree_func, \"stbds_hmfree_func\");\n  SYM(f_hmget_key, \"stbds_hmget_key\");\n  SYM(f_hmget_key_ts, \"stbds_hmget_key_ts\");\n  SYM(f_hmput_default, \"stbds_hmput_default\");\n  SYM(f_hmput_key, \"stbds_hmput_key\");\n  SYM(f_hmdel_key, \"stbds_hmdel_key\");\n  SYM(f_shmode_func, \"stbds_shmode_func\");\n  SYM(f_strkey, \"strkey\");\n  SYM(f_hm_geti, \"hm_geti\");\n\n  test_hashes();\n  test_arr();\n  test_imap(0);\n  test_imap(1);\n  test_imap(2);\n  test_imap(7);\n  test_imap(33);\n  test_imap(200);\n  test_smap(SH_DEFAULT, 1);\n  test_smap(SH_DEFAULT, 40);\n  test_smap(SH_STRDUP, 40);\n  test_smap(SH_ARENA, 40);\n  test_smap(SH_NONE, 12);\n  test_arena();\n  test_seed_and_misc();\n  test_hm_geti();\n  printf(\"DONE\\n\");\n  return 0;\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":666,"cache_read_input_tokens":89722,"cache_creation":{"ephemeral_5m_input_tokens":666,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"d5be6929-edc9-4fd0-8dec-bb397c393e02","uuid":"01471eb9-cd36-4444-8bdc-feaa883da977","timestamp":"2026-08-20T03:26:09.373Z"}
