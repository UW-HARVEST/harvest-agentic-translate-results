le_collide(%g,%g,%g)\",a,b,b);\n  }\n\n  /* dense sweep over the region containing all three fixed shapes */\n  for(int ix=-1200;ix<=400;ix+=7) for(int iy=-800;iy<=1400;iy+=11){\n    float x=ix*0.1f, y=iy*0.1f;\n    for(int ir=0; ir<=400; ir+=37){\n      float rr=ir*0.1f;\n      int e=c.circle_collide(x,y,rr), g=r.circle_collide(x,y,rr);\n      CK(e==g,\"circle_collide(%g,%g,%g): C=%d Rust=%d\",x,y,rr,e,g);\n    }\n  }\n\n  /* random fuzz incl. bit patterns */\n  srand(12345);\n  for(long k=0;k<400000;k++){\n    union{unsigned u;float f;} a,b,d;\n    a.u=((unsigned)rand()<<17)^(unsigned)rand(); b.u=((unsigned)rand()<<17)^(unsigned)rand(); d.u=((unsigned)rand()<<17)^(unsigned)rand();\n    if(k%2){ a.f=(rand()%40000-20000)/100.0f; b.f=(rand()%40000-20000)/100.0f; d.f=(rand()%8000)/100.0f; }\n    int e=c.circle_collide(a.f,b.f,d.f), g=r.circle_collide(a.f,b.f,d.f);\n    CK(e==g,\"fuzz circle_collide(%a,%a,%a): C=%d Rust=%d\",a.f,b.f,d.f,e,g);\n    c2v v1={a.f,b.f}, v2={d.f,a.f};\n    c2v p=c.c2Clampv(v1,v2,(c2v){b.f,d.f}), q=r.c2Clampv(v1,v2,(c2v){b.f,d.f});\n    CK(bits_eq(&p,&q,8),\"fuzz clampv\");\n    float f1=c.c2Dot(v1,v2), f2=r.c2Dot(v1,v2); CK(bits_eq(&f1,&f2,4),\"fuzz dot\");\n    c2Circle A={{a.f,b.f},d.f}; c2Capsule cap={{d.f,a.f},{b.f,d.f},a.f};\n    CK(c.c2CircletoCapsule(A,cap)==r.c2CircletoCapsule(A,cap),\"fuzz CtoCap\");\n    c2AABB bb={{a.f,b.f},{d.f,a.f}};\n    CK(c.c2CircletoAABB(A,bb)==r.c2CircletoAABB(A,bb),\"fuzz CtoAABB\");\n  }\n\n  printf(\"\\nchecks=%ld  mismatches=%ld  => %s\\n\", checks, fails, fails?\"FAIL\":\"PASS\");\n  return fails!=0;\n}\nEOF\ngcc -O1 -o diff_test diff_test.c -ldl -lm 2>&1|head -20 && ./diff_test ./cbuild/libc_src.so /local/home/scheschb/.harvest/work/harvest-translate-Jz5X1u/translated_rust/target/release/libtranslated_rust.so"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":517,"cache_read_input_tokens":22961,"cache_creation":{"ephemeral_5m_input_t