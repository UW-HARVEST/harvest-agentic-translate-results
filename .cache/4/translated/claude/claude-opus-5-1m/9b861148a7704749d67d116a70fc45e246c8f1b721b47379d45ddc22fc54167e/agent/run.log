t char *source);\nint js_dostring(js_State *J, const char *source);\njs_Panic js_atpanic(js_State *J, js_Panic panic);\nvoid js_report(js_State *J, const char *message);\nvoid js_setreport(js_State *J, js_Report report);\nvoid js_setcontext(js_State *J, void *uctx);\nvoid *js_getcontext(js_State *J);\njs_State *js_newstate(js_Alloc alloc, void *actx, int flags);\n```\n\nTranslation of the `js_try` idiom — read TRANSLATION_GUIDE.md carefully. Example\nfor `js_trystring`:\n```c\nconst char *js_trystring(js_State *J, int idx, const char *error) {\n    const char *s;\n    if (js_ptry(J)) { js_pop(J, 1); return error; }\n    if (js_try(J))  { js_pop(J, 1); return error; }\n    s = js_tostring(J, idx);\n    js_endtry(J);\n    return s;\n}\n```\nbecomes\n```rust\n#[unsafe(no_mangle)]\npub unsafe extern \"C-unwind\" fn js_trystring(J: *mut js_State, idx: c_int, error: *const c_char) -> *const c_char {\n    if js_ptry(J) != 0 { js_pop(J, 1); return error; }\n    match js_do_try(J, || { let s = js_tostring(J, idx); js_endtry(J); s }) {\n        None => { js_pop(J, 1); error }\n        Some(s) => s,\n    }\n}\n```\n\n`js_newstate` specifics:\n- FIRST statement of the function body must be `crate::jsi::install_panic_hook();`\n  (this is an addition required by the Rust exception emulation; put a comment\n  saying so). Then the rest exactly as in C.\n- drop the two `assert(...)` lines.\n- `J = alloc(actx, NULL, sizeof *J)` ->\n  `let J = (alloc.unwrap())(actx, null_mut(), core::mem::size_of::<js_State>() as c_int) as *mut js_State;`\n- `memset(J, 0, sizeof(*J))` -> `memset(J as *mut c_void, 0, core::mem::size_of::<js_State>());`\n- `J->stack = alloc(actx, NULL, JS_STACKSIZE * sizeof *J->stack)`; afterwards\n  add `memset((*J).stack as *mut c_void, 0, (JS_STACKSIZE as usize) * core::mem::size_of::<js_Value>());`\n  (harmless, avoids reading uninitialised bytes in Rust; add a short comment).\n- `if (js_try(J)) { js_freestate(J); return NULL; }` wraps the\n  `J->R = ...; J->G = ...