 c_char, b: *const c_char) -> c_int;\n60\t    pub fn strncmp(a: *const c_char, b: *const c_char, n: size_t) -> c_int;\n61\t    pub fn strcpy(d: *mut c_char, s: *const c_char) -> *mut c_char;\n62\t    pub fn strcat(d: *mut c_char, s: *const c_char) -> *mut c_char;\n63\t    pub fn strchr(s: *const c_char, c: c_int) -> *mut c_char;\n64\t    pub fn strrchr(s: *const c_char, c: c_int) -> *mut c_char;\n65\t    pub fn strstr(h: *const c_char, n: *const c_char) -> *mut c_char;\n66\t\n67\t    pub fn snprintf(s: *mut c_char, n: size_t, fmt: *const c_char, ...) -> c_int;\n68\t    pub fn sprintf(s: *mut c_char, fmt: *const c_char, ...) -> c_int;\n69\t    pub fn vsnprintf(s: *mut c_char, n: size_t, fmt: *const c_char, ap: *mut c_void) -> c_int;\n70\t    pub fn printf(fmt: *const c_char, ...) -> c_int;\n71\t    pub fn putchar(c: c_int) -> c_int;\n72\t    pub fn fputs(s: *const c_char, f: *mut c_void) -> c_int;\n73\t    pub fn fputc(c: c_int, f: *mut c_void) -> c_int;\n74\t    pub fn fflush(f: *mut c_void) -> c_int;\n75\t    pub fn sscanf(s: *const c_char, fmt: *const c_char, ...) -> c_int;\n76\t\n77\t    pub fn abort() -> !;\n78\t    pub fn exit(code: c_int) -> !;\n79\t    pub fn qsort(\n80\t        base: *mut c_void,\n81\t        n: size_t,\n82\t        w: size_t,\n83\t        cmp: Option<unsafe extern \"C\" fn(*const c_void, *const c_void) -> c_int>,\n84\t    );\n85\t\n86\t    pub fn time(t: *mut time_t) -> time_t;\n87\t    pub fn mktime(t: *mut tm) -> time_t;\n88\t    pub fn gmtime(t: *const time_t) -> *mut tm;\n89\t    pub fn localtime(t: *const time_t) -> *mut tm;\n90\t    pub fn gettimeofday(tv: *mut timeval, tz: *mut c_void) -> c_int;\n91\t\n92\t    pub fn pow(x: c_double, y: c_double) -> c_double;\n93\t    pub fn sqrt(x: c_double) -> c_double;\n94\t    pub fn exp(x: c_double) -> c_double;\n95\t    pub fn log(x: c_double) -> c_double;\n96\t    pub fn sin(x: c_double) -> c_double;\n97\t    pub fn cos(x: c_double) -> c_double;\n98\t    pub fn tan(x: c_double) -> c_double;\n99\t    pub fn asin(x: c_double) -> c_double;\n100\t    pub fn acos(x: c_double) -> c_double;\n101\t    pub fn atan(x: c_double) -> c_double;\n102\t    pub fn atan2(y: c_double, x: c_double) -> c_double;\n103\t    pub fn fabs(x: c_double) -> c_double;\n104\t    pub fn floor(x: c_double) -> c_double;\n105\t    pub fn ceil(x: c_double) -> c_double;\n106\t    pub fn fmod(x: c_double, y: c_double) -> c_double;\n107\t    pub fn ldexp(x: c_double, e: c_int) -> c_double;\n108\t    pub fn frexp(x: c_double, e: *mut c_int) -> c_double;\n109\t    pub fn strtod(s: *const c_char, e: *mut *mut c_char) -> c_double;\n110\t\n111\t    pub fn longjmp(env: *mut c_void, val: c_int) -> !;\n112\t\n113\t    pub static mut stdout: *mut c_void;\n114\t    pub static mut stderr: *mut c_void;\n115\t}\n116\t\n117\t/// C `isnan()`\n118\t#[inline]\n119\tpub fn isnan(x: f64) -> bool {\n120\t    x.is_nan()\n121\t}\n122\t\n123\t/// C `isinf()`\n124\t#[inline]\n125\tpub fn isinf(x: f64) -> bool {\n126\t    x.is_infinite()\n127\t}\n128\t\n129\t/// C `isfinite()`\n130\t#[inline]\n131\tpub fn isfinite(x: f64) -> bool {\n132\t    x.is_finite()\n133\t}\n134\t\n135\t/// C `signbit()`\n136\t#[inline]\n137\tpub fn signbit(x: f64) -> bool {\n138\t    x.is_sign_negative()\n139\t}\n140\t\n141\tpub const INFINITY: f64 = f64::INFINITY;\n142\tpub const NAN: f64 = f64::NAN;\n143\tpub const DBL_MAX: f64 = f64::MAX;\n144\tpub const DBL_MIN: f64 = f64::MIN_POSITIVE;\n145\tpub const DBL_EPSILON: f64 = f64::EPSILON;\n146\tpub const INT_MAX: c_int = c_int::MAX;\n147\tpub const INT_MIN: c_int = c_int::MIN;\n148\tpub const UINT_MAX: c_uint = c_uint::MAX;\n149\tpub const CHAR_BIT: c_int = 8;\n150\t"}]},"parent_tool_use_id":"toolu_bdrk_01HhG4RvGmnwJo3R4js8zLrw","session_id":"e867ece2-5670-426a-953e-de496239b763","uuid":"90844da6-80bd-4b6a-b571-f57fd6853f2d","timestamp":"2026-08-22T15:37:25.793Z","subagent_type":"general-purpose","task_description":"Translate jsregexp.c to Rust"}
