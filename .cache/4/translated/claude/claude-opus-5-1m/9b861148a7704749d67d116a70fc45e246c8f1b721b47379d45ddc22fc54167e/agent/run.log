g(J, \"pcall-ok\");\n\t}\n}\n\n/* C function that always throws */\nstatic void cf_throw(js_State *J) {\n\tjs_error(J, \"cf_throw always fails (%s)\", js_tostring(J, 1));\n}\n\n/* C function that re-enters JS which then calls back into C which throws */\nstatic void cf_deep(js_State *J) {\n\tprintf(\"cf_deep enter\\n\");\n\tjs_dostring(J, \"(function(){ cf_throw('from cf_deep') })()\");\n\tprintf(\"cf_deep exit\\n\");\n\tjs_pushundefined(J);\n}\n\nstatic void jsB_print(js_State *J) {\n\tint i, top = js_gettop(J);\n\tfor (i = 1; i < top; ++i) { if (i > 1) putchar(' '); fputs(js_tostring(J, i), stdout); }\n\tputchar('\\n');\n\tjs_pushundefined(J);\n}\n\nint main(void) {\n\tjs_State *J = js_newstate(NULL, NULL, 0);\n\tjs_setreport(J, rep);\n\n\tjs_newcfunction(J, jsB_print, \"print\", 1); js_setglobal(J, \"print\");\n\tjs_newcfunction(J, cf_run, \"cf_run\", 1); js_setglobal(J, \"cf_run\");\n\tjs_newcfunction(J, cf_guard, \"cf_guard\", 1); js_setglobal(J, \"cf_guard\");\n\tjs_newcfunction(J, cf_pcall, \"cf_pcall\", 1); js_setglobal(J, \"cf_pcall\");\n\tjs_newcfunction(J, cf_throw, \"cf_throw\", 1); js_setglobal(J, \"cf_throw\");\n\tjs_newcfunction(J, cf_deep, \"cf_deep\", 0); js_setglobal(J, \"cf_deep\");\n\n\tprintf(\"=== 1: host js_try around a throwing script\\n\");\n\tif (js_try(J)) {\n\t\tprintf(\"host caught: %s\\n\", js_trystring(J, -1, \"?\"));\n\t\tjs_pop(J, js_gettop(J));\n\t} else {\n\t\tjs_loadstring(J, \"[s]\", \"throw new RangeError('host-level')\");\n\t\tjs_pushundefined(J);\n\t\tjs_call(J, 0);\n\t\tjs_endtry(J);\n\t\tjs_pop(J, js_gettop(J));\n\t}\n\n\tprintf(\"=== 2: js_savetrypc / setjmp from host\\n\");\n\tif (my_trypc(J, NULL)) {\n\t\tprintf(\"trypc caught: %s\\n\", js_trystring(J, -1, \"?\"));\n\t\tjs_pop(J, js_gettop(J));\n\t} else {\n\t\tjs_loadstring(J, \"[s]\", \"cf_throw('via trypc')\");\n\t\tjs_pushundefined(J);\n\t\tjs_call(J, 0);\n\t\tjs_endtry(J);\n\t\tjs_pop(J, js_gettop(J));\n\t}\n\n\tprintf(\"=== 3: JS try around C callbacks\\n\");\n\tjs_