op(J, js_gettop(J));\n\t} else {\n\t\tjs_loadstring(J, \"[s]\", \"cf_throw('via trypc')\");\n\t\tjs_pushundefined(J);\n\t\tjs_call(J, 0);\n\t\tjs_endtry(J);\n\t\tjs_pop(J, js_gettop(J));\n\t}\n\n\tprintf(\"=== 3: JS try around C callbacks\\n\");\n\tjs_dostring(J, \"try { cf_throw('a') } catch (e) { print('js caught', e.name, e.message) }\");\n\tjs_dostring(J, \"print(cf_guard(function(){ throw new TypeError('inner-tc') }))\");\n\tjs_dostring(J, \"print(cf_guard(function(){ return 1 }))\");\n\tjs_dostring(J, \"print(cf_pcall(function(){ throw new Error('p') }))\");\n\tjs_dostring(J, \"print(cf_pcall(function(){ return 'v' }))\");\n\n\tprintf(\"=== 4: nested re-entrancy\\n\");\n\tjs_dostring(J, \"print(cf_run('print(\\\"nested script\\\"); 1+1'))\");\n\tjs_dostring(J, \"try { cf_deep() } catch (e) { print('deep caught', e.message) }\");\n\tjs_dostring(J, \"print(cf_run('try { cf_throw(\\\"deep2\\\") } catch (e) { print(\\\"inner js caught\\\", e.message) }'))\");\n\n\tprintf(\"=== 5: exception crossing many frames\\n\");\n\tjs_dostring(J,\n\t\t\"function l1(){ return l2() } function l2(){ return l3() }\"\n\t\t\"function l3(){ return [1].map(function(){ return cf_guard(function(){ cf_throw('x5') }) })[0] }\"\n\t\t\"print(l1())\");\n\tjs_dostring(J,\n\t\t\"function m1(){ try { return m2() } finally { print('m1 finally') } }\"\n\t\t\"function m2(){ return cf_run('throw new Error(\\\"m2\\\")') }\"\n\t\t\"try { print(m1()) } catch(e) { print('m caught', String(e)) }\");\n\n\tprintf(\"=== 6: host try nested inside JS execution via callback\\n\");\n\tjs_dostring(J, \"print(cf_guard(function(){ cf_guard(function(){ cf_throw('double') }); throw new Error('outer-after') }))\");\n\n\tprintf(\"=== 7: interleaving js_try depth\\n\");\n\t{\n\t\tint i;\n\t\tfor (i = 0; i < 70; ++i) {\n\t\t\tif (js_try(J)) {\n\t\t\t\tprintf(\"depth %d: caught %s\\n\", i, js_trystring(J, -1, \"?\"));\n\t\t\t\tjs_pop(J, js_gettop(J));\n\t\t\t\tbreak;\n\t\t\t}\n\t\t}\n\t\tprintf(\"after loop, trying to throw\\n\");\n\t\tif (js_try(J)) {\n\t\t\tprintf(\"final caught: %s\\n\", js_trystring(J, -1, \"?\"));\n\t\t\tjs_pop(J, js_gettop(J));\n\t\t} else {\n\t\t\tjs_dostring(J, \"throw new Error('final')\");\n\t\t\tjs_endtry(J);\n\t\t}\n\t}\n\tjs_pop(J, js_gettop(J));\n\n\tprintf(\"gettop %d\\n\", js_gettop(J));\n\tjs_gc(J, 1);\n\tjs_freestate(J);\n\tprintf(\"done\\n\");\n\treturn 0;\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
