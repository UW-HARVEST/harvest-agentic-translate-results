msgbuf.as_ptr());\n    crate::jserror::js_newsyntaxerror(J, buf.as_ptr());\n    crate::jsrun::js_throw(J)\n}\n```\nand for the many internal call sites use a macro (does the same thing but with\nsnprintf instead of vsnprintf):\n```rust\nmacro_rules! jsC_error {\n    ($J:expr, $node:expr, $fmt:expr $(, $a:expr)*) => {{\n        let mut buf = [0 as c_char; 512];\n        let mut msgbuf = [0 as c_char; 256];\n        snprintf(msgbuf.as_mut_ptr(), 256, $fmt $(, $a)*);\n        snprintf(buf.as_mut_ptr(), 256, c\"%s:%d: \".as_ptr(), (*$J).filename, (*$node).line);\n        strcat(buf.as_mut_ptr(), msgbuf.as_ptr());\n        crate::jserror::js_newsyntaxerror($J, buf.as_ptr());\n        crate::jsrun::js_throw($J)\n    }};\n}\n```\n\nAll the other functions in jscompile.c are `static` -> private Rust `unsafe fn`\nwith the same names. Translate ALL of them:\naddfunction, addjump, addlocal, breaktarget, cargs, carray, cassign,\ncassignforin, cassignop, cassignop1, cassignop2, cbinary, ccall, cdelete,\nceval, cexit, cfunbody, cfundecs, checkdup, checkfutureword, cobject,\ncontinuetarget, cparams, cstm, cstmlist, cswitch, ctrycatch, ctrycatchfinally,\nctryfinally, ctypeof, cunary, cvardecs, cvarinit, emit, emitarg, emitfunction,\nemitjump, emitjumpto, emitline, emitlocal, emitnumber, emitraw, emitstring,\nfindlocal, here, isfun, isloop, label, labeljumps, labelto, listlength,\nmatchlabel, newfun, returntarget.\nNOTE: `emit` etc. are fine as Rust names. `#define JF js_State *J, js_Function *F`\nexpands to two parameters `J: *mut js_State, F: *mut js_Function`.\n\nOther details:\n- `js_Function` fields in Rust: `name script lightweight strict arguments\n  numparams code codecap codelen funtab funcap funlen vartab varcap varlen\n  filename line lastline gcnext gcmark`.\n- `js_Instruction` is `c_ushort`. `emitraw` etc. do `F->code[F->codelen++] = value`\n  -> `*(*F).code.offset((*F).codelen as isize) = value as js_Instruction; (*F).codelen += 1;`\n- `memcpy(F->code + F->codelen, &nu