 lookup((*obj).properties, name);\n289\t        if (*J).strict != 0 && result.is_null() {\n290\t            js_typeerror!(J, c\"object is non-extensible\".as_ptr());\n291\t        }\n292\t        return result;\n293\t    }\n294\t\n295\t    (*obj).properties = insert(J, obj, (*obj).properties, name, &mut result);\n296\t\n297\t    result\n298\t}\n299\t\n300\t#[unsafe(no_mangle)]\n301\tpub unsafe extern \"C-unwind\" fn jsV_delproperty(\n302\t    J: *mut js_State,\n303\t    obj: *mut js_Object,\n304\t    name: *const c_char,\n305\t) {\n306\t    (*obj).properties = deleteproperty(J, obj, (*obj).properties, name);\n307\t}\n308\t\n309\t/* Flatten hierarchy of enumerable properties into an iterator object */\n310\t\n311\tunsafe fn itnewnode(\n312\t    J: *mut js_State,\n313\t    name: *const c_char,\n314\t    next: *mut js_Iterator,\n315\t) -> *mut js_Iterator {\n316\t    let n = strlen(name) as c_int + 1;\n317\t    let node = js_malloc(J, JS_ITERATOR_NAME_OFFSET as c_int + n) as *mut js_Iterator;\n318\t    (*node).next = next;\n319\t    memcpy(\n320\t        (*node).name.as_mut_ptr() as *mut c_void,\n321\t        name as *const c_void,\n322\t        n as size_t,\n323\t    );\n324\t    node\n325\t}\n326\t\n327\tunsafe fn itwalk(\n328\t    J: *mut js_State,\n329\t    mut iter: *mut js_Iterator,\n330\t    prop: *mut js_Property,\n331\t    seen: *mut js_Object,\n332\t) -> *mut js_Iterator {\n333\t    if (*prop).right != prop_sentinel() {\n334\t        iter = itwalk(J, iter, (*prop).right, seen);\n335\t    }\n336\t    if (*prop).atts & JS_DONTENUM == 0 {\n337\t        if seen.is_null() || jsV_getenumproperty(J, seen, (*prop).name.as_ptr()).is_null() {\n338\t            iter = itnewnode(J, (*prop).name.as_ptr(), iter);\n339\t        }\n340\t    }\n341\t    if (*prop).left != prop_sentinel() {\n342\t        iter = itwalk(J, iter, (*prop).left, seen);\n343\t    }\n344\t    iter\n345\t}\n346\t\n347\tunsafe fn itflatten(J: *mut js_State, obj: *mut js_Object) -> *mut js_Iterator {\n348\t    let mut iter: *mut js_Iterator = null_mut();\n349\t    if !(*obj).prototype.is_null() {\n350\t        iter = itflatten(J, (*obj).prototype);\n351\t    }\n352\t    if (*obj).properties != prop_sentinel() {\n353\t        iter = itwalk(J, iter, (*obj).properties, (*obj).prototype);\n354\t    }\n355\t    iter\n356\t}\n357\t\n358\t#[unsafe(no_mangle)]\n359\tpub unsafe extern \"C-unwind\" fn jsV_newiterator(\n360\t    J: *mut js_State,\n361\t    obj: *mut js_Object,\n362\t    own: c_int,\n363\t) -> *mut js_Object {\n364\t    let io = jsV_newobject(J, JS_CITERATOR, null_mut());\n365\t    (*io).u.iter.target = obj;\n366\t    (*io).u.iter.i = 0;\n367\t    (*io).u.iter.n = 0;\n368\t    if own != 0 {\n369\t        (*io).u.iter.head = null_mut();\n370\t        if (*obj).properties != prop_sentinel() {\n371\t            (*io).u.iter.head = itwalk(J, (*io).u.iter.head, (*obj).properties, null_mut());\n372\t        }\n373\t    } else {\n374\t        (*io).u.iter.head = itflatten(J, obj);\n375\t    }\n376\t    (*io).u.iter.current = (*io).u.iter.head;\n377\t\n378\t    if (*obj).type_ == JS_CSTRING {\n379\t        (*io).u.iter.n = (*obj).u.s.length;\n380\t    }\n381\t\n382\t    if (*obj).type_ == JS_CARRAY && (*obj).u.a.simple != 0 {\n383\t        (*io).u.iter.n = (*obj).u.a.flat_length;\n384\t    }\n385\t\n386\t    io\n387\t}\n388\t\n389\t#[unsafe(no_mangle)]\n390\tpub unsafe extern \"C-unwind\" fn jsV_nextiterator(\n391\t    J: *mut js_State,\n392\t    io: *mut js_Object,\n393\t) -> *const c_char {\n394\t    if (*io).type_ != JS_CITERATOR {\n395\t        js_typeerror!(J, c\"not an iterator\".as_ptr());\n396\t    }\n397\t    if (*io).u.iter.i < (*io).u.iter.n {\n398\t        js_itoa((*J).scratch.as_mut_ptr(), (*io).u.iter.i);\n399\t        (*io).u.iter.i += 1;\n400\t        return (*J).scratch.as_ptr();\n401\t    }\n402\t    while !(*io).u.iter.current.is_null() {\n403\t        let name: *const c_char = (*(*io).u.iter.current).name.as_ptr();\n404\t        (*io).u.iter.current = (*(*io).u.iter.current).next;\n405\t        if !jsV_getproperty(J, (*io).u.iter.target, name).is_null() {\n406\t            return name;\n407\t        }\n408\t    }\n409\t    null()\n410\t}\n411\t\n412\t/* Walk all the properties and delete them one by one for arrays */\n413\t\n414\t#[unsafe(no_mangle)]\n415\tpub unsafe extern \"C-unwind\" fn jsV_resizearray(\n416\t    J: *mut js_State,\n417\t    obj: *mut js_Object,\n418\t    newlen: c_int,\n419\t) {\n420\t    let mut buf = [0 as c_char; 32];\n421\t    let mut s: *const c_char;\n422\t    let mut k: c_int;\n423\t    if newlen < (*obj).u.a.length {\n424\t        if (*obj).u.a.length > (*obj).count * 2 {\n425\t            let it = jsV_newiterator(J, obj, 1);\n426\t            loop {\n427\t                s = jsV_nextiterator(J, it);\n428\t                if s.is_null() {\n429\t                    break;\n430\t                }\n431\t                k = jsV_numbertointeger(jsV_stringtonumber(J, s));\n432\t                if k >= newlen && streq(s, jsV_numbertostring(J, buf.as_mut_ptr(), k as f64)) {\n433\t                    jsV_delproperty(J, obj, s);\n434\t                }\n435\t            }\n436\t        } else {\n437\t            k = newlen;\n438\t            while k < (*obj).u.a.length {\n439\t                jsV_delproperty(J, obj, js_itoa(buf.as_mut_ptr(), k));\n440\t                k += 1;\n441\t            }\n442\t        }\n443\t    }\n444\t    (*obj).u.a.length = newlen;\n445\t}\n446\t"}]},"parent_tool_use_id":"toolu_bdrk_01VbyuowAoRtxSM5mXyeeAnh","session_id":"e867ece2-5670-426a-953e-de496239b763","uuid":"b43c9645-bcd4-4308-95a0-a06110db7150","timestamp":"2026-08-22T15:24:53.801Z","subagent_type":"general-purpose","task_description":"Translate jsobject.c to Rust"}
