5\tpub const OP_CATCH: c_int = 76;\n306\tpub const OP_ENDCATCH: c_int = 77;\n307\tpub const OP_WITH: c_int = 78;\n308\tpub const OP_ENDWITH: c_int = 79;\n309\tpub const OP_DEBUGGER: c_int = 80;\n310\tpub const OP_JUMP: c_int = 81;\n311\tpub const OP_JTRUE: c_int = 82;\n312\tpub const OP_JFALSE: c_int = 83;\n313\tpub const OP_RETURN: c_int = 84;\n314\t\n315\t// public enums from mujs.h\n316\tpub const JS_STRICT: c_int = 1;\n317\tpub const JS_REGEXP_G: c_int = 1;\n318\tpub const JS_REGEXP_I: c_int = 2;\n319\tpub const JS_REGEXP_M: c_int = 4;\n320\tpub const JS_READONLY: c_int = 1;\n321\tpub const JS_DONTENUM: c_int = 2;\n322\tpub const JS_DONTCONF: c_int = 4;\n323\tpub const JS_ISUNDEFINED: c_int = 0;\n324\tpub const JS_ISNULL: c_int = 1;\n325\tpub const JS_ISBOOLEAN: c_int = 2;\n326\tpub const JS_ISNUMBER: c_int = 3;\n327\tpub const JS_ISSTRING: c_int = 4;\n328\tpub const JS_ISFUNCTION: c_int = 5;\n329\tpub const JS_ISOBJECT: c_int = 6;\n330\t\n331\t/* ----------------------------------------------------------------- Rune */\n332\t\n333\tpub type Rune = c_int;\n334\tpub const UTFmax: usize = 4;\n335\tpub const Runesync: Rune = 0x80;\n336\tpub const Runeself: Rune = 0x80;\n337\tpub const Runeerror: Rune = 0xFFFD;\n338\tpub const Runemax: Rune = 0x10FFFF;\n339\t\n340\t/* --------------------------------------------------------------- values */\n341\t\n342\t/// `union js_Value` -- 16 bytes, type tag in the last byte so that it doubles\n343\t/// as the NUL terminator for short strings.\n344\t#[repr(C, align(8))]\n345\t#[derive(Copy, Clone)]\n346\tpub struct js_Value {\n347\t    pub b: [u8; 16],\n348\t}\n349\t\n350\timpl js_Value {\n351\t    #[inline]\n352\t    pub const fn zero() -> js_Value {\n353\t        js_Value { b: [0u8; 16] }\n354\t    }\n355\t    #[inline]\n356\t    pub const fn undef() -> js_Value {\n357\t        let mut v = js_Value { b: [0u8; 16] };\n358\t        v.b[15] = JS_TUNDEFINED as u8;\n359\t        v\n360\t    }\n361\t    /// `v->t.type`\n362\t    #[inline]\n363\t    pub fn ty(&self) -> u32 {\n364\t        self.b[15] as u32\n365\t    }\n366\t    #[inline]\n367\t    pub fn set_ty(&mut self, t: u32) {\n368\t        self.b[15] = t as u8;\n369\t    }\n370\t    /// `v->u.number`\n371\t    #[inline]\n372\t    pub fn num(&self) -> f64 {\n373\t        unsafe { *(self.b.as_ptr() as *const f64) }\n374\t    }\n375\t    #[inline]\n376\t    pub fn set_num(&mut self, x: f64) {\n377\t        unsafe { *(self.b.as_mut_ptr() as *mut f64) = x }\n378\t    }\n379\t    /// `v->u.boolean`\n380\t    #[inline]\n381\t    pub fn boolean(&self) -> c_int {\n382\t        unsafe { *(self.b.as_ptr() as *const c_int) }\n383\t    }\n384\t    #[inline]\n385\t    pub fn set_boolean(&mut self, x: c_int) {\n386\t        unsafe { *(self.b.as_mut_ptr() as *mut c_int) = x }\n387\t    }\n388\t    /// `v->u.litstr`\n389\t    #[inline]\n390\t    pub fn litstr(&self) -> *const c_char {\n391\t        unsafe { *(self.b.as_ptr() as *const *const c_char) }\n392\t    }\n393\t    #[inline]\n394\t    pub fn set_litstr(&mut self, x: *const c_char) {\n395\t        unsafe { *(self.b.as_mut_ptr() as *mut *const c_char) = x }\n396\t    }\n397\t    /// `v->u.memstr`\n398\t    #[inline]\n399\t    pub fn memstr(&self) -> *mut js_String {\n400\t        unsafe { *(self.b.as_ptr() as *const *mut js_String) }\n401\t    }\n402\t    #[inline]\n403\t    pub fn set_memstr(&mut self, x: *mut js_String) {\n404\t        unsafe { *(self.b.as_mut_ptr() as *mut *mut js_String) = x }\n405\t    }\n406\t    /// `v->u.object`\n407\t    #[inline]\n408\t    pub fn object(&self) -> *mut js_Object {\n409\t        unsafe { *(self.b.as_ptr() as *const *mut js_Object) }\n410\t    }\n411\t    #[inline]\n412\t    pub fn set_object(&mut self, x: *mut js_Object) {\n413\t        unsafe { *(self.b.as_mut_ptr() as *mut *mut js_Object) = x }\n414\t    }\n415\t    /// `v->u.shrstr`\n416\t    #[inline]\n417\t    pub fn shrstr(&self) -> *const c_char {\n418\t        self.b.as_ptr() as *const c_char\n419\t    }\n420\t    #[inline]\n421\t    pub fn shrstr_mut(&mut self) -> *mut c_char {\n422\t        self.b.as_mut_ptr() as *mut c_char\n423\t    }\n424\t}\n425\t\n426\t/// `v->t.type == JS_TSHRSTR || JS_TMEMSTR || JS_TLITSTR`\n427\t#[inline]\n428\tpub unsafe fn JSV_ISSTRING(v: *const js_Value) -> bool {\n429\t    let t = (*v).ty();\n430\t    t == JS_TSHRSTR || t == JS_TMEMSTR || t == JS_TLITSTR\n431\t}\n432\t\n433\t/// The `JSV_TOSTRING` macro from jsvalue.c\n434\t#[inline]\n435\tpub unsafe fn JSV_TOSTRING(v: *const js_Value) -> *const c_char {\n436\t    match (*v).ty() {\n437\t        JS_TSHRSTR => (*v).shrstr(),\n438\t        JS_TLITSTR => (*v).litstr(),\n439\t        JS_TMEMSTR => (*(*v).memstr()).p.as_ptr(),\n440\t        _ => EMPTY_STR.as_ptr(),\n441\t    }\n442\t}\n443\t\n444\tpub static EMPTY_STR: [c_char; 1] = [0];\n445\t\n446\t#[repr(C)]\n447\tpub struct js_String {\n448\t    pub gcnext: *mut js_String,\n449\t    pub gcmark: c_char,\n450\t    pub p: [c_char; 1],\n451\t}\n452\t\n453\tpub const JS_STRING_P_OFFSET: usize = core::mem::offset_of!(js_String, p);\n454\t\n455\t#[repr(C)]\n456\t#[derive(Copy, Clone)]\n457\tpub struct js_Regexp {\n458\t    pub prog: *mut c_void,\n459\t    pub source: *mut c_char,\n460\t    pub flags: c_ushort,\n461\t    pub last: c_ushort,\n462\t}\n463\t\n464\t#[repr(C)]\n465\t#[derive(Copy, Clone)]\n466\tpub struct js_ObjS {\n467\t    pub length: c_int,\n468\t    pub string: *mut c_char,\n469\t    pub shrstr: [c_char; 16],\n470\t}\n471\t\n472\t#[repr(C)]\n473\t#[derive(Copy, Clone)]\n474\tpub struct js_ObjA {\n475\t    pub length: c_int,\n476\t    pub simple: c_int,\n477\t    pub flat_length: c_int,\n478\t    pub flat_capacity: c_int,\n479\t    pub array: *mut js_Value,\n480\t}\n481\t\n482\t#[repr(C)]\n483\t#[derive(Copy, Clone)]\n484\tpub struct js_ObjF {\n485\t    pub function: *mut js_Function,\n486\t    pub scope: *mut js_Environment,\n487\t}\n488\t\n489\t#[repr(C)]\n490\t#[derive(Copy, Clone)]\n491\tpub struct js_ObjC {\n492\t    pub name: *const c_char,\n493\t    pub function: js_CFunction,\n494\t    pub constructor: js_CFunction,\n495\t    pub length: c_int,\n496\t    pub data: *mut c_void,\n497\t    pub finalize: js_Finalize,\n498\t}\n499\t\n500\t#[repr(C)]\n501\t#[derive(Copy, Clone)]\n502\tpub struct js_ObjIter {\n503\t    pub target: *mut js_Object,\n504\t    pub i: c_int,\n505\t    pub n: c_int,\n506\t    pub head: *mut js_Iterator,\n507\t    pub current: *mut js_Iterator,\n508\t}\n509\t\n510\t#[repr(C)]\n511\t#[derive(Copy, Clone)]\n512\tpub struct js_ObjUser {\n513\t    pub tag: *const c_char,\n514\t    pub data: *mut c_void,\n515\t    pub has: js_HasProperty,\n516\t    pub put: js_Put,\n517\t    pub delete: js_Delete,\n518\t    pub finalize: js_Finalize,\n519\t}\n520\t\n521\t#[repr(C)]\n522\tpub union js_ObjectU {\n523\t    pub boolean: c_int,\n524\t    pub number: f64,\n525\t    pub s: js_ObjS,\n526\t    pub a: js_ObjA,\n527\t    pub f: js_ObjF,\n528\t    pub c: js_ObjC,\n529\t    pub r: js_Regexp,\n530\t    pub iter: js_ObjIter,\n531\t    pub user: js_ObjUser,\n532\t}\n533\t\n534\t#[repr(C)]\n535\tpub struct js_Object {\n536\t    /// `enum js_Class type`\n537\t    pub type_: c_int,\n538\t    pub extensible: c_int,\n539\t    pub properties: *mut js_Property,\n540\t    pub count: c_int,\n541\t    pub prototype: *mut js_Object,\n542\t    pub u: js_ObjectU,\n543\t    pub gcnext: *mut js_Object,\n544\t    pub gcroot: *mut js_Object,\n545\t    pub gcmark: c_int,\n546\t}\n547\t\n548\t#[repr(C)]\n549\tpub struct js_Property {\n550\t    pub left: *mut js_Property,\n551\t    pub right: *mut js_Property,\n552\t    pub level: c_int,\n553\t    pub atts: c_int,\n554\t    pub value: js_Value,\n555\t    pub getter: *mut js_Object,\n556\t    pub setter: *mut js_Object,\n557\t    pub name: [c_char; 1],\n558\t}\n559\t\n560\tpub const JS_PROPERTY_NAME_OFFSET: usize = core::mem::offset_of!(js_Property, name);\n561\t\n562\t#[repr(C)]\n563\tpub struct js_Iterator {\n564\t    pub next: *mut js_Iterator,\n565\t    pub name: [c_char; 1],\n566\t}\n567\t\n568\tpub const JS_ITERATOR_NAME_OFFSET: usize = core::mem::offset_of!(js_Iterator, name);\n569\t\n570\t#[repr(C)]\n571\tpub struct js_Environment {\n572\t    pub outer: *mut js_Environment,\n573\t    pub variables: *mut js_Object,\n574\t    pub gcnext: *mut js_Environment,\n575\t    pub gcmark: c_int,\n576\t}\n577\t\n578\t#[repr(C)]\n579\tpub struct js_StringNode {\n580\t    pub left: *mut js_StringNode,\n581\t    pub right: *mut js_StringNode,\n582\t    pub level: c_int,\n583\t    pub string: [c_char; 1],\n584\t}\n585\t\n586\tpub const JS_STRINGNODE_STRING_OFFSET: usize = core::mem::offset_of!(js_StringNode, string);\n587\t\n588\t#[repr(C)]\n589\tpub struct js_StackTrace {\n590\t    pub name: *const c_char,\n591\t    pub file: *const c_char,\n592\t    pub line: c_int,\n593\t    pub stack: c_int,\n594\t}\n595\t\n596\t#[repr(C)]\n597\tpub struct js_Buffer {\n598\t    pub n: c_int,\n599\t    pub m: c_int,\n600\t    pub s: [c_char; 64],\n601\t}\n602\t\n603\tpub const JS_BUFFER_S_OFFSET: usize = core::mem::offset_of!(js_Buffer, s);\n604\t\n605\t#[repr(C)]\n606\tpub struct js_JumpList {\n607\t    pub type_: c_int,\n608\t    pub inst: c_int,\n609\t    pub next: *mut js_JumpList,\n610\t}\n611\t\n612\t#[repr(C)]\n613\tpub struct js_Ast {\n614\t    pub type_: c_int,\n615\t    pub line: c_int,\n616\t    pub parent: *mut js_Ast,\n617\t    pub a: *mut js_Ast,\n618\t    pub b: *mut js_Ast,\n619\t    pub c: *mut js_Ast,\n620\t    pub d: *mut js_Ast,\n621\t    pub number: f64,\n622\t    pub string: *const c_char,\n623\t    pub jumps: *mut js_JumpList,\n624\t    pub casejump: c_int,\n625\t    pub gcnext: *mut js_Ast,\n626\t}\n627\t\n628\t#[repr(C)]\n629\tpub struct js_Function {\n630\t    pub name: *const c_char,\n631\t    pub script: c_int,\n632\t    pub lightweight: c_int,\n633\t    pub strict: c_int,\n634\t    pub arguments: c_int,\n635\t    pub numparams: c_int,\n636\t\n637\t    pub code: *mut js_Instruction,\n638\t    pub codecap: c_int,\n639\t    pub codelen: c_int,\n640\t\n641\t    pub funtab: *mut *mut js_Function,\n642\t    pub funcap: c_int,\n643\t    pub funlen: c_int,\n644\t\n645\t    pub vartab: *mut *const c_char,\n646\t    pub varcap: c_int,\n647\t    pub varlen: c_int,\n648\t\n649\t    pub filename: *const c_char,\n650\t    pub line: c_int,\n651\t    pub lastline: c_int,\n652\t\n653\t    pub gcnext: *mut js_Function,\n654\t    pub gcmark: c_int,\n655\t}\n656\t\n657\t/* ------------------------------------------------- exception jump buffer */\n658\t\n659\t/// Kind of a try frame.\n660\tpub const TRY_EXTERNAL: c_int = 0; /* caller used setjmp() on `buf` */\n661\tpub const TRY_INTERNAL: c_int = 1; /* handled by Rust unwinding */\n662\t\n663\t#[repr(C)]\n664\tpub struct js_Jumpbuf {\n665\t    /// Storage for a `jmp_buf` (glibc needs 200 bytes; 256 is plenty).\n666\t    pub buf: [u64; 32],\n667\t    pub kind: c_int,\n668\t    pub owner: u64,\n669\t    pub E: *mut js_Environment,\n670\t    pub envtop: c_int,\n671\t    pub tracetop: c_int,\n672\t    pub top: c_int,\n673\t    pub bot: c_int,\n674\t    pub strict: c_int,\n675\t    pub pc: *mut js_Instruction,\n676\t}\n677\t\n678\t/* ---------------------------------------------------------- state struct */\n679\t\n680\t#[repr(C)]\n681\tpub struct js_LexBuf {\n682\t    pub text: *mut c_char,\n683\t    pub len: c_int,\n684\t    pub cap: c_int,\n685\t}\n686\t\n687\t#[repr(C)]\n688\tpub struct js_State {\n689\t    pub actx: *mut c_void,\n690\t    pub uctx: *mut c_void,\n691\t    pub alloc: js_Alloc,\n692\t    pub report: js_Report,\n693\t    pub panic: js_Panic,\n694\t\n695\t    pub strings: *mut js_StringNode,\n696\t\n697\t    pub default_strict: c_int,\n698\t    pub strict: c_int,\n699\t\n700\t    /* parser input source */\n701\t    pub filename: *const c_char,\n702\t    pub source: *const c_char,\n703\t    pub line: c_int,\n704\t\n705\t    /* lexer state */\n706\t    pub lexbuf: js_LexBuf,\n707\t    pub lexline: c_int,\n708\t    pub lexchar: c_int,\n709\t    pub lasttoken: c_int,\n710\t    pub newline: c_int,\n711\t\n712\t    /* parser state */\n713\t    pub astdepth: c_int,\n714\t    pub lookahead: c_int,\n715\t    pub text: *const c_char,\n716\t    pub number: f64,\n717\t    pub gcast: *mut js_Ast,\n718\t\n719\t    /* runtime environment */\n720\t    pub Object_prototype: *mut js_Object,\n721\t    pub Array_prototype: *mut js_Object,\n722\t    pub Function_prototype: *mut js_Object,\n723\t    pub Boolean_prototype: *mut js_Object,\n724\t    pub Number_prototype: *mut js_Object,\n725\t    pub String_prototype: *mut js_Object,\n726\t    pub RegExp_prototype: *mut js_Object,\n727\t    pub Date_prototype: *mut js_Object,\n728\t\n729\t    pub Error_prototype: *mut js_Object,\n730\t    pub EvalError_prototype: *mut js_Object,\n731\t    pub RangeError_prototype: *mut js_Object,\n732\t    pub ReferenceError_prototype: *mut js_Object,\n733\t    pub SyntaxError_prototype: *mut js_Object,\n734\t    pub TypeError_prototype: *mut js_Object,\n735\t    pub URIError_prototype: *mut js_Object,\n736\t\n737\t    pub seed: c_uint,\n738\t\n739\t    pub scratch: [c_char; 12],\n740\t\n741\t    pub nextref: c_int,\n742\t    pub R: *mut js_Object,\n743\t    pub G: *mut js_Object,\n744\t    pub E: *mut js_Environment,\n745\t    pub GE: *mut js_Environment,\n746\t\n747\t    /* execution stack */\n748\t    pub top: c_int,\n749\t    pub bot: c_int,\n750\t    pub stack: *mut js_Value,\n751\t\n752\t    /* garbage collector list */\n753\t    pub gcmark: c_int,\n754\t    pub gccounter: c_uint,\n755\t    pub gcthresh: c_uint,\n756\t    pub gcenv: *mut js_Environment,\n757\t    pub gcfun: *mut js_Function,\n758\t    pub gcobj: *mut js_Object,\n759\t    pub gcstr: *mut js_String,\n760\t\n761\t    pub gcroot: *mut js_Object,\n762\t\n763\t    pub runlimit: c_int,\n764\t    pub memlimit: c_int,\n765\t\n766\t    pub envtop: c_int,\n767\t    pub envstack: [*mut js_Environment; JS_ENVLIMIT],\n768\t\n769\t    pub tracetop: c_int,\n770\t    pub trace: [js_StackTrace; JS_ENVLIMIT],\n771\t\n772\t    pub trytop: c_int,\n773\t    pub trybuf: [js_Jumpbuf; JS_TRYLIMIT],\n774\t\n775\t    /* --- extra fields, not present in the C original --- */\n776\t    /// counter handing out unique ids to internal try frames\n777\t    pub try_id: u64,\n778\t}\n779\t\n780\t/* ------------------------------------------------- exception propagation */\n781\t\n782\t/// Payload of the Rust panic used to emulate `longjmp` for internal try frames.\n783\tpub struct JsThrow(pub u64);\n784\t\n785\t/// Silence the default panic message for our exception payloads.\n786\tpub fn install_panic_hook() {\n787\t    use std::sync::Once;\n788\t    static ONCE: Once = Once::new();\n789\t    ONCE.call_once(|| {\n790\t        let prev = std::panic::take_hook();\n791\t        std::panic::set_hook(Box::new(move |info| {\n792\t            if info.payload().downcast_ref::<JsThrow>().is_some() {\n793\t                return;\n794\t            }\n795\t            prev(info);\n796\t        }));\n797\t    });\n798\t}\n799\t\n800\t#[inline]\n801\tpub unsafe fn next_try_id(J: *mut js_State) -> u64 {\n802\t    (*J).try_id = (*J).try_id.wrapping_add(1);\n803\t    (*J).try_id\n804\t}\n805\t\n806\t/// Push an internal try frame; mirrors `js_savetry`/`js_savetrypc` but marks the\n807\t/// frame as being handled by Rust unwinding rather than `setjmp`.\n808\t#[inline]\n809\tpub unsafe fn js_pushtry_internal(J: *mut js_State, pc: *mut js_Instruction, owner: u64) {\n810\t    if (*J).trytop as usize == JS_TRYLIMIT {\n811\t        crate::jsrun::js_trystackoverflow(J);\n812\t    }\n813\t    let i = (*J).trytop as usize;\n814\t    let jb = &mut (*J).trybuf[i];\n815\t    jb.kind = TRY_INTERNAL;\n816\t    jb.owner = owner;\n817\t    jb.E = (*J).E;\n818\t    jb.envtop = (*J).envtop;\n819\t    jb.tracetop = (*J).tracetop;\n820\t    jb.top = (*J).top;\n821\t    jb.bot = (*J).bot;\n822\t    jb.strict = (*J).strict;\n823\t    jb.pc = pc;\n824\t    (*J).trytop += 1;\n825\t}\n826\t\n827\t/// Emulation of the C idiom\n828\t/// ```c\n829\t/// if (js_try(J)) { handler }\n830\t/// body\n831\t/// js_endtry(J);\n832\t/// ```\n833\t/// Returns `Some(value)` when `body` ran to completion and `None` when an\n834\t/// exception was thrown to this frame (i.e. the C code would have taken the\n835\t/// `if (js_try(J))` branch).\n836\t///\n837\t/// NOTE: as in C, `body` is responsible for calling `js_endtry(J)`.\n838\tpub unsafe fn js_do_try<T, F: FnOnce() -> T>(J: *mut js_State, body: F) -> Option<T> {\n839\t    let owner = next_try_id(J);\n840\t    js_pushtry_internal(J, null_mut(), owner);\n841\t    match std::panic::catch_unwind(std::panic::AssertUnwindSafe(body)) {\n842\t        Ok(v) => Some(v),\n843\t        Err(p) => match p.downcast::<JsThrow>() {\n844\t            Ok(b) => {\n845\t                if b.0 == owner {\n846\t                    None\n847\t                } else {\n848\t                    std::panic::resume_unwind(b)\n849\t                }\n850\t            }\n851\t            Err(p) => std::panic::resume_unwind(p),\n852\t        },\n853\t    }\n854\t}\n855\t\n856\t/* -------------------------------------------------------------- helpers */\n857\t\n858\t/// The shared AA-tree sentinel property node.\n859\tstatic mut PROP_SENTINEL: js_Property = js_Property {\n860\t    left: null_mut(),\n861\t    right: null_mut(),\n862\t    level: 0,\n863\t    atts: 0,\n864\t    value: js_Value::undef(),\n865\t    getter: null_mut(),\n866\t    setter: null_mut(),\n867\t    name: [0],\n868\t};\n869\t\n870\t#[inline]\n871\tpub unsafe fn prop_sentinel() -> *mut js_Property {\n872\t    let p = core::ptr::addr_of_mut!(PROP_SENTINEL);\n873\t    if (*p).left.is_null() {\n874\t        (*p).left = p;\n875\t        (*p).right = p;\n876\t    }\n877\t    p\n878\t}\n879\t\n880\t/// `!strcmp(a, b)`\n881\t#[inline]\n882\tpub unsafe fn streq(a: *const c_char, b: *const c_char) -> bool {\n883\t    strcmp(a, b) == 0\n884\t}\n885\t\n886\t#[inline]\n887\tpub fn cstr(s: &'static core::ffi::CStr) -> *const c_char {\n888\t    s.as_ptr()\n889\t}\n890\t\n891\t/// C's `(int)d` cast, reproducing what gcc emits on x86-64 (`cvttsd2si`):\n892\t/// out-of-range and NaN inputs yield `INT_MIN`.\n893\t#[inline]\n894\tpub fn cvt_i32(x: f64) -> c_int {\n895\t    if x.is_nan() || x >= 2147483648.0 || x < -2147483648.0 {\n896\t        c_int::MIN\n897\t    } else {\n898\t        x as c_int\n899\t    }\n900\t}\n901\t\n902\t/// C's `(long)d` / `(int64_t)d` cast as emitted by gcc on x86-64.\n903\t#[inline]\n904\tpub fn cvt_i64(x: f64) -> i64 {\n905\t    if x.is_nan() || x >= 9223372036854775808.0 || x < -9223372036854775808.0 {\n906\t        i64::MIN\n907\t    } else {\n908\t        x as i64\n909\t    }\n910\t}\n911\t\n912\t/// C's `(unsigned int)d` cast as emitted by gcc on x86-64.\n913\t#[inline]\n914\tpub fn cvt_u32(x: f64) -> c_uint {\n915\t    cvt_i64(x) as u64 as c_uint\n916\t}\n917\t\n918\t/// C's `(unsigned short)d` cast as emitted by gcc on x86-64.\n919\t#[inline]\n920\tpub fn cvt_u16(x: f64) -> c_ushort {\n921\t    cvt_i64(x) as u64 as c_ushort\n922\t}\n923\t"}]},"parent_tool_use_id":"toolu_bdrk_01U54pwUrfvwDtrkvnBUnMGM","session_id":"e867ece2-5670-426a-953e-de496239b763","uuid":"0862710f-88a8-4a54-b0e6-3e2eab260e5f","timestamp":"2026-08-22T15:09:28.303Z","subagent_type":"general-purpose","task_description":"Translate jsproperty.c to Rust"}
