   \"movaps %xmm3, -80(%rbp)\\n\",\n            \"movaps %xmm4, -64(%rbp)\\n\",\n            \"movaps %xmm5, -48(%rbp)\\n\",\n            \"movaps %xmm6, -32(%rbp)\\n\",\n            \"movaps %xmm7, -16(%rbp)\\n\",\n            \"9:\\n\",\n        )\n    };\n}\n\nmacro_rules! trampoline_valist {\n    ($gp:literal) => {\n        concat!(\n            /* the va_list itself lives at -208(%rbp) */\n            \"movl $\", $gp, \", -208(%rbp)\\n\",\n            \"movl $48, -204(%rbp)\\n\",\n            \"leaq 16(%rbp), %rax\\n\",\n            \"movq %rax, -200(%rbp)\\n\",\n            \"leaq -176(%rbp), %rax\\n\",\n            \"movq %rax, -192(%rbp)\\n\",\n        )\n    };\n}\n\nmacro_rules! vararg2 {\n    ($name:ident, $target:literal) => {\n        #[unsafe(naked)]\n        #[unsafe(no_mangle)]\n        pub unsafe extern \"C-unwind\" fn $name(_J: *mut js_State, _fmt: *const c_char) -> ! {\n            core::arch::naked_asm!(\n                concat!(\n                    \"pushq %rbp\\n\",\n                    trampoline_body!(),\n                    trampoline_valist!(\"16\"),\n                    \"movq -176(%rbp), %rdi\\n\",\n                    \"movq -168(%rbp), %rsi\\n\",\n                    \"leaq -208(%rbp), %rdx\\n\",\n                    \"call \", $target, \"@PLT\\n\",\n                    \"leave\\n\",\n                    \"ret\\n\",\n                ),\n                options(att_syntax)\n            )\n        }\n    };\n}\n\nmacro_rules! vararg3 {\n    ($name:ident, $target:literal) => {\n        #[unsafe(naked)]\n        #[unsafe(no_mangle)]\n        pub unsafe extern \"C-unwind\" fn $name(\n            _J: *mut js_State,\n            _node: *mut js_Ast,\n            _fmt: *const c_char,\n        ) -> ! {\n            core::arch::naked_asm!(\n                concat!(\n                    \"pushq %rbp\\n\",\n                    trampoline_body!(),\n                    trampoline_valist!(\"24\"),\n                    \"movq -176(%rbp), %rdi\\n\",\n  