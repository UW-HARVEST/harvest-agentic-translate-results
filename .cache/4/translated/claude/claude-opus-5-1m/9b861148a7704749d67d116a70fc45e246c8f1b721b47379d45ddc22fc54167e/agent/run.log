tpub unsafe extern \"C-unwind\" fn js_isnumber(J: *mut js_State, idx: c_int) -> c_int {\n294\t    ((*stackidx(J, idx)).ty() == JS_TNUMBER) as c_int\n295\t}\n296\t#[unsafe(no_mangle)]\n297\tpub unsafe extern \"C-unwind\" fn js_isstring(J: *mut js_State, idx: c_int) -> c_int {\n298\t    let t = (*stackidx(J, idx)).ty();\n299\t    (t == JS_TSHRSTR || t == JS_TLITSTR || t == JS_TMEMSTR) as c_int\n300\t}\n301\t#[unsafe(no_mangle)]\n302\tpub unsafe extern \"C-unwind\" fn js_isprimitive(J: *mut js_State, idx: c_int) -> c_int {\n303\t    ((*stackidx(J, idx)).ty() != JS_TOBJECT) as c_int\n304\t}\n305\t#[unsafe(no_mangle)]\n306\tpub unsafe extern \"C-unwind\" fn js_isobject(J: *mut js_State, idx: c_int) -> c_int {\n307\t    ((*stackidx(J, idx)).ty() == JS_TOBJECT) as c_int\n308\t}\n309\t#[unsafe(no_mangle)]\n310\tpub unsafe extern \"C-unwind\" fn js_iscoercible(J: *mut js_State, idx: c_int) -> c_int {\n311\t    let v = stackidx(J, idx);\n312\t    ((*v).ty() != JS_TUNDEFINED && (*v).ty() != JS_TNULL) as c_int\n313\t}\n314\t\n315\t#[unsafe(no_mangle)]\n316\tpub unsafe extern \"C-unwind\" fn js_iscallable(J: *mut js_State, idx: c_int) -> c_int {\n317\t    let v = stackidx(J, idx);\n318\t    if (*v).ty() == JS_TOBJECT {\n319\t        let t = (*(*v).object()).type_;\n320\t        return (t == JS_CFUNCTION || t == JS_CSCRIPT || t == JS_CCFUNCTION) as c_int;\n321\t    }\n322\t    0\n323\t}\n324\t\n325\t#[unsafe(no_mangle)]\n326\tpub unsafe extern \"C-unwind\" fn js_isarray(J: *mut js_State, idx: c_int) -> c_int {\n327\t    let v = stackidx(J, idx);\n328\t    ((*v).ty() == JS_TOBJECT && (*(*v).object()).type_ == JS_CARRAY) as c_int\n329\t}\n330\t\n331\t#[unsafe(no_mangle)]\n332\tpub unsafe extern \"C-unwind\" fn js_isregexp(J: *mut js_State, idx: c_int) -> c_int {\n333\t    let v = stackidx(J, idx);\n334\t    ((*v).ty() == JS_TOBJECT && (*(*v).object()).type_ == JS_CREGEXP) as c_int\n335\t}\n336\t\n337\t#[unsafe(no_mangle)]\n338\tpub unsafe extern \"C-unwind\" fn js_isuserdata(\n339\t    J: *mut js_State,\n340\t    idx: c_int,\n341\t    tag: *const c_char,\n342\t) -> c_int {\n343\t    let v = stackidx(J, idx);\n344\t    if (*v).ty() == JS_TOBJECT && (*(*v).object()).type_ == JS_CUSERDATA {\n345\t        return (strcmp(tag, (*(*v).object()).u.user.tag) == 0) as c_int;\n346\t    }\n347\t    0\n348\t}\n349\t\n350\t#[unsafe(no_mangle)]\n351\tpub unsafe extern \"C-unwind\" fn js_iserror(J: *mut js_State, idx: c_int) -> c_int {\n352\t    let v = stackidx(J, idx);\n353\t    ((*v).ty() == JS_TOBJECT && (*(*v).object()).type_ == JS_CERROR) as c_int\n354\t}\n355\t\n356\t#[unsafe(no_mangle)]\n357\tpub unsafe extern \"C-unwind\" fn js_typeof(J: *mut js_State, idx: c_int) -> *const c_char {\n358\t    let v = stackidx(J, idx);\n359\t    match (*v).ty() {\n360\t        JS_TUNDEFINED => c\"undefined\".as_ptr(),\n361\t        JS_TNULL => c\"object\".as_ptr(),\n362\t        JS_TBOOLEAN => c\"boolean\".as_ptr(),\n363\t        JS_TNUMBER => c\"number\".as_ptr(),\n364\t        JS_TLITSTR => c\"string\".as_ptr(),\n365\t        JS_TMEMSTR => c\"string\".as_ptr(),\n366\t        JS_TOBJECT => {\n367\t            let t = (*(*v).object()).type_;\n368\t            if t == JS_CFUNCTION || t == JS_CCFUNCTION {\n369\t                c\"function\".as_ptr()\n370\t            } else {\n371\t                c\"object\".as_ptr()\n372\t            }\n373\t        }\n374\t        /* JS_TSHRSTR and default */\n375\t        _ => c\"string\".as_ptr(),\n376\t    }\n377\t}\n378\t\n379\t#[unsafe(no_mangle)]\n380\tpub unsafe extern \"C-unwind\" fn js_type(J: *mut js_State, idx: c_int) -> c_int {\n381\t    let v = stackidx(J, idx);\n382\t    match (*v).ty() {\n383\t        JS_TUNDEFINED => JS_ISUNDEFINED,\n384\t        JS_TNULL => JS_ISNULL,\n385\t        JS_TBOOLEAN => JS_ISBOOLEAN,\n386\t        JS_TNUMBER => JS_ISNUMBER,\n387\t        JS_TLITSTR => JS_ISSTRING,\n388\t        JS_TMEMSTR => JS_ISSTRING,\n389\t        JS_TOBJECT => {\n390\t            let t = (*(*v).object()).type_;\n391\t            if t == JS_CFUNCTION || t == JS_CCFUNCTION {\n392\t                JS_ISFUNCTION\n393\t            } else {\n394\t                JS_ISOBJECT\n395\t            }\n396\t        }\n397\t        _ => JS_ISSTRING,\n398\t    }\n399\t}\n400\t\n401\t#[unsafe(no_mangle)]\n402\tpub unsafe extern \"C-unwind\" fn js_toboolean(J: *mut js_State, idx: c_int) -> c_int {\n403\t    jsV_toboolean(J, stackidx(J, idx))\n404\t}\n405\t\n406\t#[unsafe(no_mangle)]\n407\tpub unsafe extern \"C-unwind\" fn js_tonumber(J: *mut js_State, idx: c_int) -> f64 {\n408\t    jsV_tonumber(J, stackidx(J, idx))\n409\t}\n410\t\n411\t#[unsafe(no_mangle)]\n412\tpub unsafe extern \"C-unwind\" fn js_tointeger(J: *mut js_State, idx: c_int) -> c_int {\n413\t    jsV_numbertointeger(jsV_tonumber(J, stackidx(J, idx)))\n414\t}\n415\t\n416\t#[unsafe(no_mangle)]\n417\tpub unsafe extern \"C-unwind\" fn js_toint32(J: *mut js_State, idx: c_int) -> c_int {\n418\t    jsV_numbertoint32(jsV_tonumber(J, stackidx(J, idx)))\n419\t}\n420\t\n421\t#[unsafe(no_mangle)]\n422\tpub unsafe extern \"C-unwind\" fn js_touint32(J: *mut js_State, idx: c_int) -> c_uint {\n423\t    jsV_numbertouint32(jsV_tonumber(J, stackidx(J, idx)))\n424\t}\n425\t\n426\t#[unsafe(no_mangle)]\n427\tpub unsafe extern \"C-unwind\" fn js_toint16(J: *mut js_State, idx: c_int) -> i16 {\n428\t    jsV_numbertoint16(jsV_tonumber(J, stackidx(J, idx)))\n429\t}\n430\t\n431\t#[unsafe(no_mangle)]\n432\tpub unsafe extern \"C-unwind\" fn js_touint16(J: *mut js_State, idx: c_int) -> u16 {\n433\t    jsV_numbertouint16(jsV_tonumber(J, stackidx(J, idx)))\n434\t}\n435\t\n436\t#[unsafe(no_mangle)]\n437\tpub unsafe extern \"C-unwind\" fn js_tostring(J: *mut js_State, idx: c_int) -> *const c_char {\n438\t    jsV_tostring(J, stackidx(J, idx))\n439\t}\n440\t\n441\t#[unsafe(no_mangle)]\n442\tpub unsafe extern \"C-unwind\" fn js_toobject(J: *mut js_State, idx: c_int) -> *mut js_Object {\n443\t    jsV_toobject(J, stackidx(J, idx))\n444\t}\n445\t\n446\t#[unsafe(no_mangle)]\n447\tpub unsafe extern \"C-unwind\" fn js_toprimitive(J: *mut js_State, idx: c_int, hint: c_int) {\n448\t    jsV_toprimitive(J, stackidx(J, idx), hint);\n449\t}\n450\t\n451\t#[unsafe(no_mangle)]\n452\tpub unsafe extern \"C-unwind\" fn js_toregexp(J: *mut js_State, idx: c_int) -> *mut js_Regexp {\n453\t    let v = stackidx(J, idx);\n454\t    if (*v).ty() == JS_TOBJECT && (*(*v).object()).type_ == JS_CREGEXP {\n455\t        return core::ptr::addr_of_mut!((*(*v).object()).u.r);\n456\t    }\n457\t    js_typeerror!(J, c\"not a regexp\".as_ptr());\n458\t}\n459\t\n460\t#[unsafe(no_mangle)]\n461\tpub unsafe extern \"C-unwind\" fn js_touserdata(\n462\t    J: *mut js_State,\n463\t    idx: c_int,\n464\t    tag: *const c_char,\n465\t) -> *mut c_void {\n466\t    let v = stackidx(J, idx);\n467\t    if (*v).ty() == JS_TOBJECT && (*(*v).object()).type_ == JS_CUSERDATA {\n468\t        if strcmp(tag, (*(*v).object()).u.user.tag) == 0 {\n469\t            return (*(*v).object()).u.user.data;\n470\t        }\n471\t    }\n472\t    js_typeerror!(J, c\"not a %s\".as_ptr(), tag);\n473\t}\n474\t\n475\tunsafe fn jsR_tofunction(J: *mut js_State, idx: c_int) -> *mut js_Object {\n476\t    let v = stackidx(J, idx);\n477\t    if (*v).ty() == JS_TUNDEFINED || (*v).ty() == JS_TNULL {\n478\t        return null_mut();\n479\t    }\n480\t    if (*v).ty() == JS_TOBJECT {\n481\t        let t = (*(*v).object()).type_;\n482\t        if t == JS_CFUNCTION || t == JS_CCFUNCTION {\n483\t            return (*v).object();\n484\t        }\n485\t    }\n486\t    js_typeerror!(J, c\"not a function\".as_ptr());\n487\t}\n488\t\n489\t/* Stack manipulation */\n490\t\n491\t#[unsafe(no_mangle)]\n492\tpub unsafe extern \"C-unwind\" fn js_gettop(J: *mut js_State) -> c_int {\n493\t    (*J).top - (*J).bot\n494\t}\n495\t\n496\t#[unsafe(no_mangle)]\n497\tpub unsafe extern \"C-unwind\" fn js_pop(J: *mut js_State, n: c_int) {\n498\t    (*J).top -= n;\n499\t    if (*J).top < (*J).bot {\n500\t        (*J).top = (*J).bot;\n501\t        js_error!(J, c\"stack underflow!\".as_ptr());\n502\t    }\n503\t}\n504\t\n505\t#[unsafe(no_mangle)]\n506\tpub unsafe extern \"C-unwind\" fn js_remove(J: *mut js_State, idx: c_int) {\n507\t    let mut idx = if idx < 0 { (*J).top + idx } else { (*J).bot + idx };\n508\t    if idx < (*J).bot || idx >= (*J).top {\n509\t        js_error!(J, c\"stack error!\".as_ptr());\n510\t    }\n511\t    while idx < (*J).top - 1 {\n512\t        *slot(J, idx) = *slot(J, idx + 1);\n513\t        idx += 1;\n514\t    }\n515\t    (*J).top -= 1;\n516\t}\n517\t\n518\t#[unsafe(no_mangle)]\n519\tpub unsafe extern \"C-unwind\" fn js_insert(J: *mut js_State, _idx: c_int) {\n520\t    js_error!(J, c\"not implemented yet\".as_ptr());\n521\t}\n522\t\n523\t#[unsafe(no_mangle)]\n524\tpub unsafe extern \"C-unwind\" fn js_replace(J: *mut js_State, idx: c_int) {\n525\t    let idx = if idx < 0 { (*J).top + idx } else { (*J).bot + idx };\n526\t    if idx < (*J).bot || idx >= (*J).top {\n527\t        js_error!(J, c\"stack error!\".as_ptr());\n528\t    }\n529\t    (*J).top -= 1;\n530\t    *slot(J, idx) = *slot(J, (*J).top);\n531\t}\n532\t\n533\t#[unsafe(no_mangle)]\n534\tpub unsafe extern \"C-unwind\" fn js_copy(J: *mut js_State, idx: c_int) {\n535\t    CHECKSTACK!(J, 1);\n536\t    *slot(J, (*J).top) = *stackidx(J, idx);\n537\t    (*J).top += 1;\n538\t}\n539\t\n540\t#[unsafe(no_mangle)]\n541\tpub unsafe extern \"C-unwind\" fn js_dup(J: *mut js_State) {\n542\t    CHECKSTACK!(J, 1);\n543\t    *slot(J, (*J).top) = *slot(J, (*J).top - 1);\n544\t    (*J).top += 1;\n545\t}\n546\t\n547\t#[unsafe(no_mangle)]\n548\tpub unsafe extern \"C-unwind\" fn js_dup2(J: *mut js_State) {\n549\t    CHECKSTACK!(J, 2);\n550\t    *slot(J, (*J).top) = *slot(J, (*J).top - 2);\n551\t    *slot(J, (*J).top + 1) = *slot(J, (*J).top - 1);\n552\t    (*J).top += 2;\n553\t}\n554\t\n555\t#[unsafe(no_mangle)]\n556\tpub unsafe extern \"C-unwind\" fn js_rot2(J: *mut js_State) {\n557\t    let t = (*J).top;\n558\t    let tmp = *slot(J, t - 1);\n55