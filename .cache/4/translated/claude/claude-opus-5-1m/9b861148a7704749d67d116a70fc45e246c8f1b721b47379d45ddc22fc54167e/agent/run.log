t    J: *mut js_State,\n340\t    idx: c_int,\n341\t    tag: *const c_char,\n342\t) -> c_int {\n343\t    let v = stackidx(J, idx);\n344\t    if (*v).ty() == JS_TOBJECT && (*(*v).object()).type_ == JS_CUSERDATA {\n345\t        return (strcmp(tag, (*(*v).object()).u.user.tag) == 0) as c_int;\n346\t    }\n347\t    0\n348\t}\n349\t\n350\t#[unsafe(no_mangle)]\n351\tpub unsafe extern \"C-unwind\" fn js_iserror(J: *mut js_State, idx: c_int) -> c_int {\n352\t    let v = stackidx(J, idx);\n353\t    ((*v).ty() == JS_TOBJECT && (*(*v).object()).type_ == JS_CERROR) as c_int\n354\t}\n355\t\n356\t#[unsafe(no_mangle)]\n357\tpub unsafe extern \"C-unwind\" fn js_typeof(J: *mut js_State, idx: c_int) -> *const c_char {\n358\t    let v = stackidx(J, idx);\n359\t    match (*v).ty() {\n360\t        JS_TUNDEFINED => c\"undefined\".as_ptr(),\n361\t        JS_TNULL => c\"object\".as_ptr(),\n362\t        JS_TBOOLEAN => c\"boolean\".as_ptr(),\n363\t        JS_TNUMBER => c\"number\".as_ptr(),\n364\t        JS_TLITSTR => c\"string\".as_ptr(),\n365\t        JS_TMEMSTR => c\"string\".as_ptr(),\n366\t        JS_TOBJECT => {\n367\t            let t = (*(*v).object()).type_;\n368\t            if t == JS_CFUNCTION || t == JS_CCFUNCTION {\n369\t                c\"function\".as_ptr()\n370\t            } else {\n371\t                c\"object\".as_ptr()\n372\t            }\n373\t        }\n374\t        /* JS_TSHRSTR and default */\n375\t        _ => c\"string\".as_ptr(),\n376\t    }\n377\t}\n378\t\n379\t#[unsafe(no_mangle)]\n380\tpub unsafe extern \"C-unwind\" fn js_type(J: *mut js_State, idx: c_int) -> c_int {\n381\t    let v = stackidx(J, idx);\n382\t    match (*v).ty() {\n383\t        JS_TUNDEFINED => JS_ISUNDEFINED,\n384\t        JS_TNULL => JS_ISNULL,\n385\t        JS_TBOOLEAN => JS_ISBOOLEAN,\n386\t        JS_TNUMBER => JS_ISNUMBER,\n387\t        JS_TLITSTR => JS_ISSTRING,\n388\t        JS_TMEMSTR => JS_ISSTRING,\n389\t        JS_TOBJECT => {\n390\t            let t = (*(*v).object()).type_;\n391\t            if t == JS_CFUNCTION || t == JS_CCFUNCTION {\n392\t                JS_ISFUNCTION\n393\t            } else {\n394\t                JS_ISOBJECT\n395\t            }\n396\t        }\n397\t        _ => JS_ISSTRING,\n398\t    }\n399\t}\n400\t\n401\t#[unsafe(no_mangle)]\n402\tpub unsafe extern \"C-unwind\" fn js_toboolean(J: *mut js_State, idx: c_int) -> c_int {\n403\t    jsV_toboolean(J, stackidx(J, idx))\n404\t}\n405\t\n406\t#[unsafe(no_mangle)]\n407\tpub unsafe extern \"C-unwind\" fn js_tonumber(J: *mut js_State, idx: c_int) -> f64 {\n408\t    jsV_tonumber(J, stackidx(J, idx))\n409\t}\n410\t\n411\t#[unsafe(no_mangle)]\n412\tpub unsafe extern \"C-unwind\" fn js_tointeger(J: *mut js_State, idx: c_int) -> c_int {\n413\t    jsV_numbertointeger(jsV_tonumber(J, stackidx(J, idx)))\n414\t}\n415\t\n416\t#[unsafe(no_mangle)]\n417\tpub unsafe extern \"C-unwind\" fn js_toint32(J: *mut js_State, idx: c_int) -> c_int {\n418\t    jsV_numbertoint32(jsV_tonumber(J, stackidx(J, idx)))\n419\t}\n420\t\n421\t#[unsafe(no_mangle)]\n422\tpub unsafe extern \"C-unwind\" fn js_touint32(J: *mut js_State, idx: c_int) -> c_uint {\n423\t    jsV_numbertouint32(jsV_tonumber(J, stackidx(J, idx)))\n424\t}\n425\t\n426\t#[unsafe(no_mangle)]\n427\tpub unsafe extern \"C-unwind\" fn js_toint16(J: *mut js_State, idx: c_int) -> i16 {\n428\t    jsV_numbertoint16(jsV_tonumber(J, stackidx(J, idx)))\n429\t}\n430\t\n431\t#[unsafe(no_mangle)]\n432\tpub unsafe extern \"C-unwind\" fn js_touint16(J: *mut js_State, idx: c_int) -> u16 {\n433\t    jsV_numbertouint16(jsV_tonumber(J, stackidx(J, idx)))\n434\t}\n435\t\n436\t#[unsafe(no_mangle)]\n437\tpub unsafe extern \"C-unwind\" fn js_tostring(J: *mut js_State, idx: c_int) -> *const c_char {\n438\t    jsV_tostring(J, stackidx(J, idx))\n439\t}\n440\t\n441\t#[unsafe(no_mangle)]\n442\tpub unsafe extern \"C-unwind\" fn js_toobject(J: *mut js_State, idx: c_int) -> *mut js_Object {\n443\t    jsV_toobject(J, stackidx(J, idx))\n444\t}\n445\t\n446\t#[unsafe(no_mangle)]\n