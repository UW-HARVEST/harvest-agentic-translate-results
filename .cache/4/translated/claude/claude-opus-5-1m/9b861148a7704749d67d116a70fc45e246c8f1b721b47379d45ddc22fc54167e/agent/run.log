4 {\nsrc/jsvalue.rs:297:pub unsafe extern \"C-unwind\" fn jsV_stringtonumber(\nsrc/jsvalue.rs:334:pub unsafe extern \"C-unwind\" fn jsV_tonumber(J: *mut js_State, v: *mut js_Value) -> f64 {\nsrc/jsvalue.rs:352:pub unsafe extern \"C-unwind\" fn jsV_tointeger(J: *mut js_State, v: *mut js_Value) -> f64 {\nsrc/jsvalue.rs:358:pub unsafe extern \"C-unwind\" fn jsV_numbertostring(\nsrc/jsvalue.rs:480:pub unsafe extern \"C-unwind\" fn jsV_tostring(J: *mut js_State, v: *mut js_Value) -> *const c_char {\nsrc/jsvalue.rs:564:pub unsafe extern \"C-unwind\" fn jsV_toobject(J: *mut js_State, v: *mut js_Value) -> *mut js_Object {\nsrc/jsvalue.rs:583:pub unsafe extern \"C-unwind\" fn js_newobjectx(J: *mut js_State) {\nsrc/jsvalue.rs:593:pub unsafe extern \"C-unwind\" fn js_newobject(J: *mut js_State) {\nsrc/jsvalue.rs:598:pub unsafe extern \"C-unwind\" fn js_newarguments(J: *mut js_State) {\nsrc/jsvalue.rs:603:pub unsafe extern \"C-unwind\" fn js_newarray(J: *mut js_State) {\nsrc/jsvalue.rs:610:pub unsafe extern \"C-unwind\" fn js_newboolean(J: *mut js_State, v: c_int) {\nsrc/jsvalue.rs:615:pub unsafe extern \"C-unwind\" fn js_newnumber(J: *mut js_State, v: f64) {\nsrc/jsvalue.rs:620:pub unsafe extern \"C-unwind\" fn js_newstring(J: *mut js_State, v: *const c_char) {\nsrc/jsvalue.rs:625:pub unsafe extern \"C-unwind\" fn js_newfunction(\nsrc/jsvalue.rs:652:pub unsafe extern \"C-unwind\" fn js_newscript(\nsrc/jsvalue.rs:664:pub unsafe extern \"C-unwind\" fn js_newcfunctionx(\nsrc/jsvalue.rs:714:pub unsafe extern \"C-unwind\" fn js_newcfunction(\nsrc/jsvalue.rs:725:pub unsafe extern \"C-unwind\" fn js_newcconstructor(\nsrc/jsvalue.rs:754:pub unsafe extern \"C-unwind\" fn js_newuserdatax(\nsrc/jsvalue.rs:796:pub unsafe extern \"C-unwind\" fn js_newuserdata(\nsrc/jsvalue.rs:808:pub unsafe extern \"C-unwind\" fn js_instanceof(J: *mut js_State) -> c_int {\nsrc/jsvalue.rs:842:pub unsafe extern \"C-unwind\" fn js_concat(J: *mut js_State) {\nsrc/jsvalue.rs:875:pub unsafe extern \"C-unwind\" fn js_compare(J: *mut js_State, okay: *mut c_int) -> c_int {\nsrc/jsvalue.rs:899:pub unsafe extern \"C-unwind\" fn js_equal(J: *mut js_State) -> c_int {\nsrc/jsvalue.rs:964:pub unsafe extern \"C-unwind\" fn js_strictequal(J: *mut js_State) -> c_int {\n//! Rust translation of the MuJS JavaScript interpreter (`c_src/`).\n//!\n//! The crate is a `cdylib` that exports the exact same public ABI as the C\n//! library built from `c_src/`.\n#![allow(non_camel_case_types)]\n#![allow(non_snake_case)]\n#![allow(non_upper_case_globals)]\n#![allow(unused_parens)]\n#![allow(unused_imports)]\n#![allow(unused_mut)]\n#![allow(unused_variables)]\n#![allow(unused_assignments)]\n#![allow(unreachable_patterns)]\n#![allow(dead_code)]\n\n#[macro_use]\npub mod macros;\n\npub mod cstd;\npub mod jsi;\npub mod vararg;\n\npub mod jsarray;\npub mod jsboolean;\npub mod jsbuiltin;\npub mod jscompile;\npub mod jsdate;\npub mod jsdtoa;\npub mod jserror;\npub mod jsfunction;\npub mod jsgc;\npub mod jsintern;\npub mod jslex;\npub mod jsmath;\npub mod jsnumber;\npub mod jsobject;\npub mod json;\npub mod jsparse;\npub mod jsproperty;\npub mod jsregexp;\npub mod jsrepr;\npub mod jsrun;\npub mod jsstate;\npub mod jsstring;\npub mod jsvalue;\npub mod regexp;\npub mod utf;\npub mod utfdata;\n[package]\nname = \"mujs\"\nversion = \"1.3.8\"\nedition = \"2021\"\n\n[lib]\nname = \"mujs\"\ncrate-type = [\"cdylib\"]\npath = \"src/lib.rs\"\n\n[profile.release]\npanic = \"unwind\"\nopt-level = 2\noverflow-checks = false\ndebug-assertions = false","is_error":false}]},"parent_tool_use_id":"toolu_bdrk_01GAPPNMfW3p84gnf3ZXpdUr","session_id":"e867ece2-5670-426a-953e-de496239b763","uuid":"3c11116f-54ec-45fc-9269-93d6fc1dfe37","timestamp":"2026-08-22T15:25:18.882Z","subagent_type":"general-purpose","task_description":"Translate jsarray.c to Rust"}
