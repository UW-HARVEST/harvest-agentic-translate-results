{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01P19QtxKVtovtrJikF1ED5s","type":"tool_result","content":"1\t//! Helper macros used to transliterate the C sources.\n2\t#![allow(unused_macros)]\n3\t\n4\t/// `snprintf(buf, sizeof buf, fmt, ...)` on a fixed size `[c_char; N]` array.\n5\t#[macro_export]\n6\tmacro_rules! sfmt {\n7\t    ($buf:expr, $fmt:expr $(, $a:expr)*) => {\n8\t        $crate::cstd::snprintf($buf.as_mut_ptr(), $buf.len() as $crate::cstd::size_t, $fmt $(, $a)*)\n9\t    };\n10\t}\n11\t\n12\t/// Build a 256 byte message with printf formatting, throw error of given class.\n13\t#[macro_export]\n14\tmacro_rules! jsthrow_fmt {\n15\t    ($J:expr, $proto:ident, $fmt:expr $(, $a:expr)*) => {{\n16\t        let mut __buf = [0 as $crate::cstd::c_char; 256];\n17\t        $crate::cstd::snprintf(__buf.as_mut_ptr(), 256, $fmt $(, $a)*);\n18\t        $crate::jserror::js_newerrorx($J, __buf.as_ptr(), (*$J).$proto);\n19\t        $crate::jsrun::js_throw($J)\n20\t    }};\n21\t}\n22\t\n23\t#[macro_export]\n24\tmacro_rules! js_error {\n25\t    ($J:expr, $fmt:expr $(, $a:expr)*) => { $crate::jsthrow_fmt!($J, Error_prototype, $fmt $(, $a)*) };\n26\t}\n27\t#[macro_export]\n28\tmacro_rules! js_evalerror {\n29\t    ($J:expr, $fmt:expr $(, $a:expr)*) => { $crate::jsthrow_fmt!($J, EvalError_prototype, $fmt $(, $a)*) };\n30\t}\n31\t#[macro_export]\n32\tmacro_rules! js_rangeerror {\n33\t    ($J:expr, $fmt:expr $(, $a:expr)*) => { $crate::jsthrow_fmt!($J, RangeError_prototype, $fmt $(, $a)*) };\n34\t}\n35\t#[macro_export]\n36\tmacro_rules! js_referenceerror {\n37\t    ($J:expr, $fmt:expr $(, $a:expr)*) => { $crate::jsthrow_fmt!($J, ReferenceError_prototype, $fmt $(, $a)*) };\n38\t}\n39\t#[macro_export]\n40\tmacro_rules! js_syntaxerror {\n41\t    ($J:expr, $fmt:expr $(, $a:expr)*) => { $crate::jsthrow_fmt!($J, SyntaxError_prototype, $fmt $(, $a)*) };\n42\t}\n43\t#[macro_export]\n44\tmacro_rules! js_typeerror {\n45\t    ($J:expr, $fmt:expr $(, $a:expr)*) => { $crate::jsthrow_fmt!($J, TypeError_prototype, $fmt $(, $a)*) };\n46\t}\n47\t#[macro_export]\n48\tmacro_rules! js_urierror {\n49\t    ($J:expr, $fmt:expr $(, $a:expr)*) => { $crate::jsthrow_fmt!($J, URIError_prototype, $fmt $(, $a)*) };\n50\t}\n51\t"}]},"parent_tool_use_id":"toolu_bdrk_012m38ch22vhthTDoQg6GVRt","session_id":"e867ece2-5670-426a-953e-de496239b763","uuid":"57a8e725-fa18-4cda-9a77-e66279b2fbdd","timestamp":"2026-08-22T15:37:13.055Z","subagent_type":"general-purpose","task_description":"Translate jsdate.c to Rust"}
