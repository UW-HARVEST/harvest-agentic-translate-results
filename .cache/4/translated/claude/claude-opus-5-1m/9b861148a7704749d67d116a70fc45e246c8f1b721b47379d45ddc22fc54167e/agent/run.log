   js_error!(J, c\"stack underflow!\".as_ptr());\n502\t    }\n503\t}\n504\t\n505\t#[unsafe(no_mangle)]\n506\tpub unsafe extern \"C-unwind\" fn js_remove(J: *mut js_State, idx: c_int) {\n507\t    let mut idx = if idx < 0 { (*J).top + idx } else { (*J).bot + idx };\n508\t    if idx < (*J).bot || idx >= (*J).top {\n509\t        js_error!(J, c\"stack error!\".as_ptr());\n510\t    }\n511\t    while idx < (*J).top - 1 {\n512\t        *slot(J, idx) = *slot(J, idx + 1);\n513\t        idx += 1;\n514\t    }\n515\t    (*J).top -= 1;\n516\t}\n517\t\n518\t#[unsafe(no_mangle)]\n519\tpub unsafe extern \"C-unwind\" fn js_insert(J: *mut js_State, _idx: c_int) {\n520\t    js_error!(J, c\"not implemented yet\".as_ptr());\n521\t}\n522\t\n523\t#[unsafe(no_mangle)]\n524\tpub unsafe extern \"C-unwind\" fn js_replace(J: *mut js_State, idx: c_int) {\n525\t    let idx = if idx < 0 { (*J).top + idx } else { (*J).bot + idx };\n526\t    if idx < (*J).bot || idx >= (*J).top {\n527\t        js_error!(J, c\"stack error!\".as_ptr());\n528\t    }\n529\t    (*J).top -= 1;\n530\t    *slot(J, idx) = *slot(J, (*J).top);\n531\t}\n532\t\n533\t#[unsafe(no_mangle)]\n534\tpub unsafe extern \"C-unwind\" fn js_copy(J: *mut js_State, idx: c_int) {\n535\t    CHECKSTACK!(J, 1);\n536\t    *slot(J, (*J).top) = *stackidx(J, idx);\n537\t    (*J).top += 1;\n538\t}\n539\t\n540\t#[unsafe(no_mangle)]\n541\tpub unsafe extern \"C-unwind\" fn js_dup(J: *mut js_State) {\n542\t    CHECKSTACK!(J, 1);\n543\t    *slot(J, (*J).top) = *slot(J, (*J).top - 1);\n544\t    (*J).top += 1;\n545\t}\n546\t\n547\t#[unsafe(no_mangle)]\n548\tpub unsafe extern \"C-unwind\" fn js_dup2(J: *mut js_State) {\n549\t    CHECKSTACK!(J, 2);\n550\t    *slot(J, (*J).top) = *slot(J, (*J).top - 2);\n551\t    *slot(J, (*J).top + 1) = *slot(J, (*J).top - 1);\n552\t    (*J).top += 2;\n553\t}\n554\t\n555\t#[unsafe(no_mangle)]\n556\tpub unsafe extern \"C-unwind\" fn js_rot2(J: *mut js_State) {\n557\t    let t = (*J).top;\n558\t    let tmp = *slot(J, t - 1);\n559\t    *slot(J, t - 1) = *slot(J, t - 2);\n560\t    *slot(J, t - 2) = tmp;\n561\t}\n562\t\n563\t#[unsafe(no_mangle)]\n564\tpub unsafe extern \"C-unwind\" fn js_rot3(J: *mut js_State) {\n565\t    let t = (*J).top;\n566\t    let tmp = *slot(J, t - 1);\n567\t    *slot(J, t - 1) = *slot(J, t - 2);\n568\t    *slot(J, t - 2) = *slot(J, t - 3);\n569\t    *slot(J, t - 3) = tmp;\n570\t}\n571\t\n572\t#[unsafe(no_mangle)]\n573\tpub unsafe extern \"C-unwind\" fn js_rot4(J: *mut js_State) {\n574\t    let t = (*J).top;\n575\t    let tmp = *slot(J, t - 1);\n576\t    *slot(J, t - 1) = *slot(J, t - 2);\n577\t    *slot(J, t - 2) = *slot(J, t - 3);\n578\t    *slot(J, t - 3) = *slot(J, t - 4);\n579\t    *slot(J, t - 4) = tmp;\n580\t}\n581\t\n582\t#[unsafe(no_mangle)]\n583\tpub unsafe extern \"C-unwind\" fn js_rot2pop1(J: *mut js_State) {\n584\t    let t = (*J).top;\n585\t    *slot(J, t - 2) = *slot(J, t - 1);\n586\t    (*J).top -= 1;\n587\t}\n588\t\n589\t#[unsafe(no_mangle)]\n590\tpub unsafe extern \"C-unwind\" fn js_rot3pop2(J: *mut js_State) {\n591\t    let t = (*J).top;\n592\t    *slot(J, t - 3) = *slot(J, t - 1);\n593\t    (*J).top -= 2;\n594\t}\n595\t\n596\t#[unsafe(no_mangle)]\n597\tpub unsafe extern \"C-unwind\" fn js_rot(J: *mut js_State, n: c_int) {\n598\t    let t = (*J).top;\n599\t    let tmp = *slot(J, t - 1);\n600\t    let mut i = 1;\n601\t    while i < n {\n602\t        *slot(J, t - i) = *slot(J, t - i - 1);\n603\t        i += 1;\n604\t    }\n605\t    *slot(J, t - i) = tmp;\n606\t}\n607\t\n608\t/* Property access that takes care of attributes and getters/setters */\n609\t\n610\t#[unsafe(no_mangle)]\n611\tpub unsafe extern \"C-unwind\" fn js_isarrayindex(\n612\t    _J: *mut js_State,\n613\t    mut p: *const c_char,\n614\t    idx: *mut c_int,\n615\t) -> c_int {\n616\t    let mut n: c_int = 0;\n617\t\n618\t    /* check for empty string */\n619\t    if *p == 0 {\n620\t        return 0;\n621\t    }\n622\t\n623\t    /* check for '0' and integers with leading zero */\n624\t    i