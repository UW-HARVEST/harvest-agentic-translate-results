   if (!hc || !hr) { printf(\"dlopen failed: %s\\n\", dlerror()); return 2; }\n    fn_t fc = (fn_t)dlsym(hc, \"wcscat\");\n    fn_t fr = (fn_t)dlsym(hr, \"wcscat\");\n    if (!fc || !fr) { printf(\"dlsym failed\\n\"); return 2; }\n\n    wchar_t empty[1]      = {0};\n    wchar_t abc[4]        = {L'a', L'b', L'c', 0};\n    wchar_t full4[4]      = {L'a', L'b', L'c', L'd'};      /* no NUL */\n    wchar_t noterm8[8]    = {1,2,3,4,5,6,7,8};             /* no NUL */\n    wchar_t midnul[6]     = {L'x', 0, L'y', L'z', 0, 0};\n    wchar_t wide[5]       = {0x10FFFF, -1, 0x7FFFFFFF, 0x1F600, 0};\n\n    const wchar_t *srcs[] = {\n        L\"\", L\"z\", L\"hi\", L\"hello\", L\"abcdefghijklmnop\",\n        (const wchar_t[]){0x1F600, 0x4E2D, -5, 0},\n    };\n    const wchar_t *inits[] = { empty, abc, full4, noterm8, midnul, wide };\n    size_t initlens[]      = { 1, 4, 4, 8, 6, 5 };\n    const char *names[]    = { \"empty\", \"abc\", \"full4-noNUL\", \"noterm8\", \"midnul\", \"wide\" };\n\n    for (size_t ii = 0; ii < 6; ii++)\n      for (size_t si = 0; si < sizeof(srcs)/sizeof(*srcs); si++)\n        for (size_t ne = 0; ne <= BUF; ne++)\n          cmp(fc, fr, inits[ii], initlens[ii], ne, srcs[si], 0, 0, names[ii]);\n\n    /* NULL dst / NULL src / degenerate sizes */\n    for (size_t ne = 0; ne <= 3; ne++) {\n        cmp(fc, fr, abc, 4, ne, L\"q\", 1, 0, \"nulldst\");\n        cmp(fc, fr, abc, 4, ne, L\"q\", 0, 1, \"nullsrc\");\n        cmp(fc, fr, abc, 4, ne, L\"q\", 1, 1, \"bothnull\");\n        cmp(fc, fr, empty, 1, ne, L\"q\", 1, 0, \"nulldst-empty\");\n    }\n    cmp(fc, fr, abc, 4, (size_t)-1 /* SIZE_MAX */, L\"\", 1, 0, \"nulldst-huge\");\n    cmp(fc, fr, abc, 4, 0, L\"x\", 0, 0, \"zero-numElem\");\n\n    printf(\"cases=%d fails=%d\\n\", cases, fails);\n    return fails ? 1 : 0;\n}\nEOF\ngcc -O1 -o \"$TMPDIR/difftest\" \"$TMPDIR/difftest.c\" -ldl 2>&1 | head -20\n\"$TMPDIR/difftest\" \"$TMPDIR/cbuild/libc_ref.so\" \"$PWD/target/release/libtranslated_rust.so\"; echo \"EXIT=$?\