//! Temporary struct-layout verification helper. Prints `name size align`
//! lines that can be diffed against the C reference in `layoutcheck/`.
#![allow(dead_code)]

use crate::common::xxhash::*;
use crate::compress::zstd_compress_internal::*;
use crate::compress::zstd_cwksp::*;
use crate::decompress::zstd_decompress_internal::*;

macro_rules! p {
    ($out:ident, $t:ty, $n:expr) => {
        $out.push(format!(
            "{} {} {}",
            $n,
            core::mem::size_of::<$t>(),
            core::mem::align_of::<$t>()
        ));
    };
}

pub fn layout_report() -> String {
    let mut out: Vec<String> = Vec::new();
    p!(out, ZSTD_cwksp, "ZSTD_cwksp");
    p!(out, SeqDef, "SeqDef");
    p!(out, SeqStore_t, "SeqStore_t");
    p!(out, ZSTD_window_t, "ZSTD_window_t");
    p!(out, optState_t, "optState_t");
    p!(out, ZSTD_MatchState_t, "ZSTD_MatchState_t");
    p!(out, ZSTD_blockState_t, "ZSTD_blockState_t");
    p!(out, ZSTD_hufCTables_t, "ZSTD_hufCTables_t");
    p!(out, ZSTD_fseCTables_t, "ZSTD_fseCTables_t");
    p!(out, ZSTD_entropyCTables_t, "ZSTD_entropyCTables_t");
    p!(out, ZSTD_hufCTablesMetadata_t, "ZSTD_hufCTablesMetadata_t");
    p!(out, ZSTD_fseCTablesMetadata_t, "ZSTD_fseCTablesMetadata_t");
    p!(
        out,
        ZSTD_entropyCTablesMetadata_t,
        "ZSTD_entropyCTablesMetadata_t"
    );
    p!(out, ldmEntry_t, "ldmEntry_t");
    p!(out, ldmMatchCandidate_t, "ldmMatchCandidate_t");
    p!(out, ldmState_t, "ldmState_t");
    p!(out, ldmParams_t, "ldmParams_t");
    p!(out, SeqCollector, "SeqCollector");
    p!(out, ZSTD_CCtx_params, "ZSTD_CCtx_params");
    p!(out, ZSTD_blockSplitCtx, "ZSTD_blockSplitCtx");
    p!(out, ZSTD_CCtx, "ZSTD_CCtx");
    p!(out, ZSTD_CDict, "struct ZSTD_CDict_s");
    p!(out, ZSTD_seqSymbol, "ZSTD_seqSymbol");
    p!(out, ZSTD_entropyDTables_t, "ZSTD_entropyDTables_t");
    p!(out, ZSTD_DCtx, "ZSTD_DCtx");
    p!(out, ZSTD_DDict, "struct ZSTD_DDict_s");
    p!(
        out,
        ZSTD_compressedBlockState_t,
        "ZSTD_compressedBlockState_t"
    );
    p!(out, XXH64_state_t, "XXH64_state_t");
    p!(out, XXH32_state_t, "XXH32_state_t");
    p!(out, RawSeqStore_t, "RawSeqStore_t");
    p!(out, rawSeq, "rawSeq");
    p!(out, ZSTD_match_t, "ZSTD_match_t");
    p!(out, ZSTD_optimal_t, "ZSTD_optimal_t");
    p!(out, ZSTD_DDictHashSet, "ZSTD_DDictHashSet");

    out.push(format!(
        "OFF_CCtx_workspace {}",
        core::mem::offset_of!(ZSTD_CCtx, workspace)
    ));
    out.push(format!(
        "OFF_CCtx_blockState {}",
        core::mem::offset_of!(ZSTD_CCtx, blockState)
    ));
    out.push(format!(
        "OFF_CCtx_blockSplitCtx {}",
        core::mem::offset_of!(ZSTD_CCtx, blockSplitCtx)
    ));
    out.push(format!(
        "OFF_DCtx_entropy {}",
        core::mem::offset_of!(ZSTD_DCtx, entropy)
    ));
    out.push(format!(
        "OFF_DCtx_litExtraBuffer {}",
        core::mem::offset_of!(ZSTD_DCtx, litExtraBuffer)
    ));
    out.push(format!(
        "OFF_DCtx_oversizedDuration {}",
        core::mem::offset_of!(ZSTD_DCtx, oversizedDuration)
    ));
    out.push(format!(
        "OFF_MS_opt {}",
        core::mem::offset_of!(ZSTD_MatchState_t, opt)
    ));
    out.push(format!(
        "OFF_MS_cParams {}",
        core::mem::offset_of!(ZSTD_MatchState_t, cParams)
    ));

    out.join("\n")
}

/// Exported so a tiny C/Rust driver can print it.
#[unsafe(no_mangle)]
pub extern "C" fn zstd_rs_layout_report_print() {
    println!("{}", layout_report());
}
