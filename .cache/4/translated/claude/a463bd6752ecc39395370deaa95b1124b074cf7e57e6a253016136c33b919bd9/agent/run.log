{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_7wplcvbrabvxvfr7h5nruhtotcbguuxrtukch5vz7g4mcx2qlzgq","type":"message","role":"assistant","content":[{"type":"text","text":"Symbol lists match exactly. Now let me build a differential test harness to verify byte-identical behavior."}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":778,"cache_read_input_tokens":86695,"cache_creation":{"ephemeral_5m_input_tokens":778,"ephemeral_1h_input_tokens":0},"output_tokens":6,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"ef3f1378-8cf2-4998-925b-8abdca0d97d6","uuid":"ffb0aa7a-0f31-443a-aa8e-f469933a31ad","timestamp":"2026-08-20T03:32:43.779Z"}
{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_7wplcvbrabvxvfr7h5nruhtotcbguuxrtukch5vz7g4mcx2qlzgq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01Cqf8wSTq1r5YBKFmrZtDg3","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-translate-5kyuur/tmp/cbuild/difftest.c","content":"/* Differential driver: dlopen ONE library (argv[1]) and print an exhaustive\n   trace of every exported entry point.  Run once per .so and diff the output. */\n#define _GNU_SOURCE\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stddef.h>\n#include <dlfcn.h>\n\ntypedef struct { size_t length, capacity; void *hash_table; ptrdiff_t temp; } hdr;\n#define HDR(p) (((hdr*)(p))-1)\n\ntypedef struct { void *storage; size_t remaining; unsigned char block, mode; } arena_t;\ntypedef struct {\n  char  *temp_key;\n  size_t slot_count, used_count, used_count_threshold, used_count_shrink_threshold;\n  size_t tombstone_count, tombstone_count_threshold, seed, slot_count_log2;\n  arena_t string;\n  void  *storage;\n} hidx;\ntypedef struct { size_t hash[8]; ptrdiff_t index[8]; } bucket;\n\ntypedef struct { void *storage; size_t remaining; unsigned char block, mode; } sarena;\n\nstatic void  *(*p_arrgrowf)(void*, size_t, size_t, size_t);\nstatic void   (*p_arrfreef)(void*);\nstatic void   (*p_rand_seed)(size_t);\nstatic size_t (*p_hash_string)(char*, size_t);\nstatic size_t (*p_hash_bytes)(void*, size_t, size_t);\nstatic void  *(*p_hmget_key_ts)(void*, size_t, void*, size_t, ptrdiff_t*, int);\nstatic void  *(*p_hmget_key)(void*, size_t, void*, size_t, int);\nstatic void  *(*p_hmput_default)(void*, size_t);\nstatic void  *(*p_shmode_func)(size_t, int);\nstatic void  *(*p_hmdel_key)(void*, size_t, void*, size_t, size_t, int);\nstatic char  *(*p_stralloc)(void*, char*);\nstatic void  *(*p_hmput_key)(void*, size_t, void*, size_t, int);\nstatic void   (*p_strreset)(void*);\nstatic void   (*p_hmfree_func)(void*, size_t);\nstatic char  *(*p_strkey)(int);\nstatic void   (*p_intput)(int);\n\n#define HM_BINARY 0\n#define HM_STRING 1\n#define SH_NONE 0\n#define SH_DEFAULT 1\n#define SH_STRDUP 2\n#define SH_ARENA 3\n\nstatic void dump_table(const char *tag, void *raw_a)\n{\n  hidx *t = raw_a ? (hidx*) HDR(raw_a)->hash_table : NULL;\n  if (!t) { printf(\"%s table=NULL\\n\", tag); return; }\n  printf(\"%s table slot_count=%zu log2=%zu used=%zu uct=%zu ucst=%zu tomb=%zu tct=%zu seed=%016zx\"\n         \" str{rem=%zu blk=%u mode=%u stor=%d}\\n\",\n         tag, t->slot_count, t->slot_count_log2, t->used_count, t->used_count_threshold,\n         t->used_count_shrink_threshold, t->tombstone_count, t->tombstone_count_threshold,\n         t->seed, t->string.remaining, (unsigned) t->string.block, (unsigned) t->string.mode,\n         t->string.storage != NULL);\n  bucket *b = (bucket*) t->storage;\n  for (size_t i = 0; i < (t->slot_count >> 3); ++i) {\n    printf(\"  b[%zu]\", i);\n    for (int j = 0; j < 8; ++j) printf(\" %016zx/%td\", b[i].hash[j], b[i].index[j]);\n    printf(\"\\n\");\n  }\n}\n\nstatic void dump_intmap(const char *tag, void *hm, size_t elemsize)\n{\n  if (!hm) { printf(\"%s map=NULL\\n\", tag); return; }\n  void *raw = (char*) hm - elemsize;\n  hdr *h = HDR(raw);\n  printf(\"%s len=%zu cap=%zu temp=%td elems:\", tag, h->length, h->capacity, h->temp);\n  int *e = (int*) raw;\n  for (size_t i = 0; i < h->length; ++i)\n    printf(\" (%d,%d)\", e[(elemsize/4)*i], e[(elemsize/4)*i + 1]);\n  printf(\"\\n\");\n  dump_table(tag, raw);\n}\n\nstatic void dump_strmap(const char *tag, void *hm, size_t elemsize)\n{\n  if (!hm) { printf(\"%s map=NULL\\n\", tag); return; }\n  void *raw = (char*) hm - elemsize;\n  hdr *h = HDR(raw);\n  printf(\"%s len=%zu cap=%zu temp=%td elems:\", tag, h->length, h->capacity, h->temp);\n  for (size_t i = 0; i < h->length; ++i) {\n    char *k = *(char**)((char*) raw + elemsize*i);\n    int   v = *(int*)((char*) raw + elemsize*i + sizeof(char*));\n    if (i == 0) printf(\" (<default>,%d)\", v);\n    else        printf(\" (\\\"%s\\\",%d)\", k ? k : \"(null)\", v);\n  }\n  printf(\"\\n\");\n  hidx *t = (hidx*) h->hash_table;\n  if (t) printf(\"%s temp_key=\\\"%s\\\"\\n\", tag, t->temp_key ? t->temp_key : \"(null)\");\n  dump_table(tag, raw);\n}\n\n/* ---------------------------------------------------------------- tests */\n\nstatic void test_hash_string(void)\n{\n  static const char *strs[] = { \"\", \"a\", \"b\", \"ab\", \"ba\", \"test_0\", \"test_1\", \"test_12345\",\n                                \"hello world\", \"\\x80\\xff\\x7f\", \"the quick brown fox jumps over the lazy dog\",\n                                \"\\xc3\\xa9\\xc3\\xa8\\xc3\\xaa\" };\n  size_t seeds[] = { 0, 1, 2, 0x31415926, 0xdeadbeefcafebabeULL, ~(size_t)0, 0x8000000000000000ULL };\n  puts(\"== hash_string ==\");\n  for (unsigned i = 0; i < sizeof(strs)/sizeof(strs[0]); ++i)\n    for (unsigned j = 0; j < sizeof(seeds)/sizeof(seeds[0]); ++j)\n      printf(\"hs[%u][%u]=%016zx\\n\", i, j, p_hash_string((char*) strs[i], seeds[j]));\n}\n\nstatic void test_hash_bytes(void)\n{\n  unsigned char buf[64];\n  size_t seeds[] = { 0, 1, 0x31415926, 0xdeadbeefcafebabeULL, ~(size_t)0 };\n  puts(\"== hash_bytes ==\");\n  for (unsigned pat = 0; pat < 4; ++pat) {\n    for (unsigned k = 0; k < sizeof(buf); ++k) {\n      switch (pat) {\n        case 0: buf[k] = (unsigned char)(k * 37 + 13); break;\n        case 1: buf[k] = 0xff; break;\n        case 2: buf[k] = 0x00; break;\n        default: buf[k] = (unsigned char)(k & 1 ? 0x80 : 0x01); break;\n      }\n    }\n    for (size_t len = 0; len <= 40; ++len)\n      for (unsigned j = 0; j < sizeof(seeds)/sizeof(seeds[0]); ++j)\n        printf(\"hb[%u][%zu][%u]=%016zx\\n\", pat, len, j, p_hash_bytes(buf, len, seeds[j]));\n  }\n  /* also hash ints, the way hmput does */\n  for (int v = -5; v < 40; ++v) {\n    int key = v;\n    printf(\"hbi[%d]=%016zx\\n\", v, p_hash_bytes(&key, sizeof key, 0x31415926));\n  }\n}\n\nstatic void test_arr(void)\n{\n  puts(\"== arrgrowf ==\");\n  struct { size_t elemsize, addlen, min_cap; } cases[] = {\n    {4,0,0},{4,0,1},{4,1,0},{4,1,1},{4,0,4},{4,0,5},{4,3,9},{8,0,1},{8,17,0},{16,1,100},{1,0,0}\n  };\n  for (unsigned i = 0; i < sizeof(cases)/sizeof(cases[0]); ++i) {\n    void *a = p_arrgrowf(NULL, cases[i].elemsize, cases[i].addlen, cases[i].min_cap);\n    printf(\"grow0[%u] len=%zu cap=%zu temp=%td ht=%d\\n\", i, HDR(a)->length, HDR(a)->capacity,\n           HDR(a)->temp, HDR(a)->hash_table != NULL);\n    /* regrow repeatedly */\n    for (unsigned r = 0; r < 6; ++r) {\n      HDR(a)->length = HDR(a)->capacity;      /* pretend it is full */\n      a = p_arrgrowf(a, cases[i].elemsize, 1, 0);\n      printf(\"  regrow[%u] len=%zu cap=%zu\\n\", r, HDR(a)->length, HDR(a)->capacity);\n    }\n    p_arrfreef(a);\n  }\n\n  /* emulate stbds_arrput of 300 ints */\n  int *arr = NULL;\n  for (int i = 0; i < 300; ++i) {\n    if (!arr || HDR(arr)->length + 1 > HDR(arr)->capacity)\n      arr = p_arrgrowf(arr, sizeof(int), 1, 0);\n    arr[HDR(arr)->length++] = i * i;\n  }\n  printf(\"arrput len=%zu cap=%zu sum=\", HDR(arr)->length, HDR(arr)->capacity);\n  long long sum = 0;\n  for (size_t i = 0; i < HDR(arr)->length; ++i) sum += arr[i];\n  printf(\"%lld first=%d last=%d\\n\", sum, arr[0], arr[299]);\n  p_arrfreef(arr);\n}\n\nstatic void test_intmap(void)\n{\n  puts(\"== int map ==\");\n  size_t elemsize = 8;\n  void *hm = NULL;\n  for (int i = 0; i < 60; ++i) {\n    int key = (i * 7919) % 211;\n    hm = p_hmput_key(hm, elemsize, &key, sizeof(int), HM_BINARY);\n    void *raw = (char*) hm - elemsize;\n    ptrdiff_t idx = HDR(raw)->temp;\n    ((int*) raw)[2*idx + 2] = key;          /* [idx].key   in hash space */\n    ((int*) raw)[2*idx + 3] = i * 3;        /* [idx].value in hash space */\n    if (i % 13 == 0 || i > 55) { printf(\"put %d ->%td\\n\", key, idx); dump_intmap(\"  \", hm, elemsize); }\n  }\n  dump_intmap(\"after-puts\", hm, elemsize);\n\n  for (int i = -3; i < 220; i += 7) {\n    int key = i;\n    hm = p_hmget_key(hm, elemsize, &key, sizeof(int), HM_BINARY);\n    void *raw = (char*) hm - elemsize;\n    printf(\"get %d -> %td\\n\", key, HDR(raw)->temp);\n  }\n\n  for (int i = 0; i < 60; i += 2) {\n    int key = (i * 7919) % 211;\n    ptrdiff_t t;\n    hm = p_hmget_key_ts(hm, elemsize, &key, sizeof(int), &t, HM_BINARY);\n    printf(\"get_ts %d -> %td\\n\", key, t);\n  }\n\n  for (int i = 0; i < 60; i += 3) {\n    int key = (i * 7919) % 211;\n    hm = p_hmdel_key(hm, elemsize, &key, sizeof(int), 0, HM_BINARY);\n    void *raw = (char*) hm - elemsize;\n    printf(\"del %d -> %td\\n\", key, HDR(raw)->temp);\n    if (i % 9 == 0) dump_intmap(\"  \", hm, elemsize);\n  }\n  dump_intmap(\"after-dels\", hm, elemsize);\n\n  /* delete everything remaining to force shrink paths */\n  for (int i = 0; i < 60; ++i) {\n    int key = (i * 7919) % 211;\n    hm = p_hmdel_key(hm, elemsize, &key, sizeof(int), 0, HM_BINARY);\n  }\n  dump_intmap(\"after-all-dels\", hm, elemsize);\n  p_hmfree_func((char*) hm - elemsize, elemsize);\n\n  /* hmdel on NULL */\n  printf(\"del-null=%d\\n\", p_hmdel_key(NULL, elemsize, NULL, 4, 0, HM_BINARY) == NULL);\n\n  /* hmput_default paths */\n  void *d = p_hmput_default(NULL, elemsize);\n  void *draw = (char*) d - elemsize;\n  printf(\"default len=%zu cap=%zu\\n\", HDR(draw)->length, HDR(draw)->capacity);\n  ((int*) draw)[0] = -1; ((int*) draw)[1] = -2;\n  void *d2 = p_hmput_default(d, elemsize);\n  printf(\"default2 same=%d len=%zu def=(%d,%d)\\n\", d2 == d, HDR((char*)d2-elemsize)->length,\n         ((int*)((char*)d2-elemsize))[0], ((int*)((char*)d2-elemsize))[1]);\n  int kk = 5;\n  d2 = p_hmput_key(d2, elemsize, &kk, sizeof(int), HM_BINARY);\n  dump_intmap(\"default3\", d2, elemsize);\n  p_hmfree_func((char*) d2 - elemsize, elemsize);\n\n  /* get / get_ts on NULL map */\n  void *g = p_hmget_key(NULL, elemsize, &kk, sizeof(int), HM_BINARY);\n  printf(\"get-null temp=%td len=%zu\\n\", HDR((char*)g-elemsize)->temp, HDR((char*)g-elemsize)->length);\n  p_hmfree_func((char*) g - elemsize, elemsize);\n  ptrdiff_t tt = 12345;\n  void *g2 = p_hmget_key_ts(NULL, elemsize, &kk, sizeof(int), &tt, HM_BINARY);\n  printf(\"get_ts-null temp=%td len=%zu\\n\", tt, HDR((char*)g2-elemsize)->length);\n  p_hmfree_func((char*) g2 - elemsize, elemsize);\n}\n\n/* large key struct, mode BINARY, keysize 8 */\nstatic void test_bigkey(void)\n{\n  puts(\"== big binary key ==\");\n  typedef struct { int key[2]; int b, c; } el;      /* elemsize 16, keysize 8 */\n  size_t elemsize = sizeof(el);\n  void *hm = NULL;\n  for (int i = 0; i < 40; ++i) {\n    int key[2] = { i, -i };\n    hm = p_hmput_key(hm, elemsize, key, sizeof key, HM_BINARY);\n    void *raw = (char*) hm - elemsize;\n    el *e = (el*) raw;\n    ptrdiff_t idx = HDR(raw)->temp;\n    e[idx+1].key[0] = key[0]; e[idx+1].key[1] = key[1];\n    e[idx+1].b = i; e[idx+1].c = i*i;\n  }\n  void *raw = (char*) hm - elemsize;\n  printf(\"bigkey len=%zu temp=%td\\n\", HDR(raw)->length, HDR(raw)->temp);\n  dump_table(\"bigkey\", raw);\n  for (int i = 0; i < 45; ++i) {\n    int key[2] = { i, -i };\n    hm = p_hmget_key(hm, elemsize, key, sizeof key, HM_BINARY);\n    printf(\"bget %d -> %td\\n\", i, HDR((char*)hm-elemsize)->temp);\n  }\n  for (int i = 0; i < 40; i += 4) {\n    int key[2] = { i, -i };\n    hm = p_hmdel_key(hm, elemsize, key, sizeof key, 0, HM_BINARY);\n    printf(\"bdel %d -> %td len=%zu\\n\", i, HDR((char*)hm-elemsize)->temp,\n           HDR((char*)hm-elemsize)->length);\n  }\n  dump_table(\"bigkey2\", (char*) hm - elemsize);\n  p_hmfree_func((char*) hm - elemsize, elemsize);\n}\n\nstatic const char *keytab(int i)\n{\n  static char b[64];\n  sprintf(b, \"key_%d_%s\", i, (i & 1) ? \"odd\" : \"even\");\n  return b;\n}\n\nstatic void test_strmap_default(void)\n{\n  puts(\"== str map (SH_DEFAULT) ==\");\n  size_t elemsize = 16;                      /* char *key; int value; (padded) */\n  void *hm = NULL;\n  static char keys[80][64];\n  for (int i = 0; i < 40; ++i) strcpy(keys[i], keytab(i));\n  for (int i = 0; i < 40; ++i) {\n    hm = p_hmput_key(hm, elemsize, keys[i], sizeof(char*), HM_STRING);\n    void *raw = (char*) hm - elemsize;\n    ptrdiff_t idx = HDR(raw)->temp;\n    *(int*)((char*) raw + elemsize*(idx+1) + sizeof(char*)) = i * 11;\n  }\n  dump_strmap(\"sput\", hm, elemsize);\n  /* re-put existing keys (exercises the temp_key path) */\n  for (int i = 0; i < 40; i += 5) {\n    hm = p_hmput_key(hm, elemsize, keys[i], sizeof(char*), HM_STRING);\n    void *raw = (char*) hm - elemsize;\n    hidx *t = (hidx*) HDR(raw)->hash_table;\n    printf(\"reput %s -> %td temp_key=\\\"%s\\\"\\n\", keys[i], HDR(raw)->temp, t->temp_key);\n  }\n  for (int i = 0; i < 45; ++i) {\n    char k[64]; strcpy(k, keytab(i));\n    hm = p_hmget_key(hm, elemsize, k, sizeof(char*), HM_STRING);\n    printf(\"sget %s -> %td\\n\", k, HDR((char*)hm-elemsize)->temp);\n  }\n  for (int i = 0; i < 40; i += 3) {\n    char k[64]; strcpy(k, keytab(i));\n    hm = p_hmdel_key(hm, elemsize, k, sizeof(char*), 0, HM_STRING);\n    printf(\"sdel %s -> %td len=%zu\\n\", k, HDR((char*)hm-elemsize)->temp,\n           HDR((char*)hm-elemsize)->length);\n  }\n  dump_strmap(\"after-sdel\", hm, elemsize);\n  p_hmfree_func((char*) hm - elemsize, elemsize);\n}\n\nstatic void test_strmap_mode(int mode, const char *name)\n{\n  printf(\"== str map (%s) ==\\n\", name);\n  size_t elemsize = 16;\n  void *hm = p_shmode_func(elemsize, mode);\n  dump_strmap(\"shmode\", hm, elemsize);\n  for (int i = 0; i < 50; ++i) {\n    char k[128];\n    /* mix short and very long keys to exercise both stralloc branches */\n    if (i % 7 == 0) sprintf(k, \"long_key_%d_%s\", i, \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\");\n    else            sprintf(k, \"k%d\", i);\n    hm = p_hmput_key(hm, elemsize, k, sizeof(char*), HM_STRING);\n    void *raw = (char*) hm - elemsize;\n    ptrdiff_t idx = HDR(raw)->temp;\n    *(int*)((char*) raw + elemsize*(idx+1) + sizeof(char*)) = i;\n    hidx *t = (hidx*) HDR(raw)->hash_table;\n    printf(\"put \\\"%s\\\" ->%td key=\\\"%s\\\" tk=\\\"%s\\\" arena{rem=%zu blk=%u}\\n\", k, idx,\n           *(char**)((char*) raw + elemsize*(idx+1)), t->temp_key,\n           t->string.remaining, (unsigned) t->string.block);\n  }\n  dump_strmap(\"modeput\", hm, elemsize);\n  for (int i = 0; i < 55; ++i) {\n    char k[128];\n    if (i % 7 == 0) sprintf(k, \"long_key_%d_%s\", i, \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\");\n    else            sprintf(k, \"k%d\", i);\n    hm = p_hmget_key(hm, elemsize, k, sizeof(char*), HM_STRING);\n    printf(\"get \\\"%s\\\" -> %td\\n\", k, HDR((char*)hm-elemsize)->temp);\n  }\n  for (int i = 0; i < 50; i += 4) {\n    char k[128];\n    if (i % 7 == 0) sprintf(k, \"long_key_%d_%s\", i, \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\");\n    else            sprintf(k, \"k%d\", i);\n    hm = p_hmdel_key(hm, elemsize, k, sizeof(char*), 0, HM_STRING);\n    printf(\"del \\\"%s\\\" -> %td len=%zu\\n\", k, HDR((char*)hm-elemsize)->temp,\n           HDR((char*)hm-elemsize)->length);\n  }\n  dump_strmap(\"modedel\", hm, elemsize);\n  p_hmfree_func((char*) hm - elemsize, elemsize);\n}\n\nstatic void test_arena(void)\n{\n  puts(\"== arena ==\");\n  sarena a; memset(&a, 0, sizeof a);\n  char *base = NULL;\n  for (int i = 0; i < 60; ++i) {\n    char buf[4096];\n    size_t n = (i % 9 == 8) ? (size_t)(600 + i * 37) : (size_t)(1 + (i * 13) % 40);\n    for (size_t k = 0; k < n; ++k) buf[k] = 'a' + (char)((i + k) % 26);\n    buf[n] = 0;\n    char *p = p_stralloc(&a, buf);\n    printf(\"alloc[%d] len=%zu rem=%zu blk=%u eq=%d newblock=%d\\n\", i, n, a.remaining,\n           (unsigned) a.block, strcmp(p, buf) == 0, base != (char*) a.storage);\n    base = (char*) a.storage;\n  }\n  p_strreset(&a);\n  printf(\"reset stor=%d rem=%zu blk=%u mode=%u\\n\", a.storage != NULL, a.remaining,\n         (unsigned) a.block, (unsigned) a.mode);\n  /* single huge string on an empty arena */\n  sarena b; memset(&b, 0, sizeof b);\n  char big[3000]; memset(big, 'z', sizeof big); big[sizeof big - 1] = 0;\n  char *q = p_stralloc(&b, big);\n  printf(\"huge eq=%d rem=%zu blk=%u\\n\", strcmp(q, big) == 0, b.remaining, (unsigned) b.block);\n  char *q2 = p_stralloc(&b, \"tail\");\n  printf(\"huge2 eq=%d rem=%zu blk=%u\\n\", strcmp(q2, \"tail\") == 0, b.remaining, (unsigned) b.block);\n  p_strreset(&b);\n  printf(\"reset2 stor=%d\\n\", b.storage != NULL);\n}\n\nstatic void test_misc(void)\n{\n  puts(\"== strkey ==\");\n  int ns[] = { 0, 1, 9, 10, 99, 100, 12345, -1, -42, 2147483647, -2147483648, 1000000 };\n  for (unsigned i = 0; i < sizeof(ns)/sizeof(ns[0]); ++i) {\n    char *s = p_strkey(ns[i]);\n    printf(\"strkey(%d)=\\\"%s\\\" len=%zu\\n\", ns[i], s, strlen(s));\n  }\n  /* same buffer returned every time? */\n  printf(\"strkey-stable=%d\\n\", p_strkey(1) == p_strkey(2));\n\n  puts(\"== intput ==\");\n  int vs[] = { 0, 1, 2, 3, 7, 8, 10, 12, 100, -1, -1000, 255, 65536, 2147483647, -2147483648 };\n  for (unsigned i = 0; i < sizeof(vs)/sizeof(vs[0]); ++i) {\n    p_intput(vs[i]);\n    printf(\"intput(%d) ok\\n\", vs[i]);\n  }\n\n  puts(\"== rand_seed ==\");\n  p_rand_seed(0x31415926);\n  size_t elemsize = 8;\n  void *hm = NULL;\n  int k = 4242;\n  hm = p_hmput_key(hm, elemsize, &k, sizeof(int), HM_BINARY);\n  dump_intmap(\"seeded\", hm, elemsize);\n  p_hmfree_func((char*) hm - elemsize, elemsize);\n  p_rand_seed(0);\n  hm = NULL;\n  hm = p_hmput_key(hm, elemsize, &k, sizeof(int), HM_BINARY);\n  dump_intmap(\"seeded0\", hm, elemsize);\n  p_hmfree_func((char*) hm - elemsize, elemsize);\n  p_rand_seed(~(size_t)0);\n  hm = NULL;\n  for (int i = 0; i < 20; ++i) { int kk = i; hm = p_hmput_key(hm, elemsize, &kk, sizeof(int), HM_BINARY); }\n  dump_intmap(\"seededmax\", hm, elemsize);\n  p_hmfree_func((char*) hm - elemsize, elemsize);\n  p_rand_seed(0x31415926);\n}\n\n#define SYM(v, n) do { *(void**)&v = dlsym(h, n); if (!v) { printf(\"missing %s\\n\", n); exit(2);} } while (0)\n\nint main(int argc, char **argv)\n{\n  void *h = dlopen(argv[1], RTLD_NOW | RTLD_LOCAL);\n  if (!h) { printf(\"dlopen failed: %s\\n\", dlerror()); return 1; }\n  SYM(p_arrgrowf, \"stbds_arrgrowf\");\n  SYM(p_arrfreef, \"stbds_arrfreef\");\n  SYM(p_rand_seed, \"stbds_rand_seed\");\n  SYM(p_hash_string, \"stbds_hash_string\");\n  SYM(p_hash_bytes, \"stbds_hash_bytes\");\n  SYM(p_hmget_key_ts, \"stbds_hmget_key_ts\");\n  SYM(p_hmget_key, \"stbds_hmget_key\");\n  SYM(p_hmput_default, \"stbds_hmput_default\");\n  SYM(p_shmode_func, \"stbds_shmode_func\");\n  SYM(p_hmdel_key, \"stbds_hmdel_key\");\n  SYM(p_stralloc, \"stbds_stralloc\");\n  SYM(p_hmput_key, \"stbds_hmput_key\");\n  SYM(p_strreset, \"stbds_strreset\");\n  SYM(p_hmfree_func, \"stbds_hmfree_func\");\n  SYM(p_strkey, \"strkey\");\n  SYM(p_intput, \"intput\");\n\n  test_hash_string();\n  test_hash_bytes();\n  test_arr();\n  test_intmap();\n  test_bigkey();\n  test_strmap_default();\n  test_strmap_mode(SH_STRDUP, \"SH_STRDUP\");\n  test_strmap_mode(SH_ARENA, \"SH_ARENA\");\n  test_strmap_mode(SH_NONE, \"SH_NONE\");\n  test_arena();\n  test_misc();\n  puts(\"DONE\");\n  return 0;\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":778,"cache_read_input_tokens":86695,"cache_creation":{"ephemeral_5m_input_tokens":778,"ephemeral_1h_input_tokens":0},"output_tokens":6,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"ef3f1378-8cf2-4998-925b-8abdca0d97d6","uuid":"f652b018-304b-402a-bb09-1ffd144f52fb","timestamp":"2026-08-20T03:34:12.057Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Cqf8wSTq1r5YBKFmrZtDg3","type":"tool_result","content":"File created successfully at: /local/home/scheschb/.harvest/work/harvest-translate-5kyuur/tmp/cbuild/difftest.c (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"ef3f1378-8cf2-4998-925b-8abdca0d97d6","uuid":"93d14e51-80f7-4982-9832-021f7ad7c2d6","timestamp":"2026-08-20T03:34:12.067Z","tool_use_result":{"type":"create","filePath":"/local/home/scheschb/.harvest/work/harvest-translate-5kyuur/tmp/cbuild/difftest.c","content":"/* Differential driver: dlopen ONE library (argv[1]) and print an exhaustive\n   trace of every exported entry point.  Run once per .so and diff the output. */\n#define _GNU_SOURCE\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stddef.h>\n#include <dlfcn.h>\n\ntypedef struct { size_t length, capacity; void *hash_table; ptrdiff_t temp; } hdr;\n#define HDR(p) (((hdr*)(p))-1)\n\ntypedef struct { void *storage; size_t remaining; unsigned char block, mode; } arena_t;\ntypedef struct {\n  char  *temp_key;\n  size_t slot_count, used_count, used_count_threshold, used_count_shrink_threshold;\n  size_t tombstone_count, tombstone_count_threshold, seed, slot_count_log2;\n  arena_t string;\n  void  *storage;\n} hidx;\ntypedef struct { size_t hash[8]; ptrdiff_t index[8]; } bucket;\n\ntypedef struct { void *storage; size_t remaining; unsigned char block, mode; } sarena;\n\nstatic void  *(*p_arrgrowf)(void*, size_t, size_t, size_t);\nstatic void   (*p_arrfreef)(void*);\nstatic void   (*p_rand_seed)(size_t);\nstatic size_t (*p_hash_string)(char*, size_t);\nstatic size_t (*p_hash_bytes)(void*, size_t, size_t);\nstatic void  *(*p_hmget_key_ts)(void*, size_t, void*, size_t, ptrdiff_t*, int);\nstatic void  *(*p_hmget_key)(void*, size_t, void*, size_t, int);\nstatic void  *(*p_hmput_default)(void*, size_t);\nstatic void  *(*p_shmode_func)(size_t, int);\nstatic void  *(*p_hmdel_key)(void*, size_t, void*, size_t, size_t, int);\nstatic char  *(*p_stralloc)(void*, char*);\nstatic void  *(*p_hmput_key)(void*, size_t, void*, size_t, int);\nstatic void   (*p_strreset)(void*);\nstatic void   (*p_hmfree_func)(void*, size_t);\nstatic char  *(*p_strkey)(int);\nstatic void   (*p_intput)(int);\n\n#define HM_BINARY 0\n#define HM_STRING 1\n#define SH_NONE 0\n#define SH_DEFAULT 1\n#define SH_STRDUP 2\n#define SH_ARENA 3\n\nstatic void dump_table(const char *tag, void *raw_a)\n{\n  hidx *t = raw_a ? (hidx*) HDR(raw_a)->hash_table : NULL;\n  if (!t) { printf(\"%s table=NULL\\n\", tag); return; }\n  printf(\"%s table slot_count=%zu log2=%zu used=%zu uct=%zu ucst=%zu tomb=%zu tct=%zu seed=%016zx\"\n         \" str{rem=%zu blk=%u mode=%u stor=%d}\\n\",\n         tag, t->slot_count, t->slot_count_log2, t->used_count, t->used_count_threshold,\n         t->used_count_shrink_threshold, t->tombstone_count, t->tombstone_count_threshold,\n         t->seed, t->string.remaining, (unsigned) t->string.block, (unsigned) t->string.mode,\n         t->string.storage != NULL);\n  bucket *b = (bucket*) t->storage;\n  for (size_t i = 0; i < (t->slot_count >> 3); ++i) {\n    printf(\"  b[%zu]\", i);\n    for (int j = 0; j < 8; ++j) printf(\" %016zx/%td\", b[i].hash[j], b[i].index[j]);\n    printf(\"\\n\");\n  }\n}\n\nstatic void dump_intmap(const char *tag, void *hm, size_t elemsize)\n{\n  if (!hm) { printf(\"%s map=NULL\\n\", tag); return; }\n  void *raw = (char*) hm - elemsize;\n  hdr *h = HDR(raw);\n  printf(\"%s len=%zu cap=%zu temp=%td elems:\", tag, h->length, h->capacity, h->temp);\n  int *e = (int*) raw;\n  for (size_t i = 0; i < h->length; ++i)\n    printf(\" (%d,%d)\", e[(elemsize/4)*i], e[(elemsize/4)*i + 1]);\n  printf(\"\\n\");\n  dump_table(tag, raw);\n}\n\nstatic void dump_strmap(const char *tag, void *hm, size_t elemsize)\n{\n  if (!hm) { printf(\"%s map=NULL\\n\", tag); return; }\n  void *raw = (char*) hm - elemsize;\n  hdr *h = HDR(raw);\n  printf(\"%s len=%zu cap=%zu temp=%td elems:\", tag, h->length, h->capacity, h->temp);\n  for (size_t i = 0; i < h->length; ++i) {\n    char *k = *(char**)((char*) raw + elemsize*i);\n    int   v = *(int*)((char*) raw + elemsize*i + sizeof(char*));\n    if (i == 0) printf(\" (<default>,%d)\", v);\n    else        printf(\" (\\\"%s\\\",%d)\", k ? k : \"(null)\", v);\n  }\n  printf(\"\\n\");\n  hidx *t = (hidx*) h->hash_table;\n  if (t) printf(\"%s temp_key=\\\"%s\\\"\\n\", tag, t->temp_key ? t->temp_key : \"(null)\");\n  dump_table(tag, raw);\n}\n\n/* ---------------------------------------------------------------- tests */\n\nstatic void test_hash_string(void)\n{\n  static const char *strs[] = { \"\", \"a\", \"b\", \"ab\", \"ba\", \"test_0\", \"test_1\", \"test_12345\",\n                                \"hello world\", \"\\x80\\xff\\x7f\", \"the quick brown fox jumps over the lazy dog\",\n                                \"\\xc3\\xa9\\xc3\\xa8\\xc3\\xaa\" };\n  size_t seeds[] = { 0, 1, 2, 0x31415926, 0xdeadbeefcafebabeULL, ~(size_t)0, 0x8000000000000000ULL };\n  puts(\"== hash_string ==\");\n  for (unsigned i = 0; i < sizeof(strs)/sizeof(strs[0]); ++i)\n    for (unsigned j = 0; j < sizeof(seeds)/sizeof(seeds[0]); ++j)\n      printf(\"hs[%u][%u]=%016zx\\n\", i, j, p_hash_string((char*) strs[i], seeds[j]));\n}\n\nstatic void test_hash_bytes(void)\n{\n  unsigned char buf[64];\n  size_t seeds[] = { 0, 1, 0x31415926, 0xdeadbeefcafebabeULL, ~(size_t)0 };\n  puts(\"== hash_bytes ==\");\n  for (unsigned pat = 0; pat < 4; ++pat) {\n    for (unsigned k = 0; k < sizeof(buf); ++k) {\n      switch (pat) {\n        case 0: buf[k] = (unsigned char)(k * 37 + 13); break;\n        case 1: buf[k] = 0xff; break;\n        case 2: buf[k] = 0x00; break;\n        default: buf[k] = (unsigned char)(k & 1 ? 0x80 : 0x01); break;\n      }\n    }\n    for (size_t len = 0; len <= 40; ++len)\n      for (unsigned j = 0; j < sizeof(seeds)/sizeof(seeds[0]); ++j)\n        printf(\"hb[%u][%zu][%u]=%016zx\\n\", pat, len, j, p_hash_bytes(buf, len, seeds[j]));\n  }\n  /* also hash ints, the way hmput does */\n  for (int v = -5; v < 40; ++v) {\n    int key = v;\n    printf(\"hbi[%d]=%016zx\\n\", v, p_hash_bytes(&key, sizeof key, 0x31415926));\n  }\n}\n\nstatic void test_arr(void)\n{\n  puts(\"== arrgrowf ==\");\n  struct { size_t elemsize, addlen, min_cap; } cases[] = {\n    {4,0,0},{4,0,1},{4,1,0},{4,1,1},{4,0,4},{4,0,5},{4,3,9},{8,0,1},{8,17,0},{16,1,100},{1,0,0}\n  };\n  for (unsigned i = 0; i < sizeof(cases)/sizeof(cases[0]); ++i) {\n    void *a = p_arrgrowf(NULL, cases[i].elemsize, cases[i].addlen, cases[i].min_cap);\n    printf(\"grow0[%u] len=%zu cap=%zu temp=%td ht=%d\\n\", i, HDR(a)->length, HDR(a)->capacity,\n           HDR(a)->temp, HDR(a)->hash_table != NULL);\n    /* regrow repeatedly */\n    for (unsigned r = 0; r < 6; ++r) {\n      HDR(a)->length = HDR(a)->capacity;      /* pretend it is full */\n      a = p_arrgrowf(a, cases[i].elemsize, 1, 0);\n      printf(\"  regrow[%u] len=%zu cap=%zu\\n\", r, HDR(a)->length, HDR(a)->capacity);\n    }\n    p_arrfreef(a);\n  }\n\n  /* emulate stbds_arrput of 300 ints */\n  int *arr = NULL;\n  for (int i = 0; i < 300; ++i) {\n    if (!arr || HDR(arr)->length + 1 > HDR(arr)->capacity)\n      arr = p_arrgrowf(arr, sizeof(int), 1, 0);\n    arr[HDR(arr)->length++] = i * i;\n  }\n  printf(\"arrput len=%zu cap=%zu sum=\", HDR(arr)->length, HDR(arr)->capacity);\n  long long sum = 0;\n  for (size_t i = 0; i < HDR(arr)->length; ++i) sum += arr[i];\n  printf(\"%lld first=%d last=%d\\n\", sum, arr[0], arr[299]);\n  p_arrfreef(arr);\n}\n\nstatic void test_intmap(void)\n{\n  puts(\"== int map ==\");\n  size_t elemsize = 8;\n  void *hm = NULL;\n  for (int i = 0; i < 60; ++i) {\n    int key = (i * 7919) % 211;\n    hm = p_hmput_key(hm, elemsize, &key, sizeof(int), HM_BINARY);\n    void *raw = (char*) hm - elemsize;\n    ptrdiff_t idx = HDR(raw)->temp;\n    ((int*) raw)[2*idx + 2] = key;          /* [idx].key   in hash space */\n    ((int*) raw)[2*idx + 3] = i * 3;        /* [idx].value in hash space */\n    if (i % 13 == 0 || i > 55) { printf(\"put %d ->%td\\n\", key, idx); dump_intmap(\"  \", hm, elemsize); }\n  }\n  dump_intmap(\"after-puts\", hm, elemsize);\n\n  for (int i = -3; i < 220; i += 7) {\n    int key = i;\n    hm = p_hmget_key(hm, elemsize, &key, sizeof(int), HM_BINARY);\n    void *raw = (char*) hm - elemsize;\n    printf(\"get %d -> %td\\n\", key, HDR(raw)->temp);\n  }\n\n  for (int i = 0; i < 60; i += 2) {\n    int key = (i * 7919) % 211;\n    ptrdiff_t t;\n    hm = p_hmget_key_ts(hm, elemsize, &key, sizeof(int), &t, HM_BINARY);\n    printf(\"get_ts %d -> %td\\n\", key, t);\n  }\n\n  for (int i = 0; i < 60; i += 3) {\n    int key = (i * 7919) % 211;\n    hm = p_hmdel_key(hm, elemsize, &key, sizeof(int), 0, HM_BINARY);\n    void *raw = (char*) hm - elemsize;\n    printf(\"del %d -> %td\\n\", key, HDR(raw)->temp);\n    if (i % 9 == 0) dump_intmap(\"  \", hm, elemsize);\n  }\n  dump_intmap(\"after-dels\", hm, elemsize);\n\n  /* delete everything remaining to force shrink paths */\n  for (int i = 0; i < 60; ++i) {\n    int key = (i * 7919) % 211;\n    hm = p_hmdel_key(hm, elemsize, &key, sizeof(int), 0, HM_BINARY);\n  }\n  dump_intmap(\"after-all-dels\", hm, elemsize);\n  p_hmfree_func((char*) hm - elemsize, elemsize);\n\n  /* hmdel on NULL */\n  printf(\"del-null=%d\\n\", p_hmdel_key(NULL, elemsize, NULL, 4, 0, HM_BINARY) == NULL);\n\n  /* hmput_default paths */\n  void *d = p_hmput_default(NULL, elemsize);\n  void *draw = (char*) d - elemsize;\n  printf(\"default len=%zu cap=%zu\\n\", HDR(draw)->length, HDR(draw)->capacity);\n  ((int*) draw)[0] = -1; ((int*) draw)[1] = -2;\n  void *d2 = p_hmput_default(d, elemsize);\n  printf(\"default2 same=%d len=%zu def=(%d,%d)\\n\", d2 == d, HDR((char*)d2-elemsize)->length,\n         ((int*)((char*)d2-elemsize))[0], ((int*)((char*)d2-elemsize))[1]);\n  int kk = 5;\n  d2 = p_hmput_key(d2, elemsize, &kk, sizeof(int), HM_BINARY);\n  dump_intmap(\"default3\", d2, elemsize);\n  p_hmfree_func((char*) d2 - elemsize, elemsize);\n\n  /* get / get_ts on NULL map */\n  void *g = p_hmget_key(NULL, elemsize, &kk, sizeof(int), HM_BINARY);\n  printf(\"get-null temp=%td len=%zu\\n\", HDR((char*)g-elemsize)->temp, HDR((char*)g-elemsize)->length);\n  p_hmfree_func((char*) g - elemsize, elemsize);\n  ptrdiff_t tt = 12345;\n  void *g2 = p_hmget_key_ts(NULL, elemsize, &kk, sizeof(int), &tt, HM_BINARY);\n  printf(\"get_ts-null temp=%td len=%zu\\n\", tt, HDR((char*)g2-elemsize)->length);\n  p_hmfree_func((char*) g2 - elemsize, elemsize);\n}\n\n/* large key struct, mode BINARY, keysize 8 */\nstatic void test_bigkey(void)\n{\n  puts(\"== big binary key ==\");\n  typedef struct { int key[2]; int b, c; } el;      /* elemsize 16, keysize 8 */\n  size_t elemsize = sizeof(el);\n  void *hm = NULL;\n  for (int i = 0; i < 40; ++i) {\n    int key[2] = { i, -i };\n    hm = p_hmput_key(hm, elemsize, key, sizeof key, HM_BINARY);\n    void *raw = (char*) hm - elemsize;\n    el *e = (el*) raw;\n    ptrdiff_t idx = HDR(raw)->temp;\n    e[idx+1].key[0] = key[0]; e[idx+1].key[1] = key[1];\n    e[idx+1].b = i; e[idx+1].c = i*i;\n  }\n  void *raw = (char*) hm - elemsize;\n  printf(\"bigkey len=%zu temp=%td\\n\", HDR(raw)->length, HDR(raw)->temp);\n  dump_table(\"bigkey\", raw);\n  for (int i = 0; i < 45; ++i) {\n    int key[2] = { i, -i };\n    hm = p_hmget_key(hm, elemsize, key, sizeof key, HM_BINARY);\n    printf(\"bget %d -> %td\\n\", i, HDR((char*)hm-elemsize)->temp);\n  }\n  for (int i = 0; i < 40; i += 4) {\n    int key[2] = { i, -i };\n    hm = p_hmdel_key(hm, elemsize, key, sizeof key, 0, HM_BINARY);\n    printf(\"bdel %d -> %td len=%zu\\n\", i, HDR((char*)hm-elemsize)->temp,\n           HDR((char*)hm-elemsize)->length);\n  }\n  dump_table(\"bigkey2\", (char*) hm - elemsize);\n  p_hmfree_func((char*) hm - elemsize, elemsize);\n}\n\nstatic const char *keytab(int i)\n{\n  static char b[64];\n  sprintf(b, \"key_%d_%s\", i, (i & 1) ? \"odd\" : \"even\");\n  return b;\n}\n\nstatic void test_strmap_default(void)\n{\n  puts(\"== str map (SH_DEFAULT) ==\");\n  size_t elemsize = 16;                      /* char *key; int value; (padded) */\n  void *hm = NULL;\n  static char keys[80][64];\n  for (int i = 0; i < 40; ++i) strcpy(keys[i], keytab(i));\n  for (int i = 0; i < 40; ++i) {\n    hm = p_hmput_key(hm, elemsize, keys[i], sizeof(char*), HM_STRING);\n    void *raw = (char*) hm - elemsize;\n    ptrdiff_t idx = HDR(raw)->temp;\n    *(int*)((char*) raw + elemsize*(idx+1) + sizeof(char*)) = i * 11;\n  }\n  dump_strmap(\"sput\", hm, elemsize);\n  /* re-put existing keys (exercises the temp_key path) */\n  for (int i = 0; i < 40; i += 5) {\n    hm = p_hmput_key(hm, elemsize, keys[i], sizeof(char*), HM_STRING);\n    void *raw = (char*) hm - elemsize;\n    hidx *t = (hidx*) HDR(raw)->hash_table;\n    printf(\"reput %s -> %td temp_key=\\\"%s\\\"\\n\", keys[i], HDR(raw)->temp, t->temp_key);\n  }\n  for (int i = 0; i < 45; ++i) {\n    char k[64]; strcpy(k, keytab(i));\n    hm = p_hmget_key(hm, elemsize, k, sizeof(char*), HM_STRING);\n    printf(\"sget %s -> %td\\n\", k, HDR((char*)hm-elemsize)->temp);\n  }\n  for (int i = 0; i < 40; i += 3) {\n    char k[64]; strcpy(k, keytab(i));\n    hm = p_hmdel_key(hm, elemsize, k, sizeof(char*), 0, HM_STRING);\n    printf(\"sdel %s -> %td len=%zu\\n\", k, HDR((char*)hm-elemsize)->temp,\n           HDR((char*)hm-elemsize)->length);\n  }\n  dump_strmap(\"after-sdel\", hm, elemsize);\n  p_hmfree_func((char*) hm - elemsize, elemsize);\n}\n\nstatic void test_strmap_mode(int mode, const char *name)\n{\n  printf(\"== str map (%s) ==\\n\", name);\n  size_t elemsize = 16;\n  void *hm = p_shmode_func(elemsize, mode);\n  dump_strmap(\"shmode\", hm, elemsize);\n  for (int i = 0; i < 50; ++i) {\n    char k[128];\n    /* mix short and very long keys to exercise both stralloc branches */\n    if (i % 7 == 0) sprintf(k, \"long_key_%d_%s\", i, \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\");\n    else            sprintf(k, \"k%d\", i);\n    hm = p_hmput_key(hm, elemsize, k, sizeof(char*), HM_STRING);\n    void *raw = (char*) hm - elemsize;\n    ptrdiff_t idx = HDR(raw)->temp;\n    *(int*)((char*) raw + elemsize*(idx+1) + sizeof(char*)) = i;\n    hidx *t = (hidx*) HDR(raw)->hash_table;\n    printf(\"put \\\"%s\\\" ->%td key=\\\"%s\\\" tk=\\\"%s\\\" arena{rem=%zu blk=%u}\\n\", k, idx,\n           *(char**)((char*) raw + elemsize*(idx+1)), t->temp_key,\n           t->string.remaining, (unsigned) t->string.block);\n  }\n  dump_strmap(\"modeput\", hm, elemsize);\n  for (int i = 0; i < 55; ++i) {\n    char k[128];\n    if (i % 7 == 0) sprintf(k, \"long_key_%d_%s\", i, \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\");\n    else            sprintf(k, \"k%d\", i);\n    hm = p_hmget_key(hm, elemsize, k, sizeof(char*), HM_STRING);\n    printf(\"get \\\"%s\\\" -> %td\\n\", k, HDR((char*)hm-elemsize)->temp);\n  }\n  for (int i = 0; i < 50; i += 4) {\n    char k[128];\n    if (i % 7 == 0) sprintf(k, \"long_key_%d_%s\", i, \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\");\n    else            sprintf(k, \"k%d\", i);\n    hm = p_hmdel_key(hm, elemsize, k, sizeof(char*), 0, HM_STRING);\n    printf(\"del \\\"%s\\\" -> %td len=%zu\\n\", k, HDR((char*)hm-elemsize)->temp,\n           HDR((char*)hm-elemsize)->length);\n  }\n  dump_strmap(\"modedel\", hm, elemsize);\n  p_hmfree_func((char*) hm - elemsize, elemsize);\n}\n\nstatic void test_arena(void)\n{\n  puts(\"== arena ==\");\n  sarena a; memset(&a, 0, sizeof a);\n  char *base = NULL;\n  for (int i = 0; i < 60; ++i) {\n    char buf[4096];\n    size_t n = (i % 9 == 8) ? (size_t)(600 + i * 37) : (size_t)(1 + (i * 13) % 40);\n    for (size_t k = 0; k < n; ++k) buf[k] = 'a' + (char)((i + k) % 26);\n    buf[n] = 0;\n    char *p = p_stralloc(&a, buf);\n    printf(\"alloc[%d] len=%zu rem=%zu blk=%u eq=%d newblock=%d\\n\", i, n, a.remaining,\n           (unsigned) a.block, strcmp(p, buf) == 0, base != (char*) a.storage);\n    base = (char*) a.storage;\n  }\n  p_strreset(&a);\n  printf(\"reset stor=%d rem=%zu blk=%u mode=%u\\n\", a.storage != NULL, a.remaining,\n         (unsigned) a.block, (unsigned) a.mode);\n  /* single huge string on an empty arena */\n  sarena b; memset(&b, 0, sizeof b);\n  char big[3000]; memset(big, 'z', sizeof big); big[sizeof big - 1] = 0;\n  char *q = p_stralloc(&b, big);\n  printf(\"huge eq=%d rem=%zu blk=%u\\n\", strcmp(q, big) == 0, b.remaining, (unsigned) b.block);\n  char *q2 = p_stralloc(&b, \"tail\");\n  printf(\"huge2 eq=%d rem=%zu blk=%u\\n\", strcmp(q2, \"tail\") == 0, b.remaining, (unsigned) b.block);\n  p_strreset(&b);\n  printf(\"reset2 stor=%d\\n\", b.storage != NULL);\n}\n\nstatic void test_misc(void)\n{\n  puts(\"== strkey ==\");\n  int ns[] = { 0, 1, 9, 10, 99, 100, 12345, -1, -42, 2147483647, -2147483648, 1000000 };\n  for (unsigned i = 0; i < sizeof(ns)/sizeof(ns[0]); ++i) {\n    char *s = p_strkey(ns[i]);\n    printf(\"strkey(%d)=\\\"%s\\\" len=%zu\\n\", ns[i], s, strlen(s));\n  }\n  /* same buffer returned every time? */\n  printf(\"strkey-stable=%d\\n\", p_strkey(1) == p_strkey(2));\n\n  puts(\"== intput ==\");\n  int vs[] = { 0, 1, 2, 3, 7, 8, 10, 12, 100, -1, -1000, 255, 65536, 2147483647, -2147483648 };\n  for (unsigned i = 0; i < sizeof(vs)/sizeof(vs[0]); ++i) {\n    p_intput(vs[i]);\n    printf(\"intput(%d) ok\\n\", vs[i]);\n  }\n\n  puts(\"== rand_seed ==\");\n  p_rand_seed(0x31415926);\n  size_t elemsize = 8;\n  void *hm = NULL;\n  int k = 4242;\n  hm = p_hmput_key(hm, elemsize, &k, sizeof(int), HM_BINARY);\n  dump_intmap(\"seeded\", hm, elemsize);\n  p_hmfree_func((char*) hm - elemsize, elemsize);\n  p_rand_seed(0);\n  hm = NULL;\n  hm = p_hmput_key(hm, elemsize, &k, sizeof(int), HM_BINARY);\n  dump_intmap(\"seeded0\", hm, elemsize);\n  p_hmfree_func((char*) hm - elemsize, elemsize);\n  p_rand_seed(~(