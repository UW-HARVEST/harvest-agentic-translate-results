x_keybytes\",\"crypto_ipcrypt_pfx_bytes\"};\n    for (unsigned i = 0; i < sizeof names / sizeof names[0]; i++) {\n        f0 f = (f0) S(names[i]);\n        printf(\"%s=%zu\\n\", names[i], f());\n    }\n\n    uint8_t k[32], in[32], out[32], back[32], t[16];\n    /* deterministic pseudo-random */\n    uint32_t s = 12345;\n#define NX() (s = s * 1103515245u + 12345u, (uint8_t) (s >> 16))\n\n    for (int iter = 0; iter < 40; iter++) {\n        for (int i = 0; i < 32; i++) { k[i] = NX(); in[i] = NX(); t[i] = NX(); }\n\n        if (iter % 4 == 1) { /* ipv4-mapped input */\n            memset(in, 0, 12); in[10] = 0xff; in[11] = 0xff;\n        }\n        if (iter % 8 == 3) { /* identical halves to trigger the diff==0 path */\n            memcpy(k + 16, k, 16);\n        }\n\n        memset(out, 0, sizeof out);\n        enc(out, in, k); ph(\"enc\", out, 16);\n        memset(back, 0, sizeof back);\n        dec(back, out, k); ph(\"encdec\", back, 16);\n\n        memset(out, 0, sizeof out);\n        ndenc(out, in, t, k); ph(\"ndenc\", out, 24);\n        memset(back, 0, sizeof back);\n        nddec(back, out, k); ph(\"nddec\", back, 16);\n\n        memset(out, 0, sizeof out);\n        ndxenc(out, in, t, k); ph(\"ndxenc\", out, 32);\n        memset(back, 0, sizeof back);\n        ndxdec(back, out, k); ph(\"ndxdec\", back, 16);\n\n        memset(out, 0, sizeof out);\n        pfxenc(out, in, k); ph(\"pfxenc\", out, 16);\n        memset(back, 0, sizeof back);\n        pfxdec(back, out, k); ph(\"pfxdec\", back, 16);\n    }\n    return 0;\n}\nEOF\ngcc -O1 -o $TMPDIR/ipcdiff $TMPDIR/ipcdiff.c -ldl && echo built","description":"Build differential test harness"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2651,"cache_read_input_tokens":80668,"cache_creation":{"ephemeral_5m_input_tokens":2651,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"to