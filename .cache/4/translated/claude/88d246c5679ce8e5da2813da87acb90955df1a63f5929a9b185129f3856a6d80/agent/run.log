h(stdout);\n        sodium_misuse();\n        printf(\"UNREACHABLE\\n\");\n        return 0;\n    }\n    if (strcmp(mode, \"misuse_noh\") == 0) {\n        FN(void, sodium_misuse, void);\n        printf(\"about-to-misuse\\n\"); fflush(stdout);\n        sodium_misuse();\n        printf(\"UNREACHABLE\\n\");\n        return 0;\n    }\n\n    static unsigned char a[4096], b[4096];\n    size_t i;\n\n    {\n        FN(int, randombytes_set_implementation, const void *);\n        num(\"set_impl\", randombytes_set_implementation(&DET));\n        /* NaCl alias: void randombytes(unsigned char *, unsigned long long) */\n        FN(void, randombytes, unsigned char *, unsigned long long);\n        memset(a, 0, 128);\n        randombytes(a, 64);\n        hex(\"nacl_randombytes\", a, 64);\n        randombytes(a, 0);\n        hex(\"nacl_randombytes0\", a, 8);\n    }\n\n    {\n        FN(int, crypto_scalarmult_curve25519_base, unsigned char *, const unsigned char *);\n        FN(int, crypto_scalarmult_curve25519, unsigned char *, const unsigned char *,\n              const unsigned char *);\n        unsigned char n[32], p[32];\n        for (i = 0; i < 10; i++) {\n            memset(n, (int) (i * 23 + 5), 32);\n            num(\"smcb\", crypto_scalarmult_curve25519_base(b, n));\n            hex(\"smcb\", b, 32);\n            memset(p, (int) (i * 7 + 1), 32);\n            num(\"smc\", crypto_scalarmult_curve25519(a, n, p));\n            hex(\"smc\", a, 32);\n        }\n        /* RFC 7748 vector */\n        {\n            static const unsigned char sk[32] = {\n                0x77,0x07,0x6d,0x0a,0x73,0x18,0xa5,0x7d,0x3c,0x16,0xc1,0x72,0x51,0xb2,\n                0x66,0x45,0xdf,0x4c,0x2f,0x87,0xeb,0xc0,0x99,0x2a,0xb1,0x77,0xfb,0xa5,\n                0x1d,0xb9,0x2c,0x2a };\n            crypto_scalarmult_curve25519_base(b, sk);\n            hex(\"rfc7748_pk\", b, 32);\n        }\n    }\n\n    /* _sodium_blake2b_init_param on a controlled 64-byte parameter block */\n    {\n        FN(int, _s