            crypto_hash_sha3512_final(st, b); hex(\"s3512stream\", b, 64);\n            }\n        }\n    }\n\n    /* ---------------- XOFs ---------------- */\n    {\n        const char *names[] = { \"shake128\", \"shake256\", \"turboshake128\", \"turboshake256\" };\n        for (int k = 0; k < 4; k++) {\n            char nm[128];\n            snprintf(nm, sizeof nm, \"crypto_xof_%s\", names[k]);\n            int (*one)(unsigned char *, size_t, const unsigned char *, size_t) =\n                (int (*)(unsigned char *, size_t, const unsigned char *, size_t)) S(nm);\n            snprintf(nm, sizeof nm, \"crypto_xof_%s_blockbytes\", names[k]);\n            size_t (*bb)(void) = (size_t (*)(void)) S(nm);\n            snprintf(nm, sizeof nm, \"crypto_xof_%s_statebytes\", names[k]);\n            size_t (*sb)(void) = (size_t (*)(void)) S(nm);\n            snprintf(nm, sizeof nm, \"crypto_xof_%s_domain_standard\", names[k]);\n            unsigned char (*ds)(void) = (unsigned char (*)(void)) S(nm);\n            snprintf(nm, sizeof nm, \"crypto_xof_%s_init\", names[k]);\n            int (*ini)(void *) = (int (*)(void *)) S(nm);\n            snprintf(nm, sizeof nm, \"crypto_xof_%s_init_with_domain\", names[k]);\n            int (*iwd)(void *, unsigned char) = (int (*)(void *, unsigned char)) S(nm);\n            snprintf(nm, sizeof nm, \"crypto_xof_%s_update\", names[k]);\n            int (*upd)(void *, const unsigned char *, size_t) =\n                (int (*)(void *, const unsigned char *, size_t)) S(nm);\n            snprintf(nm, sizeof nm, \"crypto_xof_%s_squeeze\", names[k]);\n            int (*sq)(void *, unsigned char *, size_t) =\n                (int (*)(void *, unsigned char *, size_t)) S(nm);\n            unum(\"bb\", bb()); unum(\"sb\", sb()); unum(\"ds\", ds());\n            reseed(55 + k);\n            size_t il[] = { 0, 1, 31, 135, 136, 137, 167, 168, 169, 300 };\n            size_t ol[] = { 1, 16, 32, 135, 136, 168, 169, 400 };\n            for (i = 0; i < size