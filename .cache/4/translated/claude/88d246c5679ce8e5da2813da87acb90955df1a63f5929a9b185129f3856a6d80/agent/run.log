, void *);\n        unsigned char key[32], rk[16 * 15];\n        for (i = 0; i < 32; i++) key[i] = (unsigned char) (i * 7 + 1);\n        memset(rk, 0, sizeof rk);\n        _sodium_softaes_expand_key128(key, rk);\n        hex(\"aes128rk\", rk, 16 * 11);\n        _sodium_softaes_invert_key_schedule128(rk);\n        hex(\"aes128rkinv\", rk, 16 * 11);\n        memset(rk, 0, sizeof rk);\n        _sodium_softaes_expand_key256(key, rk);\n        hex(\"aes256rk\", rk, 16 * 15);\n        _sodium_softaes_invert_key_schedule256(rk);\n        hex(\"aes256rkinv\", rk, 16 * 15);\n        /* block ops take/return a 16-byte SoftAesBlock by value (4 x uint32) */\n        typedef struct { uint32_t w[4]; } SB;\n        SB (*enc)(SB, SB)  = (SB (*)(SB, SB)) S(\"_sodium_softaes_block_encrypt\");\n        SB (*encl)(SB, SB) = (SB (*)(SB, SB)) S(\"_sodium_softaes_block_encryptlast\");\n        SB (*dec)(SB, SB)  = (SB (*)(SB, SB)) S(\"_sodium_softaes_block_decrypt\");\n        SB (*decl)(SB, SB) = (SB (*)(SB, SB)) S(\"_sodium_softaes_block_decryptlast\");\n        SB (*imc)(SB)      = (SB (*)(SB)) S(\"_sodium_softaes_inv_mix_columns\");\n        for (int t = 0; t < 6; t++) {\n            SB blk, rkb, o;\n            for (j = 0; j < 4; j++) {\n                blk.w[j] = (uint32_t) (0x01020304u * (t + 1) + (uint32_t) j);\n                rkb.w[j] = (uint32_t) (0x0a0b0c0du ^ (uint32_t) (t * 16 + j));\n            }\n            o = enc(blk, rkb);\n            printf(\"aesenc %08x%08x%08x%08x\\n\", o.w[0], o.w[1], o.w[2], o.w[3]);\n            o = encl(blk, rkb);\n            printf(\"aesencl %08x%08x%08x%08x\\n\", o.w[0], o.w[1], o.w[2], o.w[3]);\n            o = dec(blk, rkb);\n            printf(\"aesdec %08x%08x%08x%08x\\n\", o.w[0], o.w[1], o.w[2], o.w[3]);\n            o = decl(blk, rkb);\n            printf(\"aesdecl %08x%08x%08x%08x\\n\", o.w[0], o.w[1], o.w[2], o.w[3]);\n            o = imc(blk);\n            printf(\"aesimc %08x%08x%08x%08x\\n\", o.w[0], o.w[1], o.w[2], o.w[3]);\n        }\n    }\n\n    /* ---- keccak1600 ref internals + shake/turboshake ref internals ---- */\n    {\n        FN(void, _sodium_keccak1600_ref_init, void *);\n        FN(void, _sodium_keccak1600_ref_xor_bytes, void *, const unsigned char *, size_t,\n              size_t);\n        FN(void, _sodium_keccak1600_ref_extract_bytes, const void *, unsigned char *,\n              size_t, size_t);\n        FN(void, _sodium_keccak1600_ref_permute_24, void *);\n        FN(void, _sodium_keccak1600_ref_permute_12, void *);\n        unsigned char st[256];\n        memset(a, 0x8f, 200);\n        _sodium_keccak1600_ref_init(st);\n        _sodium_keccak1600_ref_xor_bytes(st, a, 5, 90);\n        _sodium_keccak1600_ref_permute_24(st);\n        _sodium_keccak1600_ref_extract_bytes(st, b, 0, 200); hex(\"kr24\", b, 200);\n        _sodium_keccak1600_ref_permute_12(st);\n        _sodium_keccak1600_ref_extract_bytes(st, b, 7, 100); hex(\"kr12\", b, 100);\n\n        const char *xs[] = { \"shake128\", \"shake256\", \"turboshake128\", \"turboshake256\" };\n        for (int q = 0; q < 4; q++) {\n            char nm[128];\n            snprintf(nm, sizeof nm, \"_sodium_%s_ref\", xs[q]);\n            int (*one)(unsigned char *, size_t, const unsigned char *, size_t) =\n                (int (*)(unsigned char *, size_t, const unsigned char *, size_t)) S(nm);\n            snprintf(nm, sizeof nm, \"_sodium_%s_ref_init\", xs[q]);\n            int (*ini)(void *) = (int (*)(void *)) S(nm);\n            snprintf(nm, sizeof nm, \"_sodium_%s_ref_init_with_domain\", xs[q]);\n            int (*iwd)(void *, unsigned char) = (int (*)(void *, unsigned char)) S(nm);\n            snprintf(nm, sizeof nm, \"_sodium_%s_ref_update\", xs[q]);\n            int (*upd)(void *, const unsigned char *, size_t) =\n                (int (*)(void *, const unsigned char *, size_t)) S(nm);\n            snprintf(nm, sizeof nm, \"_sodium_%s_ref_squeeze\", xs[q]);\n            int (*sq)(void *, unsigned char *, size_t) =\n                (int (*)(void *, unsigned char *, size_t)) S(nm);\n            unsigned char xst[512];\n            for (size_t il = 0; il <= 200; il += 67)\n                for (size_t ol = 16; ol <= 200; ol += 61) {\n                    memset(a, (int) (il + q), il);\n                    memset(b, 0, ol);\n                    num(\"xone\", one(b, ol, a, il)); hex(\"xone\", b, ol);\n                    num(\"xini\", ini(xst));\n                    upd(xst, a, il);\n                    memset(c, 0, ol);\n                    num(\"xsq\", sq(xst, c, ol)); hex(\"xsq\", c, ol);\n                    num(\"xmatch\", memcmp(b, c, ol) == 0);\n                    num(\"xiwd\", iwd(xst, 0x1f));\n                    upd(xst, a, il);\n                    memset(d, 0, ol);\n                    sq(xst, d, ol); hex(\"xdom\", d, ol);\n                    num(\"xupd_after\", upd(xst, a, 1));\n                }\n        }\n    }\n\n    /* ---- argon2 low-level ctx path ---- */\n    {\n        /* argon2_context layout (96 bytes) */\n        typedef struct {\n            uint8_t *out; uint32_t outlen;\n            uint8_t *pwd; uint32_t pwdlen;\n            uint8_t *salt; uint32_t saltlen;\n            uint8_t *secret; uint32_t secretlen;\n            uint8_t *ad; uint32_t adlen;\n            uint32_t t_cost, m_cost, lanes, threads;\n            uint32_t flags;\n        } a2ctx;\n        FN(int, _sodium_argon2_ctx, void *, int);\n        FN(int, _sodium_argon2_validate_inputs, const void *);\n        unsigned char out[64], pwd[16], salt[16];\n        memset(pwd, 0x11, 16); memset(salt, 0x22, 16);\n        for (int ty = 0; ty <= 2; ty++) {\n            a2ctx ctx;\n            memset(&ctx, 0, sizeof ctx);\n            ctx.out = out; ctx.outlen = 32;\n            ctx.pwd = pwd; ctx.pwdlen = 16;\n            ctx.salt = salt; ctx.saltlen = 16;\n            ctx.t_cost = 3; ctx.m_cost = 32; ctx.lanes = 1; ctx.threads = 1;\n            memset(out, 0, sizeof out);\n            num(\"a2vi\", _sodium_argon