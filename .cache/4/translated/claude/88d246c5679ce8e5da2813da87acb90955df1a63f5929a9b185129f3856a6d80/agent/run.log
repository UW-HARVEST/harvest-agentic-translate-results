");ph(n24,24);printf(\" %llu %zu \",(unsigned long long)ics64[ii],L);ph(out,L);printf(\"\\n\");\n      }\n      for(size_t ii=0;ii<sizeof ics32/sizeof*ics32;ii++){\n        crypto_stream_chacha20_ietf_ext_xor_ic(out,zero,L,n24,ics32[ii],key);\n        printf(\"i \");ph(key,32);printf(\" \");ph(n24,12);printf(\" %lu %zu \",(unsigned long)ics32[ii],L);ph(out,L);printf(\"\\n\");\n      }\n    }\n  }\n  return 0;\n}\nEOF\ngcc -O1 -o $TMPDIR/cc20test/t2 $TMPDIR/cc20test/t2.c $TMPDIR/tgt_cc20/release/libsodium.so -Wl,-rpath,$TMPDIR/tgt_cc20/release && $TMPDIR/cc20test/t2 > $TMPDIR/cc20test/vec.txt && wc -l $TMPDIR/cc20test/vec.txt\ncat > $TMPDIR/cc20test/chk.py <<'EOF'\nimport sys\nsys.path.insert(0,sys.argv[1])\nfrom ref import chacha20_ks, chacha20_ietf_ks, xchacha20_ks\nf={'c':chacha20_ks,'i':chacha20_ietf_ks,'x':xchacha20_ks}\nbad=0; tot=0\nfor line in open(sys.argv[2]):\n    m,k,n,ic,L,o=line.split()\n    exp=f[m](bytes.fromhex(k),bytes.fromhex(n),int(ic),int(L)).hex()\n    tot+=1\n    if exp!=o:\n        bad+=1\n        if bad<=5: print(\"MISMATCH\",m,ic,L,\"\\n exp\",exp,\"\\n got\",o)\nprint(\"total\",tot,\"bad\",bad)\nEOF\npython3 $TMPDIR/cc20test/chk.py $TMPDIR/cc20test $TMPDIR/cc20test/vec.txt","description":"Differential test vs Python reference"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2726,"cache_read_input_tokens":72318,"cache_creation":{"ephemeral_5m_input_tokens":2726,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_01RWArqxUD3XPKiCQLjtt3VA","session_id":"dbed778e-b40b-44c3-aae8-c706753ef0ef","uuid":"97511003-9c64-41fd-a156-7c7b0b07cbe4","timestamp":"2026-08-22T13:46:51.719Z","subagent_type":"general-purpose","task_description":"Translate chacha20 stream family"}
