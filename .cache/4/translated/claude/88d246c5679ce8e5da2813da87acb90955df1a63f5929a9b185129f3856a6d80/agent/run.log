= (skp)SYM(hc,\"crypto_kx_seed_keypair\"), b = (skp)SYM(hr,\"crypto_kx_seed_keypair\");\n        unsigned char seed[32], cpk1[32], csk1[32], cpk2[32], csk2[32];\n        unsigned char spk1[32], ssk1[32], spk2[32], ssk2[32], seed2[32];\n        for (int i=0;i<32;i++) { seed[i]=(unsigned char)(i*3+5); seed2[i]=(unsigned char)(200-i*5); }\n        cmpi(\"kx_seed_keypair c ret\", a(cpk1,csk1,seed), b(cpk2,csk2,seed));\n        cmpbuf(\"kx_seed pk\", cpk1, cpk2, 32); cmpbuf(\"kx_seed sk\", csk1, csk2, 32);\n        cmpi(\"kx_seed_keypair s ret\", a(spk1,ssk1,seed2), b(spk2,ssk2,seed2));\n        cmpbuf(\"kx_seed2 pk\", spk1, spk2, 32); cmpbuf(\"kx_seed2 sk\", ssk1, ssk2, 32);\n\n        ssk ck = (ssk)SYM(hc,\"crypto_kx_client_session_keys\"), rk = (ssk)SYM(hr,\"crypto_kx_client_session_keys\");\n        ssk cs = (ssk)SYM(hc,\"crypto_kx_server_session_keys\"), rs = (ssk)SYM(hr,\"crypto_kx_server_session_keys\");\n        unsigned char rx1[32], tx1[32], rx2[32], tx2[32];\n        cmpi(\"kx_client ret\", ck(rx1,tx1,cpk1,csk1,spk1), rk(rx2,tx2,cpk1,csk1,spk1));\n        cmpbuf(\"kx_client rx\", rx1, rx2, 32); cmpbuf(\"kx_client tx\", tx1, tx2, 32);\n        unsigned char srx1[32], stx1[32], srx2[32], stx2[32];\n        cmpi(\"kx_server ret\", cs(srx1,stx1,spk1,ssk1,cpk1), rs(srx2,stx2,spk1,ssk1,cpk1));\n        cmpbuf(\"kx_server rx\", srx1, srx2, 32); cmpbuf(\"kx_server tx\", stx1, stx2, 32);\n        /* cross-check the handshake actually agrees */\n        cmpbuf(\"kx agree rx/tx\", rx1, stx1, 32);\n        cmpbuf(\"kx agree tx/rx\", tx1, srx1, 32);\n        /* NULL rx */\n        unsigned char only1[32], only2[32];\n        cmpi(\"kx_client NULLrx ret\", ck(NULL,only1,cpk1,csk1,spk1), rk(NULL,only2,cpk1,csk1,spk1));\n        cmpbuf(\"kx_client NULLrx\", only1, only2, 32);\n        cmpi(\"kx_client NULLtx ret\", ck(only1,NULL,cpk1,csk1,spk1), rk(only2,NULL,cpk1,csk1,spk1));\n        cmpbuf(\"kx_client NULLtx\", only1, only2, 32);\n        cmpi(\"kx_server NULLrx ret\", cs(NULL,only1,spk1,ssk1,cpk1), rs(NULL,only2,spk1,ssk1,cpk1));\n        cmpbuf(\"kx_server NULLrx\", only1, only2, 32);\n        /* low-order point -> -1 */\n        unsigned char zero[32]; memset(zero,0,32);\n        cmpi(\"kx_client zero pk\", ck(rx1,tx1,cpk1,csk1,zero), rk(rx2,tx2,cpk1,csk1,zero));\n    }\n\n    /* ---- secretstream ---- */\n    {\n        typedef int (*ipull)(void*, const unsigned char*, const unsigned char*);\n        typedef int (*ipush)(void*, unsigned char*, const unsigned char*);\n        typedef int (*push_f)(void*, unsigned char*, unsigned long long*, const unsigned char*, unsigned long long, const unsigned char*, unsigned long long, unsigned char);\n        typedef int (*pull_f)(void*, unsigned char*, unsigned long long*, unsigned char*, const unsigned char*, unsigned long long, const unsigned char*, unsigned long long);\n        typedef void (*rekey_f)(void*);\n        ipull ipc = (ipull)SYM(hc,\"crypto_secretstream_xchacha20poly1305_init_pull\");\n        ipull ipr = (ipull)SYM(hr,\"crypto_secretstream_xchacha20poly1305_init_pull\");\n        push_f pc = (push_f)SYM(hc,\"crypto_secretstream_xchacha20poly1305_push\");\n        push_f pr = (push_f)SYM(hr,\"crypto_secretstream_xchacha20poly1305_push\");\n        pull_f puc = (pull_f)SYM(hc,\"crypto_secretstream_xchacha20poly1305_pull\");\n        pull_f pur = (pull_f)SYM(hr,\"crypto_secretstream_xchacha20poly1305_pull\");\n        rekey_f rc = (rekey_f)SYM(hc,\"crypto_secretstream_xchacha20poly1305_rekey\");\n        rekey_f rr = (rekey_f)SYM(hr,\"crypto_secretstream_xchacha20poly1305_rekey\");\n        ipush iuc = (ipush)SYM(hc,\"crypto_secretstream_xchacha20poly1305_init_push\");\n        ipush iur = (ipush)SYM(hr,\"crypto_secretstream_xchacha20poly1305_init_push\");\n\n        unsigned char header[24], k[32];\n        for (int i=0;i<24;i++) header[i]=(unsigned char)(i*11+3);\n        for (int i=0;i<32;i++) k[i]=(unsigned char)(i*13+9);\n        unsigned char st1[64], st2[64];\n        memset(st1,0xEE,sizeof st1); memset(st2,0xEE,sizeof st2);\n        cmpi(\"ss init_pull ret\", ipc(st1, header, k), ipr(st2, header, k));\n        cmpbuf(\"ss state after init_pull\", st1, st2, 52);\n        /* remaining bytes of the caller buffer must be untouched */\n        cmpbuf(\"ss state tail untouched\", st1+52, st2+52, 12);\n\n        /* rekey */\n        unsigned char rk1[64], rk2[64];\n        memcpy(rk1, st1, 64); memcpy(rk2, st2, 64);\n        rc(rk1); rr(rk2);\n        cmpbuf(\"ss state after rekey\", rk1, rk2, 52);\n\n        /* push a sequence of messages, various tags/lengths */\n        unsigned long long lens[] = {0,1,15,16,17,63,64,65,100,1000,4096};\n        unsigned char tags[] = {0x00, 0x01, 0x02, 0x03};\n        unsigned char ad[64]; for (int i=0;i<64;i++) ad[i]=(unsigned char)(i*5+1);\n        unsigned long long adlens[] = {0, 1, 15, 16, 33, 64};\n        unsigned char msg[4096]; for (size_t i=0;i<sizeof msg;i++) msg[i]=(unsigned char)(i*31+7);\n\n        for (unsigned t=0;t<4;t++) {\n          for (unsigned li=0;li<sizeof(lens)/sizeof(lens[0]);li++) {\n            for (unsigned ai=0;ai<sizeof(adlens)/sizeof(adlens[0]);ai++) {\n              unsigned char s1[64], s2[64];\n              ipc(s1, header, k); ipr(s2, header, k);\n              unsigned char c1[4200], c2[4200];\n              memset(c1,0xAA,sizeof c1); memset(c2,0xAA,sizeof c2);\n              unsigned long long ol1=12345, ol2=12345;\n              int r1 = pc(s1, c1, &ol1, msg, lens[li], adlens[ai]?ad:NULL, adlens[ai], tags[t]);\n              int r2 = pr(s2, c2, &ol2, msg, lens[li], adlens[ai]?ad:NULL, adlens[ai], tags[t]);\n              char nm[160]; snprintf(nm,sizeof nm,\"ss push tag=%u mlen=%llu adlen=%llu\", tags[t], lens[li], adlens[ai]);\n              cmpi(nm, r1, r2); cmpi(\"ss push outlen\", (long long)ol1, (long long)ol2);\n              cmpbuf(nm, c1, c2, sizeof c1);\n              cmpbuf(\"ss push state\", s1, s2, 52);\n\n              /* now pull it back with both */\n              unsigned char q1[64], q2[64];\n              ipc(q1, header, k); ipr(q2, header, k);\n              unsigned char m1[4200], m2[4200];\n              memset(m1,0xBB,sizeof m1); memset(m2,0xBB,sizeof m2);\n              unsigned long long ml1=999, ml2=999; unsigned char tg1=7, tg2=7;\n              int u1 = puc(q1, m1, &ml1, &tg1, c1, ol1, adlens[ai]?ad:NULL, adlens[ai]);\n              int u2 = pur(q2, m2, &ml2, &tg2, c2, ol2, adlens[ai]?ad:NULL, adlens[ai]);\n              cmpi(\"ss pull ret\", u1, u2); cmpi(\"ss pull mlen\", (long long)ml1, (long long)ml2);\n              cmpi(\"ss pull tag\", tg1, tg2);\n              cmpbuf(\"ss pull m\", m1, m2, sizeof m1);\n              cmpbuf(\"ss pull state\", q1, q2, 52);\n              if (u1 != 0) { printf(\"NOTE: pull failed for %s\\n\", nm); fails++; }\n              if (ml1 != lens[li] || memcmp(m1, msg, (size_t)lens[li]) != 0) { printf(\"NOTE: roundtrip bad for %s\\n\", nm); fails++; }\n\n              /* corrupted ciphertext -> -1 */\n              c1[0] ^= 0x80; c2[0] ^= 0x80;\n              ipc(q1, header, k); ipr(q2, header, k);\n              ml1=999; ml2=999; tg1=7; tg2=7;\n              u1 = puc(q1, m1, &ml1, &tg1, c1, ol1, adlens[ai]?ad:NULL, adlens[ai]);\n              u2 = pur(q2, m2, &ml2, &tg2, c2, ol2, adlens[ai]?ad:NULL, adlens[ai]);\n              cmpi(\"ss pull corrupt ret\", u1, u2); cmpi(\"ss pull corrupt mlen\", (long long)ml1, (long long)ml2);\n              cmpi(\"ss pull corrupt tag\", tg1, tg2);\n              cmpbuf(\"ss pull corrupt state\", q1, q2, 52);\n              c1[0] ^= 0x80; c2[0] ^= 0x80;\n            }\n          }\n        }\n\n        /* multi-message chain (exercises inonce evolution + auto rekey) */\n        {\n          unsigned char s1[64], s2[64];\n          ipc(s1, header, k); ipr(s2, header, k);\n          for (int n=0;n<200;n++) {\n            unsigned char c1[300], c2[300];\n            unsigned long long ol1, ol2;\n            unsigned char tag = (n%37==0) ? 0x02 : 0x00;\n            memset(c1,0,sizeof c1); memset(c2,0,sizeof c2);\n            pc(s1, c1, &ol1, msg, 100, ad, 16, tag);\n            pr(s2, c2, &ol2, msg, 100, ad, 16, tag);\n            cmpi(\"chain outlen\", (long long)ol1, (long long)ol2);\n            cmpbuf(\"chain c\", c1, c2, sizeof c1);\n            cmpbuf(\"chain state\", s1, s2, 52);\n          }\n        }\n\n        /* NULL outlen_p / mlen_p / tag_p paths */\n        {\n          unsigned char s1[64], s2[64], c1[200], c2[200], m1[200], m2[200];\n          ipc(s1, header, k); ipr(s2, header, k);\n          memset(c1,0,sizeof c1); memset(c2,0,sizeof c2);\n          pc(s1, c1, NULL, msg, 50, NULL, 0, 0); pr(s2, c2, NULL, msg, 50, NULL, 0, 0);\n          cmpbuf(\"ss push NULL outlen\", c1, c2, sizeof c1);\n          ipc(s1, header, k); ipr(s2, header, k);\n          memset(m1,0,sizeof m1); memset(m2,0,sizeof m2);\n          cmpi(\"ss pull NULL args\", puc(s1,m1,NULL,NULL,c1,67,NULL,0), pur(s2,m2,NULL,NULL,c2,67,NULL,0));\n          cmpbuf(\"ss pull NULL args m\", m1, m2, sizeof m1);\n          /* short input */\n          cmpi(\"ss pull short\", puc(s1,m1,NULL,NULL,c1,16,NULL,0), pur(s2,m2,NULL,NULL,c2,16,NULL,0));\n        }\n\n        /* init_push: header is random, but state must be a deterministic\n           function of (header, key) -- verify by feeding C's header into R's\n           init_pull and comparing to C's own state. */\n        {\n          unsigned char h1[24], s1[64], s2[64];\n          iuc(s1, h1, k);\n          ipr(s2, h1, k);\n          cmpbuf(\"init_push state == init_pull state\", s1, s2, 52);\n          unsigned char h2[24], s3[64], s4[64];\n          iur(s3, h2, k);\n          ipc(s4, h2, k);\n          cmpbuf(\"R init_push state == C init_pull state\", s3, s4, 52);\n        }\n    }\n\n    printf(fails == 0 ? \"ALL CHECKS PASSED\\n\" : \"%d FAILURES\\n\", fails);\n    return fails != 0;\n}\nEOF\ngcc -O1 -o $TMPDIR/diff $TMPDIR/diff.c -ldl && CLIB=$TMPDIR/cbuild/libsodium