 char*) = dlsym(h, \"crypto_onetimeauth_poly1305_final\");\n    size_t (*r_statebytes)(void) = dlsym(h, \"crypto_onetimeauth_poly1305_statebytes\");\n    int (*r_sip)(unsigned char*, const unsigned char*, unsigned long long, const unsigned char*) = dlsym(h, \"crypto_shorthash_siphash24\");\n    int (*r_sipx)(unsigned char*, const unsigned char*, unsigned long long, const unsigned char*) = dlsym(h, \"crypto_shorthash_siphashx24\");\n    impl_t *r_impl = dlsym(h, \"crypto_onetimeauth_poly1305_donna_implementation\");\n    if (!r_poly || !r_sip || !r_sipx || !r_impl || !r_statebytes) { printf(\"dlsym failed\\n\"); return 1; }\n    if (r_statebytes() != 256) { printf(\"statebytes mismatch: %zu\\n\", r_statebytes()); return 1; }\n\n    unsigned char buf[600], key[32];\n    unsigned char a[16], b[16], ax[16], bx[16];\n    int fails = 0;\n\n    /* RFC 8439 poly1305 vector */\n    {\n        const unsigned char k[32] = {\n            0x85,0xd6,0xbe,0x78,0x57,0x55,0x6d,0x33,0x7f,0x44,0x52,0xfe,0x42,0xd5,0x06,0xa8,\n            0x01,0x03,0x80,0x8a,0xfb,0x0d,0xb2,0xfd,0x4a,0xbf,0xf6,0xaf,0x41,0x49,0xf5,0x1b};\n        const char *m = \"Cryptographic Forum Research Group\";\n        const unsigned char want[16] = {\n            0xa8,0x06,0x1d,0xc1,0x30,0x51,0x36,0xc6,0xc2,0x2b,0x8b,0xaf,0x0c,0x01,0x27,0xa9};\n        r_poly(a, (const unsigned char*)m, 34, k);\n        if (memcmp(a, want, 16)) { printf(\"FAIL rfc8439 poly1305 vector\\n\"); fails++; }\n        else printf(\"ok rfc8439 poly1305 vector\\n\");\n    }\n    /* siphash24 reference vector for empty input, key 00..0f */\n    {\n        unsigned char k[16]; for (int i=0;i<16;i++) k[i]=i;\n        const unsigned char want[8] = {0x31,0x0e,0x0e,0xdd,0x47,0xdb,0x6f,0x72};\n        r_sip(a, (const unsigned char*)\"\", 0, k);\n        if (memcmp(a, want, 8)) { printf(\"FAIL siphash24 empty vector\\n\"); fails++; }\n        else printf(\"ok siphash24 empty vector\\n\");\n    }\n\n    for (int trial = 0; trial < 4000; trial++) {\n        size_t len = (size_t)(rng_s % 561);\n        rng_s ^= rng_s << 13; rng_s ^= rng_s >> 7; rng_s ^= rng_s << 17;\n        len = len % 561;\n        for (size_t i = 0; i < len; i++) buf[i] = rnd();\n        for (int i = 0; i < 32; i++) key[i] = rnd();\n\n        /* one-shot poly1305 */\n        ref_poly_impl.onetimeauth(a, buf, len, key);\n        r_poly(b, buf, len, key);\n        if (memcmp(a, b, 16)) { printf(\"FAIL poly oneshot len=%zu\\n\", len); fails++; }\n        /* verify */\n        int rv1 = ref_poly_impl.onetimeauth_verify(a, buf, len, key);\n        int rv2 = r_poly_verify(a, buf, len, key);\n        if (rv1 != rv2 || rv1 != 0) { printf(\"FAIL poly verify len=%zu %d %d\\n\", len, rv1, rv2); fails++; }\n        a[0] ^= 1;\n        rv1 = ref_poly_impl.onetimeauth_verify(a, buf, len, key);\n        rv2 = r_poly_verify(a, buf, len, key);\n        if (rv1 != rv2 || rv1 == 0) { printf(\"FAIL poly verify-neg len=%zu %d %d\\n\", len, rv1, rv2); fails++; }\n\n        /* incremental poly1305 with random chunking */\n        {\n            unsigned char cst[256] __attribute__((aligned(16)));\n            unsigned char rst[256] __attribute__((aligned(16)));\n            ref_poly_impl.onetimeauth_init(cst, key);\n            r_init(rst, key);\n            size_t off = 0;\n            while (off < len) {\n                size_t chunk = (size_t)rnd() % 40;\n                if (chunk > len - off) chunk = len - off;\n                if (chunk == 0) chunk = 1;\n                ref_poly_impl.onetimeauth_update(cst, buf + off, chunk);\n                r_update(rst, buf + off, chunk);\n                off += chunk;\n            }\n            ref_poly_impl.onetimeauth_final(cst, ax);\n            r_final(rst, bx);\n            if (memcmp(ax, bx, 16)) { printf(\"FAIL poly incr len=%zu\\n\", len); fails++; }\n            ref_poly_impl.onetimeauth(a, buf, len, key);\n            if (memcmp(ax, a, 16)) { printf(\"FAIL poly incr!=oneshot len=%zu\\n\", len); fails++; }\n            if (memcmp(cst, rst, 256)) { printf(\"FAIL poly state-after-final differs len=%zu\\n\", len); fails++; }\n        }\n\n        /* siphash24 / siphashx24 */\n        ref_siphash24(a, buf, len, key);\n        r_sip(b, buf, len, key);\n        if (memcmp(a, b, 8)) { printf(\"FAIL sip len=%zu\\n\", len); fails++; }\n        ref_siphashx24(ax, buf, len, key);\n        r_sipx(bx, buf, len, key);\n        if (memcmp(ax, bx, 16)) { printf(\"FAIL sipx len=%zu\\n\", len); fails++; }\n\n        if (fails > 8) break;\n    }\n    printf(\"%s (fails=%d)\\n\", fails ? \"FAILED\" : \"ALL PASS\", fails);\n    return fails != 0;\n}\nEOF\nsed -i \"s|SOPATH|$TMPDIR/tgt_poly3/release/libsodium.so|\" $TMPDIR/dt/main.c\ngcc -O2 -w -o $TMPDIR/dt/test $TMPDIR/dt/main.c $TMPDIR/dt/poly.o $TMPDIR/dt/sip.o $TMPDIR/dt/sipx.o $TMPDIR/dt/stubs.o -ldl && $TMPDIR/dt/test","description":"Run differential test vs C reference"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2521,"cache_read_input_tokens":89573,"cache_creation":{"ephemeral_5m_input_tokens":2521,"ephemeral_1h_input_tokens":0},"output_tokens":16,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_01TB8YJCU9EfLN38cxCF2xUz","session_id":"dbed778e-b40b-44c3-aae8-c706753ef0ef","uuid":"96f095c6-98d0-4c75-851e-5ed9d9ddfc4c","timestamp":"2026-08-22T13:49:01.920Z","subagent_type":"general-purpose","task_description":"Translate poly1305, siphash, hmac, auth"}
