ble_scalarmult_vartime(&mut r2, &a, &A, &b);\n        let mut got = [0u8;32]; ge25519_tobytes(&mut got, &r2);\n\n        if got != want {\n            println!(\"MISMATCH trial {}: got {} want {}\", trial, hex(&got), hex(&want));\n            std::process::exit(1);\n        }\n        // also: A must be on curve and in main subgroup\n        assert_eq!(ge25519_is_on_curve(&A), 1);\n        assert_eq!(ge25519_is_on_main_subgroup(&A), 1);\n        // scalarmult(a,B) == scalarmult_base(a)\n        let mut u1 = Ge25519P3::zeroed(); ge25519_scalarmult(&mut u1, &a, &B);\n        let mut u2 = Ge25519P3::zeroed(); ge25519_scalarmult_base(&mut u2, &a);\n        let mut h1=[0u8;32]; let mut h2=[0u8;32];\n        ge25519_p3_tobytes(&mut h1,&u1); ge25519_p3_tobytes(&mut h2,&u2);\n        assert_eq!(h1,h2, \"scalarmult mismatch trial {}\", trial);\n    }\n    println!(\"40/40 double_scalarmult_vartime + scalarmult trials OK\");\n\n    // edge: a = b = 0 -> identity\n    let z = [0u8;32];\n    let mut r0 = Ge25519P2::zeroed();\n    ge25519_double_scalarmult_vartime(&mut r0, &z, &B, &z);\n    let mut o=[0u8;32]; ge25519_tobytes(&mut o, &r0);\n    println!(\"0*B+0*B = {}\", hex(&o));\n    assert_eq!(o[0],1); for i in 1..32 { assert_eq!(o[i],0); }\n\n    // edge: all-ones scalars (exercises slide carry propagation to the top)\n    let f = [0xffu8;32];\n    let mut rf = Ge25519P2::zeroed();\n    ge25519_double_scalarmult_vartime(&mut rf, &f, &B, &f);\n    let mut of=[0u8;32]; ge25519_tobytes(&mut of, &rf);\n    // 2^256-1 = (2^255) + ... ; compare with repeated doubling reference\n    // reference: (2^256-1) * 2B computed by binary ladder using p3_add/p3p3_dbl\n    let mut acc = Ge25519P3::zeroed(); ge25519_p3_0(&mut acc);\n    let mut twoB = Ge25519P3::zeroed(); ge25519_p3_add(&mut twoB, &B, &B);\n    for _ in 0..256 {\n        let t = acc; ge25519_p3p3_dbl(&mut acc, &t);\n        let t2 = acc; ge25519_p3_add(&mut acc, &t2, &twoB);\n    }\n    // acc = (2^256-1)*2B\n    let mut wf=[