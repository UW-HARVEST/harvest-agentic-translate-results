mlen0 > 64U - crypto_secretbox_ZEROBYTES) {\n51\t        mlen0 = 64U - crypto_secretbox_ZEROBYTES;\n52\t    }\n53\t    for (i = 0U; i < mlen0; i++) {\n54\t        block0[i + crypto_secretbox_ZEROBYTES] = m[i];\n55\t    }\n56\t    crypto_stream_salsa20_xor(block0, block0, 64U, n + 16, subkey);\n57\t    COMPILER_ASSERT(crypto_secretbox_ZEROBYTES >=\n58\t                    crypto_onetimeauth_poly1305_KEYBYTES);\n59\t    crypto_onetimeauth_poly1305_init(&state, block0);\n60\t\n61\t    for (i = 0U; i < mlen0; i++) {\n62\t        c[i] = block0[crypto_secretbox_ZEROBYTES + i];\n63\t    }\n64\t    sodium_memzero(block0, sizeof block0);\n65\t\n66\t    crypto_onetimeauth_poly1305_update(&state, c, mlen0);\n67\t    {\n68\t        unsigned long long off = mlen0;\n69\t        uint64_t           ic  = 1U;\n70\t\n71\t        COMPILER_ASSERT(STREAM_POLY1305_CHUNK % 64U == 0U);\n72\t        while (off < mlen) {\n73\t            unsigned long long cl = mlen - off;\n74\t            if (cl > STREAM_POLY1305_CHUNK) {\n75\t                cl = STREAM_POLY1305_CHUNK;\n76\t            }\n77\t            crypto_stream_salsa20_xor_ic(c + off, m + off, cl,\n78\t                                         n + 16, ic, subkey);\n79\t            crypto_onetimeauth_poly1305_update(&state, c + off, cl);\n80\t            off += cl;\n81\t            ic += cl / 64U;\n82\t        }\n83\t    }\n84\t    sodium_memzero(subkey, sizeof subkey);\n85\t\n86\t    crypto_onetimeauth_poly1305_final(&state, mac);\n87\t    sodium_memzero(&state, sizeof state);\n88\t\n89\t    return 0;\n90\t}\n91\t\n92\tint\n93\tcrypto_secretbox_easy(unsigned char *c, const unsigned char *m,\n94\t                      unsigned long long mlen, const unsigned char *n,\n95\t                      const unsigned char *k)\n96\t{\n97\t    if (mlen > crypto_secretbox_MESSAGEBYTES_MAX) {\n98\t        sodium_misuse(); /* LCOV_EXCL_LINE */\n99\t    }\n100\t    return crypto_secretbox_detached(c + crypto_secretbox_MACBYTES,\n101\t                