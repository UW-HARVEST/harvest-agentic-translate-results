            _sodium_ge25519_double_scalarmult_vartime(p2, scal, p3b, scal2);\n                _sodium_ge25519_tobytes(a, p2); hex(\"gedsm\", a, 32);\n                _sodium_ge25519_p2_to_p3(p3, p2);\n                _sodium_ge25519_p3_tobytes(a, p3); hex(\"ge23\", a, 32);\n            }\n        }\n    }\n\n    /* ---- generichash blake2b aliases + internal blake2b ---- */\n    {\n        reseed(7);\n        FN(int, crypto_generichash_blake2b, unsigned char *, size_t, const unsigned char *,\n              unsigned long long, const unsigned char *, size_t);\n        FN(int, crypto_generichash_blake2b_init, void *, const unsigned char *, size_t, size_t);\n        FN(int, crypto_generichash_blake2b_init_salt_personal, void *,\n              const unsigned char *, size_t, size_t, const unsigned char *,\n              const unsigned char *);\n        FN(int, crypto_generichash_blake2b_update, void *, const unsigned char *,\n              unsigned long long);\n        FN(int, crypto_generichash_blake2b_final, void *, unsigned char *, size_t);\n        unsigned char st[512], salt[16], pers[16];\n        memset(salt, 0x3a, 16); memset(pers, 0x4b, 16);\n        for (size_t ol = 16; ol <= 64; ol += 16)\n            for (size_t il = 0; il <= 200; il += 50) {\n                memset(a, (int) (il + 7), il);\n                num(\"gb\", crypto_generichash_blake2b(b, ol, a, il, NULL, 0));\n                hex(\"gb\", b, ol);\n                num(\"gbi\", crypto_generichash_blake2b_init(st, NULL, 0, ol));\n                crypto_generichash_blake2b_update(st, a, il);\n                num(\"gbf\", crypto_generichash_blake2b_final(st, c, ol));\n                hex(\"gbf\", c, ol);\n                num(\"gbmatch\", memcmp(b, c, ol) == 0);\n                num(\"gbisp\", crypto_generichash_blake2b_init_salt_personal(st, NULL, 0, ol,\n                        salt, pers));\n                crypto_generichash_blake2b_update(st, a, il);\n                crypto_generichash_blake2b_final(st, d, ol);\n                hex(\"gbsp\", d, ol);\n            }\n        /* internal _sodium_blake2b* */\n        FN(int, _sodium_blake2b, unsigned char *, const void *, const void *, uint8_t,\n              uint8_t, uint64_t);\n        FN(int, _sodium_blake2b_init, void *, uint8_t);\n        FN(int, _sodium_blake2b_init_key, void *, uint8_t, const void *, uint8_t);\n        FN(int, _sodium_blake2b_init_salt_personal, void *, uint8_t, const void *,\n              const void *);\n        FN(int, _sodium_blake2b_init_key_salt_personal, void *, uint8_t, const void *,\n              uint8_t, const void *, const void *);\n        FN(int, _sodium_blake2b_update, void *, const uint8_t *, uint64_t);\n        FN(int, _sodium_blake2b_final, void *, uint8_t *, uint8_t);\n        FN(int, _sodium_blake2b_salt_personal, unsigned char *, const void *, const void *,\n              uint8_t, uint8_t, uint64_t, const void *, const void *);\n        FN(int, _sodium_blake2b_long, void *, size_t, const void *, size_t);\n        unsigned char bst[512];\n        for (size_t ol = 16; ol <= 64; ol += 16) {\n            memset(a, 0x5c, 100);\n            num(\"ib2\", _sodium_blake2b(b, a, NULL, (uint8_t) ol, 0, 100));\n            hex(\"ib2\", b, ol);\n            num(\"ib2i\", _sodium_blake2b_init(bst, (uint8_t) ol));\n            _sodium_blake2b_update(bst, a, 100);\n            num(\"ib2f\", _sodium_blake2b_final(bst, c, (uint8_t) ol));\n            hex(\"ib2f\", c, ol);\n            num(\"ib2match\", memcmp(b, c, ol) == 0);\n            memset(e, 0x1d, 32);\n            num(\"ib2ik\", _sodium_blake2b_init_key(bst, (uint8_t) ol, e, 32));\n            _sodium_blake2b_update(bst, a, 100);\n            _sodium_blake2b_final(bst, c, (uint8_t) ol);\n            hex(\"ib2k\", c, ol);\n            num(\"ib2isp\", _sodium_blake2b_init_salt_personal(bst, (uint8_t) ol, salt, pers));\n            _sodium_blake2b_update(bst, a, 100);\n            _sodium_blake2b_final(bst, c, (uint8_t) ol);\n            hex(\"ib2sp\", c, ol);\n            num(\"ib2iksp\", _sodium_blake2b_init_key_salt_personal(bst, (uint8_t) ol, e, 32,\n                    salt, pers));\n            _sodium_blake2b_update(bst, a, 100);\n            _sodium_blake2b_final(bst, c, (uint8_t) ol);\n            hex(\"ib2ksp\", c, ol);\n            num(\"ib2spf\", _sodium_blake2b_salt_personal(c, a, e, (uint8_t) ol, 32, 100,\n                    salt, pers));\n            hex(\"ib2spf\", c, ol);\n        }\n        for (size_t ol = 16; ol <= 200; ol += 46) {\n            memset(a, 0x6e, 77);\n            num(\"b2long\", _sodium_blake2b_long(b, ol, a, 77));\n            hex(\"b2long\", b, ol);\n        }\n        /* _sodium_blake2b_compress_ref via a state we control */\n        {\n            FN(void, _sodium_blake2b_compress_ref, void *, const uint8_t *);\n            unsigned char bs[512], block[128];\n            memset(block, 0x2f, 128);\n            _sodium_blake2b_init(bs, 64);\n            _sodium_blake2b_compress_ref(bs, block);\n            hex(\"b2compress\", bs, 64);\n        }\n    }\n\n    /* ---- onetimeauth poly1305 aliases ---- */\n    {\n        FN(int, crypto_onetimeauth_poly1305, unsigned char *, const unsigned char *,\n              unsigned long long, const unsigned char *);\n        FN(int, crypto_onetimeauth_poly1305_verify, const unsigned char *,\n              const unsigned char *, unsigned long long, const unsigned char *);\n        FN(int, crypto_onetimeauth_poly1305_init, void *, const unsigned char *);\n        FN(int, crypto_onetimeauth_poly1305_update, void *, const unsigned char *,\n              unsigned long long);\n        FN(int, crypto_onetimeauth_poly1305_final, void *, unsigned char *);\n        unsigned char k[32], st[512];\n        memset(k, 0x51, 32);\n        for (i = 0; i <= 200; i += 33) {\n            memset(a, (int) (i + 9), i);\n            num(\"p1\", crypto_onetimeauth_poly1305(b, a, i, k)); hex(\"p1\", b, 16);\n            num(\"p1v\", crypto_onetimeauth_poly1305_verify(b, a, i, k));\n            num(\"p1i\", crypto_onetimeauth_poly1305_init(st, k));\n            crypto_onetimeauth_poly1305_update(st, a, i);\n            num(\"p1f\", crypto_onetimeauth_poly1305_final(st, c)); hex(\"p1f\", c, 16);\n        }\n    }\n\n    /* ---- shorthash siphash24 alias ---- */\n    {\n        FN(int, crypto_shorthash_siphash24, unsigned char *, const unsigned char *,\n              unsigned long long, const unsigned char *);\n        unsigned char k[16];\n        memset(k, 0x62, 16);\n        for (i = 0; i <= 70; i += 7) {\n            memset(a, (int) i, i);\n            crypto_shorthash_siphash24(b, a, i, k); hex(\"sip\", b, 8);\n        }\n    }\n\n    /* ---- auth hmac aliases (verify + hmacsha512256 streaming) ---- */\n    {\n        FN(int, crypto_auth_verify, const unsigned char *, const unsigned char *,\n              unsigned long long, const unsigned char *);\n        FN(int, crypto_auth_hmacsha256_verify, const unsigned char *, const unsigned char *,\n              unsigned long long, const unsigned char *);\n        FN(int, crypto_auth_hmacsha512_verify, const unsigned char *, const unsigned char *,\n              unsigned long long, const unsigned char *);\n        FN(int, crypto_auth_hmacsha512256_verify, const unsigned char *,\n              const unsigned char *, unsigned long long, const unsigned char *);\n        FN(int, crypto_auth_hmacsha512256_init, void *, const unsigned char *, size_t);\n        FN(int, crypto_auth_hmacsha512256_update, void *, const unsigned char *,\n              unsigned long long);\n        FN(int, crypto_auth_hmacsha512256_final, void *, unsigned char *);\n        FN(int, crypto_auth_hmacsha256, unsigned char *, const unsigned char *,\n              unsigned long long, const unsigned char *);\n        FN(int, crypto_auth_hmacsha512, unsigned char *, const unsigned char *,\n              unsigned long long, const unsigned char *);\n        FN(int, crypto_auth_hmacsha512256, unsigned char *, const unsigned char *,\n              unsigned long long, const unsigned char *);\n        FN(int, crypto_auth, unsigned char *, const unsigned char *, unsigned long long,\n              const unsigned char *);\n        unsigned char k[32], st[1024];\n        memset(k, 0x73, 32);\n        for (i = 0; i <= 200; i += 41) {\n            memset(a, (int) (i + 3), i);\n            crypto_auth(b, a, i, k);              num(\"av\", crypto_auth_verify(b, a, i, k));\n            crypto_auth_hmacsha256(b, a, i, k);   hex(\"h256\", b, 32);\n            num(\"h256v\", crypto_auth_hmacsha256_verify(b, a, i, k));\n            crypto_auth_hmacsha512(b, a, i, k);   hex(\"h512\", b, 64);\n            num(\"h512v\", crypto_auth_hmacsha512_verify(b, a, i, k));\n            crypto_auth_hmacsha512256(b, a, i, k); hex(\"h512256\", b, 32);\n            num(\"h512256v\", crypto_auth_hmacsha512256_verify(b, a, i, k));\n            num(\"h512256i\", crypto_auth_hmacsha512256_init(st, k, 32));\n            crypto_auth_hmacsha512256_update(st, a, i);\n            num(\"h512256f\", crypto_auth_hmacsha512256_final(st, c));\n            hex(\"h512256s\", c, 32);\n        }\n    }\n\n    /* ---- kdf blake2b alias + hkdf streaming extract ---- */\n    {\n        FN(int, crypto_kdf_blake2b_derive_from_key, unsigned char *, size_t, uint64_t,\n              const char *, const unsigned char *);\n        unsigned char key[32];\n        memset(key, 0x84, 32);\n        for (uint64_t sid = 0; sid < 3; sid++)\n            for (size_t sl = 16; sl <= 64; sl += 24) {\n                errno = 0;\n                int r = crypto_kdf_blake2b_derive_from_key(b, sl, sid, \"ctxABCDE\", key);\n                printf(\"kdb sid=%llu sl=%zu r=%d errno=%d\\n\",\n                       (unsigned long long) sid, sl, r, errno);\n                hex(\"kdb\", b, sl);\n            }\n        FN(int, crypto_kdf_hkdf_sha256_extract_init, void *, const unsigned char *, size_t);\n        FN(int, crypto_kdf_hkdf_sha256_extract_update, void *, const unsigned char *, size_t);\n        FN(int, crypto_kdf_hkdf_sha256_extract_final, void *, unsigned char *);\n        FN(int, crypto_kdf_hkdf_sha512_extract_init, void *, const unsigned char *, size_t);\n        FN(int, crypto_kdf_hkdf_sha512_extract_update, void *, const unsigned char *, size_t);\n        FN(int, crypto_kdf_hkdf_sha512_extract_final, void *, unsigned char *);\n        unsigned char st[1024], salt[32], prk[64];\n        memset(salt, 0x95, 32);\n        memset(a, 0x26, 300);\n        num(\"hk2i\", crypto_kdf_hkdf_sha256_extract_init(st, salt, 32));\n        for (i = 0; i < 300; i += 29)\n            crypto_kdf_hkdf_sha256_extract_update(st, a + i, (300 - i < 29) ? 300 - i : 29);\n        num(\"hk2f\", crypto_kdf_hkdf_sha256_extract_final(st, prk));\n        hex(\"hk2prk\", prk, 32);\n        num(\"hk5i\", crypto_kdf_hkdf_sha512_extract_init(st, salt, 32));\n        for (i = 0; i < 300; i += 29)\n            crypto_kdf_hkdf_sha512_extract_update(st, a + i, (300 - i < 29) ? 300 - i : 29);\n        num(\"hk5f\", crypto_kdf_hkdf_sha512_extract_final(st, prk));\n        hex(\"hk5prk\", prk, 64);\n    }\n\n    /* ---- pwhash aliases + str (deterministic salt via our RNG) ---- */\n    {\n        reseed(8);\n        FN(int, crypto_pwhash_argon2i, unsigned char *, unsigned long long, const char *,\n              unsigned long long, const unsigned char *, unsigned long long, size_t, int);\n        FN(int, crypto_pwhash_argon2id, unsigned char *, unsigned long long, const char *,\n              unsigned long long, const unsigned char *, unsigned long long, size_t, int);\n        FN(int, crypto_pwhash_argon2i_str, char *, const char *, unsigned long long,\n              unsigned long long, size_t);\n        FN(int, crypto_pwhash_argon2id_str, char *, const char *, unsigned long long,\n              unsigned long long, size_t);\n        FN(int, crypto_pwhash_str, char *, const char *, unsigned long long,\n              unsigned long long, size_t);\n        FN(int, crypto_pwhash_str_alg, char *, const char *, unsigned long long,\n              unsigned long long, size_t, int);\n        FN(int, crypto_pwhash_argon2i_str_verify, const char *, const char *,\n              unsigned long long);\n        FN(int, crypto_pwhash_argon2id_str_verify, const char *, const char *,\n              unsigned long long);\n        FN(int, crypto_pwhash_argon2i_str_needs_rehash, const char *, unsigned long long,\n              size_t);\n        FN(int, crypto_pwhash_argon2id_str_needs_rehash, const char *, unsigned long long,\n              size_t);\n        FN(int, crypto_pwhash_scryptsalsa208sha256_str, char *, const char *,\n              unsigned long long, unsigned long long, size_t);\n        FN(int, crypto_pwhash_scryptsalsa208sha256_str_verify, const char *, const char *,\n              unsigned long long);\n        FN(int, crypto_pwhash_scryptsalsa208sha256_str_needs_rehash, const char *,\n              unsigned long long, size_t);\n        const char *pw = \"hunter2-hunter2\";\n        unsigned char salt[16];\n        memset(salt, 0x96, 16);\n        for (int alg = 1; alg <= 2; alg++) {\n            errno = 0;\n            num(\"pwa2i\", crypto_pwhash_argon2i(b, 32, pw, strlen(pw), salt, 3,\n                    8192 * 4, 1));\n            hex(\"pwa2i\", b, 32);\n            errno = 0;\n            num(\"pwa2id\", crypto_pwhash_argon2id(b, 32, pw, strlen(pw), salt, 3,\n                    8192 * 4, 2));\n            hex(\"pwa2id\", b, 32);\n            (void) alg;\n        }\n        num(\"pwistr\", crypto_pwhash_argon2i_str(sbuf, pw, strlen(pw), 3, 8192 * 4));\n        printf(\"pwistr=%s\\n\", sbuf);\n        num(\"pwistrv\", crypto_pwhash_argon2i_str_verify(sbuf, pw, strlen(pw)));\n        num(\"pwistrv_bad\", crypto_pwhash_argon2i_str_verify(sbuf, \"nope\", 4));\n        num(\"pwistr_nr\", crypto_pwhash_argon2i_str_needs_rehash(sbuf, 3, 8192 * 4));\n        num(\"pwistr_nr2\", crypto_pwhash_argon2i_str_needs_rehash(sbuf, 4, 8192 * 4));\n        num(\"pwidstr\", crypto_pwhash_argon2id_str(sbuf, pw, strlen(pw), 3, 8192 * 4));\n        printf(\"pwidstr=%s\\n\", sbuf);\n        num(\"pwidstrv\", crypto_pwhash_argon2id_str_verify(sbuf, pw, strlen(pw)));\n        num(\"pwidstr_nr\", crypto_pwhash_argon2id_str_needs_rehash(sbuf, 3, 8192 * 4));\n        num(\"pwstr\", crypto_pwhash_str(sbuf, pw, strlen(pw), 3, 8192 * 4));\n        printf(\"pwstr=%s\\n\", sbuf);\n        num(\"pwstralg\", crypto_pwhash_str_alg(sbuf, pw, strlen(pw), 3, 8192 * 4, 1));\n        printf(\"pwstralg=%s\\n\", sbuf);\n        num(\"scstr\", crypto_pwhash_scryptsalsa208sha256_str(sbuf, pw, strlen(pw),\n                32768, 16777216));\n        printf(\"scstr=%s\\n\", sbuf);\n        num(\"scstrv\", crypto_pwhash_scryptsalsa208sha256_str_verify(sbuf, pw, strlen(pw)));\n        num(\"scstrv_bad\", crypto_pwhash_scryptsalsa208sha256_str_verify(sbuf, \"x\", 1));\n        num(\"scstr_nr\", crypto_pwhash_scryptsalsa208sha256_str_needs_rehash(sbuf,\n                32768, 16777216));\n        /* argon2 low-level */\n        FN(int, _sodium_argon2_hash, uint32_t, uint32_t, uint32_t, const void *, size_t,\n              const void *, size_t, void *, size_t, char *, size_t, int, uint32_t);\n        FN(int, _sodium_argon2_verify, const char *, const void *, size_t, int);\n        FN(int, _sodium_argon2_encode_string, char *, size_t, void *, int);\n        num(\"a2h\", _sodium_argon2_hash(3, 32, 1, pw, strlen(pw), salt, 16, b, 32,\n                sbuf, sizeof sbuf, 0, 0x13));\n        hex(\"a2h\", b, 32);\n        printf(\"a2h_enc=%s\\n\", sbuf);\n        num(\"a2v\", _sodium_argon2_verify(sbuf, pw, strlen(pw), 0));\n        num(\"a2v_bad\", _sodium_argon2_verify(sbuf, \"zz\", 2, 0));\n        /* escrypt low-level */\n        FN(int, _sodium_escrypt_PBKDF2_SHA256, const uint8_t *, size_t, const uint8_t *,\n              size_t, uint64_t, uint8_t *, size_t);\n        for (uint64_t it = 1; it <= 3; it++)\n            for (size_t ol = 16; ol <= 80; ol += 32) {\n                num(\"pbkdf2\", _sodium_escrypt_PBKDF2_SHA256((const uint8_t *) pw,\n                        strlen(pw), salt, 16, it, b, ol));\n                hex(\"pbkdf2\", b, ol);\n            }\n        FN(int, _sodium_escrypt_init_local, void *);\n        FN(int, _sodium_escrypt_free_local, void *);\n        FN(int, _sodium_escrypt_alloc_region, void *, size_t);\n        FN(int, _sodium_escrypt_free_region, void *);\n        FN(uint8_t *, _sodium_escrypt_r, void *, const uint8_t *, size_t, const uint8_t *,\n              uint8_t *, size_t);\n        FN(uint8_t *, _sodium_escrypt_parse_setting, const uint8_t *, uint32_t *,\n              uint32_t *, uint32_t *);\n        FN(unsigned char *, _sodium_escrypt_gensalt_r, uint32_t, uint32_t, uint32_t,\n              const uint8_t *, size_t, uint8_t *, size_t);\n        FN(int, _sodium_escrypt_kdf_nosse, void *, const uint8_t *, size_t,\n              const uint8_t *, size_t, uint64_t, uint32_t, uint32_t, uint8_t *, size_t);\n        {\n            static unsigned char local[64], region[64];\n            memset(local, 0, sizeof local);\n            num(\"elocal\", _sodium_escrypt_init_local(local));\n            unsigned char setting[128], out[128];\n            memset(setting, 0, sizeof setting);\n            unsigned char *gp = _sodium_escrypt_gensalt_r(10, 8, 1, salt, 16,\n                    setting, sizeof setting);\n            printf(\"gensalt=%s\\n\", gp ? (char *) setting : \"(null)\");\n            uint32_t N_log2 = 0, r32 = 0, p32 = 0;\n            uint8_t *ps = _sodium_escrypt_parse_setting(setting, &N_log2, &r32, &p32);\n            printf(\"parse ok=%d N_log2=%u r=%u p=%u rest=%s\\n\", ps != NULL, N_log2, r32,\n                   p32, ps ? (const char *) ps : \"(null)\");\n            memset(out, 0, sizeof out);\n            uint8_t *rp = _sodium_escrypt_r(local, (const uint8_t *) pw, strlen(pw),\n                    setting, out, sizeof out);\n            pr