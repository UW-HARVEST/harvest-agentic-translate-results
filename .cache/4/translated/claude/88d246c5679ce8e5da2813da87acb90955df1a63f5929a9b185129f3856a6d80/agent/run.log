_negate_vartime, void *, const unsigned char *);\n        FN(int, crypto_sign_ed25519ph_init, void *);\n        FN(int, crypto_sign_ed25519ph_update, void *, const unsigned char *, unsigned long long);\n        FN(int, crypto_sign_ed25519ph_final_create, void *, unsigned char *,\n              unsigned long long *, const unsigned char *);\n        FN(int, crypto_sign_ed25519ph_final_verify, void *, const unsigned char *,\n              const unsigned char *);\n        FN(int, _crypto_sign_ed25519_detached, unsigned char *, unsigned long long *,\n              const unsigned char *, unsigned long long, const unsigned char *, int);\n        FN(int, _crypto_sign_ed25519_verify_detached, const unsigned char *,\n              const unsigned char *, unsigned long long, const unsigned char *, int);\n        FN(void, _crypto_sign_ed25519_ref10_hinit, void *, int);\n        unsigned char seed[32], pk[32], sk[64], sig[64], st[1024];\n        static unsigned char sm[2048];\n        unsigned long long smlen, mlen;\n        memset(seed, 0xa1, 32);\n        num(\"edskp\", crypto_sign_ed25519_seed_keypair(pk, sk, seed));\n        hex(\"edpk\", pk, 32); hex(\"edsk\", sk, 64);\n        for (i = 0; i <= 120; i += 40) {\n            memset(a, (int) (i + 1), i);\n            num(\"edsign\", crypto_sign_ed25519(sm, &smlen, a, i, sk));\n            unum(\"edsmlen\", smlen); hex(\"edsm\", sm, smlen);\n            num(\"edopen\", crypto_sign_ed25519_open(b, &mlen, sm, smlen, pk));\n            unum(\"edmlen\", mlen);\n            num(\"eddet\", crypto_sign_ed25519_detached(sig, &smlen, a, i, sk));\n            hex(\"edsig\", sig, 64);\n            num(\"edver\", crypto_sign_ed25519_verify_detached(sig, a, i, pk));\n            /* internal, prehashed=0 */\n            num(\"edidet\", _crypto_sign_ed25519_detached(sig, &smlen, a, i, sk, 0));\n            hex(\"edisig\", sig, 64);\n            num(\"ediver\", _crypto_sign_ed25519_verify_detached(sig, a, i, pk, 0));\n            /* ph */\n            num(\"phinit\", crypto_sign_ed25519ph_init(st));\n            crypto_sign_ed25519ph_update(st, a, i);\n            num(\"phcreate\", crypto_sign_ed25519ph_final_create(st, sig, &smlen, sk));\n            hex(\"phsig\", sig, 64);\n            crypto_sign_ed25519ph_init(st);\n            crypto_sign_ed25519ph_update(st, a, i);\n            num(\"phverify\", crypto_sign_ed25519ph_final_verify(st, sig, pk));\n        }\n        /* hinit transcript: hash the DOM2 prefix state by finalising it */\n        {\n            FN(int, crypto_hash_sha512_final, void *, unsigned char *);\n            unsigned char hs[512], out[64];\n            _crypto_sign_ed25519_ref10_hinit(hs, 0);\n            crypto_hash_sha512_final(hs, out); hex(\"hinit0\", out, 64);\n            _crypto_sign_ed25519_ref10_hinit(hs, 1);\n            crypto_hash_sha512_final(hs, out); hex(\"hinit1\", out, 64);\n        }\n        /* ge25519 negate_vartime + p2/p3 conversions + double_scalarmult */\n        {\n            FN(void, _sodium_ge25519_scalarmult_base, void *, const unsigned char *);\n            FN(void, _sodium_ge25519_scalarmult, void *, const unsigned char *, const void *);\n            FN(void, _sodium_ge25519_double_scalarmult_vartime, void *,\n                  const unsigned char *, const void *, const unsigned char *);\n            FN(void, _sodium_ge25519_tobytes, unsigned char *, const void *);\n            FN(void, _sodium_ge25519_p2_to_p3, void *, const void *);\n            FN(void, _sodium_ge25519_p3_tobytes, unsigned char *, const void *);\n            unsigned char p3[160], p3b[160], p2[120], scal[32], scal2[32];\n            for (i = 0; i < 8; i++) {\n                memset(scal, (int) (i * 31 + 3), 32); scal[31] &= 0x0f;\n                memset(scal2, (int) (i * 17 + 5), 32); scal2[31] &= 0x0f;\n                num(\"gefnv\", _sodium_ge25519_frombytes_negate_vartime(p3, pk));\n                _sodium_ge25519_p3_tobytes(a, p3); hex(\"gefnv_b\", a, 32);\n                _so