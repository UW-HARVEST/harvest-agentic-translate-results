 unsigned char *);\n        FN(void, _sodium_ge25519_p3_tobytes, unsigned char *, const void *);\n        FN(void, _sodium_ge25519_p3_add, void *, const void *, const void *);\n        FN(void, _sodium_ge25519_p3_sub, void *, const void *, const void *);\n        FN(void, _sodium_ge25519_scalarmult_base, void *, const unsigned char *);\n        FN(int, _sodium_ge25519_is_on_curve, const void *);\n        FN(int, _sodium_ge25519_is_on_main_subgroup, const void *);\n        FN(int, _sodium_ge25519_has_small_order, const void *);\n        FN(void, _sodium_ge25519_clear_cofactor, void *);\n        reseed(15001);\n        int32_t fe[10], fe2[10];\n        unsigned char p3[160], p3b[160], p3c[160];\n        for (i = 0; i < 60; i++) {\n            fill(a, 64);\n            memcpy(b, a, 64);\n            _sodium_sc25519_reduce(b); hex(\"scred\", b, 32);\n            num(\"sccan\", _sodium_sc25519_is_canonical(a));\n            _sodium_sc25519_mul(c, a, a + 32); hex(\"scmul\", c, 32);\n            _sodium_sc25519_muladd(c, a, a + 32, b); hex(\"scmuladd\", c, 32);\n            _sodium_sc25519_invert(c, b); hex(\"scinv\", c, 32);\n            _sodium_fe25519_frombytes(fe, a);\n            _sodium_fe25519_tobytes(c, fe); hex(\"fetb\", c, 32);\n            _sodium_fe25519_invert(fe2, fe);\n            _sodium_fe25519_tobytes(c, fe2); hex(\"feinv\", c, 32);\n            num(\"gecan\", _sodium_ge25519_is_canonical(a));\n            _sodium_ge25519_from_uniform(c, a); hex(\"gefu\", c, 32);\n            _sodium_ge25519_from_hash(c, a); hex(\"gefh\", c, 32);\n            _sodium_ristretto255_from_hash(c, a); hex(\"rifh\", c, 32);\n            num(\"rifb\", _sodium_ristretto255_frombytes(p3, c));\n            _sodium_ristretto255_p3_tobytes(d, p3); hex(\"ritb\", d, 32);\n            num(\"ritbmatch\", memcmp(c, d, 32) == 0);\n            /* group ops */\n            _sodium_ge25519_from_uniform(c, a);\n            num(\"gefb\", _sodium_ge25519_frombytes(p3, c));\n            _sodium_g