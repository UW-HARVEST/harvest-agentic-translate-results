pdate(\n412\t            &BlakeHash, (const uint8_t *) context->pwd, context->pwdlen);\n413\t\n414\t        /* LCOV_EXCL_START */\n415\t        if (context->flags & ARGON2_FLAG_CLEAR_PASSWORD) {\n416\t            sodium_memzero(context->pwd, context->pwdlen);\n417\t            context->pwdlen = 0;\n418\t        }\n419\t        /* LCOV_EXCL_STOP */\n420\t    }\n421\t\n422\t    STORE32_LE(value, context->saltlen);\n423\t    crypto_generichash_blake2b_update(&BlakeHash, value, sizeof(value));\n424\t\n425\t    if (context->salt != NULL) {\n426\t        crypto_generichash_blake2b_update(\n427\t            &BlakeHash, (const uint8_t *) context->salt, context->saltlen);\n428\t    }\n429\t\n430\t    STORE32_LE(value, context->secretlen);\n431\t    crypto_generichash_blake2b_update(&BlakeHash, value, sizeof(value));\n432\t\n433\t    /* LCOV_EXCL_START */\n434\t    if (context->secret != NULL) {\n435\t        crypto_generichash_blake2b_update(\n436\t            &BlakeHash, (const uint8_t *) context->secret, context->secretlen);\n437\t\n438\t        if (context->flags & ARGON2_FLAG_CLEAR_SECRET) {\n439\t            sodium_memzero(context->secret, context->secretlen);\n440\t            context->secretlen = 0;\n441\t        }\n442\t    }\n443\t    /* LCOV_EXCL_STOP */\n444\t\n445\t    STORE32_LE(value, context->adlen);\n446\t    crypto_generichash_blake2b_update(&BlakeHash, value, sizeof(value));\n447\t\n448\t    /* LCOV_EXCL_START */\n449\t    if (context->ad != NULL) {\n450\t        crypto_generichash_blake2b_update(\n451\t            &BlakeHash, (const uint8_t *) context->ad, context->adlen);\n452\t    }\n453\t    /* LCOV_EXCL_STOP */\n454\t\n455\t    crypto_generichash_blake2b_final(&BlakeHash, blockhash,\n456\t                                     ARGON2_PREHASH_DIGEST_LENGTH);\n457\t}\n458\t\n459\tint\n460\targon2_initialize(argon2_instance_t *instance, argon2_context *context)\n461\t{\n462\t    uint8_t blockhash[ARGON2_PREHASH_SEED_LENGTH];\n463\t    int     result = ARGON2_OK;\n464\t\n465\t    if (instance == NULL || context == NULL) {\n466\t        return ARGON2_INCORRECT_PARAMETER; /* LCOV_EXCL_LINE */\n467\t    }\n468\t\n469\t    /* 1. Memory allocation */\n470\t\n471\t    if ((instance->pseudo_rands = (uint64_t *)\n472\t         malloc(sizeof(uint64_t) * instance->segment_length)) == NULL) {\n473\t        return ARGON2_MEMORY_ALLOCATION_ERROR; /* LCOV_EXCL_LINE */\n474\t    }\n475\t\n476\t    result = allocate_memory(&(instance->region), instance->memory_blocks);\n477\t    if (ARGON2_OK != result) {\n478\t        argon2_free_instance(instance, context->flags); /* LCOV_EXCL_LINE */\n479\t        return result;                                   /* LCOV_EXCL_LINE */\n480\t    }\n481\t\n482\t    /* 2. Initial hashing */\n483\t    /* H_0 + 8 extra bytes to produce the first blocks */\n484\t    /* uint8_t blockhash[ARGON2_PREHASH_SEED_LENGTH]; */\n485\t    /* Hashing all inputs */\n486\t    argon2_initial_hash(blockhash, context, instance->type);\n487\t    /* Zeroing 8 extra bytes */\n488\t    sodium_memzero(blockhash + ARGON2_PREHASH_DIGEST_LENGTH,\n489\t                   ARGON2_PREHASH_SEED_LENGTH - ARGON2_PREHASH_DIGEST_LENGTH);\n490\t\n491\t    /* 3. Creating first blocks, we always have at least two blocks in a slice\n492\t     */\n493\t    argon2_fill_first_blocks(blockhash, instance);\n494\t    /* Clearing the hash */\n495\t    sodium_memzero(blockhash, ARGON2_PREHASH_SEED_LENGTH);\n496\t\n497\t    return ARGON2_OK;\n498\t}\n499\t\n500\tstatic int\n501\targon2_pick_best_implementation(void)\n502\t{\n503\t/* LCOV_EXCL_START */\n504\t#if defined(__wasm_simd128__)\n505\t    fill_segment = argon2_fill_segment_wasm32;\n506\t    return 0;\n507\t#endif\n508\t#if defined(HAVE_AVX512FINTRIN_H) && defined(HAVE_AVX2INTRIN_H) && \\\n509\t    defined(HAVE_TMMINTRIN_H) && defined(HAVE_SMMINTRIN_H)\n510\t    if (sodium_runtime_has_avx512f()) {\n511\t        fill_segment = argon2_fill_segment_avx512f;\n512\t        return 0;\n513\t    }\n514\t#endif\n515\t#if defined(HAVE_AVX2INTRIN_H) && defined(HAVE_TMMINTRIN_H) && \\\n516\t    defined(HAVE_SMMINTRIN_H)\n517\t    if (sodium_runtime_has_avx2()) {\n518\t        fill_segment = argon2_fill_segment_avx2;\n519\t        return 0;\n520\t    }\n521\t#endif\n522\t#if defined(HAVE_EMMINTRIN_H) && defined(HAVE_TMMINTRIN_H)\n523\t    if (sodium_runtime_has_ssse3()) {\n524\t        fill_segment = argon2_fill_segment_ssse3;\n525\t        return 0;\n526\t    }\n527\t#endif\n528\t#if (defined(__aarch64__) || defined(_M_ARM64)) && \\\n529\t    (defined(__ARM_NEON) || defined(__ARM_NEON__))\n530\t    fill_segment = argon2_fill_segment_neon;\n531\t#else\n532\t    fill_segment = argon2_fill_segment_ref;\n533\t#endif\n534\t\n535\t    return 0;\n536\t    /* LCOV_EXCL_STOP */\n537\t}\n538\t\n539\tint\n540\t_crypto_pwhash_argon2_pick_best_implementation(void)\n541\t{\n542\t    return argon2_pick_best_implementation();\n543\t}\n544\t"}]},"parent_tool_use_id":"toolu_bdrk_012qXuxFPUb5PcFa3QquyN5a","session_id":"dbed778e-b40b-44c3-aae8-c706753ef0ef","uuid":"15145af5-2f86-4e31-9e9c-3afa44571565","timestamp":"2026-08-22T13:50:16.159Z","subagent_type":"general-purpose","task_description":"Translate argon2 core"}
