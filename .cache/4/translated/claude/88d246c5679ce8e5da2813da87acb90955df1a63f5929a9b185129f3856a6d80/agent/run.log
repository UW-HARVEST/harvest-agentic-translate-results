tation uses */\n                int32_t v = (int32_t) ((i * 2654435761u + (unsigned) t * 40503u) % 33554432u);\n                p1p1[i] = ((i + t) & 1) ? -v : v;\n            }\n            memset(p2, 0, sizeof p2);\n            memset(p3, 0, sizeof p3);\n            _sodium_ge25519_p1p1_to_p2(p2, p1p1);\n            _sodium_ge25519_tobytes(b, p2);\n            hex(\"p1p1_p2\", b, 32);\n            hex(\"p1p1_p2raw\", (const unsigned char *) p2, sizeof p2);\n            _sodium_ge25519_p1p1_to_p3(p3, p1p1);\n            _sodium_ge25519_p3_tobytes(b, p3);\n            hex(\"p1p1_p3\", b, 32);\n            hex(\"p1p1_p3raw\", (const unsigned char *) p3, sizeof p3);\n        }\n    }\n\n    /* argon2 core internals, driven directly */\n    {\n        FN(int, _sodium_argon2_initialize, void *, void *);\n        FN(void, _sodium_argon2_fill_memory_blocks, void *, uint32_t);\n        FN(void, _sodium_argon2_fill_segment_ref, const void *, a2pos);\n        FN(void, _sodium_argon2_finalize, const void *, void *);\n        FN(int, _sodium_argon2_validate_inputs, const void *);\n        unsigned char out[64], pwd[16], salt[16];\n        memset(pwd, 0x33, 16); memset(salt, 0x44, 16);\n        for (uint32_t ty = 0; ty <= 2; ty += 2) {\n            a2ctx ctx;\n            a2inst inst;\n            memset(&ctx, 0, sizeof ctx);\n            memset(&inst, 0, sizeof inst);\n            ctx.out = out; ctx.outlen = 32;\n            ctx.pwd = pwd; ctx.pwdlen = 16;\n            ctx.salt = salt; ctx.saltlen = 16;\n            ctx.t_cost = 2; ctx.m_cost = 64; ctx.lanes = 1; ctx.threads = 1;\n            memset(out, 0, sizeof out);\n            num(\"vi\", _sodium_argon2_validate_inputs(&ctx));\n            /* mirror argon2_ctx()'s own instance setup */\n            uint32_t memory_blocks = ctx.m_cost;\n            if (memory_blocks < 8 * ctx.lanes) memory_blocks = 8 * ctx.lanes;\n            uint32_t segment_length = memory_blocks / (ctx.lanes * 4);\n            memory_blocks = segment_length * (ctx.lanes * 4);\n            inst.region = NULL;\n            inst.passes = ctx.t_cost;\n            inst.current_pass = 0;\n            inst.memory_blocks = memory_blocks;\n            inst.segment_length = segment_length;\n            inst.lane_length = segment_length * 4;\n            inst.lanes = ctx.lanes;\n            inst.threads = ctx.threads;\n            inst.type = ty;\n            inst.print_internals = 0;\n            num(\"a2init\", _sodium_argon2_initialize(&inst, &ctx));\n            printf(\"a2init_region_nonnull=%d\\n\", inst.region != NULL);\n            printf(\"a2init_pr_nonnull=%d\\n\", inst.pseudo_rands != NULL);\n            if (inst.region != NULL) {\n                /* one explicit fill_segment_ref call, then the rest via\n                 * fill_memory_blocks, then finalize */\n                a2pos pos;\n                pos.pass = 0; pos.lane = 0; pos.slice = 0; pos.index = 0;\n                _sodium_argon2_fill_segment_ref(&inst, pos);\n                _sodium_argon2_fill_memory_blocks(&inst, 0);\n                _sodium_argon2_fill_memory_blocks(&inst, 1);\n                _sodium_argon2_finalize(&ctx, &inst);\n                hex(\"a2raw\", out, 32);\n            }\n        }\n    }\n\n    printf(\"DONE3\\n\");\n    return FAILED_LOAD ? 3 : 0;\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
