{"type":"system","subtype":"task_notification","task_id":"bmxrrdmv0","tool_use_id":"toolu_bdrk_011o4rk3mrih3gv62wGHjN7z","status":"completed","output_file":"","summary":"set -e\nSC=$TMPDIR/gecheck2\nmkdir -p $SC/src/bin\ncat > $SC/src/bin/t.rs <<'EOF'\nuse gecheck2::ed25519_ref10::ge::*;\nuse gecheck2::ed25519_ref10::*;\n\nfn hex(b: &[u8;32]) -> String { b.iter().map(|x| format!(\"{:02x}\", x)).collect() }\n\nfn main() {\n    // B encoding\n    let mut bb = [0u8;32];\n    bb[0] = 0x58; for i in 1..32 { bb[i] = 0x66; }\n\n    // 1*B via scalarmult_base\n    let mut a = [0u8;32]; a[0] = 1;\n    let mut h = Ge25519P3::zeroed();\n    ge25519_scalarmult_base(&mut h, &a);\n    let mut out = [0u8;32];\n    ge25519_p3_tobytes(&mut out, &h);\n    println!(\"1*B          = {}\", hex(&out));\n    println!(\"expected     = {}\", hex(&bb));\n    assert_eq!(out, bb);\n\n    // frombytes round trip\n    let mut p = Ge25519P3::zeroed();\n    assert_eq!(ge25519_frombytes(&mut p, &bb), 0);\n    let mut o2 = [0u8;32];\n    ge25519_p3_tobytes(&mut o2, &p);\n    assert_eq!(o2, bb);\n    println!(\"frombytes roundtrip OK\");\n\n    // frombytes_negate_vartime gives -B\n    let mut pn = Ge25519P3::zeroed();\n    assert_eq!(ge25519_frombytes_negate_vartime(&mut pn, &bb), 0);\n    let mut negB = Ge25519P3::zeroed();\n    ge25519_p3_neg(&mut negB, &p);\n    let mut o3 = [0u8;32]; let mut o4 = [0u8;32];\n    ge25519_p3_tobytes(&mut o3, &pn);\n    ge25519_p3_tobytes(&mut o4, &negB);\n    assert_eq!(o3, o4);\n    println!(\"frombytes_negate_vartime OK ({} )\", hex(&o3));\n\n    // 2B three ways\n    let mut a2 = [0u8;32]; a2[0] = 2;\n    let mut s1 = Ge25519P3::zeroed(); ge25519_scalarmult_base(&mut s1, &a2);\n    let mut s2 = Ge25519P3::zeroed(); ge25519_scalarmult(&mut s2, &a2, &p);\n    let mut s3 = Ge25519P3::zeroed(); ge25519_p3_add(&mut s3, &p, &p);\n    let mut s4 = Ge25519P3::zeroed(); ge25519_p3p3_dbl(&mut s4, &p);\n    let mut e1=[0u8;32]; let mut e2=[0u8;32]; let mut e3=[0u8;32]; let mut e4=[0u8;32];\n    ge25519_p3_tobytes(&mut e1,&s1); ge25519_p3_tobytes(&mut e2,&s2);\n    ge25519_p3_tobytes(&mut e3,&s3); ge25519_p3_tobytes(&mut e4,&s4);\n    println!(\"2B = {} / {} / {} / {}\", hex(&e1), hex(&e2), hex(&e3), hex(&e4));\n    assert!(e1==e2 && e2==e3 && e3==e4);\n\n    // double_scalarmult_vartime: a=0, A=B, b=2  ->  2B\n    let zero = [0u8;32];\n    let mut r2 = Ge25519P2::zeroed();\n    ge25519_double_scalarmult_vartime(&mut r2, &zero, &p, &a2);\n    let mut e5=[0u8;32]; ge25519_tobytes(&mut e5, &r2);\n    println!(\"0*B+2*B = {}\", hex(&e5));\n    assert_eq!(e5, e1);\n\n    // double_scalarmult_vartime: a=7, A=B, b=13 -> 20B\n    let mut a7=[0u8;32]; a7[0]=7;\n    let mut b13=[0u8;32]; b13[0]=13;\n    let mut r3 = Ge25519P2::zeroed();\n    ge25519_double_scalarmult_vartime(&mut r3, &a7, &p, &b13);\n    let mut e6=[0u8;32]; ge25519_tobytes(&mut e6, &r3);\n    let mut a20=[0u8;32]; a20[0]=20;\n    let mut s20 = Ge25519P3::zeroed(); ge25519_scalarmult_base(&mut s20, &a20);\n    let mut e7=[0u8;32]; ge25519_p3_tobytes(&mut e7, &s20);\n    println!(\"7B+13B = {} vs 20B = {}\", hex(&e6), hex(&e7));\n    assert_eq!(e6, e7);\n\n    // random-ish scalar: scalarmult_base(a) == scalarmult(a, B)\n    let mut ar = [0u8;32];\n    for i in 0..32 { ar[i] = (i as u8).wrapping_mul(37).wrapping_add(11); }\n    ar[31] &= 127;\n    let mut x1 = Ge25519P3::zeroed(); ge25519_scalarmult_base(&mut x1, &ar);\n    let mut x2 = Ge25519P3::zeroed(); ge25519_scalarmult(&mut x2, &ar, &p);\n    let mut f1=[0u8;32]; let mut f2=[0u8;32];\n    ge25519_p3_tobytes(&mut f1,&x1); ge25519_p3_tobytes(&mut f2,&x2);\n    println!(\"rand: {} vs {}\", hex(&f1), hex(&f2));\n    assert_eq!(f1,f2);\n\n    // p3_sub\n    let mut d = Ge25519P3::zeroed();\n    ge25519_p3_sub(&mut d, &s3, &p);   // 2B - B = B\n    let mut g1=[0u8;32]; ge25519_p3_tobytes(&mut g1,&d);\n    assert_eq!(g1, bb);\n    println!(\"p3_sub OK\");\n\n    // predicates\n    assert_eq!(ge25519_is_on_curve(&p), 1);\n    assert_eq!(ge25519_is_on_main_subgroup(&p), 1);\n    assert_eq!(ge25519_has_small_order(&p), 0);\n    assert_eq!(ge25519_is_canonical(&bb), 1);\n    println!(\"predicates OK\");\n\n    // mul_l(B) == identity\n    let mut lb = Ge25519P3::zeroed();\n    ge25519_mul_l(&mut lb, &p);\n    let mut i1=[0u8;32]; ge25519_p3_tobytes(&mut i1,&lb);\n    println!(\"l*B = {}\", hex(&i1));\n    assert_eq!(i1[0], 1);\n    for k in 1..32 { assert_eq!(i1[k], 0); }\n\n    // small-order point: the order-4 point (0, sqrt(-1)) encodes as ...\n    // y = 0 -> encoding 0x00.. ; is_on_curve? check has_small_order for identity\n    let mut id = Ge25519P3::zeroed(); ge25519_p3_0(&mut id);\n    assert_eq!(ge25519_has_small_order(&id), 1);\n    println!(\"has_small_order(identity) = 1 OK\");\n\n    // non-canonical encodings\n    let mut nc = [0xffu8;32]; nc[31] = 0x7f;   // 2^255-1 -> not canonical\n    assert_eq!(ge25519_is_canonical(&nc), 0);\n    let mut nc2 = [0xffu8;32]; nc2[0]=0xed; nc2[31]=0x7f; // p itself\n    assert_eq!(ge25519_is_canonical(&nc2), 0);\n    let mut c1 = [0u8;32]; c1[0]=0xec; for i in 1..31 {c1[i]=0xff;} c1[31]=0x7f; // p-1 canonical\n    assert_eq!(ge25519_is_canonical(&c1), 1);\n    println!(\"is_canonical OK\");\n\n    // ge25519_p3_dbladd: r*(2^n)+q\n    let mut dd = p;\n    ge25519_p3_dbladd(&mut dd, 3, &p);  // 8B + B = 9B\n    let mut a9=[0u8;32]; a9[0]=9;\n    let mut s9 = Ge25519P3::zeroed(); ge25519_scalarmult_base(&mut s9, &a9);\n    let mut h1=[0u8;32]; let mut h2=[0u8;32];\n    ge25519_p3_tobytes(&mut h1,&dd); ge25519_p3_tobytes(&mut h2,&s9);\n    println!(\"dbladd: {} vs 9B {}\", hex(&h1), hex(&h2));\n    assert_eq!(h1,h2);\n\n    // ge25519_p3_to_precomp / add_precomp consistency\n    let mut pc = Ge25519Precomp::zeroed();\n    ge25519_p3_to_precomp(&mut pc, &p);\n    let mut r1p = Ge25519P1p1::zeroed();\n    ge25519_add_precomp(&mut r1p, &p, &pc);\n    let mut yy = Ge25519P3::zeroed();\n    ge25519_p1p1_to_p3(&mut yy, &r1p);\n    let mut k1=[0u8;32]; ge25519_p3_tobytes(&mut k1,&yy);\n    assert_eq!(k1, e1); // 2B\n    let mut r1m = Ge25519P1p1::zeroed();\n    ge25519_sub_precomp(&mut r1m, &p, &pc);\n    let mut zz = Ge25519P3::zeroed();\n    ge25519_p1p1_to_p3(&mut zz, &r1m);\n    let mut k2=[0u8;32]; ge25519_p3_tobytes(&mut k2,&zz);\n    assert_eq!(k2[0], 1);\n    println!(\"precomp add/sub OK\");\n\n    // cached add/sub\n    let mut cc = Ge25519Cached::zeroed();\n    ge25519_p3_to_cached(&mut cc, &p);\n    let mut rc = Ge25519P1p1::zeroed();\n    ge25519_add_cached(&mut rc, &p, &cc);\n    let mut y2 = Ge25519P3::zeroed(); ge25519_p1p1_to_p3(&mut y2, &rc);\n    let mut k3=[0u8;32]; ge25519_p3_tobytes(&mut k3,&y2);\n    assert_eq!(k3, e1);\n    let mut rc2 = Ge25519P1p1::zeroed();\n    ge25519_sub_cached(&mut rc2, &p, &cc);\n    let mut y3 = Ge25519P3::zeroed(); ge25519_p1p1_to_p3(&mut y3, &rc2);\n    let mut k4=[0u8;32]; ge25519_p3_tobytes(&mut k4,&y3);\n    assert_eq!(k4[0], 1);\n    println!(\"cached add/sub OK\");\n\n    // p2_to_p3 / p3_to_p2\n    let mut pp2 = Ge25519P2::zeroed(); ge25519_p3_to_p2(&mut pp2, &p);\n    let mut pp3 = Ge25519P3::zeroed(); ge25519_p2_to_p3(&mut pp3, &pp2);\n    let mut k5=[0u8;32]; ge25519_p3_tobytes(&mut k5,&pp3);\n    assert_eq!(k5, bb);\n    println!(\"p2<->p3 OK\");\n\n    println!(\"ALL OK\");\n}\nEOF\ncd $SC && CARGO_TARGET_DIR=$TMPDIR/tgt_gecheck2 cargo run --release --bin t 2>&1 | tail -40","uuid":"d03f61b4-d87e-43c6-bf43-85f87423ce1b","session_id":"dbed778e-b40b-44c3-aae8-c706753ef0ef"}
