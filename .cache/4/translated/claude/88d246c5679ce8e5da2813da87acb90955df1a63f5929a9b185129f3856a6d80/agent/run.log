{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_015LDySLNMisMcuTnggrx6HF","type":"tool_result","content":"1\t//! Translation of `include/sodium/private/common.h` helpers plus small shared\n2\t//! utilities used across the crate.\n3\t//!\n4\t//! The reference build defines no `NATIVE_LITTLE_ENDIAN` / `NATIVE_BIG_ENDIAN`\n5\t//! macros, so the byte-shuffling fallbacks are used.  On any target these\n6\t//! produce identical results to the memcpy paths on a little-endian machine.\n7\t\n8\t#[inline(always)]\n9\tpub fn rotl32(x: u32, b: i32) -> u32 {\n10\t    (x << b) | (x >> (32 - b))\n11\t}\n12\t\n13\t#[inline(always)]\n14\tpub fn rotl64(x: u64, b: i32) -> u64 {\n15\t    (x << b) | (x >> (64 - b))\n16\t}\n17\t\n18\t#[inline(always)]\n19\tpub fn rotr32(x: u32, b: i32) -> u32 {\n20\t    (x >> b) | (x << (32 - b))\n21\t}\n22\t\n23\t#[inline(always)]\n24\tpub fn rotr64(x: u64, b: i32) -> u64 {\n25\t    (x >> b) | (x << (64 - b))\n26\t}\n27\t\n28\t#[inline(always)]\n29\tpub unsafe fn load64_le(src: *const u8) -> u64 {\n30\t    let mut w = *src.add(0) as u64;\n31\t    w |= (*src.add(1) as u64) << 8;\n32\t    w |= (*src.add(2) as u64) << 16;\n33\t    w |= (*src.add(3) as u64) << 24;\n34\t    w |= (*src.add(4) as u64) << 32;\n35\t    w |= (*src.add(5) as u64) << 40;\n36\t    w |= (*src.add(6) as u64) << 48;\n37\t    w |= (*src.add(7) as u64) << 56;\n38\t    w\n39\t}\n40\t\n41\t#[inline(always)]\n42\tpub unsafe fn store64_le(dst: *mut u8, mut w: u64) {\n43\t    *dst.add(0) = w as u8;\n44\t    w >>= 8;\n45\t    *dst.add(1) = w as u8;\n46\t    w >>= 8;\n47\t    *dst.add(2) = w as u8;\n48\t    w >>= 8;\n49\t    *dst.add(3) = w as u8;\n50\t    w >>= 8;\n51\t    *dst.add(4) = w as u8;\n52\t    w >>= 8;\n53\t    *dst.add(5) = w as u8;\n54\t    w >>= 8;\n55\t    *dst.add(6) = w as u8;\n56\t    w >>= 8;\n57\t    *dst.add(7) = w as u8;\n58\t}\n59\t\n60\t#[inline(always)]\n61\tpub unsafe fn load32_le(src: *const u8) -> u32 {\n62\t    let mut w = *src.add(0) as u32;\n63\t    w |= (*src.add(1) as u32) << 8;\n64\t    w |= (*src.add(2) as u32) << 16;\n65\t    w |= (*src.add(3) as u32) << 24;\n66\t    w\n67\t}\n68\t\n69\t#[inline(always)]\n70\tpub unsafe fn store32_le(dst: *mut u8, mut w: u32) {\n71\t    *dst.add(0) = w as u8;\n72\t    w >>= 8;\n73\t    *dst.add(1) = w as u8;\n74\t    w >>= 8;\n75\t    *dst.add(2) = w as u8;\n76\t    w >>= 8;\n77\t    *dst.add(3) = w as u8;\n78\t}\n79\t\n80\t#[inline(always)]\n81\tpub unsafe fn load64_be(src: *const u8) -> u64 {\n82\t    let mut w = *src.add(7) as u64;\n83\t    w |= (*src.add(6) as u64) << 8;\n84\t    w |= (*src.add(5) as u64) << 16;\n85\t    w |= (*src.add(4) as u64) << 24;\n86\t    w |= (*src.add(3) as u64) << 32;\n87\t    w |= (*src.add(2) as u64) << 40;\n88\t    w |= (*src.add(1) as u64) << 48;\n89\t    w |= (*src.add(0) as u64) << 56;\n90\t    w\n91\t}\n92\t\n93\t#[inline(always)]\n94\tpub unsafe fn store64_be(dst: *mut u8, mut w: u64) {\n95\t    *dst.add(7) = w as u8;\n96\t    w >>= 8;\n97\t    *dst.add(6) = w as u8;\n98\t    w >>= 8;\n99\t    *dst.add(5) = w as u8;\n100\t    w >>= 8;\n101\t    *dst.add(4) = w as u8;\n102\t    w >>= 8;\n103\t    *dst.add(3) = w as u8;\n104\t    w >>= 8;\n105\t    *dst.add(2) = w as u8;\n106\t    w >>= 8;\n107\t    *dst.add(1) = w as u8;\n108\t    w >>= 8;\n109\t    *dst.add(0) = w as u8;\n110\t}\n111\t\n112\t#[inline(always)]\n113\tpub unsafe fn load32_be(src: *const u8) -> u32 {\n114\t    let mut w = *src.add(3) as u32;\n115\t    w |= (*src.add(2) as u32) << 8;\n116\t    w |= (*src.add(1) as u32) << 16;\n117\t    w |= (*src.add(0) as u32) << 24;\n118\t    w\n119\t}\n120\t\n121\t#[inline(always)]\n122\tpub unsafe fn store32_be(dst: *mut u8, mut w: u32) {\n123\t    *dst.add(3) = w as u8;\n124\t    w >>= 8;\n125\t    *dst.add(2) = w as u8;\n126\t    w >>= 8;\n127\t    *dst.add(1) = w as u8;\n128\t    w >>= 8;\n129\t    *dst.add(0) = w as u8;\n130\t}\n131\t\n132\t#[inline(always)]\n133\tpub unsafe fn xor_buf(out: *mut u8, in_: *const u8,