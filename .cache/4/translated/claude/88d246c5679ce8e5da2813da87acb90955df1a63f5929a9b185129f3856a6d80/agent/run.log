ll(1, 4, 5)));\n\nSODIUM_EXPORT\nint crypto_stream_chacha20_ietf_xor_ic(unsigned char *c, const unsigned char *m,\n                                       unsigned long long mlen,\n                                       const unsigned char *n, uint32_t ic,\n                                       const unsigned char *k)\n            __attribute__ ((nonnull(1, 4, 6)));\n\nSODIUM_EXPORT\nvoid crypto_stream_chacha20_ietf_keygen(unsigned char k[crypto_stream_chacha20_ietf_KEYBYTES])\n            __attribute__ ((nonnull));\n\n=== runtime.h\n45:int sodium_runtime_has_rdrand(void);\n=== stubs\n 1 src/randombytes.rs\n 1 src/randombytes_sysrandom.rs\n 1 src/randombytes_internal_random.rs\n 3 total\n// TODO: translate\n=== lib.rs head\n83:pub mod randombytes;\n84:pub mod randombytes_internal_random;\n85:pub mod randombytes_sysrandom;","is_error":false}]},"parent_tool_use_id":"toolu_bdrk_017Bui1dsGDDe58eZ5kBVBRM","session_id":"dbed778e-b40b-44c3-aae8-c706753ef0ef","uuid":"53e56ab5-e2d2-4718-bdef-20ffe87cbe6e","timestamp":"2026-08-22T13:39:54.763Z","subagent_type":"general-purpose","task_description":"Translate randombytes subsystem"}
