"crypto_kem_xwing_seedbytes\"};\n    for (unsigned i = 0; i < sizeof szn / sizeof szn[0]; i++) {\n        size_t a = ((fnsz) g(A, szn[i]))(), b = ((fnsz) g(B, szn[i]))();\n        if (a != b) { printf(\"  MISMATCH %s: C=%zu rust=%zu\\n\", szn[i], a, b); failures++; }\n    }\n    {\n        const char *a = ((fnstr) g(A, \"crypto_kem_primitive\"))();\n        const char *b = ((fnstr) g(B, \"crypto_kem_primitive\"))();\n        if (strcmp(a, b) != 0) { printf(\"  MISMATCH primitive: %s vs %s\\n\", a, b); failures++; }\n    }\n\n    fn4 skA = (fn4) g(A, \"_sodium_mlkem768_ref_seed_keypair\");\n    fn4 skB = (fn4) g(B, \"_sodium_mlkem768_ref_seed_keypair\");\n    fn4 edA = (fn4) g(A, \"_sodium_mlkem768_ref_enc_deterministic\");\n    fn4 edB = (fn4) g(B, \"_sodium_mlkem768_ref_enc_deterministic\");\n    fn3 dcA = (fn3) g(A, \"_sodium_mlkem768_ref_dec\");\n    fn3 dcB = (fn3) g(B, \"_sodium_mlkem768_ref_dec\");\n\n    fn4 xskA = (fn4) g(A, \"crypto_kem_xwing_seed_keypair\");\n    fn4 xskB = (fn4) g(B, \"crypto_kem_xwing_seed_keypair\");\n    fn4 xedA = (fn4) g(A, \"crypto_kem_xwing_enc_deterministic\");\n    fn4 xedB = (fn4) g(B, \"crypto_kem_xwing_enc_deterministic\");\n    fn3 xdcA = (fn3) g(A, \"crypto_kem_xwing_dec\");\n    fn3 xdcB = (fn3) g(B, \"crypto_kem_xwing_dec\");\n\n    for (int t = 0; t < 16; t++) {\n        unsigned char seed[64], eseed[32];\n        for (int i = 0; i < 64; i++) seed[i] = (unsigned char) (t * 37 + i * 11 + 3);\n        for (int i = 0; i < 32; i++) eseed[i] = (unsigned char) (t * 101 + i * 7 + 5);\n\n        unsigned char pkA[1184], pkB[1184], skA_[2400], skB_[2400];\n        int ra = skA(pkA, skA_, seed), rb = skB(pkB, skB_, seed);\n        if (ra != rb) { printf(\"  ret mismatch seed_keypair t=%d\\n\", t); failures++; }\n        cmp(\"mlkem pk\", pkA, pkB, 1184);\n        cmp(\"mlkem sk\", skA_, skB_, 2400);\n\n        unsigned char ctA[1088], ctB[1088], ssA[32], ssB[32];\n        ra = edA(ctA, ssA, pkA, eseed); rb = edB(ctB, ssB, pkB, eseed);\n        if (ra != rb) { printf(\"  ret mismatch enc_det t=%d (%d,%d)\\n\", t, ra, rb); failures++; }\n        cmp(\"mlkem ct\", ctA, ctB, 1088);\n        cmp(\"mlkem ss(enc)\", ssA, ssB, 32);\n\n        unsigned char dsA[32], dsB[32];\n        ra = dcA(dsA, ctA, skA_); rb = dcB(dsB, ctB, skB_);\n        if (ra != rb) { printf(\"  ret mismatch dec t=%d\\n\", t); failures++; }\n        cmp(\"mlkem ss(dec)\", dsA, dsB, 32);\n        if (memcmp(dsA, ssA, 32) != 0) { printf(\"  C roundtrip broken t=%d\\n\", t); failures++; }\n        if (memcmp(dsB, ssB, 32) != 0) { printf(\"  RUST roundtrip broken t=%d\\n\", t); failures++; }\n\n        /* implicit rejection path: corrupt ciphertext */\n        unsigned char bad[1088];\n        memcpy(bad, ctA, 1088);\n        bad[t % 1088] ^= 0x40;\n        ra = dcA(dsA, bad, skA_); rb = dcB(dsB, bad, skB_);\n        if (ra != rb) { printf(\"  ret mismatch dec(bad) t=%d\\n\", t); failures++; }\n        cmp(\"mlkem ss(dec bad)\", dsA, dsB, 32);\n        if (memcmp(dsA, ssA, 32) == 0) { printf(\"  NOTE: corrupt ct gave same ss t=%d\\n\", t); }\n\n        /* non-canonical public key rejection */\n        unsigned char ncpk[1184];\n        memcpy(ncpk, pkA, 1184);\n        ncpk[0] = 0xff; ncpk[1] |= 0x0f;\n        ra = edA(ctA, ssA, ncpk, eseed); rb = edB(ctB, ssB, ncpk, eseed);\n        if (ra != rb) { printf(\"  ret mismatch enc_det(noncanon) t=%d (%d,%d)\\n\", t, ra, rb); failures++; }\n\n        /* ---- X-Wing ---- */\n        unsigned char xpkA[1216], xpkB[1216], xskA_[32], xskB_[32];\n        ra = xskA(xpkA, xskA_, seed); rb = xskB(xpkB, xskB_, seed);\n        if (ra != rb) { printf(\"  ret mismatch xwing seed_keypair t=%d\\n\", t); failures++; }\n        cmp(\"xwing pk\", xpkA, xpkB, 1216);\n        cmp(\"xwing sk\", xskA_, xskB_, 32);\n\n        unsigned char xseed[64];\n        for (int i = 0; i < 64; i++) xseed[i] = (unsigned char) (t * 53 + i * 3 + 17);\n        unsigned char xctA[1120], xctB[1120], xssA[32], xssB[32];\n   