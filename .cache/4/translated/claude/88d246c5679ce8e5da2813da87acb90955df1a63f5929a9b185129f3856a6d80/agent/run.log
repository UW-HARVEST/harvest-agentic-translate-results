atic uint32_t det_next(void)\n{\n    prng ^= prng >> 12; prng ^= prng << 25; prng ^= prng >> 27;\n    return (uint32_t) ((prng * 2685821657736338717ULL) >> 32);\n}\nstatic const char *det_name(void)  { return \"deterministic-test\"; }\nstatic uint32_t    det_random(void){ return det_next(); }\nstatic void        det_stir(void)   { }\nstatic void        det_buf(void *const buf, const size_t size)\n{\n    unsigned char *p = (unsigned char *) buf;\n    for (size_t i = 0; i < size; i++) p[i] = (unsigned char) det_next();\n}\nstatic int         det_close(void) { return 0; }\n\ntypedef struct rb_impl {\n    const char *(*implementation_name)(void);\n    uint32_t    (*random)(void);\n    void        (*stir)(void);\n    uint32_t    (*uniform)(const uint32_t upper_bound);\n    void        (*buf)(void *const buf, const size_t size);\n    int         (*close)(void);\n} rb_impl;\n\nstatic rb_impl DET = { det_name, det_random, det_stir, NULL, det_buf, det_close };\n\nstatic void reseed(uint64_t s) { prng = s ? s : 0x9e3779b97f4a7c15ULL; }\n\nint main(int argc, char **argv)\n{\n    if (argc < 2) { fprintf(stderr, \"usage: %s <libsodium.so>\\n\", argv[0]); return 2; }\n    H = dlopen(argv[1], RTLD_NOW | RTLD_LOCAL);\n    if (!H) { fprintf(stderr, \"dlopen: %s\\n\", dlerror()); return 2; }\n\n    static unsigned char a[8192], b[8192], c[8192], d[8192], e[8192];\n    char sbuf[512];\n    size_t i, j;\n\n    {\n        FN(int, sodium_init, void);\n        num(\"init\", sodium_init());\n        FN(int, randombytes_set_implementation, const void *);\n        num(\"set_impl\", randombytes_set_implementation(&DET));\n        FN(const char *, randombytes_implementation_name, void);\n        printf(\"impl=%s\\n\", randombytes_implementation_name());\n        FN(void, randombytes_stir, void);\n        randombytes_stir();\n        FN(uint32_t, randombytes_random, void);\n        FN(uint32_t, randombytes_uniform, uint32_t);\n        FN(void, randombytes_buf, void *, size_t);\n        FN(int, randombytes_close, void);\n        reseed(1);\n        for (i = 0; i < 10; i++) unum(\"rand\", randombytes_random());\n        for (i = 1; i <= 20; i++) unum(\"uni\", randombytes_uniform((uint32_t) i * 7919));\n        unum(\"uni0\", randombytes_uniform(0));\n        unum(\"uni1\", randombytes_uniform(1));\n        randombytes_buf(a, 64); hex(\"rbuf\", a, 64);\n        num(\"close\", randombytes_close());\n    }\n\n    /* ---- exported implementation structs must be readable and well-formed ---- */\n    {\n        const char *ds[] = { \"aegis128l_soft_implementation\", \"aegis256_soft_implementation\",\n            \"crypto_onetimeauth_poly1305_donna_implementation\",\n            \"crypto_scalarmult_curve25519_ref10_implementation\",\n            \"crypto_stream_chacha20_ref_implementation\",\n            \"crypto_stream_salsa20_ref_implementation\", \"ipcrypt_soft_implementation\",\n            \"randombytes_internal_implementation\", \"randombytes_sysrandom_implementation\" };\n        size_t nptr[] = { 2, 2, 5, 2, 4, 2, 8, 6, 6 };\n        for (i = 0; i < sizeof ds / sizeof *ds; i++) {\n            void **p = (void **) S(ds[i]);\n            int allnn = 1, anynull = 0;\n            if (p) for (j = 0; j < nptr[i]; j++) {\n                if (p[j] == NULL) { allnn = 0; anynull = 1; }\n            }\n            printf(\"%s present=%d nonnull=%d hasnull=%d\\n\", ds[i], p != NULL, allnn, anynull);\n        }\n        /* the randombytes implementations expose a name we can call */\n        {\n            void **p = (void **) S(\"randombytes_sysrandom_implementation\");\n            const char *(*nm)(void) = (const char *(*)(void)) p[0];\n            printf(\"sysrandom_name=%s\\n\", nm());\n            p = (void **) S(\"randombytes_internal_implementation\");\n            nm = (const char *(*)(void)) p[0];\n            printf(\"internal_name=%s\\n\", nm());\n        }\n    }\n\n    /* ---- pick_best_implementation entry points ---- */\n    {\n        const char *ps[] 