nly check open of a seal we produce) */\n        for (i = 0; i <= 100; i += 25) {\n            fill(a, i);\n            num(\"bxseal\", crypto_box_seal(b, a, i, pk1));\n            num(\"bxsealopen\", crypto_box_seal_open(c, b, i + 48, pk1, sk1));\n            num(\"bxsealmatch\", memcmp(a, c, i) == 0);\n        }\n        /* xchacha box */\n        {\n            FN(int, crypto_box_curve25519xchacha20poly1305_seed_keypair, unsigned char *,\n                  unsigned char *, const unsigned char *);\n            FN(int, crypto_box_curve25519xchacha20poly1305_easy, unsigned char *,\n                  const unsigned char *, unsigned long long, const unsigned char *,\n                  const unsigned char *, const unsigned char *);\n            FN(int, crypto_box_curve25519xchacha20poly1305_open_easy, unsigned char *,\n                  const unsigned char *, unsigned long long, const unsigned char *,\n                  const unsigned char *, const unsigned char *);\n            FN(int, crypto_box_curve25519xchacha20poly1305_beforenm, unsigned char *,\n                  const unsigned char *, const unsigned char *);\n            FN(int, crypto_box_curve25519xchacha20poly1305_detached, unsigned char *,\n                  unsigned char *, const unsigned char *, unsigned long long,\n                  const unsigned char *, const unsigned char *, const unsigned char *);\n            reseed(8002);\n            fill(seed, 32);\n            crypto_box_curve25519xchacha20poly1305_seed_keypair(pk1, sk1, seed);\n            hex(\"xbxpk1\", pk1, 32);\n            fill(seed, 32);\n            crypto_box_curve25519xchacha20poly1305_seed_keypair(pk2, sk2, seed);\n            hex(\"xbxpk2\", pk2, 32);\n            unsigned char n24[24]; fill(n24, 24);\n            num(\"xbxbnm\", crypto_box_curve25519xchacha20poly1305_beforenm(km, pk2, sk1));\n            hex(\"xbxkm\", km, 32);\n            for (i = 0; i <= 200; i += 29) {\n                fill(a, i);\n                memset(b, 0xa5