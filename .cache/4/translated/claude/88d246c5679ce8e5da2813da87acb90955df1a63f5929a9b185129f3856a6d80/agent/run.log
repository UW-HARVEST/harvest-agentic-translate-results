1, sk1, seed));\n        hex(\"b1pk\", pk1, 32);\n        memset(seed, 0x11, 32);\n        num(\"b1skp2\", crypto_box_curve25519xsalsa20poly1305_seed_keypair(pk2, sk2, seed));\n        hex(\"b1pk2\", pk2, 32);\n        num(\"b1bnm\", crypto_box_curve25519xsalsa20poly1305_beforenm(km, pk2, sk1));\n        hex(\"b1km\", km, 32);\n        for (i = 0; i <= 100; i += 25) {\n            memset(a, 0, 32); memset(a + 32, 0x5b, i);\n            memset(b, 0xa5, 512);\n            num(\"b1\", crypto_box_curve25519xsalsa20poly1305(b, a, i + 32, n, pk2, sk1));\n            hex(\"b1\", b, i + 32);\n            num(\"b1o\", crypto_box_curve25519xsalsa20poly1305_open(c, b, i + 32, n, pk1, sk2));\n            hex(\"b1o\", c, i + 32);\n            num(\"b1a\", crypto_box_curve25519xsalsa20poly1305_afternm(b, a, i + 32, n, km));\n            hex(\"b1a\", b, i + 32);\n            num(\"b1ao\", crypto_box_curve25519xsalsa20poly1305_open_afternm(c, b, i + 32, n, km));\n            num(\"bxa\", crypto_box_afternm(b, a, i + 32, n, km));\n            hex(\"bxa\", b, i + 32);\n            num(\"bxao\", crypto_box_open_afternm(c, b, i + 32, n, km));\n            num(\"bxda\", crypto_box_detached_afternm(d, mac, a + 32, i, n, km));\n            hex(\"bxda\", d, i); hex(\"bxdamac\", mac, 16);\n            num(\"bxoda\", crypto_box_open_detached_afternm(e, d, mac, i, n, km));\n            num(\"bxodamatch\", memcmp(a + 32, e, i) == 0);\n        }\n        /* xchacha box afternm + seal */\n        FN(int, crypto_box_curve25519xchacha20poly1305_easy_afternm, unsigned char *,\n              const unsigned char *, unsigned long long, const unsigned char *,\n              const unsigned char *);\n        FN(int, crypto_box_curve25519xchacha20poly1305_open_easy_afternm, unsigned char *,\n              const unsigned char *, unsigned long long, const unsigned char *,\n              const unsigned char *);\n        FN(int, crypto_box_curve25519xchacha20poly1305_detached_afternm, unsigned char *,\n              unsigned char *, const unsigned char *, unsigned long long,\n              const unsigned char *, const unsigned char *);\n        FN(int, crypto_box_curve25519xchacha20poly1305_open_detached_afternm, unsigned char *,\n              const unsigned char *, const unsigned char *, unsigned long long,\n              const unsigned char *, const unsigned char *);\n        FN(int, crypto_box_curve25519xchacha20poly1305_open_detached, unsigned char *,\n              const unsigned char *, const unsigned char *, unsigned long long,\n              const unsigned char *, const unsigned char *, const unsigned char *);\n        FN(int, crypto_box_curve25519xchacha20poly1305_seal, unsigned char *,\n              const unsigned char *, unsigned long long, const unsigned char *);\n        FN(int, crypto_box_curve25519xchacha20poly1305_seal_open, unsigned char *,\n              const unsigned char *, unsigned long long, const unsigned char *,\n              const unsigned char *);\n        FN(int, crypto_box_curve25519xchacha20poly1305_seed_keypair, unsigned char *,\n              unsigned char *, const unsigned char *);\n        FN(int, crypto_box_curve25519xchacha20poly1305_beforenm, unsigned char *,\n              const unsigned char *, const unsigned char *);\n        FN(int, crypto_box_curve25519xchacha20poly1305_detached, unsigned char *,\n              unsigned char *, const unsigned char *, unsigned long long,\n              const unsigned char *, const unsigned char *, const unsigned char *);\n        memset(seed, 0x77, 32);\n        crypto_box_curve25519xchacha20poly1305_seed_keypair(pk1, sk1, seed);\n        memset(seed, 0x88, 32);\n        crypto_box_curve25519xchacha20poly1305_seed_keypair(pk2, sk2, seed);\n        crypto_box_curve25519xchacha20poly1305_beforenm(km, pk2, sk1);\n        hex(\"x2km\", km, 32);\n        for (i = 0; i <= 100; i += 25) {\n            memset(a, 0x9c, i);\n            memset(b, 0xa5, 512);\n            num(\"x2ea\", crypto_box_curve25