sbuf, \"zz\", 2, 0));\n        /* escrypt low-level */\n        FN(int, _sodium_escrypt_PBKDF2_SHA256, const uint8_t *, size_t, const uint8_t *,\n              size_t, uint64_t, uint8_t *, size_t);\n        for (uint64_t it = 1; it <= 3; it++)\n            for (size_t ol = 16; ol <= 80; ol += 32) {\n                num(\"pbkdf2\", _sodium_escrypt_PBKDF2_SHA256((const uint8_t *) pw,\n                        strlen(pw), salt, 16, it, b, ol));\n                hex(\"pbkdf2\", b, ol);\n            }\n        FN(int, _sodium_escrypt_init_local, void *);\n        FN(int, _sodium_escrypt_free_local, void *);\n        FN(int, _sodium_escrypt_alloc_region, void *, size_t);\n        FN(int, _sodium_escrypt_free_region, void *);\n        FN(uint8_t *, _sodium_escrypt_r, void *, const uint8_t *, size_t, const uint8_t *,\n              uint8_t *, size_t);\n        FN(uint8_t *, _sodium_escrypt_parse_setting, const uint8_t *, uint32_t *,\n              uint32_t *, uint32_t *);\n        FN(unsigned char *, _sodium_escrypt_gensalt_r, uint32_t, uint32_t, uint32_t,\n              const uint8_t *, size_t, uint8_t *, size_t);\n        FN(int, _sodium_escrypt_kdf_nosse, void *, const uint8_t *, size_t,\n              const uint8_t *, size_t, uint64_t, uint32_t, uint32_t, uint8_t *, size_t);\n        {\n            static unsigned char local[64], region[64];\n            memset(local, 0, sizeof local);\n            num(\"elocal\", _sodium_escrypt_init_local(local));\n            unsigned char setting[128], out[128];\n            memset(setting, 0, sizeof setting);\n            unsigned char *gp = _sodium_escrypt_gensalt_r(10, 8, 1, salt, 16,\n                    setting, sizeof setting);\n            printf(\"gensalt=%s\\n\", gp ? (char *) setting : \"(null)\");\n            uint32_t N_log2 = 0, r32 = 0, p32 = 0;\n            uint8_t *ps = _sodium_escrypt_parse_setting(setting, &N_log2, &r32, &p32);\n            printf(\"parse ok=%d N_log2=%u r=%u p=%u rest=%s\\n\", ps != NULL, N_log2, r32,\n                   p32, ps ? (const char *) ps : \"(null)\");\n            memset(out, 0, sizeof out);\n            uint8_t *rp = _sodium_escrypt_r(local, (const uint8_t *) pw, strlen(pw),\n                    setting, out, sizeof out);\n            printf(\"escrypt_r=%s\\n\", rp ? (char *) out : \"(null)\");\n            memset(b, 0, 64);\n            num(\"kdfnosse\", _sodium_escrypt_kdf_nosse(local, (const uint8_t *) pw,\n                    strlen(pw), salt, 16, 1024, 8, 1, b, 64));\n            hex(\"kdfnosse\", b, 64);\n            num(\"efree\", _sodium_escrypt_free_local(local));\n            memset(region, 0, sizeof region);\n            num(\"ealloc\", _sodium_escrypt_alloc_region(region, 4096) != 0);\n            num(\"efreer\", _sodium_escrypt_free_region(region));\n        }\n    }\n\n    /* ---- aead aliases with explicit names (already covered generically, but call\n            the aes256gcm afternm/detached stubs which harness.c skips) ---- */\n    {\n        FN(int, crypto_aead_aes256gcm_encrypt_detached, unsigned char *, unsigned char *,\n              unsigned long long *, const unsigned char *, unsigned long long,\n              const unsigned char *, unsigned long long, const unsigned char *,\n              const unsigned char *, const unsigned char *);\n        FN(int, crypto_aead_aes256gcm_decrypt_detached, unsigned char *, unsigned char *,\n              const unsigned char *, unsigned long long, const unsigned char *,\n              const unsigned char *, unsigned long long, const unsigned char *,\n              const unsigned char *);\n        FN(int, crypto_aead_aes256gcm_encrypt_afternm, unsigned char *, unsigned long long *,\n              const unsigned char *, unsigned long long, const unsigned char *,\n              unsigned long long, const unsigned char *, const unsigned char *,\n              const void *);\n        FN(int, crypto_aead_aes256gcm_decrypt_afternm, unsigned char *, unsigned long long *,\n              unsigned char *, const unsigned char *, unsigned long long,\n              const unsigned char *, unsigned long long, const unsigned char *,\n              const void *);\n        FN(int, crypto_aead_aes256gcm_encrypt_detached_afternm, unsigned char *,\n              unsigned char *, unsigned long long *, const unsigned char *,\n              unsigned long long, const unsigned char *, unsigned long long,\n              const unsigned char *, const unsigned char *, const void *);\n        FN(int, crypto_aead_aes256gcm_decrypt_detached_afternm, unsigned char *,\n              unsigned char *, const unsigned char *, unsigned long long,\n              const unsigned char *, const unsigned char *, unsigned long long,\n              const unsigned char *, const void *);\n        static unsigned char gst[1024];\n        unsigned char k[32], n[12], mac[16];\n        unsigned long long cl = 0, macl = 0;\n        memset(k, 3, 32); memset(n, 4, 12); memset(a, 5, 32);\n        errno = 0; num(\"g_ed\", crypto_aead_aes256gcm_encrypt_detached(b, mac, &macl, a, 32,\n                NULL, 0, NULL, n, k)); num(\"g_ed_e\", errno);\n        errno = 0; num(\"g_dd\", crypto_aead_aes256gcm_decrypt_detached(b, NULL, a, 32, mac,\n                NULL, 0, n, k)); num(\"g_dd_e\", errno);\n        errno = 0; num(\"g_ea\", crypto_aead_aes256gcm_encrypt_afternm(b, &cl, a, 32, NULL, 0,\n                NULL, n, gst)); num(\"g_ea_e\", errno);\n        errno = 0; num(\"g_da\", crypto_aead_aes256gcm_decrypt_afternm(b, &cl, NULL, a, 48,\n                NULL, 0, n, gst)); num(\"g_da_e\", errno);\n        errno = 0; num(\"g_eda\", crypto_aead_aes256gcm_encrypt_detached_afternm(b, mac,\n                &macl, a, 32, NULL, 0, NULL, n, gst)); num(\"g_eda_e\", errno);\n        errno = 0; num(\"g_dda\", crypto_aead_aes256gcm_decrypt_detached_afternm(b, NULL, a,\n                32, mac, NULL, 0, n, gst)); num(\"g_dda_e\", errno);\n    }\n\n    /* ---- softaes full block API ---- */\n    {\n        FN(void, _sodium_softaes_expand_key128, const unsigned char *, void *);\n        FN(void, _sodium_softaes_expand_key256, const unsigned char *, void *);\n        FN(void, _sodium_softaes_invert_key_schedule128, void *);\n        FN(void, _sodium_softaes_invert_key_schedule256, void *);\n        unsigned char key[32], rk[16 * 15];\n        for (i = 0; i < 32; i++) key[i] = (unsigned char) (i * 7 + 1);\n        memset(rk, 0, sizeof rk);\n        _sodium_softaes_expand_key128(key, rk);\n        hex(\"aes128rk\", rk, 16 * 11);\n        _sodium_softaes_invert_key_schedule128(rk);\n        hex(\"aes128rkinv\", rk, 16 * 11);\n        memset(rk, 0, sizeof rk);\n        _sodium_softaes_expand_key256(key, rk);\n        hex(\"aes256rk\", rk, 16 * 15);\n        _sodium_softaes_invert_key_schedule256(rk);\n        hex(\"aes256rkinv\", rk, 16 * 15);\n        /* block ops take/return a 16-byte SoftAesBlock by value (4 x uint32) */\n        typedef struct { uint32_t w[4]; } SB;\n        SB (*enc)(SB, SB)  = (SB (*)(SB, SB)) S(\"_sodium_softaes_block_encrypt\");\n        SB (*encl)(SB, SB) = (SB (*)(SB, SB)) S(\"_sodium_softaes_block_encryptlast\");\n        SB (*dec)(SB, SB)  = (SB (*)(SB, SB)) S(\"_sodium_softaes_block_decrypt\");\n        SB (*decl)(SB, SB) = (SB (*)(SB, SB)) S(\"_sodium_softaes_block_decryptlast\");\n        SB (*imc)(SB)      = (SB (*)(SB)) S(\"_sodium_softaes_inv_mix_columns\");\n        for (int t = 0; t < 6; t++) {\n            SB blk, rkb, o;\n            for (j = 0; j < 4; j++) {\n                blk.w[j] = (uint32_t) (0x01020304u * (t + 1) + (uint32_t) j);\n                rkb.w[j] = (uint32_t) (0x0a0b0c0du ^ (uint32_t) (t * 16 + j));\n            }\n            o = enc(blk, rkb);\n            printf(\"aesenc %08x%08x%08x%08x\\n\", o.w[0], o.w[1], o.w[2], o.w[3]);\n            o = encl(blk, rkb);\n            printf(\"aesencl %08x%08x%08x%08x\\n\", o.w[0], o.w[1], o.w[2], o.w[3]);\n            o = dec(blk, rkb);\n            printf(\"aesdec %08x%08x%08x%08x\\n\", o.w[0], o.