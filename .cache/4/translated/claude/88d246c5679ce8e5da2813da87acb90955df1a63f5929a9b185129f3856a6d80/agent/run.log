{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01BhPWi31Xh72gnfftr4TkPD","type":"tool_result","content":"1\t//! Translation of `randombytes/randombytes.c`.\n2\t//!\n3\t//! Reference build: Linux/glibc x86-64, no `config.h`, no\n4\t//! `RANDOMBYTES_CUSTOM_IMPLEMENTATION`, no `RANDOMBYTES_DEFAULT_IMPLEMENTATION`,\n5\t//! no `__EMSCRIPTEN__`.  The preprocessor therefore keeps exactly the\n6\t//! `&randombytes_sysrandom_implementation` default and drops all of the\n7\t//! JavaScript backend.\n8\t\n9\t//! The reference build compiles with `-O3 -DNDEBUG -std=gnu99`, so every\n10\t//! `assert()` collapses to `((void) (0))` and is reproduced here as a comment.\n11\t\n12\tuse core::ffi::{c_char, c_int, c_ulonglong, c_void};\n13\t\n14\t/* ------------------------------------------------------------------ */\n15\t/*  include/sodium/randombytes.h                                      */\n16\t/* ------------------------------------------------------------------ */\n17\t\n18\t/// `typedef struct randombytes_implementation { ... } randombytes_implementation;`\n19\t///\n20\t/// Six function pointers, 0x30 bytes on LP64.  `Option<extern \"C\" fn(..)>` has\n21\t/// the same representation as the corresponding C function pointer thanks to\n22\t/// the null-pointer optimisation, so `None` == `NULL`.\n23\t#[repr(C)]\n24\tpub struct randombytes_implementation {\n25\t    /* required */\n26\t    pub implementation_name: Option<extern \"C\" fn() -> *const c_char>,\n27\t    /* required */\n28\t    pub random: Option<extern \"C\" fn() -> u32>,\n29\t    /* optional */\n30\t    pub stir: Option<extern \"C\" fn()>,\n31\t    /* optional */\n32\t    pub uniform: Option<extern \"C\" fn(upper_bound: u32) -> u32>,\n33\t    /* required */\n34\t    pub buf: Option<extern \"C\" fn(buf: *mut c_void, size: usize)>,\n35\t    /* optional */\n36\t    pub close: Option<extern \"C\" fn() -> c_int>,\n37\t}\n38\t\n39\t/// `#define randombytes_SEEDBYTES 32U`\n40\tconst randombytes_SEEDBYTES: usize = 32;\n41\t\n42\t/// `#define crypto_stream_chacha20_ietf_NONCEBYTES 12U`\n43\tconst crypto_stream_chacha20_ietf_NONCEBYTES: usize = 12;\n44\t\n45\t/* ------------------------------------------------------------------ */\n46\t/*  externals                                                         */\n47\t/* ------------------------------------------------------------------ */\n48\t\n49\textern \"C\" {\n50\t    /// Exported data symbol defined by `randombytes/sysrandom/randombytes_sysrandom.c`.\n51\t    static randombytes_sysrandom_implementation: randombytes_implementation;\n52\t\n53\t    fn crypto_stream_chacha20_ietf(\n54\t        c: *mut u8,\n55\t        clen: c_ulonglong,\n56\t        n: *const u8,\n57\t        k: *const u8,\n58\t    ) -> c_int;\n59\t\n60\t    fn sodium_misuse() -> !;\n61\t}\n62\t\n63\t/* ------------------------------------------------------------------ */\n64\t/*  static const randombytes_implementation *implementation;          */\n65\t/* ------------------------------------------------------------------ */\n66\t\n67\tstatic mut implementation: *const randombytes_implementation = core::ptr::null();\n68\t\n69\t/// `static void randombytes_init_if_needed(void)`\n70\tunsafe fn randombytes_init_if_needed() {\n71\t    if implementation.is_null() {\n72\t        /* RANDOMBYTES_DEFAULT_IMPLEMENTATION == &randombytes_sysrandom_implementation */\n73\t        implementation = core::ptr::addr_of!(randombytes_sysrandom_implementation);\n74\t        randombytes_stir();\n75\t    }\n76\t}\n77\t\n78\t/* ------------------------------------------------------------------ */\n79\t/*  public API                                                        */\n80\t/* ------------------------------------------------------------------ */\n81\t\n82\t#[unsafe(no_mangle)]\n83\tpub unsafe extern \"C\" fn randombytes_set_implementation(\n84\t    impl_: *const randombytes_implementation,\n85\t) -> c_int {\n86\t    implementation = impl_;\n87\t    0\n88\t}\n89\t\n90\t#[unsafe(no_mangle)]\n91\tpub unsafe extern \"C\" fn randombytes_implementation_name() -> *const c_char {\n92\t    randombytes_init_if_needed();\n93\t    ((*implementation).implementation_name.unwrap_unchecked())()\n94\t}\n95\t\n96\t#[unsafe(no_mangle)]\n97\tpub unsafe extern \"C\" fn randombytes_random() -> u32 {\n98\t    randombytes_init_if_needed();\n99\t    ((*implementation).random.unwrap_unchecked())()\n100\t}\n101\t\n102\t#[unsafe(no_mangle)]\n103\tpub unsafe extern \"C\" fn randombytes_stir() {\n104\t    randombytes_init_if_needed();\n105\t    if let Some(stir) = (*implementation).stir {\n106\t        stir();\n107\t    }\n108\t}\n109\t\n110\t#[unsafe(no_mangle)]\n111\tpub unsafe extern \"C\" fn randombytes_uniform(upper_bound: u32) -> u32 {\n112\t    let min: u32;\n113\t    let mut r: u32;\n114\t\n115\t    randombytes_init_if_needed();\n116\t    if let Some(uniform) = (*implementation).uniform {\n117\t        return uniform(upper_bound);\n118\t    }\n119\t    if upper_bound < 2 {\n120\t        return 0;\n121\t    }\n122\t    /* min = (1U + ~upper_bound) % upper_bound;  == 2**32 mod upper_bound */\n123\t    min = (!upper_bound).wrapping_add(1) % upper_bound;\n124\t    loop {\n125\t        r = randombytes_random();\n126\t        if !(r < min) {\n127\t            break;\n128\t        }\n129\t    }\n130\t    /* r is now clamped to a set whose size mod upper_bound == 0\n131\t     * the worst case (2**31+1) requires ~ 2 attempts */\n132\t\n133\t    r % upper_bound\n134\t}\n135\t\n136\t#[unsafe(no_mangle)]\n137\tpub unsafe extern \"C\" fn randombytes_buf(buf: *mut c_void, size: usize) {\n138\t    randombytes_init_if_needed();\n139\t    if size > 0 {\n140\t        ((*implementation).buf.unwrap_unchecked())(buf, size);\n141\t    }\n142\t}\n143\t\n144\t#[unsafe(no_mangle)]\n145\tpub unsafe extern \"C\" fn randombytes_buf_deterministic(\n146\t    buf: *mut c_void,\n147\t    size: usize,\n148\t    seed: *const u8, /* [randombytes_SEEDBYTES] */\n149\t) {\n150\t    stat