\n409\t\n410\tint\n411\tblake2b_pick_best_implementation(void)\n412\t{\n413\t/* LCOV_EXCL_START */\n414\t#if defined(HAVE_AVX2INTRIN_H) && defined(HAVE_TMMINTRIN_H) && \\\n415\t    defined(HAVE_SMMINTRIN_H)\n416\t    if (sodium_runtime_has_avx2()) {\n417\t        blake2b_compress = blake2b_compress_avx2;\n418\t        return 0;\n419\t    }\n420\t#endif\n421\t#if defined(HAVE_EMMINTRIN_H) && defined(HAVE_TMMINTRIN_H) && \\\n422\t    defined(HAVE_SMMINTRIN_H)\n423\t    if (sodium_runtime_has_sse41()) {\n424\t        blake2b_compress = blake2b_compress_sse41;\n425\t        return 0;\n426\t    }\n427\t#endif\n428\t#if defined(HAVE_EMMINTRIN_H) && defined(HAVE_TMMINTRIN_H)\n429\t    if (sodium_runtime_has_ssse3()) {\n430\t        blake2b_compress = blake2b_compress_ssse3;\n431\t        return 0;\n432\t    }\n433\t#endif\n434\t    blake2b_compress = blake2b_compress_ref;\n435\t\n436\t    return 0;\n437\t    /* LCOV_EXCL_STOP */\n438\t}\n439\t"}]},"parent_tool_use_id":"toolu_bdrk_01HD9MQ2WDcobnjVbsvgqmA4","session_id":"dbed778e-b40b-44c3-aae8-c706753ef0ef","uuid":"f5dec915-0b6d-4c88-a2ca-31eaba777698","timestamp":"2026-08-22T13:39:32.553Z","subagent_type":"general-purpose","task_description":"Translate blake2b and generichash"}
