.isneg %d iszero %d\\n\", fe25519_isnegative(a), fe25519_iszero(a));\n        fe25519_sq(h, a); pfe(\"pat.sq\", h);\n        fe25519_sq2(h, a); pfe(\"pat.sq2\", h);\n        fe25519_mul(h, a, a); pfe(\"pat.mul\", h);\n        fe25519_mul32(h, a, 121666u); pfe(\"pat.mul32\", h);\n        printf(\"pat.notsquare %d\\n\", fe25519_notsquare(a));\n        fe25519_invert(h, a); pfe(\"pat.invert\", h);\n    }\n\n    for (int iter = 0; iter < 400; iter++) {\n        int wide = iter % 3;\n        rand_limbs(a, wide);\n        rand_limbs(b, wide);\n        pfe(\"A\", a); pfe(\"B\", b);\n        fe25519_reduce(h, a); pfe(\"R\", h);\n        fe25519_tobytes(out, a); pbytes(\"T\", out, 32);\n        fe25519_mul(h, a, b); pfe(\"M\", h);\n        fe25519_sq(h, a); pfe(\"S\", h);\n        fe25519_sq2(h, a); pfe(\"S2\", h);\n        fe25519_mul32(h, a, (uint32_t)(nextr() & 0xffffff)); pfe(\"M32\", h);\n        fe25519_add(h, a, b); pfe(\"AD\", h);\n        fe25519_sub(h, a, b); pfe(\"SU\", h);\n        fe25519_neg(h, a); pfe(\"NE\", h);\n        printf(\"Z %d %d N %d %d\\n\", fe25519_iszero(a), fe25519_iszero(b),\n               fe25519_isnegative(a), fe25519_isnegative(b));\n        fe25519_invert(h, a); pfe(\"IV\", h);\n        fe25519_pow22523(h, a); pfe(\"PW\", h);\n        printf(\"NS %d\\n\", fe25519_notsquare(a));\n        { int r = fe25519_sqrt(h, a); printf(\"SQ %d\\n\", r); pfe(\"SQV\", h); }\n        fe25519_copy(h, a); fe25519_abs(h); pfe(\"AB\", h);\n        /* frombytes on random 32 bytes incl. top-bit set */\n        { unsigned char s[32]; for (int i=0;i<32;i++) s[i]=(unsigned char)nextr();\n          fe25519_frombytes(h, s); pbytes(\"FBs\", s, 32); pfe(\"FB\", h);\n          s[31] |= 0x80; fe25519_frombytes(h, s); pfe(\"FBtop\", h);\n          memset(s, 0xff, 32); fe25519_frombytes(h, s); pfe(\"FBff\", h);\n          fe25519_tobytes(out, h); pbytes(\"FBff.tb\", out, 32); }\n    }\n    return 0;\n}\nEOF\ngcc -O2 -o extra_c extra_c.c -I . -I /local/home/scheschb/.harves