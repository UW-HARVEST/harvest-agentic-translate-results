        c.copy_from_slice(&v[..n]);\n        }\n    }\n}\n\nfn hex(b: &[u8]) -> String {\n    b.iter().map(|x| format!(\"{:02x}\", x)).collect()\n}\n\nfn main() {\n    let mut rng = Rng(0x243F6A8885A308D3);\n    let mut mul_fail = 0usize;\n    let mut muladd_fail = 0usize;\n    let n = 10000;\n\n    let mut a = [0u8; 32];\n    let mut b = [0u8; 32];\n    let mut c = [0u8; 32];\n\n    for i in 0..n {\n        rng.fill(&mut a);\n        rng.fill(&mut b);\n        rng.fill(&mut c);\n        // exercise a spread of bit patterns, incl. full 256-bit inputs and\n        // reduced (<2^252) ones\n        match i % 4 {\n            0 => {}\n            1 => {\n                a[31] &= 0x1f;\n                b[31] &= 0x1f;\n                c[31] &= 0x1f;\n            }\n            2 => {\n                for k in 0..32 {\n                    a[k] = 0xff;\n                }\n            }\n            _ => {\n                for k in 0..32 {\n                    b[k] = 0xff;\n                    c[k] = 0xff;\n                }\n            }\n        }\n\n        let mut rc = [0u8; 32];\n        let mut rr = [0u8; 32];\n        unsafe {\n            _sodium_sc25519_mul(rc.as_mut_ptr(), a.as_ptr(), b.as_ptr());\n            shim::sc_mul::sc25519_mul(rr.as_mut_ptr(), a.as_ptr(), b.as_ptr());\n        }\n        if rc != rr {\n            mul_fail += 1;\n            if mul_fail <= 3 {\n                println!(\"MUL MISMATCH #{}\\n  a={}\\n  b={}\\n  C={}\\n  R={}\",\n                         i, hex(&a), hex(&b), hex(&rc), hex(&rr));\n            }\n        }\n\n        let mut mc = [0u8; 32];\n        let mut mr = [0u8; 32];\n        unsafe {\n            _sodium_sc25519_muladd(mc.as_mut_ptr(), a.as_ptr(), b.as_ptr(), c.as_ptr());\n            shim::sc_mul::sc25519_muladd(mr.as_mut_ptr(), a.as_ptr(), b.as_ptr(), c.as_ptr());\n        }\n        if mc != mr {\n            muladd_fail += 1;\n            if muladd_fail <= 3 {\n                println!(\"MULADD MISMATCH #{}\\n  a={}\\n  b={}\\n  c={}\\n  C={}\\n  R={}\",\n                         i, hex(&a), hex(&b), hex(&c), hex(&mc), hex(&mr));\n            }\n        }\n    }\n\n    // Known vectors\n    let mut one = [0u8; 32];\n    one[0] = 1;\n    let zero = [0u8; 32];\n    let mut out = [0u8; 32];\n    unsafe { shim::sc_mul::sc25519_mul(out.as_mut_ptr(), one.as_ptr(), one.as_ptr()) };\n    println!(\"sc25519_mul(1,1)         = {}  (expect 01 followed by zeros: {})\",\n             hex(&out), out == one);\n\n    let mut a2 = [0u8; 32];\n    let mut rng2 = Rng(0x13198A2E03707344);\n    rng2.fill(&mut a2);\n    a2[31] &= 0x0f;\n    let mut out2 = [0u8; 32];\n    let mut out3 = [0u8; 32];\n    unsafe {\n        shim::sc_mul::sc25519_muladd(out2.as_mut_ptr(), a2.as_ptr(), zero.as_ptr(), a2.as_ptr());\n        _sodium_sc25519_muladd(out3.as_mut_ptr(), a2.as_ptr(), zero.as_ptr(), a2.as_ptr());\n    }\n    println!(\"sc25519_muladd(a,0,a)    = {}\", hex(&out2));\n    println!(\"  (== a reduced, matches C: {}; == a since a<L: {})\",\n             out2 == out3, out2 == a2);\n\n    println!(\"\\n=== RESULT over {} random triples ===\", n);\n    println!(\"sc25519_mul    mismatches: {}\", mul_fail);\n    println!(\"sc25519_muladd mismatches: {}\", muladd_fail);\n    if mul_fail == 0 && muladd_fail == 0 {\n        println!(\"ALL BYTE-IDENTICAL\");\n    } else {\n        std::process::exit(1);\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":347,"cache_read_input_tokens":56975,"cache_creation":{"ephemeral_5m_input_tokens":347,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_018REAsxSsCFnaaihdG3mFmu","session_id":"dbed778e-b40b-44c3-aae8-c706753ef0ef","uuid":"349a17f4-e203-44b3-bd59-dba23b650e6b","timestamp":"2026-08-22T13:49:31.249Z","subagent_type":"general-purpose","task_description":"Translate sc25519 mul and muladd"}
