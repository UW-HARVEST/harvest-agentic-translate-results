{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01JS6uVm9hxuT7nYmCchMZei","type":"tool_result","content":"1\t#include <stdint.h>\n2\t#include <string.h>\n3\t\n4\t#include \"crypto_core_keccak1600.h\"\n5\t#include \"crypto_xof_shake128.h\"\n6\t#include \"private/common.h\"\n7\t#include \"shake128_ref.h\"\n8\t\n9\tint\n10\tshake128_ref_init_with_domain(shake128_state_internal *state, unsigned char domain)\n11\t{\n12\t    crypto_core_keccak1600_init(&state->state);\n13\t    state->offset = 0;\n14\t    state->phase  = SHAKE128_PHASE_ABSORBING;\n15\t    state->domain = domain;\n16\t\n17\t    return 0;\n18\t}\n19\t\n20\tint\n21\tshake128_ref_init(shake128_state_internal *state)\n22\t{\n23\t    return shake128_ref_init_with_domain(state, crypto_xof_shake128_DOMAIN_STANDARD);\n24\t}\n25\t\n26\tint\n27\tshake128_ref_update(shake128_state_internal *state, const unsigned char *in, size_t inlen)\n28\t{\n29\t    size_t consumed = 0;\n30\t    size_t chunk_size;\n31\t    int    ret = 0;\n32\t\n33\t    if (state->phase != SHAKE128_PHASE_ABSORBING) {\n34\t        crypto_core_keccak1600_permute_24(&state->state);\n35\t        state->phase  = SHAKE128_PHASE_ABSORBING;\n36\t        state->offset = 0;\n37\t        ret = -1;\n38\t    }\n39\t\n40\t    if (state->offset == SHAKE128_RATE && inlen > 0U) {\n41\t        crypto_core_keccak1600_permute_24(&state->state);\n42\t        state->offset = 0;\n43\t    }\n44\t    if (state->offset != 0U && inlen > 0U) {\n45\t        chunk_size = SHAKE128_RATE - state->offset;\n46\t        if (chunk_size > inlen) {\n47\t            chunk_size = inlen;\n48\t        }\n49\t        crypto_core_keccak1600_xor_bytes(&state->state, in, state->offset, chunk_size);\n50\t        state->offset += chunk_size;\n51\t        consumed = chunk_size;\n52\t        if (state->offset == SHAKE128_RATE && consumed < inlen) {\n53\t            crypto_core_keccak1600_permute_24(&state->state);\n54\t            state->offset = 0;\n55\t        }\n56\t    }\n57\t    while (inlen - consumed >= SHAKE128_RATE) {\n58\t        crypto_core_keccak1600_xor_bytes(&state->state, &in[consumed], 0U, SHAKE128_RATE);\n59\t        consumed += SHAKE128_RATE;\n60\t        state->offset = SHAKE128_RATE;\n61\t        if (consumed < inlen) {\n62\t            crypto_core_keccak1600_permute_24(&state->state);\n63\t            state->offset = 0;\n64\t        }\n65\t    }\n66\t    if (consumed < inlen) {\n67\t        chunk_size = inlen - consumed;\n68\t        crypto_core_keccak1600_xor_bytes(&state->state, &in[consumed], 0U, chunk_size);\n69\t        state->offset = chunk_size;\n70\t    }\n71\t\n72\t    return ret;\n73\t}\n74\t\n75\tstatic void\n76\tshake128_finalize(shake128_state_internal *state)\n77\t{\n78\t    unsigned char pad;\n79\t\n80\t    /* If the rate is exactly full, process that block before padding */\n81\t    if (state->offset == SHAKE128_RATE) {\n82\t        crypto_core_keccak1600_permute_24(&state->state);\n83\t        state->offset = 0;\n84\t    }\n85\t\n86\t    /* Apply padding: domain byte at current position, 0x80 at last byte */\n87\t    if (state->offset == SHAKE128_RATE - 1) {\n88\t        /* Special case: padding fits in one byte */\n89\t        pad = (unsigned char) (state->domain ^ 0x80);\n90\t        crypto_core_keccak1600_xor_bytes(&state->state, &pad, state->offset, 1);\n91\t    } else {\n92\t        /* Normal case: domain and 0x80 at different positions */\n93\t        crypto_core_keccak1600_xor_bytes(&state->state, &state->domain, state->offset, 1);\n94\t        pad = 0x80;\n95\t        crypto_core_keccak1600_xor_bytes(&state->state, &pad, SHAKE128_RATE - 1, 1);\n96\t    }\n97\t\n98\t    /* Final permutation */\n99\t    crypto_core_keccak1600_permute_24(&state->state);\n100\t\n101\t    state->offset = 0;\n102\t    state->phase  = SHAKE128_PHASE_SQUEEZING;\n103\t}\n104\t\n105\tint\n106\tshake128_ref_squeeze(shake128_state_internal *state, unsigned char *out, size_t outlen)\n107\t{\n108\t    size_t extracted = 0;\n109\t    size_t chunk_size;\n110\t\n111\t    if (state->phase == SHAKE128_PHASE_ABSORBING) {\n112\t        shake128_finalize(state);\n113\t    }\n114\t\n115\t    if (state->offset == SHAKE128_RATE && outlen > 0U) {\n116\t        crypto_core_keccak1600_permute_24(&state->state);\n117\t        state->offset = 0;\n118\t    }\n119\t    if (state->offset != 0U && outlen > 0U) {\n120\t        chunk_size = SHAKE128_RATE - state->offset;\n121\t        if (chunk_size > outlen) {\n122\t            chunk_size = outlen;\n123\t        }\n124\t        crypto_core_keccak1600_extract_bytes(&state->state, out, state->offset, chunk_size);\n125\t        state->offset += chunk_size;\n126\t        extracted = chunk_size;\n127\t        if (state->offset == SHAKE128_RATE && extracted < outlen) {\n128\t            crypto_core_keccak1600_permute_24(&state->state);\n129\t            state->offset = 0;\n130\t        }\n131\t    }\n132\t    while (outlen - extracted >= SHAKE128_RATE) {\n133\t        crypto_core_keccak1600_extract_bytes(&state->state, &out[extracted], 0U, SHAKE128_RATE);\n134\t        extracted += SHAKE128_RATE;\n135\t        state->offset = SHAKE128_RATE;\n136\t        if (extracted < outlen) {\n137\t            crypto_core_keccak1600_permute_24(&state->state);\n138\t            state->offset = 0;\n139\t        }\n140\t    }\n141\t    if (extracted < outlen) {\n142\t        chunk_size = outlen - extracted;\n143\t        crypto_core_keccak1600_extract_bytes(&state->state, &out[extracted], 0U, chunk_size);\n144\t        state->offset = chunk_size;\n145\t    }\n146\t\n147\t    return 0;\n148\t}\n149\t\n150\tint\n151\tshake128_ref(unsigned char *out, size_t outlen, const unsigned char *in, size_t inlen)\n152\t{\n153\t    shake128_state_internal state;\n154\t\n155\t    shake128_ref_init(&state);\n156\t    shake128_ref_update(&state, in, inlen);\n157\t    shake128_ref_squeeze(&state, out, outlen);\n158\t\n159\t    return 0;\n160\t}\n161\t"}]},"parent_tool_use_id":"toolu_bdr