unsigned char *,\n              const unsigned char *, unsigned long long, const unsigned char *,\n              const unsigned char *);\n        FN(int, crypto_box_curve25519xsalsa20poly1305_open_afternm, unsigned char *,\n              const unsigned char *, unsigned long long, const unsigned char *,\n              const unsigned char *);\n        FN(int, crypto_box_afternm, unsigned char *, const unsigned char *,\n              unsigned long long, const unsigned char *, const unsigned char *);\n        FN(int, crypto_box_open_afternm, unsigned char *, const unsigned char *,\n              unsigned long long, const unsigned char *, const unsigned char *);\n        FN(int, crypto_box_detached_afternm, unsigned char *, unsigned char *,\n              const unsigned char *, unsigned long long, const unsigned char *,\n              const unsigned char *);\n        FN(int, crypto_box_open_detached_afternm, unsigned char *, const unsigned char *,\n              const unsigned char *, unsigned long long, const unsigned char *,\n              const unsigned char *);\n        unsigned char k[32], n[24], seed[32], pk1[32], sk1[32], pk2[32], sk2[32], km[32];\n        unsigned char mac[16];\n        memset(k, 0x21, 32); memset(n, 0x43, 24); memset(seed, 0x65, 32);\n        for (i = 0; i <= 100; i += 25) {\n            memset(a, 0, 32); memset(a + 32, 0x37, i);\n            memset(b, 0xa5, 512);\n            num(\"sbx\", crypto_secretbox_xsalsa20poly1305(b, a, i + 32, n, k));\n            hex(\"sbx\", b, i + 32);\n            num(\"sbxo\", crypto_secretbox_xsalsa20poly1305_open(c, b, i + 32, n, k));\n            hex(\"sbxo\", c, i + 32);\n        }\n        num(\"b1skp\", crypto_box_curve25519xsalsa20poly1305_seed_keypair(pk1, sk1, seed));\n        hex(\"b1pk\", pk1, 32);\n        memset(seed, 0x11, 32);\n        num(\"b1skp2\", crypto_box_curve25519xsalsa20poly1305_seed_keypair(pk2, sk2, seed));\n        hex(\"b1pk2\", pk2, 32);\n        num(\"b1bnm\", crypto_box_curve25519xs