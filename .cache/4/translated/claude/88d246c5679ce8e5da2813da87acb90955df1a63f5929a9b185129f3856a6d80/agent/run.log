g *, const unsigned char *,\n                       unsigned long long, const unsigned char *, unsigned long long,\n                       const unsigned char *, const unsigned char *, const unsigned char *) =\n                (int (*)(unsigned char *, unsigned long long *, const unsigned char *,\n                         unsigned long long, const unsigned char *, unsigned long long,\n                         const unsigned char *, const unsigned char *,\n                         const unsigned char *)) S(nm);\n            snprintf(nm, sizeof nm, \"%s_decrypt\", ae[q].pfx);\n            int (*dec)(unsigned char *, unsigned long long *, unsigned char *,\n                       const unsigned char *, unsigned long long, const unsigned char *,\n                       unsigned long long, const unsigned char *, const unsigned char *) =\n                (int (*)(unsigned char *, unsigned long long *, unsigned char *,\n                         const unsigned char *, unsigned long long, const unsigned char *,\n                         unsigned long long, const unsigned char *,\n                         const unsigned char *)) S(nm);\n            snprintf(nm, sizeof nm, \"%s_encrypt_detached\", ae[q].pfx);\n            int (*encd)(unsigned char *, unsigned char *, unsigned long long *,\n                        const unsigned char *, unsigned long long, const unsigned char *,\n                        unsigned long long, const unsigned char *, const unsigned char *,\n                        const unsigned char *) =\n                (int (*)(unsigned char *, unsigned char *, unsigned long long *,\n                         const unsigned char *, unsigned long long, const unsigned char *,\n                         unsigned long long, const unsigned char *, const unsigned char *,\n                         const unsigned char *)) S(nm);\n            snprintf(nm, sizeof nm, \"%s_decrypt_detached\", ae[q].pfx);\n            int (*decd)(unsigned char *, unsigned char *, const unsigned