{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_012gZktvaVanFA2e1P7oiisa","type":"tool_result","content":"File created successfully at: /local/home/scheschb/.harvest/work/harvest-translate-R9Se1l/tmp/difftest.c (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"1d84d759-ccc3-4cf9-a966-b9c663b366ff","uuid":"0f9628f7-d7d9-4d23-ab95-cad5a91e2c73","timestamp":"2026-08-20T04:52:37.503Z","tool_use_result":{"type":"create","filePath":"/local/home/scheschb/.harvest/work/harvest-translate-R9Se1l/tmp/difftest.c","content":"/* Differential test driver: exercises every exported symbol and dumps\n   internal state so C and Rust builds can be compared byte for byte. */\n#include <stdio.h>\n#include <string.h>\n#include <stddef.h>\n#include <stdlib.h>\n#include <limits.h>\n\ntypedef struct { size_t length, capacity; void *hash_table; ptrdiff_t temp; } hdr;\ntypedef struct { void *storage; size_t remaining; unsigned char block, mode; } arena;\ntypedef struct { size_t hash[8]; ptrdiff_t index[8]; } bucket;\ntypedef struct {\n  char *temp_key;\n  size_t slot_count, used_count, uct, ucst, tc, tct, seed, scl2;\n  arena string;\n  bucket *storage;\n} hidx;\n\nextern void stbds_rand_seed(size_t);\nextern size_t stbds_hash_bytes(void*, size_t, size_t);\nextern size_t stbds_hash_string(char*, size_t);\nextern char *stbds_stralloc(arena*, char*);\nextern void stbds_strreset(arena*);\nextern void *stbds_arrgrowf(void*, size_t, size_t, size_t);\nextern void stbds_arrfreef(void*);\nextern void stbds_hmfree_func(void*, size_t);\nextern void *stbds_hmget_key(void*, size_t, void*, size_t, int);\nextern void *stbds_hmget_key_ts(void*, size_t, void*, size_t, ptrdiff_t*, int);\nextern void *stbds_hmput_default(void*, size_t);\nextern void *stbds_hmput_key(void*, size_t, void*, size_t, int);\nextern void *stbds_hmdel_key(void*, size_t, void*, size_t, size_t, int);\nextern void *stbds_shmode_func(size_t, int);\nextern void sh_geti(int);\nextern char *strkey(int);\n\n#define HDR(t) (((hdr*)(t))-1)\n#define HM_BINARY 0\n#define HM_STRING 1\n#define SH_NONE 0\n#define SH_DEFAULT 1\n#define SH_STRDUP 2\n#define SH_ARENA 3\n\nstatic void dump_hidx(void *arr /* raw array ptr */, int show_key)\n{\n  hidx *h = (hidx *) HDR(arr)->hash_table;\n  size_t i, j;\n  if (!h) { printf(\"  hidx: NULL\\n\"); return; }\n  printf(\"  hidx: slots=%zu used=%zu uct=%zu ucst=%zu tomb=%zu tct=%zu seed=%016zx log2=%zu\\n\",\n         h->slot_count, h->used_count, h->uct, h->ucst, h->tc, h->tct, h->seed, h->scl2);\n  printf(\"  arena: remaining=%zu block=%u mode=%u storage=%s\\n\",\n         h->string.remaining, (unsigned) h->string.block, (unsigned) h->string.mode,\n         h->string.storage ? \"yes\" : \"no\");\n  if (show_key)\n    printf(\"  temp_key=%s\\n\", h->temp_key ? h->temp_key : \"(null)\");\n  printf(\"  align64=%d\\n\", (((size_t) h->storage) & 63) == 0);\n  for (i = 0; i < h->slot_count >> 3; ++i) {\n    printf(\"  b%02zu:\", i);\n    for (j = 0; j < 8; ++j)\n      printf(\" %016zx/%td\", h->storage[i].hash[j], h->storage[i].index[j]);\n    printf(\"\\n\");\n  }\n}\n\nstatic void dump_arr(void *arr)\n{\n  printf(\"  arr: len=%zu cap=%zu temp=%td ht=%s\\n\", HDR(arr)->length, HDR(arr)->capacity,\n         HDR(arr)->temp, HDR(arr)->hash_table ? \"yes\" : \"no\");\n}\n\n/* ---------------- string map (elemsize 16, keysize 8) ---------------- */\ntypedef struct { char *key; int value; } SM;\n#define SM_E sizeof(SM)\n#define SM_K sizeof(char*)\n\nstatic ptrdiff_t sm_geti(SM **t, const char *k) {\n  *t = (SM*) stbds_hmget_key(*t, SM_E, (void*) k, SM_K, HM_STRING);\n  return HDR((char*)*t - SM_E)->temp;\n}\nstatic void sm_put(SM **t, const char *k, int v) {\n  *t = (SM*) stbds_hmput_key(*t, SM_E, (void*) k, SM_K, HM_STRING);\n  (*t)[HDR((char*)*t - SM_E)->temp].value = v;\n}\nstatic int sm_get(SM **t, const char *k) {\n  sm_geti(t, k);\n  return (*t)[HDR((char*)*t - SM_E)->temp].value;\n}\nstatic ptrdiff_t sm_del(SM **t, const char *k) {\n  *t = (SM*) stbds_hmdel_key(*t, SM_E, (void*) k, SM_K, 0, HM_STRING);\n  return *t ? HDR((char*)*t - SM_E)->temp : 0;\n}\nstatic ptrdiff_t sm_len(SM *t) { return t ? (ptrdiff_t) HDR((char*)t - SM_E)->length - 1 : 0; }\nstatic void sm_default(SM **t, int v) {\n  *t = (SM*) stbds_hmput_default(*t, SM_E);\n  (*t)[-1].value = v;\n}\nstatic void sm_free(SM **t) { if (*t) stbds_hmfree_func((char*)*t - SM_E, SM_E); *t = NULL; }\nstatic void sm_dump(SM *t, const char *tag) {\n  ptrdiff_t i;\n  printf(\" %s: len=%td default=%d\\n\", tag, sm_len(t), t ? t[-1].value : 0);\n  for (i = 0; i < sm_len(t); ++i)\n    printf(\"   [%td] %s = %d\\n\", i, t[i].key, t[i].value);\n  if (t) { dump_arr((char*)t - SM_E); dump_hidx((char*)t - SM_E, 1); }\n}\n\n/* ---------------- int map (elemsize 8, keysize 4) ---------------- */\ntypedef struct { int key; int value; } IM;\n#define IM_E sizeof(IM)\n#define IM_K sizeof(int)\nstatic ptrdiff_t im_geti(IM **t, int k) {\n  *t = (IM*) stbds_hmget_key(*t, IM_E, (void*) &k, IM_K, HM_BINARY);\n  return HDR((char*)*t - IM_E)->temp;\n}\nstatic void im_put(IM **t, int k, int v) {\n  *t = (IM*) stbds_hmput_key(*t, IM_E, (void*) &k, IM_K, HM_BINARY);\n  (*t)[HDR((char*)*t - IM_E)->temp].key = k;\n  (*t)[HDR((char*)*t - IM_E)->temp].value = v;\n}\nstatic int im_get(IM **t, int k) {\n  im_geti(t, k);\n  return (*t)[HDR((char*)*t - IM_E)->temp].value;\n}\nstatic ptrdiff_t im_del(IM **t, int k) {\n  *t = (IM*) stbds_hmdel_key(*t, IM_E, (void*) &k, IM_K, 0, HM_BINARY);\n  return *t ? HDR((char*)*t - IM_E)->temp : 0;\n}\nstatic ptrdiff_t im_len(IM *t) { return t ? (ptrdiff_t) HDR((char*)t - IM_E)->length - 1 : 0; }\nstatic void im_free(IM **t) { if (*t) stbds_hmfree_func((char*)*t - IM_E, IM_E); *t = NULL; }\nstatic void im_dump(IM *t, const char *tag) {\n  ptrdiff_t i;\n  printf(\" %s: len=%td default=%d\\n\", tag, im_len(t), t ? t[-1].value : 0);\n  for (i = 0; i < im_len(t); ++i)\n    printf(\"   [%td] %d = %d\\n\", i, t[i].key, t[i].value);\n  if (t) { dump_arr((char*)t - IM_E); dump_hidx((char*)t - IM_E, 0); }\n}\n\n/* ---------------- struct2 map (int key[2]) ---------------- */\ntypedef struct { int key[2]; int b, c, d; } S2;\n#define S2_E sizeof(S2)\n#define S2_K (2*sizeof(int))\n\nint main(void)\n{\n  size_t i, j;\n\n  printf(\"== strkey ==\\n\");\n  { int vals[] = {0, 1, -1, 7, 42, 12345, -99999, INT_MAX, INT_MIN};\n    for (i = 0; i < sizeof(vals)/sizeof(vals[0]); ++i) {\n      char *p = strkey(vals[i]);\n      printf(\"%d -> '%s' len=%zu\\n\", vals[i], p, strlen(p));\n    }\n    /* returns the same static buffer every time */\n    printf(\"same buffer: %d\\n\", strkey(1) == strkey(2));\n  }\n\n  printf(\"== hash_string ==\\n\");\n  { const char *strs[] = { \"\", \"a\", \"ab\", \"abc\", \"abcdefgh\", \"abcdefghi\",\n                           \"the quick brown fox jumps over the lazy dog\",\n                           \"\\xff\\xfe\\x80\\x01\", \"\\x7f\\x80\\x81\\x82\\x83\\x84\\x85\\x86\\x87\" };\n    size_t seeds[] = { 0, 1, 0x31415926u, (size_t)-1, 0x123456789abcdefull };\n    for (i = 0; i < sizeof(strs)/sizeof(strs[0]); ++i)\n      for (j = 0; j < sizeof(seeds)/sizeof(seeds[0]); ++j)\n        printf(\"%zu,%zu -> %016zx\\n\", i, j, stbds_hash_string((char*) strs[i], seeds[j]));\n  }\n\n  printf(\"== hash_bytes ==\\n\");\n  { unsigned char buf[64];\n    size_t seeds[] = { 0, 1, 0x31415926u, (size_t)-1, 0x123456789abcdefull };\n    for (i = 0; i < 64; ++i) buf[i] = (unsigned char) (i * 37 + 11);\n    for (i = 0; i <= 40; ++i)\n      for (j = 0; j < sizeof(seeds)/sizeof(seeds[0]); ++j)\n        printf(\"len=%zu s=%zu -> %016zx\\n\", i, j, stbds_hash_bytes(buf, i, seeds[j]));\n    /* all 0xff / all 0x00 / high-bit patterns */\n    memset(buf, 0xff, sizeof buf);\n    for (i = 0; i <= 24; ++i) printf(\"ff len=%zu -> %016zx\\n\", i, stbds_hash_bytes(buf, i, 12345));\n    memset(buf, 0x00, sizeof buf);\n    for (i = 0; i <= 24; ++i) printf(\"00 len=%zu -> %016zx\\n\", i, stbds_hash_bytes(buf, i, 12345));\n    for (i = 0; i < 64; ++i) buf[i] = (unsigned char) (0x80 | (i & 0x7f));\n    for (i = 0; i <= 24; ++i) printf(\"hi len=%zu -> %016zx\\n\", i, stbds_hash_bytes(buf, i, 999));\n  }\n\n  printf(\"== arrgrowf ==\\n\");\n  { void *a = NULL;\n    a = stbds_arrgrowf(NULL, 4, 1, 0); dump_arr(a);\n    a = stbds_arrgrowf(a, 4, 1, 0);    dump_arr(a);\n    HDR(a)->length = 4;\n    a = stbds_arrgrowf(a, 4, 1, 0);    dump_arr(a);\n    a = stbds_arrgrowf(a, 4, 0, 3);    dump_arr(a);\n    a = stbds_arrgrowf(a, 4, 0, 100);  dump_arr(a);\n    a = stbds_arrgrowf(a, 4, 0, 101);  dump_arr(a);\n    a = stbds_arrgrowf(a, 4, 500, 0);  dump_arr(a);\n    stbds_arrfreef(a);\n    a = stbds_arrgrowf(NULL, 1, 0, 0); dump_arr(a);\n    a = stbds_arrgrowf(a, 1, 0, 1);    dump_arr(a);\n    stbds_arrfreef(a);\n    a = stbds_arrgrowf(NULL, 24, 0, 1); dump_arr(a);\n    stbds_arrfreef(a);\n  }\n\n  printf(\"== stralloc ==\\n\");\n  { arena sa; char *prev = NULL; char big[4096];\n    memset(&sa, 0, sizeof sa);\n    for (i = 0; i < 300; ++i) {\n      char *p = stbds_stralloc(&sa, strkey((int) i));\n      printf(\"%zu '%s' delta=%td rem=%zu block=%u\\n\", i, p, prev ? p - prev : 0,\n             sa.remaining, (unsigned) sa.block);\n      prev = p;\n    }\n    memset(big, 'x', sizeof big); big[sizeof big - 1] = 0;\n    { char *p = stbds_stralloc(&sa, big);\n      printf(\"big len=%zu rem=%zu block=%u eq=%d\\n\", strlen(p), sa.remaining,\n             (unsigned) sa.block, strcmp(p, big) == 0); }\n    { char *p = stbds_stralloc(&sa, \"after-big\");\n      printf(\"after-big '%s' rem=%zu block=%u\\n\", p, sa.remaining, (unsigned) sa.block); }\n    stbds_strreset(&sa);\n    printf(\"reset: rem=%zu block=%u mode=%u storage=%s\\n\", sa.remaining,\n           (unsigned) sa.block, (unsigned) sa.mode, sa.storage ? \"yes\" : \"no\");\n    /* huge first allocation into an empty arena */\n    memset(&sa, 0, sizeof sa);\n    { char *p = stbds_stralloc(&sa, big);\n      printf(\"hu