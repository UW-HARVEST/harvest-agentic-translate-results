, void*, size_t, ptrdiff_t*, int);\nextern void *stbds_hmput_default(void*, size_t);\nextern void *stbds_hmput_key(void*, size_t, void*, size_t, int);\nextern void *stbds_hmdel_key(void*, size_t, void*, size_t, size_t, int);\nextern void *stbds_shmode_func(size_t, int);\nextern void sh_geti(int);\nextern char *strkey(int);\n\n#define HDR(t) (((hdr*)(t))-1)\n#define HM_BINARY 0\n#define HM_STRING 1\n#define SH_NONE 0\n#define SH_DEFAULT 1\n#define SH_STRDUP 2\n#define SH_ARENA 3\n\nstatic void dump_hidx(void *arr /* raw array ptr */, int show_key)\n{\n  hidx *h = (hidx *) HDR(arr)->hash_table;\n  size_t i, j;\n  if (!h) { printf(\"  hidx: NULL\\n\"); return; }\n  printf(\"  hidx: slots=%zu used=%zu uct=%zu ucst=%zu tomb=%zu tct=%zu seed=%016zx log2=%zu\\n\",\n         h->slot_count, h->used_count, h->uct, h->ucst, h->tc, h->tct, h->seed, h->scl2);\n  printf(\"  arena: remaining=%zu block=%u mode=%u storage=%s\\n\",\n         h->string.remaining, (unsigned) h->string.block, (unsigned) h->string.mode,\n         h->string.storage ? \"yes\" : \"no\");\n  if (show_key)\n    printf(\"  temp_key=%s\\n\", h->temp_key ? h->temp_key : \"(null)\");\n  printf(\"  align64=%d\\n\", (((size_t) h->storage) & 63) == 0);\n  for (i = 0; i < h->slot_count >> 3; ++i) {\n    printf(\"  b%02zu:\", i);\n    for (j = 0; j < 8; ++j)\n      printf(\" %016zx/%td\", h->storage[i].hash[j], h->storage[i].index[j]);\n    printf(\"\\n\");\n  }\n}\n\nstatic void dump_arr(void *arr)\n{\n  printf(\"  arr: len=%zu cap=%zu temp=%td ht=%s\\n\", HDR(arr)->length, HDR(arr)->capacity,\n         HDR(arr)->temp, HDR(arr)->hash_table ? \"yes\" : \"no\");\n}\n\n/* ---------------- string map (elemsize 16, keysize 8) ---------------- */\ntypedef struct { char *key; int value; } SM;\n#define SM_E sizeof(SM)\n#define SM_K sizeof(char*)\n\nstatic ptrdiff_t sm_geti(SM **t, const char *k) {\n  *t = (SM*) stbds_hmget_key(*t, SM_E, (void*) k, SM_K, HM_STRING);\n  return HDR((char*)*t - SM_E)->temp;\n}\nstatic void sm_put(SM **t, const char *k, int v) {\n  *t = (SM*) stbds_hmput_key(*t, SM_E, (void*) k, SM_K, HM_STRING);\n  (*t)[HDR((char*)*t - SM_E)->temp].value = v;\n}\nstatic int sm_get(SM **t, const char *k) {\n  sm_geti(t, k);\n  return (*t)[HDR((char*)*t - SM_E)->temp].value;\n}\nstatic ptrdiff_t sm_del(SM **t, const char *k) {\n  *t = (SM*) stbds_hmdel_key(*t, SM_E, (void*) k, SM_K, 0, HM_STRING);\n  return *t ? HDR((char*)*t - SM_E)->temp : 0;\n}\nstatic ptrdiff_t sm_len(SM *t) { return t ? (ptrdiff_t) HDR((char*)t - SM_E)->length - 1 : 0; }\nstatic void sm_default(SM **t, int v) {\n  *t = (SM*) stbds_hmput_default(*t, SM_E);\n  (*t)[-1].value = v;\n}\nstatic void sm_free(SM **t) { if (*t) stbds_hmfree_func((char*)*t - SM_E, SM_E); *t = NULL; }\nstatic void sm_dump(SM *t, const char *tag) {\n  ptrdiff_t i;\n  printf(\" %s: len=%td default=%d\\n\", tag, sm_len(t), t ? t[-1].value : 0);\n  for (i = 0; i < sm_len(t); ++i)\n    printf(\"   [%td] %s = %d\\n\", i, t[i].key, t[i].value);\n  if (t) { dump_arr((char*)t - SM_E); dump_hidx((char*)t - SM_E, 1); }\n}\n\n/* ---------------- int map (elemsize 8, keysize 4) ---------------- */\ntypedef struct { int key; int value; } IM;\n#define IM_E sizeof(IM)\n#define IM_K sizeof(int)\nstatic ptrdiff_t im_geti(IM **t, int k) {\n  *t = (IM*) stbds_hmget_key(*t, IM_E, (void*) &k, IM_K, HM_BINARY);\n  return HDR((char*)*t - IM_E)->temp;\n}\nstatic void im_put(IM **t, int k, int v) {\n  *t = (IM*) stbds_hmput_key(*t, IM_E, (void*) &k, IM_K, HM_BINARY);\n  (*t)[HDR((char*)*t - IM_E)->temp].key = k;\n  (*t)[HDR((char*)*t - IM_E)->temp].value = v;\n}\nstatic int im_get(IM **t, int k) {\n  im_geti(t, k);\n  return (*t)[HDR((char*)*t - IM_E)->temp].value;\n}\nstatic ptrdiff_t im_del(IM **t, int k) {\n  *t = (IM*) stbds_hmdel_key(*t, IM_E, (void*) &k, IM_K, 0, HM_BINARY);\n  return *t ? HDR((char*)*t - IM_E)->temp : 0;\n}\nstatic ptrdiff_t im_len(IM *t) { return t ? (ptrdiff_t) HDR((char*)t - IM_E)->length - 1 : 0; }\nstatic void im_free(IM **t) {