(node) {\n52\t        free(node);\n53\t    }\n54\t}\n55\t\n56\tvoid tree_delete(tree_t *tree) {\n57\t    if (!tree) {\n58\t        return;\n59\t    }\n60\t    \n61\t    // Free all nodes in the hashmap\n62\t    for (size_t i = 0; i < tree->node_map->capacity; i++) {\n63\t        if (tree->node_map->entries[i].occupied && \n64\t            !tree->node_map->entries[i].deleted) {\n65\t            tree_free_node((tree_node_t *)tree->node_map->entries[i].value);\n66\t        }\n67\t    }\n68\t    \n69\t    hashmap_destroy(tree->node_map);\n70\t    free(tree);\n71\t}\n72\t\n73\tint tree_add_node(tree_t *tree, tree_id_t id, tree_id_t parent_id, const char *data) {\n74\t    if (!tree) {\n75\t        return -1;\n76\t    }\n77\t    \n78\t    // Check if node already exists\n79\t    if (tree_contains(tree, id)) {\n80\t        fprintf(stderr, \"Error: Node with ID %lu already exists\\n\", id);\n81\t        return -1;\n82\t    }\n83\t    \n84\t    // Allocate new node\n85\t    tree_node_t *node = malloc(sizeof(tree_node_t));\n86\t    if (!node) {\n87\t        fprintf(stderr, \"Error: Failed to allocate node\\n\");\n88\t        return -1;\n89\t    }\n90\t    \n91\t    node->id = id;\n92\t    node->parent_id = parent_id;\n93\t    node->child_count = 0;\n94\t    \n95\t    if (data) {\n96\t        strncpy(node->data, data, MAX_DATA_LENGTH - 1);\n97\t        node->data[MAX_DATA_LENGTH - 1] = '\\0';\n98\t    } else {\n99\t        node->data[0] = '\\0';\n100\t    }\n101\t    \n102\t    // If this is the first node, make it the root\n103\t    if (!tree->has_root) {\n104\t        tree->root_id = id;\n105\t        tree->has_root = 1;\n106\t        node->parent_id = 0; // Root has no parent\n107\t    } else {\n108\t        // Find parent and add this node as a child\n109\t        tree_node_t *parent = tree_get_node(tree, parent_id);\n110\t        if (!parent) {\n111\t            fprintf(stderr, \"Error: Parent node %lu not found\\n\", parent_id);\n112\t            free(node);\n113\t       