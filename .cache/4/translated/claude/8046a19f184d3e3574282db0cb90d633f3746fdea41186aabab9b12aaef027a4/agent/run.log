= lock.write_all(s.as_bytes());\n    let _ = lock.flush();\n}\n\n#[macro_export]\nmacro_rules! cprintf {\n    ($($arg:tt)*) => {\n        $crate::cio::out_str(&format!($($arg)*))\n    };\n}\n\n#[macro_export]\nmacro_rules! ceprintf {\n    ($($arg:tt)*) => {\n        $crate::cio::err_str(&format!($($arg)*))\n    };\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
