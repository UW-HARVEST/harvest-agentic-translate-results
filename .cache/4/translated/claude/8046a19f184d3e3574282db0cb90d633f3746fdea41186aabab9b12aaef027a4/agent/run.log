 assert(hashmap_put(map, 1, &val1) == 0);\n45\t    assert(hashmap_put(map, 2, &val2) == 0);\n46\t    assert(hashmap_put(map, 3, &val3) == 0);\n47\t    assert(hashmap_size(map) == 3);\n48\t    \n49\t    assert(*(int *)hashmap_get(map, 1) == 42);\n50\t    assert(*(int *)hashmap_get(map, 2) == 100);\n51\t    assert(*(int *)hashmap_get(map, 3) == 200);\n52\t    \n53\t    // Test update\n54\t    int val4 = 500;\n55\t    assert(hashmap_put(map, 1, &val4) == 0);\n56\t    assert(hashmap_size(map) == 3);\n57\t    assert(*(int *)hashmap_get(map, 1) == 500);\n58\t    \n59\t    // Test remove\n60\t    void *removed = hashmap_remove(map, 2);\n61\t    assert(removed == &val2);\n62\t    assert(hashmap_size(map) == 2);\n63\t    assert(hashmap_get(map, 2) == NULL);\n64\t    \n65\t    // Test contains\n66\t    assert(hashmap_contains(map, 1) == 1);\n67\t    assert(hashmap_contains(map, 2) == 0);\n68\t    assert(hashmap_contains(map, 3) == 1);\n69\t    \n70\t    hashmap_destroy(map);\n71\t    TEST_PASS;\n72\t}\n73\t\n74\tvoid test_hashmap_collisions(void) {\n75\t    printf(\"\\n=== Testing Hashmap Collisions ===\\n\");\n76\t    \n77\t    hashmap_t *map = hashmap_create();\n78\t    \n79\t    // Add many items to force collisions\n80\t    int values[100];\n81\t    for (int i = 0; i < 100; i++) {\n82\t        values[i] = i * 10;\n83\t        assert(hashmap_put(map, i, &values[i]) == 0);\n84\t    }\n85\t    \n86\t    assert(hashmap_size(map) == 100);\n87\t    \n88\t    // Verify all values\n89\t    for (int i = 0; i < 100; i++) {\n90\t        int *val = (int *)hashmap_get(map, i);\n91\t        assert(val != NULL);\n92\t        assert(*val == i * 10);\n93\t    }\n94\t    \n95\t    hashmap_destroy(map);\n96\t    TEST_PASS;\n97\t}\n98\t\n99\tvoid test_tree_creation(void) {\n100\t    printf(\"\\n=== Testing Tree Creation ===\\n\");\n101\t    \n102\t    tree_t *tree = tree_create();\n103\t    assert(tree != NULL);\n104\t    assert(tree_size(tree) == 0);\n105\t    assert(tree->has_root == 0);\n