-1);\n  }\n  /* delete the *last* element only: old_index == final_index, avoids the mode!=1 re-find path */\n  for (int i=29;i>=25;--i) {\n    sm = stbds_hmdel_key(sm, sizeof(skv), (void*)keys[i], sizeof(char*), offsetof(skv,key), 2);\n    printf(\"del %d -> %td len=%zu\\n\", i, HDR((char*)sm-sizeof(skv))->temp, HDR((char*)sm-sizeof(skv))->length);\n  }\n  for (int i=0;i<30;++i) {\n    sm = stbds_hmget_key(sm, sizeof(skv), (void*)keys[i], sizeof(char*), 2);\n    printf(\"re-get %d -> %td\\n\", i, HDR((char*)sm-sizeof(skv))->temp);\n  }\n  stbds_hmfree_func((char*)sm-sizeof(skv), sizeof(skv));\n\n  printf(\"--- keysize 0 (every key compares equal) ---\\n\");\n  stbds_rand_seed(3);\n  ikv *z = NULL;\n  for (int i=0;i<6;++i) {\n    z = stbds_hmput_key(z, sizeof(ikv), &i, 0, 0);\n    ptrdiff_t t = HDR((char*)z-sizeof(ikv))->temp;\n    z[t].key = i; z[t].value = i*2;\n    printf(\"put %d t=%td len=%zu\\n\", i, t, HDR((char*)z-sizeof(ikv))->length);\n  }\n  for (int i=0;i<6;++i) {\n    z = stbds_hmget_key(z, sizeof(ikv), &i, 0, 0);\n    printf(\"get %d -> %td\\n\", i, HDR((char*)z-sizeof(ikv))->temp);\n  }\n  z = stbds_hmdel_key(z, sizeof(ikv), (void*)\"\", 0, 0, 0);\n  printf(\"del -> %td len=%zu\\n\", HDR((char*)z-sizeof(ikv))->temp, HDR((char*)z-sizeof(ikv))->length);\n  stbds_hmfree_func((char*)z-sizeof(ikv), sizeof(ikv));\n\n  printf(\"--- big elemsize / small keysize ---\\n\");\n  stbds_rand_seed(5);\n  typedef struct { int key; char pad[100]; int value; } fat;\n  fat *f = NULL;\n  for (int i=0;i<50;++i) {\n    f = stbds_hmput_key(f, sizeof(fat), &i, sizeof(int), 0);\n    ptrdiff_t t = HDR((char*)f-sizeof(fat))->temp;\n    f[t].key = i; f[t].value = i*i; memset(f[t].pad, (char)i, 100);\n  }\n  { hdr *h = HDR((char*)f-sizeof(fat)); hidx *hi = h->hash_table;\n    printf(\"fat len=%zu cap=%zu slots=%zu used=%zu\\n\", h->length, h->capacity, hi->slot_count, hi->used_count); }\n  for (int i=0;i<50;i+=9) {\n    f = stbds_hmget_key(f, sizeof(fat), &i, sizeof(int), 0);\n    ptrdiff_t t = HDR((char*)f-sizeof(fat))->temp;\n    printf(\"fat get %d -> %td v=%d pad=%d\\n\", i, t, t>=0?f[t].value:-1, t>=0?(int)(unsigned char)f[t].pad[50]:-1);\n  }\n  for (int i=0;i<50;i+=2) f = stbds_hmdel_key(f, sizeof(fat), &i, sizeof(int), offsetof(fat,key), 0);\n  { hdr *h = HDR((char*)f-sizeof(fat)); unsigned long long dg=0;\n    for (size_t i=0;i+1<h->length;++i) { dg=dg*131+(unsigned)f[i].key; dg=dg*31+(unsigned)f[i].value; dg=dg*7+(unsigned char)f[i].pad[3]; }\n    printf(\"fat digest %llu len=%zu\\n\", dg, h->length); }\n  stbds_hmfree_func((char*)f-sizeof(fat), sizeof(fat));\n  printf(\"--- done ---\\n\");\n  return 0;\n}\nEOF\ncd $TMPDIR/cbuild && gcc -O1 -g driver3.c -o driver3_c -L. -lref_c -Wl,-rpath,$TMPDIR/cbuild && gcc -O1 -g driver3.c -o driver3_rs -L. -lref_rs -Wl,-rpath,$TMPDIR/cbuild; MALLOC_CHECK_=3 stdbuf -o0 ./driver3_c > out3_c.txt 2>e3c.txt; echo \"C=$?\"; MALLOC_CHECK_=3 stdbuf -o0 ./driver3_rs > out3_rs.txt 2>e3rs.txt; echo \"RS=$?\"; wc -l out3_c.txt out3_rs.txt; diff out3_c.txt out3_rs.txt >d3.txt; echo \"DIFF=$?\"; head -20 d3.txt; tail -3 out3_c.txt","description":"Test mode=2, keysize=0 and fat structs differentially"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2343,"cache_read_input_tokens":142409,"cache_creation":{"ephemeral_5m_input_tokens":2343,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"34f58a0a-1270-4871-9648-c35728ff0f03","uuid":"fc63ac37-d1c0-4ceb-917b-d7483c842397","timestamp":"2026-08-20T05:16:52.662Z"}
