 /* elemsize 32, keysize 24 */\ntypedef struct { char *key; long long value; } skv;\n\nstatic void dump_table(void *hp, size_t elemsize, const char *tag) {\n  hdr *h = HDR((char*)hp - elemsize);\n  hidx *t = h->hash_table;\n  if (!t) { printf(\"%s: table=NULL len=%zu cap=%zu temp=%td\\n\", tag, h->length, h->capacity, h->temp); return; }\n  printf(\"%s: len=%zu cap=%zu temp=%td slots=%zu used=%zu tomb=%zu uct=%zu ucst=%zu tct=%zu log2=%zu seed=%zu smode=%d\\n\",\n    tag, h->length, h->capacity, h->temp, t->slot_count, t->used_count, t->tombstone_count,\n    t->uct, t->ucst, t->tct, t->log2, t->seed, t->string.mode);\n  size_t used=0, tomb=0, empty=0, sumh=0;\n  for (size_t i=0;i<t->slot_count>>3;++i) for (int j=0;j<8;++j) {\n    if (t->storage[i].index[j] >= 0) { used++; sumh = sumh*31 + t->storage[i].hash[j] + (size_t)t->storage[i].index[j]; }\n    else if (t->storage[i].index[j] == -2) tomb++; else empty++;\n  }\n  printf(\"  slots used=%zu tomb=%zu empty=%zu digest=%zu align64=%d\\n\", used, tomb, empty, sumh, (int)(((size_t)t->storage & 63)==0));\n}\n\nint main(void) {\n  printf(\"=== A: str_dups edge ===\\n\");\n  str_dups(0); str_dups(1); str_dups(1000); str_dups(INT_MIN); str_dups(INT_MAX>0?7:0);\n  printf(\"=== B: strkey edge ===\\n\");\n  printf(\"[%s]\\n\", strkey(INT_MIN));\n  printf(\"[%s]\\n\", strkey(INT_MAX));\n  printf(\"[%s]\\n\", strkey(0));\n\n  printf(\"=== C: hash_string seeds ===\\n\");\n  size_t seeds[] = {0, 1, 2, 0x31415926, SIZE_MAX, 0x8000000000000000ull, 12345678901234567ull};\n  char *strs[] = {\"\", \"\\x01\", \"\\x80\", \"\\xff\\xff\\xff\\xff\\xff\\xff\\xff\\xff\", \"0123456789abcdefghijklmnopqrstuvwxyz\",\n                  \"key_59\", \"test_999999999\", \"\\x7f\\x80\\x81 mix \\xfe\"};\n  for (unsigned a=0;a<sizeof(seeds)/sizeof(*seeds);++a)\n    for (unsigned b=0;b<sizeof(strs)/sizeof(*strs);++b)\n      printf(\"%u/%u %zu\\n\", a, b, stbds_hash_string(strs[b], seeds[a]));\n\n  printf(\"=== D: hash_bytes exhaustive-ish ===\\n\");\n 