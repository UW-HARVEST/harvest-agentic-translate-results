TCH\", repr(data))\n        print(\"  C   :\", a)\n        print(\"  RUST:\", b)\n        if fails > 10:\n            break\n\n# structured: valid prefix then junk in the byte stream\nfor it in range(3000):\n    n = random.randint(0, 8)\n    parts = [b\"3\", b\"2\", b\"1\", str(n).encode()]\n    vals = [random.choice(TOKENS) for _ in range(n)]\n    data = b\" \".join(parts + vals) + random.choice([b\"\", b\"\\n\"])\n    a = run(CREF, data); b = run(RUST, data)\n    total += 1\n    if a[0] < 0:\n        crashes += 1\n        continue\n    if a != b:\n        fails += 1\n        print(\"MISMATCH2\", repr(data))\n        print(\"  C   :\", a)\n        print(\"  RUST:\", b)\n        if fails > 10:\n            break\n\nprint(\"total=%d fails=%d c_crashes=%d\" % (total, fails, crashes))\nsys.exit(1 if fails else 0)\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":283,"cache_read_input_tokens":59470,"cache_creation":{"ephemeral_5m_input_tokens":283,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"06552a30-eea7-4d45-9162-d7a720b04073","uuid":"b1db0c50-f6a8-498c-8da4-8b7655cb0eb9","timestamp":"2026-08-19T16:44:53.571Z"}
