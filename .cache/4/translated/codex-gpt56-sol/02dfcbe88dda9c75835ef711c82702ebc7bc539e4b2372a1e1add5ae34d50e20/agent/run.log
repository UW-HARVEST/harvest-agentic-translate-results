{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes\nimport random\n\npaths = [\n    \\\"/tmp/harvest_translate_RQrwip_cbuild/libdriver.so\\\",\n    \\\"target/release/libdriver.so\\\",\n]\nlibs = [ctypes.CDLL(path) for path in paths]\nint_p = ctypes.POINTER(ctypes.c_int)\nfor lib in libs:\n    lib.fma_array.argtypes = [int_p, int_p, int_p, int_p, ctypes.c_int]\n    lib.fma_array.restype = None\n    lib.call_fma.argtypes = [int_p, ctypes.c_int]\n    lib.call_fma.restype = ctypes.c_int\n\nrng = random.Random(0x5EED)\nedge = [-(2**31), -(2**31) + 1, -100000, -1, 0, 1, 46341, 100000, 2**31 - 1]\ncase_count = 0\nfor length in [1, 2, 3, 8, 31, 100, 257]:\n    values = [rng.choice(edge) if i % 3 == 0 else rng.randint(-(2**31), 2**31 - 1) for i in range(length)]\n    mul1_values = [rng.choice(edge) for _ in range(length)]\n    add_values = [rng.choice(edge) for _ in range(length)]\n    Data = ctypes.c_int * length\n    data = Data(*values)\n    mul1 = Data(*mul1_values)\n    add = Data(*add_values)\n    outputs = []\n    returns = []\n    for lib in libs:\n        out = Data(*([0x12345678] * length))\n        lib.fma_array(out, mul1, data, add, length)\n        outputs.append(list(out))\n        returns.append(lib.call_fma(data, length))\n    expected = [ctypes.c_int(a * b + c).value for a, b, c in zip(mul1_values, values, add_values)]\n    assert outputs[0] == expected == outputs[1], (length, outputs, expected)\n    assert returns[0] == values[-1] == returns[1], (length, returns, values[-1])\n    case_count += 1\n\nfor lib in libs:\n    sentinel = (ctypes.c_int * 1)(12345)\n    lib.fma_array(sentinel, sentinel, sentinel, sentinel, 0)\n    assert sentinel[0] == 12345\n    lib.fma_array(sentinel, sentinel, sentinel, sentinel, -1)\n    assert sentinel[0] == 12345\n    assert lib.call_fma(sentinel, 0) == 0\n\nprint(f\\\"validated {case_count} array sizes across {len(libs)} libraries\\\")\nPY\"","ag