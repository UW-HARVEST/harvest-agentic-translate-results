{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes as C\nimport random\nfrom pathlib import Path\n\nroot = Path.cwd()\nlibs = [C.CDLL(str(root / 'reference_build/libtranslated_rust_c.so')),\n        C.CDLL(str(root / 'target/release/libtranslated_rust.so'))]\n\nclass Header(C.Structure):\n    _fields_ = [('length', C.c_size_t), ('capacity', C.c_size_t),\n                ('hash_table', C.c_void_p), ('temp', C.c_ssize_t)]\n\nclass Arena(C.Structure):\n    _fields_ = [('storage', C.c_void_p), ('remaining', C.c_size_t),\n                ('block', C.c_ubyte), ('mode', C.c_ubyte)]\n\nclass Entry(C.Structure):\n    _fields_ = [('key', C.c_int), ('value', C.c_int)]\n\nclass StringEntry(C.Structure):\n    _fields_ = [('key', C.c_char_p), ('value', C.c_int)]\n\nclass HashIndex(C.Structure):\n    _fields_ = [('temp_key', C.c_void_p), ('slot_count', C.c_size_t),\n                ('used_count', C.c_size_t), ('used_count_threshold', C.c_size_t),\n                ('used_count_shrink_threshold', C.c_size_t),\n                ('tombstone_count', C.c_size_t), ('tombstone_count_threshold', C.c_size_t),\n                ('seed', C.c_size_t), ('slot_count_log2', C.c_size_t),\n                ('string', Arena), ('storage', C.c_void_p)]\n\nfor lib in libs:\n    lib.stbds_hash_bytes.argtypes = [C.c_void_p, C.c_size_t, C.c_size_t]\n    lib.stbds_hash_bytes.restype = C.c_size_t\n    lib.stbds_hash_string.argtypes = [C.c_char_p, C.c_size_t]\n    lib.stbds_hash_string.restype = C.c_size_t\n    lib.stbds_arrgrowf.argtypes = [C.c_void_p, C.c_size_t, C.c_size_t, C.c_size_t]\n    lib.stbds_arrgrowf.restype = C.c_void_p\n    lib.stbds_arrfreef.argtypes = [C.c_void_p]\n    lib.stbds_rand_seed.argtypes = [C.c_size_t]\n    lib.stbds_stralloc.argtypes = [C.POINTER(Arena), C.c_char_p]\n    lib.stbds_stralloc.restype = C.c_char_p\n    lib.stbds_strreset.argtypes = [C.POINTER(Arena)]\n    lib.stbds_hmput_key.argtypes = [C.c_void_p, C.c_size_t, C.c_void_p, C.c_size_t, C.c_int]\n    lib.stbds_hmput_key.restype = C.c_void_p\n    lib.stbds_hmget_key.argtypes = [C.c_void_p, C.c_size_t, C.c_void_p, C.c_size_t, C.c_int]\n    lib.stbds_hmget_key.restype = C.c_void_p\n    lib.stbds_hmget_key_ts.argtypes = [C.c_void_p, C.c_size_t, C.c_void_p, C.c_size_t, C.POINTER(C.c_ssize_t), C.c_int]\n    lib.stbds_hmget_key_ts.restype = C.c_void_p\n    lib.stbds_hmdel_key.argtypes = [C.c_void_p, C.c_size_t, C.c_void_p, C.c_size_t, C.c_size_t, C.c_int]\n    lib.stbds_hmdel_key.restype = C.c_void_p\n    lib.stbds_hmput_default.argtypes = [C.c_void_p, C.c_size_t]\n    lib.stbds_hmput_default.restype = C.c_void_p\n    lib.stbds_shmode_func.argtypes = [C.c_size_t, C.c_int]\n    lib.stbds_shmode_func.restype = C.c_void_p\n    lib.stbds_hmfree_func.argtypes = [C.c_void_p, C.c_size_t]\n    lib.strkey.argtypes = [C.c_int]\n    lib.strkey.restype = C.c_char_p\n\nrng = random.Random(0x5EED)\nfor length in list(range(0, 40)) + [63, 64, 65, 127, 255, 1024]:\n    for _ in range(8):\n        data = bytes(rng.randrange(256) for _ in range(length))\n        buf = C.create_string_buffer(data, max(1, length))\n        seed = rng.randrange(1 << 64)\n        got = [lib.stbds_hash_bytes(buf, length, seed) for lib in libs]\n        assert got[0] == got[1], ('hash_bytes', length, seed, got)\nfor length in list(range(0, 40)) + [100, 255, 1024]:\n    data = bytes(rng.randrange(1, 256) for _ in range(length))\n    seed = rng.randrange(1 << 64)\n    got = [lib.stbds_hash_string(data, seed) for lib in libs]\n    assert got[0] == got[1], ('hash_string', length, seed, got)\nfor n in [-2147483648, -1, 0, 1, 42, 2147483647]:\n    assert libs[0].strkey(n) == libs[1].strkey(n)\nprint('hash/string-key differential: ok')\n\nptrs = [None, None]\nfor add_len, min_cap, new_len in [(0, 0, 0), (1, 0, 1), (3, 0, 4), (0, 20, 4), (17, 0, 21), (0, 21, 21)]:\n    for i, lib in enumerate(libs):\n        ptrs[i] = lib.stbds_arrgrowf(ptrs[i], C.sizeof(C.c_uint32), add_len, min_cap)\n        h = Header.from_address(ptrs[i] - C.sizeof(Header))\n        h.length = new_len\n        for j in range(new_len):\n            C.c_uint32.from_address(ptrs[i] + 4*j).value = (j * 0x10203 + 7) & 0xffffffff\n    hs = [Header.from_address(p - C.sizeof(Header)) for p in ptrs]\n    assert [(h.length, h.capacity, h.temp, bool(h.hash_table)) for h in hs][0] == [(h.length, h.capacity, h.temp, bool(h.hash_table)) for h in hs][1]\n    assert C.string_at(ptrs[0], new_len*4) == C.string_at(ptrs[1], new_len*4)\nfor lib, p in zip(libs, ptrs):\n    lib.stbds_arrfreef(p)\nprint('array growth differential: ok')\n\narenas = [Arena(), Arena()]\nstrings = [b'', b'a', b'x'*510, b'y'*511, b'z'*700, b'q'*(2**20+17), b'end']\nfor value in strings:\n    results = [lib.stbds_stralloc(C.byref(arena), value) for lib, arena in zip(libs, arenas)]\n    assert results[0] == results[1] == value\n    states = [(a.remaining, a.block, a.mode, bool(a.storage)) for a in arenas]\n    assert states[0] == states[1], (len(value), states)\nfor lib, arena in zip(libs, arenas):\n    lib.stbds_strreset(C.byref(arena))\nassert bytes(arenas[0]) == bytes(arenas[1]) == b'\\\\0' * C.sizeof(Arena)\nprint('string arena differential: ok')\n\ndef hdr(map_ptr, elem_size):\n    return Header.from_address(map_ptr - elem_size - C.sizeof(Header))\n\ndef binary_state(map_ptr):\n    h = hdr(map_ptr, C.sizeof(Entry))\n    entries = [(Entry.from_address(map_ptr + i*C.sizeof(Entry)).key,\n                Entry.from_address(map_ptr + i*C.sizeof(Entry)).value)\n               for i in range(h.length - 1)]\n    t = HashIndex.from_address(h.hash_table)\n    meta = (h.length, h.capacity, h.temp, t.slot_count, t.used_count,\n            t.used_count_threshold, t.used_count_shrink_threshold,\n            t.tombstone_count, t.tombstone_count_threshold, t.seed,\n            t.slot_count_log2, t.string.remaining, t.string.block, t.string.mode)\n    return entries, meta\n\nfor lib in libs:\n    lib.stbds_ran