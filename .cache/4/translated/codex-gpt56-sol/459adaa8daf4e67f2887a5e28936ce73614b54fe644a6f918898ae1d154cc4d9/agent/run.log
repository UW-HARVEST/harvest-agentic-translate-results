{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes as C\nfrom pathlib import Path\nref = C.CDLL('/tmp/harvest-zstd-c-build/libzstd.so', mode=C.RTLD_LOCAL)\nrust = C.CDLL(str(Path('target/release/libtranslated_zstd.so').resolve()), mode=C.RTLD_LOCAL)\n\nclass InBuffer(C.Structure):\n    _fields_ = [('src', C.c_void_p), ('size', C.c_size_t), ('pos', C.c_size_t)]\nclass OutBuffer(C.Structure):\n    _fields_ = [('dst', C.c_void_p), ('size', C.c_size_t), ('pos', C.c_size_t)]\nfor lib in (ref, rust):\n    lib.ZSTD_createCStream.restype = C.c_void_p\n    lib.ZSTD_freeCStream.argtypes = [C.c_void_p]; lib.ZSTD_freeCStream.restype = C.c_size_t\n    lib.ZSTD_initCStream.argtypes = [C.c_void_p, C.c_int]; lib.ZSTD_initCStream.restype = C.c_size_t\n    lib.ZSTD_compressStream.argtypes = [C.c_void_p, C.POINTER(OutBuffer), C.POINTER(InBuffer)]; lib.ZSTD_compressStream.restype = C.c_size_t\n    lib.ZSTD_endStream.argtypes = [C.c_void_p, C.POINTER(OutBuffer)]; lib.ZSTD_endStream.restype = C.c_size_t\n    lib.ZSTD_isError.argtypes = [C.c_size_t]; lib.ZSTD_isError.restype = C.c_uint\n    lib.ZSTD_createDStream.restype = C.c_void_p\n    lib.ZSTD_freeDStream.argtypes = [C.c_void_p]; lib.ZSTD_freeDStream.restype = C.c_size_t\n    lib.ZSTD_initDStream.argtypes = [C.c_void_p]; lib.ZSTD_initDStream.restype = C.c_size_t\n    lib.ZSTD_decompressStream.argtypes = [C.c_void_p, C.POINTER(OutBuffer), C.POINTER(InBuffer)]; lib.ZSTD_decompressStream.restype = C.c_size_t\n\ndata = bytes(((i * 17) \"'^ (i >> 3)) & 255 for i in range(300000)) + b'\"'repeated-block' * 10000\n\ndef stream_compress(lib):\n    ctx = lib.ZSTD_createCStream(); assert ctx and lib.ZSTD_initCStream(ctx, 7) == 0\n    result = bytearray()\n    for start in range(0, len(data), 7919):\n        piece = data[start:start+7919]; src = C.create_string_buffer(piece); inp = InBuffer(C.cast(src, C.c_void_p), len(piece), 0)\n        while inp.pos < inp.size:\n  