{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes as C\nimport math\nimport random\nimport struct\n\nclass V(C.Structure): _fields_ = [('x', C.c_float), ('y', C.c_float)]\nclass R(C.Structure): _fields_ = [('c', C.c_float), ('s', C.c_float)]\nclass X(C.Structure): _fields_ = [('p', V), ('r', R)]\nclass Circle(C.Structure): _fields_ = [('p', V), ('r', C.c_float)]\nclass AABB(C.Structure): _fields_ = [('min', V), ('max', V)]\nclass Capsule(C.Structure): _fields_ = [('a', V), ('b', V), ('r', C.c_float)]\nclass Cache(C.Structure):\n    _fields_ = [('metric', C.c_float), ('count', C.c_int), ('iA', C.c_int * 3), ('iB', C.c_int * 3), ('div', C.c_float)]\nclass Proxy(C.Structure): _fields_ = [('radius', C.c_float), ('count', C.c_int), ('verts', V * 8)]\nclass SV(C.Structure):\n    _fields_ = [('sA', V), ('sB', V), ('p', V), ('u', C.c_float), ('iA', C.c_int), ('iB', C.c_int)]\nclass Simplex(C.Structure): _fields_ = [('verts', SV * 4), ('div', C.c_float), ('count', C.c_int)]\n\nlibs = [C.CDLL('./c_build/libtranslated_rust.so'), C.CDLL('./target/release/libtranslated_rust.so')]\nexercised = set()\n\ndef setup(lib):\n    specs = {\n        'c2V': ([C.c_float, C.c_float], V),\n        'c2Mulvs': ([V, C.c_float], V),\n        'c2Maxv': ([V, V], V), 'c2Minv': ([V, V], V),\n        'c2Clampv': ([V, V, V], V), 'c2Sub': ([V, V], V),\n        'c2Dot': ([V, V], C.c_float), 'c2RotIdentity': ([], R),\n        'c2xIdentity': ([], X), 'c2BBVerts': ([C.POINTER(V), C.POINTER(AABB)], None),\n        'c2MakeProxy': ([C.c_void_p, C.c_int, C.POINTER(Proxy)], None),\n        'c2Len': ([V], C.c_float), 'c2Det2': ([V, V], C.c_float),\n        'c2GJKSimplexMetric': ([C.POINTER(Simplex)], C.c_float),\n        'c2Mulrv': ([R, V], V), 'c2Add': ([V, V], V), 'c2Mulxv': ([X, V], V),\n        'c22': ([C.POINTER(Simplex)], None), 'c23': ([C.POINTER(Simplex)], None),\n        'c2Neg': ([V], V), 'c2Skew': ([V], V), 'c2CCW90': ([V], V),\n        'c2D': ([C.POINTER(Simplex)], V),\n        'c2Support': ([C.POINTER(V), C.c_int, V], C.c_int),\n        'c2Witness': ([C.POINTER(Simplex), C.POINTER(V), C.POINTER(V)], None),\n        'c2Div': ([V, C.c_float], V), 'c2Norm': ([V], V),\n        'c2L': ([C.POINTER(Simplex)], V), 'c2MulrvT': ([R, V], V),\n        'c2GJK': ([C.c_void_p, C.c_int, C.POINTER(X), C.c_void_p, C.c_int,\n                   C.POINTER(X), C.POINTER(V), C.POINTER(V), C.c_int,\n                   C.POINTER(C.c_int), C.POINTER(Cache)], C.c_float),\n        'gjk_cache': ([C.c_char, C.POINTER(V), C.POINTER(V)] + [C.c_float] * 9, None),\n    }\n    for name, (args, ret) in specs.items():\n        fn = getattr(lib, name); fn.argtypes = args; fn.restype = ret\nfor lib in libs: setup(lib)\n\ndef raw(x): return C.string_at(C.byref(x), C.sizeof(x))\ndef clone(x): return type(x).from_buffer_copy(raw(x))\ndef fbits(x): return struct.pack('=f', x)\ndef result_bytes(x):\n    return raw(x) if isinstance(x, C.Structure) else (fbits(x) if isinstance(x, float) else x)\ndef same(name, args):\n    vals = [getattr(lib, name)(*args) for lib in libs]\n    exercised.add(name)\n    if result_bytes(vals[0]) \"'!= result_bytes(vals[1]):\n        raise AssertionError((name, result_bytes(vals[0]).hex() if not isinstance(vals[0], int) else vals[0], result_bytes(vals[1]).hex() if not isinstance(vals[1], int) else vals[1]))\n\ndef rf(): return random.uniform(-100.0, 100.0)\ndef rv(): return V(rf(), rf())\ndef rr():\n    a = random.uniform(-math.pi, math.pi)\n    return R(math.cos(a), math.sin(a))\ndef rx(): return X(rv(), rr())\ndef rsv(): return SV(rv(), rv(), rv(), rf(), random.randrange(4), random.randrange(4))\ndef rs(count=None):\n    s = Simplex()\n    for i in range(4): s.verts[i] = rsv()\n    s.div = random.uniform(0.25, 100.0)\n    s.count = random.randrange(1, 4) if count is None else count\n    return s\n\nrandom.seed(0xC2)\nfor _ in range(500):\n    a, b, lo, hi, q, rot, xf = rv(), rv(), rv(), rv(), random.uniform(0.1, 100.0), rr(), rx()\n    same('\"'c2V', [a.x, a.y]); same('c2Mulvs', [a, q]); same('c2Maxv', [a, b]); same('c2Minv', [a, b])\n    same('c2Clampv', [a, lo, hi]); same('c2Sub', [a, b]); same('c2Dot', [a, b]); same('c2Len', [a])\n    same('c2Det2', [a, b]); same('c2Mulrv', [rot, a]); same('c2Add', [a, b]); same('c2Mulxv', [xf, a])\n    same('c2Neg', [a]); same('c2Skew', [a]); same('c2CCW90', [a]); same('c2Div', [a, q]); same('c2Norm', [a])\n    same('c2MulrvT', [rot, a])\nsame('c2RotIdentity', []); same('c2xIdentity', [])\n\nfor _ in range(300):\n    bb0 = AABB(rv(), rv()); bb1 = clone(bb0)\n    out0, out1 = (V * 4)(), (V * 4)()\n    libs[0].c2BBVerts(out0, C.byref(bb0)); libs[1].c2BBVerts(out1, C.byref(bb1)); exercised.add('c2BBVerts')\n    if bytes(out0) \"'!= bytes(out1) or raw(bb0) != raw(bb1): raise AssertionError('\"'c2BBVerts')\n    shapes = [(0, Circle(rv(), abs(rf()))), (1, AABB(rv(), rv())), (2, Capsule(rv(), rv(), abs(rf())))]\n    for typ, shape in shapes:\n        p0, p1 = Proxy(), Proxy(); C.memset(C.byref(p0), 0xA5, C.sizeof(p0)); C.memset(C.byref(p1), 0xA5, C.sizeof(p1))\n        sh0, sh1 = clone(shape), clone(shape)\n        libs[0].c2MakeProxy(C.byref(sh0), typ, C.byref(p0)); libs[1].c2MakeProxy(C.byref(sh1), typ, C.byref(p1)); exercised.add('c2MakeProxy')\n        if raw(p0) \"'!= raw(p1) or raw(sh0) != raw(sh1): raise AssertionError(('\"'c2MakeProxy', typ))\n\nfor count in (1, 2, 3, 4):\n    for _ in range(300):\n        original = rs(count if count < 4 else 4)\n        for name in ('c2GJKSimplexMetric', 'c2D', 'c2L'):\n            s0, s1 = clone(original), clone(original); r0 = getattr(libs[0], name)(C.byref(s0)); r1 = getattr(libs[1], name)(C.byref(s1)); exercised.add(name)\n            if result_bytes(r0) \"'!= result_bytes(r1) or raw(s0) != raw(s1): raise AssertionError((name, count))\n        if count in (2, 3):\n            name = '\"'c22' if count == 2 else 'c23'; s0, s1 = clone(original), clone(original)\n            getattr(libs[0], name)(C.byref(s0)); getattr(libs[1], name)(C.byref(s1)); exercised.add(name)\n            if raw(s0) \"'!= raw(s1): raise AssertionError((name, raw(s0).hex(), raw(s1).hex()))\n        s0, s1 = clone(original), clone(original); a0, b0, a1, b1 = V(), V(), V(), V()\n        libs[0].c2Witness(C.byref(s0), C.byref(a0), C.byref(b0)); libs[1].c2Witness(C.byref(s1), C.byref(a1), C.byref(b1)); exercised.add('\"'c2Witness')\n        if raw(a0) \"'!= raw(a1) or raw(b0) != raw(b1) or raw(s0) != raw(s1): raise AssertionError(('\"'c2Witness', count))\n\nfor _ in range(500):\n    n = random.randrange(1, 9); arr0 = (V * n)(*[rv() for _ in range(n)]); arr1 = (V * n).from_buffer_copy(bytes(arr0)); d = rv()\n    r0 = libs[0].c2Support(arr0, n, d); r1 = libs[1].c2Support(arr1, n, d); exercised.add('c2Support')\n    if r0 \"'!= r1 or bytes(arr0) != bytes(arr1): raise AssertionError('\"'c2Support')\n\ndef shape(typ):\n    if typ == 0: return Circle(rv(), random.uniform(0.0, 30.0))\n    if typ == 1:\n        p = rv(); w, h = random.uniform(0.01, 40.0), random.uniform(0.01, 40.0)\n        return AABB(p, V(p.x + w, p.y + h))\n    return Capsule(rv(), rv(), random.uniform(0.0, 30.0))\n\ndef gjk_pair(ta, tb, use_radius, transforms, warm):\n    sa, sb = shape(ta), shape(tb); xa, xb = (rx(), rx()) if transforms else (None, None)\n    state = []\n    for lib in libs:\n        ca = Cache(); ca.count = 0; oa, ob = V(), V(); it = C.c_int(-99)\n        args = [C.byref(sa), ta, C.byref(xa) if xa else None, C.byref(sb), tb, C.byref(xb) if xb else None,\n                C.byref(oa), C.byref(ob), use_radius, C.byref(it), C.byref(ca)]\n        d = lib.c2GJK(*args)\n        first = (fbits(d), raw(oa), raw(ob), it.value, raw(ca))\n        if warm:\n            oa, ob, it = V(), V(), C.c_int(-99)\n            args[6:10] = [C.byref(oa), C.byref(ob), use_radius, C.byref(it)]\n            d = lib.c2GJK(*args)\n            second = (fbits(d), raw(oa), raw(ob), it.value, raw(ca))\n        else: second = None\n        state.append((first, second))\n    exercised.add('c2GJK')\n    if state[0] \"'!= state[1]: raise AssertionError(('\"'c2GJK', ta, tb, use_radius, transforms, warm, state))\n\nfor ta in range(3):\n    for tb in range(3):\n        for use_radius in (0, 1):\n            for transforms in (False, True):\n                for warm in (False, True):\n                    for _ in range(50): gjk_pair(ta, tb, use_radius, transforms, warm)\n\nfor reverse in (0, 1):\n    for _ in range(100):\n        args = [rf() for _ in range(9)]; a0, b0, a1, b1 = V(123.25, -456.5), V(-2.0, 7.0), V(123.25, -456.5), V(-2.0, 7.0)\n        libs[0].gjk_cache(reverse, C.byref(a0), C.byref(b0), *args); libs[1].gjk_cache(reverse, C.byref(a1), C.byref(b1), *args); exercised.add('gjk_cache')\n        if raw(a0) \"'!= raw(a1) or raw(b0) != raw(b1): raise AssertionError('\"'gjk_cache')\n\nexpected = set(open('c_symbols.txt').read().split())\nif exercised \"'!= expected: raise AssertionError(('\"'coverage', sorted(expected - exercised), sorted(exercised - expected)))\nprint(f'PASS: byte-identical results for all {len(exercised)} exported functions')\nprint('PASS: 3,600 randomized GJK scenarios including cold/warm cache calls')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
