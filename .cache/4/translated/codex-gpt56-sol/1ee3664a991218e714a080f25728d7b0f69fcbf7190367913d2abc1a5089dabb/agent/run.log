{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport ctypes\nimport math\nimport random\nimport struct\nfrom pathlib import Path\n\nroot = Path.cwd()\nc_lib = ctypes.CDLL(str(root / 'c_ref_build/libtranslated_rust.so'))\nr_lib = ctypes.CDLL(str(root / 'target/release/libtranslated_rust.so'))\n\nclass Node(ctypes.Structure):\n    _fields_ = [\n        ('id', ctypes.c_int),\n        ('parent_id', ctypes.c_int),\n        ('name', ctypes.c_char * 50),\n        ('value', ctypes.c_double),\n        ('active', ctypes.c_int),\n    ]\n\nassert ctypes.sizeof(Node) == 80\nassert ctypes.alignment(Node) == 8\nassert [getattr(Node, field).offset for field in ('id', 'parent_id', 'name', 'value', 'active')] == [0, 4, 8, 64, 72]\n\nfor lib in (c_lib, r_lib):\n    lib.add_node.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_char_p, ctypes.c_double]\n    lib.add_node.restype = ctypes.c_int\n    lib.find_node_by_id.argtypes = [ctypes.c_int]\n    lib.find_node_by_id.restype = ctypes.POINTER(Node)\n    lib.get_children_count.argtypes = [ctypes.c_int]\n    lib.get_children_count.restype = ctypes.c_int\n    lib.calculate_subtree_sum.argtypes = [ctypes.c_int]\n    lib.calculate_subtree_sum.restype = ctypes.c_double\n    lib.process_string.argtypes = [ctypes.POINTER(ctypes.c_char)]\n    lib.process_string.restype = ctypes.c_int\n    lib.safe_double_to_int.argtypes = [ctypes.c_double]\n    lib.safe_double_to_int.restype = ctypes.c_int\n    lib.maxnmin.argtypes = [ctypes.c_int] * 4\n    lib.maxnmin.restype = ctypes.c_int\n\n# Floating conversion boundaries, infinities, NaNs, and fractional values.\nfloat_cases = [\n    -math.inf, -2147483649.0, -2147483648.5, -2147483648.0,\n    -1234.75, -0.0, 0.0, 1234.75, 2147483646.9,\n    2147483647.0, 2147483647.5, 2147483648.0, math.inf, math.nan,\n]\nfor value in float_cases:\n    assert c_lib.safe_double_to_int(value) == r_lib.safe_double_to_int(value), value\n\n# Signed-char behavior and arbitrary non-NUL byte sequences.\nfor raw in [b'', b'a', b'root', bytes([0x7f]), bytes([0x80]), bytes([0xff, 1, 2]), bytes(range(1, 255))]:\n    c_buf = ctypes.create_string_buffer(raw + b'\\\\0')\n    r_buf = ctypes.create_string_buffer(raw + b'\\\\0')\n    assert c_lib.process_string(c_buf) == r_lib.process_string(r_buf), raw\n\n# Deterministic edge cases plus randomized full-width integer inputs.\nint_min, int_max = -(2**31), 2**31 - 1\nmax_cases = [\n    (0, 0, 0, 0), (1, 2, 3, 4), (-1, -2, -3, -4),\n    (int_min, int_max, -1, int_min), (int_max, int_max, int_max, int_max),\n    (int_min, int_min, int_min, int_min), (6, 12, -1, 9),\n]\nrng = random.Random(0xC0FFEE)\nmax_cases.extend(tuple(rng.randint(int_min, int_max) for _ in range(4)) for _ in range(20000))\nfor index, args in enumerate(max_cases):\n    c_value = c_lib.maxnmin(*args)\n    r_value = r_lib.maxnmin(*args)\n    assert c_value == r_value, (index, args, c_value, r_value)\n\n# Reset, compare all built-in nodes byte-for-byte, then exercise external mutations.\nassert c_lib.maxnmin(0, 0, 0, 0) == r_lib.maxnmin(0, 0, 0, 0)\nfor node_id in range(1, 7):\n    c_node = c_lib.find_node_by_id(node_id)\n    r_node = r_lib.find_node_by_id(node_id)\n    assert bool(c_node) == bool(r_node)\n    assert ctypes.string_at(c_node, 80) == ctypes.string_at(r_node, 80), node_id\n\nnames = [b'x', b'a\\\\0ignored', b'z' * 49, b'q' * 80]\nfor offset, name in enumerate(names, 20):\n    c_index = c_lib.add_node(offset, 1, name, offset + 0.25)\n    r_index = r_lib.add_node(offset, 1, name, offset + 0.25)\n    assert c_index == r_index\n    c_node = c_lib.find_node_by_id(offset)\n    r_node = r_lib.find_node_by_id(offset)\n    assert ctypes.string_at(c_node, 80) == ctypes.string_at(r_node, 80), name\n\nfor parent in range(-3, 25):\n    assert c_lib.get_children_count(parent) == r_lib.get_children_count(parent), parent\nfor node_id in list(range(-3, 10)) + list(range(20, 24)):\n    c_sum = c_lib.calculate_subtree_sum(node_id)\n    r_sum = r_lib.calculate_subtree_sum(node_id)\n    assert struct.pack('=d', c_sum) == struct.pack('=d', r_sum), node_id\n\n# Both began with ten occupied slots; fill through the exact 100-node limit.\nfor node_id in range(1000, 1095):\n    c_index = c_lib.add_node(node_id, -99, b'capacity', -0.5)\n    r_index = r_lib.add_node(node_id, -99, b'capacity', -0.5)\n    assert c_index == r_index, (node_id, c_index, r_index)\nassert c_lib.add_node(9999, 0, b'full', 1.0) == -1\nassert r_lib.add_node(9999, 0, b'full', 1.0) == -1\n\nprint(f'PASS: Node ABI + {len(float_cases)} float + 7 string + {len(max_cases)} maxnmin cases + stateful API checks')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
