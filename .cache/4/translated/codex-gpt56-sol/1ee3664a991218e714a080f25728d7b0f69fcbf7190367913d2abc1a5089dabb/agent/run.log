\n    39\t} Node;\r\n    40\t\r\n    41\tstatic Node node_storage[MAX_NODES];\r\n    42\tstatic int node_count = 0;\r\n    43\t\r\n    44\tint add_node(int id, int parent_id, const char *name, double value) {\r\n    45\t    if (node_count >= MAX_NODES) {\r\n    46\t        return -1;\r\n    47\t    }\r\n    48\t\r\n    49\t    Node new_node = {\r\n    50\t        .id = id,\r\n    51\t        .parent_id = parent_id,\r\n    52\t        .value = value,\r\n    53\t        .active = 1\r\n    54\t    };\r\n    55\t\r\n    56\t    strncpy(new_node.name, name, MAX_NAME_LEN - 1);\r\n    57\t    new_node.name[MAX_NAME_LEN - 1] = '\\0';\r\n    58\t\r\n    59\t    node_storage[node_count++] = new_node;\r\n    60\t    return node_count - 1;\r\n    61\t}\r\n    62\t\r\n    63\tNode* find_node_by_id(int id) {\r\n    64\t    for (int i = 0; i < node_count; i++) {\r\n    65\t        if (node_storage[i].id == id && node_storage[i].active) {\r\n    66\t            return &node_storage[i];\r\n    67\t        }\r\n    68\t    }\r\n    69\t    return NULL;\r\n    70\t}\r\n    71\t\r\n    72\tint get_children_count(int parent_id) {\r\n    73\t    int count = 0;\r\n    74\t    for (int i = 0; i < node_count; i++) {\r\n    75\t        if (node_storage[i].parent_id == parent_id && node_storage[i].active) {\r\n    76\t            count++;\r\n    77\t        }\r\n    78\t    }\r\n    79\t    return count;\r\n    80\t}\r\n    81\t\r\n    82\tdouble calculate_subtree_sum(int node_id) {\r\n    83\t    Node *node = find_node_by_id(node_id);\r\n    84\t    if (node == NULL) {\r\n    85\t        return 0.0;\r\n    86\t    }\r\n    87\t\r\n    88\t    double sum = node->value;\r\n    89\t\r\n    90\t    for (int i = 0; i < node_count; i++) {\r\n    91\t        if (node_storage[i].parent_id == node_id && node_storage[i].active) {\r\n    92\t            sum += calculate_subtree_sum(node_storage[i].id);\r\n    93\t        }\r\n    94\t    }\r\n    95\t\r\n    96\t    return sum;\r\n    97\t}\r\n    98\t\r\n    99\tint process_string(char *str) {\r\n   100\t    int result = 0;\r\n   101\t\r\n   102\t    if (*str) {\r\n   103\t        while (*str) {\r\n   104\t            result += (int)(*str);\r\n   105\t            str++;\r\n   106\t        }\r\n   107\t    }\r\n   108\t\r\n   109\t    return result;\r\n   110\t}\r\n   111\t\r\n   112\tint safe_double_to_int(double d) {\r\n   113\t    if (d > (double)INT_MAX) {\r\n   114\t        return INT_MAX;\r\n   115\t    }\r\n   116\t    if (d < (double)INT_MIN) {\r\n   117\t        return INT_MIN;\r\n   118\t    }\r\n   119\t\r\n   120\t    if (d != d) {\r\n   121\t        return 0;\r\n   122\t    }\r\n   123\t\r\n   124\t    return (int)d;\r\n   125\t}\r\n   126\t\r\n   127\tint maxnmin(int param1, int param2, int param3, int param4) {\r\n   128\t    int result = 0;\r\n   129\t\r\n   130\t    node_count = 0;\r\n   131\t\r\n   132\t    add_node(1, -1, \"root\", 10.5);\r\n   133\t    add_node(2, 1, \"child1\", 20.7);\r\n   134\t    add_node(3, 1, \"child2\", 15.3);\r\n   135\t    add_node(4, 2, \"grandchild1\", 5.9);\r\n   136\t    add_node(5, 2, \"grandchild2\", 8.2);\r\n   137\t    add_node(6, 3, \"grandchild3\", 12.4);\r\n   138\t\r\n   139\t    int node_id = (param1 % 6) + 1;\r\n   140\t    Node *selected_node = find_node_by_id(node_id);\r\n   141\t\r\n   142\t    if (selected_node != NULL) {\r\n   143\t        char *name_ptr = selected_node->name;\r\n   144\t\r\n   145\t        if (*name_ptr) {\r\n   146\t            result += process_string(name_ptr);\r\n   147\t        }\r\n   148\t\r\n   149\t        double subtree_sum = calculate_subtree_sum(node_id);\r\n   150\t\r\n   151\t        int sum_as_int = safe_double_to_int(subtree_sum);\r\n   152\t        result += sum_as_int;\r\n   153\t    }\r\n   154\t\r\n   155\t    int second_node_id = (param2 % 6) + 1;\r\n   156\t    Node *second_node = find_node_by_id(second_node_id);\r\n   157\t\r\n   158\t    if (second_node != NULL) {\r\n   159\t        double value_multiplied =