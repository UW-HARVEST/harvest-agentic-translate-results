tr = array + size;\r\n    79\t    start = array + start_offset;\r\n    80\t\r\n    81\t    while (ptr > start) {\r\n    82\t        ptr--;\r\n    83\t        sum += *ptr;\r\n    84\t    }\r\n    85\t\r\n    86\t    return sum;\r\n    87\t}\r\n    88\t\r\n    89\tstatic int compute_size_metric(const char *str) {\r\n    90\t    size_t len = strlen(str);\r\n    91\t    int metric;\r\n    92\t\r\n    93\t    metric = (int)len;\r\n    94\t\r\n    95\t    metric = metric * 2 + 010;\r\n    96\t\r\n    97\t    return metric;\r\n    98\t}\r\n    99\t\r\n   100\tstatic int safe_double_to_int(double value) {\r\n   101\t    if (value > 2147483647.0) {\r\n   102\t        value = 2147483647.0;\r\n   103\t    }\r\n   104\t    if (value < -2147483648.0) {\r\n   105\t        value = -2147483648.0;\r\n   106\t    }\r\n   107\t\r\n   108\t    return (int)value;\r\n   109\t}\r\n   110\t\r\n   111\tint jumpnode(int operation_mode, int node_id, int depth, int flags) {\r\n   112\t    Node *current_node;\r\n   113\t    Node *parent_node;\r\n   114\t    int result = 0;\r\n   115\t    int i;\r\n   116\t    double accumulated_value;\r\n   117\t    int temp_array[20];\r\n   118\t    size_t array_size;\r\n   119\t    char buffer[50];\r\n   120\t\r\n   121\t    switch (operation_mode) {\r\n   122\t        case 0001:\r\n   123\t            current_node = find_node_by_id(node_id);\r\n   124\t            if (current_node == NULL) {\r\n   125\t                return STATUS_ERROR | 0020;\r\n   126\t            }\r\n   127\t\r\n   128\t            accumulated_value = current_node->value;\r\n   129\t\r\n   130\t            for (i = 0; i < depth && current_node->parent_id != -1; i++) {\r\n   131\t                parent_node = find_node_by_id(current_node->parent_id);\r\n   132\t                if (parent_node == NULL) {\r\n   133\t                    break;\r\n   134\t                }\r\n   135\t\r\n   136\t                accumulated_value += parent_node->value * 1.5;\r\n   137\t                current_node = parent_node;\r\n   138\t            }\r\n   139\t\r\n   140\t            result = safe_double_to_int(accumulated_value);\r\n   141\t            break;\r\n   142\t\r\n   143\t        case 0002:\r\n   144\t            current_node = find_node_by_id(node_id);\r\n   145\t            if (current_node == NULL) {\r\n   146\t                return STATUS_ERROR | 0040;\r\n   147\t            }\r\n   148\t\r\n   149\t            for (i = 0; i < 4; i++) {\r\n   150\t                temp_array[i] = current_node->data[i];\r\n   151\t            }\r\n   152\t\r\n   153\t            for (i = 4; i < 020; i++) {\r\n   154\t                temp_array[i] = i * 0007;\r\n   155\t            }\r\n   156\t\r\n   157\t            array_size = 020;\r\n   158\t\r\n   159\t            result = process_backward(temp_array, array_size, depth);\r\n   160\t\r\n   161\t            result += (int)array_size * flags;\r\n   162\t            break;\r\n   163\t\r\n   164\t        case 0003:\r\n   165\t            sprintf(buffer, \"Node_%d_Depth_%d\", node_id, depth);\r\n   166\t\r\n   167\t            result = compute_size_metric(buffer);\r\n   168\t\r\n   169\t            result += (flags & 0177); /* Mask with octal 0177 */\r\n   170\t            break;\r\n   171\t\r\n   172\t        case 0004:\r\n   173\t            current_node = find_node_by_id(node_id);\r\n   174\t            if (current_node == NULL) {\r\n   175\t                return STATUS_ERROR | 0100;\r\n   176\t            }\r\n   177\t\r\n   178\t            accumulated_value = 0.0;\r\n   179\t            for (i = 0; i < 4; i++) {\r\n   180\t                accumulated_value += sqrt((double)current_node->data[i]) * 2.718281828;\r\n   181\t            }\r\n   182\t\r\n   183\t            accumulated_value *= (1.0 + depth * 0.1);\r\n   184\t\r\n   185\t            result = safe_double_to_int(accumulated_value);\r\n   186\t\r\n   187\t            if (node_count > 2) {\r\n   188\t                Node *end_ptr = &node_storage[node_coun