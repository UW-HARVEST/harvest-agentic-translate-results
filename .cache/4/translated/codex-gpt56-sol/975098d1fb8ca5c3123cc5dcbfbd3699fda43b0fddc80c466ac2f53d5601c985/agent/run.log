{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"ls -l src src/main.rs; wc -l -c src/main.rs; grep -c '\"'^fn main()'\"' src/main.rs; grep -c '\"'^fn run('\"' src/main.rs; grep -c '\"'^fn scan_decimal_int'\"' src/main.rs; sed -n '1,140p' src/main.rs\"","aggregated_output":"-rw-r--r--. 1 scheschb amazon 2094 Aug 24 20:02 src/main.rs\n\nsrc:\ntotal 4\n-rw-r--r--. 1 scheschb amazon 2094 Aug 24 20:02 main.rs\n  82 2094 src/main.rs\n1\n1\n1\nuse std::io::{self, Read, Write};\n\nstruct House {\n    floors: i32,\n    bedrooms: i32,\n    bathrooms: f64,\n}\n\nfn scan_decimal_int(input: &[u8]) -> Option<i32> {\n    let mut index = 0;\n    while input.get(index).is_some_and(u8::is_ascii_whitespace) {\n        index += 1;\n    }\n\n    let negative = match input.get(index) {\n        Some(b'+') => {\n            index += 1;\n            false\n        }\n        Some(b'-') => {\n            index += 1;\n            true\n        }\n        _ => false,\n    };\n\n    if !input.get(index).is_some_and(u8::is_ascii_digit) {\n        return None;\n    }\n\n    let mut value = 0_i32;\n    while let Some(digit) = input.get(index).filter(|byte| byte.is_ascii_digit()) {\n        value = value\n            .wrapping_mul(10)\n            .wrapping_add(i32::from(**digit - b'0'));\n        index += 1;\n    }\n\n    Some(if negative { value.wrapping_neg() } else { value })\n}\n\nfn add_floor(house: &mut House) {\n    house.floors = house.floors.wrapping_add(1);\n}\n\nfn add_bedrooms(house: &mut House, extra_bedrooms: i32) {\n    house.bedrooms = house.bedrooms.wrapping_add(extra_bedrooms);\n}\n\nfn print_house(output: &mut impl Write, house: &House) -> io::Result<()> {\n    writeln!(\n        output,\n        \"The house has {} floors, {} bedrooms, and {:.1} bathrooms\",\n        house.floors, house.bedrooms, house.bathrooms\n    )\n}\n\nfn run(output: &mut impl Write, house: &mut House, extra_bedrooms: i32) -> io::Result<()> {\n    print_house(output, house)?;\n    add_floor(house);\n    print_house(output, house)?;\n    house.bathrooms += 1.0;\n    print_house(output, house)?;\n    add_bedrooms(house, extra_bedrooms);\n    print_house(output, house)\n}\n\nfn main() -> io::Result<()> {\n    let mut input = Vec::new();\n    io::stdin().read_to_end(&mut input)?;\n    let extra_bedrooms = scan_decimal_int(&input).unwrap_or(0);\n\n    let mut house = House {\n        floors: 2,\n        bedrooms: 5,\n        bathrooms: 2.5,\n    };\n    let mut output = io::BufWriter::new(io::stdout().lock());\n\n    run(&mut output, &mut house, extra_bedrooms)?;\n    run(&mut output, &mut house, extra_bedrooms)\n}\n","exit_code":0,"status":"completed"}}
