{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_gqmrjmsod6qhzth7mvtf2suynbdtejusn63jx6vngpncekygiipq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_0154bxPSwTj7hJLko7zffQte","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-AesDK8/translated_rust/tests/inflate_dynamic.rs","content":"//! Phase B — CONFIGS.md rows D1..D13 (BTYPE 2, dynamic Huffman blocks).\n//!\n//! Drives `cp_dynamic` (all of `HLIT`/`HDIST`/`HCLEN` and all four arms of the\n//! code-length `switch`), all three `cp_build` invocations, `cp_decode` on\n//! three different trees, and `cp_block` — through the exported `cp_inflate`.\n\nmod common;\n\nuse common::deflate::*;\nuse common::*;\nuse std::os::raw::c_int;\n\n#[track_caller]\nfn check_dyn(c: &Impl, r: &Impl, d: &Dynamic, items: &[Item], label: &str, arena: usize) {\n    let n = out_size(items);\n    let stream = d.only(true, items);\n    for off in 0..4usize {\n        let case = InflateCase::new(stream.clone(), n as c_int).in_off(off);\n        assert_inflate_eq_arena(c, r, &case, &format!(\"{label} off={off}\"), arena);\n    }\n    if let Some(expect) = simulate(items) {\n        let case = InflateCase::new(stream, n as c_int);\n        let rc = run_inflate(c, &case, arena);\n        assert_eq!(rc.ret, 1, \"[{label}] C returned {}: {rc:?}\", rc.ret);\n        assert_eq!(\n            &rc.out_arena[..expect.len()],\n            &expect[..],\n            \"[{label}] C output disagrees with the reference model\"\n        );\n    }\n}\n\n// ---------------------------------------------------------------------------\n// D1 — minimal dynamic block: HLIT=257, HDIST=1, HCLEN=4\n// ---------------------------------------------------------------------------\n\n#[test]\nfn d1_minimal_dynamic_block() {\n    let (c, r) = load_both();\n    // Two literals + EOB, and a single (unused) distance code.\n    let lens = lens_for(257, 1, &[b'A' as usize, b'B' as usize, 256], &[0]);\n    let d = dynamic_from_lens(257, 1, &lens);\n    assert_eq!(d.nlit, 257);\n    assert_eq!(d.ndst, 1);\n\n    check_dyn(&c, &r, &d, &[], \"D1 empty\", 8192);\n    check_dyn(&c, &r, &d, &[Item::Lit(b'A')], \"D1 one\", 8192);\n    check_dyn(\n        &c,\n        &r,\n        &d,\n        &[Item::Lit(b'A'), Item::Lit(b'B'), Item::Lit(b'A')],\n        \"D1 three\",\n        8192,\n    );\n\n    // Randomised literal sequences.\n    let mut rng = SplitMix::new(0xD101);\n    for i in 0..200 {\n        let n = 1 + rng.below(64) as usize;\n        let items: Vec<Item> = (0..n)\n            .map(|_| Item::Lit(if rng.below(2) == 0 { b'A' } else { b'B' }))\n            .collect();\n        check_dyn(&c, &r, &d, &items, &format!(\"D1 rand#{i}\"), 8192);\n    }\n\n    // HCLEN really is 4 for at least one construction (4 distinct cl symbols).\n    let lens4 = lens_for(257, 1, &[b'A' as usize, 256], &[0]);\n    let d4 = dynamic_from_lens(257, 1, &lens4);\n    check_dyn(&c, &r, &d4, &[Item::Lit(b'A')], \"D1 hclen-min\", 8192);\n    assert!(d4.nlen >= 4, \"HCLEN must be >= 4\");\n}\n\n// ---------------------------------------------------------------------------\n// D2 — HCLEN = 19 (all 19 permutation slots transmitted)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn d2_hclen_19() {\n    let (c, r) = load_both();\n    let lens = lens_for(257, 1, &[b'x' as usize, b'y' as usize, 256], &[0]);\n    let d = dynamic_from_lens(257, 1, &lens).with_nlen(19);\n    assert_eq!(d.nlen, 19);\n    check_dyn(\n        &c,\n        &r,\n        &d,\n        &[Item::Lit(b'x'), Item::Lit(b'y')],\n        \"D2 hclen=19\",\n        8192,\n    );\n\n    // Every HCLEN from 4 to 19 (the trailing slots are transmitted as zero).\n    for nlen in 4..=19usize {\n        let dd = dynamic_from_lens(257, 1, &lens).with_nlen(nlen);\n        if dd.nlen != nlen {\n            continue;\n        }\n        check_dyn(&c, &r, &dd, &[Item::Lit(b'x')], &format!(\"D2 hclen={nlen}\"), 8192);\n    }\n}\n\n// ---------------------------------------------------------------------------\n// D3 — HLIT = 288, HDIST = 32 (the maxima)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn d3_hlit_hdist_maxima() {\n    let (c, r) = load_both();\n    let nlit = 288usize;\n    let ndst = 32usize;\n\n    // Give codes to a handful of literals plus all 32 distance symbols, so the\n    // `cp_build(0, s->dst, lens + nlit, 32)` call sees a full distance table.\n    let mut lens = vec![0u8; nlit + ndst];\n    let lit_syms: Vec<usize> = vec![b'a' as usize, b'b' as usize, 256, 257, 287];\n    let l = min_len(lit_syms.len());\n    for &s in &lit_syms {\n        lens[s] = l;\n    }\n    for s in 0..ndst {\n        lens[nlit + s] = 5; // 32 symbols of length 5 == a complete code\n    }\n    let d = dynamic_rle(nlit, ndst, &lens);\n    assert_eq!(d.nlit, 288);\n    assert_eq!(d.ndst, 32);\n\n    check_dyn(\n        &c,\n        &r,\n        &d,\n        &[Item::Lit(b'a'), Item::Lit(b'b'), Item::Lit(b'a')],\n        \"D3 maxima literals\",\n        8192,\n    );\n    // Use length symbol 257 (len 3) and 287 (len 0) with several distances.\n    for dist_sym in [0usize, 1, 5, 29, 30, 31] {\n        let nextra = DIST_EXTRA[dist_sym] as u32;\n        let dist_extra = (1u32 << nextra) - 1;\n        let dist = DIST_BASE[dist_sym] + dist_extra;\n        let mut items = if dist == 0 {\n            vec![Item::Lit(b'a'), Item::Lit(b'b')]\n        } else {\n            fill_items_with(dist as usize, b'a', b'b')\n        };\n        items.push(Item::Match {\n            len_sym: 257,\n            len_extra: 0,\n            dist_sym,\n            dist_extra,\n        });\n        let arena = if dist > 60 * 1024 { ARENA } else { 128 * 1024 };\n        check_dyn(&c, &r, &d, &items, &format!(\"D3 dist_sym={dist_sym}\"), arena);\n    }\n    // Length symbol 287 (cp_len_base == 0).\n    let items = vec![\n        Item::Lit(b'a'),\n        Item::Lit(b'b'),\n        Item::Match {\n            len_sym: 287,\n            len_extra: 0,\n            dist_sym: 0,\n            dist_extra: 0,\n        },\n        Item::Lit(b'a'),\n    ];\n    check_dyn(&c, &r, &d, &items, \"D3 len_sym=287\", 8192);\n}\n\n/// Build exactly `n` bytes of output using only literals `a`/`b` and\n/// distance-1 runs (needed where only two literal codes exist).\nfn fill_items_with(n: usize, a: u8, b: u8) -> Vec<Item> {\n    let mut items = Vec::new();\n    let mut produced = 0usize;\n    while produced < n {\n        if produced == 0 {\n            items.push(Item::Lit(a));\n            produced = 1;\n        } else if produced == 1 && n > 1 {\n            items.push(Item::Lit(b));\n            produced = 2;\n        } else {\n            let remain = n - produced;\n            if remain >= 258 {\n                items.push(match_item_257(258));\n                produced += 258;\n            } else if remain >= 3 {\n                items.push(match_item_257(remain as u32));\n                produced += remain;\n            } else {\n                items.push(Item::Lit(a));\n                produced += 1;\n            }\n        }\n    }\n    items\n}\n\n/// A distance-1 match whose length symbol is 257 + k, all with `dist_sym = 0`.\nfn match_item_257(len: u32) -> Item {\n    let (len_sym, len_extra) = len_code(len);\n    Item::Match {\n        len_sym,\n        len_extra,\n        dist_sym: 0,\n        dist_extra: 0,\n    }\n}\n\n// ---------------------------------------------------------------------------\n// D4, D5, D6 — code-length symbols 16, 17 and 18\n// ---------------------------------------------------------------------------\n\n/// D4 — symbol 16 (repeat previous length), every repeat count 3..6.\n#[test]\nfn d4_code_length_symbol_16() {\n    let (c, r) = load_both();\n    for repeat in 3..=6u32 {\n        // Build cl instructions explicitly so exactly one `16` with this extra\n        // value appears.\n        let nlit = 257usize;\n        let ndst = 1usize;\n        // lens: symbol 0 length 0, then a run of `repeat + 1` equal lengths.\n        let mut lens = vec![0u8; nlit + ndst];\n        // 'a'..'a'+repeat all get length `l`; plus EOB.\n        let l = min_len(repeat as usize + 2);\n        for k in 0..=repeat as usize {\n            lens[b'a' as usize + k] = l;\n        }\n        lens[256] = l;\n        lens[nlit] = 1; // one distance code\n        let instrs = build_16_instrs(&lens, repeat);\n        let cl = cl_lens_for(&instrs);\n        let d = Dynamic::new(nlit, ndst, cl, instrs);\n        assert!(\n            d.instrs.iter().any(|&(s, e)| s == 16 && e == repeat - 3),\n            \"code-length symbol 16 with extra {} not emitted\",\n            repeat - 3\n        );\n        let items: Vec<Item> = (0..=repeat as u8)\n            .map(|k| Item::Lit(b'a' + k))\n            .chain(std::iter::once(Item::Lit(b'a')))\n            .collect();\n        check_dyn(&c, &r, &d, &items, &format!(\"D4 repeat={repeat}\"), 8192);\n    }\n}\n\n/// Encode `lens` so that a `16` with exactly `repeat` copies is used for the\n/// run of equal non-zero lengths.\nfn build_16_instrs(lens: &[u8], repeat: u32) -> Vec<ClInstr> {\n    // rle_encode already prefers 16 for runs >= 4; verify it produced one with\n    // the requested count, otherwise construct it by hand.\n    let auto = rle_encode(lens);\n    if auto.iter().any(|&(s, e)| s == 16 && e == repeat - 3) {\n        return auto;\n    }\n    // Hand construction: emit the first length literally, then a single 16.\n    let mut out: Vec<ClInstr> = Vec::new();\n    let mut i = 0usize;\n    while i < lens.len() {\n        let v = lens[i];\n        let mut run = 1usize;\n        while i + run < lens.len() && lens[i + run] == v {\n            run += 1;\n        }\n        if v != 0 && run == repeat as usize + 1 {\n            out.push((v, 0));\n            out.push((16, repeat - 3));\n            i += run;\n        } else if v == 0 {\n            for _ in 0..run {\n                out.push((0, 0));\n            }\n            i += run;\n        } else {\n            for _ in 0..run {\n                out.push((v, 0));\n            }\n            i += run;\n        }\n    }\n    assert_eq!(expand_cl(&out), lens);\n    out\n}\n\n/// D5 — symbol 17 (zero run 3..10), every run length.\n#[test]\nfn d5_code_length_symbol_17() {\n    let (c, r) = load_both();\n    for run in 3..=10u32 {\n        let nlit = 257usize;\n        let ndst = 1usize;\n        let mut lens = vec![0u8; nlit + ndst];\n        // A non-zero length, then exactly `run` zeros, then more non-zeros.\n        lens[0] = 2;\n        for k in 0..run as usize {\n            lens[1 + k] = 0;\n        }\n        lens[1 + run as usize] = 2;\n        lens[2 + run as usize] = 2;\n        lens[256] = 2;\n        lens[nlit] = 1;\n        let instrs = build_17_instrs(&lens, run);\n        let cl = cl_lens_for(&instrs);\n        let d = Dynamic::new(nlit, ndst, cl, instrs);\n        assert!(\n            d.instrs.iter().any(|&(s, e)| s == 17 && e == run - 3),\n            \"code-length symbol 17 with extra {} not emitted\",\n            run - 3\n        );\n        let a = 0u8;\n        let b = (1 + run) as u8;\n        check_dyn(\n            &c,\n            &r,\n            &d,\n            &[Item::Lit(a), Item::Lit(b), Item::Lit(a)],\n            &format!(\"D5 run={run}\"),\n            8192,\n        );\n    }\n}\n\nfn build_17_instrs(lens: &[u8], run: u32) -> Vec<ClInstr> {\n    let mut out: Vec<ClInstr> = Vec::new();\n    let mut i = 0usize;\n    while i < lens.len() {\n        let v = lens[i];\n        let mut n = 1usize;\n        while i + n < lens.len() && lens[i + n] == v {\n            n += 1;\n        }\n        if v == 0 && n == run as usize {\n            out.push((17, run - 3));\n            i += n;\n        } else if v == 0 {\n            let mut left = n;\n            while left >= 11 {\n                let k = left.min(138);\n                out.push((18, (k - 11) as u32));\n                left -= k;\n            }\n            while left >= 3 {\n                let k = left.min(10);\n                out.push((17, (k - 3) as u32));\n                left -= k;\n            }\n            for _ in 0..left {\n                out.push((0, 0));\n            }\n            i += n;\n        } else {\n            for _ in 0..n {\n                out.push((v, 0));\n            }\n            i += n;\n        }\n    }\n    assert_eq!(expand_cl(&out), lens);\n    out\n}\n\n/// D6 — symbol 18 (zero run 11..138), a sweep over the run length.\n#[test]\nfn d6_code_length_symbol_18() {\n    let (c, r) = load_both();\n    for run in [11u32, 12, 20, 64, 100, 137, 138] {\n        let nlit = 257usize;\n        let ndst = 1usize;\n        let mut lens = vec![0u8; nlit + ndst];\n        lens[0] = 2;\n        lens[1 + run as usize] = 2;\n        lens[2 + run as usize] = 2;\n        lens[256] = 2;\n        lens[nlit] = 1;\n        let instrs = build_18_instrs(&lens, run);\n        let cl = cl_lens_for(&instrs);\n        let d = Dynamic::new(nlit, ndst, cl, instrs);\n        assert!(\n            d.instrs.iter().any(|&(s, e)| s == 18 && e == run - 11),\n            \"code-length symbol 18 with extra {} not emitted\",\n            run - 11\n        );\n        check_dyn(\n            &c,\n            &r,\n            &d,\n            &[Item::Lit(0), Item::Lit((1 + run) as u8), Item::Lit(0)],\n            &format!(\"D6 run={run}\"),\n            8192,\n        );\n    }\n}\n\nfn build_18_instrs(lens: &[u8], run: u32) -> Vec<ClInstr> {\n    let mut out: Vec<ClInstr> = Vec::new();\n    let mut i = 0usize;\n    while i < lens.len() {\n        let v = lens[i];\n        let mut n = 1usize;\n        while i + n < lens.len() && lens[i + n] == v {\n            n += 1;\n        }\n        if v == 0 && n == run as usize {\n            out.push((18, run - 11));\n            i += n;\n        } else if v == 0 {\n            let mut left = n;\n            while left >= 11 {\n                let k = left.min(138);\n                out.push((18, (k - 11) as u32));\n                left -= k;\n            }\n            while left >= 3 {\n                let k = left.min(10);\n                out.push((17, (k - 3) as u32));\n                left -= k;\n            }\n            for _ in 0..left {\n                out.push((0, 0));\n            }\n            i += n;\n        } else {\n            for _ in 0..n {\n                out.push((v, 0));\n            }\n            i += n;\n        }\n    }\n    assert_eq!(expand_cl(&out), lens);\n    out\n}\n\n// ---------------------------------------------------------------------------\n// D7 — literal code lengths 10..15 (`cp_build`'s `len <= 9` branch NOT taken)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn d7_deep_code_lengths() {\n    let (c, r) = load_both();\n    for nsym in 2..=16usize {\n        let nlit = 257usize;\n        let ndst = 1usize;\n        // A complete code with lengths 1,2,...,nsym-1,nsym-1.\n        let mut lit_syms: Vec<usize> = (0..nsym - 1).map(|k| b'a' as usize + k).collect();\n        lit_syms.push(256); // EOB gets the deepest code\n        let lens = deep_lens(nlit, ndst, &lit_syms, &[0]);\n        let max_len = *lens.iter().max().unwrap();\n        let d = dynamic_rle(nlit, ndst, &lens);\n        // The literals that exist.\n        let items: Vec<Item> = (0..nsym - 1)\n            .map(|k| Item::Lit(b'a' + k as u8))\n            .collect();\n        check_dyn(\n            &c,\n            &r,\n            &d,\n            &items,\n            &format!(\"D7 nsym={nsym} max_len={max_len}\"),\n            8192,\n        );\n        if nsym == 16 {\n            assert_eq!(max_len, 15, \"expected a 15-bit code for 16 symbols\");\n        }\n    }\n\n    // Also make sure a >9-bit code length is transmitted for a *distance*\n    // symbol, so `cp_build(0, s->dst, ...)` (the `s == NULL` call) sees one.\n    let nlit = 257usize;\n    let ndst = 16usize;\n    let dist_syms: Vec<usize> = (0..16).collect();\n    let lens = deep_lens(nlit, ndst, &[b'a' as usize, 257, 256], &dist_syms);\n    assert!(lens[nlit..].iter().any(|&l| l > 9));\n    let d = dynamic_rle(nlit, ndst, &lens);\n    // Use the deepest distance symbol (15) — it needs enough prior output.\n    let items = vec![\n        Item::Lit(b'a'),\n        Item::Match {\n            len_sym: 257,\n            len_extra: 0,\n            dist_sym: 0,\n            dist_extra: 0,\n        },\n        Item::Match {\n            len_sym: 257,\n            len_extra: 0,\n            dist_sym: 15,\n            dist_extra: (1u32 << DIST_EXTRA[15]) - 1,\n        },\n    ];\n    // dist_sym 15 => base 193, so we need >= 193 bytes first.\n    let mut items2 = vec![Item::Lit(b'a')];\n    while out_size(&items2) < 400 {\n        items2.push(Item::Match {\n            len_sym: 257,\n            len_extra: 0,\n            dist_sym: 0,\n            dist_extra: 0,\n        });\n    }\n    items2.push(Item::Match {\n        len_sym: 257,\n        len_extra: 0,\n        dist_sym: 15,\n        dist_extra: (1u32 << DIST_EXTRA[15]) - 1,\n    });\n    let _ = items;\n    check_dyn(&c, &r, &d, &items2, \"D7 deep distance code\", 8192);\n}\n\n// ---------------------------------------------------------------------------\n// D8 — real-encoder dynamic blocks (flate2, best/default)\n// ---------------------------------------------------------------------------\n\nfn deflate_raw(data: &[u8], level: u32) -> Vec<u8> {\n    use flate2::write::DeflateEncoder;\n    use flate2::Compression;\n    use std::io::Write;\n    let mut e = DeflateEncoder::new(Vec::new(), Compression::new(level));\n    e.write_all(data).unwrap();\n    e.finish().unwrap()\n}\n\nfn payloads(rng: &mut SplitMix) -> Vec<(String, Vec<u8>)> {\n    let mut v: Vec<(String, Vec<u8>)> = Vec::new();\n    v.push((\"empty\".into(), vec![]));\n    v.push((\"one\".into(), vec![0x42]));\n    v.push((\"run64k\".into(), vec![0x33; 60000]));\n    v.push((\n        \"struct\".into(),\n        (0..40000u32).map(|i| ((i / 7) % 251) as u8).collect(),\n    ));\n    v.push((\n        \"text\".into(),\n        b\"Lorem ipsum dolor sit amet, consectetur adipiscing elit. \"\n            .iter()\n            .cycle()\n            .take(30000)\n            .cloned()\n            .collect(),\n    ));\n    for n in [1usize, 2, 3, 5, 9, 17, 33, 65, 129, 257, 1000, 5000, 20000] {\n        v.push((format!(\"rand{n}\"), rng.bytes(n)));\n        v.push((\n            format!(\"lowent{n}\"),\n            (0..n).map(|_| b'a' + rng.below(6) as u8).collect(),\n        ));\n        v.push((\n            format!(\"sparse{n}\"),\n            (0..n)\n                .map(|i| if i % 97 == 0 { rng.next_u32() as u8 } else { 0 })\n                .collect(),\n        ));\n    }\n    v\n}\n\n#[test]\nfn d8_flate2_dynamic_streams() {\n    let (c, r) = load_both();\n    let mut rng = SplitMix::new(0xD808);\n    for (name, data) in payloads(&mut rng) {\n        for level in [6u32, 9] {\n            let stream = deflate_raw(&data, level);\n            let case = InflateCase::new(stream.clone(), data.len() as c_int);\n            assert_inflate_eq(&c, &r, &case, &format!(\"D8 {name} lvl={level}\"));\n            let rc = run_inflate(&c, &case, ARENA);\n            if rc.ret == 1 && data.len() > 3 {\n                assert_eq!(\n                    &rc.out_arena[..data.len()],\n                    &data[..],\n                    \"D8 {name} lvl={level}: C did not round-trip\"\n                );\n            }\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// D9 — D8 payloads × alignment × tail sweep\n// ---------------------------------------------------------------------------\n\n#[test]\nfn d9_alignment_and_tail_sweep() {\n    let (c, r) = load_both();\n    let mut rng = SplitMix::new(0xD909);\n    // Sizes 1..48 so `in_bytes` covers every residue mod 4 many times over.\n    for n in 1..=48usize {\n        let data: Vec<u8> = (0..n).map(|_| b'a' + rng.below(7) as u8).collect();\n        for level in [6u32, 9] {\n            let stream = deflate_raw(&data, level);\n            for off in 0..4usize {\n                let case = InflateCase::new(stream.clone(), n as c_int).in_off(off);\n                assert_inflate_eq_arena(\n                    &c,\n                    &r,\n                    &case,\n                    &format!(\"D9 n={n} lvl={level} off={off}\"),\n                    8192,\n                );\n            }\n        }\n    }\n    // Hand-built dynamic blocks over the same sweep.\n    let lens = lens_for(257, 1, &[b'p' as usize, b'q' as usize, 256], &[0]);\n    let d = dynamic_from_lens(257, 1, &lens);\n    for n in 0..40usize {\n        let items: Vec<Item> = (0..n)\n            .map(|i| Item::Lit(if i % 3 == 0 { b'p' } else { b'q' }))\n            .collect();\n        let stream = d.only(true, &items);\n        for off in 0..4usize {\n            let case = InflateCase::new(stream.clone(), n as c_int).in_off(off);\n            assert_inflate_eq_arena(&c, &r, &case, &format!(\"D9 hand n={n} off={off}\"), 8192);\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// D10 — distance-1 runs (`memset` path) inside a dynamic block\n// ---------------------------------------------------------------------------\n\n#[test]\nfn d10_memset_path_in_dynamic_block() {\n    let (c, r) = load_both();\n    let nlit = 286usize; // enough for length symbols up to 285\n    let ndst = 1usize;\n    let lit_syms: Vec<usize> = vec![b'z' as usize, 256, 257, 265, 273, 281, 285];\n    let lens = lens_for(nlit, ndst, &lit_syms, &[0]);\n    let d = dynamic_rle(nlit, ndst, &lens);\n\n    for &len_sym in &[257usize, 265, 273, 281, 285] {\n        let nextra = LEN_EXTRA[len_sym - 257] as u32;\n        for len_extra in [0u32, (1u32 << nextra) - 1] {\n            let items = vec![\n                Item::Lit(b'z'),\n                Item::Match {\n                    len_sym,\n                    len_extra,\n                    dist_sym: 0,\n                    dist_extra: 0,\n                },\n            ];\n            check_dyn(\n                &c,\n                &r,\n                &d,\n                &items,\n                &format!(\"D10 len_sym={len_sym} extra={len_extra}\"),\n                8192,\n            );\n        }\n    }\n    // Also via a real encoder: long single-byte runs.\n    for n in [3usize, 4, 258, 259, 600, 65536] {\n        let data = vec![0xC7u8; n];\n        for level in [6u32, 9] {\n            let stream = deflate_raw(&data, level);\n            let case = InflateCase::new(stream, n as c_int);\n            assert_inflate_eq(&c, &r, &case, &format!(\"D10 flate2 run n={n} lvl={level}\"));\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// D11 — long-range matches (distance up to 24576) in a dynamic block\n// ---------------------------------------------------------------------------\n\n#[test]\nfn d11_long_distance_matches() {\n    let (c, r) = load_both();\n    let nlit = 258usize;\n    let ndst = 30usize;\n    let mut lens = vec![0u8; nlit + ndst];\n    let lit_syms = [b'w' as usize, 256, 257];\n    let l = min_len(lit_syms.len());\n    for &s in &lit_syms {\n        lens[s] = l;\n    }\n    for s in 0..ndst {\n        lens[nlit + s] = 5; // 30 codes of length 5: valid (over-complete) code\n    }\n    let d = dynamic_rle(nlit, ndst, &lens);\n\n    for dist_sym in [20usize, 24, 27, 28, 29] {\n        let nextra = DIST_EXTRA[dist_sym] as u32;\n        let dist_extra = (1u32 << nextra) - 1;\n        let dist = DIST_BASE[dist_sym] + dist_extra;\n        let mut items = vec![Item::Lit(b'w')];\n        while (out_size(&items) as u32) < dist {\n            let remain = dist - out_size(&items) as u32;\n            if remain >= 258 {\n                items.push(match_item_257(258));\n            } else if remain >= 3 {\n                items.push(match_item_257(remain));\n            } else {\n                items.push(Item::Lit(b'w'));\n            }\n        }\n        items.push(Item::Match {\n            len_sym: 257,\n            len_extra: 0,\n            dist_sym,\n            dist_extra,\n        });\n        check_dyn(\n            &c,\n            &r,\n            &d,\n            &items,\n            &format!(\"D11 dist_sym={dist_sym} dist={dist}\"),\n            ARENA,\n        );\n    }\n\n    // Real-encoder long-distance matches: 32 KiB of repeating structure.\n    for n in [30000usize, 40000, 70000] {\n        let data: Vec<u8> = (0..n).map(|i| ((i % 251) as u8)).collect();\n        for level in [6u32, 9] {\n            let stream = deflate_raw(&data, level);\n            let case = InflateCase::new(stream, n as c_int);\n            assert_inflate_eq(&c, &r, &case, &format!(\"D11 flate2 n={n} lvl={level}\"));\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// D12 — multiple / mixed block types in one stream\n// ---------------------------------------------------------------------------\n\n#[test]\nfn d12_mixed_block_types() {\n    let (c, r) = load_both();\n    let lens = lens_for(257, 1, &[b'm' as usize, b'n' as usize, 256], &[0]);\n    let d = dynamic_from_lens(257, 1, &lens);\n    let mut rng = SplitMix::new(0xD12C);\n\n    // dynamic -> dynamic -> final dynamic\n    for nblocks in 1..=4usize {\n        for i in 0..4 {\n            let mut w = BitWriter::new();\n            let mut total = 0i64;\n            let mut all: Vec<Item> = Vec::new();\n            for b in 0..nblocks {\n                let n = rng.below(10) as usize;\n                let items: Vec<Item> = (0..n)\n                    .map(|_| Item::Lit(if rng.below(2) == 0 { b'm' } else { b'n' }))\n                    .collect();\n                total += out_size(&items);\n                all.extend(items.iter().cloned());\n                d.block(&mut w, b + 1 == nblocks, &items);\n            }\n            let stream = w.finish();\n            for off in 0..4usize {\n                let case = InflateCase::new(stream.clone(), total as c_int).in_off(off);\n                assert_inflate_eq_arena(\n                    &c,\n                    &r,\n                    &case,\n                    &format!(\"D12 dyn×{nblocks} #{i} off={off}\"),\n                    8192,\n                );\n            }\n            if let Some(expect) = simulate(&all) {\n                let case = InflateCase::new(stream, total as c_int);\n                let rc = run_inflate(&c, &case, 8192);\n                assert_eq!(rc.ret, 1, \"D12 dyn×{nblocks} #{i}: {rc:?}\");\n                assert_eq!(&rc.out_arena[..expect.len()], &expect[..]);\n            }\n        }\n    }\n\n    // fixed -> dynamic -> final fixed, and dynamic -> fixed -> final dynamic\n    for order in 0..2 {\n        let mut w = BitWriter::new();\n        let a = vec![Item::Lit(b'm'), Item::Lit(b'n')];\n        let b = vec![Item::Lit(b'm'), Item::Lit(b'm'), Item::Lit(b'n')];\n        let cc = vec![Item::Lit(b'n')];\n        if order == 0 {\n            fixed_block(&mut w, false, &a);\n            d.block(&mut w, false, &b);\n            fixed_block(&mut w, true, &cc);\n        } else {\n            d.block(&mut w, false, &a);\n            fixed_block(&mut w, false, &b);\n            d.block(&mut w, true, &cc);\n        }\n        let stream = w.finish();\n        let total = out_size(&a) + out_size(&b) + out_size(&cc);\n        let mut all = a.clone();\n        all.extend(b.iter().cloned());\n        all.extend(cc.iter().cloned());\n        for off in 0..4usize {\n            let case = InflateCase::new(stream.clone(), total as c_int).in_off(off);\n            assert_inflate_eq_arena(&c, &r, &case, &format!(\"D12 mix{order} off={off}\"), 8192);\n        }\n        let expect = simulate(&all).unwrap();\n        let case = InflateCase::new(stream, total as c_int);\n        let rc = run_inflate(&c, &case, 8192);\n        assert_eq!(rc.ret, 1, \"D12 mix{order}: {rc:?}\");\n        assert_eq!(&rc.out_arena[..expect.len()], &expect[..]);\n    }\n\n    // A NON-final stored block followed by compressed blocks.  Note the C's\n    // `cp_stored` does NOT advance the bit reader past the stored payload, so\n    // the payload bytes are *also* decoded as the following blocks; and the\n    // E2 check requires `bits_left/8 <= LEN`.  Construct exactly that.\n    {\n        let tail_items = vec![Item::Lit(b'm'), Item::Lit(b'n'), Item::Lit(b'm')];\n        let tail = fixed_only(true, &tail_items); // becomes both payload and code\n        let mut w = BitWriter::new();\n        w.bits(0, 1); // bfinal = 0\n        w.bits(0, 2); // btype = 0 (stored)\n        w.align();\n        w.u16le(tail.len() as u16);\n        w.u16le(!(tail.len() as u16));\n        w.raw(&tail);\n        let stream = w.finish();\n        let total = tail.len() as i64 + out_size(&tail_items);\n        for off in 0..4usize {\n            let case = InflateCase::new(stream.clone(), total as c_int).in_off(off);\n            assert_inflate_eq_arena(&c, &r, &case, &format!(\"D12 stored+fixed off={off}\"), 8192);\n        }\n        let case = InflateCase::new(stream, total as c_int);\n        let rc = run_inflate(&c, &case, 8192);\n        assert_eq!(\n            rc.ret, 1,\n            \"D12 stored+fixed: expected success, got {rc:?}\"\n        );\n        assert_eq!(\n            &rc.out_arena[..tail.len()],\n            &tail[..],\n            \"D12 stored+fixed: stored payload not copied\"\n        );\n        let tail_expect = simulate(&tail_items).unwrap();\n        assert_eq!(\n            &rc.out_arena[tail.len()..tail.len() + tail_expect.len()],\n            &tail_expect[..],\n            \"D12 stored+fixed: trailing fixed block wrong\"\n        );\n    }\n}\n\n// ---------------------------------------------------------------------------\n// D13 — `flate2` output of the empty input\n// ---------------------------------------------------------------------------\n\n#[test]\nfn d13_empty_input_streams() {\n    let (c, r) = load_both();\n    for level in 0..=9u32 {\n        let stream = deflate_raw(&[], level);\n        for out_bytes in [0i32, 1, 64] {\n            for off in 0..4usize {\n                let case = InflateCase::new(stream.clone(), out_bytes).in_off(off);\n                assert_inflate_eq_arena(\n                    &c,\n                    &r,\n                    &case,\n                    &format!(\"D13 lvl={level} out={out_bytes} off={off}\"),\n                    8192,\n                );\n            }\n        }\n    }\n    // Hand-built empty dynamic block.\n    let lens = lens_for(257, 1, &[256], &[0]);\n    let d = dynamic_from_lens(257, 1, &lens);\n    check_dyn(&c, &r, &d, &[], \"D13 hand-built empty dynamic\", 8192);\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4401,"cache_read_input_tokens":195911,"cache_creation":{"ephemeral_5m_input_tokens":4401,"ephemeral_1h_input_tokens":0},"output_tokens":20,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"1f391add-adf5-472a-b38e-02e2e663f9ae","uuid":"6952f7d7-1054-4f67-aa65-3254f7951ca2","timestamp":"2026-08-20T08:18:03.362Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_0154bxPSwTj7hJLko7zffQte","type":"tool_result","content":"File created successfully at: /local/home/scheschb/.harvest/work/harvest-work-AesDK8/translated_rust/tests/inflate_dynamic.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"1f391add-adf5-472a-b38e-02e2e663f9ae","uuid":"466de4b0-e88c-413d-849b-d36f68667604","timestamp":"2026-08-20T08:18:03.374Z","tool_use_result":{"type":"create","filePath":"/local/home/scheschb/.harvest/work/harvest-work-AesDK8/translated_rust/tests/inflate_dynamic.rs","content":"//! Phase B — CONFIGS.md rows D1..D13 (BTYPE 2, dynamic Huffman blocks).\n//!\n//! Drives `cp_dynamic` (all of `HLIT`/`HDIST`/`HCLEN` and all four arms of the\n//! code-length `switch`), all three `cp_build` invocations, `cp_decode` on\n//! three different trees, and `cp_block` — through the exported `cp_inflate`.\n\nmod common;\n\nuse common::deflate::*;\nuse common::*;\nuse std::os::raw::c_int;\n\n#[track_caller]\nfn check_dyn(c: &Impl, r: &Impl, d: &Dynamic, items: &[Item], label: &str, arena: usize) {\n    let n = out_size(items);\n    let stream = d.only(true, items);\n    for off in 0..4usize {\n        let case = InflateCase::new(stream.clone(), n as c_int).in_off(off);\n        assert_inflate_eq_arena(c, r, &case, &format!(\"{label} off={off}\"), arena);\n    }\n    if let Some(expect) = simulate(items) {\n        let case = InflateCase::new(stream, n as c_int);\n        let rc = run_inflate(c, &case, arena);\n        assert_eq!(rc.ret, 1, \"[{label}] C returned {}: {rc:?}\", rc.ret);\n        assert_eq!(\n            &rc.out_arena[..expect.len()],\n            &expect[..],\n            \"[{label}] C output disagrees with the reference model\"\n        );\n    }\n}\n\n// ---------------------------------------------------------------------------\n// D1 — minimal dynamic block: HLIT=257, HDIST=1, HCLEN=4\n// ---------------------------------------------------------------------------\n\n#[test]\nfn d1_minimal_dynamic_block() {\n    let (c, r) = load_both();\n    // Two literals + EOB, and a single (unused) distance code.\n    let lens = lens_for(257, 1, &[b'A' as usize, b'B' as usize, 256], &[0]);\n    let d = dynamic_from_lens(257, 1, &lens);\n    assert_eq!(d.nlit, 257);\n    assert_eq!(d.ndst, 1);\n\n    check_dyn(&c, &r, &d, &[], \"D1 empty\", 8192);\n    check_dyn(&c, &r, &d, &[Item::Lit(b'A')], \"D1 one\", 8192);\n    check_dyn(\n        &c,\n        &r,\n        &d,\n        &[Item::Lit(b'A'), Item::Lit(b'B'), Item::Lit(b'A')],\n        \"D1 three\",\n        8192,\n    );\n\n    // Randomised literal sequences.\n    let mut rng = SplitMix::new(0xD101);\n    for i in 0..200 {\n        let n = 1 + rng.below(64) as usize;\n        let items: Vec<Item> = (0..n)\n            .map(|_| Item::Lit(if rng.below(2) == 0 { b'A' } else { b'B' }))\n            .collect();\n        check_dyn(&c, &r, &d, &items, &format!(\"D1 rand#{i}\"), 8192);\n    }\n\n    // HCLEN really is 4 for at least one construction (4 distinct cl symbols).\n    let lens4 = lens_for(257, 1, &[b'A' as usize, 256], &[0]);\n    let d4 = dynamic_from_lens(257, 1, &lens4);\n    check_dyn(&c, &r, &d4, &[Item::Lit(b'A')], \"D1 hclen-min\", 8192);\n    assert!(d4.nlen >= 4, \"HCLEN must be >= 4\");\n}\n\n// ---------------------------------------------------------------------------\n// D2 — HCLEN = 19 (all 19 permutation slots transmitted)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn d2_hclen_19() {\n    let (c, r) = load_both();\n    let lens = lens_for(257, 1, &[b'x' as usize, b'y' as usize, 256], &[0]);\n    let d = dynamic_from_lens(257, 1, &lens).with_nlen(19);\n    assert_eq!(d.nlen, 19);\n    check_dyn(\n        &c,\n        &r,\n        &d,\n        &[Item::Lit(b'x'), Item::Lit(b'y')],\n        \"D2 hclen=19\",\n        8192,\n    );\n\n    // Every HCLEN from 4 to 19 (the trailing slots are transmitted as zero).\n    for nlen in 4..=19usize {\n        let dd = dynamic_from_lens(257, 1, &lens).with_nlen(nlen);\n        if dd.nlen != nlen {\n            continue;\n        }\n        check_dyn(&c, &r, &dd, &[Item::Lit(b'x')], &format!(\"D2 hclen={nlen}\"), 8192);\n    }\n}\n\n// ---------------------------------------------------------------------------\n// D3 — HLIT = 288, HDIST = 32 (the maxima)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn d3_hlit_hdist_maxima() {\n    let (c, r) = load_both();\n    let nlit = 288usize;\n    let ndst = 32usize;\n\n    // Give codes to a handful of literals plus all 32 distance symbols, so the\n    // `cp_build(0, s->dst, lens + nlit, 32)` call sees a full distance table.\n    let mut lens = vec![0u8; nlit + ndst];\n    let lit_syms: Vec<usize> = vec![b'a' as usize, b'b' as usize, 256, 257, 287];\n    let l = min_len(lit_syms.len());\n    for &s in &lit_syms {\n        lens[s] = l;\n    }\n    for s in 0..ndst {\n        lens[nlit + s] = 5; // 32 symbols of length 5 == a complete code\n    }\n    let d = dynamic_rle(nlit, ndst, &lens);\n    assert_eq!(d.nlit, 288);\n    assert_eq!(d.ndst, 32);\n\n    check_dyn(\n        &c,\n        &r,\n        &d,\n        &[Item::Lit(b'a'), Item::Lit(b'b'), Item::Lit(b'a')],\n        \"D3 maxima literals\",\n        8192,\n    );\n    // Use length symbol 257 (len 3) and 287 (len 0) with several distances.\n    for dist_sym in [0usize, 1, 5, 29, 30, 31] {\n        let nextra = DIST_EXTRA[dist_sym] as u32;\n        let dist_extra = (1u32 << nextra) - 1;\n        let dist = DIST_BASE[dist_sym] + dist_extra;\n        let mut items = if dist == 0 {\n            vec![Item::Lit(b'a'), Item::Lit(b'b')]\n        } else {\n            fill_items_with(dist as usize, b'a', b'b')\n        };\n        items.push(Item::Match {\n            len_sym: 257,\n            len_extra: 0,\n            dist_sym,\n            dist_extra,\n        });\n        let arena = if dist > 60 * 1024 { ARENA } else { 128 * 1024 };\n        check_dyn(&c, &r, &d, &items, &format!(\"D3 dist_sym={dist_sym}\"), arena);\n    }\n    // Length symbol 287 (cp_len_base == 0).\n    let items = vec![\n        Item::Lit(b'a'),\n        Item::Lit(b'b'),\n        Item::Match {\n            len_sym: 287,\n            len_extra: 0,\n            dist_sym: 0,\n            dist_extra: 0,\n        },\n        Item::Lit(b'a'),\n    ];\n    check_dyn(&c, &r, &d, &items, \"D3 len_sym=287\", 8192);\n}\n\n/// Build exactly `n` bytes of output using only literals `a`/`b` and\n/// distance-1 runs (needed where only two literal codes exist).\nfn fill_items_with(n: usize, a: u8, b: u8) -> Vec<Item> {\n    let mut items = Vec::new();\n    let mut produced = 0usize;\n    while produced < n {\n        if produced == 0 {\n            items.push(Item::Lit(a));\n            produced = 1;\n        } else if produced == 1 && n > 1 {\n            items.push(Item::Lit(b));\n            produced = 2;\n        } else {\n            let remain = n - produced;\n            if remain >= 258 {\n                items.push(match_item_257(258));\n                produced += 258;\n            } else if remain >= 3 {\n                items.push(match_item_257(remain as u32));\n                produced += remain;\n            } else {\n                items.push(Item::Lit(a));\n                produced += 1;\n            }\n        }\n    }\n    items\n}\n\n/// A distance-1 match whose length symbol is 257 + k, all with `dist_sym = 0`.\nfn match_item_257(len: u32) -> Item {\n    let (len_sym, len_extra) = len_code(len);\n    Item::Match {\n        len_sym,\n        len_extra,\n        dist_sym: 0,\n        dist_extra: 0,\n    }\n}\n\n// ---------------------------------------------------------------------------\n// D4, D5, D6 — code-length symbols 16, 17 and 18\n// ---------------------------------------------------------------------------\n\n/// D4 — symbol 16 (repeat previous length), every repeat count 3..6.\n#[test]\nfn d4_code_length_symbol_16() {\n    let (c, r) = load_both();\n    for repeat in 3..=6u32 {\n        // Build cl instructions explicitly so exactly one `16` with this extra\n        // value appears.\n        let nlit = 257usize;\n        let ndst = 1usize;\n        // lens: symbol 0 length 0, then a run of `repeat + 1` equal lengths.\n        let mut lens = vec![0u8; nlit + ndst];\n        // 'a'..'a'+repeat all get length `l`; plus EOB.\n        let l = min_len(repeat as usize + 2);\n        for k in 0..=repeat as usize {\n            lens[b'a' as usize + k] = l;\n        }\n        lens[256] = l;\n        lens[nlit] = 1; // one distance code\n        let instrs = build_16_instrs(&lens, repeat);\n        let cl = cl_lens_for(&instrs);\n        let d = Dynamic::new(nlit, ndst, cl, instrs);\n        assert!(\n            d.instrs.iter().any(|&(s, e)| s == 16 && e == repeat - 3),\n            \"code-length symbol 16 with extra {} not emitted\",\n            repeat - 3\n        );\n        let items: Vec<Item> = (0..=repeat as u8)\n            .map(|k| Item::Lit(b'a' + k))\n            .chain(std::iter::once(Item::Lit(b'a')))\n            .collect();\n        check_dyn(&c, &r, &d, &items, &format!(\"D4 repeat={repeat}\"), 8192);\n    }\n}\n\n/// Encode `lens` so that a `16` with exactly `repeat` copies is used for the\n/// run of equal non-zero lengths.\nfn build_16_instrs(lens: &[u8], repeat: u32) -> Vec<ClInstr> {\n    // rle_encode already prefers 16 for runs >= 4; verify it produced one with\n    // the requested count, otherwise construct it by hand.\n    let auto = rle_encode(lens);\n    if auto.iter().any(|&(s, e)| s == 16 && e == repeat - 3) {\n        return auto;\n    }\n    // Hand construction: emit the first length literally, then a single 16.\n    let mut out: Vec<ClInstr> = Vec::new();\n    let mut i = 0usize;\n    while i < lens.len() {\n        let v = lens[i];\n        let mut run = 1usize;\n        while i + run < lens.len() && lens[i + run] == v {\n            run += 1;\n        }\n        if v != 0 && run == repeat as usize + 1 {\n            out.push((v, 0));\n            out.push((16, repeat - 3));\n            i += run;\n        } else if v == 0 {\n            for _ in 0..run {\n                out.push((0, 0));\n            }\n            i += run;\n        } else {\n            for _ in 0..run {\n                out.push((v, 0));\n            }\n            i += run;\n        }\n    }\n    assert_eq!(expand_cl(&out), lens);\n    out\n}\n\n/// D5 — symbol 17 (zero run 3..10), every run length.\n#[test]\nfn d5_code_length_symbol_17() {\n    let (c, r) = load_both();\n    for run in 3..=10u32 {\n        let nlit = 257usize;\n        let ndst = 1usize;\n        let mut lens = vec![0u8; nlit + ndst];\n        // A non-zero length, then exactly `run` zeros, then more non-zeros.\n        lens[0] = 2;\n        for k in 0..run as usize {\n            lens[1 + k] = 0;\n        }\n        lens[1 + run as usize] = 2;\n        lens[2 + run as usize] = 2;\n        lens[256] = 2;\n        lens[nlit] = 1;\n        let instrs = build_17_instrs(&lens, run);\n        let cl = cl_lens_for(&instrs);\n        let d = Dynamic::new(nlit, ndst, cl, instrs);\n        assert!(\n            d.instrs.iter().any(|&(s, e)| s == 17 && e == run - 3),\n            \"code-length symbol 17 with extra {} not emitted\",\n            run - 3\n        );\n        let a = 0u8;\n        let b = (1 + run) as u8;\n        check_dyn(\n            &c,\n            &r,\n            &d,\n            &[Item::Lit(a), Item::Lit(b), Item::Lit(a)],\n            &format!(\"D5 run={run}\"),\n            8192,\n        );\n    }\n}\n\nfn build_17_instrs(lens: &[u8], run: u32) -> Vec<ClInstr> {\n    let mut out: Vec<ClInstr> = Vec::new();\n    let mut i = 0usize;\n    while i < lens.len() {\n        let v = lens[i];\n        let mut n = 1usize;\n        while i + n < lens.len() && lens[i + n] == v {\n            n += 1;\n        }\n        if v == 0 && n == run as usize {\n            out.push((17, run - 3));\n            i += n;\n        } else if v == 0 {\n            let mut left = n;\n            while left >= 11 {\n                let k = left.min(138);\n                out.push((18, (k - 11) as u32));\n                left -= k;\n            }\n            while left >= 3 {\n                let k = left.min(10);\n                out.push((17, (k - 3) as u32));\n                left -= k;\n            }\n            for _ in 0..left {\n                out.push((0, 0));\n            }\n            i += n;\n        } else {\n            for _ in 0..n {\n                out.push((v, 0));\n            }\n            i += n;\n        }\n    }\n    assert_eq!(expand_cl(&out), lens);\n    out\n}\n\n/// D6 — symbol 18 (zero run 11..138), a sweep over the run length.\n#[test]\nfn d6_code_length_symbol_18() {\n    let (c, r) = load_both();\n    for run in [11u32, 12, 20, 64, 100, 137, 138] {\n        let nlit = 257usize;\n        let ndst = 1usize;\n        let mut lens = vec![0u8; nlit + ndst];\n        lens[0] = 2;\n        lens[1 + run as usize] = 2;\n        lens[2 + run as usize] = 2;\n        lens[256] = 2;\n        lens[nlit] = 1;\n        let instrs = build_18_instrs(&lens, run);\n        let cl = cl_lens_for(&instrs);\n        let d = Dynamic::new(nlit, ndst, cl, instrs);\n        assert!(\n            d.instrs.iter().any(|&(s, e)| s == 18 && e == run - 11),\n            \"code-length symbol 18 with extra {} not emitted\",\n            run - 11\n        );\n        check_dyn(\n            &c,\n            &r,\n            &d,\n            &[Item::Lit(0), Item::Lit((1 + run) as u8), Item::Lit(0)],\n            &format!(\"D6 run={run}\"),\n            8192,\n        );\n    }\n}\n\nfn build_18_instrs(lens: &[u8], run: u32) -> Vec<ClInstr> {\n    let mut out: Vec<ClInstr> = Vec::new();\n    let mut i = 0usize;\n    while i < lens.len() {\n        let v = lens[i];\n        let mut n = 1usize;\n        while i + n < lens.len() && lens[i + n] == v {\n            n += 1;\n        }\n        if v == 0 && n == run as usize {\n            out.push((18, run - 11));\n            i += n;\n        } else if v == 0 {\n            let mut left = n;\n            while left >= 11 {\n                let k = left.min(138);\n                out.push((18, (k - 11) as u32));\n                left -= k;\n            }\n            while left >= 3 {\n                let k = left.min(10);\n                out.push((17, (k - 3) as u32));\n                left -= k;\n            }\n            for _ in 0..left {\n                out.push((0, 0));\n            }\n            i += n;\n        } else {\n            for _ in 0..n {\n                out.push((v, 0));\n            }\n            i += n;\n        }\n    }\n    assert_eq!(expand_cl(&out), lens);\n    out\n}\n\n// ---------------------------------------------------------------------------\n// D7 — literal code lengths 10..15 (`cp_build`'s `len <= 9` branch NOT taken)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn d7_deep_code_lengths() {\n    let (c, r) = load_both();\n    for nsym in 2..=16usize {\n        let nlit = 257usize;\n        let ndst = 1usize;\n        // A complete code with lengths 1,2,...,nsym-1,nsym-1.\n        let mut lit_syms: Vec<usize> = (0..nsym - 1).map(|k| b'a' as usize + k).collect();\n        lit_syms.push(256); // EOB gets the deepest code\n        let lens = deep_lens(nlit, ndst, &lit_syms, &[0]);\n        let max_len = *lens.iter().max().unwrap();\n        let d = dynamic_rle(nlit, ndst, &lens);\n        // The literals that exist.\n        let items: Vec<Item> = (0..nsym - 1)\n            .map(|k| Item::Lit(b'a' + k as u8))\n            .collect();\n        check_dyn(\n            &c,\n            &r,\n            &d,\n            &items,\n            &format!(\"D7 nsym={nsym} max_len={max_len}\"),\n            8192,\n        );\n        if nsym == 16 {\n            assert_eq!(max_len, 15, \"expected a 15-bit code for 16 symbols\");\n        }\n    }\n\n    // Also make sure a >9-bit code length is transmitted for a *distance*\n    // symbol, so `cp_build(0, s->dst, ...)` (the `s == NULL` call) sees one.\n    let nlit = 257usize;\n    let ndst = 16usize;\n    let dist_syms: Vec<usize> = (0..16).collect();\n    let lens = deep_lens(nlit, ndst, &[b'a' as usize, 257, 256], &dist_syms);\n    assert!(lens[nlit..].iter().any(|&l| l > 9));\n    let d = dynamic_rle(nlit, ndst, &lens);\n    // Use the deepest distance symbol (15) — it needs enough prior output.\n    let items = vec![\n        Item::Lit(b'a'),\n        Item::Match {\n            len_sym: 257,\n            len_extra: 0,\n            dist_sym: 0,\n            dist_extra: 0,\n        },\n        Item::Match {\n            len_sym: 257,\n            len_extra: 0,\n            dist_sym: 15,\n            dist_extra: (1u32 << DIST_EXTRA[15]) - 1,\n        },\n    ];\n    // dist_sym 15 => base 193, so we need >= 193 bytes first.\n    let mut items2 = vec![Item::Lit(b'a')];\n    while out_size(&items2) < 400 {\n        items2.push(Item::Match {\n            len_sym: 257,\n            len_extra: 0,\n            dist_sym: 0,\n            dist_extra: 0,\n        });\n    }\n    items2.push(Item::Match {\n        len_sym: 257,\n        len_extra: 0,\n        dist_sym: 15,\n        dist_extra: (1u32 << DIST_EXTRA[15]) - 1,\n    });\n    let _ = items;\n    check_dyn(&c, &r, &d, &items2, \"D7 deep distance code\", 8192);\n}\n\n// ---------------------------------------------------------------------------\n// D8 — real-encoder dynamic blocks (flate2, best/default)\n// ---------------------------------------------------------------------------\n\nfn deflate_raw(data: &[u8], level: u32) -> Vec<u8> {\n    use flate2::write::DeflateEncoder;\n    use flate2::Compression;\n    use std::io::Write;\n    let mut e = DeflateEncoder::new(Vec::new(), Compression::new(level));\n    e.write_all(data).unwrap();\n    e.finish().unwrap()\n}\n\nfn payloads(rng: &mut SplitMix) -> Vec<(String, Vec<u8>)> {\n    let mut v: Vec<(String, Vec<u8>)> = Vec::new();\n    v.push((\"empty\".into(), vec![]));\n    v.push((\"one\".into(), vec![0x42]));\n    v.push((\"run64k\".into(), vec![0x33; 60000]));\n    v.push((\n        \"struct\".into(),\n        (0..40000u32).map(|i| ((i / 7) % 251) as u8).collect(),\n    ));\n    v.push((\n        \"text\".into(),\n        b\"Lorem ipsum dolor sit amet, consectetur adipiscing elit. \"\n            .iter()\n            .cycle()\n            .take(30000)\n            .cloned()\n            .collect(),\n    ));\n    for n in [1usize, 2, 3, 5, 9, 17, 33, 65, 129, 257, 1000, 5000, 20000] {\n        v.push((format!(\"rand{n}\"), rng.bytes(n)));\n        v.push((\n            format!(\"lowent{n}\"),\n            (0..n).map(|_| b'a' + rng.below(6) as u8).collect(),\n        ));\n        v.push((\n            format!(\"sparse{n}\"),\n            (0..n)\n                .map(|i| if i % 97 == 0 { rng.next_u32() as u8 } else { 0 })\n                .collect(),\n        ));\n    }\n    v\n}\n\n#[test]\nfn d8_flate2_dynamic_streams() {\n    let (c, r) = load_both();\n    let mut rng = SplitMix::new(0xD808);\n    for (name, data) in payloads(&mut rng) {\n        for level in [6u32, 9] {\n            let stream = deflate_raw(&data, level);\n            let case = InflateCase::new(stream.clone(), data.len() as c_int);\n            assert_inflate_eq(&c, &r, &case, &format!(\"D8 {name} lvl={level}\"));\n            let rc = run_inflate(&c, &case, ARENA);\n            if rc.ret == 1 && data.len() > 3 {\n                assert_eq!(\n                    &rc.out_arena[..data.len()],\n                    &data[..],\n                    \"D8 {name} lvl={level}: C did not round-trip\"\n                );\n            }\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// D9 — D8 payloads × alignment × tail sweep\n// ---------------------------------------------------------------------------\n\n#[test]\nfn d9_alignment_and_tail_sweep() {\n    let (c, r) = load_both();\n    let mut rng = SplitMix::new(0xD909);\n    // Sizes 1..48 so `in_bytes` covers every residue mod 4 many times over.\n    for n in 1..=48usize {\n        let data: Vec<u8> = (0..n).map(|_| b'a' + rng.below(7) as u8).collect();\n        for level in [6u32, 9] {\n            let stream = deflate_raw(&data, level);\n            for off in 0..4usize {\n                let case = InflateCase::new(stream.clone(), n as c_int).in_off(off);\n                assert_inflate_eq_arena(\n                    &c,\n                    &r,\n                    &case,\n                    &format!(\"D9 n={n} lvl={level} off={off}\"),\n                    8192,\n                );\n            }\n        }\n    }\n    // Hand-built dynamic blocks over the same sweep.\n    let lens = lens_for(257, 1, &[b'p' as usize, b'q' as usize, 256], &[0]);\n    let d = dynamic_from_lens(257, 1, &lens);\n    for n in 0..40usize {\n        let items: Vec<Item> = (0..n)\n            .map(|i| Item::Lit(if i % 3 == 0 { b'p' } else { b'q' }))\n            .collect();\n        let stream = d.only(true, &items);\n        for off in 0..4usize {\n            let case = InflateCase::new(stream.clone(), n as c_int).in_off(off);\n            assert_inflate_eq_arena(&c, &r, &case, &format!(\"D9 hand n={n} off={off}\"), 8192);\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// D10 — distance-1 runs (`memset` path) inside a dynamic block\n// ---------------------------------------------------------------------------\n\n#[test]\nfn d10_memset_path_in_dynamic_block() {\n    let (c, r) = load_both();\n    let nlit = 286usize; // enough for length symbols up to 285\n    let ndst = 1usize;\n    let lit_syms: Vec<usize> = vec![b'z' as usize, 256, 257, 265, 273, 281, 285];\n    let lens = lens_for(nlit, ndst, &lit_syms, &[0]);\n    let d = dynamic_rle(nlit, ndst, &lens);\n\n    for &len_sym in &[257usize, 265, 273, 281, 285] {\n        let nextra = LEN_EXTRA[len_sym - 257] as u32;\n        for len_extra in [0u32, (1u32 << nextra) - 1] {\n            let items = vec![\n                Item::Lit(b'z'),\n                Item::Match {\n                    len_sym,\n                    len_extra,\n                    dist_sym: 0,\n                    dist_extra: 0,\n                },\n            ];\n            check_dyn(\n                &c,\n                &r,\n                &d,\n                &items,\n                &format!(\"D10 len_sym={len_sym} extra={len_extra}\"),\n                8192,\n            );\n        }\n    }\n    // Also via a real encoder: long single-byte runs.\n    for n in [3usize, 4, 258, 259, 600, 65536] {\n        let data = vec![0xC7u8; n];\n        for level in [6u32, 9] {\n            let stream = deflate_raw(&data, level);\n            let case = InflateCase::new(stream, n as c_int);\n            assert_inflate_eq(&c, &r, &case, &format!(\"D10 flate2 run n={n} lvl={level}\"));\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// D11 — long-range matches (distance up to 24576) in a dynamic block\n// ---------------------------------------------------------------------------\n\n#[test]\nfn d11_long_distance_matches() {\n    let (c, r) = load_both();\n    let nlit = 258usize;\n    let ndst = 30usize;\n    let mut lens = vec![0u8; nlit + ndst];\n    let lit_syms = [b'w' as usize, 256, 257];\n    let l = min_len(lit_syms.len());\n    for &s in &lit_syms {\n        lens[s] = l;\n    }\n    for s in 0..ndst {\n        lens[nlit + s] = 5; // 30 codes of length 5: valid (over-complete) code\n    }\n    let d = dynamic_rle(nlit, ndst, &lens);\n\n    for dist_sym in [20usize, 24, 27, 28, 29] {\n        let nextra = DIST_EXTRA[dist_sym] as u32;\n        let dist_extra = (1u32 << nextra) - 1;\n        let dist = DIST_BASE[dist_sym] + dist_extra;\n        let mut items = vec![Item::Lit(b'w')];\n        while (out_size(&items) as u32) < dist {\n            let remain = dist - out_size(&items) as u32;\n            if remain >= 258 {\n                items.push(match_item_257(258));\n            } else if remain >= 3 {\n                items.push(match_item_257(remain));\n            } else {\n                items.push(Item::Lit(b'w'));\n            }\n        }\n        items.push(Item::Match {\n            len_sym: 257,\n            len_extra: 0,\n            dist_sym,\n            dist_extra,\n        });\n        check_dyn(\n            &c,\n            &r,\n            &d,\n            &items,\n            &format!(\"D11 dist_sym={dist_sym} dist={dist}\"),\n            ARENA,\n        );\n    }\n\n    // Real-encoder long-distance matches: 32 KiB of repeating structure.\n    for n in [30000usize, 40000, 70000] {\n        let data: Vec<u8> = (0..n).map(|i| ((i % 251) as u8)).collect();\n        for level in [6u32, 9] {\n            let stream = deflate_raw(&data, level);\n            let case = InflateCase::new(stream, n as c_int);\n            assert_inflate_eq(&c, &r, &case, &format!(\"D11 flate2 n={n} lvl={level}\"));\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// D12 — multiple / mixed block types in one stream\n// ---------------------------------------------------------------------------\n\n#[test]\nfn d12_mixed_block_types() {\n    let (c, r) = load_both();\n    let lens = lens_for(257, 1, &[b'm' as usize, b'n' as usize, 256], &[0]);\n    let d = dynamic_from_lens(257, 1, &lens);\n    let mut rng = SplitMix::new(0xD12C);\n\n    // dynamic -> dynamic -> final dynamic\n    for nblocks in 1..=4usize {\n        for i in 0..4 {\n            let mut w = BitWriter::new();\n            let mut total = 0i64;\n            let mut all: Vec<Item> = Vec::new();\n            for b in 0..nblocks {\n                let n = rng.below(10) as usize;\n                let items: Vec<Item> = (0..n)\n                    .map(|_| Item::Lit(if rng.below(2) == 0 { b'm' } else { b'n' }))\n                    .collect();\n                total += out_size(&items);\n                all.extend(items.iter().cloned());\n                d.block(&mut w, b + 1 == nblocks, &items);\n            }\n            let stream = w.finish();\n            for off in 0..4usize {\n                let case = InflateCase::new(stream.clone(), total as c_int).in_off(off);\n                assert_inflate_eq_arena(\n                    &c,\n                    &r,\n                    &case,\n                    &format!(\"D12 dyn×{nblocks} #{i} off={off}\"),\n                    8192,\n                );\n            }\n            if let Some(expect) = simulate(&all) {\n                let case = InflateCase::new(stream, total as c_int);\n                let rc = run_inflate(&c, &case, 8192);\n                assert_eq!(rc.ret, 1, \"D12 dyn×{nblocks} #{i}: {rc:?}\");\n                assert_eq!(&rc.out_arena[..expect.len()], &expect[..]);\n            }\n        }\n    }\n\n    // fixed -> dynamic -> final fixed, and dynamic -> fixed -> final dynamic\n    for order in 0..2 {\n        let mut w = BitWriter::new();\n        let a = vec![Item::Lit(b'm'), Item::Lit(b'n')];\n        let b = vec![Item::Lit(b'm'), Item::Lit(b'm'), Item::Lit(b'n')];\n        let cc = vec![Item::Lit(b'n')];\n        if order == 0 {\n            fixed_block(&mut w, false, &a);\n            d.block(&mut w, false, &b);\n            fixed_block(&mut w, true, &cc);\n        } else {\n            d.block(&mut w, false, &a);\n            fixed_block(&mut w, false, &b);\n            d.block(&mut w, true, &cc);\n        }\n        let stream = w.finish();\n        let total = out_size(&a) + out_size(&b) + out_size(&cc);\n        let mut all = a.clone();\n        all.extend(b.iter().cloned());\n        all.extend(cc.iter().cloned());\n        for off in 0..4usize {\n            let case = InflateCase::new(stream.clone(), total as c_int).in_off(off);\n            assert_inflate_eq_arena(&c, &r, &case, &format!(\"D12 mix{order} off={off}\"), 8192);\n        }\n        let expect = simulate(&all).unwrap();\n        let case = InflateCase::new(stream, total as c_int);\n        let rc = run_inflate(&c, &case, 8192);\n        assert_eq!(rc.ret, 1, \"D12 mix{order}: {rc:?}\");\n        assert_eq!(&rc.out_arena[..expect.len()], &expect[..]);\n    }\n\n    // A NON-final stored block followed by compressed blocks.  Note the C's\n    // `cp_stored` does NOT advance the bit reader past the stored payload, so\n    // the payload bytes are *also* decoded as the following blocks; and the\n    // E2 check requires `bits_left/8 <= LEN`.  Construct exactly that.\n    {\n        let tail_items = vec![Item::Lit(b'm'), Item::Lit(b'n'), Item::Lit(b'm')];\n        let tail = fixed_only(true, &tail_items); // becomes both payload and code\n        let mut w = BitWriter::new();\n        w.bits(0, 1); // bfinal = 0\n        w.bits(0, 2); // btype = 0 (stored)\n        w.align();\n        w.u16le(tail.len() as u16);\n        w.u16le(!(tail.len() as u16));\n        w.raw(&tail);\n        let stream = w.finish();\n        let total = tail.len() as i64 + out_size(&tail_items);\n        for off in 0..4usize {\n            let case = InflateCase::new(stream.clone(), total as c_int).in_off(off);\n            assert_inflate_eq_arena(&c, &r, &case, &format!(\"D12 stored+fixed off={off}\"), 8192);\n        }\n        let case = InflateCase::new(stream, total as c_int);\n        let rc = run_inflate(&c, &case, 8192);\n        assert_eq!(\n            rc.ret, 1,\n            \"D12 stored+fixed: expected success, got {rc:?}\"\n        );\n        assert_eq!(\n            &rc.out_arena[..tail.len()],\n            &tail[..],\n            \"D12 stored+fixed: stored payload not copied\"\n        );\n        let tail_expect = simulate(&tail_items).unwrap();\n        assert_eq!(\n            &rc.out_arena[tail.len()..tail.len() + tail_expect.len()],\n            &tail_expect[..],\n            \"D12 stored+fixed: trailing fixed block wrong\"\n        );\n    }\n}\n\n// ---------------------------------------------------------------------------\n// D13 — `flate2` output of the empty input\n// ---------------------------------------------------------------------------\n\n#[test]\nfn d13_empty_input_streams() {\n    let (c, r) = load_both();\n    for level in 0..=9u32 {\n        let stream = deflate_raw(&[], level);\n        for out_bytes in [0i32, 1, 64] {\n            for off in 0..4usize {\n                let case = InflateCase::new(stream.clone(), out_bytes).in_off(off);\n                assert_inflate_eq_arena(\n                    &c,\n                    &r,\n                    &case,\n                    &format!(\"D13 lvl={level} out={out_bytes} off={off}\"),\n                    8192,\n                );\n            }\n        }\n    }\n    // Hand-built empty dynamic block.\n    let lens = lens_for(257, 1, &[256], &[0]);\n    let d = dynamic_from_lens(257, 1, &lens);\n    check_dyn(&c, &r, &d, &[], \"D13 hand-built empty dynamic\", 8192);\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
