{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_016w7ypUwMuhwJT9BovwLxr8","type":"tool_result","content":"The file /local/home/scheschb/.harvest/work/harvest-work-AesDK8/translated_rust/tests/common/mod.rs has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"1f391add-adf5-472a-b38e-02e2e663f9ae","uuid":"2d80481a-5b61-4452-bcb1-a0ec1b73343e","timestamp":"2026-08-20T08:12:52.463Z","tool_use_result":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-AesDK8/translated_rust/tests/common/mod.rs","oldString":"pub fn load_both() -> (Impl, Impl) {\n    (\n        Impl::load(\"C\", &c_so_path()),\n        Impl::load(\"Rust\", &rust_so_path()),\n    )\n}","newString":"pub fn load_both() -> (Impl, Impl) {\n    (\n        Impl::load(\"C\", &c_so_path()),\n        Impl::load(\"Rust\", &rust_so_path()),\n    )\n}\n\n/// `dlopen` is reference-counted, so every `#[test]` in one test binary shares\n/// a SINGLE instance of each library — and therefore a single\n/// `cp_error_reason` global.  libtest runs tests on parallel threads, so the\n/// clear→call→read sequence must be serialised or tests observe each other's\n/// error strings.\npub static GLOBAL_LOCK: std::sync::Mutex<()> = std::sync::Mutex::new(());\n\npub fn lock_globals() -> std::sync::MutexGuard<'static, ()> {\n    GLOBAL_LOCK.lock().unwrap_or_else(|e| e.into_inner())\n}","originalFile":"//! Shared differential-testing infrastructure.\n//!\n//! BOTH implementations are loaded as shared objects through `libloading` and\n//! called only through their exported C symbols — the Rust functions are never\n//! called directly, so the `#[no_mangle] extern \"C\"` wrappers are under test\n//! too.\n\n#![allow(dead_code)]\n#![allow(unused_unsafe)]\n\npub mod deflate;\npub mod subproc;\n\nuse libloading::{Library, Symbol};\nuse std::ffi::CStr;\nuse std::os::raw::{c_char, c_int, c_void};\nuse std::path::PathBuf;\n\npub type InflateFn = unsafe extern \"C\" fn(*mut c_void, c_int, *mut c_void, c_int) -> c_int;\npub type ConvertPixFn = unsafe extern \"C\" fn(c_int, c_int, c_int, *mut u8, *mut u8);\n\n// ---------------------------------------------------------------------------\n// Locating the two shared objects\n// ---------------------------------------------------------------------------\n\n/// `target/<profile>/` — derived from the running test executable\n/// (`target/<profile>/deps/<name>-<hash>`), so it follows `--release` etc.\npub fn target_profile_dir() -> PathBuf {\n    let exe = std::env::current_exe().expect(\"current_exe\");\n    // .../target/<profile>/deps/<test-bin>\n    exe.parent()\n        .and_then(|p| p.parent())\n        .expect(\"target/<profile>\")\n        .to_path_buf()\n}\n\npub fn rust_so_path() -> PathBuf {\n    // Allow an override so the same tests can be pointed at a release build.\n    if let Ok(p) = std::env::var(\"CP_RUST_SO\") {\n        return PathBuf::from(p);\n    }\n    let d = target_profile_dir();\n    for name in [\"libconvert_pix_lib.so\", \"libconvert_pix_lib.dylib\"] {\n        let c = d.join(name);\n        if c.exists() {\n            return c;\n        }\n    }\n    panic!(\n        \"Rust cdylib not found in {:?}. Run `cargo build` first.\",\n        d\n    );\n}\n\npub fn c_so_path() -> PathBuf {\n    if let Ok(p) = std::env::var(\"CP_C_SO\") {\n        return PathBuf::from(p);\n    }\n    // The tests run with the package root as cwd.\n    let root = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    for name in [\"libtranslated_rust.so\", \"libtranslated_rust.dylib\"] {\n        let c = root.join(\"c_src\").join(\"build\").join(name);\n        if c.exists() {\n            return c;\n        }\n    }\n    panic!(\n        \"C shared library not found under {:?}/c_src/build. Build it with:\\n  \\\n         cd c_src && mkdir -p build && cd build && \\\n         cmake .. -DCMAKE_POSITION_INDEPENDENT_CODE=ON && cmake --build .\",\n        root\n    );\n}\n\n// ---------------------------------------------------------------------------\n// A loaded implementation\n// ---------------------------------------------------------------------------\n\npub struct Impl {\n    pub name: &'static str,\n    pub lib: Library,\n}\n\nimpl Impl {\n    pub fn load(name: &'static str, path: &PathBuf) -> Impl {\n        let lib = unsafe { Library::new(path) }\n            .unwrap_or_else(|e| panic!(\"dlopen {:?} failed: {e}\", path));\n        Impl { name, lib }\n    }\n\n    pub fn inflate(&self) -> Symbol<'_, InflateFn> {\n        unsafe { self.lib.get(b\"cp_inflate\\0\") }.expect(\"cp_inflate not exported\")\n    }\n\n    pub fn convert_pix(&self) -> Symbol<'_, ConvertPixFn> {\n        unsafe { self.lib.get(b\"convert_pix\\0\") }.expect(\"convert_pix not exported\")\n    }\n\n    /// Address of the exported `const char *cp_error_reason` global.\n    pub fn error_reason_slot(&self) -> *mut *const c_char {\n        let s: Symbol<*mut *const c_char> =\n            unsafe { self.lib.get(b\"cp_error_reason\\0\") }.expect(\"cp_error_reason not exported\");\n        unsafe { *s }\n    }\n\n    pub fn error_reason(&self) -> Option<Vec<u8>> {\n        unsafe {\n            let p: *const c_char = *self.error_reason_slot();\n            if p.is_null() {\n                None\n            } else {\n                Some(CStr::from_ptr(p).to_bytes().to_vec())\n            }\n        }\n    }\n\n    pub fn clear_error_reason(&self) {\n        unsafe { *self.error_reason_slot() = std::ptr::null() }\n    }\n\n    /// Address of an exported byte-addressable data object.\n    pub fn data_ptr(&self, sym: &[u8]) -> *mut u8 {\n        let mut owned = sym.to_vec();\n        owned.push(0);\n        let s: Symbol<*mut u8> = unsafe { self.lib.get(&owned) }\n            .unwrap_or_else(|e| panic!(\"{} not exported: {e}\", String::from_utf8_lossy(sym)));\n        unsafe { *s }\n    }\n\n    pub fn data_slice(&self, sym: &[u8], len: usize) -> &[u8] {\n        unsafe { std::slice::from_raw_parts(self.data_ptr(sym), len) }\n    }\n}\n\npub fn load_both() -> (Impl, Impl) {\n    (\n        Impl::load(\"C\", &c_so_path()),\n        Impl::load(\"Rust\", &rust_so_path()),\n    )\n}\n\n// ---------------------------------------------------------------------------\n// Page-aligned arenas with deterministic filler\n// ---------------------------------------------------------------------------\n\n/// `cp_inflate` reads and writes out of bounds for several inputs the C\n/// accepts (e.g. a stored block whose `LEN` exceeds the remaining input).\n/// To make those cases *deterministically comparable* we always hand both\n/// implementations a large, page-aligned arena filled with the same\n/// pseudo-random bytes, and afterwards compare the whole arena.\npub const ARENA: usize = 256 * 1024;\n\npub struct Arena {\n    ptr: *mut u8,\n    len: usize,\n}\n\nimpl Arena {\n    pub fn new(len: usize) -> Arena {\n        let mut p: *mut c_void = std::ptr::null_mut();\n        let rc = unsafe { libc::posix_memalign(&mut p, 4096, len) };\n        assert_eq!(rc, 0, \"posix_memalign failed\");\n        assert!(!p.is_null());\n        Arena {\n            ptr: p as *mut u8,\n            len,\n        }\n    }\n\n    pub fn filled(len: usize, seed: u64) -> Arena {\n        let mut a = Arena::new(len);\n        a.fill(seed);\n        a\n    }\n\n    pub fn fill(&mut self, seed: u64) {\n        let mut r = SplitMix::new(seed);\n        let s = unsafe { std::slice::from_raw_parts_mut(self.ptr, self.len) };\n        for chunk in s.chunks_mut(8) {\n            let v = r.next_u64().to_le_bytes();\n            chunk.copy_from_slice(&v[..chunk.len()]);\n        }\n    }\n\n    pub fn len(&self) -> usize {\n        self.len\n    }\n\n    /// Base address; always 4096-aligned, so `at(off)` has alignment\n    /// `off % 4` — the only property of the pointer that `cp_inflate`'s\n    /// `first_bytes` computation depends on.\n    pub fn at(&self, off: usize) -> *mut u8 {\n        assert!(off <= self.len);\n        unsafe { self.ptr.add(off) }\n    }\n\n    pub fn as_slice(&self) -> &[u8] {\n        unsafe { std::slice::from_raw_parts(self.ptr, self.len) }\n    }\n\n    pub fn write_at(&mut self, off: usize, bytes: &[u8]) {\n        assert!(off + bytes.len() <= self.len);\n        unsafe { std::ptr::copy_nonoverlapping(bytes.as_ptr(), self.ptr.add(off), bytes.len()) };\n    }\n}\n\nimpl Drop for Arena {\n    fn drop(&mut self) {\n        unsafe { libc::free(self.ptr as *mut c_void) }\n    }\n}\n\npub struct SplitMix(u64);\n\nimpl SplitMix {\n    pub fn new(seed: u64) -> SplitMix {\n        SplitMix(seed.wrapping_add(0x9E37_79B9_7F4A_7C15))\n    }\n    pub fn next_u64(&mut self) -> u64 {\n        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);\n        let mut z = self.0;\n        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);\n        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);\n        z ^ (z >> 31)\n    }\n    pub fn next_u32(&mut self) -> u32 {\n        (self.next_u64() >> 32) as u32\n    }\n    /// Uniform-ish in `[0, n)`.\n    pub fn below(&mut self, n: u32) -> u32 {\n        if n == 0 {\n            0\n        } else {\n            self.next_u32() % n\n        }\n    }\n    pub fn bytes(&mut self, n: usize) -> Vec<u8> {\n        let mut v = Vec::with_capacity(n);\n        while v.len() < n {\n            v.extend_from_slice(&self.next_u64().to_le_bytes());\n        }\n        v.truncate(n);\n        v\n    }\n}\n\npub fn fnv1a(bytes: &[u8]) -> u64 {\n    let mut h: u64 = 0xcbf2_9ce4_8422_2325;\n    for &b in bytes {\n        h ^= b as u64;\n        h = h.wrapping_mul(0x0000_0100_0000_01b3);\n    }\n    h\n}\n\n// ---------------------------------------------------------------------------\n// In-process differential driver for cp_inflate\n// ---------------------------------------------------------------------------\n\n#[derive(Clone, Debug)]\npub struct InflateCase {\n    /// Raw DEFLATE bytes placed into the input arena at `in_off`.\n    pub input: Vec<u8>,\n    /// Offset of the input inside the (4096-aligned) input arena.\n    /// `in_off % 4` selects `first_bytes` ∈ {0,1,2,3}.\n    pub in_off: usize,\n    /// `in_bytes` argument. `None` → `input.len()`.\n    pub in_bytes: Option<c_int>,\n    /// `out_bytes` argument.\n    pub out_bytes: c_int,\n    /// Offset of the output buffer inside the output arena.\n    pub out_off: usize,\n    /// Pass NULL instead of the arena pointer.\n    pub null_in: bool,\n    pub null_out: bool,\n    /// Seed for the arena filler (identical for both implementations).\n    pub seed: u64,\n}\n\nimpl InflateCase {\n    pub fn new(input: Vec<u8>, out_bytes: c_int) -> InflateCase {\n        InflateCase {\n            input,\n            in_off: 0,\n            in_bytes: None,\n            out_bytes,\n            out_off: 0,\n            null_in: false,\n            null_out: false,\n            seed: 0x5EED,\n        }\n    }\n    pub fn in_off(mut self, o: usize) -> Self {\n        self.in_off = o;\n        self\n    }\n    pub fn in_bytes(mut self, n: c_int) -> Self {\n        self.in_bytes = Some(n);\n        self\n    }\n    pub fn out_off(mut self, o: usize) -> Self {\n        self.out_off = o;\n        self\n    }\n    pub fn null_in(mut self) -> Self {\n        self.null_in = true;\n        self\n    }\n    pub fn null_out(mut self) -> Self {\n        self.null_out = true;\n        self\n    }\n    pub fn seed(mut self, s: u64) -> Self {\n        self.seed = s;\n        self\n    }\n    pub fn effective_in_bytes(&self) -> c_int {\n        self.in_bytes.unwrap_or(self.input.len() as c_int)\n    }\n}\n\n#[derive(PartialEq, Eq)]\npub struct InflateResult {\n    pub ret: c_int,\n    pub err: Option<Vec<u8>>,\n    /// The whole output arena after the call.\n    pub out_arena: Vec<u8>,\n    /// The whole input arena after the call (must be unmodified).\n    pub in_arena: Vec<u8>,\n}\n\nimpl std::fmt::Debug for InflateResult {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        f.debug_struct(\"InflateResult\")\n            .field(\"ret\", &self.ret)\n            .field(\n                \"err\",\n                &self\n                    .err\n                    .as_ref()\n                    .map(|e| String::from_utf8_lossy(e).into_owned()),\n            )\n            .field(\"out_arena_fnv\", &format_args!(\"{:#018x}\", fnv1a(&self.out_arena)))\n            .field(\"in_arena_fnv\", &format_args!(\"{:#018x}\", fnv1a(&self.in_arena)))\n            .finish()\n    }\n}\n\n/// Run one case against one implementation, in-process.\n///\n/// Only safe for cases that are known not to abort / segfault; use\n/// [`subproc::run_batch`] for those.\npub fn run_inflate(im: &Impl, case: &InflateCase, arena_len: usize) -> InflateResult {\n    let mut ina = Arena::filled(arena_len, case.seed ^ 0xA1);\n    let outa = Arena::filled(arena_len, case.seed ^ 0xB2);\n    ina.write_at(case.in_off, &case.input);\n\n    let in_ptr = if case.null_in {\n        std::ptr::null_mut()\n    } else {\n        ina.at(case.in_off) as *mut c_void\n    };\n    let out_ptr = if case.null_out {\n        std::ptr::null_mut()\n    } else {\n        outa.at(case.out_off) as *mut c_void\n    };\n\n    im.clear_error_reason();\n    let f = im.inflate();\n    let ret = unsafe { f(in_ptr, case.effective_in_bytes(), out_ptr, case.out_bytes) };\n    InflateResult {\n        ret,\n        err: im.error_reason(),\n        out_arena: outa.as_slice().to_vec(),\n        in_arena: ina.as_slice().to_vec(),\n    }\n}\n\n/// Assert that both implementations agree on `case`, byte for byte.\n#[track_caller]\npub fn assert_inflate_eq(c: &Impl, r: &Impl, case: &InflateCase, label: &str) {\n    assert_inflate_eq_arena(c, r, case, label, ARENA)\n}\n\n#[track_caller]\npub fn assert_inflate_eq_arena(\n    c: &Impl,\n    r: &Impl,\n    case: &InflateCase,\n    label: &str,\n    arena_len: usize,\n) {\n    let rc = run_inflate(c, case, arena_len);\n    let rr = run_inflate(r, case, arena_len);\n\n    if rc.ret != rr.ret {\n        panic!(\n            \"[{label}] return value mismatch: C={} Rust={}\\n case: in_len={} in_off={} \\\n             in_bytes={} out_bytes={} out_off={} null_in={} null_out={}\\n input={}\",\n            rc.ret,\n            rr.ret,\n            case.input.len(),\n            case.in_off,\n            case.effective_in_bytes(),\n            case.out_bytes,\n            case.out_off,\n            case.null_in,\n            case.null_out,\n            hex(&case.input),\n        );\n    }\n    if rc.err != rr.err {\n        panic!(\n            \"[{label}] cp_error_reason mismatch:\\n  C   = {:?}\\n  Rust= {:?}\\n input={}\",\n            rc.err.as_ref().map(|e| String::from_utf8_lossy(e).into_owned()),\n            rr.err.as_ref().map(|e| String::from_utf8_lossy(e).into_owned()),\n            hex(&case.input),\n        );\n    }\n    if rc.out_arena != rr.out_arena {\n        let (i, cb, rb) = first_diff(&rc.out_arena, &rr.out_arena);\n        panic!(\n            \"[{label}] output arena mismatch at byte {i} (out_off={}, out_bytes={}): \\\n             C=0x{cb:02x} Rust=0x{rb:02x}\\n input({} bytes, in_off={})={}\",\n            case.out_off,\n            case.out_bytes,\n            case.input.len(),\n            case.in_off,\n            hex(&case.input),\n        );\n    }\n    if rc.in_arena != rr.in_arena {\n        let (i, cb, rb) = first_diff(&rc.in_arena, &rr.in_arena);\n        panic!(\n            \"[{label}] INPUT arena modified differently at byte {i}: C=0x{cb:02x} \\\n             Rust=0x{rb:02x}\\n input={}\",\n            hex(&case.input)\n        );\n    }\n}\n\npub fn first_diff(a: &[u8], b: &[u8]) -> (usize, u8, u8) {\n    for i in 0..a.len().min(b.len()) {\n        if a[i] != b[i] {\n            return (i, a[i], b[i]);\n        }\n    }\n    (a.len().min(b.len()), 0, 0)\n}\n\npub fn hex(b: &[u8]) -> String {\n    let mut s = String::with_capacity(b.len() * 2);\n    for &x in b.iter().take(512) {\n        s.push_str(&format!(\"{x:02x}\"));\n    }\n    if b.len() > 512 {\n        s.push_str(\"...\");\n    }\n    s\n}\n\npub fn unhex(s: &str) -> Vec<u8> {\n    let b = s.as_bytes();\n    let mut v = Vec::with_capacity(b.len() / 2);\n    let mut i = 0;\n    while i + 1 < b.len() {\n        let hi = (b[i] as char).to_digit(16).expect(\"hex\") as u8;\n        let lo = (b[i + 1] as char).to_digit(16).expect(\"hex\") as u8;\n        v.push((hi << 4) | lo);\n        i += 2;\n    }\n    v\n}\n","structuredPatch":[{"oldStart":139,"oldLines":6,"newStart":139,"newLines":17,"lines":["     )"," }"," ","+/// `dlopen` is reference-counted, so every `#[test]` in one test binary shares","+/// a SINGLE instance of each library — and therefore a single","+/// `cp_error_reason` global.  libtest runs tests on parallel threads, so the","+/// clear→call→read sequence must be serialised or tests observe each other's","+/// error strings.","+pub static GLOBAL_LOCK: std::sync::Mutex<()> = std::sync::Mutex::new(());","+","+pub fn lock_globals() -> std::sync::MutexGuard<'static, ()> {","+    GLOBAL_LOCK.lock().unwrap_or_else(|e| e.into_inner())","+}","+"," // ---------------------------------------------------------------------------"," // Page-aligned arenas with deterministic filler"," // ---------------------------------------------------------------------------"]}],"userModified":false,"replaceAll":false}}
