{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_yzxzfjfifppg4boet7kuysr2w5ve6toq2erewimwoimrccu7f47q","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_017HpiJipSknoofaHvPTVRaU","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-AesDK8/translated_rust/tests/explore.rs","content":"//! Scratch exploration of the C's actual behaviour (run with --nocapture).\n//! Not part of the verification matrix; `#[ignore]`d.\n\nmod common;\n\nuse common::deflate::*;\nuse common::*;\nuse std::os::raw::c_int;\n\n#[test]\n#[ignore]\nfn explore_stored() {\n    let (c, r) = load_both();\n    for len in [0usize, 1, 2, 3, 4, 5, 6, 7, 8, 15, 16, 17, 31, 32, 255, 1024] {\n        for off in 0..4usize {\n            let payload: Vec<u8> = (0..len).map(|i| (i as u8).wrapping_mul(37).wrapping_add(11)).collect();\n            let stream = stored_ok(true, &payload);\n            let case = InflateCase::new(stream.clone(), len as c_int).in_off(off);\n            let rc = run_inflate(&c, &case, 8192);\n            let rr = run_inflate(&r, &case, 8192);\n            let ok_c = rc.ret == 1 && &rc.out_arena[..len] == &payload[..];\n            print!(\n                \"len={len:5} off={off} in_bytes={:5} C.ret={} correct={ok_c} match={}\",\n                stream.len(),\n                rc.ret,\n                rc.ret == rr.ret && rc.out_arena == rr.out_arena && rc.err == rr.err\n            );\n            if let Some(e) = &rc.err {\n                print!(\" err={:?}\", String::from_utf8_lossy(e));\n            }\n            println!();\n        }\n    }\n}\n\n#[test]\n#[ignore]\nfn explore_fixed() {\n    let (c, r) = load_both();\n    // literals only\n    for n in [0usize, 1, 2, 3, 4, 5, 8, 16, 100] {\n        let items: Vec<Item> = (0..n).map(|i| Item::Lit((i as u8).wrapping_mul(7))).collect();\n        let expect = simulate(&items).unwrap();\n        for off in 0..4usize {\n            let stream = fixed_only(true, &items);\n            let case = InflateCase::new(stream.clone(), expect.len() as c_int).in_off(off);\n            let rc = run_inflate(&c, &case, 8192);\n            let rr = run_inflate(&r, &case, 8192);\n            println!(\n                \"lits n={n:4} off={off} in_bytes={:4} C.ret={} correct={} match={} err={:?}\",\n                stream.len(),\n                rc.ret,\n                rc.ret == 1 && &rc.out_arena[..expect.len()] == &expect[..],\n                rc.ret == rr.ret && rc.out_arena == rr.out_arena && rc.err == rr.err,\n                rc.err.as_ref().map(|e| String::from_utf8_lossy(e).into_owned())\n            );\n        }\n    }\n}\n\n#[test]\n#[ignore]\nfn explore_flate2() {\n    use flate2::write::DeflateEncoder;\n    use flate2::Compression;\n    use std::io::Write;\n    let (c, r) = load_both();\n    for lvl in [0u32, 1, 6, 9] {\n        for n in [0usize, 1, 10, 100, 1000, 5000] {\n            let mut rng = SplitMix::new(n as u64);\n            let data: Vec<u8> = (0..n).map(|_| (rng.below(4) as u8) + b'a').collect();\n            let mut e = DeflateEncoder::new(Vec::new(), Compression::new(lvl));\n            e.write_all(&data).unwrap();\n            let stream = e.finish().unwrap();\n            let case = InflateCase::new(stream.clone(), data.len() as c_int);\n            let rc = run_inflate(&c, &case, ARENA);\n            let rr = run_inflate(&r, &case, ARENA);\n            println!(\n                \"lvl={lvl} n={n:5} in_bytes={:5} C.ret={} correct={} match={} err={:?}\",\n                stream.len(),\n                rc.ret,\n                rc.ret == 1 && &rc.out_arena[..data.len()] == &data[..],\n                rc.ret == rr.ret && rc.out_arena == rr.out_arena && rc.err == rr.err,\n                rc.err.as_ref().map(|e| String::from_utf8_lossy(e).into_owned())\n            );\n        }\n    }\n}\n\n#[test]\n#[ignore]\nfn explore_dynamic() {\n    let (c, r) = load_both();\n    // Minimal dynamic block: literals 'A', 'B' and EOB, one distance symbol.\n    let nlit = 257usize;\n    let ndst = 1usize;\n    let lens = lens_for(nlit, ndst, &[b'A' as usize, b'B' as usize, 256], &[0]);\n    let d = dynamic_from_lens(nlit, ndst, &lens);\n    let items = vec![Item::Lit(b'A'), Item::Lit(b'B'), Item::Lit(b'A')];\n    let expect = simulate(&items).unwrap();\n    let stream = d.only(true, &items);\n    println!(\"dyn stream = {}\", hex(&stream));\n    for off in 0..4usize {\n        let case = InflateCase::new(stream.clone(), expect.len() as c_int).in_off(off);\n        let rc = run_inflate(&c, &case, 8192);\n        let rr = run_inflate(&r, &case, 8192);\n        println!(\n            \"dyn off={off} C.ret={} correct={} match={} err={:?}\",\n            rc.ret,\n            rc.ret == 1 && &rc.out_arena[..expect.len()] == &expect[..],\n            rc.ret == rr.ret && rc.out_arena == rr.out_arena && rc.err == rr.err,\n            rc.err.as_ref().map(|e| String::from_utf8_lossy(e).into_owned())\n        );\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":719,"cache_read_input_tokens":156402,"cache_creation":{"ephemeral_5m_input_tokens":719,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"1f391add-adf5-472a-b38e-02e2e663f9ae","uuid":"ed3bf103-7524-4c47-9925-cae5781e2d71","timestamp":"2026-08-20T08:10:45.571Z"}
