         &c,\n                &r,\n                &dd,\n                &[Item::Lit(b'x'), Item::Lit(b'x')],\n                &format!(\"D2 L={l} hclen={nlen}\"),\n                8192,\n            );\n        }\n    }\n    seen.sort_unstable();\n    seen.dedup();\n    assert_eq!(\n        seen,\n        (5..=19usize).collect::<Vec<_>>(),\n        \"expected every HCLEN from 5 to 19 to be reachable\"\n    );\n\n    // HCLEN = 19 with a richer alphabet as well.\n    let d = dynamic_full().try_with_nlen(19).expect(\"HCLEN 19\");\n    assert_eq!(d.nlen, 19);\n    check_dyn(\n        &c,\n        &r,\n        &d,\n        &[Item::Lit(b'x'), Item::Lit(b'y'), Item::Lit(0), Item::Lit(255)],\n        \"D2 full hclen=19\",\n        8192,\n    );\n}\n\n'''\ns = s[:old_start] + new + s[old_end:]\n\n# drop the now-unused helpers\ns = s.replace('''/// Build exactly `n` bytes of output using only literals `a`/`b` and\n/// distance-1 runs (needed where only two literal codes exist).\nfn fill_items_with(n: usize, a: u8, b: u8) -> Vec<Item> {''','''/// Build exactly `n` bytes of output using only literals `a`/`b` and\n/// distance-1 runs (needed where only two literal codes exist).\n#[allow(dead_code)]\nfn fill_items_with(n: usize, a: u8, b: u8) -> Vec<Item> {''')\ns = s.replace('''/// A distance-1 match whose length symbol is 257 + k, all with `dist_sym = 0`.\nfn match_item_257(len: u32) -> Item {''','''/// A distance-1 match whose length symbol is 257 + k, all with `dist_sym = 0`.\n#[allow(dead_code)]\nfn match_item_257(len: u32) -> Item {''')\nopen(p,'w').write(s)\nprint(\"ok\")\nPYEOF\ntimeout 600 cargo test --offline --test inflate_dynamic 2>&1 | tail -30","description":"Rewrite D2 HCLEN sweep and rerun"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7031,"cache_read_input_tokens":216454,"cache_creation":{"ephemeral_5m_input_tokens":7031,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"sta