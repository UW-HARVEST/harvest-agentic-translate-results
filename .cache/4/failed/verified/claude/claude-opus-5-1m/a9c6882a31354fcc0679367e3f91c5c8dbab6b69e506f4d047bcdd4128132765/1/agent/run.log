{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_ovxspp262dxby3jvmn52lvidxnx242k3kgwcqky7xwwibkq4spfa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01H4ndyMm8vmgcDEe4ynYGAS","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-AesDK8/translated_rust/tests/aborts.rs","content":"//! Phase C — ERRORS.md rows A1..A8 and G1, G2, G8, G10.\n//!\n//! The C library is compiled WITHOUT `-DNDEBUG` (there is an undefined\n//! reference to `__assert_fail` in the `.so`), so a failed `assert()` calls\n//! `abort()` and the process dies with SIGABRT.  A NULL input pointer with a\n//! non-zero length segfaults.  Both are compared by running each case against\n//! each `.so` in a subprocess and comparing the wait status — see\n//! `tests/common/subproc.rs`.\n//!\n//! Each row additionally asserts the *specific* expected outcome, so a row\n//! cannot silently pass by both implementations doing nothing.\n\nmod common;\n\nuse common::deflate::*;\nuse common::subproc::*;\nuse common::*;\nuse std::os::raw::c_int;\n\nconst CHILD: &str = \"child_entry\";\n/// SIGABRT\nconst ABRT: i32 = 6;\n/// SIGSEGV\nconst SEGV: i32 = 11;\n\nfn spec(input: Vec<u8>, in_off: usize, in_bytes: c_int, out_bytes: c_int) -> Spec {\n    Spec::Inflate {\n        input,\n        in_off,\n        in_bytes,\n        out_bytes,\n        out_off: 0,\n        null_in: false,\n        null_out: false,\n        seed: 0xA0A0,\n        arena: ARENA,\n    }\n}\n\n#[track_caller]\nfn expect_all(specs: &[Spec], want: i32, label: &str) {\n    let out = assert_batch_eq(specs, CHILD, label);\n    for (i, o) in out.iter().enumerate() {\n        assert_eq!(\n            o,\n            &Outcome::Signal(want),\n            \"[{label}] spec #{i} ({}) gave {o:?}, expected Signal({want})\",\n            specs[i].encode()\n        );\n    }\n}\n\n// ---------------------------------------------------------------------------\n// A1 — in_bytes == 0  =>  bits_left == 0  =>  assert(s->bits_left > 0)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn a1_zero_in_bytes() {\n    let mut specs = Vec::new();\n    for off in [0usize, 1, 2, 3, 16, 17, 18, 19] {\n        for out_bytes in [0i32, 1, 4096] {\n            specs.push(spec(vec![0x01, 0x02, 0x03, 0x04], off, 0, out_bytes));\n        }\n    }\n    expect_all(&specs, ABRT, \"A1\");\n}\n\n// ---------------------------------------------------------------------------\n// A2 — negative in_bytes\n// ---------------------------------------------------------------------------\n\n#[test]\nfn a2_negative_in_bytes() {\n    let mut specs = Vec::new();\n    // The C's setup loop reads `in[in_bytes - last_bytes + i]`, i.e. *before*\n    // the buffer, so the input is placed well inside the arena to keep those\n    // reads mapped (and identical) for both implementations.\n    for off in [64usize, 65, 66, 67] {\n        for in_bytes in [-1i32, -2, -3, -4, -5, -8, -16, -100] {\n            specs.push(spec(vec![0xAA; 8], off, in_bytes, 4096));\n        }\n    }\n    // INT_MIN: `bits_left = INT_MIN * 8` wraps to 0, and `last_bytes ==\n    // INT_MIN & 3 == 0`, so there are no out-of-range reads at all.\n    for off in [64usize, 68, 72] {\n        specs.push(spec(vec![0xAA; 8], off, c_int::MIN, 4096));\n    }\n    expect_all(&specs, ABRT, \"A2\");\n}\n\n// ---------------------------------------------------------------------------\n// A3 — input exhausted mid-stream\n// ---------------------------------------------------------------------------\n\n#[test]\nfn a3_input_exhausted() {\n    // 1-byte input 0x00: BFINAL=0, BTYPE=0 -> cp_stored consumes the 5 pad\n    // bits, leaving bits_left == 0, and the 16-bit LEN read asserts.\n    let mut specs = Vec::new();\n    for off in 0..4usize {\n        for out_bytes in [0i32, 4, 4096] {\n            specs.push(spec(vec![0x00], off, 1, out_bytes));\n        }\n    }\n    // 3-byte BTYPE=0 stream: LEN is read, then the NLEN read finds\n    // bits_left == 0.\n    for off in [0usize, 4, 8] {\n        specs.push(spec(vec![0x00, 0x00, 0x00], off, 3, 4096));\n    }\n    expect_all(&specs, ABRT, \"A3\");\n}\n\n// ---------------------------------------------------------------------------\n// A4 — assert(!cp_would_overflow(s, n))\n// ---------------------------------------------------------------------------\n\n#[test]\nfn a4_would_overflow() {\n    // in_off ≡ 3 (mod 4) => first_bytes == 1, so `count` starts at 8; with\n    // in_bytes == 2 the align read leaves count == 0 and bits_left == 8, and\n    // the 16-bit LEN read then has bits_left + count - 16 == -8 < 0.\n    let mut specs = Vec::new();\n    for off in [3usize, 7, 11, 15] {\n        for b1 in [0x00u8, 0xFF, 0x55] {\n            specs.push(spec(vec![0x00, b1], off, 2, 4096));\n        }\n    }\n    // The search harness also found this shape: off=1, in_bytes=3.\n    for off in [1usize, 5, 9] {\n        specs.push(spec(vec![0x85, 0x6c, 0x86], off, 3, 1024));\n    }\n    expect_all(&specs, ABRT, \"A4\");\n}\n\n// ---------------------------------------------------------------------------\n// A5 — assert(s->count >= num_bits_to_read) in cp_consume_bits\n// ---------------------------------------------------------------------------\n\n#[test]\nfn a5_consume_bits_underflow() {\n    // 1-byte input 0x02: BFINAL=0, BTYPE=1 (fixed).  Only 5 bits remain\n    // buffered, but the first `cp_decode` matches the 7-bit end-of-block code\n    // and cp_consume_bits(7) asserts.\n    let mut specs = Vec::new();\n    for off in 0..4usize {\n        for out_bytes in [0i32, 4, 1024] {\n            specs.push(spec(vec![0x02], off, 1, out_bytes));\n        }\n    }\n    // 2-byte BTYPE=0 stream: LEN's 16-bit read passes cp_would_overflow but\n    // only 8 bits are buffered.\n    for off in [0usize, 4] {\n        specs.push(spec(vec![0x00, 0x00], off, 2, 4096));\n    }\n    expect_all(&specs, ABRT, \"A5\");\n}\n\n// ---------------------------------------------------------------------------\n// A6 — assert(!(s->bits_left & 7)) in cp_ptr\n// ---------------------------------------------------------------------------\n\n/// This needs `bits_left` to be non-byte-aligned when `cp_stored` calls\n/// `cp_ptr`.  Because `cp_read_bits(s, s->count & 7)` normally re-aligns the\n/// stream, that can only happen after `cp_peak_bits` has taken its\n/// `final_word` branch at a bit position that is NOT a multiple of 8 — the\n/// branch adds the whole remaining `bits_left` to `count` instead of just the\n/// tail bytes, which permanently shifts `count` relative to `bits_left`.\n///\n/// Construction (in_off ≡ 1 mod 4 so `first_bytes == 3`, in_bytes = 6 so\n/// `word_count == 0` and `last_bytes == 3`):\n///\n/// ```text\n///   bit  0      BFINAL = 0\n///   bits 1-2    BTYPE  = 1  (fixed)\n///   bits 3-9    end-of-block (7-bit code 0)\n///   bit  10     BFINAL = 0\n///   bits 11-12  BTYPE  = 1  (fixed)   <- cp_decode peaks here at consumed=13\n///   bits 13-19  end-of-block             and takes the final_word branch\n///   bit  20     BFINAL = 1\n///   bits 21-22  BTYPE  = 0  (stored)\n///   bits 23-26  alignment padding (count & 7 == 4)\n///   bits 27-42  LEN  = 0xFFFF\n///   bits 43-58  NLEN = 0x0000 (only 43-47 are real input; the rest read as 0)\n/// ```\n///\n/// `LEN == (uint16_t)~NLEN` passes, `bits_left` is now -11 so\n/// `bits_left / 8 == -1 <= LEN` also passes, and `-11 & 7 == 5` trips the\n/// assertion.  Verified against the C `.so`, which reports\n/// `lib.c:89: cp_ptr: Assertion '!(s->bits_left & 7)' failed.`\nfn a6_stream() -> Vec<u8> {\n    vec![0x02, 0x08, 0x10, 0xF8, 0xFF, 0x07]\n}\n\n#[test]\nfn a6_cp_ptr_misaligned() {\n    let mut specs = Vec::new();\n    for off in [1usize, 5, 9, 13, 4097] {\n        for out_bytes in [1024i32, 65536, c_int::MAX] {\n            specs.push(spec(a6_stream(), off, 6, out_bytes));\n        }\n    }\n    expect_all(&specs, ABRT, \"A6\");\n}\n\n// ---------------------------------------------------------------------------\n// A7 — assert((search >> len) == (key >> len)) in cp_decode\n// ---------------------------------------------------------------------------\n\n/// A BTYPE=2 block whose transmitted code-length lengths are all zero makes\n/// `cp_build` return 0, so `cp_decode(s, s->len, 0)` never enters its binary\n/// search and reads `tree[-1]`, which aliases `s->dst[31]`.  On a fresh\n/// `calloc`ed state that is 0, so `key & 0xF == 0`, `len == 32`, and the\n/// comparison `(search >> 32) == (key >> 32)` degenerates (on x86-64 the shift\n/// count is masked to 5 bits) into `search == key`, i.e. `search == 0` — but\n/// `search` always has its low 16 bits set to 1, so the assertion fails.\nfn a7_stream(hclen: usize) -> Vec<u8> {\n    assert!((4..=19).contains(&hclen));\n    let mut w = BitWriter::new();\n    w.bits(1, 1); // BFINAL = 1\n    w.bits(2, 2); // BTYPE  = 2 (dynamic)\n    w.bits(0, 5); // HLIT  -> nlit = 257\n    w.bits(0, 5); // HDIST -> ndst = 1\n    w.bits((hclen - 4) as u32, 4);\n    for _ in 0..hclen {\n        w.bits(0, 3); // every code-length length is zero\n    }\n    let mut out = w.finish();\n    out.extend_from_slice(&[0x00; 16]);\n    out\n}\n\n#[test]\nfn a7_decode_no_prefix() {\n    let mut specs = Vec::new();\n    for hclen in [4usize, 5, 10, 19] {\n        let s = a7_stream(hclen);\n        for off in 0..4usize {\n            specs.push(spec(s.clone(), off, s.len() as c_int, 4096));\n        }\n    }\n    // The same failure from a *fixed* block whose next bits match no code:\n    // 9 one-bits cannot be a prefix of any fixed-table code (the longest is\n    // 111111111 for symbol 255, so use a stream that runs out of tree).\n    expect_all(&specs, ABRT, \"A7\");\n}\n\n// ---------------------------------------------------------------------------\n// A8 — assert(len < 16) in cp_build\n// ---------------------------------------------------------------------------\n\n/// Reachable only via the `tree[-1]` alias described for A7, and only in a\n/// MULTI-block stream: block 1 must first populate `s->dst[31]` with a real\n/// tree entry (which needs HDIST = 32 with all 32 distance code lengths\n/// non-zero), and block 2 must then have an empty code-length tree so\n/// `cp_decode` returns `(s->dst[31] >> 4) & 0xFFF == 31`.  31 is not one of\n/// the repeat codes 16/17/18, so it is stored as a literal code length, and\n/// `cp_build` then trips `assert(len < 16)`.\n///\n/// Verified against the C `.so`, which reports\n/// `lib.c:148: cp_build: Assertion 'len < 16' failed.`\nfn a8_stream() -> Vec<u8> {\n    // Block 1: HLIT = 257, HDIST = 32, all 32 distance code lengths == 5.\n    // cp_build writes s->dst[31] = (31 << 27) | (31 << 4) | 5.\n    let mut lens = vec![0u8; 257 + 32];\n    lens[b'A' as usize] = 1;\n    lens[256] = 1;\n    for k in 0..32 {\n        lens[257 + k] = 5;\n    }\n    let d = dynamic_rle(257, 32, &lens);\n    assert_eq!(d.ndst, 32);\n    let mut w = BitWriter::new();\n    d.block(&mut w, false, &[]); // BFINAL = 0, immediate end-of-block\n\n    // Block 2: all transmitted code-length lengths are zero -> s->nlen == 0.\n    w.bits(1, 1); // BFINAL = 1\n    w.bits(2, 2); // BTYPE  = 2\n    w.bits(0, 5); // HLIT  -> 257\n    w.bits(0, 5); // HDIST -> 1\n    w.bits(0, 4); // HCLEN -> 4\n    for _ in 0..4 {\n        w.bits(0, 3);\n    }\n    // key = s->dst[31]: code length 5, code 0b11111.  The assertion in\n    // cp_decode requires exactly those bits, and yields symbol 31 each time.\n    // nlit + ndst == 258 code lengths are decoded before cp_build runs.\n    for _ in 0..258 {\n        w.huff(0b11111, 5);\n    }\n    let mut out = w.finish();\n    out.extend_from_slice(&[0xFF; 64]);\n    out\n}\n\n#[test]\nfn a8_build_length_out_of_range() {\n    let s = a8_stream();\n    let mut specs = Vec::new();\n    for off in 0..4usize {\n        for out_bytes in [4096i32, 65536] {\n            specs.push(spec(s.clone(), off, s.len() as c_int, out_bytes));\n        }\n    }\n    expect_all(&specs, ABRT, \"A8\");\n}\n\n// ---------------------------------------------------------------------------\n// G1, G2 — NULL input pointer\n// ---------------------------------------------------------------------------\n\n#[test]\nfn g1_null_in_zero_bytes() {\n    // bits_left == 0 asserts before `s->words` is ever dereferenced.\n    let mut specs = Vec::new();\n    for out_bytes in [0i32, 1, 4096] {\n        specs.push(Spec::Inflate {\n            input: vec![],\n            in_off: 0,\n            in_bytes: 0,\n            out_bytes,\n            out_off: 0,\n            null_in: true,\n            null_out: false,\n            seed: 0x9001,\n            arena: ARENA,\n        });\n    }\n    expect_all(&specs, ABRT, \"G1\");\n}\n\n#[test]\nfn g2_null_in_nonzero_bytes() {\n    let mut specs = Vec::new();\n    for in_bytes in [1i32, 2, 3, 4, 8, 4096] {\n        specs.push(Spec::Inflate {\n            input: vec![],\n            in_off: 0,\n            in_bytes,\n            out_bytes: 4096,\n            out_off: 0,\n            null_in: true,\n            null_out: false,\n            seed: 0x9002,\n            arena: ARENA,\n        });\n    }\n    expect_all(&specs, SEGV, \"G2\");\n}\n\n// ---------------------------------------------------------------------------\n// G8 — every BTYPE value from a 1-byte input, and all 256 first bytes\n// ---------------------------------------------------------------------------\n\n/// A C `int`/2-bit enum field: every one of the four BTYPE values 0..3 is a\n/// real input, including the reserved 3.  Sweeping all 256 possible single\n/// bytes at all four alignments and all three interesting `out_bytes` covers\n/// every BFINAL/BTYPE combination and every padding-bit pattern.\n#[test]\nfn g8_one_byte_all_btypes() {\n    let mut specs = Vec::new();\n    for b in 0u16..256 {\n        for off in 0..4usize {\n            specs.push(spec(vec![b as u8], off, 1, 1024));\n        }\n    }\n    let out = assert_batch_eq(&specs, CHILD, \"G8\");\n    // Sanity: all four BTYPEs must actually be represented, and both a fatal\n    // and a non-fatal outcome must occur, otherwise the sweep proves little.\n    let fatal = out.iter().filter(|o| matches!(o, Outcome::Signal(_))).count();\n    let returned = out.len() - fatal;\n    assert!(fatal > 0 && returned > 0, \"G8: fatal={fatal} returned={returned}\");\n    // BTYPE == 3 (bits 1-2 both set) must always be the E6 rejection.\n    for (i, o) in out.iter().enumerate() {\n        let b = specs[i].clone();\n        let byte = match &b {\n            Spec::Inflate { input, .. } => input[0],\n            _ => unreachable!(),\n        };\n        if (byte >> 1) & 3 == 3 {\n            match o {\n                Outcome::Returned { ret, err, .. } => {\n                    assert_eq!(*ret, 0, \"G8 byte={byte:#04x}: BTYPE 3 must return 0\");\n                    assert_eq!(\n                        err.as_deref(),\n                        Some(&b\"Detected unknown block type within input stream.\"[..]),\n                        \"G8 byte={byte:#04x}: wrong reason\"\n                    );\n                }\n                other => panic!(\"G8 byte={byte:#04x}: BTYPE 3 gave {other:?}\"),\n            }\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// G10 — truncation sweep over valid streams\n// ---------------------------------------------------------------------------\n\n#[test]\nfn g10_truncation_sweep() {\n    use flate2::write::DeflateEncoder;\n    use flate2::Compression;\n    use std::io::Write;\n\n    let mut rng = SplitMix::new(0x1010);\n    let mut streams: Vec<(String, Vec<u8>)> = Vec::new();\n    streams.push((\"stored8\".into(), stored_ok(true, &rng.bytes(8))));\n    streams.push((\n        \"fixedlits\".into(),\n        fixed_only(true, &rng.bytes(10).into_iter().map(Item::Lit).collect::<Vec<_>>()),\n    ));\n    streams.push((\n        \"fixedmatch\".into(),\n        fixed_only(\n            true,\n            &[Item::Lit(b'a'), match_item(120, 1), Item::Lit(b'b')],\n        ),\n    ));\n    {\n        let lens = lens_for(257, 1, &[b'a' as usize, b'b' as usize, 256], &[0]);\n        let d = dynamic_from_lens(257, 1, &lens);\n        streams.push((\n            \"dynamic\".into(),\n            d.only(true, &[Item::Lit(b'a'), Item::Lit(b'b'), Item::Lit(b'a')]),\n        ));\n    }\n    {\n        let data: Vec<u8> = (0..60).map(|_| b'a' + rng.below(4) as u8).collect();\n        let mut e = DeflateEncoder::new(Vec::new(), Compression::new(9));\n        e.write_all(&data).unwrap();\n        streams.push((\"flate2\".into(), e.finish().unwrap()));\n    }\n\n    let mut specs = Vec::new();\n    let mut labels = Vec::new();\n    for (name, s) in &streams {\n        for k in 0..=s.len() {\n            for off in [0usize, 1, 2, 3] {\n                specs.push(spec(s[..k].to_vec(), off, k as c_int, 4096));\n                labels.push(format!(\"{name} trunc={k} off={off}\"));\n            }\n        }\n    }\n    assert!(specs.len() > 200, \"only {} truncation specs\", specs.len());\n    let out = assert_batch_eq(&specs, CHILD, \"G10\");\n    let fatal = out.iter().filter(|o| matches!(o, Outcome::Signal(_))).count();\n    assert!(fatal > 0, \"G10: no truncation was fatal — sweep is not exercising the asserts\");\n    eprintln!(\n        \"G10: {} specs, {} fatal, {} returned\",\n        out.len(),\n        fatal,\n        out.len() - fatal\n    );\n}\n\n// ---------------------------------------------------------------------------\n// Child process entry point (a no-op in a normal test run)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn child_entry() {\n    common::subproc::child_entry();\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":523,"cache_read_input_tokens":290253,"cache_creation":{"ephemeral_5m_input_tokens":523,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"1f391add-adf5-472a-b38e-02e2e663f9ae","uuid":"b2493ba4-7c6e-4e5e-91bf-ad5b64fb3a8c","timestamp":"2026-08-20T09:11:08.582Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01H4ndyMm8vmgcDEe4ynYGAS","type":"tool_result","content":"File created successfully at: /local/home/scheschb/.harvest/work/harvest-work-AesDK8/translated_rust/tests/aborts.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"1f391add-adf5-472a-b38e-02e2e663f9ae","uuid":"5f3ec4a6-eeb0-47ea-b447-c8c04cc46f5f","timestamp":"2026-08-20T09:11:08.590Z","tool_use_result":{"type":"create","filePath":"/local/home/scheschb/.harvest/work/harvest-work-AesDK8/translated_rust/tests/aborts.rs","content":"//! Phase C — ERRORS.md rows A1..A8 and G1, G2, G8, G10.\n//!\n//! The C library is compiled WITHOUT `-DNDEBUG` (there is an undefined\n//! reference to `__assert_fail` in the `.so`), so a failed `assert()` calls\n//! `abort()` and the process dies with SIGABRT.  A NULL input pointer with a\n//! non-zero length segfaults.  Both are compared by running each case against\n//! each `.so` in a subprocess and comparing the wait status — see\n//! `tests/common/subproc.rs`.\n//!\n//! Each row additionally asserts the *specific* expected outcome, so a row\n//! cannot silently pass by both implementations doing nothing.\n\nmod common;\n\nuse common::deflate::*;\nuse common::subproc::*;\nuse common::*;\nuse std::os::raw::c_int;\n\nconst CHILD: &str = \"child_entry\";\n/// SIGABRT\nconst ABRT: i32 = 6;\n/// SIGSEGV\nconst SEGV: i32 = 11;\n\nfn spec(input: Vec<u8>, in_off: usize, in_bytes: c_int, out_bytes: c_int) -> Spec {\n    Spec::Inflate {\n        input,\n        in_off,\n        in_bytes,\n        out_bytes,\n        out_off: 0,\n        null_in: false,\n        null_out: false,\n        seed: 0xA0A0,\n        arena: ARENA,\n    }\n}\n\n#[track_caller]\nfn expect_all(specs: &[Spec], want: i32, label: &str) {\n    let out = assert_batch_eq(specs, CHILD, label);\n    for (i, o) in out.iter().enumerate() {\n        assert_eq!(\n            o,\n            &Outcome::Signal(want),\n            \"[{label}] spec #{i} ({}) gave {o:?}, expected Signal({want})\",\n            specs[i].encode()\n        );\n    }\n}\n\n// ---------------------------------------------------------------------------\n// A1 — in_bytes == 0  =>  bits_left == 0  =>  assert(s->bits_left > 0)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn a1_zero_in_bytes() {\n    let mut specs = Vec::new();\n    for off in [0usize, 1, 2, 3, 16, 17, 18, 19] {\n        for out_bytes in [0i32, 1, 4096] {\n            specs.push(spec(vec![0x01, 0x02, 0x03, 0x04], off, 0, out_bytes));\n        }\n    }\n    expect_all(&specs, ABRT, \"A1\");\n}\n\n// ---------------------------------------------------------------------------\n// A2 — negative in_bytes\n// ---------------------------------------------------------------------------\n\n#[test]\nfn a2_negative_in_bytes() {\n    let mut specs = Vec::new();\n    // The C's setup loop reads `in[in_bytes - last_bytes + i]`, i.e. *before*\n    // the buffer, so the input is placed well inside the arena to keep those\n    // reads mapped (and identical) for both implementations.\n    for off in [64usize, 65, 66, 67] {\n        for in_bytes in [-1i32, -2, -3, -4, -5, -8, -16, -100] {\n            specs.push(spec(vec![0xAA; 8], off, in_bytes, 4096));\n        }\n    }\n    // INT_MIN: `bits_left = INT_MIN * 8` wraps to 0, and `last_bytes ==\n    // INT_MIN & 3 == 0`, so there are no out-of-range reads at all.\n    for off in [64usize, 68, 72] {\n        specs.push(spec(vec![0xAA; 8], off, c_int::MIN, 4096));\n    }\n    expect_all(&specs, ABRT, \"A2\");\n}\n\n// ---------------------------------------------------------------------------\n// A3 — input exhausted mid-stream\n// ---------------------------------------------------------------------------\n\n#[test]\nfn a3_input_exhausted() {\n    // 1-byte input 0x00: BFINAL=0, BTYPE=0 -> cp_stored consumes the 5 pad\n    // bits, leaving bits_left == 0, and the 16-bit LEN read asserts.\n    let mut specs = Vec::new();\n    for off in 0..4usize {\n        for out_bytes in [0i32, 4, 4096] {\n            specs.push(spec(vec![0x00], off, 1, out_bytes));\n        }\n    }\n    // 3-byte BTYPE=0 stream: LEN is read, then the NLEN read finds\n    // bits_left == 0.\n    for off in [0usize, 4, 8] {\n        specs.push(spec(vec![0x00, 0x00, 0x00], off, 3, 4096));\n    }\n    expect_all(&specs, ABRT, \"A3\");\n}\n\n// ---------------------------------------------------------------------------\n// A4 — assert(!cp_would_overflow(s, n))\n// ---------------------------------------------------------------------------\n\n#[test]\nfn a4_would_overflow() {\n    // in_off ≡ 3 (mod 4) => first_bytes == 1, so `count` starts at 8; with\n    // in_bytes == 2 the align read leaves count == 0 and bits_left == 8, and\n    // the 16-bit LEN read then has bits_left + count - 16 == -8 < 0.\n    let mut specs = Vec::new();\n    for off in [3usize, 7, 11, 15] {\n        for b1 in [0x00u8, 0xFF, 0x55] {\n            specs.push(spec(vec![0x00, b1], off, 2, 4096));\n        }\n    }\n    // The search harness also found this shape: off=1, in_bytes=3.\n    for off in [1usize, 5, 9] {\n        specs.push(spec(vec![0x85, 0x6c, 0x86], off, 3, 1024));\n    }\n    expect_all(&specs, ABRT, \"A4\");\n}\n\n// ---------------------------------------------------------------------------\n// A5 — assert(s->count >= num_bits_to_read) in cp_consume_bits\n// ---------------------------------------------------------------------------\n\n#[test]\nfn a5_consume_bits_underflow() {\n    // 1-byte input 0x02: BFINAL=0, BTYPE=1 (fixed).  Only 5 bits remain\n    // buffered, but the first `cp_decode` matches the 7-bit end-of-block code\n    // and cp_consume_bits(7) asserts.\n    let mut specs = Vec::new();\n    for off in 0..4usize {\n        for out_bytes in [0i32, 4, 1024] {\n            specs.push(spec(vec![0x02], off, 1, out_bytes));\n        }\n    }\n    // 2-byte BTYPE=0 stream: LEN's 16-bit read passes cp_would_overflow but\n    // only 8 bits are buffered.\n    for off in [0usize, 4] {\n        specs.push(spec(vec![0x00, 0x00], off, 2, 4096));\n    }\n    expect_all(&specs, ABRT, \"A5\");\n}\n\n// ---------------------------------------------------------------------------\n// A6 — assert(!(s->bits_left & 7)) in cp_ptr\n// ---------------------------------------------------------------------------\n\n/// This needs `bits_left` to be non-byte-aligned when `cp_stored` calls\n/// `cp_ptr`.  Because `cp_read_bits(s, s->count & 7)` normally re-aligns the\n/// stream, that can only happen after `cp_peak_bits` has taken its\n/// `final_word` branch at a bit position that is NOT a multiple of 8 — the\n/// branch adds the whole remaining `bits_left` to `count` instead of just the\n/// tail bytes, which permanently shifts `count` relative to `bits_left`.\n///\n/// Construction (in_off ≡ 1 mod 4 so `first_bytes == 3`, in_bytes = 6 so\n/// `word_count == 0` and `last_bytes == 3`):\n///\n/// ```text\n///   bit  0      BFINAL = 0\n///   bits 1-2    BTYPE  = 1  (fixed)\n///   bits 3-9    end-of-block (7-bit code 0)\n///   bit  10     BFINAL = 0\n///   bits 11-12  BTYPE  = 1  (fixed)   <- cp_decode peaks here at consumed=13\n///   bits 13-19  end-of-block             and takes the final_word branch\n///   bit  20     BFINAL = 1\n///   bits 21-22  BTYPE  = 0  (stored)\n///   bits 23-26  alignment padding (count & 7 == 4)\n///   bits 27-42  LEN  = 0xFFFF\n///   bits 43-58  NLEN = 0x0000 (only 43-47 are real input; the rest read as 0)\n/// ```\n///\n/// `LEN == (uint16_t)~NLEN` passes, `bits_left` is now -11 so\n/// `bits_left / 8 == -1 <= LEN` also passes, and `-11 & 7 == 5` trips the\n/// assertion.  Verified against the C `.so`, which reports\n/// `lib.c:89: cp_ptr: Assertion '!(s->bits_left & 7)' failed.`\nfn a6_stream() -> Vec<u8> {\n    vec![0x02, 0x08, 0x10, 0xF8, 0xFF, 0x07]\n}\n\n#[test]\nfn a6_cp_ptr_misaligned() {\n    let mut specs = Vec::new();\n    for off in [1usize, 5, 9, 13, 4097] {\n        for out_bytes in [1024i32, 65536, c_int::MAX] {\n            specs.push(spec(a6_stream(), off, 6, out_bytes));\n        }\n    }\n    expect_all(&specs, ABRT, \"A6\");\n}\n\n// ---------------------------------------------------------------------------\n// A7 — assert((search >> len) == (key >> len)) in cp_decode\n// ---------------------------------------------------------------------------\n\n/// A BTYPE=2 block whose transmitted code-length lengths are all zero makes\n/// `cp_build` return 0, so `cp_decode(s, s->len, 0)` never enters its binary\n/// search and reads `tree[-1]`, which aliases `s->dst[31]`.  On a fresh\n/// `calloc`ed state that is 0, so `key & 0xF == 0`, `len == 32`, and the\n/// comparison `(search >> 32) == (key >> 32)` degenerates (on x86-64 the shift\n/// count is masked to 5 bits) into `search == key`, i.e. `search == 0` — but\n/// `search` always has its low 16 bits set to 1, so the assertion fails.\nfn a7_stream(hclen: usize) -> Vec<u8> {\n    assert!((4..=19).contains(&hclen));\n    let mut w = BitWriter::new();\n    w.bits(1, 1); // BFINAL = 1\n    w.bits(2, 2); // BTYPE  = 2 (dynamic)\n    w.bits(0, 5); // HLIT  -> nlit = 257\n    w.bits(0, 5); // HDIST -> ndst = 1\n    w.bits((hclen - 4) as u32, 4);\n    for _ in 0..hclen {\n        w.bits(0, 3); // every code-length length is zero\n    }\n    let mut out = w.finish();\n    out.extend_from_slice(&[0x00; 16]);\n    out\n}\n\n#[test]\nfn a7_decode_no_prefix() {\n    let mut specs = Vec::new();\n    for hclen in [4usize, 5, 10, 19] {\n        let s = a7_stream(hclen);\n        for off in 0..4usize {\n            specs.push(spec(s.clone(), off, s.len() as c_int, 4096));\n        }\n    }\n    // The same failure from a *fixed* block whose next bits match no code:\n    // 9 one-bits cannot be a prefix of any fixed-table code (the longest is\n    // 111111111 for symbol 255, so use a stream that runs out of tree).\n    expect_all(&specs, ABRT, \"A7\");\n}\n\n// ---------------------------------------------------------------------------\n// A8 — assert(len < 16) in cp_build\n// ---------------------------------------------------------------------------\n\n/// Reachable only via the `tree[-1]` alias described for A7, and only in a\n/// MULTI-block stream: block 1 must first populate `s->dst[31]` with a real\n/// tree entry (which needs HDIST = 32 with all 32 distance code lengths\n/// non-zero), and block 2 must then have an empty code-length tree so\n/// `cp_decode` returns `(s->dst[31] >> 4) & 0xFFF == 31`.  31 is not one of\n/// the repeat codes 16/17/18, so it is stored as a literal code length, and\n/// `cp_build` then trips `assert(len < 16)`.\n///\n/// Verified against the C `.so`, which reports\n/// `lib.c:148: cp_build: Assertion 'len < 16' failed.`\nfn a8_stream() -> Vec<u8> {\n    // Block 1: HLIT = 257, HDIST = 32, all 32 distance code lengths == 5.\n    // cp_build writes s->dst[31] = (31 << 27) | (31 << 4) | 5.\n    let mut lens = vec![0u8; 257 + 32];\n    lens[b'A' as usize] = 1;\n    lens[256] = 1;\n    for k in 0..32 {\n        lens[257 + k] = 5;\n    }\n    let d = dynamic_rle(257, 32, &lens);\n    assert_eq!(d.ndst, 32);\n    let mut w = BitWriter::new();\n    d.block(&mut w, false, &[]); // BFINAL = 0, immediate end-of-block\n\n    // Block 2: all transmitted code-length lengths are zero -> s->nlen == 0.\n    w.bits(1, 1); // BFINAL = 1\n    w.bits(2, 2); // BTYPE  = 2\n    w.bits(0, 5); // HLIT  -> 257\n    w.bits(0, 5); // HDIST -> 1\n    w.bits(0, 4); // HCLEN -> 4\n    for _ in 0..4 {\n        w.bits(0, 3);\n    }\n    // key = s->dst[31]: code length 5, code 0b11111.  The assertion in\n    // cp_decode requires exactly those bits, and yields symbol 31 each time.\n    // nlit + ndst == 258 code lengths are decoded before cp_build runs.\n    for _ in 0..258 {\n        w.huff(0b11111, 5);\n    }\n    let mut out = w.finish();\n    out.extend_from_slice(&[0xFF; 64]);\n    out\n}\n\n#[test]\nfn a8_build_length_out_of_range() {\n    let s = a8_stream();\n    let mut specs = Vec::new();\n    for off in 0..4usize {\n        for out_bytes in [4096i32, 65536] {\n            specs.push(spec(s.clone(), off, s.len() as c_int, out_bytes));\n        }\n    }\n    expect_all(&specs, ABRT, \"A8\");\n}\n\n// ---------------------------------------------------------------------------\n// G1, G2 — NULL input pointer\n// ---------------------------------------------------------------------------\n\n#[test]\nfn g1_null_in_zero_bytes() {\n    // bits_left == 0 asserts before `s->words` is ever dereferenced.\n    let mut specs = Vec::new();\n    for out_bytes in [0i32, 1, 4096] {\n        specs.push(Spec::Inflate {\n            input: vec![],\n            in_off: 0,\n            in_bytes: 0,\n            out_bytes,\n            out_off: 0,\n            null_in: true,\n            null_out: false,\n            seed: 0x9001,\n            arena: ARENA,\n        });\n    }\n    expect_all(&specs, ABRT, \"G1\");\n}\n\n#[test]\nfn g2_null_in_nonzero_bytes() {\n    let mut specs = Vec::new();\n    for in_bytes in [1i32, 2, 3, 4, 8, 4096] {\n        specs.push(Spec::Inflate {\n            input: vec![],\n            in_off: 0,\n            in_bytes,\n            out_bytes: 4096,\n            out_off: 0,\n            null_in: true,\n            null_out: false,\n            seed: 0x9002,\n            arena: ARENA,\n        });\n    }\n    expect_all(&specs, SEGV, \"G2\");\n}\n\n// ---------------------------------------------------------------------------\n// G8 — every BTYPE value from a 1-byte input, and all 256 first bytes\n// ---------------------------------------------------------------------------\n\n/// A C `int`/2-bit enum field: every one of the four BTYPE values 0..3 is a\n/// real input, including the reserved 3.  Sweeping all 256 possible single\n/// bytes at all four alignments and all three interesting `out_bytes` covers\n/// every BFINAL/BTYPE combination and every padding-bit pattern.\n#[test]\nfn g8_one_byte_all_btypes() {\n    let mut specs = Vec::new();\n    for b in 0u16..256 {\n        for off in 0..4usize {\n            specs.push(spec(vec![b as u8], off, 1, 1024));\n        }\n    }\n    let out = assert_batch_eq(&specs, CHILD, \"G8\");\n    // Sanity: all four BTYPEs must actually be represented, and both a fatal\n    // and a non-fatal outcome must occur, otherwise the sweep proves little.\n    let fatal = out.iter().filter(|o| matches!(o, Outcome::Signal(_))).count();\n    let returned = out.len() - fatal;\n    assert!(fatal > 0 && returned > 0, \"G8: fatal={fatal} returned={returned}\");\n    // BTYPE == 3 (bits 1-2 both set) must always be the E6 rejection.\n    for (i, o) in out.iter().enumerate() {\n        let b = specs[i].clone();\n        let byte = match &b {\n            Spec::Inflate { input, .. } => input[0],\n            _ => unreachable!(),\n        };\n        if (byte >> 1) & 3 == 3 {\n            match o {\n                Outcome::Returned { ret, err, .. } => {\n                    assert_eq!(*ret, 0, \"G8 byte={byte:#04x}: BTYPE 3 must return 0\");\n                    assert_eq!(\n                        err.as_deref(),\n                        Some(&b\"Detected unknown block type within input stream.\"[..]),\n                        \"G8 byte={byte:#04x}: wrong reason\"\n                    );\n                }\n                other => panic!(\"G8 byte={byte:#04x}: BTYPE 3 gave {other:?}\"),\n            }\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// G10 — truncation sweep over valid streams\n// ---------------------------------------------------------------------------\n\n#[test]\nfn g10_truncation_sweep() {\n    use flate2::write::DeflateEncoder;\n    use flate2::Compression;\n    use std::io::Write;\n\n    let mut rng = SplitMix::new(0x1010);\n    let mut streams: Vec<(String, Vec<u8>)> = Vec::new();\n    streams.push((\"stored8\".into(), stored_ok(true, &rng.bytes(8))));\n    streams.push((\n        \"fixedlits\".into(),\n        fixed_only(true, &rng.bytes(10).into_iter().map(Item::Lit).collect::<Vec<_>>()),\n    ));\n    streams.push((\n        \"fixedmatch\".into(),\n        fixed_only(\n            true,\n            &[Item::Lit(b'a'), match_item(120, 1), Item::Lit(b'b')],\n        ),\n    ));\n    {\n        let lens = lens_for(257, 1, &[b'a' as usize, b'b' as usize, 256], &[0]);\n        let d = dynamic_from_lens(257, 1, &lens);\n        streams.push((\n            \"dynamic\".into(),\n            d.only(true, &[Item::Lit(b'a'), Item::Lit(b'b'), Item::Lit(b'a')]),\n        ));\n    }\n    {\n        let data: Vec<u8> = (0..60).map(|_| b'a' + rng.below(4) as u8).collect();\n        let mut e = DeflateEncoder::new(Vec::new(), Compression::new(9));\n        e.write_all(&data).unwrap();\n        streams.push((\"flate2\".into(), e.finish().unwrap()));\n    }\n\n    let mut specs = Vec::new();\n    let mut labels = Vec::new();\n    for (name, s) in &streams {\n        for k in 0..=s.len() {\n            for off in [0usize, 1, 2, 3] {\n                specs.push(spec(s[..k].to_vec(), off, k as c_int, 4096));\n                labels.push(format!(\"{name} trunc={k} off={off}\"));\n            }\n        }\n    }\n    assert!(specs.len() > 200, \"only {} truncation specs\", specs.len());\n    let out = assert_batch_eq(&specs, CHILD, \"G10\");\n    let fatal = out.iter().filter(|o| matches!(o, Outcome::Signal(_))).count();\n    assert!(fatal > 0, \"G10: no truncation was fatal — sweep is not exercising the asserts\");\n    eprintln!(\n        \"G10: {} specs, {} fatal, {} returned\",\n        out.len(),\n        fatal,\n        out.len() - fatal\n    );\n}\n\n// ---------------------------------------------------------------------------\n// Child process entry point (a no-op in a normal test run)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn child_entry() {\n    common::subproc::child_entry();\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
