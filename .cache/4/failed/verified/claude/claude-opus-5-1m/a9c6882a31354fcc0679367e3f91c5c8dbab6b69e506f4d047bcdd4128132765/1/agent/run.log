-------------------------------------------\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub enum Spec {\n    Inflate {\n        input: Vec<u8>,\n        in_off: usize,\n        in_bytes: c_int,\n        out_bytes: c_int,\n        out_off: usize,\n        null_in: bool,\n        null_out: bool,\n        seed: u64,\n        arena: usize,\n    },\n    ConvertPix {\n        bpp: c_int,\n        w: c_int,\n        h: c_int,\n        src: Vec<u8>,\n        src_off: usize,\n        dst_off: usize,\n        null_src: bool,\n        null_dst: bool,\n        seed: u64,\n        arena: usize,\n    },\n}\n\nimpl Spec {\n    pub fn inflate(input: Vec<u8>, out_bytes: c_int) -> Spec {\n        let n = input.len() as c_int;\n        Spec::Inflate {\n            input,\n            in_off: 0,\n            in_bytes: n,\n            out_bytes,\n            out_off: 0,\n            null_in: false,\n            null_out: false,\n            seed: 0x5EED,\n            arena: super::ARENA,\n        }\n    }\n\n    pub fn encode(&self) -> String {\n        match self {\n            Spec::Inflate {\n                input,\n                in_off,\n                in_bytes,\n                out_bytes,\n                out_off,\n                null_in,\n                null_out,\n                seed,\n                arena,\n            } => format!(\n                \"I {} {} {} {} {} {} {} {} {}\",\n                if input.is_empty() {\n                    \"-\".to_string()\n                } else {\n                    hex(input)\n                },\n                in_off,\n                in_bytes,\n                out_bytes,\n                out_off,\n                *null_in as u8,\n                *null_out as u8,\n                seed,\n                arena\n            ),\n            Spec::ConvertPix {\n                bpp,\n                w,\n                h,\n                src,\n                src_off,\n                dst_off,\n                null_src,\n               