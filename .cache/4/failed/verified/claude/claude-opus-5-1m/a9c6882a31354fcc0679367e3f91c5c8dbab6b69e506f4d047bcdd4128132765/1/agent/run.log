{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_iatyturi274mgvyo22hbrl6uv6r4qwn6yridt6et35lqzwrce7hq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_0147GdS8f5LekxHTd5TcKiYz","name":"Edit","input":{"replace_all":false,"file_path":"/local/home/scheschb/.harvest/work/harvest-work-AesDK8/translated_rust/tests/common/subproc.rs","old_string":"    let specs_path = std::env::var(ENV_SPECS).expect(ENV_SPECS);","new_string":"    // Many of these cases die from SIGABRT/SIGSEGV.  Without this, every death\n    // would hand a core to systemd-coredump, which makes the suite ~100x\n    // slower (and litters the journal).\n    unsafe {\n        let rl = libc::rlimit {\n            rlim_cur: 0,\n            rlim_max: 0,\n        };\n        libc::setrlimit(libc::RLIMIT_CORE, &rl);\n    }\n    let specs_path = std::env::var(ENV_SPECS).expect(ENV_SPECS);"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1038,"cache_read_input_tokens":277174,"cache_creation":{"ephemeral_5m_input_tokens":1038,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"1f391add-adf5-472a-b38e-02e2e663f9ae","uuid":"53972265-0e9a-4aba-a54c-e478c04d2fc6","timestamp":"2026-08-20T09:07:45.274Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_0147GdS8f5LekxHTd5TcKiYz","type":"tool_result","content":"The file /local/home/scheschb/.harvest/work/harvest-work-AesDK8/translated_rust/tests/common/subproc.rs has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"1f391add-adf5-472a-b38e-02e2e663f9ae","uuid":"7cc2a604-4080-4d37-a8bd-59f671d6214f","timestamp":"2026-08-20T09:07:45.285Z","tool_use_result":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-AesDK8/translated_rust/tests/common/subproc.rs","oldString":"    let specs_path = std::env::var(ENV_SPECS).expect(ENV_SPECS);","newString":"    // Many of these cases die from SIGABRT/SIGSEGV.  Without this, every death\n    // would hand a core to systemd-coredump, which makes the suite ~100x\n    // slower (and litters the journal).\n    unsafe {\n        let rl = libc::rlimit {\n            rlim_cur: 0,\n            rlim_max: 0,\n        };\n        libc::setrlimit(libc::RLIMIT_CORE, &rl);\n    }\n    let specs_path = std::env::var(ENV_SPECS).expect(ENV_SPECS);","originalFile":"//! Subprocess differential driver.\n//!\n//! Several inputs the C library accepts make it die: `assert()` is compiled in\n//! (no `-DNDEBUG`), so a failed assertion `abort()`s, and a NULL input pointer\n//! segfaults.  To compare those outcomes we re-execute the *test binary itself*\n//! as a child (`--exact <child test name>` with `CP_CHILD_*` in the\n//! environment).  The child runs a batch of cases against ONE `.so`, appending\n//! one result line per completed case and `fsync`ing, then exits 0.  If it is\n//! killed, the parent sees the signal and knows exactly which case did it\n//! (the first one with no result line), records that, and restarts the batch\n//! after it.\n//!\n//! Both the C `.so` and the Rust `.so` are driven this way, so signals,\n//! return values, `cp_error_reason` and the full output arena are all compared.\n\n#![allow(dead_code)]\n\nuse super::{fnv1a, hex, unhex, Arena, Impl};\nuse std::io::Write;\nuse std::os::raw::{c_int, c_void};\nuse std::path::{Path, PathBuf};\nuse std::process::Command;\n\npub const ENV_SO: &str = \"CP_CHILD_SO\";\npub const ENV_SPECS: &str = \"CP_CHILD_SPECS\";\npub const ENV_OUT: &str = \"CP_CHILD_OUT\";\npub const ENV_START: &str = \"CP_CHILD_START\";\n\n// ---------------------------------------------------------------------------\n// Spec\n// ---------------------------------------------------------------------------\n\n#[derive(Clone, Debug, PartialEq, Eq)]\npub enum Spec {\n    Inflate {\n        input: Vec<u8>,\n        in_off: usize,\n        in_bytes: c_int,\n        out_bytes: c_int,\n        out_off: usize,\n        null_in: bool,\n        null_out: bool,\n        seed: u64,\n        arena: usize,\n    },\n    ConvertPix {\n        bpp: c_int,\n        w: c_int,\n        h: c_int,\n        src: Vec<u8>,\n        src_off: usize,\n        dst_off: usize,\n        null_src: bool,\n        null_dst: bool,\n        seed: u64,\n        arena: usize,\n    },\n}\n\nimpl Spec {\n    pub fn inflate(input: Vec<u8>, out_bytes: c_int) -> Spec {\n        let n = input.len() as c_int;\n        Spec::Inflate {\n            input,\n            in_off: 0,\n            in_bytes: n,\n            out_bytes,\n            out_off: 0,\n            null_in: false,\n            null_out: false,\n            seed: 0x5EED,\n            arena: super::ARENA,\n        }\n    }\n\n    pub fn encode(&self) -> String {\n        match self {\n            Spec::Inflate {\n                input,\n                in_off,\n                in_bytes,\n                out_bytes,\n                out_off,\n                null_in,\n                null_out,\n                seed,\n                arena,\n            } => format!(\n                \"I {} {} {} {} {} {} {} {} {}\",\n                if input.is_empty() {\n                    \"-\".to_string()\n                } else {\n                    hex(input)\n                },\n                in_off,\n                in_bytes,\n                out_bytes,\n                out_off,\n                *null_in as u8,\n                *null_out as u8,\n                seed,\n                arena\n            ),\n            Spec::ConvertPix {\n                bpp,\n                w,\n                h,\n                src,\n                src_off,\n                dst_off,\n                null_src,\n                null_dst,\n                seed,\n                arena,\n            } => format!(\n                \"P {} {} {} {} {} {} {} {} {} {}\",\n                bpp,\n                w,\n                h,\n                if src.is_empty() {\n                    \"-\".to_string()\n                } else {\n                    hex(src)\n                },\n                src_off,\n                dst_off,\n                *null_src as u8,\n                *null_dst as u8,\n                seed,\n                arena\n            ),\n        }\n    }\n\n    pub fn decode(line: &str) -> Spec {\n        let f: Vec<&str> = line.split_whitespace().collect();\n        match f[0] {\n            \"I\" => Spec::Inflate {\n                input: if f[1] == \"-\" { Vec::new() } else { unhex(f[1]) },\n                in_off: f[2].parse().unwrap(),\n                in_bytes: f[3].parse().unwrap(),\n                out_bytes: f[4].parse().unwrap(),\n                out_off: f[5].parse().unwrap(),\n                null_in: f[6] == \"1\",\n                null_out: f[7] == \"1\",\n                seed: f[8].parse().unwrap(),\n                arena: f[9].parse().unwrap(),\n            },\n            \"P\" => Spec::ConvertPix {\n                bpp: f[1].parse().unwrap(),\n                w: f[2].parse().unwrap(),\n                h: f[3].parse().unwrap(),\n                src: if f[4] == \"-\" { Vec::new() } else { unhex(f[4]) },\n                src_off: f[5].parse().unwrap(),\n                dst_off: f[6].parse().unwrap(),\n                null_src: f[7] == \"1\",\n                null_dst: f[8] == \"1\",\n                seed: f[9].parse().unwrap(),\n                arena: f[10].parse().unwrap(),\n            },\n            other => panic!(\"bad spec kind {other:?}\"),\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Outcome\n// ---------------------------------------------------------------------------\n\n#[derive(Clone, PartialEq, Eq)]\npub enum Outcome {\n    /// The call returned. `err` is the `cp_error_reason` string, hashes cover\n    /// the whole arenas.\n    Returned {\n        ret: c_int,\n        err: Option<Vec<u8>>,\n        out_hash: u64,\n        in_hash: u64,\n    },\n    /// The process died from a signal (6 = SIGABRT, 11 = SIGSEGV, ...).\n    Signal(i32),\n    /// The process exited with a non-zero code without a result line.\n    ExitCode(i32),\n}\n\nimpl std::fmt::Debug for Outcome {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        match self {\n            Outcome::Returned {\n                ret,\n                err,\n                out_hash,\n                in_hash,\n            } => write!(\n                f,\n                \"Returned {{ ret: {ret}, err: {:?}, out: {out_hash:#018x}, in: {in_hash:#018x} }}\",\n                err.as_ref().map(|e| String::from_utf8_lossy(e).into_owned())\n            ),\n            Outcome::Signal(s) => write!(\n                f,\n                \"Signal({s}{})\",\n                match s {\n                    6 => \" SIGABRT\",\n                    11 => \" SIGSEGV\",\n                    8 => \" SIGFPE\",\n                    4 => \" SIGILL\",\n                    _ => \"\",\n                }\n            ),\n            Outcome::ExitCode(c) => write!(f, \"ExitCode({c})\"),\n        }\n    }\n}\n\nimpl Outcome {\n    fn encode(&self, idx: usize) -> String {\n        match self {\n            Outcome::Returned {\n                ret,\n                err,\n                out_hash,\n                in_hash,\n            } => format!(\n                \"{idx} {ret} {} {out_hash:016x} {in_hash:016x}\\n\",\n                match err {\n                    None => \"-\".to_string(),\n                    Some(e) => hex(e),\n                }\n            ),\n            _ => unreachable!(\"only Returned is ever written by the child\"),\n        }\n    }\n\n    fn decode(line: &str) -> (usize, Outcome) {\n        let f: Vec<&str> = line.split_whitespace().collect();\n        let idx: usize = f[0].parse().unwrap();\n        let ret: c_int = f[1].parse().unwrap();\n        let err = if f[2] == \"-\" { None } else { Some(unhex(f[2])) };\n        let out_hash = u64::from_str_radix(f[3], 16).unwrap();\n        let in_hash = u64::from_str_radix(f[4], 16).unwrap();\n        (\n            idx,\n            Outcome::Returned {\n                ret,\n                err,\n                out_hash,\n                in_hash,\n            },\n        )\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Executing one spec (used by the child, and also directly in-process)\n// ---------------------------------------------------------------------------\n\npub fn exec_spec(im: &Impl, spec: &Spec) -> Outcome {\n    match spec {\n        Spec::Inflate {\n            input,\n            in_off,\n            in_bytes,\n            out_bytes,\n            out_off,\n            null_in,\n            null_out,\n            seed,\n            arena,\n        } => {\n            let mut ina = Arena::filled(*arena, seed ^ 0xA1);\n            let outa = Arena::filled(*arena, seed ^ 0xB2);\n            ina.write_at(*in_off, input);\n            let ip = if *null_in {\n                std::ptr::null_mut()\n            } else {\n                ina.at(*in_off) as *mut c_void\n            };\n            let op = if *null_out {\n                std::ptr::null_mut()\n            } else {\n                outa.at(*out_off) as *mut c_void\n            };\n            let _g = super::lock_globals();\n            im.clear_error_reason();\n            let f = im.inflate();\n            let ret = unsafe { f(ip, *in_bytes, op, *out_bytes) };\n            let err = im.error_reason();\n            drop(_g);\n            Outcome::Returned {\n                ret,\n                err,\n                out_hash: fnv1a(outa.as_slice()),\n                in_hash: fnv1a(ina.as_slice()),\n            }\n        }\n        Spec::ConvertPix {\n            bpp,\n            w,\n            h,\n            src,\n            src_off,\n            dst_off,\n            null_src,\n            null_dst,\n            seed,\n            arena,\n        } => {\n            let mut sa = Arena::filled(*arena, seed ^ 0xC3);\n            let da = Arena::filled(*arena, seed ^ 0xD4);\n            sa.write_at(*src_off, src);\n            let sp = if *null_src {\n                std::ptr::null_mut()\n            } else {\n                sa.at(*src_off)\n            };\n            let dp = if *null_dst {\n                std::ptr::null_mut()\n            } else {\n                da.at(*dst_off)\n            };\n            let f = im.convert_pix();\n            unsafe { f(*bpp, *w, *h, sp, dp) };\n            Outcome::Returned {\n                ret: 0,\n                err: None,\n                out_hash: fnv1a(da.as_slice()),\n                in_hash: fnv1a(sa.as_slice()),\n            }\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// Child entry point\n// ---------------------------------------------------------------------------\n\n/// Call this from a `#[test]` function whose name is passed to\n/// [`run_batch`].  It is a no-op unless the `CP_CHILD_*` environment is set.\npub fn child_entry() {\n    let so = match std::env::var(ENV_SO) {\n        Ok(v) => v,\n        Err(_) => return, // normal test run: nothing to do\n    };\n    let specs_path = std::env::var(ENV_SPECS).expect(ENV_SPECS);\n    let out_path = std::env::var(ENV_OUT).expect(ENV_OUT);\n    let start: usize = std::env::var(ENV_START).expect(ENV_START).parse().unwrap();\n\n    let im = Impl::load(\"child\", &PathBuf::from(&so));\n    let specs = std::fs::read_to_string(&specs_path).expect(\"read specs\");\n    let mut out = std::fs::OpenOptions::new()\n        .create(true)\n        .append(true)\n        .open(&out_path)\n        .expect(\"open out\");\n\n    for (i, line) in specs.lines().enumerate() {\n        if i < start || line.trim().is_empty() {\n            continue;\n        }\n        let spec = Spec::decode(line);\n        let outcome = exec_spec(&im, &spec);\n        out.write_all(outcome.encode(i).as_bytes()).expect(\"write\");\n        out.flush().expect(\"flush\");\n        // Make sure the record survives an abort in the *next* iteration.\n        let _ = out.sync_data();\n    }\n    // Bypass the libtest harness's own exit path.\n    std::process::exit(0);\n}\n\n// ---------------------------------------------------------------------------\n// Parent driver\n// ---------------------------------------------------------------------------\n\nfn child_test_name() -> String {\n    std::env::var(\"CP_CHILD_TEST\").unwrap_or_else(|_| \"child_entry\".to_string())\n}\n\n/// Run every spec against `so`, restarting the child after each fatal signal.\n/// `child_test` is the name of the `#[test]` fn that calls [`child_entry`].\npub fn run_batch(so: &Path, specs: &[Spec], child_test: &str) -> Vec<Outcome> {\n    let dir = std::env::temp_dir().join(format!(\n        \"cp_diff_{}_{}\",\n        std::process::id(),\n        fnv1a(so.to_string_lossy().as_bytes())\n    ));\n    std::fs::create_dir_all(&dir).expect(\"mkdir\");\n    let specs_path = dir.join(\"specs.txt\");\n    let out_path = dir.join(\"out.txt\");\n    let _ = std::fs::remove_file(&out_path);\n\n    let mut sf = String::new();\n    for s in specs {\n        sf.push_str(&s.encode());\n        sf.push('\\n');\n    }\n    std::fs::write(&specs_path, &sf).expect(\"write specs\");\n\n    let exe = std::env::current_exe().expect(\"current_exe\");\n    let mut outcomes: Vec<Option<Outcome>> = vec![None; specs.len()];\n    let mut start = 0usize;\n\n    while start < specs.len() {\n        let status = Command::new(&exe)\n            .args([child_test, \"--exact\", \"--nocapture\", \"--test-threads=1\"])\n            .env(ENV_SO, so)\n            .env(ENV_SPECS, &specs_path)\n            .env(ENV_OUT, &out_path)\n            .env(ENV_START, start.to_string())\n            .env(\"CP_CHILD_TEST\", child_test)\n            .env(\"RUST_BACKTRACE\", \"0\")\n            .stdout(std::process::Stdio::null())\n            .stderr(std::process::Stdio::null())\n            .status()\n            .expect(\"spawn child\");\n\n        // Absorb everything the child managed to write.\n        let text = std::fs::read_to_string(&out_path).unwrap_or_default();\n        let mut highest: Option<usize> = None;\n        for line in text.lines() {\n            if line.trim().is_empty() {\n                continue;\n            }\n            let (i, o) = Outcome::decode(line);\n            outcomes[i] = Some(o);\n            highest = Some(highest.map_or(i, |h: usize| h.max(i)));\n        }\n\n        let next = match highest {\n            Some(h) => h + 1,\n            None => start,\n        };\n\n        if status.success() && next >= specs.len() {\n            break;\n        }\n        if status.success() {\n            // Child exited cleanly but did not finish the batch: shouldn't\n            // happen, but avoid an infinite loop.\n            if next <= start {\n                panic!(\"child made no progress at index {start}\");\n            }\n            start = next;\n            continue;\n        }\n\n        // Died. `next` is the first index with no record: that is the culprit.\n        let victim = next;\n        assert!(\n            victim < specs.len(),\n            \"child failed (status {status:?}) but all specs have results\"\n        );\n        let sig = signal_of(&status);\n        outcomes[victim] = Some(match sig {\n            Some(s) => Outcome::Signal(s),\n            None => Outcome::ExitCode(status.code().unwrap_or(-1)),\n        });\n        start = victim + 1;\n    }\n\n    outcomes\n        .into_iter()\n        .enumerate()\n        .map(|(i, o)| o.unwrap_or_else(|| panic!(\"no outcome recorded for spec {i}\")))\n        .collect()\n}\n\nfn signal_of(status: &std::process::ExitStatus) -> Option<i32> {\n    #[cfg(unix)]\n    {\n        use std::os::unix::process::ExitStatusExt;\n        status.signal()\n    }\n    #[cfg(not(unix))]\n    {\n        let _ = status;\n        None\n    }\n}\n\n/// Run `specs` against both `.so`s in subprocesses and assert every outcome\n/// matches.  Returns the (identical) outcome list.\n#[track_caller]\npub fn assert_batch_eq(specs: &[Spec], child_test: &str, label: &str) -> Vec<Outcome> {\n    let c = run_batch(&super::c_so_path(), specs, child_test);\n    let r = run_batch(&super::rust_so_path(), specs, child_test);\n    assert_eq!(c.len(), specs.len());\n    assert_eq!(r.len(), specs.len());\n    let mut bad = 0usize;\n    for i in 0..specs.len() {\n        if c[i] != r[i] {\n            if bad < 10 {\n                eprintln!(\n                    \"[{label}] MISMATCH spec #{i}\\n  spec = {}\\n  C    = {:?}\\n  Rust = {:?}\",\n                    specs[i].encode(),\n                    c[i],\n                    r[i]\n                );\n            }\n            bad += 1;\n        }\n    }\n    assert_eq!(bad, 0, \"[{label}] {bad}/{} specs diverged\", specs.len());\n    c\n}\n\npub fn child_name_env() -> String {\n    child_test_name()\n}\n","structuredPatch":[{"oldStart":341,"oldLines":6,"newStart":341,"newLines":16,"lines":["         Ok(v) => v,","         Err(_) => return, // normal test run: nothing to do","     };","+    // Many of these cases die from SIGABRT/SIGSEGV.  Without this, every death","+    // would hand a core to systemd-coredump, which makes the suite ~100x","+    // slower (and litters the journal).","+    unsafe {","+        let rl = libc::rlimit {","+            rlim_cur: 0,","+            rlim_max: 0,","+        };","+        libc::setrlimit(libc::RLIMIT_CORE, &rl);","+    }","     let specs_path = std::env::var(ENV_SPECS).expect(ENV_SPECS);","     let out_path = std::env::var(ENV_OUT).expect(ENV_OUT);","     let start: usize = std::env::var(ENV_START).expect(ENV_START).parse().unwrap();"]}],"userModified":false,"replaceAll":false}}
{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_ay5s5vafhuzanxjxnbcrszotqrjimlzhxe7w5stmei5k42ksreha","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01U9efDg5WMfFnP7JcnCnC4m","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-AesDK8/translated_rust/tests/errors.rs","content":"//! Phase C — ERRORS.md rows E1..E6 and G3..G7, G9.\n//!\n//! Every row here is a rejection the C reports by RETURNING 0 and setting the\n//! global `cp_error_reason`.  Both `.so`s are driven through `cp_inflate` and\n//! must return the same value AND point `cp_error_reason` at byte-identical\n//! text (not merely \"both failed\").\n\nmod common;\n\nuse common::deflate::*;\nuse common::*;\nuse std::os::raw::c_int;\n\n// The exact C string literals (lib.c:171, 180, 255, 274, 283, 357).\nconst ERR_LEN_NLEN: &[u8] =\n    b\"Failed to find LEN and NLEN as complements within stored (uncompressed) stream.\";\nconst ERR_STORED_BEYOND: &[u8] = b\"Stored block extends beyond end of input stream.\";\nconst ERR_OUT_SYMBOL: &[u8] = b\"Attempted to overwrite out buffer while outputting a symbol.\";\nconst ERR_BEFORE_OUT: &[u8] = b\"Attempted to write before out buffer (invalid backwards distance).\";\nconst ERR_OUT_STRING: &[u8] = b\"Attempted to overwrite out buffer while outputting a string.\";\nconst ERR_UNKNOWN_BLOCK: &[u8] = b\"Detected unknown block type within input stream.\";\n\n/// Differential check + assert on the exact expected outcome, so the row\n/// actually proves the *specific* rejection was reached.\n#[track_caller]\nfn expect(\n    c: &Impl,\n    r: &Impl,\n    case: &InflateCase,\n    want_ret: c_int,\n    want_err: Option<&[u8]>,\n    label: &str,\n) {\n    assert_inflate_eq_arena(c, r, case, label, 64 * 1024);\n    let rc = run_inflate(c, case, 64 * 1024);\n    assert_eq!(rc.ret, want_ret, \"[{label}] C ret: {rc:?}\");\n    assert_eq!(\n        rc.err.as_deref(),\n        want_err,\n        \"[{label}] C cp_error_reason: {:?}\",\n        rc.err.as_ref().map(|e| String::from_utf8_lossy(e).into_owned())\n    );\n    let rr = run_inflate(r, case, 64 * 1024);\n    assert_eq!(rr.ret, want_ret, \"[{label}] Rust ret: {rr:?}\");\n    assert_eq!(\n        rr.err.as_deref(),\n        want_err,\n        \"[{label}] Rust cp_error_reason: {:?}\",\n        rr.err.as_ref().map(|e| String::from_utf8_lossy(e).into_owned())\n    );\n}\n\n// ---------------------------------------------------------------------------\n// E1 — LEN and NLEN are not complements\n// ---------------------------------------------------------------------------\n\n#[test]\nfn e1_stored_len_nlen_mismatch() {\n    let (c, r) = load_both();\n    let mut rng = SplitMix::new(0xE101);\n    let mut cases = 0usize;\n    for len in [0u16, 1, 2, 3, 4, 7, 8, 16, 100, 1000] {\n        // Every wrong NLEN we can think of, plus random ones.\n        let mut nlens: Vec<u16> = vec![0, 0xFFFF, len, !len ^ 1, !len ^ 0x8000, len.wrapping_add(1)];\n        for _ in 0..4 {\n            nlens.push(rng.next_u32() as u16);\n        }\n        for nlen in nlens {\n            if nlen == !len {\n                continue; // that one is valid\n            }\n            let payload = rng.bytes(len as usize);\n            let mut w = BitWriter::new();\n            stored_block(&mut w, true, len, nlen, &payload);\n            let stream = w.finish();\n            for off in 0..4usize {\n                let case = InflateCase::new(stream.clone(), len as c_int + 64).in_off(off);\n                expect(\n                    &c,\n                    &r,\n                    &case,\n                    0,\n                    Some(ERR_LEN_NLEN),\n                    &format!(\"E1 len={len} nlen={nlen:#06x} off={off}\"),\n                );\n                cases += 1;\n            }\n        }\n    }\n    assert!(cases > 100, \"only {cases} E1 cases\");\n}\n\n// ---------------------------------------------------------------------------\n// E2 — the stored block claims fewer bytes than the input still holds\n// ---------------------------------------------------------------------------\n\n#[test]\nfn e2_stored_block_extends_beyond() {\n    let (c, r) = load_both();\n    let mut rng = SplitMix::new(0xE202);\n    for len in [0usize, 1, 2, 3, 4, 8, 17, 64, 255, 1000] {\n        for extra in [1usize, 2, 3, 4, 5, 8, 33] {\n            let payload = rng.bytes(len);\n            let mut stream = stored_ok(true, &payload);\n            stream.extend_from_slice(&rng.bytes(extra));\n            for off in 0..4usize {\n                let case = InflateCase::new(stream.clone(), len as c_int + 4096).in_off(off);\n                expect(\n                    &c,\n                    &r,\n                    &case,\n                    0,\n                    Some(ERR_STORED_BEYOND),\n                    &format!(\"E2 len={len} extra={extra} off={off}\"),\n                );\n            }\n        }\n    }\n    // The boundary: exactly `LEN` bytes of payload succeeds, one more fails.\n    for len in [4usize, 16, 100] {\n        let payload = rng.bytes(len);\n        let ok = stored_ok(true, &payload);\n        let case = InflateCase::new(ok.clone(), len as c_int);\n        expect(&c, &r, &case, 1, None, &format!(\"E2 boundary ok len={len}\"));\n        let mut bad = ok.clone();\n        bad.push(0xAA);\n        let case = InflateCase::new(bad, len as c_int + 8);\n        expect(\n            &c,\n            &r,\n            &case,\n            0,\n            Some(ERR_STORED_BEYOND),\n            &format!(\"E2 boundary +1 len={len}\"),\n        );\n    }\n}\n\n// ---------------------------------------------------------------------------\n// E3 — output buffer full while writing a literal\n// ---------------------------------------------------------------------------\n\n#[test]\nfn e3_out_overflow_symbol() {\n    let (c, r) = load_both();\n    for nlits in [1usize, 2, 3, 8, 40] {\n        let items: Vec<Item> = (0..nlits).map(|i| Item::Lit(0x30 + i as u8)).collect();\n        let stream = fixed_only(true, &items);\n        for out_bytes in 0..nlits as c_int {\n            for off in 0..4usize {\n                let case = InflateCase::new(stream.clone(), out_bytes).in_off(off);\n                expect(\n                    &c,\n                    &r,\n                    &case,\n                    0,\n                    Some(ERR_OUT_SYMBOL),\n                    &format!(\"E3 nlits={nlits} out={out_bytes} off={off}\"),\n                );\n            }\n        }\n        // Exactly enough must succeed.\n        let case = InflateCase::new(stream, nlits as c_int);\n        expect(&c, &r, &case, 1, None, &format!(\"E3 exact nlits={nlits}\"));\n    }\n    // Also in a dynamic block.\n    let lens = lens_for(257, 1, &[b'q' as usize, 256], &[0]);\n    let d = dynamic_from_lens(257, 1, &lens);\n    let items: Vec<Item> = (0..6).map(|_| Item::Lit(b'q')).collect();\n    let stream = d.only(true, &items);\n    for out_bytes in 0..6 {\n        let case = InflateCase::new(stream.clone(), out_bytes);\n        expect(\n            &c,\n            &r,\n            &case,\n            0,\n            Some(ERR_OUT_SYMBOL),\n            &format!(\"E3 dynamic out={out_bytes}\"),\n        );\n    }\n}\n\n// ---------------------------------------------------------------------------\n// E4 — back-reference before the start of the output buffer\n// ---------------------------------------------------------------------------\n\n#[test]\nfn e4_invalid_backwards_distance() {\n    let (c, r) = load_both();\n    // A match as the very first item: `out - distance < begin` for any\n    // distance >= 1.\n    for dist in [1u32, 2, 3, 5, 17, 256, 32768] {\n        let (dist_sym, dist_extra) = dist_code(dist);\n        for len_sym in [257usize, 260, 285] {\n            let nextra = LEN_EXTRA[len_sym - 257] as u32;\n            let items = vec![Item::Match {\n                len_sym,\n                len_extra: (1u32 << nextra) - 1,\n                dist_sym,\n                dist_extra,\n            }];\n            let stream = fixed_only(true, &items);\n            for off in 0..4usize {\n                let case = InflateCase::new(stream.clone(), 4096).in_off(off);\n                expect(\n                    &c,\n                    &r,\n                    &case,\n                    0,\n                    Some(ERR_BEFORE_OUT),\n                    &format!(\"E4 dist={dist} len_sym={len_sym} off={off}\"),\n                );\n            }\n        }\n    }\n    // `k` literals then a match at distance k+1 (one too far).\n    for k in 1usize..=8 {\n        let mut items: Vec<Item> = (0..k).map(|i| Item::Lit(0x50 + i as u8)).collect();\n        let (dist_sym, dist_extra) = dist_code(k as u32 + 1);\n        items.push(Item::Match {\n            len_sym: 257,\n            len_extra: 0,\n            dist_sym,\n            dist_extra,\n        });\n        let stream = fixed_only(true, &items);\n        let case = InflateCase::new(stream, 4096);\n        expect(\n            &c,\n            &r,\n            &case,\n            0,\n            Some(ERR_BEFORE_OUT),\n            &format!(\"E4 k={k} dist={}\", k + 1),\n        );\n        // ... and distance k is fine.\n        let mut ok: Vec<Item> = (0..k).map(|i| Item::Lit(0x50 + i as u8)).collect();\n        let (ds, de) = dist_code(k as u32);\n        ok.push(Item::Match {\n            len_sym: 257,\n            len_extra: 0,\n            dist_sym: ds,\n            dist_extra: de,\n        });\n        let stream = fixed_only(true, &ok);\n        let case = InflateCase::new(stream, 4096);\n        expect(&c, &r, &case, 1, None, &format!(\"E4 k={k} dist={k} ok\"));\n    }\n    // The distance-0 case (dist symbols 30/31) must NOT trigger E4:\n    // `out - 0 >= begin` holds even at the very start of the buffer.\n    let items = vec![Item::Match {\n        len_sym: 257,\n        len_extra: 0,\n        dist_sym: 30,\n        dist_extra: 0,\n    }];\n    let stream = fixed_only(true, &items);\n    let case = InflateCase::new(stream, 4096);\n    expect(&c, &r, &case, 1, None, \"E4 distance-0 is accepted\");\n}\n\n// ---------------------------------------------------------------------------\n// E5 — a copy that would run past the end of the output buffer\n// ---------------------------------------------------------------------------\n\n#[test]\nfn e5_out_overflow_string() {\n    let (c, r) = load_both();\n    for len in [3u32, 4, 10, 100, 258] {\n        let (len_sym, len_extra) = len_code(len);\n        for prefix in 1usize..=4 {\n            let mut items: Vec<Item> = (0..prefix).map(|i| Item::Lit(0x70 + i as u8)).collect();\n            items.push(Item::Match {\n                len_sym,\n                len_extra,\n                dist_sym: 0, // distance 1: the `memset` path\n                dist_extra: 0,\n            });\n            let total = prefix as c_int + len as c_int;\n            let stream = fixed_only(true, &items);\n            // Every out_bytes from `prefix` (all literals fit, the copy does\n            // not) up to total-1 must give E5.\n            for out_bytes in prefix as c_int..total {\n                for off in 0..4usize {\n                    let case = InflateCase::new(stream.clone(), out_bytes).in_off(off);\n                    expect(\n                        &c,\n                        &r,\n                        &case,\n                        0,\n                        Some(ERR_OUT_STRING),\n                        &format!(\"E5 len={len} prefix={prefix} out={out_bytes} off={off}\"),\n                    );\n                }\n            }\n            // Exactly `total` succeeds.\n            let case = InflateCase::new(stream.clone(), total);\n            expect(&c, &r, &case, 1, None, &format!(\"E5 exact len={len}\"));\n        }\n    }\n    // Same for the non-memset (distance > 1) copy path.\n    for dist in [2u32, 3, 8] {\n        let (dist_sym, dist_extra) = dist_code(dist);\n        let mut items: Vec<Item> = (0..dist as u8).map(|i| Item::Lit(0x90 + i)).collect();\n        items.push(Item::Match {\n            len_sym: 285, // length 258\n            len_extra: 0,\n            dist_sym,\n            dist_extra,\n        });\n        let stream = fixed_only(true, &items);\n        for out_bytes in dist as c_int..(dist as c_int + 258) {\n            let case = InflateCase::new(stream.clone(), out_bytes);\n            expect(\n                &c,\n                &r,\n                &case,\n                0,\n                Some(ERR_OUT_STRING),\n                &format!(\"E5 copy dist={dist} out={out_bytes}\"),\n            );\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// E6 — reserved block type 3\n// ---------------------------------------------------------------------------\n\n#[test]\nfn e6_unknown_block_type() {\n    let (c, r) = load_both();\n    let mut rng = SplitMix::new(0xE606);\n    for bfinal in [0u32, 1] {\n        for in_bytes in [2i32, 3, 4, 5, 8, 16] {\n            let mut w = BitWriter::new();\n            w.bits(bfinal, 1);\n            w.bits(3, 2); // BTYPE = 3 (reserved)\n            let mut stream = w.finish();\n            while stream.len() < in_bytes as usize {\n                stream.push(rng.next_u32() as u8);\n            }\n            stream.truncate(in_bytes as usize);\n            for off in 0..4usize {\n                let case = InflateCase::new(stream.clone(), 4096).in_off(off);\n                expect(\n                    &c,\n                    &r,\n                    &case,\n                    0,\n                    Some(ERR_UNKNOWN_BLOCK),\n                    &format!(\"E6 bfinal={bfinal} in_bytes={in_bytes} off={off}\"),\n                );\n            }\n        }\n    }\n    // BTYPE = 3 as the *second* block of a stream.\n    let items = vec![Item::Lit(b'A'), Item::Lit(b'B')];\n    let mut w = BitWriter::new();\n    fixed_block(&mut w, false, &items);\n    w.bits(1, 1);\n    w.bits(3, 2);\n    let mut stream = w.finish();\n    stream.extend_from_slice(&[0u8; 8]);\n    let case = InflateCase::new(stream, 4096);\n    expect(&c, &r, &case, 0, Some(ERR_UNKNOWN_BLOCK), \"E6 second block\");\n}\n\n// ---------------------------------------------------------------------------\n// G3, G4, G5, G6, G7 — out-pointer / out_bytes boundaries\n// ---------------------------------------------------------------------------\n\n/// G3 — `out == NULL` with `out_bytes == 0`: `out + 1 <= out_end` is false, so\n/// E3 fires *before* anything is dereferenced.\n#[test]\nfn g3_null_out_zero_bytes() {\n    let (c, r) = load_both();\n    let stream = fixed_only(true, &[Item::Lit(b'Z')]);\n    for off in 0..4usize {\n        let case = InflateCase::new(stream.clone(), 0).in_off(off).null_out();\n        expect(\n            &c,\n            &r,\n            &case,\n            0,\n            Some(ERR_OUT_SYMBOL),\n            &format!(\"G3 off={off}\"),\n        );\n    }\n    // An *empty* block writes nothing at all, so NULL/0 succeeds.\n    let empty = fixed_only(true, &[]);\n    let case = InflateCase::new(empty, 0).null_out();\n    expect(&c, &r, &case, 1, None, \"G3 empty block, NULL out\");\n}\n\n/// G4 — `out_bytes == 0` with a valid pointer.\n#[test]\nfn g4_out_bytes_zero() {\n    let (c, r) = load_both();\n    for stream in [\n        fixed_only(true, &[Item::Lit(1)]),\n        fixed_only(true, &[Item::Lit(1), Item::Lit(2)]),\n    ] {\n        for off in 0..4usize {\n            let case = InflateCase::new(stream.clone(), 0).in_off(off);\n            expect(\n                &c,\n                &r,\n                &case,\n                0,\n                Some(ERR_OUT_SYMBOL),\n                &format!(\"G4 off={off}\"),\n            );\n        }\n    }\n}\n\n/// G5 — negative `out_bytes` (so `out_end < out`).\n#[test]\nfn g5_out_bytes_negative() {\n    let (c, r) = load_both();\n    let stream = fixed_only(true, &[Item::Lit(7), Item::Lit(8)]);\n    for out_bytes in [-1i32, -2, -100, -65536, c_int::MIN, c_int::MIN + 1] {\n        for off in 0..4usize {\n            let case = InflateCase::new(stream.clone(), out_bytes)\n                .in_off(off)\n                .out_off(32 * 1024);\n            expect(\n                &c,\n                &r,\n                &case,\n                0,\n                Some(ERR_OUT_SYMBOL),\n                &format!(\"G5 out_bytes={out_bytes} off={off}\"),\n            );\n        }\n    }\n}\n\n/// G6 — `out_bytes` exactly one byte short of the true output size.\n#[test]\nfn g6_out_bytes_one_short() {\n    let (c, r) = load_both();\n    // Literal-only: the last literal trips E3.\n    for n in 1usize..=20 {\n        let items: Vec<Item> = (0..n).map(|i| Item::Lit(i as u8)).collect();\n        let stream = fixed_only(true, &items);\n        let case = InflateCase::new(stream.clone(), n as c_int - 1);\n        expect(\n            &c,\n            &r,\n            &case,\n            0,\n            Some(ERR_OUT_SYMBOL),\n            &format!(\"G6 lits n={n}\"),\n        );\n        let case = InflateCase::new(stream, n as c_int);\n        expect(&c, &r, &case, 1, None, &format!(\"G6 lits n={n} exact\"));\n    }\n    // Ending in a copy: the copy trips E5 instead.\n    for len in [3u32, 9, 258] {\n        let (len_sym, len_extra) = len_code(len);\n        let items = vec![\n            Item::Lit(0xAB),\n            Item::Match {\n                len_sym,\n                len_extra,\n                dist_sym: 0,\n                dist_extra: 0,\n            },\n        ];\n        let total = 1 + len as c_int;\n        let stream = fixed_only(true, &items);\n        let case = InflateCase::new(stream.clone(), total - 1);\n        expect(\n            &c,\n            &r,\n            &case,\n            0,\n            Some(ERR_OUT_STRING),\n            &format!(\"G6 copy len={len}\"),\n        );\n        let case = InflateCase::new(stream, total);\n        expect(&c, &r, &case, 1, None, &format!(\"G6 copy len={len} exact\"));\n    }\n    // flate2 streams, one byte short.\n    use flate2::write::DeflateEncoder;\n    use flate2::Compression;\n    use std::io::Write;\n    let mut rng = SplitMix::new(0x6606);\n    for n in [4usize, 10, 100, 1000] {\n        let data: Vec<u8> = (0..n).map(|_| b'a' + rng.below(4) as u8).collect();\n        for level in [1u32, 6, 9] {\n            let mut e = DeflateEncoder::new(Vec::new(), Compression::new(level));\n            e.write_all(&data).unwrap();\n            let stream = e.finish().unwrap();\n            let case = InflateCase::new(stream.clone(), n as c_int - 1);\n            assert_inflate_eq_arena(&c, &r, &case, &format!(\"G6 flate2 n={n}\"), 64 * 1024);\n            let rc = run_inflate(&c, &case, 64 * 1024);\n            assert_eq!(rc.ret, 0, \"G6 flate2 n={n} lvl={level}: expected failure\");\n            assert!(\n                rc.err.as_deref() == Some(ERR_OUT_SYMBOL)\n                    || rc.err.as_deref() == Some(ERR_OUT_STRING),\n                \"G6 flate2 n={n}: unexpected reason {:?}\",\n                rc.err.as_ref().map(|e| String::from_utf8_lossy(e).into_owned())\n            );\n        }\n    }\n}\n\n/// G7 — `out_bytes == INT_MAX` (and other huge values) must still succeed.\n#[test]\nfn g7_out_bytes_int_max() {\n    let (c, r) = load_both();\n    let mut rng = SplitMix::new(0x7707);\n    for out_bytes in [c_int::MAX, c_int::MAX - 1, 1 << 30, 1 << 24] {\n        // literals\n        let items: Vec<Item> = rng.bytes(32).into_iter().map(Item::Lit).collect();\n        let stream = fixed_only(true, &items);\n        for off in 0..4usize {\n            let case = InflateCase::new(stream.clone(), out_bytes).in_off(off);\n            expect(&c, &r, &case, 1, None, &format!(\"G7 out={out_bytes} off={off}\"));\n        }\n        // a stored block\n        let payload = rng.bytes(64);\n        let stream = stored_ok(true, &payload);\n        let case = InflateCase::new(stream, out_bytes);\n        expect(&c, &r, &case, 1, None, &format!(\"G7 stored out={out_bytes}\"));\n    }\n}\n\n// ---------------------------------------------------------------------------\n// G9 — trailing garbage after the real stream\n// ---------------------------------------------------------------------------\n\n#[test]\nfn g9_trailing_garbage() {\n    let (c, r) = load_both();\n    let mut rng = SplitMix::new(0x9909);\n\n    // Compressed blocks: the extra bytes are never read, so the call succeeds.\n    for n in [1usize, 5, 40] {\n        let items: Vec<Item> = rng.bytes(n).into_iter().map(Item::Lit).collect();\n        let base = fixed_only(true, &items);\n        for extra in [1usize, 2, 3, 4, 7, 16, 64] {\n            let mut stream = base.clone();\n            stream.extend_from_slice(&rng.bytes(extra));\n            for off in 0..4usize {\n                let case = InflateCase::new(stream.clone(), n as c_int).in_off(off);\n                // Both must agree; the C's own result is whatever it is.\n                assert_inflate_eq_arena(\n                    &c,\n                    &r,\n                    &case,\n                    &format!(\"G9 fixed n={n} extra={extra} off={off}\"),\n                    64 * 1024,\n                );\n            }\n        }\n    }\n\n    // Stored blocks: extra input makes `bits_left/8 > LEN` -> E2.\n    for n in [0usize, 1, 8, 100] {\n        let payload = rng.bytes(n);\n        let base = stored_ok(true, &payload);\n        for extra in [1usize, 4, 16] {\n            let mut stream = base.clone();\n            stream.extend_from_slice(&rng.bytes(extra));\n            let case = InflateCase::new(stream, n as c_int + 1024);\n            expect(\n                &c,\n                &r,\n                &case,\n                0,\n                Some(ERR_STORED_BEYOND),\n                &format!(\"G9 stored n={n} extra={extra}\"),\n            );\n        }\n    }\n\n    // `in_bytes` larger than the buffer content (the arena filler becomes the\n    // trailing garbage — identical in both implementations).\n    for n in [1usize, 5, 40] {\n        let items: Vec<Item> = rng.bytes(n).into_iter().map(Item::Lit).collect();\n        let stream = fixed_only(true, &items);\n        for grow in [1i32, 2, 3, 4, 9, 64] {\n            let case = InflateCase::new(stream.clone(), n as c_int)\n                .in_bytes(stream.len() as c_int + grow);\n            assert_inflate_eq_arena(\n                &c,\n                &r,\n                &case,\n                &format!(\"G9 in_bytes+{grow} n={n}\"),\n                64 * 1024,\n            );\n        }\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2769,"cache_read_input_tokens":278212,"cache_creation":{"ephemeral_5m_input_tokens":2769,"ephemeral_1h_input_tokens":0},"output_tokens":17,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"1f391add-adf5-472a-b38e-02e2e663f9ae","uuid":"09fea48d-98ff-4a96-ab06-4ba3c290c18d","timestamp":"2026-08-20T09:09:06.313Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01U9efDg5WMfFnP7JcnCnC4m","type":"tool_result","content":"File created successfully at: /local/home/scheschb/.harvest/work/harvest-work-AesDK8/translated_rust/tests/errors.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"1f391add-adf5-472a-b38e-02e2e663f9ae","uuid":"3fba6c39-f956-4723-a958-c1d127ff1b8c","timestamp":"2026-08-20T09:09:06.324Z","tool_use_result":{"type":"create","filePath":"/local/home/scheschb/.harvest/work/harvest-work-AesDK8/translated_rust/tests/errors.rs","content":"//! Phase C — ERRORS.md rows E1..E6 and G3..G7, G9.\n//!\n//! Every row here is a rejection the C reports by RETURNING 0 and setting the\n//! global `cp_error_reason`.  Both `.so`s are driven through `cp_inflate` and\n//! must return the same value AND point `cp_error_reason` at byte-identical\n//! text (not merely \"both failed\").\n\nmod common;\n\nuse common::deflate::*;\nuse common::*;\nuse std::os::raw::c_int;\n\n// The exact C string literals (lib.c:171, 180, 255, 274, 283, 357).\nconst ERR_LEN_NLEN: &[u8] =\n    b\"Failed to find LEN and NLEN as complements within stored (uncompressed) stream.\";\nconst ERR_STORED_BEYOND: &[u8] = b\"Stored block extends beyond end of input stream.\";\nconst ERR_OUT_SYMBOL: &[u8] = b\"Attempted to overwrite out buffer while outputting a symbol.\";\nconst ERR_BEFORE_OUT: &[u8] = b\"Attempted to write before out buffer (invalid backwards distance).\";\nconst ERR_OUT_STRING: &[u8] = b\"Attempted to overwrite out buffer while outputting a string.\";\nconst ERR_UNKNOWN_BLOCK: &[u8] = b\"Detected unknown block type within input stream.\";\n\n/// Differential check + assert on the exact expected outcome, so the row\n/// actually proves the *specific* rejection was reached.\n#[track_caller]\nfn expect(\n    c: &Impl,\n    r: &Impl,\n    case: &InflateCase,\n    want_ret: c_int,\n    want_err: Option<&[u8]>,\n    label: &str,\n) {\n    assert_inflate_eq_arena(c, r, case, label, 64 * 1024);\n    let rc = run_inflate(c, case, 64 * 1024);\n    assert_eq!(rc.ret, want_ret, \"[{label}] C ret: {rc:?}\");\n    assert_eq!(\n        rc.err.as_deref(),\n        want_err,\n        \"[{label}] C cp_error_reason: {:?}\",\n        rc.err.as_ref().map(|e| String::from_utf8_lossy(e).into_owned())\n    );\n    let rr = run_inflate(r, case, 64 * 1024);\n    assert_eq!(rr.ret, want_ret, \"[{label}] Rust ret: {rr:?}\");\n    assert_eq!(\n        rr.err.as_deref(),\n        want_err,\n        \"[{label}] Rust cp_error_reason: {:?}\",\n        rr.err.as_ref().map(|e| String::from_utf8_lossy(e).into_owned())\n    );\n}\n\n// ---------------------------------------------------------------------------\n// E1 — LEN and NLEN are not complements\n// ---------------------------------------------------------------------------\n\n#[test]\nfn e1_stored_len_nlen_mismatch() {\n    let (c, r) = load_both();\n    let mut rng = SplitMix::new(0xE101);\n    let mut cases = 0usize;\n    for len in [0u16, 1, 2, 3, 4, 7, 8, 16, 100, 1000] {\n        // Every wrong NLEN we can think of, plus random ones.\n        let mut nlens: Vec<u16> = vec![0, 0xFFFF, len, !len ^ 1, !len ^ 0x8000, len.wrapping_add(1)];\n        for _ in 0..4 {\n            nlens.push(rng.next_u32() as u16);\n        }\n        for nlen in nlens {\n            if nlen == !len {\n                continue; // that one is valid\n            }\n            let payload = rng.bytes(len as usize);\n            let mut w = BitWriter::new();\n            stored_block(&mut w, true, len, nlen, &payload);\n            let stream = w.finish();\n            for off in 0..4usize {\n                let case = InflateCase::new(stream.clone(), len as c_int + 64).in_off(off);\n                expect(\n                    &c,\n                    &r,\n                    &case,\n                    0,\n                    Some(ERR_LEN_NLEN),\n                    &format!(\"E1 len={len} nlen={nlen:#06x} off={off}\"),\n                );\n                cases += 1;\n            }\n        }\n    }\n    assert!(cases > 100, \"only {cases} E1 cases\");\n}\n\n// ---------------------------------------------------------------------------\n// E2 — the stored block claims fewer bytes than the input still holds\n// ---------------------------------------------------------------------------\n\n#[test]\nfn e2_stored_block_extends_beyond() {\n    let (c, r) = load_both();\n    let mut rng = SplitMix::new(0xE202);\n    for len in [0usize, 1, 2, 3, 4, 8, 17, 64, 255, 1000] {\n        for extra in [1usize, 2, 3, 4, 5, 8, 33] {\n            let payload = rng.bytes(len);\n            let mut stream = stored_ok(true, &payload);\n            stream.extend_from_slice(&rng.bytes(extra));\n            for off in 0..4usize {\n                let case = InflateCase::new(stream.clone(), len as c_int + 4096).in_off(off);\n                expect(\n                    &c,\n                    &r,\n                    &case,\n                    0,\n                    Some(ERR_STORED_BEYOND),\n                    &format!(\"E2 len={len} extra={extra} off={off}\"),\n                );\n            }\n        }\n    }\n    // The boundary: exactly `LEN` bytes of payload succeeds, one more fails.\n    for len in [4usize, 16, 100] {\n        let payload = rng.bytes(len);\n        let ok = stored_ok(true, &payload);\n        let case = InflateCase::new(ok.clone(), len as c_int);\n        expect(&c, &r, &case, 1, None, &format!(\"E2 boundary ok len={len}\"));\n        let mut bad = ok.clone();\n        bad.push(0xAA);\n        let case = InflateCase::new(bad, len as c_int + 8);\n        expect(\n            &c,\n            &r,\n            &case,\n            0,\n            Some(ERR_STORED_BEYOND),\n            &format!(\"E2 boundary +1 len={len}\"),\n        );\n    }\n}\n\n// ---------------------------------------------------------------------------\n// E3 — output buffer full while writing a literal\n// ---------------------------------------------------------------------------\n\n#[test]\nfn e3_out_overflow_symbol() {\n    let (c, r) = load_both();\n    for nlits in [1usize, 2, 3, 8, 40] {\n        let items: Vec<Item> = (0..nlits).map(|i| Item::Lit(0x30 + i as u8)).collect();\n        let stream = fixed_only(true, &items);\n        for out_bytes in 0..nlits as c_int {\n            for off in 0..4usize {\n                let case = InflateCase::new(stream.clone(), out_bytes).in_off(off);\n                expect(\n                    &c,\n                    &r,\n                    &case,\n                    0,\n                    Some(ERR_OUT_SYMBOL),\n                    &format!(\"E3 nlits={nlits} out={out_bytes} off={off}\"),\n                );\n            }\n        }\n        // Exactly enough must succeed.\n        let case = InflateCase::new(stream, nlits as c_int);\n        expect(&c, &r, &case, 1, None, &format!(\"E3 exact nlits={nlits}\"));\n    }\n    // Also in a dynamic block.\n    let lens = lens_for(257, 1, &[b'q' as usize, 256], &[0]);\n    let d = dynamic_from_lens(257, 1, &lens);\n    let items: Vec<Item> = (0..6).map(|_| Item::Lit(b'q')).collect();\n    let stream = d.only(true, &items);\n    for out_bytes in 0..6 {\n        let case = InflateCase::new(stream.clone(), out_bytes);\n        expect(\n            &c,\n            &r,\n            &case,\n            0,\n            Some(ERR_OUT_SYMBOL),\n            &format!(\"E3 dynamic out={out_bytes}\"),\n        );\n    }\n}\n\n// ---------------------------------------------------------------------------\n// E4 — back-reference before the start of the output buffer\n// ---------------------------------------------------------------------------\n\n#[test]\nfn e4_invalid_backwards_distance() {\n    let (c, r) = load_both();\n    // A match as the very first item: `out - distance < begin` for any\n    // distance >= 1.\n    for dist in [1u32, 2, 3, 5, 17, 256, 32768] {\n        let (dist_sym, dist_extra) = dist_code(dist);\n        for len_sym in [257usize, 260, 285] {\n            let nextra = LEN_EXTRA[len_sym - 257] as u32;\n            let items = vec![Item::Match {\n                len_sym,\n                len_extra: (1u32 << nextra) - 1,\n                dist_sym,\n                dist_extra,\n            }];\n            let stream = fixed_only(true, &items);\n            for off in 0..4usize {\n                let case = InflateCase::new(stream.clone(), 4096).in_off(off);\n                expect(\n                    &c,\n                    &r,\n                    &case,\n                    0,\n                    Some(ERR_BEFORE_OUT),\n                    &format!(\"E4 dist={dist} len_sym={len_sym} off={off}\"),\n                );\n            }\n        }\n    }\n    // `k` literals then a match at distance k+1 (one too far).\n    for k in 1usize..=8 {\n        let mut items: Vec<Item> = (0..k).map(|i| Item::Lit(0x50 + i as u8)).collect();\n        let (dist_sym, dist_extra) = dist_code(k as u32 + 1);\n        items.push(Item::Match {\n            len_sym: 257,\n            len_extra: 0,\n            dist_sym,\n            dist_extra,\n        });\n        let stream = fixed_only(true, &items);\n        let case = InflateCase::new(stream, 4096);\n        expect(\n            &c,\n            &r,\n            &case,\n            0,\n            Some(ERR_BEFORE_OUT),\n            &format!(\"E4 k={k} dist={}\", k + 1),\n        );\n        // ... and distance k is fine.\n        let mut ok: Vec<Item> = (0..k).map(|i| Item::Lit(0x50 + i as u8)).collect();\n        let (ds, de) = dist_code(k as u32);\n        ok.push(Item::Match {\n            len_sym: 257,\n            len_extra: 0,\n            dist_sym: ds,\n            dist_extra: de,\n        });\n        let stream = fixed_only(true, &ok);\n        let case = InflateCase::new(stream, 4096);\n        expect(&c, &r, &case, 1, None, &format!(\"E4 k={k} dist={k} ok\"));\n    }\n    // The distance-0 case (dist symbols 30/31) must NOT trigger E4:\n    // `out - 0 >= begin` holds even at the very start of the buffer.\n    let items = vec![Item::Match {\n        len_sym: 257,\n        len_extra: 0,\n        dist_sym: 30,\n        dist_extra: 0,\n    }];\n    let stream = fixed_only(true, &items);\n    let case = InflateCase::new(stream, 4096);\n    expect(&c, &r, &case, 1, None, \"E4 distance-0 is accepted\");\n}\n\n// ---------------------------------------------------------------------------\n// E5 — a copy that would run past the end of the output buffer\n// ---------------------------------------------------------------------------\n\n#[test]\nfn e5_out_overflow_string() {\n    let (c, r) = load_both();\n    for len in [3u32, 4, 10, 100, 258] {\n        let (len_sym, len_extra) = len_code(len);\n        for prefix in 1usize..=4 {\n            let mut items: Vec<Item> = (0..prefix).map(|i| Item::Lit(0x70 + i as u8)).collect();\n            items.push(Item::Match {\n                len_sym,\n                len_extra,\n                dist_sym: 0, // distance 1: the `memset` path\n                dist_extra: 0,\n            });\n            let total = prefix as c_int + len as c_int;\n            let stream = fixed_only(true, &items);\n            // Every out_bytes from `prefix` (all literals fit, the copy does\n            // not) up to total-1 must give E5.\n            for out_bytes in prefix as c_int..total {\n                for off in 0..4usize {\n                    let case = InflateCase::new(stream.clone(), out_bytes).in_off(off);\n                    expect(\n                        &c,\n                        &r,\n                        &case,\n                        0,\n                        Some(ERR_OUT_STRING),\n                        &format!(\"E5 len={len} prefix={prefix} out={out_bytes} off={off}\"),\n                    );\n                }\n            }\n            // Exactly `total` succeeds.\n            let case = InflateCase::new(stream.clone(), total);\n            expect(&c, &r, &case, 1, None, &format!(\"E5 exact len={len}\"));\n        }\n    }\n    // Same for the non-memset (distance > 1) copy path.\n    for dist in [2u32, 3, 8] {\n        let (dist_sym, dist_extra) = dist_code(dist);\n        let mut items: Vec<Item> = (0..dist as u8).map(|i| Item::Lit(0x90 + i)).collect();\n        items.push(Item::Match {\n            len_sym: 285, // length 258\n            len_extra: 0,\n            dist_sym,\n            dist_extra,\n        });\n        let stream = fixed_only(true, &items);\n        for out_bytes in dist as c_int..(dist as c_int + 258) {\n            let case = InflateCase::new(stream.clone(), out_bytes);\n            expect(\n                &c,\n                &r,\n                &case,\n                0,\n                Some(ERR_OUT_STRING),\n                &format!(\"E5 copy dist={dist} out={out_bytes}\"),\n            );\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// E6 — reserved block type 3\n// ---------------------------------------------------------------------------\n\n#[test]\nfn e6_unknown_block_type() {\n    let (c, r) = load_both();\n    let mut rng = SplitMix::new(0xE606);\n    for bfinal in [0u32, 1] {\n        for in_bytes in [2i32, 3, 4, 5, 8, 16] {\n            let mut w = BitWriter::new();\n            w.bits(bfinal, 1);\n            w.bits(3, 2); // BTYPE = 3 (reserved)\n            let mut stream = w.finish();\n            while stream.len() < in_bytes as usize {\n                stream.push(rng.next_u32() as u8);\n            }\n            stream.truncate(in_bytes as usize);\n            for off in 0..4usize {\n                let case = InflateCase::new(stream.clone(), 4096).in_off(off);\n                expect(\n                    &c,\n                    &r,\n                    &case,\n                    0,\n                    Some(ERR_UNKNOWN_BLOCK),\n                    &format!(\"E6 bfinal={bfinal} in_bytes={in_bytes} off={off}\"),\n                );\n            }\n        }\n    }\n    // BTYPE = 3 as the *second* block of a stream.\n    let items = vec![Item::Lit(b'A'), Item::Lit(b'B')];\n    let mut w = BitWriter::new();\n    fixed_block(&mut w, false, &items);\n    w.bits(1, 1);\n    w.bits(3, 2);\n    let mut stream = w.finish();\n    stream.extend_from_slice(&[0u8; 8]);\n    let case = InflateCase::new(stream, 4096);\n    expect(&c, &r, &case, 0, Some(ERR_UNKNOWN_BLOCK), \"E6 second block\");\n}\n\n// ---------------------------------------------------------------------------\n// G3, G4, G5, G6, G7 — out-pointer / out_bytes boundaries\n// ---------------------------------------------------------------------------\n\n/// G3 — `out == NULL` with `out_bytes == 0`: `out + 1 <= out_end` is false, so\n/// E3 fires *before* anything is dereferenced.\n#[test]\nfn g3_null_out_zero_bytes() {\n    let (c, r) = load_both();\n    let stream = fixed_only(true, &[Item::Lit(b'Z')]);\n    for off in 0..4usize {\n        let case = InflateCase::new(stream.clone(), 0).in_off(off).null_out();\n        expect(\n            &c,\n            &r,\n            &case,\n            0,\n            Some(ERR_OUT_SYMBOL),\n            &format!(\"G3 off={off}\"),\n        );\n    }\n    // An *empty* block writes nothing at all, so NULL/0 succeeds.\n    let empty = fixed_only(true, &[]);\n    let case = InflateCase::new(empty, 0).null_out();\n    expect(&c, &r, &case, 1, None, \"G3 empty block, NULL out\");\n}\n\n/// G4 — `out_bytes == 0` with a valid pointer.\n#[test]\nfn g4_out_bytes_zero() {\n    let (c, r) = load_both();\n    for stream in [\n        fixed_only(true, &[Item::Lit(1)]),\n        fixed_only(true, &[Item::Lit(1), Item::Lit(2)]),\n    ] {\n        for off in 0..4usize {\n            let case = InflateCase::new(stream.clone(), 0).in_off(off);\n            expect(\n                &c,\n                &r,\n                &case,\n                0,\n                Some(ERR_OUT_SYMBOL),\n                &format!(\"G4 off={off}\"),\n            );\n        }\n    }\n}\n\n/// G5 — negative `out_bytes` (so `out_end < out`).\n#[test]\nfn g5_out_bytes_negative() {\n    let (c, r) = load_both();\n    let stream = fixed_only(true, &[Item::Lit(7), Item::Lit(8)]);\n    for out_bytes in [-1i32, -2, -100, -65536, c_int::MIN, c_int::MIN + 1] {\n        for off in 0..4usize {\n            let case = InflateCase::new(stream.clone(), out_bytes)\n                .in_off(off)\n                .out_off(32 * 1024);\n            expect(\n                &c,\n                &r,\n                &case,\n                0,\n                Some(ERR_OUT_SYMBOL),\n                &format!(\"G5 out_bytes={out_bytes} off={off}\"),\n            );\n        }\n    }\n}\n\n/// G6 — `out_bytes` exactly one byte short of the true output size.\n#[test]\nfn g6_out_bytes_one_short() {\n    let (c, r) = load_both();\n    // Literal-only: the last literal trips E3.\n    for n in 1usize..=20 {\n        let items: Vec<Item> = (0..n).map(|i| Item::Lit(i as u8)).collect();\n        let stream = fixed_only(true, &items);\n        let case = InflateCase::new(stream.clone(), n as c_int - 1);\n        expect(\n            &c,\n            &r,\n            &case,\n            0,\n            Some(ERR_OUT_SYMBOL),\n            &format!(\"G6 lits n={n}\"),\n        );\n        let case = InflateCase::new(stream, n as c_int);\n        expect(&c, &r, &case, 1, None, &format!(\"G6 lits n={n} exact\"));\n    }\n    // Ending in a copy: the copy trips E5 instead.\n    for len in [3u32, 9, 258] {\n        let (len_sym, len_extra) = len_code(len);\n        let items = vec![\n            Item::Lit(0xAB),\n            Item::Match {\n                len_sym,\n                len_extra,\n                dist_sym: 0,\n                dist_extra: 0,\n            },\n        ];\n        let total = 1 + len as c_int;\n        let stream = fixed_only(true, &items);\n        let case = InflateCase::new(stream.clone(), total - 1);\n        expect(\n            &c,\n            &r,\n            &case,\n            0,\n            Some(ERR_OUT_STRING),\n            &format!(\"G6 copy len={len}\"),\n        );\n        let case = InflateCase::new(stream, total);\n        expect(&c, &r, &case, 1, None, &format!(\"G6 copy len={len} exact\"));\n    }\n    // flate2 streams, one byte short.\n    use flate2::write::DeflateEncoder;\n    use flate2::Compression;\n    use std::io::Write;\n    let mut rng = SplitMix::new(0x6606);\n    for n in [4usize, 10, 100, 1000] {\n        let data: Vec<u8> = (0..n).map(|_| b'a' + rng.below(4) as u8).collect();\n        for level in [1u32, 6, 9] {\n            let mut e = DeflateEncoder::new(Vec::new(), Compression::new(level));\n            e.write_all(&data).unwrap();\n            let stream = e.finish().unwrap();\n            let case = InflateCase::new(stream.clone(), n as c_int - 1);\n            assert_inflate_eq_arena(&c, &r, &case, &format!(\"G6 flate2 n={n}\"), 64 * 1024);\n            let rc = run_inflate(&c, &case, 64 * 1024);\n            assert_eq!(rc.ret, 0, \"G6 flate2 n={n} lvl={level}: expected failure\");\n            assert!(\n                rc.err.as_deref() == Some(ERR_OUT_SYMBOL)\n                    || rc.err.as_deref() == Some(ERR_OUT_STRING),\n                \"G6 flate2 n={n}: unexpected reason {:?}\",\n                rc.err.as_ref().map(|e| String::from_utf8_lossy(e).into_owned())\n            );\n        }\n    }\n}\n\n/// G7 — `out_bytes == INT_MAX` (and other huge values) must still succeed.\n#[test]\nfn g7_out_bytes_int_max() {\n    let (c, r) = load_both();\n    let mut rng = SplitMix::new(0x7707);\n    for out_bytes in [c_int::MAX, c_int::MAX - 1, 1 << 30, 1 << 24] {\n        // literals\n        let items: Vec<Item> = rng.bytes(32).into_iter().map(Item::Lit).collect();\n        let stream = fixed_only(true, &items);\n        for off in 0..4usize {\n            let case = InflateCase::new(stream.clone(), out_bytes).in_off(off);\n            expect(&c, &r, &case, 1, None, &format!(\"G7 out={out_bytes} off={off}\"));\n        }\n        // a stored block\n        let payload = rng.bytes(64);\n        let stream = stored_ok(true, &payload);\n        let case = InflateCase::new(stream, out_bytes);\n        expect(&c, &r, &case, 1, None, &format!(\"G7 stored out={out_bytes}\"));\n    }\n}\n\n// ---------------------------------------------------------------------------\n// G9 — trailing garbage after the real stream\n// ---------------------------------------------------------------------------\n\n#[test]\nfn g9_trailing_garbage() {\n    let (c, r) = load_both();\n    let mut rng = SplitMix::new(0x9909);\n\n    // Compressed blocks: the extra bytes are never read, so the call succeeds.\n    for n in [1usize, 5, 40] {\n        let items: Vec<Item> = rng.bytes(n).into_iter().map(Item::Lit).collect();\n        let base = fixed_only(true, &items);\n        for extra in [1usize, 2, 3, 4, 7, 16, 64] {\n            let mut stream = base.clone();\n            stream.extend_from_slice(&rng.bytes(extra));\n            for off in 0..4usize {\n                let case = InflateCase::new(stream.clone(), n as c_int).in_off(off);\n                // Both must agree; the C's own result is whatever it is.\n                assert_inflate_eq_arena(\n                    &c,\n                    &r,\n                    &case,\n                    &format!(\"G9 fixed n={n} extra={extra} off={off}\"),\n                    64 * 1024,\n                );\n            }\n        }\n    }\n\n    // Stored blocks: extra input makes `bits_left/8 > LEN` -> E2.\n    for n in [0usize, 1, 8, 100] {\n        let payload = rng.bytes(n);\n        let base = stored_ok(true, &payload);\n        for extra in [1usize, 4, 16] {\n            let mut stream = base.clone();\n            stream.extend_from_slice(&rng.bytes(extra));\n            let case = InflateCase::new(stream, n as c_int + 1024);\n            expect(\n                &c,\n                &r,\n                &case,\n                0,\n                Some(ERR_STORED_BEYOND),\n                &format!(\"G9 stored n={n} extra={extra}\"),\n            );\n        }\n    }\n\n    // `in_bytes` larger than the buffer content (the arena filler becomes the\n    // trailing garbage — identical in both implementations).\n    for n in [1usize, 5, 40] {\n        let items: Vec<Item> = rng.bytes(n).into_iter().map(Item::Lit).collect();\n        let stream = fixed_only(true, &items);\n        for grow in [1i32, 2, 3, 4, 9, 64] {\n            let case = InflateCase::new(stream.clone(), n as c_int)\n                .in_bytes(stream.len() as c_int + grow);\n            assert_inflate_eq_arena(\n                &c,\n                &r,\n                &case,\n                &format!(\"G9 in_bytes+{grow} n={n}\"),\n                64 * 1024,\n            );\n        }\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
