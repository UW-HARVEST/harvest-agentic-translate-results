enlens.as_ptr(),\n        19,\n    ) as u32;\n\n    // C: `uint8_t lens[288 + 32];` (uninitialized).  The repeat codes may run\n    // past the end of the logical range, and code 16 reads lens[-1] when n==0;\n    // the backing store is padded on both sides so those accesses stay inside\n    // our allocation.\n    let mut lens_buf = [0u8; 1 + (288 + 32) + 160];\n    let lens = lens_buf.as_mut_ptr().offset(1);\n\n    let mut n: c_int = 0;\n    while n < nlit + ndst {\n        let sym = cp_decode(s, addr_of_mut!((*s).len) as *mut u32, (*s).nlen as c_int);\n        match sym {\n            16 => {\n                let mut i: c_int = 3 + cp_read_bits(s, 2) as c_int;\n                while i != 0 {\n                    *lens.offset(n as isize) = *lens.offset((n - 1) as isize);\n                    i -= 1;\n                    n += 1;\n                }\n            }\n            17 => {\n                let mut i: c_int = 3 + cp_read_bits(s, 3) as c_int;\n                while i != 0 {\n                    *lens.offset(n as isize) = 0;\n                    i -= 1;\n                    n += 1;\n                }\n            }\n            18 => {\n                let mut i: c_int = 11 + cp_read_bits(s, 7) as c_int;\n                while i != 0 {\n                    *lens.offset(n as isize) = 0;\n                    i -= 1;\n                    n += 1;\n                }\n            }\n            _ => {\n                *lens.offset(n as isize) = sym as u8;\n                n += 1;\n            }\n        }\n    }\n    (*s).nlit = cp_build(s, addr_of_mut!((*s).lit) as *mut u32, lens, nlit) as u32;\n    (*s).ndst = cp_build(\n        ptr::null_mut(),\n        addr_of_mut!((*s).dst) as *mut u32,\n        lens.offset(nlit as isize),\n        ndst,\n    ) as u32;\n    1\n}\n\nunsafe fn cp_block(s: *mut cp_state_t) -> c_int {\n    let len_extra = addr_of_mut!(cp_len_extra_bits) as *const u8;\n    let len_base = addr_of_mut!(cp_len_base) as *const u32;\n    let dist_extra