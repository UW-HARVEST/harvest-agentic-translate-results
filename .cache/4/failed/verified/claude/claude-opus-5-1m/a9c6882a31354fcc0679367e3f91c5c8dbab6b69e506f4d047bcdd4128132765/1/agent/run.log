{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_mm6gjsd2kasiqvq3pbvsgimp5g7ghluxotl2ungl3czrfgdri6na","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_013NtSVfP9ocPVFNNjyHrStX","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-AesDK8/translated_rust/tests/fuzz.rs","content":"//! Phase B/C — CONFIGS.md rows X5 and X6: property-style differential fuzzing\n//! of `cp_inflate` with fixed seeds.\n//!\n//! Every case is run against BOTH `.so`s in a forked subprocess, so the\n//! comparison covers\n//!   * the return value,\n//!   * the exact `cp_error_reason` string,\n//!   * a hash of the WHOLE 256 KiB output arena (catching out-of-bounds writes),\n//!   * a hash of the WHOLE input arena (neither may modify its input), and\n//!   * the fatal signal (SIGABRT from a failed `assert()`, SIGSEGV, ...) when\n//!     the case kills the process, plus a shared wall-clock watchdog for the\n//!     inputs that make `cp_block` loop forever.\n//!\n//! Both implementations always get an arena at the same alignment mod 4 filled\n//! with the same pseudo-random bytes, which is what makes the C's numerous\n//! out-of-bounds *reads* deterministic and therefore comparable.\n//!\n//! # Why the corpora are shaped the way they are\n//!\n//! `cp_dynamic` decodes `nlit + ndst` code lengths into `uint8_t lens[288+32]`,\n//! a C **stack** array, and a repeat code (16/17/18) starting near the end of\n//! that range writes up to 137 bytes past it — clobbering `nlit`, `ndst`, `n`,\n//! `s` and the return address.  On this compiler that turns into an infinite\n//! loop or a wild jump; the value is not determined by the C source, so no\n//! byte-identical Rust translation of it exists (the Rust uses a padded buffer\n//! and terminates).  See `ub_cp_dynamic_lens_overrun` at the bottom of this\n//! file, which pins down seven concrete inputs that hit it.\n//!\n//! The corpora below are therefore built so that overrun is **impossible by\n//! construction**, using exactly two rules:\n//!\n//! 1. Bits 0..=2 of the stream (BFINAL and BTYPE of the first block) are always\n//!    fixed with BFINAL = 1, so exactly one block is ever decoded and BTYPE is\n//!    whatever the case intends.\n//! 2. When that BTYPE is 2, the whole `cp_dynamic` header — through the last\n//!    code-length instruction, i.e. `Dynamic::header_bits()` — is left intact,\n//!    so the loop provably emits exactly `nlit + ndst` lengths.  Only the\n//!    compressed *data* bits after it are fuzzed.\n//!\n//! Everything else (all of BTYPE 0/1/3, `cp_block`, `cp_decode`, `cp_stored`,\n//! the bit reader, every `out_bytes` boundary) is fuzzed without restriction.\n\nmod common;\n\nuse common::deflate::*;\nuse common::subproc::*;\nuse common::*;\nuse std::os::raw::c_int;\n\nconst CHILD: &str = \"child_entry\";\n\nfn ispec(input: Vec<u8>, in_off: usize, out_bytes: c_int, seed: u64) -> Spec {\n    let n = input.len() as c_int;\n    Spec::Inflate {\n        input,\n        in_off,\n        in_bytes: n,\n        out_bytes,\n        out_off: 0,\n        null_in: false,\n        null_out: false,\n        seed,\n        arena: ARENA,\n    }\n}\n\nfn out_bytes_choice(rng: &mut SplitMix) -> c_int {\n    match rng.below(7) {\n        0 => 0,\n        1 => 1,\n        2 => 4,\n        3 => 64,\n        4 => 4096,\n        5 => 65536,\n        _ => c_int::MAX,\n    }\n}\n\n/// Rule 1: pin BFINAL = 1 and BTYPE = `btype` in bits 0..=2.\nfn set_header(b0: u8, btype: u8) -> u8 {\n    (b0 & 0xF8) | 1 | (btype << 1)\n}\n\n// ---------------------------------------------------------------------------\n// X5 — unstructured random bytes, BTYPE 0 / 1 / 3\n// ---------------------------------------------------------------------------\n\n#[test]\nfn x5_random_stored_and_fixed_and_reserved() {\n    let mut rng = SplitMix::new(0x0F0225);\n    let mut specs = Vec::new();\n    for i in 0..4500 {\n        let n = 1 + rng.below(32) as usize; // 1..=32 bytes\n        let mut input = rng.bytes(n);\n        let btype = [0u8, 1, 3][(i % 3) as usize];\n        input[0] = set_header(input[0], btype);\n        specs.push(ispec(\n            input,\n            (i % 4) as usize,\n            out_bytes_choice(&mut rng),\n            rng.next_u64(),\n        ));\n    }\n    let out = assert_batch_eq(&specs, CHILD, \"X5\");\n    report(\"X5\", &out);\n}\n\n/// X5 (continued) — longer random inputs, still BTYPE 0/1, so `cp_block` runs\n/// for much longer and the `memset`/copy paths get random lengths and distances.\n#[test]\nfn x5_random_longer_inputs() {\n    let mut rng = SplitMix::new(0x5A17ED);\n    let mut specs = Vec::new();\n    for i in 0..1500 {\n        let n = 32 + rng.below(480) as usize; // 32..=511 bytes\n        let mut input = rng.bytes(n);\n        input[0] = set_header(input[0], (i % 2) as u8);\n        specs.push(ispec(\n            input,\n            (i % 4) as usize,\n            out_bytes_choice(&mut rng),\n            rng.next_u64(),\n        ));\n    }\n    let out = assert_batch_eq(&specs, CHILD, \"X5long\");\n    report(\"X5long\", &out);\n}\n\n/// X5 (continued) — BTYPE 2 with a WELL-FORMED `cp_dynamic` header (rule 2) and\n/// completely random data bits after it.  This is what reaches `cp_block`\n/// through the dynamic Huffman trees with arbitrary symbol streams.\n#[test]\nfn x5_random_dynamic_payloads() {\n    let mut rng = SplitMix::new(0xD9A7A);\n\n    // A selection of well-formed headers with different shapes.\n    let mut headers: Vec<(String, Dynamic)> = Vec::new();\n    headers.push((\"full\".into(), dynamic_full()));\n    {\n        let lens = lens_for(257, 1, &[b'a' as usize, b'b' as usize, 256], &[0]);\n        headers.push((\"min\".into(), dynamic_from_lens(257, 1, &lens)));\n    }\n    {\n        // A deep code (lengths up to 15) so cp_build's len > 9 path is used.\n        let syms: Vec<usize> = (0..15).map(|k| b'a' as usize + k).chain([256]).collect();\n        let lens = deep_lens(257, 1, &syms, &[0]);\n        headers.push((\"deep\".into(), dynamic_rle(257, 1, &lens)));\n    }\n    {\n        // 30 distance codes + a broad literal alphabet.\n        let mut lens = vec![0u8; 286 + 30];\n        for i in 0..286 {\n            lens[i] = 9;\n        }\n        for i in 0..30 {\n            lens[286 + i] = 5;\n        }\n        headers.push((\"wide\".into(), dynamic_rle(286, 30, &lens)));\n    }\n\n    let mut specs = Vec::new();\n    for (_, d) in &headers {\n        let hbits = d.header_bits(true);\n        for _ in 0..500 {\n            // Rebuild the header, then append random data bits.\n            let mut w = BitWriter::new();\n            d.header(&mut w, true);\n            let extra_bits = 8 + rng.below(600);\n            for _ in 0..extra_bits {\n                w.bits(rng.next_u32() & 1, 1);\n            }\n            let stream = w.finish();\n            assert!(stream.len() * 8 >= hbits);\n            specs.push(ispec(\n                stream,\n                rng.below(4) as usize,\n                out_bytes_choice(&mut rng),\n                rng.next_u64(),\n            ));\n        }\n    }\n    let out = assert_batch_eq(&specs, CHILD, \"X5dyn\");\n    report(\"X5dyn\", &out);\n}\n\n// ---------------------------------------------------------------------------\n// X6 — bit-flipped mutations of VALID streams\n// ---------------------------------------------------------------------------\n\n/// A valid stream plus the first bit index that fuzzing may touch.\nstruct Seed {\n    name: String,\n    stream: Vec<u8>,\n    /// Expected output size when undamaged.\n    out_len: i64,\n    /// Bits `[0, protect)` are never mutated (rules 1 and 2).\n    protect: usize,\n}\n\nfn seeds(rng: &mut SplitMix) -> Vec<Seed> {\n    use flate2::write::DeflateEncoder;\n    use flate2::Compression;\n    use std::io::Write;\n\n    let mut v: Vec<Seed> = Vec::new();\n\n    // BTYPE 0 — protect only BFINAL/BTYPE.\n    for n in [0usize, 1, 4, 12, 40] {\n        let p = rng.bytes(n);\n        v.push(Seed {\n            name: format!(\"stored{n}\"),\n            stream: stored_ok(true, &p),\n            out_len: n as i64,\n            protect: 3,\n        });\n    }\n\n    // BTYPE 1 — protect only BFINAL/BTYPE.\n    v.push(Seed {\n        name: \"fixed-empty\".into(),\n        stream: fixed_only(true, &[]),\n        out_len: 0,\n        protect: 3,\n    });\n    {\n        let items: Vec<Item> = rng.bytes(16).into_iter().map(Item::Lit).collect();\n        v.push(Seed {\n            name: \"fixed-lits\".into(),\n            out_len: out_size(&items),\n            stream: fixed_only(true, &items),\n            protect: 3,\n        });\n    }\n    {\n        let items = vec![Item::Lit(b'a'), match_item(60, 1), Item::Lit(b'b')];\n        v.push(Seed {\n            name: \"fixed-match1\".into(),\n            out_len: out_size(&items),\n            stream: fixed_only(true, &items),\n            protect: 3,\n        });\n    }\n    {\n        let mut items = fill_items(300, b'x');\n        items.push(match_item(258, 257));\n        v.push(Seed {\n            name: \"fixed-longdist\".into(),\n            out_len: out_size(&items),\n            stream: fixed_only(true, &items),\n            protect: 3,\n        });\n    }\n    // `flate2` streams: force BFINAL=1/BTYPE ∈ {0,1} in the first block by\n    // checking what the encoder produced, and skip anything dynamic.\n    for level in [0u32, 1, 2, 3, 6, 9] {\n        for n in [1usize, 12, 40, 200] {\n            let data: Vec<u8> = (0..n).map(|_| b'a' + rng.below(5) as u8).collect();\n            let mut e = DeflateEncoder::new(Vec::new(), Compression::new(level));\n            e.write_all(&data).unwrap();\n            let s = e.finish().unwrap();\n            if s.is_empty() {\n                continue;\n            }\n            let bfinal = s[0] & 1;\n            let btype = (s[0] >> 1) & 3;\n            if bfinal != 1 || btype == 2 || btype == 3 {\n                // Multi-block or dynamic: mutating it could reach the\n                // `cp_dynamic` stack overrun, so it is only fuzzed through the\n                // structured `x5_random_dynamic_payloads` route instead.\n                continue;\n            }\n            v.push(Seed {\n                name: format!(\"flate2-l{level}-n{n}-t{btype}\"),\n                stream: s,\n                out_len: n as i64,\n                protect: 3,\n            });\n        }\n    }\n\n    // BTYPE 2 — protect the entire cp_dynamic header (rule 2).\n    {\n        let lens = lens_for(257, 1, &[b'a' as usize, b'b' as usize, 256], &[0]);\n        let d = dynamic_from_lens(257, 1, &lens);\n        let items: Vec<Item> = (0..12)\n            .map(|i| Item::Lit(if i % 3 == 0 { b'a' } else { b'b' }))\n            .collect();\n        v.push(Seed {\n            name: \"dynamic-min\".into(),\n            out_len: out_size(&items),\n            protect: d.header_bits(true),\n            stream: d.only(true, &items),\n        });\n    }\n    {\n        let d = dynamic_full();\n        let items = vec![\n            Item::Lit(1),\n            Item::Lit(200),\n            match_item(20, 2),\n            Item::Lit(255),\n            match_item(258, 1),\n        ];\n        v.push(Seed {\n            name: \"dynamic-full\".into(),\n            out_len: out_size(&items),\n            protect: d.header_bits(true),\n            stream: d.only(true, &items),\n        });\n    }\n    v\n}\n\n#[test]\nfn x6_bitflipped_valid_streams() {\n    let mut rng = SplitMix::new(0xF11F11);\n    let pool = seeds(&mut rng);\n    assert!(pool.len() >= 12, \"seed pool too small: {}\", pool.len());\n\n    // Every seed must itself decode identically and successfully first.\n    let base_specs: Vec<Spec> = pool\n        .iter()\n        .flat_map(|s| {\n            let stream = s.stream.clone();\n            let n = s.out_len;\n            (0..4usize).map(move |off| ispec(stream.clone(), off, n as c_int + 64, 0x515E))\n        })\n        .collect();\n    let base = assert_batch_eq(&base_specs, CHILD, \"X6 base\");\n    for (i, o) in base.iter().enumerate() {\n        match o {\n            Outcome::Returned { ret: 1, .. } => {}\n            other => panic!(\n                \"X6 base spec #{i} ({}) did not decode: {other:?}\",\n                pool[i / 4].name\n            ),\n        }\n    }\n\n    // Now the mutations.\n    let mut specs = Vec::new();\n    for s in &pool {\n        let bits = s.stream.len() * 8;\n        if bits <= s.protect {\n            continue;\n        }\n        let span = bits - s.protect;\n        for _ in 0..400 {\n            let mut m = s.stream.clone();\n            let nflips = 1 + rng.below(3) as usize;\n            for _ in 0..nflips {\n                let b = s.protect + rng.below(span as u32) as usize;\n                m[b / 8] ^= 1 << (b % 8);\n            }\n            let out_bytes = match rng.below(5) {\n                0 => s.out_len as c_int,\n                1 => s.out_len as c_int + 64,\n                2 => 0,\n                3 => 4096,\n                _ => 65536,\n            };\n            specs.push(ispec(m, rng.below(4) as usize, out_bytes, rng.next_u64()));\n        }\n    }\n    assert!(specs.len() > 2000, \"only {} mutation specs\", specs.len());\n    let out = assert_batch_eq(&specs, CHILD, \"X6\");\n    report(\"X6\", &out);\n}\n\n/// X6 (continued) — exhaustive single-bit flips over the mutable region of each\n/// seed (not sampled: EVERY bit), plus byte substitutions.\n#[test]\nfn x6_exhaustive_single_bit_flips() {\n    let mut rng = SplitMix::new(0xB17B17);\n    let pool = seeds(&mut rng);\n    let mut specs = Vec::new();\n    for s in &pool {\n        let bits = s.stream.len() * 8;\n        for b in s.protect..bits {\n            let mut m = s.stream.clone();\n            m[b / 8] ^= 1 << (b % 8);\n            specs.push(ispec(m, (b % 4) as usize, s.out_len as c_int + 32, 0xB1B1));\n        }\n        for byte in (s.protect + 7) / 8..s.stream.len() {\n            for v in [0x00u8, 0x01, 0x55, 0xAA, 0xFE, 0xFF] {\n                let mut m = s.stream.clone();\n                m[byte] = v;\n                specs.push(ispec(m, (byte % 4) as usize, 4096, 0xB2B2));\n            }\n        }\n    }\n    assert!(specs.len() > 2000, \"only {} specs\", specs.len());\n    let out = assert_batch_eq(&specs, CHILD, \"X6exh\");\n    report(\"X6exh\", &out);\n}\n\n/// X6 (continued) — `in_bytes` lying about the buffer length in both\n/// directions, over BTYPE 0/1 seeds (rule 2 keeps dynamic streams out: a\n/// truncated dynamic header changes the decoded code-length sequence and could\n/// overrun `lens[]`).\n#[test]\nfn x6_length_mutations() {\n    let mut rng = SplitMix::new(0x1E17A);\n    let pool: Vec<Seed> = seeds(&mut rng)\n        .into_iter()\n        .filter(|s| s.protect == 3)\n        .collect();\n    assert!(pool.len() >= 8);\n\n    let mut specs = Vec::new();\n    for s in &pool {\n        let len = s.stream.len() as i32;\n        for delta in -len..=8 {\n            for off in 0..4usize {\n                let mut sp = ispec(s.stream.clone(), off, 4096, rng.next_u64());\n                if let Spec::Inflate { in_bytes, .. } = &mut sp {\n                    *in_bytes = len + delta;\n                }\n                specs.push(sp);\n            }\n        }\n        // Real truncation (the bytes past the cut are the arena filler).\n        for k in 0..=s.stream.len() {\n            specs.push(ispec(\n                s.stream[..k].to_vec(),\n                (k % 4) as usize,\n                4096,\n                rng.next_u64(),\n            ));\n        }\n    }\n    assert!(specs.len() > 500, \"only {} specs\", specs.len());\n    let out = assert_batch_eq(&specs, CHILD, \"X6len\");\n    report(\"X6len\", &out);\n}\n\n// ---------------------------------------------------------------------------\n// The one excluded class, pinned down explicitly\n// ---------------------------------------------------------------------------\n\n/// Seven inputs found by unrestricted fuzzing that make the C's `cp_dynamic`\n/// write past its `uint8_t lens[288 + 32]` **stack** array.\n///\n/// Diagnosed by running each one against an instrumented copy of `lib.c`\n/// (built outside `c_src/`); in every case the final iteration of\n/// `for (int n = 0; n < nlit + ndst;)` decodes code-length symbol **18**\n/// (a run of `11 + read(7)` zeros, i.e. up to 138 entries) while `n` is already\n/// 267..303, so the run writes as far as `lens[440]` — 121 bytes past the end\n/// of a 320-byte array, over `nlit`, `ndst`, `n`, `s`, the saved registers and\n/// the return address.\n///\n/// | in_off | in_bytes | HLIT | HDIST | n at the last symbol-18 | nlit+ndst |\n/// |--------|----------|------|-------|-------------------------|-----------|\n/// | 1 | 28 | 285 | 27 | 270 | 312 |\n/// | 1 | 17 | 278 | 10 | 268 | 288 |\n/// | 3 | 24 | 278 | 27 | 293 | 305 |\n/// | 0 | 20 | 280 | 25 | 271 | 305 |\n/// | 3 | 24 | 277 | 26 | 299 | 303 |\n/// | 0 | 25 | 282 | 22 | 303 | 304 |\n/// | 1 | 29 | 270 | 17 | 267 | 287 |\n///\n/// The resulting behaviour is a property of gcc's `-O0` frame layout, not of\n/// the C source, so there is no byte-identical translation to write: the Rust\n/// keeps the writes inside a padded buffer and lets the loop finish.  What IS\n/// well defined, and what this test asserts, is that **neither implementation\n/// ever reports success** for these inputs.\nconst UB_LENS_OVERRUN: &[(usize, c_int, &str)] = &[\n    (1, 28, \"e57abaac341937e6a82af2e5fc583014b227c6782a33a33868b8e4a4\"),\n    (1, 17, \"adc98af8847609d4052e42cb691cc96be3\"),\n    (3, 24, \"ad9a107e7a31c408fbd4a91fc38be1f11d99eadb05590793\"),\n    (0, 20, \"bdd858d1849db44eb702b7b99e9acbdb53c9d5ab\"),\n    (3, 24, \"a519fb60454debc10e25411ca6866e0ed69f94bf0c00bc01\"),\n    (0, 25, \"cd156f4549e88ad59c8e3945e6570e48b7c517595e3cbf0727\"),\n    (1, 29, \"6d50568580259e7ae086bacdb9e41e8ce77e66ee00ea57dedeb60485b7\"),\n];\n\n#[test]\nfn ub_cp_dynamic_lens_overrun() {\n    let specs: Vec<Spec> = UB_LENS_OVERRUN\n        .iter()\n        .map(|&(off, nb, hx)| {\n            let mut sp = ispec(unhex(hx), off, 65536, 0x0BAD);\n            if let Spec::Inflate { in_bytes, .. } = &mut sp {\n                *in_bytes = nb;\n            }\n            sp\n        })\n        .collect();\n\n    let c = run_batch(&c_so_path(), &specs, CHILD);\n    let r = run_batch(&rust_so_path(), &specs, CHILD);\n\n    for i in 0..specs.len() {\n        // The C must not report success (it hangs or dies).\n        let c_ok = matches!(c[i], Outcome::Returned { ret: 1, .. });\n        let r_ok = matches!(r[i], Outcome::Returned { ret: 1, .. });\n        assert!(\n            !c_ok,\n            \"spec #{i}: the C unexpectedly succeeded — re-check whether this \\\n             input really reaches the lens[] overrun ({:?})\",\n            c[i]\n        );\n        assert!(\n            !r_ok,\n            \"spec #{i}: the Rust unexpectedly succeeded ({:?})\",\n            r[i]\n        );\n        eprintln!(\"UB-overrun #{i}: C={:?} Rust={:?}\", c[i], r[i]);\n    }\n}\n\n// ---------------------------------------------------------------------------\n\nfn report(label: &str, out: &[Outcome]) {\n    let mut ok = 0usize;\n    let mut err = 0usize;\n    let mut sigs = std::collections::BTreeMap::<i32, usize>::new();\n    for o in out {\n        match o {\n            Outcome::Returned { ret: 1, .. } => ok += 1,\n            Outcome::Returned { .. } => err += 1,\n            Outcome::Signal(s) => *sigs.entry(*s).or_default() += 1,\n            Outcome::ExitCode(c) => *sigs.entry(-c).or_default() += 1,\n        }\n    }\n    eprintln!(\n        \"{label}: {} cases -> {ok} succeeded, {err} rejected, signals {sigs:?}\",\n        out.len()\n    );\n    assert!(\n        err > 0 && !sigs.is_empty(),\n        \"{label}: the corpus must contain both rejected and fatal cases \\\n         (ok={ok} err={err} sigs={sigs:?})\"\n    );\n}\n\n/// Child process entry point (a no-op in a normal test run).\n#[test]\nfn child_entry() {\n    common::subproc::child_entry();\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5237,"cache_read_input_tokens":343224,"cache_creation":{"ephemeral_5m_input_tokens":5237,"ephemeral_1h_input_tokens":0},"output_tokens":17,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"1f391add-adf5-472a-b38e-02e2e663f9ae","uuid":"3d1476b8-8395-4836-99b1-74a425c84204","timestamp":"2026-08-20T09:57:24.944Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_013NtSVfP9ocPVFNNjyHrStX","type":"tool_result","content":"The file /local/home/scheschb/.harvest/work/harvest-work-AesDK8/translated_rust/tests/fuzz.rs has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"1f391add-adf5-472a-b38e-02e2e663f9ae","uuid":"8d0be651-ed83-4a7e-8522-7fc09467f250","timestamp":"2026-08-20T09:57:24.988Z","tool_use_result":{"type":"update","filePath":"/local/home/scheschb/.harvest/work/harvest-work-AesDK8/translated_rust/tests/fuzz.rs","content":"//! Phase B/C — CONFIGS.md rows X5 and X6: property-style differential fuzzing\n//! of `cp_inflate` with fixed seeds.\n//!\n//! Every case is run against BOTH `.so`s in a forked subprocess, so the\n//! comparison covers\n//!   * the return value,\n//!   * the exact `cp_error_reason` string,\n//!   * a hash of the WHOLE 256 KiB output arena (catching out-of-bounds writes),\n//!   * a hash of the WHOLE input arena (neither may modify its input), and\n//!   * the fatal signal (SIGABRT from a failed `assert()`, SIGSEGV, ...) when\n//!     the case kills the process, plus a shared wall-clock watchdog for the\n//!     inputs that make `cp_block` loop forever.\n//!\n//! Both implementations always get an arena at the same alignment mod 4 filled\n//! with the same pseudo-random bytes, which is what makes the C's numerous\n//! out-of-bounds *reads* deterministic and therefore comparable.\n//!\n//! # Why the corpora are shaped the way they are\n//!\n//! `cp_dynamic` decodes `nlit + ndst` code lengths into `uint8_t lens[288+32]`,\n//! a C **stack** array, and a repeat code (16/17/18) starting near the end of\n//! that range writes up to 137 bytes past it — clobbering `nlit`, `ndst`, `n`,\n//! `s` and the return address.  On this compiler that turns into an infinite\n//! loop or a wild jump; the value is not determined by the C source, so no\n//! byte-identical Rust translation of it exists (the Rust uses a padded buffer\n//! and terminates).  See `ub_cp_dynamic_lens_overrun` at the bottom of this\n//! file, which pins down seven concrete inputs that hit it.\n//!\n//! The corpora below are therefore built so that overrun is **impossible by\n//! construction**, using exactly two rules:\n//!\n//! 1. Bits 0..=2 of the stream (BFINAL and BTYPE of the first block) are always\n//!    fixed with BFINAL = 1, so exactly one block is ever decoded and BTYPE is\n//!    whatever the case intends.\n//! 2. When that BTYPE is 2, the whole `cp_dynamic` header — through the last\n//!    code-length instruction, i.e. `Dynamic::header_bits()` — is left intact,\n//!    so the loop provably emits exactly `nlit + ndst` lengths.  Only the\n//!    compressed *data* bits after it are fuzzed.\n//!\n//! Everything else (all of BTYPE 0/1/3, `cp_block`, `cp_decode`, `cp_stored`,\n//! the bit reader, every `out_bytes` boundary) is fuzzed without restriction.\n\nmod common;\n\nuse common::deflate::*;\nuse common::subproc::*;\nuse common::*;\nuse std::os::raw::c_int;\n\nconst CHILD: &str = \"child_entry\";\n\nfn ispec(input: Vec<u8>, in_off: usize, out_bytes: c_int, seed: u64) -> Spec {\n    let n = input.len() as c_int;\n    Spec::Inflate {\n        input,\n        in_off,\n        in_bytes: n,\n        out_bytes,\n        out_off: 0,\n        null_in: false,\n        null_out: false,\n        seed,\n        arena: ARENA,\n    }\n}\n\nfn out_bytes_choice(rng: &mut SplitMix) -> c_int {\n    match rng.below(7) {\n        0 => 0,\n        1 => 1,\n        2 => 4,\n        3 => 64,\n        4 => 4096,\n        5 => 65536,\n        _ => c_int::MAX,\n    }\n}\n\n/// Rule 1: pin BFINAL = 1 and BTYPE = `btype` in bits 0..=2.\nfn set_header(b0: u8, btype: u8) -> u8 {\n    (b0 & 0xF8) | 1 | (btype << 1)\n}\n\n// ---------------------------------------------------------------------------\n// X5 — unstructured random bytes, BTYPE 0 / 1 / 3\n// ---------------------------------------------------------------------------\n\n#[test]\nfn x5_random_stored_and_fixed_and_reserved() {\n    let mut rng = SplitMix::new(0x0F0225);\n    let mut specs = Vec::new();\n    for i in 0..4500 {\n        let n = 1 + rng.below(32) as usize; // 1..=32 bytes\n        let mut input = rng.bytes(n);\n        let btype = [0u8, 1, 3][(i % 3) as usize];\n        input[0] = set_header(input[0], btype);\n        specs.push(ispec(\n            input,\n            (i % 4) as usize,\n            out_bytes_choice(&mut rng),\n            rng.next_u64(),\n        ));\n    }\n    let out = assert_batch_eq(&specs, CHILD, \"X5\");\n    report(\"X5\", &out);\n}\n\n/// X5 (continued) — longer random inputs, still BTYPE 0/1, so `cp_block` runs\n/// for much longer and the `memset`/copy paths get random lengths and distances.\n#[test]\nfn x5_random_longer_inputs() {\n    let mut rng = SplitMix::new(0x5A17ED);\n    let mut specs = Vec::new();\n    for i in 0..1500 {\n        let n = 32 + rng.below(480) as usize; // 32..=511 bytes\n        let mut input = rng.bytes(n);\n        input[0] = set_header(input[0], (i % 2) as u8);\n        specs.push(ispec(\n            input,\n            (i % 4) as usize,\n            out_bytes_choice(&mut rng),\n            rng.next_u64(),\n        ));\n    }\n    let out = assert_batch_eq(&specs, CHILD, \"X5long\");\n    report(\"X5long\", &out);\n}\n\n/// X5 (continued) — BTYPE 2 with a WELL-FORMED `cp_dynamic` header (rule 2) and\n/// completely random data bits after it.  This is what reaches `cp_block`\n/// through the dynamic Huffman trees with arbitrary symbol streams.\n#[test]\nfn x5_random_dynamic_payloads() {\n    let mut rng = SplitMix::new(0xD9A7A);\n\n    // A selection of well-formed headers with different shapes.\n    let mut headers: Vec<(String, Dynamic)> = Vec::new();\n    headers.push((\"full\".into(), dynamic_full()));\n    {\n        let lens = lens_for(257, 1, &[b'a' as usize, b'b' as usize, 256], &[0]);\n        headers.push((\"min\".into(), dynamic_from_lens(257, 1, &lens)));\n    }\n    {\n        // A deep code (lengths up to 15) so cp_build's len > 9 path is used.\n        let syms: Vec<usize> = (0..15).map(|k| b'a' as usize + k).chain([256]).collect();\n        let lens = deep_lens(257, 1, &syms, &[0]);\n        headers.push((\"deep\".into(), dynamic_rle(257, 1, &lens)));\n    }\n    {\n        // 30 distance codes + a broad literal alphabet.\n        let mut lens = vec![0u8; 286 + 30];\n        for i in 0..286 {\n            lens[i] = 9;\n        }\n        for i in 0..30 {\n            lens[286 + i] = 5;\n        }\n        headers.push((\"wide\".into(), dynamic_rle(286, 30, &lens)));\n    }\n\n    let mut specs = Vec::new();\n    for (_, d) in &headers {\n        let hbits = d.header_bits(true);\n        for _ in 0..500 {\n            // Rebuild the header, then append random data bits.\n            let mut w = BitWriter::new();\n            d.header(&mut w, true);\n            let extra_bits = 8 + rng.below(600);\n            for _ in 0..extra_bits {\n                w.bits(rng.next_u32() & 1, 1);\n            }\n            let stream = w.finish();\n            assert!(stream.len() * 8 >= hbits);\n            specs.push(ispec(\n                stream,\n                rng.below(4) as usize,\n                out_bytes_choice(&mut rng),\n                rng.next_u64(),\n            ));\n        }\n    }\n    let out = assert_batch_eq(&specs, CHILD, \"X5dyn\");\n    report(\"X5dyn\", &out);\n}\n\n// ---------------------------------------------------------------------------\n// X6 — bit-flipped mutations of VALID streams\n// ---------------------------------------------------------------------------\n\n/// A valid stream plus the first bit index that fuzzing may touch.\nstruct Seed {\n    name: String,\n    stream: Vec<u8>,\n    /// Expected output size when undamaged.\n    out_len: i64,\n    /// Bits `[0, protect)` are never mutated (rules 1 and 2).\n    protect: usize,\n}\n\nfn seeds(rng: &mut SplitMix) -> Vec<Seed> {\n    use flate2::write::DeflateEncoder;\n    use flate2::Compression;\n    use std::io::Write;\n\n    let mut v: Vec<Seed> = Vec::new();\n\n    // BTYPE 0 — protect only BFINAL/BTYPE.\n    for n in [0usize, 1, 4, 12, 40] {\n        let p = rng.bytes(n);\n        v.push(Seed {\n            name: format!(\"stored{n}\"),\n            stream: stored_ok(true, &p),\n            out_len: n as i64,\n            protect: 3,\n        });\n    }\n\n    // BTYPE 1 — protect only BFINAL/BTYPE.\n    v.push(Seed {\n        name: \"fixed-empty\".into(),\n        stream: fixed_only(true, &[]),\n        out_len: 0,\n        protect: 3,\n    });\n    {\n        let items: Vec<Item> = rng.bytes(16).into_iter().map(Item::Lit).collect();\n        v.push(Seed {\n            name: \"fixed-lits\".into(),\n            out_len: out_size(&items),\n            stream: fixed_only(true, &items),\n            protect: 3,\n        });\n    }\n    {\n        let items = vec![Item::Lit(b'a'), match_item(60, 1), Item::Lit(b'b')];\n        v.push(Seed {\n            name: \"fixed-match1\".into(),\n            out_len: out_size(&items),\n            stream: fixed_only(true, &items),\n            protect: 3,\n        });\n    }\n    {\n        let mut items = fill_items(300, b'x');\n        items.push(match_item(258, 257));\n        v.push(Seed {\n            name: \"fixed-longdist\".into(),\n            out_len: out_size(&items),\n            stream: fixed_only(true, &items),\n            protect: 3,\n        });\n    }\n    // `flate2` streams: force BFINAL=1/BTYPE ∈ {0,1} in the first block by\n    // checking what the encoder produced, and skip anything dynamic.\n    for level in [0u32, 1, 2, 3, 6, 9] {\n        for n in [1usize, 12, 40, 200] {\n            let data: Vec<u8> = (0..n).map(|_| b'a' + rng.below(5) as u8).collect();\n            let mut e = DeflateEncoder::new(Vec::new(), Compression::new(level));\n            e.write_all(&data).unwrap();\n            let s = e.finish().unwrap();\n            if s.is_empty() {\n                continue;\n            }\n            let bfinal = s[0] & 1;\n            let btype = (s[0] >> 1) & 3;\n            if bfinal != 1 || btype == 2 || btype == 3 {\n                // Multi-block or dynamic: mutating it could reach the\n                // `cp_dynamic` stack overrun, so it is only fuzzed through the\n                // structured `x5_random_dynamic_payloads` route instead.\n                continue;\n            }\n            v.push(Seed {\n                name: format!(\"flate2-l{level}-n{n}-t{btype}\"),\n                stream: s,\n                out_len: n as i64,\n                protect: 3,\n            });\n        }\n    }\n\n    // BTYPE 2 — protect the entire cp_dynamic header (rule 2).\n    {\n        let lens = lens_for(257, 1, &[b'a' as usize, b'b' as usize, 256], &[0]);\n        let d = dynamic_from_lens(257, 1, &lens);\n        let items: Vec<Item> = (0..12)\n            .map(|i| Item::Lit(if i % 3 == 0 { b'a' } else { b'b' }))\n            .collect();\n        v.push(Seed {\n            name: \"dynamic-min\".into(),\n            out_len: out_size(&items),\n            protect: d.header_bits(true),\n            stream: d.only(true, &items),\n        });\n    }\n    {\n        let d = dynamic_full();\n        let items = vec![\n            Item::Lit(1),\n            Item::Lit(200),\n            match_item(20, 2),\n            Item::Lit(255),\n            match_item(258, 1),\n        ];\n        v.push(Seed {\n            name: \"dynamic-full\".into(),\n            out_len: out_size(&items),\n            protect: d.header_bits(true),\n            stream: d.only(true, &items),\n        });\n    }\n    v\n}\n\n#[test]\nfn x6_bitflipped_valid_streams() {\n    let mut rng = SplitMix::new(0xF11F11);\n    let pool = seeds(&mut rng);\n    assert!(pool.len() >= 12, \"seed pool too small: {}\", pool.len());\n\n    // Every seed must itself decode identically and successfully first.\n    let base_specs: Vec<Spec> = pool\n        .iter()\n        .flat_map(|s| {\n            let stream = s.stream.clone();\n            let n = s.out_len;\n            (0..4usize).map(move |off| ispec(stream.clone(), off, n as c_int + 64, 0x515E))\n        })\n        .collect();\n    let base = assert_batch_eq(&base_specs, CHILD, \"X6 base\");\n    for (i, o) in base.iter().enumerate() {\n        match o {\n            Outcome::Returned { ret: 1, .. } => {}\n            other => panic!(\n                \"X6 base spec #{i} ({}) did not decode: {other:?}\",\n                pool[i / 4].name\n            ),\n        }\n    }\n\n    // Now the mutations.\n    let mut specs = Vec::new();\n    for s in &pool {\n        let bits = s.stream.len() * 8;\n        if bits <= s.protect {\n            continue;\n        }\n        let span = bits - s.protect;\n        for _ in 0..400 {\n            let mut m = s.stream.clone();\n            let nflips = 1 + rng.below(3) as usize;\n            for _ in 0..nflips {\n                let b = s.protect + rng.below(span as u32) as usize;\n                m[b / 8] ^= 1 << (b % 8);\n            }\n            let out_bytes = match rng.below(5) {\n                0 => s.out_len as c_int,\n                1 => s.out_len as c_int + 64,\n                2 => 0,\n                3 => 4096,\n                _ => 65536,\n            };\n            specs.push(ispec(m, rng.below(4) as usize, out_bytes, rng.next_u64()));\n        }\n    }\n    assert!(specs.len() > 2000, \"only {} mutation specs\", specs.len());\n    let out = assert_batch_eq(&specs, CHILD, \"X6\");\n    report(\"X6\", &out);\n}\n\n/// X6 (continued) — exhaustive single-bit flips over the mutable region of each\n/// seed (not sampled: EVERY bit), plus byte substitutions.\n#[test]\nfn x6_exhaustive_single_bit_flips() {\n    let mut rng = SplitMix::new(0xB17B17);\n    let pool = seeds(&mut rng);\n    let mut specs = Vec::new();\n    for s in &pool {\n        let bits = s.stream.len() * 8;\n        for b in s.protect..bits {\n            let mut m = s.stream.clone();\n            m[b / 8] ^= 1 << (b % 8);\n            specs.push(ispec(m, (b % 4) as usize, s.out_len as c_int + 32, 0xB1B1));\n        }\n        for byte in (s.protect + 7) / 8..s.stream.len() {\n            for v in [0x00u8, 0x01, 0x55, 0xAA, 0xFE, 0xFF] {\n                let mut m = s.stream.clone();\n                m[byte] = v;\n                specs.push(ispec(m, (byte % 4) as usize, 4096, 0xB2B2));\n            }\n        }\n    }\n    assert!(specs.len() > 2000, \"only {} specs\", specs.len());\n    let out = assert_batch_eq(&specs, CHILD, \"X6exh\");\n    report(\"X6exh\", &out);\n}\n\n/// X6 (continued) — `in_bytes` lying about the buffer length in both\n/// directions, over BTYPE 0/1 seeds (rule 2 keeps dynamic streams out: a\n/// truncated dynamic header changes the decoded code-length sequence and could\n/// overrun `lens[]`).\n#[test]\nfn x6_length_mutations() {\n    let mut rng = SplitMix::new(0x1E17A);\n    let pool: Vec<Seed> = seeds(&mut rng)\n        .into_iter()\n        .filter(|s| s.protect == 3)\n        .collect();\n    assert!(pool.len() >= 8);\n\n    let mut specs = Vec::new();\n    for s in &pool {\n        let len = s.stream.len() as i32;\n        for delta in -len..=8 {\n            for off in 0..4usize {\n                let mut sp = ispec(s.stream.clone(), off, 4096, rng.next_u64());\n                if let Spec::Inflate { in_bytes, .. } = &mut sp {\n                    *in_bytes = len + delta;\n                }\n                specs.push(sp);\n            }\n        }\n        // Real truncation (the bytes past the cut are the arena filler).\n        for k in 0..=s.stream.len() {\n            specs.push(ispec(\n                s.stream[..k].to_vec(),\n                (k % 4) as usize,\n                4096,\n                rng.next_u64(),\n            ));\n        }\n    }\n    assert!(specs.len() > 500, \"only {} specs\", specs.len());\n    let out = assert_batch_eq(&specs, CHILD, \"X6len\");\n    report(\"X6len\", &out);\n}\n\n// ---------------------------------------------------------------------------\n// The one excluded class, pinned down explicitly\n// ---------------------------------------------------------------------------\n\n/// Seven inputs found by unrestricted fuzzing that make the C's `cp_dynamic`\n/// write past its `uint8_t lens[288 + 32]` **stack** array.\n///\n/// Diagnosed by running each one against an instrumented copy of `lib.c`\n/// (built outside `c_src/`); in every case the final iteration of\n/// `for (int n = 0; n < nlit + ndst;)` decodes code-length symbol **18**\n/// (a run of `11 + read(7)` zeros, i.e. up to 138 entries) while `n` is already\n/// 267..303, so the run writes as far as `lens[440]` — 121 bytes past the end\n/// of a 320-byte array, over `nlit`, `ndst`, `n`, `s`, the saved registers and\n/// the return address.\n///\n/// | in_off | in_bytes | HLIT | HDIST | n at the last symbol-18 | nlit+ndst |\n/// |--------|----------|------|-------|-------------------------|-----------|\n/// | 1 | 28 | 285 | 27 | 270 | 312 |\n/// | 1 | 17 | 278 | 10 | 268 | 288 |\n/// | 3 | 24 | 278 | 27 | 293 | 305 |\n/// | 0 | 20 | 280 | 25 | 271 | 305 |\n/// | 3 | 24 | 277 | 26 | 299 | 303 |\n/// | 0 | 25 | 282 | 22 | 303 | 304 |\n/// | 1 | 29 | 270 | 17 | 267 | 287 |\n///\n/// The resulting behaviour is a property of gcc's `-O0` frame layout, not of\n/// the C source, so there is no byte-identical translation to write: the Rust\n/// keeps the writes inside a padded buffer and lets the loop finish.  What IS\n/// well defined, and what this test asserts, is that **neither implementation\n/// ever reports success** for these inputs.\nconst UB_LENS_OVERRUN: &[(usize, c_int, &str)] = &[\n    (1, 28, \"e57abaac341937e6a82af2e5fc583014b227c6782a33a33868b8e4a4\"),\n    (1, 17, \"adc98af8847609d4052e42cb691cc96be3\"),\n    (3, 24, \"ad9a107e7a31c408fbd4a91fc38be1f11d99eadb05590793\"),\n    (0, 20, \"bdd858d1849db44eb702b7b99e9acbdb53c9d5ab\"),\n    (3, 24, \"a519fb60454debc10e25411ca6866e0ed69f94bf0c00bc01\"),\n    (0, 25, \"cd156f4549e88ad59c8e3945e6570e48b7c517595e3cbf0727\"),\n    (1, 29, \"6d50568580259e7ae086bacdb9e41e8ce77e66ee00ea57dedeb60485b7\"),\n];\n\n#[test]\nfn ub_cp_dynamic_lens_overrun() {\n    let specs: Vec<Spec> = UB_LENS_OVERRUN\n        .iter()\n        .map(|&(off, nb, hx)| {\n            let mut sp = ispec(unhex(hx), off, 65536, 0x0BAD);\n            if let Spec::Inflate { in_bytes, .. } = &mut sp {\n                *in_bytes = nb;\n            }\n            sp\n        })\n        .collect();\n\n    let c = run_batch(&c_so_path(), &specs, CHILD);\n    let r = run_batch(&rust_so_path(), &specs, CHILD);\n\n    for i in 0..specs.len() {\n        // The C must not report success (it hangs or dies).\n        let c_ok = matches!(c[i], Outcome::Returned { ret: 1, .. });\n        let r_ok = matches!(r[i], Outcome::Returned { ret: 1, .. });\n        assert!(\n            !c_ok,\n            \"spec #{i}: the C unexpectedly succeeded — re-check whether this \\\n             input really reaches the lens[] overrun ({:?})\",\n            c[i]\n        );\n        assert!(\n            !r_ok,\n            \"spec #{i}: the Rust unexpectedly succeeded ({:?})\",\n            r[i]\n        );\n        eprintln!(\"UB-overrun #{i}: C={:?} Rust={:?}\", c[i], r[i]);\n    }\n}\n\n// ---------------------------------------------------------------------------\n\nfn report(label: &str, out: &[Outcome]) {\n    let mut ok = 0usize;\n    let mut err = 0usize;\n    let mut sigs = std::collections::BTreeMap::<i32, usize>::new();\n    for o in out {\n        match o {\n            Outcome::Returned { ret: 1, .. } => ok += 1,\n            Outcome::Returned { .. } => err += 1,\n            Outcome::Signal(s) => *sigs.entry(*s).or_default() += 1,\n            Outcome::ExitCode(c) => *sigs.entry(-c).or_default() += 1,\n        }\n    }\n    eprintln!(\n        \"{label}: {} cases -> {ok} succeeded, {err} rejected, signals {sigs:?}\",\n        out.len()\n    );\n    assert!(\n        err > 0 && !sigs.is_empty(),\n        \"{label}: the corpus must contain both rejected and fatal cases \\\n         (ok={ok} err={err} sigs={sigs:?})\"\n    );\n}\n\n/// Child process entry point (a no-op in a normal test run).\n#[test]\nfn child_entry() {\n    common::subproc::child_entry();\n}\n","structuredPatch":[{"oldStart":1,"oldLines":5,"newStart":1,"newLines":5,"lines":[" //! Phase B/C — CONFIGS.md rows X5 and X6: property-style differential fuzzing","-//! of `cp_inflate` with a fixed seed.","+//! of `cp_inflate` with fixed seeds."," //!"," //! Every case is run against BOTH `.so`s in a forked subprocess, so the"," //! comparison covers"]},{"oldStart":8,"oldLines":11,"newStart":8,"newLines":37,"lines":[" //!   * a hash of the WHOLE 256 KiB output arena (catching out-of-bounds writes),"," //!   * a hash of the WHOLE input arena (neither may modify its input), and"," //!   * the fatal signal (SIGABRT from a failed `assert()`, SIGSEGV, ...) when","-//!     the case kills the process.","+//!     the case kills the process, plus a shared wall-clock watchdog for the","+//!     inputs that make `cp_block` loop forever."," //!"," //! Both implementations always get an arena at the same alignment mod 4 filled"," //! with the same pseudo-random bytes, which is what makes the C's numerous","-//! out-of-bounds reads deterministic and therefore comparable.","+//! out-of-bounds *reads* deterministic and therefore comparable.","+//!","+//! # Why the corpora are shaped the way they are","+//!","+//! `cp_dynamic` decodes `nlit + ndst` code lengths into `uint8_t lens[288+32]`,","+//! a C **stack** array, and a repeat code (16/17/18) starting near the end of","+//! that range writes up to 137 bytes past it — clobbering `nlit`, `ndst`, `n`,","+//! `s` and the return address.  On this compiler that turns into an infinite","+//! loop or a wild jump; the value is not determined by the C source, so no","+//! byte-identical Rust translation of it exists (the Rust uses a padded buffer","+//! and terminates).  See `ub_cp_dynamic_lens_overrun` at the bottom of this","+//! file, which pins down seven concrete inputs that hit it.","+//!","+//! The corpora below are therefore built so that overrun is **impossible by","+//! construction**, using exactly two rules:","+//!","+//! 1. Bits 0..=2 of the stream (BFINAL and BTYPE of the first block) are always","+//!    fixed with BFINAL = 1, so exactly one block is ever decoded and BTYPE is","+//!    whatever the case intends.","+//! 2. When that BTYPE is 2, the whole `cp_dynamic` header — through the last","+//!    code-length instruction, i.e. `Dynamic::header_bits()` — is left intact,","+//!    so the loop provably emits exactly `nlit + ndst` lengths.  Only the","+//!    compressed *data* bits after it are fuzzed.","+//!","+//! Everything else (all of BTYPE 0/1/3, `cp_block`, `cp_decode`, `cp_stored`,","+//! the bit reader, every `out_bytes` boundary) is fuzzed without restriction."," "," mod common;"," "]},{"oldStart":38,"oldLines":90,"newStart":64,"newLines":233,"lines":["     }"," }"," ","-/// X5 — short pseudo-random byte strings at every alignment.","-///","-/// Short inputs are the sweet spot: they reach the bit-reader's end-of-stream","-/// asserts, `cp_stored`'s checks and `cp_decode`'s no-prefix assert without","-/// ever getting far enough into `cp_dynamic` to overrun its `lens[288+32]`","-/// stack array (which is genuine UB in the C — see CONFIGS.md).","+fn out_bytes_choice(rng: &mut SplitMix) -> c_int {","+    match rng.below(7) {","+        0 => 0,","+        1 => 1,","+        2 => 4,","+        3 => 64,","+        4 => 4096,","+        5 => 65536,","+        _ => c_int::MAX,","+    }","+}","+","+/// Rule 1: pin BFINAL = 1 and BTYPE = `btype` in bits 0..=2.","+fn set_header(b0: u8, btype: u8) -> u8 {","+    (b0 & 0xF8) | 1 | (btype << 1)","+}","+","+// ---------------------------------------------------------------------------","+// X5 — unstructured random bytes, BTYPE 0 / 1 / 3","+// ---------------------------------------------------------------------------","+"," #[test]","-fn x5_random_short_inputs() {","+fn x5_random_stored_and_fixed_and_reserved() {","     let mut rng = SplitMix::new(0x0F0225);","     let mut specs = Vec::new();","-    for i in 0..3000 {","-        let n = 2 + rng.below(23) as usize; // 2..=24 bytes","-        let input = rng.bytes(n);","-        let in_off = (i % 4) as usize;","-        let out_bytes = match rng.below(6) {","-            0 => 0,","-            1 => 1,","-            2 => 4,","-            3 => 64,","-            4 => 4096,","-            _ => 65536,","-        };","-        specs.push(ispec(input, in_off, out_bytes, rng.next_u64()));","+    for i in 0..4500 {","+        let n = 1 + rng.below(32) as usize; // 1..=32 bytes","+        let mut input = rng.bytes(n);","+        let btype = [0u8, 1, 3][(i % 3) as usize];","+        input[0] = set_header(input[0], btype);","+        specs.push(ispec(","+            input,","+            (i % 4) as usize,","+            out_bytes_choice(&mut rng),","+            rng.next_u64(),","+        ));","     }","     let out = assert_batch_eq(&specs, CHILD, \"X5\");","     report(\"X5\", &out);"," }"," ","-/// X5 (continued) — the same, but with a biased generator that produces valid","-/// block headers far more often, so more of the decoder is reached.","+/// X5 (continued) — longer random inputs, still BTYPE 0/1, so `cp_block` runs","+/// for much longer and the `memset`/copy paths get random lengths and distances."," #[test]","-fn x5_biased_short_inputs() {","-    let mut rng = SplitMix::new(0xB1A5ED);","+fn x5_random_longer_inputs() {","+    let mut rng = SplitMix::new(0x5A17ED);","     let mut specs = Vec::new();","-    for i in 0..3000 {","-        let n = 3 + rng.below(30) as usize;","+    for i in 0..1500 {","+        let n = 32 + rng.below(480) as usize; // 32..=511 bytes","         let mut input = rng.bytes(n);","-        // Force BFINAL=1 and a non-reserved BTYPE in the first byte.","-        let btype = rng.below(3) as u8; // 0, 1 or 2","-        input[0] = (input[0] & 0xF8) | 1 | (btype << 1);","-        let in_off = (i % 4) as usize;","-        let out_bytes = if rng.below(2) == 0 { 4096 } else { 65536 };","-        specs.push(ispec(input, in_off, out_bytes, rng.next_u64()));","+        input[0] = set_header(input[0], (i % 2) as u8);","+        specs.push(ispec(","+            input,","+            (i % 4) as usize,","+            out_bytes_choice(&mut rng),","+            rng.next_u64(),","+        ));","     }","-    let out = assert_batch_eq(&specs, CHILD, \"X5b\");","-    report(\"X5b\", &out);","+    let out = assert_batch_eq(&specs, CHILD, \"X5long\");","+    report(\"X5long\", &out);"," }"," ","-/// X6 — bit-flipped mutations of VALID streams (1..=3 flipped bits).","-///","-/// Mutating a valid stream keeps the decoder deep inside `cp_block` /","-/// `cp_dynamic` for much longer than random bytes do, which is where the","-/// interesting divergences would live.","+/// X5 (continued) — BTYPE 2 with a WELL-FORMED `cp_dynamic` header (rule 2) and","+/// completely random data bits after it.  This is what reaches `cp_block`","+/// through the dynamic Huffman trees with arbitrary symbol streams."," #[test]","-fn x6_bitflipped_valid_streams() {","+fn x5_random_dynamic_payloads() {","+    let mut rng = SplitMix::new(0xD9A7A);","+","+    // A selection of well-formed headers with different shapes.","+    let mut headers: Vec<(String, Dynamic)> = Vec::new();","+    headers.push((\"full\".into(), dynamic_full()));","+    {","+        let lens = lens_for(257, 1, &[b'a' as usize, b'b' as usize, 256], &[0]);","+        headers.push((\"min\".into(), dynamic_from_lens(257, 1, &lens)));","+    }","+    {","+        // A deep code (lengths up to 15) so cp_build's len > 9 path is used.","+        let syms: Vec<usize> = (0..15).map(|k| b'a' as usize + k).chain([256]).collect();","+        let lens = deep_lens(257, 1, &syms, &[0]);","+        headers.push((\"deep\".into(), dynamic_rle(257, 1, &lens)));","+    }","+    {","+        // 30 distance codes + a broad literal alphabet.","+        let mut lens = vec![0u8; 286 + 30];","+        for i in 0..286 {","+            lens[i] = 9;","+        }","+        for i in 0..30 {","+            lens[286 + i] = 5;","+        }","+        headers.push((\"wide\".into(), dynamic_rle(286, 30, &lens)));","+    }","+","+    let mut specs = Vec::new();","+    for (_, d) in &headers {","+        let hbits = d.header_bits(true);","+        for _ in 0..500 {","+            // Rebuild the header, then append random data bits.","+            let mut w = BitWriter::new();","+            d.header(&mut w, true);","+            let extra_bits = 8 + rng.below(600);","+            for _ in 0..extra_bits {","+                w.bits(rng.next_u32() & 1, 1);","+            }","+            let stream = w.finish();","+            assert!(stream.len() * 8 >= hbits);","+            specs.push(ispec(","+                stream,","+                rng.below(4) as usize,","+                out_bytes_choice(&mut rng),","+                rng.next_u64(),","+            ));","+        }","+    }","+    let out = assert_batch_eq(&specs, CHILD, \"X5dyn\");","+    report(\"X5dyn\", &out);","+}","+","+// ---------------------------------------------------------------------------","+// X6 — bit-flipped mutations of VALID streams","+// ---------------------------------------------------------------------------","+","+/// A valid stream plus the first bit index that fuzzing may touch.","+struct Seed {","+    name: String,","+    stream: Vec<u8>,","+    /// Expected output size when undamaged.","+    out_len: i64,","+    /// Bits `[0, protect)` are never mutated (rules 1 and 2).","+    protect: usize,","+}","+","+fn seeds(rng: &mut SplitMix) -> Vec<Seed> {","     use flate2::write::DeflateEncoder;","     use flate2::Compression;","     use std::io::Write;"," ","-    let mut rng = SplitMix::new(0xF11F11);","+    let mut v: Vec<Seed> = Vec::new();"," ","-    // A pool of valid streams of every block type.","-    let mut pool: Vec<(String, Vec<u8>, i64)> = Vec::new();","-    pool.push((\"stored0\".into(), stored_ok(true, &[]), 0));","-    pool.push((\"stored12\".into(), stored_ok(true, &rng.bytes(12)), 12));","-    pool.push((\"fixed-empty\".into(), fixed_only(true, &[]), 0));","+    // BTYPE 0 — protect only BFINAL/BTYPE.","+    for n in [0usize, 1, 4, 12, 40] {","+        let p = rng.bytes(n);","+        v.push(Seed {","+            name: format!(\"stored{n}\"),","+            stream: stored_ok(true, &p),","+            out_len: n as i64,","+            protect: 3,","+        });","+    }","+","+    // BTYPE 1 — protect only BFINAL/BTYPE.","+    v.push(Seed {","+        name: \"fixed-empty\".into(),","+        stream: fixed_only(true, &[]),","+        out_len: 0,","+        protect: 3,","+    });","     {","-        let items: Vec<Item> = rng.bytes(12).into_iter().map(Item::Lit).collect();","-        let n = out_size(&items);","-        pool.push((\"fixed-lits\".into(), fixed_only(true, &items), n));","+        let items: Vec<Item> = rng.bytes(16).into_iter().map(Item::Lit).collect();","+        v.push(Seed {","+            name: \"fixed-lits\".into(),","+            out_len: out_size(&items),","+            stream: fixed_only(true, &items),","+            protect: 3,","+        });","     }","     {","         let items = vec![Item::Lit(b'a'), match_item(60, 1), Item::Lit(b'b')];","-        let n = out_size(&items);","-        pool.push((\"fixed-match\".into(), fixed_only(true, &items), n));","+        v.push(Seed {","+            name: \"fixed-match1\".into(),","+            out_len: out_size(&items),","+            stream: fixed_only(true, &items),","+            protect: 3,","+        });","     }","     {","+        let mut items = fill_items(300, b'x');","+        items.push(match_item(258, 257));","+        v.push(Seed {","+            name: \"fixed-longdist\".into(),","+            out_len: out_size(&items),","+            stream: fixed_only(true, &items),","+            protect: 3,","+        });","+    }","+    // `flate2` streams: force BFINAL=1/BTYPE ∈ {0,1} in the first block by","+    // checking what the encoder produced, and skip anything dynamic.","+    for level in [0u32, 1, 2, 3, 6, 9] {","+        for n in [1usize, 12, 40, 200] {","+            let data: Vec<u8> = (0..n).map(|_| b'a' + rng.below(5) as u8).collect();","+            let mut e = DeflateEncoder::new(Vec::new(), Compression::new(level));","+            e.write_all(&data).unwrap();","+            let s = e.finish().unwrap();","+            if s.is_empty() {","+                continue;","+            }","+            let bfinal = s[0] & 1;","+            let btype = (s[0] >> 1) & 3;","+            if bfinal != 1 || btype == 2 || btype == 3 {","+                // Multi-block or dynamic: mutating it could reach the","+                // `cp_dynamic` stack overrun, so it is only fuzzed through the","+                // structured `x5_random_dynamic_payloads` route instead.","+                continue;","+            }","+            v.push(Seed {","+                name: format!(\"flate2-l{level}-n{n}-t{btype}\"),","+                stream: s,","+                out_len: n as i64,","+                protect: 3,","+            });","+        }","+    }","+","+    // BTYPE 2 — protect the entire cp_dynamic header (rule 2).","+    {","         let lens = lens_for(257, 1, &[b'a' as usize, b'b' as usize, 256], &[0]);","         let d = dynamic_from_lens(257, 1, &lens);","-        let items: Vec<Item> = (0..10)","+        let items: Vec<Item> = (0..12)","             .map(|i| Item::Lit(if i % 3 == 0 { b'a' } else { b'b' }))","             .collect();","-        let n = out_size(&items);","-        pool.push((\"dynamic\".into(), d.only(true, &items), n));","+        v.push(Seed {","+            name: \"dynamic-min\".into(),","+            out_len: out_size(&items),","+            protect: d.header_bits(true),","+            stream: d.only(true, &items),","+        });","     }","     {","         let d = dynamic_full();"]},{"oldStart":130,"oldLines":99,"newStart":299,"newLines":218,"lines":["             Item::Lit(200),","             match_item(20, 2),","             Item::Lit(255),","+            match_item(258, 1),","         ];","-        let n = out_size(&items);","-        pool.push((\"dynamic-full\".into(), d.only(true, &items), n));","+        v.push(Seed {","+            name: \"dynamic-full\".into(),","+            out_len: out_size(&items),","+            protect: d.header_bits(true),","+            stream: d.only(true, &items),","+        });","     }","-    for level in [1u32, 6, 9] {","-        let data: Vec<u8> = (0..40).map(|_| b'a' + rng.below(5) as u8).collect();","-        let mut e = DeflateEncoder::new(Vec::new(), Compression::new(level));","-        e.write_all(&data).unwrap();","-        pool.push((format!(\"flate2-{level}\"), e.finish().unwrap(), 40));","-    }","+    v","+}"," ","-    // Every stream in the pool must itself decode identically first.","+#[test]","+fn x6_bitflipped_valid_streams() {","+    let mut rng = SplitMix::new(0xF11F11);","+    let pool = seeds(&mut rng);","+    assert!(pool.len() >= 12, \"seed pool too small: {}\", pool.len());","+","+    // Every seed must itself decode identically and successfully first.","     let base_specs: Vec<Spec> = pool","         .iter()","-        .flat_map(|(_, s, n)| {","-            (0..4usize).map(move |off| ispec(s.clone(), off, *n as c_int + 64, 0x515E))","+        .flat_map(|s| {","+            let stream = s.stream.clone();","+            let n = s.out_len;","+            (0..4usize).map(move |off| ispec(stream.clone(), off, n as c_int + 64, 0x515E))","         })","         .collect();","     let base = assert_batch_eq(&base_specs, CHILD, \"X6 base\");","     for (i, o) in base.iter().enumerate() {","         match o {","-            Outcome::Returned { ret, .. } => {","-                assert_eq!(*ret, 1, \"X6 base spec #{i} did not decode: {o:?}\")","-            }","-            other => panic!(\"X6 base spec #{i} was fatal: {other:?}\"),","+            Outcome::Returned { ret: 1, .. } => {}","+            other => panic!(","+                \"X6 base spec #{i} ({}) did not decode: {other:?}\",","+                pool[i / 4].name","+            ),","         }","     }"," ","     // Now the mutations.","     let mut specs = Vec::new();","-    for (_, stream, n) in &pool {","-        let bits = stream.len() * 8;","-        if bits == 0 {","+    for s in &pool {","+        let bits = s.stream.len() * 8;","+        if bits <= s.protect {","             continue;","         }","-        for _ in 0..320 {","-            let mut m = stream.clone();","+        let span = bits - s.protect;","+        for _ in 0..400 {","+            let mut m = s.stream.clone();","             let nflips = 1 + rng.below(3) as usize;","             for _ in 0..nflips {","-                let b = rng.below(bits as u32) as usize;","+                let b = s.protect + rng.below(span as u32) as usize;","                 m[b / 8] ^= 1 << (b % 8);","             }","-            let in_off = rng.below(4) as usize;","-            let out_bytes = match rng.below(4) {","-                0 => *n as c_int,","-                1 => *n as c_int + 64,","-                2 => 4096,","+            let out_bytes = match rng.below(5) {","+                0 => s.out_len as c_int,","+                1 => s.out_len as c_int + 64,","+                2 => 0,","+                3 => 4096,","                 _ => 65536,","             };","-            specs.push(ispec(m, in_off, out_bytes, rng.next_u64()));","+            specs.push(ispec(m, rng.below(4) as usize, out_bytes, rng.next_u64()));","         }","     }","+    assert!(specs.len() > 2000, \"only {} mutation specs\", specs.len());","     let out = assert_batch_eq(&specs, CHILD, \"X6\");","     report(\"X6\", &out);"," }"," ","-/// X6 (continued) — truncations and single-byte substitutions of valid streams,","-/// plus `in_bytes` lying about the buffer length in both directions.","+/// X6 (continued) — exhaustive single-bit flips over the mutable region of each","+/// seed (not sampled: EVERY bit), plus byte substitutions."," #[test]","-fn x6_length_and_byte_mutations() {","+fn x6_exhaustive_single_bit_flips() {","+    let mut rng = SplitMix::new(0xB17B17);","+    let pool = seeds(&mut rng);","+    let mut specs = Vec::new();","+    for s in &pool {","+        let bits = s.stream.len() * 8;","+        for b in s.protect..bits {","+            let mut m = s.stream.clone();","+            m[b / 8] ^= 1 << (b % 8);","+            specs.push(ispec(m, (b % 4) as usize, s.out_len as c_int + 32, 0xB1B1));","+        }","+        for byte in (s.protect + 7) / 8..s.stream.len() {","+            for v in [0x00u8, 0x01, 0x55, 0xAA, 0xFE, 0xFF] {","+                let mut m = s.stream.clone();","+                m[byte] = v;","+                specs.push(ispec(m, (byte % 4) as usize, 4096, 0xB2B2));","+            }","+        }","+    }","+    assert!(specs.len() > 2000, \"only {} specs\", specs.len());","+    let out = assert_batch_eq(&specs, CHILD, \"X6exh\");","+    report(\"X6exh\", &out);","+}","+","+/// X6 (continued) — `in_bytes` lying about the buffer length in both","+/// directions, over BTYPE 0/1 seeds (rule 2 keeps dynamic streams out: a","+/// truncated dynamic header changes the decoded code-length sequence and could","+/// overrun `lens[]`).","+#[test]","+fn x6_length_mutations() {","     let mut rng = SplitMix::new(0x1E17A);","-    let items: Vec<Item> = (0..14).map(|i| Item::Lit(0x61 + i as u8)).collect();","-    let base_fixed = fixed_only(true, &items);","-    let base_stored = stored_ok(true, &rng.bytes(14));","-    let lens = lens_for(257, 1, &[b'a' as usize, b'b' as usize, 256], &[0]);","-    let d = dynamic_from_lens(257, 1, &lens);","-    let base_dyn = d.only(true, &[Item::Lit(b'a'), Item::Lit(b'b'), Item::Lit(b'a')]);","+    let pool: Vec<Seed> = seeds(&mut rng)","+        .into_iter()","+        .filter(|s| s.protect == 3)","+        .collect();","+    assert!(pool.len() >= 8);"," ","     let mut specs = Vec::new();","-    for base in [&base_fixed, &base_stored, &base_dyn] {","-        // single-byte substitutions","-        for pos in 0..base.len() {","-            for v in [0x00u8, 0x01, 0x7F, 0x80, 0xFE, 0xFF] {","-                let mut m = base.clone();","-                m[pos] = v;","-                specs.push(ispec(m, (pos % 4) as usize, 4096, rng.next_u64()));","+    for s in &pool {","+        let len = s.stream.len() as i32;","+        for delta in -len..=8 {","+            for off in 0..4usize {","+                let mut sp = ispec(s.stream.clone(), off, 4096, rng.next_u64());","+                if let Spec::Inflate { in_bytes, .. } = &mut sp {","+                    *in_bytes = len + delta;","+                }","+                specs.push(sp);","             }","         }","-        // `in_bytes` lying in both directions","-        for delta in -(base.len() as i32)..=8 {","-            let n = base.len() as i32 + delta;","-            let mut sp = ispec(base.clone(), 3, 4096, rng.next_u64());","-            if let Spec::Inflate { in_bytes, .. } = &mut sp {","-                *in_bytes = n;","-            }","-            specs.push(sp);","+        // Real truncation (the bytes past the cut are the arena filler).","+        for k in 0..=s.stream.len() {","+            specs.push(ispec(","+                s.stream[..k].to_vec(),","+                (k % 4) as usize,","+                4096,","+                rng.next_u64(),","+            ));","         }","     }","-    assert!(specs.len() > 200, \"only {} specs\", specs.len());","+    assert!(specs.len() > 500, \"only {} specs\", specs.len());","     let out = assert_batch_eq(&specs, CHILD, \"X6len\");","     report(\"X6len\", &out);"," }"," ","+// ---------------------------------------------------------------------------","+// The one excluded class, pinned down explicitly","+// ---------------------------------------------------------------------------","+","+/// Seven inputs found by unrestricted fuzzing that make the C's `cp_dynamic`","+/// write past its `uint8_t lens[288 + 32]` **stack** array.","+///","+/// Diagnosed by running each one against an instrumented copy of `lib.c`","+/// (built outside `c_src/`); in every case the final iteration of","+/// `for (int n = 0; n < nlit + ndst;)` decodes code-length symbol **18**","+/// (a run of `11 + read(7)` zeros, i.e. up to 138 entries) while `n` is already","+/// 267..303, so the run writes as far as `lens[440]` — 121 bytes past the end","+/// of a 320-byte array, over `nlit`, `ndst`, `n`, `s`, the saved registers and","+/// the return address.","+///","+/// | in_off | in_bytes | HLIT | HDIST | n at the last symbol-18 | nlit+ndst |","+/// |--------|----------|------|-------|-------------------------|-----------|","+/// | 1 | 28 | 285 | 27 | 270 | 312 |","+/// | 1 | 17 | 278 | 10 | 268 | 288 |","+/// | 3 | 24 | 278 | 27 | 293 | 305 |","+/// | 0 | 20 | 280 | 25 | 271 | 305 |","+/// | 3 | 24 | 277 | 26 | 299 | 303 |","+/// | 0 | 25 | 282 | 22 | 303 | 304 |","+/// | 1 | 29 | 270 | 17 | 267 | 287 |","+///","+/// The resulting behaviour is a property of gcc's `-O0` frame layout, not of","+/// the C source, so there is no byte-identical translation to write: the Rust","+/// keeps the writes inside a padded buffer and lets the loop finish.  What IS","+/// well defined, and what this test asserts, is that **neither implementation","+/// ever reports success** for these inputs.","+const UB_LENS_OVERRUN: &[(usize, c_int, &str)] = &[","+    (1, 28, \"e57abaac341937e6a82af2e5fc583014b227c6782a33a33868b8e4a4\"),","+    (1, 17, \"adc98af8847609d4052e42cb691cc96be3\"),","+    (3, 24, \"ad9a107e7a31c408fbd4a91fc38be1f11d99eadb05590793\"),","+    (0, 20, \"bdd858d1849db44eb702b7b99e9acbdb53c9d5ab\"),","+    (3, 24, \"a519fb60454debc10e25411ca6866e0ed69f94bf0c00bc01\"),","+    (0, 25, \"cd156f4549e88ad59c8e3945e6570e48b7c517595e3cbf0727\"),","+    (1, 29, \"6d50568580259e7ae086bacdb9e41e8ce77e66ee00ea57dedeb60485b7\"),","+];","+","+#[test]","+fn ub_cp_dynamic_lens_overrun() {","+    let specs: Vec<Spec> = UB_LENS_OVERRUN","+        .iter()","+        .map(|&(off, nb, hx)| {","+            let mut sp = ispec(unhex(hx), off, 65536, 0x0BAD);","+            if let Spec::Inflate { in_bytes, .. } = &mut sp {","+                *in_bytes = nb;","+            }","+            sp","+        })","+        .collect();","+","+    let c = run_batch(&c_so_path(), &specs, CHILD);","+    let r = run_batch(&rust_so_path(), &specs, CHILD);","+","+    for i in 0..specs.len() {","+        // The C must not report success (it hangs or dies).","+        let c_ok = matches!(c[i], Outcome::Returned { ret: 1, .. });","+        let r_ok = matches!(r[i], Outcome::Returned { ret: 1, .. });","+        assert!(","+            !c_ok,","+            \"spec #{i}: the C unexpectedly succeeded — re-check whether this \\","+             input really reaches the lens[] overrun ({:?})\",","+            c[i]","+        );","+        assert!(","+            !r_ok,","+            \"spec #{i}: the Rust unexpectedly succeeded ({:?})\",","+            r[i]","+        );","+        eprintln!(\"UB-overrun #{i}: C={:?} Rust={:?}\", c[i], r[i]);","+    }","+}","+","+// ---------------------------------------------------------------------------","+"," fn report(label: &str, out: &[Outcome]) {","     let mut ok = 0usize;","     let mut err = 0usize;"]},{"oldStart":240,"oldLines":8,"newStart":528,"newLines":8,"lines":["         out.len()","     );","     assert!(","-        ok + err > 0 && !sigs.is_empty(),","-        \"{label}: the corpus must contain both returning and fatal cases \\","+        err > 0 && !sigs.is_empty(),","+        \"{label}: the corpus must contain both rejected and fatal cases \\","          (ok={ok} err={err} sigs={sigs:?})\"","     );"," }"]}],"originalFile":"//! Phase B/C — CONFIGS.md rows X5 and X6: property-style differential fuzzing\n//! of `cp_inflate` with a fixed seed.\n//!\n//! Every case is run against BOTH `.so`s in a forked subprocess, so the\n//! comparison covers\n//!   * the return value,\n//!   * the exact `cp_error_reason` string,\n//!   * a hash of the WHOLE 256 KiB output arena (catching out-of-bounds writes),\n//!   * a hash of the WHOLE input arena (neither may modify its input), and\n//!   * the fatal signal (SIGABRT from a failed `assert()`, SIGSEGV, ...) when\n//!     the case kills the process.\n//!\n//! Both implementations always get an arena at the same alignment mod 4 filled\n//! with the same pseudo-random bytes, which is what makes the C's numerous\n//! out-of-bounds reads deterministic and therefore comparable.\n\nmod common;\n\nuse common::deflate::*;\nuse common::subproc::*;\nuse common::*;\nuse std::os::raw::c_int;\n\nconst CHILD: &str = \"child_entry\";\n\nfn ispec(input: Vec<u8>, in_off: usize, out_bytes: c_int, seed: u64) -> Spec {\n    let n = input.len() as c_int;\n    Spec::Inflate {\n        input,\n        in_off,\n        in_bytes: n,\n        out_bytes,\n        out_off: 0,\n        null_in: false,\n        null_out: false,\n        seed,\n        arena: ARENA,\n    }\n}\n\n/// X5 — short pseudo-random byte strings at every alignment.\n///\n/// Short inputs are the sweet spot: they reach the bit-reader's end-of-stream\n/// asserts, `cp_stored`'s checks and `cp_decode`'s no-prefix assert without\n/// ever getting far enough into `cp_dynamic` to overrun its `lens[288+32]`\n/// stack array (which is genuine UB in the C — see CONFIGS.md).\n#[test]\nfn x5_random_short_inputs() {\n    let mut rng = SplitMix::new(0x0F0225);\n    let mut specs = Vec::new();\n    for i in 0..3000 {\n        let n = 2 + rng.below(23) as usize; // 2..=24 bytes\n        let input = rng.bytes(n);\n        let in_off = (i % 4) as usize;\n        let out_bytes = match rng.below(6) {\n            0 => 0,\n            1 => 1,\n            2 => 4,\n            3 => 64,\n            4 => 4096,\n            _ => 65536,\n        };\n        specs.push(ispec(input, in_off, out_bytes, rng.next_u64()));\n    }\n    let out = assert_batch_eq(&specs, CHILD, \"X5\");\n    report(\"X5\", &out);\n}\n\n/// X5 (continued) — the same, but with a biased generator that produces valid\n/// block headers far more often, so more of the decoder is reached.\n#[test]\nfn x5_biased_short_inputs() {\n    let mut rng = SplitMix::new(0xB1A5ED);\n    let mut specs = Vec::new();\n    for i in 0..3000 {\n        let n = 3 + rng.below(30) as usize;\n        let mut input = rng.bytes(n);\n        // Force BFINAL=1 and a non-reserved BTYPE in the first byte.\n        let btype = rng.below(3) as u8; // 0, 1 or 2\n        input[0] = (input[0] & 0xF8) | 1 | (btype << 1);\n        let in_off = (i % 4) as usize;\n        let out_bytes = if rng.below(2) == 0 { 4096 } else { 65536 };\n        specs.push(ispec(input, in_off, out_bytes, rng.next_u64()));\n    }\n    let out = assert_batch_eq(&specs, CHILD, \"X5b\");\n    report(\"X5b\", &out);\n}\n\n/// X6 — bit-flipped mutations of VALID streams (1..=3 flipped bits).\n///\n/// Mutating a valid stream keeps the decoder deep inside `cp_block` /\n/// `cp_dynamic` for much longer than random bytes do, which is where the\n/// interesting divergences would live.\n#[test]\nfn x6_bitflipped_valid_streams() {\n    use flate2::write::DeflateEncoder;\n    use flate2::Compression;\n    use std::io::Write;\n\n    let mut rng = SplitMix::new(0xF11F11);\n\n    // A pool of valid streams of every block type.\n    let mut pool: Vec<(String, Vec<u8>, i64)> = Vec::new();\n    pool.push((\"stored0\".into(), stored_ok(true, &[]), 0));\n    pool.push((\"stored12\".into(), stored_ok(true, &rng.bytes(12)), 12));\n    pool.push((\"fixed-empty\".into(), fixed_only(true, &[]), 0));\n    {\n        let items: Vec<Item> = rng.bytes(12).into_iter().map(Item::Lit).collect();\n        let n = out_size(&items);\n        pool.push((\"fixed-lits\".into(), fixed_only(true, &items), n));\n    }\n    {\n        let items = vec![Item::Lit(b'a'), match_item(60, 1), Item::Lit(b'b')];\n        let n = out_size(&items);\n        pool.push((\"fixed-match\".into(), fixed_only(true, &items), n));\n    }\n    {\n        let lens = lens_for(257, 1, &[b'a' as usize, b'b' as usize, 256], &[0]);\n        let d = dynamic_from_lens(257, 1, &lens);\n        let items: Vec<Item> = (0..10)\n            .map(|i| Item::Lit(if i % 3 == 0 { b'a' } else { b'b' }))\n            .collect();\n        let n = out_size(&items);\n        pool.push((\"dynamic\".into(), d.only(true, &items), n));\n    }\n    {\n        let d = dynamic_full();\n        let items = vec![\n            Item::Lit(1),\n            Item::Lit(200),\n            match_item(20, 2),\n            Item::Lit(255),\n        ];\n        let n = out_size(&items);\n        pool.push((\"dynamic-full\".into(), d.only(true, &items), n));\n    }\n    for level in [1u32, 6, 9] {\n        let data: Vec<u8> = (0..40).map(|_| b'a' + rng.below(5) as u8).collect();\n        let mut e = DeflateEncoder::new(Vec::new(), Compression::new(level));\n        e.write_all(&data).unwrap();\n        pool.push((format!(\"flate2-{level}\"), e.finish().unwrap(), 40));\n    }\n\n    // Every stream in the pool must itself decode identically first.\n    let base_specs: Vec<Spec> = pool\n        .iter()\n        .flat_map(|(_, s, n)| {\n            (0..4usize).map(move |off| ispec(s.clone(), off, *n as c_int + 64, 0x515E))\n        })\n        .collect();\n    let base = assert_batch_eq(&base_specs, CHILD, \"X6 base\");\n    for (i, o) in base.iter().enumerate() {\n        match o {\n            Outcome::Returned { ret, .. } => {\n                assert_eq!(*ret, 1, \"X6 base spec #{i} did not decode: {o:?}\")\n            }\n            other => panic!(\"X6 base spec #{i} was fatal: {other:?}\"),\n        }\n    }\n\n    // Now the mutations.\n    let mut specs = Vec::new();\n    for (_, stream, n) in &pool {\n        let bits = stream.len() * 8;\n        if bits == 0 {\n            continue;\n        }\n        for _ in 0..320 {\n            let mut m = stream.clone();\n            let nflips = 1 + rng.below(3) as usize;\n            for _ in 0..nflips {\n                let b = rng.below(bits as u32) as usize;\n                m[b / 8] ^= 1 << (b % 8);\n            }\n            let in_off = rng.below(4) as usize;\n            let out_bytes = match rng.below(4) {\n                0 => *n as c_int,\n                1 => *n as c_int + 64,\n                2 => 4096,\n                _ => 65536,\n            };\n            specs.push(ispec(m, in_off, out_bytes, rng.next_u64()));\n        }\n    }\n    let out = assert_batch_eq(&specs, CHILD, \"X6\");\n    report(\"X6\", &out);\n}\n\n/// X6 (continued) — truncations and single-byte substitutions of valid streams,\n/// plus `in_bytes` lying about the buffer length in both directions.\n#[test]\nfn x6_length_and_byte_mutations() {\n    let mut rng = SplitMix::new(0x1E17A);\n    let items: Vec<Item> = (0..14).map(|i| Item::Lit(0x61 + i as u8)).collect();\n    let base_fixed = fixed_only(true, &items);\n    let base_stored = stored_ok(true, &rng.bytes(14));\n    let lens = lens_for(257, 1, &[b'a' as usize, b'b' as usize, 256], &[0]);\n    let d = dynamic_from_lens(257, 1, &lens);\n    let base_dyn = d.only(true, &[Item::Lit(b'a'), Item::Lit(b'b'), Item::Lit(b'a')]);\n\n    let mut specs = Vec::new();\n    for base in [&base_fixed, &base_stored, &base_dyn] {\n        // single-byte substitutions\n        for pos in 0..base.len() {\n            for v in [0x00u8, 0x01, 0x7F, 0x80, 0xFE, 0xFF] {\n                let mut m = base.clone();\n                m[pos] = v;\n                specs.push(ispec(m, (pos % 4) as usize, 4096, rng.next_u64()));\n            }\n        }\n        // `in_bytes` lying in both directions\n        for delta in -(base.len() as i32)..=8 {\n            let n = base.len() as i32 + delta;\n            let mut sp = ispec(base.clone(), 3, 4096, rng.next_u64());\n            if let Spec::Inflate { in_bytes, .. } = &mut sp {\n                *in_bytes = n;\n            }\n            specs.push(sp);\n        }\n    }\n    assert!(specs.len() > 200, \"only {} specs\", specs.len());\n    let out = assert_batch_eq(&specs, CHILD, \"X6len\");\n    report(\"X6len\", &out);\n}\n\nfn report(label: &str, out: &[Outcome]) {\n    let mut ok = 0usize;\n    let mut err = 0usize;\n    let mut sigs = std::collections::BTreeMap::<i32, usize>::new();\n    for o in out {\n        match o {\n            Outcome::Returned { ret: 1, .. } => ok += 1,\n            Outcome::Returned { .. } => err += 1,\n            Outcome::Signal(s) => *sigs.entry(*s).or_default() += 1,\n            Outcome::ExitCode(c) => *sigs.entry(-c).or_default() += 1,\n        }\n    }\n    eprintln!(\n        \"{label}: {} cases -> {ok} succeeded, {err} rejected, signals {sigs:?}\",\n        out.len()\n    );\n    assert!(\n        ok + err > 0 && !sigs.is_empty(),\n        \"{label}: the corpus must contain both returning and fatal cases \\\n         (ok={ok} err={err} sigs={sigs:?})\"\n    );\n}\n\n/// Child process entry point (a no-op in a normal test run).\n#[test]\nfn child_entry() {\n    common::subproc::child_entry();\n}\n","userModified":false}}
