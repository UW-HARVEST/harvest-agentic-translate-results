s[s], lit_lens[s] as u32);\n    }\n    w.huff(lit_codes[256], lit_lens[256] as u32);\n    let stream = w.finish();\n\n    let case = InflateCase::new(stream, 4);\n    let got = with_patched(&c, &r, b\"cp_permutation_order\", 19, &perm, || {\n        diff_locked(&c, &r, &case, \"patched cp_permutation_order\")\n    });\n    assert_eq!(got.ret, 1, \"patched permutation should decode: {got:?}\");\n    assert_eq!(&got.out_arena[..4], b\"abab\");\n}\n\n/// `cp_len_base` / `cp_len_extra_bits` / `cp_dist_base` / `cp_dist_extra_bits`\n/// are read by `cp_block`.  Patch each in turn and check both libraries produce\n/// the same (now different) output.\n#[test]\nfn patched_length_and_distance_tables_change_inflate() {\n    let _g = lock_globals();\n    let (c, r) = load_both();\n\n    // \"aaaa...\" via one literal + a distance-1 match with length symbol 257.\n    let items = vec![\n        Item::Lit(b'a'),\n        Item::Match {\n            len_sym: 257,\n            len_extra: 0,\n            dist_sym: 0,\n            dist_extra: 0,\n        },\n    ];\n    let stream = fixed_only(true, &items);\n\n    // Baseline: cp_len_base[0] == 3, so the output is 1 + 3 == 4 bytes.\n    let base_case = InflateCase::new(stream.clone(), 4);\n    let base = diff_locked(&c, &r, &base_case, \"len tables baseline\");\n    assert_eq!(base.ret, 1);\n    assert_eq!(&base.out_arena[..4], b\"aaaa\");\n\n    // Patch cp_len_base[0] from 3 to 9 -> the same stream now emits 10 bytes.\n    let mut lb: Vec<u8> = LEN_BASE.iter().flat_map(|v| v.to_ne_bytes()).collect();\n    lb[..4].copy_from_slice(&9u32.to_ne_bytes());\n    let case = InflateCase::new(stream.clone(), 10);\n    let got = with_patched(&c, &r, b\"cp_len_base\", 124, &lb, || {\n        diff_locked(&c, &r, &case, \"patched cp_len_base\")\n    });\n    assert_eq!(got.ret, 1, \"patched cp_len_base: {got:?}\");\n    assert_eq!(\n        &got.out_arena[..10],\n        b\"aaaaaaaaaa\",\n        \"patched cp_len_base was not honoured\"\n    );\n    // ... and with out_bytes for the OLD length it must now fail with E5.\n    let short = InflateCase::new(stream.clone(), 4);\n    let got = with_patched(&c, &r, b\"cp_len_base\", 124, &lb, || {\n        diff_locked(&c, &r, &short, \"patched cp_len_base short out\")\n    });\n    assert_eq!(got.ret, 0, \"patched cp_len_base should overflow out: {got:?}\");\n\n    // Patch cp_len_extra_bits[0] from 0 to 3: three extra bits are now consumed\n    // for length symbol 257, changing both the length and the bit alignment.\n    let mut le: Vec<u8> = LEN_EXTRA.to_vec();\n    le[0] = 3;\n    let case = InflateCase::new(stream.clone(), 4096);\n    with_patched(&c, &r, b\"cp_len_extra_bits\", 31, &le, || {\n        diff_locked(&c, &r, &case, \"patched cp_len_extra_bits\")\n    });\n\n    // Patch cp_dist_base[0] from 1 to 0: `out - 0 >= begin` still passes, but\n    // the copy source becomes `out` itself.\n    let mut db: Vec<u8> = DIST_BASE.iter().flat_map(|v| v.to_ne_bytes()).collect();\n    db[..4].copy_from_slice(&0u32.to_ne_bytes());\n    let case = InflateCase::new(stream.clone(), 4);\n    with_patched(&c, &r, b\"cp_dist_base\", 128, &db, || {\n        diff_locked(&c, &r, &case, \"patched cp_dist_base\")\n    });\n\n    // Patch cp_dist_extra_bits[0] from 0 to 5.\n    let mut de: Vec<u8> = DIST_EXTRA.to_vec();\n    de[0] = 5;\n    let case = InflateCase::new(stream, 4096);\n    with_patched(&c, &r, b\"cp_dist_extra_bits\", 32, &de, || {\n        diff_locked(&c, &r, &case, \"patched cp_dist_extra_bits\")\n    });\n}\n\n/// A randomized sweep: patch each table with random bytes and compare.  Values\n/// are kept inside the ranges the C can survive (`cp_fixed_table` lengths\n/// 0..15, extra-bit counts 0..16, bases 0..4096) so the comparison stays on\n/// defined behaviour.\n#[test]\nfn patched_tables_randomized() {\n    let _g = lock_globals();\n    let (c, r) = load_both();\n    let mut rng = SplitMix::new(0x7AB1E5);\n\n    let items = vec![\n        Item::Lit(b'z'),\n        Item::Lit(b'y'),\n        Item::Match {\n            len_sym: 260,\n            len_extra: 0,\n            dist_sym: 1,\n            dist_extra: 0,\n        },\n    ];\n    let stream = fixed_only(true, &items);\n\n    for i in 0..120 {\n        let case = InflateCase::new(stream.clone(), 4096).seed(rng.next_u64());\n        // extra-bit tables: 0..=13 keeps cp_read_bits' asserts satisfied.\n        let le: Vec<u8> = (0..31).map(|_| rng.below(14) as u8).collect();\n        let de: Vec<u8> = (0..32).map(|_| rng.below(14) as u8).collect();\n        // base tables: small so `out + length <= out_end` can still hold.\n        let lb: Vec<u8> = (0..31)\n            .flat_map(|_| rng.below(64).to_ne_bytes())\n            .collect();\n        let db: Vec<u8> = (0..32).flat_map(|_| rng.below(3).to_ne_bytes()).collect();\n\n        with_patched(&c, &r, b\"cp_len_extra_bits\", 31, &le, || {\n            with_patched(&c, &r, b\"cp_dist_extra_bits\", 32, &de, || {\n                with_patched(&c, &r, b\"cp_len_base\", 124, &lb, || {\n                    with_patched(&c, &r, b\"cp_dist_base\", 128, &db, || {\n                        diff_locked(&c, &r, &case, &format!(\"patched-random #{i}\"));\n                    })\n                })\n            })\n        });\n    }\n\n    // cp_fixed_table: random code lengths 0..9 with 256 always present, so the\n    // stream still terminates.\n    for i in 0..60 {\n        let mut table = vec![0u8; 320];\n        let l = 1 + rng.below(3) as u8;\n        for s in [b'z' as usize, b'y' as usize, 256] {\n            table[s] = l;\n        }\n        table[288] = 1;\n        table[289] = 1;\n        let lit_lens = table[..288].to_vec();\n        let lit_codes = canonical(&lit_lens);\n        let mut w = BitWriter::new();\n        w.bits(1, 1);\n        w.bits(1, 2);\n        for _ in 0..(1 + rng.below(8)) {\n            let s = if rng.below(2) == 0 { b'z' } else { b'y' } as usize;\n            w.huff(lit_codes[s], lit_lens[s] as u32);\n        }\n        w.huff(lit_codes[256], lit_lens[256] as u32);\n        let stream = w.finish();\n        let case = InflateCase::new(stream, 4096).seed(rng.next_u64());\n        let got = with_patched(&c, &r, b\"cp_fixed_table\", 320, &table, || {\n            diff_locked(&c, &r, &case, &format!(\"patched-fixed-random #{i}\"))\n        });\n        assert_eq!(got.ret, 1, \"patched-fixed-random #{i}: {got:?}\");\n    }\n}\n\n/// The same for a stored block: it reads none of the tables, so patching them\n/// must be a no-op — a control for the tests above.\n#[test]\nfn patched_tables_do_not_affect_stored_blocks() {\n    let _g = lock_globals();\n    let (c, r) = load_both();\n    let payload = b\"0123456789abcdef\";\n    let stream = stored_ok(true, payload);\n    let case = InflateCase::new(stream, payload.len() as c_int);\n    let before = diff_locked(&c, &r, &case, \"stored control before\");\n    let junk: Vec<u8> = (0..124).map(|i| (i as u8) | 1).collect();\n    let after = with_patched(&c, &r, b\"cp_len_base\", 124, &junk, || {\n        diff_locked(&c, &r, &case, \"stored control patched\")\n    });\n    assert_eq!(before.ret, 1);\n    assert_eq!(after.ret, 1);\n    assert_eq!(before.out_arena, after.out_arena);\n}\nRSEOF\ntimeout 300 cargo test --offline --test data_symbols 2>&1 | tail -30","description":"Add mutable-table tests","timeout":400000}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4732,"cache_read_input_tokens":409131,"cache_creation":{"ephemeral_5m_input_tokens":4732,"ephemeral_1h_input_tokens":0},"output_tokens":7,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"1f391add-adf5-472a-b38e-02e2e663f9ae","uuid":"7050f0df-126c-4e48-abcc-900c1dddc6e7","timestamp":"2026-08-20T10:23:56.146Z"}
