mat!(\"S1 out={out_bytes} off={off}\"), 8192);\n        }\n    }\n}\n\n/// S2 — one final stored block per size, `out_bytes` exactly `LEN`.\n#[test]\nfn s2_sizes_exact_out() {\n    let (c, r) = load_both();\n    let mut rng = SplitMix::new(0x5202);\n    for &len in LENS {\n        for rep in 0..3 {\n            let p = payload(&mut rng, len);\n            let stream = stored_ok(true, &p);\n            let case = InflateCase::new(stream, len as c_int);\n            assert_inflate_eq_arena(&c, &r, &case, &format!(\"S2 len={len} rep={rep}\"), 16 * 1024);\n        }\n    }\n}\n\n/// S3 — same, but `out_bytes` larger than `LEN` (so nothing can be clipped).\n#[test]\nfn s3_sizes_large_out() {\n    let (c, r) = load_both();\n    let mut rng = SplitMix::new(0x5303);\n    for &len in LENS {\n        for extra in [1i32, 7, 64, 8000] {\n            let p = payload(&mut rng, len);\n            let stream = stored_ok(true, &p);\n            let case = InflateCase::new(stream, len as c_int + extra);\n            assert_inflate_eq_arena(\n                &c,\n                &r,\n                &case,\n                &format!(\"S3 len={len} extra={extra}\"),\n                16 * 1024,\n            );\n        }\n    }\n}\n\n/// S4 — alignment sweep: `first_bytes` takes all four values, which changes\n/// `s->words`, `s->word_count`, the pre-seeded `s->bits` and `s->count`.\n#[test]\nfn s4_alignment_sweep() {\n    let (c, r) = load_both();\n    let mut rng = SplitMix::new(0x5404);\n    for &len in LENS {\n        for off in 0..4usize {\n            let p = payload(&mut rng, len);\n            let stream = stored_ok(true, &p);\n            let case = InflateCase::new(stream, len as c_int).in_off(off);\n            assert_inflate_eq_arena(\n                &c,\n                &r,\n                &case,\n                &format!(\"S4 len={len} off={off}\"),\n                16 * 1024,\n            );\n        }\n    }\n}\n\n/// S5 — tail sweep: `last_bytes = (in_bytes - first_bytes) & 3` takes all four\n/// values, exercising `final_word_available` and the `count += bits_left` arm\n/// of `cp_peak_bits`.  `in_bytes == 5 + LEN`, so `LEN % 4` walks the tail.\n#[test]\nfn s5_tail_sweep() {\n    let (c, r) = load_both();\n    let mut rng = SplitMix::new(0x5505);\n    for base in [0usize, 4, 8, 12, 100, 1000] {\n        for d in 0..4usize {\n            let len = base + d;\n            for off in 0..4usize {\n                let p = payload(&mut rng, len);\n                let stream = stored_ok(true, &p);\n                // last_bytes == (5 + len - off%4) & 3 : all four values occur\n                let case = InflateCase::new(stream, len as c_int).in_off(off);\n                assert_inflate_eq_arena(\n                    &c,\n                    &r,\n                    &case,\n                    &format!(\"S5 len={len} off={off}\"),\n                    16 * 1024,\n                );\n            }\n        }\n    }\n}\n\n/// S6 — `word_count == 0`: total input minus `first_bytes` is under 4 bytes, so\n/// `cp_peak_bits` can only ever take the `final_word` arm.\n#[test]\nfn s6_word_count_zero() {\n    let (c, r) = load_both();\n    // in_bytes = 5 + LEN, so LEN=0 with in_off=3 gives (5-3)... use raw\n    // in_bytes overrides to reach every (first_bytes, avail) pair under 4.\n    let stream = stored_ok(true, &[]);\n    for off in 0..4usize {\n        for in_bytes in 1i32..=8 {\n            let case = InflateCase::new(stream.clone(), 8).in_off(off).in_bytes(in_bytes);\n            // May abort for the truncated variants: those are covered by\n            // tests/aborts.rs; here we only run the ones that return.\n            if in_bytes >= 5 {\n                assert_inflate_eq_arena(\n                    &c,\n                    &r,\n                    &case,\n                    &format!(\"S6 off={off} in_bytes={in_bytes}\"),\n                    8192,\n                );\n            }\n        }\n    }\n}\n\n/// S7 — the maximum 16-bit