{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_yyp3rt4qaxx5kkjcysxmlfpjvirt6lwedsgrwynt6x773higt5iq","type":"message","role":"assistant","content":[{"type":"text","text":"Now the fixed-Huffman tests (F1–F10):"}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7587,"cache_read_input_tokens":181120,"cache_creation":{"ephemeral_5m_input_tokens":7587,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"1f391add-adf5-472a-b38e-02e2e663f9ae","uuid":"bf63f36f-20b2-4afc-9a49-ffebbe7af5f5","timestamp":"2026-08-20T08:14:06.812Z"}
{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_yyp3rt4qaxx5kkjcysxmlfpjvirt6lwedsgrwynt6x773higt5iq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01Md4B6voBPdg4MHmYqBktvL","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-AesDK8/translated_rust/tests/inflate_fixed.rs","content":"//! Phase B — CONFIGS.md rows F1..F10 (BTYPE 1, fixed Huffman blocks).\n//!\n//! Drives `cp_fixed`, `cp_build` (both the `s != NULL` lookup-filling call and\n//! the `s == NULL` call), `cp_decode` (literal tree AND distance tree) and\n//! `cp_block` (literal path, `memset` distance-1 fast path and the byte-by-byte\n//! overlapping-copy path) through the exported `cp_inflate`.\n\nmod common;\n\nuse common::deflate::*;\nuse common::*;\nuse std::os::raw::c_int;\n\n/// Run one item list as a single final fixed block and compare both `.so`s.\n/// Also cross-checks the decoded bytes against an independent simulation when\n/// the item list is simulatable.\n#[track_caller]\nfn check_fixed(c: &Impl, r: &Impl, items: &[Item], label: &str, arena: usize) {\n    let n = out_size(items);\n    assert!(n >= 0);\n    let stream = fixed_only(true, items);\n    for off in 0..4usize {\n        let case = InflateCase::new(stream.clone(), n as c_int).in_off(off);\n        assert_inflate_eq_arena(c, r, &case, &format!(\"{label} off={off}\"), arena);\n    }\n    // Reference cross-check (aligned case).\n    if let Some(expect) = simulate(items) {\n        let case = InflateCase::new(stream, n as c_int);\n        let rc = run_inflate(c, &case, arena);\n        assert_eq!(rc.ret, 1, \"[{label}] C returned {} : {rc:?}\", rc.ret);\n        assert_eq!(\n            &rc.out_arena[..expect.len()],\n            &expect[..],\n            \"[{label}] C output disagrees with the reference model\"\n        );\n    }\n}\n\n// ---------------------------------------------------------------------------\n// F1 — end-of-block only (empty output)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn f1_empty_fixed_block() {\n    let (c, r) = load_both();\n    let stream = fixed_only(true, &[]);\n    assert_eq!(stream.len(), 2, \"expected a 2-byte stream, got {stream:?}\");\n    for out_bytes in [0i32, 1, 8, 4096] {\n        for off in 0..4usize {\n            let case = InflateCase::new(stream.clone(), out_bytes).in_off(off);\n            assert_inflate_eq_arena(\n                &c,\n                &r,\n                &case,\n                &format!(\"F1 out={out_bytes} off={off}\"),\n                8192,\n            );\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// F2 — literals only, from BOTH fixed-table length classes\n// ---------------------------------------------------------------------------\n\n#[test]\nfn f2_literals_both_length_classes() {\n    let (c, r) = load_both();\n\n    // All 256 literal values, in order: covers symbols 0..143 (8-bit codes)\n    // and 144..255 (9-bit codes).\n    let all: Vec<Item> = (0u16..256).map(|v| Item::Lit(v as u8)).collect();\n    check_fixed(&c, &r, &all, \"F2 all-256\", 16 * 1024);\n\n    // Only 8-bit-code literals, only 9-bit-code literals.\n    let low: Vec<Item> = (0u16..144).map(|v| Item::Lit(v as u8)).collect();\n    check_fixed(&c, &r, &low, \"F2 low-144\", 16 * 1024);\n    let high: Vec<Item> = (144u16..256).map(|v| Item::Lit(v as u8)).collect();\n    check_fixed(&c, &r, &high, \"F2 high-112\", 16 * 1024);\n\n    // Every single-literal stream (1 byte of output), so the very first\n    // `cp_decode` on a fresh tree is exercised for every symbol.\n    for v in 0u16..256 {\n        check_fixed(&c, &r, &[Item::Lit(v as u8)], &format!(\"F2 single {v}\"), 8192);\n    }\n\n    // Short random literal runs.\n    let mut rng = SplitMix::new(0xF202);\n    for i in 0..200 {\n        let n = 1 + rng.below(40) as usize;\n        let items: Vec<Item> = rng.bytes(n).into_iter().map(Item::Lit).collect();\n        check_fixed(&c, &r, &items, &format!(\"F2 rand#{i} n={n}\"), 8192);\n    }\n}\n\n// ---------------------------------------------------------------------------\n// F3 — every length symbol 257..285 at distance 1 (the `memset` fast path)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn f3_all_length_symbols_distance1() {\n    let (c, r) = load_both();\n    for len_sym in 257..=285usize {\n        let nextra = LEN_EXTRA[len_sym - 257] as u32;\n        let max_extra = (1u32 << nextra) - 1;\n        for len_extra in [0u32, max_extra / 2, max_extra] {\n            let items = vec![\n                Item::Lit(0xA5),\n                Item::Match {\n                    len_sym,\n                    len_extra,\n                    dist_sym: 0, // dist_base[0] == 1\n                    dist_extra: 0,\n                },\n            ];\n            check_fixed(\n                &c,\n                &r,\n                &items,\n                &format!(\"F3 len_sym={len_sym} extra={len_extra}\"),\n                8192,\n            );\n        }\n    }\n    // All of them in one stream (so the same `cp_state_t` walks the whole\n    // length table without a table rebuild in between).\n    let mut items = vec![Item::Lit(0x11)];\n    for len_sym in 257..=285usize {\n        let nextra = LEN_EXTRA[len_sym - 257] as u32;\n        items.push(Item::Match {\n            len_sym,\n            len_extra: (1u32 << nextra) - 1,\n            dist_sym: 0,\n            dist_extra: 0,\n        });\n        items.push(Item::Lit((len_sym & 0xFF) as u8));\n    }\n    check_fixed(&c, &r, &items, \"F3 combined\", 32 * 1024);\n}\n\n// ---------------------------------------------------------------------------\n// F4 — every length symbol at distance 2..: the overlapping byte-copy path\n// ---------------------------------------------------------------------------\n\n#[test]\nfn f4_all_length_symbols_overlapping_copy() {\n    let (c, r) = load_both();\n    for len_sym in 257..=285usize {\n        let nextra = LEN_EXTRA[len_sym - 257] as u32;\n        for len_extra in [0u32, (1u32 << nextra) - 1] {\n            for dist in [2u32, 3, 4, 5, 7, 16] {\n                // Enough preceding output for the back-reference.\n                let mut items: Vec<Item> =\n                    (0..dist as u8).map(|i| Item::Lit(0x40 + i)).collect();\n                let (dist_sym, dist_extra) = dist_code(dist);\n                items.push(Item::Match {\n                    len_sym,\n                    len_extra,\n                    dist_sym,\n                    dist_extra,\n                });\n                check_fixed(\n                    &c,\n                    &r,\n                    &items,\n                    &format!(\"F4 len_sym={len_sym} extra={len_extra} dist={dist}\"),\n                    8192,\n                );\n            }\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// F5 — every distance symbol 0..29 with every extra-bits extreme\n// ---------------------------------------------------------------------------\n\n#[test]\nfn f5_all_distance_symbols() {\n    let (c, r) = load_both();\n    for dist_sym in 0..30usize {\n        let nextra = DIST_EXTRA[dist_sym] as u32;\n        let max_extra = (1u32 << nextra) - 1;\n        for dist_extra in [0u32, max_extra / 2, max_extra] {\n            let dist = DIST_BASE[dist_sym] + dist_extra;\n            // Build exactly `dist` bytes of output cheaply, then copy back.\n            let mut items = fill_items(dist as usize, 0x5A);\n            items.push(Item::Match {\n                len_sym: 260, // len_base[3] == 6, no extra bits\n                len_extra: 0,\n                dist_sym,\n                dist_extra,\n            });\n            let arena = if dist > 60 * 1024 { ARENA } else { 128 * 1024 };\n            check_fixed(\n                &c,\n                &r,\n                &items,\n                &format!(\"F5 dist_sym={dist_sym} extra={dist_extra} dist={dist}\"),\n                arena,\n            );\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// F6 — length symbols 286 and 287 (`cp_len_base` == 0 → zero-length copy)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn f6_length_symbols_286_287() {\n    let (c, r) = load_both();\n    for len_sym in [286usize, 287] {\n        assert_eq!(LEN_BASE[len_sym - 257], 0);\n        assert_eq!(LEN_EXTRA[len_sym - 257], 0);\n        for dist in [1u32, 2, 3, 8] {\n            let mut items: Vec<Item> = (0..dist as u8).map(|i| Item::Lit(0x60 + i)).collect();\n            let (dist_sym, dist_extra) = dist_code(dist);\n            items.push(Item::Match {\n                len_sym,\n                len_extra: 0,\n                dist_sym,\n                dist_extra,\n            });\n            items.push(Item::Lit(0xEE));\n            check_fixed(\n                &c,\n                &r,\n                &items,\n                &format!(\"F6 len_sym={len_sym} dist={dist}\"),\n                8192,\n            );\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// F7 — distance symbols 30 and 31 (`cp_dist_base` == 0 → distance 0)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn f7_distance_symbols_30_31() {\n    let (c, r) = load_both();\n    for dist_sym in [30usize, 31] {\n        assert_eq!(DIST_BASE[dist_sym], 0);\n        assert_eq!(DIST_EXTRA[dist_sym], 0);\n        for len_sym in [257usize, 260, 264, 270, 280, 285] {\n            let nextra = LEN_EXTRA[len_sym - 257] as u32;\n            let items = vec![\n                Item::Lit(0x7F),\n                Item::Lit(0x80),\n                Item::Match {\n                    len_sym,\n                    len_extra: (1u32 << nextra) - 1,\n                    dist_sym,\n                    dist_extra: 0,\n                },\n                Item::Lit(0x81),\n            ];\n            // `simulate` returns None for distance 0 (the result depends on the\n            // pre-existing arena bytes), so this row is purely differential —\n            // which is exactly the point: both must leave the arena identical.\n            check_fixed(\n                &c,\n                &r,\n                &items,\n                &format!(\"F7 dist_sym={dist_sym} len_sym={len_sym}\"),\n                8192,\n            );\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// F8 — real-encoder streams (flate2 raw deflate)\n// ---------------------------------------------------------------------------\n\nfn deflate_raw(data: &[u8], level: u32) -> Vec<u8> {\n    use flate2::write::DeflateEncoder;\n    use flate2::Compression;\n    use std::io::Write;\n    let mut e = DeflateEncoder::new(Vec::new(), Compression::new(level));\n    e.write_all(data).unwrap();\n    e.finish().unwrap()\n}\n\n/// Payload shapes chosen so the encoder produces literals, short matches, long\n/// matches, distance-1 runs and long-distance matches.\nfn payloads(rng: &mut SplitMix) -> Vec<(String, Vec<u8>)> {\n    let mut v: Vec<(String, Vec<u8>)> = Vec::new();\n    v.push((\"empty\".into(), vec![]));\n    v.push((\"one\".into(), vec![0x42]));\n    v.push((\"run256\".into(), vec![0x77; 256]));\n    v.push((\"run4096\".into(), vec![0x01; 4096]));\n    v.push((\n        \"alt\".into(),\n        (0..2000).map(|i| if i % 2 == 0 { b'a' } else { b'b' }).collect(),\n    ));\n    v.push((\"counting\".into(), (0..3000u32).map(|i| i as u8).collect()));\n    v.push((\n        \"repeat64\".into(),\n        (0..8192).map(|i| (i % 64) as u8).collect(),\n    ));\n    v.push((\n        \"text\".into(),\n        b\"the quick brown fox jumps over the lazy dog. \"\n            .iter()\n            .cycle()\n            .take(5000)\n            .cloned()\n            .collect(),\n    ));\n    for n in [1usize, 2, 3, 7, 15, 31, 63, 127, 255, 1023, 4095] {\n        v.push((format!(\"rand{n}\"), rng.bytes(n)));\n        v.push((\n            format!(\"lowent{n}\"),\n            (0..n).map(|_| b'a' + rng.below(3) as u8).collect(),\n        ));\n    }\n    v\n}\n\n#[test]\nfn f8_flate2_streams() {\n    let (c, r) = load_both();\n    let mut rng = SplitMix::new(0xF808);\n    for (name, data) in payloads(&mut rng) {\n        for level in [1u32, 2, 3] {\n            let stream = deflate_raw(&data, level);\n            let case = InflateCase::new(stream.clone(), data.len() as c_int);\n            assert_inflate_eq(&c, &r, &case, &format!(\"F8 {name} lvl={level}\"));\n            // Independent correctness cross-check.\n            let rc = run_inflate(&c, &case, ARENA);\n            if rc.ret == 1 && !data.is_empty() && data.len() > 3 {\n                assert_eq!(\n                    &rc.out_arena[..data.len()],\n                    &data[..],\n                    \"F8 {name} lvl={level}: C did not round-trip\"\n                );\n            }\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// F9 — alignment × tail sweep over the F2/F3/F8 payloads\n// ---------------------------------------------------------------------------\n\n#[test]\nfn f9_alignment_and_tail_sweep() {\n    let (c, r) = load_both();\n    let mut rng = SplitMix::new(0xF909);\n\n    let mut streams: Vec<(String, Vec<u8>, c_int)> = Vec::new();\n    // Literal runs of every length 1..40 => in_bytes takes all residues mod 4.\n    for n in 1..=40usize {\n        let items: Vec<Item> = (0..n).map(|i| Item::Lit((i as u8).wrapping_mul(11))).collect();\n        streams.push((format!(\"lits{n}\"), fixed_only(true, &items), n as c_int));\n    }\n    // Distance-1 runs of every length.\n    for len in 3..=40u32 {\n        let items = vec![Item::Lit(0x33), match_item(len, 1)];\n        streams.push((\n            format!(\"run{len}\"),\n            fixed_only(true, &items),\n            (1 + len) as c_int,\n        ));\n    }\n    // flate2 streams of assorted sizes.\n    for n in [1usize, 2, 5, 11, 23, 47, 101, 211] {\n        let data: Vec<u8> = (0..n).map(|_| b'a' + rng.below(5) as u8).collect();\n        for level in [1u32, 6] {\n            streams.push((\n                format!(\"f2_{n}_{level}\"),\n                deflate_raw(&data, level),\n                n as c_int,\n            ));\n        }\n    }\n\n    for (name, stream, out_bytes) in streams {\n        for off in 0..4usize {\n            let case = InflateCase::new(stream.clone(), out_bytes).in_off(off);\n            assert_inflate_eq_arena(&c, &r, &case, &format!(\"F9 {name} off={off}\"), 8192);\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// F10 — multiple blocks in one stream (BFINAL loop + table rebuild)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn f10_multi_block() {\n    let (c, r) = load_both();\n    let mut rng = SplitMix::new(0xF10A);\n\n    for nblocks in 1..=6usize {\n        for i in 0..6 {\n            let mut w = BitWriter::new();\n            let mut total = 0i64;\n            let mut all: Vec<Item> = Vec::new();\n            for b in 0..nblocks {\n                let n = 1 + rng.below(12) as usize;\n                let mut items: Vec<Item> = rng.bytes(n).into_iter().map(Item::Lit).collect();\n                if total + n as i64 > 4 && rng.below(2) == 0 {\n                    items.push(match_item(3 + rng.below(20), 1 + rng.below(4)));\n                }\n                total += out_size(&items);\n                all.extend(items.iter().cloned());\n                fixed_block(&mut w, b + 1 == nblocks, &items);\n            }\n            let stream = w.finish();\n            for off in 0..4usize {\n                let case = InflateCase::new(stream.clone(), total as c_int).in_off(off);\n                assert_inflate_eq_arena(\n                    &c,\n                    &r,\n                    &case,\n                    &format!(\"F10 nblocks={nblocks} #{i} off={off}\"),\n                    8192,\n                );\n            }\n            // Cross-check: the concatenation of all blocks' items.\n            if let Some(expect) = simulate(&all) {\n                let case = InflateCase::new(stream, total as c_int);\n                let rc = run_inflate(&c, &case, 8192);\n                assert_eq!(rc.ret, 1, \"F10 nblocks={nblocks} #{i}: C failed {rc:?}\");\n                assert_eq!(\n                    &rc.out_arena[..expect.len()],\n                    &expect[..],\n                    \"F10 nblocks={nblocks} #{i}: wrong bytes\"\n                );\n            }\n        }\n    }\n}\n\n/// F10 (continued) — stored, fixed and dynamic blocks mixed in one stream is\n/// covered by `tests/inflate_dynamic.rs::d12_mixed_block_types`.\n#[test]\nfn f10_note() {}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7587,"cache_read_input_tokens":181120,"cache_creation":{"ephemeral_5m_input_tokens":7587,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"1f391add-adf5-472a-b38e-02e2e663f9ae","uuid":"7c66c9a4-1535-4bfa-a9c4-1e46b300077d","timestamp":"2026-08-20T08:15:07.785Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Md4B6voBPdg4MHmYqBktvL","type":"tool_result","content":"File created successfully at: /local/home/scheschb/.harvest/work/harvest-work-AesDK8/translated_rust/tests/inflate_fixed.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"1f391add-adf5-472a-b38e-02e2e663f9ae","uuid":"2b29eb61-acb4-488b-97c1-6e1a9cf952f4","timestamp":"2026-08-20T08:15:07.795Z","tool_use_result":{"type":"create","filePath":"/local/home/scheschb/.harvest/work/harvest-work-AesDK8/translated_rust/tests/inflate_fixed.rs","content":"//! Phase B — CONFIGS.md rows F1..F10 (BTYPE 1, fixed Huffman blocks).\n//!\n//! Drives `cp_fixed`, `cp_build` (both the `s != NULL` lookup-filling call and\n//! the `s == NULL` call), `cp_decode` (literal tree AND distance tree) and\n//! `cp_block` (literal path, `memset` distance-1 fast path and the byte-by-byte\n//! overlapping-copy path) through the exported `cp_inflate`.\n\nmod common;\n\nuse common::deflate::*;\nuse common::*;\nuse std::os::raw::c_int;\n\n/// Run one item list as a single final fixed block and compare both `.so`s.\n/// Also cross-checks the decoded bytes against an independent simulation when\n/// the item list is simulatable.\n#[track_caller]\nfn check_fixed(c: &Impl, r: &Impl, items: &[Item], label: &str, arena: usize) {\n    let n = out_size(items);\n    assert!(n >= 0);\n    let stream = fixed_only(true, items);\n    for off in 0..4usize {\n        let case = InflateCase::new(stream.clone(), n as c_int).in_off(off);\n        assert_inflate_eq_arena(c, r, &case, &format!(\"{label} off={off}\"), arena);\n    }\n    // Reference cross-check (aligned case).\n    if let Some(expect) = simulate(items) {\n        let case = InflateCase::new(stream, n as c_int);\n        let rc = run_inflate(c, &case, arena);\n        assert_eq!(rc.ret, 1, \"[{label}] C returned {} : {rc:?}\", rc.ret);\n        assert_eq!(\n            &rc.out_arena[..expect.len()],\n            &expect[..],\n            \"[{label}] C output disagrees with the reference model\"\n        );\n    }\n}\n\n// ---------------------------------------------------------------------------\n// F1 — end-of-block only (empty output)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn f1_empty_fixed_block() {\n    let (c, r) = load_both();\n    let stream = fixed_only(true, &[]);\n    assert_eq!(stream.len(), 2, \"expected a 2-byte stream, got {stream:?}\");\n    for out_bytes in [0i32, 1, 8, 4096] {\n        for off in 0..4usize {\n            let case = InflateCase::new(stream.clone(), out_bytes).in_off(off);\n            assert_inflate_eq_arena(\n                &c,\n                &r,\n                &case,\n                &format!(\"F1 out={out_bytes} off={off}\"),\n                8192,\n            );\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// F2 — literals only, from BOTH fixed-table length classes\n// ---------------------------------------------------------------------------\n\n#[test]\nfn f2_literals_both_length_classes() {\n    let (c, r) = load_both();\n\n    // All 256 literal values, in order: covers symbols 0..143 (8-bit codes)\n    // and 144..255 (9-bit codes).\n    let all: Vec<Item> = (0u16..256).map(|v| Item::Lit(v as u8)).collect();\n    check_fixed(&c, &r, &all, \"F2 all-256\", 16 * 1024);\n\n    // Only 8-bit-code literals, only 9-bit-code literals.\n    let low: Vec<Item> = (0u16..144).map(|v| Item::Lit(v as u8)).collect();\n    check_fixed(&c, &r, &low, \"F2 low-144\", 16 * 1024);\n    let high: Vec<Item> = (144u16..256).map(|v| Item::Lit(v as u8)).collect();\n    check_fixed(&c, &r, &high, \"F2 high-112\", 16 * 1024);\n\n    // Every single-literal stream (1 byte of output), so the very first\n    // `cp_decode` on a fresh tree is exercised for every symbol.\n    for v in 0u16..256 {\n        check_fixed(&c, &r, &[Item::Lit(v as u8)], &format!(\"F2 single {v}\"), 8192);\n    }\n\n    // Short random literal runs.\n    let mut rng = SplitMix::new(0xF202);\n    for i in 0..200 {\n        let n = 1 + rng.below(40) as usize;\n        let items: Vec<Item> = rng.bytes(n).into_iter().map(Item::Lit).collect();\n        check_fixed(&c, &r, &items, &format!(\"F2 rand#{i} n={n}\"), 8192);\n    }\n}\n\n// ---------------------------------------------------------------------------\n// F3 — every length symbol 257..285 at distance 1 (the `memset` fast path)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn f3_all_length_symbols_distance1() {\n    let (c, r) = load_both();\n    for len_sym in 257..=285usize {\n        let nextra = LEN_EXTRA[len_sym - 257] as u32;\n        let max_extra = (1u32 << nextra) - 1;\n        for len_extra in [0u32, max_extra / 2, max_extra] {\n            let items = vec![\n                Item::Lit(0xA5),\n                Item::Match {\n                    len_sym,\n                    len_extra,\n                    dist_sym: 0, // dist_base[0] == 1\n                    dist_extra: 0,\n                },\n            ];\n            check_fixed(\n                &c,\n                &r,\n                &items,\n                &format!(\"F3 len_sym={len_sym} extra={len_extra}\"),\n                8192,\n            );\n        }\n    }\n    // All of them in one stream (so the same `cp_state_t` walks the whole\n    // length table without a table rebuild in between).\n    let mut items = vec![Item::Lit(0x11)];\n    for len_sym in 257..=285usize {\n        let nextra = LEN_EXTRA[len_sym - 257] as u32;\n        items.push(Item::Match {\n            len_sym,\n            len_extra: (1u32 << nextra) - 1,\n            dist_sym: 0,\n            dist_extra: 0,\n        });\n        items.push(Item::Lit((len_sym & 0xFF) as u8));\n    }\n    check_fixed(&c, &r, &items, \"F3 combined\", 32 * 1024);\n}\n\n// ---------------------------------------------------------------------------\n// F4 — every length symbol at distance 2..: the overlapping byte-copy path\n// ---------------------------------------------------------------------------\n\n#[test]\nfn f4_all_length_symbols_overlapping_copy() {\n    let (c, r) = load_both();\n    for len_sym in 257..=285usize {\n        let nextra = LEN_EXTRA[len_sym - 257] as u32;\n        for len_extra in [0u32, (1u32 << nextra) - 1] {\n            for dist in [2u32, 3, 4, 5, 7, 16] {\n                // Enough preceding output for the back-reference.\n                let mut items: Vec<Item> =\n                    (0..dist as u8).map(|i| Item::Lit(0x40 + i)).collect();\n                let (dist_sym, dist_extra) = dist_code(dist);\n                items.push(Item::Match {\n                    len_sym,\n                    len_extra,\n                    dist_sym,\n                    dist_extra,\n                });\n                check_fixed(\n                    &c,\n                    &r,\n                    &items,\n                    &format!(\"F4 len_sym={len_sym} extra={len_extra} dist={dist}\"),\n                    8192,\n                );\n            }\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// F5 — every distance symbol 0..29 with every extra-bits extreme\n// ---------------------------------------------------------------------------\n\n#[test]\nfn f5_all_distance_symbols() {\n    let (c, r) = load_both();\n    for dist_sym in 0..30usize {\n        let nextra = DIST_EXTRA[dist_sym] as u32;\n        let max_extra = (1u32 << nextra) - 1;\n        for dist_extra in [0u32, max_extra / 2, max_extra] {\n            let dist = DIST_BASE[dist_sym] + dist_extra;\n            // Build exactly `dist` bytes of output cheaply, then copy back.\n            let mut items = fill_items(dist as usize, 0x5A);\n            items.push(Item::Match {\n                len_sym: 260, // len_base[3] == 6, no extra bits\n                len_extra: 0,\n                dist_sym,\n                dist_extra,\n            });\n            let arena = if dist > 60 * 1024 { ARENA } else { 128 * 1024 };\n            check_fixed(\n                &c,\n                &r,\n                &items,\n                &format!(\"F5 dist_sym={dist_sym} extra={dist_extra} dist={dist}\"),\n                arena,\n            );\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// F6 — length symbols 286 and 287 (`cp_len_base` == 0 → zero-length copy)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn f6_length_symbols_286_287() {\n    let (c, r) = load_both();\n    for len_sym in [286usize, 287] {\n        assert_eq!(LEN_BASE[len_sym - 257], 0);\n        assert_eq!(LEN_EXTRA[len_sym - 257], 0);\n        for dist in [1u32, 2, 3, 8] {\n            let mut items: Vec<Item> = (0..dist as u8).map(|i| Item::Lit(0x60 + i)).collect();\n            let (dist_sym, dist_extra) = dist_code(dist);\n            items.push(Item::Match {\n                len_sym,\n                len_extra: 0,\n                dist_sym,\n                dist_extra,\n            });\n            items.push(Item::Lit(0xEE));\n            check_fixed(\n                &c,\n                &r,\n                &items,\n                &format!(\"F6 len_sym={len_sym} dist={dist}\"),\n                8192,\n            );\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// F7 — distance symbols 30 and 31 (`cp_dist_base` == 0 → distance 0)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn f7_distance_symbols_30_31() {\n    let (c, r) = load_both();\n    for dist_sym in [30usize, 31] {\n        assert_eq!(DIST_BASE[dist_sym], 0);\n        assert_eq!(DIST_EXTRA[dist_sym], 0);\n        for len_sym in [257usize, 260, 264, 270, 280, 285] {\n            let nextra = LEN_EXTRA[len_sym - 257] as u32;\n            let items = vec![\n                Item::Lit(0x7F),\n                Item::Lit(0x80),\n                Item::Match {\n                    len_sym,\n                    len_extra: (1u32 << nextra) - 1,\n                    dist_sym,\n                    dist_extra: 0,\n                },\n                Item::Lit(0x81),\n            ];\n            // `simulate` returns None for distance 0 (the result depends on the\n            // pre-existing arena bytes), so this row is purely differential —\n            // which is exactly the point: both must leave the arena identical.\n            check_fixed(\n                &c,\n                &r,\n                &items,\n                &format!(\"F7 dist_sym={dist_sym} len_sym={len_sym}\"),\n                8192,\n            );\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// F8 — real-encoder streams (flate2 raw deflate)\n// ---------------------------------------------------------------------------\n\nfn deflate_raw(data: &[u8], level: u32) -> Vec<u8> {\n    use flate2::write::DeflateEncoder;\n    use flate2::Compression;\n    use std::io::Write;\n    let mut e = DeflateEncoder::new(Vec::new(), Compression::new(level));\n    e.write_all(data).unwrap();\n    e.finish().unwrap()\n}\n\n/// Payload shapes chosen so the encoder produces literals, short matches, long\n/// matches, distance-1 runs and long-distance matches.\nfn payloads(rng: &mut SplitMix) -> Vec<(String, Vec<u8>)> {\n    let mut v: Vec<(String, Vec<u8>)> = Vec::new();\n    v.push((\"empty\".into(), vec![]));\n    v.push((\"one\".into(), vec![0x42]));\n    v.push((\"run256\".into(), vec![0x77; 256]));\n    v.push((\"run4096\".into(), vec![0x01; 4096]));\n    v.push((\n        \"alt\".into(),\n        (0..2000).map(|i| if i % 2 == 0 { b'a' } else { b'b' }).collect(),\n    ));\n    v.push((\"counting\".into(), (0..3000u32).map(|i| i as u8).collect()));\n    v.push((\n        \"repeat64\".into(),\n        (0..8192).map(|i| (i % 64) as u8).collect(),\n    ));\n    v.push((\n        \"text\".into(),\n        b\"the quick brown fox jumps over the lazy dog. \"\n            .iter()\n            .cycle()\n            .take(5000)\n            .cloned()\n            .collect(),\n    ));\n    for n in [1usize, 2, 3, 7, 15, 31, 63, 127, 255, 1023, 4095] {\n        v.push((format!(\"rand{n}\"), rng.bytes(n)));\n        v.push((\n            format!(\"lowent{n}\"),\n            (0..n).map(|_| b'a' + rng.below(3) as u8).collect(),\n        ));\n    }\n    v\n}\n\n#[test]\nfn f8_flate2_streams() {\n    let (c, r) = load_both();\n    let mut rng = SplitMix::new(0xF808);\n    for (name, data) in payloads(&mut rng) {\n        for level in [1u32, 2, 3] {\n            let stream = deflate_raw(&data, level);\n            let case = InflateCase::new(stream.clone(), data.len() as c_int);\n            assert_inflate_eq(&c, &r, &case, &format!(\"F8 {name} lvl={level}\"));\n            // Independent correctness cross-check.\n            let rc = run_inflate(&c, &case, ARENA);\n            if rc.ret == 1 && !data.is_empty() && data.len() > 3 {\n                assert_eq!(\n                    &rc.out_arena[..data.len()],\n                    &data[..],\n                    \"F8 {name} lvl={level}: C did not round-trip\"\n                );\n            }\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// F9 — alignment × tail sweep over the F2/F3/F8 payloads\n// ---------------------------------------------------------------------------\n\n#[test]\nfn f9_alignment_and_tail_sweep() {\n    let (c, r) = load_both();\n    let mut rng = SplitMix::new(0xF909);\n\n    let mut streams: Vec<(String, Vec<u8>, c_int)> = Vec::new();\n    // Literal runs of every length 1..40 => in_bytes takes all residues mod 4.\n    for n in 1..=40usize {\n        let items: Vec<Item> = (0..n).map(|i| Item::Lit((i as u8).wrapping_mul(11))).collect();\n        streams.push((format!(\"lits{n}\"), fixed_only(true, &items), n as c_int));\n    }\n    // Distance-1 runs of every length.\n    for len in 3..=40u32 {\n        let items = vec![Item::Lit(0x33), match_item(len, 1)];\n        streams.push((\n            format!(\"run{len}\"),\n            fixed_only(true, &items),\n            (1 + len) as c_int,\n        ));\n    }\n    // flate2 streams of assorted sizes.\n    for n in [1usize, 2, 5, 11, 23, 47, 101, 211] {\n        let data: Vec<u8> = (0..n).map(|_| b'a' + rng.below(5) as u8).collect();\n        for level in [1u32, 6] {\n            streams.push((\n                format!(\"f2_{n}_{level}\"),\n                deflate_raw(&data, level),\n                n as c_int,\n            ));\n        }\n    }\n\n    for (name, stream, out_bytes) in streams {\n        for off in 0..4usize {\n            let case = InflateCase::new(stream.clone(), out_bytes).in_off(off);\n            assert_inflate_eq_arena(&c, &r, &case, &format!(\"F9 {name} off={off}\"), 8192);\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// F10 — multiple blocks in one stream (BFINAL loop + table rebuild)\n// ---------------------------------------------------------------------------\n\n#[test]\nfn f10_multi_block() {\n    let (c, r) = load_both();\n    let mut rng = SplitMix::new(0xF10A);\n\n    for nblocks in 1..=6usize {\n        for i in 0..6 {\n            let mut w = BitWriter::new();\n            let mut total = 0i64;\n            let mut all: Vec<Item> = Vec::new();\n            for b in 0..nblocks {\n                let n = 1 + rng.below(12) as usize;\n                let mut items: Vec<Item> = rng.bytes(n).into_iter().map(Item::Lit).collect();\n                if total + n as i64 > 4 && rng.below(2) == 0 {\n                    items.push(match_item(3 + rng.below(20), 1 + rng.below(4)));\n                }\n                total += out_size(&items);\n                all.extend(items.iter().cloned());\n                fixed_block(&mut w, b + 1 == nblocks, &items);\n            }\n            let stream = w.finish();\n            for off in 0..4usize {\n                let case = InflateCase::new(stream.clone(), total as c_int).in_off(off);\n                assert_inflate_eq_arena(\n                    &c,\n                    &r,\n                    &case,\n                    &format!(\"F10 nblocks={nblocks} #{i} off={off}\"),\n                    8192,\n                );\n            }\n            // Cross-check: the concatenation of all blocks' items.\n            if let Some(expect) = simulate(&all) {\n                let case = InflateCase::new(stream, total as c_int);\n                let rc = run_inflate(&c, &case, 8192);\n                assert_eq!(rc.ret, 1, \"F10 nblocks={nblocks} #{i}: C failed {rc:?}\");\n                assert_eq!(\n                    &rc.out_arena[..expect.len()],\n                    &expect[..],\n                    \"F10 nblocks={nblocks} #{i}: wrong bytes\"\n                );\n            }\n        }\n    }\n}\n\n/// F10 (continued) — stored, fixed and dynamic blocks mixed in one stream is\n/// covered by `tests/inflate_dynamic.rs::d12_mixed_block_types`.\n#[test]\nfn f10_note() {}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
