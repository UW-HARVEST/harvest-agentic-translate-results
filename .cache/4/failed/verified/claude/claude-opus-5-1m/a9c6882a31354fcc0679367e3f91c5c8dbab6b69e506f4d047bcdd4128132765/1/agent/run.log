{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_nkvaq7mjo3ky2znxq7r2ygs55uxeq2bwvkqw3worosceuzspvl7a","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_012i7gEZzgTz4HNbEDfZFvAS","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-AesDK8/translated_rust/tests/data_symbols.rs","content":"//! CONFIGS.md rows X1, X2 — exported data objects.\n//!\n//! Every exported data symbol is compared byte-for-byte between the two\n//! `.so`s, loaded through `libloading`.\n\nmod common;\n\nuse common::*;\n\n/// (symbol, byte length) — lengths taken from the C declarations and verified\n/// against `nm -S` by `check_symbols.sh`.\nconst DATA: &[(&[u8], usize)] = &[\n    (b\"cp_fixed_table\", 288 + 32),\n    (b\"cp_permutation_order\", 19),\n    (b\"cp_len_extra_bits\", 29 + 2),\n    (b\"cp_len_base\", (29 + 2) * 4),\n    (b\"cp_dist_extra_bits\", 30 + 2),\n    (b\"cp_dist_base\", (30 + 2) * 4),\n];\n\n/// X1 — byte-for-byte comparison of every exported data object.\n#[test]\nfn data_symbols_match() {\n    let (c, r) = load_both();\n    for (sym, len) in DATA {\n        let cs = c.data_slice(sym, *len);\n        let rs = r.data_slice(sym, *len);\n        assert_eq!(\n            cs,\n            rs,\n            \"data symbol {} differs\\n  C   = {}\\n  Rust= {}\",\n            String::from_utf8_lossy(sym),\n            hex(cs),\n            hex(rs)\n        );\n    }\n}\n\n/// X1 — `cp_error_reason` starts out NULL in a freshly loaded library.\n#[test]\nfn error_reason_initially_null() {\n    let (c, r) = load_both();\n    assert_eq!(c.error_reason(), None, \"C cp_error_reason not NULL at load\");\n    assert_eq!(\n        r.error_reason(),\n        None,\n        \"Rust cp_error_reason not NULL at load\"\n    );\n}\n\n/// X1 — the exported arrays must also equal the RFC-1951 values the test\n/// suite's own encoder uses, so a *shared* mistake cannot hide.\n#[test]\nfn data_symbols_match_rfc1951() {\n    let (c, r) = load_both();\n    for im in [&c, &r] {\n        assert_eq!(\n            im.data_slice(b\"cp_len_extra_bits\", 31),\n            &deflate::LEN_EXTRA[..],\n            \"{} cp_len_extra_bits\",\n            im.name\n        );\n        assert_eq!(\n            im.data_slice(b\"cp_dist_extra_bits\", 32),\n            &deflate::DIST_EXTRA[..],\n            \"{} cp_dist_extra_bits\",\n            im.name\n        );\n        assert_eq!(\n            im.data_slice(b\"cp_fixed_table\", 320),\n            &[deflate::fixed_lit_lens(), deflate::fixed_dist_lens()].concat()[..],\n            \"{} cp_fixed_table\",\n            im.name\n        );\n        let perm: Vec<u8> = deflate::PERMUTATION_ORDER.iter().map(|&x| x as u8).collect();\n        assert_eq!(\n            im.data_slice(b\"cp_permutation_order\", 19),\n            &perm[..],\n            \"{} cp_permutation_order\",\n            im.name\n        );\n        let lb: Vec<u8> = deflate::LEN_BASE.iter().flat_map(|v| v.to_ne_bytes()).collect();\n        assert_eq!(\n            im.data_slice(b\"cp_len_base\", 124),\n            &lb[..],\n            \"{} cp_len_base\",\n            im.name\n        );\n        let db: Vec<u8> = deflate::DIST_BASE\n            .iter()\n            .flat_map(|v| v.to_ne_bytes())\n            .collect();\n        assert_eq!(\n            im.data_slice(b\"cp_dist_base\", 128),\n            &db[..],\n            \"{} cp_dist_base\",\n            im.name\n        );\n    }\n}\n\n/// X2 — a *successful* `cp_inflate` leaves `cp_error_reason` untouched in both\n/// implementations (the C never clears it on the happy path).\n#[test]\nfn error_reason_not_cleared_on_success() {\n    let (c, r) = load_both();\n    let sentinel = b\"SENTINEL\\0\";\n\n    for im in [&c, &r] {\n        // Point the global at a string we own, then run a successful inflate.\n        unsafe { *im.error_reason_slot() = sentinel.as_ptr() as *const std::os::raw::c_char };\n        let payload = b\"abcdefgh\";\n        let stream = deflate::stored_ok(true, payload);\n        let mut ina = Arena::filled(4096, 1);\n        let mut outa = Arena::filled(4096, 2);\n        ina.write_at(0, &stream);\n        let f = im.inflate();\n        let ret = unsafe {\n            f(\n                ina.at(0) as *mut std::os::raw::c_void,\n                stream.len() as std::os::raw::c_int,\n                outa.at(0) as *mut std::os::raw::c_void,\n                payload.len() as std::os::raw::c_int,\n            )\n        };\n        assert_eq!(ret, 1, \"{}: stored block should inflate\", im.name);\n        assert_eq!(\n            &outa.as_slice()[..payload.len()],\n            payload,\n            \"{}: wrong output\",\n            im.name\n        );\n        assert_eq!(\n            im.error_reason(),\n            Some(b\"SENTINEL\".to_vec()),\n            \"{}: cp_error_reason was modified by a successful call\",\n            im.name\n        );\n        im.clear_error_reason();\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":400,"cache_read_input_tokens":128170,"cache_creation":{"ephemeral_5m_input_tokens":400,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"1f391add-adf5-472a-b38e-02e2e663f9ae","uuid":"b9e5360d-9dd6-4aca-b40e-86e3a2a1c116","timestamp":"2026-08-20T08:06:44.316Z"}
