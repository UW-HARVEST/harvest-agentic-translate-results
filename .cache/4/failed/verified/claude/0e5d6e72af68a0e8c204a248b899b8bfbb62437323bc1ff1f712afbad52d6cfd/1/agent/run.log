{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_0118M1qUTnqQd6GuU8XzRgey","type":"tool_result","content":"     1\t// By Jan Wrobel <wrr@mixedbit.org>\n     2\t\n     3\t#include <stdio.h>\n     4\t#include <stdlib.h>\n     5\t#include <string.h>\n     6\t\n     7\t#define LUGGAGE_ID_LENGTH 8\n     8\t#define FLIGHT_ID_LENGTH 6\n     9\t#define AIRPORT_CODE_LENGTH 3\n    10\t#define COMMENTS_LENGTH 80\n    11\t\n    12\ttypedef struct RoutingDirective {\n    13\t\tunsigned int time_stamp;\n    14\t\tchar luggage_id[LUGGAGE_ID_LENGTH + 1];\n    15\t\tchar flight_id[FLIGHT_ID_LENGTH + 1];\n    16\t\tchar departure[AIRPORT_CODE_LENGTH + 1];\n    17\t\tchar arrival[AIRPORT_CODE_LENGTH + 1];\n    18\t\tchar comments[COMMENTS_LENGTH + 1];\n    19\t\tstruct RoutingDirective *next_directive;\n    20\t} RoutingDirective;\n    21\t\n    22\tvoid addRoutingDirectiveToList(RoutingDirective *previous_directive,\n    23\t\t\t\t       RoutingDirective *new_directive) {\n    24\t\tRoutingDirective *next_directive = previous_directive->next_directive;\n    25\t\tif (next_directive == NULL ||\n    26\t\t    next_directive->time_stamp > new_directive->time_stamp) {\n    27\t\t\tnew_directive->next_directive = next_directive;\n    28\t\t\tprevious_directive->next_directive = new_directive;\n    29\t\t} else {\n    30\t\t\taddRoutingDirectiveToList(next_directive, new_directive);\n    31\t\t}\n    32\t}\n    33\t\n    34\tint supersedes(RoutingDirective *directive, char *luggage_id, char *departure) {\n    35\t\tif (directive == NULL) {\n    36\t\t\treturn 0;\n    37\t\t}\n    38\t\tif (strcmp(directive->luggage_id, luggage_id) != 0) {\n    39\t\t\treturn supersedes(directive->next_directive,\n    40\t\t\t\t\t  luggage_id,\n    41\t\t\t\t\t  departure);\n    42\t\t}\n    43\t\tif (strcmp(directive->departure, departure) == 0) {\n    44\t\t\treturn 1;\n    45\t\t}\n    46\t\treturn 0;\n    47\t}\n    48\t\n    49\tint superseded(RoutingDirective *directive) {\n    50\t\treturn supersedes(directive->next_directive,\n    51\t\t\t\t  directive->luggage_id,\n    52\t\t\t\t  directive->departure);\n    53\t}\n    54\t\n    55\t\n    56\tint matches(char* expected, char* actual) {\n    57\t\treturn (expected[0] == '-' || strcmp(expected, actual) == 0);\n    58\t}\n    59\t\n    60\tvoid printMatchingDirectives(RoutingDirective* first_directive,\n    61\t\t\t\t     char *expected_luggage_id,\n    62\t\t\t\t     char *expected_flight_id,\n    63\t\t\t\t     char *expected_departure,\n    64\t\t\t\t     char *expected_arrival) {\n    65\t\tRoutingDirective *directive;\n    66\t\tfor (directive = first_directive; directive != NULL;\n    67\t\t     directive = directive->next_directive) {\n    68\t\t\tif (!superseded(directive) &&\n    69\t\t\t    matches(expected_luggage_id, directive->luggage_id) &&\n    70\t\t\t    matches(expected_flight_id, directive->flight_id) &&\n    71\t\t\t    matches(expected_departure, directive->departure) &&\n    72\t\t\t    matches(expected_arrival, directive->arrival)) {\n    73\t                        printf(\"%010u %s %s %s %s %s\\n\",\n    74\t\t\t\t       directive->time_stamp,\n    75\t\t\t\t       directive->luggage_id,\n    76\t\t\t\t       directive->flight_id,\n    77\t\t\t\t       directive->departure,\n    78\t\t\t\t       directive->arrival,\n    79\t\t\t\t       directive->comments);\n    80\t\t\t}\n    81\t\t}\n    82\t}\n    83\t\n    84\tint main(int argc, char *argv[]) {\n    85\t        if (argc != 5) {\n    86\t                fprintf(stderr, \"Command line error: 4 arguments expected\\n\");\n    87\t                exit(1);\n    88\t        }\n    89\t\tRoutingDirective directive_list_head;\n    90\t\tdirective_list_head.time_stamp = 0;\n    91\t\tdirective_list_head.next_directive = NULL;\n    92\t\n    93\t\twhile (1) {\n    94\t\t\tunsigned int time_stamp;\n    95\t\t\tchar luggage_id[LUGGAGE_ID_LENGTH + 1];\n    96\t\t\tchar flight_id[FLIGHT_ID_LENGTH + 1];\n    97\t\t\tcha