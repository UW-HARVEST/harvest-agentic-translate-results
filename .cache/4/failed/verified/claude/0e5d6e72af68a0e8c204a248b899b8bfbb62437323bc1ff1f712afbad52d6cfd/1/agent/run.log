er, ok, c[0], r[0], len(c[1]), len(r[1]), time.time() - t0))\n        if not ok:\n            # show first difference\n            a, b = c[1], r[1]\n            for i in range(min(len(a), len(b))):\n                if a[i] != b[i]:\n                    print(\"   first diff at %d: C=%r R=%r\" % (i, a[max(0,i-60):i+60], b[max(0,i-60):i+60]))\n                    break\n            else:\n                print(\"   prefix equal; clen=%d rlen=%d\" % (len(a), len(b)))\n                print(\"   C tail=%r\" % a[-120:]); print(\"   R tail=%r\" % b[-120:])\n        sys.stdout.flush()\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":485,"cache_read_input_tokens":53999,"cache_creation":{"ephemeral_5m_input_tokens":485,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"efccbdaf-66b3-453d-ae57-3a6a644854b6","uuid":"0acd2a8e-133d-400f-9beb-4fff0a5add03","timestamp":"2026-08-20T16:23:23.622Z"}
