ring in the\n897\t * format 1.0.0 through 99.99.99zz.  To get the version of *.h files\n898\t * used with your application, print out PNG_LIBPNG_VER_STRING, which\n899\t * is defined in png.h.\n900\t * Note: now there is no difference between png_get_libpng_ver() and\n901\t * png_get_header_ver().  Due to the version_nn_nn_nn typedef guard,\n902\t * it is guaranteed that png.c uses the correct version of png.h.\n903\t */\n904\t#[unsafe(no_mangle)]\n905\tpub unsafe extern \"C-unwind\" fn png_get_libpng_ver(png_ptr: png_const_structrp) -> png_const_charp {\n906\t    /* Version of *.c files used when building libpng */\n907\t    png_get_header_ver(png_ptr)\n908\t}\n909\t\n910\t#[unsafe(no_mangle)]\n911\tpub unsafe extern \"C-unwind\" fn png_get_header_ver(png_ptr: png_const_structrp) -> png_const_charp {\n912\t    /* Version of *.h files used when building libpng */\n913\t    c\"1.6.59.git\".as_ptr()\n914\t}\n915\t\n916\t#[unsafe(no_mangle)]\n917\tpub unsafe extern \"C-unwind\" fn png_get_header_version(\n918\t    png_ptr: png_const_structrp,\n919\t) -> png_const_charp {\n920\t    /* Returns longer string containing both version and date */\n921\t    /* PNG_HEADER_VERSION_STRING PNG_STRING_NEWLINE */\n922\t    c\" libpng version 1.6.59.git\\n\\n\".as_ptr()\n923\t}\n924\t\n925\t/* NOTE: this routine is not used internally! */\n926\t/* Build a grayscale palette.  Palette is assumed to be 1 << bit_depth\n927\t * large of png_color.  This lets grayscale images be treated as\n928\t * paletted.  Most useful for gamma correction and simplification\n929\t * of code.  This API is not used internally.\n930\t */\n931\t#[unsafe(no_mangle)]\n932\tpub unsafe extern \"C-unwind\" fn png_build_grayscale_palette(\n933\t    bit_depth: c_int,\n934\t    palette: png_colorp,\n935\t) {\n936\t    let num_palette: c_int;\n937\t    let color_inc: c_int;\n938\t    let mut i: c_int;\n939\t    let mut v: c_int;\n940\t\n941\t    if palette.is_null() {\n942\t        return;\n943\t    }\n944\t\n945\t    match bit_depth {\n946\t        1 => {\n947\t            num_palette = 2;\n948\t            color_inc = 0xff;\n949\t        }\n950\t\n951\t        2 => {\n952\t            num_palette = 4;\n953\t            color_inc = 0x55;\n954\t        }\n955\t\n956\t        4 => {\n957\t            num_palette = 16;\n958\t            color_inc = 0x11;\n959\t        }\n960\t\n961\t        8 => {\n962\t            num_palette = 256;\n963\t            color_inc = 1;\n964\t        }\n965\t\n966\t        _ => {\n967\t            num_palette = 0;\n968\t            color_inc = 0;\n969\t        }\n970\t    }\n971\t\n972\t    i = 0;\n973\t    v = 0;\n974\t    while i < num_palette {\n975\t        (*palette.add(i as usize)).red = (v & 0xff) as png_byte;\n976\t        (*palette.add(i as usize)).green = (v & 0xff) as png_byte;\n977\t        (*palette.add(i as usize)).blue = (v & 0xff) as png_byte;\n978\t        i += 1;\n979\t        v += color_inc;\n980\t    }\n981\t}\n982\t\n983\t#[unsafe(no_mangle)]\n984\tpub unsafe extern \"C-unwind\" fn png_handle_as_unknown(\n985\t    png_ptr: png_const_structrp,\n986\t    chunk_name: png_const_bytep,\n987\t) -> c_int {\n988\t    /* Check chunk_name and return \"keep\" value if it's on the list, else 0 */\n989\t    let mut p: png_const_bytep;\n990\t    let p_end: png_const_bytep;\n991\t\n992\t    if png_ptr.is_null() || chunk_name.is_null() || (*png_ptr).num_chunk_list == 0 {\n993\t        return PNG_HANDLE_CHUNK_AS_DEFAULT;\n994\t    }\n995\t\n996\t    p_end = (*png_ptr).chunk_list;\n997\t    p = p_end.add((*png_ptr).num_chunk_list.wrapping_mul(5) as usize); /* beyond end */\n998\t\n999\t    /* The code is the fifth byte after each four byte string.  Historically this\n1000\t     * code was always searched from the end of the list, this is no longer\n1001\t     * necessary because the 'set' routine handles duplicate entries correctly.\n1002\t     */\n1003\t    loop\n1004\t    /* num_chunk_list > 0, so at least one */\n1005\t    {\n1006\t        p 