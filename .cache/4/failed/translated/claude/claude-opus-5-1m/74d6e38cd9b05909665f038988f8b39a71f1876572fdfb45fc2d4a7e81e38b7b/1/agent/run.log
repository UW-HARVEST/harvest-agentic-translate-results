519\t    png_ptr: png_const_structrp,\n520\t    info_ptr: png_inforp,\n521\t    width: png_uint_32,\n522\t    height: png_uint_32,\n523\t    bit_depth: c_int,\n524\t    color_type: c_int,\n525\t    interlace_type: c_int,\n526\t    compression_type: c_int,\n527\t    filter_type: c_int,\n528\t) {\n529\t    if png_ptr.is_null() || info_ptr.is_null() {\n530\t        return;\n531\t    }\n532\t\n533\t    (*info_ptr).width = width;\n534\t    (*info_ptr).height = height;\n535\t    (*info_ptr).bit_depth = bit_depth as png_byte;\n536\t    (*info_ptr).color_type = color_type as png_byte;\n537\t    (*info_ptr).compression_type = compression_type as png_byte;\n538\t    (*info_ptr).filter_type = filter_type as png_byte;\n539\t    (*info_ptr).interlace_type = interlace_type as png_byte;\n540\t\n541\t    png_check_IHDR(\n542\t        png_ptr,\n543\t        (*info_ptr).width,\n544\t        (*info_ptr).height,\n545\t        (*info_ptr).bit_depth as c_int,\n546\t        (*info_ptr).color_type as c_int,\n547\t        (*info_ptr).interlace_type as c_int,\n548\t        (*info_ptr).compression_type as c_int,\n549\t        (*info_ptr).filter_type as c_int,\n550\t    );\n551\t\n552\t    if (*info_ptr).color_type as c_int == PNG_COLOR_TYPE_PALETTE {\n553\t        (*info_ptr).channels = 1;\n554\t    } else if ((*info_ptr).color_type as c_int & PNG_COLOR_MASK_COLOR) != 0 {\n555\t        (*info_ptr).channels = 3;\n556\t    } else {\n557\t        (*info_ptr).channels = 1;\n558\t    }\n559\t\n560\t    if ((*info_ptr).color_type as c_int & PNG_COLOR_MASK_ALPHA) != 0 {\n561\t        (*info_ptr).channels = (*info_ptr).channels.wrapping_add(1);\n562\t    }\n563\t\n564\t    (*info_ptr).pixel_depth =\n565\t        ((*info_ptr).channels as c_int * (*info_ptr).bit_depth as c_int) as png_byte;\n566\t\n567\t    (*info_ptr).rowbytes = PNG_ROWBYTES((*info_ptr).pixel_depth as usize, width as usize);\n568\t}\n569\t\n570\t/* oFFs */\n571\t#[unsafe(no_mangle)]\n572\tpub unsafe extern \"C-unwind\" fn png_set_oFFs(\n573\t    png_ptr: png_const_structrp,\n574\t    info_ptr: png_inforp,\n575\t    offset_x: png_int_32,\n576\t    offset_y: png_int_32,\n577\t    unit_type: c_int,\n578\t) {\n579\t    if png_ptr.is_null() || info_ptr.is_null() {\n580\t        return;\n581\t    }\n582\t\n583\t    (*info_ptr).x_offset = offset_x;\n584\t    (*info_ptr).y_offset = offset_y;\n585\t    (*info_ptr).offset_unit_type = unit_type as png_byte;\n586\t    (*info_ptr).valid |= PNG_INFO_oFFs;\n587\t}\n588\t/* oFFs */\n589\t\n590\t/* pCAL */\n591\t#[unsafe(no_mangle)]\n592\tpub unsafe extern \"C-unwind\" fn png_set_pCAL(\n593\t    png_ptr: png_const_structrp,\n594\t    info_ptr: png_inforp,\n595\t    purpose: png_const_charp,\n596\t    X0: png_int_32,\n597\t    X1: png_int_32,\n598\t    type_: c_int,\n599\t    nparams: c_int,\n600\t    units: png_const_charp,\n601\t    params: png_charpp,\n602\t) {\n603\t    let mut length: usize;\n604\t    let mut i: c_int;\n605\t\n606\t    if png_ptr.is_null()\n607\t        || info_ptr.is_null()\n608\t        || purpose.is_null()\n609\t        || units.is_null()\n610\t        || (nparams > 0 && params.is_null())\n611\t    {\n612\t        return;\n613\t    }\n614\t\n615\t    length = strlen(purpose) + 1;\n616\t\n617\t    /* TODO: validate format of calibration name and unit name */\n618\t\n619\t    /* Check that the type matches the specification. */\n620\t    if type_ < 0 || type_ > 3 {\n621\t        png_chunk_report(\n622\t            png_ptr,\n623\t            c\"Invalid pCAL equation type\".as_ptr(),\n624\t            PNG_CHUNK_WRITE_ERROR,\n625\t        );\n626\t        return;\n627\t    }\n628\t\n629\t    if nparams < 0 || nparams > 255 {\n630\t        png_chunk_report(\n631\t            png_ptr,\n632\t            c\"Invalid pCAL parameter count\".as_ptr(),\n633\t            PNG_CHUNK_WRITE_ERROR,\n634\t        );\n635\t        return;\n636\t    }\n637\t\n638\t    /* Validate params[nparams] */\n639\t    i = 0;\n640\t    while i < nparams {\n641\t        if (*params.add(i as usize)).is_null()\n642\t            || png_check_fp_string(\n643\t                *params.add(i as usize),\n644\t                strlen(*params.add(i as usize)),\n645\t            ) == 0\n646\t        {\n647\t            png_chunk_report(\n648\t                png_ptr,\n649\t                c\"Invalid format for pCAL parameter\".as_ptr(),\n650\t                PNG_CHUNK_WRITE_ERROR,\n651\t            );\n652\t            return;\n653\t        }\n654\t        i += 1;\n655\t    }\n656\t\n657\t    (*info_ptr).pcal_purpose = png_malloc_warn(png_ptr, length) as png_charp;\n658\t\n659\t    if (*info_ptr).pcal_purpose.is_null() {\n660\t        png_chunk_report(\n661\t            png_ptr,\n662\t            c\"Insufficient memory for pCAL purpose\".as_ptr(),\n663\t            PNG_CHUNK_WRITE_ERROR,\n664\t        );\n665\t        return;\n666\t    }\n667\t\n668\t    memcpy(\n669\t        (*info_ptr).pcal_purpose as *mut u8,\n670\t        purpose as *const u8,\n671\t        length,\n672\t    );\n673\t\n674\t    (*info_ptr).free_me |= PNG_FREE_PCAL;\n675\t\n676\t    (*info_ptr).pcal_X0 = X0;\n677\t    (*info_ptr).pcal_X1 = X1;\n678\t    (*info_ptr).pcal_type = type_ as png_byte;\n679\t    (*info_ptr).pcal_nparams = nparams as png_byte;\n680\t\n681\t    length = strlen(units) + 1;\n682\t\n683\t    (*info_ptr).pcal_units = png_malloc_warn(png_ptr, length) as png_charp;\n684\t\n685\t    if (*info_ptr).pcal_units.is_null() {\n686\t        png_warning(png_ptr, c\"Insufficient memory for pCAL units\".as_ptr());\n687\t        return;\n688\t    }\n689\t\n690\t    memcpy(\n691\t        (*info_ptr).pcal_units as *mut u8,\n692\t        units as *const u8,\n693\t        length,\n694\t    );\n695\t\n696\t    (*info_ptr).pcal_params = png_malloc_warn(\n697\t        png_ptr,\n698\t        ((nparams as c_uint).wrapping_add(1) as usize)\n699\t            .wrapping_mul(core::mem::size_of::<png_charp>()),\n700\t    ) as png_charpp;\n701\t\n702\t    if (*info_ptr).pcal_params.is_null() {\n703\t        png_warning(png_ptr, c\"Insufficient memory for pCAL params\".as_ptr());\n704\t        return;\n705\t    }\n706\t\n707\t    memset(\n708\t        (*info_ptr).pcal_params as *mut u8,\n709\t        0,\n710\t        ((nparams as c_uint).wrapping_add(1) as usize)\n711\t            .wrapping_mul(core::mem::size_of::<png_charp>()),\n712\t    );\n713\t\n714\t    i = 0;\n715\t    while i < nparams {\n716\t        length = strlen(*params.add(i as usize)) + 1;\n717\t\n718\t        *(*info_ptr).pcal_params.add(i as usize) =\n719\t            png_malloc_warn(png_ptr, length) as png_charp;\n720\t\n721\t        if (*(*info_ptr).pcal_params.add(i as usize)).is_null() {\n722\t            png_warning(\n723\t                png_ptr,\n724\t                c\"Insufficient memory for pCAL parameter\".as_ptr(),\n725\t            );\n726\t            return;\n727\t        }\n728\t\n729\t        memcpy(\n730\t            *(*info_ptr).pcal_params.add(i as usize) as *mut u8,\n731\t            *params.add(i as usize) as *const u8,\n732\t            length,\n733\t        );\n734\t\n735\t        i += 1;\n736\t    }\n737\t\n738\t    (*info_ptr).valid |= PNG_INFO_pCAL;\n739\t}\n740\t/* pCAL */\n741\t\n742\t/* sCAL */\n743\t#[unsafe(no_mangle)]\n744\tpub unsafe extern \"C-unwind\" fn png_set_sCAL_s(\n745\t    png_ptr: png_const_structrp,\n746\t    info_ptr: png_inforp,\n747\t    unit: c_int,\n748\t    swidth: png_const_charp,\n749\t    sheight: png_const_charp,\n750\t) {\n751\t    let mut lengthw: usize = 0;\n752\t    let mut lengthh: usize = 0;\n753\t\n754\t    if png_ptr.is_null() || info_ptr.is_null() {\n755\t        return;\n756\t    }\n757\t\n758\t    /* Double check the unit (should never get here with an invalid\n759\t     * unit unless this is an API call.)\n760\t     */\n761\t    if unit != 1 && unit != 2 {\n762\t        png_error(png_ptr, c\"Invalid sCAL unit\".as_ptr());\n763\t    }\n764\t\n765\t    if swidth.is_null()\n766\t        || {\n767\t            lengthw = strlen(swidth);\n768\t            lengthw == 0\n769\t        }\n770\t        || *swidth == 45 /* '-' */\n771\t        || png_check_fp_string(swidth, lengthw) == 0\n772\t    {\n773\t        png_error(png_ptr, c\"Invalid sCAL width\".as_ptr());\n774\t    }\n775\t\n776\t    if sheight.is_null()\n777\t        || {\n778\t            lengthh = strlen(sheight);\n779\t            lengthh == 0\n780\t        }\n781\t        || *sheight == 45 /* '-' */\n782\t        || png_check_fp_string(sheight, lengthh) == 0\n783\t    {\n784\t        png_error(png_ptr, c\"Invalid sCAL height\".as_ptr());\n785\t    }\n786\t\n787\t    (*info_ptr).scal_unit = unit as png_byte;\n788\t\n789\t    lengthw += 1;\n790\t\n791\t    (*info_ptr).scal_s_width = png_malloc_warn(png_ptr, lengthw) as png_charp;\n792\t\n793\t    if (*info_ptr).scal_s_width.is_null() {\n794\t        png_warning(\n795\t            png_ptr,\n796\t            c\"Memory allocation failed while processing sCAL\".as_ptr(),\n797\t        );\n798\t\n799\t        return;\n800\t    }\n801\t\n802\t    memcpy(\n803\t        (*info_ptr).scal_s_width as *mut u8,\n804\t        swidth as *const u8,\n805\t        lengthw,\n806\t    );\n807\t\n808\t    lengthh += 1;\n809\t\n810\t    (*info_ptr).scal_s_height = png_malloc_warn(png_ptr, lengthh) as png_charp;\n811\t\n812\t    if (*info_ptr).scal_s_height.is_null() {\n813\t        png_free(png_ptr, (*info_ptr).scal_s_width as png_voidp);\n814\t        (*info_ptr).scal_s_width = core::ptr::null_mut();\n815\t\n816\t        png_warning(\n817\t            png_ptr,\n818\t            c\"Memory allocation failed while processing sCAL\".as_ptr(),\n819\t        );\n820\t        return;\n821\t    }\n822\t\n823\t    memcpy(\n824\t        (*info_ptr).scal_s_height as *mut u8,\n825\t        sheight as *const u8,\n826\t        lengthh,\n827\t    );\n828\t\n829\t    (*info_ptr).free_me |= PNG_FREE_SCAL;\n830\t    (*info_ptr).valid |= PNG_INFO_sCAL;\n831\t}\n832\t\n833\t/* FLOATING_POINT */\n834\t#[unsafe(no_