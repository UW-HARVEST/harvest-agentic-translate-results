\n173\t    (*info_ptr).valid |= PNG_INFO_cICP;\n174\t}\n175\t/* cICP */\n176\t\n177\t/* cLLI */\n178\t#[unsafe(no_mangle)]\n179\tpub unsafe extern \"C-unwind\" fn png_set_cLLI_fixed(\n180\t    png_ptr: png_const_structrp,\n181\t    info_ptr: png_inforp,\n182\t    /* The values below are in cd/m2 (nits) and are scaled by 10,000; not\n183\t     * 100,000 as in the case of png_fixed_point.\n184\t     */\n185\t    maxCLL: png_uint_32,\n186\t    maxFALL: png_uint_32,\n187\t) {\n188\t    if png_ptr.is_null() || info_ptr.is_null() {\n189\t        return;\n190\t    }\n191\t\n192\t    /* Check the light level range: */\n193\t    if maxCLL > 0x7FFFFFFFu32 || maxFALL > 0x7FFFFFFFu32 {\n194\t        /* The limit is 200kcd/m2; somewhat bright but not inconceivable because\n195\t         * human vision is said to run up to 100Mcd/m2.  The sun is about 2Gcd/m2.\n196\t         *\n197\t         * The reference sRGB monitor is 80cd/m2 and the limit of PQ encoding is\n198\t         * 2kcd/m2.\n199\t         */\n200\t        png_chunk_report(\n201\t            png_ptr,\n202\t            c\"cLLI light level exceeds PNG limit\".as_ptr(),\n203\t            PNG_CHUNK_WRITE_ERROR,\n204\t        );\n205\t        return;\n206\t    }\n207\t\n208\t    (*info_ptr).maxCLL = maxCLL;\n209\t    (*info_ptr).maxFALL = maxFALL;\n210\t    (*info_ptr).valid |= PNG_INFO_cLLI;\n211\t}\n212\t\n213\t/* FLOATING_POINT */\n214\t#[unsafe(no_mangle)]\n215\tpub unsafe extern \"C-unwind\" fn png_set_cLLI(\n216\t    png_ptr: png_const_structrp,\n217\t    info_ptr: png_inforp,\n218\t    maxCLL: f64,\n219\t    maxFALL: f64,\n220\t) {\n221\t    png_set_cLLI_fixed(\n222\t        png_ptr,\n223\t        info_ptr,\n224\t        png_fixed_ITU(png_ptr, maxCLL, c\"png_set_cLLI(maxCLL)\".as_ptr()),\n225\t        png_fixed_ITU(png_ptr, maxFALL, c\"png_set_cLLI(maxFALL)\".as_ptr()),\n226\t    );\n227\t}\n228\t/* FLOATING_POINT */\n229\t/* cLLI */\n230\t\n231\t/* mDCV */\n232\tpub(crate) unsafe fn png_ITU_fixed_16(error: *mut c_int, v: png_fixed_point) -> png_uint_16 {\n233\t    /* Return a safe uint16_t value scaled according to the ITU H273 rules for\n234\t     * 16-bit display chromaticities.  Functions like the corresponding\n235\t     * png_fixed() internal function with regard to errors: it's an error on\n236\t     * write, a chunk_benign_error on read: See the definition of\n237\t     * png_chunk_report in pngpriv.h.\n238\t     */\n239\t    let mut v: png_fixed_point = v;\n240\t\n241\t    v /= 2; /* rounds to 0 in C: avoids insignificant arithmetic errors */\n242\t    if v > 65535 || v < 0 {\n243\t        *error = 1;\n244\t        return 0;\n245\t    }\n246\t\n247\t    v as png_uint_16 /*SAFE*/\n248\t}\n249\t\n250\t#[unsafe(no_mangle)]\n251\tpub unsafe extern \"C-unwind\" fn png_set_mDCV_fixed(\n252\t    png_ptr: png_const_structrp,\n253\t    info_ptr: png_inforp,\n254\t    white_x: png_fixed_point,\n255\t    white_y: png_fixed_point,\n256\t    red_x: png_fixed_point,\n257\t    red_y: png_fixed_point,\n258\t    green_x: png_fixed_point,\n259\t    green_y: png_fixed_point,\n260\t    blue_x: png_fixed_point,\n261\t    blue_y: png_fixed_point,\n262\t    maxDL: png_uint_32,\n263\t    minDL: png_uint_32,\n264\t) {\n265\t    let rx: png_uint_16;\n266\t    let ry: png_uint_16;\n267\t    let gx: png_uint_16;\n268\t    let gy: png_uint_16;\n269\t    let bx: png_uint_16;\n270\t    let by: png_uint_16;\n271\t    let wx: png_uint_16;\n272\t    let wy: png_uint_16;\n273\t    let mut error: c_int;\n274\t\n275\t    if png_ptr.is_null() || info_ptr.is_null() {\n276\t        return;\n277\t    }\n278\t\n279\t    /* Check the input values to ensure they are in the expected range: */\n280\t    error = 0;\n281\t    rx = png_ITU_fixed_16(&mut error, red_x);\n282\t    ry = png_ITU_fixed_16(&mut error, red_y);\n283\t    gx = png_ITU_fixed_16(&mut error, green_x);\n284\t    gy = png_ITU_fixed_16(&mut error, green_y);\n285\t    bx = png_ITU_fixed_16(&mut error, blue_x);\n286\t    by = png_ITU_fixed_16(&mut error, blue_y);\n287\t    wx = png_ITU_fixed_16(&mut error, white_x);\n288\t    wy = png_ITU_fixed_16(&mut error, white_y);\n289\t\n290\t    if error != 0 {\n291\t        png_chunk_report(\n292\t            png_ptr,\n293\t            c\"mDCV chromaticities outside representable range\".as_ptr(),\n294\t            PNG_CHUNK_WRITE_ERROR,\n295\t        );\n296\t        return;\n297\t    }\n298\t\n299\t    /* Check the light level range: */\n300\t    if maxDL > 0x7FFFFFFFu32 || minDL > 0x7FFFFFFFu32 {\n301\t        /* The limit is 200kcd/m2; somewhat bright but not inconceivable because\n302\t         * human vision is said to run up to 100Mcd/m2.  The sun is about 2Gcd/m2.\n303\t         *\n304\t         * The reference sRGB monitor is 80cd/m2 and the limit of PQ encoding is\n305\t         * 2kcd/m2.\n306\t         */\n307\t        png_chunk_report(\n308\t            png_ptr,\n309\t            c\"mDCV display light level exceeds PNG limit\".as_ptr(),\n310\t            PNG_CHUNK_WRITE_ERROR,\n311\t        );\n312\t        return;\n313\t    }\n314\t\n315\t    /* All values are safe, the settings are accepted.\n316\t     *\n317\t     * IMPLEMENTATION NOTE: in practice the values can be checked and assigned\n318\t     * but the result is confusing if a writing app calls png_set_mDCV more than\n319\t     * once, the second time with an invalid value.  This approach is more\n320\t     * obviously correct at the cost of typing and a very slight machine\n321\t     * overhead.\n322\t     */\n323\t    (*info_ptr).mastering_red_x = rx;\n324\t    (*info_ptr).mastering_red_y = ry;\n325\t    (*info_ptr).mastering_green_x = gx;\n326\t    (*info_ptr).mastering_green_y = gy;\n327\t    (*info_ptr).mastering_blue_x = bx;\n328\t    (*info_ptr).mastering_blue_y = by;\n329\t    (*info_ptr).mastering_white_x = wx;\n330\t    (*info_ptr).mastering_white_y = wy;\n331\t    (*info_ptr).mastering_maxDL = maxDL;\n332\t    (*info_ptr).mastering_minDL = minDL;\n333\t    (*info_ptr).valid |= PNG_INFO_mDCV;\n334\t}\n335\t\n336\t/* FLOATING_POINT */\n337\t#[unsafe(no_mangle)]\n338\tpub unsafe extern \"C-unwind\" fn png_set_mDCV(\n339\t    png_ptr: png_const_structrp,\n340\t    info_ptr: png_inforp,\n341\t    white_x: f64,\n342\t    white_y: f64,\n343\t    red_x: f64,\n344\t    red_y: f64,\n345\t    green_x: f64,\n346\t    green_y: f64,\n347\t    blue_x: f64,\n348\t    blue_y: f64,\n349\t    maxDL: f64,\n350\t    minDL: f64,\n351\t) {\n352\t    png_set_mDCV_fixed(\n353\t        png_ptr,\n354\t        info_ptr,\n355\t        png_fixed(png_ptr, white_x, c\"png_set_mDCV(white(x))\".as_ptr()),\n356\t        png_fixed(png_ptr, white_y, c\"png_set_mDCV(white(y))\".as_ptr()),\n357\t        png_fixed(png_ptr, red_x, c\"png_set_mDCV(red(x))\".as_ptr()),\n358\t        png_fixed(png_ptr, red_y, c\"png_set_mDCV(red(y))\".as_ptr()),\n359\t        png_fixed(png_ptr, green_x, c\"png_set_mDCV(green(x))\".as_ptr()),\n360\t        png_fixed(png_ptr, green_y, c\"png_set_mDCV(green(y))\".as_ptr()),\n361\t        png_fixed(png_ptr, blue_x, c\"png_set_mDCV(blue(x))\".as_ptr()),\n362\t        png_fixed(png_ptr, blue_y, c\"png_set_mDCV(blue(y))\".as_ptr()),\n363\t        png_fixed_ITU(png_ptr, maxDL, c\"png_set_mDCV(maxDL)\".as_ptr()),\n364\t        png_fixed_ITU(png_ptr, minDL, c\"png_set_mDCV(minDL)\".as_ptr()),\n365\t    );\n366\t}\n367\t/* FLOATING_POINT */\n368\t/* mDCV */\n369\t\n370\t/* eXIf */\n371\t#[unsafe(no_mangle)]\n372\tpub unsafe extern \"C-unwind\" fn png_set_eXIf(\n373\t    png_ptr: png_const_structrp,\n374\t    info_ptr: png_inforp,\n375\t    exif: png_bytep,\n376\t) {\n377\t    png_warning(\n378\t        png_ptr,\n379\t        c\"png_set_eXIf does not work; use png_set_eXIf_1\".as_ptr(),\n380\t    );\n381\t}\n382\t\n383\t#[unsafe(no_mangle)]\n384\tpub unsafe extern \"C-unwind\" fn png_set_eXIf_1(\n385\t    png_ptr: png_const_structrp,\n386\t    info_ptr: png_inforp,\n387\t    num_exif: png_uint_32,\n388\t    exif: png_bytep,\n389\t) {\n390\t    let new_exif: png_bytep;\n391\t\n392\t    if png_ptr.is_null()\n393\t        || info_ptr.is_null()\n394\t        || ((*png_ptr).mode & PNG_WROTE_eXIf) != 0\n395\t        || exif.is_null()\n396\t    {\n397\t        return;\n398\t    }\n399\t\n400\t    new_exif = png_malloc_warn(png_ptr, num_exif as png_alloc_size_t) as png_bytep;\n401\t\n402\t    if new_exif.is_null() {\n403\t        png_warning(\n404\t            png_ptr,\n405\t            c\"Insufficient memory for eXIf chunk data\".as_ptr(),\n406\t        );\n407\t        return;\n408\t    }\n409\t\n410\t    memcpy(new_exif, exif, num_exif as usize);\n411\t\n412\t    png_free_data(png_ptr, info_ptr, PNG_FREE_EXIF, 0);\n413\t\n414\t    (*info_ptr).num_exif = num_exif;\n415\t    (*info_ptr).exif = new_exif;\n416\t    (*info_ptr).free_me |= PNG_FREE_EXIF;\n417\t    (*info_ptr).valid |= PNG_INFO_eXIf;\n418\t}\n419\t/* eXIf */\n420\t\n421\t/* gAMA */\n422\t#[unsafe(no_mangle)]\n423\tpub unsafe extern \"C-unwind\" fn png_set_gAMA_fixed(\n424\t    png_ptr: png_const_structrp,\n425\t    info_ptr: png_inforp,\n426\t    file_gamma: png_fixed_point,\n427\t) {\n428\t    if png_ptr.is_null() || info_ptr.is_null() {\n429\t        return;\n430\t    }\n431\t\n432\t    (*info_ptr).gamma = file_gamma;\n433\t    (*info_ptr).valid |= PNG_INFO_gAMA;\n434\t}\n435\t\n436\t/* FLOATING_POINT */\n437\t#[unsafe(no_mangle)]\n438\tpub unsafe extern \"C-unwind\" fn png_set_gAMA(\n439\t    png_ptr: png_const_structrp,\n440\t    info_ptr: png_inforp,\n441\t    file_gamma: f64,\n442\t) {\n443\t    png_set_gAMA_fixed(\n444\t        png_ptr,\n445\t        info_ptr,\n446\t        png_fixed(png_ptr, file_gamma, c\"png_set_gAMA\".as_ptr()),\n447\t    );\n448\t}\n449\t\n450\t/* hIST */\n451\t#[unsafe(no_mangle)]\n452\tpub unsafe extern \"C-unwind\" fn png_set_hIST(\n453\t    png_ptr: png_const_structrp,\n454\t    info_ptr: png_inforp,\n455\t    hist: png_const_uint_16p,\n456\t) {\n457\t    let mut safe_hist: [png_uint_16; PNG_MAX_PALETTE_LENGTH as usize] =\n458\t        [0; PNG_MAX_PALETTE_LENGTH as usize];\n459\t    let mut i: c_int;\n460\t    let mut hist: png_const_uint_16p = hist;\n461\t\n462\t    if png_ptr.is_null() || info_ptr.is_null() || hist.is_null() {\n463\t        return;\n464\t    }\n465\t\n466\t    if (*info_ptr).num_palette == 0\n467\t        || (*info_ptr).num_palette as c_int > PNG_MAX_PALETTE_LENGTH\n468\t    {\n469\t        png_warning(\n470\t            png_ptr,\n471\t            c\"Invalid palette size, hIST allocation skipped\".as_ptr(),\n472\t        );\n473\t\n474\t        return;\n475\t    }\n476\t\n477\t    /* Snapshot the caller's hist before freeing, in case it points to\n478\t     * info_ptr->hist (getter-to-setter aliasing).\n479\t     */\n480\t    memcpy(\n481\t        safe_hist.as_mut_ptr() as *mut u8,\n482\t        hist as *const u8,\n483\t        ((*info_ptr).num_palette as c_uint as usize)\n484\t            .wrapping_mul(core::mem::size_of::<png_uint_16>()),\n485\t    );\n486\t    hist = safe_hist.as_ptr();\n487\t\n488\t    png_free_data(png_ptr, info_ptr, PNG_FREE_HIST, 0);\n489\t\n490\t    /* Changed from info->num_palette to PNG_MAX_PALETTE_LENGTH in\n491\t     * version 1.2.1\n492\t     */\n493\t    (*info_ptr).hist = png_malloc_warn(\n494\t        png_ptr,\n495\t        (PNG_MAX_PALETTE_LENGTH as usize).wrapping_mul(core::mem::size_of::<png_uint_16>()),\n496\t    ) as png_uint_16p;\n497\t\n498\t    if (*info_ptr).hist.is_null() {\n499\t        png_warning(\n500\t            png_ptr,\n501\t            c\"Insufficient memory for hIST chunk data\".as_ptr(),\n502\t        );\n503\t        return;\n504\t    }\n505\t\n506\t    i = 0;\n507\t    while i < (*info_ptr).num_palette as c_int {\n508\t        *(*info_ptr).hist.add(i as usize) = *hist.add(i as usize);\n509\t        i += 1;\n510\t    }\n511\t\n512\t    (*info_ptr).free_me |= PNG_FREE_HIST;\n513\t    (*info_ptr).valid |= PNG_INFO_hIST;\n514\t}\n515\t/* hIST */\n516\t\n517\t#[unsafe(no_mangle)]\n518\tpub unsafe extern \"C-unwind\" fn png_set_IHDR(\n519\t    png_ptr: png_const_structrp,\n520\t    info_ptr: png_inforp,\n521\t    width: png_uint_32,\n522\t    height: png_uint_32,\n523\t    bit_depth: c_int,\n524\t    color_type: c_int,\n525\t    interlace_type: c_int,\n526\t    compression_type: c_int,\n527\t    filter_type: c_int,\n528\t) {\n529\t    if png_ptr.is_null() || info_ptr.is_null() {\n530\t        return;\n531\t    }\n532\t\n533\t    (*info_ptr).width = width;\n534\t    (*info_ptr).height = height;\n535\t    (*info_ptr).bit_depth = bit_depth as png_byte;\n536\t    (*info_ptr).color_type = color_type as png_byte;\n537\t    (*info_ptr).compression_type = compression_type as png_byte;\n538\t    (*info_ptr).filter_type = filter_type as png_byte;\n539\t    (*info_ptr).interlace_type = interlace_type as png_byte;\n540\t\n541\t    png_check_IHDR(\n542\t        png_ptr,\n543\t        (*info_ptr).width,\n544\t        (*info_ptr).height,\n545\t        (*info_ptr).bit_depth as c_int,\n546\t        (*info_ptr).color_type as c_int,\n547\t        (*info_ptr).interlace_type as c_int,\n548\t        (*info_ptr).compression_type as c_int,\n549\t        (*info_ptr).filter_type as c_int,\n550\t    );\n551\t\n552\t    if (*info_ptr).color_type as c_int == PNG_COLOR_TYPE_PALETTE {\n553\t        (*info_ptr).channels = 1;\n554\t    } else if ((*info_ptr).color_type as c_int & PNG_COLOR_MASK_COLOR) != 0 {\n555\t        (*info_ptr).channels = 3;\n556\t    } else {\n557\t        (*info_ptr).channels = 1;\n558\t    }\n559\t\n560\t    if ((*info_ptr).color_type as c_int & PNG_COLOR_MASK_ALPHA) != 0 {\n561\t        (*info_ptr).channels = (*info_ptr).channels.wrapping_add(1);\n562\t    }\n563\t\n564\t    (*info_ptr).pixel_depth =\n565\t        ((*info_ptr).channels as c_int * (*info_ptr).bit_depth as c_int) as png_byte;\n566\t\n567\t    (*info_ptr).rowbytes = PNG_ROWBYTES((*info_ptr).pixel_depth as usize, width as usize);\n568\t}\n569\t\n570\t/* oFFs */\n571\t#[unsafe(no_mangle)]\n572\tpub unsafe extern \"C-unwind\" fn png_set_oFFs(\n573\t    png_ptr: png_const_structrp,\n574\t    info_ptr: png_inforp,\n575\t    offset_x: png_int_32,\n576\t    offset_y: png_int_32,\n577\t    unit_type: c_int,\n578\t) {\n579\t    if png_ptr.is_null() || info_ptr.is_null() {\n580\t        return;\n581\t    }\n582\t\n583\t    (*info_ptr).x_offset = offset_x;\n584\t    (*info_ptr).y_offset = offset_y;\n585\t    (*info_ptr).offset_unit_type = unit_type as png_byte;\n586\t    (*info_ptr).valid |= PNG_INFO_oFFs;\n587\t}\n588\t/* oFFs */\n589\t\n590\t/* pCAL */\n591\t#[unsafe(no_mangle)]\n592\tpub unsafe extern \"C-unwind\" fn png_set_pCAL(\n593\t    png_ptr: png_const_structrp,\n594\t    info_ptr: png_inforp,\n595\t    purpose: png_const_charp,\n596\t    X0: png_int_32,\n597\t    X1: png_int_32,\n598\t    type_: c_int,\n599\t    nparams: c_int,\n600\t    units: png_const_charp,\n601\t    params: png_charpp,\n602\t) {\n603\t    let mut length: usize;\n604\t    let mut i: c_int;\n605\t\n606\t    if png_ptr.is_null()\n607\t        || info_ptr.is_null()\n608\t        || purpose.is_null()\n609\t        || units.is_null()\n610\t        || (nparams > 0 && params.is_null())\n611\t    {\n612\t        return;\n613\t    }\n614\t\n615\t    length = strlen(purpose) + 1;\n616\t\n617\t    /* TODO: validate format of calibration name and unit name */\n618\t\n619\t    /* Check that the type matches the specification. */\n620\t    if type_ < 0 || type_ > 3 {\n621\t        png_chunk_report(\n622\t            png_ptr,\n623\t            c\"Invalid pCAL equation type\".as_ptr(),\n624\t            PNG_CHUNK_WRITE_ERROR,\n625\t        );\n626\t        return;\n627\t    }\n628\t\n629\t    if nparams < 0 || nparams > 255 {\n630\t        png_chunk_report(\n631\t            png_ptr,\n632\t            c\"Invalid pCAL parameter count\".as_ptr(),\n633\t            PNG_CHUNK_WRITE_ERROR,\n634\t        );\n635\t        return;\n636\t    }\n637\t\n638\t    /* Validate params[nparams] */\n639\t    i = 0;\n640\t    while i < nparams {\n641\t        if