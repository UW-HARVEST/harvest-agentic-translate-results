{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_013Wbh7NsvQ8vcsBkCyVN4M4","type":"tool_result","content":"1\t//! A minimal re-implementation of the subset of the zlib API that libpng uses,\n2\t//! backed by `miniz_oxide` (pure Rust).  The `z_stream` structure only contains\n3\t//! the fields libpng actually touches, plus the standard ones (so that\n4\t//! `png_zalloc` / `png_zfree` and friends keep working).\n5\t\n6\t#![allow(non_camel_case_types)]\n7\t#![allow(non_upper_case_globals)]\n8\t\n9\tuse core::ffi::{c_char, c_int, c_void};\n10\t\n11\tuse miniz_oxide::deflate::core::{\n12\t    create_comp_flags_from_zip_params, CompressorOxide, TDEFLStatus,\n13\t};\n14\tuse miniz_oxide::deflate::stream::deflate as mz_deflate;\n15\tuse miniz_oxide::inflate::stream::{inflate as mz_inflate, InflateState};\n16\tuse miniz_oxide::{DataFormat, MZError, MZFlush, MZStatus};\n17\t\n18\t/* ------------------------------------------------------------- constants */\n19\t\n20\tpub const Z_OK: c_int = 0;\n21\tpub const Z_STREAM_END: c_int = 1;\n22\tpub const Z_NEED_DICT: c_int = 2;\n23\tpub const Z_ERRNO: c_int = -1;\n24\tpub const Z_STREAM_ERROR: c_int = -2;\n25\tpub const Z_DATA_ERROR: c_int = -3;\n26\tpub const Z_MEM_ERROR: c_int = -4;\n27\tpub const Z_BUF_ERROR: c_int = -5;\n28\tpub const Z_VERSION_ERROR: c_int = -6;\n29\t\n30\tpub const Z_NO_FLUSH: c_int = 0;\n31\tpub const Z_PARTIAL_FLUSH: c_int = 1;\n32\tpub const Z_SYNC_FLUSH: c_int = 2;\n33\tpub const Z_FULL_FLUSH: c_int = 3;\n34\tpub const Z_FINISH: c_int = 4;\n35\tpub const Z_BLOCK: c_int = 5;\n36\tpub const Z_TREES: c_int = 6;\n37\t\n38\tpub const Z_DEFAULT_STRATEGY: c_int = 0;\n39\tpub const Z_FILTERED: c_int = 1;\n40\tpub const Z_HUFFMAN_ONLY: c_int = 2;\n41\tpub const Z_RLE: c_int = 3;\n42\tpub const Z_FIXED: c_int = 4;\n43\t\n44\tpub const Z_DEFLATED: c_int = 8;\n45\tpub const Z_DEFAULT_COMPRESSION: c_int = -1;\n46\t\n47\t/// `ZLIB_IO_MAX` from pngstruct.h: `((uInt)-1)`\n48\tpub const ZLIB_IO_MAX: u32 = u32::MAX;\n49\t\n50\tpub type z_alloc_func = Option<unsafe extern \"C-unwind\" fn(*mut c_void, u32, u32) -> *mut c_void>;\n51\tpub type z_free_func = Option<unsafe extern \"C-unwind\" fn(*mut c_void, *mut c_void)>;\n52\t\n53\t/* --------------------------------------------------------------- z_stream */\n54\t\n55\tpub enum ZState {\n56\t    Inflate {\n57\t        st: Box<InflateState>,\n58\t        window_bits: c_int,\n59\t        /// set once the stream has produced Z_STREAM_END\n60\t        ended: bool,\n61\t    },\n62\t    Deflate {\n63\t        st: Box<CompressorOxide>,\n64\t        level: c_int,\n65\t        window_bits: c_int,\n66\t        mem_level: c_int,\n67\t        strategy: c_int,\n68\t        ended: bool,\n69\t    },\n70\t}\n71\t\n72\t#[repr(C)]\n73\t#[derive(Clone, Copy)]\n74\tpub struct z_stream {\n75\t    pub next_in: *const u8,\n76\t    pub avail_in: u32,\n77\t    pub total_in: u64,\n78\t    pub next_out: *mut u8,\n79\t    pub avail_out: u32,\n80\t    pub total_out: u64,\n81\t    pub msg: *const c_char,\n82\t    pub state: *mut ZState,\n83\t    pub zalloc: z_alloc_func,\n84\t    pub zfree: z_free_func,\n85\t    pub opaque: *mut c_void,\n86\t    pub data_type: c_int,\n87\t    pub adler: u64,\n88\t    pub reserved: u64,\n89\t}\n90\t\n91\timpl z_stream {\n92\t    pub const fn new() -> z_stream {\n93\t        z_stream {\n94\t            next_in: core::ptr::null(),\n95\t            avail_in: 0,\n96\t            total_in: 0,\n97\t            next_out: core::ptr::null_mut(),\n98\t            avail_out: 0,\n99\t            total_out: 0,\n100\t            msg: core::ptr::null(),\n101\t            state: core::ptr::null_mut(),\n102\t            zalloc: None,\n103\t            zfree: None,\n104\t            opaque: core::ptr::null_mut(),\n105\t            data_type: 0,\n106\t            adler: 0,\n107\t            reserved: 0,\n108\t        }\n109\t    }\n110\t}\n111\t\n112\timpl Default for z_stream {\n113\t    fn default() -> Self {\n114\t        z_stream::new()\n115\t    }\n116\t}\n117\t\n118\t/* ------------------------------------------------------- status mapping */\n119\t\n120\tfn map_ok(s: MZStatus) -> c_int {\n121\t    match s {\n122\t        MZStatus::Ok => Z_OK,\n123\t        MZStatus::StreamEnd => Z_STREAM_END,\n124\t        MZStatus::NeedDict => Z_NEED_DICT,\n125\t    }\n126\t}\n127\t\n128\tfn map_err(e: MZError) -> c_int {\n129\t    match e {\n130\t        MZError::ErrNo => Z_ERRNO,\n131\t        MZError::Stream => Z_STREAM_ERROR,\n132\t        MZError::Data => Z_DATA_ERROR,\n133\t        MZError::Mem => Z_MEM_ERROR,\n134\t        MZError::Buf => Z_BUF_ERROR,\n135\t        MZError::Version => Z_VERSION_ERROR,\n136\t        MZError::Param => Z_STREAM_ERROR,\n137\t    }\n138\t}\n139\t\n140\tfn data_format_from_window_bits(window_bits: c_int) -> DataFormat {\n141\t    if window_bits < 0 {\n142\t        DataFormat::Raw\n143\t    } else {\n144\t        /* window_bits == 0 means \"take the window size from the zlib header\",\n145\t         * which still implies a zlib wrapper. */\n146\t        DataFormat::Zlib\n147\t    }\n148\t}\n149\t\n150\tfn mz_flush_from(flush: c_int) -> MZFlush {\n151\t    match flush {\n152\t        Z_NO_FLUSH => MZFlush::None,\n153\t        Z_PARTIAL_FLUSH | Z_SYNC_FLUSH => MZFlush::Sync,\n154\t        Z_FULL_FLUSH => MZFlush::Full,\n155\t        Z_FINISH => MZFlush::Finish,\n156\t        _ => MZFlush::None,\n157\t    }\n158\t}\n159\t\n160\t/* ------------------------------------------------------------- inflate */\n161\t\n162\t/// `inflateInit2(strm, windowBits)`\n163\tpub unsafe fn inflateInit2(strm: *mut z_stream, window_bits: c_int) -> c_int {\n164\t    if strm.is_null() {\n165\t        return Z_STREAM_ERROR;\n166\t    }\n167\t\n168\t    inflateEnd(strm);\n169\t\n170\t    let st = InflateState::new_boxed(data_format_from_window_bits(window_bits));\n171\t    let state = Box::new(ZState::Inflate {\n172\t        st,\n173\t        window_bits,\n174\t        ended: false,\n175\t    });\n176\t    (*strm).state = Box::into_raw(state);\n177\t    (*strm).msg = core::ptr::null();\n178\t    (*strm).total_in = 0;\n179\t    (*strm).total_out = 0;\n180\t    (*strm).adler = 1;\n181\t    Z_OK\n182\t}\n183\t\n184\tpub unsafe fn inflateInit(strm: *mut z_stream) -> c_int {\n185\t    inflateInit2(strm, 15)\n186\t}\n187\t\n188\tpub unsafe fn inflateReset2(strm: *mut z_stream, window_bits: c_int) -> c_int {\n189\t    if strm.is_null() || (*strm).state.is_null() {\n190\t        return Z_STREAM_ERROR;\n191\t    }\n192\t\n193\t    match &mut *(*strm).state {\n194\t        ZState::Inflate {\n195\t            st,\n196\t            window_bits: wb,\n197\t            ended,\n198\t        } => {\n199\t            *wb = window_bits;\n200\t            *ended = false;\n201\t            st.reset(data_format_from_window_bits(window_bits));\n202\t            (*strm).msg = core::ptr::null();\n203\t            (*strm).total_in = 0;\n204\t            (*strm).total_out = 0;\n205\t            (*strm).adler = 1;\n206\t            Z_OK\n207\t        }\n208\t        _ => Z_STREAM_ERROR,\n209\t    }\n210\t}\n211\t\n212\tpub unsafe fn inflateReset(strm: *mut z_stream) -> c_int {\n213\t    if strm.is_null() || (*strm).state.is_null() {\n214\t        return Z_STREAM_ERROR;\n215\t    }\n216\t    let wb = match &*(*strm).state {\n217\t        ZState::Inflate { window_bits, .. } => *window_bits,\n218\t        _ => return Z_STREAM_ERROR,\n219\t    };\n220\t    inflateReset2(strm, wb)\n221\t}\n222\t\n223\t/// `inflateValidate(strm, check)` -- only ever used to *disable* the ADLER32\n224\t/// check, which is not compiled in for this configuration.  Accepted for\n225\t/// completeness.\n226\tpub unsafe fn inflateValidate(strm: *mut z_stream, _check: c_int) -> c_int {\n227\t    if strm.is_null() || (*strm).state.is_null() {\n228\t        return Z_STREAM_ERROR;\n229\t    }\n230\t    match &mut *(*strm).state {\n231\t        ZState::Inflate { st, .. } => {\n232\t            if _check == 0 {\n233\t                st.reset_as(miniz_oxide::inflate::stream::FullReset(\n234\t                    DataFormat::ZLibIgnoreChecksum,\n235\t                ));\n236\t            }\n237\t            Z_OK\n238\t        }\n239\t        _ => Z_STREAM_ERROR,\n240\t    }\n241\t}\n242\t\n243\tpub unsafe fn inflateEnd(strm: *mut z_stream) -> c_int {\n244\t    if strm.is_null() {\n245\t        return Z_STREAM_ERROR;\n246\t    }\n247\t    if !(*strm).state.is_null() {\n248\t        drop(Box::from_raw((*strm).state));\n249\t        (*strm).state = core::ptr::null_mut();\n250\t    }\n251\t    Z_OK\n252\t}\n253\t\n254\tpub unsafe fn inflate(strm: *mut z_stream, flush: c_int) -> c_int {\n255\t    if strm.is_null() || (*strm).state.is_null() {\n256\t        return Z_STREAM_ERROR;\n257\t    }\n258\t\n259\t    let s = &mut *(*strm).state;\n260\t    let st = match s {\n261\t        ZState::Inflate { st, ended, .. } => {\n262\t            if *ended && flush != Z_FINISH {\n263\t                /* zlib would just return Z_STREAM_END / Z_BUF_ERROR here. */\n264\t                return Z_BUF_ERROR;\n265\t            }\n266\t            st\n267\t        }\n268\t        _ => return Z_STREAM_ERROR,\n269\t    };\n270\t\n271\t    let avail_in = (*strm).avail_in as usize;\n272\t    let avail_out = (*strm).avail_out as usize;\n273\t\n274\t    let input: &[u8] = if (*strm).next_in.is_null() || avail_in == 0 {\n275\t        &[]\n276\t    } else {\n277\t        core::slice::from_raw_parts((*strm).next_in, avail_in)\n278\t    };\n279\t    let output: &mut [u8] = if (*strm).next_out.is_null() || avail_out == 0 {\n280\t        &mut []\n281\t    } else {\n282\t        core::slice::from_raw_parts_mut((*strm).next_out, avail_out)\n283\t    };\n284\t\n285\t    let res = mz_inflate(st, input, output, mz_flush_from(flush));\n286\t\n287\t    (*strm).next_in = (*strm).next_in.add(res.bytes_consumed);\n288\t    (*strm).avail_in -= res.bytes_consumed as u32;\n289\t    (*strm).total_in += res.bytes_consumed as u64;\n290\t    (*strm).next_out = (*strm).next_out.add(res.bytes_written);\n291\t    (*strm).avail_out -= res.bytes_written as u32;\n292\t    (*strm).total_out += res.bytes_written as u64;\n293\t\n294\t    /* Provide the zlib error text for the one case we can identify. */\n295\t    if st.last_status() == miniz_oxide::inflate::TINFLStatus::Adler32Mismatch {\n296\t        (*strm).msg = c\"incorrect data check\".as_ptr();\n297\t    }\n298\t\n299\t    let ret = match res.status {\n300\t        Ok(s) => {\n301\t            if s == MZStatus::StreamEnd {\n302\t                if let ZState::Inflate { ended, .. } = &mut *(*strm).state {\n303\t                    *ended = true;\n304\t                }\n305\t            }\n306\t            map_ok(s)\n307\t        }\n308\t        Err(e) => map_err(e),\n309\t    };\n310\t\n311\t    ret\n312\t}\n313\t\n314\t/* ------------------------------------------------------------- deflate */\n315\t\n316\tpub unsafe fn deflateInit2(\n317\t    strm: *mut z_stream,\n318\t    level: c_int,\n319\t    method: c_int,\n320\t    window_bits: c_int,\n321\t    mem_level: c_int,\n322\t    strategy: c_int,\n323\t) -> c_int {\n324\t    if strm.is_null() {\n325\t        return Z_STREAM_ERROR;\n326\t    }\n327\t\n328\t    if method != Z_DEFLATED {\n329\t        return Z_STREAM_ERROR;\n330\t    }\n331\t    if level < -1 || level > 9 {\n332\t        return Z_STREAM_ERROR;\n333\t    }\n334\t    if mem_level < 1 || mem_level > 9 {\n335\t        return Z_STREAM_ERROR;\n336\t    }\n337\t    if strategy < 0 || strategy > Z_FIXED {\n338\t        return Z_STREAM_ERROR;\n339\t    }\n340\t    let wb = if window_bits < 0 {\n341\t        -window_bits\n342\t    } else {\n343\t        window_bits\n344\t    };\n345\t    if wb < 8 || wb > 15 {\n346\t        return Z_STREAM_ERROR;\n347\t    }\n348\t\n349\t    deflateEnd(strm);\n350\t\n351\t    let flags = create_comp_flags_from_zip_params(level, window_bits, strategy);\n352\t    let st = Box::new(CompressorOxide::new(flag