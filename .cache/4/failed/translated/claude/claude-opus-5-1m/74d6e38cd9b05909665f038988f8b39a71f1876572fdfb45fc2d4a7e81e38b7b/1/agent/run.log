51\t            (*png_ptr).channels = 3;\n52\t        }\n53\t\n54\t        PNG_COLOR_TYPE_GRAY_ALPHA => {\n55\t            (*png_ptr).channels = 2;\n56\t        }\n57\t\n58\t        PNG_COLOR_TYPE_RGB_ALPHA => {\n59\t            (*png_ptr).channels = 4;\n60\t        }\n61\t\n62\t        /* default: invalid, png_set_IHDR calls png_error */\n63\t        /* PNG_COLOR_TYPE_GRAY, PNG_COLOR_TYPE_PALETTE */\n64\t        _ => {\n65\t            (*png_ptr).channels = 1;\n66\t        }\n67\t    }\n68\t\n69\t    /* Set up other useful info */\n70\t    (*png_ptr).pixel_depth =\n71\t        ((*png_ptr).bit_depth as c_int * (*png_ptr).channels as c_int) as png_byte;\n72\t    (*png_ptr).rowbytes = PNG_ROWBYTES((*png_ptr).pixel_depth as usize, (*png_ptr).width as usize);\n73\t\n74\t    /* Rely on png_set_IHDR to completely validate the data and call png_error if\n75\t     * it's wrong.\n76\t     */\n77\t    png_set_IHDR(\n78\t        png_ptr,\n79\t        info_ptr,\n80\t        width,\n81\t        height,\n82\t        bit_depth,\n83\t        color_type,\n84\t        interlace_type,\n85\t        compression_type,\n86\t        filter_type,\n87\t    );\n88\t\n89\t    handled_ok\n90\t}\n91\t\n92\t/* Read and check the palette */\n93\t/* TODO: there are several obvious errors in this code when handling\n94\t * out-of-place chunks and there is much over-complexity caused by trying to\n95\t * patch up the problems.\n96\t */\n97\tpub(crate) unsafe fn png_handle_PLTE(\n98\t    png_ptr: png_structrp,\n99\t    info_ptr: png_inforp,\n100\t    length: png_uint_32,\n101\t) -> c_int {\n102\t    let mut errmsg: png_const_charp = core::ptr::null();\n103\t\n104\t    /* 1.6.47: consistency.  This used to be especially treated as a critical\n105\t     * error even in an image which is not colour mapped, there isn't a good\n106\t     * justification for treating some errors here one way and others another so\n107\t     * everything uses the same logic.\n108\t     */\n109\t    if ((*png_ptr).mode & PNG_