, 0xA0, 0xB0, 0xC0, 0xD0, 0xE0, 0xF0,\n335\t    0x01, 0x11, 0x21, 0x31, 0x41, 0x51, 0x61, 0x71, 0x81, 0x91, 0xA1, 0xB1, 0xC1, 0xD1, 0xE1, 0xF1,\n336\t    0x02, 0x12, 0x22, 0x32, 0x42, 0x52, 0x62, 0x72, 0x82, 0x92, 0xA2, 0xB2, 0xC2, 0xD2, 0xE2, 0xF2,\n337\t    0x03, 0x13, 0x23, 0x33, 0x43, 0x53, 0x63, 0x73, 0x83, 0x93, 0xA3, 0xB3, 0xC3, 0xD3, 0xE3, 0xF3,\n338\t    0x04, 0x14, 0x24, 0x34, 0x44, 0x54, 0x64, 0x74, 0x84, 0x94, 0xA4, 0xB4, 0xC4, 0xD4, 0xE4, 0xF4,\n339\t    0x05, 0x15, 0x25, 0x35, 0x45, 0x55, 0x65, 0x75, 0x85, 0x95, 0xA5, 0xB5, 0xC5, 0xD5, 0xE5, 0xF5,\n340\t    0x06, 0x16, 0x26, 0x36, 0x46, 0x56, 0x66, 0x76, 0x86, 0x96, 0xA6, 0xB6, 0xC6, 0xD6, 0xE6, 0xF6,\n341\t    0x07, 0x17, 0x27, 0x37, 0x47, 0x57, 0x67, 0x77, 0x87, 0x97, 0xA7, 0xB7, 0xC7, 0xD7, 0xE7, 0xF7,\n342\t    0x08, 0x18, 0x28, 0x38, 0x48, 0x58, 0x68, 0x78, 0x88, 0x98, 0xA8, 0xB8, 0xC8, 0xD8, 0xE8, 0xF8,\n343\t    0x09, 0x19, 0x29, 0x39, 0x49, 0x59, 0x69, 0x79, 0x89, 0x99, 0xA9, 0xB9, 0xC9, 0xD9, 0xE9, 0xF9,\n344\t    0x0A, 0x1A, 0x2A, 0x3A, 0x4A, 0x5A, 0x6A, 0x7A, 0x8A, 0x9A, 0xAA, 0xBA, 0xCA, 0xDA, 0xEA, 0xFA,\n345\t    0x0B, 0x1B, 0x2B, 0x3B, 0x4B, 0x5B, 0x6B, 0x7B, 0x8B, 0x9B, 0xAB, 0xBB, 0xCB, 0xDB, 0xEB, 0xFB,\n346\t    0x0C, 0x1C, 0x2C, 0x3C, 0x4C, 0x5C, 0x6C, 0x7C, 0x8C, 0x9C, 0xAC, 0xBC, 0xCC, 0xDC, 0xEC, 0xFC,\n347\t    0x0D, 0x1D, 0x2D, 0x3D, 0x4D, 0x5D, 0x6D, 0x7D, 0x8D, 0x9D, 0xAD, 0xBD, 0xCD, 0xDD, 0xED, 0xFD,\n348\t    0x0E, 0x1E, 0x2E, 0x3E, 0x4E, 0x5E, 0x6E, 0x7E, 0x8E, 0x9E, 0xAE, 0xBE, 0xCE, 0xDE, 0xEE, 0xFE,\n349\t    0x0F, 0x1F, 0x2F, 0x3F, 0x4F, 0x5F, 0x6F, 0x7F, 0x8F, 0x9F, 0xAF, 0xBF, 0xCF, 0xDF, 0xEF, 0xFF,\n350\t];\n351\t\n352\t/* Swaps pixel packing order within bytes */\n353\t#[unsafe(no_mangle)]\n354\tpub unsafe extern \"C-unwind\" fn png_do_packswap(row_info: png_row_infop, row: png_bytep) {\n355\t    if (*row_info).bit_depth < 8 {\n356\t        let table: png_const_bytep;\n357\t        let mut rp: png_bytep;\n358\t        let row_end: png_bytep = row.add((*row_info).rowbytes);\n359\t\n360\t        if (*row_info).bit_depth == 1 {\n361\t            table = onebppswaptable.as_ptr();\n362\t        } else if (*row_info).bit_depth == 2 {\n363\t            table = twobppswaptable.as_ptr();\n364\t        } else if (*row_info).bit_depth == 4 {\n365\t            table = fourbppswaptable.as_ptr();\n366\t        } else {\n367\t            return;\n368\t        }\n369\t\n370\t        rp = row;\n371\t        while rp < row_end {\n372\t            *rp = *table.add(*rp as usize);\n373\t            rp = rp.add(1);\n374\t        }\n375\t    }\n376\t}\n377\t\n378\t/* Remove a channel - this used to be 'png_do_strip_filler' but it used a\n379\t * somewhat weird combination of flags to determine what to do.  All the calls\n380\t * to png_do_strip_filler are changed in 1.5.2 to call this instead with the\n381\t * correct arguments.\n382\t *\n383\t * The routine isn't general - the channel must be the channel at the start or\n384\t * end (not in the middle) of each pixel.\n385\t */\n386\t#[unsafe(no_mangle)]\n387\tpub unsafe extern \"C-unwind\" fn png_do_strip_channel(\n388\t    row_info: png_row_infop,\n389\t    row: png_bytep,\n390\t    at_start: c_int,\n391\t) {\n392\t    let mut sp: png_bytep = row; /* source pointer */\n393\t    let mut dp: png_bytep = row; /* destination pointer */\n394\t    let ep: png_bytep = row.add((*row_info).rowbytes); /* One beyond end of row */\n395\t\n396\t    /* At the start sp will point to the first byte to copy and dp to where\n397\t     * it is copied to.  ep always points just beyond the end of the row, so\n398\t     * the loop simply copies (channels-1) channels until sp reaches ep.\n399\t     *\n400\t     * at_start:        0 -- convert AG, XG, ARGB, XRGB, AAGG, XXGG, etc.\n401\t     *            nonzero -- convert GA, GX, RGBA, RGBX, GGAA, RRGGBBXX, etc.\n402\t     */\n403\t\n404\t    /* GA, GX, XG cases */\n405\t    if (*row_info).channels == 2 {\n406\t        if (*row_info).bit_depth == 8 {\n407\t           