 {\n209\t        (*png_ptr).flags |= PNG_FLAG_LIBRARY_MISMATCH;\n210\t    }\n211\t\n212\t    if ((*png_ptr).flags & PNG_FLAG_LIBRARY_MISMATCH) != 0 {\n213\t        let mut pos: usize = 0;\n214\t        let mut m: [c_char; 128] = [0; 128];\n215\t\n216\t        pos = png_safecat(\n217\t            m.as_mut_ptr(),\n218\t            128,\n219\t            pos,\n220\t            c\"Application built with libpng-\".as_ptr(),\n221\t        );\n222\t        pos = png_safecat(m.as_mut_ptr(), 128, pos, user_png_ver);\n223\t        pos = png_safecat(m.as_mut_ptr(), 128, pos, c\" but running with \".as_ptr());\n224\t        pos = png_safecat(\n225\t            m.as_mut_ptr(),\n226\t            128,\n227\t            pos,\n228\t            PNG_LIBPNG_VER_STRING.as_ptr() as png_const_charp,\n229\t        );\n230\t\n231\t        png_warning(png_ptr, m.as_ptr());\n232\t\n233\t        return 0;\n234\t    }\n235\t\n236\t    /* Success return. */\n237\t    1\n238\t}\n239\t\n240\t/* Payload used to emulate the `setjmp(create_jmp_buf)` guard that\n241\t * png_create_png_struct() installs (see the comment in that function).\n242\t */\n243\tstruct PngCreateStructUnwind;\n244\t\n245\t/* Stand-in for the C `longjmp` that png_create_png_struct() stores into\n246\t * create_struct.longjmp_fn.  Rust cannot longjmp, so this unwinds instead and\n247\t * png_create_png_struct() catches the unwind with std::panic::catch_unwind.\n248\t */\n249\tunsafe extern \"C-unwind\" fn png_create_struct_longjmp(_jmp_buf: *mut jmp_buf, _val: c_int) {\n250\t    std::panic::resume_unwind(Box::new(PngCreateStructUnwind));\n251\t}\n252\t\n253\t/* Generic function to create a png_struct for either read or write - this\n254\t * contains the common initialization.\n255\t */\n256\t#[unsafe(no_mangle)]\n257\tpub unsafe extern \"C-unwind\" fn png_create_png_struct(\n258\t    user_png_ver: png_const_charp,\n259\t    error_ptr: png_voidp,\n260\t    error_fn: png_error_ptr,\n261\t    warn_fn: png_error_ptr,\n262\t    mem_ptr: png_voidp,\n263\t    malloc_fn: png_malloc_ptr,\n264\t    free_fn: png_free_ptr,\n265\t) -> png_structp {\n266\t    /* This temporary stack-allocated structure is used to provide a place to\n267\t     * build enough context to allow the user provided memory allocator (if any)\n268\t     * to be called.\n269\t     *\n270\t     * NOTE ON THE setjmp() IN THE C CODE: the C version wraps the body below in\n271\t     *\n272\t     *     if (!setjmp(create_jmp_buf)) { ... }\n273\t     *     return NULL;\n274\t     *\n275\t     * and installs `longjmp` into create_struct.longjmp_fn together with\n276\t     * `&create_jmp_buf` in create_struct.jmp_buf_ptr, so that a png_error()\n277\t     * raised while the png_struct is being built (e.g. from a broken\n278\t     * application memory allocator) simply returns NULL out of this function.\n279\t     *\n280\t     * Rust cannot use setjmp/longjmp, so the guarded region is wrapped in\n281\t     * std::panic::catch_unwind() and create_struct.longjmp_fn is set to\n282\t     * png_create_struct_longjmp() (above), which unwinds instead of jumping.\n283\t     * create_struct.jmp_buf_ptr is set to `&create_jmp_buf` exactly as in the C\n284\t     * code so that it is non-NULL (png_longjmp() only calls longjmp_fn when\n285\t     * jmp_buf_ptr != NULL); the buffer contents themselves are never used.\n286\t     * On Err(_) -- i.e. \"setjmp returned non-zero\" -- control drops out of the\n287\t     * guarded region and NULL is returned, exactly as the C does (the C code\n288\t     * does not free anything on this path either).\n289\t     */\n290\t    let mut create_struct: png_struct = png_struct::zeroed();\n291\t    let mut create_jmp_buf: jmp_buf = jmp_buf {\n292\t        opaque: [0; PNG_JMP_BUF_SIZE / 8],\n293\t    };\n294\t\n295\t    create_struct.user_width_max = PNG_USER_WIDTH_MAX;\n296\t    create_struct.user_height_max = PNG_USER_HEIGHT_MAX;\n297\t\n298\t    create_struct.user_chunk_cache_max = PNG_USER_CHUNK_CACHE_MAX;\n299\t\n300\t    /* PNG_USER_CHUNK_MALLOC_MAX > 0: default to the compile-time limit */\n301\t    create_struct.user_chunk_malloc_max = PNG_USER_CHUNK_MALLOC_MAX;\n302\t\n303\t    /* The following two API calls simply set fields in png_struct, so it is safe\n304\t     * to do them now even though error handling is not yet set up.\n305\t     */\n306\t    png_set_mem_fn(&mut create_struct, mem_ptr, malloc_fn, free_fn);\n307\t\n308\t    /* (*error_fn) can return control to the caller after the error_ptr is set,\n309\t     * this will result in a memory leak unless the error_fn does something\n310\t     * extremely sophisticated.  The design lacks merit but is implicit in the\n311\t     * API.\n312\t     */\n313\t    png_set_error_fn(&mut create_struct, error_ptr, error_fn, warn_fn);\n314\t\n315\t    let guarded = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| -> png_structp {\n316\t        /* Temporarily fake out the longjmp information until we have\n317\t         * successfully completed this function.  This only works if we have\n318\t         * setjmp() support compiled in, but it is safe - this stuff should\n319\t         * never happen.\n320\t         */\n321\t        create_struct.jmp_buf_ptr = core::ptr::addr_of_mut!(create_jmp_buf);\n322\t        create_struct.jmp_buf_size = 0; /*stack allocation*/\n323\t        create_struct.longjmp_fn = Some(png_create_struct_longjmp);\n324\t\n325\t        /* Call the general version checker (shared with read and write code): */\n326\t        if png_user_version_check(&mut create_struct, user_png_ver) != 0 {\n327\t            let png_ptr: png_structrp = png_malloc_warn(\n328\t                &mut create_struct,\n329\t                core::mem::size_of::<png_struct>(),\n330\t            ) as png_structrp;\n331\t\n332\t            if !png_ptr.is_null() {\n333\t                /* png_ptr->zstream holds a back-pointer to the png_struct, so\n334\t                 * this can only be done now:\n335\t                 */\n336\t                create_struct.zstream.zalloc = Some(png_zalloc);\n337\t                create_struct.zstream.zfree = Some(png_zfree);\n338\t                create_struct.zstream.opaque = png_ptr as *mut c_void;\n339\t\n340\t                /* Eliminate the local error handling: */\n341\t                create_struct.jmp_buf_ptr = core::ptr::null_mut();\n342\t                create_struct.jmp_buf_size = 0;\n343\t                create_struct.longjmp_fn = None;\n344\t\n345\t                *png_ptr = create_struct;\n346\t\n347\t                /* This is the successful return point */\n348\t                return png_ptr;\n349\t            }\n350\t        }\n351\t\n352\t        core::ptr::null_mut()\n353\t    }));\n354\t\n355\t    if let Ok(png_ptr) = guarded {\n356\t        if !png_ptr.is_null() {\n357\t            return png_ptr;\n358\t        }\n359\t    }\n360\t\n361\t    /* A longjmp because of a bug in the application storage allocator or a\n362\t     * simple failure to allocate the png_struct.\n363\t     */\n364\t    core::ptr::null_mut()\n365\t}\n366\t\n367\t/* Allocate the memory for an info_struct for the application. */\n368\t#[unsafe(no_mangle)]\n369\tpub unsafe extern \"C-unwind\" fn png_create_info_struct(png_ptr: png_const_structrp) -> png_infop {\n370\t    let info_ptr: png_inforp;\n371\t\n372\t    if png_ptr.is_null() {\n373\t        return core::ptr::null_mut();\n374\t    }\n375\t\n376\t    /* Use the internal API that does not (or at least should not) error out, so\n377\t     * that this call always returns ok.  The application typically sets up the\n378\t     * error handling *after* creating the info_struct because this is the way it\n379\t     * has always been done in 'example.c'.\n380\t     */\n381\t    info_ptr = png_malloc_base(png_ptr, core::mem::size_of::<png_info>()) as png_inforp;\n382\t\n383\t    if !info_ptr.is_null() {\n384\t        memset(info_ptr as *mut u8, 0, core::mem::size_of::<png_info>());\n385\t    }\n386\t\n387\t    info_ptr\n388\t}\n389\t\n390\t/* This function frees the memory associated with a single info struct.\n391\t * Normally, one would use either png_destroy_read_struct() or\n392\t * png_destroy_write_struct() to free an info struct, but this may be\n393\t * useful for some applications.  From libpng 1.6.0 this function is also used\n394\t * internally to implement the png_info release part of the 'struct' destroy\n395\t * APIs.  This ensures that all possible approaches free the same data (all of\n396\t * it).\n397\t */\n398\t#[unsafe(no_mangle)]\n399\tpub unsafe extern \"C-unwind\" fn png_destroy_info_struct(\n400\t    png_ptr: png_const_structrp,\n401\t    info_ptr_ptr: png_infopp,\n402\t) {\n403\t    let mut info_ptr: png_inforp = core::ptr::null_mut();\n404\t\n405\t    if png_ptr.is_null() {\n406\t        return;\n407\t    }\n408\t\n409\t    if !info_ptr_ptr.is_null() {\n410\t        info_ptr = *info_ptr_ptr;\n411\t    }\n412\t\n413\t    if !info_ptr.is_null() {\n414\t        /* Do this first in case of an error below; if the app implements its own\n415\t         * memory management this can lead to png_free calling png_error, which\n416\t         * will abort this routine and return control to the app error handler.\n417\t         * An infinite loop may result if it then tries to free the same info\n418\t         * ptr.\n419\t         */\n420\t        *info_ptr_ptr = core::ptr::null_mut();\n421\t\n422\t        png_free_data(png_ptr, info_ptr, PNG_FREE_ALL, -1);\n423\t        memset(info_ptr as *mut u8, 0, core::mem::size_of::<png_info>());\n424\t        png_free(png_ptr, info_ptr as png_voidp);\n425\t    }\n426\t}\n427\t\n428\t/* Initialize the info structure.  This is now an internal function (0.89)\n429\t * and applications using it are urged to use png_create_info_struct()\n430\t * instead.  Use deprecated in 1.6.0, internal use removed (used internally it\n431\t * is just a memset).\n432\t *\n433\t * NOTE: it is almost inconceivable that this API is used because it bypasses\n434\t * the user-memory mechanism and the user error handling/warning mechanisms in\n435\t * those cases where it does anything other than a memset.\n436\t */\n437\t#[unsafe(no_mangle)]\n438\tpub unsafe extern \"C-unwind\" fn png_info_init_3(\n439\t    ptr_ptr: png_infopp,\n440\t    png_info_struct_size: usize,\n441\t) {\n442\t    let mut info_ptr: png_inforp = *ptr_ptr;\n443\t\n444\t    if info_ptr.is_null() {\n445\t        return;\n446\t    }\n447\t\n448\t    if core::mem::size_of::<png_info>() > png_info_struct_size {\n449\t        *ptr_ptr = core::ptr::null_mut();\n450\t        /* The following line is why this API should not be used: */\n451\t        libc::free(info_ptr as *mut c_void);\n452\t        info_ptr = png_malloc_base(core::ptr::null_mut(), core::mem::size_of::<png_info>())\n453\t            as png_inforp;\n454\t        if info_ptr.is_null() {\n455\t            return;\n456\t        }\n457\t        *ptr_ptr = info_ptr;\n458\t    }\n459\t\n460\t    /* Set everything to 0 */\n461\t    memset(info_ptr as *mut u8, 0, core::mem::size_of::<png_info>());\n462\t}\n463\t\n464\t#[unsafe(no_mangle)]\n465\tpub unsafe extern \"C-unwind\" fn png_data_freer(\n466\t    png_ptr: png_const_structrp,\n467\t    info_ptr: png_inforp,\n468\t    freer: c_int,\n469\t    mask: png_uint_32,\n470\t) {\n471\t    if png_ptr.is_null() || info_ptr.is_null() {\n472\t        return;\n473\t    }\n474\t\n475\t    if freer == PNG_DESTROY_WILL_FREE_DATA {\n476\t        (*info_ptr).free_me |= mask;\n477\t    } else if freer == PNG_USER_WILL_FREE_DATA {\n478\t        (*info_ptr).free_me &= !mask;\n479\t    } else {\n480\t        png_error(\n481\t            png_ptr,\n482\t            c\"Unknown freer parameter in png_data_freer\".as_ptr(),\n483\t        );\n484\t    }\n485\t}\n486\t\n487\t#[unsafe(no_mangle)]\n488\tpub unsafe extern \"C-unwind\" fn png_free_data(\n489\t    png_ptr: png_const_structrp,\n490\t    info_ptr: png_inforp,\n491\t    mask: png_uint_32,\n492\t    num: c_int,\n493\t) {\n494\t    let mut mask = mask;\n495\t\n496\t    if png_ptr.is_null() || info_ptr.is_null() {\n497\t        return;\n498\t    }\n499\t\n500\t    /* Free text item num or (if num == -1) all text items */\n501\t    if !(*info_ptr).text.is_null() && ((mask & PNG_FREE_TEXT) & (*info_ptr).free_me) != 0 {\n502\t        if num != -1 {\n503\t            png_free(png_ptr, (*(*info_ptr).text.add(num as usize)).key as png_voidp);\n504\t            (*(*info_ptr).text.add(num as usize)).key = core::ptr::null_mut();\n505\t        } else {\n506\t            let mut i: c_int = 0;\n507\t\n508\t            while i < (*info_ptr).num_text {\n509\t                png_free(png_ptr, (*(*info_ptr).text.add(i as usize)).key as png_voidp);\n510\t                i += 1;\n511\t            }\n512\t\n513\t            png_free(png_ptr, (*info_ptr).text as png_voidp);\n514\t            (*info_ptr).text = core::ptr::null_mut();\n515\t            (*info_ptr).num_text = 0;\n516\t            (*info_ptr).max_text = 0;\n517\t        }\n518\t    }\n519\t\n520\t    /* Free any tRNS entry */\n521\t    if ((mask & PNG_FREE_TRNS) & (*info_ptr).free_me) != 0 {\n522\t        (*info_ptr).valid &= !PNG_INFO_tRNS;\n523\t        png_free(png_ptr, (*info_ptr).trans_alpha as png_voidp);\n524\t        (*info_ptr).trans_alpha = core::ptr::null_mut();\n525\t        (*info_ptr).num_trans = 0;\n526\t    }\n527\t\n528\t    /* Free any sCAL entry */\n529\t    if ((mask & PNG_FREE_SCAL) & (*info_ptr).free_me) != 0 {\n530\t        png_free(png_ptr, (*info_ptr).scal_s_width as png_voidp);\n531\t        png_free(png_ptr, (*info_ptr).scal_s_height as png_voidp);\n532\t        (*info_ptr).scal_s_width = core::ptr::null_mut();\n533\t        (*info_ptr).scal_s_height = core::ptr::null_mut();\n534\t        (*info_ptr).valid &= !PNG_INFO_sCAL;\n535\t    }\n536\t\n537\t    /* Free any pCAL entry */\n538\t    if ((mask & PNG_FREE_PCAL) & (*info_ptr).free_me) != 0 {\n539\t        png_free(png_ptr, (*info_ptr).pcal_purpose as png_voidp);\n540\t        png_free(png_ptr, (*info_ptr).pcal_units as png_voidp);\n541\t        (*info_ptr).pcal_purpose = core::ptr::null_mut();\n542\t        (*info_ptr).pcal_units = core::ptr::null_mut();\n543\t\n544\t        if !(*info_ptr).pcal_params.is_null() {\n545\t            let mut i: c_int = 0;\n546\t\n547\t            while i < (*info_ptr).pcal_nparams as c_int {\n548\t                png_free(png_ptr, *(*info_ptr).pcal_params.add(i as usize) as png_voidp);\n549\t                i += 1;\n550\t            }\n551\t\n552\t            png_free(png_ptr, (*info_ptr).pcal_params as png_voidp);\n553\t            (*info_ptr).pcal_params = core::ptr::null_mut();\n554\t        }\n555\t        (*info_ptr).valid &= !PNG_INFO_pCAL;\n556\t    }\n557\t\n558\t    /* Free any profile entry */\n559\t    if ((mask & PNG_FREE_ICCP) & (*info_ptr).free_me) != 0 {\n560\t        png_free(png_ptr, (*info_ptr).iccp_name as png_voidp);\n561\t        png_free(png_ptr, (*info_ptr).iccp_profile as png_voidp);\n562\t        (*info_ptr).iccp_name = core::ptr::null_mut();\n563\t        (*info_ptr).iccp_profile = core::ptr::null_mut();\n564\t        (*info_ptr).valid &= !PNG_INFO_iCCP;\n565\t    }\n566\t\n567\t    /* Free a given sPLT entry, or (if num == -1) all sPLT entries */\n568\t    if !(*info_ptr).splt_palettes.is_null()\n569\t        && ((mask & PNG_FREE_SPLT) & (*info_ptr).free_me) != 0\n570\t    {\n571\t        if num != -1 {\n572\t            png_free(\n573\t                png_ptr,\n574\t                (*(*info_ptr).splt_palettes.add(num as usize)).name as png_voidp,\n575\t            );\n576\t            png_free(\n577\t                png_ptr,\n578\t                (*(*info_ptr).splt_palettes.add(num as usize)).entries as png_voidp,\n579\t            );\n580\t            (*(*info_ptr).splt_palettes.add(num as usize)).name = core::ptr::null_mut();\n581\t            (*(*info_ptr).splt_palettes.add(num as usize)).entries = core::ptr::null_mut();\n582\t        } else {\n583\t            let mut i: c_int = 0;\n584\t\n585\t            while i < (*info_ptr).splt_palettes_num {\n586\t                png_free(\n587\t                    png_ptr,\n588\t                    (*(*info_ptr).splt_palettes.add(i as usize)).name as png_voidp,\n589\t                );\n590\t                png_free(\n591\t                    png_ptr,\n592\t                    (*(*info_ptr).splt_palettes.add(i as usize)).entries as png_voidp,\n593\t                );\n594\t                i += 1;\n595\t            }\n596\t\n597\t            png_free(png_ptr, (*info_ptr).splt_palettes as png_voidp);\n598\t            (*info_ptr).splt_palettes = core::ptr::null_mut();\n599\t            (*info_ptr).splt_palettes_num = 0;\n600\t            (*info_ptr).valid &= !PNG_INFO_sPLT;\n601\t        }\n602\t    }\n603\t\n604\t    if !(*info_ptr).unknown_chunks.is_null()\n605\t        && ((mask & PNG_FREE_UNKN) & (*info_ptr).free_me) != 0\n606\t    {\n607\t        if num != -1 {\n608\t            png_free(\n609\t                png_ptr,\n610\t                (*(*info_ptr).unknown_chunks.add(num as usize)).data as png_voidp,\n611\t            );\n612\t            (*(*info_ptr).unknown_chunks.add(num as usize)).data = core::ptr::null_mut();\n613\t        } else {\n614\t            let mut i: c_int = 0;\n615\t\n616\t            while i < (*info_ptr).unknown_chunks_num {\n617\t                png_free(\n618\t                    png_ptr,\n619\t                    (*(*info_ptr).unknown_chunks.add(i as usize)).data as png_voidp,\n620\t                );\n621\t                i += 1;\n622\t            }\n623\t\n624\t            png_free(png_ptr, (*info_ptr).unknown_chunks as png_voidp);\n625\t            (*info_ptr).unknown_chunks = core::ptr::null_mut();\n626\t            (*info_ptr).unknown_chunks_num = 0;\n627\t        }\n628\t    }\n629\t\n630\t    /* Free any eXIf entry */\n631\t    if ((mask & PNG_FREE_EXIF) & (*info_ptr).free_me) != 0 {\n632\t        if !(*info_ptr).exif.is_null() {\n633\t            png_free(png_ptr, (*info_ptr).exif as png_voidp);\n634\t            (*info_ptr).exif = core::ptr::null_mut();\n635\t        }\n636\t        (*info_ptr).valid &= !PNG_INFO_eXIf;\n637\t    }\n638\t\n639\t    /* Free any hIST entry */\n640\t    if ((mask & PNG_FREE_HIST) & (*info_ptr).free_me) != 0 {\n641\t        png_free(png_ptr, (*info_ptr).hist as png_voidp);\n642\t        (*info_ptr).hist = core::ptr::null_mut();\n643\t        (*info_ptr).valid &= !PNG_INFO_hIST;\n644\t    }\n645\t\n646\t    /* Free any PLTE entry that was internally allocated */\n647\t    if ((mask & PNG_FREE_PLTE) & (*info_ptr).free_me) != 0 {\n648\t        png_free(png_ptr, (*info_ptr).palette as png_voidp);\n649\t        (*info_ptr).palette = core::ptr::null_mut();\n650\t        (*info_ptr).valid &= !PNG_INFO_PLTE;\n651\t        (*info_ptr).num_palette = 0;\n652\t    }\n653\t\n654\t    /* Free any image bits attached to the info structure */\n655\t    if ((mask & PNG_FREE_ROWS) & (*info_ptr).free_me) != 0 {\n656\t        if !(*info_ptr).row_pointers.is_null() {\n657\t            let mut row: png_uint_32 = 0;\n658\t            while row < (*info_ptr).height {\n659\t                png_free(\n660\t                    png_ptr,\n661\t                    *(*info_ptr).row_pointers.add(row as usize) as png_voidp,\n662\t                );\n663\t                row += 1;\n664\t            }\n665\t\n666\t            png_free(png_ptr, (*info_ptr).row_pointers as png_voidp);\n667\t            (*info_ptr).row_pointers = core::ptr::null_mut();\n668\t        }\n669\t        (*info_ptr).valid &= !PNG_INFO_IDAT;\n670\t    }\n671\t\n672\t    if num != -1 {\n673\t        mask &= !PNG_FREE_MUL;\n674\t    }\n675\t\n676\t    (*info_ptr).free_me &= !mask;\n677\t}\n678\t\n679\t/* This function returns a pointer to the io_ptr associated with the user\n680\t * functions.  The application should free any memory associated with this\n681\t * pointer before png_write_destroy() or png_read_destroy() are called.\n682\t */\n683\t#[unsafe(no_mangle)]\n684\tpub unsafe extern \"C-unwind\" fn png_get_io_ptr(png_ptr: png_const_structrp) -> png_voidp {\n685\t    if png_ptr.is_null() {\n686\t        return core::ptr::null_mut();\n687\t    }\n688\t\n689\t    (*png_ptr).io_ptr\n690\t}\n691\t\n692\t/* Initialize the default input/output functions for the PNG file.  If you\n693\t * use your own read or write routines, you can call either png_set_read_fn()\n694\t * or png_set_write_fn() instead of png_init_io().  If you have defined\n695\t * PNG_NO_STDIO or otherwise disabled PNG_STDIO_SUPPORTED, you must use a\n696\t * function of your own because \"FILE *\" isn't necessarily available.\n697\t */\n698\t#[unsafe(no_mangle)]\n699\tpub unsafe extern \"C-unwind\" fn png_init_io(png_ptr: png_structrp, fp: *mut libc::FILE) {\n700\t    if png_ptr.is_null() {\n701\t        return;\n702\t    }\n703\t\n704\t    (*png_ptr).io_ptr = fp as png_voidp;\n705\t}\n706\t\n707\t/* PNG signed integers are saved in 32-bit 2's complement format.  ANSI C-90\n708\t * defines a cast of a signed integer to an unsigned integer either to preserve\n709\t * the value, if it is positive, or to calculate:\n710\t *\n711\t *     (UNSIGNED_MAX+1) + integer\n712\t *\n713\t * Where UNSIGNED_MAX is the appropriate maximum unsigned value, so when the\n714\t * negative integral value is added the result will be an unsigned value\n715\t * corresponding to the 2's complement representation.\n716\t */\n717\t#[unsafe(no_mangle)]\n718\tpub unsafe extern \"C-unwind\" fn png_save_int_32(buf: png_bytep, i: png_int_32) {\n719\t    png_save_uint_32(buf, i as png_uint_32);\n720\t}\n721\t\n722\t/* Convert the supplied time into an RFC 1123 string suitable for use in\n723\t * a \"Creation Time\" or other text-based time string.\n724\t */\n725\t#[unsafe(no_mangle)]\n726\tpub unsafe extern \"C-unwind\" fn png_convert_to_rfc1123_buffer(\n727\t    out: *mut c_char,\n728\t    ptime: png_const_timep,\n729\t) -> c_int {\n730\t    static short_mon