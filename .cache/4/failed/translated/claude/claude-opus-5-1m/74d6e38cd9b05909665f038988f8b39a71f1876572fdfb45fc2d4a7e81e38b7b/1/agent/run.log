   avail_out = avail_out.wrapping_sub(avail as png_alloc_size_t);\n603\t\n604\t            /* zlib inflate call */\n605\t            /* In fact 'avail_out' may be 0 at this point, that happens at the end\n606\t             * of the read when the final LZ end code was not passed at the end of\n607\t             * the previous chunk of input data.  Tell zlib if we have reached the\n608\t             * end of the output buffer.\n609\t             */\n610\t            ret = png_zlib_inflate(\n611\t                png_ptr,\n612\t                if avail_out > 0 {\n613\t                    Z_NO_FLUSH\n614\t                } else if finish != 0 {\n615\t                    Z_FINISH\n616\t                } else {\n617\t                    Z_SYNC_FLUSH\n618\t                },\n619\t            );\n620\t\n621\t            if !(ret == Z_OK) {\n622\t                break;\n623\t            }\n624\t        }\n625\t\n626\t        /* For safety kill the local buffer pointer now */\n627\t        if output.is_null() {\n628\t            (*png_ptr).zstream.next_out = core::ptr::null_mut();\n629\t        }\n630\t\n631\t        /* Claw back the 'size' and 'remaining_space' byte counts. */\n632\t        avail_in = avail_in.wrapping_add((*png_ptr).zstream.avail_in);\n633\t        avail_out = avail_out.wrapping_add((*png_ptr).zstream.avail_out as png_alloc_size_t);\n634\t\n635\t        /* Update the input and output sizes; the updated values are the amount\n636\t         * consumed or written, effectively the inverse of what zlib uses.\n637\t         */\n638\t        if avail_out > 0 {\n639\t            *output_size_ptr = (*output_size_ptr).wrapping_sub(avail_out);\n640\t        }\n641\t\n642\t        if avail_in > 0 {\n643\t            *input_size_ptr = (*input_size_ptr).wrapping_sub(avail_in);\n644\t        }\n645\t\n646\t        /* Ensure png_ptr->zstream.msg is set (even in the success case!) */\n647\t        png_zstream_error(png_ptr, ret);\n648\t        return ret;\n649\t    } else {