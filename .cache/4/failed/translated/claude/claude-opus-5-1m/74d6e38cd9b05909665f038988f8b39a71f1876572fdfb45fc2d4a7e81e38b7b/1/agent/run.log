25\t    length: png_uint_32,\n426\t) -> c_int {\n427\t    let mut intent: png_byte = 0;\n428\t\n429\t    png_crc_read(png_ptr, core::ptr::addr_of_mut!(intent), 1);\n430\t\n431\t    if png_crc_finish(png_ptr, 0) != 0 {\n432\t        return handled_error;\n433\t    }\n434\t\n435\t    /* This checks the range of the \"rendering intent\" because it is specified in\n436\t     * the PNG spec itself; the \"reserved\" values will result in the chunk not\n437\t     * being accepted, just as they do with the various \"reserved\" values in\n438\t     * IHDR.\n439\t     */\n440\t    if intent > 3\n441\t    /*PNGv3 spec*/\n442\t    {\n443\t        png_chunk_benign_error(png_ptr, c\"invalid\".as_ptr());\n444\t        return handled_error;\n445\t    }\n446\t\n447\t    png_set_sRGB(png_ptr, info_ptr, intent as c_int);\n448\t    /* NOTE: png_struct::chromaticities is not set here because the RGB to gray\n449\t     * coefficients are known without a need for the chromaticities.\n450\t     */\n451\t\n452\t    /* READ_GAMMA */\n453\t    /* PNGv3: chunk precedence for gamma is cICP, [iCCP], sRGB, gAMA.  iCCP is\n454\t     * not supported by libpng so the only requirement is to check for cICP\n455\t     * setting the gamma (this is NYI, but this check is safe.)\n456\t     */\n457\t    if ((*png_ptr).chunks & png_chunk_flag_from_index(PNG_INDEX_cICP)) == 0\n458\t        || (*png_ptr).chunk_gamma == 0\n459\t    {\n460\t        (*png_ptr).chunk_gamma = PNG_GAMMA_sRGB_INVERSE;\n461\t    }\n462\t    /* READ_GAMMA */\n463\t\n464\t    handled_ok\n465\t}\n466\t/* READ_sRGB */\n467\t\n468\t/* READ_iCCP */\n469\t/* Note: this does not properly handle profiles that are > 64K under DOS */\n470\tpub(crate) unsafe fn png_handle_iCCP(\n471\t    png_ptr: png_structrp,\n472\t    info_ptr: png_inforp,\n473\t    mut length: png_uint_32,\n474\t) -> c_int {\n475\t    let mut errmsg: png_const_charp = core::ptr::null(); /* error message output, or no error */\n476\t    let mut finished: c_int = 0; /* crc checked */\n477\t\n478\t    /* PNGv3: allow PNG files with both sRGB and iCCP because the PNG spec only\n479\t     * ever said that there \"should\" be only one, not \"shall\" and the PNGv3\n480\t     * colour chunk precedence rules give a handling for this case anyway.\n481\t     */\n482\t    {\n483\t        let mut read_length: u32;\n484\t        let mut keyword_length: u32;\n485\t        let mut keyword: [c_char; 81] = [0; 81];\n486\t\n487\t        /* Find the keyword; the keyword plus separator and compression method\n488\t         * bytes can be at most 81 characters long.\n489\t         */\n490\t        read_length = 81; /* maximum */\n491\t        if read_length > length {\n492\t            read_length = length /*SAFE*/;\n493\t        }\n494\t\n495\t        png_crc_read(png_ptr, keyword.as_mut_ptr() as png_bytep, read_length);\n496\t        length = length.wrapping_sub(read_length);\n497\t\n498\t        if length < LZ77Min {\n499\t            png_crc_finish(png_ptr, length);\n500\t            png_chunk_benign_error(png_ptr, c\"too short\".as_ptr());\n501\t            return handled_error;\n502\t        }\n503\t\n504\t        keyword_length = 0;\n505\t        while keyword_length < 80\n506\t            && keyword_length < read_length\n507\t            && keyword[keyword_length as usize] != 0\n508\t        {\n509\t            keyword_length = keyword_length.wrapping_add(1);\n510\t        }\n511\t\n512\t        /* TODO: make the keyword checking common */\n513\t        if keyword_length >= 1 && keyword_length <= 79 {\n514\t            /* We only understand '0' compression - deflate - so if we get a\n515\t             * different value we can't safely decode the chunk.\n516\t             */\n517\t            if keyword_length.wrapping_add(1) < read_length\n518\t                && keyword[keyword_length.wrapping_add(1) as usize]\n519\t                    == PNG_COMPRESSION_TYPE_BASE as c_char\n520\t            {\n521\t                read_length = read_length.wrapping_sub(keyword_length.wrapping_add(2));\n522\t\n523\t                if png_inflate_claim(png_ptr, png_iCCP) == Z_OK {\n524\t                    let mut profile_header: [png_byte; 132] = [0; 132];\n525\t                    let mut local_buffer: [png_byte; PNG_INFLATE_BUF_SIZE] =\n526\t                        [0; PNG_INFLATE_BUF_SIZE];\n527\t                    let mut size: png_alloc_size_t =\n528\t                        core::mem::size_of::<[png_byte; 132]>() as png_alloc_size_t;\n529\t\n530\t                    (*png_ptr).zstream.next_in = (keyword.as_ptr() as *const png_byte)\n531\t                        .add(keyword_length.wrapping_add(2) as usize);\n532\t                    (*png_ptr).zstream.avail_in = read_length;\n533\t                    png_inflate_read(\n534\t                        png_ptr,\n535\t                        local_buffer.as_mut_ptr(),\n536\t                        core::mem::size_of::<[png_byte; PNG_INFLATE_BUF_SIZE]>() as u32,\n537\t                        core::ptr::addr_of_mut!(length),\n538\t                        profile_header.as_mut_ptr(),\n539\t                        core::ptr::addr_of_mut!(size),\n540\t                        0, /*finish: don't, because the output is too small*/\n541\t                    );\n542\t\n543\t                    if size == 0 {\n544\t                        /* We have the ICC profile header; do the basic header checks. */\n545\t                        let profile_length: png_uint_32 =\n546\t                            PNG_get_uint_32(profile_header.as_ptr());\n547\t\n548\t                        if png_icc_check_length(png_ptr, keyword.as_ptr(), profile_length) != 0 {\n549\t                            /* The length is apparently ok, so we can check the 132\n550\t                             * byte header.\n551\t                             */\n552\t                            if png_icc_check_header(\n553\t                                png_ptr,\n554\t                                keyword.as_ptr(),\n555\t                                profile_length,\n556\t                                profile_header.as_ptr(),\n557\t                                (*png_ptr).color_type as c_int,\n558\t                            ) != 0\n559\t                            {\n560\t                                /* Now read the tag table; a variable size buffer is\n561\t                                 * needed at this point, allocate one for the whole\n562\t                                 * profile.  The header check has already validated\n563\t                                 * that none of this stuff will overflow.\n564\t                                 */\n565\t                                let tag_count: png_uint_32 =\n566\t                                    PNG_get_uint_32(profile_header.as_ptr().add(128));\n567\t                                let profile: png_bytep =\n568\t                                    png_read_buffer(png_ptr, profile_length as png_alloc_size_t);\n569\t\n570\t                                if !profile.is_null() {\n571\t                                    memcpy(\n572\t                                        profile,\n573\t                                        profile_header.as_ptr(),\n574\t                                        core::mem::size_of::<[png_byte; 132]>(),\n575\t                                    );\n576\t\n577\t                                    size = 12u32.wrapping_mul(tag_count) as png_alloc_size_t;\n578\t\n579\t                                    png_inflate_read(\n580\t                                        png_ptr,\n581\t                                        local_buffer.as_mut_ptr(),\n582\t                                        core::mem::size_of::<[png_byte; PNG_INFLATE_BUF_SIZE]>()\n583\t                                            as u32,\n584\t                                        core::ptr::addr_of_mut!(length),\n585\t                                        profile.add(core::mem::size_of::<[png_byte; 132]>()),\n586\t                                        core::ptr::addr_of_mut!(size),\n587\t                                        0,\n588\t                                    );\n589\t\n590\t                                    /* Still expect a buffer error because we expect\n591\t                                     * there to be some tag data!\n592\t                                     */\n593\t                                    if size == 0 {\n594\t                                        if png_icc_check_tag_table(\n595\t                                            png_ptr,\n596\t                                            keyword.as_ptr(),\n597\t                                            profile_length,\n598\t                                            profile,\n599\t                                        ) != 0\n600\t                                        {\n601\t                                            /* The profile has been validated for basic\n602\t                                             * security issues, so read the whole thing in.\n603\t                                             */\n604\t                                            size = (profile_length as png_alloc_size_t)\n605\t                                                .wrapping_sub(\n606\t                                                    core::mem::size_of::<[png_byte; 132]>(),\n607\t                                                )\n608\t                                                .wrapping_sub(\n609\t                                                    12u32.wrapping_mul(tag_count)\n610\t                                                        as png_alloc_size_t,\n611\t                                                );\n612\t\n613\t                                            png_inflate_read(\n614\t                                                png_ptr,\n615\t                                                local_buffer.as_mut_ptr(),\n616\t                                                core::mem::size_of::<\n617\t                                                    [png_byte; PNG_INFLATE_BUF_SIZE],\n618\t                                                >() as u32,\n619\t                                                core::ptr::addr_of_mut!(length),\n620\t                                                profile\n621\t                                                    .add(core::mem::size_of::<[png_byte; 132]>())\n622\t                                                    .add(12u32.wrapping_mul(tag_count) as usize),\n623\t                                                core::ptr::addr_of_mut!(size),\n624\t                                                1, /*finish*/\n625\t                                            );\n626\t\n627\t                                            if length > 0\n628\t                                                && ((*png_ptr).flags\n629\t                                                    & PNG_FLAG_BENIGN_ERRORS_WARN)\n630\t                                                    == 0\n631\t                                            {\n632\t                                                errmsg = c\"extra compressed data\".as_ptr();\n633\t                                            }\n634\t                                            /* But otherwise allow extra data: */\n635\t                                            else if size == 0 {\n636\t                                                if length > 0 {\n637\t                                                    /* This can be handled completely, so\n638\t                                                     * keep going.\n639\t                                                     */\n640\t                                                    png_chunk_warning(\n641\t                                                        png_ptr,\n642\t                                                        c\"extra compressed data\".as_ptr(),\n643\t                                                    );\n644\t                                                }\n645\t\n646\t                                                png_crc_finish(png_ptr, length);\n647\t                                                finished = 1;\n648\t\n649\t                                                /* Steal the profile for info_ptr. */\n650\t                                                if !info_ptr.is_null() {\n651\t                                                    png_free_data(\n652\t                                                        png_ptr,\n653\t                                                        info_ptr,\n654\t                                                        PNG_FREE_ICCP,\n655\t                                                        0,\n656\t                                                    );\n657\t\n658\t                                                    (*info_ptr).iccp_name = png_malloc_base(\n659\t                                                        png_ptr,\n660\t                                                        keyword_length.wrapping_add(1)\n661\t                                                            as png_alloc_size_t,\n662\t                                                    ) as png_charp;\n663\t                                                    if !(*info_ptr).iccp_name.is_null() {\n664\t                                                        memcpy(\n665\t                                                            (*info_ptr).iccp_name as *mut u8,\n666\t                                                            keyword.as_ptr() as *const u8,\n667\t                                                            keyword_length.wrapping_add(1)\n668\t                                                                as usize,\n669\t                                                        );\n670\t                                                        (*info_ptr).iccp_proflen = profile_length;\n671\t                                                        (*info_ptr).iccp_profile = profile;\n672\t                                                        (*png_ptr).read_buffer =\n673\t                                                            core::ptr::null_mut(); /*steal*/\n674\t                                                        (*info_ptr).free_me |= PNG_FREE_ICCP;\n675\t                                                        (*info_ptr).valid |= PNG_INFO_iCCP;\n676\t                                                    } else {\n677\t                                                        errmsg = c\"out of memory\".as_ptr();\n678\t                                                    }\n679\t                                                }\n680\t\n681\t                                                /* else the profile remains in the read\n682\t                                                 * buffer which gets reused for subsequent\n683\t                                                 * chunks.\n684\t                                                 */\n685\t\n686\t                                                if errmsg.is_null() {\n687\t                                                    (*png_ptr).zowner = 0;\n688\t                                                    return handled_ok;\n689\t                                                }\n690\t                                            }\n691\t                                            if errmsg.is_null() {\n692\t                                                errmsg = (*png_ptr).zstream.msg;\n693\t                                            }\n694\t                                        }\n695\t                                        /* else png_icc_check_tag_table output an error */\n696\t                                    } else\n697\t                                    /* profile truncated */\n698\t                                    {\n699\t                                        errmsg = (*png_ptr).zstream.msg;\n700\t                                    }\n701\t                                } else {\n702\t                                    errmsg = c\"out of memory\".as_ptr();\n703\t                                }\n704\t                            }\n705\t\n706\t                            /* else png_icc_check_header output an error */\n707\t                        }\n708\t\n709\t                        /* else png_icc_check_length output an error */\n710\t                    } else\n711\t                    /* profile truncated */\n712\t                    {\n713\t                        errmsg = (*png_ptr).zstream.msg;\n714\t                    }\n715\t\n716\t                    /* Release the stream */\n717\t                    (*png_ptr).zowner = 0;\n718\t                } else\n719\t                /* png_inflate_claim failed */\n720\t                {\n721\t                    errmsg = (*png_ptr).zstream.msg;\n722\t                }\n723\t            } else {\n724\t                errmsg = c\"bad compression method\".as_ptr(); /* or missing */\n725\t            }\n726\t        } else {\n727\t            errmsg = c\"bad keyword\".as_ptr();\n728\t        }\n729\t    }\n730\t\n731\t    /* Failure: the reason is in 'errmsg' */\n732\t    if finished == 0 {\n733\t        png_crc_finish(png_ptr, length);\n734\t    }\n735\t\n736\t    if !errmsg.is_null()\n737\t    /* else already output */\n738\t    {\n739\t        png_chunk_benign_error(png_ptr, errmsg);\n740\t    }\n741\t\n742\t    handled_error\n743\t}\n744\t/* READ_iCCP */\n745\t\n746\t/* READ_sPLT */\n747\t/* Note: this does not properly handle chunks that are > 64K under DOS */\n748\tpub(crate) unsafe fn png_handle_sPLT(\n749\t    png_ptr: png_structrp,\n750\t    info_ptr: png_inforp,\n751\t    length: png_uint_32,\n752\t) -> c_int {\n753\t    let buffer: png_bytep;\n754\t    let mut entry_start: png_bytep;\n755\t    let mut new_palette: png_sPLT_t = png_sPLT_t {\n756\t        name: core::ptr::null_mut(),\n757\t