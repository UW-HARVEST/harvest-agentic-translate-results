rmations |= PNG_INVERT_MONO;\n226\t}\n227\t\n228\t/* Invert monochrome grayscale data */\n229\t#[unsafe(no_mangle)]\n230\tpub unsafe extern \"C-unwind\" fn png_do_invert(row_info: png_row_infop, row: png_bytep) {\n231\t    /* This test removed from libpng version 1.0.13 and 1.2.0:\n232\t     *   if (row_info->bit_depth == 1 &&\n233\t     */\n234\t    if (*row_info).color_type as c_int == PNG_COLOR_TYPE_GRAY {\n235\t        let mut rp: png_bytep = row;\n236\t        let mut i: usize;\n237\t        let istop: usize = (*row_info).rowbytes;\n238\t\n239\t        i = 0;\n240\t        while i < istop {\n241\t            *rp = !(*rp);\n242\t            rp = rp.add(1);\n243\t            i += 1;\n244\t        }\n245\t    } else if (*row_info).color_type as c_int == PNG_COLOR_TYPE_GRAY_ALPHA\n246\t        && (*row_info).bit_depth == 8\n247\t    {\n248\t        let mut rp: png_bytep = row;\n249\t        let mut i: usize;\n250\t        let istop: usize = (*row_info).rowbytes;\n251\t\n252\t        i = 0;\n253\t        while i < istop {\n254\t            *rp = !(*rp);\n255\t            rp = rp.add(2);\n256\t            i += 2;\n257\t        }\n258\t    } else if (*row_info).color_type as c_int == PNG_COLOR_TYPE_GRAY_ALPHA\n259\t        && (*row_info).bit_depth == 16\n260\t    {\n261\t        let mut rp: png_bytep = row;\n262\t        let mut i: usize;\n263\t        let istop: usize = (*row_info).rowbytes;\n264\t\n265\t        i = 0;\n266\t        while i < istop {\n267\t            *rp = !(*rp);\n268\t            *rp.add(1) = !(*rp.add(1));\n269\t            rp = rp.add(4);\n270\t            i += 4;\n271\t        }\n272\t    }\n273\t}\n274\t\n275\t/* Swaps byte order on 16-bit depth images */\n276\t#[unsafe(no_mangle)]\n277\tpub unsafe extern \"C-unwind\" fn png_do_swap(row_info: png_row_infop, row: png_bytep) {\n278\t    if (*row_info).bit_depth == 16 {\n279\t        let mut rp: png_bytep = row;\n280\t        let mut i: png_uint_32;\n281\t        let istop: png_uint_32 = (*row_info).width.wrapping_mul((*row_info).channels as png_uint_32);\n282\t\n283\t        i = 0;\n284\t        while i < istop {\n285\t            let t: png_byte = *rp;\n286\t            *rp = *rp.add(1);\n287\t            *rp.add(1) = t;\n288\t\n289\t            i = i.wrapping_add(1);\n290\t            rp = rp.add(2);\n291\t        }\n292\t    }\n293\t}\n294\t\n295\tstatic onebppswaptable: [png_byte; 256] = [\n296\t    0x00, 0x80, 0x40, 0xC0, 0x20, 0xA0, 0x60, 0xE0, 0x10, 0x90, 0x50, 0xD0, 0x30, 0xB0, 0x70, 0xF0,\n297\t    0x08, 0x88, 0x48, 0xC8, 0x28, 0xA8, 0x68, 0xE8, 0x18, 0x98, 0x58, 0xD8, 0x38, 0xB8, 0x78, 0xF8,\n298\t    0x04, 0x84, 0x44, 0xC4, 0x24, 0xA4, 0x64, 0xE4, 0x14, 0x94, 0x54, 0xD4, 0x34, 0xB4, 0x74, 0xF4,\n299\t    0x0C, 0x8C, 0x4C, 0xCC, 0x2C, 0xAC, 0x6C, 0xEC, 0x1C, 0x9C, 0x5C, 0xDC, 0x3C, 0xBC, 0x7C, 0xFC,\n300\t    0x02, 0x82, 0x42, 0xC2, 0x22, 0xA2, 0x62, 0xE2, 0x12, 0x92, 0x52, 0xD2, 0x32, 0xB2, 0x72, 0xF2,\n301\t    0x0A, 0x8A, 0x4A, 0xCA, 0x2A, 0xAA, 0x6A, 0xEA, 0x1A, 0x9A, 0x5A, 0xDA, 0x3A, 0xBA, 0x7A, 0xFA,\n302\t    0x06, 0x86, 0x46, 0xC6, 0x26, 0xA6, 0x66, 0xE6, 0x16, 0x96, 0x56, 0xD6, 0x36, 0xB6, 0x76, 0xF6,\n303\t    0x0E, 0x8E, 0x4E, 0xCE, 0x2E, 0xAE, 0x6E, 0xEE, 0x1E, 0x9E, 0x5E, 0xDE, 0x3E, 0xBE, 0x7E, 0xFE,\n304\t    0x01, 0x81, 0x41, 0xC1, 0x21, 0xA1, 0x61, 0xE1, 0x11, 0x91, 0x51, 0xD1, 0x31, 0xB1, 0x71, 0xF1,\n305\t    0x09, 0x89, 0x49, 0xC9, 0x29, 0xA9, 0x69, 0xE9, 0x19, 0x99, 0x59, 0xD9, 0x39, 0xB9, 0x79, 0xF9,\n306\t    0x05, 0x85, 0x45, 0xC5, 0x25, 0xA5, 0x65, 0xE5, 0x15, 0x95, 0x55, 0xD5, 0x35, 0xB5, 0x75, 0xF5,\n307\t    0x0D, 0x8D, 0x4D, 0xCD, 0x2D, 0xAD, 0x6D, 0xED, 0x1D, 0x9D, 0x5D, 0xDD, 0x3D, 0xBD, 0x7D, 0xFD,\n308\t    0x03, 0x83, 0x43, 0xC3, 0x23, 0xA3, 0x63, 0xE3, 0x13, 0x93, 0x53, 0xD3, 0x33, 0xB3, 0x73, 0xF3,\n309\t    0x0B, 0x8B, 0x4B, 0xCB, 0x2B, 0xAB, 0x6B, 0xEB, 0x1B, 0x9B, 0x5B, 0xDB, 0x3B, 0xBB, 0x7B, 0xFB,\n310\t    0x07, 0x87, 0x47, 0xC7, 0x27, 0xA7, 0x67, 0xE7, 0x17, 0x97, 0x57, 0xD7, 0x37, 0xB7, 0x77, 0xF7,\n31