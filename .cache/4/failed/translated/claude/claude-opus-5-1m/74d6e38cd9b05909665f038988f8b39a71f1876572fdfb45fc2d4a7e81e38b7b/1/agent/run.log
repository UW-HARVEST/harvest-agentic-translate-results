{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_018TbG94VEBi5pVfgJ3g1tqt","type":"tool_result","content":"1\t// png_p2.rs -- part 2 of the translation of c_src/src/png.c (lines 1068..1958)\n2\t//\n3\t// Covers png_fp_add .. png_set_rgb_coefficients.\n4\t\n5\t/* PNG_COLORSPACE_SUPPORTED */\n6\tpub(crate) unsafe fn png_fp_add(\n7\t    addend0: png_int_32,\n8\t    addend1: png_int_32,\n9\t    error: *mut c_int,\n10\t) -> png_int_32 {\n11\t    /* Safely add two fixed point values setting an error flag and returning 0.5\n12\t     * on overflow.\n13\t     * IMPLEMENTATION NOTE: ANSI requires signed overflow not to occur, therefore\n14\t     * relying on addition of two positive values producing a negative one is not\n15\t     * safe.\n16\t     */\n17\t    if addend0 > 0 {\n18\t        if 0x7fffffff_i32.wrapping_sub(addend0) >= addend1 {\n19\t            return addend0.wrapping_add(addend1);\n20\t        }\n21\t    } else if addend0 < 0 {\n22\t        if (-0x7fffffff_i32).wrapping_sub(addend0) <= addend1 {\n23\t            return addend0.wrapping_add(addend1);\n24\t        }\n25\t    } else {\n26\t        return addend1;\n27\t    }\n28\t\n29\t    *error = 1;\n30\t    PNG_FP_1 / 2\n31\t}\n32\t\n33\tpub(crate) unsafe fn png_fp_sub(\n34\t    addend0: png_int_32,\n35\t    addend1: png_int_32,\n36\t    error: *mut c_int,\n37\t) -> png_int_32 {\n38\t    /* As above but calculate addend0-addend1. */\n39\t    if addend1 > 0 {\n40\t        if (-0x7fffffff_i32).wrapping_add(addend1) <= addend0 {\n41\t            return addend0.wrapping_sub(addend1);\n42\t        }\n43\t    } else if addend1 < 0 {\n44\t        if 0x7fffffff_i32.wrapping_add(addend1) >= addend0 {\n45\t            return addend0.wrapping_sub(addend1);\n46\t        }\n47\t    } else {\n48\t        return addend0;\n49\t    }\n50\t\n51\t    *error = 1;\n52\t    PNG_FP_1 / 2\n53\t}\n54\t\n55\tpub(crate) unsafe fn png_safe_add(\n56\t    addend0_and_result: *mut png_int_32,\n57\t    addend1: png_int_32,\n58\t    addend2: png_int_32,\n59\t) -> c_int {\n60\t    /* Safely add three integers.  Returns 0 on success, 1 on overflow.  Does not\n61\t     * set the result on overflow.\n62\t     */\n63\t    let mut error: c_int = 0;\n64\t    let inner: png_int_32 = png_fp_add(addend1, addend2, &mut error);\n65\t    let result: c_int = png_fp_add(*addend0_and_result, inner, &mut error);\n66\t    if error == 0 {\n67\t        *addend0_and_result = result;\n68\t    }\n69\t    error\n70\t}\n71\t\n72\t/* Added at libpng-1.5.5 to support read and write of true CIEXYZ values for\n73\t * cHRM, as opposed to using chromaticities.  These internal APIs return\n74\t * non-zero on a parameter error.  The X, Y and Z values are required to be\n75\t * positive and less than 1.0.\n76\t */\n77\t#[unsafe(no_mangle)]\n78\tpub unsafe extern \"C-unwind\" fn png_xy_from_XYZ(xy: *mut png_xy, XYZ: *const png_XYZ) -> c_int {\n79\t    /* NOTE: returns 0 on success, 1 means error. */\n80\t    let mut d: png_int_32;\n81\t    let dred: png_int_32;\n82\t    let dgreen: png_int_32;\n83\t    let dblue: png_int_32;\n84\t    let dwhite: png_int_32;\n85\t    let whiteX: png_int_32;\n86\t    let whiteY: png_int_32;\n87\t\n88\t    /* 'd' in each of the blocks below is just X+Y+Z for each component,\n89\t     * x, y and z are X,Y,Z/(X+Y+Z).\n90\t     */\n91\t    d = (*XYZ).red_X;\n92\t    if png_safe_add(&mut d, (*XYZ).red_Y, (*XYZ).red_Z) != 0 {\n93\t        return 1;\n94\t    }\n95\t    dred = d;\n96\t    if png_muldiv(\n97\t        core::ptr::addr_of_mut!((*xy).redx),\n98\t        (*XYZ).red_X,\n99\t        PNG_FP_1,\n100\t        dred,\n101\t    ) == 0\n102\t    {\n103\t        return 1;\n104\t    }\n105\t    if png_muldiv(\n106\t        core::ptr::addr_of_mut!((*xy).redy),\n107\t        (*XYZ).red_Y,\n108\t        PNG_FP_1,\n109\t        dred,\n110\t    ) == 0\n111\t    {\n112\t        return 1;\n113\t    }\n114\t\n115\t    d = (*XYZ).green_X;\n116\t    if png_safe_add(&mut d, (*XYZ).green_Y, (*XYZ).green_Z) != 0 {\n117\t        return 1;\n118\t    }\n119\t    dgreen = d;\n120\t    if png_muldiv(\n121\t        core::ptr::addr_of_mut!((*xy).greenx),\n122\t        (*XYZ).green_X,\n123\t        PNG_FP_1,\n124\t        dgreen,\n125\t    ) == 0\n126\t    {\n127\t        return 1;\n128\t    }\n129\t    if png_muldiv(\n130\t        core::ptr::addr_of_mut!((*xy).greeny),\n131\t        (*XYZ).green_Y,\n132\t        PNG_FP_1,\n133\t        dgreen,\n134\t    ) == 0\n135\t    {\n136\t        return 1;\n137\t    }\n138\t\n139\t    d = (*XYZ).blue_X;\n140\t    if png_safe_add(&mut d, (*XYZ).blue_Y, (*XYZ).blue_Z) != 0 {\n141\t        return 1;\n142\t    }\n143\t    dblue = d;\n144\t    if png_muldiv(\n145\t        core::ptr::addr_of_mut!((*xy).bluex),\n146\t        (*XYZ).blue_X,\n147\t        PNG_FP_1,\n148\t        dblue,\n149\t    ) == 0\n150\t    {\n151\t        return 1;\n152\t    }\n153\t    if png_muldiv(\n154\t        core::ptr::addr_of_mut!((*xy).bluey),\n155\t        (*XYZ).blue_Y,\n156\t        PNG_FP_1,\n157\t        dblue,\n158\t    ) == 0\n159\t    {\n160\t        return 1;\n161\t    }\n162\t\n163\t    /* The reference white is simply the sum of the end-point (X,Y,Z) vectors so\n164\t     * the following calculates (X+Y+Z) of the reference white (media white,\n165\t     * encoding white) itself:\n166\t     */\n167\t    d = dblue;\n168\t    if png_safe_add(&mut d, dred, dgreen) != 0 {\n169\t        return 1;\n170\t    }\n171\t    dwhite = d;\n172\t\n173\t    /* Find the white X,Y values from the sum of the red, green and blue X,Y\n174\t     * values.\n175\t     */\n176\t    d = (*XYZ).red_X;\n177\t    if png_safe_add(&mut d, (*XYZ).green_X, (*XYZ).blue_X) != 0 {\n178\t        return 1;\n179\t    }\n180\t    whiteX = d;\n181\t\n182\t    d = (*XYZ).red_Y;\n183\t    if png_safe_add(&mut d, (*XYZ).green_Y, (*XYZ).blue_Y) != 0 {\n184\t        return 1;\n185\t    }\n186\t    whiteY = d;\n187\t\n188\t    if png_muldiv(\n189\t        core::ptr::addr_of_mut!((*xy).whitex),\n190\t        whiteX,\n191\t        PNG_FP_1,\n192\t        dwhite,\n193\t    ) == 0\n194\t    {\n195\t        return 1;\n196\t    }\n197\t    if png_muldiv(\n198\t        core::ptr::addr_of_mut!((*xy).whitey),\n199\t        whiteY,\n200\t        PNG_FP_1,\n201\t        dwhite,\n202\t    ) == 0\n203\t    {\n204\t        return 1;\n205\t    }\n206\t\n207\t    0\n208\t}\n209\t\n210\t#[unsafe(no_mangle)]\n211\tpub unsafe extern \"C-unwind\" fn png_XYZ_from_xy(XYZ: *mut png_XYZ, xy: *const png_xy) -> c_int {\n212\t    /* NOTE: returns 0 on success, 1 means error. */\n213\t    let mut red_inverse: png_fixed_point = 0;\n214\t    let mut green_inverse: png_fixed_point = 0;\n215\t    let blue_scale: png_fixed_point;\n216\t    let mut left: png_fixed_point = 0;\n217\t    let mut right: png_fixed_point = 0;\n218\t    let denominator: png_fixed_point;\n219\t\n220\t    /* Check xy and, implicitly, z.  Note that wide gamut color spaces typically\n221\t     * have end points with 0 tristimulus values (these are impossible end\n222\t     * points, but they are used to cover the possible colors).  We check\n223\t     * xy->whitey against 5, not 0, to avoid a possible integer overflow.\n224\t     *\n225\t     * The limits here will *not* accept ACES AP0, where bluey is -7700\n226\t     * (-0.0770) because the PNG spec itself requires the xy values to be\n227\t     * unsigned.  whitey is also required to be 5 or more to avoid overflow.\n228\t     *\n229\t     * Instead the upper limits have been relaxed to accommodate ACES AP1 where\n230\t     * redz ends up as -600 (-0.006).  ProPhotoRGB was already \"in range.\"\n231\t     * The new limit accommodates the AP0 and AP1 ranges for z but not AP0 redy.\n232\t     */\n233\t    let fpLimit: png_fixed_point = PNG_FP_1 + (PNG_FP_1 / 10);\n234\t    if (*xy).redx < 0 || (*xy).redx > fpLimit {\n235\t        return 1;\n236\t    }\n237\t    if (*xy).redy < 0 || (*xy).redy > fpLimit - (*xy).redx {\n238\t        return 1;\n239\t    }\n240\t    if (*xy).greenx < 0 || (*xy).greenx > fpLimit {\n241\t        return 1;\n242\t    }\n243\t    if (*xy).greeny < 0 || (*xy).greeny > fpLimit - (*xy).greenx {\n244\t        return 1;\n245\t    }\n246\t    if (*xy).bluex < 0 || (*xy).bluex > fpLimit {\n247\t        return 1;\n248\t    }\n249\t    if (*xy).bluey < 0 || (*xy).bluey > fpLimit - (*xy).bluex {\n250\t        return 1;\n251\t    }\n252\t    if (*xy).whitex < 0 || (*xy).whitex > fpLimit {\n253\t        return 1;\n254\t    }\n255\t    if (*xy).whitey < 5 || (*xy).whitey > fpLimit - (*xy).whitex {\n256\t        return 1;\n257\t    }\n258\t\n259\t    /* The reverse calculation is more difficult because the original tristimulus\n260\t     * value had 9 independent values (red,green,blue)x(X,Y,Z) however only 8\n261\t     * derived values were recorded in the cHRM chunk;\n262\t     * (red,green,blue,white)x(x,y).  This loses one degree of freedom and\n263\t     * therefore an arbitrary ninth value has to be introduced to undo the\n264\t     * original transformations.\n265\t     *\n266\t     * Think of the original end-points as points in (X,Y,Z) space.  The\n267\t     * chromaticity values (c) have the property:\n268\t     *\n269\t     *           C\n270\t     *   c = ---------\n271\t     *       X + Y + Z\n272\t     *\n273\t     * For each c (x,y,z) from the corresponding original C (X,Y,Z).  Thus the\n274\t     * three chromaticity values (x,y,z) for each end-point obey the\n275\t     * relationship:\n276\t     *\n277\t     *   x + y + z = 1\n278\t     *\n279\t     * This describes the plane in (X,Y,Z) space that intersects each axis at the\n280\t     * value 1.0; call this the chromaticity plane.  Thus the chromaticity\n281\t     * calculation has scaled each end-point so that it is on the x+y+z=1 plane\n282\t     * and chromaticity is the intersection of the vector from the origin to the\n283\t     * (X,Y,Z) value with the chromaticity plane.\n284\t     *\n285\t     * To fully invert the chromaticity calculation we would need the three\n286\t     * end-point scale factors, (red-scale, green-scale, blue-scale), but these\n287\t     * were not recorded.  Instead we calculated the reference white (X,Y,Z) and\n288\t     * recorded the chromaticity of this.  The reference white (X,Y,Z) would have\n289\t     * given all three of the scale factors since:\n290\t     *\n291\t     *    color-C = color-c * color-scale\n292\t     *    white-C = red-C + green-C + blue-C\n293\t     *            = red-c*red-scale + green-c*green-scale + blue-c*blue-scale\n294\t     *\n295\t     * But cHRM records only white-x and white-y, so we have lost the white scale\n296\t     * factor:\n297\t     *\n298\t     *    white-C = white-c*white-scale\n299\t     *\n300\t     * To handle this the inverse transformation makes an arbitrary assumption\n301\t     * about white-scale:\n302\t     *\n303\t     *    Assume: white-Y = 1.0\n304\t     *    Hence:  white-scale = 1/white-y\n305\t     *    Or:     red-Y + green-Y + blue-Y = 1.0\n306\t     *\n307\t     * Notice the last statement of the assumption gives an equation in three of\n308\t     * the nine values we want to calculate.  8 more equations come from the\n309\t     * above routine as summarised at the top above (the chromaticity\n310\t     * calculation):\n311\t     *\n312\t     *    Given: color-x = color-X / (color-X + color-Y + color-Z)\n313\t     *    Hence: (color-x - 1)*color-X + color.x*color-Y + color.x*color-Z = 0\n314\t     *\n315\t     * This is 9 simultaneous equations in the 9 variables \"color-C\" and can be\n316\t     * solved by Cramer's rule.  Cramer's rule requires calculating 10 9x9 matrix\n317\t     * determinants, however this is not as bad as it seems because only 28 of\n318\t     * the total of 90 terms in the various matrices are non-zero.  Nevertheless\n319\t     * Cramer's rule is notoriously numerically unstable because the determinant\n320\t     * calculation involves the difference of large, but similar, numbers.  It is\n321\t     * difficult to be sure that the calculation is stable for real world values\n322\t     * and it is certain that it becomes unstable where the end points are close\n323\t     * together.\n324\t     *\n325\t     * So this code uses the perhaps slightly less optimal but more\n326\t     * understandable and totally obvious approach of calculating color-scale.\n327\t     *\n328\t     * This algorithm depends on the precision in white-scale and that is\n329\t     * (1/white-y), so we can immediately see that as white-y approaches 0 the\n330\t     * accuracy inherent in the cHRM chunk drops off substantially.\n331\t     *\n332\t     * libpng arithmetic: a simple inversion of the above equations\n333\t     * ------------------------------------------------------------\n334\t     *\n335\t     *    white_scale = 1/white-y\n336\t     *    white-X = white-x * white-scale\n337\t     *    white-Y = 1.0\n338\t     *    white-Z = (1 - white-x - white-y) * white_scale\n339\t     *\n340\t     *    white-C = red-C + green-C + blue-C\n341\t     *            = red-c*red-scale + green-c*green-scale + blue-c*blue-scale\n342\t     *\n343\t     * This gives us three equations in (red-scale,green-scale,blue-scale) where\n344\t     * all the coefficients are now known:\n345\t     *\n346\t     *    red-x*red-scale + green-x*green-scale + blue-x*blue-scale\n347\t     *       = white-x/white-y\n348\t     *    red-y*red-scale + green-y*green-scale + blue-y*blue-scale = 1\n349\t     *    red-z*red-scale + green-z*green-scale + blue-z*blue-scale\n350\t     *       = (1 - white-x - white-y)/white-y\n351\t     *\n352\t     * In the last equation color-z is (1 - color-x - color-y) so we can add all\n353\t     * three equations together to get an alternative third:\n354\t     *\n355\t     *    red-scale + green-scale + blue-scale = 1/white-y = white-scale\n356\t     *\n357\t     * So now we have a Cramer's rule solution where the determinants are just\n358\t     * 3x3 - far more tractable.  Unfortunately 3x3 determinants still involve\n359\t     * multiplication of three coefficients so we can't guarantee to avoid\n360\t     * overflow in the libpng fixed point representation.  Using Cramer's rule in\n361\t     * floating point is probably a good choice here, but it's not an option for\n362\t     * fixed point.  Instead proceed to simplify the first two equations by\n363\t     * eliminating what is likely to be the largest value, blue-scale:\n364\t     *\n365\t     *    blue-scale = white-scale - red-scale - green-scale\n366\t     *\n367\t     * Hence:\n368\t     *\n369\t     *    (red-x - blue-x)*red-scale + (green-x - blue-x)*green-scale =\n370\t     *                (white-x - blue-x)*white-scale\n371\t     *\n372\t     *    (red-y - blue-y)*red-scale + (green-y - blue-y)*green-scale =\n373\t     *                1 - blue-y*white-scale\n374\t     *\n375\t     * And now we can trivially solve for (red-scale,green-scale):\n376\t     *\n377\t     *    green-scale =\n378\t     *                (white-x - blue-x)*white-scale - (red-x - blue-x)*red-scale\n379\t     *                -----------------------------------------------------------\n380\t     *                                  green-x - blue-x\n381\t     *\n382\t     *    red-scale =\n383\t     *                1 - blue-y*white-scale - (green-y - blue-y) * green-scale\n384\t     *                ---------------------------------------------------------\n385\t     *                                  red-y - blue-y\n386\t     *\n387\t     * Hence:\n388\t     *\n389\t     *    red-scale =\n390\t     *          ( (green-x - blue-x) * (white-y - blue-y) -\n391\t     *            (green-y - blue-y) * (white-x - blue-x) ) / white-y\n392\t     * -------------------------------------------------------------------------\n393\t     *  (green-x - blue-x)*(red-y - blue-y)-(green-y - blue-y)*(red-x - blue-x)\n394\t     *\n395\t     *    green-scale =\n396\t     *          ( (red-y - blue-y) * (white-x - blue-x) -\n397\t     *            (red-x - blue-x) * (white-y - blue-y) ) / white-y\n398\t     * -------------------------------------------------------------------------\n399\t     *  (green-x - blue-x)*(red-y - blue-y)-(green-y - blue-y)*(red-x - blue-x)\n400\t     *\n401\t     * Accuracy:\n402\t     * The input values have 5 decimal digits of accuracy.\n403\t     *\n404\t     * In the previous implementation the values were all in the range 0 < value\n405\t     * < 1, so simple products are in the same range but may need up to 10\n406\t     * decimal digits to preserve the original precision and avoid underflow.\n407\t     * Because we are using a 32-bit signed representation we cannot match this;\n408\t     * the best is a little over 9 decimal digits, less than 10.\n409\t     *\n410\t     * This range has now been extended to allow values up to 1.1, or 110,000 in\n411\t     * fixed point.\n412\t     *\n413\t     * The approach used here is to preserve the maximum precision within the\n414\t     * signed representation.  Because the red-scale calculation above uses the\n415\t     * difference between two products of values that must be in the range\n416\t     * -1.1..+1.1 it is sufficient to divide the product by 8;\n417\t     * ceil(121,000/32767*2).  The factor is irrelevant in the calculation\n418\t     * because it is applied to both numerator and denominator.\n419\t     *\n420\t     * Note that the values of the differences of the products of the\n421\t     * chromaticities in the above equations tend to be small, for example for\n422\t     * the sRGB chromaticities they are:\n423\t     *\n424\t     * red numerator:    -0.04751\n425\t     * green numerator:  -0.08788\n426\t     * denominator:      -0.2241 (without white-y multiplication)\n427\t     *\n428\t     *  The resultant Y coefficients from the chromaticities of some widely used\n429\t     *  color space definitions are (to 15 decimal places):\n430\t     *\n431\t     *  sRGB\n432\t     *    0.212639005871510 0.715168678767756 0.072192315360734\n433\t     *  Kodak ProPhoto\n434\t     *    0.288071128229293 0.711843217810102 0.000085653960605\n435\t     *  Adobe RGB\n436\t     *    0.297344975250536 0.627363566255466 0.075291458493998\n437\t     *  Adobe Wide Gamut RGB\n438\t     *    0.258728243040113 0.724682314948566 0.016589442011321\n439\t     */\n440\t    {\n441\t        let mut error: c_int = 0;\n442\t\n443\t        /* By the argument above overflow should be impossible here, however the\n444\t         * code now simply returns a failure code.  The xy subtracts in the\n445\t         * arguments to png_muldiv are *not* checked for overflow because the\n446\t         * checks at the start guarantee they are in the range 0..110000 and\n447\t         * png_fixed_point is a 32-bit signed number.\n448\t         */\n449\t        if png_muldiv(\n450\t            &mut left,\n451\t            (*xy).greenx - (*xy).bluex,\n452\t            (*xy).redy - (*xy).bluey,\n453\t            8,\n454\t        ) == 0\n455\t        {\n456\t            return 1;\n457\t        }\n458\t        if png_muldiv(\n459\t            &mut right,\n460\t            (*xy).greeny - (*xy).bluey,\n461\t            (*xy).redx - (*xy).bluex,\n462\t            8,\n463\t        ) == 0\n464\t        {\n465\t            return 1;\n466\t        }\n467\t        denominator = png_fp_sub(left, right, &mut error);\n468\t        if error != 0 {\n469\t            return 1;\n470\t        }\n471\t\n472\t        /* Now find the red numerator. */\n473\t        if png_muldiv(\n474\t            &mut left,\n475\t            (*xy).greenx - (*xy).bluex,\n476\t            (*xy).whitey - (*xy).bluey,\n477\t            8,\n478\t        ) == 0\n479\t        {\n480\t            return 1;\n481\t        }\n482\t        if png_muldiv(\n483\t            &mut right,\n484\t            (*xy).greeny - (*xy).bluey,\n485\t            (*xy).whitex - (*xy).bluex,\n486\t            8,\n487\t        ) == 0\n488\t        {\n489\t            return 1;\n490\t        }\n491\t\n492\t        /* Overflow is possible here and it indicates an extreme set of PNG cHRM\n493\t         * chunk values.  This calculation actually returns the reciprocal of the\n494\t         * scale value because this allows us to delay the multiplication of\n495\t         * white-y into the denominator, which tends to produce a small number.\n496\t         */\n497\t        let divisor: png_fixed_point = png_fp_sub(left, right, &mut error);\n498\t        if png_muldiv(&mut red_inverse, (*xy).whitey, denominator, divisor) == 0\n499\t            || error != 0\n500\t            || red_inverse <= (*xy).whitey\n501\t        /* r+g+b scales = white scale */\n502\t        {\n503\t            return 1;\n504\t        }\n505\t\n506\t        /* Similarly for green_inverse: */\n507\t        if png_muldiv(\n508\t            &mut left,\n509\t            (*xy).redy - (*xy).bluey,\n510\t            (*xy).whitex - (*xy).bluex,\n511\t            8,\n512\t        ) == 0\n513\t        {\n514\t            return 1;\n515\t        }\n516\t        if png_muldiv(\n517\t            &mut right,\n518\t            (*xy).redx - (*xy).bluex,\n519\t            (*xy).whitey - (*xy).bluey,\n520\t            8,\n521\t        ) == 0\n522\t        {\n523\t            return 1;\n524\t        }\n525\t        let divisor2: png_fixed_point = png_fp_sub(left, right, &mut error);\n526\t        if png_muldiv(&mut green_inverse, (*xy).whitey, denominator, divisor2) == 0\n527\t            || error != 0\n528\t            || green_inverse <= (*xy).whitey\n529\t        {\n530\t            return 1;\n531\t        }\n532\t\n533\t        /* And the blue scale, the checks above guarantee this can't overflow but\n534\t         * it can still produce 0 for extreme cHRM values.\n535\t         */\n536\t        let inner: png_fixed_point = png_fp_sub(\n537\t            png_reciprocal((*xy).whitey),\n538\t            png_reciprocal(red_inverse),\n539\t            &mut error,\n540\t        );\n541\t        blue_scale = png_fp_sub(inner, png_reciprocal(green_inverse), &mut error);\n542\t        if error != 0 || blue_scale <= 0 {\n543\t            return 1;\n544\t        }\n545\t    }\n546\t\n547\t    /* And fill in the png_XYZ.  Again the subtracts are safe because of the\n548\t     * checks on the xy values at the start (the subtracts just calculate the\n549\t     * corresponding z values.)\n550\t     */\n551\t    if png_muldiv(\n552\t        core::ptr::addr_of_mut!((*XYZ).red_X),\n553\t        (*xy).redx,\n554\t        PNG_FP_1,\n555\t        red_inverse,\n556\t    ) == 0\n557\t    {\n558\t        return 1;\n559\t    }\n560\t    if png_muldiv(\n561\t        core::ptr::addr_of_mut!((*XYZ).red_Y),\n562\t        (*xy).redy,\n563\t        PNG_FP_1,\n564\t        red_inverse,\n565\t    ) == 0\n566\t    {\n567\t        return 1;\n568\t    }\n569\t    if png_muldiv(\n570\t        core::ptr::addr_of_mut!((*XYZ).red_Z),\n571\t        PNG_FP_1 - (*xy).redx - (*xy).redy,\n572\t        PNG_FP_1,\n573\t        red_inverse,\n574\t    ) == 0\n575\t    {\n576\t        return 1;\n577\t    }\n578\t\n579\t    if png_muldiv(\n580\t        core::ptr::addr_of_mut!((*XYZ).green_X),\n581\t        (*xy).greenx,\n582\t        PNG_FP_1,\n583\t        green_inverse,\n584\t    ) == 0\n585\t    {\n586\t        return 1;\n587\t    }\n588\t    if png_muldiv(\n589\t        core::ptr::addr_of_mut!((*XYZ).green_Y),\n590\t        (*xy).greeny,\n591\t        PNG_FP_1,\n592\t        green_inverse,\n593\t    ) == 0\n594\t    {\n595\t        return 1;\n596\t    }\n597\t    if png_muldiv(\n598\t        core::ptr::addr_of_mut!((*XYZ).green_Z),\n599\t        PNG_FP_1 - (*xy).greenx - (*xy).greeny,\n600\t        PNG_FP_1,\n601\t        green_inverse,\n602\t    ) == 0\n603\t    {\n604\t        return 1;\n605\t    }\n606\t\n607\t    if png_muldiv(\n608\t        core::ptr::addr_of_mut!((*XYZ).blue_X),\n609\t        (*xy).bluex,\n610\t        blue_scale,\n611\t        PNG_FP_1,\n612\t    ) == 0\n613\t    {\n614\t        return 1;\n615\t    }\n616\t    if png_muldiv(\n617\t        core::ptr::addr_of_mut!((*XYZ).blue_Y),\n618\t        (*xy).bluey,\n619\t        blue_scale,\n620\t        PNG_FP_1,\n621\t    ) == 0\n622\t    {\n623\t        return 1;\n624\t    }\n625\t    if png_muldiv(\n626\t        core::ptr::addr_of_mut!((*XYZ).blue_Z),\n627\t        PNG_FP_1 - (*xy).bluex - (*xy).bluey,\n628\t        blue_scale,\n629\t        PNG_FP_1,\n630\t    ) == 0\n631\t    {\n632\t        return 1;\n633\t    }\n634\t\n635\t    0 /*success*/\n636\t}\n637\t/* COLORSPACE */\n638\t\n639\t/* PNG_READ_iCCP_SUPPORTED */\n640\t/* Error message generation */\n641\tpub(crate) unsafe fn png_icc_tag_char(byte: png_uint_32) -> c_char {\n642\t    let byte = byte & 0xff;\n643\t    if byte >= 32 && byte <= 126 {\n644\t        byte as c_char\n645\t    } else {\n646\t        b'?' as c_char\n647\t    }\n648\t}\n649\t\n650\tpub(crate) unsafe fn png_icc_tag_name(name: *mut c_char, tag: png_uint_32) {\n651\t    *name.add(0) = b'\\'' as c_char;\n652\t    *name.add(1) = png_icc_tag_char(tag >> 24);\n653\t    *name.add(2) = png_icc_tag_char(tag >> 16);\n654\t    *name.add(3) = png_icc_tag_char(tag >> 8);\n655\t    *name.add(4) = png_icc_tag_char(tag);\n656\t    *name.add(5) = b'\\'' as c_char;\n657\t}\n658\t\n659\tpub(crate) unsafe fn is_ICC_signature_char(it: png_alloc_size_t) -> c_int {\n660\t    (it == 32 || (it >= 48 && it <= 57) || (it >= 65 && it <= 90) || (it >= 97 && it <= 122))\n661\t        as c_int\n662\t}\n663\t\n664\tpub(crate) unsafe fn is_ICC_signature(it: png_alloc_size_t) -> c_int {\n665\t    (is_ICC_signature_char(it >> 24) != 0 /* checks all the top bits */\n666\t        && is_ICC_signature_char((it >> 16) & 0xff) != 0\n667\t        && is_ICC_signature_char((it >> 8) & 0xff) != 0\n668\t        && is_ICC_signature_char(it & 0xff) != 0) as c_int\n669\t}\n670\t\n671\tpub(crate) unsafe fn png_icc_profile_error(\n672\t    png_ptr: png_const_structrp,\n673\t    name: png_const_charp,\n674\t    value: png_alloc_size_t,\n675\t    reason: png_const_charp,\n676\t) -> c_int {\n677\t    let mut pos: usize;\n678\t    let mut message: [c_char; 196] = [0; 196]; /* see below for calculation */\n679\t\n680\t    pos = png_safecat(message.as_mut_ptr(), 196, 0, c\"profile '\".as_ptr()); /* 9 chars */\n681\t    pos = png_safecat(message.as_mut_ptr(), pos + 79, pos, name); /* Truncate to 79 chars */\n682\t    pos = png_safecat(message.as_mut_ptr(), 196, pos, c\"': \".as_ptr()); /* +2 = 90 */\n683\t    if is_ICC_signature(value) != 0 {\n684\t        /* So 'value' is at most 4 bytes and the following cast is safe */\n685\t        png_icc_tag_name(message.as_mut_ptr().add(pos), value as png_uint_32);\n686\t        pos += 6; /* total +8; less than the else clause */\n687\t        *message.as_mut_ptr().add(pos) = b':' as c_char;\n688\t        pos += 1;\n689\t        *message.as_mut_ptr().add(pos) = b' ' as c_char;\n690\t        pos += 1;\n691\t    }\n692\t    /* PNG_WARNINGS_SUPPORTED */\n693\t    else {\n694\t        let mut number: [c_char; PNG_NUMBER_BUFFER_SIZE] = [0; PNG_NUMBER_BUFFER_SIZE]; /* +24 = 114 */\n695\t\n696\t        pos = png_safecat(\n697\t            message.as_mut_ptr(),\n698\t            196,\n699\t            pos,\n700\t            png_format_number(\n701\t                number.as_ptr(),\n702\t                number.as_mut_ptr().add(PNG_NUMBER_BUFFER_SIZE),\n703\t                PNG_NUMBER_FORMAT_x,\n704\t                value,\n705\t            ),\n706\t        );\n707\t        pos = png_safecat(message.as_mut_ptr(), 196, pos, c\"h: \".as_ptr()); /* +2 = 116 */\n708\t    }\n709\t    /* The 'reason' is an arbitrary message, allow +79 maximum 195 */\n710\t    pos = png_safecat(message.as_mut_ptr(), 196, pos, reason);\n711\t\n712\t    png_chunk_benign_error(png_ptr, message.as_ptr());\n713\t\n714\t    0\n715\t}\n716\t\n717\t/* Encoded value of D50 as an ICC XYZNumber.  From the ICC 2010 spec the value\n718\t * is XYZ(0.9642,1.0,0.8249), which scales to:\n719\t *\n720\t *    (63189.8112, 65536, 54060.6464)\n721\t */\n722\tstatic D50_nCIEXYZ: [png_byte; 12] = [\n723\t    0x00, 0x00, 0xf6, 0xd6, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0xd3, 0x2d,\n724\t];\n725\t\n726\tpub(crate) unsafe fn icc_check_length(\n727\t    png_ptr: png_const_structrp,\n728\t    name: png_const_charp,\n729\t    profile_length: png_uint_32,\n730\t) -> c_int\n731\t/* bool */\n732\t{\n733\t    if profile_length < 132 {\n734\t        return png_icc_profile_error(\n735\t            png_ptr,\n736\t            name,\n737\t            profile_length as png_alloc_size_t,\n738\t            c\"too short\".as_ptr(),\n739\t        );\n740\t    }\n741\t    1\n742\t}\n743\t\n744\t#[unsafe(no_mangle)]\n745\tpub unsafe extern \"C-unwind\" fn png_icc_check_length(\n746\t    png_ptr: png_const_structrp,\n747\t    name: png_const_charp,\n748\t    profile_length: png_uint_32,\n749\t) -> c_int {\n750\t    if icc_check_length(png_ptr, name, profile_length) == 0 {\n751\t        return 0;\n752\t    }\n753\t\n754\t    /* This needs to be here because the 'normal' check is in\n755\t     * png_decompress_chunk, yet this happens after the attempt to\n756\t     * png_malloc_base the required data.  We only need this on read; on write\n757\t     * the caller supplies the profile buffer so libpng doesn't allocate it.  See\n758\t     * the call to icc_check_length below (the write case).\n759\t     */\n760\t    if (profile_length as png_alloc_size_t) > (*png_ptr).user_chunk_malloc_max {\n761\t        return png_icc_profile_error(\n762\t            png_ptr,\n763\t            name,\n764\t            profile_length as png_alloc_size_t,\n765\t            c\"profile too long\".as_ptr(),\n766\t        );\n767\t    }\n768\t\n769\t    1\n770\t}\n771\t\n772\t#[unsafe(no_mangle)]\n773\tpub unsafe extern \"C-unwind\" fn png_icc_check_header(\n774\t    png_ptr: png_const_structrp,\n775\t    name: png_const_charp,\n776\t    profile_length: png_uint_32,\n777\t    profile: png_const_bytep, /* first 132 bytes only */\n778\t    color_type: c_int,\n779\t) -> c_int {\n780\t    let mut temp: png_uint_32;\n781\t\n782\t    /* Length check; this cannot be ignored in this code because profile_length\n783\t     * is used later to check the tag table, so even if the profile seems over\n784\t     * long profile_length from the caller must be correct.  The caller can fix\n785\t     * this up on read or write by just passing in the profile header length.\n786\t     */\n787\t    temp = PNG_get_uint_32(profile);\n788\t    if temp != profile_length {\n789\t        return png_icc_profile_error(\n790\t            png_ptr,\n791\t            name,\n792\t            temp as png_alloc_size_t,\n793\t            c\"length does not match profile\".as_ptr(),\n794\t        );\n795\t    }\n796\t\n797\t    temp = *profile.add(8) as png_uint_32;\n798\t    if temp > 3 && (profile_length & 3) != 0 {\n799\t        return png_icc_profile_error(\n800\t            png_ptr,\n801\t            name,\n802\t            profile_length as png_alloc_size_t,\n803\t            c\"invalid length\".as_ptr(),\n804\t        );\n805\t    }\n806\t\n807\t    temp = PNG_get_uint_32(profile.add(128)); /* tag count: 12 bytes/tag */\n808\t    if temp > 357913930 || /* (2^32-4-132)/12: maximum possible tag count */\n809\t       profile_length < 132u32.wrapping_add(12u32.wrapping_mul(temp))\n810\t    /* truncated tag table */\n811\t    {\n812\t        return png_icc_profile_error(\n813\t            png_ptr,\n814\t            name,\n815\t            temp as png_alloc_size_t,\n816\t            c\"tag count too large\".as_ptr(),\n817\t        );\n818\t    }\n819\t\n820\t    /* The 'intent' must be valid or we can't store it, ICC limits the intent to\n821\t     * 16 bits.\n822\t     */\n823\t    temp = PNG_get_uint_32(profile.add(64));\n824\t    if temp >= 0xffff\n825\t    /* The ICC limit */\n826\t    {\n827\t        return png_icc_profile_error(\n828\t            png_ptr,\n829\t            name,\n830\t            temp as png_alloc_size_t,\n831\t            c\"invalid rendering intent\".as_ptr(),\n832\t        );\n833\t    }\n834\t\n835\t    /* This is just a warning because the profile may be valid in future\n836\t     * versions.\n837\t     */\n838\t    if temp >= PNG_sRGB_INTENT_LAST as png_uint_32 {\n839\t        png_icc_profile_error(\n840\t            png_ptr,\n841\t            name,\n842\t            temp as png_alloc_size_t,\n843\t            c\"intent outside defined range\".as_ptr(),\n844\t        );\n845\t    }\n846\t\n847\t    /* At this point the tag table can't be checked because it hasn't necessarily\n848\t     * been loaded; however, various header fields can be checked.  These checks\n849\t     * are for values permitted by the PNG spec in an ICC profile; the PNG spec\n850\t     * restricts the profiles that can be passed in an iCCP chunk (they must be\n851\t     * appropriate to processing PNG data!)\n852\t     */\n853\t\n854\t    /* Data checks (could be skipped).  These checks must be independent of the\n855\t     * version number; however, the version number doesn't accommodate changes in\n856\t     * the header fields (just the known tags and the interpretation of the\n857\t     * data.)\n858\t     */\n859\t    temp = PNG_get_uint_32(profile.add(36)); /* signature 'ascp' */\n860\t    if temp != 0x61637370 {\n861\t        return png_icc_profile_error(\n862\t            png_ptr,\n863\t            name,\n864\t            temp as png_alloc_size_t,\n865\t            c\"invalid signature\".as_ptr(),\n866\t        );\n867\t    }\n868\t\n869\t    /* Currently the PCS illuminant/adopted white point (the computational\n870\t     * white point) are required to be D50,\n871\t     * however the profile contains a record of the illuminant so perhaps ICC\n872\t     * expects to be able to change this in the future (despite the rationale in\n873\t     * the introduction for using a fixed PCS adopted white.)  Consequently the\n874\t     * following is just a warning.\n875\t     */\n876\t    if memcmp(profile.add(68), D50_nCIEXYZ.as_ptr(), 12) != 0 {\n877\t        png_icc_profile_error(\n878\t            png_ptr,\n879\t            name,\n880\t            0, /*no tag value*/\n881\t            c\"PCS illuminant is not D50\".as_ptr(),\n882\t        );\n883\t    }\n884\t\n885\t    /* The PNG spec requires this:\n886\t     * \"If the iCCP chunk is present, the image samples conform to the colour\n887\t     * space represented by the embedded ICC profile as defined by the\n888\t     * International Color Consortium [ICC]. The colour space of the ICC profile\n889\t     * shall be an RGB colour space for colour images (PNG colour types 2, 3, and\n890\t     * 6), or a greyscale colour space for greyscale images (PNG colour types 0\n891\t     * and 4).\"\n892\t     *\n893\t     * This checking code ensures the embedded profile (on either read or write)\n894\t     * conforms to the specification requirements.  Notice that an ICC 'gray'\n895\t     * color-space profile contains the information to transform the monochrome\n896\t     * data to XYZ or L*a*b (according to which PCS the profile uses) and this\n897\t     * should be used in preference to the standard libpng K channel replication\n898\t     * into R, G and B channels.\n899\t     *\n900\t     * Previously it was suggested that an RGB profile on grayscale data could be\n901\t     * handled.  However it is clear that using an RGB profile in this context\n902\t     * must be an error - there is no specification of what it means.  Thus it is\n903\t     * almost certainly more correct to ignore the profile.\n904\t     */\n905\t    temp = PNG_get_uint_32(profile.add(16)); /* data colour space field */\n906\t    match temp {\n907\t        0x52474220 =>\n908\t        /* 'RGB ' */\n909\t        {\n910\t            if (color_type & PNG_COLOR_MASK_COLOR) == 0 {\n911\t                return png_icc_profile_error(\n912\t                    png_ptr,\n913\t                    name,\n914\t                    temp as png_alloc_size_t,\n915\t                    c\"RGB color space not permitted on grayscale PNG\".as_ptr(),\n916\t                );\n917\t            }\n918\t        }\n919\t\n920\t        0x47524159 =>\n921\t        /* 'GRAY' */\n922\t        {\n923\t            if (color_type & PNG_COLOR_MASK_COLOR) != 0 {\n924\t                return png_icc_profile_error(\n925\t                    png_ptr,\n926\t                    name,\n927\t                    temp as png_alloc_size_t,\n928\t                    c\"Gray color space not permitted on RGB PNG\".as_ptr(),\n929\t                );\n930\t            }\n931\t        }\n932\t\n933\t        _ => {\n934\t            return png_icc_profile_error(\n935\t                png_ptr,\n936\t                name,\n937\t                temp as png_alloc_size_t,\n938\t                c\"invalid ICC profile color space\".as_ptr(),\n939\t            );\n940\t        }\n941\t    }\n942\t\n943\t    /* It is up to the application to check that the profile class matches the\n944\t     * application requirements; the spec provides no guidance, but it's pretty\n945\t     * weird if the profile is not scanner ('scnr'), monitor ('mntr'), printer\n946\t     * ('prtr') or 'spac' (for generic color spaces).  Issue a warning in these\n947\t     * cases.  Issue an error for device link or abstract profiles - these don't\n948\t     * contain the records necessary to transform the color-space to anything\n949\t     * other than the target device (and not even that for an abstract profile).\n950\t     * Profiles of these classes may not be embedded in images.\n951\t     */\n952\t    temp = PNG_get_uint_32(profile.add(12)); /* profile/device class */\n953\t    match temp {\n954\t        /* 'scnr' */\n955\t        /* 'mntr' */\n956\t        /* 'prtr' */\n957\t        /* 'spac' */\n958\t        0x73636e72 | 0x6d6e7472 | 0x70727472 | 0x73706163 => {\n959\t            /* All supported */\n960\t        }\n961\t\n962\t        0x61627374 =>\n963\t        /* 'abst' */\n964\t        {\n965\t            /* May not be embedded in an image */\n966\t            return png_icc_profile_error(\n967\t                png_ptr,\n968\t                name,\n969\t                temp as png_alloc_size_t,\n970\t                c\"invalid embedded Abstract ICC profile\".as_ptr(),\n971\t            );\n972\t        }\n973\t\n974\t        0x6c696e6b =>\n975\t        /* 'link' */\n976\t        {\n977\t            /* DeviceLink profiles cannot be interpreted in a non-device specific\n978\t             * fashion, if an app uses the AToB0Tag in the profile the results are\n979\t             * undefined unless the result is sent to the intended device,\n980\t             * therefore a DeviceLink profile should not be found embedded in a\n981\t             * PNG.\n982\t             */\n983\t            return png_icc_profile_error(\n984\t                png_ptr,\n985\t                name,\n986\t                temp as png_alloc_size_t,\n987\t                c\"unexpected DeviceLink ICC profile class\".as_ptr(),\n988\t            );\n989\t        }\n990\t\n991\t        0x6e6d636c =>\n992\t        /* 'nmcl' */\n993\t        {\n994\t            /* A NamedColor profile is also device specific, however it doesn't\n995\t             * contain an AToB0 tag that is open to misinterpretation.  Almost\n996\t             * certainly it will fail the tests below.\n997\t             */\n998\t            png_icc_profile_error(\n999\t                png_ptr,\n1000\t                name,\n1001\t                temp as png_alloc_size_t,\n1002\t                c\"unexpected NamedColor ICC profile class\".as_ptr(),\n1003\t            );\n1004\t        }\n1005\t\n1006\t        _ => {\n1007\t            /* To allow for future enhancements to the profile accept unrecognized\n1008\t             * profile classes with a warning, these then hit the test below on the\n1009\t             * tag content to ensure they are backward compatible with one of the\n1010\t             * understood profiles.\n1011\t             */\n1012\t            png_icc_profile_error(\n1013\t                png_ptr,\n1014\t                name,\n1015\t                temp as png_alloc_size_t,\n1016\t                c\"unrecognized ICC profile class\".as_ptr(),\n1017\t            );\n1018\t        }\n1019\t    }\n1020\t\n1021\t    /* For any profile other than a device link one the PCS must be encoded\n1022\t     * either in XYZ or Lab.\n1023\t     */\n1024\t    temp = PNG_get_uint_32(profile.add(20));\n1025\t    match temp {\n1026\t        /* 'XYZ ' */\n1027\t        /* 'Lab ' */\n1028\t        0x58595a20 | 0x4c616220 => {}\n1029\t\n1030\t        _ => {\n1031\t            return png_icc_profile_error(\n1032\t                png_ptr,\n1033\t                name,\n1034\t                temp as png_alloc_size_t,\n1035\t                c\"unexpected ICC PCS encoding\".as_ptr(),\n1036\t            );\n1037\t        }\n1038\t    }\n1039\t\n1040\t    1\n1041\t}\n1042\t\n1043\t#[unsafe(no_mangle)]\n1044\tpub unsafe extern \"C-unwind\" fn png_icc_check_tag_table(\n1045\t    png_ptr: png_const_structrp,\n1046\t    name: png_const_charp,\n1047\t    profile_length: png_uint_32,\n1048\t    profile: png_const_bytep, /* header plus whole tag table */\n1049\t) -> c_int {\n1050\t    let tag_count: png_uint_32 = PNG_get_uint_32(profile.add(128));\n1051\t    let mut itag: png_uint_32;\n1052\t    let mut tag: png_const_bytep = profile.add(132); /* The first tag */\n1053\t\n1054\t    /* First scan all the tags in the table and add bits to the icc_info value\n1055\t     * (temporarily in 'tags').\n1056\t     */\n1057\t    itag = 0;\n1058\t    while itag < tag_count {\n1059\t        let tag_id: png_uint_32 = PNG_get_uint_32(tag.add(0));\n1060\t        let tag_start: png_uint_32 = PNG_get_uint_32(tag.add(4)); /* must be aligned */\n1061\t        let tag_length: png_uint_32 = PNG_get_uint_32(tag.add(8)); /* not padded */\n1062\t\n1063\t        /* The ICC specification does not exclude zero length tags, therefore the\n1064\t         * start might actually be anywhere if there is no data, but this would be\n1065\t         * a clear abuse of the intent of the standard so the start is checked for\n1066\t         * being in range.  All defined tag types have an 8 byte header - a 4 byte\n1067\t         * type signature then 0.\n1068\t         */\n1069\t\n1070\t        /* This is a hard error; potentially it can cause read outside the\n1071\t         * profile.\n1072\t         */\n1073\t        if tag_start > profile_length || tag_length > profile_length.wrapping_sub(tag_start) {\n1074\t            return png_icc_profile_error(\n1075\t                png_ptr,\n1076\t                name,\n1077\t                tag_id as png_alloc_size_t,\n1078\t                c\"ICC profile tag outside profile\".as_ptr(),\n1079\t            );\n1080\t        }\n1081\t\n1082\t        if (tag_start & 3) != 0 {\n1083\t            /* CNHP730S.icc shipped with Microsoft Windows 64 violates this; it is\n1084\t             * only a warning here because libpng does not care about the\n1085\t             * alignment.\n1086\t             */\n1087\t            png_icc_profile_error(\n1088\t                png_ptr,\n1089\t                name,\n1090\t                tag_id as png_alloc_size_t,\n1091\t                c\"ICC profile tag start not a multiple of 4\".as_ptr(),\n1092\t            );\n1093\t        }\n1094\t\n1095\t        itag = itag.wrapping_add(1);\n1096\t        tag = tag.add(12);\n1097\t    }\n1098\t\n1099\t    1 /* success, maybe with warnings */\n1100\t}\n1101\t/* READ_iCCP */\n1102\t\n1103\t/* PNG_READ_RGB_TO_GRAY_SUPPORTED */\n1104\t/* (defined PNG_READ_mDCV_SUPPORTED) || (defined PNG_READ_cHRM_SUPPORTED) */\n1105\tpub(crate) unsafe fn have_chromaticities(png_ptr: png_const_structrp) -> c_int {\n1106\t    /* Handle new PNGv3 chunks and the precedence rules to determine whether\n1107\t     * png_struct::chromaticities must be processed