{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01PihaAdJiVrEcgMevbJSXfk","type":"tool_result","content":"1\t// pngwutil_p1.rs -- part 1 of the translation of c_src/src/pngwutil.c (lines 1..688)\n2\t//\n3\t// Covers the interlace tables, png_save_uint_32 .. png_write_compressed_data_out.\n4\t\n5\t/* WRITE_INTERLACING */\n6\t/* Arrays to facilitate interlacing - use pass (0 - 6) as index. */\n7\t\n8\t/* Start of interlace block */\n9\tstatic png_pass_start: [png_byte; 7] = [0, 4, 0, 2, 0, 1, 0];\n10\t/* Offset to next interlace block */\n11\tstatic png_pass_inc: [png_byte; 7] = [8, 8, 4, 4, 2, 2, 1];\n12\t/* Start of interlace block in the y direction */\n13\tstatic png_pass_ystart: [png_byte; 7] = [0, 0, 4, 0, 2, 0, 1];\n14\t/* Offset to next interlace block in the y direction */\n15\tstatic png_pass_yinc: [png_byte; 7] = [8, 8, 8, 4, 4, 2, 2];\n16\t\n17\t/* TODO: Move these arrays to a common utility module to avoid duplication. */\n18\t\n19\t/* WRITE_INT_FUNCTIONS */\n20\t/* Place a 32-bit number into a buffer in PNG byte order.  We work\n21\t * with unsigned numbers for convenience, although one supported\n22\t * ancillary chunk uses signed (two's complement) numbers.\n23\t */\n24\t#[unsafe(no_mangle)]\n25\tpub unsafe extern \"C-unwind\" fn png_save_uint_32(buf: png_bytep, i: png_uint_32) {\n26\t    *buf = ((i >> 24) & 0xffu32) as png_byte;\n27\t    *buf.add(1) = ((i >> 16) & 0xffu32) as png_byte;\n28\t    *buf.add(2) = ((i >> 8) & 0xffu32) as png_byte;\n29\t    *buf.add(3) = (i & 0xffu32) as png_byte;\n30\t}\n31\t\n32\t/* Place a 16-bit number into a buffer in PNG byte order.\n33\t * The parameter is declared unsigned int, not png_uint_16,\n34\t * just to avoid potential problems on pre-ANSI C compilers.\n35\t */\n36\t#[unsafe(no_mangle)]\n37\tpub unsafe extern \"C-unwind\" fn png_save_uint_16(buf: png_bytep, i: c_uint) {\n38\t    *buf = ((i >> 8) & 0xffu32) as png_byte;\n39\t    *buf.add(1) = (i & 0xffu32) as png_byte;\n40\t}\n41\t/* WRITE_INT_FUNCTIONS */\n42\t\n43\t/* Simple function to write the signature.  If we have already written\n44\t * the magic bytes of the signature, or more likely, the PNG stream is\n45\t * being embedded into another stream and doesn't need its own signature,\n46\t * we should call png_set_sig_bytes() to tell libpng how many of the\n47\t * bytes have already been written.\n48\t */\n49\t#[unsafe(no_mangle)]\n50\tpub unsafe extern \"C-unwind\" fn png_write_sig(png_ptr: png_structrp) {\n51\t    let mut png_signature: [png_byte; 8] = [137, 80, 78, 71, 13, 10, 26, 10];\n52\t\n53\t    /* IO_STATE */\n54\t    /* Inform the I/O callback that the signature is being written */\n55\t    (*png_ptr).io_state = PNG_IO_WRITING | PNG_IO_SIGNATURE;\n56\t\n57\t    /* Write the rest of the 8 byte signature */\n58\t    png_write_data(\n59\t        png_ptr,\n60\t        png_signature.as_ptr().add((*png_ptr).sig_bytes as usize),\n61\t        (8 - (*png_ptr).sig_bytes as c_int) as usize,\n62\t    );\n63\t\n64\t    if (*png_ptr).sig_bytes < 3 {\n65\t        (*png_ptr).mode |= PNG_HAVE_PNG_SIGNATURE;\n66\t    }\n67\t}\n68\t\n69\t/* Write the start of a PNG chunk.  The type is the chunk type.\n70\t * The total_length is the sum of the lengths of all the data you will be\n71\t * passing in png_write_chunk_data().\n72\t */\n73\tpub(crate) unsafe fn png_write_chunk_header(\n74\t    png_ptr: png_structrp,\n75\t    chunk_name: png_uint_32,\n76\t    length: png_uint_32,\n77\t) {\n78\t    let mut buf: [png_byte; 8] = [0; 8];\n79\t\n80\t    if png_ptr.is_null() {\n81\t        return;\n82\t    }\n83\t\n84\t    /* IO_STATE */\n85\t    /* Inform the I/O callback that the chunk header is being written.\n86\t     * PNG_IO_CHUNK_HDR requires a single I/O call.\n87\t     */\n88\t    (*png_ptr).io_state = PNG_IO_WRITING | PNG_IO_CHUNK_HDR;\n89\t\n90\t    /* Write the length and the chunk name */\n91\t    png_save_uint_32(buf.as_mut_ptr(), length);\n92\t    png_save_uint_32(buf.as_mut_ptr().add(4), chunk_name);\n93\t    png_write_data(png_ptr, buf.as_ptr(), 8);\n94\t\n95\t    /* Put the chunk name into png_ptr->chunk_name */\n96\t    (*png_ptr).chunk_name = chunk_name;\n97\t\n98\t    /* Reset the crc and run it over the chunk name */\n99\t    png_reset_crc(png_ptr);\n100\t\n101\t    png_calculate_crc(png_ptr, buf.as_ptr().add(4), 4);\n102\t\n103\t    /* IO_STATE */\n104\t    /* Inform the I/O callback that chunk data will (possibly) be written.\n105\t     * PNG_IO_CHUNK_DATA does NOT require a specific number of I/O calls.\n106\t     */\n107\t    (*png_ptr).io_state = PNG_IO_WRITING | PNG_IO_CHUNK_DATA;\n108\t}\n109\t\n110\t#[unsafe(no_mangle)]\n111\tpub unsafe extern \"C-unwind\" fn png_write_chunk_start(\n112\t    png_ptr: png_structrp,\n113\t    chunk_string: png_const_bytep,\n114\t    length: png_uint_32,\n115\t) {\n116\t    png_write_chunk_header(png_ptr, PNG_CHUNK_FROM_STRING(chunk_string), length);\n117\t}\n118\t\n119\t/* Write the data of a PNG chunk started with png_write_chunk_header().\n120\t * Note that multiple calls to this function are allowed, and that the\n121\t * sum of the lengths from these calls *must* add up to the total_length\n122\t * given to png_write_chunk_header().\n123\t */\n124\t#[unsafe(no_mangle)]\n125\tpub unsafe extern \"C-unwind\" fn png_write_chunk_data(\n126\t    png_ptr: png_structrp,\n127\t    data: png_const_bytep,\n128\t    length: usize,\n129\t) {\n130\t    /* Write the data, and run the CRC over it */\n131\t    if png_ptr.is_null() {\n132\t        return;\n133\t    }\n134\t\n135\t    if !data.is_null() && length > 0 {\n136\t        png_write_data(png_ptr, data, length);\n137\t\n138\t        /* Update the CRC after writing the data,\n139\t         * in case the user I/O routine alters it.\n140\t         */\n141\t        png_calculate_crc(png_ptr, data, length);\n142\t    }\n143\t}\n144\t\n145\t/* Finish a chunk started with png_write_chunk_header(). */\n146\t#[unsafe(no_mangle)]\n147\tpub unsafe extern \"C-unwind\" fn png_write_chunk_end(png_ptr: png_structrp) {\n148\t    let mut buf: [png_byte; 4] = [0; 4];\n149\t\n150\t    if png_ptr.is_null() {\n151\t        return;\n152\t    }\n153\t\n154\t    /* IO_STATE */\n155\t    /* Inform the I/O callback that the chunk CRC is being written.\n156\t     * PNG_IO_CHUNK_CRC requires a single I/O function call.\n157\t     */\n158\t    (*png_ptr).io_state = PNG_IO_WRITING | PNG_IO_CHUNK_CRC;\n159\t\n160\t    /* Write the crc in a single operation */\n161\t    png_save_uint_32(buf.as_mut_ptr(), (*png_ptr).crc);\n162\t\n163\t    png_write_data(png_ptr, buf.as_ptr(), 4);\n164\t}\n165\t\n166\t/* Write a PNG chunk all at once.  The type is an array of ASCII characters\n167\t * representing the chunk name.  The array must be at least 4 bytes in\n168\t * length, and does not need to be null terminated.  To be safe, pass the\n169\t * pre-defined chunk names here, and if you need a new one, define it\n170\t * where the others are defined.  The length is the length of the data.\n171\t * All the data must be present.  If that is not possible, use the\n172\t * png_write_chunk_start(), png_write_chunk_data(), and png_write_chunk_end()\n173\t * functions instead.\n174\t */\n175\tpub(crate) unsafe fn png_write_complete_chunk(\n176\t    png_ptr: png_structrp,\n177\t    chunk_name: png_uint_32,\n178\t    data: png_const_bytep,\n179\t    length: usize,\n180\t) {\n181\t    if png_ptr.is_null() {\n182\t        return;\n183\t    }\n184\t\n185\t    /* On 64-bit architectures 'length' may not fit in a png_uint_32. */\n186\t    if length > PNG_UINT_31_MAX as usize {\n187\t        png_error(png_ptr, c\"length exceeds PNG maximum\".as_ptr());\n188\t    }\n189\t\n190\t    png_write_chunk_header(png_ptr, chunk_name, length as png_uint_32);\n191\t    png_write_chunk_data(png_ptr, data, length);\n192\t    png_write_chunk_end(png_ptr);\n193\t}\n194\t\n195\t/* This is the API that calls the internal function above. */\n196\t#[unsafe(no_mangle)]\n197\tpub unsafe extern \"C-unwind\" fn png_write_chunk(\n198\t    png_ptr: png_structrp,\n199\t    chunk_string: png_const_bytep,\n200\t    data: png_const_bytep,\n201\t    length: usize,\n202\t) {\n203\t    png_write_complete_chunk(\n204\t        png_ptr,\n205\t        PNG_CHUNK_FROM_STRING(chunk_string),\n206\t        data,\n207\t        length,\n208\t    );\n209\t}\n210\t\n211\t/* This is used below to find the size of an image to pass to png_deflate_claim,\n212\t * so it only needs to be accurate if the size is less than 16384 bytes (the\n213\t * point at which a lower LZ window size can be used.)\n214\t */\n215\tpub(crate) unsafe fn png_image_size(png_ptr: png_structrp) -> png_alloc_size_t {\n216\t    /* Only return sizes up to the maximum of a png_uint_32; do this by limiting\n217\t     * the width and height used to 15 bits.\n218\t     */\n219\t    let h: png_uint_32 = (*png_ptr).height;\n220\t\n221\t    if (*png_ptr).rowbytes < 32768 && h < 32768 {\n222\t        if (*png_ptr).interlaced != 0 {\n223\t            /* Interlacing makes the image larger because of the replication of\n224\t             * both the filter byte and the padding to a byte boundary.\n225\t             */\n226\t            let w: png_uint_32 = (*png_ptr).width;\n227\t            let pd: c_uint = (*png_ptr).pixel_depth as c_uint;\n228\t            let mut cb_base: png_alloc_size_t;\n229\t            let mut pass: c_int;\n230\t\n231\t            cb_base = 0;\n232\t            pass = 0;\n233\t            while pass <= 6 {\n234\t                let pw: png_uint_32 = PNG_PASS_COLS(w, pass);\n235\t\n236\t                if pw > 0 {\n237\t                    cb_base = cb_base.wrapping_add(\n238\t                        (PNG_ROWBYTES(pd as usize, pw as usize).wrapping_add(1))\n239\t                            .wrapping_mul(PNG_PASS_ROWS(h, pass) as usize),\n240\t                    );\n241\t                }\n242\t\n243\t                pass += 1;\n244\t            }\n245\t\n246\t            return cb_base;\n247\t        } else {\n248\t            return ((*png_ptr).rowbytes.wrapping_add(1)).wrapping_mul(h as usize);\n249\t        }\n250\t    } else {\n251\t        return 0xffffffffu32 as png_alloc_size_t;\n252\t    }\n253\t}\n254\t\n255\t/* WRITE_OPTIMIZE_CMF */\n256\t/* This is the code to hack the first two bytes of the deflate stream (the\n257\t * deflate header) to correct the windowBits value to match the actual data\n258\t * size.  Note that the second argument is the *uncompressed* size but the\n259\t * first argument is the *compressed* data (and it must be deflate\n260\t * compressed.)\n261\t */\n262\tpub(crate) unsafe fn optimize_cmf(data: png_bytep, data_size: png_alloc_size_t) {\n263\t    /* Optimize the CMF field in the zlib stream.  The resultant zlib stream is\n264\t     * still compliant to the stream specification.\n265\t     */\n266\t    if data_size <= 16384\n267\t    /* else windowBits must be 15 */\n268\t    {\n269\t        let mut z_cmf: c_uint = *data as c_uint; /* zlib compression method and flags */\n270\t\n271\t        if (z_cmf & 0x0f) == 8 && (z_cmf & 0xf0) <= 0x70 {\n272\t            let mut z_cinfo: c_uint;\n273\t            let mut half_z_window_size: c_uint;\n274\t\n275\t            z_cinfo = z_cmf >> 4;\n276\t            half_z_window_size = 1u32.wrapping_shl(z_cinfo.wrapping_add(7));\n277\t\n278\t            if data_size <= half_z_window_size as png_alloc_size_t\n279\t            /* else no change */\n280\t            {\n281\t                let mut tmp: c_uint;\n282\t\n283\t                loop {\n284\t                    half_z_window_size >>= 1;\n285\t                    z_cinfo = z_cinfo.wrapping_sub(1);\n286\t\n287\t                    if !(z_cinfo > 0 && data_size <= half_z_window_size as png_alloc_size_t) {\n288\t                        break;\n289\t                    }\n290\t                }\n291\t\n292\t                z_cmf = (z_cmf & 0x0f) | (z_cinfo << 4);\n293\t\n294\t                *data = z_cmf as png_byte;\n295\t                tmp = *data.add(1) as c_uint & 0xe0;\n296\t                tmp = tmp.wrapping_add(0x1f - ((z_cmf << 8).wrapping_add(tmp)) % 0x1f);\n297\t                *data.add(1) = tmp as png_byte;\n298\t            }\n299\t        }\n300\t    }\n301\t}\n302\t/* WRITE_OPTIMIZE_CMF */\n303\t\n304\t/* Initialize the compressor for the appropriate type of compression. */\n305\tpub(crate) unsafe fn png_deflate_claim(\n306\t    png_ptr: png_structrp,\n307\t    owner: png_uint_32,\n308\t    data_size: png_alloc_size_t,\n309\t) -> c_int {\n310\t    if (*png_ptr).zowner != 0 {\n311\t        /* WARNINGS || ERROR_TEXT */\n312\t        let mut msg: [c_char; 64] = [0; 64];\n313\t\n314\t        PNG_STRING_FROM_CHUNK(msg.as_mut_ptr(), owner);\n315\t        msg[4] = b':' as c_char;\n316\t        msg[5] = b' ' as c_char;\n317\t        PNG_STRING_FROM_CHUNK(msg.as_mut_ptr().add(6), (*png_ptr).zowner);\n318\t        /* So the message that results is \"<chunk> using zstream\"; this is an\n319\t         * internal error, but is very useful for debugging.  i18n requirements\n320\t         * are minimal.\n321\t         */\n322\t        png_safecat(msg.as_mut_ptr(), 64, 10, c\" using zstream\".as_ptr());\n323\t\n324\t        /* !PNG_RELEASE_BUILD */\n325\t        png_error(png_ptr, msg.as_ptr());\n326\t    }\n327\t\n328\t    {\n329\t        let mut level: c_int = (*png_ptr).zlib_level;\n330\t        let mut method: c_int = (*png_ptr).zlib_method;\n331\t        let mut windowBits: c_int = (*png_ptr).zlib_window_bits;\n332\t        let mut memLevel: c_int = (*png_ptr).zlib_mem_level;\n333\t        let strategy: c_int; /* set below */\n334\t        let mut ret: c_int; /* zlib return code */\n335\t\n336\t        if owner == png_IDAT {\n337\t            if ((*png_ptr).flags & PNG_FLAG_ZLIB_CUSTOM_STRATEGY) != 0 {\n338\t                strategy = (*png_ptr).zlib_strategy;\n339\t            } else if (*png_ptr).do_filter as c_int != PNG_FILTER_NONE {\n340\t                strategy = PNG_Z_DEFAULT_STRATEGY;\n341\t            } else {\n342\t                strategy = PNG_Z_DEFAULT_NOFILTER_STRATEGY;\n343\t            }\n344\t        } else {\n345\t            /* WRITE_CUSTOMIZE_ZTXT_COMPRESSION */\n346\t            level = (*png_ptr).zlib_text_level;\n347\t            method = (*png_ptr).zlib_text_method;\n348\t            windowBits = (*png_ptr).zlib_text_window_bits;\n349\t            memLevel = (*png_ptr).zlib_text_mem_level;\n350\t            strategy = (*png_ptr).zlib_text_strategy;\n351\t        }\n352\t\n353\t        /* Adjust 'windowBits' down if larger than 'data_size'; to stop this\n354\t         * happening just pass 32768 as the data_size parameter.  Notice that zlib\n355\t         * requires an extra 262 bytes in the window in addition to the data to be\n356\t         * able to see the whole of the data, so if data_size+262 takes us to the\n357\t         * next windowBits size we need to fix up the value later.  (Because even\n358\t         * though deflate needs the extra window, inflate does not!)\n359\t         */\n360\t        if data_size <= 16384 {\n361\t            /* IMPLEMENTATION NOTE: this 'half_window_size' stuff is only here to\n362\t             * work round a Microsoft Visual C misbehavior which, contrary to C-90,\n363\t             * widens the result of the following shift to 64-bits if (and,\n364\t             * apparently, only if) it is used in a test.\n365\t             */\n366\t            let mut half_window_size: c_uint = 1u32.wrapping_shl((windowBits - 1) as c_uint);\n367\t\n368\t            while data_size.wrapping_add(262) <= half_window_size as png_alloc_size_t {\n369\t                half_window_size >>= 1;\n370\t                windowBits -= 1;\n371\t            }\n372\t        }\n373\t\n374\t        /* Check against the previous initialized values, if any. */\n375\t        if ((*png_ptr).flags & PNG_FLAG_ZSTREAM_INITIALIZED) != 0\n376\t            && ((*png_ptr).zlib_set_level != level\n377\t                || (*png_ptr).zlib_set_method != method\n378\t                || (*png_ptr).zlib_set_window_bits != windowBits\n379\t                || (*png_ptr).zlib_set_mem_level != memLevel\n380\t                || (*png_ptr).zlib_set_strategy != strategy)\n381\t        {\n382\t            if deflateEnd(core::ptr::addr_of_mut!((*png_ptr).zstream)) != Z_OK {\n383\t                png_warning(png_ptr, c\"deflateEnd failed (ignored)\".as_ptr());\n384\t            }\n385\t\n386\t            (*png_ptr).flags &= !PNG_FLAG_ZSTREAM_INITIALIZED;\n387\t        }\n388\t\n389\t        /* For safety clear out the input and output pointers (currently zlib\n390\t         * doesn't use them on Init, but it might in the future).\n391\t         */\n392\t        (*png_ptr).zstream.next_in = core::ptr::null();\n393\t        (*png_ptr).zstream.avail_in = 0;\n394\t        (*png_ptr).zstream.next_out = core::ptr::null_mut();\n395\t        (*png_ptr).zstream.avail_out = 0;\n396\t\n397\t        /* Now initialize if required, setting the new parameters, otherwise just\n398\t         * do a simple reset to the previous parameters.\n399\t         */\n400\t        if ((*png_ptr).flags & PNG_FLAG_ZSTREAM_INITIALIZED) != 0 {\n401\t            ret = deflateReset(core::ptr::addr_of_mut!((*png_ptr).zstream));\n402\t        } else {\n403\t            ret = deflateInit2(\n404\t                core::ptr::addr_of_mut!((*png_ptr).zstream),\n405\t                level,\n406\t                method,\n407\t                windowBits,\n408\t                memLevel,\n409\t                strategy,\n410\t            );\n411\t\n412\t            if ret == Z_OK {\n413\t                (*png_ptr).flags |= PNG_FLAG_ZSTREAM_INITIALIZED;\n414\t            }\n415\t        }\n416\t\n417\t        /* The return code is from either deflateReset or deflateInit2; they have\n418\t         * pretty much the same set of error codes.\n419\t         */\n420\t        if ret == Z_OK {\n421\t            (*png_ptr).zowner = owner;\n422\t        } else {\n423\t            png_zstream_error(png_ptr, ret);\n424\t        }\n425\t\n426\t        return ret;\n427\t    }\n428\t}\n429\t\n430\t/* Clean up (or trim) a linked list of compression buffers. */\n431\t#[unsafe(no_mangle)]\n432\tpub unsafe extern \"C-unwind\" fn png_free_buffer_list(\n433\t    png_ptr: png_structrp,\n434\t    listp: *mut png_compression_bufferp,\n435\t) {\n436\t    let mut list: png_compression_bufferp = *listp;\n437\t\n438\t    if !list.is_null() {\n439\t        *listp = core::ptr::null_mut();\n440\t\n441\t        loop {\n442\t            let next: png_compression_bufferp = (*list).next;\n443\t\n444\t            png_free(png_ptr, list as png_voidp);\n445\t            list = next;\n446\t\n447\t            if list.is_null() {\n448\t                break;\n449\t            }\n450\t        }\n451\t    }\n452\t}\n453\t\n454\t/* WRITE_COMPRESSED_TEXT */\n455\t/* This pair of functions encapsulates the operation of (a) compressing a\n456\t * text string, and (b) issuing it later as a series of chunk data writes.\n457\t * The compression_state structure is shared context for these functions\n458\t * set up by the caller to allow access to the relevant local variables.\n459\t *\n460\t * compression_buffer (new in 1.6.0) is just a linked list of zbuffer_size\n461\t * temporary buffers.  From 1.6.0 it is retained in png_struct so that it will\n462\t * be correctly freed in the event of a write error (previous implementations\n463\t * just leaked memory.)\n464\t */\n465\t#[repr(C)]\n466\tpub(crate) struct compression_state {\n467\t    pub input: png_const_bytep,      /* The uncompressed input data */\n468\t    pub input_len: png_alloc_size_t, /* Its length */\n469\t    pub output_len: png_uint_32,     /* Final compressed length */\n470\t    pub output: [png_byte; 1024],    /* First block of output */\n471\t}\n472\t\n473\tpub(crate) unsafe fn png_text_compress_init(\n474\t    comp: *mut compression_state,\n475\t    input: png_const_bytep,\n476\t    input_len: png_alloc_size_t,\n477\t) {\n478\t    (*comp).input = input;\n479\t    (*comp).input_len = input_len;\n480\t    (*comp).output_len = 0;\n481\t}\n482\t\n483\t/* Compress the data in the compression state input */\n484\tpub(crate) unsafe fn png_text_compress(\n485\t    png_ptr: png_structrp,\n486\t    chunk_name: png_uint_32,\n487\t    comp: *mut compression_state,\n488\t    prefix_len: png_uint_32,\n489\t) -> c_int {\n490\t    let mut ret: c_int;\n491\t\n492\t    /* To find the length of the output it is necessary to first compress the\n493\t     * input. The result is buffered rather than using the two-pass algorithm\n494\t     * that is used on the inflate side; deflate is assumed to be slower and a\n495\t     * PNG writer is assumed to have more memory available than a PNG reader.\n496\t     *\n497\t     * IMPLEMENTATION NOTE: the zlib API deflateBound() can be used to find an\n498\t     * upper limit on the output size, but it is always bigger than the input\n499\t     * size so it is likely to be more efficient to use this linked-list\n500\t     * approach.\n501\t     */\n502\t    ret = png_deflate_claim(png_ptr, chunk_name, (*comp).input_len);\n503\t\n504\t    if ret != Z_OK {\n505\t        return ret;\n506\t    }\n507\t\n508\t    /* Set up the compression buffers, we need a loop here to avoid overflowing a\n509\t     * uInt.  Use ZLIB_IO_MAX to limit the input.  The output is always limited\n510\t     * by the output buffer size, so there is no need to check that.  Since this\n511\t     * is ANSI-C we know that an 'int', hence a uInt, is always at least 16 bits\n512\t     * in size.\n513\t     */\n514\t    {\n515\t        let mut end: *mut png_compression_bufferp =\n516\t            core::ptr::addr_of_mut!((*png_ptr).zbuffer_list);\n517\t        let mut input_len: png_alloc_size_t = (*comp).input_len; /* may be zero! */\n518\t        let mut output_len: png_uint_32;\n519\t\n520\t        /* zlib updates these for us: */\n521\t        (*png_ptr).zstream.next_in = (*comp).input;\n522\t        (*png_ptr).zstream.avail_in = 0; /* Set below */\n523\t        (*png_ptr).zstream.next_out = (*comp).output.as_mut_ptr();\n524\t        (*png_ptr).zstream.avail_out = core::mem::size_of::<[png_byte; 1024]>() as u32;\n525\t\n526\t        output_len = (*png_ptr).zstream.avail_out;\n527\t\n528\t        loop {\n529\t            let mut avail_in: u32 = ZLIB_IO_MAX;\n530\t\n531\t            if avail_in as png_alloc_size_t > input_len {\n532\t                avail_in = input_len as u32;\n533\t            }\n534\t\n535\t            input_len = input_len.wrapping_sub(avail_in as png_alloc_size_t);\n536\t\n537\t            (*png_ptr).zstream.avail_in = avail_in;\n538\t\n539\t            if (*png_ptr).zstream.avail_out == 0 {\n540\t                let mut next: *mut png_compression_buffer;\n541\t\n542\t                /* Chunk data is limited to 2^31 bytes in length, so the prefix\n543\t                 * length must be counted here.\n544\t                 */\n545\t                if output_len.wrapping_add(prefix_len) > PNG_UINT_31_MAX {\n546\t                    ret = Z_MEM_ERROR;\n547\t                    break;\n548\t                }\n549\t\n550\t                /* Need a new (malloc'ed) buffer, but there may be one present\n551\t                 * already.\n552\t                 */\n553\t                next = *end;\n554\t                if next.is_null() {\n555\t                    next = png_malloc_base(\n556\t                        png_ptr,\n557\t                        PNG_COMPRESSION_BUFFER_SIZE((*png_ptr).zbuffer_size as usize),\n558\t                    ) as png_compression_bufferp;\n559\t\n560\t                    if next.is_null() {\n561\t                        ret = Z_MEM_ERROR;\n562\t                        break;\n563\t                    }\n564\t\n565\t                    /* Link in this buffer (so that it will be freed later) */\n566\t                    (*next).next = core::ptr::null_mut();\n567\t                    *end = next;\n568\t                }\n569\t\n570\t                (*png_ptr).zstream.next_out = (*next).output.as_mut_ptr();\n571\t                (*png_ptr).zstream.avail_out = (*png_ptr).zbuffer_size;\n572\t                output_len = output_len.wrapping_add((*png_ptr).zstream.avail_out);\n573\t\n574\t                /* Move 'end' to the next buffer pointer. */\n575\t                end = core::ptr::addr_of_mut!((*next).next);\n576\t            }\n577\t\n578\t            /* Compress the data */\n579\t            ret = deflate(\n580\t                core::ptr::addr_of_mut!((*png_ptr).zstream),\n581\t                if input_len > 0 { Z_NO_FLUSH } else { Z_FINISH },\n582\t            );\n583\t\n584\t            /* Claw back input data that was not consumed (because avail_in is\n585\t             * reset above every time round the loop).\n586\t             */\n587\t            input_len = input_len.wrapping_add((*png_ptr).zstream.avail_in as png_alloc_size_t);\n588\t            (*png_ptr).zstream.avail_in = 0; /* safety */\n589\t\n590\t            if !(ret == Z_OK) {\n591\t                break;\n592\t            }\n593\t        }\n594\t\n595\t        /* There may be some space left in the last output buffer. This needs to\n596\t         * be subtracted from output_len.\n597\t         */\n598\t        output_len = output_len.wrapping_sub((*png_ptr).zstream.avail_out);\n599\t        (*png_ptr).zstream.avail_out = 0; /* safety */\n600\t        (*comp).output_len = output_len;\n601\t\n602\t        /* Now double check the output length, put in a custom message if it is\n603\t         * too long.  Otherwise ensure the z_stream::msg pointer is set to\n604\t         * something.\n605\t         */\n606\t        if output_len.wrapping_add(prefix_len) >= PNG_UINT_31_MAX {\n607\t            (*png_ptr).zstream.msg = c\"compressed data too long\".as_ptr();\n608\t            ret = Z_MEM_ERROR;\n609\t        } else {\n610\t            png_zstream_error(png_ptr, ret);\n611\t        }\n612\t\n613\t        