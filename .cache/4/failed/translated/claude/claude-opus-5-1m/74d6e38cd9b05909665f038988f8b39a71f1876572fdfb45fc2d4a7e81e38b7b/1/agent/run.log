*png_ptr).sig_bit.red = buf[0];\n317\t        (*png_ptr).sig_bit.green = buf[1];\n318\t        (*png_ptr).sig_bit.blue = buf[2];\n319\t        (*png_ptr).sig_bit.alpha = buf[3];\n320\t    } else\n321\t    /* grayscale */\n322\t    {\n323\t        (*png_ptr).sig_bit.gray = buf[0];\n324\t        (*png_ptr).sig_bit.red = buf[0];\n325\t        (*png_ptr).sig_bit.green = buf[0];\n326\t        (*png_ptr).sig_bit.blue = buf[0];\n327\t        (*png_ptr).sig_bit.alpha = buf[1];\n328\t    }\n329\t\n330\t    png_set_sBIT(png_ptr, info_ptr, core::ptr::addr_of!((*png_ptr).sig_bit));\n331\t    handled_ok\n332\t}\n333\t/* READ_sBIT */\n334\t\n335\t/* READ_cHRM */\n336\tpub(crate) unsafe fn png_get_int_32_checked(\n337\t    buf: png_const_bytep,\n338\t    error: *mut c_int,\n339\t) -> png_int_32 {\n340\t    let mut uval: png_uint_32 = PNG_get_uint_32(buf);\n341\t    if (uval & 0x80000000u32) == 0\n342\t    /* non-negative */\n343\t    {\n344\t        return uval as png_int_32;\n345\t    }\n346\t\n347\t    uval = (uval ^ 0xffffffffu32).wrapping_add(1); /* 2's complement: -x = ~x+1 */\n348\t    if (uval & 0x80000000u32) == 0\n349\t    /* no overflow */\n350\t    {\n351\t        return (uval as png_int_32).wrapping_neg();\n352\t    }\n353\t\n354\t    /* This version of png_get_int_32 has a way of returning the error to the\n355\t     * caller, so:\n356\t     */\n357\t    *error = 1;\n358\t    0 /* Safe */\n359\t}\n360\t\n361\tpub(crate) unsafe fn png_handle_cHRM(\n362\t    png_ptr: png_structrp,\n363\t    info_ptr: png_inforp,\n364\t    length: png_uint_32,\n365\t) -> c_int {\n366\t    let mut error: c_int = 0;\n367\t    let mut xy: png_xy = png_xy::default();\n368\t    let mut buf: [png_byte; 32] = [0; 32];\n369\t\n370\t    png_crc_read(png_ptr, buf.as_mut_ptr(), 32);\n371\t\n372\t    if png_crc_finish(png_ptr, 0) != 0 {\n373\t        return handled_error;\n374\t    }\n375\t\n376\t    xy.whitex = png_get_int_32_checked(buf.as_ptr().add(0), core::ptr::addr_of_mut!(error));\n377\t    x