n256\t    }\n257\t\n258\t    /* WRITE_INTERLACING */\n259\t    /* If interlaced and not interested in row, return */\n260\t    if (*png_ptr).interlaced != 0 && ((*png_ptr).transformations & PNG_INTERLACE) != 0 {\n261\t        match (*png_ptr).pass {\n262\t            0 => {\n263\t                if ((*png_ptr).row_number & 0x07) != 0 {\n264\t                    png_write_finish_row(png_ptr);\n265\t                    return;\n266\t                }\n267\t            }\n268\t\n269\t            1 => {\n270\t                if ((*png_ptr).row_number & 0x07) != 0 || (*png_ptr).width < 5 {\n271\t                    png_write_finish_row(png_ptr);\n272\t                    return;\n273\t                }\n274\t            }\n275\t\n276\t            2 => {\n277\t                if ((*png_ptr).row_number & 0x07) != 4 {\n278\t                    png_write_finish_row(png_ptr);\n279\t                    return;\n280\t                }\n281\t            }\n282\t\n283\t            3 => {\n284\t                if ((*png_ptr).row_number & 0x03) != 0 || (*png_ptr).width < 3 {\n285\t                    png_write_finish_row(png_ptr);\n286\t                    return;\n287\t                }\n288\t            }\n289\t\n290\t            4 => {\n291\t                if ((*png_ptr).row_number & 0x03) != 2 {\n292\t                    png_write_finish_row(png_ptr);\n293\t                    return;\n294\t                }\n295\t            }\n296\t\n297\t            5 => {\n298\t                if ((*png_ptr).row_number & 0x01) != 0 || (*png_ptr).width < 2 {\n299\t                    png_write_finish_row(png_ptr);\n300\t                    return;\n301\t                }\n302\t            }\n303\t\n304\t            6 => {\n305\t                if ((*png_ptr).row_number & 0x01) == 0 {\n306\t                    png_write_finish_row(png_ptr);\n307\t                    return;\n308\t                }\n309\t            }\n310\t\n311\t            _ => {\n312\t                /* error: ignore it */\n313\t            }\n314\t        }\n315\t    }\n316\t\n317\t    /* Set up row info for transformations */\n318\t    row_info.color_type = (*png_ptr).color_type;\n319\t    row_info.width = (*png_ptr).usr_width;\n320\t    row_info.channels = (*png_ptr).usr_channels;\n321\t    row_info.bit_depth = (*png_ptr).usr_bit_depth;\n322\t    row_info.pixel_depth =\n323\t        (row_info.bit_depth as c_int).wrapping_mul(row_info.channels as c_int) as png_byte;\n324\t    row_info.rowbytes = PNG_ROWBYTES(row_info.pixel_depth as usize, row_info.width as usize);\n325\t\n326\t    /* Copy user's row into buffer, leaving room for filter byte. */\n327\t    memcpy((*png_ptr).row_buf.add(1), row, row_info.rowbytes);\n328\t\n329\t    /* WRITE_INTERLACING */\n330\t    /* Handle interlacing */\n331\t    if (*png_ptr).interlaced != 0\n332\t        && (*png_ptr).pass < 6\n333\t        && ((*png_ptr).transformations & PNG_INTERLACE) != 0\n334\t    {\n335\t        png_do_write_interlace(\n336\t            &mut row_info,\n337\t            (*png_ptr).row_buf.add(1),\n338\t            (*png_ptr).pass as c_int,\n339\t        );\n340\t        /* This should always get caught above, but still ... */\n341\t        if row_info.width == 0 {\n342\t            png_write_finish_row(png_ptr);\n343\t            return;\n344\t        }\n345\t    }\n346\t\n347\t    /* WRITE_TRANSFORMS */\n348\t    /* Handle other transformations */\n349\t    if (*png_ptr).transformations != 0 {\n350\t        png_do_write_transformations(png_ptr, &mut row_info);\n351\t    }\n352\t\n353\t    /* At this point the row_info pixel depth must match the 'transformed' depth,\n354\t     * which is also the output depth.\n355\t     */\n356\t    if row_info.pixel_depth != (*png_ptr).pixel_depth\n357\t        || row_info.pixel_depth != (*png_ptr).transformed_pixel_depth\n358\t    {\n359\t        png_error(png_ptr, c\"internal write transform logic error\".as_ptr());\n360\t    }\n361\t\n362\t    /* MNG_FEATURES */\n363\t    /* Write filter_method 64 (intrapixel differencing) only if\n364\t     * 1. Libpng was compiled with PNG_MNG_FEATURES_SUPPORTED and\n365\t     * 2. Libpng did not write a PNG signature (this filter_method is only\n366\t     *    used in PNG datastreams that are embedded in MNG datastreams) and\n367\t     * 3. The application called png_permit_mng_features with a mask that\n368\t     *    included PNG_FLAG_MNG_FILTER_64 and\n369\t     * 4. The filter_method is 64 and\n370\t     * 5. The color_type is RGB or RGBA\n371\t     */\n372\t    if ((*png_ptr).mng_features_permitted & PNG_FLAG_MNG_FILTER_64) != 0\n373\t        && ((*png_ptr).filter_type as c_int == PNG_INTRAPIXEL_DIFFERENCING)\n374\t    {\n375\t        /* Intrapixel differencing */\n376\t        png_do_write_intrapixel(&mut row_info, (*png_ptr).row_buf.add(1));\n377\t    }\n378\t\n379\t    /* Added at libpng-1.5.10 */\n380\t    /* WRITE_CHECK_FOR_INVALID_INDEX */\n381\t    /* Check for out-of-range palette index */\n382\t    if row_info.color_type as c_int == PNG_COLOR_TYPE_PALETTE && (*png_ptr).num_palette_max >= 0 {\n383\t        png_do_check_palette_indexes(png_ptr, &mut row_info);\n384\t    }\n385\t\n386\t    /* Find a filter if necessary, filter the row and write it out. */\n387\t    png_write_find_filter(png_ptr, &mut row_info);\n388\t\n389\t    if let Some(f) = (*png_ptr).write_row_fn {\n390\t        f(png_ptr, (*png_ptr).row_number, (*png_ptr).pass as c_int);\n391\t    }\n392\t}\n393\t\n394\t/* WRITE_FLUSH */\n395\t/* Set the automatic flush interval or 0 to turn flushing off */\n396\t#[unsafe(no_mangle)]\n397\tpub unsafe extern \"C-unwind\" fn png_set_flush(png_ptr: png_structrp, nrows: c_int) {\n398\t    if png_ptr.is_null() {\n399\t        return;\n400\t    }\n401\t\n402\t    (*png_ptr).flush_dist = if nrows < 0 { 0 } else { nrows as png_uint_32 };\n403\t}\n404\t\n405\t/* Flush the current output buffers now */\n406\t#[unsafe(no_mangle)]\n407\tpub unsafe extern \"C-unwind\" fn png_write_flush(png_ptr: png_structrp) {\n408\t    if png_ptr.is_null() {\n409\t        return;\n410\t    }\n411\t\n412\t    /* We have already written out all of the data */\n413\t    if (*png_ptr).row_number >= (*png_ptr).num_rows {\n414\t        return;\n415\t    }\n416\t\n417\t    png_compress_IDAT(png_ptr, core::ptr::null(), 0, Z_SYNC_FLUSH);\n418\t    (*png_ptr).flush_rows = 0;\n419\t    png_flush(png_ptr);\n420\t}\n421\t/* WRITE_FLUSH */\n422\t\n423\t/* Free any memory used in png_ptr struct without freeing the struct itself. */\n424\tpub(crate) unsafe fn png_write_destroy(png_ptr: png_structrp) {\n425\t    /* Free any memory zlib uses */\n426\t    if ((*png_ptr).flags & PNG_FLAG_ZSTREAM_INITIALIZED) != 0 {\n427\t        deflateEnd(core::ptr::addr_of_mut!((*png_ptr).zstream));\n428\t    }\n429\t\n430\t    /* Free our memory.  png_free checks NULL for us. */\n431\t    png_free_buffer_list(png_ptr, core::ptr::addr_of_mut!((*png_ptr).zbuffer_list));\n432\t    png_free(png_ptr, (*png_ptr).row_buf as png_voidp);\n433\t    (*png_ptr).row_buf = core::ptr::null_mut();\n434\t    /* WRITE_FILTER */\n435\t    png_free(png_ptr, (*png_ptr).prev_row as png_voidp);\n436\t    png_free(png_ptr, (*png_ptr).try_row as png_voidp);\n437\t    png_free(png_ptr, (*png_ptr).tst_row as png_voidp);\n438\t    (*png_ptr).prev_row = core::ptr::null_mut();\n439\t    (*png_ptr).try_row = core::ptr::null_mut();\n440\t    (*png_ptr).tst_row = core::ptr::null_mut();\n441\t\n442\t    /* SET_UNKNOWN_CHUNKS */\n443\t    png_free(png_ptr, (*png_ptr).chunk_list as png_voidp);\n444\t    (*png_ptr).chunk_list = core::ptr::null_mut();\n445\t\n446\t    /* tRNS */\n447\t    /* Free the independent copy of trans_alpha owned by png_struct. */\n448\t    png_free(png_ptr, (*png_ptr).trans_alpha as png_voidp);\n449\t    (*png_ptr).trans_alpha = core::ptr::null_mut();\n450\t\n451\t    /* Free the independent copy of the palette owned by png_struct. */\n452\t    png_free(png_ptr, (*png_ptr).palette as png_voidp);\n453\t    (*png_ptr).palette = core::ptr::null_mut();\n454\t\n455\t    /* The error handling and memory handling information is left intact at this\n456\t     * point: the jmp_buf may still have to be freed.  See png_destroy_png_struct\n457\t     * for how this happens.\n458\t     */\n459\t}\n460\t\n461\t/* Free all memory used by the write.\n462\t * In libpng 1.6.0 this API changed quietly to no longer accept a NULL value for\n463\t * *png_ptr_ptr.  Prior to 1.6.0 it would accept such a value and it would free\n464\t * the passed in info_structs but it would quietly fail to free any of the data\n465\t * inside them.  In 1.6.0 it quietly does nothing (it has to be quiet because it\n466\t * has no png_ptr.)\n467\t */\n468\t#[unsafe(no_mangle)]\n469\tpub unsafe extern \"C-unwind\" fn png_destroy_write_struct(\n470\t    png_ptr_ptr: png_structpp,\n471\t    info_ptr_ptr: png_infopp,\n472\t) {\n473\t    if !png_ptr_ptr.is_null() {\n474\t        let png_ptr: png_structrp = *png_ptr_ptr;\n475\t\n476\t        if !png_ptr.is_null()\n477\t        /* added in libpng 1.6.0 */\n478\t        {\n479\t            png_destroy_info_struct(png_ptr, info_ptr_ptr);\n480\t\n481\t            *png_ptr_ptr = core::ptr::null_mut();\n482\t            png_write_destroy(png_ptr);\n483\t            png_destroy_png_struct(png_ptr);\n484\t        }\n485\t    }\n486\t}\n487\t\n488\t/* Allow the application to select one or more row filters to use. */\n489\t#[unsafe(no_mangle)]\n490\tpub unsafe extern \"C-unwind\" fn png_set_filter(\n491\t    png_ptr: png_structrp,\n492\t    method: c_int,\n493\t    filters: c_int,\n494\t) {\n495\t    let mut method: c_int = method;\n496\t    let mut filters: c_int = filters;\n497\t\n498\t    if png_ptr.is_null() {\n499\t        return;\n500\t    }\n501\t\n502\t    /* MNG_FEATURES */\n503\t    if ((*png_ptr).mng_features_permitted & PNG_FLAG_MNG_FILTER_64) != 0\n504\t        && (method == PNG_INTRAPIXEL_DIFFERENCING)\n505\t    {\n506\t        method = PNG_FILTER_TYPE_BASE;\n507\t    }\n508\t\n509\t    if method == PNG_FILTER_TYPE_BASE {\n510\t        match filters & (PNG_ALL_FILTERS | 0x07) {\n511\t            /* WRITE_FILTER */\n512\t            5 | 6 | 7 => {\n513\t                png_app_error(png_ptr, c\"Unknown row filter for method 0\".as_ptr());\n514\t                /* FALLTHROUGH */\n515\t                (*png_ptr).do_filter = PNG_FILTER_NONE as png_byte;\n516\t            }\n517\t            PNG_FILTER_VALUE_NONE => {\n518\t                (*png_ptr).do_filter = PNG_FILTER_NONE as png_byte;\n519\t            }\n520\t\n521\t            /* WRITE_FILTER */\n522\t            PNG_FILTER_VALUE_SUB => {\n523\t                (*png_ptr).do_filter = PNG_FILTER_SUB as png_byte;\n524\t            }\n525\t\n526\t            PNG_FILTER_VALUE_UP => {\n527\t                (*png_ptr).do_filter = PNG_FILTER_UP as png_byte;\n528\t            }\n529\t\n530\t            PNG_FILTER_VALUE_AVG => {\n531\t                (*png_ptr).do_filter = PNG_FILTER_AVG as png_byte;\n532\t            }\n533\t\n534\t            PNG_FILTER_VALUE_PAETH => {\n535\t                (*png_ptr).do_filter = PNG_FILTER_PAETH as png_byte;\n536\t            }\n537\t\n538\t            _ => {\n539\t                (*png_ptr).do_filter = filters as png_byte;\n540\t            }\n541\t        }\n542\t\n543\t        /* WRITE_FILTER */\n544\t        /* If we have allocated the row_buf, this means we have already started\n545\t         * with the image and we should have allocated all of the filter buffers\n546\t         * that have been selected.  If prev_row isn't already allocated, then\n547\t         * it is too late to start using the filters that need it, since we\n548\t         * will be missing the data in the previous row.  If an application\n549\t         * wants to start and stop using particular filters during compression,\n550\t         * it should start out with all of the filters, and then remove them\n551\t         * or add them back after the start of compression.\n552\t         *\n553\t         * NOTE: this is a nasty constraint on the code, because it means that the\n554\t         * prev_row buffer must be maintained even if there are currently no\n555\t         * 'prev_row' requiring filters active.\n556\t         */\n557\t        if !(*png_ptr).row_buf.is_null() {\n558\t            let mut num_filters: c_int;\n559\t            let buf_size: png_alloc_size_t;\n560\t\n561\t            /* Repeat the checks in png_write_start_row; 1 pixel high or wide\n562\t             * images cannot benefit from certain filters.  If this isn't done here\n563\t             * the check below will fire on 1 pixel high images.\n564\t             */\n565\t            if (*png_ptr).height == 1 {\n566\t                filters &= !(PNG_FILTER_UP | PNG_FILTER_AVG | PNG_FILTER_PAETH);\n567\t            }\n568\t\n569\t            if (*png_ptr).width == 1 {\n570\t                filters &= !(PNG_FILTER_SUB | PNG_FILTER_AVG | PNG_FILTER_PAETH);\n571\t            }\n572\t\n573\t            if (filters & (PNG_FILTER_UP | PNG_FILTER_AVG | PNG_FILTER_PAETH)) != 0\n574\t                && (*png_ptr).prev_row.is_null()\n575\t            {\n576\t                /* This is the error case, however it is benign - the previous row\n577\t                 * is not available so the filter can't be used.  Just warn here.\n578\t                 */\n579\t                png_app_warning(\n580\t                    png_ptr,\n581\t                    c\"png_set_filter: UP/AVG/PAETH cannot be added after start\".as_ptr(),\n582\t                );\n583\t                filters &= !(PNG_FILTER_UP | PNG_FILTER_AVG | PNG_FILTER_PAETH);\n584\t            }\n585\t\n586\t            num_filters = 0;\n587\t\n588\t            if (filters & PNG_FILTER_SUB) != 0 {\n589\t                num_filters += 1;\n590\t            }\n591\t\n592\t            if (filters & PNG_FILTER_UP) != 0 {\n593\t                num_filters += 1;\n594\t            }\n595\t\n596\t            if (filters & PNG_FILTER_AVG) != 0 {\n597\t                num_filters += 1;\n598\t            }\n599\t\n600\t            if (filters & PNG_FILTER_PAETH) != 0 {\n601\t                num_filters += 1;\n602\t            }\n603\t\n604\t            /* Allocate needed row buffers if they have not already been\n605\t             * allocated.\n606\t             */\n607\t            buf_size = PNG_ROWBYTES(\n608\t                ((*png_ptr).usr_channels as c_int).wrapping_mul((*png_ptr).usr_bit_depth as c_int)\n609\t                    as usize,\n610\t                (*png_ptr).width as usize,\n611\t            )\n612\t            .wrapping_add(1);\n613\t\n614\t            if (*png_ptr).try_row.is_null() {\n615\t                (*png_ptr).try_row = png_malloc(png_ptr, buf_size) as png_bytep;\n616\t            }\n617\t\n618\t            if num_filters > 1 {\n619\t                if (*png_ptr).tst_row.is_null() {\n620\t                    (*png_ptr).tst_row = png_malloc(png_ptr, buf_size) as png_bytep;\n621\t                }\n622\t            }\n623\t        }\n624\t        (*png_ptr).do_filter = filters as png_byte;\n625\t        /* WRITE_FILTER */\n626\t    } else {\n627\t        png_error(png_ptr, c\"Unknown custom filter method\".as_ptr());\n628\t    }\n629\t}\n630\t\n631\t/* WRITE_WEIGHTED_FILTER -- DEPRECATED */\n632\t/* Provide floating and fixed point APIs */\n633\t#[unsafe(no_mangle)]\n634\tpub unsafe extern \"C-unwind\" fn png_set_filter_heuristics(\n635\t    png_ptr: png_structrp,\n636\t    heuristic_method: c_int,\n637\t    num_weights: c_int,\n638\t    filter_weights: png_const_doublep,\n639\t    filter_costs: png_const_doublep,\n640\t) {\n641\t}\n642\t\n643\t#[unsafe(no_mangle)]\n644\tpub unsafe extern \"C-unwind\" fn png_set_filter_heuristics_fixed(\n645\t    png_ptr: png_structrp,\n646\t    heuristic_method: c_int,\n647\t    num_weights: c_int,\n648\t    filter_weights: png_const_fixed_point_p,\n649\t    filter_costs: png_const_fixed_point_p,\n650\t) {\n651\t}\n652\t/* WRITE_WEIGHTED_FILTER */\n653\t\n654\t/* WRITE_CUSTOMIZE_COMPRESSION */\n655\t#[unsafe(no_mangle)]\n656\tpub unsafe extern \"C-unwind\" fn png_set_compression_level(png_ptr: png_structrp, level: c_int) {\n657\t    if png_ptr.is_null() {\n658\t        return;\n659\t    }\n660\t\n661\t    (*png_ptr).zlib_level = level;\n662\t}\n663\t\n664\t#[unsafe(no_mangle)]\n665\tpub unsafe extern \"C-unwind\" fn png_set_compression_mem_level(\n666\t    png_ptr: png_structrp,\n667\t    mem_level: c_int,\n668\t) {\n669\t    if png_ptr.is_null() {\n670\t        return;\n671\t    }\n672\t\n673\t    (*png_ptr).zlib_mem_level = mem_level;\n674\t}\n675\t\n676\t#[unsafe(no_mangle)]\n677\tpub unsafe extern \"C-unwind\" fn png_set_compression_strategy(\n678\t    png_ptr: png_structrp,\n679\t    strategy: c_int,\n680\t) {\n681\t    if png_ptr.is_null() {\n682\t        return;\n683\t    }\n684\t\n685\t    /* The flag setting here prevents the libpng dynamic selection of strategy.\n686\t     */\n687\t    (*png_ptr).flags |= PNG_FLAG_ZLIB_CUSTOM_STRATEGY;\n688\t    (*png_ptr).zlib_strategy = strategy;\n689\t}\n690\t\n691\t/* If PNG_WRITE_OPTIMIZE_CMF_SUPPORTED is defined, libpng will use a\n692\t * smaller value of window_bits if it can do so safely.\n693\t */\n694\t#[unsafe(no_mangle)]\n695\tpub unsafe extern \"C-unwind\" fn png_set_compression_window_bits(\n696\t    png_ptr: png_structrp,\n697\t    window_bits: c_int,\n698\t) {\n699\t    let mut window_bits: c_int = window_bits;\n700\t\n701\t    if png_ptr.is_null() {\n702\t        return;\n703\t    }\n704\t\n705\t    /* Prior to 1.6.0 this would warn but then set the window_bits value. This\n706\t     * meant that negative window bits values could be selected that would cause\n707\t     * libpng to write a non-standard PNG file with raw deflate or gzip\n708\t     * compressed IDAT or ancillary chunks.  Such files can be read and there is\n709\t     * no warning on read, so this seems like a very bad idea.\n710\t     */\n711\t    if window_bits > 15 {\n712\t        png_warning(\n713\t            png_ptr,\n714\t            c\"Only compression windows <= 32k supported by PNG\".as_ptr(),\n715\t        );\n716\t        window_bits = 15;\n717\t    } else if window_bits < 8 {\n718\t        png_warning(\n719\t            png_ptr,\n720\t            c\"Only compression windows >= 256 supported by PNG\".as_ptr(),\n721\t        );\n722\t        window_bits = 8;\n723\t    }\n724\t\n725\t    (*png_ptr).zlib_window_bits = window_bits;\n726\t}\n727\t\n728\t#[unsafe(no_mangle)]\n729\tpub unsafe extern \"C-unwind\" fn png_set_compression_method(png_ptr: png_structrp, method: c_int) {\n730\t    if png_ptr.is_null() {\n731\t        return;\n732\t    }\n733\t\n734\t    /* This would produce an invalid PNG file if it worked, but it doesn't and\n735\t     * deflate will fault it, so it is harmless to just warn here.\n736\t     */\n737\t    if method != 8 {\n738\t        png_warning(\n739\t            png_ptr,\n740\t            c\"Only compression method 8 is supported by PNG\".as_ptr(),\n741\t        );\n742\t    }\n743\t\n744\t    (*png_ptr).zlib_method = method;\n745\t}\n746\t/* WRITE_CUSTOMIZE_COMPRESSION */\n747\t\n748\t/* The following were added to libpng-1.5.4 */\n749\t/* WRITE_CUSTOMIZE_ZTXT_COMPRESSION */\n750\t#[unsafe(no_mangle)]\n751\tpub unsafe extern \"C-unwind\" fn png_set_text_compression_level(\n752\t    png_ptr: png_structrp,\n753\t    level: c_int,\n754\t) {\n755\t    if png_ptr.is_null() {\n756\t        return;\n757\t    }\n758\t\n759\t    (*png_ptr).zlib_text_level = level;\n760\t}\n761\t\n762\t#[unsafe(no_mangle)]\n763\tpub unsafe extern \"C-unwind\" fn png_set_text_compression_mem_level(\n764\t    png_ptr: png_structrp,\n765\t    mem_level: c_int,\n766\t) {\n767\t    if png_ptr.is_null() {\n768\t        return;\n769\t    }\n770\t\n771\t    (*png_ptr).zlib_text_mem_level = mem_level;\n772\t}\n773\t\n774\t#[unsafe(no_mangle)]\n775\tpub unsafe extern \"C-unwind\" fn png_set_text_compression_strategy(\n776\t    png_ptr: png_structrp,\n777\t    strategy: c_int,\n778\t) {\n779\t    if png_ptr.is_null() {\n780\t        return;\n781\t    }\n782\t\n783\t    (*png_ptr).zlib_text_strategy = strategy;\n784\t}\n785\t\n786\t/* If PNG_WRITE_OPTIMIZE_CMF_SUPPORTED is defined, libpng will use a\n787\t * smaller value of window_bits if it can do so safely.\n788\t */\n789\t#[unsafe(no_mangle)]\n790\tpub unsafe extern \"C-unwind\" fn png_set_text_compression_window_bits(\n791\t    png_ptr: png_structrp,\n792\t    window_bits: c_int,\n793\t) {\n794\t    let mut window_bits: c_int = window_bits;\n795\t\n796\t    if png_ptr.is_null() {\n797\t        return;\n798\t    }\n799\t\n800\t    if window_bits > 15 {\n801\t        png_warning(\n802\t            png_ptr,\n803\t            c\"Only compression windows <= 32k supported by PNG\".as_ptr(),\n804\t        );\n805\t        window_bits = 15;\n806\t    } else if window_bits < 8 {\n807\t        png_warning(\n808\t            png_ptr,\n809\t            c\"Only compression windows >= 256 supported by PNG\".as_ptr(),\n810\t        );\n811\t        window_bits = 8;\n812\t    }\n813\t\n814\t    (*png_ptr).zlib_text_window_bits = window_bits;\n815\t}\n816\t\n817\t#[unsafe(no_mangle)]\n818\tpub unsafe extern \"C-unwind\" fn png_set_text_compression_method(\n819\t    png_ptr: png_structrp,\n820\t    method: c_int,\n821\t) {\n822\t    if png_ptr.is_null() {\n823\t        return;\n824\t    }\n825\t\n826\t    if method != 8 {\n827\t        png_warning(\n828\t            png_ptr,\n829\t            c\"Only compression method 8 is supported by PNG\".as_ptr(),\n830\t        );\n831\t    }\n832\t\n833\t    (*png_ptr).zlib_text_method = method;\n834\t}\n835\t/* WRITE_CUSTOMIZE_ZTXT_COMPRESSION */\n836\t/* end of API added to libpng-1.5.4 */\n837\t\n838\t#[unsafe(no_mangle)]\n839\tpub unsafe extern \"C-unwind\" fn png_set_write_status_fn(\n840\t    png_ptr: png_structrp,\n841\t    write_row_fn: png_write_status_ptr,\n842\t) {\n843\t    if png_ptr.is_null() {\n844\t        return;\n8