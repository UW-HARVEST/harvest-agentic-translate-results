num_pal == 0)\n189\t        || num_pal > max_palette_length\n190\t    {\n191\t        if (*png_ptr).color_type as c_int == PNG_COLOR_TYPE_PALETTE {\n192\t            png_error(png_ptr, c\"Invalid number of colors in palette\".as_ptr());\n193\t        } else {\n194\t            png_warning(png_ptr, c\"Invalid number of colors in palette\".as_ptr());\n195\t            return;\n196\t        }\n197\t    }\n198\t\n199\t    if ((*png_ptr).color_type as c_int & PNG_COLOR_MASK_COLOR) == 0 {\n200\t        png_warning(\n201\t            png_ptr,\n202\t            c\"Ignoring request to write a PLTE chunk in grayscale PNG\".as_ptr(),\n203\t        );\n204\t\n205\t        return;\n206\t    }\n207\t\n208\t    (*png_ptr).num_palette = num_pal as png_uint_16;\n209\t\n210\t    png_write_chunk_header(png_ptr, png_PLTE, num_pal.wrapping_mul(3));\n211\t\n212\t    i = 0;\n213\t    pal_ptr = palette;\n214\t    while i < num_pal {\n215\t        buf[0] = (*pal_ptr).red;\n216\t        buf[1] = (*pal_ptr).green;\n217\t        buf[2] = (*pal_ptr).blue;\n218\t        png_write_chunk_data(png_ptr, buf.as_ptr(), 3);\n219\t\n220\t        i = i.wrapping_add(1);\n221\t        pal_ptr = pal_ptr.add(1);\n222\t    }\n223\t\n224\t    png_write_chunk_end(png_ptr);\n225\t    (*png_ptr).mode |= PNG_HAVE_PLTE;\n226\t}\n227\t\n228\t/* This is similar to png_text_compress, above, except that it does not require\n229\t * all of the data at once and, instead of buffering the compressed result,\n230\t * writes it as IDAT chunks.  Unlike png_text_compress it *can* png_error out\n231\t * because it calls the write interface.  As a result it does its own error\n232\t * reporting and does not return an error code.  In the event of error it will\n233\t * just call png_error.  The input data length may exceed 32-bits.  The 'flush'\n234\t * parameter is exactly the same as that to deflate, with the following\n235\t * meanings:\n236\t *\n237\t * Z_NO_FLUSH: normal incremental output of compressed data\n238\t * Z_SYNC_