{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01S57njboJEDBj9c4MDGpmH5","type":"tool_result","content":"1\t//! Translated from pngerror.c\n2\t\n3\t#![allow(non_snake_case)]\n4\t\n5\tuse core::ffi::{c_char, c_int};\n6\t\n7\tuse crate::png::png_image_free;\n8\tuse crate::pngmem::{png_free, png_malloc_warn};\n9\tuse crate::pngpriv::*;\n10\tuse crate::types::*;\n11\t\n12\tconst PNG_LITERAL_LEFT_SQUARE_BRACKET: c_char = 0x5b;\n13\tconst PNG_LITERAL_RIGHT_SQUARE_BRACKET: c_char = 0x5d;\n14\t\n15\t/// Marker payload used for the `png_safe_error` unwind.\n16\tpub struct PngSafeUnwind;\n17\t\n18\t#[unsafe(no_mangle)]\n19\tpub unsafe extern \"C-unwind\" fn png_error(\n20\t    png_ptr: png_const_structrp,\n21\t    error_message: png_const_charp,\n22\t) -> ! {\n23\t    if !png_ptr.is_null() {\n24\t        if let Some(f) = (*png_ptr).error_fn {\n25\t            f(png_ptr, error_message);\n26\t        }\n27\t    }\n28\t\n29\t    /* If the custom handler doesn't exist, or if it returns,\n30\t     * use the default handler, which will not return. */\n31\t    png_default_error(png_ptr, error_message)\n32\t}\n33\t\n34\t#[unsafe(no_mangle)]\n35\tpub unsafe extern \"C-unwind\" fn png_safecat(\n36\t    buffer: png_charp,\n37\t    bufsize: usize,\n38\t    pos: usize,\n39\t    string: png_const_charp,\n40\t) -> usize {\n41\t    let mut pos = pos;\n42\t\n43\t    if !buffer.is_null() && pos < bufsize {\n44\t        if !string.is_null() {\n45\t            let mut s = string;\n46\t            while *s != 0 && pos < bufsize - 1 {\n47\t                *buffer.add(pos) = *s;\n48\t                pos += 1;\n49\t                s = s.add(1);\n50\t            }\n51\t        }\n52\t\n53\t        *buffer.add(pos) = 0;\n54\t    }\n55\t\n56\t    pos\n57\t}\n58\t\n59\t#[unsafe(no_mangle)]\n60\tpub unsafe extern \"C-unwind\" fn png_format_number(\n61\t    start: png_const_charp,\n62\t    end: png_charp,\n63\t    format: c_int,\n64\t    number: png_alloc_size_t,\n65\t) -> png_charp {\n66\t    static DIGITS: [u8; 17] = *b\"0123456789ABCDEF\\0\";\n67\t\n68\t    let mut number = number;\n69\t    let mut count: c_int = 0; /* number of digits output */\n70\t    let mut mincount: c_int = 1; /* minimum number required */\n71\t    let mut output: c_int = 0; /* digit output (for the fixed point format) */\n72\t    let mut end = end;\n73\t\n74\t    end = end.sub(1);\n75\t    *end = 0;\n76\t\n77\t    /* This is written so that the loop always runs at least once, even with\n78\t     * number zero.\n79\t     */\n80\t    while (end as usize) > (start as usize) && (number != 0 || count < mincount) {\n81\t        match format {\n82\t            PNG_NUMBER_FORMAT_fixed => {\n83\t                /* Needs five digits (the fraction) */\n84\t                mincount = 5;\n85\t                if output != 0 || number % 10 != 0 {\n86\t                    end = end.sub(1);\n87\t                    *end = DIGITS[(number % 10) as usize] as c_char;\n88\t                    output = 1;\n89\t                }\n90\t                number /= 10;\n91\t            }\n92\t\n93\t            PNG_NUMBER_FORMAT_02u => {\n94\t                /* Expects at least 2 digits. (falls through to _u) */\n95\t                mincount = 2;\n96\t                end = end.sub(1);\n97\t                *end = DIGITS[(number % 10) as usize] as c_char;\n98\t                number /= 10;\n99\t            }\n100\t\n101\t            PNG_NUMBER_FORMAT_u => {\n102\t                end = end.sub(1);\n103\t                *end = DIGITS[(number % 10) as usize] as c_char;\n104\t                number /= 10;\n105\t            }\n106\t\n107\t            PNG_NUMBER_FORMAT_02x => {\n108\t                /* This format expects at least two digits (falls through to _x) */\n109\t                mincount = 2;\n110\t                end = end.sub(1);\n111\t                *end = DIGITS[(number & 0xf) as usize] as c_char;\n112\t                number >>= 4;\n113\t            }\n114\t\n115\t            PNG_NUMBER_FORMAT_x => {\n116\t                end = end.sub(1);\n117\t                *end = DIGITS[(number & 0xf) as usize] as c_char;\n118\t                number >>= 4;\n119\t            }\n120\t\n121\t            _ => {\n122\t                /* an error */\n123\t                number = 0;\n124\t            }\n125\t        }\n126\t\n127\t        /* Keep track of the number of digits added */\n128\t        count += 1;\n129\t\n130\t        /* Float a fixed number here: */\n131\t        if format == PNG_NUMBER_FORMAT_fixed && count == 5 && (end as usize) > (start as usize) {\n132\t            /* End of the fraction, but maybe nothing was output?  In that case\n133\t             * drop the decimal point.  If the number is a true zero handle that\n134\t             * here.\n135\t             */\n136\t            if output != 0 {\n137\t                end = end.sub(1);\n138\t                *end = b'.' as c_char;\n139\t            } else if number == 0 {\n140\t                end = end.sub(1);\n141\t                *end = b'0' as c_char;\n142\t            }\n143\t        }\n144\t    }\n145\t\n146\t    end\n147\t}\n148\t\n149\t#[unsafe(no_mangle)]\n150\tpub unsafe extern \"C-unwind\" fn png_warning(\n151\t    png_ptr: png_const_structrp,\n152\t    warning_message: png_const_charp,\n153\t) {\n154\t    let offset = 0usize;\n155\t    if !png_ptr.is_null() {\n156\t        if let Some(f) = (*png_ptr).warning_fn {\n157\t            f(png_ptr, warning_message.add(offset));\n158\t            return;\n159\t        }\n160\t    }\n161\t    png_default_warning(png_ptr, warning_message.add(offset));\n162\t}\n163\t\n164\t#[unsafe(no_mangle)]\n165\tpub unsafe extern \"C-unwind\" fn png_warning_parameter(\n166\t    p: *mut [c_char; PNG_WARNING_PARAMETER_SIZE],\n167\t    number: c_int,\n168\t    string: png_const_charp,\n169\t) {\n170\t    if number > 0 && number <= PNG_WARNING_PARAMETER_COUNT as c_int {\n171\t        let slot = p.add((number - 1) as usize) as png_charp;\n172\t        png_safecat(slot, PNG_WARNING_PARAMETER_SIZE, 0, string);\n173\t    }\n174\t}\n175\t\n176\t#[unsafe(no_mangle)]\n177\tpub unsafe extern \"C-unwind\" fn png_warning_parameter_unsigned(\n178\t    p: *mut [c_char; PNG_WARNING_PARAMETER_SIZE],\n179\t    number: c_int,\n180\t    format: c_int,\n181\t    value: png_alloc_size_t,\n182\t) {\n183\t    let mut buffer: [c_char; PNG_NUMBER_BUFFER_SIZE] = [0; PNG_NUMBER_BUFFER_SIZE];\n184\t    let s = png_format_number(\n185\t        buffer.as_ptr(),\n186\t        buffer.as_mut_ptr().add(PNG_NUMBER_BUFFER_SIZE),\n187\t        format,\n188\t        value,\n189\t    );\n190\t    png_warning_parameter(p, number, s);\n191\t}\n192\t\n193\t#[unsafe(no_mangle)]\n194\tpub unsafe extern \"C-unwind\" fn png_warning_parameter_signed(\n195\t    p: *mut [c_char; PNG_WARNING_PARAMETER_SIZE],\n196\t    number: c_int,\n197\t    format: c_int,\n198\t    value: png_int_32,\n199\t) {\n200\t    let mut buffer: [c_char; PNG_NUMBER_BUFFER_SIZE] = [0; PNG_NUMBER_BUFFER_SIZE];\n201\t\n202\t    /* Avoid overflow by doing the negate in a png_alloc_size_t: */\n203\t    let mut u = value as png_alloc_size_t;\n204\t    if value < 0 {\n205\t        u = (!u).wrapping_add(1);\n206\t    }\n207\t\n208\t    let mut str = png_format_number(\n209\t        buffer.as_ptr(),\n210\t        buffer.as_mut_ptr().add(PNG_NUMBER_BUFFER_SIZE),\n211\t        format,\n212\t        u,\n213\t    );\n214\t\n215\t    if value < 0 && (str as usize) > (buffer.as_ptr() as usize) {\n216\t        str = str.sub(1);\n217\t        *str = b'-' as c_char;\n218\t    }\n219\t\n220\t    png_warning_parameter(p, number, str);\n221\t}\n222\t\n223\t#[unsafe(no_mangle)]\n224\tpub unsafe extern \"C-unwind\" fn png_formatted_warning(\n225\t    png_ptr: png_const_structrp,\n226\t    p: *mut [c_char; PNG_WARNING_PARAMETER_SIZE],\n227\t    message: png_const_charp,\n228\t) {\n229\t    let mut i: usize = 0;\n230\t    let mut msg: [c_char; 192] = [0; 192];\n231\t    let mut message = message;\n232\t\n233\t    while i < 192 - 1 && *message != 0 {\n234\t        /* '@' at end of string is now just printed (previously it was skipped);\n235\t         * it is an error in the calling code to terminate the string with @.\n236\t         */\n237\t        if !p.is_null() && *message == b'@' as c_char && *message.add(1) != 0 {\n238\t            message = message.add(1);\n239\t            let parameter_char = *message as c_int; /* Consume the '@' */\n240\t            const VALID_PARAMETERS: [u8; 10] = *b\"123456789\\0\";\n241\t            let mut parameter = 0usize;\n242\t\n243\t            while VALID_PARAMETERS[parameter] as c_int != parameter_char\n244\t                && VALID_PARAMETERS[parameter] != 0\n245\t            {\n246\t                parameter += 1;\n247\t            }\n248\t\n249\t            /* If the parameter digit is out of range it will just get printed. */\n250\t            if parameter < PNG_WARNING_PARAMETER_COUNT {\n251\t                /* Append this parameter */\n252\t                let mut parm = (p.add(parameter) as png_const_charp) as *const c_char;\n253\t                let pend = (p.add(parameter) as png_const_charp).add(PNG_WARNING_PARAMETER_SIZE);\n254\t\n255\t                while i < 192 - 1 && *parm != 0 && (parm as usize) < (pend as usize) {\n256\t                    msg[i] = *parm;\n257\t                    i += 1;\n258\t                    parm = parm.add(1);\n259\t                }\n260\t\n261\t                /* Consume the parameter digit too: */\n262\t                message = message.add(1);\n263\t                continue;\n264\t            }\n265\t\n266\t            /* else not a parameter and there is a character after the @ sign;\n267\t             * just copy that.\n268\t             */\n269\t        }\n270\t\n271\t        msg[i] = *message;\n272\t        i += 1;\n273\t        message = message.add(1);\n274\t    }\n275\t\n276\t    /* i is always less than (sizeof msg), so: */\n277\t    msg[i] = 0;\n278\t\n279\t    png_warning(png_ptr, msg.as_ptr());\n280\t}\n281\t\n282\t#[unsafe(no_mangle)]\n283\tpub unsafe extern \"C-unwind\" fn png_benign_error(\n284\t    png_ptr: png_const_structrp,\n285\t    error_message: png_const_charp,\n286\t) {\n287\t    if ((*png_ptr).flags & PNG_FLAG_BENIGN_ERRORS_WARN) != 0 {\n288\t        if ((*png_ptr).mode & PNG_IS_READ_STRUCT) != 0 && (*png_ptr).chunk_name != 0 {\n289\t            png_chunk_warning(png_ptr, error_message);\n290\t        } else {\n291\t            png_warning(png_ptr, error_message);\n292\t        }\n293\t    } else {\n294\t        if ((*png_ptr).mode & PNG_IS_READ_STRUCT) != 0 && (*png_ptr).chunk_name != 0 {\n295\t            png_chunk_error(png_ptr, error_message);\n296\t        } else {\n297\t            png_error(png_ptr, error_message);\n298\t        }\n299\t    }\n300\t}\n301\t\n302\t#[unsafe(no_mangle)]\n303\tpub unsafe extern \"C-unwind\" fn png_app_warning(\n304\t    png_ptr: png_const_structrp,\n305\t    error_message: png_const_charp,\n306\t) {\n307\t    if ((*png_ptr).flags & PNG_FLAG_APP_WARNINGS_WARN) != 0 {\n308\t        png_warning(png_ptr, error_message);\n309\t    } else {\n310\t        png_error(png_ptr, error_message);\n311\t    }\n312\t}\n313\t\n314\t#[unsafe(no_mangle)]\n315\tpub unsafe extern \"C-unwind\" fn png_app_error(\n316\t    png_ptr: png_const_structrp,\n317\t    error_message: png_const_charp,\n318\t) {\n319\t    if ((*png_ptr).flags & PNG_FLAG_APP_ERRORS_WARN) != 0 {\n320\t        png_warning(png_ptr, error_message);\n321\t    } else {\n322\t        png_error(png_ptr, error_message);\n323\t    }\n324\t}\n325\t\n326\t#[inline]\n327\tfn isnonalpha(c: c_int) -> bool {\n328\t    c < 65 || c > 122 || (c > 90 && c < 97)\n329\t}\n330\t\n331\tstatic PNG_DIGIT: [u8; 16] = *b\"0123456789ABCDEF\";\n332\t\n333\t/// buffer must have room for 18 + PNG_MAX_ERROR_TEXT characters\n334\tunsafe fn png_format_buffer(\n335\t    png_ptr: png_const_structrp,\n336\t    buffer: png_charp,\n337\t    error_message: png_const_charp,\n338\t) {\n339\t    let chunk_name = (*png_ptr).chunk_name;\n340\t    let mut iout: usize = 0;\n341\t    let mut ishift: c_int = 24;\n342\t\n343\t    while ishift >= 0 {\n344\t        let c = ((chunk_name >> ishift) & 0xff) as c_int;\n345\t\n346\t        ishift -= 8;\n347\t        if isnonalpha(c) {\n348\t            *buffer.add(iout) = PNG_LITERAL_LEFT_SQUARE_BRACKET;\n349\t            iout += 1;\n350\t            *buffer.add(iout) = PNG_DIGIT[((c & 0xf0) >> 4) as usize] as c_char;\n351\t            iout += 1;\n352\t            *buffer.add(iout) = PNG_DIGIT[(c & 0x0f) as usize] as c_char;\n353\t            iout += 1;\n354\t            *buffer.add(iout) = PNG_LITERAL_RIGHT_SQUARE_BRACKET;\n355\t            iout += 1;\n356\t        } else {\n357\t            *buffer.add(iout) = c as c_char;\n358\t            iout += 1;\n359\t        }\n360\t    }\n361\t\n362\t    if error_message.is_null() {\n363\t        *buffer.add(iout) = 0;\n364\t    } else {\n365\t        let mut iin: usize = 0;\n366\t\n367\t        *buffer.add(iout) = b':' as c_char;\n368\t        iout += 1;\n369\t        *buffer.add(iout) = b' ' as c_char;\n370\t        iout += 1;\n371\t\n372\t        while iin < PNG_MAX_ERROR_TEXT - 1 && *error_message.add(iin) != 0 {\n373\t            *buffer.add(iout) = *error_message.add(iin);\n374\t            iout += 1;\n375\t            iin += 1;\n376\t        }\n377\t\n378\t        *buffer.add(iout) = 0;\n379\t    }\n380\t}\n381\t\n382\t#[unsafe(no_mangle)]\n383\tpub unsafe extern \"C-unwind\" fn png_chunk_error(\n384\t    png_ptr: png_const_structrp,\n385\t    error_message: png_const_charp,\n386\t) -> ! {\n387\t    let mut msg: [c_char; 18 + PNG_MAX_ERROR_TEXT] = [0; 18 + PNG_MAX_ERROR_TEXT];\n388\t    if png_ptr.is_null() {\n389\t        png_error(png_ptr, error_message);\n390\t    } else {\n391\t        png_format_buffer(png_ptr, msg.as_mut_ptr(), error_message);\n392\t        png_error(png_ptr, msg.as_ptr());\n393\t    }\n394\t}\n395\t\n396\t#[unsafe(no_mangle)]\n397\tpub unsafe extern \"C-unwind\" fn png_chunk_warning(\n398\t    png_ptr: png_const_structrp,\n399\t    warning_message: png_const_charp,\n400\t) {\n401\t    let mut msg: [c_char; 18 + PNG_MAX_ERROR_TEXT] = [0; 18 + PNG_MAX_ERROR_TEXT];\n402\t    if png_ptr.is_null() {\n403\t        png_warning(png_ptr, warning_message);\n404\t    } else {\n405\t        png_format_buffer(png_ptr, msg.as_mut_ptr(), warning_message);\n406\t        png_warning(png_ptr, msg.as_ptr());\n407\t    }\n408\t}\n409\t\n410\t#[unsafe(no_mangle)]\n411\tpub unsafe extern \"C-unwind\" fn png_chunk_benign_error(\n412\t    png_ptr: png_const_structrp,\n413\t    error_message: png_const_charp,\n414\t) {\n415\t    if ((*png_ptr).flags & PNG_FLAG_BENIGN_ERRORS_WARN) != 0 {\n416\t        png_chunk_warning(png_ptr, error_message);\n417\t    } else {\n418\t        png_chunk_error(png_ptr, error_message);\n419\t    }\n420\t}\n421\t\n422\t#[unsafe(no_mangle)]\n423\tpub unsafe extern \"C-unwind\" fn png_chunk_report(\n424\t    png_ptr: png_const_structrp,\n425\t    message: png_const_charp,\n426\t    error: c_int,\n427\t) {\n428\t    if ((*png_ptr).mode & PNG_IS_READ_STRUCT) != 0 {\n429\t        if error < PNG_CHUNK_ERROR {\n430\t            png_chunk_warning(png_ptr, message);\n431\t        } else {\n432\t            png_chunk_benign_error(png_ptr, message);\n433\t        }\n434\t    } else {\n435\t        if error < PNG_CHUNK_WRITE_ERROR {\n436\t            png_app_warning(png_ptr, message);\n437\t        } else {\n438\t            png_app_error(png_ptr, message);\n439\t        }\n440\t    }\n441\t}\n442\t\n443\t#[unsafe(no_mangle)]\n444\tpub unsafe extern \"C-unwind\" fn png_fixed_error(\n445\t    png_ptr: png_const_structrp,\n446\t    name: png_const_charp,\n447\t) -> ! {\n448\t    const FIXED_MESSAGE: &[u8] = b\"fixed point overflow in \";\n449\t    const FIXED_MESSAGE_LN: usize = 23;\n450\t\n451\t    let mut msg: [c_char; FIXED_MESSAGE_LN + PNG_MAX_ERROR_TEXT] =\n452\t        [0; FIXED_MESSAGE_LN + PNG_MAX_ERROR_TEXT];\n453\t    memcpy(\n454\t        msg.as_mut_ptr() as *mut u8,\n455\t        FIXED_MESSAGE.as_ptr(),\n456\t        FIXED_MESSAGE_LN,\n457\t    );\n458\t    let mut iin: usize = 0;\n459\t    if !name.is_null() {\n460\t        while iin < PNG_MAX_ERROR_TEXT - 1 && *name.add(iin) != 0 {\n461\t            msg[FIXED_MESSAGE_LN + iin] = *name.add(iin);\n462\t            iin += 1;\n463\t        }\n464\t    }\n465\t    msg[FIXED_MESSAGE_LN + iin] = 0;\n466\t    png_error(png_ptr, msg.as_ptr())\n467\t}\n468\t\n469\t#[unsafe(no_mangle)]\n470\tpub unsafe extern \"C-unwind\" fn png_set_longjmp_fn(\n471\t    png_ptr: png_structrp,\n472\t    longjmp_fn: png_longjmp_ptr,\n473\t    jmp_buf_size: usize,\n474\t) -> *mut jmp_buf {\n475\t    if png_ptr.is_null() {\n476\t        return core::ptr::null_mut();\n477\t    }\n478\t\n479\t    if (*png_ptr).jmp_buf_ptr.is_null() {\n480\t        (*png_ptr).jmp_buf_size = 0; /* not allocated */\n481\t\n482\t        if jmp_buf_size <= core::mem::size_of::<jmp_buf>() {\n483\t            (*png_ptr).jmp_buf_ptr = core::ptr::addr_of_mut!((*png_ptr).jmp_buf_local);\n484\t        } else {\n485\t            (*png_ptr).jmp_buf_ptr = png_malloc_warn(png_ptr, jmp_buf_size) as *mut jmp_buf;\n486\t\n487\t            if (*png_ptr).jmp_buf_ptr.is_null() {\n488\t                return core::ptr::null_mut(); /* new NULL return on OOM */\n489\t            }\n490\t\n491\t            (*png_ptr).jmp_buf_size = jmp_buf_size;\n492\t        }\n493\t    } else {\n494\t        /* Already allocated: check the size */\n495\t        let mut size = (*png_ptr).jmp_buf_size;\n496\t\n497\t        if size == 0 {\n498\t            size = core::mem::size_of::<jmp_buf>();\n499\t            if (*png_ptr).jmp_buf_ptr != core::ptr::addr_of_mut!((*png_ptr).jmp_buf_local) {\n500\t                png_error(png_ptr, c\"Libpng jmp_buf still allocated\".as_ptr());\n501\t            }\n502\t        }\n503\t\n504\t        if size != jmp_buf_size {\n505\t            png_warning(png_