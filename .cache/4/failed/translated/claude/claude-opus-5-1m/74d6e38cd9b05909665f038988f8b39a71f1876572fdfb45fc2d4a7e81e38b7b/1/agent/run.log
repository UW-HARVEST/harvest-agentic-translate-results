 png_set_alpha_mode(pp, PNG_ALPHA_PNG, PNG_DEFAULT_sRGB);\n1261: * png_set_alpha_mode(pp, PNG_ALPHA_PNG, PNG_GAMMA_MAC);\n1264: *    is easier than achieving the same effect with png_set_gamma.  You must use\n1266: *    fire if more than one call to png_set_alpha_mode and png_set_background is\n1272:PNG_EXPORT(36, void, png_set_strip_alpha,\n1349:PNG_FP_EXPORT(47, void, png_set_background,\n1353:PNG_FIXED_EXPORT(215, void, png_set_background_fixed,\n1367:PNG_EXPORT(229, void, png_set_scale_16,\n1374:PNG_EXPORT(48, void, png_set_strip_16,\n1382:PNG_EXPORT(49, void, png_set_quantize,\n1400: * These routines accept the same gamma values as png_set_alpha_mode (described\n1405:PNG_FP_EXPORT(50, void, png_set_gamma,\n1408:PNG_FIXED_EXPORT(208, void, png_set_gamma_fixed,\n1489:PNG_EXPORT(66, void, png_set_crc_action,\n1492:/* Values for png_set_crc_action() say how to handle CRC errors in\n1689:PNG_EXPORT(84, void, png_set_read_user_transform_fn,","is_error":false}]},"parent_tool_use_id":"toolu_bdrk_01Rxg5qSbvzqTJ5Z749YkU1W","session_id":"a9a0a7d5-d080-4cce-a91d-7cd01f6e0204","uuid":"4cd4996c-5908-4288-8b7e-0a55137d44a9","timestamp":"2026-08-22T16:29:04.353Z","subagent_type":"general-purpose","task_description":"Translate pngrtran.c part 1"}
