{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_mx3did53babx2oqyeocycq6igdgfxjyb3wmq56fqkq4zucmytmla","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_017bwo2yZhTJVkMTXsfZfWo9","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-translate-bpUWKO/translated_rust/src/zlib.rs","content":"//! A minimal re-implementation of the subset of the zlib API that libpng uses,\n//! backed by `miniz_oxide` (pure Rust).  The `z_stream` structure only contains\n//! the fields libpng actually touches, plus the standard ones (so that\n//! `png_zalloc` / `png_zfree` and friends keep working).\n\n#![allow(non_camel_case_types)]\n#![allow(non_upper_case_globals)]\n\nuse core::ffi::{c_char, c_int, c_void};\n\nuse miniz_oxide::deflate::core::{\n    create_comp_flags_from_zip_params, CompressorOxide, TDEFLStatus,\n};\nuse miniz_oxide::deflate::stream::deflate as mz_deflate;\nuse miniz_oxide::inflate::stream::{inflate as mz_inflate, InflateState};\nuse miniz_oxide::{DataFormat, MZError, MZFlush, MZStatus};\n\n/* ------------------------------------------------------------- constants */\n\npub const Z_OK: c_int = 0;\npub const Z_STREAM_END: c_int = 1;\npub const Z_NEED_DICT: c_int = 2;\npub const Z_ERRNO: c_int = -1;\npub const Z_STREAM_ERROR: c_int = -2;\npub const Z_DATA_ERROR: c_int = -3;\npub const Z_MEM_ERROR: c_int = -4;\npub const Z_BUF_ERROR: c_int = -5;\npub const Z_VERSION_ERROR: c_int = -6;\n\npub const Z_NO_FLUSH: c_int = 0;\npub const Z_PARTIAL_FLUSH: c_int = 1;\npub const Z_SYNC_FLUSH: c_int = 2;\npub const Z_FULL_FLUSH: c_int = 3;\npub const Z_FINISH: c_int = 4;\npub const Z_BLOCK: c_int = 5;\npub const Z_TREES: c_int = 6;\n\npub const Z_DEFAULT_STRATEGY: c_int = 0;\npub const Z_FILTERED: c_int = 1;\npub const Z_HUFFMAN_ONLY: c_int = 2;\npub const Z_RLE: c_int = 3;\npub const Z_FIXED: c_int = 4;\n\npub const Z_DEFLATED: c_int = 8;\npub const Z_DEFAULT_COMPRESSION: c_int = -1;\n\n/// `ZLIB_IO_MAX` from pngstruct.h: `((uInt)-1)`\npub const ZLIB_IO_MAX: u32 = u32::MAX;\n\npub type z_alloc_func = Option<unsafe extern \"C-unwind\" fn(*mut c_void, u32, u32) -> *mut c_void>;\npub type z_free_func = Option<unsafe extern \"C-unwind\" fn(*mut c_void, *mut c_void)>;\n\n/* --------------------------------------------------------------- z_stream */\n\npub enum ZState {\n    Inflate {\n        st: Box<InflateState>,\n        window_bits: c_int,\n        /// set once the stream has produced Z_STREAM_END\n        ended: bool,\n    },\n    Deflate {\n        st: Box<CompressorOxide>,\n        level: c_int,\n        window_bits: c_int,\n        mem_level: c_int,\n        strategy: c_int,\n        ended: bool,\n    },\n}\n\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct z_stream {\n    pub next_in: *const u8,\n    pub avail_in: u32,\n    pub total_in: u64,\n    pub next_out: *mut u8,\n    pub avail_out: u32,\n    pub total_out: u64,\n    pub msg: *const c_char,\n    pub state: *mut ZState,\n    pub zalloc: z_alloc_func,\n    pub zfree: z_free_func,\n    pub opaque: *mut c_void,\n    pub data_type: c_int,\n    pub adler: u64,\n    pub reserved: u64,\n}\n\nimpl z_stream {\n    pub const fn new() -> z_stream {\n        z_stream {\n            next_in: core::ptr::null(),\n            avail_in: 0,\n            total_in: 0,\n            next_out: core::ptr::null_mut(),\n            avail_out: 0,\n            total_out: 0,\n            msg: core::ptr::null(),\n            state: core::ptr::null_mut(),\n            zalloc: None,\n            zfree: None,\n            opaque: core::ptr::null_mut(),\n            data_type: 0,\n            adler: 0,\n            reserved: 0,\n        }\n    }\n}\n\nimpl Default for z_stream {\n    fn default() -> Self {\n        z_stream::new()\n    }\n}\n\n/* ------------------------------------------------------- status mapping */\n\nfn map_ok(s: MZStatus) -> c_int {\n    match s {\n        MZStatus::Ok => Z_OK,\n        MZStatus::StreamEnd => Z_STREAM_END,\n        MZStatus::NeedDict => Z_NEED_DICT,\n    }\n}\n\nfn map_err(e: MZError) -> c_int {\n    match e {\n        MZError::ErrNo => Z_ERRNO,\n        MZError::Stream => Z_STREAM_ERROR,\n        MZError::Data => Z_DATA_ERROR,\n        MZError::Mem => Z_MEM_ERROR,\n        MZError::Buf => Z_BUF_ERROR,\n        MZError::Version => Z_VERSION_ERROR,\n        MZError::Param => Z_STREAM_ERROR,\n    }\n}\n\nfn data_format_from_window_bits(window_bits: c_int) -> DataFormat {\n    if window_bits < 0 {\n        DataFormat::Raw\n    } else {\n        /* window_bits == 0 means \"take the window size from the zlib header\",\n         * which still implies a zlib wrapper. */\n        DataFormat::Zlib\n    }\n}\n\nfn mz_flush_from(flush: c_int) -> MZFlush {\n    match flush {\n        Z_NO_FLUSH => MZFlush::None,\n        Z_PARTIAL_FLUSH | Z_SYNC_FLUSH => MZFlush::Sync,\n        Z_FULL_FLUSH => MZFlush::Full,\n        Z_FINISH => MZFlush::Finish,\n        _ => MZFlush::None,\n    }\n}\n\n/* ------------------------------------------------------------- inflate */\n\n/// `inflateInit2(strm, windowBits)`\npub unsafe fn inflateInit2(strm: *mut z_stream, window_bits: c_int) -> c_int {\n    if strm.is_null() {\n        return Z_STREAM_ERROR;\n    }\n\n    inflateEnd(strm);\n\n    let st = InflateState::new_boxed(data_format_from_window_bits(window_bits));\n    let state = Box::new(ZState::Inflate {\n        st,\n        window_bits,\n        ended: false,\n    });\n    (*strm).state = Box::into_raw(state);\n    (*strm).msg = core::ptr::null();\n    (*strm).total_in = 0;\n    (*strm).total_out = 0;\n    (*strm).adler = 1;\n    Z_OK\n}\n\npub unsafe fn inflateInit(strm: *mut z_stream) -> c_int {\n    inflateInit2(strm, 15)\n}\n\npub unsafe fn inflateReset2(strm: *mut z_stream, window_bits: c_int) -> c_int {\n    if strm.is_null() || (*strm).state.is_null() {\n        return Z_STREAM_ERROR;\n    }\n\n    match &mut *(*strm).state {\n        ZState::Inflate {\n            st,\n            window_bits: wb,\n            ended,\n        } => {\n            *wb = window_bits;\n            *ended = false;\n            st.reset(data_format_from_window_bits(window_bits));\n            (*strm).msg = core::ptr::null();\n            (*strm).total_in = 0;\n            (*strm).total_out = 0;\n            (*strm).adler = 1;\n            Z_OK\n        }\n        _ => Z_STREAM_ERROR,\n    }\n}\n\npub unsafe fn inflateReset(strm: *mut z_stream) -> c_int {\n    if strm.is_null() || (*strm).state.is_null() {\n        return Z_STREAM_ERROR;\n    }\n    let wb = match &*(*strm).state {\n        ZState::Inflate { window_bits, .. } => *window_bits,\n        _ => return Z_STREAM_ERROR,\n    };\n    inflateReset2(strm, wb)\n}\n\n/// `inflateValidate(strm, check)` -- only ever used to *disable* the ADLER32\n/// check, which is not compiled in for this configuration.  Accepted for\n/// completeness.\npub unsafe fn inflateValidate(strm: *mut z_stream, _check: c_int) -> c_int {\n    if strm.is_null() || (*strm).state.is_null() {\n        return Z_STREAM_ERROR;\n    }\n    match &mut *(*strm).state {\n        ZState::Inflate { st, .. } => {\n            if _check == 0 {\n                st.reset_as(miniz_oxide::inflate::stream::FullReset(\n                    DataFormat::ZLibIgnoreChecksum,\n                ));\n            }\n            Z_OK\n        }\n        _ => Z_STREAM_ERROR,\n    }\n}\n\npub unsafe fn inflateEnd(strm: *mut z_stream) -> c_int {\n    if strm.is_null() {\n        return Z_STREAM_ERROR;\n    }\n    if !(*strm).state.is_null() {\n        drop(Box::from_raw((*strm).state));\n        (*strm).state = core::ptr::null_mut();\n    }\n    Z_OK\n}\n\npub unsafe fn inflate(strm: *mut z_stream, flush: c_int) -> c_int {\n    if strm.is_null() || (*strm).state.is_null() {\n        return Z_STREAM_ERROR;\n    }\n\n    let s = &mut *(*strm).state;\n    let st = match s {\n        ZState::Inflate { st, ended, .. } => {\n            if *ended && flush != Z_FINISH {\n                /* zlib would just return Z_STREAM_END / Z_BUF_ERROR here. */\n                return Z_BUF_ERROR;\n            }\n            st\n        }\n        _ => return Z_STREAM_ERROR,\n    };\n\n    let avail_in = (*strm).avail_in as usize;\n    let avail_out = (*strm).avail_out as usize;\n\n    let input: &[u8] = if (*strm).next_in.is_null() || avail_in == 0 {\n        &[]\n    } else {\n        core::slice::from_raw_parts((*strm).next_in, avail_in)\n    };\n    let output: &mut [u8] = if (*strm).next_out.is_null() || avail_out == 0 {\n        &mut []\n    } else {\n        core::slice::from_raw_parts_mut((*strm).next_out, avail_out)\n    };\n\n    let res = mz_inflate(st, input, output, mz_flush_from(flush));\n\n    (*strm).next_in = (*strm).next_in.add(res.bytes_consumed);\n    (*strm).avail_in -= res.bytes_consumed as u32;\n    (*strm).total_in += res.bytes_consumed as u64;\n    (*strm).next_out = (*strm).next_out.add(res.bytes_written);\n    (*strm).avail_out -= res.bytes_written as u32;\n    (*strm).total_out += res.bytes_written as u64;\n\n    /* Provide the zlib error text for the one case we can identify. */\n    if st.last_status() == miniz_oxide::inflate::TINFLStatus::Adler32Mismatch {\n        (*strm).msg = c\"incorrect data check\".as_ptr();\n    }\n\n    let ret = match res.status {\n        Ok(s) => {\n            if s == MZStatus::StreamEnd {\n                if let ZState::Inflate { ended, .. } = &mut *(*strm).state {\n                    *ended = true;\n                }\n            }\n            map_ok(s)\n        }\n        Err(e) => map_err(e),\n    };\n\n    ret\n}\n\n/* ------------------------------------------------------------- deflate */\n\npub unsafe fn deflateInit2(\n    strm: *mut z_stream,\n    level: c_int,\n    method: c_int,\n    window_bits: c_int,\n    mem_level: c_int,\n    strategy: c_int,\n) -> c_int {\n    if strm.is_null() {\n        return Z_STREAM_ERROR;\n    }\n\n    if method != Z_DEFLATED {\n        return Z_STREAM_ERROR;\n    }\n    if level < -1 || level > 9 {\n        return Z_STREAM_ERROR;\n    }\n    if mem_level < 1 || mem_level > 9 {\n        return Z_STREAM_ERROR;\n    }\n    if strategy < 0 || strategy > Z_FIXED {\n        return Z_STREAM_ERROR;\n    }\n    let wb = if window_bits < 0 {\n        -window_bits\n    } else {\n        window_bits\n    };\n    if wb < 8 || wb > 15 {\n        return Z_STREAM_ERROR;\n    }\n\n    deflateEnd(strm);\n\n    let flags = create_comp_flags_from_zip_params(level, window_bits, strategy);\n    let st = Box::new(CompressorOxide::new(flags));\n    let state = Box::new(ZState::Deflate {\n        st,\n        level,\n        window_bits,\n        mem_level,\n        strategy,\n        ended: false,\n    });\n    (*strm).state = Box::into_raw(state);\n    (*strm).msg = core::ptr::null();\n    (*strm).total_in = 0;\n    (*strm).total_out = 0;\n    (*strm).adler = 1;\n    Z_OK\n}\n\npub unsafe fn deflateReset(strm: *mut z_stream) -> c_int {\n    if strm.is_null() || (*strm).state.is_null() {\n        return Z_STREAM_ERROR;\n    }\n    match &mut *(*strm).state {\n        ZState::Deflate { st, ended, .. } => {\n            st.reset();\n            *ended = false;\n            (*strm).msg = core::ptr::null();\n            (*strm).total_in = 0;\n            (*strm).total_out = 0;\n            (*strm).adler = 1;\n            Z_OK\n        }\n        _ => Z_STREAM_ERROR,\n    }\n}\n\npub unsafe fn deflateEnd(strm: *mut z_stream) -> c_int {\n    if strm.is_null() {\n        return Z_STREAM_ERROR;\n    }\n    if !(*strm).state.is_null() {\n        drop(Box::from_raw((*strm).state));\n        (*strm).state = core::ptr::null_mut();\n    }\n    Z_OK\n}\n\npub unsafe fn deflate(strm: *mut z_stream, flush: c_int) -> c_int {\n    if strm.is_null() || (*strm).state.is_null() {\n        return Z_STREAM_ERROR;\n    }\n\n    let st = match &mut *(*strm).state {\n        ZState::Deflate { st, .. } => st,\n        _ => return Z_STREAM_ERROR,\n    };\n\n    let avail_in = (*strm).avail_in as usize;\n    let avail_out = (*strm).avail_out as usize;\n\n    let input: &[u8] = if (*strm).next_in.is_null() || avail_in == 0 {\n        &[]\n    } else {\n        core::slice::from_raw_parts((*strm).next_in, avail_in)\n    };\n    let output: &mut [u8] = if (*strm).next_out.is_null() || avail_out == 0 {\n        &mut []\n    } else {\n        core::slice::from_raw_parts_mut((*strm).next_out, avail_out)\n    };\n\n    if output.is_empty() {\n        /* zlib returns Z_BUF_ERROR when there is no output space (and no\n         * progress can be made). */\n        if st.prev_return_status() == TDEFLStatus::Done {\n            return if flush == Z_FINISH { Z_STREAM_END } else { Z_BUF_ERROR };\n        }\n        return Z_BUF_ERROR;\n    }\n\n    let res = mz_deflate(st, input, output, mz_flush_from(flush));\n\n    (*strm).next_in = (*strm).next_in.add(res.bytes_consumed);\n    (*strm).avail_in -= res.bytes_consumed as u32;\n    (*strm).total_in += res.bytes_consumed as u64;\n    (*strm).next_out = (*strm).next_out.add(res.bytes_written);\n    (*strm).avail_out -= res.bytes_written as u32;\n    (*strm).total_out += res.bytes_written as u64;\n\n    match res.status {\n        Ok(s) => map_ok(s),\n        Err(e) => map_err(e),\n    }\n}\n\n/* ---------------------------------------------------------------- crc32 */\n\nstatic mut CRC_TABLE: [u32; 256] = [0; 256];\nstatic CRC_INIT: core::sync::atomic::AtomicBool = core::sync::atomic::AtomicBool::new(false);\n\nfn crc_table() -> &'static [u32; 256] {\n    unsafe {\n        if !CRC_INIT.load(core::sync::atomic::Ordering::Acquire) {\n            let mut n = 0usize;\n            while n < 256 {\n                let mut c = n as u32;\n                let mut k = 0;\n                while k < 8 {\n                    if c & 1 != 0 {\n                        c = 0xedb8_8320 ^ (c >> 1);\n                    } else {\n                        c >>= 1;\n                    }\n                   