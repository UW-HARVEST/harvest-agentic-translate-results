{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01D1yzorydwADbFsBM95Rshf","type":"tool_result","content":"1\t// pngrutil_p1.rs -- part 1 of the translation of c_src/src/pngrutil.c (lines 1..900)\n2\t//\n3\t// Covers LZ77Min, the interlace tables, png_get_uint_31 .. png_inflate_read.\n4\t\n5\t/* The minimum 'zlib' stream is assumed to be just the 2 byte header, 5 bytes\n6\t * minimum 'deflate' stream, and the 4 byte checksum.\n7\t */\n8\tconst LZ77Min: png_uint_32 = 2u32 + 5u32 + 4u32;\n9\t\n10\t/* READ_INTERLACING */\n11\t/* Arrays to facilitate interlacing - use pass (0 - 6) as index. */\n12\t\n13\t/* Start of interlace block */\n14\tstatic png_pass_start: [png_byte; 7] = [0, 4, 0, 2, 0, 1, 0];\n15\t/* Offset to next interlace block */\n16\tstatic png_pass_inc: [png_byte; 7] = [8, 8, 4, 4, 2, 2, 1];\n17\t/* Start of interlace block in the y direction */\n18\tstatic png_pass_ystart: [png_byte; 7] = [0, 0, 4, 0, 2, 0, 1];\n19\t/* Offset to next interlace block in the y direction */\n20\tstatic png_pass_yinc: [png_byte; 7] = [8, 8, 8, 4, 4, 2, 2];\n21\t\n22\t/* TODO: Move these arrays to a common utility module to avoid duplication. */\n23\t\n24\t#[unsafe(no_mangle)]\n25\tpub unsafe extern \"C-unwind\" fn png_get_uint_31(\n26\t    png_ptr: png_const_structrp,\n27\t    buf: png_const_bytep,\n28\t) -> png_uint_32 {\n29\t    let uval: png_uint_32 = PNG_get_uint_32(buf);\n30\t\n31\t    if uval > PNG_UINT_31_MAX {\n32\t        png_error(png_ptr, c\"PNG unsigned integer out of range\".as_ptr());\n33\t    }\n34\t\n35\t    uval\n36\t}\n37\t\n38\t/* READ_INT_FUNCTIONS */\n39\t/* NOTE: the read macros will obscure these definitions, so that if\n40\t * PNG_USE_READ_MACROS is set the library will not use them internally,\n41\t * but the APIs will still be available externally.\n42\t *\n43\t * The parentheses around \"PNGAPI function_name\" in the following three\n44\t * functions are necessary because they allow the macros to co-exist with\n45\t * these (unused but exported) functions.\n46\t */\n47\t\n48\t/* Grab an unsigned 32-bit integer from a buffer in big-endian format. */\n49\t#[unsafe(no_mangle)]\n50\tpub unsafe extern \"C-unwind\" fn png_get_uint_32(buf: png_const_bytep) -> png_uint_32 {\n51\t    let uval: png_uint_32 = (((*buf) as png_uint_32) << 24)\n52\t        .wrapping_add(((*buf.add(1)) as png_uint_32) << 16)\n53\t        .wrapping_add(((*buf.add(2)) as png_uint_32) << 8)\n54\t        .wrapping_add((*buf.add(3)) as png_uint_32);\n55\t\n56\t    uval\n57\t}\n58\t\n59\t/* Grab a signed 32-bit integer from a buffer in big-endian format.  The\n60\t * data is stored in the PNG file in two's complement format and there\n61\t * is no guarantee that a 'png_int_32' is exactly 32 bits, therefore\n62\t * the following code does a two's complement to native conversion.\n63\t */\n64\t#[unsafe(no_mangle)]\n65\tpub unsafe extern \"C-unwind\" fn png_get_int_32(buf: png_const_bytep) -> png_int_32 {\n66\t    let mut uval: png_uint_32 = PNG_get_uint_32(buf);\n67\t    if (uval & 0x80000000u32) == 0\n68\t    /* non-negative */\n69\t    {\n70\t        return uval as png_int_32;\n71\t    }\n72\t\n73\t    uval = (uval ^ 0xffffffffu32).wrapping_add(1); /* 2's complement: -x = ~x+1 */\n74\t    if (uval & 0x80000000u32) == 0\n75\t    /* no overflow */\n76\t    {\n77\t        return (uval as png_int_32).wrapping_neg();\n78\t    }\n79\t    /* The following has to be safe; this function only gets called on PNG data\n80\t     * and if we get here that data is invalid.  0 is the most safe value and\n81\t     * if not then an attacker would surely just generate a PNG with 0 instead.\n82\t     */\n83\t    0\n84\t}\n85\t\n86\t/* Grab an unsigned 16-bit integer from a buffer in big-endian format. */\n87\t#[unsafe(no_mangle)]\n88\tpub unsafe extern \"C-unwind\" fn png_get_uint_16(buf: png_const_bytep) -> png_uint_16 {\n89\t    /* ANSI-C requires an int value to accommodate at least 16 bits so this\n90\t     * works and allows the comp