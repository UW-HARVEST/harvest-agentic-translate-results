g_ptr).malloc_fn {\n55\t            return f(png_ptr, size);\n56\t        }\n57\t    }\n58\t\n59\t    /* Use the system malloc */\n60\t    libc::malloc(size)\n61\t}\n62\t\n63\tunsafe fn png_malloc_array_checked(\n64\t    png_ptr: png_const_structrp,\n65\t    nelements: c_int,\n66\t    element_size: usize,\n67\t) -> png_voidp {\n68\t    let req = nelements as png_alloc_size_t; /* known to be > 0 */\n69\t\n70\t    if req <= PNG_SIZE_MAX / element_size {\n71\t        return png_malloc_base(png_ptr, req * element_size);\n72\t    }\n73\t\n74\t    /* The failure case when the request is too large */\n75\t    core::ptr::null_mut()\n76\t}\n77\t\n78\t#[unsafe(no_mangle)]\n79\tpub unsafe extern \"C-unwind\" fn png_malloc_array(\n80\t    png_ptr: png_const_structrp,\n81\t    nelements: c_int,\n82\t    element_size: usize,\n83\t) -> png_voidp {\n84\t    if nelements <= 0 || element_size == 0 {\n85\t        png_error(png_ptr, c\"internal error: array alloc\".as_ptr());\n86\t    }\n87\t\n88\t    png_malloc_array_checked(png_ptr, nelements, element_size)\n89\t}\n90\t\n91\t#[unsafe(no_mangle)]\n92\tpub unsafe extern \"C-unwind\" fn png_realloc_array(\n93\t    png_ptr: png_const_structrp,\n94\t    old_array: png_const_voidp,\n95\t    old_elements: c_int,\n96\t    add_elements: c_int,\n97\t    element_size: usize,\n98\t) -> png_voidp {\n99\t    /* These are internal errors: */\n100\t    if add_elements <= 0\n101\t        || element_size == 0\n102\t        || old_elements < 0\n103\t        || (old_array.is_null() && old_elements > 0)\n104\t    {\n105\t        png_error(png_ptr, c\"internal error: array realloc\".as_ptr());\n106\t    }\n107\t\n108\t    /* Check for overflow on the elements count (so the caller does not have to\n109\t     * check.)\n110\t     */\n111\t    if add_elements <= c_int::MAX - old_elements {\n112\t        let new_array =\n113\t            png_malloc_array_checked(png_ptr, old_elements + add_elements, element_size);\n114\t\n115\t        if !new_array.is_null() {\n116\t            if old_elements > 0 {\n117\t                memcpy(\n118\t                    new_array as *mut u8,\n119\t                    old_array as *const u8,\n120\t                    element_size * (old_elements as u32 as usize),\n121\t                );\n122\t            }\n123\t\n124\t            memset(\n125\t                (new_array as *mut u8).add(element_size * (old_elements as u32 as usize)),\n126\t                0,\n127\t                element_size * (add_elements as u32 as usize),\n128\t            );\n129\t\n130\t            return new_array;\n131\t        }\n132\t    }\n133\t\n134\t    core::ptr::null_mut() /* error */\n135\t}\n136\t\n137\t#[unsafe(no_mangle)]\n138\tpub unsafe extern \"C-unwind\" fn png_malloc(\n139\t    png_ptr: png_const_structrp,\n140\t    size: png_alloc_size_t,\n141\t) -> png_voidp {\n142\t    if png_ptr.is_null() {\n143\t        return core::ptr::null_mut();\n144\t    }\n145\t\n146\t    let ret = png_malloc_base(png_ptr, size);\n147\t\n148\t    if ret.is_null() {\n149\t        png_error(png_ptr, c\"Out of memory\".as_ptr());\n150\t    }\n151\t\n152\t    ret\n153\t}\n154\t\n155\t#[unsafe(no_mangle)]\n156\tpub unsafe extern \"C-unwind\" fn png_malloc_default(\n157\t    png_ptr: png_const_structrp,\n158\t    size: png_alloc_size_t,\n159\t) -> png_voidp {\n160\t    if png_ptr.is_null() {\n161\t        return core::ptr::null_mut();\n162\t    }\n163\t\n164\t    /* Passing 'NULL' here bypasses the application provided memory handler. */\n165\t    let ret = png_malloc_base(core::ptr::null_mut(), size);\n166\t\n167\t    if ret.is_null() {\n168\t        png_error(png_ptr, c\"Out of Memory\".as_ptr());\n169\t    }\n170\t\n171\t    ret\n172\t}\n173\t\n174\t#[unsafe(no_mangle)]\n175\tpub unsafe extern \"C-unwind\" fn png_malloc_warn(\n176\t    png_ptr: png_const_structrp,\n177\t    size: png_alloc_size_t,\n178\t) -> png_voidp {\n179\t    if !png_ptr.is_null() {\n180\t        let ret = png_malloc_base(png_ptr, size);\n181\t\n182\t        if !ret.is_null() {\n183\t            return ret;\n184\t        }\n185\t\n186\t        png_warning(png_ptr, c\"Out of memory\".as_ptr());\n187\t    }\n188\t\n189\t    core::ptr::null_mut()\n190\t}\n191\t\n192\t#[unsafe(no_mangle)]\n193\tpub unsafe extern \"C-unwind\" fn png_free(png_ptr: png_const_structrp, ptr: png_voidp) {\n194\t    if png_ptr.is_null() || ptr.is_null() {\n195\t        return;\n196\t    }\n197\t\n198\t    if let Some(f) = (*png_ptr).free_fn {\n199\t        f(png_ptr, ptr);\n200\t    } else {\n201\t        png_free_default(png_ptr, ptr);\n202\t    }\n203\t}\n204\t\n205\t#[unsafe(no_mangle)]\n206\tpub unsafe extern \"C-unwind\" fn png_free_default(png_ptr: png_const_structrp, ptr: png_voidp) {\n207\t    if png_ptr.is_null() || ptr.is_null() {\n208\t        return;\n209\t    }\n210\t\n211\t    libc::free(ptr as *mut c_void);\n212\t}\n213\t\n214\t#[unsafe(no_mangle)]\n215\tpub unsafe extern \"C-unwind\" fn png_set_mem_fn(\n216\t    png_ptr: png_structrp,\n217\t    mem_ptr: png_voidp,\n218\t    malloc_fn: png_malloc_ptr,\n219\t    free_fn: png_free_ptr,\n220\t) {\n221\t    if !png_ptr.is_null() {\n222\t        (*png_ptr).mem_ptr = mem_ptr;\n223\t        (*png_ptr).malloc_fn = malloc_fn;\n224\t        (*png_ptr).free_fn = free_fn;\n225\t    }\n226\t}\n227\t\n228\t#[unsafe(no_mangle)]\n229\tpub unsafe extern \"C-unwind\" fn png_get_mem_ptr(png_ptr: png_const_structrp) -> png_voidp {\n230\t    if png_ptr.is_null() {\n231\t        return core::ptr::null_mut();\n232\t    }\n233\t\n234\t    (*png_ptr).mem_ptr\n235\t}\n236\t"}]},"parent_tool_use_id":"toolu_bdrk_017ma11b4EEt7GdB6GfFcrCk","session_id":"a9a0a7d5-d080-4cce-a91d-7cd01f6e0204","uuid":"c3e1b94d-f4ee-4184-b396-c028a4167b09","timestamp":"2026-08-22T13:59:02.615Z","subagent_type":"general-purpose","task_description":"Translate pngtrans.c"}
