}\n48\t\n49\t            (*png_ptr).channels = 3;\n50\t        }\n51\t\n52\t        PNG_COLOR_TYPE_PALETTE => {\n53\t            match bit_depth {\n54\t                1 | 2 | 4 | 8 => {\n55\t                    (*png_ptr).channels = 1;\n56\t                }\n57\t\n58\t                _ => {\n59\t                    png_error(png_ptr, c\"Invalid bit depth for paletted image\".as_ptr());\n60\t                }\n61\t            }\n62\t        }\n63\t\n64\t        PNG_COLOR_TYPE_GRAY_ALPHA => {\n65\t            is_invalid_depth = (bit_depth != 8) as c_int;\n66\t            /* WRITE_16BIT */\n67\t            is_invalid_depth = (is_invalid_depth != 0 && bit_depth != 16) as c_int;\n68\t            if is_invalid_depth != 0 {\n69\t                png_error(\n70\t                    png_ptr,\n71\t                    c\"Invalid bit depth for grayscale+alpha image\".as_ptr(),\n72\t                );\n73\t            }\n74\t\n75\t            (*png_ptr).channels = 2;\n76\t        }\n77\t\n78\t        PNG_COLOR_TYPE_RGB_ALPHA => {\n79\t            is_invalid_depth = (bit_depth != 8) as c_int;\n80\t            /* WRITE_16BIT */\n81\t            is_invalid_depth = (is_invalid_depth != 0 && bit_depth != 16) as c_int;\n82\t            if is_invalid_depth != 0 {\n83\t                png_error(png_ptr, c\"Invalid bit depth for RGBA image\".as_ptr());\n84\t            }\n85\t\n86\t            (*png_ptr).channels = 4;\n87\t        }\n88\t\n89\t        _ => {\n90\t            png_error(png_ptr, c\"Invalid image color type specified\".as_ptr());\n91\t        }\n92\t    }\n93\t\n94\t    if compression_type != PNG_COMPRESSION_TYPE_BASE {\n95\t        png_warning(png_ptr, c\"Invalid compression type specified\".as_ptr());\n96\t        compression_type = PNG_COMPRESSION_TYPE_BASE;\n97\t    }\n98\t\n99\t    /* Write filter_method 64 (intrapixel differencing) only if\n100\t     * 1. Libpng was compiled with PNG_MNG_FEATURES_SUPPORTED and\n101\t     * 2. Libpng did not write a PNG signature (thi