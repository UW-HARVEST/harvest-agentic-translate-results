rror code is apparently a success code.\n1057\t */\n1058\t#[unsafe(no_mangle)]\n1059\tpub unsafe extern \"C-unwind\" fn png_zstream_error(png_ptr: png_structrp, ret: c_int) {\n1060\t    /* Translate 'ret' into an appropriate error string, priority is given to the\n1061\t     * one in zstream if set.  This always returns a string, even in cases like\n1062\t     * Z_OK or Z_STREAM_END where the error code is a success code.\n1063\t     */\n1064\t    if (*png_ptr).zstream.msg.is_null() {\n1065\t        match ret {\n1066\t            Z_STREAM_END => {\n1067\t                /* Normal exit */\n1068\t                (*png_ptr).zstream.msg = c\"unexpected end of LZ stream\".as_ptr();\n1069\t            }\n1070\t\n1071\t            Z_NEED_DICT => {\n1072\t                /* This means the deflate stream did not have a dictionary; this\n1073\t                 * indicates a bogus PNG.\n1074\t                 */\n1075\t                (*png_ptr).zstream.msg = c\"missing LZ dictionary\".as_ptr();\n1076\t            }\n1077\t\n1078\t            Z_ERRNO => {\n1079\t                /* gz APIs only: should not happen */\n1080\t                (*png_ptr).zstream.msg = c\"zlib IO error\".as_ptr();\n1081\t            }\n1082\t\n1083\t            Z_STREAM_ERROR => {\n1084\t                /* internal libpng error */\n1085\t                (*png_ptr).zstream.msg = c\"bad parameters to zlib\".as_ptr();\n1086\t            }\n1087\t\n1088\t            Z_DATA_ERROR => {\n1089\t                (*png_ptr).zstream.msg = c\"damaged LZ stream\".as_ptr();\n1090\t            }\n1091\t\n1092\t            Z_MEM_ERROR => {\n1093\t                (*png_ptr).zstream.msg = c\"insufficient memory\".as_ptr();\n1094\t            }\n1095\t\n1096\t            Z_BUF_ERROR => {\n1097\t                /* End of input or output; not a problem if the caller is doing\n1098\t                 * incremental read or write.\n1099\t                 */\n1100\t                (*png_ptr).zstream.msg = c\"truncated\".as_ptr