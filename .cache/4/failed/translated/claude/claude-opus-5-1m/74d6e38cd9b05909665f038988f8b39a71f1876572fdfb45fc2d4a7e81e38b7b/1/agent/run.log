        pos = png_safecat(\n            out,\n            29,\n            pos,\n            short_months[((*ptime).month - 1) as usize].as_ptr() as png_const_charp,\n        );\n\n        /* APPEND(' '); */\n        if pos < 28 {\n            *out.add(pos) = b' ' as c_char;\n            pos += 1;\n        }\n\n        /* APPEND_NUMBER(PNG_NUMBER_FORMAT_u, ptime->year); */\n        pos = png_safecat(\n            out,\n            29,\n            pos,\n            png_format_number(\n                number_buf.as_ptr(),\n                number_buf.as_mut_ptr().add(5),\n                PNG_NUMBER_FORMAT_u,\n                (*ptime).year as png_alloc_size_t,\n            ),\n        );\n\n        /* APPEND(' '); */\n        if pos < 28 {\n            *out.add(pos) = b' ' as c_char;\n            pos += 1;\n        }\n\n        /* APPEND_NUMBER(PNG_NUMBER_FORMAT_02u, (unsigned)ptime->hour); */\n        pos = png_safecat(\n            out,\n            29,\n            pos,\n            png_format_number(\n                number_buf.as_ptr(),\n                number_buf.as_mut_ptr().add(5),\n                PNG_NUMBER_FORMAT_02u,\n                (*ptime).hour as c_uint as png_alloc_size_t,\n            ),\n        );\n\n        /* APPEND(':'); */\n        if pos < 28 {\n            *out.add(pos) = b':' as c_char;\n            pos += 1;\n        }\n\n        /* APPEND_NUMBER(PNG_NUMBER_FORMAT_02u, (unsigned)ptime->minute); */\n        pos = png_safecat(\n            out,\n            29,\n            pos,\n            png_format_number(\n                number_buf.as_ptr(),\n                number_buf.as_mut_ptr().add(5),\n                PNG_NUMBER_FORMAT_02u,\n                (*ptime).minute as c_uint as png_alloc_size_t,\n            ),\n        );\n\n        /* APPEND(':'); */\n        if pos < 28 {\n            *out.add(pos) = b':' as c_char;\n            pos += 1;\n        }\n\n        /* APPEND_NUMBER(PNG_NUMBER_FORMAT_02u, (unsigned)ptime->second); */\n        p