ization.\n323\t             */\n324\t            /* WRITE_OPTIMIZE_CMF */\n325\t            if ((*png_ptr).mode & PNG_HAVE_IDAT) == 0\n326\t                && (*png_ptr).compression_type as c_int == PNG_COMPRESSION_TYPE_BASE\n327\t            {\n328\t                optimize_cmf(data, png_image_size(png_ptr));\n329\t            }\n330\t\n331\t            if size > 0 {\n332\t                png_write_complete_chunk(png_ptr, png_IDAT, data, size as usize);\n333\t            }\n334\t            (*png_ptr).mode |= PNG_HAVE_IDAT;\n335\t\n336\t            (*png_ptr).zstream.next_out = data;\n337\t            (*png_ptr).zstream.avail_out = size;\n338\t\n339\t            /* For SYNC_FLUSH or FINISH it is essential to keep calling zlib with\n340\t             * the same flush parameter until it has finished output, for NO_FLUSH\n341\t             * it doesn't matter.\n342\t             */\n343\t            if ret == Z_OK && flush != Z_NO_FLUSH {\n344\t                continue;\n345\t            }\n346\t        }\n347\t\n348\t        /* The order of these checks doesn't matter much; it just affects which\n349\t         * possible error might be detected if multiple things go wrong at once.\n350\t         */\n351\t        if ret == Z_OK\n352\t        /* most likely return code! */\n353\t        {\n354\t            /* If all the input has been consumed then just return.  If Z_FINISH\n355\t             * was used as the flush parameter something has gone wrong if we get\n356\t             * here.\n357\t             */\n358\t            if input_len == 0 {\n359\t                if flush == Z_FINISH {\n360\t                    png_error(png_ptr, c\"Z_OK on Z_FINISH with output space\".as_ptr());\n361\t                }\n362\t\n363\t                return;\n364\t            }\n365\t        } else if ret == Z_STREAM_END && flush == Z_FINISH {\n366\t            /* This is the end of the IDAT data; any pending output must be\n367\t             * flushed.  For small PNG files we may still be at the beginning.\n368\t             */\n369\t            let data: png_bytep = (*(*png_ptr).zbuffer_list).output.as_mut_ptr();\n370\t            let size: u32 = (*png_ptr)\n371\t                .zbuffer_size\n372\t                .wrapping_sub((*png_ptr).zstream.avail_out);\n373\t\n374\t            /* WRITE_OPTIMIZE_CMF */\n375\t            if ((*png_ptr).mode & PNG_HAVE_IDAT) == 0\n376\t                && (*png_ptr).compression_type as c_int == PNG_COMPRESSION_TYPE_BASE\n377\t            {\n378\t                optimize_cmf(data, png_image_size(png_ptr));\n379\t            }\n380\t\n381\t            if size > 0 {\n382\t                png_write_complete_chunk(png_ptr, png_IDAT, data, size as usize);\n383\t            }\n384\t            (*png_ptr).zstream.avail_out = 0;\n385\t            (*png_ptr).zstream.next_out = core::ptr::null_mut();\n386\t            (*png_ptr).mode |= PNG_HAVE_IDAT | PNG_AFTER_IDAT;\n387\t\n388\t            (*png_ptr).zowner = 0; /* Release the stream */\n389\t            return;\n390\t        } else {\n391\t            /* This is an error condition. */\n392\t            png_zstream_error(png_ptr, ret);\n393\t            png_error(png_ptr, (*png_ptr).zstream.msg);\n394\t        }\n395\t    }\n396\t}\n397\t\n398\t/* Write an IEND chunk */\n399\t#[unsafe(no_mangle)]\n400\tpub unsafe extern \"C-unwind\" fn png_write_IEND(png_ptr: png_structrp) {\n401\t    png_write_complete_chunk(png_ptr, png_IEND, core::ptr::null(), 0);\n402\t    (*png_ptr).mode |= PNG_HAVE_IEND;\n403\t}\n404\t\n405\t/* WRITE_gAMA */\n406\t/* Write a gAMA chunk */\n407\t#[unsafe(no_mangle)]\n408\tpub unsafe extern \"C-unwind\" fn png_write_gAMA_fixed(\n409\t    png_ptr: png_structrp,\n410\t    file_gamma: png_fixed_point,\n411\t) {\n412\t    let mut buf: [png_byte; 4] = [0; 4];\n413\t\n414\t    /* file_gamma is saved in 1/100,000ths */\n415\t    png_save_uint_32(buf.as_mut_ptr(), file_gamma as png_uint_32);\n416\t    png_write_complete_chunk(png_ptr, png_gAMA, buf.as_ptr(), 4);\n417\t}\n418\t/* WRITE_gAMA */\n419\t\n420\t/* WRITE_sRGB */\n421\t/* Write a sRGB chunk */\n422\t#[unsafe(no_mangle)]\n423\tpub unsafe extern \"C-unwind\" fn png_write_sRGB(png_ptr: png_structrp, srgb_intent: c_int) {\n424\t    let mut buf: [png_byte; 1] = [0; 1];\n425\t\n426\t    if srgb_intent >= PNG_sRGB_INTENT_LAST {\n427\t        png_warning(png_ptr, c\"Invalid sRGB rendering intent specified\".as_ptr());\n428\t    }\n429\t\n430\t    buf[0] = srgb_intent as png_byte;\n431\t    png_write_complete_chunk(png_ptr, png_sRGB, buf.as_ptr(), 1);\n432\t}\n433\t/* WRITE_sRGB */\n434\t\n435\t/* WRITE_iCCP */\n436\t/* Write an iCCP chunk */\n437\t#[unsafe(no_mangle)]\n438\tpub unsafe extern \"C-unwind\" fn png_write_iCCP(\n439\t    png_ptr: png_structrp,\n440\t    name: png_const_charp,\n441\t    profile: png_const_bytep,\n442\t    profile_len: png_uint_32,\n443\t) {\n444\t    let mut name_len: png_uint_32;\n445\t    let mut new_name: [png_byte; 81] = [0; 81]; /* 1 byte for the compression byte */\n446\t    let mut comp: compression_state = core::mem::zeroed();\n447\t    let temp: png_uint_32;\n448\t\n449\t    /* These are all internal problems: the profile should have been checked\n450\t     * before when it was stored.\n451\t     */\n452\t    if profile.is_null() {\n453\t        png_error(png_ptr, c\"No profile for iCCP chunk\".as_ptr()); /* internal error */\n454\t    }\n455\t\n456\t    if profile_len < 132 {\n457\t        png_error(png_ptr, c\"ICC profile too short\".as_ptr());\n458\t    }\n459\t\n460\t    if PNG_get_uint_32(profile) != profile_len {\n461\t        png_error(png_ptr, c\"Incorrect data in iCCP\".as_ptr());\n462\t    }\n463\t\n464\t    temp = *profile.add(8) as png_uint_32;\n465\t    if temp > 3 && (profile_len & 0x03) != 0 {\n466\t        png_error(\n467\t            png_ptr,\n468\t            c\"ICC profile length invalid (not a multiple of 4)\".as_ptr(),\n469\t        );\n470\t    }\n471\t\n472\t    {\n473\t        let embedded_profile_len: png_uint_32 = PNG_get_uint_32(profile);\n474\t\n475\t        if profile_len != embedded_profile_len {\n476\t            png_error(png_ptr, c\"Profile length does not match profile\".as_ptr());\n477\t        }\n478\t    }\n479\t\n480\t    name_len = png_check_keyword(png_ptr, name, new_name.as_mut_ptr());\n481\t\n482\t    if name_len == 0 {\n483\t        png_error(png_ptr, c\"iCCP: invalid keyword\".as_ptr());\n484\t    }\n485\t\n486\t    name_len = name_len.wrapping_add(1);\n487\t    new_name[name_len as usize] = PNG_COMPRESSION_TYPE_BASE as png_byte;\n488\t\n489\t    /* Make sure we include the NULL after the name and the compression type */\n490\t    name_len = name_len.wrapping_add(1);\n491\t\n492\t    png_text_compress_init(&mut comp, profile, profile_len as png_alloc_size_t);\n493\t\n494\t    /* Allow for keyword terminator and compression byte */\n495\t    if png_text_compress(png_ptr, png_iCCP, &mut comp, name_len) != Z_OK {\n496\t        png_error(png_ptr, (*png_ptr).zstream.msg);\n497\t    }\n498\t\n499\t    png_write_chunk_header(png_ptr, png_iCCP, name_len.wrapping_add(comp.output_len));\n500\t\n501\t    png_write_chunk_data(png_ptr, new_name.as_ptr(), name_len as usize);\n502\t\n503\t    png_write_compressed_data_out(png_ptr, &mut comp);\n504\t\n505\t    png_write_chunk_end(png_ptr);\n506\t}\n507\t/* WRITE_iCCP */\n508\t\n509\t/* WRITE_sPLT */\n510\t/* Write a sPLT chunk */\n511\t#[unsafe(no_mangle)]\n512\tpub unsafe extern \"C-unwind\" fn png_write_sPLT(png_ptr: png_structrp, spalette: png_const_sPLT_tp) {\n513\t    let name_len: png_uint_32;\n514\t    let mut new_name: [png_byte; 80] = [0; 80];\n515\t    let mut entrybuf: [png_byte; 10] = [0; 10];\n516\t    let entry_size: usize = if (*spalette).depth as c_int == 8 { 6 } else { 10 };\n517\t    let palette_size: usize = entry_size.wrapping_mul((*spalette).nentries as usize);\n518\t    let mut ep: png_sPLT_entryp;\n519\t\n520\t    name_len = png_check_keyword(png_ptr, (*spalette).name, new_name.as_mut_ptr());\n521\t\n522\t    if name_len == 0 {\n523\t        png_error(png_ptr, c\"sPLT: invalid keyword\".as_ptr());\n524\t    }\n525\t\n526\t    /* Make sure we include the NULL after the name */\n527\t    png_write_chunk_header(\n528\t        png_ptr,\n529\t        png_sPLT,\n530\t        (name_len as usize)\n531\t            .wrapping_add(2)\n532\t            .wrapping_add(palette_size) as png_uint_32,\n533\t    );\n534\t\n535\t    png_write_chunk_data(\n536\t        png_ptr,\n537\t        new_name.as_ptr(),\n538\t        name_len.wrapping_add(1) as usize,\n539\t    );\n540\t\n541\t    png_write_chunk_data(png_ptr, core::ptr::addr_of!((*spalette).depth), 1);\n542\t\n543\t    /* Loop through each palette entry, writing appropriately */\n544\t    ep = (*spalette).entries;\n545\t    while ep < (*spalette).entries.offset((*spalette).nentries as isize) {\n546\t        if (*spalette).depth as c_int == 8 {\n547\t            entrybuf[0] = (*ep).red as png_byte;\n548\t            entrybuf[1] = (*ep).green as png_byte;\n549\t            entrybuf[2] = (*ep).blue as png_byte;\n550\t            entrybuf[3] = (*ep).alpha as png_byte;\n551\t            png_save_uint_16(entrybuf.as_mut_ptr().add(4), (*ep).frequency as c_uint);\n552\t        } else {\n553\t            png_save_uint_16(entrybuf.as_mut_ptr().add(0), (*ep).red as c_uint);\n554\t            png_save_uint_16(entrybuf.as_mut_ptr().add(2), (*ep).green as c_uint);\n555\t            png_save_uint_16(entrybuf.as_mut_ptr().add(4), (*ep).blue as c_uint);\n556\t            png_save_uint_16(entrybuf.as_mut_ptr().add(6), (*ep).alpha as c_uint);\n557\t            png_save_uint_16(entrybuf.as_mut_ptr().add(8), (*ep).frequency as c_uint);\n558\t        }\n559\t\n560\t        png_write_chunk_data(png_ptr, entrybuf.as_ptr(), entry_size);\n561\t\n562\t        ep = ep.add(1);\n563\t    }\n564\t\n565\t    png_write_chunk_end(png_ptr);\n566\t}\n567\t/* WRITE_sPLT */\n568\t\n569\t/* WRITE_sBIT */\n570\t/* Write the sBIT chunk */\n571\t#[unsafe(no_mangle)]\n572\tpub unsafe extern \"C-unwind\" fn png_write_sBIT(\n573\t    png_ptr: png_structrp,\n574\t    sbit: png_const_color_8p,\n575\t    color_type: c_int,\n576\t) {\n577\t    let mut buf: [png_byte; 4] = [0; 4];\n578\t    let mut size: usize;\n579\t\n580\t    /* Make sure we don't depend upon the order of PNG_COLOR_8 */\n581\t    if (color_type & PNG_COLOR_MASK_COLOR) != 0 {\n582\t        let maxbits: png_byte;\n583\t\n584\t        maxbits = (if color_type == PNG_COLOR_TYPE_PALETTE {\n585\t            8\n586\t        } else {\n587\t            (*png_ptr).usr_bit_depth as c_int\n588\t        }) as png_byte;\n589\t\n590\t        if (*sbit).red == 0\n591\t            || (*sbit).red > maxbits\n592\t            || (*sbit).green == 0\n593\t            || (*sbit).green > maxbits\n594\t            || (*sbit).blue == 0\n595\t            || (*sbit).blue > maxbits\n596\t        {\n597\t            png_warning(png_ptr, c\"Invalid sBIT depth specified\".as_ptr());\n598\t            return;\n599\t        }\n600\t\n601\t        buf[0] = (*sbit).red;\n602\t        buf[1] = (*sbit).green;\n603\t        buf[2] = (*sbit).blue;\n604\t        size = 3;\n605\t    } else {\n606\t        if (*sbit).gray == 0 || (*sbit).gray > (*png_ptr).usr_bit_depth {\n607\t            png_warning(png_ptr, c\"Invalid sBIT depth specified\".as_ptr());\n608\t            return;\n609\t        }\n610\t\n611\t        buf[0] = (*sbit).gray;\n612\t        size = 1;\n613\t    }\n614\t\n615\t    if (color_type & PNG_COLOR_MASK_ALPHA) != 0 {\n616\t        if (*sbit).alpha == 0 || (*sbit).alpha > (*png_ptr).usr_bit_depth {\n617\t            png_warning(png_ptr, c\"Invalid sBIT depth specified\".as_ptr());\n618\t            return;\n619\t        }\n620\t\n621\t        buf[size] = (*sbit).alpha;\n622\t        size = size.wrapping_add(1);\n623\t    }\n624\t\n625\t    png_write_complete_chunk(png_ptr, png_sBIT, buf.as_ptr(), size);\n626\t}\n627\t/* WRITE_sBIT */\n628\t\n629\t/* WRITE_cHRM */\n630\t/* Write the cHRM chunk */\n631\t#[unsafe(no_mangle)]\n632\tpub unsafe extern \"C-unwind\" fn png_write_cHRM_fixed(png_ptr: png_structrp, xy: *const png_xy) {\n633\t    let mut buf: [png_byte; 32] = [0; 32];\n634\t\n635\t    /* Each value is saved in 1/100,000ths */\n636\t    png_save_int_32(buf.as_mut_ptr(), (*xy).whitex);\n637\t    png_save_int_32(buf.as_mut_ptr().add(4), (*xy).whitey);\n638\t\n639\t    png_save_int_32(buf.as_mut_ptr().add(8), (*xy).redx);\n640\t    png_save_int_32(buf.as_mut_ptr().add(12), (*xy).redy);\n641\t\n642\t    png_save_int_32(buf.as_mut_ptr().add(16), (*xy).greenx);\n643\t    png_save_int_32(buf.as_mut_ptr().add(20), (*xy).greeny);\n644\t\n645\t    png_save_int_32(buf.as_mut_ptr().add(24), (*xy).bluex);\n646\t    png_save_int_32(buf.as_mut_ptr().add(28), (*xy).bluey);\n647\t\n648\t    png_write_complete_chunk(png_ptr, png_cHRM, buf.as_ptr(), 32);\n649\t}\n650\t/* WRITE_cHRM */\n651\t\n652\t/* WRITE_tRNS */\n653\t/* Write the tRNS chunk */\n654\t#[unsafe(no_mangle)]\n655\tpub unsafe extern \"C-unwind\" fn png_write_tRNS(\n656\t    png_ptr: png_structrp,\n657\t    trans_alpha: png_const_bytep,\n658\t    tran: png_const_color_16p,\n659\t    num_trans: c_int,\n660\t    color_type: c_int,\n661\t) {\n662\t    let mut buf: [png_byte; 6] = [0; 6];\n663\t\n664\t    if color_type == PNG_COLOR_TYPE_PALETTE {\n665\t        if num_trans <= 0 || num_trans > (*png_ptr).num_palette as c_int {\n666\t            png_app_warning(\n667\t                png_ptr,\n668\t                c\"Invalid number of transparent colors specified\".as_ptr(),\n669\t            );\n670\t            return;\n671\t        }\n672\t\n673\t        /* Write the chunk out as it is */\n674\t        png_write_complete_chunk(png_ptr, png_tRNS, trans_alpha, num_trans as usize);\n675\t    } else if color_type == PNG_COLOR_TYPE_GRAY {\n676\t        /* One 16-bit value */\n677\t        if (*tran).gray as c_int >= 1i32.wrapping_shl((*png_ptr).bit_depth as c_uint) {\n678\t            png_app_warning(\n679\t                png_ptr,\n680\t                c\"Ignoring attempt to write tRNS chunk out-of-range for bit_depth\".as_ptr(),\n681\t            );\n682\t\n683\t            return;\n684\t        }\n685\t\n686\t        png_save_uint_16(buf.as_mut_ptr(), (*tran).gray as c_uint);\n687\t        png_write_complete_chunk(png_ptr, png_tRNS, buf.as_ptr(), 2);\n688\t    } else if color_type == PNG_COLOR_TYPE_RGB {\n689\t        /* Three 16-bit values */\n690\t        png_save_uint_16(buf.as_mut_ptr(), (*tran).red as c_uint);\n691\t        png_save_uint_16(buf.as_mut_ptr().add(2), (*tran).green as c_uint);\n692\t        png_save_uint_16(buf.as_mut_ptr().add(4), (*tran).blue as c_uint);\n693\t        /* WRITE_16BIT */\n694\t        if (*png_ptr).bit_depth == 8 && (buf[0] | buf[2] | buf[4]) != 0 {\n695\t            png_app_warning(\n696\t                png_ptr,\n697\t                c\"Ignoring attempt to write 16-bit tRNS chunk when bit_depth is 8\".as_ptr(),\n698\t            );\n699\t            return;\n700\t        }\n701\t\n702\t        png_write_complete_chunk(png_ptr, png_tRNS, buf.as_ptr(), 6);\n703\t    } else {\n704\t        png_app_warning(png_ptr, c\"Can't write tRNS with an alpha channel\".as_ptr());\n705\t    }\n706\t}\n707\t/* WRITE_tRNS */\n708\t\n709\t/* WRITE_bKGD */\n710\t/* Write the background chunk */\n711\t#[unsafe(no_mangle)]\n712\tpub unsafe extern \"C-unwind\" fn png_write_bKGD(\n713\t    png_ptr: png_structrp,\n714\t    back: png_const_color_16p,\n715\t    color_type: c_int,\n716\t) {\n717\t    let mut buf: [png_byte; 6] = [0; 6];\n718\t\n719\t    if color_type == PNG_COLOR_TYPE_PALETTE {\n720\t        if (/* MNG_FEATURES */\n721\t            (*png_ptr).num_palette != 0\n722\t                || ((*png_ptr).mng_features_permitted & PNG_FLAG_MNG_EMPTY_PLTE) == 0)\n723\t            && (*back).index as c_int >= (*png_ptr).num_palette as c_int\n724\t        {\n725\t            png_warning(png_ptr, c\"Invalid background palette index\".as_ptr());\n726\t            return;\n727\t        }\n728\t\n729\t        buf[0] = (*back).index;\n730\t        png_write_complete_chunk(png_ptr, png_bKGD, buf.as_ptr(), 1);\n731\t    } else if (color_type & PNG_COLOR_MASK_COLOR) != 0 {\n732\t        png_save_uint_16(buf.as_mut_ptr(), (*back).red as c_uint);\n733\t        png_save_uint_16(buf.as_mut_ptr().add(2), (*back).green as c_uint);\n734\t        png_save_uint_16(buf.as_mut_ptr().add(4), (*back).blue as c_uint);\n735\t        /* WRITE_16BIT */\n736\t        if (*png_ptr).bit_depth == 8 && (buf[0] | buf[2] | buf[4]) != 0 {\n737\t            png_warning(\n738\t                png_ptr,\n739\t                c\"Ignoring attempt to write 16-bit bKGD chunk when bit_depth is 8\".as_ptr(),\n740\t            );\n741\t\n742\t            return;\n743\t        }\n744\t\n745\t        png_write_complete_chunk(png_ptr, png_bKGD, buf.as_ptr(), 6);\n746\t    } else {\n747\t        if (*back).gray as c_int >= 1i32.wrapping_shl((*png_ptr).bit_depth as c_uint) {\n748\t            png_warning(\n749\t                png_ptr,\n750\t                c\"Ignoring attempt to write bKGD chunk out-of-range for bit_depth\".as_ptr(),\n751\t            );\n752\t\n753\t            return;\n754\t        }\n755\t\n756\t        png_save_uint_16(buf.as_mut_ptr(), (*back).gray as c_uint);\n757\t        png_write_complete_chunk(png_ptr, png_bKGD, buf.as_ptr(), 2);\n758\t    }\n759\t}\n760\t/* WRITE_bKGD */\n761\t\n762\t/* WRITE_cICP */\n763\t/* Write the cICP data */\n764\t#[unsafe(no_mangle)]\n765\tpub unsafe extern \"C-unwind\" fn png_write_cICP(\n766\t    png_ptr: png_structrp,\n767\t    colour_primaries: png_byte,\n768\t    transfer_function: png_byte,\n769\t    matrix_coefficients: png_byte,\n770\t    video_full_range_flag: png_byte,\n771\t) {\n772\t    let mut buf: [png_byte; 4] = [0; 4];\n773\t\n774\t    png_write_chunk_header(png_ptr, png_cICP, 4);\n775\t\n776\t    buf[0] = colour_primaries;\n777\t    buf[1] = transfer_function;\n778\t    buf[2] = matrix_coefficients;\n779\t    buf[3] = video_full_range_flag;\n780\t    png_write_chunk_data(png_ptr, buf.as_ptr(), 4);\n781\t\n782\t    png_write_chunk_end(png_ptr);\n783\t}\n784\t/* WRITE_cICP */\n785\t\n786\t/* WRITE_cLLI */\n787\t#[unsafe(no_mangle)]\n788\tpub unsafe extern \"C-unwind\" fn png_write_cLLI_fixed(\n789\t    png_ptr: png_structrp,\n790\t    maxCLL: png_uint_32,\n791\t    maxFALL: png_uint_32,\n792\t) {\n793\t    let mut buf: [png_byte; 8] = [0; 8];\n794\t\n795\t    png_save_uint_32(buf.as_mut_ptr(), maxCLL);\n796\t    png_save_uint_32(buf.as_mut_ptr().add(4), maxFALL);\n797\t\n798\t    png_write_complete_chunk(png_ptr, png_cLLI, buf.as_ptr(), 8);\n799\t}\n800\t/* WRITE_cLLI */\n801\t\n802\t/* WRITE_mDCV */\n803\t#[unsafe(no_mangle)]\n804\tpub unsafe extern \"C-unwind\" fn png_write_mDCV_fixed(\n805\t    png_ptr: png_structrp,\n806\t    red_x: png_uint_16,\n807\t    red_y: png_uint_16,\n808\t    green_x: png_uint_16,\n809\t    green_y: png_uint_16,\n810\t    blue_x: png_uint_16,\n811\t    blue_y: png_uint_16,\n812\t    white_x: png_uint_16,\n813\t    white_y: png_uint_16,\n814\t    maxDL: png_uint_32,\n815\t    minDL: png_uint_32,\n816\t) {\n817\t    let mut buf: [png_byte; 24] = [0; 24];\n818\t\n819\t    png_save_uint_16(buf.as_mut_ptr().add(0), red_x as c_uint);\n820\t    png_save_uint_16(buf.as_mut_ptr().add(2), red_y as c_uint);\n821\t    png_save_uint_16(buf.as_mut_ptr().add(4), green_x as c_uint);\n822\t    png_save_uint_16(buf.as_mut_ptr().add(6), green_y as c_uint);\n823\t    png_save_uint_16(buf.as_mut_ptr().add(8), blue_x as c_uint);\n824\t    png_save_uint_16(buf.as_mut_ptr().add(10), blue_y as c_uint);\n825\t    png_save_uint_16(buf.as_mut_ptr().add(12), white_x as c_uint);\n826\t    png_save_uint_16(buf.as_mut_ptr().add(14), white_y as c_uint);\n827\t    png_save_uint_32(buf.as_mut_ptr().add(16), maxDL);\n828\t    png_save_uint_32(buf.as_mut_ptr().add(20), minDL);\n829\t\n830\t    png_write_complete_chunk(png_ptr, png_mDCV, buf.as_ptr(), 24);\n831\t}\n832\t/* WRITE_mDCV */\n833\t\n834\t/* WRITE_eXIf */\n835\t/* Write the Exif data */\n836\t#[unsafe(no_mangle)]\n837\tpub unsafe extern \"C-unwind\" fn png_write_eXIf(\n838\t    png_ptr: png_structrp,\n839\t    exif: png_bytep,\n840\t    num_exif: c_int,\n841\t) {\n842\t    let mut i: c_int;\n843\t    let mut buf: [png_byte; 1] = [0; 1];\n844\t\n845\t    png_write_chunk_header(png_ptr, png_eXIf, num_exif as png_uint_32);\n846\t\n847\t    i = 0;\n848\t    while i < num_exif {\n849\t        buf[0] = *exif.offset(i as isize);\n850\t        png_write_chunk_data(png_ptr, buf.as_ptr(), 1);\n851\t\n852\t        i = i.wrapping_add(1);\n853\t    }\n854\t\n855\t    png_write_chunk_end(png_ptr);\n856\t}\n857\t/* WRITE_eXIf */\n858\t\n859\t/* WRITE_hIST */\n860\t/* Write the histogram */\n861\t#[unsafe(no_mangle)]\n862\tpub unsafe extern \"C-unwind\" fn png_write_hIST(\n863\t    png_ptr: png_structrp,\n864\t    hist: png_const_uint_16p,\n865\t    num_hist: c_int,\n866\t) {\n867\t    let mut i: c_int;\n868\t    let mut buf: [png_byte; 3] = [0; 3];\n869\t\n870\t    if num_hist > (*png_ptr).num_palette as c_int {\n871\t        png_warning(\n872\t            png_ptr,\n873\t            c\"Invalid number of histogram entries specified\".as_ptr(),\n874\t        );\n875\t        return;\n876\t    }\n877\t\n878\t    png_write_chunk_header(png_ptr, png_hIST, num_hist.wrapping_mul(2) as png_uint_32);\n879\t\n880\t    i = 0;\n881\t    while i < num_hist {\n882\t        png_save_uint_16(buf.as_mut_ptr(), *hist.offset(i as isize) as c_uint);\n883\t        png_write_chunk_data(png_ptr, buf.as_ptr(), 2);\n884\t\n885\t        i = i.wrapping_add(1);\n886\t    }\n887\t\n888\t    png_write_chunk_end(png_ptr);\n889\t}\n890\t/* WRITE_hIST */\n891\t"}]},"parent_tool_use_id":"toolu_bdrk_01P91Ffd2Gst2nNcxmbU4s7z","session_id":"a9a0a7d5-d080-4cce-a91d-7cd01f6e0204","uuid":"6f34831f-6695-45de-bba6-9bc456205f8d","timestamp":"2026-08-22T15:27:16.889Z","subagent_type":"general-purpose","task_de