apping_add(32768);\n757\t    (0xffff & ((temp.wrapping_add(temp >> 16)) >> 16)) as png_uint_16\n758\t}\n759\t\n760\t/* Read/write integer helpers (macro forms used inside the library) */\n761\t\n762\t#[inline]\n763\tpub unsafe fn PNG_get_uint_32(buf: png_const_bytep) -> png_uint_32 {\n764\t    ((*buf as png_uint_32) << 24)\n765\t        + ((*buf.add(1) as png_uint_32) << 16)\n766\t        + ((*buf.add(2) as png_uint_32) << 8)\n767\t        + (*buf.add(3) as png_uint_32)\n768\t}\n769\t\n770\t#[inline]\n771\tpub unsafe fn PNG_get_uint_16(buf: png_const_bytep) -> png_uint_16 {\n772\t    (((*buf as u32) << 8) + (*buf.add(1) as u32)) as png_uint_16\n773\t}\n774\t\n775\t#[inline]\n776\tpub unsafe fn PNG_get_int_32(buf: png_const_bytep) -> png_int_32 {\n777\t    if (*buf & 0x80) != 0 {\n778\t        -(((((PNG_get_uint_32(buf) ^ 0xffff_ffffu32).wrapping_add(1)) & 0x7fff_ffff) as png_int_32))\n779\t    } else {\n780\t        PNG_get_uint_32(buf) as png_int_32\n781\t    }\n782\t}\n783\t\n784\t/* Alignment helper */\n785\t#[inline]\n786\tpub fn png_isaligned<T>(ptr: *const T) -> bool {\n787\t    (ptr as usize) & (core::mem::size_of::<T>() - 1) == 0\n788\t}\n789\t\n790\t/* <float.h> constants used by png.c */\n791\tpub const DBL_DIG: c_int = 15;\n792\tpub const DBL_MIN: f64 = f64::MIN_POSITIVE; /* 2.2250738585072014e-308 */\n793\tpub const DBL_MAX: f64 = f64::MAX;\n794\tpub const DBL_MIN_10_EXP: c_int = -307;\n795\tpub const DBL_MAX_10_EXP: c_int = 308;\n796\t\n797\t/* <math.h> functions that Rust's std does not provide directly. */\n798\textern \"C\" {\n799\t    pub fn frexp(x: f64, exp: *mut c_int) -> f64;\n800\t    pub fn modf(x: f64, iptr: *mut f64) -> f64;\n801\t    pub fn pow(x: f64, y: f64) -> f64;\n802\t}\n803\t\n804\t#[inline]\n805\tpub fn floor(x: f64) -> f64 {\n806\t    x.floor()\n807\t}\n808\t\n809\t#[inline]\n810\tpub fn fabs(x: f64) -> f64 {\n811\t    x.abs()\n812\t}\n813\t\n814\t/* The C library's `stderr` (glibc exposes it as a real global variable). */\n815\tex