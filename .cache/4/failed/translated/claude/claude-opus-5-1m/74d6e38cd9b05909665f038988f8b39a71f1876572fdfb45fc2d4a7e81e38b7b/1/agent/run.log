{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01X92bn4jCJg4zHbkekyBJE9","type":"tool_result","content":"660\t\n661\t/* Combines the row recently read in with the existing pixels in the row.  This\n662\t * routine takes care of alpha and transparency if requested.  This routine also\n663\t * handles the two methods of progressive display of interlaced images,\n664\t * depending on the 'display' value; if 'display' is true then the whole row\n665\t * (dp) is filled from the start by replicating the available pixels.  If\n666\t * 'display' is false only those pixels present in the pass are filled in.\n667\t */\n668\t#[unsafe(no_mangle)]\n669\tpub unsafe extern \"C-unwind\" fn png_combine_row(\n670\t    png_ptr: png_const_structrp,\n671\t    dp: png_bytep,\n672\t    display: c_int,\n673\t) {\n674\t    let mut dp: png_bytep = dp;\n675\t    let mut pixel_depth: c_uint = (*png_ptr).transformed_pixel_depth as c_uint;\n676\t    let mut sp: png_const_bytep = (*png_ptr).row_buf.add(1);\n677\t    let mut row_width: png_alloc_size_t = (*png_ptr).width as png_alloc_size_t;\n678\t    let pass: c_uint = (*png_ptr).pass as c_uint;\n679\t    let mut end_ptr: png_bytep = core::ptr::null_mut();\n680\t    let mut end_byte: png_byte = 0;\n681\t    let mut end_mask: c_uint;\n682\t\n683\t    /* Added in 1.5.6: it should not be possible to enter this routine until at\n684\t     * least one row has been read from the PNG data and transformed.\n685\t     */\n686\t    if pixel_depth == 0 {\n687\t        png_error(png_ptr, c\"internal row logic error\".as_ptr());\n688\t    }\n689\t\n690\t    /* Added in 1.5.4: the pixel depth should match the information returned by\n691\t     * any call to png_read_update_info at this point.  Do not continue if we got\n692\t     * this wrong.\n693\t     */\n694\t    if (*png_ptr).info_rowbytes != 0\n695\t        && (*png_ptr).info_rowbytes != PNG_ROWBYTES(pixel_depth as usize, row_width)\n696\t    {\n697\t        png_error(png_ptr, c\"internal row size calculation error\".as_ptr());\n698\t    }\n699\t\n700\t    /* Don't expect this to ever happen: */\n701\t    if row_width == 0 {\n702\t        png_error(png_ptr, c\"internal row width error\".as_ptr());\n703\t    }\n704\t\n705\t    /* Preserve the last byte in cases where only part of it will be overwritten,\n706\t     * the multiply below may overflow, we don't care because ANSI-C guarantees\n707\t     * we get the low bits.\n708\t     */\n709\t    end_mask = ((pixel_depth as png_alloc_size_t).wrapping_mul(row_width) & 7) as c_uint;\n710\t    if end_mask != 0 {\n711\t        /* end_ptr == NULL is a flag to say do nothing */\n712\t        end_ptr = dp\n713\t            .add(PNG_ROWBYTES(pixel_depth as usize, row_width))\n714\t            .sub(1);\n715\t        end_byte = *end_ptr;\n716\t        /* READ_PACKSWAP_SUPPORTED */\n717\t        if ((*png_ptr).transformations & PNG_PACKSWAP) != 0 {\n718\t            /* little-endian byte */\n719\t            end_mask = 0xffu32 << end_mask;\n720\t        } else\n721\t        /* big-endian byte */\n722\t        {\n723\t            end_mask = 0xffu32 >> end_mask;\n724\t        }\n725\t        /* end_mask is now the bits to *keep* from the destination row */\n726\t    }\n727\t\n728\t    /* For non-interlaced images this reduces to a memcpy(). A memcpy()\n729\t     * will also happen if interlacing isn't supported or if the application\n730\t     * does not call png_set_interlace_handling().  In the latter cases the\n731\t     * caller just gets a sequence of the unexpanded rows from each interlace\n732\t     * pass.\n733\t     */\n734\t    /* READ_INTERLACING_SUPPORTED */\n735\t    if (*png_ptr).interlaced != 0\n736\t        && ((*png_ptr).transformations & PNG_INTERLACE) != 0\n737\t        && pass < 6\n738\t        && (display == 0 ||\n739\t       /* The following copies everything for 'display' on passes 0, 2 and 4. */\n740\t       (display == 1 && (pass & 1) != 0))\n741\t    {\n742\t        /* Narrow images may have no bits in a pass; the caller should handle\n743\t         * this, but this test is cheap:\n744\t         */\n745\t        if row_width <= PNG_PASS_START_COL(pass as c_int) as png_alloc_size_t {\n746\t            return;\n747\t        }\n748\t\n749\t        if pixel_depth < 8 {\n750\t            /* For pixel depths up to 4 bpp the 8-pixel mask can be expanded to fit\n751\t             * into 32 bits, then a single loop over the bytes using the four byte\n752\t             * values in the 32-bit mask can be used.  For the 'display' option the\n753\t             * expanded mask may also not require any masking within a byte.  To\n754\t             * make this work the PACKSWAP option must be taken into account - it\n755\t             * simply requires the pixels to be reversed in each byte.\n756\t             *\n757\t             * The 'regular' case requires a mask for each of the first 6 passes,\n758\t             * the 'display' case does a copy for the even passes in the range\n759\t             * 0..6.  This has already been handled in the test above.\n760\t             *\n761\t             * The masks are arranged as four bytes with the first byte to use in\n762\t             * the lowest bits (little-endian) regardless of the order (PACKSWAP or\n763\t             * not) of the pixels in each byte.\n764\t             *\n765\t             * NOTE: the whole of this logic depends on the caller of this function\n766\t             * only calling it on rows appropriate to the pass.  This function only\n767\t             * understands the 'x' logic; the 'y' logic is handled by the caller.\n768\t             *\n769\t             * The following defines allow generation of compile time constant bit\n770\t             * masks for each pixel depth and each possibility of swapped or not\n771\t             * swapped bytes.  Pass 'p' is in the range 0..6; 'x', a pixel index,\n772\t             * is in the range 0..7; and the result is 1 if the pixel is to be\n773\t             * copied in the pass, 0 if not.  'S' is for the sparkle method, 'B'\n774\t             * for the block method.\n775\t             */\n776\t            /* PNG_USE_COMPILE_TIME_MASKS == 1 */\n777\t            const fn PNG_LSR(x: png_uint_32, s: c_int) -> png_uint_32 {\n778\t                x >> ((s & 0x1f) as u32)\n779\t            }\n780\t            const fn PNG_LSL(x: png_uint_32, s: c_int) -> png_uint_32 {\n781\t                x << ((s & 0x1f) as u32)\n782\t            }\n783\t            const fn S_COPY(p: c_int, x: c_int) -> png_uint_32 {\n784\t                (if p < 4 {\n785\t                    PNG_LSR(0x80088822, (3 - p) * 8 + (7 - x))\n786\t                } else {\n787\t                    PNG_LSR(0xaa55ff00, (7 - p) * 8 + (7 - x))\n788\t                }) & 1\n789\t            }\n790\t            const fn B_COPY(p: c_int, x: c_int) -> png_uint_32 {\n791\t                (if p < 4 {\n792\t                    PNG_LSR(0xff0fff33, (3 - p) * 8 + (7 - x))\n793\t                } else {\n794\t                    PNG_LSR(0xff55ff00, (7 - p) * 8 + (7 - x))\n795\t                }) & 1\n796\t            }\n797\t\n798\t            /* Return a mask for pass 'p' pixel 'x' at depth 'd'.  The mask is\n799\t             * little endian - the first pixel is at bit 0 - however the extra\n800\t             * parameter 's' can be set to cause the mask position to be swapped\n801\t             * within each byte, to match the PNG format.  This is done by XOR of\n802\t             * the shift with 7, 6 or 4 for bit depths 1, 2 and 4.\n803\t             */\n804\t            const fn PIXEL_MASK(_p: c_int, x: c_int, d: c_int, s: c_int) -> png_uint_32 {\n805\t                PNG_LSL(\n806\t                    PNG_LSL(1u32, d).wrapping_sub(1),\n807\t                    (x * d) ^ (if s != 0 { 8 - d } else { 0 }),\n808\t                )\n809\t            }\n810\t\n811\t            /* Hence generate the appropriate 'block' or 'sparkle' pixel copy mask.\n812\t             */\n813\t            const fn S_MASKx(p: c_int, x: c_int, d: c_int, s: c_int) -> png_uint_32 {\n814\t                if S_COPY(p, x) != 0 {\n815\t                    PIXEL_MASK(p, x, d, s)\n816\t                } else {\n817\t                    0\n818\t                }\n819\t            }\n820\t            const fn B_MASKx(p: c_int, x: c_int, d: c_int, s: c_int) -> png_uint_32 {\n821\t                if B_COPY(p, x) != 0 {\n822\t                    PIXEL_MASK(p, x, d, s)\n823\t                } else {\n824\t                    0\n825\t                }\n826\t            }\n827\t\n828\t            /* Combine 8 of these to get the full mask.  For the 1-bpp and 2-bpp\n829\t             * cases the result needs replicating, for the 4-bpp case the above\n830\t             * generates a full 32 bits.\n831\t             */\n832\t            const fn MASK_EXPAND(m: png_uint_32, d: c_int) -> png_uint_32 {\n833\t                m.wrapping_mul(if d == 1 {\n834\t                    0x01010101\n835\t                } else if d == 2 {\n836\t                    0x00010001\n837\t                } else {\n838\t                    1\n839\t                })\n840\t            }\n841\t\n842\t            const fn S_MASK(p: c_int, d: c_int, s: c_int) -> png_uint_32 {\n843\t                MASK_EXPAND(\n844\t                    S_MASKx(p, 0, d, s)\n845\t                        .wrapping_add(S_MASKx(p, 1, d, s))\n846\t                        .wrapping_add(S_MASKx(p, 2, d, s))\n847\t                        .wrapping_add(S_MASKx(p, 3, d, s))\n848\t                        .wrapping_add(S_MASKx(p, 4, d, s))\n849\t                        .wrapping_add(S_MASKx(p, 5, d, s))\n850\t                        .wrapping_add(S_MASKx(p, 6, d, s))\n851\t                        .wrapping_add(S_MASKx(p, 7, d, s)),\n852\t                    d,\n853\t                )\n854\t            }\n855\t\n856\t            const fn B_MASK(p: c_int, d: c_int, s: c_int) -> png_uint_32 {\n857\t                MAS