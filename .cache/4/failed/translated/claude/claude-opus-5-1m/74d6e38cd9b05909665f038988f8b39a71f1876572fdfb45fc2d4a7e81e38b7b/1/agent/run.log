n415\tpub const PNG_FLAG_CRC_ANCILLARY_NOWARN: png_uint_32 = 0x0200;\n416\tpub const PNG_FLAG_CRC_CRITICAL_USE: png_uint_32 = 0x0400;\n417\tpub const PNG_FLAG_CRC_CRITICAL_IGNORE: png_uint_32 = 0x0800;\n418\tpub const PNG_FLAG_OPTIMIZE_ALPHA: png_uint_32 = 0x2000;\n419\tpub const PNG_FLAG_DETECT_UNINITIALIZED: png_uint_32 = 0x4000;\n420\tpub const PNG_FLAG_LIBRARY_MISMATCH: png_uint_32 = 0x20000;\n421\tpub const PNG_FLAG_STRIP_ERROR_TEXT: png_uint_32 = 0x80000;\n422\tpub const PNG_FLAG_BENIGN_ERRORS_WARN: png_uint_32 = 0x100000;\n423\tpub const PNG_FLAG_APP_WARNINGS_WARN: png_uint_32 = 0x200000;\n424\tpub const PNG_FLAG_APP_ERRORS_WARN: png_uint_32 = 0x400000;\n425\t\n426\tpub const PNG_FLAG_CRC_ANCILLARY_MASK: png_uint_32 =\n427\t    PNG_FLAG_CRC_ANCILLARY_USE | PNG_FLAG_CRC_ANCILLARY_NOWARN;\n428\tpub const PNG_FLAG_CRC_CRITICAL_MASK: png_uint_32 =\n429\t    PNG_FLAG_CRC_CRITICAL_USE | PNG_FLAG_CRC_CRITICAL_IGNORE;\n430\tpub const PNG_FLAG_CRC_MASK: png_uint_32 =\n431\t    PNG_FLAG_CRC_ANCILLARY_MASK | PNG_FLAG_CRC_CRITICAL_MASK;\n432\t\n433\t/* Gamma */\n434\tpub const PNG_GAMMA_MAC_OLD: png_fixed_point = 151724;\n435\tpub const PNG_GAMMA_MAC_INVERSE: png_fixed_point = 65909;\n436\tpub const PNG_GAMMA_sRGB_INVERSE: png_fixed_point = 45455;\n437\tpub const PNG_LIB_GAMMA_MIN: png_fixed_point = 1000;\n438\tpub const PNG_LIB_GAMMA_MAX: png_fixed_point = 10000000;\n439\t\n440\t/* Chunk report levels */\n441\tpub const PNG_CHUNK_WARNING: c_int = 0;\n442\tpub const PNG_CHUNK_WRITE_ERROR: c_int = 1;\n443\tpub const PNG_CHUNK_ERROR: c_int = 2;\n444\t\n445\tpub const PNG_UNEXPECTED_ZLIB_RETURN: c_int = -7;\n446\t\n447\t/* Number formats */\n448\tpub const PNG_NUMBER_FORMAT_u: c_int = 1;\n449\tpub const PNG_NUMBER_FORMAT_02u: c_int = 2;\n450\tpub const PNG_NUMBER_FORMAT_d: c_int = 1;\n451\tpub const PNG_NUMBER_FORMAT_02d: c_int = 2;\n452\tpub const PNG_NUMBER_FORMAT_x: c_int = 3;\n453\tpub const PNG_NUMBER_FORMAT_02x: c_int = 4;\n454\tpub const PNG_NUMBER_FORMAT_fixed: c_int = 5;\n455\tpub const PNG_NUMBER_BUFFER_SIZE: usize = 24;\n456\t\n457\tpub const PNG_WARNING_PARAMETER_SIZE: usize = 32;\n458\tpub const PNG_WARNING_PARAMETER_COUNT: usize = 8;\n459\tpub type png_warning_parameters = [[core::ffi::c_char; PNG_WARNING_PARAMETER_SIZE];\n460\t    PNG_WARNING_PARAMETER_COUNT];\n461\t\n462\tpub const PNG_MAX_ERROR_TEXT: usize = 196;\n463\t\n464\t/* fp parser states */\n465\tpub const PNG_FP_INTEGER: c_int = 0;\n466\tpub const PNG_FP_FRACTION: c_int = 1;\n467\tpub const PNG_FP_EXPONENT: c_int = 2;\n468\tpub const PNG_FP_STATE: c_int = 3;\n469\tpub const PNG_FP_SAW_SIGN: c_int = 4;\n470\tpub const PNG_FP_SAW_DIGIT: c_int = 8;\n471\tpub const PNG_FP_SAW_DOT: c_int = 16;\n472\tpub const PNG_FP_SAW_E: c_int = 32;\n473\tpub const PNG_FP_SAW_ANY: c_int = 60;\n474\tpub const PNG_FP_WAS_VALID: c_int = 64;\n475\tpub const PNG_FP_NEGATIVE: c_int = 128;\n476\tpub const PNG_FP_NONZERO: c_int = 256;\n477\tpub const PNG_FP_STICKY: c_int = 448;\n478\tpub const PNG_FP_INVALID: c_int = 512;\n479\tpub const PNG_FP_MAYBE: c_int = 0;\n480\tpub const PNG_FP_OK: c_int = 1;\n481\tpub const PNG_FP_NZ_MASK: c_int = PNG_FP_SAW_DIGIT | PNG_FP_NEGATIVE | PNG_FP_NONZERO;\n482\tpub const PNG_FP_Z_MASK: c_int = PNG_FP_SAW_DIGIT | PNG_FP_NONZERO;\n483\t\n484\t#[inline]\n485\tpub fn PNG_FP_IS_ZERO(state: c_int) -> bool {\n486\t    (state & PNG_FP_Z_MASK) == PNG_FP_SAW_DIGIT\n487\t}\n488\t#[inline]\n489\tpub fn PNG_FP_IS_POSITIVE(state: c_int) -> bool {\n490\t    (state & PNG_FP_NZ_MASK) == PNG_FP_Z_MASK\n491\t}\n492\t#[inline]\n493\tpub fn PNG_FP_IS_NEGATIVE(state: c_int) -> bool {\n494\t    (state & PNG_FP_NZ_MASK) == PNG_FP_NZ_MASK\n495\t}\n496\t\n497\tpub const PNG_sCAL_MAX_DIGITS: usize = (PNG_sCAL_PRECISION as usize) + 1 + 1 + 10;\n498\t\n499\t/* png_handle_result_code */\n500\tpub const handled_error: c_int = 0;\n501\tpub const handled_discarded: c_int = 1;\n502\tpub const handled_saved: c_int = 2;\n503\tpub const handled_ok: c_int = 3;\n504\t\n505\t/* ------------------------------------------------------- chunk constants */\n506\t\n507\t#[inline]\n508\tpub const fn PNG_U32(b1: u32, b2: u32, b3: u32, b4: u32) -> png_uint_32 {\n509\t    (b1 << 24) | (b2 << 16) | (b3 << 8) | b4\n510\t}\n511\t\n512\tpub const png_IDAT: png_uint_32 = PNG_U32(73, 68, 65, 84);\n513\tpub const png_IEND: png_uint_32 = PNG_U32(73, 69, 78, 68);\n514\tpub const png_IHDR: png_uint_32 = PNG_U32(73, 72, 68, 82);\n515\tpub const png_PLTE: png_uint_32 = PNG_U32(80, 76, 84, 69);\n516\tpub const png_acTL: png_uint_32 = PNG_U32(97, 99, 84, 76);\n517\tpub const png_bKGD: png_uint_32 = PNG_U32(98, 75, 71, 68);\n518\tpub const png_cHRM: png_uint_32 = PNG_U32(99, 72, 82, 77);\n519\tpub const png_cICP: png_uint_32 = PNG_U32(99, 73, 67, 80);\n520\tpub const png_cLLI: png_uint_32 = PNG_U32(99, 76, 76, 73);\n521\tpub const png_eXIf: png_uint_32 = PNG_U32(101, 88, 73, 102);\n522\tpub const png_fcTL: png_uint_32 = PNG_U32(102, 99, 84, 76);\n523\tpub const png_fdAT: png_uint_32 = PNG_U32(102, 100, 65, 84);\n524\tpub const png_fRAc: png_uint_32 = PNG_U32(102, 82, 65, 99);\n525\tpub const png_gAMA: png_uint_32 = PNG_U32(103, 65, 77, 65);\n526\tpub const png_gIFg: png_uint_32 = PNG_U32(103, 73, 70, 103);\n527\tpub const png_gIFt: png_uint_32 = PNG_U32(103, 73, 70, 116);\n528\tpub const png_gIFx: png_uint_32 = PNG_U32(103, 73, 70, 120);\n529\tpub const png_hIST: png_uint_32 = PNG_U32(104, 73, 83, 84);\n530\tpub const png_iCCP: png_uint_32 = PNG_U32(105, 67, 67, 80);\n531\tpub const png_iTXt: png_uint_32 = PNG_U32(105, 84, 88, 116);\n532\tpub const png_mDCV: png_uint_32 = PNG_U32(109, 68, 67, 86);\n533\tpub const png_oFFs: png_uint_32 = PNG_U32(111, 70, 70, 115);\n534\tpub const png_pCAL: png_uint_32 = PNG_U32(112, 67, 65, 76);\n535\tpub const png_pHYs: png_uint_32 = PNG_U32(112, 72, 89, 115);\n536\tpub const png_sBIT: png_uint_32 = PNG_U32(115, 66, 73, 84);\n537\tpub const png_sCAL: png_uint_32 = PNG_U32(115, 67, 65, 76);\n538\tpub const png_sPLT: png_uint_32 = PNG_U32(115, 80, 76, 84);\n539\tpub const png_sRGB: png_uint_32 = PNG_U32(115, 82, 71, 66);\n540\tpub const png_sTER: png_uint_32 = PNG_U32(115, 84, 69, 82);\n541\tpub const png_tEXt: png_uint_32 = PNG_U32(116, 69, 88, 116);\n542\tpub const png_tIME: png_uint_32 = PNG_U32(116, 73, 77, 69);\n543\tpub const png_tRNS: png_uint_32 = PNG_U32(116, 82, 78, 83);\n544\tpub const png_zTXt: png_uint_32 = PNG_U32(122, 84, 88, 116);\n545\t\n546\t/* Chunk index values (PNG_KNOWN_CHUNKS) */\n547\tpub const PNG_INDEX_IHDR: c_int = 0;\n548\tpub const PNG_INDEX_PLTE: c_int = 1;\n549\tpub const PNG_INDEX_IDAT: c_int = 2;\n550\tpub const PNG_INDEX_IEND: c_int = 3;\n551\tpub const PNG_INDEX_acTL: c_int = 4;\n552\tpub const PNG_INDEX_bKGD: c_int = 5;\n553\tpub const PNG_INDEX_cHRM: c_int = 6;\n554\tpub const PNG_INDEX_cICP: c_int = 7;\n555\tpub const PNG_INDEX_cLLI: c_int = 8;\n556\tpub const PNG_INDEX_eXIf: c_int = 9;\n557\tpub const PNG_INDEX_fcTL: c_int = 10;\n558\tpub const PNG_INDEX_fdAT: c_int = 11;\n559\tpub const PNG_INDEX_gAMA: c_int = 12;\n560\tpub const PNG_INDEX_hIST: c_int = 13;\n561\tpub const PNG_INDEX_iCCP: c_int = 14;\n562\tpub const PNG_INDEX_iTXt: c_int = 15;\n563\tpub const PNG_INDEX_mDCV: c_int = 16;\n564\tpub const PNG_INDEX_oFFs: c_int = 17;\n565\tpub const PNG_INDEX_pCAL: c_int = 18;\n566\tpub const PNG_INDEX_pHYs: c_int = 19;\n567\tpub const PNG_INDEX_sBIT: c_int = 20;\n568\tpub const PNG_INDEX_sCAL: c_int = 21;\n569\tpub const PNG_INDEX_sPLT: c_int = 22;\n570\tpub const PNG_INDEX_sRGB: c_int = 23;\n571\tpub const PNG_INDEX_tEXt: c_int = 24;\n572\tpub const PNG_INDEX_tIME: c_int = 25;\n573\tpub const PNG_INDEX_tRNS: c_int = 26;\n574\tpub const PNG_INDEX_zTXt: c_int = 27;\n575\tpub const PNG_INDEX_unknown: c_int = 28;\n576\t\n577\t#[inline]\n578\tpub const fn png_chunk_flag_from_index(i: c_int) -> png_uint_32 {\n579\t    0x8000_0000u32 >> (31 - i)\n580\t}\n581\t\n582\t#[inline]\n583\tpub const fn PNG_CHUNK_ANCILLARY(c: png_uint_32) -> c_int {\n584\t    (1 & (c >> 29)) as c_int\n585\t}\n586\t#[inline]\n587\tpub const fn PNG_CHUNK_CRITICAL(c: png_uint_32) -> c_int {\n588\t    if PNG_CHUNK_ANCILLARY(c) != 0 {\n589\t        0\n590\t    } else {\n591\t        1\n592\t    }\n593\t}\n594\t#[inline]\n595\tpub const fn PNG_CHUNK_PRIVATE(c: png_uint_32) -> c_int {\n596\t    (1 & (c >> 21)) as c_int\n597\t}\n598\t#[inline]\n599\tpub const fn PNG_CHUNK_RESERVED(c: png_uint_32) -> c_int {\n600\t    (1 & (c >> 13)) as c_int\n601\t}\n602\t#[inline]\n603\tpub const fn PNG_CHUNK_SAFE_TO_COPY(c: png_uint_32) -> c_int {\n604\t    (1 & (c >> 5)) as c_int\n605\t}\n606\t\n607\t/// `PNG_CHUNK_FROM_STRING(s)` -- reads 4 bytes.\n608\t#[inline]\n609\tpub unsafe fn PNG_CHUNK_FROM_STRING(s: *const png_byte) -> png_uint_32 {\n610\t    PNG_U32(\n611\t        (0xff & *s) as u32,\n612\t        (0xff & *s.add(1)) as u32,\n613\t        (0xff & *s.add(2)) as u32,\n614\t        (0xff & *s.add(3)) as u32,\n615\t    )\n616\t}\n617\t\n618\t/// `PNG_STRING_FROM_CHUNK(s, c)` -- writes 4 bytes.\n619\t#[inline]\n620\tpub unsafe fn PNG_STRING_FROM_CHUNK(s: *mut core::ffi::c_char, c: png_uint_32) {\n621\t    *s = ((c >> 24) & 0xff) as core::ffi::c_char;\n622\t    *s.add(1) = ((c >> 16) & 0xff) as core::ffi::c_char;\n623\t    *s.add(2) = ((c >> 8) & 0xff) as core::ffi::c_char;\n624\t    *s.add(3) = (c & 0xff) as core::ffi::c_char;\n625\t}\n626\t\n627\t/// `PNG_CSTRING_FROM_CHUNK(s, c)` -- writes 4 bytes plus a NUL.\n628\t#[inline]\n629\tpub unsafe fn PNG_CSTRING_FROM_CHUNK(s: *mut core::ffi::c_char, c: png_uint_32) {\n630\t    PNG_STRING_FROM_CHUNK(s, c);\n631\t    *s.add(4) = 0;\n632\t}\n633\t\n634\t/* ------------------------------------------------------ utility \"macros\" */\n635\t\n636\t#[inline]\n637\tpub fn PNG_ROWBYTES(pixel_bits: usize, width: usize) -> usize {\n638\t    if pixel_bits >= 8 {\n639\t        width.wrapping_mul(pixel_bits >> 3)\n640\t    } else {\n641\t        (width.wrapping_mul(pixel_bits)).wrapping_add(7) >> 3\n642\t    }\n643\t}\n644\t\n645\t#[inline]\n646\