{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01JMVmRqciJQ8YknbYTVwhaB","type":"tool_result","content":"1\t// png_p1.rs -- part 1 of the translation of c_src/src/png.c (lines 1..1067)\n2\t//\n3\t// Covers png_set_sig_bytes .. png_zstream_error.\n4\t\n5\t/* Tells libpng that we have already handled the first \"num_bytes\" bytes\n6\t * of the PNG file signature.  If the PNG data is embedded into another\n7\t * stream we can set num_bytes = 8 so that libpng will not attempt to read\n8\t * or write any of the magic bytes before it starts on the IHDR.\n9\t */\n10\t\n11\t#[unsafe(no_mangle)]\n12\tpub unsafe extern \"C-unwind\" fn png_set_sig_bytes(png_ptr: png_structrp, num_bytes: c_int) {\n13\t    let mut nb: c_uint = num_bytes as c_uint;\n14\t\n15\t    if png_ptr.is_null() {\n16\t        return;\n17\t    }\n18\t\n19\t    if num_bytes < 0 {\n20\t        nb = 0;\n21\t    }\n22\t\n23\t    if nb > 8 {\n24\t        png_error(png_ptr, c\"Too many bytes for PNG signature\".as_ptr());\n25\t    }\n26\t\n27\t    (*png_ptr).sig_bytes = nb as png_byte;\n28\t}\n29\t\n30\t/* Checks whether the supplied bytes match the PNG signature.  We allow\n31\t * checking less than the full 8-byte signature so that those apps that\n32\t * already read the first few bytes of a file to determine the file type\n33\t * can simply check the remaining bytes for extra assurance.  Returns\n34\t * an integer less than, equal to, or greater than zero if sig is found,\n35\t * respectively, to be less than, to match, or be greater than the correct\n36\t * PNG signature (this is the same behavior as strcmp, memcmp, etc).\n37\t */\n38\t#[unsafe(no_mangle)]\n39\tpub unsafe extern \"C-unwind\" fn png_sig_cmp(\n40\t    sig: png_const_bytep,\n41\t    start: usize,\n42\t    num_to_check: usize,\n43\t) -> c_int {\n44\t    static png_signature: [png_byte; 8] = [137, 80, 78, 71, 13, 10, 26, 10];\n45\t\n46\t    let mut num_to_check = num_to_check;\n47\t\n48\t    if num_to_check > 8 {\n49\t        num_to_check = 8;\n50\t    } else if num_to_check < 1 {\n51\t        return -1;\n52\t    }\n53\t\n54\t    if start > 7 {\n55\t        return -1;\n56\t    }\n57\t\n58\t    if start + num_to_check > 8 {\n59\t        num_to_check = 8 - start;\n60\t    }\n61\t\n62\t    memcmp(sig.add(start), png_signature.as_ptr().add(start), num_to_check)\n63\t}\n64\t\n65\t/* Function to allocate memory for zlib */\n66\t#[unsafe(no_mangle)]\n67\tpub unsafe extern \"C-unwind\" fn png_zalloc(\n68\t    png_ptr: *mut c_void,\n69\t    items: u32,\n70\t    size: u32,\n71\t) -> *mut c_void {\n72\t    let mut num_bytes: png_alloc_size_t = size as png_alloc_size_t;\n73\t\n74\t    if png_ptr.is_null() {\n75\t        return core::ptr::null_mut();\n76\t    }\n77\t\n78\t    /* This check against overflow is vestigial, dating back from\n79\t     * the old times when png_zalloc used to be an exported function.\n80\t     * We're still keeping it here for now, as an extra-cautious\n81\t     * prevention against programming errors inside zlib, although it\n82\t     * should rather be a debug-time assertion instead.\n83\t     */\n84\t    if size != 0\n85\t        && (items as png_alloc_size_t) >= (!(0 as png_alloc_size_t)) / (size as png_alloc_size_t)\n86\t    {\n87\t        png_warning(\n88\t            png_ptr as png_structrp,\n89\t            c\"Potential overflow in png_zalloc()\".as_ptr(),\n90\t        );\n91\t        return core::ptr::null_mut();\n92\t    }\n93\t\n94\t    num_bytes = num_bytes.wrapping_mul(items as png_alloc_size_t);\n95\t    png_malloc_warn(png_ptr as png_structrp, num_bytes)\n96\t}\n97\t\n98\t/* Function to free memory for zlib */\n99\t#[unsafe(no_mangle)]\n100\tpub unsafe extern \"C-unwind\" fn png_zfree(png_ptr: *mut c_void, ptr: *mut c_void) {\n101\t    png_free(png_ptr as png_const_structrp, ptr);\n102\t}\n103\t\n104\t/* Reset the CRC variable to 32 bits of 1's.  Care must be taken\n105\t * in case CRC is > 32 bits to leave the top bits 0.\n106\t */\n107\t#[unsafe(no_mangle)]\n108\tpub unsafe extern \"C-unwind\" fn png_reset_crc(png_ptr: png_structrp) {\n109\t    /* The cast is safe because the crc is a 32-bit value. */\n110\t    (*png_ptr).crc = crc32(0, core::ptr::null(), 0) as png_uint_32;\n111\t}\n112\t\n113\t/* Calculate the CRC over a section of data.  We can only pass as\n114\t * much data to this routine as the largest single buffer size.  We\n115\t * also check that this data will actually be used before going to the\n116\t * trouble of calculating it.\n117\t */\n118\t#[unsafe(no_mangle)]\n119\tpub unsafe extern \"C-unwind\" fn png_calculate_crc(\n120\t    png_ptr: png_structrp,\n121\t    ptr: png_const_bytep,\n122\t    length: usize,\n123\t) {\n124\t    let mut need_crc: c_int = 1;\n125\t\n126\t    if PNG_CHUNK_ANCILLARY((*png_ptr).chunk_name) != 0 {\n127\t        if ((*png_ptr).flags & PNG_FLAG_CRC_ANCILLARY_MASK)\n128\t            == (PNG_FLAG_CRC_ANCILLARY_USE | PNG_FLAG_CRC_ANCILLARY_NOWARN)\n129\t        {\n130\t            need_crc = 0;\n131\t        }\n132\t    } else\n133\t    /* critical */\n134\t    {\n135\t        if ((*png_ptr).flags & PNG_FLAG_CRC_CRITICAL_IGNORE) != 0 {\n136\t            need_crc = 0;\n137\t        }\n138\t    }\n139\t\n140\t    /* 'uLong' is defined in zlib.h as unsigned long; this means that on some\n141\t     * systems it is a 64-bit value.  crc32, however, returns 32 bits so the\n142\t     * following cast is safe.  'uInt' may be no more than 16 bits, so it is\n143\t     * necessary to perform a loop here.\n144\t     */\n145\t    if need_crc != 0 && length > 0 {\n146\t        let mut crc: u64 = (*png_ptr).crc as u64; /* Should never issue a warning */\n147\t        let mut ptr = ptr;\n148\t        let mut length = length;\n149\t\n150\t        loop {\n151\t            let mut safe_length: u32 = length as u32;\n152\t            if safe_length == 0 {\n153\t                safe_length = u32::MAX; /* evil, but safe */\n154\t            }\n155\t\n156\t            crc = crc32(crc, ptr, safe_length);\n157\t\n158\t            /* The following should never issue compiler warnings; if they do the\n159\t             * target system has characteristics that will probably violate other\n160\t             * assumptions within the libpng code.\n161\t             */\n162\t            ptr = ptr.add(safe_length as usize);\n163\t            length = length.wrapping_sub(safe_length as usize);\n164\t\n165\t            if !(length > 0) {\n166\t                break;\n167\t            }\n168\t        }\n169\t\n170\t        /* And the following is always safe because the crc is only 32 bits. */\n171\t        (*png_ptr).crc = crc as png_uint_32;\n172\t    }\n173\t}\n174\t\n175\t/* Check a user supplied version number, called from both read and write\n176\t * functions that create a png_struct.\n177\t */\n178\t#[unsafe(no_mangle)]\n179\tpub unsafe extern \"C-unwind\" fn png_user_version_check(\n180\t    png_ptr: png_structrp,\n181\t    user_png_ver: png_const_charp,\n182\t) -> c_int {\n183\t    /* Libpng versions 1.0.0 and later are binary compatible if the version\n184\t     * string matches through the second '.'; we must recompile any\n185\t     * applications that use any older library version.\n186\t     */\n187\t\n188\t    if !user_png_ver.is_null() {\n189\t        let mut i: c_int = -1;\n190\t        let mut found_dots: c_int = 0;\n191\t\n192\t        loop {\n193\t            i += 1;\n194\t            if *user_png_ver.add(i as usize) != PNG_LIBPNG_VER_STRING[i as usize] as c_char {\n195\t                (*png_ptr).flags |= PNG_FLAG_LIBRARY_MISMATCH;\n196\t            }\n197\t            if *user_png_ver.add(i as usize) == b'.' as c_char {\n198\t                found_dots += 1;\n199\t            }\n200\t\n201\t            if !(found_dots < 2\n202\t                && *user_png_ver.add(i as usize) != 0\n203\t                && PNG_LIBPNG_VER_STRING[i as usize] != 0)\n204\t            {\n205\t                break;\n206\t            }\n207\t        }\n208\t    } else {\n209\t        (*png_ptr).flags |= PNG_FLAG_LIBRARY_MISMATCH;\n210\t    }\n211\t\n212\t    if ((*png_ptr).flags & PNG_FLAG_LIBRARY_MISMATCH) != 0 {\n213\t        let mut pos: usize = 0;\n214\t        let mut m: [c_char; 128] = [0; 128];\n215\t\n216\t        pos = png_safecat(\n217\t            m.as_mut_ptr(),\n218\t            128,\n219\t            pos,\n220\t            c\"Application built with libpng-\".as_ptr(),\n221\t        );\n222\t        pos = png_safecat(m.as_mut_ptr(), 128, pos, user_png_ver);\n223\t        pos = png_safecat(m.as_mut_ptr(), 128, pos, c\" but running with \".as_ptr());\n224\t        pos = png_safecat(\n225\t            m.as_mut_ptr(),\n226\t            128,\n227\t            pos,\n228\t            PNG_LIBPNG_VER_STRING.as_ptr() as png_const_charp,\n229\t        );\n230\t\n231\t        png_warning(png_ptr, m.as_ptr());\n232\t\n233\t        return 0;\n234\t    }\n235\t\n236\t    /* Success return. */\n237\t    1\n238\t}\n239\t\n240\t/* Payload used to emulate the `setjmp(create_jmp_buf)` guard that\n241\t * png_create_png_struct() installs (see the comment in that function).\n242\t */\n243\tstruct PngCreateStructUnwind;\n244\t\n245\t/* Stand-in for the C `longjmp` that png_create_png_struct() stores into\n246\t * create_struct.longjmp_fn.  Rust cannot longjmp, so this unwinds instead and\n247\t * png_create_png_struct() catches the unwind with std::panic::catch_unwind.\n248\t */\n249\tunsafe extern \"C-unwind\" fn png_create_struct_longjmp(_jmp_buf: *mut jmp_buf, _val: c_int) {\n250\t    std::panic::resume_unwind(Box::new(PngCreateStructUnwind));\n251\t}\n252\t\n253\t/* Generic function to create a png_struct for either read or write - this\n254\t * contains the common initialization.\n255\t */\n256\t#[unsafe(no_mangle)]\n257\tpub unsafe extern \"C-unwind\" fn png_create_png_struct(\n258\t    user_png_ver: png_const_charp,\n259\t    error_ptr: png_voidp,\n260\t    error_fn: png_error_ptr,\n261\t    warn_fn: png_error_ptr,\n262\t    mem_ptr: png_voidp,\n263\t    malloc_fn: png_malloc_ptr,\n264\t    free_fn: png_free_ptr,\n265\t) -> png_structp {\n266\t    /* This temporary stack-allocated structure is used to provide a place to\n267\t     * build enough context to allow the user provided memory allocator (if any)\n268\t     * to be called.\n269\t     *\n270\t     * NOTE ON THE setjmp() IN THE C CODE: the C version wraps the body below in\n271\t     *\n272\t     *     if (!setjmp(create_jmp_buf)) { ... }\n273\t     *     return NULL;\n274\t     *\n275\t     * and installs `longjmp` into create_struct.longjmp_fn together with\n276\t     * `&create_jmp_buf` in create_struct.jmp_buf_ptr, so that a png_error()\n277\t     * raised while the png_struct is being built (e.g. from a broken\n278\t     * application memory allocator) simply returns NULL out of this function.\n279\t     *\n280\t     * Rust cannot use setjmp/longjmp, so the guarded region is wrapped in\n281\t     * std::panic::catch_unwind() and create_struct.longjmp_fn is set to\n282\t     * png_create_struct_longjmp() (above), which unwinds instead of jumping.\n283\t     * create_struct.jmp_buf_ptr is set to `&create_jmp_buf` exactly as in the C\n284\t     * code so that it is non-NULL (png_longjmp() only calls longjmp_fn when\n285\t     * jmp_buf_ptr != NULL); the buffer contents themselves are never used.\n286\t     * On Err(_) -- i.e. \"setjmp returned non-zero\" -- control drops out of the\n287\t     * guarded region and NULL is returned, exactly as the C does (the C code\n288\t     * does not free anything on this path either).\n289\t     */\n290\t    let mut create_struct: png_struct = png_struct::zeroed();\n291\t    let mut create_jmp_buf: jmp_buf = jmp_buf {\n292\t        opaque: [0; PNG_JMP_BUF_SIZE / 8],\n293\t    };\n294\t\n295\t    create_struct.user_width_max = PNG_USER_WIDTH_MAX;\n296\t    create_struct.user_height_max = PNG_USER_HEIGHT_MAX;\n297\t\n298\t    create_struct.user_chunk_cache_max = PNG_USER_CHUNK_CACHE_MAX;\n299\t\n300\t    /* PNG_USER_CHUNK_MALLOC_MAX > 0: default to the compile-time limit */\n301\t    create_struct.user_chunk_malloc_max = PNG_USER_CHUNK_MALLOC_MAX;\n302\t\n303\t    /* The following two API calls simply set fields in png_struct, so it is safe\n304\t     * to do them now even though error handling is not yet set up.\n305\t     */\n306\t    png_set_mem_fn(&mut create_struct, mem_ptr, malloc_fn, free_fn);\n307\t\n308\t    /* (*error_fn) can return control to the caller after the error_ptr is set,\n309\t     * this will result in a memory leak unless the error_fn does something\n310\t     * extremely sophisticated.  The design lacks merit but is implicit in the\n311\t     * API.\n312\t     */\n313\t    png_set_error_fn(&mut create_struct, error_ptr, error_fn, warn_fn);\n314\t\n315\t    let guarded = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| -> png_structp {\n316\t        /* Temporarily fake out the longjmp information until we have\n317\t         * successfully completed this function.  This only works if we have\n318\t         * setjmp() support compiled in, but it is safe - this stuff should\n319\t         * never happen.\n320\t         */\n321\t        create_struct.jmp_buf_ptr = core::ptr::addr_of_mut!(create_jmp_buf);\n322\t        create_struct.jmp_buf_size = 0; /*stack allocation*/\n323\t        create_struct.longjmp_fn = Some(png_create_struct_longjmp);\n324\t\n325\t        /* Call the general version checker (shared with read and write code): */\n326\t        if png_user_version_check(&mut create_struct, user_png_ver) != 0 {\n327\t            let png_ptr: png_structrp = png_malloc_warn(\n328\t                &mut create_struct,\n329\t                core::mem::size_of::<png_struct>(),\n330\t            ) as png_structrp;\n331\t\n332\t            if !png_ptr.is_null() {\n333\t                /* png_ptr->zstream holds a back-pointer to the png_struct, so\n334\t                 * this can only be done now:\n335\t                 */\n336\t                create_struct.zstream.zalloc = Some(png_zalloc);\n337\t                create_struct.zstream.zfree = Some(png_zfree);\n338\t                create_struct.zstream.opaque = png_ptr as *mut c_void;\n339\t\n340\t                /* Eliminate the local error handling: */\n341\t                create_struct.jmp_buf_ptr = core::ptr::null_mut();\n342\t                create_struct.jmp_buf_size = 0;\n343\t                create_struct.longjmp_fn = None;\n344\t\n345\t                *png_ptr = create_struct;\n346\t\n347\t                /* This is the successful return point */\n348\t                return png_ptr;\n349\t            }\n350\t        }\n351\t\n352\t        core::ptr::null_mut()\n353\t    }));\n354\t\n355\t    if let Ok(png_ptr) = guarded {\n356\t        if !png_ptr.is_null() {\n357\t            return png_ptr;\n358\t        }\n359\t    }\n360\t\n361\t    /* A longjmp because of a bug in the application storage allocator or a\n362\t     * simple failure to allocate the png_struct.\n363\t     */\n364\t    core::ptr::null_mut()\n365\t}\n366\t\n367\t/* Allocate the memory for an info_struct for the application. */\n368\t#[unsafe(no_mangle)]\n369\tpub unsafe extern \"C-unwind\" fn png_create_info_struct(png_ptr: png_const_structrp) -> png_infop {\n370\t    let info_ptr: png_inforp;\n371\t\n372\t    if png_ptr.is_null() {\n373\t        return core::ptr::null_mut();\n374\t    }\n375\t\n376\t    /* Use the internal API that does not (or at least should not) error out, so\n377\t     * that this call always returns ok.  The application typically sets up the\n378\t     * error handling *after* creating the info_struct because this is the way it\n379\t     * has always been done in 'example.c'.\n380\t     */\n381\t    info_ptr = png_malloc_base(png_ptr, core::mem::size_of::<png_info>()) as png_inforp;\n382\t\n383\t    if !info_ptr.is_null() {\n384\t        memset(info_ptr as *mut u8, 0, core::mem::size_of::<png_info>());\n385\t    }\n386\t\n387\t    info_ptr\n388\t}\n389\t\n390\t/* This function frees the memory associated with a single info struct.\n391\t * Normally, one would use either png_destroy_read_struct() or\n392\t * png_destroy_write_struct() to free an info struct, but this may be\n393\t * useful for some applications.  From libpng 1.6.0 this function is also used\n394\t * internally to implement the png_info release part of the 'struct' destroy\n395\t * APIs.  This ensures that all possible approaches free the same data (all of\n396\t * it).\n397\t */\n398\t#[unsafe(no_mangle)]\n399\tpub unsafe extern \"C-unwind\" fn png_destroy_info_struct(\n400\t    png_ptr: png_const_structrp,\n401\t    info_ptr_ptr: png_infopp,\n402\t) {\n403\t    let mut info_ptr: png_inforp = core::ptr::null_mut();\n404\t\n405\t    if png_ptr.is_null() {\n406\t        return;\n407\t    }\n408\t\n409\t    if !info_ptr_ptr.is_null() {\n410\t        info_ptr = *info_ptr_ptr;\n411\t    }\n412\t\n413\t    if !info_ptr.is_null() {\n414\t        /* Do this first in case of an error below; if the app implements its own\n415\t         * memory management this can lead to png_free calling png_error, which\n416\t         * will abort this routine and return control to the app error handler.\n417\t         * An infinite loop may result if it then tries to free the same info\n418\t         * ptr.\n419\t         */\n420\t        *info_ptr_ptr = core::ptr::null_mut();\n421\t\n422\t        png_free_data(png_ptr, info_ptr, PNG_FREE_ALL, -1);\n423\t        memset(info_ptr as *mut u8, 0, core::mem::size_of::<png_info>());\n424\t        png_free(png_ptr, info_ptr as png_voidp);\n425\t    }\n426\t}\n427\t\n428\t/* Initialize the info structure.  This is now an internal function (0.89)\n429\t * and applications using it are urged to use png_create_info_struct()\n430\t * instead.  Use deprecated in 1.6.0, internal use removed (used internally it\n431\t * is just a memset).\n432\t *\n433\t * NOTE: it is almost inconceivable that this API is used because it bypasses\n434\t * the user-memory mechanism and the user error handling/warning mechanisms in\n435\t * those cases where it does anything other than a memset.\n436\t */\n437\t#[unsafe(no_mangle)]\n438\tpub unsafe extern \"C-unwind\" fn png_info_init_3(\n439\t    ptr_ptr: png_infopp,\n440\t    png_info_struct_size: usize,\n441\t) {\n442\t    let mut info_ptr: png_inforp = *ptr_ptr;\n443\t\n444\t    if info_ptr.is_null() {\n445\t        return;\n446\t    }\n447\t\n448\t    if core::mem::size_of::<png_info>() > png_info_struct_size {\n449\t        *ptr_ptr = core::ptr::null_mut();\n450\t        /* The following line is why this API should not be used: */\n451\t        libc::free(info_ptr as *mut c_void);\n452\t        info_ptr = png_malloc_base(core::ptr::null_mut(), core::mem::size_of::<png_info>())\n453\t            as png_inforp;\n454\t        if info_ptr.is_null() {\n455\t            return;\n456\t        }\n457\t        *ptr_ptr = info_ptr;\n458\t    }\n459\t\n460\t    /* Set everything to 0 */\n461\t    memset(info_ptr as *mut u8, 0, core::mem::size_of::<png_info>());\n462\t}\n463\t\n464\t#[unsafe(no_mangle)]\n465\tpub unsafe extern \"C-unwind\" fn png_data_freer(\n466\t    png_ptr: png_const_structrp,\n467\t    info_ptr: png_inforp,\n468\t    freer: c_int,\n469\t    mask: png_uint_32,\n470\t) {\n471\t    if png_ptr.is_null() || info_ptr.is_null() {\n472\t        return;\n473\t    }\n474\t\n475\t    if freer == PNG_DESTROY_WILL_FREE_DATA {\n476\t        (*info_ptr).free_me |= mask;\n477\t    } else if freer == PNG_USER_WILL_FREE_DATA {\n478\t        (*info_ptr).free_me &= !mask;\n479\t    } else {\n480\t        png_error(\n481\t            png_ptr,\n482\t            c\"Unknown freer parameter in png_data_freer\".as_ptr(),\n483\t        );\n484\t    }\n485\t}\n486\t\n487\t#[unsafe(no_mangle)]\n488\tpub unsafe extern \"C-unwind\" fn png_free_data(\n489\t    png_ptr: png_const_structrp,\n490\t    info_ptr: png_inforp,\n491\t    mask: png_uint_32,\n492\t    num: c_int,\n493\t) {\n494\t    let mut mask = mask;\n495\t\n496\t    if png_ptr.is_null() || info_ptr.is_null() {\n497\t        return;\n498\t    }\n499\t\n500\t    /* Free text item num or (if num == -1) all text items */\n501\t    if !(*info_ptr).text.is_null() && ((mask & PNG_FREE_TEXT) & (*info_ptr).free_me) != 0 {\n502\t        if num != -1 {\n503\t            png_free(png_ptr, (*(*info_ptr).text.add(num as usize)).key as png_voidp);\n504\t            (*(*info_ptr).text.add(num as usize)).key = core::ptr::null_mut();\n505\t        } else {\n506\t            let mut i: c_int = 0;\n507\t\n508\t            while i < (*info_ptr).num_text {\n509\t                png_free(png_ptr, (*(*info_ptr).text.add(i as usize)).key as png_voidp);\n510\t                i += 1;\n511\t            }\n512\t\n513\t            png_free(png_ptr, (*info_ptr).text as png_voidp);\n514\t            (*info_ptr).text = core::ptr::null_mut();\n515\t            (*info_ptr).num_text = 0;\n516\t            (*info_ptr).max_text = 0;\n517\t        }\n518\t    }\n519\t\n520\t    /* Free any tRNS entry */\n521\t    if ((mask & PNG_FREE_TRNS) & (*info_ptr).free_me) != 0 {\n522\t        (*info_ptr).valid &= !PNG_INFO_tRNS;\n523\t        png_free(png_ptr, (*info_ptr).trans_alpha as png_voidp);\n524\t        (*info_ptr).trans_alpha = core::ptr::null_mut();\n525\t        (*info_ptr).num_trans = 0;\n526\t    }\n527\t\n528\t    /* Free any sCAL entry */\n529\t    if ((mask & PNG_FREE_SCAL) & (*info_ptr).free_me) != 0 {\n530\t        png_free(png_ptr, (*info_ptr).scal_s_width as png_voidp);\n531\t        png_free(png_ptr, (*info_ptr).scal_s_height as png_voidp);\n532\t        (*info_ptr).scal_s_width = core::ptr::null_mut();\n533\t        (*info_ptr).scal_s_height = core::ptr::null_mut();\n534\t        (*info_ptr).valid &= !PNG_INFO_sCAL;\n535\t    }\n536\t\n537\t    /* Free any pCAL entry */\n538\t    if ((mask & PNG_FREE_PCAL) & (*info_ptr).free_me) != 0 {\n539\t        png_free(png_ptr, (*info_ptr).pcal_purpose as png_voidp);\n540\t        png_free(png_ptr, (*info_ptr).pcal_units as png_voidp);\n541\t        (*info_ptr).pcal_purpose = core::ptr::null_mut();\n542\t        (*info_ptr).pcal_units = core::ptr::null_mut();\n543\t\n544\t        if !(*info_ptr).pcal_params.is_null() {\n545\t            let mut i: c_int = 0;\n546\t\n547\t            while i < (*info_ptr).pcal_nparams as c_int {\n548\t                png_free(png_ptr, *(*info_ptr).pcal_params.add(i as usize) as png_voidp);\n549\t                i += 1;\n550\t            }\n551\t\n552\t            png_free(png_ptr, (*info_ptr).pcal_params as png_voidp);\n553\t            (*info_ptr).pcal_params = core::ptr::null_mut();\n554\t        }\n555\t        (*info_ptr).valid &= !PNG_INFO_pCAL;\n556\t    }\n557\t\n558\t    /* Free any profile entry */\n559\t    if ((mask & PNG_FREE_ICCP) & (*info_ptr).free_me) != 0 {\n560\t        png_free(png_ptr, (*info_ptr).iccp_name as png_voidp);\n561\t        png_free(png_ptr, (*info_ptr).iccp_profile as png_voidp);\n562\t        (*info_ptr).iccp_name = core::ptr::null_mut();\n563\t        (*info_ptr).iccp_profile = core::ptr::null_mut();\n564\t        (*info_ptr).valid &= !PNG_INFO_iCCP;\n565\t    }\n566\t\n567\t    /* Free a given sPLT entry, or (if num == -1) all sPLT entries */\n568\t    if !(*info_ptr).splt_palettes.is_null()\n569\t        && ((mask & PNG_FREE_SPLT) & (*info_ptr).free_me) != 0\n570\t    {\n571\t        if num != -1 {\n572\t            png_free(\n573\t                png_ptr,\n574\t                (*(*info_ptr).splt_palettes.add(num as usize)).name as png_voidp,\n575\t            );\n576\t            png_free(\n577\t                png_ptr,\n578\t                (*(*info_ptr).splt_palettes.add(num as usize)).entries as png_voidp,\n579\t            );\n580\t            (*(*info_ptr).splt_palettes.add(num as usize)).name = core::ptr::null_mut();\n581\t            (*(*info_ptr).splt_palettes.add(num as usize)).entries = core::ptr::null_mut();\n582\t        } else {\n583\t            let mut i: c_int = 0;\n584\t\n585\t            while i < (*info_ptr).splt_palettes_num {\n586\t                png_free(\n587\t                    png_ptr,\n588\t                    (*(*info_ptr).splt_palettes.add(i as usize)).name as png_voidp,\n589\t                );\n590\t                png_free(\n591\t                    png_ptr,\n592\t                    (*(*info_ptr).splt_palettes.add(i as usize)).entries as png_voidp,\n593\t                );\n594\t                i += 1;\n595\t            }\n596\t\n597\t            png_free(png_ptr, (*info_ptr).splt_palettes as png_voidp);\n598\t            (*info_ptr).splt_palettes = core::ptr::null_mut();\n599\t            (*info_ptr).splt_palettes_num = 0;\n600\t            (*info_ptr).valid &= !PNG_INFO_sPLT;\n601\t        }\n602\t    }\n603\t\n604\t    if !(*info_ptr).unknown_chunks.is_null()\n605\t        && ((mask & PNG_FREE_UNKN) & (*info_ptr).free_me) != 0\n606\t    {\n607\t        if num != -1 {\n608\t            png_free(\n609\t                png_ptr,\n610\t                (*(*info_ptr).unknown_chunks.add(num as usize)).data as png_voidp,\n611\t            );\n612\t            (*(*info_ptr).unknown_chunks.add(num as usize)).data = core::ptr::null_mut();\n613\t        } else {\n614\t            let mut i: c_int = 0;\n615\t\n616\t            while i < (*info_ptr).unknown_chunks_num {\n617\t                png_free(\n618\t                    png_ptr,\n619\t                    (*(*info_ptr).unknown_chunks.add(i as usize)).data as png_voidp,\n620\t                );\n621\t                i += 1;\n622\t            }\n623\t\n624\t            png_free(png_ptr, (*info_ptr).unknown_chunks as png_voidp);\n625\t            (*info_ptr).unknown_chunks = core::ptr::null_mut();\n626\t            (*info_ptr).unknown_chunks_num = 0;\n627\t        }\n628\t    }\n629\t\n630\t    /* Free any eXIf entry */\n631\t    if ((mask & PNG_FREE_EXIF) & (*info_ptr).free_me) != 0 {\n632\t        if !(*info_ptr).exif.is_null() {\n633\t            png_free(png_ptr, (*info_ptr).exif as png_voidp);\n634\t            (*info_ptr).exif = core::ptr::null_mut();\n635\t        }\n636\t        (*info_ptr).valid &= !PNG_INFO_eXIf;\n637\t    }\n638\t\n639\t    /* Free any hIST entry */\n640\t    if ((mask & PNG_FREE_HIST) & (*info_ptr).free_me) != 0 {\n641\t        png_free(png_ptr, (*info_ptr).hist as png_voidp);\n642\t        (*info_ptr).hist = core::ptr::null_mut();\n643\t        (*info_ptr).valid &= !PNG_INFO_hIST;\n644\t    }\n645\t\n646\t    /* Free any PLTE entry that was internally allocated */\n647\t    if ((mask & PNG_FREE_PLTE) & (*info_ptr).free_me) != 0 {\n648\t        png_free(png_ptr, (*info_ptr).palette as png_voidp);\n649\t        (*info_ptr).palette = core::ptr::null_mut();\n650\t        (*info_ptr).valid &= !PNG_INFO_PLTE;\n651\t        (*info_ptr).num_palette = 0;\n652\t    }\n653\t\n654\t    /* Free any image bits attached to the info structure */\n655\t    if ((mask & PNG_FREE_ROWS) & (*info_ptr).free_me) != 0 {\n656\t        if !(*info_ptr).row_pointers.is_null() {\n657\t            let mut row: png_uint_32 = 0;\n658\t            while row < (*info_ptr).height {\n659\t                png_free(\n660\t                    png_ptr,\n661\t                    *(*info_ptr).row_pointers.add(row as usize) as png_voidp,\n662\t                );\n663\t                row += 1;\n664\t            }\n665\t\n666\t            png_free(png_ptr, (*info_ptr).row_pointers as png_voidp);\n667\t            (*info_ptr).row_pointers = core::ptr::null_mut();\n668\t        }\n669\t        (*info_ptr).valid &= !PNG_INFO_IDAT;\n670\t    }\n671\t\n672\t    if num != -1 {\n673\t        mask &= !PNG_FREE_MUL;\n674\t    }\n675\t\n676\t    (*info_ptr).free_me &= !mask;\n677\t}\n678\t\n679\t/* This function returns a pointer to the io_ptr associated with the user\n680\t * functions.  The application should free any memory associated with this\n681\t * pointer before png_write_destroy() or png_read_destroy() are called.\n682\t */\n683\t#[unsafe(no_mangle)]\n684\tpub unsafe extern \"C-unwind\" fn png_get_io_ptr(png_ptr: png_const_structrp) -> png_voidp {\n685\t    if png_ptr.is_null() {\n686\t        return core::ptr::null_mut();\n687\t    }\n688\t\n689\t    (*png_ptr).io_ptr\n690\t}\n691\t\n692\t/* Initialize the default input/output functions for the PNG file.  If you\n693\t * use your own read or write routines, you can call either png_set_read_fn()\n694\t * or png_set_write_fn() instead of png_init_io().  If you have defined\n695\t * PNG_NO_STDIO or otherwise disabled PNG_STDIO_SUPPORTED, you must use a\n696\t * function of your own because \"FILE *\" isn't necessarily available.\n697\t */\n698\t#[unsafe(no_mangle)]\n699\tpub unsafe extern \"C-unwind\" fn png_init_io(png_ptr: png_structrp, fp: *mut libc::FILE) {\n700\t    if png_ptr.is_null() {\n701\t        return;\n702\t    }\n703\t\n704\t    (*png_ptr).io_ptr = fp as png_voidp;\n705\t}\n706\t\n707\t/* PNG signed integers are saved in 32-bit 2's complement format.  ANSI C-90\n708\t * defines a cast of a signed integer to an unsigned integer either to preserve\n709\t * the value, if it is positive, or to calculate:\n710\t *\n711\t *     (UNSIGNED_MAX+1) + integer\n712\t *\n713\t * Where UNSIGNED_MAX is the appropriate maximum unsigned value, so when the\n714\t * negative integral value is added the result will be an unsigned value\n715\t * corresponding to the 2's complement representation.\n716\t */\n717\t#[unsafe(no_mangle)]\n718\tpub unsafe extern \"C-unwind\" fn png_save_int_32(buf: png_bytep, i: png_int_32) {\n719\t    png_save_uint_32(buf, i as png_uint_32);\n720\t}\n721\t\n722\t/* Convert the supplied time into an RFC 1123 string suitable for use in\n723\t * a \"Creation Time\" or other text-based time string.\n724\t */\n725\t#[unsafe(no_mangle)]\n726\tpub unsafe extern \"C-unwind\" fn png_convert_to_rfc1123_buffer(\n727\t    out: *mut c_char,\n728\t    ptime: png_const_timep,\n729\t) -> c_int {\n730\t    static short_months: [&[u8; 4]; 12] = [\n731\t        b\"Jan\\0\", b\"Feb\\0\", b\"Mar\\0\", b\"Apr\\0\", b\"May\\0\", b\"Jun\\0\", b\"Jul\\0\", b\"Aug\\0\", b\"Sep\\0\",\n732\t        b\"Oct\\0\", b\"Nov\\0\", b\"Dec\\0\",\n733\t    ];\n734\t\n735\t    if out.is_null() {\n736\t        return 0;\n737\t    }\n738\t\n739\t    if (*ptime).year > 9999 /* RFC1123 limitation */\n740\t        || (*ptime).month == 0\n741\t        || (*ptime).month > 12\n742\t        || (*ptime).day == 0\n743\t        || (*ptime).day > 31\n744\t        || (*ptime).hour > 23\n745\t        || (*ptime).minute > 59\n746\t        || (*ptime).second > 60\n747\t    {\n748\t        return 0;\n749\t    }\n750\t\n751\t    {\n752\t        let mut pos: usize = 0;\n753\t        let mut number_buf: [c_char; 5] = [0, 0, 0, 0, 0]; /* enough for a four-digit year */\n754\t\n755\t        /* APPEND_NUMBER(PNG_NUMBER_FORMAT_u, (unsigned)ptime->day); */\n756\t        pos = png_safecat(\n757\t            out,\n758\t            29,\n759\t            pos,\n760\t            png_format_number(\n761\t                number_buf.as_ptr(),\n762\t                number_buf.as_mut_ptr().add(5),\n763\t                PNG_NUMBER_FORMAT_u,\n764\t                (*ptime).day as c_uint as png_alloc_size_t,\n765\t            ),\n766\t        );\n767\t\n768\t        /* APPEND(' '); */\n769\t        if pos < 28 {\n770\t            *out.add(pos) = b' ' as c_char;\n771\t            pos += 1;\n772\t        }\n773\t\n774\t        /* APPEND_STRING(short_months[(ptime->month - 1)]); */\n775\t        pos = png_safecat(\n776\t            out,\n777\t            29,\n778\t            pos,\n779\t            short_months[((*ptime).month - 1) as usize].as_ptr() as png_const_charp,\n780\t        );\n781\t\n782\t        /* APPEND(' '); */\n783\t        if pos < 28 {\n784\t            *out.add(pos) = b' ' as c_char;\n785\t            pos += 1;\n786\t        }\n787\t\n788\t        /* APPEND_NUMBER(PNG_NUMBER_FORMAT_u, ptime->year); */\n789\t        pos = png_safecat(\n790\t            out,\n791\t            29,\n792\t            pos,\n793\t            png_format_number(\n794\t                number_buf.as_ptr(),\n795\t                number_buf.as_mut_ptr().add(5),\n796\t                PNG_NUMBER_FORMAT_u,\n797\t                (*ptime).year as png_alloc_size_t,\n798\t            ),\n799\t        );\n800\t\n801\t        /* APPEND(' '); */\n802\t        if pos < 28 {\n803\t            *out.add(pos) = b' ' as c_char;\n804\t            pos += 1;\n805\t        }\n806\t\n807\t        /* APPEND_NUMBER(PNG_NUMBER_FORMAT_02u, (unsigned)ptime->hour); */\n808\t        pos = png_safecat(\n809\t            out,\n810\t            29,\n811\t            pos,\n812\t            png_format_number(\n813\t                number_buf.as_ptr(),\n814\t                number_buf.as_mut_ptr().add(5),\n815\t                PNG_NUMBER_FORMAT_02u,\n816\t                (*ptime).hour as c_uint as png_alloc_size_t,\n817\t            ),\n818\t        );\n819\t\n820\t        /* APPEND(':'); */\n821\t        if pos < 28 {\n822\t            *out.add(pos) = b':' as c_char;\n823\t            pos += 1;\n824\t        }\n825\t\n826\t        /* APPEND_NUMBER(PNG_NUMBER_FORMAT_02u, (unsigned)ptime->minute); */\n827\t        pos = png_safecat(\n828\t            out,\n829\t            29,\n830\t            pos,\n831\t            png_format_number(\n832\t                number_buf.as_ptr(),\n833\t                number_buf.as_mut_ptr().add(5),\n834\t                PNG_NUMBER_FORMAT_02u,\n835\t                (*ptime).minute as c_uint as png_alloc_size_t,\n836\t            ),\n837\t        );\n838\t\n839\t        /* APPEND(':'); */\n840\t        if pos < 28 {\n841\t            *out.add(pos) = b':' as c_char;\n842\t            pos += 1;\n843\t        }\n844\t\n845\t        /* APPEND_NUMBER(PNG_NUMBER_FORMAT_02u, (unsigned)ptime->second); */\n846\t        pos = png_safecat(\n847\t            out,\n848\t            29,\n849\t            pos,\n850\t            png_format_number(\n851\t                number_buf.as_ptr(),\n852\t                number_buf.as_mut_ptr().add(5),\n853\t                PNG_NUMBER_FORMAT_02u,\n854\t                (*ptime).second as c_uint as png_alloc_size_t,\n855\t            ),\n856\t        );\n857\t\n858\t        /* APPEND_STRING(\" +0000\"); This reliably terminates the buffer */\n859\t        pos = png_safecat(out, 29, pos, c\" +0000\".as_ptr());\n860\t    }\n861\t\n862\t    1\n863\t}\n864\t\n865\t/* To do: remove the following from libpng-1.7 */\n866\t/* Original API that uses a private buffer in png_struct.\n867\t * Deprecated because it causes png_struct to carry a spurious temporary\n868\t * buffer (png_struct::time_buffer), better to have the caller pass this in.\n869\t */\n870\t#[unsafe(no_mangle)]\n871\tpub unsafe extern \"C-unwind\" fn png_convert_to_rfc1123(\n872\t    png_ptr: png_structrp,\n873\t    ptime: png_const_timep,\n874\t) -> png_const_charp {\n875\t    if !png_ptr.is_null() {\n876\t        /* The only failure above if png_ptr != NULL is from an invalid ptime */\n877\t        if png_convert_to_rfc1123_buffer(\n878\t            core::ptr::addr_of_mut!((*png_ptr).time_buffer) as *mut c_char,\n879\t            ptime,\n880\t        ) == 0\n881\t        {\n882\t            png_warning(png_ptr, c\"Ignoring invalid time value\".as_ptr());\n883\t        } else {\n884\t            return core::ptr::addr_of!((*png_ptr).time_buffer) as png_const_charp;\n885\t        }\n886\t    }\n887\t\n888\t    core::ptr::null()\n889\t}\n890\t\n891\t#[unsafe(no_mangle)]\n892\tpub unsafe extern \"C-unwind\" fn png_get_copyright(png_ptr: png_const_structrp) -> png_const_charp {\n893\t    c\"\\nlibpng version 1.6.59.git\\nCopyright (c) 2018-2026 Cosmin Truta\\nCopyright (c) 1998-2002,2004,2006-2018 Glenn Randers-Pehrson\\nCopyright (c) 1996-1997 Andreas Dilger\\nCopyright (c) 1995-1996 Guy Eric Schalnat, Group 42, Inc.\\n\".as_ptr()\n894\t}\n895\t\n896\t/* The following return the library version as a short string in the\n897\t * format 1.0.0 through 99.99.99zz.  To get the version of *.h files\n898\t * used with your application, print out PNG_LIBPNG_VER_STRING, which\n899\t * is defined in png.h.\n900\t * Note: now there is no difference between png_get_libpng_ver() and\n901\t * png_get_header_ver().  Due to the version_nn_nn_nn typedef guard,\n902\t * it is guaranteed that png.c uses the correct version of png.h.\n903\t */\n904\t#[unsafe(no_mangle)]\n905\tpub unsafe extern \"C-unwind\" fn png_get_libpng_ver(png_ptr: png_const_structrp) -> png_const_charp {\n906\t    /* Version of *.c files used when building libpng */\n907\t    png_get_header_ver(png_ptr)\n908\t}\n909\t\n910\t#[unsafe(no_mangle)]\n911\tpub unsafe extern \"C-unwind\" fn png_get_header_ver(png_ptr: png_const_structrp) -> png_const_charp {\n912\t    /* Version of *.h files used when building libpng */\n913\t    c\"1.6.59.git\".as_ptr()\n914\t}\n915\t\n916\t#[unsafe(no_mangle)]\n917\tpub unsafe extern \"C-unwind\" fn png_get_header_version(\n918\t    png_ptr: png_const_structrp,\n919\t) -> png_const_charp {\n920\t    /* Returns longer string containing both version and date */\n921\t    /* PNG_HEADER_VERSION_STRING PNG_STRING_NEWLINE */\n922\t    c\" libpng version 1.6.59.git\\n\\n\".as_ptr()\n923\t}\n924\t\n925\t/* NOTE: this routine is not used internally! */\n926\t/* Build a grayscale palette.  Palette is assumed to be 1 << bit_depth\n927\t * large of png_color.  This lets grayscale images be treated as\n928\t * paletted.  Most useful for gamma correction and simplification\n929\t * of code.  This API is not used internally.\n930\t */\n931\t#[unsafe(no_mangle)]\n932\tpub unsafe extern \"C-unwind\" fn png_build_grayscale_palette(\n933\t    bit_depth: c_int,\n934\t    palette: png_colorp,\n935\t) {\n936\t    let num_palette: c_int;\n937\t    let color_inc: c_int;\n938\t    let mut i: c_int;\n939\t    let mut v: c_int;\n940\t\n941\t    if palette.is_null() {\n942\t        return;\n943\t    }\n944\t\n945\t    match bit_depth {\n946\t        1 => {\n947\t            num_palette = 2;\n948\t            color_inc = 0xff;\n949\t        }\n950\t\n951\t        2 => {\n952\t            num_palette = 4;\n953\t            color_inc = 0x55;\n954\t        }\n955\t\n956\t        4 => {\n957\t            num_palette = 16;\n958\t            color_inc = 0x11;\n959\t        }\n960\t\n961\t        8 => {\n962\t            num_palette = 256;\n963\t            color_inc = 1;\n964\t        }\n965\t\n966\t        _ => {\n967\t            num_palette = 0;\n968\t            color_inc = 0;\n969\t        }\n970\t    }\n971\t\n972\t    i = 0;\n973\t    v = 0;\n974\t    while i < num_palette {\n975\t        (*palette.add(i as usize)).red = (v & 0xff) as png_byte;\n976\t        (*palette.add(i as usize)).green = (v & 0xff) as png_byte;\n977\t        (*palette.add(i as usize)).blue = (v & 0xff) as png_byte;\n978\t        i += 1;\n979\t        v += color_inc;\n980\t    }\n981\t}\n982\t\n983\t#[unsafe(no_mangle)]\n984\tpub unsafe extern \"C-unwind\" fn png_handle_as_unknown(\n985\t    png_ptr: png_const_structrp,\n986\t    chunk_name: png_const_bytep,\n987\t) -> c_int {\n988\t    /* Check chunk_name and return \"keep\" value if it's on the list, else 0 */\n989\t    let mut p: png_const_bytep;\n990\t    let p_end: png_const_bytep;\n991\t\n992\t    if png_ptr.is_null() || chunk_name.is_null() || (*png_ptr).num_chunk_list == 0 {\n993\t        return PNG_HANDLE_CHUNK_AS_DEFAULT;\n994\t    }\n995\t\n996\t    p_end = (*png_ptr).chunk_list;\n997\t    p = p_end.add((*png_ptr).num_chunk_list.wrapping_mul(5) as usize); /* beyond end */\n998\t\n999\t    /* The code is the fifth byte after each four byte string.  Historically this\n1000\t     * code was always searched from the end of the list, this is no longer\n1001\t     * necessary because the 'set' routine handles duplicate entries correctly.\n1002\t     */\n1003\t    loop\n1004\t    /* num_chunk_list > 0, so at least one */\n1005\t    {\n1006\t        p = p.sub(5);\n1007\t\n1008\t        if memcmp(chunk_name, p, 4) == 0 {\n1009\t            return *p.add(4) as c_int;\n1010\t        }\n1011\t\n1012\t        if !((p as usize) > (p_end as usize)) {\n1013\t            break;\n1014\t        }\n1015\t    }\n1016\t\n1017\t    /* This means that known chunks should be processed and unknown chunks should\n1018\t     * be handled according to the value of png_ptr->unknown_default; this can be\n1019\t     * confusing because, as a result, there are two levels of defaulting for\n1020\t     * unknown chunks.\n1021\t     */\n1022\t    PNG_HANDLE_CHUNK_AS_DEFAULT\n1023\t}\n1024\t\n1025\t#[unsafe(no_mangle)]\n1026\tpub unsafe extern \"C-unwind\" fn png_chunk_unknown_handling(\n1027\t    png_ptr: png_const_structrp,\n1028\t    chunk_name: png_uint_32,\n1029\t) -> c_int {\n1030\t    let mut chunk_string: [png_byte; 5] = [0; 5];\n1031\t\n1032\t    PNG_CSTRING_FROM_CHUNK(chunk_string.as_mut_ptr() as *mut c_char, chunk_name);\n1033\t    png_handle_as_unknown(png_ptr, chunk_string.as_ptr())\n1034\t}\n1035\t\n1036\t/* This function, added to libpng-1.0.6g, is untested. */\n1037\t#[unsafe(no_mangle)]\n1038\tpub unsafe extern \"C-unwind\" fn png_reset_zstream(png_ptr: png_structrp) -> c_int {\n1039\t    if png_ptr.is_null() {\n1040\t        return Z_STREAM_ERROR;\n1041\t    }\n1042\t\n1043\t    /* WARNING: this resets the window bits to the maximum! */\n1044\t    inflateReset(core::ptr::addr_of_mut!((*png_ptr).zstream))\n1045\t}\n1046\t\n1047\t/* This function was added to libpng-1.0.7 */\n1048\t#[unsafe(no_mangle)]\n1049\tpub unsafe extern \"C-unwind\" fn png_access_version_number() -> png_uint_32 {\n1050\t    /* Version of *.c files used when building libpng */\n1051\t    PNG_LIBPNG_VER as png_uint_32\n1052\t}\n1053\t\n1054\t/* Ensure that png_ptr->zstream.msg holds some appropriate error message string.\n1055\t * If it doesn't 'ret' is used to set it to something appropriate, even in cases\n1056\t * like Z_OK or Z_STREAM_END where the error code is apparently a success code.\n1057\t */\n1058\t#[unsafe(no_mangle)]\n1059\tpub unsafe extern \"C-unwind\" fn png_zstream_error(png_ptr: png_structrp, ret: c_int) {\n1060\t    /* Translate 'ret' into an appropriate error string, priority is given to the\n1061\t     * one in zstream if set.  This always returns a string, even in cases like\n1062\t     * Z_OK or Z_STREAM_END where the error code is a success code.\n1063\t     */\n1064\t    if (*png_ptr).zstream.msg.is_null() {\n1065\t        match ret {\n1066\t            Z_STREAM_END => {\n1067\t                /* Normal exit */\n1068\t                (*png_ptr).zstream.msg = c\"unexpected end of LZ stream\".as_ptr();\n1069\t            }\n1070\t\n1071\t            Z_NEED_DICT => {\n1072\t                /* This means the deflate stream did not have a dictionary; this\n1073\t                 * indicates a bogus PNG.\n1074\t                 */\n1075\t                (*png_ptr).zstream.msg = c\"missing LZ dictionary\".as_ptr();\n1076\t            }\n1077\t\n1078\t            Z_ERRNO => {\n1079\t                /* gz APIs only: should not happen */\n1080\t                (*png_ptr).zstream.msg = c\"zlib IO error\".as_ptr();\n1081\t            }\n1082\t\n1083\t            Z_STREAM_ERROR => {\n1084\t                /* internal libpng error */\n1085\t                (*png_ptr).zstream.msg = c\"bad parameters to zlib\".as_ptr();\n1086\t            }\n1087\t\n1088\t            Z_DATA_ERROR => {\n1089\t                (*png_ptr).zstream.msg = c\"damaged LZ stream\".as_ptr();\n1090\t            }\n1091\t\n1092\t            Z_MEM_ERROR => {\n1093\t                (*png_ptr).zstream.msg = c\"insufficient memory\".as_ptr();\n1094\t            }\n1095\t\n1096\t            Z_BUF_ERROR => {\n1097\t                /* End of input or output; not a problem if the caller is doing\n1098\t                 * incremental read or write.\n1099\t                 */\n1100\t                (*png_ptr).zstream.msg = c\"truncated\".as_ptr();\n1101\t            }\n1102\t\n1103\t            Z_VERSION_ERROR => {\n1104\t                (*png_ptr).zstream.msg = c\"unsupported zlib version\".as_ptr();\n1105\t            }\n1106\t\n1107\t            PNG_UNEXPECTED_ZLIB_RETURN => {\n1108\t                /* Compile errors here mean that zlib now uses the value co-opted in\n1109\t                 * pngpriv.h for PNG_UNEXPECTED_ZLIB_RETURN; update the switch above\n1110\t                 * and change pngpriv.h.  Note that this message is \"... return\",\n1111\t                 * whereas the default/Z_OK one is \"... return code\".\n1112\t                 */\n1113\t                (*png_ptr).zstream.msg = c\"unexpected zlib return\".as_ptr();\n1114\t            }\n1115\t\n1116\t            /* default: and case Z_OK: */\n1117\t            _ => {\n1118\t                (*png_ptr).zstream.msg = c\"unexpected zlib return code\".as_ptr();\n1119\t            }\n1120\t        }\n1121\t    }\n1122\t}\n1123\t"}]},"parent_tool_use_id":"toolu_bdrk_01Y7Q3tof4WQzU724AENz3JX","session_id":"a9a0a7d5-d080-4cce-a91d-7cd01f6e0204","uuid":"cdbb67dc-9187-4ba1-b6d2-97a3218d4122","timestamp":"2026-08-22T14:41:48.294Z","subagent_type":"general-purpose","task_description":"Translate pngpread.c"}
