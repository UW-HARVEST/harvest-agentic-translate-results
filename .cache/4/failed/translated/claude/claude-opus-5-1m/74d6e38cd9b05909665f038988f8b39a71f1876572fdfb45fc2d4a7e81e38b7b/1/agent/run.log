\n554\tpub unsafe extern \"C-unwind\" fn png_longjmp(png_ptr: png_const_structrp, val: c_int) -> ! {\n555\t    if !png_ptr.is_null() {\n556\t        if let Some(f) = (*png_ptr).longjmp_fn {\n557\t            if !(*png_ptr).jmp_buf_ptr.is_null() {\n558\t                f((*png_ptr).jmp_buf_ptr, val);\n559\t            }\n560\t        }\n561\t    }\n562\t\n563\t    /* If control reaches this point, png_longjmp() must not return. */\n564\t    libc::abort();\n565\t}\n566\t\n567\tunsafe fn png_default_warning(_png_ptr: png_const_structrp, warning_message: png_const_charp) {\n568\t    libc::fputs(c\"libpng warning: \".as_ptr(), png_stderr());\n569\t    libc::fputs(warning_message, png_stderr());\n570\t    libc::fputs(c\"\\n\".as_ptr(), png_stderr());\n571\t}\n572\t\n573\t#[unsafe(no_mangle)]\n574\tpub unsafe extern \"C-unwind\" fn png_set_error_fn(\n575\t    png_ptr: png_structrp,\n576\t    error_ptr: png_voidp,\n577\t    error_fn: png_error_ptr,\n578\t    warning_fn: png_error_ptr,\n579\t) {\n580\t    if png_ptr.is_null() {\n581\t        return;\n582\t    }\n583\t\n584\t    (*png_ptr).error_ptr = error_ptr;\n585\t    (*png_ptr).error_fn = error_fn;\n586\t    (*png_ptr).warning_fn = warning_fn;\n587\t}\n588\t\n589\t#[unsafe(no_mangle)]\n590\tpub unsafe extern \"C-unwind\" fn png_get_error_ptr(png_ptr: png_const_structrp) -> png_voidp {\n591\t    if png_ptr.is_null() {\n592\t        return core::ptr::null_mut();\n593\t    }\n594\t\n595\t    (*png_ptr).error_ptr\n596\t}\n597\t\n598\t#[unsafe(no_mangle)]\n599\tpub unsafe extern \"C-unwind\" fn png_safe_error(\n600\t    png_nonconst_ptr: png_structp,\n601\t    error_message: png_const_charp,\n602\t) {\n603\t    let png_ptr = png_nonconst_ptr;\n604\t    let image = (*png_ptr).error_ptr as png_imagep;\n605\t\n606\t    /* An error is always logged here, overwriting anything (typically a\n607\t     * warning) that is already there:\n608\t     */\n609\t    if !image.is_null() {\n610\t        png_safecat(\n611\t            (*image)