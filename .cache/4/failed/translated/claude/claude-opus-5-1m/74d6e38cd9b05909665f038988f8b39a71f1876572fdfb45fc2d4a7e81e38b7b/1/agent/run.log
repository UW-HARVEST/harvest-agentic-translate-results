ng_ptr).chunk_name != 0 {\n            png_chunk_error(png_ptr, error_message);\n        } else {\n            png_error(png_ptr, error_message);\n        }\n    }\n}\n---\n\n    if check != length {\n        png_error(png_ptr, c\"Write Error\".as_ptr());\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C-unwind\" fn png_flush(png_ptr: png_structrp) {\n    if let Some(f) = (*png_ptr).output_flush_fn {\n        f(png_ptr);\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C-unwind\" fn png_default_flush(png_ptr: png_structp) {\n    if png_ptr.is_null() {\n        return;\n    }\n\n    let io_ptr = (*png_ptr).io_ptr as *mut libc::FILE;\n    libc::fflush(io_ptr);","is_error":false}]},"parent_tool_use_id":"toolu_bdrk_01P91Ffd2Gst2nNcxmbU4s7z","session_id":"a9a0a7d5-d080-4cce-a91d-7cd01f6e0204","uuid":"51e6ff98-4df3-4828-b8bf-627d9a376ee7","timestamp":"2026-08-22T15:27:47.368Z","subagent_type":"general-purpose","task_description":"Translate pngwrite.c part 1"}
