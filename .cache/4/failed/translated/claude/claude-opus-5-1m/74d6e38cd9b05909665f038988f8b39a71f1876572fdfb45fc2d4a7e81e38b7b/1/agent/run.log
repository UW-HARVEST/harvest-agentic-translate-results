\n326\tpub fn PNG_IMAGE_SAMPLE_SIZE(fmt: png_uint_32) -> png_uint_32 {\n327\t    PNG_IMAGE_SAMPLE_CHANNELS(fmt) * PNG_IMAGE_SAMPLE_COMPONENT_SIZE(fmt)\n328\t}\n329\t#[inline]\n330\tpub fn PNG_IMAGE_MAXIMUM_COLORMAP_COMPONENTS(fmt: png_uint_32) -> png_uint_32 {\n331\t    PNG_IMAGE_SAMPLE_CHANNELS(fmt) * 256\n332\t}\n333\t#[inline]\n334\tpub fn PNG_IMAGE_PIXEL_CHANNELS(fmt: png_uint_32) -> png_uint_32 {\n335\t    if (fmt & PNG_FORMAT_FLAG_COLORMAP) != 0 {\n336\t        1\n337\t    } else {\n338\t        PNG_IMAGE_SAMPLE_CHANNELS(fmt)\n339\t    }\n340\t}\n341\t#[inline]\n342\tpub fn PNG_IMAGE_PIXEL_COMPONENT_SIZE(fmt: png_uint_32) -> png_uint_32 {\n343\t    if (fmt & PNG_FORMAT_FLAG_COLORMAP) != 0 {\n344\t        1\n345\t    } else {\n346\t        PNG_IMAGE_SAMPLE_COMPONENT_SIZE(fmt)\n347\t    }\n348\t}\n349\t#[inline]\n350\tpub fn PNG_IMAGE_PIXEL_SIZE(fmt: png_uint_32) -> png_uint_32 {\n351\t    if (fmt & PNG_FORMAT_FLAG_COLORMAP) != 0 {\n352\t        1\n353\t    } else {\n354\t        PNG_IMAGE_SAMPLE_SIZE(fmt)\n355\t    }\n356\t}\n357\t\n358\t/* ----------------------------------------------------- pngpriv.h: modes */\n359\t\n360\tpub const PNG_HAVE_IHDR: png_uint_32 = 0x01;\n361\tpub const PNG_HAVE_PLTE: png_uint_32 = 0x02;\n362\tpub const PNG_HAVE_IDAT: png_uint_32 = 0x04;\n363\tpub const PNG_AFTER_IDAT: png_uint_32 = 0x08;\n364\tpub const PNG_HAVE_IEND: png_uint_32 = 0x10;\n365\tpub const PNG_HAVE_CHUNK_HEADER: png_uint_32 = 0x100;\n366\tpub const PNG_WROTE_tIME: png_uint_32 = 0x200;\n367\tpub const PNG_WROTE_INFO_BEFORE_PLTE: png_uint_32 = 0x400;\n368\tpub const PNG_BACKGROUND_IS_GRAY: png_uint_32 = 0x800;\n369\tpub const PNG_HAVE_PNG_SIGNATURE: png_uint_32 = 0x1000;\n370\tpub const PNG_HAVE_CHUNK_AFTER_IDAT: png_uint_32 = 0x2000;\n371\tpub const PNG_WROTE_eXIf: png_uint_32 = 0x4000;\n372\tpub const PNG_IS_READ_STRUCT: png_uint_32 = 0x8000;\n373\t\n374\t/* Transformations */\n375\tpub const PNG_BGR: png_uint_32 = 0x0001;\n376\tpub const PNG_INTERLACE: png_uint_3