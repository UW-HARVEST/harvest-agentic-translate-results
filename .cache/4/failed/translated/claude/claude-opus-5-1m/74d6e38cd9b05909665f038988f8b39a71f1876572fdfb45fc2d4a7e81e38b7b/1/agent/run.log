,64) != 0) { ++fails; printf(\"FX MISMATCH v=%d  C='%s' RUST='%s'\\n\", v, a, b); }\n}\n\nint main(void)\n{\n   /* png_ascii_from_fp over a wide range of magnitudes and precisions */\n   double vals[] = {0.0, 1.0, -1.0, 0.5, -0.5, 0.1, 0.01, 0.001, 0.0001,\n      1e-5, 9.999999999, 0.9999999999, 123456789.0, 1234567890123.0,\n      3.14159265358979, 2.718281828459045, 1e300, 1e-300, 1e-310, 1e308,\n      1.0/3.0, 2.0/3.0, 1e-4, 99999.5, 100000.0, 0.000999999999,\n      -0.000999999999, 65535.0, 1.0/255.0, 1.0/65535.0, 0.45455, 2.2,\n      1e10, 1e-10, 5e-324, 1.7976931348623157e308,\n      0.0000001, 9.99999999999999e-5, 1e-3-1e-19, 1e100, 1e-100};\n   size_t nv = sizeof vals/sizeof vals[0];\n   for (size_t k=0;k<nv;k++)\n      for (unsigned int p=0;p<=18;p++) { cmp_fp(vals[k],p); cmp_fp(-vals[k],p); }\n\n   /* inf/nan */\n   cmp_fp(1.0/0.0, 5); cmp_fp(-1.0/0.0, 5);\n\n   /* pseudo-random doubles */\n   srand(12345);\n   for (int n=0;n<400000;n++)\n   {\n      double m = (double)rand()/(double)RAND_MAX;\n      int e = (rand()%620)-310;\n      double v = m * pow(10.0, e);\n      if (rand()&1) v = -v;\n      cmp_fp(v, (unsigned)(rand()%19));\n   }\n\n   /* png_ascii_from_fixed exhaustive-ish */\n   int fx[] = {0,1,-1,5,-5,10,99999,100000,-100000,100001,2147483647,\n      -2147483647, (-2147483647-1), 12345, -12345, 50000, 45455, 220000,\n      1, 9, 10, 100, 1000, 10000, 99998, 300000, 1000000};\n   for (size_t k=0;k<sizeof fx/sizeof fx[0];k++) cmp_fx(fx[k]);\n   for (int n=0;n<400000;n++) { int v = (rand()<<16)^rand(); if(rand()&1) v=-v; cmp_fx(v); }\n\n   /* png_check_fp_string */\n   const char *strs[] = {\"\", \"0\", \"-0\", \"+1\", \"1.5\", \".5\", \"5.\", \"1e5\", \"1E-5\",\n      \"1.5e+3\", \"..\", \"1..2\", \"e5\", \".e5\", \"-\", \"+\", \"1e\", \"1e+\", \"abc\",\n      \"0.0000\", \"12345678901234567890\", \"1.2.3\", \"1e5e5\", \" 1\", \"1 \", \"-.5e-5\"};\n   for (size_t k=0;k<sizeof strs/sizeof strs[0];k++)\n   {\n      int r = png_check_fp_string(strs[k],