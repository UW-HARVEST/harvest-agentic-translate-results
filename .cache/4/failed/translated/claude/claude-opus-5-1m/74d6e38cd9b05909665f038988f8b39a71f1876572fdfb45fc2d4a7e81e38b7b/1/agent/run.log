ese (unused but exported) functions.\n46\t */\n47\t\n48\t/* Grab an unsigned 32-bit integer from a buffer in big-endian format. */\n49\t#[unsafe(no_mangle)]\n50\tpub unsafe extern \"C-unwind\" fn png_get_uint_32(buf: png_const_bytep) -> png_uint_32 {\n51\t    let uval: png_uint_32 = (((*buf) as png_uint_32) << 24)\n52\t        .wrapping_add(((*buf.add(1)) as png_uint_32) << 16)\n53\t        .wrapping_add(((*buf.add(2)) as png_uint_32) << 8)\n54\t        .wrapping_add((*buf.add(3)) as png_uint_32);\n55\t\n56\t    uval\n57\t}\n58\t\n59\t/* Grab a signed 32-bit integer from a buffer in big-endian format.  The\n60\t * data is stored in the PNG file in two's complement format and there\n61\t * is no guarantee that a 'png_int_32' is exactly 32 bits, therefore\n62\t * the following code does a two's complement to native conversion.\n63\t */\n64\t#[unsafe(no_mangle)]\n65\tpub unsafe extern \"C-unwind\" fn png_get_int_32(buf: png_const_bytep) -> png_int_32 {\n66\t    let mut uval: png_uint_32 = PNG_get_uint_32(buf);\n67\t    if (uval & 0x80000000u32) == 0\n68\t    /* non-negative */\n69\t    {\n70\t        return uval as png_int_32;\n71\t    }\n72\t\n73\t    uval = (uval ^ 0xffffffffu32).wrapping_add(1); /* 2's complement: -x = ~x+1 */\n74\t    if (uval & 0x80000000u32) == 0\n75\t    /* no overflow */\n76\t    {\n77\t        return (uval as png_int_32).wrapping_neg();\n78\t    }\n79\t    /* The following has to be safe; this function only gets called on PNG data\n80\t     * and if we get here that data is invalid.  0 is the most safe value and\n81\t     * if not then an attacker would surely just generate a PNG with 0 instead.\n82\t     */\n83\t    0\n84\t}\n85\t\n86\t/* Grab an unsigned 16-bit integer from a buffer in big-endian format. */\n87\t#[unsafe(no_mangle)]\n88\tpub unsafe extern \"C-unwind\" fn png_get_uint_16(buf: png_const_bytep) -> png_uint_16 {\n89\t    /* ANSI-C requires an int value to accommodate at least 16 bits so this\n90\t     * works and allows the compiler not to worry about possible narrowing\n91\t     * on 32-bit systems.  (Pre-ANSI systems did not make integers smaller\n92\t     * than 16 bits either.)\n93\t     */\n94\t    let val: c_uint = (((*buf) as c_uint) << 8).wrapping_add((*buf.add(1)) as c_uint);\n95\t\n96\t    val as png_uint_16\n97\t}\n98\t/* READ_INT_FUNCTIONS */\n99\t\n100\t/* Read and check the PNG file signature */\n101\t#[unsafe(no_mangle)]\n102\tpub unsafe extern \"C-unwind\" fn png_read_sig(png_ptr: png_structrp, info_ptr: png_inforp) {\n103\t    let num_checked: usize;\n104\t    let num_to_check: usize;\n105\t\n106\t    /* Exit if the user application does not expect a signature. */\n107\t    if (*png_ptr).sig_bytes >= 8 {\n108\t        return;\n109\t    }\n110\t\n111\t    num_checked = (*png_ptr).sig_bytes as usize;\n112\t    num_to_check = 8usize.wrapping_sub(num_checked);\n113\t\n114\t    /* IO_STATE */\n115\t    (*png_ptr).io_state = PNG_IO_READING | PNG_IO_SIGNATURE;\n116\t\n117\t    /* The signature must be serialized in a single I/O call. */\n118\t    png_read_data(\n119\t        png_ptr,\n120\t        (core::ptr::addr_of_mut!((*info_ptr).signature) as png_bytep).add(num_checked),\n121\t        num_to_check,\n122\t    );\n123\t    (*png_ptr).sig_bytes = 8;\n124\t\n125\t    if png_sig_cmp(\n126\t        core::ptr::addr_of!((*info_ptr).signature) as png_const_bytep,\n127\t        num_checked,\n128\t        num_to_check,\n129\t    ) != 0\n130\t    {\n131\t        if num_checked < 4\n132\t            && png_sig_cmp(\n133\t                core::ptr::addr_of!((*info_ptr).signature) as png_const_bytep,\n134\t                num_checked,\n135\t                num_to_check.wrapping_sub(4),\n136\t            ) != 0\n137\t        {\n138\t            png_error(png_ptr, c\"Not a PNG file\".as_ptr());\n139\t        } else {\n140\t            png_error(png_ptr, c\"PNG file corrupted by ASCII conversion\".as_ptr());\n141\t        }\n142\t    }\n143\t    if num_checked < 3 {\n144\t        (*png_ptr).mode |= PNG_HAVE_PNG_SIGNATURE;\n145\t    }\n146\t}\n147\t\n148\t/* This function is called to verify that a chunk name is valid.\n149\t * Do this using the bit-whacking approach from contrib/tools/pngfix.c\n150\t *\n151\t * Copied from libpng 1.7.\n152\t */\n153\tpub(crate) unsafe fn check_chunk_name(name: png_uint_32) -> c_int {\n154\t    let mut name = name;\n155\t    let mut t: png_uint_32;\n156\t\n157\t    /* Remove bit 5 from all but the reserved byte; this means\n158\t     * every 8-bit unit must be in the range 65-90 to be valid.\n159\t     * So bit 5 must be zero, bit 6 must be set and bit 7 zero.\n160\t     */\n161\t    name &= !PNG_U32(32, 32, 0, 32);\n162\t    t = (name & !0x1f1f1f1fu32) ^ 0x40404040u32;\n163\t\n164\t    /* Subtract 65 for each 8-bit quantity, this must not\n165\t     * overflow and each byte must then be in the range 0-25.\n166\t     */\n167\t    name = name.wrapping_sub(PNG_U32(65, 65, 65, 65));\n168\t    t |= name;\n169\t\n170\t    /* Subtract 26, handling the overflow which should set the\n171\t     * top three bits of each byte.\n172\t     */\n173\t    name = name.wrapping_sub(PNG_U32(25, 25, 25, 26));\n174\t    t |= !name;\n175\t\n176\t    ((t & 0xe0e0e0e0u32) == 0u32) as c_int\n177\t}\n178\t\n179\t/* Read the chunk header (length + type name).\n180\t * Put the type name into png_ptr->chunk_name, and return the length.\n181\t */\n182\t#[unsafe(no_mangle)]\n183\tpub unsafe extern \"C-unwind\" fn png_read_chunk_header(png_ptr: png_structrp) -> png_uint_32 {\n184\t    let mut buf: [png_byte; 8] = [0; 8];\n185\t    let chunk_name: png_uint_32;\n186\t    let length: png_uint_32;\n187\t\n188\t    /* IO_STATE */\n189\t    (*png_ptr).io_state = PNG_IO_READING | PNG_IO_CHUNK_HDR;\n190\t\n191\t    /* Read the length and the chunk name.  png_struct::chunk_name is immediately\n192\t     * updated even if they are detectably wrong.  This aids error message\n193\t     * handling by allowing png_chunk_error to be used.\n194\t     */\n195\t    png_read_data(png_ptr, buf.as_mut_ptr(), 8);\n196\t    length = png_get_uint_31(png_ptr, buf.as_ptr());\n197\t    chunk_name = PNG_CHUNK_FROM_STRING(buf.as_ptr().add(4));\n198\t    (*png_ptr).chunk_name = chunk_name;\n199\t\n200\t    /* Reset the crc and run it over the chunk name. */\n201\t    png_reset_crc(png_ptr);\n202\t    png_calculate_crc(png_ptr, buf.as_ptr().add(4), 4);\n203\t\n204\t    /* Sanity check the length (first by <= 0x80) and the chunk name.  An error\n205\t     * here indicates a broken stream and libpng has no recovery from this.\n206\t     */\n207\t    if buf[0] >= 0x80u8 {\n208\t        png_chunk_error(png_ptr, c\"bad header (invalid length)\".as_ptr());\n209\t    }\n210\t\n211\t    /* Check to see if chunk name is valid. */\n212\t    if check_chunk_name(chunk_name) == 0 {\n213\t        png_chunk_error(png_ptr, c\"bad header (invalid type)\".as_ptr());\n214\t    }\n215\t\n216\t    /* IO_STATE */\n217\t    (*png_ptr).io_state = PNG_IO_READING | PNG_IO_CHUNK_DATA;\n218\t\n219\t    length\n220\t}\n221\t\n222\t/* Read data, and (optionally) run it through the CRC. */\n223\t#[unsafe(no_mangle)]\n224\tpub unsafe extern \"C-unwind\" fn png_crc_read(\n225\t    png_ptr: png_structrp,\n226\t    buf: png_bytep,\n227\t    length: png_uint_32,\n228\t) {\n229\t    if png_ptr.is_null() {\n230\t        return;\n231\t    }\n232\t\n233\t    png_read_data(png_ptr, buf, length as usize);\n234\t    png_calculate_crc(png_ptr, buf, length as usize);\n235\t}\n236\t\n237\t/* Compare the CRC stored in the PNG file with that calculated by libpng from\n238\t * the data it has read thus far.\n239\t */\n240\tpub(crate) unsafe fn png_crc_error(png_ptr: png_structrp, handle_as_ancillary: c_int) -> c_int {\n241\t    let mut crc_bytes: [png_byte; 4] = [0; 4];\n242\t    let crc: png_uint_32;\n243\t    let mut need_crc: c_int = 1;\n244\t\n245\t    /* There are four flags two for ancillary and two for critical chunks.  The\n246\t     * default setting of these flags is all zero.\n247\t     *\n248\t     * PNG_FLAG_CRC_ANCILLARY_USE\n249\t     * PNG_FLAG_CRC_ANCILLARY_NOWARN\n250\t     *  USE+NOWARN: no CRC calculation (implemented here), else;\n251\t     *  NOWARN:     png_chunk_error on error (implemented in png_crc_finish)\n252\t     *  else:       png_chunk_warning on error (implemented in png_crc_finish)\n253\t     *              This is the default.\n254\t     *\n255\t     *    I.e. NOWARN without USE produces png_chunk_error.  The default setting\n256\t     *    where neither are set does the same thing.\n257\t     *\n258\t     * PNG_FLAG_CRC_CRITICAL_USE\n259\t     * PNG_FLAG_CRC_CRITICAL_IGNORE\n260\t     *  IGNORE: no CRC calculation (implemented here), else;\n261\t     *  USE:    png_chunk_warning on error (implemented in png_crc_finish)\n262\t     *  else:   png_chunk_error on error (implemented in png_crc_finish)\n263\t     *          This is the default.\n264\t     *\n265\t     * This arose because of original mis-implementation and has persisted for\n266\t     * compatibility reasons.\n267\t     *\n268\t     * TODO: the flag names are internal so maybe this can be changed to\n269\t     * something comprehensible.\n270\t     */\n271\t    if handle_as_ancillary != 0 || PNG_CHUNK_ANCILLARY((*png_ptr).chunk_name) != 0 {\n272\t        if ((*png_ptr).flags & PNG_FLAG_CRC_ANCILLARY_MASK)\n273\t            == (PNG_FLAG_CRC_ANCILLARY_USE | PNG_FLAG_CRC_ANCILLARY_NOWARN)\n274\t        {\n275\t            need_crc = 0;\n276\t        }\n277\t    } else\n278\t    /* critical */\n279\t    {\n280\t        if ((*png_ptr).flags & PNG_FLAG_CRC_CRITICAL_IGNORE) != 0 {\n281\t            need_crc = 0;\n282\t        }\n283\t    }\n284\t\n285\t    /* IO_STATE */\n286\t    (*png_ptr).io_state = PNG_IO_READING | PNG_IO_CHUNK_CRC;\n287\t\n288\t    /* The chunk CRC must be serialized in a single I/O call. */\n289\t    png_read_data(png_ptr, crc_bytes.as_mut_ptr(), 4);\n290\t\n291\t    if need_crc != 0 {\n292\t        crc = PNG_get_uint_32(crc_bytes.as_ptr());\n293\t        return (crc != (*png_ptr).crc) as c_int;\n294\t    } else {\n295\t        return 0;\n296\t    }\n297\t}\n298\t\n299\t/* Optionally skip data and then check the CRC.  Depending on whether we\n300\t * are reading an ancillary or critical chunk, and how the program has set\n301\t * things up, we may calculate the CRC on the data and print a message.\n302\t * Returns '1' if there was a CRC error, '0' otherwise.\n303\t *\n304\t * There is one public version which is used in most places and another which\n305\t * takes the value for the 'critical' flag to check.  This allows PLTE and IEND\n306\t * handling code to ignore the CRC error and removes some confusing code\n307\t * duplication.\n308\t */\n309\tpub(crate) unsafe fn png_crc_finish_critical(\n310\t    png_ptr: png_structrp,\n311\t    skip: png_uint_32,\n312\t    handle_as_ancillary: c_int,\n313\t) -> c_int {\n314\t    let mut skip = skip;\n315\t    let mut handle_as_ancillary = handle_as_ancillary;\n316\t\n317\t    /* The size of the local buffer for inflate is a good guess as to a\n318\t     * reasonable size to use for buffering reads from the application.\n319\t     */\n320\t    while skip > 0 {\n321\t        let mut len: png_uint_32;\n322\t        let mut tmpbuf: [png_byte; PNG_INFLATE_BUF_SIZE] = [0; PNG_INFLATE_BUF_SIZE];\n323\t\n324\t        len = core::mem::size_of::<[png_byte; PNG_INFLATE_BUF_SIZE]>() as png_uint_32;\n325\t        if len > skip {\n326\t            len = skip;\n327\t        }\n328\t        skip -= len;\n329\t\n330\t        png_crc_read(png_ptr, tmpbuf.as_mut_ptr(), len);\n331\t    }\n332\t\n333\t    /* If 'handle_as_ancillary' has been requested and this is a critical chunk\n334\t     * but PNG_FLAG_CRC_CRITICAL_IGNORE was set then png_read_crc did not, in\n335\t     * fact, calculate the CRC so the ANCILLARY settings should not be used\n336\t     * instead.\n337\t     */\n338\t    if handle_as_ancillary != 0 && ((*png_ptr).flags & PNG_FLAG_CRC_CRITICAL_IGNORE) != 0 {\n339\t        handle_as_ancillary = 0;\n340\t    }\n341\t\n342\t    /* TODO: this might be more comprehensible if png_crc_error was inlined here.\n343\t     */\n344\t    if png_crc_error(png_ptr, handle_as_ancillary) != 0 {\n345\t        /* See above for the explanation of how the flags work. */\n346\t        let warn: bool = if handle_as_ancillary != 0\n347\t            || PNG_CHUNK_ANCILLARY((*png_ptr).chunk_name) != 0\n348\t        {\n349\t            ((*png_ptr).flags & PNG_FLAG_CRC_ANCILLARY_NOWARN) == 0\n350\t        } else {\n351\t            ((*png_ptr).flags & PNG_FLAG_CRC_CRITICAL_USE) != 0\n352\t        };\n353\t\n354\t        if warn {\n355\t            png_chunk_warning(png_ptr, c\"CRC error\".as_ptr());\n356\t        } else {\n357\t            png_chunk_error(png_ptr, c\"CRC error\".as_ptr());\n358\t        }\n359\t\n360\t        return 1;\n361\t    }\n362\t\n363\t    0\n364\t}\n365\t\n366\t#[unsafe(no_mangle)]\n367\tpub unsafe extern \"C-unwind\" fn png_crc_finish(\n368\t    png_ptr: png_structrp,\n369\t    skip: png_uint_32,\n370\t) -> c_int {\n371\t    png_crc_finish_critical(png_ptr, skip, 0 /*critical handling*/)\n372\t}\n373\t\n374\t/* READ_iCCP|iTXt|pCAL|sCAL|sPLT|tEXt|zTXt|eXIf|SEQUENTIAL_READ */\n375\t/* Manage the read buffer; this simply reallocates the buffer if it is not small\n376\t * enough (or if it is not allocated).  The routine returns a pointer to the\n377\t * buffer; if an error occurs and 'warn' is set the routine returns NULL, else\n378\t * it will call png_error on failure.\n379\t */\n380\tpub(crate) unsafe fn png_read_buffer(\n381\t    png_ptr: png_structrp,\n382\t    new_size: png_alloc_size_t,\n383\t) -> png_bytep {\n384\t    let mut buffer: png_bytep = (*png_ptr).read_buffer;\n385\t\n386\t    if new_size > (*png_ptr).user_chunk_malloc_max {\n387\t        return core::ptr::null_mut();\n388\t    }\n389\t\n390\t    if !buffer.is_null() && new_size > (*png_ptr).read_buffer_size {\n391\t        (*png_ptr).read_buffer = core::ptr::null_mut();\n392\t        (*png_ptr).read_buffer_size = 0;\n393\t        png_free(png_ptr, buffer as png_voidp);\n394\t        buffer = core::ptr::null_mut();\n395\t    }\n396\t\n397\t    if buffer.is_null() {\n398\t        buffer = png_malloc_base(png_ptr, new_size) as png_bytep;\n399\t\n400\t        if !buffer.is_null() {\n401\t            memset(buffer, 0, new_size); /* just in case */\n402\t            (*png_ptr).read_buffer = buffer;\n403\t            (*png_ptr).read_buffer_size = new_size;\n404\t        }\n405\t    }\n406\t\n407\t    buffer\n408\t}\n409\t/* READ_iCCP|iTXt|pCAL|sCAL|sPLT|tEXt|zTXt|eXIf|SEQUENTIAL_READ */\n410\t\n411\t/* png_inflate_claim: claim the zstream for some nefarious purpose that involves\n412\t * decompression.  Returns Z_OK on success, else a zlib error code.  It checks\n413\t * the owner but, in final release builds, just issues a warning if some other\n414\t * chunk apparently owns the stream.  Prior to release it does a png_error.\n415\t */\n416\tpub(crate) unsafe fn png_inflate_claim(png_ptr: png_structrp, owner: png_uint_32) -> c_int {\n417\t    if (*png_ptr).zowner != 0 {\n418\t        let mut msg: [c_char; 64] = [0; 64];\n419\t\n420\t        PNG_STRING_FROM_CHUNK(msg.as_mut_ptr(), (*png_ptr).zowner);\n421\t        /* So the message that results is \"<chunk> using zstream\"; this is an\n422\t         * internal error, but is very useful for debugging.  i18n requirements\n423\t         * are minimal.\n424\t         */\n425\t        png_safecat(msg.as_mut_ptr(), 64, 4, c\" using zstream\".as_ptr());\n426\t        /* !PNG_RELEASE_BUILD */\n427\t        png_chunk_error(png_ptr, msg.as_ptr());\n428\t    }\n429\t\n430\t    /* Implementation note: unlike 'png_deflate_claim' this internal function\n431\t     * does not take the size of the data as an argument.  Some efficiency could\n432\t     * be gained by using this when it is known *if* the zlib stream itself does\n433\t     * not record the number; however, this is an illusion: the original writer\n434\t     * of the PNG may have selected a lower window size, and we really must\n435\t     * follow that because, for systems with limited capabilities, we\n436\t     * would otherwise reject the application's attempts to use a smaller window\n437\t     * size (zlib doesn't have an interface to say \"this or lower\"!).\n438\t     *\n439\t     * inflateReset2 was added to zlib 1.2.4; before this the window could not be\n440\t     * reset, therefore it is necessary to always allocate the maximum window\n441\t     * size with earlier zlibs just in case later compressed chunks need it.\n442\t     */\n443\t    {\n444\t        let mut ret: c_int; /* zlib return code */\n445\t        /* ZLIB_VERNUM >= 0x1240 */\n446\t        let mut window_bits: c_int = 0;\n447\t\n448\t        /* SET_OPTION && MAXIMUM_INFLATE_WINDOW */\n449\t        if (((*png_ptr).options >> PNG_MAXIMUM_INFLATE_WINDOW) & 3)\n450\t            == PNG_OPTION_ON as png_uint_32\n451\t        {\n452\t            window_bits = 15;\n453\t            (*png_ptr).zstream_start = 0; /* fixed window size */\n454\t        } else {\n455\t            (*png_ptr).zstream_start = 1;\n456\t        }\n457\t\n458\t        /* Set this for safety, just in case the previous owner left pointers to\n459\t         * memory allocations.\n460\t         */\n461\t        (*png_ptr).zstream.next_in = core::ptr::null();\n462\t        (*png_ptr).zstream.avail_in = 0;\n463\t        (*png_ptr).zstream.next_out = core::ptr::null_mut();\n464\t        (*png_ptr).zstream.avail_out = 0;\n465\t\n466\t        if ((*png_ptr).flags & PNG_FLAG_ZSTREAM_INITIALIZED) != 0 {\n467\t            ret = inflateReset2(core::ptr::addr_of_mut!((*png_ptr).zstream), window_bits);\n468\t        } else {\n469\t            ret = inflateInit2(core::ptr::addr_of_mut!((*png_ptr).zstream), window_bits);\n470\t\n471\t            if ret == Z_OK {\n472\t                (*png_ptr).flags |= PNG_FLAG_ZSTREAM_INITIALIZED;\n473\t            }\n474\t        }\n475\t\n476\t        if ret == Z_OK {\n477\t            (*png_ptr).zowner = owner;\n478\t        } else {\n479\t            png_zstream_error(png_ptr, ret);\n480\t        }\n481\t\n482\t        return ret;\n483\t    }\n484\t}\n485\t\n486\t/* Zlib >= 1.2.4 */\n487\t/* Handle the start of the inflate stream if we called inflateInit2(strm,0);\n488\t * in this case some zlib versions skip validation of the CINFO field and, in\n489\t * certain circumstances, libpng may end up displaying an invalid image, in\n490\t * contrast to implementations that call zlib in the normal way (e.g. libpng\n491\t * 1.5).\n492\t */\n493\t#[unsafe(no_mangle)]\n494\tpub unsafe extern \"C-unwind\" fn png_zlib_inflate(png_ptr: png_structrp, flush: c_int) -> c_int {\n495\t    if (*png_ptr).zstream_start != 0 && (*png_ptr).zstream.avail_in > 0 {\n496\t        if ((*(*png_ptr).zstream.next_in) >> 4) > 7 {\n497\t            (*png_ptr).zstream.msg = c\"invalid window size (libpng)\".as_ptr();\n498\t            return Z_DATA_ERROR;\n499\t        }\n500\t\n501\t        (*png_ptr).zstream_start = 0;\n502\t    }\n503\t\n504\t    inflate(core::ptr::addr_of_mut!((*png_ptr).zstream), flush)\n505\t}\n506\t/* Zlib >= 1.2.4 */\n507\t\n508\t/* READ_COMPRESSED_TEXT */\n509\t/* READ_zTXt || READ_iTXt */\n510\t/* png_inflate now returns zlib error codes including Z_OK and Z_STREAM_END to\n511\t * allow the caller to do multiple calls if required.  If the 'finish' flag is\n512\t * set Z_FINISH will be passed to the final inflate() call and Z_STREAM_END must\n513\t * be returned or there has been a problem, otherwise Z_SYNC_FLUSH is used and\n514\t * Z_OK or Z_STREAM_END will be returned on success.\n515\t *\n516\t * The input and output sizes are updated to the actual amounts of data consumed\n517\t * or written, not the amount available (as in a z_stream).  The data pointers\n518\t * are not changed, so the next input is (data+input_size) and the next\n519\t * available output is (output+output_size).\n520\t */\n521\tpub(crate) unsafe fn png_inflate(\n522\t    png_ptr: png_structrp,\n523\t    owner: png_uint_32,\n524\t    finish: c_int,\n525\t    /* INPUT: */ input: png_const_bytep,\n526\t    input_size_ptr: png_uint_32p,\n527\t    /* OUTPUT: */ output: png_bytep,\n528\t    output_size_ptr: *mut png_alloc_size_t,\n529\t) -> c_int {\n530\t    if (*png_ptr).zowner == owner\n531\t    /* Else not claimed */\n532\t    {\n533\t        let mut ret: c_int;\n534\t        let mut avail_out: png_alloc_size_t = *output_size_ptr;\n535\t        let mut avail_in: png_uint_32 = *input_size_ptr;\n536\t\n537\t        /* zlib can't necessarily handle more than 65535 bytes at once (i.e. it\n538\t         * can't even necessarily handle 65536 bytes) because the type uInt is\n539\t         * \"16 bits or more\".  Consequently it is necessary to chunk the input to\n540\t         * zlib.  This code uses ZLIB_IO_MAX, from pngpriv.h, as the maximum (the\n541\t         * maximum value that can be stored in a uInt.)  It is possible to set\n542\t         * ZLIB_IO_MAX to a lower value in pngpriv.h and this may sometimes have\n543\t         * a performance advantage, because it reduces the amount of data accessed\n544\t         * at each step and that may give the OS more time to page it in.\n545\t         */\n546\t        (*png_ptr).zstream.next_in = input;\n547\t        /* avail_in and avail_out are set below from 'size' */\n548\t        (*png_ptr).zstream.avail_in = 0;\n549\t        (*png_ptr).zstream.avail_out = 0;\n550\t\n551\t        /* Read directly into the output if it is available (this is set to\n552\t         * a local buffer below if output is NULL).\n553\t         */\n554\t        if !output.is_null() {\n555\t            (*png_ptr).zstream.next_out = output;\n556\t        }\n557\t\n558\t        loop {\n559\t            let mut avail: u32;\n560\t            let mut local_buffer: [png_byte; PNG_INFLATE_BUF_SIZE] = [0; PNG_INFLATE_BUF_SIZE];\n561\t\n562\t            /* zlib INPUT BUFFER */\n563\t  