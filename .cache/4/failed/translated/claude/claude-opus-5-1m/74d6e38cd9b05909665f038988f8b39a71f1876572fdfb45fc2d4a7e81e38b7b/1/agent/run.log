{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_014FyxQd2WKuAvcXBvvFVpgw","type":"tool_result","content":"1\t//! Basic libpng types (from pngconf.h and png.h) plus the public structures.\n2\t//!\n3\t//! NOTE ON CONST-NESS: for `png_struct` / `png_info` pointers the C code freely\n4\t//! casts away `const` (via `png_constcast`).  Because `*const T` and `*mut T`\n5\t//! are ABI-identical, all such aliases are defined as `*mut` so that the\n6\t//! translated code does not need casts everywhere.\n7\t\n8\t#![allow(non_camel_case_types)]\n9\t\n10\tuse core::ffi::{c_char, c_int, c_uint, c_void};\n11\t\n12\tuse crate::pnginfo::png_info;\n13\tuse crate::pngstruct::png_struct;\n14\t\n15\t/* ---------------------------------------------------------------- pngconf.h */\n16\t\n17\tpub type png_byte = u8;\n18\tpub type png_int_16 = i16;\n19\tpub type png_uint_16 = u16;\n20\tpub type png_int_32 = i32;\n21\tpub type png_uint_32 = u32;\n22\tpub type png_size_t = usize;\n23\tpub type png_ptrdiff_t = isize;\n24\tpub type png_alloc_size_t = usize;\n25\tpub type png_fixed_point = i32;\n26\t\n27\tpub type png_voidp = *mut c_void;\n28\tpub type png_const_voidp = *const c_void;\n29\tpub type png_bytep = *mut png_byte;\n30\tpub type png_const_bytep = *const png_byte;\n31\tpub type png_uint_32p = *mut png_uint_32;\n32\tpub type png_const_uint_32p = *const png_uint_32;\n33\tpub type png_int_32p = *mut png_int_32;\n34\tpub type png_const_int_32p = *const png_int_32;\n35\tpub type png_uint_16p = *mut png_uint_16;\n36\tpub type png_const_uint_16p = *const png_uint_16;\n37\tpub type png_int_16p = *mut png_int_16;\n38\tpub type png_const_int_16p = *const png_int_16;\n39\tpub type png_charp = *mut c_char;\n40\tpub type png_const_charp = *const c_char;\n41\tpub type png_fixed_point_p = *mut png_fixed_point;\n42\tpub type png_const_fixed_point_p = *const png_fixed_point;\n43\tpub type png_size_tp = *mut usize;\n44\tpub type png_const_size_tp = *const usize;\n45\tpub type png_doublep = *mut f64;\n46\tpub type png_const_doublep = *const f64;\n47\t\n48\tpub type png_bytepp = *mut png_bytep;\n49\tpub type png_uint_32pp = *mut png_uint_32p;\n50\tpub type png_int_32pp = *mut png_int_32p;\n51\tpub type png_uint_16pp = *mut png_uint_16p;\n52\tpub type png_int_16pp = *mut png_int_16p;\n53\tpub type png_const_charpp = *mut png_const_charp;\n54\tpub type png_charpp = *mut png_charp;\n55\tpub type png_fixed_point_pp = *mut png_fixed_point_p;\n56\tpub type png_doublepp = *mut png_doublep;\n57\tpub type png_charppp = *mut png_charpp;\n58\t\n59\t/* -------------------------------------------------------- struct pointers */\n60\t\n61\tpub type png_structp = *mut png_struct;\n62\tpub type png_const_structp = *mut png_struct;\n63\tpub type png_structpp = *mut png_structp;\n64\tpub type png_structrp = *mut png_struct;\n65\tpub type png_const_structrp = *mut png_struct;\n66\t\n67\tpub type png_infop = *mut png_info;\n68\tpub type png_const_infop = *mut png_info;\n69\tpub type png_infopp = *mut png_infop;\n70\tpub type png_inforp = *mut png_info;\n71\tpub type png_const_inforp = *mut png_info;\n72\t\n73\t/* ------------------------------------------------------- public structures */\n74\t\n75\t#[repr(C)]\n76\t#[derive(Clone, Copy, Default)]\n77\tpub struct png_color {\n78\t    pub red: png_byte,\n79\t    pub green: png_byte,\n80\t    pub blue: png_byte,\n81\t}\n82\tpub type png_colorp = *mut png_color;\n83\tpub type png_const_colorp = *const png_color;\n84\tpub type png_colorpp = *mut png_colorp;\n85\t\n86\t#[repr(C)]\n87\t#[derive(Clone, Copy, Default)]\n88\tpub struct png_color_16 {\n89\t    pub index: png_byte,\n90\t    pub red: png_uint_16,\n91\t    pub green: png_uint_16,\n92\t    pub blue: png_uint_16,\n93\t    pub gray: png_uint_16,\n94\t}\n95\tpub type png_color_16p = *mut png_color_16;\n96\tpub type png_const_color_16p = *const png_color_16;\n97\tpub type png_color_16pp = *mut png_color_16p;\n98\t\n99\t#[repr(C)]\n100\t#[derive(Clone, Copy, Default)]\n101\tpub struct png_color_8 {\n102\t    pub red: png_byte,\n103\t    pub green: png_byte,\n104\t    pub blue: png_byte,\n105\t    pub gray: png_byte,\n106\t    pub alpha: png_byte,\n107\t}\n108\tpub type png_color_8p = *mut png_color_8;\n109\tpub type png_const_color_8p = *const png_color_8;\n110\tpub type png_color_8pp = *mut png_color_8p;\n111\t\n112\t#[repr(C)]\n113\t#[derive(Clone, Copy, Default)]\n114\tpub struct png_sPLT_entry {\n115\t    pub red: png_uint_16,\n116\t    pub green: png_uint_16,\n117\t    pub blue: png_uint_16,\n118\t    pub alpha: png_uint_16,\n119\t    pub frequency: png_uint_16,\n120\t}\n121\tpub type png_sPLT_entryp = *mut png_sPLT_entry;\n122\tpub type png_const_sPLT_entryp = *const png_sPLT_entry;\n123\tpub type png_sPLT_entrypp = *mut png_sPLT_entryp;\n124\t\n125\t#[repr(C)]\n126\t#[derive(Clone, Copy)]\n127\tpub struct png_sPLT_t {\n128\t    pub name: png_charp,\n129\t    pub depth: png_byte,\n130\t    pub entries: png_sPLT_entryp,\n131\t    pub nentries: png_int_32,\n132\t}\n133\tpub type png_sPLT_tp = *mut png_sPLT_t;\n134\tpub type png_const_sPLT_tp = *const png_sPLT_t;\n135\tpub type png_sPLT_tpp = *mut png_sPLT_tp;\n136\t\n137\t#[repr(C)]\n138\t#[derive(Clone, Copy)]\n139\tpub struct png_text {\n140\t    pub compression: c_int,\n141\t    pub key: png_charp,\n142\t    pub text: png_charp,\n143\t    pub text_length: usize,\n144\t    pub itxt_length: usize,\n145\t    pub lang: png_charp,\n146\t    pub lang_key: png_charp,\n147\t}\n148\tpub type png_textp = *mut png_text;\n149\tpub type png_const_textp = *const png_text;\n150\tpub type png_textpp = *mut png_textp;\n151\t\n152\t#[repr(C)]\n153\t#[derive(Clone, Copy, Default)]\n154\tpub struct png_time {\n155\t    pub year: png_uint_16,\n156\t    pub month: png_byte,\n157\t    pub day: png_byte,\n158\t    pub hour: png_byte,\n159\t    pub minute: png_byte,\n160\t    pub second: png_byte,\n161\t}\n162\tpub type png_timep = *mut png_time;\n163\tpub type png_const_timep = *const png_time;\n164\tpub type png_timepp = *mut png_timep;\n165\t\n166\t#[repr(C)]\n167\t#[derive(Clone, Copy)]\n168\tpub struct png_unknown_chunk {\n169\t    pub name: [png_byte; 5],\n170\t    pub data: *mut png_byte,\n171\t    pub size: usize,\n172\t    pub location: png_byte,\n173\t}\n174\tpub type png_unknown_chunkp = *mut png_unknown_chunk;\n175\tpub type png_const_unknown_chunkp = *const png_unknown_chunk;\n176\tpub type png_unknown_chunkpp = *mut png_unknown_chunkp;\n177\t\n178\t#[repr(C)]\n179\t#[derive(Clone, Copy, Default)]\n180\tpub struct png_row_info {\n181\t    pub width: png_uint_32,\n182\t    pub rowbytes: usize,\n183\t    pub color_type: png_byte,\n184\t    pub bit_depth: png_byte,\n185\t    pub channels: png_byte,\n186\t    pub pixel_depth: png_byte,\n187\t}\n188\tpub type png_row_infop = *mut png_row_info;\n189\tpub type png_row_infopp = *mut png_row_infop;\n190\t\n191\t/* --------------------------------------------------------------- callbacks */\n192\t\n193\tpub type png_error_ptr = Option<unsafe extern \"C-unwind\" fn(png_structp, png_const_charp)>;\n194\tpub type png_rw_ptr = Option<unsafe extern \"C-unwind\" fn(png_structp, png_bytep, usize)>;\n195\tpub type png_flush_ptr = Option<unsafe extern \"C-unwind\" fn(png_structp)>;\n196\tpub type png_read_status_ptr =\n197\t    Option<unsafe extern \"C-unwind\" fn(png_structp, png_uint_32, c_int)>;\n198\tpub type png_write_status_ptr =\n199\t    Option<unsafe extern \"C-unwind\" fn(png_structp, png_uint_32, c_int)>;\n200\tpub type png_progressive_info_ptr = Option<unsafe extern \"C-unwind\" fn(png_structp, png_infop)>;\n201\tpub type png_progressive_end_ptr = Option<unsafe extern \"C-unwind\" fn(png_structp, png_infop)>;\n202\tpub type png_progressive_row_ptr =\n203\t    Option<unsafe extern \"C-unwind\" fn(png_structp, png_bytep, png_uint_32, c_int)>;\n204\tpub type png_user_transform_ptr =\n205\t    Option<unsafe extern \"C-unwind\" fn(png_structp, png_row_infop, png_bytep)>;\n206\tpub type png_user_chun