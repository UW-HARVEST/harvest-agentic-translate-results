b const PNG_INDEX_sPLT: c_int = 22;\npub const PNG_INDEX_sRGB: c_int = 23;\npub const PNG_INDEX_tEXt: c_int = 24;\npub const PNG_INDEX_tIME: c_int = 25;\npub const PNG_INDEX_tRNS: c_int = 26;\npub const PNG_INDEX_zTXt: c_int = 27;\npub const PNG_INDEX_unknown: c_int = 28;\n\n#[inline]\npub const fn png_chunk_flag_from_index(i: c_int) -> png_uint_32 {\n    0x8000_0000u32 >> (31 - i)\n}\n\n#[inline]\npub const fn PNG_CHUNK_ANCILLARY(c: png_uint_32) -> c_int {\n    (1 & (c >> 29)) as c_int\n}\n#[inline]\npub const fn PNG_CHUNK_CRITICAL(c: png_uint_32) -> c_int {\n    if PNG_CHUNK_ANCILLARY(c) != 0 {\n        0\n    } else {\n        1\n    }\n}\n#[inline]\npub const fn PNG_CHUNK_PRIVATE(c: png_uint_32) -> c_int {\n    (1 & (c >> 21)) as c_int\n}\n#[inline]\npub const fn PNG_CHUNK_RESERVED(c: png_uint_32) -> c_int {\n    (1 & (c >> 13)) as c_int\n}\n#[inline]\npub const fn PNG_CHUNK_SAFE_TO_COPY(c: png_uint_32) -> c_int {\n    (1 & (c >> 5)) as c_int\n}\n\n/// `PNG_CHUNK_FROM_STRING(s)` -- reads 4 bytes.\n#[inline]\npub unsafe fn PNG_CHUNK_FROM_STRING(s: *const png_byte) -> png_uint_32 {\n    PNG_U32(\n        (0xff & *s) as u32,\n        (0xff & *s.add(1)) as u32,\n        (0xff & *s.add(2)) as u32,\n        (0xff & *s.add(3)) as u32,\n    )\n}\n\n/// `PNG_STRING_FROM_CHUNK(s, c)` -- writes 4 bytes.\n#[inline]\npub unsafe fn PNG_STRING_FROM_CHUNK(s: *mut core::ffi::c_char, c: png_uint_32) {\n    *s = ((c >> 24) & 0xff) as core::ffi::c_char;\n    *s.add(1) = ((c >> 16) & 0xff) as core::ffi::c_char;\n    *s.add(2) = ((c >> 8) & 0xff) as core::ffi::c_char;\n    *s.add(3) = (c & 0xff) as core::ffi::c_char;\n}\n\n/// `PNG_CSTRING_FROM_CHUNK(s, c)` -- writes 4 bytes plus a NUL.\n#[inline]\npub unsafe fn PNG_CSTRING_FROM_CHUNK(s: *mut core::ffi::c_char, c: png_uint_32) {\n    PNG_STRING_FROM_CHUNK(s, c);\n    *s.add(4) = 0;\n}\n\n/* ------------------------------------------------------ utility \"macros\" */\n\n#[inline]\npub fn PNG_ROWBYTES(pixel_bits: usize, width: usize) -> usize {\n    if pixel_bits >= 8 {\n        width.wrapping_mul(pixel_bits >> 3)\n    } else {\n        (width.wrapping_mul(pixel_bits)).wrapping_add(7) >> 3\n    }\n}\n\n#[inline]\npub fn PNG_TRAILBITS(pixel_bits: png_uint_32, width: png_uint_32) -> png_uint_32 {\n    (pixel_bits.wrapping_mul(width % 8)) % 8\n}\n\n#[inline]\npub fn PNG_PADBITS(pixel_bits: png_uint_32, width: png_uint_32) -> png_uint_32 {\n    (8 - PNG_TRAILBITS(pixel_bits, width)) % 8\n}\n\n#[inline]\npub fn PNG_DIV65535(v24: png_uint_32) -> png_uint_32 {\n    (v24.wrapping_add(32895)) >> 16\n}\n\n#[inline]\npub fn PNG_DIV257(v16: png_uint_32) -> png_uint_32 {\n    PNG_DIV65535(v16.wrapping_mul(255))\n}\n\n#[inline]\npub fn PNG_OUT_OF_RANGE(value: png_fixed_point, ideal: png_fixed_point, delta: png_fixed_point) -> bool {\n    value < ideal - delta || value > ideal + delta\n}\n\n/* Interlace macros (png.h) */\n\n#[inline]\npub const fn PNG_PASS_START_ROW(pass: c_int) -> c_int {\n    ((1 & !pass) << (3 - (pass >> 1))) & 7\n}\n#[inline]\npub const fn PNG_PASS_START_COL(pass: c_int) -> c_int {\n    ((1 & pass) << (3 - ((pass + 1) >> 1))) & 7\n}\n#[inline]\npub const fn PNG_PASS_ROW_OFFSET(pass: c_int) -> c_int {\n    if pass > 2 {\n        8 >> ((pass - 1) >> 1)\n    } else {\n        8\n    }\n}\n#[inline]\npub const fn PNG_PASS_COL_OFFSET(pass: c_int) -> c_int {\n    1 << ((7 - pass) >> 1)\n}\n#[inline]\npub const fn PNG_PASS_ROW_SHIFT(pass: c_int) -> c_int {\n    if pass > 2 {\n        (8 - pass) >> 1\n    } else {\n        3\n    }\n}\n#[inline]\npub const fn PNG_PASS_COL_SHIFT(pass: c_int) -> c_int {\n    if pass > 1 {\n        (7 - pass) >> 1\n    } else {\n        3\n    }\n}\n#[inline]\npub fn PNG_PASS_ROWS(height: png_uint_32, pass: c_int) -> png_uint_32 {\n    let shift = PNG_PASS_ROW_SHIFT(pass);\n    height.wrapping_add((((1 << shift) - 1) - PNG_PASS_START_ROW(pass)) as png_uint_32) >> shift\n}\n#[inline]\npub fn PNG_PASS_COLS(width: png_uint_32, pass: c_int) -> png_uint_32 {\n    let shift = PNG_PASS_COL_SHIFT(pass);\n    width.wrapping_add((((1 << shift) - 1) - PNG_PASS_START_COL(pass)) as png_uint_32) >> shift\n}\n#[inline]\npub fn PNG_ROW_FROM_PASS_ROW(y_in: png_uint_32, pass: c_int) -> png_uint_32 {\n    (y_in << PNG_PASS_ROW_SHIFT(pass)).wrapping_add(PNG_PASS_START_ROW(pass) as png_uint_32)\n}\n#[inline]\npub fn PNG_COL_FROM_PASS_COL(x_in: png_uint_32, pass: c_int) -> png_uint_32 {\n    (x_in << PNG_PASS_COL_SHIFT(pass)).wrapping_add(PNG_PASS_START_COL(pass) as png_uint_32)\n}\n#[inline]\npub const fn PNG_PASS_MASK(pass: c_int, off: c_int) -> u32 {\n    ((0x1101_45AFu32 >> (((7 - off) - pass) << 2)) & 0xF)\n        | ((0x0114_5AF0u32 >> (((7 - off) - pass) << 2)) & 0xF0)\n}\n#[inline]\npub fn PNG_ROW_IN_INTERLACE_PASS(y: png_uint_32, pass: c_int) -> u32 {\n    (PNG_PASS_MASK(pass, 0) >> (y & 7)) & 1\n}\n#[inline]\npub fn PNG_COL_IN_INTERLACE_PASS(x: png_uint_32, pass: c_int) -> u32 {\n    (PNG_PASS_MASK(pass, 1) >> (x & 7)) & 1\n}\n\n/* Compositing (NODIV variants, as PNG_READ_COMPOSITE_NODIV_SUPPORTED is on) */\n\n#[inline]\npub fn png_composite(fg: png_uint_16, alpha: png_uint_16, bg: png_uint_16) -> png_byte {\n    let temp: png_uint_16 = fg\n        .wrapping_mul(alpha)\n        .wrapping_add(bg.wrapping_mul(255u16.wrapping_sub(alpha)))\n        .wrapping_add(128);\n    (((temp.wrapping_add(temp >> 8)) >> 8) & 0xff) as png_byte\n}\n\n#[inline]\npub fn png_composite_16(fg: png_uint_32, alpha: png_uint_32, bg: png_uint_32) -> png_uint_16 {\n    let temp: png_uint_32 = fg\n        .wrapping_mul(alpha)\n        .wrapping_add(bg.wrapping_mul(65535u32.wrapping_sub(alpha)))\n        .wrapping_add(32768);\n    (0xffff & ((temp.wrapping_add(temp >> 16)) >> 16)) as png_uint_16\n}\n\n/* Read/write integer helpers (macro forms used inside the library) */\n\n#[inline]\npub unsafe fn PNG_get_uint_32(buf: png_const_bytep) -> png_uint_32 {\n    ((*buf as png_uint_32) << 24)\n        + ((*buf.add(1) as png_uint_32) << 16)\n        + ((*buf.add(2) as png_uint