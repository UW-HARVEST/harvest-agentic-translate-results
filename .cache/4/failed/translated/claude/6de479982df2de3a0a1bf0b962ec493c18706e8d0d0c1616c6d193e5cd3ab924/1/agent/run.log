              f32::NEG_INFINITY\n                } else {\n                    f32::INFINITY\n                });\n            }\n            self.pos = start;\n            return None;\n        }\n\n        // nan / nan(n-char-sequence)\n        if matches!(self.peek(), Some(b'n') | Some(b'N')) {\n            if self.eat_word(\"nan\") {\n                if self.peek() == Some(b'(') {\n                    let save = self.pos;\n                    self.bump();\n                    let mut ok = false;\n                    while let Some(c) = self.peek() {\n                        if c == b')' {\n                            self.bump();\n                            ok = true;\n                            break;\n                        }\n                        if c.is_ascii_alphanumeric() || c == b'_' {\n                            self.bump();\n                        } else {\n                            break;\n                        }\n                    }\n                    if !ok {\n                        self.pos = save;\n                    }\n                }\n                let nan = f32::from_bits(0x7fc0_0000);\n                return Some(if neg { -nan } else { nan });\n            }\n            self.pos = start;\n            return None;\n        }\n\n        // hex float: 0x / 0X\n        if self.peek() == Some(b'0')\n            && matches!(self.peek_at(1), Some(b'x') | Some(b'X'))\n            && (self.peek_at(2).and_then(hex_val).is_some()\n                || (self.peek_at(2) == Some(b'.') && self.peek_at(3).and_then(hex_val).is_some()))\n        {\n            self.pos += 2;\n            let mut mant: u128 = 0;\n            let mut bexp: i64 = 0;\n            let mut digits = 0u32;\n            while let Some(c) = self.peek() {\n                if let Some(d) = hex_val(c) {\n                    if digits < 30 {\n                        mant = mant * 16 + d as u128;\n                        digits += 1;\n                    } else {\n        