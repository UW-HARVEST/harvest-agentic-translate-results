[0m[49m[38;5;10m+    424[0m:[38;5;10m[49m             signal: None
[0m[49m[38;5;10m+    425[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    426[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    427[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    428[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    429[0m:[38;5;10m[49m /// stdin is never read, so anything on it must be ignored identically: empty,
[0m[49m[38;5;10m+    430[0m:[38;5;10m[49m /// one line, no trailing newline, NUL bytes, and a payload far larger than a
[0m[49m[38;5;10m+    431[0m:[38;5;10m[49m /// pipe buffer. (`scanf` would consume across newlines and `fgets` would stop
[0m[49m[38;5;10m+    432[0m:[38;5;10m[49m /// at one; this program does neither, and these cases pin that down.)
[0m[49m[38;5;10m+    433[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    434[0m:[38;5;10m[49m fn stdin_contents_are_ignored_identically() {
[0m[49m[38;5;10m+    435[0m:[38;5;10m[49m     let dir = scratch("stdin");
[0m[49m[38;5;10m+    436[0m:[38;5;10m[49m     let cases: Vec<(&str, Vec<u8>)> = vec![
[0m[49m[38;5;10m+    437[0m:[38;5;10m[49m         ("empty", Vec::new()),
[0m[49m[38;5;10m+    438[0m:[38;5;10m[49m         ("single_line", b"1\n".to_vec()),
[0m[49m[38;5;10m+    439[0m:[38;5;10m[49m         ("single_item_no_newline", b"42".to_vec()),
[0m[49m[38;5;10m+    440[0m:[38;5;10m[49m         ("two_lines", b"hello\nworld\n".to_vec()),
[0m[49m[38;5;10m+    441[0m:[38;5;10m[49m         ("blank_lines", b"\n\n\n".to_vec()),
[0m[49m[38;5;10m+    442[0m:[38;5;10m[49m         ("whitespace_only", b"   \t  \n".to_vec()),
[0m[49m[38;5;10m+    443[0m:[38;5;10m[49m         ("nul_bytes", vec![0u8, 0, b'a', 0, b'\n']),
[0m[49m[38;5;10m+    444[0m:[38;5;10m[49m         ("binary", (0u8..=255).collect()),
[0m[49m[38;5;10m+    445[0m:[38;5;10m[49m         ("negative_numbers", b"-1 -2147483648 -9223372036854775808\n".to_vec()),
[0m[49m[38;5;10m+    446[0m:[38;5;10m[49m         ("huge_numbers", b"99999999999999999999999999\n".to_vec()),
[0m[49m[38;5;10m+    447[0m:[38;5;10m[49m         ("long_line", vec![b'x'; 100_000]),
[0m[49m[38;5;10m+    448[0m:[38;5;10m[49m         ("large_payload", b"0123456789\n".repeat(100_000)),
[0m[49m[38;5;10m+    449[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    450[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    451[0m:[38;5;10m[49m     for (name, bytes) in cases {
[0m[49m[38;5;10m+    452[0m:[38;5;10m[49m         let path = dir.join(name);
[0m[49m[38;5;10m+    453[0m:[38;5;10m[49m         File::create(&path).unwrap().write_all(&bytes).unwrap();
[0m[49m[38;5;10m+    454[0m:[38;5;10m[49m         let c = run_plain(c_binary(), &[], Some(&path), manifest_dir(), Env::Inherit);
[0m[49m[38;5;10m+    455[0m:[38;5;10m[49m         let r = run_plain(rust_binary(), &[], Some(&path), manifest_dir(), Env::Inherit);
[0m[49m[38;5;10m+    456[0m:[38;5;10m[49m         assert_same(&format!("stdin/{name}"), &c, &r);
[0m[49m[38;5;10m+    457[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    458[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    459[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    460[0m:[38;5;10m[49m /// stdin as a pipe rather than a regular file: a program that probed `isatty`
[0m[49m[38;5;10m+    461[0m:[38;5;10m[49m /// or read a byte would show up here.
[0m[49m[38;5;10m+    462[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    463[0m:[38;5;10m[49m fn stdin_as_pipe_and_as_closed_fd() {
[0m[49m[38;5;10m+    464[0m:[38;5;10m[49m     // Pipe with data the program must not consume.
[0m[49m[38;5;10m+    465[0m:[38;5;10m[49m     for prog_pair in [(c_binary(), rust_binary())] {
[0m[49m[38;5;10m+    466[0m:[38;5;10m[49m         let mut results = Vec::new();
[0m[49m[38;5;10m+    467[0m:[38;5;10m[49m         for prog in [prog_pair.0, prog_pair.1] {
[0m[49m[38;5;10m+    468[0m:[38;5;10m[49m             let mut child = Command::new(prog)
[0m[49m[38;5;10m+    469[0m:[38;5;10m[49m                 .stdin(Stdio::piped())
[0m[49m[38;5;10m+    470[0m:[38;5;10m[49m                 .stdout(Stdio::piped())
[0m[49m[38;5;10m+    471[0m:[38;5;10m[49m                 .stderr(Stdio::piped())
[0m[49m[38;5;10m+    472[0m:[38;5;10m[49m                 .spawn()
[0m[49m[38;5;10m+    473[0m:[38;5;10m[49m                 .expect("spawn");
[0m[49m[38;5;10m+    474[0m:[38;5;10m[49m             let mut sink = child.stdin.take().unwrap();
[0m[49m[38;5;10m+    475[0m:[38;5;10m[49m             // Ignore write errors: the program never reads, so the pipe may
[0m[49m[38;5;10m+    476[0m:[38;5;10m[49m             // fill or be closed under us. Neither is our concern.
[0m[49m[38;5;10m+    477[0m:[38;5;10m[49m             let _ = sink.write_all(b"5\nalpha\nbeta\n");
[0m[49m[38;5;10m+    478[0m:[38;5;10m[49m             drop(sink);
[0m[49m[38;5;10m+    479[0m:[38;5;10m[49m             results.push(Observed::from_output(child.wait_with_output().unwrap()));
[0m[49m[38;5;10m+    480[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    481[0m:[38;5;10m[49m         assert_same("stdin/pipe", &results[0], &results[1]);
[0m[49m[38;5;10m+    482[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    483[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    484[0m:[38;5;10m[49m     // stdin closed outright.
[0m[49m[38;5;10m+    485[0m:[38;5;10m[49m     let c = run_in_shell(c_binary(), r#"exec "$1" <&-"#);
[0m[49m[38;5;10m+    486[0m:[38;5;10m[49m     let r = run_in_shell(rust_binary(), r#"exec "$1" <&-"#);
[0m[49m[38;5;10m+    487[0m:[38;5;10m[49m     assert_same("stdin/closed", &c, &r);
[0m[49m[38;5;10m+    488[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    489[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    490[0m:[38;5;10m[49m /// `main(void)` ignores argv; confirm both agree for none, one, many, empty and
[0m[49m[38;5;10m+    491[0m:[38;5;10m[49m /// non-UTF-8 arguments.
[0m[49m[38;5;10m+    492[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    493[0m:[38;5;10m[49m fn argv_is_ignored_identically() {
[0m[49m[38;5;10m+    494[0m:[38;5;10m[49m     let cases: Vec<Vec<&str>> = vec![
[0m[49m[38;5;10m+    495[0m:[38;5;10m[49m         vec![],
[0m[49m[38;5;10m+    496[0m:[38;5;10m[49m         vec![""],
[0m[49m[38;5;10m+    497[0m:[38;5;10m[49m         vec!["-h"],
[0m[49m[38;5;10m+    498[0m:[38;5;10m[49m         vec!["--help"],
[0m[49m[38;5;10m+    499[0m:[38;5;10m[49m         vec!["0"],
[0m[49m[38;5;10m+    500[0m:[38;5;10m[49m         vec!["a", "b", "c"],
[0m[49m[38;5;10m+    501[0m:[38;5;10m[49m         vec!["--", "-1", "999999999999999999999"],
[0m[49m[38;5;10m+    502[0m:[38;5;10m[49m         vec!["\u{2713}", "café", "日本語"],
[0m[49m[38;5;10m+    503[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    504[0m:[38;5;10m[49m     for (i, args) in cases.iter().enumerate() {
[0m[49m[38;5;10m+    505[0m:[38;5;10m[49m         let c = run_plain(c_binary(), args, None, manifest_dir(), Env::Inherit);
[0m[49m[38;5;10m+    506[0m:[38;5;10m[49m         let r = run_plain(rust_binary(), args, None, manifest_dir(), Env::Inherit);
[0m[49m[38;5;10m+    507[0m:[38;5;10m[49m         assert_same(&format!("argv/{i}:{args:?}"), &c, &r);
[0m[49m[38;5;10m+    508[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    509[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    510[0m:[38;5;10m[49m     // A great many arguments, and one very long argument.
[0m[49m[38;5;10m+    511[0m:[38;5;10m[49m     let many: Vec<String> = (0..500).map(|i| i.to_string()).collect();
[0m[49m[38;5;10m+    512[0m:[38;5;10m[49m     let many: Vec<&str> = many.iter().map(String::as_str).collect();
