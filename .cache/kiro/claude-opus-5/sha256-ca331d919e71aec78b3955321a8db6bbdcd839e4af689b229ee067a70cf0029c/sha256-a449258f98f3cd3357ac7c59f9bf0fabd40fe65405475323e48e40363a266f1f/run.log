[0m[49m[38;5;10m+    557[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    558[0m:[38;5;10m[49m /// Output is fully deterministic across repeated runs, and identical between the
[0m[49m[38;5;10m+    559[0m:[38;5;10m[49m /// two programs each time. A hash-order or address-dependent difference would
[0m[49m[38;5;10m+    560[0m:[38;5;10m[49m /// surface here.
[0m[49m[38;5;10m+    561[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    562[0m:[38;5;10m[49m fn repeated_runs_are_byte_identical() {
[0m[49m[38;5;10m+    563[0m:[38;5;10m[49m     let mut c_runs = Vec::new();
[0m[49m[38;5;10m+    564[0m:[38;5;10m[49m     let mut r_runs = Vec::new();
[0m[49m[38;5;10m+    565[0m:[38;5;10m[49m     for i in 0..5 {
[0m[49m[38;5;10m+    566[0m:[38;5;10m[49m         let c = run_plain(c_binary(), &[], None, manifest_dir(), Env::Inherit);
[0m[49m[38;5;10m+    567[0m:[38;5;10m[49m         let r = run_plain(rust_binary(), &[], None, manifest_dir(), Env::Inherit);
[0m[49m[38;5;10m+    568[0m:[38;5;10m[49m         assert_same(&format!("repeat/{i}"), &c, &r);
[0m[49m[38;5;10m+    569[0m:[38;5;10m[49m         c_runs.push(c);
[0m[49m[38;5;10m+    570[0m:[38;5;10m[49m         r_runs.push(r);
[0m[49m[38;5;10m+    571[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    572[0m:[38;5;10m[49m     for i in 1..c_runs.len() {
[0m[49m[38;5;10m+    573[0m:[38;5;10m[49m         assert_eq!(c_runs[0], c_runs[i], "C run {i} differs from C run 0");
[0m[49m[38;5;10m+    574[0m:[38;5;10m[49m         assert_eq!(r_runs[0], r_runs[i], "Rust run {i} differs from Rust run 0");
[0m[49m[38;5;10m+    575[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    576[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    577[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    578[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    579[0m:[38;5;10m[49m // Phase C: stream wiring, buffering order and signal disposition
[0m[49m[38;5;10m+    580[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    581[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    582[0m:[38;5;10m[49m /// Separate regular files: stdout is fully buffered in both cases, so this is
[0m[49m[38;5;10m+    583[0m:[38;5;10m[49m /// the same content as the piped baseline but reached through a different glibc
[0m[49m[38;5;10m+    584[0m:[38;5;10m[49m /// buffering decision.
[0m[49m[38;5;10m+    585[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    586[0m:[38;5;10m[49m fn separate_regular_files_match() {
[0m[49m[38;5;10m+    587[0m:[38;5;10m[49m     let dir = scratch("separate_files");
[0m[49m[38;5;10m+    588[0m:[38;5;10m[49m     let c = run_to_separate_files(c_binary(), &dir, "c");
[0m[49m[38;5;10m+    589[0m:[38;5;10m[49m     let r = run_to_separate_files(rust_binary(), &dir, "r");
[0m[49m[38;5;10m+    590[0m:[38;5;10m[49m     assert_same("streams/separate_files", &c, &r);
[0m[49m[38;5;10m+    591[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    592[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    593[0m:[38;5;10m[49m /// `prog >file 2>&1`: the interleaving is decided by buffering. glibc holds the
[0m[49m[38;5;10m+    594[0m:[38;5;10m[49m /// 1499 bytes of stdout until `exit`, so both stderr lines appear *first* in the
[0m[49m[38;5;10m+    595[0m:[38;5;10m[49m /// merged file even though they are printed in the middle of the run. A Rust
[0m[49m[38;5;10m+    596[0m:[38;5;10m[49m /// translation using line-buffered `println!` would put them in a different
[0m[49m[38;5;10m+    597[0m:[38;5;10m[49m /// place, so this case is the one that pins the buffering emulation down.
[0m[49m[38;5;10m+    598[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    599[0m:[38;5;10m[49m fn merged_into_one_file_matches_including_order() {
[0m[49m[38;5;10m+    600[0m:[38;5;10m[49m     let dir = scratch("merged_file");
[0m[49m[38;5;10m+    601[0m:[38;5;10m[49m     let c = run_merged_to_file(c_binary(), &dir, "c");
[0m[49m[38;5;10m+    602[0m:[38;5;10m[49m     let r = run_merged_to_file(rust_binary(), &dir, "r");
[0m[49m[38;5;10m+    603[0m:[38;5;10m[49m     assert_same("streams/merged_file", &c, &r);
[0m[49m[38;5;10m+    604[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    605[0m:[38;5;10m[49m     let merged = String::from_utf8(c.stdout.clone()).unwrap();
[0m[49m[38;5;10m+    606[0m:[38;5;10m[49m     let first_err = merged
[0m[49m[38;5;10m+    607[0m:[38;5;10m[49m         .find("Error: Node with ID 2 already exists")
[0m[49m[38;5;10m+    608[0m:[38;5;10m[49m         .expect("stderr line present in merged output");
[0m[49m[38;5;10m+    609[0m:[38;5;10m[49m     let banner = merged.find("TREE WITH HASHMAP ID MAPPING TESTS").expect("banner");
[0m[49m[38;5;10m+    610[0m:[38;5;10m[49m     assert!(
[0m[49m[38;5;10m+    611[0m:[38;5;10m[49m         first_err < banner,
[0m[49m[38;5;10m+    612[0m:[38;5;10m[49m         "expected fully buffered stdout to land after unbuffered stderr"
[0m[49m[38;5;10m+    613[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    614[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    615[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    616[0m:[38;5;10m[49m /// `prog 2>&1 | reader`: both streams share a pipe.
[0m[49m[38;5;10m+    617[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    618[0m:[38;5;10m[49m fn merged_into_one_pipe_matches_including_order() {
[0m[49m[38;5;10m+    619[0m:[38;5;10m[49m     let c = run_merged_to_pipe(c_binary());
[0m[49m[38;5;10m+    620[0m:[38;5;10m[49m     let r = run_merged_to_pipe(rust_binary());
[0m[49m[38;5;10m+    621[0m:[38;5;10m[49m     assert_same("streams/merged_pipe", &c, &r);
[0m[49m[38;5;10m+    622[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    623[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    624[0m:[38;5;10m[49m /// Discarding one stream must not perturb the other.
[0m[49m[38;5;10m+    625[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    626[0m:[38;5;10m[49m fn discarded_streams_match() {
[0m[49m[38;5;10m+    627[0m:[38;5;10m[49m     let c = run_stdout_to_device(c_binary(), "/dev/null");
[0m[49m[38;5;10m+    628[0m:[38;5;10m[49m     let r = run_stdout_to_device(rust_binary(), "/dev/null");
[0m[49m[38;5;10m+    629[0m:[38;5;10m[49m     assert_same("streams/stdout_devnull", &c, &r);
[0m[49m[38;5;10m+    630[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    631[0m:[38;5;10m[49m     let c = run_in_shell(c_binary(), r#"exec "$1" 2>/dev/null"#);
[0m[49m[38;5;10m+    632[0m:[38;5;10m[49m     let r = run_in_shell(rust_binary(), r#"exec "$1" 2>/dev/null"#);
[0m[49m[38;5;10m+    633[0m:[38;5;10m[49m     assert_same("streams/stderr_devnull", &c, &r);
[0m[49m[38;5;10m+    634[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    635[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    636[0m:[38;5;10m[49m /// Closed descriptors. C's `printf` fails with `EBADF` and the return value is
[0m[49m[38;5;10m+    637[0m:[38;5;10m[49m /// ignored, so the program still exits 0; the Rust side must do the same rather
[0m[49m[38;5;10m+    638[0m:[38;5;10m[49m /// than panicking on a write error.
[0m[49m[38;5;10m+    639[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    640[0m:[38;5;10m[49m fn closed_descriptors_match() {
[0m[49m[38;5;10m+    641[0m:[38;5;10m[49m     let c = run_in_shell(c_binary(), r#"exec "$1" >&-"#);
[0m[49m[38;5;10m+    642[0m:[38;5;10m[49m     let r = run_in_shell(rust_binary(), r#"exec "$1" >&-"#);
[0m[49m[38;5;10m+    643[0m:[38;5;10m[49m     assert_same("streams/stdout_closed", &c, &r);
[0m[49m[38;5;10m+    644[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    645[0m:[38;5;10m[49m     let c = run_in_shell(c_binary(), r#"exec "$1" 2>&-"#);
[0m[49m[38;5;10m+    646[0m:[38;5;10m[49m     let r = run_in_shell(rust_binary(), r#"exec "$1" 2>&-"#);
[0m[49m[38;5;10m+    647[0m:[38;5;10m[49m     assert_same("streams/stderr_closed", &c, &r);
[0m[49m[38;5;10m+    648[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    649[0m:[38;5;10m[49m     let c = run_in_shell(c_binary(), r#"exec "$1" >&- 2>&-"#);
[0m[49m[38;5;10m+    650[0m:[38;5;10m[49m     let r = run_in_shell(rust_binary(), r#"exec "$1" >&- 2>&-"#);
[0m[49m[38;5;10m+    651[0m:[38;5;10m[49m     assert_same("streams/both_closed", &c, &r);
[0m[49m[38;5;10m+    652[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    653[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    654[0m:[38;5;10m[49m /// `/dev/full` makes every write fail with `ENOSPC`. C ignores `printf`'s return
[0m[49m[38;5;10m+    655[0m:[38;5;10m[49m /// value and exits 0; the Rust program must not turn the error into a panic or a
[0m[49m[38;5;10m+    656[0m:[38;5;10m[49m /// non-zero status.
[0m[49m[38;5;10m+    657[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    658[0m:[38;5;10m[49m fn write_errors_are_ignored_identically() {
[0m[49m[38;5;10m+    659[0m:[38;5;10m[49m     let c = run_stdout_to_device(c_binary(), "/dev/full");
[0m[49m[38;5;10m+    660[0m:[38;5;10m[49m     let r = run_stdout_to_device(rust_binary(), "/dev/full");
[0m[49m[38;5;10m+    661[0m:[38;5;10m[49m     assert_same("streams/dev_full", &c, &r);
[0m[49m[38;5;10m+    662[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    663[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    664[0m:[38;5;10m[49m /// Writing to a pipe with no reader. A C program starts with `SIGPIPE` at
[0m[49m[38;5;10m+    665[0m:[38;5;10m[49m /// `SIG_DFL` and dies (wait status 141); the Rust runtime installs `SIG_IGN`
[0m[49m[38;5;10m+    666[0m:[38;5;10m[49m /// before `main`, which would make the failed write invisible and the exit
[0m[49m[38;5;10m+    667[0m:[38;5;10m[49m /// status 0. Only the agreement between the two is asserted, so the test states
[0m[49m[38;5;10m+    668[0m:[38;5;10m[49m /// the real requirement without depending on which side of the race the reader's
[0m[49m[38;5;10m+    669[0m:[38;5;10m[49m /// exit lands on.
[0m[49m[38;5;10m+    670[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    671[0m:[38;5;10m[49m fn sigpipe_disposition_matches() {
[0m[49m[38;5;10m+    672[0m:[38;5;10m[49m     let c = run_in_shell(c_binary(), r#""$1" 2>/dev/null > >(exec true); exit $?"#);
[0m[49m[38;5;10m+    673[0m:[38;5;10m[49m     let r = run_in_shell(rust_binary(), r#""$1" 2>/dev/null > >(exec true); exit $?"#);
[0m[49m[38;5;10m+    674[0m:[38;5;10m[49m     assert_same("signals/sigpipe_stdout", &c, &r);
[0m[49m[38;5;10m+    675[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    676[0m:[38;5;10m[49m     let c = run_in_shell(c_binary(), r#""$1" >/dev/null 2> >(exec true); exit $?"#);
[0m[49m[38;5;10m+    677[0m:[38;5;10m[49m     let r = run_in_shell(rust_binary(), r#""$1" >/dev/null 2> >(exec true); exit $?"#);
[0m[49m[38;5;10m+    678[0m:[38;5;10m[49m     assert_same("signals/sigpipe_stderr", &c, &r);
[0m[49m[38;5;10m+    679[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    680[0m:[38;5;10m[49m     let c = run_in_shell(c_binary(), r#""$1" 2>&1 > >(exec true); exit $?"#);
[0m[49m[38;5;10m+    681[0m:[38;5;10m[49m     let r = run_in_shell(rust_binary(), r#""$1" 2>&1 > >(exec true); exit $?"#);
[0m[49m[38;5;10m+    682[0m:[38;5;10m[49m     assert_same("signals/sigpipe_merged", &c, &r);
[0m[49m[38;5;10m+    683[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    684[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    685[0m:[38;5;10m[49m /// A pipeline whose reader consumes only a prefix, and one that consumes
