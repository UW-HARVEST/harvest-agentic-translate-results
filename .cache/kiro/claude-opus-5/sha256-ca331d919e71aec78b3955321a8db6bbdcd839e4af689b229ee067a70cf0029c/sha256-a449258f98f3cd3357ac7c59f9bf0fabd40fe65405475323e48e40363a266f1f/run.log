[0m[49m[38;5;10m+    395[0m:[38;5;10m[49m     for line in [
[0m[49m[38;5;10m+    396[0m:[38;5;10m[49m         "[1] root",
[0m[49m[38;5;10m+    397[0m:[38;5;10m[49m         "  [2] child1",
[0m[49m[38;5;10m+    398[0m:[38;5;10m[49m         "    [5] gc1",
[0m[49m[38;5;10m+    399[0m:[38;5;10m[49m         "    [6] gc2",
[0m[49m[38;5;10m+    400[0m:[38;5;10m[49m         "  [3] child2",
