[0m[49m[38;5;10m+    533[0m:[38;5;10m[49m         &[("TERM", "dumb"), ("COLUMNS", "20")],
[0m[49m[38;5;10m+    534[0m:[38;5;10m[49m         &[("NO_COLOR", "1"), ("CLICOLOR_FORCE", "1")],
[0m[49m[38;5;10m+    535[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    536[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    537[0m:[38;5;10m[49m     let c = run_plain(c_binary(), &[], None, manifest_dir(), Env::Empty);
[0m[49m[38;5;10m+    538[0m:[38;5;10m[49m     let r = run_plain(rust_binary(), &[], None, manifest_dir(), Env::Empty);
[0m[49m[38;5;10m+    539[0m:[38;5;10m[49m     assert_same("env/empty", &c, &r);
[0m[49m[38;5;10m+    540[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    541[0m:[38;5;10m[49m     for pairs in LOCALES {
