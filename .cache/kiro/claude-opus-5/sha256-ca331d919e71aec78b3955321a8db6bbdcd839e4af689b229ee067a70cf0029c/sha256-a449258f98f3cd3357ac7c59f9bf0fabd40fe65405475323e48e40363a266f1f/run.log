[0m[49m[38;5;10m+    339[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    340[0m:[38;5;10m[49m /// The single run drives every branch class in the C source. Assert each one is
[0m[49m[38;5;10m+    341[0m:[38;5;10m[49m /// visible in the output, so the comparison cannot quietly shrink.
[0m[49m[38;5;10m+    342[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    343[0m:[38;5;10m[49m fn landmarks_prove_every_branch_class_is_exercised() {
[0m[49m[38;5;10m+    344[0m:[38;5;10m[49m     let c = run_plain(c_binary(), &[], None, manifest_dir(), Env::Inherit);
[0m[49m[38;5;10m+    345[0m:[38;5;10m[49m     let r = run_plain(rust_binary(), &[], None, manifest_dir(), Env::Inherit);
[0m[49m[38;5;10m+    346[0m:[38;5;10m[49m     assert_same("landmarks", &c, &r);
[0m[49m[38;5;10m+    347[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    348[0m:[38;5;10m[49m     let out = String::from_utf8(c.stdout.clone()).expect("stdout is UTF-8");
[0m[49m[38;5;10m+    349[0m:[38;5;10m[49m     let err = String::from_utf8(c.stderr.clone()).expect("stderr is UTF-8");
[0m[49m[38;5;10m+    350[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    351[0m:[38;5;10m[49m     // Non-ASCII framing: the box-drawing banner and the check/cross marks must
[0m[49m[38;5;10m+    352[0m:[38;5;10m[49m     // survive as the same bytes, not as `?` or replacement characters.
[0m[49m[38;5;10m+    353[0m:[38;5;10m[49m     for needle in [
[0m[49m[38;5;10m+    354[0m:[38;5;10m[49m         "╔════════════════════════════════════════╗",
[0m[49m[38;5;10m+    355[0m:[38;5;10m[49m         "║  TREE WITH HASHMAP ID MAPPING TESTS   ║",
[0m[49m[38;5;10m+    356[0m:[38;5;10m[49m         "╚════════════════════════════════════════╝",
[0m[49m[38;5;10m+    357[0m:[38;5;10m[49m         "✓ PASS: test_hashmap_basic",
[0m[49m[38;5;10m+    358[0m:[38;5;10m[49m     ] {
[0m[49m[38;5;10m+    359[0m:[38;5;10m[49m         assert!(out.contains(needle), "stdout missing {needle:?}");
[0m[49m[38;5;10m+    360[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    361[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    362[0m:[38;5;10m[49m     // One `✓ PASS:` line per test function in main.c, and no `✗ FAIL:` line.
[0m[49m[38;5;10m+    363[0m:[38;5;10m[49m     assert_eq!(out.matches("✓ PASS:").count(), 14, "expected 14 PASS lines");
[0m[49m[38;5;10m+    364[0m:[38;5;10m[49m     assert!(!out.contains("✗ FAIL:"), "unexpected FAIL line");
