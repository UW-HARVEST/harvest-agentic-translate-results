[0m[49m[38;5;10m+    543[0m:[38;5;10m[49m         let r = run_plain(rust_binary(), &[], None, manifest_dir(), Env::Only(pairs));
[0m[49m[38;5;10m+    544[0m:[38;5;10m[49m         assert_same(&format!("env/{pairs:?}"), &c, &r);
[0m[49m[38;5;10m+    545[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    546[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    547[0m:[38;5;10m[49m 
