[0m[49m[38;5;10m+    402[0m:[38;5;10m[49m         "      [10] ggc1",
[0m[49m[38;5;10m+    403[0m:[38;5;10m[49m         "  [4] child3",
[0m[49m[38;5;10m+    404[0m:[38;5;10m[49m         "    [8] gc4",
[0m[49m[38;5;10m+    405[0m:[38;5;10m[49m         "    [9] gc5",
[0m[49m[38;5;10m+    406[0m:[38;5;10m[49m     ] {
