[0m[49m[38;5;10m+    368[0m:[38;5;10m[49m         // hashmap: put/get/update/remove/contains, and resize under 100 keys
[0m[49m[38;5;10m+    369[0m:[38;5;10m[49m         "=== Testing Hashmap Basic Operations ===",
[0m[49m[38;5;10m+    370[0m:[38;5;10m[49m         "=== Testing Hashmap Collisions ===",
