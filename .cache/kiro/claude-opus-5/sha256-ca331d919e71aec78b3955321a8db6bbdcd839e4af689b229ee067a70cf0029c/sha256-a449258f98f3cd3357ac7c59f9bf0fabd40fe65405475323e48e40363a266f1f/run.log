[0m[49m[38;5;10m+    329[0m:[38;5;10m[49m     let co = run_plain(c, &[], None, cwd, Env::Inherit);
[0m[49m[38;5;10m+    330[0m:[38;5;10m[49m     let ro = run_plain(r, &[], None, cwd, Env::Inherit);
[0m[49m[38;5;10m+    331[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    332[0m:[38;5;10m[49m     assert!(!co.stdout.is_empty(), "C produced no stdout; nothing to compare");
[0m[49m[38;5;10m+    333[0m:[38;5;10m[49m     assert_same("baseline", &co, &ro);
[0m[49m[38;5;10m+    334[0m:[38;5;10m[49m }
