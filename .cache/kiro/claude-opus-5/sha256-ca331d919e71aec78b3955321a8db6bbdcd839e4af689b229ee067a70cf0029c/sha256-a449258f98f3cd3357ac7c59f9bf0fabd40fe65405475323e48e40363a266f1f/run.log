[0m[49m[38;5;10m+    408[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    409[0m:[38;5;10m[49m     // The `!tree->has_root` arm of tree_print is never reached by this driver.
[0m[49m[38;5;10m+    410[0m:[38;5;10m[49m     assert!(!out.contains("(empty tree)"));
[0m[49m[38;5;10m+    411[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    412[0m:[38;5;10m[49m     // Both `fprintf(stderr, ...)` error paths the driver reaches, in order.
[0m[49m[38;5;10m+    413[0m:[38;5;10m[49m     assert_eq!(
[0m[49m[38;5;10m+    414[0m:[38;5;10m[49m         err,
[0m[49m[38;5;10m+    415[0m:[38;5;10m[49m         "Error: Node with ID 2 already exists\nError: Parent has maximum children\n",
[0m[49m[38;5;10m+    416[0m:[38;5;10m[49m         "stderr does not match the two expected error paths"
[0m[49m[38;5;10m+    417[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    418[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    419[0m:[38;5;10m[49m     // Exit status: `return 0` from main, no signal.
[0m[49m[38;5;10m+    420[0m:[38;5;10m[49m     assert_eq!(
[0m[49m[38;5;10m+    421[0m:[38;5;10m[49m         c.status,
