[0m[49m[38;5;10m+    140[0m:[38;5;10m[49m fn golden_output_shape_for_zero() {
[0m[49m[38;5;10m+    141[0m:[38;5;10m[49m     let c = run(c_bin(), b"0");
[0m[49m[38;5;10m+    142[0m:[38;5;10m[49m     let expected = "\
[0m[49m[38;5;10m+    143[0m:[38;5;10m[49m The house has 2 floors, 5 bedrooms, and 2.5 bathrooms
