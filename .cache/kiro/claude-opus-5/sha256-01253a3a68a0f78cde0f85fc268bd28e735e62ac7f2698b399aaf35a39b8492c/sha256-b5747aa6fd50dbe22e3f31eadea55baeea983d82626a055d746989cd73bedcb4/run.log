static void show(int size, const char *src) {
    char *r = encode_base64(size, src);
    if (!r) { printf("NULL\n"); return; }
    printf("[%s]", r);
    /* dump raw bytes of the whole allocation-relevant prefix */
    size_t l = strlen(r);
    printf(" len=%zu\n", l);
    free(r);
}
int main(void) {
    show(0, NULL);
    show(5, NULL);
    show(0, "");
    show(0, "f"); show(0,"fo"); show(0,"foo"); show(0,"foob"); show(0,"fooba"); show(0,"foobar");
    show(3, "\xff\xfe\xfd");
    show(1, "\x80");
    show(6, "\x00\x01\x02\x03\x04\x05");
    show(-1, "abc");
    show(-5, "abc");
    show(2, "abcdef");
    show(0, "The quick brown fox jumps over the lazy dog!!");
    char big[300]; for (int i=0;i<300;i++) big[i]=(char)i; show(300, big);
    return 0;
}
