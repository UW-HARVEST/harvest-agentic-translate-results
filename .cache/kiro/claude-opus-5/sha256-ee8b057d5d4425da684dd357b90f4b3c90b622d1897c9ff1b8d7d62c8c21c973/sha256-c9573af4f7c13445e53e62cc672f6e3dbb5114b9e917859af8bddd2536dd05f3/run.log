[0m[49m[38;5;10m+    101[0m:[38;5;10m[49m                     7 => {
[0m[49m[38;5;10m+    102[0m:[38;5;10m[49m                         if trial & 2 != 0 {
[0m[49m[38;5;10m+    103[0m:[38;5;10m[49m                             *b |= 0x80
[0m[49m[38;5;10m+    104[0m:[38;5;10m[49m                         } else {
[0m[49m[38;5;10m+    105[0m:[38;5;10m[49m                             *b &= 0x7f
