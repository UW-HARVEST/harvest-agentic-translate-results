[0m[49m[38;5;10m+    510[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    511[0m:[38;5;10m[49m // CONFIGS.md row 79 — hmput_key on a NULL map with a string mode
[0m[49m[38;5;10m+    512[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    513[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    514[0m:[38;5;10m[49m /// `hmput_key(NULL, ..., mode >= STBDS_HM_STRING)` builds its own table and
[0m[49m[38;5;10m+    515[0m:[38;5;10m[49m /// sets `string.mode = STBDS_SH_DEFAULT` (ERRORS.md row 21) — no
[0m[49m[38;5;10m+    516[0m:[38;5;10m[49m /// `shmode_func` involved.  This is the `shput`-on-a-fresh-map path.
[0m[49m[38;5;10m+    517[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    518[0m:[38;5;10m[49m fn cfg_row_79_hmput_key_null_string_mode() {
[0m[49m[38;5;10m+    519[0m:[38;5;10m[49m     let (l, _g) = libs();
[0m[49m[38;5;10m+    520[0m:[38;5;10m[49m     for &m in [1i32, 2, 1000, i32::MAX].iter() {
[0m[49m[38;5;10m+    521[0m:[38;5;10m[49m         for &elemsize in [8usize, 16, 24].iter() {
[0m[49m[38;5;10m+    522[0m:[38;5;10m[49m             seed_both(l, 0xFACE);
[0m[49m[38;5;10m+    523[0m:[38;5;10m[49m             let mut rng = Rng::new(0xF_0079 + m as u64 + elemsize as u64);
[0m[49m[38;5;10m+    524[0m:[38;5;10m[49m             let mut keep_c = Keep::new();
[0m[49m[38;5;10m+    525[0m:[38;5;10m[49m             let mut keep_r = Keep::new();
[0m[49m[38;5;10m+    526[0m:[38;5;10m[49m             // NOTE: starts from NULL, not from shmode_func
[0m[49m[38;5;10m+    527[0m:[38;5;10m[49m             let mut map = Map::new(l, elemsize, 8, m, Pay::StrPtr);
[0m[49m[38;5;10m+    528[0m:[38;5;10m[49m             let mut ks: Vec<Vec<u8>> = vec![];
[0m[49m[38;5;10m+    529[0m:[38;5;10m[49m             unsafe {
[0m[49m[38;5;10m+    530[0m:[38;5;10m[49m                 while ks.len() < 30 {
[0m[49m[38;5;10m+    531[0m:[38;5;10m[49m                     let n = 1 + rng.below(25);
[0m[49m[38;5;10m+    532[0m:[38;5;10m[49m                     let k = rng.cstring(n);
[0m[49m[38;5;10m+    533[0m:[38;5;10m[49m                     if ks.contains(&k) {
[0m[49m[38;5;10m+    534[0m:[38;5;10m[49m                         continue;
[0m[49m[38;5;10m+    535[0m:[38;5;10m[49m                     }
[0m[49m[38;5;10m+    536[0m:[38;5;10m[49m                     ks.push(k.clone());
[0m[49m[38;5;10m+    537[0m:[38;5;10m[49m                     let (kc, kr) = (keep_c.add(&k), keep_r.add(&k));
[0m[49m[38;5;10m+    538[0m:[38;5;10m[49m                     let v = rng.bytes(elemsize - 8);
[0m[49m[38;5;10m+    539[0m:[38;5;10m[49m                     map.put(kc, kr, &v, 8);
[0m[49m[38;5;10m+    540[0m:[38;5;10m[49m                     map.assert_eq(&format!("mode={m} es={elemsize} fresh-string put"));
[0m[49m[38;5;10m+    541[0m:[38;5;10m[49m                     assert_eq!(
[0m[49m[38;5;10m+    542[0m:[38;5;10m[49m                         temp_key_str(map.raw_c()),
[0m[49m[38;5;10m+    543[0m:[38;5;10m[49m                         temp_key_str(map.raw_r()),
[0m[49m[38;5;10m+    544[0m:[38;5;10m[49m                         "mode={m} es={elemsize}: temp_key"
[0m[49m[38;5;10m+    545[0m:[38;5;10m[49m                     );
[0m[49m[38;5;10m+    546[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    547[0m:[38;5;10m[49m                 let (sc, _) = map.snaps();
[0m[49m[38;5;10m+    548[0m:[38;5;10m[49m                 assert_eq!(
[0m[49m[38;5;10m+    549[0m:[38;5;10m[49m                     sc.table.as_ref().unwrap().arena_mode,
[0m[49m[38;5;10m+    550[0m:[38;5;10m[49m                     1,
[0m[49m[38;5;10m+    551[0m:[38;5;10m[49m                     "mode={m}: a fresh string-mode table must get SH_DEFAULT"
[0m[49m[38;5;10m+    552[0m:[38;5;10m[49m                 );
[0m[49m[38;5;10m+    553[0m:[38;5;10m[49m                 for k in ks.iter() {
[0m[49m[38;5;10m+    554[0m:[38;5;10m[49m                     let (kc, kr) = (keep_c.add(k), keep_r.add(k));
[0m[49m[38;5;10m+    555[0m:[38;5;10m[49m                     let (a, b) = map.get_ts(kc, kr);
[0m[49m[38;5;10m+    556[0m:[38;5;10m[49m                     assert_eq!(a, b, "mode={m} fresh-string get");
[0m[49m[38;5;10m+    557[0m:[38;5;10m[49m                     assert!(a >= 0);
[0m[49m[38;5;10m+    558[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    559[0m:[38;5;10m[49m                 if m == 1 {
[0m[49m[38;5;10m+    560[0m:[38;5;10m[49m                     // mode == 1 makes the compaction re-find safe, so delete
