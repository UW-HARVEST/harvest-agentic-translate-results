[0m[49m[38;5;10m+    123[0m:[38;5;10m[49m                 let (a, b) = hb(l, &mut buf, len, 0x3141_5926);
[0m[49m[38;5;10m+    124[0m:[38;5;10m[49m                 assert_eq!(a, b, "signext sweep len={len} v={v}");
[0m[49m[38;5;10m+    125[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    126[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    127[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    128[0m:[38;5;10m[49m }
