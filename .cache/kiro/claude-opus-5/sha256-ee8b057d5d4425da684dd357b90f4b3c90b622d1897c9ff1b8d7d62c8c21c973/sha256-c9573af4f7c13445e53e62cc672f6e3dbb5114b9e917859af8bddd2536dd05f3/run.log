[0m[49m[38;5;10m+    416[0m:[38;5;10m[49m             let tr = (l.r.shmode_func)(elemsize, shmode);
[0m[49m[38;5;10m+    417[0m:[38;5;10m[49m             let sc = snap_hash(tc, elemsize, Pay::Raw);
[0m[49m[38;5;10m+    418[0m:[38;5;10m[49m             let sr = snap_hash(tr, elemsize, Pay::Raw);
[0m[49m[38;5;10m+    419[0m:[38;5;10m[49m             assert_snap(&sc, &sr, &format!("shmode_func(mode={shmode})"));
