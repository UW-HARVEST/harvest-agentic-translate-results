[0m[49m[38;5;10m+    574[0m:[38;5;10m[49m                 } else {
[0m[49m[38;5;10m+    575[0m:[38;5;10m[49m                     for k in ks.iter().rev() {
[0m[49m[38;5;10m+    576[0m:[38;5;10m[49m                         let (kc, kr) = (keep_c.add(k), keep_r.add(k));
[0m[49m[38;5;10m+    577[0m:[38;5;10m[49m                         map.del(kc, kr, 0);
[0m[49m[38;5;10m+    578[0m:[38;5;10m[49m                         map.assert_eq(&format!("mode={m} fresh-string del-last"));
