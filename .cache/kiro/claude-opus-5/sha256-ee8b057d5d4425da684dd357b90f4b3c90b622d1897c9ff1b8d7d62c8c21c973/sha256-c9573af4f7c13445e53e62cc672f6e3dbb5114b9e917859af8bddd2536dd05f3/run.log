[0m[49m[38;5;10m+    563[0m:[38;5;10m[49m                     for i in (1..order.len()).rev() {
[0m[49m[38;5;10m+    564[0m:[38;5;10m[49m                         let j = rng.below(i + 1);
[0m[49m[38;5;10m+    565[0m:[38;5;10m[49m                         order.swap(i, j);
[0m[49m[38;5;10m+    566[0m:[38;5;10m[49m                     }
[0m[49m[38;5;10m+    567[0m:[38;5;10m[49m                     for &idx in order.iter() {
[0m[49m[38;5;10m+    568[0m:[38;5;10m[49m                         let (kc, kr) = (keep_c.add(&ks[idx]), keep_r.add(&ks[idx]));
[0m[49m[38;5;10m+    569[0m:[38;5;10m[49m                         map.del(kc, kr, 0);
