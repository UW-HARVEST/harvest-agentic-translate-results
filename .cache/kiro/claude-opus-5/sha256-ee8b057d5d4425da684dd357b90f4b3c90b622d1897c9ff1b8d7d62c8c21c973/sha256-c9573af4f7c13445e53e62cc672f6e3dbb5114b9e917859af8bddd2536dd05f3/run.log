[0m[49m[38;5;10m+    497[0m:[38;5;10m[49m                     "absent delete must not touch used_count"
[0m[49m[38;5;10m+    498[0m:[38;5;10m[49m                 );
[0m[49m[38;5;10m+    499[0m:[38;5;10m[49m                 assert_eq!(
