[0m[49m[38;5;10m+    425[0m:[38;5;10m[49m             (l.c.hmfree_func)(base(tc, elemsize), elemsize);
[0m[49m[38;5;10m+    426[0m:[38;5;10m[49m             (l.r.hmfree_func)(base(tr, elemsize), elemsize);
[0m[49m[38;5;10m+    427[0m:[38;5;10m[49m         }
