[0m[49m[38;5;10m+    501[0m:[38;5;10m[49m                     before.table.as_ref().unwrap().tombstone_count,
[0m[49m[38;5;10m+    502[0m:[38;5;10m[49m                     "absent delete must not create a tombstone"
[0m[49m[38;5;10m+    503[0m:[38;5;10m[49m                 );
[0m[49m[38;5;10m+    504[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    505[0m:[38;5;10m[49m             m.free();
[0m[49m[38;5;10m+    506[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    507[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    508[0m:[38;5;10m[49m }
