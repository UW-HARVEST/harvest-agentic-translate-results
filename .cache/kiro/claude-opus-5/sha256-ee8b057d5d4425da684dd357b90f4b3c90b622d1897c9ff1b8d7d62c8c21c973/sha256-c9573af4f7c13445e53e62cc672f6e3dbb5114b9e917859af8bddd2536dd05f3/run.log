[0m[49m[38;5;10m+     97[0m:[38;5;10m[49m                         } else {
[0m[49m[38;5;10m+     98[0m:[38;5;10m[49m                             *b &= 0x7f
[0m[49m[38;5;10m+     99[0m:[38;5;10m[49m                         }
