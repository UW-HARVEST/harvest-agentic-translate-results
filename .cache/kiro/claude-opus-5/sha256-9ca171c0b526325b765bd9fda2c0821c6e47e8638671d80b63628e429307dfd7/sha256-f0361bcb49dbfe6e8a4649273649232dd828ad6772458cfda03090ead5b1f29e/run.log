[0m[49m[38;5;10m+    358[0m:[38;5;10m[49m         ),
[0m[49m[38;5;10m+    359[0m:[38;5;10m[49m     ]
[0m[49m[38;5;10m+    360[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    361[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    362[0m:[38;5;10m[49m /// Inputs on which the C never returns (`ERRORS.md` rows 12–13) must never be
[0m[49m[38;5;10m+    363[0m:[38;5;10m[49m /// fed to the libraries. Guard every generated input with this predicate.
[0m[49m[38;5;10m+    364[0m:[38;5;10m[49m fn terminates(x: i32, y: i32) -> bool {
[0m[49m[38;5;10m+    365[0m:[38;5;10m[49m     // Guard rejects immediately -> always terminates.
[0m[49m[38;5;10m+    366[0m:[38;5;10m[49m     if !(x > 0 || y > 0) {
[0m[49m[38;5;10m+    367[0m:[38;5;10m[49m         return true;
[0m[49m[38;5;10m+    368[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    369[0m:[38;5;10m[49m     // Accepted and y < 0: `y == 0` is never reached, so `y--` runs forever.
[0m[49m[38;5;10m+    370[0m:[38;5;10m[49m     y >= 0
[0m[49m[38;5;10m+    371[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    372[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    373[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    374[0m:[38;5;10m[49m fn phase_b_configuration_surface() {
[0m[49m[38;5;10m+    375[0m:[38;5;10m[49m     let _g = capture_lock().lock().unwrap();
[0m[49m[38;5;10m+    376[0m:[38;5;10m[49m     let mut cap = Capture::new("phase_b");
[0m[49m[38;5;10m+    377[0m:[38;5;10m[49m     let mut total = 0usize;
[0m[49m[38;5;10m+    378[0m:[38;5;10m[49m     for (i, (label, iters, gen)) in configs_rows().into_iter().enumerate() {
[0m[49m[38;5;10m+    379[0m:[38;5;10m[49m         let mut rng = Lcg::new(i as u64 + 1);
[0m[49m[38;5;10m+    380[0m:[38;5;10m[49m         for k in 0..iters {
[0m[49m[38;5;10m+    381[0m:[38;5;10m[49m             let (x, y) = gen(&mut rng);
[0m[49m[38;5;10m+    382[0m:[38;5;10m[49m             assert!(
[0m[49m[38;5;10m+    383[0m:[38;5;10m[49m                 terminates(x, y),
[0m[49m[38;5;10m+    384[0m:[38;5;10m[49m                 "{}: generated non-terminating input ({}, {})",
[0m[49m[38;5;10m+    385[0m:[38;5;10m[49m                 label,
[0m[49m[38;5;10m+    386[0m:[38;5;10m[49m                 x,
[0m[49m[38;5;10m+    387[0m:[38;5;10m[49m                 y
[0m[49m[38;5;10m+    388[0m:[38;5;10m[49m             );
[0m[49m[38;5;10m+    389[0m:[38;5;10m[49m             assert_same(&mut cap, &format!("{} iter {}", label, k), x, y);
[0m[49m[38;5;10m+    390[0m:[38;5;10m[49m             total += 1;
[0m[49m[38;5;10m+    391[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    392[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    393[0m:[38;5;10m[49m     drop(cap);
[0m[49m[38;5;10m+    394[0m:[38;5;10m[49m     println!("phase B: {} differential invocations matched", total);
[0m[49m[38;5;10m+    395[0m:[38;5;10m[49m     assert!(total >= 2000, "expected a substantial sweep, got {}", total);
[0m[49m[38;5;10m+    396[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    397[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    398[0m:[38;5;10m[49m /// Exhaustive small grid — every `(x, y)` pair in `[-4, 24]^2` that terminates.
[0m[49m[38;5;10m+    399[0m:[38;5;10m[49m /// This is the cross-product of all value classes in `CONFIGS.md` at full
[0m[49m[38;5;10m+    400[0m:[38;5;10m[49m /// density, so no class interaction can be missed.
[0m[49m[38;5;10m+    401[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    402[0m:[38;5;10m[49m fn phase_b_exhaustive_small_grid() {
[0m[49m[38;5;10m+    403[0m:[38;5;10m[49m     let _g = capture_lock().lock().unwrap();
[0m[49m[38;5;10m+    404[0m:[38;5;10m[49m     let mut cap = Capture::new("grid");
[0m[49m[38;5;10m+    405[0m:[38;5;10m[49m     let mut n = 0;
[0m[49m[38;5;10m+    406[0m:[38;5;10m[49m     for x in -4..=24 {
[0m[49m[38;5;10m+    407[0m:[38;5;10m[49m         for y in -4..=24 {
[0m[49m[38;5;10m+    408[0m:[38;5;10m[49m             if !terminates(x, y) {
[0m[49m[38;5;10m+    409[0m:[38;5;10m[49m                 continue;
[0m[49m[38;5;10m+    410[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    411[0m:[38;5;10m[49m             assert_same(&mut cap, &format!("grid({},{})", x, y), x, y);
[0m[49m[38;5;10m+    412[0m:[38;5;10m[49m             n += 1;
[0m[49m[38;5;10m+    413[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    414[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    415[0m:[38;5;10m[49m     drop(cap);
[0m[49m[38;5;10m+    416[0m:[38;5;10m[49m     println!("phase B grid: {} pairs matched", n);
[0m[49m[38;5;10m+    417[0m:[38;5;10m[49m     assert!(n > 800, "grid too small: {}", n);
[0m[49m[38;5;10m+    418[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    419[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    420[0m:[38;5;10m[49m /// Independent oracle for the C control flow, written straight from
[0m[49m[38;5;10m+    421[0m:[38;5;10m[49m /// `c_src/src/driver.c`. This catches the case where *both* `.so`s agree
[0m[49m[38;5;10m+    422[0m:[38;5;10m[49m /// because the Rust and the harness share a misunderstanding — it pins the
[0m[49m[38;5;10m+    423[0m:[38;5;10m[49m /// expected byte stream to the C source text itself.
[0m[49m[38;5;10m+    424[0m:[38;5;10m[49m fn oracle(mut x: i32, mut y: i32) -> Vec<u8> {
[0m[49m[38;5;10m+    425[0m:[38;5;10m[49m     let mut out = Vec::new();
[0m[49m[38;5;10m+    426[0m:[38;5;10m[49m     // Program counter over the C statements, so the `goto`s are literal jumps.
[0m[49m[38;5;10m+    427[0m:[38;5;10m[49m     #[derive(PartialEq)]
[0m[49m[38;5;10m+    428[0m:[38;5;10m[49m     enum Pc {
[0m[49m[38;5;10m+    429[0m:[38;5;10m[49m         Cond,
[0m[49m[38;5;10m+    430[0m:[38;5;10m[49m         Head,
[0m[49m[38;5;10m+    431[0m:[38;5;10m[49m         Label1,
[0m[49m[38;5;10m+    432[0m:[38;5;10m[49m         Label2,
[0m[49m[38;5;10m+    433[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    434[0m:[38;5;10m[49m     let mut pc = Pc::Cond;
[0m[49m[38;5;10m+    435[0m:[38;5;10m[49m     loop {
[0m[49m[38;5;10m+    436[0m:[38;5;10m[49m         match pc {
[0m[49m[38;5;10m+    437[0m:[38;5;10m[49m             Pc::Cond => {
[0m[49m[38;5;10m+    438[0m:[38;5;10m[49m                 if x > 0 || y > 0 {
[0m[49m[38;5;10m+    439[0m:[38;5;10m[49m                     pc = Pc::Head;
[0m[49m[38;5;10m+    440[0m:[38;5;10m[49m                 } else {
[0m[49m[38;5;10m+    441[0m:[38;5;10m[49m                     return out;
[0m[49m[38;5;10m+    442[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    443[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    444[0m:[38;5;10m[49m             Pc::Head => {
[0m[49m[38;5;10m+    445[0m:[38;5;10m[49m                 out.extend_from_slice(b"loop\n");
[0m[49m[38;5;10m+    446[0m:[38;5;10m[49m                 if x == 1 && y == 4 {
[0m[49m[38;5;10m+    447[0m:[38;5;10m[49m                     pc = Pc::Label2;
[0m[49m[38;5;10m+    448[0m:[38;5;10m[49m                 } else {
[0m[49m[38;5;10m+    449[0m:[38;5;10m[49m                     pc = Pc::Label1;
[0m[49m[38;5;10m+    450[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    451[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    452[0m:[38;5;10m[49m             Pc::Label1 => {
[0m[49m[38;5;10m+    453[0m:[38;5;10m[49m                 if x > 0 {
[0m[49m[38;5;10m+    454[0m:[38;5;10m[49m                     out.extend_from_slice(b"x\n");
[0m[49m[38;5;10m+    455[0m:[38;5;10m[49m                     x -= 1;
[0m[49m[38;5;10m+    456[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    457[0m:[38;5;10m[49m                 pc = Pc::Label2;
[0m[49m[38;5;10m+    458[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    459[0m:[38;5;10m[49m             Pc::Label2 => {
[0m[49m[38;5;10m+    460[0m:[38;5;10m[49m                 if y == 0 {
[0m[49m[38;5;10m+    461[0m:[38;5;10m[49m                     pc = Pc::Cond; // `continue`
[0m[49m[38;5;10m+    462[0m:[38;5;10m[49m                     continue;
[0m[49m[38;5;10m+    463[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    464[0m:[38;5;10m[49m                 out.extend_from_slice(b"y\n");
[0m[49m[38;5;10m+    465[0m:[38;5;10m[49m                 y -= 1;
[0m[49m[38;5;10m+    466[0m:[38;5;10m[49m                 pc = if x < 3 { Pc::Label1 } else { Pc::Cond };
[0m[49m[38;5;10m+    467[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    468[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    469[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    470[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    471[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    472[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    473[0m:[38;5;10m[49m fn phase_b_matches_independent_oracle() {
[0m[49m[38;5;10m+    474[0m:[38;5;10m[49m     let _g = capture_lock().lock().unwrap();
[0m[49m[38;5;10m+    475[0m:[38;5;10m[49m     let mut cap = Capture::new("oracle");
[0m[49m[38;5;10m+    476[0m:[38;5;10m[49m     let mut rng = Lcg::new(0xABCD);
[0m[49m[38;5;10m+    477[0m:[38;5;10m[49m     let mut checked = 0;
[0m[49m[38;5;10m+    478[0m:[38;5;10m[49m     // Fixed interesting points plus a randomized sweep.
[0m[49m[38;5;10m+    479[0m:[38;5;10m[49m     let mut cases: Vec<(i32, i32)> = vec![
[0m[49m[38;5;10m+    480[0m:[38;5;10m[49m         (0, 0),
[0m[49m[38;5;10m+    481[0m:[38;5;10m[49m         (1, 0),
[0m[49m[38;5;10m+    482[0m:[38;5;10m[49m         (0, 1),
[0m[49m[38;5;10m+    483[0m:[38;5;10m[49m         (1, 1),
[0m[49m[38;5;10m+    484[0m:[38;5;10m[49m         (1, 3),
[0m[49m[38;5;10m+    485[0m:[38;5;10m[49m         (1, 4),
[0m[49m[38;5;10m+    486[0m:[38;5;10m[49m         (1, 5),
[0m[49m[38;5;10m+    487[0m:[38;5;10m[49m         (2, 4),
[0m[49m[38;5;10m+    488[0m:[38;5;10m[49m         (3, 4),
[0m[49m[38;5;10m+    489[0m:[38;5;10m[49m         (4, 4),
[0m[49m[38;5;10m+    490[0m:[38;5;10m[49m         (3, 0),
[0m[49m[38;5;10m+    491[0m:[38;5;10m[49m         (5, 7),
[0m[49m[38;5;10m+    492[0m:[38;5;10m[49m         (i32::MIN, 3),
[0m[49m[38;5;10m+    493[0m:[38;5;10m[49m         (-1, 0),
[0m[49m[38;5;10m+    494[0m:[38;5;10m[49m         (0, -1),
[0m[49m[38;5;10m+    495[0m:[38;5;10m[49m         (-1, -1),
[0m[49m[38;5;10m+    496[0m:[38;5;10m[49m         (i32::MIN, i32::MIN),
[0m[49m[38;5;10m+    497[0m:[38;5;10m[49m         (0, i32::MIN),
[0m[49m[38;5;10m+    498[0m:[38;5;10m[49m         (i32::MIN, 0),
[0m[49m[38;5;10m+    499[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    500[0m:[38;5;10m[49m     for _ in 0..400 {
[0m[49m[38;5;10m+    501[0m:[38;5;10m[49m         cases.push((rng.range(-6, 30), rng.range(-6, 30)));
[0m[49m[38;5;10m+    502[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    503[0m:[38;5;10m[49m     for (x, y) in cases {
[0m[49m[38;5;10m+    504[0m:[38;5;10m[49m         if !terminates(x, y) {
[0m[49m[38;5;10m+    505[0m:[38;5;10m[49m             continue;
[0m[49m[38;5;10m+    506[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    507[0m:[38;5;10m[49m         let got = assert_same(&mut cap, &format!("oracle({},{})", x, y), x, y);
[0m[49m[38;5;10m+    508[0m:[38;5;10m[49m         let want = oracle(x, y);
[0m[49m[38;5;10m+    509[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    510[0m:[38;5;10m[49m             got,
[0m[49m[38;5;10m+    511[0m:[38;5;10m[49m             want,
[0m[49m[38;5;10m+    512[0m:[38;5;10m[49m             "both .so agree but disagree with the C-source oracle for driver({}, {})",
[0m[49m[38;5;10m+    513[0m:[38;5;10m[49m             x,
[0m[49m[38;5;10m+    514[0m:[38;5;10m[49m             y
[0m[49m[38;5;10m+    515[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    516[0m:[38;5;10m[49m         checked += 1;
[0m[49m[38;5;10m+    517[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    518[0m:[38;5;10m[49m     drop(cap);
[0m[49m[38;5;10m+    519[0m:[38;5;10m[49m     println!("phase B oracle: {} cases matched C, Rust and oracle", checked);
[0m[49m[38;5;10m+    520[0m:[38;5;10m[49m     assert!(checked > 300);
[0m[49m[38;5;10m+    521[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    522[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    523[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    524[0m:[38;5;10m[49m // Phase C — error / rejection surface (ERRORS.md rows 1–11)
[0m[49m[38;5;10m+    525[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    526[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    527[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    528[0m:[38;5;10m[49m fn phase_c_error_surface_rows_1_through_11() {
[0m[49m[38;5;10m+    529[0m:[38;5;10m[49m     let _g = capture_lock().lock().unwrap();
[0m[49m[38;5;10m+    530[0m:[38;5;10m[49m     let mut cap = Capture::new("phase_c");
[0m[49m[38;5;10m+    531[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    532[0m:[38;5;10m[49m     // Rows 1-6, 10: the loop-entry guard rejects. The C emits *nothing at all*;
[0m[49m[38;5;10m+    533[0m:[38;5;10m[49m     // that empty byte stream is the rejection signal (the function is `void`,
[0m[49m[38;5;10m+    534[0m:[38;5;10m[49m     // so there is no code to compare). Assert both are byte-identical AND
[0m[49m[38;5;10m+    535[0m:[38;5;10m[49m     // that the shared result is genuinely the rejection, not merely "equal".
[0m[49m[38;5;10m+    536[0m:[38;5;10m[49m     let rejecting: &[(&str, i32, i32)] = &[
[0m[49m[38;5;10m+    537[0m:[38;5;10m[49m         ("row 1: x==0,y==0", 0, 0),
[0m[49m[38;5;10m+    538[0m:[38;5;10m[49m         ("row 2: x==0,y==-1", 0, -1),
[0m[49m[38;5;10m+    539[0m:[38;5;10m[49m         ("row 3: x==-1,y==0", -1, 0),
[0m[49m[38;5;10m+    540[0m:[38;5;10m[49m         ("row 4: x==-1,y==-1", -1, -1),
[0m[49m[38;5;10m+    541[0m:[38;5;10m[49m         ("row 5: x==INT_MIN,y==INT_MIN", i32::MIN, i32::MIN),
[0m[49m[38;5;10m+    542[0m:[38;5;10m[49m         ("row 6a: x==INT_MIN,y==0", i32::MIN, 0),
[0m[49m[38;5;10m+    543[0m:[38;5;10m[49m         ("row 6b: x==0,y==INT_MIN", 0, i32::MIN),
[0m[49m[38;5;10m+    544[0m:[38;5;10m[49m         ("row 10: x==0,y==INT_MIN", 0, i32::MIN),
[0m[49m[38;5;10m+    545[0m:[38;5;10m[49m         ("row 10b: x==-7,y==INT_MIN", -7, i32::MIN),
[0m[49m[38;5;10m+    546[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    547[0m:[38;5;10m[49m     for (label, x, y) in rejecting {
[0m[49m[38;5;10m+    548[0m:[38;5;10m[49m         let out = assert_same(&mut cap, label, *x, *y);
[0m[49m[38;5;10m+    549[0m:[38;5;10m[49m         assert!(
[0m[49m[38;5;10m+    550[0m:[38;5;10m[49m             out.is_empty(),
[0m[49m[38;5;10m+    551[0m:[38;5;10m[49m             "{}: expected the guard to reject with zero output, got {}",
[0m[49m[38;5;10m+    552[0m:[38;5;10m[49m             label,
