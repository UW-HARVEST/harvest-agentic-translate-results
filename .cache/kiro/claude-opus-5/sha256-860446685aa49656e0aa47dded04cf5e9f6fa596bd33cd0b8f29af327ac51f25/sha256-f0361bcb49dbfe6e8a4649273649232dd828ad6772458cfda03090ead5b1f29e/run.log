========== src/cbind.rs ==========
     1	
     2	//! Minimal bindings to the platform C library.
     3	//!
     4	//! The original library relies on `stdio` streams, `malloc`/`free` and the
     5	//! `str*` family. Re-using the very same C entry points (instead of Rust
     6	//! equivalents) keeps the observable behaviour - buffering, interleaving with a
     7	//! caller's own stdio writes, allocator identity, `atoi`/`getenv` semantics -
     8	//! bit-for-bit identical to the C implementation.
     9	
    10	#![allow(non_camel_case_types)]
    11	
    12	use core::ffi::{c_char, c_int, c_void};
    13	
    14	/// Opaque `FILE`.
    15	#[repr(C)]
    16	pub struct FILE {
    17	    _private: [u8; 0],
    18	}
    19	
    20	pub const EXIT_FAILURE: c_int = 1;
    21	
    22	extern "C" {
    23	    pub static mut stderr: *mut FILE;
    24	
    25	    pub fn fopen(path: *const c_char, mode: *const c_char) -> *mut FILE;
    26	    pub fn fclose(stream: *mut FILE) -> c_int;
    27	    pub fn fprintf(stream: *mut FILE, format: *const c_char, ...) -> c_int;
    28	    pub fn printf(format: *const c_char, ...) -> c_int;
    29	
    30	    pub fn malloc(size: usize) -> *mut c_void;
    31	    pub fn free(ptr: *mut c_void);
    32	
    33	    pub fn getenv(name: *const c_char) -> *mut c_char;
    34	    pub fn atoi(s: *const c_char) -> c_int;
    35	
    36	    pub fn strlen(s: *const c_char) -> usize;
    37	    pub fn strchr(s: *const c_char, c: c_int) -> *mut c_char;
    38	    pub fn strncpy(dst: *mut c_char, src: *const c_char, n: usize) -> *mut c_char;
    39	}
========== src/logger.rs ==========
     1	
     2	//! Translation of `c_src/src/logger.c`.
     3	
     4	use core::ffi::{c_char, c_int};
     5	use core::ptr;
     6	
     7	use crate::cbind::{fclose, fopen, fprintf, getenv, FILE};
     8	
     9	/// `static FILE *log_file = NULL;`
    10	static mut LOG_FILE: *mut FILE = ptr::null_mut();
    11	
    12	/// `int initialize_logger();`
    13	///
    14	/// Opens `$LOG_FILE` (or `default.log`) for appending. Note that, exactly like
    15	/// the C original, a second call simply overwrites the stored handle without
    16	/// closing the previous one.
    17	#[unsafe(no_mangle)]
    18	pub unsafe extern "C" fn initialize_logger() -> c_int {
    19	    let log_file_env: *const c_char = getenv(c"LOG_FILE".as_ptr());
    20	    let log_file_path: *const c_char = if !log_file_env.is_null() {
    21	        log_file_env
    22	    } else {
    23	        c"default.log".as_ptr()
    24	    };
    25	
    26	    LOG_FILE = fopen(log_file_path, c"a".as_ptr());
    27	    if LOG_FILE.is_null() {
    28	        fprintf(
    29	            crate::cbind::stderr,
    30	            c"Failed to open log file: %s\n".as_ptr(),
    31	            log_file_path,
    32	        );
    33	        return -1;
    34	    }
    35	
    36	    log_info(c"Logger initialized.".as_ptr());
    37	    0
    38	}
    39	
    40	/// `void log_info(const char *message);`
    41	#[unsafe(no_mangle)]
    42	pub unsafe extern "C" fn log_info(message: *const c_char) {
    43	    if !LOG_FILE.is_null() {
    44	        fprintf(LOG_FILE, c"[INFO] %s\n".as_ptr(), message);
    45	    }
    46	}
    47	
    48	/// `void log_warning(const char *message);`
    49	#[unsafe(no_mangle)]
    50	pub unsafe extern "C" fn log_warning(message: *const c_char) {
    51	    if !LOG_FILE.is_null() {
    52	        fprintf(LOG_FILE, c"[WARNING] %s\n".as_ptr(), message);
    53	    }
    54	}
    55	
    56	/// `void log_error(const char *message);`
    57	#[unsafe(no_mangle)]
    58	pub unsafe extern "C" fn log_error(message: *const c_char) {
    59	    if !LOG_FILE.is_null() {
    60	        fprintf(LOG_FILE, c"[ERROR] %s\n".as_ptr(), message);
    61	    }
    62	}
    63	
    64	/// `void finalize_logger();`
    65	///
    66	/// Mirrors the C original: the handle is closed but *not* reset to `NULL`, so
    67	/// subsequent logging calls still see a non-NULL (now dangling) handle.
    68	#[unsafe(no_mangle)]
    69	pub unsafe extern "C" fn finalize_logger() {
    70	    if !LOG_FILE.is_null() {
    71	        log_info(c"Logger finalized.".as_ptr());
    72	        fclose(LOG_FILE);
    73	    }
    74	}
