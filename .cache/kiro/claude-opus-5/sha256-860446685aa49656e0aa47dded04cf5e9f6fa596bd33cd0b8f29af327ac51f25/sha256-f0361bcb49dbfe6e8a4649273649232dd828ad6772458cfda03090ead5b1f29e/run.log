    11	/// ```c
    12	/// typedef struct {
    13	///     char description[256];
    14	///     int priority;
    15	/// } Task;
    16	/// ```
    17	#[repr(C)]
    18	pub struct Task {
    19	    pub description: [c_char; 256],
    20	    pub priority: c_int,
    21	}
    22	
    23	/// ```c
    24	/// typedef struct {
    25	///     Task *tasks;
    26	///     int max_tasks;
    27	///     int task_count;
    28	/// } TaskManager;
    29	/// ```
    30	#[repr(C)]
    31	pub struct TaskManager {
    32	    pub tasks: *mut Task,
    33	    pub max_tasks: c_int,
    34	    pub task_count: c_int,
    35	}
    36	
    37	// Layout must match the C structs exactly; the ABI depends on it.
    38	const _: () = assert!(size_of::<Task>() == 260);
    39	const _: () = assert!(size_of::<TaskManager>() == 16);
    40	
    41	/// `TaskManager *create_task_manager();`
    42	#[unsafe(no_mangle)]
    43	pub unsafe extern "C" fn create_task_manager() -> *mut TaskManager {
    44	    let manager = malloc(size_of::<TaskManager>()) as *mut TaskManager;
    45	    if manager.is_null() {
    46	        log_error(c"Failed to allocate memory for TaskManager.".as_ptr());
    47	        return ptr::null_mut();
    48	    }
    49	
    50	    let max_tasks_env: *const c_char = getenv(c"MAX_TASKS".as_ptr());
    51	    let max_tasks: c_int = if !max_tasks_env.is_null() {
    52	        atoi(max_tasks_env)
    53	    } else {
    54	        10
    55	    };
    56	    addr_of_mut!((*manager).max_tasks).write(max_tasks);
    57	    addr_of_mut!((*manager).task_count).write(0);
    58	
    59	    // `manager->max_tasks * sizeof(Task)` in C promotes the (possibly negative)
    60	    // int to size_t and then multiplies with wrap-around; reproduce that.
    61	    let bytes = (max_tasks as isize as usize).wrapping_mul(size_of::<Task>());
    62	    let tasks = malloc(bytes) as *mut Task;
    63	    addr_of_mut!((*manager).tasks).write(tasks);
    64	    if tasks.is_null() {
    65	        log_error(c"Failed to allocate memory for tasks.".as_ptr());
    66	        free(manager as *mut c_void);
    67	        return ptr::null_mut();
    68	    }
    69	
    70	    log_info(c"TaskManager created successfully.".as_ptr());
    71	    manager
    72	}
    73	
    74	/// `void add_task(TaskManager *manager, const char *description, int priority);`
    75	#[unsafe(no_mangle)]
    76	pub unsafe extern "C" fn add_task(
    77	    manager: *mut TaskManager,
    78	    description: *const c_char,
    79	    priority: c_int,
    80	) {
    81	    if (*manager).task_count >= (*manager).max_tasks {
    82	        log_warning(c"Cannot add task: Maximum task limit reached.".as_ptr());
    83	        return;
    84	    }
    85	
    86	    let index = (*manager).task_count;
    87	    (*manager).task_count = index + 1;
    88	    let task: *mut Task = (*manager).tasks.offset(index as isize);
    89	
    90	    let desc = addr_of_mut!((*task).description) as *mut c_char;
    91	    strncpy(desc, description, 256 - 1);
    92	    *desc.add(256 - 1) = 0;
    93	    addr_of_mut!((*task).priority).write(priority);
    94	
    95	    log_info(c"Task added successfully.".as_ptr());
    96	}
    97	
    98	/// `void print_tasks(const TaskManager *manager);`
    99	#[unsafe(no_mangle)]
   100	pub unsafe extern "C" fn print_tasks(manager: *const TaskManager) {
   101	    printf(c"Tasks:\n".as_ptr());
   102	    let mut i: c_int = 0;
   103	    while i < (*manager).task_count {
   104	        let task: *const Task = (*manager).tasks.offset(i as isize);
   105	        printf(
   106	            c"  [%d] %s (Priority: %d)\n".as_ptr(),
   107	            i + 1,
   108	            addr_of!((*task).description) as *const c_char,
   109	            (*task).priority,
   110	        );
   111	        i += 1;
   112	    }
   113	}
   114	
   115	/// `void destroy_task_manager(TaskManager *manager);`
   116	#[unsafe(no_mangle)]
   117	pub unsafe extern "C" fn destroy_task_manager(manager: *mut TaskManager) {
   118	    free((*manager).tasks as *mut c_void);
   119	    free(manager as *mut c_void);
   120	    log_info(c"TaskManager destroyed successfully.".as_ptr());
   121	}
