     1	
     2	//! Translation of `c_src/src/driver.c`.
     3	
     4	use core::ffi::{c_char, c_int, c_void};
     5	
     6	use crate::cbind::{fprintf, free, malloc, strchr, strlen, strncpy, EXIT_FAILURE};
     7	use crate::logger::{finalize_logger, initialize_logger};
     8	use crate::task_manager::{add_task, create_task_manager, destroy_task_manager, print_tasks};
     9	
    10	/// `int driver(const char *tasks);`
    11	///
    12	/// Splits `tasks` on `'\n'` and registers every line - including empty ones -
    13	/// with an incrementing priority starting at 1, then prints the task list.
    14	#[unsafe(no_mangle)]
    15	pub unsafe extern "C" fn driver(tasks: *const c_char) -> c_int {
    16	    let res = initialize_logger();
    17	    if res != 0 {
    18	        return EXIT_FAILURE;
    19	    }
    20	
    21	    let manager = create_task_manager();
    22	    if manager.is_null() {
    23	        return EXIT_FAILURE;
    24	    }
    25	
    26	    let mut start: *const c_char = tasks;
    27	    let mut priority: c_int = 1;
    28	    while *start != 0 {
    29	        let mut end: *const c_char = strchr(start, b'\n' as c_int);
    30	        if end.is_null() {
    31	            end = start.add(strlen(start));
    32	        }
    33	
    34	        // Extract the current task
    35	        let length = end.offset_from(start) as usize;
    36	        let task = malloc(length + 1) as *mut c_char;
    37	        if task.is_null() {
    38	            fprintf(
    39	                crate::cbind::stderr,
    40	                c"Error: Failed to allocate memory for task.\n".as_ptr(),
    41	            );
    42	            destroy_task_manager(manager);
    43	            finalize_logger();
    44	            return EXIT_FAILURE;
    45	        }
    46	        strncpy(task, start, length);
    47	        *task.add(length) = 0;
    48	
    49	        add_task(manager, task, priority);
    50	        priority += 1;
    51	        free(task as *mut c_void);
    52	        start = if *end == b'\n' as c_char {
    53	            end.add(1)
    54	        } else {
    55	            end
    56	        };
    57	    }
    58	
    59	    print_tasks(manager);
    60	
    61	    destroy_task_manager(manager);
    62	    finalize_logger();
    63	
    64	    0
    65	}
