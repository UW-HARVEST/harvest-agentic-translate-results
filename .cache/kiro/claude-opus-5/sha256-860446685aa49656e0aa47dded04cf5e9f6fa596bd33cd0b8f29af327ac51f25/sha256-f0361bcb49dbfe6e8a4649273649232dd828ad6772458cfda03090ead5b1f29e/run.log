#!/usr/bin/env bash
# Mutation-coverage check: inject a known bug into the Rust, confirm the
# differential suite catches it, then revert. Proves the tests are not vacuous.
set -uo pipefail
cd "$(dirname "$0")/translation"
mkdir -p /tmp/mutbak && cp src/*.rs /tmp/mutbak/

restore() { cp /tmp/mutbak/*.rs src/; }
trap restore EXIT

run_one() {
  local name="$1" file="$2" from="$3" to="$4"
  restore
  if ! grep -qF -- "$from" "src/$file"; then echo "SKIP  $name (pattern absent)"; return; fi
  perl -0pi -e "BEGIN{\$f=q{$from};\$t=q{$to}} s/\Q\$f\E/\$t/" "src/$file"
  if ! grep -qF -- "$to" "src/$file"; then echo "SKIP  $name (substitution failed)"; return; fi
  if ! timeout 300 cargo build --release >/dev/null 2>&1; then echo "SKIP  $name (does not compile)"; return; fi
  out=$(timeout 300 cargo test --release -- --test-threads=1 2>&1)
  failed=$(echo "$out" | grep -oE '^test [a-z0-9_]+ \.\.\. FAILED' | wc -l)
  if [ "$failed" -gt 0 ]; then
    echo "CAUGHT $name  ($failed tests failed) e.g. $(echo "$out" | grep -oE '^test [a-z0-9_]+ \.\.\. FAILED' | head -1 | awk '{print $2}')"
  else
    echo "MISSED $name  <-- BLIND SPOT"
  fi
}

