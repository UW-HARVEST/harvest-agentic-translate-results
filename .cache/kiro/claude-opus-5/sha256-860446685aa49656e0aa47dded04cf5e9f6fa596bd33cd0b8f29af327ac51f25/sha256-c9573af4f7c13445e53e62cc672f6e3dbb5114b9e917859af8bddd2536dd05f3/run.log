    25	
    26	//! Minimal bindings to the platform C library.
    27	//!
    28	//! The original library relies on `stdio` streams, `malloc`/`free` and the
    29	//! `str*` family. Re-using the very same C entry points (instead of Rust
    30	//! equivalents) keeps the observable behaviour - buffering, interleaving with a
    31	//! caller's own stdio writes, allocator identity, `atoi`/`getenv` semantics -
    32	//! bit-for-bit identical to the C implementation.
    33	
    34	#![allow(non_camel_case_types)]
    35	
    36	use core::ffi::{c_char, c_int, c_void};
    37	
    38	/// Opaque `FILE`.
    39	#[repr(C)]
    40	pub struct FILE {
    41	    _private: [u8; 0],
    42	}
    43	
    44	pub const EXIT_FAILURE: c_int = 1;
    45	
    46	extern "C" {
    47	    pub static mut stderr: *mut FILE;
    48	
    49	    pub fn fopen(path: *const c_char, mode: *const c_char) -> *mut FILE;
    50	    pub fn fclose(stream: *mut FILE) -> c_int;
    51	    pub fn fprintf(stream: *mut FILE, format: *const c_char, ...) -> c_int;
    52	    pub fn printf(format: *const c_char, ...) -> c_int;
    53	
    54	    pub fn malloc(size: usize) -> *mut c_void;
    55	    pub fn free(ptr: *mut c_void);
    56	
    57	    pub fn getenv(name: *const c_char) -> *mut c_char;
    58	    pub fn atoi(s: *const c_char) -> c_int;
    59	
    60	    pub fn strlen(s: *const c_char) -> usize;
    61	    pub fn strchr(s: *const c_char, c: c_int) -> *mut c_char;
    62	    pub fn strncpy(dst: *mut c_char, src: *const c_char, n: usize) -> *mut c_char;
    63	}
