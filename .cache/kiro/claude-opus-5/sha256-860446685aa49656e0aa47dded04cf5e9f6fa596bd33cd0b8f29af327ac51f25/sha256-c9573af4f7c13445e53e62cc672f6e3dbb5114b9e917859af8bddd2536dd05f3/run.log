    25	
    26	//! Translation of `c_src/src/driver.c`.
    27	
    28	use core::ffi::{c_char, c_int, c_void};
    29	
    30	use crate::cbind::{fprintf, free, malloc, strchr, strlen, strncpy, EXIT_FAILURE};
    31	use crate::logger::{finalize_logger, initialize_logger};
    32	use crate::task_manager::{add_task, create_task_manager, destroy_task_manager, print_tasks};
    33	
    34	/// `int driver(const char *tasks);`
    35	///
    36	/// Splits `tasks` on `'\n'` and registers every line - including empty ones -
    37	/// with an incrementing priority starting at 1, then prints the task list.
    38	#[unsafe(no_mangle)]
    39	pub unsafe extern "C" fn driver(tasks: *const c_char) -> c_int {
    40	    let res = initialize_logger();
    41	    if res != 0 {
    42	        return EXIT_FAILURE;
    43	    }
    44	
    45	    let manager = create_task_manager();
    46	    if manager.is_null() {
    47	        return EXIT_FAILURE;
    48	    }
    49	
    50	    let mut start: *const c_char = tasks;
    51	    let mut priority: c_int = 1;
    52	    while *start != 0 {
    53	        let mut end: *const c_char = strchr(start, b'\n' as c_int);
    54	        if end.is_null() {
    55	            end = start.add(strlen(start));
    56	        }
    57	
    58	        // Extract the current task
    59	        let length = end.offset_from(start) as usize;
    60	        let task = malloc(length + 1) as *mut c_char;
    61	        if task.is_null() {
    62	            fprintf(
    63	                crate::cbind::stderr,
    64	                c"Error: Failed to allocate memory for task.\n".as_ptr(),
    65	            );
    66	            destroy_task_manager(manager);
    67	            finalize_logger();
    68	            return EXIT_FAILURE;
    69	        }
    70	        strncpy(task, start, length);
    71	        *task.add(length) = 0;
    72	
    73	        add_task(manager, task, priority);
    74	        priority += 1;
    75	        free(task as *mut c_void);
    76	        start = if *end == b'\n' as c_char {
    77	            end.add(1)
    78	        } else {
    79	            end
    80	        };
    81	    }
    82	
    83	    print_tasks(manager);
    84	
    85	    destroy_task_manager(manager);
    86	    finalize_logger();
    87	
    88	    0
    89	}
