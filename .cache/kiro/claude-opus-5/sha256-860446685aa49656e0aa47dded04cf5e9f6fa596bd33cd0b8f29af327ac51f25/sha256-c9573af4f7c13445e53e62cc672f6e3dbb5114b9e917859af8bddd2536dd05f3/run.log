    25	
    26	//! Translation of `c_src/src/task_manager.c` and `c_src/include/task_manager.h`.
    27	
    28	use core::ffi::{c_char, c_int, c_void};
    29	use core::mem::size_of;
    30	use core::ptr::{self, addr_of, addr_of_mut};
    31	
    32	use crate::cbind::{atoi, free, getenv, malloc, printf, strncpy};
    33	use crate::logger::{log_error, log_info, log_warning};
    34	
    35	/// ```c
    36	/// typedef struct {
    37	///     char description[256];
    38	///     int priority;
    39	/// } Task;
    40	/// ```
    41	#[repr(C)]
    42	pub struct Task {
    43	    pub description: [c_char; 256],
    44	    pub priority: c_int,
    45	}
    46	
    47	/// ```c
    48	/// typedef struct {
    49	///     Task *tasks;
    50	///     int max_tasks;
    51	///     int task_count;
    52	/// } TaskManager;
    53	/// ```
    54	#[repr(C)]
    55	pub struct TaskManager {
    56	    pub tasks: *mut Task,
    57	    pub max_tasks: c_int,
    58	    pub task_count: c_int,
    59	}
    60	
    61	// Layout must match the C structs exactly; the ABI depends on it.
    62	const _: () = assert!(size_of::<Task>() == 260);
    63	const _: () = assert!(size_of::<TaskManager>() == 16);
    64	
    65	/// `TaskManager *create_task_manager();`
    66	#[unsafe(no_mangle)]
    67	pub unsafe extern "C" fn create_task_manager() -> *mut TaskManager {
    68	    let manager = malloc(size_of::<TaskManager>()) as *mut TaskManager;
    69	    if manager.is_null() {
    70	        log_error(c"Failed to allocate memory for TaskManager.".as_ptr());
    71	        return ptr::null_mut();
    72	    }
    73	
    74	    let max_tasks_env: *const c_char = getenv(c"MAX_TASKS".as_ptr());
    75	    let max_tasks: c_int = if !max_tasks_env.is_null() {
    76	        atoi(max_tasks_env)
    77	    } else {
    78	        10
    79	    };
    80	    addr_of_mut!((*manager).max_tasks).write(max_tasks);
    81	    addr_of_mut!((*manager).task_count).write(0);
    82	
    83	    // `manager->max_tasks * sizeof(Task)` in C promotes the (possibly negative)
    84	    // int to size_t and then multiplies with wrap-around; reproduce that.
    85	    let bytes = (max_tasks as isize as usize).wrapping_mul(size_of::<Task>());
    86	    let tasks = malloc(bytes) as *mut Task;
    87	    addr_of_mut!((*manager).tasks).write(tasks);
    88	    if tasks.is_null() {
    89	        log_error(c"Failed to allocate memory for tasks.".as_ptr());
    90	        free(manager as *mut c_void);
    91	        return ptr::null_mut();
    92	    }
    93	
    94	    log_info(c"TaskManager created successfully.".as_ptr());
    95	    manager
    96	}
    97	
    98	/// `void add_task(TaskManager *manager, const char *description, int priority);`
    99	#[unsafe(no_mangle)]
   100	pub unsafe extern "C" fn add_task(
   101	    manager: *mut TaskManager,
   102	    description: *const c_char,
   103	    priority: c_int,
   104	) {
   105	    if (*manager).task_count >= (*manager).max_tasks {
   106	        log_warning(c"Cannot add task: Maximum task limit reached.".as_ptr());
   107	        return;
   108	    }
   109	
   110	    let index = (*manager).task_count;
   111	    (*manager).task_count = index + 1;
   112	    let task: *mut Task = (*manager).tasks.offset(index as isize);
   113	
   114	    let desc = addr_of_mut!((*task).description) as *mut c_char;
   115	    strncpy(desc, description, 256 - 1);
   116	    *desc.add(256 - 1) = 0;
   117	    addr_of_mut!((*task).priority).write(priority);
   118	
   119	    log_info(c"Task added successfully.".as_ptr());
   120	}
   121	
   122	/// `void print_tasks(const TaskManager *manager);`
   123	#[unsafe(no_mangle)]
   124	pub unsafe extern "C" fn print_tasks(manager: *const TaskManager) {
   125	    printf(c"Tasks:\n".as_ptr());
   126	    let mut i: c_int = 0;
   127	    while i < (*manager).task_count {
   128	        let task: *const Task = (*manager).tasks.offset(i as isize);
   129	        printf(
   130	            c"  [%d] %s (Priority: %d)\n".as_ptr(),
   131	            i + 1,
   132	            addr_of!((*task).description) as *const c_char,
   133	            (*task).priority,
   134	        );
   135	        i += 1;
   136	    }
   137	}
   138	
   139	/// `void destroy_task_manager(TaskManager *manager);`
   140	#[unsafe(no_mangle)]
   141	pub unsafe extern "C" fn destroy_task_manager(manager: *mut TaskManager) {
   142	    free((*manager).tasks as *mut c_void);
   143	    free(manager as *mut c_void);
   144	    log_info(c"TaskManager destroyed successfully.".as_ptr());
   145	}
