    30	
    31	static FILE *log_file = NULL;
    32	
    33	int initialize_logger() {
    34	    const char *log_file_env = getenv("LOG_FILE");
    35	    const char *log_file_path = log_file_env ? log_file_env : "default.log";
    36	
    37	    log_file = fopen(log_file_path, "a");
    38	    if (!log_file) {
    39	        fprintf(stderr, "Failed to open log file: %s\n", log_file_path);
    40	        return -1;
    41	    }
    42	
    43	    log_info("Logger initialized.");
    44	    return 0;
    45	}
    46	
    47	void log_info(const char *message) {
    48	    if (log_file) {
    49	        fprintf(log_file, "[INFO] %s\n", message);
    50	    }
    51	}
    52	
    53	void log_warning(const char *message) {
    54	    if (log_file) {
    55	        fprintf(log_file, "[WARNING] %s\n", message);
    56	    }
    57	}
    58	
    59	void log_error(const char *message) {
    60	    if (log_file) {
    61	        fprintf(log_file, "[ERROR] %s\n", message);
    62	    }
    63	}
    64	
    65	void finalize_logger() {
    66	    if (log_file) {
    67	        log_info("Logger finalized.");
    68	        fclose(log_file);
    69	    }
    70	}
