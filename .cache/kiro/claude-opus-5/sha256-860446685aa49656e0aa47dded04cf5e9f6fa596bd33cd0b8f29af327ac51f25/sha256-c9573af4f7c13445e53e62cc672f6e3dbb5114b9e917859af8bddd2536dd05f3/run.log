    25	
    26	//! Translation of `c_src/src/logger.c`.
    27	
    28	use core::ffi::{c_char, c_int};
    29	use core::ptr;
    30	
    31	use crate::cbind::{fclose, fopen, fprintf, getenv, FILE};
    32	
    33	/// `static FILE *log_file = NULL;`
    34	static mut LOG_FILE: *mut FILE = ptr::null_mut();
    35	
    36	/// `int initialize_logger();`
    37	///
    38	/// Opens `$LOG_FILE` (or `default.log`) for appending. Note that, exactly like
    39	/// the C original, a second call simply overwrites the stored handle without
    40	/// closing the previous one.
    41	#[unsafe(no_mangle)]
    42	pub unsafe extern "C" fn initialize_logger() -> c_int {
    43	    let log_file_env: *const c_char = getenv(c"LOG_FILE".as_ptr());
    44	    let log_file_path: *const c_char = if !log_file_env.is_null() {
    45	        log_file_env
    46	    } else {
    47	        c"default.log".as_ptr()
    48	    };
    49	
    50	    LOG_FILE = fopen(log_file_path, c"a".as_ptr());
    51	    if LOG_FILE.is_null() {
    52	        fprintf(
    53	            crate::cbind::stderr,
    54	            c"Failed to open log file: %s\n".as_ptr(),
    55	            log_file_path,
    56	        );
    57	        return -1;
    58	    }
    59	
    60	    log_info(c"Logger initialized.".as_ptr());
