import re,glob
pat = re.compile(r'cs\((("(?:[^"\\]|\\.)*")|(&?[A-Za-z_][A-Za-z0-9_]*)|(&format!\([^()]*\)))\)\.as_ptr\(\)')
# Targeted: only rewrite the argument positions that store borrowed pointers.
targets = [
 # (function call name, 0-based arg index that is borrowed)
 ('js_newcfunction', 1),
 ('js_newcfunctionx', 1),
 ('js_newcconstructor', 2),
 ('js_newuserdata', 0),
 ('js_newuserdatax', 0),
 ('js_pushliteral', 0),
 ('jsB_props', 0),
 ('jsB_props', 1),
 ('jsB_propf', 0),
]
for f in glob.glob('*.rs')+glob.glob('common/*.rs'):
    s=open(f).read(); orig=s
    for fn, idx in targets:
        # find calls like (api.js_newcfunction)(J, cb, cs("x").as_ptr(), 0)
        def fix(m):
            call=m.group(0)
            # split top-level args after the first '(' following the fn name
            head_end = call.index(')(')+2
            head = call[:head_end]
            body = call[head_end:-1]
            args=[]; depth=0; cur=''
            for ch in body:
                if ch in '([{': depth+=1
                if ch in ')]}': depth-=1
                if ch==',' and depth==0:
                    args.append(cur); cur=''
                else: cur+=ch
            args.append(cur)
            # arg 0 is J, so borrowed index idx maps to args[idx+1]
            k = idx+1
            if k < len(args):
                a = args[k]
                m2 = re.search(r'cs\((.*)\)\.as_ptr\(\)', a.strip())
                if m2:
                    args[k] = a.replace(m2.group(0), 'sstr(%s)' % m2.group(1))
            return head + ','.join(args) + ')'
        s = re.sub(r'\(api\.'+fn+r'\)\((?:[^()]|\([^()]*(?:\([^()]*\)[^()]*)*\))*\)', fix, s)
    if s!=orig:
        open(f,'w').write(s); print('patched', f)
