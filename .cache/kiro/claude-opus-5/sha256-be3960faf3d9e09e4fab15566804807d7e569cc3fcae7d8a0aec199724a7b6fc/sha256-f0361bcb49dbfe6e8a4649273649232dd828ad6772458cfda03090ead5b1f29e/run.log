import re
rows=[]
for line in open('/tmp/errsites.tsv'):
    f,ln,fn,stmt=line.rstrip('\n').split('\t',3)
    if '"' not in stmt:      # the 7 declarations/definitions of the helpers
        continue
    m=re.search(r'"((?:[^"\\]|\\.)*)"',stmt)
    if not m: continue
    rows.append((f,ln,fn,m.group(1)))
print(len(rows),'real error sites')
msgs=sorted({r[3] for r in rows})
print(len(msgs),'distinct messages')
with open('translation/tests/error_patterns.txt','w') as fh:
    for m in msgs:
        fh.write(m+'\n')
# rewrite errsites without declarations
with open('/tmp/errsites2.tsv','w') as fh:
    for f,ln,fn,msg in rows:
        fh.write('\t'.join([f,ln,fn,msg])+'\n')
