import re
kind={'js_typeerror':'TypeError','js_rangeerror':'RangeError','js_syntaxerror':'SyntaxError',
 'js_referenceerror':'ReferenceError','js_urierror':'URIError','js_evalerror':'EvalError',
 'js_error':'Error','jsC_error':'SyntaxError (compile)','jsP_error':'SyntaxError (parse)',
 'jsY_error':'SyntaxError (lex)','die':'regcomp -> NULL, *errorp ='}
n=0
for line in open('/tmp/errsites.tsv'):
