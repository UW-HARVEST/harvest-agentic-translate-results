    msg=re.search(r'"((?:[^"\\]|\\.)*)"',stmt)
    msg=msg.group(1) if msg else '(dynamic)'
    guard=stmt
    gm=re.match(r'(if\s*\(.*?\))\s*\S',stmt)
    if gm: guard=gm.group(1)
    else: guard='reached at '+f+':'+ln
    guard=guard.replace('|','\\|')
    msg=msg.replace('|','\\|')
    print('| %d | `%s:%s` | `%s` | %s | `%s: %s` |'%(n,f,ln,fn,guard,k,msg))
