[0m[49m[38;5;10m+    386[0m:[38;5;10m[49m /// Every binary32 exponent, printed as an exact decimal expansion and as a C99
[0m[49m[38;5;10m+    387[0m:[38;5;10m[49m /// hex float, round-tripped through both programs.
[0m[49m[38;5;10m+    388[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    389[0m:[38;5;10m[49m fn every_exponent_round_trips() {
[0m[49m[38;5;10m+    390[0m:[38;5;10m[49m     for be in 0u32..255 {
[0m[49m[38;5;10m+    391[0m:[38;5;10m[49m         for frac in [0u32, 1, 0x40_0000, 0x7f_ffff] {
[0m[49m[38;5;10m+    392[0m:[38;5;10m[49m             let bits = (be << 23) | frac;
[0m[49m[38;5;10m+    393[0m:[38;5;10m[49m             let f = f32::from_bits(bits);
[0m[49m[38;5;10m+    394[0m:[38;5;10m[49m             // Exact decimal expansion: f32 -> f64 is lossless, and {:.80e}
