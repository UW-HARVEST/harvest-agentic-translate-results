[0m[49m[38;5;10m+    337[0m:[38;5;10m[49m         push(format!("0.{}", "9".repeat(n)));
[0m[49m[38;5;10m+    338[0m:[38;5;10m[49m         push(format!("{} 5", " ".repeat(n)));
[0m[49m[38;5;10m+    339[0m:[38;5;10m[49m         push(format!("{}2.5", "\n".repeat(n)));
[0m[49m[38;5;10m+    340[0m:[38;5;10m[49m         push(format!("0x{}1p0", "0".repeat(n)));
[0m[49m[38;5;10m+    341[0m:[38;5;10m[49m         push(format!("0x0.{}1p0", "0".repeat(n)));
