[0m[49m[38;5;10m+    402[0m:[38;5;10m[49m /// A deterministic pseudo-random sweep: junk strings, decimal numbers and hex
[0m[49m[38;5;10m+    403[0m:[38;5;10m[49m /// floats.  Seeded, so a failure is reproducible.
[0m[49m[38;5;10m+    404[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    405[0m:[38;5;10m[49m fn randomized_sweep() {
[0m[49m[38;5;10m+    406[0m:[38;5;10m[49m     // xorshift64*, so the suite needs no external crates.
[0m[49m[38;5;10m+    407[0m:[38;5;10m[49m     struct Rng(u64);
[0m[49m[38;5;10m+    408[0m:[38;5;10m[49m     impl Rng {
[0m[49m[38;5;10m+    409[0m:[38;5;10m[49m         fn next(&mut self) -> u64 {
[0m[49m[38;5;10m+    410[0m:[38;5;10m[49m             let mut x = self.0;
[0m[49m[38;5;10m+    411[0m:[38;5;10m[49m             x ^= x >> 12;
[0m[49m[38;5;10m+    412[0m:[38;5;10m[49m             x ^= x << 25;
[0m[49m[38;5;10m+    413[0m:[38;5;10m[49m             x ^= x >> 27;
[0m[49m[38;5;10m+    414[0m:[38;5;10m[49m             self.0 = x;
[0m[49m[38;5;10m+    415[0m:[38;5;10m[49m             x.wrapping_mul(0x2545_f491_4f6c_dd1d)
[0m[49m[38;5;10m+    416[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    417[0m:[38;5;10m[49m         fn below(&mut self, n: usize) -> usize {
[0m[49m[38;5;10m+    418[0m:[38;5;10m[49m             (self.next() % n as u64) as usize
[0m[49m[38;5;10m+    419[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    420[0m:[38;5;10m[49m         fn pick(&mut self, s: &[u8]) -> u8 {
[0m[49m[38;5;10m+    421[0m:[38;5;10m[49m             s[self.below(s.len())]
[0m[49m[38;5;10m+    422[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    423[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    424[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    425[0m:[38;5;10m[49m     let mut rng = Rng(0x9e37_79b9_7f4a_7c15);
[0m[49m[38;5;10m+    426[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    427[0m:[38;5;10m[49m     // Junk over an alphabet of every character the %f grammar reacts to.
[0m[49m[38;5;10m+    428[0m:[38;5;10m[49m     const ALPHA: &[u8] = b"0123456789.-+eExXpPabcdefABCDEFnNiIfFtTyY() \t\n\r";
