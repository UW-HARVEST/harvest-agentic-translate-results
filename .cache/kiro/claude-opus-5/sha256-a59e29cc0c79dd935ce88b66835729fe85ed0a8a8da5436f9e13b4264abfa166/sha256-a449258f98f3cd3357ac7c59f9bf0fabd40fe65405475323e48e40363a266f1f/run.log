[0m[49m[38;5;10m+    472[0m:[38;5;10m[49m         (r.code, r.signal),
[0m[49m[38;5;10m+    473[0m:[38;5;10m[49m         "status differs on a broken stdout pipe: C {:?} vs Rust {:?}",
