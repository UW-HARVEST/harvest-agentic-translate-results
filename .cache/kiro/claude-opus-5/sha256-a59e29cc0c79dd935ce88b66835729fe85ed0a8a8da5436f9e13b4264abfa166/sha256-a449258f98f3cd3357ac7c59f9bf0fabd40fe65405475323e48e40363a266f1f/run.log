[0m[49m[38;5;10m+    154[0m:[38;5;10m[49m         c.stderr,
[0m[49m[38;5;10m+    155[0m:[38;5;10m[49m         r.stderr,
[0m[49m[38;5;10m+    156[0m:[38;5;10m[49m         "stderr differs for {label} (input {:?})\n  C: {:?}\n  R: {:?}",
[0m[49m[38;5;10m+    157[0m:[38;5;10m[49m         String::from_utf8_lossy(input),
[0m[49m[38;5;10m+    158[0m:[38;5;10m[49m         String::from_utf8_lossy(&c.stderr),
[0m[49m[38;5;10m+    159[0m:[38;5;10m[49m         String::from_utf8_lossy(&r.stderr),
[0m[49m[38;5;10m+    160[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    161[0m:[38;5;10m[49m     assert_eq!(
[0m[49m[38;5;10m+    162[0m:[38;5;10m[49m         (c.code, c.signal),
[0m[49m[38;5;10m+    163[0m:[38;5;10m[49m         (r.code, r.signal),
[0m[49m[38;5;10m+    164[0m:[38;5;10m[49m         "exit status differs for {label} (input {:?}): C {:?} vs Rust {:?}",
[0m[49m[38;5;10m+    165[0m:[38;5;10m[49m         String::from_utf8_lossy(input),
[0m[49m[38;5;10m+    166[0m:[38;5;10m[49m         (c.code, c.signal),
[0m[49m[38;5;10m+    167[0m:[38;5;10m[49m         (r.code, r.signal),
[0m[49m[38;5;10m+    168[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    169[0m:[38;5;10m[49m     c
[0m[49m[38;5;10m+    170[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    171[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    172[0m:[38;5;10m[49m fn assert_same_cases(cases: &[(&str, &[u8])]) {
[0m[49m[38;5;10m+    173[0m:[38;5;10m[49m     for (label, input) in cases {
[0m[49m[38;5;10m+    174[0m:[38;5;10m[49m         assert_same(label, input);
[0m[49m[38;5;10m+    175[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    176[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    177[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    178[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    179[0m:[38;5;10m[49m // The two reachable outputs, pinned to exact bytes
[0m[49m[38;5;10m+    180[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    181[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    182[0m:[38;5;10m[49m /// `bad()`: `data = CHAR_MAX` (127), `data * 2` computed as `int` (254) and
[0m[49m[38;5;10m+    183[0m:[38;5;10m[49m /// truncated to `char` (-2); `printf("%02x")` promotes -2 to `int` and prints
[0m[49m[38;5;10m+    184[0m:[38;5;10m[49m /// its unsigned bit pattern, so eight digits, not two.
[0m[49m[38;5;10m+    185[0m:[38;5;10m[49m const BAD_OUT: &[u8] = b"fffffffe\n";
[0m[49m[38;5;10m+    186[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    187[0m:[38;5;10m[49m /// `good()`: `goodG2B` prints 4 as `04`, then `goodB2G` takes the
[0m[49m[38;5;10m+    188[0m:[38;5;10m[49m /// `data < CHAR_MAX/2` false branch (127 < 63 is false) and prints the message.
[0m[49m[38;5;10m+    189[0m:[38;5;10m[49m const GOOD_OUT: &[u8] = b"04\ndata value is too large to perform arithmetic safely.\n";
[0m[49m[38;5;10m+    190[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    191[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    192[0m:[38;5;10m[49m fn golden_output_bytes_are_what_the_c_produces() {
[0m[49m[38;5;10m+    193[0m:[38;5;10m[49m     // Guards against both programs drifting together: these are the literal
[0m[49m[38;5;10m+    194[0m:[38;5;10m[49m     // bytes the C source is able to emit.
[0m[49m[38;5;10m+    195[0m:[38;5;10m[49m     let zero = run(c_bin(), b"0\n");
[0m[49m[38;5;10m+    196[0m:[38;5;10m[49m     assert_eq!(zero.stdout, BAD_OUT, "C bad() output changed");
[0m[49m[38;5;10m+    197[0m:[38;5;10m[49m     assert_eq!(zero.stderr, b"");
[0m[49m[38;5;10m+    198[0m:[38;5;10m[49m     assert_eq!(zero.code, Some(0));
[0m[49m[38;5;10m+    199[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m     let one = run(c_bin(), b"1\n");
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m     assert_eq!(one.stdout, GOOD_OUT, "C good() output changed");
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m     assert_eq!(one.stderr, b"");
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m     assert_eq!(one.code, Some(0));
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m     // And the Rust binary reproduces them.
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m     assert_eq!(run(rust_bin(), b"0\n").stdout, BAD_OUT);
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m     assert_eq!(run(rust_bin(), b"1\n").stdout, GOOD_OUT);
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m // Phase B: the branches the C actually has
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m /// `main`: no input at all, so `scanf` returns EOF and leaves `x == 0`, taking
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m /// the `else` branch into `bad()`.
[0m[49m[38;5;10m+    216[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    217[0m:[38;5;10m[49m fn empty_input_reaches_bad() {
[0m[49m[38;5;10m+    218[0m:[38;5;10m[49m     let out = assert_same("empty input", b"");
[0m[49m[38;5;10m+    219[0m:[38;5;10m[49m     assert_eq!(out.stdout, BAD_OUT);
[0m[49m[38;5;10m+    220[0m:[38;5;10m[49m     assert_eq!(out.code, Some(0));
[0m[49m[38;5;10m+    221[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m /// A single item on stdin: the smallest well-formed input for each branch.
[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m fn single_value_selects_the_branch() {
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m     let zero = assert_same("single 0", b"0");
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m     assert_eq!(zero.stdout, BAD_OUT);
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m     let one = assert_same("single 1", b"1");
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m     assert_eq!(one.stdout, GOOD_OUT);
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m fn zero_variants_all_reach_bad() {
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m     assert_same_cases(&[
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m         ("0", b"0"),
[0m[49m[38;5;10m+    236[0m:[38;5;10m[49m         ("0 with newline", b"0\n"),
[0m[49m[38;5;10m+    237[0m:[38;5;10m[49m         ("-0", b"-0"),
[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m         ("+0", b"+0"),
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m         ("many zeros", b"00000"),
[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m         ("0 then junk", b"0abc"),
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m         // `%d` stops at 'x'; it does not accept a hex prefix.
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m         ("0x10", b"0x10"),
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m         ("0 then more numbers", b"0 1 2"),
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m     ]);
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m fn nonzero_variants_all_reach_good() {
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m     assert_same_cases(&[
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m         ("1", b"1"),
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m         ("-1", b"-1"),
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m         ("+5", b"+5"),
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m         ("-5", b"-5"),
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m         ("42 with newline", b"42\n"),
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m         ("leading zeros then 1", b"0001"),
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m         // `%d` stops at '.', converting just the 3.
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m         ("3.9", b"3.9"),
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m         ("1 then letters", b"1foo"),
[0m[49m[38;5;10m+    259[0m:[38;5;10m[49m         ("two numbers, first wins", b"  12  34"),
[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m     ]);
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    263[0m:[38;5;10m[49m /// `scanf` skips leading whitespace and therefore reads across newlines --
[0m[49m[38;5;10m+    264[0m:[38;5;10m[49m /// unlike `fgets`, which would stop at the first one.
[0m[49m[38;5;10m+    265[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    266[0m:[38;5;10m[49m fn scanf_skips_whitespace_across_lines() {
[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m     assert_same_cases(&[
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m         ("blank lines then value", b"\n\n\n  7\n"),
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m         ("leading spaces", b"      7"),
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m         ("tab then value", b"\t7"),
[0m[49m[38;5;10m+    271[0m:[38;5;10m[49m         ("crlf then value", b"\r\n7"),
[0m[49m[38;5;10m+    272[0m:[38;5;10m[49m         ("all C whitespace then value", b" \t\n\x0b\x0c\r 42"),
[0m[49m[38;5;10m+    273[0m:[38;5;10m[49m         ("value on the third line", b"\n\n5"),
[0m[49m[38;5;10m+    274[0m:[38;5;10m[49m     ]);
[0m[49m[38;5;10m+    275[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    277[0m:[38;5;10m[49m /// Inputs where no digit is converted: `scanf` reports a matching failure and
[0m[49m[38;5;10m+    278[0m:[38;5;10m[49m /// leaves `x` at its initialiser 0, so `bad()` runs.
[0m[49m[38;5;10m+    279[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    280[0m:[38;5;10m[49m fn matching_failure_leaves_x_zero() {
[0m[49m[38;5;10m+    281[0m:[38;5;10m[49m     let cases: &[(&str, &[u8])] = &[
[0m[49m[38;5;10m+    282[0m:[38;5;10m[49m         ("letters", b"abc"),
[0m[49m[38;5;10m+    283[0m:[38;5;10m[49m         ("lone minus", b"-"),
[0m[49m[38;5;10m+    284[0m:[38;5;10m[49m         ("lone plus", b"+"),
[0m[49m[38;5;10m+    285[0m:[38;5;10m[49m         ("double minus", b"--1"),
[0m[49m[38;5;10m+    286[0m:[38;5;10m[49m         ("sign then space", b"- 1"),
[0m[49m[38;5;10m+    287[0m:[38;5;10m[49m         ("sign then letter", b"-a"),
[0m[49m[38;5;10m+    288[0m:[38;5;10m[49m         ("dot first", b".5"),
[0m[49m[38;5;10m+    289[0m:[38;5;10m[49m         ("only whitespace", b"   \n\t\n"),
[0m[49m[38;5;10m+    290[0m:[38;5;10m[49m         ("lone newline", b"\n"),
[0m[49m[38;5;10m+    291[0m:[38;5;10m[49m         ("punctuation", b"!!!"),
[0m[49m[38;5;10m+    292[0m:[38;5;10m[49m         ("NUL byte first", b"\0 5"),
[0m[49m[38;5;10m+    293[0m:[38;5;10m[49m         ("invalid utf-8", b"\xff\xfe"),
[0m[49m[38;5;10m+    294[0m:[38;5;10m[49m         ("utf-8 multibyte first", b"\xc3\xa9 7"),
[0m[49m[38;5;10m+    295[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    296[0m:[38;5;10m[49m     for (label, input) in cases {
[0m[49m[38;5;10m+    297[0m:[38;5;10m[49m         let out = assert_same(label, input);
[0m[49m[38;5;10m+    298[0m:[38;5;10m[49m         assert_eq!(out.stdout, BAD_OUT, "{label} should reach bad()");
[0m[49m[38;5;10m+    299[0m:[38;5;10m[49m         assert_eq!(out.code, Some(0));
[0m[49m[38;5;10m+    300[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    301[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    302[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    303[0m:[38;5;10m[49m /// glibc converts `%d` with `strtol` (saturating at `long`) and then stores the
[0m[49m[38;5;10m+    304[0m:[38;5;10m[49m /// result into an `int`, keeping the low 32 bits. Values whose low 32 bits are
[0m[49m[38;5;10m+    305[0m:[38;5;10m[49m /// zero therefore reach `bad()` even though the number written was non-zero.
[0m[49m[38;5;10m+    306[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    307[0m:[38;5;10m[49m fn int_truncation_of_the_converted_value() {
[0m[49m[38;5;10m+    308[0m:[38;5;10m[49m     // Low 32 bits are zero -> x == 0 -> bad().
[0m[49m[38;5;10m+    309[0m:[38;5;10m[49m     for (label, input) in [
[0m[49m[38;5;10m+    310[0m:[38;5;10m[49m         ("2^32", &b"4294967296"[..]),
[0m[49m[38;5;10m+    311[0m:[38;5;10m[49m         ("2^36", &b"68719476736"[..]),
[0m[49m[38;5;10m+    312[0m:[38;5;10m[49m         ("2^40", &b"1099511627776"[..]),
[0m[49m[38;5;10m+    313[0m:[38;5;10m[49m         ("-2^32", &b"-4294967296"[..]),
[0m[49m[38;5;10m+    314[0m:[38;5;10m[49m         ("LONG_MIN", &b"-9223372036854775808"[..]),
[0m[49m[38;5;10m+    315[0m:[38;5;10m[49m         ("below LONG_MIN saturates to LONG_MIN", &b"-9223372036854775809"[..]),
[0m[49m[38;5;10m+    316[0m:[38;5;10m[49m         ("very negative saturates", &b"-99999999999999999999"[..]),
[0m[49m[38;5;10m+    317[0m:[38;5;10m[49m         ("zeros then 2^32", &b"0000000000000000000000004294967296"[..]),
[0m[49m[38;5;10m+    318[0m:[38;5;10m[49m     ] {
[0m[49m[38;5;10m+    319[0m:[38;5;10m[49m         let out = assert_same(label, input);
[0m[49m[38;5;10m+    320[0m:[38;5;10m[49m         assert_eq!(out.stdout, BAD_OUT, "{label} truncates to 0");
[0m[49m[38;5;10m+    321[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    322[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    323[0m:[38;5;10m[49m     // Low 32 bits non-zero -> good().
[0m[49m[38;5;10m+    324[0m:[38;5;10m[49m     for (label, input) in [
[0m[49m[38;5;10m+    325[0m:[38;5;10m[49m         ("INT_MAX", &b"2147483647"[..]),
[0m[49m[38;5;10m+    326[0m:[38;5;10m[49m         ("INT_MAX+1", &b"2147483648"[..]),
[0m[49m[38;5;10m+    327[0m:[38;5;10m[49m         ("INT_MIN", &b"-2147483648"[..]),
[0m[49m[38;5;10m+    328[0m:[38;5;10m[49m         ("INT_MIN-1", &b"-2147483649"[..]),
[0m[49m[38;5;10m+    329[0m:[38;5;10m[49m         ("LONG_MAX", &b"9223372036854775807"[..]),
[0m[49m[38;5;10m+    330[0m:[38;5;10m[49m         ("above LONG_MAX saturates to LONG_MAX", &b"9223372036854775808"[..]),
[0m[49m[38;5;10m+    331[0m:[38;5;10m[49m         ("2^64", &b"18446744073709551616"[..]),
[0m[49m[38;5;10m+    332[0m:[38;5;10m[49m         ("2^64+1", &b"18446744073709551617"[..]),
[0m[49m[38;5;10m+    333[0m:[38;5;10m[49m         ("huge positive saturates", &b"99999999999999999999"[..]),
[0m[49m[38;5;10m+    334[0m:[38;5;10m[49m     ] {
[0m[49m[38;5;10m+    335[0m:[38;5;10m[49m         let out = assert_same(label, input);
[0m[49m[38;5;10m+    336[0m:[38;5;10m[49m         assert_eq!(out.stdout, GOOD_OUT, "{label} truncates to non-zero");
[0m[49m[38;5;10m+    337[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    338[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    339[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    340[0m:[38;5;10m[49m /// The largest inputs the conversion has to chew through: far more digits and
[0m[49m[38;5;10m+    341[0m:[38;5;10m[49m /// far more leading whitespace than any buffer in the program.
