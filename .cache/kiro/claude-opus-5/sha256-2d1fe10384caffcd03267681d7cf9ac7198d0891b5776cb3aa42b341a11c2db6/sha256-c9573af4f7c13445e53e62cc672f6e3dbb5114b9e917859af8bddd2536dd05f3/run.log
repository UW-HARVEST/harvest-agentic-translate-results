[0m[49m[38;5;10m+     94[0m:[38;5;10m[49m // ------------------------------------------------------------------- error rep
[0m[49m[38;5;10m+     95[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     96[0m:[38;5;10m[49m /// Canonical, library-independent description of a `size_t` return value.
[0m[49m[38;5;10m+     97[0m:[38;5;10m[49m #[derive(Debug, PartialEq, Eq, Clone)]
[0m[49m[38;5;10m+     98[0m:[38;5;10m[49m pub enum Ret {
