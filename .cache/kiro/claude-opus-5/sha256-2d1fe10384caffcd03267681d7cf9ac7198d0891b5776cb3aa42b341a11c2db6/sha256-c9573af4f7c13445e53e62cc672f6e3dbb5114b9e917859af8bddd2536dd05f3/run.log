[0m[49m[38;5;10m+    157[0m:[38;5;10m[49m         assert_eq!(a, b, "{ctx}: C={a:?} RS={b:?} (raw C={cr:#x} RS={rr:#x})");
[0m[49m[38;5;10m+    158[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    159[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    160[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    161[0m:[38;5;10m[49m // ------------------------------------------------------------------------ rng
[0m[49m[38;5;10m+    162[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    163[0m:[38;5;10m[49m /// Deterministic xorshift64* PRNG — fixed seed => reproducible property tests.
