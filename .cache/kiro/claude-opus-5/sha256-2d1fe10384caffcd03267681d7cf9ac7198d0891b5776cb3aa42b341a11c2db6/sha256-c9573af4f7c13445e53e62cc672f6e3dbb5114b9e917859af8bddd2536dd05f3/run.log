[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m     Constant,
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m     Random,
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m     Text,
[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m     LowEntropy,
[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m     Repeating,
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m     Incompressible,
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m     TwoSymbols,
