[0m[49m[38;5;10m+    125[0m:[38;5;10m[49m                 let code = (self.get_code)(r);
[0m[49m[38;5;10m+    126[0m:[38;5;10m[49m                 let name = cstr((self.get_name)(r));
[0m[49m[38;5;10m+    127[0m:[38;5;10m[49m                 Ret::Err { code, name }
[0m[49m[38;5;10m+    128[0m:[38;5;10m[49m             } else {
