[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m /// Data-shape generators covering the shapes the C code special-cases.
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m #[derive(Debug, Clone, Copy, PartialEq)]
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m pub enum Shape {
