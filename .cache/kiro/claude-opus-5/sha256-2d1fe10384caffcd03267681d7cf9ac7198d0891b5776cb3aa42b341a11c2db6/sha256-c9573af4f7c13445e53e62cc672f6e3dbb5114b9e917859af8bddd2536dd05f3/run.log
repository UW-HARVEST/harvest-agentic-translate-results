[0m[49m[38;5;10m+    217[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    218[0m:[38;5;10m[49m pub const ALL_SHAPES: &[Shape] = &[
[0m[49m[38;5;10m+    219[0m:[38;5;10m[49m     Shape::Empty,
[0m[49m[38;5;10m+    220[0m:[38;5;10m[49m     Shape::Zeros,
[0m[49m[38;5;10m+    221[0m:[38;5;10m[49m     Shape::Constant,
[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m     Shape::Random,
[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m     Shape::Text,
[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m     Shape::LowEntropy,
[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m     Shape::Repeating,
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m     Shape::Incompressible,
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m     Shape::TwoSymbols,
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m     Shape::Sequential,
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m     Shape::LongMatches,
