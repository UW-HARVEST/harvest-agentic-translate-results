[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m pub fn gen(shape: Shape, len: usize, rng: &mut Rng) -> Vec<u8> {
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m     match shape {
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m         Shape::Empty => Vec::new(),
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m         Shape::Zeros => vec![0u8; len],
[0m[49m[38;5;10m+    236[0m:[38;5;10m[49m         Shape::Constant => vec![rng.byte(); len],
[0m[49m[38;5;10m+    237[0m:[38;5;10m[49m         Shape::Random | Shape::Incompressible => (0..len).map(|_| rng.byte()).collect(),
[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m         Shape::Text => {
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m             const W: &[&str] = &[
[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m                 "the ", "quick ", "brown ", "fox ", "jumps ", "over ", "lazy ", "dog ", "and ",
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m                 "then ", "zstd ", "compresses ", "it ", "very ", "well ", "indeed ", "a ", "of ",
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m             ];
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m             let mut v = Vec::with_capacity(len + 16);
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m             while v.len() < len {
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m                 v.extend_from_slice(W[rng.below(W.len())].as_bytes());
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m             v.truncate(len);
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m             v
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m         Shape::LowEntropy => (0..len).map(|_| rng.byte() & 0x07).collect(),
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m         Shape::Repeating => {
