import re,glob
lit=set(); tpl=set()
prefixes=set()
for f in glob.glob('tests/*.rs'):
    s=open(f).read()
    for m in re.finditer(r'"([A-Za-z_][A-Za-z0-9_{}]*)"', s):
        t=m.group(1)
        (tpl if '{' in t else lit).add(t)
# any bare identifier-ish literal can also be a version/strategy prefix used in format!
prefixes |= {t for t in lit if re.fullmatch(r'(ZSTD|FSE|HUF|ZBUFF)v\d\d', t)}
prefixes |= {t for t in lit if re.fullmatch(r'v\d\d', t)}
prefixes |= {t for t in lit if re.fullmatch(r'[a-zA-Z0-9_]+', t)}
out=set(lit)
for t in tpl:
    ph=re.findall(r'\{[A-Za-z0-9_]*\}', t)
    if len(ph)!=1: continue
    for p in prefixes:
        out.add(t.replace(ph[0], p))
for n in sorted(out): print(n)
