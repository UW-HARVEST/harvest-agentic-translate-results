[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m             // finders, LDM, and repeat-offset code paths.
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m             let mut v = Vec::with_capacity(len + 256);
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m             let blk: Vec<u8> = (0..1024).map(|_| rng.byte()).collect();
[0m[49m[38;5;10m+    263[0m:[38;5;10m[49m             while v.len() < len {
[0m[49m[38;5;10m+    264[0m:[38;5;10m[49m                 v.extend_from_slice(&blk);
[0m[49m[38;5;10m+    265[0m:[38;5;10m[49m                 if rng.bool() {
[0m[49m[38;5;10m+    266[0m:[38;5;10m[49m                     for _ in 0..rng.below(32) {
[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m                         v.push(rng.byte());
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m                     }
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    271[0m:[38;5;10m[49m             v.truncate(len);
[0m[49m[38;5;10m+    272[0m:[38;5;10m[49m             v
[0m[49m[38;5;10m+    273[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    274[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    275[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    277[0m:[38;5;10m[49m /// Interesting length values: boundaries + a few random sizes.
[0m[49m[38;5;10m+    278[0m:[38;5;10m[49m pub const LENS: &[usize] = &[
[0m[49m[38;5;10m+    279[0m:[38;5;10m[49m     0, 1, 2, 3, 7, 8, 15, 16, 17, 31, 32, 63, 64, 100, 127, 128, 129, 255, 256, 257, 511, 512,
[0m[49m[38;5;10m+    280[0m:[38;5;10m[49m     1000, 1023, 1024, 1025, 4095, 4096, 4097, 8192, 16384, 20000, 65535, 65536, 65537, 100_000,
[0m[49m[38;5;10m+    281[0m:[38;5;10m[49m     131_072, 200_000,
