[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m             let pat: Vec<u8> = (0..plen).map(|_| rng.byte()).collect();
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m             (0..len).map(|i| pat[i % plen]).collect()
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m         Shape::TwoSymbols => (0..len).map(|_| if rng.bool() { b'a' } else { b'b' }).collect(),
