[0m[49m[38;5;10m+    115[0m:[38;5;10m[49m                 get_name: sym::<FnGetErrorName>(lib, "ZSTD_getErrorName"),
[0m[49m[38;5;10m+    116[0m:[38;5;10m[49m             }
