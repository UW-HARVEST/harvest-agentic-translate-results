[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m         inputs.push(-v);
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m         inputs.push(f64::from_bits(v.to_bits() + 1));
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m         inputs.push(f64::from_bits(v.to_bits() - 1));
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m     for e in 60..=1023i32 {
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m         let v = f64::from_bits(((e + 1023) as u64) << 52) * 1.0;
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m         inputs.push(v);
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m         inputs.push(v * 1.5);
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m         inputs.push(-v);
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m     inputs.push(f64::MAX);
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m     inputs.push(f64::MIN);
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m     inputs.push(f64::from_bits(0x7fef_ffff_ffff_fffe));
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m     assert_same_all(inputs);
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m 
