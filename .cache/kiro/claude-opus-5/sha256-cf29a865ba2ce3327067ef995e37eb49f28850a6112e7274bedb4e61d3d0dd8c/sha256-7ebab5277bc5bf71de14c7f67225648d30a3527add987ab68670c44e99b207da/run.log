[0m[49m[38;5;10m+    130[0m:[38;5;10m[49m fn powers_of_two_match() {
[0m[49m[38;5;10m+    131[0m:[38;5;10m[49m     let mut inputs = Vec::new();
[0m[49m[38;5;10m+    132[0m:[38;5;10m[49m     for e in -1074i32..=1023 {
[0m[49m[38;5;10m+    133[0m:[38;5;10m[49m         let v = if e < -1022 {
[0m[49m[38;5;10m+    134[0m:[38;5;10m[49m             f64::from_bits(1u64 << (e + 1074))
[0m[49m[38;5;10m+    135[0m:[38;5;10m[49m         } else {
[0m[49m[38;5;10m+    136[0m:[38;5;10m[49m             f64::from_bits((((e + 1023) as u64) << 52))
[0m[49m[38;5;10m+    137[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+    138[0m:[38;5;10m[49m         inputs.push(v);
[0m[49m[38;5;10m+    139[0m:[38;5;10m[49m         inputs.push(-v);
[0m[49m[38;5;10m+    140[0m:[38;5;10m[49m         inputs.push(f64::from_bits(v.to_bits() + 1));
[0m[49m[38;5;10m+    141[0m:[38;5;10m[49m         if v.to_bits() > 0 {
[0m[49m[38;5;10m+    142[0m:[38;5;10m[49m             inputs.push(f64::from_bits(v.to_bits() - 1));
[0m[49m[38;5;10m+    143[0m:[38;5;10m[49m         }
