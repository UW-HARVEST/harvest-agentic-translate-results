[0m[49m[38;5;10m+    146[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    147[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    148[0m:[38;5;10m[49m /// `%a` trims trailing zero hex digits and omits the radix point when the
[0m[49m[38;5;10m+    149[0m:[38;5;10m[49m /// fraction is empty. Sweeping mantissas that end in progressively more zero
[0m[49m[38;5;10m+    150[0m:[38;5;10m[49m /// nibbles pins that logic down for all 13 hex digits.
[0m[49m[38;5;10m+    151[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    152[0m:[38;5;10m[49m fn hex_float_trailing_zero_trimming_matches() {
[0m[49m[38;5;10m+    153[0m:[38;5;10m[49m     let mut inputs = Vec::new();
[0m[49m[38;5;10m+    154[0m:[38;5;10m[49m     for nibbles in 0..=13u32 {
[0m[49m[38;5;10m+    155[0m:[38;5;10m[49m         for pat in [0x1u64, 0x8, 0xf, 0x9, 0xa] {
[0m[49m[38;5;10m+    156[0m:[38;5;10m[49m             let m = if nibbles == 0 {
[0m[49m[38;5;10m+    157[0m:[38;5;10m[49m                 0
[0m[49m[38;5;10m+    158[0m:[38;5;10m[49m             } else {
[0m[49m[38;5;10m+    159[0m:[38;5;10m[49m                 (pat << (4 * (nibbles - 1))) & 0x000f_ffff_ffff_ffff
[0m[49m[38;5;10m+    160[0m:[38;5;10m[49m             };
[0m[49m[38;5;10m+    161[0m:[38;5;10m[49m             for exp in [0u64, 1, 0x3ff, 0x400, 0x7fe] {
[0m[49m[38;5;10m+    162[0m:[38;5;10m[49m                 inputs.push(f64::from_bits((exp << 52) | m));
[0m[49m[38;5;10m+    163[0m:[38;5;10m[49m                 inputs.push(f64::from_bits(0x8000_0000_0000_0000 | (exp << 52) | m));
[0m[49m[38;5;10m+    164[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    165[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    166[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    167[0m:[38;5;10m[49m     // Every "one nibble set, rest zero" mantissa.
[0m[49m[38;5;10m+    168[0m:[38;5;10m[49m     for nib in 0..13u32 {
[0m[49m[38;5;10m+    169[0m:[38;5;10m[49m         for val in 1..16u64 {
[0m[49m[38;5;10m+    170[0m:[38;5;10m[49m             let m = val << (4 * nib);
[0m[49m[38;5;10m+    171[0m:[38;5;10m[49m             inputs.push(f64::from_bits(0x3ff0_0000_0000_0000 | m));
[0m[49m[38;5;10m+    172[0m:[38;5;10m[49m             inputs.push(f64::from_bits(0x0000_0000_0000_0000 | m));
[0m[49m[38;5;10m+    173[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    174[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    175[0m:[38;5;10m[49m     assert_same_all(inputs);
[0m[49m[38;5;10m+    176[0m:[38;5;10m[49m }
