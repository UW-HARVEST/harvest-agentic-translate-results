[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m         inputs.push(v);
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m         inputs.push(-v);
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m     assert_same_all(inputs);
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m /// Very large magnitudes: `%.4f` has to print the full exact integer expansion
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m /// (up to ~309 digits) followed by four zeros.
