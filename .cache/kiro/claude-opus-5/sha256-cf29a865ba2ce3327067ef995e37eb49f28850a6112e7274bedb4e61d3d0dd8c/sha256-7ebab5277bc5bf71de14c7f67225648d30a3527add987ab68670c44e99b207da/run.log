[0m[49m[38;5;10m+    178[0m:[38;5;10m[49m /// Exact halfway cases for `%.4f`. A `double` with exactly five fractional bits
[0m[49m[38;5;10m+    179[0m:[38;5;10m[49m /// is a multiple of 1/32, and every odd multiple of 1/32 ends in `...5` at the
[0m[49m[38;5;10m+    180[0m:[38;5;10m[49m /// fifth decimal place — i.e. an exact tie that must be broken the same way by
[0m[49m[38;5;10m+    181[0m:[38;5;10m[49m /// both implementations (glibc rounds half to even).
[0m[49m[38;5;10m+    182[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    183[0m:[38;5;10m[49m fn fixed_decimal_exact_ties_match() {
[0m[49m[38;5;10m+    184[0m:[38;5;10m[49m     let mut inputs = Vec::new();
[0m[49m[38;5;10m+    185[0m:[38;5;10m[49m     for k in 0..4096i64 {
[0m[49m[38;5;10m+    186[0m:[38;5;10m[49m         let v = k as f64 / 32.0;
[0m[49m[38;5;10m+    187[0m:[38;5;10m[49m         inputs.push(v);
[0m[49m[38;5;10m+    188[0m:[38;5;10m[49m         inputs.push(-v);
[0m[49m[38;5;10m+    189[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    190[0m:[38;5;10m[49m     // Ties further out: multiples of 1/2^n for n = 5..=20 keep producing
[0m[49m[38;5;10m+    191[0m:[38;5;10m[49m     // decimals whose tail sits right at or below the rounding position.
[0m[49m[38;5;10m+    192[0m:[38;5;10m[49m     for n in 5..=24u32 {
[0m[49m[38;5;10m+    193[0m:[38;5;10m[49m         let denom = (1u64 << n) as f64;
[0m[49m[38;5;10m+    194[0m:[38;5;10m[49m         for k in [1i64, 3, 5, 7, 9, 11, 13, 15, 17, 31, 33, 63, 127, 255, 1023] {
[0m[49m[38;5;10m+    195[0m:[38;5;10m[49m             let v = k as f64 / denom;
[0m[49m[38;5;10m+    196[0m:[38;5;10m[49m             inputs.push(v);
[0m[49m[38;5;10m+    197[0m:[38;5;10m[49m             inputs.push(-v);
[0m[49m[38;5;10m+    198[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    199[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m     assert_same_all(inputs);
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m /// Values clustered just above and below the `%.4f` rounding boundary, where a
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m /// one-ulp difference decides the printed digits.
[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m fn fixed_decimal_boundary_neighbours_match() {
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m     let mut inputs = Vec::new();
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m     for k in 0..2000i64 {
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m         // x.xxxx5 targets, approached from both sides in ulps.
[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m         let base = (k as f64) * 1e-4 + 0.5e-4;
[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m         for delta in -3i64..=3 {
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m             let bits = base.to_bits();
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m             let shifted = if delta >= 0 {
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m                 bits.wrapping_add(delta as u64)
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m             } else {
[0m[49m[38;5;10m+    216[0m:[38;5;10m[49m                 bits.wrapping_sub((-delta) as u64)
[0m[49m[38;5;10m+    217[0m:[38;5;10m[49m             };
[0m[49m[38;5;10m+    218[0m:[38;5;10m[49m             let v = f64::from_bits(shifted);
[0m[49m[38;5;10m+    219[0m:[38;5;10m[49m             inputs.push(v);
[0m[49m[38;5;10m+    220[0m:[38;5;10m[49m             inputs.push(-v);
[0m[49m[38;5;10m+    221[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m     // Values just under 1e-4 / 5e-5, where the result flips to 0.0000.
[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m     for k in 1..500i64 {
