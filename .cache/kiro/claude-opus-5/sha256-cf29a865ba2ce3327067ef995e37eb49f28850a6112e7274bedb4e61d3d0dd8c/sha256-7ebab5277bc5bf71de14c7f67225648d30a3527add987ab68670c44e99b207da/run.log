[0m[49m[38;5;10m+    107[0m:[38;5;10m[49m fn every_exponent_field_matches() {
[0m[49m[38;5;10m+    108[0m:[38;5;10m[49m     let mantissas: [u64; 6] = [
[0m[49m[38;5;10m+    109[0m:[38;5;10m[49m         0x0_0000_0000_0000,
[0m[49m[38;5;10m+    110[0m:[38;5;10m[49m         0x0_0000_0000_0001,
[0m[49m[38;5;10m+    111[0m:[38;5;10m[49m         0x8_0000_0000_0000,
