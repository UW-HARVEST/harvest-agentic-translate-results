run() {
  desc="$1"; shift
  printf '%s' "$1" > /tmp/in.bin
  co=$("$C" < /tmp/in.bin 2>/tmp/ce); cs=$?
  ro=$("$R" < /tmp/in.bin 2>/tmp/re); rs=$?
  ce=$(cat /tmp/ce); re=$(cat /tmp/re)
  if [ "$co" = "$ro" ] && [ "$cs" = "$rs" ] && [ "$ce" = "$re" ]; then
    printf 'OK   %-28s -> %s (exit %s)\n' "$desc" "$co" "$cs"
  else
    printf 'DIFF %-28s C=[%s] exit=%s err=[%s] | R=[%s] exit=%s err=[%s]\n' "$desc" "$co" "$cs" "$ce" "$ro" "$rs" "$re"
  fi
}
