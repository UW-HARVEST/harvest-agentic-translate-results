import random, subprocess, sys
C="c_src/build/driver"; R="translation/target/release/driver"
def run(p, data):
    pr = subprocess.run([p], input=data, capture_output=True)
    return pr.stdout, pr.stderr, pr.returncode
cases=[]
# structured edges
edges=[b"", b"0", b"-0", b"+0", b"--5", b"++5", b"+-5", b"-+5", b" -12 ",
  b"\x0b\x0c\r\n\t 9", b"9"*30, b"-"+b"9"*30, b"0"*40+b"7", b"0"*40,
  b"2147483647", b"2147483648", b"-2147483648", b"-2147483649",
  b"9223372036854775807", b"9223372036854775808", b"-9223372036854775808",
  b"-9223372036854775809", b"18446744073709551616", b"4294967295", b"4294967296",
  b"1"*400, b"\x00", b"\x005", b"\xff", b"\xc3\xa9", b"5\x00\x00", b"\t\t\t",
  b"1e10", b"1.5", b"1,5", b"0x1f", b"0b101", b" \n \n \n 3\n", b"7 8 9",
  b"2147483647\n2", b"-0000000001", b"+0000000001",
  b"12345678901234567890123456789012345678901234567890",
]
cases += edges
# random
random.seed(1234)
alphabet=b"0123456789+- \t\n\r\x0b\x0cabcxXeE.,\x00\xff"
for _ in range(4000):
    n=random.randint(0,24)
    cases.append(bytes(random.choice(alphabet) for _ in range(n)))
for _ in range(600):
    v=random.randint(-2**70, 2**70)
    pad=random.choice([b"", b" ", b"\n", b"\t "])
    cases.append(pad+str(v).encode()+random.choice([b"", b"\n", b" x", b"9"*random.randint(0,5)]))
bad=0
for data in cases:
    a=run(C,data); b=run(R,data)
    if a!=b:
        bad+=1
        print("DIFF", repr(data)[:120], "C=", a, "R=", b)
        if bad>15: break
print("cases:", len(cases), "mismatches:", bad)
EOF
