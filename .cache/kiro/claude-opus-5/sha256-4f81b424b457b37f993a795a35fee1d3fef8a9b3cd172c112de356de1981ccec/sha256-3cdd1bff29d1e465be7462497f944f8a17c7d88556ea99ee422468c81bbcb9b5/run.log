   202	/// `DEFINE_ACCUM(OP)` -> `static int accum_<OP>(int n)`.
   203	///
   204	/// Note the faithful reproduction of `DISPATCH_REP`: it only has cases for
   205	/// `0..=6`, so `n == 7` (or any other out-of-range value) hits `default:` and
   206	/// leaves the accumulator at its initial value. This is deliberate; the C
   207	/// behaviour is not "fixed" here.
   208	pub fn accum(n: c_int) -> c_int {
   209	    let mut acc: c_int = INIT;
   210	    match n {
   211	        0 => {}
   212	        1 => {
   213	            acc = step(acc, 0);
   214	        }
   215	        2 => {
   216	            acc = step(acc, 0);
   217	            acc = step(acc, 1);
   218	        }
   219	        3 => {
   220	            acc = step(acc, 0);
   221	            acc = step(acc, 1);
   222	            acc = step(acc, 2);
   223	        }
   224	        4 => {
   225	            acc = step(acc, 0);
   226	            acc = step(acc, 1);
   227	            acc = step(acc, 2);
   228	            acc = step(acc, 3);
   229	        }
   230	        5 => {
   231	            acc = step(acc, 0);
   232	            acc = step(acc, 1);
   233	            acc = step(acc, 2);
   234	            acc = step(acc, 3);
   235	            acc = step(acc, 4);
   236	        }
   237	        6 => {
   238	            acc = step(acc, 0);
   239	            acc = step(acc, 1);
   240	            acc = step(acc, 2);
   241	            acc = step(acc, 3);
   242	            acc = step(acc, 4);
   243	            acc = step(acc, 5);
   244	        }
   245	        _ => { /* default: break; */ }
   246	    }
   247	    acc
   248	}
