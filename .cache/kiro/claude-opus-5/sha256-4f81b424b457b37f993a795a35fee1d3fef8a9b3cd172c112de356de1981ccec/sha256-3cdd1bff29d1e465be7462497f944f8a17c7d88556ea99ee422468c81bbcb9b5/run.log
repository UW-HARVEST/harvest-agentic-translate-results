    36	/// Newtype so a raw `*const c_char` can live in a `static` (raw pointers are
    37	/// not `Sync`). `repr(transparent)` keeps the exported symbol a bare pointer,
    38	/// identical in layout to the C `const char *G_OP_NAME`.
    39	#[repr(transparent)]
    40	pub struct CStrPtr(pub *const c_char);
