     1	// Translation of c_src/src/mdmacros.h
     2	//
     3	// The C header is pure preprocessor machinery: it selects an operation family
     4	// from the `OP` token and unrolls `REPEAT` accumulator steps via token pasting.
     5	// Rust has no textual token pasting, so the selection is done with `cfg`
     6	// features (one per CMake cache value) and the unrolling collapses into a
     7	// bounded loop that is semantically identical to the unrolled chain.
     8	//
     9	// C macro -> Rust equivalent:
    10	//   OP                 -> `add` / `sub` / `mul` features, see `sel` below
    11	//   REPEAT             -> `REPEAT` const, from the `repeat_N` features
    12	//   OP_FN(OP)          -> `OP_FN` (fn pointer to op_add / op_sub / op_mul)
    13	//   INIT_FOR(OP)       -> `INIT`
    14	//   STEP_OP(OP,acc,i)  -> `step(acc, i)`
    15	//   STR(OP)            -> `OP_NAME` (NUL-terminated, as the C string literal)
    16	//   RUN_LOOP(op,acc,n) -> `run_loop(acc)`
    17	//   DEFINE_ACCUM(OP)   -> `accum(n)`
    18	//   DO_LOOP(op,acc,n)  -> `do_loop(acc, n)`
