   170	/* ---------------------------------------------------------------------------
   171	 * Unrolling helpers.
   172	 * ------------------------------------------------------------------------- */
   173	
   174	/// `RUN_LOOP(OP, acc, REPEAT)` == `CHOOSE_REP(REPEAT)(OP, acc)`.
   175	///
   176	/// `REPn` expands to `STEP_OP(op, acc, 0); ... STEP_OP(op, acc, n-1);`, i.e.
   177	/// the step applied with the literal indices `0 .. n-1` in order.
   178	#[inline]
   179	pub fn run_loop(mut acc: c_int) -> c_int {
   180	    let mut i: c_int = 0;
   181	    while i < REPEAT {
   182	        acc = step(acc, i);
   183	        i += 1;
   184	    }
   185	    acc
   186	}
   187	
   188	/// `DO_LOOP(op, acc, n)` == `FOR_EACH((n), { STEP_OP(op, acc, i); })`.
   189	///
   190	/// Unused by the C sources, kept for parity with the header.
   191	#[allow(dead_code)]
   192	#[inline]
   193	pub fn do_loop(mut acc: c_int, n: c_int) -> c_int {
   194	    let mut i: c_int = 0;
   195	    while i < n {
   196	        acc = step(acc, i);
   197	        i += 1;
   198	    }
   199	    acc
   200	}
