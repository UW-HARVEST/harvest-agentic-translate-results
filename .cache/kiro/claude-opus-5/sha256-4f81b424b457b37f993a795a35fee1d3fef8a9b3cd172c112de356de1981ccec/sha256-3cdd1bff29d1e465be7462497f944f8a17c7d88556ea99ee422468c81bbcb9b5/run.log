    22	}
    23	
    24	/// `int op_mul(int a, int b) { return a * b; }`
    25	#[unsafe(no_mangle)]
    26	pub extern "C" fn op_mul(a: c_int, b: c_int) -> c_int {
    27	    a.wrapping_mul(b)
    28	}
