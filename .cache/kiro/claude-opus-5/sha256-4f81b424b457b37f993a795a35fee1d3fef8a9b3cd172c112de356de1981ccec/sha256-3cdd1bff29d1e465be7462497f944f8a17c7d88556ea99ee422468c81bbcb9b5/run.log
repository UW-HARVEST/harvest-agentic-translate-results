    42	// Safety: the pointee is a `'static` read-only ASCII string literal, and the
    43	// pointer itself is never mutated.
    44	unsafe impl Sync for CStrPtr {}
    45	
    46	/// `const char *G_OP_NAME = STR(OP);`
    47	#[unsafe(no_mangle)]
    48	pub static G_OP_NAME: CStrPtr = CStrPtr(mdmacros::OP_NAME.as_ptr() as *const c_char);
