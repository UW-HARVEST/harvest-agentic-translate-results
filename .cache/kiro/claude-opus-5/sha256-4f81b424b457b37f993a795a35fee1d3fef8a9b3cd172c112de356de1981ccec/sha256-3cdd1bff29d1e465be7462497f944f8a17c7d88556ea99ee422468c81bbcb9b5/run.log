    14	use std::ffi::c_int;
    15	use std::io::Write;
    16	use std::os::unix::ffi::OsStrExt;
    17	
    18	/// `atoi(3)`: optional leading whitespace, optional sign, then decimal digits;
    19	/// parsing stops at the first non-digit. No error is reported.
    20	///
    21	/// glibc implements it as `(int)strtol(...)`, so out-of-range input saturates
    22	/// at `long` bounds and is then truncated to `int`.
    23	fn atoi(bytes: &[u8]) -> c_int {
    24	    let mut idx = 0usize;
    25	
    26	    while idx < bytes.len() && matches!(bytes[idx], b' ' | b'\t' | b'\n' | b'\x0b' | b'\x0c' | b'\r')
    27	    {
    28	        idx += 1;
    29	    }
    30	
    31	    let mut negative = false;
    32	    if idx < bytes.len() && (bytes[idx] == b'+' || bytes[idx] == b'-') {
    33	        negative = bytes[idx] == b'-';
    34	        idx += 1;
    35	    }
    36	
    37	    let mut acc: i64 = 0;
    38	    let mut saturated = false;
    39	    while idx < bytes.len() && bytes[idx].is_ascii_digit() {
    40	        let digit = i64::from(bytes[idx] - b'0');
    41	        if !saturated {
    42	            match acc.checked_mul(10).and_then(|v| v.checked_add(digit)) {
    43	                Some(v) => acc = v,
    44	                None => saturated = true,
    45	            }
    46	        }
    47	        idx += 1;
    48	    }
    49	
    50	    let value = if saturated {
    51	        if negative {
    52	            i64::MIN
    53	        } else {
    54	            i64::MAX
    55	        }
    56	    } else if negative {
    57	        -acc
    58	    } else {
    59	        acc
    60	    };
    61	
    62	    value as c_int
    63	}
    64	
    65	fn main() {
    66	    let argv: Vec<std::ffi::OsString> = std::env::args_os().collect();
    67	    let argc = argv.len();
    68	
    69	    if argc < 3 {
    70	        let program = argv
    71	            .first()
    72	            .map(|s| s.to_string_lossy().into_owned())
    73	            .unwrap_or_default();
    74	        let mut stderr = std::io::stderr();
    75	        let _ = write!(stderr, "usage: {} A B\n", program);
    76	        let _ = stderr.flush();
    77	        std::process::exit(2);
    78	    }
    79	
    80	    let a = atoi(argv[1].as_bytes());
    81	    let b = atoi(argv[2].as_bytes());
    82	
    83	    // int r_call = (OP_FN(OP))(a, b);
    84	    let r_call = (mdmacros::OP_FN)(a, b);
    85	
    86	    // int acc = INIT_FOR(OP); RUN_LOOP(OP, acc, REPEAT);
    87	    let acc = mdmacros::run_loop(mdmacros::INIT);
    88	
    89	    let x1 = mdcore::helper_call(a, b);
    90	    let x2 = mdcore::helper_ptr(a, b);
    91	    let x3 = mdcore::use_generated(mdmacros::REPEAT);
    92	    let g = (mdcore::G_OP)(a, b);
    93	
    94	    println!(
    95	        "op={} call={} acc={} g.call={}",
    96	        mdmacros::op_name_str(),
    97	        r_call,
    98	        acc,
    99	        g
   100	    );
   101	
   102	    let summary = r_call
   103	        .wrapping_add(acc)
   104	        .wrapping_add(x1)
   105	        .wrapping_add(x2)
   106	        .wrapping_add(x3)
   107	        .wrapping_add(g);
   108	    println!("summary={}", summary);
   109	}
