[0m[49m[38;5;10m+    275[0m:[38;5;10m[49m     assert_same_str("UINT32_MAX", "4294967295");
[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m     assert_same_str("2^32", "4294967296");
[0m[49m[38;5;10m+    277[0m:[38;5;10m[49m }
