[0m[49m[38;5;10m+    280[0m:[38;5;10m[49m fn out_of_range_conversion_is_clamped_then_truncated() {
[0m[49m[38;5;10m+    281[0m:[38;5;10m[49m     // glibc converts %d through a long, clamping at LONG_MAX/LONG_MIN, then
[0m[49m[38;5;10m+    282[0m:[38;5;10m[49m     // truncates to int. LONG_MAX -> -1, LONG_MIN -> 0.
