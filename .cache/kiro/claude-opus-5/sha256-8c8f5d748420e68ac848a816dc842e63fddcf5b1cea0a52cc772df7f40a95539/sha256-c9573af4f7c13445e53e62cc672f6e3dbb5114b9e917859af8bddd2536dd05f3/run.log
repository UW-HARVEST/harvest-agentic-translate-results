[0m[49m[38;5;10m+    700[0m:[38;5;10m[49m         (api.printLine)(ptr::null());
[0m[49m[38;5;10m+    701[0m:[38;5;10m[49m         (api.printLine)(ptr::null());
[0m[49m[38;5;10m+    702[0m:[38;5;10m[49m         call_print_line(api, b"after\0");
[0m[49m[38;5;10m+    703[0m:[38;5;10m[49m     });
