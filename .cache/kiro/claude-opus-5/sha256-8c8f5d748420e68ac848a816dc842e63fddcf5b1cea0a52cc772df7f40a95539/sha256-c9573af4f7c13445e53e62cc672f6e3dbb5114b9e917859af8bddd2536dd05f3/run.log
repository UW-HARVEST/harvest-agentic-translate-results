[0m[49m[38;5;10m+    809[0m:[38;5;10m[49m         match mode.as_str() {
[0m[49m[38;5;10m+    810[0m:[38;5;10m[49m             "devfull" => {
[0m[49m[38;5;10m+    811[0m:[38;5;10m[49m                 let f = fs::OpenOptions::new()
[0m[49m[38;5;10m+    812[0m:[38;5;10m[49m                     .write(true)
[0m[49m[38;5;10m+    813[0m:[38;5;10m[49m                     .open("/dev/full")
[0m[49m[38;5;10m+    814[0m:[38;5;10m[49m                     .expect("open /dev/full");
[0m[49m[38;5;10m+    815[0m:[38;5;10m[49m                 assert!(dup2(f.as_raw_fd(), 1) >= 0);
[0m[49m[38;5;10m+    816[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    817[0m:[38;5;10m[49m             "closed" => {
[0m[49m[38;5;10m+    818[0m:[38;5;10m[49m                 assert!(close(1) == 0 || true);
[0m[49m[38;5;10m+    819[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    820[0m:[38;5;10m[49m             other => panic!("unknown helper mode {other}"),
[0m[49m[38;5;10m+    821[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    822[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    823[0m:[38;5;10m[49m         // Every entry point, on a stdout that cannot be written.
[0m[49m[38;5;10m+    824[0m:[38;5;10m[49m         (api.printLine)(b"unwritable\0".as_ptr() as *const c_char);
[0m[49m[38;5;10m+    825[0m:[38;5;10m[49m         (api.printLine)(ptr::null());
[0m[49m[38;5;10m+    826[0m:[38;5;10m[49m         (api.bad)();
[0m[49m[38;5;10m+    827[0m:[38;5;10m[49m         (api.good)();
[0m[49m[38;5;10m+    828[0m:[38;5;10m[49m         (api.driver)();
[0m[49m[38;5;10m+    829[0m:[38;5;10m[49m         fflush(ptr::null_mut());
[0m[49m[38;5;10m+    830[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    831[0m:[38;5;10m[49m     // Reaching here without panic/abort is the assertion.
[0m[49m[38;5;10m+    832[0m:[38;5;10m[49m     std::process::exit(0);
[0m[49m[38;5;10m+    833[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    834[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    835[0m:[38;5;10m[49m /// ERRORS row 5 — vacuous, and documented as such: there is no `enum` or
[0m[49m[38;5;10m+    836[0m:[38;5;10m[49m /// integer parameter anywhere in this API, so no out-of-range enum value can be
[0m[49m[38;5;10m+    837[0m:[38;5;10m[49m /// passed across the FFI boundary. This test pins that fact down structurally
[0m[49m[38;5;10m+    838[0m:[38;5;10m[49m /// by calling every argument-less entry point through a `void(void)` pointer
[0m[49m[38;5;10m+    839[0m:[38;5;10m[49m /// type, and by re-deriving the parameter count from the C header.
[0m[49m[38;5;10m+    840[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    841[0m:[38;5;10m[49m fn test_err_05_no_enum_or_integer_input_exists() {
[0m[49m[38;5;10m+    842[0m:[38;5;10m[49m     let hdr = fs::read_to_string(workspace_root().join("c_src/include/driver.h")).expect("read driver.h");
[0m[49m[38;5;10m+    843[0m:[38;5;10m[49m     let src = fs::read_to_string(workspace_root().join("c_src/src/driver.c")).expect("read driver.c");
[0m[49m[38;5;10m+    844[0m:[38;5;10m[49m     assert!(
[0m[49m[38;5;10m+    845[0m:[38;5;10m[49m         !hdr.contains("enum") && !src.contains("enum"),
[0m[49m[38;5;10m+    846[0m:[38;5;10m[49m         "the C source gained an enum — ERRORS.md row 5 is no longer vacuous and needs real tests"
[0m[49m[38;5;10m+    847[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    848[0m:[38;5;10m[49m     assert!(
[0m[49m[38;5;10m+    849[0m:[38;5;10m[49m         !src.contains("switch"),
[0m[49m[38;5;10m+    850[0m:[38;5;10m[49m         "the C source gained a switch — ERRORS.md row 5 needs real tests"
[0m[49m[38;5;10m+    851[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    852[0m:[38;5;10m[49m     // The only parameter in the whole library is printLine's `const char *`.
[0m[49m[38;5;10m+    853[0m:[38;5;10m[49m     assert_eq!(
[0m[49m[38;5;10m+    854[0m:[38;5;10m[49m         src.matches("const char *").count(),
[0m[49m[38;5;10m+    855[0m:[38;5;10m[49m         1,
[0m[49m[38;5;10m+    856[0m:[38;5;10m[49m         "parameter surface of the C changed; re-derive ERRORS.md"
[0m[49m[38;5;10m+    857[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    858[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    859[0m:[38;5;10m[49m     // The argument-less entry points are genuinely `void(void)`: calling them
[0m[49m[38;5;10m+    860[0m:[38;5;10m[49m     // through a zero-arg fn pointer is well-defined for both .so's.
[0m[49m[38;5;10m+    861[0m:[38;5;10m[49m     let out = assert_same("err05/void(void) entry points", |api| unsafe {
[0m[49m[38;5;10m+    862[0m:[38;5;10m[49m         (api.bad)();
[0m[49m[38;5;10m+    863[0m:[38;5;10m[49m         (api.good)();
[0m[49m[38;5;10m+    864[0m:[38;5;10m[49m         (api.driver)();
[0m[49m[38;5;10m+    865[0m:[38;5;10m[49m     });
