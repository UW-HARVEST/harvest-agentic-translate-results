[0m[49m[38;5;10m+    707[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    708[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    709[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    710[0m:[38;5;10m[49m /// ERRORS row 2 — empty string is ACCEPTED, not rejected: the guard tests the
[0m[49m[38;5;10m+    711[0m:[38;5;10m[49m /// pointer, not emptiness. Distinguishes `line != NULL` from `line && *line`.
[0m[49m[38;5;10m+    712[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    713[0m:[38;5;10m[49m fn test_err_02_empty_string() {
