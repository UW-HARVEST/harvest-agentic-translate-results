[0m[49m[38;5;10m+    754[0m:[38;5;10m[49m /// ERRORS row 4 — stdout unwritable: `printf` fails, the C discards its return
[0m[49m[38;5;10m+    755[0m:[38;5;10m[49m /// value, so `printLine` still returns normally and nothing is reported. The
[0m[49m[38;5;10m+    756[0m:[38;5;10m[49m /// Rust must not panic or abort either.
[0m[49m[38;5;10m+    757[0m:[38;5;10m[49m ///
[0m[49m[38;5;10m+    758[0m:[38;5;10m[49m /// Implemented by pointing fd 1 at `/dev/full` (writes fail with ENOSPC) and by
[0m[49m[38;5;10m+    759[0m:[38;5;10m[49m /// closing fd 1 outright, in a *forked child* — an unwritable fd 1 poisons the
[0m[49m[38;5;10m+    760[0m:[38;5;10m[49m /// process-wide stdio error flag, so it must not leak into other tests.
[0m[49m[38;5;10m+    761[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    762[0m:[38;5;10m[49m fn test_err_04_stdout_closed_is_silently_ignored() {
[0m[49m[38;5;10m+    763[0m:[38;5;10m[49m     // Both variants are exercised in a child process; we compare the child's
[0m[49m[38;5;10m+    764[0m:[38;5;10m[49m     // exit status between C and Rust. A panic/abort in Rust would change it.
[0m[49m[38;5;10m+    765[0m:[38;5;10m[49m     for mode in ["devfull", "closed"] {
[0m[49m[38;5;10m+    766[0m:[38;5;10m[49m         let mut statuses = Vec::new();
[0m[49m[38;5;10m+    767[0m:[38;5;10m[49m         for which in ["c", "rust"] {
[0m[49m[38;5;10m+    768[0m:[38;5;10m[49m             let exe = std::env::current_exe().expect("current_exe");
[0m[49m[38;5;10m+    769[0m:[38;5;10m[49m             let st = std::process::Command::new(&exe)
[0m[49m[38;5;10m+    770[0m:[38;5;10m[49m                 .args(["--exact", "helper_unwritable_stdout", "--nocapture", "--ignored"])
[0m[49m[38;5;10m+    771[0m:[38;5;10m[49m                 .env("DRIVER_HELPER_MODE", mode)
[0m[49m[38;5;10m+    772[0m:[38;5;10m[49m                 .env("DRIVER_HELPER_WHICH", which)
[0m[49m[38;5;10m+    773[0m:[38;5;10m[49m                 .env("RUST_DRIVER_SO", rust_so_path())
[0m[49m[38;5;10m+    774[0m:[38;5;10m[49m                 .stdout(std::process::Stdio::null())
[0m[49m[38;5;10m+    775[0m:[38;5;10m[49m                 .stderr(std::process::Stdio::null())
[0m[49m[38;5;10m+    776[0m:[38;5;10m[49m                 .status()
[0m[49m[38;5;10m+    777[0m:[38;5;10m[49m                 .expect("spawn helper");
[0m[49m[38;5;10m+    778[0m:[38;5;10m[49m             statuses.push((which, st.code(), st.success()));
[0m[49m[38;5;10m+    779[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    780[0m:[38;5;10m[49m         let (_, c_code, c_ok) = statuses[0];
[0m[49m[38;5;10m+    781[0m:[38;5;10m[49m         let (_, r_code, r_ok) = statuses[1];
[0m[49m[38;5;10m+    782[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    783[0m:[38;5;10m[49m             (c_code, c_ok),
[0m[49m[38;5;10m+    784[0m:[38;5;10m[49m             (r_code, r_ok),
[0m[49m[38;5;10m+    785[0m:[38;5;10m[49m             "err04/{mode}: C exited {c_code:?} but Rust exited {r_code:?} — an unwritable \
[0m[49m[38;5;10m+    786[0m:[38;5;10m[49m              stdout must be swallowed identically (the C discards printf's return value)"
[0m[49m[38;5;10m+    787[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    788[0m:[38;5;10m[49m         assert!(
[0m[49m[38;5;10m+    789[0m:[38;5;10m[49m             c_ok,
[0m[49m[38;5;10m+    790[0m:[38;5;10m[49m             "err04/{mode}: sanity — the C helper itself should exit 0 (failure is ignored, not fatal)"
[0m[49m[38;5;10m+    791[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    792[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    793[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    794[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    795[0m:[38;5;10m[49m /// Child-process body for `test_err_04...`. Ignored so it never runs on its own.
[0m[49m[38;5;10m+    796[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    797[0m:[38;5;10m[49m #[ignore]
[0m[49m[38;5;10m+    798[0m:[38;5;10m[49m fn helper_unwritable_stdout() {
[0m[49m[38;5;10m+    799[0m:[38;5;10m[49m     let mode = std::env::var("DRIVER_HELPER_MODE").unwrap_or_default();
[0m[49m[38;5;10m+    800[0m:[38;5;10m[49m     let which = std::env::var("DRIVER_HELPER_WHICH").unwrap_or_default();
[0m[49m[38;5;10m+    801[0m:[38;5;10m[49m     if mode.is_empty() {
[0m[49m[38;5;10m+    802[0m:[38;5;10m[49m         return; // not invoked as a helper
[0m[49m[38;5;10m+    803[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    804[0m:[38;5;10m[49m     let (c, r) = apis();
[0m[49m[38;5;10m+    805[0m:[38;5;10m[49m     let api = if which == "c" { c } else { r };
[0m[49m[38;5;10m+    806[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    807[0m:[38;5;10m[49m     unsafe {
