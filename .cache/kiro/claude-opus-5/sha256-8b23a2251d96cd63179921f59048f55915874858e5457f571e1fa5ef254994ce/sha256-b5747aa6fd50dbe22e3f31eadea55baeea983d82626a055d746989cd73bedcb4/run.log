  for(int i=0;i<200;i++){ sprintf(kb,"key_%d_%d",i,i*3); sm=hmput_key(sm,sizeof(se),kb,sizeof(char*),1); sm[HDR(sm-1)->temp].value=i; }
  printf("sm len=%zu\n",HDR(sm-1)->length-1);
  for(int i=0;i<200;i+=7){ sprintf(kb,"key_%d_%d",i,i*3); sm=hmdel_key(sm,sizeof(se),kb,sizeof(char*),offsetof(se,key),1); printf("sdel %d -> %td\n",i,HDR(sm-1)->temp); }
  for(int i=0;i<200;i++){ sprintf(kb,"key_%d_%d",i,i*3); sm=hmget_key(sm,sizeof(se),kb,sizeof(char*),1); ptrdiff_t t=HDR(sm-1)->temp; printf("sget %d -> %td %d %s\n",i,t,t<0?-1:sm[t].value,t<0?"-":sm[t].key); }
  hmfree_func(sm-1,sizeof(se));

  /* arena mode */
  se *am = shmode_func(sizeof(se), 3 /* ARENA */);
  for(int i=0;i<300;i++){ sprintf(kb,"arena_%d",i); am=hmput_key(am,sizeof(se),kb,sizeof(char*),1); am[HDR(am-1)->temp].value=i*2; }
  for(int i=0;i<300;i+=11){ sprintf(kb,"arena_%d",i); am=hmget_key(am,sizeof(se),kb,sizeof(char*),1); ptrdiff_t t=HDR(am-1)->temp; printf("aget %d -> %td %d %s\n",i,t,am[t].value,am[t].key); }
  /* long string forcing oversized block */
  memset(kb,'z',60); kb[60]=0;
  char big[4096]; memset(big,'q',4095); big[4095]=0;
  am=hmput_key(am,sizeof(se),big,sizeof(char*),1); am[HDR(am-1)->temp].value=999;
  am=hmget_key(am,sizeof(se),big,sizeof(char*),1); printf("big -> %td %d len=%zu\n",HDR(am-1)->temp,am[HDR(am-1)->temp].value,strlen(am[HDR(am-1)->temp].key));
  hmfree_func(am-1,sizeof(se));

  /* hmput_default */
  be *dm=NULL; dm=hmput_default(dm,sizeof(be)); dm[-1].value=-77;
  long k=5; dm=hmget_key(dm,sizeof(be),&k,sizeof(long),0);
  printf("default temp=%td val=%ld\n",HDR(dm-1)->temp,dm[HDR(dm-1)->temp].value);
  hmfree_func(dm-1,sizeof(be));
  return 0;
}
