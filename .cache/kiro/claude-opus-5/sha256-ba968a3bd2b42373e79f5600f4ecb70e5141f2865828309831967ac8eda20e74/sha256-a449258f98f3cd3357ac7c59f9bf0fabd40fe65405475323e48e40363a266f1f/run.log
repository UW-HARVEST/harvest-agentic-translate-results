import struct,random,sys
random.seed(3)
out=bytearray()
def add(b): out.extend(struct.pack('<I', b & 0xffffffff))
# every exponent x a spread of mantissas
for e in range(0,256):
    for m in [0,1,2,3,0x7fffff,0x7ffffe,0x400000,0x3fffff,0x555555,0x2aaaaa,0x123456,0x7ffff0]:
