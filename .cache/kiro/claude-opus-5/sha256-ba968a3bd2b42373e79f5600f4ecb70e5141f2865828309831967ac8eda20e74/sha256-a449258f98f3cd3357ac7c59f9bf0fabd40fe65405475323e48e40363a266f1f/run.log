import struct, math
img=open('/tmp/memimage.bin','rb').read()
BASE=0x400000; END=0x406000
RT=0x405040; GI=0x405240; BS=0x405440
def u8(a):
    assert BASE<=a<END, "SEGV at %#x"%a
    return img[a-BASE]
def f32(a):
    assert BASE<=a and a+4<=END, "SEGV(f) at %#x"%a
    return struct.unpack('<f', img[a-BASE:a-BASE+4])[0]
def ff(v):
