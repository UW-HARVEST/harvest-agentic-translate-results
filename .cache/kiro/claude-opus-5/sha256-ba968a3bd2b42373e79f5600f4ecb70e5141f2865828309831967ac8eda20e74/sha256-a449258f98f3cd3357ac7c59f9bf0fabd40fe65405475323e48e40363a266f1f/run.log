    def crem(a,b):
        q=abs(a)//abs(b); q=-q if (a<0)!=(b<0) else q
        return a-q*b
    x0=crem(px,xw2); y0=crem(py,yw2); z0=crem(pz,zw2)
    if x0<0: x0+=xw2
    if y0<0: y0+=yw2
    if z0<0: z0+=zw2
    x1=crem(x0+1,xw2); y1=crem(y0+1,yw2); z1=crem(z0+1,zw2)
    print("px,py,pz",px,py,pz,"w2",xw2,yw2,zw2)
    print("x0,x1",x0,x1,"y0,y1",y0,y1,"z0,z1",z0,z1)
    r0=u8(RT+x0); print(" rt[%d]=%d addr %#x"%(x0,r0,RT+x0))
    r0=u8(RT+r0+seed); print(" r0=",r0)
    r1=u8(RT+x1); r1=u8(RT+r1+seed); print(" r1=",r1)
    r00=u8(RT+r0+y0); r01=u8(RT+r0+y1); r10=u8(RT+r1+y0); r11=u8(RT+r1+y1)
    print(" r00,r01,r10,r11",r00,r01,r10,r11)
    for nm,(r,zz) in {"n000":(r00,z0),"n001":(r00,z1),"n010":(r01,z0),"n011":(r01,z1),
                      "n100":(r10,z0),"n101":(r10,z1),"n110":(r11,z0),"n111":(r11,z1)}.items():
        gi=u8(GI+r+zz)
        print("  %s gi=%d  basisaddr=%#x  ok=%s"%(nm,gi,BS+gi*16, BS+gi*16+12<=END))
