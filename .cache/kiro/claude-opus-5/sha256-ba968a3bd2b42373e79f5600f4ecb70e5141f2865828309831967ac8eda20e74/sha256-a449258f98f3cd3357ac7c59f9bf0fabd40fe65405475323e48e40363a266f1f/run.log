mod cscan;
use std::io::Read;
fn hexf(v: f32) -> String {
    // glibc "%a" for a double promoted from float
    let d = v as f64;
    if d.is_nan() { return if d.is_sign_negative() {"-nan".into()} else {"nan".into()}; }
    if d.is_infinite() { return if d<0.0 {"-inf".into()} else {"inf".into()}; }
    let bits = d.to_bits();
    let neg = bits >> 63 == 1;
    let exp = ((bits >> 52) & 0x7ff) as i64;
    let man = bits & 0xf_ffff_ffff_ffff;
    let (lead, e) = if exp == 0 { (0u64, -1022i64) } else { (1u64, exp - 1023) };
    let mut frac = format!("{:013x}", man);
    while frac.ends_with('0') { frac.pop(); }
    let s = if frac.is_empty() { format!("0x{}p{}{}", lead, if e<0 {"-"} else {"+"}, e.abs()) }
            else { format!("0x{}.{}p{}{}", lead, frac, if e<0 {"-"} else {"+"}, e.abs()) };
    if neg { format!("-{}", s) } else { s }
}
fn main(){
    let mut b=Vec::new(); std::io::stdin().read_to_end(&mut b).unwrap();
    let mut sc=cscan::Scanner::new(&b);
    let (mut which,mut xw,mut yw,mut zw,mut seed,mut oct)=(0i32,0i32,0i32,0i32,0i32,0i32);
    let (mut x,mut y,mut z,mut lac,mut gain,mut off)=(0f32,0f32,0f32,0f32,0f32,0f32);
    let mut n=0i32;
    'a: {
        macro_rules! d { ($v:ident) => { match sc.scan_i32() { Some(v)=>{$v=v; n+=1;}, None=>break 'a } } }
        macro_rules! f { ($v:ident) => { match sc.scan_f32() { Some(v)=>{$v=v; n+=1;}, None=>break 'a } } }
        d!(which); f!(x); f!(y); f!(z); d!(xw); d!(yw); d!(zw); d!(seed); f!(lac); f!(gain); f!(off); d!(oct);
    }
    if n==0 && b.iter().all(|c| matches!(c, b' '|b'\t'|b'\n'|0x0b|0x0c|b'\r')) { n = -1; }
    else if n==0 { n = 0; }
    println!("n={} {} {} {} {} {} {} {} {} {} {} {} {}", n, which, hexf(x),hexf(y),hexf(z),
             xw,yw,zw,seed,hexf(lac),hexf(gain),hexf(off),oct);
}
EOF
