[49m[38;5;10m+      1[0m:[38;5;10m[49m //! Faithful re-implementation of the glibc `<ctype.h>` lookup tables for the
[0m[49m[38;5;10m+      2[0m:[38;5;10m[49m //! `"C"` locale, as used by the original C program.
[0m[49m[38;5;10m+      3[0m:[38;5;10m[49m //!
[0m[49m[38;5;10m+      4[0m:[38;5;10m[49m //! Two details of the C original are load-bearing and are reproduced here:
[0m[49m[38;5;10m+      5[0m:[38;5;10m[49m //!
[0m[49m[38;5;10m+      6[0m:[38;5;10m[49m //! 1. glibc implements `isalnum()` and friends as macros that mask a table
[0m[49m[38;5;10m+      7[0m:[38;5;10m[49m //!    entry (`(*__ctype_b_loc ())[c] & _ISalnum`) and hand the *raw masked
[0m[49m[38;5;10m+      8[0m:[38;5;10m[49m //!    bits* back to the caller. So `printf("%d", isalpha('a'))` prints `1024`,
[0m[49m[38;5;10m+      9[0m:[38;5;10m[49m //!    not `1`. The mask constants below are exactly glibc's `_ISbit` values.
[0m[49m[38;5;10m+     10[0m:[38;5;10m[49m //!
[0m[49m[38;5;10m+     11[0m:[38;5;10m[49m //! 2. The tables are addressed from `-128` through `255`, because a plain
[0m[49m[38;5;10m+     12[0m:[38;5;10m[49m //!    `char` is signed on this platform. In the `"C"` locale every entry in
[0m[49m[38;5;10m+     13[0m:[38;5;10m[49m //!    the `-128..=-1` and `128..=255` regions is zero, and the case-conversion
[0m[49m[38;5;10m+     14[0m:[38;5;10m[49m //!    tables are the identity there. Passing a negative `char` therefore
[0m[49m[38;5;10m+     15[0m:[38;5;10m[49m //!    classifies as "nothing at all" rather than trapping.
[0m[49m[38;5;10m+     16[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     17[0m:[38;5;10m[49m /// `_ISbit(0)` — uppercase.
[0m[49m[38;5;10m+     18[0m:[38;5;10m[49m pub const IS_UPPER: u16 = 0x0100;
[0m[49m[38;5;10m+     19[0m:[38;5;10m[49m /// `_ISbit(1)` — lowercase.
[0m[49m[38;5;10m+     20[0m:[38;5;10m[49m pub const IS_LOWER: u16 = 0x0200;
[0m[49m[38;5;10m+     21[0m:[38;5;10m[49m /// `_ISbit(2)` — alphabetic.
[0m[49m[38;5;10m+     22[0m:[38;5;10m[49m pub const IS_ALPHA: u16 = 0x0400;
[0m[49m[38;5;10m+     23[0m:[38;5;10m[49m /// `_ISbit(3)` — decimal digit.
[0m[49m[38;5;10m+     24[0m:[38;5;10m[49m pub const IS_DIGIT: u16 = 0x0800;
[0m[49m[38;5;10m+     25[0m:[38;5;10m[49m /// `_ISbit(4)` — hexadecimal digit.
[0m[49m[38;5;10m+     26[0m:[38;5;10m[49m pub const IS_XDIGIT: u16 = 0x1000;
