[0m[49m[38;5;10m+     47[0m:[38;5;10m[49m /// Classification bits for one ASCII code point in the `"C"` locale.
[0m[49m[38;5;10m+     48[0m:[38;5;10m[49m const fn class_of(c: u8) -> u16 {
