[0m[49m[38;5;10m+     30[0m:[38;5;10m[49m pub const IS_PRINT: u16 = 0x4000;
[0m[49m[38;5;10m+     31[0m:[38;5;10m[49m /// `_ISbit(7)` — graphical.
[0m[49m[38;5;10m+     32[0m:[38;5;10m[49m pub const IS_GRAPH: u16 = 0x8000;
[0m[49m[38;5;10m+     33[0m:[38;5;10m[49m /// `_ISbit(8)` — blank.
[0m[49m[38;5;10m+     34[0m:[38;5;10m[49m pub const IS_BLANK: u16 = 0x0001;
[0m[49m[38;5;10m+     35[0m:[38;5;10m[49m /// `_ISbit(9)` — control.
[0m[49m[38;5;10m+     36[0m:[38;5;10m[49m pub const IS_CNTRL: u16 = 0x0002;
[0m[49m[38;5;10m+     37[0m:[38;5;10m[49m /// `_ISbit(10)` — punctuation.
[0m[49m[38;5;10m+     38[0m:[38;5;10m[49m pub const IS_PUNCT: u16 = 0x0004;
[0m[49m[38;5;10m+     39[0m:[38;5;10m[49m /// `_ISbit(11)` — alphanumeric.
