[0m[49m[38;5;10m+     41[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     42[0m:[38;5;10m[49m /// The tables are indexed from `-128`, so this is added to the character value.
[0m[49m[38;5;10m+     43[0m:[38;5;10m[49m const TABLE_BIAS: i32 = 128;
