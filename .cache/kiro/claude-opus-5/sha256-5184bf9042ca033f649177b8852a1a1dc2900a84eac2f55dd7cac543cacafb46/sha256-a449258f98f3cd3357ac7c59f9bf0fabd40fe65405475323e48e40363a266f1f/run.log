[0m[49m[38;5;10m+    412[0m:[38;5;10m[49m         ["5e-324", "5e-324", "5e-324"],
[0m[49m[38;5;10m+    413[0m:[38;5;10m[49m         // float boundaries: max finite, min normal, min subnormal.
[0m[49m[38;5;10m+    414[0m:[38;5;10m[49m         ["3.4028234663852886e38", "1", "1"],
[0m[49m[38;5;10m+    415[0m:[38;5;10m[49m         ["3.4028235e38", "3.4028235e38", "3.4028235e38"],
[0m[49m[38;5;10m+    416[0m:[38;5;10m[49m         ["1.1754943508222875e-38", "1", "1"],
[0m[49m[38;5;10m+    417[0m:[38;5;10m[49m         ["1.401298464324817e-45", "1", "1"],
[0m[49m[38;5;10m+    418[0m:[38;5;10m[49m         ["1e-45", "1e-45", "1e-45"],
[0m[49m[38;5;10m+    419[0m:[38;5;10m[49m         ["1e-38", "1e-38", "1e-38"],
[0m[49m[38;5;10m+    420[0m:[38;5;10m[49m         ["1e38", "1e38", "1e38"],
[0m[49m[38;5;10m+    421[0m:[38;5;10m[49m         // Long digit strings that must still round identically.
[0m[49m[38;5;10m+    422[0m:[38;5;10m[49m         ["9999999999999999999999999999999999999999", "1", "1"],
[0m[49m[38;5;10m+    423[0m:[38;5;10m[49m         ["0.000000000000000000000000000000000000000001", "1", "1"],
[0m[49m[38;5;10m+    424[0m:[38;5;10m[49m     ]);
[0m[49m[38;5;10m+    425[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    426[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    427[0m:[38;5;10m[49m /// Non-finite inputs, where `Q_rsqrt` and the final multiplies go through the
[0m[49m[38;5;10m+    428[0m:[38;5;10m[49m /// IEEE special cases. `printf` spells these `inf`/`-inf`/`nan`/`-nan`, and the
[0m[49m[38;5;10m+    429[0m:[38;5;10m[49m /// sign of a NaN is observable, so every sign combination is exercised.
[0m[49m[38;5;10m+    430[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    431[0m:[38;5;10m[49m fn infinities_and_nans_through_the_math() {
[0m[49m[38;5;10m+    432[0m:[38;5;10m[49m     let specials = [
[0m[49m[38;5;10m+    433[0m:[38;5;10m[49m         "0", "-0", "1", "-1", "inf", "-inf", "nan", "-nan", "1e39", "-1e39", "1e-45", "-1e-45",
[0m[49m[38;5;10m+    434[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    435[0m:[38;5;10m[49m     for a in specials.iter() {
[0m[49m[38;5;10m+    436[0m:[38;5;10m[49m         for b in specials.iter() {
[0m[49m[38;5;10m+    437[0m:[38;5;10m[49m             for c in specials.iter() {
[0m[49m[38;5;10m+    438[0m:[38;5;10m[49m                 assert_same(&[oss(a), oss(b), oss(c)]);
[0m[49m[38;5;10m+    439[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    440[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    441[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    442[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    443[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    444[0m:[38;5;10m[49m /// `inf * 0` and `inf + -inf` are invalid operations. On x86 they yield the
[0m[49m[38;5;10m+    445[0m:[38;5;10m[49m /// "QNaN floating-point indefinite", whose sign bit is *set*, so the C program
[0m[49m[38;5;10m+    446[0m:[38;5;10m[49m /// prints `-nan` rather than `nan` for these.
[0m[49m[38;5;10m+    447[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    448[0m:[38;5;10m[49m fn invalid_operations_print_negative_nan() {
[0m[49m[38;5;10m+    449[0m:[38;5;10m[49m     check_triples(&[
[0m[49m[38;5;10m+    450[0m:[38;5;10m[49m         ["inf", "0", "0"],
[0m[49m[38;5;10m+    451[0m:[38;5;10m[49m         ["-inf", "0", "0"],
[0m[49m[38;5;10m+    452[0m:[38;5;10m[49m         ["0", "inf", "0"],
[0m[49m[38;5;10m+    453[0m:[38;5;10m[49m         ["0", "0", "inf"],
[0m[49m[38;5;10m+    454[0m:[38;5;10m[49m         ["inf", "0", "1"],
[0m[49m[38;5;10m+    455[0m:[38;5;10m[49m         ["1e39", "0", "0"],
[0m[49m[38;5;10m+    456[0m:[38;5;10m[49m         ["inf", "-inf", "0"],
[0m[49m[38;5;10m+    457[0m:[38;5;10m[49m         ["1e39", "-1e39", "0"],
[0m[49m[38;5;10m+    458[0m:[38;5;10m[49m         ["inf", "inf", "0"],
[0m[49m[38;5;10m+    459[0m:[38;5;10m[49m     ]);
[0m[49m[38;5;10m+    460[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    461[0m:[38;5;10m[49m     // Pin the actual bytes: this is the case that a "NaN is NaN" comparison
[0m[49m[38;5;10m+    462[0m:[38;5;10m[49m     // would wave through.
[0m[49m[38;5;10m+    463[0m:[38;5;10m[49m     let args = [oss("inf"), oss("0"), oss("0")];
[0m[49m[38;5;10m+    464[0m:[38;5;10m[49m     let c = run(c_binary(), &args);
[0m[49m[38;5;10m+    465[0m:[38;5;10m[49m     assert_eq!(c.stdout, b"-inf -nan -nan\n");
[0m[49m[38;5;10m+    466[0m:[38;5;10m[49m     assert_same(&args);
[0m[49m[38;5;10m+    467[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    468[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    469[0m:[38;5;10m[49m /// Arguments are raw bytes, not text: `argv` need not be valid UTF-8.
[0m[49m[38;5;10m+    470[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    471[0m:[38;5;10m[49m fn non_utf8_arguments() {
[0m[49m[38;5;10m+    472[0m:[38;5;10m[49m     let cases: Vec<Vec<Vec<u8>>> = vec![
[0m[49m[38;5;10m+    473[0m:[38;5;10m[49m         vec![b"\x80\xff".to_vec(), b"1".to_vec(), b"1".to_vec()],
[0m[49m[38;5;10m+    474[0m:[38;5;10m[49m         vec![b"1".to_vec(), b"\xc3".to_vec(), b"1".to_vec()],
[0m[49m[38;5;10m+    475[0m:[38;5;10m[49m         vec![b"1".to_vec(), b"1".to_vec(), b"\xfe\xfd\xfc".to_vec()],
[0m[49m[38;5;10m+    476[0m:[38;5;10m[49m         vec![b"\xff5".to_vec(), b"5\xff".to_vec(), b"5".to_vec()],
[0m[49m[38;5;10m+    477[0m:[38;5;10m[49m         // Valid UTF-8 but not ASCII digits: full-width "123".
[0m[49m[38;5;10m+    478[0m:[38;5;10m[49m         vec!["１２３".as_bytes().to_vec(), b"1".to_vec(), b"1".to_vec()],
[0m[49m[38;5;10m+    479[0m:[38;5;10m[49m         // Wrong arity with non-UTF-8 bytes, i.e. the error path.
[0m[49m[38;5;10m+    480[0m:[38;5;10m[49m         vec![b"\x80\xff".to_vec(), b"1".to_vec()],
[0m[49m[38;5;10m+    481[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    482[0m:[38;5;10m[49m     for case in &cases {
[0m[49m[38;5;10m+    483[0m:[38;5;10m[49m         let args: Vec<OsString> = case.iter().map(|b| bytes(b)).collect();
[0m[49m[38;5;10m+    484[0m:[38;5;10m[49m         assert_same(&args);
[0m[49m[38;5;10m+    485[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    486[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    487[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    488[0m:[38;5;10m[49m /// Very long arguments: `atof` reads the whole token, however long.
[0m[49m[38;5;10m+    489[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    490[0m:[38;5;10m[49m fn very_long_arguments() {
[0m[49m[38;5;10m+    491[0m:[38;5;10m[49m     let long_int = "9".repeat(5000);
[0m[49m[38;5;10m+    492[0m:[38;5;10m[49m     let long_frac = format!("0.{}1", "0".repeat(5000));
[0m[49m[38;5;10m+    493[0m:[38;5;10m[49m     let long_hex = format!("0x{}p-8000", "f".repeat(2000));
[0m[49m[38;5;10m+    494[0m:[38;5;10m[49m     let long_exp = format!("1e{}", "9".repeat(400));
[0m[49m[38;5;10m+    495[0m:[38;5;10m[49m     let long_ws = format!("{}5", " ".repeat(4000));
[0m[49m[38;5;10m+    496[0m:[38;5;10m[49m     let long_zeros = format!("{}1", "0".repeat(5000));
[0m[49m[38;5;10m+    497[0m:[38;5;10m[49m     let cases = [
[0m[49m[38;5;10m+    498[0m:[38;5;10m[49m         [long_int.as_str(), "1", "1"],
[0m[49m[38;5;10m+    499[0m:[38;5;10m[49m         [long_frac.as_str(), "1", "1"],
[0m[49m[38;5;10m+    500[0m:[38;5;10m[49m         [long_hex.as_str(), "1", "1"],
[0m[49m[38;5;10m+    501[0m:[38;5;10m[49m         [long_exp.as_str(), "1", "1"],
[0m[49m[38;5;10m+    502[0m:[38;5;10m[49m         [long_ws.as_str(), "1", "1"],
[0m[49m[38;5;10m+    503[0m:[38;5;10m[49m         [long_zeros.as_str(), "1", "1"],
[0m[49m[38;5;10m+    504[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    505[0m:[38;5;10m[49m     check_triples(&cases);
[0m[49m[38;5;10m+    506[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    507[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    508[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    509[0m:[38;5;10m[49m // Phase C: broader sweeps, to catch paths the hand-written cases miss
[0m[49m[38;5;10m+    510[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    511[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    512[0m:[38;5;10m[49m /// Deterministic 64-bit xorshift, so the sweeps below are reproducible.
[0m[49m[38;5;10m+    513[0m:[38;5;10m[49m struct Rng(u64);
[0m[49m[38;5;10m+    514[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    515[0m:[38;5;10m[49m impl Rng {
[0m[49m[38;5;10m+    516[0m:[38;5;10m[49m     fn next_u64(&mut self) -> u64 {
[0m[49m[38;5;10m+    517[0m:[38;5;10m[49m         let mut x = self.0;
[0m[49m[38;5;10m+    518[0m:[38;5;10m[49m         x ^= x << 13;
[0m[49m[38;5;10m+    519[0m:[38;5;10m[49m         x ^= x >> 7;
[0m[49m[38;5;10m+    520[0m:[38;5;10m[49m         x ^= x << 17;
[0m[49m[38;5;10m+    521[0m:[38;5;10m[49m         self.0 = x;
[0m[49m[38;5;10m+    522[0m:[38;5;10m[49m         x
[0m[49m[38;5;10m+    523[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    524[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    525[0m:[38;5;10m[49m     fn next_u32(&mut self) -> u32 {
[0m[49m[38;5;10m+    526[0m:[38;5;10m[49m         (self.next_u64() >> 32) as u32
[0m[49m[38;5;10m+    527[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    528[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    529[0m:[38;5;10m[49m     fn below(&mut self, n: usize) -> usize {
[0m[49m[38;5;10m+    530[0m:[38;5;10m[49m         (self.next_u64() % n as u64) as usize
[0m[49m[38;5;10m+    531[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    532[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    533[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    534[0m:[38;5;10m[49m /// Render an `f32` as a decimal string that `atof` converts back to exactly the
[0m[49m[38;5;10m+    535[0m:[38;5;10m[49m /// same `f32`. `f32 -> f64` is exact and 17 significant digits round-trip an
[0m[49m[38;5;10m+    536[0m:[38;5;10m[49m /// `f64`, so the conversion is lossless.
[0m[49m[38;5;10m+    537[0m:[38;5;10m[49m fn exact_arg(f: f32) -> String {
[0m[49m[38;5;10m+    538[0m:[38;5;10m[49m     if f.is_nan() {
[0m[49m[38;5;10m+    539[0m:[38;5;10m[49m         // `atof` cannot spell an arbitrary NaN payload, and the payload is not
[0m[49m[38;5;10m+    540[0m:[38;5;10m[49m         // observable in `%f` output -- only the sign is.
[0m[49m[38;5;10m+    541[0m:[38;5;10m[49m         return if f.is_sign_negative() {
[0m[49m[38;5;10m+    542[0m:[38;5;10m[49m             "-nan".to_string()
[0m[49m[38;5;10m+    543[0m:[38;5;10m[49m         } else {
[0m[49m[38;5;10m+    544[0m:[38;5;10m[49m             "nan".to_string()
[0m[49m[38;5;10m+    545[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+    546[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    547[0m:[38;5;10m[49m     if f.is_infinite() {
[0m[49m[38;5;10m+    548[0m:[38;5;10m[49m         return if f < 0.0 { "-inf" } else { "inf" }.to_string();
[0m[49m[38;5;10m+    549[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    550[0m:[38;5;10m[49m     format!("{:.17e}", f as f64)
[0m[49m[38;5;10m+    551[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    552[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    553[0m:[38;5;10m[49m /// Notable `f32` bit patterns: zeros, subnormals, the normal boundary, the max
[0m[49m[38;5;10m+    554[0m:[38;5;10m[49m /// finite value, infinities, quiet NaNs of both signs, and the magic constants
[0m[49m[38;5;10m+    555[0m:[38;5;10m[49m /// from `Q_rsqrt` itself.
[0m[49m[38;5;10m+    556[0m:[38;5;10m[49m const SPECIAL_BITS: [u32; 28] = [
[0m[49m[38;5;10m+    557[0m:[38;5;10m[49m     0x0000_0000, // +0
[0m[49m[38;5;10m+    558[0m:[38;5;10m[49m     0x8000_0000, // -0
[0m[49m[38;5;10m+    559[0m:[38;5;10m[49m     0x0000_0001, // smallest +subnormal
[0m[49m[38;5;10m+    560[0m:[38;5;10m[49m     0x8000_0001, // smallest -subnormal
[0m[49m[38;5;10m+    561[0m:[38;5;10m[49m     0x007f_ffff, // largest +subnormal
[0m[49m[38;5;10m+    562[0m:[38;5;10m[49m     0x807f_ffff, // largest -subnormal
[0m[49m[38;5;10m+    563[0m:[38;5;10m[49m     0x0080_0000, // smallest +normal
[0m[49m[38;5;10m+    564[0m:[38;5;10m[49m     0x8080_0000, // smallest -normal
[0m[49m[38;5;10m+    565[0m:[38;5;10m[49m     0x3f80_0000, // 1.0
[0m[49m[38;5;10m+    566[0m:[38;5;10m[49m     0xbf80_0000, // -1.0
[0m[49m[38;5;10m+    567[0m:[38;5;10m[49m     0x3fc0_0000, // 1.5 (threehalfs)
[0m[49m[38;5;10m+    568[0m:[38;5;10m[49m     0x7f7f_ffff, // max finite
[0m[49m[38;5;10m+    569[0m:[38;5;10m[49m     0xff7f_ffff, // -max finite
[0m[49m[38;5;10m+    570[0m:[38;5;10m[49m     0x7f80_0000, // +inf
[0m[49m[38;5;10m+    571[0m:[38;5;10m[49m     0xff80_0000, // -inf
[0m[49m[38;5;10m+    572[0m:[38;5;10m[49m     0x7fc0_0000, // +qNaN
[0m[49m[38;5;10m+    573[0m:[38;5;10m[49m     0xffc0_0000, // -qNaN (the x86 indefinite)
[0m[49m[38;5;10m+    574[0m:[38;5;10m[49m     0x7fc0_0001, // +qNaN, other payload
[0m[49m[38;5;10m+    575[0m:[38;5;10m[49m     0xffc0_0001, // -qNaN, other payload
[0m[49m[38;5;10m+    576[0m:[38;5;10m[49m     0x7f80_0001, // +sNaN
[0m[49m[38;5;10m+    577[0m:[38;5;10m[49m     0xff80_0001, // -sNaN
[0m[49m[38;5;10m+    578[0m:[38;5;10m[49m     0x7fff_ffff, // +NaN, all payload bits
[0m[49m[38;5;10m+    579[0m:[38;5;10m[49m     0xffff_ffff, // -NaN, all payload bits
[0m[49m[38;5;10m+    580[0m:[38;5;10m[49m     0x4b00_0000, // 2^23, where floats stop being contiguous integers
[0m[49m[38;5;10m+    581[0m:[38;5;10m[49m     0x5f37_59df, // the Q_rsqrt magic constant read as a float
[0m[49m[38;5;10m+    582[0m:[38;5;10m[49m     0x1f77_59df, // Q_rsqrt(inf)'s intermediate
[0m[49m[38;5;10m+    583[0m:[38;5;10m[49m     0x7e80_0000, // large enough that squaring overflows to inf
[0m[49m[38;5;10m+    584[0m:[38;5;10m[49m     0xfe80_0000, // negative counterpart
[0m[49m[38;5;10m+    585[0m:[38;5;10m[49m ];
[0m[49m[38;5;10m+    586[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    587[0m:[38;5;10m[49m /// Every ordered pair of notable bit patterns in the first two components.
[0m[49m[38;5;10m+    588[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    589[0m:[38;5;10m[49m fn sweep_special_bit_patterns() {
[0m[49m[38;5;10m+    590[0m:[38;5;10m[49m     let mut rng = Rng(0x1234_5678_9abc_def1);
[0m[49m[38;5;10m+    591[0m:[38;5;10m[49m     for &a in SPECIAL_BITS.iter() {
[0m[49m[38;5;10m+    592[0m:[38;5;10m[49m         for &b in SPECIAL_BITS.iter() {
[0m[49m[38;5;10m+    593[0m:[38;5;10m[49m             let c = SPECIAL_BITS[rng.below(SPECIAL_BITS.len())];
[0m[49m[38;5;10m+    594[0m:[38;5;10m[49m             assert_same(&[
