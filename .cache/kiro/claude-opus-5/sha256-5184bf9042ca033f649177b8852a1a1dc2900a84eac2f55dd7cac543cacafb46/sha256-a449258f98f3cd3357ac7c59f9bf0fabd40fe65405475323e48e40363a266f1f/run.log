#include <unistd.h>
#include <stdio.h>
#include <string.h>
// exec target with a caller-chosen argv, including the empty (argc==0) case.
int main(int argc, char** argv) {
    // argv[1] = target, argv[2] = "none" for empty argv, else arg0 to use,
    // remaining args passed through.
    char* target = argv[1];
    if (strcmp(argv[2], "none") == 0) {
        char* av[1] = { NULL };
        execv(target, av);
    } else {
        char* av[8];
        int n = 0;
        av[n++] = argv[2];
        for (int i = 3; i < argc; i++) av[n++] = argv[i];
        av[n] = NULL;
        execv(target, av);
    }
    perror("execv");
    return 127;
}
