project(lz4 C)

set(CMAKE_C_STANDARD 99)

add_library(lz4 SHARED
    src/lz4.c
    src/lz4hc.c
    src/lz4frame.c
    src/lz4file.c
    src/xxhash.c
)

target_include_directories(lz4
    PUBLIC include
