[0m[49m[38;5;10m+    463[0m:[38;5;10m[49m     } else if raw & 0x7f == 0 {
[0m[49m[38;5;10m+    464[0m:[38;5;10m[49m         Outcome::Exited((raw >> 8) & 0xff)
[0m[49m[38;5;10m+    465[0m:[38;5;10m[49m     } else {
