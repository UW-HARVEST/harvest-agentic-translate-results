[0m[49m[38;5;10m+    438[0m:[38;5;10m[49m /// the SAME way instead of "improving" the C by adding a check, and the only
[0m[49m[38;5;10m+    439[0m:[38;5;10m[49m /// way to observe that differentially is to run each in its own process and
[0m[49m[38;5;10m+    440[0m:[38;5;10m[49m /// compare how it died.
[0m[49m[38;5;10m+    441[0m:[38;5;10m[49m pub fn child_status<F: FnOnce()>(f: F) -> i32 {
[0m[49m[38;5;10m+    442[0m:[38;5;10m[49m     let pid = unsafe { fork() };
[0m[49m[38;5;10m+    443[0m:[38;5;10m[49m     if pid == 0 {
[0m[49m[38;5;10m+    444[0m:[38;5;10m[49m         f();
[0m[49m[38;5;10m+    445[0m:[38;5;10m[49m         unsafe { _exit(0) }
[0m[49m[38;5;10m+    446[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    447[0m:[38;5;10m[49m     assert!(pid > 0, "fork() failed");
[0m[49m[38;5;10m+    448[0m:[38;5;10m[49m     let mut st = 0i32;
[0m[49m[38;5;10m+    449[0m:[38;5;10m[49m     unsafe { waitpid(pid, &mut st, 0) };
[0m[49m[38;5;10m+    450[0m:[38;5;10m[49m     st
[0m[49m[38;5;10m+    451[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    452[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    453[0m:[38;5;10m[49m /// Decode a raw wait status into a comparable, printable outcome.
[0m[49m[38;5;10m+    454[0m:[38;5;10m[49m #[derive(Debug, PartialEq, Eq)]
