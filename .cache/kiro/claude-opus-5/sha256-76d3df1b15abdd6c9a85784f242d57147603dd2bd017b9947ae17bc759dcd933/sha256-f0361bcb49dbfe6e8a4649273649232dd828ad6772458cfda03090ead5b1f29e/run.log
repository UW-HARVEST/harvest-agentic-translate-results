[0m[49m[38;5;10m+    510[0m:[38;5;10m[49m             "err21: C build unexpectedly died for len={len}"
[0m[49m[38;5;10m+    511[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    512[0m:[38;5;10m[49m         assert_eq!(
