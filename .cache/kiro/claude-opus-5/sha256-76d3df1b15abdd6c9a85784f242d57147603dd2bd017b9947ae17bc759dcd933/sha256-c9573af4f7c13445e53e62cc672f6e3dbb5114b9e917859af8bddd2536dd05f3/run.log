[0m[49m[38;5;10m+    737[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    738[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    739[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    740[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    741[0m:[38;5;10m[49m // C33 — the composed pipeline
[0m[49m[38;5;10m+    742[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    743[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    744[0m:[38;5;10m[49m /// C33 — cross-check the composed `driver -> call_fma -> fma_array` pipeline
[0m[49m[38;5;10m+    745[0m:[38;5;10m[49m /// against a direct `call_fma` on the same parsed prefix. A per-wrapper test
[0m[49m[38;5;10m+    746[0m:[38;5;10m[49m /// cannot see a bug where two stages' errors cancel; this can.
[0m[49m[38;5;10m+    747[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    748[0m:[38;5;10m[49m fn c33_pipeline_cross_check() {
[0m[49m[38;5;10m+    749[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 33);
[0m[49m[38;5;10m+    750[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    751[0m:[38;5;10m[49m     // Mirror of the C parse loop, so the expected prefix is derived
[0m[49m[38;5;10m+    752[0m:[38;5;10m[49m     // independently of either implementation under test.
[0m[49m[38;5;10m+    753[0m:[38;5;10m[49m     fn parse_prefix(s: &str) -> Vec<i32> {
[0m[49m[38;5;10m+    754[0m:[38;5;10m[49m         let mut out = Vec::new();
[0m[49m[38;5;10m+    755[0m:[38;5;10m[49m         let mut rest = s;
[0m[49m[38;5;10m+    756[0m:[38;5;10m[49m         while out.len() < 100 {
[0m[49m[38;5;10m+    757[0m:[38;5;10m[49m             let t = rest.trim_start();
[0m[49m[38;5;10m+    758[0m:[38;5;10m[49m             let mut end = 0;
[0m[49m[38;5;10m+    759[0m:[38;5;10m[49m             let b = t.as_bytes();
[0m[49m[38;5;10m+    760[0m:[38;5;10m[49m             if end < b.len() && (b[end] == b'+' || b[end] == b'-') {
[0m[49m[38;5;10m+    761[0m:[38;5;10m[49m                 end += 1;
[0m[49m[38;5;10m+    762[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    763[0m:[38;5;10m[49m             let digits_start = end;
[0m[49m[38;5;10m+    764[0m:[38;5;10m[49m             while end < b.len() && b[end].is_ascii_digit() {
[0m[49m[38;5;10m+    765[0m:[38;5;10m[49m                 end += 1;
[0m[49m[38;5;10m+    766[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    767[0m:[38;5;10m[49m             if end == digits_start {
[0m[49m[38;5;10m+    768[0m:[38;5;10m[49m                 break; // matching failure or EOF
[0m[49m[38;5;10m+    769[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    770[0m:[38;5;10m[49m             match t[..end].parse::<i32>() {
[0m[49m[38;5;10m+    771[0m:[38;5;10m[49m                 Ok(v) => out.push(v),
[0m[49m[38;5;10m+    772[0m:[38;5;10m[49m                 // Over-range: glibc saturates, which this cross-check does not
[0m[49m[38;5;10m+    773[0m:[38;5;10m[49m                 // model, so stop rather than assert a value we did not derive.
[0m[49m[38;5;10m+    774[0m:[38;5;10m[49m                 Err(_) => break,
[0m[49m[38;5;10m+    775[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    776[0m:[38;5;10m[49m             rest = &t[end..];
[0m[49m[38;5;10m+    777[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    778[0m:[38;5;10m[49m         out
[0m[49m[38;5;10m+    779[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    780[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    781[0m:[38;5;10m[49m     for it in 0..ITERS {
[0m[49m[38;5;10m+    782[0m:[38;5;10m[49m         let n = rng.range(0, 150);
[0m[49m[38;5;10m+    783[0m:[38;5;10m[49m         // Magnitudes kept inside `i32` so `parse_prefix` never hits saturation.
[0m[49m[38;5;10m+    784[0m:[38;5;10m[49m         let vals: Vec<i32> = (0..n).map(|_| rng.i32_full()).collect();
[0m[49m[38;5;10m+    785[0m:[38;5;10m[49m         let s = vals
[0m[49m[38;5;10m+    786[0m:[38;5;10m[49m             .iter()
[0m[49m[38;5;10m+    787[0m:[38;5;10m[49m             .map(|v| v.to_string())
[0m[49m[38;5;10m+    788[0m:[38;5;10m[49m             .collect::<Vec<_>>()
[0m[49m[38;5;10m+    789[0m:[38;5;10m[49m             .join(" ");
[0m[49m[38;5;10m+    790[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    791[0m:[38;5;10m[49m         // Top of the pipeline: both `.so`s must print the same bytes.
[0m[49m[38;5;10m+    792[0m:[38;5;10m[49m         let out = assert_driver_matches(&s, &format!("C33 it={it} n={n}"));
[0m[49m[38;5;10m+    793[0m:[38;5;10m[49m 
