[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m             unsafe { (api.fma_array)(o, p(1), p(2), p(3), n as c_int) };
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m             SURVIVED
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m         };
