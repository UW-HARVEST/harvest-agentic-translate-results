[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m             } else {
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m                 out.as_mut_ptr()
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m             };
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m             let p = |k: usize| {
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m                 if which == k {
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m                     std::ptr::null()
[0m[49m[38;5;10m+    236[0m:[38;5;10m[49m                 } else {
[0m[49m[38;5;10m+    237[0m:[38;5;10m[49m                     buf.as_ptr()
[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m                 }
