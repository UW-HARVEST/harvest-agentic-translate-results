[0m[49m[38;5;10m+    721[0m:[38;5;10m[49m                 s.push_str(rng.pick(SEPS));
[0m[49m[38;5;10m+    722[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    723[0m:[38;5;10m[49m             match rng.range(0, 9) {
[0m[49m[38;5;10m+    724[0m:[38;5;10m[49m                 0..=4 => s.push_str(&rng.i32_full().to_string()),
[0m[49m[38;5;10m+    725[0m:[38;5;10m[49m                 5 => s.push_str(&format!("+{}", rng.next_u32() % (i32::MAX as u32))),
[0m[49m[38;5;10m+    726[0m:[38;5;10m[49m                 6 => s.push_str(&format!(
[0m[49m[38;5;10m+    727[0m:[38;5;10m[49m                     "{}{}",
[0m[49m[38;5;10m+    728[0m:[38;5;10m[49m                     "0".repeat(rng.range(1, 5)),
[0m[49m[38;5;10m+    729[0m:[38;5;10m[49m                     rng.next_u32() % 1000
[0m[49m[38;5;10m+    730[0m:[38;5;10m[49m                 )),
[0m[49m[38;5;10m+    731[0m:[38;5;10m[49m                 7 => s.push_str(rng.pick(OVER_RANGE)),
[0m[49m[38;5;10m+    732[0m:[38;5;10m[49m                 8 => s.push_str(rng.pick(GARBAGE)),
[0m[49m[38;5;10m+    733[0m:[38;5;10m[49m                 _ => s.push_str(rng.pick(&["0x1f", "1e9", "2.5", "1_0", "0b1"])),
[0m[49m[38;5;10m+    734[0m:[38;5;10m[49m             }
