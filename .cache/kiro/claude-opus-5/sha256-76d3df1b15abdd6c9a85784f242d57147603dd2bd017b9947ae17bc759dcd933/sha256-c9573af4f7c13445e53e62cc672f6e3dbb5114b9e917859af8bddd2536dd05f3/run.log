[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m         let r_out = isolated(|| run(r));
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m             c_out, r_out,
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m             "E14 which={which}: C and Rust must fault identically \
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m              (C={c_out:?} Rust={r_out:?})"
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m         assert!(
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m             matches!(c_out, Isolated::Signal(_)),
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m             "E14 which={which}: expected the C to fault, got {c_out:?}"
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m 
