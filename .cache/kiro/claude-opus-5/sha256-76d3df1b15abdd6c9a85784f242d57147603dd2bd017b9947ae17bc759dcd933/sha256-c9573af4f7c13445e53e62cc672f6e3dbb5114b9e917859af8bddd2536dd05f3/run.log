[0m[49m[38;5;10m+    708[0m:[38;5;10m[49m /// C32 — broad fuzz over the whole `driver` token grammar: valid integers,
[0m[49m[38;5;10m+    709[0m:[38;5;10m[49m /// signs, whitespace runs, garbage words and over-range numerals mixed freely,
[0m[49m[38;5;10m+    710[0m:[38;5;10m[49m /// up to 300 tokens.
[0m[49m[38;5;10m+    711[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    712[0m:[38;5;10m[49m fn c32_driver_fuzz_random() {
[0m[49m[38;5;10m+    713[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 32);
[0m[49m[38;5;10m+    714[0m:[38;5;10m[49m     for it in 0..400 {
[0m[49m[38;5;10m+    715[0m:[38;5;10m[49m         let n = rng.range(1, 300);
[0m[49m[38;5;10m+    716[0m:[38;5;10m[49m         let mut s = String::new();
[0m[49m[38;5;10m+    717[0m:[38;5;10m[49m         for i in 0..n {
[0m[49m[38;5;10m+    718[0m:[38;5;10m[49m             if i > 0 && rng.range(0, 9) != 0 {
[0m[49m[38;5;10m+    719[0m:[38;5;10m[49m                 // Usually separate tokens; occasionally glue them together to
