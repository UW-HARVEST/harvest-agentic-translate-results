[0m[49m[38;5;10m+    159[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    160[0m:[38;5;10m[49m fn e12_call_fma_negative_len_is_ub() {
[0m[49m[38;5;10m+    161[0m:[38;5;10m[49m     let (c, r) = *apis();
