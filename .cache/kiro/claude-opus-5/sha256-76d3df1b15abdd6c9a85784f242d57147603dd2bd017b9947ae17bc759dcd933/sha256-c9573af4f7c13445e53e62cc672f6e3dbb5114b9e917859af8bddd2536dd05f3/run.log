#define _GNU_SOURCE
#include <stdio.h>
#include <dlfcn.h>
typedef int (*sf)(const char*, const char*, ...);
static const char *cases[] = {
 "", " ", "\t\n ", "5", "  -7", "+9", "007", "2147483647", "2147483648",
 "-2147483648", "-2147483649", "99999999999999999999", "-", "+", "0x10",
 "5abc", "abc5", "1 2 3", "1,2", "  12  34", "0", "-0", "  \n\t+42xyz",
 "1e5", ".5", "--5", "18446744073709551617", "  \v\f 8", "3 ", NULL };
int main(void){
  sf legacy = (sf)dlsym(RTLD_DEFAULT, "sscanf");
  sf iso    = (sf)dlsym(RTLD_DEFAULT, "__isoc99_sscanf");
  printf("legacy=%p iso=%p same_ptr=%d\n",(void*)legacy,(void*)iso,legacy==iso);
  int ndiff=0;
  for (int i=0; cases[i]; i++){
    int a=0xDEAD, b=0xDEAD; size_t na=0xAA55, nb=0xAA55;
    int ra = iso(cases[i], "%d%zn", &a, &na);
    int rb = legacy(cases[i], "%d%zn", &b, &nb);
    if (!(ra==rb && a==b && (ra!=1 || na==nb))) { ndiff++;
      printf("DIFF %-22s iso(rc=%d v=%d n=%zu) leg(rc=%d v=%d n=%zu)\n",cases[i],ra,a,na,rb,b,nb); }
  }
  printf("total diffs = %d\n", ndiff);
  return 0;
}
EOF
