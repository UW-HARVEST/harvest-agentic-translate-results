[0m[49m[38;5;10m+    218[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    219[0m:[38;5;10m[49m fn e14_fma_array_faulting_nulls() {
[0m[49m[38;5;10m+    220[0m:[38;5;10m[49m     let (c, r) = *apis();
