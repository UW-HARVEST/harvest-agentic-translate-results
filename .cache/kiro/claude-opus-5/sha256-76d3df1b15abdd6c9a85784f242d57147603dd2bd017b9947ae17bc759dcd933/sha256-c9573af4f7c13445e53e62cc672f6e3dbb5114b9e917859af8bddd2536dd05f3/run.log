[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m     eprintln!("E13: C call_fma(data, INT_MAX) -> {out:?}");
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m // E14..E16 — the faulting null-pointer paths, compared as signals
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m /// E14 — `fma_array` with `len > 0` and a null pointer in each argument
