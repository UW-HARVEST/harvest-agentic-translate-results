[0m[49m[38;5;10m+     28[0m:[38;5;10m[49m /// `int smallestValue (struct ListNode *date);`
[0m[49m[38;5;10m+     29[0m:[38;5;10m[49m type SmallestValueFn = unsafe extern "C" fn(*mut ListNode) -> c_int;
[0m[49m[38;5;10m+     30[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     31[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
