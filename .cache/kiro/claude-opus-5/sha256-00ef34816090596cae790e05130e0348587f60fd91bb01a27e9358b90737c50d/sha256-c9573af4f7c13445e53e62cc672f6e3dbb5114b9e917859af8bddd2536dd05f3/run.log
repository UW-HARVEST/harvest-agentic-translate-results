[0m[49m[38;5;10m+     52[0m:[38;5;10m[49m             .unwrap_or_else(|e| panic!("`smallestValue` not exported by {}: {e}", path.display()));
[0m[49m[38;5;10m+     53[0m:[38;5;10m[49m         let smallest_value = *sym;
[0m[49m[38;5;10m+     54[0m:[38;5;10m[49m         Lib {
[0m[49m[38;5;10m+     55[0m:[38;5;10m[49m             _lib: lib,
