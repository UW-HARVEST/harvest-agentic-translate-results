echo "=== flush boundary measurement ==="
measure() {
  bin="$1"; label="$2"; target="/tmp/mo_$label"
  rm -f /tmp/mf "$target"; mkfifo /tmp/mf
  "$bin" < /tmp/mf > "$target" 2>/dev/null &
  pid=$!; exec 9>/tmp/mf; prev=0; sizes=""
  for i in $(seq 1 60); do
    printf '%s\n' "$(head -c 99 /dev/zero | tr '\0' 'a')" >&9
    sz=$(stat -c %s "$target" 2>/dev/null || echo 0)
    if [ "$sz" != "$prev" ]; then sizes="$sizes ${i}00->$sz"; prev=$sz; fi
  done
  exec 9>&-; kill -9 $pid 2>/dev/null; wait $pid 2>/dev/null
  echo "$label:$sizes"
}
