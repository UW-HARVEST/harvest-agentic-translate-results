probe() {
  desc="$1"; shift
  co=$( { "$C" "$@" 2>/tmp/ce; } | od -An -c | head -3 ); cs=$?
  # capture status properly
  "$C" "$@" >/tmp/co 2>/tmp/ce </dev/null; cst=$?
  "$R" "$@" >/tmp/ro 2>/tmp/re </dev/null; rst=$?
  echo "$desc: Cstat=$cst Rstat=$rst  out=$(cmp -s /tmp/co /tmp/ro && echo same || echo DIFF)  err=$(cmp -s /tmp/ce /tmp/re && echo same || echo DIFF)"
}

