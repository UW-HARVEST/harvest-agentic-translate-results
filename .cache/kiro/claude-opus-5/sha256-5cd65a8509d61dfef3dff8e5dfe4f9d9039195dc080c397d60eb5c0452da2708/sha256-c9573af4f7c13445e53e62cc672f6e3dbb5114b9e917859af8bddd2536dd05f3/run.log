[0m[49m[38;5;10m+    174[0m:[38;5;10m[49m // -------------------------------------------------------- data generators ----
[0m[49m[38;5;10m+    175[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    176[0m:[38;5;10m[49m #[derive(Copy, Clone, Debug, PartialEq, Eq)]
[0m[49m[38;5;10m+    177[0m:[38;5;10m[49m pub enum Data {
[0m[49m[38;5;10m+    178[0m:[38;5;10m[49m     /// Finite `double`s in `[-1, 1]`.
[0m[49m[38;5;10m+    179[0m:[38;5;10m[49m     Finite,
[0m[49m[38;5;10m+    180[0m:[38;5;10m[49m     /// Finite non-negative `double`s in `[0, 1]` (a plausible spectrum).
[0m[49m[38;5;10m+    181[0m:[38;5;10m[49m     Positive,
[0m[49m[38;5;10m+    182[0m:[38;5;10m[49m     AllZeros,
[0m[49m[38;5;10m+    183[0m:[38;5;10m[49m     /// Every element the same random value.
[0m[49m[38;5;10m+    184[0m:[38;5;10m[49m     Constant,
[0m[49m[38;5;10m+    185[0m:[38;5;10m[49m     Ramp,
[0m[49m[38;5;10m+    186[0m:[38;5;10m[49m     /// One random index nonzero.
[0m[49m[38;5;10m+    187[0m:[38;5;10m[49m     Spike,
[0m[49m[38;5;10m+    188[0m:[38;5;10m[49m     /// `|x| ~ 1e300` -- `total` and `Σx²` overflow.
[0m[49m[38;5;10m+    189[0m:[38;5;10m[49m     Huge,
[0m[49m[38;5;10m+    190[0m:[38;5;10m[49m     /// Subnormal / near-zero `double`s.
[0m[49m[38;5;10m+    191[0m:[38;5;10m[49m     Tiny,
[0m[49m[38;5;10m+    192[0m:[38;5;10m[49m     /// Mixture of `+0.0` and `-0.0`.
[0m[49m[38;5;10m+    193[0m:[38;5;10m[49m     SignedZeros,
[0m[49m[38;5;10m+    194[0m:[38;5;10m[49m     /// Finite with a few `±inf` lanes.
[0m[49m[38;5;10m+    195[0m:[38;5;10m[49m     WithInf,
[0m[49m[38;5;10m+    196[0m:[38;5;10m[49m     /// Finite with a few quiet NaNs with random payloads.
[0m[49m[38;5;10m+    197[0m:[38;5;10m[49m     WithQNaN,
[0m[49m[38;5;10m+    198[0m:[38;5;10m[49m     /// Finite with a few signalling NaNs with random payloads.
[0m[49m[38;5;10m+    199[0m:[38;5;10m[49m     WithSNaN,
[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m     /// Completely random bit patterns (every IEEE class).
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m     RandomBits,
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m     /// `double`s whose **low 32 bits** are a chosen `float` class.
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m     LowWordInf,
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m     LowWordNaN,
