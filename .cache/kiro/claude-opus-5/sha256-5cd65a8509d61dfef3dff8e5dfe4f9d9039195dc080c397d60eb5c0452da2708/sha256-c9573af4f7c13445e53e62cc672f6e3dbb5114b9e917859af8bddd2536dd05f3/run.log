[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m         Data::Ramp => {
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m             let step = rng.range(-2.0, 2.0);
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m             let base = rng.range(-2.0, 2.0);
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m             for (i, x) in v.iter_mut().enumerate() {
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m                 *x = base + step * i as f64;
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m         Data::Spike => {
[0m[49m[38;5;10m+    236[0m:[38;5;10m[49m             if n > 0 {
[0m[49m[38;5;10m+    237[0m:[38;5;10m[49m                 let i = rng.below(n);
[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m                 v[i] = rng.range(-100.0, 100.0);
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m         Data::Huge => {
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m             for x in v.iter_mut() {
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m                 *x = rng.range(1e295, 1e308) * if rng.bool_() { 1.0 } else { -1.0 };
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m         Data::Tiny => {
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m             for x in v.iter_mut() {
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m                 // Random subnormal / very small doubles.
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m                 let bits = (rng.next_u64() & 0x000F_FFFF_FFFF_FFFF)
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m                     | if rng.bool_() { 1u64 << 63 } else { 0 };
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m                 *x = f64::from_bits(bits);
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m         Data::SignedZeros => {
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m             for x in v.iter_mut() {
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m                 *x = if rng.bool_() { 0.0 } else { -0.0 };
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    259[0m:[38;5;10m[49m         Data::WithInf => {
[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m             for x in v.iter_mut() {
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m                 *x = rng.range(-1.0, 1.0);
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    263[0m:[38;5;10m[49m             for _ in 0..(n / 4 + 1).min(n.max(1)) {
[0m[49m[38;5;10m+    264[0m:[38;5;10m[49m                 if n > 0 {
[0m[49m[38;5;10m+    265[0m:[38;5;10m[49m                     let i = rng.below(n);
[0m[49m[38;5;10m+    266[0m:[38;5;10m[49m                     v[i] = if rng.bool_() {
[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m                         f64::INFINITY
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m                     } else {
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m                         f64::NEG_INFINITY
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m                     };
[0m[49m[38;5;10m+    271[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    272[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    273[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    274[0m:[38;5;10m[49m         Data::WithQNaN => {
[0m[49m[38;5;10m+    275[0m:[38;5;10m[49m             for x in v.iter_mut() {
[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m                 *x = rng.range(-1.0, 1.0);
[0m[49m[38;5;10m+    277[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    278[0m:[38;5;10m[49m             for _ in 0..(n / 4 + 1) {
[0m[49m[38;5;10m+    279[0m:[38;5;10m[49m                 if n > 0 {
[0m[49m[38;5;10m+    280[0m:[38;5;10m[49m                     let i = rng.below(n);
[0m[49m[38;5;10m+    281[0m:[38;5;10m[49m                     let payload = rng.next_u64() & 0x0007_FFFF_FFFF_FFFF;
[0m[49m[38;5;10m+    282[0m:[38;5;10m[49m                     let sign = if rng.bool_() { 1u64 << 63 } else { 0 };
[0m[49m[38;5;10m+    283[0m:[38;5;10m[49m                     v[i] = f64::from_bits(sign | 0x7FF8_0000_0000_0000 | payload);
[0m[49m[38;5;10m+    284[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    285[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    286[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    287[0m:[38;5;10m[49m         Data::WithSNaN => {
[0m[49m[38;5;10m+    288[0m:[38;5;10m[49m             for x in v.iter_mut() {
[0m[49m[38;5;10m+    289[0m:[38;5;10m[49m                 *x = rng.range(-1.0, 1.0);
[0m[49m[38;5;10m+    290[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    291[0m:[38;5;10m[49m             for _ in 0..(n / 4 + 1) {
[0m[49m[38;5;10m+    292[0m:[38;5;10m[49m                 if n > 0 {
[0m[49m[38;5;10m+    293[0m:[38;5;10m[49m                     let i = rng.below(n);
[0m[49m[38;5;10m+    294[0m:[38;5;10m[49m                     let payload = (rng.next_u64() & 0x0007_FFFF_FFFF_FFFF).max(1);
[0m[49m[38;5;10m+    295[0m:[38;5;10m[49m                     let sign = if rng.bool_() { 1u64 << 63 } else { 0 };
[0m[49m[38;5;10m+    296[0m:[38;5;10m[49m                     // exponent all ones, quiet bit CLEAR, payload nonzero
[0m[49m[38;5;10m+    297[0m:[38;5;10m[49m                     v[i] = f64::from_bits(sign | 0x7FF0_0000_0000_0000 | payload);
[0m[49m[38;5;10m+    298[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    299[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    300[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    301[0m:[38;5;10m[49m         Data::RandomBits => {
[0m[49m[38;5;10m+    302[0m:[38;5;10m[49m             for x in v.iter_mut() {
[0m[49m[38;5;10m+    303[0m:[38;5;10m[49m                 *x = f64::from_bits(rng.next_u64());
[0m[49m[38;5;10m+    304[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    305[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    306[0m:[38;5;10m[49m         Data::LowWordInf => {
[0m[49m[38;5;10m+    307[0m:[38;5;10m[49m             for x in v.iter_mut() {
[0m[49m[38;5;10m+    308[0m:[38;5;10m[49m                 let hi = (rng.next_u32() as u64) << 32;
[0m[49m[38;5;10m+    309[0m:[38;5;10m[49m                 let lo = if rng.bool_() { 0x7F80_0000u64 } else { 0xFF80_0000u64 };
[0m[49m[38;5;10m+    310[0m:[38;5;10m[49m                 *x = f64::from_bits(hi | lo);
