[0m[49m[38;5;10m+    592[0m:[38;5;10m[49m /// Row 26 -- `smoothen`'s tail divides by 16 even with fewer samples. Verified
[0m[49m[38;5;10m+    593[0m:[38;5;10m[49m /// by a direct observation on the C: an impulse response whose tail is
[0m[49m[38;5;10m+    594[0m:[38;5;10m[49m /// attenuated rather than renormalised.
[0m[49m[38;5;10m+    595[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    596[0m:[38;5;10m[49m fn err26_smoothen_tail_divisor_is_always_16() {
[0m[49m[38;5;10m+    597[0m:[38;5;10m[49m     // A DC input of 16.0 preprocessed by the C: the first smoothen row sums
[0m[49m[38;5;10m+    598[0m:[38;5;10m[49m     // min(16, n) samples and divides by 16, so for n < 16 the output is n, not
[0m[49m[38;5;10m+    599[0m:[38;5;10m[49m     // 16. Observe it through `match`'s gate, which is the only place the
[0m[49m[38;5;10m+    600[0m:[38;5;10m[49m     // preprocessed magnitude is visible... instead assert the property that
[0m[49m[38;5;10m+    601[0m:[38;5;10m[49m     // depends on it: for a constant input, `differentiate` yields exactly zero
[0m[49m[38;5;10m+    602[0m:[38;5;10m[49m     // only because every smoothen row used the same divisor. A constant input
[0m[49m[38;5;10m+    603[0m:[38;5;10m[49m     // therefore always produces a zero-magnitude vector and a NaN contrast.
[0m[49m[38;5;10m+    604[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 126);
[0m[49m[38;5;10m+    605[0m:[38;5;10m[49m     for &bins in &[1usize, 2, 3, 15, 16, 17, 33, 64] {
[0m[49m[38;5;10m+    606[0m:[38;5;10m[49m         for _ in 0..8 {
[0m[49m[38;5;10m+    607[0m:[38;5;10m[49m             let c0 = rng.range(-10.0, 10.0);
[0m[49m[38;5;10m+    608[0m:[38;5;10m[49m             let buf = vec![c0; bins];
[0m[49m[38;5;10m+    609[0m:[38;5;10m[49m             for &thr in &[f64::NEG_INFINITY, -1.0, 0.0, 0.5, 1.0, f64::INFINITY] {
[0m[49m[38;5;10m+    610[0m:[38;5;10m[49m                 diff_match(
[0m[49m[38;5;10m+    611[0m:[38;5;10m[49m                     &format!("row26 bins={bins} c={c0} thr={thr:?}"),
[0m[49m[38;5;10m+    612[0m:[38;5;10m[49m                     &buf,
[0m[49m[38;5;10m+    613[0m:[38;5;10m[49m                     &buf.clone(),
[0m[49m[38;5;10m+    614[0m:[38;5;10m[49m                     bins as i32,
[0m[49m[38;5;10m+    615[0m:[38;5;10m[49m                     thr,
[0m[49m[38;5;10m+    616[0m:[38;5;10m[49m                 );
[0m[49m[38;5;10m+    617[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    618[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    619[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    620[0m:[38;5;10m[49m     // And exercise the tail asymmetry explicitly: a ramp, where interior rows
[0m[49m[38;5;10m+    621[0m:[38;5;10m[49m     // use 16 samples and the last 15 rows use fewer, all divided by 16.
[0m[49m[38;5;10m+    622[0m:[38;5;10m[49m     for &bins in &[16usize, 17, 20, 31, 32, 33] {
[0m[49m[38;5;10m+    623[0m:[38;5;10m[49m         let ramp: Vec<f64> = (0..bins).map(|i| i as f64).collect();
[0m[49m[38;5;10m+    624[0m:[38;5;10m[49m         let rev: Vec<f64> = (0..bins).map(|i| (bins - i) as f64).collect();
[0m[49m[38;5;10m+    625[0m:[38;5;10m[49m         for &thr in &[f64::NEG_INFINITY, -1.0, 0.0, 0.5, 1.0, f64::INFINITY] {
[0m[49m[38;5;10m+    626[0m:[38;5;10m[49m             diff_match(
[0m[49m[38;5;10m+    627[0m:[38;5;10m[49m                 &format!("row26 ramp bins={bins} thr={thr:?}"),
[0m[49m[38;5;10m+    628[0m:[38;5;10m[49m                 &ramp,
[0m[49m[38;5;10m+    629[0m:[38;5;10m[49m                 &rev,
[0m[49m[38;5;10m+    630[0m:[38;5;10m[49m                 bins as i32,
[0m[49m[38;5;10m+    631[0m:[38;5;10m[49m                 thr,
[0m[49m[38;5;10m+    632[0m:[38;5;10m[49m             );
[0m[49m[38;5;10m+    633[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    634[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    635[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    636[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    637[0m:[38;5;10m[49m /// Row 27 -- odd `bins`: the high half of the middle `double` slot is never
[0m[49m[38;5;10m+    638[0m:[38;5;10m[49m /// read by `spectral_contrast`. Verified by perturbing exactly that half and
[0m[49m[38;5;10m+    639[0m:[38;5;10m[49m /// checking both libraries ignore it identically.
[0m[49m[38;5;10m+    640[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    641[0m:[38;5;10m[49m fn err27_odd_bins_high_half_unread() {
[0m[49m[38;5;10m+    642[0m:[38;5;10m[49m     let (c, rs) = libs();
[0m[49m[38;5;10m+    643[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 127);
[0m[49m[38;5;10m+    644[0m:[38;5;10m[49m     for &n in &[1usize, 3, 5, 17, 33] {
[0m[49m[38;5;10m+    645[0m:[38;5;10m[49m         for _ in 0..16 {
[0m[49m[38;5;10m+    646[0m:[38;5;10m[49m             let base = gen_f64(&mut rng, n, Data::Finite);
[0m[49m[38;5;10m+    647[0m:[38;5;10m[49m             let k = (n - 1) / 2; // the slot whose high half is unread
[0m[49m[38;5;10m+    648[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    649[0m:[38;5;10m[49m             let mut perturbed = base.clone();
[0m[49m[38;5;10m+    650[0m:[38;5;10m[49m             let hi_mask = 0xFFFF_FFFF_0000_0000u64;
[0m[49m[38;5;10m+    651[0m:[38;5;10m[49m             perturbed[k] = f64::from_bits(
[0m[49m[38;5;10m+    652[0m:[38;5;10m[49m                 (base[k].to_bits() & !hi_mask) | (rng.next_u64() & hi_mask),
[0m[49m[38;5;10m+    653[0m:[38;5;10m[49m             );
[0m[49m[38;5;10m+    654[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    655[0m:[38;5;10m[49m             let run = |lib: &Lib, v: &[f64]| -> (f64, Vec<u64>) {
[0m[49m[38;5;10m+    656[0m:[38;5;10m[49m                 let mut a = v.to_vec();
[0m[49m[38;5;10m+    657[0m:[38;5;10m[49m                 let mut b = v.to_vec();
[0m[49m[38;5;10m+    658[0m:[38;5;10m[49m                 let r = unsafe {
[0m[49m[38;5;10m+    659[0m:[38;5;10m[49m                     (lib.spectral_contrast)(
[0m[49m[38;5;10m+    660[0m:[38;5;10m[49m                         a.as_mut_ptr() as *mut f32,
[0m[49m[38;5;10m+    661[0m:[38;5;10m[49m                         b.as_mut_ptr() as *mut f32,
[0m[49m[38;5;10m+    662[0m:[38;5;10m[49m                         n as i32,
[0m[49m[38;5;10m+    663[0m:[38;5;10m[49m                     )
[0m[49m[38;5;10m+    664[0m:[38;5;10m[49m                 };
[0m[49m[38;5;10m+    665[0m:[38;5;10m[49m                 // only the first n*4 bytes are meaningful
[0m[49m[38;5;10m+    666[0m:[38;5;10m[49m                 (r, bits64(&a))
[0m[49m[38;5;10m+    667[0m:[38;5;10m[49m             };
