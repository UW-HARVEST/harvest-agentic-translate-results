[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m pub fn gen_f64(rng: &mut Rng, n: usize, d: Data) -> Vec<f64> {
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m     let mut v = vec![0.0f64; n];
[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m     match d {
[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m         Data::Finite => {
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m             for x in v.iter_mut() {
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m                 *x = rng.range(-1.0, 1.0);
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    216[0m:[38;5;10m[49m         Data::Positive => {
