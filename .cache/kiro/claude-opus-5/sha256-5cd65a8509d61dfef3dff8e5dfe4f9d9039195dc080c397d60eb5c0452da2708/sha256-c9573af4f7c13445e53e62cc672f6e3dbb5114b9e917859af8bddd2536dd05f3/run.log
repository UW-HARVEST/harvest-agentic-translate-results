[0m[49m[38;5;10m+    499[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    500[0m:[38;5;10m[49m         diff_sc(&format!("row22 n={n}"), &a, &b, n as i32);
[0m[49m[38;5;10m+    501[0m:[38;5;10m[49m         // And pre-infinite lanes of opposite sign.
[0m[49m[38;5;10m+    502[0m:[38;5;10m[49m         let mut a = vec![1.0f32; n];
[0m[49m[38;5;10m+    503[0m:[38;5;10m[49m         let mut b = vec![1.0f32; n];
[0m[49m[38;5;10m+    504[0m:[38;5;10m[49m         a[0] = f32::INFINITY;
[0m[49m[38;5;10m+    505[0m:[38;5;10m[49m         b[0] = f32::INFINITY;
[0m[49m[38;5;10m+    506[0m:[38;5;10m[49m         a[1] = f32::INFINITY;
[0m[49m[38;5;10m+    507[0m:[38;5;10m[49m         b[1] = f32::NEG_INFINITY;
[0m[49m[38;5;10m+    508[0m:[38;5;10m[49m         diff_sc(&format!("row22 inf n={n}"), &a, &b, n as i32);
[0m[49m[38;5;10m+    509[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    510[0m:[38;5;10m[49m }
