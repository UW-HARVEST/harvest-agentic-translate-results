[0m[49m[38;5;10m+    218[0m:[38;5;10m[49m                 *x = rng.unit();
[0m[49m[38;5;10m+    219[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    220[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    221[0m:[38;5;10m[49m         Data::AllZeros => {}
[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m         Data::Constant => {
[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m             let c = rng.range(-4.0, 4.0);
[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m             for x in v.iter_mut() {
[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m                 *x = c;
