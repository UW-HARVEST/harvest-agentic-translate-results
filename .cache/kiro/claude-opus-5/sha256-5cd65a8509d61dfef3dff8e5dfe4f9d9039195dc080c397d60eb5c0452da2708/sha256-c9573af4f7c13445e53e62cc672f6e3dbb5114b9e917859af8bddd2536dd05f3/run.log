//! MUTANT: treats spectral_contrast elements as f64 (i.e. "fixes" the C bug).
use std::ffi::c_int;
fn dot_product(a: &[f64], b: &[f64]) -> f64 {
    let mut sum = 0.0f64;
    for i in 0..a.len() { sum += a[i] * b[i]; }
    sum
}
fn normalize(v: &mut [f64]) {
    let m = dot_product(v, v).sqrt();
    for i in 0..v.len() { v[i] /= m; }
}
pub(crate) unsafe fn spectral_contrast_raw(a: *mut f32, b: *mut f32, length: usize) -> f64 {
    let a = unsafe { std::slice::from_raw_parts_mut(a as *mut f64, length) };
    let b = unsafe { std::slice::from_raw_parts_mut(b as *mut f64, length) };
    normalize(a); normalize(b); dot_product(a, b)
}
#[unsafe(no_mangle)]
pub unsafe extern "C" fn spectral_contrast(a: *mut f64, b: *mut f64, length: c_int) -> f64 {
    if length <= 0 { return 0.0; }
    unsafe { spectral_contrast_raw(a as *mut f32, b as *mut f32, length as usize) }
}
EOF
