[0m[49m[38;5;10m+    135[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    136[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    137[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    138[0m:[38;5;10m[49m pub const SEED: u64 = 0x5DEE_CE66_D;
[0m[49m[38;5;10m+    139[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    140[0m:[38;5;10m[49m // ------------------------------------------------------------- fixtures ------
[0m[49m[38;5;10m+    141[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    142[0m:[38;5;10m[49m /// The threshold set used by every "T ∈ full set" row of `CONFIGS.md`.
[0m[49m[38;5;10m+    143[0m:[38;5;10m[49m pub const THRESHOLDS: &[f64] = &[
[0m[49m[38;5;10m+    144[0m:[38;5;10m[49m     f64::NEG_INFINITY,
[0m[49m[38;5;10m+    145[0m:[38;5;10m[49m     -1e300,
[0m[49m[38;5;10m+    146[0m:[38;5;10m[49m     -1.0,
[0m[49m[38;5;10m+    147[0m:[38;5;10m[49m     -0.5,
[0m[49m[38;5;10m+    148[0m:[38;5;10m[49m     -0.0,
[0m[49m[38;5;10m+    149[0m:[38;5;10m[49m     0.0,
[0m[49m[38;5;10m+    150[0m:[38;5;10m[49m     f64::MIN_POSITIVE,
[0m[49m[38;5;10m+    151[0m:[38;5;10m[49m     1e-9,
[0m[49m[38;5;10m+    152[0m:[38;5;10m[49m     0.25,
[0m[49m[38;5;10m+    153[0m:[38;5;10m[49m     0.5,
[0m[49m[38;5;10m+    154[0m:[38;5;10m[49m     0.75,
[0m[49m[38;5;10m+    155[0m:[38;5;10m[49m     0.999_999_999_999_999_9,
[0m[49m[38;5;10m+    156[0m:[38;5;10m[49m     1.0,
[0m[49m[38;5;10m+    157[0m:[38;5;10m[49m     1.000_000_000_000_000_2,
[0m[49m[38;5;10m+    158[0m:[38;5;10m[49m     2.0,
[0m[49m[38;5;10m+    159[0m:[38;5;10m[49m     1e300,
[0m[49m[38;5;10m+    160[0m:[38;5;10m[49m     f64::INFINITY,
[0m[49m[38;5;10m+    161[0m:[38;5;10m[49m ];
[0m[49m[38;5;10m+    162[0m:[38;5;10m[49m 
