===== src/fp.rs =====
     1	//! x86-64 SSE-faithful floating-point primitives.
     2	//!
     3	//! For finite/infinite operands these are plain IEEE-754 operations and the
     4	//! helpers below are indistinguishable from `+` / `*`. They exist purely to pin
     5	//! down **NaN payload propagation**, which IEEE-754 leaves unspecified and
     6	//! which therefore differs between the GCC-compiled C and LLVM-compiled Rust.
     7	//!
     8	//! SSE rules reproduced here:
     9	//!   * For `ADDSD dst, src` / `MULSS dst, src`, if the *destination* operand is
    10	//!     a NaN the result is that NaN, quieted; only if the destination is not a
    11	//!     NaN does the *source* NaN propagate.
    12	//!   * "Quieting" sets the most significant significand bit and leaves the sign
    13	//!     and the remaining payload bits alone.
    14	//!
    15	//! Why this matters: `fadd` and `fmul` are commutative, so LLVM is free to pick
    16	//! either operand as the two-address destination. It consistently chooses the
    17	//! dying operand (the freshly loaded value), whereas GCC consistently keeps the
    18	//! accumulator in the destination register. With NaN inputs the two choices
    19	//! yield different payloads in the returned `double`. Reproducing the C exactly
    20	//! requires pinning the operand roles.
    21	//!
    22	//! Non-commutative operations (`SUBSD`, `DIVSD`, `DIVPD`, `SQRTSD`) need no
    23	//! helper: their destination operand is fixed by the source order, and LLVM
    24	//! cannot swap it.
    25	
    26	#[inline(always)]
    27	fn quiet_f64(x: f64) -> f64 {
    28	    f64::from_bits(x.to_bits() | 0x0008_0000_0000_0000)
    29	}
    30	
    31	#[inline(always)]
    32	fn quiet_f32(x: f32) -> f32 {
    33	    f32::from_bits(x.to_bits() | 0x0040_0000)
    34	}
    35	
    36	/// `ADDSD dst, src` -> `dst + src`, with the destination NaN winning.
    37	#[inline(always)]
    38	pub(crate) fn add_sd(dst: f64, src: f64) -> f64 {
    39	    if dst.is_nan() {
    40	        quiet_f64(dst)
    41	    } else if src.is_nan() {
    42	        quiet_f64(src)
    43	    } else {
    44	        dst + src
    45	    }
    46	}
    47	
    48	/// `MULSD dst, src` -> `dst * src`, with the destination NaN winning.
    49	#[inline(always)]
    50	pub(crate) fn mul_sd(dst: f64, src: f64) -> f64 {
    51	    if dst.is_nan() {
    52	        quiet_f64(dst)
    53	    } else if src.is_nan() {
    54	        quiet_f64(src)
    55	    } else {
    56	        dst * src
    57	    }
    58	}
    59	
    60	/// `MULSS dst, src` -> `dst * src` in single precision, destination NaN winning.
    61	#[inline(always)]
    62	pub(crate) fn mul_ss(dst: f32, src: f32) -> f32 {
    63	    if dst.is_nan() {
    64	        quiet_f32(dst)
    65	    } else if src.is_nan() {
    66	        quiet_f32(src)
    67	    } else {
    68	        dst * src
    69	    }
    70	}
===== src/spectral_contrast.rs =====
     1	//! Rust translation of `c_src/src/spectral_contrast.c`.
     2	//!
     3	//! ## The `float_t` trap (reproduced, not fixed)
     4	//!
     5	//! `c_src/src/spectral_contrast.c` includes **only** `<math.h>` -- it never
     6	//! includes `match.h`. Therefore the `float_t` it uses is *not* the
     7	//! `typedef double float_t;` from `match.h`, but the C99 `float_t` from
     8	//! `<math.h>`. On x86-64 glibc `__FLT_EVAL_METHOD__ == 0`, so
     9	//! `float_t` is `float` (4 bytes).
    10	//!
    11	//! Confirmed against the compiled C shared object: `spectral_contrast` uses
    12	//! `movss` / `mulss` and a 4-byte element stride, i.e. it walks its arguments
    13	//! as `float *`, while `match` (which sees `match.h`) walks its arrays as
    14	//! `double *`.
    15	//!
    16	//! This is a bug in the original C, and per the translation contract it is
    17	//! reproduced exactly: `spectral_contrast` operates on `f32` elements.
    18	
    19	use std::ffi::c_int;
    20	use std::slice;
    21	
    22	use crate::fp::{add_sd, mul_ss};
    23	
    24	/// `static double dot_product(float_t *a, float_t *b, int length)`
    25	///
    26	/// `a[i] * b[i]` is a `float * float` product. With `FLT_EVAL_METHOD == 0` the
    27	/// multiply happens in single precision (`mulss`), and only the *result* is
    28	/// widened to `double` before being accumulated (`cvtss2sd` + `addsd`).
    29	///
    30	/// GCC emits `movss a[i]` / `mulss b[i]` / `cvtss2sd` / `addsd sum`, i.e. the
    31	/// multiply's destination is `a[i]` and the add's destination is `sum`; see
    32	/// `crate::fp` for why those roles are pinned explicitly.
    33	fn dot_product(a: &[f32], b: &[f32]) -> f64 {
    34	    let mut sum: f64 = 0.0;
    35	    for i in 0..a.len() {
    36	        sum = add_sd(sum, mul_ss(a[i], b[i]) as f64);
    37	    }
    38	    sum
    39	}
    40	
    41	/// `static void normalize(float_t *v, int length)`
    42	///
    43	/// `v[i] /= magnitude` where `v[i]` is `float` and `magnitude` is `double`:
    44	/// widen, divide in double precision, then truncate back to `float`
    45	/// (`cvtss2sd` / `divsd` / `cvtsd2ss`).
    46	fn normalize(v: &mut [f32]) {
    47	    let magnitude = dot_product(v, v).sqrt();
    48	    for i in 0..v.len() {
    49	        v[i] = ((v[i] as f64) / magnitude) as f32;
    50	    }
    51	}
    52	
    53	/// Internal entry point operating on already-checked slices, so that `match`
    54	/// can reach the same code path the C `match` reaches through the PLT.
    55	pub(crate) fn spectral_contrast_slices(a: &mut [f32], b: &mut [f32]) -> f64 {
    56	    normalize(a);
    57	    normalize(b);
    58	    dot_product(a, b)
    59	}
    60	
    61	/// `double spectral_contrast(float_t *a, float_t *b, int length)`
    62	///
    63	/// Public ABI symbol. Note the element type is `f32` (see module docs).
    64	#[unsafe(no_mangle)]
    65	pub unsafe extern "C" fn spectral_contrast(a: *mut f32, b: *mut f32, length: c_int) -> f64 {
    66	    // Every loop in this translation unit is `for(i = 0; i < length; i++)`, so
    67	    // a non-positive `length` degenerates to zero iterations:
    68	    //   dot_product -> 0.0, sqrt(0.0) -> 0.0, normalize -> no-op, result 0.0.
    69	    if length <= 0 {
    70	        return 0.0;
    71	    }
    72	    let n = length as usize;
    73	    let a = unsafe { slice::from_raw_parts_mut(a, n) };
    74	    let b = unsafe { slice::from_raw_parts_mut(b, n) };
    75	    spectral_contrast_slices(a, b)
    76	}
