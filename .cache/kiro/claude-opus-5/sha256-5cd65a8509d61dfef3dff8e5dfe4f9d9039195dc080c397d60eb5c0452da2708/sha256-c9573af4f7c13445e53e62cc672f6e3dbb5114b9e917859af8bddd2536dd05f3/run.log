[0m[49m[38;5;10m+    312[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    313[0m:[38;5;10m[49m         Data::LowWordNaN => {
[0m[49m[38;5;10m+    314[0m:[38;5;10m[49m             for x in v.iter_mut() {
[0m[49m[38;5;10m+    315[0m:[38;5;10m[49m                 let hi = (rng.next_u32() as u64) << 32;
[0m[49m[38;5;10m+    316[0m:[38;5;10m[49m                 let lo = 0x7F80_0000u64 | (rng.next_u32() as u64 & 0x007F_FFFF).max(1);
