[0m[49m[38;5;10m+    489[0m:[38;5;10m[49m /// Row 22 -- `dot_product` overflowing to `±inf`, then `inf + (-inf)`.
[0m[49m[38;5;10m+    490[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    491[0m:[38;5;10m[49m fn err22_dot_product_overflow() {
[0m[49m[38;5;10m+    492[0m:[38;5;10m[49m     for &n in &[2usize, 3, 16, 17, 64] {
[0m[49m[38;5;10m+    493[0m:[38;5;10m[49m         // Alternating huge lanes with opposite-signed products.
[0m[49m[38;5;10m+    494[0m:[38;5;10m[49m         let mut a = vec![0.0f32; n];
