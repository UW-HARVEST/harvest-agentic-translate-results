[0m[49m[38;5;10m+    396[0m:[38;5;10m[49m // Row 14 — `magnitude == +inf`.
[0m[49m[38;5;10m+    397[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    398[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    399[0m:[38;5;10m[49m fn err14_magnitude_infinite() {
[0m[49m[38;5;10m+    400[0m:[38;5;10m[49m     let l = libs();
[0m[49m[38;5;10m+    401[0m:[38;5;10m[49m     for n in 1..=20usize {
[0m[49m[38;5;10m+    402[0m:[38;5;10m[49m         // `f32::MAX^2` overflows to `+inf`, so `magnitude = sqrt(+inf) = +inf`
[0m[49m[38;5;10m+    403[0m:[38;5;10m[49m         // and every `v[i] /= +inf` becomes `±0`.
[0m[49m[38;5;10m+    404[0m:[38;5;10m[49m         let a: Vec<f32> = (0..n).map(|k| if k % 2 == 0 { f32::MAX } else { -f32::MAX }).collect();
[0m[49m[38;5;10m+    405[0m:[38;5;10m[49m         let b: Vec<f32> = vec![f32::MAX; n];
[0m[49m[38;5;10m+    406[0m:[38;5;10m[49m         let c = call_sc(&l.c, &a, &b, n as c_int);
[0m[49m[38;5;10m+    407[0m:[38;5;10m[49m         let r = call_sc(&l.r, &a, &b, n as c_int);
[0m[49m[38;5;10m+    408[0m:[38;5;10m[49m         assert_sc_eq(&format!("err14 n={n}"), &c, &r);
[0m[49m[38;5;10m+    409[0m:[38;5;10m[49m         assert!(
[0m[49m[38;5;10m+    410[0m:[38;5;10m[49m             c.a_after.iter().all(|&x| x == 0x0000_0000 || x == 0x8000_0000),
[0m[49m[38;5;10m+    411[0m:[38;5;10m[49m             "err14 n={n}: lanes must collapse to ±0, got {:08X?}",
[0m[49m[38;5;10m+    412[0m:[38;5;10m[49m             c.a_after
[0m[49m[38;5;10m+    413[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    414[0m:[38;5;10m[49m         assert_eq!(f64::from_bits(c.ret), 0.0, "err14 n={n}: result must be zero");
[0m[49m[38;5;10m+    415[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    416[0m:[38;5;10m[49m     // Explicit `+inf` lanes: `sqrt(+inf) = +inf`, `inf / inf = -nan`.
[0m[49m[38;5;10m+    417[0m:[38;5;10m[49m     for n in 1..=20usize {
[0m[49m[38;5;10m+    418[0m:[38;5;10m[49m         let a = vec![f32::INFINITY; n];
[0m[49m[38;5;10m+    419[0m:[38;5;10m[49m         let b = vec![1.0f32; n];
[0m[49m[38;5;10m+    420[0m:[38;5;10m[49m         let c = call_sc(&l.c, &a, &b, n as c_int);
[0m[49m[38;5;10m+    421[0m:[38;5;10m[49m         let r = call_sc(&l.r, &a, &b, n as c_int);
[0m[49m[38;5;10m+    422[0m:[38;5;10m[49m         assert_sc_eq(&format!("err14b n={n}"), &c, &r);
[0m[49m[38;5;10m+    423[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    424[0m:[38;5;10m[49m }
