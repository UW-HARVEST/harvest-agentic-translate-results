[0m[49m[38;5;10m+    275[0m:[38;5;10m[49m                 let ret =
[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m                     diff_match(&format!("err10 {shape:?} thr={thr:e} #{i}"), &t, &r, 1, thr);
