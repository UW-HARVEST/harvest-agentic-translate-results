[0m[49m[38;5;10m+    444[0m:[38;5;10m[49m         let cn = call_sc_null(&l.c, len);
[0m[49m[38;5;10m+    445[0m:[38;5;10m[49m         let rn = call_sc_null(&l.r, len);
[0m[49m[38;5;10m+    446[0m:[38;5;10m[49m         assert_eq!(cn, 0, "err15 NULL len={len}: C must return +0.0");
[0m[49m[38;5;10m+    447[0m:[38;5;10m[49m         assert_eq!(cn, rn, "err15 NULL len={len}");
[0m[49m[38;5;10m+    448[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    449[0m:[38;5;10m[49m         // And out of process, to prove neither implementation faults.
[0m[49m[38;5;10m+    450[0m:[38;5;10m[49m         let (co, cv) = probe::isolated_sc_null(&l.c, len);
[0m[49m[38;5;10m+    451[0m:[38;5;10m[49m         let (ro, rv) = probe::isolated_sc_null(&l.r, len);
[0m[49m[38;5;10m+    452[0m:[38;5;10m[49m         assert_eq!(co, Outcome::Exited(0), "err15 isolated C len={len}: {co:?}");
[0m[49m[38;5;10m+    453[0m:[38;5;10m[49m         assert_eq!(ro, Outcome::Exited(0), "err15 isolated Rust len={len}: {ro:?}");
[0m[49m[38;5;10m+    454[0m:[38;5;10m[49m         assert_eq!(cv, Some(0));
