[0m[49m[38;5;10m+    349[0m:[38;5;10m[49m         let r = call_sc(&l.r, &a, &b, n as c_int);
[0m[49m[38;5;10m+    350[0m:[38;5;10m[49m         assert_sc_eq(&format!("err12b n={n}"), &c, &r);
