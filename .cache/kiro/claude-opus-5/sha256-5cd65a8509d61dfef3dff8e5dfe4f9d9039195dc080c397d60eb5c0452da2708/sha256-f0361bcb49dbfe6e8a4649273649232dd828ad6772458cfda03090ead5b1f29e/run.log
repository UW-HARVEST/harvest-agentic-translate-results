# row 34: n must be >= 1
s = s.replace('        let n = rng.range(41);\n        let sa = ALL_SHAPE64', '        let n = 1 + rng.range(40);\n        let sa = ALL_SHAPE64')
open(p,'w').write(s)
print("ok")
