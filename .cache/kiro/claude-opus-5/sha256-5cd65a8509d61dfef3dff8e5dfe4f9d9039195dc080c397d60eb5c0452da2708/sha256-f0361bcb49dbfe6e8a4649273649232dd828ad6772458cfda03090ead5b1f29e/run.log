[0m[49m[38;5;10m+    481[0m:[38;5;10m[49m         assert_sc_eq(&format!("err16b n={n}"), &c, &r);
[0m[49m[38;5;10m+    482[0m:[38;5;10m[49m         let v = f64::from_bits(c.ret);
[0m[49m[38;5;10m+    483[0m:[38;5;10m[49m         assert!((v - 1.0).abs() < 1e-5, "err16b n={n}: expected ~1.0, got {v}");
