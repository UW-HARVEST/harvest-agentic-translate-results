[0m[49m[38;5;10m+    438[0m:[38;5;10m[49m         assert_sc_eq(&format!("err15 len={len}"), &c, &r);
[0m[49m[38;5;10m+    439[0m:[38;5;10m[49m         assert_eq!(c.ret, 0, "err15 len={len}: expected +0.0");
[0m[49m[38;5;10m+    440[0m:[38;5;10m[49m         assert_eq!(c.a_after, a.iter().map(|x| x.to_bits()).collect::<Vec<_>>());
[0m[49m[38;5;10m+    441[0m:[38;5;10m[49m         assert_eq!(c.b_after, b.iter().map(|x| x.to_bits()).collect::<Vec<_>>());
[0m[49m[38;5;10m+    442[0m:[38;5;10m[49m 
