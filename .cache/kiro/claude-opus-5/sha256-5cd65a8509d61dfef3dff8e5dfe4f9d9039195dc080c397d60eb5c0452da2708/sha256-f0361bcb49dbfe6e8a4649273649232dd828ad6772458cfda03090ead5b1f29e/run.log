===== translation/src/match.rs =====
     1	//! Rust translation of `c_src/src/match.c`.
     2	//!
     3	//! This translation unit sees `match.h`, so here `float_t` is `double` (`f64`).
     4	//! `spectral_contrast`, however, was compiled against `<math.h>`'s `float_t`
     5	//! (`f32`) -- see `spectral_contrast.rs`. The C code therefore hands
     6	//! `double`-typed scratch buffers to a function that reads them as `float`.
     7	//! That reinterpretation is part of the observable behaviour and is reproduced
     8	//! verbatim below.
     9	
    10	use std::ffi::c_int;
    11	use std::slice;
    12	
    13	use crate::fp::{add_sd, mul_sd};
    14	use crate::spectral_contrast::spectral_contrast_slices;
    15	
    16	/// `#define N_SMOOTH 16` from `include/match.h`.
    17	const N_SMOOTH: usize = 16;
    18	
    19	/// `static double total(float_t *v, int length)`
    20	fn total(v: &[f64]) -> f64 {
    21	    let mut sum: f64 = 0.0;
    22	    for i in 0..v.len() {
    23	        sum = add_sd(sum, v[i]);
    24	    }
    25	    sum
    26	}
    27	
    28	/// `static void smoothen(float_t *v, int length)`
    29	///
    30	/// In-place box filter with a truncated (not wrapped, not renormalised) kernel
    31	/// at the tail: the divisor is always `N_SMOOTH`, even when fewer than
    32	/// `N_SMOOTH` samples were available. Reproduced as-is.
    33	fn smoothen(v: &mut [f64]) {
    34	    let length = v.len();
    35	    for i in 0..length {
    36	        let mut sum: f64 = 0.0;
    37	        let mut j = 0usize;
    38	        while j < N_SMOOTH && i + j < length {
    39	            sum = add_sd(sum, v[i + j]);
    40	            j += 1;
    41	        }
    42	        v[i] = sum / N_SMOOTH as f64;
    43	    }
    44	}
    45	
    46	/// `static void differentiate(float_t *v, int length)`
    47	fn differentiate(v: &mut [f64]) {
    48	    let length = v.len();
    49	    // C: `for(i = 0; i < length - 1; i++)` then `v[length - 1] = 0;`
    50	    // For length == 0 the C writes `v[-1]`, an out-of-bounds store into stack
    51	    // padding of the caller's VLA. It is unreachable from any observable
    52	    // output (the buffer is function-local and `spectral_contrast` returns 0.0
    53	    // for length 0), so it is elided rather than reproduced as UB.
    54	    if length == 0 {
    55	        return;
    56	    }
    57	    for i in 0..length - 1 {
    58	        v[i] = v[i + 1] - v[i];
    59	    }
    60	    v[length - 1] = 0.0;
    61	}
    62	
    63	/// `static void preprocess(float_t *v, float_t *source, int length)`
    64	fn preprocess(v: &mut [f64], source: &[f64]) {
    65	    v.copy_from_slice(source); // memcpy(v, source, length * sizeof(*v))
    66	    smoothen(v);
    67	    differentiate(v);
    68	    smoothen(v);
    69	}
    70	
    71	/// `int match(float_t *test, float_t *reference, int bins, double threshold)`
    72	#[unsafe(no_mangle)]
    73	pub unsafe extern "C" fn r#match(
    74	    test: *mut f64,
    75	    reference: *mut f64,
    76	    bins: c_int,
    77	    threshold: f64,
    78	) -> c_int {
    79	    // `float_t t[bins], r[bins];` -- a VLA. Every loop in this TU is bounded by
    80	    // `i < length`, so a non-positive `bins` behaves as an empty buffer.
    81	    let n = if bins > 0 { bins as usize } else { 0 };
    82	
    83	    let test_in: &[f64] = if n == 0 {
    84	        &[]
    85	    } else {
    86	        unsafe { slice::from_raw_parts(test, n) }
    87	    };
    88	    let reference_in: &[f64] = if n == 0 {
    89	        &[]
    90	    } else {
    91	        unsafe { slice::from_raw_parts(reference, n) }
    92	    };
    93	
    94	    // Error/validation order is preserved: the energy gate runs first and
    95	    // short-circuits before any preprocessing.
    96	    // GCC evaluates the right-hand side as `mulsd total_ref, threshold`, so
    97	    // `total(reference)` is the multiply's destination operand.
    98	    if total(test_in) < mul_sd(total(reference_in), threshold) {
    99	        return 0;
   100	    }
   101	
   102	    let mut t = vec![0.0f64; n];
   103	    let mut r = vec![0.0f64; n];
   104	    preprocess(&mut t, test_in);
   105	    preprocess(&mut r, reference_in);
   106	
   107	    // `spectral_contrast(t, r, bins)`: match.h declares the parameters as
   108	    // `float_t *` == `double *`, but the definition was compiled with
   109	    // `float_t` == `float`. The callee consequently reads `bins` *f32* lanes
   110	    // out of the low half of each f64 buffer, and writes its normalised f32
   111	    // results back over those same bytes. Reproduce the reinterpretation.
   112	    //
   113	    // `Vec<f64>` is 8-byte aligned, so the f32 view is well aligned, and
   114	    // `bins` f32 lanes fit inside `bins` f64 slots.
   115	    let contrast = {
   116	        let tf: &mut [f32] = if n == 0 {
   117	            &mut []
   118	        } else {
   119	            unsafe { slice::from_raw_parts_mut(t.as_mut_ptr() as *mut f32, n) }
   120	        };
   121	        let rf: &mut [f32] = if n == 0 {
   122	            &mut []
   123	        } else {
   124	            unsafe { slice::from_raw_parts_mut(r.as_mut_ptr() as *mut f32, n) }
   125	        };
   126	        spectral_contrast_slices(tf, rf)
   127	    };
