[0m[49m[38;5;10m+    378[0m:[38;5;10m[49m             let b = gen32(Shape32::Unit, n, &mut rng);
[0m[49m[38;5;10m+    379[0m:[38;5;10m[49m             let c = call_sc(&l.c, &a, &b, n as c_int);
[0m[49m[38;5;10m+    380[0m:[38;5;10m[49m             let r = call_sc(&l.r, &a, &b, n as c_int);
[0m[49m[38;5;10m+    381[0m:[38;5;10m[49m             assert_sc_eq(&format!("err13 nan=0x{nb:08X} n={n}"), &c, &r);
[0m[49m[38;5;10m+    382[0m:[38;5;10m[49m             assert!(
[0m[49m[38;5;10m+    383[0m:[38;5;10m[49m                 c.a_after.iter().all(|&x| f32::from_bits(x).is_nan()),
[0m[49m[38;5;10m+    384[0m:[38;5;10m[49m                 "err13 nan=0x{nb:08X} n={n}: NaN magnitude must poison every lane, got {:08X?}",
[0m[49m[38;5;10m+    385[0m:[38;5;10m[49m                 c.a_after
[0m[49m[38;5;10m+    386[0m:[38;5;10m[49m             );
[0m[49m[38;5;10m+    387[0m:[38;5;10m[49m             assert!(
[0m[49m[38;5;10m+    388[0m:[38;5;10m[49m                 f64::from_bits(c.ret).is_nan(),
