[0m[49m[38;5;10m+    488[0m:[38;5;10m[49m // Row 17 — the `float_t` mismatch itself (covered by every CONFIGS row);
[0m[49m[38;5;10m+    489[0m:[38;5;10m[49m // asserted here as an explicit, self-contained invariant.
[0m[49m[38;5;10m+    490[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    491[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    492[0m:[38;5;10m[49m fn err17_float_t_mismatch_is_reproduced() {
[0m[49m[38;5;10m+    493[0m:[38;5;10m[49m     let l = libs();
[0m[49m[38;5;10m+    494[0m:[38;5;10m[49m     // `spectral_contrast` counts elements in `float`s, not `double`s. Feed it a
[0m[49m[38;5;10m+    495[0m:[38;5;10m[49m     // buffer whose first `n` *floats* are a known unit vector and whose upper
[0m[49m[38;5;10m+    496[0m:[38;5;10m[49m     // halves are garbage: if either implementation read `double`s it would see
[0m[49m[38;5;10m+    497[0m:[38;5;10m[49m     // completely different values, so bit-exact agreement here pins the ABI.
[0m[49m[38;5;10m+    498[0m:[38;5;10m[49m     let n = 8usize;
[0m[49m[38;5;10m+    499[0m:[38;5;10m[49m     let mut a = vec![0.0f32; 2 * n];
[0m[49m[38;5;10m+    500[0m:[38;5;10m[49m     let mut b = vec![0.0f32; 2 * n];
[0m[49m[38;5;10m+    501[0m:[38;5;10m[49m     for k in 0..n {
[0m[49m[38;5;10m+    502[0m:[38;5;10m[49m         a[k] = (k as f32) + 1.0;
[0m[49m[38;5;10m+    503[0m:[38;5;10m[49m         b[k] = (n - k) as f32;
[0m[49m[38;5;10m+    504[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    505[0m:[38;5;10m[49m     for k in n..2 * n {
[0m[49m[38;5;10m+    506[0m:[38;5;10m[49m         a[k] = f32::from_bits(0xDEAD_BEEF);
[0m[49m[38;5;10m+    507[0m:[38;5;10m[49m         b[k] = f32::from_bits(0xCAFE_BABE);
[0m[49m[38;5;10m+    508[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    509[0m:[38;5;10m[49m     let c = call_sc(&l.c, &a, &b, n as c_int);
[0m[49m[38;5;10m+    510[0m:[38;5;10m[49m     let r = call_sc(&l.r, &a, &b, n as c_int);
[0m[49m[38;5;10m+    511[0m:[38;5;10m[49m     assert_sc_eq("err17", &c, &r);
[0m[49m[38;5;10m+    512[0m:[38;5;10m[49m     // The upper half must be untouched — proof the element stride is 4 bytes.
[0m[49m[38;5;10m+    513[0m:[38;5;10m[49m     for k in n..2 * n {
[0m[49m[38;5;10m+    514[0m:[38;5;10m[49m         assert_eq!(c.a_after[k], 0xDEAD_BEEF, "err17: a[{k}] must not be touched");
[0m[49m[38;5;10m+    515[0m:[38;5;10m[49m         assert_eq!(c.b_after[k], 0xCAFE_BABE, "err17: b[{k}] must not be touched");
[0m[49m[38;5;10m+    516[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    517[0m:[38;5;10m[49m     let v = f64::from_bits(c.ret);
[0m[49m[38;5;10m+    518[0m:[38;5;10m[49m     assert!(v.is_finite() && v > 0.0 && v < 1.0, "err17: expected a finite cosine, got {v}");
[0m[49m[38;5;10m+    519[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    520[0m:[38;5;10m[49m 
