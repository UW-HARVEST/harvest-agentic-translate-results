[0m[49m[38;5;10m+    355[0m:[38;5;10m[49m     let mut rng = Rng::new(0xE00C);
[0m[49m[38;5;10m+    356[0m:[38;5;10m[49m     for n in 2..=40usize {
[0m[49m[38;5;10m+    357[0m:[38;5;10m[49m         let t: Vec<f64> = (0..n).map(|_| (rng.range(1000) as f64) + 1.0).collect();
[0m[49m[38;5;10m+    358[0m:[38;5;10m[49m         let r: Vec<f64> = (0..n).map(|_| (rng.range(1000) as f64) + 1.0).collect();
