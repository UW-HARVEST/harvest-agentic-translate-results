        let lanes = |v: &[f64]| -> Vec<f32> {
            let mut out = Vec::with_capacity(v.len());
            for x in v {
                let bits = x.to_bits();
                out.push(f32::from_bits(bits as u32));
                out.push(f32::from_bits((bits >> 32) as u32));
