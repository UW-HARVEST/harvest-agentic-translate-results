[0m[49m[38;5;10m+    430[0m:[38;5;10m[49m fn err15_spectral_contrast_nonpositive_length() {
[0m[49m[38;5;10m+    431[0m:[38;5;10m[49m     let l = libs();
[0m[49m[38;5;10m+    432[0m:[38;5;10m[49m     let mut rng = Rng::new(0xE00F);
[0m[49m[38;5;10m+    433[0m:[38;5;10m[49m     for &len in &[0i32, -1, -2, -15, -16, -17, -1000, i32::MIN + 1, i32::MIN] {
[0m[49m[38;5;10m+    434[0m:[38;5;10m[49m         let a = gen32(Shape32::BitRandom, 16, &mut rng);
[0m[49m[38;5;10m+    435[0m:[38;5;10m[49m         let b = gen32(Shape32::BitRandom, 16, &mut rng);
