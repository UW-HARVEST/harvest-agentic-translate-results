[0m[49m[38;5;10m+    281[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    282[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    283[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    284[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    285[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    286[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    287[0m:[38;5;10m[49m // Row 11 — `inf - inf` inside `differentiate`.
[0m[49m[38;5;10m+    288[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    289[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    290[0m:[38;5;10m[49m fn err11_inf_minus_inf_nan() {
[0m[49m[38;5;10m+    291[0m:[38;5;10m[49m     let mut rng = Rng::new(0xE00B);
[0m[49m[38;5;10m+    292[0m:[38;5;10m[49m     // Adjacent equal infinities guarantee `subsd` produces the x86 indefinite
[0m[49m[38;5;10m+    293[0m:[38;5;10m[49m     // NaN, which then flows through the second `smoothen`.
[0m[49m[38;5;10m+    294[0m:[38;5;10m[49m     for n in 2..=20usize {
