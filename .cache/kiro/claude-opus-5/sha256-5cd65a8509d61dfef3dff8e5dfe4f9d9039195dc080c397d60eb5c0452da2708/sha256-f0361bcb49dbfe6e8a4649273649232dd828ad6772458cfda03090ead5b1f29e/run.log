[0m[49m[38;5;10m+    316[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    317[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    318[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    319[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    320[0m:[38;5;10m[49m // Row 12 — `magnitude == 0` ⇒ `0/0` and `x/0` inside `normalize`.
[0m[49m[38;5;10m+    321[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    322[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    323[0m:[38;5;10m[49m fn err12_zero_magnitude() {
