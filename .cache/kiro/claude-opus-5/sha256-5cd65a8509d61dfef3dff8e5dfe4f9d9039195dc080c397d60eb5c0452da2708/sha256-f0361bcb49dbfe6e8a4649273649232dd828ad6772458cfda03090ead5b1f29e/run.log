[0m[49m[38;5;10m+    296[0m:[38;5;10m[49m             let mut t = gen64(Shape64::Unit, n, &mut rng);
[0m[49m[38;5;10m+    297[0m:[38;5;10m[49m             let k = rng.range(n - 1);
[0m[49m[38;5;10m+    298[0m:[38;5;10m[49m             let s = if rng.bool() { f64::INFINITY } else { f64::NEG_INFINITY };
[0m[49m[38;5;10m+    299[0m:[38;5;10m[49m             t[k] = s;
[0m[49m[38;5;10m+    300[0m:[38;5;10m[49m             t[k + 1] = s;
[0m[49m[38;5;10m+    301[0m:[38;5;10m[49m             let r = gen64(Shape64::Unit, n, &mut rng);
[0m[49m[38;5;10m+    302[0m:[38;5;10m[49m             for &thr in &[0.0f64, 0.25, 1.0, -1.0] {
[0m[49m[38;5;10m+    303[0m:[38;5;10m[49m                 diff_match(&format!("err11 n={n} k={k} thr={thr} #{i}"), &t, &r, n as c_int, thr);
[0m[49m[38;5;10m+    304[0m:[38;5;10m[49m                 diff_match(&format!("err11r n={n} k={k} thr={thr} #{i}"), &r, &t, n as c_int, thr);
[0m[49m[38;5;10m+    305[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    306[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    307[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    308[0m:[38;5;10m[49m     // The same condition at the lowest-level entry point: `inf * 0` inside
[0m[49m[38;5;10m+    309[0m:[38;5;10m[49m     // `dot_product` and `inf/inf` inside `normalize`.
[0m[49m[38;5;10m+    310[0m:[38;5;10m[49m     for n in 1..=20usize {
[0m[49m[38;5;10m+    311[0m:[38;5;10m[49m         for i in 0..30 {
[0m[49m[38;5;10m+    312[0m:[38;5;10m[49m             let a = gen32(Shape32::Infinities, n, &mut rng);
[0m[49m[38;5;10m+    313[0m:[38;5;10m[49m             let b = gen32(Shape32::Infinities, n, &mut rng);
[0m[49m[38;5;10m+    314[0m:[38;5;10m[49m             diff_sc(&format!("err11sc n={n} #{i}"), &a, &b, n as c_int);
