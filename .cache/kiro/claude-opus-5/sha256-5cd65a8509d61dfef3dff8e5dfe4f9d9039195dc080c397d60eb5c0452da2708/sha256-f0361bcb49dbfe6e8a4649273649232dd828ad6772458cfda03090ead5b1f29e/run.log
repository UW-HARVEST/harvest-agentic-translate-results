[0m[49m[38;5;10m+    547[0m:[38;5;10m[49m     let n = 4_000_000usize;
[0m[49m[38;5;10m+    548[0m:[38;5;10m[49m     let t = vec![1.0f64 + 1e-9; n];
[0m[49m[38;5;10m+    549[0m:[38;5;10m[49m     let r = vec![1.0f64 + 2e-9; n];
[0m[49m[38;5;10m+    550[0m:[38;5;10m[49m     let (co, _) = probe::isolated_match(&l.c, &t, &r, n as c_int, 0.25);
[0m[49m[38;5;10m+    551[0m:[38;5;10m[49m     assert!(co.crashed(), "err19: expected the C VLA to overflow the stack, got {co:?}");
[0m[49m[38;5;10m+    552[0m:[38;5;10m[49m     // Documented divergence: the Rust uses heap `Vec`s, so it completes. This is
[0m[49m[38;5;10m+    553[0m:[38;5;10m[49m     // C undefined behaviour (stack overflow), so no value is compared.
[0m[49m[38;5;10m+    554[0m:[38;5;10m[49m     let (ro, rv) = probe::isolated_match(&l.r, &t, &r, n as c_int, 0.25);
[0m[49m[38;5;10m+    555[0m:[38;5;10m[49m     assert_eq!(ro, Outcome::Exited(0), "err19: Rust outcome {ro:?}");
[0m[49m[38;5;10m+    556[0m:[38;5;10m[49m     assert!(rv.is_some());
[0m[49m[38;5;10m+    557[0m:[38;5;10m[49m }
