[0m[49m[38;5;10m+    219[0m:[38;5;10m[49m     for &len in &[0i32, -1, -7, i32::MIN] {
[0m[49m[38;5;10m+    220[0m:[38;5;10m[49m         let a = gen32(Shape32::BitRandom, 8, &mut rng);
[0m[49m[38;5;10m+    221[0m:[38;5;10m[49m         let b = gen32(Shape32::BitRandom, 8, &mut rng);
[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m         let c = call_sc(&l.c, &a, &b, len);
[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m         let r = call_sc(&l.r, &a, &b, len);
[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m         assert_sc_eq(&format!("err06 len={len}"), &c, &r);
[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m         assert_eq!(c.ret, 0x0000_0000_0000_0000, "err06 len={len}: C must return +0.0");
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m // Row 8 — `smoothen`'s truncated tail keeps the `N_SMOOTH` divisor.
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m fn err08_smoothen_tail_divisor() {
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m     let mut rng = Rng::new(0xE008);
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m     // For every `bins < 16` *every* window is truncated; for `bins >= 16` only
