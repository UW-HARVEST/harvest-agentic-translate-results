[0m[49m[38;5;10m+    460[0m:[38;5;10m[49m // Row 16 — aliased `a == b`.
[0m[49m[38;5;10m+    461[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    462[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    463[0m:[38;5;10m[49m fn err16_spectral_contrast_aliased() {
