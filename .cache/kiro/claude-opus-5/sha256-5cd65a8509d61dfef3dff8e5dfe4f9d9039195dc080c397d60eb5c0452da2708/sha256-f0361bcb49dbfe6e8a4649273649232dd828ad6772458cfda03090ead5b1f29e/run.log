[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m     for n in 1..=40usize {
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m         for shape in [Shape64::Constant, Shape64::Unit, Shape64::Ramp, Shape64::Impulse] {
[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m             for i in 0..12 {
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m                 let t = gen64(shape, n, &mut rng);
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m                 let r = gen64(shape, n, &mut rng);
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m                 for &thr in &[0.0f64, 0.25, 0.9, 1.0] {
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m                     diff_match(
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m                         &format!("err08 n={n} {shape:?} thr={thr} #{i}"),
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m                         &t,
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m                         &r,
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m                         n as c_int,
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m                         thr,
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m                     );
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m // Row 10 — `differentiate` with `length == 1` forces the sole element to 0.
[0m[49m[38;5;10m+    259[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m fn err10_differentiate_length_one() {
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m     let mut rng = Rng::new(0xE00A);
