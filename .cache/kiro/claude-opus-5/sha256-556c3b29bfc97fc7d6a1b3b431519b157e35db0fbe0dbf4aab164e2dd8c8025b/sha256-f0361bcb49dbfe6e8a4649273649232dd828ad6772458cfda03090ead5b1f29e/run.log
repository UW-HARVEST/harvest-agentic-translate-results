[0m[49m[38;5;10m+    181[0m:[38;5;10m[49m         let s1: Vec<u8> = (0..rng.range(1, 64))
[0m[49m[38;5;10m+    182[0m:[38;5;10m[49m             .map(|_| rng.range(0x80, 0xFF) as u8)
[0m[49m[38;5;10m+    183[0m:[38;5;10m[49m             .collect();
[0m[49m[38;5;10m+    184[0m:[38;5;10m[49m         let s2: Vec<u8> = (0..rng.range(1, 16))
[0m[49m[38;5;10m+    185[0m:[38;5;10m[49m             .map(|_| rng.range(0x80, 0xFF) as u8)
[0m[49m[38;5;10m+    186[0m:[38;5;10m[49m             .collect();
[0m[49m[38;5;10m+    187[0m:[38;5;10m[49m         let want = strcspn_ref(&s1, &s2);
