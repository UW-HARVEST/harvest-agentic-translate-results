[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m     same(&["0", "1", "0"]);
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m     same(&["0", "0", "1"]);
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m     same(&["0.5", "0.5", "0.5"]);
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m     same(&["100000", "200000", "300000"]);
[0m[49m[38;5;10m+    236[0m:[38;5;10m[49m     same(&["-3.5", "2.25", "-0.125"]);
