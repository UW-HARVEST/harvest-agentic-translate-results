[0m[49m[38;5;10m+    296[0m:[38;5;10m[49m     same(&["0x0.8p-148", "0", "0"]);
[0m[49m[38;5;10m+    297[0m:[38;5;10m[49m     same(&["-0x1p-149", "0x1p-149", "0"]);
[0m[49m[38;5;10m+    298[0m:[38;5;10m[49m     same(&["0x1p-150", "0", "0"]);
[0m[49m[38;5;10m+    299[0m:[38;5;10m[49m     same(&["0x1.8p-150", "0", "0"]);
[0m[49m[38;5;10m+    300[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    301[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    302[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    303[0m:[38;5;10m[49m // Infinities and NaNs: the interesting part of Q_rsqrt
[0m[49m[38;5;10m+    304[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    305[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    306[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    307[0m:[38;5;10m[49m fn infinities() {
[0m[49m[38;5;10m+    308[0m:[38;5;10m[49m     same(&["inf", "0", "0"]);
[0m[49m[38;5;10m+    309[0m:[38;5;10m[49m     same(&["-inf", "0", "0"]);
[0m[49m[38;5;10m+    310[0m:[38;5;10m[49m     same(&["inf", "inf", "inf"]);
[0m[49m[38;5;10m+    311[0m:[38;5;10m[49m     same(&["-inf", "-inf", "-inf"]);
[0m[49m[38;5;10m+    312[0m:[38;5;10m[49m     same(&["inf", "-inf", "0"]);
[0m[49m[38;5;10m+    313[0m:[38;5;10m[49m     same(&["-inf", "inf", "0"]);
[0m[49m[38;5;10m+    314[0m:[38;5;10m[49m     same(&["inf", "1", "-inf"]);
[0m[49m[38;5;10m+    315[0m:[38;5;10m[49m     same(&["1", "inf", "1"]);
[0m[49m[38;5;10m+    316[0m:[38;5;10m[49m     same(&["infinity", "0", "0"]);
[0m[49m[38;5;10m+    317[0m:[38;5;10m[49m     same(&["-INFINITY", "0", "0"]);
[0m[49m[38;5;10m+    318[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    319[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    320[0m:[38;5;10m[49m /// A single NaN anywhere poisons the whole result.
[0m[49m[38;5;10m+    321[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    322[0m:[38;5;10m[49m fn single_nan() {
[0m[49m[38;5;10m+    323[0m:[38;5;10m[49m     same_in_each_slot("nan");
[0m[49m[38;5;10m+    324[0m:[38;5;10m[49m     same_in_each_slot("-nan");
[0m[49m[38;5;10m+    325[0m:[38;5;10m[49m     same_in_each_slot("NaN");
[0m[49m[38;5;10m+    326[0m:[38;5;10m[49m     same_in_each_slot("nan(1234)");
[0m[49m[38;5;10m+    327[0m:[38;5;10m[49m     same_in_each_slot("-nan(0x7f)");
[0m[49m[38;5;10m+    328[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    329[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    330[0m:[38;5;10m[49m /// Two NaNs of *different* signs is the case that pinned down the operand
[0m[49m[38;5;10m+    331[0m:[38;5;10m[49m /// order of `DotProduct`'s additions: x86 NaN propagation is not commutative,
[0m[49m[38;5;10m+    332[0m:[38;5;10m[49m /// so which NaN survives — and therefore the sign printed by `%f` — depends on
[0m[49m[38;5;10m+    333[0m:[38;5;10m[49m /// the left-to-right evaluation order of the C expression.
[0m[49m[38;5;10m+    334[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    335[0m:[38;5;10m[49m fn mixed_sign_nans_select_the_surviving_nan() {
[0m[49m[38;5;10m+    336[0m:[38;5;10m[49m     let nans = ["nan", "-nan"];
[0m[49m[38;5;10m+    337[0m:[38;5;10m[49m     let others = ["1", "-1", "0", "-0", "inf", "-inf", "1e30", "1e-40"];
[0m[49m[38;5;10m+    338[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    339[0m:[38;5;10m[49m     // Every arrangement of two NaNs plus one ordinary value.
[0m[49m[38;5;10m+    340[0m:[38;5;10m[49m     for a in nans {
[0m[49m[38;5;10m+    341[0m:[38;5;10m[49m         for b in nans {
[0m[49m[38;5;10m+    342[0m:[38;5;10m[49m             for o in others {
[0m[49m[38;5;10m+    343[0m:[38;5;10m[49m                 same(&[a, b, o]);
[0m[49m[38;5;10m+    344[0m:[38;5;10m[49m                 same(&[a, o, b]);
[0m[49m[38;5;10m+    345[0m:[38;5;10m[49m                 same(&[o, a, b]);
[0m[49m[38;5;10m+    346[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    347[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    348[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    349[0m:[38;5;10m[49m     // Three NaNs, all sign combinations.
[0m[49m[38;5;10m+    350[0m:[38;5;10m[49m     for a in nans {
[0m[49m[38;5;10m+    351[0m:[38;5;10m[49m         for b in nans {
[0m[49m[38;5;10m+    352[0m:[38;5;10m[49m             for c in nans {
[0m[49m[38;5;10m+    353[0m:[38;5;10m[49m                 same(&[a, b, c]);
[0m[49m[38;5;10m+    354[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    355[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    356[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    357[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    358[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    359[0m:[38;5;10m[49m /// `inf * 0` and `inf - inf` are invalid operations; on x86 they produce the
[0m[49m[38;5;10m+    360[0m:[38;5;10m[49m /// "QNaN indefinite", whose sign bit is set, so `%f` prints `-nan`.
[0m[49m[38;5;10m+    361[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    362[0m:[38;5;10m[49m fn invalid_operations_produce_negative_nan() {
[0m[49m[38;5;10m+    363[0m:[38;5;10m[49m     same(&["inf", "0", "0"]);
[0m[49m[38;5;10m+    364[0m:[38;5;10m[49m     same(&["-inf", "0", "0"]);
[0m[49m[38;5;10m+    365[0m:[38;5;10m[49m     same(&["inf", "-inf", "0"]);
[0m[49m[38;5;10m+    366[0m:[38;5;10m[49m     same(&["inf", "-inf", "1"]);
[0m[49m[38;5;10m+    367[0m:[38;5;10m[49m     same(&["0", "inf", "0"]);
[0m[49m[38;5;10m+    368[0m:[38;5;10m[49m     same(&["0", "0", "-inf"]);
[0m[49m[38;5;10m+    369[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    370[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    371[0m:[38;5;10m[49m /// NaN payloads and signs combined with infinities.
[0m[49m[38;5;10m+    372[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    373[0m:[38;5;10m[49m fn nans_mixed_with_infinities() {
[0m[49m[38;5;10m+    374[0m:[38;5;10m[49m     let pool = ["nan", "-nan", "inf", "-inf", "0", "-0", "1"];
[0m[49m[38;5;10m+    375[0m:[38;5;10m[49m     for a in pool {
[0m[49m[38;5;10m+    376[0m:[38;5;10m[49m         for b in pool {
[0m[49m[38;5;10m+    377[0m:[38;5;10m[49m             for c in pool {
[0m[49m[38;5;10m+    378[0m:[38;5;10m[49m                 same(&[a, b, c]);
[0m[49m[38;5;10m+    379[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    380[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    381[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    382[0m:[38;5;10m[49m }
