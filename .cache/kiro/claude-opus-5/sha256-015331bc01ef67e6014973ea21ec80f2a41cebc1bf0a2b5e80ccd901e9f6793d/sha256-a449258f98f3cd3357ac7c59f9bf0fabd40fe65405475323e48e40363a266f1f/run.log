[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m     same(&["1e30", "1e30", "1e30"]);
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m     same(&["1e38", "1e38", "1e38"]);
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m     same(&["3.4028235e38", "0", "0"]);
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m     same(&["-3.4028235e38", "0", "0"]);
[0m[49m[38;5;10m+    271[0m:[38;5;10m[49m     same(&["1e39", "0", "0"]);
[0m[49m[38;5;10m+    272[0m:[38;5;10m[49m     same(&["-1e39", "0", "0"]);
[0m[49m[38;5;10m+    273[0m:[38;5;10m[49m     same(&["1e300", "0", "0"]);
[0m[49m[38;5;10m+    274[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    275[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m /// Squaring tiny values underflows to zero, so `Q_rsqrt` sees exactly `0`.
[0m[49m[38;5;10m+    277[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    278[0m:[38;5;10m[49m fn dot_product_underflows_to_zero() {
[0m[49m[38;5;10m+    279[0m:[38;5;10m[49m     same(&["1e-30", "1e-30", "1e-30"]);
[0m[49m[38;5;10m+    280[0m:[38;5;10m[49m     same(&["1e-23", "0", "0"]);
[0m[49m[38;5;10m+    281[0m:[38;5;10m[49m     same(&["1e-38", "0", "0"]);
[0m[49m[38;5;10m+    282[0m:[38;5;10m[49m     same(&["1e-45", "0", "0"]);
[0m[49m[38;5;10m+    283[0m:[38;5;10m[49m     same(&["1e-46", "0", "0"]);
[0m[49m[38;5;10m+    284[0m:[38;5;10m[49m     same(&["1.4012984643e-45", "0", "0"]);
[0m[49m[38;5;10m+    285[0m:[38;5;10m[49m     same(&["7.0064923217e-46", "0", "0"]);
[0m[49m[38;5;10m+    286[0m:[38;5;10m[49m     same(&["1e-320", "0", "0"]);
[0m[49m[38;5;10m+    287[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    288[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    289[0m:[38;5;10m[49m /// `float` subnormals, reached both directly and through the double-to-float
[0m[49m[38;5;10m+    290[0m:[38;5;10m[49m /// narrowing that the assignment in `main` performs.
[0m[49m[38;5;10m+    291[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    292[0m:[38;5;10m[49m fn float_subnormals() {
[0m[49m[38;5;10m+    293[0m:[38;5;10m[49m     same(&["0x1p-149", "0", "0"]);
