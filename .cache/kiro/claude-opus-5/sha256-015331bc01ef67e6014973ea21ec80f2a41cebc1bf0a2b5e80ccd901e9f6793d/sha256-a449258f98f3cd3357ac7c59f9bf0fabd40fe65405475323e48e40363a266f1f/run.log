use std::io::{BufRead,Write};
fn format_f(value:f64)->String{
    if value.is_nan(){return if value.is_sign_negative(){"-nan".into()}else{"nan".into()};}
    if value.is_infinite(){return if value<0.0{"-inf".into()}else{"inf".into()};}
    format!("{:.6}",value)
}
fn main(){
    let si=std::io::stdin(); let mut o=std::io::BufWriter::new(std::io::stdout());
    for l in si.lock().lines(){ let l=l.unwrap(); let t=l.trim();
        if t.is_empty(){continue;}
        let b=u32::from_str_radix(t.trim_start_matches("0x"),16).unwrap();
        let f=f32::from_bits(b);
        writeln!(o,"{}",format_f(f as f64)).unwrap();
    }
}
EOF
