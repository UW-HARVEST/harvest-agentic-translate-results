import os
d='/tmp/cases2'
def w(n,x):
    open(os.path.join(d,n),'wb').write(x if isinstance(x,bytes) else x.encode('latin-1'))
def L(*l): return '\n'.join(l)+'\n'

# owner string of controlled length: name field 32 chars + password of k chars
for k in range(0, 32):
    owner_name = 'N'*32
    pw = 'P'*k if k else 'x'
    body = L(f'adduser {owner_name} {pw} 9', f'login {owner_name} {pw}', 'whoami')
    body += L(*[f'createfile f{i}' for i in range(1,21)])
    body += L('listfiles','status','listvars','readfile f20')
    w(f'owner_len_{32+len(pw)}', body)

# same but only a few files so the overflow lands in the middle of files[]
for k in (0,10,20,31):
    pw='P'*k if k else 'x'
    w(f'owner_mid_{k}', L(f'adduser {"N"*32} {pw} 9', f'login {"N"*32} {pw}',
        'createfile a A','createfile b B','listfiles','readfile a','deletefile a',
        'listfiles','status'))

# every last-user password length
for n in range(0, 64):
    w(f'lu_pw_{n:02d}', L(*[f'adduser u{i} p{i} {i}' for i in range(1,10)])
      + L('adduser LAST '+'P'*n+' 5','listusers','status','whoami','listfiles','listvars'))
# every last-user NAME length
for n in range(28, 64):
    w(f'lu_nm_{n:02d}', L(*[f'adduser u{i} p{i} {i}' for i in range(1,10)])
      + L('adduser '+'N'*n+' pw 5','listusers','status','whoami'))
