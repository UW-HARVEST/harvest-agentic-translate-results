import random, subprocess, sys
C="c_src/build/driver"; R="translation/target/release/driver"
def run(b,d):
    p=subprocess.run([b],input=d,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
    return p.returncode,p.stdout,p.stderr
CMDS=["adduser","login","logout","whoami","listusers","createfile","touch","readfile","cat",
 "writefile","deletefile","rm","listfiles","ls","set","get","unset","listvars","compare",
 "compareN","startswith","match","debug","verbose","status","help","add","log","list",
 "create","read","write","delete","junk",""]
bad=0
for seed in range(40):
    rng=random.Random(1000+seed)
    lines=[]
    # seed the session with a state that is close to an overflow boundary
    mode=rng.randint(0,3)
    if mode==0:
        for i in range(1,10): lines.append(f'adduser u{i} p{i} {i}')
        lines.append('adduser LAST '+'P'*rng.randint(38,44)+' 5')
    elif mode==1:
        k=rng.randint(1,31); pw='P'*k
        lines.append(f'adduser {"N"*32} {pw} 9'); lines.append(f'login {"N"*32+pw} {pw}')
        for i in range(1,rng.randint(2,21)): lines.append(f'createfile f{i}')
    elif mode==2:
        for i in range(1,rng.randint(2,22)): lines.append(f'set v{i} '+'V'*rng.randint(1,63))
    else:
        lines.append('adduser a p 9'); lines.append('login a p')
    W=["a","b","f1","f2","f20","on","off","0","1","5","9","-1","N"*32,"N"*40,"N"*63,
       "P"*31,"P"*40,"u1","p1","LAST","2147483647","abc"]
    for _ in range(rng.randint(1,25)):
        c=rng.choice(CMDS); n=rng.choice([0,1,2,2,3,4])
        lines.append(" ".join([c]+[rng.choice(W) for _ in range(n)]))
    data=("\n".join(lines)+"\n").encode('latin-1')
    a=run(C,data); b=run(R,data)
    if a!=b:
        bad+=1
        open(f'/tmp/sfuzz_{seed}','wb').write(data)
        print("MISMATCH seed",seed,"exit",a[0],b[0],"lens",len(a[1]),len(b[1]))
        for i,(x,y) in enumerate(zip(a[1],b[1])):
            if x!=y: print("  byte",i,repr(a[1][i:i+50]),repr(b[1][i:i+50])); break
print("state-biased fuzz mismatches:",bad)
