        let y = f64::from_bits(u64::from_str_radix(it.next().unwrap(), 16).unwrap());
        let (r, e) = cpow::pow_with_errno(x, y);
        let ec = match e { cpow::Errno::None => 0, cpow::Errno::Edom => 33, cpow::Errno::Erange => 34 };
        // also exercise the %.2f formatter on all three doubles
        writeln!(w, "{:016x} {} {} {} {}", r.to_bits(), ec,
                 cfmt::format_f2(r), cfmt::format_f2(x), cfmt::format_f2(y)).unwrap();
    }
}
