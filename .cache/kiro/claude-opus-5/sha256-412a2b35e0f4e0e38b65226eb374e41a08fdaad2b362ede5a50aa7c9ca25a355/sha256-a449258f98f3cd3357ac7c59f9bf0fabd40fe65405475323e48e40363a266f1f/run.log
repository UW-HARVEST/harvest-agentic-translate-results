[0m[49m[38;5;10m+    413[0m:[38;5;10m[49m             .collect();
[0m[49m[38;5;10m+    414[0m:[38;5;10m[49m         let frac: String = (0..rng.below(18))
[0m[49m[38;5;10m+    415[0m:[38;5;10m[49m             .map(|_| (b'0' + rng.below(10) as u8) as char)
[0m[49m[38;5;10m+    416[0m:[38;5;10m[49m             .collect();
[0m[49m[38;5;10m+    417[0m:[38;5;10m[49m         let base = format!("{}{}.{}e{}", sign, digits, frac, rng.range(-340, 340));
[0m[49m[38;5;10m+    418[0m:[38;5;10m[49m         let exponent = format!("{}", rng.range(-1200, 1200));
[0m[49m[38;5;10m+    419[0m:[38;5;10m[49m         check(&base, &exponent);
