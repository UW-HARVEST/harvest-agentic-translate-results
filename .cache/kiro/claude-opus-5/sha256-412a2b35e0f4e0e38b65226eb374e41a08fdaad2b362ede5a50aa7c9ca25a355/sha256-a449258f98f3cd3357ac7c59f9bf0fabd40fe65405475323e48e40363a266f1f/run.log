#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
static char line[4000000];
static unsigned char buf[2000001];
int main(void){
  while (fgets(line, sizeof line, stdin)) {
    size_t n = strlen(line);
    while (n && (line[n-1]=='\n'||line[n-1]=='\r')) line[--n]=0;
    if (!n) continue;
    size_t m = n/2;
    for (size_t i=0;i<m;i++){ unsigned v; sscanf(line+2*i, "%2x", &v); buf[i]=(unsigned char)v; }
    buf[m]=0;
    char *end;
    errno = 0;
    double d = strtod((char*)buf, &end);
    unsigned long long bits; memcpy(&bits, &d, 8);
    printf("%016llx %zu %d\n", bits, (size_t)(end-(char*)buf), errno==ERANGE?1:0);
  }
  return 0;
}
