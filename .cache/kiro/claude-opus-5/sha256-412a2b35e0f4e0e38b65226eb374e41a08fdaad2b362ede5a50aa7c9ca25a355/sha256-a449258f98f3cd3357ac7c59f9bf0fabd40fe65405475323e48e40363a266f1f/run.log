#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
static char line[4000010];
static unsigned char buf[2000005];
static int hv(int c){ if(c>='0'&&c<='9')return c-'0'; if(c>='a'&&c<='f')return c-'a'+10; if(c>='A'&&c<='F')return c-'A'+10; return -1;}
int main(void){
  while (fgets(line, sizeof line, stdin)) {
    size_t n = strlen(line);
    while (n && (line[n-1]=='\n'||line[n-1]=='\r')) line[--n]=0;
    if (!n) continue;
    size_t m = n/2;
    for (size_t i=0;i<m;i++) buf[i] = (unsigned char)(hv(line[2*i])*16 + hv(line[2*i+1]));
    buf[m]=0;
    char *end;
    errno = 0;
    double d = strtod((char*)buf, &end);
    unsigned long long bits; memcpy(&bits, &d, 8);
    printf("%016llx %zu %d\n", bits, (size_t)(end-(char*)buf), errno==ERANGE?1:0);
  }
  return 0;
}
