use std::ffi::CString;
use std::io::Write;
use std::os::unix::ffi::OsStrExt;
const EDOM: i32 = 33;
const ERANGE: i32 = 34;
#[link(name = "m")]
extern "C" {
    fn strtod(nptr: *const std::os::raw::c_char, endptr: *mut *mut std::os::raw::c_char) -> f64;
    fn pow(x: f64, y: f64) -> f64;
    fn __errno_location() -> *mut i32;
}
fn errno_get() -> i32 { unsafe { *__errno_location() } }
fn errno_clear() { unsafe { *__errno_location() = 0 } }
struct StrtodResult { value: f64, has_trailing: bool, errno: i32 }
fn c_strtod(bytes: &[u8]) -> StrtodResult {
    let truncated = match bytes.iter().position(|&b| b == 0) { Some(i) => &bytes[..i], None => bytes };
    let cstr = CString::new(truncated).unwrap();
    let nptr = cstr.as_ptr();
    let mut endptr: *mut std::os::raw::c_char = std::ptr::null_mut();
    errno_clear();
    let value = unsafe { strtod(nptr, &mut endptr) };
    let errno = errno_get();
    let offset = (endptr as usize) - (nptr as usize);
    let has_trailing = cstr.as_bytes().get(offset).is_some_and(|&b| b != 0);
    StrtodResult { value, has_trailing, errno }
}
fn c_pow(base: f64, exponent: f64) -> (f64, i32) {
    errno_clear();
    let result = unsafe { pow(base, exponent) };
    (result, errno_get())
}
fn format_f2(v: f64) -> String {
    if v.is_nan() { if v.is_sign_negative() { "-nan".to_string() } else { "nan".to_string() } }
    else { format!("{:.2}", v) }
}
fn ew(b: &[u8]) { let mut e = std::io::stderr(); let _ = e.write_all(b); let _ = e.flush(); }
fn main() {
    let argv: Vec<Vec<u8>> = std::env::args_os().map(|a| a.as_bytes().to_vec()).collect();
    if argv.len() != 3 {
        let prog: &[u8] = argv.first().map_or(&b"(null)"[..], |a| a.as_slice());
        let mut m = b"Usage: ".to_vec(); m.extend_from_slice(prog); m.extend_from_slice(b" base exponent\n");
        ew(&m); std::process::exit(1);
    }
    let ba = &argv[1];
    let bc = c_strtod(ba);
    if bc.errno == ERANGE { let mut m=b"Range error while converting base '".to_vec(); m.extend_from_slice(ba); m.extend_from_slice(b"'\n"); ew(&m); std::process::exit(1); }
    else if bc.has_trailing { let mut m=b"Invalid numeric input for base: '".to_vec(); m.extend_from_slice(ba); m.extend_from_slice(b"'\n"); ew(&m); std::process::exit(1); }
    let base = bc.value;
    let ea = &argv[2];
    let ec = c_strtod(ea);
    if ec.errno == ERANGE { let mut m=b"Range error while converting exponent '".to_vec(); m.extend_from_slice(ea); m.extend_from_slice(b"'\n"); ew(&m); std::process::exit(1); }
    else if ec.has_trailing { let mut m=b"Invalid numeric input for exponent: '".to_vec(); m.extend_from_slice(ea); m.extend_from_slice(b"'\n"); ew(&m); std::process::exit(1); }
    let exponent = ec.value;
    let (result, pe) = c_pow(base, exponent);
    if pe == EDOM { ew(format!("Domain error: pow({}, {}) is undefined in the real number domain.\n", format_f2(base), format_f2(exponent)).as_bytes()); std::process::exit(1); }
    else if pe == ERANGE { ew(format!("Range error: pow({}, {}) caused overflow or underflow.\n", format_f2(base), format_f2(exponent)).as_bytes()); std::process::exit(1); }
    let mut o = std::io::stdout(); let _ = o.write_all(format!("Result: {}\n", format_f2(result)).as_bytes()); let _ = o.flush();
    std::process::exit(0);
}
EOF
