mod strtod;
use std::io::{self, Read, Write};
fn main(){
    let mut buf = Vec::new();
    io::stdin().read_to_end(&mut buf).unwrap();
    let out = io::stdout();
    let mut w = io::BufWriter::new(out.lock());
    for line in buf.split(|&b| b == b'\n') {
        if line.is_empty() { continue; }
        // line is hex-encoded bytes of the input string
        let bytes: Vec<u8> = line.chunks(2)
            .map(|c| u8::from_str_radix(std::str::from_utf8(c).unwrap(), 16).unwrap())
            .collect();
        let r = strtod::strtod(&bytes);
        writeln!(w, "{:016x} {} {}", r.value.to_bits(), r.consumed, r.erange as i32).unwrap();
    }
}
