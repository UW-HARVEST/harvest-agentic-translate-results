import re,glob
for f in glob.glob('tests/test_*.rs'):
    s=open(f).read()
    # insert `let _guard = serial();` as first statement of each #[test] fn
    out=[]
    lines=s.split('\n')
    i=0
    while i < len(lines):
        out.append(lines[i])
        if lines[i].strip()=='#[test]':
            # find the fn line ending with '{'
            j=i+1
            while not lines[j].rstrip().endswith('{'):
                out.append(lines[j]); j+=1
            out.append(lines[j])
            out.append('    let _guard = serial();')
            i=j+1
            continue
        i+=1
    open(f,'w').write('\n'.join(out))
    print("patched",f)
EOF
