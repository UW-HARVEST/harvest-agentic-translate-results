[0m[49m[38;5;10m+     90[0m:[38;5;10m[49m             status,
[0m[49m[38;5;10m+     91[0m:[38;5;10m[49m             String::from_utf8_lossy(&self.stdout),
[0m[49m[38;5;10m+     92[0m:[38;5;10m[49m             String::from_utf8_lossy(&self.stderr)
[0m[49m[38;5;10m+     93[0m:[38;5;10m[49m         )
[0m[49m[38;5;10m+     94[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     95[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     96[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     97[0m:[38;5;10m[49m /// Run `program`, writing `input` to its stdin, and collect everything.
[0m[49m[38;5;10m+     98[0m:[38;5;10m[49m ///
[0m[49m[38;5;10m+     99[0m:[38;5;10m[49m /// The write side ignores `EPIPE`: these programs stop reading as soon as one
[0m[49m[38;5;10m+    100[0m:[38;5;10m[49m /// `%d` conversion finishes, so the remainder of a long input is often never
[0m[49m[38;5;10m+    101[0m:[38;5;10m[49m /// consumed. That is true of the C program too and must not fail the test.
[0m[49m[38;5;10m+    102[0m:[38;5;10m[49m fn run(program: &Path, input: &[u8]) -> Outcome {
[0m[49m[38;5;10m+    103[0m:[38;5;10m[49m     let mut child = Command::new(program)
[0m[49m[38;5;10m+    104[0m:[38;5;10m[49m         .stdin(Stdio::piped())
[0m[49m[38;5;10m+    105[0m:[38;5;10m[49m         .stdout(Stdio::piped())
[0m[49m[38;5;10m+    106[0m:[38;5;10m[49m         .stderr(Stdio::piped())
[0m[49m[38;5;10m+    107[0m:[38;5;10m[49m         .spawn()
[0m[49m[38;5;10m+    108[0m:[38;5;10m[49m         .unwrap_or_else(|e| panic!("failed to spawn {}: {e}", program.display()));
[0m[49m[38;5;10m+    109[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    110[0m:[38;5;10m[49m     {
[0m[49m[38;5;10m+    111[0m:[38;5;10m[49m         let mut stdin = child.stdin.take().expect("stdin was piped");
[0m[49m[38;5;10m+    112[0m:[38;5;10m[49m         let input = input.to_vec();
[0m[49m[38;5;10m+    113[0m:[38;5;10m[49m         // A separate thread avoids deadlocking on inputs larger than the pipe
[0m[49m[38;5;10m+    114[0m:[38;5;10m[49m         // buffer; write errors (EPIPE) are deliberately ignored.
[0m[49m[38;5;10m+    115[0m:[38;5;10m[49m         std::thread::spawn(move || {
[0m[49m[38;5;10m+    116[0m:[38;5;10m[49m             let _ = stdin.write_all(&input);
[0m[49m[38;5;10m+    117[0m:[38;5;10m[49m             let _ = stdin.flush();
[0m[49m[38;5;10m+    118[0m:[38;5;10m[49m         });
[0m[49m[38;5;10m+    119[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    120[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    121[0m:[38;5;10m[49m     let out = child.wait_with_output().expect("failed to wait for child");
[0m[49m[38;5;10m+    122[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    123[0m:[38;5;10m[49m     let status = match out.status.code() {
[0m[49m[38;5;10m+    124[0m:[38;5;10m[49m         Some(code) => Ok(code),
[0m[49m[38;5;10m+    125[0m:[38;5;10m[49m         None => {
[0m[49m[38;5;10m+    126[0m:[38;5;10m[49m             #[cfg(unix)]
[0m[49m[38;5;10m+    127[0m:[38;5;10m[49m             {
[0m[49m[38;5;10m+    128[0m:[38;5;10m[49m                 use std::os::unix::process::ExitStatusExt;
[0m[49m[38;5;10m+    129[0m:[38;5;10m[49m                 Err(out.status.signal().expect("no code and no signal"))
[0m[49m[38;5;10m+    130[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    131[0m:[38;5;10m[49m             #[cfg(not(unix))]
[0m[49m[38;5;10m+    132[0m:[38;5;10m[49m             {
[0m[49m[38;5;10m+    133[0m:[38;5;10m[49m                 panic!("process ended without an exit code")
[0m[49m[38;5;10m+    134[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    135[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    136[0m:[38;5;10m[49m     };
[0m[49m[38;5;10m+    137[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    138[0m:[38;5;10m[49m     Outcome {
[0m[49m[38;5;10m+    139[0m:[38;5;10m[49m         stdout: out.stdout,
[0m[49m[38;5;10m+    140[0m:[38;5;10m[49m         stderr: out.stderr,
[0m[49m[38;5;10m+    141[0m:[38;5;10m[49m         status,
[0m[49m[38;5;10m+    142[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    143[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    144[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    145[0m:[38;5;10m[49m /// Assert that both programs agree on stdout, stderr and exit status.
[0m[49m[38;5;10m+    146[0m:[38;5;10m[49m fn assert_same(description: &str, input: &[u8]) {
[0m[49m[38;5;10m+    147[0m:[38;5;10m[49m     let c = run(&c_binary(), input);
[0m[49m[38;5;10m+    148[0m:[38;5;10m[49m     let r = run(&rust_binary(), input);
[0m[49m[38;5;10m+    149[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    150[0m:[38;5;10m[49m     assert_eq!(
[0m[49m[38;5;10m+    151[0m:[38;5;10m[49m         c.stdout,
[0m[49m[38;5;10m+    152[0m:[38;5;10m[49m         r.stdout,
[0m[49m[38;5;10m+    153[0m:[38;5;10m[49m         "stdout differs for {description} (input {:?})\n  C:    {:?}\n  Rust: {:?}",
[0m[49m[38;5;10m+    154[0m:[38;5;10m[49m         String::from_utf8_lossy(input),
[0m[49m[38;5;10m+    155[0m:[38;5;10m[49m         String::from_utf8_lossy(&c.stdout),
[0m[49m[38;5;10m+    156[0m:[38;5;10m[49m         String::from_utf8_lossy(&r.stdout)
[0m[49m[38;5;10m+    157[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    158[0m:[38;5;10m[49m     assert_eq!(
[0m[49m[38;5;10m+    159[0m:[38;5;10m[49m         c.stderr,
[0m[49m[38;5;10m+    160[0m:[38;5;10m[49m         r.stderr,
[0m[49m[38;5;10m+    161[0m:[38;5;10m[49m         "stderr differs for {description} (input {:?})\n  C:    {:?}\n  Rust: {:?}",
[0m[49m[38;5;10m+    162[0m:[38;5;10m[49m         String::from_utf8_lossy(input),
[0m[49m[38;5;10m+    163[0m:[38;5;10m[49m         String::from_utf8_lossy(&c.stderr),
[0m[49m[38;5;10m+    164[0m:[38;5;10m[49m         String::from_utf8_lossy(&r.stderr)
[0m[49m[38;5;10m+    165[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    166[0m:[38;5;10m[49m     assert_eq!(
[0m[49m[38;5;10m+    167[0m:[38;5;10m[49m         c.status, r.status,
[0m[49m[38;5;10m+    168[0m:[38;5;10m[49m         "exit status differs for {description} (input {:?})\n  C:    {:?}\n  Rust: {:?}",
[0m[49m[38;5;10m+    169[0m:[38;5;10m[49m         String::from_utf8_lossy(input),
[0m[49m[38;5;10m+    170[0m:[38;5;10m[49m         c.status,
[0m[49m[38;5;10m+    171[0m:[38;5;10m[49m         r.status
[0m[49m[38;5;10m+    172[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    173[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    174[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    175[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    176[0m:[38;5;10m[49m // The branch structure of c_src/src/main.c
[0m[49m[38;5;10m+    177[0m:[38;5;10m[49m //
[0m[49m[38;5;10m+    178[0m:[38;5;10m[49m //   main:  scanf("%d", &x);  if (x) good(); else bad();
[0m[49m[38;5;10m+    179[0m:[38;5;10m[49m //
[0m[49m[38;5;10m+    180[0m:[38;5;10m[49m // So the input classes are exactly the classes of `scanf("%d")` outcome
[0m[49m[38;5;10m+    181[0m:[38;5;10m[49m // crossed with "was the stored value zero or non-zero":
[0m[49m[38;5;10m+    182[0m:[38;5;10m[49m //
[0m[49m[38;5;10m+    183[0m:[38;5;10m[49m //   1. conversion never happens (EOF, matching failure) -> x keeps its
[0m[49m[38;5;10m+    184[0m:[38;5;10m[49m //      initialiser 0 -> bad()
[0m[49m[38;5;10m+    185[0m:[38;5;10m[49m //   2. conversion succeeds and yields 0                 -> bad()
[0m[49m[38;5;10m+    186[0m:[38;5;10m[49m //   3. conversion succeeds and yields non-zero          -> good()
[0m[49m[38;5;10m+    187[0m:[38;5;10m[49m //
[0m[49m[38;5;10m+    188[0m:[38;5;10m[49m // bad() calls alloca(10) but stores ten 4-byte ints through the pointer, so it
[0m[49m[38;5;10m+    189[0m:[38;5;10m[49m // writes 30 bytes past the request. That out-of-bounds write is the original
[0m[49m[38;5;10m+    190[0m:[38;5;10m[49m // defect and both programs must survive it identically.
[0m[49m[38;5;10m+    191[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    192[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    193[0m:[38;5;10m[49m // --- class 1: no conversion, x stays 0, bad() runs -------------------------
[0m[49m[38;5;10m+    194[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    195[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    196[0m:[38;5;10m[49m fn empty_input() {
[0m[49m[38;5;10m+    197[0m:[38;5;10m[49m     assert_same("empty input (immediate EOF)", b"");
[0m[49m[38;5;10m+    198[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    199[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m fn whitespace_only() {
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m     // %d skips whitespace then hits EOF: scanf returns EOF, x untouched.
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m     assert_same("spaces and newlines only", b"   \n\t \n");
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m     assert_same("newlines only", b"\n\n");
[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m     assert_same("single space", b" ");
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m     assert_same("vertical tab and form feed", b"\x0b\x0c");
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m fn matching_failure_non_numeric() {
[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m     assert_same("letters", b"abc");
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m     assert_same("leading spaces then letters", b"  abc");
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m     assert_same("leading dot", b".5");
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m     assert_same("comma", b",");
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m     assert_same("hash", b"#1");
[0m[49m[38;5;10m+    216[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    217[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    218[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    219[0m:[38;5;10m[49m fn matching_failure_sign_without_digits() {
[0m[49m[38;5;10m+    220[0m:[38;5;10m[49m     assert_same("bare minus", b"-");
[0m[49m[38;5;10m+    221[0m:[38;5;10m[49m     assert_same("bare plus", b"+");
[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m     assert_same("minus then letter", b"-a");
[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m     assert_same("plus then newline", b"+\n");
[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m     assert_same("double minus", b"--1");
[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m // --- class 2: conversion yields zero, bad() runs ---------------------------
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m fn converts_to_zero() {
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m     assert_same("plain zero", b"0");
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m     assert_same("negative zero", b"-0");
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m     assert_same("positive zero", b"+0");
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m     assert_same("zero with trailing newline", b"0\n");
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m     assert_same("many leading zeros", b"0000000000000000000");
[0m[49m[38;5;10m+    236[0m:[38;5;10m[49m     // 0x is not a %d prefix: reads "0", leaves "x10" unread.
[0m[49m[38;5;10m+    237[0m:[38;5;10m[49m     assert_same("hex-looking literal", b"0x10");
[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m     assert_same("zero then another number", b"0\n1\n");
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m     // 2^32 truncated to a 32-bit int is 0.
[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m     assert_same("2^32 truncates to zero", b"4294967296");
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m     assert_same("-2^32 truncates to zero", b"-4294967296");
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m     // strtol saturates at LONG_MIN; (int)LONG_MIN == 0.
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m     assert_same("negative overflow saturates", b"-99999999999999999999");
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m // --- class 3: conversion yields non-zero, good() runs ---------------------
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m fn converts_to_nonzero() {
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m     assert_same("one", b"1");
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m     assert_same("minus one", b"-1");
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m     assert_same("plus seven", b"+7");
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m     assert_same("leading zeros then digit", b"007");
