[0m[49m[38;5;10m+     86[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+     87[0m:[38;5;10m[49m         write!(
[0m[49m[38;5;10m+     88[0m:[38;5;10m[49m             f,
