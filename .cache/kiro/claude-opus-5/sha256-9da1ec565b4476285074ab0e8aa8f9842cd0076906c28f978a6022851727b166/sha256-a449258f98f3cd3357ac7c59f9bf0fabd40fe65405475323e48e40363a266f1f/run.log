[0m[49m[38;5;10m+     80[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     81[0m:[38;5;10m[49m impl std::fmt::Debug for Outcome {
[0m[49m[38;5;10m+     82[0m:[38;5;10m[49m     fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
[0m[49m[38;5;10m+     83[0m:[38;5;10m[49m         let status = match self.status {
[0m[49m[38;5;10m+     84[0m:[38;5;10m[49m             Ok(code) => format!("exit {}", code),
