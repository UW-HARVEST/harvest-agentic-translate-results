[0m[49m[38;5;10m+     69[0m:[38;5;10m[49m     exe
[0m[49m[38;5;10m+     70[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     71[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     72[0m:[38;5;10m[49m /// What a run of either program produced.
[0m[49m[38;5;10m+     73[0m:[38;5;10m[49m #[derive(PartialEq, Eq)]
[0m[49m[38;5;10m+     74[0m:[38;5;10m[49m struct Outcome {
[0m[49m[38;5;10m+     75[0m:[38;5;10m[49m     stdout: Vec<u8>,
[0m[49m[38;5;10m+     76[0m:[38;5;10m[49m     stderr: Vec<u8>,
[0m[49m[38;5;10m+     77[0m:[38;5;10m[49m     /// `Ok(code)` for a normal exit, `Err(signal)` when killed by a signal.
