[0m[49m[38;5;10m+    601[0m:[38;5;10m[49m     let skipped = p.maxnmin(-1, 0, 1, 0); // node_id 0 → absent
[0m[49m[38;5;10m+    602[0m:[38;5;10m[49m     assert_ne!(with, skipped, "the NULL branch must change the result");
