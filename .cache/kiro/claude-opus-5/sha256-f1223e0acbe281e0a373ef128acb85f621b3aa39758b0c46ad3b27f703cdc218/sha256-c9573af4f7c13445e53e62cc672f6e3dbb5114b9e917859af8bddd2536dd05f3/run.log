[0m[49m[38;5;10m+    577[0m:[38;5;10m[49m /// Row 28: `(param1 % 6) + 1` names no node → first block skipped.
[0m[49m[38;5;10m+    578[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    579[0m:[38;5;10m[49m fn err_28_maxnmin_selected_node_null() {
[0m[49m[38;5;10m+    580[0m:[38;5;10m[49m     let p = Pair::fresh();
