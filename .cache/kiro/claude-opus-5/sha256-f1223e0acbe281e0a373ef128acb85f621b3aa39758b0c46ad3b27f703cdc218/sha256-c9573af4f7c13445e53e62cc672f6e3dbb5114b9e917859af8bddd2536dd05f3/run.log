[0m[49m[38;5;10m+    501[0m:[38;5;10m[49m             p.safe_double_to_int(f64::from_bits((i32::MAX as f64).to_bits() + k)),
[0m[49m[38;5;10m+    502[0m:[38;5;10m[49m             i32::MAX
[0m[49m[38;5;10m+    503[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    504[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    505[0m:[38;5;10m[49m             p.safe_double_to_int(f64::from_bits((i32::MIN as f64).to_bits() + k)),
[0m[49m[38;5;10m+    506[0m:[38;5;10m[49m             i32::MIN
[0m[49m[38;5;10m+    507[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    508[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    509[0m:[38;5;10m[49m }
