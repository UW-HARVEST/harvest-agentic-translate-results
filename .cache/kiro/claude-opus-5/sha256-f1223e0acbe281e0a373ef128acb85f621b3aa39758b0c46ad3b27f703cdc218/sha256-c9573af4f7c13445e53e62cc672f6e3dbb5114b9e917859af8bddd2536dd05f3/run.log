Purpose: Add addsd helper replicating x86 SSE NaN propagation order

[49m[38;5;10m+      167[0m:[38;5;10m[49m /// x86-64 SSE `addsd dst, src` semantics: `dst + src`, but with the hardware's
[0m[49m[38;5;10m+      168[0m:[38;5;10m[49m /// NaN-propagation rule spelled out.
[0m[49m[38;5;10m+      169[0m:[38;5;10m[49m ///
[0m[49m[38;5;10m+      170[0m:[38;5;10m[49m /// The C statement being translated is
[0m[49m[38;5;10m+      171[0m:[38;5;10m[49m ///
[0m[49m[38;5;10m+      172[0m:[38;5;10m[49m /// ```c
[0m[49m[38;5;10m+      173[0m:[38;5;10m[49m /// sum += calculate_subtree_sum(node_storage[i].id);
[0m[49m[38;5;10m+      174[0m:[38;5;10m[49m /// ```
[0m[49m[38;5;10m+      175[0m:[38;5;10m[49m ///
[0m[49m[38;5;10m+      176[0m:[38;5;10m[49m /// gcc leaves the callee's return value in `%xmm0` and emits
[0m[49m[38;5;10m+      177[0m:[38;5;10m[49m /// `addsd %xmm1,%xmm0` — i.e. the *destination* register holds the **child's**
[0m[49m[38;5;10m+      178[0m:[38;5;10m[49m /// subtree sum and the *source* holds the running accumulator. `addsd` returns
[0m[49m[38;5;10m+      179[0m:[38;5;10m[49m /// the destination operand (quieted) when it is a NaN, and only otherwise falls
[0m[49m[38;5;10m+      180[0m:[38;5;10m[49m /// back to the source operand, so the child's NaN sign and payload win over the
[0m[49m[38;5;10m+      181[0m:[38;5;10m[49m /// accumulator's.
[0m[49m[38;5;10m+      182[0m:[38;5;10m[49m ///
[0m[49m[38;5;10m+      183[0m:[38;5;10m[49m /// Writing `child + sum` in Rust would express that at the source level, but
[0m[49m[38;5;10m+      184[0m:[38;5;10m[49m /// LLVM treats `fadd` as commutative and is free to canonicalise the operand
[0m[49m[38;5;10m+      185[0m:[38;5;10m[49m /// order, so the rule is written out explicitly here. When neither operand is a
[0m[49m[38;5;10m+      186[0m:[38;5;10m[49m /// NaN this is a plain `addsd` and any NaN *created* by the addition
[0m[49m[38;5;10m+      187[0m:[38;5;10m[49m /// (`inf + -inf`) is the hardware's "indefinite" QNaN on both sides.
[0m[49m[38;5;10m+      188[0m:[38;5;10m[49m #[inline]
[0m[49m[38;5;10m+      189[0m:[38;5;10m[49m fn addsd(dst: c_double, src: c_double) -> c_double {
[0m[49m[38;5;10m+      190[0m:[38;5;10m[49m     /// Bit 51 — setting it turns a signalling NaN into the quiet NaN with the
[0m[49m[38;5;10m+      191[0m:[38;5;10m[49m     /// same sign and payload, and is a no-op for an already-quiet NaN.
[0m[49m[38;5;10m+      192[0m:[38;5;10m[49m     const QUIET_BIT: u64 = 0x0008_0000_0000_0000;
[0m[49m[38;5;10m+      193[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+      194[0m:[38;5;10m[49m     if dst.is_nan() {
[0m[49m[38;5;10m+      195[0m:[38;5;10m[49m         return c_double::from_bits(dst.to_bits() | QUIET_BIT);
[0m[49m[38;5;10m+      196[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+      197[0m:[38;5;10m[49m     if src.is_nan() {
[0m[49m[38;5;10m+      198[0m:[38;5;10m[49m         return c_double::from_bits(src.to_bits() | QUIET_BIT);
[0m[49m[38;5;10m+      199[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+      200[0m:[38;5;10m[49m     dst + src
[0m[49m[38;5;10m+      201[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+      202[0m:[38;5;10m[49m 
