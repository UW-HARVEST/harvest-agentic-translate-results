[0m[49m[38;5;10m+    640[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    641[0m:[38;5;10m[49m         assert_ne!(p.process_node_name(id), 0);
[0m[49m[38;5;10m+    642[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    643[0m:[38;5;10m[49m     // The guard's else-branch is equivalent to adding 0, which is exactly what
[0m[49m[38;5;10m+    644[0m:[38;5;10m[49m     // process_string returns for an empty string — asserted differentially here.
[0m[49m[38;5;10m+    645[0m:[38;5;10m[49m     let q = Pair::fresh();
