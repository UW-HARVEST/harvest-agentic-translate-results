[0m[49m[38;5;10m+    626[0m:[38;5;10m[49m     assert_ne!(c, d, "with second_node present, param3 must matter");
[0m[49m[38;5;10m+    627[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    628[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    629[0m:[38;5;10m[49m /// Row 30: the `if (*name_ptr)` guard.
[0m[49m[38;5;10m+    630[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    631[0m:[38;5;10m[49m fn err_30_maxnmin_empty_name_branch() {
