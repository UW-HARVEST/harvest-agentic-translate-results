[0m[49m[38;5;10m+    586[0m:[38;5;10m[49m             "p1={p1} should select a missing id, got {node_id}"
[0m[49m[38;5;10m+    587[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    588[0m:[38;5;10m[49m         for p2 in [0i32, 1, 5, -1] {
[0m[49m[38;5;10m+    589[0m:[38;5;10m[49m             for p3 in [1i32, 0, -1] {
[0m[49m[38;5;10m+    590[0m:[38;5;10m[49m                 for p4 in [0i32, 1, 2, -1] {
[0m[49m[38;5;10m+    591[0m:[38;5;10m[49m                     p.maxnmin(p1, p2, p3, p4);
[0m[49m[38;5;10m+    592[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    593[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    594[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    595[0m:[38;5;10m[49m     }
