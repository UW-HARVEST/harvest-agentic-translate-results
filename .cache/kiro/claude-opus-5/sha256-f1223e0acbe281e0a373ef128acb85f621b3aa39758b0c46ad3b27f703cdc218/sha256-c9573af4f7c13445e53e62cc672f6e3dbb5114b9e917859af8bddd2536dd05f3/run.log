[0m[49m[38;5;10m+    290[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    291[0m:[38;5;10m[49m         let v = p.calculate_subtree_sum(1);
[0m[49m[38;5;10m+    292[0m:[38;5;10m[49m         assert_eq!(v.to_bits(), root_val.to_bits(), "only the root value must remain");
