[0m[49m[38;5;10m+    636[0m:[38;5;10m[49m     for id in 1..=6 {
[0m[49m[38;5;10m+    637[0m:[38;5;10m[49m         let (cp, rp) = p.find_node_by_id(id).expect("node");
[0m[49m[38;5;10m+    638[0m:[38;5;10m[49m         for ptr in [cp, rp] {
