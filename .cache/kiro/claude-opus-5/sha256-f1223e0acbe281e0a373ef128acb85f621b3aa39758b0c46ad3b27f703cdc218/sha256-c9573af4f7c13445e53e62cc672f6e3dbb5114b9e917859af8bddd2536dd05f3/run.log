[0m[49m[38;5;10m+    546[0m:[38;5;10m[49m         assert!(d.is_nan(), "0x{bits:016x} should be NaN");
[0m[49m[38;5;10m+    547[0m:[38;5;10m[49m         assert_eq!(p.safe_double_to_int(d), 0, "NaN 0x{bits:016x} → 0");
[0m[49m[38;5;10m+    548[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    549[0m:[38;5;10m[49m     // random NaN payloads
[0m[49m[38;5;10m+    550[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 126);
[0m[49m[38;5;10m+    551[0m:[38;5;10m[49m     for _ in 0..5_000 {
[0m[49m[38;5;10m+    552[0m:[38;5;10m[49m         let payload = rng.next_u64() & 0x000F_FFFF_FFFF_FFFF;
[0m[49m[38;5;10m+    553[0m:[38;5;10m[49m         if payload == 0 {
[0m[49m[38;5;10m+    554[0m:[38;5;10m[49m             continue;
[0m[49m[38;5;10m+    555[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    556[0m:[38;5;10m[49m         let sign = (rng.next_u64() & 1) << 63;
[0m[49m[38;5;10m+    557[0m:[38;5;10m[49m         let d = f64::from_bits(sign | 0x7FF0_0000_0000_0000 | payload);
[0m[49m[38;5;10m+    558[0m:[38;5;10m[49m         assert_eq!(p.safe_double_to_int(d), 0);
[0m[49m[38;5;10m+    559[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    560[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    561[0m:[38;5;10m[49m 
