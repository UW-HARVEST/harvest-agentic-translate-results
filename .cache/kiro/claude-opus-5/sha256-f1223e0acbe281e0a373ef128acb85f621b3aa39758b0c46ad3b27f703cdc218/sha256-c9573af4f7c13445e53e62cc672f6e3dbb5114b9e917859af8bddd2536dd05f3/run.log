[0m[49m[38;5;10m+    528[0m:[38;5;10m[49m /// Row 26: every NaN bit pattern → `0`.
[0m[49m[38;5;10m+    529[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    530[0m:[38;5;10m[49m fn err_26_sdti_nan_payloads() {
[0m[49m[38;5;10m+    531[0m:[38;5;10m[49m     let p = Pair::fresh();
[0m[49m[38;5;10m+    532[0m:[38;5;10m[49m     let nans: [u64; 10] = [
[0m[49m[38;5;10m+    533[0m:[38;5;10m[49m         0x7FF8_0000_0000_0000, // canonical qNaN
[0m[49m[38;5;10m+    534[0m:[38;5;10m[49m         0xFFF8_0000_0000_0000, // -qNaN
[0m[49m[38;5;10m+    535[0m:[38;5;10m[49m         0x7FF8_0000_0000_0001,
[0m[49m[38;5;10m+    536[0m:[38;5;10m[49m         0xFFF8_0000_0000_0001,
[0m[49m[38;5;10m+    537[0m:[38;5;10m[49m         0x7FF0_0000_0000_0001, // sNaN
[0m[49m[38;5;10m+    538[0m:[38;5;10m[49m         0xFFF0_0000_0000_0001,
[0m[49m[38;5;10m+    539[0m:[38;5;10m[49m         0x7FFF_FFFF_FFFF_FFFF,
[0m[49m[38;5;10m+    540[0m:[38;5;10m[49m         0xFFFF_FFFF_FFFF_FFFF,
[0m[49m[38;5;10m+    541[0m:[38;5;10m[49m         0x7FF7_FFFF_FFFF_FFFF,
[0m[49m[38;5;10m+    542[0m:[38;5;10m[49m         0xFFF7_FFFF_FFFF_FFFF,
[0m[49m[38;5;10m+    543[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    544[0m:[38;5;10m[49m     for bits in nans {
