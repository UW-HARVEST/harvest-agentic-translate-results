[0m[49m[38;5;10m+    612[0m:[38;5;10m[49m         for p1 in [0i32, 1, 5] {
[0m[49m[38;5;10m+    613[0m:[38;5;10m[49m             for p3 in [1i32, 0, -1, 100, i32::MAX] {
[0m[49m[38;5;10m+    614[0m:[38;5;10m[49m                 for p4 in [0i32, 1, 2, -1] {
