[0m[49m[38;5;10m+    654[0m:[38;5;10m[49m         let p = fresh_pair();
[0m[49m[38;5;10m+    655[0m:[38;5;10m[49m         let vals: Vec<f64> = (0..6).map(|_| rng.tame_f64()).collect();
