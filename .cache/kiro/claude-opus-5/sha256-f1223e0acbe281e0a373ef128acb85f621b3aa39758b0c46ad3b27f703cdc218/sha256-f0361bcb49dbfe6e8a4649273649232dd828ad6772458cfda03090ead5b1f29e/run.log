[0m[49m[38;5;10m+    452[0m:[38;5;10m[49m         for p2 in -12..=12i32 {
[0m[49m[38;5;10m+    453[0m:[38;5;10m[49m             for p3 in [-2i32, -1, 0, 1, 5] {
[0m[49m[38;5;10m+    454[0m:[38;5;10m[49m                 for p4 in [-2i32, -1, 0, 1, 2] {
[0m[49m[38;5;10m+    455[0m:[38;5;10m[49m                     eq_i32(
