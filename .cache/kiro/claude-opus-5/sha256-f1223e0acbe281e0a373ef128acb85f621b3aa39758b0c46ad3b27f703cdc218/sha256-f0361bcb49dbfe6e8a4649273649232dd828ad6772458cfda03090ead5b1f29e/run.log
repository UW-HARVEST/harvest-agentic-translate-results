[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m             eq_node("C36/state", id, &p.c.find_snap(id), &p.r.find_snap(id));
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m             eq_i32("C36/children", id, p.c.children(id), p.r.children(id));
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m             eq_bits("C36/sum", id, p.c.subtree_bits(id), p.r.subtree_bits(id));
