    51	int safe_add(int a, int b, int perms) {
    52	    if (!check_permissions(perms, READ_PERM | WRITE_PERM)) {
    53	        printf("Insufficient permissions for addition\n");
    54	        return 0;
    55	    }
    56	    return a + b;
    57	}
