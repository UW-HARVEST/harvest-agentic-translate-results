    67	int copy_and_sum(int* src, int count) {
    68	    if (src == NULL) {
    69	        printf("Source pointer is NULL\n");
    70	        return -1;
    71	    }
    72	
    73	    int* dest = (int*)malloc(count * sizeof(int));
    74	    if (dest == NULL) {
    75	        printf("Memory allocation failed\n");
    76	        return -1;
    77	    }
    78	
    79	    memcpy(dest, src, count * sizeof(int));
    80	
    81	    int sum = 0;
    82	    for (int i = 0; i < count; i++) {
    83	        sum += dest[i];
    84	    }
    85	
    86	    free(dest);
    87	    return sum;
    88	}
