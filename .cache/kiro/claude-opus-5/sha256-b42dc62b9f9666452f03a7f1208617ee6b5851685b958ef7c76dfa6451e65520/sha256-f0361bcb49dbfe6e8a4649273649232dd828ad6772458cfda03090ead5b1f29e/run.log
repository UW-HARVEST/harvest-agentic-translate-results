    38	char* create_result_string(const char* op, int val) {
    39	    char* str = (char*)malloc(64 * sizeof(char));
    40	    if (str == NULL) {
    41	        return NULL;
    42	    }
    43	    snprintf(str, 64, "Operation: %s, Value: %d", op, val);
