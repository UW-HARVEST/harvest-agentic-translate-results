[0m[49m[38;5;10m+    168[0m:[38;5;10m[49m // --- EOF / no-input paths: scanf returns EOF, x stays 0 --------------------
[0m[49m[38;5;10m+    169[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    170[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    171[0m:[38;5;10m[49m fn empty_input() {
[0m[49m[38;5;10m+    172[0m:[38;5;10m[49m     assert_same_str("empty", "");
[0m[49m[38;5;10m+    173[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    174[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    175[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    176[0m:[38;5;10m[49m fn only_whitespace() {
