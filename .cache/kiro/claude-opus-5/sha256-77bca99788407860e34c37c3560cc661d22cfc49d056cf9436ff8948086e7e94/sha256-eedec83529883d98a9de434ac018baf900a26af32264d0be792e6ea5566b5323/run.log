import random, subprocess, sys
C="./c_src/build/driver"; R="./translation/target/release/driver"
alpha=b"0123456789+- \t\n\r\x0b\x0cxXabcdefABCDEF.,eE_\x00\xff\x80"
random.seed(1234)
def gen(i):
    if i%7==0:
        n=random.randint(1,25); return bytes(random.choice(alpha) for _ in range(n))
    if i%7==1:
        return str(random.randint(-2**35,2**35)).encode()
    if i%7==2:
        return str(random.randint(-2**70,2**70)).encode()
    if i%7==3:
        pad=bytes(random.choice(b" \t\n\r\x0b\x0c") for _ in range(random.randint(0,5)))
        return pad+str(random.randint(-2**33,2**33)).encode()+pad
    if i%7==4:
        return b"0"*random.randint(0,40)+str(random.randint(0,2**40)).encode()
    if i%7==5:
        return bytes(random.randrange(256) for _ in range(random.randint(0,20)))
    return random.choice([b"",b"-",b"+",b"\n"])+str(random.choice([2**31-1,2**31,-2**31,-2**31-1,2**32,2**63-1,-2**63,2**63,2**64])).encode()
bad=0
for i in range(6000):
    d=gen(i)
    c=subprocess.run([C],input=d,capture_output=True)
    r=subprocess.run([R],input=d,capture_output=True)
    if (c.stdout,c.stderr,c.returncode)!=(r.stdout,r.stderr,r.returncode):
        bad+=1; print("MISMATCH",d, c.stdout, r.stdout, c.returncode, r.returncode)
        if bad>10: break
print("done, mismatches:",bad)
EOF
