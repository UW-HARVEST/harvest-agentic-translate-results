cmp_bytes() {
  desc="$1"; file="$2"
  $C < "$file" > /tmp/co 2>/tmp/ce; crc=$?
  $R < "$file" > /tmp/ro 2>/tmp/re; rrc=$?
  if cmp -s /tmp/co /tmp/ro && cmp -s /tmp/ce /tmp/re && [ $crc -eq $rrc ]; then s=OK; else s=MISMATCH; fi
  printf '%-30s %-9s rc=%s/%s out=%s\n' "$desc" "$s" "$crc" "$rrc" "$(head -c 40 /tmp/co | tr -d '\n')"
}
