[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m     for (wide, low) in cases {
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m         diff_int(wide, &format!("ERRORS row 8: garbage high bits {wide:#010x}"));
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m         let want = capture(|| unsafe { cd(low as c_char) });
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m         let c_wide = capture(|| unsafe { cdi(wide) });
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m             c_wide,
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m             want,
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m             "row 8: C({wide:#010x}) must equal C(char {low:#04x})\n  {}\n  {}",
[0m[49m[38;5;10m+    259[0m:[38;5;10m[49m             render(&c_wide),
[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m             render(&want)
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m         let r_want = capture(|| unsafe { rd(low as c_char) });
[0m[49m[38;5;10m+    263[0m:[38;5;10m[49m         let r_wide = capture(|| unsafe { rdi(wide) });
[0m[49m[38;5;10m+    264[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    265[0m:[38;5;10m[49m             r_wide, r_want,
[0m[49m[38;5;10m+    266[0m:[38;5;10m[49m             "row 8: Rust({wide:#010x}) must equal Rust(char {low:#04x})"
[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m         assert_eq!(c_wide, r_wide, "row 8: C/Rust divergence at {wide:#010x}");
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m 
