[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m         (0xDEAD_BE41u32 as c_int, 0x41),
[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m         (0x7FFF_FF00u32 as c_int, 0x00),
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m         (0xFFFF_FF7Fu32 as c_int, 0x7F),
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m         (0x0BAD_C0DEu32 as c_int, 0xDE),
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m         (c_int::MIN, 0x00),
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m         (c_int::MAX, 0xFF),
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m     ];
