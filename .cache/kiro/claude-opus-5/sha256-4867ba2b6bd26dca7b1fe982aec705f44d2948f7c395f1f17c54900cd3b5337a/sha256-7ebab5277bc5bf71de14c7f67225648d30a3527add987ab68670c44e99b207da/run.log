[0m[49m[38;5;10m+    16[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    17[0m:[38;5;10m[49m # --- enumerate features ------------------------------------------------------
[0m[49m[38;5;10m+    18[0m:[38;5;10m[49m # Feature names are the `name = [...]` keys in the [features] table, minus
[0m[49m[38;5;10m+    19[0m:[38;5;10m[49m # `default`, which is covered by the no-default-features baseline plus combos.
[0m[49m[38;5;10m+    20[0m:[38;5;10m[49m mapfile -t FEATURES < <(
