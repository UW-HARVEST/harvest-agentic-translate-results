[0m[49m[38;5;10m+    12[0m:[38;5;10m[49m if [[ ! -f $C_BUILD/libdriver.so ]]; then
[0m[49m[38;5;10m+    13[0m:[38;5;10m[49m   mkdir -p $C_BUILD
[0m[49m[38;5;10m+    14[0m:[38;5;10m[49m   (cd $C_BUILD && cmake .. -DCMAKE_POSITION_INDEPENDENT_CODE=ON >/dev/null && cmake --build . >/dev/null) || exit 1
