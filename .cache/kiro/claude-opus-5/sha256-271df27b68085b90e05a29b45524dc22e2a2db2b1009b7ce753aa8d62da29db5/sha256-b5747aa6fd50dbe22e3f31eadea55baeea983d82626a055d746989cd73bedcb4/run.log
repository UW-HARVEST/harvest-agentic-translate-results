#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct os_data {
    char *os_name, *os_version, *os_major, *os_minor,
         *os_codename, *os_platform, *os_build, *os_uname, *os_arch;
} os_data;

void parse_uname_string(char *uname, os_data *osd);
char *get_os_arch(char *os_header);
int w_regexec(const char *pattern, const char *string, size_t nmatch, void *pmatch);

static void p(const char *n, char *v) {
    if (v) printf("  %s=[%s]\n", n, v); else printf("  %s=NULL\n", n);
}

static const char *CASES[] = {
    "Microsoft Windows 10 Pro [Ver: 10.0.19045.5011]",
    "Microsoft Windows Server 2019 [Ver: 10.0.17763]",
    "Win [Ver: 6]",
    "x [Ver: ]",
    "Linux |ubuntu_x86_64 [Ubuntu|ubuntu: 22.04 (Jammy Jellyfish)]",
    "Linux ip-1 5.15.0 x86_64 [CentOS Linux|centos: 8.5 (Core)]",
    "Linux host 4.18 aarch64 [Amazon Linux|amzn: 2]",
    "Darwin mac 21.6.0 arm64 [macOS|darwin: 12.5 (Monterey)]",
    "SunOS s 5.11 i86pc [Solaris: 11.4]",
    "AIX host 7 2 ia64 [AIX: 7.2]",
    "Linux h armv7l [Debian GNU/Linux|debian: 11 (bullseye)]",
    "Linux h sparc [NoColon]",
    "Linux h amd64 [a|b: 1.2.3.4 (x) (y)]",
    "no brackets at all x86_64",
    "trailing space [ ]",
    "empty version [x: ]",
    "Linux [|onlypipe: 9.9]",
    "FreeBSD f 13.1 amd64 [FreeBSD|freebsd: 13.1-RELEASE]",
    "weird [Ver: abc.def]",
    "weird2 [Ver: 12.34.56.78.90]",
    "arch first i386 then [Ver: 1.2.3]",
    NULL
};

int main(void) {
    for (int i = 0; CASES[i]; i++) {
        char buf[512];
        strcpy(buf, CASES[i]);
        os_data o;
        memset(&o, 0, sizeof(o));
        printf("CASE %d: <%s>\n", i, CASES[i]);
        parse_uname_string(buf, &o);
        p("name", o.os_name); p("version", o.os_version); p("major", o.os_major);
        p("minor", o.os_minor); p("codename", o.os_codename); p("platform", o.os_platform);
        p("build", o.os_build); p("arch", o.os_arch);
        printf("  uname_after=[%s]\n", buf);
        free(o.os_name); free(o.os_version); free(o.os_major); free(o.os_minor);
        free(o.os_codename); free(o.os_platform); free(o.os_build); free(o.os_arch);
    }
    /* osd == NULL */
    { char b[64]; strcpy(b, "Linux x [A: 1.0]"); parse_uname_string(b, NULL);
      printf("NULLOSD uname_after=[%s]\n", b); }
    /* get_os_arch directly */
    { const char *h[] = {"nothing here","has i686 inside","x86_64 and i386","arm64","aarch64 x", "", NULL};
      for (int i = 0; h[i]; i++) { char b[128]; strcpy(b, h[i]); char *a = get_os_arch(b);
        printf("ARCH <%s> -> %s\n", h[i], a ? a : "NULL"); free(a); } }
    /* w_regexec */
    { int mm[8];
      printf("RX1=%d\n", w_regexec(NULL, "x", 2, mm));
      printf("RX2=%d\n", w_regexec("^a", NULL, 2, mm));
      fflush(stdout);
      printf("RX3=%d\n", w_regexec("^([0-9", "123", 2, mm));
      fflush(stdout);
      printf("RX4=%d\n", w_regexec("^([0-9]+)", "123abc", 2, mm));
      printf("  so=%d eo=%d so1=%d eo1=%d\n", mm[0], mm[1], mm[2], mm[3]);
      printf("RX5=%d\n", w_regexec("^zzz", "123abc", 2, mm)); }
    return 0;
}
