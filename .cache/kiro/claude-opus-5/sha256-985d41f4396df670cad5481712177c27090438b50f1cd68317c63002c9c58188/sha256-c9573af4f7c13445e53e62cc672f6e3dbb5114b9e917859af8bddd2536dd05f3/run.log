        true
    } else if c.status.crashed() {
        false
    } else {
        c.ret != r.ret || c.err != r.err || c.buf != r.buf
    };

    if !diverged {
        if c.status.crashed() {
            t.both_crashed += 1;
        } else {
            t.matched += 1;
        }
        return;
    }

    // The Rust must never be worse than the C.
    if !c.status.crashed() && r.status.crashed() {
        panic!(
            "[{label}] Rust crashed ({:?}) where the C returned normally\\n  input({}) = {:02x?}",
            r.status,
            stream.len(),
            stream
        );
    }

    match lens_overrun(stream, out_len, ob) {
        Some(true) => t.c_ub += 1,
        Some(false) => panic!(
