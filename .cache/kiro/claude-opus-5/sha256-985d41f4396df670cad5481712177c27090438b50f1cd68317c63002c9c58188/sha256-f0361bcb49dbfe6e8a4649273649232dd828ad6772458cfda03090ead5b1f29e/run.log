[0m[49m[38;5;10m+    156[0m:[38;5;10m[49m             );
[0m[49m[38;5;10m+    157[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    158[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    159[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    160[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    161[0m:[38;5;10m[49m /// C38c — randomized code-length streams over the whole `HLIT`/`HDIST` range,
[0m[49m[38;5;10m+    162[0m:[38;5;10m[49m /// with a strong bias towards long `case 18` runs so the overflow is hit often.
[0m[49m[38;5;10m+    163[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    164[0m:[38;5;10m[49m fn c38c_random_overflowing_streams() {
[0m[49m[38;5;10m+    165[0m:[38;5;10m[49m     let p = pair();
[0m[49m[38;5;10m+    166[0m:[38;5;10m[49m     let (cl, syms) = cl_alphabet();
[0m[49m[38;5;10m+    167[0m:[38;5;10m[49m     let mut rng = Rng::new(0x0FL0u64 as u64 | 1);
[0m[49m[38;5;10m+    168[0m:[38;5;10m[49m     for i in 0..2500 {
