[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m                     sym: 18,
[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m                     extra_bits: 7,
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m                     extra_val: 127,
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m                 });
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m             let mut e = Enc::new();
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m             e.dynamic_header_raw(true, hlit, 32, &cl, &stream);
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m             for _ in 0..64 {
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m                 e.w.bits(0xFF, 8);
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m             let input = e.finish();
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m             drive(
[0m[49m[38;5;10m+    236[0m:[38;5;10m[49m                 &p,
[0m[49m[38;5;10m+    237[0m:[38;5;10m[49m                 &format!("C38d/rep={rep},hlit={hlit},sha={:016x}", fnv(&input)),
[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m                 &input,
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m                 4096,
[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m             );
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m /// C38e — a *valid* dynamic block whose code-length stream ends with a `case 18`
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m /// run that overshoots `nlit + ndst` by only a few bytes, i.e. the overflow is
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m /// small enough to stay inside `lenlens[]` (harmless) and must still decode
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m /// successfully in both libraries.
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m fn c38e_small_harmless_overshoot() {
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m     let p = pair();
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m     let (cl, _) = cl_alphabet();
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m     let mut successes = 0usize;
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m     for hlit in [257usize, 260, 280, 288] {
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m         for hdist in [1usize, 8, 32] {
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m             let total = hlit + hdist;
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m             // lengths: symbol 1 for the first `k`, then zeros to the end
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m             for overshoot in [1usize, 3, 8, 15, 18] {
[0m[49m[38;5;10m+    259[0m:[38;5;10m[49m                 let zeros_needed = total.saturating_sub(2) + overshoot;
[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m                 if zeros_needed < 11 {
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m                     continue;
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    263[0m:[38;5;10m[49m                 let mut stream: Vec<ClSym> = vec![
[0m[49m[38;5;10m+    264[0m:[38;5;10m[49m                     ClSym { sym: 1, extra_bits: 0, extra_val: 0 },
[0m[49m[38;5;10m+    265[0m:[38;5;10m[49m                     ClSym { sym: 1, extra_bits: 0, extra_val: 0 },
[0m[49m[38;5;10m+    266[0m:[38;5;10m[49m                 ];
[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m                 let mut left = zeros_needed;
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m                 while left > 0 {
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m                     let n = left.min(138).max(11);
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m                     stream.push(ClSym {
[0m[49m[38;5;10m+    271[0m:[38;5;10m[49m                         sym: 18,
[0m[49m[38;5;10m+    272[0m:[38;5;10m[49m                         extra_bits: 7,
[0m[49m[38;5;10m+    273[0m:[38;5;10m[49m                         extra_val: (n - 11) as u32,
[0m[49m[38;5;10m+    274[0m:[38;5;10m[49m                     });
[0m[49m[38;5;10m+    275[0m:[38;5;10m[49m                     left = left.saturating_sub(n);
[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    277[0m:[38;5;10m[49m                 let mut e = Enc::new();
[0m[49m[38;5;10m+    278[0m:[38;5;10m[49m                 e.dynamic_header_raw(true, hlit, hdist, &cl, &stream);
[0m[49m[38;5;10m+    279[0m:[38;5;10m[49m                 // two length-1 literal symbols exist: codes 0 and 1.
[0m[49m[38;5;10m+    280[0m:[38;5;10m[49m                 // symbol 0 is literal 0x00, symbol 1 is literal 0x01... but only
[0m[49m[38;5;10m+    281[0m:[38;5;10m[49m                 // if they land in the literal alphabet. Emit a few bits then stop.
[0m[49m[38;5;10m+    282[0m:[38;5;10m[49m                 for _ in 0..16 {
[0m[49m[38;5;10m+    283[0m:[38;5;10m[49m                     e.w.bits(0xFF, 8);
[0m[49m[38;5;10m+    284[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    285[0m:[38;5;10m[49m                 let input = e.finish();
[0m[49m[38;5;10m+    286[0m:[38;5;10m[49m                 let tag = format!(
