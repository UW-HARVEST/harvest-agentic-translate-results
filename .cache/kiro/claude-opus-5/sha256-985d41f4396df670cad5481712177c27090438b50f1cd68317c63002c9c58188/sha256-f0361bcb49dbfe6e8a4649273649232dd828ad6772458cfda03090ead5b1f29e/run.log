[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m             out_bytes,
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m /// C38d — `case 16` as the very first code-length symbol, so `lens[-1]` is read.
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m /// In the C that byte is the most-significant byte of the spilled `s` pointer
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m /// (a heap address), i.e. `0x00`. If the Rust modelled it as anything else, the
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m /// resulting literal tree would differ and the decoded output would diverge.
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m fn c38d_lens_minus_one_is_read() {
[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m     let p = pair();
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m     let (cl, _) = cl_alphabet();
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m     for rep in 0..4usize {
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m         for hlit in [257usize, 270, 288] {
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m             let mut stream: Vec<ClSym> = vec![ClSym {
[0m[49m[38;5;10m+    216[0m:[38;5;10m[49m                 // repeat lens[-1] three to six times, at n == 0
[0m[49m[38;5;10m+    217[0m:[38;5;10m[49m                 sym: 16,
[0m[49m[38;5;10m+    218[0m:[38;5;10m[49m                 extra_bits: 2,
[0m[49m[38;5;10m+    219[0m:[38;5;10m[49m                 extra_val: rep as u32,
[0m[49m[38;5;10m+    220[0m:[38;5;10m[49m             }];
[0m[49m[38;5;10m+    221[0m:[38;5;10m[49m             // then fill the rest with something decodable
[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m             for _ in 0..400 {
