[0m[49m[38;5;10m+    182[0m:[38;5;10m[49m                 extra_bits: eb,
[0m[49m[38;5;10m+    183[0m:[38;5;10m[49m                 extra_val: ev,
[0m[49m[38;5;10m+    184[0m:[38;5;10m[49m             });
[0m[49m[38;5;10m+    185[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    186[0m:[38;5;10m[49m         let mut e = Enc::new();
[0m[49m[38;5;10m+    187[0m:[38;5;10m[49m         e.dynamic_header_raw(true, hlit, hdist, &cl, &stream);
[0m[49m[38;5;10m+    188[0m:[38;5;10m[49m         for _ in 0..32 {
[0m[49m[38;5;10m+    189[0m:[38;5;10m[49m             e.w.bits(rng.u8() as u32, 8);
[0m[49m[38;5;10m+    190[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    191[0m:[38;5;10m[49m         let input = e.finish();
[0m[49m[38;5;10m+    192[0m:[38;5;10m[49m         let out_bytes = *[0i32, 1, 64, 4096].get(rng.below(4)).unwrap();
[0m[49m[38;5;10m+    193[0m:[38;5;10m[49m         drive(
[0m[49m[38;5;10m+    194[0m:[38;5;10m[49m             &p,
[0m[49m[38;5;10m+    195[0m:[38;5;10m[49m             &format!(
[0m[49m[38;5;10m+    196[0m:[38;5;10m[49m                 "C38c/#{i} hlit={hlit},hdist={hdist},out={out_bytes},sha={:016x}",
