[0m[49m[38;5;10m+    176[0m:[38;5;10m[49m                 17 => (3u32, rng.below(8) as u32),
[0m[49m[38;5;10m+    177[0m:[38;5;10m[49m                 18 => (7u32, rng.below(128) as u32),
[0m[49m[38;5;10m+    178[0m:[38;5;10m[49m                 _ => (0u32, 0u32),
[0m[49m[38;5;10m+    179[0m:[38;5;10m[49m             };
[0m[49m[38;5;10m+    180[0m:[38;5;10m[49m             stream.push(ClSym {
