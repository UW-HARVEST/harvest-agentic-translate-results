[0m[49m[38;5;10m+    195[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    196[0m:[38;5;10m[49m // Deterministic pseudo-random test data
[0m[49m[38;5;10m+    197[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    198[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    199[0m:[38;5;10m[49m /// Small, fast, deterministic byte generator for test vectors (splitmix64).
[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m pub struct Rng(pub u64);
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m 
