def patch(path, mapping, header_label):
    lines = open(path).read().split("\n")
    out=[]
    for l in lines:
        m = re.match(r'^\| (\d+) \|(.*)\| \[ \] \|\s*$', l)
        if m:
            n=int(m.group(1))
            assert n in mapping, f"{path}: row {n} has no test"
            out.append(f"| {n} |{m.group(2)}| [x] `{mapping[n]}` |")
        elif l.startswith("| # |") and l.rstrip().endswith("| [ ] |"):
            out.append(l.rstrip()[:-6] + f"| {header_label} |")
        else:
            out.append(l)
    open(path,"w").write("\n".join(out))

