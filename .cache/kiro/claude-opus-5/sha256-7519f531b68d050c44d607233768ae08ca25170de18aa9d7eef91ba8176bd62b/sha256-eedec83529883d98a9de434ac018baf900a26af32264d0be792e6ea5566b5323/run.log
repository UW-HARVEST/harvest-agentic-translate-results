import random, subprocess
C="./c_src/build/driver"; R="./translation/target/release/driver"
def run(p, data):
    pr=subprocess.run([p], input=data, capture_output=True)
    return pr.stdout, pr.stderr, pr.returncode
cases=[]
# boundary numbers
for base in [0,1,2,127,128,255,256,32767,32768,65535,65536,
             2147483647,2147483648,4294967295,4294967296,
             1073741823,1073741824,1073741674,
             9223372036854775807,9223372036854775808,
             18446744073709551615,18446744073709551616]:
    for d in (-2,-1,0,1,2):
        for s in ("","-","+"):
            cases.append(f"{s}{base+d}".encode())
# whitespace / junk combos
ws=[b"", b" ", b"\t", b"\n", b"\r", b"\x0b", b"\x0c", b"  \n\t ", b"\n\n\n"]
tails=[b"", b"\n", b" ", b"abc", b".5", b"e5", b"\x00", b"\xff", b"-", b"+", b"999"]
for a in ws:
    for n in [b"", b"0", b"7", b"-7", b"+7", b"-", b"+", b"a", b"0x1f", b"00012", b"2147483648"]:
        for t in tails:
            cases.append(a+n+t)
# random bytes
rnd=random.Random(1234)
for _ in range(3000):
    n=rnd.randint(0,12)
    cases.append(bytes(rnd.choice(b" \t\n\r+-0123456789abcxX.\x00\xff") for _ in range(n)))
# random long digit strings
for _ in range(2000):
    L=rnd.randint(1,25)
    s=rnd.choice(["","-","+"])+"".join(rnd.choice("0123456789") for _ in range(L))
    cases.append(s.encode())
bad=0; seen=set()
for c in cases:
    if c in seen: continue
    seen.add(c)
    a=run(C,c); b=run(R,c)
    if a!=b:
        bad+=1
        print("DIFF", repr(c), "C=",a, "R=",b)
        if bad>25: break
print(f"checked {len(seen)} unique inputs, {bad} diffs")
EOF
