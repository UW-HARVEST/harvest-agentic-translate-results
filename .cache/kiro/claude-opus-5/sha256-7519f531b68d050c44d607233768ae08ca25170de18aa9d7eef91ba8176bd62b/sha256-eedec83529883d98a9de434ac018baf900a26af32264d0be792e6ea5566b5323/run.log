[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m         ("negative overflow threshold", b"-1073741824"),
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m         ("just inside negative", b"-1073741823"),
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m         ("deep negative", b"-1073741974"),
[0m[49m[38;5;10m+    263[0m:[38;5;10m[49m         ("x = 2^30 - 150", b"1073741674"),
[0m[49m[38;5;10m+    264[0m:[38;5;10m[49m     ] {
[0m[49m[38;5;10m+    265[0m:[38;5;10m[49m         assert_same(label, input);
[0m[49m[38;5;10m+    266[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m fn overflow_threshold_sweep() {
[0m[49m[38;5;10m+    271[0m:[38;5;10m[49m     // Walk the exact wraparound boundary one integer at a time, in both
[0m[49m[38;5;10m+    272[0m:[38;5;10m[49m     // directions, so an off-by-one in the wrapping arithmetic cannot hide.
[0m[49m[38;5;10m+    273[0m:[38;5;10m[49m     for x in 1_073_741_668i64..=1_073_741_680 {
[0m[49m[38;5;10m+    274[0m:[38;5;10m[49m         assert_same("positive overflow boundary", x.to_string().as_bytes());
[0m[49m[38;5;10m+    275[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m     for x in -1_073_741_830i64..=-1_073_741_818 {
[0m[49m[38;5;10m+    277[0m:[38;5;10m[49m         assert_same("negative overflow boundary", x.to_string().as_bytes());
[0m[49m[38;5;10m+    278[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    279[0m:[38;5;10m[49m }
