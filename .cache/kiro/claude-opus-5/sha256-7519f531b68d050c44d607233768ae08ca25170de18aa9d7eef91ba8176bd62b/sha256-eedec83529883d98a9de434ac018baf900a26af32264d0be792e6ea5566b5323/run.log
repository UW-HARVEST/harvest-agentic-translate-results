[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m fn arithmetic_overflow_wraps() {
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m     // 2*x + 300 overflows int for x >= 1073741674 and underflows for
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m     // x <= -1073741824. These straddle both thresholds.
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m     for (label, input) in [
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m         ("largest x with no overflow", &b"1073741673"[..]),
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m         ("first x that overflows", b"1073741674"),
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m         ("one past that", b"1073741675"),
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m         ("2^30", b"1073741824"),
