[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m             let ln = ((cap.b.x - cap.a.x).powi(2) + (cap.b.y - cap.a.y).powi(2)).sqrt();
[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m             let sgn = if side == 0 { 1.0f32 } else { -1.0f32 };
