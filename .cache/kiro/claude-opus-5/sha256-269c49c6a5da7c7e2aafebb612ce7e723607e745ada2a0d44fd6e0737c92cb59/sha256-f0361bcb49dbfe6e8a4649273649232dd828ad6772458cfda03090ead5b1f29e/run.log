[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m fn rows41_43_capsule_side_and_endcap() {
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m     let l = libs();
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m     let mut rng = Rng::new(0x4143);
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m     for side in 0..2 {
