[0m[49m[38;5;10m+    464[0m:[38;5;10m[49m         f32::from_bits(0x4222_2222),
[0m[49m[38;5;10m+    465[0m:[38;5;10m[49m         f32::from_bits(0x4333_3333),
[0m[49m[38;5;10m+    466[0m:[38;5;10m[49m         f32::from_bits(0x4444_4444),
[0m[49m[38;5;10m+    467[0m:[38;5;10m[49m         f32::from_bits(0x4555_5555),
[0m[49m[38;5;10m+    468[0m:[38;5;10m[49m         f32::from_bits(0x4666_6666),
[0m[49m[38;5;10m+    469[0m:[38;5;10m[49m         f32::from_bits(0x4777_7777),
[0m[49m[38;5;10m+    470[0m:[38;5;10m[49m         f32::from_bits(0x4888_8888),
[0m[49m[38;5;10m+    471[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    472[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    473[0m:[38;5;10m[49m     let mut rounds: Vec<[f32; 8]> = vec![sentinels];
[0m[49m[38;5;10m+    474[0m:[38;5;10m[49m     // Rotations of the sentinels so each value visits each field position.
[0m[49m[38;5;10m+    475[0m:[38;5;10m[49m     for shift in 1..8 {
[0m[49m[38;5;10m+    476[0m:[38;5;10m[49m         let mut r = [0f32; 8];
[0m[49m[38;5;10m+    477[0m:[38;5;10m[49m         for i in 0..8 {
[0m[49m[38;5;10m+    478[0m:[38;5;10m[49m             r[i] = sentinels[(i + shift) % 8];
[0m[49m[38;5;10m+    479[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    480[0m:[38;5;10m[49m         rounds.push(r);
[0m[49m[38;5;10m+    481[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    482[0m:[38;5;10m[49m     for _ in 0..3000 {
[0m[49m[38;5;10m+    483[0m:[38;5;10m[49m         let mut r = [0f32; 8];
[0m[49m[38;5;10m+    484[0m:[38;5;10m[49m         for i in 0..8 {
[0m[49m[38;5;10m+    485[0m:[38;5;10m[49m             r[i] = rng.any_bits();
[0m[49m[38;5;10m+    486[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    487[0m:[38;5;10m[49m         rounds.push(r);
[0m[49m[38;5;10m+    488[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    489[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    490[0m:[38;5;10m[49m     for s in rounds {
