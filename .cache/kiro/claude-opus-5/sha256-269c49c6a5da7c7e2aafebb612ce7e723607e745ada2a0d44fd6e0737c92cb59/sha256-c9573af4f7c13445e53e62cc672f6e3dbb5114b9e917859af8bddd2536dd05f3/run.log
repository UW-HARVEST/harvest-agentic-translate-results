[0m[49m[38;5;10m+     36[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     37[0m:[38;5;10m[49m # Full power set of the optional features (skipped entirely when there are none).
[0m[49m[38;5;10m+     38[0m:[38;5;10m[49m n=${#FEATURES[@]}
[0m[49m[38;5;10m+     39[0m:[38;5;10m[49m if [ "$n" -gt 0 ]; then
[0m[49m[38;5;10m+     40[0m:[38;5;10m[49m   total=$((1 << n))
[0m[49m[38;5;10m+     41[0m:[38;5;10m[49m   for ((mask = 0; mask < total; mask++)); do
[0m[49m[38;5;10m+     42[0m:[38;5;10m[49m     sel=()
