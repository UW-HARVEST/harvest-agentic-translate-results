[0m[49m[38;5;10m+    493[0m:[38;5;10m[49m         let m = c2m { x: a, y: b };
[0m[49m[38;5;10m+    494[0m:[38;5;10m[49m         let ray = c2Ray { p: a, d: b, t: s[4] };
[0m[49m[38;5;10m+    495[0m:[38;5;10m[49m         let circ = c2Circle { p: c2v { x: s[5], y: s[6] }, r: s[7] };
[0m[49m[38;5;10m+    496[0m:[38;5;10m[49m         let box_ = c2AABB { min: c2v { x: s[4], y: s[5] }, max: c2v { x: s[6], y: s[7] } };
[0m[49m[38;5;10m+    497[0m:[38;5;10m[49m         let cap = c2Capsule {
[0m[49m[38;5;10m+    498[0m:[38;5;10m[49m             a: c2v { x: s[4], y: s[5] },
[0m[49m[38;5;10m+    499[0m:[38;5;10m[49m             b: c2v { x: s[6], y: s[7] },
[0m[49m[38;5;10m+    500[0m:[38;5;10m[49m             r: s[0],
[0m[49m[38;5;10m+    501[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+    502[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    503[0m:[38;5;10m[49m         // 8-byte SSE struct in, 8-byte SSE struct out.
[0m[49m[38;5;10m+    504[0m:[38;5;10m[49m         d.check_v(unsafe { (l.c.c2V)(s[0], s[1]) }, unsafe { (l.r.c2V)(s[0], s[1]) }, || "abi c2V".into());
[0m[49m[38;5;10m+    505[0m:[38;5;10m[49m         for (name, f_c, f_r) in [
[0m[49m[38;5;10m+    506[0m:[38;5;10m[49m             ("c2Skew", l.c.c2Skew, l.r.c2Skew),
[0m[49m[38;5;10m+    507[0m:[38;5;10m[49m             ("c2Absv", l.c.c2Absv, l.r.c2Absv),
[0m[49m[38;5;10m+    508[0m:[38;5;10m[49m             ("c2CCW90", l.c.c2CCW90, l.r.c2CCW90),
[0m[49m[38;5;10m+    509[0m:[38;5;10m[49m             ("c2Norm", l.c.c2Norm, l.r.c2Norm),
[0m[49m[38;5;10m+    510[0m:[38;5;10m[49m         ] {
[0m[49m[38;5;10m+    511[0m:[38;5;10m[49m             d.check_v(unsafe { f_c(a) }, unsafe { f_r(a) }, || format!("abi {name}({})", fmt_v(a)));
[0m[49m[38;5;10m+    512[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    513[0m:[38;5;10m[49m         for (name, f_c, f_r) in [
[0m[49m[38;5;10m+    514[0m:[38;5;10m[49m             ("c2Add", l.c.c2Add, l.r.c2Add),
[0m[49m[38;5;10m+    515[0m:[38;5;10m[49m             ("c2Sub", l.c.c2Sub, l.r.c2Sub),
[0m[49m[38;5;10m+    516[0m:[38;5;10m[49m             ("c2Minv", l.c.c2Minv, l.r.c2Minv),
[0m[49m[38;5;10m+    517[0m:[38;5;10m[49m             ("c2Maxv", l.c.c2Maxv, l.r.c2Maxv),
