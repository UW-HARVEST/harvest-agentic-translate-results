[0m[49m[38;5;10m+    353[0m:[38;5;10m[49m /// Row 26 — the SAT rejection: ray bbox overlaps the box but the ray line misses.
[0m[49m[38;5;10m+    354[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    355[0m:[38;5;10m[49m fn cfg_26_raytoaabb_sat_reject() {
[0m[49m[38;5;10m+    356[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 26);
[0m[49m[38;5;10m+    357[0m:[38;5;10m[49m     let mut cases = Vec::new();
[0m[49m[38;5;10m+    358[0m:[38;5;10m[49m     let mut tries = 0;
[0m[49m[38;5;10m+    359[0m:[38;5;10m[49m     while cases.len() < N && tries < N * 60 {
[0m[49m[38;5;10m+    360[0m:[38;5;10m[49m         tries += 1;
[0m[49m[38;5;10m+    361[0m:[38;5;10m[49m         let b = rand_box(&mut rng);
[0m[49m[38;5;10m+    362[0m:[38;5;10m[49m         // A ray from one corner region of the box's bbox to the diagonally
[0m[49m[38;5;10m+    363[0m:[38;5;10m[49m         // opposite one, offset so the line passes outside a corner.
[0m[49m[38;5;10m+    364[0m:[38;5;10m[49m         let origin = c2v {
[0m[49m[38;5;10m+    365[0m:[38;5;10m[49m             x: rng.range(b.min.x - 20.0, b.max.x + 20.0),
[0m[49m[38;5;10m+    366[0m:[38;5;10m[49m             y: rng.range(b.min.y - 20.0, b.max.y + 20.0),
[0m[49m[38;5;10m+    367[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+    368[0m:[38;5;10m[49m         let target = c2v {
