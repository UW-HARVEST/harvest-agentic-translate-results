[0m[49m[38;5;10m+    298[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    299[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    300[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    301[0m:[38;5;10m[49m /// Row 25 — axis-aligned rays: `da == db` on two planes ⇒ the `d != 0` guard in
[0m[49m[38;5;10m+    302[0m:[38;5;10m[49m /// `c2RayToPlane_OneDimensional`.
[0m[49m[38;5;10m+    303[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    304[0m:[38;5;10m[49m fn cfg_25_raytoaabb_axis_aligned() {
[0m[49m[38;5;10m+    305[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 25);
[0m[49m[38;5;10m+    306[0m:[38;5;10m[49m     let mut cases = Vec::new();
[0m[49m[38;5;10m+    307[0m:[38;5;10m[49m     let dirs = [
[0m[49m[38;5;10m+    308[0m:[38;5;10m[49m         c2v { x: 1.0, y: 0.0 },
[0m[49m[38;5;10m+    309[0m:[38;5;10m[49m         c2v { x: -1.0, y: 0.0 },
[0m[49m[38;5;10m+    310[0m:[38;5;10m[49m         c2v { x: 0.0, y: 1.0 },
[0m[49m[38;5;10m+    311[0m:[38;5;10m[49m         c2v { x: 0.0, y: -1.0 },
[0m[49m[38;5;10m+    312[0m:[38;5;10m[49m         c2v { x: 1.0, y: -0.0 },
[0m[49m[38;5;10m+    313[0m:[38;5;10m[49m         c2v { x: -0.0, y: 1.0 },
[0m[49m[38;5;10m+    314[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    315[0m:[38;5;10m[49m     for _ in 0..(N / dirs.len() + 1) {
[0m[49m[38;5;10m+    316[0m:[38;5;10m[49m         let b = rand_box(&mut rng);
[0m[49m[38;5;10m+    317[0m:[38;5;10m[49m         let cx = (b.min.x + b.max.x) * 0.5;
[0m[49m[38;5;10m+    318[0m:[38;5;10m[49m         let cy = (b.min.y + b.max.y) * 0.5;
[0m[49m[38;5;10m+    319[0m:[38;5;10m[49m         for d in dirs {
