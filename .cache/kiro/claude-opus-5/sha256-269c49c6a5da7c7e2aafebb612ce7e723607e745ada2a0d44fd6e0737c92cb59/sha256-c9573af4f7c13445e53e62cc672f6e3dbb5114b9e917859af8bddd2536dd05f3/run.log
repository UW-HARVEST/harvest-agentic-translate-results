[0m[49m[38;5;10m+    163[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    164[0m:[38;5;10m[49m /// Row 47 — the all-three-hit configuration (`ret == 7`) with the full output
[0m[49m[38;5;10m+    165[0m:[38;5;10m[49m /// triple written. Constructed, then confirmed by observing the C's return.
[0m[49m[38;5;10m+    166[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    167[0m:[38;5;10m[49m fn cfg_47_gen_ray_all_three_hit() {
[0m[49m[38;5;10m+    168[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 47);
[0m[49m[38;5;10m+    169[0m:[38;5;10m[49m     let mut d = Diff::new("row47 gen_ray all-three hit");
[0m[49m[38;5;10m+    170[0m:[38;5;10m[49m     let mut found = 0usize;
[0m[49m[38;5;10m+    171[0m:[38;5;10m[49m     let mut tries = 0usize;
[0m[49m[38;5;10m+    172[0m:[38;5;10m[49m     while found < N && tries < N * 400 {
[0m[49m[38;5;10m+    173[0m:[38;5;10m[49m         tries += 1;
[0m[49m[38;5;10m+    174[0m:[38;5;10m[49m         // Ray from left to right through the origin; put all three shapes on it.
[0m[49m[38;5;10m+    175[0m:[38;5;10m[49m         let mut p = Params::default();
[0m[49m[38;5;10m+    176[0m:[38;5;10m[49m         p.r_p_x = -100.0 + rng.range(-5.0, 5.0);
[0m[49m[38;5;10m+    177[0m:[38;5;10m[49m         p.r_p_y = rng.range(-1.0, 1.0);
[0m[49m[38;5;10m+    178[0m:[38;5;10m[49m         p.mp_x = 100.0 + rng.range(-5.0, 5.0);
[0m[49m[38;5;10m+    179[0m:[38;5;10m[49m         p.mp_y = p.r_p_y + rng.range(-0.5, 0.5);
[0m[49m[38;5;10m+    180[0m:[38;5;10m[49m         // Circle straddling the ray.
[0m[49m[38;5;10m+    181[0m:[38;5;10m[49m         p.c_p_x = rng.range(-60.0, -20.0);
[0m[49m[38;5;10m+    182[0m:[38;5;10m[49m         p.c_p_y = p.r_p_y + rng.range(-3.0, 3.0);
[0m[49m[38;5;10m+    183[0m:[38;5;10m[49m         p.c_r = rng.range(6.0, 15.0);
[0m[49m[38;5;10m+    184[0m:[38;5;10m[49m         // Capsule crossing the ray vertically.
[0m[49m[38;5;10m+    185[0m:[38;5;10m[49m         p.cap_a_x = rng.range(-10.0, 10.0);
[0m[49m[38;5;10m+    186[0m:[38;5;10m[49m         p.cap_a_y = p.r_p_y - rng.range(10.0, 30.0);
[0m[49m[38;5;10m+    187[0m:[38;5;10m[49m         p.cap_b_x = p.cap_a_x + rng.range(-2.0, 2.0);
[0m[49m[38;5;10m+    188[0m:[38;5;10m[49m         p.cap_b_y = p.r_p_y + rng.range(10.0, 30.0);
[0m[49m[38;5;10m+    189[0m:[38;5;10m[49m         p.cap_r = rng.range(2.0, 8.0);
[0m[49m[38;5;10m+    190[0m:[38;5;10m[49m         // Box straddling the ray further along.
[0m[49m[38;5;10m+    191[0m:[38;5;10m[49m         let cx = rng.range(30.0, 70.0);
[0m[49m[38;5;10m+    192[0m:[38;5;10m[49m         p.bb_min_x = cx - rng.range(5.0, 15.0);
[0m[49m[38;5;10m+    193[0m:[38;5;10m[49m         p.bb_max_x = cx + rng.range(5.0, 15.0);
[0m[49m[38;5;10m+    194[0m:[38;5;10m[49m         p.bb_min_y = p.r_p_y - rng.range(5.0, 15.0);
[0m[49m[38;5;10m+    195[0m:[38;5;10m[49m         p.bb_max_y = p.r_p_y + rng.range(5.0, 15.0);
[0m[49m[38;5;10m+    196[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    197[0m:[38;5;10m[49m         let r = check(&mut d, &p);
[0m[49m[38;5;10m+    198[0m:[38;5;10m[49m         if r == 7 {
[0m[49m[38;5;10m+    199[0m:[38;5;10m[49m             found += 1;
[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m     assert!(
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m         found > 100,
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m         "only {found} of {tries} constructed cases returned 7 (all three hit)"
[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m     eprintln!("    row47: {found} all-three-hit cases out of {tries}");
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m     d.finish();
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m /// Row 48 — every return code 0..=7 must be observed at least once, so each hit
[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m /// bit and each combination of hit bits is exercised.
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m fn cfg_48_gen_ray_all_return_codes() {
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 48);
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m     let mut d = Diff::new("row48 gen_ray all return codes");
[0m[49m[38;5;10m+    216[0m:[38;5;10m[49m     let mut hist = [0usize; 8];
[0m[49m[38;5;10m+    217[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    218[0m:[38;5;10m[49m     // Broad sweep at several spatial scales to make every combination appear.
[0m[49m[38;5;10m+    219[0m:[38;5;10m[49m     for spread in [3.0f32, 10.0, 40.0, 150.0, 600.0] {
[0m[49m[38;5;10m+    220[0m:[38;5;10m[49m         for _ in 0..N {
[0m[49m[38;5;10m+    221[0m:[38;5;10m[49m             let p = rand_params(&mut rng, spread);
[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m             let r = check(&mut d, &p);
[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m             if (0..8).contains(&r) {
[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m                 hist[r as usize] += 1;
[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m     // Targeted single-shape configurations: park the other two shapes far away.
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m     for _ in 0..N {
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m         let mut p = rand_params(&mut rng, 40.0);
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m         let far = 1.0e5;
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m         // circle only
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m         let mut q = p;
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m         q.cap_a_x = far;
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m         q.cap_a_y = far;
[0m[49m[38;5;10m+    236[0m:[38;5;10m[49m         q.cap_b_x = far + 10.0;
[0m[49m[38;5;10m+    237[0m:[38;5;10m[49m         q.cap_b_y = far;
[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m         q.bb_min_x = -far;
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m         q.bb_min_y = -far;
[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m         q.bb_max_x = -far + 1.0;
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m         q.bb_max_y = -far + 1.0;
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m         let r = check(&mut d, &q);
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m         if (0..8).contains(&r) {
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m             hist[r as usize] += 1;
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m         // capsule only
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m         let mut q = p;
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m         q.c_p_x = far;
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m         q.c_p_y = far;
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m         q.c_r = 0.001;
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m         q.bb_min_x = -far;
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m         q.bb_min_y = -far;
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m         q.bb_max_x = -far + 1.0;
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m         q.bb_max_y = -far + 1.0;
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m         let r = check(&mut d, &q);
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m         if (0..8).contains(&r) {
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m             hist[r as usize] += 1;
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    259[0m:[38;5;10m[49m         // box only
[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m         p.c_p_x = far;
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m         p.c_p_y = far;
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m         p.c_r = 0.001;
[0m[49m[38;5;10m+    263[0m:[38;5;10m[49m         p.cap_a_x = -far;
[0m[49m[38;5;10m+    264[0m:[38;5;10m[49m         p.cap_a_y = -far;
[0m[49m[38;5;10m+    265[0m:[38;5;10m[49m         p.cap_b_x = -far + 10.0;
[0m[49m[38;5;10m+    266[0m:[38;5;10m[49m         p.cap_b_y = -far;
[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m         p.cap_r = 0.001;
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m         let r = check(&mut d, &p);
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m         if (0..8).contains(&r) {
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m             hist[r as usize] += 1;
[0m[49m[38;5;10m+    271[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    272[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    273[0m:[38;5;10m[49m     eprintln!("    row48 return-code histogram: {hist:?}");
[0m[49m[38;5;10m+    274[0m:[38;5;10m[49m     for code in 0..8 {
[0m[49m[38;5;10m+    275[0m:[38;5;10m[49m         assert!(
[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m             hist[code] > 0,
[0m[49m[38;5;10m+    277[0m:[38;5;10m[49m             "gen_ray return code {code} was never produced (histogram {hist:?})"
[0m[49m[38;5;10m+    278[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    279[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    280[0m:[38;5;10m[49m     d.finish();
[0m[49m[38;5;10m+    281[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    282[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    283[0m:[38;5;10m[49m /// Row 49 — `mp == ray.p` ⇒ `c2Norm` of a zero vector ⇒ NaN direction and NaN
[0m[49m[38;5;10m+    284[0m:[38;5;10m[49m /// `ray.t` flowing through all three shapes.
[0m[49m[38;5;10m+    285[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    286[0m:[38;5;10m[49m fn cfg_49_gen_ray_degenerate_ray() {
[0m[49m[38;5;10m+    287[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 49);
[0m[49m[38;5;10m+    288[0m:[38;5;10m[49m     let mut d = Diff::new("row49 gen_ray degenerate ray");
[0m[49m[38;5;10m+    289[0m:[38;5;10m[49m     for _ in 0..N {
[0m[49m[38;5;10m+    290[0m:[38;5;10m[49m         let mut p = rand_params(&mut rng, 40.0);
[0m[49m[38;5;10m+    291[0m:[38;5;10m[49m         // Exactly coincident mouse point and ray origin.
[0m[49m[38;5;10m+    292[0m:[38;5;10m[49m         p.mp_x = p.r_p_x;
[0m[49m[38;5;10m+    293[0m:[38;5;10m[49m         p.mp_y = p.r_p_y;
[0m[49m[38;5;10m+    294[0m:[38;5;10m[49m         check(&mut d, &p);
[0m[49m[38;5;10m+    295[0m:[38;5;10m[49m         // Signed-zero variants of the same coincidence.
[0m[49m[38;5;10m+    296[0m:[38;5;10m[49m         let mut q = p;
[0m[49m[38;5;10m+    297[0m:[38;5;10m[49m         q.mp_x = -p.r_p_x * 0.0;
[0m[49m[38;5;10m+    298[0m:[38;5;10m[49m         q.r_p_x = 0.0;
[0m[49m[38;5;10m+    299[0m:[38;5;10m[49m         q.mp_y = 0.0;
[0m[49m[38;5;10m+    300[0m:[38;5;10m[49m         q.r_p_y = -0.0;
[0m[49m[38;5;10m+    301[0m:[38;5;10m[49m         check(&mut d, &q);
[0m[49m[38;5;10m+    302[0m:[38;5;10m[49m         // One component coincident only (direction has a zero component).
[0m[49m[38;5;10m+    303[0m:[38;5;10m[49m         let mut s = rand_params(&mut rng, 40.0);
[0m[49m[38;5;10m+    304[0m:[38;5;10m[49m         s.mp_y = s.r_p_y;
[0m[49m[38;5;10m+    305[0m:[38;5;10m[49m         check(&mut d, &s);
[0m[49m[38;5;10m+    306[0m:[38;5;10m[49m         let mut u = rand_params(&mut rng, 40.0);
[0m[49m[38;5;10m+    307[0m:[38;5;10m[49m         u.mp_x = u.r_p_x;
[0m[49m[38;5;10m+    308[0m:[38;5;10m[49m         check(&mut d, &u);
[0m[49m[38;5;10m+    309[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    310[0m:[38;5;10m[49m     d.finish();
[0m[49m[38;5;10m+    311[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    312[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    313[0m:[38;5;10m[49m /// Row 50 — every special float class injected into each of the 16 parameters
[0m[49m[38;5;10m+    314[0m:[38;5;10m[49m /// in turn, on top of an otherwise-hitting configuration.
[0m[49m[38;5;10m+    315[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    316[0m:[38;5;10m[49m fn cfg_50_gen_ray_special_field_sweep() {
[0m[49m[38;5;10m+    317[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 50);
[0m[49m[38;5;10m+    318[0m:[38;5;10m[49m     let mut d = Diff::new("row50 gen_ray special field sweep");
[0m[49m[38;5;10m+    319[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    320[0m:[38;5;10m[49m     let mut inject: Vec<f32> = SPECIALS.to_vec();
[0m[49m[38;5;10m+    321[0m:[38;5;10m[49m     inject.extend(NAN_BITS.iter().map(|&b| f32::from_bits(b)));
[0m[49m[38;5;10m+    322[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    323[0m:[38;5;10m[49m     // Several distinct base configurations so the injection lands on different
[0m[49m[38;5;10m+    324[0m:[38;5;10m[49m     // code paths.
[0m[49m[38;5;10m+    325[0m:[38;5;10m[49m     let bases: Vec<Params> = (0..12).map(|_| rand_params(&mut rng, 40.0)).collect();
[0m[49m[38;5;10m+    326[0m:[38;5;10m[49m     for base in &bases {
[0m[49m[38;5;10m+    327[0m:[38;5;10m[49m         for &s in &inject {
[0m[49m[38;5;10m+    328[0m:[38;5;10m[49m             for field in 0..16 {
[0m[49m[38;5;10m+    329[0m:[38;5;10m[49m                 let mut p = *base;
[0m[49m[38;5;10m+    330[0m:[38;5;10m[49m                 p.set(field, s);
[0m[49m[38;5;10m+    331[0m:[38;5;10m[49m                 check(&mut d, &p);
[0m[49m[38;5;10m+    332[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    333[0m:[38;5;10m[49m             // Two fields at once, to catch interaction (e.g. NaN in both the
[0m[49m[38;5;10m+    334[0m:[38;5;10m[49m             // capsule endpoints, or both box corners).
[0m[49m[38;5;10m+    335[0m:[38;5;10m[49m             for (f1, f2) in [(0, 2), (1, 3), (7, 9), (8, 10), (12, 14), (13, 15), (6, 11)] {
