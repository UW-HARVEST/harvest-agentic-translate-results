[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m         let b = rand_box(&mut rng);
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m         let corners = [
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m             c2v { x: b.min.x, y: b.min.y },
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m             c2v { x: b.max.x, y: b.min.y },
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m             c2v { x: b.min.x, y: b.max.y },
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m             c2v { x: b.max.x, y: b.max.y },
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m         ];
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m         for corner in corners {
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m             let cx = (b.min.x + b.max.x) * 0.5;
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m             let cy = (b.min.y + b.max.y) * 0.5;
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m             // Fire straight through the corner from outside, along the diagonal.
[0m[49m[38;5;10m+    259[0m:[38;5;10m[49m             let dx = corner.x - cx;
[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m             let dy = corner.y - cy;
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m             let origin = c2v {
