[0m[49m[38;5;10m+     51[0m:[38;5;10m[49m       COMBOS+=("default+:$joined|--features $joined")
[0m[49m[38;5;10m+     52[0m:[38;5;10m[49m     fi
[0m[49m[38;5;10m+     53[0m:[38;5;10m[49m   done
[0m[49m[38;5;10m+     54[0m:[38;5;10m[49m fi
