[0m[49m[38;5;10m+    358[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    359[0m:[38;5;10m[49m /// Row 38 — capsule axis orientation sweep: all 8 octants plus the 4
[0m[49m[38;5;10m+    360[0m:[38;5;10m[49m /// axis-aligned directions, so `M` covers every sign combination (and
[0m[49m[38;5;10m+    361[0m:[38;5;10m[49m /// `c2CCW90` / `c2Skew(M.y)` sign handling is exercised in each).
[0m[49m[38;5;10m+    362[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    363[0m:[38;5;10m[49m fn cfg_38_raytocapsule_axis_orientations() {
[0m[49m[38;5;10m+    364[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 38);
[0m[49m[38;5;10m+    365[0m:[38;5;10m[49m     let mut cases = Vec::new();
[0m[49m[38;5;10m+    366[0m:[38;5;10m[49m     let dirs: [(f32, f32); 12] = [
[0m[49m[38;5;10m+    367[0m:[38;5;10m[49m         (1.0, 0.0),
[0m[49m[38;5;10m+    368[0m:[38;5;10m[49m         (0.0, 1.0),
[0m[49m[38;5;10m+    369[0m:[38;5;10m[49m         (-1.0, 0.0),
[0m[49m[38;5;10m+    370[0m:[38;5;10m[49m         (0.0, -1.0),
[0m[49m[38;5;10m+    371[0m:[38;5;10m[49m         (1.0, 1.0),
[0m[49m[38;5;10m+    372[0m:[38;5;10m[49m         (-1.0, 1.0),
[0m[49m[38;5;10m+    373[0m:[38;5;10m[49m         (1.0, -1.0),
[0m[49m[38;5;10m+    374[0m:[38;5;10m[49m         (-1.0, -1.0),
[0m[49m[38;5;10m+    375[0m:[38;5;10m[49m         (2.0, 1.0),
[0m[49m[38;5;10m+    376[0m:[38;5;10m[49m         (-1.0, 2.0),
[0m[49m[38;5;10m+    377[0m:[38;5;10m[49m         (1.0, -2.0),
[0m[49m[38;5;10m+    378[0m:[38;5;10m[49m         (-2.0, -1.0),
[0m[49m[38;5;10m+    379[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    380[0m:[38;5;10m[49m     for _ in 0..(N / dirs.len() + 1) {
[0m[49m[38;5;10m+    381[0m:[38;5;10m[49m         let a = rng.vec_coord();
[0m[49m[38;5;10m+    382[0m:[38;5;10m[49m         let len = rng.range(1.0, 40.0);
[0m[49m[38;5;10m+    383[0m:[38;5;10m[49m         let r = rng.radius();
[0m[49m[38;5;10m+    384[0m:[38;5;10m[49m         for (dx, dy) in dirs {
[0m[49m[38;5;10m+    385[0m:[38;5;10m[49m             let m = (dx * dx + dy * dy).sqrt();
[0m[49m[38;5;10m+    386[0m:[38;5;10m[49m             let cap = c2Capsule {
[0m[49m[38;5;10m+    387[0m:[38;5;10m[49m                 a,
[0m[49m[38;5;10m+    388[0m:[38;5;10m[49m                 b: c2v {
[0m[49m[38;5;10m+    389[0m:[38;5;10m[49m                     x: a.x + dx / m * len,
[0m[49m[38;5;10m+    390[0m:[38;5;10m[49m                     y: a.y + dy / m * len,
[0m[49m[38;5;10m+    391[0m:[38;5;10m[49m                 },
[0m[49m[38;5;10m+    392[0m:[38;5;10m[49m                 r,
[0m[49m[38;5;10m+    393[0m:[38;5;10m[49m             };
[0m[49m[38;5;10m+    394[0m:[38;5;10m[49m             // Fire from several directions around it.
[0m[49m[38;5;10m+    395[0m:[38;5;10m[49m             for k in 0..4 {
[0m[49m[38;5;10m+    396[0m:[38;5;10m[49m                 let ang = rng.range(0.0, 6.283_185_5) + k as f32 * 1.570_796_3;
[0m[49m[38;5;10m+    397[0m:[38;5;10m[49m                 let dist = rng.range(r, 100.0);
[0m[49m[38;5;10m+    398[0m:[38;5;10m[49m                 let mid = c2v {
[0m[49m[38;5;10m+    399[0m:[38;5;10m[49m                     x: (cap.a.x + cap.b.x) * 0.5,
[0m[49m[38;5;10m+    400[0m:[38;5;10m[49m                     y: (cap.a.y + cap.b.y) * 0.5,
[0m[49m[38;5;10m+    401[0m:[38;5;10m[49m                 };
[0m[49m[38;5;10m+    402[0m:[38;5;10m[49m                 let origin = c2v {
[0m[49m[38;5;10m+    403[0m:[38;5;10m[49m                     x: mid.x + dist * ang.cos(),
[0m[49m[38;5;10m+    404[0m:[38;5;10m[49m                     y: mid.y + dist * ang.sin(),
[0m[49m[38;5;10m+    405[0m:[38;5;10m[49m                 };
[0m[49m[38;5;10m+    406[0m:[38;5;10m[49m                 let s = rng.range(-0.3, 1.3);
[0m[49m[38;5;10m+    407[0m:[38;5;10m[49m                 let target = c2v {
[0m[49m[38;5;10m+    408[0m:[38;5;10m[49m                     x: cap.a.x + (cap.b.x - cap.a.x) * s + rng.range(-r * 2.0, r * 2.0),
[0m[49m[38;5;10m+    409[0m:[38;5;10m[49m                     y: cap.a.y + (cap.b.y - cap.a.y) * s + rng.range(-r * 2.0, r * 2.0),
[0m[49m[38;5;10m+    410[0m:[38;5;10m[49m                 };
[0m[49m[38;5;10m+    411[0m:[38;5;10m[49m                 cases.push((
[0m[49m[38;5;10m+    412[0m:[38;5;10m[49m                     c2Ray {
[0m[49m[38;5;10m+    413[0m:[38;5;10m[49m                         p: origin,
[0m[49m[38;5;10m+    414[0m:[38;5;10m[49m                         d: norm(origin, target),
[0m[49m[38;5;10m+    415[0m:[38;5;10m[49m                         t: rng.range(0.0, 250.0),
[0m[49m[38;5;10m+    416[0m:[38;5;10m[49m                     },
[0m[49m[38;5;10m+    417[0m:[38;5;10m[49m                     cap,
[0m[49m[38;5;10m+    418[0m:[38;5;10m[49m                 ));
[0m[49m[38;5;10m+    419[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    420[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    421[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    422[0m:[38;5;10m[49m     run_batch(
[0m[49m[38;5;10m+    423[0m:[38;5;10m[49m         "row38 c2RaytoCapsule axis orientations",
[0m[49m[38;5;10m+    424[0m:[38;5;10m[49m         cases,
[0m[49m[38;5;10m+    425[0m:[38;5;10m[49m         &[
[0m[49m[38;5;10m+    426[0m:[38;5;10m[49m             CapBranch::SideMx,
[0m[49m[38;5;10m+    427[0m:[38;5;10m[49m             CapBranch::SideSkew,
[0m[49m[38;5;10m+    428[0m:[38;5;10m[49m             CapBranch::EarlySlab,
[0m[49m[38;5;10m+    429[0m:[38;5;10m[49m             CapBranch::FallThrough,
[0m[49m[38;5;10m+    430[0m:[38;5;10m[49m         ],
[0m[49m[38;5;10m+    431[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    432[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    433[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    434[0m:[38;5;10m[49m /// Row 39 — reversed capsule (`b` before `a`) and the zero-length axis
[0m[49m[38;5;10m+    435[0m:[38;5;10m[49m /// (`a == b`) which makes `c2Norm` divide by zero ⇒ an all-NaN basis `M`.
[0m[49m[38;5;10m+    436[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    437[0m:[38;5;10m[49m fn cfg_39_raytocapsule_reversed_and_degenerate_axis() {
[0m[49m[38;5;10m+    438[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 39);
[0m[49m[38;5;10m+    439[0m:[38;5;10m[49m     let mut d = Diff::new("row39 c2RaytoCapsule reversed/degenerate axis");
[0m[49m[38;5;10m+    440[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    441[0m:[38;5;10m[49m     for _ in 0..N {
[0m[49m[38;5;10m+    442[0m:[38;5;10m[49m         let cap = rand_capsule(&mut rng);
[0m[49m[38;5;10m+    443[0m:[38;5;10m[49m         let rev = c2Capsule { a: cap.b, b: cap.a, r: cap.r };
[0m[49m[38;5;10m+    444[0m:[38;5;10m[49m         let (ray, _) = rand_case(&mut rng);
[0m[49m[38;5;10m+    445[0m:[38;5;10m[49m         for c in [cap, rev] {
[0m[49m[38;5;10m+    446[0m:[38;5;10m[49m             let (cr, co, rr, ro) = call(ray, c);
[0m[49m[38;5;10m+    447[0m:[38;5;10m[49m             d.check_ray(cr, co, rr, ro, || fmt_case(ray, c));
[0m[49m[38;5;10m+    448[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    449[0m:[38;5;10m[49m         // Zero-length axis in several flavours.
[0m[49m[38;5;10m+    450[0m:[38;5;10m[49m         let p = rng.vec_coord();
[0m[49m[38;5;10m+    451[0m:[38;5;10m[49m         for c in [
[0m[49m[38;5;10m+    452[0m:[38;5;10m[49m             c2Capsule { a: p, b: p, r: cap.r },
[0m[49m[38;5;10m+    453[0m:[38;5;10m[49m             c2Capsule {
[0m[49m[38;5;10m+    454[0m:[38;5;10m[49m                 a: p,
[0m[49m[38;5;10m+    455[0m:[38;5;10m[49m                 b: c2v { x: -p.x * 0.0 + p.x, y: p.y },
[0m[49m[38;5;10m+    456[0m:[38;5;10m[49m                 r: cap.r,
[0m[49m[38;5;10m+    457[0m:[38;5;10m[49m             },
[0m[49m[38;5;10m+    458[0m:[38;5;10m[49m             c2Capsule {
[0m[49m[38;5;10m+    459[0m:[38;5;10m[49m                 a: c2v { x: 0.0, y: 0.0 },
[0m[49m[38;5;10m+    460[0m:[38;5;10m[49m                 b: c2v { x: -0.0, y: -0.0 },
[0m[49m[38;5;10m+    461[0m:[38;5;10m[49m                 r: cap.r,
[0m[49m[38;5;10m+    462[0m:[38;5;10m[49m             },
[0m[49m[38;5;10m+    463[0m:[38;5;10m[49m             c2Capsule { a: p, b: p, r: 0.0 },
[0m[49m[38;5;10m+    464[0m:[38;5;10m[49m         ] {
[0m[49m[38;5;10m+    465[0m:[38;5;10m[49m             let (cr, co, rr, ro) = call(ray, c);
[0m[49m[38;5;10m+    466[0m:[38;5;10m[49m             d.check_ray(cr, co, rr, ro, || fmt_case(ray, c));
[0m[49m[38;5;10m+    467[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    468[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    469[0m:[38;5;10m[49m     d.finish();
[0m[49m[38;5;10m+    470[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    471[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    472[0m:[38;5;10m[49m /// Row 40 — `B.r` and `A.t` magnitude sweep, including 0 and inf.
[0m[49m[38;5;10m+    473[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    474[0m:[38;5;10m[49m fn cfg_40_raytocapsule_r_t_sweep() {
[0m[49m[38;5;10m+    475[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 40);
[0m[49m[38;5;10m+    476[0m:[38;5;10m[49m     let mut d = Diff::new("row40 c2RaytoCapsule r/t sweep");
[0m[49m[38;5;10m+    477[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    478[0m:[38;5;10m[49m     let rs: &[f32] = &[
[0m[49m[38;5;10m+    479[0m:[38;5;10m[49m         0.0, -0.0, 1e-45, 1e-20, 0.001, 1.0, 50.0, 1e20, f32::MAX,
[0m[49m[38;5;10m+    480[0m:[38;5;10m[49m         f32::INFINITY, -3.0, f32::NAN,
[0m[49m[38;5;10m+    481[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    482[0m:[38;5;10m[49m     let ts: &[f32] = &[
[0m[49m[38;5;10m+    483[0m:[38;5;10m[49m         0.0, -0.0, 1e-20, 1.0, 1e6, f32::MAX, f32::INFINITY, -5.0, f32::NAN,
[0m[49m[38;5;10m+    484[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    485[0m:[38;5;10m[49m     for _ in 0..(N / (rs.len() * ts.len()) + 2) {
[0m[49m[38;5;10m+    486[0m:[38;5;10m[49m         let base = rand_capsule(&mut rng);
[0m[49m[38;5;10m+    487[0m:[38;5;10m[49m         let (ray0, _) = rand_case(&mut rng);
[0m[49m[38;5;10m+    488[0m:[38;5;10m[49m         for &r in rs {
[0m[49m[38;5;10m+    489[0m:[38;5;10m[49m             let cap = c2Capsule { a: base.a, b: base.b, r };
[0m[49m[38;5;10m+    490[0m:[38;5;10m[49m             for &t in ts {
[0m[49m[38;5;10m+    491[0m:[38;5;10m[49m                 let ray = c2Ray { p: ray0.p, d: ray0.d, t };
[0m[49m[38;5;10m+    492[0m:[38;5;10m[49m                 let (cr, co, rr, ro) = call(ray, cap);
[0m[49m[38;5;10m+    493[0m:[38;5;10m[49m                 d.check_ray(cr, co, rr, ro, || fmt_case(ray, cap));
[0m[49m[38;5;10m+    494[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    495[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    496[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    497[0m:[38;5;10m[49m     d.finish();
[0m[49m[38;5;10m+    498[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    499[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    500[0m:[38;5;10m[49m /// Row 41 — `yAe.x == yAp.x` inside the else-branch ⇒ the UNGUARDED division by
[0m[49m[38;5;10m+    501[0m:[38;5;10m[49m /// zero in `t = (c - yAp.x) / d`. Reached when the ray direction is parallel to
[0m[49m[38;5;10m+    502[0m:[38;5;10m[49m /// the capsule axis (so its lateral component is exactly zero).
[0m[49m[38;5;10m+    503[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    504[0m:[38;5;10m[49m fn cfg_41_raytocapsule_parallel_div_zero() {
[0m[49m[38;5;10m+    505[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 41);
[0m[49m[38;5;10m+    506[0m:[38;5;10m[49m     let mut d = Diff::new("row41 c2RaytoCapsule parallel /0");
[0m[49m[38;5;10m+    507[0m:[38;5;10m[49m     let mut hit_div0 = 0usize;
[0m[49m[38;5;10m+    508[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    509[0m:[38;5;10m[49m     for _ in 0..N {
[0m[49m[38;5;10m+    510[0m:[38;5;10m[49m         let cap = rand_capsule(&mut rng);
[0m[49m[38;5;10m+    511[0m:[38;5;10m[49m         let axis = c2v { x: cap.b.x - cap.a.x, y: cap.b.y - cap.a.y };
[0m[49m[38;5;10m+    512[0m:[38;5;10m[49m         let alen = (axis.x * axis.x + axis.y * axis.y).sqrt();
[0m[49m[38;5;10m+    513[0m:[38;5;10m[49m         let (ux, uy) = (axis.x / alen, axis.y / alen);
[0m[49m[38;5;10m+    514[0m:[38;5;10m[49m         // Direction exactly parallel (and anti-parallel) to the axis, origin
[0m[49m[38;5;10m+    515[0m:[38;5;10m[49m         // offset laterally by more than r so `|yAp.x| >= r`.
[0m[49m[38;5;10m+    516[0m:[38;5;10m[49m         for sign in [1.0f32, -1.0] {
[0m[49m[38;5;10m+    517[0m:[38;5;10m[49m             for latmul in [1.01f32, 1.5, 3.0, 10.0] {
[0m[49m[38;5;10m+    518[0m:[38;5;10m[49m                 let lat = cap.r * latmul * if rng.bool() { 1.0 } else { -1.0 };
[0m[49m[38;5;10m+    519[0m:[38;5;10m[49m                 let s = rng.range(-2.0, 3.0);
[0m[49m[38;5;10m+    520[0m:[38;5;10m[49m                 let origin = c2v {
[0m[49m[38;5;10m+    521[0m:[38;5;10m[49m                     x: cap.a.x + axis.x * s + uy * lat,
[0m[49m[38;5;10m+    522[0m:[38;5;10m[49m                     y: cap.a.y + axis.y * s - ux * lat,
[0m[49m[38;5;10m+    523[0m:[38;5;10m[49m                 };
[0m[49m[38;5;10m+    524[0m:[38;5;10m[49m                 let ray = c2Ray {
[0m[49m[38;5;10m+    525[0m:[38;5;10m[49m                     p: origin,
[0m[49m[38;5;10m+    526[0m:[38;5;10m[49m                     d: c2v { x: ux * sign, y: uy * sign },
[0m[49m[38;5;10m+    527[0m:[38;5;10m[49m                     t: rng.range(0.0, 200.0),
[0m[49m[38;5;10m+    528[0m:[38;5;10m[49m                 };
[0m[49m[38;5;10m+    529[0m:[38;5;10m[49m                 // Detect the actual /0 using the C's own arithmetic.
[0m[49m[38;5;10m+    530[0m:[38;5;10m[49m                 let l = libs();
[0m[49m[38;5;10m+    531[0m:[38;5;10m[49m                 unsafe {
[0m[49m[38;5;10m+    532[0m:[38;5;10m[49m                     let My = (l.c.c2Norm)((l.c.c2Sub)(cap.b, cap.a));
[0m[49m[38;5;10m+    533[0m:[38;5;10m[49m                     let M = c2m { x: (l.c.c2CCW90)(My), y: My };
[0m[49m[38;5;10m+    534[0m:[38;5;10m[49m                     let yAp = (l.c.c2MulmvT)(M, (l.c.c2Sub)(ray.p, cap.a));
[0m[49m[38;5;10m+    535[0m:[38;5;10m[49m                     let yAd = (l.c.c2MulmvT)(M, ray.d);
[0m[49m[38;5;10m+    536[0m:[38;5;10m[49m                     let yAe = (l.c.c2Add)(yAp, (l.c.c2Mulvs)(yAd, ray.t));
[0m[49m[38;5;10m+    537[0m:[38;5;10m[49m                     if yAe.x - yAp.x == 0.0 {
