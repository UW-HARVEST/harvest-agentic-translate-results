[0m[49m[38;5;10m+    153[0m:[38;5;10m[49m     for _ in 0..N * 2 {
[0m[49m[38;5;10m+    154[0m:[38;5;10m[49m         let p = rand_params(&mut rng, 40.0);
[0m[49m[38;5;10m+    155[0m:[38;5;10m[49m         let r = check(&mut d, &p);
[0m[49m[38;5;10m+    156[0m:[38;5;10m[49m         if (0..8).contains(&r) {
[0m[49m[38;5;10m+    157[0m:[38;5;10m[49m             ret_hist[r as usize] += 1;
[0m[49m[38;5;10m+    158[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    159[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    160[0m:[38;5;10m[49m     eprintln!("    row46 return-code histogram: {ret_hist:?}");
[0m[49m[38;5;10m+    161[0m:[38;5;10m[49m     d.finish();
