[0m[49m[38;5;10m+     40[0m:[38;5;10m[49m         let b = (l.c.c2Dot)(m, ray.d);
[0m[49m[38;5;10m+     41[0m:[38;5;10m[49m         let disc = b * b - cc;
[0m[49m[38;5;10m+     42[0m:[38;5;10m[49m         (disc, -b - disc.sqrt())
[0m[49m[38;5;10m+     43[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     44[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     45[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     46[0m:[38;5;10m[49m /// `d` (the separating-axis value) as `c2RaytoAABB` computes it.
[0m[49m[38;5;10m+     47[0m:[38;5;10m[49m fn aabb_sat_d(ray: c2Ray, b: c2AABB) -> f32 {
[0m[49m[38;5;10m+     48[0m:[38;5;10m[49m     let l = libs();
[0m[49m[38;5;10m+     49[0m:[38;5;10m[49m     unsafe {
[0m[49m[38;5;10m+     50[0m:[38;5;10m[49m         let p0 = ray.p;
[0m[49m[38;5;10m+     51[0m:[38;5;10m[49m         let p1 = (l.c.c2Add)(ray.p, (l.c.c2Mulvs)(ray.d, ray.t));
[0m[49m[38;5;10m+     52[0m:[38;5;10m[49m         let ab = (l.c.c2Sub)(p1, p0);
[0m[49m[38;5;10m+     53[0m:[38;5;10m[49m         let n = (l.c.c2Skew)(ab);
[0m[49m[38;5;10m+     54[0m:[38;5;10m[49m         let abs_n = (l.c.c2Absv)(n);
[0m[49m[38;5;10m+     55[0m:[38;5;10m[49m         let half = (l.c.c2Mulvs)((l.c.c2Sub)(b.max, b.min), 0.5);
[0m[49m[38;5;10m+     56[0m:[38;5;10m[49m         let centre = (l.c.c2Mulvs)((l.c.c2Add)(b.min, b.max), 0.5);
[0m[49m[38;5;10m+     57[0m:[38;5;10m[49m         let dot = (l.c.c2Dot)(n, (l.c.c2Sub)(p0, centre));
[0m[49m[38;5;10m+     58[0m:[38;5;10m[49m         let adot = if dot < 0.0 { -dot } else { dot };
[0m[49m[38;5;10m+     59[0m:[38;5;10m[49m         adot - (l.c.c2Dot)(abs_n, half)
[0m[49m[38;5;10m+     60[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     61[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     62[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     63[0m:[38;5;10m[49m /// `c2RaytoAABB`'s ray bounding box, as the C builds it.
[0m[49m[38;5;10m+     64[0m:[38;5;10m[49m fn aabb_ray_box(ray: c2Ray) -> c2AABB {
[0m[49m[38;5;10m+     65[0m:[38;5;10m[49m     let l = libs();
[0m[49m[38;5;10m+     66[0m:[38;5;10m[49m     unsafe {
[0m[49m[38;5;10m+     67[0m:[38;5;10m[49m         let p1 = (l.c.c2Add)(ray.p, (l.c.c2Mulvs)(ray.d, ray.t));
[0m[49m[38;5;10m+     68[0m:[38;5;10m[49m         c2AABB {
[0m[49m[38;5;10m+     69[0m:[38;5;10m[49m             min: (l.c.c2Minv)(ray.p, p1),
[0m[49m[38;5;10m+     70[0m:[38;5;10m[49m             max: (l.c.c2Maxv)(ray.p, p1),
[0m[49m[38;5;10m+     71[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+     72[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     73[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     74[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     75[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+     76[0m:[38;5;10m[49m // c2RaytoCircle — rows 1-5
[0m[49m[38;5;10m+     77[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+     78[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     79[0m:[38;5;10m[49m /// Row 1 — `disc < 0`: the ray LINE misses the circle. Must return 0 and leave
[0m[49m[38;5;10m+     80[0m:[38;5;10m[49m /// `*out` untouched.
[0m[49m[38;5;10m+     81[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+     82[0m:[38;5;10m[49m fn err_01_circle_disc_negative() {
[0m[49m[38;5;10m+     83[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 1);
[0m[49m[38;5;10m+     84[0m:[38;5;10m[49m     let mut d = Diff::new("row01 circle disc < 0");
[0m[49m[38;5;10m+     85[0m:[38;5;10m[49m     let mut fired = 0usize;
[0m[49m[38;5;10m+     86[0m:[38;5;10m[49m     for _ in 0..4000 {
[0m[49m[38;5;10m+     87[0m:[38;5;10m[49m         let c = c2Circle {
[0m[49m[38;5;10m+     88[0m:[38;5;10m[49m             p: v(rng.coord(), rng.coord()),
[0m[49m[38;5;10m+     89[0m:[38;5;10m[49m             r: rng.range(0.1, 5.0),
[0m[49m[38;5;10m+     90[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+     91[0m:[38;5;10m[49m         // Direction perpendicular to the offset, origin far to the side: the
[0m[49m[38;5;10m+     92[0m:[38;5;10m[49m         // line passes well outside the circle.
[0m[49m[38;5;10m+     93[0m:[38;5;10m[49m         let off = rng.range(c.r * 3.0, c.r * 40.0) * if rng.bool() { 1.0 } else { -1.0 };
[0m[49m[38;5;10m+     94[0m:[38;5;10m[49m         let ray = c2Ray {
[0m[49m[38;5;10m+     95[0m:[38;5;10m[49m             p: v(c.p.x + off, c.p.y - 100.0),
[0m[49m[38;5;10m+     96[0m:[38;5;10m[49m             d: v(0.0, 1.0),
[0m[49m[38;5;10m+     97[0m:[38;5;10m[49m             t: 1000.0,
[0m[49m[38;5;10m+     98[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+     99[0m:[38;5;10m[49m         let (disc, _) = circle_internals(ray, c);
[0m[49m[38;5;10m+    100[0m:[38;5;10m[49m         if !(disc < 0.0) {
[0m[49m[38;5;10m+    101[0m:[38;5;10m[49m             continue;
[0m[49m[38;5;10m+    102[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    103[0m:[38;5;10m[49m         fired += 1;
[0m[49m[38;5;10m+    104[0m:[38;5;10m[49m         let (cr, co, rr, ro) = call_circle(ray, c);
[0m[49m[38;5;10m+    105[0m:[38;5;10m[49m         assert_eq!(cr, 0, "disc<0 must return 0");
[0m[49m[38;5;10m+    106[0m:[38;5;10m[49m         assert!(rc_eq(co, POISON), "disc<0 must leave *out untouched");
[0m[49m[38;5;10m+    107[0m:[38;5;10m[49m         d.check_ray(cr, co, rr, ro, || format!("disc={} ", fmt_f(disc)));
[0m[49m[38;5;10m+    108[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    109[0m:[38;5;10m[49m     assert!(fired > 1000, "row01 trigger fired only {fired} times");
[0m[49m[38;5;10m+    110[0m:[38;5;10m[49m     eprintln!("    row01: {fired} cases with disc < 0");
[0m[49m[38;5;10m+    111[0m:[38;5;10m[49m     d.finish();
[0m[49m[38;5;10m+    112[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    113[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    114[0m:[38;5;10m[49m /// Row 2 — `t < 0`: the ray line hits, but behind the origin.
[0m[49m[38;5;10m+    115[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    116[0m:[38;5;10m[49m fn err_02_circle_t_negative() {
[0m[49m[38;5;10m+    117[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 2);
[0m[49m[38;5;10m+    118[0m:[38;5;10m[49m     let mut d = Diff::new("row02 circle t < 0");
[0m[49m[38;5;10m+    119[0m:[38;5;10m[49m     let mut fired = 0usize;
[0m[49m[38;5;10m+    120[0m:[38;5;10m[49m     for _ in 0..4000 {
[0m[49m[38;5;10m+    121[0m:[38;5;10m[49m         let c = c2Circle {
[0m[49m[38;5;10m+    122[0m:[38;5;10m[49m             p: v(rng.coord(), rng.coord()),
[0m[49m[38;5;10m+    123[0m:[38;5;10m[49m             r: rng.range(0.5, 20.0),
[0m[49m[38;5;10m+    124[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+    125[0m:[38;5;10m[49m         // Origin PAST the circle, aiming further away: both roots are negative.
[0m[49m[38;5;10m+    126[0m:[38;5;10m[49m         let dist = c.r + rng.range(1.0, 50.0);
[0m[49m[38;5;10m+    127[0m:[38;5;10m[49m         let ray = c2Ray {
[0m[49m[38;5;10m+    128[0m:[38;5;10m[49m             p: v(c.p.x + dist, c.p.y),
[0m[49m[38;5;10m+    129[0m:[38;5;10m[49m             d: v(1.0, 0.0),
[0m[49m[38;5;10m+    130[0m:[38;5;10m[49m             t: 1000.0,
[0m[49m[38;5;10m+    131[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+    132[0m:[38;5;10m[49m         let (disc, t) = circle_internals(ray, c);
[0m[49m[38;5;10m+    133[0m:[38;5;10m[49m         if disc < 0.0 || !(t < 0.0) {
[0m[49m[38;5;10m+    134[0m:[38;5;10m[49m             continue;
[0m[49m[38;5;10m+    135[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    136[0m:[38;5;10m[49m         fired += 1;
[0m[49m[38;5;10m+    137[0m:[38;5;10m[49m         let (cr, co, rr, ro) = call_circle(ray, c);
[0m[49m[38;5;10m+    138[0m:[38;5;10m[49m         assert_eq!(cr, 0, "t<0 must return 0");
[0m[49m[38;5;10m+    139[0m:[38;5;10m[49m         assert!(rc_eq(co, POISON), "t<0 must leave *out untouched");
[0m[49m[38;5;10m+    140[0m:[38;5;10m[49m         d.check_ray(cr, co, rr, ro, || format!("t={}", fmt_f(t)));
[0m[49m[38;5;10m+    141[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    142[0m:[38;5;10m[49m     // Origin INSIDE the circle: t = -b - sqrt(disc) is negative there too.
[0m[49m[38;5;10m+    143[0m:[38;5;10m[49m     for _ in 0..4000 {
[0m[49m[38;5;10m+    144[0m:[38;5;10m[49m         let c = c2Circle {
[0m[49m[38;5;10m+    145[0m:[38;5;10m[49m             p: v(rng.coord(), rng.coord()),
[0m[49m[38;5;10m+    146[0m:[38;5;10m[49m             r: rng.range(1.0, 20.0),
[0m[49m[38;5;10m+    147[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+    148[0m:[38;5;10m[49m         let ang = rng.range(0.0, 6.283_185_5);
[0m[49m[38;5;10m+    149[0m:[38;5;10m[49m         let rr_ = rng.range(0.0, c.r * 0.9);
[0m[49m[38;5;10m+    150[0m:[38;5;10m[49m         let ray = c2Ray {
[0m[49m[38;5;10m+    151[0m:[38;5;10m[49m             p: v(c.p.x + rr_ * ang.cos(), c.p.y + rr_ * ang.sin()),
[0m[49m[38;5;10m+    152[0m:[38;5;10m[49m             d: v(ang.cos(), ang.sin()),
[0m[49m[38;5;10m+    153[0m:[38;5;10m[49m             t: 1000.0,
[0m[49m[38;5;10m+    154[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+    155[0m:[38;5;10m[49m         let (disc, t) = circle_internals(ray, c);
[0m[49m[38;5;10m+    156[0m:[38;5;10m[49m         if disc < 0.0 || !(t < 0.0) {
[0m[49m[38;5;10m+    157[0m:[38;5;10m[49m             continue;
[0m[49m[38;5;10m+    158[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    159[0m:[38;5;10m[49m         fired += 1;
[0m[49m[38;5;10m+    160[0m:[38;5;10m[49m         let (cr, co, rr, ro) = call_circle(ray, c);
[0m[49m[38;5;10m+    161[0m:[38;5;10m[49m         assert_eq!(cr, 0);
[0m[49m[38;5;10m+    162[0m:[38;5;10m[49m         d.check_ray(cr, co, rr, ro, || format!("inside, t={}", fmt_f(t)));
[0m[49m[38;5;10m+    163[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    164[0m:[38;5;10m[49m     assert!(fired > 1000, "row02 trigger fired only {fired} times");
[0m[49m[38;5;10m+    165[0m:[38;5;10m[49m     eprintln!("    row02: {fired} cases with t < 0");
[0m[49m[38;5;10m+    166[0m:[38;5;10m[49m     d.finish();
[0m[49m[38;5;10m+    167[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    168[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    169[0m:[38;5;10m[49m /// Row 3 — `t > A.t`: hit exists but lies beyond the ray's length. Includes the
[0m[49m[38;5;10m+    170[0m:[38;5;10m[49m /// exact boundary `t == A.t` (must be ACCEPTED) and one ULP past it.
[0m[49m[38;5;10m+    171[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    172[0m:[38;5;10m[49m fn err_03_circle_t_beyond_len() {
[0m[49m[38;5;10m+    173[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 3);
[0m[49m[38;5;10m+    174[0m:[38;5;10m[49m     let mut d = Diff::new("row03 circle t > A.t");
[0m[49m[38;5;10m+    175[0m:[38;5;10m[49m     let mut fired = 0usize;
[0m[49m[38;5;10m+    176[0m:[38;5;10m[49m     let mut boundary_accepted = 0usize;
[0m[49m[38;5;10m+    177[0m:[38;5;10m[49m     for _ in 0..4000 {
[0m[49m[38;5;10m+    178[0m:[38;5;10m[49m         let c = c2Circle {
[0m[49m[38;5;10m+    179[0m:[38;5;10m[49m             p: v(rng.coord(), rng.coord()),
[0m[49m[38;5;10m+    180[0m:[38;5;10m[49m             r: rng.range(0.5, 20.0),
[0m[49m[38;5;10m+    181[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+    182[0m:[38;5;10m[49m         let dist = c.r + rng.range(5.0, 80.0);
[0m[49m[38;5;10m+    183[0m:[38;5;10m[49m         let ray_far = c2Ray {
[0m[49m[38;5;10m+    184[0m:[38;5;10m[49m             p: v(c.p.x - dist, c.p.y),
[0m[49m[38;5;10m+    185[0m:[38;5;10m[49m             d: v(1.0, 0.0),
[0m[49m[38;5;10m+    186[0m:[38;5;10m[49m             t: 1e9,
[0m[49m[38;5;10m+    187[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+    188[0m:[38;5;10m[49m         let (disc, t) = circle_internals(ray_far, c);
[0m[49m[38;5;10m+    189[0m:[38;5;10m[49m         if disc < 0.0 || t < 0.0 {
[0m[49m[38;5;10m+    190[0m:[38;5;10m[49m             continue;
[0m[49m[38;5;10m+    191[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    192[0m:[38;5;10m[49m         // A.t exactly at t -> accepted; one ULP below -> rejected.
[0m[49m[38;5;10m+    193[0m:[38;5;10m[49m         for (at, expect_hit) in [
[0m[49m[38;5;10m+    194[0m:[38;5;10m[49m             (t, true),
[0m[49m[38;5;10m+    195[0m:[38;5;10m[49m             (f32::from_bits(t.to_bits() - 1), false),
[0m[49m[38;5;10m+    196[0m:[38;5;10m[49m             (t * 0.5, false),
[0m[49m[38;5;10m+    197[0m:[38;5;10m[49m             (0.0, false),
[0m[49m[38;5;10m+    198[0m:[38;5;10m[49m         ] {
[0m[49m[38;5;10m+    199[0m:[38;5;10m[49m             let ray = c2Ray { p: ray_far.p, d: ray_far.d, t: at };
[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m             let (cr, co, rr, ro) = call_circle(ray, c);
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m             if expect_hit {
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m                 if cr == 1 {
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m                     boundary_accepted += 1;
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m             } else if cr == 0 {
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m                 fired += 1;
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m                 assert!(rc_eq(co, POISON), "t>A.t must leave *out untouched");
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m             d.check_ray(cr, co, rr, ro, || {
[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m                 format!("t={} A.t={}", fmt_f(t), fmt_f(at))
[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m             });
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m     assert!(fired > 1000, "row03 trigger fired only {fired} times");
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m     assert!(
[0m[49m[38;5;10m+    216[0m:[38;5;10m[49m         boundary_accepted > 500,
[0m[49m[38;5;10m+    217[0m:[38;5;10m[49m         "the `t <= A.t` boundary was never accepted ({boundary_accepted}); \
[0m[49m[38;5;10m+    218[0m:[38;5;10m[49m          the test is not probing the boundary"
[0m[49m[38;5;10m+    219[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    220[0m:[38;5;10m[49m     eprintln!("    row03: {fired} rejections, {boundary_accepted} boundary acceptances");
[0m[49m[38;5;10m+    221[0m:[38;5;10m[49m     d.finish();
[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m }
