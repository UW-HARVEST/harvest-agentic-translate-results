[0m[49m[38;5;10m+    179[0m:[38;5;10m[49m             5 => self.wide(),
[0m[49m[38;5;10m+    180[0m:[38;5;10m[49m             6 => SPECIALS[self.below(SPECIALS.len())],
[0m[49m[38;5;10m+    181[0m:[38;5;10m[49m             7 => self.any_bits(),
