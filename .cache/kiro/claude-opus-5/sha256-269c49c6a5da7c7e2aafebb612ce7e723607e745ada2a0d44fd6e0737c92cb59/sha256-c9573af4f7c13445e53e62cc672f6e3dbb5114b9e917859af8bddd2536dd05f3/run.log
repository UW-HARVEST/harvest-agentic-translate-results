[0m[49m[38;5;10m+    286[0m:[38;5;10m[49m                         d: c2v { x: inv_sqrt2 * sx, y: inv_sqrt2 * sy },
[0m[49m[38;5;10m+    287[0m:[38;5;10m[49m                         t: 10.0,
[0m[49m[38;5;10m+    288[0m:[38;5;10m[49m                     },
[0m[49m[38;5;10m+    289[0m:[38;5;10m[49m                     sq,
