[0m[49m[38;5;10m+    375[0m:[38;5;10m[49m         let mut p = base;
[0m[49m[38;5;10m+    376[0m:[38;5;10m[49m         p.bb_max_y = p.bb_min_y;
[0m[49m[38;5;10m+    377[0m:[38;5;10m[49m         check(&mut d, &p);
