[0m[49m[38;5;10m+    324[0m:[38;5;10m[49m                 (cx - 50.0, b.min.y),
[0m[49m[38;5;10m+    325[0m:[38;5;10m[49m                 (cx - 50.0, b.max.y),
[0m[49m[38;5;10m+    326[0m:[38;5;10m[49m                 (b.min.x, cy - 50.0),
[0m[49m[38;5;10m+    327[0m:[38;5;10m[49m                 (b.max.x, cy - 50.0),
[0m[49m[38;5;10m+    328[0m:[38;5;10m[49m             ] {
[0m[49m[38;5;10m+    329[0m:[38;5;10m[49m                 cases.push((
[0m[49m[38;5;10m+    330[0m:[38;5;10m[49m                     c2Ray {
