[0m[49m[38;5;10m+     15[0m:[38;5;10m[49m   echo "FAIL: C .so not built. Run:"
[0m[49m[38;5;10m+     16[0m:[38;5;10m[49m   echo "  cd c_src && mkdir -p build && cd build && cmake .. -DCMAKE_POSITION_INDEPENDENT_CODE=ON && cmake --build ."
[0m[49m[38;5;10m+     17[0m:[38;5;10m[49m   exit 1
[0m[49m[38;5;10m+     18[0m:[38;5;10m[49m fi
[0m[49m[38;5;10m+     19[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     20[0m:[38;5;10m[49m # --- enumerate the optional features declared in Cargo.toml -----------------
[0m[49m[38;5;10m+     21[0m:[38;5;10m[49m mapfile -t FEATURES < <(
[0m[49m[38;5;10m+     22[0m:[38;5;10m[49m   awk '
[0m[49m[38;5;10m+     23[0m:[38;5;10m[49m     /^\[features\]/        { in_f = 1; next }
[0m[49m[38;5;10m+     24[0m:[38;5;10m[49m     /^\[/                  { in_f = 0 }
[0m[49m[38;5;10m+     25[0m:[38;5;10m[49m     in_f && /^[A-Za-z0-9_-]+[[:space:]]*=/ {
[0m[49m[38;5;10m+     26[0m:[38;5;10m[49m       split($0, a, "=");
[0m[49m[38;5;10m+     27[0m:[38;5;10m[49m       gsub(/[[:space:]]/, "", a[1]);
[0m[49m[38;5;10m+     28[0m:[38;5;10m[49m       if (a[1] != "default") print a[1];
[0m[49m[38;5;10m+     29[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     30[0m:[38;5;10m[49m   ' Cargo.toml
