[0m[49m[38;5;10m+    188[0m:[38;5;10m[49m /// Row 23 — each winning-plane branch forced by approaching from each side.
[0m[49m[38;5;10m+    189[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    190[0m:[38;5;10m[49m fn cfg_23_raytoaabb_each_plane() {
[0m[49m[38;5;10m+    191[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 23);
[0m[49m[38;5;10m+    192[0m:[38;5;10m[49m     let mut cases = Vec::new();
[0m[49m[38;5;10m+    193[0m:[38;5;10m[49m     for _ in 0..(N / 8 + 1) {
[0m[49m[38;5;10m+    194[0m:[38;5;10m[49m         let b = rand_box(&mut rng);
[0m[49m[38;5;10m+    195[0m:[38;5;10m[49m         let cx = (b.min.x + b.max.x) * 0.5;
[0m[49m[38;5;10m+    196[0m:[38;5;10m[49m         let cy = (b.min.y + b.max.y) * 0.5;
[0m[49m[38;5;10m+    197[0m:[38;5;10m[49m         let w = b.max.x - b.min.x;
[0m[49m[38;5;10m+    198[0m:[38;5;10m[49m         let h = b.max.y - b.min.y;
[0m[49m[38;5;10m+    199[0m:[38;5;10m[49m         // Eight approach directions: 4 faces + 4 diagonals.
[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m         let offs: [(f32, f32); 8] = [
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m             (-(w + 20.0), 0.0),
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m             (w + 20.0, 0.0),
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m             (0.0, -(h + 20.0)),
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m             (0.0, h + 20.0),
[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m             (-(w + 20.0), -(h + 20.0)),
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m             (w + 20.0, -(h + 20.0)),
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m             (-(w + 20.0), h + 20.0),
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m             (w + 20.0, h + 20.0),
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m         ];
[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m         for (ox, oy) in offs {
[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m             let origin = c2v { x: cx + ox, y: cy + oy };
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m             let target = c2v {
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m                 x: cx + rng.range(-w * 0.4, w * 0.4),
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m                 y: cy + rng.range(-h * 0.4, h * 0.4),
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m             };
[0m[49m[38;5;10m+    216[0m:[38;5;10m[49m             let dx = target.x - origin.x;
[0m[49m[38;5;10m+    217[0m:[38;5;10m[49m             let dy = target.y - origin.y;
[0m[49m[38;5;10m+    218[0m:[38;5;10m[49m             let len = (dx * dx + dy * dy).sqrt();
[0m[49m[38;5;10m+    219[0m:[38;5;10m[49m             cases.push((
[0m[49m[38;5;10m+    220[0m:[38;5;10m[49m                 c2Ray {
[0m[49m[38;5;10m+    221[0m:[38;5;10m[49m                     p: origin,
