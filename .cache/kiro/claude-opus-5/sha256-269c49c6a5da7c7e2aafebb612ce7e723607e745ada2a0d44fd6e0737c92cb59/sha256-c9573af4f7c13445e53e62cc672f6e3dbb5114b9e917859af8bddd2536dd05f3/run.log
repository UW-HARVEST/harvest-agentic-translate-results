[0m[49m[38;5;10m+    478[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    479[0m:[38;5;10m[49m     // One zero component: 0*inf == NaN, nonzero*inf == inf.
[0m[49m[38;5;10m+    480[0m:[38;5;10m[49m     for a in [v(0.0, 5.0), v(5.0, 0.0), v(-0.0, 5.0), v(5.0, -0.0), v(0.0, -5.0)] {
[0m[49m[38;5;10m+    481[0m:[38;5;10m[49m         let cn = unsafe { (l.c.c2Norm)(a) };
[0m[49m[38;5;10m+    482[0m:[38;5;10m[49m         let rn = unsafe { (l.r.c2Norm)(a) };
