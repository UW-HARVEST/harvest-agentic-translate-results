[0m[49m[38;5;10m+    291[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    292[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    293[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    294[0m:[38;5;10m[49m     run_batch(
[0m[49m[38;5;10m+    295[0m:[38;5;10m[49m         "row24 c2RaytoAABB corner ties",
