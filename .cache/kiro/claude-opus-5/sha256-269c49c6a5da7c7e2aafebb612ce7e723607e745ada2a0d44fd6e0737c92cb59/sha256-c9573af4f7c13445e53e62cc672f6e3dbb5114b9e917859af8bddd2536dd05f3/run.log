[0m[49m[38;5;10m+    458[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 53);
[0m[49m[38;5;10m+    459[0m:[38;5;10m[49m     let mut d = Diff::new("row53 struct ABI parity");
[0m[49m[38;5;10m+    460[0m:[38;5;10m[49m 
