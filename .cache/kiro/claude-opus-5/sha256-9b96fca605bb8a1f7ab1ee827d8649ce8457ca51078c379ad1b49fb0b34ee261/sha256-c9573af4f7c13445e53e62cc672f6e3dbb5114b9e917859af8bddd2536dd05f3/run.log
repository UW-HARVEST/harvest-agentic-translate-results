import re,os
# find `while` loops containing a `match` that contains a bare `break;`
for root,_,fs in os.walk('.'):
    for f in fs:
        if not f.endswith('.rs'): continue
        p=os.path.join(root,f)
        L=open(p).read().split('\n')
        # track: inside while ... { ... match ... { ... break; }
        for i,l in enumerate(L):
            if re.search(r'\bmatch\b.*\{\s*$', l):
                indent=len(l)-len(l.lstrip())
                # look back for an enclosing loop/while at lower indent
                encl=None
                for j in range(i-1,max(0,i-60),-1):
                    lj=L[j]
                    ij=len(lj)-len(lj.lstrip())
                    if ij<indent and re.search(r'^\s*(while|loop|for)\b', lj):
                        encl=(j,lj.strip()); break
                    if ij<indent and re.search(r'^\s*(unsafe )?(pub )?fn\b', lj):
