                    if k>i and re.match(r'^\s*break;\s*$', L[k]): found.append(k+1)
                    if depth<=0 and k>i: break
                    k+=1
                if found:
                    print(f"{p}:{i+1} match inside {encl[1]!r} @{encl[0]+1} -> bare break; at lines {found}")
