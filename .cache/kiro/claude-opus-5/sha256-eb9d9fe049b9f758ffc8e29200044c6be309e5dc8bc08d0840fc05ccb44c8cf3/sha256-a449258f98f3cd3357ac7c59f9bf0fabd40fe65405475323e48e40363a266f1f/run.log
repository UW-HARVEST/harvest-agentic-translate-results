[0m[49m[38;5;10m+    345[0m:[38;5;10m[49m         format!("{}7\n", " ".repeat(255)).as_bytes(),
[0m[49m[38;5;10m+    346[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    347[0m:[38;5;10m[49m     // First chunk is "x"*254 + "7"; the tail is just "\n".
[0m[49m[38;5;10m+    348[0m:[38;5;10m[49m     assert_identical(
[0m[49m[38;5;10m+    349[0m:[38;5;10m[49m         "254 x then 7",
[0m[49m[38;5;10m+    350[0m:[38;5;10m[49m         format!("{}7\n", "x".repeat(254)).as_bytes(),
[0m[49m[38;5;10m+    351[0m:[38;5;10m[49m     );
