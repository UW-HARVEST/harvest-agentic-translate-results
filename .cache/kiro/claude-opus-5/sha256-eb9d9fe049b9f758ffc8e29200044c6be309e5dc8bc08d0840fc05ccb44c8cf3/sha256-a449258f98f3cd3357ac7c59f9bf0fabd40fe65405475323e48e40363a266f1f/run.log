[0m[49m[38;5;10m+    359[0m:[38;5;10m[49m         "300-byte line starting with 1",
[0m[49m[38;5;10m+    360[0m:[38;5;10m[49m         format!("1{}\n", "a".repeat(299)).as_bytes(),
[0m[49m[38;5;10m+    361[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    362[0m:[38;5;10m[49m     // A digit run split across the buffer boundary.
