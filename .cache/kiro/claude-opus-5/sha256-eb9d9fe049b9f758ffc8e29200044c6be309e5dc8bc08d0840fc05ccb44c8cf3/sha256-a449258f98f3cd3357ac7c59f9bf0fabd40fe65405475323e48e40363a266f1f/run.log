[0m[49m[38;5;10m+    365[0m:[38;5;10m[49m         format!("{}\n", "1234567890".repeat(60)).as_bytes(),
[0m[49m[38;5;10m+    366[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    367[0m:[38;5;10m[49m }
