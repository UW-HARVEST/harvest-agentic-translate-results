import re
src = open('c_src/include/lib.h').read()
# isolate the initializer
start = src.index('tflac_crc16_tables[8][256] = {')
body = src[start:]
# find inner brace groups
groups = re.findall(r'\{([^{}]*)\}', body)
assert len(groups) == 8, len(groups)
out = []
out.append('// Translated from c_src/include/lib.h (tflac_crc16_tables).')
out.append('pub static TFLAC_CRC16_TABLES: [[u16; 256]; 8] = [')
for g in groups:
    vals = re.findall(r'0x[0-9a-fA-F]+', g)
    assert len(vals) == 256, len(vals)
    out.append('    [')
    for i in range(0, 256, 8):
        out.append('        ' + ', '.join(v.lower() for v in vals[i:i+8]) + ',')
    out.append('    ],')
out.append('];')
open('translation/src/tables.rs','w').write('\n'.join(out) + '\n')
print('ok')
EOF[0m[38;5;244m (using tool: shell)[0m
