#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <dlfcn.h>
typedef uint16_t (*fn)(const uint8_t*, uint32_t, uint16_t);
int main(void){
    void *a = dlopen("./libc_orig.so", RTLD_NOW);
    void *b = dlopen("/local/home/scheschb/.harvest/work/harvest-work-QuPKLK/translation/target/release/libtflac_crc16.so", RTLD_NOW);
    if(!a||!b){ fprintf(stderr,"dlopen: %s\n", dlerror()); return 2; }
    fn ca = (fn)dlsym(a,"crc16"), cb = (fn)dlsym(b,"crc16");
    if(!ca||!cb){ fprintf(stderr,"dlsym failed\n"); return 2; }
    uint8_t buf[600];
    unsigned mismatch=0, checked=0;
    srand(12345);
    for(int t=0;t<2000;t++){
        for(int i=0;i<600;i++) buf[i]=rand()&0xFF;
        for(uint32_t len=0; len<=64; len++){
            uint16_t seeds[4]={0,0xFFFF,0x1D0F,(uint16_t)rand()};
            for(int s=0;s<4;s++){
                uint16_t x=ca(buf,len,seeds[s]), y=cb(buf,len,seeds[s]);
                checked++;
                if(x!=y){ if(mismatch<5) printf("MISMATCH len=%u seed=%04x c=%04x rust=%04x\n",len,seeds[s],x,y); mismatch++; }
            }
        }
        uint32_t big=600; uint16_t x=ca(buf,big,0xABCD), y=cb(buf,big,0xABCD);
        checked++; if(x!=y){ if(mismatch<5) printf("MISMATCH big c=%04x rust=%04x\n",x,y); mismatch++; }
    }
    printf("checked=%u mismatches=%u\n",checked,mismatch);
    return mismatch?1:0;
}
EOF
