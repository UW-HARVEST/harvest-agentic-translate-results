[0m[49m[38;5;10m+     96[0m:[38;5;10m[49m     111c: mov $0x0,%eax
[0m[49m[38;5;10m+     97[0m:[38;5;10m[49m     1122: ret
[0m[49m[38;5;10m+     98[0m:[38;5;10m[49m ```
