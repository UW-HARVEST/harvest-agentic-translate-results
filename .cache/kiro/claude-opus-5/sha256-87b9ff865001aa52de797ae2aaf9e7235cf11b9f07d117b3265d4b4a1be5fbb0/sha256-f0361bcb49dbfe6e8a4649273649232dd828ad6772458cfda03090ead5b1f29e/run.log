[0m[49m[38;5;10m+    678[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    679[0m:[38;5;10m[49m fn c8_buffering_modes() {
[0m[49m[38;5;10m+    680[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0x8);
[0m[49m[38;5;10m+    681[0m:[38;5;10m[49m     for (mode, mode_name) in [
[0m[49m[38;5;10m+    682[0m:[38;5;10m[49m         (_IONBF, "IONBF"),
[0m[49m[38;5;10m+    683[0m:[38;5;10m[49m         (_IOLBF, "IOLBF"),
[0m[49m[38;5;10m+    684[0m:[38;5;10m[49m         (_IOFBF, "IOFBF"),
[0m[49m[38;5;10m+    685[0m:[38;5;10m[49m     ] {
[0m[49m[38;5;10m+    686[0m:[38;5;10m[49m         for _ in 0..8 {
[0m[49m[38;5;10m+    687[0m:[38;5;10m[49m             let n = rng.range(0, 120) as usize;
[0m[49m[38;5;10m+    688[0m:[38;5;10m[49m             let tag = format!("C8/{mode_name}/n={n}");
[0m[49m[38;5;10m+    689[0m:[38;5;10m[49m             let run = |imp: Impl| {
[0m[49m[38;5;10m+    690[0m:[38;5;10m[49m                 unsafe {
[0m[49m[38;5;10m+    691[0m:[38;5;10m[49m                     fflush(libc_stdout());
[0m[49m[38;5;10m+    692[0m:[38;5;10m[49m                     setvbuf(libc_stdout(), std::ptr::null_mut(), mode, 0);
[0m[49m[38;5;10m+    693[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    694[0m:[38;5;10m[49m                 let rcs = call_n(imp, n);
[0m[49m[38;5;10m+    695[0m:[38;5;10m[49m                 unsafe {
[0m[49m[38;5;10m+    696[0m:[38;5;10m[49m                     fflush(libc_stdout());
[0m[49m[38;5;10m+    697[0m:[38;5;10m[49m                     // Restore the default so the mode cannot leak into other rows.
[0m[49m[38;5;10m+    698[0m:[38;5;10m[49m                     setvbuf(libc_stdout(), std::ptr::null_mut(), _IOFBF, 0);
[0m[49m[38;5;10m+    699[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    700[0m:[38;5;10m[49m                 rcs
[0m[49m[38;5;10m+    701[0m:[38;5;10m[49m             };
[0m[49m[38;5;10m+    702[0m:[38;5;10m[49m             let out = assert_same(&tag, run);
[0m[49m[38;5;10m+    703[0m:[38;5;10m[49m             assert_n_lines(&tag, &out, n);
[0m[49m[38;5;10m+    704[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    705[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    706[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    707[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    708[0m:[38;5;10m[49m /// C9 — bytes left sitting in the buffer with no explicit flush inside the
[0m[49m[38;5;10m+    709[0m:[38;5;10m[49m /// operation, versus flushed part-way through. Both must yield the same stream.
[0m[49m[38;5;10m+    710[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    711[0m:[38;5;10m[49m fn c9_unflushed_vs_flushed() {
[0m[49m[38;5;10m+    712[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0x9);
[0m[49m[38;5;10m+    713[0m:[38;5;10m[49m     for case in 0..24 {
[0m[49m[38;5;10m+    714[0m:[38;5;10m[49m         let n = rng.range(1, 300) as usize;
[0m[49m[38;5;10m+    715[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    716[0m:[38;5;10m[49m         // (a) no flush anywhere inside; only the capture's final drain flushes.
[0m[49m[38;5;10m+    717[0m:[38;5;10m[49m         let tag = format!("C9a/nofl/n={n}");
[0m[49m[38;5;10m+    718[0m:[38;5;10m[49m         let out_nofl = assert_same(&tag, |imp| call_n(imp, n));
[0m[49m[38;5;10m+    719[0m:[38;5;10m[49m         assert_n_lines(&tag, &out_nofl, n);
[0m[49m[38;5;10m+    720[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    721[0m:[38;5;10m[49m         // (b) flush at a randomized point part-way through.
[0m[49m[38;5;10m+    722[0m:[38;5;10m[49m         let cut = rng.range(0, n as u64) as usize;
[0m[49m[38;5;10m+    723[0m:[38;5;10m[49m         let tag = format!("C9b/flush@{cut}/n={n}/case={case}");
[0m[49m[38;5;10m+    724[0m:[38;5;10m[49m         let out_fl = assert_same(&tag, |imp| {
[0m[49m[38;5;10m+    725[0m:[38;5;10m[49m             let mut rcs = call_n(imp, cut);
[0m[49m[38;5;10m+    726[0m:[38;5;10m[49m             unsafe {
[0m[49m[38;5;10m+    727[0m:[38;5;10m[49m                 fflush(std::ptr::null_mut());
[0m[49m[38;5;10m+    728[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    729[0m:[38;5;10m[49m             rcs.extend(call_n(imp, n - cut));
[0m[49m[38;5;10m+    730[0m:[38;5;10m[49m             rcs
[0m[49m[38;5;10m+    731[0m:[38;5;10m[49m         });
[0m[49m[38;5;10m+    732[0m:[38;5;10m[49m         assert_n_lines(&tag, &out_fl, n);
[0m[49m[38;5;10m+    733[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    734[0m:[38;5;10m[49m             out_nofl, out_fl,
[0m[49m[38;5;10m+    735[0m:[38;5;10m[49m             "[{tag}] flushing part-way changed the byte stream"
[0m[49m[38;5;10m+    736[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    737[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    738[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    739[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    740[0m:[38;5;10m[49m /// C10 — concurrent calls from several threads. glibc locks the FILE, so each
[0m[49m[38;5;10m+    741[0m:[38;5;10m[49m /// line is written atomically; since every line is identical the resulting byte
[0m[49m[38;5;10m+    742[0m:[38;5;10m[49m /// stream is deterministic and can be compared exactly.
[0m[49m[38;5;10m+    743[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    744[0m:[38;5;10m[49m fn c10_concurrent_threads() {
[0m[49m[38;5;10m+    745[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0xA);
[0m[49m[38;5;10m+    746[0m:[38;5;10m[49m     for case in 0..12 {
[0m[49m[38;5;10m+    747[0m:[38;5;10m[49m         let threads = rng.range(2, 8) as usize;
[0m[49m[38;5;10m+    748[0m:[38;5;10m[49m         let per = rng.range(1, 64) as usize;
[0m[49m[38;5;10m+    749[0m:[38;5;10m[49m         let tag = format!("C10/case={case}/t={threads}/k={per}");
[0m[49m[38;5;10m+    750[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    751[0m:[38;5;10m[49m         let out = assert_same(&tag, |imp| {
[0m[49m[38;5;10m+    752[0m:[38;5;10m[49m             // A raw fn pointer is Copy + Send, so it can cross into threads
[0m[49m[38;5;10m+    753[0m:[38;5;10m[49m             // while the `Library` stays owned by the main thread.
[0m[49m[38;5;10m+    754[0m:[38;5;10m[49m             let f = imp.ptr();
[0m[49m[38;5;10m+    755[0m:[38;5;10m[49m             let handles: Vec<_> = (0..threads)
[0m[49m[38;5;10m+    756[0m:[38;5;10m[49m                 .map(|_| {
[0m[49m[38;5;10m+    757[0m:[38;5;10m[49m                     std::thread::spawn(move || {
[0m[49m[38;5;10m+    758[0m:[38;5;10m[49m                         let mut rcs = Vec::with_capacity(per);
[0m[49m[38;5;10m+    759[0m:[38;5;10m[49m                         for _ in 0..per {
[0m[49m[38;5;10m+    760[0m:[38;5;10m[49m                             rcs.push(unsafe { f() });
[0m[49m[38;5;10m+    761[0m:[38;5;10m[49m                         }
[0m[49m[38;5;10m+    762[0m:[38;5;10m[49m                         rcs
[0m[49m[38;5;10m+    763[0m:[38;5;10m[49m                     })
[0m[49m[38;5;10m+    764[0m:[38;5;10m[49m                 })
[0m[49m[38;5;10m+    765[0m:[38;5;10m[49m                 .collect();
[0m[49m[38;5;10m+    766[0m:[38;5;10m[49m             let mut all: Vec<c_int> = Vec::new();
[0m[49m[38;5;10m+    767[0m:[38;5;10m[49m             for h in handles {
[0m[49m[38;5;10m+    768[0m:[38;5;10m[49m                 all.extend(h.join().expect("worker thread panicked"));
[0m[49m[38;5;10m+    769[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    770[0m:[38;5;10m[49m             all.sort_unstable();
[0m[49m[38;5;10m+    771[0m:[38;5;10m[49m             all
[0m[49m[38;5;10m+    772[0m:[38;5;10m[49m         });
[0m[49m[38;5;10m+    773[0m:[38;5;10m[49m         assert_n_lines(&tag, &out, threads * per);
[0m[49m[38;5;10m+    774[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    775[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    776[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    777[0m:[38;5;10m[49m /// C11 — both `.so`s loaded at once, calls alternating between them mid-stream.
[0m[49m[38;5;10m+    778[0m:[38;5;10m[49m /// Verifies `RTLD_LOCAL` isolation (no symbol interposition between the two
[0m[49m[38;5;10m+    779[0m:[38;5;10m[49m /// identically-named `helloworld` exports) and that the two are byte-for-byte
[0m[49m[38;5;10m+    780[0m:[38;5;10m[49m /// interchangeable within a single output stream.
[0m[49m[38;5;10m+    781[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    782[0m:[38;5;10m[49m fn c11_both_libraries_interleaved() {
[0m[49m[38;5;10m+    783[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0xB);
[0m[49m[38;5;10m+    784[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    785[0m:[38;5;10m[49m     // Prove the two symbols really are distinct code, not one interposing on
[0m[49m[38;5;10m+    786[0m:[38;5;10m[49m     // the other — otherwise this row would pass vacuously.
[0m[49m[38;5;10m+    787[0m:[38;5;10m[49m     let pc = libs().c.get::<HelloFn>(b"helloworld\0").map(|s| *s as usize);
[0m[49m[38;5;10m+    788[0m:[38;5;10m[49m     let pr = libs().rust.get::<HelloFn>(b"helloworld\0").map(|s| *s as usize);
[0m[49m[38;5;10m+    789[0m:[38;5;10m[49m     let (pc, pr) = unsafe { (pc, pr) };
[0m[49m[38;5;10m+    790[0m:[38;5;10m[49m     let (pc, pr) = (pc.expect("C symbol"), pr.expect("Rust symbol"));
[0m[49m[38;5;10m+    791[0m:[38;5;10m[49m     assert_ne!(
[0m[49m[38;5;10m+    792[0m:[38;5;10m[49m         pc, pr,
[0m[49m[38;5;10m+    793[0m:[38;5;10m[49m         "C11: both libraries resolved to the SAME address — the two .so files \
[0m[49m[38;5;10m+    794[0m:[38;5;10m[49m          are interposing, so no differential comparison is actually happening"
[0m[49m[38;5;10m+    795[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    796[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    797[0m:[38;5;10m[49m     for case in 0..24 {
[0m[49m[38;5;10m+    798[0m:[38;5;10m[49m         let len = rng.range(1, 64) as usize;
[0m[49m[38;5;10m+    799[0m:[38;5;10m[49m         let pattern: Vec<Impl> = (0..len)
[0m[49m[38;5;10m+    800[0m:[38;5;10m[49m             .map(|_| if rng.flip() { Impl::C } else { Impl::Rust })
[0m[49m[38;5;10m+    801[0m:[38;5;10m[49m             .collect();
[0m[49m[38;5;10m+    802[0m:[38;5;10m[49m         let tag = format!("C11/case={case}/len={len}");
[0m[49m[38;5;10m+    803[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    804[0m:[38;5;10m[49m         let mixed = capture(&tag, || {
[0m[49m[38;5;10m+    805[0m:[38;5;10m[49m             let mut rcs = Vec::new();
[0m[49m[38;5;10m+    806[0m:[38;5;10m[49m             for &imp in &pattern {
[0m[49m[38;5;10m+    807[0m:[38;5;10m[49m                 let f = imp.ptr();
[0m[49m[38;5;10m+    808[0m:[38;5;10m[49m                 rcs.push(unsafe { f() });
[0m[49m[38;5;10m+    809[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    810[0m:[38;5;10m[49m             rcs
[0m[49m[38;5;10m+    811[0m:[38;5;10m[49m         });
[0m[49m[38;5;10m+    812[0m:[38;5;10m[49m         let all_c = capture(&tag, || call_n(Impl::C, len));
[0m[49m[38;5;10m+    813[0m:[38;5;10m[49m         let all_r = capture(&tag, || call_n(Impl::Rust, len));
[0m[49m[38;5;10m+    814[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    815[0m:[38;5;10m[49m         assert_eq!(mixed.0, all_c.0, "[{tag}] mixed vs all-C return codes");
[0m[49m[38;5;10m+    816[0m:[38;5;10m[49m         assert_eq!(mixed.0, all_r.0, "[{tag}] mixed vs all-Rust return codes");
[0m[49m[38;5;10m+    817[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    818[0m:[38;5;10m[49m             mixed.1, all_c.1,
[0m[49m[38;5;10m+    819[0m:[38;5;10m[49m             "[{tag}] interleaving C and Rust changed the byte stream vs all-C"
[0m[49m[38;5;10m+    820[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    821[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    822[0m:[38;5;10m[49m             mixed.1, all_r.1,
[0m[49m[38;5;10m+    823[0m:[38;5;10m[49m             "[{tag}] interleaving C and Rust changed the byte stream vs all-Rust"
[0m[49m[38;5;10m+    824[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    825[0m:[38;5;10m[49m         assert_n_lines(&tag, &mixed.1, len);
[0m[49m[38;5;10m+    826[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    827[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    828[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    829[0m:[38;5;10m[49m /// C12 — every return value, on every call, under a large randomized battery.
[0m[49m[38;5;10m+    830[0m:[38;5;10m[49m /// A return value that depended on call count or on hidden state would show up
[0m[49m[38;5;10m+    831[0m:[38;5;10m[49m /// here rather than only on the first call.
[0m[49m[38;5;10m+    832[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    833[0m:[38;5;10m[49m fn c12_return_value_under_load() {
[0m[49m[38;5;10m+    834[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0xC);
[0m[49m[38;5;10m+    835[0m:[38;5;10m[49m     let mut total = 0usize;
[0m[49m[38;5;10m+    836[0m:[38;5;10m[49m     for case in 0..40 {
[0m[49m[38;5;10m+    837[0m:[38;5;10m[49m         let n = rng.range(1, 400) as usize;
[0m[49m[38;5;10m+    838[0m:[38;5;10m[49m         let tag = format!("C12/case={case}/n={n}");
[0m[49m[38;5;10m+    839[0m:[38;5;10m[49m         let out = assert_same(&tag, |imp| call_n(imp, n));
[0m[49m[38;5;10m+    840[0m:[38;5;10m[49m         assert_n_lines(&tag, &out, n);
[0m[49m[38;5;10m+    841[0m:[38;5;10m[49m         for imp in BOTH {
[0m[49m[38;5;10m+    842[0m:[38;5;10m[49m             let (rcs, _) = capture(&tag, || call_n(imp, n));
[0m[49m[38;5;10m+    843[0m:[38;5;10m[49m             assert_eq!(rcs.len(), n);
[0m[49m[38;5;10m+    844[0m:[38;5;10m[49m             for (i, &rc) in rcs.iter().enumerate() {
[0m[49m[38;5;10m+    845[0m:[38;5;10m[49m                 assert_eq!(
[0m[49m[38;5;10m+    846[0m:[38;5;10m[49m                     rc,
[0m[49m[38;5;10m+    847[0m:[38;5;10m[49m                     0,
[0m[49m[38;5;10m+    848[0m:[38;5;10m[49m                     "[{tag}/{}] call #{i} returned {rc}, expected 0",
[0m[49m[38;5;10m+    849[0m:[38;5;10m[49m                     imp.name()
[0m[49m[38;5;10m+    850[0m:[38;5;10m[49m                 );
[0m[49m[38;5;10m+    851[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    852[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    853[0m:[38;5;10m[49m         total += n;
[0m[49m[38;5;10m+    854[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    855[0m:[38;5;10m[49m     assert!(total > 1000, "C12 should exercise a meaningful call volume");
[0m[49m[38;5;10m+    856[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    857[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    858[0m:[38;5;10m[49m /// C13 — symbol re-resolved with a fresh `dlsym` before every call, versus
[0m[49m[38;5;10m+    859[0m:[38;5;10m[49m /// resolved once and reused. Probes lazy-PLT-binding differences between the
[0m[49m[38;5;10m+    860[0m:[38;5;10m[49m /// two objects.
[0m[49m[38;5;10m+    861[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    862[0m:[38;5;10m[49m fn c13_fresh_dlsym_per_call() {
[0m[49m[38;5;10m+    863[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0xD);
