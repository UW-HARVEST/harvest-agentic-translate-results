     1	//! Rust translation of `c_src/src/lib.c` (`hex2bin`).
     2	//!
     3	//! The original C relies heavily on integer promotion and truncation tricks to
     4	//! stay branch-free while classifying hex characters. Every one of those
     5	//! conversions is reproduced explicitly here so the observable behaviour --
     6	//! return value, bytes written, and `*hex_end_p` -- is identical, including the
     7	//! quirky cases (e.g. `strchr(ignore, 0)` matching the NUL terminator).
     8	
     9	use std::ffi::{c_char, c_int};
    10	
    11	/// Equivalent of `strchr(ignore, c) != NULL`.
    12	///
    13	/// Mirrors C `strchr` semantics: the terminating NUL is part of the searched
    14	/// string, so looking for `0` always succeeds.
    15	unsafe fn strchr_found(ignore: *const c_char, c: u8) -> bool {
    16	    let mut p = ignore;
    17	    loop {
    18	        let b = unsafe { *p } as u8;
    19	        if b == c {
    20	            return true;
    21	        }
    22	        if b == 0 {
    23	            return false;
    24	        }
    25	        p = unsafe { p.add(1) };
    26	    }
    27	}
    28	
    29	#[unsafe(no_mangle)]
    30	pub unsafe extern "C" fn hex2bin(
    31	    bin: *mut u8,
    32	    bin_maxlen: usize,
    33	    hex: *const c_char,
    34	    hex_len: usize,
    35	    ignore: *const c_char,
    36	    hex_end_p: *mut *const c_char,
    37	) -> c_int {
    38	    let mut bin_pos: usize = 0;
    39	    let mut hex_pos: usize = 0;
    40	    let mut ret: c_int = 0;
    41	    let mut c_acc: u8 = 0;
    42	    // `unsigned char state`: toggled with `~state`, so it alternates 0 / 0xFF.
    43	    let mut state: u8 = 0;
    44	
    45	    while hex_pos < hex_len {
    46	        let c: u8 = unsafe { *hex.add(hex_pos) } as u8;
    47	
    48	        // c_num = c ^ 48U;                      (truncated to unsigned char)
    49	        let c_num: u8 = c ^ 48u8;
    50	        // c_num0 = (c_num - 10U) >> 8;          (int arithmetic, then truncated)
    51	        let c_num0: u8 = ((c_num as i32 - 10) >> 8) as u8;
    52	        // c_alpha = (c & ~32U) - 55U;           (unsigned int, then truncated)
    53	        let c_alpha: u8 = ((c as u32 & !32u32).wrapping_sub(55)) as u8;
    54	        // c_alpha0 = ((c_alpha - 10U) ^ (c_alpha - 16U)) >> 8;
    55	        let c_alpha0: u8 = (((c_alpha as i32 - 10) ^ (c_alpha as i32 - 16)) >> 8) as u8;
    56	
    57	        if (c_num0 | c_alpha0) == 0 {
    58	            if !ignore.is_null() && state == 0 && unsafe { strchr_found(ignore, c) } {
    59	                hex_pos += 1;
    60	                continue;
    61	            }
    62	            break;
    63	        }
    64	
    65	        let c_val: u8 = (c_num0 & c_num) | (c_alpha0 & c_alpha);
    66	
    67	        if bin_pos >= bin_maxlen {
    68	            ret = -1;
    69	            break;
    70	        }
    71	        if state == 0 {
    72	            c_acc = c_val.wrapping_mul(16);
    73	        } else {
    74	            unsafe { *bin.add(bin_pos) = c_acc | c_val };
    75	            bin_pos += 1;
    76	        }
    77	        state = !state;
    78	        hex_pos += 1;
    79	    }
    80	
    81	    if state != 0 {
    82	        hex_pos = hex_pos.wrapping_sub(1);
    83	        ret = -1;
    84	    }
    85	    if ret != 0 {
    86	        bin_pos = 0;
    87	    }
    88	    if !hex_end_p.is_null() {
    89	        unsafe { *hex_end_p = hex.add(hex_pos) };
    90	    } else if hex_pos != hex_len {
    91	        ret = -1;
    92	    }
    93	    if ret != 0 {
    94	        return ret;
    95	    }
    96	    bin_pos as c_int
    97	}
