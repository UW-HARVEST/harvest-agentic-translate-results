[0m[49m[38;5;10m+    467[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    468[0m:[38;5;10m[49m /// Small deterministic xorshift PRNG so the corpus is reproducible.
[0m[49m[38;5;10m+    469[0m:[38;5;10m[49m struct Rng(u64);
[0m[49m[38;5;10m+    470[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    471[0m:[38;5;10m[49m impl Rng {
