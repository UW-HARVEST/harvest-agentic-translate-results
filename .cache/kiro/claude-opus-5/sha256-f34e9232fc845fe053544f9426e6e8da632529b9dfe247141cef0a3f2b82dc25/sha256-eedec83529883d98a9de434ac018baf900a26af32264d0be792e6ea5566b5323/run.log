import random, subprocess, sys
C="./c_src/build/driver"; R="./translation/target/release/driver"
alpha=[b' ',b'\n',b'\t',b'\r',b'\v',b'\f',b'-',b'+',b'0',b'1',b'9',b'x',b'.',b',',b'a',b'\x00',b'\xff',b'5',b'7',b'2']
random.seed(1234)
bad=0
def check(data,tag):
    global bad
    a=subprocess.run([C],input=data,capture_output=True)
    b=subprocess.run([R],input=data,capture_output=True)
    if (a.stdout,a.stderr,a.returncode)!=(b.stdout,b.stderr,b.returncode):
        bad+=1
        print("DIFF",tag,repr(data[:120]),a.stdout,a.returncode,"|",b.stdout,b.returncode)
for n in range(1500):
    L=random.randint(0,60)
    check(b"".join(random.choice(alpha) for _ in range(L)),"rand%d"%n)
for n in range(600):
    k=random.randint(0,8)
    parts=[]
    for _ in range(k):
        style=random.randint(0,5)
        if style==0: v=random.randint(-2**31,2**31-1)
        elif style==1: v=random.randint(-2**63,2**63-1)
        elif style==2: v=random.choice([2**31,2**31-1,-2**31,2**63-1,-2**63,2**32,0])
        elif style==3: v=random.randint(-10,10)
        elif style==4: v=random.getrandbits(random.randint(1,300))
        else: v=-random.getrandbits(random.randint(1,300))
        parts.append(str(v))
    check(random.choice([b" ",b"\n",b"\t",b"  \n "]).join(p.encode() for p in parts),"num%d"%n)
# exact 100/101/99 counts with tricky tails
for cnt in (0,1,2,98,99,100,101,102,200):
    for tail in (b"",b"\n",b" x",b" -",b" 2147483648"):
        check(b" ".join(str(i).encode() for i in range(1,cnt+1))+tail,"cnt%d"%cnt)
print("mismatches:",bad)
EOF
