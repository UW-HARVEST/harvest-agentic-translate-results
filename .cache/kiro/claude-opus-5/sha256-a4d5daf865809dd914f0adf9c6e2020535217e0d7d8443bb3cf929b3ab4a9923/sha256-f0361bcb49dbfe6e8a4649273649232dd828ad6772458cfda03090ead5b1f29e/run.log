[0m[49m[38;5;10m+    579[0m:[38;5;10m[49m          RUST=(code {r_code:?}, signal {r_sig:?})"
[0m[49m[38;5;10m+    580[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    581[0m:[38;5;10m[49m     // The C has no null check, so it must actually fault (SIGSEGV = 11).
