[0m[49m[38;5;10m+    661[0m:[38;5;10m[49m         let rnext = *(rv.storage as *const usize);
[0m[49m[38;5;10m+    662[0m:[38;5;10m[49m         assert_ne!(cnext, 0, "#37 C must splice after the head");
[0m[49m[38;5;10m+    663[0m:[38;5;10m[49m         assert_ne!(rnext, 0, "#37 Rust must splice after the head");
[0m[49m[38;5;10m+    664[0m:[38;5;10m[49m         assert_eq!(cp2 as usize, cnext + 8, "#37 C returned block start");
[0m[49m[38;5;10m+    665[0m:[38;5;10m[49m         assert_eq!(rp2 as usize, rnext + 8, "#37 Rust returned block start");
[0m[49m[38;5;10m+    666[0m:[38;5;10m[49m         (b.c.strreset)(ca.ptr());
[0m[49m[38;5;10m+    667[0m:[38;5;10m[49m         (b.r.strreset)(ra.ptr());
[0m[49m[38;5;10m+    668[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    669[0m:[38;5;10m[49m         // #40: strreset on an already-empty arena
[0m[49m[38;5;10m+    670[0m:[38;5;10m[49m         for _ in 0..3 {
[0m[49m[38;5;10m+    671[0m:[38;5;10m[49m             (b.c.strreset)(ca.ptr());
[0m[49m[38;5;10m+    672[0m:[38;5;10m[49m             (b.r.strreset)(ra.ptr());
[0m[49m[38;5;10m+    673[0m:[38;5;10m[49m             assert_eq!(cv.remaining, 0);
[0m[49m[38;5;10m+    674[0m:[38;5;10m[49m             assert_eq!(rv.remaining, 0);
[0m[49m[38;5;10m+    675[0m:[38;5;10m[49m             assert_eq!(cv.block, 0);
[0m[49m[38;5;10m+    676[0m:[38;5;10m[49m             assert_eq!(rv.block, 0);
[0m[49m[38;5;10m+    677[0m:[38;5;10m[49m             assert_eq!(cv.mode, 0);
[0m[49m[38;5;10m+    678[0m:[38;5;10m[49m             assert_eq!(rv.mode, 0);
