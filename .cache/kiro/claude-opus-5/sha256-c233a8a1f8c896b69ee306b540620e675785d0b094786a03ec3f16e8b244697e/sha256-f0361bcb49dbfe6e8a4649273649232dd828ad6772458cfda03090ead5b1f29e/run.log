[0m[49m[38;5;10m+    571[0m:[38;5;10m[49m         seed_both(b, 0x3141_5926);
[0m[49m[38;5;10m+    572[0m:[38;5;10m[49m         unsafe {
[0m[49m[38;5;10m+    573[0m:[38;5;10m[49m             let mut c = (b.c.shmode_func)(16, shmode);
[0m[49m[38;5;10m+    574[0m:[38;5;10m[49m             let mut r = (b.r.shmode_func)(16, shmode);
[0m[49m[38;5;10m+    575[0m:[38;5;10m[49m             let keys: Vec<CBuf> = (0..120)
[0m[49m[38;5;10m+    576[0m:[38;5;10m[49m                 .map(|i| CBuf::new(format!("delkey-{i}\0").as_bytes()))
[0m[49m[38;5;10m+    577[0m:[38;5;10m[49m                 .collect();
