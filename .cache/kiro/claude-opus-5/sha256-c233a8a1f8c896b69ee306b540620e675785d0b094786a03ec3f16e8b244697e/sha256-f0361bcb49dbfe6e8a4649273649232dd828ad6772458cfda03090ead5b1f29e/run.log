[0m[49m[38;5;10m+    594[0m:[38;5;10m[49m                 assert_eq!(cs, rs, "delete state shmode={shmode}");
[0m[49m[38;5;10m+    595[0m:[38;5;10m[49m                 if cs.slot_count < prev.slot_count {
