[0m[49m[38;5;10m+    615[0m:[38;5;10m[49m // #36 - #40 — string-arena rejection paths (see also phase_b_arena.rs)
[0m[49m[38;5;10m+    616[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    617[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    618[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    619[0m:[38;5;10m[49m fn err_36_to_40_arena_paths() {
[0m[49m[38;5;10m+    620[0m:[38;5;10m[49m     let (_g, b) = both();
[0m[49m[38;5;10m+    621[0m:[38;5;10m[49m     const ARENA: usize = 24;
[0m[49m[38;5;10m+    622[0m:[38;5;10m[49m     unsafe {
[0m[49m[38;5;10m+    623[0m:[38;5;10m[49m         // #39: empty string into a fresh arena -> 512-byte block, p = base+511
[0m[49m[38;5;10m+    624[0m:[38;5;10m[49m         let ca = CBuf::new(&[0u8; ARENA]);
[0m[49m[38;5;10m+    625[0m:[38;5;10m[49m         let ra = CBuf::new(&[0u8; ARENA]);
[0m[49m[38;5;10m+    626[0m:[38;5;10m[49m         let e = CBuf::new(b"\0");
[0m[49m[38;5;10m+    627[0m:[38;5;10m[49m         let cp = (b.c.stralloc)(ca.ptr(), e.cptr());
[0m[49m[38;5;10m+    628[0m:[38;5;10m[49m         let rp = (b.r.stralloc)(ra.ptr(), e.cptr());
[0m[49m[38;5;10m+    629[0m:[38;5;10m[49m         let cv = &*(ca.0 as *const StringArena);
[0m[49m[38;5;10m+    630[0m:[38;5;10m[49m         let rv = &*(ra.0 as *const StringArena);
[0m[49m[38;5;10m+    631[0m:[38;5;10m[49m         assert_eq!(cv.remaining, 511, "C remaining after empty string");
[0m[49m[38;5;10m+    632[0m:[38;5;10m[49m         assert_eq!(rv.remaining, 511, "Rust remaining after empty string");
[0m[49m[38;5;10m+    633[0m:[38;5;10m[49m         assert_eq!(cv.block, 1);
[0m[49m[38;5;10m+    634[0m:[38;5;10m[49m         assert_eq!(rv.block, 1);
[0m[49m[38;5;10m+    635[0m:[38;5;10m[49m         assert_eq!(cp.offset_from((cv.storage as *const i8).add(8)), 511);
[0m[49m[38;5;10m+    636[0m:[38;5;10m[49m         assert_eq!(rp.offset_from((rv.storage as *const i8).add(8)), 511);
[0m[49m[38;5;10m+    637[0m:[38;5;10m[49m         (b.c.strreset)(ca.ptr());
[0m[49m[38;5;10m+    638[0m:[38;5;10m[49m         (b.r.strreset)(ra.ptr());
[0m[49m[38;5;10m+    639[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    640[0m:[38;5;10m[49m         // #36: first string longer than the block -> remaining forced to 0
[0m[49m[38;5;10m+    641[0m:[38;5;10m[49m         let big: Vec<u8> = std::iter::repeat(b'Z').take(600).chain([0]).collect();
[0m[49m[38;5;10m+    642[0m:[38;5;10m[49m         let bigb = CBuf::new(&big);
[0m[49m[38;5;10m+    643[0m:[38;5;10m[49m         let cp = (b.c.stralloc)(ca.ptr(), bigb.cptr());
[0m[49m[38;5;10m+    644[0m:[38;5;10m[49m         let rp = (b.r.stralloc)(ra.ptr(), bigb.cptr());
[0m[49m[38;5;10m+    645[0m:[38;5;10m[49m         assert_eq!(cv.remaining, 0, "#36 C remaining must be forced to 0");
[0m[49m[38;5;10m+    646[0m:[38;5;10m[49m         assert_eq!(rv.remaining, 0, "#36 Rust remaining must be forced to 0");
[0m[49m[38;5;10m+    647[0m:[38;5;10m[49m         assert_eq!(cstr(cp), cstr(rp));
[0m[49m[38;5;10m+    648[0m:[38;5;10m[49m         // the dedicated block became the head, and its `next` is NULL
[0m[49m[38;5;10m+    649[0m:[38;5;10m[49m         assert_eq!(*(cv.storage as *const usize), 0, "#36 C next must be NULL");
[0m[49m[38;5;10m+    650[0m:[38;5;10m[49m         assert_eq!(*(rv.storage as *const usize), 0, "#36 Rust next must be NULL");
[0m[49m[38;5;10m+    651[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    652[0m:[38;5;10m[49m         // #37: another oversized string, now that storage != NULL -> spliced
[0m[49m[38;5;10m+    653[0m:[38;5;10m[49m         // *after* the head, and `remaining` is left untouched
[0m[49m[38;5;10m+    654[0m:[38;5;10m[49m         let cp2 = (b.c.stralloc)(ca.ptr(), bigb.cptr());
[0m[49m[38;5;10m+    655[0m:[38;5;10m[49m         let rp2 = (b.r.stralloc)(ra.ptr(), bigb.cptr());
[0m[49m[38;5;10m+    656[0m:[38;5;10m[49m         assert_eq!(cv.remaining, 0, "#37 C remaining unchanged");
[0m[49m[38;5;10m+    657[0m:[38;5;10m[49m         assert_eq!(rv.remaining, 0, "#37 Rust remaining unchanged");
[0m[49m[38;5;10m+    658[0m:[38;5;10m[49m         assert_eq!(cstr(cp2), cstr(rp2));
[0m[49m[38;5;10m+    659[0m:[38;5;10m[49m         // head->next now points at the new block
