=== Cargo.toml ===
[package]
name = "translation"
version = "0.1.0"
edition = "2021"

[lib]
name = "sh_geti_lib"
crate-type = ["cdylib"]
path = "src/lib.rs"

[dev-dependencies]
libloading = "0.8"

[profile.release]
panic = "abort"

# This crate is a literal translation of C.  It deliberately reproduces the
# original's wrapping arithmetic and its undefined behaviour on invalid input
# (e.g. dereferencing a NULL key).  Rust's debug-only null/alignment checks and
# overflow checks would turn those into panics, which diverges from the C, so
# they are disabled in the dev/test profile as well as release.
[profile.dev]
debug-assertions = false
overflow-checks = false

