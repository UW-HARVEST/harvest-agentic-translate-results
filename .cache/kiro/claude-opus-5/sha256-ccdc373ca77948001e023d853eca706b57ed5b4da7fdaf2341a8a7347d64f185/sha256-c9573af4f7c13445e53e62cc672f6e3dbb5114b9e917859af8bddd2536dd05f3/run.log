[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m fn seed_boundary_sweep_does_not_reject() {
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m     let seeds: Vec<u32> = vec![
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m         0,
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m         1,
[0m[49m[38;5;10m+    236[0m:[38;5;10m[49m         2,
[0m[49m[38;5;10m+    237[0m:[38;5;10m[49m         i32::MAX as u32,            // 2147483647
[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m         i32::MAX as u32 + 1,        // 2147483648, sign bit set
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m         u32::MAX - 1,               // 4294967294
[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m         u32::MAX,                   // 4294967295
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m         (-1i32) as u32,             // == u32::MAX
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m         (i32::MIN) as u32,          // == 2147483648
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m         (0x1_0000_0000u64 as u32),  // 64-bit value truncated to 0
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m         (0x1_0000_0001u64 as u32),  // truncated to 1
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m         32767,
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m         32768,
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m         65535,
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m         65536,
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m         2147483646,
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m     // Only the seeds with a cached C reference can be compared byte-for-byte;
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m     // the rest are executed to prove they are accepted (no panic, no abort) and
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m     // that equal bit patterns give equal results.
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m     let cached: &[u32] = &[0, 1, 2, 2147483648, 4294967295];
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m     let _g = harness::lock();
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m     let rl = harness::rust();
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m     let mut seen: std::collections::HashMap<u32, Vec<u8>> = std::collections::HashMap::new();
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m     for &s in &seeds {
[0m[49m[38;5;10m+    259[0m:[38;5;10m[49m         let out = rl.long_exec_capture(s);
[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m         assert!(!out.is_empty(), "seed {s}: library printed nothing");
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m         if let Some(prev) = seen.get(&s) {
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m             assert_eq!(prev, &out, "seed {s}: non-deterministic output");
[0m[49m[38;5;10m+    263[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    264[0m:[38;5;10m[49m         if cached.contains(&s) {
[0m[49m[38;5;10m+    265[0m:[38;5;10m[49m             let expect = harness::read_reference_stdout("seed sweep", &format!("c.exec.{s}.out"));
[0m[49m[38;5;10m+    266[0m:[38;5;10m[49m             assert_eq!(out, expect, "seed {s}: differs from C reference");
[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m         seen.insert(s, out);
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m     }
