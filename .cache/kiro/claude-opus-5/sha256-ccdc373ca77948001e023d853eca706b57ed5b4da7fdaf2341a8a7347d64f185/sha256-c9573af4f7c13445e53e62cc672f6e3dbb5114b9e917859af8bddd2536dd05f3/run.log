[0m[49m[38;5;10m+    273[0m:[38;5;10m[49m     assert_eq!(seen[&0], seen[&(0x1_0000_0000u64 as u32)]);
[0m[49m[38;5;10m+    274[0m:[38;5;10m[49m     assert_eq!(seen[&1], seen[&(0x1_0000_0001u64 as u32)]);
[0m[49m[38;5;10m+    275[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    277[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    278[0m:[38;5;10m[49m // ERRORS.md rows 16..=18 — XOR accumulation and the `%d` conversion.
[0m[49m[38;5;10m+    279[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
