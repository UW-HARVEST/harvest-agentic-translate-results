                    }"""
new="""                    if trace {
                        eprintln!("[trace]   subj={:02x?} start={} mo={:#x}", subj, start, mo);
                    }
                    if c_crashes_on_invalid_utf(p, &cp, &subj, subj.len()) {
                        (p.c.match_data_free)(mdc);
                        (p.r.match_data_free)(mdr);
                        continue;
                    }"""
assert s.count(old)==1
s=s.replace(old,new,1)
open(p,'w').write(s)
print("ok")
