s=open(p).read()
old="""fn utf_unsafe(p: &Pair, cp: &CodePair, subj: &[u8], slen: Sz, start: Sz, mopts: u32) -> bool {
    if mopts & o::NO_UTF_CHECK == 0 {
        return false;
    }"""
new="""fn utf_unsafe(p: &Pair, cp: &CodePair, subj: &[u8], slen: Sz, start: Sz, mopts: u32) -> bool {
    let eff0 = if slen == PCRE2_ZERO_TERMINATED {
        subj.iter().position(|&b| b == 0).unwrap_or(subj.len())
    } else {
        slen.min(subj.len())
    };
    // Upstream C crash: MATCH_INVALID_UTF + a lookbehind + invalid UTF subject.
    if c_crashes_on_invalid_utf(p, cp, subj, eff0) {
        return true;
    }
    if mopts & o::NO_UTF_CHECK == 0 {
        return false;
    }"""
assert s.count(old)==1
s=s.replace(old,new,1)
open(p,'w').write(s)

