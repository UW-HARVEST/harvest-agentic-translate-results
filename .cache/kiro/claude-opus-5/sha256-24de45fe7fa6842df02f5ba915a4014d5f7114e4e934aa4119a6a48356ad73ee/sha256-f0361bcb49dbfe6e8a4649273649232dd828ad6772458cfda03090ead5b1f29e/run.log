[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    236[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    237[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m fn err08_threshold_high_side_byte_11_pow() {
