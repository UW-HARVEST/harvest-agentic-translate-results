[0m[49m[38;5;10m+    344[0m:[38;5;10m[49m     let garbage = [
[0m[49m[38;5;10m+    345[0m:[38;5;10m[49m         u64::MAX,
[0m[49m[38;5;10m+    346[0m:[38;5;10m[49m         0xFFFF_FFFF_FF00_0000,
