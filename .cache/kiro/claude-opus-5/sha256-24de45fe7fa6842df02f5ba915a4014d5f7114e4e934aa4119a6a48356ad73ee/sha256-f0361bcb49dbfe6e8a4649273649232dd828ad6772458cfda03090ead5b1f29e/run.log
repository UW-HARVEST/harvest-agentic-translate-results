[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m             let a = match pos {
[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m                 0 => Rgb::new(LINEAR_MAX, 0, 0),
[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m                 1 => Rgb::new(0, LINEAR_MAX, 0),
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m                 _ => Rgb::new(0, 0, LINEAR_MAX),
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m             };
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m             p.assert_same(a, partner, "err07 byte-10 linear branch");
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m             p.assert_same(partner, a, "err07 byte-10 linear branch swapped");
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m         }
