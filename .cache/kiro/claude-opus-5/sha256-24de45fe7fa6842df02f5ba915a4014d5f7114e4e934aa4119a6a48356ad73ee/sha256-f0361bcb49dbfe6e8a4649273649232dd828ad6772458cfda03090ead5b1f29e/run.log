[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m // Rows 7-8 — the transfer-function threshold: byte 10 is the last linear value,
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m // byte 11 is one step past it and takes `pow`.
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    216[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    217[0m:[38;5;10m[49m fn err07_threshold_low_side_byte_10_linear() {
[0m[49m[38;5;10m+    218[0m:[38;5;10m[49m     let p = load();
[0m[49m[38;5;10m+    219[0m:[38;5;10m[49m     // 10/255 = 0.0392156... <= 0.04045
[0m[49m[38;5;10m+    220[0m:[38;5;10m[49m     assert!((10.0f32 / 255.0f32) as f64 <= 0.04045);
