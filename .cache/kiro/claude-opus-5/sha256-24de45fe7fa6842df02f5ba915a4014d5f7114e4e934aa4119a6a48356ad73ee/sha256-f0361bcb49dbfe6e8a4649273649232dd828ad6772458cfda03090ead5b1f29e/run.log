[0m[49m[38;5;10m+    396[0m:[38;5;10m[49m     // There is therefore no null pointer to pass, no length to zero out, and no
[0m[49m[38;5;10m+    397[0m:[38;5;10m[49m     // buffer to oversize.
[0m[49m[38;5;10m+    398[0m:[38;5;10m[49m     assert_eq!(std::mem::size_of::<Rgb>(), 3, "cb_rgb_255 must be 3 bytes");
[0m[49m[38;5;10m+    399[0m:[38;5;10m[49m     assert_eq!(std::mem::align_of::<Rgb>(), 1, "cb_rgb_255 must be align 1");
