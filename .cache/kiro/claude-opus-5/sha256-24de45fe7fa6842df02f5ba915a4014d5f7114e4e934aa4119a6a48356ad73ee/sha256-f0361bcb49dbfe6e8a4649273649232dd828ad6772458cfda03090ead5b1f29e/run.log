[0m[49m[38;5;10m+    393[0m:[38;5;10m[49m fn err14_no_pointer_or_length_surface_exists() {
[0m[49m[38;5;10m+    394[0m:[38;5;10m[49m     // `cb_rgb_255` is a 3-byte, alignment-1, pointer-free value type, and
