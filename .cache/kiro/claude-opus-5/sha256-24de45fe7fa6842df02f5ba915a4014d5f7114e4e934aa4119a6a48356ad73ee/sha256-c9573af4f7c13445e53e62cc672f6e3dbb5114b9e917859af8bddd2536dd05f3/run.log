[0m[49m[38;5;10m+    372[0m:[38;5;10m[49m         } else if fwd.is_nan() || rev.is_nan() {
[0m[49m[38;5;10m+    373[0m:[38;5;10m[49m             not_swapped += 1;
[0m[49m[38;5;10m+    374[0m:[38;5;10m[49m         } else {
