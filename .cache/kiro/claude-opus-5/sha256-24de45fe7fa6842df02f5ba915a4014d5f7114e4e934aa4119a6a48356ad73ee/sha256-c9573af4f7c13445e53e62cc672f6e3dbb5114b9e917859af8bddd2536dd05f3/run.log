[0m[49m[38;5;10m+    265[0m:[38;5;10m[49m     assert!(
[0m[49m[38;5;10m+    266[0m:[38;5;10m[49m         c_syms.iter().any(|s| s == "contrast_ratio"),
[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m         "C .so must export contrast_ratio; got {c_syms:?}"
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m     let mut missing = Vec::new();
[0m[49m[38;5;10m+    271[0m:[38;5;10m[49m     for name in &c_syms {
