[0m[49m[38;5;10m+    290[0m:[38;5;10m[49m         let in_rust = unsafe { pair.rust_lib.get::<*const ()>(&bytes) }.is_ok();
[0m[49m[38;5;10m+    291[0m:[38;5;10m[49m         assert!(!in_c, "{hidden} is static in C and must not be dynamic");
