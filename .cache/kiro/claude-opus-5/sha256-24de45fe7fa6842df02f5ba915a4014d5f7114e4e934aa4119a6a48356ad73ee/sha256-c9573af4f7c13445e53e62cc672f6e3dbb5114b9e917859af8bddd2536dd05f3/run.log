[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m         let (Some(_addr), Some(kind), Some(name)) = (it.next(), it.next(), it.next()) else {
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m             continue;
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m         // Skip absolute/ABI-tag symbols, which are not callable API.
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m         if kind.eq_ignore_ascii_case("a") {
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m             continue;
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m         if name.starts_with("_ITM_") || name == "__gmon_start__" {
