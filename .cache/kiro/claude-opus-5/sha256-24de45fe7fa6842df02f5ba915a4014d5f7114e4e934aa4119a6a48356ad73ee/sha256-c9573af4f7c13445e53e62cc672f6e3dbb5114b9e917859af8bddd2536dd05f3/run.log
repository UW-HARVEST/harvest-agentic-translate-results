[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m     let out = std::process::Command::new("nm")
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m         .args(["-D", "--defined-only", pair.c_path.to_str().unwrap()])
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m         .output()
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m         .expect("run nm on the C .so");
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m     assert!(out.status.success(), "nm failed on the C .so");
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m     let text = String::from_utf8_lossy(&out.stdout);
