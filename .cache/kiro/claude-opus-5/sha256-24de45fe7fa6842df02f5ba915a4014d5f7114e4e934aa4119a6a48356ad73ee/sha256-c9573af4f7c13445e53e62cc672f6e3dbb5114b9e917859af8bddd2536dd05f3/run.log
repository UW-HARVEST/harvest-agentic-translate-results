[0m[49m[38;5;10m+    389[0m:[38;5;10m[49m     let c = pair.c();
[0m[49m[38;5;10m+    390[0m:[38;5;10m[49m     for n in 0u16..=255 {
[0m[49m[38;5;10m+    391[0m:[38;5;10m[49m         let a = CbRgb255::new(n as u8, n as u8, n as u8);
[0m[49m[38;5;10m+    392[0m:[38;5;10m[49m         check(&pair, a, a, "C06");
[0m[49m[38;5;10m+    393[0m:[38;5;10m[49m     }
