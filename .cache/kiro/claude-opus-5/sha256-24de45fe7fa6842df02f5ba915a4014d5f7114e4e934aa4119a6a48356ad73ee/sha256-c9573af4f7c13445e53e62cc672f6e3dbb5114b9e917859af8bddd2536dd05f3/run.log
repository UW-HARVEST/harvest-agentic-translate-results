[0m[49m[38;5;10m+    755[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    756[0m:[38;5;10m[49m fn e09_every_channel_value_is_accepted() {
[0m[49m[38;5;10m+    757[0m:[38;5;10m[49m     let pair = Pair::load();
[0m[49m[38;5;10m+    758[0m:[38;5;10m[49m     for slot in 0..6usize {
[0m[49m[38;5;10m+    759[0m:[38;5;10m[49m         for v in 0u16..=255 {
[0m[49m[38;5;10m+    760[0m:[38;5;10m[49m             let mut ch = [7u8; 6];
[0m[49m[38;5;10m+    761[0m:[38;5;10m[49m             ch[slot] = v as u8;
[0m[49m[38;5;10m+    762[0m:[38;5;10m[49m             let a = CbRgb255::new(ch[0], ch[1], ch[2]);
[0m[49m[38;5;10m+    763[0m:[38;5;10m[49m             let b = CbRgb255::new(ch[3], ch[4], ch[5]);
[0m[49m[38;5;10m+    764[0m:[38;5;10m[49m             check(&pair, a, b, "E9");
[0m[49m[38;5;10m+    765[0m:[38;5;10m[49m             let mut ch2 = [200u8; 6];
[0m[49m[38;5;10m+    766[0m:[38;5;10m[49m             ch2[slot] = v as u8;
[0m[49m[38;5;10m+    767[0m:[38;5;10m[49m             let a2 = CbRgb255::new(ch2[0], ch2[1], ch2[2]);
[0m[49m[38;5;10m+    768[0m:[38;5;10m[49m             let b2 = CbRgb255::new(ch2[3], ch2[4], ch2[5]);
[0m[49m[38;5;10m+    769[0m:[38;5;10m[49m             check(&pair, a2, b2, "E9");
[0m[49m[38;5;10m+    770[0m:[38;5;10m[49m             let mut ch3 = [0u8; 6];
