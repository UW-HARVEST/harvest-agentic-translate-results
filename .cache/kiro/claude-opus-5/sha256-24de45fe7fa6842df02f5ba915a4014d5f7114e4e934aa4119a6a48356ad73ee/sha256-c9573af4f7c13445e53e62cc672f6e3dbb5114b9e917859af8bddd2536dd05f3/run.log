[0m[49m[38;5;10m+    611[0m:[38;5;10m[49m     for a in [
[0m[49m[38;5;10m+    612[0m:[38;5;10m[49m         CbRgb255::new(1, 0, 0),
[0m[49m[38;5;10m+    613[0m:[38;5;10m[49m         CbRgb255::new(0, 1, 0),
[0m[49m[38;5;10m+    614[0m:[38;5;10m[49m         CbRgb255::new(0, 0, 1),
[0m[49m[38;5;10m+    615[0m:[38;5;10m[49m     ] {
[0m[49m[38;5;10m+    616[0m:[38;5;10m[49m         check(&pair, a, black, "E1");
[0m[49m[38;5;10m+    617[0m:[38;5;10m[49m         let v = unsafe { c(a, black) };
