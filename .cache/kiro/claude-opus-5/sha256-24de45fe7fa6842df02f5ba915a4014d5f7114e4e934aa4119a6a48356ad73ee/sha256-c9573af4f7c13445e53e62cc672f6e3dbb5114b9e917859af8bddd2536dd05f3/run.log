[0m[49m[38;5;10m+    702[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    703[0m:[38;5;10m[49m     // Confirm the boundary really is between 10 and 11 in the C, so the row is
[0m[49m[38;5;10m+    704[0m:[38;5;10m[49m     // testing what ERRORS.md claims.
[0m[49m[38;5;10m+    705[0m:[38;5;10m[49m     let c = pair.c();
