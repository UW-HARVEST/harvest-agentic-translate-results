[0m[49m[38;5;10m+    724[0m:[38;5;10m[49m     let header = std::fs::read_to_string(
[0m[49m[38;5;10m+    725[0m:[38;5;10m[49m         workspace_root().join("c_src").join("include").join("lib.h"),
[0m[49m[38;5;10m+    726[0m:[38;5;10m[49m     )
[0m[49m[38;5;10m+    727[0m:[38;5;10m[49m     .expect("read lib.h");
[0m[49m[38;5;10m+    728[0m:[38;5;10m[49m     let decl = header
