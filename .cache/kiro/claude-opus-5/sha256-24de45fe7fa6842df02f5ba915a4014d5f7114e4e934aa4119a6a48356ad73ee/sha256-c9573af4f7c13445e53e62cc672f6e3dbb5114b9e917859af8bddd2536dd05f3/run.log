[0m[49m[38;5;10m+    734[0m:[38;5;10m[49m         "E6/E8 assume no pointer parameters, but the declaration is: {decl}"
[0m[49m[38;5;10m+    735[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    736[0m:[38;5;10m[49m     assert!(
