[49m[38;5;10m+    549[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    550[0m:[38;5;10m[49m /// Row 31 — `floorf` implementation parity.
[0m[49m[38;5;10m+    551[0m:[38;5;10m[49m ///
[0m[49m[38;5;10m+    552[0m:[38;5;10m[49m /// The C `.so` imports `floorf@GLIBC_2.2.5`; the Rust `.so` resolves its
[0m[49m[38;5;10m+    553[0m:[38;5;10m[49m /// `floorf` to a *local* copy supplied by `compiler_builtins`' libm (`nm` shows
[0m[49m[38;5;10m+    554[0m:[38;5;10m[49m /// `t floorf`, a local text symbol). Those are two different implementations of
[0m[49m[38;5;10m+    555[0m:[38;5;10m[49m /// the same exactly-specified operation, so this row hammers the hue axis
[0m[49m[38;5;10m+    556[0m:[38;5;10m[49m /// specifically — a strided sweep over the entire `f32` bit space plus a dense
[0m[49m[38;5;10m+    557[0m:[38;5;10m[49m /// pseudo-random sweep — to confirm the sector index they produce is identical
[0m[49m[38;5;10m+    558[0m:[38;5;10m[49m /// for every hue class.
[0m[49m[38;5;10m+    559[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    560[0m:[38;5;10m[49m fn cfg_31_floorf_implementation_parity() {
[0m[49m[38;5;10m+    561[0m:[38;5;10m[49m     // Strided sweep over all 2^32 bit patterns (prime stride => hits every
[0m[49m[38;5;10m+    562[0m:[38;5;10m[49m     // exponent and a well-spread set of mantissas).
[0m[49m[38;5;10m+    563[0m:[38;5;10m[49m     const STRIDE: u32 = 4_093;
[0m[49m[38;5;10m+    564[0m:[38;5;10m[49m     let mut bits: u32 = 0;
[0m[49m[38;5;10m+    565[0m:[38;5;10m[49m     let mut n: u64 = 0;
[0m[49m[38;5;10m+    566[0m:[38;5;10m[49m     loop {
[0m[49m[38;5;10m+    567[0m:[38;5;10m[49m         let h = f32::from_bits(bits);
[0m[49m[38;5;10m+    568[0m:[38;5;10m[49m         // s = 1 keeps p exactly 0 and makes q/t depend directly on f, so a
[0m[49m[38;5;10m+    569[0m:[38;5;10m[49m         // one-ULP error in the floor result is visible in the output.
[0m[49m[38;5;10m+    570[0m:[38;5;10m[49m         assert_same("cfg31", &[h, 1.0, 1.0]);
[0m[49m[38;5;10m+    571[0m:[38;5;10m[49m         assert_same("cfg31", &[h, 0.375, 0.625]);
[0m[49m[38;5;10m+    572[0m:[38;5;10m[49m         n += 1;
[0m[49m[38;5;10m+    573[0m:[38;5;10m[49m         let (next, ovf) = bits.overflowing_add(STRIDE);
[0m[49m[38;5;10m+    574[0m:[38;5;10m[49m         if ovf {
[0m[49m[38;5;10m+    575[0m:[38;5;10m[49m             break;
[0m[49m[38;5;10m+    576[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    577[0m:[38;5;10m[49m         bits = next;
[0m[49m[38;5;10m+    578[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    579[0m:[38;5;10m[49m     assert!(n > 1_000_000, "expected >1e6 strided hue samples, got {n}");
[0m[49m[38;5;10m+    580[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    581[0m:[38;5;10m[49m     // Dense pseudo-random hue bit patterns with randomized s/v.
[0m[49m[38;5;10m+    582[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 31);
[0m[49m[38;5;10m+    583[0m:[38;5;10m[49m     for _ in 0..300_000 {
[0m[49m[38;5;10m+    584[0m:[38;5;10m[49m         let h = f32::from_bits(rng.next_u32());
[0m[49m[38;5;10m+    585[0m:[38;5;10m[49m         assert_same("cfg31", &[h, rng.range(-2.0, 3.0), rng.range(-100.0, 100.0)]);
[0m[49m[38;5;10m+    586[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    587[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    588[0m:[38;5;10m[49m     // Every hue that is an exact integer number of degrees over a wide span,
[0m[49m[38;5;10m+    589[0m:[38;5;10m[49m     // where the sector boundary lands exactly on a floor step.
[0m[49m[38;5;10m+    590[0m:[38;5;10m[49m     for d in -5000i32..=5000 {
[0m[49m[38;5;10m+    591[0m:[38;5;10m[49m         assert_same("cfg31", &[d as f32, 1.0, 1.0]);
[0m[49m[38;5;10m+    592[0m:[38;5;10m[49m         assert_same("cfg31", &[d as f32 + 0.5, 0.75, 0.25]);
[0m[49m[38;5;10m+    593[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    594[0m:[38;5;10m[49m }
