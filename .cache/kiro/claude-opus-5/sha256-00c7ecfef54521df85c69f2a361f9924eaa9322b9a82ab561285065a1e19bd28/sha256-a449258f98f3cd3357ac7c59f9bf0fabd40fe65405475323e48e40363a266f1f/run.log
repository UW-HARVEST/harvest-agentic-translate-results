[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m         z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m         z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m         z ^ (z >> 31)
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m     fn below(&mut self, n: usize) -> usize {
[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m         (self.next_u64() % n as u64) as usize
[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m }
