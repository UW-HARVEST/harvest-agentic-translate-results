[0m[49m[38;5;10m+    132[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    133[0m:[38;5;10m[49m // `!!b` collapses any non-zero to 1, and `bool b : 1` stores 0 or 1.
[0m[49m[38;5;10m+    134[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    135[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    136[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    137[0m:[38;5;10m[49m fn bool_field_collapses_every_nonzero() {
[0m[49m[38;5;10m+    138[0m:[38;5;10m[49m     for b in [
[0m[49m[38;5;10m+    139[0m:[38;5;10m[49m         "0",
[0m[49m[38;5;10m+    140[0m:[38;5;10m[49m         "1",
[0m[49m[38;5;10m+    141[0m:[38;5;10m[49m         "-1",
[0m[49m[38;5;10m+    142[0m:[38;5;10m[49m         "2",
[0m[49m[38;5;10m+    143[0m:[38;5;10m[49m         "-2",
[0m[49m[38;5;10m+    144[0m:[38;5;10m[49m         "5",
[0m[49m[38;5;10m+    145[0m:[38;5;10m[49m         "-3",
[0m[49m[38;5;10m+    146[0m:[38;5;10m[49m         "256",
[0m[49m[38;5;10m+    147[0m:[38;5;10m[49m         "2147483647",
[0m[49m[38;5;10m+    148[0m:[38;5;10m[49m         "-2147483648",
[0m[49m[38;5;10m+    149[0m:[38;5;10m[49m         "2147483648",
[0m[49m[38;5;10m+    150[0m:[38;5;10m[49m         "4294967296",
[0m[49m[38;5;10m+    151[0m:[38;5;10m[49m         "-4294967296",
[0m[49m[38;5;10m+    152[0m:[38;5;10m[49m         "9223372036854775807",
[0m[49m[38;5;10m+    153[0m:[38;5;10m[49m         "-9223372036854775808",
[0m[49m[38;5;10m+    154[0m:[38;5;10m[49m         "99999999999999999999999",
[0m[49m[38;5;10m+    155[0m:[38;5;10m[49m         "-99999999999999999999999",
[0m[49m[38;5;10m+    156[0m:[38;5;10m[49m     ] {
[0m[49m[38;5;10m+    157[0m:[38;5;10m[49m         assert_same_str("bool field", &format!("0 0 {b} 0"));
[0m[49m[38;5;10m+    158[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    159[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    160[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    161[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    162[0m:[38;5;10m[49m // `int z` is stored without truncation, so the full signed range matters,
[0m[49m[38;5;10m+    163[0m:[38;5;10m[49m // as does the wrap that `%d` performs when the value exceeds `int`.
[0m[49m[38;5;10m+    164[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    165[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    166[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    167[0m:[38;5;10m[49m fn z_field_across_the_int_range() {
[0m[49m[38;5;10m+    168[0m:[38;5;10m[49m     for z in [
[0m[49m[38;5;10m+    169[0m:[38;5;10m[49m         "0",
[0m[49m[38;5;10m+    170[0m:[38;5;10m[49m         "1",
[0m[49m[38;5;10m+    171[0m:[38;5;10m[49m         "-1",
[0m[49m[38;5;10m+    172[0m:[38;5;10m[49m         "42",
[0m[49m[38;5;10m+    173[0m:[38;5;10m[49m         "-42",
[0m[49m[38;5;10m+    174[0m:[38;5;10m[49m         "2147483646",
[0m[49m[38;5;10m+    175[0m:[38;5;10m[49m         "2147483647",  // INT_MAX
[0m[49m[38;5;10m+    176[0m:[38;5;10m[49m         "2147483648",  // INT_MAX + 1, wraps
[0m[49m[38;5;10m+    177[0m:[38;5;10m[49m         "2147483649",
[0m[49m[38;5;10m+    178[0m:[38;5;10m[49m         "-2147483647",
[0m[49m[38;5;10m+    179[0m:[38;5;10m[49m         "-2147483648", // INT_MIN
[0m[49m[38;5;10m+    180[0m:[38;5;10m[49m         "-2147483649", // INT_MIN - 1, wraps
[0m[49m[38;5;10m+    181[0m:[38;5;10m[49m         "4294967295",
[0m[49m[38;5;10m+    182[0m:[38;5;10m[49m         "4294967296",
[0m[49m[38;5;10m+    183[0m:[38;5;10m[49m         "4294967297",
[0m[49m[38;5;10m+    184[0m:[38;5;10m[49m         "-4294967296",
[0m[49m[38;5;10m+    185[0m:[38;5;10m[49m     ] {
[0m[49m[38;5;10m+    186[0m:[38;5;10m[49m         assert_same_str("z value", &format!("0 0 0 {z}"));
[0m[49m[38;5;10m+    187[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    188[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    189[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    190[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    191[0m:[38;5;10m[49m // Overflow, truncation and signedness exactly as the C library performs them:
[0m[49m[38;5;10m+    192[0m:[38;5;10m[49m // `%u` goes through `strtoul` (wraps a negative, saturates at `ULONG_MAX`),
[0m[49m[38;5;10m+    193[0m:[38;5;10m[49m // `%d` through `strtol` (saturates at `LONG_MIN`/`LONG_MAX`), and the 64-bit
[0m[49m[38;5;10m+    194[0m:[38;5;10m[49m // result is then truncated into the 32-bit destination.
[0m[49m[38;5;10m+    195[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    196[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    197[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    198[0m:[38;5;10m[49m fn unsigned_conversion_boundaries() {
[0m[49m[38;5;10m+    199[0m:[38;5;10m[49m     for v in [
[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m         "4294967295",           // UINT_MAX
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m         "4294967296",           // 2^32, truncates to 0
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m         "4294967297",           // 2^32 + 1
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m         "9223372036854775807",  // LONG_MAX
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m         "9223372036854775808",  // 2^63
[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m         "18446744073709551615", // ULONG_MAX
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m         "18446744073709551616", // ULONG_MAX + 1, saturates
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m         "18446744073709551617",
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m         "99999999999999999999999999999999",
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m     ] {
[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m         assert_same_str("u boundary in x", &format!("{v} 0 0 0"));
[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m         assert_same_str("u boundary in y", &format!("0 {v} 0 0"));
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    216[0m:[38;5;10m[49m fn negative_values_for_an_unsigned_conversion() {
[0m[49m[38;5;10m+    217[0m:[38;5;10m[49m     // `%u` accepts a sign; the value wraps modulo 2^64 before truncation.
[0m[49m[38;5;10m+    218[0m:[38;5;10m[49m     for v in [
[0m[49m[38;5;10m+    219[0m:[38;5;10m[49m         "-0",
[0m[49m[38;5;10m+    220[0m:[38;5;10m[49m         "-1",
[0m[49m[38;5;10m+    221[0m:[38;5;10m[49m         "-2",
[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m         "-3",
[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m         "-4",
[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m         "-8",
[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m         "-4294967295",
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m         "-4294967296",
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m         "-4294967297",
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m         "-18446744073709551615", // wraps to 1
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m         "-18446744073709551616", // saturates
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m         "-99999999999999999999999",
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m     ] {
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m         assert_same_str("negative u in x", &format!("{v} 0 0 0"));
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m         assert_same_str("negative u in y", &format!("0 {v} 0 0"));
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    236[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    237[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m fn signed_conversion_boundaries() {
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m     for v in [
[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m         "9223372036854775806",
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m         "9223372036854775807",  // LONG_MAX
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m         "9223372036854775808",  // LONG_MAX + 1, saturates then truncates
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m         "9223372036854775809",
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m         "-9223372036854775807",
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m         "-9223372036854775808", // LONG_MIN
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m         "-9223372036854775809", // LONG_MIN - 1, saturates then truncates
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m         "18446744073709551615",
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m         "18446744073709551616",
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m         "99999999999999999999999",
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m         "-99999999999999999999999",
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m     ] {
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m         assert_same_str("d boundary in z", &format!("0 0 0 {v}"));
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m         assert_same_str("d boundary in b", &format!("0 0 {v} 0"));
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m fn very_long_digit_runs() {
[0m[49m[38;5;10m+    259[0m:[38;5;10m[49m     for len in [19usize, 20, 21, 39, 40, 128, 1000] {
[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m         let nines = "9".repeat(len);
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m         assert_same_str("long run of nines for u", &format!("{nines} 0 0 0"));
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m         assert_same_str("long run of nines for d", &format!("0 0 0 {nines}"));
[0m[49m[38;5;10m+    263[0m:[38;5;10m[49m         assert_same_str("long negative run for d", &format!("0 0 0 -{nines}"));
[0m[49m[38;5;10m+    264[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    265[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    266[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m fn leading_zeros_do_not_change_the_value() {
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m     assert_same_str("leading zeros", "0003 0007 0001 0009");
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m     assert_same_str("many leading zeros", "0000000000000000005 0 0 0");
