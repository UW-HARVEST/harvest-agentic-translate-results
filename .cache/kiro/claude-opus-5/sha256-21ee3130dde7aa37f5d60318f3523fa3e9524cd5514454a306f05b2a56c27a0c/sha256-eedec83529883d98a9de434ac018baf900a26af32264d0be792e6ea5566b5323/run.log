[0m[49m[38;5;10m+    443[0m:[38;5;10m[49m         use std::os::unix::process::ExitStatusExt;
[0m[49m[38;5;10m+    444[0m:[38;5;10m[49m         (output.status.code(), output.status.signal(), output.stderr)
[0m[49m[38;5;10m+    445[0m:[38;5;10m[49m     };
[0m[49m[38;5;10m+    446[0m:[38;5;10m[49m 
