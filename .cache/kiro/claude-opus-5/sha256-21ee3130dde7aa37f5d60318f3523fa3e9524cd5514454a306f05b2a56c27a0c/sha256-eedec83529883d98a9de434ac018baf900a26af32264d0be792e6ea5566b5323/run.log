[0m[49m[38;5;10m+    316[0m:[38;5;10m[49m     assert_same_str("bad third value", "1 2 x 4");
[0m[49m[38;5;10m+    317[0m:[38;5;10m[49m     assert_same_str("bad fourth value", "1 2 3 x");
[0m[49m[38;5;10m+    318[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    319[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    320[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    321[0m:[38;5;10m[49m fn a_stuck_stream_stays_stuck() {
