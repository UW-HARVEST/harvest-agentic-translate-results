[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    277[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    278[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    279[0m:[38;5;10m[49m // Sign handling, including the cases where a sign is accepted and then no
[0m[49m[38;5;10m+    280[0m:[38;5;10m[49m // digit follows (a matching failure that leaves the destination untouched).
[0m[49m[38;5;10m+    281[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    282[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    283[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    284[0m:[38;5;10m[49m fn explicit_plus_signs_are_accepted() {
[0m[49m[38;5;10m+    285[0m:[38;5;10m[49m     assert_same_str("all plus", "+1 +2 +1 +7");
[0m[49m[38;5;10m+    286[0m:[38;5;10m[49m     assert_same_str("plus zero", "+0 +0 +0 +0");
[0m[49m[38;5;10m+    287[0m:[38;5;10m[49m     assert_same_str("mixed signs", "+3 -1 +0 -5");
[0m[49m[38;5;10m+    288[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    289[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    290[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    291[0m:[38;5;10m[49m fn a_sign_with_no_digits_is_a_matching_failure() {
[0m[49m[38;5;10m+    292[0m:[38;5;10m[49m     assert_same_str("lone minus then space", "- 1 2 3");
[0m[49m[38;5;10m+    293[0m:[38;5;10m[49m     assert_same_str("lone plus then space", "+ 1 2 3");
[0m[49m[38;5;10m+    294[0m:[38;5;10m[49m     assert_same_str("double minus", "--1 2 3 4");
[0m[49m[38;5;10m+    295[0m:[38;5;10m[49m     assert_same_str("plus then minus", "+-1 2 3 4");
[0m[49m[38;5;10m+    296[0m:[38;5;10m[49m     assert_same_str("minus then plus", "-+1 2 3 4");
[0m[49m[38;5;10m+    297[0m:[38;5;10m[49m     assert_same_str("lone minus at end of input", "1 2 3 -");
[0m[49m[38;5;10m+    298[0m:[38;5;10m[49m     assert_same_str("lone plus at end of input", "1 2 3 +");
[0m[49m[38;5;10m+    299[0m:[38;5;10m[49m     assert_same_str("only a minus", "-");
[0m[49m[38;5;10m+    300[0m:[38;5;10m[49m     assert_same_str("only a plus", "+");
[0m[49m[38;5;10m+    301[0m:[38;5;10m[49m     assert_same_str("only signs", "----");
[0m[49m[38;5;10m+    302[0m:[38;5;10m[49m     assert_same_str("sign then newline", "-\n1 2 3");
[0m[49m[38;5;10m+    303[0m:[38;5;10m[49m     assert_same_str("sign then letter", "-a 1 2 3");
[0m[49m[38;5;10m+    304[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    305[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    306[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    307[0m:[38;5;10m[49m // Matching failures at each of the four positions. The offending byte stays in
[0m[49m[38;5;10m+    308[0m:[38;5;10m[49m // the stream, so once a conversion fails on a non-digit every later conversion
[0m[49m[38;5;10m+    309[0m:[38;5;10m[49m // fails too; that stickiness is part of the behaviour being matched.
[0m[49m[38;5;10m+    310[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    311[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    312[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    313[0m:[38;5;10m[49m fn matching_failure_at_each_position() {
[0m[49m[38;5;10m+    314[0m:[38;5;10m[49m     assert_same_str("bad first value", "x 1 2 3");
