struct tflac { u32 samplerate, channels, bitdepth; u8 channel_mode; u32 frame_header, cur_blocksize; };
int main(int argc, char**argv){
  void*h=dlopen(argv[1],RTLD_NOW); if(!h){fprintf(stderr,"%s\n",dlerror());return 1;}
  void(*f)(struct tflac*)=dlsym(h,"update_frame_header"); if(!f){fprintf(stderr,"nosym\n");return 1;}
  u32 rates[]={0,1,10,100,999,1000,8000,16000,22050,24000,32000,44100,48000,96000,176400,192000,882000,
               255000,256000,257000,65535,65536,65530,655350,655360,1000000,4294967295u,123456,70000,70001};
  u32 bs[]={0,1,192,255,256,257,512,576,1024,1152,2048,2304,4096,4608,8192,16384,32768,65535,4294967295u};
  u32 bd[]={0,1,8,12,16,20,24,32,33,255};
  u32 ch[]={0,1,2,3,8,255,4294967295u};
  for(unsigned a=0;a<sizeof rates/4;a++)for(unsigned b=0;b<sizeof bs/4;b++)
  for(unsigned c=0;c<sizeof bd/4;c++)for(unsigned d=0;d<sizeof ch/4;d++)for(u32 m=0;m<8;m++){
