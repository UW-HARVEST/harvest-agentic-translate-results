[0m[49m[38;5;10m+    329[0m:[38;5;10m[49m     assert!(!text.contains("\r"), "no CR: the format string is \"%d\\n\"");
[0m[49m[38;5;10m+    330[0m:[38;5;10m[49m     for l in &lines {
[0m[49m[38;5;10m+    331[0m:[38;5;10m[49m         assert!(!l.is_empty());
[0m[49m[38;5;10m+    332[0m:[38;5;10m[49m         assert!(!l.starts_with(' ') && !l.ends_with(' '), "no padding in \"%d\"");
[0m[49m[38;5;10m+    333[0m:[38;5;10m[49m         assert!(
[0m[49m[38;5;10m+    334[0m:[38;5;10m[49m             l.parse::<i32>().is_ok(),
[0m[49m[38;5;10m+    335[0m:[38;5;10m[49m             "each line must be a bare decimal i32, got {l:?}"
[0m[49m[38;5;10m+    336[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    337[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    338[0m:[38;5;10m[49m     // -20, -20+1, ... : the first few are negative, later ones positive.
[0m[49m[38;5;10m+    339[0m:[38;5;10m[49m     assert_eq!(lines[0], "-20");
