[0m[49m[38;5;10m+    324[0m:[38;5;10m[49m     let out = h.driver(1);
[0m[49m[38;5;10m+    325[0m:[38;5;10m[49m     let text = String::from_utf8(out.clone()).expect("stdout must be valid ASCII");
[0m[49m[38;5;10m+    326[0m:[38;5;10m[49m     let lines: Vec<&str> = text.split_terminator('\n').collect();
