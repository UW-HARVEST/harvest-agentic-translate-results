[0m[49m[38;5;10m+    505[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    506[0m:[38;5;10m[49m /// A deterministic sweep, so a regression anywhere in the parser shows up even
[0m[49m[38;5;10m+    507[0m:[38;5;10m[49m /// if no hand-written case names it.
[0m[49m[38;5;10m+    508[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    509[0m:[38;5;10m[49m fn pseudo_random_sweep() {
[0m[49m[38;5;10m+    510[0m:[38;5;10m[49m     let mut d = Differ::new();
[0m[49m[38;5;10m+    511[0m:[38;5;10m[49m     let mut state: u64 = 0x1234_5678_9abc_def1;
[0m[49m[38;5;10m+    512[0m:[38;5;10m[49m     let mut next = |n: u64| -> u64 {
[0m[49m[38;5;10m+    513[0m:[38;5;10m[49m         state ^= state << 13;
[0m[49m[38;5;10m+    514[0m:[38;5;10m[49m         state ^= state >> 7;
[0m[49m[38;5;10m+    515[0m:[38;5;10m[49m         state ^= state << 17;
[0m[49m[38;5;10m+    516[0m:[38;5;10m[49m         state % n
[0m[49m[38;5;10m+    517[0m:[38;5;10m[49m     };
[0m[49m[38;5;10m+    518[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    519[0m:[38;5;10m[49m     for _ in 0..500 {
[0m[49m[38;5;10m+    520[0m:[38;5;10m[49m         let s = match next(6) {
[0m[49m[38;5;10m+    521[0m:[38;5;10m[49m             0 => format!("{}.{}e{}", next(1_000_000), next(1_000_000),
[0m[49m[38;5;10m+    522[0m:[38;5;10m[49m                          next(120) as i64 - 60),
[0m[49m[38;5;10m+    523[0m:[38;5;10m[49m             1 => format!("-{}.{}e{}", next(1_000_000), next(1_000_000),
[0m[49m[38;5;10m+    524[0m:[38;5;10m[49m                          next(120) as i64 - 60),
[0m[49m[38;5;10m+    525[0m:[38;5;10m[49m             2 => format!("0x{:x}p{}", next(u64::MAX), next(320) as i64 - 160),
[0m[49m[38;5;10m+    526[0m:[38;5;10m[49m             3 => format!("0x{:x}.{:x}p{}", next(1 << 30), next(1u64 << 40),
[0m[49m[38;5;10m+    527[0m:[38;5;10m[49m                          next(320) as i64 - 160),
[0m[49m[38;5;10m+    528[0m:[38;5;10m[49m             4 => {
[0m[49m[38;5;10m+    529[0m:[38;5;10m[49m                 // random garbage drawn from characters the parser reacts to
[0m[49m[38;5;10m+    530[0m:[38;5;10m[49m                 const ALPHABET: &[u8] = b"0123456789+-.eExXaAfFiInNtTyY() \t";
[0m[49m[38;5;10m+    531[0m:[38;5;10m[49m                 let len = next(14) as usize + 1;
[0m[49m[38;5;10m+    532[0m:[38;5;10m[49m                 (0..len)
[0m[49m[38;5;10m+    533[0m:[38;5;10m[49m                     .map(|_| ALPHABET[next(ALPHABET.len() as u64) as usize] as char)
[0m[49m[38;5;10m+    534[0m:[38;5;10m[49m                     .collect()
[0m[49m[38;5;10m+    535[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    536[0m:[38;5;10m[49m             _ => format!("{}e-{}", next(1 << 40), next(50)),
[0m[49m[38;5;10m+    537[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+    538[0m:[38;5;10m[49m         d.check_str(&s);
[0m[49m[38;5;10m+    539[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    540[0m:[38;5;10m[49m     d.finish("pseudo-random");
[0m[49m[38;5;10m+    541[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    542[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    543[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    544[0m:[38;5;10m[49m // Exit status and signal behaviour
[0m[49m[38;5;10m+    545[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    546[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    547[0m:[38;5;10m[49m /// `main` always `return 0`, on every path, including matching failure.
[0m[49m[38;5;10m+    548[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    549[0m:[38;5;10m[49m fn exit_status_is_always_zero_on_normal_runs() {
