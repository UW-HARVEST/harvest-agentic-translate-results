[0m[49m[38;5;10m+    428[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    429[0m:[38;5;10m[49m fn round_half_to_even() {
[0m[49m[38;5;10m+    430[0m:[38;5;10m[49m     let mut d = Differ::new();
[0m[49m[38;5;10m+    431[0m:[38;5;10m[49m     for s in [
[0m[49m[38;5;10m+    432[0m:[38;5;10m[49m         "16777216", "16777217", "16777218", "16777219", "16777220",
[0m[49m[38;5;10m+    433[0m:[38;5;10m[49m         "8388609e-1", "1.000000059604644775390625",
[0m[49m[38;5;10m+    434[0m:[38;5;10m[49m         "1.0000000596046447753906250001", "2.00000011920928955078125",
[0m[49m[38;5;10m+    435[0m:[38;5;10m[49m         "0x1000001p0", "0x1000003p0", "0x800000.8p1", "0x800001.8p1",
[0m[49m[38;5;10m+    436[0m:[38;5;10m[49m         "0x1.0000008p0", "0x1.0000018p0", "0x1.0000001p0",
