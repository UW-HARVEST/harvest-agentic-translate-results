[0m[49m[38;5;10m+    407[0m:[38;5;10m[49m         "3.40282346638528859812e+38",
[0m[49m[38;5;10m+    408[0m:[38;5;10m[49m         "3.40282356779733661637e+38",
[0m[49m[38;5;10m+    409[0m:[38;5;10m[49m         "3.40282366920938463463e+38",
