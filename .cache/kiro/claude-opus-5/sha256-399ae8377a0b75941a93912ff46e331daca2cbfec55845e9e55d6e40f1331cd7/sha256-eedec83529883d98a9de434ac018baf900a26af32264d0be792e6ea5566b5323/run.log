[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m     assert_eq!(expected, actual, "baseline run differs");
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m     // sanity: 1.5f32 == 0x3fc00000, printed little-endian byte by byte
[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m     assert_eq!(expected.stdout, b"0000c03f\n");
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m     assert_eq!(expected.stderr, b"");
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m     assert_eq!(expected.status, Ok(0));
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
