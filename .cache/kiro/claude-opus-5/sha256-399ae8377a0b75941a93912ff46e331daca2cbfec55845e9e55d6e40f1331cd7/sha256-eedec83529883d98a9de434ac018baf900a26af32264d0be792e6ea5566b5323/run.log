[0m[49m[38;5;10m+    190[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    191[0m:[38;5;10m[49m // Phase A -- both programs exist, run, and agree on the simplest input
[0m[49m[38;5;10m+    192[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    193[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    194[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    195[0m:[38;5;10m[49m fn both_programs_build_and_run() {
[0m[49m[38;5;10m+    196[0m:[38;5;10m[49m     let c = c_bin();
