[0m[49m[38;5;10m+    412[0m:[38;5;10m[49m         "1.17549421069244107e-38",
[0m[49m[38;5;10m+    413[0m:[38;5;10m[49m         "1.40129846432481707e-45",
[0m[49m[38;5;10m+    414[0m:[38;5;10m[49m         "7.00649232162408535e-46",
[0m[49m[38;5;10m+    415[0m:[38;5;10m[49m         "7.00649232162408536e-46",
[0m[49m[38;5;10m+    416[0m:[38;5;10m[49m         "2.938735877055718770e-39",
[0m[49m[38;5;10m+    417[0m:[38;5;10m[49m         "1e-45", "1.5e-45", "2.5e-45", "1e-46", "7e-46", "7.1e-46",
