[0m[49m[38;5;10m+    199[0m:[38;5;10m[49m     assert!(r.exists(), "Rust binary missing at {}", r.display());
[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m     let expected = run(&c, b"1.5\n");
