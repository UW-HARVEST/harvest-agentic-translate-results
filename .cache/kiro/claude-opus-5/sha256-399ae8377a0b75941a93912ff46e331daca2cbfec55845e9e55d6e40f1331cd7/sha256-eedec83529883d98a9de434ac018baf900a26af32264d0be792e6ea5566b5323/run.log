[0m[49m[38;5;10m+    375[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    376[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    377[0m:[38;5;10m[49m /// Raw bytes, including NUL and bytes outside ASCII.
[0m[49m[38;5;10m+    378[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    379[0m:[38;5;10m[49m fn binary_and_non_ascii_input() {
[0m[49m[38;5;10m+    380[0m:[38;5;10m[49m     let mut d = Differ::new();
[0m[49m[38;5;10m+    381[0m:[38;5;10m[49m     for b in [
[0m[49m[38;5;10m+    382[0m:[38;5;10m[49m         &b"\x00"[..], b"\xff\xfe", b"\x001", b"1\x00", b"\x7f", b"\x80\x81",
[0m[49m[38;5;10m+    383[0m:[38;5;10m[49m         b"\xc3\xa9", b"1.5\x00abc", b"\xef\xbb\xbf1.5", b"-\xff",
