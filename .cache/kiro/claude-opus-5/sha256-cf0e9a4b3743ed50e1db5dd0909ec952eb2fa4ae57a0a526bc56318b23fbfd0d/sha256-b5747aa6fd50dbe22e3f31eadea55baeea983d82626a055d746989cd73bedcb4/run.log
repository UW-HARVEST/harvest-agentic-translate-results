import re
src=open('c_src/src/utfdata.h').read()
out=["// Generated from c_src/src/utfdata.h\n#![allow(dead_code)]\nuse crate::utf::Rune;\n"]
for m in re.finditer(r'static const Rune (\w+)\[\] = \{(.*?)\n\};', src, re.S):
    name, body = m.group(1), m.group(2)
    vals=[v.strip() for v in body.replace('\n','').split(',') if v.strip()]
    out.append(f"pub static {name}: [Rune; {len(vals)}] = [")
    # chunk lines
    for i in range(0,len(vals),12):
        out.append("    "+", ".join(vals[i:i+12])+",")
    out.append("];\n")
open('translation/src/utfdata.rs','w').write("\n".join(out))
print("ok")
EOF
