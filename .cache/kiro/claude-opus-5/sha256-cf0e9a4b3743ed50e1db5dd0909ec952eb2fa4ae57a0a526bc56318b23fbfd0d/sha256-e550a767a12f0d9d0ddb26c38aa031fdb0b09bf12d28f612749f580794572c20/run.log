[0m[49m[38;5;10m+     61[0m:[38;5;10m[49m ## 3. Types
[0m[49m[38;5;10m+     62[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     63[0m:[38;5;10m[49m | C | Rust |
[0m[49m[38;5;10m+     64[0m:[38;5;10m[49m |---|---|
[0m[49m[38;5;10m+     65[0m:[38;5;10m[49m | `int` | `c_int` |
[0m[49m[38;5;10m+     66[0m:[38;5;10m[49m | `unsigned int` | `c_uint` |
[0m[49m[38;5;10m+     67[0m:[38;5;10m[49m | `char` | `c_char` (**signed**, i8) |
[0m[49m[38;5;10m+     68[0m:[38;5;10m[49m | `const char *` | `*const c_char` |
[0m[49m[38;5;10m+     69[0m:[38;5;10m[49m | `double` | `f64` |
[0m[49m[38;5;10m+     70[0m:[38;5;10m[49m | `short`/`unsigned short` | `c_short`/`c_ushort` |
[0m[49m[38;5;10m+     71[0m:[38;5;10m[49m | `void *` | `*mut c_void` |
