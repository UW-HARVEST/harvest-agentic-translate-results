typedef void (*drv_t)(unsigned int, unsigned int, unsigned char, int);
typedef struct { unsigned int bits; int z; } foo_raw;
typedef void (*pf_t)(const void*);
int main(int argc, char**argv){
  void *h = dlopen(argv[1], RTLD_NOW);
  if(!h){ fprintf(stderr,"%s\n", dlerror()); return 1; }
  drv_t driver = (drv_t)dlsym(h, "driver");
  pf_t print_foo = (pf_t)dlsym(h, "print_foo");
  if(!driver||!print_foo){ fprintf(stderr,"missing symbol\n"); return 1; }
  unsigned int vals[] = {0u,1u,2u,3u,4u,5u,6u,7u,8u,255u,4294967295u};
  int zs[] = {0,1,-1,42,-2147483648,2147483647};
  unsigned char bs[] = {0,1,2,255};
  for(size_t i=0;i<sizeof vals/sizeof*vals;i++)
   for(size_t j=0;j<sizeof vals/sizeof*vals;j++)
    for(size_t k=0;k<sizeof bs/sizeof*bs;k++)
     for(size_t m=0;m<sizeof zs/sizeof*zs;m++)
      driver(vals[i], vals[j], bs[k], zs[m]);
  /* exercise print_foo directly over every bit pattern of the storage unit */
  for(unsigned int u=0; u<256u; u++){ foo_raw f = { u, (int)u - 128 }; print_foo(&f); }
  dlclose(h);
  return 0;
}
