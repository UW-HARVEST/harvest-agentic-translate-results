#include <dlfcn.h>
#include <stdio.h>
#include <stdlib.h>
#include <stdint.h>
typedef void (*driver_fn)(unsigned int, unsigned int, unsigned char, int);
typedef void (*print_foo_fn)(const void *);
int main(int argc, char **argv) {
    void *h = dlopen(argv[1], RTLD_NOW);
    if (!h) { fprintf(stderr, "dlopen: %s\n", dlerror()); return 1; }
    driver_fn driver = (driver_fn)dlsym(h, "driver");
    print_foo_fn print_foo = (print_foo_fn)dlsym(h, "print_foo");
    if (!driver || !print_foo) { fprintf(stderr, "dlsym failed\n"); return 1; }

    unsigned int vals[] = {0u,1u,2u,3u,4u,5u,6u,7u,8u,9u,15u,16u,31u,255u,256u,
                           0x7fffffffu,0x80000000u,0xfffffffeu,0xffffffffu,12345u};
    int zs[] = {0,1,-1,42,-42,2147483647,-2147483648,-999999,123456789};
    unsigned char bs[] = {0,1,2,3,0xff,0x80};
    size_t nv = sizeof(vals)/sizeof(*vals), nz = sizeof(zs)/sizeof(*zs), nb = sizeof(bs)/sizeof(*bs);
    for (size_t i=0;i<nv;i++) for (size_t j=0;j<nv;j++) for (size_t k=0;k<nb;k++) for (size_t m=0;m<nz;m++)
        driver(vals[i], vals[j], bs[k], zs[m]);

    /* exercise print_foo directly over every possible bit pattern of byte 0 */
    for (unsigned pat = 0; pat < 256; pat++) {
        for (size_t m=0;m<nz;m++) {
            unsigned char buf[8];
            buf[0] = (unsigned char)pat; buf[1]=0xAA; buf[2]=0xBB; buf[3]=0xCC;
            int z = zs[m];
            memcpy(buf+4, &z, 4);
            print_foo(buf);
        }
    }
    fflush(stdout);
    return 0;
}
EOF
