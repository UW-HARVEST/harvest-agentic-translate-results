    if isinstance(b,str): b=b.encode('latin1',errors='replace')
    i=0
    while i<len(b) and b[i:i+1] in b' \t\n\x0b\x0c\r': i+=1
    neg=False
    if i<len(b) and b[i:i+1] in b'+-':
        neg = b[i:i+1]==b'-'; i+=1
    s=i; acc=0
    while i<len(b) and 48<=b[i]<=57:
        acc=acc*10+(b[i]-48); i+=1
    if i==s: return 0
    v=-acc if neg else acc
    if v>2**63-1: v=2**63-1
    if v<-2**63: v=-2**63
    return v
