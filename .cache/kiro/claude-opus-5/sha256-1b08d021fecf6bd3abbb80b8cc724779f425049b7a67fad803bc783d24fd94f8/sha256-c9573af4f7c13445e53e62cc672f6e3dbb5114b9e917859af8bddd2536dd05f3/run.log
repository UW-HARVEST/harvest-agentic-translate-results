[0m[49m[38;5;10m+    414[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    415[0m:[38;5;10m[49m // Divergence accounting
[0m[49m[38;5;10m+    416[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    417[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    418[0m:[38;5;10m[49m /// Collects mismatches so a failing row reports a representative sample rather
[0m[49m[38;5;10m+    419[0m:[38;5;10m[49m /// than only the first bad input.
[0m[49m[38;5;10m+    420[0m:[38;5;10m[49m pub struct Diff {
[0m[49m[38;5;10m+    421[0m:[38;5;10m[49m     row: String,
[0m[49m[38;5;10m+    422[0m:[38;5;10m[49m     checked: usize,
[0m[49m[38;5;10m+    423[0m:[38;5;10m[49m     failures: Vec<String>,
[0m[49m[38;5;10m+    424[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    425[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    426[0m:[38;5;10m[49m const MAX_REPORTED: usize = 12;
[0m[49m[38;5;10m+    427[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    428[0m:[38;5;10m[49m impl Diff {
[0m[49m[38;5;10m+    429[0m:[38;5;10m[49m     pub fn new(row: impl Into<String>) -> Diff {
[0m[49m[38;5;10m+    430[0m:[38;5;10m[49m         Diff {
[0m[49m[38;5;10m+    431[0m:[38;5;10m[49m             row: row.into(),
[0m[49m[38;5;10m+    432[0m:[38;5;10m[49m             checked: 0,
[0m[49m[38;5;10m+    433[0m:[38;5;10m[49m             failures: Vec::new(),
[0m[49m[38;5;10m+    434[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    435[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    436[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    437[0m:[38;5;10m[49m     pub fn eq<T: PartialEq + std::fmt::Debug>(&mut self, ctx: impl FnOnce() -> String, c: T, r: T) {
[0m[49m[38;5;10m+    438[0m:[38;5;10m[49m         self.checked += 1;
[0m[49m[38;5;10m+    439[0m:[38;5;10m[49m         if c != r {
[0m[49m[38;5;10m+    440[0m:[38;5;10m[49m             if self.failures.len() < MAX_REPORTED {
[0m[49m[38;5;10m+    441[0m:[38;5;10m[49m                 self.failures
[0m[49m[38;5;10m+    442[0m:[38;5;10m[49m                     .push(format!("  {}\n      C={:?}\n   Rust={:?}", ctx(), c, r));
[0m[49m[38;5;10m+    443[0m:[38;5;10m[49m             } else {
[0m[49m[38;5;10m+    444[0m:[38;5;10m[49m                 self.failures.truncate(MAX_REPORTED);
[0m[49m[38;5;10m+    445[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    446[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    447[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    448[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    449[0m:[38;5;10m[49m     /// Bit-exact `f32` comparison (so `NaN != NaN` unless the payloads match,
