[0m[49m[38;5;10m+    313[0m:[38;5;10m[49m             1 => c2v { x: a.x, y: a.y - len },
[0m[49m[38;5;10m+    314[0m:[38;5;10m[49m             2 => c2v { x: a.x + len, y: a.y },
[0m[49m[38;5;10m+    315[0m:[38;5;10m[49m             3 => c2v { x: a.x - len, y: a.y },
