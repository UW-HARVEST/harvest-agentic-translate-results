[0m[49m[38;5;10m+    513[0m:[38;5;10m[49m     )
[0m[49m[38;5;10m+    514[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    515[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    516[0m:[38;5;10m[49m /// Run both raycast-shaped implementations on a pre-filled out-buffer and
[0m[49m[38;5;10m+    517[0m:[38;5;10m[49m /// compare the returned int **and** all 12 out bytes.
[0m[49m[38;5;10m+    518[0m:[38;5;10m[49m pub struct RayResult {
