[0m[49m[38;5;10m+    451[0m:[38;5;10m[49m     pub fn f32_bits(&mut self, ctx: impl FnOnce() -> String, c: f32, r: f32) {
[0m[49m[38;5;10m+    452[0m:[38;5;10m[49m         self.checked += 1;
[0m[49m[38;5;10m+    453[0m:[38;5;10m[49m         if c.to_bits() != r.to_bits() {
[0m[49m[38;5;10m+    454[0m:[38;5;10m[49m             if self.failures.len() < MAX_REPORTED {
[0m[49m[38;5;10m+    455[0m:[38;5;10m[49m                 self.failures.push(format!(
[0m[49m[38;5;10m+    456[0m:[38;5;10m[49m                     "  {}\n      C={:#010x} ({c:e})\n   Rust={:#010x} ({r:e})",
[0m[49m[38;5;10m+    457[0m:[38;5;10m[49m                     ctx(),
[0m[49m[38;5;10m+    458[0m:[38;5;10m[49m                     c.to_bits(),
[0m[49m[38;5;10m+    459[0m:[38;5;10m[49m                     r.to_bits()
[0m[49m[38;5;10m+    460[0m:[38;5;10m[49m                 ));
[0m[49m[38;5;10m+    461[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    462[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    463[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    464[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    465[0m:[38;5;10m[49m     pub fn v_bits(&mut self, ctx: impl Fn() -> String, c: c2v, r: c2v) {
[0m[49m[38;5;10m+    466[0m:[38;5;10m[49m         self.f32_bits(|| format!("{}.x", ctx()), c.x, r.x);
[0m[49m[38;5;10m+    467[0m:[38;5;10m[49m         self.f32_bits(|| format!("{}.y", ctx()), c.y, r.y);
[0m[49m[38;5;10m+    468[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    469[0m:[38;5;10m[49m 
