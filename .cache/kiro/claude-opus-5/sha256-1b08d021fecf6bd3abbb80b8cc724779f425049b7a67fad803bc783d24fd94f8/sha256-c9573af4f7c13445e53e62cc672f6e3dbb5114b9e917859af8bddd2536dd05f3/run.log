[0m[49m[38;5;10m+    473[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    474[0m:[38;5;10m[49m     #[track_caller]
[0m[49m[38;5;10m+    475[0m:[38;5;10m[49m     pub fn finish(self) {
[0m[49m[38;5;10m+    476[0m:[38;5;10m[49m         assert!(
[0m[49m[38;5;10m+    477[0m:[38;5;10m[49m             self.checked > 0,
[0m[49m[38;5;10m+    478[0m:[38;5;10m[49m             "row `{}` performed no comparisons",
[0m[49m[38;5;10m+    479[0m:[38;5;10m[49m             self.row
[0m[49m[38;5;10m+    480[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    481[0m:[38;5;10m[49m         if !self.failures.is_empty() {
[0m[49m[38;5;10m+    482[0m:[38;5;10m[49m             panic!(
[0m[49m[38;5;10m+    483[0m:[38;5;10m[49m                 "row `{}`: {} of {} comparisons diverged (first {} shown)\n{}",
[0m[49m[38;5;10m+    484[0m:[38;5;10m[49m                 self.row,
[0m[49m[38;5;10m+    485[0m:[38;5;10m[49m                 self.failures.len(),
[0m[49m[38;5;10m+    486[0m:[38;5;10m[49m                 self.checked,
[0m[49m[38;5;10m+    487[0m:[38;5;10m[49m                 self.failures.len().min(MAX_REPORTED),
[0m[49m[38;5;10m+    488[0m:[38;5;10m[49m                 self.failures.join("\n")
[0m[49m[38;5;10m+    489[0m:[38;5;10m[49m             );
[0m[49m[38;5;10m+    490[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    491[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    492[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    493[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    494[0m:[38;5;10m[49m /// Formatting helper used in a lot of contexts.
[0m[49m[38;5;10m+    495[0m:[38;5;10m[49m pub fn fv(v: c2v) -> String {
[0m[49m[38;5;10m+    496[0m:[38;5;10m[49m     format!("({:#010x},{:#010x})", v.x.to_bits(), v.y.to_bits())
[0m[49m[38;5;10m+    497[0m:[38;5;10m[49m }
