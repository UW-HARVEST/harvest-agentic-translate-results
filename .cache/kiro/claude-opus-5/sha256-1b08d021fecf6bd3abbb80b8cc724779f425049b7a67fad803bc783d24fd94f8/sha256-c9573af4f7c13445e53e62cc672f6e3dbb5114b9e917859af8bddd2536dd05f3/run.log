[0m[49m[38;5;10m+     788[0m:[38;5;10m[49m         let corner = match i % 4 {
[0m[49m[38;5;10m+     789[0m:[38;5;10m[49m             0 => c2v { x: b.min.x, y: b.min.y },
[0m[49m[38;5;10m+     790[0m:[38;5;10m[49m             1 => c2v { x: b.max.x, y: b.min.y },
[0m[49m[38;5;10m+     791[0m:[38;5;10m[49m             2 => c2v { x: b.min.x, y: b.max.y },
[0m[49m[38;5;10m+     792[0m:[38;5;10m[49m             _ => c2v { x: b.max.x, y: b.max.y },
