[0m[49m[38;5;10m+    132[0m:[38;5;10m[49m     let mut g = Rng::new(0x2801);
[0m[49m[38;5;10m+    133[0m:[38;5;10m[49m     for _ in 0..N / 4 {
[0m[49m[38;5;10m+    134[0m:[38;5;10m[49m         let centre = g.v(20.0);
