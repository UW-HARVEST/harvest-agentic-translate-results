[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m fn row50_capsule_side_wall_both_signs() {
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m     let (c, r) = pair();
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m     let mut d = Diff::new("50: c2RaytoCapsule side-wall normal, c>0 (M.x) and c<0 (Skew(M.y))");
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m     let mut h = Hist::default();
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m     let mut g = Rng::new(0x5001);
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m     for i in 0..N * 2 {
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m         let cap = capsule(&mut g, i as u32);
[0m[49m[38;5;10m+    259[0m:[38;5;10m[49m         let axis = unsafe { (c.c2Norm)((c.c2Sub)(cap.b, cap.a)) };
[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m         let perp = c2v { x: -axis.y, y: axis.x };
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m         let len = unsafe { (c.c2Len)((c.c2Sub)(cap.b, cap.a)) };
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m         let sign = if i % 2 == 0 { 1.0f32 } else { -1.0f32 };
[0m[49m[38;5;10m+    263[0m:[38;5;10m[49m         // well outside the slab on one side, aimed straight at the mid-point
