[0m[49m[38;5;10m+     794[0m:[38;5;10m[49m         let sx = if corner.x == b.min.x { -1.0f32 } else { 1.0 };
[0m[49m[38;5;10m+     795[0m:[38;5;10m[49m         let sy = if corner.y == b.min.y { -1.0f32 } else { 1.0 };
