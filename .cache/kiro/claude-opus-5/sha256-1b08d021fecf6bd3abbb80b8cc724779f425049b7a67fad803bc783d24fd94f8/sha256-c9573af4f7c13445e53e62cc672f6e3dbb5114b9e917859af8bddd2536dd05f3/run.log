[0m[49m[38;5;10m+     838[0m:[38;5;10m[49m fn e29_aabb_all_t_beyond_one() {
[0m[49m[38;5;10m+     839[0m:[38;5;10m[49m     let (c, r) = pair();
[0m[49m[38;5;10m+     840[0m:[38;5;10m[49m     let mut d = Diff::new("E29: c2RaytoAABB hit == 0");
[0m[49m[38;5;10m+     841[0m:[38;5;10m[49m     let mut g = Rng::new(0xE029);
[0m[49m[38;5;10m+     842[0m:[38;5;10m[49m     // This arm is reached by rays whose infinite line hits the box but whose
[0m[49m[38;5;10m+     843[0m:[38;5;10m[49m     // parametrised plane crossings all land past 1; drive it by volume and by
[0m[49m[38;5;10m+     844[0m:[38;5;10m[49m     // stopping the ray short.
[0m[49m[38;5;10m+     845[0m:[38;5;10m[49m     for _ in 0..M * 8 {
