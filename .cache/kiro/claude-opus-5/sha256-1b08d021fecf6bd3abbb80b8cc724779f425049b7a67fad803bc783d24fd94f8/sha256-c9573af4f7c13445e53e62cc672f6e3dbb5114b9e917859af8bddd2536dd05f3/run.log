[0m[49m[38;5;10m+    198[0m:[38;5;10m[49m             3 => -cap.r * (1.0 + g.unit() * 4.0),
[0m[49m[38;5;10m+    199[0m:[38;5;10m[49m             4 => cap.r * (1.0 + g.unit() * 0.2),
[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m             _ => g.sym(cap.r * 8.0),
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m         let along = match i % 5 {
