[0m[49m[38;5;10m+    292[0m:[38;5;10m[49m             ),
[0m[49m[38;5;10m+    293[0m:[38;5;10m[49m             1 => (
[0m[49m[38;5;10m+    294[0m:[38;5;10m[49m                 c2v {
[0m[49m[38;5;10m+    295[0m:[38;5;10m[49m                     x: b.max.x + w * (0.5 + g.unit()),
[0m[49m[38;5;10m+    296[0m:[38;5;10m[49m                     y: b.min.y + h * u,
[0m[49m[38;5;10m+    297[0m:[38;5;10m[49m                 },
[0m[49m[38;5;10m+    298[0m:[38;5;10m[49m                 c2v { x: -1.0, y: 0.0 },
[0m[49m[38;5;10m+    299[0m:[38;5;10m[49m             ),
[0m[49m[38;5;10m+    300[0m:[38;5;10m[49m             2 => (
[0m[49m[38;5;10m+    301[0m:[38;5;10m[49m                 c2v {
[0m[49m[38;5;10m+    302[0m:[38;5;10m[49m                     x: b.min.x + w * u,
