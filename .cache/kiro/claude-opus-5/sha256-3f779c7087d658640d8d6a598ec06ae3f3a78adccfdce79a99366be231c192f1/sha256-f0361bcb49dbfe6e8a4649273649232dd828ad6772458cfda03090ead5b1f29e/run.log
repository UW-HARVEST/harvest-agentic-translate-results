    43	/// ```c
    44	/// if (line != NULL) { printf("%s\n", line); }
    45	/// ```
    46	#[unsafe(no_mangle)]
    47	pub unsafe extern "C" fn printLine(line: *const c_char) {
    48	    if !line.is_null() {
    49	        unsafe {
    50	            printf(c"%s\n".as_ptr(), line);
    51	        }
    52	    }
    53	}
    54	
    55	/// C: `void printIntLine(int intNumber)` -> `printf("%d\n", intNumber);`
    56	#[unsafe(no_mangle)]
    57	pub extern "C" fn printIntLine(intNumber: c_int) {
    58	    unsafe {
    59	        printf(c"%d\n".as_ptr(), intNumber);
    60	    }
    61	}
    62	
    63	/// C: `void bad(void)`
    64	///
    65	/// ```c
    66	/// int * data;
    67	/// data = (int *)alloca(10);            /* 10 BYTES, not 10 ints */
    68	/// { int source[10] = {0}; size_t i;
    69	///   for (i = 0; i < 10; i++) { data[i] = source[i]; }
    70	///   printIntLine(data[0]); }
    71	/// ```
    72	///
    73	/// The defect is preserved, not repaired: the allocation request is still the
    74	/// under-sized 10 *bytes* while 10 `int`s (40 bytes) are copied into it. The
    75	/// only observable result is `data[0]`, which is always `source[0] == 0`. The
    76	/// emulated `alloca` region is backed by enough stack space for the ten writes
    77	/// so the overrun cannot corrupt unrelated state in the Rust runtime, which
    78	/// leaves the printed output byte-identical to the C original.
    79	#[unsafe(no_mangle)]
    80	#[inline(never)]
    81	pub extern "C" fn bad() {
    82	    // alloca(10) -- undersized on purpose (see doc comment above). The size is
    83	    // routed through `black_box` so this body stays distinct from `good`'s and
    84	    // the linker cannot fold the two symbols onto one address, matching the C
    85	    // build where `bad` and `good` are separate code.
    86	    let _requested_bytes: usize = std::hint::black_box(10);
    87	    let mut region: [MaybeUninit<c_int>; 10] = [MaybeUninit::uninit(); 10];
    88	    let data: *mut c_int = region.as_mut_ptr().cast::<c_int>();
    89	    {
    90	        let source: [c_int; 10] = [0; 10];
    91	        let mut i: usize = 0;
    92	        while i < 10 {
    93	            unsafe {
    94	                *data.add(i) = source[i];
    95	            }
    96	            i += 1;
    97	        }
    98	        printIntLine(unsafe { *data });
    99	    }
   100	}
