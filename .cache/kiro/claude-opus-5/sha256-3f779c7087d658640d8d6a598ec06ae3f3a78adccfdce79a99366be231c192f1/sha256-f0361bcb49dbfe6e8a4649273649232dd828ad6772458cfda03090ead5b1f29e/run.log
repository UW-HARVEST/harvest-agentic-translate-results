    31	use std::ffi::{c_char, c_int};
    32	use std::mem::MaybeUninit;
    33	
    34	// Output is produced through the platform C `printf` (not Rust's `std::io`) so
    35	// that stream buffering, flushing and interleaving with any C caller's own
    36	// stdio writes are byte-for-byte identical to the original library.
    37	unsafe extern "C" {
