[0m[49m[38;5;10m+     418[0m:[38;5;10m[49m             } else {
[0m[49m[38;5;10m+     419[0m:[38;5;10m[49m                 kinds.push("dynamic");
[0m[49m[38;5;10m+     420[0m:[38;5;10m[49m                 let (ll, dl) = deflate::tables_for(&toks, 15, 288, 2);
[0m[49m[38;5;10m+     421[0m:[38;5;10m[49m                 deflate::dynamic_block(&mut bw, &ll, &dl, &toks, last, true);
[0m[49m[38;5;10m+     422[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+     423[0m:[38;5;10m[49m             expect.extend_from_slice(&data);
