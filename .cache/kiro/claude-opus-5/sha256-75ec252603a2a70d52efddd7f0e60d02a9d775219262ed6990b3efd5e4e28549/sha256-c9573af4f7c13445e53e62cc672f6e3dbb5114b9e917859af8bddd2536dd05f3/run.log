[0m[49m[38;5;10m+     282[0m:[38;5;10m[49m fn row07_inflate_all_distance_codes() {
[0m[49m[38;5;10m+     283[0m:[38;5;10m[49m     // Every one of the 30 distance codes, incl. dist == 32768 (needs a 32 KiB
