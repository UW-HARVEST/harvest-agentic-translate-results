[0m[49m[38;5;10m+     406[0m:[38;5;10m[49m     for trial in 0..60 {
[0m[49m[38;5;10m+     407[0m:[38;5;10m[49m         let nblocks = rng.range(2, 5) as usize;
[0m[49m[38;5;10m+     408[0m:[38;5;10m[49m         let mut bw = deflate::BitWriter::new();
