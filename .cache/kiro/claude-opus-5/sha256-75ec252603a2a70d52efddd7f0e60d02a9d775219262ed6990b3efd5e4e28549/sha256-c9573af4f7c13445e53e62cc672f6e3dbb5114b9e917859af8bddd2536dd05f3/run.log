[0m[49m[38;5;10m+     312[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+     313[0m:[38;5;10m[49m // Rows 8-10 — cp_inflate, dynamic Huffman
[0m[49m[38;5;10m+     314[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+     315[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     316[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+     317[0m:[38;5;10m[49m fn row08_inflate_dynamic_shallow() {
[0m[49m[38;5;10m+     318[0m:[38;5;10m[49m     // depth <= 9 ⇒ every code lands in cp_build's 512-entry `lookup` table.
[0m[49m[38;5;10m+     319[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0x08);
