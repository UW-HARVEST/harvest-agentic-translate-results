[0m[49m[38;5;10m+     337[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0x09);
[0m[49m[38;5;10m+     338[0m:[38;5;10m[49m     for trial in 0..40 {
[0m[49m[38;5;10m+     339[0m:[38;5;10m[49m         let mut data: Vec<u8> = Vec::new();
[0m[49m[38;5;10m+     340[0m:[38;5;10m[49m         // Exponentially decaying symbol popularity builds a deep tree.
[0m[49m[38;5;10m+     341[0m:[38;5;10m[49m         for sym in 0..14u32 {
[0m[49m[38;5;10m+     342[0m:[38;5;10m[49m             let reps = 1usize << (13 - sym);
[0m[49m[38;5;10m+     343[0m:[38;5;10m[49m             for _ in 0..reps {
[0m[49m[38;5;10m+     344[0m:[38;5;10m[49m                 data.push(sym as u8);
[0m[49m[38;5;10m+     345[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+     346[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+     347[0m:[38;5;10m[49m         for _ in 0..rng.range(1, 50) {
[0m[49m[38;5;10m+     348[0m:[38;5;10m[49m             data.push(rng.below(14) as u8);
[0m[49m[38;5;10m+     349[0m:[38;5;10m[49m         }
