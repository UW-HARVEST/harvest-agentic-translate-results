[0m[49m[38;5;10m+     324[0m:[38;5;10m[49m         let toks: Vec<Tok> = data.iter().map(|&b| Tok::Lit(b)).collect();
[0m[49m[38;5;10m+     325[0m:[38;5;10m[49m         let def = deflate::dynamic_stream(&toks, 9, 257, 2, true);
