[0m[49m[38;5;10m+     353[0m:[38;5;10m[49m         assert!(maxlen > 9, "trial {trial}: tree not deep enough ({maxlen})");
[0m[49m[38;5;10m+     354[0m:[38;5;10m[49m         let mut bw = deflate::BitWriter::new();
