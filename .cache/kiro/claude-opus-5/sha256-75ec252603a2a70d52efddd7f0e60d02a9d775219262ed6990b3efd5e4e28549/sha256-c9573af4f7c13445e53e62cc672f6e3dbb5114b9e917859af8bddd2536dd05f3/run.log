[0m[49m[38;5;10m+     287[0m:[38;5;10m[49m         let base = deflate::DIST_BASE[dc];
[0m[49m[38;5;10m+     288[0m:[38;5;10m[49m         let span = 1u32 << deflate::DIST_EXTRA[dc];
[0m[49m[38;5;10m+     289[0m:[38;5;10m[49m         let mut dists = vec![base];
[0m[49m[38;5;10m+     290[0m:[38;5;10m[49m         if span > 1 {
[0m[49m[38;5;10m+     291[0m:[38;5;10m[49m             dists.push(base + span / 2);
[0m[49m[38;5;10m+     292[0m:[38;5;10m[49m             dists.push(base + span - 1);
[0m[49m[38;5;10m+     293[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+     294[0m:[38;5;10m[49m         for dist in dists {
[0m[49m[38;5;10m+     295[0m:[38;5;10m[49m             if dist > 32768 {
[0m[49m[38;5;10m+     296[0m:[38;5;10m[49m                 continue;
[0m[49m[38;5;10m+     297[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+     298[0m:[38;5;10m[49m             let need = dist as usize;
[0m[49m[38;5;10m+     299[0m:[38;5;10m[49m             let hist = &history[..need];
[0m[49m[38;5;10m+     300[0m:[38;5;10m[49m             let mut toks: Vec<Tok> = hist.iter().map(|&b| Tok::Lit(b)).collect();
[0m[49m[38;5;10m+     301[0m:[38;5;10m[49m             toks.push(Tok::Match { len: 258, dist });
[0m[49m[38;5;10m+     302[0m:[38;5;10m[49m             let expect = deflate::expand(&toks);
[0m[49m[38;5;10m+     303[0m:[38;5;10m[49m             let def = deflate::fixed_stream(&toks);
[0m[49m[38;5;10m+     304[0m:[38;5;10m[49m             let (c, r) = call_inflate(&def, def.len() as i32, expect.len() as i32);
[0m[49m[38;5;10m+     305[0m:[38;5;10m[49m             assert_same(&format!("row07 dist code {dc} dist={dist}"), &c, &r);
[0m[49m[38;5;10m+     306[0m:[38;5;10m[49m             assert_eq!(c.ret, 1, "C failed dc={dc} dist={dist}: {}", c.err_str());
[0m[49m[38;5;10m+     307[0m:[38;5;10m[49m             assert_eq!(c.payload, expect);
[0m[49m[38;5;10m+     308[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+     309[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     310[0m:[38;5;10m[49m }
