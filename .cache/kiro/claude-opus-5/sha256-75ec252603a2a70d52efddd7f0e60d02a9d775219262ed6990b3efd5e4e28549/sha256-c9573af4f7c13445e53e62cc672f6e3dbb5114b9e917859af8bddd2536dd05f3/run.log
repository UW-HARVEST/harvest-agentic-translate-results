[0m[49m[38;5;10m+     397[0m:[38;5;10m[49m // Row 11 — multi-block streams
[0m[49m[38;5;10m+     398[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+     399[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     400[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+     401[0m:[38;5;10m[49m fn row11_inflate_multi_block() {
[0m[49m[38;5;10m+     402[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0x0B);
[0m[49m[38;5;10m+     403[0m:[38;5;10m[49m     // Fixed + dynamic blocks can be chained freely. A stored block can only be
[0m[49m[38;5;10m+     404[0m:[38;5;10m[49m     // the *last* block (cp_stored's `bits_left/8 <= LEN` check), so it is placed
