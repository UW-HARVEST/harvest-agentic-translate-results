[0m[49m[38;5;10m+     466[0m:[38;5;10m[49m fn err14_allocation_boundary() {
[0m[49m[38;5;10m+     467[0m:[38;5;10m[49m     // The largest size the "image too large" guard admits: w*h == 0x1FFFFFFF
[0m[49m[38;5;10m+     468[0m:[38;5;10m[49m     // ⇒ malloc(0x7FFFFFFC) (~2 GiB). Whether that succeeds is up to the
[0m[49m[38;5;10m+     469[0m:[38;5;10m[49m     // allocator; C and Rust must agree either way, and no IDAT follows so the
[0m[49m[38;5;10m+     470[0m:[38;5;10m[49m     // next rejection is row 18.
