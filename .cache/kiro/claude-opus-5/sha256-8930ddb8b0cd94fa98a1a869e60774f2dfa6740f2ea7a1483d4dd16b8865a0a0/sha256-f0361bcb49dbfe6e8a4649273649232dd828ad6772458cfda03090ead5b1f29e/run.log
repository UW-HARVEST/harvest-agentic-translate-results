[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m fn phase_c_b12_large_and_residue_lengths() {
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m     let mut rng = Rng::new(0xC00A);
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m     let mut buf = vec![0u8; 1024 * 1024 + 8];
