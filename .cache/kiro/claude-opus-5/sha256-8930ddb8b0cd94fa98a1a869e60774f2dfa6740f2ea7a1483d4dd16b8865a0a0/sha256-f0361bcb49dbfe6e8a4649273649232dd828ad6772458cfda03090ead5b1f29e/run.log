[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m fn phase_c_b14_no_enum_full_integer_domain() {
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m     let mut rng = Rng::new(0xC00C);
[0m[49m[38;5;10m+    259[0m:[38;5;10m[49m     let mut buf = vec![0u8; 64];
[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m     rng.fill(&mut buf);
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m     // Full u16 seed domain at several lengths.
[0m[49m[38;5;10m+    263[0m:[38;5;10m[49m     for len in [0u32, 1, 7, 8, 9, 16, 63, 64] {
[0m[49m[38;5;10m+    264[0m:[38;5;10m[49m         for s in 0u32..=0xFFFF {
[0m[49m[38;5;10m+    265[0m:[38;5;10m[49m             let ret_c_eq_rs = assert_same(&format!("B14 len={len} seed=0x{s:04x}"), buf.as_ptr(), len, s as u16);
[0m[49m[38;5;10m+    266[0m:[38;5;10m[49m             let _ = ret_c_eq_rs;
[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m     // len == 0 must be accepted for every seed even with a null pointer; no
