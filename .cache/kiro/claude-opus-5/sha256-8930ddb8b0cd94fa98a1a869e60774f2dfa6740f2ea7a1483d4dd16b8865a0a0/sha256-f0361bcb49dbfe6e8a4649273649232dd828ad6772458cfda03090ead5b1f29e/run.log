[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m         for base in [0u32, 8, 4096, 65536, 1024 * 1024] {
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m             let len = base + r;
