[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m     assert_same("B12 full", buf.as_ptr(), buf.len() as u32, seed);
[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m /// ERRORS B13 — unaligned pointers: the Rust must read byte-wise like the C.
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m fn phase_c_b13_unaligned_pointer() {
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m     let mut rng = Rng::new(0xC00B);
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m     let mut backing = vec![0u8; 4096];
