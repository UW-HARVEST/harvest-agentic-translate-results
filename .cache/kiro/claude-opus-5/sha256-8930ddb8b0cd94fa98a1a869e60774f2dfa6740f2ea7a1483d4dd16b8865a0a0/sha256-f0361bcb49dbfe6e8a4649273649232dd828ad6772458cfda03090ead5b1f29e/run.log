[0m[49m[38;5;10m+    168[0m:[38;5;10m[49m fn phase_c_b11_every_table_slot_reachable() {
[0m[49m[38;5;10m+    169[0m:[38;5;10m[49m     let mut rng = Rng::new(0xC009);
[0m[49m[38;5;10m+    170[0m:[38;5;10m[49m 
