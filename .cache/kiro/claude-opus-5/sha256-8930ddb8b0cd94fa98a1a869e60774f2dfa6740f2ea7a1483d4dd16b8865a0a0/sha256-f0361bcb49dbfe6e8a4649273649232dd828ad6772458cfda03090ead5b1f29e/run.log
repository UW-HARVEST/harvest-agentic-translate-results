[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m         for len in 0u32..=64 {
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m             if off + len as usize > backing.len() {
[0m[49m[38;5;10m+    236[0m:[38;5;10m[49m                 continue;
[0m[49m[38;5;10m+    237[0m:[38;5;10m[49m             }
