import re
cov = set(re.findall(r'"([BC]\d+)"', open('tests/diff/cases.rs').read()))

def tick(path, pfx):
    out=[]
    n=0
    for l in open(path):
        m = re.match(r'\| (\d+) \|', l)
        if m and l.rstrip().endswith('| [ ] |'):
            rid = pfx+m.group(1)
            if rid in cov:
                l = l.rstrip()[:-7] + '| [x] |\n'
                n+=1
        out.append(l)
    open(path,'w').writelines(out)
    return n

print("CONFIGS ticked:", tick('CONFIGS.md','B'))
print("ERRORS  ticked:", tick('ERRORS.md','C'))
