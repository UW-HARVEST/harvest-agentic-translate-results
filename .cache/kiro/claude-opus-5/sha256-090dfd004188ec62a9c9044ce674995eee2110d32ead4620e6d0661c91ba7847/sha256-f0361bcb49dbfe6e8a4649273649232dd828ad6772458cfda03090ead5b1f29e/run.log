Purpose: Read rdpath simple_stride implementation

fn simple_stride(api: &Api, rng: &mut Rng) {
    unsafe {
        let data = encode(api, rng, 8, 6, 8, 6, PNG_INTERLACE_NONE);
        let fmt = PNG_FORMAT_FLAG_COLOR | PNG_FORMAT_FLAG_ALPHA;
        for stride_mode in 0..3 {
            let mut image = png_image::default();
            image.version = PNG_IMAGE_VERSION;
            let r = (api.png_image_begin_read_from_memory)(
                &mut image, data.as_ptr() as *const c_void, data.len());
            if r == 0 {
                p!("stride begin fail woe={}", image.warning_or_error);
                (api.png_image_free)(&mut image);
                continue;
            }
            image.format = fmt;
            let ch = format_channels(fmt);
            let min_stride = (image.width * ch) as i32;
            let stride = match stride_mode {
                0 => -min_stride,
                1 => min_stride + 8,
                _ => min_stride,
            };
            // Size the buffer generously in BOTH directions so that whichever
            // way libpng indexes from the base pointer for a negative stride,
            // no access lands out of bounds. `span` is the number of bytes the
            // rows cover; we allocate 2*span + a page of slack and place the
            // base pointer in the middle.
            let span = (stride.unsigned_abs() * image.height) as usize + min_stride as usize;
            let cap = span * 2 + 4096;
            let mut buf = vec![0u8; cap];
            let mid = cap / 2;
            let base = buf.as_mut_ptr().add(mid);
            let fr = (api.png_image_finish_read)(
                &mut image, std::ptr::null(), base as *mut c_void, stride, std::ptr::null_mut());
            p!("stride={} finish={} woe={} msg={:?}", stride, fr, image.warning_or_error, image.msg());
            // Emit the covered span around the base so the compared bytes are
            // deterministic regardless of index direction.
            let lo = mid.saturating_sub(span);
            let hi = (mid + span).min(cap);
            emit_bytes(&format!("stride={} buf", stride), &buf[lo..hi]);
            (api.png_image_free)(&mut image);
        }
    }
}
