import os,re
rows=[]
for fn in sorted(os.listdir('.rowresults')):
    if not fn.startswith('C'): continue
    for line in open('.rowresults/'+fn):
        p=line.rstrip('\n').split('\t')
        if len(p)<4: continue
        rows.append(p)
def norm(s):
    return re.sub(r'[^a-z0-9]','',s.lower())
bad=[]
for st,scen,desc,obs in rows:
    parts=desc.split(' \u2014 ')
    exp=' '.join(parts[2:]) if len(parts)>2 else ''
    m=re.search(r'png_error: (.*?)(?:; |$)', obs)
    msg=m.group(1) if m else None
    if msg:
        # is the core of the message reflected in exp?
        core=norm(msg)
        if core and core not in norm(exp):
            bad.append((scen,exp,obs))
print(len(bad),"rows whose documented expectation does not literally contain the observed message")
for s,e,o in bad:
    print("---",s.split('id=')[-1])
    print("   exp:",e[:110])
    print("   obs:",o[:150])
