#[unsafe(no_mangle)]
pub unsafe extern "C" fn png_fixed(
    png_ptr: png_const_structrp,
    fp: f64,
    text: png_const_charp,
) -> png_fixed_point {
    let r: f64 = floor(100000.0 * fp + 0.5);

