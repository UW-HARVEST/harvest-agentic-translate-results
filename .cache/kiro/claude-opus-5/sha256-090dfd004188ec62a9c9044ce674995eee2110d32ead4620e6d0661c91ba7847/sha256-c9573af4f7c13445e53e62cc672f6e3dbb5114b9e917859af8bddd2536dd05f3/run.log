import re

def patch(path, fname, callee, args, conv):
    """Rewrite a wrapper so its conversions happen in reverse (C/GCC) order."""
    s = open(path).read()
    start = s.index("pub unsafe extern \"C\" fn %s(" % fname)
    end = s.index("\n}\n", start) + 3
    body = s[start:end]
    # build replacement
    lines = []
    sig_end = body.index(") {") + 3
    sig = body[:sig_end]
    lines.append(sig)
    lines.append("    /* NOTE: the reference C build evaluates this argument list right to left,")
    lines.append("     * so the conversions (which can raise png_fixed_error) must happen in")
    lines.append("     * that order for the error message to match. */")
    for name, tag, cv in reversed(args):
        lines.append("    let %s_fx = %s(png_ptr, %s, cstr(b\"%s\\0\"));" % (name, cv, name, tag))
    lines.append("    %s(" % callee)
    for extra in conv:
        lines.append("        %s," % extra)
    for name, _, _ in args:
        lines.append("        %s_fx," % name)
    lines.append("    );")
    lines.append("}")
    new = "\n".join(lines) + "\n"
    s = s[:start] + new + s[end:]
    open(path, "w").write(s)
    print("patched", fname)

