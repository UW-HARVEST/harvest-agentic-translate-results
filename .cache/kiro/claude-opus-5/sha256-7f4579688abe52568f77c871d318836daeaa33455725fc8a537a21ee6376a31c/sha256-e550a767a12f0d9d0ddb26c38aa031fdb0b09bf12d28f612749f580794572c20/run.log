  for (i=0; i < num; i+=1)
    hmdel(intmap, i);
  for (i=0; i < num; i+=1)
    STBDS_ASSERT(hmget(intmap, i) == -2 );
  hmfree(intmap);
  for (i=0; i < num; i+=2)
    hmput(intmap, i, i*3);
