[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m // C16 — shared stdout: alternate C and Rust calls with no intermediate flush
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    271[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    272[0m:[38;5;10m[49m fn c16_shared_stdout_interleaved_ordering() {
[0m[49m[38;5;10m+    273[0m:[38;5;10m[49m     let script = build_script(1024, SEED ^ 16);
[0m[49m[38;5;10m+    274[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    275[0m:[38;5;10m[49m     // Alternate the two implementations call-by-call into one buffered stream.
[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m     // If the Rust translation wrote via `std::io::stdout` instead of libc
