[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m             let r = rng.next_u64();
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m             let v = (r >> 8) as u8;
[0m[49m[38;5;10m+    236[0m:[38;5;10m[49m             if r & 1 == 0 { Op::PrintHex(v) } else { Op::Driver(v) }
[0m[49m[38;5;10m+    237[0m:[38;5;10m[49m         })
[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m         .collect()
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m }
