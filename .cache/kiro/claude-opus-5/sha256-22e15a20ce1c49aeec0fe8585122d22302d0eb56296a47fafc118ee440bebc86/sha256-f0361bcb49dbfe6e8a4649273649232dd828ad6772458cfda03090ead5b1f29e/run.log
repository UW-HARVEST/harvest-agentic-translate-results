[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m fn run_script(api: &Api, script: &[Op]) {
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m     for op in script {
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m         unsafe {
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m             match *op {
