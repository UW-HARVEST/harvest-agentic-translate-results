[0m[49m[38;5;10m+    220[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    221[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m /// A scripted sequence of calls, so the exact same script can be replayed
[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m /// against either implementation.
[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m #[derive(Clone, Copy)]
[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m enum Op {
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m     PrintHex(u8),
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m     Driver(u8),
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m fn build_script(n: usize, seed: u64) -> Vec<Op> {
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m     let mut rng = Rng::new(seed);
