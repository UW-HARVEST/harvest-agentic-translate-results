[0m[49m[38;5;10m+    281[0m:[38;5;10m[49m             let api = if i % 2 == 0 { c() } else { rs() };
[0m[49m[38;5;10m+    282[0m:[38;5;10m[49m             run_script(api, std::slice::from_ref(op));
