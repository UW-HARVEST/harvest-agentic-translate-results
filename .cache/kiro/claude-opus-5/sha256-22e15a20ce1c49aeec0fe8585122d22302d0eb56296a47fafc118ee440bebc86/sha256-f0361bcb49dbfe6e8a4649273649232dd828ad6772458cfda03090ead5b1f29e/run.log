[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m                 Op::Driver(v) => (api.driver)(v as c_char),
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m fn c15_long_interleaved_sequence_transcript() {
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m     let script = build_script(4096, SEED ^ 15);
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m     let c_out = capture(|| run_script(c(), &script));
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m     let r_out = capture(|| run_script(rs(), &script));
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    259[0m:[38;5;10m[49m     assert_eq!(
