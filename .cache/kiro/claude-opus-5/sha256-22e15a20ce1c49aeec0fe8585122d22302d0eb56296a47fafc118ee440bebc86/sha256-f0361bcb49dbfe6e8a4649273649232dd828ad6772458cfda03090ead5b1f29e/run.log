[0m[49m[38;5;10m+     11[0m:[38;5;10m[49m //! agree on the exact outcome — the exact emitted bytes AND the fact that
[0m[49m[38;5;10m+     12[0m:[38;5;10m[49m //! neither rejects, traps, or aborts. Because both functions return `void`,
[0m[49m[38;5;10m+     13[0m:[38;5;10m[49m //! "same error/sentinel" means "same emitted line and same non-rejection", and
[0m[49m[38;5;10m+     14[0m:[38;5;10m[49m //! each test additionally pins the exact expected C bytes so a test cannot pass
[0m[49m[38;5;10m+     15[0m:[38;5;10m[49m //! by both sides being equally broken.
[0m[49m[38;5;10m+     16[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     17[0m:[38;5;10m[49m mod common;
[0m[49m[38;5;10m+     18[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     19[0m:[38;5;10m[49m use common::*;
[0m[49m[38;5;10m+     20[0m:[38;5;10m[49m use std::ffi::{c_char, c_int};
[0m[49m[38;5;10m+     21[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     22[0m:[38;5;10m[49m /// Asserts C and Rust agree, *and* that the shared result is the exact byte
