    24	    }
    25	
    26	    /* Verify we processed the expected number of lines */
    27	    if (lineIndex != numLines) {
    28	        /* Something went wrong - we didn't find as many lines as expected */
    29	        free(bufferPtrs);
    30	        return NULL;
    31	    }
    32	
    33	    return linePointers;
    34	}
