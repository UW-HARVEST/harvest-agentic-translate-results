     3	/* Create an array of pointers to the lines in a buffer */
     4	const char** UTIL_createLinePointers(char* buffer, size_t numLines, size_t bufferSize)
     5	{
     6	    size_t lineIndex = 0;
     7	    size_t pos = 0;
     8	    void* const bufferPtrs = malloc(numLines * sizeof(const char**));
     9	    const char** const linePointers = (const char**)bufferPtrs;
    10	    if (bufferPtrs == NULL) return NULL;
    11	
    12	    while (lineIndex < numLines && pos < bufferSize) {
    13	        size_t len = 0;
    14	        linePointers[lineIndex++] = buffer+pos;
    15	
    16	        /* Find the next null terminator, being careful not to go past the buffer */
    17	        while ((pos + len < bufferSize) && buffer[pos + len] != '\0') {
    18	            len++;
    19	        }
