[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m fn state_carries_between_the_two_run_calls() {
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m     let out = run(&rust_bin(), b"10\n");
