[0m[49m[38;5;10m+    168[0m:[38;5;10m[49m                 out.stderr.is_empty(),
[0m[49m[38;5;10m+    169[0m:[38;5;10m[49m                 "{} wrote to stderr on {:?}: {}",
[0m[49m[38;5;10m+    170[0m:[38;5;10m[49m                 bin.display(),
[0m[49m[38;5;10m+    171[0m:[38;5;10m[49m                 show(input),
[0m[49m[38;5;10m+    172[0m:[38;5;10m[49m                 show(&out.stderr)
[0m[49m[38;5;10m+    173[0m:[38;5;10m[49m             );
[0m[49m[38;5;10m+    174[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    175[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    176[0m:[38;5;10m[49m }
