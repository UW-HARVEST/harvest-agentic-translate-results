c, r = sys.argv[1], sys.argv[2]
random.seed(1234)
alpha = b"0123456789+- \t\n\r\x00abcxX.,\xff\x80\v\f"
fails = 0
for i in range(4000):
    n = random.randint(0, 130)
    data = bytes(random.choice(alpha) for _ in range(n))
    if i % 4 == 0:  # bias toward plausible numbers
        data = (str(random.randint(-2**40, 2**40)) + random.choice(["\n","","abc\n"," \n"])).encode()
    co = subprocess.run([c], input=data, capture_output=True)
    ro = subprocess.run([r], input=data, capture_output=True)
    if (co.stdout, co.stderr, co.returncode) != (ro.stdout, ro.stderr, ro.returncode):
        fails += 1
        print("MISMATCH", data[:60])
        print(" C ", co.returncode, co.stdout[-70:], co.stderr[:60])
        print(" R ", ro.returncode, ro.stdout[-70:], ro.stderr[:60])
        if fails > 5: break
print("fuzz done, mismatches:", fails)
