[0m[49m[38;5;10m+    156[0m:[38;5;10m[49m fn exit_status_is_zero_and_stderr_empty_on_both_paths() {
[0m[49m[38;5;10m+    157[0m:[38;5;10m[49m     for input in [&b"5\n"[..], &b"oops\n"[..], &b""[..]] {
[0m[49m[38;5;10m+    158[0m:[38;5;10m[49m         for bin in [c_bin(), rust_bin()] {
[0m[49m[38;5;10m+    159[0m:[38;5;10m[49m             let out = run(&bin, input);
