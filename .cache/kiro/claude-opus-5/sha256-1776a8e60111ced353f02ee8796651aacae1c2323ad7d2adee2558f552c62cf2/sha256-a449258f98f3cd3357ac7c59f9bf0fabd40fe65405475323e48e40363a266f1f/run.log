        else: skipped+=1
        continue
    if a!=b:
        fails+=1; print("MISMATCH %r\n  C=%r\n  R=%r"%(args,a,b))
        if fails>10: break
print("done fails=%d skipped=%d / %d"%(fails,skipped,N))
