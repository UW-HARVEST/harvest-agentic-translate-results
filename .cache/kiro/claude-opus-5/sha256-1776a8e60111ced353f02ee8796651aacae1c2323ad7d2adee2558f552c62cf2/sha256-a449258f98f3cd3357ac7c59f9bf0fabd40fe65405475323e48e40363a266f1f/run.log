[0m[49m[38;5;10m+    553[0m:[38;5;10m[49m fn sweep_deterministic_pseudorandom_programs() {
[0m[49m[38;5;10m+    554[0m:[38;5;10m[49m     // A small xorshift keeps this reproducible without a dev-dependency.
[0m[49m[38;5;10m+    555[0m:[38;5;10m[49m     let mut state: u64 = 0x2545F4914F6CDD1D;
[0m[49m[38;5;10m+    556[0m:[38;5;10m[49m     let mut next = |n: u64| -> u64 {
[0m[49m[38;5;10m+    557[0m:[38;5;10m[49m         state ^= state << 13;
[0m[49m[38;5;10m+    558[0m:[38;5;10m[49m         state ^= state >> 7;
[0m[49m[38;5;10m+    559[0m:[38;5;10m[49m         state ^= state << 17;
[0m[49m[38;5;10m+    560[0m:[38;5;10m[49m         state % n
[0m[49m[38;5;10m+    561[0m:[38;5;10m[49m     };
[0m[49m[38;5;10m+    562[0m:[38;5;10m[49m     let big = [
[0m[49m[38;5;10m+    563[0m:[38;5;10m[49m         -2147483648i64,
[0m[49m[38;5;10m+    564[0m:[38;5;10m[49m         2147483647,
[0m[49m[38;5;10m+    565[0m:[38;5;10m[49m         65536,
[0m[49m[38;5;10m+    566[0m:[38;5;10m[49m         1000,
[0m[49m[38;5;10m+    567[0m:[38;5;10m[49m         -1000,
[0m[49m[38;5;10m+    568[0m:[38;5;10m[49m         123456789,
[0m[49m[38;5;10m+    569[0m:[38;5;10m[49m         -123456789,
[0m[49m[38;5;10m+    570[0m:[38;5;10m[49m         7,
[0m[49m[38;5;10m+    571[0m:[38;5;10m[49m         100,
[0m[49m[38;5;10m+    572[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    573[0m:[38;5;10m[49m     for _ in 0..400 {
[0m[49m[38;5;10m+    574[0m:[38;5;10m[49m         let len = 1 + next(14) as usize;
[0m[49m[38;5;10m+    575[0m:[38;5;10m[49m         let mut words: Vec<String> = Vec::with_capacity(len);
[0m[49m[38;5;10m+    576[0m:[38;5;10m[49m         for _ in 0..len {
[0m[49m[38;5;10m+    577[0m:[38;5;10m[49m             let r = next(100);
[0m[49m[38;5;10m+    578[0m:[38;5;10m[49m             let v: i64 = if r < 60 {
[0m[49m[38;5;10m+    579[0m:[38;5;10m[49m                 next(11) as i64 // an opcode
[0m[49m[38;5;10m+    580[0m:[38;5;10m[49m             } else if r < 85 {
[0m[49m[38;5;10m+    581[0m:[38;5;10m[49m                 next(25) as i64 - 4
[0m[49m[38;5;10m+    582[0m:[38;5;10m[49m             } else {
[0m[49m[38;5;10m+    583[0m:[38;5;10m[49m                 big[next(big.len() as u64) as usize]
[0m[49m[38;5;10m+    584[0m:[38;5;10m[49m             };
[0m[49m[38;5;10m+    585[0m:[38;5;10m[49m             words.push(v.to_string());
[0m[49m[38;5;10m+    586[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    587[0m:[38;5;10m[49m         let refs: Vec<&str> = words.iter().map(|s| s.as_str()).collect();
[0m[49m[38;5;10m+    588[0m:[38;5;10m[49m         assert_same_args(&refs);
[0m[49m[38;5;10m+    589[0m:[38;5;10m[49m         // The same program fed through stdin must also agree.
[0m[49m[38;5;10m+    590[0m:[38;5;10m[49m         let mut input = words.join(" ").into_bytes();
[0m[49m[38;5;10m+    591[0m:[38;5;10m[49m         input.push(b'\n');
[0m[49m[38;5;10m+    592[0m:[38;5;10m[49m         assert_same(&["--stdin"], &input);
[0m[49m[38;5;10m+    593[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    594[0m:[38;5;10m[49m }
