import random, struct, subprocess
from decimal import Decimal, getcontext
getcontext().prec=200
C="/tmp/cref/driver"; R="/local/home/scheschb/.harvest/work/harvest-work-5iZraN/translation/target/release/driver"
def val(b): return struct.unpack('<f', struct.pack('<I', b))[0]
cases=[]
random.seed(99)
bits=[random.randrange(1,0x7f7fffff) for _ in range(500)]+[1,2,3,0x7f7fffff,0x7f7ffffe,0x00800000,0x007fffff,0x00000001,0x3f800000,0x3f800001]
for b in bits:
    a=Decimal(val(b)); c=Decimal(val(b+1))
    mid=(a+c)/2
    for s in [mid, mid*(1-Decimal('1e-30')), mid*(1+Decimal('1e-30'))]:
        cases.append(format(s,'f')); cases.append('-'+format(s,'f'))
        cases.append(format(s,'e')); cases.append(float.hex(float(s)))
# subnormal + overflow boundaries via hex midpoints
for e in range(-160,-120):
    cases += ['0x1p%d'%e, '0x1.8p%d'%e, '0x1.7fffffp%d'%e, '0x0.8p%d'%e]
for e in range(120,132):
    cases += ['0x1.fffffep%d'%e, '0x1.ffffffp%d'%e, '0x1.fffffe1p%d'%e, '0x2p%d'%e]
cases += ['1'+'0'*400, '0.'+'0'*400+'1', '9'*500, '1.'+'9'*500+'e-40',
          '0x'+'f'*40+'p-200', '0x'+'1'*60+'p-100', '0x'+'0'*300+'1p10',
          '1'+'0'*38, '3.4028235677973366e38','3.4028235677973365e38']
bad=0
for c in cases:
    d=c.encode()
    a=subprocess.run([C],input=d,capture_output=True).stdout
    b=subprocess.run([R],input=d,capture_output=True).stdout
    if a!=b:
        bad+=1; print("MISMATCH",c[:80],a,b)
        if bad>10: break
print(f"{len(cases)} boundary cases, {bad} mismatches")
