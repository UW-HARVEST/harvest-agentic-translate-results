[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m fn run_crash_child(so_index: usize, imp: c_int, mask: u8) -> Outcome {
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m     let exe = std::env::current_exe().expect("current_exe");
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m     let out = Command::new(exe)
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m         .args([
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m             "--exact",
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m             "err_crash_child_entrypoint",
