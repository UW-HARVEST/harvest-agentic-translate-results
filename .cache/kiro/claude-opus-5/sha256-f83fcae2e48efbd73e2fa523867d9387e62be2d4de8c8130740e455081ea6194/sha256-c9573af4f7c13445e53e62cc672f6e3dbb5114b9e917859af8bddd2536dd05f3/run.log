[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m /// How a child terminated, as a comparable value.
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m #[derive(Debug, PartialEq, Eq)]
[0m[49m[38;5;10m+    236[0m:[38;5;10m[49m enum Outcome {
[0m[49m[38;5;10m+    237[0m:[38;5;10m[49m     Signal(i32),
[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m     Exit(i32),
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m }
