[0m[49m[38;5;10m+     38[0m:[38;5;10m[49m             bits(got),
[0m[49m[38;5;10m+     39[0m:[38;5;10m[49m             bits(c_out),
[0m[49m[38;5;10m+     40[0m:[38;5;10m[49m             "\n[{row}] rejection divergence in {}\n  impairment : {imp} (out of range)\n  input      : {}\n  C   output : {} (unchanged)\n  Rust output: {}\n",
[0m[49m[38;5;10m+     41[0m:[38;5;10m[49m             r.label,
[0m[49m[38;5;10m+     42[0m:[38;5;10m[49m             show(input),
[0m[49m[38;5;10m+     43[0m:[38;5;10m[49m             show(c_out),
[0m[49m[38;5;10m+     44[0m:[38;5;10m[49m             show(got),
[0m[49m[38;5;10m+     45[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+     46[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     47[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     48[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     49[0m:[38;5;10m[49m /// A spread of interesting payloads to reject with, so a row is not proven by a
[0m[49m[38;5;10m+     50[0m:[38;5;10m[49m /// single value.
[0m[49m[38;5;10m+     51[0m:[38;5;10m[49m fn rejection_payloads() -> Vec<[f32; 3]> {
[0m[49m[38;5;10m+     52[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0xDEAD_BEEF);
[0m[49m[38;5;10m+     53[0m:[38;5;10m[49m     let mut v = vec![
[0m[49m[38;5;10m+     54[0m:[38;5;10m[49m         [0.0, 0.0, 0.0],
[0m[49m[38;5;10m+     55[0m:[38;5;10m[49m         [-0.0, -0.0, -0.0],
[0m[49m[38;5;10m+     56[0m:[38;5;10m[49m         [0.25, 0.5, 0.75],
[0m[49m[38;5;10m+     57[0m:[38;5;10m[49m         [1.0, 1.0, 1.0],
[0m[49m[38;5;10m+     58[0m:[38;5;10m[49m         [f32::INFINITY, f32::NEG_INFINITY, 0.0],
[0m[49m[38;5;10m+     59[0m:[38;5;10m[49m         [f32::MAX, f32::MIN, f32::MIN_POSITIVE],
[0m[49m[38;5;10m+     60[0m:[38;5;10m[49m         [f32::from_bits(0x7FC0_0000), f32::from_bits(0xFFC0_1234), f32::from_bits(0x7F80_0001)],
[0m[49m[38;5;10m+     61[0m:[38;5;10m[49m         [f32::from_bits(1), f32::from_bits(0x8000_0001), f32::from_bits(0x007F_FFFF)],
[0m[49m[38;5;10m+     62[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+     63[0m:[38;5;10m[49m     for _ in 0..256 {
[0m[49m[38;5;10m+     64[0m:[38;5;10m[49m         v.push(draw_triple(&mut rng, VClass::Any));
[0m[49m[38;5;10m+     65[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     66[0m:[38;5;10m[49m     v
[0m[49m[38;5;10m+     67[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     68[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     69[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+     70[0m:[38;5;10m[49m // E1..E5 — individual out-of-range enum values
[0m[49m[38;5;10m+     71[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+     72[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     73[0m:[38;5;10m[49m fn out_of_range_row(row: &str, imp: c_int) {
[0m[49m[38;5;10m+     74[0m:[38;5;10m[49m     for (i, p) in rejection_payloads().iter().enumerate() {
[0m[49m[38;5;10m+     75[0m:[38;5;10m[49m         assert_rejected_noop(&format!("{row} payload#{i}"), imp, *p);
[0m[49m[38;5;10m+     76[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     77[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     78[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     79[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+     80[0m:[38;5;10m[49m fn err_e1_impairment_3() {
[0m[49m[38;5;10m+     81[0m:[38;5;10m[49m     // One past the last enumerator cbTritanopia.
[0m[49m[38;5;10m+     82[0m:[38;5;10m[49m     out_of_range_row("E1", 3);
[0m[49m[38;5;10m+     83[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     84[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     85[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+     86[0m:[38;5;10m[49m fn err_e2_impairment_neg1() {
[0m[49m[38;5;10m+     87[0m:[38;5;10m[49m     // One before the first enumerator cbProtanopia. Caught by gcc's unsigned
[0m[49m[38;5;10m+     88[0m:[38;5;10m[49m     // `ja` bound check.
[0m[49m[38;5;10m+     89[0m:[38;5;10m[49m     out_of_range_row("E2", -1);
[0m[49m[38;5;10m+     90[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     91[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     92[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+     93[0m:[38;5;10m[49m fn err_e3_impairment_int_max() {
[0m[49m[38;5;10m+     94[0m:[38;5;10m[49m     out_of_range_row("E3", c_int::MAX);
[0m[49m[38;5;10m+     95[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     96[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     97[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+     98[0m:[38;5;10m[49m fn err_e4_impairment_int_min() {
[0m[49m[38;5;10m+     99[0m:[38;5;10m[49m     out_of_range_row("E4", c_int::MIN);
[0m[49m[38;5;10m+    100[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    101[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    102[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    103[0m:[38;5;10m[49m fn err_e5_impairment_4() {
[0m[49m[38;5;10m+    104[0m:[38;5;10m[49m     // A power of two just past the range: a naive bitmask test would admit it.
[0m[49m[38;5;10m+    105[0m:[38;5;10m[49m     out_of_range_row("E5", 4);
[0m[49m[38;5;10m+    106[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    107[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    108[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    109[0m:[38;5;10m[49m // E6 — dense + randomized sweep of out-of-range enum values
[0m[49m[38;5;10m+    110[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    111[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    112[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    113[0m:[38;5;10m[49m fn err_e6_impairment_out_of_range_sweep() {
[0m[49m[38;5;10m+    114[0m:[38;5;10m[49m     let payload = [0.3125f32, -2.5, 7.75];
[0m[49m[38;5;10m+    115[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    116[0m:[38;5;10m[49m     // Dense sweep around the valid range.
[0m[49m[38;5;10m+    117[0m:[38;5;10m[49m     for imp in -4096i32..=4096 {
[0m[49m[38;5;10m+    118[0m:[38;5;10m[49m         if (0..=2).contains(&imp) {
[0m[49m[38;5;10m+    119[0m:[38;5;10m[49m             continue;
[0m[49m[38;5;10m+    120[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    121[0m:[38;5;10m[49m         assert_rejected_noop("E6 dense", imp, payload);
[0m[49m[38;5;10m+    122[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    123[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    124[0m:[38;5;10m[49m     // Randomized sweep over the whole i32 space.
[0m[49m[38;5;10m+    125[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0x0FF0_0FF0);
[0m[49m[38;5;10m+    126[0m:[38;5;10m[49m     for _ in 0..4096 {
[0m[49m[38;5;10m+    127[0m:[38;5;10m[49m         let imp = rng.next_u32() as i32;
[0m[49m[38;5;10m+    128[0m:[38;5;10m[49m         if (0..=2).contains(&imp) {
[0m[49m[38;5;10m+    129[0m:[38;5;10m[49m             continue;
[0m[49m[38;5;10m+    130[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    131[0m:[38;5;10m[49m         let v = draw_triple(&mut rng, VClass::Any);
[0m[49m[38;5;10m+    132[0m:[38;5;10m[49m         assert_rejected_noop("E6 random", imp, v);
[0m[49m[38;5;10m+    133[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    134[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    135[0m:[38;5;10m[49m     // And the boundary values, exactly.
[0m[49m[38;5;10m+    136[0m:[38;5;10m[49m     for imp in [
[0m[49m[38;5;10m+    137[0m:[38;5;10m[49m         i32::MIN,
[0m[49m[38;5;10m+    138[0m:[38;5;10m[49m         i32::MIN + 1,
[0m[49m[38;5;10m+    139[0m:[38;5;10m[49m         -2,
[0m[49m[38;5;10m+    140[0m:[38;5;10m[49m         -1,
[0m[49m[38;5;10m+    141[0m:[38;5;10m[49m         3,
[0m[49m[38;5;10m+    142[0m:[38;5;10m[49m         4,
[0m[49m[38;5;10m+    143[0m:[38;5;10m[49m         i32::MAX - 1,
[0m[49m[38;5;10m+    144[0m:[38;5;10m[49m         i32::MAX,
[0m[49m[38;5;10m+    145[0m:[38;5;10m[49m         0x8000_0000u32 as i32,
[0m[49m[38;5;10m+    146[0m:[38;5;10m[49m         0x7FFF_FFFF,
[0m[49m[38;5;10m+    147[0m:[38;5;10m[49m     ] {
[0m[49m[38;5;10m+    148[0m:[38;5;10m[49m         assert_rejected_noop("E6 boundary", imp, payload);
[0m[49m[38;5;10m+    149[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    150[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    151[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    152[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    153[0m:[38;5;10m[49m // E7 — only the low 32 bits of the enum argument are read
[0m[49m[38;5;10m+    154[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    155[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    156[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    157[0m:[38;5;10m[49m fn err_e7_high_half_ignored() {
[0m[49m[38;5;10m+    158[0m:[38;5;10m[49m     // `mov %edi,-0x4(%rbp)`: the high half of rdi is ignored, so a 64-bit value
[0m[49m[38;5;10m+    159[0m:[38;5;10m[49m     // whose low half is a valid enumerator takes the corresponding case.
[0m[49m[38;5;10m+    160[0m:[38;5;10m[49m     for (wide, expect_imp) in [
[0m[49m[38;5;10m+    161[0m:[38;5;10m[49m         (0x0000_0001_0000_0000i64, CB_PROTANOPIA),
[0m[49m[38;5;10m+    162[0m:[38;5;10m[49m         (0x0000_0001_0000_0001i64, CB_DEUTERANOPIA),
[0m[49m[38;5;10m+    163[0m:[38;5;10m[49m         (0x7FFF_FFFF_0000_0002i64, CB_TRITANOPIA),
[0m[49m[38;5;10m+    164[0m:[38;5;10m[49m         (-0x1_0000_0000i64, CB_PROTANOPIA), // low half == 0
[0m[49m[38;5;10m+    165[0m:[38;5;10m[49m     ] {
[0m[49m[38;5;10m+    166[0m:[38;5;10m[49m         let truncated = wide as i32;
[0m[49m[38;5;10m+    167[0m:[38;5;10m[49m         assert_eq!(truncated, expect_imp, "test vector is inconsistent");
[0m[49m[38;5;10m+    168[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    169[0m:[38;5;10m[49m         for v in [
[0m[49m[38;5;10m+    170[0m:[38;5;10m[49m             [0.25f32, 0.5, 0.75],
[0m[49m[38;5;10m+    171[0m:[38;5;10m[49m             [1.0, 0.0, 0.0],
[0m[49m[38;5;10m+    172[0m:[38;5;10m[49m             [f32::INFINITY, 1.0, f32::from_bits(0x7FC0_1234)],
[0m[49m[38;5;10m+    173[0m:[38;5;10m[49m         ] {
[0m[49m[38;5;10m+    174[0m:[38;5;10m[49m             // Passed as a plain c_int, which is what the C prototype declares;
[0m[49m[38;5;10m+    175[0m:[38;5;10m[49m             // the point of the row is that the *value* is out of enum range in
[0m[49m[38;5;10m+    176[0m:[38;5;10m[49m             // 64-bit terms yet valid once truncated.
[0m[49m[38;5;10m+    177[0m:[38;5;10m[49m             assert_same(&format!("E7 wide={wide:#018x}"), truncated, v);
[0m[49m[38;5;10m+    178[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    179[0m:[38;5;10m[49m             // And it must not be treated as a rejection.
[0m[49m[38;5;10m+    180[0m:[38;5;10m[49m             let out = c_impl().apply(truncated, v);
[0m[49m[38;5;10m+    181[0m:[38;5;10m[49m             assert_ne!(
[0m[49m[38;5;10m+    182[0m:[38;5;10m[49m                 bits(out),
[0m[49m[38;5;10m+    183[0m:[38;5;10m[49m                 bits(v),
[0m[49m[38;5;10m+    184[0m:[38;5;10m[49m                 "E7: expected the {} case to run for {wide:#018x}",
[0m[49m[38;5;10m+    185[0m:[38;5;10m[49m                 impairment_name(expect_imp)
[0m[49m[38;5;10m+    186[0m:[38;5;10m[49m             );
[0m[49m[38;5;10m+    187[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    188[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    189[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    190[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    191[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    192[0m:[38;5;10m[49m // E8..E11 — null pointers with a VALID impairment must fault identically
[0m[49m[38;5;10m+    193[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    194[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    195[0m:[38;5;10m[49m /// Set when this process is a crash child. Format: `<so-index>:<impairment>:<mask>`
[0m[49m[38;5;10m+    196[0m:[38;5;10m[49m /// where `so-index` 0 is the C `.so` and 1.. index into `rust_impls()`, and
[0m[49m[38;5;10m+    197[0m:[38;5;10m[49m /// `mask` bit 0/1/2 nulls out R/G/B respectively.
[0m[49m[38;5;10m+    198[0m:[38;5;10m[49m const CRASH_ENV: &str = "CB_CRASH_SPEC";
[0m[49m[38;5;10m+    199[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m /// The child entry point. Under normal test runs `CB_CRASH_SPEC` is unset and
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m /// this returns immediately.
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m fn err_crash_child_entrypoint() {
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m     let Ok(spec) = std::env::var(CRASH_ENV) else {
[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m         return;
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m     };
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m     let parts: Vec<&str> = spec.split(':').collect();
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m     assert_eq!(parts.len(), 3, "bad {CRASH_ENV}: {spec}");
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m     let so_index: usize = parts[0].parse().unwrap();
[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m     let imp: c_int = parts[1].parse().unwrap();
[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m     let mask: u8 = parts[2].parse().unwrap();
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m     let im: &Impl = if so_index == 0 {
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m         c_impl()
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m     } else {
[0m[49m[38;5;10m+    216[0m:[38;5;10m[49m         &rust_impls()[so_index - 1]
[0m[49m[38;5;10m+    217[0m:[38;5;10m[49m     };
[0m[49m[38;5;10m+    218[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    219[0m:[38;5;10m[49m     let mut r = 0.25f32;
[0m[49m[38;5;10m+    220[0m:[38;5;10m[49m     let mut g = 0.5f32;
[0m[49m[38;5;10m+    221[0m:[38;5;10m[49m     let mut b = 0.75f32;
[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m     let pr = if mask & 1 != 0 { std::ptr::null_mut() } else { &mut r as *mut f32 };
[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m     let pg = if mask & 2 != 0 { std::ptr::null_mut() } else { &mut g as *mut f32 };
[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m     let pb = if mask & 4 != 0 { std::ptr::null_mut() } else { &mut b as *mut f32 };
[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m     // Make sure the call is not optimised away and flush before faulting.
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m     eprintln!("crash child: so={so_index} imp={imp} mask={mask}");
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m     unsafe { (im.call)(imp, pr, pg, pb) };
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m     // If we get here the call did NOT fault; report that distinctly.
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m     println!("SURVIVED {r} {g} {b}");
