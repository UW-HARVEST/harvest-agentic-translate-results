[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m /// the C code. Ground truth is therefore "killed by SIGSEGV"; the Rust `.so`
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m /// must terminate the same way rather than, for instance, returning quietly or
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m /// aborting with a different signal.
[0m[49m[38;5;10m+    263[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    264[0m:[38;5;10m[49m fn err_e8_null_ptr_faults() {
[0m[49m[38;5;10m+    265[0m:[38;5;10m[49m     // (impairment, mask, ERRORS.md row)
[0m[49m[38;5;10m+    266[0m:[38;5;10m[49m     let cases: [(c_int, u8, &str); 8] = [
[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m         (CB_PROTANOPIA, 0b001, "E8  R=NULL, imp=0"),
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m         (CB_DEUTERANOPIA, 0b010, "E9  G=NULL, imp=1"),
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m         (CB_TRITANOPIA, 0b100, "E10 B=NULL, imp=2"),
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m         (CB_PROTANOPIA, 0b111, "E11 all NULL, imp=0"),
[0m[49m[38;5;10m+    271[0m:[38;5;10m[49m         (CB_DEUTERANOPIA, 0b111, "E11 all NULL, imp=1"),
[0m[49m[38;5;10m+    272[0m:[38;5;10m[49m         (CB_TRITANOPIA, 0b111, "E11 all NULL, imp=2"),
[0m[49m[38;5;10m+    273[0m:[38;5;10m[49m         (CB_PROTANOPIA, 0b011, "E8/E9 R,G=NULL, imp=0"),
[0m[49m[38;5;10m+    274[0m:[38;5;10m[49m         (CB_TRITANOPIA, 0b101, "E8/E10 R,B=NULL, imp=2"),
[0m[49m[38;5;10m+    275[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    277[0m:[38;5;10m[49m     for (imp, mask, row) in cases {
[0m[49m[38;5;10m+    278[0m:[38;5;10m[49m         let c_outcome = run_crash_child(0, imp, mask);
[0m[49m[38;5;10m+    279[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    280[0m:[38;5;10m[49m             c_outcome,
[0m[49m[38;5;10m+    281[0m:[38;5;10m[49m             Outcome::Signal(libc_sigsegv()),
[0m[49m[38;5;10m+    282[0m:[38;5;10m[49m             "[{row}] premise failed: the C .so did not die on SIGSEGV, got {c_outcome:?}"
[0m[49m[38;5;10m+    283[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    284[0m:[38;5;10m[49m         for (i, r) in rust_impls().iter().enumerate() {
[0m[49m[38;5;10m+    285[0m:[38;5;10m[49m             let got = run_crash_child(i + 1, imp, mask);
[0m[49m[38;5;10m+    286[0m:[38;5;10m[49m             assert_eq!(
[0m[49m[38;5;10m+    287[0m:[38;5;10m[49m                 got, c_outcome,
[0m[49m[38;5;10m+    288[0m:[38;5;10m[49m                 "[{row}] {} terminated as {got:?} but the C .so terminated as {c_outcome:?}",
[0m[49m[38;5;10m+    289[0m:[38;5;10m[49m                 r.label
[0m[49m[38;5;10m+    290[0m:[38;5;10m[49m             );
[0m[49m[38;5;10m+    291[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    292[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    293[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    294[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    295[0m:[38;5;10m[49m fn libc_sigsegv() -> i32 {
[0m[49m[38;5;10m+    296[0m:[38;5;10m[49m     11
[0m[49m[38;5;10m+    297[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    298[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    299[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    300[0m:[38;5;10m[49m // E12/E13 — an invalid impairment must NOT dereference, even a bad pointer
[0m[49m[38;5;10m+    301[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    302[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    303[0m:[38;5;10m[49m /// With no `case` taken, the pointers are never touched, so null pointers are
[0m[49m[38;5;10m+    304[0m:[38;5;10m[49m /// harmless. This is the row that catches a translation which validates or
[0m[49m[38;5;10m+    305[0m:[38;5;10m[49m /// dereferences its pointers before dispatching on the impairment.
[0m[49m[38;5;10m+    306[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    307[0m:[38;5;10m[49m fn err_e12_null_ptrs_invalid_impairment_is_safe() {
[0m[49m[38;5;10m+    308[0m:[38;5;10m[49m     for imp in [3, 4, -1, 17, c_int::MAX, c_int::MIN] {
[0m[49m[38;5;10m+    309[0m:[38;5;10m[49m         // In-process: if either .so dereferenced, the test process would die,
[0m[49m[38;5;10m+    310[0m:[38;5;10m[49m         // which the harness reports as a failure of this test.
[0m[49m[38;5;10m+    311[0m:[38;5;10m[49m         unsafe {
[0m[49m[38;5;10m+    312[0m:[38;5;10m[49m             (c_impl().call)(imp, std::ptr::null_mut(), std::ptr::null_mut(), std::ptr::null_mut())
[0m[49m[38;5;10m+    313[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+    314[0m:[38;5;10m[49m         for r in rust_impls() {
[0m[49m[38;5;10m+    315[0m:[38;5;10m[49m             unsafe {
[0m[49m[38;5;10m+    316[0m:[38;5;10m[49m                 (r.call)(imp, std::ptr::null_mut(), std::ptr::null_mut(), std::ptr::null_mut())
[0m[49m[38;5;10m+    317[0m:[38;5;10m[49m             };
[0m[49m[38;5;10m+    318[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    319[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    320[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    321[0m:[38;5;10m[49m     // Mixed: some null, some valid, still out of range -> still a no-op.
[0m[49m[38;5;10m+    322[0m:[38;5;10m[49m     for imp in [3, -1, c_int::MIN] {
[0m[49m[38;5;10m+    323[0m:[38;5;10m[49m         let mut a = 1.0f32;
[0m[49m[38;5;10m+    324[0m:[38;5;10m[49m         let mut b = 2.0f32;
[0m[49m[38;5;10m+    325[0m:[38;5;10m[49m         unsafe { (c_impl().call)(imp, &mut a, std::ptr::null_mut(), &mut b) };
[0m[49m[38;5;10m+    326[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    327[0m:[38;5;10m[49m             (a.to_bits(), b.to_bits()),
[0m[49m[38;5;10m+    328[0m:[38;5;10m[49m             (1.0f32.to_bits(), 2.0f32.to_bits()),
[0m[49m[38;5;10m+    329[0m:[38;5;10m[49m             "E12 premise failed: C wrote through a valid pointer for imp={imp}"
[0m[49m[38;5;10m+    330[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    331[0m:[38;5;10m[49m         for r in rust_impls() {
[0m[49m[38;5;10m+    332[0m:[38;5;10m[49m             let mut ra = 1.0f32;
[0m[49m[38;5;10m+    333[0m:[38;5;10m[49m             let mut rb = 2.0f32;
[0m[49m[38;5;10m+    334[0m:[38;5;10m[49m             unsafe { (r.call)(imp, &mut ra, std::ptr::null_mut(), &mut rb) };
[0m[49m[38;5;10m+    335[0m:[38;5;10m[49m             assert_eq!(
[0m[49m[38;5;10m+    336[0m:[38;5;10m[49m                 (ra.to_bits(), rb.to_bits()),
[0m[49m[38;5;10m+    337[0m:[38;5;10m[49m                 (a.to_bits(), b.to_bits()),
[0m[49m[38;5;10m+    338[0m:[38;5;10m[49m                 "E12 divergence in {} for imp={imp}",
[0m[49m[38;5;10m+    339[0m:[38;5;10m[49m                 r.label
[0m[49m[38;5;10m+    340[0m:[38;5;10m[49m             );
[0m[49m[38;5;10m+    341[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    342[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    343[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    344[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    345[0m:[38;5;10m[49m /// Same, with non-null but deliberately unmapped addresses: proves the pointers
[0m[49m[38;5;10m+    346[0m:[38;5;10m[49m /// are not read merely because they are non-null.
[0m[49m[38;5;10m+    347[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    348[0m:[38;5;10m[49m fn err_e13_bogus_ptr_invalid_impairment_is_safe() {
[0m[49m[38;5;10m+    349[0m:[38;5;10m[49m     let bogus = [1usize, 3, 0xDEAD, 0xFFFF_FFFF_FFF0];
[0m[49m[38;5;10m+    350[0m:[38;5;10m[49m     for imp in [3, 4, -1, c_int::MAX, c_int::MIN] {
[0m[49m[38;5;10m+    351[0m:[38;5;10m[49m         for &addr in &bogus {
[0m[49m[38;5;10m+    352[0m:[38;5;10m[49m             let p = addr as *mut f32;
[0m[49m[38;5;10m+    353[0m:[38;5;10m[49m             unsafe { (c_impl().call)(imp, p, p, p) };
[0m[49m[38;5;10m+    354[0m:[38;5;10m[49m             for r in rust_impls() {
[0m[49m[38;5;10m+    355[0m:[38;5;10m[49m                 unsafe { (r.call)(imp, p, p, p) };
[0m[49m[38;5;10m+    356[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    357[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    358[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    359[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    360[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    361[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    362[0m:[38;5;10m[49m // E14 — signalling NaNs are not rejected; they are quieted
[0m[49m[38;5;10m+    363[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    364[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    365[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    366[0m:[38;5;10m[49m fn err_e14_signaling_nan_not_rejected() {
[0m[49m[38;5;10m+    367[0m:[38;5;10m[49m     // Hand-picked sNaN encodings: minimum payload, maximum payload, both signs,
[0m[49m[38;5;10m+    368[0m:[38;5;10m[49m     // and the payloads that alias the default QNaN once quieted.
[0m[49m[38;5;10m+    369[0m:[38;5;10m[49m     let snans: [u32; 10] = [
[0m[49m[38;5;10m+    370[0m:[38;5;10m[49m         0x7F80_0001,
[0m[49m[38;5;10m+    371[0m:[38;5;10m[49m         0xFF80_0001,
[0m[49m[38;5;10m+    372[0m:[38;5;10m[49m         0x7FBF_FFFF,
[0m[49m[38;5;10m+    373[0m:[38;5;10m[49m         0xFFBF_FFFF,
[0m[49m[38;5;10m+    374[0m:[38;5;10m[49m         0x7F80_0002,
[0m[49m[38;5;10m+    375[0m:[38;5;10m[49m         0xFF80_1234,
[0m[49m[38;5;10m+    376[0m:[38;5;10m[49m         0x7F9F_FFFF,
[0m[49m[38;5;10m+    377[0m:[38;5;10m[49m         0xFFA5_5555,
[0m[49m[38;5;10m+    378[0m:[38;5;10m[49m         0x7F80_00FF,
[0m[49m[38;5;10m+    379[0m:[38;5;10m[49m         0xFF80_8000,
[0m[49m[38;5;10m+    380[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    381[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    382[0m:[38;5;10m[49m     for &imp in &VALID_IMPAIRMENTS {
[0m[49m[38;5;10m+    383[0m:[38;5;10m[49m         for &a in &snans {
[0m[49m[38;5;10m+    384[0m:[38;5;10m[49m             for &b in &snans {
[0m[49m[38;5;10m+    385[0m:[38;5;10m[49m                 // sNaN in each position, with ordinary values elsewhere, and
[0m[49m[38;5;10m+    386[0m:[38;5;10m[49m                 // with two sNaNs at once (which is what pins dst/src priority).
[0m[49m[38;5;10m+    387[0m:[38;5;10m[49m                 let vectors: [[f32; 3]; 6] = [
[0m[49m[38;5;10m+    388[0m:[38;5;10m[49m                     [f32::from_bits(a), 0.5, 0.25],
[0m[49m[38;5;10m+    389[0m:[38;5;10m[49m                     [0.5, f32::from_bits(a), 0.25],
[0m[49m[38;5;10m+    390[0m:[38;5;10m[49m                     [0.5, 0.25, f32::from_bits(a)],
[0m[49m[38;5;10m+    391[0m:[38;5;10m[49m                     [f32::from_bits(a), f32::from_bits(b), 0.25],
[0m[49m[38;5;10m+    392[0m:[38;5;10m[49m                     [f32::from_bits(a), 0.25, f32::from_bits(b)],
[0m[49m[38;5;10m+    393[0m:[38;5;10m[49m                     [0.25, f32::from_bits(a), f32::from_bits(b)],
[0m[49m[38;5;10m+    394[0m:[38;5;10m[49m                 ];
[0m[49m[38;5;10m+    395[0m:[38;5;10m[49m                 for v in vectors {
[0m[49m[38;5;10m+    396[0m:[38;5;10m[49m                     // Ground truth: an sNaN is NOT rejected; the call proceeds.
[0m[49m[38;5;10m+    397[0m:[38;5;10m[49m                     let out = c_impl().apply(imp, v);
[0m[49m[38;5;10m+    398[0m:[38;5;10m[49m                     assert!(
[0m[49m[38;5;10m+    399[0m:[38;5;10m[49m                         out.iter().any(|x| x.is_nan()),
[0m[49m[38;5;10m+    400[0m:[38;5;10m[49m                         "E14 premise failed: no NaN in the C output {} for input {}",
[0m[49m[38;5;10m+    401[0m:[38;5;10m[49m                         show(out),
[0m[49m[38;5;10m+    402[0m:[38;5;10m[49m                         show(v)
[0m[49m[38;5;10m+    403[0m:[38;5;10m[49m                     );
[0m[49m[38;5;10m+    404[0m:[38;5;10m[49m                     assert_same("E14", imp, v);
[0m[49m[38;5;10m+    405[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    406[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    407[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    408[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    409[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    410[0m:[38;5;10m[49m     // Plus a randomized sweep over the whole sNaN encoding space.
[0m[49m[38;5;10m+    411[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0x5NAN_u64.wrapping_mul(1));
[0m[49m[38;5;10m+    412[0m:[38;5;10m[49m     for i in 0..20_000 {
[0m[49m[38;5;10m+    413[0m:[38;5;10m[49m         let v = draw_triple(&mut rng, VClass::SignallingNan);
[0m[49m[38;5;10m+    414[0m:[38;5;10m[49m         assert_same(&format!("E14 random#{i}"), VALID_IMPAIRMENTS[i % 3], v);
[0m[49m[38;5;10m+    415[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    416[0m:[38;5;10m[49m }
