[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m         .expect("spawn crash child");
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m     match out.status.signal() {
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m         Some(s) => Outcome::Signal(s),
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m         None => Outcome::Exit(out.status.code().unwrap_or(-1)),
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m 
