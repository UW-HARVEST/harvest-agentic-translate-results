[0m[49m[38;5;10m+    415[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    416[0m:[38;5;10m[49m /// Bytes that are neither digits, signs nor `isspace`.
[0m[49m[38;5;10m+    417[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    418[0m:[38;5;10m[49m fn non_ascii_and_control_bytes() {
