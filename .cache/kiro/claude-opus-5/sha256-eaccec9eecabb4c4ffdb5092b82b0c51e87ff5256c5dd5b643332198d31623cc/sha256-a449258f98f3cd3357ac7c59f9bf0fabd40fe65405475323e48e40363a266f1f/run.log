[0m[49m[38;5;10m+    370[0m:[38;5;10m[49m /// glibc's `%d` collects the digits and runs them through `strtol`, which
[0m[49m[38;5;10m+    371[0m:[38;5;10m[49m /// *saturates* at LONG_MAX / LONG_MIN on overflow; the saturated `long` is then
[0m[49m[38;5;10m+    372[0m:[38;5;10m[49m /// truncated when stored through the `int *`. That is observably different from
[0m[49m[38;5;10m+    373[0m:[38;5;10m[49m /// wrapping 64-bit arithmetic, so each of these pins the behavior down.
[0m[49m[38;5;10m+    374[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    375[0m:[38;5;10m[49m fn overflow_saturation_and_truncation() {
[0m[49m[38;5;10m+    376[0m:[38;5;10m[49m     // Fits in a long, truncates to 1/2/3 -> success path.
[0m[49m[38;5;10m+    377[0m:[38;5;10m[49m     same("x = 2^32 + 1 truncates to 1", "4294967297 2 3");
[0m[49m[38;5;10m+    378[0m:[38;5;10m[49m     same("x = 2^33 + 1 truncates to 1", "8589934593 2 3");
[0m[49m[38;5;10m+    379[0m:[38;5;10m[49m     same("y = 2^32 + 2 truncates to 2", "1 4294967298 3");
[0m[49m[38;5;10m+    380[0m:[38;5;10m[49m     same("z = 2^32 + 3 truncates to 3", "1 2 4294967299");
[0m[49m[38;5;10m+    381[0m:[38;5;10m[49m     same("x negative wrap to 1", "-4294967295 2 3");
[0m[49m[38;5;10m+    382[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    383[0m:[38;5;10m[49m     // Exactly at the long boundaries.
[0m[49m[38;5;10m+    384[0m:[38;5;10m[49m     same("y = LONG_MAX", "1 9223372036854775807 3");
[0m[49m[38;5;10m+    385[0m:[38;5;10m[49m     same("y = LONG_MIN", "1 -9223372036854775808 3");
[0m[49m[38;5;10m+    386[0m:[38;5;10m[49m     same("x = LONG_MAX", "9223372036854775807 2 3");
[0m[49m[38;5;10m+    387[0m:[38;5;10m[49m     same("x = LONG_MIN", "-9223372036854775808 2 3");
[0m[49m[38;5;10m+    388[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    389[0m:[38;5;10m[49m     // Past the long boundaries: saturation, NOT wraparound. If the Rust side
[0m[49m[38;5;10m+    390[0m:[38;5;10m[49m     // wrapped instead of saturating, `2^64 + 2` would land on y == 2 and print
[0m[49m[38;5;10m+    391[0m:[38;5;10m[49m     // "Ok!" where the C prints the y error.
[0m[49m[38;5;10m+    392[0m:[38;5;10m[49m     same("y = 2^64 + 2 (saturates, does not wrap to 2)", "1 18446744073709551618 3");
[0m[49m[38;5;10m+    393[0m:[38;5;10m[49m     same("z = 2^64 + 3 (saturates, does not wrap to 3)", "1 2 18446744073709551619");
[0m[49m[38;5;10m+    394[0m:[38;5;10m[49m     same("x = 2^64 + 1 (saturates, does not wrap to 1)", "18446744073709551617 2 3");
[0m[49m[38;5;10m+    395[0m:[38;5;10m[49m     same("y = -(2^64 - 2) (saturates, does not wrap to 2)", "1 -18446744073709551614 3");
[0m[49m[38;5;10m+    396[0m:[38;5;10m[49m     same("y = LONG_MAX + 1", "1 9223372036854775808 3");
[0m[49m[38;5;10m+    397[0m:[38;5;10m[49m     same("y = LONG_MIN - 1", "1 -9223372036854775809 3");
[0m[49m[38;5;10m+    398[0m:[38;5;10m[49m     same("x = 20 nines", "99999999999999999999 2 3");
[0m[49m[38;5;10m+    399[0m:[38;5;10m[49m     same("y = 21 digits", "1 184467440737095516180 3");
[0m[49m[38;5;10m+    400[0m:[38;5;10m[49m     same("x = INT_MAX + 1", "2147483648 2 3");
[0m[49m[38;5;10m+    401[0m:[38;5;10m[49m     same("x = 2^63 - 2^31 + 2", "9223372034707292162 2 3");
[0m[49m[38;5;10m+    402[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    403[0m:[38;5;10m[49m 
