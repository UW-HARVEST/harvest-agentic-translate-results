[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m         c.status,
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m         r.status,
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m         "\n{}\nEXIT STATUS differs (Ok = exit code, Err = signal)\n  C    = {:?}\n  Rust = {:?}",
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m         ctx(),
