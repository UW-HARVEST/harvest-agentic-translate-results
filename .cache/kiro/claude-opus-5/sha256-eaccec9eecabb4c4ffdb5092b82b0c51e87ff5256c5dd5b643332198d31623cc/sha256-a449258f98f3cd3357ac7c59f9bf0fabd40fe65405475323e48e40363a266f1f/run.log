[0m[49m[38;5;10m+    155[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    156[0m:[38;5;10m[49m // The differential assertion
[0m[49m[38;5;10m+    157[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    158[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    159[0m:[38;5;10m[49m fn show(bytes: &[u8]) -> String {
[0m[49m[38;5;10m+    160[0m:[38;5;10m[49m     match std::str::from_utf8(bytes) {
[0m[49m[38;5;10m+    161[0m:[38;5;10m[49m         Ok(s) => format!("{s:?}"),
