[0m[49m[38;5;10m+    194[0m:[38;5;10m[49m         hex(&r.stdout)
[0m[49m[38;5;10m+    195[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    196[0m:[38;5;10m[49m     assert_eq!(
[0m[49m[38;5;10m+    197[0m:[38;5;10m[49m         c.stderr,
[0m[49m[38;5;10m+    198[0m:[38;5;10m[49m         r.stderr,
[0m[49m[38;5;10m+    199[0m:[38;5;10m[49m         "\n{}\nSTDERR differs\n  C    = {}\n  Rust = {}",
[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m         ctx(),
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m         show(&c.stderr),
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m         show(&r.stderr)
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m     );
