[0m[49m[38;5;10m+    427[0m:[38;5;10m[49m     assert_same("bell/backspace/escape", b"1\x072\x083\x1b");
[0m[49m[38;5;10m+    428[0m:[38;5;10m[49m     // 0x1c..0x1f are not isspace in the C locale even though some tables list
[0m[49m[38;5;10m+    429[0m:[38;5;10m[49m     // them as separators.
[0m[49m[38;5;10m+    430[0m:[38;5;10m[49m     assert_same("0x1c-0x1f separators", b"1\x1c2\x1d3");
[0m[49m[38;5;10m+    431[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    432[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    433[0m:[38;5;10m[49m /// Huge amounts of leading whitespace, and huge amounts of unread trailing
[0m[49m[38;5;10m+    434[0m:[38;5;10m[49m /// input (the program exits without draining stdin).
