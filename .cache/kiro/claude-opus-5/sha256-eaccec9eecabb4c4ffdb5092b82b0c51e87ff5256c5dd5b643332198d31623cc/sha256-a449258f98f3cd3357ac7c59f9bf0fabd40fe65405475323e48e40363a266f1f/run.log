[0m[49m[38;5;10m+    142[0m:[38;5;10m[49m         #[cfg(not(unix))]
[0m[49m[38;5;10m+    143[0m:[38;5;10m[49m         {
[0m[49m[38;5;10m+    144[0m:[38;5;10m[49m             Ok(out.status.code().unwrap_or(-1))
[0m[49m[38;5;10m+    145[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    146[0m:[38;5;10m[49m     };
