[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m fn both_binaries_exist_and_run() {
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m     assert!(c_bin().exists(), "C binary not built: {}", c_bin().display());
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m     assert!(
