[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m         rust_bin().display()
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m     // A trivial run must succeed for both, otherwise every other test is
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m     // measuring nothing.
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m     let c = run(c_bin(), b"1 2 3");
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m     let r = run(rust_bin(), b"1 2 3");
