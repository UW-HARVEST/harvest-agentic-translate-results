[0m[49m[38;5;10m+    407[0m:[38;5;10m[49m fn very_long_digit_runs() {
[0m[49m[38;5;10m+    408[0m:[38;5;10m[49m     same("23 leading zeros then 1", "00000000000000000000001 2 3");
[0m[49m[38;5;10m+    409[0m:[38;5;10m[49m     same("5001-digit x", &format!("1{} 2 3", "0".repeat(5000)));
