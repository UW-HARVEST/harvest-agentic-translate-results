[0m[49m[38;5;10m+    323[0m:[38;5;10m[49m         1 => rng.range_i32(0, 1 << 20) << 4,
[0m[49m[38;5;10m+    324[0m:[38;5;10m[49m         2 => -(rng.range_i32(0, 1 << 20) << 4),
[0m[49m[38;5;10m+    325[0m:[38;5;10m[49m         3 => !0i32 << 4,          // uni becomes negative with the chosen low nibble
[0m[49m[38;5;10m+    326[0m:[38;5;10m[49m         4 => i32::MIN,            // most-negative high bits
[0m[49m[38;5;10m+    327[0m:[38;5;10m[49m         _ => (rng.next_i32() >> 4) << 4,
[0m[49m[38;5;10m+    328[0m:[38;5;10m[49m     };
