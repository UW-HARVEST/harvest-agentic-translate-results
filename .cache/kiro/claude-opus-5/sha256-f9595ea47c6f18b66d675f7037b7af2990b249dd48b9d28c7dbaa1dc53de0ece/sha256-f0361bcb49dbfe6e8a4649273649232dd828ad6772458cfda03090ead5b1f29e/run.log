[0m[49m[38;5;10m+    309[0m:[38;5;10m[49m /// Generate a `uni` whose low nibble lands in the requested class, with the
[0m[49m[38;5;10m+    310[0m:[38;5;10m[49m /// high bits randomized (including negative values and near-boundary values).
[0m[49m[38;5;10m+    311[0m:[38;5;10m[49m fn gen_uni(rng: &mut Rng, c: UniClass) -> i32 {
