[0m[49m[38;5;10m+    313[0m:[38;5;10m[49m         UniClass::Low0 => 0x0,
[0m[49m[38;5;10m+    314[0m:[38;5;10m[49m         UniClass::Low7 => 0x7,
[0m[49m[38;5;10m+    315[0m:[38;5;10m[49m         UniClass::MidB30 => rng.range_i32(1, 6),
[0m[49m[38;5;10m+    316[0m:[38;5;10m[49m         UniClass::Low8 => 0x8,
[0m[49m[38;5;10m+    317[0m:[38;5;10m[49m         UniClass::Low15 => 0xF,
