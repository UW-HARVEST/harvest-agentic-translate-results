[0m[49m[38;5;10m+    351[0m:[38;5;10m[49m         let frac = (x.fract() * 100_000.0).round() as u64 % 100_000;
[0m[49m[38;5;10m+    352[0m:[38;5;10m[49m         let d4 = (frac / 10) % 10;
