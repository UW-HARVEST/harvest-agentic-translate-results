[0m[49m[38;5;10m+    151[0m:[38;5;10m[49m                     y: t * 3.0,
[0m[49m[38;5;10m+    152[0m:[38;5;10m[49m                 },
[0m[49m[38;5;10m+    153[0m:[38;5;10m[49m                 c2v { x: t, y: t },
[0m[49m[38;5;10m+    154[0m:[38;5;10m[49m             ],
[0m[49m[38;5;10m+    155[0m:[38;5;10m[49m             1.0,
[0m[49m[38;5;10m+    156[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    157[0m:[38;5;10m[49m         diff_c22(c, r, &format!("row26 k={k}"), s);
[0m[49m[38;5;10m+    158[0m:[38;5;10m[49m         let mut chk = s;
[0m[49m[38;5;10m+    159[0m:[38;5;10m[49m         unsafe { (c.c22)(&mut chk) };
[0m[49m[38;5;10m+    160[0m:[38;5;10m[49m         assert_eq!(chk.count, 1, "row26 k={k}: expected the count=1 branch");
[0m[49m[38;5;10m+    161[0m:[38;5;10m[49m         assert_eq!(
