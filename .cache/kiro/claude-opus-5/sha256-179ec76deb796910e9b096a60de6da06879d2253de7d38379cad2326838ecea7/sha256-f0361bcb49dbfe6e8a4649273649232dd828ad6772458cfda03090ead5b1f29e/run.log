[0m[49m[38;5;10m+    219[0m:[38;5;10m[49m     let mut rs = s;
[0m[49m[38;5;10m+    220[0m:[38;5;10m[49m     unsafe { (c.c23)(&mut cs) };
[0m[49m[38;5;10m+    221[0m:[38;5;10m[49m     unsafe { (r.c23)(&mut rs) };
[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m     eq_simplex(ctx, &cs, &rs);
[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m     cs
[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m /// Rows 30-36 — every one of the seven `c23` branches, reached deliberately by
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m /// placing the origin in each Voronoi region of a triangle, then verified to
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m /// have actually been taken (via the resulting `count` and vertex shuffle).
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m ///
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m /// A large randomized sweep records which branches were hit so the test fails
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m /// loudly if any branch is left unexercised.
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m fn row30_36_c23_all_seven_branches() {
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m     let (c, r) = apis();
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m     let mut hits = [0usize; 7];
[0m[49m[38;5;10m+    236[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    237[0m:[38;5;10m[49m     // Classify by replicating the C's branch conditions (used only to assert
[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m     // coverage; correctness itself is decided by the differential compare).
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m     let classify = |a: c2v, b: c2v, cc: c2v| -> usize {
[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m         let dot = |p: c2v, q: c2v| p.x * q.x + p.y * q.y;
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m         let sub = |p: c2v, q: c2v| c2v {
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m             x: p.x - q.x,
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m             y: p.y - q.y,
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m         let det = |p: c2v, q: c2v| p.x * q.y - p.y * q.x;
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m         let uab = dot(b, sub(b, a));
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m         let vab = dot(a, sub(a, b));
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m         let ubc = dot(cc, sub(cc, b));
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m         let vbc = dot(b, sub(b, cc));
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m         let uca = dot(a, sub(a, cc));
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m         let vca = dot(cc, sub(cc, a));
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m         let area = det(sub(b, a), sub(cc, a));
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m         let uabc = det(b, cc) * area;
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m         let vabc = det(cc, a) * area;
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m         let wabc = det(a, b) * area;
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m         if vab <= 0.0 && uca <= 0.0 {
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m             0
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m         } else if uab <= 0.0 && vbc <= 0.0 {
[0m[49m[38;5;10m+    259[0m:[38;5;10m[49m             1
[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m         } else if ubc <= 0.0 && vca <= 0.0 {
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m             2
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m         } else if uab > 0.0 && vab > 0.0 && wabc <= 0.0 {
[0m[49m[38;5;10m+    263[0m:[38;5;10m[49m             3
[0m[49m[38;5;10m+    264[0m:[38;5;10m[49m         } else if ubc > 0.0 && vbc > 0.0 && uabc <= 0.0 {
[0m[49m[38;5;10m+    265[0m:[38;5;10m[49m             4
[0m[49m[38;5;10m+    266[0m:[38;5;10m[49m         } else if uca > 0.0 && vca > 0.0 && vabc <= 0.0 {
[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m             5
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m         } else {
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m             6
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    271[0m:[38;5;10m[49m     };
[0m[49m[38;5;10m+    272[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    273[0m:[38;5;10m[49m     // Hand-built cases: a triangle, translated so the origin lands in each of
[0m[49m[38;5;10m+    274[0m:[38;5;10m[49m     // its 7 feature regions (3 vertices, 3 edges, interior).
[0m[49m[38;5;10m+    275[0m:[38;5;10m[49m     let tri = [
[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m         c2v { x: 0.0, y: 0.0 },
[0m[49m[38;5;10m+    277[0m:[38;5;10m[49m         c2v { x: 4.0, y: 0.0 },
[0m[49m[38;5;10m+    278[0m:[38;5;10m[49m         c2v { x: 0.0, y: 3.0 },
[0m[49m[38;5;10m+    279[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    280[0m:[38;5;10m[49m     let offsets = [
[0m[49m[38;5;10m+    281[0m:[38;5;10m[49m         c2v { x: -2.0, y: -2.0 },  // beyond vertex A
[0m[49m[38;5;10m+    282[0m:[38;5;10m[49m         c2v { x: 6.0, y: -2.0 },   // beyond vertex B
[0m[49m[38;5;10m+    283[0m:[38;5;10m[49m         c2v { x: -2.0, y: 5.0 },   // beyond vertex C
[0m[49m[38;5;10m+    284[0m:[38;5;10m[49m         c2v { x: 2.0, y: -2.0 },   // edge AB
[0m[49m[38;5;10m+    285[0m:[38;5;10m[49m         c2v { x: 4.0, y: 3.0 },    // edge BC
[0m[49m[38;5;10m+    286[0m:[38;5;10m[49m         c2v { x: -2.0, y: 1.5 },   // edge CA
[0m[49m[38;5;10m+    287[0m:[38;5;10m[49m         c2v { x: 1.0, y: 1.0 },    // interior
[0m[49m[38;5;10m+    288[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    289[0m:[38;5;10m[49m     for (oi, off) in offsets.iter().enumerate() {
[0m[49m[38;5;10m+    290[0m:[38;5;10m[49m         let pts: Vec<c2v> = tri
[0m[49m[38;5;10m+    291[0m:[38;5;10m[49m             .iter()
[0m[49m[38;5;10m+    292[0m:[38;5;10m[49m             .map(|p| c2v {
[0m[49m[38;5;10m+    293[0m:[38;5;10m[49m                 x: p.x - off.x,
[0m[49m[38;5;10m+    294[0m:[38;5;10m[49m                 y: p.y - off.y,
[0m[49m[38;5;10m+    295[0m:[38;5;10m[49m             })
[0m[49m[38;5;10m+    296[0m:[38;5;10m[49m             .collect();
[0m[49m[38;5;10m+    297[0m:[38;5;10m[49m         let s = simplex_from_points(&pts, 1.0);
[0m[49m[38;5;10m+    298[0m:[38;5;10m[49m         let out = diff_c23(c, r, &format!("row30-36 offset#{oi}"), s);
[0m[49m[38;5;10m+    299[0m:[38;5;10m[49m         let br = classify(pts[0], pts[1], pts[2]);
[0m[49m[38;5;10m+    300[0m:[38;5;10m[49m         hits[br] += 1;
[0m[49m[38;5;10m+    301[0m:[38;5;10m[49m         // Sanity: branches 0..3 collapse to count 1, 3..6 to 2, 6 to 3.
[0m[49m[38;5;10m+    302[0m:[38;5;10m[49m         let expect_count = match br {
[0m[49m[38;5;10m+    303[0m:[38;5;10m[49m             0 | 1 | 2 => 1,
[0m[49m[38;5;10m+    304[0m:[38;5;10m[49m             3 | 4 | 5 => 2,
[0m[49m[38;5;10m+    305[0m:[38;5;10m[49m             _ => 3,
[0m[49m[38;5;10m+    306[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+    307[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    308[0m:[38;5;10m[49m             out.count, expect_count,
[0m[49m[38;5;10m+    309[0m:[38;5;10m[49m             "row30-36 offset#{oi}: branch {br} should yield count {expect_count}"
[0m[49m[38;5;10m+    310[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    311[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    312[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    313[0m:[38;5;10m[49m     // Randomized sweep across many triangle shapes and origin placements.
[0m[49m[38;5;10m+    314[0m:[38;5;10m[49m     let mut g = Rng::new(SEED ^ 30);
[0m[49m[38;5;10m+    315[0m:[38;5;10m[49m     for i in 0..N {
[0m[49m[38;5;10m+    316[0m:[38;5;10m[49m         let pts = [g.v(), g.v(), g.v()];
[0m[49m[38;5;10m+    317[0m:[38;5;10m[49m         let s = simplex_from_points(&pts, 1.0);
[0m[49m[38;5;10m+    318[0m:[38;5;10m[49m         diff_c23(c, r, &format!("row30-36 random #{i}"), s);
