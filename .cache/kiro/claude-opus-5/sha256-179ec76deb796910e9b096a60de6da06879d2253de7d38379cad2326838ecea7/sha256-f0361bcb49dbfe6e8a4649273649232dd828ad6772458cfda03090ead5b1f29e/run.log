[0m[49m[38;5;10m+    632[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    633[0m:[38;5;10m[49m // Shape-as-bytes helper: lets us hand the same raw buffer to both libraries
[0m[49m[38;5;10m+    634[0m:[38;5;10m[49m // (including for out-of-range type tags, where the C reads nothing at all).
[0m[49m[38;5;10m+    635[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    636[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    637[0m:[38;5;10m[49m /// A 32-byte zero-padded buffer, big enough for any of the three shapes, so
[0m[49m[38;5;10m+    638[0m:[38;5;10m[49m /// out-of-range type tags never read indeterminate memory on either side.
[0m[49m[38;5;10m+    639[0m:[38;5;10m[49m #[repr(C, align(8))]
[0m[49m[38;5;10m+    640[0m:[38;5;10m[49m pub struct ShapeBuf(pub [u8; 32]);
[0m[49m[38;5;10m+    641[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    642[0m:[38;5;10m[49m impl ShapeBuf {
[0m[49m[38;5;10m+    643[0m:[38;5;10m[49m     pub fn zeroed() -> ShapeBuf {
[0m[49m[38;5;10m+    644[0m:[38;5;10m[49m         ShapeBuf([0u8; 32])
[0m[49m[38;5;10m+    645[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    646[0m:[38;5;10m[49m     pub fn from_circle(c: c2Circle) -> ShapeBuf {
[0m[49m[38;5;10m+    647[0m:[38;5;10m[49m         let mut b = ShapeBuf::zeroed();
[0m[49m[38;5;10m+    648[0m:[38;5;10m[49m         unsafe { std::ptr::write(b.0.as_mut_ptr() as *mut c2Circle, c) };
[0m[49m[38;5;10m+    649[0m:[38;5;10m[49m         b
[0m[49m[38;5;10m+    650[0m:[38;5;10m[49m     }
