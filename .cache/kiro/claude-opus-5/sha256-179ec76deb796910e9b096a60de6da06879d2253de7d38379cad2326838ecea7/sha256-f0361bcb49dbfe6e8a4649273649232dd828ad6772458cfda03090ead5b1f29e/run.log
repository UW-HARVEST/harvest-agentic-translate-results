[0m[49m[38;5;10m+    670[0m:[38;5;10m[49m /// real inputs the library must handle identically.
[0m[49m[38;5;10m+    671[0m:[38;5;10m[49m pub const BAD_TYPES: [C2_TYPE; 8] = [3, 4, 100, -1, -2, i32::MAX, i32::MIN, 0x7fff_0000];
[0m[49m[38;5;10m+    672[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    673[0m:[38;5;10m[49m pub fn type_name(t: C2_TYPE) -> &'static str {
[0m[49m[38;5;10m+    674[0m:[38;5;10m[49m     match t {
[0m[49m[38;5;10m+    675[0m:[38;5;10m[49m         C2_TYPE_CAPSULE => "CAPSULE",
[0m[49m[38;5;10m+    676[0m:[38;5;10m[49m         C2_TYPE_CIRCLE => "CIRCLE",
[0m[49m[38;5;10m+    677[0m:[38;5;10m[49m         C2_TYPE_AABB => "AABB",
[0m[49m[38;5;10m+    678[0m:[38;5;10m[49m         _ => "INVALID",
[0m[49m[38;5;10m+    679[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    680[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    681[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    682[0m:[38;5;10m[49m /// Build a random shape of the given type as a byte buffer.
[0m[49m[38;5;10m+    683[0m:[38;5;10m[49m pub fn rand_shape(rng: &mut Rng, t: C2_TYPE) -> ShapeBuf {
[0m[49m[38;5;10m+    684[0m:[38;5;10m[49m     match t {
[0m[49m[38;5;10m+    685[0m:[38;5;10m[49m         C2_TYPE_CIRCLE => ShapeBuf::from_circle(rng.circle()),
[0m[49m[38;5;10m+    686[0m:[38;5;10m[49m         C2_TYPE_AABB => ShapeBuf::from_aabb(rng.aabb()),
