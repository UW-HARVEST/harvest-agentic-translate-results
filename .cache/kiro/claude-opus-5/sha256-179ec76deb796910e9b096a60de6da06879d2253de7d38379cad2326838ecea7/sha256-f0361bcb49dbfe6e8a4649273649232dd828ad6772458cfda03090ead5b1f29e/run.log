[0m[49m[38;5;10m+    138[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    139[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    140[0m:[38;5;10m[49m /// Row 26 — branch `u <= 0`: the origin is beyond `b`, vertex A is replaced by
[0m[49m[38;5;10m+    141[0m:[38;5;10m[49m /// vertex B (so the `sA`/`sB`/`iA`/`iB` copy is observable).
[0m[49m[38;5;10m+    142[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    143[0m:[38;5;10m[49m fn row26_c22_branch_u_le_0() {
[0m[49m[38;5;10m+    144[0m:[38;5;10m[49m     let (c, r) = apis();
[0m[49m[38;5;10m+    145[0m:[38;5;10m[49m     for k in 1..200i32 {
[0m[49m[38;5;10m+    146[0m:[38;5;10m[49m         let t = k as f32 * 0.37;
[0m[49m[38;5;10m+    147[0m:[38;5;10m[49m         let s = simplex_from_points(
[0m[49m[38;5;10m+    148[0m:[38;5;10m[49m             &[
