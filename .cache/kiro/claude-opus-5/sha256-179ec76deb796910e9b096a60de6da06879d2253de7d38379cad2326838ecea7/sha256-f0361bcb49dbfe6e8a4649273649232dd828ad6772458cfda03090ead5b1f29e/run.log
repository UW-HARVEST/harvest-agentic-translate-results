[0m[49m[38;5;10m+    493[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    494[0m:[38;5;10m[49m     /// Full float-class spread: normals, zeros, subnormals, huge, inf, NaN.
[0m[49m[38;5;10m+    495[0m:[38;5;10m[49m     pub fn wild(&mut self) -> f32 {
