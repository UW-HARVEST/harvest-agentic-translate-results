[0m[49m[38;5;10m+     774[0m:[38;5;10m[49m                         b: p2,
[0m[49m[38;5;10m+     775[0m:[38;5;10m[49m                         r: rad,
[0m[49m[38;5;10m+     776[0m:[38;5;10m[49m                     })
[0m[49m[38;5;10m+     777[0m:[38;5;10m[49m                 }
