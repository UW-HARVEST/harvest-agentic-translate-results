[0m[49m[38;5;10m+    481[0m:[38;5;10m[49m                     rc = ro.cache.unwrap();
[0m[49m[38;5;10m+    482[0m:[38;5;10m[49m                     eq_cache(&format!("{ctx} cache"), &cc, &rc);
[0m[49m[38;5;10m+    483[0m:[38;5;10m[49m                 }
