[0m[49m[38;5;10m+    474[0m:[38;5;10m[49m                         type_name(tb)
[0m[49m[38;5;10m+    475[0m:[38;5;10m[49m                     );
[0m[49m[38;5;10m+    476[0m:[38;5;10m[49m                     eq_f32(&format!("{ctx} dist"), co.dist, ro.dist);
[0m[49m[38;5;10m+    477[0m:[38;5;10m[49m                     eq_v(&format!("{ctx} outA"), co.outA, ro.outA);
[0m[49m[38;5;10m+    478[0m:[38;5;10m[49m                     eq_v(&format!("{ctx} outB"), co.outB, ro.outB);
[0m[49m[38;5;10m+    479[0m:[38;5;10m[49m                     eq_int(&format!("{ctx} iters"), co.iters, ro.iters);
