[0m[49m[38;5;10m+    504[0m:[38;5;10m[49m                             1 => -1e9, // makes `metric < -1.0e8f` true
[0m[49m[38;5;10m+    505[0m:[38;5;10m[49m                             2 => f32::NAN,
[0m[49m[38;5;10m+    506[0m:[38;5;10m[49m                             3 => 1e9,
[0m[49m[38;5;10m+    507[0m:[38;5;10m[49m                             _ => g.coord(),
[0m[49m[38;5;10m+    508[0m:[38;5;10m[49m                         },
[0m[49m[38;5;10m+    509[0m:[38;5;10m[49m                         count,
[0m[49m[38;5;10m+    510[0m:[38;5;10m[49m                         // 0..8 keeps us inside c2Proxy.verts[8]
[0m[49m[38;5;10m+    511[0m:[38;5;10m[49m                         iA: [
[0m[49m[38;5;10m+    512[0m:[38;5;10m[49m                             g.below(8) as c_int,
[0m[49m[38;5;10m+    513[0m:[38;5;10m[49m                             g.below(8) as c_int,
[0m[49m[38;5;10m+    514[0m:[38;5;10m[49m                             g.below(8) as c_int,
[0m[49m[38;5;10m+    515[0m:[38;5;10m[49m                         ],
[0m[49m[38;5;10m+    516[0m:[38;5;10m[49m                         iB: [
[0m[49m[38;5;10m+    517[0m:[38;5;10m[49m                             g.below(8) as c_int,
[0m[49m[38;5;10m+    518[0m:[38;5;10m[49m                             g.below(8) as c_int,
[0m[49m[38;5;10m+    519[0m:[38;5;10m[49m                             g.below(8) as c_int,
[0m[49m[38;5;10m+    520[0m:[38;5;10m[49m                         ],
[0m[49m[38;5;10m+    521[0m:[38;5;10m[49m                         div: match g.below(4) {
[0m[49m[38;5;10m+    522[0m:[38;5;10m[49m                             0 => 0.0,
[0m[49m[38;5;10m+    523[0m:[38;5;10m[49m                             1 => 1.0,
[0m[49m[38;5;10m+    524[0m:[38;5;10m[49m                             _ => g.coord(),
[0m[49m[38;5;10m+    525[0m:[38;5;10m[49m                         },
[0m[49m[38;5;10m+    526[0m:[38;5;10m[49m                     };
[0m[49m[38;5;10m+    527[0m:[38;5;10m[49m                     let o = Opts {
[0m[49m[38;5;10m+    528[0m:[38;5;10m[49m                         use_radius: ur,
[0m[49m[38;5;10m+    529[0m:[38;5;10m[49m                         want_outA: true,
[0m[49m[38;5;10m+    530[0m:[38;5;10m[49m                         want_outB: true,
[0m[49m[38;5;10m+    531[0m:[38;5;10m[49m                         want_iters: true,
[0m[49m[38;5;10m+    532[0m:[38;5;10m[49m                         cache: Some(cache),
[0m[49m[38;5;10m+    533[0m:[38;5;10m[49m                     };
[0m[49m[38;5;10m+    534[0m:[38;5;10m[49m                     let a = rand_shape(&mut g, ta);
[0m[49m[38;5;10m+    535[0m:[38;5;10m[49m                     let b = rand_shape(&mut g, tb);
[0m[49m[38;5;10m+    536[0m:[38;5;10m[49m                     diff(&format!("row64 #{i} count={count}"), &a, ta, None, &b, tb, None, &o);
[0m[49m[38;5;10m+    537[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    538[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    539[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    540[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    541[0m:[38;5;10m[49m }
