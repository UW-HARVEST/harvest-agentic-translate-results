[0m[49m[38;5;10m+    660[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    661[0m:[38;5;10m[49m     pub fn as_ptr(&self) -> *const c_void {
[0m[49m[38;5;10m+    662[0m:[38;5;10m[49m         self.0.as_ptr() as *const c_void
[0m[49m[38;5;10m+    663[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    664[0m:[38;5;10m[49m }
