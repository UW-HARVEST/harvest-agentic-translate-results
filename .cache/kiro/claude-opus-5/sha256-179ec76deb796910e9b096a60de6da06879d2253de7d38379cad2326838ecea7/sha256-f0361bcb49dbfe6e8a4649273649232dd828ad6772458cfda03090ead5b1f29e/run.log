[0m[49m[38;5;10m+    543[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    544[0m:[38;5;10m[49m // Rows 65-70 — shape relations, constructed rather than random
[0m[49m[38;5;10m+    545[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    546[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    547[0m:[38;5;10m[49m /// Build a shape of type `t` centred at `c` with "radius" `s`.
[0m[49m[38;5;10m+    548[0m:[38;5;10m[49m fn shape_at(t: C2_TYPE, cx: f32, cy: f32, s: f32) -> ShapeBuf {
[0m[49m[38;5;10m+    549[0m:[38;5;10m[49m     match t {
[0m[49m[38;5;10m+    550[0m:[38;5;10m[49m         C2_TYPE_CIRCLE => ShapeBuf::from_circle(c2Circle {
[0m[49m[38;5;10m+    551[0m:[38;5;10m[49m             p: c2v { x: cx, y: cy },
[0m[49m[38;5;10m+    552[0m:[38;5;10m[49m             r: s,
[0m[49m[38;5;10m+    553[0m:[38;5;10m[49m         }),
[0m[49m[38;5;10m+    554[0m:[38;5;10m[49m         C2_TYPE_AABB => ShapeBuf::from_aabb(c2AABB {
[0m[49m[38;5;10m+    555[0m:[38;5;10m[49m             min: c2v { x: cx - s, y: cy - s },
[0m[49m[38;5;10m+    556[0m:[38;5;10m[49m             max: c2v { x: cx + s, y: cy + s },
[0m[49m[38;5;10m+    557[0m:[38;5;10m[49m         }),
[0m[49m[38;5;10m+    558[0m:[38;5;10m[49m         _ => ShapeBuf::from_capsule(c2Capsule {
[0m[49m[38;5;10m+    559[0m:[38;5;10m[49m             a: c2v { x: cx - s, y: cy },
[0m[49m[38;5;10m+    560[0m:[38;5;10m[49m             b: c2v { x: cx + s, y: cy },
[0m[49m[38;5;10m+    561[0m:[38;5;10m[49m             r: s * 0.5,
[0m[49m[38;5;10m+    562[0m:[38;5;10m[49m         }),
[0m[49m[38;5;10m+    563[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    564[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    565[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    566[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    567[0m:[38;5;10m[49m fn row65_70_shape_relations() {
[0m[49m[38;5;10m+    568[0m:[38;5;10m[49m     // Separations chosen to straddle every threshold: deep overlap, touching,
[0m[49m[38;5;10m+    569[0m:[38;5;10m[49m     // just apart (the radius-shrink branch), far apart, containment, coincident.
[0m[49m[38;5;10m+    570[0m:[38;5;10m[49m     let seps: [f32; 14] = [
[0m[49m[38;5;10m+    571[0m:[38;5;10m[49m         0.0, 1e-8, 1e-6, 0.001, 0.5, 1.0, 1.5, 1.9999, 2.0, 2.0001, 2.5, 5.0, 100.0, 1e6,
[0m[49m[38;5;10m+    572[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    573[0m:[38;5;10m[49m     for (ta, tb) in all_type_pairs() {
[0m[49m[38;5;10m+    574[0m:[38;5;10m[49m         for ur in [0, 1] {
[0m[49m[38;5;10m+    575[0m:[38;5;10m[49m             let o = Opts::plain(ur);
[0m[49m[38;5;10m+    576[0m:[38;5;10m[49m             for &sep in &seps {
[0m[49m[38;5;10m+    577[0m:[38;5;10m[49m                 // Row 65-68: separation sweep along x, and along the diagonal.
[0m[49m[38;5;10m+    578[0m:[38;5;10m[49m                 let a = shape_at(ta, 0.0, 0.0, 1.0);
[0m[49m[38;5;10m+    579[0m:[38;5;10m[49m                 let b = shape_at(tb, sep, 0.0, 1.0);
