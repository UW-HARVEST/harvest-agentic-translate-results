[0m[49m[38;5;10m+    179[0m:[38;5;10m[49m         assert_eq!(chk.count, 2, "row27 k={k}: expected the count=2 branch");
[0m[49m[38;5;10m+    180[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    181[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    182[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    183[0m:[38;5;10m[49m /// Rows 28-29 — randomized `c22` over every float class and every `count`
[0m[49m[38;5;10m+    184[0m:[38;5;10m[49m /// value (the C reads only `a.p`/`b.p` regardless of `count`).
[0m[49m[38;5;10m+    185[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    186[0m:[38;5;10m[49m fn row28_29_c22_randomized() {
[0m[49m[38;5;10m+    187[0m:[38;5;10m[49m     let (c, r) = apis();
[0m[49m[38;5;10m+    188[0m:[38;5;10m[49m     let mut g = Rng::new(SEED ^ 28);
[0m[49m[38;5;10m+    189[0m:[38;5;10m[49m     for i in 0..N {
[0m[49m[38;5;10m+    190[0m:[38;5;10m[49m         let s = forge(&mut g, *&COUNTS[(i % COUNTS.len()) as usize]);
[0m[49m[38;5;10m+    191[0m:[38;5;10m[49m         diff_c22(c, r, &format!("row28 random #{i}"), s);
[0m[49m[38;5;10m+    192[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    193[0m:[38;5;10m[49m     // Wild `p` values, incl. inf/NaN/subnormal.
[0m[49m[38;5;10m+    194[0m:[38;5;10m[49m     for i in 0..N {
[0m[49m[38;5;10m+    195[0m:[38;5;10m[49m         let mut s = forge(&mut g, 2);
[0m[49m[38;5;10m+    196[0m:[38;5;10m[49m         s.verts[0].p = g.wild_v();
[0m[49m[38;5;10m+    197[0m:[38;5;10m[49m         s.verts[1].p = g.wild_v();
[0m[49m[38;5;10m+    198[0m:[38;5;10m[49m         diff_c22(c, r, &format!("row28 wild #{i}"), s);
[0m[49m[38;5;10m+    199[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m     // Row 29: exactly-equal points, and points differing by one ULP.
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m     for i in 0..2000u32 {
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m         let mut g2 = Rng::new(SEED ^ 29 ^ i as u64);
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m         let p = g2.v();
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m         let q = c2v {
[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m             x: f32::from_bits(p.x.to_bits() ^ 1),
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m             y: p.y,
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m         diff_c22(c, r, &format!("row29 equal #{i}"), simplex_from_points(&[p, p], 1.0));
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m         diff_c22(c, r, &format!("row29 ulp #{i}"), simplex_from_points(&[p, q], 1.0));
[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m // Rows 30-37 — c23 (all seven branches)
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    216[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    217[0m:[38;5;10m[49m fn diff_c23(c: &Api, r: &Api, ctx: &str, s: c2Simplex) -> c2Simplex {
