[0m[49m[38;5;10m+    169[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    170[0m:[38;5;10m[49m fn row27_c22_branch_interior() {
[0m[49m[38;5;10m+    171[0m:[38;5;10m[49m     let (c, r) = apis();
[0m[49m[38;5;10m+    172[0m:[38;5;10m[49m     for k in 1..200i32 {
