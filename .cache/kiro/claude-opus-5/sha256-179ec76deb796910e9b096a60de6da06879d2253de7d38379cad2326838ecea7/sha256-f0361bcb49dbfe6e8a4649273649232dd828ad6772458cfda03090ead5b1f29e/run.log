[0m[49m[38;5;10m+    494[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    495[0m:[38;5;10m[49m fn row64_hand_forged_cache() {
[0m[49m[38;5;10m+    496[0m:[38;5;10m[49m     let mut g = Rng::new(SEED ^ 64);
[0m[49m[38;5;10m+    497[0m:[38;5;10m[49m     for (ta, tb) in all_type_pairs() {
[0m[49m[38;5;10m+    498[0m:[38;5;10m[49m         for count in 1..=3i32 {
[0m[49m[38;5;10m+    499[0m:[38;5;10m[49m             for ur in [0, 1] {
[0m[49m[38;5;10m+    500[0m:[38;5;10m[49m                 for i in 0..80 {
