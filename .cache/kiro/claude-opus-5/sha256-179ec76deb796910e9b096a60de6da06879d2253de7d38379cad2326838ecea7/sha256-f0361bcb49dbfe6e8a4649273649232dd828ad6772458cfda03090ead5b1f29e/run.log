[0m[49m[38;5;10m+    666[0m:[38;5;10m[49m /// The three valid `C2_TYPE` values, in declaration order.
[0m[49m[38;5;10m+    667[0m:[38;5;10m[49m pub const VALID_TYPES: [C2_TYPE; 3] = [C2_TYPE_CAPSULE, C2_TYPE_CIRCLE, C2_TYPE_AABB];
