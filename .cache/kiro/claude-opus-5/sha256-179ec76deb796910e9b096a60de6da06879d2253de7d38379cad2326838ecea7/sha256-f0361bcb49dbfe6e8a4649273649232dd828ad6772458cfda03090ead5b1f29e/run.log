[0m[49m[38;5;10m+     820[0m:[38;5;10m[49m             for &tb in &VALID_TYPES {
[0m[49m[38;5;10m+     821[0m:[38;5;10m[49m                 for _ in 0..64 {
[0m[49m[38;5;10m+     822[0m:[38;5;10m[49m                     // Keep every index that will be read at 0 so no
[0m[49m[38;5;10m+     823[0m:[38;5;10m[49m                     // out-of-vertex-count read happens.
[0m[49m[38;5;10m+     824[0m:[38;5;10m[49m                     let cache = c2GJKCache {
[0m[49m[38;5;10m+     825[0m:[38;5;10m[49m                         metric: 0.0,
[0m[49m[38;5;10m+     826[0m:[38;5;10m[49m                         count,
[0m[49m[38;5;10m+     827[0m:[38;5;10m[49m                         iA: [0, 0, 0],
[0m[49m[38;5;10m+     828[0m:[38;5;10m[49m                         iB: [0, 0, 0],
[0m[49m[38;5;10m+     829[0m:[38;5;10m[49m                         // `div` is read as an index when count == 7; +0.0 has
[0m[49m[38;5;10m+     830[0m:[38;5;10m[49m                         // all-zero bits, so the index is 0.
[0m[49m[38;5;10m+     831[0m:[38;5;10m[49m                         div: 0.0,
[0m[49m[38;5;10m+     832[0m:[38;5;10m[49m                     };
[0m[49m[38;5;10m+     833[0m:[38;5;10m[49m                     let args = GjkArgs {
[0m[49m[38;5;10m+     834[0m:[38;5;10m[49m                         ax: None,
[0m[49m[38;5;10m+     835[0m:[38;5;10m[49m                         bx: None,
[0m[49m[38;5;10m+     836[0m:[38;5;10m[49m                         outA: true,
[0m[49m[38;5;10m+     837[0m:[38;5;10m[49m                         outB: true,
