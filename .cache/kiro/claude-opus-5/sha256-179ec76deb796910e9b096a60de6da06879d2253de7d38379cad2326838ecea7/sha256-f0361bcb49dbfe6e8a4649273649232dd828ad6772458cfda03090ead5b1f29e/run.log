[0m[49m[38;5;10m+    444[0m:[38;5;10m[49m     for (ta, tb) in all_type_pairs() {
[0m[49m[38;5;10m+    445[0m:[38;5;10m[49m         for ur in [0, 1] {
[0m[49m[38;5;10m+    446[0m:[38;5;10m[49m             for trial in 0..40 {
[0m[49m[38;5;10m+    447[0m:[38;5;10m[49m                 let a = rand_shape(&mut g, ta);
[0m[49m[38;5;10m+    448[0m:[38;5;10m[49m                 let b = rand_shape(&mut g, tb);
[0m[49m[38;5;10m+    449[0m:[38;5;10m[49m                 let mut cc = c2GJKCache::default();
