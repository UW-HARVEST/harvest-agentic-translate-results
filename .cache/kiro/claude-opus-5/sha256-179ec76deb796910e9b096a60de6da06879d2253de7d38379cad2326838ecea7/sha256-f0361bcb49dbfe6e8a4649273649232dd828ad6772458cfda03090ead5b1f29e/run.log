[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m /// Row 91 (ERRORS.md rows 41-42) — `ptr_from_parts` with an out-of-range type.
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m ///
[0m[49m[38;5;10m+    259[0m:[38;5;10m[49m /// The C `switch` has no `default:` and the function **falls off the end of a
[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m /// non-`void` function**, which is undefined behaviour: the returned pointer is
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m /// whatever happens to be in the return register. The Rust returns `NULL`.
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m /// The pointer value therefore cannot be compared. What *is* well defined and
[0m[49m[38;5;10m+    263[0m:[38;5;10m[49m /// is asserted here:
[0m[49m[38;5;10m+    264[0m:[38;5;10m[49m ///   * neither build crashes;
[0m[49m[38;5;10m+    265[0m:[38;5;10m[49m ///   * the only consumer, `omni_collide`, discards the pointer via
[0m[49m[38;5;10m+    266[0m:[38;5;10m[49m ///     `c2Collided`'s `default:` arm, so the observable result agrees (row 94).
[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m fn row91_ptr_from_parts_invalid_type_is_ub() {
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m     let (c, r) = apis();
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m     let mut g = Rng::new(SEED ^ 91);
[0m[49m[38;5;10m+    271[0m:[38;5;10m[49m     let mut c_null = 0usize;
[0m[49m[38;5;10m+    272[0m:[38;5;10m[49m     let mut r_null = 0usize;
[0m[49m[38;5;10m+    273[0m:[38;5;10m[49m     for &bad in &BAD_TYPES {
[0m[49m[38;5;10m+    274[0m:[38;5;10m[49m         for _ in 0..64 {
[0m[49m[38;5;10m+    275[0m:[38;5;10m[49m             let p: [f32; 5] = [g.coord(), g.coord(), g.coord(), g.coord(), g.coord()];
[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m             // Must not crash. The returned pointer is deliberately NOT
[0m[49m[38;5;10m+    277[0m:[38;5;10m[49m             // dereferenced and NOT freed: in the C it is not a valid
[0m[49m[38;5;10m+    278[0m:[38;5;10m[49m             // allocation.
[0m[49m[38;5;10m+    279[0m:[38;5;10m[49m             let cp = unsafe { (c.ptr_from_parts)(bad, p[0], p[1], p[2], p[3], p[4]) };
[0m[49m[38;5;10m+    280[0m:[38;5;10m[49m             let rp = unsafe { (r.ptr_from_parts)(bad, p[0], p[1], p[2], p[3], p[4]) };
[0m[49m[38;5;10m+    281[0m:[38;5;10m[49m             if cp.is_null() {
[0m[49m[38;5;10m+    282[0m:[38;5;10m[49m                 c_null += 1;
[0m[49m[38;5;10m+    283[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    284[0m:[38;5;10m[49m             if rp.is_null() {
[0m[49m[38;5;10m+    285[0m:[38;5;10m[49m                 r_null += 1;
[0m[49m[38;5;10m+    286[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    287[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    288[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    289[0m:[38;5;10m[49m     println!(
[0m[49m[38;5;10m+    290[0m:[38;5;10m[49m         "row91 ptr_from_parts(invalid): C returned NULL {c_null} times, Rust {r_null} times \
[0m[49m[38;5;10m+    291[0m:[38;5;10m[49m          (C is UB — no return statement on that path)"
[0m[49m[38;5;10m+    292[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    293[0m:[38;5;10m[49m     // The Rust's choice is NULL on every invalid input, which is the safest
[0m[49m[38;5;10m+    294[0m:[38;5;10m[49m     // reading of the C's missing return.
