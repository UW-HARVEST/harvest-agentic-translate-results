[0m[49m[38;5;10m+    652[0m:[38;5;10m[49m         let mut b = ShapeBuf::zeroed();
[0m[49m[38;5;10m+    653[0m:[38;5;10m[49m         unsafe { std::ptr::write(b.0.as_mut_ptr() as *mut c2AABB, a) };
[0m[49m[38;5;10m+    654[0m:[38;5;10m[49m         b
[0m[49m[38;5;10m+    655[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    656[0m:[38;5;10m[49m     pub fn from_capsule(c: c2Capsule) -> ShapeBuf {
[0m[49m[38;5;10m+    657[0m:[38;5;10m[49m         let mut b = ShapeBuf::zeroed();
