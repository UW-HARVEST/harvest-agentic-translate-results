[0m[49m[38;5;10m+     763[0m:[38;5;10m[49m     let mut g = Rng::new(SEED ^ 124);
[0m[49m[38;5;10m+     764[0m:[38;5;10m[49m     for &t in &[C2_TYPE_CIRCLE, C2_TYPE_CAPSULE] {
[0m[49m[38;5;10m+     765[0m:[38;5;10m[49m         for _ in 0..2000 {
[0m[49m[38;5;10m+     766[0m:[38;5;10m[49m             let p1 = g.v();
[0m[49m[38;5;10m+     767[0m:[38;5;10m[49m             let p2 = g.v();
[0m[49m[38;5;10m+     768[0m:[38;5;10m[49m             let mk = |rad: f32| -> ShapeBuf {
