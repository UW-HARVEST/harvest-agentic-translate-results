[0m[49m[38;5;10m+    509[0m:[38;5;10m[49m             12 => -1e30,
[0m[49m[38;5;10m+    510[0m:[38;5;10m[49m             13 => f32::EPSILON,
[0m[49m[38;5;10m+    511[0m:[38;5;10m[49m             14 => -f32::EPSILON,
