[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m         // Row 90: CAPSULE -> { a = (a,b), b = (c,d), r = e }.
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m         unsafe {
