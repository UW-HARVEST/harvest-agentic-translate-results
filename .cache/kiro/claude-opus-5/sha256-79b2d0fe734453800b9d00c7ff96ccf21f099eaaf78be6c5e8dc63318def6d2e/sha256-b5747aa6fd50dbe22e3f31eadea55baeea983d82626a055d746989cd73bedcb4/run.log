typedef int (*f_ac)(AABB,Cap);
typedef int (*f_cc)(Cap,Cap);
typedef float (*f_gjk)(const void*,int,const void*,const void*,int,const void*,v*,v*,int,int*,Cache*);
int main(int argc,char**argv){
  void*h=dlopen(argv[1],RTLD_NOW); if(!h){printf("%s\n",dlerror());return 1;}
