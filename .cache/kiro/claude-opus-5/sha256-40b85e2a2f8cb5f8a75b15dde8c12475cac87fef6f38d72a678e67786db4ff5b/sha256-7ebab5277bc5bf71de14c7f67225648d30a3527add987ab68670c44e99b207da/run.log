/// How stable is the C across many repeats of one identical call?
#[test]
fn repeat_stability() {
    let l = Libs::load();
    let cf: OmniFn = *l.pair::<OmniFn>("omni_manifold").0;
    let rf: OmniFn = *l.pair::<OmniFn>("omni_manifold").1;
    let rust = call(rf);
    let mut distinct: Vec<(String, usize)> = Vec::new();
    for _ in 0..5000 {
        scrub_stack();
        let got = call(cf);
        let k = hex(bytes_of(&got));
        match distinct.iter_mut().find(|(s, _)| *s == k) {
            Some((_, n)) => *n += 1,
            None => distinct.push((k, 1)),
        }
    }
    println!("rust = {}", hex(bytes_of(&rust)));
    for (k, n) in &distinct {
        println!("{n:6} x {k}");
    }
}
