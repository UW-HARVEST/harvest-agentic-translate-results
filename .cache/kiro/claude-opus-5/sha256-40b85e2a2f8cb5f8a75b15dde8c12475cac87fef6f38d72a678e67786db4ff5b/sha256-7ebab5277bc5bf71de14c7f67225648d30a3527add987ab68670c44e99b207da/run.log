/// Replicates the level5 loop order to find what residual state breaks the
/// capsule/AABB case, then retries the same input in isolation.
#[test]
fn bisect_loop_context() {
    let l = Libs::load();
    let cf: OmniFn = *l.pair::<OmniFn>("omni_manifold").0;
    let rf: OmniFn = *l.pair::<OmniFn>("omni_manifold").1;
    let types = [C2_TYPE_CAPSULE, C2_TYPE_CIRCLE, C2_TYPE_AABB, C2_TYPE_POLY];
    let base: [f32; 10] = [-1.0, -0.5, 1.0, 0.5, 0.75, -0.25, 0.25, 1.25, 1.5, 0.5];
    let mut count = 0usize;
    'outer: for &ta in &types {
        for &tb in &types {
            for slot in 0..10 {
                for &val in NOTABLE {
                    let mut v = base;
                    v[slot] = val;
                    let m0 = c2Manifold {
                        count: 0x5555_5555,
                        depths: [-1.5, 2.5],
                        contact_points: [c2v { x: 3.0, y: 4.0 }, c2v { x: 5.0, y: 6.0 }],
                        n: c2v { x: 7.0, y: 8.0 },
                    };
                    let mut mc = m0;
                    let mut mr = m0;
                    scrub_stack();
                    unsafe { cf(&mut mc, ta, v[0], v[1], v[2], v[3], v[4], tb, v[5], v[6], v[7], v[8], v[9]) };
                    unsafe { rf(&mut mr, ta, v[0], v[1], v[2], v[3], v[4], tb, v[5], v[6], v[7], v[8], v[9]) };
                    count += 1;
                    if !same(&mc, &mr) {
                        println!("first mismatch after {count} calls: ta={ta} tb={tb} slot={slot} val={val:e}");
                        println!("  C    = {}", hex(bytes_of(&mc)));
                        println!("  Rust = {}", hex(bytes_of(&mr)));
                        // retry the identical input three more times
                        for k in 0..3 {
                            let mut m2 = m0;
                            scrub_stack();
                            unsafe { cf(&mut m2, ta, v[0], v[1], v[2], v[3], v[4], tb, v[5], v[6], v[7], v[8], v[9]) };
                            println!("  retry {k} C = {}", hex(bytes_of(&m2)));
                        }
                        break 'outer;
                    }
                }
            }
        }
    }
    println!("total calls: {count}");
}
