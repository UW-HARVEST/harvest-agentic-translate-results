import re, glob
# Convert `assert_same(&format!(A), &X, &Y)` -> `assert_same_lazy(&X, &Y, || format!(A))`
# and `assert_f32(&format!(A), X, Y)` -> `assert_f32_lazy(X, Y, || format!(A))`
pat_same = re.compile(
    r'assert_same\(\s*&format!\((?P<fmt>.*?)\),\s*(?P<a>&[A-Za-z0-9_\.\[\]]+),\s*(?P<b>&[A-Za-z0-9_\.\[\]]+),?\s*\)',
    re.S)
pat_f32 = re.compile(
    r'assert_f32\(\s*&format!\((?P<fmt>.*?)\),\s*(?P<a>[A-Za-z0-9_\.\[\]\(\)]+),\s*(?P<b>[A-Za-z0-9_\.\[\]\(\)]+),?\s*\)',
    re.S)
for f in sorted(glob.glob('tests/*.rs')):
    s0 = open(f).read()
    s = pat_same.sub(lambda m: f"assert_same_lazy({m.group('a')}, {m.group('b')}, || format!({m.group('fmt')}))", s0)
    s = pat_f32.sub(lambda m: f"assert_f32_lazy({m.group('a')}, {m.group('b')}, || format!({m.group('fmt')}))", s)
    if s != s0:
        open(f,'w').write(s)
        print(f, "converted")
PY
