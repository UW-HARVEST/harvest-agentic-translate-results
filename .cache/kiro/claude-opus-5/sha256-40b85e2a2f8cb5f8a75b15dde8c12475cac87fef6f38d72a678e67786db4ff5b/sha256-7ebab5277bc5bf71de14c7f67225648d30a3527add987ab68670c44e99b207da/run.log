        unsafe { rf(&mut mr, C2_TYPE_CAPSULE, v[0], v[1], v[2], v[3], v[4], C2_TYPE_AABB, v[5], v[6], v[7], v[8], v[9]) };
        total += 1;
        if !same(&mc, &mr) {
            bad += 1;
            if first.is_none() {
