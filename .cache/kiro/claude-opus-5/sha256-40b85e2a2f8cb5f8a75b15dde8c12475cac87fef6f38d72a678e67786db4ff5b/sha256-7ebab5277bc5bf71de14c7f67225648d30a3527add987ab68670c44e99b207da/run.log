/// Over a long run, `omni_manifold`'s leaked `malloc`s force glibc to extend the
/// heap periodically. `sysmalloc`/`brk` use far more stack than the fast path,
/// writing into the region `c2GJK` later reads its uninitialised `c2Proxy pB`
/// from. This measures how often that makes the C disagree, and whether the same
/// input reproduces.
#[test]
fn long_run_divergence() {
    let l = Libs::load();
    let cf: OmniFn = *l.pair::<OmniFn>("omni_manifold").0;
    let rf: OmniFn = *l.pair::<OmniFn>("omni_manifold").1;
    let types = [C2_TYPE_CAPSULE, C2_TYPE_CIRCLE, C2_TYPE_AABB, C2_TYPE_POLY];
    let mut rng = Rng::new(9001);
    let mut bad: Vec<(usize, C2_TYPE, C2_TYPE, [f32; 10])> = Vec::new();
    let n = 300_000;
    for i in 0..n {
        let ta = types[rng.below(4) as usize];
        let tb = types[rng.below(4) as usize];
        let mut v = [0f32; 10];
        for x in v.iter_mut() {
            *x = rng.tame();
        }
        let mut mc = c2Manifold::default();
        let mut mr = c2Manifold::default();
        scrub_stack();
        unsafe { cf(&mut mc, ta, v[0], v[1], v[2], v[3], v[4], tb, v[5], v[6], v[7], v[8], v[9]) };
        unsafe { rf(&mut mr, ta, v[0], v[1], v[2], v[3], v[4], tb, v[5], v[6], v[7], v[8], v[9]) };
        if !same(&mc, &mr) {
            bad.push((i, ta, tb, v));
        }
    }
    println!("{} divergences in {n} calls", bad.len());
    for (i, ta, tb, v) in bad.iter().take(10) {
        // replay the identical input now
        let mut agree = 0;
        for _ in 0..5 {
            let mut mc = c2Manifold::default();
            let mut mr = c2Manifold::default();
            scrub_stack();
            unsafe { cf(&mut mc, *ta, v[0], v[1], v[2], v[3], v[4], *tb, v[5], v[6], v[7], v[8], v[9]) };
            unsafe { rf(&mut mr, *ta, v[0], v[1], v[2], v[3], v[4], *tb, v[5], v[6], v[7], v[8], v[9]) };
            if same(&mc, &mr) {
                agree += 1;
            }
        }
        println!("  call {i}: ta={ta} tb={tb} -> replay agrees {agree}/5");
    }
}
EOF
