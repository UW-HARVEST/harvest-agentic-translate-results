    26	use std::ffi::{c_char, c_int};
    27	
    28	unsafe extern "C" {
    29	    /// The C source uses `printf` from <stdio.h>. Calling libc's `printf`
    30	    /// directly (rather than Rust's `println!`) keeps the write going through
    31	    /// the exact same `stdout` FILE stream and buffering discipline as the C
    32	    /// library, so byte-for-byte output and flush ordering are preserved.
    33	    fn printf(fmt: *const c_char, ...) -> c_int;
    34	}
    35	
    36	/// Rust equivalent of C's `div_t`.
    37	#[repr(C)]
    38	#[derive(Copy, Clone)]
    39	struct DivT {
    40	    quot: c_int,
    41	    rem: c_int,
    42	}
    43	
    44	/// Equivalent of C's `div()` from <stdlib.h>.
    45	///
    46	/// C's `div` performs plain `numer / denom` and `numer % denom` on `int`,
    47	/// which on x86-64 lowers to a single `idiv` instruction. That means the two
    48	/// non-representable cases -- division by zero, and `INT_MIN / -1` -- raise
    49	/// SIGFPE rather than returning a value. Rust's `/` operator would instead
    50	/// panic (printing a message to stderr and aborting), which is observably
    51	/// different. Emitting `idiv` directly reproduces the original C behavior
    52	/// exactly, including the fatal signal.
    53	#[cfg(target_arch = "x86_64")]
    54	#[inline]
    55	fn c_div(numer: c_int, denom: c_int) -> DivT {
    56	    let quot: c_int;
    57	    let rem: c_int;
    58	    unsafe {
    59	        std::arch::asm!(
    60	            "cdq",
    61	            "idiv {denom:e}",
    62	            denom = in(reg) denom,
    63	            inout("eax") numer => quot,
    64	            out("edx") rem,
    65	            options(pure, nomem, nostack),
    66	        );
    67	    }
    68	    DivT { quot, rem }
    69	}
    70	
    71	/// Portable fallback for non-x86-64 targets. `wrapping_div`/`wrapping_rem`
    72	/// avoid Rust's overflow panic for `INT_MIN / -1` (yielding `INT_MIN`, the
    73	/// value the truncated hardware result also produces); division by zero still
    74	/// aborts, matching the C program's fatal termination.
    75	#[cfg(not(target_arch = "x86_64"))]
    76	#[inline]
    77	fn c_div(numer: c_int, denom: c_int) -> DivT {
    78	    DivT {
    79	        quot: numer.wrapping_div(denom),
    80	        rem: numer.wrapping_rem(denom),
    81	    }
    82	}
    83	
    84	/// void driver(int x, int y);
    85	///
    86	/// Translation of:
    87	/// ```c
    88	/// void driver(int x, int y) {
    89	///     div_t result = div(x, y);
    90	///     printf("quotient: %d, remainder: %d\n", result.quot, result.rem);
    91	/// }
    92	/// ```
    93	#[unsafe(no_mangle)]
    94	pub extern "C" fn driver(x: c_int, y: c_int) {
    95	    let result = c_div(x, y);
    96	    unsafe {
    97	        printf(
    98	            c"quotient: %d, remainder: %d\n".as_ptr(),
    99	            result.quot,
   100	            result.rem,
   101	        );
   102	    }
   103	}
