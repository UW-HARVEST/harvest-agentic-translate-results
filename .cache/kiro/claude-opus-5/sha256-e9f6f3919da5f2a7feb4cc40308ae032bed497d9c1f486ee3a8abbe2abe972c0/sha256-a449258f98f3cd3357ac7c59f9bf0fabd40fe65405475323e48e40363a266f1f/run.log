mod cfmt { include!("/tmp/cfmt_copy.rs"); }
mod cscan { include!("/tmp/cscan_copy.rs"); }
use cfmt::format_g;
use cscan::Scanner;
use std::io::Write;

fn emulate(input: &[u8]) -> String {
    let mut which = 0i32;
    let (mut x, mut y, mut z) = (0f32, 0f32, 0f32);
    let (mut xw, mut yw, mut zw, mut seed) = (0i32, 0i32, 0i32, 0i32);
    let (mut lac, mut gain, mut off) = (0f32, 0f32, 0f32);
    let mut oct = 0i32;
    let mut sc = Scanner::new(input);
    let mut n = 0i32;
    'scan: {
        match sc.scan_i32() { Some(v) => { which = v; n += 1 } None => break 'scan }
        match sc.scan_f32() { Some(v) => { x = v; n += 1 } None => break 'scan }
        match sc.scan_f32() { Some(v) => { y = v; n += 1 } None => break 'scan }
        match sc.scan_f32() { Some(v) => { z = v; n += 1 } None => break 'scan }
        match sc.scan_i32() { Some(v) => { xw = v; n += 1 } None => break 'scan }
        match sc.scan_i32() { Some(v) => { yw = v; n += 1 } None => break 'scan }
        match sc.scan_i32() { Some(v) => { zw = v; n += 1 } None => break 'scan }
        match sc.scan_i32() { Some(v) => { seed = v; n += 1 } None => break 'scan }
        match sc.scan_f32() { Some(v) => { lac = v; n += 1 } None => break 'scan }
        match sc.scan_f32() { Some(v) => { gain = v; n += 1 } None => break 'scan }
        match sc.scan_f32() { Some(v) => { off = v; n += 1 } None => break 'scan }
        match sc.scan_i32() { Some(v) => { oct = v; n += 1 } None => break 'scan }
    }
    let g = |v: f32| format_g(v as f64, 9);
    format!("{}|{}|{}|{}|{}|{}|{}|{}|{}|{}|{}|{}|{}", if n == 0 { -1 } else { n }, which,
        g(x), g(y), g(z), xw, yw, zw, seed, g(lac), g(gain), g(off), oct)
}

#[test]
fn bulk() {
    let dir = std::env::var("SCAN_DIR").unwrap();
    let raw = std::fs::read(format!("{dir}/scan_in.txt")).unwrap();
    let exp = std::fs::read_to_string(format!("{dir}/scan.c.out")).unwrap();
    // records separated by a 0x00 byte
    let inputs: Vec<&[u8]> = raw.split(|b| *b == 0).collect();
    let expected: Vec<&str> = exp.lines().collect();
    assert_eq!(inputs.len(), expected.len(), "record count");
    let mut bad = 0;
    let mut out = std::io::stdout();
    for (i, (inp, e)) in inputs.iter().zip(expected.iter()).enumerate() {
        let got = emulate(inp);
        if got != *e {
            bad += 1;
            if bad < 40 {
                writeln!(out, "[{i}] input={:?}\n   exp={e}\n   got={got}", String::from_utf8_lossy(inp)).unwrap();
            }
        }
    }
    writeln!(out, "bad={bad}").unwrap();
    assert_eq!(bad, 0);
}
