import random, subprocess, os, sys, struct
C=os.environ['REF']+"/cdriver"; R="./translation/target/release/driver"
random.seed(99)
def cases():
    # raw random bytes incl. non-UTF8
    for _ in range(4000):
        yield bytes(random.randrange(256) for _ in range(random.randrange(0,12)))
    # random bytes drawn from a float-ish alphabet
    alpha=b'0123456789abcdefxXpPeE+-. \t\n\r\0iInNfFyYaA()_'
    for _ in range(8000):
        yield bytes(random.choice(alpha) for _ in range(random.randrange(0,20)))
    # rounding ties near subnormal / normal boundaries
    for _ in range(4000):
        m=random.randrange(1,1<<25); e=random.randrange(-60,45)
        yield ("%de%d"%(m,e)).encode()
    # exact-tie decimal expansions of f32 midpoints
    for _ in range(3000):
        bits=random.randrange(0,0xff000000)
        f=struct.unpack('f',struct.pack('I',bits))[0]
        yield repr(f).encode()
        yield ("%.60g"%f).encode()
    # hex rounding boundaries
    for _ in range(4000):
        digs=''.join(random.choice('0123456789abcdef') for _ in range(random.randrange(1,30)))
        pt=random.randrange(0,len(digs)+1)
        s='0x'+digs[:pt]+'.'+digs[pt:]+'p'+str(random.randrange(-190,150))
        yield (random.choice(['','-','+'])+s).encode()
    # long digit strings
    for _ in range(2000):
        yield (''.join(random.choice('0123456789') for _ in range(random.randrange(1,120)))+'e'+str(random.randrange(-120,60))).encode()
    # leading whitespace / multiline
    for _ in range(2000):
        ws=''.join(random.choice(' \t\n\r\v\f') for _ in range(random.randrange(0,8)))
        yield (ws+random.choice(['1','-2.5','0x1.8p-3','inf','nan','','.','e'])+'\nrest').encode()
bad=0; n=0
for b in cases():
    n+=1
    a=subprocess.run([C],input=b,capture_output=True).stdout
    c=subprocess.run([R],input=b,capture_output=True).stdout
    if a!=c:
        bad+=1; print("DIFF",b,a,c)
        if bad>15: break
print("fuzz2 cases=%d diffs=%d"%(n,bad))
