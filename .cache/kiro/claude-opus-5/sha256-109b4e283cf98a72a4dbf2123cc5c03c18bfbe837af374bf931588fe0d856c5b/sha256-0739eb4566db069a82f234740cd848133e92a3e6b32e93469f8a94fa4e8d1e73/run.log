import random, subprocess, os
C=os.environ['REF']+"/cdriver"; R="./translation/target/release/driver"
random.seed(7)
def cases():
    # long significands with extreme exponents (both directions)
    for _ in range(1200):
        nd=random.choice([1,2,5,19,20,25,40,100,400,799,800,801,900,2000,5000])
        d=''.join(random.choice('0123456789') for _ in range(nd))
        e=random.choice([0,1,-1,38,39,-38,-45,-46,-50,300,-300,999,-999,
                         nd, -nd, nd+38, -(nd+45), 999999, -999999, 10**9, -10**9,
                         10**12, -10**12])
        yield (random.choice(['','-','+'])+d+random.choice(['','.','.0','.5'])+'e'+str(e)).encode()
    # fraction-heavy forms
    for _ in range(800):
        nz=random.randrange(0,300)
        d=''.join(random.choice('0123456789') for _ in range(random.randrange(1,60)))
        yield (random.choice(['','-'])+'0.'+'0'*nz+d+random.choice(['','e%d'%random.randrange(-400,400)])).encode()
    # exact halfway cases: (2k+1)*2^-149 / 2 and normal midpoints via fractions
    from fractions import Fraction
    for _ in range(1200):
        k=random.randrange(0,1<<24); e=random.randrange(-149,80)
        # midpoint between k*2^e and (k+1)*2^e
        f=Fraction(2*k+1,2)*Fraction(2)**e
        s=str(f.numerator)+'e0' if f.denominator==1 else None
        if s is None:
            # exact decimal expansion (denominator is a power of 2 -> terminates)
            num, den = f.numerator, f.denominator
            import math
            p=den.bit_length()-1
            s=str(num*(5**p))+'e-'+str(p)
        yield s.encode()
        yield (s+'1').encode()
    # trailing/leading zero heavy
    for _ in range(500):
        yield ('0'*random.randrange(0,200)+str(random.randrange(1,10**6))+'0'*random.randrange(0,200)+'e'+str(random.randrange(-100,50))).encode()
bad=0;n=0
for b in cases():
    n+=1
    a=subprocess.run([C],input=b,capture_output=True).stdout
    c=subprocess.run([R],input=b,capture_output=True).stdout
    if a!=c:
        bad+=1; print("DIFF",b[:80],a,c)
        if bad>10: break
print("fuzz3 cases=%d diffs=%d"%(n,bad))
