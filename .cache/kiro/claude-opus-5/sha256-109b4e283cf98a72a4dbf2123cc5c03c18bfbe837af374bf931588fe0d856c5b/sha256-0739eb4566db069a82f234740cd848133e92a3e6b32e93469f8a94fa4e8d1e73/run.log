import random, subprocess, struct, os
random.seed(1234)
C="/tmp/cref/driver"; R="./translation/target/release/driver"
def gen():
    k=random.randrange(9)
    if k==0:
        return repr(struct.unpack('f',os.urandom(4))[0])
    if k==1:
        s=random.choice(['','-','+'])
        return s+str(random.randrange(0,10**random.randrange(1,25)))+random.choice(['','.','.0',''+'.'+str(random.randrange(10**8))])+random.choice(['','e%d'%random.randrange(-60,60),'E%+d'%random.randrange(-400,400)])
    if k==2:
        return random.choice(['','-','+'])+'0'+random.choice('xX')+''.join(random.choice('0123456789abcdefABCDEF') for _ in range(random.randrange(0,12)))+random.choice(['','.'+''.join(random.choice('0123456789abcdef') for _ in range(random.randrange(0,10)))])+random.choice(['','p%d'%random.randrange(-200,200),'P%+d'%random.randrange(-40,40),'p','p+'])
    if k==3:
        return random.choice(['inf','INF','Inf','infinity','INFINITY','infinit','nan','NaN','NAN','nan(','nan()','nan(123)','nan(0x1)','-nan(_a1)','-inf','+infinity'])
    if k==4:
        return ''.join(random.choice(' \t\n\r\v\f') for _ in range(random.randrange(0,6)))+random.choice(['1','-2.5','','x','.','e','0x1p3'])
    if k==5:
        return ''.join(random.choice('0123456789.eExXpP+-abcdinf \t\n') for _ in range(random.randrange(0,14)))
    if k==6:
        return '0.'+'0'*random.randrange(0,50)+str(random.randrange(1,10**6))
    if k==7:
        return str(random.randrange(1,10**9))+'e'+str(random.randrange(-50,-30))
    return random.choice(['1e-45','7e-46','1.4e-45','2.8e-45','1e-44','0x1p-149','0x1.8p-149','0x1p-150','0x1.000002p0','16777215.5','16777217.0'])
bad=0
for i in range(30000):
    s=gen(); b=s.encode()
    a=subprocess.run([C],input=b,capture_output=True).stdout
    c=subprocess.run([R],input=b,capture_output=True).stdout
    if a!=c:
        bad+=1
        print("DIFF",repr(s),a,c)
        if bad>15: break
print("fuzz done, diffs=",bad)
