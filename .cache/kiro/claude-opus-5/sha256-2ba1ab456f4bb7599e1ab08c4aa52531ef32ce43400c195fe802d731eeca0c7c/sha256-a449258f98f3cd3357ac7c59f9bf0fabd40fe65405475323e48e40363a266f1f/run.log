[0m[49m[38;5;10m+    670[0m:[38;5;10m[49m     // 0x50505050, and the next line assigns users[0x50505050].permission_level.
[0m[49m[38;5;10m+    671[0m:[38;5;10m[49m     let mut users_case = String::new();
[0m[49m[38;5;10m+    672[0m:[38;5;10m[49m     for i in 1..=9 {
[0m[49m[38;5;10m+    673[0m:[38;5;10m[49m         users_case += &format!("adduser u{i} p{i} {i}\n");
[0m[49m[38;5;10m+    674[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    675[0m:[38;5;10m[49m     users_case += &format!("adduser last {} 5\n", rep("P", 63));
