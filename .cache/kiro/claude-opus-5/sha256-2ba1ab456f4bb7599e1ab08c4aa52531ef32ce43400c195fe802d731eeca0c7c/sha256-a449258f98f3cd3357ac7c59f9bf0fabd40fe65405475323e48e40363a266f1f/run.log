[0m[49m[38;5;10m+    679[0m:[38;5;10m[49m     // files[] into file_count, and the next line assigns
[0m[49m[38;5;10m+    680[0m:[38;5;10m[49m     // files[<clobbered>].permissions.
[0m[49m[38;5;10m+    681[0m:[38;5;10m[49m     let mangled = format!("{}secret", rep("A", 32));
[0m[49m[38;5;10m+    682[0m:[38;5;10m[49m     let mut files_case = format!(
[0m[49m[38;5;10m+    683[0m:[38;5;10m[49m         "adduser {} secret 9\nlogin {} secret\n",
[0m[49m[38;5;10m+    684[0m:[38;5;10m[49m         rep("A", 40),
[0m[49m[38;5;10m+    685[0m:[38;5;10m[49m         mangled
[0m[49m[38;5;10m+    686[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    687[0m:[38;5;10m[49m     for i in 1..=20 {
[0m[49m[38;5;10m+    688[0m:[38;5;10m[49m         files_case += &format!("createfile f{i} c{i}\n");
[0m[49m[38;5;10m+    689[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    690[0m:[38;5;10m[49m     files_case += "listfiles\nstatus\n";
[0m[49m[38;5;10m+    691[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    692[0m:[38;5;10m[49m     // Case 3: the same crash, but with enough output beforehand that glibc has
