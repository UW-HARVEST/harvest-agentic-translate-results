[0m[49m[38;5;10m+    725[0m:[38;5;10m[49m         mangled
[0m[49m[38;5;10m+    726[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    727[0m:[38;5;10m[49m     for i in 1..=20 {
[0m[49m[38;5;10m+    728[0m:[38;5;10m[49m         input += &format!("createfile f{i} c{i}\n");
[0m[49m[38;5;10m+    729[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    730[0m:[38;5;10m[49m     input += "listfiles\nstatus\n";
[0m[49m[38;5;10m+    731[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    732[0m:[38;5;10m[49m     let c = run(&c_binary(), input.as_bytes());
[0m[49m[38;5;10m+    733[0m:[38;5;10m[49m     let r = run(&rust_binary(), input.as_bytes());
[0m[49m[38;5;10m+    734[0m:[38;5;10m[49m     assert_eq!(
