[0m[49m[38;5;10m+    576[0m:[38;5;10m[49m /// Rows 3 and 4: the two allocation-failure branches. These cannot be induced
[0m[49m[38;5;10m+    577[0m:[38;5;10m[49m /// through the public ABI without process-wide allocator interposition, so they
[0m[49m[38;5;10m+    578[0m:[38;5;10m[49m /// are pinned structurally: both implementations must use the *libc* allocator
[0m[49m[38;5;10m+    579[0m:[38;5;10m[49m /// (not Rust's global allocator) and the `malloc` failure path must `free(dest)`
[0m[49m[38;5;10m+    580[0m:[38;5;10m[49m /// before returning NULL. See ERRORS.md for the rationale.
[0m[49m[38;5;10m+    581[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    582[0m:[38;5;10m[49m fn err_03_04_allocation_failure_structure() {
[0m[49m[38;5;10m+    583[0m:[38;5;10m[49m     let root = crate_root();
[0m[49m[38;5;10m+    584[0m:[38;5;10m[49m     let rs = std::fs::read_to_string(root.join("src/lib.rs")).expect("read src/lib.rs");
[0m[49m[38;5;10m+    585[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    586[0m:[38;5;10m[49m     // The Rust translation must import the same libc allocator the C uses, so
[0m[49m[38;5;10m+    587[0m:[38;5;10m[49m     // that its allocation-failure thresholds are identical by construction.
[0m[49m[38;5;10m+    588[0m:[38;5;10m[49m     for needed in ["fn calloc(", "fn malloc(", "fn free("] {
[0m[49m[38;5;10m+    589[0m:[38;5;10m[49m         assert!(
[0m[49m[38;5;10m+    590[0m:[38;5;10m[49m             rs.contains(needed),
[0m[49m[38;5;10m+    591[0m:[38;5;10m[49m             "Rust must declare libc `{needed}` so allocation behaviour matches C"
[0m[49m[38;5;10m+    592[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    593[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    594[0m:[38;5;10m[49m     assert!(
[0m[49m[38;5;10m+    595[0m:[38;5;10m[49m         !rs.contains("Vec::") && !rs.contains("Box::") && !rs.contains("String::"),
[0m[49m[38;5;10m+    596[0m:[38;5;10m[49m         "Rust must not allocate the result with Rust's global allocator — the \
[0m[49m[38;5;10m+    597[0m:[38;5;10m[49m          caller frees it with libc free()"
[0m[49m[38;5;10m+    598[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    599[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    600[0m:[38;5;10m[49m     // calloc-failure branch: return NULL, allocate nothing else first.
[0m[49m[38;5;10m+    601[0m:[38;5;10m[49m     assert!(
[0m[49m[38;5;10m+    602[0m:[38;5;10m[49m         rs.contains("if dest.is_null()"),
[0m[49m[38;5;10m+    603[0m:[38;5;10m[49m         "missing the calloc-failure branch (ERRORS.md row 3)"
[0m[49m[38;5;10m+    604[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    605[0m:[38;5;10m[49m     // malloc-failure branch: free(dest) THEN return NULL.
[0m[49m[38;5;10m+    606[0m:[38;5;10m[49m     let buf_null = rs
[0m[49m[38;5;10m+    607[0m:[38;5;10m[49m         .find("if buf.is_null()")
[0m[49m[38;5;10m+    608[0m:[38;5;10m[49m         .expect("missing the malloc-failure branch (ERRORS.md row 4)");
[0m[49m[38;5;10m+    609[0m:[38;5;10m[49m     let tail = &rs[buf_null..];
[0m[49m[38;5;10m+    610[0m:[38;5;10m[49m     let brace_end = tail.find('}').expect("malloc-failure block is unterminated");
[0m[49m[38;5;10m+    611[0m:[38;5;10m[49m     let block = &tail[..brace_end];
[0m[49m[38;5;10m+    612[0m:[38;5;10m[49m     assert!(
[0m[49m[38;5;10m+    613[0m:[38;5;10m[49m         block.contains("free(dest"),
[0m[49m[38;5;10m+    614[0m:[38;5;10m[49m         "ERRORS.md row 4: the malloc-failure path must free(dest) before \
[0m[49m[38;5;10m+    615[0m:[38;5;10m[49m          returning NULL; block was:\n{block}"
[0m[49m[38;5;10m+    616[0m:[38;5;10m[49m     );
