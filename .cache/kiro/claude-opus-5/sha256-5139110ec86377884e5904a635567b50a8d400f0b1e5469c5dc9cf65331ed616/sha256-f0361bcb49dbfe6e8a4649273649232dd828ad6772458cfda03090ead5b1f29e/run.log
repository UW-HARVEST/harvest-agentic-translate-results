[0m[49m[38;5;10m+    567[0m:[38;5;10m[49m                 cf(buf.as_ptr() as *const c_char),
[0m[49m[38;5;10m+    568[0m:[38;5;10m[49m                 rf(buf.as_ptr() as *const c_char),
[0m[49m[38;5;10m+    569[0m:[38;5;10m[49m             )
