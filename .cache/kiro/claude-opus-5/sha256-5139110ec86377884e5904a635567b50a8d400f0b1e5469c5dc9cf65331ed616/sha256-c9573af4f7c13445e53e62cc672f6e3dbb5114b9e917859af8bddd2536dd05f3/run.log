/// after a large block is freed), so `malloc_usable_size` stops being a
/// faithful proxy for the requested size. Below it, the value was empirically
/// deterministic and is compared for equality.
const MMAP_THRESHOLD: usize = 128 * 1024;

#[track_caller]
fn compare(c_out: &Outcome, rust_out: &Outcome, requested: usize, ctx: impl Fn() -> String) {
    match (c_out, rust_out) {
        (Outcome::Null, Outcome::Null) => {}
        (
            Outcome::Buffer { full: cf, c_strlen: cs, usable: cu },
            Outcome::Buffer { full: rf, c_strlen: rs, usable: ru },
        ) => {
            assert_eq!(cs, rs, "strlen differs for {}", ctx());
            if cf != rf {
                panic!(
