                    ctx(),
                    hex(cf),
                    hex(rf)
                );
            }
            // Under-allocation in either implementation would be UB.
            assert!(*cu >= requested, "C under-allocated: {cu} < {requested}");
            assert!(*ru >= requested, "Rust under-allocated: {ru} < {requested}");
            if requested < MMAP_THRESHOLD {
                assert_eq!(
                    cu, ru,
                    "allocation size differs for {} (requested {requested}) — the Rust \\
                     calloc/malloc arguments must match the C exactly",
                    ctx()
                );
            }
        }
        _ => panic!(
            "DIVERGENCE (NULL-ness) for {}\\n  C   : {}\\n  Rust: {}",
            ctx(),
            render(c_out),
            render(rust_out)
        ),
    }
}""")

