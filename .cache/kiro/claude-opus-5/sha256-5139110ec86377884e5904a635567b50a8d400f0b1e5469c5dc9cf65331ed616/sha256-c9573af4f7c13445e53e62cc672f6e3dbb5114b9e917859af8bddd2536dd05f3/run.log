/// block is freed, so the first and second caller of the same size get different
/// chunks. Setting the threshold explicitly ALSO disables the auto-tuning, and
/// with everything mmap'd the usable size becomes a pure function of the request
/// (page rounding), making the C's `calloc(1, strlen+1+13)` / `malloc(strlen+1)`
/// sizing contract exactly and deterministically comparable.
fn force_deterministic_allocator() {
    unsafe {
        assert_eq!(mallopt(M_MMAP_THRESHOLD, 1), 1, "mallopt(M_MMAP_THRESHOLD) failed");
    }
}""",
