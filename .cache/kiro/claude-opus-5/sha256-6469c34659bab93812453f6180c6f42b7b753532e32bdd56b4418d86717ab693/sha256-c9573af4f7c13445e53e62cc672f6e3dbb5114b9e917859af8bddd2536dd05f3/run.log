    80	    // `i < length`, so a non-positive `bins` behaves as an empty buffer.
    81	    let n = if bins > 0 { bins as usize } else { 0 };
    82	
    83	    let test_in: &[f64] = if n == 0 {
    84	        &[]
    85	    } else {
    86	        unsafe { slice::from_raw_parts(test, n) }
    87	    };
