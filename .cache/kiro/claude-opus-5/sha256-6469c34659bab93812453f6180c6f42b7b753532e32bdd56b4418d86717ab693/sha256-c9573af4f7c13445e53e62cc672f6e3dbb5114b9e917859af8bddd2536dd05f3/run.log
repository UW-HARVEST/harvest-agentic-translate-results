=== spectral_contrast.c ===
     1	#include <math.h> /* sqrt */
     2	
     3	static double dot_product(float_t *a, float_t *b, int length) {
     4	    double sum = 0;
     5	    int i;
     6	    for(i = 0; i < length; i++) sum += a[i] * b[i];
     7	    return sum;
     8	}
     9	
    10	static void normalize(float_t *v, int length) {
    11	    double magnitude = sqrt(dot_product(v, v, length));
    12	    int i;
    13	    for(i = 0; i < length; i++) v[i] /= magnitude;
    14	}
    15	
    16	double spectral_contrast(float_t *a, float_t *b, int length) {
    17	    normalize(a, length);
    18	    normalize(b, length);
    19	    return dot_product(a, b, length);
    20	}
