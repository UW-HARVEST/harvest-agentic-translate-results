     1	//! Translation of `c_src/src/match.c`.
     2	//!
     3	//! This translation unit includes `match.h`, so `float_t` here is `double`.
     4	
     5	use core::ffi::{c_double, c_int};
     6	
     7	use crate::spectral_contrast::spectral_contrast;
     8	use crate::{clamp_len, slice_from_raw};
     9	
    10	/// `#define N_SMOOTH 16` -- size of the smoothing kernel.
    11	const N_SMOOTH: usize = 16;
    12	
    13	/// Scratch buffers here carry one extra leading element ahead of the logical
    14	/// vector `v`, so the index this offset applies is spelled out once.
    15	const PAD: usize = 1;
    16	
    17	/// ```c
    18	/// static double total(float_t *v, int length) {
    19	///     double sum = 0;
    20	///     int i;
    21	///     for(i = 0; i < length; i++) sum += v[i];
    22	///     return sum;
    23	/// }
    24	/// ```
    25	fn total(v: &[f64]) -> f64 {
    26	    let mut sum: f64 = 0.0;
    27	    for &element in v {
    28	        sum += element;
    29	    }
    30	    sum
    31	}
    32	
    33	/// ```c
    34	/// static void smoothen(float_t *v, int length) {
    35	///     double sum;
    36	///     int i, j;
    37	///     for(i = 0; i < length; i++) {
    38	///         sum = 0;
    39	///         for(j = 0; j < N_SMOOTH && i + j < length; j++)
    40	///             sum += v[i + j];
    41	///         v[i] = sum / N_SMOOTH;
    42	///     }
    43	/// }
    44	/// ```
    45	///
    46	/// The tail elements (`i > length - N_SMOOTH`) still divide by the full
    47	/// `N_SMOOTH` even though fewer terms were summed, which damps the tail towards
    48	/// zero. That is the C's behaviour and is kept.
    49	fn smoothen(v: &mut [f64]) {
    50	    let length = v.len();
    51	    for i in 0..length {
    52	        let mut sum: f64 = 0.0;
    53	        let mut j = 0usize;
    54	        while j < N_SMOOTH && i + j < length {
    55	            sum += v[i + j];
    56	            j += 1;
    57	        }
    58	        v[i] = sum / N_SMOOTH as f64;
    59	    }
    60	}
    61	
    62	/// ```c
    63	/// static void differentiate(float_t *v, int length) {
    64	///     int i;
    65	///     for(i = 0; i < length - 1; i++) v[i] = v[i + 1] - v[i];
    66	///     v[length - 1] = 0;
    67	/// }
    68	/// ```
    69	///
    70	/// `buf` is a padded buffer: `buf[0]` is scratch and `buf[PAD..]` is the
    71	/// logical vector `v` of length `buf.len() - PAD`. The padding exists so that
    72	/// the C's `v[length - 1] = 0` store still has somewhere to land when
    73	/// `length == 0`, where C writes one element *before* the array. Reproducing
    74	/// that store harmlessly keeps the memory-safety of this translation without
    75	/// changing any observable result.
    76	fn differentiate(buf: &mut [f64]) {
    77	    let length = buf.len() - PAD;
    78	    for i in 0..length.saturating_sub(1) {
    79	        buf[PAD + i] = buf[PAD + i + 1] - buf[PAD + i];
    80	    }
    81	    // `PAD + length - 1` for the in-bounds case, `buf[0]` (the pad) for
    82	    // `length == 0`.
    83	    buf[length] = 0.0;
    84	}
    85	
    86	/// ```c
    87	/// static void preprocess(float_t *v, float_t *source, int length) {
    88	///     memcpy(v, source, length * sizeof(*v));
    89	///     smoothen(v, length);
    90	///     differentiate(v, length);
    91	///     smoothen(v, length);
    92	/// }
    93	/// ```
    94	fn preprocess(buf: &mut [f64], source: &[f64]) {
    95	    buf[PAD..].copy_from_slice(source);
    96	    smoothen(&mut buf[PAD..]);
    97	    differentiate(buf);
    98	    smoothen(&mut buf[PAD..]);
    99	}
   100	
   101	/// ```c
   102	/// int match(float_t *test, float_t *reference, int bins, double threshold) {
   103	///     float_t t[bins], r[bins];
   104	///     if(total(test, bins) < threshold * total(reference, bins)) return 0;
   105	///     preprocess(t, test, bins);
   106	///     preprocess(r, reference, bins);
   107	///     return spectral_contrast(t, r, bins) >= threshold;
   108	/// }
   109	/// ```
   110	///
   111	/// `t` and `r` are `double` arrays, but `spectral_contrast` -- compiled with
   112	/// `float_t == float` -- reinterprets them as `float` arrays. The cast below
   113	/// preserves that. See the crate docs.
   114	///
   115	/// # Safety
   116	/// `test` and `reference` must each be valid for reads of `bins` `double`s.
   117	#[unsafe(no_mangle)]
   118	pub unsafe extern "C" fn r#match(
   119	    test: *mut c_double,
   120	    reference: *mut c_double,
   121	    bins: c_int,
   122	    threshold: c_double,
   123	) -> c_int {
   124	    let len = clamp_len(bins);
   125	    let test = unsafe { slice_from_raw(test, len) };
   126	    let reference = unsafe { slice_from_raw(reference, len) };
   127	
   128	    if total(test) < threshold * total(reference) {
   129	        return 0;
   130	    }
   131	
   132	    let mut t = vec![0.0f64; len + PAD];
   133	    let mut r = vec![0.0f64; len + PAD];
   134	    preprocess(&mut t, test);
   135	    preprocess(&mut r, reference);
   136	
   137	    let contrast = unsafe {
   138	        spectral_contrast(
   139	            t[PAD..].as_mut_ptr().cast(),
   140	            r[PAD..].as_mut_ptr().cast(),
   141	            bins,
   142	        )
   143	    };
   144	    (contrast >= threshold) as c_int
   145	}
=== src/spectral_contrast.rs ===
     1	//! Rust translation of `c_src/src/spectral_contrast.c`.
     2	//!
     3	//! ## The `float_t` trap (reproduced, not fixed)
     4	//!
     5	//! `c_src/src/spectral_contrast.c` includes **only** `<math.h>` -- it never
     6	//! includes `match.h`. Therefore the `float_t` it uses is *not* the
     7	//! `typedef double float_t;` from `match.h`, but the C99 `float_t` from
     8	//! `<math.h>`. On x86-64 glibc `__FLT_EVAL_METHOD__ == 0`, so
     9	//! `float_t` is `float` (4 bytes).
    10	//!
    11	//! Confirmed against the compiled C shared object: `spectral_contrast` uses
    12	//! `movss` / `mulss` and a 4-byte element stride, i.e. it walks its arguments
    13	//! as `float *`, while `match` (which sees `match.h`) walks its arrays as
    14	//! `double *`.
    15	//!
    16	//! This is a bug in the original C, and per the translation contract it is
    17	//! reproduced exactly: `spectral_contrast` operates on `f32` elements.
    18	
    19	use std::ffi::c_int;
    20	use std::slice;
    21	
    22	use crate::fp::{add_sd, mul_ss};
    23	
    24	/// `static double dot_product(float_t *a, float_t *b, int length)`
    25	///
    26	/// `a[i] * b[i]` is a `float * float` product. With `FLT_EVAL_METHOD == 0` the
    27	/// multiply happens in single precision (`mulss`), and only the *result* is
    28	/// widened to `double` before being accumulated (`cvtss2sd` + `addsd`).
    29	///
    30	/// GCC emits `movss a[i]` / `mulss b[i]` / `cvtss2sd` / `addsd sum`, i.e. the
    31	/// multiply's destination is `a[i]` and the add's destination is `sum`; see
    32	/// `crate::fp` for why those roles are pinned explicitly.
    33	fn dot_product(a: &[f32], b: &[f32]) -> f64 {
    34	    let mut sum: f64 = 0.0;
    35	    for i in 0..a.len() {
    36	        sum = add_sd(sum, mul_ss(a[i], b[i]) as f64);
    37	    }
    38	    sum
    39	}
    40	
    41	/// `static void normalize(float_t *v, int length)`
    42	///
    43	/// `v[i] /= magnitude` where `v[i]` is `float` and `magnitude` is `double`:
    44	/// widen, divide in double precision, then truncate back to `float`
    45	/// (`cvtss2sd` / `divsd` / `cvtsd2ss`).
    46	fn normalize(v: &mut [f32]) {
    47	    let magnitude = dot_product(v, v).sqrt();
    48	    for i in 0..v.len() {
    49	        v[i] = ((v[i] as f64) / magnitude) as f32;
    50	    }
    51	}
    52	
    53	/// Internal entry point operating on already-checked slices, so that `match`
    54	/// can reach the same code path the C `match` reaches through the PLT.
    55	pub(crate) fn spectral_contrast_slices(a: &mut [f32], b: &mut [f32]) -> f64 {
    56	    normalize(a);
    57	    normalize(b);
    58	    dot_product(a, b)
    59	}
    60	
    61	/// `double spectral_contrast(float_t *a, float_t *b, int length)`
    62	///
    63	/// Public ABI symbol. Note the element type is `f32` (see module docs).
    64	#[unsafe(no_mangle)]
    65	pub unsafe extern "C" fn spectral_contrast(a: *mut f32, b: *mut f32, length: c_int) -> f64 {
    66	    // Every loop in this translation unit is `for(i = 0; i < length; i++)`, so
    67	    // a non-positive `length` degenerates to zero iterations:
    68	    //   dot_product -> 0.0, sqrt(0.0) -> 0.0, normalize -> no-op, result 0.0.
    69	    if length <= 0 {
    70	        return 0.0;
    71	    }
    72	    let n = length as usize;
    73	    let a = unsafe { slice::from_raw_parts_mut(a, n) };
    74	    let b = unsafe { slice::from_raw_parts_mut(b, n) };
    75	    spectral_contrast_slices(a, b)
    76	}
=== src/match.rs ===
     1	//! Rust translation of `c_src/src/match.c`.
     2	//!
     3	//! This translation unit sees `match.h`, so here `float_t` is `double` (`f64`).
     4	//! `spectral_contrast`, however, was compiled against `<math.h>`'s `float_t`
     5	//! (`f32`) -- see `spectral_contrast.rs`. The C code therefore hands
     6	//! `double`-typed scratch buffers to a function that reads them as `float`.
     7	//! That reinterpretation is part of the observable behaviour and is reproduced
     8	//! verbatim below.
     9	
    10	use std::ffi::c_int;
    11	use std::slice;
    12	
    13	use crate::fp::{add_sd, mul_sd};
    14	use crate::spectral_contrast::spectral_contrast_slices;
    15	
    16	/// `#define N_SMOOTH 16` from `include/match.h`.
    17	const N_SMOOTH: usize = 16;
    18	
    19	/// `static double total(float_t *v, int length)`
    20	fn total(v: &[f64]) -> f64 {
    21	    let mut sum: f64 = 0.0;
    22	    for i in 0..v.len() {
    23	        sum = add_sd(sum, v[i]);
    24	    }
    25	    sum
    26	}
    27	
    28	/// `static void smoothen(float_t *v, int length)`
    29	///
    30	/// In-place box filter with a truncated (not wrapped, not renormalised) kernel
    31	/// at the tail: the divisor is always `N_SMOOTH`, even when fewer than
    32	/// `N_SMOOTH` samples were available. Reproduced as-is.
    33	fn smoothen(v: &mut [f64]) {
    34	    let length = v.len();
    35	    for i in 0..length {
    36	        let mut sum: f64 = 0.0;
    37	        let mut j = 0usize;
    38	        while j < N_SMOOTH && i + j < length {
    39	            sum = add_sd(sum, v[i + j]);
    40	            j += 1;
    41	        }
    42	        v[i] = sum / N_SMOOTH as f64;
    43	    }
    44	}
    45	
    46	/// `static void differentiate(float_t *v, int length)`
    47	fn differentiate(v: &mut [f64]) {
    48	    let length = v.len();
    49	    // C: `for(i = 0; i < length - 1; i++)` then `v[length - 1] = 0;`
    50	    // For length == 0 the C writes `v[-1]`, an out-of-bounds store into stack
    51	    // padding of the caller's VLA. It is unreachable from any observable
    52	    // output (the buffer is function-local and `spectral_contrast` returns 0.0
    53	    // for length 0), so it is elided rather than reproduced as UB.
    54	    if length == 0 {
    55	        return;
    56	    }
    57	    for i in 0..length - 1 {
    58	        v[i] = v[i + 1] - v[i];
    59	    }
    60	    v[length - 1] = 0.0;
    61	}
    62	
    63	/// `static void preprocess(float_t *v, float_t *source, int length)`
    64	fn preprocess(v: &mut [f64], source: &[f64]) {
    65	    v.copy_from_slice(source); // memcpy(v, source, length * sizeof(*v))
    66	    smoothen(v);
    67	    differentiate(v);
    68	    smoothen(v);
    69	}
    70	
    71	/// `int match(float_t *test, float_t *reference, int bins, double threshold)`
    72	#[unsafe(no_mangle)]
    73	pub unsafe extern "C" fn r#match(
    74	    test: *mut f64,
    75	    reference: *mut f64,
    76	    bins: c_int,
    77	    threshold: f64,
    78	) -> c_int {
