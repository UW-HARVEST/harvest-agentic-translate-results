typedef int (*confusion_fn)(int,int,int,int);
typedef void* (*create_fn)(int,int);
typedef void (*destroy_fn)(void*);
typedef int (*procbuf_fn)(void*,char);
typedef int (*confuse_fn)(void*,int);
typedef void (*update_fn)(void*,int);
int main(int argc, char** argv){
  void* h = dlopen(argv[1], RTLD_NOW);
  if(!h){fprintf(stderr,"%s\n",dlerror());return 2;}
  confusion_fn confusion=(confusion_fn)dlsym(h,"confusion");
  create_fn cs=(create_fn)dlsym(h,"create_state");
  destroy_fn ds=(destroy_fn)dlsym(h,"destroy_state");
  procbuf_fn pb=(procbuf_fn)dlsym(h,"process_buffer");
  confuse_fn ct=(confuse_fn)dlsym(h,"confuse_types");
  update_fn uf=(update_fn)dlsym(h,"update_flags");
  srandom(20260901);
  for(int i=0;i<20000;i++){
    int a=(int)random()-(int)(random()/2), b=(int)random()*(random()&1?1:-1);
    int c=(int)random()%2000-1000, d=(int)random()%2000-1000;
    printf("F %d %d %d %d -> %d\n",a,b,c,d,confusion(a,b,c,d));
  }
  for(int i=0;i<3000;i++){
    int init=(int)random()*(random()&1?1:-1);
