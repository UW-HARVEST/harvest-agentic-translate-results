import random, subprocess, sys
C="c_src/build/driver"; R="translation/target/release/driver"
random.seed(int(sys.argv[1]))
def tok():
    r=random.random()
    if r<0.55: return str(random.randint(-5,300))
    if r<0.70: return str(random.randint(-2**33,2**33))
    if r<0.78: return str(random.choice([2**31,2**31-1,-2**31,2**63,-2**63,10**25]))
    if r<0.86: return random.choice(["abc","x","0x1f","+","-","--3","+7","","."])
    return str(random.randint(-300,600))
def ws(): return random.choice([" ","\n","  ","\t","\n\n"," \r\n","\v","\f"])
bad=0
for it in range(4000):
    n=random.randint(0,40)
    s=ws().join(tok() for _ in range(n))+random.choice(["","\n"," "])
    b=s.encode()
    a=subprocess.run([C],input=b,capture_output=True)
    c=subprocess.run([R],input=b,capture_output=True)
    if (a.stdout,a.stderr,a.returncode)!=(c.stdout,c.stderr,c.returncode):
        bad+=1
        print("MISMATCH", repr(s))
        print(" C",a.returncode,a.stdout[:200],a.stderr[:200])
        print(" R",c.returncode,c.stdout[:200],c.stderr[:200])
        if bad>6: break
print("done, mismatches:",bad)
EOF
