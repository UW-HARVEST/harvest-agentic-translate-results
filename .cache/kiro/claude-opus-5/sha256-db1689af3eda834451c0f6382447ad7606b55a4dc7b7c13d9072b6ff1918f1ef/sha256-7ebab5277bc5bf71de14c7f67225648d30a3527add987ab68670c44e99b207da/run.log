    fn puts(&mut self, k: *const c_char, v: c_int) -> isize {
        self.t = unsafe {
            (self.im.hmput_key)(self.t, ELEM, k as *mut c_void, KEYSIZE, HM_STRING)
        };
        unsafe {
            let idx = self.temp();
            let e = (self.t as *mut StrEntry).offset(idx);
