# --- Cargo features -------------------------------------------------------$
FEATURES=$(awk '$
  /^\[features\]/ { in=1; next }$
  /^\[/           { in=0 }$
  in && /^[A-Za-z0-9_-]+[[:space:]]*=/ { sub(/[[:space:]]*=.*/, ""); print }$
' "$CRATE/Cargo.toml')$
$
# --- CMake build options --------------------------------------------------$
CMAKE_OPTS=$(grep -Eio '^[[:space:]]*(option|set)\([[:space:]]*[A-Za-z0-9_]+' \$
  "$ROOT/c_src/CMakeLists.txt" 2>/dev/null | sed -E 's/.*\(\s*//' || true)$
CMAKE_DEFS=$(grep -Eic 'target_compile_definitions|add_definitions|add_compile_definitions' \$
  "$ROOT/c_src/CMakeLists.txt" || true)$
$
if [ -z "$FEATURES" ]; then$
  echo "Cargo.toml: no [features] section -> no optional features"$
else$
  echo "Cargo.toml features:"; echo "$FEATURES" | sed 's/^/  - /'$
fi$
$
if [ -z "$CMAKE_OPTS" ]; then$
  echo "CMakeLists.txt: no option()/set() build switches"$
else$
  echo "CMakeLists.txt switches:"; echo "$CMAKE_OPTS" | sed 's/^/  - /'$
fi$
echo "CMakeLists.txt compile-definition directives: $CMAKE_DEFS"$
