[0m[49m[38;5;10m+    526[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    527[0m:[38;5;10m[49m fn libraries_are_distinct_objects() {
[0m[49m[38;5;10m+    528[0m:[38;5;10m[49m     let _g = gate();
[0m[49m[38;5;10m+    529[0m:[38;5;10m[49m     let p = Pair::fresh();
[0m[49m[38;5;10m+    530[0m:[38;5;10m[49m     let a = p.c.call_local(7);
[0m[49m[38;5;10m+    531[0m:[38;5;10m[49m     let b = p.r.call_local(7);
[0m[49m[38;5;10m+    532[0m:[38;5;10m[49m     assert_eq!(a, b);
[0m[49m[38;5;10m+    533[0m:[38;5;10m[49m     let mut lc: c_int = 5;
[0m[49m[38;5;10m+    534[0m:[38;5;10m[49m     let mut lr: c_int = 5;
