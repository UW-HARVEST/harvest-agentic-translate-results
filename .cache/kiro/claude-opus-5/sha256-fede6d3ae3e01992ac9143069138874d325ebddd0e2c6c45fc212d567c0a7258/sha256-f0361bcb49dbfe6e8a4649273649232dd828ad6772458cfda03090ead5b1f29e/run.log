#[test]
fn err_row01_null_pointer_segv() {
    let _g = gate();
    let p = Pair::fresh();
    let c = run_in_child_capturing_stderr(|| {
        let _ = unsafe { (p.c.sa)(std::ptr::null_mut()) };
    });
