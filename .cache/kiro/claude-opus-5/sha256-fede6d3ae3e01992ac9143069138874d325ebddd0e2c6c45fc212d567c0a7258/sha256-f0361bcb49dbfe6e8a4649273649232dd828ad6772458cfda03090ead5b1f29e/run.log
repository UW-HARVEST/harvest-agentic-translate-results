                "misaligned off={off} v={v}: caller buffers differ"
            );
            let (pc, pr) = (p.c.probe_inner(), p.r.probe_inner());
            assert_eq!(pc, pr, "misaligned off={off} v={v}: `inner` differs");
        }
    }
