    k1.iA[0]=0;k1.iA[1]=1;k1.iB[0]=0;k1.iB[1]=1;
    c2GJKCache k2=k1;
    float d1=f1(&a,C2_TYPE_CIRCLE,0,&b,C2_TYPE_CIRCLE,0,0,0,1,0,&k1);
    float d2=f2(&a,C2_TYPE_CIRCLE,0,&b,C2_TYPE_CIRCLE,0,0,0,1,0,&k2);
    n++; if(memcmp(&d1,&d2,4)) diff++;
  }
  printf("forged-cache: compared=%ld differing=%ld\n",n,diff);
  return 0;
}
