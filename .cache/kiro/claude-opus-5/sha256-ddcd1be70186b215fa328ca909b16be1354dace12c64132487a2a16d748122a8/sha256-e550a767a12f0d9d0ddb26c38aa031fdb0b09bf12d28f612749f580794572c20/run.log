typedef enum { C2_TYPE_CIRCLE, C2_TYPE_AABB, C2_TYPE_CAPSULE } C2_TYPE;
typedef struct { float x,y; } c2v;
typedef struct { float c,s; } c2r;
typedef struct { c2v p; c2r r; } c2x;
typedef struct { c2v p; float r; } c2Circle;
typedef struct { float metric; int count; int iA[3]; int iB[3]; float div; } c2GJKCache;
typedef float (*GJK)(const void*,C2_TYPE,const c2x*,const void*,C2_TYPE,const c2x*,c2v*,c2v*,int,int*,c2GJKCache*);
static uint32_t rs=0x2468ace0u; static uint32_t nx(void){rs^=rs<<13;rs^=rs>>17;rs^=rs<<5;return rs;}
int main(int c_,char**v){
  void*h1=dlopen(v[1],RTLD_NOW|RTLD_LOCAL), *h2=dlopen(v[2],RTLD_NOW|RTLD_LOCAL);
  GJK f1=(GJK)dlsym(h1,"c2GJK"), f2=(GJK)dlsym(h2,"c2GJK");
  long diff=0,n=0;
  for(int i=0;i<200000;i++){
    c2Circle a={{(float)(nx()%200)-100,(float)(nx()%200)-100},(float)(nx()%50)};
    c2Circle b={{(float)(nx()%200)-100,(float)(nx()%200)-100},(float)(nx()%50)};
