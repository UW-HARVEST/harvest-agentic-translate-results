     1	//! Translation of `c_src/src/match.c`.
     2	//!
     3	//! This translation unit includes `match.h`, so `float_t` here is `double`.
     4	
     5	use core::ffi::{c_double, c_int};
     6	
     7	use crate::spectral_contrast::spectral_contrast;
     8	use crate::{clamp_len, slice_from_raw};
     9	
    10	/// `#define N_SMOOTH 16` -- size of the smoothing kernel.
    11	const N_SMOOTH: usize = 16;
    12	
    13	/// Scratch buffers here carry one extra leading element ahead of the logical
    14	/// vector `v`, so the index this offset applies is spelled out once.
    15	const PAD: usize = 1;
    16	
    17	/// ```c
    18	/// static double total(float_t *v, int length) {
    19	///     double sum = 0;
    20	///     int i;
    21	///     for(i = 0; i < length; i++) sum += v[i];
    22	///     return sum;
    23	/// }
    24	/// ```
    25	fn total(v: &[f64]) -> f64 {
    26	    let mut sum: f64 = 0.0;
    27	    for &element in v {
    28	        sum += element;
    29	    }
    30	    sum
    31	}
    32	
    33	/// ```c
    34	/// static void smoothen(float_t *v, int length) {
    35	///     double sum;
    36	///     int i, j;
    37	///     for(i = 0; i < length; i++) {
    38	///         sum = 0;
    39	///         for(j = 0; j < N_SMOOTH && i + j < length; j++)
    40	///             sum += v[i + j];
    41	///         v[i] = sum / N_SMOOTH;
    42	///     }
    43	/// }
    44	/// ```
    45	///
    46	/// The tail elements (`i > length - N_SMOOTH`) still divide by the full
    47	/// `N_SMOOTH` even though fewer terms were summed, which damps the tail towards
    48	/// zero. That is the C's behaviour and is kept.
    49	fn smoothen(v: &mut [f64]) {
    50	    let length = v.len();
    51	    for i in 0..length {
    52	        let mut sum: f64 = 0.0;
    53	        let mut j = 0usize;
    54	        while j < N_SMOOTH && i + j < length {
    55	            sum += v[i + j];
    56	            j += 1;
    57	        }
    58	        v[i] = sum / N_SMOOTH as f64;
    59	    }
    60	}
    61	
    62	/// ```c
    63	/// static void differentiate(float_t *v, int length) {
    64	///     int i;
    65	///     for(i = 0; i < length - 1; i++) v[i] = v[i + 1] - v[i];
    66	///     v[length - 1] = 0;
    67	/// }
    68	/// ```
    69	///
    70	/// `buf` is a padded buffer: `buf[0]` is scratch and `buf[PAD..]` is the
    71	/// logical vector `v` of length `buf.len() - PAD`. The padding exists so that
    72	/// the C's `v[length - 1] = 0` store still has somewhere to land when
    73	/// `length == 0`, where C writes one element *before* the array. Reproducing
    74	/// that store harmlessly keeps the memory-safety of this translation without
    75	/// changing any observable result.
    76	fn differentiate(buf: &mut [f64]) {
    77	    let length = buf.len() - PAD;
    78	    for i in 0..length.saturating_sub(1) {
    79	        buf[PAD + i] = buf[PAD + i + 1] - buf[PAD + i];
    80	    }
    81	    // `PAD + length - 1` for the in-bounds case, `buf[0]` (the pad) for
    82	    // `length == 0`.
    83	    buf[length] = 0.0;
    84	}
    85	
    86	/// ```c
    87	/// static void preprocess(float_t *v, float_t *source, int length) {
    88	///     memcpy(v, source, length * sizeof(*v));
    89	///     smoothen(v, length);
    90	///     differentiate(v, length);
    91	///     smoothen(v, length);
    92	/// }
    93	/// ```
    94	fn preprocess(buf: &mut [f64], source: &[f64]) {
    95	    buf[PAD..].copy_from_slice(source);
    96	    smoothen(&mut buf[PAD..]);
    97	    differentiate(buf);
    98	    smoothen(&mut buf[PAD..]);
    99	}
   100	
   101	/// ```c
   102	/// int match(float_t *test, float_t *reference, int bins, double threshold) {
   103	///     float_t t[bins], r[bins];
   104	///     if(total(test, bins) < threshold * total(reference, bins)) return 0;
   105	///     preprocess(t, test, bins);
   106	///     preprocess(r, reference, bins);
   107	///     return spectral_contrast(t, r, bins) >= threshold;
   108	/// }
   109	/// ```
   110	///
   111	/// `t` and `r` are `double` arrays, but `spectral_contrast` -- compiled with
   112	/// `float_t == float` -- reinterprets them as `float` arrays. The cast below
   113	/// preserves that. See the crate docs.
   114	///
   115	/// # Safety
   116	/// `test` and `reference` must each be valid for reads of `bins` `double`s.
   117	#[unsafe(no_mangle)]
   118	pub unsafe extern "C" fn r#match(
   119	    test: *mut c_double,
   120	    reference: *mut c_double,
   121	    bins: c_int,
   122	    threshold: c_double,
   123	) -> c_int {
   124	    let len = clamp_len(bins);
   125	    let test = unsafe { slice_from_raw(test, len) };
   126	    let reference = unsafe { slice_from_raw(reference, len) };
   127	
   128	    if total(test) < threshold * total(reference) {
   129	        return 0;
   130	    }
   131	
   132	    let mut t = vec![0.0f64; len + PAD];
   133	    let mut r = vec![0.0f64; len + PAD];
   134	    preprocess(&mut t, test);
   135	    preprocess(&mut r, reference);
   136	
   137	    let contrast = unsafe {
   138	        spectral_contrast(
   139	            t[PAD..].as_mut_ptr().cast(),
   140	            r[PAD..].as_mut_ptr().cast(),
   141	            bins,
   142	        )
   143	    };
   144	    (contrast >= threshold) as c_int
   145	}
===== translation/src/spectral_contrast.rs =====
     1	//! Translation of `c_src/src/spectral_contrast.c`.
     2	//!
     3	//! This translation unit does **not** include `match.h`, so its `float_t` is
     4	//! `<math.h>`'s C99 `float_t`, i.e. `float` on x86-64 Linux. See the crate
     5	//! docs.
     6	
     7	use core::ffi::{c_double, c_float, c_int};
     8	
     9	use crate::{clamp_len, slice_from_raw_mut};
    10	
    11	/// ```c
    12	/// static double dot_product(float_t *a, float_t *b, int length) {
    13	///     double sum = 0;
    14	///     int i;
    15	///     for(i = 0; i < length; i++) sum += a[i] * b[i];
    16	///     return sum;
    17	/// }
    18	/// ```
    19	///
    20	/// `a[i] * b[i]` multiplies two `float`s, so the product is rounded to `float`
    21	/// *before* being widened and accumulated into the `double` sum (`mulss`,
    22	/// `cvtss2sd`, `addsd`). The `as f32` round-trip below is load-bearing.
    23	fn dot_product(a: &[f32], b: &[f32]) -> f64 {
    24	    let mut sum: f64 = 0.0;
    25	    for i in 0..a.len() {
    26	        let product: f32 = a[i] * b[i];
    27	        sum += product as f64;
    28	    }
    29	    sum
    30	}
    31	
    32	/// ```c
    33	/// static void normalize(float_t *v, int length) {
    34	///     double magnitude = sqrt(dot_product(v, v, length));
    35	///     int i;
    36	///     for(i = 0; i < length; i++) v[i] /= magnitude;
    37	/// }
    38	/// ```
    39	///
    40	/// `v[i] /= magnitude` widens the element to `double`, divides in `double`,
    41	/// then narrows back to `float`. A zero or NaN magnitude is not guarded against
    42	/// in the C, and is not guarded against here.
    43	fn normalize(v: &mut [f32]) {
    44	    let magnitude: f64 = dot_product(&*v, &*v).sqrt();
    45	    for element in v.iter_mut() {
    46	        *element = (*element as f64 / magnitude) as f32;
    47	    }
    48	}
    49	
    50	/// ```c
    51	/// double spectral_contrast(float_t *a, float_t *b, int length) {
    52	///     normalize(a, length);
    53	///     normalize(b, length);
    54	///     return dot_product(a, b, length);
    55	/// }
    56	/// ```
    57	///
    58	/// # Safety
    59	/// `a` and `b` must each be valid for reads and writes of `length` `float`s and
    60	/// must not alias. Callers of the C library that follow `match.h` will pass
    61	/// `double` arrays instead; only the leading `length * 4` bytes are touched.
    62	#[unsafe(no_mangle)]
    63	pub unsafe extern "C" fn spectral_contrast(
    64	    a: *mut c_float,
    65	    b: *mut c_float,
    66	    length: c_int,
    67	) -> c_double {
    68	    let len = clamp_len(length);
    69	    let a = unsafe { slice_from_raw_mut(a, len) };
    70	    let b = unsafe { slice_from_raw_mut(b, len) };
    71	    normalize(a);
    72	    normalize(b);
    73	    dot_product(a, b)
    74	}
