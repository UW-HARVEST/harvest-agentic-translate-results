     1	//! Rust translation of `c_src` (MIT Lincoln Laboratory spectral matcher).
     2	//!
     3	//! The C build compiles two translation units, `src/match.c` and
     4	//! `src/spectral_contrast.c`, into one shared library exporting `match` and
     5	//! `spectral_contrast`.
     6	//!
     7	//! # The `float_t` divergence (faithfully reproduced, not fixed)
     8	//!
     9	//! `include/match.h` contains `typedef double float_t;`, so every `float_t` in
    10	//! `match.c` (which includes `match.h`) is a **`double`**.
    11	//!
    12	//! `spectral_contrast.c` includes only `<math.h>` and *never* includes
    13	//! `match.h`. It therefore picks up the C99 `float_t` from `<math.h>`, which on
    14	//! x86-64 Linux (`FLT_EVAL_METHOD == 0`) is a **`float`**. Its functions really
    15	//! do load, multiply and store 4-byte floats -- verified against the emitted
    16	//! object code (`movss` / `mulss` / `cvtss2sd` / `divsd` / `cvtsd2ss`).
    17	//!
    18	//! The two units still link, because the mismatch is only in the pointee type,
    19	//! and the header's declaration makes `match.c` pass `double *` buffers to a
    20	//! function that reinterprets them as `float *`. So `spectral_contrast` chews
    21	//! through only the first `length * 4` bytes of each `length`-element `double`
    22	//! array and fills the leading half with bit-recycled garbage. That is the
    23	//! behaviour the C library has, so it is the behaviour reproduced here: the
    24	//! Rust `spectral_contrast` takes `*mut c_float`, and `match` hands it its
    25	//! `f64` scratch buffers cast to `*mut c_float`.
    26	
    27	mod matcher;
    28	mod spectral_contrast;
    29	
    30	/// Reconstructs a shared slice from a C pointer, tolerating the null/empty
    31	/// case that `slice::from_raw_parts` forbids but C accepts.
    32	///
    33	/// # Safety
    34	/// For `len > 0`, `p` must be valid for reads of `len` elements.
    35	unsafe fn slice_from_raw<'a, T>(p: *const T, len: usize) -> &'a [T] {
    36	    if len == 0 {
    37	        &[]
    38	    } else {
    39	        unsafe { core::slice::from_raw_parts(p, len) }
    40	    }
    41	}
    42	
    43	/// Mutable counterpart of [`slice_from_raw`].
    44	///
    45	/// # Safety
    46	/// For `len > 0`, `p` must be valid for reads and writes of `len` elements and
    47	/// must not alias any other live reference.
    48	unsafe fn slice_from_raw_mut<'a, T>(p: *mut T, len: usize) -> &'a mut [T] {
    49	    if len == 0 {
    50	        &mut []
    51	    } else {
    52	        unsafe { core::slice::from_raw_parts_mut(p, len) }
    53	    }
    54	}
    55	
    56	/// C's `int`-typed lengths are used unchecked as array bounds. A non-positive
    57	/// length makes every C loop body run zero times, so clamp to zero.
    58	fn clamp_len(length: core::ffi::c_int) -> usize {
    59	    if length > 0 { length as usize } else { 0 }
    60	}
