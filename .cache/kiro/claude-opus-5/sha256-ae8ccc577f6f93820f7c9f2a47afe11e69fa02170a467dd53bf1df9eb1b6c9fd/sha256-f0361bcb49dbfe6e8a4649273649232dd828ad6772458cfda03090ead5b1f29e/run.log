/// `set_error()` with the message already rendered by the caller.
unsafe fn set_error_rendered(
    s: *mut scanner_t,
    source: *const c_char,
    code: c_int,
    text: *const c_char,
) {
    unsafe {
        jsonp_error_set_str(
            (*s).error,
            (*s).token.line,
            (*s).token.column,
            (*s).token.pos,
            code,
            text,
        );

        jsonp_error_set_source((*s).error, source);
    }
}

macro_rules! set_error {
