    return x-0x100000000 if x>=0x80000000 else x
bases=[-2**31,-0x40000000,-0x20000000,-1024,-4,-1,0,1,4,1024,0x20000000,0x40000000,2**31-1]
vals=sorted({wrap32(b+d) for b in bases for d in (-2,-1,0,1,2)})
