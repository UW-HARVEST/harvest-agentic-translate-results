import pty, os, sys
def run_on_pty(argv, infile):
    m, s = pty.openpty()
    with open(infile,'rb') as f:
        data=f.read()
    r,w = os.pipe()
    os.write(w, data); os.close(w)
    pid = os.fork()
    if pid==0:
        os.dup2(r,0); os.dup2(s,1); os.dup2(s,2); os.close(m)
        os.execv(argv[0], argv)
    os.close(s); os.close(r)
    out=b''
    try:
        while True:
            b=os.read(m,4096)
            if not b: break
            out+=b
    except OSError:
        pass
    _,st=os.waitpid(pid,0)
    return out, st
out, st = run_on_pty(['/local/home/scheschb/.harvest/work/harvest-work-RzDpWx/c_src/build/driver'], '/tmp/in160.txt')
