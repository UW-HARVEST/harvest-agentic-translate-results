            rs, c,
            "allocate_and_compute({size}, 1.5) [{bytes} bytes]: C={c} Rust={rs} \\
             (same malloc outcome required)"
        );
        assert!(bytes >= 8 << 30);
        assert_eq!(
            c, -1,
            "C: allocate_and_compute({size}, 1.5) requests {bytes} bytes and should be -1"
        );
    }
"""
assert old_e9 in s
s = s.replace(old_e9, new_e9)

