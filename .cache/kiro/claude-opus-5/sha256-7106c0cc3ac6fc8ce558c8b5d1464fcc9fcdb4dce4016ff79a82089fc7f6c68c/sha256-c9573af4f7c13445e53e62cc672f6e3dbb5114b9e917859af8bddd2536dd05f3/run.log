#[test]
fn err_e19_mult_inf() {
    let p = pair();
    for (m, want_big) in [(f64::INFINITY, i32::MAX), (f64::NEG_INFINITY, i32::MIN)] {
        // size == 1 -> i == 0 -> value 0, coefficient +-inf -> 0 * inf = NaN.
        let c = p.c.allocate_and_compute(1, m);
        let rs = p.rs.allocate_and_compute(1, m);
        assert_eq!(c, 0, "C: allocate_and_compute(1, {m:?}) should be 0 (0*inf=NaN)");
        assert_eq!(rs, c, "allocate_and_compute(1, {m:?}): C={c} Rust={rs}");

