            assert_eq!(
                c, want_big,
                "C: allocate_and_compute({size}, {m:?}) should be {want_big}"
            );
            assert_eq!(
                rs, c,
                "allocate_and_compute({size}, {m:?}): C={c} Rust={rs}"
            );
        }
    }
}
