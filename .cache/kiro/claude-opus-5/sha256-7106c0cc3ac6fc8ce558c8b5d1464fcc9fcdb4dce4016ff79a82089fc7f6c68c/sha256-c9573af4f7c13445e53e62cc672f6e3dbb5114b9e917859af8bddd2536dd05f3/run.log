[0m[49m[38;5;10m+    593[0m:[38;5;10m[49m fn err_g5_operation_fuzz() {
[0m[49m[38;5;10m+    594[0m:[38;5;10m[49m     let p = pair();
[0m[49m[38;5;10m+    595[0m:[38;5;10m[49m     let mut r = Rng::new(0xG5_0000u64.wrapping_mul(1)); // placeholder replaced below
[0m[49m[38;5;10m+    596[0m:[38;5;10m[49m     let _ = &mut r;
