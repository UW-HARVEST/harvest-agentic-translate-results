[0m[49m[38;5;10m+     52[0m:[38;5;10m[49m     let n = COUNTER.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
[0m[49m[38;5;10m+     53[0m:[38;5;10m[49m     let path = std::env::temp_dir().join(format!(
[0m[49m[38;5;10m+     54[0m:[38;5;10m[49m         "driver_diff_{}_{}_{}.out",
[0m[49m[38;5;10m+     55[0m:[38;5;10m[49m         std::process::id(),
[0m[49m[38;5;10m+     56[0m:[38;5;10m[49m         tag,
[0m[49m[38;5;10m+     57[0m:[38;5;10m[49m         n
[0m[49m[38;5;10m+     58[0m:[38;5;10m[49m     ));
[0m[49m[38;5;10m+     59[0m:[38;5;10m[49m     let file = File::create(&path).expect("create capture file");
[0m[49m[38;5;10m+     60[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     61[0m:[38;5;10m[49m     unsafe {
[0m[49m[38;5;10m+     62[0m:[38;5;10m[49m         // Flush anything already buffered so it lands on the real stdout.
[0m[49m[38;5;10m+     63[0m:[38;5;10m[49m         fflush(std::ptr::null_mut());
[0m[49m[38;5;10m+     64[0m:[38;5;10m[49m         let saved = dup(1);
[0m[49m[38;5;10m+     65[0m:[38;5;10m[49m         assert!(saved >= 0, "dup(1) failed");
[0m[49m[38;5;10m+     66[0m:[38;5;10m[49m         assert!(dup2(file.as_raw_fd(), 1) >= 0, "dup2 onto fd 1 failed");
[0m[49m[38;5;10m+     67[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     68[0m:[38;5;10m[49m         f();
[0m[49m[38;5;10m+     69[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     70[0m:[38;5;10m[49m         // The libraries use buffered stdio; force it out before restoring.
[0m[49m[38;5;10m+     71[0m:[38;5;10m[49m         fflush(std::ptr::null_mut());
[0m[49m[38;5;10m+     72[0m:[38;5;10m[49m         assert!(dup2(saved, 1) >= 0, "restoring fd 1 failed");
[0m[49m[38;5;10m+     73[0m:[38;5;10m[49m         close(saved);
[0m[49m[38;5;10m+     74[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     75[0m:[38;5;10m[49m     drop(file);
[0m[49m[38;5;10m+     76[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     77[0m:[38;5;10m[49m     let bytes = std::fs::read(&path).expect("read capture file");
[0m[49m[38;5;10m+     78[0m:[38;5;10m[49m     let _ = std::fs::remove_file(&path);
[0m[49m[38;5;10m+     79[0m:[38;5;10m[49m     bytes
[0m[49m[38;5;10m+     80[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     81[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     82[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+     83[0m:[38;5;10m[49m // Locating and loading the two shared objects.
[0m[49m[38;5;10m+     84[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+     85[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     86[0m:[38;5;10m[49m fn manifest_dir() -> PathBuf {
[0m[49m[38;5;10m+     87[0m:[38;5;10m[49m     PathBuf::from(env!("CARGO_MANIFEST_DIR"))
[0m[49m[38;5;10m+     88[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     89[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     90[0m:[38;5;10m[49m /// `c_src/build/libdriver.so`, built with cmake on demand.
[0m[49m[38;5;10m+     91[0m:[38;5;10m[49m fn c_so_path() -> PathBuf {
[0m[49m[38;5;10m+     92[0m:[38;5;10m[49m     let root = manifest_dir().parent().expect("workspace root").to_path_buf();
