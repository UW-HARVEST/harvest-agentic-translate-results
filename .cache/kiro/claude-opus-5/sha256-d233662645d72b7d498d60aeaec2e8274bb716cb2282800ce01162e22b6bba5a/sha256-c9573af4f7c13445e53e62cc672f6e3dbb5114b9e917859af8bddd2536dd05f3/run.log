[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m // Phase B — valid-path differential tests, one per CONFIGS.md row.
[0m[49m[38;5;10m+    271[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    272[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    273[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    274[0m:[38;5;10m[49m fn config_c1_small_positive() {
