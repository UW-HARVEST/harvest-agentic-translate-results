[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m #[track_caller]
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m fn assert_same(row: &str, values: &[i32]) {
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m     assert!(!values.is_empty(), "{row}: no inputs generated");
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    216[0m:[38;5;10m[49m     let (c_out, rust_out) = {
