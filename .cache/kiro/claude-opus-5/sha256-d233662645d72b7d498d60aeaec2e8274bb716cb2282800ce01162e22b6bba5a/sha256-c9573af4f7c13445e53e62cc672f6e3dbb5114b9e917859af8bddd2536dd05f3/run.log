[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m             let c1 = capture_stdout_locked("c1", || unsafe { c_fn(v) });
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m             let r1 = capture_stdout_locked("r1", || unsafe { r_fn(v) });
