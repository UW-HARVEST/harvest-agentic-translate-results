=== lib.rs ===
     1	// Rust translation of the C library in c_src/.
     2	//
     3	// Original C library (c_src/):
     4	//   * c_src/include/driver.h -- public header, declares `void driver(int x);`
     5	//   * c_src/src/driver.c     -- the single translation unit
     6	//
     7	// The C build (c_src/CMakeLists.txt) compiles src/driver.c into a shared
     8	// library whose only exported (defined) dynamic symbol is `driver`. There are
     9	// no namespace-renaming preprocessor macros in the public header, so the final
    10	// linker symbol is plainly `driver`.
    11	
    12	#![allow(non_snake_case)]
    13	
    14	use std::ffi::{c_char, c_int};
    15	
    16	// The C code uses `printf("%d\n", y)` from <stdio.h>. We call the very same
    17	// libc function rather than Rust's own `print!`/`std::io::stdout`, so that the
    18	// emitted bytes *and* the stdio buffering/flush semantics (line buffered on a
    19	// tty, fully buffered when redirected, flushed at exit by libc) are identical
    20	// to the original library. This also keeps output correctly interleaved with
    21	// any stdio writes performed by a C caller that loads this shared object.
    22	unsafe extern "C" {
    23	    fn printf(format: *const c_char, ...) -> c_int;
    24	}
    25	
    26	/// Translation of:
    27	///
    28	/// ```c
    29	/// void driver(int x) {
    30	///     register int y = 2*x;
    31	///     y += 300;
    32	///     printf("%d\n", y);
    33	/// }
    34	/// ```
    35	///
    36	/// `register` is only a (long-obsolete) storage-class hint and has no bearing
    37	/// on observable behaviour, so it is not modelled.
    38	///
    39	/// The arithmetic is performed with wrapping semantics on `i32`: signed
    40	/// overflow is undefined behaviour in C, but the C library as actually compiled
    41	/// (two's-complement `lea`/`add` on the target) wraps, so `wrapping_*` faithfully
    42	/// reproduces the original behaviour for every input, including `INT_MIN` and
    43	/// values near `INT_MAX`, instead of panicking as Rust's checked arithmetic
    44	/// would in a debug build. No bug is "fixed" here: the observable result matches
    45	/// the C.
    46	#[unsafe(no_mangle)]
    47	pub extern "C" fn driver(x: c_int) {
    48	    let mut y: c_int = (x as i32).wrapping_mul(2);
    49	    y = y.wrapping_add(300);
    50	
    51	    // "%d\n\0" -- exactly the format string used by the C source.
    52	    unsafe {
    53	        printf(c"%d\n".as_ptr(), y);
    54	    }
    55	}
