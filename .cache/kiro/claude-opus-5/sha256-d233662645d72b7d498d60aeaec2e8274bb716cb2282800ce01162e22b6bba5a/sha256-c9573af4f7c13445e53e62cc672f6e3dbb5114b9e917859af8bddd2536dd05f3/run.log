[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m             String::from_utf8_lossy(&r1),
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m             "{row}: divergence for driver({v})"
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m     }
