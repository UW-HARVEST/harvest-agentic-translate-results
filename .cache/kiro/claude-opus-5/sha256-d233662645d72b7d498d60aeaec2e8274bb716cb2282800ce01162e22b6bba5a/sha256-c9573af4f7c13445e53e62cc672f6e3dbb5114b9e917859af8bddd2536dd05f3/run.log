[0m[49m[38;5;10m+    178[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    179[0m:[38;5;10m[49m const SEED: u64 = 0x5EED_D1FF_C0FF_EE01;
[0m[49m[38;5;10m+    180[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    181[0m:[38;5;10m[49m struct Rng(u64);
[0m[49m[38;5;10m+    182[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    183[0m:[38;5;10m[49m impl Rng {
[0m[49m[38;5;10m+    184[0m:[38;5;10m[49m     fn new(stream: u64) -> Self {
[0m[49m[38;5;10m+    185[0m:[38;5;10m[49m         Rng(SEED ^ stream.wrapping_mul(0xA0761D6478BD642F))
[0m[49m[38;5;10m+    186[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    187[0m:[38;5;10m[49m     fn next_u64(&mut self) -> u64 {
[0m[49m[38;5;10m+    188[0m:[38;5;10m[49m         self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);
