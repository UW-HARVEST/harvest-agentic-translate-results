[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m             for &v in values {
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m                 unsafe { r_fn(v) };
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m         });
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m         (c_out, rust_out)
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m     };
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m     if c_out == rust_out {
