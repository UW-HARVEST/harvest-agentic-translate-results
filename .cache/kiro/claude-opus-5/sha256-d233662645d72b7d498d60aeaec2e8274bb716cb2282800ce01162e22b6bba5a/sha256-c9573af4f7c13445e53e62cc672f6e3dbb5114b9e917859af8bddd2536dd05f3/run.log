[0m[49m[38;5;10m+    656[0m:[38;5;10m[49m     };
[0m[49m[38;5;10m+    657[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    658[0m:[38;5;10m[49m     let c_fn = c_driver();
[0m[49m[38;5;10m+    659[0m:[38;5;10m[49m     let r_fn = rust_driver();
