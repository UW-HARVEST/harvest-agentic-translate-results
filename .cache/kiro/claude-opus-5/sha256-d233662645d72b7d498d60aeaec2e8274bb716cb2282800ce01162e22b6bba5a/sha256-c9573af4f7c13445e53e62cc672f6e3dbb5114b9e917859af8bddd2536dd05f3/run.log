[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    277[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    278[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    279[0m:[38;5;10m[49m fn config_c2_small_negative() {
[0m[49m[38;5;10m+    280[0m:[38;5;10m[49m     randomized("C2", 2, N, -1000, -1);
[0m[49m[38;5;10m+    281[0m:[38;5;10m[49m }
