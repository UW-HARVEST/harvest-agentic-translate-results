[0m[49m[38;5;10m+     48[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     49[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     50[0m:[38;5;10m[49m fn capture_stdout_locked<F: FnOnce()>(tag: &str, f: F) -> Vec<u8> {
