[0m[49m[38;5;10m+    664[0m:[38;5;10m[49m     });
[0m[49m[38;5;10m+    665[0m:[38;5;10m[49m     c_returned = true;
[0m[49m[38;5;10m+    666[0m:[38;5;10m[49m     let (r_rc, r_err) = run(&|| {
[0m[49m[38;5;10m+    667[0m:[38;5;10m[49m         unsafe { r_fn(7) };
[0m[49m[38;5;10m+    668[0m:[38;5;10m[49m     });
[0m[49m[38;5;10m+    669[0m:[38;5;10m[49m     r_returned = true;
