[0m[49m[38;5;10m+      6[0m:[38;5;10m[49m //!
[0m[49m[38;5;10m+      7[0m:[38;5;10m[49m //! The only observable behaviour of `void driver(int)` is the bytes it writes
[0m[49m[38;5;10m+      8[0m:[38;5;10m[49m //! to `stdout` via `printf`, so every assertion is a byte-for-byte comparison
[0m[49m[38;5;10m+      9[0m:[38;5;10m[49m //! of captured `stdout`.
[0m[49m[38;5;10m+     10[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     11[0m:[38;5;10m[49m use libloading::{Library, Symbol};
[0m[49m[38;5;10m+     12[0m:[38;5;10m[49m use std::ffi::{c_char, c_int, c_void};
[0m[49m[38;5;10m+     13[0m:[38;5;10m[49m use std::fs::File;
[0m[49m[38;5;10m+     14[0m:[38;5;10m[49m use std::os::unix::io::AsRawFd;
[0m[49m[38;5;10m+     15[0m:[38;5;10m[49m use std::path::{Path, PathBuf};
[0m[49m[38;5;10m+     16[0m:[38;5;10m[49m use std::process::Command;
[0m[49m[38;5;10m+     17[0m:[38;5;10m[49m use std::sync::{Mutex, MutexGuard, OnceLock};
[0m[49m[38;5;10m+     18[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     19[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+     20[0m:[38;5;10m[49m // libc bits used for capturing whatever the loaded libraries write to fd 1.
[0m[49m[38;5;10m+     21[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+     22[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     23[0m:[38;5;10m[49m unsafe extern "C" {
[0m[49m[38;5;10m+     24[0m:[38;5;10m[49m     fn dup(oldfd: c_int) -> c_int;
[0m[49m[38;5;10m+     25[0m:[38;5;10m[49m     fn dup2(oldfd: c_int, newfd: c_int) -> c_int;
[0m[49m[38;5;10m+     26[0m:[38;5;10m[49m     fn close(fd: c_int) -> c_int;
[0m[49m[38;5;10m+     27[0m:[38;5;10m[49m     fn fflush(stream: *mut c_void) -> c_int;
[0m[49m[38;5;10m+     28[0m:[38;5;10m[49m     fn clearerr(stream: *mut c_void);
[0m[49m[38;5;10m+     29[0m:[38;5;10m[49m     fn open(path: *const c_char, flags: c_int, ...) -> c_int;
[0m[49m[38;5;10m+     30[0m:[38;5;10m[49m     static mut stdout: *mut c_void;
[0m[49m[38;5;10m+     31[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     32[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     33[0m:[38;5;10m[49m const O_WRONLY: c_int = 1;
[0m[49m[38;5;10m+     34[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     35[0m:[38;5;10m[49m /// fd 1 is process-global, so captures must never overlap.
[0m[49m[38;5;10m+     36[0m:[38;5;10m[49m fn capture_lock() -> MutexGuard<'static, ()> {
[0m[49m[38;5;10m+     37[0m:[38;5;10m[49m     static LOCK: OnceLock<Mutex<()>> = OnceLock::new();
[0m[49m[38;5;10m+     38[0m:[38;5;10m[49m     match LOCK.get_or_init(|| Mutex::new(())).lock() {
[0m[49m[38;5;10m+     39[0m:[38;5;10m[49m         Ok(g) => g,
[0m[49m[38;5;10m+     40[0m:[38;5;10m[49m         Err(p) => p.into_inner(),
[0m[49m[38;5;10m+     41[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     42[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     43[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     44[0m:[38;5;10m[49m /// Run `f` with fd 1 redirected to a temp file; return everything written.
[0m[49m[38;5;10m+     45[0m:[38;5;10m[49m fn capture_stdout<F: FnOnce()>(tag: &str, f: F) -> Vec<u8> {
