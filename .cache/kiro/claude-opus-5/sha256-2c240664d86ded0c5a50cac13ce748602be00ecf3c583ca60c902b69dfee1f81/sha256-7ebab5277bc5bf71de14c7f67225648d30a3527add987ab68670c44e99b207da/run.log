/// actually written by the implementation.  The allocation is
/// `(w+1)*h*4` bytes but only part of it is ever touched; the rest is
/// uninitialised `malloc` memory and would differ between any two runs.
fn deterministic_len(w: usize, h: usize, bpp: usize, raw_len: usize) -> usize {
    let alloc = (w + 1) * h * 4;
    let out_off = (w + 1) * h * (4 - bpp);
    let written_end = (out_off + raw_len).min(alloc);
    written_end.max(w * h * 4).min(alloc)
}

