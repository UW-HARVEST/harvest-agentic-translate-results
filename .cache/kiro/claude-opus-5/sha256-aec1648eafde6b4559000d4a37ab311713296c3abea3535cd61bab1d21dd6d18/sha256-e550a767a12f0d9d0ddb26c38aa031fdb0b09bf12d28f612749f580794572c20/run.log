#include <dlfcn.h>
#include <stdio.h>
#include <stdint.h>
#include <stdlib.h>

typedef int (*cmp_fn)(const uint8_t *, const uint8_t *);

static long long mismatches = 0, checks = 0;

static void chk(cmp_fn c, cmp_fn r, const uint8_t *h1, const uint8_t *h2) {
    int a = c(h1, h2), b = r(h1, h2);
    checks++;
    if (a != b) {
        if (mismatches < 10)
            fprintf(stderr, "MISMATCH h1=%02x%02x%02x h2=%02x%02x%02x C=%d Rust=%d\n",
                    h1[0], h1[1], h1[2], h2[0], h2[1], h2[2], a, b);
        mismatches++;
    }
}

int main(int argc, char **argv) {
    void *hc = dlopen(argv[1], RTLD_NOW | RTLD_LOCAL);
    if (!hc) { fprintf(stderr, "dlopen C: %s\n", dlerror()); return 2; }
    void *hr = dlopen(argv[2], RTLD_NOW | RTLD_LOCAL);
    if (!hr) { fprintf(stderr, "dlopen Rust: %s\n", dlerror()); return 2; }
    cmp_fn c = (cmp_fn)dlsym(hc, "hdr_compare");
    cmp_fn r = (cmp_fn)dlsym(hr, "hdr_compare");
    if (!c || !r) { fprintf(stderr, "dlsym failed (C=%p Rust=%p)\n", (void*)c, (void*)r); return 2; }

    uint8_t h1[3], h2[3];

    /* Phase 1: every possible 3-byte h2 (2^24) against a spread of h1 values. */
    static const uint8_t h1set[][3] = {
        {0x00,0x00,0x00}, {0xff,0xfb,0x90}, {0xff,0xe3,0x44},
        {0x12,0xff,0xff}, {0xaa,0x55,0x0c}, {0x00,0xfa,0xf0},
    };
    for (unsigned b0 = 0; b0 < 256; b0++)
      for (unsigned b1 = 0; b1 < 256; b1++)
        for (unsigned b2 = 0; b2 < 256; b2++) {
            h2[0]=b0; h2[1]=b1; h2[2]=b2;
            for (unsigned k = 0; k < sizeof(h1set)/sizeof(h1set[0]); k++) {
                h1[0]=h1set[k][0]; h1[1]=h1set[k][1]; h1[2]=h1set[k][2];
                chk(c, r, h1, h2);
            }
        }

    /* Phase 2: exhaustive over the bytes hdr_compare actually reads:
       h2[0]=0xff (only value that can pass validation) x all h2[1],h2[2]
       x all h1[1],h1[2]. h1[0] is stirred since C never reads it. */
    h2[0] = 0xff;
    for (unsigned b1 = 0; b1 < 256; b1++)
      for (unsigned b2 = 0; b2 < 256; b2++) {
        h2[1]=b1; h2[2]=b2;
        for (unsigned a1 = 0; a1 < 256; a1++)
          for (unsigned a2 = 0; a2 < 256; a2++) {
            h1[0] = (uint8_t)(a1 * 31u + a2 * 7u + b1);
            h1[1]=a1; h1[2]=a2;
            chk(c, r, h1, h2);
          }
      }

    printf("checks=%lld mismatches=%lld\n", checks, mismatches);
    return mismatches ? 1 : 0;
}
EOF
