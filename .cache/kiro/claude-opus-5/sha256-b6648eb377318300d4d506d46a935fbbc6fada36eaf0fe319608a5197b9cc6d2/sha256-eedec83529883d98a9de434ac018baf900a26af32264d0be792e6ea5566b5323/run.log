import os, subprocess
def probe(prog):
    r, w = os.pipe()
    p = subprocess.Popen([prog], stdin=subprocess.PIPE, stdout=w, stderr=subprocess.DEVNULL)
    os.close(w); os.close(r)          # no reader remains -> writes must EPIPE/SIGPIPE
    p.stdin.write(b"a"); p.stdin.close()
    return p.wait()
for prog in ("c_src/build/driver", "translation/target/release/driver"):
    print(prog, "->", probe(prog))
EOF
