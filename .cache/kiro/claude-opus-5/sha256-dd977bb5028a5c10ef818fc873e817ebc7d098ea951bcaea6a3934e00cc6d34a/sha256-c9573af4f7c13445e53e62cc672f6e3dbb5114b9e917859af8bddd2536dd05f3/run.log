[0m[49m[38;5;10m+    375[0m:[38;5;10m[49m                     cr.alloc(&p.c, &mut s),
[0m[49m[38;5;10m+    376[0m:[38;5;10m[49m                     rr.alloc(&p.rs, &mut s2),
[0m[49m[38;5;10m+    377[0m:[38;5;10m[49m                     "round={round} step={step} n={n}"
[0m[49m[38;5;10m+    378[0m:[38;5;10m[49m                 );
[0m[49m[38;5;10m+    379[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    380[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    381[0m:[38;5;10m[49m         unsafe {
[0m[49m[38;5;10m+    382[0m:[38;5;10m[49m             cr.verify_live(&p.c);
[0m[49m[38;5;10m+    383[0m:[38;5;10m[49m             rr.verify_live(&p.rs);
