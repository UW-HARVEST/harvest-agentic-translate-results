from fractions import Fraction
# exact halfway values between consecutive f32, written in full decimal, plus/minus tiny tail
def halfway(k):
    # midpoint between 2^e*(1+m/2^23) and next
    e=rng.randrange(-149,127)
    m=rng.randrange(0,1<<23)
    f=Fraction(2)**e*(1+Fraction(m,1<<23)) if e>=-126 else Fraction(rng.randrange(1,1<<23),1)*Fraction(2)**-149
    nxt=f+Fraction(2)**max(e-23,-149)
    mid=(f+nxt)/2
    # exact decimal of mid (denominator is power of 2)
    num,den=mid.numerator,mid.denominator
    import decimal
    decimal.getcontext().prec=400
    s=str(decimal.Decimal(num)/decimal.Decimal(den))
    return s
