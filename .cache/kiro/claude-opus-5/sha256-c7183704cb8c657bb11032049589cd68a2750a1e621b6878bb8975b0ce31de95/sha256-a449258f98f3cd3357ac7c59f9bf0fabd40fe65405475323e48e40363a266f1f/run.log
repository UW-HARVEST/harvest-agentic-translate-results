def gen(rng):
    k=rng.randrange(9)
    if k==0: return ("%.*g"%(rng.randrange(1,20), rng.uniform(-1e39,1e39))).encode()
    if k==1: return ("%de%d"%(rng.randrange(-10**18,10**18), rng.randrange(-350,350))).encode()
    if k==2: return ("0x%xp%d"%(rng.randrange(0,1<<40), rng.randrange(-200,200))).encode()
    if k==3: return ("0x%x.%xp%d"%(rng.randrange(0,1<<20),rng.randrange(0,1<<20), rng.randrange(-200,200))).encode()
    if k==4:
        alpha=b"0123456789.eE+-xXpPinfaNtY \t\n"
        return bytes(rng.choice(alpha) for _ in range(rng.randrange(0,12)))
    if k==5: return bytes(rng.randrange(1,127) for _ in range(rng.randrange(0,8)))
    if k==6:
        d="".join(rng.choice("0123456789") for _ in range(rng.randrange(1,60)))
        return ("%s.%se%d"%(d,d,rng.randrange(-60,60))).encode()
    if k==7: return rng.choice([b"inf",b"-inf",b"nan",b"infinity",b"NAN",b"-NaN",b"",b" ",b"\n"])
    return ("%.17g"%rng.choice([0.0,-0.0,1.1754943508222875e-38,1.401298464324817e-45,3.4028234663852886e38,7e-46,2**-149*0.5,2**-149*1.5])).encode()
rng=random.Random(int(sys.argv[1]) if len(sys.argv)>1 else 0)
bad=0
