[49m[38;5;10m+      1[0m:[38;5;10m[49m //! Differential test harness: loads BOTH the C `.so` and the Rust `.so` through
[0m[49m[38;5;10m+      2[0m:[38;5;10m[49m //! `libloading` and compares their stdout byte-for-byte.
[0m[49m[38;5;10m+      3[0m:[38;5;10m[49m //!
[0m[49m[38;5;10m+      4[0m:[38;5;10m[49m //! The Rust implementation is NEVER called directly — always through
[0m[49m[38;5;10m+      5[0m:[38;5;10m[49m //! `dlopen`/`dlsym` on `libdriver.so`, exactly as an external C consumer would,
[0m[49m[38;5;10m+      6[0m:[38;5;10m[49m //! so the `#[no_mangle] extern "C"` export wrapper is under test too.
[0m[49m[38;5;10m+      7[0m:[38;5;10m[49m //!
[0m[49m[38;5;10m+      8[0m:[38;5;10m[49m //! Phase B rows come from `CONFIGS.md`, Phase C rows from `ERRORS.md`.
[0m[49m[38;5;10m+      9[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     10[0m:[38;5;10m[49m use std::ffi::c_int;
[0m[49m[38;5;10m+     11[0m:[38;5;10m[49m use std::io::Write;
[0m[49m[38;5;10m+     12[0m:[38;5;10m[49m use std::os::unix::io::AsRawFd;
[0m[49m[38;5;10m+     13[0m:[38;5;10m[49m use std::path::PathBuf;
[0m[49m[38;5;10m+     14[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     15[0m:[38;5;10m[49m use libloading::{Library, Symbol};
[0m[49m[38;5;10m+     16[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     17[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+     18[0m:[38;5;10m[49m // libc bits needed to capture the *C* stdout stream (fd 1).
[0m[49m[38;5;10m+     19[0m:[38;5;10m[49m //
[0m[49m[38;5;10m+     20[0m:[38;5;10m[49m // Both shared objects write through the process-wide libc `stdout`, so the only
[0m[49m[38;5;10m+     21[0m:[38;5;10m[49m // faithful way to capture their output is to redirect file descriptor 1 and
[0m[49m[38;5;10m+     22[0m:[38;5;10m[49m // flush the C streams. `fflush(NULL)` flushes every open output stream, which
[0m[49m[38;5;10m+     23[0m:[38;5;10m[49m // avoids needing the `stdout` global symbol.
[0m[49m[38;5;10m+     24[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+     25[0m:[38;5;10m[49m extern "C" {
[0m[49m[38;5;10m+     26[0m:[38;5;10m[49m     fn dup(oldfd: c_int) -> c_int;
[0m[49m[38;5;10m+     27[0m:[38;5;10m[49m     fn dup2(oldfd: c_int, newfd: c_int) -> c_int;
[0m[49m[38;5;10m+     28[0m:[38;5;10m[49m     fn close(fd: c_int) -> c_int;
[0m[49m[38;5;10m+     29[0m:[38;5;10m[49m     fn fflush(stream: *mut std::ffi::c_void) -> c_int;
[0m[49m[38;5;10m+     30[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     31[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     32[0m:[38;5;10m[49m /// `sizeof(house_t)` — `int floors; int bedrooms; double bathrooms;` on LP64.
[0m[49m[38;5;10m+     33[0m:[38;5;10m[49m const HOUSE_SIZE: usize = 16;
[0m[49m[38;5;10m+     34[0m:[38;5;10m[49m /// One `driver` call prints `2 * sizeof(house_t)` hex digits plus `'\n'`.
[0m[49m[38;5;10m+     35[0m:[38;5;10m[49m const LINE_LEN: usize = HOUSE_SIZE * 2;
[0m[49m[38;5;10m+     36[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     37[0m:[38;5;10m[49m /// Fixed seed so every randomized row is reproducible.
[0m[49m[38;5;10m+     38[0m:[38;5;10m[49m const SEED: u64 = 0x5EED_1234_5678_9ABC;
[0m[49m[38;5;10m+     39[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     40[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+     41[0m:[38;5;10m[49m // Library loading
