     1	//! Minimal declarations of the C standard library entry points used by the
     2	//! original C sources. The translation calls straight through to libc so that
     3	//! allocation, tokenisation, formatting and stdio behaviour (including
     4	//! diagnostics written to `stderr` and `errno` values) are byte-for-byte
     5	//! identical to the C library.
     6	
     7	use core::ffi::{c_char, c_int, c_long, c_void};
     8	
     9	/// Opaque stand-in for C's `FILE`.
    10	#[repr(C)]
    11	pub struct FILE {
    12	    _private: [u8; 0],
    13	}
    14	
    15	unsafe extern "C" {
    16	    pub static mut stderr: *mut FILE;
    17	
    18	    pub fn malloc(size: usize) -> *mut c_void;
    19	    pub fn free(ptr: *mut c_void);
    20	
    21	    pub fn strdup(s: *const c_char) -> *mut c_char;
    22	    pub fn strtok_r(
    23	        s: *mut c_char,
    24	        delim: *const c_char,
    25	        saveptr: *mut *mut c_char,
    26	    ) -> *mut c_char;
    27	    pub fn strerror(errnum: c_int) -> *mut c_char;
    28	    pub fn atoi(s: *const c_char) -> c_int;
    29	
    30	    pub fn perror(s: *const c_char);
    31	    pub fn fprintf(stream: *mut FILE, format: *const c_char, ...) -> c_int;
    32	    pub fn snprintf(str: *mut c_char, size: usize, format: *const c_char, ...) -> c_int;
    33	
    34	    pub fn fopen(path: *const c_char, mode: *const c_char) -> *mut FILE;
    35	    pub fn fclose(stream: *mut FILE) -> c_int;
    36	
    37	    fn __errno_location() -> *mut c_int;
    38	}
    39	
    40	/// `errno` as an rvalue.
    41	#[inline]
    42	pub fn errno() -> c_int {
    43	    unsafe { *__errno_location() }
    44	}
    45	
    46	/// `EINVAL` on Linux.
    47	pub const EINVAL: c_int = 22;
    48	
    49	/// `EXIT_SUCCESS` from `<stdlib.h>`.
    50	pub const EXIT_SUCCESS: c_int = 0;
    51	/// `EXIT_FAILURE` from `<stdlib.h>`.
    52	pub const EXIT_FAILURE: c_int = 1;
    53	
    54	/// `sizeof(int)` as C computes it in `malloc(width * sizeof(int))`.
    55	pub const SIZEOF_INT: usize = core::mem::size_of::<c_int>();
    56	/// `sizeof(int*)` as C computes it in `malloc(height * sizeof(int*))`.
    57	pub const SIZEOF_INT_PTR: usize = core::mem::size_of::<*mut c_int>();
    58	
    59	/// Reproduces C's `n * sizeof(T)`: the (possibly negative) `int` is converted
    60	/// to `size_t` first, then multiplied with wrapping semantics.
    61	#[inline]
    62	pub fn c_size_mul(n: c_int, elem: usize) -> usize {
    63	    (n as c_long as usize).wrapping_mul(elem)
    64	}
    65	
    66	/// `strcat(dst, src)`: append `src` (NUL terminated) at the first NUL of `dst`.
    67	///
    68	/// # Safety
    69	/// Same contract as C's `strcat`.
    70	pub unsafe fn strcat(dst: *mut c_char, src: *const c_char) -> *mut c_char {
    71	    unsafe {
    72	        let mut end = dst;
    73	        while *end != 0 {
    74	            end = end.add(1);
    75	        }
    76	        let mut s = src;
    77	        loop {
    78	            let b = *s;
    79	            *end = b;
    80	            if b == 0 {
    81	                break;
    82	            }
    83	            end = end.add(1);
    84	            s = s.add(1);
    85	        }
    86	        dst
    87	    }
    88	}
