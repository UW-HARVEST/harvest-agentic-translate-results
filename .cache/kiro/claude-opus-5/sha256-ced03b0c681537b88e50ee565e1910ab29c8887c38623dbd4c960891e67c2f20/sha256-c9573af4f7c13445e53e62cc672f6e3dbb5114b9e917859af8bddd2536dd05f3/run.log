    33	matrix_t* allocate_matrix(int width, int height) {
    34	    matrix_t* mat = malloc(sizeof(matrix_t));
    35	    if (mat == NULL) {
    36	        perror("Failed to allocate memory for matrix struct");
    37	        return NULL;
    38	    }
    39	
    40	    mat->width = width;
    41	    mat->height = height;
    42	
    43	    mat->matrix = malloc(height * sizeof(int*));
    44	    if (mat->matrix == NULL) {
    45	        perror("Failed to allocate memory for matrix rows");
    46	        free(mat);
    47	        return NULL;
    48	    }
    49	
    50	    for (int i = 0; i < height; i++) {
    51	        mat->matrix[i] = malloc(width * sizeof(int));
    52	        if (mat->matrix[i] == NULL) {
    53	            perror("Failed to allocate memory for matrix columns");
    54	            for (int j = 0; j <= i; j++) {
    55	                free(mat->matrix[j]);
    56	            }
    57	            free(mat->matrix);
    58	            free(mat);
    59	            return NULL;
    60	        }
    61	    }
    62	
    63	    return mat;
    64	}
    65	
    66	void free_matrix(matrix_t* mat) {
    67	    if (mat == NULL) {
    68	        return;
    69	    }
    70	
    71	    for (int i = 0; i < mat->height; i++) {
    72	        free(mat->matrix[i]);
    73	    }
    74	    free(mat->matrix);
    75	    free(mat);
    76	}
    77	
    78	matrix_t* initialize_matrix_from_string(const char* input, int width, int height) {
    79	    matrix_t* mat = allocate_matrix(width, height);
    80	
    81	    char* input_copy = strdup(input);
    82	    if (input_copy == NULL) {
    83	        perror("Failed to duplicate input string");
    84	        free_matrix(mat);
    85	        return NULL;
    86	    }
    87	
    88	    char* saveptr_row;
    89	    char* row_token = strtok_r(input_copy, "\n", &saveptr_row);
    90	    for (int i = 0; i < height; i++) {
    91	        if (row_token == NULL) {
    92	            fprintf(stderr, "Insufficient rows in input string.\n");
    93	            free(input_copy);
    94	            free_matrix(mat);
    95	            return NULL;
    96	        }
    97	
    98	        char* saveptr_col;
    99	        char* col_token = strtok_r(row_token, " ", &saveptr_col); 
   100	        for (int j = 0; j < width; j++) {
   101	            if (col_token == NULL) {
   102	                fprintf(stderr, "Insufficient columns in row %d.\n", i + 1);
   103	                free(input_copy);
   104	                free_matrix(mat);
   105	                return NULL;
   106	            }
   107	            mat->matrix[i][j] = atoi(col_token);
   108	            col_token = strtok_r(NULL, " ", &saveptr_col);
   109	        }
   110	
   111	        row_token = strtok_r(NULL, "\n", &saveptr_row);
   112	    }
   113	
   114	    free(input_copy);
   115	    return mat;
   116	}
   117	
   118	matrix_t* multiply_matrices(matrix_t* mat_a, matrix_t* mat_b) {
   119	    if (mat_a->width != mat_b->height) {
   120	        fprintf(stderr, "Matrix dimensions do not allow multiplication.\n");
   121	        return NULL;
   122	    }
   123	
   124	    matrix_t* result = allocate_matrix(mat_b->width, mat_a->height);
   125	    for (int i = 0; i < mat_a->height; i++) {
   126	        for (int j = 0; j < mat_b->width; j++) {
   127	            result->matrix[i][j] = 0;
   128	            for (int k = 0; k < mat_a->width; k++) {
   129	                result->matrix[i][j] += mat_a->matrix[i][k] * mat_b->matrix[k][j];
   130	            }
   131	        }
   132	    }
   133	
   134	    return result;
   135	}
   136	
   137	char* matrix_to_string(matrix_t* mat) {
   138	    if (mat == NULL) {
   139	        fprintf(stderr, "Error: Matrix is NULL.\n");
   140	        return NULL;
   141	    }
   142	
   143	    int buffer_size = mat->height * (mat->width * 10 + mat->width) + mat->height + 1;
   144	    char* result = malloc(buffer_size);
   145	    if (result == NULL) {
   146	        perror("Failed to allocate memory for matrix string");
   147	        return NULL;
   148	    }
   149	
   150	    result[0] = '\0';
   151	
   152	    for (int i = 0; i < mat->height; i++) {
   153	        for (int j = 0; j < mat->width; j++) {
   154	            char buffer[12];
   155	            snprintf(buffer, sizeof(buffer), "%d", mat->matrix[i][j]);
   156	            strcat(result, buffer);
   157	
   158	            if (j < mat->width - 1) {
   159	                strcat(result, " ");
   160	            }
   161	        }
   162	        strcat(result, "\n");
   163	    }
   164	
   165	    return result;
   166	}
