     3	use core::ffi::{c_char, c_int, c_void};
     4	
     5	use crate::cstd::{EXIT_FAILURE, EXIT_SUCCESS, free};
     6	use crate::matrix::{free_matrix, initialize_matrix_from_string, matrix_to_string, multiply_matrices};
     7	use crate::write::write_to_file;
     8	
     9	/// `#define OUT_FILE "matrix.txt"`
    10	const OUT_FILE: &core::ffi::CStr = c"matrix.txt";
    11	
    12	#[unsafe(no_mangle)]
    13	pub unsafe extern "C" fn driver(
    14	    width_a: c_int,
    15	    height_a: c_int,
    16	    matrix_a: *const c_char,
    17	    width_b: c_int,
    18	    height_b: c_int,
    19	    matrix_b: *const c_char,
    20	) -> c_int {
    21	    unsafe {
    22	        let mat_a = initialize_matrix_from_string(matrix_a, width_a, height_a);
    23	        if mat_a.is_null() {
    24	            return EXIT_FAILURE;
    25	        }
    26	        let mat_b = initialize_matrix_from_string(matrix_b, width_b, height_b);
    27	        if mat_b.is_null() {
    28	            free_matrix(mat_a);
    29	            return EXIT_FAILURE;
    30	        }
    31	
    32	        let res = multiply_matrices(mat_a, mat_b);
    33	        if res.is_null() {
    34	            free_matrix(mat_a);
    35	            free_matrix(mat_b);
    36	            return EXIT_FAILURE;
    37	        }
    38	        let res_str = matrix_to_string(res);
    39	        if res_str.is_null() {
    40	            free_matrix(mat_a);
    41	            free_matrix(mat_b);
    42	            // The C code frees only the struct here (matching it exactly).
    43	            free(res as *mut c_void);
    44	            return EXIT_FAILURE;
    45	        }
    46	
    47	        let res_write = write_to_file(OUT_FILE.as_ptr(), res_str);
    48	
    49	        free_matrix(mat_a);
    50	        free_matrix(mat_b);
    51	        free_matrix(res);
    52	        free(res_str as *mut c_void);
    53	
    54	        if res_write != 0 {
    55	            return EXIT_FAILURE;
    56	        }
    57	
    58	        EXIT_SUCCESS
    59	    }
    60	}
