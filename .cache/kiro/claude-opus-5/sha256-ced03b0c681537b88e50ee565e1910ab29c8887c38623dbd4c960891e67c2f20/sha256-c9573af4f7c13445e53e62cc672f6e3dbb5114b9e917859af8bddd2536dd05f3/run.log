     1	//! Translation of `c_src/src/write.c`.
     2	//!
     3	//! Note the C parameter is named `content` in the definition (`contents` in the
     4	//! header); only the type signature matters across the ABI.
     5	
     6	use core::ffi::{c_char, c_int};
     7	
     8	use crate::cstd::{self, EINVAL, errno, fclose, fopen, stderr, strerror};
     9	
    10	#[unsafe(no_mangle)]
    11	pub unsafe extern "C" fn write_to_file(filename: *const c_char, content: *const c_char) -> c_int {
    12	    unsafe {
    13	        if content.is_null() {
    14	            cstd::fprintf(stderr, c"Error: Content is NULL.\n".as_ptr());
    15	            return EINVAL;
    16	        }
    17	
    18	        let file = fopen(filename, c"w".as_ptr());
    19	        if file.is_null() {
    20	            cstd::fprintf(
    21	                stderr,
    22	                c"Error opening file '%s': %s\n".as_ptr(),
    23	                filename,
    24	                strerror(errno()),
    25	            );
    26	            return errno();
    27	        }
    28	
    29	        if cstd::fprintf(file, c"%s".as_ptr(), content) < 0 {
    30	            cstd::fprintf(
    31	                stderr,
    32	                c"Error writing to file '%s': %s\n".as_ptr(),
    33	                filename,
    34	                strerror(errno()),
    35	            );
    36	            fclose(file);
    37	            return errno();
    38	        }
    39	
    40	        if fclose(file) != 0 {
    41	            cstd::fprintf(
    42	                stderr,
    43	                c"Error closing file '%s': %s\n".as_ptr(),
    44	                filename,
    45	                strerror(errno()),
    46	            );
    47	            return errno();
    48	        }
    49	
    50	        0
    51	    }
    52	}
