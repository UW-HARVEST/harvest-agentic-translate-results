    81	#[unsafe(no_mangle)]
    82	pub unsafe extern "C" fn initialize_matrix_from_string(
    83	    input: *const c_char,
    84	    width: c_int,
    85	    height: c_int,
    86	) -> *mut matrix_t {
    87	    unsafe {
    88	        // The C code deliberately does not check `mat` for NULL here.
    89	        let mat = allocate_matrix(width, height);
    90	
    91	        let input_copy = strdup(input);
    92	        if input_copy.is_null() {
    93	            perror(c"Failed to duplicate input string".as_ptr());
    94	            free_matrix(mat);
    95	            return ptr::null_mut();
    96	        }
    97	
    98	        let mut saveptr_row: *mut c_char = ptr::null_mut();
    99	        let mut row_token = strtok_r(input_copy, c"\n".as_ptr(), &mut saveptr_row);
   100	
   101	        let mut i: c_int = 0;
   102	        while i < height {
   103	            if row_token.is_null() {
   104	                cstd::fprintf(stderr, c"Insufficient rows in input string.\n".as_ptr());
   105	                free(input_copy as *mut c_void);
   106	                free_matrix(mat);
   107	                return ptr::null_mut();
   108	            }
   109	
   110	            let mut saveptr_col: *mut c_char = ptr::null_mut();
   111	            let mut col_token = strtok_r(row_token, c" ".as_ptr(), &mut saveptr_col);
   112	
   113	            let mut j: c_int = 0;
   114	            while j < width {
   115	                if col_token.is_null() {
   116	                    cstd::fprintf(
   117	                        stderr,
   118	                        c"Insufficient columns in row %d.\n".as_ptr(),
   119	                        i + 1,
   120	                    );
   121	                    free(input_copy as *mut c_void);
   122	                    free_matrix(mat);
   123	                    return ptr::null_mut();
   124	                }
   125	                let row = *(*mat).matrix.offset(i as isize);
   126	                *row.offset(j as isize) = atoi(col_token);
   127	                col_token = strtok_r(ptr::null_mut(), c" ".as_ptr(), &mut saveptr_col);
   128	                j += 1;
   129	            }
   130	
   131	            row_token = strtok_r(ptr::null_mut(), c"\n".as_ptr(), &mut saveptr_row);
   132	            i += 1;
   133	        }
   134	
   135	        free(input_copy as *mut c_void);
   136	        mat
   137	    }
   138	}
   139	
   140	#[unsafe(no_mangle)]
   141	pub unsafe extern "C" fn multiply_matrices(
   142	    mat_a: *mut matrix_t,
   143	    mat_b: *mut matrix_t,
   144	) -> *mut matrix_t {
   145	    unsafe {
   146	        if (*mat_a).width != (*mat_b).height {
   147	            cstd::fprintf(
   148	                stderr,
   149	                c"Matrix dimensions do not allow multiplication.\n".as_ptr(),
   150	            );
   151	            return ptr::null_mut();
   152	        }
   153	
   154	        // The C code does not check `result` for NULL.
   155	        let result = allocate_matrix((*mat_b).width, (*mat_a).height);
   156	
   157	        let mut i: c_int = 0;
   158	        while i < (*mat_a).height {
   159	            let mut j: c_int = 0;
   160	            while j < (*mat_b).width {
   161	                let res_row = *(*result).matrix.offset(i as isize);
   162	                *res_row.offset(j as isize) = 0;
   163	                let mut k: c_int = 0;
   164	                while k < (*mat_a).width {
   165	                    let a = *(*(*mat_a).matrix.offset(i as isize)).offset(k as isize);
   166	                    let b = *(*(*mat_b).matrix.offset(k as isize)).offset(j as isize);
   167	                    let cur = *res_row.offset(j as isize);
   168	                    *res_row.offset(j as isize) = cur.wrapping_add(a.wrapping_mul(b));
   169	                    k += 1;
   170	                }
   171	                j += 1;
   172	            }
   173	            i += 1;
   174	        }
   175	
   176	        result
   177	    }
   178	}
   179	
   180	#[unsafe(no_mangle)]
   181	pub unsafe extern "C" fn matrix_to_string(mat: *mut matrix_t) -> *mut c_char {
   182	    unsafe {
   183	        if mat.is_null() {
   184	            cstd::fprintf(stderr, c"Error: Matrix is NULL.\n".as_ptr());
   185	            return ptr::null_mut();
   186	        }
   187	
   188	        let width = (*mat).width;
   189	        let height = (*mat).height;
   190	
   191	        // int arithmetic, wrapping like gcc: height * (width * 10 + width) + height + 1
   192	        let buffer_size = height
   193	            .wrapping_mul(width.wrapping_mul(10).wrapping_add(width))
   194	            .wrapping_add(height)
   195	            .wrapping_add(1);
   196	
   197	        let result = malloc(c_size_mul(buffer_size, 1)) as *mut c_char;
   198	        if result.is_null() {
   199	            perror(c"Failed to allocate memory for matrix string".as_ptr());
   200	            return ptr::null_mut();
   201	        }
   202	
   203	        *result = 0;
   204	
   205	        let mut i: c_int = 0;
   206	        while i < height {
   207	            let mut j: c_int = 0;
   208	            while j < width {
   209	                let mut buffer = [0 as c_char; 12];
   210	                let value = *(*(*mat).matrix.offset(i as isize)).offset(j as isize);
   211	                snprintf(buffer.as_mut_ptr(), buffer.len(), c"%d".as_ptr(), value);
   212	                cstd::strcat(result, buffer.as_ptr());
   213	
   214	                if j < width.wrapping_sub(1) {
   215	                    cstd::strcat(result, c" ".as_ptr());
   216	                }
   217	                j += 1;
   218	            }
   219	            cstd::strcat(result, c"\n".as_ptr());
   220	            i += 1;
   221	        }
   222	
   223	        result
   224	    }
   225	}
