import re
h=open('c_src/src/stb_perlin.h').read()
def cnums(name, text):
    i=text.index('unsigned char '+name)
    b=text.index('{',i); e=text.index('};',b)
    body=text[b+1:e]
    body=re.sub(r'//.*','',body)
    return [int(x) for x in re.findall(r'\d+',body)]
r=cnums('stb__perlin_randtab',h)
