static unsigned bits(float f){unsigned u;memcpy(&u,&f,4);return u;}
static float mk(unsigned u){float f;memcpy(&f,&u,4);return f;}
int main(){
  volatile float zero=0.0f, inf=1.0f/0.0f;
  float ind = zero*inf;           /* x86 indefinite: 0xffc00000 */
  float pn  = mk(0x7fc00000);
  printf("ind=%08x pn=%08x\n", bits(ind), bits(pn));
  volatile float A=ind, B=pn;
  printf("A+B=%08x B+A=%08x A-B=%08x B-A=%08x A*B=%08x B*A=%08x\n",
    bits(A+B), bits(B+A), bits(A-B), bits(B-A), bits(A*B), bits(B*A));
  /* lerp(a,b,t) = a + (b-a)*t */
  printf("lerp(A,B,1)=%08x lerp(B,A,1)=%08x\n", bits(A+(B-A)*1.0f), bits(B+(A-B)*1.0f));
  /* grad: g0*x + g1*y + g2*z with x=inf, y=0, z=pn, g={0,1,1} */
  volatile float x=inf, y=0.0f, z=pn;
  printf("g011=%08x\n", bits(0.0f*x + 1.0f*y + 1.0f*z));
  printf("g100=%08x\n", bits(1.0f*x + 0.0f*y + 0.0f*z));
  return 0;
}
EOF
