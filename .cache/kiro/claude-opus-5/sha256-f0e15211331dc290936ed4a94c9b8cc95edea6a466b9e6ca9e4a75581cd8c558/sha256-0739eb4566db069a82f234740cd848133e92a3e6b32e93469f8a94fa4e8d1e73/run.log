def grab(name):
    i=src.index('static unsigned char %s[512] ='%name)
    j=src.index('{',i); k=src.index('};',j)
    body=src[j+1:k]
    body=re.sub(r'//[^\n]*','',body)
    nums=[int(t) for t in re.findall(r'\d+',body)]
    assert len(nums)==512,(name,len(nums))
    return nums
def emit(name,nums):
    lines=[]
    for i in range(0,512,16):
        lines.append('    '+', '.join(str(n) for n in nums[i:i+16])+',')
    return 'pub static %s: [u8; 512] = [\n%s\n];\n'%(name,'\n'.join(lines))
