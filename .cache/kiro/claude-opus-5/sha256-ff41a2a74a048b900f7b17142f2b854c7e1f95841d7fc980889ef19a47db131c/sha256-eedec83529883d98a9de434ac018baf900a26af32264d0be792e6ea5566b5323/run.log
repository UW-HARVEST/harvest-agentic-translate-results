[0m[49m[38;5;10m+    295[0m:[38;5;10m[49m fn scanf_skips_whitespace_across_newlines() {
[0m[49m[38;5;10m+    296[0m:[38;5;10m[49m     // fgets would stop at the first newline; scanf does not. This is the
