[0m[49m[38;5;10m+     30[0m:[38;5;10m[49m COMBOS=("" "--no-default-features" "--all-features")
[0m[49m[38;5;10m+     31[0m:[38;5;10m[49m if [ -n "$FEATURES" ]; then
[0m[49m[38;5;10m+     32[0m:[38;5;10m[49m   # Power set of the declared features.
