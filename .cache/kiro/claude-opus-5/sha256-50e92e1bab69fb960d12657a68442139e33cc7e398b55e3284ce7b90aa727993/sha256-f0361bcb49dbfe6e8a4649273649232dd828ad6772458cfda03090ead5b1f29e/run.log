/* Place the subject flush against an unmapped guard page: any read past
   end_subject faults, proving whether the C library reads out of bounds. */
#include <stdio.h>
#include <string.h>
#include <sys/mman.h>
#include <unistd.h>
#define PCRE2_CODE_UNIT_WIDTH 8
#include "pcre2.h"

int main(int argc, char **argv){
  long ps = sysconf(_SC_PAGESIZE);
  unsigned char *base = mmap(NULL, 2*ps, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0);
  if (base == MAP_FAILED) { perror("mmap"); return 2; }
  mprotect(base + ps, ps, PROT_NONE);          /* guard page */
  unsigned char *subj = base + ps - 2;          /* 2 bytes, then guard */
  subj[0] = 0xf4; subj[1] = 0x19;

  const char *pat = argc > 1 ? argv[1] : "(?<!\\P{L}b?)";
  int e; PCRE2_SIZE eo;
  pcre2_code *re = pcre2_compile((PCRE2_SPTR)pat, strlen(pat),
                                 PCRE2_MATCH_INVALID_UTF, &e, &eo, NULL);
  if(!re){ printf("compile fail %d at %zu\n", e, eo); return 1; }
  pcre2_match_data *md = pcre2_match_data_create(1, NULL);
  printf("calling pcre2_match with subject flush against guard page...\n");
  fflush(stdout);
  int rc = pcre2_match(re, (PCRE2_SPTR)subj, 2, 0, PCRE2_NOTEMPTY_ATSTART, md, NULL);
  printf("returned rc=%d (no fault => no read past end_subject)\n", rc);
  pcre2_match_data_free(md); pcre2_code_free(re);
  return 0;
}
EOF
