[package]
name = "pcre2"
version = "10.48.0"
edition = "2024"

[lib]
name = "pcre2"
crate-type = ["cdylib"]
path = "src/lib.rs"

[profile.release]
panic = "abort"
overflow-checks = false
debug-assertions = false

[workspace]
===CMAKE===
cmake_minimum_required(VERSION 3.10)
project(pcre2 C)
set(CMAKE_C_STANDARD 99)

file(GLOB PCRE2_SOURCES "src/*.c")

add_library(pcre2 SHARED ${PCRE2_SOURCES})

target_include_directories(pcre2
    PUBLIC include
    PRIVATE src
)

target_compile_definitions(pcre2 PRIVATE
    HAVE_CONFIG_H
    PCRE2_CODE_UNIT_WIDTH=8
    SUPPORT_UNICODE
)

target_compile_options(pcre2 PRIVATE -w)

# Output the shared library to the build directory root (expected by the runner)
set_target_properties(pcre2 PROPERTIES
    LIBRARY_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}"
    PREFIX "lib"
)
===check_syms===
#!/bin/bash
# Compare the exported symbol set of the C build with the Rust cdylib.
set -u
C_SO=/tmp/pcre2cbuild/libpcre2.so
R_SO="$(dirname "$0")/target/release/libpcre2.so"

nm -D --defined-only "$C_SO" | awk '$2 ~ /^[TDRBW]$/ {print $3}' | sort -u > /tmp/c_syms.txt
nm -D --defined-only "$R_SO" | awk '$2 ~ /^[TDRBW]$/ {print $3}' | sort -u > /tmp/r_syms.txt

echo "C exports: $(wc -l < /tmp/c_syms.txt)   Rust exports: $(wc -l < /tmp/r_syms.txt)"
echo
echo "=== MISSING from Rust ($(comm -23 /tmp/c_syms.txt /tmp/r_syms.txt | wc -l)) ==="
comm -23 /tmp/c_syms.txt /tmp/r_syms.txt
