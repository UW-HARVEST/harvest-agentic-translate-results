[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m /// C2 — a single set bit walked through every bit of every byte.
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m fn cfg02_single_bit_set() {
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m     assert_same_many((0..32).map(|k| (1u32 << k) as i32), "C2");
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m /// C3 — a single cleared bit (complement of C2).
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m fn cfg03_single_bit_clear() {
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m     assert_same_many((0..32).map(|k| !(1u32 << k) as i32), "C3");
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m /// C4 — every one of the 256 byte values in byte 0, incl. all 16 values
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m /// below 0x10 that require `%02x`'s leading zero.
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m fn cfg04_every_byte_value_in_byte0() {
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m     assert_same_many((0u32..=0xff).map(|b| b as i32), "C4");
[0m[49m[38;5;10m+    259[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m /// C5 — every byte value in every byte *position*, so a wrong index or stride
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m /// in the loop is visible.
[0m[49m[38;5;10m+    263[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    264[0m:[38;5;10m[49m fn cfg05_every_byte_value_in_every_position() {
[0m[49m[38;5;10m+    265[0m:[38;5;10m[49m     for shift in [8u32, 16, 24] {
[0m[49m[38;5;10m+    266[0m:[38;5;10m[49m         assert_same_many((0u32..=0xff).map(|b| (b << shift) as i32), "C5");
[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m /// C6 — randomized positive values.
[0m[49m[38;5;10m+    271[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    272[0m:[38;5;10m[49m fn cfg06_random_positive() {
[0m[49m[38;5;10m+    273[0m:[38;5;10m[49m     let mut rng = Rng::new(0xC0FFEE_1234_5678);
[0m[49m[38;5;10m+    274[0m:[38;5;10m[49m     assert_same_many(
[0m[49m[38;5;10m+    275[0m:[38;5;10m[49m         (0..4096).map(|_| (rng.next_u64() as u32 & 0x7fff_ffff) as i32),
[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m         "C6",
[0m[49m[38;5;10m+    277[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    278[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    279[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    280[0m:[38;5;10m[49m /// C7 — randomized negative values (sign bit set).
[0m[49m[38;5;10m+    281[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    282[0m:[38;5;10m[49m fn cfg07_random_negative() {
[0m[49m[38;5;10m+    283[0m:[38;5;10m[49m     let mut rng = Rng::new(0xDEAD_BEEF_CAFE_0001);
[0m[49m[38;5;10m+    284[0m:[38;5;10m[49m     assert_same_many(
[0m[49m[38;5;10m+    285[0m:[38;5;10m[49m         (0..4096).map(|_| ((rng.next_u64() as u32) | 0x8000_0000) as i32),
[0m[49m[38;5;10m+    286[0m:[38;5;10m[49m         "C7",
[0m[49m[38;5;10m+    287[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    288[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    289[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    290[0m:[38;5;10m[49m /// C8 — unconstrained property test over all 2^32 bit patterns.
[0m[49m[38;5;10m+    291[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    292[0m:[38;5;10m[49m fn cfg08_random_full_range() {
[0m[49m[38;5;10m+    293[0m:[38;5;10m[49m     let mut rng = Rng::new(0x5EED_0000_0000_0042);
[0m[49m[38;5;10m+    294[0m:[38;5;10m[49m     assert_same_many((0..8192).map(|_| rng.next_i32()), "C8");
[0m[49m[38;5;10m+    295[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    296[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    297[0m:[38;5;10m[49m /// C9 — the hand-picked boundary values.
[0m[49m[38;5;10m+    298[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    299[0m:[38;5;10m[49m fn cfg09_boundaries() {
[0m[49m[38;5;10m+    300[0m:[38;5;10m[49m     assert_same_many(BOUNDARIES.iter().copied(), "C9");
[0m[49m[38;5;10m+    301[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    302[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    303[0m:[38;5;10m[49m /// C10 — byte-order sensitivity: feed `x` and its byte-swap. If the Rust loop
[0m[49m[38;5;10m+    304[0m:[38;5;10m[49m /// walked the object representation in the opposite direction, `driver(x)` in
[0m[49m[38;5;10m+    305[0m:[38;5;10m[49m /// Rust would equal `driver(bswap(x))` in C, which this catches.
[0m[49m[38;5;10m+    306[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    307[0m:[38;5;10m[49m fn cfg10_byte_order_pairs() {
[0m[49m[38;5;10m+    308[0m:[38;5;10m[49m     let mut rng = Rng::new(0xB5_0000_0000_AA55);
[0m[49m[38;5;10m+    309[0m:[38;5;10m[49m     for _ in 0..1024 {
[0m[49m[38;5;10m+    310[0m:[38;5;10m[49m         let x = rng.next_i32();
[0m[49m[38;5;10m+    311[0m:[38;5;10m[49m         let s = (x as u32).swap_bytes() as i32;
[0m[49m[38;5;10m+    312[0m:[38;5;10m[49m         assert_same(x, "C10");
[0m[49m[38;5;10m+    313[0m:[38;5;10m[49m         assert_same(s, "C10");
[0m[49m[38;5;10m+    314[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    315[0m:[38;5;10m[49m         // Asymmetric bit patterns must produce different output for x and its
[0m[49m[38;5;10m+    316[0m:[38;5;10m[49m         // byte-swap; otherwise the direction check above would be vacuous.
[0m[49m[38;5;10m+    317[0m:[38;5;10m[49m         if (x as u32).swap_bytes() != x as u32 {
[0m[49m[38;5;10m+    318[0m:[38;5;10m[49m             let (cx, _) = both(x);
[0m[49m[38;5;10m+    319[0m:[38;5;10m[49m             let (cs, _) = both(s);
[0m[49m[38;5;10m+    320[0m:[38;5;10m[49m             assert_ne!(
[0m[49m[38;5;10m+    321[0m:[38;5;10m[49m                 cx, cs,
[0m[49m[38;5;10m+    322[0m:[38;5;10m[49m                 "C10: byte-swapped inputs {x:#010x}/{s:#010x} produced identical output, \
[0m[49m[38;5;10m+    323[0m:[38;5;10m[49m                  so this row cannot detect a reversed traversal"
[0m[49m[38;5;10m+    324[0m:[38;5;10m[49m             );
[0m[49m[38;5;10m+    325[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    326[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    327[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    328[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    329[0m:[38;5;10m[49m /// C11 — call-count shape: zero calls, one call, then many consecutive calls
[0m[49m[38;5;10m+    330[0m:[38;5;10m[49m /// against the same loaded handle.
[0m[49m[38;5;10m+    331[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    332[0m:[38;5;10m[49m fn cfg11_zero_one_many_calls() {
[0m[49m[38;5;10m+    333[0m:[38;5;10m[49m     let cd = c_driver();
[0m[49m[38;5;10m+    334[0m:[38;5;10m[49m     let rd = rust_driver();
[0m[49m[38;5;10m+    335[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    336[0m:[38;5;10m[49m     // zero calls: both must emit nothing at all
[0m[49m[38;5;10m+    337[0m:[38;5;10m[49m     let ((), c0) = capture(|| {});
[0m[49m[38;5;10m+    338[0m:[38;5;10m[49m     let ((), r0) = capture(|| {});
[0m[49m[38;5;10m+    339[0m:[38;5;10m[49m     assert_eq!(c0, r0, "C11: empty capture mismatch");
[0m[49m[38;5;10m+    340[0m:[38;5;10m[49m     assert!(c0.is_empty(), "C11: empty capture was not empty");
[0m[49m[38;5;10m+    341[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    342[0m:[38;5;10m[49m     // one call
[0m[49m[38;5;10m+    343[0m:[38;5;10m[49m     assert_same(0x1234_5678, "C11/one");
[0m[49m[38;5;10m+    344[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    345[0m:[38;5;10m[49m     // many calls without reloading — catches any hidden per-library state
[0m[49m[38;5;10m+    346[0m:[38;5;10m[49m     let mut rng = Rng::new(0x11_2233_4455_6677);
[0m[49m[38;5;10m+    347[0m:[38;5;10m[49m     let xs: Vec<i32> = (0..256).map(|_| rng.next_i32()).collect();
[0m[49m[38;5;10m+    348[0m:[38;5;10m[49m     let ((), c_many) = capture(|| unsafe {
[0m[49m[38;5;10m+    349[0m:[38;5;10m[49m         for &x in &xs {
[0m[49m[38;5;10m+    350[0m:[38;5;10m[49m             cd(x);
[0m[49m[38;5;10m+    351[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    352[0m:[38;5;10m[49m     });
[0m[49m[38;5;10m+    353[0m:[38;5;10m[49m     let ((), r_many) = capture(|| unsafe {
[0m[49m[38;5;10m+    354[0m:[38;5;10m[49m         for &x in &xs {
[0m[49m[38;5;10m+    355[0m:[38;5;10m[49m             rd(x);
[0m[49m[38;5;10m+    356[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    357[0m:[38;5;10m[49m     });
[0m[49m[38;5;10m+    358[0m:[38;5;10m[49m     assert_eq!(c_many, r_many, "C11: 256 consecutive calls diverged");
[0m[49m[38;5;10m+    359[0m:[38;5;10m[49m     assert_eq!(
[0m[49m[38;5;10m+    360[0m:[38;5;10m[49m         c_many.len(),
[0m[49m[38;5;10m+    361[0m:[38;5;10m[49m         256 * 9,
[0m[49m[38;5;10m+    362[0m:[38;5;10m[49m         "C11: expected 9 bytes (8 hex + newline) per call"
[0m[49m[38;5;10m+    363[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    364[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    365[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    366[0m:[38;5;10m[49m /// C12 — interleaving and ordering: alternate the two libraries inside one
[0m[49m[38;5;10m+    367[0m:[38;5;10m[49m /// captured stream, both C-first and Rust-first.
[0m[49m[38;5;10m+    368[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    369[0m:[38;5;10m[49m fn cfg12_interleaved_and_reversed_order() {
[0m[49m[38;5;10m+    370[0m:[38;5;10m[49m     let cd = c_driver();
[0m[49m[38;5;10m+    371[0m:[38;5;10m[49m     let rd = rust_driver();
[0m[49m[38;5;10m+    372[0m:[38;5;10m[49m     let mut rng = Rng::new(0x0FED_CBA9_8765_4321);
[0m[49m[38;5;10m+    373[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    374[0m:[38;5;10m[49m     for _ in 0..256 {
[0m[49m[38;5;10m+    375[0m:[38;5;10m[49m         let x = rng.next_i32();
[0m[49m[38;5;10m+    376[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    377[0m:[38;5;10m[49m         // C then Rust in one stream: the two halves must be identical.
[0m[49m[38;5;10m+    378[0m:[38;5;10m[49m         let ((), cr) = capture(|| unsafe {
[0m[49m[38;5;10m+    379[0m:[38;5;10m[49m             cd(x);
[0m[49m[38;5;10m+    380[0m:[38;5;10m[49m             rd(x);
[0m[49m[38;5;10m+    381[0m:[38;5;10m[49m         });
[0m[49m[38;5;10m+    382[0m:[38;5;10m[49m         // Rust then C in one stream.
[0m[49m[38;5;10m+    383[0m:[38;5;10m[49m         let ((), rc) = capture(|| unsafe {
[0m[49m[38;5;10m+    384[0m:[38;5;10m[49m             rd(x);
[0m[49m[38;5;10m+    385[0m:[38;5;10m[49m             cd(x);
[0m[49m[38;5;10m+    386[0m:[38;5;10m[49m         });
[0m[49m[38;5;10m+    387[0m:[38;5;10m[49m         assert_eq!(cr, rc, "C12: output depends on call order for {x:#010x}");
[0m[49m[38;5;10m+    388[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    389[0m:[38;5;10m[49m         let half = cr.len() / 2;
[0m[49m[38;5;10m+    390[0m:[38;5;10m[49m         assert_eq!(cr.len() % 2, 0, "C12: odd-length interleaved output");
[0m[49m[38;5;10m+    391[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    392[0m:[38;5;10m[49m             &cr[..half],
[0m[49m[38;5;10m+    393[0m:[38;5;10m[49m             &cr[half..],
[0m[49m[38;5;10m+    394[0m:[38;5;10m[49m             "C12: C and Rust halves differ for {x:#010x}"
[0m[49m[38;5;10m+    395[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    396[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    397[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    398[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    399[0m:[38;5;10m[49m /// C13 — both `.so`s resident in one process, driven through the same fd 1.
[0m[49m[38;5;10m+    400[0m:[38;5;10m[49m /// This is the condition every other row already runs under; assert it
[0m[49m[38;5;10m+    401[0m:[38;5;10m[49m /// explicitly, including that the two handles are genuinely distinct objects.
[0m[49m[38;5;10m+    402[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    403[0m:[38;5;10m[49m fn cfg13_both_libraries_resident_same_process() {
[0m[49m[38;5;10m+    404[0m:[38;5;10m[49m     let cd = c_driver();
[0m[49m[38;5;10m+    405[0m:[38;5;10m[49m     let rd = rust_driver();
[0m[49m[38;5;10m+    406[0m:[38;5;10m[49m     let c_addr = *cd as usize;
[0m[49m[38;5;10m+    407[0m:[38;5;10m[49m     let r_addr = *rd as usize;
[0m[49m[38;5;10m+    408[0m:[38;5;10m[49m     assert_ne!(
[0m[49m[38;5;10m+    409[0m:[38;5;10m[49m         c_addr, r_addr,
[0m[49m[38;5;10m+    410[0m:[38;5;10m[49m         "C13: C and Rust `driver` resolved to the same address — only one \
[0m[49m[38;5;10m+    411[0m:[38;5;10m[49m          library is actually loaded, so no differential testing is happening"
[0m[49m[38;5;10m+    412[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    413[0m:[38;5;10m[49m     assert_same(0x0BAD_F00Du32 as i32, "C13");
[0m[49m[38;5;10m+    414[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    415[0m:[38;5;10m[49m 
