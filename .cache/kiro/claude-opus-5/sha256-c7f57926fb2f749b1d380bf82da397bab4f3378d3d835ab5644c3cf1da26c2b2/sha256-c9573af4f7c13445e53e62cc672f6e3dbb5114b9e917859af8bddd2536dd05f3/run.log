[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m     0x0102_0304u32 as i32,
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m     0x0403_0201u32 as i32,
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m     0x1000_0000u32 as i32,
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m     0x0000_000fu32 as i32,
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m ];
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m // PHASE B — valid-path differential tests, one per CONFIGS.md row
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m 
