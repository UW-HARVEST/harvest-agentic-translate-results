[0m[49m[38;5;10m+    160[0m:[38;5;10m[49m     assert_identical("long max overflow with y", b"99999999999999999999999 5");
[0m[49m[38;5;10m+    161[0m:[38;5;10m[49m     // < LONG_MIN -> LONG_MIN -> (int) 0
