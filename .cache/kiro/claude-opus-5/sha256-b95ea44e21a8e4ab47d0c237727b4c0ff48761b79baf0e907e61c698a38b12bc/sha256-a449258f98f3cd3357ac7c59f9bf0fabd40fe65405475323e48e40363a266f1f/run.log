import random, subprocess, sys, os
C,R,D = sys.argv[1:4]
random.seed(1234)
LIMIT=1<<21
def cap(prog, data):
    p = subprocess.Popen([prog], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    try:
        p.stdin.write(data); p.stdin.close()
    except BrokenPipeError:
        pass
    out=b''
    while len(out) < LIMIT:
        c = p.stdout.read(65536)
        if not c: break
        out += c
    truncated = len(out) >= LIMIT
    if truncated:
        p.kill()
    p.wait()
    err = p.stderr.read()
    return out[:LIMIT], err, (None if truncated else p.returncode)

cases=[]
for _ in range(250):
    x = random.choice([random.randint(-10,60), random.randint(-3,3), random.randint(0,200),
                       random.choice([2147483647,-2147483648,2147483648,4294967296,99999999999999999999999])])
    y = random.choice([random.randint(-10,60), random.randint(0,200), random.randint(-3,3),
                       random.choice([0,1,4,2147483647,-2147483648,4294967297])])
    sep = random.choice([b' ', b'\n', b'\t', b'  \n\t ', b'\r\n', b'\v', b'\f', b''])
    pre = random.choice([b'', b' ', b'\n\n', b'\t'])
    post = random.choice([b'', b'\n', b' junk', b'\x00', b'  '])
    s = pre + str(x).encode() + sep + str(y).encode() + post
    if sep == b'' and y >= 0:  # "5" + "3" would glue into one number; still valid input
        pass
    cases.append(s)
for _ in range(60):
    n = random.randint(0,12)
    cases.append(bytes(random.choice(b'0123456789 +-\n\tabcXx.\x00') for _ in range(n)))
cases += [b'', b'\x00', b'0 0', b'1 4']

bad=0
for s in cases:
    a = cap(C, s); b = cap(R, s)
    if a != b:
        bad += 1
        print("DIFF", s[:60], "\n C:", a[2], len(a[0]), a[0][:80], a[1][:40],
              "\n R:", b[2], len(b[0]), b[0][:80], b[1][:40])
        if bad > 5: break
print(f"fuzz cases={len(cases)} diffs={bad}")
