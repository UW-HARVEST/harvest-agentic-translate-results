[0m[49m[38;5;10m+    148[0m:[38;5;10m[49m     // 2^32 -> (int) 0 for both fields.
[0m[49m[38;5;10m+    149[0m:[38;5;10m[49m     assert_identical("2^32 twice", b"4294967296 4294967296");
[0m[49m[38;5;10m+    150[0m:[38;5;10m[49m     // -(2^32 - 1) -> (int) 1, and 2^32 -> (int) 0: this run prints output, so
[0m[49m[38;5;10m+    151[0m:[38;5;10m[49m     // it distinguishes truncation from clamping.
[0m[49m[38;5;10m+    152[0m:[38;5;10m[49m     assert_identical("neg 2^32-1", b"-4294967295 4294967296");
[0m[49m[38;5;10m+    153[0m:[38;5;10m[49m     assert_identical("2^32+1", b"4294967297 0");
[0m[49m[38;5;10m+    154[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    155[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    156[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    157[0m:[38;5;10m[49m fn values_beyond_long_range_saturate_then_truncate() {
[0m[49m[38;5;10m+    158[0m:[38;5;10m[49m     // > LONG_MAX -> LONG_MAX -> (int) -1
