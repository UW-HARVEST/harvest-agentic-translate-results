[0m[49m[38;5;10m+    143[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    144[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    145[0m:[38;5;10m[49m fn values_above_int_range_are_truncated_to_int() {
[0m[49m[38;5;10m+    146[0m:[38;5;10m[49m     // 2^31 -> (int) -2147483648, so the loop is never entered.
