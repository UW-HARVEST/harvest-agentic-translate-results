[0m[49m[38;5;10m+    163[0m:[38;5;10m[49m     assert_identical("long min overflow with y", b"-99999999999999999999999 7");
[0m[49m[38;5;10m+    164[0m:[38;5;10m[49m     // A digit string long enough to rule out any small fixed-size accumulator.
