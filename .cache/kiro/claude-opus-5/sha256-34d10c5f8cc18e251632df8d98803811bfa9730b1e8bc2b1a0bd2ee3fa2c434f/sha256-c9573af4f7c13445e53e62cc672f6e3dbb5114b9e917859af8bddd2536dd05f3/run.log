p='src/lib.rs'; s=open(p).read()

# 1. eq_op on the faithful `d != d` NaN test
old = """#[unsafe(no_mangle)]
pub extern "C" fn safe_double_to_int(d: c_double) -> c_int {"""
new = """#[unsafe(no_mangle)]
// `d != d` is kept verbatim from `lib.c:82` rather than rewritten to
// `d.is_nan()`; the two are identical in codegen and the literal form preserves
// the line-by-line correspondence with the C source.
#[allow(clippy::eq_op)]
pub extern "C" fn safe_double_to_int(d: c_double) -> c_int {"""
assert old in s; s = s.replace(old, new, 1)

# 2. `# Safety` sections for the unsafe extern fns
safety = {
"pub unsafe extern \"C\" fn compare_results_in_array(":
  "/// # Safety\n/// `arr` must be a valid `ResultArray*`. As in the C, the indices are only\n/// checked against `arr->count` from above — a negative index or a `count`\n/// larger than the real array forms an out-of-bounds address (never\n/// dereferenced), exactly as `&arr->data[idx]` does in C.\n",
"pub unsafe extern \"C\" fn init_result_array(":
  "/// # Safety\n/// `arr` must be a valid `ResultArray*`. `values` must point to at least\n/// `min(count, 10)` `int`s; when that is zero, `values` is never read (so NULL\n/// is accepted), matching the C.\n",
"pub unsafe extern \"C\" fn process_with_foreach(":
  "/// # Safety\n/// `arr` must be a valid `ResultArray*` and `op` a callable function pointer.\n/// A negative `arr->count` makes the loop run off the end of the array, exactly\n/// as the `count_iter != size` guard in the C `FOREACH` macro does.\n",
"pub unsafe extern \"C\" fn compute_weighted_sum(":
  "/// # Safety\n/// `arr` must be a valid `ResultArray*`; elements `0..arr->count` are read.\n",
}
for sig, doc in safety.items():
    assert sig in s, sig
    s = s.replace(sig, doc + sig, 1)
open(p,'w').write(s)
print("lib.rs patched")

p='tests/phase_c_errors.rs'; s=open(p).read()
old = """            #[allow(invalid_value)]
