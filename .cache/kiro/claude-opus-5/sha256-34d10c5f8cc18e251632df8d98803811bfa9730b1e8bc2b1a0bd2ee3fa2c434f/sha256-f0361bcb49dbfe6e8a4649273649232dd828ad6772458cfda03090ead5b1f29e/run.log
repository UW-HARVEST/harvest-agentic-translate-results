   249	#[unsafe(no_mangle)]
   250	pub extern "C" fn arrayfunc(
   251	    param1: c_int,
   252	    param2: c_int,
   253	    param3: c_int,
   254	    param4: c_int,
   255	) -> c_int {
   256	    let operations: [OperationFunc; 4] = [
   257	        add_operation,
   258	        multiply_operation,
   259	        subtract_operation,
   260	        modulo_operation,
   261	    ];
   262	
   263	    let mut values: [c_int; 8] = [
   264	        param1,
   265	        param2,
   266	        param3,
   267	        param4,
   268	        param1.wrapping_add(param2),
   269	        param2.wrapping_sub(param3),
   270	        param3.wrapping_mul(2),
   271	        (param4 / 2).wrapping_add(1),
   272	    ];
