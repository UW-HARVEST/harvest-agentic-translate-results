   274	    // `ResultArray arr = {.count = 0};` zero-initializes the whole aggregate.
   275	    let mut arr = ResultArray {
   276	        data: [Result {
   277	            value: 0,
   278	            scaled: 0.0,
   279	            rank: 0,
   280	        }; 10],
   281	        count: 0,
   282	    };
