    75	int safe_double_to_int(double d) {
    76	    if (d >= (double)INT32_MAX) {
    77	        return INT32_MAX;
    78	    }
    79	    if (d <= (double)INT32_MIN) {
    80	        return INT32_MIN;
    81	    }
    82	    if (d != d) {
    83	        return 0;
    84	    }
    85	    return (int)d;
    86	}
    87	
    88	int compute_scaled_value(int base, double scale_factor) {
    89	    double scaled = (double)base * scale_factor;
    90	    return safe_double_to_int(scaled);
    91	}
    92	
    93	int compare_results_in_array(ResultArray *arr, int idx1, int idx2) {
    94	    if (idx1 >= arr->count || idx2 >= arr->count) {
    95	        return 0;
    96	    }
    97	
    98	    Result *ptr1 = &arr->data[idx1];
    99	    Result *ptr2 = &arr->data[idx2];
   100	
   101	    if (ptr1 < ptr2) {
   102	        return -1;
   103	    } else if (ptr1 > ptr2) {
   104	        return 1;
   105	    }
   106	    return 0;
   107	}
   108	
   109	void init_result_array(ResultArray *arr, int values[], int count) {
   110	    arr->count = count < 10 ? count : 10;
   111	
   112	    for (int i = 0; i < arr->count; i++) {
   113	        arr->data[i] = (Result){
   114	            .value = values[i],
   115	            .scaled = (double)values[i] * 1.5,
   116	            .rank = i
   117	        };
   118	    }
   119	}
