    26	use std::ffi::{c_double, c_int};
    27	
    28	/// `typedef int (*operation_func)(int a, int b, int unused1, int unused2);`
    29	pub type OperationFunc = extern "C" fn(c_int, c_int, c_int, c_int) -> c_int;
    30	
    31	/// ```c
    32	/// typedef struct {
    33	///     int value;
    34	///     double scaled;
    35	///     int rank;
    36	/// } Result;
    37	/// ```
    38	#[repr(C)]
    39	#[derive(Clone, Copy)]
    40	pub struct Result {
    41	    pub value: c_int,
    42	    pub scaled: c_double,
    43	    pub rank: c_int,
    44	}
    45	
    46	/// ```c
    47	/// typedef struct {
    48	///     Result data[10];
    49	///     int count;
    50	/// } ResultArray;
    51	/// ```
    52	#[repr(C)]
    53	pub struct ResultArray {
    54	    pub data: [Result; 10],
    55	    pub count: c_int,
    56	}
    57	
    58	// ---------------------------------------------------------------------------
    59	// Operations
    60	// ---------------------------------------------------------------------------
    61	
    62	#[unsafe(no_mangle)]
    63	pub extern "C" fn add_operation(a: c_int, b: c_int, _unused1: c_int, _unused2: c_int) -> c_int {
    64	    // C signed overflow is UB; gcc/clang produce two's-complement wraparound.
    65	    a.wrapping_add(b)
    66	}
    67	
    68	#[unsafe(no_mangle)]
    69	pub extern "C" fn multiply_operation(a: c_int, b: c_int, _unused1: c_int, _unused2: c_int) -> c_int {
    70	    a.wrapping_mul(b)
    71	}
    72	
    73	#[unsafe(no_mangle)]
    74	pub extern "C" fn subtract_operation(a: c_int, b: c_int, _unused1: c_int, _unused2: c_int) -> c_int {
    75	    a.wrapping_sub(b)
    76	}
    77	
    78	/// Signed remainder with C's exact machine semantics.
    79	///
    80	/// On x86-64 the compiler emits `idiv`, which raises `#DE` (SIGFPE) for
    81	/// `INT_MIN % -1`. Rust's `%` would instead panic there, so the instruction is
    82	/// emitted directly to keep the observable behaviour identical to the C.
    83	#[cfg(target_arch = "x86_64")]
    84	#[inline]
    85	fn c_rem_i32(a: c_int, b: c_int) -> c_int {
    86	    let rem: c_int;
    87	    unsafe {
    88	        std::arch::asm!(
    89	            "cdq",
    90	            "idiv {divisor:e}",
    91	            divisor = in(reg) b,
    92	            inout("eax") a => _,
    93	            out("edx") rem,
    94	            options(nomem, nostack),
    95	        );
    96	    }
    97	    rem
    98	}
    99	
   100	#[cfg(not(target_arch = "x86_64"))]
   101	#[inline]
   102	fn c_rem_i32(a: c_int, b: c_int) -> c_int {
   103	    a.wrapping_rem(b)
   104	}
   105	
   106	#[unsafe(no_mangle)]
   107	pub extern "C" fn modulo_operation(a: c_int, b: c_int, _unused1: c_int, _unused2: c_int) -> c_int {
   108	    if b == 0 {
   109	        return 0;
   110	    }
   111	    c_rem_i32(a, b)
   112	}
