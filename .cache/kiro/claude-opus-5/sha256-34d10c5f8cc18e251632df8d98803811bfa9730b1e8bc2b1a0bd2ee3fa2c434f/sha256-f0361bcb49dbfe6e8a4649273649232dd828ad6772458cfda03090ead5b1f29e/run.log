   144	
   145	/// Compares the *addresses* of two elements, exactly as the C does. No lower
   146	/// bound check on the indices is performed (faithful to the original).
   147	#[unsafe(no_mangle)]
   148	pub unsafe extern "C" fn compare_results_in_array(
   149	    arr: *mut ResultArray,
   150	    idx1: c_int,
   151	    idx2: c_int,
   152	) -> c_int {
   153	    let count = (*arr).count;
   154	    if idx1 >= count || idx2 >= count {
   155	        return 0;
   156	    }
   157	
   158	    let base = (&raw mut (*arr).data) as *mut Result;
   159	    let ptr1 = base.offset(idx1 as isize);
   160	    let ptr2 = base.offset(idx2 as isize);
   161	
   162	    if ptr1 < ptr2 {
   163	        -1
   164	    } else if ptr1 > ptr2 {
   165	        1
   166	    } else {
   167	        0
   168	    }
   169	}
   170	
   171	#[unsafe(no_mangle)]
   172	pub unsafe extern "C" fn init_result_array(
   173	    arr: *mut ResultArray,
   174	    values: *mut c_int,
   175	    count: c_int,
   176	) {
   177	    (*arr).count = if count < 10 { count } else { 10 };
   178	
   179	    let base = (&raw mut (*arr).data) as *mut Result;
   180	    let mut i: c_int = 0;
   181	    while i < (*arr).count {
   182	        let v = *values.offset(i as isize);
   183	        *base.offset(i as isize) = Result {
   184	            value: v,
   185	            scaled: v as c_double * 1.5,
   186	            rank: i,
   187	        };
   188	        i += 1;
   189	    }
   190	}
   191	
   192	/// Translation of the `FOREACH` macro loop: walks `arr->data[0 .. arr->count)`.
   193	#[unsafe(no_mangle)]
   194	pub unsafe extern "C" fn process_with_foreach(arr: *mut ResultArray, op: OperationFunc) -> c_int {
   195	    let mut total: c_int = 0;
   196	
   197	    let base = (&raw mut (*arr).data) as *mut Result;
   198	    let size = (*arr).count;
   199	
   200	    let mut count_iter: c_int = 0;
   201	    while count_iter != size {
   202	        let item = base.offset(count_iter as isize);
   203	
   204	        let result = op((*item).value, (*item).rank, 0, 0);
   205	        total = total.wrapping_add(result);
   206	
   207	        let temp = result as c_double * 0.75;
   208	        (*item).scaled = temp;
   209	        (*item).value = safe_double_to_int(temp);
   210	
   211	        count_iter += 1;
   212	    }
   213	
   214	    total
   215	}
   216	
   217	#[unsafe(no_mangle)]
   218	pub unsafe extern "C" fn compute_weighted_sum(arr: *mut ResultArray) -> c_int {
   219	    let mut sum: c_int = 0;
   220	
   221	    let base_ptr = (&raw mut (*arr).data) as *mut Result;
   222	    let count = (*arr).count;
   223	
   224	    let mut i: c_int = 0;
   225	    while i < count {
   226	        let current = base_ptr.offset(i as isize);
   227	        let base = base_ptr;
   228	
   229	        // `current - base` is the element index; 1 is used for the first slot.
   230	        let weight: c_int = if current > base {
   231	            current.offset_from(base) as c_int
   232	        } else {
   233	            1
   234	        };
   235	
   236	        let weighted = (*current).value as c_double * weight as c_double * 0.8;
   237	        sum = sum.wrapping_add(safe_double_to_int(weighted));
   238	
   239	        i += 1;
   240	    }
   241	
   242	    sum
   243	}
