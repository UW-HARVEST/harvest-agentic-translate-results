    50	int add_operation(int a, int b, int unused1, int unused2) {
    51	    (void)unused1;
    52	    (void)unused2;
    53	    return a + b;
    54	}
    55	
    56	int multiply_operation(int a, int b, int unused1, int unused2) {
    57	    (void)unused1;
    58	    (void)unused2;
    59	    return a * b;
    60	}
    61	
    62	int subtract_operation(int a, int b, int unused1, int unused2) {
    63	    (void)unused1;
    64	    (void)unused2;
    65	    return a - b;
    66	}
    67	
    68	int modulo_operation(int a, int b, int unused1, int unused2) {
    69	    (void)unused1;
    70	    (void)unused2;
    71	    if (b == 0) return 0;
    72	    return a % b;
    73	}
