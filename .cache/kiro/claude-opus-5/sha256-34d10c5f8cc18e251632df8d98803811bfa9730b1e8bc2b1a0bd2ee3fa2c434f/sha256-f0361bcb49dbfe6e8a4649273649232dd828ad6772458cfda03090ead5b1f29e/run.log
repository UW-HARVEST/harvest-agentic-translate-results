   118	/// Exact order of checks preserved: upper bound, lower bound, then NaN.
   119	/// (NaN fails both relational tests, so it reaches the `d != d` case.)
   120	#[unsafe(no_mangle)]
   121	pub extern "C" fn safe_double_to_int(d: c_double) -> c_int {
   122	    if d >= c_int::MAX as c_double {
   123	        return c_int::MAX;
   124	    }
   125	    if d <= c_int::MIN as c_double {
   126	        return c_int::MIN;
   127	    }
   128	    if d != d {
   129	        return 0;
   130	    }
   131	    // Value is strictly inside the int range here, so truncation matches C.
   132	    d as c_int
   133	}
   134	
   135	#[unsafe(no_mangle)]
   136	pub extern "C" fn compute_scaled_value(base: c_int, scale_factor: c_double) -> c_int {
   137	    let scaled = base as c_double * scale_factor;
   138	    safe_double_to_int(scaled)
   139	}
