[0m[49m[38;5;10m+     30[0m:[38;5;10m[49m //!
[0m[49m[38;5;10m+     31[0m:[38;5;10m[49m //! void driver(double f) {
[0m[49m[38;5;10m+     32[0m:[38;5;10m[49m //!     raw_double_t u = {.f = f};
[0m[49m[38;5;10m+     33[0m:[38;5;10m[49m //!     printf("%llx %a %.4f\n", u.x, f, f);
[0m[49m[38;5;10m+     34[0m:[38;5;10m[49m //! }
[0m[49m[38;5;10m+     35[0m:[38;5;10m[49m //!
[0m[49m[38;5;10m+     36[0m:[38;5;10m[49m //! int main() {
