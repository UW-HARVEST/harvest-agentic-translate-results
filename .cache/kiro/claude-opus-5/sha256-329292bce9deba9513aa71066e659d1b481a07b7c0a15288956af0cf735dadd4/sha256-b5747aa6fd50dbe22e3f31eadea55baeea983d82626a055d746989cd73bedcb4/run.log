import re, textwrap
src=open('c_src/src/lib.c').read()
def tab(name):
    m=re.search(re.escape(name)+r'\[(\d+)\]\s*=\s*\{(.*?)\};', src, re.S)
    return int(m.group(1)), [v.strip() for v in m.group(2).split(',')]

def fmt(name, ty, vals, per):
    n=len(vals)
    lines=[]
    for i in range(0,n,per):
        lines.append('    '+', '.join(vals[i:i+per])+',')
    return f"static {name}: [{ty}; {n}] = [\n"+"\n".join(lines)+"\n];\n"

_,mant=tab('m__mantissa')
_,off=tab('m__offset')
_,exp=tab('m__exponent')

out = []
out.append("""//! Translation of c_src/src/lib.c (half-precision -> single-precision conversion).
//!
//! Behaviour is reproduced bit-for-bit, including the quirks of the original
//! lookup tables (e.g. the second half of the mantissa table repeating a
//! different stride). No bugs are "fixed".

""")
out.append(fmt('M_MANTISSA','u32',mant,6))
out.append("\n")
out.append(fmt('M_OFFSET','u16',off,8))
out.append("\n")
out.append(fmt('M_EXPONENT','u32',exp,6))
out.append("""
/// `float half2float(uint16_t h)`
///
/// Mirrors the C implementation exactly:
/// ```c
/// int n = h >> 10;
/// out.num = m__mantissa[(h & 0x3ff) + m__offset[n]] + m__exponent[n];
/// return out.flt;
/// ```
/// The addition is unsigned 32-bit and wraps, matching C's `uint32_t`
/// arithmetic, and the result is reinterpreted as a `float`.
#[unsafe(no_mangle)]
pub extern "C" fn half2float(h: u16) -> core::ffi::c_float {
    let n = (h >> 10) as usize;
    let idx = (h & 0x3ff) as usize + M_OFFSET[n] as usize;
    let num = M_MANTISSA[idx].wrapping_add(M_EXPONENT[n]);
    f32::from_bits(num)
}
""")
open('translation/src/lib.rs','w').write(''.join(out))
EOF
