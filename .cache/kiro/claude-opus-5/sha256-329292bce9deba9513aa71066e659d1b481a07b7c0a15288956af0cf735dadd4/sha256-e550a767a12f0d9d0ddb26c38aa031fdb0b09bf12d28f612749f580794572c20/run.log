import re
src = open('c_src/src/lib.c').read()

def grab(name):
    # find "name[N] = { ... };"
    m = re.search(re.escape(name) + r'\[(\d+)\]\s*=\s*\{(.*?)\};', src, re.S)
    n = int(m.group(1))
    vals = re.findall(r'0x[0-9a-fA-F]+', m.group(2))
    print(name, 'declared', n, 'found', len(vals))
    assert len(vals) == n, (name, n, len(vals))
    return n, vals

mant = grab('m__mantissa')
off  = grab('m__offset')
exp  = grab('m__exponent')

def emit(name, ty, n, vals, per):
    lines = [f'static {name}: [{ty}; {n}] = [']
    for i in range(0, n, per):
        lines.append('    ' + ', '.join(vals[i:i+per]) + ',')
    lines.append('];')
    return '\n'.join(lines)

body = f'''//! Rust translation of c_src/src/lib.c
//!
//! Public ABI: `float half2float(uint16_t h)`
//!
//! The three lookup tables below are copied verbatim from the C source so the
//! conversion is bit-for-bit identical.

#![allow(non_upper_case_globals)]

use std::ffi::{{c_float, c_ushort}};

{emit('M__MANTISSA', 'u32', mant[0], mant[1], 6)}

{emit('M__OFFSET', 'u16', off[0], off[1], 8)}

{emit('M__EXPONENT', 'u32', exp[0], exp[1], 6)}

/// Translation of:
/// ```c
/// float half2float(uint16_t h) {{
///     union {{ float flt; uint32_t num; }} out;
///     int n = h >> 10;
///     out.num = m__mantissa[(h & 0x3ff) + m__offset[n]] + m__exponent[n];
///     return out.flt;
/// }}
/// ```
///
/// `n` is in 0..=63 because `h` is 16 bits, and
/// `(h & 0x3ff) + m__offset[n]` is at most 0x3ff + 0x400 = 0x7ff, so both
/// table accesses are in bounds for every possible input.
///
/// The C addition of the mantissa and exponent words is plain `uint32_t`
/// arithmetic, which wraps; `wrapping_add` reproduces that exactly.
#[unsafe(no_mangle)]
pub extern "C" fn half2float(h: c_ushort) -> c_float {{
    let n = (h >> 10) as usize;
    let num = M__MANTISSA[((h & 0x3ff) as usize) + (M__OFFSET[n] as usize)]
        .wrapping_add(M__EXPONENT[n]);
    f32::from_bits(num)
}}
'''
import os
os.makedirs('translation/src', exist_ok=True)
open('translation/src/lib.rs','w').write(body)
print('wrote translation/src/lib.rs')
