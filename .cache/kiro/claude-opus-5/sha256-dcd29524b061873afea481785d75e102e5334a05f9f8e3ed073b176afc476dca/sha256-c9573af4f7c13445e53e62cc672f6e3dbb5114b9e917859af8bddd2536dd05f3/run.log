import re
p='src/lib.rs'
s=open(p).read()
o=s

# --- c22: s->div = u + v  (addss dst = u) -------------------------------------
s = s.replace("""            s.verts[0].u = u;
            s.verts[1].u = v;
            s.div = u + v;
            s.count = 2;""",
"""            s.verts[0].u = u;
            s.verts[1].u = v;
            s.div = fp::add(u, v);
            s.count = 2;""")

# --- c23: barycentrics = c2Det2(..) * area  (mulss dst = det result) ----------
s = s.replace("""        let uABC = c2Det2(b, c) * area;
        let vABC = c2Det2(c, a) * area;
        let wABC = c2Det2(a, b) * area;""",
"""        let uABC = fp::mul(c2Det2(b, c), area);
        let vABC = fp::mul(c2Det2(c, a), area);
        let wABC = fp::mul(c2Det2(a, b), area);""")

for (u,v) in [("uAB","vAB"),("uBC","vBC"),("uCA","vCA")]:
    s = s.replace(f"            s.div = {u} + {v};", f"            s.div = fp::add({u}, {v});")

s = s.replace("            s.div = uABC + vABC + wABC;",
              "            s.div = fp::add(fp::add(uABC, vABC), wABC);")

# --- c2Witness / c2L: den = 1.0f / div ; den * u  (mulss dst = u) -------------
s = s.replace("        let den = 1.0f32 / (*s).div;", "        let den = fp::div(1.0, (*s).div);")
s = re.sub(r"den \* v\[(\d)\]\.u", lambda m: f"fp::mul(v[{m.group(1)}].u, den)", s)

open(p,'w').write(s)
print("changed:", s!=o)
print("remaining raw ops:")
PYEOF
