[0m[49m[38;5;10m+     618[0m:[38;5;10m[49m             });
[0m[49m[38;5;10m+     619[0m:[38;5;10m[49m             let sb = Shape::Aabb(c2AABB {
[0m[49m[38;5;10m+     620[0m:[38;5;10m[49m                 min: c2v { x: cb.x - s, y: cb.y - s },
[0m[49m[38;5;10m+     621[0m:[38;5;10m[49m                 max: c2v { x: cb.x + s, y: cb.y + s },
