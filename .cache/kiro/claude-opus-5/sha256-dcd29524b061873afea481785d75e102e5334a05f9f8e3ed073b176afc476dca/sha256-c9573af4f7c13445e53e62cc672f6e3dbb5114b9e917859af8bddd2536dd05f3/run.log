[0m[49m[38;5;10m+     654[0m:[38;5;10m[49m             let mut pa = c2Proxy::default();
[0m[49m[38;5;10m+     655[0m:[38;5;10m[49m             let mut pb = c2Proxy::default();
[0m[49m[38;5;10m+     656[0m:[38;5;10m[49m             (p.c.c2MakeProxy)(sa.as_ptr(), sa.ty(), &mut pa);
[0m[49m[38;5;10m+     657[0m:[38;5;10m[49m             (p.c.c2MakeProxy)(sb.as_ptr(), sb.ty(), &mut pb);
[0m[49m[38;5;10m+     658[0m:[38;5;10m[49m             let mut seed = c2Simplex::default();
[0m[49m[38;5;10m+     659[0m:[38;5;10m[49m             for k in 0..3 {
