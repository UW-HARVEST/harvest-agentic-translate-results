[0m[49m[38;5;10m+     662[0m:[38;5;10m[49m                 seed.verts[k].p = (p.c.c2Sub)(vb, va);
[0m[49m[38;5;10m+     663[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+     664[0m:[38;5;10m[49m             seed.count = 3;
[0m[49m[38;5;10m+     665[0m:[38;5;10m[49m             let metric = (p.c.c2GJKSimplexMetric)(&mut seed);
[0m[49m[38;5;10m+     666[0m:[38;5;10m[49m             let min_m = if metric < metric_old { metric } else { metric_old };
[0m[49m[38;5;10m+     667[0m:[38;5;10m[49m             let max_m = if metric > metric_old { metric } else { metric_old };
[0m[49m[38;5;10m+     668[0m:[38;5;10m[49m             if min_m < max_m * 2.0 && metric < -1.0e8f32 {
[0m[49m[38;5;10m+     669[0m:[38;5;10m[49m                 hit_reject += 1;
