[0m[49m[38;5;10m+     640[0m:[38;5;10m[49m                     rng.below(4) as c_int,
[0m[49m[38;5;10m+     641[0m:[38;5;10m[49m                     rng.below(4) as c_int,
[0m[49m[38;5;10m+     642[0m:[38;5;10m[49m                 ],
[0m[49m[38;5;10m+     643[0m:[38;5;10m[49m                 div: if i % 7 == 0 { 0.0 } else { rng.finite() },
[0m[49m[38;5;10m+     644[0m:[38;5;10m[49m             };
[0m[49m[38;5;10m+     645[0m:[38;5;10m[49m             let ur = (i % 2) as c_int;
