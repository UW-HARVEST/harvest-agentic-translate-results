[0m[49m[38;5;10m+    449[0m:[38;5;10m[49m         "", "0", "0x", "0X", "0x.", "0x.p", "0xp1", ".", ".e1", "e1", "E", "i", "in", "inf",
[0m[49m[38;5;10m+    450[0m:[38;5;10m[49m         "infi", "infin", "infini", "infinit", "infinity", "infinityx", "n", "na", "nan", "nan(",
[0m[49m[38;5;10m+    451[0m:[38;5;10m[49m         "nan()", "nan(x", "1", "1.", ".1", "1e", "1e+", "0x1", "0x1p", "0x1.8p-2",
