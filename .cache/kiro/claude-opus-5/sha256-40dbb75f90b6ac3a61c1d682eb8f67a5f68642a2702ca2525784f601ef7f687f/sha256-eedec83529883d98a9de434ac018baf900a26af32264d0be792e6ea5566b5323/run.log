[0m[49m[38;5;10m+    470[0m:[38;5;10m[49m         patterns.push((1u64 << k) - 1);
[0m[49m[38;5;10m+    471[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    472[0m:[38;5;10m[49m     patterns.extend([
[0m[49m[38;5;10m+    473[0m:[38;5;10m[49m         0x000f_ffff_ffff_ffff, // largest subnormal
[0m[49m[38;5;10m+    474[0m:[38;5;10m[49m         0x0010_0000_0000_0000, // smallest normal
[0m[49m[38;5;10m+    475[0m:[38;5;10m[49m         0x0010_0000_0000_0001,
[0m[49m[38;5;10m+    476[0m:[38;5;10m[49m         0x7fef_ffff_ffff_ffff, // largest finite
