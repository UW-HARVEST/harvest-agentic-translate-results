[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m         rp::set_node_count(n);
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m         if n >= 100 {
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m             let rc_c = unsafe { (c.add_node)(1, -1, 1.0) };
[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m             let rc_r = rp::add_node(1, -1, 1.0);
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m             assert_eq!(rc_c, rc_r, "add_node status at node_count={n}");
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m             assert_eq!(rc_c, 0o2, "expected STATUS_ERROR at node_count={n}");
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m     unsafe { (c.reset)() };
[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m     rp::reset();
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m }
