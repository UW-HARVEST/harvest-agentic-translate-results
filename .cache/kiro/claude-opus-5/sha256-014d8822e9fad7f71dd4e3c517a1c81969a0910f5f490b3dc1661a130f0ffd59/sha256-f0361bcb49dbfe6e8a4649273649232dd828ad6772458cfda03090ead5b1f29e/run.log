[0m[49m[38;5;10m+    184[0m:[38;5;10m[49m fn internals_add_node_negative_count_signed_comparison() {
[0m[49m[38;5;10m+    185[0m:[38;5;10m[49m     let c = setup();
[0m[49m[38;5;10m+    186[0m:[38;5;10m[49m     for n in [-1i32, -5, -100, i32::MIN + 1] {
