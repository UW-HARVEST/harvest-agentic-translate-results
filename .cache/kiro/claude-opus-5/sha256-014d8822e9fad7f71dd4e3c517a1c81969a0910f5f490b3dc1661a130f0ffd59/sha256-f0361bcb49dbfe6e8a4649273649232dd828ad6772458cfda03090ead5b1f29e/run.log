import re, pathlib
files = {
 'tests/phase_b_valid_paths.rs': None,
 'tests/phase_c_error_paths.rs': None,
 'tests/phase_b_internals.rs': None,
}
for f in files:
    p = pathlib.Path(f)
    s = p.read_text()
    # wrap literal loop bounds >= 2000 in `0..N` with common::iters(N)
    def repl(m):
        n = int(m.group(1).replace('_',''))
        return '0..common::iters(%s)' % m.group(1) if n >= 2000 else m.group(0)
    s2 = re.sub(r'0\.\.([0-9][0-9_]*)(?:u32)?\b(?!\.)', repl, s)
    # `for _ in 0..common::iters(N)` is fine; also handle `for i in 0..common::iters(N)` needing usize
    p.write_text(s2)
    print(f, 'patched', s2.count('common::iters'))
