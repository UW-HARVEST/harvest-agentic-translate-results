[0m[49m[38;5;10m+    148[0m:[38;5;10m[49m fn internals_add_node_fills_storage_identically() {
[0m[49m[38;5;10m+    149[0m:[38;5;10m[49m     let c = setup();
[0m[49m[38;5;10m+    150[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 1);
[0m[49m[38;5;10m+    151[0m:[38;5;10m[49m     // Fill past MAX_NODES (100) so the `node_count >= MAX_NODES` rejection fires.
[0m[49m[38;5;10m+    152[0m:[38;5;10m[49m     for k in 0..130 {
[0m[49m[38;5;10m+    153[0m:[38;5;10m[49m         let id = rng.next_i32_biased();
[0m[49m[38;5;10m+    154[0m:[38;5;10m[49m         let parent = rng.next_i32_biased();
[0m[49m[38;5;10m+    155[0m:[38;5;10m[49m         let value = f64::from_bits(rng.next_u64());
[0m[49m[38;5;10m+    156[0m:[38;5;10m[49m         let value = if value.is_finite() { value } else { k as f64 * 1.25 };
[0m[49m[38;5;10m+    157[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    158[0m:[38;5;10m[49m         let rc_c = unsafe { (c.add_node)(id, parent, value) };
[0m[49m[38;5;10m+    159[0m:[38;5;10m[49m         let rc_r = rp::add_node(id, parent, value);
[0m[49m[38;5;10m+    160[0m:[38;5;10m[49m         assert_eq!(rc_c, rc_r, "add_node #{k} status: C={rc_c} Rust={rc_r}");
[0m[49m[38;5;10m+    161[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    162[0m:[38;5;10m[49m         let nc_c = unsafe { (c.node_count)() };
[0m[49m[38;5;10m+    163[0m:[38;5;10m[49m         let nc_r = rp::node_count();
[0m[49m[38;5;10m+    164[0m:[38;5;10m[49m         assert_eq!(nc_c, nc_r, "node_count after #{k}: C={nc_c} Rust={nc_r}");
[0m[49m[38;5;10m+    165[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    166[0m:[38;5;10m[49m         if rc_c == 0 {
[0m[49m[38;5;10m+    167[0m:[38;5;10m[49m             let idx = nc_c - 1;
[0m[49m[38;5;10m+    168[0m:[38;5;10m[49m             assert_eq!(unsafe { (c.node_id)(idx) }, id);
[0m[49m[38;5;10m+    169[0m:[38;5;10m[49m             assert_eq!(unsafe { (c.node_parent_id)(idx) }, parent);
[0m[49m[38;5;10m+    170[0m:[38;5;10m[49m             assert_eq!(unsafe { (c.node_value)(idx) }.to_bits(), value.to_bits());
[0m[49m[38;5;10m+    171[0m:[38;5;10m[49m             for k2 in 0..4 {
