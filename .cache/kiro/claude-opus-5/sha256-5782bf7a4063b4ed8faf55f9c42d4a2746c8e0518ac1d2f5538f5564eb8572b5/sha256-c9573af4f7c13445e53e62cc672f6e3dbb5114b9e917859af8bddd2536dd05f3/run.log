#include <dlfcn.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
static char msg[64];
__attribute__((noinline)) void dirty(unsigned long v, int words){
    volatile unsigned long buf[512];
    for(int i=0;i<words && i<512;i++) buf[i]=v;
    __asm__ volatile("" :: "r"(buf) : "memory");
}
__attribute__((noinline)) void callit(void (*f)(void)){ f(); }
int main(int argc, char**argv){
    strcpy(msg, argv[3]);
    unsigned long v = strcmp(argv[2],"null")==0 ? 0UL : (unsigned long)msg;
    void *h = dlopen(argv[1], RTLD_NOW|RTLD_LOCAL);
    void (*bad)(void) = dlsym(h,"bad");
    void (*driver)(int) = dlsym(h,"driver");
    dirty(v, 512);
    callit(bad);
    fflush(stdout);
    dirty(v, 512);
    ((void(*)(int))driver)(0);
    fflush(stdout);
    return 0;
}
EOF
