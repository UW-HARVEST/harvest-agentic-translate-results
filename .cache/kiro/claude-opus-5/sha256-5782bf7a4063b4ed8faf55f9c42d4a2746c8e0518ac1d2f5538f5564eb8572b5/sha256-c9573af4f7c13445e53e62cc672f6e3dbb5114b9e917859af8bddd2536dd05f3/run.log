[0m[49m[38;5;10m+     914[0m:[38;5;10m[49m     let mut rng = Rng::new(25);
[0m[49m[38;5;10m+     915[0m:[38;5;10m[49m     let page = unsafe { libc::sysconf(libc::_SC_PAGESIZE) } as usize;
[0m[49m[38;5;10m+     916[0m:[38;5;10m[49m     for i in 0..64 {
[0m[49m[38;5;10m+     917[0m:[38;5;10m[49m         let len = rng.range(1, 64);
[0m[49m[38;5;10m+     918[0m:[38;5;10m[49m         // Two pages; second one is made inaccessible.
[0m[49m[38;5;10m+     919[0m:[38;5;10m[49m         let base = unsafe {
[0m[49m[38;5;10m+     920[0m:[38;5;10m[49m             libc::mmap(
[0m[49m[38;5;10m+     921[0m:[38;5;10m[49m                 ptr::null_mut(),
[0m[49m[38;5;10m+     922[0m:[38;5;10m[49m                 2 * page,
[0m[49m[38;5;10m+     923[0m:[38;5;10m[49m                 libc::PROT_READ | libc::PROT_WRITE,
