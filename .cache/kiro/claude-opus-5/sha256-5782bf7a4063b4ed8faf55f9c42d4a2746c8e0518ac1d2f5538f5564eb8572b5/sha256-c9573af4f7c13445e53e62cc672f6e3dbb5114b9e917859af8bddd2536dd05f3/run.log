typedef void (*d_t)(int);
int main(int argc, char**argv){
    int n = atoi(argv[2]);
    void *h = dlopen(argv[1], RTLD_NOW|RTLD_LOCAL);
    if(!h){ fprintf(stderr,"dlopen fail: %s\n", dlerror()); return 2; }
    d_t driver = (d_t)dlsym(h,"driver");
    volatile char *p = alloca(n?n:1);
    for(int i=0;i<(n?n:1);i++) p[i]=0;
    driver(0);
    fflush(stdout);
    return 0;
}
