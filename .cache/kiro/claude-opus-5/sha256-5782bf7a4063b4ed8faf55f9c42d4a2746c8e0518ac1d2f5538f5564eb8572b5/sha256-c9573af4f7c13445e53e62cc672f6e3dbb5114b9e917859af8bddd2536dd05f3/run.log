[0m[49m[38;5;10m+     941[0m:[38;5;10m[49m                 base.cast::<u8>().wrapping_add(start),
[0m[49m[38;5;10m+     942[0m:[38;5;10m[49m                 len + 1,
[0m[49m[38;5;10m+     943[0m:[38;5;10m[49m             );
[0m[49m[38;5;10m+     944[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+     945[0m:[38;5;10m[49m         let p = unsafe { base.cast::<u8>().wrapping_add(start) } as *const c_char;
[0m[49m[38;5;10m+     946[0m:[38;5;10m[49m 
