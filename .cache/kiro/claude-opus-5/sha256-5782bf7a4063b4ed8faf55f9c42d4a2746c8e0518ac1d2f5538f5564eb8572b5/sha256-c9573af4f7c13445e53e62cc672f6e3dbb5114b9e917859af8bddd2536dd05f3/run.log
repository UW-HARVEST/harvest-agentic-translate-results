[0m[49m[38;5;10m+     958[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+     959[0m:[38;5;10m[49m         assert_eq!(out.len(), len + 1, "CONFIGS row 25 / i={i}: length");
[0m[49m[38;5;10m+     960[0m:[38;5;10m[49m         set_residue_uniform(0);
