[0m[49m[38;5;10m+     950[0m:[38;5;10m[49m             &payload,
[0m[49m[38;5;10m+     951[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+     952[0m:[38;5;10m[49m         set_residue_uniform(p as u64);
[0m[49m[38;5;10m+     953[0m:[38;5;10m[49m         let out = assert_same_op(
[0m[49m[38;5;10m+     954[0m:[38;5;10m[49m             "CONFIGS row 25",
