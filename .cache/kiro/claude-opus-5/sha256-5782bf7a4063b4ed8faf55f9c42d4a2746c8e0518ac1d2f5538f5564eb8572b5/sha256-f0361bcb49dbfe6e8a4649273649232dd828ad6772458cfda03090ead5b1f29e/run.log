[0m[49m[38;5;10m+    33[0m:[38;5;10m[49m extra = "\n".join(f"int ctl_sym_{i}(void) {{ return {i}; }}" for i in range(2000))
[0m[49m[38;5;10m+    34[0m:[38;5;10m[49m open(f"{w}/fat.c", "w").write(src.replace('#include "driver.h"',
[0m[49m[38;5;10m+    35[0m:[38;5;10m[49m                                           '#include "driver.h"\n' + extra))
[0m[49m[38;5;10m+    36[0m:[38;5;10m[49m PY
