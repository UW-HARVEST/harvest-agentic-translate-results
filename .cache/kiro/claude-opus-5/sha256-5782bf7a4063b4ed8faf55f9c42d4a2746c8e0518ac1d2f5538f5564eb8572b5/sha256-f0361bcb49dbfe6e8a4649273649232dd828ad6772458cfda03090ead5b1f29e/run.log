#include <dlfcn.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
int main(int argc, char**argv){
    int mode = strcmp(argv[2],"lazy")==0 ? RTLD_LAZY : RTLD_NOW;
    void *h = dlopen(argv[1], mode);
    if(!h){ fprintf(stderr,"dlopen: %s\n", dlerror()); return 2; }
    void (*driver)(int) = dlsym(h,"driver");
    void (*bad)(void) = dlsym(h,"bad");
    void (*good)(void) = dlsym(h,"good");
    void (*printLine)(const char*) = dlsym(h,"printLine");
    // argv[3..] = sequence of ops: b, g, d0, d1, pX, pN(null)
    for(int i=3;i<argc;i++){
        char *o = argv[i];
        if(!strcmp(o,"b")) bad();
        else if(!strcmp(o,"g")) good();
        else if(o[0]=='d') driver(atoi(o+1));
        else if(o[0]=='p') { if(!strcmp(o,"pNULL")) printLine(NULL); else printLine(o+1); }
    }
    fflush(stdout);
    return 0;
}
EOF
