[0m[49m[38;5;10m+    20[0m:[38;5;10m[49m         line = line.split('#')[0].strip()
[0m[49m[38;5;10m+    21[0m:[38;5;10m[49m         if '=' in line:
[0m[49m[38;5;10m+    22[0m:[38;5;10m[49m             name = line.split('=')[0].strip()
[0m[49m[38;5;10m+    23[0m:[38;5;10m[49m             if name != 'default':
