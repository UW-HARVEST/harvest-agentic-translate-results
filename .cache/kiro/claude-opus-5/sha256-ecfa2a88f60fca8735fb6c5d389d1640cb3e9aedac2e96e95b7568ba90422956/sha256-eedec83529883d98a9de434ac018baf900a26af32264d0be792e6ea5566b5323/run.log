import random, subprocess, collections
ROOT="/local/home/scheschb/.harvest/work/harvest-work-CKIatf"
def L(p): return ["setarch","-R",ROOT+p]
C=L("/c_src/build/driver"); R=L("/translation/target/release/driver")
def run(cmd,d):
    p=subprocess.run(cmd,input=d,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
    return p.stdout,p.stderr,p.returncode
NAMES=["A","B","C","D","", "  ", "a"*63, "a"*70, "x\ty", "\xff\xfe", "N1"]
DIST=["0","1","5","9","-1","-2147483648","2147483647","abc","","  7  ","3x"]
CH=["1","2","3","4","5","6","7","8","0","9","-1","junk","","  2  ","8abc","2147483648","1"*300]
def gen(rng):
    out=[]
    for _ in range(rng.randint(1,40)):
        ch=rng.choice(CH); out.append(ch)
        c=ch.strip()
        if c in ("1","4","6","7"): out.append(rng.choice(NAMES))
        elif c=="2": out += [rng.choice(NAMES),rng.choice(NAMES),rng.choice(DIST)]
        elif c=="5": out += [rng.choice(NAMES),rng.choice(NAMES)]
    s="\n".join(out)
    if rng.random()<0.85: s+="\n"
    return s.encode("latin-1")
stats=collections.Counter(); bad=0; n=0
for s in range(1500):
    rng=random.Random(90000+s)
    d=gen(rng)
    co,ce,cs=run(C,d); ro,re_,rs=run(R,d); n+=1
    stats[cs]+=1
    if (co,ce,cs)!=(ro,re_,rs):
        bad+=1; print("MISMATCH",s,d[:200])
        if cs!=rs: print(" status",cs,rs)
        if ce!=re_: print(" errC",ce[:200],"\n errR",re_[:200])
        if co!=ro:
            for k in range(min(len(co),len(ro))):
                if co[k]!=ro[k]: print(" out@",k,repr(co[max(0,k-60):k+60]),"\n     ",repr(ro[max(0,k-60):k+60])); break
            else: print(" lens",len(co),len(ro))
        if bad>=4: break
print("checked",n,"statuses",dict(stats),"mismatches",bad)
EOF
