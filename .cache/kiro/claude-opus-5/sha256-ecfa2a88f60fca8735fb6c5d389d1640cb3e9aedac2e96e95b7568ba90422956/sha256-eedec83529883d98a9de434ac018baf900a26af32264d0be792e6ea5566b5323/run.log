import random, subprocess, collections
ROOT="/local/home/scheschb/.harvest/work/harvest-work-CKIatf"
C=["setarch","-R",ROOT+"/c_src/build/driver"]
R=["setarch","-R",ROOT+"/translation/target/release/driver"]
def run(cmd,d):
    p=subprocess.run(cmd,input=d,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
    return p.stdout,p.stderr,p.returncode
N=["A","B","C","D"]
stats=collections.Counter(); bad=0
for s in range(600):
    rng=random.Random(s)
    L=[]
    for c in N: L += ["1",c]
    for _ in range(rng.randint(1,6)):
        L += ["2",rng.choice(N),rng.choice(N),str(rng.randint(0,9))]
    for _ in range(rng.randint(1,10)):
        op=rng.choice(["6","7","7","3","1","4"])
        L += [op, rng.choice(N)]
    if rng.random()<0.8: L.append("8")
    d=("\n".join(L)+"\n").encode()
    co,ce,cs=run(C,d); ro,re_,rs=run(R,d)
    stats[cs]+=1
    if (co,ce,cs)!=(ro,re_,rs):
        bad+=1
        print("MISMATCH seed",s,d)
        if cs!=rs: print(" status",cs,rs)
        if ce!=re_: print(" err",ce[:200],"|",re_[:200])
        if co!=ro:
            for k in range(min(len(co),len(ro))):
                if co[k]!=ro[k]:
                    print(" out@",k,repr(co[k-50:k+50]),"|",repr(ro[k-50:k+50])); break
            else: print(" outlen",len(co),len(ro))
        if bad>=5: break
print("statuses",dict(stats),"mismatches",bad)
EOF
