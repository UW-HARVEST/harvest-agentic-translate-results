N=["A","B","C","D"]; DIST=["0","3","-1","abc"]
CH=["1","2","3","4","5","6","7","8","0","junk",""]
bad=0
for s in range(250):
    rng=random.Random(s*17+9); L=[]
    for _ in range(rng.randint(1,18)):
        ch=rng.choice(CH); L.append(ch); c=ch.strip()
        if c in ("1","4","6","7"): L.append(rng.choice(N))
        elif c=="2": L += [rng.choice(N),rng.choice(N),rng.choice(DIST)]
        elif c=="5": L += [rng.choice(N),rng.choice(N)]
    if rng.random()<0.8: L.append("8")
    d=("\n".join(L)+"\n").encode()
    c=run(CB,d,"c"); r=run(RB,d,"r")
