        ch=rng.choice(CH); L.append(ch); c=ch.strip()
        if c in ("1","4","6","7"): L.append(rng.choice(N))
        elif c=="2": L += [rng.choice(N),rng.choice(N),rng.choice(DIST)]
        elif c=="5": L += [rng.choice(N),rng.choice(N)]
