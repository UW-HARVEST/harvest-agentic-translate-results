import subprocess
def build(n):
    names=[b'N%02d'%i for i in range(n)]
    s=b'1\nDEL\n'
    for x in names: s+=b'1\n'+x+b'\n'
    for a,b in zip(names,names[1:]): s+=b'2\n'+a+b'\n'+b+b'\n1\n'
    s+=b'7\nDEL\n5\n'+names[0]+b'\n'+names[-1]+b'\n3\n8\n'
    return s
