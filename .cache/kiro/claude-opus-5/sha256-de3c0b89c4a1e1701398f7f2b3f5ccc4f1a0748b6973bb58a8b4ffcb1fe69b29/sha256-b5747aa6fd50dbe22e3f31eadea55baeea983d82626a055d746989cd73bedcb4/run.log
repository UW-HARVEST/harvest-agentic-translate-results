int main(void){
    /* extra slack after the struct so that any OOB writes land somewhere sane */
    unsigned char blob[sizeof(tflac)+256];
    tflac_s32 samples[4096];
    unsigned seed=12345u;
    for(int trial=0; trial<200; trial++){
        memset(blob,0,sizeof blob);
        tflac *t=(tflac*)blob;
        for(size_t i=0;i<sizeof(t->md5_ctx.buffer);i++){ seed=seed*1103515245u+12345u; t->md5_ctx.buffer[i]=(tflac_u8)(seed>>16); }
        seed=seed*1103515245u+12345u; t->md5_ctx.pos=(seed>>16)%64;   /* in-bounds pos */
        seed=seed*1103515245u+12345u; t->md5_ctx.total=seed;
        seed=seed*1103515245u+12345u; t->cur_blocksize=(seed>>8)%1000;
        seed=seed*1103515245u+12345u; t->channels=(seed>>8)%8;
        for(int i=0;i<4096;i++){ seed=seed*1103515245u+12345u; samples[i]=(tflac_s32)seed; }
