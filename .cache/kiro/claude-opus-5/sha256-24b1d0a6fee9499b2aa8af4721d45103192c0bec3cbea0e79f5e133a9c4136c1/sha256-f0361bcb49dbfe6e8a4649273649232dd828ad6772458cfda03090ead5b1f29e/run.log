[0m[49m[38;5;10m+    190[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    191[0m:[38;5;10m[49m             check_explicit(&bytes, "row9 embedded NULs");
[0m[49m[38;5;10m+    192[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    193[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    194[0m:[38;5;10m[49m     // A NUL in the very first position must still encode `len` bytes.
[0m[49m[38;5;10m+    195[0m:[38;5;10m[49m     let bytes = [0u8, b'A', b'B', b'C'];
