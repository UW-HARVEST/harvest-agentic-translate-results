[0m[49m[38;5;10m+    118[0m:[38;5;10m[49m         check_explicit(&hi, "row7 all high-bit");
[0m[49m[38;5;10m+    119[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    120[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    121[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    122[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    123[0m:[38;5;10m[49m // Row 8: sweep every 6-bit index through every position, hitting all five
[0m[49m[38;5;10m+    124[0m:[38;5;10m[49m // `encode()` branches ('A'-'Z', 'a'-'z', '0'-'9', '+', '/').
[0m[49m[38;5;10m+    125[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    126[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    127[0m:[38;5;10m[49m /// Pack four 6-bit values into the three bytes that produce them.
[0m[49m[38;5;10m+    128[0m:[38;5;10m[49m fn pack(v: [u8; 4]) -> [u8; 3] {
[0m[49m[38;5;10m+    129[0m:[38;5;10m[49m     [
[0m[49m[38;5;10m+    130[0m:[38;5;10m[49m         (v[0] << 2) | (v[1] >> 4),
[0m[49m[38;5;10m+    131[0m:[38;5;10m[49m         ((v[1] & 0x0F) << 4) | (v[2] >> 2),
[0m[49m[38;5;10m+    132[0m:[38;5;10m[49m         ((v[2] & 0x03) << 6) | v[3],
[0m[49m[38;5;10m+    133[0m:[38;5;10m[49m     ]
[0m[49m[38;5;10m+    134[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    135[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    136[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    137[0m:[38;5;10m[49m fn cfg_row8_all_encode_branches_every_position() {
[0m[49m[38;5;10m+    138[0m:[38;5;10m[49m     let mut seen = [false; 64];
[0m[49m[38;5;10m+    139[0m:[38;5;10m[49m     for v in 0u8..64 {
[0m[49m[38;5;10m+    140[0m:[38;5;10m[49m         for pos in 0..4usize {
[0m[49m[38;5;10m+    141[0m:[38;5;10m[49m             let mut idx = [0u8; 4];
[0m[49m[38;5;10m+    142[0m:[38;5;10m[49m             idx[pos] = v;
[0m[49m[38;5;10m+    143[0m:[38;5;10m[49m             let bytes = pack(idx);
[0m[49m[38;5;10m+    144[0m:[38;5;10m[49m             check_explicit(&bytes, "row8 6-bit sweep");
[0m[49m[38;5;10m+    145[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    146[0m:[38;5;10m[49m         // Same value in all four slots.
[0m[49m[38;5;10m+    147[0m:[38;5;10m[49m         let bytes = pack([v, v, v, v]);
[0m[49m[38;5;10m+    148[0m:[38;5;10m[49m         check_explicit(&bytes, "row8 6-bit uniform");
[0m[49m[38;5;10m+    149[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    150[0m:[38;5;10m[49m         if let Outcome::Str(s) = pair().c.call(3, Some(&bytes)) {
[0m[49m[38;5;10m+    151[0m:[38;5;10m[49m             assert_eq!(s.len(), 4);
[0m[49m[38;5;10m+    152[0m:[38;5;10m[49m             seen[v as usize] = true;
[0m[49m[38;5;10m+    153[0m:[38;5;10m[49m             // Cross-check against the reference transliteration of the C.
[0m[49m[38;5;10m+    154[0m:[38;5;10m[49m             assert_eq!(s, reference(3, &bytes), "reference mismatch for v={v}");
[0m[49m[38;5;10m+    155[0m:[38;5;10m[49m         } else {
[0m[49m[38;5;10m+    156[0m:[38;5;10m[49m             panic!("unexpected NULL for v={v}");
[0m[49m[38;5;10m+    157[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    158[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    159[0m:[38;5;10m[49m     assert!(seen.iter().all(|&x| x), "not every 6-bit index was exercised");
[0m[49m[38;5;10m+    160[0m:[38;5;10m[49m     // Confirm the alphabet's four distinct branches really were produced.
[0m[49m[38;5;10m+    161[0m:[38;5;10m[49m     let alphabet: Vec<u8> = (0u8..64)
[0m[49m[38;5;10m+    162[0m:[38;5;10m[49m         .map(|v| match pair().c.call(3, Some(&pack([v, 0, 0, 0]))) {
[0m[49m[38;5;10m+    163[0m:[38;5;10m[49m             Outcome::Str(s) => s[0],
[0m[49m[38;5;10m+    164[0m:[38;5;10m[49m             Outcome::Null => panic!("NULL"),
[0m[49m[38;5;10m+    165[0m:[38;5;10m[49m         })
[0m[49m[38;5;10m+    166[0m:[38;5;10m[49m         .collect();
[0m[49m[38;5;10m+    167[0m:[38;5;10m[49m     assert!(alphabet.contains(&b'A') && alphabet.contains(&b'Z'), "A-Z branch");
[0m[49m[38;5;10m+    168[0m:[38;5;10m[49m     assert!(alphabet.contains(&b'a') && alphabet.contains(&b'z'), "a-z branch");
[0m[49m[38;5;10m+    169[0m:[38;5;10m[49m     assert!(alphabet.contains(&b'0') && alphabet.contains(&b'9'), "0-9 branch");
[0m[49m[38;5;10m+    170[0m:[38;5;10m[49m     assert!(alphabet.contains(&b'+'), "'+' branch (u == 62)");
[0m[49m[38;5;10m+    171[0m:[38;5;10m[49m     assert!(alphabet.contains(&b'/'), "'/' branch (u == 63)");
[0m[49m[38;5;10m+    172[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    173[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    174[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    175[0m:[38;5;10m[49m // Rows 9-11: embedded NULs, and the min/max uniform buffers.
