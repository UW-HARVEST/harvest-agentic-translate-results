#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <dlfcn.h>
#include "lib.h"

typedef int (*parse_fn)(struct ima_info *, const void *);

static unsigned char buf[4096];
static size_t pos;

static void put8(unsigned char v){ buf[pos++]=v; }
static void put16be(unsigned v){ put8(v>>8); put8(v&0xff); }
static void put32be(unsigned v){ put8(v>>24); put8(v>>16); put8(v>>8); put8(v); }
static void put64be(unsigned long long v){ for(int i=7;i>=0;i--) put8((v>>(i*8))&0xff); }
static void putf64be(double d){ unsigned long long u; memcpy(&u,&d,8); put64be(u); }
static void tag(const char *s){ put8(s[0]);put8(s[1]);put8(s[2]);put8(s[3]); }

/* Chunk header as the C code actually reads it: 4-byte type, 4 pad, 8-byte size */
static void chunk_hdr(const char *t, long long size){ tag(t); put32be(0); put64be(size); }

static void show(const char *name, int rc, struct ima_info *i, const unsigned char *base){
    unsigned long long srbits; memcpy(&srbits,&i->sample_rate,8);
    printf("%-6s rc=%d", name, rc);
    if(rc==0) printf(" blocks=+%ld size=%llu sr_bits=0x%016llx sr=%g frames=%llu ch=%u",
        i->blocks?(long)((const unsigned char*)i->blocks-base):-1,
        (unsigned long long)i->size, srbits, i->sample_rate,
        (unsigned long long)i->frame_count, i->channel_count);
    printf("\n");
}

int main(int argc, char **argv){
    void *h1=dlopen(argv[1],RTLD_NOW), *h2=dlopen(argv[2],RTLD_NOW);
    if(!h1||!h2){ printf("dlopen: %s\n", dlerror()); return 1; }
    parse_fn f1=(parse_fn)dlsym(h1,"ima_parse"), f2=(parse_fn)dlsym(h2,"ima_parse");
    if(!f1||!f2){ printf("dlsym failed\n"); return 1; }

    struct { const char *name; double sr; unsigned ch; long long frames; int bad_type; int bad_ver; int bad_fmt; int no_pakt_order; }
    cases[] = {
        {"44100 stereo", 44100.0, 2, 100000, 0,0,0,0},
        {"8000 mono",     8000.0, 1,   1234, 0,0,0,0},
        {"48000 5.1",    48000.0, 6, 999999, 0,0,0,0},
        {"22050.5",      22050.5, 2,      7, 0,0,0,0},
        {"1e300",          1e300, 2,      7, 0,0,0,0},
        {"tiny",          1e-300, 2,      7, 0,0,0,0},
        {"neg",         -44100.0, 2,      7, 0,0,0,0},
        {"badtype",      44100.0, 2,      7, 1,0,0,0},
        {"badver",       44100.0, 2,      7, 0,1,0,0},
        {"badfmt",       44100.0, 2,      7, 0,0,1,0},
        {"paktfirst",    44100.0, 2,     42, 0,0,0,1},
    };
    int fails=0;
    for(unsigned c=0;c<sizeof cases/sizeof *cases;c++){
        pos=0; memset(buf,0,sizeof buf);
        tag(cases[c].bad_type?"cafX":"caff"); put16be(cases[c].bad_ver?2:1); put16be(0);

        if(cases[c].no_pakt_order){
            chunk_hdr("pakt",24); put64be(11); put64be(cases[c].frames); put32be(0); put32be(0);
            chunk_hdr("free",8);  put64be(0);
            chunk_hdr("desc",32); putf64be(cases[c].sr); tag(cases[c].bad_fmt?"XXXX":"ima4");
            put32be(0); put32be(34); put32be(64); put32be(cases[c].ch); put32be(4);
        } else {
            chunk_hdr("desc",32); putf64be(cases[c].sr); tag(cases[c].bad_fmt?"XXXX":"ima4");
            put32be(0); put32be(34); put32be(64); put32be(cases[c].ch); put32be(4);
            chunk_hdr("pakt",24); put64be(11); put64be(cases[c].frames); put32be(0); put32be(0);
        }
        chunk_hdr("data",374); put32be(0);
        for(int k=0;k<340;k++) put8((unsigned char)(k*7+3));

        struct ima_info a, b;
        memset(&a,0xAA,sizeof a); memset(&b,0xAA,sizeof b);
        int r1=f1(&a,buf), r2=f2(&b,buf);
        int same = (r1==r2) && (r1!=0 || memcmp(&a,&b,sizeof a)==0);
        printf("[%-12s] %s\n", cases[c].name, same?"MATCH":"*** MISMATCH ***");
        if(!same){ fails++; show("C",r1,&a,buf); show("Rust",r2,&b,buf); }
        else show("both",r1,&a,buf);
    }
    printf("\n%s\n", fails?"FAILURES":"all cases identical");
    return fails!=0;
}
