[0m[49m[38;5;10m+    381[0m:[38;5;10m[49m             let rc = unsafe { (i.c)(c_buf.as_mut_ptr(), n, src.as_ptr()) };
[0m[49m[38;5;10m+    382[0m:[38;5;10m[49m             let rr = unsafe { (i.rust)(r_buf.as_mut_ptr(), n, src.as_ptr()) };
[0m[49m[38;5;10m+    383[0m:[38;5;10m[49m             assert_eq!(
[0m[49m[38;5;10m+    384[0m:[38;5;10m[49m                 rc, rr,
[0m[49m[38;5;10m+    385[0m:[38;5;10m[49m                 "cfg_25 round {round}: ret C={rc} RUST={rr} (n={n}, src={src:?})"
[0m[49m[38;5;10m+    386[0m:[38;5;10m[49m             );
[0m[49m[38;5;10m+    387[0m:[38;5;10m[49m             assert_eq!(
[0m[49m[38;5;10m+    388[0m:[38;5;10m[49m                 c_buf, r_buf,
[0m[49m[38;5;10m+    389[0m:[38;5;10m[49m                 "cfg_25 round {round}: buffer diverged (n={n}, src={src:?})"
[0m[49m[38;5;10m+    390[0m:[38;5;10m[49m             );
[0m[49m[38;5;10m+    391[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    392[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    393[0m:[38;5;10m[49m }
