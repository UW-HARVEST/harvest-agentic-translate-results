#include <stdio.h>
#include <stdint.h>
#include <dlfcn.h>
#include <stdlib.h>
#include <string.h>
typedef struct { uint64_t val; uint32_t bits, pos, len, tot; uint8_t *buffer; } bw_t;
typedef int (*fn)(bw_t*, uint32_t, uint64_t);
static uint64_t s=88172645463325252ULL;
static uint64_t rnd(void){ s^=s<<13; s^=s>>7; s^=s<<17; return s; }
int main(int argc,char**argv){
  void*h=dlopen(argv[1],RTLD_NOW); if(!h){puts(dlerror());return 1;}
  fn f=(fn)dlsym(h,"bitwriter_add"); if(!f){puts(dlerror());return 1;}
  printf("sizeof=%zu off val=%zu bits=%zu pos=%zu len=%zu tot=%zu buf=%zu\n",
    sizeof(bw_t),offsetof(bw_t,val),offsetof(bw_t,bits),offsetof(bw_t,pos),
    offsetof(bw_t,len),offsetof(bw_t,tot),offsetof(bw_t,buffer));
  /* deterministic edge grid */
  uint32_t bitsv[]={0,1,2,3,7,8,31,32,33,63,64,65,100,127,128,1000,0xFFFFFFFFu,0x80000000u};
  uint64_t valv[]={0,1,2,0xFFULL,0xFFFFFFFFULL,0xFFFFFFFFFFFFFFFFULL,0xDEADBEEFCAFEBABEULL,0x8000000000000000ULL};
  uint32_t initb[]={0,1,7,32,63,64,65,100,0xFFFFFFFFu};
  for(unsigned a=0;a<sizeof(bitsv)/4;a++)
   for(unsigned b=0;b<sizeof(valv)/8;b++)
    for(unsigned c=0;c<sizeof(initb)/4;c++){
      bw_t w; memset(&w,0,sizeof w);
      w.val=valv[b]^0x5555555555555555ULL; w.bits=initb[c]; w.tot=0xFFFFFFF0u; w.pos=3; w.len=9;
      int r=f(&w,bitsv[a],valv[b]);
      printf("E %u %u %llu -> r=%d val=%016llx bits=%08x tot=%08x pos=%u len=%u\n",
        bitsv[a],initb[c],(unsigned long long)valv[b],r,(unsigned long long)w.val,w.bits,w.tot,w.pos,w.len);
    }
  /* random fuzz */
  for(int n=0;n<200000;n++){
    bw_t w; memset(&w,0,sizeof w);
    uint64_t x=rnd();
    w.val=rnd(); w.bits=(uint32_t)(rnd()%70); w.tot=(uint32_t)rnd(); w.pos=(uint32_t)rnd(); w.len=(uint32_t)rnd();
    uint32_t bb=(uint32_t)(x%70); uint64_t vv=rnd();
    int r=f(&w,bb,vv);
    printf("R %d %d %016llx %08x %08x\n",n,r,(unsigned long long)w.val,w.bits,w.tot);
  }
  return 0;
}
