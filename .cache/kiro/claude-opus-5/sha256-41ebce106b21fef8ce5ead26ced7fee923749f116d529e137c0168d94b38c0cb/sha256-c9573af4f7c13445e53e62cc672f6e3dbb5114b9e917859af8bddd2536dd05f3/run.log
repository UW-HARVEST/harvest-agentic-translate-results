[0m[49m[38;5;10m+    110[0m:[38;5;10m[49m                     t: rng.range(0.0, 40.0),
[0m[49m[38;5;10m+    111[0m:[38;5;10m[49m                 };
[0m[49m[38;5;10m+    112[0m:[38;5;10m[49m                 d.ray("c2RaytoCapsule(in-bb)", call_capsule(&p.c, A, B), call_capsule(&p.rs, A, B));
