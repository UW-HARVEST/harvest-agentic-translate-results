[0m[49m[38;5;10m+     122[0m:[38;5;10m[49m             let neg = c2Circle { p: centre, r: -r };
[0m[49m[38;5;10m+     123[0m:[38;5;10m[49m             let cpos = call_circle(&p.c, A, pos);
[0m[49m[38;5;10m+     124[0m:[38;5;10m[49m             let cneg = call_circle(&p.c, A, neg);
[0m[49m[38;5;10m+     125[0m:[38;5;10m[49m             d.ray("row 4: C r == -r", cpos, cneg);
[0m[49m[38;5;10m+     126[0m:[38;5;10m[49m             d.ray("row 4: neg radius", cneg, call_circle(&p.rs, A, neg));
[0m[49m[38;5;10m+     127[0m:[38;5;10m[49m         }
