[0m[49m[38;5;10m+     184[0m:[38;5;10m[49m                 ("row 8", c2v { x: 0.0, y: -(h + gap) }),
[0m[49m[38;5;10m+     185[0m:[38;5;10m[49m                 ("row 9", c2v { x: 0.0, y: h + gap }),
