[0m[49m[38;5;10m+     225[0m:[38;5;10m[49m             min: c2v { x: f32::NAN, y: f32::NAN },
[0m[49m[38;5;10m+     226[0m:[38;5;10m[49m             max: c2v { x: f32::NAN, y: f32::NAN },
[0m[49m[38;5;10m+     227[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+     228[0m:[38;5;10m[49m         let cv = (p.c.c2AABBtoAABB)(nanbox, nanbox);
[0m[49m[38;5;10m+     229[0m:[38;5;10m[49m         expect_c("row 10 (all NaN)", cv, 1);
[0m[49m[38;5;10m+     230[0m:[38;5;10m[49m         d.int("row 10: all NaN", cv, (p.rs.c2AABBtoAABB)(nanbox, nanbox));
[0m[49m[38;5;10m+     231[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     232[0m:[38;5;10m[49m     d.finish("ERRORS rows 6-10: c2AABBtoAABB rejections");
[0m[49m[38;5;10m+     233[0m:[38;5;10m[49m }
