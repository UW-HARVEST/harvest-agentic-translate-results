[0m[49m[38;5;10m+    126[0m:[38;5;10m[49m     let mut rng = Rng::new(0x39);
[0m[49m[38;5;10m+    127[0m:[38;5;10m[49m     unsafe {
[0m[49m[38;5;10m+    128[0m:[38;5;10m[49m         for _ in 0..(N * 2) {
[0m[49m[38;5;10m+    129[0m:[38;5;10m[49m             let B = rand_capsule(&mut rng);
[0m[49m[38;5;10m+    130[0m:[38;5;10m[49m             let f = frame(&B);
[0m[49m[38;5;10m+    131[0m:[38;5;10m[49m             for (uk, v) in [
[0m[49m[38;5;10m+    132[0m:[38;5;10m[49m                 (0.0f32, -0.5f32),
[0m[49m[38;5;10m+    133[0m:[38;5;10m[49m                 (0.5, -0.3),
[0m[49m[38;5;10m+    134[0m:[38;5;10m[49m                 (-0.5, -0.3),
[0m[49m[38;5;10m+    135[0m:[38;5;10m[49m                 (0.9, -0.05),
[0m[49m[38;5;10m+    136[0m:[38;5;10m[49m                 (0.0, 1.5),
[0m[49m[38;5;10m+    137[0m:[38;5;10m[49m                 (0.5, 1.3),
[0m[49m[38;5;10m+    138[0m:[38;5;10m[49m                 (-0.5, 1.3),
[0m[49m[38;5;10m+    139[0m:[38;5;10m[49m             ] {
