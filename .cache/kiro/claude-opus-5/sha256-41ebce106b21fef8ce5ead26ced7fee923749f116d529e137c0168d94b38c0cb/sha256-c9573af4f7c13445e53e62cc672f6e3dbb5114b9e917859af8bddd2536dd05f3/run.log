[0m[49m[38;5;10m+     192[0m:[38;5;10m[49m                 let cv = (p.c.c2AABBtoAABB)(A, B);
[0m[49m[38;5;10m+     193[0m:[38;5;10m[49m                 expect_c(row, cv, 0);
[0m[49m[38;5;10m+     194[0m:[38;5;10m[49m                 d.int(row, cv, (p.rs.c2AABBtoAABB)(A, B));
[0m[49m[38;5;10m+     195[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+     196[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+     197[0m:[38;5;10m[49m         // Row 10: any NaN coordinate makes all four `<` false, so the C
[0m[49m[38;5;10m+     198[0m:[38;5;10m[49m         // reports the boxes as OVERLAPPING.
[0m[49m[38;5;10m+     199[0m:[38;5;10m[49m         let sane = c2AABB {
[0m[49m[38;5;10m+     200[0m:[38;5;10m[49m             min: c2v { x: -1.0, y: -1.0 },
[0m[49m[38;5;10m+     201[0m:[38;5;10m[49m             max: c2v { x: 1.0, y: 1.0 },
[0m[49m[38;5;10m+     202[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+     203[0m:[38;5;10m[49m         for slot in 0..8 {
[0m[49m[38;5;10m+     204[0m:[38;5;10m[49m             let mut A = sane;
[0m[49m[38;5;10m+     205[0m:[38;5;10m[49m             let mut B = c2AABB {
[0m[49m[38;5;10m+     206[0m:[38;5;10m[49m                 min: c2v { x: 100.0, y: 100.0 },
[0m[49m[38;5;10m+     207[0m:[38;5;10m[49m                 max: c2v { x: 200.0, y: 200.0 },
[0m[49m[38;5;10m+     208[0m:[38;5;10m[49m             };
[0m[49m[38;5;10m+     209[0m:[38;5;10m[49m             let n = f32::NAN;
[0m[49m[38;5;10m+     210[0m:[38;5;10m[49m             match slot {
[0m[49m[38;5;10m+     211[0m:[38;5;10m[49m                 0 => A.min.x = n,
[0m[49m[38;5;10m+     212[0m:[38;5;10m[49m                 1 => A.min.y = n,
[0m[49m[38;5;10m+     213[0m:[38;5;10m[49m                 2 => A.max.x = n,
[0m[49m[38;5;10m+     214[0m:[38;5;10m[49m                 3 => A.max.y = n,
[0m[49m[38;5;10m+     215[0m:[38;5;10m[49m                 4 => B.min.x = n,
[0m[49m[38;5;10m+     216[0m:[38;5;10m[49m                 5 => B.min.y = n,
[0m[49m[38;5;10m+     217[0m:[38;5;10m[49m                 6 => B.max.x = n,
[0m[49m[38;5;10m+     218[0m:[38;5;10m[49m                 _ => B.max.y = n,
[0m[49m[38;5;10m+     219[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+     220[0m:[38;5;10m[49m             let cv = (p.c.c2AABBtoAABB)(A, B);
[0m[49m[38;5;10m+     221[0m:[38;5;10m[49m             d.int(&format!("row 10 (NaN slot {slot})"), cv, (p.rs.c2AABBtoAABB)(A, B));
[0m[49m[38;5;10m+     222[0m:[38;5;10m[49m         }
