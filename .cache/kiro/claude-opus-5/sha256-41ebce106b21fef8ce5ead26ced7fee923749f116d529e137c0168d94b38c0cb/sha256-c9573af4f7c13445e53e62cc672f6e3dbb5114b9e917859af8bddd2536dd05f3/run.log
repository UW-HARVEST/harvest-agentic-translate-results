[0m[49m[38;5;10m+     235[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+     236[0m:[38;5;10m[49m // Rows 11-18 — c2RaytoAABB (incl. the static c2RayToPlane_OneDimensional,
[0m[49m[38;5;10m+     237[0m:[38;5;10m[49m // which is not exported and can only be driven through c2RaytoAABB)
[0m[49m[38;5;10m+     238[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+     239[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     240[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+     241[0m:[38;5;10m[49m fn rows11_18_aabb_ray_rejections() {
[0m[49m[38;5;10m+     242[0m:[38;5;10m[49m     let p = load_pair();
[0m[49m[38;5;10m+     243[0m:[38;5;10m[49m     let mut d = Diff::new();
[0m[49m[38;5;10m+     244[0m:[38;5;10m[49m     let mut rng = Rng::new(0xE11);
[0m[49m[38;5;10m+     245[0m:[38;5;10m[49m     unsafe {
[0m[49m[38;5;10m+     246[0m:[38;5;10m[49m         // Row 14: the ray's own AABB does not overlap B at all.
[0m[49m[38;5;10m+     247[0m:[38;5;10m[49m         for _ in 0..3000 {
[0m[49m[38;5;10m+     248[0m:[38;5;10m[49m             let B = c2AABB {
[0m[49m[38;5;10m+     249[0m:[38;5;10m[49m                 min: c2v { x: -1.0, y: -1.0 },
[0m[49m[38;5;10m+     250[0m:[38;5;10m[49m                 max: c2v { x: 1.0, y: 1.0 },
[0m[49m[38;5;10m+     251[0m:[38;5;10m[49m             };
[0m[49m[38;5;10m+     252[0m:[38;5;10m[49m             let far = 50.0 + rng.range(0.0, 100.0);
[0m[49m[38;5;10m+     253[0m:[38;5;10m[49m             let dir = rng.v_dir();
[0m[49m[38;5;10m+     254[0m:[38;5;10m[49m             let A = c2Ray {
[0m[49m[38;5;10m+     255[0m:[38;5;10m[49m                 p: c2v { x: far, y: far },
[0m[49m[38;5;10m+     256[0m:[38;5;10m[49m                 d: dir,
[0m[49m[38;5;10m+     257[0m:[38;5;10m[49m                 t: 1.0,
[0m[49m[38;5;10m+     258[0m:[38;5;10m[49m             };
[0m[49m[38;5;10m+     259[0m:[38;5;10m[49m             let cr = call_aabb(&p.c, A, B);
[0m[49m[38;5;10m+     260[0m:[38;5;10m[49m             expect_c("row 14", cr.0, 0);
[0m[49m[38;5;10m+     261[0m:[38;5;10m[49m             untouched("row 14", "C", cr.1);
[0m[49m[38;5;10m+     262[0m:[38;5;10m[49m             d.ray("row 14: ray bbox disjoint", cr, call_aabb(&p.rs, A, B));
[0m[49m[38;5;10m+     263[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+     264[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     265[0m:[38;5;10m[49m         // Row 15: bboxes overlap but the separating-axis test `d > 0` rejects.
[0m[49m[38;5;10m+     266[0m:[38;5;10m[49m         // A long diagonal ray whose bbox contains the box but whose line
[0m[49m[38;5;10m+     267[0m:[38;5;10m[49m         // passes outside it.
[0m[49m[38;5;10m+     268[0m:[38;5;10m[49m         let B = c2AABB {
[0m[49m[38;5;10m+     269[0m:[38;5;10m[49m             min: c2v { x: -1.0, y: -1.0 },
[0m[49m[38;5;10m+     270[0m:[38;5;10m[49m             max: c2v { x: 1.0, y: 1.0 },
[0m[49m[38;5;10m+     271[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+     272[0m:[38;5;10m[49m         let mut row15_hits = 0;
[0m[49m[38;5;10m+     273[0m:[38;5;10m[49m         for _ in 0..4000 {
[0m[49m[38;5;10m+     274[0m:[38;5;10m[49m             let s = rng.range(3.0, 40.0);
[0m[49m[38;5;10m+     275[0m:[38;5;10m[49m             // start bottom-left, end top-right, but shifted so the line misses
[0m[49m[38;5;10m+     276[0m:[38;5;10m[49m             let shift = rng.range(2.5, 10.0) * if rng.bool() { 1.0 } else { -1.0 };
[0m[49m[38;5;10m+     277[0m:[38;5;10m[49m             let A = c2Ray {
[0m[49m[38;5;10m+     278[0m:[38;5;10m[49m                 p: c2v { x: -s + shift, y: -s },
[0m[49m[38;5;10m+     279[0m:[38;5;10m[49m                 d: c2Norm_local(c2v { x: 1.0, y: 1.0 }),
[0m[49m[38;5;10m+     280[0m:[38;5;10m[49m                 t: 2.0 * s * 1.5,
[0m[49m[38;5;10m+     281[0m:[38;5;10m[49m             };
[0m[49m[38;5;10m+     282[0m:[38;5;10m[49m             let cr = call_aabb(&p.c, A, B);
[0m[49m[38;5;10m+     283[0m:[38;5;10m[49m             if cr.0 == 0 && cast_eq(cr.1, POISON) {
[0m[49m[38;5;10m+     284[0m:[38;5;10m[49m                 row15_hits += 1;
[0m[49m[38;5;10m+     285[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+     286[0m:[38;5;10m[49m             d.ray("row 15: SAT reject", cr, call_aabb(&p.rs, A, B));
[0m[49m[38;5;10m+     287[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+     288[0m:[38;5;10m[49m         assert!(row15_hits > 0, "[row 15] never produced a SAT rejection");
[0m[49m[38;5;10m+     289[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     290[0m:[38;5;10m[49m         // Row 16: every t_i > 1.0 -> hit == 0.  Row 11/12/13: the three exits of
[0m[49m[38;5;10m+     291[0m:[38;5;10m[49m         // c2RayToPlane_OneDimensional. All are driven by placing the ray so
[0m[49m[38;5;10m+     292[0m:[38;5;10m[49m         // that `da < 0`, `da*db > 0`, or `da == db`.
[0m[49m[38;5;10m+     293[0m:[38;5;10m[49m         //   da == db happens whenever p0 and p1 have the same coordinate on the
[0m[49m[38;5;10m+     294[0m:[38;5;10m[49m         //   tested axis, i.e. for axis-aligned rays and for A.t == 0.
[0m[49m[38;5;10m+     295[0m:[38;5;10m[49m         for _ in 0..3000 {
[0m[49m[38;5;10m+     296[0m:[38;5;10m[49m             let bx = rng.sym(6.0);
[0m[49m[38;5;10m+     297[0m:[38;5;10m[49m             let by = rng.sym(6.0);
