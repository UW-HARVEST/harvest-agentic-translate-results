[0m[49m[38;5;10m+     155[0m:[38;5;10m[49m // Rows 6-10 — c2AABBtoAABB
[0m[49m[38;5;10m+     156[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+     157[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     158[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+     159[0m:[38;5;10m[49m fn rows06_10_aabbtoaabb_rejections() {
[0m[49m[38;5;10m+     160[0m:[38;5;10m[49m     let p = load_pair();
[0m[49m[38;5;10m+     161[0m:[38;5;10m[49m     let mut d = Diff::new();
[0m[49m[38;5;10m+     162[0m:[38;5;10m[49m     let mut rng = Rng::new(0xE06);
[0m[49m[38;5;10m+     163[0m:[38;5;10m[49m     unsafe {
[0m[49m[38;5;10m+     164[0m:[38;5;10m[49m         let base = |rng: &mut Rng| {
[0m[49m[38;5;10m+     165[0m:[38;5;10m[49m             let x = rng.sym(10.0);
[0m[49m[38;5;10m+     166[0m:[38;5;10m[49m             let y = rng.sym(10.0);
[0m[49m[38;5;10m+     167[0m:[38;5;10m[49m             c2AABB {
[0m[49m[38;5;10m+     168[0m:[38;5;10m[49m                 min: c2v { x, y },
[0m[49m[38;5;10m+     169[0m:[38;5;10m[49m                 max: c2v { x: x + rng.range(0.5, 6.0), y: y + rng.range(0.5, 6.0) },
[0m[49m[38;5;10m+     170[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+     171[0m:[38;5;10m[49m         };
