[0m[49m[38;5;10m+    177[0m:[38;5;10m[49m                             t: rng.range(0.0, 60.0),
[0m[49m[38;5;10m+    178[0m:[38;5;10m[49m                         };
[0m[49m[38;5;10m+    179[0m:[38;5;10m[49m                         d.ray("c2RaytoCapsule(deleg)", call_capsule(&p.c, A, B), call_capsule(&p.rs, A, B));
[0m[49m[38;5;10m+    180[0m:[38;5;10m[49m                     }
[0m[49m[38;5;10m+    181[0m:[38;5;10m[49m                     let A = c2Ray { p: origin, d: rng.v_dir(), t: rng.range(0.0, 60.0) };
[0m[49m[38;5;10m+    182[0m:[38;5;10m[49m                     d.ray("c2RaytoCapsule(deleg-rnd)", call_capsule(&p.c, A, B), call_capsule(&p.rs, A, B));
[0m[49m[38;5;10m+    183[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    184[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    185[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    186[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    187[0m:[38;5;10m[49m     d.finish("row 40: c2RaytoCapsule |yAp.x| < r delegation");
[0m[49m[38;5;10m+    188[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    189[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    190[0m:[38;5;10m[49m /// Row 41: the side-wall branch. Origin has `|u| >= r`, the ray crosses the
[0m[49m[38;5;10m+    191[0m:[38;5;10m[49m /// `u = ±r` wall plane, and the crossing height `y` selects cap A, cap B or a
[0m[49m[38;5;10m+    192[0m:[38;5;10m[49m /// genuine wall hit (with the `M.x` vs `c2Skew(M.y)` normal choice).
[0m[49m[38;5;10m+    193[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    194[0m:[38;5;10m[49m fn row41_capsule_side_wall() {
[0m[49m[38;5;10m+    195[0m:[38;5;10m[49m     let p = load_pair();
[0m[49m[38;5;10m+    196[0m:[38;5;10m[49m     let mut d = Diff::new();
[0m[49m[38;5;10m+    197[0m:[38;5;10m[49m     let mut rng = Rng::new(0x41);
[0m[49m[38;5;10m+    198[0m:[38;5;10m[49m     unsafe {
[0m[49m[38;5;10m+    199[0m:[38;5;10m[49m         for _ in 0..(N * 4) {
[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m             let B = rand_capsule(&mut rng);
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m             let f = frame(&B);
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m             for side in [1.0f32, -1.0] {
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m                 let u0 = side * (B.r + rng.range(0.01, 20.0));
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m                 // target height on the wall: below 0, inside, above len
[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m                 for vt in [
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m                     -rng.range(0.1, 5.0) * B.r,
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m                     rng.range(0.05, 0.95) * f.len,
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m                     f.len + rng.range(0.1, 5.0) * B.r,
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m                     0.0,
[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m                     f.len,
[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m                 ] {
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m                     let v0 = vt + rng.sym(4.0);
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m                     let origin = f.to_world(u0, v0);
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m                     // direction that crosses u = side*r at height vt when
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m                     // travelling the full ray length
[0m[49m[38;5;10m+    216[0m:[38;5;10m[49m                     let target = f.to_world(side * B.r, vt);
[0m[49m[38;5;10m+    217[0m:[38;5;10m[49m                     let dx = target.x - origin.x;
[0m[49m[38;5;10m+    218[0m:[38;5;10m[49m                     let dy = target.y - origin.y;
[0m[49m[38;5;10m+    219[0m:[38;5;10m[49m                     let l = (dx * dx + dy * dy).sqrt();
[0m[49m[38;5;10m+    220[0m:[38;5;10m[49m                     if !(l > 0.0) {
[0m[49m[38;5;10m+    221[0m:[38;5;10m[49m                         continue;
[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m                     }
[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m                     let dir = c2v { x: dx / l, y: dy / l };
[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m                     for tk in [0.5f32, 1.0, 2.0, 1.0e-3] {
[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m                         let A = c2Ray { p: origin, d: dir, t: l * tk };
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m                         d.ray("c2RaytoCapsule(wall)", call_capsule(&p.c, A, B), call_capsule(&p.rs, A, B));
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m                     }
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m                     // and the same geometry with an unnormalised direction
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m                     let A = c2Ray {
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m                         p: origin,
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m                         d: c2v { x: dx, y: dy },
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m                         t: rng.range(0.0, 2.0),
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m                     };
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m                     d.ray("c2RaytoCapsule(wall-unnorm)", call_capsule(&p.c, A, B), call_capsule(&p.rs, A, B));
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    236[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    237[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m     d.finish("row 41: c2RaytoCapsule side wall");
[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m /// Row 42: axis-aligned capsules crossed by axis-aligned rays — makes
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m /// `yAd.x`/`yAe.x - yAp.x` exactly zero very often.
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m fn row42_capsule_axis_aligned() {
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m     let p = load_pair();
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m     let mut d = Diff::new();
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m     let mut rng = Rng::new(0x42);
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m     unsafe {
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m         for _ in 0..(N * 2) {
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m             let a = rng.v_small();
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m             let len = rng.range(0.2, 16.0);
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m             let r = rng.range(0.05, 6.0);
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m             for axis in 0..4 {
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m                 let b = match axis {
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m                     0 => c2v { x: a.x + len, y: a.y },
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m                     1 => c2v { x: a.x - len, y: a.y },
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m                     2 => c2v { x: a.x, y: a.y + len },
[0m[49m[38;5;10m+    259[0m:[38;5;10m[49m                     _ => c2v { x: a.x, y: a.y - len },
[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m                 };
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m                 let B = c2Capsule { a, b, r };
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m                 for dir in AXIS_DIRS {
[0m[49m[38;5;10m+    263[0m:[38;5;10m[49m                     for off in [0.0f32, 0.5, 1.0, 1.5, -0.5, -1.0] {
[0m[49m[38;5;10m+    264[0m:[38;5;10m[49m                         let origin = c2v {
[0m[49m[38;5;10m+    265[0m:[38;5;10m[49m                             x: a.x - dir.x * 20.0 + if dir.x == 0.0 { off * r } else { 0.0 },
[0m[49m[38;5;10m+    266[0m:[38;5;10m[49m                             y: a.y - dir.y * 20.0 + if dir.y == 0.0 { off * r } else { 0.0 },
[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m                         };
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m                         for t in [0.0f32, 10.0, 20.0, 40.0] {
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m                             let A = c2Ray { p: origin, d: dir, t };
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m                             d.ray("c2RaytoCapsule(axis)", call_capsule(&p.c, A, B), call_capsule(&p.rs, A, B));
[0m[49m[38;5;10m+    271[0m:[38;5;10m[49m                         }
[0m[49m[38;5;10m+    272[0m:[38;5;10m[49m                     }
[0m[49m[38;5;10m+    273[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    274[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    275[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    277[0m:[38;5;10m[49m     d.finish("row 42: c2RaytoCapsule axis-aligned");
[0m[49m[38;5;10m+    278[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    279[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    280[0m:[38;5;10m[49m /// Row 43: degenerate capsules — `a == b` (the axis normalises to NaN),
[0m[49m[38;5;10m+    281[0m:[38;5;10m[49m /// `r == 0`, `r < 0`, `A.t == 0`, and fully non-finite inputs.
[0m[49m[38;5;10m+    282[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    283[0m:[38;5;10m[49m fn row43_capsule_degenerate() {
[0m[49m[38;5;10m+    284[0m:[38;5;10m[49m     let p = load_pair();
[0m[49m[38;5;10m+    285[0m:[38;5;10m[49m     let mut d = Diff::new();
[0m[49m[38;5;10m+    286[0m:[38;5;10m[49m     let mut rng = Rng::new(0x43);
[0m[49m[38;5;10m+    287[0m:[38;5;10m[49m     unsafe {
