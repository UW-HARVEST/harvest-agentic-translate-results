[0m[49m[38;5;10m+    141[0m:[38;5;10m[49m                 let vv = if v < 0.0 { v * B.r } else { f.len + (v - 1.0) * B.r };
[0m[49m[38;5;10m+    142[0m:[38;5;10m[49m                 let A = c2Ray {
[0m[49m[38;5;10m+    143[0m:[38;5;10m[49m                     p: f.to_world(uk * B.r, vv),
[0m[49m[38;5;10m+    144[0m:[38;5;10m[49m                     d: rng.v_dir(),
[0m[49m[38;5;10m+    145[0m:[38;5;10m[49m                     t: rng.range(0.0, 40.0),
[0m[49m[38;5;10m+    146[0m:[38;5;10m[49m                 };
[0m[49m[38;5;10m+    147[0m:[38;5;10m[49m                 d.ray("c2RaytoCapsule(in-cap)", call_capsule(&p.c, A, B), call_capsule(&p.rs, A, B));
[0m[49m[38;5;10m+    148[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    149[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    150[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    151[0m:[38;5;10m[49m     d.finish("row 39: c2RaytoCapsule origin in end-caps");
[0m[49m[38;5;10m+    152[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    153[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    154[0m:[38;5;10m[49m /// Row 40: `|yAp.x| < B.r` while outside the bb and both caps → delegate to
[0m[49m[38;5;10m+    155[0m:[38;5;10m[49m /// circle A (`yAp.y < 0`) or circle B (`yAp.y >= 0`).
[0m[49m[38;5;10m+    156[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    157[0m:[38;5;10m[49m fn row40_capsule_delegate_by_sign() {
[0m[49m[38;5;10m+    158[0m:[38;5;10m[49m     let p = load_pair();
[0m[49m[38;5;10m+    159[0m:[38;5;10m[49m     let mut d = Diff::new();
[0m[49m[38;5;10m+    160[0m:[38;5;10m[49m     let mut rng = Rng::new(0x40);
[0m[49m[38;5;10m+    161[0m:[38;5;10m[49m     unsafe {
[0m[49m[38;5;10m+    162[0m:[38;5;10m[49m         for _ in 0..(N * 3) {
[0m[49m[38;5;10m+    163[0m:[38;5;10m[49m             let B = rand_capsule(&mut rng);
[0m[49m[38;5;10m+    164[0m:[38;5;10m[49m             let f = frame(&B);
[0m[49m[38;5;10m+    165[0m:[38;5;10m[49m             // |u| < r but v far outside [ -r, len + r ] so the caps reject
[0m[49m[38;5;10m+    166[0m:[38;5;10m[49m             for u in [0.0f32, 0.5, -0.5, 0.95, -0.95] {
[0m[49m[38;5;10m+    167[0m:[38;5;10m[49m                 for v in [
