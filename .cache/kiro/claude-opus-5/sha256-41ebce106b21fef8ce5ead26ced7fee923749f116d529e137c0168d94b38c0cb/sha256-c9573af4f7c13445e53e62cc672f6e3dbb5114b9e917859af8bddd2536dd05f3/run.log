[0m[49m[38;5;10m+    119[0m:[38;5;10m[49m /// Row 39: ray origin inside end-cap A / end-cap B but OUTSIDE the local bb
[0m[49m[38;5;10m+    120[0m:[38;5;10m[49m /// (`v < 0` or `v > len`), which is the only way to reach the
[0m[49m[38;5;10m+    121[0m:[38;5;10m[49m /// `c2CircleToPoint` early returns.
[0m[49m[38;5;10m+    122[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    123[0m:[38;5;10m[49m fn row39_capsule_origin_in_caps() {
[0m[49m[38;5;10m+    124[0m:[38;5;10m[49m     let p = load_pair();
