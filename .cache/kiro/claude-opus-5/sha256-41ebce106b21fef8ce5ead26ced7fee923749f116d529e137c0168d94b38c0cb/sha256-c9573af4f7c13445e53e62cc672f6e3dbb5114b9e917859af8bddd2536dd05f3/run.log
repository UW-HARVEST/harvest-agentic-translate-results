[0m[49m[38;5;10m+     174[0m:[38;5;10m[49m             let w = A.max.x - A.min.x;
[0m[49m[38;5;10m+     175[0m:[38;5;10m[49m             let h = A.max.y - A.min.y;
[0m[49m[38;5;10m+     176[0m:[38;5;10m[49m             let gap = rng.range(0.01, 10.0);
[0m[49m[38;5;10m+     177[0m:[38;5;10m[49m             // Row 6: B.max.x < A.min.x
[0m[49m[38;5;10m+     178[0m:[38;5;10m[49m             // Row 7: A.max.x < B.min.x
[0m[49m[38;5;10m+     179[0m:[38;5;10m[49m             // Row 8: B.max.y < A.min.y
[0m[49m[38;5;10m+     180[0m:[38;5;10m[49m             // Row 9: A.max.y < B.min.y
[0m[49m[38;5;10m+     181[0m:[38;5;10m[49m             let cases = [
[0m[49m[38;5;10m+     182[0m:[38;5;10m[49m                 ("row 6", c2v { x: -(w + gap), y: 0.0 }),
