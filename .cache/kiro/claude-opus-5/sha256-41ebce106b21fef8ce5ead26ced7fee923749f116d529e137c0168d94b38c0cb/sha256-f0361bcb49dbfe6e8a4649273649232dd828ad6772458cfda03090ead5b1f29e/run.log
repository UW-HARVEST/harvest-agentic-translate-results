[0m[49m[38;5;10m+    578[0m:[38;5;10m[49m             x: p.verts[j].x - p.verts[i].x,
[0m[49m[38;5;10m+    579[0m:[38;5;10m[49m             y: p.verts[j].y - p.verts[i].y,
[0m[49m[38;5;10m+    580[0m:[38;5;10m[49m         };
