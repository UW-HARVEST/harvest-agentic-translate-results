[0m[49m[38;5;10m+    570[0m:[38;5;10m[49m         p.verts[i] = C2v {
[0m[49m[38;5;10m+    571[0m:[38;5;10m[49m             x: c.x + rad * a.cos(),
[0m[49m[38;5;10m+    572[0m:[38;5;10m[49m             y: c.y + rad * a.sin(),
[0m[49m[38;5;10m+    573[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+    574[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    575[0m:[38;5;10m[49m     for i in 0..n {
