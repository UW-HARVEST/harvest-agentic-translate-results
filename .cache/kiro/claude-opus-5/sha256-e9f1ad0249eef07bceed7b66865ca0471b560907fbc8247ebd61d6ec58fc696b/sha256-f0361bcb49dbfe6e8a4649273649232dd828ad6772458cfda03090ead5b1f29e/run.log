import re
c=open('c_src/src/lib.c').read()
r=open('translation/src/lib.rs').read()

def cparse(name, rows, cols):
    i=c.index('g_scf_'+name)
    i=c.index('{',i)
    # find matching close brace
    d=0
    for j in range(i,len(c)):
        if c[j]=='{': d+=1
        elif c[j]=='}':
            d-=1
            if d==0: break
    body=c[i+1:j]
    out=[]
    for m in re.finditer(r'\{([^{}]*)\}', body):
        vals=[int(x) for x in re.findall(r'\d+', m.group(1))]
        out.append(vals+[0]*(cols-len(vals)))
    assert len(out)==rows,(name,len(out))
    return out

def rparse(name, rows, cols):
    i=r.index('G_SCF_'+name+':')
    i=r.index('= [',i)
    d=0
    for j in range(i,len(r)):
        if r[j]=='[': d+=1
        elif r[j]==']':
            d-=1
            if d==0: break
    body=r[i+3:j]
    out=[]
    for m in re.finditer(r'\[([^\[\]]*)\]', body):
        vals=[int(x) for x in re.findall(r'\d+', m.group(1))]
        out.append(vals)
    assert len(out)==rows,(name,len(out))
    for v in out: assert len(v)==cols,(name,len(v))
    return out

for name,rows,cols in [('long',8,23),('short',8,40),('mixed',8,40)]:
    a=cparse(name,rows,cols); b=rparse(name.upper(),rows,cols)
    if a==b: print(f"g_scf_{name}: IDENTICAL ({rows}x{cols})")
    else:
        for k,(x,y) in enumerate(zip(a,b)):
            if x!=y: print(f"g_scf_{name} row {k} MISMATCH\n C: {x}\n R: {y}")
