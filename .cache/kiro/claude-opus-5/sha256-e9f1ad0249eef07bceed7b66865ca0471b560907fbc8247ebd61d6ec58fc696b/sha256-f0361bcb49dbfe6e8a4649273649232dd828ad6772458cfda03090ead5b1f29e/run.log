[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    263[0m:[38;5;10m[49m // Side-info generation: mirrors the C read order so any configuration can be
[0m[49m[38;5;10m+    264[0m:[38;5;10m[49m // produced deliberately.
[0m[49m[38;5;10m+    265[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    266[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m #[derive(Clone, Copy, Debug)]
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m pub struct GrChoice {
