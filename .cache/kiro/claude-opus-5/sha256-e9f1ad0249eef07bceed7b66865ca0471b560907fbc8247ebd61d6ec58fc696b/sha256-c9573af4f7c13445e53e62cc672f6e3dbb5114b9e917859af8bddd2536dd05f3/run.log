[0m[49m[38;5;10m+    572[0m:[38;5;10m[49m                 assert_eq!(c_result(&input), baseline_c, "U4: hdr[0] must be ignored by C");
[0m[49m[38;5;10m+    573[0m:[38;5;10m[49m                 assert_eq!(rust_result(&input), baseline_r, "U4: hdr[0] must be ignored by Rust");
[0m[49m[38;5;10m+    574[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    575[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    576[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    577[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    578[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    579[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    580[0m:[38;5;10m[49m // Generic FFI boundary abuse: out-of-range "enum-like" values and extreme ints
[0m[49m[38;5;10m+    581[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    582[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    583[0m:[38;5;10m[49m /// The C API has no enums, but the three header bytes it reads are treated as
[0m[49m[38;5;10m+    584[0m:[38;5;10m[49m /// bit-flag/index sources with no validation: `hdr[1]` bits 3-4 and `hdr[2]`
[0m[49m[38;5;10m+    585[0m:[38;5;10m[49m /// bits 2-3 index the tables, `hdr[3]` bits 6-7 select the channel mode. All
[0m[49m[38;5;10m+    586[0m:[38;5;10m[49m /// 2^24 combinations of the bits actually read are valid C inputs. Sweep every
[0m[49m[38;5;10m+    587[0m:[38;5;10m[49m /// one of the read bit-fields exhaustively (4 x 4 x 4 = 64 combinations of
[0m[49m[38;5;10m+    588[0m:[38;5;10m[49m /// (b3,b4) x base x hdr[3] mode, times full random noise elsewhere).
[0m[49m[38;5;10m+    589[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    590[0m:[38;5;10m[49m fn ffi_all_header_bitfield_combinations() {
[0m[49m[38;5;10m+    591[0m:[38;5;10m[49m     let mut rng = rng_for("FFI-HDR");
[0m[49m[38;5;10m+    592[0m:[38;5;10m[49m     for h1_lo in 0..4u8 {
[0m[49m[38;5;10m+    593[0m:[38;5;10m[49m         // bits 3 and 4 of hdr[1]
[0m[49m[38;5;10m+    594[0m:[38;5;10m[49m         for base in 0..4u8 {
[0m[49m[38;5;10m+    595[0m:[38;5;10m[49m             for mode in 0..4u8 {
[0m[49m[38;5;10m+    596[0m:[38;5;10m[49m                 for _ in 0..64 {
[0m[49m[38;5;10m+    597[0m:[38;5;10m[49m                     let mut hdr = [0u8; 4];
[0m[49m[38;5;10m+    598[0m:[38;5;10m[49m                     hdr[0] = rng.next_u32() as u8;
[0m[49m[38;5;10m+    599[0m:[38;5;10m[49m                     hdr[1] = ((rng.next_u32() as u8) & !0x18) | (h1_lo << 3);
[0m[49m[38;5;10m+    600[0m:[38;5;10m[49m                     hdr[2] = ((rng.next_u32() as u8) & !0x0C) | (base << 2);
[0m[49m[38;5;10m+    601[0m:[38;5;10m[49m                     hdr[3] = ((rng.next_u32() as u8) & 0x3F) | (mode << 6);
[0m[49m[38;5;10m+    602[0m:[38;5;10m[49m                     let mut buf = vec![0u8; BUF_BYTES];
[0m[49m[38;5;10m+    603[0m:[38;5;10m[49m                     for b in buf.iter_mut() {
[0m[49m[38;5;10m+    604[0m:[38;5;10m[49m                         *b = rng.next_u32() as u8;
[0m[49m[38;5;10m+    605[0m:[38;5;10m[49m                     }
[0m[49m[38;5;10m+    606[0m:[38;5;10m[49m                     let pos = rng.range_i32(0, 63);
[0m[49m[38;5;10m+    607[0m:[38;5;10m[49m                     let limit = rng.range_i32(-4, 4096);
[0m[49m[38;5;10m+    608[0m:[38;5;10m[49m                     let input = Input {
[0m[49m[38;5;10m+    609[0m:[38;5;10m[49m                         hdr,
[0m[49m[38;5;10m+    610[0m:[38;5;10m[49m                         buf,
[0m[49m[38;5;10m+    611[0m:[38;5;10m[49m                         pos,
[0m[49m[38;5;10m+    612[0m:[38;5;10m[49m                         limit,
[0m[49m[38;5;10m+    613[0m:[38;5;10m[49m                         desc: format!(
[0m[49m[38;5;10m+    614[0m:[38;5;10m[49m                             "FFI-HDR h1_lo={h1_lo} base={base} mode={mode} hdr={hdr:02x?} pos={pos} limit={limit}"
[0m[49m[38;5;10m+    615[0m:[38;5;10m[49m                         ),
[0m[49m[38;5;10m+    616[0m:[38;5;10m[49m                     };
[0m[49m[38;5;10m+    617[0m:[38;5;10m[49m                     compare("FFI-HDR", &input);
[0m[49m[38;5;10m+    618[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    619[0m:[38;5;10m[49m             }
