[0m[49m[38;5;10m+    460[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    461[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    462[0m:[38;5;10m[49m /// Sweep the reservoir slack from far-under to far-over so the `>` comparison
[0m[49m[38;5;10m+    463[0m:[38;5;10m[49m /// itself is pinned down, including negative `limit + main_data_begin*8`.
[0m[49m[38;5;10m+    464[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    465[0m:[38;5;10m[49m fn e5b_reservoir_slack_sweep() {
[0m[49m[38;5;10m+    466[0m:[38;5;10m[49m     let mut rng = rng_for("E5b");
[0m[49m[38;5;10m+    467[0m:[38;5;10m[49m     for ext in [false, true] {
[0m[49m[38;5;10m+    468[0m:[38;5;10m[49m         for mono in [false, true] {
[0m[49m[38;5;10m+    469[0m:[38;5;10m[49m             for _ in 0..64 {
[0m[49m[38;5;10m+    470[0m:[38;5;10m[49m                 let sr = srs(ext)[rng.below(srs(ext).len() as u32) as usize];
[0m[49m[38;5;10m+    471[0m:[38;5;10m[49m                 let hdr = hdr_for(ext, mono, sr, &mut rng);
[0m[49m[38;5;10m+    472[0m:[38;5;10m[49m                 let n = gr_count_of(&hdr) as usize;
[0m[49m[38;5;10m+    473[0m:[38;5;10m[49m                 let blocks: Vec<Blk> = (0..n).map(|_| Blk::rand(&mut rng)).collect();
[0m[49m[38;5;10m+    474[0m:[38;5;10m[49m                 let base = BuildOpts {
[0m[49m[38;5;10m+    475[0m:[38;5;10m[49m                     blocks,
[0m[49m[38;5;10m+    476[0m:[38;5;10m[49m                     main_data_begin: Some(0),
[0m[49m[38;5;10m+    477[0m:[38;5;10m[49m                     part_23_length: Some(100),
[0m[49m[38;5;10m+    478[0m:[38;5;10m[49m                     limit: LimitMode::Ample,
[0m[49m[38;5;10m+    479[0m:[38;5;10m[49m                     ..Default::default()
[0m[49m[38;5;10m+    480[0m:[38;5;10m[49m                 };
[0m[49m[38;5;10m+    481[0m:[38;5;10m[49m                 let probe = build(hdr, &base, &mut rng);
[0m[49m[38;5;10m+    482[0m:[38;5;10m[49m                 // `probe.limit` is Ample; walk a window of literal limits around
[0m[49m[38;5;10m+    483[0m:[38;5;10m[49m                 // the true boundary and require identical sentinels throughout.
[0m[49m[38;5;10m+    484[0m:[38;5;10m[49m                 let boundary = 100 * n as i32 + 200; // upper bound on p23sum + pos
[0m[49m[38;5;10m+    485[0m:[38;5;10m[49m                 for delta in -8..=8i32 {
[0m[49m[38;5;10m+    486[0m:[38;5;10m[49m                     let opts = BuildOpts {
[0m[49m[38;5;10m+    487[0m:[38;5;10m[49m                         limit: LimitMode::Literal(boundary + delta),
[0m[49m[38;5;10m+    488[0m:[38;5;10m[49m                         ..BuildOpts {
[0m[49m[38;5;10m+    489[0m:[38;5;10m[49m                             blocks: base.blocks.clone(),
[0m[49m[38;5;10m+    490[0m:[38;5;10m[49m                             main_data_begin: Some(0),
[0m[49m[38;5;10m+    491[0m:[38;5;10m[49m                             part_23_length: Some(100),
[0m[49m[38;5;10m+    492[0m:[38;5;10m[49m                             limit: LimitMode::Ample,
[0m[49m[38;5;10m+    493[0m:[38;5;10m[49m                             ..Default::default()
[0m[49m[38;5;10m+    494[0m:[38;5;10m[49m                         }
[0m[49m[38;5;10m+    495[0m:[38;5;10m[49m                     };
[0m[49m[38;5;10m+    496[0m:[38;5;10m[49m                     let input = build(hdr, &opts, &mut rng);
[0m[49m[38;5;10m+    497[0m:[38;5;10m[49m                     compare("E5b", &input);
[0m[49m[38;5;10m+    498[0m:[38;5;10m[49m                     assert_eq!(c_result(&input), rust_result(&input));
[0m[49m[38;5;10m+    499[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    500[0m:[38;5;10m[49m                 let _ = probe;
[0m[49m[38;5;10m+    501[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    502[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    503[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    504[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    505[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    506[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
