[0m[49m[38;5;10m+    519[0m:[38;5;10m[49m                 assert_eq!(sr_idx_of(&hdr), 8, "U1: sr_idx must be 8");
[0m[49m[38;5;10m+    520[0m:[38;5;10m[49m                 let opts = BuildOpts {
