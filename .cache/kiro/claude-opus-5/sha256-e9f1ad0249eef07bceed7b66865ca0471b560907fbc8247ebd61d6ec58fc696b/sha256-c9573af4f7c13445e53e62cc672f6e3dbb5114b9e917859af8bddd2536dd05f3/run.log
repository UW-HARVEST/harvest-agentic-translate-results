[0m[49m[38;5;10m+    510[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    511[0m:[38;5;10m[49m fn u1_sr_idx_out_of_range() {
[0m[49m[38;5;10m+    512[0m:[38;5;10m[49m     let mut rng = rng_for("U1");
