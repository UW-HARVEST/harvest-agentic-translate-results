[0m[49m[38;5;10m+    522[0m:[38;5;10m[49m                     big_values: Some(rng.below(289)),
[0m[49m[38;5;10m+    523[0m:[38;5;10m[49m                     ..Default::default()
[0m[49m[38;5;10m+    524[0m:[38;5;10m[49m                 };
[0m[49m[38;5;10m+    525[0m:[38;5;10m[49m                 let input = build(hdr, &opts, &mut rng);
[0m[49m[38;5;10m+    526[0m:[38;5;10m[49m                 compare("U1", &input);
[0m[49m[38;5;10m+    527[0m:[38;5;10m[49m                 let (cg, _, crv) = unsafe { run(c, &input) };
[0m[49m[38;5;10m+    528[0m:[38;5;10m[49m                 let (rg, _, rrv) = unsafe { run(r, &input) };
[0m[49m[38;5;10m+    529[0m:[38;5;10m[49m                 assert_eq!(crv, rrv);
[0m[49m[38;5;10m+    530[0m:[38;5;10m[49m                 assert_ne!(crv, -1, "U1: sr_idx 8 is NOT rejected by the C");
[0m[49m[38;5;10m+    531[0m:[38;5;10m[49m                 let t = match blk {
[0m[49m[38;5;10m+    532[0m:[38;5;10m[49m                     Blk::S2M0 => T_SHORT,
[0m[49m[38;5;10m+    533[0m:[38;5;10m[49m                     Blk::S2M1 => T_MIXED,
[0m[49m[38;5;10m+    534[0m:[38;5;10m[49m                     _ => T_LONG,
[0m[49m[38;5;10m+    535[0m:[38;5;10m[49m                 };
[0m[49m[38;5;10m+    536[0m:[38;5;10m[49m                 seen[t] = true;
[0m[49m[38;5;10m+    537[0m:[38;5;10m[49m                 let coff = (cg[0].sfbtab as usize).wrapping_sub(c.table_bases[t]);
[0m[49m[38;5;10m+    538[0m:[38;5;10m[49m                 let roff = (rg[0].sfbtab as usize).wrapping_sub(r.table_bases[t]);
[0m[49m[38;5;10m+    539[0m:[38;5;10m[49m                 assert_eq!(coff, 8 * ROW_SIZE[t], "U1: C offset must be 8 rows past base");
[0m[49m[38;5;10m+    540[0m:[38;5;10m[49m                 assert_eq!(roff, 8 * ROW_SIZE[t], "U1: Rust offset must be 8 rows past base");
[0m[49m[38;5;10m+    541[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    542[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    543[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    544[0m:[38;5;10m[49m     assert_eq!(seen, [true, true, true], "U1 must cover all three tables");
[0m[49m[38;5;10m+    545[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    546[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    547[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    548[0m:[38;5;10m[49m // U4 — hdr[0] is never read
