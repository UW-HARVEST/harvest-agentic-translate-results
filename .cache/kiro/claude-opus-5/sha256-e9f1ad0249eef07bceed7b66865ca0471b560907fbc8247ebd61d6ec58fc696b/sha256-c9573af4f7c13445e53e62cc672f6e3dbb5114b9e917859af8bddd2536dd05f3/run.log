[0m[49m[38;5;10m+    434[0m:[38;5;10m[49m                 compare("E5", &input);
[0m[49m[38;5;10m+    435[0m:[38;5;10m[49m                 assert_eq!(
[0m[49m[38;5;10m+    436[0m:[38;5;10m[49m                     c_result(&input),
[0m[49m[38;5;10m+    437[0m:[38;5;10m[49m                     -1,
[0m[49m[38;5;10m+    438[0m:[38;5;10m[49m                     "E5: one bit over the reservoir must give -1: {}",
[0m[49m[38;5;10m+    439[0m:[38;5;10m[49m                     input.desc
[0m[49m[38;5;10m+    440[0m:[38;5;10m[49m                 );
[0m[49m[38;5;10m+    441[0m:[38;5;10m[49m                 assert_eq!(rust_result(&input), -1, "E5: Rust must give -1");
