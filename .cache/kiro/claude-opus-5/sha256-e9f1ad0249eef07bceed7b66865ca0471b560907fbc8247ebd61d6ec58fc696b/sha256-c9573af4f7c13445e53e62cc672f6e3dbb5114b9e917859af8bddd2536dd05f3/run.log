[0m[49m[38;5;10m+    551[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    552[0m:[38;5;10m[49m fn u4_hdr0_ignored() {
[0m[49m[38;5;10m+    553[0m:[38;5;10m[49m     let mut rng = rng_for("U4");
[0m[49m[38;5;10m+    554[0m:[38;5;10m[49m     for ext in [false, true] {
[0m[49m[38;5;10m+    555[0m:[38;5;10m[49m         for mono in [false, true] {
[0m[49m[38;5;10m+    556[0m:[38;5;10m[49m             let sr = srs(ext)[rng.below(srs(ext).len() as u32) as usize];
[0m[49m[38;5;10m+    557[0m:[38;5;10m[49m             let hdr = hdr_for(ext, mono, sr, &mut rng);
[0m[49m[38;5;10m+    558[0m:[38;5;10m[49m             let n = gr_count_of(&hdr) as usize;
[0m[49m[38;5;10m+    559[0m:[38;5;10m[49m             let blocks: Vec<Blk> = (0..n).map(|_| Blk::rand(&mut rng)).collect();
[0m[49m[38;5;10m+    560[0m:[38;5;10m[49m             let opts = BuildOpts {
[0m[49m[38;5;10m+    561[0m:[38;5;10m[49m                 blocks,
[0m[49m[38;5;10m+    562[0m:[38;5;10m[49m                 ..Default::default()
[0m[49m[38;5;10m+    563[0m:[38;5;10m[49m             };
[0m[49m[38;5;10m+    564[0m:[38;5;10m[49m             let mut input = build(hdr, &opts, &mut rng);
[0m[49m[38;5;10m+    565[0m:[38;5;10m[49m             input.hdr[0] = 0;
[0m[49m[38;5;10m+    566[0m:[38;5;10m[49m             let baseline_c = c_result(&input);
[0m[49m[38;5;10m+    567[0m:[38;5;10m[49m             let baseline_r = rust_result(&input);
[0m[49m[38;5;10m+    568[0m:[38;5;10m[49m             assert_eq!(baseline_c, baseline_r);
[0m[49m[38;5;10m+    569[0m:[38;5;10m[49m             for h0 in 0..=255u8 {
[0m[49m[38;5;10m+    570[0m:[38;5;10m[49m                 input.hdr[0] = h0;
