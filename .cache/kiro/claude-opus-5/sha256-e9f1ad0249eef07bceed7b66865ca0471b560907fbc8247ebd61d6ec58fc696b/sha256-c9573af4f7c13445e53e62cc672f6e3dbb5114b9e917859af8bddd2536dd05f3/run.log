[0m[49m[38;5;10m+    444[0m:[38;5;10m[49m                 let exact = BuildOpts {
[0m[49m[38;5;10m+    445[0m:[38;5;10m[49m                     limit: LimitMode::ExactBoundary,
[0m[49m[38;5;10m+    446[0m:[38;5;10m[49m                     ..over
[0m[49m[38;5;10m+    447[0m:[38;5;10m[49m                 };
[0m[49m[38;5;10m+    448[0m:[38;5;10m[49m                 let input = build(hdr, &exact, &mut rng);
[0m[49m[38;5;10m+    449[0m:[38;5;10m[49m                 compare("E7", &input);
[0m[49m[38;5;10m+    450[0m:[38;5;10m[49m                 assert_eq!(
[0m[49m[38;5;10m+    451[0m:[38;5;10m[49m                     c_result(&input),
[0m[49m[38;5;10m+    452[0m:[38;5;10m[49m                     0,
[0m[49m[38;5;10m+    453[0m:[38;5;10m[49m                     "E7: exact boundary must be accepted: {}",
