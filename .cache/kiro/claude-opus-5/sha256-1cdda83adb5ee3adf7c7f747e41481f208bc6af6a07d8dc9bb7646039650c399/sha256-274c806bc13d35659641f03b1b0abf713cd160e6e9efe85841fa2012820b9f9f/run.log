  desc="$1"; shift
  python3 -c "$1" > in.bin
  "$C" < in.bin > c.out 2>/dev/null; crc=$?
  "$R" < in.bin > r.out 2>/dev/null; rrc=$?
  if cmp -s c.out r.out && [ "$crc" = "$rrc" ]; then echo "PASS  $desc"; else
    echo "FAIL  $desc  (rc $crc/$rrc)"; echo "  C: $(od -c c.out|head -2|tr '\n' '|')"; echo "  R: $(od -c r.out|head -2|tr '\n' '|')"; fail=1; fi
}
w(){ echo "import sys;sys.stdout.buffer.write($1)"; }

