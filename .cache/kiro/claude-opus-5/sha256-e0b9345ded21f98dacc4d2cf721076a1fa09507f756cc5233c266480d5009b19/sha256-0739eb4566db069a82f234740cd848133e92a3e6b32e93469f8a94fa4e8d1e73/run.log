import importlib.util, sys, subprocess
spec = importlib.util.spec_from_file_location("dt", "difftest.py")
# instead of importing (it runs), re-create case list by exec with check disabled
src = open("difftest.py").read()
src = src.split("def check(")[0]
g = {}
exec(src, g)
cases = g["cases"]; raw = g["raw_cases"]; run = g["run"]; C = g["C"]; R = g["R"]

def classify(data):
    t = data.split()
    try:
        op = int(t[0]); flags = int(t[1]); il = int(t[2])
        inp = [int(x) for x in t[3:3+il]]
        rl = int(t[3+il]); ref=[int(x) for x in t[4+il:4+il+rl]]
    except Exception:
        return "unparsable"
    if op != 4 or not (flags & 2):
        return "other"
    def slen(b):
        for i,v in enumerate(b):
            if v%256==0: return i
        return None
    tl = slen(inp); pl = slen(ref)
    if tl is None or pl is None: return "nonterm"
    return "underflow" if pl > tl else "other"

buckets={}
for data in cases:
    rc,o,e = run(C,data)
    rc2,o2,e2 = run(R,data)
    if (rc,o,e)!=(rc2,o2,e2):
        k=classify(data)
        buckets.setdefault(k,[]).append((data,rc,o,e,rc2,o2,e2))
for k,v in buckets.items():
    print("BUCKET",k,len(v))
for k,v in buckets.items():
    if k!="underflow":
        for row in v[:20]: print(k, row)
