src = open("difftest.py").read().split("def check(")[0]
g={}; exec(src,g)
cases=g["cases"]+g["raw_cases"]; run=g["run"]; C=g["C"]; R=g["R"]

def parse(data):
    t=data.split()
    try:
        op=int(t[0]); flags=int(t[1]); il=int(t[2])
        if il>1024 or 3+il>len(t): return None
        inp=[int(x)%256 for x in t[3:3+il]]
        rl=int(t[3+il])
        if rl>1024 or 4+il+rl>len(t): return None
        ref=[int(x)%256 for x in t[4+il:4+il+rl]]
        return op,flags,inp,ref
    except Exception: return None

def touches_uninit(p):
    """True if the C program would read uninitialised stack bytes."""
    op,flags,inp,ref=p
    inp_term = 0 in inp
    ref_term = 0 in ref
    if op==0:  return not (inp_term and ref_term)
    if op==1:  return not inp_term
    if op==2:  return not (inp_term and ref_term)
    if op==3:
        if len(ref)==0: return True          # reference[0] is garbage
        return not inp_term and (ref[0] not in inp)
    if op==4:  return not (inp_term and ref_term)
    return False

def underflow(p):
    op,flags,inp,ref=p
    if op!=4 or not (flags & 2): return False
    if 0 not in inp or 0 not in ref: return False
    return ref.index(0) > inp.index(0)

real=[]; uninit=0; und=0
for data in cases:
    rc,o,e=run(C,data); rc2,o2,e2=run(R,data)
    if (rc,o,e)==(rc2,o2,e2): continue
    p=parse(data)
    if p is None: real.append(("PARSE?",data,rc,o,e,rc2,o2,e2)); continue
    if touches_uninit(p): uninit+=1; continue
    if underflow(p): und+=1; continue
    real.append(("REAL",data,rc,o,e,rc2,o2,e2))
print("total cases:",len(cases))
print("uninit-dependent mismatches:",uninit)
print("oob-scan(underflow) mismatches:",und)
print("REAL mismatches:",len(real))
for r in real[:40]: print(r)
