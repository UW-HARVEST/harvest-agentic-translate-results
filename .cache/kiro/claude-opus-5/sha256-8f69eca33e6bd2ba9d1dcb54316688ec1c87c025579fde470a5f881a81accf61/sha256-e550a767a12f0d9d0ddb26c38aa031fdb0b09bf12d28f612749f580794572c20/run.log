[0m[49m[38;5;10m+     58[0m:[38;5;10m[49m PNG_RISCV_RVV_OPT           == 0     PNG_RISCV_RVV_IMPLEMENTATION  == 0
[0m[49m[38;5;10m+     59[0m:[38;5;10m[49m PNG_INTEL_SSE_OPT           == 0     PNG_INTEL_SSE_IMPLEMENTATION  == 0
