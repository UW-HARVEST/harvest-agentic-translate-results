[0m[49m[38;5;10m+     64[0m:[38;5;10m[49m PNG_POINTER_INDEXING_SUPPORTED -> defined
[0m[49m[38;5;10m+     65[0m:[38;5;10m[49m PNG_SETJMP_SUPPORTED        -> defined
[0m[49m[38;5;10m+     66[0m:[38;5;10m[49m PNG_MAX_MALLOC_64K          -> NOT defined
