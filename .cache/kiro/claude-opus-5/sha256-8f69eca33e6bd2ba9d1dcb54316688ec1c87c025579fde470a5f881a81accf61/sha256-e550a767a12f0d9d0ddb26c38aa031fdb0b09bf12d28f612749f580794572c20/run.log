[0m[49m[38;5;10m+     34[0m:[38;5;10m[49m ## 1. Build configuration (what the C preprocessor resolves to)
[0m[49m[38;5;10m+     35[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     36[0m:[38;5;10m[49m `c_src/include/pnglibconf.h` enables **almost everything**.  Assume every
[0m[49m[38;5;10m+     37[0m:[38;5;10m[49m `PNG_*_SUPPORTED` macro is **defined** (so `#ifdef` blocks are INCLUDED,
[0m[49m[38;5;10m+     38[0m:[38;5;10m[49m `#ifndef` blocks are SKIPPED) **except** these, which are NOT defined:
[0m[49m[38;5;10m+     39[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     40[0m:[38;5;10m[49m ```
[0m[49m[38;5;10m+     41[0m:[38;5;10m[49m PNG_ARM_NEON_API_SUPPORTED      PNG_ARM_NEON_CHECK_SUPPORTED
[0m[49m[38;5;10m+     42[0m:[38;5;10m[49m PNG_MIPS_MMI_API_SUPPORTED      PNG_MIPS_MMI_CHECK_SUPPORTED
[0m[49m[38;5;10m+     43[0m:[38;5;10m[49m PNG_MIPS_MSA_API_SUPPORTED      PNG_MIPS_MSA_CHECK_SUPPORTED
[0m[49m[38;5;10m+     44[0m:[38;5;10m[49m PNG_POWERPC_VSX_API_SUPPORTED   PNG_POWERPC_VSX_CHECK_SUPPORTED
[0m[49m[38;5;10m+     45[0m:[38;5;10m[49m PNG_BENIGN_WRITE_ERRORS_SUPPORTED
[0m[49m[38;5;10m+     46[0m:[38;5;10m[49m PNG_DISABLE_ADLER32_CHECK_SUPPORTED
[0m[49m[38;5;10m+     47[0m:[38;5;10m[49m PNG_ERROR_NUMBERS_SUPPORTED
[0m[49m[38;5;10m+     48[0m:[38;5;10m[49m ```
[0m[49m[38;5;10m+     49[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     50[0m:[38;5;10m[49m Other resolved values you will meet:
[0m[49m[38;5;10m+     51[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     52[0m:[38;5;10m[49m ```
[0m[49m[38;5;10m+     53[0m:[38;5;10m[49m PNG_ARM_NEON_OPT            == 0     PNG_ARM_NEON_IMPLEMENTATION   == 0
[0m[49m[38;5;10m+     54[0m:[38;5;10m[49m PNG_MIPS_MSA_OPT            == 0     PNG_MIPS_MSA_IMPLEMENTATION   == 0
[0m[49m[38;5;10m+     55[0m:[38;5;10m[49m PNG_MIPS_MMI_OPT            == 0     PNG_MIPS_MMI_IMPLEMENTATION   == 0
[0m[49m[38;5;10m+     56[0m:[38;5;10m[49m PNG_POWERPC_VSX_OPT         == 0     PNG_POWERPC_VSX_IMPLEMENTATION== 0
