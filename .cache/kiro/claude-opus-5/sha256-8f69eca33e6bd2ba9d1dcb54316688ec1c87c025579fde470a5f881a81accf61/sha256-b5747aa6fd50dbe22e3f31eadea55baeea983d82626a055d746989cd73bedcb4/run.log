helper = '''
/* png_read_png allocates the row buffers with png_malloc and never initialises
 * the padding bits beyond the last pixel of a sub-byte-depth row, so those bits
 * are whatever the heap happened to hold.  Mask them off before hashing so the
 * comparison only covers defined data.
 */
static void mask_padding(png_structp rp, png_infop rip)
{
   png_bytepp rows = png_get_rows(rp, rip);
   png_uint_32 h = png_get_image_height(rp, rip);
   png_uint_32 w = png_get_image_width(rp, rip);
   int bd = png_get_bit_depth(rp, rip);
   int ch = png_get_channels(rp, rip);
   size_t rb = png_get_rowbytes(rp, rip);
   unsigned long bits = (unsigned long)w * (unsigned)ch * (unsigned)bd;
   unsigned trail = (unsigned)(bits % 8);
   if (rows == NULL || trail == 0 || rb == 0) return;
   for (png_uint_32 y = 0; y < h; y++)
      rows[y][rb - 1] &= (png_byte)(0xff << (8 - trail));
}
'''
