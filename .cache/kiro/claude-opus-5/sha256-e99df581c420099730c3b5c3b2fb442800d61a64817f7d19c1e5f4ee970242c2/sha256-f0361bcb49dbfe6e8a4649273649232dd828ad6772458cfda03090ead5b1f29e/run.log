[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m                 continue;
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m             if ((b2h1 & 0xF0) == 0) == ((b2h2 & 0xF0) == 0) {
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m                 continue;
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m             let h2 = [0xff, rng.pick(&valid_b1_values()), b2h2];
