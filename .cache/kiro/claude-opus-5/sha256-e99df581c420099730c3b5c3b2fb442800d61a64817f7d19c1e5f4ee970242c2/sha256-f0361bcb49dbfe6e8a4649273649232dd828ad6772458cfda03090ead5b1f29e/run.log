[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    271[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    272[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    273[0m:[38;5;10m[49m // G4 / CONFIGS row 28 — read extent: nothing past byte 2 is ever touched.
[0m[49m[38;5;10m+    274[0m:[38;5;10m[49m // The header is placed at the very end of a mapped page whose successor page
[0m[49m[38;5;10m+    275[0m:[38;5;10m[49m // is PROT_NONE, so any over-read faults the test process for BOTH libraries
[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m // identically. Also verifies the short-circuit read order: when h2 is invalid
[0m[49m[38;5;10m+    277[0m:[38;5;10m[49m // early, later bytes are not read.
[0m[49m[38;5;10m+    278[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    279[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    280[0m:[38;5;10m[49m mod guard {
[0m[49m[38;5;10m+    281[0m:[38;5;10m[49m     use std::ffi::c_void;
[0m[49m[38;5;10m+    282[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    283[0m:[38;5;10m[49m     unsafe extern "C" {
[0m[49m[38;5;10m+    284[0m:[38;5;10m[49m         fn mmap(
[0m[49m[38;5;10m+    285[0m:[38;5;10m[49m             addr: *mut c_void,
[0m[49m[38;5;10m+    286[0m:[38;5;10m[49m             length: usize,
[0m[49m[38;5;10m+    287[0m:[38;5;10m[49m             prot: i32,
[0m[49m[38;5;10m+    288[0m:[38;5;10m[49m             flags: i32,
[0m[49m[38;5;10m+    289[0m:[38;5;10m[49m             fd: i32,
[0m[49m[38;5;10m+    290[0m:[38;5;10m[49m             offset: i64,
[0m[49m[38;5;10m+    291[0m:[38;5;10m[49m         ) -> *mut c_void;
[0m[49m[38;5;10m+    292[0m:[38;5;10m[49m         fn mprotect(addr: *mut c_void, len: usize, prot: i32) -> i32;
[0m[49m[38;5;10m+    293[0m:[38;5;10m[49m         fn munmap(addr: *mut c_void, len: usize) -> i32;
[0m[49m[38;5;10m+    294[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    295[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    296[0m:[38;5;10m[49m     const PROT_NONE: i32 = 0;
[0m[49m[38;5;10m+    297[0m:[38;5;10m[49m     const PROT_READ: i32 = 1;
[0m[49m[38;5;10m+    298[0m:[38;5;10m[49m     const PROT_WRITE: i32 = 2;
[0m[49m[38;5;10m+    299[0m:[38;5;10m[49m     const MAP_PRIVATE: i32 = 0x02;
[0m[49m[38;5;10m+    300[0m:[38;5;10m[49m     const MAP_ANONYMOUS: i32 = 0x20;
[0m[49m[38;5;10m+    301[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    302[0m:[38;5;10m[49m     /// Two pages; the second is made PROT_NONE. Returns (base, page_size).
[0m[49m[38;5;10m+    303[0m:[38;5;10m[49m     pub struct Guarded {
[0m[49m[38;5;10m+    304[0m:[38;5;10m[49m         base: *mut u8,
[0m[49m[38;5;10m+    305[0m:[38;5;10m[49m         page: usize,
[0m[49m[38;5;10m+    306[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    307[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    308[0m:[38;5;10m[49m     impl Guarded {
[0m[49m[38;5;10m+    309[0m:[38;5;10m[49m         pub fn new() -> Guarded {
[0m[49m[38;5;10m+    310[0m:[38;5;10m[49m             let page = 4096usize;
[0m[49m[38;5;10m+    311[0m:[38;5;10m[49m             let base = unsafe {
[0m[49m[38;5;10m+    312[0m:[38;5;10m[49m                 mmap(
[0m[49m[38;5;10m+    313[0m:[38;5;10m[49m                     std::ptr::null_mut(),
[0m[49m[38;5;10m+    314[0m:[38;5;10m[49m                     page * 2,
[0m[49m[38;5;10m+    315[0m:[38;5;10m[49m                     PROT_READ | PROT_WRITE,
[0m[49m[38;5;10m+    316[0m:[38;5;10m[49m                     MAP_PRIVATE | MAP_ANONYMOUS,
[0m[49m[38;5;10m+    317[0m:[38;5;10m[49m                     -1,
[0m[49m[38;5;10m+    318[0m:[38;5;10m[49m                     0,
[0m[49m[38;5;10m+    319[0m:[38;5;10m[49m                 )
[0m[49m[38;5;10m+    320[0m:[38;5;10m[49m             };
[0m[49m[38;5;10m+    321[0m:[38;5;10m[49m             assert!(
[0m[49m[38;5;10m+    322[0m:[38;5;10m[49m                 base as isize != -1 && !base.is_null(),
[0m[49m[38;5;10m+    323[0m:[38;5;10m[49m                 "mmap failed for the guard-page test"
[0m[49m[38;5;10m+    324[0m:[38;5;10m[49m             );
[0m[49m[38;5;10m+    325[0m:[38;5;10m[49m             let base = base as *mut u8;
[0m[49m[38;5;10m+    326[0m:[38;5;10m[49m             let rc = unsafe { mprotect(base.add(page) as *mut c_void, page, PROT_NONE) };
[0m[49m[38;5;10m+    327[0m:[38;5;10m[49m             assert_eq!(rc, 0, "mprotect(PROT_NONE) failed");
[0m[49m[38;5;10m+    328[0m:[38;5;10m[49m             Guarded { base, page }
[0m[49m[38;5;10m+    329[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    330[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    331[0m:[38;5;10m[49m         /// Write `n` bytes so that byte `n-1` is the last readable byte before
[0m[49m[38;5;10m+    332[0m:[38;5;10m[49m         /// the guard page, and return a pointer to the first of them.
[0m[49m[38;5;10m+    333[0m:[38;5;10m[49m         pub fn place(&self, bytes: &[u8]) -> *const u8 {
[0m[49m[38;5;10m+    334[0m:[38;5;10m[49m             let n = bytes.len();
[0m[49m[38;5;10m+    335[0m:[38;5;10m[49m             unsafe {
[0m[49m[38;5;10m+    336[0m:[38;5;10m[49m                 let dst = self.base.add(self.page - n);
[0m[49m[38;5;10m+    337[0m:[38;5;10m[49m                 std::ptr::copy_nonoverlapping(bytes.as_ptr(), dst, n);
[0m[49m[38;5;10m+    338[0m:[38;5;10m[49m                 dst
[0m[49m[38;5;10m+    339[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    340[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    341[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    342[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    343[0m:[38;5;10m[49m     impl Drop for Guarded {
[0m[49m[38;5;10m+    344[0m:[38;5;10m[49m         fn drop(&mut self) {
[0m[49m[38;5;10m+    345[0m:[38;5;10m[49m             unsafe {
