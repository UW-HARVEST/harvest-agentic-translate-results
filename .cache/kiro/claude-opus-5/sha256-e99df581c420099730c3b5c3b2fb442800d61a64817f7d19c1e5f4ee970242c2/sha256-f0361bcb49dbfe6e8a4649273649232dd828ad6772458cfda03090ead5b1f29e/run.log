[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m fn g01_null_h1_with_invalid_h2() {
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m     let p = Pair::load();
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m     // One invalid h2 per rejection reason (ERRORS rows 1-5).
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m     let invalid: [[u8; 3]; 6] = [
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m         [0x00, 0xfb, 0x90], // row 1: bad sync
[0m[49m[38;5;10m+    259[0m:[38;5;10m[49m         [0xff, 0x12, 0x90], // row 2: byte1 neither class
