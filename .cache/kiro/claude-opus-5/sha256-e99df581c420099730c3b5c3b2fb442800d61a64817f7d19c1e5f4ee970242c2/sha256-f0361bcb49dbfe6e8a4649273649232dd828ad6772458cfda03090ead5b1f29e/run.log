[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m         [0xff, 0xf9, 0x90], // row 3: layer 0, other value
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m         [0xff, 0xfb, 0xf4], // row 4: nibble 15
[0m[49m[38;5;10m+    263[0m:[38;5;10m[49m         [0xff, 0xfb, 0x9c], // row 5: S == 3
