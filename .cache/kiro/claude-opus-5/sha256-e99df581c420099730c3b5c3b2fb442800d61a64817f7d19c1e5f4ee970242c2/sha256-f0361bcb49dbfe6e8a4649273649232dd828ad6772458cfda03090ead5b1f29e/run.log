[0m[49m[38;5;10m+    189[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    190[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    191[0m:[38;5;10m[49m fn err07_byte2_mask_0c_mismatch_exhaustive() {
