[0m[49m[38;5;10m+    176[0m:[38;5;10m[49m                 rng.pick(&valid_b1_values()),
[0m[49m[38;5;10m+    177[0m:[38;5;10m[49m                 rng.pick(&valid_b2_values()),
[0m[49m[38;5;10m+    178[0m:[38;5;10m[49m             ];
