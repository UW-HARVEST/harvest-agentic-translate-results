[0m[49m[38;5;10m+     72[0m:[38;5;10m[49m     cfg_row01_exhaustive_shard12 => 192,
[0m[49m[38;5;10m+     73[0m:[38;5;10m[49m     cfg_row01_exhaustive_shard13 => 208,
