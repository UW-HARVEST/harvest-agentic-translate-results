[0m[49m[38;5;10m+     20[0m:[38;5;10m[49m /// One shard of row 1: `h2[1]` in `[lo, hi)`, everything else exhaustive.
[0m[49m[38;5;10m+     21[0m:[38;5;10m[49m fn row1_shard(lo: u16, hi: u16) {
[0m[49m[38;5;10m+     22[0m:[38;5;10m[49m     let l = libs();
