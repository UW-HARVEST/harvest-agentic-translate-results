[0m[49m[38;5;10m+     25[0m:[38;5;10m[49m     let mut pairs: u64 = 0;
[0m[49m[38;5;10m+     26[0m:[38;5;10m[49m     for b1 in lo..hi {
[0m[49m[38;5;10m+     27[0m:[38;5;10m[49m         h2[1] = b1 as u8;
[0m[49m[38;5;10m+     28[0m:[38;5;10m[49m         for b2 in 0u16..256 {
[0m[49m[38;5;10m+     29[0m:[38;5;10m[49m             h2[2] = b2 as u8;
[0m[49m[38;5;10m+     30[0m:[38;5;10m[49m             for a1 in 0u16..256 {
[0m[49m[38;5;10m+     31[0m:[38;5;10m[49m                 h1[1] = a1 as u8;
[0m[49m[38;5;10m+     32[0m:[38;5;10m[49m                 for a2 in 0u16..256 {
[0m[49m[38;5;10m+     33[0m:[38;5;10m[49m                     h1[2] = a2 as u8;
[0m[49m[38;5;10m+     34[0m:[38;5;10m[49m                     if let Some((c, r)) = diff(l, &h1, &h2) {
[0m[49m[38;5;10m+     35[0m:[38;5;10m[49m                         panic!(
