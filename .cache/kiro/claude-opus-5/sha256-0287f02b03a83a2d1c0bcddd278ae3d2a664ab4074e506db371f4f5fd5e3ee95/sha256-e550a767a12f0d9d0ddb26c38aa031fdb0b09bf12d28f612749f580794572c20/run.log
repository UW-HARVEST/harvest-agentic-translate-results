#!/bin/bash
# Differential test: C reference vs Rust translation.
C=/tmp/cbuild/driver_c
R="$(pwd)/translation/target/release/driver"
fail=0
total=0

run_case() {
  total=$((total+1))
  co=$("$C" "$@" 2>/dev/null); cs=$?
  ro=$("$R" "$@" 2>/dev/null); rs=$?
  # capture exact bytes (command substitution strips trailing newlines, so hash raw)
  ch=$("$C" "$@" 2>/dev/null | od -An -tx1 | tr -d ' \n'); cs=${PIPESTATUS[0]}
  rh=$("$R" "$@" 2>/dev/null | od -An -tx1 | tr -d ' \n')
  cs=$("$C" "$@" >/dev/null 2>&1; echo $?)
  rs=$("$R" "$@" >/dev/null 2>&1; echo $?)
  if [ "$ch" != "$rh" ] || [ "$cs" != "$rs" ]; then
    fail=$((fail+1))
    printf 'MISMATCH args=[%s]\n  C  rc=%s bytes=%s\n  RS rc=%s bytes=%s\n' "$*" "$cs" "$ch" "$rs" "$rh"
  fi
}

# no args
total=$((total+1))
ch=$("$C" 2>/dev/null | od -An -tx1 | tr -d ' \n'); cs=$("$C" >/dev/null 2>&1; echo $?)
rh=$("$R" 2>/dev/null | od -An -tx1 | tr -d ' \n'); rs=$("$R" >/dev/null 2>&1; echo $?)
if [ "$ch" != "$rh" ] || [ "$cs" != "$rs" ]; then
  fail=$((fail+1)); printf 'MISMATCH args=[] C rc=%s %s / RS rc=%s %s\n' "$cs" "$ch" "$rs" "$rh"
fi

STRINGS=("hello" "" "a" "hello world" "0123456789" "  padded  " "ünïcødé" "tab	sep")
IDX=("" "0" "1" "3" "5" "10" "11" "-1" "-0" "+3" "abc" "3abc" " 4" "4 " "" "2147483647" "2147483648" "9223372036854775807" "9223372036854775808" "99999999999999999999" "-9223372036854775809" "4294967296" "4294967301" "0x5" "07" "+" "-" "1e3")

for s in "${STRINGS[@]}"; do
  run_case "$s"
  for a in "${IDX[@]}"; do
    run_case "$s" "$a"
    for b in "${IDX[@]}"; do
      run_case "$s" "$a" "$b"
    done
  done
done

# too many args
run_case a b c d
run_case a b c d e

echo "cases=$total failures=$fail"
exit $([ $fail -eq 0 ]; echo $?)
