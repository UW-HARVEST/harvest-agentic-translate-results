     1	//! `atoi` with C semantics, for `mdmain.c`'s argument parsing.
     2	
     3	use core::ffi::c_int;
     4	
     5	/// `int atoi(const char *nptr)`.
     6	///
     7	/// glibc implements this as `(int) strtol(nptr, NULL, 10)`: leading whitespace is
     8	/// skipped, an optional sign is consumed, digits are accumulated until the first
     9	/// non-digit, and a string with no digits at all yields 0. Out-of-range input
    10	/// saturates at `LONG_MAX`/`LONG_MIN` inside `strtol` and is then truncated by the
    11	/// cast to `int`, which is what the `i64` saturation plus `as c_int` below
    12	/// reproduce. Formally the overflow case is unspecified for `atoi`; matching
    13	/// glibc keeps the observable behaviour aligned with the reference binary.
    14	pub fn atoi(s: &[u8]) -> c_int {
    15	    let mut idx = 0usize;
    16	
    17	    // isspace() in the C locale.
    18	    while idx < s.len()
    19	        && matches!(
    20	            s[idx],
    21	            b' ' | b'\t' | b'\n' | 0x0b /* \v */ | 0x0c /* \f */ | b'\r'
    22	        )
    23	    {
    24	        idx += 1;
    25	    }
    26	
    27	    let mut negative = false;
    28	    if idx < s.len() && (s[idx] == b'+' || s[idx] == b'-') {
    29	        negative = s[idx] == b'-';
    30	        idx += 1;
    31	    }
    32	
    33	    // Accumulate the magnitude, saturating the way strtol clamps to LONG_MAX.
    34	    let mut magnitude: i64 = 0;
    35	    while idx < s.len() && s[idx].is_ascii_digit() {
    36	        let digit = i64::from(s[idx] - b'0');
    37	        magnitude = magnitude.saturating_mul(10).saturating_add(digit);
    38	        idx += 1;
    39	    }
    40	
    41	    let value: i64 = if negative {
    42	        // LONG_MIN is one further out than -LONG_MAX; saturating_neg keeps the
    43	        // clamp on the negative side too.
    44	        magnitude.saturating_neg()
    45	    } else {
    46	        magnitude
    47	    };
    48	
    49	    // (int) of a long: truncate the low 32 bits.
    50	    value as c_int
    51	}
