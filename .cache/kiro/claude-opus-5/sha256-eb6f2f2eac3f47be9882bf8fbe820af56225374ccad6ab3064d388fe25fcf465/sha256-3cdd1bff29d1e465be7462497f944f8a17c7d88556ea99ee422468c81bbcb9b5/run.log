     1	//! Minimal `<stdio.h>`-shaped output helpers.
     2	//!
     3	//! The C code reaches `printf`/`fprintf`, which write raw bytes and ignore
     4	//! errors. These wrappers do the same: they take byte slices (so a non-UTF-8
     5	//! `argv[0]` still reproduces exactly under `%s`) and swallow I/O errors instead
     6	//! of panicking, which is what an unchecked `printf` return value amounts to.
     7	
     8	use std::io::Write;
     9	
    10	/// `fwrite(bytes, 1, n, stdout)` -- errors ignored, as `printf`'s return value is.
    11	pub fn print_bytes(bytes: &[u8]) {
    12	    let stdout = std::io::stdout();
    13	    let mut lock = stdout.lock();
    14	    let _ = lock.write_all(bytes);
    15	}
    16	
    17	/// `printf("%s", s)`.
    18	pub fn print_str(s: &str) {
    19	    print_bytes(s.as_bytes());
    20	}
    21	
    22	/// `fwrite(bytes, 1, n, stderr)`.
    23	pub fn eprint_bytes(bytes: &[u8]) {
    24	    let stderr = std::io::stderr();
    25	    let mut lock = stderr.lock();
    26	    let _ = lock.write_all(bytes);
    27	}
    28	
    29	/// Flushes `stdout`, mirroring the implicit flush C performs at `exit`.
    30	pub fn flush_stdout() {
    31	    let _ = std::io::stdout().flush();
