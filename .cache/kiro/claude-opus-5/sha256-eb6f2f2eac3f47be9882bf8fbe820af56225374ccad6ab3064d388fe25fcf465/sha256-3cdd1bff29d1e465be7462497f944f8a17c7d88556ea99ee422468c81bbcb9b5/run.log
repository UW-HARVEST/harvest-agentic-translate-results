    24	//! Rust translation of `src/mdmain.c` -- the `driver` executable.
    25	//!
    26	//! The library target is a `cdylib`, which Cargo cannot link into a Rust binary,
    27	//! so the driver pulls the same module files in directly via `#[path]`. The C
    28	//! build does the equivalent thing: `mdcore.c` and `mdmain.c` are compiled into
    29	//! one `add_executable(driver ...)`.
    30	
    31	#[path = "mdmacros.rs"]
    32	mod mdmacros;
    33	
    34	#[path = "mdcore.rs"]
    35	mod mdcore;
    36	
    37	#[path = "stdio.rs"]
    38	mod stdio;
    39	
    40	#[path = "cstdlib.rs"]
    41	mod cstdlib;
    42	
    43	use core::ffi::c_int;
    44	
    45	use cstdlib::atoi;
    46	use mdcore::{g_op, g_op_name_bytes, helper_call, helper_ptr, use_generated};
    47	use mdmacros::{run_loop, INIT, OP_FN, REPEAT};
    48	
    49	/// Collects `argv` as raw byte strings so `%s` reproduces the original bytes
    50	/// even for arguments that are not valid UTF-8.
    51	fn argv_bytes() -> Vec<Vec<u8>> {
    52	    std::env::args_os()
    53	        .map(|arg| {
    54	            #[cfg(unix)]
    55	            {
    56	                use std::os::unix::ffi::OsStrExt;
    57	                arg.as_bytes().to_vec()
    58	            }
    59	            #[cfg(not(unix))]
    60	            {
    61	                arg.to_string_lossy().into_owned().into_bytes()
    62	            }
    63	        })
    64	        .collect()
    65	}
    66	
    67	fn main() {
    68	    let argv = argv_bytes();
    69	    let argc = argv.len() as c_int;
    70	
    71	    if argc < 3 {
    72	        // fprintf(stderr, "usage: %s A B\n", argv[0]);
    73	        let mut msg = Vec::new();
    74	        msg.extend_from_slice(b"usage: ");
    75	        msg.extend_from_slice(argv.first().map(|v| v.as_slice()).unwrap_or(b""));
    76	        msg.extend_from_slice(b" A B\n");
    77	        stdio::eprint_bytes(&msg);
    78	        stdio::flush_stdout();
    79	        std::process::exit(2);
    80	    }
    81	
    82	    let a = atoi(&argv[1]);
    83	    let b = atoi(&argv[2]);
    84	
    85	    // int r_call = (OP_FN(OP))(a, b);
    86	    let r_call = OP_FN(a, b);
    87	
    88	    // int acc = INIT_FOR(OP); RUN_LOOP(OP, acc, REPEAT);
    89	    let acc = run_loop(INIT);
    90	
    91	    let x1 = helper_call(a, b);
    92	    let x2 = helper_ptr(a, b);
    93	    let x3 = use_generated(REPEAT);
    94	    let g = g_op()(a, b);
    95	
    96	    // printf("op=%s call=%d acc=%d g.call=%d\n", G_OP_NAME, r_call, acc, g);
    97	    let mut line = Vec::new();
    98	    line.extend_from_slice(b"op=");
    99	    line.extend_from_slice(g_op_name_bytes());
   100	    line.extend_from_slice(format!(" call={} acc={} g.call={}\n", r_call, acc, g).as_bytes());
   101	    stdio::print_bytes(&line);
   102	
   103	    // printf("summary=%d\n", r_call + acc + x1 + x2 + x3 + g);
   104	    let summary = r_call
   105	        .wrapping_add(acc)
   106	        .wrapping_add(x1)
   107	        .wrapping_add(x2)
   108	        .wrapping_add(x3)
   109	        .wrapping_add(g);
   110	    stdio::print_str(&format!("summary={}\n", summary));
   111	
   112	    stdio::flush_stdout();
   113	    std::process::exit(0);
   114	}
