cmake_minimum_required(VERSION 3.10)
project(driver)
set(OP "add" CACHE STRING "operation leveraged")
set(REPEAT "5" CACHE STRING "iterations tested")
set(CMAKE_C_FLAGS "-DOP=${OP} -DREPEAT=${REPEAT}")
add_executable(driver
    src/mdcore.c
    src/mdmain.c)
=====CARGO=====
[package]
name = "driver"
version = "0.1.0"
edition = "2021"
description = "Rust translation of the MIT LL macro-dispatch C driver (mdcore/mdmain)"
license = "MIT"

[lib]
name = "driver"
path = "src/lib.rs"
crate-type = ["cdylib"]

[[bin]]
name = "driver"
path = "src/main.rs"

# CMake cache variables become Cargo features, named after the *value* of the
# variable, lowercased:
#
#   -DOP=add|sub|mul        ->  --features add | sub | mul
#   -DREPEAT=0..7           ->  --features 0 | 1 | ... | 7
#
# CMake defaults are OP=add, REPEAT=5, which is the `default` feature set.
#
# Every combination compiles. When several values of the same variable are
# enabled at once (which happens when default features are left on), the
# non-default value wins, so `--features sub` behaves like -DOP=sub.
[features]
default = ["add", "5"]

# OP
add = []
sub = []
mul = []

# REPEAT
"0" = []
"1" = []
"2" = []
"3" = []
"4" = []
"5" = []
"6" = []
"7" = []

[workspace]
