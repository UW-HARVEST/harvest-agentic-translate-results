#include <dlfcn.h>
#include <stdio.h>
#include <stdint.h>
#include <string.h>

typedef uint16_t (*fn_t)(float);

int main(int argc, char **argv) {
    void *hc = dlopen(argv[1], RTLD_NOW);
    void *hr = dlopen(argv[2], RTLD_NOW);
    if (!hc || !hr) { fprintf(stderr, "dlopen failed: %s\n", dlerror()); return 2; }
    fn_t fc = (fn_t)dlsym(hc, "float2half");
    fn_t fr = (fn_t)dlsym(hr, "float2half");
    if (!fc || !fr) { fprintf(stderr, "dlsym failed\n"); return 2; }

    uint64_t mismatches = 0;
    uint64_t i = 0;
    do {
        uint32_t bits = (uint32_t)i;
        float f;
        memcpy(&f, &bits, 4);
        uint16_t a = fc(f);
        uint16_t b = fr(f);
        if (a != b) {
            if (mismatches < 10)
                fprintf(stderr, "MISMATCH bits=0x%08x C=0x%04x Rust=0x%04x\n", bits, a, b);
            mismatches++;
        }
        i++;
    } while (i <= 0xFFFFFFFFull);

    printf("tested=%llu mismatches=%llu\n",
           (unsigned long long)i, (unsigned long long)mismatches);
    return mismatches != 0;
}
