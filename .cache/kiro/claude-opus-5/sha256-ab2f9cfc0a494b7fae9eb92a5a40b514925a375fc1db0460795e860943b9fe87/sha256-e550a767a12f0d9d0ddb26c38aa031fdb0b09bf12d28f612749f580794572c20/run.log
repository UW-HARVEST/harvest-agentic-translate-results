import re
src = open('c_src/src/lib.c').read()

def grab(name):
    i = src.index(name)
    lb = src.index('{', i)
    rb = src.index('}', lb)
    body = src[lb+1:rb]
    vals = [int(t, 16) for t in re.findall(r'0x[0-9a-fA-F]+', body)]
    return vals

base = grab('m__base')
shift = grab('m__shift')
print("base len:", len(base), "min:", min(base), "max:", hex(max(base)))
print("shift len:", len(shift), "min:", hex(min(shift)), "max:", hex(max(shift)))

import json
json.dump({'base': base, 'shift': shift}, open('/tmp/tables.json','w'))
