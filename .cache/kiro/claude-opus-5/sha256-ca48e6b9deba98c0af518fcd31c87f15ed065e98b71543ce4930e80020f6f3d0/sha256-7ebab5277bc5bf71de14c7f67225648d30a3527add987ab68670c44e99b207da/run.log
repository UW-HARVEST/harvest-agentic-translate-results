    27	#[inline]
    28	fn sprite_less_than_or_equal(a: &spritebatch_sprite_t, b: &spritebatch_sprite_t) -> bool {
    29	    if a.sort_bits <= b.sort_bits {
    30	        return true;
    31	    }
    32	    if a.sort_bits == b.sort_bits && a.texture_id <= b.texture_id {
