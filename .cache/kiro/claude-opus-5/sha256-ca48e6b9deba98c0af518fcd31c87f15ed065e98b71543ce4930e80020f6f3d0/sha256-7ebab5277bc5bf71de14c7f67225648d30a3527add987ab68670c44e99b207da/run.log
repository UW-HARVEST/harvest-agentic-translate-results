    41	fn merge_sort_iteration(
    42	    src: &[spritebatch_sprite_t],
    43	    lo: c_int,
    44	    split: c_int,
    45	    hi: c_int,
    46	    dst: &mut [spritebatch_sprite_t],
    47	) {
    48	    let mut i = lo;
    49	    let mut j = split;
    50	    let mut k = lo;
    51	    while k < hi {
