import pty, os, subprocess
def run_tty(exe, data):
    m, s = pty.openpty()
    p = subprocess.Popen([exe], stdin=subprocess.PIPE, stdout=s, stderr=subprocess.STDOUT)
    os.close(s); p.stdin.write(data); p.stdin.close()
    out = b""
    try:
        while True:
            c = os.read(m, 4096)
            if not c: break
            out += c
    except OSError: pass
    p.wait(); os.close(m)
    return out, p.returncode
for data in [b"", b"3\n3\n", b"0\n0\n", b"nan\n"]:
