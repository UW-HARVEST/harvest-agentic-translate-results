                let rs = rcs();
                let a = cld(cs, std::ptr::null(), n);
                let b = rld(rs, std::ptr::null(), n);
                cfs(cs);
                rfs(rs);
                (a, b)
            };
            eq(&format!("row30 loadDict(NULL,{n})"), a, b);
            eq(&format!("row30 loadDict(NULL,{n}) == 0"), a, 0);
        }''')

# rows29_33 row33: usingDict NULL only with dictSize <= 0
