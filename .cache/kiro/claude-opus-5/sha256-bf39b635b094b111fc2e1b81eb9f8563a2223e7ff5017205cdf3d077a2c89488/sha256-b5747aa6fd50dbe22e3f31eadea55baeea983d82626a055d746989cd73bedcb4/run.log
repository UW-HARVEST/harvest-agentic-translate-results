#include <stdio.h>
#include <stdint.h>
#include <stdlib.h>
typedef struct { uint8_t r,g,b,a; } cp_pixel_t;
typedef struct { int w,h; cp_pixel_t *pix; } cp_image_t;
extern void premultiply(cp_image_t*);
int main(void){
  unsigned s=12345; int W=37,H=11;
  cp_pixel_t *p = malloc(sizeof(cp_pixel_t)*W*H);
  for(int i=0;i<W*H;i++){ s=s*1103515245u+12345u; p[i].r=(s>>16)&0xff;
    s=s*1103515245u+12345u; p[i].g=(s>>16)&0xff;
    s=s*1103515245u+12345u; p[i].b=(s>>16)&0xff;
    s=s*1103515245u+12345u; p[i].a=(s>>16)&0xff; }
  cp_image_t img={W,H,p};
  premultiply(&img);
  for(int i=0;i<W*H;i++) printf("%u %u %u %u\n",p[i].r,p[i].g,p[i].b,p[i].a);
  /* edge cases: zero dims, negative dims */
  cp_pixel_t one={200,150,100,128}; cp_image_t z={0,5,&one}; premultiply(&z);
  printf("zero: %u %u %u %u\n",one.r,one.g,one.b,one.a);
  cp_image_t n={-1,-1,&one}; premultiply(&n);
  printf("neg: %u %u %u %u\n",one.r,one.g,one.b,one.a);
  return 0;
}
EOF
