new='''#[test]
fn row49_index_manipulation() {
    // js_copy is index-safe (stackidx() clamps out-of-range to `undefined`),
    // but js_remove / js_replace throw "stack error!" and js_insert always
    // throws "not implemented yet".  All of them are therefore driven inside a
    // host C function under js_pcall so the throw is caught by the library.
    for depth in [1usize, 2, 3, 5, 8] {
        for idx in -(depth as c_int) - 2..=(depth as c_int) + 2 {
            for op in 0..6 {
                diff_protected(
                    &format!("stack op depth={depth} idx={idx} op={op}"),
                    0,
                    || {
                        move |api: &Api, j: JS| unsafe {
                            for k in 0..depth {
                                (api.js_pushnumber)(j, k as f64);
                            }
                            match op {
                                0 => (api.js_copy)(j, idx),
                                1 => (api.js_remove)(j, idx),
                                2 => {
                                    (api.js_pushnumber)(j, 99.0);
                                    (api.js_insert)(j, idx)
                                }
                                3 => {
                                    (api.js_pushnumber)(j, 99.0);
                                    (api.js_replace)(j, idx)
                                }
                                4 => (api.js_pop)(j, idx),
                                _ => {
                                    // js_rot is unchecked in C; keep n within
                                    // the live frame so the walk stays in bounds
                                    let n = idx.rem_euclid(depth as c_int + 1);
                                    (api.js_rot)(j, n)
                                }
                            }
                            for l in snapshot(api, j) {
                                log(l);
                            }
                        }
                    },
                );
            }
        }
    }
}

'''
