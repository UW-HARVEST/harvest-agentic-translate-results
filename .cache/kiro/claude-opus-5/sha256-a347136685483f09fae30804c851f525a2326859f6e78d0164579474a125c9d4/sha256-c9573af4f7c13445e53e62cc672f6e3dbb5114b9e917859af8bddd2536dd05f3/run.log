[0m[49m[38;5;10m+    182[0m:[38;5;10m[49m         let diri = rng.vec2_small_int(4);
[0m[49m[38;5;10m+    183[0m:[38;5;10m[49m         let si = rng.small_int(4);
[0m[49m[38;5;10m+    184[0m:[38;5;10m[49m         let ti = rng.small_int(4);
[0m[49m[38;5;10m+    185[0m:[38;5;10m[49m         diff.check(
[0m[49m[38;5;10m+    186[0m:[38;5;10m[49m             p1i,
[0m[49m[38;5;10m+    187[0m:[38;5;10m[49m             add2(p1i, scale2(diri, ti)),
[0m[49m[38;5;10m+    188[0m:[38;5;10m[49m             add2(p1i, scale2(diri, si)),
[0m[49m[38;5;10m+    189[0m:[38;5;10m[49m             rng.vec2_small_int(8),
[0m[49m[38;5;10m+    190[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    191[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    192[0m:[38;5;10m[49m     diff.finish();
[0m[49m[38;5;10m+    193[0m:[38;5;10m[49m }
