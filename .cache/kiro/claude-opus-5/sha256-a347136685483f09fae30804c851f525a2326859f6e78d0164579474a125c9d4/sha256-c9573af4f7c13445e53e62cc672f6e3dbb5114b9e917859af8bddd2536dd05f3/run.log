[0m[49m[38;5;10m+    504[0m:[38;5;10m[49m /// E14 — unrestricted bit-pattern fuzz: proves there is no input the C rejects
[0m[49m[38;5;10m+    505[0m:[38;5;10m[49m /// and pins the exact result for every IEEE class combination.
[0m[49m[38;5;10m+    506[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    507[0m:[38;5;10m[49m fn phase_c_e14_no_input_is_rejected() {
[0m[49m[38;5;10m+    508[0m:[38;5;10m[49m     let d = Dual::load();
[0m[49m[38;5;10m+    509[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0xEE);
[0m[49m[38;5;10m+    510[0m:[38;5;10m[49m     let mut diff = Diff::new(&d, "E14 unrestricted fuzz");
[0m[49m[38;5;10m+    511[0m:[38;5;10m[49m     for _ in 0..200_000 {
[0m[49m[38;5;10m+    512[0m:[38;5;10m[49m         let p1 = rng.vec2_any();
[0m[49m[38;5;10m+    513[0m:[38;5;10m[49m         let p2 = rng.vec2_any();
[0m[49m[38;5;10m+    514[0m:[38;5;10m[49m         let p3 = rng.vec2_any();
[0m[49m[38;5;10m+    515[0m:[38;5;10m[49m         let p = rng.vec2_any();
[0m[49m[38;5;10m+    516[0m:[38;5;10m[49m         diff.check(p1, p2, p3, p);
[0m[49m[38;5;10m+    517[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    518[0m:[38;5;10m[49m     diff.finish();
[0m[49m[38;5;10m+    519[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    520[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    521[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    522[0m:[38;5;10m[49m // Generic C-API boundary cases required by Phase C even though `ERRORS.md`
[0m[49m[38;5;10m+    523[0m:[38;5;10m[49m // shows they are structurally inapplicable to this signature.
[0m[49m[38;5;10m+    524[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    525[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    526[0m:[38;5;10m[49m /// The public API has no pointer parameters, so a "null pointer" input cannot
[0m[49m[38;5;10m+    527[0m:[38;5;10m[49m /// be constructed. This test proves that mechanically from the exported
[0m[49m[38;5;10m+    528[0m:[38;5;10m[49m /// signature instead of silently skipping the case: the bit pattern that would
[0m[49m[38;5;10m+    529[0m:[38;5;10m[49m /// be a null pointer (all-zero words) is passed as the argument values, and the
[0m[49m[38;5;10m+    530[0m:[38;5;10m[49m /// nearest analogue (all-zero `lm_vec2`s) is compared.
[0m[49m[38;5;10m+    531[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    532[0m:[38;5;10m[49m fn phase_c_boundary_no_pointer_parameters() {
[0m[49m[38;5;10m+    533[0m:[38;5;10m[49m     let d = Dual::load();
[0m[49m[38;5;10m+    534[0m:[38;5;10m[49m     let zero = Vec2::new(f32::from_bits(0), f32::from_bits(0));
[0m[49m[38;5;10m+    535[0m:[38;5;10m[49m     // "all arguments are the null bit pattern"
[0m[49m[38;5;10m+    536[0m:[38;5;10m[49m     let out = both(&d, zero, zero, zero, zero);
[0m[49m[38;5;10m+    537[0m:[38;5;10m[49m     assert!(out.x.is_nan() && out.y.is_nan());
[0m[49m[38;5;10m+    538[0m:[38;5;10m[49m     // one slot at a time zeroed, rest normal
[0m[49m[38;5;10m+    539[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0xF0);
[0m[49m[38;5;10m+    540[0m:[38;5;10m[49m     let mut diff = Diff::new(&d, "boundary null-analogue");
[0m[49m[38;5;10m+    541[0m:[38;5;10m[49m     for _ in 0..N {
[0m[49m[38;5;10m+    542[0m:[38;5;10m[49m         let mut c = [0f32; 8];
[0m[49m[38;5;10m+    543[0m:[38;5;10m[49m         for s in c.iter_mut() {
[0m[49m[38;5;10m+    544[0m:[38;5;10m[49m             *s = rng.wide_normal();
[0m[49m[38;5;10m+    545[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    546[0m:[38;5;10m[49m         for slot in 0..8usize {
[0m[49m[38;5;10m+    547[0m:[38;5;10m[49m             let mut cc = c;
[0m[49m[38;5;10m+    548[0m:[38;5;10m[49m             cc[slot] = f32::from_bits(0);
[0m[49m[38;5;10m+    549[0m:[38;5;10m[49m             let (p1, p2, p3, p) = from_components(cc);
[0m[49m[38;5;10m+    550[0m:[38;5;10m[49m             diff.check(p1, p2, p3, p);
[0m[49m[38;5;10m+    551[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    552[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    553[0m:[38;5;10m[49m     diff.finish();
[0m[49m[38;5;10m+    554[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    555[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    556[0m:[38;5;10m[49m /// The public API has no length/size/count parameter, so "zero and oversized
[0m[49m[38;5;10m+    557[0m:[38;5;10m[49m /// lengths" cannot be constructed. The closest reachable analogue is a
[0m[49m[38;5;10m+    558[0m:[38;5;10m[49m /// zero-length edge (`v0 == 0` and/or `v1 == 0`, i.e. a zero-extent triangle)
[0m[49m[38;5;10m+    559[0m:[38;5;10m[49m /// and an "oversized" extent (`FLT_MAX`-scale edges), both of which are
[0m[49m[38;5;10m+    560[0m:[38;5;10m[49m /// asserted bit-exactly here.
[0m[49m[38;5;10m+    561[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    562[0m:[38;5;10m[49m fn phase_c_boundary_zero_and_oversized_extent() {
[0m[49m[38;5;10m+    563[0m:[38;5;10m[49m     let d = Dual::load();
[0m[49m[38;5;10m+    564[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0xF1);
[0m[49m[38;5;10m+    565[0m:[38;5;10m[49m     let mut diff = Diff::new(&d, "boundary zero/oversized extent");
[0m[49m[38;5;10m+    566[0m:[38;5;10m[49m     for _ in 0..N {
[0m[49m[38;5;10m+    567[0m:[38;5;10m[49m         let a = rng.vec2_unit();
[0m[49m[38;5;10m+    568[0m:[38;5;10m[49m         let p = rng.vec2_unit();
[0m[49m[38;5;10m+    569[0m:[38;5;10m[49m         // zero extent in one or both edges
[0m[49m[38;5;10m+    570[0m:[38;5;10m[49m         diff.check(a, a, a, p);
[0m[49m[38;5;10m+    571[0m:[38;5;10m[49m         diff.check(a, a, add2(a, rng.vec2_unit()), p);
[0m[49m[38;5;10m+    572[0m:[38;5;10m[49m         diff.check(a, add2(a, rng.vec2_unit()), a, p);
[0m[49m[38;5;10m+    573[0m:[38;5;10m[49m         // oversized extent
[0m[49m[38;5;10m+    574[0m:[38;5;10m[49m         let huge = Vec2::new(f32::MAX, f32::MAX);
[0m[49m[38;5;10m+    575[0m:[38;5;10m[49m         diff.check(a, add2(a, huge), a, p);
[0m[49m[38;5;10m+    576[0m:[38;5;10m[49m         diff.check(
[0m[49m[38;5;10m+    577[0m:[38;5;10m[49m             Vec2::new(-f32::MAX, -f32::MAX),
[0m[49m[38;5;10m+    578[0m:[38;5;10m[49m             Vec2::new(f32::MAX, -f32::MAX),
[0m[49m[38;5;10m+    579[0m:[38;5;10m[49m             Vec2::new(-f32::MAX, f32::MAX),
[0m[49m[38;5;10m+    580[0m:[38;5;10m[49m             p,
[0m[49m[38;5;10m+    581[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    582[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    583[0m:[38;5;10m[49m     diff.finish();
[0m[49m[38;5;10m+    584[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    585[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    586[0m:[38;5;10m[49m /// The public API has no `enum` (or any integer) parameter, so an
[0m[49m[38;5;10m+    587[0m:[38;5;10m[49m /// "out-of-range enum value" cannot be constructed. `float` is the only
[0m[49m[38;5;10m+    588[0m:[38;5;10m[49m /// parameter type and it has **no** invalid bit pattern: all 2^32 words are
[0m[49m[38;5;10m+    589[0m:[38;5;10m[49m /// valid `float`s. This test proves the claim by walking the entire exponent
[0m[49m[38;5;10m+    590[0m:[38;5;10m[49m /// field plus the boundary mantissas of every IEEE class through every one of
[0m[49m[38;5;10m+    591[0m:[38;5;10m[49m /// the eight argument slots — the exhaustive analogue of "one step past the
[0m[49m[38;5;10m+    592[0m:[38;5;10m[49m /// documented valid range".
[0m[49m[38;5;10m+    593[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    594[0m:[38;5;10m[49m fn phase_c_boundary_every_ieee_class_in_every_slot() {
[0m[49m[38;5;10m+    595[0m:[38;5;10m[49m     let d = Dual::load();
[0m[49m[38;5;10m+    596[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0xF2);
[0m[49m[38;5;10m+    597[0m:[38;5;10m[49m     let mut diff = Diff::new(&d, "boundary IEEE class sweep");
[0m[49m[38;5;10m+    598[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    599[0m:[38;5;10m[49m     // Class boundaries: one step below / at / one step above every transition.
[0m[49m[38;5;10m+    600[0m:[38;5;10m[49m     let mut probes: Vec<u32> = Vec::new();
[0m[49m[38;5;10m+    601[0m:[38;5;10m[49m     for &base in &[
[0m[49m[38;5;10m+    602[0m:[38;5;10m[49m         0x0000_0000u32, // +0
[0m[49m[38;5;10m+    603[0m:[38;5;10m[49m         0x0000_0001,    // smallest subnormal
[0m[49m[38;5;10m+    604[0m:[38;5;10m[49m         0x007F_FFFF,    // largest subnormal
[0m[49m[38;5;10m+    605[0m:[38;5;10m[49m         0x0080_0000,    // smallest normal (FLT_MIN)
[0m[49m[38;5;10m+    606[0m:[38;5;10m[49m         0x0080_0001,
[0m[49m[38;5;10m+    607[0m:[38;5;10m[49m         0x3F7F_FFFF, // just below 1.0
[0m[49m[38;5;10m+    608[0m:[38;5;10m[49m         0x3F80_0000, // 1.0
[0m[49m[38;5;10m+    609[0m:[38;5;10m[49m         0x3F80_0001, // just above 1.0
[0m[49m[38;5;10m+    610[0m:[38;5;10m[49m         0x7F7F_FFFE,
[0m[49m[38;5;10m+    611[0m:[38;5;10m[49m         0x7F7F_FFFF, // FLT_MAX
[0m[49m[38;5;10m+    612[0m:[38;5;10m[49m         0x7F80_0000, // +inf
[0m[49m[38;5;10m+    613[0m:[38;5;10m[49m         0x7F80_0001, // smallest sNaN
[0m[49m[38;5;10m+    614[0m:[38;5;10m[49m         0x7FBF_FFFF, // largest sNaN
[0m[49m[38;5;10m+    615[0m:[38;5;10m[49m         0x7FC0_0000, // smallest qNaN
[0m[49m[38;5;10m+    616[0m:[38;5;10m[49m         0x7FFF_FFFF, // largest qNaN
[0m[49m[38;5;10m+    617[0m:[38;5;10m[49m     ] {
[0m[49m[38;5;10m+    618[0m:[38;5;10m[49m         probes.push(base);
[0m[49m[38;5;10m+    619[0m:[38;5;10m[49m         probes.push(base | 0x8000_0000); // negative counterpart
[0m[49m[38;5;10m+    620[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    621[0m:[38;5;10m[49m     // full exponent walk at a fixed mantissa
[0m[49m[38;5;10m+    622[0m:[38;5;10m[49m     for exp in 0..=255u32 {
[0m[49m[38;5;10m+    623[0m:[38;5;10m[49m         probes.push((exp << 23) | 0x0012_3456);
[0m[49m[38;5;10m+    624[0m:[38;5;10m[49m         probes.push(0x8000_0000 | (exp << 23) | 0x0012_3456);
[0m[49m[38;5;10m+    625[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    626[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    627[0m:[38;5;10m[49m     for &bits in &probes {
[0m[49m[38;5;10m+    628[0m:[38;5;10m[49m         let v = f32::from_bits(bits);
[0m[49m[38;5;10m+    629[0m:[38;5;10m[49m         for slot in 0..8usize {
[0m[49m[38;5;10m+    630[0m:[38;5;10m[49m             // against a fixed well-conditioned background
[0m[49m[38;5;10m+    631[0m:[38;5;10m[49m             let mut c = [0.0f32, 0.0, 1.0, 0.0, 0.0, 1.0, 0.25, 0.25];
[0m[49m[38;5;10m+    632[0m:[38;5;10m[49m             c[slot] = v;
[0m[49m[38;5;10m+    633[0m:[38;5;10m[49m             let (p1, p2, p3, p) = from_components(c);
[0m[49m[38;5;10m+    634[0m:[38;5;10m[49m             diff.check(p1, p2, p3, p);
[0m[49m[38;5;10m+    635[0m:[38;5;10m[49m             // and against randomized backgrounds
[0m[49m[38;5;10m+    636[0m:[38;5;10m[49m             for _ in 0..4 {
[0m[49m[38;5;10m+    637[0m:[38;5;10m[49m                 let mut r = [0f32; 8];
[0m[49m[38;5;10m+    638[0m:[38;5;10m[49m                 for s in r.iter_mut() {
[0m[49m[38;5;10m+    639[0m:[38;5;10m[49m                     *s = rng.wide_normal();
[0m[49m[38;5;10m+    640[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    641[0m:[38;5;10m[49m                 r[slot] = v;
[0m[49m[38;5;10m+    642[0m:[38;5;10m[49m                 let (q1, q2, q3, q) = from_components(r);
[0m[49m[38;5;10m+    643[0m:[38;5;10m[49m                 diff.check(q1, q2, q3, q);
[0m[49m[38;5;10m+    644[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    645[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    646[0m:[38;5;10m[49m         // and with every slot set to the probe value at once
[0m[49m[38;5;10m+    647[0m:[38;5;10m[49m         let c = [v; 8];
[0m[49m[38;5;10m+    648[0m:[38;5;10m[49m         let (p1, p2, p3, p) = from_components(c);
[0m[49m[38;5;10m+    649[0m:[38;5;10m[49m         diff.check(p1, p2, p3, p);
[0m[49m[38;5;10m+    650[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    651[0m:[38;5;10m[49m     diff.finish();
[0m[49m[38;5;10m+    652[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    653[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    654[0m:[38;5;10m[49m /// Pairwise sweep: every ordered pair of class-boundary values placed in every
[0m[49m[38;5;10m+    655[0m:[38;5;10m[49m /// ordered pair of argument slots. This is the case that catches operand-order
[0m[49m[38;5;10m+    656[0m:[38;5;10m[49m /// bugs in commutative operations, because it is the only way to get two
[0m[49m[38;5;10m+    657[0m:[38;5;10m[49m /// *different* NaNs into the two operands of a single `mulss`/`addss`.
[0m[49m[38;5;10m+    658[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    659[0m:[38;5;10m[49m fn phase_c_boundary_pairwise_class_sweep() {
[0m[49m[38;5;10m+    660[0m:[38;5;10m[49m     let d = Dual::load();
[0m[49m[38;5;10m+    661[0m:[38;5;10m[49m     let mut diff = Diff::new(&d, "boundary pairwise class sweep");
[0m[49m[38;5;10m+    662[0m:[38;5;10m[49m     let probes: [u32; 16] = [
[0m[49m[38;5;10m+    663[0m:[38;5;10m[49m         0x0000_0000,
[0m[49m[38;5;10m+    664[0m:[38;5;10m[49m         0x8000_0000,
[0m[49m[38;5;10m+    665[0m:[38;5;10m[49m         0x0000_0001,
[0m[49m[38;5;10m+    666[0m:[38;5;10m[49m         0x8000_0001,
[0m[49m[38;5;10m+    667[0m:[38;5;10m[49m         0x0080_0000,
[0m[49m[38;5;10m+    668[0m:[38;5;10m[49m         0x3F80_0000,
[0m[49m[38;5;10m+    669[0m:[38;5;10m[49m         0xBF80_0000,
[0m[49m[38;5;10m+    670[0m:[38;5;10m[49m         0x7F7F_FFFF,
[0m[49m[38;5;10m+    671[0m:[38;5;10m[49m         0xFF7F_FFFF,
[0m[49m[38;5;10m+    672[0m:[38;5;10m[49m         0x7F80_0000,
[0m[49m[38;5;10m+    673[0m:[38;5;10m[49m         0xFF80_0000,
[0m[49m[38;5;10m+    674[0m:[38;5;10m[49m         0x7F80_0001,
[0m[49m[38;5;10m+    675[0m:[38;5;10m[49m         0x7FC0_0000,
[0m[49m[38;5;10m+    676[0m:[38;5;10m[49m         0xFFC0_0000,
[0m[49m[38;5;10m+    677[0m:[38;5;10m[49m         0x7FC1_2345,
[0m[49m[38;5;10m+    678[0m:[38;5;10m[49m         0xFFDE_ADBE,
[0m[49m[38;5;10m+    679[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    680[0m:[38;5;10m[49m     for &a in &probes {
[0m[49m[38;5;10m+    681[0m:[38;5;10m[49m         for &b in &probes {
[0m[49m[38;5;10m+    682[0m:[38;5;10m[49m             let va = f32::from_bits(a);
[0m[49m[38;5;10m+    683[0m:[38;5;10m[49m             let vb = f32::from_bits(b);
[0m[49m[38;5;10m+    684[0m:[38;5;10m[49m             for i in 0..8usize {
[0m[49m[38;5;10m+    685[0m:[38;5;10m[49m                 for j in 0..8usize {
[0m[49m[38;5;10m+    686[0m:[38;5;10m[49m                     if i == j {
[0m[49m[38;5;10m+    687[0m:[38;5;10m[49m                         continue;
[0m[49m[38;5;10m+    688[0m:[38;5;10m[49m                     }
[0m[49m[38;5;10m+    689[0m:[38;5;10m[49m                     let mut c = [1.0f32, 2.0, 3.0, 5.0, 7.0, 11.0, 13.0, 17.0];
