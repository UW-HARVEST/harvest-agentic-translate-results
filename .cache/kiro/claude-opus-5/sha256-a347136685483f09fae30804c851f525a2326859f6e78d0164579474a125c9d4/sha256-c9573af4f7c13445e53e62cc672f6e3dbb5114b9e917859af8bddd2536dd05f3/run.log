[0m[49m[38;5;10m+    174[0m:[38;5;10m[49m         let s = rng.range(-4.0, 4.0);
[0m[49m[38;5;10m+    175[0m:[38;5;10m[49m         let t = rng.range(-4.0, 4.0);
[0m[49m[38;5;10m+    176[0m:[38;5;10m[49m         let p3 = add2(p1, scale2(dir, s));
[0m[49m[38;5;10m+    177[0m:[38;5;10m[49m         let p2 = add2(p1, scale2(dir, t));
[0m[49m[38;5;10m+    178[0m:[38;5;10m[49m         let p = rng.vec2_unit();
[0m[49m[38;5;10m+    179[0m:[38;5;10m[49m         diff.check(p1, p2, p3, p);
