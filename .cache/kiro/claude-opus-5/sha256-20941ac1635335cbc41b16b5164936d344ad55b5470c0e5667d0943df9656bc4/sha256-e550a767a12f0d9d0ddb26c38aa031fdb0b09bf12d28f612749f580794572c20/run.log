#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <dlfcn.h>
#include <stdint.h>
#include <math.h>

typedef void (*fn_t)(float*, const float*);

static uint32_t st = 0x12345678u;
static uint32_t xr(void){ st^=st<<13; st^=st>>17; st^=st<<5; return st; }

int main(int argc, char** argv){
    void* hc = dlopen(argv[1], RTLD_NOW);
    void* hr = dlopen(argv[2], RTLD_NOW);
    if(!hc||!hr){ printf("dlopen fail: %s\n", dlerror()); return 2; }
    fn_t fc = (fn_t)dlsym(hc, "rgb_to_hsv");
    fn_t fr = (fn_t)dlsym(hr, "rgb_to_hsv");
    if(!fc||!fr){ printf("dlsym fail\n"); return 2; }

    float specials[] = {0.0f, -0.0f, 1.0f, -1.0f, 0.5f, 255.0f, 1e-38f, 1e38f,
                        INFINITY, -INFINITY, NAN, 3.4028235e38f, -3.4028235e38f,
                        1e-45f, 0.3333333f, 100.0f};
    int ns = sizeof(specials)/sizeof(specials[0]);
    long total=0, bad=0;

    /* exhaustive over special triples */
    for(int i=0;i<ns;i++) for(int j=0;j<ns;j++) for(int k=0;k<ns;k++){
        float src[3] = {specials[i], specials[j], specials[k]};
        float dc[3], dr[3];
        memset(dc,0xAA,sizeof dc); memset(dr,0xAA,sizeof dr);
        fc(dc, src); fr(dr, src);
        total++;
        if(memcmp(dc,dr,sizeof dc)!=0){
            bad++;
            if(bad<=10) printf("MISMATCH src=%a,%a,%a  c=%a,%a,%a  rs=%a,%a,%a\n",
                src[0],src[1],src[2],dc[0],dc[1],dc[2],dr[0],dr[1],dr[2]);
        }
    }

    /* random bit patterns (all floats incl. NaN/denormals) */
    for(long n=0;n<3000000;n++){
        uint32_t u[3]={xr(),xr(),xr()};
        float src[3]; memcpy(src,u,sizeof src);
        float dc[3], dr[3];
        memset(dc,0xAA,sizeof dc); memset(dr,0xAA,sizeof dr);
        fc(dc, src); fr(dr, src);
        total++;
        if(memcmp(dc,dr,sizeof dc)!=0){
            bad++;
            if(bad<=10) printf("MISMATCH src=%a,%a,%a  c=%a,%a,%a  rs=%a,%a,%a\n",
                src[0],src[1],src[2],dc[0],dc[1],dc[2],dr[0],dr[1],dr[2]);
        }
    }

    /* random in [0,1] plus duplicate-channel cases */
    for(long n=0;n<2000000;n++){
        float a = (float)(xr()%1001)/1000.0f;
        float b = (float)(xr()%1001)/1000.0f;
        float src[3];
        switch(n%4){
            case 0: src[0]=a; src[1]=b; src[2]=(float)(xr()%1001)/1000.0f; break;
            case 1: src[0]=a; src[1]=a; src[2]=b; break;
            case 2: src[0]=a; src[1]=b; src[2]=a; break;
            default: src[0]=b; src[1]=a; src[2]=a; break;
        }
        float dc[3], dr[3];
        memset(dc,0xAA,sizeof dc); memset(dr,0xAA,sizeof dr);
        fc(dc, src); fr(dr, src);
        total++;
        if(memcmp(dc,dr,sizeof dc)!=0){
            bad++;
            if(bad<=10) printf("MISMATCH src=%a,%a,%a\n",src[0],src[1],src[2]);
        }
    }

    printf("total=%ld mismatches=%ld\n", total, bad);
    return bad?1:0;
}
EOF
