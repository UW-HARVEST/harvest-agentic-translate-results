[0m[49m[38;5;10m+    557[0m:[38;5;10m[49m // (`Result: N`) the C source produces.
[0m[49m[38;5;10m+    558[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    559[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    560[0m:[38;5;10m[49m // ERRORS.md row 1: x != 1.
[0m[49m[38;5;10m+    561[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    562[0m:[38;5;10m[49m fn err_row1_x_not_1() {
