[0m[49m[38;5;10m+    264[0m:[38;5;10m[49m         z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
[0m[49m[38;5;10m+    265[0m:[38;5;10m[49m         z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
[0m[49m[38;5;10m+    266[0m:[38;5;10m[49m         z ^ (z >> 31)
[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m     }
