[0m[49m[38;5;10m+    572[0m:[38;5;10m[49m         let (x, y, z) = (rng.i32_not(1), rng.i32(), rng.i32());
[0m[49m[38;5;10m+    573[0m:[38;5;10m[49m         let out = assert_same_call("ERRORS row 1", &c, &r, x, y, z);
[0m[49m[38;5;10m+    574[0m:[38;5;10m[49m         assert_eq!(
