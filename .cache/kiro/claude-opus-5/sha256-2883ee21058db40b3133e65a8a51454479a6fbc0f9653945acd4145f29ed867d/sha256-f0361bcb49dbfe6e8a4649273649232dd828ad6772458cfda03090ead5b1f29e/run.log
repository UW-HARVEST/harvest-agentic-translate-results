[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m // Deterministic PRNG (splitmix64), fixed seed for reproducibility.
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m struct Rng(u64);
