[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m     for &(x, y, z) in inputs {
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m         assert_same_call(row, &c2, &r2, x, y, z);
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m     panic!(
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m         "[{row}] batch transcripts diverged over {} calls (index {:?}) although every single call matched in isolation — the persisted `static y` state must differ.\n  C len {} / Rust len {}",
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m         inputs.len(),
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m         first_diff(&c_out, &r_out),
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m         c_out.len(),
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m         r_out.len()
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    236[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    237[0m:[38;5;10m[49m /// Assert both libraries produce exactly the tabulated bytes from ERRORS.md,
[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m /// i.e. the same error *sentinel*, not merely "both failed somehow".
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m fn assert_same_and_expected(row: &str, x: i32, y: i32, z: i32, expected: &str) {
