[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m /// Batched differential assertion: runs the whole input list against C in one
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m /// capture and against Rust in one capture, then compares the two complete
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m /// transcripts. This is stricter than per-call comparison because any
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m /// divergence in the persisted `static y` shows up in later calls too. On
[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m /// mismatch it re-runs per input to name the exact offending arguments.
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m fn assert_same_batch(row: &str, inputs: &[(i32, i32, i32)]) {
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m     let (c, r) = load_pair();
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m     let c_out = capture(|| {
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m         for &(x, y, z) in inputs {
[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m             c.call(x, y, z);
[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m     });
