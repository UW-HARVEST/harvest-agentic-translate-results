[0m[49m[38;5;10m+    518[0m:[38;5;10m[49m // CONFIGS.md row 16: interleave C and Rust calls on the SAME redirected stdout
[0m[49m[38;5;10m+    519[0m:[38;5;10m[49m // stream. The C compiler rewrote the conversion-free `printf`s into `puts`
[0m[49m[38;5;10m+    520[0m:[38;5;10m[49m // while the Rust build calls `printf`; interleaving proves both go through the
[0m[49m[38;5;10m+    521[0m:[38;5;10m[49m // same libc stdio buffer and emit identical bytes in identical stream order.
[0m[49m[38;5;10m+    522[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    523[0m:[38;5;10m[49m fn cfg_row16_interleaved_on_one_stream() {
[0m[49m[38;5;10m+    524[0m:[38;5;10m[49m     let _g = serial_guard();
[0m[49m[38;5;10m+    525[0m:[38;5;10m[49m     let mut rng = Rng::new();
[0m[49m[38;5;10m+    526[0m:[38;5;10m[49m     let inputs: Vec<_> = (0..256)
[0m[49m[38;5;10m+    527[0m:[38;5;10m[49m         .map(|_| (rng.small(), rng.small(), rng.small()))
[0m[49m[38;5;10m+    528[0m:[38;5;10m[49m         .collect();
[0m[49m[38;5;10m+    529[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    530[0m:[38;5;10m[49m     let (c, r) = load_pair();
[0m[49m[38;5;10m+    531[0m:[38;5;10m[49m     // Reference: the same call made twice against C only.
[0m[49m[38;5;10m+    532[0m:[38;5;10m[49m     let cc = capture(|| {
[0m[49m[38;5;10m+    533[0m:[38;5;10m[49m         for &(x, y, z) in &inputs {
[0m[49m[38;5;10m+    534[0m:[38;5;10m[49m             c.call(x, y, z);
[0m[49m[38;5;10m+    535[0m:[38;5;10m[49m             c.call(x, y, z);
[0m[49m[38;5;10m+    536[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    537[0m:[38;5;10m[49m     });
[0m[49m[38;5;10m+    538[0m:[38;5;10m[49m     // Under test: C then Rust, alternating, in one stream.
[0m[49m[38;5;10m+    539[0m:[38;5;10m[49m     let cr = capture(|| {
[0m[49m[38;5;10m+    540[0m:[38;5;10m[49m         for &(x, y, z) in &inputs {
[0m[49m[38;5;10m+    541[0m:[38;5;10m[49m             c.call(x, y, z);
[0m[49m[38;5;10m+    542[0m:[38;5;10m[49m             r.call(x, y, z);
[0m[49m[38;5;10m+    543[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    544[0m:[38;5;10m[49m     });
[0m[49m[38;5;10m+    545[0m:[38;5;10m[49m     assert_eq!(
[0m[49m[38;5;10m+    546[0m:[38;5;10m[49m         cr,
[0m[49m[38;5;10m+    547[0m:[38;5;10m[49m         cc,
[0m[49m[38;5;10m+    548[0m:[38;5;10m[49m         "[CONFIGS row 16] interleaved C/Rust transcript differs from C/C reference at byte {:?}",
[0m[49m[38;5;10m+    549[0m:[38;5;10m[49m         first_diff(&cr, &cc)
[0m[49m[38;5;10m+    550[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    551[0m:[38;5;10m[49m     assert!(!cc.is_empty());
[0m[49m[38;5;10m+    552[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    553[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    554[0m:[38;5;10m[49m // ===========================================================================
