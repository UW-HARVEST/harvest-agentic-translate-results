    uint32_t yb=(uint32_t)rnd(); int e;
    uint64_t z=rnd();
    switch(z&3){case 0: e=(int)(int32_t)rnd(); break;
                case 1: e=(int)((int32_t)(rnd()%2000)-1000); break;
                case 2: e=(int)((int32_t)(rnd()%300)-150); break;
                default: e=(int)((int32_t)(rnd()%100000)-50000);}
    float y=f_of(yb);
    uint32_t rc=b(c(y,e)), rr=b(r(y,e)); n++;
    if(rc!=rr){ if(bad<10) printf("MISMATCH y=%08x e=%d c=%08x rust=%08x\n",yb,e,rc,rr); bad++; }
  }
  printf("compared=%lld mismatches=%lld\n",n,bad);
  return bad?1:0;
}
