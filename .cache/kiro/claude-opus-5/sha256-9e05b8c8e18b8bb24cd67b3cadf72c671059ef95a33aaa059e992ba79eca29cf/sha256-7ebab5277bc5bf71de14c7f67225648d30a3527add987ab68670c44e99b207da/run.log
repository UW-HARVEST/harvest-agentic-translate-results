import re
p='src/lib.rs'
s=open(p).read()
marker = "// C ABI exports."
i = s.index(marker)
head, tail = s[:i], s[i:]

names = ['c2V','c2Dot','c2Len','c2Add','c2Sub','c2Mulvs','c2Div','c2Norm','c2Minv','c2Maxv',
