# In head: rename fn definitions and call sites (identifier followed by '(')
def repl(m):
    n = m.group(1)
    return n + '_impl(' if n in names else m.group(0)
head = re.sub(r'\b(\w+)\(', repl, head)
open(p,'w').write(head + tail)
print("renamed")
