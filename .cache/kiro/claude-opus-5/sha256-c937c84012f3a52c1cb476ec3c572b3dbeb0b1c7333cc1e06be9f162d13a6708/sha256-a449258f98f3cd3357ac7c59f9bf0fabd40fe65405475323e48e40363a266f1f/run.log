[0m[49m[38;5;10m+    474[0m:[38;5;10m[49m         if r & (1 << 60) != 0 {
[0m[49m[38;5;10m+    475[0m:[38;5;10m[49m             s.push(if r & (1 << 61) != 0 { '-' } else { '+' });
[0m[49m[38;5;10m+    476[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    477[0m:[38;5;10m[49m         let mut w = next();
[0m[49m[38;5;10m+    478[0m:[38;5;10m[49m         for _ in 0..n {
[0m[49m[38;5;10m+    479[0m:[38;5;10m[49m             s.push(DIGITS[(w % 10) as usize] as char);
[0m[49m[38;5;10m+    480[0m:[38;5;10m[49m             w /= 10;
[0m[49m[38;5;10m+    481[0m:[38;5;10m[49m             if w == 0 {
[0m[49m[38;5;10m+    482[0m:[38;5;10m[49m                 w = next();
[0m[49m[38;5;10m+    483[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    484[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    485[0m:[38;5;10m[49m         if r & (1 << 55) != 0 {
