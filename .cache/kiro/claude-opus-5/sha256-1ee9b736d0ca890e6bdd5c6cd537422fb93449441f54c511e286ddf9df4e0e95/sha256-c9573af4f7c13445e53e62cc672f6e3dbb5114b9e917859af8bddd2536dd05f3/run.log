    35	int cleanup(int a, int b, int c, int d) {
    36	    int numbers[] = {a, b, c, d};
    37	    char *dynamic_str = NULL;
    38	    int result = 0;
    39	
    40	    const char *expected_str = "VALID";
    41	    const char *input_str = "VALID";
    42	    if (strncmp(input_str, expected_str, strlen(expected_str)) != 0) {
    43	        printf("Input string validation failed.\n");
    44	        goto cleanup;
    45	    }
    46	
    47	    for (int i = 0; i < 4; i++) {
    48	        switch (numbers[i]) {
    49	            case 10:
    50	                result += 10;
    51	            case 20:
    52	                result += 20;
    53	                break;
    54	            case 30:
    55	                result += 30;
    56	            case 40:
    57	                result += 40;
    58	                break;
    59	            default:
    60	                result += numbers[i];
    61	                break;
    62	        }
    63	    }
    64	
    65	    dynamic_str = (char *)malloc(50 * sizeof(char));
    66	    if (!dynamic_str) {
    67	        printf("Memory allocation failed.\n");
    68	        goto cleanup;
    69	    }
    70	
    71	    snprintf(dynamic_str, 50, "Processed numbers: %s", TO_STRING(numbers));
    72	    printf("%s\n", dynamic_str);
    73	
    74	cleanup:
    75	    cleanup_resources(dynamic_str);
    76	    return result;
    77	}
    78	
    79	void print_result(const char *label, int result) {
    80	    printf("%s: %d\n", label, result);
    81	}
    82	
    83	void cleanup_resources(char *dynamic_str) {
    84	    if (dynamic_str) {
    85	        free(dynamic_str);
    86	        dynamic_str = NULL;
    87	    }
    88	}
