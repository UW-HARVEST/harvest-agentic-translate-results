    26	use std::ffi::{c_char, c_int, c_void};
    27	use std::ptr;
    28	
    29	// The C translation unit uses the platform C library for all I/O and memory
    30	// management. We bind to the very same functions so that stdio buffering,
    31	// formatting and heap ownership are byte-for-byte identical to the original,
    32	// and so that a pointer handed to `cleanup_resources` may legitimately come
    33	// from (or go to) C `malloc`/`free`.
    34	unsafe extern "C" {
    35	    fn printf(format: *const c_char, ...) -> c_int;
    36	    fn snprintf(s: *mut c_char, n: usize, format: *const c_char, ...) -> c_int;
    37	    fn malloc(size: usize) -> *mut c_void;
    38	    fn free(ptr: *mut c_void);
    39	    fn strncmp(s1: *const c_char, s2: *const c_char, n: usize) -> c_int;
    40	    fn strlen(s: *const c_char) -> usize;
    41	}
    42	
    43	/// ```c
    44	/// int cleanup(int a, int b, int c, int d);
    45	/// ```
    46	///
    47	/// Faithful translation, including:
    48	///   * the deliberate `switch` fall-through from `case 10` into `case 20`
    49	///     and from `case 30` into `case 40`;
    50	///   * `TO_STRING(numbers)`, which the C preprocessor stringizes to the
    51	///     literal text `numbers` (it is *not* the array contents);
    52	///   * the `goto cleanup` control flow, modelled with a labelled block.
    53	#[unsafe(no_mangle)]
    54	pub unsafe extern "C" fn cleanup(a: c_int, b: c_int, c: c_int, d: c_int) -> c_int {
    55	    let numbers: [c_int; 4] = [a, b, c, d];
    56	    let mut dynamic_str: *mut c_char = ptr::null_mut();
    57	    let mut result: c_int = 0;
    58	
    59	    let expected_str: *const c_char = c"VALID".as_ptr();
    60	    let input_str: *const c_char = c"VALID".as_ptr();
    61	
    62	    // `'cleanup: { ... break 'cleanup; }` reproduces `goto cleanup;`.
    63	    'cleanup: {
    64	        if unsafe { strncmp(input_str, expected_str, strlen(expected_str)) } != 0 {
    65	            unsafe { printf(c"Input string validation failed.\n".as_ptr()) };
    66	            break 'cleanup;
    67	        }
    68	
    69	        for i in 0..4usize {
    70	            match numbers[i] {
    71	                10 => {
    72	                    // case 10: falls through into case 20
    73	                    result = result.wrapping_add(10);
    74	                    result = result.wrapping_add(20);
    75	                    // break
    76	                }
    77	                20 => {
    78	                    result = result.wrapping_add(20);
    79	                    // break
    80	                }
    81	                30 => {
    82	                    // case 30: falls through into case 40
    83	                    result = result.wrapping_add(30);
    84	                    result = result.wrapping_add(40);
    85	                    // break
    86	                }
    87	                40 => {
    88	                    result = result.wrapping_add(40);
    89	                    // break
    90	                }
    91	                _ => {
    92	                    result = result.wrapping_add(numbers[i]);
    93	                    // break
    94	                }
    95	            }
    96	        }
    97	
    98	        dynamic_str = unsafe { malloc(50 * core::mem::size_of::<c_char>()) } as *mut c_char;
    99	        if dynamic_str.is_null() {
   100	            unsafe { printf(c"Memory allocation failed.\n".as_ptr()) };
   101	            break 'cleanup;
   102	        }
   103	
   104	        unsafe {
   105	            snprintf(
   106	                dynamic_str,
   107	                50,
   108	                c"Processed numbers: %s".as_ptr(),
   109	                c"numbers".as_ptr(),
   110	            );
   111	            printf(c"%s\n".as_ptr(), dynamic_str);
   112	        }
   113	    }
   114	
   115	    // cleanup:
   116	    unsafe { cleanup_resources(dynamic_str) };
   117	    result
   118	}
   119	
   120	/// ```c
   121	/// void print_result(const char *label, int result);
   122	/// ```
   123	#[unsafe(no_mangle)]
   124	pub unsafe extern "C" fn print_result(label: *const c_char, result: c_int) {
   125	    unsafe { printf(c"%s: %d\n".as_ptr(), label, result) };
   126	}
   127	
   128	/// ```c
   129	/// void cleanup_resources(char *dynamic_str);
   130	/// ```
   131	///
   132	/// The trailing `dynamic_str = NULL;` in the C source only clears the local
   133	/// parameter copy, so it has no observable effect and is intentionally left
   134	/// unreproduced (a comment marks where it was).
   135	#[unsafe(no_mangle)]
   136	pub unsafe extern "C" fn cleanup_resources(dynamic_str: *mut c_char) {
   137	    if !dynamic_str.is_null() {
   138	        unsafe { free(dynamic_str as *mut c_void) };
   139	        // dynamic_str = NULL;  /* dead store on the local parameter */
   140	    }
   141	}
