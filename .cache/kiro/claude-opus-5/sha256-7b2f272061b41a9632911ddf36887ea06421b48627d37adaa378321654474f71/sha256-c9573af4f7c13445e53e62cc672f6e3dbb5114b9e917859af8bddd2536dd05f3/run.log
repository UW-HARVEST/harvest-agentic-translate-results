import re
IDENT=r"[A-Za-z0-9_]"
def templates(text):
    out=[]
    for tpl in re.findall(r'"([^"\\]*\{[^"\\]*)"', text):
        core = re.sub(r"\{[^{}]*\}", "\x00", tpl)
        if not re.fullmatch(r"[A-Za-z0-9_\x00]+", core) or "\x00" not in core: continue
        if len(core.replace("\x00","")) < 4: continue
        rx = "^" + "".join(IDENT+"*" if ch=="\x00" else re.escape(ch) for ch in core) + "$"
        out.append(re.compile(rx))
