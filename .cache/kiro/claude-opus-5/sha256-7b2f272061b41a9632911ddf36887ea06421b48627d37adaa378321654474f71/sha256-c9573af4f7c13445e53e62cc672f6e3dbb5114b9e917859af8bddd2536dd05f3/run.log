    """Every symbol-name shape the snippet can produce.

    Two sources:
      * plain string literals, and
      * `format!("..{..}..")` templates, where each `{...}` placeholder is
        treated as an arbitrary identifier fragment. That is how the
        table-driven tests build names, e.g. `format!("{pfx}_encrypt_detached")`
        or `format!("crypto_pwhash_{alg}_str_verify")`.
    """
    lits = set(re.findall(r'"([A-Za-z_][A-Za-z0-9_]*)"', text))
    pats = []
    for tpl in re.findall(r'"([A-Za-z0-9_{}:\\.\\$#?<>\\-]*\\{[^"]*)"', text):
        if "{" not in tpl:
            continue
        # only templates that look like they build a symbol name
        core = re.sub(r"\\{[^{}]*\\}", "\\x00", tpl)
        if not re.fullmatch(r"[A-Za-z0-9_\\x00]+", core):
            continue
        rx = "^" + re.escape(core).replace("\\\\x00", "[A-Za-z0-9_]*") + "$"
        try:
            pats.append(re.compile(rx))
        except re.error:
            pass
    return lits, pats


TABLES = re.compile(
    r"\\b(STREAMS|SECRETBOXES|AEADS|HASHES|XOFS|HMACS|KEYGENS|USIZE_FNS|U64_FNS|"
    r"INT_FNS|U8_FNS|STR_FNS|SS|MALFORMED|fixed_vectors)\\b"
)

for path in sorted(glob.glob(os.path.join(TESTS, "*.rs"))):
    target = os.path.basename(path)[:-3]
    txt = open(path, encoding="utf-8").read()
    file_lits, file_pats = name_patterns(txt)

    blocks = []
    for m in re.finditer(r"#\\[test\\]\\s*\\n\\s*fn\\s+([A-Za-z0-9_]+)", txt):
        blocks.append((m.group(1), m.end()))
    for i, (name, start) in enumerate(blocks):
        end = blocks[i + 1][1] if i + 1 < len(blocks) else len(txt)
        body = txt[start:end]
        test_to_target[name] = target
        lits, pats = name_patterns(body)
        if TABLES.search(body):
            lits |= file_lits
            pats = pats + file_pats
        for s in syms:
            if s in lits or any(p.match(s) for p in pats):
                sym_to_tests.setdefault(s, set()).add(name)

'''
