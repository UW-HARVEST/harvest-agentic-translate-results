[0m[49m[38;5;10m+    553[0m:[38;5;10m[49m                     }, // zero width
[0m[49m[38;5;10m+    554[0m:[38;5;10m[49m                     2 => c2AABB {
[0m[49m[38;5;10m+    555[0m:[38;5;10m[49m                         min: a,
[0m[49m[38;5;10m+    556[0m:[38;5;10m[49m                         max: c2v { x: b.x, y: a.y },
[0m[49m[38;5;10m+    557[0m:[38;5;10m[49m                     }, // zero height
[0m[49m[38;5;10m+    558[0m:[38;5;10m[49m                     _ => c2AABB { min: b, max: a }, // possibly inverted
[0m[49m[38;5;10m+    559[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    560[0m:[38;5;10m[49m             } else {
[0m[49m[38;5;10m+    561[0m:[38;5;10m[49m                 c2AABB {
[0m[49m[38;5;10m+    562[0m:[38;5;10m[49m                     min: c2v {
[0m[49m[38;5;10m+    563[0m:[38;5;10m[49m                         x: a.x.min(b.x),
[0m[49m[38;5;10m+    564[0m:[38;5;10m[49m                         y: a.y.min(b.y),
[0m[49m[38;5;10m+    565[0m:[38;5;10m[49m                     },
[0m[49m[38;5;10m+    566[0m:[38;5;10m[49m                     max: c2v {
