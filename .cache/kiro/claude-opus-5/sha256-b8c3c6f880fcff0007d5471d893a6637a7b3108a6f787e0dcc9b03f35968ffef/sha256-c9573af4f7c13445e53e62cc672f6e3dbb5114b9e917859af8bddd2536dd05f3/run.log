[0m[49m[38;5;10m+    484[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    485[0m:[38;5;10m[49m // Random shape builders (valid, interesting shapes)
[0m[49m[38;5;10m+    486[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    487[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    488[0m:[38;5;10m[49m /// Owns the bytes a shape occupies so a `*const c_void` stays valid.
[0m[49m[38;5;10m+    489[0m:[38;5;10m[49m #[derive(Clone)]
[0m[49m[38;5;10m+    490[0m:[38;5;10m[49m pub enum Shape {
