[0m[49m[38;5;10m+    507[0m:[38;5;10m[49m             Shape::Aabb(c) => c as *const c2AABB as *const c_void,
[0m[49m[38;5;10m+    508[0m:[38;5;10m[49m             Shape::Capsule(c) => c as *const c2Capsule as *const c_void,
[0m[49m[38;5;10m+    509[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    510[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    511[0m:[38;5;10m[49m     pub fn describe(&self) -> String {
