[0m[49m[38;5;10m+    530[0m:[38;5;10m[49m     match ty {
[0m[49m[38;5;10m+    531[0m:[38;5;10m[49m         C2_TYPE_CIRCLE => {
[0m[49m[38;5;10m+    532[0m:[38;5;10m[49m             let p = rng.tame_v(mag);
[0m[49m[38;5;10m+    533[0m:[38;5;10m[49m             let r = if degen {
