typedef struct c2v { float x, y; } c2v;
c2v c2V(float x,float y){c2v a;a.x=x;a.y=y;return a;}
float c2Dot(c2v a,c2v b){return a.x*b.x+a.y*b.y;}
float c2Det2(c2v a,c2v b){return a.x*b.y-a.y*b.x;}
