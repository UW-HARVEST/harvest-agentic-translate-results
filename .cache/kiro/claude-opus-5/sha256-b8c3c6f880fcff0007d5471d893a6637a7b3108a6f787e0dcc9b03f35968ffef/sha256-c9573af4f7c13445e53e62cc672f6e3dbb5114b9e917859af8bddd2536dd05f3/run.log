[0m[49m[38;5;10m+    514[0m:[38;5;10m[49m             Shape::Aabb(c) => format!(
[0m[49m[38;5;10m+    515[0m:[38;5;10m[49m                 "AABB(min=({},{}),max=({},{}))",
[0m[49m[38;5;10m+    516[0m:[38;5;10m[49m                 c.min.x, c.min.y, c.max.x, c.max.y
[0m[49m[38;5;10m+    517[0m:[38;5;10m[49m             ),
[0m[49m[38;5;10m+    518[0m:[38;5;10m[49m             Shape::Capsule(c) => format!(
[0m[49m[38;5;10m+    519[0m:[38;5;10m[49m                 "Capsule(a=({},{}),b=({},{}),r={})",
