#[unsafe(no_mangle)]
pub unsafe extern "C-unwind" fn jsV_numbertointeger(n: f64) -> c_int {
    let mut n = n;
    if n == 0.0 {
        return 0;
    }
    if isnan(n) {
        return 0;
    }
    n = if n < 0.0 {
        unsafe { -floor(-n) }
    } else {
        unsafe { floor(n) }
    };
    if n < INT_MIN as f64 {
        return INT_MIN;
    }
    if n > INT_MAX as f64 {
        return INT_MAX;
    }
    n as c_int
}

