import re, itertools, subprocess, sys
txt = open('Cargo.toml').read()
m = re.search(r'^\[features\]\s*$(.*?)(^\[|\Z)', txt, re.M|re.S)
feats = []
if m:
    for line in m.group(1).splitlines():
        line = line.split('#')[0].strip()
        if '=' in line:
            feats.append(line.split('=')[0].strip())
print("declared features:", feats if feats else "(none)")
combos = []
for r in range(len(feats)+1):
    for c in itertools.combinations(feats, r):
        combos.append(",".join(c))
if not combos:
    combos = [""]
print("combinations to check:", len(combos))
fail = 0
for c in combos:
    cmd = ["cargo","check","--release","--all-targets","--no-default-features"]
    if c:
        cmd += ["--features", c]
    p = subprocess.run(cmd, capture_output=True, text=True)
    label = c if c else "<no features>"
    errs = [l for l in p.stderr.splitlines() if l.startswith("error")]
    print(f"  {label}: {'OK' if p.returncode==0 else 'FAIL'}")
    if p.returncode != 0:
        fail = 1
        print("\n".join(p.stderr.splitlines()[-30:]))
# also the default configuration
p = subprocess.run(["cargo","check","--release","--all-targets"], capture_output=True, text=True)
