    25	
    26	#include <stdio.h>
    27	#include <stdlib.h>
    28	#include "task_manager.h"
    29	#include "logger.h"
    30	#include <string.h>
    31	
    32	int driver(const char *tasks) {
    33	    int res = initialize_logger();
    34	    if (res != 0) {
    35	        return EXIT_FAILURE;
    36	    }
    37	
    38	    TaskManager *manager = create_task_manager();
    39	    if (!manager) {
    40	        return EXIT_FAILURE;
    41	    }
    42	
    43	    const char *start = tasks;
    44	    int priority = 1;
    45	    while (*start != '\0') {
    46	        const char *end = strchr(start, '\n');
    47	        if (end == NULL) {
    48	            end = start + strlen(start);
    49	        }
    50	
    51	        // Extract the current task
    52	        size_t length = end - start;
    53	        char *task = (char *)malloc(length + 1);
    54	        if (!task) {
    55	            fprintf(stderr, "Error: Failed to allocate memory for task.\n");
    56	            destroy_task_manager(manager);
    57	            finalize_logger();
    58	            return EXIT_FAILURE;
    59	        }
    60	        strncpy(task, start, length);
    61	        task[length] = '\0';
    62	
    63	        add_task(manager, task, priority++);
    64	        free(task);
    65	        start = (*end == '\n') ? end + 1 : end;
    66	    }    
    67	
    68	    print_tasks(manager);
    69	
    70	    destroy_task_manager(manager);
    71	    finalize_logger();
    72	
    73	    return 0;
    74	}
