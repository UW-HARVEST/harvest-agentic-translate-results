//! temporary diagnostic: print the exact malloc/free sequence
mod common;

use common::{arm_malloc_failure, disarm_malloc_failure, trace_events, trace_start, trace_stop, Api};
use std::ffi::{c_char, c_int, CString};

extern "C" {
    fn setenv(n: *const c_char, v: *const c_char, o: c_int) -> c_int;
}

#[test]
fn diag() {
    unsafe {
        let v = CString::new("/dev/null").unwrap();
        setenv(c"LOG_FILE".as_ptr(), v.as_ptr(), 1);
        let v = CString::new("10").unwrap();
        setenv(c"MAX_TASKS".as_ptr(), v.as_ptr(), 1);
    }
    let p = common::pair();
    let f: &dyn Fn(&Api) = &|api: &Api| unsafe {
        (api.initialize_logger)();
        let before = arm_malloc_failure(2600);
        let m = (api.create_task_manager)();
        let fired = disarm_malloc_failure(before);
        assert!(fired && m.is_null());
        (api.finalize_logger)();
    };
    for api in [&p.c, &p.rust] {
        f(api);
        trace_start();
        f(api);
        let st = trace_stop();
        eprintln!("--- {} {:?} ---", api.name, st);
        for (k, v) in trace_events() {
            match k {
                0 => eprintln!("  malloc({v})"),
                1 => eprintln!("  free(0x{v:x})"),
                _ => eprintln!("  malloc({v}) -> NULL (forced)"),
            }
        }
    }
}
EOF
