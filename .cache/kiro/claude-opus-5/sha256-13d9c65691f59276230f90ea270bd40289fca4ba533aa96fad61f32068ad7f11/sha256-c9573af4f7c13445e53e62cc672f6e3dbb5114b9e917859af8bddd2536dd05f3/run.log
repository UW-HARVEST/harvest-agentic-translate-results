[0m[49m[38;5;10m+    407[0m:[38;5;10m[49m     if c.ret != r.ret {
[0m[49m[38;5;10m+    408[0m:[38;5;10m[49m         msg += &format!("  return: C={} Rust={}\n", c.ret, r.ret);
[0m[49m[38;5;10m+    409[0m:[38;5;10m[49m     }
