[0m[49m[38;5;10m+    420[0m:[38;5;10m[49m                 show(a),
[0m[49m[38;5;10m+    421[0m:[38;5;10m[49m                 show(b)
[0m[49m[38;5;10m+    422[0m:[38;5;10m[49m             );
[0m[49m[38;5;10m+    423[0m:[38;5;10m[49m             if let Some(i) = a.iter().zip(b.iter()).position(|(x, y)| x != y) {
