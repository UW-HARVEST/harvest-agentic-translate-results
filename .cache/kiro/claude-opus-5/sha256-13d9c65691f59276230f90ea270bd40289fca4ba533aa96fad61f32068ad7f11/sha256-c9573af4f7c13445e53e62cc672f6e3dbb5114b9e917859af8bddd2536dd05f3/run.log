    26	//! Translation of `c_src/src/logger.c`.
    27	
    28	use core::ffi::{c_char, c_int};
    29	use core::ptr;
    30	
    31	use crate::cbind::{fclose, fopen, fprintf, getenv, FILE};
    32	
    33	/// `static FILE *log_file = NULL;`
    34	static mut LOG_FILE: *mut FILE = ptr::null_mut();
    35	
    36	/// `int initialize_logger();`
    37	///
    38	/// Opens `$LOG_FILE` (or `default.log`) for appending. Note that, exactly like
    39	/// the C original, a second call simply overwrites the stored handle without
    40	/// closing the previous one.
    41	#[unsafe(no_mangle)]
    42	pub unsafe extern "C" fn initialize_logger() -> c_int {
    43	    let log_file_env: *const c_char = getenv(c"LOG_FILE".as_ptr());
    44	    let log_file_path: *const c_char = if !log_file_env.is_null() {
    45	        log_file_env
    46	    } else {
    47	        c"default.log".as_ptr()
    48	    };
    49	
    50	    LOG_FILE = fopen(log_file_path, c"a".as_ptr());
    51	    if LOG_FILE.is_null() {
    52	        fprintf(
    53	            crate::cbind::stderr,
    54	            c"Failed to open log file: %s\n".as_ptr(),
    55	            log_file_path,
    56	        );
    57	        return -1;
    58	    }
    59	
    60	    log_info(c"Logger initialized.".as_ptr());
    61	    0
    62	}
    63	
    64	/// `void log_info(const char *message);`
    65	#[unsafe(no_mangle)]
    66	pub unsafe extern "C" fn log_info(message: *const c_char) {
    67	    if !LOG_FILE.is_null() {
    68	        fprintf(LOG_FILE, c"[INFO] %s\n".as_ptr(), message);
    69	    }
    70	}
    71	
    72	/// `void log_warning(const char *message);`
    73	#[unsafe(no_mangle)]
    74	pub unsafe extern "C" fn log_warning(message: *const c_char) {
    75	    if !LOG_FILE.is_null() {
    76	        fprintf(LOG_FILE, c"[WARNING] %s\n".as_ptr(), message);
    77	    }
    78	}
    79	
    80	/// `void log_error(const char *message);`
    81	#[unsafe(no_mangle)]
    82	pub unsafe extern "C" fn log_error(message: *const c_char) {
    83	    if !LOG_FILE.is_null() {
    84	        fprintf(LOG_FILE, c"[ERROR] %s\n".as_ptr(), message);
    85	    }
    86	}
    87	
    88	/// `void finalize_logger();`
    89	///
    90	/// Mirrors the C original: the handle is closed but *not* reset to `NULL`, so
    91	/// subsequent logging calls still see a non-NULL (now dangling) handle.
    92	#[unsafe(no_mangle)]
    93	pub unsafe extern "C" fn finalize_logger() {
    94	    if !LOG_FILE.is_null() {
    95	        log_info(c"Logger finalized.".as_ptr());
    96	        fclose(LOG_FILE);
    97	    }
    98	}
