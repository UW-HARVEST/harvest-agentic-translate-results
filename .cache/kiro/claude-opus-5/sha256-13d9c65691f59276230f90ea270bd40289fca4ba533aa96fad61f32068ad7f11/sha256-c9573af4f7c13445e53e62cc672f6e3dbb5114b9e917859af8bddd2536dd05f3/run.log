    25	
    26	//! Minimal bindings to the platform C library.
    27	//!
    28	//! The original library relies on `stdio` streams, `malloc`/`free` and the
    29	//! `str*` family. Re-using the very same C entry points (instead of Rust
    30	//! equivalents) keeps the observable behaviour - buffering, interleaving with a
    31	//! caller's own stdio writes, allocator identity, `atoi`/`getenv` semantics -
    32	//! bit-for-bit identical to the C implementation.
    33	
    34	#![allow(non_camel_case_types)]
    35	
    36	use core::ffi::{c_char, c_int, c_void};
    37	
    38	/// Opaque `FILE`.
    39	#[repr(C)]
    40	pub struct FILE {
    41	    _private: [u8; 0],
    42	}
    43	
    44	pub const EXIT_FAILURE: c_int = 1;
    45	
    46	extern "C" {
    47	    pub static mut stderr: *mut FILE;
    48	
    49	    pub fn fopen(path: *const c_char, mode: *const c_char) -> *mut FILE;
    50	    pub fn fclose(stream: *mut FILE) -> c_int;
    51	    pub fn fprintf(stream: *mut FILE, format: *const c_char, ...) -> c_int;
    52	    pub fn printf(format: *const c_char, ...) -> c_int;
    53	
    54	    pub fn malloc(size: usize) -> *mut c_void;
    55	    pub fn free(ptr: *mut c_void);
    56	
    57	    pub fn getenv(name: *const c_char) -> *mut c_char;
    58	    pub fn atoi(s: *const c_char) -> c_int;
    59	
    60	    pub fn strlen(s: *const c_char) -> usize;
    61	    pub fn strchr(s: *const c_char, c: c_int) -> *mut c_char;
    62	    pub fn strncpy(dst: *mut c_char, src: *const c_char, n: usize) -> *mut c_char;
    63	}
=================== src/cstdio.rs ===================
     1	//! Access to the C runtime's `stdout` / `stderr` streams.
     2	//!
     3	//! `printf`/`fprintf(stderr, ...)` in the original library append to glibc's
     4	//! own stdio buffers, which are shared with whatever C code calls into this
     5	//! library and are flushed at process exit.  Writing through Rust's
     6	//! `std::io::stdout()` would use a *separate* buffer and therefore interleave
     7	//! differently with a caller's `printf`, so the real streams are used instead.
     8	
     9	use std::ffi::c_void;
    10	
    11	extern "C" {
    12	    static mut stdout: *mut c_void;
    13	    static mut stderr: *mut c_void;
    14	    fn fwrite(ptr: *const u8, size: usize, nitems: usize, stream: *mut c_void) -> usize;
    15	}
    16	
    17	/// One `printf("%s", bytes)`-equivalent append to the `stdout` buffer.
    18	pub fn print_stdout(bytes: &[u8]) {
    19	    unsafe {
    20	        let stream = std::ptr::addr_of!(stdout).read();
    21	        fwrite(bytes.as_ptr(), 1, bytes.len(), stream);
    22	    }
    23	}
    24	
    25	/// One `fprintf(stderr, "%s", bytes)`-equivalent write (stderr is unbuffered).
    26	pub fn print_stderr(bytes: &[u8]) {
    27	    unsafe {
    28	        let stream = std::ptr::addr_of!(stderr).read();
    29	        fwrite(bytes.as_ptr(), 1, bytes.len(), stream);
    30	    }
    31	}
=================== src/cutil.rs ===================
     1	//! Small helpers that reproduce the exact semantics of the C standard library
     2	//! functions used by the original sources (glibc / x86-64 Linux).
     3	
     4	use std::ffi::{c_char, c_int, OsString};
     5	
     6	/// Bytes of a NUL-terminated C string.
     7	///
     8	/// `printf`/`fprintf` with `%s` in glibc prints the literal text `(null)` when
     9	/// handed a NULL pointer, so mirror that instead of crashing.
    10	///
    11	/// # Safety
    12	/// `s` must be NULL or a valid pointer to a NUL-terminated string.
    13	pub unsafe fn c_str_bytes(s: *const c_char) -> Vec<u8> {
    14	    if s.is_null() {
    15	        return b"(null)".to_vec();
    16	    }
    17	    let mut out = Vec::new();
    18	    let mut p = s as *const u8;
    19	    while *p != 0 {
    20	        out.push(*p);
    21	        p = p.add(1);
    22	    }
    23	    out
    24	}
    25	
    26	/// Raw bytes of an environment variable, as `getenv()` would see them.
    27	pub fn getenv_bytes(name: &str) -> Option<Vec<u8>> {
    28	    #[cfg(unix)]
    29	    {
    30	        use std::os::unix::ffi::OsStringExt;
    31	        std::env::var_os(name).map(|v: OsString| v.into_vec())
    32	    }
    33	    #[cfg(not(unix))]
    34	    {
    35	        std::env::var_os(name).map(|v: OsString| v.to_string_lossy().into_owned().into_bytes())
    36	    }
    37	}
    38	
    39	/// glibc `atoi`, which is defined as `(int)strtol(s, NULL, 10)`.
    40	///
    41	/// That means: leading whitespace is skipped, an optional sign is accepted,
    42	/// digits are accumulated, out-of-range values saturate to `LONG_MAX` /
    43	/// `LONG_MIN` and the resulting `long` is then *truncated* to `int`
    44	/// (so e.g. "99999999999999999999" yields -1 and "4294967296" yields 0).
    45	pub fn c_atoi(bytes: &[u8]) -> c_int {
    46	    let mut i = 0usize;
    47	
    48	    // isspace(): ' ', '\t', '\n', '\v', '\f', '\r'
    49	    while i < bytes.len() && matches!(bytes[i], b' ' | b'\t' | b'\n' | 0x0b | 0x0c | b'\r') {
    50	        i += 1;
    51	    }
    52	
    53	    let mut negative = false;
    54	    if i < bytes.len() && (bytes[i] == b'+' || bytes[i] == b'-') {
    55	        negative = bytes[i] == b'-';
    56	        i += 1;
    57	    }
    58	
    59	    let mut magnitude: u64 = 0;
    60	    let mut overflow = false;
    61	    while i < bytes.len() && bytes[i].is_ascii_digit() {
    62	        let digit = (bytes[i] - b'0') as u64;
    63	        if !overflow {
    64	            match magnitude.checked_mul(10).and_then(|v| v.checked_add(digit)) {
    65	                Some(v) => magnitude = v,
    66	                None => overflow = true,
    67	            }
    68	        }
    69	        i += 1;
    70	    }
    71	
    72	    // Saturate into `long` exactly like strtol does.
    73	    let as_long: i64 = if negative {
    74	        if overflow || magnitude > (i64::MAX as u64) + 1 {
    75	            i64::MIN
    76	        } else if magnitude == (i64::MAX as u64) + 1 {
    77	            i64::MIN
    78	        } else {
    79	            -(magnitude as i64)
    80	        }
    81	    } else if overflow || magnitude > i64::MAX as u64 {
    82	        i64::MAX
    83	    } else {
    84	        magnitude as i64
    85	    };
    86	
    87	    // Implicit long -> int conversion performed by atoi().
    88	    as_long as c_int
    89	}
    90	
    91	/// `strncpy(dst, src, n)` followed by nothing else: copies at most `n` bytes,
    92	/// stopping after a NUL, and zero-pads the remainder of the `n` bytes.
    93	///
    94	/// # Safety
    95	/// `dst` must be writable for `n` bytes; `src` must be a valid NUL-terminated
    96	/// string (a NULL `src` faults, exactly as the C original does).
    97	pub unsafe fn strncpy(dst: *mut u8, src: *const c_char, n: usize) {
    98	    let src = src as *const u8;
    99	    let mut i = 0usize;
   100	    while i < n {
   101	        let byte = *src.add(i);
   102	        *dst.add(i) = byte;
   103	        if byte == 0 {
   104	            break;
   105	        }
   106	        i += 1;
   107	    }
   108	    // strncpy pads the rest of the n bytes with NUL.
   109	    while i < n {
   110	        *dst.add(i) = 0;
   111	        i += 1;
   112	    }
   113	}
