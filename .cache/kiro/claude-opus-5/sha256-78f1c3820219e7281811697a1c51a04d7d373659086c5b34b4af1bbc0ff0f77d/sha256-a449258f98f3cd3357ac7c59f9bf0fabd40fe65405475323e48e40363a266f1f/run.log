[0m[49m[38;5;10m+     24[0m:[38;5;10m[49m programs terminated differently:
[0m[49m[38;5;10m+     25[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     26[0m:[38;5;10m[49m ```
[0m[49m[38;5;10m+     27[0m:[38;5;10m[49m $ set -o pipefail; c_src/build/driver -2000000            | head -n 1  ; echo $?
[0m[49m[38;5;10m+     28[0m:[38;5;10m[49m -2000000
[0m[49m[38;5;10m+     29[0m:[38;5;10m[49m 141          # killed by SIGPIPE (128 + 13)
[0m[49m[38;5;10m+     30[0m:[38;5;10m[49m $ set -o pipefail; translation/target/release/driver -2000000 | head -n 1 ; echo $?
[0m[49m[38;5;10m+     31[0m:[38;5;10m[49m -2000000
[0m[49m[38;5;10m+     32[0m:[38;5;10m[49m 0            # exited normally
[0m[49m[38;5;10m+     33[0m:[38;5;10m[49m ```
