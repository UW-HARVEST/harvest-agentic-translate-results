import os, random, subprocess, sys
C, R = sys.argv[1], sys.argv[2]
random.seed(7)

def prefix(bin, arg, limit=4096):
    p = subprocess.Popen([bin, arg], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    buf = b""
    while len(buf) < limit:
        c = p.stdout.read(limit - len(buf))
        if not c: break
        buf += c
    p.stdout.close()
    err = p.stderr.read(); p.stderr.close()
    return buf[:limit], err, p.wait()

cands = [str(2**31 - 1), str(2**31), str(2**31 + 5), str(-2**31), str(-2**31 - 1),
         "2147483640", "2147483000", "-2147483000", "1000000000", "-2000000000"]
for _ in range(120):
    v = random.choice([random.randint(2**31-60, 2**31+60),
                       -random.randint(2**31-60, 2**31+60),
                       random.randint(2**63-60, 2**63+60),
                       random.randint(10**9, 2**31-1)])
    cands.append(str(v))

diffs = 0
for a in cands:
    co, ro = prefix(C, a), prefix(R, a)
    if co != ro:
        diffs += 1
        print("DIFF", a, "\n  C ", co[0][:60], co[2], "\n  R ", ro[0][:60], ro[2])
print(f"prefix-checked {len(cands)} wrap-region cases, {diffs} mismatches")
