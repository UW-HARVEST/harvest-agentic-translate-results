import random, subprocess, sys
C, R = sys.argv[1], sys.argv[2]
random.seed(20260902)

def outcome(bin, args):
    p = subprocess.run([bin]+args, capture_output=True)
    return p.stdout, p.stderr, p.returncode

def c_trunc_mod(a, b):
    return abs(a) % b * (1 if a >= 0 else -1)

def iterations(iv):
    """Loop length with C's truncating % and 32-bit wraparound, or None if huge."""
    if iv >= 0 and c_trunc_mod(iv, 10) == 9:
        return 1
    if iv < 0:
        return 9 - iv + 1
    return None  # climbs to INT_MAX, wraps to INT_MIN: ~4e9 lines

def narrow(v):
    iv = v & 0xFFFFFFFF
    return iv - 2**32 if iv >= 2**31 else iv

def saturate(v):
    return max(-2**63, min(2**63 - 1, v))

alphabet = list(b"0123456789+- \t\n.eExX_abz") + [0x0b, 0x0c, 0xff]
cases, skipped = [], 0
for _ in range(4000):
    s = bytes(random.choice(alphabet) for _ in range(random.randint(0, 6)))
    cases.append([s])
for _ in range(3000):
    v = random.choice([
        random.randint(-10**4, 10**4),
        random.randint(2**31-40, 2**31+40) * random.choice([1, -1]),
        random.randint(2**63-40, 2**63+40) * random.choice([1, -1]),
        random.randint(2**32-40, 2**32+40) * random.choice([1, -1]),
        random.randint(-10**25, 10**25),
    ])
    n = iterations(narrow(saturate(v)))
    if n is None or n > 2_000_000:
        skipped += 1
        continue
    cases.append([str(v).encode()])
for _ in range(300):
    cases.append([str(random.randint(0, 9)).encode()
                  for _ in range(random.choice([0, 1, 2, 3, 5]))])

diffs = 0
for args in cases:
    a = [x.decode('latin1') for x in args]
    co, ro = outcome(C, a), outcome(R, a)
    if co != ro:
        diffs += 1
        print("DIFF", a, "\n  C ", co[0][:80], co[1][:80], co[2],
                          "\n  R ", ro[0][:80], ro[1][:80], ro[2])
        if diffs > 15: break
print(f"ran {len(cases)} cases ({skipped} skipped as multi-billion-iteration), {diffs} mismatches")
