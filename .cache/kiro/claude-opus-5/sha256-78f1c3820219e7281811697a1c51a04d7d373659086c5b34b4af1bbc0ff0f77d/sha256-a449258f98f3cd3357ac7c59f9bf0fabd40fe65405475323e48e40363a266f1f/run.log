import random, subprocess, sys
C, R = sys.argv[1], sys.argv[2]

def outcome(bin, args):
    p = subprocess.run([bin]+args, capture_output=True)
    return p.stdout, p.stderr, p.returncode

alphabet = list(b"0123456789+- \t\n.eExX_abz\xff\x00"[:-1]) + [0x0b, 0x0c]
cases = []
# random short byte-strings
for _ in range(4000):
    n = random.randint(0, 6)
    s = bytes(random.choice(alphabet) for _ in range(n))
    if b'\x00' in s: continue
    cases.append([s])
# random integers near interesting boundaries, kept small enough to terminate fast
for _ in range(1500):
    v = random.choice([
        random.randint(-10**4, 10**4),
        random.randint(2**31-40, 2**31+40) * random.choice([1,-1]),
        random.randint(2**63-40, 2**63+40) * random.choice([1,-1]),
        random.randint(2**32-40, 2**32+40) * random.choice([1,-1]),
    ])
    s = str(v).encode()
    # skip values whose loop would run for billions of iterations
    iv = v & 0xFFFFFFFF
    if iv >= 2**31: iv -= 2**32
    if iv % 10 != 9 and (9 - iv) > 2_000_000: continue
    cases.append([s])
