    except Exception as e:
        print("RUNERR", a, e); diffs += 1; continue
    if co != ro:
        diffs += 1
        print("DIFF", a)
        print("  C ", co[0][:80], co[1][:80], co[2])
        print("  R ", ro[0][:80], ro[1][:80], ro[2])
        if diffs > 15: break
print(f"checked {len(cases)} cases, {diffs} mismatches")
