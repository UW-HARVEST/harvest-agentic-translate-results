=== lib.rs ===
     1	// Rust translation of c_src/src/driver.c
     2	//
     3	// Original C library: Copyright 2025 MIT Lincoln Laboratory (MIT-style license,
     4	// see c_src/src/driver.c for the full notice).
     5	//
     6	// The translation preserves the exact public ABI of the C shared library:
     7	//   printLine, printIntLine, bad, good, driver
     8	//
     9	// Output is produced through the platform C library's `printf` so that the
    10	// bytes written, and the stdout buffering/flush semantics, are identical to
    11	// the original C library (including interleaving with any C code in the same
    12	// process that also writes to stdout).
    13	
    14	#![allow(non_snake_case)]
    15	
    16	use std::ffi::{c_char, c_int};
    17	
    18	unsafe extern "C" {
    19	    #[link_name = "printf"]
    20	    unsafe fn c_printf(fmt: *const c_char, ...) -> c_int;
    21	}
    22	
    23	/// void printLine (const char * line)
    24	///
    25	/// Prints `line` followed by a newline; a NULL pointer prints nothing.
    26	#[unsafe(no_mangle)]
    27	pub unsafe extern "C" fn printLine(line: *const c_char) {
    28	    if !line.is_null() {
    29	        unsafe {
    30	            c_printf(c"%s\n".as_ptr(), line);
    31	        }
    32	    }
    33	}
    34	
    35	/// void printIntLine (int intNumber)
    36	#[unsafe(no_mangle)]
    37	pub unsafe extern "C" fn printIntLine(int_number: c_int) {
    38	    unsafe {
    39	        c_printf(c"%d\n".as_ptr(), int_number);
    40	    }
    41	}
    42	
    43	/// void bad()
    44	///
    45	/// Faithful translation, bug included: the original computes `intOne + intTwo`
    46	/// but discards the result instead of assigning it to `intSum`, so both lines
    47	/// print 0. This is intentional and must NOT be "fixed".
    48	#[unsafe(no_mangle)]
    49	pub unsafe extern "C" fn bad() {
    50	    let int_one: c_int = 1;
    51	    let int_two: c_int = 1;
    52	    let int_sum: c_int = 0;
    53	    unsafe {
    54	        printIntLine(int_sum);
    55	    }
    56	    // Statement with no effect, exactly as in the C source.
    57	    let _ = int_one.wrapping_add(int_two);
    58	    unsafe {
    59	        printIntLine(int_sum);
    60	    }
    61	}
    62	
    63	/// void good()
    64	#[unsafe(no_mangle)]
    65	pub unsafe extern "C" fn good() {
    66	    let int_one: c_int = 1;
    67	    let int_two: c_int = 1;
    68	    let mut int_sum: c_int = 0;
    69	    unsafe {
    70	        printIntLine(int_sum);
    71	    }
    72	    int_sum = int_one.wrapping_add(int_two);
    73	    unsafe {
    74	        printIntLine(int_sum);
    75	    }
    76	}
    77	
    78	/// void driver(void)
    79	#[unsafe(no_mangle)]
    80	pub unsafe extern "C" fn driver() {
    81	    unsafe {
    82	        printLine(c"Calling good()...".as_ptr());
    83	        good();
    84	        printLine(c"Finished good()".as_ptr());
    85	        printLine(c"Calling bad()...".as_ptr());
    86	        bad();
    87	        printLine(c"Finished bad()".as_ptr());
    88	    }
    89	}
