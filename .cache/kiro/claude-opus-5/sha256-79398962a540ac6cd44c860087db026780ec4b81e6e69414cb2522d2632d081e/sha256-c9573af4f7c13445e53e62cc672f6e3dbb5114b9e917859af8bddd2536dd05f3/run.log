[0m[49m[38;5;10m+     498[0m:[38;5;10m[49m         let mut p = Pair::new(&s, 16, 8, KeyRepr::Inline(8), 8..16);
[0m[49m[38;5;10m+     499[0m:[38;5;10m[49m         let mut keys = Keys8::new(&mut rng, 40);
