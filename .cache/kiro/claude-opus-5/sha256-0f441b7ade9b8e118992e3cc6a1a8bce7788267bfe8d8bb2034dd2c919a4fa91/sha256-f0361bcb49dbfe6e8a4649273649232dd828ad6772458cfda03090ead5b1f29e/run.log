    10	// This crate reproduces that ABI byte-for-byte compatibly, including the
    11	// 1 MiB zero-initialised `array` object living in .bss.
    12	//
    13	// Fidelity notes:
    14	//   * `srand`/`rand` are taken from the host libc, exactly as the C code does,
    15	//     so the pseudo-random fill is identical on any platform the C library
    16	//     would run on.
    17	//   * Output is emitted through libc `printf` with the same `"%d\n"` format so
    18	//     it shares the C stdio buffer and produces identical bytes.
    19	//   * All integer arithmetic uses wrapping semantics, matching what a C
    20	//     compiler emits for `int` on two's-complement hardware (the C code relies
    21	//     on signed overflow and on `>>` being an arithmetic shift).
    22	
    23	#![allow(non_upper_case_globals)]
