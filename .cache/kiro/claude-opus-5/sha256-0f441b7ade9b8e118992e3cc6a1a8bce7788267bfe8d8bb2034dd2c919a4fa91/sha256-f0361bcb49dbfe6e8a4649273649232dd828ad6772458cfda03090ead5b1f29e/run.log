    25	use std::ffi::{c_char, c_int, c_uint};
    26	use std::ptr::addr_of_mut;
    27	
    28	/// `#define ARRAY_SIZE (256 * 1024)` -- 1MB assuming sizeof(int) = 4
    29	const ARRAY_SIZE: usize = 256 * 1024;
    30	
    31	/// `#define ITERATIONS 2000`
    32	const ITERATIONS: c_int = 2000;
    33	
    34	/// Number of times the inner arithmetic kernel is applied per element per call
    35	/// to `perform_expensive_operations`.
    36	const INNER: u32 = 100;
    37	
    38	extern "C" {
    39	    fn srand(seed: c_uint);
    40	    fn rand() -> c_int;
    41	    fn printf(fmt: *const c_char, ...) -> c_int;
