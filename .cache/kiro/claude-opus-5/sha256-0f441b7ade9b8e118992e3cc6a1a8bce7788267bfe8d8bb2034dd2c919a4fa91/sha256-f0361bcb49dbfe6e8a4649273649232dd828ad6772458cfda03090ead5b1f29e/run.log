    43	
    44	/// Wrapper that reproduces the 32-byte alignment gcc gives the C array.
    45	#[repr(C, align(32))]
    46	pub struct Array([c_int; ARRAY_SIZE]);
    47	
    48	/// `int array[ARRAY_SIZE];` -- global, zero initialised, exported from the
    49	/// shared object as a 0x100000 byte .bss object.
    50	#[used]
    51	#[unsafe(no_mangle)]
    52	pub static mut array: Array = Array([0; ARRAY_SIZE]);
    53	
    54	#[inline(always)]
    55	fn array_mut() -> &'static mut [c_int; ARRAY_SIZE] {
    56	    // The C code is equally non-thread-safe about this global.
    57	    unsafe { &mut (*addr_of_mut!(array)).0 }
    58	}
    59	
    60	/// One application of the C inner-loop body:
    61	///
    62	/// ```c
    63	/// x = x * 3 + 7;
    64	/// x = x ^ (x >> 3);
    65	/// x = x - (x << 1);
    66	/// x = x / 2 + x % 7;
    67	/// ```
    68	///
    69	/// Signed overflow wraps and `>>` is arithmetic, matching gcc/clang on all
    70	/// supported targets. `x / 2` truncates toward zero and `x % 7` keeps the sign
    71	/// of the dividend, exactly as C requires.
    72	#[inline(always)]
    73	pub(crate) fn kernel_step(x: c_int) -> c_int {
    74	    let mut x = x;
    75	    x = x.wrapping_mul(3).wrapping_add(7);
    76	    x ^= x >> 3;
    77	    x = x.wrapping_sub(x.wrapping_shl(1));
    78	    x = x.wrapping_div(2).wrapping_add(x.wrapping_rem(7));
    79	    x
    80	}
    81	
    82	/// `f^n(x)` computed the naive way.
    83	#[inline(always)]
    84	pub(crate) fn kernel_iterate(mut x: c_int, n: u32) -> c_int {
    85	    for _ in 0..n {
    86	        x = kernel_step(x);
    87	    }
    88	    x
    89	}
