     1	//! Exact accelerator for `f^n` where `f` is the C inner-loop body
     2	//! (`crate::kernel_step`).
     3	//!
     4	//! `long_exec` calls `perform_expensive_operations()` 2000 times, and that
     5	//! function applies `f` 100 times to every element independently.  So the whole
     6	//! nested loop is nothing but `f^200000` applied element-wise.
     7	//!
     8	//! `f` maps `i32 -> i32`, i.e. it is a self-map of a finite set, so every orbit
     9	//! is eventually periodic: `v, f(v), ...` runs down a "tail" of length `mu` and
    10	//! then cycles with period `lambda`.  Once the cycle is known, `f^n(v)` for any
    11	//! `n >= mu` is a single modular index into the cycle.  Everything here is exact
    12	//! function-iteration algebra -- no approximation -- so the resulting array (and
    13	//! therefore the printed XOR) is bit-identical to running the naive nested loop.
    14	//!
    15	//! Orbits started from different array elements coalesce, so a memo of
    16	//! "how this value relates to its cycle" makes the whole pass cost roughly the
    17	//! number of *distinct* values visited instead of `262144 * 200000` steps.
    18	//!
    19	//! Every escape hatch in here falls back to plain iteration, which is why the
    20	//! result cannot depend on the heuristics: they only decide how much work is
    21	//! saved, never what is computed.
    22	
    23	use crate::{kernel_iterate, kernel_step};
    24	use std::collections::HashMap;
    25	use std::ffi::c_int;
    26	use std::hash::{BuildHasherDefault, Hasher};
    27	
    28	/// Size of the membership filter in bits (2^25 bits = 4 MiB).
    29	const FILTER_BITS: u32 = 25;
    30	const FILTER_WORDS: usize = 1usize << (FILTER_BITS - 5);
    31	
    32	/// Upper bound on memoised tail entries, to keep peak memory bounded.
    33	const MEMO_CAP: usize = 6 << 20;
    34	
    35	/// Only every `STRIDE`-th value of a walked tail is memoised; a later walk then
    36	/// overshoots the first already-known value by at most `STRIDE` steps.
    37	const STRIDE: usize = 16;
    38	
    39	/// Refuse to materialise absurdly long cycles (keeps worst-case memory bounded).
    40	const MAX_CYCLE: u64 = 8 << 20;
    41	
    42	/// Cycle discovery costs a few times the orbit length, so it only pays off when
    43	/// `n` is large.  Below this we just iterate.
    44	const LEARN_MIN_N: u32 = 8192;
    45	
    46	/// Hard cap on cycle-discovery attempts, so a pathological input can never turn
    47	/// this into more work than the naive loop.
    48	const MAX_LEARN_ATTEMPTS: u32 = 64;
    49	
    50	/// Cheap multiplicative hasher; keys are already well-mixed integers.
    51	#[derive(Default)]
    52	struct IntHasher(u64);
    53	
    54	impl Hasher for IntHasher {
    55	    #[inline]
    56	    fn write(&mut self, bytes: &[u8]) {
    57	        for &b in bytes {
    58	            self.0 = (self.0 ^ b as u64).wrapping_mul(0x100_0000_01b3);
    59	        }
    60	    }
    61	    #[inline]
    62	    fn write_i32(&mut self, i: i32) {
    63	        self.0 = (i as u32 as u64).wrapping_mul(0x9E37_79B9_7F4A_7C15);
    64	    }
    65	    #[inline]
    66	    fn finish(&self) -> u64 {
    67	        self.0 ^ (self.0 >> 29)
    68	    }
    69	}
    70	
    71	type IntMap<K, V> = HashMap<K, V, BuildHasherDefault<IntHasher>>;
    72	
    73	/// For a value `y`: for every `t >= dist`, `f^t(y) == cycles[cycle][(off + t) % len]`.
    74	#[derive(Clone, Copy)]
    75	struct Entry {
    76	    cycle: u32,
    77	    off: u32,
    78	    dist: u32,
    79	}
    80	
    81	struct Solver {
    82	    cycles: Vec<Vec<c_int>>,
    83	    memo: IntMap<c_int, Entry>,
    84	    filter: Vec<u32>,
    85	    path: Vec<c_int>,
    86	    learn_attempts: u32,
    87	}
    88	
    89	#[inline(always)]
    90	fn filter_index(x: c_int) -> usize {
    91	    let h = (x as u32 as u64).wrapping_mul(0x9E37_79B9_7F4A_7C15);
    92	    ((h >> (64 - FILTER_BITS)) as usize) & ((1usize << FILTER_BITS) - 1)
    93	}
    94	
    95	#[inline]
    96	fn clamp_u32(v: u64) -> u32 {
    97	    if v > u32::MAX as u64 {
    98	        u32::MAX
    99	    } else {
   100	        v as u32
   101	    }
   102	}
   103	
   104	impl Solver {
   105	    fn new() -> Self {
   106	        Solver {
   107	            cycles: Vec::new(),
   108	            memo: IntMap::default(),
   109	            filter: vec![0u32; FILTER_WORDS],
   110	            path: Vec::new(),
   111	            learn_attempts: 0,
   112	        }
   113	    }
   114	
   115	    #[inline(always)]
   116	    fn maybe_known(&self, x: c_int) -> bool {
   117	        let i = filter_index(x);
   118	        (self.filter[i >> 5] >> (i & 31)) & 1 != 0
   119	    }
   120	
   121	    #[inline(always)]
   122	    fn lookup(&self, x: c_int) -> Option<Entry> {
   123	        if self.maybe_known(x) {
   124	            self.memo.get(&x).copied()
   125	        } else {
   126	            None
   127	        }
   128	    }
   129	
   130	    /// `force` bypasses the size cap; used for cycle members, which must stay
   131	    /// resident or later walks cannot short-circuit at all.
   132	    fn remember(&mut self, x: c_int, e: Entry, force: bool) {
   133	        if !force && self.memo.len() >= MEMO_CAP {
   134	            return;
   135	        }
   136	        self.memo.entry(x).or_insert(e);
   137	        let i = filter_index(x);
   138	        self.filter[i >> 5] |= 1u32 << (i & 31);
   139	    }
   140	
   141	    /// Brent's cycle finding: returns `(mu, lambda)` for the orbit of `v`.
   142	    fn brent(v: c_int) -> (u64, u64) {
   143	        let mut power: u64 = 1;
   144	        let mut lam: u64 = 1;
   145	        let mut tortoise = v;
   146	        let mut hare = kernel_step(v);
   147	        while tortoise != hare {
   148	            if power == lam {
   149	                tortoise = hare;
   150	                power *= 2;
   151	                lam = 0;
   152	            }
   153	            hare = kernel_step(hare);
   154	            lam += 1;
   155	        }
   156	        let mut tortoise = v;
   157	        let mut hare = v;
   158	        for _ in 0..lam {
   159	            hare = kernel_step(hare);
   160	        }
   161	        let mut mu: u64 = 0;
   162	        while tortoise != hare {
   163	            tortoise = kernel_step(tortoise);
   164	            hare = kernel_step(hare);
   165	            mu += 1;
   166	        }
   167	        (mu, lam)
   168	    }
   169	
   170	    /// Discover the cycle reached from `v` and memoise it plus a subsample of
   171	    /// the tail leading into it.  Re-uses an already known cycle if this orbit
   172	    /// funnels into one.
   173	    fn learn(&mut self, v: c_int) {
   174	        self.learn_attempts += 1;
   175	        let (mu, lam) = Self::brent(v);
   176	
   177	        let mut entry_val = v;
   178	        for _ in 0..mu {
   179	            entry_val = kernel_step(entry_val);
   180	        }
   181	
   182	        // Position of `entry_val` on its cycle, creating the cycle if new.
   183	        // `entry_val` is `f^mu(v)`, so it genuinely lies on a cycle; if a memo
   184	        // entry exists at all then its `off` is that cycle position (both sides
   185	        // of the memo identity are periodic in `t`), so the cycle can be reused
   186	        // rather than duplicated.
   187	        let (ci, entry_pos, len) = match self.lookup(entry_val) {
   188	            Some(e) => {
   189	                let len = self.cycles[e.cycle as usize].len() as u64;
   190	                (e.cycle, e.off as u64, len)
   191	            }
   192	            None => {
   193	                if lam > MAX_CYCLE {
   194	                    return;
   195	                }
   196	                let mut vals = Vec::with_capacity(lam as usize);
   197	                let mut y = entry_val;
   198	                for _ in 0..lam {
   199	                    vals.push(y);
   200	                    y = kernel_step(y);
   201	                }
   202	                let ci = self.cycles.len() as u32;
   203	                self.cycles.push(vals);
   204	                let len = self.cycles[ci as usize].len();
   205	                for pos in 0..len {
   206	                    let val = self.cycles[ci as usize][pos];
   207	                    self.remember(
   208	                        val,
   209	                        Entry {
   210	                            cycle: ci,
   211	                            off: pos as u32,
   212	                            dist: 0,
   213	                        },
   214	                        true,
   215	                    );
   216	                }
   217	                (ci, 0u64, len as u64)
   218	            }
   219	        };
   220	
   221	        // Tail: y_j = f^j(v) reaches cycle position `entry_pos` after mu - j steps.
   222	        let mut y = v;
   223	        let mut j: u64 = 0;
   224	        while j < mu {
   225	            if (j as usize) % STRIDE == 0 {
   226	                let back = mu - j;
   227	                let off = ((entry_pos + len - (back % len)) % len) as u32;
   228	                self.remember(
   229	                    y,
   230	                    Entry {
   231	                        cycle: ci,
   232	                        off,
   233	                        dist: clamp_u32(back),
   234	                    },
   235	                    false,
   236	                );
   237	            }
   238	            y = kernel_step(y);
   239	            j += 1;
   240	        }
   241	    }
   242	
   243	    /// Exact `f^n(v)`.
   244	    fn resolve(&mut self, v: c_int, n: u32) -> c_int {
   245	        let mut path = std::mem::take(&mut self.path);
   246	        path.clear();
   247	
   248	        let mut x = v;
   249	        let mut k: u32 = 0;
   250	        let hit = loop {
   251	            if let Some(e) = self.lookup(x) {
   252	                break Some(e);
   253	            }
   254	            if k == n {
   255	                break None;
   256	            }
   257	            path.push(x);
   258	            x = kernel_step(x);
   259	            k += 1;
   260	        };
   261	
   262	        let answer = match hit {
   263	            None => {
   264	                // Walked the full n steps, so `x` is already the exact answer.
   265	                // Learn this basin so that later elements are cheap.
   266	                if n >= LEARN_MIN_N && self.learn_attempts < MAX_LEARN_ATTEMPTS {
   267	                    self.learn(v);
   268	                }
   269	                x
   270	            }
   271	            Some(e) => {
   272	                let len = self.cycles[e.cycle as usize].len() as u64;
   273	                let total_dist = k as u64 + e.dist as u64;
   274	                let ans = if (n as u64) >= total_dist {
   275	                    let idx = ((e.off as u64 + n as u64 - k as u64) % len) as usize;
   276	                    self.cycles[e.cycle as usize][idx]
   277	                } else {
   278	                    kernel_iterate(v, n)
   279	                };
   280	                // Memoise a subsample of the freshly walked tail.
   281	                let mut j = 0usize;
   282	                while j < path.len() {
   283	                    let y = path[j];
   284	                    let back = (k as u64) - (j as u64);
   285	                    let off = ((e.off as u64 + len - (back % len)) % len) as u32;
   286	                    let dist = clamp_u32(back + e.dist as u64);
   287	                    self.remember(
   288	                        y,
   289	                        Entry {
   290	                            cycle: e.cycle,
   291	                            off,
   292	                            dist,
   293	                        },
   294	                        false,
   295	                    );
   296	                    j += STRIDE;
   297	                }
   298	                ans
   299	            }
   300	        };
   301	
   302	        self.path = path;
   303	        answer
   304	    }
   305	}
   306	
   307	/// Apply `f^n` to every element of `arr`, exactly as `n / 100` calls to
   308	/// `perform_expensive_operations()` would.
   309	pub fn apply_iterations(arr: &mut [c_int], n: u32) {
   310	    if n == 0 {
   311	        return;
   312	    }
   313	    if n < LEARN_MIN_N {
   314	        // Cheap enough that the bookkeeping would cost more than it saves.
   315	        for slot in arr.iter_mut() {
   316	            *slot = kernel_iterate(*slot, n);
   317	        }
   318	        return;
   319	    }
   320	    let mut solver = Solver::new();
   321	    for slot in arr.iter_mut() {
   322	        *slot = solver.resolve(*slot, n);
   323	    }
   324	    debug_report(&solver, n);
   325	}
   326	
   327	#[cfg(feature = "debug-stats")]
   328	fn debug_report(solver: &Solver, n: u32) {
   329	    let cyc_vals: usize = solver.cycles.iter().map(|c| c.len()).sum();
   330	    let mut lens: Vec<usize> = solver.cycles.iter().map(|c| c.len()).collect();
   331	    lens.sort_unstable();
   332	    eprintln!(
   333	        "DBG n={} learn_attempts={} cycles={} cyc_vals={} memo={} cycle_lens={:?}",
   334	        n,
   335	        solver.learn_attempts,
   336	        solver.cycles.len(),
   337	        cyc_vals,
   338	        solver.memo.len(),
   339	        lens
   340	    );
   341	}
   342	
   343	#[cfg(not(feature = "debug-stats"))]
   344	#[inline(always)]
   345	fn debug_report(_solver: &Solver, _n: u32) {}
