/* Exhaustively verify perform_expensive_operations over ALL 2^32 int inputs by
   driving BOTH shared objects through their exported symbols. */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <dlfcn.h>
#define N (256*1024)
int main(int argc,char**argv){
  const char*cso=argv[1], *rso=argv[2];
  long shard=atol(argv[3]), nshard=atol(argv[4]);
  void*hc=dlopen(cso,RTLD_NOW|RTLD_LOCAL); if(!hc){fprintf(stderr,"dlopen C: %s\n",dlerror());return 2;}
  void*hr=dlopen(rso,RTLD_NOW|RTLD_LOCAL); if(!hr){fprintf(stderr,"dlopen R: %s\n",dlerror());return 2;}
  void(*pc)(void)=dlsym(hc,"perform_expensive_operations");
  void(*pr)(void)=dlsym(hr,"perform_expensive_operations");
  int*ac=dlsym(hc,"array"); int*ar=dlsym(hr,"array");
  if(!pc||!pr||!ac||!ar){fprintf(stderr,"dlsym\n");return 3;}
  int*in=malloc(N*4);
  long total=4294967296L/N; /* 16384 chunks */
  long bad=0, done=0;
  for(long c=shard;c<total;c+=nshard){
    unsigned int base=(unsigned int)(c*N);
    for(long i=0;i<N;i++) in[i]=(int)(base+(unsigned int)i);
    memcpy(ac,in,N*4); memcpy(ar,in,N*4);
    pc(); pr();
    if(memcmp(ac,ar,N*4)!=0){
      for(long i=0;i<N;i++) if(ac[i]!=ar[i]){
        if(bad<5) fprintf(stderr,"MISMATCH in=%d C=%d R=%d\n",in[i],ac[i],ar[i]);
        bad++;
      }
    }
    done++;
  }
  printf("shard %ld/%ld chunks=%ld mismatches=%ld\n",shard,nshard,done,bad);
  return bad?1:0;
}
EOF
