#include <stdio.h>
#include <stdint.h>
#include <string.h>
#include <dlfcn.h>
typedef struct c2v { float x, y; } c2v;
typedef struct c2Raycast { float t; c2v n; } c2Raycast;
typedef struct c2r { float c, s; } c2r;
typedef struct c2x { c2v p; c2r r; } c2x;
typedef struct c2Circle { c2v p; float r; } c2Circle;
typedef struct c2AABB { c2v min, max; } c2AABB;
typedef struct c2Capsule { c2v a, b; float r; } c2Capsule;
typedef struct c2Poly { int count; c2v verts[8]; c2v norms[8]; } c2Poly;
typedef struct c2Ray { c2v p, d; float t; } c2Ray;

static uint64_t s = 0x12345678ULL;
static uint32_t rnd(void){ s = s*6364136223846793005ULL + 1442695040888963407ULL; return (uint32_t)(s>>33); }
static float rf(void){ return ((float)(int32_t)(rnd()%40001) - 20000.0f)/1000.0f; }

int (*RC)(c2Ray, c2Circle, c2Raycast*);
int (*RA)(c2Ray, c2AABB, c2Raycast*);
int (*RCap)(c2Ray, c2Capsule, c2Raycast*);
int (*RP)(c2Ray, const c2Poly*, const c2x*, c2Raycast*);
int (*CAST)(c2Ray, const void*, const c2x*, int, c2Raycast*);
c2v (*NORM)(c2v);
float (*LEN)(c2v);
c2v (*MINV)(c2v,c2v);
c2v (*ABSV)(c2v);
int (*AABBAABB)(c2AABB,c2AABB);
int (*C2P)(c2Circle,c2v);

#define G(v,n) do{ v = dlsym(h,n); if(!v){printf("missing %s\n",n); return 1;} }while(0)

static void dump(const char* tag, int r, c2Raycast* o){
    unsigned char* p=(unsigned char*)o;
    printf("%s r=%d [", tag, r);
    for(size_t i=0;i<sizeof(*o);i++) printf("%02x", p[i]);
    printf("]\n");
}
int main(int argc, char** argv){
    void* h = dlopen(argv[1], RTLD_NOW);
    if(!h){printf("dlopen: %s\n", dlerror()); return 1;}
    G(RC,"c2RaytoCircle"); G(RA,"c2RaytoAABB"); G(RCap,"c2RaytoCapsule");
    G(RP,"c2RaytoPoly"); G(CAST,"c2CastRay"); G(NORM,"c2Norm"); G(LEN,"c2Len");
    G(MINV,"c2Minv"); G(ABSV,"c2Absv"); G(AABBAABB,"c2AABBtoAABB"); G(C2P,"c2CircleToPoint");

    for(int it=0; it<4000; ++it){
        c2Ray ray; ray.p=(c2v){rf(),rf()}; ray.d=(c2v){rf(),rf()}; ray.t=rf();
        if(it%3==0){ c2v n=NORM(ray.d); ray.d=n; }           // normalized dirs
        if(it%7==0){ ray.d=(c2v){ (it%2)?1.0f:0.0f, (it%2)?0.0f:-1.0f }; }
        c2Raycast o; memset(&o,0x5A,sizeof o);

        c2Circle ci; ci.p=(c2v){rf(),rf()}; ci.r=rf();
        dump("circ", RC(ray,ci,&o), &o);

        c2AABB bb; c2v q1={rf(),rf()}, q2={rf(),rf()};
        bb.min=MINV(q1,q2); bb.max=(c2v){q1.x>q2.x?q1.x:q2.x, q1.y>q2.y?q1.y:q2.y};
        memset(&o,0x5A,sizeof o); dump("aabb", RA(ray,bb,&o), &o);

        c2Capsule cap; cap.a=(c2v){rf(),rf()}; cap.b=(c2v){rf(),rf()}; cap.r=rf();
        memset(&o,0x5A,sizeof o); dump("caps", RCap(ray,cap,&o), &o);

        c2Poly pl; memset(&pl,0,sizeof pl);
        int cnt = 3 + (rnd()%6);
        pl.count = cnt;
        for(int i=0;i<cnt;i++){ pl.verts[i]=(c2v){rf(),rf()}; pl.norms[i]=NORM((c2v){rf(),rf()}); }
        if(it%5==0){ // axis aligned box like the real one
            pl.count=4;
            pl.verts[0]=(c2v){0.875f,-11.5f}; pl.verts[1]=(c2v){0.875f,11.5f};
            pl.verts[2]=(c2v){-0.875f,11.5f}; pl.verts[3]=(c2v){-0.875f,-11.5f};
            pl.norms[0]=(c2v){1,0}; pl.norms[1]=(c2v){0,1};
            pl.norms[2]=(c2v){-1,0}; pl.norms[3]=(c2v){0,-1};
        }
        memset(&o,0x5A,sizeof o); dump("polyN", RP(ray,&pl,0,&o), &o);
        c2x bx; bx.p=(c2v){rf(),rf()}; c2v u=NORM((c2v){rf(),rf()}); bx.r=(c2r){u.x,u.y};
        memset(&o,0x5A,sizeof o); dump("polyX", RP(ray,&pl,&bx,&o), &o);
        memset(&o,0x5A,sizeof o); dump("cast0", CAST(ray,&ci,0,0,&o), &o);
        memset(&o,0x5A,sizeof o); dump("cast1", CAST(ray,&bb,0,1,&o), &o);
        memset(&o,0x5A,sizeof o); dump("cast2", CAST(ray,&cap,0,2,&o), &o);
        memset(&o,0x5A,sizeof o); dump("cast3", CAST(ray,&pl,&bx,3,&o), &o);
        memset(&o,0x5A,sizeof o); dump("cast9", CAST(ray,&pl,&bx,42,&o), &o);
        c2v av=ABSV(ray.d);
        printf("misc %08x %08x %08x %d %d\n",
            *(uint32_t*)&av.x, *(uint32_t*)&av.y,
            (uint32_t)(*(uint32_t*)(float[]){LEN(ray.d)}),
            AABBAABB(bb,bb), C2P(ci, ray.p));
    }
    return 0;
}
