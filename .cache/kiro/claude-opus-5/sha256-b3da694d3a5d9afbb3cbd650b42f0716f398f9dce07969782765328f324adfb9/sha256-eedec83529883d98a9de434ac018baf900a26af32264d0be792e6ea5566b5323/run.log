[0m[49m[38;5;10m+    555[0m:[38;5;10m[49m             cases.push((b + delta).to_string());
[0m[49m[38;5;10m+    556[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    557[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    558[0m:[38;5;10m[49m     for n in -300i32..=300 {
