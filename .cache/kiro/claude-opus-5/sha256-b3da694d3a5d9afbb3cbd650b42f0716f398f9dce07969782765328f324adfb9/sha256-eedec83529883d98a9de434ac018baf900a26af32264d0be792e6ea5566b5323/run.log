[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m     assert_same_and_eq("one", b"1", "01000000\n");
[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m     assert_same_and_eq("255", b"255", "ff000000\n");
[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m     assert_same_and_eq("256", b"256", "00010000\n");
[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m     assert_same_and_eq("65535", b"65535", "ffff0000\n");
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m     assert_same_and_eq("16777216", b"16777216", "00000001\n");
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m /// Explicit sign handling, including `-0`.
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m fn signs() {
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m     assert_same_and_eq("plus5", b"+5", "05000000\n");
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m     assert_same_and_eq("minus1", b"-1", "ffffffff\n");
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m     assert_same_and_eq("minus_zero", b"-0", "00000000\n");
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m     assert_same_and_eq("plus_zero", b"+0", "00000000\n");
[0m[49m[38;5;10m+    236[0m:[38;5;10m[49m     assert_same_and_eq("minus7", b"-7", "f9ffffff\n");
[0m[49m[38;5;10m+    237[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m /// `scanf`'s leading-whitespace skip crosses newlines (unlike `fgets`).
[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m fn leading_whitespace_is_skipped_across_newlines() {
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m     assert_same_and_eq("nl_then_7", b"\n\n\n7", "07000000\n");
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m     assert_same_and_eq("mixed_ws_then_7", b" \t\n\r\x0b\x0c 7", "07000000\n");
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m     assert_same_and_eq("ws_then_neg", b"     -7  ", "f9ffffff\n");
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m     assert_same_and_eq("tab_then_5", b"\t5", "05000000\n");
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m /// Only the first conversion happens; the rest of stdin is never read.
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m fn only_the_first_item_is_converted() {
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m     assert_same_and_eq("two_ints", b"3 4", "03000000\n");
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m     assert_same_and_eq("two_lines", b"3\n4\n", "03000000\n");
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m     assert_same_and_eq("many_ints", b"12 34 56 78\n", "0c000000\n");
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m     assert_same_and_eq("first_then_garbage", b"12abc", "0c000000\n");
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m     assert_same_and_eq("first_then_dot", b"3.9", "03000000\n");
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m     assert_same_and_eq("comma_group", b"1,000", "01000000\n");
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m     assert_same_and_eq("underscore", b"1_0", "01000000\n");
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m     assert_same_and_eq("e_notation", b"1e5", "01000000\n");
[0m[49m[38;5;10m+    259[0m:[38;5;10m[49m     // %d is base 10, so conversion stops at the 'x'.
[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m     assert_same_and_eq("hex_literal", b"0x10", "00000000\n");
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    263[0m:[38;5;10m[49m /// Matching failure: nothing is stored, `x` stays 0.
[0m[49m[38;5;10m+    264[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    265[0m:[38;5;10m[49m fn matching_failures_leave_x_at_zero() {
[0m[49m[38;5;10m+    266[0m:[38;5;10m[49m     for (name, input) in [
[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m         ("alpha", &b"abc"[..]),
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m         ("dot_first", &b".5"[..]),
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m         ("sign_only_minus", &b"-"[..]),
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m         ("sign_only_plus", &b"+"[..]),
[0m[49m[38;5;10m+    271[0m:[38;5;10m[49m         ("double_minus", &b"--5"[..]),
[0m[49m[38;5;10m+    272[0m:[38;5;10m[49m         ("double_plus", &b"++5"[..]),
[0m[49m[38;5;10m+    273[0m:[38;5;10m[49m         ("plus_minus", &b"+-5"[..]),
[0m[49m[38;5;10m+    274[0m:[38;5;10m[49m         ("minus_plus", &b"-+5"[..]),
[0m[49m[38;5;10m+    275[0m:[38;5;10m[49m         ("space_after_sign", &b"- 5"[..]),
[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m         ("space_after_plus", &b"+ 5"[..]),
[0m[49m[38;5;10m+    277[0m:[38;5;10m[49m         ("sign_then_nl", &b"-\n5"[..]),
[0m[49m[38;5;10m+    278[0m:[38;5;10m[49m         ("punct", &b"!?#"[..]),
[0m[49m[38;5;10m+    279[0m:[38;5;10m[49m         ("nul_first", &b"\x00\x005"[..]),
[0m[49m[38;5;10m+    280[0m:[38;5;10m[49m         ("nul_only", &b"\x00"[..]),
[0m[49m[38;5;10m+    281[0m:[38;5;10m[49m         ("high_bytes", &b"\xff\xfe5"[..]),
[0m[49m[38;5;10m+    282[0m:[38;5;10m[49m         ("ws_then_alpha", &b"   xyz"[..]),
[0m[49m[38;5;10m+    283[0m:[38;5;10m[49m     ] {
[0m[49m[38;5;10m+    284[0m:[38;5;10m[49m         assert_same_and_eq(name, input, "00000000\n");
[0m[49m[38;5;10m+    285[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    286[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    287[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    288[0m:[38;5;10m[49m /// The int boundaries, and the truncation of `strtol`'s `long` result into an
[0m[49m[38;5;10m+    289[0m:[38;5;10m[49m /// `int` that glibc performs for `%d`.
[0m[49m[38;5;10m+    290[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    291[0m:[38;5;10m[49m fn int_boundaries_and_truncation() {
[0m[49m[38;5;10m+    292[0m:[38;5;10m[49m     assert_same_and_eq("int_max", b"2147483647", "ffffff7f\n");
[0m[49m[38;5;10m+    293[0m:[38;5;10m[49m     assert_same_and_eq("int_min", b"-2147483648", "00000080\n");
[0m[49m[38;5;10m+    294[0m:[38;5;10m[49m     // Fits in a long, then truncated to int: wraps to INT_MIN.
[0m[49m[38;5;10m+    295[0m:[38;5;10m[49m     assert_same_and_eq("int_max_plus_1", b"2147483648", "00000080\n");
[0m[49m[38;5;10m+    296[0m:[38;5;10m[49m     // ... and to INT_MAX.
[0m[49m[38;5;10m+    297[0m:[38;5;10m[49m     assert_same_and_eq("int_min_minus_1", b"-2147483649", "ffffff7f\n");
[0m[49m[38;5;10m+    298[0m:[38;5;10m[49m     // 2^32 truncates to 0.
[0m[49m[38;5;10m+    299[0m:[38;5;10m[49m     assert_same_and_eq("two_pow_32", b"4294967296", "00000000\n");
[0m[49m[38;5;10m+    300[0m:[38;5;10m[49m     assert_same_and_eq("two_pow_32_plus_1", b"4294967297", "01000000\n");
[0m[49m[38;5;10m+    301[0m:[38;5;10m[49m     assert_same_and_eq("neg_two_pow_32", b"-4294967296", "00000000\n");
[0m[49m[38;5;10m+    302[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    303[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    304[0m:[38;5;10m[49m /// glibc converts `%d` with `strtol`, which *saturates* at LONG_MAX / LONG_MIN
[0m[49m[38;5;10m+    305[0m:[38;5;10m[49m /// on overflow; the saturated `long` is then truncated to `int`. So a huge
[0m[49m[38;5;10m+    306[0m:[38;5;10m[49m /// positive number becomes -1 and a huge negative one becomes 0.
[0m[49m[38;5;10m+    307[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    308[0m:[38;5;10m[49m fn long_overflow_saturates_then_truncates() {
[0m[49m[38;5;10m+    309[0m:[38;5;10m[49m     assert_same_and_eq("long_max", b"9223372036854775807", "ffffffff\n");
[0m[49m[38;5;10m+    310[0m:[38;5;10m[49m     assert_same_and_eq("long_max_plus_1", b"9223372036854775808", "ffffffff\n");
[0m[49m[38;5;10m+    311[0m:[38;5;10m[49m     assert_same_and_eq("long_min", b"-9223372036854775808", "00000000\n");
[0m[49m[38;5;10m+    312[0m:[38;5;10m[49m     assert_same_and_eq("long_min_minus_1", b"-9223372036854775809", "00000000\n");
[0m[49m[38;5;10m+    313[0m:[38;5;10m[49m     assert_same_and_eq("twenty_nines", b"99999999999999999999", "ffffffff\n");
[0m[49m[38;5;10m+    314[0m:[38;5;10m[49m     assert_same_and_eq("twenty_nines_neg", b"-99999999999999999999", "00000000\n");
[0m[49m[38;5;10m+    315[0m:[38;5;10m[49m     assert_same_and_eq("two_pow_64", b"18446744073709551616", "ffffffff\n");
[0m[49m[38;5;10m+    316[0m:[38;5;10m[49m     assert_same_and_eq("ten_pow_30", b"1000000000000000000000000000000", "ffffffff\n");
[0m[49m[38;5;10m+    317[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    318[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    319[0m:[38;5;10m[49m /// Leading zeros are not an overflow, however many there are.
[0m[49m[38;5;10m+    320[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    321[0m:[38;5;10m[49m fn leading_zeros() {
[0m[49m[38;5;10m+    322[0m:[38;5;10m[49m     let mut input = vec![b'0'; 30];
[0m[49m[38;5;10m+    323[0m:[38;5;10m[49m     input.extend_from_slice(b"42");
[0m[49m[38;5;10m+    324[0m:[38;5;10m[49m     assert_same_and_eq("leading_zeros_42", &input, "2a000000\n");
[0m[49m[38;5;10m+    325[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    326[0m:[38;5;10m[49m     let mut neg = vec![b'-'];
[0m[49m[38;5;10m+    327[0m:[38;5;10m[49m     neg.extend(std::iter::repeat(b'0').take(30));
[0m[49m[38;5;10m+    328[0m:[38;5;10m[49m     neg.push(b'1');
[0m[49m[38;5;10m+    329[0m:[38;5;10m[49m     assert_same_and_eq("leading_zeros_neg1", &neg, "ffffffff\n");
[0m[49m[38;5;10m+    330[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    331[0m:[38;5;10m[49m     let zeros = vec![b'0'; 100_000];
[0m[49m[38;5;10m+    332[0m:[38;5;10m[49m     assert_same_and_eq("100k_zeros", &zeros, "00000000\n");
[0m[49m[38;5;10m+    333[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    334[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    335[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    336[0m:[38;5;10m[49m // Phase C: the paths nothing above reaches
[0m[49m[38;5;10m+    337[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    338[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    339[0m:[38;5;10m[49m /// Digit runs long enough to cross the Rust reader's internal 4 KiB buffer and
[0m[49m[38;5;10m+    340[0m:[38;5;10m[49m /// glibc's own `scanf` work buffer.
[0m[49m[38;5;10m+    341[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    342[0m:[38;5;10m[49m fn very_long_inputs_and_buffer_boundaries() {
[0m[49m[38;5;10m+    343[0m:[38;5;10m[49m     let nines = vec![b'9'; 100_000];
[0m[49m[38;5;10m+    344[0m:[38;5;10m[49m     assert_same_and_eq("100k_nines", &nines, "ffffffff\n");
[0m[49m[38;5;10m+    345[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    346[0m:[38;5;10m[49m     let mut neg_nines = vec![b'-'];
[0m[49m[38;5;10m+    347[0m:[38;5;10m[49m     neg_nines.extend(std::iter::repeat(b'9').take(100_000));
[0m[49m[38;5;10m+    348[0m:[38;5;10m[49m     assert_same_and_eq("100k_nines_neg", &neg_nines, "00000000\n");
[0m[49m[38;5;10m+    349[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    350[0m:[38;5;10m[49m     // Whitespace runs that straddle the 4096-byte read boundary, so that the
[0m[49m[38;5;10m+    351[0m:[38;5;10m[49m     // digits land at, just before and just after the refill point.
[0m[49m[38;5;10m+    352[0m:[38;5;10m[49m     for pad in [4094usize, 4095, 4096, 4097, 8191, 8192, 8193] {
[0m[49m[38;5;10m+    353[0m:[38;5;10m[49m         let mut input = vec![b' '; pad];
[0m[49m[38;5;10m+    354[0m:[38;5;10m[49m         input.extend_from_slice(b"123456");
[0m[49m[38;5;10m+    355[0m:[38;5;10m[49m         assert_same_and_eq(&format!("ws_pad_{pad}"), &input, "40e20100\n");
[0m[49m[38;5;10m+    356[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    357[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    358[0m:[38;5;10m[49m     // A sign and digits split across the boundary.
[0m[49m[38;5;10m+    359[0m:[38;5;10m[49m     for pad in [4095usize, 4096] {
[0m[49m[38;5;10m+    360[0m:[38;5;10m[49m         let mut input = vec![b'\n'; pad];
[0m[49m[38;5;10m+    361[0m:[38;5;10m[49m         input.extend_from_slice(b"-2");
[0m[49m[38;5;10m+    362[0m:[38;5;10m[49m         assert_same_and_eq(&format!("nl_pad_{pad}_neg2"), &input, "feffffff\n");
[0m[49m[38;5;10m+    363[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    364[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    365[0m:[38;5;10m[49m     let mut big_ws = vec![b' '; 10_000];
[0m[49m[38;5;10m+    366[0m:[38;5;10m[49m     big_ws.extend_from_slice(b"-13");
[0m[49m[38;5;10m+    367[0m:[38;5;10m[49m     assert_same_and_eq("10k_spaces_neg13", &big_ws, "f3ffffff\n");
[0m[49m[38;5;10m+    368[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    369[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    370[0m:[38;5;10m[49m /// Arbitrary binary stdin, including every byte value, must not diverge.
[0m[49m[38;5;10m+    371[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    372[0m:[38;5;10m[49m fn arbitrary_binary_input() {
[0m[49m[38;5;10m+    373[0m:[38;5;10m[49m     let all: Vec<u8> = (0u8..=255).collect();
[0m[49m[38;5;10m+    374[0m:[38;5;10m[49m     assert_same("all_256_bytes", &all);
[0m[49m[38;5;10m+    375[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    376[0m:[38;5;10m[49m     // Every single byte on its own: exercises "is this byte whitespace, a
[0m[49m[38;5;10m+    377[0m:[38;5;10m[49m     // sign, a digit, or a matching failure?" for the whole domain.
[0m[49m[38;5;10m+    378[0m:[38;5;10m[49m     for b in 0u8..=255 {
[0m[49m[38;5;10m+    379[0m:[38;5;10m[49m         assert_same(&format!("single_byte_{b:#04x}"), &[b]);
[0m[49m[38;5;10m+    380[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    381[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    382[0m:[38;5;10m[49m     // Every byte value directly after a digit (does the conversion stop
[0m[49m[38;5;10m+    383[0m:[38;5;10m[49m     // there?) and directly after a sign (matching failure or not?).
[0m[49m[38;5;10m+    384[0m:[38;5;10m[49m     for b in 0u8..=255 {
[0m[49m[38;5;10m+    385[0m:[38;5;10m[49m         assert_same(&format!("digit_then_{b:#04x}"), &[b'7', b]);
[0m[49m[38;5;10m+    386[0m:[38;5;10m[49m         assert_same(&format!("sign_then_{b:#04x}"), &[b'-', b]);
[0m[49m[38;5;10m+    387[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    388[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    389[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    390[0m:[38;5;10m[49m /// Every value of the low byte, plus a spread of bit patterns, to pin the
[0m[49m[38;5;10m+    391[0m:[38;5;10m[49m /// `%02x` formatting (zero padding, lowercase, no separators, one trailing
[0m[49m[38;5;10m+    392[0m:[38;5;10m[49m /// newline) across the whole hex alphabet.
