import pathlib, re
p = pathlib.Path("src/lib.rs")
s = p.read_text()

# c2Witness / c2L: `den = 1.0f / s->div` is `divss div, 1.0f`.
old = "        let den = 1.0f32 / s.div;"
assert s.count(old) == 2, s.count(old)
s = s.replace(old, "        let den = fdiv(1.0f32, s.div);")

# The reference build emits `movss <u>; mulss den`, so the destination register
# holds `u`, not `den` - i.e. the operands are reversed vs the C source.
n = 0
for field in ("a", "b", "c"):
    for comp in ("sA", "sB", "p"):
        old = f"c2Mulvs(s.{field}.{comp}, den * s.{field}.u)"
        new = f"c2Mulvs(s.{field}.{comp}, fmul(s.{field}.u, den))"
        n += s.count(old)
        s = s.replace(old, new)
print("den*u sites rewritten:", n)
assert "den * s." not in s, [l for l in s.splitlines() if "den * s." in l]
p.write_text(s)
EOF
