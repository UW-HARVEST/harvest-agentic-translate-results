[0m[49m[38;5;10m+     34[0m:[38;5;10m[49m     fgets(s1, sizeof(s1), stdin);
[0m[49m[38;5;10m+     35[0m:[38;5;10m[49m     fgets(s2, sizeof(s1), stdin);
