import subprocess, random, sys
C="./c_src/build/driver"; R="./translation/target/release/driver"
def run(p, data):
    pr=subprocess.run([p],input=data,capture_output=True)
    return pr.stdout, pr.stderr, pr.returncode
def check(data, tag):
    a=run(C,data); b=run(R,data)
    if a!=b:
        print("DIFF",tag,repr(data[:120]),"C:",a,"R:",b); return False
    return True

fails=0
# every single byte value as the sole content of s1, and as sole content of s2
for v in range(256):
    b=bytes([v])
    if not check(b+b"\nabc\n", f"s1=byte{v}"): fails+=1
    if not check(b"abc\n"+b+b"\n", f"s2=byte{v}"): fails+=1

# high-byte reject sets (signedness of char in strcspn)
for v in range(128,256):
    if not check(bytes([v])*5+b"\n"+bytes([v])+b"\n", f"hi{v}"): fails+=1

# structured lengths around the 99/100 boundary, with a match char placed everywhere
for n in (0,1,2,97,98,99,100,101,197,198,199,200):
    for pos in set([0,1,n//2,max(0,n-2),max(0,n-1)]):
        if n==0: continue
        s=bytearray(b'a'*n); s[pos%n]=ord('X')
        for tail in (b"\nX\n", b"\nX", b"\n\n", b"\n", b"", b"\nabc\n"):
            if not check(bytes(s)+tail, f"n={n},pos={pos}"): fails+=1

# random fuzz over arbitrary bytes incl NUL and newlines
random.seed(1234)
for i in range(4000):
    ln=random.randint(0,260)
    alpha=random.choice([b"ab\n", b"abc", b"ab\n\x00", bytes(range(256)), b"\n", b"aX\n\x00\xff"])
    data=bytes(random.choice(alpha) for _ in range(ln))
    if not check(data, f"rand{i}"): fails+=1

print("FAILURES:", fails)
EOF
