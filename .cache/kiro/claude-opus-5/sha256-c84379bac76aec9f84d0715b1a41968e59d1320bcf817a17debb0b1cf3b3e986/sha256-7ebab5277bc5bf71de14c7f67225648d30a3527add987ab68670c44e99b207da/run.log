    26	use std::ffi::{CStr, c_char, c_int};
    27	
    28	// `driver.h` declares only `void driver(const char *in);` and contains no
    29	// namespace/renaming macros, so the linker symbols are the plain source-level
    30	// names. `fma_array` and `call_fma` are non-static in the C translation unit,
    31	// so they are exported from the shared library too and are kept exported here.
    32	unsafe extern "C" {
    33	    fn printf(fmt: *const c_char, ...) -> c_int;
    34	}
    35	
    36	/// C: `void fma_array(int *restrict out, const int *mul1, const int *mul2,
    37	///                   const int *add, int len)`
    38	#[unsafe(no_mangle)]
    39	pub unsafe extern "C" fn fma_array(
    40	    out: *mut c_int,
    41	    mul1: *const c_int,
    42	    mul2: *const c_int,
    43	    add: *const c_int,
    44	    len: c_int,
    45	) {
    46	    let mut i: c_int = 0;
    47	    while i < len {
    48	        let idx = i as isize;
    49	        // Signed overflow is UB in C; on the usual targets it wraps, so wrap here.
    50	        let v = unsafe {
    51	            (*mul1.offset(idx))
    52	                .wrapping_mul(*mul2.offset(idx))
    53	                .wrapping_add(*add.offset(idx))
    54	        };
    55	        unsafe { *out.offset(idx) = v };
    56	        i += 1;
    57	    }
    58	}
    59	
    60	/// C: `int call_fma(const int *data, int len)`
    61	#[unsafe(no_mangle)]
    62	pub unsafe extern "C" fn call_fma(data: *const c_int, len: c_int) -> c_int {
    63	    if len == 0 {
    64	        return 0;
    65	    }
    66	    // A negative `len` makes the C VLA declarations and the `out[len-1]` read
    67	    // undefined behaviour; there is no observable behaviour to reproduce.
    68	    if len < 0 {
    69	        return 0;
    70	    }
    71	
    72	    let n = len as usize;
    73	    // C leaves these VLAs uninitialized; every element that is later read is
    74	    // written before use, so zero-filling is equivalent.
    75	    let mut out: Vec<c_int> = vec![0; n];
    76	    let mut ones: Vec<c_int> = vec![0; n];
    77	    let mut zeros: Vec<c_int> = vec![0; n];
    78	
    79	    out[0] = 0;
    80	    for i in 0..n {
    81	        ones[i] = 1;
    82	        zeros[i] = 0;
    83	    }
    84	
    85	    unsafe {
    86	        fma_array(
    87	            out.as_mut_ptr(),
    88	            ones.as_ptr(),
    89	            data,
    90	            zeros.as_ptr(),
    91	            len,
    92	        );
    93	    }
    94	    out[n - 1]
    95	}
    96	
    97	/// C: `void driver(const char *in)`
    98	#[unsafe(no_mangle)]
    99	pub unsafe extern "C" fn driver(input: *const c_char) {
   100	    // sscanf reads up to the terminating NUL, so snapshot the whole string once
   101	    // and then walk it with an offset (the C code advances `in` by `%zn`).
   102	    let s = unsafe { CStr::from_ptr(input) }.to_bytes();
   103	
   104	    let mut data: [c_int; 100] = [0; 100];
   105	    let mut pos: usize = 0;
   106	    let mut i: usize = 0;
   107	    while i < 100 {
   108	        // `sscanf(in, "%d%zn", &data[i], &nb) != 1` -> break
   109	        match scan_d(&s[pos..]) {
   110	            Some((value, nb)) => {
   111	                data[i] = value;
   112	                pos += nb;
   113	            }
   114	            None => break,
   115	        }
   116	        i += 1;
   117	    }
   118	
   119	    let result = unsafe { call_fma(data.as_ptr(), i as c_int) };
   120	    unsafe {
   121	        printf(c"%d\n".as_ptr(), result);
   122	    }
   123	}
   124	
   125	/// `isspace()` in the C locale.
   126	fn is_space(b: u8) -> bool {
   127	    matches!(b, b' ' | b'\t' | b'\n' | 0x0b | 0x0c | b'\r')
   128	}
   129	
   130	/// One `%d` conversion as performed by glibc's `sscanf`.
   131	///
   132	/// Returns `Some((converted_value, chars_consumed))` on success (the character
   133	/// count matches what `%zn` would store, i.e. it includes the skipped leading
   134	/// whitespace and the optional sign), or `None` for an input/matching failure.
   135	///
   136	/// glibc converts the collected digit string with `strtol`, which saturates at
   137	/// `LONG_MAX`/`LONG_MIN`, and then assigns that `long` to the `int *` argument,
   138	/// truncating it. That saturate-then-truncate behaviour is reproduced here.
   139	fn scan_d(s: &[u8]) -> Option<(c_int, usize)> {
   140	    let mut p: usize = 0;
   141	    while p < s.len() && is_space(s[p]) {
   142	        p += 1;
   143	    }
   144	
   145	    let negative = if p < s.len() && (s[p] == b'+' || s[p] == b'-') {
   146	        let neg = s[p] == b'-';
   147	        p += 1;
   148	        neg
   149	    } else {
   150	        false
   151	    };
   152	
   153	    let digits_start = p;
   154	    let mut magnitude: u64 = 0;
   155	    let mut saturated = false;
   156	    while p < s.len() && s[p].is_ascii_digit() {
   157	        if !saturated {
   158	            match magnitude
   159	                .checked_mul(10)
   160	                .and_then(|v| v.checked_add((s[p] - b'0') as u64))
   161	            {
   162	                Some(v) => magnitude = v,
   163	                None => saturated = true,
   164	            }
   165	        }
   166	        p += 1;
   167	    }
   168	
   169	    if p == digits_start {
   170	        // No digits: matching failure (or input failure at end of string).
   171	        return None;
   172	    }
   173	
   174	    let as_long: i64 = if negative {
   175	        const MIN_MAGNITUDE: u64 = 1u64 << 63; // |LONG_MIN|
   176	        if saturated || magnitude > MIN_MAGNITUDE {
   177	            i64::MIN
   178	        } else {
   179	            (magnitude as i64).wrapping_neg()
   180	        }
   181	    } else if saturated || magnitude > i64::MAX as u64 {
   182	        i64::MAX
   183	    } else {
   184	        magnitude as i64
   185	    };
   186	
   187	    Some((as_long as c_int, p))
   188	}
