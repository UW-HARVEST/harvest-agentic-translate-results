[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m             ));
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m     for i in 0..pool.len() {
[0m[49m[38;5;10m+    271[0m:[38;5;10m[49m         let a = pool[i];
[0m[49m[38;5;10m+    272[0m:[38;5;10m[49m         let b = pool[(i * 7 + 13) % pool.len()];
