[0m[49m[38;5;10m+    119[0m:[38;5;10m[49m // ------------------------------------------------------------------------ C49
[0m[49m[38;5;10m+    120[0m:[38;5;10m[49m /// Hold everything at the tame baseline and sweep the arguments of exactly one
[0m[49m[38;5;10m+    121[0m:[38;5;10m[49m /// sub-function at a time, so a divergence points straight at one stage.
[0m[49m[38;5;10m+    122[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    123[0m:[38;5;10m[49m fn c49_agglom_per_subfunction_sweeps() {
[0m[49m[38;5;10m+    124[0m:[38;5;10m[49m     let p = load();
