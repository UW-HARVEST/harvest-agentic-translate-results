[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m // ---------------------------------------------------------------- C6, C9
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m fn c6_c9_circle_to_circle_direct_and_via_f2() {
