#[unsafe(no_mangle)]
pub static mut cp_fixed_table: [u8; 288 + 32] = {
    let mut t = [0u8; 288 + 32];
    let mut i = 0usize;
    while i < 144 { t[i] = 8; i += 1; }
    while i < 256 { t[i] = 9; i += 1; }
    while i < 280 { t[i] = 7; i += 1; }
    while i < 288 { t[i] = 8; i += 1; }
    while i < 320 { t[i] = 5; i += 1; }
    t
};

