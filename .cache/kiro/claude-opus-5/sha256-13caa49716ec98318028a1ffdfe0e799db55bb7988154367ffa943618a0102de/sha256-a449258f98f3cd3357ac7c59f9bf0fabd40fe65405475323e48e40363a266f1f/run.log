[0m[49m[38;5;10m+     50[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     51[0m:[38;5;10m[49m     let test_bin = std::path::PathBuf::from(env!("CARGO_BIN_EXE_driver"));
[0m[49m[38;5;10m+     52[0m:[38;5;10m[49m     let inputs: &[&[u8]] = &[
[0m[49m[38;5;10m+     53[0m:[38;5;10m[49m         b"1\n9\n0\n1\n12\n",
[0m[49m[38;5;10m+     54[0m:[38;5;10m[49m         b"2\nS\n3\n0\n0\n4\n0\n-2147483648\n5\n0\n12\n",
[0m[49m[38;5;10m+     55[0m:[38;5;10m[49m         b"99999999999999999999\n-99999999999999999999\n12\n",
[0m[49m[38;5;10m+     56[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+     57[0m:[38;5;10m[49m     for (i, inp) in inputs.iter().enumerate() {
