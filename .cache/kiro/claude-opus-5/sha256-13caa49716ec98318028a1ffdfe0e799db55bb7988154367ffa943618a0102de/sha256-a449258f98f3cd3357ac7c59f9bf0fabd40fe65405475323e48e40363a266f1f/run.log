[0m[49m[38;5;10m+     68[0m:[38;5;10m[49m             (b.code, b.signal),
[0m[49m[38;5;10m+     69[0m:[38;5;10m[49m             "…and on exit status for input {i}"
[0m[49m[38;5;10m+     70[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+     71[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     72[0m:[38;5;10m[49m }
