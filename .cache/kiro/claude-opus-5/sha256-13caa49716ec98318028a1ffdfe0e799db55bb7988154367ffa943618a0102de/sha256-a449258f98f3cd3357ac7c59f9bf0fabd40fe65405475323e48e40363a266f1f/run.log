[0m[49m[38;5;10m+     62[0m:[38;5;10m[49m             harness::canonicalize_pointers(&b.stdout),
[0m[49m[38;5;10m+     63[0m:[38;5;10m[49m             "release and test-profile binaries disagree on stdout for input {i}"
[0m[49m[38;5;10m+     64[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+     65[0m:[38;5;10m[49m         assert_eq!(a.stderr, b.stderr, "…and on stderr for input {i}");
