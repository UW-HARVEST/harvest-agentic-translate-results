[0m[49m[38;5;10m+    513[0m:[38;5;10m[49m fn stdout_closed_early_kills_both_programs_the_same_way() {
[0m[49m[38;5;10m+    514[0m:[38;5;10m[49m     // The C program keeps the default SIGPIPE disposition and dies from signal
[0m[49m[38;5;10m+    515[0m:[38;5;10m[49m     // 13 when its reader goes away.  The Rust runtime ignores SIGPIPE unless
[0m[49m[38;5;10m+    516[0m:[38;5;10m[49m     // the program restores it, which would silently turn a signal death into a
[0m[49m[38;5;10m+    517[0m:[38;5;10m[49m     // successful exit.  Compare the raw wait status of both.
[0m[49m[38;5;10m+    518[0m:[38;5;10m[49m     let long = vec![b'x'; 100_000];
[0m[49m[38;5;10m+    519[0m:[38;5;10m[49m     let statuses: Vec<_> = [c_binary(), rust_binary()]
[0m[49m[38;5;10m+    520[0m:[38;5;10m[49m         .iter()
[0m[49m[38;5;10m+    521[0m:[38;5;10m[49m         .map(|bin| {
[0m[49m[38;5;10m+    522[0m:[38;5;10m[49m             let mut child = Command::new(bin)
[0m[49m[38;5;10m+    523[0m:[38;5;10m[49m                 .arg(os(&long))
[0m[49m[38;5;10m+    524[0m:[38;5;10m[49m                 .stdout(Stdio::piped())
[0m[49m[38;5;10m+    525[0m:[38;5;10m[49m                 .stderr(Stdio::piped())
[0m[49m[38;5;10m+    526[0m:[38;5;10m[49m                 .spawn()
[0m[49m[38;5;10m+    527[0m:[38;5;10m[49m                 .expect("spawn");
[0m[49m[38;5;10m+    528[0m:[38;5;10m[49m             // Drop the read end immediately so the child's write hits EPIPE.
[0m[49m[38;5;10m+    529[0m:[38;5;10m[49m             drop(child.stdout.take());
[0m[49m[38;5;10m+    530[0m:[38;5;10m[49m             let out = child.wait_with_output().expect("wait");
[0m[49m[38;5;10m+    531[0m:[38;5;10m[49m             exit_status(&out.status)
[0m[49m[38;5;10m+    532[0m:[38;5;10m[49m         })
[0m[49m[38;5;10m+    533[0m:[38;5;10m[49m         .collect();
[0m[49m[38;5;10m+    534[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    535[0m:[38;5;10m[49m     assert_eq!(
[0m[49m[38;5;10m+    536[0m:[38;5;10m[49m         statuses[0], statuses[1],
[0m[49m[38;5;10m+    537[0m:[38;5;10m[49m         "C and Rust disagree on the status after stdout is closed early: {statuses:?}"
[0m[49m[38;5;10m+    538[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    539[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    540[0m:[38;5;10m[49m 
