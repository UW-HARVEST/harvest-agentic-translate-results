[0m[49m[38;5;10m+    564[0m:[38;5;10m[49m             (exit_status(&out.status), out.stderr)
[0m[49m[38;5;10m+    565[0m:[38;5;10m[49m         })
[0m[49m[38;5;10m+    566[0m:[38;5;10m[49m         .collect();
