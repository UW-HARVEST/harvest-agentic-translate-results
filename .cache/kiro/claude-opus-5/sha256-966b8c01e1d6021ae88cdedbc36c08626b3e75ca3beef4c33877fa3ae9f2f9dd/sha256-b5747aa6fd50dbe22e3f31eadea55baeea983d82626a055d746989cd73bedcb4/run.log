"$TMP/hc" > "$TMP/out_c.txt"; "$TMP/hr" > "$TMP/out_rust.txt"
echo "=== C output ==="; cat "$TMP/out_c.txt"
if diff -u "$TMP/out_c.txt" "$TMP/out_rust.txt"; then echo "RESULT: byte-identical"; else echo "RESULT: MISMATCH"; fi
