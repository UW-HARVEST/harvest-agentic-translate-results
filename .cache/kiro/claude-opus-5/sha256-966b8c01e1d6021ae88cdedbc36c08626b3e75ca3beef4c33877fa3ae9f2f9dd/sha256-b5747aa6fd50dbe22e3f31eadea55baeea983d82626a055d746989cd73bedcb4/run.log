TMP=$(mktemp -d)
cc -O2 -shared -fPIC -I c_src/include -o "$TMP/libC.so" c_src/src/simplestruct.c
cat > "$TMP/harness.c" <<'EOF'
#include <stdio.h>
#include <stdlib.h>
struct ListNode { int value; struct ListNode* next; };
int smallestValue(struct ListNode*);
static struct ListNode* build(int *v, int n) {
    struct ListNode *head = NULL, *tail = NULL;
    for (int i = 0; i < n; i++) {
        struct ListNode *nd = malloc(sizeof *nd);
        nd->value = v[i]; nd->next = NULL;
        if (tail) tail->next = nd; else head = nd;
        tail = nd;
    }
    return head;
}
int main(void) {
    int a[] = {5};
    int b[] = {3,1,4,1,5,9,2,6};
    int c[] = {-7,-2,-100,0};
    int d[] = {2147483647,-2147483648,0};
    int e[] = {4,4,4,4};
    printf("null=%d\n", smallestValue(NULL));
    printf("one=%d\n", smallestValue(build(a,1)));
    printf("mixed=%d\n", smallestValue(build(b,8)));
    printf("neg=%d\n", smallestValue(build(c,4)));
    printf("extremes=%d\n", smallestValue(build(d,3)));
    printf("dup=%d\n", smallestValue(build(e,4)));
    int big[10000];
    for (int i = 0; i < 10000; i++) big[i] = (i * 7919) % 10007 - 5000;
    printf("big=%d\n", smallestValue(build(big,10000)));
    return 0;
}
EOF
cc -O2 -o "$TMP/hc" "$TMP/harness.c" -L"$TMP" -lC -Wl,-rpath,"$TMP"
