[0m[49m[38;5;10m+    174[0m:[38;5;10m[49m         let hr = hex_r.as_mut_ptr() as usize;
[0m[49m[38;5;10m+    175[0m:[38;5;10m[49m         let cf = c.bin2hex;
[0m[49m[38;5;10m+    176[0m:[38;5;10m[49m         let rf = r.bin2hex;
[0m[49m[38;5;10m+    177[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    178[0m:[38;5;10m[49m             in_child(|| unsafe {
[0m[49m[38;5;10m+    179[0m:[38;5;10m[49m                 std::hint::black_box(cf(hc as *mut c_char, hex_maxlen, std::ptr::null(), 0));
[0m[49m[38;5;10m+    180[0m:[38;5;10m[49m             }),
