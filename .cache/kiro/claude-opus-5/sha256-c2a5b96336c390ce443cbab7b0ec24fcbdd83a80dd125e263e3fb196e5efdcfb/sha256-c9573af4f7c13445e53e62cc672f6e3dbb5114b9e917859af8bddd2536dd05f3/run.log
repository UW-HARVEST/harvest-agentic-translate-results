[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m     // The only `hex_maxlen` values that would be accepted for LIMIT-1.
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m     for hm in [usize::MAX - 2, usize::MAX - 1, usize::MAX] {
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m         // These are accepted by the guard; the subsequent loop would write
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m         // ~16 EiB, so we only assert that the *guard* verdict agrees. Both
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m         // implementations must reach the loop and then die the same way
