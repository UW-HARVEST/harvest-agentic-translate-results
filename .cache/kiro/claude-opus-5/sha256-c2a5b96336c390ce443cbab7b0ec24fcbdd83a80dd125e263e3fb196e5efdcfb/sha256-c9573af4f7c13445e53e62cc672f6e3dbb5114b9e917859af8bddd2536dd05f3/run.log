[0m[49m[38;5;10m+    183[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    184[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    185[0m:[38;5;10m[49m             in_child(|| unsafe {
[0m[49m[38;5;10m+    186[0m:[38;5;10m[49m                 std::hint::black_box(rf(hr as *mut c_char, hex_maxlen, std::ptr::null(), 0));
[0m[49m[38;5;10m+    187[0m:[38;5;10m[49m             }),
[0m[49m[38;5;10m+    188[0m:[38;5;10m[49m             Outcome::Exited(0),
