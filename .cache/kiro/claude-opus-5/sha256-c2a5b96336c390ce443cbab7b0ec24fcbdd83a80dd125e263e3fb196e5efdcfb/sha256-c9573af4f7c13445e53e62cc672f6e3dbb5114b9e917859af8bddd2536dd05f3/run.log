[0m[49m[38;5;10m+    219[0m:[38;5;10m[49m /// G5 — one step either side of the `bin_len` range boundary.
[0m[49m[38;5;10m+    220[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    221[0m:[38;5;10m[49m fn g5_bin_len_range_boundary() {
[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m     let (c, r) = both();
[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m     // Exactly at the limit -> rejected by operand 1.
