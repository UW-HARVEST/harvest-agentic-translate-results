[0m[49m[38;5;10m+    191[0m:[38;5;10m[49m         ("trailing junk after last value", b"1 2 1 42 ignored rest"),
[0m[49m[38;5;10m+    192[0m:[38;5;10m[49m         ("newline separated", b"1\n2\n1\n42\n"),
[0m[49m[38;5;10m+    193[0m:[38;5;10m[49m         ("tab separated", b"1\t2\t1\t42"),
[0m[49m[38;5;10m+    194[0m:[38;5;10m[49m         ("crlf separated", b"1\r\n2\r\n1\r\n42\r\n"),
