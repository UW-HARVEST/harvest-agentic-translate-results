[0m[49m[38;5;10m+    179[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    180[0m:[38;5;10m[49m /// Row 13 — source pointer at each misalignment 0..=15.
[0m[49m[38;5;10m+    181[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    182[0m:[38;5;10m[49m fn cfg_row13_source_misalignment() {
[0m[49m[38;5;10m+    183[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0x13);
[0m[49m[38;5;10m+    184[0m:[38;5;10m[49m     // A 16-byte-aligned backing allocation so offsets are true misalignments.
[0m[49m[38;5;10m+    185[0m:[38;5;10m[49m     let layout = std::alloc::Layout::from_size_align(4096, 64).unwrap();
[0m[49m[38;5;10m+    186[0m:[38;5;10m[49m     let base = unsafe { std::alloc::alloc(layout) };
[0m[49m[38;5;10m+    187[0m:[38;5;10m[49m     assert!(!base.is_null());
[0m[49m[38;5;10m+    188[0m:[38;5;10m[49m     for off in 0..=15usize {
[0m[49m[38;5;10m+    189[0m:[38;5;10m[49m         for rep in 0..64 {
[0m[49m[38;5;10m+    190[0m:[38;5;10m[49m             let len = rng.in_range(0, 200);
[0m[49m[38;5;10m+    191[0m:[38;5;10m[49m             let start = unsafe { base.add(off) };
[0m[49m[38;5;10m+    192[0m:[38;5;10m[49m             for i in 0..len {
[0m[49m[38;5;10m+    193[0m:[38;5;10m[49m                 unsafe { *start.add(i) = rng.non_nul_byte() };
[0m[49m[38;5;10m+    194[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    195[0m:[38;5;10m[49m             unsafe { *start.add(len) = 0 };
[0m[49m[38;5;10m+    196[0m:[38;5;10m[49m             let got = assert_same(start as *const c_char, &format!("row13 off={off} len={len} rep={rep}"))
[0m[49m[38;5;10m+    197[0m:[38;5;10m[49m                 .unwrap();
[0m[49m[38;5;10m+    198[0m:[38;5;10m[49m             assert_eq!(got.len(), len + 1);
[0m[49m[38;5;10m+    199[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m     unsafe { std::alloc::dealloc(base, layout) };
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m /// Row 14 — the terminator is the last readable byte before an unmapped guard
[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m /// page. Any read past the NUL would segfault, so surviving this proves neither
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m /// implementation over-reads.
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m fn cfg_row14_guard_page_no_overread() {
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m     let page = unsafe { libc::sysconf(libc::_SC_PAGESIZE) } as usize;
[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0x14);
[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m     for rep in 0..16 {
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m         // Two pages; the second is made unreadable.
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m         let map = unsafe {
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m             libc::mmap(
[0m[49m[38;5;10m+    216[0m:[38;5;10m[49m                 std::ptr::null_mut(),
[0m[49m[38;5;10m+    217[0m:[38;5;10m[49m                 2 * page,
[0m[49m[38;5;10m+    218[0m:[38;5;10m[49m                 libc::PROT_READ | libc::PROT_WRITE,
[0m[49m[38;5;10m+    219[0m:[38;5;10m[49m                 libc::MAP_PRIVATE | libc::MAP_ANONYMOUS,
[0m[49m[38;5;10m+    220[0m:[38;5;10m[49m                 -1,
[0m[49m[38;5;10m+    221[0m:[38;5;10m[49m                 0,
[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m             )
[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m         assert_ne!(map, libc::MAP_FAILED, "mmap failed");
[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m         let base = map as *mut u8;
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m         assert_eq!(unsafe { libc::mprotect(base.add(page) as *mut libc::c_void, page, libc::PROT_NONE) }, 0);
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m         // Content length chosen so the NUL lands on the final readable byte.
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m         let len = rng.in_range(0, page - 1);
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m         let start = unsafe { base.add(page - len - 1) };
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m         for i in 0..len {
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m             unsafe { *start.add(i) = rng.non_nul_byte() };
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m         unsafe { *start.add(len) = 0 }; // last byte of the readable page
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    236[0m:[38;5;10m[49m         let got = assert_same(start as *const c_char, &format!("row14 rep={rep} len={len}")).unwrap();
[0m[49m[38;5;10m+    237[0m:[38;5;10m[49m         assert_eq!(got.len(), len + 1);
[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m         unsafe { libc::munmap(map, 2 * page) };
[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m /// Row 15 — the returned buffer must be releasable with `free`, because the C
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m /// returns `malloc` memory and that is part of the observable ABI. (Every other
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m /// test already frees via `libc::free`; this row hammers it to make an
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m /// allocator mismatch show up as heap corruption / abort.)
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m fn cfg_row15_result_is_free_able() {
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0x15);
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m     for imp in [c_impl(), rust_impl()] {
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m         for rep in 0..2000 {
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m             let len = rng.in_range(0, 300);
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m             let buf = rng.cstring(len);
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m             let p = unsafe { (imp.custom_strdup)(buf.as_ptr() as *const c_char) };
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m             assert!(!p.is_null(), "{} returned NULL for len={len} rep={rep}", imp.name);
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m             let copied = unsafe { std::slice::from_raw_parts(p as *const u8, len + 1) };
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m             assert_eq!(copied, &buf[..], "{} produced a bad copy", imp.name);
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m             unsafe { libc::free(p as *mut libc::c_void) };
[0m[49m[38;5;10m+    259[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    263[0m:[38;5;10m[49m /// Row 16 — the result is an independent copy, not an alias of the input.
[0m[49m[38;5;10m+    264[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    265[0m:[38;5;10m[49m fn cfg_row16_result_is_independent_copy() {
[0m[49m[38;5;10m+    266[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0x16);
[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m     for imp in [c_impl(), rust_impl()] {
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m         for rep in 0..256 {
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m             let len = rng.in_range(1, 128);
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m             let mut buf = rng.cstring(len);
[0m[49m[38;5;10m+    271[0m:[38;5;10m[49m             let original = buf.clone();
[0m[49m[38;5;10m+    272[0m:[38;5;10m[49m             let p = unsafe { (imp.custom_strdup)(buf.as_ptr() as *const c_char) };
[0m[49m[38;5;10m+    273[0m:[38;5;10m[49m             assert!(!p.is_null());
[0m[49m[38;5;10m+    274[0m:[38;5;10m[49m             assert_ne!(p as usize, buf.as_ptr() as usize, "{} aliased the input", imp.name);
[0m[49m[38;5;10m+    275[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m             // Mutating the input must not disturb the copy.
[0m[49m[38;5;10m+    277[0m:[38;5;10m[49m             for b in buf.iter_mut().take(len) {
