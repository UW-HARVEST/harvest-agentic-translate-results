[0m[49m[38;5;10m+    288[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    289[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    290[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    291[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    292[0m:[38;5;10m[49m /// Row 17 — many simultaneously live results; no shared scratch buffer.
[0m[49m[38;5;10m+    293[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    294[0m:[38;5;10m[49m fn cfg_row17_many_live_results() {
[0m[49m[38;5;10m+    295[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0x17);
[0m[49m[38;5;10m+    296[0m:[38;5;10m[49m     let mut inputs: Vec<Vec<u8>> = Vec::new();
[0m[49m[38;5;10m+    297[0m:[38;5;10m[49m     for i in 0..256usize {
[0m[49m[38;5;10m+    298[0m:[38;5;10m[49m         let mut v = rng.cstring(rng.in_range(1, 64));
[0m[49m[38;5;10m+    299[0m:[38;5;10m[49m         // Make each input unique by stamping the index into the first bytes.
[0m[49m[38;5;10m+    300[0m:[38;5;10m[49m         v[0] = (i % 255) as u8 + 1;
[0m[49m[38;5;10m+    301[0m:[38;5;10m[49m         inputs.push(v);
[0m[49m[38;5;10m+    302[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    303[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    304[0m:[38;5;10m[49m     for imp in [c_impl(), rust_impl()] {
[0m[49m[38;5;10m+    305[0m:[38;5;10m[49m         let mut live: Vec<*mut c_char> = Vec::new();
[0m[49m[38;5;10m+    306[0m:[38;5;10m[49m         for inp in &inputs {
[0m[49m[38;5;10m+    307[0m:[38;5;10m[49m             let p = unsafe { (imp.custom_strdup)(inp.as_ptr() as *const c_char) };
[0m[49m[38;5;10m+    308[0m:[38;5;10m[49m             assert!(!p.is_null());
[0m[49m[38;5;10m+    309[0m:[38;5;10m[49m             live.push(p);
[0m[49m[38;5;10m+    310[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    311[0m:[38;5;10m[49m         // All 256 results must be distinct pointers and still hold their data.
[0m[49m[38;5;10m+    312[0m:[38;5;10m[49m         let mut seen: Vec<usize> = live.iter().map(|p| *p as usize).collect();
[0m[49m[38;5;10m+    313[0m:[38;5;10m[49m         seen.sort_unstable();
[0m[49m[38;5;10m+    314[0m:[38;5;10m[49m         let before = seen.len();
[0m[49m[38;5;10m+    315[0m:[38;5;10m[49m         seen.dedup();
[0m[49m[38;5;10m+    316[0m:[38;5;10m[49m         assert_eq!(before, seen.len(), "{} returned duplicate pointers", imp.name);
[0m[49m[38;5;10m+    317[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    318[0m:[38;5;10m[49m         for (inp, p) in inputs.iter().zip(live.iter()) {
[0m[49m[38;5;10m+    319[0m:[38;5;10m[49m             let n = inp.len();
[0m[49m[38;5;10m+    320[0m:[38;5;10m[49m             let copied = unsafe { std::slice::from_raw_parts(*p as *const u8, n) };
[0m[49m[38;5;10m+    321[0m:[38;5;10m[49m             assert_eq!(copied, &inp[..], "{} clobbered an earlier result", imp.name);
[0m[49m[38;5;10m+    322[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    323[0m:[38;5;10m[49m         for p in live {
[0m[49m[38;5;10m+    324[0m:[38;5;10m[49m             unsafe { libc::free(p as *mut libc::c_void) };
[0m[49m[38;5;10m+    325[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    326[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    327[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    328[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    329[0m:[38;5;10m[49m /// Row 18 — concurrent calls from 8 threads (reentrancy).
[0m[49m[38;5;10m+    330[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    331[0m:[38;5;10m[49m fn cfg_row18_concurrent_calls() {
[0m[49m[38;5;10m+    332[0m:[38;5;10m[49m     let c = c_impl();
[0m[49m[38;5;10m+    333[0m:[38;5;10m[49m     let r = rust_impl();
[0m[49m[38;5;10m+    334[0m:[38;5;10m[49m     let mut handles = Vec::new();
[0m[49m[38;5;10m+    335[0m:[38;5;10m[49m     for t in 0..8u64 {
[0m[49m[38;5;10m+    336[0m:[38;5;10m[49m         handles.push(std::thread::spawn(move || {
[0m[49m[38;5;10m+    337[0m:[38;5;10m[49m             let mut rng = Rng::new(SEED ^ 0x18 ^ (t << 32));
[0m[49m[38;5;10m+    338[0m:[38;5;10m[49m             for rep in 0..2000 {
[0m[49m[38;5;10m+    339[0m:[38;5;10m[49m                 let len = rng.in_range(0, 256);
[0m[49m[38;5;10m+    340[0m:[38;5;10m[49m                 let buf = rng.cstring(len);
[0m[49m[38;5;10m+    341[0m:[38;5;10m[49m                 for imp in [c, r] {
[0m[49m[38;5;10m+    342[0m:[38;5;10m[49m                     let p = unsafe { (imp.custom_strdup)(buf.as_ptr() as *const c_char) };
[0m[49m[38;5;10m+    343[0m:[38;5;10m[49m                     assert!(!p.is_null(), "{} NULL in thread {t} rep {rep}", imp.name);
[0m[49m[38;5;10m+    344[0m:[38;5;10m[49m                     let copied = unsafe { std::slice::from_raw_parts(p as *const u8, len + 1) };
[0m[49m[38;5;10m+    345[0m:[38;5;10m[49m                     assert_eq!(copied, &buf[..], "{} bad copy in thread {t} rep {rep}", imp.name);
[0m[49m[38;5;10m+    346[0m:[38;5;10m[49m                     unsafe { libc::free(p as *mut libc::c_void) };
[0m[49m[38;5;10m+    347[0m:[38;5;10m[49m                 }
[0m[49m[38;5;10m+    348[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    349[0m:[38;5;10m[49m         }));
[0m[49m[38;5;10m+    350[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    351[0m:[38;5;10m[49m     for h in handles {
[0m[49m[38;5;10m+    352[0m:[38;5;10m[49m         h.join().expect("thread panicked");
[0m[49m[38;5;10m+    353[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    354[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    355[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    356[0m:[38;5;10m[49m /// Row 19 — unrestricted seeded property sweep mixing every axis, including
