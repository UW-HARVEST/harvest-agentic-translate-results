[0m[49m[38;5;10m+    175[0m:[38;5;10m[49m         let got = assert_same_bytes(&buf, &format!("row12 rep={rep}")).unwrap();
[0m[49m[38;5;10m+    176[0m:[38;5;10m[49m         assert_eq!(got, vec![0u8], "row12: must copy exactly one NUL byte");
[0m[49m[38;5;10m+    177[0m:[38;5;10m[49m     }
