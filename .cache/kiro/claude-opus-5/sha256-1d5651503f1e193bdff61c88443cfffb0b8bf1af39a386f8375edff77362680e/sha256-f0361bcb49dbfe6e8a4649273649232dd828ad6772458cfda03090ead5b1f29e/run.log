[0m[49m[38;5;10m+    279[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    280[0m:[38;5;10m[49m             let copied = unsafe { std::slice::from_raw_parts(p as *const u8, len + 1) };
[0m[49m[38;5;10m+    281[0m:[38;5;10m[49m             assert_eq!(copied, &original[..], "{} copy changed when input changed (rep={rep})", imp.name);
[0m[49m[38;5;10m+    282[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    283[0m:[38;5;10m[49m             // Mutating the copy must not disturb the input.
[0m[49m[38;5;10m+    284[0m:[38;5;10m[49m             unsafe { *(p as *mut u8) = 0x21 };
[0m[49m[38;5;10m+    285[0m:[38;5;10m[49m             assert_eq!(buf[0], 0x7E, "{} input changed when copy changed", imp.name);
[0m[49m[38;5;10m+    286[0m:[38;5;10m[49m 
