[0m[49m[38;5;10m+    491[0m:[38;5;10m[49m         codes
[0m[49m[38;5;10m+    492[0m:[38;5;10m[49m     };
[0m[49m[38;5;10m+    493[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    494[0m:[38;5;10m[49m     let (c, r) = both();
[0m[49m[38;5;10m+    495[0m:[38;5;10m[49m     let (cc, ccap) = capture(|| run(c));
[0m[49m[38;5;10m+    496[0m:[38;5;10m[49m     let (rc, rcap) = capture(|| run(r));
