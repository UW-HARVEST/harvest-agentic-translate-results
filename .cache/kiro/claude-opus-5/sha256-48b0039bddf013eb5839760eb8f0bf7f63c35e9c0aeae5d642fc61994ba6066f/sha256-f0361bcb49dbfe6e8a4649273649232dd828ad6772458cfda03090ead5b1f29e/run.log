     1	//! Rust translation of `c_src/src/lib.c` (minimp3-style synthesis helper).
     2	//!
     3	//! The C library globs `src/lib.c` into a single shared object whose only
     4	//! exported public symbol is `synth_pair` (verified with `nm -D`). The header
     5	//! `include/lib.h` defines no namespace-renaming macros, so the linker symbol
     6	//! matches the source-level name exactly.
     7	//!
     8	//! Behaviour is reproduced bit-for-bit, including the C code's rounding /
     9	//! clipping quirks; no "bug fixes" are applied.
    10	
    11	#![allow(non_snake_case)]
    12	
    13	use std::ffi::c_int;
    14	
    15	/// `typedef int16_t mp3d_sample_t;` from `include/lib.h`.
    16	pub type Mp3dSampleT = i16;
    17	
    18	/// Faithful port of the file-local (`static`) helper:
    19	///
    20	/// ```c
    21	/// static int16_t mp3d_scale_pcm(float sample) {
    22	///     if (sample >= 32766.5)  return (int16_t)32767;
    23	///     if (sample <= -32767.5) return (int16_t)-32768;
    24	///     int16_t s = (int16_t)(sample + .5f);
    25	///     s -= (s < 0);
    26	///     return s;
    27	/// }
    28	/// ```
    29	///
    30	/// Notes on exact-semantics preservation:
    31	/// * The two literals `32766.5` / `-32767.5` are `double` in C, so the `float`
    32	///   operand is promoted to `double` before the comparison. Both constants are
    33	///   exactly representable in either format, but the promotion is mirrored
    34	///   anyway.
    35	/// * `sample + .5f` is a single-precision addition (the literal is `float`).
    36	/// * The C cast truncates toward zero into `int` and then narrows to
    37	///   `int16_t`; `as i32 as i16` reproduces that, including the x86-64 NaN case
    38	///   (`cvttss2si` -> `0x8000_0000`, whose low 16 bits are `0`).
    39	/// * `s -= (s < 0)` is performed on the promoted `int` and stored back into an
    40	///   `int16_t`; `wrapping_sub` matches GCC's narrowing behaviour.
    41	#[inline]
    42	fn mp3d_scale_pcm(sample: f32) -> i16 {
    43	    if f64::from(sample) >= 32766.5 {
    44	        return 32767i16;
    45	    }
    46	    if f64::from(sample) <= -32767.5 {
    47	        return -32768i16;
    48	    }
    49	    let s = (sample + 0.5f32) as i32 as i16;
    50	    s.wrapping_sub(i16::from(s < 0))
    51	}
    52	
    53	/// Faithful port of the single public entry point:
    54	///
    55	/// ```c
    56	/// void synth_pair(mp3d_sample_t *pcm, int nch, const float *z);
    57	/// ```
    58	///
    59	/// The accumulation order, the mixed add/subtract pairings and the integer
    60	/// coefficients (all exactly representable in `f32`) are preserved verbatim so
    61	/// that the emitted single-precision rounding sequence is identical.
    62	///
    63	/// # Safety
    64	///
    65	/// Same contract as the C function: `pcm` must be writable at offsets `0` and
    66	/// `16 * nch`, and `z` must be readable for the strided taps used below
    67	/// (`z[0 ..= 14 * 64]` and, after the `z += 2` advance, `z[2 ..= 2 + 14 * 64]`).
    68	#[unsafe(no_mangle)]
    69	pub unsafe extern "C" fn synth_pair(pcm: *mut Mp3dSampleT, nch: c_int, z: *const f32) {
    70	    // `z[i * 64]` in the first block.
    71	    let tap = |i: usize| -> f32 { unsafe { *z.add(i * 64) } };
    72	
    73	    let mut a: f32;
    74	    a = (tap(14) - tap(0)) * 29.0f32;
    75	    a += (tap(1) + tap(13)) * 213.0f32;
    76	    a += (tap(12) - tap(2)) * 459.0f32;
    77	    a += (tap(3) + tap(11)) * 2037.0f32;
    78	    a += (tap(10) - tap(4)) * 5153.0f32;
    79	    a += (tap(5) + tap(9)) * 6574.0f32;
    80	    a += (tap(8) - tap(6)) * 37489.0f32;
    81	    a += tap(7) * 75038.0f32;
    82	    unsafe { *pcm.add(0) = mp3d_scale_pcm(a) };
    83	
    84	    // `z += 2;` -- every subsequent tap is shifted by two floats.
    85	    let tap2 = |i: usize| -> f32 { unsafe { *z.add(2 + i * 64) } };
    86	
    87	    a = tap2(14) * 104.0f32;
    88	    a += tap2(12) * 1567.0f32;
    89	    a += tap2(10) * 9727.0f32;
    90	    a += tap2(8) * 64019.0f32;
    91	    a += tap2(6) * -9975.0f32;
    92	    a += tap2(4) * -45.0f32;
    93	    a += tap2(2) * 146.0f32;
    94	    a += tap2(0) * -5.0f32;
    95	    // `pcm[16 * nch]` -- signed index, reproduced with `offset` so that a
    96	    // negative `nch` behaves like the C pointer arithmetic rather than
    97	    // wrapping through `usize`.
    98	    unsafe { *pcm.offset(16isize * nch as isize) = mp3d_scale_pcm(a) };
    99	}
