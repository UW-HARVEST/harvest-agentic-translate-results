[0m[49m[38;5;10m+     43[0m:[38;5;10m[49m         "C driver({x},{y},{b},{z}) printed {:?}, masking rule says {:?}",
[0m[49m[38;5;10m+     44[0m:[38;5;10m[49m         String::from_utf8_lossy(&c_out),
[0m[49m[38;5;10m+     45[0m:[38;5;10m[49m         String::from_utf8_lossy(&want)
[0m[49m[38;5;10m+     46[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+     47[0m:[38;5;10m[49m     assert_eq!(
[0m[49m[38;5;10m+     48[0m:[38;5;10m[49m         c_out,
[0m[49m[38;5;10m+     49[0m:[38;5;10m[49m         r_out,
[0m[49m[38;5;10m+     50[0m:[38;5;10m[49m         "driver({x},{y},{b},{z}): C {:?} vs Rust {:?}",
[0m[49m[38;5;10m+     51[0m:[38;5;10m[49m         String::from_utf8_lossy(&c_out),
[0m[49m[38;5;10m+     52[0m:[38;5;10m[49m         String::from_utf8_lossy(&r_out)
[0m[49m[38;5;10m+     53[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+     54[0m:[38;5;10m[49m }
