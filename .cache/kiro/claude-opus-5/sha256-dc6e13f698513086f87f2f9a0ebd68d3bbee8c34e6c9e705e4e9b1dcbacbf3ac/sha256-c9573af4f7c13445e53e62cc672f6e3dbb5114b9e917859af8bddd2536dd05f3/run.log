[0m[49m[38;5;10m+      5[0m:[38;5;10m[49m //!
[0m[49m[38;5;10m+      6[0m:[38;5;10m[49m //! The C library has no error *returns* (both functions are `void`), so
[0m[49m[38;5;10m+      7[0m:[38;5;10m[49m //! "returns the same error/rejection" means one of two concrete things,
[0m[49m[38;5;10m+      8[0m:[38;5;10m[49m //! depending on the row:
[0m[49m[38;5;10m+      9[0m:[38;5;10m[49m //!
[0m[49m[38;5;10m+     10[0m:[38;5;10m[49m //! * an **implicit rejection**: the invalid input is silently masked, and the
[0m[49m[38;5;10m+     11[0m:[38;5;10m[49m //!   observable rejection is the exact byte string printed. Asserting the two
[0m[49m[38;5;10m+     12[0m:[38;5;10m[49m //!   libraries print the same bytes is asserting they reject identically. Each
[0m[49m[38;5;10m+     13[0m:[38;5;10m[49m //!   such test additionally pins the *expected* C behaviour independently (the
[0m[49m[38;5;10m+     14[0m:[38;5;10m[49m //!   masking rule read off `objdump`), so a test cannot pass by both sides
[0m[49m[38;5;10m+     15[0m:[38;5;10m[49m //!   being wrong in the same way.
[0m[49m[38;5;10m+     16[0m:[38;5;10m[49m //! * a **fatal rejection**: the process dies. Asserted as an identical
[0m[49m[38;5;10m+     17[0m:[38;5;10m[49m //!   termination signal, observed in a forked child so the runner survives.
[0m[49m[38;5;10m+     18[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     19[0m:[38;5;10m[49m mod common;
[0m[49m[38;5;10m+     20[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     21[0m:[38;5;10m[49m use common::*;
[0m[49m[38;5;10m+     22[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     23[0m:[38;5;10m[49m const SEED: u64 = 0xE770_0000_0BAD_0001;
[0m[49m[38;5;10m+     24[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     25[0m:[38;5;10m[49m fn libs() -> Libs {
[0m[49m[38;5;10m+     26[0m:[38;5;10m[49m     Libs::load()
[0m[49m[38;5;10m+     27[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     28[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     29[0m:[38;5;10m[49m /// The byte string the C is *specified* (by its compiled masking) to print.
[0m[49m[38;5;10m+     30[0m:[38;5;10m[49m fn expected_line(x: u32, y: u32, b: u8, z: i32) -> Vec<u8> {
[0m[49m[38;5;10m+     31[0m:[38;5;10m[49m     format!("{} {} {} {}\n", x & 3, y & 7, b & 1, z).into_bytes()
[0m[49m[38;5;10m+     32[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     33[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     34[0m:[38;5;10m[49m /// Run `driver` in both libraries and additionally check the output against the
[0m[49m[38;5;10m+     35[0m:[38;5;10m[49m /// independently-derived expected line, so a shared bug cannot hide.
[0m[49m[38;5;10m+     36[0m:[38;5;10m[49m #[track_caller]
[0m[49m[38;5;10m+     37[0m:[38;5;10m[49m fn check_driver(l: &Libs, x: u32, y: u32, b: u8, z: i32) {
[0m[49m[38;5;10m+     38[0m:[38;5;10m[49m     let (c_out, r_out) = diff_driver(l, x, y, b, z);
[0m[49m[38;5;10m+     39[0m:[38;5;10m[49m     let want = expected_line(x, y, b, z);
[0m[49m[38;5;10m+     40[0m:[38;5;10m[49m     assert_eq!(
[0m[49m[38;5;10m+     41[0m:[38;5;10m[49m         c_out,
