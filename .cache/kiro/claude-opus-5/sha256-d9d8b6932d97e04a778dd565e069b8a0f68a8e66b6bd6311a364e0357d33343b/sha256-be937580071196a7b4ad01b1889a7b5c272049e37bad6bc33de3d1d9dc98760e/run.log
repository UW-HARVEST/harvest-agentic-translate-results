    28	int main(int argc, char **argv) {
    29	    if (argc < 3) {
    30	        fprintf(stderr, "usage: %s A B\n", argv[0]);
    31	        return 2;
    32	    }
    33	    int a = atoi(argv[1]);
    34	    int b = atoi(argv[2]);
    35	
    36	    int r_call = (OP_FN(OP))(a, b);
    37	    int acc = INIT_FOR(OP);
    38	    RUN_LOOP(OP, acc, REPEAT);
    39	
    40	    int x1 = helper_call(a, b);
    41	    int x2 = helper_ptr(a, b);
    42	    int x3 = use_generated(REPEAT);
    43	    int g  = G_OP(a, b);
    44	
    45	    printf("op=%s call=%d acc=%d g.call=%d\n", G_OP_NAME, r_call, acc, g);
    46	    printf("summary=%d\n", r_call + acc + x1 + x2 + x3 + g);
    47	    return 0;
    48	}
