   176	// ---------------------------------------------------------------------------
   177	// REP0 .. REP7 unrolling
   178	// ---------------------------------------------------------------------------
   179	
   180	/// `REP<n>(op, acc)` for `n` in `0..=7`.
   181	///
   182	/// The C macros chain: `REP3` expands to `REP2` plus `STEP_OP(op, acc, 2)`, so
   183	/// `REP<n>` applies `STEP_OP` once for each `i` in `0..n` with the literal index
   184	/// baked in. A counted loop produces exactly the same sequence of accumulator
   185	/// values; the C version is unrolled only because the preprocessor cannot
   186	/// generate a loop bound from a token.
   187	#[inline]
   188	pub fn rep(mut acc: c_int, n: c_int) -> c_int {
   189	    let mut i: c_int = 0;
   190	    while i < n {
   191	        acc = step(acc, i);
   192	        i = i.wrapping_add(1);
   193	    }
   194	    acc
   195	}
   196	
   197	/// `RUN_LOOP(OP, acc, REPEAT)` -- `CHOOSE_REP(REPEAT)(OP, acc)`.
   198	#[inline]
   199	pub fn run_loop(acc: c_int) -> c_int {
   200	    rep(acc, REPEAT)
   201	}
   202	
   203	/// `DISPATCH_REP(op, acc, n)`: a `switch (n)` covering only cases 0 through 6.
   204	///
   205	/// The `default:` arm is an empty `break`, so any other `n` -- including 7, and
   206	/// including negatives -- leaves the accumulator at its initial value. This is a
   207	/// real asymmetry in the C header (`REP7` exists but the switch stops at 6) and
   208	/// is reproduced verbatim: with `-DREPEAT=7`, `use_generated(REPEAT)` reports
   209	/// just `INIT_FOR(OP)`.
   210	#[inline]
   211	pub fn dispatch_rep(acc: c_int, n: c_int) -> c_int {
   212	    match n {
   213	        0 => rep(acc, 0),
   214	        1 => rep(acc, 1),
   215	        2 => rep(acc, 2),
   216	        3 => rep(acc, 3),
   217	        4 => rep(acc, 4),
   218	        5 => rep(acc, 5),
   219	        6 => rep(acc, 6),
   220	        _ => acc,
   221	    }
   222	}
   223	
   224	/// `FOR_EACH`/`DO_LOOP`: the runtime-bounded variant of the unrolling.
   225	///
   226	/// Defined in the header but never instantiated by `mdcore.c` or `mdmain.c`;
   227	/// carried over for completeness so the translated header exposes the same
   228	/// surface.
   229	#[inline]
   230	#[allow(dead_code)]
   231	pub fn do_loop(acc: c_int, n: c_int) -> c_int {
   232	    rep(acc, n)
   233	}
