    24	#ifndef MD_MACROS_H
    25	#define MD_MACROS_H
    26	
    27	#ifndef OP
    28	#  define OP add
    29	#endif
    30	#ifndef REPEAT
    31	#  define REPEAT 5
    32	#endif
    33	
    34	#define STR1(x) #x
    35	#define STR(x)  STR1(x)
    36	#define CAT1(a,b) a##b
    37	#define CAT(a,b)  CAT1(a,b)
    38	
    39	/* ---------- Operation family prototypes (defined in md_core.c) ---------- */
    40	extern int op_add(int a, int b);
    41	extern int op_sub(int a, int b);
    42	extern int op_mul(int a, int b);
    43	
    44	/* Choose function by building the identifier: op_<OP> */
    45	#define OP_FN(op) CAT(op_, op)
    46	
    47	/* Step macros (selected via token-paste) */
    48	#define STEP_add(acc, i) ((acc) += (i))
    49	#define STEP_sub(acc, i) ((acc) -= (i))
    50	#define STEP_mul(acc, i) ((acc) *= ((i) + 1))
    51	
    52	#define STEP_OP_I(op, acc, i) CAT(STEP_, op)(acc, (i))
    53	#define STEP_OP(op, acc, i)   STEP_OP_I(op, acc, (i))
    54	
    55	/* Initial accumulator per op (token-paste) */
    56	#define INIT_add 0
    57	#define INIT_sub 0
    58	#define INIT_mul 1
    59	#define INIT_FOR(op) CAT(INIT_, op)
    60	
    61	/* ---- REPEAT-based manual unrolling ---- */
    62	
    63	#define REP0(op, acc)        /* nothing */
    64	#define REP1(op, acc)        STEP_OP(op, acc, 0);
    65	#define REP2(op, acc)        REP1(op, acc) STEP_OP(op, acc, 1);
    66	#define REP3(op, acc)        REP2(op, acc) STEP_OP(op, acc, 2);
    67	#define REP4(op, acc)        REP3(op, acc) STEP_OP(op, acc, 3);
    68	#define REP5(op, acc)        REP4(op, acc) STEP_OP(op, acc, 4);
    69	#define REP6(op, acc)        REP5(op, acc) STEP_OP(op, acc, 5);
    70	#define REP7(op, acc)        REP6(op, acc) STEP_OP(op, acc, 6);
    71	
    72	/* Choose the REPn that matches REPEAT. */
    73	#define CHOOSE_REP_I(n)      CAT(REP, n)
    74	#define CHOOSE_REP(n)        CHOOSE_REP_I(n)
    75	
    76	/* Loop macro expands into a real for-statement (Stmt comes from macros) */
    77	#define FOR_EACH(n, body) for (int i = 0; i < (n); ++i) body
    78	#define DO_LOOP(op, acc, n) FOR_EACH((n), { STEP_OP(op, acc, i); })
    79	#define RUN_LOOP(op, acc, n) CHOOSE_REP(n)(op, acc)
    80	
    81	/* Macro-generated accumulator function: accum_<OP>(n) */
    82	#define DISPATCH_REP(op, acc, n) do { \
    83	  switch (n) { \
    84	    case 0: REP0(op, acc);  break; \
    85	    case 1: REP1(op, acc);  break; \
    86	    case 2: REP2(op, acc);  break; \
    87	    case 3: REP3(op, acc);  break; \
    88	    case 4: REP4(op, acc);  break; \
    89	    case 5: REP5(op, acc);  break; \
    90	    case 6: REP6(op, acc);  break; \
    91	    default: break; \
    92	  } \
    93	} while(0)
    94	
    95	#define DEFINE_ACCUM(op) \
    96	  static int CAT(accum_, op)(int n) { \
    97	    int acc = INIT_FOR(op); \
    98	    DISPATCH_REP(op, acc, n); \
    99	    return acc; \
   100	  }
