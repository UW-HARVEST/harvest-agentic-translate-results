    24	//! Rust translation of `src/mdcore.c`.
    25	//!
    26	//! `mdmacros.h` declares no namespace/renaming macros, so every exported symbol
    27	//! keeps its source-level spelling: `op_add`, `op_sub`, `op_mul`, `G_OP`,
    28	//! `G_OP_NAME`, `helper_call`, `helper_ptr`, `use_generated`. `accum_<OP>`
    29	//! is `static` in C (via `DEFINE_ACCUM`) and stays private here.
    30	
    31	use core::ffi::{c_char, c_int};
    32	
    33	use crate::mdmacros::{dispatch_rep, run_loop, INIT, OP_FN, OP_NAME_C};
    34	
    35	// ---------------------------------------------------------------------------
    36	// Define operations
    37	// ---------------------------------------------------------------------------
    38	
    39	/// `int op_add(int a, int b) { return a + b; }`
    40	#[unsafe(no_mangle)]
    41	pub extern "C" fn op_add(a: c_int, b: c_int) -> c_int {
    42	    a.wrapping_add(b)
    43	}
    44	
    45	/// `int op_sub(int a, int b) { return a - b; }`
    46	#[unsafe(no_mangle)]
    47	pub extern "C" fn op_sub(a: c_int, b: c_int) -> c_int {
    48	    a.wrapping_sub(b)
    49	}
    50	
    51	/// `int op_mul(int a, int b) { return a * b; }`
    52	#[unsafe(no_mangle)]
    53	pub extern "C" fn op_mul(a: c_int, b: c_int) -> c_int {
    54	    a.wrapping_mul(b)
    55	}
    56	
    57	// ---------------------------------------------------------------------------
    58	// DEFINE_ACCUM(OP)  ->  static int accum_<OP>(int n)
    59	// ---------------------------------------------------------------------------
    60	
    61	/// `static int accum_<OP>(int n) { int acc = INIT_FOR(OP); DISPATCH_REP(OP, acc, n); return acc; }`
    62	fn accum(n: c_int) -> c_int {
    63	    let acc: c_int = INIT;
    64	    dispatch_rep(acc, n)
    65	}
    66	
    67	// ---------------------------------------------------------------------------
    68	// Global macro uses at file scope
    69	// ---------------------------------------------------------------------------
    70	
    71	/// Storage backing `G_OP_NAME`, standing in for the string literal that
    72	/// `STR(OP)` expands to.
    73	static OP_NAME_STORAGE: [u8; 4] = *OP_NAME_C;
    74	
    75	/// `const char *` in a `static`: a bare raw pointer is not `Sync`, so it is
    76	/// wrapped in a `repr(transparent)` newtype. The exported symbol is still a
    77	/// single pointer-sized slot holding the address of the name, identical to what
    78	/// the C compiler emits for `const char *G_OP_NAME = STR(OP);`.
    79	#[repr(transparent)]
    80	pub struct CStrPtr(pub *const c_char);
    81	
    82	// SAFETY: the pointer targets `OP_NAME_STORAGE`, an immutable `static` that
    83	// lives for the whole program and is never written, so sharing it across threads
    84	// is sound. C exposes the same global with no synchronization at all.
    85	unsafe impl Sync for CStrPtr {}
    86	
    87	/// `int (*G_OP)(int,int) = OP_FN(OP);`
    88	///
    89	/// Mutable to match the non-`const` C global; nothing in the program writes it.
    90	#[unsafe(no_mangle)]
    91	pub static mut G_OP: extern "C" fn(c_int, c_int) -> c_int = OP_FN;
    92	
    93	/// `const char *G_OP_NAME = STR(OP);`
    94	#[unsafe(no_mangle)]
    95	pub static G_OP_NAME: CStrPtr = CStrPtr(&OP_NAME_STORAGE as *const [u8; 4] as *const c_char);
    96	
    97	// ---------------------------------------------------------------------------
    98	// Helpers
    99	// ---------------------------------------------------------------------------
   100	
   101	/// ```c
   102	/// int helper_call(int a, int b) {
   103	///     int r = (OP_FN(OP))(a, b);
   104	///     int acc = INIT_FOR(OP);
   105	///     RUN_LOOP(OP, acc, REPEAT);
   106	///     printf("helper.call=%d helper.acc=%d\n", r, acc);
   107	///     return r + acc;
   108	/// }
   109	/// ```
   110	#[unsafe(no_mangle)]
   111	pub extern "C" fn helper_call(a: c_int, b: c_int) -> c_int {
   112	    let r = OP_FN(a, b);
   113	    let acc = run_loop(INIT);
   114	    crate::stdio::print_str(&format!("helper.call={} helper.acc={}\n", r, acc));
   115	    r.wrapping_add(acc)
   116	}
   117	
   118	/// ```c
   119	/// int helper_ptr(int a, int b) {
   120	///     int (*fp)(int,int) = OP_FN(OP);
   121	///     int r = fp(a, b);
   122	///     printf("helper.ptr=%d\n", r);
   123	///     return r;
   124	/// }
   125	/// ```
   126	#[unsafe(no_mangle)]
   127	pub extern "C" fn helper_ptr(a: c_int, b: c_int) -> c_int {
   128	    let fp: extern "C" fn(c_int, c_int) -> c_int = OP_FN;
   129	    let r = fp(a, b);
   130	    crate::stdio::print_str(&format!("helper.ptr={}\n", r));
   131	    r
   132	}
   133	
   134	/// ```c
   135	/// int use_generated(int n) {
   136	///     int r = (ACCUM_FN(OP))(n);
   137	///     printf("gen.acc=%d\n", r);
   138	///     return r;
   139	/// }
   140	/// ```
   141	#[unsafe(no_mangle)]
   142	pub extern "C" fn use_generated(n: c_int) -> c_int {
   143	    let r = accum(n);
   144	    crate::stdio::print_str(&format!("gen.acc={}\n", r));
   145	    r
   146	}
   147	
   148	/// Reads `G_OP` the way `mdmain.c` does (`int g = G_OP(a, b);`).
   149	///
   150	/// Exists so the driver can go through the global without an `unsafe` block of
   151	/// its own; the `static mut` read is confined here.
   152	#[inline]
   153	pub fn g_op() -> extern "C" fn(c_int, c_int) -> c_int {
   154	    // SAFETY: `G_OP` is initialized at load time and never mutated, so this read
   155	    // cannot observe a torn or uninitialized value.
   156	    unsafe { G_OP }
   157	}
   158	
   159	/// Borrows `G_OP_NAME` as bytes for `%s` formatting.
   160	#[inline]
   161	pub fn g_op_name_bytes() -> &'static [u8] {
   162	    &OP_NAME_STORAGE[..OP_NAME_STORAGE.len() - 1]
   163	}
