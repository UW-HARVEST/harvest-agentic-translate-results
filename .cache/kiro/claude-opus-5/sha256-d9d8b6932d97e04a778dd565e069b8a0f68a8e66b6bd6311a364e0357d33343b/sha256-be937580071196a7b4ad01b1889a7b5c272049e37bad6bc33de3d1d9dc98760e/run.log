    23	
    24	//! Rust translation of `src/mdmacros.h`.
    25	//!
    26	//! The C header does all of its work in the preprocessor: token pasting picks
    27	//! an `op_<OP>` function, a `STEP_<OP>` expression, an `INIT_<OP>` seed, and a
    28	//! `REP<REPEAT>` manual unrolling. None of that survives into the object file,
    29	//! so the Rust equivalent resolves the same choices at compile time with
    30	//! `#[cfg(feature = ...)]` and `const`.
    31	//!
    32	//! Feature -> CMake mapping:
    33	//!   `add` / `sub` / `mul`  <=>  `-DOP=add|sub|mul`
    34	//!   `0` ..= `7`            <=>  `-DREPEAT=0..7`
    35	//!
    36	//! `REPEAT` is bounded by 0..=7 in C as well: `RUN_LOOP` expands to
    37	//! `CHOOSE_REP(REPEAT)`, i.e. `REP<REPEAT>`, and the header only defines
    38	//! `REP0` through `REP7`.
    39	
    40	use core::ffi::c_int;
    41	
    42	// ---------------------------------------------------------------------------
    43	// OP selection  (`#define OP add` / `-DOP=...`)
    44	// ---------------------------------------------------------------------------
    45	//
    46	// Precedence is mul > sub > add so that enabling a non-default OP feature wins
    47	// over the `add` that arrives with `default`. Absence of every OP feature falls
    48	// back to `add`, matching the header's `#ifndef OP / #define OP add`.
    49	
    50	/// `STR(OP)` -- the operation name as a NUL-terminated C string body.
    51	///
    52	/// All three names are three bytes, so one fixed-size array serves every
    53	/// configuration.
    54	#[cfg(feature = "mul")]
    55	pub const OP_NAME_C: &[u8; 4] = b"mul\0";
    56	#[cfg(all(feature = "sub", not(feature = "mul")))]
    57	pub const OP_NAME_C: &[u8; 4] = b"sub\0";
    58	#[cfg(all(not(feature = "sub"), not(feature = "mul")))]
    59	pub const OP_NAME_C: &[u8; 4] = b"add\0";
    60	
    61	/// `INIT_FOR(OP)`: `INIT_add`/`INIT_sub` are 0, `INIT_mul` is 1.
    62	#[cfg(feature = "mul")]
    63	pub const INIT: c_int = 1;
    64	#[cfg(not(feature = "mul"))]
    65	pub const INIT: c_int = 0;
    66	
    67	/// `OP_FN(OP)` -- `CAT(op_, OP)`, the selected operation function.
    68	///
    69	/// Kept as an `extern "C" fn` value so that both the direct call in
    70	/// `helper_call`, the local function pointer in `helper_ptr`, and the `G_OP`
    71	/// global all refer to the very same exported symbol, as in C.
    72	#[cfg(feature = "mul")]
    73	pub const OP_FN: extern "C" fn(c_int, c_int) -> c_int = crate::mdcore::op_mul;
    74	#[cfg(all(feature = "sub", not(feature = "mul")))]
    75	pub const OP_FN: extern "C" fn(c_int, c_int) -> c_int = crate::mdcore::op_sub;
    76	#[cfg(all(not(feature = "sub"), not(feature = "mul")))]
    77	pub const OP_FN: extern "C" fn(c_int, c_int) -> c_int = crate::mdcore::op_add;
    78	
    79	// ---------------------------------------------------------------------------
    80	// STEP_OP(op, acc, i)
    81	// ---------------------------------------------------------------------------
    82	//
    83	//   #define STEP_add(acc, i) ((acc) += (i))
    84	//   #define STEP_sub(acc, i) ((acc) -= (i))
    85	//   #define STEP_mul(acc, i) ((acc) *= ((i) + 1))
    86	//
    87	// Signed overflow is undefined in C but wraps in practice on the platforms this
    88	// builds for (gcc/clang two's complement). `wrapping_*` reproduces that without
    89	// panicking in debug builds.
    90	
    91	/// One `STEP_mul` application.
    92	#[cfg(feature = "mul")]
    93	#[inline]
    94	pub fn step(acc: c_int, i: c_int) -> c_int {
    95	    acc.wrapping_mul(i.wrapping_add(1))
    96	}
    97	
    98	/// One `STEP_sub` application.
    99	#[cfg(all(feature = "sub", not(feature = "mul")))]
   100	#[inline]
   101	pub fn step(acc: c_int, i: c_int) -> c_int {
   102	    acc.wrapping_sub(i)
   103	}
   104	
   105	/// One `STEP_add` application.
   106	#[cfg(all(not(feature = "sub"), not(feature = "mul")))]
   107	#[inline]
   108	pub fn step(acc: c_int, i: c_int) -> c_int {
   109	    acc.wrapping_add(i)
   110	}
   111	
   112	// ---------------------------------------------------------------------------
   113	// REPEAT selection  (`#define REPEAT 5` / `-DREPEAT=...`)
   114	// ---------------------------------------------------------------------------
   115	//
   116	// As with OP, an explicitly requested value beats the `5` that comes in via
   117	// `default`, and no REPEAT feature at all falls back to 5.
   118	
   119	#[cfg(feature = "0")]
   120	pub const REPEAT: c_int = 0;
   121	
   122	#[cfg(all(feature = "1", not(feature = "0")))]
