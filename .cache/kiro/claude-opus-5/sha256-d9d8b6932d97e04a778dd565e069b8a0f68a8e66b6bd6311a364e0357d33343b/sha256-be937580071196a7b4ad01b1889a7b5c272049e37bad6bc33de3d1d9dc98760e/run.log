    39	int helper_call(int a, int b) {
    40	    int r = (OP_FN(OP))(a, b);
    41	    int acc = INIT_FOR(OP);
    42	    RUN_LOOP(OP, acc, REPEAT);
    43	    printf("helper.call=%d helper.acc=%d\n", r, acc);
    44	    return r + acc;
    45	}
