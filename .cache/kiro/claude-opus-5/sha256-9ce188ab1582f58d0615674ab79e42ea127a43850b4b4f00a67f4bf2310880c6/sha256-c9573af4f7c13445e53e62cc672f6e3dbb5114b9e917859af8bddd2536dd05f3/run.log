[0m[49m[38;5;10m+    159[0m:[38;5;10m[49m             cpath.as_ptr(),
[0m[49m[38;5;10m+    160[0m:[38;5;10m[49m             libc::O_RDWR | libc::O_CREAT | libc::O_TRUNC,
[0m[49m[38;5;10m+    161[0m:[38;5;10m[49m             0o600 as libc::c_int,
[0m[49m[38;5;10m+    162[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    163[0m:[38;5;10m[49m         assert!(fd >= 0, "open({path:?}) failed");
[0m[49m[38;5;10m+    164[0m:[38;5;10m[49m         let saved = libc::dup(1);
[0m[49m[38;5;10m+    165[0m:[38;5;10m[49m         assert!(saved >= 0, "dup(1) failed");
[0m[49m[38;5;10m+    166[0m:[38;5;10m[49m         assert!(libc::dup2(fd, 1) >= 0, "dup2 failed");
[0m[49m[38;5;10m+    167[0m:[38;5;10m[49m 
