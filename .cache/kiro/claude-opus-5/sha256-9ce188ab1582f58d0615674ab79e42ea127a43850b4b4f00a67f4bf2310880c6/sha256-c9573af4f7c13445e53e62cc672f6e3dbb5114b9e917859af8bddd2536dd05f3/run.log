[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m     if c != r {
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m         panic!(
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m             "output divergence [{label}]\n  C    ({} bytes): {}\n  Rust ({} bytes): {}",
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m             c.len(),
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m             render(&c),
[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m             r.len(),
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m             render(&r)
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m fn render(b: &[u8]) -> String {
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m     let head: Vec<u8> = b.iter().copied().take(256).collect();
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m     let s = String::from_utf8_lossy(&head).escape_debug().to_string();
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m     if b.len() > 256 {
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m         format!("\"{s}\"... (+{} bytes)", b.len() - 256)
[0m[49m[38;5;10m+    216[0m:[38;5;10m[49m     } else {
[0m[49m[38;5;10m+    217[0m:[38;5;10m[49m         format!("\"{s}\"")
[0m[49m[38;5;10m+    218[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    219[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    220[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    221[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m // Deterministic PRNG (xorshift64*) — fixed seed, reproducible runs
[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m 
