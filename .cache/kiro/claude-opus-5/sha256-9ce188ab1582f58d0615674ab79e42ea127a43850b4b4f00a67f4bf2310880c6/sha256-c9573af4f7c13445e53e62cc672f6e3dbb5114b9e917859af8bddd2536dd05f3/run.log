[0m[49m[38;5;10m+    172[0m:[38;5;10m[49m         assert!(libc::dup2(saved, 1) >= 0, "dup2 restore failed");
[0m[49m[38;5;10m+    173[0m:[38;5;10m[49m         libc::close(saved);
[0m[49m[38;5;10m+    174[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    175[0m:[38;5;10m[49m         assert!(libc::lseek(fd, 0, libc::SEEK_SET) == 0, "lseek failed");
[0m[49m[38;5;10m+    176[0m:[38;5;10m[49m         let mut out = Vec::new();
