[0m[49m[38;5;10m+     92[0m:[38;5;10m[49m     unsafe {
[0m[49m[38;5;10m+     93[0m:[38;5;10m[49m         Api {
[0m[49m[38;5;10m+     94[0m:[38;5;10m[49m             print_line: sym(lib, b"printLine\0", which),
[0m[49m[38;5;10m+     95[0m:[38;5;10m[49m             bad: sym(lib, b"bad\0", which),
[0m[49m[38;5;10m+     96[0m:[38;5;10m[49m             good: sym(lib, b"good\0", which),
[0m[49m[38;5;10m+     97[0m:[38;5;10m[49m             driver: sym(lib, b"driver\0", which),
[0m[49m[38;5;10m+     98[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+     99[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    100[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    101[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    102[0m:[38;5;10m[49m struct Pair {
[0m[49m[38;5;10m+    103[0m:[38;5;10m[49m     c: Api,
