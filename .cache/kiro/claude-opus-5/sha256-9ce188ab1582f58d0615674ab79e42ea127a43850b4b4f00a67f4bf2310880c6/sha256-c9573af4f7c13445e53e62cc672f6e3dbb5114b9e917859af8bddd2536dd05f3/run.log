[0m[49m[38;5;10m+    141[0m:[38;5;10m[49m static CAPTURE_LOCK: Mutex<()> = Mutex::new(());
[0m[49m[38;5;10m+    142[0m:[38;5;10m[49m static COUNTER: AtomicU64 = AtomicU64::new(0);
[0m[49m[38;5;10m+    143[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    144[0m:[38;5;10m[49m /// Run `f` with C `stdout` redirected to a scratch file and return every byte
[0m[49m[38;5;10m+    145[0m:[38;5;10m[49m /// it wrote.
[0m[49m[38;5;10m+    146[0m:[38;5;10m[49m pub fn capture<F: FnOnce()>(f: F) -> Vec<u8> {
[0m[49m[38;5;10m+    147[0m:[38;5;10m[49m     let _guard = CAPTURE_LOCK.lock().unwrap_or_else(|e| e.into_inner());
[0m[49m[38;5;10m+    148[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    149[0m:[38;5;10m[49m     let n = COUNTER.fetch_add(1, Ordering::Relaxed);
[0m[49m[38;5;10m+    150[0m:[38;5;10m[49m     let path = std::env::temp_dir().join(format!("driver_diff_{}_{}.out", std::process::id(), n));
[0m[49m[38;5;10m+    151[0m:[38;5;10m[49m     let cpath = CString::new(path.as_os_str().as_encoded_bytes()).expect("temp path has no NUL");
[0m[49m[38;5;10m+    152[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    153[0m:[38;5;10m[49m     unsafe {
[0m[49m[38;5;10m+    154[0m:[38;5;10m[49m         // Push out anything libc has already buffered for the real stdout so it
[0m[49m[38;5;10m+    155[0m:[38;5;10m[49m         // cannot leak into the capture.
