[0m[49m[38;5;10m+    191[0m:[38;5;10m[49m     assert_eq!(run(&c_binary(), b"\0").stdout, b"01\n");
[0m[49m[38;5;10m+    192[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    193[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    194[0m:[38;5;10m[49m /// Signed-`char` truncation and the sign extension `%x` prints afterwards.
[0m[49m[38;5;10m+    195[0m:[38;5;10m[49m /// `char result = data + 1` wraps into negative territory at 0x7f, and the
[0m[49m[38;5;10m+    196[0m:[38;5;10m[49m /// variadic promotion to `int` then makes `%x` print eight hex digits.
[0m[49m[38;5;10m+    197[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    198[0m:[38;5;10m[49m fn signed_char_boundaries() {
[0m[49m[38;5;10m+    199[0m:[38;5;10m[49m     for (input, expected) in [
[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m         (0x7eu8, &b"7f\n"[..]),
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m         (0x7f, &b"ffffff80\n"[..]),
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m         (0x80, &b"ffffff81\n"[..]),
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m         (0xfe, &b"ffffffff\n"[..]),
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m         (0xff, &b"00\n"[..]),
[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m     ] {
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m         let buf = [input];
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m         assert_same(&format!("byte {input:#04x}"), &buf);
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m             run(&c_binary(), &buf).stdout,
[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m             expected,
[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m             "byte {input:#04x}"
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    216[0m:[38;5;10m[49m /// `%02x` pads to two digits but never truncates a wider value.
[0m[49m[38;5;10m+    217[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    218[0m:[38;5;10m[49m fn zero_padding_width() {
[0m[49m[38;5;10m+    219[0m:[38;5;10m[49m     // 0x00 -> result 0x01 -> "01" (padded)
[0m[49m[38;5;10m+    220[0m:[38;5;10m[49m     assert_same("pad low", b"\x00");
[0m[49m[38;5;10m+    221[0m:[38;5;10m[49m     // 0x0f -> result 0x10 -> "10" (no padding needed)
[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m     assert_same("no pad", b"\x0f");
[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m     // 0x7f -> result -128 -> "ffffff80" (wider than the field width)
[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m     assert_same("wider than width", b"\x7f");
[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m     assert_eq!(run(&c_binary(), b"\x0f").stdout, b"10\n");
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m /// Exhaustive: every possible first byte.
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m fn all_256_first_bytes() {
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m     let c = c_binary();
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m     let r = rust_binary();
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m     for b in 0u16..=255 {
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m         let buf = [b as u8];
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m         let co = run(&c, &buf);
[0m[49m[38;5;10m+    236[0m:[38;5;10m[49m         let ro = run(&r, &buf);
[0m[49m[38;5;10m+    237[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m             co.stdout,
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m             ro.stdout,
[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m             "stdout differs for byte {b:#04x}: C={:?} Rust={:?}",
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m             String::from_utf8_lossy(&co.stdout),
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m             String::from_utf8_lossy(&ro.stdout)
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m         assert_eq!(co.stderr, ro.stderr, "stderr differs for byte {b:#04x}");
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m             co.status.code(),
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m             ro.status.code(),
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m             "exit status differs for byte {b:#04x}"
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m /// Exhaustive with a trailing byte, proving the second byte never leaks in.
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m fn all_256_first_bytes_with_trailer() {
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m     let c = c_binary();
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m     let r = rust_binary();
