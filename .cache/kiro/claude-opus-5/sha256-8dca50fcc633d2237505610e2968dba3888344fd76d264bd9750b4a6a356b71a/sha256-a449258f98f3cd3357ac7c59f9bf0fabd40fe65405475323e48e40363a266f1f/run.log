[0m[49m[38;5;10m+    291[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    292[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    293[0m:[38;5;10m[49m /// Binary input containing every byte value, in order and reversed, so the
[0m[49m[38;5;10m+    294[0m:[38;5;10m[49m /// first byte is 0x00 in one case and 0xff in the other.
[0m[49m[38;5;10m+    295[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    296[0m:[38;5;10m[49m fn full_byte_range_streams() {
[0m[49m[38;5;10m+    297[0m:[38;5;10m[49m     let ascending: Vec<u8> = (0u16..=255).map(|b| b as u8).collect();
[0m[49m[38;5;10m+    298[0m:[38;5;10m[49m     let mut descending = ascending.clone();
[0m[49m[38;5;10m+    299[0m:[38;5;10m[49m     descending.reverse();
[0m[49m[38;5;10m+    300[0m:[38;5;10m[49m     assert_same("ascending 0..=255", &ascending);
[0m[49m[38;5;10m+    301[0m:[38;5;10m[49m     assert_same("descending 255..=0", &descending);
[0m[49m[38;5;10m+    302[0m:[38;5;10m[49m     assert_eq!(run(&c_binary(), &ascending).stdout, b"01\n");
[0m[49m[38;5;10m+    303[0m:[38;5;10m[49m     assert_eq!(run(&c_binary(), &descending).stdout, b"00\n");
[0m[49m[38;5;10m+    304[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    305[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    306[0m:[38;5;10m[49m /// UTF-8 multi-byte character: only its first (continuation-leading) byte is read.
[0m[49m[38;5;10m+    307[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    308[0m:[38;5;10m[49m fn utf8_multibyte_first_byte_only() {
[0m[49m[38;5;10m+    309[0m:[38;5;10m[49m     assert_same("euro sign", "\u{20ac}".as_bytes()); // E2 82 AC -> 0xe2 -> ffffffe3
[0m[49m[38;5;10m+    310[0m:[38;5;10m[49m     assert_same("emoji", "\u{1f600}".as_bytes()); // F0 9F 98 80 -> 0xf0 -> fffffff1
[0m[49m[38;5;10m+    311[0m:[38;5;10m[49m     assert_eq!(run(&c_binary(), "\u{20ac}".as_bytes()).stdout, b"ffffffe3\n");
[0m[49m[38;5;10m+    312[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    313[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    314[0m:[38;5;10m[49m /// stdin closed entirely (fd 0 not open): the `read` fails, `fscanf` assigns
[0m[49m[38;5;10m+    315[0m:[38;5;10m[49m /// nothing, and `data` keeps `' '`.
[0m[49m[38;5;10m+    316[0m:[38;5;10m[49m #[test]
