[0m[49m[38;5;10m+    264[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    265[0m:[38;5;10m[49m             co.status.code(),
[0m[49m[38;5;10m+    266[0m:[38;5;10m[49m             ro.status.code(),
[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m             "exit status differs for {b:#04x} + 'Z'"
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    271[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    272[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    273[0m:[38;5;10m[49m // Phase C: paths not covered above
[0m[49m[38;5;10m+    274[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    275[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m /// Input far larger than any stdio buffer. The program still reads one byte and
[0m[49m[38;5;10m+    277[0m:[38;5;10m[49m /// exits; the writer may see EPIPE, which must not change either program's
[0m[49m[38;5;10m+    278[0m:[38;5;10m[49m /// observable output.
[0m[49m[38;5;10m+    279[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    280[0m:[38;5;10m[49m fn very_large_input() {
[0m[49m[38;5;10m+    281[0m:[38;5;10m[49m     let big = vec![b'Q'; 1 << 20];
[0m[49m[38;5;10m+    282[0m:[38;5;10m[49m     assert_same("1 MiB of 'Q'", &big);
[0m[49m[38;5;10m+    283[0m:[38;5;10m[49m     assert_eq!(run(&c_binary(), &big).stdout, b"52\n");
[0m[49m[38;5;10m+    284[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    285[0m:[38;5;10m[49m 
