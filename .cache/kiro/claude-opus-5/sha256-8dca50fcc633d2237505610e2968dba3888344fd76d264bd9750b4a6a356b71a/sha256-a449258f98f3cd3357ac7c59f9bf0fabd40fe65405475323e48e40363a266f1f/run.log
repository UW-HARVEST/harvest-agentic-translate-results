[0m[49m[38;5;10m+    129[0m:[38;5;10m[49m         c.status.code(),
[0m[49m[38;5;10m+    130[0m:[38;5;10m[49m         r.status.code(),
[0m[49m[38;5;10m+    131[0m:[38;5;10m[49m         "exit status differs for {label}: C={:?} Rust={:?}",
[0m[49m[38;5;10m+    132[0m:[38;5;10m[49m         c.status,
[0m[49m[38;5;10m+    133[0m:[38;5;10m[49m         r.status
[0m[49m[38;5;10m+    134[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    135[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    136[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    137[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    138[0m:[38;5;10m[49m // Phase B: the input classes the C program branches on
[0m[49m[38;5;10m+    139[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    140[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    141[0m:[38;5;10m[49m /// Empty stdin: `fscanf` returns EOF without assigning, so `data` stays `' '`.
[0m[49m[38;5;10m+    142[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    143[0m:[38;5;10m[49m fn empty_stdin() {
[0m[49m[38;5;10m+    144[0m:[38;5;10m[49m     assert_same("empty stdin", b"");
[0m[49m[38;5;10m+    145[0m:[38;5;10m[49m     // Pin the observed C behavior so a regression is obvious, not just "equal".
[0m[49m[38;5;10m+    146[0m:[38;5;10m[49m     let c = run(&c_binary(), b"");
[0m[49m[38;5;10m+    147[0m:[38;5;10m[49m     assert_eq!(c.stdout, b"21\n");
[0m[49m[38;5;10m+    148[0m:[38;5;10m[49m     assert!(c.stderr.is_empty());
[0m[49m[38;5;10m+    149[0m:[38;5;10m[49m     assert_eq!(c.status.code(), Some(0));
[0m[49m[38;5;10m+    150[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    151[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    152[0m:[38;5;10m[49m /// A space on stdin is *data*, not a skipped separator, and coincidentally
[0m[49m[38;5;10m+    153[0m:[38;5;10m[49m /// produces the same output as the EOF path.
[0m[49m[38;5;10m+    154[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    155[0m:[38;5;10m[49m fn single_space_matches_eof_output() {
[0m[49m[38;5;10m+    156[0m:[38;5;10m[49m     assert_same("single space", b" ");
[0m[49m[38;5;10m+    157[0m:[38;5;10m[49m     let c = run(&c_binary(), b" ");
[0m[49m[38;5;10m+    158[0m:[38;5;10m[49m     assert_eq!(c.stdout, b"21\n");
[0m[49m[38;5;10m+    159[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    160[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    161[0m:[38;5;10m[49m /// `%c` does not skip leading whitespace: a newline is consumed as the byte.
[0m[49m[38;5;10m+    162[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    163[0m:[38;5;10m[49m fn leading_whitespace_is_consumed_as_data() {
[0m[49m[38;5;10m+    164[0m:[38;5;10m[49m     for (label, input, expected) in [
[0m[49m[38;5;10m+    165[0m:[38;5;10m[49m         ("newline", &b"\nA"[..], &b"0b\n"[..]),
[0m[49m[38;5;10m+    166[0m:[38;5;10m[49m         ("tab", &b"\tA"[..], &b"0a\n"[..]),
[0m[49m[38;5;10m+    167[0m:[38;5;10m[49m         ("cr", &b"\rA"[..], &b"0e\n"[..]),
[0m[49m[38;5;10m+    168[0m:[38;5;10m[49m         ("vtab", &b"\x0bA"[..], &b"0c\n"[..]),
[0m[49m[38;5;10m+    169[0m:[38;5;10m[49m         ("formfeed", &b"\x0cA"[..], &b"0d\n"[..]),
[0m[49m[38;5;10m+    170[0m:[38;5;10m[49m     ] {
[0m[49m[38;5;10m+    171[0m:[38;5;10m[49m         assert_same(label, input);
[0m[49m[38;5;10m+    172[0m:[38;5;10m[49m         assert_eq!(run(&c_binary(), input).stdout, expected, "{label}");
[0m[49m[38;5;10m+    173[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    174[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    175[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    176[0m:[38;5;10m[49m /// Only the first byte matters; the rest of stdin is never read.
[0m[49m[38;5;10m+    177[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    178[0m:[38;5;10m[49m fn only_first_byte_is_read() {
[0m[49m[38;5;10m+    179[0m:[38;5;10m[49m     assert_same("two bytes", b"AB");
[0m[49m[38;5;10m+    180[0m:[38;5;10m[49m     assert_same("line", b"hello world\n");
[0m[49m[38;5;10m+    181[0m:[38;5;10m[49m     assert_same("multiple lines", b"first\nsecond\nthird\n");
[0m[49m[38;5;10m+    182[0m:[38;5;10m[49m     assert_eq!(run(&c_binary(), b"AB").stdout, b"42\n");
[0m[49m[38;5;10m+    183[0m:[38;5;10m[49m     assert_eq!(run(&c_binary(), b"hello world\n").stdout, b"69\n");
[0m[49m[38;5;10m+    184[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    185[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    186[0m:[38;5;10m[49m /// NUL is a perfectly ordinary byte for `%c`.
[0m[49m[38;5;10m+    187[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    188[0m:[38;5;10m[49m fn nul_byte() {
[0m[49m[38;5;10m+    189[0m:[38;5;10m[49m     assert_same("NUL", b"\0");
