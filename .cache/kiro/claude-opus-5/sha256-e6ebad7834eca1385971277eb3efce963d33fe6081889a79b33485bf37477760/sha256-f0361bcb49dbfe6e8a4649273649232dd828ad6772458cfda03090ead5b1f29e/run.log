[0m[49m[38;5;10m+    424[0m:[38;5;10m[49m         // mod == 17 (ba == 20) -> mod/2 == 8, so codes 0..7 must come out
[0m[49m[38;5;10m+    425[0m:[38;5;10m[49m         // negative via the unsigned wrap.
[0m[49m[38;5;10m+    426[0m:[38;5;10m[49m         inp.ba_all(|_| 20).total_bands(8).group_size(12).pos(0);
[0m[49m[38;5;10m+    427[0m:[38;5;10m[49m         let (c, _) = assert_same_ret(&libs, "E20", it, &inp.done());
