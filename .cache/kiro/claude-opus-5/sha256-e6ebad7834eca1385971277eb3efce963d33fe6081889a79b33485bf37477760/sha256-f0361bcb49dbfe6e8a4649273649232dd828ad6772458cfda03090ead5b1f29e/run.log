[0m[49m[38;5;10m+     20[0m:[38;5;10m[49m     0x7FA0_0000 ^ (i as u32).wrapping_mul(0x9E37_79B9)
[0m[49m[38;5;10m+     21[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     22[0m:[38;5;10m[49m 
