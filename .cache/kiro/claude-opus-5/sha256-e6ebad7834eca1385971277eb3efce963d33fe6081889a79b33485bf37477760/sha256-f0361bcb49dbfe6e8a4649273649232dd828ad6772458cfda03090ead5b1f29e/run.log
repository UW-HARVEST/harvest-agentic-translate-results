[0m[49m[38;5;10m+    573[0m:[38;5;10m[49m     let mut rng = Rng::new(0xE01A);
[0m[49m[38;5;10m+    574[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    575[0m:[38;5;10m[49m     struct Case {
[0m[49m[38;5;10m+    576[0m:[38;5;10m[49m         name: &'static str,
[0m[49m[38;5;10m+    577[0m:[38;5;10m[49m         null_gr: bool,
[0m[49m[38;5;10m+    578[0m:[38;5;10m[49m         null_bs: bool,
[0m[49m[38;5;10m+    579[0m:[38;5;10m[49m         null_sci: bool,
[0m[49m[38;5;10m+    580[0m:[38;5;10m[49m         tb: u8,
[0m[49m[38;5;10m+    581[0m:[38;5;10m[49m         ba: u8,
[0m[49m[38;5;10m+    582[0m:[38;5;10m[49m         gs: i32,
[0m[49m[38;5;10m+    583[0m:[38;5;10m[49m         expect_crash: bool,
[0m[49m[38;5;10m+    584[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    585[0m:[38;5;10m[49m     let cases = [
[0m[49m[38;5;10m+    586[0m:[38;5;10m[49m         // sci is always dereferenced (total_bands) -> always fatal.
[0m[49m[38;5;10m+    587[0m:[38;5;10m[49m         Case { name: "sci null", null_gr: false, null_bs: false, null_sci: true, tb: 0, ba: 0, gs: 3, expect_crash: true },
