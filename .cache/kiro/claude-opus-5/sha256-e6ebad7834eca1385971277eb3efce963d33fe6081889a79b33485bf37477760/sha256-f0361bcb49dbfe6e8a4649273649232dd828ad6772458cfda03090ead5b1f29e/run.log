[0m[49m[38;5;10m+    445[0m:[38;5;10m[49m     for it in 0..24 {
[0m[49m[38;5;10m+    446[0m:[38;5;10m[49m         let mut inp = Inputs::new(&mut rng, BUF_BIG);
[0m[49m[38;5;10m+    447[0m:[38;5;10m[49m         // In-array slots inert, `scfcod` slots active: any decoding at all
[0m[49m[38;5;10m+    448[0m:[38;5;10m[49m         // proves `ba` was fetched from beyond `bitalloc[64]`.
[0m[49m[38;5;10m+    449[0m:[38;5;10m[49m         inp.ba_all(|i| if i < 64 { 0 } else { 7 }).total_bands(40).group_size(3).pos(0);
[0m[49m[38;5;10m+    450[0m:[38;5;10m[49m         let (c, _) = assert_same_ret(&libs, "E21", it, &inp.done());
[0m[49m[38;5;10m+    451[0m:[38;5;10m[49m         assert_ne!(c.pos, 0, "E21: premise -- ba must have been read out of `scfcod`");
[0m[49m[38;5;10m+    452[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    453[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    454[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    455[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    456[0m:[38;5;10m[49m fn e22_index_reads_past_struct() {
