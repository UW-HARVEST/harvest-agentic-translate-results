[0m[49m[38;5;10m+    539[0m:[38;5;10m[49m                 inp.ba_all(|_| 9).total_bands(8).group_size(gs).pos(pos).limit(lim);
[0m[49m[38;5;10m+    540[0m:[38;5;10m[49m                 assert_same_ret(&libs, "E24-scalar-active", it, &inp.done());
[0m[49m[38;5;10m+    541[0m:[38;5;10m[49m                 it += 1;
[0m[49m[38;5;10m+    542[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    543[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    544[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    545[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    546[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    547[0m:[38;5;10m[49m // --------------------------------------------------------------------------
[0m[49m[38;5;10m+    548[0m:[38;5;10m[49m // E25 -- degenerate bitstream content
[0m[49m[38;5;10m+    549[0m:[38;5;10m[49m // --------------------------------------------------------------------------
[0m[49m[38;5;10m+    550[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    551[0m:[38;5;10m[49m fn e25_degenerate_buffer_content() {
[0m[49m[38;5;10m+    552[0m:[38;5;10m[49m     let libs = Libs::load();
[0m[49m[38;5;10m+    553[0m:[38;5;10m[49m     let mut rng = Rng::new(0xE019);
[0m[49m[38;5;10m+    554[0m:[38;5;10m[49m     for (it, fill) in [0x00u8, 0xFF].iter().enumerate() {
[0m[49m[38;5;10m+    555[0m:[38;5;10m[49m         let mut inp = Inputs::new(&mut rng, BUF_MED);
[0m[49m[38;5;10m+    556[0m:[38;5;10m[49m         inp.ba_all(|_| 10).total_bands(8).group_size(12).pos(0).buf_fill(*fill);
[0m[49m[38;5;10m+    557[0m:[38;5;10m[49m         let (c, _) = assert_same_ret(&libs, "E25", it, &inp.done());
[0m[49m[38;5;10m+    558[0m:[38;5;10m[49m         let half = (1i32 << 9) - 1;
[0m[49m[38;5;10m+    559[0m:[38;5;10m[49m         let expect =
[0m[49m[38;5;10m+    560[0m:[38;5;10m[49m             if *fill == 0 { -(half as f32) } else { (1023 - half) as f32 };
[0m[49m[38;5;10m+    561[0m:[38;5;10m[49m         assert_eq!(c.grbuf[GR_PREFIX], expect.to_bits(), "E25: fill=0x{fill:02X}");
[0m[49m[38;5;10m+    562[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    563[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    564[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    565[0m:[38;5;10m[49m // --------------------------------------------------------------------------
[0m[49m[38;5;10m+    566[0m:[38;5;10m[49m // E26 -- NULL pointers. The C has no null check; both libraries must agree on
[0m[49m[38;5;10m+    567[0m:[38;5;10m[49m //        which combinations survive (because a guard makes the deref
