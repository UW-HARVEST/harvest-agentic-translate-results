[0m[49m[38;5;10m+    509[0m:[38;5;10m[49m     assert!(crashes < 256, "E24: expected most ba values to complete normally");
[0m[49m[38;5;10m+    510[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    511[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    512[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    513[0m:[38;5;10m[49m fn e24_extreme_scalar_arguments() {
[0m[49m[38;5;10m+    514[0m:[38;5;10m[49m     let libs = Libs::load();
[0m[49m[38;5;10m+    515[0m:[38;5;10m[49m     let mut rng = Rng::new(0xE018);
[0m[49m[38;5;10m+    516[0m:[38;5;10m[49m     let gss = [i32::MIN, i32::MIN + 1, -1000000, -1, 0, 1, 1000000, i32::MAX];
[0m[49m[38;5;10m+    517[0m:[38;5;10m[49m     let poss = [i32::MIN, -1, 0, 1, i32::MAX];
[0m[49m[38;5;10m+    518[0m:[38;5;10m[49m     let lims = [i32::MIN, -1, 0, 1, i32::MAX];
[0m[49m[38;5;10m+    519[0m:[38;5;10m[49m     let mut it = 0;
[0m[49m[38;5;10m+    520[0m:[38;5;10m[49m     for gs in gss {
[0m[49m[38;5;10m+    521[0m:[38;5;10m[49m         for pos in poss {
