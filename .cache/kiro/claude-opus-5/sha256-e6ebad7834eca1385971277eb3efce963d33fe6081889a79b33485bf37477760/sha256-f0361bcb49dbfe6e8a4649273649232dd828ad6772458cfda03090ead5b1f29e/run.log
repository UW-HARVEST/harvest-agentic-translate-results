[0m[49m[38;5;10m+    483[0m:[38;5;10m[49m         assert_eq!(c.pos, 4 * 510 * 3 * 4, "E23: 510 bands per granule");
[0m[49m[38;5;10m+    484[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    485[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    486[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    487[0m:[38;5;10m[49m // --------------------------------------------------------------------------
[0m[49m[38;5;10m+    488[0m:[38;5;10m[49m // E24 -- out-of-range "enum" ints across the FFI boundary. C enums accept any
[0m[49m[38;5;10m+    489[0m:[38;5;10m[49m //        int and this API has no valid-value check at all: sweep every ba byte
[0m[49m[38;5;10m+    490[0m:[38;5;10m[49m //        and a spread of extreme group_size / pos / limit values.
[0m[49m[38;5;10m+    491[0m:[38;5;10m[49m // --------------------------------------------------------------------------
[0m[49m[38;5;10m+    492[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    493[0m:[38;5;10m[49m fn e24_all_ba_values_no_rejection() {
[0m[49m[38;5;10m+    494[0m:[38;5;10m[49m     let libs = Libs::load();
[0m[49m[38;5;10m+    495[0m:[38;5;10m[49m     let mut rng = Rng::new(0xE017);
[0m[49m[38;5;10m+    496[0m:[38;5;10m[49m     let mut crashes = 0usize;
[0m[49m[38;5;10m+    497[0m:[38;5;10m[49m     for ba in 0..=255u8 {
[0m[49m[38;5;10m+    498[0m:[38;5;10m[49m         let mut inp = Inputs::new(&mut rng, BUF_MED);
[0m[49m[38;5;10m+    499[0m:[38;5;10m[49m         inp.ba_all(|_| ba).total_bands(3).group_size(3).pos(0).limit(64);
[0m[49m[38;5;10m+    500[0m:[38;5;10m[49m         let (c, r) = assert_same_ret(&libs, "E24-ba", ba as usize, &inp.done());
[0m[49m[38;5;10m+    501[0m:[38;5;10m[49m         assert_eq!(c.crashed(), r.crashed());
[0m[49m[38;5;10m+    502[0m:[38;5;10m[49m         if c.crashed() {
[0m[49m[38;5;10m+    503[0m:[38;5;10m[49m             crashes += 1;
[0m[49m[38;5;10m+    504[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    505[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    506[0m:[38;5;10m[49m     // Not a vacuous sweep: the huge-`n` values really do make `bs->pos`
