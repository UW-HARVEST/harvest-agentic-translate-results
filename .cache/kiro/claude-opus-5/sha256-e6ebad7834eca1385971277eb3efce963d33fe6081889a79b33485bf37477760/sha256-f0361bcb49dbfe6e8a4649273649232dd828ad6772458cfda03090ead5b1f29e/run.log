[0m[49m[38;5;10m+    413[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    414[0m:[38;5;10m[49m // --------------------------------------------------------------------------
[0m[49m[38;5;10m+    415[0m:[38;5;10m[49m // E20 -- `code % mod - mod / 2` wraps in unsigned before the cast to int
[0m[49m[38;5;10m+    416[0m:[38;5;10m[49m // --------------------------------------------------------------------------
[0m[49m[38;5;10m+    417[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    418[0m:[38;5;10m[49m fn e20_unsigned_wrap_before_int_cast() {
[0m[49m[38;5;10m+    419[0m:[38;5;10m[49m     let libs = Libs::load();
[0m[49m[38;5;10m+    420[0m:[38;5;10m[49m     let mut rng = Rng::new(0xE013);
