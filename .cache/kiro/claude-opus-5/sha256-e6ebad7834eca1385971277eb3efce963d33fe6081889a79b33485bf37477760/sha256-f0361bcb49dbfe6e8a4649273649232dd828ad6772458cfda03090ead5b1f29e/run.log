[0m[49m[38;5;10m+    589[0m:[38;5;10m[49m         // total_bands == 0 -> neither grbuf nor bs is ever touched.
[0m[49m[38;5;10m+    590[0m:[38;5;10m[49m         Case { name: "grbuf+bs null, tb=0", null_gr: true, null_bs: true, null_sci: false, tb: 0, ba: 9, gs: 3, expect_crash: false },
