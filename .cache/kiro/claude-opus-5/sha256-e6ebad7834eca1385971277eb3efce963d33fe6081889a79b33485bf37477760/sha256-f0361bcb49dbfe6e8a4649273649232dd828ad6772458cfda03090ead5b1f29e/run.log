[0m[49m[38;5;10m+    474[0m:[38;5;10m[49m // --------------------------------------------------------------------------
[0m[49m[38;5;10m+    475[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    476[0m:[38;5;10m[49m fn e23_total_bands_max() {
