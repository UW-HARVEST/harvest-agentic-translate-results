[0m[49m[38;5;10m+     44[0m:[38;5;10m[49m         assert_eq!(c.grbuf[GR_PREFIX], (-(half as f32)).to_bits(), "E1: expected 0-half sample");
[0m[49m[38;5;10m+     45[0m:[38;5;10m[49m         assert_eq!(c.pos, 4 * 8 * 3 * ba as i32, "E1: pos must advance past the limit");
[0m[49m[38;5;10m+     46[0m:[38;5;10m[49m         assert_eq!(c.ret, 12);
[0m[49m[38;5;10m+     47[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+     48[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+     49[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+     50[0m:[38;5;10m[49m // --------------------------------------------------------------------------
[0m[49m[38;5;10m+     51[0m:[38;5;10m[49m // E2 -- guard trips mid-run: prefix real, suffix all zero bits
