[0m[49m[38;5;10m+    479[0m:[38;5;10m[49m     for it in 0..16 {
[0m[49m[38;5;10m+    480[0m:[38;5;10m[49m         let mut inp = Inputs::new(&mut rng, BUF_BIG);
[0m[49m[38;5;10m+    481[0m:[38;5;10m[49m         inp.ba_all(|_| 4).total_bands(255).group_size(3).pos(0);
