[0m[49m[38;5;10m+    432[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    433[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    434[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    435[0m:[38;5;10m[49m     assert!(saw_negative, "E20: never produced a negative sample; the wrap path was not reached");
[0m[49m[38;5;10m+    436[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    437[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    438[0m:[38;5;10m[49m // --------------------------------------------------------------------------
[0m[49m[38;5;10m+    439[0m:[38;5;10m[49m // E21 / E22 -- bitalloc index leaving its array, then leaving the struct
[0m[49m[38;5;10m+    440[0m:[38;5;10m[49m // --------------------------------------------------------------------------
[0m[49m[38;5;10m+    441[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    442[0m:[38;5;10m[49m fn e21_index_reads_scfcod() {
