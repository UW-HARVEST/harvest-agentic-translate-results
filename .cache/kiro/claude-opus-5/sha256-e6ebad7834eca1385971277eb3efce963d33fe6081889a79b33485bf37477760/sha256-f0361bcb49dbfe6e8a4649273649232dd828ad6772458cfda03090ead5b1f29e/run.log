[0m[49m[38;5;10m+    526[0m:[38;5;10m[49m                 inp.ba_all(|_| 0).total_bands(8).group_size(gs).pos(pos).limit(lim);
[0m[49m[38;5;10m+    527[0m:[38;5;10m[49m                 let (c, _) = assert_same_ret(&libs, "E24-scalar", it, &inp.done());
[0m[49m[38;5;10m+    528[0m:[38;5;10m[49m                 assert_eq!(c.ret, gs.wrapping_mul(4));
[0m[49m[38;5;10m+    529[0m:[38;5;10m[49m                 it += 1;
[0m[49m[38;5;10m+    530[0m:[38;5;10m[49m             }
