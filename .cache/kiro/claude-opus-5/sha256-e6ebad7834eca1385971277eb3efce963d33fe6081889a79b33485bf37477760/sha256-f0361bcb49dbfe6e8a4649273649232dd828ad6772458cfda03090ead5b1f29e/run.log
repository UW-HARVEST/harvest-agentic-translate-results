[0m[49m[38;5;10m+    569[0m:[38;5;10m[49m // --------------------------------------------------------------------------
[0m[49m[38;5;10m+    570[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    571[0m:[38;5;10m[49m fn e26_null_pointers() {
