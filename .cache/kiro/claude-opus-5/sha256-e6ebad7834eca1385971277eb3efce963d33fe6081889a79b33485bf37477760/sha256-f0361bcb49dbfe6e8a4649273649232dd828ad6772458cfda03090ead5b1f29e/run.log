[0m[49m[38;5;10m+    523[0m:[38;5;10m[49m                 let mut inp = Inputs::new(&mut rng, BUF_MED);
[0m[49m[38;5;10m+    524[0m:[38;5;10m[49m                 // `ba == 0` everywhere: no get_bits, no grbuf write, so these
