[0m[49m[38;5;10m+     34[0m:[38;5;10m[49m     let libs = Libs::load();
[0m[49m[38;5;10m+     35[0m:[38;5;10m[49m     let mut rng = Rng::new(0xE001);
[0m[49m[38;5;10m+     36[0m:[38;5;10m[49m     for it in 0..32 {
[0m[49m[38;5;10m+     37[0m:[38;5;10m[49m         let ba = rng.range(1, 16) as u8;
[0m[49m[38;5;10m+     38[0m:[38;5;10m[49m         let mut inp = Inputs::new(&mut rng, BUF_MED);
