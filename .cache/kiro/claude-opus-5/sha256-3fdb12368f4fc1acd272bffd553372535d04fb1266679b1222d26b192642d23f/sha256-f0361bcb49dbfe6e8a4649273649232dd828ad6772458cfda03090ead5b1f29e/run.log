import re
# Every site of the form:
#   let ctx = ...;
#   let c = measure_pair(&ctx, CF);
#   let r = measure_pair(&ctx, RF);
#   assert_pair_eq(&ctx, c, r);
# becomes: strict ordered assert_alloc_diff(ctx, CF, RF) FIRST (the real
# C-vs-Rust check), then a stable `c` for the follow-on C-vs-C checks.
pat = re.compile(
    r'^(?P<i>[ ]*)let ctx = (?P<ctx>format!\([^\n]*\));\n'
    r'[ ]*let c = measure_pair\(&ctx, (?P<cf>\|\| unsafe \{[^\n]*\})\);\n'
    r'[ ]*let r = measure_pair\(&ctx, (?P<rf>\|\| unsafe \{[^\n]*\})\);\n'
    r'[ ]*assert_pair_eq\(&ctx, c, r\);\n', re.M)

total = 0
for path in ("tests/phase_b.rs", "tests/phase_c.rs"):
    s = open(path).read()
    def rep(m):
        global total; total += 1
        i, ctx, cf, rf = m.group('i'), m.group('ctx'), m.group('cf'), m.group('rf')
        return (f'{i}let ctx = {ctx};\n'
                f'{i}// Strict, ORDERED C-vs-Rust differential (adjacent, heap-locked).\n'
                f'{i}assert_alloc_diff(&ctx, {cf}, {rf});\n'
                f'{i}// Stable phase-independent C measurement for the C-vs-C checks below.\n'
                f'{i}let c = measure_pair(&ctx, {cf});\n')
    s = pat.sub(rep, s)
    open(path, "w").write(s)
print("upgraded sites:", total)
