import re, sys

pat = re.compile(
    r'let (\w+) = pair2\((\|\| unsafe \{[^\n]*?\})\);\n'
    r'(\s*)let (\w+) = pair2\((\|\| unsafe \{[^\n]*?\})\);\n'
    r'\s*assert_pair_eq\((&format!\([^\n]*?\)|"[^"]*"), \1, \4\);',
    re.M)

total = 0
for path in ("tests/phase_b.rs", "tests/phase_c.rs"):
    s = open(path).read()
    def rep(m):
        global total
        total += 1
        indent = m.group(3)
        return (f'assert_alloc_diff(\n{indent}    {m.group(6)},\n'
                f'{indent}    {m.group(2)},\n'
                f'{indent}    {m.group(5)},\n{indent});')
    s2 = pat.sub(rep, s)
    open(path, "w").write(s2)
    print(f"{path}: rewrote {total} sites so far")
print("total rewritten:", total)
