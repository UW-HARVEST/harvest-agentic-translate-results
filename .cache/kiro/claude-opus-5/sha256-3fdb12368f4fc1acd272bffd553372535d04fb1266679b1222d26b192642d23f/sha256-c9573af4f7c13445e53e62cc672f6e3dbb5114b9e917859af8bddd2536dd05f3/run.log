[0m[49m[38;5;10m+    389[0m:[38;5;10m[49m         (4, 4),
[0m[49m[38;5;10m+    390[0m:[38;5;10m[49m         (4, 5),
[0m[49m[38;5;10m+    391[0m:[38;5;10m[49m         (-1, 1),
[0m[49m[38;5;10m+    392[0m:[38;5;10m[49m         (i32::MIN, 1),
[0m[49m[38;5;10m+    393[0m:[38;5;10m[49m         (1, 1),
[0m[49m[38;5;10m+    394[0m:[38;5;10m[49m         (2, 2),
[0m[49m[38;5;10m+    395[0m:[38;5;10m[49m     ] {
[0m[49m[38;5;10m+    396[0m:[38;5;10m[49m         unsafe { (p.c.shift_array)(ptr::null_mut(), size, positions) };
[0m[49m[38;5;10m+    397[0m:[38;5;10m[49m         unsafe { (p.rust.shift_array)(ptr::null_mut(), size, positions) };
[0m[49m[38;5;10m+    398[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    399[0m:[38;5;10m[49m     // Reaching here without a fault means both implementations agree.
[0m[49m[38;5;10m+    400[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    401[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    402[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    403[0m:[38;5;10m[49m // Rows 24-25: process_string rejects an empty string via `if (*str)`
[0m[49m[38;5;10m+    404[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    405[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    406[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    407[0m:[38;5;10m[49m fn err_process_string_empty() {
[0m[49m[38;5;10m+    408[0m:[38;5;10m[49m     let p = common::load_pair();
[0m[49m[38;5;10m+    409[0m:[38;5;10m[49m     let empty: [c_char; 1] = [0];
[0m[49m[38;5;10m+    410[0m:[38;5;10m[49m     let c = unsafe { (p.c.process_string)(empty.as_ptr()) };
