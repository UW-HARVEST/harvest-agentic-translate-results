[0m[49m[38;5;10m+    473[0m:[38;5;10m[49m             );
[0m[49m[38;5;10m+    474[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    475[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    476[0m:[38;5;10m[49m     // Exhaustive sweep of every operation value in a wide window around the
[0m[49m[38;5;10m+    477[0m:[38;5;10m[49m     // valid labels, so the boundary at 0 and at 3 is covered from both sides.
[0m[49m[38;5;10m+    478[0m:[38;5;10m[49m     for operation in -64..=64i32 {
[0m[49m[38;5;10m+    479[0m:[38;5;10m[49m         for value in [0, -1, 1, 0xFF, -0x100, i32::MAX, i32::MIN, 0x5A5A_5A5A] {
[0m[49m[38;5;10m+    480[0m:[38;5;10m[49m             let c = unsafe { (p.c.apply_bitmask)(value, operation) };
[0m[49m[38;5;10m+    481[0m:[38;5;10m[49m             let r = unsafe { (p.rust.apply_bitmask)(value, operation) };
[0m[49m[38;5;10m+    482[0m:[38;5;10m[49m             assert_eq!(c, r, "apply_bitmask({value}, {operation})");
