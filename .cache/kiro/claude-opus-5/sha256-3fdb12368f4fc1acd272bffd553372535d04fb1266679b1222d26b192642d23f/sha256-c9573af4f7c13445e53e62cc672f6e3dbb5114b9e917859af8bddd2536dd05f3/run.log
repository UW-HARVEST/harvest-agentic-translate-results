[0m[49m[38;5;10m+    428[0m:[38;5;10m[49m         let c = unsafe { (p.c.process_string)(buf.as_ptr()) };
[0m[49m[38;5;10m+    429[0m:[38;5;10m[49m         let r = unsafe { (p.rust.process_string)(buf.as_ptr()) };
[0m[49m[38;5;10m+    430[0m:[38;5;10m[49m         assert_eq!(c, 0, "C must return 0 when the first byte is NUL");
[0m[49m[38;5;10m+    431[0m:[38;5;10m[49m         assert_eq!(r, 0, "Rust must return 0 when the first byte is NUL");
[0m[49m[38;5;10m+    432[0m:[38;5;10m[49m         assert_eq!(c, r);
[0m[49m[38;5;10m+    433[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    434[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    435[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    436[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    437[0m:[38;5;10m[49m // Rows 26-27: apply_bitmask `default:` for out-of-range operation values
[0m[49m[38;5;10m+    438[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    439[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    440[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    441[0m:[38;5;10m[49m fn err_apply_bitmask_out_of_range_operation() {
[0m[49m[38;5;10m+    442[0m:[38;5;10m[49m     let p = common::load_pair();
[0m[49m[38;5;10m+    443[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0x26);
[0m[49m[38;5;10m+    444[0m:[38;5;10m[49m     // A C `switch` over an `int` accepts any int, so a value with no matching
[0m[49m[38;5;10m+    445[0m:[38;5;10m[49m     // label is a legitimate input crossing the FFI boundary.
[0m[49m[38;5;10m+    446[0m:[38;5;10m[49m     let out_of_range: [c_int; 16] = [
[0m[49m[38;5;10m+    447[0m:[38;5;10m[49m         -1,
[0m[49m[38;5;10m+    448[0m:[38;5;10m[49m         -2,
[0m[49m[38;5;10m+    449[0m:[38;5;10m[49m         -3,
[0m[49m[38;5;10m+    450[0m:[38;5;10m[49m         -4,
[0m[49m[38;5;10m+    451[0m:[38;5;10m[49m         -100,
[0m[49m[38;5;10m+    452[0m:[38;5;10m[49m         4,
[0m[49m[38;5;10m+    453[0m:[38;5;10m[49m         5,
[0m[49m[38;5;10m+    454[0m:[38;5;10m[49m         6,
[0m[49m[38;5;10m+    455[0m:[38;5;10m[49m         7,
[0m[49m[38;5;10m+    456[0m:[38;5;10m[49m         8,
[0m[49m[38;5;10m+    457[0m:[38;5;10m[49m         100,
[0m[49m[38;5;10m+    458[0m:[38;5;10m[49m         255,
[0m[49m[38;5;10m+    459[0m:[38;5;10m[49m         256,
[0m[49m[38;5;10m+    460[0m:[38;5;10m[49m         65536,
[0m[49m[38;5;10m+    461[0m:[38;5;10m[49m         i32::MAX,
[0m[49m[38;5;10m+    462[0m:[38;5;10m[49m         i32::MIN,
[0m[49m[38;5;10m+    463[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    464[0m:[38;5;10m[49m     for operation in out_of_range {
[0m[49m[38;5;10m+    465[0m:[38;5;10m[49m         for _ in 0..300 {
[0m[49m[38;5;10m+    466[0m:[38;5;10m[49m             let value = rng.interesting_i32();
[0m[49m[38;5;10m+    467[0m:[38;5;10m[49m             let c = unsafe { (p.c.apply_bitmask)(value, operation) };
[0m[49m[38;5;10m+    468[0m:[38;5;10m[49m             let r = unsafe { (p.rust.apply_bitmask)(value, operation) };
[0m[49m[38;5;10m+    469[0m:[38;5;10m[49m             assert_eq!(c, r, "apply_bitmask({value}, {operation}): C={c} Rust={r}");
[0m[49m[38;5;10m+    470[0m:[38;5;10m[49m             assert_eq!(
[0m[49m[38;5;10m+    471[0m:[38;5;10m[49m                 c, value,
