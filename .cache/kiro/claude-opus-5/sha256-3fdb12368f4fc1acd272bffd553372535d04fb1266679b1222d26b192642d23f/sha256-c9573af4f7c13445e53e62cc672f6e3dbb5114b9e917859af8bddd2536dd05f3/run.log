[0m[49m[38;5;10m+    412[0m:[38;5;10m[49m     assert_eq!(c, 0, "C: empty string must return 0");
[0m[49m[38;5;10m+    413[0m:[38;5;10m[49m     assert_eq!(r, 0, "Rust: empty string must return 0");
[0m[49m[38;5;10m+    414[0m:[38;5;10m[49m     assert_eq!(c, r);
[0m[49m[38;5;10m+    415[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    416[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    417[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    418[0m:[38;5;10m[49m fn err_process_string_embedded_nul_first() {
[0m[49m[38;5;10m+    419[0m:[38;5;10m[49m     let p = common::load_pair();
