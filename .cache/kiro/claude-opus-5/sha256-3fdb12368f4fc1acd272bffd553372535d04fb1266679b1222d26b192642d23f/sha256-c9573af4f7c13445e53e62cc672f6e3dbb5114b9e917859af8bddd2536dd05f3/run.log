[0m[49m[38;5;10m+    318[0m:[38;5;10m[49m                 shift_expect_noop(&p, &data, size, positions);
[0m[49m[38;5;10m+    319[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    320[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    321[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    322[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    323[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    324[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    325[0m:[38;5;10m[49m // Rows 19, 21: size == 0 and size == 1
[0m[49m[38;5;10m+    326[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    327[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    328[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    329[0m:[38;5;10m[49m fn err_shift_array_zero_and_one_size() {
[0m[49m[38;5;10m+    330[0m:[38;5;10m[49m     let p = common::load_pair();
[0m[49m[38;5;10m+    331[0m:[38;5;10m[49m     // size == 0 with a real (but zero-length window) buffer: guard must reject
[0m[49m[38;5;10m+    332[0m:[38;5;10m[49m     // every `positions`, so no write happens even though the window is empty.
[0m[49m[38;5;10m+    333[0m:[38;5;10m[49m     const GUARD: c_int = 0x2B2B_2B2B;
[0m[49m[38;5;10m+    334[0m:[38;5;10m[49m     for positions in [i32::MIN, -1, 0, 1, 2, 100, i32::MAX] {
[0m[49m[38;5;10m+    335[0m:[38;5;10m[49m         let mut a = [GUARD; 8];
[0m[49m[38;5;10m+    336[0m:[38;5;10m[49m         let mut b = [GUARD; 8];
[0m[49m[38;5;10m+    337[0m:[38;5;10m[49m         unsafe { (p.c.shift_array)(a.as_mut_ptr(), 0, positions) };
[0m[49m[38;5;10m+    338[0m:[38;5;10m[49m         unsafe { (p.rust.shift_array)(b.as_mut_ptr(), 0, positions) };
[0m[49m[38;5;10m+    339[0m:[38;5;10m[49m         assert_eq!(a, b, "shift_array(size=0, positions={positions})");
[0m[49m[38;5;10m+    340[0m:[38;5;10m[49m         assert_eq!(a, [GUARD; 8], "size=0 must never write");
[0m[49m[38;5;10m+    341[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    342[0m:[38;5;10m[49m     // size == 1: positions == 1 is rejected by `positions < size`.
[0m[49m[38;5;10m+    343[0m:[38;5;10m[49m     for positions in [i32::MIN, -1, 0, 1, 2, i32::MAX] {
[0m[49m[38;5;10m+    344[0m:[38;5;10m[49m         let mut a = [7, GUARD, GUARD, GUARD];
[0m[49m[38;5;10m+    345[0m:[38;5;10m[49m         let mut b = a;
[0m[49m[38;5;10m+    346[0m:[38;5;10m[49m         unsafe { (p.c.shift_array)(a.as_mut_ptr(), 1, positions) };
[0m[49m[38;5;10m+    347[0m:[38;5;10m[49m         unsafe { (p.rust.shift_array)(b.as_mut_ptr(), 1, positions) };
[0m[49m[38;5;10m+    348[0m:[38;5;10m[49m         assert_eq!(a, b, "shift_array(size=1, positions={positions})");
[0m[49m[38;5;10m+    349[0m:[38;5;10m[49m         assert_eq!(a, [7, GUARD, GUARD, GUARD], "size=1 must never write");
[0m[49m[38;5;10m+    350[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    351[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    352[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    353[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    354[0m:[38;5;10m[49m // Row 20: negative size
[0m[49m[38;5;10m+    355[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    356[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    357[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    358[0m:[38;5;10m[49m fn err_shift_array_negative_size() {
[0m[49m[38;5;10m+    359[0m:[38;5;10m[49m     let p = common::load_pair();
[0m[49m[38;5;10m+    360[0m:[38;5;10m[49m     const GUARD: c_int = -0x1234_5678;
[0m[49m[38;5;10m+    361[0m:[38;5;10m[49m     for size in [-1i32, -2, -100, i32::MIN, i32::MIN + 1] {
[0m[49m[38;5;10m+    362[0m:[38;5;10m[49m         for positions in [i32::MIN, -1, 0, 1, 2, 100, i32::MAX] {
[0m[49m[38;5;10m+    363[0m:[38;5;10m[49m             let mut a = [GUARD; 8];
[0m[49m[38;5;10m+    364[0m:[38;5;10m[49m             let mut b = [GUARD; 8];
[0m[49m[38;5;10m+    365[0m:[38;5;10m[49m             unsafe { (p.c.shift_array)(a.as_mut_ptr(), size, positions) };
[0m[49m[38;5;10m+    366[0m:[38;5;10m[49m             unsafe { (p.rust.shift_array)(b.as_mut_ptr(), size, positions) };
[0m[49m[38;5;10m+    367[0m:[38;5;10m[49m             assert_eq!(a, b, "shift_array(size={size}, positions={positions})");
[0m[49m[38;5;10m+    368[0m:[38;5;10m[49m             assert_eq!(a, [GUARD; 8], "negative size must never write");
[0m[49m[38;5;10m+    369[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    370[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    371[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    372[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    373[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    374[0m:[38;5;10m[49m // Rows 22-23: NULL arr is safe whenever the guard rejects the call
[0m[49m[38;5;10m+    375[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    376[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    377[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    378[0m:[38;5;10m[49m fn err_shift_array_null_when_guard_fails() {
[0m[49m[38;5;10m+    379[0m:[38;5;10m[49m     let p = common::load_pair();
[0m[49m[38;5;10m+    380[0m:[38;5;10m[49m     // No NULL check exists, but `positions > 0 && positions < size` short
[0m[49m[38;5;10m+    381[0m:[38;5;10m[49m     // circuits before any load, so these calls must not touch memory.
[0m[49m[38;5;10m+    382[0m:[38;5;10m[49m     for (size, positions) in [
[0m[49m[38;5;10m+    383[0m:[38;5;10m[49m         (0i32, 0i32),
[0m[49m[38;5;10m+    384[0m:[38;5;10m[49m         (0, 1),
[0m[49m[38;5;10m+    385[0m:[38;5;10m[49m         (0, -1),
[0m[49m[38;5;10m+    386[0m:[38;5;10m[49m         (0, i32::MAX),
