[0m[49m[38;5;10m+    484[0m:[38;5;10m[49m                 assert_eq!(c, value, "operation={operation} must be identity");
[0m[49m[38;5;10m+    485[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    486[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    487[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    488[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    489[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    490[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    491[0m:[38;5;10m[49m // Row 28: negative `param1 % 4` falls into apply_bitmask's default:
[0m[49m[38;5;10m+    492[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    493[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    494[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    495[0m:[38;5;10m[49m fn err_arity4_negative_modulo_hits_default() {
[0m[49m[38;5;10m+    496[0m:[38;5;10m[49m     let p = common::load_pair();
[0m[49m[38;5;10m+    497[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0x28);
[0m[49m[38;5;10m+    498[0m:[38;5;10m[49m     for _ in 0..1000 {
[0m[49m[38;5;10m+    499[0m:[38;5;10m[49m         // param1 < 0 and not a multiple of 4 => param1 % 4 in {-1,-2,-3}.
[0m[49m[38;5;10m+    500[0m:[38;5;10m[49m         let k = rng.range_i32(0, 100_000) as i64;
[0m[49m[38;5;10m+    501[0m:[38;5;10m[49m         let m = rng.range_i32(1, 3) as i64;
[0m[49m[38;5;10m+    502[0m:[38;5;10m[49m         let param1 = (-4 * k - m) as c_int;
[0m[49m[38;5;10m+    503[0m:[38;5;10m[49m         assert!(param1 % 4 < 0, "sanity: C-style truncating remainder");
