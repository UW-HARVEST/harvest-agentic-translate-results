[0m[49m[38;5;10m+     436[0m:[38;5;10m[49m fn err23_hash_below_2_fixup() {
[0m[49m[38;5;10m+     437[0m:[38;5;10m[49m     // The fixup only fires for keys whose raw siphash / string hash is 0 or 1,
[0m[49m[38;5;10m+     438[0m:[38;5;10m[49m     // i.e. with probability 2^-63 per key.  A bounded search confirms it is
[0m[49m[38;5;10m+     439[0m:[38;5;10m[49m     // unreachable in practice AND that the two hash implementations agree on
[0m[49m[38;5;10m+     440[0m:[38;5;10m[49m     // every candidate examined, which is what makes the fixup equivalent.
[0m[49m[38;5;10m+     441[0m:[38;5;10m[49m     let (p, _g) = libs();
[0m[49m[38;5;10m+     442[0m:[38;5;10m[49m     let mut rng = Rng::new(0xC0FFEE ^ 23);
