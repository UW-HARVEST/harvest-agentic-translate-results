[0m[49m[38;5;10m+     444[0m:[38;5;10m[49m     for _ in 0..200_000 {
[0m[49m[38;5;10m+     445[0m:[38;5;10m[49m         let mut b = rng.bytes(8);
[0m[49m[38;5;10m+     446[0m:[38;5;10m[49m         let seed = rng.next_u64() as usize;
[0m[49m[38;5;10m+     447[0m:[38;5;10m[49m         unsafe {
[0m[49m[38;5;10m+     448[0m:[38;5;10m[49m             let x = (p.c.hash_bytes)(b.as_mut_ptr() as *mut c_void, 8, seed);
[0m[49m[38;5;10m+     449[0m:[38;5;10m[49m             let y = (p.rs.hash_bytes)(b.as_mut_ptr() as *mut c_void, 8, seed);
[0m[49m[38;5;10m+     450[0m:[38;5;10m[49m             assert_eq!(x, y);
[0m[49m[38;5;10m+     451[0m:[38;5;10m[49m             if x < 2 {
[0m[49m[38;5;10m+     452[0m:[38;5;10m[49m                 found += 1;
[0m[49m[38;5;10m+     453[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+     454[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+     455[0m:[38;5;10m[49m         let k = CKey::new(&rng.nonnul(1 + rng.below(16)));
[0m[49m[38;5;10m+     456[0m:[38;5;10m[49m         unsafe {
[0m[49m[38;5;10m+     457[0m:[38;5;10m[49m             let x = (p.c.hash_string)(k.ptr(), seed);
[0m[49m[38;5;10m+     458[0m:[38;5;10m[49m             let y = (p.rs.hash_string)(k.ptr(), seed);
