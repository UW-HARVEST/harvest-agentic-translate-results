import re
src = open('c_src/src/lib.c').read()

def extract_between(start_marker, end_marker):
    i = src.index(start_marker)
    j = src.index(end_marker, i)
    return src[i:j]

# ---- tflac_crc16_tables[8][256] ----
i = src.index('static const tflac_u16 tflac_crc16_tables[8][256] = {')
j = src.index('};', i)
body = src[i:j]
# find inner groups { ... }
groups = re.findall(r'\{([^{}]*)\}', body)
assert len(groups) == 8, len(groups)
crc = []
for g in groups:
    vals = re.findall(r'0x[0-9a-fA-F]+', g)
    assert len(vals) == 256, len(vals)
    crc.append(vals)

def arr_decl(name, ty, vals, per_line=8, nested=None):
    out = []
    if nested is None:
        out.append(f'static {name}: [{ty}; {len(vals)}] = [')
        for k in range(0, len(vals), per_line):
            out.append('    ' + ', '.join(v+ty for v in vals[k:k+per_line]) + ',')
        out.append('];')
    return '\n'.join(out)

lines = []
lines.append('//! Static lookup tables translated verbatim from c_src/src/lib.c.')
lines.append('#![allow(dead_code)]')
lines.append('')
lines.append('/// Verbatim translation of `static const tflac_u16 tflac_crc16_tables[8][256]`.')
lines.append('/// Unused by the C library (file-static, never referenced) but kept for fidelity.')
lines.append('pub static TFLAC_CRC16_TABLES: [[u16; 256]; 8] = [')
for g in crc:
    lines.append('    [')
    for k in range(0, 256, 8):
        lines.append('        ' + ', '.join(v+'u16' for v in g[k:k+8]) + ',')
    lines.append('    ],')
lines.append('];')
lines.append('')

# ---- m__mantissa[2048] ----
i = src.index('static uint32_t m__mantissa[2048] = {')
j = src.index('};', i)
