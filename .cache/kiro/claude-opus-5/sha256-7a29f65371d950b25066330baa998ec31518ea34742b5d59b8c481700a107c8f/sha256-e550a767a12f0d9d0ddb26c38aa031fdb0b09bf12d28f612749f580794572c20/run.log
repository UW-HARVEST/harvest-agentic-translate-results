import re
c = open('c_src/src/lib.c').read()
r = open('translation/src/tables.rs').read()

def carr(marker, count):
    i = c.index(marker); j = c.index('};', i)
    v = [int(x,16) for x in re.findall(r'0x[0-9a-fA-F]+', c[i:j])]
    assert len(v)==count, (marker, len(v))
    return v

def rarr(marker, count, suffix):
    i = r.index(marker); j = r.index('\n];', i)
    v = [int(x,16) for x in re.findall(r'0x([0-9a-fA-F]+)'+suffix, r[i:j])]
    assert len(v)==count, (marker, len(v))
    return v

pairs = [
 ('static const tflac_u16 tflac_crc16_tables[8][256] = {', 2048, 'pub static TFLAC_CRC16_TABLES', 'u16'),
 ('static uint32_t m__mantissa[2048] = {', 2048, 'pub static M_MANTISSA', 'u32'),
 ('static uint16_t m__offset[64] = {', 64, 'pub static M_OFFSET', 'u16'),
 ('static uint32_t m__exponent[64] = {', 64, 'pub static M_EXPONENT', 'u32'),
]
ok=True
for cm, n, rm, sfx in pairs:
    a = carr(cm, n); b = rarr(rm, n, sfx)
    same = a==b
    ok &= same
    print(f"{rm:32s} n={n:5d} identical={same}")
print("ALL TABLES IDENTICAL" if ok else "TABLE MISMATCH")
