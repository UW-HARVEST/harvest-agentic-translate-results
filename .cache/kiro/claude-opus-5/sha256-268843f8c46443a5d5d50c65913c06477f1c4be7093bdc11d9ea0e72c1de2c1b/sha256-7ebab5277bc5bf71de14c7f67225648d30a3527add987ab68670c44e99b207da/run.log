    30	use std::ffi::{c_char, c_int};
    31	
    32	unsafe extern "C" {
    33	    /// C `printf` from the platform libc. Used instead of Rust's own `stdout`
    34	    /// so that the emitted bytes and the stream buffering behaviour match the
    35	    /// original C library exactly (important when a C caller also writes to
    36	    /// stdout in the same process).
    37	    fn printf(format: *const c_char, ...) -> c_int;
    38	}
    39	
    40	/// `static int inner = 1;` from `static_alias`.
    41	///
    42	/// Function-local `static` storage in C has the lifetime of the whole program,
    43	/// so the value persists across every call to `static_alias` — including calls
    44	/// made from separate `driver` invocations.
    45	static mut INNER: c_int = 1;
    46	
    47	/// Translation of:
    48	///
    49	/// ```c
    50	/// int *static_alias(int *outer) {
    51	///   static int inner = 1;
    52	///   if (*outer >= inner) { inner += *outer; return &inner; }
    53	///   else                 { *outer += inner; return outer;  }
    54	/// }
    55	/// ```
    56	///
    57	/// The returned pointer aliases either the static `inner` or the caller's own
    58	/// object, which is the behaviour the original code intentionally exercises.
    59	/// Additions use wrapping arithmetic to mirror the two's-complement wraparound
    60	/// produced by mainstream C compilers (signed overflow is UB in C, so no
    61	/// behaviour is being "fixed" here).
    62	#[unsafe(no_mangle)]
    63	pub unsafe extern "C" fn static_alias(outer: *mut c_int) -> *mut c_int {
    64	    unsafe {
    65	        let inner: *mut c_int = &raw mut INNER;
    66	
    67	        if *outer >= *inner {
    68	            *inner = (*inner).wrapping_add(*outer);
    69	            inner
    70	        } else {
    71	            *outer = (*outer).wrapping_add(*inner);
    72	            outer
    73	        }
    74	    }
    75	}
    76	
    77	/// Translation of:
    78	///
    79	/// ```c
    80	/// void driver(int initial_value, int iterations) {
    81	///   int *running_sum = &initial_value;
    82	///   for (int i = 0; i < iterations; i++) {
    83	///     running_sum = static_alias(running_sum);
    84	///     printf("%d\n", *running_sum);
    85	///   }
    86	/// }
    87	/// ```
    88	///
    89	/// `initial_value` is a by-value parameter in C, so `&initial_value` points at
    90	/// the function's own mutable copy; `running_sum` starts out aliasing that copy
    91	/// and may later be redirected at the static `inner`.
    92	#[unsafe(no_mangle)]
    93	pub unsafe extern "C" fn driver(initial_value: c_int, iterations: c_int) {
    94	    unsafe {
    95	        let mut initial_value: c_int = initial_value;
    96	        let mut running_sum: *mut c_int = &raw mut initial_value;
    97	
    98	        let mut i: c_int = 0;
    99	        while i < iterations {
