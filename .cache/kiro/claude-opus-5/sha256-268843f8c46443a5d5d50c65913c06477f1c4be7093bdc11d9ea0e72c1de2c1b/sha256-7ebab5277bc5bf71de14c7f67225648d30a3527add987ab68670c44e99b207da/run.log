    41	 */
    42	void
    43	driver(int initial_value, int iterations) {
    44	  int *running_sum = &initial_value;
    45	  for (int i = 0; i < iterations; i++) {
    46	    running_sum = static_alias(running_sum);
    47	    printf("%d\n", *running_sum);
    48	  }
    49	  return;
    50	}
