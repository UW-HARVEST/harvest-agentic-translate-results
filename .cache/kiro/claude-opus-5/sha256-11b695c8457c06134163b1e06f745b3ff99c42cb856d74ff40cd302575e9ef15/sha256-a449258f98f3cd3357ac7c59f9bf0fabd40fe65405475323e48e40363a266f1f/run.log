[0m[49m[38;5;10m+    582[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    583[0m:[38;5;10m[49m // Broad sweeps: exhaustive short strings, then deterministic pseudo-random
[0m[49m[38;5;10m+    584[0m:[38;5;10m[49m // byte soup, to catch anything the enumerated cases missed.
[0m[49m[38;5;10m+    585[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    586[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    587[0m:[38;5;10m[49m /// Every y/n string up to `max_len`, against one operation and all params.
[0m[49m[38;5;10m+    588[0m:[38;5;10m[49m fn exhaustive_for_operation(op: &str, max_len: u32) {
[0m[49m[38;5;10m+    589[0m:[38;5;10m[49m     for len in 0..=max_len {
[0m[49m[38;5;10m+    590[0m:[38;5;10m[49m         for mask in 0u32..(1u32 << len) {
[0m[49m[38;5;10m+    591[0m:[38;5;10m[49m             let s: String = (0..len)
[0m[49m[38;5;10m+    592[0m:[38;5;10m[49m                 .map(|i| if mask >> i & 1 == 1 { 'y' } else { 'n' })
[0m[49m[38;5;10m+    593[0m:[38;5;10m[49m                 .collect();
[0m[49m[38;5;10m+    594[0m:[38;5;10m[49m             for p in ["0", "1", "2", "3"] {
[0m[49m[38;5;10m+    595[0m:[38;5;10m[49m                 assert_same(&input(op, p, &s));
[0m[49m[38;5;10m+    596[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    597[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    598[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    599[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    600[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    601[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    602[0m:[38;5;10m[49m fn exhaustive_short_strings_operation_0() {
[0m[49m[38;5;10m+    603[0m:[38;5;10m[49m     exhaustive_for_operation("0", 8);
[0m[49m[38;5;10m+    604[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    605[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    606[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    607[0m:[38;5;10m[49m fn exhaustive_short_strings_operation_1() {
[0m[49m[38;5;10m+    608[0m:[38;5;10m[49m     exhaustive_for_operation("1", 8);
[0m[49m[38;5;10m+    609[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    610[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    611[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    612[0m:[38;5;10m[49m fn exhaustive_short_strings_operation_2() {
[0m[49m[38;5;10m+    613[0m:[38;5;10m[49m     exhaustive_for_operation("2", 9);
[0m[49m[38;5;10m+    614[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    615[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    616[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    617[0m:[38;5;10m[49m fn exhaustive_short_strings_operation_3() {
[0m[49m[38;5;10m+    618[0m:[38;5;10m[49m     exhaustive_for_operation("3", 9);
[0m[49m[38;5;10m+    619[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    620[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    621[0m:[38;5;10m[49m /// Small deterministic PRNG so the sweep is reproducible run to run.
[0m[49m[38;5;10m+    622[0m:[38;5;10m[49m struct Rng(u64);
[0m[49m[38;5;10m+    623[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    624[0m:[38;5;10m[49m impl Rng {
[0m[49m[38;5;10m+    625[0m:[38;5;10m[49m     fn next_u32(&mut self) -> u32 {
[0m[49m[38;5;10m+    626[0m:[38;5;10m[49m         // xorshift64*
[0m[49m[38;5;10m+    627[0m:[38;5;10m[49m         let mut x = self.0;
[0m[49m[38;5;10m+    628[0m:[38;5;10m[49m         x ^= x >> 12;
[0m[49m[38;5;10m+    629[0m:[38;5;10m[49m         x ^= x << 25;
