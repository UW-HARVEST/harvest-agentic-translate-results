     1	//! Rust translation of `c_src/src/lib.c`.
     2	//!
     3	//! Behaviour is a faithful, byte-for-byte reproduction of the original C,
     4	//! including the bug in the third hue branch (the C source tests
     5	//! `h < 120.0f && h < 180.0f` where `h >= 120.0f && h < 180.0f` was clearly
     6	//! intended). That branch is therefore only reachable for `h < 0.0f`, which is
     7	//! preserved here deliberately.
     8	
     9	use std::ffi::c_float;
    10	
    11	/// Pure computation kernel: HSL triple in, RGB triple out.
    12	///
    13	/// Mirrors the C statement-for-statement so float rounding matches exactly.
    14	fn hsl_to_rgb_impl(src: [c_float; 3]) -> [c_float; 3] {
    15	    let h = src[0];
    16	    let s = src[1];
    17	    let l = src[2];
    18	
    19	    if s == 0.0 {
    20	        return [l, l, l];
    21	    }
    22	
    23	    // c = (1.0f - fabsf(2.0f * l - 1.0f)) * s;
    24	    let c = (1.0f32 - (2.0f32 * l - 1.0f32).abs()) * s;
    25	    // m = 1.0f * (l - 0.5f * c);
    26	    let m = 1.0f32 * (l - 0.5f32 * c);
    27	    // x = c * (1.0f - fabsf(fmodf(h / 60.0f, 2) - 1.0f));
    28	    // Rust's `%` on f32 is truncated remainder, i.e. identical to fmodf.
    29	    let x = c * (1.0f32 - ((h / 60.0f32) % 2.0f32 - 1.0f32).abs());
    30	
    31	    if h >= 0.0f32 && h < 60.0f32 {
    32	        [c + m, x + m, m]
    33	    } else if h >= 60.0f32 && h < 120.0f32 {
    34	        [x + m, c + m, m]
    35	    } else if h < 120.0f32 && h < 180.0f32 {
    36	        // Faithful reproduction of the original C condition (see module docs).
    37	        [m, c + m, x + m]
    38	    } else if h >= 180.0f32 && h < 240.0f32 {
    39	        [m, x + m, c + m]
    40	    } else if h >= 240.0f32 && h < 300.0f32 {
    41	        [x + m, m, c + m]
    42	    } else if h >= 300.0f32 && h < 360.0f32 {
    43	        [c + m, m, x + m]
    44	    } else {
    45	        [m, m, m]
    46	    }
    47	}
    48	
    49	/// C ABI entry point: `void hsl_to_rgb(float *dest, const float *src)`.
    50	///
    51	/// # Safety
    52	///
    53	/// `src` must point to at least 3 readable `float`s and `dest` to at least 3
    54	/// writable `float`s. As in the C original, `dest` and `src` may overlap: the
    55	/// source values are fully consumed before anything is written back.
    56	#[unsafe(no_mangle)]
    57	pub unsafe extern "C" fn hsl_to_rgb(dest: *mut c_float, src: *const c_float) {
    58	    // Read the inputs up front (as the C does into locals) so that overlapping
    59	    // `dest`/`src` buffers behave identically and no aliasing slices coexist.
    60	    let input = [
    61	        unsafe { *src.add(0) },
    62	        unsafe { *src.add(1) },
    63	        unsafe { *src.add(2) },
    64	    ];
    65	
    66	    let out = hsl_to_rgb_impl(input);
    67	
    68	    let dest = unsafe { std::slice::from_raw_parts_mut(dest, 3) };
    69	    dest.copy_from_slice(&out);
    70	}
