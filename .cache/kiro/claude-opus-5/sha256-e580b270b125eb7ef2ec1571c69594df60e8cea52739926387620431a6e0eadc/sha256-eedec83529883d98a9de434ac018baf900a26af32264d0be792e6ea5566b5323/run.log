[0m[49m[38;5;10m+    186[0m:[38;5;10m[49m /// path -- not even a newline.
[0m[49m[38;5;10m+    187[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    188[0m:[38;5;10m[49m fn harness_sanity() {
[0m[49m[38;5;10m+    189[0m:[38;5;10m[49m     assert_ne!(c_bin(), rust_bin(), "harness must compare two different binaries");
[0m[49m[38;5;10m+    190[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    191[0m:[38;5;10m[49m     let c_good = run(c_bin(), b"1");
[0m[49m[38;5;10m+    192[0m:[38;5;10m[49m     assert_eq!(c_good.stdout, b"helperGood1 string\n");
[0m[49m[38;5;10m+    193[0m:[38;5;10m[49m     assert_eq!(c_good.code, Some(0));
[0m[49m[38;5;10m+    194[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    195[0m:[38;5;10m[49m     let c_bad = run(c_bin(), b"0");
[0m[49m[38;5;10m+    196[0m:[38;5;10m[49m     assert_eq!(c_bad.stdout, b"", "the bad path prints nothing at all");
[0m[49m[38;5;10m+    197[0m:[38;5;10m[49m     assert_eq!(c_bad.code, Some(0));
[0m[49m[38;5;10m+    198[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    199[0m:[38;5;10m[49m     let r_good = run(rust_bin(), b"1");
[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m     assert_eq!(r_good.stdout, b"helperGood1 string\n");
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m     let r_bad = run(rust_bin(), b"0");
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m     assert_eq!(r_bad.stdout, b"");
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m 
