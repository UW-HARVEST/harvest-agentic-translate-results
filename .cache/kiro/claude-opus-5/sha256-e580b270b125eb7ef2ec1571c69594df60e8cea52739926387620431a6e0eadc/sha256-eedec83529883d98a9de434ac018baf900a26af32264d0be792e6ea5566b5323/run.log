[0m[49m[38;5;10m+    297[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    298[0m:[38;5;10m[49m // Phase C: matching failures -- input that never yields a number
[0m[49m[38;5;10m+    299[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    300[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    301[0m:[38;5;10m[49m /// On a matching failure `scanf` leaves `x` alone, so `x == 0` and `bad()` runs.
[0m[49m[38;5;10m+    302[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    303[0m:[38;5;10m[49m fn matching_failures_leave_x_zero() {
[0m[49m[38;5;10m+    304[0m:[38;5;10m[49m     for s in [
[0m[49m[38;5;10m+    305[0m:[38;5;10m[49m         "abc", "x", "z9", "-", "+", "--1", "++1", "-+1", "+-1", ".", ".5", "-.5", "+.5", "/", ":",
[0m[49m[38;5;10m+    306[0m:[38;5;10m[49m         "0x", "e", "E", "nan", "inf", "NULL", "#", "!", "~", "'", "\"", "?", "%", "%d", "*", "*1",
[0m[49m[38;5;10m+    307[0m:[38;5;10m[49m         " -", " +", "\n-", "- 1", "+ 1", "-\n1", "(1)", "[1]", "\\1",
[0m[49m[38;5;10m+    308[0m:[38;5;10m[49m     ] {
[0m[49m[38;5;10m+    309[0m:[38;5;10m[49m         assert_same_str(s, s);
[0m[49m[38;5;10m+    310[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    311[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    312[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    313[0m:[38;5;10m[49m /// Bytes that are neither digits, signs nor whitespace, including non-UTF-8.
[0m[49m[38;5;10m+    314[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    315[0m:[38;5;10m[49m fn non_ascii_and_control_bytes() {
[0m[49m[38;5;10m+    316[0m:[38;5;10m[49m     assert_same("NUL first", b"\x00");
[0m[49m[38;5;10m+    317[0m:[38;5;10m[49m     assert_same("NUL then digit", b"\x001");
[0m[49m[38;5;10m+    318[0m:[38;5;10m[49m     assert_same("high byte", b"\xff");
[0m[49m[38;5;10m+    319[0m:[38;5;10m[49m     assert_same("invalid utf8", b"\xff\xfe\x801");
[0m[49m[38;5;10m+    320[0m:[38;5;10m[49m     assert_same("utf8 minus sign", "\u{2212}5".as_bytes());
[0m[49m[38;5;10m+    321[0m:[38;5;10m[49m     assert_same("utf8 digit", "\u{ff11}".as_bytes()); // fullwidth 1
[0m[49m[38;5;10m+    322[0m:[38;5;10m[49m     assert_same("bom then 1", b"\xef\xbb\xbf1");
[0m[49m[38;5;10m+    323[0m:[38;5;10m[49m     assert_same("bell", b"\x071");
[0m[49m[38;5;10m+    324[0m:[38;5;10m[49m     assert_same("escape", b"\x1b[0m1");
[0m[49m[38;5;10m+    325[0m:[38;5;10m[49m     assert_same("del", b"\x7f1");
[0m[49m[38;5;10m+    326[0m:[38;5;10m[49m     assert_same("all non-ws control bytes", &(1u8..=8).collect::<Vec<u8>>());
[0m[49m[38;5;10m+    327[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    328[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    329[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    330[0m:[38;5;10m[49m // Phase C: integer range, truncation and signedness exactly as C does it
[0m[49m[38;5;10m+    331[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    332[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    333[0m:[38;5;10m[49m /// glibc's `%d` converts with `strtol` semantics into a `long`, then stores
[0m[49m[38;5;10m+    334[0m:[38;5;10m[49m /// through an `int *`. Out-of-range input therefore *saturates* at
[0m[49m[38;5;10m+    335[0m:[38;5;10m[49m /// `LONG_MAX`/`LONG_MIN` and is then *truncated* to 32 bits -- it does not clamp
[0m[49m[38;5;10m+    336[0m:[38;5;10m[49m /// to `INT_MAX`/`INT_MIN`. Truncation is observable because it decides which
[0m[49m[38;5;10m+    337[0m:[38;5;10m[49m /// branch runs: `4294967296` truncates to 0 and takes the bad path even though
[0m[49m[38;5;10m+    338[0m:[38;5;10m[49m /// the number is nonzero.
[0m[49m[38;5;10m+    339[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    340[0m:[38;5;10m[49m fn int_range_edges() {
[0m[49m[38;5;10m+    341[0m:[38;5;10m[49m     for s in [
[0m[49m[38;5;10m+    342[0m:[38;5;10m[49m         "2147483647",  // INT_MAX
[0m[49m[38;5;10m+    343[0m:[38;5;10m[49m         "-2147483648", // INT_MIN
[0m[49m[38;5;10m+    344[0m:[38;5;10m[49m         "2147483648",  // INT_MAX + 1 -> 0x80000000 -> INT_MIN, nonzero
[0m[49m[38;5;10m+    345[0m:[38;5;10m[49m         "-2147483649",
[0m[49m[38;5;10m+    346[0m:[38;5;10m[49m         "4294967295", // 2^32 - 1 -> -1, nonzero
[0m[49m[38;5;10m+    347[0m:[38;5;10m[49m         "4294967296", // 2^32     -> 0, BAD branch despite nonzero input
[0m[49m[38;5;10m+    348[0m:[38;5;10m[49m         "4294967297", // 2^32 + 1 -> 1, nonzero
[0m[49m[38;5;10m+    349[0m:[38;5;10m[49m         "-4294967295",
[0m[49m[38;5;10m+    350[0m:[38;5;10m[49m         "-4294967296", // -2^32 -> 0, bad branch
[0m[49m[38;5;10m+    351[0m:[38;5;10m[49m         "-4294967297",
[0m[49m[38;5;10m+    352[0m:[38;5;10m[49m         "8589934592", // 2^33 -> 0
[0m[49m[38;5;10m+    353[0m:[38;5;10m[49m         "1099511627776",
[0m[49m[38;5;10m+    354[0m:[38;5;10m[49m     ] {
[0m[49m[38;5;10m+    355[0m:[38;5;10m[49m         assert_same_str(s, s);
[0m[49m[38;5;10m+    356[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    357[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    358[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    359[0m:[38;5;10m[49m /// Values at and beyond the `long` range, where `strtol` saturates.
[0m[49m[38;5;10m+    360[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    361[0m:[38;5;10m[49m fn long_range_saturation() {
[0m[49m[38;5;10m+    362[0m:[38;5;10m[49m     for s in [
[0m[49m[38;5;10m+    363[0m:[38;5;10m[49m         "9223372036854775807",  // LONG_MAX      -> low 32 bits 0xffffffff
[0m[49m[38;5;10m+    364[0m:[38;5;10m[49m         "9223372036854775808",  // LONG_MAX + 1  -> saturates to LONG_MAX
[0m[49m[38;5;10m+    365[0m:[38;5;10m[49m         "-9223372036854775808", // LONG_MIN      -> low 32 bits 0
[0m[49m[38;5;10m+    366[0m:[38;5;10m[49m         "-9223372036854775809", // beyond        -> saturates to LONG_MIN
[0m[49m[38;5;10m+    367[0m:[38;5;10m[49m         "10000000000000000000",
[0m[49m[38;5;10m+    368[0m:[38;5;10m[49m         "18446744073709551615", // 2^64 - 1
[0m[49m[38;5;10m+    369[0m:[38;5;10m[49m         "18446744073709551616", // 2^64
[0m[49m[38;5;10m+    370[0m:[38;5;10m[49m         "99999999999999999999999999",
[0m[49m[38;5;10m+    371[0m:[38;5;10m[49m         "-99999999999999999999999999",
[0m[49m[38;5;10m+    372[0m:[38;5;10m[49m     ] {
[0m[49m[38;5;10m+    373[0m:[38;5;10m[49m         assert_same_str(s, s);
[0m[49m[38;5;10m+    374[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    375[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    376[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    377[0m:[38;5;10m[49m /// Digit strings far past any integer width, and leading zeros that make a
[0m[49m[38;5;10m+    378[0m:[38;5;10m[49m /// short number look long.
[0m[49m[38;5;10m+    379[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    380[0m:[38;5;10m[49m fn very_long_digit_strings() {
[0m[49m[38;5;10m+    381[0m:[38;5;10m[49m     assert_same_str("1000 nines", &"9".repeat(1000));
[0m[49m[38;5;10m+    382[0m:[38;5;10m[49m     assert_same_str("negative 1000 nines", &format!("-{}", "9".repeat(1000)));
[0m[49m[38;5;10m+    383[0m:[38;5;10m[49m     assert_same_str("1000 zeros", &"0".repeat(1000));
[0m[49m[38;5;10m+    384[0m:[38;5;10m[49m     assert_same_str("negative 1000 zeros", &format!("-{}", "0".repeat(1000)));
[0m[49m[38;5;10m+    385[0m:[38;5;10m[49m     assert_same_str("1000 zeros then 1", &format!("{}1", "0".repeat(1000)));
[0m[49m[38;5;10m+    386[0m:[38;5;10m[49m     assert_same_str("10000 nines", &"9".repeat(10_000));
[0m[49m[38;5;10m+    387[0m:[38;5;10m[49m     assert_same_str("1 then 1000 zeros", &format!("1{}", "0".repeat(1000)));
[0m[49m[38;5;10m+    388[0m:[38;5;10m[49m     assert_same_str("alternating", &"12".repeat(600));
[0m[49m[38;5;10m+    389[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    390[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    391[0m:[38;5;10m[49m /// A sign followed by many digits, and signs in positions `%d` rejects.
[0m[49m[38;5;10m+    392[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    393[0m:[38;5;10m[49m fn sign_handling() {
[0m[49m[38;5;10m+    394[0m:[38;5;10m[49m     assert_same_str("+2147483647", "+2147483647");
[0m[49m[38;5;10m+    395[0m:[38;5;10m[49m     assert_same_str("+0000000001", "+0000000001");
[0m[49m[38;5;10m+    396[0m:[38;5;10m[49m     assert_same_str("-0000000000", "-0000000000");
[0m[49m[38;5;10m+    397[0m:[38;5;10m[49m     assert_same_str("-0000000001", "-0000000001");
[0m[49m[38;5;10m+    398[0m:[38;5;10m[49m     assert_same_str("sign at EOF", "-");
[0m[49m[38;5;10m+    399[0m:[38;5;10m[49m     assert_same_str("plus at EOF", "+");
[0m[49m[38;5;10m+    400[0m:[38;5;10m[49m     assert_same_str("sign then space", "- ");
[0m[49m[38;5;10m+    401[0m:[38;5;10m[49m     assert_same_str("sign then newline", "-\n");
[0m[49m[38;5;10m+    402[0m:[38;5;10m[49m     assert_same_str("1-2", "1-2");
[0m[49m[38;5;10m+    403[0m:[38;5;10m[49m     assert_same_str("1+2", "1+2");
[0m[49m[38;5;10m+    404[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    405[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    406[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    407[0m:[38;5;10m[49m // Phase C: stdin shapes other than a plain pipe write
[0m[49m[38;5;10m+    408[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    409[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    410[0m:[38;5;10m[49m /// stdin closed immediately: read returns EOF, same as empty input.
[0m[49m[38;5;10m+    411[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    412[0m:[38;5;10m[49m fn stdin_closed_immediately() {
[0m[49m[38;5;10m+    413[0m:[38;5;10m[49m     let c = {
[0m[49m[38;5;10m+    414[0m:[38;5;10m[49m         let child = Command::new(c_bin())
[0m[49m[38;5;10m+    415[0m:[38;5;10m[49m             .stdin(Stdio::null())
[0m[49m[38;5;10m+    416[0m:[38;5;10m[49m             .stdout(Stdio::piped())
[0m[49m[38;5;10m+    417[0m:[38;5;10m[49m             .stderr(Stdio::piped())
[0m[49m[38;5;10m+    418[0m:[38;5;10m[49m             .spawn()
[0m[49m[38;5;10m+    419[0m:[38;5;10m[49m             .expect("spawn C");
[0m[49m[38;5;10m+    420[0m:[38;5;10m[49m         child.wait_with_output().expect("collect C")
[0m[49m[38;5;10m+    421[0m:[38;5;10m[49m     };
[0m[49m[38;5;10m+    422[0m:[38;5;10m[49m     let r = {
[0m[49m[38;5;10m+    423[0m:[38;5;10m[49m         let child = Command::new(rust_bin())
[0m[49m[38;5;10m+    424[0m:[38;5;10m[49m             .stdin(Stdio::null())
[0m[49m[38;5;10m+    425[0m:[38;5;10m[49m             .stdout(Stdio::piped())
[0m[49m[38;5;10m+    426[0m:[38;5;10m[49m             .stderr(Stdio::piped())
[0m[49m[38;5;10m+    427[0m:[38;5;10m[49m             .spawn()
[0m[49m[38;5;10m+    428[0m:[38;5;10m[49m             .expect("spawn Rust");
[0m[49m[38;5;10m+    429[0m:[38;5;10m[49m         child.wait_with_output().expect("collect Rust")
[0m[49m[38;5;10m+    430[0m:[38;5;10m[49m     };
[0m[49m[38;5;10m+    431[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    432[0m:[38;5;10m[49m     assert_eq!(Escaped(&c.stdout).to_debug(), Escaped(&r.stdout).to_debug(), "stdout with /dev/null stdin");
[0m[49m[38;5;10m+    433[0m:[38;5;10m[49m     assert_eq!(Escaped(&c.stderr).to_debug(), Escaped(&r.stderr).to_debug(), "stderr with /dev/null stdin");
[0m[49m[38;5;10m+    434[0m:[38;5;10m[49m     assert_eq!(c.status.code(), r.status.code(), "exit code with /dev/null stdin");
[0m[49m[38;5;10m+    435[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    436[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    437[0m:[38;5;10m[49m impl Escaped<'_> {
[0m[49m[38;5;10m+    438[0m:[38;5;10m[49m     fn to_debug(&self) -> String {
[0m[49m[38;5;10m+    439[0m:[38;5;10m[49m         format!("{self:?}")
[0m[49m[38;5;10m+    440[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    441[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    442[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    443[0m:[38;5;10m[49m /// A large input where the number appears only after more bytes than any single
[0m[49m[38;5;10m+    444[0m:[38;5;10m[49m /// stdio buffer, so buffered and unbuffered readers must still agree.
[0m[49m[38;5;10m+    445[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    446[0m:[38;5;10m[49m fn input_larger_than_a_stdio_buffer() {
[0m[49m[38;5;10m+    447[0m:[38;5;10m[49m     assert_same_str("64KiB of spaces then 1", &format!("{}1", " ".repeat(64 * 1024)));
[0m[49m[38;5;10m+    448[0m:[38;5;10m[49m     assert_same_str("64KiB of newlines then 0", &format!("{}0", "\n".repeat(64 * 1024)));
[0m[49m[38;5;10m+    449[0m:[38;5;10m[49m     assert_same_str("1 then 64KiB of junk", &format!("1{}", "x".repeat(64 * 1024)));
[0m[49m[38;5;10m+    450[0m:[38;5;10m[49m     assert_same_str("0 then 64KiB of junk", &format!("0{}", "x".repeat(64 * 1024)));
[0m[49m[38;5;10m+    451[0m:[38;5;10m[49m     assert_same_str("junk then number", &format!("{}1", "x".repeat(64 * 1024)));
[0m[49m[38;5;10m+    452[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    453[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    454[0m:[38;5;10m[49m /// stdout is a pipe whose reader has already gone away by the time the program
[0m[49m[38;5;10m+    455[0m:[38;5;10m[49m /// writes. A C program inherits the default `SIGPIPE` disposition and dies with
[0m[49m[38;5;10m+    456[0m:[38;5;10m[49m /// signal 13 (status 141 through a shell); the Rust runtime ignores `SIGPIPE`
[0m[49m[38;5;10m+    457[0m:[38;5;10m[49m /// unless that is undone, which would make it exit 0 instead.
[0m[49m[38;5;10m+    458[0m:[38;5;10m[49m ///
[0m[49m[38;5;10m+    459[0m:[38;5;10m[49m /// The `sleep` delays the program's only write until well after the reader has
[0m[49m[38;5;10m+    460[0m:[38;5;10m[49m /// exited, so the closed pipe is not a race. The assertion is differential, so
[0m[49m[38;5;10m+    461[0m:[38;5;10m[49m /// this test is meaningful on any platform without needing to be skipped.
[0m[49m[38;5;10m+    462[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    463[0m:[38;5;10m[49m fn sigpipe_disposition_matches() {
[0m[49m[38;5;10m+    464[0m:[38;5;10m[49m     fn status_via_shell(bin: &Path) -> Option<String> {
[0m[49m[38;5;10m+    465[0m:[38;5;10m[49m         let script = format!(
[0m[49m[38;5;10m+    466[0m:[38;5;10m[49m             "{{ sleep 0.5; printf 1; }} | {} 2>/dev/null | true; printf '%s' \"${{PIPESTATUS[1]}}\"",
[0m[49m[38;5;10m+    467[0m:[38;5;10m[49m             shell_quote(bin)
[0m[49m[38;5;10m+    468[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    469[0m:[38;5;10m[49m         let out = Command::new("bash").arg("-c").arg(&script).output().ok()?;
[0m[49m[38;5;10m+    470[0m:[38;5;10m[49m         Some(String::from_utf8_lossy(&out.stdout).trim().to_string())
[0m[49m[38;5;10m+    471[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    472[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    473[0m:[38;5;10m[49m     let c = status_via_shell(c_bin());
[0m[49m[38;5;10m+    474[0m:[38;5;10m[49m     let r = status_via_shell(rust_bin());
[0m[49m[38;5;10m+    475[0m:[38;5;10m[49m     assert_eq!(c, r, "exit status on SIGPIPE differs (C={c:?}, Rust={r:?})");
[0m[49m[38;5;10m+    476[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    477[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    478[0m:[38;5;10m[49m fn shell_quote(p: &Path) -> String {
