import re
p='tests/c1_errors_core.rs'
s=open(p).read()

# Replace the fn cmp2 with a macro
s=s.replace('''/// Compare (ret, errno) from a C call and a Rust call.
#[track_caller]
fn cmp2(ctx: &str, c: impl FnOnce() -> i32, r: impl FnOnce() -> i32) -> i32 {
    let (a, ea) = with_errno(c);
    let (b, eb) = with_errno(r);
    assert_eq!(a, b, "{ctx}: return differs (C={a} Rust={b})");
    assert_eq!(ea, eb, "{ctx}: errno differs (C={ea} Rust={eb})");
    a
}''','''/// Compare (ret, errno) from a C call and a Rust call.
///
/// A macro rather than a function so both calls are sequenced statements and
/// may therefore both take `&mut` of the same output buffer.
macro_rules! cmp2 {
    ($ctx:expr, $cexpr:expr, $rexpr:expr) => {{
        let ctx: &str = &$ctx;
        set_errno(0);
        let a: i32 = unsafe { $cexpr };
        let ea = errno();
        set_errno(0);
        let b: i32 = unsafe { $rexpr };
        let eb = errno();
        assert_eq!(a, b, "{}: return differs (C={} Rust={})", ctx, a, b);
        assert_eq!(ea, eb, "{}: errno differs (C={} Rust={})", ctx, ea, eb);
        a
    }};
}''')

# Rewrite every cmp2( ctx, || unsafe { X }, || unsafe { Y }, ) call into cmp2!(ctx, X, Y)
pat = re.compile(
    r'cmp2\(\s*(?P<ctx>(?:&format!\([^\n]*\)|"[^"\n]*"|&?\w+)),\s*'
    r'\|\| unsafe \{ (?P<c>.*?) \},\s*'
    r'\|\| unsafe \{ (?P<r>.*?) \},\s*\)',
    re.S)
def rep(m):
    return 'cmp2!(%s, %s, %s)' % (m.group('ctx'), m.group('c').strip(), m.group('r').strip())
s, n = pat.subn(rep, s)
print("rewrote", n, "cmp2 calls")

# Same problem for with_errno double-borrow: rewrite `let (_, e) = with_errno(|| unsafe { X });`
s = re.sub(r'let \(_, e\) = with_errno\(\|\| unsafe \{\s*(.*?)\s*\}\);',
           r'set_errno(0);\n        let _ = unsafe { \1 };\n        let e = errno();', s, flags=re.S)
open(p,'w').write(s)
