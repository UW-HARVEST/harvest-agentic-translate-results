[0m[49m[38;5;10m+    336[0m:[38;5;10m[49m         let mut z = self.0;
[0m[49m[38;5;10m+    337[0m:[38;5;10m[49m         z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
[0m[49m[38;5;10m+    338[0m:[38;5;10m[49m         z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
[0m[49m[38;5;10m+    339[0m:[38;5;10m[49m         z ^ (z >> 31)
[0m[49m[38;5;10m+    340[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    341[0m:[38;5;10m[49m     /// Uniform-ish in `[lo, hi]` inclusive.
