[0m[49m[38;5;10m+    934[0m:[38;5;10m[49m         !c_syms.is_empty(),
[0m[49m[38;5;10m+    935[0m:[38;5;10m[49m         "parsed no exported symbols from the C .so; nm output was:\n{text}"
[0m[49m[38;5;10m+    936[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    937[0m:[38;5;10m[49m     assert!(
[0m[49m[38;5;10m+    938[0m:[38;5;10m[49m         c_syms.iter().any(|s| s == "driver") && c_syms.iter().any(|s| s == "printLine"),
[0m[49m[38;5;10m+    939[0m:[38;5;10m[49m         "expected both `driver` and `printLine` among the C exports, got {c_syms:?}"
[0m[49m[38;5;10m+    940[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    941[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    942[0m:[38;5;10m[49m     let rp = rust_so_path();
