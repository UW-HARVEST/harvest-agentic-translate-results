[0m[49m[38;5;10m+    918[0m:[38;5;10m[49m             let name = it.next()?;
[0m[49m[38;5;10m+    919[0m:[38;5;10m[49m             let kind = it.next()?;
[0m[49m[38;5;10m+    920[0m:[38;5;10m[49m             // Global text/data symbols only; skip ld/glibc bookkeeping.
[0m[49m[38;5;10m+    921[0m:[38;5;10m[49m             if !matches!(kind, "T" | "D" | "B" | "R" | "W" | "i") {
[0m[49m[38;5;10m+    922[0m:[38;5;10m[49m                 return None;
[0m[49m[38;5;10m+    923[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    924[0m:[38;5;10m[49m             if name.starts_with('_') {
