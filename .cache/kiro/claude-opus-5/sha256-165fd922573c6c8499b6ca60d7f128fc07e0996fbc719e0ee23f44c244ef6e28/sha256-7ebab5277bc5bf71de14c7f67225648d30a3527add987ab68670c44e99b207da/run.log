     1	//! Translation of `c_src/src/driver.c`.
     2	
     3	use std::ffi::c_char;
     4	use std::ffi::c_int;
     5	
     6	use crate::cutil::{EXIT_FAILURE, EXIT_SUCCESS, free};
     7	use crate::matrix::{free_matrix, initialize_matrix_from_string, matrix_to_string, multiply_matrices};
     8	use crate::write::write_to_file;
     9	
    10	const OUT_FILE: &std::ffi::CStr = c"matrix.txt";
    11	
    12	#[unsafe(no_mangle)]
    13	pub extern "C" fn driver(
    14	    width_a: c_int,
    15	    height_a: c_int,
    16	    matrix_a: *const c_char,
    17	    width_b: c_int,
    18	    height_b: c_int,
    19	    matrix_b: *const c_char,
    20	) -> c_int {
    21	    let mat_a = initialize_matrix_from_string(matrix_a, width_a, height_a);
    22	    if mat_a.is_null() {
    23	        return EXIT_FAILURE;
    24	    }
    25	    let mat_b = initialize_matrix_from_string(matrix_b, width_b, height_b);
    26	    if mat_b.is_null() {
    27	        free_matrix(mat_a);
    28	        return EXIT_FAILURE;
    29	    }
    30	
    31	    let res = multiply_matrices(mat_a, mat_b);
    32	    if res.is_null() {
    33	        free_matrix(mat_a);
    34	        free_matrix(mat_b);
    35	        return EXIT_FAILURE;
    36	    }
    37	    let res_str = matrix_to_string(res);
    38	    if res_str.is_null() {
    39	        free_matrix(mat_a);
    40	        free_matrix(mat_b);
    41	        // NOTE: the original calls plain free() here rather than free_matrix(),
    42	        // leaking the rows. Reproduced as-is.
    43	        unsafe { free(res as *mut u8) };
    44	        return EXIT_FAILURE;
    45	    }
    46	
    47	    let res_write = write_to_file(OUT_FILE.as_ptr(), res_str);
    48	
    49	    free_matrix(mat_a);
    50	    free_matrix(mat_b);
    51	    free_matrix(res);
    52	    unsafe { free(res_str as *mut u8) };
    53	
    54	    if res_write != 0 {
    55	        return EXIT_FAILURE;
    56	    }
    57	
    58	    EXIT_SUCCESS
    59	}
