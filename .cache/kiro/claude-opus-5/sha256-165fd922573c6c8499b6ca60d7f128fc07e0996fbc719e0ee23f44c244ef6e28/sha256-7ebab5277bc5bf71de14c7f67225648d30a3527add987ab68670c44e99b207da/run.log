     1	//! Rust translation of the C `driver` library (matrix multiply + file write).
     2	//!
     3	//! Behaviour, error ordering, messages and return codes mirror the original C
     4	//! exactly, including its bugs (unchecked allocations, the `free()` instead of
     5	//! `free_matrix()` in `driver`).
     6	
     7	#![allow(non_camel_case_types)]
     8	
     9	mod cutil;
    10	mod driver;
    11	mod matrix;
    12	mod write;
    13	
    14	pub use driver::driver;
    15	pub use matrix::{
    16	    allocate_matrix, free_matrix, initialize_matrix_from_string, matrix_to_string,
    17	    multiply_matrices, matrix_t,
    18	};
    19	pub use write::write_to_file;
===== src/cutil.rs =====
     1	//! Minimal bindings to the pieces of the C runtime that the original program
     2	//! relies on, plus faithful re-implementations of the libc helpers whose exact
     3	//! behaviour is observable (`atoi`, `strtok_r`, `perror`).
     4	//!
     5	//! Heap blocks handed out to / freed by callers must come from the same
     6	//! allocator the C version used, because callers still call `free()` on them
     7	//! (`driver()` itself does). Hence `malloc`/`free` rather than Rust's allocator.
     8	
     9	use std::ffi::c_char;
    10	use std::ffi::c_int;
    11	use std::io::Write;
    12	
    13	#[repr(C)]
    14	pub struct FILE {
    15	    _opaque: [u8; 0],
    16	}
    17	
    18	unsafe extern "C" {
    19	    pub fn malloc(size: usize) -> *mut u8;
    20	    pub fn realloc(ptr: *mut u8, size: usize) -> *mut u8;
    21	    pub fn free(ptr: *mut u8);
    22	
    23	    pub fn strerror(errnum: c_int) -> *const c_char;
    24	
    25	    pub fn fopen(path: *const c_char, mode: *const c_char) -> *mut FILE;
    26	    pub fn fputs(s: *const c_char, stream: *mut FILE) -> c_int;
    27	    pub fn fclose(stream: *mut FILE) -> c_int;
    28	}
    29	
    30	/// `EINVAL` on Linux.
    31	pub const EINVAL: c_int = 22;
    32	
    33	/// `EXIT_SUCCESS` / `EXIT_FAILURE` from `<stdlib.h>`.
    34	pub const EXIT_SUCCESS: c_int = 0;
    35	pub const EXIT_FAILURE: c_int = 1;
    36	
    37	/// Current value of `errno`.
    38	pub fn errno() -> c_int {
    39	    std::io::Error::last_os_error().raw_os_error().unwrap_or(0)
    40	}
    41	
    42	/// `strerror(errnum)` as a byte string (no trailing NUL).
    43	pub fn strerror_bytes(errnum: c_int) -> Vec<u8> {
    44	    let mut out = Vec::new();
    45	    unsafe {
    46	        let mut p = strerror(errnum);
    47	        if !p.is_null() {
    48	            while *p != 0 {
    49	                out.push(*p as u8);
    50	                p = p.add(1);
    51	            }
    52	        }
    53	    }
    54	    out
    55	}
    56	
    57	/// Write raw bytes to stderr. C's `stderr` is unbuffered and so is Rust's, so
    58	/// this is byte-for-byte equivalent to `fprintf(stderr, ...)`.
    59	pub fn stderr_write(bytes: &[u8]) {
    60	    let mut err = std::io::stderr();
    61	    let _ = err.write_all(bytes);
    62	    let _ = err.flush();
    63	}
    64	
    65	/// `perror(msg)`: `"<msg>: <strerror(errno)>\n"` on stderr.
    66	pub fn perror(msg: &str) {
    67	    let mut buf = Vec::with_capacity(msg.len() + 32);
    68	    buf.extend_from_slice(msg.as_bytes());
    69	    buf.extend_from_slice(b": ");
    70	    buf.extend_from_slice(&strerror_bytes(errno()));
    71	    buf.push(b'\n');
    72	    stderr_write(&buf);
    73	}
    74	
    75	/// C's `int`-to-`size_t` conversion: sign-extend, then reinterpret.
    76	#[inline]
    77	pub fn int_to_size_t(v: c_int) -> usize {
    78	    v as isize as usize
    79	}
    80	
    81	/// `strlen`.
    82	///
    83	/// # Safety
    84	/// `s` must point to a NUL-terminated buffer.
    85	pub unsafe fn strlen(s: *const c_char) -> usize {
    86	    let mut n = 0usize;
    87	    unsafe {
    88	        while *s.add(n) != 0 {
    89	            n += 1;
    90	        }
    91	    }
    92	    n
    93	}
    94	
    95	/// `strdup`: `malloc` a copy of the NUL-terminated string at `s`.
    96	///
    97	/// # Safety
    98	/// `s` must point to a NUL-terminated buffer.
    99	pub unsafe fn strdup(s: *const c_char) -> *mut c_char {
   100	    unsafe {
   101	        let len = strlen(s);
   102	        let buf = malloc(len + 1);
   103	        if buf.is_null() {
   104	            return std::ptr::null_mut();
   105	        }
   106	        std::ptr::copy_nonoverlapping(s as *const u8, buf, len + 1);
   107	        buf as *mut c_char
   108	    }
   109	}
   110	
   111	/// `strtok_r` restricted to a single delimiter byte, which is all the original
   112	/// code uses (`"\n"` and `" "`). Semantics match glibc: leading delimiters are
   113	/// skipped, the delimiter that terminates the token is overwritten with NUL,
   114	/// and NULL is returned once nothing but delimiters remain.
   115	///
   116	/// # Safety
   117	/// `s` (when non-null) and `*saveptr` must point into a writable
   118	/// NUL-terminated buffer.
   119	pub unsafe fn strtok_r(s: *mut c_char, delim: u8, saveptr: &mut *mut c_char) -> *mut c_char {
   120	    unsafe {
   121	        let mut cur = if s.is_null() { *saveptr } else { s };
   122	
   123	        // Skip leading delimiters.
   124	        while *cur != 0 && *cur as u8 == delim {
   125	            cur = cur.add(1);
   126	        }
   127	
   128	        if *cur == 0 {
   129	            *saveptr = cur;
   130	            return std::ptr::null_mut();
   131	        }
   132	
   133	        let token = cur;
   134	
   135	        // Find the end of the token.
   136	        while *cur != 0 && *cur as u8 != delim {
   137	            cur = cur.add(1);
   138	        }
   139	
   140	        if *cur == 0 {
   141	            *saveptr = cur;
   142	        } else {
   143	            *cur = 0;
   144	            *saveptr = cur.add(1);
   145	        }
   146	
   147	        token
   148	    }
   149	}
   150	
   151	#[inline]
   152	fn is_c_space(b: u8) -> bool {
   153	    matches!(b, b' ' | b'\t' | b'\n' | 0x0b | 0x0c | b'\r')
   154	}
   155	
   156	/// `atoi`, matching glibc: it is `(int) strtol(s, NULL, 10)`, so out-of-range
   157	/// input saturates at `LONG_MAX`/`LONG_MIN` and is then truncated to `int`.
   158	///
   159	/// # Safety
   160	/// `s` must point to a NUL-terminated buffer.
   161	pub unsafe fn atoi(s: *const c_char) -> c_int {
   162	    unsafe {
   163	        let mut p = s;
   164	
   165	        while is_c_space(*p as u8) {
   166	            p = p.add(1);
   167	        }
   168	
   169	        let mut negative = false;
   170	        if *p as u8 == b'-' {
   171	            negative = true;
   172	            p = p.add(1);
   173	        } else if *p as u8 == b'+' {
   174	            p = p.add(1);
   175	        }
   176	
   177	        // Accumulate as unsigned magnitude, saturating like strtol does.
   178	        let limit: u64 = if negative {
   179	            i64::MIN.unsigned_abs()
   180	        } else {
   181	            i64::MAX as u64
   182	        };
   183	
   184	        let mut acc: u64 = 0;
   185	        let mut overflow = false;
   186	        while (*p as u8).is_ascii_digit() {
   187	            let digit = ((*p as u8) - b'0') as u64;
   188	            if !overflow {
   189	                match acc.checked_mul(10).and_then(|v| v.checked_add(digit)) {
   190	                    Some(v) if v <= limit => acc = v,
   191	                    _ => {
   192	                        overflow = true;
   193	                        acc = limit;
   194	                    }
   195	                }
   196	            }
   197	            p = p.add(1);
   198	        }
   199	
   200	        let as_long: i64 = if negative {
   201	            (acc as i64).wrapping_neg()
   202	        } else {
   203	            acc as i64
   204	        };
   205	
   206	        as_long as c_int
   207	    }
   208	}
