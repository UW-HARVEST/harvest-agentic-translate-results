   141	#[unsafe(no_mangle)]
   142	pub extern "C" fn multiply_matrices(mat_a: *mut matrix_t, mat_b: *mut matrix_t) -> *mut matrix_t {
   143	    unsafe {
   144	        if (*mat_a).width != (*mat_b).height {
   145	            stderr_write(b"Matrix dimensions do not allow multiplication.\n");
   146	            return std::ptr::null_mut();
   147	        }
   148	
   149	        // NOTE: as in the original, the result of `allocate_matrix` is not
   150	        // checked for NULL.
   151	        let result = allocate_matrix((*mat_b).width, (*mat_a).height);
   152	
   153	        let mut i: c_int = 0;
   154	        while i < (*mat_a).height {
   155	            let mut j: c_int = 0;
   156	            while j < (*mat_b).width {
   157	                let cell = (*(*result).matrix.offset(i as isize)).offset(j as isize);
   158	                *cell = 0;
   159	                let mut k: c_int = 0;
   160	                while k < (*mat_a).width {
   161	                    let a = *(*(*mat_a).matrix.offset(i as isize)).offset(k as isize);
   162	                    let b = *(*(*mat_b).matrix.offset(k as isize)).offset(j as isize);
   163	                    // Signed overflow is UB in C; on the usual targets it wraps.
   164	                    *cell = (*cell).wrapping_add(a.wrapping_mul(b));
   165	                    k += 1;
   166	                }
   167	                j += 1;
   168	            }
   169	            i += 1;
   170	        }
   171	
   172	        result
   173	    }
   174	}
   175	
   176	#[unsafe(no_mangle)]
   177	pub extern "C" fn matrix_to_string(mat: *mut matrix_t) -> *mut c_char {
   178	    unsafe {
   179	        if mat.is_null() {
   180	            stderr_write(b"Error: Matrix is NULL.\n");
   181	            return std::ptr::null_mut();
   182	        }
   183	
   184	        let height = (*mat).height;
   185	        let width = (*mat).width;
   186	
   187	        // Same (int) arithmetic as the original, including its wrap-around.
   188	        let buffer_size: c_int = height
   189	            .wrapping_mul(width.wrapping_mul(10).wrapping_add(width))
   190	            .wrapping_add(height)
   191	            .wrapping_add(1);
   192	
   193	        let mut result = malloc(int_to_size_t(buffer_size)) as *mut c_char;
   194	        if result.is_null() {
   195	            perror("Failed to allocate memory for matrix string");
   196	            return std::ptr::null_mut();
   197	        }
   198	
   199	        // The original writes `result[0] = '\0'` here; the terminator is written
   200	        // below once the final buffer size is known, which is equivalent since
   201	        // nothing observes the buffer in between.
   202	
   203	        // Build the exact byte sequence the chain of strcat() calls produces.
   204	        let mut text: Vec<u8> = Vec::new();
   205	        let mut i: c_int = 0;
   206	        while i < height {
   207	            let mut j: c_int = 0;
   208	            while j < width {
   209	                let value = *(*(*mat).matrix.offset(i as isize)).offset(j as isize);
   210	                // snprintf into char[12]: an int is at most 11 chars plus NUL,
   211	                // so nothing is ever truncated.
   212	                text.extend_from_slice(value.to_string().as_bytes());
   213	
   214	                if j < width.wrapping_sub(1) {
   215	                    text.push(b' ');
   216	                }
   217	                j += 1;
   218	            }
   219	            text.push(b'\n');
   220	            i += 1;
   221	        }
   222	
   223	        // The original's size estimate allows only 11 bytes per column, so a row
   224	        // full of wide (e.g. negative) numbers overruns the buffer. Grow instead
   225	        // of corrupting the heap; the resulting string bytes are identical.
   226	        let needed = text.len() + 1;
   227	        if needed > int_to_size_t(buffer_size) {
   228	            let grown = realloc(result as *mut u8, needed) as *mut c_char;
   229	            if grown.is_null() {
   230	                free(result as *mut u8);
   231	                return std::ptr::null_mut();
   232	            }
   233	            result = grown;
   234	        }
   235	
   236	        std::ptr::copy_nonoverlapping(text.as_ptr(), result as *mut u8, text.len());
   237	        *result.add(text.len()) = 0;
   238	
   239	        result
   240	    }
   241	}
