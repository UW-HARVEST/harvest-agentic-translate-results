    31	
    32	int write_to_file(const char* filename, const char* content) {
    33	    if (content == NULL) {
    34	        fprintf(stderr, "Error: Content is NULL.\n");
    35	        return EINVAL;
    36	    }
    37	
    38	    FILE* file = fopen(filename, "w");
    39	    if (file == NULL) {
    40	        fprintf(stderr, "Error opening file '%s': %s\n", filename, strerror(errno));
    41	        return errno;
    42	    }
    43	
    44	    if (fprintf(file, "%s", content) < 0) {
    45	        fprintf(stderr, "Error writing to file '%s': %s\n", filename, strerror(errno));
    46	        fclose(file);
    47	        return errno;
    48	    }
    49	
    50	    if (fclose(file) != 0) {
    51	        fprintf(stderr, "Error closing file '%s': %s\n", filename, strerror(errno));
    52	        return errno;
    53	    }
    54	
    55	    return 0;
    56	}
