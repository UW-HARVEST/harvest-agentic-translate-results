     9	
    10	/// `matrix_t` from `include/matrix.h`.
    11	#[repr(C)]
    12	pub struct matrix_t {
    13	    pub matrix: *mut *mut c_int,
    14	    pub width: c_int,
    15	    pub height: c_int,
    16	}
    17	
    18	const SIZEOF_INT_PTR: usize = std::mem::size_of::<*mut c_int>();
    19	const SIZEOF_INT: usize = std::mem::size_of::<c_int>();
    20	
    21	#[unsafe(no_mangle)]
    22	pub extern "C" fn allocate_matrix(width: c_int, height: c_int) -> *mut matrix_t {
    23	    unsafe {
    24	        let mat = malloc(std::mem::size_of::<matrix_t>()) as *mut matrix_t;
    25	        if mat.is_null() {
    26	            perror("Failed to allocate memory for matrix struct");
    27	            return std::ptr::null_mut();
    28	        }
    29	
    30	        (*mat).width = width;
    31	        (*mat).height = height;
    32	
    33	        // `height * sizeof(int*)`: `height` is converted to size_t first, so a
    34	        // negative height becomes a huge allocation request (and thus fails).
    35	        (*mat).matrix =
    36	            malloc(int_to_size_t(height).wrapping_mul(SIZEOF_INT_PTR)) as *mut *mut c_int;
    37	        if (*mat).matrix.is_null() {
    38	            perror("Failed to allocate memory for matrix rows");
    39	            free(mat as *mut u8);
    40	            return std::ptr::null_mut();
    41	        }
    42	
    43	        let mut i: c_int = 0;
    44	        while i < height {
    45	            let row = malloc(int_to_size_t(width).wrapping_mul(SIZEOF_INT)) as *mut c_int;
    46	            *(*mat).matrix.offset(i as isize) = row;
    47	            if row.is_null() {
    48	                perror("Failed to allocate memory for matrix columns");
    49	                // Matches the original loop bound `j <= i` (the last entry is
    50	                // the NULL row that just failed; free(NULL) is a no-op).
    51	                let mut j: c_int = 0;
    52	                while j <= i {
    53	                    free(*(*mat).matrix.offset(j as isize) as *mut u8);
    54	                    j += 1;
    55	                }
    56	                free((*mat).matrix as *mut u8);
    57	                free(mat as *mut u8);
    58	                return std::ptr::null_mut();
    59	            }
    60	            i += 1;
    61	        }
    62	
    63	        mat
    64	    }
    65	}
    66	
    67	#[unsafe(no_mangle)]
    68	pub extern "C" fn free_matrix(mat: *mut matrix_t) {
    69	    unsafe {
    70	        if mat.is_null() {
    71	            return;
    72	        }
    73	
    74	        let mut i: c_int = 0;
    75	        while i < (*mat).height {
    76	            free(*(*mat).matrix.offset(i as isize) as *mut u8);
    77	            i += 1;
    78	        }
    79	        free((*mat).matrix as *mut u8);
    80	        free(mat as *mut u8);
    81	    }
    82	}
    83	
    84	#[unsafe(no_mangle)]
    85	pub extern "C" fn initialize_matrix_from_string(
    86	    input: *const c_char,
    87	    width: c_int,
    88	    height: c_int,
    89	) -> *mut matrix_t {
    90	    unsafe {
    91	        // NOTE: the original does not check `allocate_matrix` for NULL here.
    92	        let mat = allocate_matrix(width, height);
    93	
    94	        let input_copy = strdup(input);
    95	        if input_copy.is_null() {
    96	            perror("Failed to duplicate input string");
    97	            free_matrix(mat);
    98	            return std::ptr::null_mut();
    99	        }
   100	
   101	        let mut saveptr_row: *mut c_char = std::ptr::null_mut();
   102	        let mut row_token = strtok_r(input_copy, b'\n', &mut saveptr_row);
   103	
   104	        let mut i: c_int = 0;
   105	        while i < height {
   106	            if row_token.is_null() {
   107	                stderr_write(b"Insufficient rows in input string.\n");
   108	                free(input_copy as *mut u8);
   109	                free_matrix(mat);
   110	                return std::ptr::null_mut();
   111	            }
   112	
   113	            let mut saveptr_col: *mut c_char = std::ptr::null_mut();
   114	            let mut col_token = strtok_r(row_token, b' ', &mut saveptr_col);
   115	
   116	            let mut j: c_int = 0;
   117	            while j < width {
   118	                if col_token.is_null() {
   119	                    stderr_write(
   120	                        format!("Insufficient columns in row {}.\n", i.wrapping_add(1))
   121	                            .as_bytes(),
   122	                    );
   123	                    free(input_copy as *mut u8);
   124	                    free_matrix(mat);
   125	                    return std::ptr::null_mut();
   126	                }
   127	                *(*(*mat).matrix.offset(i as isize)).offset(j as isize) = atoi(col_token);
   128	                col_token = strtok_r(std::ptr::null_mut(), b' ', &mut saveptr_col);
   129	                j += 1;
   130	            }
   131	
   132	            row_token = strtok_r(std::ptr::null_mut(), b'\n', &mut saveptr_row);
   133	            i += 1;
   134	        }
   135	
   136	        free(input_copy as *mut u8);
   137	        mat
   138	    }
   139	}
