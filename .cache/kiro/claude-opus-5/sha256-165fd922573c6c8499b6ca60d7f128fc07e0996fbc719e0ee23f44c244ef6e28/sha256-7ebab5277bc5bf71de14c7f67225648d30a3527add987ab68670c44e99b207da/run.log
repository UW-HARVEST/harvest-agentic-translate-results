    33	#define OUT_FILE "matrix.txt"
    34	
    35	int driver(int width_a, int height_a, const char* matrix_a, int width_b, int height_b, const char* matrix_b) {
    36	    matrix_t* mat_a = initialize_matrix_from_string(matrix_a, width_a, height_a);
    37	    if (mat_a == NULL) {
    38	        return EXIT_FAILURE;
    39	    }
    40	    matrix_t* mat_b = initialize_matrix_from_string(matrix_b, width_b, height_b);
    41	    if (mat_b == NULL) {
    42	        free_matrix(mat_a);
    43	        return EXIT_FAILURE;
    44	    }
    45	
    46	    matrix_t* res = multiply_matrices(mat_a, mat_b);
    47	    if (res == NULL) {
    48	        free_matrix(mat_a);
    49	        free_matrix(mat_b);
    50	        return EXIT_FAILURE;
    51	    }
    52	    char* res_str = matrix_to_string(res);
    53	    if (res_str == NULL) {
    54	        free_matrix(mat_a);
    55	        free_matrix(mat_b);
    56	        free(res);
    57	        return EXIT_FAILURE;
    58	    }
    59	
    60	    int res_write = write_to_file(OUT_FILE, res_str);
    61	
    62	    free_matrix(mat_a);
    63	    free_matrix(mat_b);
    64	    free_matrix(res);
    65	    free(res_str);
    66	
    67	    if (res_write != 0) {
    68	        return EXIT_FAILURE;
    69	    }
    70	
    71	    return EXIT_SUCCESS;
    72	}
