     1	//! Translation of `c_src/src/write.c`.
     2	
     3	use std::ffi::c_char;
     4	use std::ffi::c_int;
     5	
     6	use crate::cutil::{EINVAL, errno, fclose, fopen, fputs, stderr_write, strerror_bytes};
     7	
     8	/// Renders `"<prefix>'<filename>': <strerror(err)>\n"` exactly like the
     9	/// original `fprintf(stderr, ...)` calls do.
    10	fn report(prefix: &[u8], filename: *const c_char, err: c_int) {
    11	    let mut buf: Vec<u8> = Vec::new();
    12	    buf.extend_from_slice(prefix);
    13	    buf.push(b'\'');
    14	    unsafe {
    15	        let mut p = filename;
    16	        while *p != 0 {
    17	            buf.push(*p as u8);
    18	            p = p.add(1);
    19	        }
    20	    }
    21	    buf.extend_from_slice(b"': ");
    22	    buf.extend_from_slice(&strerror_bytes(err));
    23	    buf.push(b'\n');
    24	    stderr_write(&buf);
    25	}
    26	
    27	#[unsafe(no_mangle)]
    28	pub extern "C" fn write_to_file(filename: *const c_char, content: *const c_char) -> c_int {
    29	    unsafe {
    30	        if content.is_null() {
    31	            stderr_write(b"Error: Content is NULL.\n");
    32	            return EINVAL;
    33	        }
    34	
    35	        let file = fopen(filename, c"w".as_ptr());
    36	        if file.is_null() {
    37	            let err = errno();
    38	            report(b"Error opening file ", filename, err);
    39	            return err;
    40	        }
    41	
    42	        // `fprintf(file, "%s", content)` is equivalent to fputs here; both
    43	        // return a negative value on failure.
    44	        if fputs(content, file) < 0 {
    45	            let err = errno();
    46	            report(b"Error writing to file ", filename, err);
    47	            fclose(file);
    48	            return err;
    49	        }
    50	
    51	        if fclose(file) != 0 {
    52	            let err = errno();
    53	            report(b"Error closing file ", filename, err);
    54	            return err;
    55	        }
    56	
    57	        0
    58	    }
    59	}
