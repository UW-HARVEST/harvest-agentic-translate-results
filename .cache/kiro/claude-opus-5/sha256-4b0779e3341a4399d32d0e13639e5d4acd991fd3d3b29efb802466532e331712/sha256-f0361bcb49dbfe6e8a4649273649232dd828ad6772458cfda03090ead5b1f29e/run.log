[0m[49m[38;5;10m+    578[0m:[38;5;10m[49m         s.div = 1.0;
[0m[49m[38;5;10m+    579[0m:[38;5;10m[49m         s.verts[0].p = a;
[0m[49m[38;5;10m+    580[0m:[38;5;10m[49m         s.verts[1].p = b;
[0m[49m[38;5;10m+    581[0m:[38;5;10m[49m         s.verts[2].p = c;
