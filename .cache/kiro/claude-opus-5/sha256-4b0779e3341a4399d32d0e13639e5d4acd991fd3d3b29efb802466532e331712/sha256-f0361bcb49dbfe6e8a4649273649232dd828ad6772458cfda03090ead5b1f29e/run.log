[0m[49m[38;5;10m+    583[0m:[38;5;10m[49m         // (a=b, b=c, b=a, a=c) are observable
[0m[49m[38;5;10m+    584[0m:[38;5;10m[49m         for (k, v) in s.verts.iter_mut().enumerate() {
[0m[49m[38;5;10m+    585[0m:[38;5;10m[49m             v.sA = c2v {
