[0m[49m[38;5;10m+    320[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    321[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    322[0m:[38;5;10m[49m     for &p in EDGE_F32 {
[0m[49m[38;5;10m+    323[0m:[38;5;10m[49m         for &q in EDGE_F32 {
