[0m[49m[38;5;10m+    587[0m:[38;5;10m[49m                 y: -(k as f32),
[0m[49m[38;5;10m+    588[0m:[38;5;10m[49m             };
[0m[49m[38;5;10m+    589[0m:[38;5;10m[49m             v.sB = c2v {
[0m[49m[38;5;10m+    590[0m:[38;5;10m[49m                 x: 10.0 + k as f32,
[0m[49m[38;5;10m+    591[0m:[38;5;10m[49m                 y: -10.0 - k as f32,
[0m[49m[38;5;10m+    592[0m:[38;5;10m[49m             };
[0m[49m[38;5;10m+    593[0m:[38;5;10m[49m             v.iA = k as i32;
