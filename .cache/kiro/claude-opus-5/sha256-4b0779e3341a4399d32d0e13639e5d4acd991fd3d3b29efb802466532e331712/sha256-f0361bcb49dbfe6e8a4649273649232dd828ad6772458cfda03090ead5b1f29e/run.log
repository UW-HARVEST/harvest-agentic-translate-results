[0m[49m[38;5;10m+    526[0m:[38;5;10m[49m // Rows 22–29 — c23 (all seven branches + degenerate)
[0m[49m[38;5;10m+    527[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    528[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    529[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    530[0m:[38;5;10m[49m fn row22_to_row29_c23() {
[0m[49m[38;5;10m+    531[0m:[38;5;10m[49m     type S1 = unsafe extern "C" fn(*mut c2Simplex) -> ();
[0m[49m[38;5;10m+    532[0m:[38;5;10m[49m     let (c_f, r_f) = pair::<S1>("c23");
[0m[49m[38;5;10m+    533[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    534[0m:[38;5;10m[49m     let mut rng = Rng::new(0x0022);
[0m[49m[38;5;10m+    535[0m:[38;5;10m[49m     let mut outcomes = std::collections::BTreeSet::new();
[0m[49m[38;5;10m+    536[0m:[38;5;10m[49m     for i in 0..(N * 6) {
[0m[49m[38;5;10m+    537[0m:[38;5;10m[49m         let mut s = rng.simplex(20.0, 3);
[0m[49m[38;5;10m+    538[0m:[38;5;10m[49m         // Sometimes build a genuine triangle around a random origin offset so
[0m[49m[38;5;10m+    539[0m:[38;5;10m[49m         // the vertex/edge/interior Voronoi regions are all reached.
[0m[49m[38;5;10m+    540[0m:[38;5;10m[49m         if i % 2 == 0 {
