[0m[49m[38;5;10m+    517[0m:[38;5;10m[49m             let mut rs = s;
[0m[49m[38;5;10m+    518[0m:[38;5;10m[49m             c_f(&mut cs);
[0m[49m[38;5;10m+    519[0m:[38;5;10m[49m             r_f(&mut rs);
