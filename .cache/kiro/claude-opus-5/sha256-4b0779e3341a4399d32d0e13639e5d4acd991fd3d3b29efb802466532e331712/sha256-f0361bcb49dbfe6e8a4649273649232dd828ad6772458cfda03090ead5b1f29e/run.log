[0m[49m[38;5;10m+    417[0m:[38;5;10m[49m                 let a0 = Shape::rand(&mut rng, ta, 30.0);
[0m[49m[38;5;10m+    418[0m:[38;5;10m[49m                 let b0 = Shape::rand(&mut rng, tb, 30.0);
