[0m[49m[38;5;10m+    498[0m:[38;5;10m[49m     // Hand-built inputs that pin each branch deterministically.
[0m[49m[38;5;10m+    499[0m:[38;5;10m[49m     let mk = |a: c2v, b: c2v| {
