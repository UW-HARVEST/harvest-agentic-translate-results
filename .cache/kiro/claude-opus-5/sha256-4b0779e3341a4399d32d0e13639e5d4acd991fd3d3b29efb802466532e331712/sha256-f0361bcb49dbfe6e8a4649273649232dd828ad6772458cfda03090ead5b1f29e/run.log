[0m[49m[38;5;10m+    542[0m:[38;5;10m[49m             let r = rng.range(0.5, 8.0);
[0m[49m[38;5;10m+    543[0m:[38;5;10m[49m             let t0 = rng.range(0.0, 6.28);
[0m[49m[38;5;10m+    544[0m:[38;5;10m[49m             for k in 0..3 {
