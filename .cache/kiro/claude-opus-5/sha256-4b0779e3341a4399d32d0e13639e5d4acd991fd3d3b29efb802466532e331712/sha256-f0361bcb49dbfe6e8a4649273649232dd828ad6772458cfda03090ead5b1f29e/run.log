[0m[49m[38;5;10m+    520[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    521[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    522[0m:[38;5;10m[49m fn row52_row53_row54_row56_geometric_regimes() {
[0m[49m[38;5;10m+    523[0m:[38;5;10m[49m     let (c_f, r_f) = gjk_pair();
[0m[49m[38;5;10m+    524[0m:[38;5;10m[49m     let mut rng = Rng::new(0x0052);
