[0m[49m[38;5;10m+    548[0m:[38;5;10m[49m                     y: o.y + r * t.sin(),
[0m[49m[38;5;10m+    549[0m:[38;5;10m[49m                 };
[0m[49m[38;5;10m+    550[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    551[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    552[0m:[38;5;10m[49m         unsafe {
[0m[49m[38;5;10m+    553[0m:[38;5;10m[49m             let mut cs = s;
[0m[49m[38;5;10m+    554[0m:[38;5;10m[49m             let mut rs = s;
[0m[49m[38;5;10m+    555[0m:[38;5;10m[49m             c_f(&mut cs);
[0m[49m[38;5;10m+    556[0m:[38;5;10m[49m             r_f(&mut rs);
[0m[49m[38;5;10m+    557[0m:[38;5;10m[49m             assert!(
