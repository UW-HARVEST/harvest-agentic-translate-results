[0m[49m[38;5;10m+    566[0m:[38;5;10m[49m         outcomes.iter().any(|&(c, _)| c == 1)
[0m[49m[38;5;10m+    567[0m:[38;5;10m[49m             && outcomes.iter().any(|&(c, _)| c == 2)
[0m[49m[38;5;10m+    568[0m:[38;5;10m[49m             && outcomes.iter().any(|&(c, _)| c == 3),
[0m[49m[38;5;10m+    569[0m:[38;5;10m[49m         "c23 outcome coverage incomplete: {outcomes:?}"
[0m[49m[38;5;10m+    570[0m:[38;5;10m[49m     );
[0m[49m[38;5;10m+    571[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    572[0m:[38;5;10m[49m     // Pinned triangles: origin in each vertex region, each edge region, inside,
[0m[49m[38;5;10m+    573[0m:[38;5;10m[49m     // plus fully degenerate configurations.
[0m[49m[38;5;10m+    574[0m:[38;5;10m[49m     let p = |x: f32, y: f32| c2v { x, y };
[0m[49m[38;5;10m+    575[0m:[38;5;10m[49m     let mk = |a: c2v, b: c2v, c: c2v| {
[0m[49m[38;5;10m+    576[0m:[38;5;10m[49m         let mut s = c2Simplex::default();
