[0m[49m[38;5;10m+    353[0m:[38;5;10m[49m /// A deterministic sweep over many numeric spellings, to catch rounding or
[0m[49m[38;5;10m+    354[0m:[38;5;10m[49m /// truncation differences the hand-written cases would miss.
[0m[49m[38;5;10m+    355[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    356[0m:[38;5;10m[49m fn numeric_sweep() {
[0m[49m[38;5;10m+    357[0m:[38;5;10m[49m     // Simple xorshift so the sweep is reproducible without extra dependencies.
[0m[49m[38;5;10m+    358[0m:[38;5;10m[49m     let mut state: u64 = 0x2545_F491_4F6C_DD1D;
[0m[49m[38;5;10m+    359[0m:[38;5;10m[49m     let mut next = || {
[0m[49m[38;5;10m+    360[0m:[38;5;10m[49m         state ^= state << 13;
[0m[49m[38;5;10m+    361[0m:[38;5;10m[49m         state ^= state >> 7;
[0m[49m[38;5;10m+    362[0m:[38;5;10m[49m         state ^= state << 17;
[0m[49m[38;5;10m+    363[0m:[38;5;10m[49m         state
[0m[49m[38;5;10m+    364[0m:[38;5;10m[49m     };
[0m[49m[38;5;10m+    365[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    366[0m:[38;5;10m[49m     let mut cases: Vec<Vec<u8>> = Vec::new();
[0m[49m[38;5;10m+    367[0m:[38;5;10m[49m     for _ in 0..120 {
[0m[49m[38;5;10m+    368[0m:[38;5;10m[49m         let a = next();
[0m[49m[38;5;10m+    369[0m:[38;5;10m[49m         let b = next();
[0m[49m[38;5;10m+    370[0m:[38;5;10m[49m         // Exponents chosen to straddle the float and double limits as well as
