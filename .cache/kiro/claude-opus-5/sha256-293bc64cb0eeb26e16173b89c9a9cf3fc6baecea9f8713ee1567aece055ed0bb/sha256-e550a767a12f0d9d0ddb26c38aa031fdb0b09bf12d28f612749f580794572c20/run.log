typedef void (*cb_fn)(int,float*,float*,float*);
static uint32_t bits(float f){uint32_t u;memcpy(&u,&f,4);return u;}
static int isnanb(uint32_t u){return (u&0x7f800000u)==0x7f800000u && (u&0x7fffffu)!=0;}
static uint32_t s=0x12345678u;
static uint32_t xs(void){s^=s<<13;s^=s>>17;s^=s<<5;return s;}
int main(int argc,char**argv){
  void*hc=dlopen(argv[1],RTLD_NOW),*hr=dlopen(argv[2],RTLD_NOW);
  cb_fn c=(cb_fn)dlsym(hc,"colourblind"),r=(cb_fn)dlsym(hr,"colourblind");
  long numeric=0,nanonly=0,total=0;
  float edge[]={0.0f,-0.0f,1.0f,-1.0f,0.5f,255.0f,1e-45f,1e38f,-1e38f,
                3.4028235e38f,1.1754944e-38f,0.1f,0.3f,INFINITY,-INFINITY,NAN};
  size_t ne=sizeof(edge)/sizeof(*edge);
  for(int imp=-3;imp<=5;imp++)for(size_t i=0;i<ne;i++)for(size_t j=0;j<ne;j++)for(size_t k=0;k<ne;k++){
    float a1=edge[i],b1=edge[j],c1=edge[k],a2=a1,b2=b1,c2=c1;
    c(imp,&a1,&b1,&c1); r(imp,&a2,&b2,&c2); total++;
    uint32_t A1=bits(a1),B1=bits(b1),C1=bits(c1),A2=bits(a2),B2=bits(b2),C2=bits(c2);
    if(A1!=A2||B1!=B2||C1!=C2){
      int allnan=(!(A1!=A2)||(isnanb(A1)&&isnanb(A2)))&&(!(B1!=B2)||(isnanb(B1)&&isnanb(B2)))&&(!(C1!=C2)||(isnanb(C1)&&isnanb(C2)));
      if(allnan) nanonly++; else {numeric++; if(numeric<4) printf("NUMERIC DIFF imp=%d in=(%08x %08x %08x) C=(%08x %08x %08x) RS=(%08x %08x %08x)\n",imp,bits(edge[i]),bits(edge[j]),bits(edge[k]),A1,B1,C1,A2,B2,C2);}
    }
  }
  for(long n=0;n<6000000;n++){
    uint32_t u1=xs(),u2=xs(),u3=xs(); int imp=(int)(xs()%4);
    float a1,b1,c1,a2,b2,c2; memcpy(&a1,&u1,4);memcpy(&b1,&u2,4);memcpy(&c1,&u3,4);
    a2=a1;b2=b1;c2=c1; c(imp,&a1,&b1,&c1); r(imp,&a2,&b2,&c2); total++;
    uint32_t A1=bits(a1),B1=bits(b1),C1=bits(c1),A2=bits(a2),B2=bits(b2),C2=bits(c2);
    if(A1!=A2||B1!=B2||C1!=C2){
      int allnan=(!(A1!=A2)||(isnanb(A1)&&isnanb(A2)))&&(!(B1!=B2)||(isnanb(B1)&&isnanb(B2)))&&(!(C1!=C2)||(isnanb(C1)&&isnanb(C2)));
      if(allnan) nanonly++; else {numeric++; if(numeric<4) printf("NUMERIC DIFF imp=%d in=(%08x %08x %08x) C=(%08x %08x %08x) RS=(%08x %08x %08x)\n",imp,u1,u2,u3,A1,B1,C1,A2,B2,C2);}
    }
  }
  for(long n=0;n<2000000;n++){
    float a1=(float)(xs()%1000001)/1000000.0f,b1=(float)(xs()%1000001)/1000000.0f,c1=(float)(xs()%1000001)/1000000.0f;
    float a2=a1,b2=b1,c2=c1; int imp=(int)(xs()%3);
