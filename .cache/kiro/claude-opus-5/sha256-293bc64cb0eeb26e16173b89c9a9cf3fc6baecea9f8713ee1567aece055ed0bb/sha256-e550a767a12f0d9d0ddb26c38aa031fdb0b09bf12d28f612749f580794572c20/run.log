#include <dlfcn.h>
#include <math.h>
#include <stdint.h>
#include <stdio.h>
#include <string.h>
typedef void (*cb_fn)(int,float*,float*,float*);
static uint32_t bits(float f){uint32_t u;memcpy(&u,&f,4);return u;}
static uint64_t s=0x853c49e6748fea9bULL;
static uint32_t xs(void){s^=s<<13;s^=s>>7;s^=s<<17;return (uint32_t)(s>>16);}
/* Heavily biased generator: frequent NaN (incl. signaling), inf, zeros, subnormals. */
static uint32_t weird(void){
  switch(xs()%10){
    case 0: return 0x7f800000u;                      /* +inf */
    case 1: return 0xff800000u;                      /* -inf */
    case 2: return 0x7fc00000u | (xs()&0x3fffffu);   /* +qNaN */
    case 3: return 0xffc00000u | (xs()&0x3fffffu);   /* -qNaN */
    case 4: return 0x7f800000u | (1+(xs()&0x3fffffu));/* +sNaN */
    case 5: return 0xff800000u | (1+(xs()&0x3fffffu));/* -sNaN */
    case 6: return 0x00000000u;                      /* +0 */
    case 7: return 0x80000000u;                      /* -0 */
    case 8: return xs()&0x807fffffu;                 /* subnormal */
    default: return xs();                            /* arbitrary */
  }
}
int main(int argc,char**argv){
  void*hc=dlopen(argv[1],RTLD_NOW),*hr=dlopen(argv[2],RTLD_NOW);
  if(!hc||!hr){printf("dlopen: %s\n",dlerror());return 2;}
  cb_fn c=(cb_fn)dlsym(hc,"colourblind"),r=(cb_fn)dlsym(hr,"colourblind");
  if(!c||!r){printf("dlsym failed\n");return 2;}
  long bad=0,total=0;
  for(long n=0;n<20000000;n++){
    uint32_t u1=weird(),u2=weird(),u3=weird();
    int imp=(int)(xs()%7)-2;   /* -2..4, exercises out-of-range values too */
    float a1,b1,c1,a2,b2,c2;
    memcpy(&a1,&u1,4);memcpy(&b1,&u2,4);memcpy(&c1,&u3,4);
    a2=a1;b2=b1;c2=c1;
    c(imp,&a1,&b1,&c1); r(imp,&a2,&b2,&c2); total++;
    if(bits(a1)!=bits(a2)||bits(b1)!=bits(b2)||bits(c1)!=bits(c2)){
      if(bad<5) printf("MISMATCH imp=%d in=(%08x %08x %08x) C=(%08x %08x %08x) RS=(%08x %08x %08x)\n",
                       imp,u1,u2,u3,bits(a1),bits(b1),bits(c1),bits(a2),bits(b2),bits(c2));
      bad++;
    }
  }
  /* Out-of-range impairment must not dereference the pointers (C has no default:). */
  for(int imp=-5;imp<=8;imp++){ if(imp>=0&&imp<=2) continue; c(imp,NULL,NULL,NULL); r(imp,NULL,NULL,NULL); }
  printf("NULL-pointer/out-of-range: both survived\n");
  printf("soak cases=%ld mismatches=%ld -> %s\n",total,bad,bad?"FAIL":"BYTE-IDENTICAL");
  return bad!=0;
}
