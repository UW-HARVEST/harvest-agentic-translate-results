    14	
    15	/// `mp3d_sample_t` from `lib.h`.
    16	#[allow(non_camel_case_types)]
    17	type mp3d_sample_t = i16;
    18	
    19	/// Faithful port of the `static int16_t mp3d_scale_pcm(float sample)` helper.
    20	///
    21	/// The C comparisons are against `double` literals (`32766.5`, `-32767.5`),
    22	/// so the `float` argument is promoted to `double` first; both constants are
    23	/// exactly representable in either format, so the promotion is modelled by
    24	/// comparing as `f64`.
    25	///
    26	/// `(int16_t)(sample + .5f)` is a C float-to-integer conversion, i.e.
    27	/// truncation toward zero. The early returns guarantee the value is well
    28	/// inside the `i16` range at that point, so Rust's saturating `as i16`
    29	/// behaves identically to C's truncation here.
    30	fn mp3d_scale_pcm(sample: f32) -> i16 {
    31	    if sample as f64 >= 32766.5 {
    32	        return 32767i32 as i16;
    33	    }
    34	    if sample as f64 <= -32767.5 {
    35	        return -32768i32 as i16;
    36	    }
    37	    let mut s: i16 = (sample + 0.5f32) as i16;
    38	    // C: `s -= (s < 0);` -- integer promotion, subtract 0 or 1, truncate back.
    39	    s = s.wrapping_sub(if s < 0 { 1 } else { 0 });
    40	    s
    41	}
