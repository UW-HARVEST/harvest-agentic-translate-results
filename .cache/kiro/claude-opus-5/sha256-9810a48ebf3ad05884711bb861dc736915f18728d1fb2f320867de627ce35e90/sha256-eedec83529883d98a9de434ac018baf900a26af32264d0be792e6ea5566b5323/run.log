import os, subprocess, sys
def run(prog):
    r, w = os.pipe()
    p = subprocess.Popen([prog], stdin=subprocess.DEVNULL, stdout=w,
                         stderr=subprocess.PIPE)
    os.close(w)
    os.close(r)          # no reader at all -> first write gets EPIPE/SIGPIPE
    err = p.communicate()[1]
    return p.returncode, err
for prog in sys.argv[1:]:
    rc, err = run(prog)
    print(f"{prog}\n   returncode={rc}  (negative => killed by that signal)  stderr={err!r}")
EOF
