[0m[49m[38;5;10m+    163[0m:[38;5;10m[49m         assert!(x.to_bits().to_ne_bytes().iter().all(|&b| b >= 0x80));
[0m[49m[38;5;10m+    164[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    165[0m:[38;5;10m[49m     assert_same_batch(&im, &xs, Sink::File, Buffering::Default);
[0m[49m[38;5;10m+    166[0m:[38;5;10m[49m }
