[0m[49m[38;5;10m+    197[0m:[38;5;10m[49m         let b = f32::from_bits(rng.next_u32() & 0x7f7f_ffff);
[0m[49m[38;5;10m+    198[0m:[38;5;10m[49m         xs.push(a / b);
