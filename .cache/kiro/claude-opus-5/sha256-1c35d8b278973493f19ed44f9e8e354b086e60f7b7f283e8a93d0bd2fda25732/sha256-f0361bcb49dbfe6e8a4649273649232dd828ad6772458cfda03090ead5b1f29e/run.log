#include "driver.h"

#include <stdio.h>
#include <string.h>

static void print_hex(unsigned char *p, int len) {
    for (int i = 0; i < len; i++) {
        printf("%02x", p[i]);
    }
    printf("\n");
}

void driver(float x) {
    char raw[sizeof(x)];
    memcpy(raw, &x, sizeof(x));
    print_hex((unsigned char *)raw, sizeof(raw));
}
