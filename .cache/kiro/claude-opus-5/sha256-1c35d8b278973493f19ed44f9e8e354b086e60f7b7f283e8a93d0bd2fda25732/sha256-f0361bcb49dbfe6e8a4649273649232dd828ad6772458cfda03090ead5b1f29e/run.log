[0m[49m[38;5;10m+    351[0m:[38;5;10m[49m     assert_eq!(pos, pos_r);
[0m[49m[38;5;10m+    352[0m:[38;5;10m[49m     assert_eq!(pos, b"00000000\n");
[0m[49m[38;5;10m+    353[0m:[38;5;10m[49m 
