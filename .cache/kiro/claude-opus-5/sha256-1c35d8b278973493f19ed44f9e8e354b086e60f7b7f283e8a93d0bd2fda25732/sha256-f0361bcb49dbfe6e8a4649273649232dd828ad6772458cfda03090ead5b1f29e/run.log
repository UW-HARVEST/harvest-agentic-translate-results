[0m[49m[38;5;10m+    147[0m:[38;5;10m[49m /// CONFIGS row 11: every byte at or above `0x80`. This is the signed-`char`
[0m[49m[38;5;10m+    148[0m:[38;5;10m[49m /// sign-extension trap: the C casts `char raw[]` to `unsigned char *`, so each
[0m[49m[38;5;10m+    149[0m:[38;5;10m[49m /// byte must print as exactly two unsigned hex digits (`ff`), never as a
[0m[49m[38;5;10m+    150[0m:[38;5;10m[49m /// sign-extended `ffffffff`.
[0m[49m[38;5;10m+    151[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    152[0m:[38;5;10m[49m fn cfg11_high_bit_bytes_only() {
[0m[49m[38;5;10m+    153[0m:[38;5;10m[49m     let im = impls();
[0m[49m[38;5;10m+    154[0m:[38;5;10m[49m     let mut rng = Rng::with_seed(0x8080_8080_8080_8080);
[0m[49m[38;5;10m+    155[0m:[38;5;10m[49m     let xs: Vec<f32> = (0..2_000)
[0m[49m[38;5;10m+    156[0m:[38;5;10m[49m         .map(|_| {
