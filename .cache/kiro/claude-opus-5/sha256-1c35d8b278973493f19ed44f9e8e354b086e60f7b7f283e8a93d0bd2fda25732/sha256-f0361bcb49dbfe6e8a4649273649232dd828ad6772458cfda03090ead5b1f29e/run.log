[0m[49m[38;5;10m+    158[0m:[38;5;10m[49m             let (b0, b1, b2, b3) = (b(&mut rng), b(&mut rng), b(&mut rng), b(&mut rng));
[0m[49m[38;5;10m+    159[0m:[38;5;10m[49m             f32::from_bits(b0 | (b1 << 8) | (b2 << 16) | (b3 << 24))
