import zlib, os, random
random.seed(1234)
os.makedirs('corpus', exist_ok=True)
cases = []
def raw(data, level=-1, strategy=zlib.Z_DEFAULT_STRATEGY, wbits=-15):
    c = zlib.compressobj(level, zlib.DEFLATED, wbits, 9, strategy)
    return c.compress(data) + c.flush()

payloads = {
 'empty': b'',
 'a': b'a',
 'hello': b'hello world',
 'rep': b'abcabcabc'*50,
 'aaaa': b'a'*1000,
 'text': (b'the quick brown fox jumps over the lazy dog. '*40),
 'rand': bytes(random.randrange(256) for _ in range(5000)),
 'binary': bytes(range(256))*8,
 'mixed': b''.join([bytes([i%7])*i for i in range(1,120)]),
 'long': (b'0123456789'*3000),
}
for name, p in payloads.items():
    for lvl in (0,1,6,9):
        for strat in (zlib.Z_DEFAULT_STRATEGY, zlib.Z_FIXED, zlib.Z_HUFFMAN_ONLY, zlib.Z_RLE):
            try:
                c = raw(p, lvl, strat)
