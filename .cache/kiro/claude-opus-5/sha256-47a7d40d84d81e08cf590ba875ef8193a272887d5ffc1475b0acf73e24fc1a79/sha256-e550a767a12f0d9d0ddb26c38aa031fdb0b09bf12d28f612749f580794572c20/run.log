import zlib, os, random
random.seed(999)
os.makedirs('c2', exist_ok=True)
cases=[]
def add(name, data, outsz):
    fn=f'c2/{name}.bin'; open(fn,'wb').write(data); cases.append((fn,outsz))

# multi-block via sync flush
for lvl in (0,1,6,9):
    p=b'the quick brown fox '*200
    co=zlib.compressobj(lvl,zlib.DEFLATED,-15)
    d=b''
    for i in range(0,len(p),400):
        d+=co.compress(p[i:i+400])+co.flush(zlib.Z_SYNC_FLUSH)
    d+=co.flush()
    add(f'multiblock_l{lvl}', d, len(p))
    add(f'multiblock_l{lvl}_exact', d, len(p))

# stored blocks (level 0) multiple, big
big=bytes(random.randrange(256) for _ in range(200000))
co=zlib.compressobj(0,zlib.DEFLATED,-15); d=co.compress(big)+co.flush()
add('stored_big', d, len(big))

# large window / long matches
p=(b'X'*70000)+(b'Y'*10)+(b'X'*70000)
co=zlib.compressobj(9,zlib.DEFLATED,-15); add('window', co.compress(p)+co.flush(), len(p))

# exact-size and off-by-one output buffers on a normal stream
p=b'hello hello hello world world'*100
co=zlib.compressobj(6,zlib.DEFLATED,-15); d=co.compress(p)+co.flush()
add('exact', d, len(p))
for k,delta in enumerate([-1,-2,-len(p)//2,1,1000]):
    add(f'exact_d{k}', d, len(p)+delta)

# corrupted stored blocks: flip NLEN
co=zlib.compressobj(0,zlib.DEFLATED,-15); s=bytearray(co.compress(b'abcdefghij'*10)+co.flush())
add('stored_ok', bytes(s), 100)
for i in range(1,6):
    t=bytearray(s); t[i]^=0xFF; add(f'stored_bad{i}', bytes(t), 100)
# truncated stored
for cut in (1,2,3,4,5,6,20):
    add(f'stored_trunc{cut}', bytes(s[:cut]), 100)

# fixed-huffman streams mutated
co=zlib.compressobj(6,zlib.DEFLATED,-15,9,zlib.Z_FIXED); base=co.compress(b'abcdefg'*300)+co.flush()
for i in range(80):
    b=bytearray(base); b[random.randrange(len(b))]^=1<<random.randrange(8)
    add(f'fixmut{i}', bytes(b), 2100)
# tiny handcrafted headers
for v in range(256):
    add(f'hdr{v}', bytes([v,0x00,0x00,0x00,0xFF,0xFF,0x00,0x00]), 256)
with open('cases2.txt','w') as f:
    for fn,sz in cases: f.write(f'{fn} {sz}\n')
print(len(cases))
