int main(int argc,char**argv){
  /* argv: lib case outsz off resultfile */
  void*h=dlopen(argv[1],RTLD_NOW);
  if(!h){fprintf(stderr,"%s\n",dlerror());return 2;}
  pinflate_t p=(pinflate_t)dlsym(h,"pinflate");
  const char**e=(const char**)dlsym(h,"cp_error_reason");
  FILE*f=fopen(argv[2],"rb"); fseek(f,0,SEEK_END); long n=ftell(f); fseek(f,0,SEEK_SET);
  uint8_t*d=malloc(n?n:1); if(n && fread(d,1,n,f)!=(size_t)n) return 2; fclose(f);
  int outsz=atoi(argv[3]); int off=atoi(argv[4]);

  uint8_t*ir=mmap((void*)0x200000000UL,INREG,PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANONYMOUS|MAP_FIXED,-1,0);
  uint8_t*orr=mmap((void*)0x400000000UL,OUTREG,PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANONYMOUS|MAP_FIXED,-1,0);
  if(ir==MAP_FAILED||orr==MAP_FAILED){perror("mmap");return 2;}
  /* deterministic filler */
  uint32_t st=0x12345678; for(int i=0;i<INREG;i++){st=st*1103515245u+12345u; ir[i]=(uint8_t)(st>>16);}
  memset(orr,0xCD,OUTREG);
  memcpy(ir+INOFF+off,d,n);

  *e=NULL;
  int r=p(ir+INOFF+off,(int)n,orr,outsz);
  const char*er=*e;

  FILE*rf=fopen(argv[5],"wb");
  fprintf(rf,"ret=%d\nerr=%s\n",r,er?er:"(null)");
  /* record the whole out region so out-of-bounds writes are captured too */
  fwrite(orr,1,OUTREG,rf);
  fclose(rf);
  return 0;
}
EOF
