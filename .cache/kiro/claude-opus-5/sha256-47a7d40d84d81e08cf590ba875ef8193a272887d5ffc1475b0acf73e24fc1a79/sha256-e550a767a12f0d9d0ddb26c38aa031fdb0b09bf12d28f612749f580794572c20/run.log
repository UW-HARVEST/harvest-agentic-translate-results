#include <dlfcn.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

typedef int (*pinflate_t)(void *, int, void *, int);

typedef struct {
  void *h;
  pinflate_t pinflate;
  const char **err;
  uint8_t *fixed_table, *perm, *len_extra, *dist_extra;
  uint32_t *len_base, *dist_base;
} lib_t;

static void load(lib_t *l, const char *path) {
  l->h = dlopen(path, RTLD_NOW | RTLD_LOCAL);
  if (!l->h) { fprintf(stderr, "dlopen %s: %s\n", path, dlerror()); exit(2); }
  #define G(f,t) l->f = (t)dlsym(l->h, #f); if(!l->f){fprintf(stderr,"missing %s in %s\n",#f,path);exit(2);}
  G(pinflate, pinflate_t)
  G(err, const char **)
  G(fixed_table, uint8_t *)
  G(perm, uint8_t *)
  G(len_extra, uint8_t *)
  G(dist_extra, uint8_t *)
  G(len_base, uint32_t *)
  G(dist_base, uint32_t *)
  #undef G
}
static void load2(lib_t *l, const char *path) {
  l->h = dlopen(path, RTLD_NOW | RTLD_LOCAL);
  if (!l->h) { fprintf(stderr, "dlopen %s: %s\n", path, dlerror()); exit(2); }
  l->pinflate = (pinflate_t)dlsym(l->h, "pinflate");
  l->err = (const char **)dlsym(l->h, "cp_error_reason");
  l->fixed_table = (uint8_t *)dlsym(l->h, "cp_fixed_table");
  l->perm = (uint8_t *)dlsym(l->h, "cp_permutation_order");
  l->len_extra = (uint8_t *)dlsym(l->h, "cp_len_extra_bits");
  l->dist_extra = (uint8_t *)dlsym(l->h, "cp_dist_extra_bits");
  l->len_base = (uint32_t *)dlsym(l->h, "cp_len_base");
  l->dist_base = (uint32_t *)dlsym(l->h, "cp_dist_base");
  if(!l->pinflate||!l->err||!l->fixed_table||!l->perm||!l->len_extra||!l->dist_extra||!l->len_base||!l->dist_base){
    fprintf(stderr,"missing symbol in %s\n",path); exit(2);}
}

#define OUTPAD 4096

int fails = 0, checks = 0;

static void run_case(lib_t *a, lib_t *b, const char *file, int outsz) {
  FILE *f = fopen(file, "rb");
  if (!f) { fprintf(stderr, "open %s\n", file); exit(2); }
  fseek(f, 0, SEEK_END); long n = ftell(f); fseek(f, 0, SEEK_SET);
  uint8_t *data = malloc(n ? n : 1);
  if (n) { if (fread(data, 1, n, f) != (size_t)n) exit(2); }
  fclose(f);

  for (int off = 0; off < 4; ++off) {
    /* aligned base + off, with deterministic padding around */
    uint8_t *inbuf = aligned_alloc(64, 64 + n + 64);
    memset(inbuf, 0xA5, 64 + n + 64);
    memcpy(inbuf + off, data, n);
    uint8_t *in = inbuf + off;

    int total = outsz + OUTPAD;
    uint8_t *o1 = malloc(total), *o2 = malloc(total);
    memset(o1, 0xCD, total); memset(o2, 0xCD, total);

    *a->err = NULL; *b->err = NULL;
    int r1 = a->pinflate(in, (int)n, o1, outsz);
    const char *e1 = *a->err;
    int r2 = b->pinflate(in, (int)n, o2, outsz);
    const char *e2 = *b->err;

    checks++;
    int bad = 0;
    if (r1 != r2) { printf("RET MISMATCH %s off=%d out=%d: %d vs %d\n", file, off, outsz, r1, r2); bad = 1; }
    if (memcmp(o1, o2, total) != 0) {
      int i = 0; while (i < total && o1[i] == o2[i]) i++;
      printf("OUT MISMATCH %s off=%d out=%d at byte %d (%02x vs %02x)\n", file, off, outsz, i, o1[i], o2[i]);
      bad = 1;
    }
    int es = (e1 == NULL) == (e2 == NULL) && (e1 == NULL || strcmp(e1, e2) == 0);
    if (!es) { printf("ERR MISMATCH %s off=%d out=%d: [%s] vs [%s]\n", file, off, outsz, e1?e1:"(null)", e2?e2:"(null)"); bad = 1; }
    if (bad) fails++;
    free(o1); free(o2); free(inbuf);
  }
  free(data);
}

int main(int argc, char **argv) {
  lib_t A, B;
  load2(&A, argv[1]);
  load2(&B, argv[2]);

  /* table comparison */
  if (memcmp(A.fixed_table, B.fixed_table, 320)) { printf("fixed_table differs\n"); fails++; }
  if (memcmp(A.perm, B.perm, 19)) { printf("permutation_order differs\n"); fails++; }
  if (memcmp(A.len_extra, B.len_extra, 31)) { printf("len_extra differs\n"); fails++; }
  if (memcmp(A.dist_extra, B.dist_extra, 32)) { printf("dist_extra differs\n"); fails++; }
  if (memcmp(A.len_base, B.len_base, 31*4)) { printf("len_base differs\n"); fails++; }
  if (memcmp(A.dist_base, B.dist_base, 32*4)) { printf("dist_base differs\n"); fails++; }
  printf("tables compared\n");

  FILE *cf = fopen(argv[3], "r");
  char path[512]; int sz;
  while (fscanf(cf, "%511s %d", path, &sz) == 2) run_case(&A, &B, path, sz);
  fclose(cf);
  printf("checks=%d fails=%d\n", checks, fails);
  return fails ? 1 : 0;
}
