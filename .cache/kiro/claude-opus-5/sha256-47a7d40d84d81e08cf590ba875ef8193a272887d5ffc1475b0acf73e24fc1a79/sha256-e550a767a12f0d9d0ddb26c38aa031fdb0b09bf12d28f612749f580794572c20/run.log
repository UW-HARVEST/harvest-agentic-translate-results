import zlib, os, random
os.makedirs('/tmp/cases', exist_ok=True)
random.seed(1234)
cases = {}
def raw(data, level=6, strategy=zlib.Z_DEFAULT_STRATEGY):
    c = zlib.compressobj(level, zlib.DEFLATED, -15, 9, strategy)
    return c.compress(data) + c.flush()

payloads = {
 'empty': b'',
 'a': b'a',
 'hello': b'hello world',
 'rep1': b'a'*1000,
 'rep2': b'abcabcabc'*300,
 'text': (b'The quick brown fox jumps over the lazy dog. '*100),
 'rand': bytes(random.randrange(256) for _ in range(4096)),
 'binary': bytes(range(256))*16,
 'mixed': (b'aaaa'+bytes(range(200))+b'zzzz')*40,
 'long': bytes(random.choice(b'abcdefgh') for _ in range(65536)),
}
for name, p in payloads.items():
    for lvl in (0,1,6,9):
        for strat,sn in ((zlib.Z_DEFAULT_STRATEGY,'d'),(zlib.Z_FIXED,'f'),(zlib.Z_HUFFMAN_ONLY,'h'),(zlib.Z_RLE,'r')):
            try:
                d = raw(p, lvl, strat)
            except Exception:
                continue
            fn = f'/tmp/cases/{name}_{lvl}{sn}.bin'
            open(fn,'wb').write(d)
            cases[fn] = len(p)
# malformed / truncated cases
base = raw(payloads['text'], 6)
for k,cut in enumerate([1,2,3,5,10,50]):
    fn=f'/tmp/cases/trunc{k}.bin'; open(fn,'wb').write(base[:max(1,len(base)-cut)]); cases[fn]=len(payloads['text'])
# btype 3
open('/tmp/cases/bad_btype.bin','wb').write(bytes([0b00000111,0,0,0])); cases['/tmp/cases/bad_btype.bin']=64
# stored block
c=zlib.compressobj(0, zlib.DEFLATED, -15); st=c.compress(b'stored data here')+c.flush()
open('/tmp/cases/stored.bin','wb').write(st); cases['/tmp/cases/stored.bin']=64
import json
json.dump(cases, open('/tmp/cases.json','w'))
print(len(cases), 'cases')
