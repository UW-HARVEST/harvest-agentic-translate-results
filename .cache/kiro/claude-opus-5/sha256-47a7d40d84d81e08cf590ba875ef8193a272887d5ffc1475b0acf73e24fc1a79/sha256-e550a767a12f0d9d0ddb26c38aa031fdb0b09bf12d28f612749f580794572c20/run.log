import re
src = open('c_src/src/lib.c').read()
def grab(name):
    i = src.index(name)
    b = src.index('{', i); e = src.index('}', b)
    body = src[b+1:e]
    vals = [int(x) for x in re.findall(r'-?\d+', body)]
    return vals
for n in ['cp_fixed_table','cp_permutation_order','cp_len_extra_bits','cp_len_base','cp_dist_extra_bits','cp_dist_base']:
    v = grab(n)
    print(n, len(v))
ft = grab('cp_fixed_table')
# summarize runs
runs=[]
for x in ft:
    if runs and runs[-1][0]==x: runs[-1][1]+=1
    else: runs.append([x,1])
print(runs)
open('/tmp/tables.txt','w').write(repr({n:grab(n) for n in ['cp_fixed_table','cp_permutation_order','cp_len_extra_bits','cp_len_base','cp_dist_extra_bits','cp_dist_base']}))
