#include <unistd.h>
#include <sys/wait.h>
typedef int (*pinflate_t)(void*,int,void*,int);
typedef struct { pinflate_t p; const char **e; } lib_t;
static lib_t ld(const char*path){lib_t l; void*h=dlopen(path,RTLD_NOW);
  if(!h){fprintf(stderr,"%s\n",dlerror());exit(2);}
  l.p=(pinflate_t)dlsym(h,"pinflate"); l.e=(const char**)dlsym(h,"cp_error_reason");
  if(!l.p||!l.e){fprintf(stderr,"sym missing\n");exit(2);} return l;}
#define OUTPAD 4096
static lib_t A,B;
/* returns 0 ok, 1 mismatch */
static int one(const uint8_t*data,long n,int outsz,int off,const char*file){
  uint8_t*ib=aligned_alloc(64,64+n+64); memset(ib,0xA5,64+n+64); memcpy(ib+off,data,n);
  uint8_t*in=ib+off; int total=outsz+OUTPAD;
  uint8_t*o1=malloc(total),*o2=malloc(total); memset(o1,0xCD,total); memset(o2,0xCD,total);
  *A.e=NULL; int r1=A.p(in,(int)n,o1,outsz); const char*e1=*A.e;
  *B.e=NULL; int r2=B.p(in,(int)n,o2,outsz); const char*e2=*B.e;
  int bad=0;
  if(r1!=r2){printf("RET %s off=%d out=%d: %d vs %d\n",file,off,outsz,r1,r2);bad=1;}
  if(memcmp(o1,o2,total)){int i=0;while(i<total&&o1[i]==o2[i])i++;
    printf("OUT %s off=%d out=%d @%d %02x vs %02x\n",file,off,outsz,i,o1[i],o2[i]);bad=1;}
  int es=((e1==NULL)==(e2==NULL))&&(e1==NULL||strcmp(e1,e2)==0);
  if(!es){printf("ERR %s off=%d out=%d: [%s] vs [%s]\n",file,off,outsz,e1?e1:"(null)",e2?e2:"(null)");bad=1;}
  free(o1);free(o2);free(ib); return bad;
}
int main(int argc,char**argv){
  setvbuf(stdout,NULL,_IONBF,0);
  A=ld(argv[1]); B=ld(argv[2]);
  FILE*cf=fopen(argv[3],"r"); char path[512]; int sz;
  int ok=0,mis=0,crash=0;
  while(fscanf(cf,"%511s %d",path,&sz)==2){
    FILE*f=fopen(path,"rb"); fseek(f,0,SEEK_END); long n=ftell(f); fseek(f,0,SEEK_SET);
    uint8_t*d=malloc(n?n:1); if(n)fread(d,1,n,f); fclose(f);
    for(int off=0;off<4;off++){
      pid_t pid=fork();
      if(pid==0){ int r=one(d,n,sz,off,path); _exit(r?1:0); }
      int st; waitpid(pid,&st,0);
      if(WIFEXITED(st)&&WEXITSTATUS(st)==0) ok++;
      else if(WIFEXITED(st)&&WEXITSTATUS(st)==1) mis++;
      else { crash++; printf("CRASH(one-or-both, C UB) %s off=%d out=%d sig=%d\n",path,off,sz,WIFSIGNALED(st)?WTERMSIG(st):-1); }
    }
    free(d);
  }
  printf("identical=%d mismatch=%d crashed=%d\n",ok,mis,crash);
  return mis?1:0;
}
