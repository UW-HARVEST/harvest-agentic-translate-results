Purpose: Review SSE helper section

//! Rust translation of `c_src/src/lib.c`.
//!
//! The goal is bit-for-bit identical behaviour with the original C, including
//! its quirks (e.g. the unreachable `h < 120.0f && h < 180.0f` branch in `f11`).

#![allow(non_snake_case)]
#![allow(non_camel_case_types)]

mod tables;

use core::ffi::{c_int, c_void};
use tables::{M_EXPONENT, M_MANTISSA, M_OFFSET};

/* ------------------------------------------------------------------ *
 * x86-64 SSE NaN propagation
 *
 * A scalar SSE arithmetic instruction (`mulss dst, src`, `addss dst, src`)
 * picks its result NaN as: quiet(dst) if dst is NaN, else quiet(src) if src is
 * NaN, else the default QNaN 0x7FC00000 when the operation is invalid
 * (0 * inf, inf - inf, ...). So for `+` and `*`, which are commutative, the
 * *register allocation* decides the NaN payload and sign.
 *
 * gcc at -O0 and LLVM do not always agree on which operand becomes the
 * destination, and source-level operand order does not control LLVM's choice.
 * These helpers therefore make the destination explicit: `dest` is whichever
 * operand the C build (see `objdump -d` of the reference .so) leaves in the
 * destination register. They are only used where both operands can be NaN
 * simultaneously with differing payloads; elsewhere the choice is unobservable.
 * ------------------------------------------------------------------ */

#[inline(always)]
fn quiet_f32(x: f32) -> f32 {
    f32::from_bits(x.to_bits() | 0x0040_0000)
}

#[inline(always)]
fn sse_nan_result(dest: f32, src: f32) -> f32 {
    if dest.is_nan() {
        quiet_f32(dest)
    } else if src.is_nan() {
        quiet_f32(src)
    } else {
        // Invalid operation with non-NaN operands (0 * inf, inf - inf, ...).
        // x86 SSE produces the "QNaN floating-point indefinite", whose sign bit
        // is *set*: 0xFFC00000, not 0x7FC00000.
        f32::from_bits(0xFFC0_0000)
    }
}

/// `mulss dest, src`
#[inline(always)]
fn sse_mul(dest: f32, src: f32) -> f32 {
    let r = dest * src;
    if r.is_nan() {
        sse_nan_result(dest, src)
    } else {
        r
    }
}

/// `addss dest, src`
#[inline(always)]
fn sse_add(dest: f32, src: f32) -> f32 {
    let r = dest + src;
    if r.is_nan() {
        sse_nan_result(dest, src)
    } else {
        r
    }
}
