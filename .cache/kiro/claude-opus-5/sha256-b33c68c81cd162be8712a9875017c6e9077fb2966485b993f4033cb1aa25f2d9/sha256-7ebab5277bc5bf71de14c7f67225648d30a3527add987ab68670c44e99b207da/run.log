/* ------------------------------------------------------------------ *
 * colour space conversions
 * ------------------------------------------------------------------ */

/// Reproduces the x86-64 `cvttss2si` behaviour of a C `(int)` cast from
/// `float`: out-of-range values and NaN yield `INT_MIN`.
fn c_cast_i32(v: f32) -> c_int {
    if v >= -2147483648.0f32 && v < 2147483648.0f32 {
        v as c_int
    } else {
        INT_MIN
    }
}

