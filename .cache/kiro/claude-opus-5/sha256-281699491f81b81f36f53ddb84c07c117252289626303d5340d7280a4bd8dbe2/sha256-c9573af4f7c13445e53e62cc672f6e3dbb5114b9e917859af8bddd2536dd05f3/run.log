s = s.replace("(*dctx).frameInfo.contentChecksumFlag = contentChecksumFlag as c_int;", "(*dctx).frameInfo.contentChecksumFlag = contentChecksumFlag;")
s = s.replace("(*dctx).frameInfo.blockSizeID = blockSizeID as c_int;", "(*dctx).frameInfo.blockSizeID = blockSizeID;")
