             "LZ4F_blockLinked","LZ4F_blockIndependent",
             "LZ4F_noContentChecksum","LZ4F_contentChecksumEnabled",
             "LZ4F_noBlockChecksum","LZ4F_blockChecksumEnabled",
             "LZ4F_frame","LZ4F_skippableFrame"]:
    s = s.replace(f"pub const {name}: c_int =", f"pub const {name}: c_uint =")
s = s.replace("pub const LZ4F_BLOCKSIZEID_DEFAULT: c_int =", "pub const LZ4F_BLOCKSIZEID_DEFAULT: c_uint =")

# 2. struct fields
s = s.replace("""    pub blockSizeID: c_int,
    pub blockMode: c_int,
    pub contentChecksumFlag: c_int,
    pub frameType: c_int,""","""    pub blockSizeID: c_uint,
    pub blockMode: c_uint,
    pub contentChecksumFlag: c_uint,
    pub frameType: c_uint,""")
s = s.replace("    pub blockChecksumFlag: c_int,", "    pub blockChecksumFlag: c_uint,")

# 3. public entry point signature
s = s.replace("pub extern \"C\" fn LZ4F_getBlockSize(mut blockSizeID: c_int) -> usize {",
              "pub extern \"C\" fn LZ4F_getBlockSize(mut blockSizeID: c_uint) -> usize {")

# 4. helpers that take these values
s = s.replace("fn LZ4F_optimalBSID(requestedBSID: c_int, srcSize: usize) -> c_int {",
