// Generated differential test corpus - see tests/harness/mod.rs.
//
// Each case feeds one byte string to BOTH binaries (the CMake-built C `driver`
// and this crate's release/debug `driver`) on stdin and requires stdout, stderr
// and the exit status to be byte-for-byte identical.
//
// Only inputs for which the C program is itself reproducible are listed here.
// The C code calls strcmp()/strlen() on stack buffers that main() may not have
// NUL terminated; those reads pick up pre-main stack residue whose contents
// depend on ASLR, so the C binary returns different answers on different runs
// of the same input. See ERRORS.md ("ASLR-dependent inputs") for the analysis
// and for the probe used to classify each case.

mod harness;

use harness::check;

#[test]
