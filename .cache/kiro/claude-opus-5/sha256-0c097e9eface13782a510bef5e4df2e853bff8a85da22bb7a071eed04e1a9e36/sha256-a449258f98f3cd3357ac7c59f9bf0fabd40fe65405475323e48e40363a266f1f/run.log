# Fuzz raw byte payloads (arbitrary garbage) to stress the scanf layer.
import random, subprocess
C="c_src/build/driver"; R="translation/target/release/driver"
def run(e,d):
    p=subprocess.run([e],input=d,stdout=subprocess.PIPE,stderr=subprocess.PIPE)
    return p.stdout,p.stderr,p.returncode
rnd=random.Random(99); bad=0; n=4000
alpha=b"0123456789 \n\t\r+-xX.eE,;abz\x00\x0b\x0c"
for _ in range(n):
    d=bytes(rnd.choice(alpha) for _ in range(rnd.randint(0,40)))
    c=run(C,d); r=run(R,d)
    if c!=r:
        reps=set()
        for _ in range(25): reps.add(run(C,d))
        if len(reps)>1: continue
        bad+=1; print("MISMATCH",repr(d),"C=",c,"R=",r)
        if bad>15: break
print("raw-byte fuzz n=%d mismatches=%d"%(n,bad))
