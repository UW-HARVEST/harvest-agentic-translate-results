# op3, input_len=1024 with k leading nonzero bytes, delim=0 -> index of first zero byte in buffer
probe_first_zero() {
  k=$1
  body=""
  for i in $(seq 1 $k); do body="$body 1"; done
  rest=$((1024-k))
  for i in $(seq 1 $rest); do body="$body 1"; done
  # all 1024 written -> deterministic sanity check (expect -1)
  echo -n "all written k=$k: "; printf '3 0 1024 %s 1 0' "$body" | $C
}
