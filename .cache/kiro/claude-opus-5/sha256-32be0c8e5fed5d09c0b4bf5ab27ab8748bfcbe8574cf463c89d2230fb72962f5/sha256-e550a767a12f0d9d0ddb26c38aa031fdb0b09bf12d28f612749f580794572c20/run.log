        for _ in range(random.randrange(1, 5)):
            if len(b) > 40: b[random.randrange(40, len(b))] = random.randrange(256)
    open('/tmp/fuzz/f%04d.png' % i, 'wb').write(bytes(b)); n += 1
print(n, "fuzz inputs")
