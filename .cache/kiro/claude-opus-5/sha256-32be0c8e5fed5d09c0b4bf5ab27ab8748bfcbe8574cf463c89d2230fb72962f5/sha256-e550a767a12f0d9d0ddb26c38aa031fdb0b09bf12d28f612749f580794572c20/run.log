    elif m==1: # replace IDAT payload with random bytes entirely
        w,h=random.randrange(1,40),random.randrange(1,40)
        ct=random.choice([0,2,3,4,6])
        payload=bytes(random.randrange(256) for _ in range(random.randrange(6,400)))
        b=bytearray(b'\x89PNG\r\n\x1a\n')
        def ch(t,dd): return struct.pack('>I',len(dd))+t+dd+struct.pack('>I',zlib.crc32(t+dd)&0xffffffff)
        b+=ch(b'IHDR',struct.pack('>IIBBBBB',w,h,8,ct,0,0,0))
        if ct==3: b+=ch(b'PLTE',bytes(random.randrange(256) for _ in range(768)))
        b+=ch(b'IDAT',b'\x78\x9c'+payload)+ch(b'IEND',b'')
    elif m==2: # zero out a random span
        p=random.randrange(40,len(b)); n=random.randrange(1,40)
        b[p:p+n]=bytes(n)
    else:      # bit flips
        for _ in range(random.randrange(1,12)):
            p=random.randrange(len(b)); b[p]^=1<<random.randrange(8)
    open('%s/g%04d.png'%(d,i),'wb').write(bytes(b))
print(len(os.listdir(d)),'inputs')
