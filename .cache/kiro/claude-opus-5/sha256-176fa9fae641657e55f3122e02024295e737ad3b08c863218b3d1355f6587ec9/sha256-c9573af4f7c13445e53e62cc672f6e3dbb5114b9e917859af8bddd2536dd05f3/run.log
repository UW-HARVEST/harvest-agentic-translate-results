     1	// Rust translation of c_src/src/driver.c
     2	//
     3	// Public ABI: `void driver(int x)` (see c_src/include/driver.h).
     4	//
     5	// Behaviour is reproduced exactly, including the use of C `stdio` `printf` so
     6	// that buffering/interleaving with any C caller's own stdio output matches the
     7	// original library byte for byte.
     8	
     9	use core::ffi::{c_char, c_int};
    10	
    11	unsafe extern "C" {
    12	    /// C `printf` from libc, used so output goes through the very same FILE
    13	    /// buffer the original library wrote to.
    14	    #[link_name = "printf"]
    15	    unsafe fn c_printf(fmt: *const c_char, ...) -> c_int;
    16	}
    17	
    18	/// Mirror of the C `house_t`:
    19	///
    20	/// ```c
    21	/// typedef struct {
    22	///     int floors;
    23	///     int bedrooms;
    24	///     double bathrooms;
    25	/// } house_t;
    26	/// ```
    27	///
    28	/// `repr(C)` gives the identical layout (offsets 0, 4, 8; size 16, align 8 on
    29	/// the LP64 targets the C library is built for), so the raw byte dump below is
    30	/// the same as the C version's.
    31	#[repr(C)]
    32	#[derive(Clone, Copy)]
    33	struct HouseT {
    34	    floors: c_int,
    35	    bedrooms: c_int,
    36	    bathrooms: f64,
    37	}
    38	
    39	/// Translation of the file-static `print_hex`. Kept private, exactly like the
    40	/// C `static` function, so it contributes no dynamic symbol.
    41	fn print_hex(p: &[u8]) {
    42	    // `for (int i = 0; i < len; i++) printf("%02x", p[i]);`
    43	    for &b in p {
    44	        unsafe {
    45	            c_printf(c"%02x".as_ptr(), c_int::from(b));
    46	        }
    47	    }
    48	    // `printf("\n");`
    49	    unsafe {
    50	        c_printf(c"\n".as_ptr());
    51	    }
    52	}
    53	
    54	/// `void driver(int floors)`
    55	#[unsafe(no_mangle)]
    56	pub extern "C" fn driver(floors: c_int) {
    57	    // house_t house = {0};
    58	    let mut house = HouseT {
    59	        floors: 0,
    60	        bedrooms: 0,
    61	        bathrooms: 0.0,
    62	    };
    63	
    64	    // house.floors = floors;
    65	    house.floors = floors;
    66	    // house.bedrooms = 3;
    67	    house.bedrooms = 3;
    68	    // house.bathrooms = 2.;
    69	    house.bathrooms = 2.0;
    70	
    71	    // char raw[sizeof(house)];
    72	    // memcpy(raw, &house, sizeof(house));
    73	    let mut raw = [0u8; core::mem::size_of::<HouseT>()];
    74	    unsafe {
    75	        core::ptr::copy_nonoverlapping(
    76	            (&raw const house).cast::<u8>(),
    77	            raw.as_mut_ptr(),
    78	            core::mem::size_of::<HouseT>(),
    79	        );
    80	    }
    81	
    82	    // print_hex((unsigned char *)&raw, sizeof(raw));
    83	    print_hex(&raw);
    84	}
