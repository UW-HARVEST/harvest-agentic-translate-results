[0m[49m[38;5;10m+    426[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    427[0m:[38;5;10m[49m fn config_c8_static_helper_not_exported() {
[0m[49m[38;5;10m+    428[0m:[38;5;10m[49m     for (name, lib) in [("C", &libs().c), ("Rust", &libs().rust)] {
[0m[49m[38;5;10m+    429[0m:[38;5;10m[49m         let sym: Result<Symbol<unsafe extern "C" fn(*const u8, c_int)>, _> =
[0m[49m[38;5;10m+    430[0m:[38;5;10m[49m             unsafe { lib.get(b"print_hex\0") };
[0m[49m[38;5;10m+    431[0m:[38;5;10m[49m         assert!(
