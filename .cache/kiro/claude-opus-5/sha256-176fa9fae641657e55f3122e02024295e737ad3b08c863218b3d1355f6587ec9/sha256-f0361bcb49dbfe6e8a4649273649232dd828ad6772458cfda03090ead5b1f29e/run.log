[0m[49m[38;5;10m+    451[0m:[38;5;10m[49m         assert_eq!(r.len(), 33, "{row}: Rust unexpectedly did not print a full line");
[0m[49m[38;5;10m+    452[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    453[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    454[0m:[38;5;10m[49m     // Exact expected images, so the test pins the C's actual behaviour rather
[0m[49m[38;5;10m+    455[0m:[38;5;10m[49m     // than only "both agree".
[0m[49m[38;5;10m+    456[0m:[38;5;10m[49m     assert_eq!(c_driver(0), b"00000000030000000000000000000040\n");
[0m[49m[38;5;10m+    457[0m:[38;5;10m[49m     assert_eq!(rust_driver(0), b"00000000030000000000000000000040\n");
[0m[49m[38;5;10m+    458[0m:[38;5;10m[49m     assert_eq!(c_driver(-1), b"ffffffff030000000000000000000040\n");
[0m[49m[38;5;10m+    459[0m:[38;5;10m[49m     assert_eq!(rust_driver(-1), b"ffffffff030000000000000000000040\n");
[0m[49m[38;5;10m+    460[0m:[38;5;10m[49m     assert_eq!(c_driver(i32::MAX), b"ffffff7f030000000000000000000040\n");
[0m[49m[38;5;10m+    461[0m:[38;5;10m[49m     assert_eq!(rust_driver(i32::MAX), b"ffffff7f030000000000000000000040\n");
[0m[49m[38;5;10m+    462[0m:[38;5;10m[49m     assert_eq!(c_driver(i32::MIN), b"00000080030000000000000000000040\n");
[0m[49m[38;5;10m+    463[0m:[38;5;10m[49m     assert_eq!(rust_driver(i32::MIN), b"00000080030000000000000000000040\n");
[0m[49m[38;5;10m+    464[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    465[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    466[0m:[38;5;10m[49m /// ERRORS.md E5/E6 — values one step past the signed range, passed as
[0m[49m[38;5;10m+    467[0m:[38;5;10m[49m /// `unsigned int` across the FFI boundary. There is no valid-range check in
[0m[49m[38;5;10m+    468[0m:[38;5;10m[49m /// the C, so both must reinterpret identically.
[0m[49m[38;5;10m+    469[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    470[0m:[38;5;10m[49m fn error_surface_e5_e6_out_of_signed_range() {
[0m[49m[38;5;10m+    471[0m:[38;5;10m[49m     for x in [
[0m[49m[38;5;10m+    472[0m:[38;5;10m[49m         0x8000_0000u32,
[0m[49m[38;5;10m+    473[0m:[38;5;10m[49m         0xFFFF_FFFFu32,
[0m[49m[38;5;10m+    474[0m:[38;5;10m[49m         0x8000_0001u32,
[0m[49m[38;5;10m+    475[0m:[38;5;10m[49m         0x7FFF_FFFFu32 + 1,
[0m[49m[38;5;10m+    476[0m:[38;5;10m[49m         u32::MAX - 1,
[0m[49m[38;5;10m+    477[0m:[38;5;10m[49m     ] {
[0m[49m[38;5;10m+    478[0m:[38;5;10m[49m         let c = c_driver_u32(x);
[0m[49m[38;5;10m+    479[0m:[38;5;10m[49m         let r = rust_driver_u32(x);
[0m[49m[38;5;10m+    480[0m:[38;5;10m[49m         assert_same("E5/E6", i64::from(x), &c, &r);
[0m[49m[38;5;10m+    481[0m:[38;5;10m[49m         // Must be identical to the signed reinterpretation — no rejection.
[0m[49m[38;5;10m+    482[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    483[0m:[38;5;10m[49m             c,
[0m[49m[38;5;10m+    484[0m:[38;5;10m[49m             c_driver(x as i32),
[0m[49m[38;5;10m+    485[0m:[38;5;10m[49m             "E5/E6: C treated unsigned {x:#x} differently from its signed reading"
[0m[49m[38;5;10m+    486[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    487[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    488[0m:[38;5;10m[49m             r,
[0m[49m[38;5;10m+    489[0m:[38;5;10m[49m             rust_driver(x as i32),
[0m[49m[38;5;10m+    490[0m:[38;5;10m[49m             "E5/E6: Rust treated unsigned {x:#x} differently from its signed reading"
[0m[49m[38;5;10m+    491[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    492[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    493[0m:[38;5;10m[49m     assert_eq!(c_driver_u32(0x8000_0000), b"00000080030000000000000000000040\n");
[0m[49m[38;5;10m+    494[0m:[38;5;10m[49m     assert_eq!(rust_driver_u32(0x8000_0000), b"00000080030000000000000000000040\n");
[0m[49m[38;5;10m+    495[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    496[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    497[0m:[38;5;10m[49m /// ERRORS.md E7 — "out-of-range enum values". The library declares no enum, so
[0m[49m[38;5;10m+    498[0m:[38;5;10m[49m /// every int is a valid input and neither side may reject any of them.
[0m[49m[38;5;10m+    499[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    500[0m:[38;5;10m[49m fn error_surface_e7_out_of_range_enum_like_values() {
[0m[49m[38;5;10m+    501[0m:[38;5;10m[49m     let cases: [i32; 11] = [
[0m[49m[38;5;10m+    502[0m:[38;5;10m[49m         i32::MIN,
[0m[49m[38;5;10m+    503[0m:[38;5;10m[49m         -2,
[0m[49m[38;5;10m+    504[0m:[38;5;10m[49m         -1,
[0m[49m[38;5;10m+    505[0m:[38;5;10m[49m         0,
[0m[49m[38;5;10m+    506[0m:[38;5;10m[49m         1,
[0m[49m[38;5;10m+    507[0m:[38;5;10m[49m         2,
[0m[49m[38;5;10m+    508[0m:[38;5;10m[49m         255,
[0m[49m[38;5;10m+    509[0m:[38;5;10m[49m         256,
[0m[49m[38;5;10m+    510[0m:[38;5;10m[49m         65535,
[0m[49m[38;5;10m+    511[0m:[38;5;10m[49m         65536,
[0m[49m[38;5;10m+    512[0m:[38;5;10m[49m         i32::MAX,
[0m[49m[38;5;10m+    513[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    514[0m:[38;5;10m[49m     for x in cases {
[0m[49m[38;5;10m+    515[0m:[38;5;10m[49m         let c = c_driver(x);
[0m[49m[38;5;10m+    516[0m:[38;5;10m[49m         let r = rust_driver(x);
[0m[49m[38;5;10m+    517[0m:[38;5;10m[49m         assert_same("E7", i64::from(x), &c, &r);
[0m[49m[38;5;10m+    518[0m:[38;5;10m[49m         assert_eq!(c.len(), 33, "E7: C rejected {x} (short output)");
[0m[49m[38;5;10m+    519[0m:[38;5;10m[49m         assert_eq!(r.len(), 33, "E7: Rust rejected {x} (short output)");
[0m[49m[38;5;10m+    520[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    521[0m:[38;5;10m[49m     // Every distinct input must give a distinct output (the value is not
[0m[49m[38;5;10m+    522[0m:[38;5;10m[49m     // clamped, saturated, or normalised on either side).
[0m[49m[38;5;10m+    523[0m:[38;5;10m[49m     let mut c_outs: Vec<Vec<u8>> = cases.iter().map(|&x| c_driver(x)).collect();
[0m[49m[38;5;10m+    524[0m:[38;5;10m[49m     let mut r_outs: Vec<Vec<u8>> = cases.iter().map(|&x| rust_driver(x)).collect();
[0m[49m[38;5;10m+    525[0m:[38;5;10m[49m     assert_eq!(c_outs, r_outs, "E7: output sets diverge");
[0m[49m[38;5;10m+    526[0m:[38;5;10m[49m     c_outs.sort();
[0m[49m[38;5;10m+    527[0m:[38;5;10m[49m     c_outs.dedup();
[0m[49m[38;5;10m+    528[0m:[38;5;10m[49m     assert_eq!(c_outs.len(), cases.len(), "E7: C collapsed distinct inputs");
[0m[49m[38;5;10m+    529[0m:[38;5;10m[49m     r_outs.sort();
[0m[49m[38;5;10m+    530[0m:[38;5;10m[49m     r_outs.dedup();
[0m[49m[38;5;10m+    531[0m:[38;5;10m[49m     assert_eq!(r_outs.len(), cases.len(), "E7: Rust collapsed distinct inputs");
[0m[49m[38;5;10m+    532[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    533[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    534[0m:[38;5;10m[49m /// ERRORS.md E8 — oversized (64-bit) argument; the ABI truncates to 32 bits.
[0m[49m[38;5;10m+    535[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    536[0m:[38;5;10m[49m fn error_surface_e8_oversized_argument() {
[0m[49m[38;5;10m+    537[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 0xE8);
[0m[49m[38;5;10m+    538[0m:[38;5;10m[49m     let mut cases: Vec<u64> = vec![
[0m[49m[38;5;10m+    539[0m:[38;5;10m[49m         0x0000_0001_0000_0001,
[0m[49m[38;5;10m+    540[0m:[38;5;10m[49m         0xFFFF_FFFF_0000_0000,
[0m[49m[38;5;10m+    541[0m:[38;5;10m[49m         0xDEAD_BEEF_CAFE_BABE,
[0m[49m[38;5;10m+    542[0m:[38;5;10m[49m         u64::MAX,
[0m[49m[38;5;10m+    543[0m:[38;5;10m[49m         0x1_8000_0000,
[0m[49m[38;5;10m+    544[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    545[0m:[38;5;10m[49m     for _ in 0..256 {
[0m[49m[38;5;10m+    546[0m:[38;5;10m[49m         cases.push(((rng.next_u32() as u64) << 32) | rng.next_u32() as u64);
[0m[49m[38;5;10m+    547[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    548[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    549[0m:[38;5;10m[49m     for x in cases {
[0m[49m[38;5;10m+    550[0m:[38;5;10m[49m         let c = c_driver_u64(x);
[0m[49m[38;5;10m+    551[0m:[38;5;10m[49m         let r = rust_driver_u64(x);
[0m[49m[38;5;10m+    552[0m:[38;5;10m[49m         assert_same("E8", x as i64, &c, &r);
[0m[49m[38;5;10m+    553[0m:[38;5;10m[49m         // Must equal the low-32-bit call on both sides.
[0m[49m[38;5;10m+    554[0m:[38;5;10m[49m         let low = x as u32 as i32;
[0m[49m[38;5;10m+    555[0m:[38;5;10m[49m         assert_eq!(c, c_driver(low), "E8: C did not truncate {x:#x} to {low}");
[0m[49m[38;5;10m+    556[0m:[38;5;10m[49m         assert_eq!(r, rust_driver(low), "E8: Rust did not truncate {x:#x} to {low}");
[0m[49m[38;5;10m+    557[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    558[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    559[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    560[0m:[38;5;10m[49m /// ERRORS.md E9/E10 — documented as not applicable; this test proves the
[0m[49m[38;5;10m+    561[0m:[38;5;10m[49m /// premise (the public API takes exactly one scalar and no pointer/length) by
[0m[49m[38;5;10m+    562[0m:[38;5;10m[49m /// showing that calling `driver` with a pointer-shaped bit pattern is still
[0m[49m[38;5;10m+    563[0m:[38;5;10m[49m /// just an integer to both libraries, i.e. there is no pointer to be null.
[0m[49m[38;5;10m+    564[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    565[0m:[38;5;10m[49m fn error_surface_e9_e10_no_pointer_or_length_parameter() {
[0m[49m[38;5;10m+    566[0m:[38;5;10m[49m     // A "null pointer"-looking argument is simply the integer 0 (== row E1),
[0m[49m[38;5;10m+    567[0m:[38;5;10m[49m     // and an arbitrary pointer-looking bit pattern is simply its low 32 bits.
[0m[49m[38;5;10m+    568[0m:[38;5;10m[49m     assert_eq!(c_driver(0), rust_driver(0));
[0m[49m[38;5;10m+    569[0m:[38;5;10m[49m     assert_eq!(c_driver(0), c_driver_u64(0));
[0m[49m[38;5;10m+    570[0m:[38;5;10m[49m     assert_eq!(rust_driver(0), rust_driver_u64(0));
[0m[49m[38;5;10m+    571[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    572[0m:[38;5;10m[49m     let ptrish = 0x7FFF_1234_5678u64;
[0m[49m[38;5;10m+    573[0m:[38;5;10m[49m     assert_eq!(c_driver_u64(ptrish), rust_driver_u64(ptrish));
[0m[49m[38;5;10m+    574[0m:[38;5;10m[49m     assert_eq!(c_driver_u64(ptrish), c_driver(ptrish as u32 as i32));
[0m[49m[38;5;10m+    575[0m:[38;5;10m[49m 
