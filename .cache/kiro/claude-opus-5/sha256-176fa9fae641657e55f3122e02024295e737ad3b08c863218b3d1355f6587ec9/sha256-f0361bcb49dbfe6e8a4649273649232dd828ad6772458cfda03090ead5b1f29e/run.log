[0m[49m[38;5;10m+    410[0m:[38;5;10m[49m         let bedrooms = i32::from_le_bytes(bytes[4..8].try_into().unwrap());
[0m[49m[38;5;10m+    411[0m:[38;5;10m[49m         let bathrooms = f64::from_le_bytes(bytes[8..16].try_into().unwrap());
[0m[49m[38;5;10m+    412[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    413[0m:[38;5;10m[49m         assert_eq!(floors, x, "C7: floors field mismatch for {x}");
[0m[49m[38;5;10m+    414[0m:[38;5;10m[49m         assert_eq!(bedrooms, 3, "C7: bedrooms field must be 3 for {x}");
[0m[49m[38;5;10m+    415[0m:[38;5;10m[49m         assert_eq!(bathrooms, 2.0, "C7: bathrooms field must be 2.0 for {x}");
[0m[49m[38;5;10m+    416[0m:[38;5;10m[49m         assert_eq!(
[0m[49m[38;5;10m+    417[0m:[38;5;10m[49m             &bytes[8..16],
[0m[49m[38;5;10m+    418[0m:[38;5;10m[49m             &2.0f64.to_le_bytes(),
[0m[49m[38;5;10m+    419[0m:[38;5;10m[49m             "C7: bathrooms IEEE-754 image mismatch for {x}"
[0m[49m[38;5;10m+    420[0m:[38;5;10m[49m         );
[0m[49m[38;5;10m+    421[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    422[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    423[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    424[0m:[38;5;10m[49m /// CONFIGS.md C8 — `print_hex` must not be an exported symbol in either
