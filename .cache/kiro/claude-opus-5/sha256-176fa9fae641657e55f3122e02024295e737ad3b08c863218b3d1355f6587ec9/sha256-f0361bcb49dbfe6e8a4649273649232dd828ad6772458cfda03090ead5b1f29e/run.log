[0m[49m[38;5;10m+    440[0m:[38;5;10m[49m // ===========================================================================
[0m[49m[38;5;10m+    441[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    442[0m:[38;5;10m[49m /// ERRORS.md E1–E4 — the zero / extreme / all-bits-set boundaries.
[0m[49m[38;5;10m+    443[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    444[0m:[38;5;10m[49m fn error_surface_e1_e4_boundaries() {
[0m[49m[38;5;10m+    445[0m:[38;5;10m[49m     for (row, x) in [("E1", 0i32), ("E2", i32::MAX), ("E3", i32::MIN), ("E4", -1)] {
[0m[49m[38;5;10m+    446[0m:[38;5;10m[49m         let c = c_driver(x);
[0m[49m[38;5;10m+    447[0m:[38;5;10m[49m         let r = rust_driver(x);
[0m[49m[38;5;10m+    448[0m:[38;5;10m[49m         assert_same(row, i64::from(x), &c, &r);
