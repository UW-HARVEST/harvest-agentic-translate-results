[0m[49m[38;5;10m+    523[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    524[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    525[0m:[38;5;10m[49m fn output_format_is_byte_exact() {
[0m[49m[38;5;10m+    526[0m:[38;5;10m[49m     // Checked against the C program's own bytes, then pinned to the literal
[0m[49m[38;5;10m+    527[0m:[38;5;10m[49m     // format string from the C source.
[0m[49m[38;5;10m+    528[0m:[38;5;10m[49m     assert_identical("format", b"-17 5");
[0m[49m[38;5;10m+    529[0m:[38;5;10m[49m     let c = run(c_binary(), b"-17 5");
[0m[49m[38;5;10m+    530[0m:[38;5;10m[49m     let rust = run(rust_binary(), b"-17 5");
[0m[49m[38;5;10m+    531[0m:[38;5;10m[49m     assert_eq!(c.stdout, b"quotient: -3, remainder: -2\n".to_vec());
[0m[49m[38;5;10m+    532[0m:[38;5;10m[49m     assert_eq!(rust.stdout, c.stdout);
[0m[49m[38;5;10m+    533[0m:[38;5;10m[49m     // No padding, no extra newline, nothing on stderr.
