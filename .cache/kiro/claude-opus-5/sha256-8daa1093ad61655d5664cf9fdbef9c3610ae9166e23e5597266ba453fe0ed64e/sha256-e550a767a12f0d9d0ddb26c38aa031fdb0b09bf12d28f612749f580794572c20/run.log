import re
p='src/dtoa.rs'
s=open(p).read()
orig=s

# Confine the rewrite to the two "fast path" state-machine arms of dtoa_r, which
# are the places where the C relies on modular u64 arithmetic and on x86 shift
# masking.
start = s.index('                L::Toobig => {')
end   = s.index('                L::FastFailed1 => {')
body  = s[start:end]

pairs = [
    # additive / subtractive modular arithmetic
    ('res + rb > ures - rb',            'res.wrapping_add(rb) > ures.wrapping_sub(rb)'),
    ('res - rb <= ures + rb',           'res.wrapping_sub(rb) <= ures.wrapping_add(rb)'),
    ('(res + rb) << (1 - eulp) >= ulp_v', 'res.wrapping_add(rb).wrapping_shl((1 - eulp) as u32) >= ulp_v'),
    ('ures + rb >= res - rb',           'ures.wrapping_add(rb) >= res.wrapping_sub(rb)'),
    ('ures - rb < res + rb',            'ures.wrapping_sub(rb) < res.wrapping_add(rb)'),
    ('ures << (-eulp) < ulp_v',         'ures.wrapping_shl((-eulp) as u32) < ulp_v'),
    ('ures << (1 - eulp) < ulp_v',      'ures.wrapping_shl((1 - eulp) as u32) < ulp_v'),
    ('res - rb <= ures + rb',           'res.wrapping_sub(rb) <= ures.wrapping_add(rb)'),
    ('ures - rb <= res + rb',           'ures.wrapping_sub(rb) <= res.wrapping_add(rb)'),
    ('res + rb < ures - rb',            'res.wrapping_add(rb) < ures.wrapping_sub(rb)'),
    ('res - rb > ures + rb',            'res.wrapping_sub(rb) > ures.wrapping_add(rb)'),
    ('sres = (res - rb) << (1 - eulp);', 'sres = res.wrapping_sub(rb).wrapping_shl((1 - eulp) as u32);'),
    ('sres = res << (1 - eulp);',        'sres = res.wrapping_shl((1 - eulp) as u32);'),
    ('sres += (rblo + reslo) >> j;',     'sres = sres.wrapping_add(rblo.wrapping_add(reslo) >> j);'),
    ('sres += (rblo + reslo) << (-j);',  'sres = sres.wrapping_add(rblo.wrapping_add(reslo).wrapping_shl((-j) as u32));'),
    ('sres + (rb << (1 - eulp)) >= ulp_v', 'sres.wrapping_add(rb.wrapping_shl((1 - eulp) as u32)) >= ulp_v'),
    ('(ures - rb) << (1 - eulp) < ulp_v', 'ures.wrapping_sub(rb).wrapping_shl((1 - eulp) as u32) < ulp_v'),
    ('(ures + rb) << (1 - eulp) < ulp_v', 'ures.wrapping_add(rb).wrapping_shl((1 - eulp) as u32) < ulp_v'),
    ('zb & (res + rb) == 0',             'zb & res.wrapping_add(rb) == 0'),
    ('sres = (reslo + rblo) >> 31;',     'sres = reslo.wrapping_add(rblo) >> 31;'),
    ('sres += 2 * rb;',                  'sres = sres.wrapping_add(2u64.wrapping_mul(rb));'),
    ('ures <= sres || res - ures <= sres', 'ures <= sres || res.wrapping_sub(ures) <= sres'),
    ('res <= sres || ures - res <= sres',  'res <= sres || ures.wrapping_sub(res) <= sres'),
    # multiplicative modular arithmetic
    ('rb *= 10;',        'rb = rb.wrapping_mul(10);'),
    ('res *= 10;',       'res = res.wrapping_mul(10);'),
    ('ulp_v *= 5;',      'ulp_v = ulp_v.wrapping_mul(5);'),
    ('rblo *= 10;',      'rblo = rblo.wrapping_mul(10);'),
    ('rb = 10 * rb + (rblo >> 32);',   'rb = 10u64.wrapping_mul(rb).wrapping_add(rblo >> 32);'),
    ('reslo *= 10;',     'reslo = reslo.wrapping_mul(10);'),
    ('res = 10 * res + (reslo >> 32);', 'res = 10u64.wrapping_mul(res).wrapping_add(reslo >> 32);'),
    ('sulp_v = ulp_v << (eulp - 1);',   'sulp_v = ulp_v.wrapping_shl((eulp - 1) as u32);'),
    ('sulp_v = (ulp_v << (eulp - 1)) - rb;', 'sulp_v = ulp_v.wrapping_shl((eulp - 1) as u32).wrapping_sub(rb);'),
    ('zb = (1u64 << (eulp + 63)).wrapping_neg();', 'zb = (1u64.wrapping_shl((eulp + 63) as u32)).wrapping_neg();'),
    ('zb = (1u64 << (eulp + 60)).wrapping_neg();', 'zb = (1u64.wrapping_shl((eulp + 60) as u32)).wrapping_neg();'),
    ('res = res0 >> i;',  'res = res0.wrapping_shr(i as u32);'),
    ('reslo = ((res0 << (64 - i)) >> 32) | (reslo >> i);',
     'reslo = (res0.wrapping_shl((64 - i) as u32) >> 32) | reslo.wrapping_shr(i as u32);'),
    ('res >>= 4 - be;',   'res = res.wrapping_shr((4 - be) as u32);'),
    ('2 * res <= ulp_v',  '2u64.wrapping_mul(res) <= ulp_v'),
    ('4 * res <= ulp_v',  '4u64.wrapping_mul(res) <= ulp_v'),
    ('2 * res < ulp_v',   '2u64.wrapping_mul(res) < ulp_v'),
    ('2 * ures < ulp_v',  '2u64.wrapping_mul(ures) < ulp_v'),
    ('2 * sres < ulp_v',  '2u64.wrapping_mul(sres) < ulp_v'),
    ('ures = 0x1000000000000000 - res;', 'ures = 0x1000000000000000u64.wrapping_sub(res);'),
    ('ureslo = 0x100000000 - reslo;',    'ureslo = 0x100000000u64.wrapping_sub(reslo);'),
    ('ures -= 1;',        'ures = ures.wrapping_sub(1);'),
]
for a,b in pairs:
    body = body.replace(a,b)
s = s[:start] + body + s[end:]
open(p,'w').write(s)
print('dtoa.rs patched, changed =', s != orig)
