     1	//! Rust translation of `c_src/src/lib.c`.
     2	//!
     3	//! The C library exports exactly one public symbol, `searchAndReplace`
     4	//! (declared in `c_src/include/lib.h`, no namespace/renaming macros are
     5	//! involved). The translation below reproduces the original control flow,
     6	//! allocation strategy and quirks (including `strncpy`'s NUL-padding
     7	//! behaviour and the non-terminating behaviour for an empty `search`
     8	//! string) byte for byte.
     9	//!
    10	//! The returned buffer is allocated with the platform `malloc`/`realloc`
    11	//! (and `strdup`), so callers may release it with `free()` exactly as with
    12	//! the C implementation.
    13	
    14	use std::ffi::{c_char, c_void};
    15	
    16	extern "C" {
    17	    fn malloc(size: usize) -> *mut c_void;
    18	    fn realloc(ptr: *mut c_void, size: usize) -> *mut c_void;
    19	    fn strdup(s: *const c_char) -> *mut c_char;
    20	    fn strlen(s: *const c_char) -> usize;
    21	}
    22	
    23	/// Equivalent of `strstr(hay + start, needle)`, returning the offset of the
    24	/// match relative to the beginning of `hay`.
    25	///
    26	/// `hay` holds the bytes of a NUL-terminated string (without the NUL) and
    27	/// `start <= hay.len()`. As with `strstr`, an empty `needle` matches
    28	/// immediately at `start`.
    29	fn c_strstr(hay: &[u8], start: usize, needle: &[u8]) -> Option<usize> {
    30	    if needle.is_empty() {
    31	        return Some(start);
    32	    }
    33	    if needle.len() > hay.len() {
    34	        return None;
    35	    }
    36	    let last = hay.len() - needle.len();
    37	    let mut i = start;
    38	    while i <= last {
    39	        if &hay[i..i + needle.len()] == needle {
    40	            return Some(i);
    41	        }
    42	        i += 1;
    43	    }
    44	    None
    45	}
    46	
    47	/// Equivalent of `strncpy(dst, src, n)` where `src` holds the bytes of the
    48	/// source NUL-terminated string (without the NUL): at most `n` bytes are
    49	/// copied and, if the source is shorter than `n`, the remainder of the `n`
    50	/// destination bytes is filled with NULs.
    51	///
    52	/// # Safety
    53	/// `dst` must be valid for `n` writes.
    54	unsafe fn c_strncpy(dst: *mut u8, src: &[u8], n: usize) {
    55	    let copied = if src.len() < n { src.len() } else { n };
    56	    std::ptr::copy_nonoverlapping(src.as_ptr(), dst, copied);
    57	    if copied < n {
    58	        std::ptr::write_bytes(dst.add(copied), 0u8, n - copied);
    59	    }
    60	}
    61	
    62	/// See `searchAndReplace` in `c_src/src/lib.c`.
    63	///
    64	/// # Safety
    65	/// `orig`, `search` and `value` must be valid NUL-terminated C strings, as
    66	/// required by the original C implementation.
    67	#[unsafe(no_mangle)]
    68	pub unsafe extern "C" fn searchAndReplace(
    69	    orig: *const c_char,
    70	    search: *const c_char,
    71	    value: *const c_char,
    72	) -> *mut c_char {
    73	    let p: Option<usize>;
    74	    let orig_len: usize = strlen(orig);
    75	    let search_len: usize = strlen(search);
    76	    let value_len: usize = strlen(value);
    77	
    78	    let mut inx_start: usize;
