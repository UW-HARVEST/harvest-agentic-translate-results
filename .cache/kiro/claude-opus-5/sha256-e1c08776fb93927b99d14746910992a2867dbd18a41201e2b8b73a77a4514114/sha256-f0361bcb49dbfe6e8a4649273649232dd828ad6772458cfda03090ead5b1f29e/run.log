     8	char *searchAndReplace(const char *orig, const char *search, const char *value)
     9	{
    10	    char *p;
    11	    const size_t orig_len = strlen(orig);
    12	    const size_t search_len = strlen(search);
    13	    const size_t value_len = strlen(value);
    14	
    15	    size_t inx_start;
    16	    char *tmp = NULL;
    17	    size_t tmp_offset = 0;
    18	    size_t total_bytes_allocated = 1;
    19	    size_t from;
    20	
    21	    /* Check for any match */
    22	    p = strstr(orig, search);
    23	    if (p == NULL) {
    24	        tmp = strdup(orig);
    25	        return tmp;
    26	    }
    27	
    28	    inx_start = (size_t) (p - orig);
    29	    from = inx_start + search_len;
    30	
    31	    /* Copy content before first match, if any */
    32	    if (inx_start > 0) {
    33	        total_bytes_allocated = inx_start + 1;
    34	        tmp = malloc(sizeof(char) * total_bytes_allocated);
    35	        if (tmp == NULL) {
    36	            return NULL;
    37	        }
    38	        strncpy(tmp, orig, inx_start);
    39	        tmp_offset = inx_start;
    40	    }
    41	
    42	    while (p != NULL) {
    43	        /* Copy replacement */
    44	        total_bytes_allocated += value_len;
    45	        tmp = realloc(tmp, total_bytes_allocated);
    46	        if (tmp == NULL) {
    47	            return NULL;
    48	        }
    49	
    50	        strncpy(tmp + tmp_offset, value, total_bytes_allocated - tmp_offset);
    51	        tmp_offset += value_len;
    52	
    53	        /* Search for further occurrences */
    54	        p = strstr(orig + inx_start + search_len, search);
    55	        if (p != NULL) {
    56	            size_t inx_start2 = (size_t) (p - orig);
    57	
    58	            /* Copy content between matches, if any */
    59	            if (inx_start2 > from) {
    60	                size_t gap = inx_start2 - from;
    61	                total_bytes_allocated += gap;
    62	                tmp = realloc(tmp, total_bytes_allocated);
    63	                if (tmp == NULL) {
    64	                    return NULL;
    65	                }
    66	                strncpy(tmp + tmp_offset, orig + from, gap);
    67	                tmp_offset += gap;
    68	            }
    69	
    70	            inx_start = inx_start2;
    71	        }
    72	
    73	        /* Set position for copying content after last match */
    74	        from = inx_start + search_len;
    75	    }
    76	
    77	    /* Copy content after last match, if any */
    78	    if ((from < orig_len) && from > 0) {
    79	        total_bytes_allocated += orig_len - from;
    80	        tmp = realloc(tmp, total_bytes_allocated);
    81	        if (tmp == NULL) {
    82	            return NULL;
    83	        }
    84	        strncpy(tmp + tmp_offset, orig + from, orig_len - from);
    85	    }
    86	
    87	    tmp[total_bytes_allocated - 1] = '\0';
    88	
    89	    return tmp;
    90	}

