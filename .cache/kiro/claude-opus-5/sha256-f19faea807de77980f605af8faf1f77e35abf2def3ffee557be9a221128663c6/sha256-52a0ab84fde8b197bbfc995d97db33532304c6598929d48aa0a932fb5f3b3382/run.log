#[cfg(secpar_192s)]
pub const SPX_FORS_HEIGHT: usize = 14;
#[cfg(secpar_192s)]
pub const SPX_FORS_TREES: usize = 17;

#[cfg(secpar_192f)]
pub const SPX_N: usize = 24;
#[cfg(secpar_192f)]
pub const SPX_FULL_HEIGHT: usize = 66;
#[cfg(secpar_192f)]
