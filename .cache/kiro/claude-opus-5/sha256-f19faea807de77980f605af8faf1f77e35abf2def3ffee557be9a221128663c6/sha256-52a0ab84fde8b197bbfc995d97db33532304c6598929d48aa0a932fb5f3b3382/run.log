name = "sphincsplus"
path = "src/lib.rs"
crate-type = ["cdylib"]

[[bin]]
name = "driver"
path = "src/main.rs"

[dependencies]
aes = "0.8.4"

[features]
default = ["blake", "simple", "128f"]

# HASH_BACKEND cache variable values
