#[cfg(secpar_192f)]
pub const SPX_FORS_HEIGHT: usize = 8;
#[cfg(secpar_192f)]
pub const SPX_FORS_TREES: usize = 33;

#[cfg(secpar_256s)]
pub const SPX_N: usize = 32;
#[cfg(secpar_256s)]
pub const SPX_FULL_HEIGHT: usize = 64;
#[cfg(secpar_256s)]
pub const SPX_D: usize = 8;
#[cfg(secpar_256s)]
pub const SPX_FORS_HEIGHT: usize = 14;
#[cfg(secpar_256s)]
