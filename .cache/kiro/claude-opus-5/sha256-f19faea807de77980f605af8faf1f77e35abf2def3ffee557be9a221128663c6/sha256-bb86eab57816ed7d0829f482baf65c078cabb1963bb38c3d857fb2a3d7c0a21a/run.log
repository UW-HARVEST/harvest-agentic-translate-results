 */
void thash(unsigned char *out, const unsigned char *in, unsigned int inblocks,
           const spx_ctx *ctx, uint32_t addr[8])
{
#if SPX_BLAKE512
    if (inblocks > 1) {
	thash_512(out, in, inblocks, ctx, addr);
        return;
