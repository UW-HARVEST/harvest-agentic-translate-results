[0m[49m[38;5;10m+    773[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    774[0m:[38;5;10m[49m fn row18_row19_bytes_to_ull_degenerate() {
[0m[49m[38;5;10m+    775[0m:[38;5;10m[49m     let libs = Libs::load();
[0m[49m[38;5;10m+    776[0m:[38;5;10m[49m     type F = unsafe extern "C" fn(*const u8, c_uint) -> u64;
