echo "RUST_UNDEFINED_NONLIBC:"
nm -D -u "$ROOT/translation/target/release/libsphincsplus.so" | awk '{print $2}' \
  | grep -v '@GLIBC' | grep -v '^_ITM' | grep -v '^__' | sed 's/^/  /'
EOF
