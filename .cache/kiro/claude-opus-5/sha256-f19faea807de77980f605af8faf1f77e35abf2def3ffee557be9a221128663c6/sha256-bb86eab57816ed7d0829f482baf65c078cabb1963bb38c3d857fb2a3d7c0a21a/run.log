[package]
name = "sphincsplus"
version = "0.1.0"
edition = "2021"
build = "build.rs"

[lib]
name = "sphincsplus"
path = "src/lib.rs"
crate-type = ["cdylib"]

[[bin]]
name = "driver"
path = "src/main.rs"

[dependencies]
aes = "0.8.4"

[features]
default = ["blake", "simple", "128f"]

# HASH_BACKEND cache variable values
haraka = []
sha2 = []
shake = []
blake = []
# CMakeLists.txt spells the SHAKE backend "shake256" in its help string while
# the source tree directory is "shake"; accept both spellings.
shake256 = ["shake"]

# THASH cache variable values
robust = []
simple = []

# SECPAR cache variable values
"128s" = []
"128f" = []
"192s" = []
"192f" = []
"256s" = []
"256f" = []

# Selects the non-deterministic /dev/urandom randombytes() (randombytes.c,
# CMake target `sphincs_core`) instead of the NIST deterministic DRBG
# (rng.c, CMake target `sphincs_core_det`).  The driver executable links the
# deterministic core, which is the default here as well.
urandom = []

[profile.release]
opt-level = 3

