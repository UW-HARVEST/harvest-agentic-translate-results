[0m[49m[38;5;10m+    754[0m:[38;5;10m[49m fn row17_ull_to_bytes_zero_outlen() {
[0m[49m[38;5;10m+    755[0m:[38;5;10m[49m     let libs = Libs::load();
[0m[49m[38;5;10m+    756[0m:[38;5;10m[49m     type F = unsafe extern "C" fn(*mut u8, c_uint, u64);
[0m[49m[38;5;10m+    757[0m:[38;5;10m[49m     let (c, r) = pair!(libs, "SPX_ull_to_bytes", F);
[0m[49m[38;5;10m+    758[0m:[38;5;10m[49m     let mut rng = Rng::new(915);
[0m[49m[38;5;10m+    759[0m:[38;5;10m[49m     for i in 0..200 {
[0m[49m[38;5;10m+    760[0m:[38;5;10m[49m         let v = if i == 0 { 0 } else { rng.next_u64() };
[0m[49m[38;5;10m+    761[0m:[38;5;10m[49m         let mut cb = [0xAAu8; 16];
[0m[49m[38;5;10m+    762[0m:[38;5;10m[49m         let mut rb = [0xAAu8; 16];
[0m[49m[38;5;10m+    763[0m:[38;5;10m[49m         unsafe {
[0m[49m[38;5;10m+    764[0m:[38;5;10m[49m             c(cb.as_mut_ptr(), 0, v);
[0m[49m[38;5;10m+    765[0m:[38;5;10m[49m             r(rb.as_mut_ptr(), 0, v);
[0m[49m[38;5;10m+    766[0m:[38;5;10m[49m         }
