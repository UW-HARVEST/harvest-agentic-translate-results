[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m /// partial word such as `infi` is a matching failure rather than infinity.
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m fn infinity_forms_including_partial_matches() {
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m     check_all(with_all_prefixes(&[
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m         "inf", "INF", "Inf", "iNf", "infinity", "INFINITY", "InFiNiTy", "infx", "inf5", "inf.",
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m         "infinityy", "infinity5", "i", "in", "infi", "infin", "infini", "infinit", "INFI",
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m         "Infinit",
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m     ]));
