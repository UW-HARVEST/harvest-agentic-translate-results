[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m /// `nan`: matched three letters only. The optional `(n-char-sequence)` payload
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m /// is never collected, so the payload cannot reach the result.
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m fn nan_forms_including_payloads() {
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m     check_all(with_all_prefixes(&[
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m         "nan", "NAN", "NaN", "nAn", "nanx", "nan5", "nan(", "nan()", "nan(1", "nan(123)",
