[0m[49m[38;5;10m+    133[0m:[38;5;10m[49m         assert_identical(input.as_ref());
[0m[49m[38;5;10m+    134[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    135[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    136[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    137[0m:[38;5;10m[49m /// Every sign / leading-whitespace prefix the scanf skip can see. A leading `-`
[0m[49m[38;5;10m+    138[0m:[38;5;10m[49m /// is what makes a matching failure observable: on failure the C program keeps
[0m[49m[38;5;10m+    139[0m:[38;5;10m[49m /// its initial `+0.0f` (`00000000`), while a successful conversion of a
[0m[49m[38;5;10m+    140[0m:[38;5;10m[49m /// zero-valued token stores `-0.0f` (`00000080`).
[0m[49m[38;5;10m+    141[0m:[38;5;10m[49m const PREFIXES: [&str; 7] = ["", "-", "+", "  ", "  -", "\n-", "-  "];
[0m[49m[38;5;10m+    142[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    143[0m:[38;5;10m[49m fn with_all_prefixes(bodies: &[&str]) -> Vec<Vec<u8>> {
[0m[49m[38;5;10m+    144[0m:[38;5;10m[49m     let mut out = Vec::with_capacity(bodies.len() * PREFIXES.len());
[0m[49m[38;5;10m+    145[0m:[38;5;10m[49m     for body in bodies {
[0m[49m[38;5;10m+    146[0m:[38;5;10m[49m         for p in PREFIXES {
[0m[49m[38;5;10m+    147[0m:[38;5;10m[49m             out.push(format!("{p}{body}").into_bytes());
[0m[49m[38;5;10m+    148[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    149[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    150[0m:[38;5;10m[49m     out
[0m[49m[38;5;10m+    151[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    152[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    153[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    154[0m:[38;5;10m[49m // Phase A sanity: both programs are runnable and agree on the trivial input
[0m[49m[38;5;10m+    155[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    156[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    157[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    158[0m:[38;5;10m[49m fn both_programs_are_runnable() {
[0m[49m[38;5;10m+    159[0m:[38;5;10m[49m     assert!(c_binary().is_file(), "C binary not built");
[0m[49m[38;5;10m+    160[0m:[38;5;10m[49m     assert!(rust_binary().is_file(), "Rust binary not built");
[0m[49m[38;5;10m+    161[0m:[38;5;10m[49m     let c = run(c_binary(), b"1\n");
[0m[49m[38;5;10m+    162[0m:[38;5;10m[49m     assert_eq!(c.stdout, b"0000803f\n");
[0m[49m[38;5;10m+    163[0m:[38;5;10m[49m     assert_eq!(c.status.code(), Some(0));
[0m[49m[38;5;10m+    164[0m:[38;5;10m[49m     assert_identical(b"1\n");
[0m[49m[38;5;10m+    165[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    166[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    167[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    168[0m:[38;5;10m[49m // Phase B: the input classes the C program branches on
[0m[49m[38;5;10m+    169[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    170[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    171[0m:[38;5;10m[49m /// `scanf` returns EOF and never touches `x`, so `driver` prints the initial
[0m[49m[38;5;10m+    172[0m:[38;5;10m[49m /// `0.0f`. This is the "empty input" class.
[0m[49m[38;5;10m+    173[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    174[0m:[38;5;10m[49m fn empty_and_whitespace_only_input() {
[0m[49m[38;5;10m+    175[0m:[38;5;10m[49m     check_all([
[0m[49m[38;5;10m+    176[0m:[38;5;10m[49m         &b""[..],
[0m[49m[38;5;10m+    177[0m:[38;5;10m[49m         b"\n",
[0m[49m[38;5;10m+    178[0m:[38;5;10m[49m         b"\n\n\n",
[0m[49m[38;5;10m+    179[0m:[38;5;10m[49m         b" ",
[0m[49m[38;5;10m+    180[0m:[38;5;10m[49m         b"\t",
[0m[49m[38;5;10m+    181[0m:[38;5;10m[49m         b"\r",
[0m[49m[38;5;10m+    182[0m:[38;5;10m[49m         b"\x0b",
[0m[49m[38;5;10m+    183[0m:[38;5;10m[49m         b"\x0c",
[0m[49m[38;5;10m+    184[0m:[38;5;10m[49m         b"\t\r\x0b\x0c\n   ",
[0m[49m[38;5;10m+    185[0m:[38;5;10m[49m         b"                                        ",
[0m[49m[38;5;10m+    186[0m:[38;5;10m[49m     ]);
[0m[49m[38;5;10m+    187[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    188[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    189[0m:[38;5;10m[49m /// `scanf`'s whitespace skip crosses newlines, and only the first conversion
[0m[49m[38;5;10m+    190[0m:[38;5;10m[49m /// happens: trailing lines are never read.
[0m[49m[38;5;10m+    191[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    192[0m:[38;5;10m[49m fn leading_whitespace_and_trailing_input_are_ignored() {
[0m[49m[38;5;10m+    193[0m:[38;5;10m[49m     check_all([
[0m[49m[38;5;10m+    194[0m:[38;5;10m[49m         &b"   42"[..],
[0m[49m[38;5;10m+    195[0m:[38;5;10m[49m         b"\t42",
[0m[49m[38;5;10m+    196[0m:[38;5;10m[49m         b"\n\n42\n\n",
[0m[49m[38;5;10m+    197[0m:[38;5;10m[49m         b"  \n\t\n  1.5",
[0m[49m[38;5;10m+    198[0m:[38;5;10m[49m         b"1\n2\n",
[0m[49m[38;5;10m+    199[0m:[38;5;10m[49m         b"  \r\n-3.5e2extra",
[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m         b"7 garbage that is never read",
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m         b"7\n8\n9\n10\n",
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m         b"0.5\0trailing-nul",
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m     ]);
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m /// Signed zeros: the sign is applied even when the significand is zero, so the
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m /// object representation differs from `+0.0f`.
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m fn signed_zeros() {
[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m     check_all(with_all_prefixes(&[
[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m         "0", "00", "0.", ".0", "0.0", "0e0", "0e999", "0e-999", "0.000", "0x0", "0x0.", "0x.0",
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m         "0x0p0", "0x0p9999", "000000000000000000000",
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m     ]));
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    216[0m:[38;5;10m[49m /// A matching failure leaves `x` at its initialized `0.0f`. Each of these is a
[0m[49m[38;5;10m+    217[0m:[38;5;10m[49m /// distinct reason the conversion cannot start or cannot complete.
[0m[49m[38;5;10m+    218[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    219[0m:[38;5;10m[49m fn matching_failures_leave_the_initial_value() {
[0m[49m[38;5;10m+    220[0m:[38;5;10m[49m     check_all(with_all_prefixes(&[
[0m[49m[38;5;10m+    221[0m:[38;5;10m[49m         "", "abc", "xyz", ".", ".e5", "e", "e5", "E", "x", "X", "p1", "-", "+", "--1", "+-1",
[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m         "$", "\u{7f}", "/", ":", "@", "`", "z", "i", "in", "n", "na", "inf ", // handled below too
[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m     ]));
[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m     // A bare sign or a lone dot, with nothing that can follow it.
[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m     check_all([&b"-"[..], b"+", b".", b"-.", b"+.", b"-.e", b"-e", b"- 1", b"+ 1"]);
