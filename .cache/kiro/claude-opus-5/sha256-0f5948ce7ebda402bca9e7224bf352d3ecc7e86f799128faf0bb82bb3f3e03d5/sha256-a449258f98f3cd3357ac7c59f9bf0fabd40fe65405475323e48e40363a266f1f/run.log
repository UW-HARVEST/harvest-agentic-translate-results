[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m /// The `0x` prefix has its own acceptance rule inside `vfscanf`, separate from
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m /// `strtof`'s: with neither a hex digit nor a `.` after the prefix the whole
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m /// conversion fails, so `x` keeps `+0.0f` even though a `-` was read.
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m fn hex_prefix_without_digits() {
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m     check_all(with_all_prefixes(&[
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m         // no hex digit and no '.' -> matching failure
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m         "0x", "0X", "0xg", "0xz9", "0xp", "0xp1", "0xP-3", "0x+1", "0x 1", "0xx", "0Xt",
[0m[49m[38;5;10m+    236[0m:[38;5;10m[49m         // a '.' is collected -> conversion succeeds, converting only the leading '0'
[0m[49m[38;5;10m+    237[0m:[38;5;10m[49m         "0x.", "0X.", "0x..", "0x.x", "0x.p", "0x.p1", "0x.g", "0x.e5",
[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m     ]));
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m     check_all([&b"-0x\n1"[..], b"-0x\t1", b"-0X"]);
[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m 
