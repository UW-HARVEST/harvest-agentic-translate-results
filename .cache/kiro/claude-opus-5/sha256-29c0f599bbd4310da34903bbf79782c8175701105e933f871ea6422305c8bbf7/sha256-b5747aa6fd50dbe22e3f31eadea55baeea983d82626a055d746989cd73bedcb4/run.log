#include <stdio.h>
#include <stdlib.h>
#include "match.h"
int main(void){
    int bins;
    double threshold;
    for (int trial=0; trial<8; trial++){
        bins = 1 + trial*7;
        threshold = 0.1*trial;
        double *t = malloc(sizeof(double)*bins), *r = malloc(sizeof(double)*bins);
        for(int i=0;i<bins;i++){ t[i] = (i*i%17)+0.5; r[i] = ((i*3)%11)+1.25; }
        printf("bins=%d thr=%.17g -> match=%d\n", bins, threshold, match(t,r,bins,threshold));
        free(t); free(r);
    }
    /* direct spectral_contrast probe: pass double buffer as declared (double*) */
    {
        int n = 8;
        double *a = malloc(sizeof(double)*n), *b = malloc(sizeof(double)*n);
        for(int i=0;i<n;i++){a[i]=i+1.0;b[i]=(n-i)*0.5;}
        double sc = spectral_contrast(a,b,n);
        printf("sc=%.17g\n", sc);
        for(int i=0;i<n;i++) printf("  a[%d]=%.17g b[%d]=%.17g\n", i, a[i], i, b[i]);
    }
    return 0;
}
