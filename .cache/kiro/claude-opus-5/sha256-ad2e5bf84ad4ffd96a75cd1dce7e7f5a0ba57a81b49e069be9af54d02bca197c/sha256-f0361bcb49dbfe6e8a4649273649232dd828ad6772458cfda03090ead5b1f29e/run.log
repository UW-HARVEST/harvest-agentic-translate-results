[0m[49m[38;5;10m+    266[0m:[38;5;10m[49m         let t = [rng.finite_f32(), rng.finite_f32(), subnormal(&mut rng)];
[0m[49m[38;5;10m+    267[0m:[38;5;10m[49m         diff_disjoint(&t, 1, 2, &format!("row12 mixed subnormal dxy [iter {it}]"));
[0m[49m[38;5;10m+    268[0m:[38;5;10m[49m         let t = [subnormal(&mut rng), subnormal(&mut rng), rng.finite_f32()];
[0m[49m[38;5;10m+    269[0m:[38;5;10m[49m         diff_disjoint(&t, 1, 2, &format!("row12 mixed subnormal arm [iter {it}]"));
[0m[49m[38;5;10m+    270[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    271[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    272[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    273[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    274[0m:[38;5;10m[49m // Row 13 — infinities in every position
[0m[49m[38;5;10m+    275[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    276[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    277[0m:[38;5;10m[49m fn cfg_row13_infinities() {
[0m[49m[38;5;10m+    278[0m:[38;5;10m[49m     let vals = [
[0m[49m[38;5;10m+    279[0m:[38;5;10m[49m         f32::INFINITY,
[0m[49m[38;5;10m+    280[0m:[38;5;10m[49m         f32::NEG_INFINITY,
[0m[49m[38;5;10m+    281[0m:[38;5;10m[49m         0.0f32,
[0m[49m[38;5;10m+    282[0m:[38;5;10m[49m         -0.0f32,
[0m[49m[38;5;10m+    283[0m:[38;5;10m[49m         1.0f32,
[0m[49m[38;5;10m+    284[0m:[38;5;10m[49m         -1.0f32,
[0m[49m[38;5;10m+    285[0m:[38;5;10m[49m         f32::MAX,
[0m[49m[38;5;10m+    286[0m:[38;5;10m[49m         f32::MIN,
[0m[49m[38;5;10m+    287[0m:[38;5;10m[49m         f32::MIN_POSITIVE,
[0m[49m[38;5;10m+    288[0m:[38;5;10m[49m         f32::from_bits(1),
[0m[49m[38;5;10m+    289[0m:[38;5;10m[49m     ];
[0m[49m[38;5;10m+    290[0m:[38;5;10m[49m     // Exhaustive 10^3 cross product — this is the full A4 grid for the
[0m[49m[38;5;10m+    291[0m:[38;5;10m[49m     // interesting classes, so no randomization is needed here.
[0m[49m[38;5;10m+    292[0m:[38;5;10m[49m     for &a in &vals {
[0m[49m[38;5;10m+    293[0m:[38;5;10m[49m         for &b in &vals {
[0m[49m[38;5;10m+    294[0m:[38;5;10m[49m             for &c in &vals {
[0m[49m[38;5;10m+    295[0m:[38;5;10m[49m                 diff_disjoint(&[a, b, c], 1, 2, "row13 inf/zero grid");
[0m[49m[38;5;10m+    296[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    297[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    298[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    299[0m:[38;5;10m[49m     // And as a multi-element run so the strides are exercised too.
[0m[49m[38;5;10m+    300[0m:[38;5;10m[49m     let mut src = Vec::new();
[0m[49m[38;5;10m+    301[0m:[38;5;10m[49m     for &a in &vals {
[0m[49m[38;5;10m+    302[0m:[38;5;10m[49m         for &b in &vals {
[0m[49m[38;5;10m+    303[0m:[38;5;10m[49m             src.extend_from_slice(&[a, b, f32::INFINITY]);
[0m[49m[38;5;10m+    304[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    305[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    306[0m:[38;5;10m[49m     let count = (src.len() / 3) as i32;
[0m[49m[38;5;10m+    307[0m:[38;5;10m[49m     diff_disjoint(&src, count, count as usize * 2, "row13 inf run");
[0m[49m[38;5;10m+    308[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    309[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    310[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    311[0m:[38;5;10m[49m // Row 14 — fully aliased dest == src
[0m[49m[38;5;10m+    312[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    313[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    314[0m:[38;5;10m[49m fn cfg_row14_aliased_in_place() {
[0m[49m[38;5;10m+    315[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 14);
[0m[49m[38;5;10m+    316[0m:[38;5;10m[49m     for it in 0..20_000 {
[0m[49m[38;5;10m+    317[0m:[38;5;10m[49m         let count = (rng.below(32) + 1) as i32;
[0m[49m[38;5;10m+    318[0m:[38;5;10m[49m         // Backing store must cover both the 3*count reads and 2*count writes.
[0m[49m[38;5;10m+    319[0m:[38;5;10m[49m         let n = count as usize * 3 + 8;
[0m[49m[38;5;10m+    320[0m:[38;5;10m[49m         let buf: Vec<f32> = (0..n)
[0m[49m[38;5;10m+    321[0m:[38;5;10m[49m             .map(|_| if it % 4 == 0 { rng.special_f32() } else { rng.finite_f32() })
[0m[49m[38;5;10m+    322[0m:[38;5;10m[49m             .collect();
[0m[49m[38;5;10m+    323[0m:[38;5;10m[49m         diff_aliased(&buf, 0, 0, count, &format!("row14 dest==src [iter {it}]"));
[0m[49m[38;5;10m+    324[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    325[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    326[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    327[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
