[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m         let mut c_dest = [0.0f32; 2];
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m         unsafe { (c_tfm())(c_dest.as_mut_ptr(), t.as_ptr(), 1) };
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m         assert_eq!(
