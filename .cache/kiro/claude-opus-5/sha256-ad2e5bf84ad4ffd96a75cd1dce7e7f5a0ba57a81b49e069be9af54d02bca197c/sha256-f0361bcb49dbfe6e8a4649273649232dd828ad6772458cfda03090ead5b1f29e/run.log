[0m[49m[38;5;10m+    186[0m:[38;5;10m[49m fn err_row7_equal_operands_take_else_arm() {
[0m[49m[38;5;10m+    187[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 107);
