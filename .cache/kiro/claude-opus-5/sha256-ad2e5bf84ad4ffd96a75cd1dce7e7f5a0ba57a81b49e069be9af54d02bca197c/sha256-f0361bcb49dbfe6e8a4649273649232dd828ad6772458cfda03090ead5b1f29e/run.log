[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m // Row 9 — sqd is NaN: unordered compare, NOT clamped, reaches sqrtf
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m fn err_row9_nan_sqd_not_clamped() {
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m     let inf = f32::INFINITY;
[0m[49m[38;5;10m+    259[0m:[38;5;10m[49m     // dx2 == dy2 == inf -> inf*inf - inf + inf = NaN.
[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m     let cases: [[f32; 3]; 8] = [
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m         [inf, inf, 0.0],
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m         [inf, inf, 1.0],
[0m[49m[38;5;10m+    263[0m:[38;5;10m[49m         [-inf, -inf, 0.0],
