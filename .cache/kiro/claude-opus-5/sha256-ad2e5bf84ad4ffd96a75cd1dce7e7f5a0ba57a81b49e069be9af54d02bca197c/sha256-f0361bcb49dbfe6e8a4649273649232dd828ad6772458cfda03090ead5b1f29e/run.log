[0m[49m[38;5;10m+    115[0m:[38;5;10m[49m             let src = [core[0], core[1], core[2], *trap, *trap, *trap];
[0m[49m[38;5;10m+    116[0m:[38;5;10m[49m             let mut c_dest = [f32::from_bits(0xA5A5_A5A5); 2];
