[0m[49m[38;5;10m+    156[0m:[38;5;10m[49m         // Perturb by a few ULPs so dy2*dy2 - 2*dx2*dy2 + dx2*dx2 cancels badly.
[0m[49m[38;5;10m+    157[0m:[38;5;10m[49m         let ulps = rng.below(5) as i32 - 2;
[0m[49m[38;5;10m+    158[0m:[38;5;10m[49m         let other = f32::from_bits((base.to_bits() as i32).wrapping_add(ulps) as u32);
[0m[49m[38;5;10m+    159[0m:[38;5;10m[49m         let dxy = f32::from_bits(rng.below(0x0080_0000)); // subnormal-ish, tiny
[0m[49m[38;5;10m+    160[0m:[38;5;10m[49m         let (a, b) = if it % 2 == 0 { (base, other) } else { (other, base) };
[0m[49m[38;5;10m+    161[0m:[38;5;10m[49m         // Track whether the clamp actually engaged (computed the same way as C).
[0m[49m[38;5;10m+    162[0m:[38;5;10m[49m         let (dx2, dy2) = if a < b { (a, b) } else { (b, a) };
[0m[49m[38;5;10m+    163[0m:[38;5;10m[49m         let sqd = (dy2 * dy2) - (2.0f32 * dx2 * dy2) + (dx2 * dx2) + (4.0f32 * dxy * dxy);
[0m[49m[38;5;10m+    164[0m:[38;5;10m[49m         if sqd < 0.0 {
[0m[49m[38;5;10m+    165[0m:[38;5;10m[49m             hit += 1;
[0m[49m[38;5;10m+    166[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    167[0m:[38;5;10m[49m         diff_disjoint(&[a, b, dxy], 1, 2, &format!("row08 clamp [iter {it}]"));
[0m[49m[38;5;10m+    168[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    169[0m:[38;5;10m[49m     assert!(hit > 0, "row08 never produced a negative sqd; test is not exercising the clamp");
[0m[49m[38;5;10m+    170[0m:[38;5;10m[49m     eprintln!("row08: clamp engaged on {hit} / 30000 inputs");
[0m[49m[38;5;10m+    171[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    172[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    173[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    174[0m:[38;5;10m[49m // Row 9 — sqd huge / near overflow, clamp passes through
[0m[49m[38;5;10m+    175[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    176[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    177[0m:[38;5;10m[49m fn cfg_row09_sqd_huge() {
[0m[49m[38;5;10m+    178[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 9);
[0m[49m[38;5;10m+    179[0m:[38;5;10m[49m     for it in 0..20_000 {
[0m[49m[38;5;10m+    180[0m:[38;5;10m[49m         // Exponent near the top so squaring overflows to +inf.
[0m[49m[38;5;10m+    181[0m:[38;5;10m[49m         let big = |rng: &mut Rng| {
[0m[49m[38;5;10m+    182[0m:[38;5;10m[49m             let exp = rng.below(20) + 235; // biased exponent 235..254
[0m[49m[38;5;10m+    183[0m:[38;5;10m[49m             let mant = rng.next_u32() & 0x007F_FFFF;
[0m[49m[38;5;10m+    184[0m:[38;5;10m[49m             let sign = (rng.next_u32() & 1) << 31;
[0m[49m[38;5;10m+    185[0m:[38;5;10m[49m             f32::from_bits(sign | (exp << 23) | mant)
[0m[49m[38;5;10m+    186[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+    187[0m:[38;5;10m[49m         let a = big(&mut rng);
[0m[49m[38;5;10m+    188[0m:[38;5;10m[49m         let b = big(&mut rng);
[0m[49m[38;5;10m+    189[0m:[38;5;10m[49m         let dxy = if it % 3 == 0 { rng.finite_f32() } else { big(&mut rng) };
[0m[49m[38;5;10m+    190[0m:[38;5;10m[49m         diff_disjoint(&[a, b, dxy], 1, 2, &format!("row09 huge sqd [iter {it}]"));
[0m[49m[38;5;10m+    191[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    192[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    193[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    194[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    195[0m:[38;5;10m[49m // Row 10 — sqd is NaN (unordered), so the clamp does NOT fire
[0m[49m[38;5;10m+    196[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    197[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    198[0m:[38;5;10m[49m fn cfg_row10_sqd_nan() {
[0m[49m[38;5;10m+    199[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 10);
[0m[49m[38;5;10m+    200[0m:[38;5;10m[49m     let inf = f32::INFINITY;
[0m[49m[38;5;10m+    201[0m:[38;5;10m[49m     let ninf = f32::NEG_INFINITY;
[0m[49m[38;5;10m+    202[0m:[38;5;10m[49m     // inf - inf inside the discriminant, from finite inputs whose products
[0m[49m[38;5;10m+    203[0m:[38;5;10m[49m     // overflow, and from literal infinities.
[0m[49m[38;5;10m+    204[0m:[38;5;10m[49m     for a in [inf, ninf, f32::MAX, f32::MIN] {
[0m[49m[38;5;10m+    205[0m:[38;5;10m[49m         for b in [inf, ninf, f32::MAX, f32::MIN] {
[0m[49m[38;5;10m+    206[0m:[38;5;10m[49m             for dxy in [inf, ninf, f32::MAX, f32::MIN, 0.0, -0.0, 1.0] {
[0m[49m[38;5;10m+    207[0m:[38;5;10m[49m                 diff_disjoint(&[a, b, dxy], 1, 2, "row10 inf-cancellation");
[0m[49m[38;5;10m+    208[0m:[38;5;10m[49m             }
[0m[49m[38;5;10m+    209[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    210[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    211[0m:[38;5;10m[49m     for it in 0..20_000 {
[0m[49m[38;5;10m+    212[0m:[38;5;10m[49m         let pick = |rng: &mut Rng| match rng.below(4) {
[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m             0 => f32::INFINITY,
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m             1 => f32::NEG_INFINITY,
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m             2 => f32::MAX,
[0m[49m[38;5;10m+    216[0m:[38;5;10m[49m             _ => f32::MIN,
[0m[49m[38;5;10m+    217[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+    218[0m:[38;5;10m[49m         let a = pick(&mut rng);
[0m[49m[38;5;10m+    219[0m:[38;5;10m[49m         let b = pick(&mut rng);
[0m[49m[38;5;10m+    220[0m:[38;5;10m[49m         let dxy = pick(&mut rng);
[0m[49m[38;5;10m+    221[0m:[38;5;10m[49m         diff_disjoint(&[a, b, dxy], 1, 2, &format!("row10 nan sqd [iter {it}]"));
[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m // Row 11 — exactly one NaN lane, random payload/sign
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m fn cfg_row11_single_nan_lane() {
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 11);
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m     for it in 0..30_000 {
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m         let lane = (it % 3) as usize;
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m         let mut t = [rng.finite_f32(), rng.finite_f32(), rng.finite_f32()];
[0m[49m[38;5;10m+    234[0m:[38;5;10m[49m         t[lane] = rng.nan_f32();
[0m[49m[38;5;10m+    235[0m:[38;5;10m[49m         diff_disjoint(&t, 1, 2, &format!("row11 NaN in lane {lane} [iter {it}]"));
[0m[49m[38;5;10m+    236[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    237[0m:[38;5;10m[49m     // Also both-arm coverage with a NaN dxy only (the arm predicate stays
[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m     // ordered, so the then arm is reachable with a NaN discriminant term).
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m     for it in 0..10_000 {
[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m         let mut t = then_arm_triple(&mut rng);
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m         t[2] = rng.nan_f32();
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m         diff_disjoint(&t, 1, 2, &format!("row11 then-arm NaN dxy [iter {it}]"));
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m         let mut t = else_arm_triple(&mut rng);
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m         t[2] = rng.nan_f32();
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m         diff_disjoint(&t, 1, 2, &format!("row11 else-arm NaN dxy [iter {it}]"));
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m // Row 12 — subnormal lanes
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    252[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    253[0m:[38;5;10m[49m fn cfg_row12_subnormals() {
[0m[49m[38;5;10m+    254[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 12);
[0m[49m[38;5;10m+    255[0m:[38;5;10m[49m     let subnormal = |rng: &mut Rng| {
[0m[49m[38;5;10m+    256[0m:[38;5;10m[49m         let sign = (rng.next_u32() & 1) << 31;
[0m[49m[38;5;10m+    257[0m:[38;5;10m[49m         let mant = rng.below(0x0080_0000); // 0..2^23-1, exponent field zero
[0m[49m[38;5;10m+    258[0m:[38;5;10m[49m         f32::from_bits(sign | mant)
[0m[49m[38;5;10m+    259[0m:[38;5;10m[49m     };
[0m[49m[38;5;10m+    260[0m:[38;5;10m[49m     for it in 0..30_000 {
[0m[49m[38;5;10m+    261[0m:[38;5;10m[49m         let t = [subnormal(&mut rng), subnormal(&mut rng), subnormal(&mut rng)];
[0m[49m[38;5;10m+    262[0m:[38;5;10m[49m         diff_disjoint(&t, 1, 2, &format!("row12 subnormals [iter {it}]"));
[0m[49m[38;5;10m+    263[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    264[0m:[38;5;10m[49m     // Mixed: subnormal discriminant term with normal arm operands.
