[0m[49m[38;5;10m+    213[0m:[38;5;10m[49m // Row 8 — sqd < 0 is clamped to 0.0f before sqrtf (no EDOM)
[0m[49m[38;5;10m+    214[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    215[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    216[0m:[38;5;10m[49m fn err_row8_negative_sqd_clamped_to_zero() {
[0m[49m[38;5;10m+    217[0m:[38;5;10m[49m     let mut rng = Rng::new(SEED ^ 108);
[0m[49m[38;5;10m+    218[0m:[38;5;10m[49m     let mut hits = 0usize;
[0m[49m[38;5;10m+    219[0m:[38;5;10m[49m     for it in 0..40_000 {
[0m[49m[38;5;10m+    220[0m:[38;5;10m[49m         let base = match it % 3 {
[0m[49m[38;5;10m+    221[0m:[38;5;10m[49m             0 => rng.finite_f32(),
[0m[49m[38;5;10m+    222[0m:[38;5;10m[49m             1 => f32::from_bits(0x7F00_0000 | (rng.next_u32() & 0x007F_FFFF)),
[0m[49m[38;5;10m+    223[0m:[38;5;10m[49m             _ => rng.small_f32(),
[0m[49m[38;5;10m+    224[0m:[38;5;10m[49m         };
[0m[49m[38;5;10m+    225[0m:[38;5;10m[49m         let ulps = rng.below(9) as i32 - 4;
[0m[49m[38;5;10m+    226[0m:[38;5;10m[49m         let other = f32::from_bits((base.to_bits() as i32).wrapping_add(ulps) as u32);
[0m[49m[38;5;10m+    227[0m:[38;5;10m[49m         // Tiny dxy so 4*dxy^2 cannot rescue the cancelled square.
[0m[49m[38;5;10m+    228[0m:[38;5;10m[49m         let dxy = f32::from_bits(rng.below(0x0040_0000));
[0m[49m[38;5;10m+    229[0m:[38;5;10m[49m         let (a, b) = if it % 2 == 0 { (base, other) } else { (other, base) };
[0m[49m[38;5;10m+    230[0m:[38;5;10m[49m         let (dx2, dy2) = if a < b { (a, b) } else { (b, a) };
[0m[49m[38;5;10m+    231[0m:[38;5;10m[49m         let sqd = (dy2 * dy2) - (2.0f32 * dx2 * dy2) + (dx2 * dx2) + (4.0f32 * dxy * dxy);
[0m[49m[38;5;10m+    232[0m:[38;5;10m[49m         if sqd < 0.0 {
[0m[49m[38;5;10m+    233[0m:[38;5;10m[49m             hits += 1;
