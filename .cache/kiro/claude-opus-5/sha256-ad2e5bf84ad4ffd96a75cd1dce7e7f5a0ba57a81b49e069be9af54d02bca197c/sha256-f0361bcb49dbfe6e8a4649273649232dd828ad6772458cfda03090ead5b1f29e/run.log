[0m[49m[38;5;10m+    107[0m:[38;5;10m[49m         diff_disjoint(&src, 1, 2, &format!("row4 exact extent [iter {it}]"));
[0m[49m[38;5;10m+    108[0m:[38;5;10m[49m     }
