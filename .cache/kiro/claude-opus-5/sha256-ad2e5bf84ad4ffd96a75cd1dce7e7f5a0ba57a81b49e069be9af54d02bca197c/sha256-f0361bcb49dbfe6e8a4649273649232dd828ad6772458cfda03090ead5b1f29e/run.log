run_sabotage() {
  name="$1"
  echo "===== SABOTAGE: $name ====="
  cargo build --release 2>&1 | grep -E '^error' | head -5
  timeout 600 cargo test --release 2>&1 | grep -E '^test (cfg|err)_|test result' | grep -E 'FAILED|failed|result' | head -5
  cp /tmp/lib.rs.orig src/lib.rs
}

# S1: reassociate 2.0f*dx2*dy2  ->  dx2*(2.0f*dy2)   (rounding-visible on normals)
sed -i 's|acc = subss(acc, mulss(two_dx2, dy2));|acc = subss(acc, mulss(dx2, addss(dy2, dy2)));|' src/lib.rs
run_sabotage "reassociate 2*dx2*dy2"

# S2: reverse the final accumulate operand roles (NaN-payload-visible only)
sed -i 's|let sqd = addss(mulss(mulss(4.0f32, dxy), dxy), acc);|let sqd = addss(acc, mulss(mulss(4.0f32, dxy), dxy));|' src/lib.rs
run_sabotage "reverse final addss operands"

# S3: clamp NaN away (wrong: C leaves NaN unclamped)
sed -i 's|let clamped = if 0.0f32 > sqd { 0.0f32 } else { sqd };|let clamped = if !(sqd >= 0.0f32) { 0.0f32 } else { sqd };|' src/lib.rs
run_sabotage "clamp NaN discriminant to zero"

# S4: drop the SSE NaN modelling entirely (naive port)
sed -i 's|^    if dest.is_nan() {$|    if false {|' src/lib.rs
run_sabotage "naive port, no SSE NaN operand modelling"

echo "===== restored ====="; diff -q src/lib.rs /tmp/lib.rs.orig && echo "lib.rs identical to original"[0m[38;5;244m (using tool: shell)[0m
