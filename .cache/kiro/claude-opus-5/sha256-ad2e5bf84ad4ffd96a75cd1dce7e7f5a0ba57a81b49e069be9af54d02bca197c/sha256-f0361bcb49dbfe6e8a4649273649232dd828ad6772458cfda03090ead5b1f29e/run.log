[0m[49m[38;5;10m+    238[0m:[38;5;10m[49m             let expect = if a < b { [dx2 - lambda, dxy] } else { [dxy, dx2 - lambda] };
[0m[49m[38;5;10m+    239[0m:[38;5;10m[49m             let mut c_dest = [0.0f32; 2];
[0m[49m[38;5;10m+    240[0m:[38;5;10m[49m             unsafe { (c_tfm())(c_dest.as_mut_ptr(), [a, b, dxy].as_ptr(), 1) };
[0m[49m[38;5;10m+    241[0m:[38;5;10m[49m             assert_eq!(
[0m[49m[38;5;10m+    242[0m:[38;5;10m[49m                 c_dest.map(f32::to_bits),
[0m[49m[38;5;10m+    243[0m:[38;5;10m[49m                 expect.map(f32::to_bits),
[0m[49m[38;5;10m+    244[0m:[38;5;10m[49m                 "row8: C did not clamp negative sqd to 0 (sqd={sqd:e}, a={a:e}, b={b:e}, dxy={dxy:e})"
[0m[49m[38;5;10m+    245[0m:[38;5;10m[49m             );
[0m[49m[38;5;10m+    246[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    247[0m:[38;5;10m[49m         diff_disjoint(&[a, b, dxy], 1, 2, &format!("row8 clamp [iter {it}]"));
[0m[49m[38;5;10m+    248[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    249[0m:[38;5;10m[49m     assert!(hits > 0, "row8: never produced sqd < 0, the clamp branch was not reached");
[0m[49m[38;5;10m+    250[0m:[38;5;10m[49m     eprintln!("row8: negative-sqd clamp reached {hits} times");
[0m[49m[38;5;10m+    251[0m:[38;5;10m[49m }
