static float rf(int mode){
  switch(mode){
  case 0:{ uint32_t b=rnd(); float f; memcpy(&f,&b,4); return f; }
  case 1: return (float)((int32_t)rnd()%2001)/100.0f;
  case 2:{ static const float sp[]={0.0f,-0.0f,1.0f,-1.0f,0.5f,3.0f,1e-38f,1e38f,INFINITY,-INFINITY,NAN,16777216.0f,-16777216.0f};
           return sp[rnd()%(sizeof(sp)/sizeof(sp[0]))]; }
  case 3: return (float)((int32_t)rnd()%7);
  default:{ /* finite, non-NaN arbitrary bit patterns */
