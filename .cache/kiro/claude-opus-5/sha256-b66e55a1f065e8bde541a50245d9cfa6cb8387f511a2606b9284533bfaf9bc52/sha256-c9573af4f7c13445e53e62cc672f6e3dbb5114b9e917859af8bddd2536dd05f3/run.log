[0m[49m[38;5;10m+    146[0m:[38;5;10m[49m             inputs.push([h, sat(&mut rng), rng.range(0.0, 1.0)]);
[0m[49m[38;5;10m+    147[0m:[38;5;10m[49m         }
[0m[49m[38;5;10m+    148[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    149[0m:[38;5;10m[49m     assert_same_batch("CONFIGS row 12", inputs);
[0m[49m[38;5;10m+    150[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    151[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    152[0m:[38;5;10m[49m /// Smallest representable step up, handling `0.0` and sign changes.
[0m[49m[38;5;10m+    153[0m:[38;5;10m[49m fn next_up(x: f32) -> f32 {
[0m[49m[38;5;10m+    154[0m:[38;5;10m[49m     if x == 0.0 {
[0m[49m[38;5;10m+    155[0m:[38;5;10m[49m         return f32::from_bits(1);
[0m[49m[38;5;10m+    156[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    157[0m:[38;5;10m[49m     let b = x.to_bits();
[0m[49m[38;5;10m+    158[0m:[38;5;10m[49m     if x > 0.0 {
[0m[49m[38;5;10m+    159[0m:[38;5;10m[49m         f32::from_bits(b + 1)
[0m[49m[38;5;10m+    160[0m:[38;5;10m[49m     } else {
[0m[49m[38;5;10m+    161[0m:[38;5;10m[49m         f32::from_bits(b - 1)
[0m[49m[38;5;10m+    162[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    163[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    164[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    165[0m:[38;5;10m[49m /// Smallest representable step down.
[0m[49m[38;5;10m+    166[0m:[38;5;10m[49m fn next_down(x: f32) -> f32 {
