[0m[49m[38;5;10m+    127[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    128[0m:[38;5;10m[49m // Axis B — hue exactly on / adjacent to each threshold
[0m[49m[38;5;10m+    129[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    130[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    131[0m:[38;5;10m[49m /// Row 12: each of `{0,60,120,180,240,300,360}` exactly, plus both `nextafter`
[0m[49m[38;5;10m+    132[0m:[38;5;10m[49m /// neighbours, crossed with randomized `s` and `l`. `>=` is inclusive and `<`
[0m[49m[38;5;10m+    133[0m:[38;5;10m[49m /// exclusive, so a threshold belongs to the arm above it.
[0m[49m[38;5;10m+    134[0m:[38;5;10m[49m #[test]
[0m[49m[38;5;10m+    135[0m:[38;5;10m[49m fn cfg_row12_hue_threshold_boundaries() {
[0m[49m[38;5;10m+    136[0m:[38;5;10m[49m     let mut rng = Rng::new(12);
[0m[49m[38;5;10m+    137[0m:[38;5;10m[49m     let mut hues: Vec<f32> = Vec::new();
[0m[49m[38;5;10m+    138[0m:[38;5;10m[49m     for &t in THRESHOLDS {
[0m[49m[38;5;10m+    139[0m:[38;5;10m[49m         hues.push(t);
[0m[49m[38;5;10m+    140[0m:[38;5;10m[49m         hues.push(next_up(t));
[0m[49m[38;5;10m+    141[0m:[38;5;10m[49m         hues.push(next_down(t));
[0m[49m[38;5;10m+    142[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    143[0m:[38;5;10m[49m     let mut inputs = Vec::new();
[0m[49m[38;5;10m+    144[0m:[38;5;10m[49m     for h in hues {
