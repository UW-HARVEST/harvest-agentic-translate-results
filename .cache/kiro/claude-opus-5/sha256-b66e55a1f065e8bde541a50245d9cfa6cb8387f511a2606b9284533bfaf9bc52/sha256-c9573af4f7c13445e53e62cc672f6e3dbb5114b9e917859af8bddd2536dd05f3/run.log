     5	void hsl_to_rgb(float *dest, const float *src) {
     6	    float h = src[0];
     7	    float s = src[1];
     8	    float l = src[2];
     9	    float c, m, x;
    10	    if (s == 0) {
    11	        dest[0] = l;
    12	        dest[1] = l;
    13	        dest[2] = l;
    14	        return;
    15	    }
    16	    c = (1.0f - fabsf(2.0f * l - 1.0f)) * s;
    17	    m = 1.0f * (l - 0.5f * c);
    18	    x = c * (1.0f - fabsf(fmodf(h / 60.0f, 2) - 1.0f));
    19	    if (h >= 0.0f && h < 60.0f) {
    20	        dest[0] = c + m;
    21	        dest[1] = x + m;
    22	        dest[2] = m;
    23	    } else if (h >= 60.0f && h < 120.0f) {
    24	        dest[0] = x + m;
    25	        dest[1] = c + m;
    26	        dest[2] = m;
    27	    } else if (h < 120.0f && h < 180.0f) {
    28	        dest[0] = m;
    29	        dest[1] = c + m;
    30	        dest[2] = x + m;
    31	    } else if (h >= 180.0f && h < 240.0f) {
    32	        dest[0] = m;
    33	        dest[1] = x + m;
    34	        dest[2] = c + m;
    35	    } else if (h >= 240.0f && h < 300.0f) {
