[0m[49m[38;5;10m+    168[0m:[38;5;10m[49m         return f32::from_bits(1 | 0x8000_0000);
[0m[49m[38;5;10m+    169[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    170[0m:[38;5;10m[49m     let b = x.to_bits();
[0m[49m[38;5;10m+    171[0m:[38;5;10m[49m     if x > 0.0 {
[0m[49m[38;5;10m+    172[0m:[38;5;10m[49m         f32::from_bits(b - 1)
[0m[49m[38;5;10m+    173[0m:[38;5;10m[49m     } else {
[0m[49m[38;5;10m+    174[0m:[38;5;10m[49m         f32::from_bits(b + 1)
[0m[49m[38;5;10m+    175[0m:[38;5;10m[49m     }
[0m[49m[38;5;10m+    176[0m:[38;5;10m[49m }
[0m[49m[38;5;10m+    177[0m:[38;5;10m[49m 
[0m[49m[38;5;10m+    178[0m:[38;5;10m[49m // ---------------------------------------------------------------------------
[0m[49m[38;5;10m+    179[0m:[38;5;10m[49m // Axis L — lightness regimes
