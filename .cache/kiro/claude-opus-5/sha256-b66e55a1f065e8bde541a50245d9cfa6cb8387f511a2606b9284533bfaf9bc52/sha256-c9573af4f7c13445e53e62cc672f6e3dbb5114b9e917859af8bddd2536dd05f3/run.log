     1	//! Rust translation of the C library in `c_src/`.
     2	//!
     3	//! Public ABI (verified against `nm -D` on the C shared library):
     4	//!   * `hsl_to_rgb`
     5	//!
     6	//! Source: `c_src/src/lib.c`, `c_src/include/lib.h`. There are no namespace or
     7	//! renaming macros in the public header, so the linker symbol equals the source
     8	//! name.
     9	//!
    10	//! # Fidelity notes
    11	//!
    12	//! The original C is reproduced verbatim, bugs included:
    13	//!
    14	//! * The third arm of the hue cascade reads `h < 120.0f && h < 180.0f` instead
    15	//!   of `h >= 120.0f && h < 180.0f`. The two preceding arms already consume
    16	//!   `0 <= h < 120`, so this arm is only reachable for `h < 0`; hues in
    17	//!   `[120, 180)` therefore fall through to the final `else` and come out as
    18	//!   the flat grey `(m, m, m)`. This is preserved, not fixed.
    19	//! * The redundant `1.0f *` in `m = 1.0f * (l - 0.5f * c)` is an exact identity
    20	//!   for every `f32` bit pattern, and the C compiler elides it; it is dropped
    21	//!   here with no observable change.
    22	//! * `fmodf` maps onto Rust's `%` for `f32`, which is the same truncated
    23	//!   remainder and lowers to the same libm call.
    24	//! * A NaN hue makes every predicate in the cascade false, so control reaches
    25	//!   the final `else`, exactly as in C.
    26	//!
    27	//! ## Why the arithmetic goes through helper functions
    28	//!
    29	//! Naive `a - b` / `a * b` expressions are bit-identical to the C for every
    30	//! non-NaN input, but they are *not* bit-identical when both operands of an
    31	//! operation are NaN. On x86-64 a two-operand SSE instruction such as
    32	//! `subss dst, src` returns the *destination* operand's NaN (quieted) when both
    33	//! operands are NaN, so the result's sign bit and payload depend on which
    34	//! operand the compiler placed in the destination register. LLVM and GCC make
    35	//! different (equally legal) choices: LLVM rewrites `l - 0.5 * c` into
    36	//! `(-0.5) * c + l`, which flips the destination operand and hence the returned
    37	//! NaN.
    38	//!
    39	//! The `add`/`sub`/`mul`/`div` helpers below make that choice explicit instead
    40	//! of leaving it to the optimiser: the first argument is the SSE destination
    41	//! operand. Operand roles were read off the compiled C. For every input where
    42	//! at most one operand is NaN the helpers are plain IEEE arithmetic, so this
    43	//! costs nothing in fidelity elsewhere.
    44	
    45	#![allow(clippy::missing_safety_doc)]
    46	
    47	/// Quiet a NaN the way SSE does when it propagates an operand: set the quiet
    48	/// bit and leave the sign and the rest of the payload alone.
    49	#[inline(always)]
    50	fn quiet(x: f32) -> f32 {
    51	    f32::from_bits(x.to_bits() | 0x0040_0000)
    52	}
    53	
    54	/// `a + b` with `a` as the SSE destination operand.
    55	#[inline(always)]
    56	fn add(a: f32, b: f32) -> f32 {
    57	    if a.is_nan() {
    58	        quiet(a)
    59	    } else if b.is_nan() {
    60	        quiet(b)
    61	    } else {
    62	        a + b
    63	    }
    64	}
    65	
    66	/// `a - b` with `a` as the SSE destination operand.
    67	#[inline(always)]
    68	fn sub(a: f32, b: f32) -> f32 {
    69	    if a.is_nan() {
    70	        quiet(a)
    71	    } else if b.is_nan() {
    72	        quiet(b)
    73	    } else {
    74	        a - b
    75	    }
    76	}
    77	
    78	/// `a * b` with `a` as the SSE destination operand.
    79	#[inline(always)]
    80	fn mul(a: f32, b: f32) -> f32 {
    81	    if a.is_nan() {
    82	        quiet(a)
    83	    } else if b.is_nan() {
    84	        quiet(b)
    85	    } else {
    86	        a * b
    87	    }
    88	}
    89	
    90	/// `a / b` with `a` as the SSE destination operand.
    91	#[inline(always)]
    92	fn div(a: f32, b: f32) -> f32 {
    93	    if a.is_nan() {
    94	        quiet(a)
    95	    } else if b.is_nan() {
    96	        quiet(b)
    97	    } else {
    98	        a / b
    99	    }
   100	}
   101	
   102	/// `fabsf`: a pure bit operation (`andps`), so it never quiets a NaN.
   103	#[inline(always)]
   104	fn fabsf(x: f32) -> f32 {
   105	    f32::from_bits(x.to_bits() & 0x7fff_ffff)
   106	}
   107	
   108	/// `fmodf(a, b)`. Rust's `%` on `f32` is C's `fmodf`.
   109	#[inline(always)]
   110	fn fmodf(a: f32, b: f32) -> f32 {
   111	    a % b
   112	}
   113	
   114	/// Convert an HSL triple to an RGB triple.
   115	///
   116	/// `src` must point to at least 3 readable `f32` values (hue in degrees,
   117	/// saturation, lightness). `dest` must point to at least 3 writable `f32`
   118	/// values. Mirrors `void hsl_to_rgb(float *dest, const float *src)`.
   119	#[unsafe(no_mangle)]
   120	pub unsafe extern "C" fn hsl_to_rgb(dest: *mut f32, src: *const f32) {
   121	    let h: f32 = unsafe { *src.add(0) };
   122	    let s: f32 = unsafe { *src.add(1) };
   123	    let l: f32 = unsafe { *src.add(2) };
   124	
   125	    let c: f32;
   126	    let m: f32;
   127	    let x: f32;
   128	
   129	    if s == 0.0f32 {
   130	        unsafe {
   131	            *dest.add(0) = l;
   132	            *dest.add(1) = l;
   133	            *dest.add(2) = l;
   134	        }
   135	        return;
   136	    }
   137	
   138	    // c = (1.0f - fabsf(2.0f * l - 1.0f)) * s;
   139	    // `2.0f * l` is emitted as `l + l`.
   140	    c = mul(sub(1.0f32, fabsf(sub(add(l, l), 1.0f32))), s);
   141	
   142	    // m = 1.0f * (l - 0.5f * c);  (the `1.0f *` is an exact no-op)
   143	    m = sub(l, mul(c, 0.5f32));
   144	
   145	    // x = c * (1.0f - fabsf(fmodf(h / 60.0f, 2) - 1.0f));
   146	    // The literal `2` is an int converted to 2.0f for the fmodf call.
   147	    x = mul(sub(1.0f32, fabsf(sub(fmodf(div(h, 60.0f32), 2.0f32), 1.0f32))), c);
   148	
   149	    // Branch order and each individual predicate are kept exactly as in C.
   150	    let (r, g, b): (f32, f32, f32) = if h >= 0.0f32 && h < 60.0f32 {
   151	        (add(c, m), add(x, m), m)
   152	    } else if h >= 60.0f32 && h < 120.0f32 {
   153	        (add(x, m), add(c, m), m)
   154	    } else if h < 120.0f32 && h < 180.0f32 {
   155	        // NOTE: faithful copy of the original (buggy) predicate; the C says
   156	        // `h < 120.0f`, not `h >= 120.0f`.
   157	        (m, add(c, m), add(m, x))
   158	    } else if h >= 180.0f32 && h < 240.0f32 {
   159	        (m, add(x, m), add(m, c))
   160	    } else if h >= 240.0f32 && h < 300.0f32 {
   161	        (add(x, m), m, add(m, c))
   162	    } else if h >= 300.0f32 && h < 360.0f32 {
   163	        (add(c, m), m, add(m, x))
   164	    } else {
   165	        (m, m, m)
   166	    };
   167	
   168	    unsafe {
   169	        *dest.add(0) = r;
   170	        *dest.add(1) = g;
   171	        *dest.add(2) = b;
   172	    }
   173	}
