  r_out=$(printf '%s\n%s\n' "$s1" "$s2" | timeout 10 "$RUST_BIN" 2>&1)
  if [ "$c_out" != "$r_out" ]; then
    echo "MISMATCH for ('$s1', '$s2')"
    echo "  C:    '$c_out'"
    echo "  Rust: '$r_out'"
    all_pass=false
  else
    echo "OK: ('$s1', '$s2') => '$c_out'"
  fi
}

