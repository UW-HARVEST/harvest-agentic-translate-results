#include <dlfcn.h>
#include <stdio.h>
void (*driver_fn)(char);
int main() {
    void *h = dlopen("./c_src/build/libdriver.so", RTLD_NOW);
    if (!h) { fprintf(stderr, "C dlopen: %s\n", dlerror()); return 1; }
    driver_fn = dlsym(h, "driver");
    for (int i = 0; i < 128; i++) driver_fn((char)i);
    dlclose(h);
}
EOF
