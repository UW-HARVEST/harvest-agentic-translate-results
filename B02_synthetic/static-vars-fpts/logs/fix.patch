+/// Emulate C's fgets(buf, buf_size, stdin).
+/// Reads up to `buf_size - 1` bytes, stops at newline or EOF.
+/// Truncates at first null byte (C strlen semantics).
+fn fgets(stdin: &io::Stdin, buf_size: usize) -> Option<String> {
+    let mut result = Vec::new();
+    let mut byte = [0u8; 1];
+    let max = buf_size - 1;
+    loop {
+        match io::Read::read(&mut stdin.lock(), &mut byte) {
+            Ok(0) => break,   // EOF
+            Ok(_) => {
+                result.push(byte[0]);
+                if byte[0] == b'\n' || result.len() >= max {
+                    break;
+                }
+            }
+            Err(_) => break,
+        }
+    }
+    if result.is_empty() {
+        return None;
+    }
+    // Truncate at first null byte (C strlen semantics)
+    if let Some(pos) = result.iter().position(|&b| b == 0) {
+        result.truncate(pos);
+    }
+    Some(String::from_utf8_lossy(&result).into_owned())
+}
