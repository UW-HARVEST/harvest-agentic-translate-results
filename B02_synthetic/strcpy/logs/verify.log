# Test cases: operation flags input_len [bytes...] ref_len [bytes...]
# Helper to convert string to byte list
str_to_bytes() {
    local s="$1"
    local len=${#s}
    local total=$((len + 1))  # +1 for null terminator
    echo -n "$total"
    for (( i=0; i<len; i++ )); do
        printf " %d" "'${s:$i:1}"
    done
    echo " 0"  # null terminator
}

run_test() {
    local label="$1"
    local input="$2"
    local c_out=$(echo "$input" | timeout 10 "$C_BIN" 2>/dev/null)
    local r_out=$(echo "$input" | timeout 10 "$R_BIN" 2>/dev/null)
    local c_err=$(echo "$input" | timeout 10 "$C_BIN" 2>&1 >/dev/null)
    local r_err=$(echo "$input" | timeout 10 "$R_BIN" 2>&1 >/dev/null)
    if [ "$c_out" = "$r_out" ] && [ "$c_err" = "$r_err" ]; then
        echo "PASS [$label]: stdout='$c_out'"
    else
        echo "FAIL [$label]: C_stdout='$c_out' R_stdout='$r_out' C_stderr='$c_err' R_stderr='$r_err'"
    fi
}

