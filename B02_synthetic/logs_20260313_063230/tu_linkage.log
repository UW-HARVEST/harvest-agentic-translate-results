#include <stdio.h>
#include <stddef.h>

static int state_a = 0;

static int target(int code) {
    if (code < 0) return (state_a & 1) ? 6 : 5;
    state_a = state_a ^ (code<<1);
    int k = ((code >> 2) ^ state_a) & 7;
    switch (k) {
        case 0: return 0;
        case 1: return 2;
        case 2: return 4;
        case 3: return 1;
        case 4: return 3;
        case 5:;
        case 6: return 5;
        default: return 7;
    }
}

int process_a_stream(const int *xs, size_t n){
    size_t acc=0;
    for(size_t i=0;i<n;i++){
        int v=xs[i];
        for(int j=0;j<3;j++){
            int t=target(v+j);
            fprintf(stderr, "i=%zu v=%d j=%d v+j=%d t=%d state_a=%d acc_before=%zu", i, v, j, v+j, t, state_a, acc);
            if ((t&1)==0) { acc += t; fprintf(stderr, " acc_after=%zu (add)\n", acc); continue; }
            size_t shift = (size_t)(t<<j);
            acc ^= shift;
            fprintf(stderr, " t<<j=%d (size_t)=%zu acc_after=%zu (xor)\n", t<<j, shift, acc);
            if (t==5) { fprintf(stderr, "  break\n"); break; }
        }
    }
    fprintf(stderr, "final acc=%zu\n", acc);
    if (acc > 0x7fffffffLL) { fprintf(stderr, "clamping to 0x7fffffff\n"); acc = 0x7fffffffLL; }
    if (acc < -0x80000000LL) { fprintf(stderr, "clamping to -0x80000000\n"); acc = (size_t)-0x80000000LL; }
    fprintf(stderr, "return (int)%zu = %d\n", acc, (int)acc);
    return (int)acc;
}

int main() {
    int xs[] = {2, 1};
    int result = process_a_stream(xs, 2);
    printf("result = %d\n", result);
    return 0;
}
