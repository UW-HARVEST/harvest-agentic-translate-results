+/// Emulate C's fgets(buf, 256, stdin): read up to 255 bytes, stopping at (and including) '\n'.
+fn fgets_256(stdin: &mut dyn io::Read) -> Option<Vec<u8>> {
+    let mut buf = Vec::new();
+    let mut byte = [0u8; 1];
+    for _ in 0..255 {
+        match stdin.read(&mut byte) {
+            Ok(0) => break,
+            Ok(_) => {
+                buf.push(byte[0]);
+                if byte[0] == b'\n' {
+                    break;
+                }
+            }
+            Err(_) => break,
+        }
+    }
+    if buf.is_empty() {
+        None
+    } else {
+        Some(buf)
+    }
+}
+
+/// Emulate C's sscanf(buf, "%d", &choice): parse leading integer, skipping leading whitespace.
+fn sscanf_int(buf: &[u8]) -> Option<i32> {
+    let s = String::from_utf8_lossy(buf);
+    let s = s.trim_start();
+    if s.is_empty() {
+        return None;
+    }
+    let mut end = 0;
+    for (i, c) in s.char_indices() {
+        if i == 0 && (c == '+' || c == '-') {
+            end = i + c.len_utf8();
+            continue;
+        }
+        if c.is_ascii_digit() {
+            end = i + 1;
+        } else {
+            break;
+        }
+    }
+    if end == 0 {
+        return None;
+    }
+    let num_str = &s[..end];
+    if num_str == "+" || num_str == "-" {
+        return None;
+    }
+    // Parse as i64 then truncate to i32 to emulate C overflow wrapping
+    num_str.parse::<i64>().ok().map(|v| v as i32)
+}
