+
+// Mimic C fgets(buf, size, stdin): reads at most size-1 bytes,
+// stopping at newline or EOF. Remainder stays in stdin for next read.
+// Returns the string without the trailing newline, or None on EOF with no data.
+fn fgets_line(stdin: &io::Stdin, buf_size: usize) -> Option<String> {
+    let mut buf = Vec::with_capacity(buf_size);
+    let mut byte = [0u8; 1];
+    let mut stdin_lock = stdin.lock();
+    let max_chars = buf_size - 1;
+    let mut read_any = false;
+    for _ in 0..max_chars {
+        match stdin_lock.read(&mut byte) {
+            Ok(0) => break,
+            Ok(_) => {
+                read_any = true;
+                if byte[0] == b'\n' {
+                    break;
+                }
+                buf.push(byte[0]);
+            }
+            Err(_) => break,
+        }
+    }
+    if !read_any && buf.is_empty() {
+        return None;
     }
+    Some(String::from_utf8_lossy(&buf).to_string())
 }
 
