t,\n                r_out.to_bits()\n            );\n        }\n    }\n}\n\n#[test]\nfn random_sweep() {\n    // A deterministic pseudo-random sweep across many inputs.\n    let mut state: u64 = 0xC0FFEE_u64;\n    fn next(s: &mut u64) -> u64 {\n        *s = s.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);\n        *s\n    }\n    for _ in 0..2000 {\n        let bits = (next(&mut state) & 0xFFFF_FFFF) as u32;\n        let y = f32::from_bits(bits);\n        // Restrict to finite values to avoid NaN payload weirdness across runs.\n        if !y.is_finite() {\n            continue;\n        }\n        let e = (next(&mut state) % 250) as i32; // 0..=249\n        run_case(y, e);\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
