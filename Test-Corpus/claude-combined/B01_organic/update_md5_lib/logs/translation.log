fn test_update_md5_matches() {\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).unwrap();\n        let r_lib = Library::new(rust_lib_path()).unwrap();\n\n        let c_upd: Symbol<unsafe extern \"C\" fn(*mut Tflac, *const i32) -> u32> =\n            c_lib.get(b\"update_md5\").unwrap();\n        let r_upd: Symbol<unsafe extern \"C\" fn(*mut Tflac, *const i32) -> u32> =\n            r_lib.get(b\"update_md5\").unwrap();\n\n        // The C update_md5 advances samples by 8*sizeof(tflac_s32)=32 elements\n        // per iteration, and reads 8 elements ahead. Iterations: i=0..=4 (5 iters).\n        // So pointer reaches base + 4*32, then reads 0..=7 ahead. Total 4*32+8=136 samples.\n        let mut samples = vec![0i32; 4 * 32 + 8];\n        for (i, s) in samples.iter_mut().enumerate() {\n            // mix of positive and negative-ish signed ints\n            *s = (i as i32).wrapping_mul(0x01010101) ^ ((i as i32) << 7);\n        }\n\n        let mut c_t = Tflac {\n            md5_ctx: fresh_md5(),\n            cur_blocksize: 100,\n            channels: 2,\n        };\n        let mut r_t = Tflac {\n            md5_ctx: fresh_md5(),\n            cur_blocksize: 100,\n            channels: 2,\n        };\n\n        let c_ret = c_upd(&mut c_t as *mut Tflac, samples.as_ptr());\n        let r_ret = r_upd(&mut r_t as *mut Tflac, samples.as_ptr());\n\n        assert_eq!(c_ret, r_ret, \"return value mismatch\");\n        assert!(tflac_eq(&c_t, &r_t), \"tflac state mismatch after update_md5\");\n    }\n}\n\n#[test]\nfn test_update_md5_various_blocksizes() {\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).unwrap();\n        let r_lib = Library::new(rust_lib_path()).unwrap();\n\n        let c_upd: Symbol<unsafe extern \"C\" fn(*mut Tflac, *const i32) -> u32> =\n            c_lib.get(b\"update_md5\").unwrap();\n        let r_upd: Symbol<unsafe extern \"C\" fn(*mut Tflac, *const i32) -> u32> =\n            r_lib.get(b\"update_md5\").unwrap();\n\n        let mu