\" fn(*mut Tflac, *const i32) -> u32> =\n            c_lib.get(b\"update_md5\").unwrap();\n        let r_upd: Symbol<unsafe extern \"C\" fn(*mut Tflac, *const i32) -> u32> =\n            r_lib.get(b\"update_md5\").unwrap();\n\n        let mut samples = vec![0i32; 4 * 32 + 8];\n        for (i, s) in samples.iter_mut().enumerate() {\n            *s = (i as i32).wrapping_mul(2654435761u32 as i32);\n        }\n\n        for &(bs, ch) in &[(0u32, 1u32), (1, 1), (8, 1), (16, 2), (1024, 2), (4096, 8)] {\n            let mut c_t = Tflac {\n                md5_ctx: fresh_md5(),\n                cur_blocksize: bs,\n                channels: ch,\n            };\n            let mut r_t = Tflac {\n                md5_ctx: fresh_md5(),\n                cur_blocksize: bs,\n                channels: ch,\n            };\n            let c_ret = c_upd(&mut c_t as *mut Tflac, samples.as_ptr());\n            let r_ret = r_upd(&mut r_t as *mut Tflac, samples.as_ptr());\n            assert_eq!(c_ret, r_ret, \"ret mismatch bs={} ch={}\", bs, ch);\n            assert!(\n                tflac_eq(&c_t, &r_t),\n                \"state mismatch bs={} ch={}\",\n                bs, ch\n            );\n        }\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
