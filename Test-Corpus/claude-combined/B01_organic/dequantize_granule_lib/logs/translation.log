{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_evfw3hjqkdhwy27ealqju3vritygatc6fpeaq4skh2afkfr2vhbq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_0146WPzH9oMBV8NsPxgNpYvY","name":"Write","input":{"file_path":"/tmp/harvest-translate-0w8yeQ/translated_rust/tests/ffi_compare.rs","content":"//! Integration tests that load BOTH the C and Rust shared libraries via\n//! libloading and verify that they produce byte-identical output for the\n//! exported `dequantize_granule` API.\n\nuse libloading::{Library, Symbol};\nuse std::os::raw::c_int;\nuse std::path::PathBuf;\n\n#[repr(C)]\nstruct BsT {\n    buf: *const u8,\n    pos: c_int,\n    limit: c_int,\n}\n\n#[repr(C)]\nstruct L12ScaleInfo {\n    scf: [f32; 3 * 64],\n    total_bands: u8,\n    stereo_bands: u8,\n    bitalloc: [u8; 64],\n    scfcod: [u8; 64],\n}\n\nimpl Default for L12ScaleInfo {\n    fn default() -> Self {\n        Self {\n            scf: [0.0; 192],\n            total_bands: 0,\n            stereo_bands: 0,\n            bitalloc: [0; 64],\n            scfcod: [0; 64],\n        }\n    }\n}\n\ntype DequantizeGranuleFn = unsafe extern \"C\" fn(\n    grbuf: *mut f32,\n    bs: *mut BsT,\n    sci: *mut L12ScaleInfo,\n    group_size: c_int,\n) -> c_int;\n\nfn c_lib_path() -> PathBuf {\n    let manifest = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    manifest.join(\"c_src/build/libtranslated_rust.so\")\n}\n\nfn rust_lib_path() -> PathBuf {\n    let manifest = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    manifest.join(\"target/release/libtranslated_rust.so\")\n}\n\nstruct LoadedLib {\n    _lib: Library,\n    dequantize_granule: DequantizeGranuleFn,\n}\n\nimpl LoadedLib {\n    fn load(path: &PathBuf) -> Self {\n        unsafe {\n            let lib = Library::new(path).expect(\"failed to load library\");\n            let symbol: Symbol<DequantizeGranuleFn> =\n                lib.get(b\"dequantize_granule\").expect(\"missing symbol\");\n            let f = *symbol;\n            // Drop the Symbol but keep the Library alive.\n            drop(symbol);\n            LoadedLib {\n                _lib: lib,\n                dequantize_granule: f,\n            }\n        }\n    }\n}\n\n/// Run a single test case through both libraries and compare results.\nfn run_case(\n    label: &str,\n    c_lib: &LoadedLib,\n    rust_lib: &LoadedLib,\n    sci: &L12ScaleInfo,\n    bitstream: &[u8],\n    pos: c_int,\n    limit: c_int,\n    group_size: c_int,\n) {\n    // Allocate two granule buffers, fill with a sentinel so we can spot writes.\n    // grbuf is indexed up to (group_size*j) + (k * choff)... we need at least\n    // 2*576 + group_size*4 floats to be safe, but the C code writes into a\n    // pattern that ranges across `grbuf[0..2*576]` typically. We use a\n    // generous size to avoid OOB regardless of specific case.\n    let grbuf_len = 2 * 576 + 4 * (group_size as usize) + 64;\n\n    let mut c_grbuf = vec![f32::from_bits(0xDEAD_BEEF); grbuf_len];\n    let mut rust_grbuf = vec![f32::from_bits(0xDEAD_BEEF); grbuf_len];\n\n    // Each library gets its own copy of the bs struct (pos is mutated).\n    let mut c_bs = BsT {\n        buf: bitstream.as_ptr(),\n        pos,\n        limit,\n    };\n    let mut rust_bs = BsT {\n        buf: bitstream.as_ptr(),\n        pos,\n        limit,\n    };\n\n    // Each library gets its own (mutable) copy of sci. The C code does not\n    // modify sci, but pass distinct copies to be safe.\n    let mut c_sci = L12ScaleInfo {\n        scf: sci.scf,\n        total_bands: sci.total_bands,\n        stereo_bands: sci.stereo_bands,\n        bitalloc: sci.bitalloc,\n        scfcod: sci.scfcod,\n    };\n    let mut rust_sci = L12ScaleInfo {\n        scf: sci.scf,\n        total_bands: sci.total_bands,\n        stereo_bands: sci.stereo_bands,\n        bitalloc: sci.bitalloc,\n        scfcod: sci.scfcod,\n    };\n\n    let c_ret = unsafe {\n        (c_lib.dequantize_granule)(c_grbuf.as_mut_ptr(), &mut c_bs, &mut c_sci, group_size)\n    };\n    let rust_ret = unsafe {\n        (rust_lib.dequantize_granule)(\n            rust_grbuf.as_mut_ptr(),\n            &mut rust_bs,\n            &mut rust_sci,\n            group_size,\n        )\n    };\n\n    assert_eq!(c_ret, rust_ret, \"[{}] return value mismatch\", label);\n    assert_eq!(\n        c_bs.pos, rust_bs.pos,\n        \"[{}] bitstream pos mismatch after call\",\n        label\n    );\n\n    // Compare buffers byte-for-byte by checking each f32's bit pattern.\n    for (i, (c_val, r_val)) in c_grbuf.iter().zip(rust_grbuf.iter()).enumerate() {\n        assert_eq!(\n            c_val.to_bits(),\n            r_val.to_bits(),\n            \"[{}] grbuf[{}] mismatch: c={} (0x{:08x}) rust={} (0x{:08x})\",\n            label,\n            i,\n            c_val,\n            c_val.to_bits(),\n            r_val,\n            r_val.to_bits(),\n        );\n    }\n}\n\n#[test]\nfn ba_zero_passthrough() {\n    // All-zero bitalloc should produce a buffer left as the sentinel except\n    // for nothing (no writes) — both libs should match exactly.\n    let c_lib = LoadedLib::load(&c_lib_path());\n    let rust_lib = LoadedLib::load(&rust_lib_path());\n\n    let mut sci = L12ScaleInfo::default();\n    sci.total_bands = 4; // 8 bands processed (2 * total_bands)\n    // bitalloc all zero by default.\n\n    let bitstream = vec![0u8; 1024];\n    run_case(\n        \"ba_zero\",\n        &c_lib,\n        &rust_lib,\n        &sci,\n        &bitstream,\n        0,\n        (bitstream.len() * 8) as c_int,\n        12,\n    );\n}\n\n#[test]\nfn ba_small_values() {\n    // Various ba values 1..16 (the < 17 branch) with a deterministic\n    // bitstream.\n    let c_lib = LoadedLib::load(&c_lib_path());\n    let rust_lib = LoadedLib::load(&rust_lib_path());\n\n    let mut sci = L12ScaleInfo::default();\n    sci.total_bands = 6; // 12 bands\n    for i in 0..(2 * sci.total_bands as usize) {\n        // Cycle through ba values 1..=16\n        sci.bitalloc[i] = ((i % 16) + 1) as u8;\n    }\n\n    // Pseudo-random-ish but deterministic bitstream.\n    let bitstream: Vec<u8> = (0..2048u32).map(|x| (x.wrapping_mul(2654435761)) as u8).collect();\n\n    run_case(\n        \"ba_small\",\n        &c_lib,\n        &rust_lib,\n        &sci,\n        &bitstream,\n        0,\n        (bitstream.len() * 8) as c_int,\n        12,\n    );\n}\n\n#[test]\nfn ba_large_values() {\n    // ba values >= 17 trigger the modulo branch.\n    let c_lib = LoadedLib::load(&c_lib_path());\n    let rust_lib = LoadedLib::load(&rust_lib_path());\n\n    let mut sci = L12ScaleInfo::default();\n    sci.total_bands = 4; // 8 bands\n    // ba can be 17 or 18 in the C codec source per allocation table.\n    let bas: [u8; 8] = [17, 18, 17, 18, 17, 18, 17, 18];\n    sci.bitalloc[..8].copy_from_slice(&bas);\n\n    let bitstream: Vec<u8> = (0..2048u32).map(|x| (x.wrapping_mul(0x9E3779B1)) as u8).collect();\n\n    run_case(\n        \"ba_large\",\n        &c_lib,\n        &rust_lib,\n        &sci,\n        &bitstream,\n        0,\n        (bitstream.len() * 8) as c_int,\n        12,\n    );\n}\n\n#[test]\nfn mixed_bitalloc() {\n    let c_lib = LoadedLib::load(&c_lib_path());\n    let rust_lib = LoadedLib::load(&rust_lib_path());\n\n    let mut sci = L12ScaleInfo::default();\n    sci.total_bands = 8; // 16 bands\n    // Mix of 0, small, and large.\n    let bas: [u8; 16] = [0, 1, 2, 5, 0, 17, 18, 16, 3, 0, 8, 17, 4, 0, 18, 7];\n    sci.bitalloc[..16].copy_from_slice(&bas);\n\n    let bitstream: Vec<u8> = (0..4096u32).map(|x| (x ^ (x >> 7)) as u8).collect();\n\n    run_case(\n        \"mixed\",\n        &c_lib,\n        &rust_lib,\n        &sci,\n        &bitstream,\n        0,\n        (bitstream.len() * 8) as c_int,\n        12,\n    );\n}\n\n#[test]\nfn group_size_4() {\n    let c_lib = LoadedLib::load(&c_lib_path());\n    let rust_lib = LoadedLib::load(&rust_lib_path());\n\n    let mut sci = L12ScaleInfo::default();\n    sci.total_bands = 5;\n    for i in 0..10 {\n        sci.bitalloc[i] = ((i % 5) + 1) as u8;\n    }\n\n    let bitstream: Vec<u8> = (0..1024u32).map(|x| x as u8).collect();\n\n    run_case(\n        \"group_4\",\n        &c_lib,\n        &rust_lib,\n        &sci,\n        &bitstream,\n        0,\n        (bitstream.len() * 8) as c_int,\n        4,\n    );\n}\n\n#[test]\nfn limit_exceeded_returns_zero() {\n    // get_bits returns 0 when pos exceeds limit. Verify both libraries do\n    // the same thing in that boundary condition.\n    let c_lib = LoadedLib::load(&c_lib_path());\n    let rust_lib = LoadedLib::load(&rust_lib_path());\n\n    let mut sci = L12ScaleInfo::default();\n    sci.total_bands = 3; // 6 bands\n    for i in 0..6 {\n        sci.bitalloc[i] = 4;\n    }\n\n    // Tight limit so reads go past the end quickly.\n    let bitstream: Vec<u8> = (0..16u32).map(|x| (x * 17) as u8).collect();\n    let limit: c_int = 16; // only 16 bits available\n\n    run_case(\n        \"limit_exceeded\",\n        &c_lib,\n        &rust_lib,\n        &sci,\n        &bitstream,\n        0,\n        limit,\n        12,\n    );\n}\n\n#[test]\nfn nonzero_starting_pos() {\n    let c_lib = LoadedLib::load(&c_lib_path());\n    let rust_lib = LoadedLib::load(&rust_lib_path());\n\n    let mut sci = L12ScaleInfo::default();\n    sci.total_bands = 4;\n    let bas: [u8; 8] = [3, 17, 5, 18, 0, 12, 17, 1];\n    sci.bitalloc[..8].copy_from_slice(&bas);\n\n    let bitstream: Vec<u8> = (0..4096u32).map(|x| (x.wrapping_mul(1103515245).wrapping_add(12345)) as u8).collect();\n\n    // Several different starting positions to exercise the (pos & 7) shift.\n    for start in [0, 1, 3, 7, 8, 13, 31, 64] {\n        run_case(\n            &format!(\"nonzero_pos_{}\", start),\n            &c_lib,\n            &rust_lib,\n            &sci,\n            &bitstream,\n            start,\n            (bitstream.len() * 8) as c_int,\n            12,\n        );\n    }\n}\n\n#[test]\nfn return_value_basic() {\n    // The function returns group_size * 4 unconditionally.\n    let c_lib = LoadedLib::load(&c_lib_path());\n    let rust_lib = LoadedLib::load(&rust_lib_path());\n\n    for gs in [0, 1, 4, 8, 12, 24] {\n        let sci = L12ScaleInfo::default();\n        let bitstream = vec![0u8; 256];\n        run_case(\n            &format!(\"ret_gs_{}\", gs),\n            &c_lib,\n            &rust_lib,\n            &sci,\n            &bitstream,\n            0,\n            (bitstream.len() * 8) as c_int,\n            gs,\n        );\n    }\n}\n\n#[test]\nfn dense_random_sweep() {\n    // Many varied configurations to catch any subtle bug.\n    let c_lib = LoadedLib::load(&c_lib_path());\n    let rust_lib = LoadedLib::load(&rust_lib_path());\n\n    // Simple LCG so results are reproducible without an external crate.\n    let mut state: u64 = 0xC0FFEE_BEEFu64;\n    let mut next = || {\n        state = state.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);\n        (state >> 32) as u32\n    };\n\n    let bitstream: Vec<u8> = (0..8192u32).map(|x| (x.wrapping_mul(2654435761)) as u8).collect();\n\n    for case in 0..50 {\n        let mut sci = L12ScaleInfo::default();\n        sci.total_bands = ((next() % 10) + 1) as u8; // 1..=10\n        let nbands = 2 * sci.total_bands as usize;\n        for i in 0..nbands {\n            // Pick from {0, 1..16, 17, 18} with various probabilities.\n            let r = next() % 20;\n            sci.bitalloc[i] = match r {\n                0..=3 => 0,                          // zero\n                4..=15 => ((next() % 16) + 1) as u8, // 1..=16\n                _ => 17 + (next() % 2) as u8,        // 17 or 18\n            };\n        }\n\n        let group_size = ((next() % 24) + 1) as c_int;\n        let start_pos = (next() % 100) as c_int;\n\n        run_case(\n            &format!(\"sweep_{}\", case),\n            &c_lib,\n            &rust_lib,\n            &sci,\n            &bitstream,\n            start_pos,\n            (bitstream.len() * 8) as c_int,\n            group_size,\n        );\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":182,"cache_read_input_tokens":19384,"cache_creation":{"ephemeral_5m_input_tokens":182,"ephemeral_1h_input_tokens":0},"output_tokens":22,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"29a2ec77-b1a5-4207-8393-e8c3a2898bb9","uuid":"98b20c4b-cbbf-46a0-93f2-2243151c5e3a"}
