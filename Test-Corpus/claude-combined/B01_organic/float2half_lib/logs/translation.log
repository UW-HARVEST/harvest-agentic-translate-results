{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_2xcreoypostz7s6oc23bsah63ymlkwwwcowfw3idt7maiviu76zq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01UqTPT9HHVJfb1R96h2AvqS","name":"Write","input":{"file_path":"/tmp/harvest-translate-bqcgbc/translated_rust/tests/ffi_compare.rs","content":"use libloading::{Library, Symbol};\nuse std::path::PathBuf;\n\ntype Float2HalfFn = unsafe extern \"C\" fn(f32) -> u16;\n\nfn workspace_root() -> PathBuf {\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n}\n\nfn c_lib_path() -> PathBuf {\n    workspace_root().join(\"c_src/build/libtranslated_rust.so\")\n}\n\nfn rust_lib_path() -> PathBuf {\n    // The integration test binary lives in target/<profile>/deps; the cdylib\n    // is in target/<profile>/. Use CARGO_MANIFEST_DIR to find both, picking\n    // whichever profile (debug/release) is built.\n    let root = workspace_root();\n    let release = root.join(\"target/release/libtranslated_rust.so\");\n    let debug = root.join(\"target/debug/libtranslated_rust.so\");\n    if release.exists() {\n        release\n    } else {\n        debug\n    }\n}\n\nunsafe fn load(path: &std::path::Path) -> Library {\n    Library::new(path).unwrap_or_else(|e| panic!(\"failed to load {:?}: {}\", path, e))\n}\n\nfn run_pair<F: Fn(Float2HalfFn, Float2HalfFn)>(f: F) {\n    unsafe {\n        let c_lib = load(&c_lib_path());\n        let rust_lib = load(&rust_lib_path());\n        let c_fn: Symbol<Float2HalfFn> = c_lib.get(b\"float2half\").unwrap();\n        let r_fn: Symbol<Float2HalfFn> = rust_lib.get(b\"float2half\").unwrap();\n        f(*c_fn, *r_fn);\n    }\n}\n\nfn check(c: Float2HalfFn, r: Float2HalfFn, value: f32) {\n    unsafe {\n        let cv = c(value);\n        let rv = r(value);\n        assert_eq!(\n            cv, rv,\n            \"mismatch on value {} (bits 0x{:08x}): C=0x{:04x} Rust=0x{:04x}\",\n            value,\n            value.to_bits(),\n            cv,\n            rv\n        );\n    }\n}\n\n#[test]\nfn float2half_zero_and_subnormal() {\n    run_pair(|c, r| {\n        check(c, r, 0.0_f32);\n        check(c, r, -0.0_f32);\n        check(c, r, f32::from_bits(0x00000001));\n        check(c, r, f32::from_bits(0x80000001));\n        check(c, r, 1e-40_f32);\n        check(c, r, -1e-40_f32);\n    });\n}\n\n#[test]\nfn float2half_normal_values() {\n    run_pair(|c, r| {\n        let values: &[f32] = &[\n            1.0, -1.0, 0.5, -0.5, 2.0, -2.0, 65504.0, -65504.0, 0.1, -0.1, 100.0, -100.0,\n            1e-7, 1e-5, 1e-3, 1e3, 1e5, 1.5, 2.5, 3.14159, 2.71828,\n        ];\n        for &v in values {\n            check(c, r, v);\n        }\n    });\n}\n\n#[test]\nfn float2half_infinity_nan() {\n    run_pair(|c, r| {\n        check(c, r, f32::INFINITY);\n        check(c, r, f32::NEG_INFINITY);\n        check(c, r, f32::NAN);\n        check(c, r, -f32::NAN);\n        // Custom NaN bit patterns\n        check(c, r, f32::from_bits(0x7fc00001));\n        check(c, r, f32::from_bits(0xffc00001));\n        check(c, r, f32::from_bits(0x7f800001)); // signaling NaN\n    });\n}\n\n#[test]\nfn float2half_overflow_underflow() {\n    run_pair(|c, r| {\n        check(c, r, f32::MAX);\n        check(c, r, f32::MIN);\n        check(c, r, f32::MIN_POSITIVE);\n        check(c, r, -f32::MIN_POSITIVE);\n        check(c, r, 1e30_f32);\n        check(c, r, -1e30_f32);\n        check(c, r, 1e-30_f32);\n    });\n}\n\n#[test]\nfn float2half_exhaustive_exponent_sweep() {\n    // Sweep all 512 exponent+sign combinations with mantissa = 0\n    run_pair(|c, r| {\n        for j in 0u32..512 {\n            // build float with exponent = (j & 0xff), sign = j>>8\n            let bits = (j << 23) | 0; // mantissa=0\n            let f = f32::from_bits(bits);\n            check(c, r, f);\n        }\n    });\n}\n\n#[test]\nfn float2half_random_bit_patterns() {\n    // Pseudo-random sweep using a simple LCG. Cover varied mantissas.\n    run_pair(|c, r| {\n        let mut state: u64 = 0xDEADBEEFCAFEBABE;\n        for _ in 0..10000 {\n            state = state.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);\n            let bits = (state >> 32) as u32;\n            let f = f32::from_bits(bits);\n            check(c, r, f);\n        }\n    });\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":166,"cache_read_input_tokens":29948,"cache_creation":{"ephemeral_5m_input_tokens":166,"ephemeral_1h_input_tokens":0},"output_tokens":22,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"5f750838-8774-4009-b394-03f174fe2417","uuid":"44536831-34ba-415b-8ca7-0ab8479b8039"}
