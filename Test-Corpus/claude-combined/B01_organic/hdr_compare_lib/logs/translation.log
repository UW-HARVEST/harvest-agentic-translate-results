 in 0u8..=255 {\n                    for b1 in 0u8..=255 {\n                        // Limit h2/h2 sweep to representative values for time\n                        for a2 in [0x00u8, 0x0c, 0x10, 0x33, 0xa0, 0xff, 0xf0, 0xc0].iter() {\n                            for b2 in [0x00u8, 0x0c, 0x10, 0x33, 0xa0, 0xff, 0xf0, 0xc0].iter() {\n                                let h1 = [a0, a1, *a2];\n                                let h2 = [b0, b1, *b2];\n                                let c_res = c_fn(h1.as_ptr(), h2.as_ptr());\n                                let r_res = r_fn(h1.as_ptr(), h2.as_ptr());\n                                assert_eq!(\n                                    c_res, r_res,\n                                    \"Mismatch for h1={:?}, h2={:?}: C={}, Rust={}\",\n                                    h1, h2, c_res, r_res\n                                );\n                            }\n                        }\n                    }\n                }\n            }\n        }\n    }\n}\n\n#[test]\nfn compare_hdr_compare_specific_cases() {\n    let (c_lib, r_lib) = load_libs();\n    unsafe {\n        let c_fn: Symbol<HdrCompareFn> = c_lib.get(b\"hdr_compare\").unwrap();\n        let r_fn: Symbol<HdrCompareFn> = r_lib.get(b\"hdr_compare\").unwrap();\n\n        // Specific MPEG header-like cases\n        let cases: [[u8; 3]; 8] = [\n            [0xff, 0xfb, 0x90],\n            [0xff, 0xfa, 0x90],\n            [0xff, 0xe2, 0x10],\n            [0xff, 0xf2, 0xff],\n            [0x00, 0x00, 0x00],\n            [0xff, 0xff, 0xff],\n            [0xff, 0xf0, 0xf0],\n            [0xff, 0xfc, 0x0c],\n        ];\n        for h1 in &cases {\n            for h2 in &cases {\n                let c_res = c_fn(h1.as_ptr(), h2.as_ptr());\n                let r_res = r_fn(h1.as_ptr(), h2.as_ptr());\n                assert_eq!(\n                    c_res, r_res,\n                    \"Mismatch for h1={:?}, h2={:?}: C={}, Rust={}\",\n                    h1, h2, c_res, r_res\n                );\n            }\n        }\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
