(c_path.exists(), \"C lib not found at {:?}\", c_path);\n    assert!(r_path.exists(), \"Rust lib not found at {:?}\", r_path);\n\n    let c_lib = unsafe { Library::new(&c_path) }.expect(\"load C lib\");\n    let r_lib = unsafe { Library::new(&r_path) }.expect(\"load Rust lib\");\n\n    let cases = [\n        TflacMd5 { a: 0, b: 0, c: 0, d: 0 },\n        TflacMd5 {\n            a: 0x01020304,\n            b: 0x05060708,\n            c: 0x090a0b0c,\n            d: 0x0d0e0f10,\n        },\n        TflacMd5 {\n            a: 0xffffffff,\n            b: 0xffffffff,\n            c: 0xffffffff,\n            d: 0xffffffff,\n        },\n        TflacMd5 {\n            a: 0xdeadbeef,\n            b: 0xcafebabe,\n            c: 0xfeedface,\n            d: 0x8badf00d,\n        },\n        TflacMd5 {\n            a: 1,\n            b: 2,\n            c: 3,\n            d: 4,\n        },\n        TflacMd5 {\n            a: 0x80000000,\n            b: 0x00000001,\n            c: 0x7fffffff,\n            d: 0x12345678,\n        },\n    ];\n\n    for case in &cases {\n        run_case(&c_lib, &r_lib, case);\n    }\n\n    // Pseudorandom sweep with deterministic LCG so failures are reproducible.\n    let mut state: u64 = 0xC0FFEEu64;\n    for _ in 0..1024 {\n        let mut next = || {\n            state = state.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);\n            (state >> 32) as u32\n        };\n        let m = TflacMd5 {\n            a: next(),\n            b: next(),\n            c: next(),\n            d: next(),\n        };\n        run_case(&c_lib, &r_lib, &m);\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":173,"cache_read_input_tokens":18528,"cache_creation":{"ephemeral_5m_input_tokens":173,"ephemeral_1h_input_tokens":0},"output_tokens":22,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"7f2d6884-4e3c-4479-bbab-e8999704