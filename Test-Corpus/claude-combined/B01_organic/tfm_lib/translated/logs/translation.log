_branch_first() {\n    // s0 < s1 => first branch\n    let src = vec![1.0f32, 5.0, 2.0];\n    compare(&src, 1);\n}\n\n#[test]\nfn test_branch_second() {\n    // s0 >= s1 => second branch\n    let src = vec![5.0f32, 1.0, 2.0];\n    compare(&src, 1);\n}\n\n#[test]\nfn test_equal_first_second() {\n    // s0 == s1 => second branch\n    let src = vec![3.0f32, 3.0, 1.5];\n    compare(&src, 1);\n}\n\n#[test]\nfn test_multiple_inputs() {\n    let src = vec![\n        0.1f32, 0.2, 0.3, // first branch\n        0.5, 0.4, 0.3, // second branch\n        1.0, 1.0, 0.0, // equal\n        -1.0, 2.0, 0.5, // negative\n        2.0, -1.0, 0.5, // negative\n    ];\n    compare(&src, 5);\n}\n\n#[test]\nfn test_negative_values() {\n    let src = vec![-3.0f32, -1.0, -2.0];\n    compare(&src, 1);\n}\n\n#[test]\nfn test_zeros() {\n    let src = vec![0.0f32, 0.0, 0.0];\n    compare(&src, 1);\n}\n\n#[test]\nfn test_large_values() {\n    let src = vec![1e10f32, 2e10, 3e10, 1e-10, 2e-10, 3e-10];\n    compare(&src, 2);\n}\n\n#[test]\nfn test_random_like() {\n    let mut src: Vec<f32> = Vec::new();\n    for i in 0..200 {\n        let x = (i as f32) * 0.31 - 30.0;\n        let y = (i as f32) * 0.17 + 5.0;\n        let z = ((i as f32) * 0.07).sin() * 4.0;\n        src.push(x);\n        src.push(y);\n        src.push(z);\n    }\n    compare(&src, 200);\n}\n\n#[test]\nfn test_special_inf_nan_paths() {\n    // values that may yield negative sqd if not clamped\n    let src = vec![10.0f32, 0.5, 0.01];\n    compare(&src, 1);\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
