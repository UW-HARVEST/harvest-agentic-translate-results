{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_dbee6ta2ya2zp26tywjubqemev6u2u5zomy2uvdsurljaqubylsq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01DE21UtGUeJmTAmSt43somV","name":"Write","input":{"file_path":"/tmp/harvest-translate-d4gGuI/translated_rust/tests/ffi_compare.rs","content":"use libloading::{Library, Symbol};\nuse std::path::PathBuf;\n\ntype EncodeQuantFn = unsafe extern \"C\" fn(\n    uni: i32,\n    step: i32,\n    pred: i32,\n    tgt: i32,\n    tgt2: i32,\n    lsbit: i32,\n) -> i32;\n\nfn c_lib_path() -> PathBuf {\n    let mut p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    p.push(\"c_src\");\n    p.push(\"build\");\n    p.push(\"libtranslated_rust.so\");\n    p\n}\n\nfn rust_lib_path() -> PathBuf {\n    let mut p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    p.push(\"target\");\n    p.push(\"release\");\n    p.push(\"libtranslated_rust.so\");\n    p\n}\n\nfn load_libs() -> (Library, Library) {\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).expect(\"Failed to load C library\");\n        let rust_lib = Library::new(rust_lib_path()).expect(\"Failed to load Rust library\");\n        (c_lib, rust_lib)\n    }\n}\n\nfn call_encode_quant(\n    lib: &Library,\n    uni: i32,\n    step: i32,\n    pred: i32,\n    tgt: i32,\n    tgt2: i32,\n    lsbit: i32,\n) -> i32 {\n    unsafe {\n        let f: Symbol<EncodeQuantFn> = lib.get(b\"encode_quant\").expect(\"symbol\");\n        f(uni, step, pred, tgt, tgt2, lsbit)\n    }\n}\n\n#[test]\nfn test_encode_quant_basic() {\n    let (c_lib, rust_lib) = load_libs();\n\n    let cases = [\n        (0, 8, 0, 0, 0, 0),\n        (1, 8, 0, 0, 0, 0),\n        (7, 8, 0, 0, 0, 0),\n        (8, 8, 0, 0, 0, 0),\n        (15, 8, 0, 0, 0, 0),\n        (3, 16, 100, 50, 200, 0),\n        (3, 16, 100, 50, 200, 1),\n        (3, 16, 100, 50, 200, 2),\n        (3, 16, 100, 50, 200, 3),\n        (3, 16, 100, 50, 200, 4),\n        (3, 16, 100, 50, 200, 5),\n        (0, 1, 0, 0, 0, 1),\n        (15, 100, 1000, -500, 500, 4),\n        (-1, 8, 0, 0, 0, 0),\n        (-100, 8, 0, 0, 0, 4),\n    ];\n\n    for &(uni, step, pred, tgt, tgt2, lsbit) in &cases {\n        let c_out = call_encode_quant(&c_lib, uni, step, pred, tgt, tgt2, lsbit);\n        let r_out = call_encode_quant(&rust_lib, uni, step, pred, tgt, tgt2, lsbit);\n        assert_eq!(\n            c_out, r_out,\n            \"mismatch for inputs {:?}: C={} Rust={}\",\n            (uni, step, pred, tgt, tgt2, lsbit),\n            c_out,\n            r_out\n        );\n    }\n}\n\n#[test]\nfn test_encode_quant_random() {\n    let (c_lib, rust_lib) = load_libs();\n\n    // Deterministic LCG-based pseudo-random for reproducibility\n    let mut state: u64 = 0xdeadbeefcafebabe;\n    let mut next = || {\n        state = state.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);\n        (state >> 33) as u32\n    };\n\n    for _ in 0..2000 {\n        let uni = (next() % 32) as i32 - 16;\n        let step = (next() % 256) as i32;\n        let pred = (next() % 4096) as i32 - 2048;\n        let tgt = (next() % 4096) as i32 - 2048;\n        let tgt2 = (next() % 4096) as i32 - 2048;\n        let lsbit = (next() % 8) as i32;\n\n        let c_out = call_encode_quant(&c_lib, uni, step, pred, tgt, tgt2, lsbit);\n        let r_out = call_encode_quant(&rust_lib, uni, step, pred, tgt, tgt2, lsbit);\n        assert_eq!(\n            c_out, r_out,\n            \"mismatch for inputs ({}, {}, {}, {}, {}, {}): C={} Rust={}\",\n            uni, step, pred, tgt, tgt2, lsbit, c_out, r_out\n        );\n    }\n}\n\n#[test]\nfn test_encode_quant_lsbit_paths() {\n    let (c_lib, rust_lib) = load_libs();\n\n    // Cover all lsbit values 0..=7 with various uni\n    for uni in -20i32..=20 {\n        for lsbit in 0i32..=7 {\n            for step in [0, 1, 7, 8, 64, 255] {\n                for pred in [-1000, 0, 1000] {\n                    let tgt = pred / 2;\n                    let tgt2 = pred * 2;\n                    let c_out = call_encode_quant(&c_lib, uni, step, pred, tgt, tgt2, lsbit);\n                    let r_out = call_encode_quant(&rust_lib, uni, step, pred, tgt, tgt2, lsbit);\n                    assert_eq!(\n                        c_out, r_out,\n                        \"mismatch for ({}, {}, {}, {}, {}, {})\",\n                        uni, step, pred, tgt, tgt2, lsbit\n                    );\n                }\n            }\n        }\n    }\n}\n\n#[test]\nfn test_encode_quant_boundary_uni() {\n    let (c_lib, rust_lib) = load_libs();\n\n    // Boundary cases for uni near multiples of 8 to test (uni ^ uni1) & ~7 behavior\n    for &uni in &[\n        i32::MIN,\n        i32::MIN + 1,\n        -16,\n        -9,\n        -8,\n        -7,\n        -1,\n        0,\n        1,\n        7,\n        8,\n        9,\n        15,\n        16,\n        i32::MAX - 1,\n        i32::MAX,\n    ] {\n        for lsbit in 0..=5 {\n            let c_out = call_encode_quant(&c_lib, uni, 8, 0, 0, 0, lsbit);\n            let r_out = call_encode_quant(&rust_lib, uni, 8, 0, 0, 0, lsbit);\n            assert_eq!(\n                c_out, r_out,\n                \"mismatch for uni={}, lsbit={}\",\n                uni, lsbit\n            );\n        }\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":167,"cache_read_input_tokens":18932,"cache_creation":{"ephemeral_5m_input_tokens":167,"ephemeral_1h_input_tokens":0},"output_tokens":22,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"ceae8c49-bdf7-46e8-9ad6-99ce3e125b32","uuid":"02d07294-e124-4947-bb3f-bc2d232d5984"}
