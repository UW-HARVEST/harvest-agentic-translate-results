{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_x5ncbjpegi63zbss7wbb6warlp7o3ple6bbcsrekir5apumfjhna","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01T2y6WdQMKm7Coof2wo4BsD","name":"Write","input":{"file_path":"/tmp/harvest-translate-lzb8nR/translated_rust/tests/ffi_compare.rs","content":"use libloading::{Library, Symbol};\nuse std::path::PathBuf;\n\n#[repr(C)]\n#[derive(Copy, Clone, Debug, PartialEq, Eq)]\nstruct SpritebatchSpriteT {\n    texture_id: u64,\n    sort_bits: i32,\n}\n\ntype MergeSortFn = unsafe extern \"C\" fn(\n    a: *mut SpritebatchSpriteT,\n    b: *mut SpritebatchSpriteT,\n    size: i32,\n);\n\nfn project_root() -> PathBuf {\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n}\n\nfn c_lib_path() -> PathBuf {\n    project_root().join(\"c_src/build/libtranslated_rust.so\")\n}\n\nfn rust_lib_path() -> PathBuf {\n    project_root().join(\"target/release/libtranslated_rust.so\")\n}\n\nfn load_lib(p: &PathBuf) -> Library {\n    unsafe { Library::new(p) }.unwrap_or_else(|e| panic!(\"could not load {:?}: {e}\", p))\n}\n\nfn call_merge_sort(lib: &Library, input: &[SpritebatchSpriteT]) -> (Vec<SpritebatchSpriteT>, Vec<SpritebatchSpriteT>) {\n    let mut a = input.to_vec();\n    let mut b = input.to_vec();\n    unsafe {\n        let func: Symbol<MergeSortFn> = lib.get(b\"merge_sort\").unwrap();\n        func(a.as_mut_ptr(), b.as_mut_ptr(), input.len() as i32);\n    }\n    (a, b)\n}\n\nfn run_compare(input: &[SpritebatchSpriteT]) {\n    let c = load_lib(&c_lib_path());\n    let r = load_lib(&rust_lib_path());\n    let (c_a, c_b) = call_merge_sort(&c, input);\n    let (r_a, r_b) = call_merge_sort(&r, input);\n    assert_eq!(c_a, r_a, \"a buffers differ for input {:?}\", input);\n    assert_eq!(c_b, r_b, \"b buffers differ for input {:?}\", input);\n}\n\nfn s(t: u64, sb: i32) -> SpritebatchSpriteT {\n    SpritebatchSpriteT { texture_id: t, sort_bits: sb }\n}\n\n#[test]\nfn empty() {\n    run_compare(&[]);\n}\n\n#[test]\nfn single() {\n    run_compare(&[s(42, 7)]);\n}\n\n#[test]\nfn already_sorted() {\n    let v: Vec<_> = (0..16).map(|i| s(i as u64, i)).collect();\n    run_compare(&v);\n}\n\n#[test]\nfn reverse_sorted() {\n    let v: Vec<_> = (0..16).rev().map(|i| s(i as u64, i)).collect();\n    run_compare(&v);\n}\n\n#[test]\nfn duplicates() {\n    let v = vec![\n        s(1, 5),\n        s(2, 5),\n        s(3, 5),\n        s(0, 5),\n        s(7, 1),\n        s(6, 1),\n    ];\n    run_compare(&v);\n}\n\n#[test]\nfn mixed_random() {\n    // Simple LCG to make it deterministic\n    let mut state: u64 = 0xCAFEBABE_DEADBEEF;\n    let mut v = Vec::with_capacity(257);\n    for _ in 0..257 {\n        state = state.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);\n        let tex = state >> 32;\n        let sort_bits = (state & 0xFFFF) as i32 - 0x8000;\n        v.push(s(tex, sort_bits));\n    }\n    run_compare(&v);\n}\n\n#[test]\nfn negative_sort_bits() {\n    let v = vec![\n        s(10, -5),\n        s(20, -3),\n        s(30, 0),\n        s(40, 100),\n        s(50, -100),\n        s(60, 50),\n        s(70, -50),\n    ];\n    run_compare(&v);\n}\n\n#[test]\nfn all_equal() {\n    let v = vec![s(5, 5); 10];\n    run_compare(&v);\n}\n\n#[test]\nfn power_of_two_size() {\n    let v: Vec<_> = (0..64).map(|i| s((63 - i) as u64, (i * 7) % 13 - 6)).collect();\n    run_compare(&v);\n}\n\n#[test]\nfn odd_size() {\n    let v: Vec<_> = (0..33).map(|i| s((i * 31 % 17) as u64, i % 5 - 2)).collect();\n    run_compare(&v);\n}\n\n#[test]\nfn large_input() {\n    let mut state: u64 = 0xDEADBEEF_CAFEBABE;\n    let n = 5000;\n    let mut v = Vec::with_capacity(n);\n    for _ in 0..n {\n        state = state.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);\n        v.push(s(state, (state >> 16) as i32));\n    }\n    run_compare(&v);\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":273,"cache_read_input_tokens":18729,"cache_creation":{"ephemeral_5m_input_tokens":273,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"b7cafb71-d23c-4cc4-bfe4-f1371e9f3656","uuid":"277e0a45-09de-4a9e-a8df-d73fdb91bec9"}
