ush_u32_be(buf, 0); // priming_frames\n    push_u32_be(buf, 0); // remainder_frames\n}\n\nfn build_data_chunk(buf: &mut Vec<u8>, payload_size: i64, payload_bytes: &[u8]) {\n    push_fourcc(buf, b\"data\");\n    push_i64_be(buf, payload_size);\n    push_u32_be(buf, 0); // edit_count\n    buf.extend_from_slice(payload_bytes);\n}","newString":"// ---------- Helpers for constructing in-memory CAF-style buffers ----------\n//\n// IMPORTANT: The C parser interprets the input bytes as native in-memory C\n// structs. Each field's *value* is stored in big-endian byte order, but the\n// struct layout includes natural alignment padding. In particular,\n// `caf_chunk { u32 type; i64 size; }` is 16 bytes with a 4-byte padding hole\n// between `type` and `size`, NOT 12 bytes as on-disk CAF would have it.\n\nfn push_u16_be(buf: &mut Vec<u8>, v: u16) {\n    buf.extend_from_slice(&v.to_be_bytes());\n}\nfn push_u32_be(buf: &mut Vec<u8>, v: u32) {\n    buf.extend_from_slice(&v.to_be_bytes());\n}\nfn push_i64_be(buf: &mut Vec<u8>, v: i64) {\n    buf.extend_from_slice(&v.to_be_bytes());\n}\nfn push_fourcc(buf: &mut Vec<u8>, s: &[u8; 4]) {\n    buf.extend_from_slice(s);\n}\nfn push_padding(buf: &mut Vec<u8>, n: usize) {\n    for _ in 0..n {\n        buf.push(0);\n    }\n}\n\n/// caf_header: u32 type, u16 version, u16 flags. Size = 8.\nfn build_caf_header(buf: &mut Vec<u8>, version: u16, magic: &[u8; 4]) {\n    push_fourcc(buf, magic);\n    push_u16_be(buf, version);\n    push_u16_be(buf, 0); // flags\n}\n\n/// caf_chunk header: u32 type + 4 bytes padding + i64 size. Size = 16.\nfn push_chunk_header(buf: &mut Vec<u8>, fourcc: &[u8; 4], size: i64) {\n    push_fourcc(buf, fourcc);\n    push_padding(buf, 4); // alignment padding before i64 size\n    push_i64_be(buf, size);\n}\n\n/// caf_audio_description body: f64, u32, u32, u32, u32, u32, u32. Size = 32.\nfn build_desc_chunk(\n    buf: &mut Vec<u8>,\n    sample_rate_raw_bytes: [u8; 8],\n    format_id: &[u8; 4],\n    channels_per_frame: u32,\n) {\n    push_chunk_header(buf, b\"desc\", 32);\n    buf.extend_from_slice(&sample_rate_raw_bytes); // 8 raw bytes\n    push_fourcc(buf, format_id);\n    push_u32_be(buf, 0); // format_flags\n    push_u32_be(buf, 34); // bytes_per_packet\n    push_u32_be(buf, 64); // frames_per_packet\n    push_u32_be(buf, channels_per_frame);\n    push_u32_be(buf, 16); // bits_per_channel\n}\n\n/// caf_packet_table body: i64, i64, i32, i32. Size = 24.\nfn build_pakt_chunk(buf: &mut Vec<u8>, frame_count: i64) {\n    push_chunk_header(buf, b\"pakt\", 24);\n    push_i64_be(buf, 0); // packet_count\n    push_i64_be(buf, frame_count);\n    push_u32_be(buf, 0); // priming_frames\n    push_u32_be(buf, 0); // remainder_frames\n}\n\n/// data chunk: caf_data { u32 edit_count } + opaque audio payload.\nfn build_data_chunk(buf: &mut Vec<u8>, payload_size: i64, payload_bytes: &[u8]) {\n    push_chunk_header(buf, b\"data\", payload_size);\n    push_u32_be(buf, 0); // edit_count\n    buf.extend_from_slice(payload_bytes);\n}","originalFile":"//! Integration tests that compare the C and Rust implementations of\n//! `ima_parse` via FFI through libloading. Both shared libraries are loaded at\n//! runtime and compared symbol-for-symbol.\n\nuse libloading::{Library, Symbol};\nuse std::ffi::c_void;\nuse std::os::raw::c_int;\nuse std::path::{Path, PathBuf};\n\n/// Buffer wrapper that guarantees 8-byte alignment of the underlying storage,\n/// matching the natural alignment of the largest field in the C structs\n/// (`ima_s64_t`).\n#[repr(C, align(8))]\nstruct AlignedBuf(Vec<u64>);\n\nimpl AlignedBuf {\n    fn from_bytes(bytes: &[u8]) -> Self {\n        let words = (bytes.len() + 7) / 8;\n        let mut v: Vec<u64> = vec![0u64; words];\n        unsafe {\n            std::ptr::copy_nonoverlapping(\n                bytes.as_ptr(),\n                v.as_mut_ptr() as *mut u8,\n                bytes.len(),\n            );\n        }\n        AlignedBuf(v)\n    }\n    fn as_ptr(&self) -> *const u8 {\n        self.0.as_ptr() as *const u8\n    }\n}\n\n#[repr(C)]\n#[derive(Debug, Clone, Copy)]\nstruct ImaBlock {\n    preamble: u16,\n    data: [u8; 32],\n}\n\n#[repr(C)]\n#[derive(Debug, Clone, Copy)]\nstruct ImaInfo {\n    blocks: *const ImaBlock,\n    size: u64,\n    sample_rate: f64,\n    frame_count: u64,\n    channel_count: u32,\n}\n\nunsafe impl Send for ImaInfo {}\n\ntype ImaParseFn = unsafe extern \"C\" fn(*mut ImaInfo, *const c_void) -> c_int;\n\nfn workspace_root() -> PathBuf {\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n}\n\nfn c_lib_path() -> PathBuf {\n    let mut p = workspace_root();\n    p.push(\"c_src\");\n    p.push(\"build\");\n    p.push(\"libtranslated_rust.so\");\n    p\n}\n\nfn rust_lib_path() -> PathBuf {\n    let mut p = workspace_root();\n    p.push(\"target\");\n    p.push(\"release\");\n    p.push(\"libima_lib.so\");\n    p\n}\n\nfn ensure_libs_present() {\n    let cp = c_lib_path();\n    let rp = rust_lib_path();\n    assert!(\n        Path::new(&cp).exists(),\n        \"C shared lib not found at {:?}\",\n        cp\n    );\n    assert!(\n        Path::new(&rp).exists(),\n        \"Rust shared lib not found at {:?} (run `cargo build --release` first)\",\n        rp\n    );\n}\n\nunsafe fn call_parse(lib: &Library, buf: &AlignedBuf) -> (c_int, ImaInfo, *const u8) {\n    let mut info = ImaInfo {\n        blocks: std::ptr::null(),\n        size: 0xDEAD_BEEF_DEAD_BEEFu64,\n        sample_rate: 0.0,\n        frame_count: 0xDEAD_BEEF_DEAD_BEEFu64,\n        channel_count: 0xDEAD_BEEFu32,\n    };\n    let parse: Symbol<ImaParseFn> = lib.get(b\"ima_parse\").expect(\"symbol ima_parse missing\");\n    let p = buf.as_ptr();\n    let rc = parse(&mut info as *mut ImaInfo, p as *const c_void);\n    (rc, info, p)\n}\n\nfn compare_outputs(bytes: &[u8], data_offset_for_blocks: Option<usize>) {\n    ensure_libs_present();\n    let buf_c = AlignedBuf::from_bytes(bytes);\n    let buf_r = AlignedBuf::from_bytes(bytes);\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).expect(\"load C lib\");\n        let r_lib = Library::new(rust_lib_path()).expect(\"load Rust lib\");\n\n        let (rc_c, info_c, base_c) = call_parse(&c_lib, &buf_c);\n        let (rc_r, info_r, base_r) = call_parse(&r_lib, &buf_r);\n\n        assert_eq!(rc_c, rc_r, \"return code mismatch (C vs Rust)\");\n\n        if rc_c == 0 {\n            assert_eq!(info_c.size, info_r.size, \"size mismatch\");\n            assert_eq!(\n                info_c.sample_rate.to_bits(),\n                info_r.sample_rate.to_bits(),\n                \"sample_rate bits mismatch\"\n            );\n            assert_eq!(\n                info_c.frame_count, info_r.frame_count,\n                \"frame_count mismatch\"\n            );\n            assert_eq!(\n                info_c.channel_count, info_r.channel_count,\n                \"channel_count mismatch\"\n            );\n\n            // Compare blocks pointer offset (relative to its own buffer base).\n            let off_c = (info_c.blocks as usize).wrapping_sub(base_c as usize);\n            let off_r = (info_r.blocks as usize).wrapping_sub(base_r as usize);\n            assert_eq!(off_c, off_r, \"blocks pointer offset mismatch\");\n            if let Some(expected) = data_offset_for_blocks {\n                assert_eq!(\n                    off_c, expected,\n                    \"blocks pointer offset not at expected location\"\n                );\n            }\n        }\n    }\n}\n\n// ---------- Helpers for constructing CAF-style test buffers ----------\n\nfn push_u16_be(buf: &mut Vec<u8>, v: u16) {\n    buf.extend_from_slice(&v.to_be_bytes());\n}\nfn push_u32_be(buf: &mut Vec<u8>, v: u32) {\n    buf.extend_from_slice(&v.to_be_bytes());\n}\nfn push_i64_be(buf: &mut Vec<u8>, v: i64) {\n    buf.extend_from_slice(&v.to_be_bytes());\n}\nfn push_fourcc(buf: &mut Vec<u8>, s: &[u8; 4]) {\n    buf.extend_from_slice(s);\n}\n\nfn build_caf_header(buf: &mut Vec<u8>, version: u16, magic: &[u8; 4]) {\n    push_fourcc(buf, magic);\n    push_u16_be(buf, version);\n    push_u16_be(buf, 0); // flags\n}\n\nfn build_desc_chunk(\n    buf: &mut Vec<u8>,\n    sample_rate_raw_bytes: [u8; 8],\n    format_id: &[u8; 4],\n    channels_per_frame: u32,\n) {\n    push_fourcc(buf, b\"desc\");\n    push_i64_be(buf, 32); // size of audio description\n    buf.extend_from_slice(&sample_rate_raw_bytes); // raw 8 bytes for sample_rate field\n    push_fourcc(buf, format_id);\n    push_u32_be(buf, 0); // format_flags\n    push_u32_be(buf, 34); // bytes_per_packet\n    push_u32_be(buf, 64); // frames_per_packet\n    push_u32_be(buf, channels_per_frame);\n    push_u32_be(buf, 16); // bits_per_channel\n}\n\nfn build_pakt_chunk(buf: &mut Vec<u8>, frame_count: i64) {\n    push_fourcc(buf, b\"pakt\");\n    push_i64_be(buf, 24);\n    push_i64_be(buf, 0); // packet_count\n    push_i64_be(buf, frame_count);\n    push_u32_be(buf, 0); // priming_frames\n    push_u32_be(buf, 0); // remainder_frames\n}\n\nfn build_data_chunk(buf: &mut Vec<u8>, payload_size: i64, payload_bytes: &[u8]) {\n    push_fourcc(buf, b\"data\");\n    push_i64_be(buf, payload_size);\n    push_u32_be(buf, 0); // edit_count\n    buf.extend_from_slice(payload_bytes);\n}\n\n// ---------- Tests ----------\n\n#[test]\nfn invalid_magic_returns_minus_one() {\n    let mut buf = Vec::new();\n    build_caf_header(&mut buf, 1, b\"XXXX\");\n    // Pad with zero bytes so any deref of header is valid memory.\n    buf.resize(64, 0);\n    compare_outputs(&buf, None);\n}\n\n#[test]\nfn invalid_version_returns_minus_two() {\n    let mut buf = Vec::new();\n    build_caf_header(&mut buf, 2, b\"caff\");\n    buf.resize(64, 0);\n    compare_outputs(&buf, None);\n}\n\n#[test]\nfn invalid_format_id_returns_minus_three() {\n    let mut buf = Vec::new();\n    build_caf_header(&mut buf, 1, b\"caff\");\n    // sample_rate as 8 zero bytes (treats as 0.0 f64 -> u64 0)\n    let sr = [0u8; 8];\n    build_desc_chunk(&mut buf, sr, b\"junk\", 1);\n    build_pakt_chunk(&mut buf, 100);\n    build_data_chunk(&mut buf, 8, &[0u8; 8]);\n    compare_outputs(&buf, None);\n}\n\n#[test]\nfn full_parse_zero_sample_rate_one_channel() {\n    let mut buf = Vec::new();\n    build_caf_header(&mut buf, 1, b\"caff\");\n    let sr = [0u8; 8]; // 0.0 → conv path stays at 0\n    build_desc_chunk(&mut buf, sr, b\"ima4\", 1);\n    build_pakt_chunk(&mut buf, 12345);\n    let payload = vec![0xABu8; 64];\n    build_data_chunk(&mut buf, payload.len() as i64, &payload);\n\n    // header (8) + desc chunk header (12) + desc body (32)\n    //  + pakt chunk header (12) + pakt body (24)\n    //  + data chunk header (12) + caf_data (4) = 104\n    let expected_blocks_off = 8 + 12 + 32 + 12 + 24 + 12 + 4;\n    compare_outputs(&buf, Some(expected_blocks_off));\n}\n\n#[test]\nfn full_parse_two_channels_specific_size() {\n    let mut buf = Vec::new();\n    build_caf_header(&mut buf, 1, b\"caff\");\n    let sr = [0u8; 8];\n    build_desc_chunk(&mut buf, sr, b\"ima4\", 2);\n    build_pakt_chunk(&mut buf, 99_999);\n    let payload = vec![0u8; 128];\n    build_data_chunk(&mut buf, 128, &payload);\n\n    let expected_blocks_off = 8 + 12 + 32 + 12 + 24 + 12 + 4;\n    compare_outputs(&buf, Some(expected_blocks_off));\n}\n\n#[test]\nfn full_parse_chunks_in_swapped_order() {\n    // Place pakt before desc — both codes scan all chunks until 'data'.\n    let mut buf = Vec::new();\n    build_caf_header(&mut buf, 1, b\"caff\");\n    build_pakt_chunk(&mut buf, 4242);\n    let sr = [0u8; 8];\n    build_desc_chunk(&mut buf, sr, b\"ima4\", 1);\n    build_data_chunk(&mut buf, 16, &vec![0xCDu8; 16]);\n    let expected_blocks_off = 8 + 12 + 24 + 12 + 32 + 12 + 4;\n    compare_outputs(&buf, Some(expected_blocks_off));\n}\n\n#[test]\nfn full_parse_with_unknown_chunk_skipped() {\n    // Unknown chunk between header and the others: the parser must skip past\n    // it using the chunk size field.\n    let mut buf = Vec::new();\n    build_caf_header(&mut buf, 1, b\"caff\");\n\n    // Unknown chunk with 17 bytes of payload — exercise the skip-by-size path.\n    push_fourcc(&mut buf, b\"junk\");\n    let unknown_payload_size: i64 = 17;\n    push_i64_be(&mut buf, unknown_payload_size);\n    buf.extend(std::iter::repeat(0xEEu8).take(unknown_payload_size as usize));\n\n    build_desc_chunk(&mut buf, [0u8; 8], b\"ima4\", 1);\n    build_pakt_chunk(&mut buf, 7);\n    build_data_chunk(&mut buf, 5, &[0u8; 5]);\n\n    let expected_blocks_off =\n        8 // header\n        + 12 + (unknown_payload_size as usize) // unknown\n        + 12 + 32 // desc\n        + 12 + 24 // pakt\n        + 12 + 4; // data + caf_data\n    compare_outputs(&buf, Some(expected_blocks_off));\n}\n\n#[test]\nfn full_parse_sample_rate_byte_pattern_a() {\n    // Try a non-trivial sample-rate byte pattern. The C code performs a quirky\n    // float→int + byteswap + bitcast conversion; both impls must produce the\n    // same f64 bit pattern.\n    let mut buf = Vec::new();\n    build_caf_header(&mut buf, 1, b\"caff\");\n\n    // 8 bytes that represent some f64 in native (little-endian) memory layout.\n    // Using 44100.0 little-endian byte pattern.\n    let f: f64 = 44100.0;\n    let sr_bytes = f.to_le_bytes();\n    build_desc_chunk(&mut buf, sr_bytes, b\"ima4\", 1);\n    build_pakt_chunk(&mut buf, 0);\n    build_data_chunk(&mut buf, 4, &[0u8; 4]);\n    compare_outputs(&buf, None);\n}\n\n#[test]\nfn full_parse_sample_rate_byte_pattern_b() {\n    let mut buf = Vec::new();\n    build_caf_header(&mut buf, 1, b\"caff\");\n    // Negative small value.\n    let f: f64 = -1234.5;\n    let sr_bytes = f.to_le_bytes();\n    build_desc_chunk(&mut buf, sr_bytes, b\"ima4\", 1);\n    build_pakt_chunk(&mut buf, 0);\n    build_data_chunk(&mut buf, 4, &[0u8; 4]);\n    compare_outputs(&buf, None);\n}\n\n#[test]\nfn full_parse_sample_rate_byte_pattern_c() {\n    let mut buf = Vec::new();\n    build_caf_header(&mut buf, 1, b\"caff\");\n    // A small positive integer-valued double.\n    let f: f64 = 7.0;\n    let sr_bytes = f.to_le_bytes();\n    build_desc_chunk(&mut buf, sr_bytes, b\"ima4\", 1);\n    build_pakt_chunk(&mut buf, 0);\n    build_data_chunk(&mut buf, 4, &[0u8; 4]);\n    compare_outputs(&buf, None);\n}\n\n#[test]\nfn exports_match_c() {\n    // Verify the Rust .so exports `ima_parse` (the only public symbol of the\n    // C library).\n    unsafe {\n        let r_lib = Library::new(rust_lib_path()).expect(\"load Rust lib\");\n        let _: Symbol<ImaParseFn> = r_lib\n            .get(b\"ima_parse\")\n            .expect(\"Rust .so missing `ima_parse`\");\n    }\n}\n","structuredPatch":[{"oldStart":144,"oldLines":7,"newStart":144,"newLines":13,"lines":["     }"," }"," ","-// ---------- Helpers for constructing CAF-style test buffers ----------","+// ---------- Helpers for constructing in-memory CAF-style buffers ----------","+//","+// IMPORTANT: The C parser interprets the input bytes as native in-memory C","+// structs. Each field's *value* is stored in big-endian byte order, but the","+// struct layout includes natural alignment padding. In particular,","+// `caf_chunk { u32 type; i64 size; }` is 16 bytes with a 4-byte padding hole","+// between `type` and `size`, NOT 12 bytes as on-disk CAF would have it."," "," fn push_u16_be(buf: &mut Vec<u8>, v: u16) {","     buf.extend_from_slice(&v.to_be_bytes());"]},{"oldStart":158,"oldLines":22,"newStart":164,"newLines":35,"lines":[" fn push_fourcc(buf: &mut Vec<u8>, s: &[u8; 4]) {","     buf.extend_from_slice(s);"," }","+fn push_padding(buf: &mut Vec<u8>, n: usize) {","+    for _ in 0..n {","+        buf.push(0);","+    }","+}"," ","+/// caf_header: u32 type, u16 version, u16 flags. Size = 8."," fn build_caf_header(buf: &mut Vec<u8>, version: u16, magic: &[u8; 4]) {","     push_fourcc(buf, magic);","     push_u16_be(buf, version);","     push_u16_be(buf, 0); // flags"," }"," ","+/// caf_chunk header: u32 type + 4 bytes padding + i64 size. Size = 16.","+fn push_chunk_header(buf: &mut Vec<u8>, fourcc: &[u8; 4], size: i64) {","+