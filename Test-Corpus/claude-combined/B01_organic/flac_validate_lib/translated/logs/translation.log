    blocksize,\n        samplerate,\n        channels,\n        bitdepth,\n        channel_mode,\n        max_rice_value,\n        min_partition_order,\n        max_partition_order,\n        partition_order: 0,\n        _pad: [0; 3],\n        cur_blocksize: 0,\n    }\n}\n\n#[test]\nfn test_tflac_size_memory() {\n    unsafe {\n        let c = Library::new(c_lib_path()).expect(\"load c lib\");\n        let r = Library::new(rust_lib_path()).expect(\"load rust lib\");\n\n        let c_fn: Symbol<unsafe extern \"C\" fn(u32) -> u32> =\n            c.get(b\"tflac_size_memory\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(u32) -> u32> =\n            r.get(b\"tflac_size_memory\").unwrap();\n\n        let inputs = [\n            0u32, 1, 2, 4, 7, 15, 16, 17, 31, 32, 100, 256, 1024, 4096, 65535, 65536,\n            1_000_000, 0xFFFF_FFFF, 0xFFFF_FFF0, 0x1000_0000,\n        ];\n        for &v in &inputs {\n            let cv = c_fn(v);\n            let rv = r_fn(v);\n            assert_eq!(cv, rv, \"tflac_size_memory({}) c={} rust={}\", v, cv, rv);\n        }\n    }\n}\n\n#[test]\nfn test_flac_validate_basic_invalid() {\n    unsafe {\n        let c = Library::new(c_lib_path()).expect(\"load c lib\");\n        let r = Library::new(rust_lib_path()).expect(\"load rust lib\");\n\n        let c_fn: Symbol<unsafe extern \"C\" fn(*mut Tflac) -> c_int> =\n            c.get(b\"flac_validate\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(*mut Tflac) -> c_int> =\n            r.get(b\"flac_validate\").unwrap();\n\n        // Various invalid configurations\n        let cases = vec![\n            // blocksize too small\n            make_tflac(0, 44100, 2, 16, 0, 0, 0, 0),\n            make_tflac(15, 44100, 2, 16, 0, 0, 0, 0),\n            // blocksize too large\n            make_tflac(65536, 44100, 2, 16, 0, 0, 0, 0),\n            // samplerate 0\n            make_tflac(4096, 0, 2, 16, 0, 0, 0, 0),\n            // samplerate too large\n            make_tflac(4096, 655351, 2, 16, 0, 0, 0, 0),\n            // channels 0\n            make_tflac(4096, 44100, 0, 16, 0, 0, 0, 0),\n            // channels too many\n            make_tflac(4096, 44100, 9, 16, 0, 0, 0, 0),\n            // bitdepth 0\n            make_tflac(4096, 44100, 2, 0, 0, 0, 0, 0),\n            // bitdepth too large\n            make_tflac(4096, 44100, 2, 33, 0, 0, 0, 0),\n            // max_rice_value > 30\n            make_tflac(4096, 44100, 2, 16, 0, 31, 0, 0),\n            // max_partition_order > 15\n            make_tflac(4096, 44100, 2, 16, 0, 0, 0, 16),\n            // min > max partition order\n            make_tflac(4096, 44100, 2, 16, 0, 0, 5, 3),\n        ];\n\n        for mut t1 in cases {\n            let mut t2 = t1.clone();\n            let cr = c_fn(&mut t1 as *mut _);\n            let rr = r_fn(&mut t2 as *mut _);\n            assert_eq!(cr, rr, \"return mismatch: c={} rust={} t={:?}\", cr, rr, t1);\n            assert_eq!(t1, t2, \"struct mismatch after validate\");\n        }\n    }\n}\n\n#[test]\nfn test_flac_validate_valid() {\n    unsafe {\n        let c = Library::new(c_lib_path()).expect(\"load c lib\");\n        let r = Library::new(rust_lib_path()).expect(\"load rust lib\");\n\n        let c_fn: Symbol<unsafe extern \"C\" fn(*mut Tflac) -> c_int> =\n            c.get(b\"flac_validate\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(*mut Tflac) -> c_int> =\n            r.get(b\"flac_validate\").unwrap();\n\n        let cases = vec![\n            // Standard 44.1k stereo 16-bit\n            make_tflac(4096, 44100, 2, 16, 0, 0, 0, 0),\n            // With channel_mode != 0 and 2 channels, bitdepth != 32 -> should keep\n            make_tflac(4096, 44100, 2, 16, 1, 0, 0, 0),\n            make_tflac(4096, 44100, 2, 16, 2, 0, 0, 0),\n            make_tflac(4096, 44100, 2, 16, 3, 0, 0, 0),\n            // channel_mode != 0 but bitdepth=32 -> should reset to 0\n            make_tflac(4096, 44100, 2, 32, 1, 0, 0, 0),\n           