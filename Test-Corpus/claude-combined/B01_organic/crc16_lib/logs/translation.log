 inputs.push((vec![b as u8], 0x1234));\n        inputs.push((vec![b as u8], 0xFFFF));\n    }\n\n    // Lengths 1..=20 to exercise both 8-byte block path and tail loop.\n    let mut lcg: u64 = 0xDEAD_BEEF_CAFE_F00D;\n    for len in 1..=64usize {\n        let mut buf = vec![0u8; len];\n        for b in &mut buf {\n            lcg = lcg.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);\n            *b = (lcg >> 33) as u8;\n        }\n        inputs.push((buf.clone(), 0));\n        inputs.push((buf.clone(), 0xABCD));\n        inputs.push((buf, 0xFFFF));\n    }\n\n    // Larger random blocks.\n    for &len in &[100usize, 256, 1024, 4096, 7, 8, 9, 15, 16, 17] {\n        let mut buf = vec![0u8; len];\n        for b in &mut buf {\n            lcg = lcg.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);\n            *b = (lcg >> 33) as u8;\n        }\n        inputs.push((buf.clone(), 0));\n        inputs.push((buf.clone(), 0x1234));\n        inputs.push((buf, 0xFFFF));\n    }\n\n    // All-zero, all-0xFF, ascending sequences.\n    inputs.push((vec![0u8; 32], 0));\n    inputs.push((vec![0xFFu8; 32], 0));\n    inputs.push(((0u8..=255).collect(), 0));\n    inputs.push(((0u8..=255).collect(), 0xCAFE));\n\n    inputs\n}\n\n#[test]\nfn crc16_matches_c() {\n    let c_path = c_lib_path();\n    let rust_path = rust_lib_path();\n    assert!(c_path.exists(), \"C library not found at {:?}\", c_path);\n    assert!(rust_path.exists(), \"Rust library not found at {:?}\", rust_path);\n\n    unsafe {\n        let c_lib = Library::new(&c_path).expect(\"failed to load C lib\");\n        let rust_lib = Library::new(&rust_path).expect(\"failed to load Rust lib\");\n        let c_crc16 = load_crc16(&c_lib);\n        let rust_crc16 = load_crc16(&rust_lib);\n\n        for (i, (data, seed)) in run_inputs().into_iter().enumerate() {\n            let ptr = if data.is_empty() {\n                std::ptr::null()\n            } else {\n                data.as_ptr()\n            };\n            let c_out = c_crc16(ptr, data.len() as u32, seed);\n            let rust_out = rust_crc16(ptr, data.len() as u32, seed);\n            assert_eq!(\n                c_out, rust_out,\n                \"mismatch at case {}: data.len={}, seed=0x{:04x}, c=0x{:04x}, rust=0x{:04x}\",\n                i, data.len(), seed, c_out, rust_out\n            );\n        }\n    }\n}\n\n#[test]\nfn exports_match() {\n    // Sanity-check that crc16 symbol is exported from both .so files.\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).expect(\"c lib\");\n        let rust_lib = Library::new(rust_lib_path()).expect(\"rust lib\");\n        let _: Symbol<Crc16Fn> = c_lib.get(b\"crc16\\0\").expect(\"c crc16\");\n        let _: Symbol<Crc16Fn> = rust_lib.get(b\"crc16\\0\").expect(\"rust crc16\");\n    }\n}\n","structuredPatch":[{"oldStart":20,"oldLines":7,"newStart":20,"newLines":7,"lines":["     p"," }"," ","-unsafe fn load_crc16(lib: &Library) -> Symbol<Crc16Fn> {","+unsafe fn load_crc16(lib: &Library) -> Symbol<'_, Crc16Fn> {","     unsafe { lib.get::<Crc16Fn>(b\"crc16\\0\").expect(\"crc16 symbol not found\") }"," }"," "]}],"userModified":false,"replaceAll":false}}
