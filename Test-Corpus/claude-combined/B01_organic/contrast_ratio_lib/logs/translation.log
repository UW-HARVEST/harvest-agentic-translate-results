ad_contrast_ratio(&c_lib);\n        let r_fn = load_contrast_ratio(&r_lib);\n\n        let c_out = c_fn(a, b);\n        let r_out = r_fn(a, b);\n\n        // Compare bit-for-bit.\n        let cb = c_out.to_bits();\n        let rb = r_out.to_bits();\n        assert_eq!(\n            cb, rb,\n            \"Mismatch for A={:?} B={:?}: C={} ({:#x}) Rust={} ({:#x})\",\n            a, b, c_out, cb, r_out, rb\n        );\n    }\n}\n\n#[test]\nfn black_vs_white() {\n    run_case(\n        CbRgb255 { r: 0, g: 0, b: 0 },\n        CbRgb255 {\n            r: 255,\n            g: 255,\n            b: 255,\n        },\n    );\n}\n\n#[test]\nfn white_vs_black() {\n    run_case(\n        CbRgb255 {\n            r: 255,\n            g: 255,\n            b: 255,\n        },\n        CbRgb255 { r: 0, g: 0, b: 0 },\n    );\n}\n\n#[test]\nfn same_color() {\n    run_case(\n        CbRgb255 {\n            r: 128,\n            g: 128,\n            b: 128,\n        },\n        CbRgb255 {\n            r: 128,\n            g: 128,\n            b: 128,\n        },\n    );\n}\n\n#[test]\nfn primary_colors() {\n    let pairs = [\n        (\n            CbRgb255 { r: 255, g: 0, b: 0 },\n            CbRgb255 { r: 0, g: 255, b: 0 },\n        ),\n        (\n            CbRgb255 { r: 0, g: 0, b: 255 },\n            CbRgb255 { r: 255, g: 255, b: 0 },\n        ),\n        (\n            CbRgb255 {\n                r: 255,\n                g: 0,\n                b: 255,\n            },\n            CbRgb255 {\n                r: 0,\n                g: 255,\n                b: 255,\n            },\n        ),\n    ];\n    for (a, b) in pairs.iter() {\n        run_case(*a, *b);\n    }\n}\n\n#[test]\nfn near_threshold_values() {\n    // Threshold for C is R/255 > 0.04045 -> R > ~10.31. Test values right at boundary.\n    for v in 0u8..=20u8 {\n        run_case(\n            CbRgb255 { r: v, g: 0, b: 0 },\n            CbRgb255 {\n                r: 255,\n                g: 255,\n                b: 255,\n   