{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_ka3r6hmbeostwqzj3yhq5zjpbyf6qjsjz5k5xczmncivyz6xozwq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01FY4L2ZNRHeLL7eyWUQLsUe","name":"Write","input":{"file_path":"/tmp/harvest-translate-Gsl0Bm/translated_rust/tests/ffi_compare.rs","content":"use libloading::{Library, Symbol};\nuse std::path::PathBuf;\n\ntype Half2FloatFn = unsafe extern \"C\" fn(u16) -> f32;\n\nfn manifest_dir() -> PathBuf {\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n}\n\nfn c_lib_path() -> PathBuf {\n    manifest_dir().join(\"c_src\").join(\"build\").join(\"libtranslated_rust.so\")\n}\n\nfn rust_lib_path() -> PathBuf {\n    manifest_dir().join(\"target\").join(\"release\").join(\"libtranslated_rust.so\")\n}\n\nfn open_libs() -> (Library, Library) {\n    unsafe {\n        let c = Library::new(c_lib_path()).expect(\"failed to load C lib\");\n        let r = Library::new(rust_lib_path()).expect(\"failed to load Rust lib\");\n        (c, r)\n    }\n}\n\n#[test]\nfn half2float_all_inputs_match() {\n    let (c_lib, r_lib) = open_libs();\n    unsafe {\n        let c_fn: Symbol<Half2FloatFn> = c_lib.get(b\"half2float\\0\").expect(\"missing half2float in C\");\n        let r_fn: Symbol<Half2FloatFn> = r_lib.get(b\"half2float\\0\").expect(\"missing half2float in Rust\");\n\n        for h in 0u32..=0xFFFFu32 {\n            let h = h as u16;\n            let cv = c_fn(h);\n            let rv = r_fn(h);\n            // Compare bit-for-bit (handles NaN equality)\n            let cb = cv.to_bits();\n            let rb = rv.to_bits();\n            assert_eq!(\n                cb, rb,\n                \"mismatch for h=0x{:04x}: C=0x{:08x} ({}), Rust=0x{:08x} ({})\",\n                h, cb, cv, rb, rv\n            );\n        }\n    }\n}\n\n#[test]\nfn half2float_known_values() {\n    let (c_lib, r_lib) = open_libs();\n    unsafe {\n        let c_fn: Symbol<Half2FloatFn> = c_lib.get(b\"half2float\\0\").unwrap();\n        let r_fn: Symbol<Half2FloatFn> = r_lib.get(b\"half2float\\0\").unwrap();\n\n        // Sample of \"interesting\" inputs\n        let inputs: &[u16] = &[\n            0x0000, // +0\n            0x8000, // -0\n            0x3c00, // 1.0\n            0xbc00, // -1.0\n            0x7c00, // +Inf\n            0xfc00, // -Inf\n            0x7e00, // NaN (qNaN)\n            0x3555, // ~0.333...\n            0x0001, // smallest subnormal\n            0x03ff, // largest subnormal\n            0x0400, // smallest normal\n            0x7bff, // largest finite\n        ];\n\n        for &h in inputs {\n            let cv = c_fn(h).to_bits();\n            let rv = r_fn(h).to_bits();\n            assert_eq!(cv, rv, \"mismatch for h=0x{:04x}\", h);\n        }\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":163,"cache_read_input_tokens":36951,"cache_creation":{"ephemeral_5m_input_tokens":163,"ephemeral_1h_input_tokens":0},"output_tokens":22,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"e50418ba-d775-4011-971e-3c9bf0c4ee99","uuid":"3f7158a8-6e52-46e7-892b-af42c0372df6"}
