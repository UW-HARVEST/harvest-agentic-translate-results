file\n    let mut buf = Vec::new();\n    let mut f = File::open(&tmp_path).expect(\"open tmp\");\n    f.seek(SeekFrom::Start(0)).ok();\n    f.read_to_end(&mut buf).expect(\"read tmp\");\n    let _ = std::fs::remove_file(&tmp_path);\n    buf\n}\n\nextern \"C\" {\n    fn dup(oldfd: i32) -> i32;\n    fn dup2(oldfd: i32, newfd: i32) -> i32;\n    fn close(fd: i32) -> i32;\n    fn fflush(stream: *mut std::ffi::c_void) -> i32;\n}\n\nfn flush_libc_stdout() {\n    // Flush std rust stdout\n    use std::io::Write;\n    let _ = std::io::stdout().flush();\n    // Flush libc stdout (the FILE*) — pass NULL to flush all open streams\n    unsafe {\n        fflush(std::ptr::null_mut());\n    }\n}\n\ntype DriverFn = unsafe extern \"C\" fn(c_int);\n\nfn run_driver(lib_path: &str, x: c_int) -> Vec<u8> {\n    capture_stdout(|| unsafe {\n        let lib = Library::new(lib_path).expect(\"load lib\");\n        let f: Symbol<DriverFn> = lib.get(b\"driver\").expect(\"get sym driver\");\n        f(x);\n        // make sure output is flushed before lib unloads\n        flush_libc_stdout();\n    })\n}\n\n#[test]\nfn driver_zero() {\n    let c_out = run_driver(C_LIB, 0);\n    let r_out = run_driver(RUST_LIB, 0);\n    assert_eq!(c_out, r_out, \"driver(0): C={:?} Rust={:?}\", c_out, r_out);\n}\n\n#[test]\nfn driver_one() {\n    let c_out = run_driver(C_LIB, 1);\n    let r_out = run_driver(RUST_LIB, 1);\n    assert_eq!(c_out, r_out);\n}\n\n#[test]\nfn driver_negative_one() {\n    let c_out = run_driver(C_LIB, -1);\n    let r_out = run_driver(RUST_LIB, -1);\n    assert_eq!(c_out, r_out);\n}\n\n#[test]\nfn driver_int_max() {\n    let c_out = run_driver(C_LIB, c_int::MAX);\n    let r_out = run_driver(RUST_LIB, c_int::MAX);\n    assert_eq!(c_out, r_out);\n}\n\n#[test]\nfn driver_int_min() {\n    let c_out = run_driver(C_LIB, c_int::MIN);\n    let r_out = run_driver(RUST_LIB, c_int::MIN);\n    assert_eq!(c_out, r_out);\n}\n\n#[test]\nfn driver_various() {\n    for &x in &[0, 1, -1, 42, 0x12345678, -42, 