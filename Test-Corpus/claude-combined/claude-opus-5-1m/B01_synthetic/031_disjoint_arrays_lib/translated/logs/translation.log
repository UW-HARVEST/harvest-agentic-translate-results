   len: c_int,\n);\ntype CallFmaFn = unsafe extern \"C\" fn(data: *const c_int, len: c_int) -> c_int;\ntype DriverFn = unsafe extern \"C\" fn(input: *const c_char);\n\nfn load_libs() -> (Library, Library) {\n    unsafe {\n        let c = Library::new(C_LIB_PATH).expect(\"load C lib\");\n        let r = Library::new(RUST_LIB_PATH).expect(\"load Rust lib\");\n        (c, r)\n    }\n}\n\nfn run_fma_array(lib: &Library, mul1: &[c_int], mul2: &[c_int], add: &[c_int]) -> Vec<c_int> {\n    assert_eq!(mul1.len(), mul2.len());\n    assert_eq!(mul1.len(), add.len());\n    let len = mul1.len();\n    let mut out = vec![0i32; len];\n    unsafe {\n        let f: Symbol<FmaArrayFn> = lib.get(b\"fma_array\").expect(\"fma_array\");\n        f(\n            out.as_mut_ptr(),\n            mul1.as_ptr(),\n            mul2.as_ptr(),\n            add.as_ptr(),\n            len as c_int,\n        );\n    }\n    out\n}\n\nfn run_call_fma(lib: &Library, data: &[c_int]) -> c_int {\n    unsafe {\n        let f: Symbol<CallFmaFn> = lib.get(b\"call_fma\").expect(\"call_fma\");\n        f(data.as_ptr(), data.len() as c_int)\n    }\n}\n\n/// Captures stdout written by the called function (including printf via libc).\nfn capture_driver(lib: &Library, input: &str) -> Vec<u8> {\n    // Flush libc stdout from any previous run\n    unsafe {\n        // open libc to flush stdout\n        extern \"C\" {\n            fn fflush(stream: *mut std::ffi::c_void) -> c_int;\n        }\n        fflush(std::ptr::null_mut());\n    }\n\n    // Create temp file for capture\n    let path = std::env::temp_dir().join(format!(\n        \"driver_capture_{}_{}.txt\",\n        std::process::id(),\n        rand_id()\n    ));\n    let file = File::options()\n        .read(true)\n        .write(true)\n        .create(true)\n        .truncate(true)\n        .open(&path)\n        .expect(\"create temp file\");\n\n    // Save original stdout\n    let stdout_fd = 1;\n    let saved = unsafe { libc_dup(stdout_fd) };\n    assert!(saved >= 0, \"dup failed\");\n\n    // Redirect stdout fd to our temp file\n    let new_fd = file.as_raw_fd();\n    let r = unsafe { libc_dup2(new_fd, stdout_fd) };\n    assert!(r >= 0, \"dup2 failed\");\n\n    let cinput = CString::new(input).unwrap();\n    unsafe {\n        let f: Symbol<DriverFn> = lib.get(b\"driver\").expect(\"driver\");\n        f(cinput.as_ptr());\n        // Flush libc stdout to file\n        extern \"C\" {\n            fn fflush(stream: *mut std::ffi::c_void) -> c_int;\n        }\n        fflush(std::ptr::null_mut());\n    }\n\n    // Restore stdout\n    unsafe {\n        libc_dup2(saved, stdout_fd);\n        libc_close(saved);\n    }\n\n    // Read captured contents\n    let mut file = File::open(&path).expect(\"reopen capture\");\n    let _ = file.seek(SeekFrom::Start(0));\n    let mut buf = Vec::new();\n    file.read_to_end(&mut buf).expect(\"read capture\");\n    let _ = std::fs::remove_file(&path);\n    buf\n}\n\nfn rand_id() -> u64 {\n    use std::time::{SystemTime, UNIX_EPOCH};\n    SystemTime::now()\n        .duration_since(UNIX_EPOCH)\n        .unwrap()\n        .as_nanos() as u64\n}\n\nunsafe fn libc_dup(fd: c_int) -> c_int {\n    extern \"C\" {\n        fn dup(oldfd: c_int) -> c_int;\n    }\n    dup(fd)\n}\nunsafe fn libc_dup2(oldfd: c_int, newfd: c_int) -> c_int {\n    extern \"C\" {\n        fn dup2(oldfd: c_int, newfd: c_int) -> c_int;\n    }\n    dup2(oldfd, newfd)\n}\nunsafe fn libc_close(fd: c_int) -> c_int {\n    extern \"C\" {\n        fn close(fd: c_int) -> c_int;\n    }\n    close(fd)\n}\n\n#[test]\nfn test_fma_array_basic() {\n    let (c, r) = load_libs();\n    let mul1 = vec![1, 2, 3, 4, 5];\n    let mul2 = vec![10, 20, 30, 40, 50];\n    let add = vec![100, 200, 300, 400, 500];\n    let c_out = run_fma_array(&c, &mul1, &mul2, &add);\n    let r_out = run_fma_array(&r, &mul1, &mul2, &add);\n    assert_eq!(c_out, r_out);\n}\n\n#[test]\nfn test_fma_array_negatives() {\n    let (c, r) = load_libs();\n    let mul1 = vec![-1, -2, -3];\n    let mul2 = vec![5, -7, 9];\n    let add = vec![0, 1, -1];\n    let c_out = run_fma_array(&c, &mul1, &mul2, &add);\n    let r_out = run_fma_array(&r, &mul1, &mul2, &add);\n    assert_eq!(c_out, r_out);\n}\n\n#[test]\nfn test_fma_array_zero_len() {\n    let (c, r) = load_libs();\n    let mul1: Vec<c_int> = vec![];\n    let mul2: Vec<c_int> = vec![];\n    let add: Vec<c_int> = vec![];\n    let c_out = run_fma_array(&c, &mul1, &mul2, &add);\n    let r_out = run_fma_array(&r, &mul1, &mul2, &add);\n    assert_eq!(c_out, r_out);\n}\n\n#[test]\nfn test_call_fma_empty() {\n    let (c, r) = load_libs();\n    let data: Vec<c_int> = vec![];\n    assert_eq!(run_call_fma(&c, &data), run_call_fma(&r, &data));\n}\n\n#[test]\nfn test_call_fma_single() {\n    let (c, r) = load_libs();\n    let data = vec![42];\n    assert_eq!(run_call_fma(&c, &data), run_call_fma(&r, &data));\n}\n\n#[test]\nfn test_call_fma_many() {\n    let (c, r) = load_libs();\n    let data = vec![1, 2, 3, 4, 5, 6, 7];\n    assert_eq!(run_call_fma(&c, &data), run_call_fma(&r, &data));\n}\n\n#[test]\nfn test_call_fma_negatives() {\n    let (c, r) = load_libs();\n    let data = vec![-3, -7, 0, 99, -42];\n    assert_eq!(run_call_fma(&c, &data), run_call_fma(&r, &data));\n}\n\n#[test]\nfn test_driver_basic() {\n    let (c, r) = load_libs();\n    let inputs = [\n        \"1 2 3 4 5\",\n        \"\",\n        \"42\",\n        \"10 20 30\",\n        \"-1 -2 -3 -4\",\n        \"100 200 300 400 500 600 700\",\n        \"  5   6  7  \",\n        \"1\\n2\\n3\\n4\\n5\",\n        \"0\",\n        \"abc\",\n        \"1 abc 2\",\n        \"999999\",\n    ];\n    for input in &inputs {\n        let c_out = capture_driver(&c, input);\n        let r_out = capture_driver(&r, input);\n        assert_eq!(\n            c_out, r_out,\n            \"mismatch for input {:?}: C={:?} Rust={:?}\",\n            input,\n            String::from_utf8_lossy(&c_out),\n            String::from_utf8_lossy(&r_out)\n        );\n    }\n}\n\n#[test]\nfn test_driver_long_input() {\n    let (c, r) = load_libs();\n    // 100+ numbers - the C code only reads up to 100\n    let mut input = String::new();\n    for i in 0..150 {\n        input.push_str(&format!(\"{} \", i));\n    }\n    let c_out = capture_driver(&c, &input);\n    let r_out = capture_driver(&r, &input);\n    assert_eq!(c_out, r_out);\n}\n","userModified":false}}
