duration_since(UNIX_EPOCH)\n        .unwrap()\n        .as_nanos() as u64\n}\n\n#[test]\nfn test_fma_array_basic() {\n    let (c, r) = load_libs();\n    let mul1 = vec![1, 2, 3, 4, 5];\n    let mul2 = vec![10, 20, 30, 40, 50];\n    let add = vec![100, 200, 300, 400, 500];\n    let c_out = run_fma_array(&c, &mul1, &mul2, &add);\n    let r_out = run_fma_array(&r, &mul1, &mul2, &add);\n    assert_eq!(c_out, r_out);\n}\n\n#[test]\nfn test_fma_array_negatives() {\n    let (c, r) = load_libs();\n    let mul1 = vec![-1, -2, -3];\n    let mul2 = vec![5, -7, 9];\n    let add = vec![0, 1, -1];\n    let c_out = run_fma_array(&c, &mul1, &mul2, &add);\n    let r_out = run_fma_array(&r, &mul1, &mul2, &add);\n    assert_eq!(c_out, r_out);\n}\n\n#[test]\nfn test_fma_array_zero_len() {\n    let (c, r) = load_libs();\n    let mul1: Vec<c_int> = vec![];\n    let mul2: Vec<c_int> = vec![];\n    let add: Vec<c_int> = vec![];\n    let c_out = run_fma_array(&c, &mul1, &mul2, &add);\n    let r_out = run_fma_array(&r, &mul1, &mul2, &add);\n    assert_eq!(c_out, r_out);\n}\n\n#[test]\nfn test_call_fma_empty() {\n    let (c, r) = load_libs();\n    let data: Vec<c_int> = vec![];\n    assert_eq!(run_call_fma(&c, &data), run_call_fma(&r, &data));\n}\n\n#[test]\nfn test_call_fma_single() {\n    let (c, r) = load_libs();\n    let data = vec![42];\n    assert_eq!(run_call_fma(&c, &data), run_call_fma(&r, &data));\n}\n\n#[test]\nfn test_call_fma_many() {\n    let (c, r) = load_libs();\n    let data = vec![1, 2, 3, 4, 5, 6, 7];\n    assert_eq!(run_call_fma(&c, &data), run_call_fma(&r, &data));\n}\n\n#[test]\nfn test_call_fma_negatives() {\n    let (c, r) = load_libs();\n    let data = vec![-3, -7, 0, 99, -42];\n    assert_eq!(run_call_fma(&c, &data), run_call_fma(&r, &data));\n}\n\n#[test]\nfn test_driver_basic() {\n    let (c, r) = load_libs();\n    let inputs = [\n        \"1 2 3 4 5\",\n        \"\",\n        \"42\",\n        \"10 20 30\",\n        \"-1 -2 -3 -4\",\n        \"100 200 300 400 500 600 700\",\n        \"  5   6  7  \",\n        \"1\\n2\\n3\\n4\\n5\",\n        \"0\",\n        \"abc\",\n        \"1 abc 2\",\n        \"999999\",\n    ];\n    for input in &inputs {\n        let c_out = capture_driver(&c, input);\n        let r_out = capture_driver(&r, input);\n        assert_eq!(\n            c_out, r_out,\n            \"mismatch for input {:?}: C={:?} Rust={:?}\",\n            input,\n            String::from_utf8_lossy(&c_out),\n            String::from_utf8_lossy(&r_out)\n        );\n    }\n}\n\n#[test]\nfn test_driver_long_input() {\n    let (c, r) = load_libs();\n    // 100+ numbers - the C code only reads up to 100\n    let mut input = String::new();\n    for i in 0..150 {\n        input.push_str(&format!(\"{} \", i));\n    }\n    let c_out = capture_driver(&c, &input);\n    let r_out = capture_driver(&r, &input);\n    assert_eq!(c_out, r_out);\n}\n","structuredPatch":[{"oldStart":7,"oldLines":6,"newStart":7,"newLines":13,"lines":[" const C_LIB_PATH: &str = \"c_src/build/libdriver.so\";"," const RUST_LIB_PATH: &str = \"target/release/libdriver.so\";"," ","+unsafe extern \"C\" {","+    fn fflush(stream: *mut std::ffi::c_void) -> c_int;","+    fn dup(oldfd: c_int) -> c_int;","+    fn dup2(oldfd: c_int, newfd: c_int) -> c_int;","+    fn close(fd: c_int) -> c_int;","+}","+"," type FmaArrayFn = unsafe extern \"C\" fn(","     out: *mut c_int,","     mul1: *const c_int,"]},{"oldStart":54,"oldLines":10,"newStart":61,"newLines":6,"lines":[" fn capture_driver(lib: &Library, input: &str) -> Vec<u8> {","     // Flush libc stdout from any previous run","     unsafe {","-        // open libc to flush stdout","-        extern \"C\" {","-            fn fflush(stream: *mut std::ffi::c_void) -> c_int;","-        }","         fflush(std::ptr::null_mut());","     }"," "]},{"oldStart":77,"oldLines":29,"newStart":80,"newLines":25,"lines":[" ","     // Save original stdout","     let stdout_fd = 1;","-    let saved = unsafe { libc_dup(stdout_fd) };","+    let saved