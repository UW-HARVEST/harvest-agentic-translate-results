rintLine(line: *const c_char) {\n    if !line.is_null() {\n        unsafe {\n            // Match C: printf(\"%s\\n\", line);\n            let fmt = b\"%s\\n\\0\".as_ptr() as *const c_char;\n            printf(fmt, line);\n        }\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn bad() {\n    // Reproduce the C undefined behavior: declare a local pointer and use it\n    // without initialization. The C code does:\n    //     char *data;\n    //     printLine(data);\n    let data: *const c_char = unsafe { MaybeUninit::uninit().assume_init() };\n    printLine(data);\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn good() {\n    let data: *const c_char = b\"string\\0\".as_ptr() as *const c_char;\n    printLine(data);\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn driver(use_good: c_int) {\n    if use_good != 0 {\n        good();\n    } else {\n        bad();\n    }\n}\n","structuredPatch":[{"oldStart":34,"oldLines":6,"newStart":34,"newLines":7,"lines":["     // without initialization. The C code does:","     //     char *data;","     //     printLine(data);","+    #[allow(invalid_value)]","     let data: *const c_char = unsafe { MaybeUninit::uninit().assume_init() };","     printLine(data);"," }"]}],"userModified":false,"replaceAll":false}}
