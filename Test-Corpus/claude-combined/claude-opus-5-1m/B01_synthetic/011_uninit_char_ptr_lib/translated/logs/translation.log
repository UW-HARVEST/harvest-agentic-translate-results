{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_tgi3sopn326267cis2jk25pc7urw6omjs27gwiqvtqt4yijdaaka","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01HAywU3pKnCtYLHqWAkkxmX","name":"Write","input":{"file_path":"/tmp/harvest-translate-C4sovG/translated_rust/tests/ffi_compare.rs","content":"// Integration tests that compare the Rust .so against the C .so via libloading.\n// We run both libraries through their C ABI exports, capturing stdout, and\n// assert the deterministic outputs match byte-for-byte.\n\nuse libloading::{Library, Symbol};\nuse std::ffi::CString;\nuse std::fs::File;\nuse std::io::{Read, Seek, SeekFrom};\nuse std::os::raw::{c_char, c_int};\nuse std::os::unix::io::AsRawFd;\nuse std::sync::Mutex;\n\n// libc bindings we need for stdout capture.\nextern \"C\" {\n    fn dup(oldfd: c_int) -> c_int;\n    fn dup2(oldfd: c_int, newfd: c_int) -> c_int;\n    fn close(fd: c_int) -> c_int;\n    fn fflush(stream: *mut std::ffi::c_void) -> c_int;\n}\n\n// stdout capture must be serialized; tests run in parallel by default.\nstatic CAPTURE_LOCK: Mutex<()> = Mutex::new(());\n\nconst STDOUT_FD: c_int = 1;\n\n/// Run `f` and capture everything written to stdout (fd 1) during it.\n/// Returns the captured bytes. Note: this changes the global stdout fd\n/// for the duration of `f`, which is why CAPTURE_LOCK must be held.\nfn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {\n    let _guard = CAPTURE_LOCK.lock().unwrap_or_else(|e| e.into_inner());\n\n    // Make sure any pending stdout is flushed before we redirect.\n    unsafe { fflush(std::ptr::null_mut()) };\n\n    // Create a temp file to redirect stdout into.\n    let tmp = tempfile();\n    let tmp_fd = tmp.as_raw_fd();\n\n    // Save original stdout fd.\n    let saved = unsafe { dup(STDOUT_FD) };\n    assert!(saved >= 0, \"dup failed\");\n\n    // Redirect stdout (fd 1) to the temp file.\n    let rc = unsafe { dup2(tmp_fd, STDOUT_FD) };\n    assert!(rc >= 0, \"dup2 failed\");\n\n    // Run the closure.\n    f();\n\n    // Flush any buffered stdout written by the C library through stdio.\n    unsafe { fflush(std::ptr::null_mut()) };\n\n    // Restore stdout.\n    let rc = unsafe { dup2(saved, STDOUT_FD) };\n    assert!(rc >= 0, \"dup2 restore failed\");\n    unsafe { close(saved) };\n\n    // Read what was captured.\n    let mut tmp = tmp;\n    tmp.seek(SeekFrom::Start(0)).unwrap();\n    let mut buf = Vec::new();\n    tmp.read_to_end(&mut buf).unwrap();\n    buf\n}\n\nfn tempfile() -> File {\n    // Use a uniquely-named file in /tmp; we never expose the path.\n    use std::sync::atomic::{AtomicU64, Ordering};\n    static COUNTER: AtomicU64 = AtomicU64::new(0);\n    let n = COUNTER.fetch_add(1, Ordering::SeqCst);\n    let path = format!(\n        \"/tmp/driver_ffi_capture_{}_{}.tmp\",\n        std::process::id(),\n        n\n    );\n    let f = File::options()\n        .read(true)\n        .write(true)\n        .create(true)\n        .truncate(true)\n        .open(&path)\n        .expect(\"failed to create tempfile\");\n    // unlink so the file is reaped when closed.\n    let cpath = CString::new(path).unwrap();\n    unsafe {\n        libc_unlink(cpath.as_ptr());\n    }\n    f\n}\n\nextern \"C\" {\n    #[link_name = \"unlink\"]\n    fn libc_unlink(path: *const c_char) -> c_int;\n}\n\nfn c_lib_path() -> String {\n    let manifest = env!(\"CARGO_MANIFEST_DIR\");\n    format!(\"{}/c_src/build/libdriver.so\", manifest)\n}\n\nfn rust_lib_path() -> String {\n    // Cargo sets CARGO_MANIFEST_DIR; we built with --release earlier but tests\n    // may use whichever profile. Try release first, fall back to debug.\n    let manifest = env!(\"CARGO_MANIFEST_DIR\");\n    let release = format!(\"{}/target/release/libdriver.so\", manifest);\n    let debug = format!(\"{}/target/debug/libdriver.so\", manifest);\n    if std::path::Path::new(&release).exists() {\n        release\n    } else {\n        debug\n    }\n}\n\nunsafe fn load(path: &str) -> Library {\n    Library::new(path).unwrap_or_else(|e| panic!(\"failed to load {}: {}\", path, e))\n}\n\n#[test]\nfn printline_null_matches() {\n    unsafe {\n        let c = load(&c_lib_path());\n        let r = load(&rust_lib_path());\n\n        let c_print: Symbol<unsafe extern \"C\" fn(*const c_char)> =\n            c.get(b\"printLine\").unwrap();\n        let r_print: Symbol<unsafe extern \"C\" fn(*const c_char)> =\n            r.get(b\"printLine\").unwrap();\n\n        let c_out = capture_stdout(|| c_print(std::ptr::null()));\n        let r_out = capture_stdout(|| r_print(std::ptr::null()));\n\n        assert_eq!(c_out, r_out, \"printLine(NULL) outputs differ\");\n        assert!(c_out.is_empty(), \"printLine(NULL) should print nothing\");\n    }\n}\n\n#[test]\nfn printline_strings_match() {\n    let cases: &[&[u8]] = &[\n        b\"hello\\0\",\n        b\"\\0\",                      // empty string\n        b\"line with spaces\\0\",\n        b\"unicode: \\xc3\\xa9\\xc3\\xa0\\0\", // é à in UTF-8\n        b\"with\\ttab\\0\",\n    ];\n\n    unsafe {\n        let c = load(&c_lib_path());\n        let r = load(&rust_lib_path());\n\n        let c_print: Symbol<unsafe extern \"C\" fn(*const c_char)> =\n            c.get(b\"printLine\").unwrap();\n        let r_print: Symbol<unsafe extern \"C\" fn(*const c_char)> =\n            r.get(b\"printLine\").unwrap();\n\n        for case in cases {\n            let p = case.as_ptr() as *const c_char;\n            let c_out = capture_stdout(|| c_print(p));\n            let r_out = capture_stdout(|| r_print(p));\n            assert_eq!(\n                c_out, r_out,\n                \"printLine differs for input {:?}\",\n                case\n            );\n        }\n    }\n}\n\n#[test]\nfn good_matches() {\n    unsafe {\n        let c = load(&c_lib_path());\n        let r = load(&rust_lib_path());\n\n        let c_good: Symbol<unsafe extern \"C\" fn()> = c.get(b\"good\").unwrap();\n        let r_good: Symbol<unsafe extern \"C\" fn()> = r.get(b\"good\").unwrap();\n\n        let c_out = capture_stdout(|| c_good());\n        let r_out = capture_stdout(|| r_good());\n\n        assert_eq!(c_out, r_out, \"good() outputs differ\");\n        assert_eq!(c_out, b\"string\\n\", \"good() should print 'string\\\\n'\");\n    }\n}\n\n#[test]\nfn driver_use_good_matches() {\n    unsafe {\n        let c = load(&c_lib_path());\n        let r = load(&rust_lib_path());\n\n        let c_drv: Symbol<unsafe extern \"C\" fn(c_int)> = c.get(b\"driver\").unwrap();\n        let r_drv: Symbol<unsafe extern \"C\" fn(c_int)> = r.get(b\"driver\").unwrap();\n\n        // Various non-zero values should all behave the same.\n        for &v in &[1, 2, -1, i32::MAX, i32::MIN] {\n            let c_out = capture_stdout(|| c_drv(v));\n            let r_out = capture_stdout(|| r_drv(v));\n            assert_eq!(c_out, r_out, \"driver({}) outputs differ\", v);\n            assert_eq!(c_out, b\"string\\n\", \"driver({}) should match good()\", v);\n        }\n    }\n}\n\n// driver(0) calls bad(), which uses an uninitialized pointer (UB in C).\n// We can't byte-compare those outputs because they depend on whatever happens\n// to be on the stack. We just verify the symbol exists and is callable\n// without comparing output.\n#[test]\nfn bad_and_driver_zero_are_callable() {\n    unsafe {\n        let c = load(&c_lib_path());\n        let r = load(&rust_lib_path());\n\n        let _: Symbol<unsafe extern \"C\" fn()> = c.get(b\"bad\").unwrap();\n        let _: Symbol<unsafe extern \"C\" fn()> = r.get(b\"bad\").unwrap();\n        let _: Symbol<unsafe extern \"C\" fn(c_int)> = c.get(b\"driver\").unwrap();\n        let _: Symbol<unsafe extern \"C\" fn(c_int)> = r.get(b\"driver\").unwrap();\n    }\n}\n\n#[test]\nfn rust_so_exports_all_c_symbols() {\n    // Every function-text symbol in the C .so (excluding _init/_fini and\n    // implementation details) must be present in the Rust .so.\n    unsafe {\n        let _c = load(&c_lib_path());\n        let r = load(&rust_lib_path());\n\n        for sym in [\n            b\"printLine\".as_slice(),\n            b\"bad\".as_slice(),\n            b\"good\".as_slice(),\n            b\"driver\".as_slice(),\n        ] {\n            let res: Result<Symbol<unsafe extern \"C\" fn()>, _> = r.get(sym);\n            assert!(\n                res.is_ok(),\n                \"Rust .so missing exported symbol: {}\",\n                std::str::from_utf8(sym).unwrap()\n            );\n        }\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":188,"cache_read_input_tokens":24646,"cache_creation":{"ephemeral_5m_input_tokens":188,"ephemeral_1h_input_tokens":0},"output_tokens":40,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"c25d50c0-33be-4a20-905f-0b02fca080ee","uuid":"0b61590e-6f9b-412c-88aa-48c1a3d07b9a"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01HAywU3pKnCtYLHqWAkkxmX","type":"tool_result","content":"File created successfully at: /tmp/harvest-translate-C4sovG/translated_rust/tests/ffi_compare.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"c25d50c0-33be-4a20-905f-0b02fca080ee","uuid":"cc9c89c2-975a-443d-a33f-63956e19cb6b","timestamp":"2026-05-29T23:39:09.837Z","tool_use_result":{"type":"create","filePath":"/tmp/harvest-translate-C4sovG/translated_rust/tests/ffi_compare.rs","content":"// Integration tests that compare the Rust .so against the C .so via libloading.\n// We run both libraries through their C ABI exports, capturing stdout, and\n// assert the deterministic outputs match byte-for-byte.\n\nuse libloading::{Library, Symbol};\nuse std::ffi::CString;\nuse std::fs::File;\nuse std::io::{Read, Seek, SeekFrom};\nuse std::os::raw::{c_char, c_int};\nuse std::os::unix::io::AsRawFd;\nuse std::sync::Mutex;\n\n// libc bindings we need for stdout capture.\nextern \"C\" {\n    fn dup(oldfd: c_int) -> c_int;\n    fn dup2(oldfd: c_int, newfd: c_int) -> c_int;\n    fn close(fd: c_int) -> c_int;\n    fn fflush(stream: *mut std::ffi::c_void) -> c_int;\n}\n\n// stdout capture must be serialized; tests run in parallel by default.\nstatic CAPTURE_LOCK: Mutex<()> = Mutex::new(());\n\nconst STDOUT_FD: c_int = 1;\n\n/// Run `f` and capture everything written to stdout (fd 1) during it.\n/// Returns the captured bytes. Note: this changes the global stdout fd\n/// for the duration of `f`, which is why CAPTURE_LOCK must be held.\nfn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {\n    let _guard = CAPTURE_LOCK.lock().unwrap_or_else(|e| e.into_inner());\n\n    // Make sure any pending stdout is flushed before we redirect.\n    unsafe { fflush(std::ptr::null_mut()) };\n\n    // Create a temp file to redirect stdout into.\n    let tmp = tempfile();\n    let tmp_fd = tmp.as_raw_fd();\n\n    // Save original stdout fd.\n    let saved = unsafe { dup(STDOUT_FD) };\n    assert!(saved >= 0, \"dup failed\");\n\n    // Redirect stdout (fd 1) to the temp file.\n    let rc = unsafe { dup2(tmp_fd, STDOUT_FD) };\n    assert!(rc >= 0, \"dup2 failed\");\n\n    // Run the closure.\n    f();\n\n    // Flush any buffered stdout written by the C library through stdio.\n    unsafe { fflush(std::ptr::null_mut()) };\n\n    // Restore stdout.\n    let rc = unsafe { dup2(saved, STDOUT_FD) };\n    assert!(rc >= 0, \"dup2 restore failed\");\n    unsafe { close(saved) };\n\n    // Read what was captured.\n    let mut tmp = tmp;\n    tmp.seek(SeekFrom::Start(0)).unwrap();\n    let mut buf = Vec::new();\n    tmp.read_to_end(&mut buf).unwrap();\n    buf\n}\n\nfn tempfile() -> File {\n    // Use a uniquely-named file in /tmp; we never expose the path.\n    use std::sync::atomic::{AtomicU64, Ordering};\n    static COUNTER: AtomicU64 = AtomicU64::new(0);\n    let n = COUNTER.fetch_add(1, Ordering::SeqCst);\n    let path = format!(\n        \"/tmp/driver_ffi_capture_{}_{}.tmp\",\n        std::process::id(),\n        n\n    );\n    let f = File::options()\n        .read(true)\n        .write(true)\n        .create(true)\n        .truncate(true)\n        .open(&path)\n        .expect(\"failed to create tempfile\");\n    // unlink so the file is reaped when closed.\n    let cpath = CString::new(path).unwrap();\n    unsafe {\n        libc_unlink(cpath.as_ptr());\n    }\n    f\n}\n\nextern \"C\" {\n    #[link_name = \"unlink\"]\n    fn libc_unlink(path: *const c_char) -> c_int;\n}\n\nfn c_lib_path() -> String {\n    let manifest = env!(\"CARGO_MANIFEST_DIR\");\n    format!(\"{}/c_src/build/libdriver.so\", manifest)\n}\n\nfn rust_lib_path() -> String {\n    // Cargo sets CARGO_MANIFEST_DIR; we built with --release earlier but tests\n    // may use whichever profile. Try release first, fall back to debug.\n    let manifest = env!(\"CARGO_MANIFEST_DIR\");\n    let release = format!(\"{}/target/release/libdriver.so\", manifest);\n    let debug = format!(\"{}/target/debug/libdriver.so\", manifest);\n    if std::path::Path::new(&release).exists() {\n        release\n    } else {\n        debug\n    }\n}\n\nunsafe fn load(path: &str) -> Library {\n    Library::new(path).unwrap_or_else(|e| panic!(\"failed to load {}: {}\", path, e))\n}\n\n#[test]\nfn printline_null_matches() {\n    unsafe {\n        let c = load(&c_lib_path());\n        let r = load(&rust_lib_path());\n\n        let c_print: Symbol<unsafe extern \"C\" fn(*const c_char)> =\n            c.get(b\"printLine\").unwrap();\n        let r_print: Symbol<unsafe extern \"C\" fn(*const c_char)> =\n            r.get(b\"printLine\").unwrap();\n\n        let c_out = capture_stdout(|| c_print(std::ptr::null()));\n        let r_out = capture_stdout(|| r_print(std::ptr::null()));\n\n        assert_eq!(c_out, r_out, \"printLine(NULL) outputs differ\");\n        assert!(c_out.is_empty(), \"printLine(NULL) should print nothing\");\n    }\n}\n\n#[test]\nfn printline_strings_match() {\n    let cases: &[&[u8]] = &[\n        b\"hello\\0\",\n        b\"\\0\",                      // empty string\n        b\"line with spaces\\0\",\n        b\"unicode: \\xc3\\xa9\\xc3\\xa0\\0\", // é à in UTF-8\n        b\"with\\ttab\\0\",\n    ];\n\n    unsafe {\n        let c = load(&c_lib_path());\n        let r = load(&rust_lib_path());\n\n        let c_print: Symbol<unsafe extern \"C\" fn(*const c_char)> =\n            c.get(b\"printLine\").unwrap();\n        let r_print: Symbol<unsafe extern \"C\" fn(*const c_char)> =\n            r.get(b\"printLine\").unwrap();\n\n        for case in cases {\n            let p = case.as_ptr() as *const c_char;\n            let c_out = capture_stdout(|| c_print(p));\n            let r_out = capture_stdout(|| r_print(p));\n            assert_eq!(\n                c_out, r_out,\n                \"printLine differs for input {:?}\",\n                case\n            );\n        }\n    }\n}\n\n#[test]\nfn good_matches() {\n    unsafe {\n        let c = load(&c_lib_path());\n        let r = load(&rust_lib_path());\n\n        let c_good: Symbol<unsafe extern \"C\" fn()> = c.get(b\"good\").unwrap();\n        let r_good: Symbol<unsafe extern \"C\" fn()> = r.get(b\"good\").unwrap();\n\n        let c_out = capture_stdout(|| c_good());\n        let r_out = capture_stdout(|| r_good());\n\n        assert_eq!(c_out, r_out, \"good() outputs differ\");\n        assert_eq!(c_out, b\"string\\n\", \"good() should print 'string\\\\n'\");\n    }\n}\n\n#[test]\nfn driver_use_good_matches() {\n    unsafe {\n        let c = load(&c_lib_path());\n        let r = load(&rust_lib_path());\n\n        let c_drv: Symbol<unsafe extern \"C\" fn(c_int)> = c.get(b\"driver\").unwrap();\n        let r_drv: Symbol<unsafe extern \"C\" fn(c_int)> = r.get(b\"driver\").unwrap();\n\n        // Various non-zero values should all behave the same.\n        for &v in &[1, 2, -1, i32::MAX, i32::MIN] {\n            let c_out = capture_stdout(|| c_drv(v));\n            let r_out = capture_stdout(|| r_drv(v));\n            assert_eq!(c_out, r_out, \"driver({}) outputs differ\", v);\n            assert_eq!(c_out, b\"string\\n\", \"driver({}) should match good()\", v);\n        }\n    }\n}\n\n// driver(0) calls bad(), which uses an uninitialized pointer (UB in C).\n// We can't byte-compare those outputs because they depend on whatever happens\n// to be on the stack. We just verify the symbol exists and is callable\n// without comparing output.\n#[test]\nfn bad_and_driver_zero_are_callable() {\n    unsafe {\n        let c = load(&c_lib_path());\n        let r = load(&rust_lib_path());\n\n        let _: Symbol<unsafe extern \"C\" fn()> = c.get(b\"bad\").unwrap();\n        let _: Symbol<unsafe extern \"C\" fn()> = r.get(b\"bad\").unwrap();\n        let _: Symbol<unsafe extern \"C\" fn(c_int)> = c.get(b\"driver\").unwrap();\n        let _: Symbol<unsafe extern \"C\" fn(c_int)> = r.get(b\"driver\").unwrap();\n    }\n}\n\n#[test]\nfn rust_so_exports_all_c_symbols() {\n    // Every function-text symbol in the C .so (excluding _init/_fini and\n    // implementation details) must be present in the Rust .so.\n    unsafe {\n        let _c = load(&c_lib_path());\n        let r = load(&rust_lib_path());\n\n        for sym in [\n            b\"printLine\".as_slice(),\n            b\"bad\".as_slice(),\n            b\"good\".as_slice(),\n            b\"driver\".as_slice(),\n        ] {\n            let res: Result<Symbol<unsafe extern \"C\" fn()>, _> = r.get(sym);\n            assert!(\n                res.is_ok(),\n                \"Rust .so missing exported symbol: {}\",\n                std::str::from_utf8(sym).unwrap()\n            );\n        }\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
