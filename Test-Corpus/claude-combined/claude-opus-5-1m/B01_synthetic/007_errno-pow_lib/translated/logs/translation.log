{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_3osxajx3jhnrnfnln6oce36o3lepwzopknpmfgrrq4ci7krpdo5a","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_011PvZ3hjhMseqnuoGuJuXbG","name":"Write","input":{"file_path":"/tmp/harvest-translate-hJhqZH/translated_rust/tests/ffi_compare.rs","content":"use libloading::{Library, Symbol};\nuse std::path::PathBuf;\n\ntype MyPowFn = unsafe extern \"C\" fn(f64, f64) -> f64;\n\nfn c_lib_path() -> PathBuf {\n    let manifest_dir = env!(\"CARGO_MANIFEST_DIR\");\n    PathBuf::from(manifest_dir).join(\"c_src/build/libpow.so\")\n}\n\nfn rust_lib_path() -> PathBuf {\n    let manifest_dir = env!(\"CARGO_MANIFEST_DIR\");\n    // Use release build by default; fall back to debug if needed.\n    let release = PathBuf::from(manifest_dir).join(\"target/release/libpow.so\");\n    if release.exists() {\n        return release;\n    }\n    PathBuf::from(manifest_dir).join(\"target/debug/libpow.so\")\n}\n\nfn run_pair(base: f64, exponent: f64) -> (f64, f64) {\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).expect(\"loading C lib\");\n        let rs_lib = Library::new(rust_lib_path()).expect(\"loading Rust lib\");\n\n        let c_pow: Symbol<MyPowFn> = c_lib.get(b\"my_pow\").expect(\"C my_pow\");\n        let rs_pow: Symbol<MyPowFn> = rs_lib.get(b\"my_pow\").expect(\"Rust my_pow\");\n\n        let c_result = c_pow(base, exponent);\n        let rs_result = rs_pow(base, exponent);\n\n        (c_result, rs_result)\n    }\n}\n\nfn assert_bits_eq(a: f64, b: f64, label: &str) {\n    let ab = a.to_bits();\n    let bb = b.to_bits();\n    assert_eq!(\n        ab, bb,\n        \"{}: C={} (bits=0x{:016x}) Rust={} (bits=0x{:016x})\",\n        label, a, ab, b, bb\n    );\n}\n\n#[test]\nfn test_pow_basic_positive() {\n    let cases: &[(f64, f64)] = &[\n        (2.0, 3.0),\n        (10.0, 2.0),\n        (5.0, 0.0),\n        (1.0, 1000.0),\n        (0.0, 0.0),\n        (0.5, 4.0),\n        (3.0, 0.5),\n    ];\n    for &(b, e) in cases {\n        let (c, r) = run_pair(b, e);\n        assert_bits_eq(c, r, &format!(\"pow({}, {})\", b, e));\n    }\n}\n\n#[test]\nfn test_pow_negative_base() {\n    let cases: &[(f64, f64)] = &[\n        (-2.0, 3.0),\n        (-2.0, 4.0),\n        (-1.0, 5.0),\n    ];\n    for &(b, e) in cases {\n        let (c, r) = run_pair(b, e);\n        assert_bits_eq(c, r, &format!(\"pow({}, {})\", b, e));\n    }\n}\n\n#[test]\nfn test_pow_domain_error_negative_fraction() {\n    // pow(-1, 0.5) -> NaN, errno=EDOM. Function returns -1.0.\n    let (c, r) = run_pair(-1.0, 0.5);\n    assert_bits_eq(c, r, \"pow(-1, 0.5)\");\n}\n\n#[test]\nfn test_pow_range_overflow() {\n    // Huge exponent -> overflow / inf, errno=ERANGE -> -1.0\n    let (c, r) = run_pair(1e308, 10.0);\n    assert_bits_eq(c, r, \"pow(1e308, 10)\");\n}\n\n#[test]\nfn test_pow_range_underflow() {\n    // Tiny base raised to large positive -> underflow to 0\n    let (c, r) = run_pair(1e-300, 10.0);\n    assert_bits_eq(c, r, \"pow(1e-300, 10)\");\n}\n\n#[test]\nfn test_pow_special_values() {\n    let cases: &[(f64, f64)] = &[\n        (f64::INFINITY, 2.0),\n        (f64::NEG_INFINITY, 3.0),\n        (2.0, f64::INFINITY),\n        (1.0, f64::INFINITY), // pow(1, inf) == 1 in C\n        (0.0, -1.0),          // 1/0 -> inf, errno=ERANGE\n    ];\n    for &(b, e) in cases {\n        let (c, r) = run_pair(b, e);\n        assert_bits_eq(c, r, &format!(\"pow({}, {})\", b, e));\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":165,"cache_read_input_tokens":23767,"cache_creation":{"ephemeral_5m_input_tokens":165,"ephemeral_1h_input_tokens":0},"output_tokens":22,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"672ff279-70e6-4609-b18f-cc5d9b31363c","uuid":"967b9518-3e5e-42c9-99a3-0b66b97dee01"}
