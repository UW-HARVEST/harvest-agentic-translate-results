{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_tyyua3jbvm3ibycqk5y72yzje3cruasnbftaiacwqjcyv7izbgaa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_016Htg7hGtFMNgSCLaQNZFM4","name":"Write","input":{"file_path":"/tmp/harvest-translate-4O7zp2/translated_rust/tests/ffi_driver.rs","content":"use libloading::{Library, Symbol};\nuse std::ffi::c_int;\nuse std::fs::File;\nuse std::io::{Read, Seek, SeekFrom};\nuse std::os::unix::io::AsRawFd;\n\nextern \"C\" {\n    fn dup(oldfd: c_int) -> c_int;\n    fn dup2(oldfd: c_int, newfd: c_int) -> c_int;\n    fn close(fd: c_int) -> c_int;\n    fn fflush(stream: *mut std::ffi::c_void) -> c_int;\n}\n\nconst STDOUT_FILENO: c_int = 1;\n\n/// Calls the given closure while stdout is redirected to a temp file,\n/// then returns the captured bytes.\nfn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {\n    // Create a temp file (anonymous) using tmpfile-equivalent\n    let path = std::env::temp_dir().join(format!(\n        \"driver_capture_{}_{}\",\n        std::process::id(),\n        std::time::SystemTime::now()\n            .duration_since(std::time::UNIX_EPOCH)\n            .unwrap()\n            .as_nanos()\n    ));\n    let file = File::options()\n        .read(true)\n        .write(true)\n        .create_new(true)\n        .open(&path)\n        .expect(\"create temp file\");\n\n    let saved_stdout;\n    unsafe {\n        // Flush C stdout buffer first\n        fflush(std::ptr::null_mut());\n        saved_stdout = dup(STDOUT_FILENO);\n        assert!(saved_stdout >= 0);\n        let res = dup2(file.as_raw_fd(), STDOUT_FILENO);\n        assert!(res >= 0);\n    }\n\n    f();\n\n    // Restore stdout\n    unsafe {\n        fflush(std::ptr::null_mut());\n        dup2(saved_stdout, STDOUT_FILENO);\n        close(saved_stdout);\n    }\n\n    let mut file = file;\n    file.seek(SeekFrom::Start(0)).unwrap();\n    let mut buf = Vec::new();\n    file.read_to_end(&mut buf).unwrap();\n    drop(file);\n    let _ = std::fs::remove_file(&path);\n    buf\n}\n\nfn c_lib_path() -> String {\n    \"c_src/build/libdriver.so\".to_string()\n}\n\nfn rust_lib_path() -> String {\n    \"target/release/libdriver.so\".to_string()\n}\n\n#[test]\nfn driver_outputs_match() {\n    let c_lib = unsafe { Library::new(c_lib_path()).expect(\"load C lib\") };\n    let rust_lib = unsafe { Library::new(rust_lib_path()).expect(\"load Rust lib\") };\n\n    let c_driver: Symbol<unsafe extern \"C\" fn(c_int)> =\n        unsafe { c_lib.get(b\"driver\").expect(\"C driver symbol\") };\n    let rust_driver: Symbol<unsafe extern \"C\" fn(c_int)> =\n        unsafe { rust_lib.get(b\"driver\").expect(\"Rust driver symbol\") };\n\n    let test_inputs: &[c_int] = &[0, 1, 2, 3, -1, 100, -42, i32::MAX, i32::MIN];\n\n    for &input in test_inputs {\n        let c_out = capture_stdout(|| unsafe { c_driver(input) });\n        let rust_out = capture_stdout(|| unsafe { rust_driver(input) });\n        assert_eq!(\n            c_out, rust_out,\n            \"Mismatch for input {}: C={:?}, Rust={:?}\",\n            input,\n            String::from_utf8_lossy(&c_out),\n            String::from_utf8_lossy(&rust_out)\n        );\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":235,"cache_read_input_tokens":18698,"cache_creation":{"ephemeral_5m_input_tokens":235,"ephemeral_1h_input_tokens":0},"output_tokens":35,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"15804cbf-9265-4351-af60-ad9ba83fa7b8","uuid":"1266b8fa-e670-4979-bd24-0ee8a72b1955"}
