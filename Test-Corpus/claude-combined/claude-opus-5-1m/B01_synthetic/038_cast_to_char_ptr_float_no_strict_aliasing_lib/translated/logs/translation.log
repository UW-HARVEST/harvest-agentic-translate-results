ect stdout to.\n    let mut tmp = tempfile();\n\n    // Save current stdout fd.\n    let stdout_fd = 1;\n    let saved_fd = unsafe { libc::dup(stdout_fd) };\n    assert!(saved_fd >= 0, \"dup failed\");\n\n    // Replace stdout with our temp file.\n    let new_fd = unsafe { libc::dup2(tmp.as_raw_fd(), stdout_fd) };\n    assert!(new_fd >= 0, \"dup2 failed\");\n\n    // Run the function.\n    f();\n\n    // Flush stdout.\n    unsafe {\n        fflush(std::ptr::null_mut());\n    }\n\n    // Restore stdout.\n    unsafe {\n        libc::dup2(saved_fd, stdout_fd);\n        libc::close(saved_fd);\n    }\n\n    // Read the captured contents.\n    tmp.seek(SeekFrom::Start(0)).unwrap();\n    let mut buf = Vec::new();\n    tmp.read_to_end(&mut buf).unwrap();\n    buf\n}\n\nfn tempfile() -> std::fs::File {\n    let dir = std::env::temp_dir();\n    let pid = std::process::id();\n    let counter = COUNTER.fetch_add(1, std::sync::atomic::Ordering::SeqCst);\n    let path = dir.join(format!(\"driver_test_{}_{}.tmp\", pid, counter));\n    let f = std::fs::OpenOptions::new()\n        .read(true)\n        .write(true)\n        .create(true)\n        .truncate(true)\n        .open(&path)\n        .unwrap();\n    let _ = std::fs::remove_file(&path);\n    f\n}\n\nstatic COUNTER: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);\n\n// libc dependency for fd manipulation\nextern crate libc;\n\nfn run_driver(lib_path: &str, x: f32) -> Vec<u8> {\n    let lib = unsafe { Library::new(lib_path) }.expect(\"Failed to load library\");\n    let driver: Symbol<unsafe extern \"C\" fn(f32)> =\n        unsafe { lib.get(b\"driver\") }.expect(\"driver symbol not found\");\n    capture_stdout(|| {\n        unsafe { driver(x) };\n    })\n}\n\n#[test]\nfn compare_driver_zero() {\n    let c = run_driver(C_LIB, 0.0);\n    let r = run_driver(RUST_LIB, 0.0);\n    assert_eq!(c, r, \"outputs differ for x=0.0\");\n}\n\n#[test]\nfn compare_driver_one() {\n    let c = run_driver(C_LIB, 1.0);\n    let r = run_driver(RUST_LIB, 1.0);\n    assert_eq!(c, r, \"outputs differ for x=1.0\");\n}\n\n#[test]\nfn compare_driver_negative() {\n    let c = run_driver(C_LIB, -1.5);\n    let r = run_driver(RUST_LIB, -1.5);\n    assert_eq!(c, r, \"outputs differ for x=-1.5\");\n}\n\n#[test]\nfn compare_driver_pi() {\n    let c = run_driver(C_LIB, std::f32::consts::PI);\n    let r = run_driver(RUST_LIB, std::f32::consts::PI);\n    assert_eq!(c, r, \"outputs differ for x=PI\");\n}\n\n#[test]\nfn compare_driver_inf() {\n    let c = run_driver(C_LIB, f32::INFINITY);\n    let r = run_driver(RUST_LIB, f32::INFINITY);\n    assert_eq!(c, r, \"outputs differ for x=INF\");\n}\n\n#[test]\nfn compare_driver_neg_inf() {\n    let c = run_driver(C_LIB, f32::NEG_INFINITY);\n    let r = run_driver(RUST_LIB, f32::NEG_INFINITY);\n    assert_eq!(c, r, \"outputs differ for x=-INF\");\n}\n\n#[test]\nfn compare_driver_nan() {\n    let c = run_driver(C_LIB, f32::NAN);\n    let r = run_driver(RUST_LIB, f32::NAN);\n    assert_eq!(c, r, \"outputs differ for x=NaN\");\n}\n\n#[test]\nfn compare_driver_large() {\n    let c = run_driver(C_LIB, 1.234567e30);\n    let r = run_driver(RUST_LIB, 1.234567e30);\n    assert_eq!(c, r, \"outputs differ for x=1.234567e30\");\n}\n\n#[test]\nfn compare_driver_small() {\n    let c = run_driver(C_LIB, 1.234567e-30);\n    let r = run_driver(RUST_LIB, 1.234567e-30);\n    assert_eq!(c, r, \"outputs differ for x=1.234567e-30\");\n}\n","structuredPatch":[{"oldStart":69,"oldLines":7,"newStart":69,"newLines":10,"lines":[" // libc dependency for fd manipulation"," extern crate libc;"," ","+static STDOUT_LOCK: std::sync::Mutex<()> = std::sync::Mutex::new(());","+"," fn run_driver(lib_path: &str, x: f32) -> Vec<u8> {","+    let _guard = STDOUT_LOCK.lock().unwrap_or_else(|e| e.into_inner());","     let lib = unsafe { Library::new(lib_path) }.expect(\"Failed to load library\");","     let driver: Symbol<unsafe extern \"C\" fn(f32)> =","         unsafe { lib.get(b\"driver\") }.expect(\"