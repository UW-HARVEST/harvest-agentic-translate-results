{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_eg32xeqbs4pqo33ovi3hfi7ltwinhwkc5xysfvtfgv43hlwrnwfa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01QgLRf2ibtxFURZa9efRK62","name":"Write","input":{"file_path":"/tmp/harvest-translate-ttjYeU/translated_rust/tests/driver_compare.rs","content":"use libloading::{Library, Symbol};\nuse std::io::{Read, Seek, SeekFrom};\nuse std::os::unix::io::AsRawFd;\n\nconst C_LIB: &str = \"c_src/build/libdriver.so\";\nconst RUST_LIB: &str = \"target/release/libdriver.so\";\n\nextern crate libc;\n\nextern \"C\" {\n    fn fflush(stream: *mut libc::FILE) -> i32;\n}\n\n/// Run `f` with stdout redirected to a fresh temporary file; return what was captured.\nfn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {\n    unsafe {\n        fflush(std::ptr::null_mut());\n    }\n\n    let mut tmp = make_tempfile();\n    let stdout_fd = 1;\n    let saved_fd = unsafe { libc::dup(stdout_fd) };\n    assert!(saved_fd >= 0, \"dup failed\");\n    let new_fd = unsafe { libc::dup2(tmp.as_raw_fd(), stdout_fd) };\n    assert!(new_fd >= 0, \"dup2 failed\");\n\n    f();\n\n    unsafe {\n        fflush(std::ptr::null_mut());\n        libc::dup2(saved_fd, stdout_fd);\n        libc::close(saved_fd);\n    }\n\n    tmp.seek(SeekFrom::Start(0)).unwrap();\n    let mut buf = Vec::new();\n    tmp.read_to_end(&mut buf).unwrap();\n    buf\n}\n\nfn make_tempfile() -> std::fs::File {\n    let dir = std::env::temp_dir();\n    let pid = std::process::id();\n    let counter = COUNTER.fetch_add(1, std::sync::atomic::Ordering::SeqCst);\n    let path = dir.join(format!(\"driver_test_{}_{}.tmp\", pid, counter));\n    let f = std::fs::OpenOptions::new()\n        .read(true)\n        .write(true)\n        .create(true)\n        .truncate(true)\n        .open(&path)\n        .unwrap();\n    let _ = std::fs::remove_file(&path);\n    f\n}\n\nstatic COUNTER: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);\n\nfn run_driver_in_lib(lib_path: &str, x: f32) -> Vec<u8> {\n    let lib = unsafe { Library::new(lib_path) }.expect(\"Failed to load library\");\n    let driver: Symbol<unsafe extern \"C\" fn(f32)> =\n        unsafe { lib.get(b\"driver\") }.expect(\"driver symbol not found\");\n    capture_stdout(|| {\n        unsafe { driver(x) };\n    })\n}\n\nfn check(x: f32, label: &str) {\n    let c = run_driver_in_lib(C_LIB, x);\n    let r = run_driver_in_lib(RUST_LIB, x);\n    assert_eq!(c, r, \"outputs differ for {label}\");\n}\n\n/// Single combined test to avoid concurrent stdout-redirection conflicts\n/// with the cargo test harness running tests in parallel threads.\n#[test]\nfn compare_driver_all() {\n    check(0.0, \"0.0\");\n    check(-0.0, \"-0.0\");\n    check(1.0, \"1.0\");\n    check(-1.0, \"-1.0\");\n    check(-1.5, \"-1.5\");\n    check(std::f32::consts::PI, \"PI\");\n    check(std::f32::consts::E, \"E\");\n    check(f32::INFINITY, \"INFINITY\");\n    check(f32::NEG_INFINITY, \"NEG_INFINITY\");\n    check(f32::NAN, \"NAN\");\n    check(1.234567e30, \"1.234567e30\");\n    check(1.234567e-30, \"1.234567e-30\");\n    check(f32::MIN, \"MIN\");\n    check(f32::MAX, \"MAX\");\n    check(f32::EPSILON, \"EPSILON\");\n    check(f32::MIN_POSITIVE, \"MIN_POSITIVE\");\n    // Subnormal\n    check(f32::from_bits(1), \"subnormal smallest\");\n    // A few arbitrary bit patterns\n    for bits in [0xdeadbeefu32, 0x12345678, 0xffffffff, 0x7f800001, 0xff800001] {\n        check(f32::from_bits(bits), &format!(\"bits=0x{bits:08x}\"));\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":643,"cache_read_input_tokens":23197,"cache_creation":{"ephemeral_5m_input_tokens":643,"ephemeral_1h_input_tokens":0},"output_tokens":29,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"228449e3-cd89-4b86-97bd-becea853b136","uuid":"9e11f004-0651-477b-87b7-d68d3ddeff0e"}
