d();\n\n    unsafe {\n        // Flush stdout first to make sure no buffered C output bleeds in.\n        fflush(stdout);\n        // Save original stdout fd\n        let saved_fd = dup(1);\n        assert!(saved_fd >= 0);\n\n        // Redirect stdout to temp file\n        let r = dup2(tmp_fd, 1);\n        assert!(r >= 0);\n\n        // Run user code\n        f();\n\n        // Flush stdout from C side\n        fflush(stdout);\n\n        // Restore stdout\n        dup2(saved_fd, 1);\n        close(saved_fd);\n    }\n\n    drop(tmp_file);\n    let mut f = File::open(&tmp_path).expect(\"open tmp for read\");\n    f.seek(SeekFrom::Start(0)).unwrap();\n    let mut buf = Vec::new();\n    f.read_to_end(&mut buf).unwrap();\n    let _ = std::fs::remove_file(&tmp_path);\n    buf\n}\n\nunsafe fn call_void_fn(lib: &Library, name: &[u8]) -> Vec<u8> {\n    let func: Symbol<unsafe extern \"C\" fn()> = lib.get(name).expect(\"symbol\");\n    capture_stdout(|| unsafe { func() })\n}\n\nunsafe fn call_print_line(lib: &Library, s: Option<&str>) -> Vec<u8> {\n    let func: Symbol<unsafe extern \"C\" fn(*const c_char)> =\n        lib.get(b\"printLine\").expect(\"symbol\");\n    let cstr = s.map(|s| CString::new(s).unwrap());\n    let ptr = match &cstr {\n        Some(c) => c.as_ptr(),\n        None => std::ptr::null(),\n    };\n    capture_stdout(|| unsafe { func(ptr) })\n}\n\nunsafe fn call_print_int_line(lib: &Library, n: c_int) -> Vec<u8> {\n    let func: Symbol<unsafe extern \"C\" fn(c_int)> =\n        lib.get(b\"printIntLine\").expect(\"symbol\");\n    capture_stdout(|| unsafe { func(n) })\n}\n\n#[test]\nfn test_print_line_match() {\n    let c = unsafe { Library::new(c_lib_path()).expect(\"load c lib\") };\n    let r = unsafe { Library::new(rust_lib_path()).expect(\"load rust lib\") };\n\n    for s in &[Some(\"hello\"), Some(\"\"), Some(\"multi\\nline\"), None] {\n        let c_out = unsafe { call_print_line(&c, *s) };\n        let r_out = unsafe { call_print_line(&r, *s) };\n        assert_eq!(\n            c_out, r_out,\n            \"printLine mismatch for {:?}: c={:?} r={:?}\",\n            s,\n            String::from_utf8_lossy(&c_out),\n            String::from_utf8_lossy(&r_out)\n        );\n    }\n}\n\n#[test]\nfn test_print_int_line_match() {\n    let c = unsafe { Library::new(c_lib_path()).expect(\"load c lib\") };\n    let r = unsafe { Library::new(rust_lib_path()).expect(\"load rust lib\") };\n\n    for n in &[0, 1, -1, 12345, -98765, i32::MAX, i32::MIN] {\n        let c_out = unsafe { call_print_int_line(&c, *n) };\n        let r_out = unsafe { call_print_int_line(&r, *n) };\n        assert_eq!(c_out, r_out, \"printIntLine mismatch for {}\", n);\n    }\n}\n\n#[test]\nfn test_good_match() {\n    let c = unsafe { Library::new(c_lib_path()).expect(\"load c lib\") };\n    let r = unsafe { Library::new(rust_lib_path()).expect(\"load rust lib\") };\n\n    let c_out = unsafe { call_void_fn(&c, b\"good\") };\n    let r_out = unsafe { call_void_fn(&r, b\"good\") };\n    assert_eq!(c_out, r_out, \"good() mismatch\");\n}\n\n#[test]\nfn test_bad_match() {\n    let c = unsafe { Library::new(c_lib_path()).expect(\"load c lib\") };\n    let r = unsafe { Library::new(rust_lib_path()).expect(\"load rust lib\") };\n\n    let c_out = unsafe { call_void_fn(&c, b\"bad\") };\n    let r_out = unsafe { call_void_fn(&r, b\"bad\") };\n    assert_eq!(c_out, r_out, \"bad() mismatch\");\n}\n\n#[test]\nfn test_driver_match() {\n    let c = unsafe { Library::new(c_lib_path()).expect(\"load c lib\") };\n    let r = unsafe { Library::new(rust_lib_path()).expect(\"load rust lib\") };\n\n    let c_out = unsafe { call_void_fn(&c, b\"driver\") };\n    let r_out = unsafe { call_void_fn(&r, b\"driver\") };\n    assert_eq!(\n        c_out,\n        r_out,\n        \"driver() mismatch:\\nC: {}\\nR: {}\",\n        String::from_utf8_lossy(&c_out),\n        String::from_utf8_lossy(&r_out)\n    );\n}\n","structuredPatch":[{"oldStart":1,"oldLines":7,"newStart":1,"newLines":7,"lines":[" use libloading::{Library, Symbol};"," use std::ffi::CString;"," use std::fs::File;","-use std::io::{Read, Seek, SeekFrom, Write};","+use std::io::{Read, Seek, SeekFrom};"," use std::os::raw::{c_char, c_int};"," use std::os::unix::io::AsRawFd;"," use std::sync::Mutex;"]}],"userModified":false,"replaceAll":false}}
