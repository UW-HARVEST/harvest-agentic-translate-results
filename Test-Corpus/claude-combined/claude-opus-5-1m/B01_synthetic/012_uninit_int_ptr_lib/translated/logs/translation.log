nsafe { dup(1) };\n    assert!(original_stdout_fd >= 0);\n\n    // Redirect stdout (fd 1) to our temp file\n    unsafe {\n        let r = dup2(file.as_raw_fd(), 1);\n        assert!(r >= 0);\n    }\n\n    // Run the closure\n    f();\n\n    // Flush libc stdout\n    unsafe {\n        fflush(std::ptr::null_mut());\n    }\n\n    // Restore stdout\n    unsafe {\n        let r = dup2(original_stdout_fd, 1);\n        assert!(r >= 0);\n        close(original_stdout_fd);\n    }\n\n    // Read everything\n    file.seek(SeekFrom::Start(0)).expect(\"seek\");\n    let mut buf = Vec::new();\n    file.read_to_end(&mut buf).expect(\"read\");\n    drop(file);\n    let _ = fs::remove_file(&path);\n    buf\n}\n\nfn run_print_int_ptr_line(lib_path: &PathBuf, value: c_int) -> Vec<u8> {\n    let lib = unsafe { Library::new(lib_path) }.expect(\"load library\");\n    let sym: Symbol<unsafe extern \"C\" fn(*const c_int)> =\n        unsafe { lib.get(b\"printIntPtrLine\\0\") }.expect(\"symbol printIntPtrLine\");\n    let v = value;\n    let p: *const c_int = &v;\n    capture_stdout(|| unsafe { sym(p) })\n}\n\nfn run_good(lib_path: &PathBuf) -> Vec<u8> {\n    let lib = unsafe { Library::new(lib_path) }.expect(\"load library\");\n    let sym: Symbol<unsafe extern \"C\" fn()> = unsafe { lib.get(b\"good\\0\") }.expect(\"symbol good\");\n    capture_stdout(|| unsafe { sym() })\n}\n\nfn run_driver(lib_path: &PathBuf, use_good: c_int) -> Vec<u8> {\n    let lib = unsafe { Library::new(lib_path) }.expect(\"load library\");\n    let sym: Symbol<unsafe extern \"C\" fn(c_int)> =\n        unsafe { lib.get(b\"driver\\0\") }.expect(\"symbol driver\");\n    capture_stdout(|| unsafe { sym(use_good) })\n}\n\n#[test]\nfn print_int_ptr_line_matches() {\n    for v in [-1, 0, 1, 5, 42, i32::MAX, i32::MIN] {\n        let c_out = run_print_int_ptr_line(&c_lib_path(), v);\n        let r_out = run_print_int_ptr_line(&rust_lib_path(), v);\n        assert_eq!(c_out, r_out, \"mismatch for value {}\", v);\n        // Also sanity check format\n        let expected = format!(\"{}\\n\", v);\n        assert_eq!(c_out, expected.as_bytes());\n    }\n}\n\n#[test]\nfn good_matches() {\n    let c_out = run_good(&c_lib_path());\n    let r_out = run_good(&rust_lib_path());\n    assert_eq!(c_out, r_out);\n    assert_eq!(c_out, b\"5\\n\");\n}\n\n#[test]\nfn driver_use_good_matches() {\n    // Only test the well-defined branch: useGood != 0.\n    for v in [1, 2, -1, 100] {\n        let c_out = run_driver(&c_lib_path(), v);\n        let r_out = run_driver(&rust_lib_path(), v);\n        assert_eq!(c_out, r_out, \"mismatch for useGood={}\", v);\n        assert_eq!(c_out, b\"5\\n\");\n    }\n}\n\n#[test]\nfn driver_use_good_zero_executes() {\n    // Don't compare outputs (bad() reads uninitialized memory and is UB),\n    // but verify the symbol is reachable and callable on both libraries.\n    let c_lib = unsafe { Library::new(c_lib_path()) }.expect(\"load c lib\");\n    let _c_sym: Symbol<unsafe extern \"C\" fn(c_int)> =\n        unsafe { c_lib.get(b\"driver\\0\") }.expect(\"c driver\");\n    let r_lib = unsafe { Library::new(rust_lib_path()) }.expect(\"load rust lib\");\n    let _r_sym: Symbol<unsafe extern \"C\" fn(c_int)> =\n        unsafe { r_lib.get(b\"driver\\0\") }.expect(\"rust driver\");\n    // Also confirm `bad` is exported in both libraries.\n    let _c_bad: Symbol<unsafe extern \"C\" fn()> = unsafe { c_lib.get(b\"bad\\0\") }.expect(\"c bad\");\n    let _r_bad: Symbol<unsafe extern \"C\" fn()> = unsafe { r_lib.get(b\"bad\\0\") }.expect(\"rust bad\");\n}\n\n#[test]\nfn rust_exports_match_c_public_api() {\n    // Verify the Rust shared library exports every public function the C library exports.\n    let c_lib = unsafe { Library::new(c_lib_path()) }.expect(\"load c lib\");\n    let r_lib = unsafe { Library::new(rust_lib_path()) }.expect(\"load rust lib\");\n\n    for name in [\"driver\", \"good\", \"bad\", \"printIntPtrLine\"] {\n        let mut sym_name = name.as_bytes().to_vec();\n        sym_name.push(0);\n        let _c: Symbol<unsafe extern \"C\" fn()> =\n            unsafe { c_lib.get(&sym_name) }.unwrap_or_else(|_| panic!(\"c missing {}\", name));\n        let _r: Symbol<unsafe extern \"C\" fn()> =\n            unsafe { r_lib.get(&sym_name) }.unwrap_or_else(|_| panic!(\"rust missing {}\", name));\n    }\n}\n\n// Suppress unused-import warning on platforms where Write isn't strictly needed.\n#[allow(dead_code)]\nfn _force_use_write(_w: &mut dyn Write) {}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
