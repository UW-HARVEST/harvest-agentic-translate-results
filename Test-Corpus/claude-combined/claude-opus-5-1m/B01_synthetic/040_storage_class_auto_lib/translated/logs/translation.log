{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_uamngwqftarij3n566vh2savogdhjcopa3t4lwtouc35pawhndoa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01CiyCgZnWUw5cVyx3pSY9e7","name":"Write","input":{"file_path":"/tmp/harvest-translate-0GiWoQ/translated_rust/tests/ffi_compare.rs","content":"use libloading::{Library, Symbol};\nuse std::ffi::c_int;\nuse std::fs;\nuse std::io::{Read, Seek, SeekFrom, Write};\nuse std::os::unix::io::AsRawFd;\n\nextern \"C\" {\n    fn dup(oldfd: c_int) -> c_int;\n    fn dup2(oldfd: c_int, newfd: c_int) -> c_int;\n    fn close(fd: c_int) -> c_int;\n    fn fflush(stream: *mut std::ffi::c_void) -> c_int;\n}\n\nfn c_lib_path() -> String {\n    let manifest = env!(\"CARGO_MANIFEST_DIR\");\n    format!(\"{}/c_src/build/libdriver.so\", manifest)\n}\n\nfn rust_lib_path() -> String {\n    let manifest = env!(\"CARGO_MANIFEST_DIR\");\n    format!(\"{}/target/release/libdriver.so\", manifest)\n}\n\n/// Calls a `driver(int)`-style function from a loaded library while capturing\n/// stdout. Returns the captured bytes.\nfn call_driver_capture(lib_path: &str, x: c_int) -> Vec<u8> {\n    unsafe {\n        let lib = Library::new(lib_path).expect(\"failed to load library\");\n        let driver: Symbol<unsafe extern \"C\" fn(c_int)> =\n            lib.get(b\"driver\").expect(\"symbol driver not found\");\n\n        // Flush any pending stdout buffer in the host (Rust) process.\n        let _ = std::io::stdout().flush();\n        // Flush libc stdout (which the C printf will use).\n        fflush(std::ptr::null_mut());\n\n        // Create a temporary file to capture stdout output.\n        let tmp_path = std::env::temp_dir().join(format!(\n            \"driver_capture_{}_{}.txt\",\n            std::process::id(),\n            x\n        ));\n        let mut tmp = fs::OpenOptions::new()\n            .read(true)\n            .write(true)\n            .create(true)\n            .truncate(true)\n            .open(&tmp_path)\n            .expect(\"failed to open tmp file\");\n\n        let stdout_fd: c_int = 1;\n        let saved = dup(stdout_fd);\n        assert!(saved >= 0, \"dup failed\");\n\n        let rc = dup2(tmp.as_raw_fd(), stdout_fd);\n        assert!(rc >= 0, \"dup2 to tmp failed\");\n\n        // Call the function under test.\n        driver(x);\n\n        // Flush libc stdout so all printf output reaches the file.\n        fflush(std::ptr::null_mut());\n\n        // Restore original stdout.\n        let rc = dup2(saved, stdout_fd);\n        assert!(rc >= 0, \"dup2 restore failed\");\n        close(saved);\n\n        // Read the captured output back.\n        tmp.seek(SeekFrom::Start(0)).expect(\"seek failed\");\n        let mut buf = Vec::new();\n        tmp.read_to_end(&mut buf).expect(\"read failed\");\n        let _ = fs::remove_file(&tmp_path);\n        buf\n    }\n}\n\nfn assert_match(x: c_int) {\n    let c_out = call_driver_capture(&c_lib_path(), x);\n    let r_out = call_driver_capture(&rust_lib_path(), x);\n    assert_eq!(\n        c_out, r_out,\n        \"mismatch for x={}: C={:?} Rust={:?}\",\n        x, c_out, r_out\n    );\n}\n\n#[test]\nfn driver_zero() {\n    assert_match(0);\n}\n\n#[test]\nfn driver_positive() {\n    assert_match(1);\n    assert_match(42);\n    assert_match(1000);\n}\n\n#[test]\nfn driver_negative() {\n    assert_match(-1);\n    assert_match(-150);\n    assert_match(-1_000_000);\n}\n\n#[test]\nfn driver_extremes() {\n    assert_match(c_int::MAX);\n    assert_match(c_int::MIN);\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":219,"cache_read_input_tokens":18472,"cache_creation":{"ephemeral_5m_input_tokens":219,"ephemeral_1h_input_tokens":0},"output_tokens":33,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"43d1bce9-2f0a-42c1-8621-63a3c201e273","uuid":"e79d1383-62aa-4673-84c2-36f403fd3a1e"}
