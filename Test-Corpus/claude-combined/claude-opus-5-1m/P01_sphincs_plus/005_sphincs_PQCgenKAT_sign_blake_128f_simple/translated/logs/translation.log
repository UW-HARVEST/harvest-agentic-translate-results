; tr::absorb_bytes(&mut tctx, &sk);\n\n        let mut smlen: u64 = 0;\n        let ret = unsafe {\n            SPX_crypto_sign(sm.as_mut_ptr(), &mut smlen, m.as_ptr(), mlen, sk.as_ptr())\n        };\n        if ret != 0 {\n            eprintln!(\"crypto_sign={}\", ret);\n            return std::process::ExitCode::from(254);\n        }\n        tr::absorb_label(&mut tctx, \"smlen\"); tr::absorb_u64(&mut tctx, smlen);\n        tr::absorb_label(&mut tctx, \"sm\"); tr::absorb_bytes(&mut tctx, &sm[..smlen as usize]);\n\n        let mut mlen1: u64 = 0;\n        let ret = unsafe {\n            SPX_crypto_sign_open(m1.as_mut_ptr(), &mut mlen1, sm.as_ptr(), smlen, pk.as_ptr())\n        };\n        if ret != 0 {\n            eprintln!(\"crypto_sign_open={}\", ret);\n            return std::process::ExitCode::from(254);\n        }\n        if mlen1 != mlen {\n            eprintln!(\"mlen mismatch\");\n            return std::process::ExitCode::from(254);\n        }\n        if m[..mlen_us] != m1[..mlen_us] {\n            eprintln!(\"m mismatch\");\n            return std::process::ExitCode::from(254);\n        }\n    }\n\n    let mut digest = [0u8; 32];\n    tr::finalize(&mut tctx, &mut digest);\n    print!(\"KAT transcript digest = \");\n    for b in &digest {\n        print!(\"{:02X}\", b);\n    }\n    println!();\n\n    let _ = SPX_N;\n    std::process::ExitCode::SUCCESS\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
