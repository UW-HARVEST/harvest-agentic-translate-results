ibloading::os::unix::{Library as UnixLib, RTLD_GLOBAL, RTLD_LAZY};\nuse libloading::{Library, Symbol};\nuse std::path::PathBuf;\n\nfn rust_libname() -> PathBuf {\n    PathBuf::from(\"target/debug/libsphincs_plus.so\")\n}\n\nfn c_backend_lib() -> PathBuf {\n    let backend = if cfg!(feature = \"haraka\") {\n        \"haraka\"\n    } else if cfg!(feature = \"sha2\") {\n        \"sha2\"\n    } else if cfg!(feature = \"shake\") {\n        \"shake\"\n    } else if cfg!(feature = \"blake\") {\n        \"blake\"\n    } else {\n        panic!(\"no backend feature enabled\")\n    };\n    PathBuf::from(format!(\"c_src/build/lib/{0}/lib{0}.so\", backend))\n}\n\nfn open_libs() -> (UnixLib, UnixLib, UnixLib, Library, Library) {\n    unsafe {\n        // Load Rust .so first (RTLD_LOCAL) so its internal symbol references\n        // resolve to itself, not the later C globals.\n        let lib_r = Library::new(rust_libname()).unwrap();\n        // Then load C deps with RTLD_GLOBAL so the C libs can resolve their\n        // mutual references.\n        let crypto = UnixLib::open(Some(\"libcrypto.so.10\"), RTLD_LAZY | RTLD_GLOBAL).unwrap();\n        let backend = UnixLib::open(Some(c_backend_lib().to_str().unwrap()), RTLD_LAZY | RTLD_GLOBAL).unwrap();\n        let core = UnixLib::open(Some(\"c_src/build/app/libsphincs_core_det.so\"), RTLD_LAZY | RTLD_GLOBAL).unwrap();\n        let lib_c = Library::new(\"c_src/build/app/libsphincs_core_det.so\").unwrap();\n        (crypto, backend, core, lib_c, lib_r)\n    }\n}\n\n#[test]\nfn randombytes_matches() {\n    unsafe {\n        let (_c, _b, _co, lib_c, lib_r) = open_libs();\n        let init_c: Symbol<unsafe extern \"C\" fn(*mut u8, *mut u8)> = lib_c.get(b\"randombytes_init\").unwrap();\n        let rb_c: Symbol<unsafe extern \"C\" fn(*mut u8, u64) -> i32> = lib_c.get(b\"randombytes\").unwrap();\n        let init_r: Symbol<unsafe extern \"C\" fn(*mut u8, *mut u8)> = lib_r.get(b\"randombytes_init\").unwrap();\n        let rb_r: Symbol<unsafe extern \"C\" fn(*mut u8, u64) -> i32> = lib_r.get(b\"randombytes\").unwrap();\n\n        let mut entropy = [0u8; 48];\n        for i in 0..48 { entropy[i] = i as u8; }\n\n        let mut c_out = [0u8; 200];\n        let mut r_out = [0u8; 200];\n        init_c(entropy.as_mut_ptr(), core::ptr::null_mut());\n        rb_c(c_out.as_mut_ptr(), 200);\n        init_r(entropy.as_mut_ptr(), core::ptr::null_mut());\n        rb_r(r_out.as_mut_ptr(), 200);\n        assert_eq!(c_out, r_out);\n    }\n}\n\n#[test]\nfn full_roundtrip_matches() {\n    unsafe {\n        let (_c, _b, _co, lib_c, lib_r) = open_libs();\n        let init_c: Symbol<unsafe extern \"C\" fn(*mut u8, *mut u8)> = lib_c.get(b\"randombytes_init\").unwrap();\n        let init_r: Symbol<unsafe extern \"C\" fn(*mut u8, *mut u8)> = lib_r.get(b\"randombytes_init\").unwrap();\n        let bytes_c: Symbol<unsafe extern \"C\" fn() -> u64> = lib_c.get(b\"crypto_sign_bytes\").unwrap();\n        let bytes_r: Symbol<unsafe extern \"C\" fn() -> u64> = lib_r.get(b\"crypto_sign_bytes\").unwrap();\n        let pkbytes_c: Symbol<unsafe extern \"C\" fn() -> u64> = lib_c.get(b\"crypto_sign_publickeybytes\").unwrap();\n        let skbytes_c: Symbol<unsafe extern \"C\" fn() -> u64> = lib_c.get(b\"crypto_sign_secretkeybytes\").unwrap();\n        let pkbytes_r: Symbol<unsafe extern \"C\" fn() -> u64> = lib_r.get(b\"crypto_sign_publickeybytes\").unwrap();\n        let skbytes_r: Symbol<unsafe extern \"C\" fn() -> u64> = lib_r.get(b\"crypto_sign_secretkeybytes\").unwrap();\n\n        // sanity: same shapes\n        assert_eq!(bytes_c(), bytes_r());\n        assert_eq!(pkbytes_c(), pkbytes_r());\n        assert_eq!(skbytes_c(), skbytes_r());\n\n        let bytes = bytes_c() as usize;\n        let pkbytes = pkbytes_c() as usize;\n        let skbytes = skbytes_c() as usize;\n\n        let kp_c: Symbol<unsafe extern \"C\" fn(*mut u8, *mut u8) -> i32> = lib_c.get(b\"crypto_sign_keypair\").unwrap();\n        let kp_r: Symbol<unsafe extern \"C\" fn(*mut u8, *mut u8) -> i32> = lib_r.get(b\"crypto_sign_keypair\").unwrap();\n        let sign_c: Symbol<unsafe extern \"C\" fn(*mut u8, *mut u64, *const u8, u64, *const u8) -> i32> = lib_c.get(b\"crypto_sign\").unwrap();\n        let sign_r: Symbol<unsafe extern \"C\" fn(*mut u8, *mut u64, *const u8, u64, *const u8) -> i32> = lib_r.get(b\"crypto_sign\").unwrap();\n        let open_c: Symbol<unsafe extern \"C\" fn(*mut u8, *mut u64, *const u8, u64, *const u8) -> i32> = lib_c.get(b\"crypto_sign_open\").unwrap();\n        let open_r: Symbol<unsafe extern \"C\" fn(*mut u8, *mut u64, *const u8, u64, *const u8) -> i32> = lib_r.get(b\"crypto_sign_open\").unwrap();\n\n        let mut entropy = [0u8; 48];\n        for i in 0..48 { entropy[i] = i as u8; }\n\n        // Run C: keypair, sign, verify\n        init_c(entropy.as_mut_ptr(), core::ptr::null_mut());\n        let mut pk_c = vec![0u8; pkbytes];\n        let mut sk_c = vec![0u8; skbytes];\n        kp_c(pk_c.as_mut_ptr(), sk_c.as_mut_ptr());\n        let m = b\"some test message for SPHINCS+\";\n        let mut sm_c = vec![0u8; m.len() + bytes];\n        let mut smlen_c: u64 = 0;\n        sign_c(sm_c.as_mut_ptr(), &mut smlen_c, m.as_ptr(), m.len() as u64, sk_c.as_ptr());\n\n        let mut m1_c = vec![0u8; sm_c.len()];\n        let mut mlen1_c: u64 = 0;\n        let r = open_c(m1_c.as_mut_ptr(), &mut mlen1_c, sm_c.as_ptr(), smlen_c, pk_c.as_ptr());\n        assert_eq!(r, 0);\n        assert_eq!(mlen1_c as usize, m.len());\n        assert_eq!(&m1_c[..m.len()], m);\n\n        // Run Rust\n        init_r(entropy.as_mut_ptr(), core::ptr::null_mut());\n        let mut pk_r = vec![0u8; pkbytes];\n        let mut sk_r = vec![0u8; skbytes];\n        kp_r(pk_r.as_mut_ptr(), sk_r.as_mut_ptr());\n        let mut sm_r = vec![0u8; m.len() + bytes];\n        let mut smlen_r: u64 = 0;\n        sign_r(sm_r.as_mut_ptr(), &mut smlen_r, m.as_ptr(), m.len() as u64, sk_r.as_ptr());\n        let mut m1_r = vec![0u8; sm_r.len()];\n        let mut mlen1_r: u64 = 0;\n        let r = open_r(m1_r.as_mut_ptr(), &mut mlen1_r, sm_r.as_ptr(), smlen_r, pk_r.as_ptr());\n        assert_eq!(r, 0);\n\n        // Verify byte-identical outputs\n        assert_eq!(pk_c, pk_r, \"pk mismatch\");\n        assert_eq!(sk_c, sk_r, \"sk mismatch\");\n        assert_eq!(smlen_c, smlen_r, \"smlen mismatch\");\n        assert_eq!(sm_c, sm_r, \"sm mismatch\");\n    }\n}\n","userModified":false}}
