d — with RTLD_LOCAL, the lookup uses the library's own symbols + ld-linker scope. `cdylib` in Rust uses a versioned scope by default. Hmm.\n\nLet me try an alternative: don't preload the C libs with RTLD_GLOBAL, instead load only what we need:"}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":662,"cache_read_input_tokens":418803,"cache_creation":{"ephemeral_5m_input_tokens":662,"ephemeral_1h_input_tokens":0},"output_tokens":6,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"d2bcf60c-a976-41d2-926b-974741aa24ae","uuid":"4acd8a75-971f-4174-9e04-34f3fc80460c"}
