  le[i] = (uint8_t)((x >> (8 * i)) & 0xFF);\n65\t  }\n66\t\n67\t  uint8_t lenle[8];\n68\t  unsigned long long L = 8;\n69\t  for(i = 0; i < 8; i++) {\n70\t    lenle[i] = (uint8_t)((L >> (8 * i)) & 0xFF);\n71\t  }\n72\t\n73\t  blakeX_update(ctx, lenle, 8);\n74\t  blakeX_update(ctx, le, 8);\n75\t}\n76\t\n77\tstatic inline void kat_tr_absorb_bytes(kat_tr_ctx *ctx, const uint8_t *buf, size_t len) {\n78\t  uint8_t lenle[8];\n79\t  unsigned long long L = (unsigned long long) len;\n80\t  size_t i;\n81\t  for(i = 0; i < 8; i++) {\n82\t    lenle[i] = (uint8_t)((L >> (8 * i)) & 0xFF);\n83\t  }\n84\t  blakeX_update(ctx, lenle, 8);\n85\t  if(len) {\n86\t    blakeX_update(ctx, buf, len);\n87\t  }\n88\t}\n89\t\n90\tstatic inline void kat_tr_final(kat_tr_ctx *ctx, uint8_t out32[32]) {\n91\t  unsigned char outbuf[blakeX_output_bytes] = {0};\n92\t  blakeX_final(ctx, outbuf);\n93\t  memcpy(out32, outbuf, 32);\n94\t}\n95\t#elif HARAKA_TR\n96\t#include \"../../lib/haraka/include/haraka.h\"\n97\t\n98\ttypedef struct {\n99\t  spx_ctx inner;\n100\t  uint8_t s[65];\n101\t} kat_tr_ctx;\n102\t\n103\tstatic inline void kat_tr_init(kat_tr_ctx *ctx) {\n104\t  size_t i;\n105\t  for(i = 0; i < SPX_N; ++i) {\n106\t    ctx->inner.pub_seed[i] = 0;\n107\t    ctx->inner.sk_seed[i] = 0;\n108\t  }\n109\t\n110\t  tweak_constants(&ctx->inner);\n111\t  haraka_S_inc_init(ctx->s);\n112\t\n113\t  static const uint8_t tag[] = \"KAT-TRANSCRIPT-v1-HARAKA\";\n114\t  haraka_S_inc_absorb(ctx->s, tag, sizeof tag - 1, &ctx->inner);\n115\t\n116\t  const uint8_t sep = 0x00;\n117\t  haraka_S_inc_absorb(ctx->s, &sep, 1, &ctx->inner);\n118\t}\n119\t\n120\tstatic inline void kat_tr_absorb_label(kat_tr_ctx *ctx, const char *label) {\n121\t  const uint8_t *p = (const uint8_t *)label;\n122\t  size_t n = 0; while(p[n]) n++;\n123\t  haraka_S_inc_absorb(ctx->s, p, n, &ctx->inner);\n124\t\n125\t  const uint8_t sep = 0x00;\n126\t  haraka_S_inc_absorb(ctx->s, &sep, 1, &ctx->inner);\n127\t}\n128\t\n129\tstatic inline void kat_tr_absorb_u64(kat_tr_ctx *ctx, unsigned long long x) {\n130\t  uint8_t le[8];\n131\t  size_t i;\n132\t  for (i = 0; i < 8; i++) {\n133\t    le[i] = (uint8_t)((x >> (8 * i)) & 0xFF);\n134\t  }\n135\t\n136\t  uint8_t lenle[8];\n137\t  unsigned long long L = 8;\n138\t  for(i = 0; i < 8; i++) {\n139\t    lenle[i] = (uint8_t)((L >> (8 * i)) & 0xFF);\n140\t  }\n141\t\n142\t  haraka_S_inc_absorb(ctx->s, lenle, 8, &ctx->inner);\n143\t  haraka_S_inc_absorb(ctx->s, le, 8, &ctx->inner);\n144\t}\n145\t\n146\tstatic inline void kat_tr_absorb_bytes(kat_tr_ctx *ctx, const uint8_t *buf, size_t len) {\n147\t  uint8_t lenle[8];\n148\t  unsigned long long L = (unsigned long long) len;\n149\t  size_t i;\n150\t  for(i = 0; i < 8; i++) {\n151\t    lenle[i] = (uint8_t)((L >> (8 * i)) & 0xFF);\n152\t  }\n153\t  haraka_S_inc_absorb(ctx->s, lenle, 8, &ctx->inner);\n154\t  if(len) {\n155\t    haraka_S_inc_absorb(ctx->s, buf, len, &ctx->inner);\n156\t  }\n157\t}\n158\t\n159\tstatic inline void kat_tr_final(kat_tr_ctx *ctx, uint8_t out32[32]) {\n160\t  haraka_S_inc_finalize(ctx->s);\n161\t  haraka_S_inc_squeeze(out32, 32, ctx->s, &ctx->inner);\n162\t}\n163\t#elif SHA2_TR\n164\t#include \"../../lib/sha2/include/sha2.h\"\n165\t#if SPX_N >= 24\n166\t#define shaX_inc_init sha512_inc_init\n167\t#define shaX_inc_blocks sha512_inc_blocks\n168\t#define shaX_inc_finalize sha512_inc_finalize\n169\t#define shaX_state_len 72\n170\t#define shaX_block_bytes 128\n171\t#define shaX_output_bytes 64\n172\t#else\n173\t#define shaX_inc_init sha256_inc_init\n174\t#define shaX_inc_blocks sha256_inc_blocks\n175\t#define shaX_inc_finalize sha256_inc_finalize\n176\t#define shaX_state_len 40\n177\t#define shaX_block_bytes 64\n178\t#define shaX_output_bytes 32\n179\t#endif\n180\t\n181\ttypedef struct {\n182\t  uint8_t s[shaX_state_len];\n183\t} kat_tr_ctx;\n184\t\n185\tstatic inline void kat_tr_init(kat_tr_ctx *ctx) {\n186\t  static const uint8_t tag[] = \"KAT-TRANSCRIPT-v1-SHA2\";\n187\t  uint8_t block[shaX_block_bytes];\n188\t  size_t i;\n189\t\n190\t  for (i = 0; i < sizeof tag - 1; ++i) {\n191\t      block[i] = tag[i];\n192\t  }\n193\t  for (i = sizeof tag - 1; i < shaX_block_bytes; ++i) {\n194\t      block[i] = 0;\n195\t  }\n196\t\n197\t  shaX_inc_init(ctx->s);\n198\t  shaX_inc_blocks(ctx->s, block, 1);\n199\t}\n200\t\n201\tstatic inline void kat_tr_absorb_label(kat_tr_ctx *ctx, const char *label) {\n202\t  const uint8_t *p = (const uint8_t *)label;\n203\t  size_t n = 0; while(p[n]) n++;\n204\t  size_t block_count = (n + 1 + (shaX_block_bytes - 1)) / shaX_block_bytes;\n205\t\n206\t  size_t i;\n207\t  for(i = 0; i < block_count; ++i) {\n208\t    uint8_t block[shaX_block_bytes];\n209\t    size_t j;\n210\t\n211\t    for(j = 0; i * shaX_block_bytes + j < n && j < shaX_block_bytes; ++j) {\n212\t      block[j] = p[i * shaX_block_bytes + j];\n213\t    }\n214\t\n215\t    if(i * shaX_block_bytes + j == n && j < shaX_block_bytes) {\n216\t      block[j] = 0x00;\n217\t      ++j;\n218\t    }\n219\t\n220\t    for(; j < shaX_block_bytes; ++j) {\n221\t      block[j] = 0;\n222\t    }\n223\t\n224\t    shaX_inc_blocks(ctx->s, block, 1);\n225\t  }\n226\t}\n227\t\n228\tstatic inline void kat_tr_absorb_u64(kat_tr_ctx *ctx, unsigned long long x) {\n229\t  uint8_t block[shaX_block_bytes];\n230\t  uint8_t le[8];\n231\t  size_t i;\n232\t  for (i = 0; i < 8; i++) {\n233\t    le[i] = (uint8_t)((x >> (8 * i)) & 0xFF);\n234\t  }\n235\t\n236\t  uint8_t lenle[8];\n237\t  unsigned long long L = 8;\n238\t  for(i = 0; i < 8; i++) {\n239\t    lenle[i] = (uint8_t)((L >> (8 * i)) & 0xFF);\n240\t  }\n241\t\n242\t  for (i = 0; i < 8; ++i) {\n243\t      block[i] = lenle[i];\n244\t  }\n245\t  for (i = 0; i < 8; ++i) {\n246\t      block[8+i] = le[i];\n247\t  }\n248\t  for (i = 16; i < shaX_block_bytes; ++i) {\n249\t      block[i] = 0;\n250\t  }\n251\t\n252\t  shaX_inc_blocks(ctx->s, block, 1);\n253\t}\n254\t\n255\tstatic inline void kat_tr_absorb_bytes(kat_tr_ctx *ctx, const uint8_t *buf, size_t len) {\n256\t  uint8_t lenle[shaX_block_bytes] = {0};\n257\t  unsigned long long L = (unsigned long long) len;\n258\t  size_t i;\n259\t  for(i = 0; i < 8; i++) {\n260\t    lenle[i] = (uint8_t)((L >> (8 * i)) & 0xFF);\n261\t  }\n262\t  size_t block_count = (len + (shaX_block_bytes - 1)) / shaX_block_bytes;\n263\t  shaX_inc_blocks(ctx->s, lenle, 1);\n264\t\n265\t  if(len != 0) {\n266\t    for(i = 0; i < block_count; ++i) {\n267\t      uint8_t block[shaX_block_bytes];\n268\t      size_t j;\n269\t\n270\t      for(j = 0; i * shaX_block_bytes + j < len && j < shaX_block_bytes; ++j) {\n271\t        block[j] = buf[i * shaX_block_bytes + j];\n272\t      }\n273\t      for(; j < shaX_block_bytes; ++j) {\n274\t        block[j] = 0;\n275\t      }\n276\t\n277\t      shaX_inc_blocks(ctx->s, block, 1);\n278\t    }\n279\t  }\n280\t}\n281\t\n282\tstatic inline void kat_tr_final(kat_tr_ctx *ctx, uint8_t out32[32]) {\n283\t  unsigned char outbuf[shaX_output_bytes] = {0};\n284\t  uint8_t final_block[shaX_block_bytes] = {0};\n285\t  shaX_inc_finalize(outbuf, ctx->s, final_block, 1);\n286\t  memcpy(out32, outbuf, 32);\n287\t}\n288\t#elif SHAKE_TR\n289\t#include \"../../lib/shake/include/fips202.h\"\n290\ttypedef struct {\n291\t  uint64_t s[26];\n292\t} kat_tr_ctx;\n293\t\n294\tstatic inline void kat_tr_init(kat_tr_ctx *ctx) {\n295\t  shake256_inc_init(ctx->s);\n296\t\n297\t  static const uint8_t tag[] = \"KAT-TRANSCRIPT-v1-SHAKE\";\n298\t  shake256_inc_absorb(ctx->s, tag, sizeof tag - 1);\n299\t\n300\t  const uint8_t sep = 0x00;\n301\t  shake256_inc_absorb(ctx->s, &sep, 1);\n302\t}\n303\t\n304\tstatic inline void kat_tr_absorb_label(kat_tr_ctx *ctx, const char *label) {\n305\t  const uint8_t *p = (const uint8_t *)label;\n306\t  size_t n = 0; while(p[n]) n++;\n307\t  shake256_inc_absorb(ctx->s, p, n);\n308\t\n309\t  const uint8_t sep = 0x00;\n310\t  shake256_inc_absorb(ctx->s, &sep, 1);\n311\t}\n312\t\n313\tstatic inline void kat_tr_absorb_u64(kat_tr_ctx *ctx, unsigned long long x) {\n314\t  uint8_t le[8];\n315\t  size_t i;\n316\t  for (i = 0; i < 8; i++) {\n317\t    le[i] = (uint8_t)((x >> (8 * i)) & 0xFF);\n318\t  }\n319\t\n320\t  uint8_t lenle[8];\n321\t  unsigned long long L = 8;\n322\t  for(i = 0; i < 8; i++) {\n323\t    lenle[i] = (uint8_t)((L >> (8 * i)) & 0xFF);\n324\t  }\n325\t\n326\t  shake256_inc_absorb(ctx->s, lenle, 8);\n327\t  shake256_inc_absorb(ctx->s, le, 8);\n328\t}\n329\t\n330\tstatic inline void kat_tr_absorb_bytes(kat_tr_ctx *ctx, const uint8_t *buf, size_t len) {\n331\t  uint8_t lenle[8];\n332\t  unsigned long long L = (unsigned long long) len;\n333\t  size_t i;\n334\t  for(i = 0; i < 8; i++) {\n335\t    lenle[i] = (uint8_t)((L >> (8 * i)) & 0xFF);\n336\t  }\n337\t  shake256_inc_absorb(ctx->s, lenle, 8);\n338\t  if(len) {\n339\t    shake256_inc_absorb(ctx->s, buf, len);\n340\t  }\n341\t}\n342\t\n343\tstatic inline void kat_tr_final(kat_tr_ctx *ctx, uint8_t out32[32]) {\n344\t  shake256_inc_finalize(ctx->s);\n345\t  shake256_inc_squeeze(out32, 32, ctx->s);\n346\t}\n347\t#endif\n348\t\n349\tint\n350\tmain(void)\n351\t{\n352\t  static unsigned char  m[BASE_MLEN * LOOP_COUNT];\n353\t  static unsigned char  sm[BASE_MLEN * LOOP_COUNT + CRYPTO_BYTES];\n354\t  static unsigned char  m1[BASE_MLEN * LOOP_COUNT + CRYPTO_BYTES];\n355\t  static unsigned char  pk[CRYPTO_PUBLICKEYBYTES];\n356\t  static unsigned char  sk[CRYPTO_SECRETKEYBYTES];\n357\t  static unsigned char  seed[48];\n358\t  static unsigned char  entropy_input[48];\n359\t  static unsigned char  msg[BASE_MLEN * LOOP_COUNT];\n360\t\n361\t  unsigned long long    mlen, smlen, mlen1;\n362\t  int                   ret;\n363\t\n364\t  // Deterministic entropy to seed DRBG to make .req\n365\t  for (int i = 0; i < 48; i++) {\n366\t    entropy_input[i] = (unsigned char)i;\n367\t  }\n368\t  randombytes_init(entropy_input, NULL);\n369\t\n370\t  // Initialize Transcript\n371\t  kat_tr_ctx tctx;\n372\t  kat_tr_init(&tctx);\n373\t  kat_tr_absorb_label(&tctx, \"CRYPTO_ALGNAME\");\n374\t  kat_tr_absorb_bytes(&tctx, (const uint8_t *)CRYPTO_ALGNAME, strlen(CRYPTO_ALGNAME));\n375\t  kat_tr_absorb_label(&tctx, \"SKBYTES\"); kat_tr_absorb_u64(&tctx, CRYPTO_SECRETKEYBYTES);\n376\t  kat_tr_absorb_label(&tctx, \"PKBYTES\"); kat_tr_absorb_u64(&tctx, CRYPTO_PUBLICKEYBYTES);\n377\t  kat_tr_absorb_label(&tctx, \"SIGBYTES\"); kat_tr_absorb_u64(&tctx, CRYPTO_BYTES);\n378\t\n379\t  for (int i = 0; i < LOOP_COUNT; i++) {\n380\t    randombytes(seed, sizeof seed);\n381\t\n382\t    kat_tr_absorb_label(&tctx, \"count\"); kat_tr_absorb_u64(&tctx, (unsigned long long) i);\n383\t    kat_tr_absorb_label(&tctx, \"seed\"); kat_tr_absorb_bytes(&tctx, seed, sizeof seed);\n384\t\n385\t    mlen = (unsigned long long int)(BASE_MLEN * (i + 1));\n386\t    if (mlen > BASE_MLEN * LOOP_COUNT) { fprintf(stderr, \"mlen overflow\\n\"); return KAT_OVERFLOW; }\n387\t\n388\t    kat_tr_absorb_label(&tctx, \"mlen\"); kat_tr_absorb_u64(&tctx, mlen);\n389\t\n390\t    randombytes(msg, mlen);\n391\t    kat_tr_absorb_label(&tctx, \"msg\"); kat_tr_absorb_bytes(&tctx, msg, mlen);\n392\t\n393\t    memset(m, 0, mlen);\n394\t    memset(m1, 0, mlen + CRYPTO_BYTES);\n395\t    memset(sm, 0, mlen + CRYPTO_BYTES);\n396\t    memcpy(m, msg, mlen);\n397\t\n398\t    // Keypair\n399\t    ret = crypto_sign_keypair(pk, sk);\n400\t    if (ret) { fprintf(stderr, \"crypto_sign_keypair=%d\\n\", ret); return KAT_CRYPTO_FAILURE; }\n401\t    kat_tr_absorb_label(&tctx, \"pk\"); kat_tr_absorb_bytes(&tctx, pk, CRYPTO_PUBLICKEYBYTES);\n402\t    kat_tr_absorb_label(&tctx, \"sk\"); kat_tr_absorb_bytes(&tctx, sk, CRYPTO_SECRETKEYBYTES);\n403\t\n404\t    // Sign\n405\t    ret = crypto_sign(sm, &smlen, m, mlen, sk);\n406\t    if (ret) { fprintf(stderr, \"crypto_sign=%d\\n\", ret); return KAT_CRYPTO_FAILURE; }\n407\t    kat_tr_absorb_label(&tctx, \"smlen\"); kat_tr_absorb_u64(&tctx, smlen);\n408\t    kat_tr_absorb_label(&tctx, \"sm\"); kat_tr_absorb_bytes(&tctx, sm, smlen);\n409\t\n410\t    // Verify\n411\t    ret = crypto_sign_open(m1, &mlen1, sm, smlen, pk);\n412\t    if (ret) { fprintf(stderr, \"crypto_sign_open=%d\\n\", ret); return KAT_CRYPTO_FAILURE; }\n413\t    if (mlen1 != mlen) { fprintf(stderr, \"mlen mismatch\\n\"); return KAT_CRYPTO_FAILURE; }\n414\t    if (memcmp(m, m1, mlen) != 0) { fprintf(stderr, \"m mismatch\\n\"); return KAT_CRYPTO_FAILURE; }\n415\t  }\n416\t\n417\t  // Finalize transcript digest\n418\t  uint8_t digest[32] = {0};\n419\t  kat_tr_final(&tctx, digest);\n420\t\n421\t  printf(\"KAT transcript digest = \");\n422\t  for (size_t i = 0; i < 32; i++) { printf(\"%02X\", digest[i]); }\n423\t  printf(\"\\n\");\n424\t\n425\t  return KAT_SUCCESS;\n426\t}\n427\t"}]},"parent_tool_use_id":null,"session_id":"d2bcf60c-a976-41d2-926b-974741aa24ae","uuid":"fbfc3d91-efa2-4d5e-9070-e188ac976870","timestamp":"2026-05-30T04:56:18.664Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-translate-TzX4FX/translated_rust/c_src/app/src/PQCgenKAT_sign.c","content":"//\n//  PQCgenKAT_sign.c\n//\n//  Created by Bassham, Lawrence E (Fed) on 8/29/17.\n//  Copyright © 2017 Bassham, Lawrence E (Fed). All rights reserved.\n//\n\n#include <stdint.h>\n#include <stdio.h>\n#include <string.h>\n\n#include \"../include/api.h\"\n#include \"../include/rng.h\"\n\n#define MAX_MARKER_LEN       50\n#define BASE_MLEN            33\n#define LOOP_COUNT           7\n\n#define KAT_SUCCESS          0\n#define KAT_OVERFLOW        -1\n#define KAT_CRYPTO_FAILURE  -2\n\n#ifdef BLAKE_TR\n#include \"../../lib/blake/include/blake.h\"\n#if SPX_N >= 24\n#define blakestateX blakestate512\n#define blakeX_init blake512_init\n#define blakeX_update blake512_update\n#define blakeX_final blake512_final\n#define blakeX_output_bytes 64\n#else\n#define blakestateX blakestate256\n#define blakeX_init blake256_init\n#define blakeX_update blake256_update\n#define blakeX_final blake256_final\n#define blakeX_output_bytes 32\n#endif\n\ntypedef blakestateX kat_tr_ctx;\n\nstatic inline void kat_tr_init(kat_tr_ctx *ctx) {\n  blakeX_init(ctx);\n\n  static const uint8_t tag[] = \"KAT-TRANSCRIPT-v1-BLAKE\";\n  blakeX_update(ctx, tag, sizeof tag - 1);\n\n  const uint8_t sep = 0x00;\n  blakeX_update(ctx, &sep, 1);\n}\n\nstatic inline void kat_tr_absorb_label(kat_tr_ctx *ctx, const char *label) {\n  const uint8_t *p = (const uint8_t *)label;\n  size_t n = 0; while(p[n]) n++;\n  blakeX_update(ctx, p, n);\n\n  const uint8_t sep = 0x00;\n  blakeX_update(ctx, &sep, 1);\n}\n\nstatic inline void kat_tr_absorb_u64(kat_tr_ctx *ctx, unsigned long long x) {\n  uint8_t le[8];\n  size_t i;\n  for (i = 0; i < 8; i++) {\n    le[i] = (uint8_t)((x >> (8 * i)) & 0xFF);\n  }\n\n  uint8_t lenle[8];\n  unsigned long long L = 8;\n  for(i = 0; i < 8; i++) {\n    lenle[i] = (uint8_t)((L >> (8 * i)) & 0xFF);\n  }\n\n  blakeX_update(ctx, lenle, 8);\n  blakeX_update(ctx, le, 8);\n}\n\nstatic inline void kat_tr_absorb_bytes(kat_tr_ctx *ctx, const uint8_t *buf, size_t len) {\n  uint8_t lenle[8];\n  unsigned long long L = (unsigned long long) len;\n  size_t i;\n  for(i = 0; i < 8; i++) {\n    lenle[i] = (uint8_t)((L >> (8 * i)) & 0xFF);\n  }\n  blakeX_update(ctx, lenle, 8);\n  if(len) {\n    blakeX_update(ctx, buf, len);\n  }\n}\n\nstatic inline void kat_tr_final(kat_tr_ctx *ctx, uint8_t out32[32]) {\n  unsigned char outbuf[blakeX_output_bytes] = {0};\n  blakeX_final(ctx, outbuf);\n  memcpy(out32, outbuf, 32);\n}\n#elif HARAKA_TR\n#include \"../../lib/haraka/include/haraka.h\"\n\ntypedef struct {\n  spx_ctx inner;\n  uint8_t s[65];\n} kat_tr_ctx;\n\nstatic inline void kat_tr_init(kat_tr_ctx *ctx) {\n  size_t i;\n  for(i = 0; i < SPX_N; ++i) {\n    ctx->inner.pub_seed[i] = 0;\n    ctx->inner.sk_seed[i] = 0;\n  }\n\n  tweak_constants(&ctx->inner);\n  haraka_S_inc_init(ctx->s);\n\n  static const uint8_t tag[] = \"KAT-TRANSCRIPT-v1-HARAKA\";\n  haraka_S_inc_absorb(ctx->s, tag, sizeof tag - 1, &ctx->inner);\n\n  const uint8_t sep = 0x00;\n  haraka_S_inc_absorb(ctx->s, &sep, 1, &ctx->inner);\n}\n\nstatic inline void kat_tr_absorb_label(kat_tr_ctx *ctx, const char