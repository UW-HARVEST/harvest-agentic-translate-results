ft Windows 11 [Ver: 10.0.22000.918]\",\n        // Windows minimal version\n        \"Some OS [Ver: 1.2.3]\",\n        // Architecture not in the list\n        \"Linux |alpine [Alpine: 3.15] mips64\",\n        // Empty version inside brackets\n        \"Linux |x [Foo: 1.0] amd64\",\n    ];\n    for input in cases {\n        let c = parse_uname_via(&libs.c, input);\n        let r = parse_uname_via(&libs.r, input);\n        assert_osd_eq(&c.osd, &r.osd);\n    }\n}\n\n#[test]\nfn test_w_regexec_invalid_pattern() {\n    let libs = Libs::load();\n    // Unbalanced bracket — regcomp should fail. Both should return 0.\n    let (cr, _) = w_regexec_via(&libs.c, Some(\"[unbalanced\"), Some(\"foo\"), 2);\n    let (rr, _) = w_regexec_via(&libs.r, Some(\"[unbalanced\"), Some(\"foo\"), 2);\n    assert_eq!(cr, rr);\n    assert_eq!(cr, 0);\n}","originalFile":"use libloading::{Library, Symbol};\nuse std::ffi::{c_char, c_int, CString};\nuse std::os::raw::c_void;\nuse std::path::PathBuf;\n\n/// Mirrors `os_data` from c_src/include/lib.h. Field order/size MUST match.\n#[repr(C)]\n#[derive(Default, Clone, Copy)]\nstruct OsData {\n    os_name: *mut c_char,\n    os_version: *mut c_char,\n    os_major: *mut c_char,\n    os_minor: *mut c_char,\n    os_codename: *mut c_char,\n    os_platform: *mut c_char,\n    os_build: *mut c_char,\n    os_uname: *mut c_char,\n    os_arch: *mut c_char,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy)]\nstruct CRegmatch {\n    rm_so: libc::c_long,\n    rm_eo: libc::c_long,\n}\n\ntype GetOsArchFn = unsafe extern \"C\" fn(*mut c_char) -> *mut c_char;\ntype ParseUnameFn = unsafe extern \"C\" fn(*mut c_char, *mut OsData);\ntype WRegexecFn =\n    unsafe extern \"C\" fn(*const c_char, *const c_char, libc::size_t, *mut CRegmatch) -> c_int;\n\nfn c_so_path() -> PathBuf {\n    let mut p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    p.push(\"c_src\");\n    p.push(\"build\");\n    p.push(\"libdriver.so\");\n    p\n}\n\nfn rust_so_path() -> PathBuf {\n    // Built with `cargo build --release` (or default `cargo test` debug).\n    // Use the same target dir Cargo points at.\n    let mut p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    p.push(\"target\");\n    // Try release first, fall back to debug.\n    p.push(\"release\");\n    p.push(\"libdriver.so\");\n    if p.exists() {\n        return p;\n    }\n    let mut p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    p.push(\"target\");\n    p.push(\"debug\");\n    p.push(\"libdriver.so\");\n    p\n}\n\nunsafe fn cstr_to_string(p: *const c_char) -> Option<Vec<u8>> {\n    if p.is_null() {\n        None\n    } else {\n        let len = libc::strlen(p);\n        let slice = std::slice::from_raw_parts(p as *const u8, len);\n        Some(slice.to_vec())\n    }\n}\n\nfn assert_cstr_eq(c: *const c_char, r: *const c_char, label: &str) {\n    unsafe {\n        let cs = cstr_to_string(c);\n        let rs = cstr_to_string(r);\n        assert_eq!(\n            cs,\n            rs,\n            \"{}: C={:?} Rust={:?}\",\n            label,\n            cs.as_ref().map(|v| String::from_utf8_lossy(v).into_owned()),\n            rs.as_ref().map(|v| String::from_utf8_lossy(v).into_owned()),\n        );\n    }\n}\n\nstruct Libs {\n    c: Library,\n    r: Library,\n}\n\nimpl Libs {\n    fn load() -> Self {\n        let c_path = c_so_path();\n        let r_path = rust_so_path();\n        assert!(c_path.exists(), \"C lib not built at {:?}\", c_path);\n        assert!(r_path.exists(), \"Rust lib not built at {:?}\", r_path);\n        unsafe {\n            Libs {\n                c: Library::new(&c_path).expect(\"load C lib\"),\n                r: Library::new(&r_path).expect(\"load Rust lib\"),\n            }\n        }\n    }\n}\n\nfn get_os_arch_via(lib: &Library, input: &str) -> Option<Vec<u8>> {\n    let cstr = CString::new(input).unwrap();\n    unsafe {\n        let f: Symbol<GetOsArchFn> = lib.get(b\"get_os_arch\").unwrap();\n        let buf: *mut c_char = cstr.as_ptr() as *mut c_char;\n        // get_os_arch never modifies its input, but pass a writable copy to be safe.\n        let mut owned: Vec<u8> = cstr.to_bytes_with_nul().to_vec();\n        let p = f(owned.as_mut_ptr() as *mut c_char);\n        if p.is_null() {\n            let _ = buf; // silence unused\n            None\n        } else {\n            let v = cstr_to_string(p);\n            libc::free(p as *mut c_void);\n            v\n        }\n    }\n}\n\nfn w_regexec_via(\n    lib: &Library,\n    pattern: Option<&str>,\n    string: Option<&str>,\n    nmatch: usize,\n) -> (c_int, Vec<CRegmatch>) {\n    unsafe {\n        let f: Symbol<WRegexecFn> = lib.get(b\"w_regexec\").unwrap();\n        let pat_c = pattern.map(|p| CString::new(p).unwrap());\n        let str_c = string.map(|s| CString::new(s).unwrap());\n        let pat_ptr = pat_c\n            .as_ref()\n            .map(|c| c.as_ptr())\n            .unwrap_or(std::ptr::null());\n        let str_ptr = str_c\n            .as_ref()\n            .map(|c| c.as_ptr())\n            .unwrap_or(std::ptr::null());\n        let mut matches: Vec<CRegmatch> = vec![CRegmatch { rm_so: 0, rm_eo: 0 }; nmatch.max(1)];\n        let r = f(pat_ptr, str_ptr, nmatch as libc::size_t, matches.as_mut_ptr());\n        (r, matches)\n    }\n}\n\nfn parse_uname_via(lib: &Library, input: &str) -> OsDataOwned {\n    let mut buf: Vec<u8> = input.as_bytes().to_vec();\n    buf.push(0);\n    let mut osd = OsData {\n        os_name: std::ptr::null_mut(),\n        os_version: std::ptr::null_mut(),\n        os_major: std::ptr::null_mut(),\n        os_minor: std::ptr::null_mut(),\n        os_codename: std::ptr::null_mut(),\n        os_platform: std::ptr::null_mut(),\n        os_build: std::ptr::null_mut(),\n        os_uname: std::ptr::null_mut(),\n        os_arch: std::ptr::null_mut(),\n    };\n    unsafe {\n        let f: Symbol<ParseUnameFn> = lib.get(b\"parse_uname_string\").unwrap();\n        f(buf.as_mut_ptr() as *mut c_char, &mut osd);\n    }\n    OsDataOwned { osd }\n}\n\nstruct OsDataOwned {\n    osd: OsData,\n}\n\nimpl Drop for OsDataOwned {\n    fn drop(&mut self) {\n        unsafe {\n            for p in [\n                self.osd.os_name,\n                self.osd.os_version,\n                self.osd.os_major,\n                self.osd.os_minor,\n                self.osd.os_codename,\n                self.osd.os_platform,\n                self.osd.os_build,\n                self.osd.os_uname,\n                self.osd.os_arch,\n            ] {\n                if !p.is_null() {\n                    libc::free(p as *mut c_void);\n                }\n            }\n        }\n    }\n}\n\nfn assert_osd_eq(c: &OsData, r: &OsData) {\n    assert_cstr_eq(c.os_name, r.os_name, \"os_name\");\n    assert_cstr_eq(c.os_version, r.os_version, \"os_version\");\n    assert_cstr_eq(c.os_major, r.os_major, \"os_major\");\n    assert_cstr_eq(c.os_minor, r.os_minor, \"os_minor\");\n    assert_cstr_eq(c.os_codename, r.os_codename, \"os_codename\");\n    assert_cstr_eq(c.os_platform, r.os_platform, \"os_platform\");\n    assert_cstr_eq(c.os_build, r.os_build, \"os_build\");\n    assert_cstr_eq(c.os_uname, r.os_uname, \"os_uname\");\n    assert_cstr_eq(c.os_arch, r.os_arch, \"os_arch\");\n}\n\n// ---------------- Tests ----------------\n\n#[test]\nfn test_get_os_arch_basic() {\n    let libs = Libs::load();\n    let cases = [\n        \"Linux x86_64\",\n        \"Linux i386\",\n        \"Linux i686\",\n        \"Linux sparc\",\n        \"Linux amd64\",\n        \"Solaris i86pc\",\n        \"Linux ia64\",\n        \"AIX powerpc\",\n        \"Linux armv6l\",\n        \"Linux armv7l\",\n        \"Linux aarch64\",\n        \"Darwin arm64\",\n        \"no arch here\",\n        \"\",\n        \"x86_64 wins over i686 if first\",\n        \"i686 first then x86_64\",\n    ];\n    for s in cases.iter() {\n        let cv = get_os_arch_via(&libs.c, s);\n        let rv = get_os_arch_via(&libs.r, s);\n        assert_eq!(cv, rv, \"input={:?}\", s);\n    }\n}\n\n#[test]\nfn test_w_regexec_basic() {\n    let libs = Libs::load();\n    // Match cases.\n    let pat = \"^([0-9]+)\\\\.*\";\n    let inputs = [\"10.0.19042\", \"0\", \"abc\", \"12.34\"];\n    for inp in inputs.iter() {\n        let (cr, cm) = w_regexec_via(&libs.c, Some(pat), Some(inp), 2);\n        let (rr, rm) = w_regexec_via(&libs.r, Some(pat), Some(inp), 2);\n        assert_eq!(cr, rr, \"result mismatch for {:?}\", inp);\n        if cr != 0 {\n            assert_eq!(cm[0].rm_so, rm[0].rm_so);\n            assert_eq!(cm[0].rm_eo, rm[0].rm_eo);\n            assert_eq!(cm[1].rm_so, rm[1].rm_so);\n            assert_eq!(cm[1].rm_eo, rm[1].rm_eo);\n        }\n    }\n}\n\n#[test]\nfn test_w_regexec_null_inputs() {\n    let libs = Libs::load();\n    let (cr, _) = w_regexec_via(&libs.c, None, Some(\"foo\"), 2);\n    let (rr, _) = w_regexec_via(&libs.r, None, Some(\"foo\"), 2);\n    assert_eq!(cr, 0);\n    assert_eq!(rr, 0);\n\n    let (cr, _) = w_regexec_via(&libs.c, Some(\"foo\"), None, 2);\n    let (rr, _) = w_regexec_via(&libs.r, Some(\"foo\"), None, 2);\n    assert_eq!(cr, 0);\n    assert_eq!(rr, 0);\n}\n\n#[test]\nfn test_parse_uname_windows() {\n    let libs = Libs::load();\n    let cases = [\n        \"Microsoft Windows 10 Pro [Ver: 10.0.19042.1234]\",\n        \"Microsoft Windows Server 2019 [Ver: 10.0.17763]\",\n        \"Microsoft Windows XP [Ver: 5.1.2600]\",\n    ];\n    for input in cases {\n        let c = parse_uname_via(&libs.c, input);\n        let r = parse_uname_via(&libs.r, input);\n        assert_osd_eq(&c.osd, &r.osd);\n    }\n}\n\n#[test]\nfn test_parse_uname_linux_style() {\n    let libs = Libs::load();\n    let cases = [\n        \"Linux |ubuntu [Ubuntu: 20.04 (Focal Fossa)] x86_64\",\n        \"Linux |centos [CentOS Linux: 7.9 (Core)] x86_64\",\n        \"Darwin |darwin [Mac OS X: 11.6 (Big Sur)] arm64\",\n        \"Linux |ubuntu [Ubuntu: 22.04] aarch64\",\n    ];\n    for input in cases {\n        let c = parse_uname_via(&libs.c, input);\n        let r = parse_uname_via(&libs.r, input);\n        assert_osd_eq(&c.osd, &r.osd);\n    }\n}\n\n#[test]\nfn test_parse_uname_no_brackets() {\n    let libs = Libs::load();\n    // No \" [\" substring, no \" [Ver: \" — should leave fields null but still try\n    // get_os_arch on the right-hand path... actually no, that path only runs\n    // inside the `else` branch, but it doesn't depend on \" [\" being found.\n    let input = \"just some text x86_64\";\n    let c = parse_uname_via(&libs.c, input);\n    let r = parse_uname_via(&libs.r, input);\n    assert_osd_eq(&c.osd, &r.osd);\n}\n","structuredPatch":[{"oldStart":308,"oldLines":3,"newStart":308,"newLines":37,"lines":["     let r = parse_uname_via(&libs.r, input);","     assert_osd_eq(&c.osd, &r.osd);"," }","+","+#[test]","+fn test_parse_uname_more_edge_cases() {","+    let libs = Libs::load();","+    let cases = [","+        // Linux without codename","+        \"Linux |linux [Slackware: 14.2] x86_64\",","+        // No platform separator (no `|`) in name","+        \"Linux [Ubuntu: 20.04 (Focal)] x86_64\",","+        // Windows with multi-component build (regex captures group 1, group 2 is the trailing repeat)","+        \"Microsoft Windows 11 [Ver: 10.0.22000.918]\",","+        // Windows minimal version","+        \"Some OS [Ver: 1.2.3]\",","+        // Architecture not in the list","+        \"Linux |alpine [Alpine: 3.15] mips64\",","+        // Empty version inside brackets","+        \"Linux |x [Foo: 1.0] amd64\",","+    ];","+    for input in cases {","+        let c = parse_uname_via(&libs.c, input);","+        let r = parse_uname_via(&libs.r, input);","+        assert_osd_eq(&c.osd, &r.osd);","+    }","+}","+","+#[test]","+fn test_w_regexec_invalid_pattern() {","+    let libs = Libs::load();","+    // Unbalanced bracket — regcomp should fail. Both should return 0.","+    let (cr, _) = w_regexec_via(&libs.c, Some(\"[unbalanced\"), Some(\"foo\"), 2);","+    let (rr, _) = w_regexec_via(&libs.r, Some(\"[unbala