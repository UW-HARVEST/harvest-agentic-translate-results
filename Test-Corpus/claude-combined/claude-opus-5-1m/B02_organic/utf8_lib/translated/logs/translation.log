f..].to_vec();\n        let r_suffix = bytes[r_off..].to_vec();\n        (c_suffix, r_suffix)\n    }\n}\n\nfn run_filter_pair(input: &[u8], replacement: bool) -> (Vec<u8>, Vec<u8>) {\n    let cstr = CString::new(input).unwrap();\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).expect(\"load c\");\n        let rust_lib = Library::new(rust_lib_path()).expect(\"load rust\");\n\n        let c_fn: Symbol<WUtf8Filter> = c_lib.get(b\"w_utf8_filter\").expect(\"c sym\");\n        let r_fn: Symbol<WUtf8Filter> = rust_lib.get(b\"w_utf8_filter\").expect(\"rust sym\");\n\n        // We use the C library's free since both libs use malloc. To be safe\n        // we use libc free via dlsym from c lib (which links to libc).\n        let libc = Library::new(\"libc.so.6\").expect(\"load libc\");\n        let free_sym: Symbol<FreeFn> = libc.get(b\"free\").expect(\"free sym\");\n\n        let c_ret = c_fn(cstr.as_ptr(), replacement);\n        let r_ret = r_fn(cstr.as_ptr(), replacement);\n\n        let c_bytes = cstr_from_ptr(c_ret);\n        let r_bytes = cstr_from_ptr(r_ret);\n\n        if !c_ret.is_null() {\n            free_sym(c_ret as *mut c_void);\n        }\n        if !r_ret.is_null() {\n            free_sym(r_ret as *mut c_void);\n        }\n\n        (c_bytes, r_bytes)\n    }\n}\n\nfn assert_drop(input: &[u8]) {\n    let (c, r) = run_drop_pair(input);\n    assert_eq!(c, r, \"w_utf8_drop mismatch for input {:?}\", input);\n}\n\nfn assert_filter(input: &[u8], replacement: bool) {\n    let (c, r) = run_filter_pair(input, replacement);\n    assert_eq!(\n        c, r,\n        \"w_utf8_filter mismatch for input {:?} replacement={}\",\n        input, replacement\n    );\n}\n\n// ---------- w_utf8_drop tests ----------\n\n#[test]\nfn test_drop_empty() {\n    assert_drop(b\"\");\n}\n\n#[test]\nfn test_drop_ascii() {\n    assert_drop(b\"hello world\");\n}\n\n#[test]\nfn test_drop_2byte() {\n    // U+00E9 (é) -> 0xC3 0xA9\n    assert_drop(&[b'h', b'e', 0xC3, 0xA9]);\n}\n\n