st_filter_empty_repl() {\n    assert_filter(b\"\", true);\n}\n\n#[test]\nfn test_filter_ascii_no_repl() {\n    assert_filter(b\"hello world\", false);\n}\n\n#[test]\nfn test_filter_ascii_repl() {\n    assert_filter(b\"hello world\", true);\n}\n\n#[test]\nfn test_filter_valid_utf8_no_repl() {\n    assert_filter(\"Hello, 世界! 😀\".as_bytes(), false);\n}\n\n#[test]\nfn test_filter_valid_utf8_repl() {\n    assert_filter(\"Hello, 世界! 😀\".as_bytes(), true);\n}\n\n#[test]\nfn test_filter_invalid_no_repl() {\n    let mut v = b\"hello\".to_vec();\n    v.push(0xFF);\n    v.extend_from_slice(b\"world\");\n    assert_filter(&v, false);\n}\n\n#[test]\nfn test_filter_invalid_with_repl() {\n    let mut v = b\"hello\".to_vec();\n    v.push(0xFF);\n    v.extend_from_slice(b\"world\");\n    assert_filter(&v, true);\n}\n\n#[test]\nfn test_filter_only_invalid_no_repl() {\n    assert_filter(&[0xFF, 0xFE, 0xFD], false);\n}\n\n#[test]\nfn test_filter_only_invalid_with_repl() {\n    assert_filter(&[0xFF, 0xFE, 0xFD], true);\n}\n\n#[test]\nfn test_filter_surrogate_no_repl() {\n    assert_filter(&[0xED, 0xA0, 0x80], false);\n}\n\n#[test]\nfn test_filter_surrogate_repl() {\n    assert_filter(&[0xED, 0xA0, 0x80], true);\n}\n\n#[test]\nfn test_filter_overlong_no_repl() {\n    assert_filter(&[0xC0, 0x80, b'X'], false);\n}\n\n#[test]\nfn test_filter_overlong_repl() {\n    assert_filter(&[0xC0, 0x80, b'X'], true);\n}\n\n#[test]\nfn test_filter_many_invalid_repl() {\n    // Tests realloc path (more than 3 invalid bytes -> repl > REPLACEMENT_INC threshold)\n    let mut v = Vec::new();\n    for _ in 0..2000 {\n        v.push(0xFF);\n    }\n    assert_filter(&v, true);\n}\n\n#[test]\nfn test_filter_many_invalid_no_repl() {\n    let mut v = Vec::new();\n    for _ in 0..2000 {\n        v.push(0xFF);\n    }\n    assert_filter(&v, false);\n}\n\n#[test]\nfn test_filter_mixed_valid_invalid_repl() {\n    let mut v = b\"prefix\".to_vec();\n    v.extend_from_slice(&[0xFF, 0xFE]);\n    v.extend_from_slice(\"中文\".