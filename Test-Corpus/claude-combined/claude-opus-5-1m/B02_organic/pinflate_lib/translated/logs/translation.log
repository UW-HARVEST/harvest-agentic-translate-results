          c_out.as_mut_ptr() as *mut c_void,\n            c_out.len() as c_int,\n        )\n    };\n    let r_rc = unsafe {\n        (libs.rust_pinflate)(\n            r_in.as_mut_ptr() as *mut c_void,\n            r_in.len() as c_int,\n            r_out.as_mut_ptr() as *mut c_void,\n            r_out.len() as c_int,\n        )\n    };\n    (c_rc, c_out, r_rc, r_out)\n}\n\nfn check(libs: &Libs, label: &str, input: &[u8], expected_out: &[u8]) {\n    let cap = expected_out.len().max(1) + 16;\n    let (c_rc, c_out, r_rc, r_out) = run_both(libs, input, cap);\n    assert_eq!(c_rc, r_rc, \"{}: return code mismatch (C={}, Rust={})\", label, c_rc, r_rc);\n    assert_eq!(\n        &c_out[..expected_out.len()],\n        expected_out,\n        \"{}: C output mismatch\",\n        label\n    );\n    assert_eq!(c_out, r_out, \"{}: C/Rust output buffer mismatch\", label);\n}\n\n#[test]\nfn test_empty_fixed_block() {\n    unsafe {\n        let libs = load();\n        // empty fixed block - just final + fixed + EOB\n        let input: &[u8] = &[0x03, 0x00];\n        check(&libs, \"empty_fixed\", input, &[]);\n    }\n}\n\n#[test]\nfn test_hello_world_fixed() {\n    unsafe {\n        let libs = load();\n        let input: &[u8] = &[\n            0xf3, 0x48, 0xcd, 0xc9, 0xc9, 0xd7, 0x51, 0x28, 0xcf, 0x2f, 0xca, 0x49, 0x51, 0x04,\n            0x00,\n        ];\n        check(&libs, \"hello\", input, b\"Hello, world!\");\n    }\n}\n\n#[test]\nfn test_aaa_repeated() {\n    unsafe {\n        let libs = load();\n        let input: &[u8] = &[0x4b, 0x4c, 0xa4, 0x3d, 0x00, 0x00];\n        let expected = vec![b'a'; 100];\n        check(&libs, \"aaa\", input, &expected);\n    }\n}\n\n#[test]\nfn test_quick_brown_fox_dynamic() {\n    unsafe {\n        let libs = load();\n        let input: &[u8] = &[\n            0x0b, 0xc9, 0x48, 0x55, 0x28, 0x2c, 0xcd, 0x4c, 0xce, 0x56, 0x48, 0x2a, 0xca, 0x2f,\n            0xcf, 0x53, 0x48, 0xcb, 0xaf, 0x50, 0xc8, 0x2a, 0xcd, 0x2d, 0x28, 0x56, 0xc8, 0x2f,\n            0x4b, 0x2d, 0x52, 0x28, 0x01, 0x4a, 0xe7, 0x24, 0x56, 0x55, 0x2a, 0xa4, 0xe4, 0xa7,\n            0xeb, 0x29, 0x84, 0x8c, 0x2a, 0x1e, 0x7c, 0x8a, 0x01,\n        ];\n        let expected: Vec<u8> = b\"The quick brown fox jumps over the lazy dog. \"\n            .iter()\n            .copied()\n            .cycle()\n            .take(b\"The quick brown fox jumps over the lazy dog. \".len() * 10)\n            .collect();\n        check(&libs, \"fox\", input, &expected);\n    }\n}\n\n#[test]\nfn test_stored_block() {\n    unsafe {\n        let libs = load();\n        let input: &[u8] = &[\n            0x01, 0xc8, 0x00, 0x37, 0xff, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58,\n            0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58,\n            0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58,\n            0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58,\n            0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58,\n            0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58,\n            0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58,\n            0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58,\n            0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58,\n            0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58,\n            0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58,\n            0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58,\n            0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58,\n            0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58, 0x58,\n            0x58, 0x58, 0x58, 0x58, 0x58, 0