, (0, 5), (-5, 6)],\n        ];\n\n        for seq in &sequences {\n            s_c(0x31415926);\n            let cs = run_hmput_sequence(&c, seq);\n            s_r(0x31415926);\n            let rs = run_hmput_sequence(&r, seq);\n            assert_eq!(cs, rs, \"hmput sequence mismatch for seq.len()={}\", seq.len());\n        }\n    }\n}\n\n// ============================================================================\n// Verify the symbol parity between the two .so files.\n// ============================================================================\n\n#[test]\nfn test_symbol_parity() {\n    use std::process::Command;\n    let c_out = Command::new(\"nm\")\n        .args([\"-D\", \"--defined-only\", C_SO])\n        .output()\n        .expect(\"nm on C .so failed\");\n    let r_out = Command::new(\"nm\")\n        .args([\"-D\", \"--defined-only\", RUST_SO])\n        .output()\n        .expect(\"nm on Rust .so failed\");\n\n    fn collect_text_syms(out: &[u8]) -> Vec<String> {\n        let s = String::from_utf8_lossy(out);\n        let mut v = Vec::new();\n        for line in s.lines() {\n            // Format: addr type name\n            let parts: Vec<&str> = line.split_whitespace().collect();\n            if parts.len() == 3 && parts[1] == \"T\" {\n                let n = parts[2];\n                // Ignore Rust internal exports / cross-platform autogen ones\n                if n.starts_with('_')\n                    || n.starts_with(\"rust_\")\n                    || n == \"rust_eh_personality\"\n                    || n.starts_with(\"__rust\")\n                {\n                    continue;\n                }\n                v.push(n.to_string());\n            }\n        }\n        v.sort();\n        v\n    }\n\n    let c_syms = collect_text_syms(&c_out.stdout);\n    let r_syms = collect_text_syms(&r_out.stdout);\n\n    for s in &c_syms {\n        assert!(\n            r_syms.contains(s),\n            \"Rust .so missing symbol {} (C exports it)\",\n            s\n        );\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
