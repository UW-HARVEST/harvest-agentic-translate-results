{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_6xgs7g6hhibod2ly6fi3qhg32w6dvbk32jaavlwstq33egvy55pa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01E8nRNfK4WD8NCY8REd3AEX","name":"Write","input":{"file_path":"/tmp/harvest-translate-gtgGSD/translated_rust/tests/ffi_compare.rs","content":"// Integration tests that load BOTH the C .so and the Rust .so via libloading,\n// and compare their outputs through FFI to verify byte-identical behavior.\n\nuse libloading::{Library, Symbol};\nuse std::ffi::{c_char, c_int};\nuse std::io::{Read, Seek, SeekFrom, Write};\nuse std::os::unix::io::{AsRawFd, FromRawFd, IntoRawFd, RawFd};\nuse std::path::PathBuf;\nuse std::sync::Mutex;\n\n// Serialise stdout-capturing tests so they don't race on the global fd 1.\nstatic STDOUT_LOCK: Mutex<()> = Mutex::new(());\n\nfn workspace_root() -> PathBuf {\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n}\n\nfn c_lib_path() -> PathBuf {\n    workspace_root().join(\"c_src/build/libtranslated_rust.so\")\n}\n\nfn rust_lib_path() -> PathBuf {\n    workspace_root().join(\"target/release/libtranslated_rust.so\")\n}\n\n/// Capture everything written to fd 1 (stdout) by `f` and return the bytes.\n/// Uses dup/dup2 around a tempfile so we capture libc::printf output too.\nfn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {\n    // Ensure any buffered Rust stdout is flushed first (paranoia).\n    let _ = std::io::stdout().flush();\n    // Also flush libc stdout.\n    unsafe {\n        libc::fflush(std::ptr::null_mut());\n    }\n\n    // Save the current stdout (fd 1).\n    let saved_fd: RawFd = unsafe { libc::dup(1) };\n    assert!(saved_fd >= 0, \"dup(stdout) failed\");\n\n    // Create a tempfile to redirect into.\n    let mut tmp = tempfile_rs();\n    let tmp_fd = tmp.as_raw_fd();\n\n    // Redirect fd 1 -> tmp file.\n    let dup_ret = unsafe { libc::dup2(tmp_fd, 1) };\n    assert!(dup_ret >= 0, \"dup2 failed\");\n\n    // Run the user code.\n    f();\n\n    // Flush libc and Rust stdout buffers into the tempfile.\n    unsafe {\n        libc::fflush(std::ptr::null_mut());\n    }\n    let _ = std::io::stdout().flush();\n\n    // Restore stdout.\n    let restore_ret = unsafe { libc::dup2(saved_fd, 1) };\n    assert!(restore_ret >= 0, \"dup2 restore failed\");\n    unsafe {\n        libc::close(saved_fd);\n    }\n\n    // Read the tempfile back.\n    tmp.seek(SeekFrom::Start(0)).expect(\"seek failed\");\n    let mut buf = Vec::new();\n    tmp.read_to_end(&mut buf).expect(\"read failed\");\n    buf\n}\n\nfn tempfile_rs() -> std::fs::File {\n    // Make a unique tempfile with libc, then take ownership as a std File.\n    let template = std::ffi::CString::new(\"/tmp/rust_c_compare_XXXXXX\").unwrap();\n    let raw = template.into_raw();\n    let fd = unsafe { libc::mkstemp(raw) };\n    // Reclaim and free template memory (we don't care about the path; we'll unlink via O_TMPFILE-like trick).\n    let cstring = unsafe { std::ffi::CString::from_raw(raw) };\n    if fd < 0 {\n        panic!(\"mkstemp failed\");\n    }\n    // Unlink immediately so it disappears on close.\n    unsafe {\n        libc::unlink(cstring.as_ptr());\n    }\n    unsafe { std::fs::File::from_raw_fd(fd as RawFd) }\n}\n\n#[allow(dead_code)]\nfn into_fd(file: std::fs::File) -> RawFd {\n    file.into_raw_fd()\n}\n\n// -----------------------------------------------------------------------------\n// Helpers: load lib + a typed function symbol\n// -----------------------------------------------------------------------------\n\nunsafe fn load_lib(path: &PathBuf) -> Library {\n    Library::new(path).unwrap_or_else(|e| panic!(\"failed to load {:?}: {}\", path, e))\n}\n\n// -----------------------------------------------------------------------------\n// check_permissions\n// -----------------------------------------------------------------------------\n#[test]\nfn test_check_permissions_matches() {\n    unsafe {\n        let c_lib = load_lib(&c_lib_path());\n        let r_lib = load_lib(&rust_lib_path());\n        let c_fn: Symbol<unsafe extern \"C\" fn(c_int, c_int) -> c_int> =\n            c_lib.get(b\"check_permissions\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(c_int, c_int) -> c_int> =\n            r_lib.get(b\"check_permissions\").unwrap();\n\n        let cases = [\n            (0o644, 0o600),\n            (0o644, 0o400),\n            (0o644, 0o200),\n            (0o644, 0o100),\n            (0o755, 0o700),\n            (0o000, 0o000),\n            (-1, 0o600),\n            (0, 0o400),\n        ];\n        for (perms, required) in cases.iter().copied() {\n            assert_eq!(\n                c_fn(perms, required),\n                r_fn(perms, required),\n                \"check_permissions({:o}, {:o})\",\n                perms,\n                required\n            );\n        }\n    }\n}\n\n// -----------------------------------------------------------------------------\n// safe_add\n// -----------------------------------------------------------------------------\n#[test]\nfn test_safe_add_matches() {\n    let _g = STDOUT_LOCK.lock().unwrap();\n    unsafe {\n        let c_lib = load_lib(&c_lib_path());\n        let r_lib = load_lib(&rust_lib_path());\n\n        let c_fn: Symbol<unsafe extern \"C\" fn(c_int, c_int, c_int) -> c_int> =\n            c_lib.get(b\"safe_add\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(c_int, c_int, c_int) -> c_int> =\n            r_lib.get(b\"safe_add\").unwrap();\n\n        let cases = [\n            (1, 2, 0o644),\n            (10, -3, 0o600),\n            (5, 7, 0o400), // missing write\n            (5, 7, 0o200), // missing read\n            (5, 7, 0o000),\n            (i32::MAX, 1, 0o644), // overflow case in C is UB, but matching wrap\n        ];\n        for (a, b, perms) in cases.iter().copied() {\n            let c_out_capture = capture_stdout(|| {\n                let v = c_fn(a, b, perms);\n                std::hint::black_box(v);\n            });\n            let r_out_capture = capture_stdout(|| {\n                let v = r_fn(a, b, perms);\n                std::hint::black_box(v);\n            });\n            // Re-run to fetch return values without capturing redirection state.\n            let c_ret = capture_stdout(|| {});\n            assert_eq!(c_ret, b\"\");\n            let cv = c_fn(a, b, perms);\n            let _ = capture_stdout(|| {});\n            let rv = r_fn(a, b, perms);\n            let _ = capture_stdout(|| {});\n\n            assert_eq!(cv, rv, \"safe_add({},{},{:o}) return\", a, b, perms);\n            assert_eq!(\n                c_out_capture, r_out_capture,\n                \"safe_add({},{},{:o}) stdout\",\n                a, b, perms\n            );\n        }\n    }\n}\n\n// -----------------------------------------------------------------------------\n// create_result_string\n// -----------------------------------------------------------------------------\n#[test]\nfn test_create_result_string_matches() {\n    unsafe {\n        let c_lib = load_lib(&c_lib_path());\n        let r_lib = load_lib(&rust_lib_path());\n\n        let c_fn: Symbol<unsafe extern \"C\" fn(*const c_char, c_int) -> *mut c_char> =\n            c_lib.get(b\"create_result_string\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(*const c_char, c_int) -> *mut c_char> =\n            r_lib.get(b\"create_result_string\").unwrap();\n\n        let cases: &[(&[u8], i32)] = &[\n            (b\"multiply\\0\", 42),\n            (b\"add\\0\", 0),\n            (b\"\\0\", -1),\n            (b\"long_op_name\\0\", 1234567),\n        ];\n        for (op, val) in cases.iter().copied() {\n            let cp = c_fn(op.as_ptr() as *const c_char, val);\n            let rp = r_fn(op.as_ptr() as *const c_char, val);\n            assert!(!cp.is_null());\n            assert!(!rp.is_null());\n            let c_bytes = std::ffi::CStr::from_ptr(cp).to_bytes().to_vec();\n            let r_bytes = std::ffi::CStr::from_ptr(rp).to_bytes().to_vec();\n            assert_eq!(c_bytes, r_bytes, \"create_result_string({:?},{})\", op, val);\n            libc::free(cp as *mut libc::c_void);\n            libc::free(rp as *mut libc::c_void);\n        }\n    }\n}\n\n// -----------------------------------------------------------------------------\n// multiply_with_log\n// -----------------------------------------------------------------------------\n#[test]\nfn test_multiply_with_log_matches() {\n    unsafe {\n        let c_lib = load_lib(&c_lib_path());\n        let r_lib = load_lib(&rust_lib_path());\n\n        let c_fn: Symbol<unsafe extern \"C\" fn(c_int, c_int, *mut *mut c_char) -> c_int> =\n            c_lib.get(b\"multiply_with_log\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(c_int, c_int, *mut *mut c_char) -> c_int> =\n            r_lib.get(b\"multiply_with_log\").unwrap();\n\n        let cases = [(2, 3), (-4, 5), (0, 99), (7, 0)];\n        for (a, b) in cases.iter().copied() {\n            let mut c_log: *mut c_char = std::ptr::null_mut();\n            let mut r_log: *mut c_char = std::ptr::null_mut();\n            let cv = c_fn(a, b, &mut c_log);\n            let rv = r_fn(a, b, &mut r_log);\n            assert_eq!(cv, rv, \"multiply_with_log({},{}) return\", a, b);\n            assert!(!c_log.is_null());\n            assert!(!r_log.is_null());\n            let c_bytes = std::ffi::CStr::from_ptr(c_log).to_bytes().to_vec();\n            let r_bytes = std::ffi::CStr::from_ptr(r_log).to_bytes().to_vec();\n            assert_eq!(c_bytes, r_bytes, \"multiply_with_log({},{}) log\", a, b);\n            libc::free(c_log as *mut libc::c_void);\n            libc::free(r_log as *mut libc::c_void);\n        }\n    }\n}\n\n// -----------------------------------------------------------------------------\n// copy_and_sum\n// -----------------------------------------------------------------------------\n#[test]\nfn test_copy_and_sum_matches() {\n    let _g = STDOUT_LOCK.lock().unwrap();\n    unsafe {\n        let c_lib = load_lib(&c_lib_path());\n        let r_lib = load_lib(&rust_lib_path());\n\n        let c_fn: Symbol<unsafe extern \"C\" fn(*mut c_int, c_int) -> c_int> =\n            c_lib.get(b\"copy_and_sum\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(*mut c_int, c_int) -> c_int> =\n            r_lib.get(b\"copy_and_sum\").unwrap();\n\n        // Non-null arrays\n        let mut a = [1, 2, 3, 4, 5];\n        let mut b = [-10, 20, -30];\n        let mut c = [0i32; 0]; // zero count\n\n        let pairs: &[(&mut [c_int], c_int)] = &[(&mut a, 5), (&mut b, 3), (&mut c, 0)];\n        for (arr, count) in pairs.iter().map(|(s, c)| (s.as_ptr() as *mut c_int, *c)) {\n            let c_out = capture_stdout(|| {\n                let _ = c_fn(arr, count);\n            });\n            let r_out = capture_stdout(|| {\n                let _ = r_fn(arr, count);\n            });\n            assert_eq!(c_out, r_out, \"copy_and_sum stdout differs\");\n            // Compare actual return values too\n            let cv = c_fn(arr, count);\n            let _ = capture_stdout(|| {});\n            let rv = r_fn(arr, count);\n            let _ = capture_stdout(|| {});\n            assert_eq!(cv, rv, \"copy_and_sum return differs\");\n        }\n\n        // NULL src case - should print and return -1\n        let c_null_out = capture_stdout(|| {\n            let _ = c_fn(std::ptr::null_mut(), 5);\n        });\n        let r_null_out = capture_stdout(|| {\n            let _ = r_fn(std::ptr::null_mut(), 5);\n        });\n        assert_eq!(c_null_out, r_null_out);\n        assert_eq!(c_fn(std::ptr::null_mut(), 5), -1);\n        assert_eq!(r_fn(std::ptr::null_mut(), 5), -1);\n        // Drain anything those last calls printed.\n        let _ = capture_stdout(|| {});\n    }\n}\n\n// -----------------------------------------------------------------------------\n// compare_operations\n// -----------------------------------------------------------------------------\n#[test]\nfn test_compare_operations_matches() {\n    let _g = STDOUT_LOCK.lock().unwrap();\n    unsafe {\n        let c_lib = load_lib(&c_lib_path());\n        let r_lib = load_lib(&rust_lib_path());\n\n        let c_fn: Symbol<unsafe extern \"C\" fn(*const c_char, *const c_char) -> c_int> =\n            c_lib.get(b\"compare_operations\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(*const c_char, *const c_char) -> c_int> =\n            r_lib.get(b\"compare_operations\").unwrap();\n\n        let pairs: &[(&[u8], &[u8])] = &[\n            (b\"foo\\0\", b\"foo\\0\"),\n            (b\"foo\\0\", b\"bar\\0\"),\n            (b\"abc\\0\", b\"abd\\0\"),\n            (b\"\\0\", b\"\\0\"),\n            (b\"a\\0\", b\"ab\\0\"),\n        ];\n        for (x, y) in pairs.iter().copied() {\n            let cv = c_fn(x.as_ptr() as *const c_char, y.as_ptr() as *const c_char);\n            let rv = r_fn(x.as_ptr() as *const c_char, y.as_ptr() as *const c_char);\n            // strcmp signs only; normalise\n            assert_eq!(cv.signum(), rv.signum(), \"compare_operations sign differ\");\n        }\n\n        // NULL cases\n        let c_out = capture_stdout(|| {\n            let v = c_fn(std::ptr::null(), b\"x\\0\".as_ptr() as *const c_char);\n            assert_eq!(v, -1);\n        });\n        let r_out = capture_stdout(|| {\n            let v = r_fn(std::ptr::null(), b\"x\\0\".as_ptr() as *const c_char);\n            assert_eq!(v, -1);\n        });\n        assert_eq!(c_out, r_out);\n\n        let c_out = capture_stdout(|| {\n            let v = c_fn(b\"x\\0\".as_ptr() as *const c_char, std::ptr::null());\n            assert_eq!(v, -1);\n        });\n        let r_out = capture_stdout(|| {\n            let v = r_fn(b\"x\\0\".as_ptr() as *const c_char, std::ptr::null());\n            assert_eq!(v, -1);\n        });\n        assert_eq!(c_out, r_out);\n    }\n}\n\n// -----------------------------------------------------------------------------\n// complexmode\n// -----------------------------------------------------------------------------\n#[test]\nfn test_complexmode_matches() {\n    let _g = STDOUT_LOCK.lock().unwrap();\n    unsafe {\n        let c_lib = load_lib(&c_lib_path());\n        let r_lib = load_lib(&rust_lib_path());\n\n        let c_fn: Symbol<unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int> =\n            c_lib.get(b\"complexmode\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int> =\n            r_lib.get(b\"complexmode\").unwrap();\n\n        let cases = [\n            (1, 2, 3, 0),    // addition\n            (1, -5, 10, 0),\n            (2, 3, 4, 0),    // multiplication\n            (2, 0, 0, 0),\n            (3, 1, 2, 3),    // array sum\n            (3, -1, -2, -3),\n            (4, 2, 3, 4),    // complex w/ exec perm? 0644 doesn't have 0100 -> falls to add path\n            (4, 10, 20, 30),\n            (5, 0, 0, 0),    // invalid mode\n            (0, 0, 0, 0),    // invalid mode\n            (-1, 0, 0, 0),   // invalid mode\n        ];\n        for (m, v1, v2, v3) in cases.iter().copied() {\n            let c_out = capture_stdout(|| {\n                let _ = c_fn(m, v1, v2, v3);\n            });\n            let r_out = capture_stdout(|| {\n                let _ = r_fn(m, v1, v2, v3);\n            });\n            assert_eq!(\n                c_out, r_out,\n                \"complexmode({},{},{},{}) stdout differs.\\nC:    {}\\nRust: {}\",\n                m,\n                v1,\n                v2,\n                v3,\n                String::from_utf8_lossy(&c_out),\n                String::from_utf8_lossy(&r_out)\n            );\n            // Compare return values\n            let cv = c_fn(m, v1, v2, v3);\n            let _ = capture_stdout(|| {});\n            let rv = r_fn(m, v1, v2, v3);\n            let _ = capture_stdout(|| {});\n            assert_eq!(cv, rv, \"complexmode({},{},{},{}) return\", m, v1, v2, v3);\n        }\n    }\n}\n\n// -----------------------------------------------------------------------------\n// Symbol parity: every T-symbol exported by the C .so must exist in Rust .so\n// -----------------------------------------------------------------------------\n#[test]\nfn test_symbol_parity() {\n    use std::process::Command;\n    let c_so = c_lib_path();\n    let r_so = rust_lib_path();\n\n    fn t_syms(path: &PathBuf) -> Vec<String> {\n        let out = Command::new(\"nm\")\n            .arg(\"-D\")\n            .arg(path)\n            .output()\n            .expect(\"nm failed\");\n        let s = String::from_utf8_lossy(&out.stdout);\n        let mut syms = Vec::new();\n        for line in s.lines() {\n            let parts: Vec<&str> = line.split_whitespace().collect();\n            if parts.len() >= 3 && parts[1] == \"T\" {\n                syms.push(parts[2].to_string());\n            }\n        }\n        syms.sort();\n        syms\n    }\n\n    let c_syms = t_syms(&c_so);\n    let r_syms = t_syms(&r_so);\n\n    let expected = [\"check_permissions\", \"compare_operations\", \"complexmode\",\n                    \"copy_and_sum\", \"create_result_string\", \"multiply_with_log\", \"safe_add\"];\n    for sym in expected.iter() {\n        assert!(c_syms.iter().any(|s| s == sym), \"C lib missing {}\", sym);\n        assert!(r_syms.iter().any(|s| s == sym), \"Rust lib missing {}\", sym);\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":173,"cache_read_input_tokens":24639,"cache_creation":{"ephemeral_5m_input_tokens":173,"ephemeral_1h_input_tokens":0},"output_tokens":29,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"8154ed6f-5742-4eb2-893f-2fbf6c92f5f7","uuid":"e665a11c-3926-4682-9ba3-085498889fed"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01E8nRNfK4WD8NCY8REd3AEX","type":"tool_result","content":"File created successfully at: /tmp/harvest-translate-gtgGSD/translated_rust/tests/ffi_compare.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"8154ed6f-5742-4eb2-893f-2fbf6c92f5f7","uuid":"5f213c38-6e97-4245-bf08-81038dc2f682","timestamp":"2026-05-30T01:28:33.022Z","tool_use_result":{"type":"create","filePath":"/tmp/harvest-translate-gtgGSD/translated_rust/tests/ffi_compare.rs","content":"// Integration tests that load BOTH the C .so and the Rust .so via libloading,\n// and compare their outputs through FFI to verify byte-identical behavior.\n\nuse libloading::{Library, Symbol};\nuse std::ffi::{c_char, c_int};\nuse std::io::{Read, Seek, SeekFrom, Write};\nuse std::os::unix::io::{AsRawFd, FromRawFd, IntoRawFd, RawFd};\nuse std::path::PathBuf;\nuse std::sync::Mutex;\n\n// Serialise stdout-capturing tests so they don't race on the global fd 1.\nstatic STDOUT_LOCK: Mutex<()> = Mutex::new(());\n\nfn workspace_root() -> PathBuf {\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n}\n\nfn c_lib_path() -> PathBuf {\n    workspace_root().join(\"c_src/build/libtranslated_rust.so\")\n}\n\nfn rust_lib_path() -> PathBuf {\n    workspace_root().join(\"target/release/libtranslated_rust.so\")\n}\n\n/// Capture everything written to fd 1 (stdout) by `f` and return the bytes.\n/// Uses dup/dup2 around a tempfile so we capture libc::printf output too.\nfn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {\n    // Ensure any buffered Rust stdout is flushed first (paranoia).\n    let _ = std::io::stdout().flush();\n    // Also flush libc stdout.\n    unsafe {\n        libc::fflush(std::ptr::null_mut());\n    }\n\n    // Save the current stdout (fd 1).\n    let saved_fd: RawFd = unsafe { libc::dup(1) };\n    assert!(saved_fd >= 0, \"dup(stdout) failed\");\n\n    // Create a tempfile to redirect into.\n    let mut tmp = tempfile_rs();\n    let tmp_fd = tmp.as_raw_fd();\n\n    // Redirect fd 1 -> tmp file.\n    let dup_ret = unsafe { libc::dup2(tmp_fd, 1) };\n    assert!(dup_ret >= 0, \"dup2 failed\");\n\n    // Run the user code.\n    f();\n\n    // Flush libc and Rust stdout buffers into the tempfile.\n    unsafe {\n        libc::fflush(std::ptr::null_mut());\n    }\n    let _ = std::io::stdout().flush();\n\n    // Restore stdout.\n    let restore_ret = unsafe { libc::dup2(saved_fd, 1) };\n    assert!(restore_ret >= 0, \"dup2 restore failed\");\n    unsafe {\n        libc::close(saved_fd);\n    }\n\n    // Read the tempfile back.\n    tmp.seek(SeekFrom::Start(0)).expect(\"seek failed\");\n    let mut buf = Vec::new();\n    tmp.read_to_end(&mut buf).expect(\"read failed\");\n    buf\n}\n\nfn tempfile_rs() -> std::fs::File {\n    // Make a unique tempfile with libc, then take ownership as a std File.\n    let template = std::ffi::CString::new(\"/tmp/rust_c_compare_XXXXXX\").unwrap();\n    let raw = template.into_raw();\n    let fd = unsafe { libc::mkstemp(raw) };\n    // Reclaim and free template memory (we don't care about the path; we'll unlink via O_TMPFILE-like trick).\n    let cstring = unsafe { std::ffi::CString::from_raw(raw) };\n    if fd < 0 {\n        panic!(\"mkstemp failed\");\n    }\n    // Unlink immediately so it disappears on close.\n    unsafe {\n        libc::unlink(cstring.as_ptr());\n    }\n    unsafe { std::fs::File::from_raw_fd(fd as RawFd) }\n}\n\n#[allow(dead_code)]\nfn into_fd(file: std::fs::File) -> RawFd {\n    file.into_raw_fd()\n}\n\n// -----------------------------------------------------------------------------\n// Helpers: load lib + a typed function symbol\n// -----------------------------------------------------------------------------\n\nunsafe fn load_lib(path: &PathBuf) -> Library {\n    Library::new(path).unwrap_or_else(|e| panic!(\"failed to load {:?}: {}\", path, e))\n}\n\n// -----------------------------------------------------------------------------\n// check_permissions\n// -----------------------------------------------------------------------------\n#[test]\nfn test_check_permissions_matches() {\n    unsafe {\n        let c_lib = load_lib(&c_lib_path());\n        let r_lib = load_lib(&rust_lib_path());\n        let c_fn: Symbol<unsafe extern \"C\" fn(c_int, c_int) -> c_int> =\n            c_lib.get(b\"check_permissions\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(c_int, c_int) -> c_int> =\n            r_lib.get(b\"check_permissions\").unwrap();\n\n        let cases = [\n            (0o644, 0o600),\n            (0o644, 0o400),\n            (0o644, 0o200),\n            (0o644, 0o100),\n            (0o755, 0o700),\n            (0o000, 0o000),\n            (-1, 0o600),\n            (0, 0o400),\n        ];\n        for (perms, required) in cases.iter().copied() {\n            assert_eq!(\n                c_fn(perms, required),\n                r_fn(perms, required),\n                \"check_permissions({:o}, {:o})\",\n                perms,\n                required\n            );\n        }\n    }\n}\n\n// -----------------------------------------------------------------------------\n// safe_add\n// -----------------------------------------------------------------------------\n#[test]\nfn test_safe_add_matches() {\n    let _g = STDOUT_LOCK.lock().unwrap();\n    unsafe {\n        let c_lib = load_lib(&c_lib_path());\n        let r_lib = load_lib(&rust_lib_path());\n\n        let c_fn: Symbol<unsafe extern \"C\" fn(c_int, c_int, c_int) -> c_int> =\n            c_lib.get(b\"safe_add\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(c_int, c_int, c_int) -> c_int> =\n            r_lib.get(b\"safe_add\").unwrap();\n\n        let cases = [\n            (1, 2, 0o644),\n            (10, -3, 0o600),\n            (5, 7, 0o400), // missing write\n            (5, 7, 0o200), // missing read\n            (5, 7, 0o000),\n            (i32::MAX, 1, 0o644), // overflow case in C is UB, but matching wrap\n        ];\n        for (a, b, perms) in cases.iter().copied() {\n            let c_out_capture = capture_stdout(|| {\n                let v = c_fn(a, b, perms);\n                std::hint::black_box(v);\n            });\n            let r_out_capture = capture_stdout(|| {\n                let v = r_fn(a, b, perms);\n                std::hint::black_box(v);\n            });\n            // Re-run to fetch return values without capturing redirection state.\n            let c_ret = capture_stdout(|| {});\n            assert_eq!(c_ret, b\"\");\n            let cv = c_fn(a, b, perms);\n            let _ = capture_stdout(|| {});\n            let rv = r_fn(a, b, perms);\n            let _ = capture_stdout(|| {});\n\n            assert_eq!(cv, rv, \"safe_add({},{},{:o}) return\", a, b, perms);\n            assert_eq!(\n                c_out_capture, r_out_capture,\n                \"safe_add({},{},{:o}) stdout\",\n                a, b, perms\n            );\n        }\n    }\n}\n\n// -----------------------------------------------------------------------------\n// create_result_string\n// -----------------------------------------------------------------------------\n#[test]\nfn test_create_result_string_matches() {\n    unsafe {\n        let c_lib = load_lib(&c_lib_path());\n        let r_lib = load_lib(&rust_lib_path());\n\n        let c_fn: Symbol<unsafe extern \"C\" fn(*const c_char, c_int) -> *mut c_char> =\n            c_lib.get(b\"create_result_string\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(*const c_char, c_int) -> *mut c_char> =\n            r_lib.get(b\"create_result_string\").unwrap();\n\n        let cases: &[(&[u8], i32)] = &[\n            (b\"multiply\\0\", 42),\n            (b\"add\\0\", 0),\n            (b\"\\0\", -1),\n            (b\"long_op_name\\0\", 1234567),\n        ];\n        for (op, val) in cases.iter().copied() {\n            let cp = c_fn(op.as_ptr() as *const c_char, val);\n            let rp = r_fn(op.as_ptr() as *const c_char, val);\n            assert!(!cp.is_null());\n            assert!(!rp.is_null());\n            let c_bytes = std::ffi::CStr::from_ptr(cp).to_bytes().to_vec();\n            let r_bytes = std::ffi::CStr::from_ptr(rp).to_bytes().to_vec();\n            assert_eq!(c_bytes, r_bytes, \"create_result_string({:?},{})\", op, val);\n            libc::free(cp as *mut libc::c_void);\n            libc::free(rp as *mut libc::c_void);\n        }\n    }\n}\n\n// -----------------------------------------------------------------------------\n// multiply_with_log\n// -----------------------------------------------------------------------------\n#[test]\nfn test_multiply_with_log_matches() {\n    unsafe {\n        let c_lib = load_lib(&c_lib_path());\n        let r_lib = load_lib(&rust_lib_path());\n\n        let c_fn: Symbol<unsafe extern \"C\" fn(c_int, c_int, *mut *mut c_char) -> c_int> =\n            c_lib.get(b\"multiply_with_log\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(c_int, c_int, *mut *mut c_char) -> c_int> =\n            r_lib.get(b\"multiply_with_log\").unwrap();\n\n        let cases = [(2, 3), (-4, 5), (0, 99), (7, 0)];\n        for (a, b) in cases.iter().copied() {\n            let mut c_log: *mut c_char = std::ptr::null_mut();\n            let mut r_log: *mut c_char = std::ptr::null_mut();\n            let cv = c_fn(a, b, &mut c_log);\n            let rv = r_fn(a, b, &mut r_log);\n            assert_eq!(cv, rv, \"multiply_with_log({},{}) return\", a, b);\n            assert!(!c_log.is_null());\n            assert!(!r_log.is_null());\n            let c_bytes = std::ffi::CStr::from_ptr(c_log).to_bytes().to_vec();\n            let r_bytes = std::ffi::CStr::from_ptr(r_log).to_bytes().to_vec();\n            assert_eq!(c_bytes, r_bytes, \"multiply_with_log({},{}) log\", a, b);\n            libc::free(c_log as *mut libc::c_void);\n            libc::free(r_log as *mut libc::c_void);\n        }\n    }\n}\n\n// -----------------------------------------------------------------------------\n// copy_and_sum\n// -----------------------------------------------------------------------------\n#[test]\nfn test_copy_and_sum_matches() {\n    let _g = STDOUT_LOCK.lock().unwrap();\n    unsafe {\n        let c_lib = load_lib(&c_lib_path());\n        let r_lib = load_lib(&rust_lib_path());\n\n        let c_fn: Symbol<unsafe extern \"C\" fn(*mut c_int, c_int) -> c_int> =\n            c_lib.get(b\"copy_and_sum\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(*mut c_int, c_int) -> c_int> =\n            r_lib.get(b\"copy_and_sum\").unwrap();\n\n        // Non-null arrays\n        let mut a = [1, 2, 3, 4, 5];\n        let mut b = [-10, 20, -30];\n        let mut c = [0i32; 0]; // zero count\n\n        let pairs: &[(&mut [c_int], c_int)] = &[(&mut a, 5), (&mut b, 3), (&mut c, 0)];\n        for (arr, count) in pairs.iter().map(|(s, c)| (s.as_ptr() as *mut c_int, *c)) {\n            let c_out = capture_stdout(|| {\n                let _ = c_fn(arr, count);\n            });\n            let r_out = capture_stdout(|| {\n                let _ = r_fn(arr, count);\n            });\n            assert_eq!(c_out, r_out, \"copy_and_sum stdout differs\");\n            // Compare actual return values too\n            let cv = c_fn(arr, count);\n            let _ = capture_stdout(|| {});\n            let rv = r_fn(arr, count);\n            let _ = capture_stdout(|| {});\n            assert_eq!(cv, rv, \"copy_and_sum return differs\");\n        }\n\n        // NULL src case - should print and return -1\n        let c_null_out = capture_stdout(|| {\n            let _ = c_fn(std::ptr::null_mut(), 5);\n        });\n        let r_null_out = capture_stdout(|| {\n            let _ = r_fn(std::ptr::null_mut(), 5);\n        });\n        assert_eq!(c_null_out, r_null_out);\n        assert_eq!(c_fn(std::ptr::null_mut(), 5), -1);\n        assert_eq!(r_fn(std::ptr::null_mut(), 5), -1);\n        // Drain anything those last calls printed.\n        let _ = capture_stdout(|| {});\n    }\n}\n\n// -----------------------------------------------------------------------------\n// compare_operations\n// -----------------------------------------------------------------------------\n#[test]\nfn test_compare_operations_matches() {\n    let _g = STDOUT_LOCK.lock().unwrap();\n    unsafe {\n        let c_lib = load_lib(&c_lib_path());\n        let r_lib = load_lib(&rust_lib_path());\n\n        let c_fn: Symbol<unsafe extern \"C\" fn(*const c_char, *const c_char) -> c_int> =\n            c_lib.get(b\"compare_operations\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(*const c_char, *const c_char) -> c_int> =\n            r_lib.get(b\"compare_operations\").unwrap();\n\n        let pairs: &[(&[u8], &[u8])] = &[\n            (b\"foo\\0\", b\"foo\\0\"),\n            (b\"foo\\0\", b\"bar\\0\"),\n            (b\"abc\\0\", b\"abd\\0\"),\n            (b\"\\0\", b\"\\0\"),\n            (b\"a\\0\", b\"ab\\0\"),\n        ];\n        for (x, y) in pairs.iter().copied() {\n            let cv = c_fn(x.as_ptr() as *const c_char, y.as_ptr() as *const c_char);\n            let rv = r_fn(x.as_ptr() as *const c_char, y.as_ptr() as *const c_char);\n            // strcmp signs only; normalise\n            assert_eq!(cv.signum(), rv.signum(), \"compare_operations sign differ\");\n        }\n\n        // NULL cases\n        let c_out = capture_stdout(|| {\n            let v = c_fn(std::ptr::null(), b\"x\\0\".as_ptr() as *const c_char);\n            assert_eq!(v, -1);\n        });\n        let r_out = capture_stdout(|| {\n            let v = r_fn(std::ptr::null(), b\"x\\0\".as_ptr() as *const c_char);\n            assert_eq!(v, -1);\n        });\n        assert_eq!(c_out, r_out);\n\n        let c_out = capture_stdout(|| {\n            let v = c_fn(b\"x\\0\".as_ptr() as *const c_char, std::ptr::null());\n            assert_eq!(v, -1);\n        });\n        let r_out = capture_stdout(|| {\n            let v = r_fn(b\"x\\0\".as_ptr() as *const c_char, std::ptr::null());\n            assert_eq!(v, -1);\n        });\n        assert_eq!(c_out, r_out);\n    }\n}\n\n// -----------------------------------------------------------------------------\n// complexmode\n// -----------------------------------------------------------------------------\n#[test]\nfn test_complexmode_matches() {\n    let _g = STDOUT_LOCK.lock().unwrap();\n    unsafe {\n        let c_lib = load_lib(&c_lib_path());\n        let r_lib = load_lib(&rust_lib_path());\n\n        let c_fn: Symbol<unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int> =\n            c_lib.get(b\"complexmode\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int> =\n            r_lib.get(b\"complexmode\").unwrap();\n\n        let cases = [\n            (1, 2, 3, 0),    // addition\n            (1, -5, 10, 0),\n            (2, 3, 4, 0),    // multiplication\n            (2, 0, 0, 0),\n            (3, 1, 2, 3),    // array sum\n            (3, -1, -2, -3),\n            (4, 2, 3, 4),    // complex w/ exec perm? 0644 doesn't have 0100 -> falls to add path\n            (4, 10, 20, 30),\n            (5, 0, 0, 0),    // invalid mode\n            (0, 0, 0, 0),    // invalid mode\n            (-1, 0, 0, 0),   // invalid mode\n        ];\n        for (m, v1, v2, v3) in cases.iter().copied() {\n            let c_out = capture_stdout(|| {\n                let _ = c_fn(m, v1, v2, v3);\n            });\n            let r_out = capture_stdout(|| {\n                let _ = r_fn(m, v1, v2, v3);\n            });\n            assert_eq!(\n                c_out, r_out,\n                \"complexmode({},{},{},{}) stdout differs.\\nC:    {}\\nRust: {}\",\n                m,\n                v1,\n                v2,\n                v3,\n                String::from_utf8_lossy(&c_out),\n                String::from_utf8_lossy(&r_out)\n            );\n            // Compare return values\n            let cv = c_fn(m, v1, v2, v3);\n            let _ = capture_stdout(|| {});\n            let rv = r_fn(m, v1, v2, v3);\n            let _ = capture_stdout(|| {});\n            assert_eq!(cv, rv, \"complexmode({},{},{},{}) return\", m, v1, v2, v3);\n        }\n    }\n}\n\n// -----------------------------------------------------------------------------\n// Symbol parity: every T-symbol exported by the C .so must exist in Rust .so\n// -----------------------------------------------------------------------------\n#[test]\nfn test_symbol_parity() {\n    use std::process::Command;\n    let c_so = c_lib_path();\n    let r_so = rust_lib_path();\n\n    fn t_syms(path: &PathBuf) -> Vec<String> {\n        let out = Command::new(\"nm\")\n            .arg(\"-D\")\n            .arg(path)\n            .output()\n            .expect(\"nm failed\");\n        let s = String::from_utf8_lossy(&out.stdout);\n        let mut syms = Vec::new();\n        for line in s.lines() {\n            let parts: Vec<&str> = line.split_whitespace().collect();\n            if parts.len() >= 3 && parts[1] == \"T\" {\n                syms.push(parts[2].to_string());\n            }\n        }\n        syms.sort();\n        syms\n    }\n\n    let c_syms = t_syms(&c_so);\n    let r_syms = t_syms(&r_so);\n\n    let expected = [\"check_permissions\", \"compare_operations\", \"complexmode\",\n                    \"copy_and_sum\", \"create_result_string\", \"multiply_with_log\", \"safe_add\"];\n    for sym in expected.iter() {\n        assert!(c_syms.iter().any(|s| s == sym), \"C lib missing {}\", sym);\n        assert!(r_syms.iter().any(|s| s == sym), \"Rust lib missing {}\", sym);\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
