t(\"dlopen failed\");\n        let cleanup: Symbol<CleanupFn> = lib.get(b\"cleanup\\0\").expect(\"missing cleanup\");\n        let print_result: Symbol<PrintResultFn> =\n            lib.get(b\"print_result\\0\").expect(\"missing print_result\");\n        let cleanup_resources: Symbol<CleanupResourcesFn> = lib\n            .get(b\"cleanup_resources\\0\")\n            .expect(\"missing cleanup_resources\");\n        let cleanup = *cleanup;\n        let print_result = *print_result;\n        let cleanup_resources = *cleanup_resources;\n        Loaded {\n            _lib: lib,\n            cleanup,\n            print_result,\n            cleanup_resources,\n        }\n    }\n}\n\n// All capture-based comparisons live in this single #[test] so the cargo test\n// harness can never have another concurrent test write to fd 1 while we're\n// redirected. Inside, we still hold CAPTURE_LOCK for safety.\n#[test]\nfn ffi_outputs_match_c() {\n    let c = load(&c_lib_path());\n    let r = load(&rust_lib_path());\n\n    // ---- cleanup() across many input combinations ----\n    let cleanup_cases: &[(c_int, c_int, c_int, c_int)] = &[\n        (0, 0, 0, 0),\n        (10, 20, 30, 40),\n        (10, 10, 10, 10),\n        (20, 20, 20, 20),\n        (30, 30, 30, 30),\n        (40, 40, 40, 40),\n        (1, 2, 3, 4),\n        (10, 30, 20, 40),\n        (-1, -2, -3, -4),\n        (10, 0, 30, 0),\n        (50, 60, 70, 80),\n        (10, 25, 30, 45),\n        (i32::MIN, i32::MAX, 0, 7),\n    ];\n    for &(a, b, cc, d) in cleanup_cases {\n        let mut c_ret: c_int = 0;\n        let c_out = capture_stdout(|| unsafe {\n            c_ret = (c.cleanup)(a, b, cc, d);\n        });\n        let mut r_ret: c_int = 0;\n        let r_out = capture_stdout(|| unsafe {\n            r_ret = (r.cleanup)(a, b, cc, d);\n        });\n        assert_eq!(\n            c_ret, r_ret,\n            \"cleanup return mismatch for inputs {:?}: C={}, Rust={}\",\n            (a, b, cc, d),\n            c_ret,\n            r_ret\n        );\n        assert_eq!(\n            c_out, r_out,\n            \"cleanup stdout mismatch for inputs {:?}\\nC:    {:?}\\nRust: {:?}\",\n            (a, b, cc, d),\n            String::from_utf8_lossy(&c_out),\n            String::from_utf8_lossy(&r_out)\n        );\n    }\n\n    // ---- print_result() ----\n    let labels = [\"\", \"answer\", \"x\", \"with spaces\", \"very-long-label-1234567890\"];\n    let values: &[c_int] = &[0, 1, -1, 42, i32::MIN, i32::MAX];\n    for label in &labels {\n        let cs = CString::new(*label).unwrap();\n        for &v in values {\n            let c_out = capture_stdout(|| unsafe {\n                (c.print_result)(cs.as_ptr(), v);\n            });\n            let r_out = capture_stdout(|| unsafe {\n                (r.print_result)(cs.as_ptr(), v);\n            });\n            assert_eq!(\n                c_out, r_out,\n                \"print_result mismatch for label {:?} value {}\\nC:    {:?}\\nRust: {:?}\",\n                label,\n                v,\n                String::from_utf8_lossy(&c_out),\n                String::from_utf8_lossy(&r_out)\n            );\n        }\n    }\n\n    // ---- cleanup_resources(NULL) ----\n    let c_out = capture_stdout(|| unsafe {\n        (c.cleanup_resources)(std::ptr::null_mut());\n    });\n    let r_out = capture_stdout(|| unsafe {\n        (r.cleanup_resources)(std::ptr::null_mut());\n    });\n    assert_eq!(c_out, r_out, \"cleanup_resources(NULL) outputs differ\");\n    assert!(c_out.is_empty(), \"C cleanup_resources(NULL) wrote stdout: {:?}\", c_out);\n    assert!(r_out.is_empty(), \"Rust cleanup_resources(NULL) wrote stdout: {:?}\", r_out);\n\n    // ---- cleanup_resources() with a malloc'd pointer ----\n    // Both .so files dynamically link the system libc, so a libc::malloc'd\n    // pointer is freeable by either implementation's free() call.\n    unsafe {\n        let p = libc::malloc(16) as *mut c_char;\n        assert!(!p.is_null());\n        let out = capture_stdout(|| {\n            (c.cleanup_resources)(p);\n        });\n        assert!(out.is_empty(), \"C cleanup_resources wrote unexpected stdout: {:?}\", out);\n\n        let p2 = libc::malloc(16) as *mut c_char;\n        assert!(!p2.is_null());\n        let out = capture_stdout(|| {\n            (r.cleanup_resources)(p2);\n        });\n        assert!(out.is_empty(), \"Rust cleanup_resources wrote unexpected stdout: {:?}\", out);\n    }\n}\n\n// Pure metadata test — no stdout capture — so it's safe to run in parallel\n// with anything else.\n#[test]\nfn rust_so_exports_match_c_so_exports() {\n    use std::process::Command;\n\n    fn defined_symbols(p: &PathBuf) -> Vec<String> {\n        let out = Command::new(\"nm\")\n            .arg(\"-D\")\n            .arg(\"--defined-only\")\n            .arg(p)\n            .output()\n            .expect(\"nm failed\");\n        let s = String::from_utf8_lossy(&out.stdout);\n        let mut syms: Vec<String> = s\n            .lines()\n            .filter_map(|l| {\n                let parts: Vec<&str> = l.split_whitespace().collect();\n                if parts.len() >= 3 {\n                    let ty = parts[1];\n                    let name = parts[2];\n                    if (ty == \"T\" || ty == \"W\")\n                        && !name.starts_with('_')\n                        && name != \"_init\"\n                        && name != \"_fini\"\n                    {\n                        Some(name.to_string())\n                    } else {\n                        None\n                    }\n                } else {\n                    None\n                }\n            })\n            .collect();\n        syms.sort();\n        syms.dedup();\n        syms\n    }\n\n    let c_syms = defined_symbols(&c_lib_path());\n    let r_syms = defined_symbols(&rust_lib_path());\n    for s in &c_syms {\n        assert!(\n            r_syms.contains(s),\n            \"Rust .so is missing symbol exported by C: {}\\nC: {:?}\\nRust: {:?}\",\n            s,\n            c_syms,\n            r_syms\n        );\n    }\n    // We expect at least these three.\n    for required in &[\"cleanup\", \"print_result\", \"cleanup_resources\"] {\n        assert!(r_syms.iter().any(|s| s == required),\n            \"Rust .so is missing required public symbol: {}\\nfound: {:?}\", required, r_syms);\n    }\n}\n","structuredPatch":[{"oldStart":6,"oldLines":6,"newStart":6,"newLines":11,"lines":[" //"," // We never call Rust functions directly; everything is exercised via dlopen,"," // the same way an external caller would.","+//","+// Note: tests that capture process stdout MUST be serialized. Cargo's test","+// harness writes test status lines to fd 1 from other threads, so we keep all","+// capture-based tests in a single #[test] function and use a process-wide","+// mutex around capture."," "," use libloading::{Library, Symbol};"," use std::ffi::CString;"]},{"oldStart":15,"oldLines":8,"newStart":20,"newLines":6,"lines":[" use std::path::PathBuf;"," use std::sync::Mutex;"," ","-// Tests within a single binary run on multiple threads, but stdout is global","-// process state. Capture must be serialized."," static CAPTURE_LOCK: Mutex<()> = Mutex::new(());"," "," fn c_lib_path() -> PathBuf {"]},{"oldStart":27,"oldLines":11,"newStart":30,"newLines":8,"lines":[" }"," "," fn rust_lib_path() -> PathBuf {","-    // CARGO_MANIFEST_DIR / target / <profile> / libtranslated_rust.so. Cargo","-    // sets the test profile to \"debug\" by default; but the user instructions","-    // also build --release. Prefer whatever cargo is currently producing.","     let manifest = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));","-    for profile in &[\"debug\", \"release\"] {","+    for profile in &[\"release\", \"debug\"] {","         let p = manifest.join(\"target\").join(profile).join(\"libtranslated_rust.so\");","         if p.exists() {","             return p;"]},{"oldStart":40,"oldLines":14,"newStart":40,"newLines":12,"lines":["     panic!(\"could not locate Rust libtranslated_rust.so under target/\");"," }"," ","-/// Run `f` with stdout redirected to a temp file, return what was written.","-/// We dup the original stdout fd, redirect fd 1 to the file, run the closure,","-/// flush, then restore fd 1.","+/// Run `f` with the process's stdout redirected to a temp file, return the","+/// bytes that were written. Restores fd 1 before returning."," fn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {","     let _guard = CAPTURE_LOCK.lock().unwrap();"," ","     unsafe {","-        // Make sure anything pending is flushed before we redirect.","         libc::fflush(std::ptr::null_mut());"," ","         let saved = libc::dup(1);"]},{"oldStart":95,"oldLines":9,"newStart":93,"newLines":9,"lines":[" "," struct Loaded {","     _lib: Library,","-    cleanup: unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int,","-    print_result: unsafe extern \"C\" fn(*const c_char, c_int),","-    cleanup_resources: unsafe extern \"C\" fn(*mut c_char),","+    cleanup: CleanupFn,","+    print_result: PrintResultFn,","+    cleanup_resources: CleanupResourcesFn,"," }"," "," fn load(path: &PathBuf) -> Loaded {"]},{"oldStart":121,"oldLines":11,"newStart":119,"newLines":31,"lines":["     }"," }"," ","-fn run_cases(cases: &[(c_int, c_int, c_int, c_int)]) {","+// All capture-based comparisons live in this single #[test] so the cargo test","+// harness can never have another concurrent test write to fd 1 while we're","+// redirected. Inside, we still hold CAPTURE_LOCK for safety.","+#[test]","+fn ffi_outputs_match_c() {","     let c = load(&c_lib_path());","     let r = load(&rust_lib_path());"," ","-    for &(a, b, cc, d) in cases {","+    // ---- cleanup() across many input combinations ----","+    let cleanup_cases: &[(c_int, c_int, c_int, c_int)] = &[","+        (0, 0, 0, 0),","+        (10, 20, 30, 40),","+        (10, 10, 10, 10),","+        (20, 20, 20, 20),","+        (30, 30, 30, 30),","+        (40, 40, 40, 40),","+        (1, 2, 3, 4),","+        (10, 30, 20, 40),","+        (-1, -2, -3, -4),","+        (10, 0, 30, 0),","+        (50, 60, 70, 80),","+        (10, 25, 30, 45),","+        (i32::MIN, i32::MAX, 0, 7),","+    ];","+    for &(a, b, cc, d) in cleanup_cases {","         let mut c_ret: c_int = 0;","         let c_out = capture_stdout(|| unsafe {","             c_ret = (c.cleanup)(a, b, cc, d);"]},{"oldStart":149,"oldLines":36,"newStart":167,"newLines":10,"lines":["             String::from_utf8_lossy(&r_out)","         );","     }","-}"," ","-#[test]","-fn cleanup_various_inputs() {","-    let cases: &[(c_int, c_int, c_int, c_int)] = &[","-        (0, 0, 0, 0),","-        (10, 20, 30, 40),","-        (10, 10, 10, 10),","-        (20, 20, 20, 20),","-        (30, 30, 30, 30),","-        (40, 40, 40, 40),","-        (1, 2, 3, 4),","-        (10, 30, 20, 40),","-        (-1, -2, -3, -4),","-        (10, 0, 30, 0),","-        (50, 60, 70, 80),","-        (10, 25, 30, 45), // mix of switch hits and \"default\" branches","-        (i32::MIN, i32::MAX, 0, 7),","-    ];","-    run_cases(cases);","-}","-","-#[test]","-fn print_result_matches() {","-    let c = load(&c_lib_path());","-    let r = load(&rust_lib_path());","-","+    // ---- print_result() ----","     let labels = [\"\", \"answer\", \"x\", \"with spaces\", \"very-long-label-1234567890\"];","     let values: &[c_int] = &[0, 1, -1, 42, i32::MIN, i32::MAX];","-","     for label in &labels {","         let cs = CString::new(*label).unwrap();","         for &v in values {"]},{"oldStart":198,"oldLines":38,"newStart":190,"newLines":21,"lines":["             );","         }","     }","-}"," ","-#[test]","-fn cleanup_resources_with_null_is_noop() {","-    let c = load(&c_lib_path());","-    let r = load(&rust_lib_path());","-","+    // ---- cleanup_resources(NULL) ----","     let c_out = capture_stdout(|| unsafe {","         (c.cleanup_resources)(std::ptr::null_mut());","     });","     let r_out = capture_stdout(|| unsafe {","         (r.cleanup_resources)(std::ptr::null_mut());","     });","-    assert_eq!(c_out, r_out, \"cleanup_resources(NULL) should be a silent no-op\");","-    // Both should produce no output at all.","-    assert!(c_out.is_empty(), \"C cleanup_resources(NULL) wrote to stdout: {:?}\", c_out);","-    assert!(r_out.is_empty(), \"Rust cleanup_resources(NULL) wrote to stdout: {:?}\", r_out);","-}","+    assert_eq!(c_out, r_out, \"cleanup_resources(NULL) outputs differ\");","+    assert!(c_out.is_empty(), \"C cleanup_resources(NULL) wrote stdout: {:?}\", c_out);","+    assert!(r_out.is_empty(), \"Rust cleanup_resources(NULL) wrote stdout: {:?}\", r_out);"," ","-#[test]","-fn cleanup_resources_frees_malloced_pointer() {","-    // Each library may have its own heap; we want to confirm that calling","-    // cleanup_resources on a non-null pointer obtained from libc::malloc does","-    // not crash and produces no stdout. We only feed each library a pointer","-    // it allocated itself by going through cleanup() (which mallocs and frees","-    // internally) — that's already covered. Here we just sanity-check the","-    // documented contract by allocating with the system malloc and freeing","-    // through cleanup_resources, since both .so files dynamically link against","-    // the same system libc.","-    let c = load(&c_lib_path());","-    let r = load(&rust_lib_path());","-","+    // ---- cleanup_resources() with a malloc'd pointer ----","+    // Both .so files dynamically link the system libc, so a libc::malloc'd","+    // pointer is freeable by either implementation's free() call.","     unsafe {","         let p = libc::malloc(16) as *mut c_char;","         assert!(!p.is_null());"]},{"oldStart":247,"oldLines":6,"newStart":222,"newLines":8,"lines":["     }"," }"," ","+// Pure metadata test — no stdout capture — so it's safe to run in parallel","+// with anything else."," #[test]"," fn rust_so_exports_match_c_so_exports() {","     use std::process::Command;"]},{"oldStart":266,"oldLines":7,"newStart":243,"newLines":6,"lines":["                 if parts.len() >= 3 {","                     let ty = parts[1];","                     let name = parts[2];","-                    // Public code symbols only (T, W). Skip data/init.","                     if (ty == \"T\" || ty == \"W\")","                         && !name.starts_with('_')","                         && name != \"_init\""]},{"oldStart":297,"oldLines":4,"newStart":273,"newLines":9,"lines":["             r_syms","         );","     }","+    // We expect at least these three.","+    for required in &[\"cleanup\", \"print_result\", \"cleanup_resources\"] {","+        assert!(r_syms.iter().any(|s| s == required),","+            \"Rust .so is missing required public symbol: {}\\nfound: {:?}\", required, r_syms);","+    }"," }"]}],"originalFile":"// Integration test that loads BOTH the C-built libtranslated_rust.so and the\n// Rust-built libtranslated_rust.so via libloading, calls each public function\n// through its FFI export, and asserts that:\n//   - return values match exactly\n//   - bytes written to stdout match exactly\n//\n// We never call Rust functions directly; everything is exercised via dlopen,\n// the same way an external caller would.\n\nuse libloading::{Library, Symbol};\nuse std::ffi::CString;\nuse std::fs;\nuse std::io::Read;\nuse std::os::raw::{c_char, c_int};\nuse std::path::PathBuf;\nuse std::sync::Mutex;\n\n// Tests within a single binary run on multiple threads, but stdout is global\n// process state. Capture must be serialized.\nstatic CAPTURE_LOCK: Mutex<()> = Mutex::new(());\n\nfn c_lib_path() -> PathBuf {\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n        .join(\"c_src\")\n        .join(\"build\")\n        .join(\"libtranslated_rust.so\")\n}\n\nfn rust_lib_path() -> PathBuf {\n    // CARGO_MANIFEST_DIR / target / <profile> / libtranslated_rust.so. Cargo\n    // sets the test profile to \"debug\" by default; but the user instructions\n    // also build --release. Prefer whatever cargo is currently producing.\n    let manifest = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    for profile in &[\"debug\", \"release\"] {\n        let p = manifest.join(\"target\").join(profile).join(\"libtranslated_rust.so\");\n        if p.exists() {\n            return p;\n        }\n    }\n    panic!(\"could not locate Rust libtranslated_rust.so under target/\");\n}\n\n/// Run `f` with stdout redirected to a temp file, return what was written.\n/// We dup the original stdout fd, redirect fd 1 to the file, run the closure,\n/// flush, then restore fd 1.\nfn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {\n    let _guard = CAPTURE_LOCK.lock().unwrap();\n\n    unsafe {\n        // Make sure anything pending is flushed before we redirect.\n        libc::fflush(std::ptr::null_mut());\n\n        let saved = libc::dup(1);\n        assert!(saved >= 0, \"dup(1) failed\");\n\n        let tmpdir = std::env::temp_dir();\n        let path = tmpdir.join(format!(\n            \"ffi_compat_capture_{}_{}.tmp\",\n            std::process::id(),\n            std::time::SystemTime::now()\n                .duration_since(std::time::UNIX_EPOCH)\n                .unwrap()\n                .as_nanos()\n        ));\n        let cpath = CString::new(path.to_str().unwrap()).unwrap();\n\n        let fd = libc::open(\n            cpath.as_ptr(),\n            libc::O_CREAT | libc::O_TRUNC | libc::O_RDWR,\n            0o600,\n        );\n        assert!(fd >= 0, \"open temp file failed\");\n\n        let r = libc::dup2(fd, 1);\n        assert!(r >= 0, \"dup2 failed\");\n        libc::close(fd);\n\n        f();\n\n        libc::fflush(std::ptr::null_mut());\n        libc::dup2(saved, 1);\n        libc::close(saved);\n\n        let mut bytes = Vec::new();\n        let mut file = fs::File::open(&path).expect(\"open captured file\");\n        file.read_to_end(&mut bytes).expect(\"read captured file\");\n        let _ = fs::remove_file(&path);\n        bytes\n    }\n}\n\ntype CleanupFn = unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int;\ntype PrintResultFn = unsafe extern \"C\" fn(*const c_char, c_int);\ntype CleanupResourcesFn = unsafe extern \"C\" fn(*mut c_char);\n\nstruct Loaded {\n    _lib: Library,\n    cleanup: unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int,\n    print_result: unsafe extern \"C\" fn(*const c_char, c_int),\n    cleanup_resources: unsafe extern \"C\" fn(*mut c_char),\n}\n\nfn load(path: &PathBuf) -> Loaded {\n    unsafe {\n        let lib = Library::new(path).expect(\"dlopen failed\");\n        let cleanup: Symbol<CleanupFn> = lib.get(b\"cleanup\\0\").expect(\"missing cleanup\");\n        let print_result: Symbol<PrintResultFn> =\n            lib.get(b\"print_result\\0\").expect(\"missing print_result\");\n        let cleanup_resources: Symbol<CleanupResourcesFn> = lib\n            .get(b\"cleanup_resources\\0\")\n            .expect(\"missing cleanup_resources\");\n        let cleanup = *cleanup;\n        let print_result = *print_result;\n        let cleanup_resources = *cleanup_resources;\n        Loaded {\n            _lib: lib,\n            cleanup,\n            print_result,\n            cleanup_resources,\n        }\n    }\n}\n\nfn run_cases(cases: &[(c_int, c_int, c_int, c_int)]) {\n    let c = load(&c_lib_path());\n    let r = load(&rust_lib_path());\n\n    for &(a, b, cc, d) in cases {\n        let mut c_ret: c_int = 0;\n        let c_out = capture_stdout(|| unsafe {\n            c_ret = (c.cleanup)(a, b, cc, d);\n        });\n        let mut r_ret: c_int = 0;\n        let r_out = capture_stdout(|| unsafe {\n            r_ret = (r.cleanup)(a, b, cc, d);\n        });\n        assert_eq!(\n            c_ret, r_ret,\n            \"cleanup return mismatch for inputs {:?}: C={}, Rust={}\",\n            (a, b, cc, d),\n            c_ret,\n            r_ret\n        );\n        assert_eq!(\n            c_out, r_out,\n            \"cleanup stdout mismatch for inputs {:?}\\nC:    {:?}\\nRust: {:?}\",\n            (a, b, cc, d),\n            String::from_utf8_lossy(&c_out),\n            String::from_utf8_lossy(&r_out)\n        );\n    }\n}\n\n#[test]\nfn cleanup_various_inputs() {\n    let cases: &[(c_int, c_int, c_int, c_int)] = &[\n        (0, 0, 0, 0),\n        (10, 20, 30, 40),\n        (10, 10, 10, 10),\n        (20, 20, 20, 20),\n        (30, 30, 30, 30),\n        (40, 40, 40, 40),\n        (1, 2, 3, 4),\n        (10, 30, 20, 40),\n        (-1, -2, -3, -4),\n        (10, 0, 30, 0),\n        (50, 60, 70, 80),\n        (10, 25, 30, 45), // mix of switch hits and \"default\" branches\n        (i32::MIN, i32::MAX, 0, 7),\n    ];\n    run_cases(cases);\n}\n\n#[test]\nfn print_result_matches() {\n    let c = load(&c_lib_path());\n    let r = load(&rust_lib_path());\n\n    let labels = [\"\", \"answer\", \"x\", \"with spaces\", \"very-long-label-1234567890\"];\n    let values: &[c_int] = &[0, 1, -1, 42, i32::MIN, i32::MAX];\n\n    for label in &labels {\n        let cs = CString::new(*label).unwrap();\n        for &v in values {\n            let c_out = capture_stdout(|| unsafe {\n                (c.print_result)(cs.as_ptr(), v);\n            });\n            let r_out = capture_stdout(|| unsafe {\n                (r.print_result)(cs.as_ptr(), v);\n            });\n            assert_eq!(\n                c_out, r_out,\n                \"print_result mismatch for label {:?} value {}\\nC:    {:?}\\nRust: {:?}\",\n                label,\n                v,\n                String::from_utf8_lossy(&c_out),\n                String::from_utf8_lossy(&r_out)\n            );\n        }\n    }\n}\n\n#[test]\nfn cleanup_resources_with_null_is_noop() {\n    let c = load(&c_lib_path());\n    let r = load(&rust_lib_path());\n\n    let c_out = capture_stdout(|| unsafe {\n        (c.cleanup_resources)(std::ptr::null_mut());\n    });\n    let r_out = capture_stdout(|| unsafe {\n        (r.cleanup_resources)(std::ptr::null_mut());\n    });\n    assert_eq!(c_out, r_out, \"cleanup_resources(NULL) should be a silent no-op\");\n    // Both should produce no output at all.\n    assert!(c_out.is_empty(), \"C cleanup_resources(NULL) wrote to stdout: {:?}\", c_out);\n    assert!(r_out.is_empty(), \"Rust cleanup_resources(NULL) wrote to stdout: {:?}\", r_out);\n}\n\n#[test]\nfn cleanup_resources_frees_malloced_pointer() {\n    // Each library may have its own heap; we want to confirm that calling\n    // cleanup_resources on a non-null pointer obtained from libc::malloc does\n    // not crash and produces no stdout. We only feed each library a pointer\n    // it allocated itself by going through cleanup() (which mallocs and frees\n    // internally) — that's already covered. Here we just sanity-check the\n    // documented contract by allocating with the system malloc and freeing\n    // through cleanup_resources, since both .so files dynamically link against\n    // the same system libc.\n    let c = load(&c_lib_path());\n    let r = load(&rust_lib_path());\n\n    unsafe {\n        let p = libc::malloc(16) as *mut c_char;\n        assert!(!p.is_null());\n        let out = capture_stdout(|| {\n            (c.cleanup_resources)(p);\n        });\n        assert!(out.is_empty(), \"C cleanup_resources wrote unexpected stdout: {:?}\", out);\n\n        let p2 = libc::malloc(16) as *mut c_char;\n        assert!(!p2.is_null());\n        let out = capture_stdout(|| {\n            (r.cleanup_resources)(p2);\n        });\n        assert!(out.is_empty(), \"Rust cleanup_resources wrote unexpected stdout: {:?}\", out);\n    }\n}\n\n#[test]\nfn rust_so_exports_match_c_so_exports() {\n    use std::process::Command;\n\n    fn defined_symbols(p: &PathBuf) -> Vec<String> {\n        let out = Command::new(\"nm\")\n            .arg(\"-D\")\n            .arg(\"--defined-only\")\n            .arg(p)\n            .output()\n            .expect(\"nm failed\");\n        let s = String::from_utf8_lossy(&out.stdout);\n        let mut syms: Vec<String> = s\n            .lines()\n            .filter_map(|l| {\n                let parts: Vec<&str> = l.split_whitespace().collect();\n                if parts.len() >= 3 {\n                    let ty = parts[1];\n                    let name = parts[2];\n                    // Public code symbols only (T, W). Skip data/init.\n                    if (ty == \"T\" || ty == \"W\")\n                        && !name.starts_with('_')\n                        && name != \"_init\"\n                        && name != \"_fini\"\n                    {\n                        Some(name.to_string())\n                    } else {\n                        None\n                    }\n                } else {\n                    None\n                }\n            })\n            .collect();\n        syms.sort();\n        syms.dedup();\n        syms\n    }\n\n    let c_syms = defined_symbols(&c_lib_path());\n    let r_syms = defined_symbols(&rust_lib_path());\n    for s in &c_syms {\n        assert!(\n            r_syms.contains(s),\n            \"Rust .so is missing symbol exported by C: {}\\nC: {:?}\\nRust: {:?}\",\n            s,\n            c_syms,\n            r_syms\n        );\n    }\n}\n","userModified":false}}
