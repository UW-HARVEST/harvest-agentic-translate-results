        printf(\"Input string validation failed.\\n\");\n44\t        goto cleanup;\n45\t    }\n46\t\n47\t    for (int i = 0; i < 4; i++) {\n48\t        switch (numbers[i]) {\n49\t            case 10:\n50\t                result += 10;\n51\t            case 20:\n52\t                result += 20;\n53\t                break;\n54\t            case 30:\n55\t                result += 30;\n56\t            case 40:\n57\t                result += 40;\n58\t                break;\n59\t            default:\n60\t                result += numbers[i];\n61\t                break;\n62\t        }\n63\t    }\n64\t\n65\t    dynamic_str = (char *)malloc(50 * sizeof(char));\n66\t    if (!dynamic_str) {\n67\t        printf(\"Memory allocation failed.\\n\");\n68\t        goto cleanup;\n69\t    }\n70\t\n71\t    snprintf(dynamic_str, 50, \"Processed numbers: %s\", TO_STRING(numbers));\n72\t    printf(\"%s\\n\", dynamic_str);\n73\t\n74\tcleanup:\n75\t    cleanup_resources(dynamic_str);\n76\t    return result;\n77\t}\n78\t\n79\tvoid print_result(const char *label, int result) {\n80\t    printf(\"%s: %d\\n\", label, result);\n81\t}\n82\t\n83\tvoid cleanup_resources(char *dynamic_str) {\n84\t    if (dynamic_str) {\n85\t        free(dynamic_str);\n86\t        dynamic_str = NULL;\n87\t    }\n88\t}\n89\t"}]},"parent_tool_use_id":null,"session_id":"eb6c58db-f99c-40f3-8236-50076216c758","uuid":"60569f60-2b14-4f20-bbdb-1c63a469a2ef","timestamp":"2026-05-30T01:45:27.199Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-translate-v8fbsn/translated_rust/c_src/src/lib.c","content":"// Copyright 2025 MIT Lincoln Laboratory\n// Permission is hereby granted, free of charge,\n// to any person obtaining a copy of this software\n// and associated documentation files (the “Software”),\n// to deal in the Software without restriction,\n// including without limitation the rights to use, copy,\n// modify, merge, publish, distribute, sublicense,\n// and/or sell copies of the Software,\n// and to per