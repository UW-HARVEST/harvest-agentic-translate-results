ines":["                     let cs = CString::new(*s).unwrap();","                     r_results.push(rb_append(rbuf, cs.as_ptr()));","                 }","-                let r_data =","-                    CStr::from_ptr((*rbuf).data).to_bytes().to_vec();","+                let r_data = CStr::from_ptr((*rbuf).data).to_bytes().to_vec();","                 let r_length = (*rbuf).length;","                 rb_destroy(rbuf);"," "]},{"oldStart":238,"oldLines":7,"newStart":214,"newLines":7,"lines":["             (100, 100, 100, 100),","             (1, 0, 1, 0),","             (5, 10, 15, 20),","-            (3, 0, 7, 0), // hits divide-by-zero branch in op2 etc.","+            (3, 0, 7, 0),","         ];"," ","         for &args in inputs {"]},{"oldStart":251,"oldLines":7,"newStart":227,"newLines":7,"lines":["             );","             assert_eq!(","                 cout, rout,","-                \"buffapp stdout mismatch for args={:?}\\nC bytes: {:?}\\nRust bytes: {:?}\",","+                \"buffapp stdout mismatch for args={:?}\\nC: {:?}\\nR: {:?}\",","                 args,","                 String::from_utf8_lossy(&cout),","                 String::from_utf8_lossy(&rout)"]}],"originalFile":"// Integration tests: load both the C and Rust shared libraries via\n// libloading and compare their FFI outputs byte-for-byte.\n\nuse libloading::{Library, Symbol};\nuse std::ffi::{c_char, c_int, CStr, CString};\nuse std::io::{Read, Seek, SeekFrom, Write};\nuse std::os::unix::io::AsRawFd;\nuse std::path::PathBuf;\n\n#[repr(C)]\nstruct StringBuffer {\n    data: *mut c_char,\n    capacity: c_int,\n    length: c_int,\n}\n\nfn c_lib_path() -> PathBuf {\n    let manifest = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    manifest.join(\"c_src/build/libtranslated_rust.so\")\n}\n\nfn rust_lib_path() -> PathBuf {\n    let manifest = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    manifest.join(\"target/release/libtranslated_rust.so\")\n}\n\nunsafe fn load_libs() -> (Library, Library) {\n    let c = Library::new(c_lib_path()).expect(\"failed to load C library\");\n    let r = Library::new(rust_lib_path()).expect(\"failed to load Rust library\");\n    (c, r)\n}\n\n/// Capture stdout produced by `f`. Works by `dup`ing stdout, replacing\n/// stdout's fd with a tempfile, then restoring it when `f` returns.\nfn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {\n    unsafe {\n        // Make sure any pending writes from the C runtime are flushed.\n        libc::fflush(libc::__stdoutp_or_default());\n    }\n\n    let mut tmp = tempfile();\n    let saved = unsafe { libc::dup(1) };\n    assert!(saved >= 0, \"dup failed\");\n    let r = unsafe { libc::dup2(tmp.as_raw_fd(), 1) };\n    assert!(r >= 0, \"dup2 failed\");\n\n    f();\n\n    // Flush libc stdout before restoring.\n    unsafe {\n        libc::fflush(libc::__stdoutp_or_default());\n    }\n\n    // Restore real stdout.\n    let r = unsafe { libc::dup2(saved, 1) };\n    assert!(r >= 0, \"dup2 restore failed\");\n    unsafe {\n        libc::close(saved);\n    }\n\n    tmp.seek(SeekFrom::Start(0)).unwrap();\n    let mut buf = Vec::new();\n    tmp.read_to_end(&mut buf).unwrap();\n    buf\n}\n\nfn tempfile() -> std::fs::File {\n    // Use a unique name in /tmp.\n    use std::time::{SystemTime, UNIX_EPOCH};\n    let nanos = SystemTime::now().duration_since(UNIX_EPOCH).unwrap().subsec_nanos();\n    let pid = std::process::id();\n    let path = format!(\"/tmp/ffi_capture_{}_{}_{}.tmp\", pid, nanos, rand_suffix());\n    std::fs::OpenOptions::new()\n        .read(true)\n        .write(true)\n        .create(true)\n        .truncate(true)\n        .open(&path)\n        .expect(\"tempfile\")\n}\n\nfn rand_suffix() -> u64 {\n    use std::time::Instant;\n    let mut x = Instant::now().elapsed().subsec_nanos() as u64;\n    x ^= std::process::id() as u64;\n    x = x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);\n    x\n}\n\n// --- Provide a shim for libc::__stdoutp_or_default; not all Rust libcs\n// expose `stdout` directly. We rely on `fflush(NULL)` instead, which\n// flushes ALL streams.\nmod libc_compat {\n    extern \"C\" {\n        pub fn fflush(stream: *mut libc::FILE) -> libc::c_int;\n    }\n}\n\n// Override the helper to call fflush(NULL) which is portable.\n#[allow(non_snake_case)]\nmod libc {\n    pub use ::libc::*;\n    pub fn __stdoutp_or_default() -> *mut FILE {\n        std::ptr::null_mut()\n    }\n}\n\n// ---------------- get_operation_name ----------------\n\ntype GetOperationNameFn = unsafe extern \"C\" fn(c_int) -> *const c_char;\n\n#[test]\nfn test_get_operation_name() {\n    unsafe {\n        let (c, r) = load_libs();\n        let cf: Symbol<GetOperationNameFn> = c.get(b\"get_operation_name\").unwrap();\n        let rf: Symbol<GetOperationNameFn> = r.get(b\"get_operation_name\").unwrap();\n\n        for code in [-5, -1, 0, 1, 2, 3, 4, 7, 100] {\n            let cs = CStr::from_ptr(cf(code)).to_bytes().to_vec();\n            let rs = CStr::from_ptr(rf(code)).to_bytes().to_vec();\n            assert_eq!(cs, rs, \"mismatch for op_code={}\", code);\n        }\n    }\n}\n\n// ---------------- perform_operation ----------------\n\ntype PerformOperationFn = unsafe extern \"C\" fn(c_int, c_int, *const c_char) -> c_int;\n\n#[test]\nfn test_perform_operation() {\n    unsafe {\n        let (c, r) = load_libs();\n        let cf: Symbol<PerformOperationFn> = c.get(b\"perform_operation\").unwrap();\n        let rf: Symbol<PerformOperationFn> = r.get(b\"perform_operation\").unwrap();\n\n        let ops = [\"add\", \"subtract\", \"multiply\", \"divide\", \"unknown\", \"\"];\n        let pairs = [(0, 0), (3, 4), (-2, 5), (10, 3), (10, 0), (-7, -3), (1, 2)];\n        for op in &ops {\n            let cstr = CString::new(*op).unwrap();\n            for &(a, b) in &pairs {\n                let cv = cf(a, b, cstr.as_ptr());\n                let rv = rf(a, b, cstr.as_ptr());\n                assert_eq!(cv, rv, \"mismatch for op={} a={} b={}\", op, a, b);\n            }\n        }\n    }\n}\n\n// ---------------- create_buffer / append_to_buffer / destroy_buffer ----------------\n\ntype CreateBufferFn = unsafe extern \"C\" fn(c_int) -> *mut StringBuffer;\ntype AppendToBufferFn = unsafe extern \"C\" fn(*mut StringBuffer, *const c_char) -> c_int;\ntype DestroyBufferFn = unsafe extern \"C\" fn(*mut StringBuffer);\n\n#[test]\nfn test_buffer_lifecycle() {\n    unsafe {\n        let (c, r) = load_libs();\n\n        for &cap in &[1, 8, 32, 100] {\n            for trials in &[\n                vec![\"hello\"],\n                vec![\"a\", \"b\", \"c\"],\n                vec![\"short\", \"a slightly longer string that requires growth\"],\n                vec![\"\"; 0], // no appends\n                vec![\"\", \"x\", \"\", \"yz\"],\n            ] {\n                // C side\n                let cb_create: Symbol<CreateBufferFn> = c.get(b\"create_buffer\").unwrap();\n                let cb_append: Symbol<AppendToBufferFn> = c.get(b\"append_to_buffer\").unwrap();\n                let cb_destroy: Symbol<DestroyBufferFn> = c.get(b\"destroy_buffer\").unwrap();\n\n                let cbuf = cb_create(cap);\n                assert!(!cbuf.is_null());\n                let mut c_results = Vec::new();\n                for s in trials {\n                    let cs = CString::new(*s).unwrap();\n                    c_results.push(cb_append(cbuf, cs.as_ptr()));\n                }\n                let c_data =\n                    CStr::from_ptr((*cbuf).data).to_bytes().to_vec();\n                let c_length = (*cbuf).length;\n                cb_destroy(cbuf);\n\n                // Rust side\n                let rb_create: Symbol<CreateBufferFn> = r.get(b\"create_buffer\").unwrap();\n                let rb_append: Symbol<AppendToBufferFn> = r.get(b\"append_to_buffer\").unwrap();\n                let rb_destroy: Symbol<DestroyBufferFn> = r.get(b\"destroy_buffer\").unwrap();\n\n                let rbuf = rb_create(cap);\n                assert!(!rbuf.is_null());\n                let mut r_results = Vec::new();\n                for s in trials {\n                    let cs = CString::new(*s).unwrap();\n                    r_results.push(rb_append(rbuf, cs.as_ptr()));\n                }\n                let r_data =\n                    CStr::from_ptr((*rbuf).data).to_bytes().to_vec();\n                let r_length = (*rbuf).length;\n                rb_destroy(rbuf);\n\n                assert_eq!(c_results, r_results, \"append return-value mismatch\");\n                assert_eq!(c_data, r_data, \"buffer data mismatch\");\n                assert_eq!(c_length, r_length, \"buffer length mismatch\");\n            }\n        }\n    }\n}\n\n// ---------------- buffapp ----------------\n\ntype BuffappFn = unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int;\n\nfn run_buffapp(lib: &Library, args: (c_int, c_int, c_int, c_int)) -> (c_int, Vec<u8>) {\n    unsafe {\n        let f: Symbol<BuffappFn> = lib.get(b\"buffapp\").unwrap();\n        let mut ret: c_int = 0;\n        let out = capture_stdout(|| {\n            ret = f(args.0, args.1, args.2, args.3);\n        });\n        (ret, out)\n    }\n}\n\n#[test]\nfn test_buffapp_outputs_match() {\n    unsafe {\n        let (c, r) = load_libs();\n\n        let inputs: &[(c_int, c_int, c_int, c_int)] = &[\n            (1, 2, 3, 4),\n            (0, 0, 0, 0),\n            (4, 5, 6, 7),\n            (10, 3, 8, 2),\n            (-1, -2, -3, -4),\n            (100, 100, 100, 100),\n            (1, 0, 1, 0),\n            (5, 10, 15, 20),\n            (3, 0, 7, 0), // hits divide-by-zero branch in op2 etc.\n        ];\n\n        for &args in inputs {\n            let (cret, cout) = run_buffapp(&c, args);\n            let (rret, rout) = run_buffapp(&r, args);\n            assert_eq!(\n                cret, rret,\n                \"buffapp return value mismatch for args={:?}\",\n                args\n            );\n            assert_eq!(\n                cout, rout,\n                \"buffapp stdout mismatch for args={:?}\\nC bytes: {:?}\\nRust bytes: {:?}\",\n                args,\n                String::from_utf8_lossy(&cout),\n                String::from_utf8_lossy(&rout)\n            );\n        }\n    }\n}\n","userModified":false}}
