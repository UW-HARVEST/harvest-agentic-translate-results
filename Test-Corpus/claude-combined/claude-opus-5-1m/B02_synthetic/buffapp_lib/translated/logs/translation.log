        if new_data.is_null() {\n            return -1;\n        }\n\n        (*buffer).data = new_data;\n        (*buffer).capacity = new_capacity;\n    }\n\n    libc::strcpy((*buffer).data.offset((*buffer).length as isize), s);\n    (*buffer).length += str_len;\n\n    0\n}\n\nunsafe fn destroy_buffer(buffer: *mut StringBuffer) {\n    if !buffer.is_null() {\n        if !(*buffer).data.is_null() {\n            libc::free((*buffer).data as *mut libc::c_void);\n        }\n        libc::free(buffer as *mut libc::c_void);\n    }\n}\n\nfn get_operation_name(op_code: c_int) -> &'static [u8] {\n    match op_code {\n        0 => b\"add\\0\",\n        1 => b\"subtract\\0\",\n        2 => b\"multiply\\0\",\n        3 => b\"divide\\0\",\n        _ => b\"unknown\\0\",\n    }\n}\n\nunsafe fn perform_operation(a: c_int, b: c_int, operation: *const c_char) -> c_int {\n    let op = CStr::from_ptr(operation).to_bytes();\n    if op == b\"add\" {\n        a.wrapping_add(b)\n    } else if op == b\"subtract\" {\n        a.wrapping_sub(b)\n    } else if op == b\"multiply\" {\n        a.wrapping_mul(b)\n    } else if op == b\"divide\" {\n        if b != 0 {\n            // C `/` for ints: truncated division. In Rust, `/` traps on\n            // INT_MIN / -1 overflow. C is undefined there too, so we match\n            // typical C behavior with wrapping_div.\n            a.wrapping_div(b)\n        } else {\n            0\n        }\n    } else {\n        0\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn buffapp(\n    param1: c_int,\n    param2: c_int,\n    param3: c_int,\n    param4: c_int,\n) -> c_int {\n    let log_buffer = create_buffer(32);\n    let mut result: c_int = 0;\n    let mut temp: [c_char; 64] = [0; 64];\n\n    (*log_buffer).length = 0;\n\n    libc::sprintf(\n        temp.as_mut_ptr(),\n        b\"Starting computation with %d parameters\\n\\0\".as_ptr() as *const c_char,\n        4 as c_int,\n    );\n    append_to_buffer(log_buffer, temp.as_ptr());\n\n    let op1 = get_operation_name(param1.rem_euclid_c(4));\n    libc::sprintf(\n        temp.as_mut_ptr(),\n        b\"Operation 1: %s(%d, %d)\\n\\0\".as_ptr() as *const c_char,\n        op1.as_ptr() as *const c_char,\n        param1,\n        param2,\n    );\n    append_to_buffer(log_buffer, temp.as_ptr());\n\n    let intermediate1 = perform_operation(param1, param2, op1.as_ptr() as *const c_char);\n    result = result.wrapping_add(intermediate1);\n\n    let op2 = get_operation_name(param3.rem_euclid_c(4));\n    libc::sprintf(\n        temp.as_mut_ptr(),\n        b\"Operation 2: %s(%d, %d)\\n\\0\".as_ptr() as *const c_char,\n        op2.as_ptr() as *const c_char,\n        param3,\n        param4,\n    );\n    append_to_buffer(log_buffer, temp.as_ptr());\n\n    let intermediate2 = perform_operation(param3, param4, op2.as_ptr() as *const c_char);\n    result = result.wrapping_add(intermediate2);\n\n    let op3: &[u8] = b\"multiply\\0\";\n    libc::sprintf(\n        temp.as_mut_ptr(),\n        b\"Operation 3: %s(%d, %d)\\n\\0\".as_ptr() as *const c_char,\n        op3.as_ptr() as *const c_char,\n        intermediate1,\n        intermediate2,\n    );\n    append_to_buffer(log_buffer, temp.as_ptr());\n\n    let intermediate3 = perform_operation(intermediate1, intermediate2, op3.as_ptr() as *const c_char);\n\n    if intermediate3 != 0 {\n        result = result.wrapping_div(intermediate3);\n    } else {\n        result = param1\n            .wrapping_add(param2)\n            .wrapping_add(param3)\n            .wrapping_add(param4);\n    }\n\n    libc::sprintf(\n        temp.as_mut_ptr(),\n        b\"Final result: %d\\n\\0\".as_ptr() as *const c_char,\n        result,\n    );\n    append_to_buffer(log_buffer, temp.as_ptr());\n\n    libc::printf(\n        b\"Computation Log:\\n%s\\n\\0\".as_ptr() as *const c_char,\n        (*log_buffer).data,\n    );\n\n    destroy_buffer(log_buffer);\n\n    result\n}\n\n// Helper trait to mirror C's `%` semantics for c_int.\n// C's `%` is a truncated remainder (sign follows dividend); Rust's `%`\n// matches that for primitive integer types via `%` already, BUT we want\n// to be careful about overflow. The original C uses `param % 4`, which\n// is well-defined for any int as long as 4 != 0.\ntrait CRem {\n    fn rem_euclid_c(self, rhs: Self) -> Self;\n}\n\nimpl CRem for c_int {\n    #[inline]\n    fn rem_euclid_c(self, rhs: c_int) -> c_int {\n        // C truncated remainder. Rust's `%` operator on i32 also performs\n        // truncated remainder, but panics on overflow (INT_MIN % -1).\n        // For our use rhs = 4, so no overflow possible.\n        self.wrapping_rem(rhs)\n    }\n}\n","userModified":false}}
