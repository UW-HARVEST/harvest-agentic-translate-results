  unsafe {\n        let (c_lib, r_lib) = load_libs();\n        let c_fn: Symbol<unsafe extern \"C\" fn(*mut [c_int; 4])> = c_lib.get(b\"init_matrix\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(*mut [c_int; 4])> = r_lib.get(b\"init_matrix\").unwrap();\n\n        let mut c_mat: [[c_int; 4]; 3] = [[0; 4]; 3];\n        let mut r_mat: [[c_int; 4]; 3] = [[0; 4]; 3];\n        c_fn(c_mat.as_mut_ptr());\n        r_fn(r_mat.as_mut_ptr());\n        assert_eq!(c_mat, r_mat, \"init_matrix output mismatch\");\n    }\n}\n\n#[test]\nfn test_compare_allocations() {\n    // Note: the C function depends on malloc layout (which is non-deterministic\n    // across processes), so result values 1, 2, or 3 (the ptr1 vs ptr2 branch)\n    // are platform/run-dependent. We simply verify the function returns\n    // something sane for both libs (no crash). We can't assert byte-equality\n    // because each call is in the same process but different malloc results.\n    unsafe {\n        let (c_lib, r_lib) = load_libs();\n        let c_fn: Symbol<unsafe extern \"C\" fn(c_int, c_int) -> c_int> = c_lib.get(b\"compare_allocations\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(c_int, c_int) -> c_int> = r_lib.get(b\"compare_allocations\").unwrap();\n\n        for &(v1, v2) in &[(1i32, 2), (0, 0), (-5, 5), (100, 200)] {\n            let c_out = c_fn(v1, v2);\n            let r_out = r_fn(v1, v2);\n            // Both should produce one of: 1, 2, 3, 11, 12, 13.\n            // The \"+10 if *uninit_ptr > 0\" branch depends on val1.\n            let valid_set = [1, 2, 3, 11, 12, 13];\n            assert!(valid_set.contains(&c_out), \"C compare_allocations returned {} for ({}, {})\", c_out, v1, v2);\n            assert!(valid_set.contains(&r_out), \"Rust compare_allocations returned {} for ({}, {})\", r_out, v1, v2);\n\n            // The +10 part is deterministic based on val1: if val1 > 0, result + 10.\n            let c_added = c_out > 10;\n            let r_added = r_out > 10;\n            assert_eq!(c_added, r_added, \"+10 branch mismatch for ({}, {})\", v1, v2);\n        }\n    }\n}\n\n#[test]\nfn test_arity4_deterministic_part() {\n    // arity4 calls compare_allocations whose 1/2/3 component is non-deterministic.\n    // We can verify: differences between C and Rust outputs come only from the\n    // compare_allocations 1/2/3 component, so |c_out - r_out| should be at most\n    // the spread caused by that. Better: compute everything except that and\n    // confirm both libs are within {result-2, result-1, result, result+1, result+2}.\n    //\n    // Simpler approach: call arity4 many times with same inputs in each lib;\n    // in Rust at least, the +10 branch + sum is deterministic across calls\n    // *within a process* if pointer ordering is stable. Actually it's not.\n    //\n    // We instead verify: differences only come from the 1/2/3 component of\n    // compare_allocations. Compute diff = c_out - r_out should be in {-2,-1,0,1,2}\n    // possibly scaled by param3/100.\n    unsafe {\n        let (c_lib, r_lib) = load_libs();\n        let c_fn: Symbol<unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int> = c_lib.get(b\"arity4\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(c_int, c_int, c_int, c_int) -> c_int> = r_lib.get(b\"arity4\").unwrap();\n\n        for &(p1, p2, p3, p4) in &[\n            (0i32, 0, 0, 0),\n            (1, 2, 0, 0),\n            (1, 2, 0, 5),\n            (10, 20, 200, 5),\n            (-1, -2, 0, 0),\n            (5, 5, 100, -3),\n        ] {\n            let c_out = c_fn(p1, p2, p3, p4);\n            let r_out = r_fn(p1, p2, p3, p4);\n            // Diff comes from compare_allocations 1/2/3 in {1,2,3}. After being\n            // added to result and possibly scaled by param3/100, diff <= 2 in\n            // absolute value before scaling. After scaling, diff could be 0\n            // (because scaling integer-divides by 100).\n            let diff = (c_out - r_out).abs();\n            assert!(diff <= 2 + (p3.abs() / 50 + 1), \"arity4({},{},{},{}) C={} R={} diff={}\", p1, p2, p3, p4, c_out, r_out, diff);\n        }\n    }\n}\n\n#[test]\nfn test_arity_dispatch() {\n    // arity dispatches to arity2/3/4. We test the len < 2 case (deterministic)\n    // and that for valid lengths both libraries return values within the\n    // expected non-deterministic spread.\n    unsafe {\n        let (c_lib, r_lib) = load_libs();\n        let c_fn: Symbol<unsafe extern \"C\" fn(c_uchar, *mut c_int) -> c_int> = c_lib.get(b\"arity\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(c_uchar, *mut c_int) -> c_int> = r_lib.get(b\"arity\").unwrap();\n\n        // Deterministic cases (len < 2): always returns -1.\n        for len in 0u8..2u8 {\n            let mut params = vec![1, 2, 3, 4];\n            let c_out = c_fn(len, params.as_mut_ptr());\n            let r_out = r_fn(len, params.as_mut_ptr());\n            assert_eq!(c_out, -1);\n            assert_eq!(r_out, -1, \"arity({}) Rust returned {}, expected -1\", len, r_out);\n            assert_eq!(c_out, r_out);\n        }\n\n        // Larger len: just sanity check that values are roughly in same range.\n        for len in 2u8..=5u8 {\n            let mut params = vec![1, 2, 3, 4];\n            let c_out = c_fn(len, params.as_mut_ptr());\n            let r_out = r_fn(len, params.as_mut_ptr());\n            let diff = (c_out - r_out).abs();\n            assert!(diff <= 5, \"arity({}) C={} R={} diff too large\", len, c_out, r_out);\n        }\n    }\n}\n\n#[test]\nfn test_symbols_match() {\n    // Verify that both libs export the same set of public symbols we care about.\n    unsafe {\n        let (c_lib, r_lib) = load_libs();\n        for name in &[\n            \"apply_bitmask\",\n            \"arity\",\n            \"arity2\",\n            \"arity3\",\n            \"arity4\",\n            \"compare_allocations\",\n            \"init_matrix\",\n            \"process_string\",\n            \"shift_array\",\n        ] {\n            let _: Symbol<unsafe extern \"C\" fn()> = c_lib.get(name.as_bytes())\n                .unwrap_or_else(|_| panic!(\"C lib missing symbol {}\", name));\n            let _: Symbol<unsafe extern \"C\" fn()> = r_lib.get(name.as_bytes())\n                .unwrap_or_else(|_| panic!(\"Rust lib missing symbol {}\", name));\n        }\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
