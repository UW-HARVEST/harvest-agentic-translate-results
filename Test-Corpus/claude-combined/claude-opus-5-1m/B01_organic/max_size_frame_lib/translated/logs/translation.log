FrameFn> = unsafe { c_lib.get(b\"max_size_frame\").unwrap() };\n    let r_fn: Symbol<MaxSizeFrameFn> = unsafe { r_lib.get(b\"max_size_frame\").unwrap() };\n\n    // Edge cases including potential overflow scenarios.\n    let cases: &[(c_uint, c_uint, c_uint)] = &[\n        (0, 0, 0),\n        (u32::MAX, 1, 1),\n        (1, u32::MAX, 1),\n        (1, 1, u32::MAX),\n        (u32::MAX, u32::MAX, u32::MAX),\n        (4096, 2, 16),\n        (4096, 2, 24),\n        (4096, 2, 32),\n        (4096, 1, 16),\n        (4096, 8, 16),\n    ];\n\n    for &(b, ch, bd) in cases {\n        let c_out = unsafe { c_fn(b, ch, bd) };\n        let r_out = unsafe { r_fn(b, ch, bd) };\n        assert_eq!(\n            c_out, r_out,\n            \"mismatch for ({}, {}, {})\",\n            b, ch, bd\n        );\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":232,"cache_read_input_tokens":16759,"cache_creation":{"ephemeral_5m_input_tokens":232,"ephemeral_1h_input_tokens":0},"output_tokens":29,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"fe8e6dbf-9338-4829-9374-21f08693101b","uuid":"705b5e61-e56e-456b-b63f-a2e0188ca5be"}
