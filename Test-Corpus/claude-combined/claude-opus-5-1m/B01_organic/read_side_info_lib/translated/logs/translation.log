ld/libtranslated_rust.so\"\n}\n\nfn rust_lib_path() -> &'static str {\n    \"target/release/libtranslated_rust.so\"\n}\n\nunsafe fn call_lib(\n    lib_path: &str,\n    buf: &[u8],\n    limit_offset: i32,\n    pos_offset: i32,\n    hdr: &[u8; 4],\n) -> (c_int, [L3GrInfoT; 4], BsT) {\n    let lib = unsafe { Library::new(lib_path) }.expect(\"load lib\");\n    let func: Symbol<ReadSideInfoFn> =\n        unsafe { lib.get(b\"read_side_info\") }.expect(\"get symbol\");\n\n    let mut bs = BsT {\n        buf: buf.as_ptr(),\n        pos: pos_offset,\n        limit: ((buf.len() as i32) * 8) - limit_offset,\n    };\n\n    let mut grs: [L3GrInfoT; 4] = unsafe { std::mem::zeroed() };\n    let result = unsafe { func(&mut bs as *mut _, grs.as_mut_ptr(), hdr.as_ptr()) };\n    (result, grs, bs)\n}\n\n/// Compare gr structs; sfbtab pointers are NOT compared because they live in\n/// different .so static segments.\nfn assert_grs_eq(c: &L3GrInfoT, r: &L3GrInfoT) {\n    // Compare via byte representation of all fields except sfbtab pointer.\n    // Easier: directly compare fields.\n    assert_eq!(c.part_23_length, r.part_23_length, \"part_23_length\");\n    assert_eq!(c.big_values, r.big_values, \"big_values\");\n    assert_eq!(c.scalefac_compress, r.scalefac_compress, \"scalefac_compress\");\n    assert_eq!(c.global_gain, r.global_gain, \"global_gain\");\n    assert_eq!(c.block_type, r.block_type, \"block_type\");\n    assert_eq!(c.mixed_block_flag, r.mixed_block_flag, \"mixed_block_flag\");\n    assert_eq!(c.n_long_sfb, r.n_long_sfb, \"n_long_sfb\");\n    assert_eq!(c.n_short_sfb, r.n_short_sfb, \"n_short_sfb\");\n    assert_eq!(c.table_select, r.table_select, \"table_select\");\n    assert_eq!(c.region_count, r.region_count, \"region_count\");\n    assert_eq!(c.subblock_gain, r.subblock_gain, \"subblock_gain\");\n    assert_eq!(c.preflag, r.preflag, \"preflag\");\n    assert_eq!(c.scalefac_scale, r.scalefac_scale, \"scalefac_scale\");\n    assert_eq!(c.count1_table, r.count1_table, \"count1_table\");\n    assert_eq!(c.scfsi, r.scfsi, \"scfsi\");\n    // Compare what sfbtab points to (first 23 bytes are always meaningful for long/mixed,\n    // 40 for short, but 23 is always safe to read for either table type).\n    if c.sfbtab.is_null() && r.sfbtab.is_null() {\n        return;\n    }\n    assert!(!c.sfbtab.is_null());\n    assert!(!r.sfbtab.is_null());\n    let c_slice = unsafe { std::slice::from_raw_parts(c.sfbtab, 23) };\n    let r_slice = unsafe { std::slice::from_raw_parts(r.sfbtab, 23) };\n    assert_eq!(c_slice, r_slice, \"sfbtab contents differ\");\n}\n\nfn run_compare(buf: &[u8], pos: i32, limit_offset: i32, hdr: [u8; 4]) {\n    let (c_ret, c_grs, c_bs) =\n        unsafe { call_lib(c_lib_path(), buf, limit_offset, pos, &hdr) };\n    let (r_ret, r_grs, r_bs) =\n        unsafe { call_lib(rust_lib_path(), buf, limit_offset, pos, &hdr) };\n\n    assert_eq!(c_ret, r_ret, \"return value mismatch hdr={:?}\", hdr);\n    assert_eq!(c_bs.pos, r_bs.pos, \"bs.pos mismatch hdr={:?}\", hdr);\n    assert_eq!(c_bs.limit, r_bs.limit, \"bs.limit mismatch hdr={:?}\", hdr);\n    for i in 0..4 {\n        assert_grs_eq(&c_grs[i], &r_grs[i]);\n    }\n}\n\n#[test]\nfn test_mpeg1_basic() {\n    // hdr[1] & 0x8 -> MPEG1 (so bit 3 set), gr_count = 2, scfsi width 7+2=9.\n    // hdr[3] & 0xC0 != 0xC0 (mono case is 0xC0; pick 0x40 for stereo).\n    // hdr[2] >> 2 & 3 -> sample-rate index input.\n    let buf = vec![0xA5u8; 256];\n    let hdr = [0xFF, 0xFB /* 0x8 set, version flags set */, 0x90, 0x40];\n    run_compare(&buf, 0, 0, hdr);\n}\n\n#[test]\nfn test_mpeg1_mono() {\n    let buf = vec![0xC3u8; 256];\n    // hdr[3] & 0xC0 == 0xC0 -> mono (gr_count = 1, doubled to 2).\n    let hdr = [0xFF, 0xFB, 0x90, 0xC0];\n    run_compare(&buf, 0, 0, hdr);\n}\n\n#[test]\nfn test_mpeg2_stereo() {\n    // MPEG2: hdr[1] & 0x8 == 0. So gr_count = 2 (stereo), scfsi width 8+2=10.\n    let buf = vec![0x33u8; 256];\n    let hdr = [0xFF, 0xF3, 0x90, 0x40];\n    run_compare(&buf, 0, 0, hdr);\n}\n\n#[test]\nfn test_mpeg2_mono() {\n    let buf = vec![0x77u8; 256];\n    let hdr = [0xFF, 0xF3, 0x90, 0xC0];\n    run_compare(&buf, 0, 0, hdr);\n}\n\n#[test]\nfn test_various_headers() {\n    // Sweep various possible headers. We carefully limit to cases that don't\n    // trigger out-of-bounds reads within the get_bits loop.\n    let buf = vec![0xDEu8; 512];\n    for hdr1_bits in [0x00u8, 0x08, 0x18, 0x10] {\n        for hdr2_sr in 0..3u8 {\n            for hdr3_chan in [0x00u8, 0x40, 0x80, 0xC0] {\n                let hdr = [\n                    0xFF,\n                    0xE0 | hdr1_bits,\n                    (hdr2_sr << 2),\n                    hdr3_chan,\n                ];\n                run_compare(&buf, 0, 0, hdr);\n            }\n        }\n    }\n}\n\n#[test]\nfn test_buffer_patterns() {\n    let patterns: [u8; 8] = [0x00, 0xFF, 0xAA, 0x55, 0x12, 0xED, 0x80, 0x01];\n    for p in patterns {\n        eprintln!(\"pattern 0x{:02X}\", p);\n        let buf = vec![p; 256];\n        let hdr = [0xFF, 0xFB, 0x90, 0x40];\n        run_compare(&buf, 0, 0, hdr);\n    }\n}\n\n#[test]\nfn test_with_pos_offset() {\n    // Start with a non-zero bit position to exercise the alignment branches.\n    let buf = vec![0xA5u8; 256];\n    let hdr = [0xFF, 0xFB, 0x90, 0x40];\n    for pos in [1, 3, 5, 7, 8, 13, 17, 31] {\n        run_compare(&buf, pos, 0, hdr);\n    }\n}\n\n#[test]\nfn test_truncated_limit() {\n    // When pos > limit happens inside get_bits, it returns 0. This exercises\n    // that path (and may trigger the part_23_sum overflow check, returning -1).\n    let buf = vec![0xA5u8; 256];\n    let hdr = [0xFF, 0xFB, 0x90, 0x40];\n    // limit_offset = (buf.len()*8) - actual_limit. Use large offset to make\n    // limit small and force the overflow check.\n    for limit_off in [100, 500, 1000, 1500, 2000] {\n        run_compare(&buf, 0, limit_off, hdr);\n    }\n}\n\n#[test]\nfn test_random_buffers() {\n    // Pseudo-random buffer/header combos (deterministic, no rand crate).\n    let mut state: u64 = 0xDEADBEEFCAFEBABE;\n    for _ in 0..50 {\n        let mut buf = vec![0u8; 256];\n        for b in &mut buf {\n            state = state.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);\n            *b = (state >> 33) as u8;\n        }\n        state = state.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);\n        // hdr is 4 bytes; we only really care about hdr[1..=3].\n        let hdr = [\n            0xFF,\n            (state as u8) | 0xE0,\n            (state >> 8) as u8,\n            (state >> 16) as u8,\n        ];\n        run_compare(&buf, 0, 0, hdr);\n    }\n}\n","structuredPatch":[{"oldStart":65,"oldLines":22,"newStart":65,"newLines":13,"lines":[" type ReadSideInfoFn =","     unsafe extern \"C\" fn(*mut BsT, *mut L3GrInfoT, *const u8) -> c_int;"," ","-fn c_lib_path() -> &'static str {","-    \"c_src/build/libtranslated_rust.so\"","-}","-","-fn rust_lib_path() -> &'static str {","-    \"target/release/libtranslated_rust.so\"","-}","-","-unsafe fn call_lib(","-    lib_path: &str,","+unsafe fn call_lib_via(","+    lib: &Library,","     buf: &[u8],","     limit_offset: i32,","     pos_offset: i32,","     hdr: &[u8; 4],"," ) -> (c_int, [L3GrInfoT; 4], BsT) {","-    let lib = unsafe { Library::new(lib_path) }.expect(\"load lib\");","     let func: Symbol<ReadSideInfoFn> =","         unsafe { lib.get(b\"read_side_info\") }.expect(\"get symbol\");"," "]}],"userModified":false,"replaceAll":false}}
