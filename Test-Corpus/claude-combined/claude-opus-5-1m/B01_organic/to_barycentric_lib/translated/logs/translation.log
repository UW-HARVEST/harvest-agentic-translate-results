      p2,\n            p3,\n            p\n        );\n    }\n}\n\n#[test]\nfn test_identity_triangle() {\n    let p1 = LmVec2 { x: 0.0, y: 0.0 };\n    let p2 = LmVec2 { x: 1.0, y: 0.0 };\n    let p3 = LmVec2 { x: 0.0, y: 1.0 };\n    run_case(p1, p2, p3, LmVec2 { x: 0.25, y: 0.25 });\n    run_case(p1, p2, p3, LmVec2 { x: 0.0, y: 0.0 });\n    run_case(p1, p2, p3, LmVec2 { x: 1.0, y: 0.0 });\n    run_case(p1, p2, p3, LmVec2 { x: 0.0, y: 1.0 });\n    run_case(p1, p2, p3, LmVec2 { x: 0.5, y: 0.5 });\n}\n\n#[test]\nfn test_offset_triangle() {\n    let p1 = LmVec2 { x: 2.0, y: 3.0 };\n    let p2 = LmVec2 { x: 5.0, y: 3.0 };\n    let p3 = LmVec2 { x: 2.0, y: 7.0 };\n    run_case(p1, p2, p3, LmVec2 { x: 3.5, y: 5.0 });\n    run_case(p1, p2, p3, LmVec2 { x: 0.0, y: 0.0 });\n    run_case(p1, p2, p3, LmVec2 { x: 100.0, y: -50.0 });\n}\n\n#[test]\nfn test_negative_coords() {\n    let p1 = LmVec2 { x: -1.0, y: -1.0 };\n    let p2 = LmVec2 { x: 1.0, y: -1.0 };\n    let p3 = LmVec2 { x: 0.0, y: 1.0 };\n    run_case(p1, p2, p3, LmVec2 { x: 0.0, y: 0.0 });\n    run_case(p1, p2, p3, LmVec2 { x: -0.5, y: 0.5 });\n    run_case(p1, p2, p3, LmVec2 { x: 1e-7, y: 1e-7 });\n}\n\n#[test]\nfn test_small_and_large() {\n    let p1 = LmVec2 { x: 1e-6, y: 1e-6 };\n    let p2 = LmVec2 { x: 2e-6, y: 1e-6 };\n    let p3 = LmVec2 { x: 1e-6, y: 3e-6 };\n    run_case(p1, p2, p3, LmVec2 { x: 1.5e-6, y: 2e-6 });\n\n    let p1 = LmVec2 { x: 1e6, y: 1e6 };\n    let p2 = LmVec2 { x: 2e6, y: 1e6 };\n    let p3 = LmVec2 { x: 1e6, y: 3e6 };\n    run_case(p1, p2, p3, LmVec2 { x: 1.5e6, y: 2e6 });\n}\n\n#[test]\nfn test_random_cases() {\n    // deterministic pseudo-random sweep\n    let mut state: u32 = 0x12345678;\n    let next = |s: &mut u32| -> f32 {\n        *s = s.wrapping_mul(1664525).wrapping_add(1013904223);\n        let v = (*s as f32) / (u32::MAX as f32);\n        v * 20.0 - 10.0\n    };\n\n    for _ in 0..200 {\n        let p1 = LmVec2 {\n            x: next(&mut state),\n            y: next(&mut stat