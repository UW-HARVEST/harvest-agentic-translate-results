);\n\n    // Flush libc stdout buffer.\n    unsafe { libc::fflush(std::ptr::null_mut()) };\n\n    let new_fd = tmp.as_raw_fd();\n    unsafe {\n        libc::dup2(new_fd, 1);\n    }\n\n    f();\n\n    unsafe { libc::fflush(std::ptr::null_mut()) };\n\n    // Restore stdout\n    unsafe {\n        libc::dup2(saved_stdout, 1);\n        libc::close(saved_stdout);\n    }\n\n    // Re-open the file via fd to read the captured bytes.\n    let mut f = unsafe { std::fs::File::from_raw_fd(libc::dup(new_fd)) };\n    f.seek(SeekFrom::Start(0)).expect(\"seek\");\n    let mut buf = Vec::new();\n    f.read_to_end(&mut buf).expect(\"read\");\n    buf\n}\n\n#[test]\nfn test_foo_matches() {\n    let c = unsafe { Library::new(c_lib_path()).expect(\"load c lib\") };\n    let r = unsafe { Library::new(rust_lib_path()).expect(\"load rust lib\") };\n\n    let c_foo: Symbol<FooFn> = unsafe { c.get(b\"foo\").unwrap() };\n    let r_foo: Symbol<FooFn> = unsafe { r.get(b\"foo\").unwrap() };\n\n    let cases: &[(&str, c_char)] = &[\n        (\"\", b'A' as c_char),\n        (\"AAAA\", b'A' as c_char),\n        (\"aaaaa\", b'A' as c_char),\n        (\"hello world\", b'l' as c_char),\n        (\"xxxx-xxxx\", b'x' as c_char),\n        (\"AaXxAaXx\", b'A' as c_char),\n        (\"AaXxAaXx\", b'x' as c_char),\n        (\"the quick brown fox jumps over the lazy dog\", b' ' as c_char),\n        (\"ABCDEFGABCDEFG\", b'G' as c_char),\n        (\"\\n\\t\\rA\", b'A' as c_char),\n        // Edge: char that doesn't appear\n        (\"hello\", b'z' as c_char),\n    ];\n\n    for (s, c_arg) in cases {\n        let cs = CString::new(*s).unwrap();\n        let cv = unsafe { c_foo(cs.as_ptr(), *c_arg) };\n        let rv = unsafe { r_foo(cs.as_ptr(), *c_arg) };\n        assert_eq!(cv, rv, \"foo mismatch on input {:?}, c={}\", s, *c_arg as u8 as char);\n    }\n}\n\n#[test]\nfn test_driver_matches() {\n    let c = unsafe { Library::new(c_lib_path()).expect(\"load c lib\") };\n    let r = unsafe { Library::new(rust_lib_path()).expect(\"load rust lib\") };\n\n    let c_driver: Symbol<DriverFn> = unsafe { c.get(b\"driver\").unwrap() };\n    let r_driver: Symbol<DriverFn> = unsafe { r.get(b\"driver\").unwrap() };\n\n    let inputs = &[\n        \"\",\n        \"A\",\n        \"x\",\n        \"Ax\",\n        \"AAA\",\n        \"xxx\",\n        \"hello world\",\n        \"AxAxAxAx\",\n        \"the quick brown fox jumps over the lazy dog\",\n        \"no matches here\",\n        \"Mixed CASE WITH X and A characters\",\n    ];\n\n    for s in inputs {\n        let cs = CString::new(*s).unwrap();\n\n        let c_out = capture_stdout(|| unsafe { c_driver(cs.as_ptr()) });\n        let r_out = capture_stdout(|| unsafe { r_driver(cs.as_ptr()) });\n\n        assert_eq!(c_out, r_out, \"driver output mismatch on input {:?}\\nC:    {:?}\\nRust: {:?}\",\n            s, String::from_utf8_lossy(&c_out), String::from_utf8_lossy(&r_out));\n    }\n}\n","structuredPatch":[{"oldStart":7,"oldLines":6,"newStart":7,"newLines":10,"lines":[" type FooFn = unsafe extern \"C\" fn(*const c_char, c_char) -> c_int;"," type DriverFn = unsafe extern \"C\" fn(*const c_char);"," ","+// A global mutex to ensure stdout-capturing tests don't run concurrently","+// with each other or with other tests that touch stdout.","+static STDOUT_LOCK: std::sync::Mutex<()> = std::sync::Mutex::new(());","+"," fn c_lib_path() -> &'static str {","     \"c_src/build/libdriver.so\""," }"]}],"userModified":false,"replaceAll":false}}
