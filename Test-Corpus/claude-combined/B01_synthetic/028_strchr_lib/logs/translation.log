()).expect(\"load c lib\") };\n    let r = unsafe { Library::new(rust_lib_path()).expect(\"load rust lib\") };\n\n    let c_foo: Symbol<FooFn> = unsafe { c.get(b\"foo\").unwrap() };\n    let r_foo: Symbol<FooFn> = unsafe { r.get(b\"foo\").unwrap() };\n\n    let cases: &[(&str, c_char)] = &[\n        (\"\", b'A' as c_char),\n        (\"AAAA\", b'A' as c_char),\n        (\"aaaaa\", b'A' as c_char),\n        (\"hello world\", b'l' as c_char),\n        (\"xxxx-xxxx\", b'x' as c_char),\n        (\"AaXxAaXx\", b'A' as c_char),\n        (\"AaXxAaXx\", b'x' as c_char),\n        (\"the quick brown fox jumps over the lazy dog\", b' ' as c_char),\n        (\"ABCDEFGABCDEFG\", b'G' as c_char),\n        (\"\\n\\t\\rA\", b'A' as c_char),\n        // Edge: char that doesn't appear\n        (\"hello\", b'z' as c_char),\n    ];\n\n    for (s, c_arg) in cases {\n        let cs = CString::new(*s).unwrap();\n        let cv = unsafe { c_foo(cs.as_ptr(), *c_arg) };\n        let rv = unsafe { r_foo(cs.as_ptr(), *c_arg) };\n        assert_eq!(cv, rv, \"foo mismatch on input {:?}, c={}\", s, *c_arg as u8 as char);\n    }\n}\n\n#[test]\nfn test_driver_matches() {\n    let c = unsafe { Library::new(c_lib_path()).expect(\"load c lib\") };\n    let r = unsafe { Library::new(rust_lib_path()).expect(\"load rust lib\") };\n\n    let c_driver: Symbol<DriverFn> = unsafe { c.get(b\"driver\").unwrap() };\n    let r_driver: Symbol<DriverFn> = unsafe { r.get(b\"driver\").unwrap() };\n\n    let inputs = &[\n        \"\",\n        \"A\",\n        \"x\",\n        \"Ax\",\n        \"AAA\",\n        \"xxx\",\n        \"hello world\",\n        \"AxAxAxAx\",\n        \"the quick brown fox jumps over the lazy dog\",\n        \"no matches here\",\n        \"Mixed CASE WITH X and A characters\",\n    ];\n\n    for s in inputs {\n        let cs = CString::new(*s).unwrap();\n\n        let c_out = capture_stdout(|| unsafe { c_driver(cs.as_ptr()) });\n        let r_out = capture_stdout(|| unsafe { r_driver(cs.as_ptr(