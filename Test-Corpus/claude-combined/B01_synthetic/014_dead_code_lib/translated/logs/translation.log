.create(true)\n        .truncate(true)\n        .open(&p)\n        .unwrap();\n    // Unlink so it disappears on close\n    let _ = fs::remove_file(&p);\n    f\n}\n\nunsafe fn call_print_line(lib: &Library, s: Option<&str>) -> Vec<u8> {\n    let sym: Symbol<unsafe extern \"C\" fn(*const c_char)> =\n        lib.get(b\"printLine\\0\").expect(\"printLine missing\");\n    let cs;\n    let ptr = match s {\n        Some(s) => {\n            cs = CString::new(s).unwrap();\n            cs.as_ptr()\n        }\n        None => std::ptr::null(),\n    };\n    capture_stdout(|| sym(ptr))\n}\n\nunsafe fn call_void(lib: &Library, name: &[u8]) -> Vec<u8> {\n    // name should include trailing nul\n    let sym: Symbol<unsafe extern \"C\" fn()> =\n        lib.get(name).unwrap_or_else(|_| panic!(\"missing symbol: {:?}\", name));\n    capture_stdout(|| sym())\n}\n\n#[test]\nfn print_line_with_string() {\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).expect(\"load c\");\n        let r_lib = Library::new(rust_lib_path()).expect(\"load rust\");\n        let c_out = call_print_line(&c_lib, Some(\"hello world\"));\n        let r_out = call_print_line(&r_lib, Some(\"hello world\"));\n        assert_eq!(c_out, r_out);\n    }\n}\n\n#[test]\nfn print_line_with_empty_string() {\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).expect(\"load c\");\n        let r_lib = Library::new(rust_lib_path()).expect(\"load rust\");\n        let c_out = call_print_line(&c_lib, Some(\"\"));\n        let r_out = call_print_line(&r_lib, Some(\"\"));\n        assert_eq!(c_out, r_out);\n    }\n}\n\n#[test]\nfn print_line_with_null() {\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).expect(\"load c\");\n        let r_lib = Library::new(rust_lib_path()).expect(\"load rust\");\n        let c_out = call_print_line(&c_lib, None);\n        let r_out = call_print_line(&r_lib, None);\n        assert_eq!(c_out, r_out);\n        assert!(c_out.is_empty());\n    }\n}\n\n#[test]\nfn print_line_special_characters() {\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).expect(\"load c\");\n        let r_lib = Library::new(rust_lib_path()).expect(\"load rust\");\n        let inputs = [\"abc 123\", \"with\\ttab\", \"line\", \"100% percent\"];\n        for s in inputs.iter() {\n            let c_out = call_print_line(&c_lib, Some(s));\n            let r_out = call_print_line(&r_lib, Some(s));\n            assert_eq!(c_out, r_out, \"mismatch on {:?}\", s);\n        }\n    }\n}\n\n#[test]\nfn good_function() {\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).expect(\"load c\");\n        let r_lib = Library::new(rust_lib_path()).expect(\"load rust\");\n        let c_out = call_void(&c_lib, b\"good\\0\");\n        let r_out = call_void(&r_lib, b\"good\\0\");\n        assert_eq!(c_out, r_out);\n    }\n}\n\n#[test]\nfn bad_function() {\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).expect(\"load c\");\n        let r_lib = Library::new(rust_lib_path()).expect(\"load rust\");\n        let c_out = call_void(&c_lib, b\"bad\\0\");\n        let r_out = call_void(&r_lib, b\"bad\\0\");\n        assert_eq!(c_out, r_out);\n    }\n}\n\n#[test]\nfn driver_function() {\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).expect(\"load c\");\n        let r_lib = Library::new(rust_lib_path()).expect(\"load rust\");\n        let c_out = call_void(&c_lib, b\"driver\\0\");\n        let r_out = call_void(&r_lib, b\"driver\\0\");\n        assert_eq!(c_out, r_out);\n    }\n}\n\n#[test]\nfn rust_lib_exports_all_c_public_symbols() {\n    // Ensure each public C symbol is also exported by the Rust lib.\n    unsafe {\n        let r_lib = Library::new(rust_lib_path()).expect(\"load rust\");\n        let _: Symbol<unsafe extern \"C\" fn(*const c_char)> =\n            r_lib.get(b\"printLine\\0\").expect(\"printLine missing\");\n        let _: Symbol<unsafe extern \"C\" fn()> = r_lib.get(b\"good\\0\").expect(\"good missing\");\n        let 