mut buf).unwrap();\n    buf\n}\n\nfn tempfile_rs() -> std::fs::File {\n    // Use libc tmpfile to get an unnamed temp file.\n    extern \"C\" {\n        fn tmpfile() -> *mut libc::FILE;\n        fn fileno(stream: *mut libc::FILE) -> i32;\n    }\n    let fp = unsafe { tmpfile() };\n    assert!(!fp.is_null(), \"tmpfile failed\");\n    let fd = unsafe { fileno(fp) };\n    let dup_fd = unsafe { libc::dup(fd) };\n    // Close the FILE*, the duped fd remains.\n    unsafe { libc::fclose(fp) };\n    unsafe { std::fs::File::from_raw_fd(dup_fd) }\n}\n\nfn run_driver(lib_path: &std::path::Path, x: c_int, y: c_int) -> Vec<u8> {\n    let lib = unsafe { Library::new(lib_path).expect(\"failed to load lib\") };\n    let sym: Symbol<DriverFn> = unsafe { lib.get(b\"driver\").expect(\"no driver symbol\") };\n    capture_stdout(|| unsafe { sym(x, y) })\n}\n\nfn compare(x: c_int, y: c_int) {\n    let c_out = run_driver(&c_lib_path(), x, y);\n    let r_out = run_driver(&rust_lib_path(), x, y);\n    assert_eq!(\n        c_out,\n        r_out,\n        \"mismatch for x={}, y={}\\nC:\\n{}\\nRust:\\n{}\",\n        x,\n        y,\n        String::from_utf8_lossy(&c_out),\n        String::from_utf8_lossy(&r_out)\n    );\n}\n\n#[test]\nfn test_zero_zero() {\n    compare(0, 0);\n}\n\n#[test]\nfn test_negatives() {\n    compare(-1, -1);\n    compare(-5, 0);\n    compare(0, -3);\n}\n\n#[test]\nfn test_simple_cases() {\n    compare(1, 0);\n    compare(0, 1);\n    compare(1, 1);\n    compare(2, 2);\n    compare(3, 3);\n}\n\n#[test]\nfn test_trigger_goto_label2() {\n    // x==1 && y==4 triggers `goto label2`\n    compare(1, 4);\n}\n\n#[test]\nfn test_larger_values() {\n    compare(5, 5);\n    compare(10, 1);\n    compare(1, 10);\n    compare(7, 3);\n    compare(3, 7);\n    compare(4, 4);\n}\n\n#[test]\nfn test_x_only() {\n    for x in 0..8 {\n        compare(x, 0);\n    }\n}\n\n#[test]\nfn test_y_only() {\n    for y in 0..8 {\n        compare(0, y);\n    }\n}\n\n#[test]\nfn test_grid() {\n    for x in 0..6 {\n        for y in 0..6 {\n            compare(x, y);\n        }\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":237,"cache_read_input_tokens":19186,"cache_creation":{"ephemeral_5m_input_tokens":237,"ephemeral_1h_input_tokens":0},"output_tokens":34,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"f7dc753a-e3cd-4bf8-8469-7e4718f73f8f","uuid":"e7322551-cae2-454c-b569-49fd04683d2f"}
