ists() {\n        p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n            .join(\"target\")\n            .join(\"debug\")\n            .join(\"libdriver.so\");\n    }\n    p\n}\n\n/// Capture stdout written by `f` (including from C printf) and return it as bytes.\nfn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {\n    unsafe {\n        // Make sure libc stdio buffers are flushed before redirecting.\n        fflush(stdout);\n\n        let stdout_fd = fileno(stdout);\n        let saved = dup(stdout_fd);\n        assert!(saved >= 0, \"dup failed\");\n\n        // Create a temporary file to redirect stdout to.\n        let tmp = tempfile();\n        let tmp_fd = tmp.as_raw_fd();\n\n        let rc = dup2(tmp_fd, stdout_fd);\n        assert!(rc >= 0, \"dup2 failed\");\n\n        f();\n\n        fflush(stdout);\n\n        // Restore stdout\n        let rc = dup2(saved, stdout_fd);\n        assert!(rc >= 0, \"dup2 restore failed\");\n        libc::close(saved);\n\n        // Read the captured bytes.\n        let mut tmp = tmp;\n        tmp.seek(SeekFrom::Start(0)).unwrap();\n        let mut buf = Vec::new();\n        tmp.read_to_end(&mut buf).unwrap();\n        buf\n    }\n}\n\nfn tempfile() -> File {\n    // Create a tempfile via memfd / tmp directory.\n    unsafe {\n        let name = b\"/tmp/.rust_c_compare_XXXXXX\\0\";\n        let mut tpl: Vec<u8> = name.to_vec();\n        let fd = libc::mkstemp(tpl.as_mut_ptr() as *mut i8);\n        assert!(fd >= 0, \"mkstemp failed\");\n        // Unlink so it's removed on close.\n        libc::unlink(tpl.as_ptr() as *const i8);\n        File::from_raw_fd(fd)\n    }\n}\n\nfn call_driver(lib_path: &PathBuf, x: c_int) -> Vec<u8> {\n    let lib = unsafe { Library::new(lib_path).expect(\"failed to load lib\") };\n    let driver: Symbol<unsafe extern \"C\" fn(c_int)> =\n        unsafe { lib.get(b\"driver\\0\").expect(\"driver symbol not found\") };\n    let out = capture_stdout(|| unsafe {\n        driver(x);\n    });\n    // Drop the library only after we're done.\n    drop(driver);\n    drop(lib);\n    out\n}\n\nfn compare_for(x: c_int) {\n    let c_out = call_driver(&c_lib_path(), x);\n    let r_out = call_driver(&rust_lib_path(), x);\n    assert_eq!(\n        c_out, r_out,\n        \"outputs differ for x={}: c={:?} rust={:?}\",\n        x,\n        String::from_utf8_lossy(&c_out),\n        String::from_utf8_lossy(&r_out)\n    );\n}\n\n#[test]\nfn driver_zero() {\n    compare_for(0);\n}\n\n#[test]\nfn driver_negative() {\n    compare_for(-5);\n}\n\n#[test]\nfn driver_one() {\n    compare_for(1);\n}\n\n#[test]\nfn driver_small() {\n    compare_for(5);\n}\n\n#[test]\nfn driver_medium() {\n    compare_for(100);\n}\n\n#[test]\nfn driver_large() {\n    compare_for(10_000);\n}\n","structuredPatch":[{"oldStart":4,"oldLines":7,"newStart":4,"newLines":11,"lines":[" use std::io::{Read, Seek, SeekFrom};"," use std::os::unix::io::{AsRawFd, FromRawFd};"," use std::path::PathBuf;","+use std::sync::Mutex;"," ","+// Serialize stdout captures across tests so parallel runs don't trample each other.","+static CAPTURE_LOCK: Mutex<()> = Mutex::new(());","+"," extern \"C\" {","     fn fflush(stream: *mut libc::FILE) -> c_int;","     fn dup(fd: c_int) -> c_int;"]}],"userModified":false,"replaceAll":false}}
