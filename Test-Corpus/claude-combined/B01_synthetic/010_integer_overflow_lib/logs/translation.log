    if let Ok(td) = std::env::var(\"CARGO_TARGET_DIR\") {\n        p = PathBuf::from(td);\n    } else {\n        p.push(\"target\");\n    }\n    // Tests run with the debug profile.\n    let debug = p.join(\"debug\").join(\"libdriver.so\");\n    if debug.exists() {\n        return debug;\n    }\n    // Fall back to release if that's all that's been built.\n    p.join(\"release\").join(\"libdriver.so\")\n}\n\n/// Capture everything written to `stdout` (fd 1, including by C `printf`)\n/// during the closure.\nfn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {\n    let _guard = STDOUT_LOCK.lock().unwrap_or_else(|e| e.into_inner());\n\n    // Flush any pending Rust-side stdout buffering first.\n    use std::io::Write;\n    std::io::stdout().flush().ok();\n\n    unsafe {\n        // Save the original stdout fd.\n        let saved: RawFd = libc::dup(1);\n        assert!(saved >= 0, \"dup(1) failed\");\n\n        // Create a pipe.\n        let mut fds = [0 as RawFd; 2];\n        assert_eq!(libc::pipe(fds.as_mut_ptr()), 0, \"pipe() failed\");\n        let read_fd = fds[0];\n        let write_fd = fds[1];\n\n        // Make the read end non-blocking so we don't deadlock if the\n        // writer never closes (it will close, but be safe).\n        let flags = libc::fcntl(read_fd, libc::F_GETFL, 0);\n        libc::fcntl(read_fd, libc::F_SETFL, flags | libc::O_NONBLOCK);\n\n        // Redirect fd 1 to the write end of the pipe.\n        assert!(libc::dup2(write_fd, 1) >= 0, \"dup2 failed\");\n        libc::close(write_fd);\n\n        // Run the closure.\n        f();\n\n        // Make sure C stdio buffers are flushed.\n        // libc::fflush(NULL) flushes all open output streams.\n        extern \"C\" {\n            fn fflush(stream: *mut libc::FILE) -> i32;\n        }\n        fflush(std::ptr::null_mut());\n\n        // Restore original stdout, then close the pipe write end (which\n        // is currently fd 1 in the redirected world).\n        libc::dup2(saved, 1);\n        libc::close(saved);\n\n        // Drain the pipe.\n        let mut buf = Vec::new();\n        let mut tmp = [0u8; 4096];\n        loop {\n            let n = libc::read(\n                read_fd,\n                tmp.as_mut_ptr() as *mut libc::c_void,\n                tmp.len(),\n            );\n            if n > 0 {\n                buf.extend_from_slice(&tmp[..n as usize]);\n            } else {\n                break;\n            }\n        }\n        libc::close(read_fd);\n        buf\n    }\n}\n\nunsafe fn call_driver(lib: &Library, data: c_char) -> Vec<u8> {\n    let f: Symbol<unsafe extern \"C\" fn(c_char)> = lib.get(b\"driver\").unwrap();\n    capture_stdout(|| f(data))\n}\n\nunsafe fn call_print_hex(lib: &Library, data: c_char) -> Vec<u8> {\n    let f: Symbol<unsafe extern \"C\" fn(c_char)> =\n        lib.get(b\"printHexCharLine\").unwrap();\n    capture_stdout(|| f(data))\n}\n\n#[test]\nfn print_hex_char_line_matches() {\n    let c_path = c_lib_path();\n    let rust_path = rust_lib_path();\n    assert!(c_path.exists(), \"C lib not found at {:?}\", c_path);\n    assert!(rust_path.exists(), \"Rust lib not found at {:?}\", rust_path);\n\n    unsafe {\n        let c_lib = Library::new(&c_path).expect(\"load C lib\");\n        let r_lib = Library::new(&rust_path).expect(\"load Rust lib\");\n\n        // Cover the entire signed-char range (and unsigned char range);\n        // c_char is one byte wide regardless of signedness.\n        for v in i16::from(i8::MIN)..=i16::from(i8::MAX) {\n            let val = v as i8 as c_char;\n            let c_out = call_print_hex(&c_lib, val);\n            let r_out = call_print_hex(&r_lib, val);\n            assert_eq!(\n                c_out, r_out,\n                \"printHexCharLine mismatch for input {}: C={:?}, Rust={:?}\",\n                v, c_out, r_out\n            );\n        }\n    }\n}\n\n#[test]\nfn driver_matches() {\n    let c_path = c_lib_path();\n    let rust_path = rust_lib_path();\n    assert!(c_path.exists(), \"C lib not found at {:?}\", c_path);\n    assert!(rust_path.exists(), \"Rust lib not found at {:?}\", rust_path);\n\n    unsafe {\n        let c_lib = Library::new(&c_path).expect(\"load C lib\");\n        let r_lib = Library::new(&rust_path).expect(\"load Rust lib\");\n\n        for v in i16::from(i8::MIN)..=i16::from(i8::MAX) {\n            let val = v as i8 as c_char;\n            let c_out = call_driver(&c_lib, val);\n            let r_out = call_driver(&r_lib, val);\n            assert_eq!(\n                c_out, r_out,\n                \"driver mismatch for input {}: C={:?}, Rust={:?}\",\n                v, c_out, r_out\n            );\n        }\n    }\n}\n\n// Borrowed minimal libc bindings to avoid pulling in extra deps; we\n// already have libc as a regular dep.\nmod _ensure_read_used {\n    #[allow(dead_code)]\n    fn _r() {\n        let _: fn(&mut std::fs::File, &mut [u8]) -> std::io::Result<usize> =\n            <std::fs::File as super::Read>::read;\n    }\n}\n","structuredPatch":[{"oldStart":166,"oldLines":12,"newStart":166,"newLines":3,"lines":["     }"," }"," ","-// Borrowed minimal libc bindings to avoid pulling in extra deps; we","-// already have libc as a regular dep.","-mod _ensure_read_used {","-    #[allow(dead_code)]","-    fn _r() {","-        let _: fn(&mut std::fs::File, &mut [u8]) -> std::io::Result<usize> =","-            <std::fs::File as super::Read>::read;","-    }","-}"]}],"userModified":false,"replaceAll":false}}
