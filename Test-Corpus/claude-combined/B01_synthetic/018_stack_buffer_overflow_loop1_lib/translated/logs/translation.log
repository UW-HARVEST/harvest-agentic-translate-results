{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_mrr72luusqhgbt2apmkim4ghvlbsh2pzk37hrcs5ziar6kuusuta","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_015YwYEVhYwY8YfvqpMZQKWq","name":"Write","input":{"file_path":"/tmp/harvest-translate-jYInbG/translated_rust/tests/ffi_compare.rs","content":"// Integration test: load both the C and the Rust shared libraries via\n// libloading and compare their byte-for-byte output through FFI.\n\nuse libloading::{Library, Symbol};\nuse std::ffi::{c_char, c_int};\nuse std::io::Read;\nuse std::os::unix::io::FromRawFd;\n\nextern \"C\" {\n    fn dup(fd: c_int) -> c_int;\n    fn dup2(oldfd: c_int, newfd: c_int) -> c_int;\n    fn close(fd: c_int) -> c_int;\n    fn pipe(fds: *mut c_int) -> c_int;\n    fn fflush(stream: *mut libc::FILE) -> c_int;\n}\n\nconst C_LIB_PATH: &str = \"c_src/build/libdriver.so\";\nconst RUST_LIB_PATH: &str = \"target/release/libdriver.so\";\n\n/// Capture everything written to stdout (file descriptor 1) while running `f`.\nfn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {\n    unsafe {\n        // Make sure any buffered C stdout is flushed first.\n        let stdout_stream = libc::fdopen(\n            dup(1),\n            b\"w\\0\".as_ptr() as *const c_char,\n        );\n        if !stdout_stream.is_null() {\n            fflush(stdout_stream as *mut libc::FILE);\n            libc::fclose(stdout_stream);\n        }\n\n        // Save original stdout\n        let saved = dup(1);\n        assert!(saved >= 0, \"dup failed\");\n\n        // Create pipe\n        let mut fds: [c_int; 2] = [0; 2];\n        assert_eq!(pipe(fds.as_mut_ptr()), 0, \"pipe failed\");\n\n        // Redirect stdout to the write end of the pipe\n        assert!(dup2(fds[1], 1) >= 0, \"dup2 failed\");\n        close(fds[1]);\n\n        // Run the function\n        f();\n\n        // Flush stdout (libc) so all data ends up in the pipe\n        // We have to call fflush on the actual stdout stream.\n        fflush(libc_stdout());\n\n        // Restore stdout\n        dup2(saved, 1);\n        close(saved);\n\n        // Read all data from the pipe's read end\n        let mut file = std::fs::File::from_raw_fd(fds[0]);\n        let mut buf = Vec::new();\n        file.read_to_end(&mut buf).expect(\"read failed\");\n        buf\n    }\n}\n\nfn libc_stdout() -> *mut libc::FILE {\n    extern \"C\" {\n        // glibc exports stdout as a pointer variable.\n        static mut stdout: *mut libc::FILE;\n    }\n    unsafe { stdout }\n}\n\nfn load_lib(path: &str) -> Library {\n    unsafe { Library::new(path).unwrap_or_else(|e| panic!(\"failed to load {}: {}\", path, e)) }\n}\n\n#[test]\nfn driver_outputs_match() {\n    let c_lib = load_lib(C_LIB_PATH);\n    let rust_lib = load_lib(RUST_LIB_PATH);\n\n    for &use_good in &[0, 1] {\n        let c_out = unsafe {\n            let f: Symbol<unsafe extern \"C\" fn(c_int)> = c_lib.get(b\"driver\").unwrap();\n            capture_stdout(|| f(use_good))\n        };\n        let r_out = unsafe {\n            let f: Symbol<unsafe extern \"C\" fn(c_int)> = rust_lib.get(b\"driver\").unwrap();\n            capture_stdout(|| f(use_good))\n        };\n        assert_eq!(\n            c_out, r_out,\n            \"driver({}) mismatch: c={:?} rust={:?}\",\n            use_good,\n            String::from_utf8_lossy(&c_out),\n            String::from_utf8_lossy(&r_out)\n        );\n    }\n}\n\n#[test]\nfn good_outputs_match() {\n    let c_lib = load_lib(C_LIB_PATH);\n    let rust_lib = load_lib(RUST_LIB_PATH);\n\n    let c_out = unsafe {\n        let f: Symbol<unsafe extern \"C\" fn()> = c_lib.get(b\"good\").unwrap();\n        capture_stdout(|| f())\n    };\n    let r_out = unsafe {\n        let f: Symbol<unsafe extern \"C\" fn()> = rust_lib.get(b\"good\").unwrap();\n        capture_stdout(|| f())\n    };\n    assert_eq!(c_out, r_out);\n}\n\n#[test]\nfn bad_outputs_match() {\n    let c_lib = load_lib(C_LIB_PATH);\n    let rust_lib = load_lib(RUST_LIB_PATH);\n\n    let c_out = unsafe {\n        let f: Symbol<unsafe extern \"C\" fn()> = c_lib.get(b\"bad\").unwrap();\n        capture_stdout(|| f())\n    };\n    let r_out = unsafe {\n        let f: Symbol<unsafe extern \"C\" fn()> = rust_lib.get(b\"bad\").unwrap();\n        capture_stdout(|| f())\n    };\n    assert_eq!(c_out, r_out);\n}\n\n#[test]\nfn print_int_line_outputs_match() {\n    let c_lib = load_lib(C_LIB_PATH);\n    let rust_lib = load_lib(RUST_LIB_PATH);\n\n    for &n in &[0, 1, -1, 42, i32::MAX, i32::MIN] {\n        let c_out = unsafe {\n            let f: Symbol<unsafe extern \"C\" fn(c_int)> = c_lib.get(b\"printIntLine\").unwrap();\n            capture_stdout(|| f(n))\n        };\n        let r_out = unsafe {\n            let f: Symbol<unsafe extern \"C\" fn(c_int)> = rust_lib.get(b\"printIntLine\").unwrap();\n            capture_stdout(|| f(n))\n        };\n        assert_eq!(c_out, r_out, \"printIntLine({}) mismatch\", n);\n    }\n}\n\n#[test]\nfn print_line_outputs_match() {\n    let c_lib = load_lib(C_LIB_PATH);\n    let rust_lib = load_lib(RUST_LIB_PATH);\n\n    let inputs: &[&[u8]] = &[\n        b\"hello\\0\",\n        b\"\\0\",\n        b\"line with spaces and stuff!\\0\",\n        b\"a\\0\",\n    ];\n    for &s in inputs {\n        let ptr = s.as_ptr() as *const c_char;\n        let c_out = unsafe {\n            let f: Symbol<unsafe extern \"C\" fn(*const c_char)> = c_lib.get(b\"printLine\").unwrap();\n            capture_stdout(|| f(ptr))\n        };\n        let r_out = unsafe {\n            let f: Symbol<unsafe extern \"C\" fn(*const c_char)> = rust_lib.get(b\"printLine\").unwrap();\n            capture_stdout(|| f(ptr))\n        };\n        assert_eq!(c_out, r_out);\n    }\n\n    // Null pointer\n    let c_out = unsafe {\n        let f: Symbol<unsafe extern \"C\" fn(*const c_char)> = c_lib.get(b\"printLine\").unwrap();\n        capture_stdout(|| f(std::ptr::null()))\n    };\n    let r_out = unsafe {\n        let f: Symbol<unsafe extern \"C\" fn(*const c_char)> = rust_lib.get(b\"printLine\").unwrap();\n        capture_stdout(|| f(std::ptr::null()))\n    };\n    assert_eq!(c_out, r_out);\n}\n\n#[test]\nfn exports_match() {\n    // Sanity check that all symbols exported by the C lib also exist in the Rust lib.\n    let c_lib = load_lib(C_LIB_PATH);\n    let rust_lib = load_lib(RUST_LIB_PATH);\n    for sym in &[b\"driver\".as_slice(), b\"good\", b\"bad\", b\"printIntLine\", b\"printLine\"] {\n        unsafe {\n            let _: Symbol<unsafe extern \"C\" fn()> = c_lib\n                .get(sym)\n                .unwrap_or_else(|e| panic!(\"C missing {:?}: {}\", sym, e));\n            let _: Symbol<unsafe extern \"C\" fn()> = rust_lib\n                .get(sym)\n                .unwrap_or_else(|e| panic!(\"Rust missing {:?}: {}\", sym, e));\n        }\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":211,"cache_read_input_tokens":20191,"cache_creation":{"ephemeral_5m_input_tokens":211,"ephemeral_1h_input_tokens":0},"output_tokens":36,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"f5139a6d-c4b0-4432-889e-133ddcdd63f6","uuid":"95d681af-5d8d-4fd4-a0b5-311440757890"}
