{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_dejkr7dmdceqjkkwu4oill6scbad6gzx64vb7tlktyfihlx3odea","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01KL9GSHVJq6EZWRC69YHfLd","name":"Write","input":{"file_path":"/tmp/harvest-translate-j8rxdZ/translated_rust/tests/ffi_compare.rs","content":"use libloading::{Library, Symbol};\nuse std::ffi::c_int;\nuse std::fs::File;\nuse std::io::{Read, Seek, SeekFrom, Write};\nuse std::os::unix::io::AsRawFd;\n\nextern \"C\" {\n    fn dup(oldfd: c_int) -> c_int;\n    fn dup2(oldfd: c_int, newfd: c_int) -> c_int;\n    fn close(fd: c_int) -> c_int;\n    fn fflush(stream: *mut std::ffi::c_void) -> c_int;\n}\n\nconst STDOUT_FD: c_int = 1;\n\n/// Capture stdout produced while calling `f`. Returns captured bytes.\nfn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {\n    // Flush any prior C-stdio buffered output on stdout.\n    unsafe {\n        // fflush(NULL) flushes all open output streams.\n        fflush(std::ptr::null_mut());\n    }\n\n    // Save current stdout fd.\n    let saved = unsafe { dup(STDOUT_FD) };\n    assert!(saved >= 0, \"dup failed\");\n\n    // Open a temp file and redirect fd 1 to it.\n    let tmp_path = std::env::temp_dir().join(format!(\n        \"ffi_capture_{}_{}.tmp\",\n        std::process::id(),\n        std::time::SystemTime::now()\n            .duration_since(std::time::UNIX_EPOCH)\n            .unwrap()\n            .as_nanos()\n    ));\n    let mut tmp = File::options()\n        .read(true)\n        .write(true)\n        .create(true)\n        .truncate(true)\n        .open(&tmp_path)\n        .expect(\"open tmp\");\n\n    let tmp_fd = tmp.as_raw_fd();\n    let rc = unsafe { dup2(tmp_fd, STDOUT_FD) };\n    assert!(rc >= 0, \"dup2 failed\");\n\n    // Run the closure.\n    f();\n\n    // Flush again so all printf output ends up in the file.\n    unsafe {\n        fflush(std::ptr::null_mut());\n    }\n\n    // Restore stdout.\n    let rc = unsafe { dup2(saved, STDOUT_FD) };\n    assert!(rc >= 0, \"dup2 restore failed\");\n    unsafe {\n        close(saved);\n    }\n\n    // Read the temp file.\n    tmp.flush().ok();\n    tmp.seek(SeekFrom::Start(0)).expect(\"seek\");\n    let mut buf = Vec::new();\n    tmp.read_to_end(&mut buf).expect(\"read tmp\");\n\n    // Cleanup\n    drop(tmp);\n    let _ = std::fs::remove_file(&tmp_path);\n\n    buf\n}\n\nfn c_lib_path() -> std::path::PathBuf {\n    let manifest_dir = env!(\"CARGO_MANIFEST_DIR\");\n    std::path::PathBuf::from(manifest_dir).join(\"c_src/build/libdriver.so\")\n}\n\nfn rust_lib_path() -> std::path::PathBuf {\n    let manifest_dir = env!(\"CARGO_MANIFEST_DIR\");\n    // Tests build the library; locate it under target/.\n    // Cargo sets the lib next to the test binary, so check both debug and release.\n    let candidates = [\n        std::path::PathBuf::from(manifest_dir).join(\"target/debug/libdriver.so\"),\n        std::path::PathBuf::from(manifest_dir).join(\"target/release/libdriver.so\"),\n    ];\n    for c in candidates.iter() {\n        if c.exists() {\n            return c.clone();\n        }\n    }\n    panic!(\"Rust libdriver.so not found in target/{{debug,release}}\");\n}\n\nfn call_driver(lib_path: &std::path::Path, x: c_int, y: c_int) -> Vec<u8> {\n    let lib = unsafe { Library::new(lib_path) }.expect(\"load lib\");\n    let driver: Symbol<unsafe extern \"C\" fn(c_int, c_int)> =\n        unsafe { lib.get(b\"driver\") }.expect(\"get driver\");\n    capture_stdout(|| unsafe {\n        driver(x, y);\n    })\n}\n\n#[test]\nfn driver_matches_c() {\n    let c_path = c_lib_path();\n    let rust_path = rust_lib_path();\n    assert!(c_path.exists(), \"C lib missing: {:?}\", c_path);\n    assert!(rust_path.exists(), \"Rust lib missing: {:?}\", rust_path);\n\n    // Sequential, single-threaded test cases. Avoid running in parallel because\n    // we manipulate the process-wide stdout fd.\n    let cases: &[(c_int, c_int)] = &[\n        (10, 3),\n        (-10, 3),\n        (10, -3),\n        (-10, -3),\n        (0, 1),\n        (1, 1),\n        (7, 2),\n        (100, 7),\n        (-100, 7),\n        (i32::MAX, 1),\n        (i32::MAX, 2),\n        (i32::MIN + 1, 2),\n        (5, 5),\n        (123456, 789),\n    ];\n\n    for &(x, y) in cases {\n        let c_out = call_driver(&c_path, x, y);\n        let r_out = call_driver(&rust_path, x, y);\n        assert_eq!(\n            c_out, r_out,\n            \"driver({}, {}) mismatch:\\n C: {:?}\\n R: {:?}\",\n            x, y, c_out, r_out\n        );\n    }\n}\n\n#[test]\nfn rust_lib_exports_driver() {\n    // Verify the symbol exists in the Rust .so by loading via libloading.\n    let lib = unsafe { Library::new(rust_lib_path()) }.expect(\"load rust lib\");\n    let _: Symbol<unsafe extern \"C\" fn(c_int, c_int)> =\n        unsafe { lib.get(b\"driver\") }.expect(\"driver symbol must be exported\");\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":214,"cache_read_input_tokens":18624,"cache_creation":{"ephemeral_5m_input_tokens":214,"ephemeral_1h_input_tokens":0},"output_tokens":32,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"2faf831e-120d-46f2-97f8-37f0a3709155","uuid":"0cc7a3c6-08ce-47ca-ab39-e7755e20c075"}
