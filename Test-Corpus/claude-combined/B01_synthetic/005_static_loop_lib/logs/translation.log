direct fd 1 to the temp file.\n    let tmp_fd = file_as_raw_fd(&tmp);\n    let rc = unsafe { libc::dup2(tmp_fd, 1) };\n    assert!(rc >= 0, \"dup2 failed\");\n\n    f();\n\n    // Flush the C stdio after the call so all printf output is in the file.\n    unsafe {\n        libc::fflush(std::ptr::null_mut());\n    }\n\n    // Restore the original stdout.\n    let rc = unsafe { libc::dup2(saved, 1) };\n    assert!(rc >= 0, \"dup2 restore failed\");\n    unsafe {\n        libc::close(saved);\n    }\n\n    // Read everything from the temp file.\n    tmp.seek(SeekFrom::Start(0)).unwrap();\n    let mut buf = Vec::new();\n    tmp.read_to_end(&mut buf).unwrap();\n    buf\n}\n\nfn tempfile_in_memory() -> std::fs::File {\n    // Use tmpfile via libc so the file is automatically removed.\n    let f = unsafe { libc::tmpfile() };\n    assert!(!f.is_null(), \"tmpfile failed\");\n    let fd = unsafe { libc::fileno(f) };\n    assert!(fd >= 0, \"fileno failed\");\n    // Duplicate so we can hand a Rust File ownership without closing the C FILE*.\n    let dup_fd = unsafe { libc::dup(fd) };\n    assert!(dup_fd >= 0, \"dup tmpfile failed\");\n    // Close the C FILE* (this closes its underlying fd).\n    unsafe {\n        libc::fclose(f);\n    }\n    use std::os::unix::io::FromRawFd;\n    unsafe { std::fs::File::from_raw_fd(dup_fd) }\n}\n\nfn file_as_raw_fd(f: &std::fs::File) -> std::os::unix::io::RawFd {\n    use std::os::unix::io::AsRawFd;\n    f.as_raw_fd()\n}\n\nextern crate libc;\n\n#[test]\nfn static_sum_matches_c() {\n    let _g = TEST_LOCK.lock().unwrap();\n    let c_lib = load(C_LIB);\n    let rust_lib = load(RUST_LIB);\n\n    let c_sum: Symbol<StaticSumFn> = unsafe { c_lib.get(b\"static_sum\").unwrap() };\n    let r_sum: Symbol<StaticSumFn> = unsafe { rust_lib.get(b\"static_sum\").unwrap() };\n\n    let inputs = [0, 1, 2, 3, 5, -1, -100, 1000, 0, 7, -3, 42, i32::MAX, i32::MIN, 1, 2];\n    let mut c_running = 0i64;\n    let mut r_running = 0i64;\n    for &v in &inputs {\n        let c_val = unsafe { c_sum(v) };\n        let r_val = unsafe { r_sum(v) };\n        assert_eq!(\n            c_val, r_val,\n            \"mismatch on input {v} (c_running prev={c_running}, r_running prev={r_running})\"\n        );\n        c_running = c_val as i64;\n        r_running = r_val as i64;\n    }\n}\n\n#[test]\nfn driver_output_matches_c() {\n    let c_lib = load(C_LIB);\n    let rust_lib = load(RUST_LIB);\n\n    // Each call uses fresh \"static\" state because we have not touched static_sum\n    // in either lib for this test (other tests run in separate processes by\n    // default with cargo's process-per-test approach? Actually cargo test runs\n    // tests in the same process by default with threads). To make this test\n    // self-contained, we will use stride values that we accept whatever the\n    // current static_sum state is; we just compare C and Rust under the SAME\n    // sequence of operations from a known-equal state.\n\n    // Re-seed both libs to a known equal state by computing what is needed to\n    // bring them to 0. We can get the current sum by calling static_sum(0).\n    let c_sum: Symbol<StaticSumFn> = unsafe { c_lib.get(b\"static_sum\").unwrap() };\n    let r_sum: Symbol<StaticSumFn> = unsafe { rust_lib.get(b\"static_sum\").unwrap() };\n    let c_state = unsafe { c_sum(0) };\n    let r_state = unsafe { r_sum(0) };\n    // Reset both to 0 by adding the negation.\n    unsafe {\n        c_sum(-c_state);\n        r_sum(-r_state);\n    }\n    // Sanity check\n    assert_eq!(unsafe { c_sum(0) }, 0);\n    assert_eq!(unsafe { r_sum(0) }, 0);\n\n    let strides = [0, 1, 2, -1, 5, -3, 100];\n    for &stride in &strides {\n        // Reset both to 0 again before each driver call.\n        let cs = unsafe { c_sum(0) };\n        let rs = unsafe { r_sum(0) };\n        unsafe {\n            c_sum(-cs);\n            r_sum(-rs);\n        }\n\n        let c_driver: Symbol<DriverFn> = unsafe { c_lib.get(b\"driver\").unwrap() };\n        let r_driver: Symbol<DriverFn> = unsafe { rust_lib.get(b\"driver\").unwrap() };\n\n        let c_out = capture_stdout(|| unsafe { c_driver(stride) });\n\n        // Reset Rust static_sum to 0 again before calling rust driver.\n        let rs2 = unsafe { r_sum(0) };\n        unsafe {\n            r_sum(-rs2);\n        }\n        let r_out = capture_stdout(|| unsafe { r_driver(stride) });\n\n        assert_eq!(\n            c_out, r_out,\n            \"driver output mismatch for stride={stride}\\nC:    {:?}\\nRust: {:?}\",\n            String::from_utf8_lossy(&c_out),\n            String::from_utf8_lossy(&r_out)\n        );\n    }\n}\n","structuredPatch":[{"oldStart":107,"oldLines":6,"newStart":107,"newLines":7,"lines":[" "," #[test]"," fn driver_output_matches_c() {","+    let _g = TEST_LOCK.lock().unwrap();","     let c_lib = load(C_LIB);","     let rust_lib = load(RUST_LIB);"," "]}],"userModified":false,"replaceAll":false}}
