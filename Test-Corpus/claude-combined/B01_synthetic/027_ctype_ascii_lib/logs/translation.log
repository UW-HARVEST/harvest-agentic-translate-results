{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_u5uq6rokpr5ayxjjyrz3gvm45fhlhvqzedv2vgie4sdhox4sfxja","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01CTNP45gAuQnPAZqM1fA8qm","name":"Write","input":{"file_path":"/tmp/harvest-translate-hqzbJF/translated_rust/tests/ffi_compare.rs","content":"// FFI integration test: load both libraries via libloading and compare\n// their stdout output for the same inputs.\n\nuse libloading::{Library, Symbol};\nuse std::os::raw::c_char;\nuse std::sync::Mutex;\n\ntype DriverFn = unsafe extern \"C\" fn(c_char);\n\nfn lib_paths() -> (&'static str, &'static str) {\n    (\"c_src/build/libdriver.so\", \"target/release/libdriver.so\")\n}\n\nextern \"C\" {\n    fn dup(oldfd: i32) -> i32;\n    fn dup2(oldfd: i32, newfd: i32) -> i32;\n    fn close(fd: i32) -> i32;\n    fn pipe(fds: *mut i32) -> i32;\n    fn read(fd: i32, buf: *mut u8, count: usize) -> isize;\n    fn fflush(stream: *mut libc::FILE) -> i32;\n}\n\nextern \"C\" {\n    static stdout: *mut libc::FILE;\n}\nunsafe fn libc_stdout() -> *mut libc::FILE {\n    stdout\n}\n\n// Process-wide stdout capture must be serialized.\nstatic CAPTURE_LOCK: Mutex<()> = Mutex::new(());\n\n/// Capture stdout produced by a closure. Uses pipe + dup2.\nfn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {\n    let _guard = CAPTURE_LOCK.lock().unwrap_or_else(|p| p.into_inner());\n    unsafe {\n        // Flush anything already in stdout buffer.\n        let s = libc_stdout();\n        if !s.is_null() {\n            fflush(s);\n        }\n\n        let stdout_fd: i32 = 1;\n        let saved = dup(stdout_fd);\n        assert!(saved >= 0, \"dup failed\");\n\n        let mut fds: [i32; 2] = [0; 2];\n        let r = pipe(fds.as_mut_ptr());\n        assert!(r == 0, \"pipe failed\");\n\n        // Make read end non-blocking so we can drain after restoring stdout.\n        // We'll set O_NONBLOCK after writing finishes.\n        let r = dup2(fds[1], stdout_fd);\n        assert!(r >= 0, \"dup2 failed\");\n        close(fds[1]);\n\n        f();\n\n        let s = libc_stdout();\n        if !s.is_null() {\n            fflush(s);\n        }\n\n        // Restore original stdout.\n        dup2(saved, stdout_fd);\n        close(saved);\n\n        // Now set the read end non-blocking and drain.\n        const F_GETFL: i32 = 3;\n        const F_SETFL: i32 = 4;\n        const O_NONBLOCK: i32 = 0o4000;\n        extern \"C\" {\n            fn fcntl(fd: i32, cmd: i32, ...) -> i32;\n        }\n        let flags = fcntl(fds[0], F_GETFL);\n        if flags >= 0 {\n            fcntl(fds[0], F_SETFL, flags | O_NONBLOCK);\n        }\n\n        let mut buf = Vec::new();\n        let mut tmp = [0u8; 4096];\n        loop {\n            let n = read(fds[0], tmp.as_mut_ptr(), tmp.len());\n            if n <= 0 {\n                break;\n            }\n            buf.extend_from_slice(&tmp[..n as usize]);\n        }\n        close(fds[0]);\n\n        buf\n    }\n}\n\nfn run_driver_via_lib(path: &str, c: c_char) -> Vec<u8> {\n    let lib = unsafe { Library::new(path).expect(\"load library\") };\n    let func: Symbol<DriverFn> = unsafe { lib.get(b\"driver\").expect(\"get driver\") };\n    capture_stdout(|| unsafe { func(c) })\n}\n\nfn run_for_byte(c: c_char) {\n    let (c_path, rust_path) = lib_paths();\n    let c_out = run_driver_via_lib(c_path, c);\n    let rust_out = run_driver_via_lib(rust_path, c);\n    assert_eq!(\n        c_out,\n        rust_out,\n        \"Mismatch for input byte {} (0x{:02x}).\\n--- C output ---\\n{}\\n--- Rust output ---\\n{}\\n\",\n        c as i32,\n        (c as u8) as i32,\n        String::from_utf8_lossy(&c_out),\n        String::from_utf8_lossy(&rust_out),\n    );\n}\n\n#[test]\nfn driver_matches_for_ascii_letters() {\n    for c in b'A'..=b'Z' {\n        run_for_byte(c as c_char);\n    }\n    for c in b'a'..=b'z' {\n        run_for_byte(c as c_char);\n    }\n}\n\n#[test]\nfn driver_matches_for_digits() {\n    for c in b'0'..=b'9' {\n        run_for_byte(c as c_char);\n    }\n}\n\n#[test]\nfn driver_matches_for_punctuation_and_whitespace() {\n    let chars: &[u8] = b\" \\t\\n\\r\\x0b\\x0c!\\\"#$%&'()*+,-./:;<=>?@[\\\\]^_`{|}~\";\n    for &c in chars {\n        run_for_byte(c as c_char);\n    }\n}\n\n#[test]\nfn driver_matches_for_control_chars() {\n    for c in 0u8..=31u8 {\n        run_for_byte(c as c_char);\n    }\n    run_for_byte(127u8 as c_char);\n}\n\n#[test]\nfn driver_matches_for_high_bytes() {\n    // Test full range of c_char (signed on most platforms).\n    for c in 0u8..=255u8 {\n        run_for_byte(c as c_char);\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1170,"cache_read_input_tokens":22849,"cache_creation":{"ephemeral_5m_input_tokens":1170,"ephemeral_1h_input_tokens":0},"output_tokens":30,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"24c30404-16a7-4a8f-ac4a-6fb15de66248","uuid":"4665fb33-d04f-4e75-80e6-7065ac12e6f8"}
