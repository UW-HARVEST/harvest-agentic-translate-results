{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_4vbg7mt33a4jm5n7a22nfzmmat7scyhcyx4uan47xdppyf6iwszq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01JQ6Rq7XVUs62axbvVeFd3D","name":"Write","input":{"file_path":"/tmp/harvest-translate-hqzbJF/translated_rust/tests/ffi_compare.rs","content":"// FFI integration test: load both libraries via libloading and compare\n// their stdout output for the same inputs.\n\nuse libloading::{Library, Symbol};\nuse std::ffi::CStr;\nuse std::os::raw::c_char;\n\ntype DriverFn = unsafe extern \"C\" fn(c_char);\n\nfn lib_paths() -> (&'static str, &'static str) {\n    (\"c_src/build/libdriver.so\", \"target/release/libdriver.so\")\n}\n\nextern \"C\" {\n    fn dup(oldfd: i32) -> i32;\n    fn dup2(oldfd: i32, newfd: i32) -> i32;\n    fn close(fd: i32) -> i32;\n    fn pipe(fds: *mut i32) -> i32;\n    fn read(fd: i32, buf: *mut u8, count: usize) -> isize;\n    fn fflush(stream: *mut libc::FILE) -> i32;\n    fn fileno(stream: *mut libc::FILE) -> i32;\n}\n\n/// Capture stdout produced by a closure. Uses pipe + dup2.\nfn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {\n    unsafe {\n        // Flush stdout first.\n        // We need access to libc stdout. libc crate exposes it.\n        let stdout_fd: i32 = 1;\n        // Save original stdout.\n        let saved = dup(stdout_fd);\n        assert!(saved >= 0, \"dup failed\");\n\n        // Create a pipe.\n        let mut fds: [i32; 2] = [0; 2];\n        let r = pipe(fds.as_mut_ptr());\n        assert!(r == 0, \"pipe failed\");\n\n        // Replace stdout with the write end of the pipe.\n        let r = dup2(fds[1], stdout_fd);\n        assert!(r >= 0, \"dup2 failed\");\n        close(fds[1]);\n\n        // Run the function.\n        f();\n\n        // Flush stdout to ensure everything is written to the pipe.\n        // Use the FILE* stdout if available; alternatively, write a newline.\n        // Use libc::fflush with libc::stdout()? libc crate exposes:\n        let stdout_file = libc_stdout();\n        if !stdout_file.is_null() {\n            fflush(stdout_file);\n        }\n\n        // Restore original stdout.\n        dup2(saved, stdout_fd);\n        close(saved);\n\n        // Read from the read end until EOF.\n        let mut buf = Vec::new();\n        let mut tmp = [0u8; 4096];\n        loop {\n            let n = read(fds[0], tmp.as_mut_ptr(), tmp.len());\n            if n <= 0 {\n                break;\n            }\n            buf.extend_from_slice(&tmp[..n as usize]);\n        }\n        close(fds[0]);\n\n        buf\n    }\n}\n\nextern \"C\" {\n    // libc stdout symbol\n    static stdout: *mut libc::FILE;\n}\nunsafe fn libc_stdout() -> *mut libc::FILE {\n    stdout\n}\n\nfn run_driver_via_lib(path: &str, c: c_char) -> Vec<u8> {\n    let lib = unsafe { Library::new(path).expect(\"load library\") };\n    let func: Symbol<DriverFn> = unsafe { lib.get(b\"driver\").expect(\"get driver\") };\n    capture_stdout(|| unsafe { func(c) })\n}\n\nfn run_for_byte(c: c_char) {\n    let (c_path, rust_path) = lib_paths();\n    let c_out = run_driver_via_lib(c_path, c);\n    let rust_out = run_driver_via_lib(rust_path, c);\n    assert_eq!(\n        c_out,\n        rust_out,\n        \"Mismatch for input byte {} (0x{:02x}).\\n--- C output ---\\n{}\\n--- Rust output ---\\n{}\\n\",\n        c as i32,\n        (c as u8) as i32,\n        String::from_utf8_lossy(&c_out),\n        String::from_utf8_lossy(&rust_out),\n    );\n}\n\n#[test]\nfn driver_matches_for_ascii_letters() {\n    for c in b'A'..=b'Z' {\n        run_for_byte(c as c_char);\n    }\n    for c in b'a'..=b'z' {\n        run_for_byte(c as c_char);\n    }\n}\n\n#[test]\nfn driver_matches_for_digits() {\n    for c in b'0'..=b'9' {\n        run_for_byte(c as c_char);\n    }\n}\n\n#[test]\nfn driver_matches_for_punctuation_and_whitespace() {\n    let chars: &[u8] = b\" \\t\\n\\r\\x0b\\x0c!\\\"#$%&'()*+,-./:;<=>?@[\\\\]^_`{|}~\";\n    for &c in chars {\n        run_for_byte(c as c_char);\n    }\n}\n\n#[test]\nfn driver_matches_for_control_chars() {\n    for c in 0u8..=31u8 {\n        run_for_byte(c as c_char);\n    }\n    run_for_byte(127u8 as c_char);\n}\n\n#[test]\nfn driver_matches_for_high_bytes() {\n    // Test full range of c_char (signed on most platforms).\n    for c in 0u8..=255u8 {\n        run_for_byte(c as c_char);\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":282,"cache_read_input_tokens":20583,"cache_creation":{"ephemeral_5m_input_tokens":282,"ephemeral_1h_input_tokens":0},"output_tokens":31,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"24c30404-16a7-4a8f-ac4a-6fb15de66248","uuid":"97bdfd27-75d9-480d-b636-25ec539afc81"}
