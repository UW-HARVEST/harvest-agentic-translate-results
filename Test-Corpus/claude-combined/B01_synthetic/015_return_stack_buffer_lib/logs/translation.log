ed library, capturing whatever it\n/// writes to stdout (FD 1) into a Vec<u8> via a pipe + secondary process.\n///\n/// Implementation detail: the simplest way to capture stdout of a dynamically\n/// loaded library without polluting cargo's harness output is to spawn a\n/// helper subprocess (this same test binary, re-invoked with a special arg)\n/// that loads the library and runs the requested operation, writing the\n/// library's stdout to its own stdout, which we capture.\nfn run_in_child(lib: &Path, op: &str, arg: &str) -> Vec<u8> {\n    let exe = std::env::current_exe().expect(\"current_exe\");\n    let out = Command::new(exe)\n        .env(\"FFI_DRIVER_HELPER\", \"1\")\n        .env(\"FFI_DRIVER_LIB\", lib)\n        .env(\"FFI_DRIVER_OP\", op)\n        .env(\"FFI_DRIVER_ARG\", arg)\n        .stdout(Stdio::piped())\n        .stderr(Stdio::inherit())\n        .spawn()\n        .expect(\"spawn helper\")\n        .wait_with_output()\n        .expect(\"wait helper\");\n    out.stdout\n}\n\n/// When the test binary is invoked with `FFI_DRIVER_HELPER=1`, run the\n/// requested operation against the shared library and exit. We use a `ctor`-\n/// style approach with a regular check at process startup using a\n/// `#[ctor]`-free pattern: just check at the start of `main`. Cargo's libtest\n/// runs `main` per binary, so we check via a custom `pre_main` invoked from a\n/// `#[used]` `extern \"C\"` constructor.\n///\n/// We don't have ctor crate available, so instead we use the `linkme` /\n/// constructor approach via `__attribute__((constructor))` on Linux. Since\n/// adding crates is overkill, we instead piggy-back on a test that runs first\n/// and bail out, OR — simpler — we check at the beginning of every test.\nfn helper_dispatch_if_requested() {\n    if std::env::var_os(\"FFI_DRIVER_HELPER\").is_none() {\n        return;\n    }\n    let lib_path = std::env::var(\"FFI_DRIVER_LIB\").expect(\"FFI_DRIVER_LIB\");\n    let op = std::env::var(\"FFI_DRIVER_OP\").expect(\"FFI_DRIVER_OP\");\n    let arg = std::env::var(\"FFI_DRIVER_ARG\").unwrap_or_default();\n\n    unsafe {\n        let lib = libloading::Library::new(&lib_path).expect(\"load library\");\n        match op.as_str() {\n            \"good\" => {\n                let f: libloading::Symbol<FnVoid> = lib.get(b\"good\").expect(\"good\");\n                f();\n            }\n            \"bad\" => {\n                let f: libloading::Symbol<FnVoid> = lib.get(b\"bad\").expect(\"bad\");\n                f();\n            }\n            \"driver\" => {\n                let f: libloading::Symbol<FnInt> = lib.get(b\"driver\").expect(\"driver\");\n                let v: c_int = arg.parse().expect(\"parse driver arg\");\n                f(v);\n            }\n            \"printLine_null\" => {\n                let f: libloading::Symbol<FnCharPtr> =\n                    lib.get(b\"printLine\").expect(\"printLine\");\n                f(std::ptr::null());\n            }\n            \"printLine\" => {\n                let f: libloading::Symbol<FnCharPtr> =\n                    lib.get(b\"printLine\").expect(\"printLine\");\n                let cs = CString::new(arg).expect(\"CString\");\n                f(cs.as_ptr());\n            }\n            other => panic!(\"unknown op {}\", other),\n        }\n        // Flush stdout (which both the C and Rust libs share with us) so the\n        // captured pipe sees all output before we exit.\n        extern \"C\" {\n            fn fflush(stream: *mut std::ffi::c_void) -> c_int;\n        }\n        let _ = fflush(std::ptr::null_mut());\n    }\n    std::process::exit(0);\n}\n\nfn compare(op: &str, arg: &str) {\n    let c_out = run_in_child(&c_lib_path(), op, arg);\n    let r_out = run_in_child(&rust_lib_path(), op, arg);\n    assert_eq!(\n        c_out, r_out,\n        \"byte mismatch for op={} arg={}\\n  C   ={:?}\\n  Rust={:?}\",\n        op, arg, c_out, r_out\n    );\n}\n\n// All tests start by checking if we're the helper child. If so, disp