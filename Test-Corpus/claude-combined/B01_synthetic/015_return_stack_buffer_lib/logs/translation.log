{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_7ohjpdf72jb3n7kwaxevpfef3o6jswck7vvxsvsddgtjfnvfosma","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01JrDXMXxpZeeiSNGyNyQCnw","name":"Write","input":{"file_path":"/tmp/harvest-translate-8qnssn/translated_rust/tests/ffi_compat.rs","content":"//! FFI integration tests that load both the C `libdriver.so` and the Rust\n//! `libdriver.so` via `libloading` and compare their behavior byte-for-byte.\n//!\n//! Each test forks a child process so we can capture the real `stdout` of\n//! whichever shared library we're testing without interfering with the\n//! parent's stdout (which `cargo test` uses).\n\nuse std::ffi::CString;\nuse std::io::Read;\nuse std::os::raw::{c_char, c_int};\nuse std::path::{Path, PathBuf};\nuse std::process::{Command, Stdio};\n\ntype FnVoid = unsafe extern \"C\" fn();\ntype FnInt = unsafe extern \"C\" fn(c_int);\ntype FnCharPtr = unsafe extern \"C\" fn(*const c_char);\n\nfn c_lib_path() -> PathBuf {\n    let manifest = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    manifest.join(\"c_src\").join(\"build\").join(\"libdriver.so\")\n}\n\nfn rust_lib_path() -> PathBuf {\n    let manifest = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    let release = manifest.join(\"target\").join(\"release\").join(\"libdriver.so\");\n    if release.exists() {\n        return release;\n    }\n    manifest.join(\"target\").join(\"debug\").join(\"libdriver.so\")\n}\n\n/// Run a closure with a freshly-loaded shared library, capturing whatever it\n/// writes to stdout (FD 1) into a Vec<u8> via a pipe + secondary process.\n///\n/// Implementation detail: the simplest way to capture stdout of a dynamically\n/// loaded library without polluting cargo's harness output is to spawn a\n/// helper subprocess (this same test binary, re-invoked with a special arg)\n/// that loads the library and runs the requested operation, writing the\n/// library's stdout to its own stdout, which we capture.\nfn run_in_child(lib: &Path, op: &str, arg: &str) -> Vec<u8> {\n    let exe = std::env::current_exe().expect(\"current_exe\");\n    let out = Command::new(exe)\n        .env(\"FFI_DRIVER_HELPER\", \"1\")\n        .env(\"FFI_DRIVER_LIB\", lib)\n        .env(\"FFI_DRIVER_OP\", op)\n        .env(\"FFI_DRIVER_ARG\", arg)\n        .stdout(Stdio::piped())\n        .stderr(Stdio::inherit())\n        .spawn()\n        .expect(\"spawn helper\")\n        .wait_with_output()\n        .expect(\"wait helper\");\n    out.stdout\n}\n\n/// When the test binary is invoked with `FFI_DRIVER_HELPER=1`, run the\n/// requested operation against the shared library and exit. We use a `ctor`-\n/// style approach with a regular check at process startup using a\n/// `#[ctor]`-free pattern: just check at the start of `main`. Cargo's libtest\n/// runs `main` per binary, so we check via a custom `pre_main` invoked from a\n/// `#[used]` `extern \"C\"` constructor.\n///\n/// We don't have ctor crate available, so instead we use the `linkme` /\n/// constructor approach via `__attribute__((constructor))` on Linux. Since\n/// adding crates is overkill, we instead piggy-back on a test that runs first\n/// and bail out, OR — simpler — we check at the beginning of every test.\nfn helper_dispatch_if_requested() {\n    if std::env::var_os(\"FFI_DRIVER_HELPER\").is_none() {\n        return;\n    }\n    let lib_path = std::env::var(\"FFI_DRIVER_LIB\").expect(\"FFI_DRIVER_LIB\");\n    let op = std::env::var(\"FFI_DRIVER_OP\").expect(\"FFI_DRIVER_OP\");\n    let arg = std::env::var(\"FFI_DRIVER_ARG\").unwrap_or_default();\n\n    unsafe {\n        let lib = libloading::Library::new(&lib_path).expect(\"load library\");\n        match op.as_str() {\n            \"good\" => {\n                let f: libloading::Symbol<FnVoid> = lib.get(b\"good\").expect(\"good\");\n                f();\n            }\n            \"bad\" => {\n                let f: libloading::Symbol<FnVoid> = lib.get(b\"bad\").expect(\"bad\");\n                f();\n            }\n            \"driver\" => {\n                let f: libloading::Symbol<FnInt> = lib.get(b\"driver\").expect(\"driver\");\n                let v: c_int = arg.parse().expect(\"parse driver arg\");\n                f(v);\n            }\n            \"printLine_null\" => {\n                let f: libloading::Symbol<FnCharPtr> =\n                    lib.get(b\"printLine\").expect(\"printLine\");\n                f(std::ptr::null());\n            }\n            \"printLine\" => {\n                let f: libloading::Symbol<FnCharPtr> =\n                    lib.get(b\"printLine\").expect(\"printLine\");\n                let cs = CString::new(arg).expect(\"CString\");\n                f(cs.as_ptr());\n            }\n            other => panic!(\"unknown op {}\", other),\n        }\n        // Flush stdout from inside the loaded library by calling fflush.\n        let fflush: libloading::Symbol<unsafe extern \"C\" fn(*mut std::ffi::c_void) -> c_int> =\n            lib.get(b\"fflush\").unwrap_or_else(|_| {\n                // libc isn't necessarily linked through `lib`. Try the global\n                // namespace via dlsym(NULL, ...).\n                panic!(\"fflush not found in lib\");\n            });\n        let _ = fflush(std::ptr::null_mut());\n    }\n    std::process::exit(0);\n}\n\nfn compare(op: &str, arg: &str) {\n    let c_out = run_in_child(&c_lib_path(), op, arg);\n    let r_out = run_in_child(&rust_lib_path(), op, arg);\n    assert_eq!(\n        c_out, r_out,\n        \"byte mismatch for op={} arg={}\\n  C   ={:?}\\n  Rust={:?}\",\n        op, arg, c_out, r_out\n    );\n}\n\n// All tests start by checking if we're the helper child. If so, dispatch and\n// exit before any test logic runs.\nfn ensure_libs_built() {\n    helper_dispatch_if_requested();\n    let c = c_lib_path();\n    let r = rust_lib_path();\n    assert!(c.exists(), \"C library not built at {:?}\", c);\n    assert!(r.exists(), \"Rust library not built at {:?}\", r);\n}\n\n#[test]\nfn test_good() {\n    ensure_libs_built();\n    compare(\"good\", \"\");\n}\n\n#[test]\nfn test_bad() {\n    ensure_libs_built();\n    compare(\"bad\", \"\");\n}\n\n#[test]\nfn test_driver_zero() {\n    ensure_libs_built();\n    compare(\"driver\", \"0\");\n}\n\n#[test]\nfn test_driver_one() {\n    ensure_libs_built();\n    compare(\"driver\", \"1\");\n}\n\n#[test]\nfn test_driver_negative() {\n    ensure_libs_built();\n    compare(\"driver\", \"-5\");\n}\n\n#[test]\nfn test_driver_large() {\n    ensure_libs_built();\n    compare(\"driver\", \"12345\");\n}\n\n#[test]\nfn test_printline_null() {\n    ensure_libs_built();\n    compare(\"printLine_null\", \"\");\n}\n\n#[test]\nfn test_printline_hello() {\n    ensure_libs_built();\n    compare(\"printLine\", \"hello\");\n}\n\n#[test]\nfn test_printline_empty() {\n    ensure_libs_built();\n    compare(\"printLine\", \"\");\n}\n\n#[test]\nfn test_printline_unicode_bytes() {\n    ensure_libs_built();\n    // %s prints raw bytes through to stdout; both libs should match.\n    compare(\"printLine\", \"héllo wörld 🌍\");\n}\n\n#[test]\nfn test_printline_long() {\n    ensure_libs_built();\n    let s = \"abcdefghijklmnopqrstuvwxyz\".repeat(50);\n    compare(\"printLine\", &s);\n}\n\n#[test]\nfn test_symbol_set_matches() {\n    ensure_libs_built();\n    // Sanity check: every public symbol in the C lib must also exist in the\n    // Rust lib, with a matching name.\n    unsafe {\n        let c_lib = libloading::Library::new(c_lib_path()).expect(\"load C lib\");\n        let r_lib = libloading::Library::new(rust_lib_path()).expect(\"load Rust lib\");\n        for name in &[b\"bad\" as &[u8], b\"good\", b\"driver\", b\"printLine\"] {\n            let _: libloading::Symbol<*const ()> = c_lib\n                .get(name)\n                .unwrap_or_else(|_| panic!(\"C lib missing {:?}\", std::str::from_utf8(name)));\n            let _: libloading::Symbol<*const ()> = r_lib\n                .get(name)\n                .unwrap_or_else(|_| panic!(\"Rust lib missing {:?}\", std::str::from_utf8(name)));\n        }\n    }\n}\n\n// ----- helper child entry point -----\n//\n// Cargo's libtest creates its own `main`, so we can't override it. Instead we\n// rely on `helper_dispatch_if_requested()` being called from each test before\n// any normal test work. This is invoked through `ensure_libs_built()`, but\n// also via a constructor-like mechanism: when the helper env var is set, we\n// want to bypass libtest entirely. We accomplish that with a `#[ctor]`-style\n// initializer using a `link_section` constructor.\n\n#[used]\n#[cfg_attr(target_os = \"linux\", link_section = \".init_array\")]\nstatic HELPER_CTOR: extern \"C\" fn() = helper_ctor;\n\nextern \"C\" fn helper_ctor() {\n    if std::env::var_os(\"FFI_DRIVER_HELPER\").is_some() {\n        helper_dispatch_if_requested();\n    }\n}\n\n// Allow `Read` import to remain useful in case helpers expand later.\n#[allow(dead_code)]\nfn _silence_read_import(mut r: impl Read) -> std::io::Result<Vec<u8>> {\n    let mut v = Vec::new();\n    r.read_to_end(&mut v)?;\n    Ok(v)\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":541,"cache_read_input_tokens":27918,"cache_creation":{"ephemeral_5m_input_tokens":541,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"742f4da3-7d93-4301-a871-309d9ca4b855","uuid":"45d0270f-1c4f-4f6a-add6-a5d46a4be131"}
