puts differ for ({}, {}, {})\\nC:    {:?}\\nRust: {:?}\",\n        x,\n        y,\n        z,\n        String::from_utf8_lossy(&c_out),\n        String::from_utf8_lossy(&rust_out)\n    );\n}\n\n#[test]\nfn test_x_not_one() {\n    run_case(0, 2, 3);\n}\n\n#[test]\nfn test_x_not_one_negative() {\n    run_case(-5, 2, 3);\n}\n\n#[test]\nfn test_y_not_two() {\n    run_case(1, 0, 3);\n}\n\n#[test]\nfn test_y_not_two_other() {\n    run_case(1, 99, 3);\n}\n\n#[test]\nfn test_z_not_three() {\n    run_case(1, 2, 0);\n}\n\n#[test]\nfn test_z_not_three_other() {\n    run_case(1, 2, 100);\n}\n\n#[test]\nfn test_all_ok() {\n    run_case(1, 2, 3);\n}\n\n#[test]\nfn test_all_zero() {\n    run_case(0, 0, 0);\n}\n\n#[test]\nfn test_negatives() {\n    run_case(-1, -2, -3);\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":208,"cache_read_input_tokens":22792,"cache_creation":{"ephemeral_5m_input_tokens":208,"ephemeral_1h_input_tokens":0},"output_tokens":29,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"e1190ae4-e093-41ea-9605-82632c687c30","uuid":"b0ccca33-5bd3-48ac-a72d-c79799d63ec9"}
