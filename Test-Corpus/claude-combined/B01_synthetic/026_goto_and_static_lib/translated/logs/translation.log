\n        f();\n\n        fflush(stdout);\n\n        // Restore stdout to /dev/null so subsequent operations don't write to the temp file.\n        let _ = freopen(c_dev_tty_or_null.as_ptr(), c_w.as_ptr(), stdout);\n    }\n\n    let mut buf = Vec::new();\n    let mut f = fs::File::open(&tmp).expect(\"open temp capture\");\n    f.read_to_end(&mut buf).expect(\"read temp capture\");\n    let _ = fs::remove_file(&tmp);\n    buf\n}\n\nfn rand_u64() -> u64 {\n    use std::time::{SystemTime, UNIX_EPOCH};\n    let nanos = SystemTime::now()\n        .duration_since(UNIX_EPOCH)\n        .unwrap()\n        .as_nanos() as u64;\n    nanos ^ (std::ptr::addr_of!(nanos) as u64)\n}\n\ntype DriverFn = unsafe extern \"C\" fn(c_int, c_int, c_int);\n\nfn run_case(x: c_int, y: c_int, z: c_int) {\n    let _guard = FFI_LOCK.lock().unwrap();\n\n    let c_lib = unsafe { Library::new(c_lib_path()) }.expect(\"load C lib\");\n    let rust_lib = unsafe { Library::new(rust_lib_path()) }.expect(\"load Rust lib\");\n\n    let c_driver: Symbol<DriverFn> = unsafe { c_lib.get(b\"driver\\0\") }.expect(\"C driver\");\n    let rust_driver: Symbol<DriverFn> = unsafe { rust_lib.get(b\"driver\\0\") }.expect(\"Rust driver\");\n\n    let c_out = capture_stdout(\"c\", || unsafe { c_driver(x, y, z) });\n    let rust_out = capture_stdout(\"rust\", || unsafe { rust_driver(x, y, z) });\n\n    assert_eq!(\n        c_out,\n        rust_out,\n        \"outputs differ for ({}, {}, {})\\nC:    {:?}\\nRust: {:?}\",\n        x,\n        y,\n        z,\n        String::from_utf8_lossy(&c_out),\n        String::from_utf8_lossy(&rust_out)\n    );\n}\n\n#[test]\nfn test_x_not_one() {\n    run_case(0, 2, 3);\n}\n\n#[test]\nfn test_x_not_one_negative() {\n    run_case(-5, 2, 3);\n}\n\n#[test]\nfn test_y_not_two() {\n    run_case(1, 0, 3);\n}\n\n#[test]\nfn test_y_not_two_other() {\n    run_case(1, 99, 3);\n}\n\n#[test]\nfn test_z_not_three() {\n    run_case(1, 2, 0);\n}\n\n#[test]\nfn test_z_not_three_other() {\n    run_case(1, 2, 100);\n}\n\n#[test]\nfn test_all_ok() {\n    run_case(1, 2, 3);\n}\n\n#[test]\nfn test_all_zero() {\n    run_case(0, 0, 0);\n}\n\n#[test]\nfn test_negatives() {\n    run_case(-1, -2, -3);\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":160,"cache_read_input_tokens":19503,"cache_creation":{"ephemeral_5m_input_tokens":160,"ephemeral_1h_input_tokens":0},"output_tokens":32,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"e1190ae4-e093-41ea-9605-82632c687c30","uuid":"da5452dc-7d2d-42e0-bd6d-3e58b1cda2d1"}
