l missing\");"," ","-        // Extract raw fn pointers — we can't keep `Symbol` borrows past the","-        // `Library` move into the struct, but the function pointers remain","-        // valid as long as the libraries stay loaded.","         let c_slice: SliceFn = *c_sym;","         let rust_slice: SliceFn = *rust_sym;"," "]},{"oldStart":144,"oldLines":8,"newStart":135,"newLines":6,"lines":[" /// Run `slice` from both libraries against the same inputs, then assert the"," /// return value AND the captured stdout match byte-for-byte."," fn compare(label: &str, libs: &Libs, input: &str, start: Option<i32>, stop: Option<i32>) {","-    // Each call gets its own owned mutable string buffer because the C","-    // signature takes `char *` (non-const).","     let mut s_c = CString::new(input).unwrap().into_bytes_with_nul();","     let mut s_r = CString::new(input).unwrap().into_bytes_with_nul();","     let mut start_c = start;"]},{"oldStart":179,"oldLines":7,"newStart":168,"newLines":9,"lines":[" ","     assert_eq!(","         c_rv, r_rv,","-        \"[{label}] return values differ: C={c_rv} Rust={r_rv}\"","+        \"[{label}] return values differ: C={c_rv} Rust={r_rv}\\n  C stdout={:?}\\n  Rust stdout={:?}\",","+        String::from_utf8_lossy(&c_out),","+        String::from_utf8_lossy(&r_out),","     );","     assert_eq!(","         c_out, r_out,"]},{"oldStart":227,"oldLines":7,"newStart":218,"newLines":6,"lines":[" #[test]"," fn slice_start_off_end() {","     let libs = load_libs();","-    // start > len => \"start is off the end\" error","     compare(\"start-too-big\", &libs, \"abc\", Some(4), None);","     compare(\"start-way-off\", &libs, \"abc\", Some(100), None);"," }"]},{"oldStart":235,"oldLines":10,"newStart":225,"newLines":6,"lines":[" #[test]"," fn slice_start_equals_len_no_stop() {","     let libs = load_libs();","-    // start == len is allowed (NOT > len). With no stop, stop=len, the","-    // printed slice is empty (precision == 0). Note: this can't be tested","-    // when start_ptr is provided alongside no stop_ptr because the C code","-    // doesn't enforce stop > start in that branch.","     compare(\"start-eq-len\", &libs, \"abc\", Some(3), None);"," }"," "]},{"oldStart":259,"oldLines":9,"newStart":245,"newLines":9,"lines":[" #[test]"," fn slice_negative_start() {","     let libs = load_libs();","-    // C compares `start` (int) with `len` (size_t). The integer promotion","-    // rules turn negative `start` into a huge unsigned value, so it should","-    // hit the \"start is off the end\" branch.","+    // C compares `start` (int) with `len` (size_t). Integer promotion turns","+    // a negative `start` into a huge unsigned value — should hit the","+    // \"start is off the end\" branch.","     compare(\"neg-start\", &libs, \"abcdef\", Some(-1), None);","     compare(\"neg-start-w-stop\", &libs, \"abcdef\", Some(-1), Some(3));"," }"]},{"oldStart":269,"oldLines":7,"newStart":255,"newLines":6,"lines":[" #[test]"," fn slice_negative_stop() {","     let libs = load_libs();","-    // Same as above for `stop`.","     compare(\"neg-stop\", &libs, \"abcdef\", None, Some(-1));","     compare(\"neg-stop-w-start\", &libs, \"abcdef\", Some(0), Some(-1));"," }"]}],"originalFile":"// Compares the C (`c_src/build/libString_Slice.so`) implementation of\n// `slice()` against our Rust (`target/release/libString_Slice.so`)\n// re-implementation. We load both libraries through `libloading` and call\n// the exported `slice` symbol exactly as an external caller would, then\n// compare both the return value and the captured stdout output\n// byte-for-byte.\n\nuse libloading::{Library, Symbol};\nuse std::ffi::{c_char, c_int, CString};\nuse std::fs::File;\nuse std::io::Read;\nuse std::os::unix::io::AsRawFd;\nuse std::path::PathBuf;\n\ntype SliceFn = unsafe extern \"C\" fn(*mut c_char, *mut c_int, *mut c_int) -> c_int;\n\nfn c_lib_path() -> PathBuf {\n    let mut p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    p.push(\"c_src\");\n    p.push(\"build\");\n    p.push(\"libString_Slice.so\");\n    p\n}\n\nfn rust_lib_path() -> PathBuf {\n    // We force `cargo test` to also build the cdylib by depending on it via\n    // build artifacts in target/<profile>/. Since dev-tests run in the debug\n    // profile by default, also check there.\n    let mut p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    p.push(\"target\");\n    // Prefer release (built explicitly during the harness) but fall back to\n    // debug if a `cargo test` invocation only produced a debug cdylib.\n    let release = {\n        let mut q = p.clone();\n        q.push(\"release\");\n        q.push(\"libString_Slice.so\");\n        q\n    };\n    if release.exists() {\n        return release;\n    }\n    p.push(\"debug\");\n    p.push(\"libString_Slice.so\");\n    p\n}\n\n/// Capture stdout while calling `f`. Returns (return_value, captured_bytes).\n///\n/// We dup the real stdout fd, replace fd 1 with a pipe's write end, run the\n/// closure (which calls into FFI that writes via libc `printf`), then flush,\n/// restore fd 1, and read everything from the pipe's read end.\nfn capture_stdout<F: FnOnce() -> c_int>(f: F) -> (c_int, Vec<u8>) {\n    use std::io::Write;\n\n    // Make sure Rust's own stdout buffer is empty before we redirect — this\n    // way nothing of ours leaks into the captured output.\n    std::io::stdout().flush().ok();\n\n    unsafe {\n        // Flush libc's stdout so any prior buffered data lands on the real\n        // terminal, not in our capture buffer.\n        libc::fflush(std::ptr::null_mut());\n\n        let mut fds: [c_int; 2] = [0, 0];\n        assert_eq!(libc::pipe(fds.as_mut_ptr()), 0, \"pipe() failed\");\n        let (read_fd, write_fd) = (fds[0], fds[1]);\n\n        let saved_stdout = libc::dup(1);\n        assert!(saved_stdout >= 0, \"dup(1) failed\");\n\n        assert!(libc::dup2(write_fd, 1) >= 0, \"dup2(write_fd, 1) failed\");\n        libc::close(write_fd);\n\n        let rv = f();\n\n        // Flush libc's stdout buffer so all printf output is in the pipe.\n        libc::fflush(std::ptr::null_mut());\n\n        // Restore real stdout and close the saved fd.\n        assert!(libc::dup2(saved_stdout, 1) >= 0, \"dup2 restore failed\");\n        libc::close(saved_stdout);\n\n        // Read everything available on the pipe.\n        let mut file = File::from_raw_fd_owned(read_fd);\n        let mut buf = Vec::new();\n        file.read_to_end(&mut buf).expect(\"read from pipe failed\");\n        (rv, buf)\n    }\n}\n\n// File::from_raw_fd is unsafe and consumes ownership; wrap it for clarity.\ntrait FromRawFdOwned {\n    unsafe fn from_raw_fd_owned(fd: c_int) -> Self;\n}\nimpl FromRawFdOwned for File {\n    unsafe fn from_raw_fd_owned(fd: c_int) -> Self {\n        use std::os::unix::io::FromRawFd;\n        unsafe { File::from_raw_fd(fd) }\n    }\n}\n\n#[allow(unused_imports)]\nuse std::os::fd::AsFd;\n#[allow(unused_imports)]\nuse std::os::unix::io::FromRawFd;\n\n// Suppress dead_code warning for AsRawFd import on some toolchains.\n#[allow(dead_code)]\nfn _unused_asrawfd_anchor(f: &File) -> c_int {\n    f.as_raw_fd()\n}\n\nstruct Libs {\n    _c_lib: Library,\n    _rust_lib: Library,\n    c_slice: SliceFn,\n    rust_slice: SliceFn,\n}\n\nfn load_libs() -> Libs {\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).expect(\"failed to load C .so\");\n        let rust_lib = Library::new(rust_lib_path()).expect(\"failed to load Rust .so\");\n\n        let c_sym: Symbol<SliceFn> = c_lib.get(b\"slice\\0\").expect(\"C: slice symbol missing\");\n        let rust_sym: Symbol<SliceFn> =\n            rust_lib.get(b\"slice\\0\").expect(\"Rust: slice symbol missing\");\n\n        // Extract raw fn pointers — we can't keep `Symbol` borrows past the\n        // `Library` move into the struct, but the function pointers remain\n        // valid as long as the libraries stay loaded.\n        let c_slice: SliceFn = *c_sym;\n        let rust_slice: SliceFn = *rust_sym;\n\n        Libs {\n            _c_lib: c_lib,\n            _rust_lib: rust_lib,\n            c_slice,\n            rust_slice,\n        }\n    }\n}\n\n/// Run `slice` from both libraries against the same inputs, then assert the\n/// return value AND the captured stdout match byte-for-byte.\nfn compare(label: &str, libs: &Libs, input: &str, start: Option<i32>, stop: Option<i32>) {\n    // Each call gets its own owned mutable string buffer because the C\n    // signature takes `char *` (non-const).\n    let mut s_c = CString::new(input).unwrap().into_bytes_with_nul();\n    let mut s_r = CString::new(input).unwrap().into_bytes_with_nul();\n    let mut start_c = start;\n    let mut start_r = start;\n    let mut stop_c = stop;\n    let mut stop_r = stop;\n\n    let start_c_ptr: *mut c_int = start_c\n        .as_mut()\n        .map(|v| v as *mut i32 as *mut c_int)\n        .unwrap_or(std::ptr::null_mut());\n    let start_r_ptr: *mut c_int = start_r\n        .as_mut()\n        .map(|v| v as *mut i32 as *mut c_int)\n        .unwrap_or(std::ptr::null_mut());\n    let stop_c_ptr: *mut c_int = stop_c\n        .as_mut()\n        .map(|v| v as *mut i32 as *mut c_int)\n        .unwrap_or(std::ptr::null_mut());\n    let stop_r_ptr: *mut c_int = stop_r\n        .as_mut()\n        .map(|v| v as *mut i32 as *mut c_int)\n        .unwrap_or(std::ptr::null_mut());\n\n    let (c_rv, c_out) = capture_stdout(|| unsafe {\n        (libs.c_slice)(s_c.as_mut_ptr() as *mut c_char, start_c_ptr, stop_c_ptr)\n    });\n    let (r_rv, r_out) = capture_stdout(|| unsafe {\n        (libs.rust_slice)(s_r.as_mut_ptr() as *mut c_char, start_r_ptr, stop_r_ptr)\n    });\n\n    assert_eq!(\n        c_rv, r_rv,\n        \"[{label}] return values differ: C={c_rv} Rust={r_rv}\"\n    );\n    assert_eq!(\n        c_out, r_out,\n        \"[{label}] stdout bytes differ:\\n  C   = {:?}\\n  Rust= {:?}\",\n        String::from_utf8_lossy(&c_out),\n        String::from_utf8_lossy(&r_out),\n    );\n}\n\n#[test]\nfn slice_full_string_no_indices() {\n    let libs = load_libs();\n    compare(\"full/no-indices\", &libs, \"hello world\", None, None);\n}\n\n#[test]\nfn slice_with_start_only() {\n    let libs = load_libs();\n    compare(\"start-only\", &libs, \"hello world\", Some(6), None);\n    compare(\"start-zero\", &libs, \"hello world\", Some(0), None);\n    compare(\"start-mid\", &libs, \"abcdef\", Some(2), None);\n}\n\n#[test]\nfn slice_with_stop_only() {\n    let libs = load_libs();\n    compare(\"stop-only\", &libs, \"hello world\", None, Some(5));\n    compare(\"stop-equals-len\", &libs, \"abcdef\", None, Some(6));\n}\n\n#[test]\nfn slice_with_both_indices() {\n    let libs = load_libs();\n    compare(\"both\", &libs, \"hello world\", Some(0), Some(5));\n    compare(\"both-mid\", &libs, \"hello world\", Some(6), Some(11));\n    compare(\"both-1char\", &libs, \"abcdef\", Some(2), Some(3));\n}\n\n#[test]\nfn slice_empty_string_no_indices() {\n    let libs = load_libs();\n    compare(\"empty/no-indices\", &libs, \"\", None, None);\n}\n\n#[test]\nfn slice_start_off_end() {\n    let libs = load_libs();\n    // start > len => \"start is off the end\" error\n    compare(\"start-too-big\", &libs, \"abc\", Some(4), None);\n    compare(\"start-way-off\", &libs, \"abc\", Some(100), None);\n}\n\n#[test]\nfn slice_start_equals_len_no_stop() {\n    let libs = load_libs();\n    // start == len is allowed (NOT > len). With no stop, stop=len, the\n    // printed slice is empty (precision == 0). Note: this can't be tested\n    // when start_ptr is provided alongside no stop_ptr because the C code\n    // doesn't enforce stop > start in that branch.\n    compare(\"start-eq-len\", &libs, \"abc\", Some(3), None);\n}\n\n#[test]\nfn slice_stop_off_end() {\n    let libs = load_libs();\n    compare(\"stop-too-big\", &libs, \"abc\", None, Some(4));\n    compare(\"stop-too-big-with-start\", &libs, \"abc\", Some(0), Some(10));\n}\n\n#[test]\nfn slice_stop_le_start() {\n    let libs = load_libs();\n    compare(\"stop-eq-start\", &libs, \"abcdef\", Some(2), Some(2));\n    compare(\"stop-lt-start\", &libs, \"abcdef\", Some(4), Some(2));\n}\n\n#[test]\nfn slice_negative_start() {\n    let libs = load_libs();\n    // C compares `start` (int) with `len` (size_t). The integer promotion\n    // rules turn negative `start` into a huge unsigned value, so it should\n    // hit the \"start is off the end\" branch.\n    compare(\"neg-start\", &libs, \"abcdef\", Some(-1), None);\n    compare(\"neg-start-w-stop\", &libs, \"abcdef\", Some(-1), Some(3));\n}\n\n#[test]\nfn slice_negative_stop() {\n    let libs = load_libs();\n    // Same as above for `stop`.\n    compare(\"neg-stop\", &libs, \"abcdef\", None, Some(-1));\n    compare(\"neg-stop-w-start\", &libs, \"abcdef\", Some(0), Some(-1));\n}\n\n#[test]\nfn slice_long_string() {\n    let libs = load_libs();\n    let input: String = (0..256u32).map(|i| (b'a' + (i % 26) as u8) as char).collect();\n    compare(\"long/full\", &libs, &input, None, None);\n    compare(\"long/mid\", &libs, &input, Some(50), Some(200));\n}\n","userModified":false}}
