);\n    }\n\n    let stdout_fd: c_int = 1;\n    // Duplicate the original stdout fd so we can restore it later.\n    let saved_fd: c_int = unsafe { libc_dup(stdout_fd) };\n    assert!(saved_fd >= 0, \"dup(stdout) failed\");\n\n    // Create a pipe.\n    let mut pipefd: [c_int; 2] = [0, 0];\n    let r = unsafe { libc_pipe(pipefd.as_mut_ptr()) };\n    assert_eq!(r, 0, \"pipe() failed\");\n\n    // Redirect stdout to the write end of the pipe.\n    let r = unsafe { libc_dup2(pipefd[1], stdout_fd) };\n    assert!(r >= 0, \"dup2 failed\");\n    unsafe { libc_close(pipefd[1]) };\n\n    // Run the closure (its stdout output is now going to the pipe).\n    f();\n\n    // Flush both Rust and C stdout buffers before reading.\n    let _ = std::io::stdout().flush();\n    unsafe { libc_fflush_stdout() };\n\n    // Restore the original stdout.\n    unsafe { libc_dup2(saved_fd, stdout_fd) };\n    unsafe { libc_close(saved_fd) };\n\n    // Read whatever has been written to the pipe.\n    let mut file = unsafe { File::from_raw_fd(pipefd[0]) };\n    let mut buf = Vec::new();\n    file.read_to_end(&mut buf).expect(\"reading pipe\");\n    buf\n}\n\n// We need a few libc functions; declare them locally rather than depending on\n// the `libc` crate.\nuse std::os::unix::io::FromRawFd;\nunsafe extern \"C\" {\n    #[link_name = \"dup\"]\n    fn libc_dup(fd: c_int) -> c_int;\n    #[link_name = \"dup2\"]\n    fn libc_dup2(oldfd: c_int, newfd: c_int) -> c_int;\n    #[link_name = \"pipe\"]\n    fn libc_pipe(pipefd: *mut c_int) -> c_int;\n    #[link_name = \"close\"]\n    fn libc_close(fd: c_int) -> c_int;\n    fn fflush(stream: *mut std::ffi::c_void) -> c_int;\n}\n\nunsafe fn libc_fflush_stdout() {\n    // stdout in glibc is a known global; passing NULL flushes all open streams,\n    // which is sufficient for our test purposes.\n    unsafe { fflush(std::ptr::null_mut()) };\n    // Suppress unused warning by keeping a reference around.\n    let _ = AsRawFd::as_raw_fd;\n}\n\n// Helper: load both