        -1,\n        c_char::MIN,\n    ];\n\n    for &v in cases.iter() {\n        let c_out = capture_stdout(|| unsafe {\n            let f: Symbol<unsafe extern \"C\" fn(c_char)> =\n                c_lib.get(b\"printHexCharLine\").unwrap();\n            f(v);\n        });\n        let r_out = capture_stdout(|| unsafe {\n            let f: Symbol<unsafe extern \"C\" fn(c_char)> =\n                rust_lib.get(b\"printHexCharLine\").unwrap();\n            f(v);\n        });\n        assert_eq!(c_out, r_out, \"printHexCharLine({}) differs\", v);\n    }\n}\n\n#[test]\nfn test_bad_matches() {\n    let (c_lib, rust_lib) = load_libs();\n\n    let c_out = capture_stdout(|| unsafe {\n        let f: Symbol<unsafe extern \"C\" fn()> = c_lib.get(b\"bad\").unwrap();\n        f();\n    });\n    let r_out = capture_stdout(|| unsafe {\n        let f: Symbol<unsafe extern \"C\" fn()> = rust_lib.get(b\"bad\").unwrap();\n        f();\n    });\n\n    assert_eq!(c_out, r_out, \"bad() output differs\");\n}\n\n#[test]\nfn test_good_matches() {\n    let (c_lib, rust_lib) = load_libs();\n\n    let c_out = capture_stdout(|| unsafe {\n        let f: Symbol<unsafe extern \"C\" fn()> = c_lib.get(b\"good\").unwrap();\n        f();\n    });\n    let r_out = capture_stdout(|| unsafe {\n        let f: Symbol<unsafe extern \"C\" fn()> = rust_lib.get(b\"good\").unwrap();\n        f();\n    });\n\n    assert_eq!(c_out, r_out, \"good() output differs\");\n}\n\n#[test]\nfn test_driver_with_zero_matches() {\n    let (c_lib, rust_lib) = load_libs();\n\n    let c_out = capture_stdout(|| unsafe {\n        let f: Symbol<unsafe extern \"C\" fn(c_int)> = c_lib.get(b\"driver\").unwrap();\n        f(0);\n    });\n    let r_out = capture_stdout(|| unsafe {\n        let f: Symbol<unsafe extern \"C\" fn(c_int)> = rust_lib.get(b\"driver\").unwrap();\n        f(0);\n    });\n\n    assert_eq!(c_out, r_out, \"driver(0) output differs\");\n}\n\n#[test]\nfn test_driver_with_one_matches() {\n    let (c_lib, rust_lib) = load_libs();\n\n    let c_out = capture_stdout(|| unsafe {\n        let f: Symbol<unsafe extern \"C\" fn(c_int)> = c_lib.get(b\"driver\").unwrap();\n        f(1);\n    });\n    let r_out = capture_stdout(|| unsafe {\n        let f: Symbol<unsafe extern \"C\" fn(c_int)> = rust_lib.get(b\"driver\").unwrap();\n        f(1);\n    });\n\n    assert_eq!(c_out, r_out, \"driver(1) output differs\");\n}\n\n#[test]\nfn test_driver_with_other_nonzero_matches() {\n    let (c_lib, rust_lib) = load_libs();\n\n    for &v in &[2 as c_int, -1, 42, c_int::MAX, c_int::MIN] {\n        let c_out = capture_stdout(|| unsafe {\n            let f: Symbol<unsafe extern \"C\" fn(c_int)> = c_lib.get(b\"driver\").unwrap();\n            f(v);\n        });\n        let r_out = capture_stdout(|| unsafe {\n            let f: Symbol<unsafe extern \"C\" fn(c_int)> = rust_lib.get(b\"driver\").unwrap();\n            f(v);\n        });\n        assert_eq!(c_out, r_out, \"driver({}) output differs\", v);\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
