unsafe extern \"C\" fn(c_int)> = rust_lib.get(b\"driver\").unwrap();\n        f(1);\n    });\n\n    assert_eq!(c_out, r_out, \"driver(1) output differs\");\n}\n\n#[test]\nfn test_driver_with_other_nonzero_matches() {\n    let (c_lib, rust_lib) = load_libs();\n\n    for &v in &[2 as c_int, -1, 42, c_int::MAX, c_int::MIN] {\n        let c_out = capture_stdout(|| unsafe {\n            let f: Symbol<unsafe extern \"C\" fn(c_int)> = c_lib.get(b\"driver\").unwrap();\n            f(v);\n        });\n        let r_out = capture_stdout(|| unsafe {\n            let f: Symbol<unsafe extern \"C\" fn(c_int)> = rust_lib.get(b\"driver\").unwrap();\n            f(v);\n        });\n        assert_eq!(c_out, r_out, \"driver({}) output differs\", v);\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":452,"cache_read_input_tokens":21245,"cache_creation":{"ephemeral_5m_input_tokens":452,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"81c6cbce-f24a-40a7-aeff-39e0b9c8cc01","uuid":"88e02e8d-6ef0-4ac0-846e-2c23b2e04626"}
