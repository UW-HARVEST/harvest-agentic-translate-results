h(stdout);\n\n        let saved = dup(1);\n        assert!(saved >= 0, \"dup failed\");\n\n        let mut fds: [c_int; 2] = [0, 0];\n        let r = pipe(fds.as_mut_ptr());\n        assert_eq!(r, 0, \"pipe failed\");\n\n        // Make stdout point at the write end of the pipe.\n        let r = dup2(fds[1], 1);\n        assert!(r >= 0, \"dup2 failed\");\n        close(fds[1]);\n\n        f();\n\n        fflush(stdout);\n\n        // Restore original stdout.\n        let r = dup2(saved, 1);\n        assert!(r >= 0, \"dup2 restore failed\");\n        close(saved);\n\n        // Read everything from the read end of the pipe.\n        let mut file = std::fs::File::from_raw_fd(fds[0]);\n        let mut buf = Vec::new();\n        file.read_to_end(&mut buf).expect(\"read pipe\");\n        buf\n    }\n}\n\nfn load_lib(path: &str) -> Library {\n    unsafe { Library::new(path).expect(\"load library\") }\n}\n\nfn call_driver(lib: &Library, input: &str) -> Vec<u8> {\n    let cstr = CString::new(input).unwrap();\n    let p = cstr.as_ptr();\n    capture_stdout(|| unsafe {\n        let f: Symbol<unsafe extern \"C\" fn(*const c_char)> =\n            lib.get(b\"driver\").expect(\"get driver symbol\");\n        f(p);\n    })\n}\n\nfn call_run(lib: &Library, n: c_int) -> Vec<u8> {\n    capture_stdout(|| unsafe {\n        let f: Symbol<unsafe extern \"C\" fn(c_int)> =\n            lib.get(b\"run\").expect(\"get run symbol\");\n        f(n);\n    })\n}\n\nfn assert_eq_bytes(a: &[u8], b: &[u8], label: &str) {\n    if a != b {\n        eprintln!(\"--- {} ---\", label);\n        eprintln!(\"C    : {:?}\", String::from_utf8_lossy(a));\n        eprintln!(\"Rust : {:?}\", String::from_utf8_lossy(b));\n    }\n    assert_eq!(a, b, \"mismatch in {}\", label);\n}\n\n#[test]\nfn driver_valid_inputs() {\n    let cl = load_lib(C_LIB);\n    let rl = load_lib(RUST_LIB);\n\n    for inp in &[\"0\", \"1\", \"-1\", \"42\", \"-100\", \"2147483647\", \"-2147483648\"] {\n        let c_out = call_driver(&cl, inp);\n        let r_out = call_driver(&rl, inp);\n        assert_eq_bytes(&c_out, &r_out, &format!(\"driver(\\\"{}\\\")\", inp));\n    }\n}\n\n#[test]\nfn driver_invalid_inputs() {\n    let cl = load_lib(C_LIB);\n    let rl = load_lib(RUST_LIB);\n\n    for inp in &[\"\", \"hello\", \"abc123\"] {\n        let c_out = call_driver(&cl, inp);\n        let r_out = call_driver(&rl, inp);\n        assert_eq_bytes(&c_out, &r_out, &format!(\"driver(\\\"{}\\\")\", inp));\n    }\n}\n\n#[test]\nfn driver_overflow_inputs() {\n    let cl = load_lib(C_LIB);\n    let rl = load_lib(RUST_LIB);\n\n    for inp in &[\n        \"2147483648\",\n        \"-2147483649\",\n        \"99999999999999999999\",\n        \"-99999999999999999999\",\n    ] {\n        let c_out = call_driver(&cl, inp);\n        let r_out = call_driver(&rl, inp);\n        assert_eq_bytes(&c_out, &r_out, &format!(\"driver(\\\"{}\\\")\", inp));\n    }\n}\n\n#[test]\nfn driver_partial_parse() {\n    let cl = load_lib(C_LIB);\n    let rl = load_lib(RUST_LIB);\n    for inp in &[\"10abc\", \"  5\", \"+7\", \"-0\"] {\n        let c_out = call_driver(&cl, inp);\n        let r_out = call_driver(&rl, inp);\n        assert_eq_bytes(&c_out, &r_out, &format!(\"driver(\\\"{}\\\")\", inp));\n    }\n}\n\n#[test]\nfn run_direct() {\n    let cl = load_lib(C_LIB);\n    let rl = load_lib(RUST_LIB);\n\n    for n in &[0i32, 1, -1, 3, -10, 1000, i32::MAX, i32::MIN] {\n        let c_out = call_run(&cl, *n);\n        let r_out = call_run(&rl, *n);\n        assert_eq_bytes(&c_out, &r_out, &format!(\"run({})\", n));\n    }\n}\n","structuredPatch":[{"oldStart":1,"oldLines":14,"newStart":1,"newLines":19,"lines":[" // Integration tests that compare the Rust .so against the C .so."," //","-// We can't compare what the libraries print to stdout directly through a","-// `printf` call inside the library, so we redirect the process stdout to a","-// pipe with `dup2`, call the library, flush stdout, and read back the bytes.","-// The tests load both libraries and compare their outputs byte-for-byte.","+// The C library writes to stdout via `printf`. To compare outputs we","+// redirect process stdout to a pipe with `dup2`, call the library","+// function, flush stdout, and read the bytes back.","+//","+// Tests must serialize because stdout is a process-global resource and","+// each library carries its own `the_house` static, so concurrent calls","+// from the test harness would interleave each library's state."," "," use libloading::{Library, Symbol};"," use std::ffi::CString;"," use std::io::Read;"," use std::os::raw::{c_char, c_int};","+use std::os::unix::io::FromRawFd;","+use std::sync::Mutex;"," "," const C_LIB: &str = \"c_src/build/libdriver.so\";"," const RUST_LIB: &str = \"target/release/libdriver.so\";"]},{"oldStart":25,"oldLines":8,"newStart":30,"newLines":11,"lines":["     static stdout: *mut libc::FILE;"," }"," ","+static STDOUT_LOCK: Mutex<()> = Mutex::new(());","+"," /// Capture everything `f` writes to fd 1 (stdout) and return it as a byte vec."," fn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {","+    let _guard = STDOUT_LOCK.lock().unwrap();","     unsafe {","         // Flush any buffered output first so it doesn't leak into our capture.","         fflush(stdout);"]},{"oldStart":53,"oldLines":15,"newStart":61,"newLines":13,"lines":["         close(saved);"," ","         // Read everything from the read end of the pipe.","-        let mut file = std::fs::File::from(std::os::unix::io::OwnedFd::from_raw_fd(fds[0]));","+        let mut file = std::fs::File::from_raw_fd(fds[0]);","         let mut buf = Vec::new();","         file.read_to_end(&mut buf).expect(\"read pipe\");","         buf","     }"," }"," ","-use std::os::unix::io::FromRawFd;","-"," fn load_lib(path: &str) -> Library {","     unsafe { Library::new(path).expect(\"load library\") }"," }"]},{"oldStart":99,"oldLines":11,"newStart":105,"newLines":6,"lines":["     let rl = load_lib(RUST_LIB);"," ","     for inp in &[\"0\", \"1\", \"-1\