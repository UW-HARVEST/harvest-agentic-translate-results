re everything that gets written to stdout (including writes coming\n/// from inside a dynamically loaded shared library) while the closure runs.\nfn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {\n    unsafe {\n        // Flush any pending output before swapping stdout.\n        let _ = fflush(libc_stdout());\n\n        let stdout_fd = libc::STDOUT_FILENO;\n        let saved = libc::dup(stdout_fd);\n        assert!(saved >= 0, \"dup failed\");\n\n        let mut pipe_fds: [c_int; 2] = [0; 2];\n        let rc = libc::pipe(pipe_fds.as_mut_ptr());\n        assert_eq!(rc, 0, \"pipe failed\");\n        let (read_fd, write_fd) = (pipe_fds[0], pipe_fds[1]);\n\n        // Redirect stdout to the pipe's write end.\n        let rc = libc::dup2(write_fd, stdout_fd);\n        assert!(rc >= 0, \"dup2 failed\");\n        libc::close(write_fd);\n\n        f();\n\n        // Flush whatever the closure wrote, then restore stdout.\n        let _ = fflush(libc_stdout());\n        let rc = libc::dup2(saved, stdout_fd);\n        assert!(rc >= 0, \"dup2 restore failed\");\n        libc::close(saved);\n\n        // Read everything from the pipe's read end.\n        let mut file = std::fs::File::from_raw_fd(read_fd);\n        let mut buf = Vec::new();\n        file.read_to_end(&mut buf).expect(\"read pipe\");\n        buf\n    }\n}\n\nfn libc_stdout() -> *mut libc::FILE {\n    extern \"C\" {\n        static mut stdout: *mut libc::FILE;\n    }\n    unsafe { stdout }\n}\n\n// ---- Wrappers around the shared library exports ----\n\nunsafe fn call_print_line(lib: &Library, s: Option<&str>) {\n    let f: Symbol<unsafe extern \"C\" fn(*const c_char)> =\n        lib.get(b\"printLine\").expect(\"printLine symbol\");\n    match s {\n        Some(text) => {\n            let c = CString::new(text).unwrap();\n            f(c.as_ptr());\n        }\n        None => f(std::ptr::null()),\n    }\n}\n\nunsafe fn call_print_int_line(lib: &Library, n: c_int) {\n    let f: Symbol<unsafe extern \"C\" fn(c_int)> =\n        lib.get(b\"printIntLine\").expect(\"printIntLine symbol\");\n    f(n);\n}\n\nunsafe fn call_bad(lib: &Library, data: c_float) {\n    let f: Symbol<unsafe extern \"C\" fn(c_float)> =\n        lib.get(b\"bad\").expect(\"bad symbol\");\n    f(data);\n}\n\nunsafe fn call_good(lib: &Library, data: c_float) {\n    let f: Symbol<unsafe extern \"C\" fn(c_float)> =\n        lib.get(b\"good\").expect(\"good symbol\");\n    f(data);\n}\n\nunsafe fn call_driver(lib: &Library, good_data: c_float, bad_data: c_float) {\n    let f: Symbol<unsafe extern \"C\" fn(c_float, c_float)> =\n        lib.get(b\"driver\").expect(\"driver symbol\");\n    f(good_data, bad_data);\n}\n\nfn load_libs() -> (Library, Library) {\n    unsafe {\n        let c = Library::new(c_lib_path()).expect(\"load C library\");\n        let r = Library::new(rust_lib_path()).expect(\"load Rust library\");\n        (c, r)\n    }\n}\n\nfn assert_same<F: Fn(&Library)>(label: &str, c_lib: &Library, rust_lib: &Library, f: F) {\n    let c_out = capture_stdout(|| f(c_lib));\n    let rust_out = capture_stdout(|| f(rust_lib));\n    assert_eq!(\n        c_out, rust_out,\n        \"output mismatch for {label}: C={:?} Rust={:?}\",\n        String::from_utf8_lossy(&c_out),\n        String::from_utf8_lossy(&rust_out)\n    );\n}\n\n// ---- Tests ----\n\n#[test]\nfn print_line_with_text() {\n    let (c_lib, rust_lib) = load_libs();\n    for text in &[\"\", \"hello\", \"line one\\nline two\", \"with %d format specifiers\", \"trailing space \"] {\n        assert_same(&format!(\"printLine({text:?})\"), &c_lib, &rust_lib, |lib| unsafe {\n            call_print_line(lib, Some(text));\n        });\n    }\n}\n\n#[test]\nfn print_line_null_is_noop() {\n    let (c_lib, rust_lib) = load_libs();\n    assert_same(\"printLine(NULL)\", &c_lib, &rust_lib, |lib| unsafe {\n        call_print_line(lib, None);\n    });\n}\n\n#[test]\nfn print_int_line_values() {\n    let (c_lib, rust_lib) = load_libs();\n    for &n in &[0_i32, 1, -1, 42, -42, i32::MAX, i32::MIN] {\n        assert_same(&format!(\"printIntLine({n})\"), &c_lib, &rust_lib, |lib| unsafe {\n            call_print_int_line(lib, n);\n        });\n    }\n}\n\n#[test]\nfn bad_various_inputs() {\n    let (c_lib, rust_lib) = load_libs();\n    // Stick to inputs where (int)(100.0 / data) is well-defined to avoid\n    // platform UB; we still want a representative spread.\n    for &v in &[1.0_f32, 2.0, 4.0, 0.5, -1.0, -2.5, 100.0, 0.1, 10.0, 0.01] {\n        assert_same(&format!(\"bad({v})\"), &c_lib, &rust_lib, |lib| unsafe {\n            call_bad(lib, v);\n        });\n    }\n}\n\n#[test]\nfn good_various_inputs() {\n    let (c_lib, rust_lib) = load_libs();\n    // Includes a value below the 1e-6 threshold to exercise the divide-by-zero branch.\n    for &v in &[1.0_f32, 2.0, -1.0, 0.0, 0.0000001, -0.0000001, 50.0, 0.5] {\n        assert_same(&format!(\"good({v})\"), &c_lib, &rust_lib, |lib| unsafe {\n            call_good(lib, v);\n        });\n    }\n}\n\n#[test]\nfn driver_various_inputs() {\n    let (c_lib, rust_lib) = load_libs();\n    let cases: &[(f32, f32)] = &[\n        (5.0, 5.0),\n        (1.0, 2.0),\n        (-3.0, 4.0),\n        (0.0, 1.0),    // good() takes the divide-by-zero branch\n        (0.5, 0.25),\n        (1e-7, 100.0), // good() takes the divide-by-zero branch\n    ];\n    for &(g, b) in cases {\n        assert_same(&format!(\"driver({g}, {b})\"), &c_lib, &rust_lib, |lib| unsafe {\n            call_driver(lib, g, b);\n        });\n    }\n}\n","structuredPatch":[{"oldStart":33,"oldLines":6,"newStart":33,"newLines":7,"lines":[" /// Capture everything that gets written to stdout (including writes coming"," /// from inside a dynamically loaded shared library) while the closure runs."," fn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {","+    let _guard = stdout_lock().lock().unwrap_or_else(|e| e.into_inner());","     unsafe {","         // Flush any pending output before swapping stdout.","         let _ = fflush(libc_stdout());"]}],"userModified":false,"replaceAll":false}}
