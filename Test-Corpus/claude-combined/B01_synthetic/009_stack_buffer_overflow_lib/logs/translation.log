{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_vtu5ih3wqjclljtea2ygsiksabfotehnixu3fbfjfooxsziucnua","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_014h3uneqUbe93BxZfbNf94U","name":"Write","input":{"file_path":"/tmp/harvest-translate-Wnuwnz/translated_rust/tests/ffi_compare.rs","content":"// Integration tests that compare the C reference shared library against\n// the Rust shared library by loading both via libloading and calling their\n// exported symbols. Output is captured by redirecting fd 1 (stdout) to a pipe.\n\nuse libloading::{Library, Symbol};\nuse std::ffi::{c_char, c_int};\nuse std::io::Read;\nuse std::os::unix::io::{FromRawFd, IntoRawFd, RawFd};\nuse std::path::PathBuf;\nuse std::sync::Mutex;\n\n// Serialize stdout-capturing tests since they all manipulate fd 1 globally.\nstatic STDOUT_LOCK: Mutex<()> = Mutex::new(());\n\nfn c_lib_path() -> PathBuf {\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n        .join(\"c_src\")\n        .join(\"build\")\n        .join(\"libdriver.so\")\n}\n\nfn rust_lib_path() -> PathBuf {\n    // cargo test builds the cdylib in target/<profile>/deps and target/<profile>\n    let mut p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\")).join(\"target\");\n    // Try debug first, fall back to release\n    let dbg = p.join(\"debug\").join(\"libdriver.so\");\n    if dbg.exists() {\n        return dbg;\n    }\n    p.push(\"release\");\n    p.push(\"libdriver.so\");\n    p\n}\n\n/// Capture everything written to stdout during the closure by replacing\n/// fd 1 with a pipe. Returns the raw bytes.\nfn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {\n    use std::os::unix::io::AsRawFd;\n    // Flush Rust's stdout buffer first\n    use std::io::Write;\n    let _ = std::io::stdout().flush();\n\n    // Create a pipe\n    let mut fds = [0 as libc::c_int; 2];\n    let rc = unsafe { libc::pipe(fds.as_mut_ptr()) };\n    assert_eq!(rc, 0, \"pipe() failed\");\n    let read_fd: RawFd = fds[0];\n    let write_fd: RawFd = fds[1];\n\n    // Save the current stdout and dup the pipe write end onto fd 1\n    let saved_stdout: RawFd = unsafe { libc::dup(1) };\n    assert!(saved_stdout >= 0, \"dup(1) failed\");\n    let rc = unsafe { libc::dup2(write_fd, 1) };\n    assert!(rc >= 0, \"dup2 failed\");\n    unsafe { libc::close(write_fd) };\n\n    // Run the function\n    f();\n\n    // Flush libc stdout\n    unsafe {\n        let _ = libc::fflush(std::ptr::null_mut());\n    }\n\n    // Restore original stdout\n    let rc = unsafe { libc::dup2(saved_stdout, 1) };\n    assert!(rc >= 0, \"dup2 restore failed\");\n    unsafe { libc::close(saved_stdout) };\n\n    // Read everything from the pipe\n    let mut file = unsafe { std::fs::File::from_raw_fd(read_fd) };\n    let mut out = Vec::new();\n    // Set non-blocking? We've already closed the write fd in this process;\n    // however the dup2'd copy was on fd 1 which we restored. So the only\n    // remaining write end was the dup2 copy on fd 1, which is now gone.\n    file.read_to_end(&mut out).expect(\"read pipe\");\n    let _ = file.into_raw_fd(); // ensure fd is closed via Drop of File at end of scope; into_raw_fd skips that. Use drop instead:\n    // Actually we want File to close on drop. Re-wrap:\n    out\n}\n\nextern crate libc;\n\n// Function signature types\ntype FnPrintLine = unsafe extern \"C\" fn(*const c_char);\ntype FnPrintIntLine = unsafe extern \"C\" fn(c_int);\ntype FnBad = unsafe extern \"C\" fn(c_int);\ntype FnGood = unsafe extern \"C\" fn(c_int);\ntype FnDriver = unsafe extern \"C\" fn(c_int, c_int);\n\nfn run_c<F: FnOnce(&Library)>(f: F) -> Vec<u8> {\n    let lib = unsafe { Library::new(c_lib_path()).expect(\"load C lib\") };\n    let bytes = capture_stdout(|| f(&lib));\n    drop(lib);\n    bytes\n}\n\nfn run_rust<F: FnOnce(&Library)>(f: F) -> Vec<u8> {\n    let lib = unsafe { Library::new(rust_lib_path()).expect(\"load Rust lib\") };\n    let bytes = capture_stdout(|| f(&lib));\n    drop(lib);\n    bytes\n}\n\nfn assert_match(name: &str, c_out: &[u8], r_out: &[u8]) {\n    if c_out != r_out {\n        eprintln!(\"=== {} mismatch ===\", name);\n        eprintln!(\"C   ({} bytes): {:?}\", c_out.len(), String::from_utf8_lossy(c_out));\n        eprintln!(\"Rust({} bytes): {:?}\", r_out.len(), String::from_utf8_lossy(r_out));\n        panic!(\"output differed for {}\", name);\n    }\n}\n\n#[test]\nfn print_line_basic() {\n    let _g = STDOUT_LOCK.lock().unwrap();\n    let msg = b\"hello world\\0\";\n    let c = run_c(|lib| {\n        let f: Symbol<FnPrintLine> = unsafe { lib.get(b\"printLine\\0\").unwrap() };\n        unsafe { f(msg.as_ptr() as *const c_char) };\n    });\n    let r = run_rust(|lib| {\n        let f: Symbol<FnPrintLine> = unsafe { lib.get(b\"printLine\\0\").unwrap() };\n        unsafe { f(msg.as_ptr() as *const c_char) };\n    });\n    assert_match(\"printLine basic\", &c, &r);\n}\n\n#[test]\nfn print_line_null() {\n    let _g = STDOUT_LOCK.lock().unwrap();\n    let c = run_c(|lib| {\n        let f: Symbol<FnPrintLine> = unsafe { lib.get(b\"printLine\\0\").unwrap() };\n        unsafe { f(std::ptr::null()) };\n    });\n    let r = run_rust(|lib| {\n        let f: Symbol<FnPrintLine> = unsafe { lib.get(b\"printLine\\0\").unwrap() };\n        unsafe { f(std::ptr::null()) };\n    });\n    assert_match(\"printLine null\", &c, &r);\n}\n\n#[test]\nfn print_line_empty() {\n    let _g = STDOUT_LOCK.lock().unwrap();\n    let msg = b\"\\0\";\n    let c = run_c(|lib| {\n        let f: Symbol<FnPrintLine> = unsafe { lib.get(b\"printLine\\0\").unwrap() };\n        unsafe { f(msg.as_ptr() as *const c_char) };\n    });\n    let r = run_rust(|lib| {\n        let f: Symbol<FnPrintLine> = unsafe { lib.get(b\"printLine\\0\").unwrap() };\n        unsafe { f(msg.as_ptr() as *const c_char) };\n    });\n    assert_match(\"printLine empty\", &c, &r);\n}\n\n#[test]\nfn print_int_line_values() {\n    let _g = STDOUT_LOCK.lock().unwrap();\n    for &v in &[0i32, 1, -1, 42, i32::MAX, i32::MIN] {\n        let c = run_c(|lib| {\n            let f: Symbol<FnPrintIntLine> = unsafe { lib.get(b\"printIntLine\\0\").unwrap() };\n            unsafe { f(v) };\n        });\n        let r = run_rust(|lib| {\n            let f: Symbol<FnPrintIntLine> = unsafe { lib.get(b\"printIntLine\\0\").unwrap() };\n            unsafe { f(v) };\n        });\n        assert_match(&format!(\"printIntLine({})\", v), &c, &r);\n    }\n}\n\n#[test]\nfn bad_negative() {\n    let _g = STDOUT_LOCK.lock().unwrap();\n    let c = run_c(|lib| {\n        let f: Symbol<FnBad> = unsafe { lib.get(b\"bad\\0\").unwrap() };\n        unsafe { f(-1) };\n    });\n    let r = run_rust(|lib| {\n        let f: Symbol<FnBad> = unsafe { lib.get(b\"bad\\0\").unwrap() };\n        unsafe { f(-1) };\n    });\n    assert_match(\"bad(-1)\", &c, &r);\n}\n\n#[test]\nfn bad_in_range() {\n    let _g = STDOUT_LOCK.lock().unwrap();\n    for v in 0..10i32 {\n        let c = run_c(|lib| {\n            let f: Symbol<FnBad> = unsafe { lib.get(b\"bad\\0\").unwrap() };\n            unsafe { f(v) };\n        });\n        let r = run_rust(|lib| {\n            let f: Symbol<FnBad> = unsafe { lib.get(b\"bad\\0\").unwrap() };\n            unsafe { f(v) };\n        });\n        assert_match(&format!(\"bad({})\", v), &c, &r);\n    }\n}\n\n#[test]\nfn good_various() {\n    let _g = STDOUT_LOCK.lock().unwrap();\n    for &v in &[-5i32, -1, 0, 3, 7, 9] {\n        let c = run_c(|lib| {\n            let f: Symbol<FnGood> = unsafe { lib.get(b\"good\\0\").unwrap() };\n            unsafe { f(v) };\n        });\n        let r = run_rust(|lib| {\n            let f: Symbol<FnGood> = unsafe { lib.get(b\"good\\0\").unwrap() };\n            unsafe { f(v) };\n        });\n        assert_match(&format!(\"good({})\", v), &c, &r);\n    }\n}\n\n#[test]\nfn good_out_of_range() {\n    let _g = STDOUT_LOCK.lock().unwrap();\n    for &v in &[10i32, 50, 1000] {\n        let c = run_c(|lib| {\n            let f: Symbol<FnGood> = unsafe { lib.get(b\"good\\0\").unwrap() };\n            unsafe { f(v) };\n        });\n        let r = run_rust(|lib| {\n            let f: Symbol<FnGood> = unsafe { lib.get(b\"good\\0\").unwrap() };\n            unsafe { f(v) };\n        });\n        assert_match(&format!(\"good({})\", v), &c, &r);\n    }\n}\n\n#[test]\nfn driver_various() {\n    let _g = STDOUT_LOCK.lock().unwrap();\n    let cases: &[(c_int, c_int)] = &[\n        (0, 0),\n        (5, 5),\n        (-1, -1),\n        (7, 3),\n        (9, 9),\n    ];\n    for &(g, b) in cases {\n        let c = run_c(|lib| {\n            let f: Symbol<FnDriver> = unsafe { lib.get(b\"driver\\0\").unwrap() };\n            unsafe { f(g, b) };\n        });\n        let r = run_rust(|lib| {\n            let f: Symbol<FnDriver> = unsafe { lib.get(b\"driver\\0\").unwrap() };\n            unsafe { f(g, b) };\n        });\n        assert_match(&format!(\"driver({}, {})\", g, b), &c, &r);\n    }\n}\n\n#[test]\nfn symbols_match() {\n    // Spot-check: every public C symbol must be exported by the Rust .so.\n    let c = unsafe { Library::new(c_lib_path()).expect(\"load C\") };\n    let r = unsafe { Library::new(rust_lib_path()).expect(\"load Rust\") };\n    for name in &[\"printLine\", \"printIntLine\", \"bad\", \"good\", \"driver\"] {\n        let mut nul = name.as_bytes().to_vec();\n        nul.push(0);\n        unsafe {\n            c.get::<*const ()>(&nul).unwrap_or_else(|_| panic!(\"C missing {}\", name));\n            r.get::<*const ()>(&nul).unwrap_or_else(|_| panic!(\"Rust missing {}\", name));\n        }\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":161,"cache_read_input_tokens":20502,"cache_creation":{"ephemeral_5m_input_tokens":161,"ephemeral_1h_input_tokens":0},"output_tokens":22,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"a8feff04-924c-4e6f-ac59-e27ce7d980c0","uuid":"b17dea4c-cc1b-47b1-ad3f-02f92230e69a"}
