(|| f(&lib));\n    drop(lib);\n    bytes\n}\n\nfn run_rust<F: FnOnce(&Library)>(f: F) -> Vec<u8> {\n    let lib = unsafe { Library::new(rust_lib_path()).expect(\"load Rust lib\") };\n    let bytes = capture_stdout(|| f(&lib));\n    drop(lib);\n    bytes\n}\n\nfn assert_match(name: &str, c_out: &[u8], r_out: &[u8]) {\n    if c_out != r_out {\n        eprintln!(\"=== {} mismatch ===\", name);\n        eprintln!(\"C   ({} bytes): {:?}\", c_out.len(), String::from_utf8_lossy(c_out));\n        eprintln!(\"Rust({} bytes): {:?}\", r_out.len(), String::from_utf8_lossy(r_out));\n        panic!(\"output differed for {}\", name);\n    }\n}\n\n#[test]\nfn print_line_basic() {\n    let _g = STDOUT_LOCK.lock().unwrap();\n    let msg = b\"hello world\\0\";\n    let c = run_c(|lib| {\n        let f: Symbol<FnPrintLine> = unsafe { lib.get(b\"printLine\\0\").unwrap() };\n        unsafe { f(msg.as_ptr() as *const c_char) };\n    });\n    let r = run_rust(|lib| {\n        let f: Symbol<FnPrintLine> = unsafe { lib.get(b\"printLine\\0\").unwrap() };\n        unsafe { f(msg.as_ptr() as *const c_char) };\n    });\n    assert_match(\"printLine basic\", &c, &r);\n}\n\n#[test]\nfn print_line_null() {\n    let _g = STDOUT_LOCK.lock().unwrap();\n    let c = run_c(|lib| {\n        let f: Symbol<FnPrintLine> = unsafe { lib.get(b\"printLine\\0\").unwrap() };\n        unsafe { f(std::ptr::null()) };\n    });\n    let r = run_rust(|lib| {\n        let f: Symbol<FnPrintLine> = unsafe { lib.get(b\"printLine\\0\").unwrap() };\n        unsafe { f(std::ptr::null()) };\n    });\n    assert_match(\"printLine null\", &c, &r);\n}\n\n#[test]\nfn print_line_empty() {\n    let _g = STDOUT_LOCK.lock().unwrap();\n    let msg = b\"\\0\";\n    let c = run_c(|lib| {\n        let f: Symbol<FnPrintLine> = unsafe { lib.get(b\"printLine\\0\").unwrap() };\n        unsafe { f(msg.as_ptr() as *const c_char) };\n    });\n    let r = run_rust(|lib| {\n        let f: Symbol<FnPrintLine> = unsafe { lib.get(b\"printLine\\0\").unwrap() };\n        unsafe { f(msg.as_ptr() as *const c_char) };\n    });\n    assert_match(\"printLine empty\", &c, &r);\n}\n\n#[test]\nfn print_int_line_values() {\n    let _g = STDOUT_LOCK.lock().unwrap();\n    for &v in &[0i32, 1, -1, 42, i32::MAX, i32::MIN] {\n        let c = run_c(|lib| {\n            let f: Symbol<FnPrintIntLine> = unsafe { lib.get(b\"printIntLine\\0\").unwrap() };\n            unsafe { f(v) };\n        });\n        let r = run_rust(|lib| {\n            let f: Symbol<FnPrintIntLine> = unsafe { lib.get(b\"printIntLine\\0\").unwrap() };\n            unsafe { f(v) };\n        });\n        assert_match(&format!(\"printIntLine({})\", v), &c, &r);\n    }\n}\n\n#[test]\nfn bad_negative() {\n    let _g = STDOUT_LOCK.lock().unwrap();\n    let c = run_c(|lib| {\n        let f: Symbol<FnBad> = unsafe { lib.get(b\"bad\\0\").unwrap() };\n        unsafe { f(-1) };\n    });\n    let r = run_rust(|lib| {\n        let f: Symbol<FnBad> = unsafe { lib.get(b\"bad\\0\").unwrap() };\n        unsafe { f(-1) };\n    });\n    assert_match(\"bad(-1)\", &c, &r);\n}\n\n#[test]\nfn bad_in_range() {\n    let _g = STDOUT_LOCK.lock().unwrap();\n    for v in 0..10i32 {\n        let c = run_c(|lib| {\n            let f: Symbol<FnBad> = unsafe { lib.get(b\"bad\\0\").unwrap() };\n            unsafe { f(v) };\n        });\n        let r = run_rust(|lib| {\n            let f: Symbol<FnBad> = unsafe { lib.get(b\"bad\\0\").unwrap() };\n            unsafe { f(v) };\n        });\n        assert_match(&format!(\"bad({})\", v), &c, &r);\n    }\n}\n\n#[test]\nfn good_various() {\n    let _g = STDOUT_LOCK.lock().unwrap();\n    for &v in &[-5i32, -1, 0, 3, 7, 9] {\n        let c = run_c(|lib| {\n            let f: Symbol<FnGood> = unsafe { lib.get(b\"good\\0\").unwrap() };\n            unsafe { f(v) };\n        });\n        let r = run_rust(|lib| {\n            let f: Symbol<FnGood> = unsafe { lib.get(b\"good\\0\").unwrap() };\n            unsafe { f(v) };\n        });\n        assert_match(&format!(\"good({})\", v), &c, &r);\n    }\n}\n\n#[test]\nfn good_out_of_range() {\n    let _g = STDOUT_LOCK.lock().unwrap();\n    for &v in &[10i32, 50, 1000] {\n        let c = run_c(|lib| {\n            let f: Symbol<FnGood> = unsafe { lib.get(b\"good\\0\").unwrap() };\n            unsafe { f(v) };\n        });\n        let r = run_rust(|lib| {\n            let f: Symbol<FnGood> = unsafe { lib.get(b\"good\\0\").unwrap() };\n            unsafe { f(v) };\n        });\n        assert_match(&format!(\"good({})\", v), &c, &r);\n    }\n}\n\n#[test]\nfn driver_various() {\n    let _g = STDOUT_LOCK.lock().unwrap();\n    let cases: &[(c_int, c_int)] = &[\n        (0, 0),\n        (5, 5),\n        (-1, -1),\n        (7, 3),\n        (9, 9),\n    ];\n    for &(g, b) in cases {\n        let c = run_c(|lib| {\n            let f: Symbol<FnDriver> = unsafe { lib.get(b\"driver\\0\").unwrap() };\n            unsafe { f(g, b) };\n        });\n        let r = run_rust(|lib| {\n            let f: Symbol<FnDriver> = unsafe { lib.get(b\"driver\\0\").unwrap() };\n            unsafe { f(g, b) };\n        });\n        assert_match(&format!(\"driver({}, {})\", g, b), &c, &r);\n    }\n}\n\n#[test]\nfn symbols_match() {\n    // Spot-check: every public C symbol must be exported by the Rust .so.\n    let c = unsafe { Library::new(c_lib_path()).expect(\"load C\") };\n    let r = unsafe { Library::new(rust_lib_path()).expect(\"load Rust\") };\n    for name in &[\"printLine\", \"printIntLine\", \"bad\", \"good\", \"driver\"] {\n        let mut nul = name.as_bytes().to_vec();\n        nul.push(0);\n        unsafe {\n            c.get::<*const ()>(&nul).unwrap_or_else(|_| panic!(\"C missing {}\", name));\n            r.get::<*const ()>(&nul).unwrap_or_else(|_| panic!(\"Rust missing {}\", name));\n        }\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
