ARRAY_SIZE];","+        for i in 0..ARRAY_SIZE {","+            out[i] = *array_ptr.add(i);","+        }","+        out","+    }","+}","+","+extern \"C\" {","+    #[link_name = \"srand\"]","+    fn libc_srand(seed: c_uint);","+    #[link_name = \"rand\"]","+    fn libc_rand() -> c_int;","+}","+","+#[test]","+fn perform_expensive_operations_matches_for_seed_42() {","+    let c_out = run_perform_once(&c_lib_path(), 42);","+    let r_out = run_perform_once(&rust_lib_path(), 42);","+    assert_eq!(c_out.len(), r_out.len());","+    if c_out != r_out {","+        let mut first_diff = None;","+        for i in 0..c_out.len() {","+            if c_out[i] != r_out[i] {","+                first_diff = Some((i, c_out[i], r_out[i]));","+                break;","+            }","+        }","+        panic!(\"perform_expensive_operations mismatch; first diff: {:?}\", first_diff);","+    }","+}","+","+#[test]","+fn perform_expensive_operations_matches_for_seed_0() {","+    let c_out = run_perform_once(&c_lib_path(), 0);","+    let r_out = run_perform_once(&rust_lib_path(), 0);","+    assert_eq!(c_out, r_out);","+}","+","+#[test]","+fn perform_expensive_operations_matches_for_seed_1234567() {","+    let c_out = run_perform_once(&c_lib_path(), 1234567);","+    let r_out = run_perform_once(&rust_lib_path(), 1234567);","+    assert_eq!(c_out, r_out);","+}","+","+#[test]"," #[ignore = \"slow: long_exec runs ~4 minutes per call. Run with --ignored.\"]"," fn long_exec_outputs_match_for_seed_42() {","-    // Note: `long_exec` runs ~1MB * 2000 iterations of math; this is slow but","-    // tractable. Single seed keeps test runtime reasonable.","     let c_out = run_long_exec(&c_lib_path(), 42);","     let r_out = run_long_exec(&rust_lib_path(), 42);","     assert_eq!("]}],"originalFile":"// Integration test: compare C reference and Rust translation through libloading.\n// Both .so files are loaded and the exported C ABI symbols are called directly.\n\nuse libloading::{Library, Symbol};\nuse std::os::raw::{c_int, c_uint};\nuse std::process::{Command, Stdio};\n\nfn c_lib_path() -> String {\n    \"c_src/build/liblong.so\".to_string()\n}\n\nfn rust_lib_path() -> String {\n    \"target/release/liblong.so\".to_string()\n}\n\n/// Spawn a child process that loads the given .so via libloading and calls\n/// `long_exec(seed)`. The child writes the captured stdout (the printf line)\n/// to its own stdout. We use a separate process so the global `array` from the\n/// two libraries cannot interfere with each other in a single process — and so\n/// stdout captured from `printf` is cleanly separated.\nfn run_long_exec(lib_path: &str, seed: c_uint) -> String {\n    // Use a small helper binary built at runtime via `cc` is too involved;\n    // instead spawn `cargo run` on a tiny helper in tests/helpers/. To keep\n    // this test self-contained, we instead `exec` ourselves via a sub-process\n    // helper compiled inline using the system's C compiler.\n    let helper_src = r#\"\n#include <dlfcn.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\nint main(int argc, char **argv) {\n    if (argc < 3) return 2;\n    void *h = dlopen(argv[1], RTLD_NOW);\n    if (!h) { fprintf(stderr, \"dlopen failed: %s\\n\", dlerror()); return 3; }\n    void (*fn)(unsigned int) = (void (*)(unsigned int))dlsym(h, \"long_exec\");\n    if (!fn) { fprintf(stderr, \"dlsym failed: %s\\n\", dlerror()); return 4; }\n    fn((unsigned int)strtoul(argv[2], NULL, 10));\n    fflush(stdout);\n    return 0;\n}\n\"#;\n    let tmpdir = std::env::temp_dir().join(format!(\"long_ffi_helper_{}\", std::process::id()));\n    std::fs::create_dir_all(&tmpdir).unwrap();\n    let src_path = tmpdir.join(\"helper.c\");\n    let bin_path = tmpdir.join(\"helper\");\n    std::fs::write(&src_path, helper_src).unwrap();\n    let cc = std::env::var(\"CC\").unwrap_or_else(|_| \"cc\".to_string());\n    let status = Command::new(&cc)\n        .arg(&src_path)\n        .arg(\"-o\")\n        .arg(&bin_path)\n        .arg(\"-ldl\")\n        .status()\n        .expect(\"compile helper\");\n    assert!(status.success(), \"helper compile failed\");\n\n    let output = Command::new(&bin_path)\n        .arg(lib_path)\n        .arg(seed.to_string())\n        .stdout(Stdio::piped())\n        .stderr(Stdio::piped())\n        .output()\n        .expect(\"run helper\");\n    assert!(\n        output.status.success(),\n        \"helper exited with {:?}: stderr={}\",\n        output.status,\n        String::from_utf8_lossy(&output.stderr)\n    );\n    String::from_utf8(output.stdout).expect(\"stdout utf8\")\n}\n\n#[test]\nfn rust_lib_exports_long_exec_symbol() {\n    // Confirm the Rust .so really exports `long_exec` with the right C ABI.\n    unsafe {\n        let lib = Library::new(rust_lib_path()).expect(\"load rust .so\");\n        let _sym: Symbol<unsafe extern \"C\" fn(c_uint)> =\n            lib.get(b\"long_exec\").expect(\"rust .so missing long_exec\");\n    }\n}\n\n#[test]\nfn c_lib_exports_long_exec_symbol() {\n    unsafe {\n        let lib = Library::new(c_lib_path()).expect(\"load c .so\");\n        let _sym: Symbol<unsafe extern \"C\" fn(c_uint)> =\n            lib.get(b\"long_exec\").expect(\"c .so missing long_exec\");\n    }\n}\n\n#[test]\nfn rust_lib_exports_perform_expensive_operations_symbol() {\n    unsafe {\n        let lib = Library::new(rust_lib_path()).expect(\"load rust .so\");\n        let _sym: Symbol<unsafe extern \"C\" fn()> = lib\n            .get(b\"perform_expensive_operations\")\n            .expect(\"rust .so missing perform_expensive_operations\");\n    }\n}\n\n#[test]\nfn rust_lib_exports_array_symbol() {\n    unsafe {\n        let lib = Library::new(rust_lib_path()).expect(\"load rust .so\");\n        let _sym: Symbol<*mut c_int> =\n            lib.get(b\"array\").expect(\"rust .so missing `array` global\");\n    }\n}\n\n#[test]\n#[ignore = \"slow: long_exec runs ~4 minutes per call. Run with --ignored.\"]\nfn long_exec_outputs_match_for_seed_42() {\n    // Note: `long_exec` runs ~1MB * 2000 iterations of math; this is slow but\n    // tractable. Single seed keeps test runtime reasonable.\n    let c_out = run_long_exec(&c_lib_path(), 42);\n    let r_out = run_long_exec(&rust_lib_path(), 42);\n    assert_eq!(\n        c_out.as_bytes(),\n        r_out.as_bytes(),\n        \"mismatch for seed 42:\\n  C   = {:?}\\n  Rust= {:?}\",\n        c_out,\n        r_out\n    );\n}\n","userModified":false}}
