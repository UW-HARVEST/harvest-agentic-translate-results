{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_grxbnm6ng53jiudsr6mq7fn4oxoe4becimxz3vyrru6fv4bd5orq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01CyVfiyrRqXTTEL3bB64RrR","name":"Write","input":{"file_path":"/tmp/harvest-translate-YbVnVZ/translated_rust/tests/ffi_compare.rs","content":"// Integration tests: load both C and Rust .so via libloading and compare\n// their stdout output byte-for-byte.\n\nuse libloading::{Library, Symbol};\nuse std::ffi::c_int;\nuse std::fs::File;\nuse std::io::{Read, Seek, SeekFrom, Write};\nuse std::os::unix::io::{AsRawFd, FromRawFd};\nuse std::path::PathBuf;\n\nfn project_root() -> PathBuf {\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n}\n\nfn c_lib_path() -> PathBuf {\n    project_root().join(\"c_src\").join(\"build\").join(\"libdriver.so\")\n}\n\nfn rust_lib_path() -> PathBuf {\n    project_root()\n        .join(\"target\")\n        .join(\"release\")\n        .join(\"libdriver.so\")\n}\n\n/// Capture stdout written during the closure (including from C's printf and\n/// Rust's println). Uses dup2 to redirect fd 1 to a temp file, then reads it\n/// back.\nfn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {\n    // Flush any pending Rust stdout.\n    let _ = std::io::stdout().flush();\n    // Flush libc stdout in case the C lib already wrote something earlier.\n    unsafe {\n        libc::fflush(std::ptr::null_mut());\n    }\n\n    // Create temp file\n    let tmp_path = std::env::temp_dir().join(format!(\n        \"ffi_capture_{}_{}.bin\",\n        std::process::id(),\n        std::time::SystemTime::now()\n            .duration_since(std::time::UNIX_EPOCH)\n            .unwrap()\n            .as_nanos()\n    ));\n    let tmp_file = File::create(&tmp_path).expect(\"create tmp file\");\n\n    let stdout_fd = 1;\n    // Save original stdout\n    let saved = unsafe { libc::dup(stdout_fd) };\n    assert!(saved >= 0, \"dup failed\");\n\n    // Redirect stdout to the temp file\n    let r = unsafe { libc::dup2(tmp_file.as_raw_fd(), stdout_fd) };\n    assert!(r >= 0, \"dup2 failed\");\n\n    // Drop tmp_file (we'll re-open by path); but keep file alive on disk.\n    drop(tmp_file);\n\n    // Run user closure\n    f();\n\n    // Flush stdio\n    let _ = std::io::stdout().flush();\n    unsafe {\n        libc::fflush(std::ptr::null_mut());\n    }\n\n    // Restore stdout\n    let r = unsafe { libc::dup2(saved, stdout_fd) };\n    assert!(r >= 0, \"dup2 restore failed\");\n    unsafe {\n        libc::close(saved);\n    }\n\n    // Read captured contents\n    let mut f = File::open(&tmp_path).expect(\"open tmp file for read\");\n    let _ = f.seek(SeekFrom::Start(0));\n    let mut buf = Vec::new();\n    f.read_to_end(&mut buf).expect(\"read tmp file\");\n    let _ = std::fs::remove_file(&tmp_path);\n    buf\n}\n\nunsafe fn call_driver(lib: &Library, x: c_int) {\n    let f: Symbol<unsafe extern \"C\" fn(c_int)> =\n        lib.get(b\"driver\\0\").expect(\"driver symbol\");\n    f(x);\n}\n\nfn run_driver(lib_path: &PathBuf, x: c_int) -> Vec<u8> {\n    let lib = unsafe { Library::new(lib_path) }.expect(\"load library\");\n    let out = capture_stdout(|| unsafe { call_driver(&lib, x) });\n    drop(lib);\n    out\n}\n\nfn assert_match(x: c_int) {\n    let c_out = run_driver(&c_lib_path(), x);\n    let r_out = run_driver(&rust_lib_path(), x);\n    assert_eq!(\n        c_out, r_out,\n        \"mismatch for driver({}):\\n  C   = {:?}\\n  Rust= {:?}\",\n        x,\n        String::from_utf8_lossy(&c_out),\n        String::from_utf8_lossy(&r_out)\n    );\n}\n\n#[test]\nfn driver_zero() {\n    assert_match(0);\n}\n\n#[test]\nfn driver_one() {\n    assert_match(1);\n}\n\n#[test]\nfn driver_negative() {\n    assert_match(-1);\n}\n\n#[test]\nfn driver_large() {\n    assert_match(123456);\n}\n\n#[test]\nfn driver_int_min() {\n    assert_match(i32::MIN);\n}\n\n#[test]\nfn driver_int_max() {\n    assert_match(i32::MAX);\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":275,"cache_read_input_tokens":18929,"cache_creation":{"ephemeral_5m_input_tokens":275,"ephemeral_1h_input_tokens":0},"output_tokens":32,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"45826aa5-8546-41a8-842a-ff2b9f3c9fbd","uuid":"9571aae8-e3e6-4c86-ac7d-8e8b9481e852"}
