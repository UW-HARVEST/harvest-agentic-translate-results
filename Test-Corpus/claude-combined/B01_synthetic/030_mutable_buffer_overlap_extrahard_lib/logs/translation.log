{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_etathu7nryl5bmjut5c3xwwdr77axcdbelde5joaephmtl4uug6q","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_011FqsYc7AJsHTfUyhtLF31G","name":"Write","input":{"file_path":"/tmp/harvest-translate-2oL025/translated_rust/tests/ffi_compare.rs","content":"use libloading::{Library, Symbol};\nuse std::os::raw::c_int;\n\nconst C_LIB_PATH: &str = \"c_src/build/libdriver.so\";\nconst RUST_LIB_PATH: &str = \"target/release/libdriver.so\";\n\ntype FmaArrayFn = unsafe extern \"C\" fn(\n    out: *mut c_int,\n    mul1: *const c_int,\n    mul2: *const c_int,\n    add: *const c_int,\n    len: c_int,\n);\n\ntype DriverFn = unsafe extern \"C\" fn(data: *const c_int, len: c_int);\n\nfn load_libs() -> (Library, Library) {\n    unsafe {\n        let c = Library::new(C_LIB_PATH).expect(\"failed to load C lib\");\n        let r = Library::new(RUST_LIB_PATH).expect(\"failed to load Rust lib\");\n        (c, r)\n    }\n}\n\nfn call_fma_array(lib: &Library, mul1: &[c_int], mul2: &[c_int], add: &[c_int]) -> Vec<c_int> {\n    let len = mul1.len();\n    assert_eq!(len, mul2.len());\n    assert_eq!(len, add.len());\n    let mut out = vec![0 as c_int; len];\n    unsafe {\n        let f: Symbol<FmaArrayFn> = lib.get(b\"fma_array\").unwrap();\n        f(\n            out.as_mut_ptr(),\n            mul1.as_ptr(),\n            mul2.as_ptr(),\n            add.as_ptr(),\n            len as c_int,\n        );\n    }\n    out\n}\n\n/// Capture stdout produced by calling `f`. Works for prints from C/Rust libs\n/// because we duplicate the underlying file descriptor 1.\nfn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {\n    use std::io::Read;\n    use std::os::unix::io::FromRawFd;\n\n    unsafe {\n        // Flush rust stdout buffer\n        use std::io::Write;\n        std::io::stdout().flush().ok();\n        // Flush libc stdout to ensure prior content is drained.\n        libc::fflush(std::ptr::null_mut());\n\n        // Save original stdout fd\n        let saved_fd = libc::dup(1);\n        assert!(saved_fd >= 0, \"dup failed\");\n\n        // Create pipe\n        let mut pipefd = [0 as c_int; 2];\n        let r = libc::pipe(pipefd.as_mut_ptr());\n        assert_eq!(r, 0, \"pipe failed\");\n        let read_fd = pipefd[0];\n        let write_fd = pipefd[1];\n\n        // Replace stdout with write end\n        let r = libc::dup2(write_fd, 1);\n        assert!(r >= 0, \"dup2 failed\");\n        libc::close(write_fd);\n\n        // Run the function\n        f();\n\n        // Flush libc stdout\n        libc::fflush(std::ptr::null_mut());\n\n        // Restore stdout\n        let r = libc::dup2(saved_fd, 1);\n        assert!(r >= 0, \"dup2 restore failed\");\n        libc::close(saved_fd);\n\n        // Read from pipe\n        let mut file = std::fs::File::from_raw_fd(read_fd);\n        let mut buf = Vec::new();\n        file.read_to_end(&mut buf).unwrap();\n        buf\n    }\n}\n\nfn call_driver_capture(lib: &Library, data: &[c_int]) -> Vec<u8> {\n    capture_stdout(|| unsafe {\n        let f: Symbol<DriverFn> = lib.get(b\"driver\").unwrap();\n        f(data.as_ptr(), data.len() as c_int);\n    })\n}\n\n#[test]\nfn test_fma_array_basic() {\n    let (c_lib, r_lib) = load_libs();\n    let mul1 = vec![1, 2, 3, 4, 5];\n    let mul2 = vec![10, 20, 30, 40, 50];\n    let add = vec![100, 200, 300, 400, 500];\n    let out_c = call_fma_array(&c_lib, &mul1, &mul2, &add);\n    let out_r = call_fma_array(&r_lib, &mul1, &mul2, &add);\n    assert_eq!(out_c, out_r);\n}\n\n#[test]\nfn test_fma_array_zero_len() {\n    let (c_lib, r_lib) = load_libs();\n    let m1: Vec<c_int> = vec![];\n    let m2: Vec<c_int> = vec![];\n    let a: Vec<c_int> = vec![];\n    let out_c = call_fma_array(&c_lib, &m1, &m2, &a);\n    let out_r = call_fma_array(&r_lib, &m1, &m2, &a);\n    assert_eq!(out_c, out_r);\n}\n\n#[test]\nfn test_fma_array_negative() {\n    let (c_lib, r_lib) = load_libs();\n    let mul1 = vec![-1, -2, -3, 0, 1];\n    let mul2 = vec![5, -5, 7, 0, -1];\n    let add = vec![10, -10, 0, 1, -1];\n    let out_c = call_fma_array(&c_lib, &mul1, &mul2, &add);\n    let out_r = call_fma_array(&r_lib, &mul1, &mul2, &add);\n    assert_eq!(out_c, out_r);\n}\n\n#[test]\nfn test_fma_array_overflow_wrap() {\n    let (c_lib, r_lib) = load_libs();\n    // INT_MAX * 2 overflow scenario - this is technically UB in C but the\n    // generated code typically does wrapping arithmetic. The C side determines\n    // ground truth.\n    let mul1 = vec![100000, 50000, i32::MAX];\n    let mul2 = vec![100000, 50000, 2];\n    let add = vec![0, 0, 0];\n    let out_c = call_fma_array(&c_lib, &mul1, &mul2, &add);\n    let out_r = call_fma_array(&r_lib, &mul1, &mul2, &add);\n    assert_eq!(out_c, out_r);\n}\n\n#[test]\nfn test_driver_basic() {\n    let (c_lib, r_lib) = load_libs();\n    let data = vec![1, 2, 3, 4, 5];\n    let c_out = call_driver_capture(&c_lib, &data);\n    let r_out = call_driver_capture(&r_lib, &data);\n    assert_eq!(c_out, r_out, \"driver output mismatch\");\n}\n\n#[test]\nfn test_driver_negative() {\n    let (c_lib, r_lib) = load_libs();\n    let data = vec![-1, -2, 0, 3, -7];\n    let c_out = call_driver_capture(&c_lib, &data);\n    let r_out = call_driver_capture(&r_lib, &data);\n    assert_eq!(c_out, r_out, \"driver output mismatch\");\n}\n\n#[test]\nfn test_driver_single() {\n    let (c_lib, r_lib) = load_libs();\n    let data = vec![42];\n    let c_out = call_driver_capture(&c_lib, &data);\n    let r_out = call_driver_capture(&r_lib, &data);\n    assert_eq!(c_out, r_out, \"driver output mismatch\");\n}\n\n#[test]\nfn test_driver_zero_length() {\n    let (c_lib, r_lib) = load_libs();\n    let data: Vec<c_int> = vec![];\n    let c_out = call_driver_capture(&c_lib, &data);\n    let r_out = call_driver_capture(&r_lib, &data);\n    assert_eq!(c_out, r_out, \"driver output mismatch\");\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{