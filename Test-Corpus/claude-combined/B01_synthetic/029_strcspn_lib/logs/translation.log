out: RawFd = unsafe { libc::dup(1) };\n    assert!(saved_stdout >= 0);\n\n    // Create a pipe\n    let mut fds = [0 as RawFd; 2];\n    let r = unsafe { libc::pipe(fds.as_mut_ptr()) };\n    assert_eq!(r, 0);\n    let (read_fd, write_fd) = (fds[0], fds[1]);\n\n    // Redirect stdout (fd 1) to write end of pipe\n    let r = unsafe { libc::dup2(write_fd, 1) };\n    assert!(r >= 0);\n    unsafe { libc::close(write_fd) };\n\n    // Run the function\n    f();\n\n    // Flush\n    unsafe {\n        libc::fflush(std::ptr::null_mut());\n    }\n\n    // Restore stdout\n    let r = unsafe { libc::dup2(saved_stdout, 1) };\n    assert!(r >= 0);\n    unsafe { libc::close(saved_stdout) };\n\n    // Read from pipe read end\n    let mut file = unsafe { File::from_raw_fd(read_fd) };\n    let mut output = Vec::new();\n    file.read_to_end(&mut output).unwrap();\n    output\n}\n\nfn run_driver(lib_path: &str, s1: &str, s2: &str) -> Vec<u8> {\n    let lib = unsafe { Library::new(lib_path).expect(\"Failed to load library\") };\n    let driver: Symbol<DriverFn> = unsafe { lib.get(b\"driver\").expect(\"driver symbol missing\") };\n    let cs1 = CString::new(s1).unwrap();\n    let cs2 = CString::new(s2).unwrap();\n\n    capture_stdout(|| unsafe {\n        driver(cs1.as_ptr(), cs2.as_ptr());\n    })\n}\n\nfn check_match(s1: &str, s2: &str) {\n    let c_out = run_driver(C_LIB, s1, s2);\n    let rust_out = run_driver(RUST_LIB, s1, s2);\n    assert_eq!(\n        c_out, rust_out,\n        \"mismatch for s1={:?}, s2={:?}: C={:?}, Rust={:?}\",\n        s1, s2, c_out, rust_out\n    );\n}\n\n#[test]\nfn test_basic() {\n    check_match(\"hello world\", \"lo\");\n}\n\n#[test]\nfn test_no_match() {\n    check_match(\"abcdef\", \"xyz\");\n}\n\n#[test]\nfn test_empty_s1() {\n    check_match(\"\", \"abc\");\n}\n\n#[test]\nfn test_empty_s2() {\n    check_match(\"hello\", \"\");\n}\n\n#[test]\nfn test_first_char_match() {\n    check_match(\"abcdef\", \"a\");\n}\n\n#[test]\nfn test_full_match() {\n    check_match(\"aaaa\", \"a\");\n}\n\n#[test]\nfn test_multi_chars() {\n    check_match(\"This is a test sentence.\", \" .,\");\n}\n\n#[test]\nfn test_special_chars() {\n    check_match(\"\\t\\nhello\", \"\\n\");\n}\n\n#[test]\nfn test_long_string() {\n    let long = \"x\".repeat(1000);\n    check_match(&long, \"y\");\n}\n\n#[test]\nfn test_long_with_match() {\n    let mut s = \"x\".repeat(500);\n    s.push('Z');\n    s.push_str(&\"x\".repeat(500));\n    check_match(&s, \"Z\");\n}\n","structuredPatch":[{"oldStart":3,"oldLines":12,"newStart":3,"newLines":16,"lines":[" use std::fs::File;"," use std::io::Read;"," use std::os::unix::io::{FromRawFd, RawFd};","+use std::sync::Mutex;"," "," const C_LIB: &str = \"c_src/build/libdriver.so\";"," const RUST_LIB: &str = \"target/release/libdriver.so\";"," "," type DriverFn = unsafe extern \"C\" fn(*const c_char, *const c_char);"," ","+// Serialize tests because we redirect the global stdout fd.","+static STDOUT_LOCK: Mutex<()> = Mutex::new(());","+"," /// Capture stdout while running closure `f`"," fn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {","     // Flush libc stdout"]}],"userModified":false,"replaceAll":false}}
