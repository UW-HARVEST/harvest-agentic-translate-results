{ lib.get(b\"driver\").expect(\"driver symbol missing\") };\n    let cs1 = CString::new(s1).unwrap();\n    let cs2 = CString::new(s2).unwrap();\n\n    capture_stdout(|| unsafe {\n        driver(cs1.as_ptr(), cs2.as_ptr());\n    })\n}\n\nfn check_match(s1: &str, s2: &str) {\n    let c_out = run_driver(C_LIB, s1, s2);\n    let rust_out = run_driver(RUST_LIB, s1, s2);\n    assert_eq!(\n        c_out, rust_out,\n        \"mismatch for s1={:?}, s2={:?}: C={:?}, Rust={:?}\",\n        s1, s2, c_out, rust_out\n    );\n}\n\n#[test]\nfn test_basic() {\n    check_match(\"hello world\", \"lo\");\n}\n\n#[test]\nfn test_no_match() {\n    check_match(\"abcdef\", \"xyz\");\n}\n\n#[test]\nfn test_empty_s1() {\n    check_match(\"\", \"abc\");\n}\n\n#[test]\nfn test_empty_s2() {\n    check_match(\"hello\", \"\");\n}\n\n#[test]\nfn test_first_char_match() {\n    check_match(\"abcdef\", \"a\");\n}\n\n#[test]\nfn test_full_match() {\n    check_match(\"aaaa\", \"a\");\n}\n\n#[test]\nfn test_multi_chars() {\n    check_match(\"This is a test sentence.\", \" .,\");\n}\n\n#[test]\nfn test_special_chars() {\n    check_match(\"\\t\\nhello\", \"\\n\");\n}\n\n#[test]\nfn test_long_string() {\n    let long = \"x\".repeat(1000);\n    check_match(&long, \"y\");\n}\n\n#[test]\nfn test_long_with_match() {\n    let mut s = \"x\".repeat(500);\n    s.push('Z');\n    s.push_str(&\"x\".repeat(500));\n    check_match(&s, \"Z\");\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":253,"cache_read_input_tokens":18884,"cache_creation":{"ephemeral_5m_input_tokens":253,"ephemeral_1h_input_tokens":0},"output_tokens":39,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"9bbb2786-4393-429c-966e-484a0dad5d48","uuid":"15fca79f-19c9-4025-a1ef-4e93d77dacd8"}
