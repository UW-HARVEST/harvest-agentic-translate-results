{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_usbitx3rnwih5zkarxx7g7p4eh2ad6elgpnkwhys73sj6qbyznaa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01T61bUg7pWnDcX86XiikvtG","name":"Write","input":{"file_path":"/tmp/harvest-translate-XiZJ3U/translated_rust/tests/ffi_compare.rs","content":"// FFI parity tests: load both the C and Rust shared libraries and assert\n// that `smallestValue` returns identical results for identical inputs.\n\nuse libloading::{Library, Symbol};\nuse std::os::raw::c_int;\nuse std::path::PathBuf;\nuse std::ptr;\n\n#[repr(C)]\nstruct ListNode {\n    value: c_int,\n    next: *mut ListNode,\n}\n\ntype SmallestValueFn = unsafe extern \"C\" fn(*mut ListNode) -> c_int;\n\nfn c_lib_path() -> PathBuf {\n    let mut p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    p.push(\"c_src\");\n    p.push(\"build\");\n    p.push(\"libSimpleList.so\");\n    p\n}\n\nfn rust_lib_path() -> PathBuf {\n    // Cargo sets OUT_DIR for build scripts only; for integration tests we\n    // discover the cdylib next to the test binary.\n    // The integration test runs from target/<profile>/deps/<test>-<hash>,\n    // so the cdylib lives at target/<profile>/libsimplelist.so.\n    let exe = std::env::current_exe().expect(\"current_exe\");\n    // Walk up from .../target/<profile>/deps/<test_bin> to .../target/<profile>/\n    let mut dir = exe\n        .parent()\n        .and_then(|p| p.parent())\n        .expect(\"test exe parent\")\n        .to_path_buf();\n    dir.push(\"libsimplelist.so\");\n    dir\n}\n\nstruct Libs {\n    _c: Library,\n    _rust: Library,\n    c_smallest: SmallestValueFn,\n    rust_smallest: SmallestValueFn,\n}\n\nimpl Libs {\n    fn load() -> Self {\n        unsafe {\n            let c_lib = Library::new(c_lib_path()).expect(\"load C lib\");\n            let rust_lib = Library::new(rust_lib_path()).expect(\"load Rust lib\");\n            let c_sym: Symbol<SmallestValueFn> =\n                c_lib.get(b\"smallestValue\").expect(\"C smallestValue\");\n            let rust_sym: Symbol<SmallestValueFn> =\n                rust_lib.get(b\"smallestValue\").expect(\"Rust smallestValue\");\n            let c_smallest = *c_sym;\n            let rust_smallest = *rust_sym;\n            Libs {\n                _c: c_lib,\n                _rust: rust_lib,\n                c_smallest,\n                rust_smallest,\n            }\n        }\n    }\n}\n\n/// Build a contiguous block of `ListNode`s on the heap from `values`. The\n/// returned `Vec` owns the storage, and node `i.next` points to node `i+1`\n/// (the last node has `next = null`). Returns `(storage, head_ptr)`.\nfn make_list(values: &[c_int]) -> (Vec<ListNode>, *mut ListNode) {\n    if values.is_empty() {\n        return (Vec::new(), ptr::null_mut());\n    }\n    let mut nodes: Vec<ListNode> = values\n        .iter()\n        .map(|&v| ListNode {\n            value: v,\n            next: ptr::null_mut(),\n        })\n        .collect();\n    // Wire up next pointers.\n    let len = nodes.len();\n    let base: *mut ListNode = nodes.as_mut_ptr();\n    for i in 0..len - 1 {\n        unsafe {\n            (*base.add(i)).next = base.add(i + 1);\n        }\n    }\n    let head = base;\n    (nodes, head)\n}\n\nfn check(libs: &Libs, values: &[c_int]) {\n    let (storage, head) = make_list(values);\n    let c_out = unsafe { (libs.c_smallest)(head) };\n    let rust_out = unsafe { (libs.rust_smallest)(head) };\n    assert_eq!(\n        c_out, rust_out,\n        \"mismatch on input {:?}: C={} Rust={}\",\n        values, c_out, rust_out\n    );\n    drop(storage);\n}\n\n#[test]\nfn null_pointer_returns_minus_one() {\n    let libs = Libs::load();\n    let c_out = unsafe { (libs.c_smallest)(ptr::null_mut()) };\n    let rust_out = unsafe { (libs.rust_smallest)(ptr::null_mut()) };\n    assert_eq!(c_out, -1);\n    assert_eq!(rust_out, -1);\n}\n\n#[test]\nfn single_element() {\n    let libs = Libs::load();\n    for v in [0, 1, -1, 42, i32::MIN, i32::MAX] {\n        check(&libs, &[v]);\n    }\n}\n\n#[test]\nfn ascending_descending_mixed() {\n    let libs = Libs::load();\n    check(&libs, &[1, 2, 3, 4, 5]);\n    check(&libs, &[5, 4, 3, 2, 1]);\n    check(&libs, &[3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5]);\n    check(&libs, &[-10, -20, -30, -5, 0, 100]);\n    check(&libs, &[7, 7, 7, 7]);\n}\n\n#[test]\nfn extremes() {\n    let libs = Libs::load();\n    check(&libs, &[i32::MIN, i32::MAX, 0]);\n    check(&libs, &[i32::MAX, i32::MAX, i32::MIN]);\n    check(&libs, &[0, 0, 0, i32::MIN]);\n}\n\n#[test]\nfn longer_random_like() {\n    let libs = Libs::load();\n    let mut v: Vec<c_int> = (0..1000).map(|i| ((i * 2654435761u32) as i32) ^ i).collect();\n    check(&libs, &v);\n    v.reverse();\n    check(&libs, &v);\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":162,"cache_read_input_tokens":19144,"cache_creation":{"ephemeral_5m_input_tokens":162,"ephemeral_1h_input_tokens":0},"output_tokens":22,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"48e091c4-e6e3-418f-99e0-3a45e779ceb0","uuid":"dcf75f22-76a4-42f5-9f6e-07c2395a56b3"}
