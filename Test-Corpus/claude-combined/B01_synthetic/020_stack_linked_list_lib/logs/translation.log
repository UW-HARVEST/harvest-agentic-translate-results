ut,\n        \"mismatch on input {:?}: C={} Rust={}\",\n        values, c_out, rust_out\n    );\n    drop(storage);\n}\n\n#[test]\nfn null_pointer_returns_minus_one() {\n    let libs = Libs::load();\n    let c_out = unsafe { (libs.c_smallest)(ptr::null_mut()) };\n    let rust_out = unsafe { (libs.rust_smallest)(ptr::null_mut()) };\n    assert_eq!(c_out, -1);\n    assert_eq!(rust_out, -1);\n}\n\n#[test]\nfn single_element() {\n    let libs = Libs::load();\n    for v in [0, 1, -1, 42, i32::MIN, i32::MAX] {\n        check(&libs, &[v]);\n    }\n}\n\n#[test]\nfn ascending_descending_mixed() {\n    let libs = Libs::load();\n    check(&libs, &[1, 2, 3, 4, 5]);\n    check(&libs, &[5, 4, 3, 2, 1]);\n    check(&libs, &[3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5]);\n    check(&libs, &[-10, -20, -30, -5, 0, 100]);\n    check(&libs, &[7, 7, 7, 7]);\n}\n\n#[test]\nfn extremes() {\n    let libs = Libs::load();\n    check(&libs, &[i32::MIN, i32::MAX, 0]);\n    check(&libs, &[i32::MAX, i32::MAX, i32::MIN]);\n    check(&libs, &[0, 0, 0, i32::MIN]);\n}\n\n#[test]\nfn longer_random_like() {\n    let libs = Libs::load();\n    let mut v: Vec<c_int> = (0..1000).map(|i| ((i * 2654435761u32) as i32) ^ i).collect();\n    check(&libs, &v);\n    v.reverse();\n    check(&libs, &v);\n}\n","structuredPatch":[{"oldStart":142,"oldLines":7,"newStart":142,"newLines":8,"lines":[" #[test]"," fn longer_random_like() {","     let libs = Libs::load();","-    let mut v: Vec<c_int> = (0..1000).map(|i| ((i * 2654435761u32) as i32) ^ i).collect();","+    let mut v: Vec<c_int> =","+        (0u32..1000).map(|i| ((i.wrapping_mul(2654435761u32)) ^ i) as i32).collect();","     check(&libs, &v);","     v.reverse();","     check(&libs, &v);"]}],"userModified":false,"replaceAll":false}}
