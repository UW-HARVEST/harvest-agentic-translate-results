        } else {\n            break;\n        }\n    }\n\n    let mut negative = false;\n    if i < bytes.len() && (bytes[i] == b'+' || bytes[i] == b'-') {\n        negative = bytes[i] == b'-';\n        i += 1;\n    }\n\n    let digits_start = i;\n    let mut acc: i64 = 0;\n    let mut overflow = false;\n    while i < bytes.len() && bytes[i].is_ascii_digit() {\n        let d = (bytes[i] - b'0') as i64;\n        if !overflow {\n            // Track overflow against C `long` (assume 64-bit on Linux x86_64).\n            // For values that would overflow long, strtol clamps and sets errno=ERANGE.\n            acc = acc.saturating_mul(10).saturating_add(d);\n            if acc == i64::MAX {\n                // potential overflow flag\n                // We'll detect actual overflow by checking magnitude after parse.\n            }\n        }\n        // continue scanning all digits regardless to advance endp\n        if let Some(next) = acc.checked_mul(1) {\n            let _ = next;\n        }\n        i += 1;\n        // Detect overflow more precisely: if multiplied/added past i64 range\n        // Simpler: re-parse using i128 below.\n        let _ = overflow;\n    }\n\n    if i == digits_start {\n        // No digits consumed; in C, this means endp == str (after the optional sign,\n        // strtol still treats no-digits as no conversion and sets endp = original str).\n        return None;\n    }\n\n    // Re-parse using i128 to detect overflow against `long` (i64) and then i32 range.\n    let digit_str = std::str::from_utf8(&bytes[digits_start..i]).ok()?;\n    let mut val: i128 = 0;\n    for ch in digit_str.bytes() {\n        val = val * 10 + (ch - b'0') as i128;\n        if val > (i64::MAX as i128) + 1 {\n            // Overflow against long; emulate strtol clamping + ERANGE => errno != 0 => fail\n            return None;\n        }\n    }\n    let signed: i128 = if negative { -val } else { val };\n\n    if signed < i64::MIN as i128 || signed > i64::MAX as i128 {\n        return None;\n    }\n    if signed < i32::MIN as i128 || signed > i32::MAX as i128 {\n        return None;\n    }\n    Some(signed as i32)\n}\n\nfn main() {\n    // Replicate `fgets(in, 100, stdin)`: read up to 99 bytes or until newline (inclusive),\n    // then NUL-terminate. We don't need a NUL, but we must stop at the first newline\n    // and limit to 99 bytes of payload.\n    let mut buf = [0u8; 99];\n    let mut len = 0usize;\n    let stdin = io::stdin();\n    let mut handle = stdin.lock();\n    let mut byte = [0u8; 1];\n    while len < buf.len() {\n        match handle.read(&mut byte) {\n            Ok(0) => break, // EOF\n            Ok(_) => {\n                buf[len] = byte[0];\n                len += 1;\n                if byte[0] == b'\\n' {\n                    break;\n                }\n            }\n            Err(_) => break,\n        }\n    }\n\n    let s = std::str::from_utf8(&buf[..len]).unwrap_or(\"\");\n    let stdout = io::stdout();\n    let mut out = stdout.lock();\n\n    if let Some(x) = parse_val(s) {\n        let mut the_house = House {\n            floors: 2,\n            bedrooms: 5,\n            bathrooms: 2.5,\n        };\n        run(&mut the_house, x);\n        run(&mut the_house, x);\n    } else {\n        writeln!(out, \"An error occurred\").unwrap();\n    }\n}\n","userModified":false}}
