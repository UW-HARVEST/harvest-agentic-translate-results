      f();\n\n        // flush the C library so all data hits the file\n        fflush(stdout);\n        // restore stdout\n        dup2(saved, STDOUT_FILENO);\n        close(saved);\n    }\n    fs::read_to_string(path).expect(\"read captured stdout\")\n}\n\nfn run_driver(lib_path: &str, value: c_double, capture_path: &str) -> String {\n    let lib = unsafe { Library::new(lib_path).expect(\"failed to load library\") };\n    let driver: Symbol<unsafe extern \"C\" fn(c_double)> =\n        unsafe { lib.get(b\"driver\").expect(\"missing `driver` symbol\") };\n    capture_stdout(capture_path, || unsafe { driver(value) })\n}\n\nfn compare_for(value: c_double) {\n    let tmp = std::env::temp_dir();\n    let c_out = tmp.join(format!(\"driver_c_{:x}.txt\", value.to_bits()));\n    let r_out = tmp.join(format!(\"driver_r_{:x}.txt\", value.to_bits()));\n    let c_out_s = c_out.to_string_lossy().to_string();\n    let r_out_s = r_out.to_string_lossy().to_string();\n\n    let c_text = run_driver(C_LIB, value, &c_out_s);\n    let r_text = run_driver(RUST_LIB, value, &r_out_s);\n\n    assert_eq!(\n        c_text, r_text,\n        \"mismatch for {:?} (bits {:#x})\\nC:    {:?}\\nRust: {:?}\",\n        value,\n        value.to_bits(),\n        c_text,\n        r_text\n    );\n}\n\n#[test]\nfn driver_basic_values() {\n    let cases: &[f64] = &[\n        0.0,\n        -0.0,\n        1.0,\n        -1.0,\n        3.14159265358979,\n        -2.718281828,\n        1.5,\n        0.1,\n        100.0,\n        -1234.5678,\n        f64::MIN_POSITIVE,\n        1e-10,\n        1e10,\n        1e100,\n        -1e-100,\n    ];\n    for &v in cases {\n        compare_for(v);\n    }\n}\n\n#[test]\nfn driver_special_values() {\n    // The %a format on infinities/NaN may produce platform-specific output but\n    // both libraries link to the same libc, so behavior should match exactly.\n    let cases: &[f64] = &[f64::INFINITY, f64::NEG_INFINITY, f64::NAN];\n    for &v in cases {\n        compare_for(v);\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
