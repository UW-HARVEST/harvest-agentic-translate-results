{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_ojwuyyykrm5ldyksuuzfoso4mlnz4bog65h37wb77b5nxneszpla","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01NkqS2mzupg6JTYzt5TqJxU","name":"Write","input":{"file_path":"/tmp/harvest-translate-qDROyh/translated_rust/tests/ffi_compare.rs","content":"// Compare C and Rust .so outputs via FFI through libloading.\n// We capture stdout for printLine/driver since they call printf.\n\nuse libloading::{Library, Symbol};\nuse std::ffi::CString;\nuse std::fs;\nuse std::io::{Read, Seek, SeekFrom};\nuse std::os::raw::{c_char, c_int};\nuse std::sync::Mutex;\n\n// Stdout is a process-wide resource — serialize tests that capture it.\nstatic STDOUT_LOCK: Mutex<()> = Mutex::new(());\n\nfn c_so_path() -> &'static str {\n    \"c_src/build/libdriver.so\"\n}\n\nfn rust_so_path() -> &'static str {\n    // cargo test builds the cdylib into target/debug/\n    if std::path::Path::new(\"target/release/libdriver.so\").exists() {\n        \"target/release/libdriver.so\"\n    } else {\n        \"target/debug/libdriver.so\"\n    }\n}\n\n/// Capture stdout produced while invoking `f` (which is expected to call into C/printf).\n/// Uses dup2 to redirect fd 1 to a temp file, then reads back.\nfn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {\n    let _guard = STDOUT_LOCK.lock().unwrap();\n\n    // Flush any pending stdout from Rust side\n    use std::io::Write;\n    let _ = std::io::stdout().flush();\n    // Also flush libc stdout\n    unsafe {\n        extern \"C\" {\n            fn fflush(stream: *mut core::ffi::c_void) -> c_int;\n        }\n        fflush(std::ptr::null_mut());\n    }\n\n    // Create a temp file for capture\n    let dir = std::env::temp_dir();\n    let path = dir.join(format!(\n        \"ffi_capture_{}_{}.txt\",\n        std::process::id(),\n        std::time::SystemTime::now()\n            .duration_since(std::time::UNIX_EPOCH)\n            .unwrap()\n            .as_nanos()\n    ));\n    let mut tmp = fs::OpenOptions::new()\n        .read(true)\n        .write(true)\n        .create(true)\n        .truncate(true)\n        .open(&path)\n        .expect(\"open tmp\");\n\n    // Save original stdout and dup\n    use std::os::unix::io::AsRawFd;\n    let saved = unsafe { libc::dup(1) };\n    assert!(saved >= 0, \"dup failed\");\n    let tmp_fd = tmp.as_raw_fd();\n    unsafe {\n        let r = libc::dup2(tmp_fd, 1);\n        assert!(r >= 0);\n    }\n\n    f();\n\n    // Flush again\n    let _ = std::io::stdout().flush();\n    unsafe {\n        extern \"C\" {\n            fn fflush(stream: *mut core::ffi::c_void) -> c_int;\n        }\n        fflush(std::ptr::null_mut());\n    }\n\n    // Restore\n    unsafe {\n        let r = libc::dup2(saved, 1);\n        assert!(r >= 0);\n        libc::close(saved);\n    }\n\n    // Read the file\n    tmp.seek(SeekFrom::Start(0)).unwrap();\n    let mut buf = Vec::new();\n    tmp.read_to_end(&mut buf).unwrap();\n    drop(tmp);\n    let _ = fs::remove_file(&path);\n    buf\n}\n\nfn run_print_line(lib: &Library, s: Option<&str>) -> Vec<u8> {\n    type PrintLineFn = unsafe extern \"C\" fn(*const c_char);\n    let func: Symbol<PrintLineFn> = unsafe { lib.get(b\"printLine\\0\").expect(\"printLine symbol\") };\n    let cstr_storage;\n    let ptr: *const c_char = match s {\n        Some(t) => {\n            cstr_storage = CString::new(t).unwrap();\n            cstr_storage.as_ptr()\n        }\n        None => std::ptr::null(),\n    };\n    capture_stdout(|| unsafe { func(ptr) })\n}\n\nfn run_driver(lib: &Library, data: c_int) -> Vec<u8> {\n    type DriverFn = unsafe extern \"C\" fn(c_int);\n    let func: Symbol<DriverFn> = unsafe { lib.get(b\"driver\\0\").expect(\"driver symbol\") };\n    capture_stdout(|| unsafe { func(data) })\n}\n\n#[test]\nfn print_line_basic() {\n    let c = unsafe { Library::new(c_so_path()).expect(\"load C so\") };\n    let r = unsafe { Library::new(rust_so_path()).expect(\"load Rust so\") };\n\n    for s in &[\"\", \"hello\", \"a\", \"AAAAAAA\", \"with spaces and !@#\"] {\n        let c_out = run_print_line(&c, Some(s));\n        let r_out = run_print_line(&r, Some(s));\n        assert_eq!(c_out, r_out, \"printLine({:?}) mismatch\", s);\n    }\n}\n\n#[test]\nfn print_line_null() {\n    let c = unsafe { Library::new(c_so_path()).expect(\"load C so\") };\n    let r = unsafe { Library::new(rust_so_path()).expect(\"load Rust so\") };\n    let c_out = run_print_line(&c, None);\n    let r_out = run_print_line(&r, None);\n    assert_eq!(c_out, r_out);\n    assert!(c_out.is_empty());\n}\n\n#[test]\nfn driver_various_data() {\n    let c = unsafe { Library::new(c_so_path()).expect(\"load C so\") };\n    let r = unsafe { Library::new(rust_so_path()).expect(\"load Rust so\") };\n\n    // data == 0: copies 0 bytes, then dest[0] = '\\0' -> empty string\n    // data within [1..99]: copies that many 'A's\n    // data == 100 or larger: skips the if-branch, dest stays \"\" (empty string)\n    for &d in &[0i32, 1, 5, 50, 99, 100, 101, 1000] {\n        let c_out = run_driver(&c, d);\n        let r_out = run_driver(&r, d);\n        assert_eq!(c_out, r_out, \"driver({}) mismatch\", d);\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":334,"cache_read_input_tokens":19009,"cache_creation":{"ephemeral_5m_input_tokens":334,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"5eed5125-8423-485c-a07b-902c21c3f8e9","uuid":"84377ffd-8600-4b84-b19a-9b235e38849c"}
