{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_rvlvdfrmmhxzfqtrh6buu3puetq7jg44p7gr2wlrfefyhn767nrq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01J255GYAMi9dw6W7qhPjgyz","name":"Write","input":{"file_path":"/tmp/harvest-translate-MSvKYr/translated_rust/tests/ffi_compare.rs","content":"use libloading::{Library, Symbol};\nuse std::ffi::{c_char, CStr, CString};\nuse std::path::PathBuf;\n\ntype SearchAndReplaceFn =\n    unsafe extern \"C\" fn(*const c_char, *const c_char, *const c_char) -> *mut c_char;\n\n// We need libc::free to deallocate the returned strings, since both libraries\n// allocate via malloc/realloc/strdup.\nextern \"C\" {\n    fn free(ptr: *mut std::ffi::c_void);\n}\n\nfn c_lib_path() -> PathBuf {\n    let mut p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    p.push(\"c_src\");\n    p.push(\"build\");\n    p.push(\"libdriver.so\");\n    p\n}\n\nfn rust_lib_path() -> PathBuf {\n    let mut p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    p.push(\"target\");\n    // cargo test in default profile builds debug, but cdylib is also produced\n    // in debug. Try debug first, then release.\n    let debug_path = {\n        let mut q = p.clone();\n        q.push(\"debug\");\n        q.push(\"libdriver.so\");\n        q\n    };\n    if debug_path.exists() {\n        return debug_path;\n    }\n    p.push(\"release\");\n    p.push(\"libdriver.so\");\n    p\n}\n\nunsafe fn call_and_collect(\n    sym: &Symbol<SearchAndReplaceFn>,\n    orig: &str,\n    search: &str,\n    value: &str,\n) -> Option<Vec<u8>> {\n    let c_orig = CString::new(orig).unwrap();\n    let c_search = CString::new(search).unwrap();\n    let c_value = CString::new(value).unwrap();\n    let result = sym(c_orig.as_ptr(), c_search.as_ptr(), c_value.as_ptr());\n    if result.is_null() {\n        return None;\n    }\n    let bytes = CStr::from_ptr(result).to_bytes().to_vec();\n    free(result as *mut std::ffi::c_void);\n    Some(bytes)\n}\n\nfn run_case(orig: &str, search: &str, value: &str) {\n    unsafe {\n        let c_lib = Library::new(c_lib_path()).expect(\"load C lib\");\n        let rust_lib = Library::new(rust_lib_path()).expect(\"load Rust lib\");\n        let c_fn: Symbol<SearchAndReplaceFn> = c_lib.get(b\"searchAndReplace\").unwrap();\n        let rust_fn: Symbol<SearchAndReplaceFn> = rust_lib.get(b\"searchAndReplace\").unwrap();\n\n        let c_out = call_and_collect(&c_fn, orig, search, value);\n        let rust_out = call_and_collect(&rust_fn, orig, search, value);\n        assert_eq!(\n            c_out, rust_out,\n            \"mismatch for orig={:?}, search={:?}, value={:?}\",\n            orig, search, value\n        );\n    }\n}\n\n#[test]\nfn no_match_returns_copy() {\n    run_case(\"hello world\", \"xyz\", \"abc\");\n}\n\n#[test]\nfn empty_orig_no_match() {\n    // search is non-empty so strstr finds nothing in empty orig => strdup(\"\")\n    run_case(\"\", \"x\", \"y\");\n}\n\n#[test]\nfn single_match_at_start() {\n    run_case(\"foobar\", \"foo\", \"BAZ\");\n}\n\n#[test]\nfn single_match_at_end() {\n    run_case(\"hellofoo\", \"foo\", \"BAZ\");\n}\n\n#[test]\nfn single_match_in_middle() {\n    run_case(\"hellofoworld\", \"fo\", \"BAR\");\n}\n\n#[test]\nfn multiple_matches_no_gap() {\n    run_case(\"aaaa\", \"a\", \"b\");\n}\n\n#[test]\nfn multiple_matches_with_gaps() {\n    run_case(\"foo123foo456foo\", \"foo\", \"X\");\n}\n\n#[test]\nfn replace_with_longer() {\n    run_case(\"a-b-c\", \"-\", \"===\");\n}\n\n#[test]\nfn replace_with_shorter() {\n    run_case(\"aaa===bbb===ccc\", \"===\", \"+\");\n}\n\n#[test]\nfn replace_with_empty() {\n    run_case(\"hello world hello\", \"hello\", \"\");\n}\n\n#[test]\nfn search_at_boundary() {\n    run_case(\"xxhelloyyhello\", \"hello\", \"ZZ\");\n}\n\n#[test]\nfn whole_string_is_match() {\n    run_case(\"foo\", \"foo\", \"BAR\");\n}\n\n#[test]\nfn overlapping_pattern_search() {\n    // \"aa\" appears at indices 0, 2, 4 in \"aaaaaa\"; non-overlapping behavior of strstr\n    run_case(\"aaaaaa\", \"aa\", \"Z\");\n}\n\n#[test]\nfn pattern_partial_at_end() {\n    run_case(\"hellofo\", \"foo\", \"X\");\n}\n\n#[test]\nfn many_consecutive_matches() {\n    run_case(\"ababababab\", \"ab\", \"CD\");\n}\n\n#[test]\nfn long_input_many_replacements() {\n    let orig = \"the quick brown fox jumps over the lazy dog. the fox is fast.\";\n    run_case(orig, \"the\", \"THE\");\n    run_case(orig, \"fox\", \"cat\");\n    run_case(orig, \" \", \"_\");\n    run_case(orig, \".\", \"!\");\n}\n\n#[test]\nfn unicode_bytes() {\n    // Non-ASCII bytes still work since strstr is byte-oriented (multibyte safe\n    // for UTF-8 since UTF-8 has the self-sync property).\n    run_case(\"héllo wörld héllo\", \"héllo\", \"BYE\");\n}\n\n#[test]\nfn replacement_contains_search() {\n    // Make sure we don't recursively replace inserted \"search\" tokens.\n    run_case(\"xx\", \"x\", \"xx\");\n}\n\n#[test]\nfn no_match_empty_inputs() {\n    // search \"\" - strstr of empty needle returns the haystack, exercising the\n    // matching branch with zero-length needle.\n    run_case(\"hello\", \"\", \"X\");\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":170,"cache_read_input_tokens":19838,"cache_creation":{"ephemeral_5m_input_tokens":170,"ephemeral_1h_input_tokens":0},"output_tokens":22,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"c471cb56-dc63-4a10-939b-94d49b5f9c8b","uuid":"3a77d870-0f2d-4e7a-8f5d-59233e743421"}
