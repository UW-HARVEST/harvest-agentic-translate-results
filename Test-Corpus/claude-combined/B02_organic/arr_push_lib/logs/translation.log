{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_4z5qgu5pynjtck2lul2krnwmuyuc7khmnywvcaxuyd2wbfwxwn7q","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01T85to1qcX25aFHueMmF9S1","name":"Write","input":{"file_path":"/tmp/harvest-translate-q58veN/translated_rust/tests/ffi_compare.rs","content":"// FFI integration tests comparing C and Rust .so outputs side-by-side.\n//\n// Both libraries are loaded via libloading and exercised through the\n// same exported symbols. We never call Rust functions directly here.\n\nuse libloading::{Library, Symbol};\nuse std::ffi::{c_char, c_int, c_void};\nuse std::ptr;\n\nconst C_LIB: &str = \"c_src/build/libtranslated_rust.so\";\nconst RUST_LIB: &str = \"target/release/libtranslated_rust.so\";\n\n// ---------- Type signatures we import from each .so ----------\ntype FnRandSeed = unsafe extern \"C\" fn(usize);\ntype FnHashString = unsafe extern \"C\" fn(*mut c_char, usize) -> usize;\ntype FnHashBytes = unsafe extern \"C\" fn(*mut c_void, usize, usize) -> usize;\ntype FnArrgrowf = unsafe extern \"C\" fn(*mut c_void, usize, usize, usize) -> *mut c_void;\ntype FnArrfreef = unsafe extern \"C\" fn(*mut c_void);\ntype FnArrPush = unsafe extern \"C\" fn(c_int);\ntype FnStrkey = unsafe extern \"C\" fn(c_int) -> *mut c_char;\ntype FnHmputKey = unsafe extern \"C\" fn(*mut c_void, usize, *mut c_void, usize, c_int) -> *mut c_void;\ntype FnHmgetKey = unsafe extern \"C\" fn(*mut c_void, usize, *mut c_void, usize, c_int) -> *mut c_void;\ntype FnHmgetKeyTs = unsafe extern \"C\" fn(*mut c_void, usize, *mut c_void, usize, *mut isize, c_int) -> *mut c_void;\ntype FnHmdelKey = unsafe extern \"C\" fn(*mut c_void, usize, *mut c_void, usize, usize, c_int) -> *mut c_void;\ntype FnHmfreeFunc = unsafe extern \"C\" fn(*mut c_void, usize);\ntype FnShmodeFunc = unsafe extern \"C\" fn(usize, c_int) -> *mut c_void;\ntype FnHmputDefault = unsafe extern \"C\" fn(*mut c_void, usize) -> *mut c_void;\n\n#[repr(C)]\n#[derive(Copy, Clone, Debug, PartialEq, Eq)]\npub struct ArrayHeader {\n    pub length: usize,\n    pub capacity: usize,\n    pub hash_table: *mut c_void,\n    pub temp: isize,\n}\n\nunsafe fn header(t: *mut c_void) -> *mut ArrayHeader {\n    unsafe { (t as *mut ArrayHeader).offset(-1) }\n}\n\nfn load_lib(path: &str) -> Library {\n    unsafe { Library::new(path) }.unwrap_or_else(|e| panic!(\"load {path}: {e}\"))\n}\n\n#[test]\nfn test_libs_load() {\n    let _c = load_lib(C_LIB);\n    let _r = load_lib(RUST_LIB);\n}\n\n#[test]\nfn test_hash_string_matches() {\n    let c = load_lib(C_LIB);\n    let r = load_lib(RUST_LIB);\n    unsafe {\n        let cf: Symbol<FnHashString> = c.get(b\"stbds_hash_string\").unwrap();\n        let rf: Symbol<FnHashString> = r.get(b\"stbds_hash_string\").unwrap();\n\n        let cases: &[(&[u8], usize)] = &[\n            (b\"\\0\", 0),\n            (b\"hello\\0\", 0),\n            (b\"a\\0\", 1),\n            (b\"foobar baz quux\\0\", 0xdeadbeef),\n            (b\"this is a longer string for testing\\0\", 0x123456789abcdef0),\n            (b\"x\\0\", 0xffffffffffffffff),\n        ];\n\n        for (s, seed) in cases {\n            let p = s.as_ptr() as *mut c_char;\n            let cv = cf(p, *seed);\n            let rv = rf(p, *seed);\n            assert_eq!(cv, rv, \"stbds_hash_string mismatch for {:?} seed {:#x}\", s, seed);\n        }\n    }\n}\n\n#[test]\nfn test_hash_bytes_matches() {\n    let c = load_lib(C_LIB);\n    let r = load_lib(RUST_LIB);\n    unsafe {\n        let cf: Symbol<FnHashBytes> = c.get(b\"stbds_hash_bytes\").unwrap();\n        let rf: Symbol<FnHashBytes> = r.get(b\"stbds_hash_bytes\").unwrap();\n\n        // Test various input lengths to cover all switch fall-through cases\n        let mut buf = [0u8; 64];\n        for i in 0..buf.len() {\n            buf[i] = (i as u8).wrapping_mul(17).wrapping_add(3);\n        }\n        for len in 0..=24usize {\n            for &seed in &[0usize, 1, 0x1234, 0xdeadbeef, 0x31415926, usize::MAX] {\n                let p = buf.as_ptr() as *mut c_void;\n                let cv = cf(p, len, seed);\n                let rv = rf(p, len, seed);\n                assert_eq!(cv, rv, \"stbds_hash_bytes mismatch len={len} seed={seed:#x}\");\n            }\n        }\n    }\n}\n\n#[test]\nfn test_strkey_matches() {\n    let c = load_lib(C_LIB);\n    let r = load_lib(RUST_LIB);\n    unsafe {\n        let cf: Symbol<FnStrkey> = c.get(b\"strkey\").unwrap();\n        let rf: Symbol<FnStrkey> = r.get(b\"strkey\").unwrap();\n\n        for n in &[0i32, 1, -1, 42, 1000, 1234567, i32::MAX, i32::MIN] {\n            let cp = cf(*n);\n            let rp = rf(*n);\n            // compare the returned C strings\n            let c_bytes = std::ffi::CStr::from_ptr(cp).to_bytes();\n            let r_bytes = std::ffi::CStr::from_ptr(rp).to_bytes();\n            assert_eq!(c_bytes, r_bytes, \"strkey({}) differs\", n);\n        }\n    }\n}\n\n#[test]\nfn test_arrgrowf_then_free() {\n    let c = load_lib(C_LIB);\n    let r = load_lib(RUST_LIB);\n    unsafe {\n        let c_grow: Symbol<FnArrgrowf> = c.get(b\"stbds_arrgrowf\").unwrap();\n        let c_free: Symbol<FnArrfreef> = c.get(b\"stbds_arrfreef\").unwrap();\n        let r_grow: Symbol<FnArrgrowf> = r.get(b\"stbds_arrgrowf\").unwrap();\n        let r_free: Symbol<FnArrfreef> = r.get(b\"stbds_arrfreef\").unwrap();\n\n        // Grow each side, check that header.length=0, header.capacity=min_cap=4 (since min_cap<4)\n        for &n in &[0usize, 1, 4, 8, 32] {\n            let ca = c_grow(ptr::null_mut(), 4, n, 0);\n            let ra = r_grow(ptr::null_mut(), 4, n, 0);\n\n            let ch = header(ca);\n            let rh = header(ra);\n            assert_eq!((*ch).length, (*rh).length);\n            assert_eq!((*ch).capacity, (*rh).capacity);\n\n            c_free(ca);\n            r_free(ra);\n        }\n\n        // Grow incrementally to test resizing\n        let mut ca: *mut c_void = ptr::null_mut();\n        let mut ra: *mut c_void = ptr::null_mut();\n        for i in 0..50 {\n            // arrmaybegrow logic: if (!a) || length+1 > capacity, then grow.\n            let need_grow_c = ca.is_null() || (*header(ca)).length + 1 > (*header(ca)).capacity;\n            let need_grow_r = ra.is_null() || (*header(ra)).length + 1 > (*header(ra)).capacity;\n            assert_eq!(need_grow_c, need_grow_r);\n            if need_grow_c {\n                ca = c_grow(ca, 4, 1, 0);\n                ra = r_grow(ra, 4, 1, 0);\n                assert_eq!((*header(ca)).capacity, (*header(ra)).capacity);\n            }\n            // Append\n            let cap_c = (*header(ca)).capacity;\n            let cap_r = (*header(ra)).capacity;\n            let len_c = (*header(ca)).length;\n            let len_r = (*header(ra)).length;\n            assert_eq!(cap_c, cap_r);\n            assert_eq!(len_c, len_r);\n            *((ca as *mut i32).add(len_c)) = i;\n            *((ra as *mut i32).add(len_r)) = i;\n            (*header(ca)).length = len_c + 1;\n            (*header(ra)).length = len_r + 1;\n        }\n        // Compare buffer contents\n        let len = (*header(ca)).length;\n        for i in 0..len {\n            assert_eq!(*((ca as *mut i32).add(i)), *((ra as *mut i32).add(i)));\n        }\n        c_free(ca);\n        r_free(ra);\n    }\n}\n\n#[test]\nfn test_arr_push() {\n    // arr_push has no return value, but we want to be sure it doesn't crash\n    // and behaves identically (both should work with same inputs).\n    let c = load_lib(C_LIB);\n    let r = load_lib(RUST_LIB);\n    unsafe {\n        let cf: Symbol<FnArrPush> = c.get(b\"arr_push\").unwrap();\n        let rf: Symbol<FnArrPush> = r.get(b\"arr_push\").unwrap();\n        for &n in &[0i32, 10, 100, 250, 500] {\n            cf(n);\n            rf(n);\n        }\n    }\n}\n\n// Test the hashmap put/get/del flow with binary keys.\n// This exercises stbds_hmput_key, stbds_hmget_key, stbds_hmdel_key, stbds_hmfree_func.\n#[repr(C)]\n#[derive(Copy, Clone, Default)]\nstruct IntKV {\n    key: i32,\n    _pad: i32, // 8-byte align so {i32 key, i32 value}\n    value: i64,\n}\n\n#[test]\nfn test_hmap_int_keys() {\n    let c = load_lib(C_LIB);\n    let r = load_lib(RUST_LIB);\n    unsafe {\n        let c_seed: Symbol<FnRandSeed> = c.get(b\"stbds_rand_seed\").unwrap();\n        let r_seed: Symbol<FnRandSeed> = r.get(b\"stbds_rand_seed\").unwrap();\n        c_seed(0x31415926);\n        r_seed(0x31415926);\n\n        let c_put: Symbol<FnHmputKey> = c.get(b\"stbds_hmput_key\").unwrap();\n        let r_put: Symbol<FnHmputKey> = r.get(b\"stbds_hmput_key\").unwrap();\n        let c_get: Symbol<FnHmgetKeyTs> = c.get(b\"stbds_hmget_key_ts\").unwrap();\n        let r_get: Symbol<FnHmgetKeyTs> = r.get(b\"stbds_hmget_key_ts\").unwrap();\n        let c_del: Symbol<FnHmdelKey> = c.get(b\"stbds_hmdel_key\").unwrap();\n        let r_del: Symbol<FnHmdelKey> = r.get(b\"stbds_hmdel_key\").unwrap();\n        let c_free: Symbol<FnHmfreeFunc> = c.get(b\"stbds_hmfree_func\").unwrap();\n        let r_free: Symbol<FnHmfreeFunc> = r.get(b\"stbds_hmfree_func\").unwrap();\n\n        let elemsize = std::mem::size_of::<IntKV>();\n        let keysize = 4usize;\n\n        let mut ca: *mut c_void = ptr::null_mut();\n        let mut ra: *mut c_void = ptr::null_mut();\n\n        // Insert keys 0..30\n        for i in 0..30i32 {\n            let mut k = i;\n            let key_ptr = &mut k as *mut i32 as *mut c_void;\n            ca = c_put(ca, elemsize, key_ptr, keysize, 0);\n            ra = r_put(ra, elemsize, key_ptr, keysize, 0);\n            // After put, write value at the slot indicated by header.temp+1\n            let c_idx = (*header(ca as *mut c_void).cast::<ArrayHeader>().sub(0)).temp;\n            let r_idx = (*header(ra as *mut c_void).cast::<ArrayHeader>().sub(0)).temp;\n            // header is at hash_to_arr position\n            // Note: hmput_key returns the hash-side pointer; the array header is at -1 of (a-elemsize)\n            // We've used header() which is pointer cast offset -1. But the array header lives at\n            // -1 of the underlying raw_a (the array side). So we need to step back elemsize first.\n            let c_raw = (ca as *mut u8).sub(elemsize) as *mut c_void;\n            let r_raw = (ra as *mut u8).sub(elemsize) as *mut c_void;\n            let c_idx2 = (*header(c_raw)).temp;\n            let r_idx2 = (*header(r_raw)).temp;\n            assert_eq!(c_idx2, r_idx2, \"temp index mismatch for key {}\", i);\n            let _ = c_idx;\n            let _ = r_idx;\n\n            // Set key+value at slot (c_idx2+1) — the table is 1-indexed in the underlying array\n            // (offset 0 is the \"default\" slot).\n            let slot = (c_idx2 + 1) as usize;\n            let c_kv = (ca as *mut IntKV).add(slot - 1);\n            let r_kv = (ra as *mut IntKV).add(slot - 1);\n            (*c_kv).key = i;\n            (*c_kv).value = (i as i64) * 1000;\n            (*r_kv).key = i;\n            (*r_kv).value = (i as i64) * 1000;\n        }\n\n        // Look up keys\n        for i in 0..30i32 {\n            let mut k = i;\n            let key_ptr = &mut k as *mut i32 as *mut c_void;\n            let mut c_temp: isize = 0;\n            let mut r_temp: isize = 0;\n            ca = c_get(ca, elemsize, key_ptr, keysize, &mut c_temp, 0);\n            ra = r_get(ra, elemsize, key_ptr, keysize, &mut r_temp, 0);\n            assert_eq!(c_temp, r_temp, \"temp mismatch for get({})\", i);\n            if c_temp >= 0 {\n                let c_kv = (ca as *mut IntKV).add(c_temp as usize);\n                let r_kv = (ra as *mut IntKV).add(r_temp as usize);\n                assert_eq!((*c_kv).value, (*r_kv).value);\n            }\n        }\n\n        // Look up missing keys\n        for i in 100..110i32 {\n            let mut k = i;\n            let key_ptr = &mut k as *mut i32 as *mut c_void;\n            let mut c_temp: isize = 0;\n            let mut r_temp: isize = 0;\n            ca = c_get(ca, elemsize, key_ptr, keysize, &mut c_temp, 0);\n            ra = r_get(ra, elemsize, key_ptr, keysize, &mut r_temp, 0);\n            assert_eq!(c_temp, r_temp);\n        }\n\n        // Delete some keys (using the offset of `key` in IntKV which is 0).\n        for i in 0..15i32 {\n            let mut k = i;\n            let key_ptr = &mut k as *mut i32 as *mut c_void;\n            ca = c_del(ca, elemsize, key_ptr, keysize, 0, 0);\n            ra = r_del(ra, elemsize, key_ptr, keysize, 0, 0);\n        }\n\n        // Look up the remaining keys\n        for i in 15..30i32 {\n            let mut k = i;\n            let key_ptr = &mut k as *mut i32 as *mut c_void;\n            let mut c_temp: isize = 0;\n            let mut r_temp: isize = 0;\n            ca = c_get(ca, elemsize, key_ptr, keysize, &mut c_temp, 0);\n            ra = r_get(ra, elemsize, key_ptr, keysize, &mut r_temp, 0);\n            assert_eq!(c_temp, r_temp);\n            if c_temp >= 0 {\n                let c_kv = (ca as *mut IntKV).add(c_temp as usize);\n                let r_kv = (ra as *mut IntKV).add(r_temp as usize);\n                assert_eq!((*c_kv).value, (*r_kv).value);\n            }\n        }\n\n        // Free\n        c_free(ca, elemsize);\n        r_free(ra, elemsize);\n    }\n}\n\n// Test stringmap with STBDS_SH_STRDUP semantics.\n#[repr(C)]\n#[derive(Copy, Clone)]\nstruct StrKV {\n    key: *mut c_char,\n    value: i32,\n    _pad: i32,\n}\n\n#[test]\nfn test_shmap_strdup() {\n    let c = load_lib(C_LIB);\n    let r = load_lib(RUST_LIB);\n    unsafe {\n        let c_seed: Symbol<FnRandSeed> = c.get(b\"stbds_rand_seed\").unwrap();\n        let r_seed: Symbol<FnRandSeed> = r.get(b\"stbds_rand_seed\").unwrap();\n        c_seed(0x31415926);\n        r_seed(0x31415926);\n\n        let c_shmode: Symbol<FnShmodeFunc> = c.get(b\"stbds_shmode_func\").unwrap();\n        let r_shmode: Symbol<FnShmodeFunc> = r.get(b\"stbds_shmode_func\").unwrap();\n        let c_put: Symbol<FnHmputKey> = c.get(b\"stbds_hmput_key\").unwrap();\n        let r_put: Symbol<FnHmputKey> = r.get(b\"stbds_hmput_key\").unwrap();\n        let c_free: Symbol<FnHmfreeFunc> = c.get(b\"stbds_hmfree_func\").unwrap();\n        let r_free: Symbol<FnHmfreeFunc> = r.get(b\"stbds_hmfree_func\").unwrap();\n\n        let elemsize = std::mem::size_of::<StrKV>();\n        let keysize = std::mem::size_of::<*mut c_char>();\n\n        // STBDS_SH_STRDUP = 2\n        let mut ca = c_shmode(elemsize, 2);\n        let mut ra = r_shmode(elemsize, 2);\n\n        let test_strings: Vec<std::ffi::CString> = (0..10)\n            .map(|i| std::ffi::CString::new(format!(\"key_{}\", i)).unwrap())\n            .collect();\n\n        for (i, s) in test_strings.iter().enumerate() {\n            let key = s.as_ptr() as *mut c_void;\n            ca = c_put(ca, elemsize, key, keysize, 1);\n            ra = r_put(ra, elemsize, key, keysize, 1);\n\n            let c_raw = (ca as *mut u8).sub(elemsize) as *mut c_void;\n            let r_raw = (ra as *mut u8).sub(elemsize) as *mut c_void;\n            let c_idx = (*header(c_raw)).temp;\n            let r_idx = (*header(r_raw)).temp;\n            assert_eq!(c_idx, r_idx);\n\n            let slot = (c_idx + 1) as usize;\n            let c_kv = (ca as *mut StrKV).add(slot - 1);\n            let r_kv = (ra as *mut StrKV).add(slot - 1);\n            (*c_kv).value = i as i32;\n            (*r_kv).value = i as i32;\n        }\n\n        // Verify keys present in both via lookup\n        let c_get: Symbol<FnHmgetKey> = c.get(b\"stbds_hmget_key\").unwrap();\n        let r_get: Symbol<FnHmgetKey> = r.get(b\"stbds_hmget_key\").unwrap();\n        for s in test_strings.iter() {\n            let key = s.as_ptr() as *mut c_void;\n            ca = c_get(ca, elemsize, key, keysize, 1);\n            ra = r_get(ra, elemsize, key, keysize, 1);\n            let c_raw = (ca as *mut u8).sub(elemsize) as *mut c_void;\n            let r_raw = (ra as *mut u8).sub(elemsize) as *mut c_void;\n            let c_idx = (*header(c_raw)).temp;\n            let r_idx = (*header(r_raw)).temp;\n            assert_eq!(c_idx, r_idx, \"string lookup index differs\");\n        }\n\n        c_free(ca, elemsize);\n        r_free(ra, elemsize);\n    }\n}\n\n#[test]\nfn test_hmput_default() {\n    let c = load_lib(C_LIB);\n    let r = load_lib(RUST_LIB);\n    unsafe {\n        let c_def: Symbol<FnHmputDefault> = c.get(b\"stbds_hmput_default\").unwrap();\n        let r_def: Symbol<FnHmputDefault> = r.get(b\"stbds_hmput_default\").unwrap();\n        let c_free: Symbol<FnHmfreeFunc> = c.get(b\"stbds_hmfree_func\").unwrap();\n        let r_free: Symbol<FnHmfreeFunc> = r.get(b\"stbds_hmfree_func\").unwrap();\n\n        let elemsize = 16usize;\n        let ca = c_def(ptr::null_mut(), elemsize);\n        let ra = r_def(ptr::null_mut(), elemsize);\n\n        // Compare lengths and contents at slot 0 (the default slot).\n        // Default slot is at array-side offset 0; array starts at ca-elemsize.\n        let c_raw = (ca as *mut u8).sub(elemsize) as *mut c_void;\n        let r_raw = (ra as *mut u8).sub(elemsize) as *mut c_void;\n\n        assert_eq!((*header(c_raw)).length, (*header(r_raw)).length);\n\n        c_free(ca, elemsize);\n        r_free(ra, elemsize);\n    }\n}\n\n#[test]\nfn test_string_arena() {\n    // Test stbds_stralloc + stbds_strreset using the Rust and C string_arena\n    // structs by calling shmode then string-key puts.\n    let c = load_lib(C_LIB);\n    let r = load_lib(RUST_LIB);\n    unsafe {\n        let c_shmode: Symbol<FnShmodeFunc> = c.get(b\"stbds_shmode_func\").unwrap();\n        let r_shmode: Symbol<FnShmodeFunc> = r.get(b\"stbds_shmode_func\").unwrap();\n        let c_put: Symbol<FnHmputKey> = c.get(b\"stbds_hmput_key\").unwrap();\n        let r_put: Symbol<FnHmputKey> = r.get(b\"stbds_hmput_key\").unwrap();\n        let c_free: Symbol<FnHmfreeFunc> = c.get(b\"stbds_hmfree_func\").unwrap();\n        let r_free: Symbol<FnHmfreeFunc> = r.get(b\"stbds_hmfree_func\").unwrap();\n\n        // STBDS_SH_ARENA = 3\n        let elemsize = std::mem::size_of::<StrKV>();\n        let keysize = std::mem::size_of::<*mut c_char>();\n        let mut ca = c_shmode(elemsize, 3);\n        let mut ra = r_shmode(elemsize, 3);\n\n        let strings: Vec<std::ffi::CString> = (0..32)\n            .map(|i| std::ffi::CString::new(format!(\"arena_{:04}\", i)).unwrap())\n            .collect();\n\n        for s in &strings {\n            let key = s.as_ptr() as *mut c_void;\n            ca = c_put(ca, elemsize, key, keysize, 1);\n            ra = r_put(ra, elemsize, key, keysize, 1);\n\n            let c_raw = (ca as *mut u8).sub(elemsize) as *mut c_void;\n            let r_raw = (ra as *mut u8).sub(elemsize) as *mut c_void;\n            assert_eq!((*header(c_raw)).temp, (*header(r_raw)).temp);\n            assert_eq!((*header(c_raw)).length, (*header(r_raw)).length);\n        }\n\n        c_free(ca, elemsize);\n        r_free(ra, elemsize);\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":450,"cache_read_input_tokens":56047,"cache_creation":{"ephemeral_5m_input_tokens":450,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"0dd51079-00ff-467a-8ebc-d6f941e54b8a","uuid":"198fed30-4d63-4700-8606-41280f4bb9cc"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01T85to1qcX25aFHueMmF9S1","type":"tool_result","content":"File created successfully at: /tmp/harvest-translate-q58veN/translated_rust/tests/ffi_compare.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"0dd51079-00ff-467a-8ebc-d6f941e54b8a","uuid":"37b11597-66ba-46ce-a036-b2d2107c5f3e","timestamp":"2026-05-30T00:40:32.845Z","tool_use_result":{"type":"create","filePath":"/tmp/harvest-translate-q58veN/translated_rust/tests/ffi_compare.rs","content":"// FFI integration tests comparing C and Rust .so outputs side-by-side.\n//\n// Both libraries are loaded via libloading and exercised through the\n// same exported symbols. We never call Rust functions directly here.\n\nuse libloading::{Library, Symbol};\nuse std::ffi::{c_char, c_int, c_void};\nuse std::ptr;\n\nconst C_LIB: &str = \"c_src/build/libtranslated_rust.so\";\nconst RUST_LIB: &str = \"target/release/libtranslated_rust.so\";\n\n// ---------- Type signatures we import from each .so ----------\ntype FnRandSeed = unsafe extern \"C\" fn(usize);\ntype FnHashString = unsafe extern \"C\" fn(*mut c_char, usize) -> usize;\ntype FnHashBytes = unsafe extern \"C\" fn(*mut c_void, usize, usize) -> usize;\ntype FnArrgrowf = unsafe extern \"C\" fn(*mut c_void, usize, usize, usize) -> *mut c_void;\ntype FnArrfreef = unsafe extern \"C\" fn(*mut c_void);\ntype FnArrPush = unsafe extern \"C\" fn(c_int);\ntype FnStrkey = unsafe extern \"C\" fn(c_int) -> *mut c_char;\ntype FnHmputKey = unsafe extern \"C\" fn(*mut c_void, usize, *mut c_void, usize, c_int) -> *mut c_void;\ntype FnHmgetKey = unsafe extern \"C\" fn(*mut c_void, usize, *mut c_void, usize, c_int) -> *mut c_void;\ntype FnHmgetKeyTs = unsafe extern \"C\" fn(*mut c_void, usize, *mut c_void, usize, *mut isize, c_int) -> *mut c_void;\ntype FnHmdelKey = unsafe extern \"C\" fn(*mut c_void, usize, *mut c_void, usize, usize, c_int) -> *mut c_void;\ntype FnHmfreeFunc = unsafe extern \"C\" fn(*mut c_void, usize);\ntype FnShmodeFunc = unsafe extern \"C\" fn(usize, c_int) -> *mut c_void;\ntype FnHmputDefault = unsafe extern \"C\" fn(*mut c_void, usize) -> *mut c_void;\n\n#[repr(C)]\n#[derive(Copy, Clone, Debug, PartialEq, Eq)]\npub struct ArrayHeader {\n    pub length: usize,\n    pub capacity: usize,\n    pub hash_table: *mut c_void,\n    pub temp: isize,\n}\n\nunsafe fn header(t: *mut c_void) -> *mut ArrayHeader {\n    unsafe { (t as *mut ArrayHeader).offset(-1) }\n}\n\nfn load_lib(path: &str) -> Library {\n    unsafe { Library::new(path) }.unwrap_or_else(|e| panic!(\"load {path}: {e}\"))\n}\n\n#[test]\nfn test_libs_load() {\n    let _c = load_lib(C_LIB);\n    let _r = load_lib(RUST_LIB);\n}\n\n#[test]\nfn test_hash_string_matches() {\n    let c = load_lib(C_LIB);\n    let r = load_lib(RUST_LIB);\n    unsafe {\n        let cf: Symbol<FnHashString> = c.get(b\"stbds_hash_string\").unwrap();\n        let rf: Symbol<FnHashString> = r.get(b\"stbds_hash_string\").unwrap();\n\n        let cases: &[(&[u8], usize)] = &[\n            (b\"\\0\", 0),\n            (b\"hello\\0\", 0),\n            (b\"a\\0\", 1),\n            (b\"foobar baz quux\\0\", 0xdeadbeef),\n            (b\"this is a longer string for testing\\0\", 0x123456789abcdef0),\n            (b\"x\\0\", 0xffffffffffffffff),\n        ];\n\n        for (s, seed) in cases {\n            let p = s.as_ptr() as *mut c_char;\n            let cv = cf(p, *seed);\n            let rv = rf(p, *seed);\n            assert_eq!(cv, rv, \"stbds_hash_string mismatch for {:?} seed {:#x}\", s, seed);\n        }\n    }\n}\n\n#[test]\nfn test_hash_bytes_matches() {\n    let c = load_lib(C_LIB);\n    let r = load_lib(RUST_LIB);\n    unsafe {\n        let cf: Symbol<FnHashBytes> = c.get(b\"stbds_hash_bytes\").unwrap();\n        let rf: Symbol<FnHashBytes> = r.get(b\"stbds_hash_bytes\").unwrap();\n\n        // Test various input lengths to cover all switch fall-through cases\n        let mut buf = [0u8; 64];\n        for i in 0..buf.len() {\n            buf[i] = (i as u8).wrapping_mul(17).wrapping_add(3);\n        }\n        for len in 0..=24usize {\n            for &seed in &[0usize, 1, 0x1234, 0xdeadbeef, 0x31415926, usize::MAX] {\n                let p = buf.as_ptr() as *mut c_void;\n                let cv = cf(p, len, seed);\n                let rv = rf(p, len, seed);\n                assert_eq!(cv, rv, \"stbds_hash_bytes mismatch len={len} seed={seed:#x}\");\n            }\n        }\n    }\n}\n\n#[test]\nfn test_strkey_matches() {\n    let c = load_lib(C_LIB);\n    let r = load_lib(RUST_LIB);\n    unsafe {\n        let cf: Symbol<FnStrkey> = c.get(b\"strkey\").unwrap();\n        let rf: Symbol<FnStrkey> = r.get(b\"strkey\").unwrap();\n\n        for n in &[0i32, 1, -1, 42, 1000, 1234567, i32::MAX, i32::MIN] {\n            let cp = cf(*n);\n            let rp = rf(*n);\n            // compare the returned C strings\n            let c_bytes = std::ffi::CStr::from_ptr(cp).to_bytes();\n            let r_bytes = std::ffi::CStr::from_ptr(rp).to_bytes();\n            assert_eq!(c_bytes, r_bytes, \"strkey({}) differs\", n);\n        }\n    }\n}\n\n#[test]\nfn test_arrgrowf_then_free() {\n    let c = load_lib(C_LIB);\n    let r = load_lib(RUST_LIB);\n    unsafe {\n        let c_grow: Symbol<FnArrgrowf> = c.get(b\"stbds_arrgrowf\").unwrap();\n        let c_free: Symbol<FnArrfreef> = c.get(b\"stbds_arrfreef\").unwrap();\n        let r_grow: Symbol<FnArrgrowf> = r.get(b\"stbds_arrgrowf\").unwrap();\n        let r_free: Symbol<FnArrfreef> = r.get(b\"stbds_arrfreef\").unwrap();\n\n        // Grow each side, check that header.length=0, header.capacity=min_cap=4 (since min_cap<4)\n        for &n in &[0usize, 1, 4, 8, 32] {\n            let ca = c_grow(ptr::null_mut(), 4, n, 0);\n            let ra = r_grow(ptr::null_mut(), 4, n, 0);\n\n            let ch = header(ca);\n            let rh = header(ra);\n            assert_eq!((*ch).length, (*rh).length);\n            assert_eq!((*ch).capacity, (*rh).capacity);\n\n            c_free(ca);\n            r_free(ra);\n        }\n\n        // Grow incrementally to test resizing\n        let mut ca: *mut c_void = ptr::null_mut();\n        let mut ra: *mut c_void = ptr::null_mut();\n        for i in 0..50 {\n            // arrmaybegrow logic: if (!a) || length+1 > capacity, then grow.\n            let need_grow_c = ca.is_null() || (*header(ca)).length + 1 > (*header(ca)).capacity;\n            let need_grow_r = ra.is_null() || (*header(ra)).length + 1 > (*header(ra)).capacity;\n            assert_eq!(need_grow_c, need_grow_r);\n            if need_grow_c {\n                ca = c_grow(ca, 4, 1, 0);\n                ra = r_grow(ra, 4, 1, 0);\n                assert_eq!((*header(ca)).capacity, (*header(ra)).capacity);\n            }\n            // Append\n            let cap_c = (*header(ca)).capacity;\n            let cap_r = (*header(ra)).capacity;\n            let len_c = (*header(ca)).length;\n            let len_r = (*header(ra)).length;\n            assert_eq!(cap_c, cap_r);\n            assert_eq!(len_c, len_r);\n            *((ca as *mut i32).add(len_c)) = i;\n            *((ra as *mut i32).add(len_r)) = i;\n            (*header(ca)).length = len_c + 1;\n            (*header(ra)).length = len_r + 1;\n        }\n        // Compare buffer contents\n        let len = (*header(ca)).length;\n        for i in 0..len {\n            assert_eq!(*((ca as *mut i32).add(i)), *((ra as *mut i32).add(i)));\n        }\n        c_free(ca);\n        r_free(ra);\n    }\n}\n\n#[test]\nfn test_arr_push() {\n    // arr_push has no return value, but we want to be sure it doesn't crash\n    // and behaves identically (both should work with same inputs).\n    let c = load_lib(C_LIB);\n    let r = load_lib(RUST_LIB);\n    unsafe {\n        let cf: Symbol<FnArrPush> = c.get(b\"arr_push\").unwrap();\n        let rf: Symbol<FnArrPush> = r.get(b\"arr_push\").unwrap();\n        for &n in &[0i32, 10, 100, 250, 500] {\n            cf(n);\n            rf(n);\n        }\n    }\n}\n\n// Test the hashmap put/get/del flow with binary keys.\n// This exercises stbds_hmput_key, stbds_hmget_key, stbds_hmdel_key, stbds_hmfree_func.\n#[repr(C)]\n#[derive(Copy, Clone, Default)]\nstruct IntKV {\n    key: i32,\n    _pad: i32, // 8-byte align so {i32 key, i32 value}\n    value: i64,\n}\n\n#[test]\nfn test_hmap_int_keys() {\n    let c = load_lib(C_LIB);\n    let r = load_lib(RUST_LIB);\n    unsafe {\n        let c_seed: Symbol<FnRandSeed> = c.get(b\"stbds_rand_seed\").unwrap();\n        let r_seed: Symbol<FnRandSeed> = r.get(b\"stbds_rand_seed\").unwrap();\n        c_seed(0x31415926);\n        r_seed(0x31415926);\n\n        let c_put: Symbol<FnHmputKey> = c.get(b\"stbds_hmput_key\").unwrap();\n        let r_put: Symbol<FnHmputKey> = r.get(b\"stbds_hmput_key\").unwrap();\n        let c_get: Symbol<FnHmgetKeyTs> = c.get(b\"stbds_hmget_key_ts\").unwrap();\n        let r_get: Symbol<FnHmgetKeyTs> = r.get(b\"stbds_hmget_key_ts\").unwrap();\n        let c_del: Symbol<FnHmdelKey> = c.get(b\"stbds_hmdel_key\").unwrap();\n        let r_del: Symbol<FnHmdelKey> = r.get(b\"stbds_hmdel_key\").unwrap();\n        let c_free: Symbol<FnHmfreeFunc> = c.get(b\"stbds_hmfree_func\").unwrap();\n        let r_free: Symbol<FnHmfreeFunc> = r.get(b\"stbds_hmfree_func\").unwrap();\n\n        let elemsize = std::mem::size_of::<IntKV>();\n        let keysize = 4usize;\n\n        let mut ca: *mut c_void = ptr::null_mut();\n        let mut ra: *mut c_void = ptr::null_mut();\n\n        // Insert keys 0..30\n        for i in 0..30i32 {\n            let mut k = i;\n            let key_ptr = &mut k as *mut i32 as *mut c_void;\n            ca = c_put(ca, elemsize, key_ptr, keysize, 0);\n            ra = r_put(ra, elemsize, key_ptr, keysize, 0);\n            // After put, write value at the slot indicated by header.temp+1\n            let c_idx = (*header(ca as *mut c_void).cast::<ArrayHeader>().sub(0)).temp;\n            let r_idx = (*header(ra as *mut c_void).cast::<ArrayHeader>().sub(0)).temp;\n            // header is at hash_to_arr position\n            // Note: hmput_key returns the hash-side pointer; the array header is at -1 of (a-elemsize)\n            // We've used header() which is pointer cast offset -1. But the array header lives at\n            // -1 of the underlying raw_a (the array side). So we need to step back elemsize first.\n            let c_raw = (ca as *mut u8).sub(elemsize) as *mut c_void;\n            let r_raw = (ra as *mut u8).sub(elemsize) as *mut c_void;\n            let c_idx2 = (*header(c_raw)).temp;\n            let r_idx2 = (*header(r_raw)).temp;\n            assert_eq!(c_idx2, r_idx2, \"temp index mismatch for key {}\", i);\n            let _ = c_idx;\n            let _ = r_idx;\n\n            // Set key+value at slot (c_idx2+1) — the table is 1-indexed in the underlying array\n            // (offset 0 is the \"default\" slot).\n            let slot = (c_idx2 + 1) as usize;\n            let c_kv = (ca as *mut IntKV).add(slot - 1);\n            let r_kv = (ra as *mut IntKV).add(slot - 1);\n            (*c_kv).key = i;\n            (*c_kv).value = (i as i64) * 1000;\n            (*r_kv).key = i;\n            (*r_kv).value = (i as i64) * 1000;\n        }\n\n        // Look up keys\n        for i in 0..30i32 {\n            let mut k = i;\n            let key_ptr = &mut k as *mut i32 as *mut c_void;\n            let mut c_temp: isize = 0;\n            let mut r_temp: isize = 0;\n            ca = c_get(ca, elemsize, key_ptr, keysize, &mut c_temp, 0);\n            ra = r_get(ra, elemsize, key_ptr, keysize, &mut r_temp, 0);\n            assert_eq!(c_temp, r_temp, \"temp mismatch for get({})\", i);\n            if c_temp >= 0 {\n                let c_kv = (ca as *mut IntKV).add(c_temp as usize);\n                let r_kv = (ra as *mut IntKV).add(r_temp as usize);\n                assert_eq!((*c_kv).value, (*r_kv).value);\n            }\n        }\n\n        // Look up missing keys\n        for i in 100..110i32 {\n            let mut k = i;\n            let key_ptr = &mut k as *mut i32 as *mut c_void;\n            let mut c_temp: isize = 0;\n            let mut r_temp: isize = 0;\n            ca = c_get(ca, elemsize, key_ptr, keysize, &mut c_temp, 0);\n            ra = r_get(ra, elemsize, key_ptr, keysize, &mut r_temp, 0);\n            assert_eq!(c_temp, r_temp);\n        }\n\n        // Delete some keys (using the offset of `key` in IntKV which is 0).\n        for i in 0..15i32 {\n            let mut k = i;\n            let key_ptr = &mut k as *mut i32 as *mut c_void;\n            ca = c_del(ca, elemsize, key_ptr, keysize, 0, 0);\n            ra = r_del(ra, elemsize, key_ptr, keysize, 0, 0);\n        }\n\n        // Look up the remaining keys\n        for i in 15..30i32 {\n            let mut k = i;\n            let key_ptr = &mut k as *mut i32 as *mut c_void;\n            let mut c_temp: isize = 0;\n            let mut r_temp: isize = 0;\n            ca = c_get(ca, elemsize, key_ptr, keysize, &mut c_temp, 0);\n            ra = r_get(ra, elemsize, key_ptr, keysize, &mut r_temp, 0);\n            assert_eq!(c_temp, r_temp);\n            if c_temp >= 0 {\n                let c_kv = (ca as *mut IntKV).add(c_temp as usize);\n                let r_kv = (ra as *mut IntKV).add(r_temp as usize);\n                assert_eq!((*c_kv).value, (*r_kv).value);\n            }\n        }\n\n        // Free\n        c_free(ca, elemsize);\n        r_free(ra, elemsize);\n    }\n}\n\n// Test stringmap with STBDS_SH_STRDUP semantics.\n#[repr(C)]\n#[derive(Copy, Clone)]\nstruct StrKV {\n    key: *mut c_char,\n    value: i32,\n    _pad: i32,\n}\n\n#[test]\nfn test_shmap_strdup() {\n    let c = load_lib(C_LIB);\n    let r = load_lib(RUST_LIB);\n    unsafe {\n        let c_seed: Symbol<FnRandSeed> = c.get(b\"stbds_rand_seed\").unwrap();\n        let r_seed: Symbol<FnRandSeed> = r.get(b\"stbds_rand_seed\").unwrap();\n        c_seed(0x31415926);\n        r_seed(0x31415926);\n\n        let c_shmode: Symbol<FnShmodeFunc> = c.get(b\"stbds_shmode_func\").unwrap();\n        let r_shmode: Symbol<FnShmodeFunc> = r.get(b\"stbds_shmode_func\").unwrap();\n        let c_put: Symbol<FnHmputKey> = c.get(b\"stbds_hmput_key\").unwrap();\n        let r_put: Symbol<FnHmputKey> = r.get(b\"stbds_hmput_key\").unwrap();\n        let c_free: Symbol<FnHmfreeFunc> = c.get(b\"stbds_hmfree_func\").unwrap();\n        let r_free: Symbol<FnHmfreeFunc> = r.get(b\"stbds_hmfree_func\").unwrap();\n\n        let elemsize = std::mem::size_of::<StrKV>();\n        let keysize = std::mem::size_of::<*mut c_char>();\n\n        // STBDS_SH_STRDUP = 2\n        let mut ca = c_shmode(elemsize, 2);\n        let mut ra = r_shmode(elemsize, 2);\n\n        let test_strings: Vec<std::ffi::CString> = (0..10)\n            .map(|i| std::ffi::CString::new(format!(\"key_{}\", i)).unwrap())\n            .collect();\n\n        for (i, s) in test_strings.iter().enumerate() {\n            let key = s.as_ptr() as *mut c_void;\n            ca = c_put(ca, elemsize, key, keysize, 1);\n            ra = r_put(ra, elemsize, key, keysize, 1);\n\n            let c_raw = (ca as *mut u8).sub(elemsize) as *mut c_void;\n            let r_raw = (ra as *mut u8).sub(elemsize) as *mut c_void;\n            let c_idx = (*header(c_raw)).temp;\n            let r_idx = (*header(r_raw)).temp;\n            assert_eq!(c_idx, r_idx);\n\n            let slot = (c_idx + 1) as usize;\n            let c_kv = (ca as *mut StrKV).add(slot - 1);\n            let r_kv = (ra as *mut StrKV).add(slot - 1);\n            (*c_kv).value = i as i32;\n            (*r_kv).value = i as i32;\n        }\n\n        // Verify keys present in both via lookup\n        let c_get: Symbol<FnHmgetKey> = c.get(b\"stbds_hmget_key\").unwrap();\n        let r_get: Symbol<FnHmgetKey> = r.get(b\"stbds_hmget_key\").unwrap();\n        for s in test_strings.iter() {\n            let key = s.as_ptr() as *mut c_void;\n            ca = c_get(ca, elemsize, key, keysize, 1);\n            ra = r_get(ra, elemsize, key, keysize, 1);\n            let c_raw = (ca as *mut u8).sub(elemsize) as *mut c_void;\n            let r_raw = (ra as *mut u8).sub(elemsize) as *mut c_void;\n            let c_idx = (*header(c_raw)).temp;\n            let r_idx = (*header(r_raw)).temp;\n            assert_eq!(c_idx, r_idx, \"string lookup index differs\");\n        }\n\n        c_free(ca, elemsize);\n        r_free(ra, elemsize);\n    }\n}\n\n#[test]\nfn test_hmput_default() {\n    let c = load_lib(C_LIB);\n    let r = load_lib(RUST_LIB);\n    unsafe {\n        let c_def: Symbol<FnHmputDefault> = c.get(b\"stbds_hmput_default\").unwrap();\n        let r_def: Symbol<FnHmputDefault> = r.get(b\"stbds_hmput_default\").unwrap();\n        let c_free: Symbol<FnHmfreeFunc> = c.get(b\"stbds_hmfree_func\").unwrap();\n        let r_free: Symbol<FnHmfreeFunc> = r.get(b\"stbds_hmfree_func\").unwrap();\n\n        let elemsize = 16usize;\n        let ca = c_def(ptr::null_mut(), elemsize);\n        let ra = r_def(ptr::null_mut(), elemsize);\n\n        // Compare lengths and contents at slot 0 (the default slot).\n        // Default slot is at array-side offset 0; array starts at ca-elemsize.\n        let c_raw = (ca as *mut u8).sub(elemsize) as *mut c_void;\n        let r_raw = (ra as *mut u8).sub(elemsize) as *mut c_void;\n\n        assert_eq!((*header(c_raw)).length, (*header(r_raw)).length);\n\n        c_free(ca, elemsize);\n        r_free(ra, elemsize);\n    }\n}\n\n#[test]\nfn test_string_arena() {\n    // Test stbds_stralloc + stbds_strreset using the Rust and C string_arena\n    // structs by calling shmode then string-key puts.\n    let c = load_lib(C_LIB);\n    let r = load_lib(RUST_LIB);\n    unsafe {\n        let c_shmode: Symbol<FnShmodeFunc> = c.get(b\"stbds_shmode_func\").unwrap();\n        let r_shmode: Symbol<FnShmodeFunc> = r.get(b\"stbds_shmode_func\").unwrap();\n        let c_put: Symbol<FnHmputKey> = c.get(b\"stbds_hmput_key\").unwrap();\n        let r_put: Symbol<FnHmputKey> = r.get(b\"stbds_hmput_key\").unwrap();\n        let c_free: Symbol<FnHmfreeFunc> = c.get(b\"stbds_hmfree_func\").unwrap();\n        let r_free: Symbol<FnHmfreeFunc> = r.get(b\"stbds_hmfree_func\").unwrap();\n\n        // STBDS_SH_ARENA = 3\n        let elemsize = std::mem::size_of::<StrKV>();\n        let keysize = std::mem::size_of::<*mut c_char>();\n        let mut ca = c_shmode(elemsize, 3);\n        let mut ra = r_shmode(elemsize, 3);\n\n        let strings: Vec<std::ffi::CString> = (0..32)\n            .map(|i| std::ffi::CString::new(format!(\"arena_{:04}\", i)).unwrap())\n            .collect();\n\n        for s in &strings {\n            let key = s.as_ptr() as *mut c_void;\n            ca = c_put(ca, elemsize, key, keysize, 1);\n            ra = r_put(ra, elemsize, key, keysize, 1);\n\n            let c_raw = (ca as *mut u8).sub(elemsize) as *mut c_void;\n            let r_raw = (ra as *mut u8).sub(elemsize) as *mut c_void;\n            assert_eq!((*header(c_raw)).temp, (*header(r_raw)).temp);\n            assert_eq!((*header(c_raw)).length, (*header(r_raw)).length);\n        }\n\n        c_free(ca, elemsize);\n        r_free(ra, elemsize);\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
