{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_vc5ixfyyhogb6ofwyl6tthg4htu763ivsvnktymzs62bndepe4ga","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_013CTRgoRuQsJGPPiohjEQeW","name":"Write","input":{"file_path":"/tmp/harvest-translate-4cvE8I/translated_rust/tests/ffi_compare.rs","content":"use libloading::{Library, Symbol};\nuse std::ffi::c_int;\nuse std::path::PathBuf;\n\nfn workspace_dir() -> PathBuf {\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n}\n\nfn c_lib_path() -> PathBuf {\n    workspace_dir().join(\"c_src/build/libtranslated_rust.so\")\n}\n\nfn rust_lib_path() -> PathBuf {\n    workspace_dir().join(\"target/release/liblib.so\")\n}\n\ntype GetPredictFuncFn = unsafe extern \"C\" fn(c_int) -> c_int;\n\nunsafe fn load_get_predict_func(lib: &Library) -> Symbol<GetPredictFuncFn> {\n    unsafe { lib.get(b\"get_predict_func\\0\").expect(\"symbol get_predict_func\") }\n}\n\n#[test]\nfn get_predict_func_matches() {\n    let c_lib = unsafe { Library::new(c_lib_path()).expect(\"load C .so\") };\n    let rust_lib = unsafe { Library::new(rust_lib_path()).expect(\"load Rust .so\") };\n\n    let c_fn = unsafe { load_get_predict_func(&c_lib) };\n    let rust_fn = unsafe { load_get_predict_func(&rust_lib) };\n\n    // Cover the named cases (0..=11), the default range (12..=20),\n    // negative values, and edge cases.\n    let inputs: Vec<c_int> = (-5..=20).chain(std::iter::once(c_int::MIN)).chain(std::iter::once(c_int::MAX)).collect();\n\n    for pfcn in inputs {\n        let c_result = unsafe { c_fn(pfcn) };\n        let rust_result = unsafe { rust_fn(pfcn) };\n        assert_eq!(\n            c_result, rust_result,\n            \"get_predict_func({}) mismatch: C={} Rust={}\",\n            pfcn, c_result, rust_result\n        );\n    }\n}\n\n#[test]\nfn get_predict_func_known_values() {\n    // Sanity: per the C source, every pfcn in [0, 11] should report 1\n    // (the dispatcher returns the matching _PfnN function), and every pfcn\n    // outside [0, 11] should report 0 (it returns the generic dispatcher,\n    // which is not one of the comparison targets).\n    let c_lib = unsafe { Library::new(c_lib_path()).expect(\"load C .so\") };\n    let c_fn = unsafe { load_get_predict_func(&c_lib) };\n\n    for pfcn in 0..=11 {\n        assert_eq!(unsafe { c_fn(pfcn) }, 1, \"expected 1 for pfcn={}\", pfcn);\n    }\n    for pfcn in [-1, 12, 13, 14, 15, 16, 100, c_int::MIN, c_int::MAX] {\n        assert_eq!(unsafe { c_fn(pfcn) }, 0, \"expected 0 for pfcn={}\", pfcn);\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":142,"cache_read_input_tokens":31570,"cache_creation":{"ephemeral_5m_input_tokens":142,"ephemeral_1h_input_tokens":0},"output_tokens":22,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"5923e66f-a9d0-4f9b-8339-10c6a71d5fed","uuid":"aa9d8561-2d0b-4abd-b8d2-cd46129949e6"}
