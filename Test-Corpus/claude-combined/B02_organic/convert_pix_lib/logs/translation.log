  ];\n        for name in names.iter().copied() {\n            let _: Symbol<*const u8> = c_lib.get(name).unwrap_or_else(|e| {\n                panic!(\"C missing {:?}: {}\", std::str::from_utf8(name).unwrap(), e)\n            });\n            let _: Symbol<*const u8> = r_lib.get(name).unwrap_or_else(|e| {\n                panic!(\"Rust missing {:?}: {}\", std::str::from_utf8(name).unwrap(), e)\n            });\n        }\n    }\n}","originalFile":"use libloading::{Library, Symbol};\nuse std::os::raw::{c_int, c_void};\n\n#[repr(C)]\n#[derive(Copy, Clone, Debug, PartialEq, Eq)]\nstruct CpPixel {\n    r: u8,\n    g: u8,\n    b: u8,\n    a: u8,\n}\n\nconst C_LIB_PATH: &str = \"c_src/build/libtranslated_rust.so\";\nconst RUST_LIB_PATH: &str = \"target/release/libtranslated_rust.so\";\n\nunsafe fn load_libs() -> (Library, Library) {\n    let c_lib = Library::new(C_LIB_PATH).expect(\"load C lib\");\n    let r_lib = Library::new(RUST_LIB_PATH).expect(\"load Rust lib\");\n    (c_lib, r_lib)\n}\n\n// Type aliases for the C functions\ntype ConvertPixFn = unsafe extern \"C\" fn(c_int, c_int, c_int, *mut u8, *mut CpPixel);\ntype CpInflateFn = unsafe extern \"C\" fn(*mut c_void, c_int, *mut c_void, c_int) -> c_int;\n\n#[test]\nfn convert_pix_bpp_1() {\n    unsafe {\n        let (c_lib, r_lib) = load_libs();\n        let c_fn: Symbol<ConvertPixFn> = c_lib.get(b\"convert_pix\").unwrap();\n        let r_fn: Symbol<ConvertPixFn> = r_lib.get(b\"convert_pix\").unwrap();\n\n        let w = 5;\n        let h = 3;\n        let bpp = 1;\n        // Each row: 1 filter byte + w*bpp pixel bytes\n        let mut src: Vec<u8> = Vec::new();\n        for y in 0..h {\n            src.push(0);\n            for x in 0..w {\n                src.push(((y * 100 + x * 7) & 0xFF) as u8);\n            }\n        }\n        let mut src_c = src.clone();\n        let mut src_r = src.clone();\n        let zero = CpPixel { r: 0, g: 0, b: 0, a: 0 };\n        let mut dst_c = vec![zero; (w * h) as usize];\n        let mut dst_r = vec![zero; (w * h) as usize];\n        c_fn(bpp, w, h, src_c.as_mut_ptr(), dst_c.as_mut_ptr());\n        r_fn(bpp, w, h, src_r.as_mut_ptr(), dst_r.as_mut_ptr());\n        assert_eq!(dst_c, dst_r);\n    }\n}\n\n#[test]\nfn convert_pix_bpp_2() {\n    unsafe {\n        let (c_lib, r_lib) = load_libs();\n        let c_fn: Symbol<ConvertPixFn> = c_lib.get(b\"convert_pix\").unwrap();\n        let r_fn: Symbol<ConvertPixFn> = r_lib.get(b\"convert_pix\").unwrap();\n\n        let w = 4;\n        let h = 2;\n        let bpp = 2;\n        let mut src: Vec<u8> = Vec::new();\n        for y in 0..h {\n            src.push(0);\n            for x in 0..w {\n                src.push(((y * 30 + x * 11) & 0xFF) as u8);\n                src.push(((y * 50 + x * 13 + 0x80) & 0xFF) as u8);\n            }\n        }\n        let mut src_c = src.clone();\n        let mut src_r = src.clone();\n        let zero = CpPixel { r: 0, g: 0, b: 0, a: 0 };\n        let mut dst_c = vec![zero; (w * h) as usize];\n        let mut dst_r = vec![zero; (w * h) as usize];\n        c_fn(bpp, w, h, src_c.as_mut_ptr(), dst_c.as_mut_ptr());\n        r_fn(bpp, w, h, src_r.as_mut_ptr(), dst_r.as_mut_ptr());\n        assert_eq!(dst_c, dst_r);\n    }\n}\n\n#[test]\nfn convert_pix_bpp_3() {\n    unsafe {\n        let (c_lib, r_lib) = load_libs();\n        let c_fn: Symbol<ConvertPixFn> = c_lib.get(b\"convert_pix\").unwrap();\n        let r_fn: Symbol<ConvertPixFn> = r_lib.get(b\"convert_pix\").unwrap();\n\n        let w = 8;\n        let h = 4;\n        let bpp = 3;\n        let mut src: Vec<u8> = Vec::new();\n        for y in 0..h {\n            src.push(0);\n            for x in 0..w {\n                src.push(((y * 17 + x * 23 + 1) & 0xFF) as u8);\n                src.push(((y * 19 + x * 29 + 7) & 0xFF) as u8);\n                src.push(((y * 31 + x * 37 + 13) & 0xFF) as u8);\n            }\n        }\n        let mut src_c = src.clone();\n        let mut src_r = src.clone();\n        let zero = CpPixel { r: 0, g: 0, b: 0, a: 0 };\n        let mut dst_c = vec![zero; (w * h) as usize];\n        let mut dst_r = vec![zero; (w * h) as usize];\n        c_fn(bpp, w, h, src_c.as_mut_ptr(), dst_c.as_mut_ptr());\n        r_fn(bpp, w, h, src_r.as_mut_ptr(), dst_r.as_mut_ptr());\n        assert_eq!(dst_c, dst_r);\n    }\n}\n\n#[test]\nfn convert_pix_bpp_4() {\n    unsafe {\n        let (c_lib, r_lib) = load_libs();\n        let c_fn: Symbol<ConvertPixFn> = c_lib.get(b\"convert_pix\").unwrap();\n        let r_fn: Symbol<ConvertPixFn> = r_lib.get(b\"convert_pix\").unwrap();\n\n        let w = 6;\n        let h = 5;\n        let bpp = 4;\n        let mut src: Vec<u8> = Vec::new();\n        for y in 0..h {\n            src.push(0);\n            for x in 0..w {\n                src.push(((y * 17 + x * 23 + 1) & 0xFF) as u8);\n                src.push(((y * 19 + x * 29 + 7) & 0xFF) as u8);\n                src.push(((y * 31 + x * 37 + 13) & 0xFF) as u8);\n                src.push(((y * 41 + x * 43 + 19) & 0xFF) as u8);\n            }\n        }\n        let mut src_c = src.clone();\n        let mut src_r = src.clone();\n        let zero = CpPixel { r: 0, g: 0, b: 0, a: 0 };\n        let mut dst_c = vec![zero; (w * h) as usize];\n        let mut dst_r = vec![zero; (w * h) as usize];\n        c_fn(bpp, w, h, src_c.as_mut_ptr(), dst_c.as_mut_ptr());\n        r_fn(bpp, w, h, src_r.as_mut_ptr(), dst_r.as_mut_ptr());\n        assert_eq!(dst_c, dst_r);\n    }\n}\n\n// Build a raw deflate (RFC 1951) \"stored\" block manually: BFINAL=1, BTYPE=00,\n// pad to byte, LEN, NLEN, raw bytes.\nfn make_stored_deflate(data: &[u8]) -> Vec<u8> {\n    let mut out = Vec::new();\n    // first byte: BFINAL=1 in bit 0, BTYPE=00 in bits 1-2 -> 0b00000001 = 0x01\n    out.push(0x01);\n    let len = data.len() as u16;\n    let nlen = !len;\n    out.push((len & 0xFF) as u8);\n    out.push((len >> 8) as u8);\n    out.push((nlen & 0xFF) as u8);\n    out.push((nlen >> 8) as u8);\n    out.extend_from_slice(data);\n    out\n}\n\n// A precomputed raw-deflate of \"Hello, world!\" using fixed Huffman codes (BTYPE=01).\n// We construct it via Python-zlib offline; we test by running both libs on it.\n// To avoid relying on python at test time, we use stored block tests primarily,\n// and also include a hardcoded fixed-huffman blob for \"Hello, world!\".\nconst HELLO_FIXED_DEFLATE: &[u8] = &[\n    0xF3, 0x48, 0xCD, 0xC9, 0xC9, 0xD7, 0x51, 0x28, 0xCF, 0x2F, 0xCA, 0x49, 0x51, 0x04, 0x00,\n];\n\n#[test]\nfn cp_inflate_stored_short() {\n    unsafe {\n        let (c_lib, r_lib) = load_libs();\n        let c_fn: Symbol<CpInflateFn> = c_lib.get(b\"cp_inflate\").unwrap();\n        let r_fn: Symbol<CpInflateFn> = r_lib.get(b\"cp_inflate\").unwrap();\n\n        let payload = b\"Hello, stored block!\";\n        let input = make_stored_deflate(payload);\n        let mut input_c = input.clone();\n        let mut input_r = input.clone();\n        let mut out_c = vec![0u8; 256];\n        let mut out_r = vec![0u8; 256];\n        let rc = c_fn(\n            input_c.as_mut_ptr() as *mut c_void,\n            input_c.len() as c_int,\n            out_c.as_mut_ptr() as *mut c_void,\n            out_c.len() as c_int,\n        );\n        let rr = r_fn(\n            input_r.as_mut_ptr() as *mut c_void,\n            input_r.len() as c_int,\n            out_r.as_mut_ptr() as *mut c_void,\n            out_r.len() as c_int,\n        );\n        assert_eq!(rc, rr);\n        assert_eq!(rc, 1);\n        assert_eq!(&out_c[..payload.len()], payload);\n        assert_eq!(&out_c[..], &out_r[..]);\n    }\n}\n\n#[test]\nfn cp_inflate_stored_aligned_in_buffer() {\n    unsafe {\n        let (c_lib, r_lib) = load_libs();\n        let c_fn: Symbol<CpInflateFn> = c_lib.get(b\"cp_inflate\").unwrap();\n        let r_fn: Symbol<CpInflateFn> = r_lib.get(b\"cp_inflate\").unwrap();\n\n        // Try various lengths to exercise different first_bytes/last_bytes counts\n        for plen in [0usize, 1, 2, 3, 4, 5, 7, 16, 31, 257].iter().copied() {\n            let payload: Vec<u8> = (0..plen).map(|i| (i * 31 + 7) as u8).collect();\n            let input = make_stored_deflate(&payload);\n            let mut input_c = input.clone();\n            let mut input_r = input.clone();\n            let mut out_c = vec![0u8; plen.max(1) + 16];\n            let mut out_r = vec![0u8; plen.max(1) + 16];\n            let rc = c_fn(\n                input_c.as_mut_ptr() as *mut c_void,\n                input_c.len() as c_int,\n                out_c.as_mut_ptr() as *mut c_void,\n                out_c.len() as c_int,\n            );\n            let rr = r_fn(\n                input_r.as_mut_ptr() as *mut c_void,\n                input_r.len() as c_int,\n                out_r.as_mut_ptr() as *mut c_void,\n                out_r.len() as c_int,\n            );\n            assert_eq!(rc, rr, \"plen={}\", plen);\n            assert_eq!(out_c, out_r, \"plen={}\", plen);\n        }\n    }\n}\n\n#[test]\nfn cp_inflate_fixed_huffman_hello() {\n    unsafe {\n        let (c_lib, r_lib) = load_libs();\n        let c_fn: Symbol<CpInflateFn> = c_lib.get(b\"cp_inflate\").unwrap();\n        let r_fn: Symbol<CpInflateFn> = r_lib.get(b\"cp_inflate\").unwrap();\n\n        let mut input_c = HELLO_FIXED_DEFLATE.to_vec();\n        let mut input_r = HELLO_FIXED_DEFLATE.to_vec();\n        let mut out_c = vec![0u8; 64];\n        let mut out_r = vec![0u8; 64];\n        let rc = c_fn(\n            input_c.as_mut_ptr() as *mut c_void,\n            input_c.len() as c_int,\n            out_c.as_mut_ptr() as *mut c_void,\n            out_c.len() as c_int,\n        );\n        let rr = r_fn(\n            input_r.as_mut_ptr() as *mut c_void,\n            input_r.len() as c_int,\n            out_r.as_mut_ptr() as *mut c_void,\n            out_r.len() as c_int,\n        );\n        assert_eq!(rc, rr);\n        assert_eq!(rc, 1);\n        assert_eq!(out_c, out_r);\n        assert_eq!(&out_c[..13], b\"Hello, world!\");\n    }\n}\n\n// A precomputed dynamic huffman deflate stream. This is the result of\n// compressing a buffer using standard zlib raw deflate of moderate size.\n// Generated offline; we only compare C vs Rust outputs.\n// Produced via Python:\n//   import zlib\n//   data = b'The quick brown fox jumps over the lazy dog. ' * 8\n//   c = zlib.compressobj(9, zlib.DEFLATED, -15)\n//   out = c.compress(data) + c.flush()\nconst DYNAMIC_DEFLATE: &[u8] = &[\n    0x0B, 0xC9, 0x48, 0x55, 0x28, 0x2C, 0xCD, 0x4C, 0xCE, 0x56, 0x48, 0x2A, 0xCA, 0x2F, 0xCF, 0x53,\n    0x48, 0xCB, 0xAF, 0x50, 0xC8, 0x2A, 0xCD, 0x2D, 0x28, 0x56, 0xC8, 0x2F, 0x4B, 0x2D, 0x52, 0x28,\n    0x01, 0x4A, 0xE7, 0x24, 0x56, 0x55, 0x2A, 0xA4, 0xE4, 0xA7, 0xEB, 0x29, 0x84, 0x8C, 0x2A, 0x26,\n    0x57, 0x31, 0x00,\n];\n\n// Larger dynamic-huffman deflate: 2000 bytes of pseudorandom input.\n// Python: data = bytes((i*31+7)&0xff for i in range(2000))\n//         c = zlib.compressobj(9, zlib.DEFLATED, -15)\n//         out = c.compress(data) + c.flush()\nconst DYNAMIC_DEFLATE_LARGE: &[u8] = &[\n    0x63, 0x57, 0x73, 0x4D, 0x69, 0x5E, 0x74, 0xF0, 0xC1, 0x7F, 0x39, 0xDB, 0x98, 0xEA, 0x59, 0x3B,\n    0x6F, 0x7C, 0x17, 0x33, 0x0D, 0x29, 0x9E, 0xB4, 0xF1, 0xC2, 0x7B, 0x3E, 0x5D, 0x9F, 0xEC, 0xAE,\n    0x95, 0x27, 0x9E, 0xB3, 0xA9, 0xBA, 0x24, 0x37, 0x2D, 0x3C, 0x70, 0xFF, 0x9F, 0xAC, 0x4D, 0x74,\n    0xD5, 0xCC, 0x1D, 0xD7, 0xBF, 0x89, 0x9A, 0x04, 0x17, 0x4D, 0xDC, 0x70, 0xFE, 0x1D, 0xAF, 0x8E,\n    0x77, 0x56, 0xE7, 0x8A, 0xE3, 0xCF, 0x58, 0x55, 0x9C, 0x93, 0x1A, 0x17, 0xEC, 0xBF, 0xF7, 0x57,\n    0xC6, 0x3A, 0xAA, 0x72, 0xC6, 0xF6, 0x6B, 0x5F, 0x45, 0x8C, 0x83, 0x0A, 0x27, 0xAC, 0x3F, 0xF7,\n    0x96, 0x47, 0xDB, 0x2B, 0xB3, 0x63, 0xF9, 0xB1, 0xA7, 0x2C, 0xCA, 0x4E, 0x89, 0x0D, 0xF3, 0xF7,\n    0xDD, 0xFD, 0x23, 0x6D, 0x15, 0x59, 0x31, 0x7D, 0xDB, 0xD5, 0x2F, 0xC2, 0x46, 0x81, 0x05, 0xFD,\n    0xEB, 0xCE, 0xBE, 0xE1, 0xD6, 0xF2, 0xCC, 0x68, 0x5F, 0x76, 0xF4, 0x09, 0xB3, 0x92, 0x63, 0x42,\n    0xFD, 0xBC, 0xBD, 0x77, 0x7E, 0x4B, 0x59, 0x4