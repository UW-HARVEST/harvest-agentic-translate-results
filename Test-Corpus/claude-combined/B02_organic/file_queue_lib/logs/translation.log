{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_sf64rv5fbsc37pwnsyfjfvds7rcq62xmymmkj5tznzmrc3upyvqa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01GyxQfV2mh6qJX7LBoALkm1","name":"Write","input":{"file_path":"/tmp/harvest-translate-55bNCM/translated_rust/tests/ffi_compare.rs","content":"//! Integration tests that load both the C-built and Rust-built shared\n//! libraries via libloading and compare their behavior byte-for-byte.\n\nuse std::ffi::CString;\nuse std::io::Write;\nuse std::os::raw::{c_char, c_int, c_uint, c_void};\nuse std::path::PathBuf;\n\nuse libloading::{Library, Symbol};\n\n// ---- Mirror of C public types --------------------------------------------\n\n#[repr(C)]\n#[derive(Debug)]\npub struct AlertData {\n    pub rule: c_uint,\n    pub level: c_uint,\n    pub alertid: *mut c_char,\n    pub date: *mut c_char,\n    pub location: *mut c_char,\n    pub comment: *mut c_char,\n    pub group: *mut c_char,\n    pub srcip: *mut c_char,\n    pub srcport: c_int,\n    pub dstip: *mut c_char,\n    pub dstport: c_int,\n    pub user: *mut c_char,\n    pub filename: *mut c_char,\n}\n\nunsafe fn cstr_to_opt(p: *const c_char) -> Option<Vec<u8>> {\n    if p.is_null() {\n        None\n    } else {\n        let mut n = 0usize;\n        while *p.add(n) != 0 {\n            n += 1;\n        }\n        let slice = std::slice::from_raw_parts(p as *const u8, n);\n        Some(slice.to_vec())\n    }\n}\n\n#[derive(Debug, PartialEq, Eq)]\nstruct AlertSnapshot {\n    rule: c_uint,\n    level: c_uint,\n    alertid: Option<Vec<u8>>,\n    date: Option<Vec<u8>>,\n    location: Option<Vec<u8>>,\n    comment: Option<Vec<u8>>,\n    group: Option<Vec<u8>>,\n    srcip: Option<Vec<u8>>,\n    srcport: c_int,\n    dstip: Option<Vec<u8>>,\n    dstport: c_int,\n    user: Option<Vec<u8>>,\n    filename: Option<Vec<u8>>,\n}\n\nunsafe fn snapshot(p: *const AlertData) -> Option<AlertSnapshot> {\n    if p.is_null() {\n        return None;\n    }\n    let d = &*p;\n    Some(AlertSnapshot {\n        rule: d.rule,\n        level: d.level,\n        alertid: cstr_to_opt(d.alertid),\n        date: cstr_to_opt(d.date),\n        location: cstr_to_opt(d.location),\n        comment: cstr_to_opt(d.comment),\n        group: cstr_to_opt(d.group),\n        srcip: cstr_to_opt(d.srcip),\n        srcport: d.srcport,\n        dstip: cstr_to_opt(d.dstip),\n        dstport: d.dstport,\n        user: cstr_to_opt(d.user),\n        filename: cstr_to_opt(d.filename),\n    })\n}\n\n// ---- Library helpers ------------------------------------------------------\n\nfn c_lib_path() -> PathBuf {\n    let mut p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    p.push(\"c_src\");\n    p.push(\"build\");\n    p.push(\"libdriver.so\");\n    p\n}\n\nfn rust_lib_path() -> PathBuf {\n    let mut p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    p.push(\"target\");\n    p.push(\"release\");\n    p.push(\"libdriver.so\");\n    p\n}\n\nstruct LibBundle {\n    _lib: Library,\n}\n\nimpl LibBundle {\n    unsafe fn load(path: &PathBuf) -> Self {\n        let lib = Library::new(path).expect(\"failed to open library\");\n        Self { _lib: lib }\n    }\n\n    unsafe fn get<T>(&self, name: &[u8]) -> Symbol<'_, T> {\n        self._lib.get(name).expect(\"symbol not found\")\n    }\n}\n\n// ---- Helpers to call exported functions ----------------------------------\n\ntype DriverFn = unsafe extern \"C\" fn(c_int, c_int, c_int, c_uint, c_int) -> *mut AlertData;\ntype FreeAlertDataFn = unsafe extern \"C\" fn(*mut AlertData);\ntype GetAlertDataFn = unsafe extern \"C\" fn(c_int, *mut libc::FILE) -> *mut AlertData;\ntype OsCallocFn = unsafe extern \"C\" fn(libc::size_t, libc::size_t) -> *mut c_void;\ntype OsReallocFn = unsafe extern \"C\" fn(*mut c_void, libc::size_t) -> *mut c_void;\ntype OsStrdupFn = unsafe extern \"C\" fn(*const c_char) -> *mut c_char;\n\n// ---- Tests ----------------------------------------------------------------\n\n/// Returns (c_lib, rust_lib).\nunsafe fn load_pair() -> (LibBundle, LibBundle) {\n    let c_path = c_lib_path();\n    assert!(c_path.exists(), \"C library not built at {:?}\", c_path);\n    let rust_path = rust_lib_path();\n    assert!(rust_path.exists(), \"Rust library not built at {:?}\", rust_path);\n    (LibBundle::load(&c_path), LibBundle::load(&rust_path))\n}\n\n#[test]\nfn os_calloc_works_in_both() {\n    unsafe {\n        let (cl, rl) = load_pair();\n        let c_calloc: Symbol<OsCallocFn> = cl.get(b\"os_calloc\");\n        let r_calloc: Symbol<OsCallocFn> = rl.get(b\"os_calloc\");\n\n        let pc = c_calloc(4, 8);\n        let pr = r_calloc(4, 8);\n        assert!(!pc.is_null());\n        assert!(!pr.is_null());\n        // Both should be zero-initialized regions of 32 bytes.\n        let cs = std::slice::from_raw_parts(pc as *const u8, 32);\n        let rs = std::slice::from_raw_parts(pr as *const u8, 32);\n        assert_eq!(cs, &[0u8; 32]);\n        assert_eq!(rs, &[0u8; 32]);\n        libc::free(pc);\n        libc::free(pr);\n    }\n}\n\n#[test]\nfn os_strdup_matches() {\n    unsafe {\n        let (cl, rl) = load_pair();\n        let c_dup: Symbol<OsStrdupFn> = cl.get(b\"os_strdup\");\n        let r_dup: Symbol<OsStrdupFn> = rl.get(b\"os_strdup\");\n\n        let s = CString::new(\"hello world\").unwrap();\n        let cdup = c_dup(s.as_ptr());\n        let rdup = r_dup(s.as_ptr());\n\n        let cb = cstr_to_opt(cdup).unwrap();\n        let rb = cstr_to_opt(rdup).unwrap();\n        assert_eq!(cb, rb);\n        assert_eq!(cb, b\"hello world\");\n\n        libc::free(cdup as *mut c_void);\n        libc::free(rdup as *mut c_void);\n    }\n}\n\n#[test]\nfn os_realloc_matches() {\n    unsafe {\n        let (cl, rl) = load_pair();\n        let c_calloc: Symbol<OsCallocFn> = cl.get(b\"os_calloc\");\n        let r_calloc: Symbol<OsCallocFn> = rl.get(b\"os_calloc\");\n        let c_realloc: Symbol<OsReallocFn> = cl.get(b\"os_realloc\");\n        let r_realloc: Symbol<OsReallocFn> = rl.get(b\"os_realloc\");\n\n        let pc = c_calloc(1, 4);\n        let pr = r_calloc(1, 4);\n        let pc2 = c_realloc(pc, 64);\n        let pr2 = r_realloc(pr, 64);\n        assert!(!pc2.is_null());\n        assert!(!pr2.is_null());\n        libc::free(pc2);\n        libc::free(pr2);\n    }\n}\n\n// ---- GetAlertData behavior tests -----------------------------------------\n\n/// Helper: write a string to a temp file and return a FILE* opened\n/// for reading (using libc::fopen).\nunsafe fn open_with_contents(contents: &[u8]) -> (*mut libc::FILE, tempfile::NamedTempFile) {\n    let mut tf = tempfile::NamedTempFile::new().unwrap();\n    tf.write_all(contents).unwrap();\n    tf.flush().unwrap();\n    let p = tf.path();\n    let cp = CString::new(p.to_str().unwrap()).unwrap();\n    let mode = CString::new(\"r\").unwrap();\n    let fp = libc::fopen(cp.as_ptr(), mode.as_ptr());\n    assert!(!fp.is_null());\n    (fp, tf)\n}\n\nfn run_get_alert_data(flag: c_int, contents: &[u8]) -> (Option<AlertSnapshot>, Option<AlertSnapshot>) {\n    unsafe {\n        let (cl, rl) = load_pair();\n        let c_fn: Symbol<GetAlertDataFn> = cl.get(b\"GetAlertData\");\n        let r_fn: Symbol<GetAlertDataFn> = rl.get(b\"GetAlertData\");\n        let c_free: Symbol<FreeAlertDataFn> = cl.get(b\"FreeAlertData\");\n        let r_free: Symbol<FreeAlertDataFn> = rl.get(b\"FreeAlertData\");\n\n        let (cfp, _t1) = open_with_contents(contents);\n        let (rfp, _t2) = open_with_contents(contents);\n\n        let cp = c_fn(flag, cfp);\n        let rp = r_fn(flag, rfp);\n\n        let cs = snapshot(cp);\n        let rs = snapshot(rp);\n\n        if !cp.is_null() {\n            c_free(cp);\n        }\n        if !rp.is_null() {\n            r_free(rp);\n        }\n\n        libc::fclose(cfp);\n        libc::fclose(rfp);\n\n        (cs, rs)\n    }\n}\n\n#[test]\nfn get_alert_data_empty_returns_null() {\n    let (c, r) = run_get_alert_data(0, b\"\");\n    assert!(c.is_none());\n    assert!(r.is_none());\n}\n\n#[test]\nfn get_alert_data_basic_alert() {\n    // Minimal alert that exercises the typical parse path.\n    let contents = b\"\\\n** Alert 1234.5678: - syscheck,\n2024 Jan 02 03:04:05 hostname->location\nRule: 550 (level 7) -> 'File integrity issue'\nSrc IP: 1.2.3.4\nSrc Port: 22\nDst IP: 5.6.7.8\nDst Port: 80\nUser: alice\nIntegrity checksum changed for: '/etc/passwd'\nSome additional log line\n\";\n    let (c, r) = run_get_alert_data(0, contents);\n    assert_eq!(c, r, \"C and Rust GetAlertData differ\");\n    assert!(c.is_some(), \"expected an alert to be returned\");\n    let s = c.unwrap();\n    assert_eq!(s.rule, 550);\n    assert_eq!(s.level, 7);\n    assert_eq!(s.srcport, 22);\n    assert_eq!(s.dstport, 80);\n    assert_eq!(s.alertid.as_deref(), Some(&b\"1234.5678\"[..]));\n    assert_eq!(s.group.as_deref(), Some(&b\"syscheck,\"[..]));\n    assert_eq!(s.comment.as_deref(), Some(&b\"File integrity issue\"[..]));\n    assert_eq!(s.srcip.as_deref(), Some(&b\"1.2.3.4\"[..]));\n    assert_eq!(s.dstip.as_deref(), Some(&b\"5.6.7.8\"[..]));\n    assert_eq!(s.user.as_deref(), Some(&b\"alice\"[..]));\n    assert_eq!(s.filename.as_deref(), Some(&b\"/etc/passwd\"[..]));\n}\n\n#[test]\nfn get_alert_data_two_alerts_returns_first() {\n    let contents = b\"\\\n** Alert 0001.0001: - testing\n2024 Mar 10 12:00:00 host->/var/log/auth.log\nRule: 100 (level 5) -> 'first alert'\nSrc IP: 10.0.0.1\n** Alert 0002.0002: - testing\n2024 Mar 10 12:00:01 host->/var/log/auth.log\nRule: 200 (level 6) -> 'second alert'\n\";\n    let (c, r) = run_get_alert_data(0, contents);\n    assert_eq!(c, r);\n    let s = c.expect(\"first alert\");\n    assert_eq!(s.rule, 100);\n    assert_eq!(s.level, 5);\n    assert_eq!(s.alertid.as_deref(), Some(&b\"0001.0001\"[..]));\n    assert_eq!(s.comment.as_deref(), Some(&b\"first alert\"[..]));\n}\n\n#[test]\nfn get_alert_data_mail_flag_filters() {\n    // Without the mail header, MAIL_SET should reject the alert (the parser\n    // will continue past the alert begin and fail to find date/location).\n    let no_mail = b\"\\\n** Alert 11.22: - foo\n2024 Apr 01 00:00:00 host->loc\nRule: 1 (level 1) -> 'x'\n\";\n    let (c, r) = run_get_alert_data(0x001, no_mail);\n    assert_eq!(c, r);\n}\n\n#[test]\nfn get_alert_data_with_mail_keyword_parses() {\n    let with_mail = b\"\\\n** Alert 11.22: mail - foo\n2024 Apr 01 00:00:00 host->loc\nRule: 1 (level 1) -> 'x'\n\";\n    let (c, r) = run_get_alert_data(0x001, with_mail);\n    assert_eq!(c, r);\n    let s = c.expect(\"alert with mail\");\n    assert_eq!(s.rule, 1);\n    assert_eq!(s.level, 1);\n    assert_eq!(s.comment.as_deref(), Some(&b\"x\"[..]));\n}\n\n#[test]\nfn get_alert_data_no_colon_skips() {\n    // Missing ':' -> continue skipping\n    let contents = b\"** Alert no_colon_here\\nrandom text\\n\";\n    let (c, r) = run_get_alert_data(0, contents);\n    assert_eq!(c, r);\n    assert!(c.is_none());\n}\n\n#[test]\nfn get_alert_data_truncated_after_alert_begin() {\n    // EOF before reaching state 2 -> returns NULL\n    let contents = b\"** Alert 9.9: - g\\n\";\n    let (c, r) = run_get_alert_data(0, contents);\n    assert_eq!(c, r);\n    assert!(c.is_none());\n}\n\n#[test]\nfn get_alert_data_no_group_dash() {\n    // Alert begin with colon but no '-' so group is not set.\n    let contents = b\"\\\n** Alert 9.9 nodash\n2024 Apr 01 00:00:00 host->loc\nRule: 1 (level 1) -> 'x'\n\";\n    let (c, r) = run_get_alert_data(0, contents);\n    assert_eq!(c, r);\n}\n\n// ---- driver() entrypoint test --------------------------------------------\n\n/// driver() opens \"alerts.log\" in the cwd. Set up an alerts.log in a temp\n/// dir, chdir into it, and call driver(). Then chdir back.\n#[test]\nfn driver_reads_alert_from_cwd_alerts_log() {\n    unsafe {\n        let (cl, rl) = load_pair();\n        let c_fn: Symbol<DriverFn> = cl.get(b\"driver\");\n        let r_fn: Symbol<DriverFn> = rl.get(b\"driver\");\n        let c_free: Symbol<FreeAlertDataFn> = cl.get(b\"FreeAlertData\");\n        let r_free: Symbol<FreeAlertDataFn> = rl.get(b\"FreeAlertData\");\n\n        let alert = b\"\\\n** Alert 7777.7777: - syscheck\n2024 May 30 10:11:12 host->/etc\nRule: 555 (level 9) -> 'driver test'\nSrc IP: 9.9.9.9\nSrc Port: 1\nDst IP: 8.8.8.8\nDst Port: 2\nUser: bob\nIntegrity checksum changed for: '/etc/hosts'\ntrailing log line\n\";\n        // Run inside a temp dir with alerts.log.\n        let tmp = tempfile::tempdir().unwrap();\n        std::fs::write(tmp.path().join(\"alerts.log\"), alert).unwrap();\n\n        // Save and switch cwd; we'll restore it manually.\n        let orig_cwd = std::env::current_dir().unwrap();\n        std::env::set_current_dir(tmp.path()).unwrap();\n\n        let cres = c_fn(30, 4, 124, 1, 0x004); // CRALERT_READ_ALL\n        let rres = r_fn(30, 4, 124, 1, 0x004);\n\n        // Restore cwd before doing any potentially failing assertions.\n        std::env::set_current_dir(&orig_cwd).unwrap();\n\n        let cs = snapshot(cres);\n        let rs = snapshot(rres);\n        if !cres.is_null() {\n            c_free(cres);\n        }\n        if !rres.is_null() {\n            r_free(rres);\n        }\n\n        assert_eq!(cs, rs, \"driver() outputs differ\");\n        let s = cs.expect(\"driver should return an alert\");\n        assert_eq!(s.rule, 555);\n        assert_eq!(s.level, 9);\n        assert_eq!(s.alertid.as_deref(), Some(&b\"7777.7777\"[..]));\n        assert_eq!(s.user.as_deref(), Some(&b\"bob\"[..]));\n        assert_eq!(s.filename.as_deref(), Some(&b\"/etc/hosts\"[..]));\n    }\n}\n\n// ---- Symbol parity test --------------------------------------------------\n\n#[test]\nfn rust_exports_match_c_exports() {\n    let c = c_lib_path();\n    let r = rust_lib_path();\n\n    let c_syms = exported_symbols(&c);\n    let r_syms = exported_symbols(&r);\n\n    let expected = [\n        \"driver\",\n        \"FreeAlertData\",\n        \"GetAlertData\",\n        \"Init_FileQueue\",\n        \"Read_FileMon\",\n        \"merror\",\n        \"os_calloc\",\n        \"os_realloc\",\n        \"os_strdup\",\n    ];\n    for s in expected {\n        assert!(c_syms.contains(s), \"C lib missing {}\", s);\n        assert!(r_syms.contains(s), \"Rust lib missing {} (only has {:?})\", s, r_syms);\n    }\n}\n\nfn exported_symbols(p: &std::path::Path) -> std::collections::HashSet<String> {\n    let out = std::process::Command::new(\"nm\")\n        .arg(\"-D\")\n        .arg(p)\n        .output()\n        .expect(\"nm\");\n    let stdout = String::from_utf8_lossy(&out.stdout);\n    let mut set = std::collections::HashSet::new();\n    for line in stdout.lines() {\n        // \" <addr> T name\" or \" <addr> W name\"\n        let parts: Vec<&str> = line.split_whitespace().collect();\n        if parts.len() >= 3 {\n            let kind = parts[parts.len() - 2];\n            if matches!(kind, \"T\" | \"W\" | \"B\" | \"D\" | \"R\") {\n                set.insert(parts[parts.len() - 1].to_string());\n            }\n        }\n    }\n    set\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":160,"cache_read_input_tokens":42230,"cache_creation":{"ephemeral_5m_input_tokens":160,"ephemeral_1h_input_tokens":0},"output_tokens":22,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"3137f746-2e9e-4d1b-81e6-f72e5273f032","uuid":"e4abd25f-81fb-44bc-b062-d25f5a2623cd"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01GyxQfV2mh6qJX7LBoALkm1","type":"tool_result","content":"File created successfully at: /tmp/harvest-translate-55bNCM/translated_rust/tests/ffi_compare.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"3137f746-2e9e-4d1b-81e6-f72e5273f032","uuid":"8394ea4b-ac68-4aa4-a760-f795c7b60ce5","timestamp":"2026-05-30T00:28:40.813Z","tool_use_result":{"type":"create","filePath":"/tmp/harvest-translate-55bNCM/translated_rust/tests/ffi_compare.rs","content":"//! Integration tests that load both the C-built and Rust-built shared\n//! libraries via libloading and compare their behavior byte-for-byte.\n\nuse std::ffi::CString;\nuse std::io::Write;\nuse std::os::raw::{c_char, c_int, c_uint, c_void};\nuse std::path::PathBuf;\n\nuse libloading::{Library, Symbol};\n\n// ---- Mirror of C public types --------------------------------------------\n\n#[repr(C)]\n#[derive(Debug)]\npub struct AlertData {\n    pub rule: c_uint,\n    pub level: c_uint,\n    pub alertid: *mut c_char,\n    pub date: *mut c_char,\n    pub location: *mut c_char,\n    pub comment: *mut c_char,\n    pub group: *mut c_char,\n    pub srcip: *mut c_char,\n    pub srcport: c_int,\n    pub dstip: *mut c_char,\n    pub dstport: c_int,\n    pub user: *mut c_char,\n    pub filename: *mut c_char,\n}\n\nunsafe fn cstr_to_opt(p: *const c_char) -> Option<Vec<u8>> {\n    if p.is_null() {\n        None\n    } else {\n        let mut n = 0usize;\n        while *p.add(n) != 0 {\n            n += 1;\n        }\n        let slice = std::slice::from_raw_parts(p as *const u8, n);\n        Some(slice.to_vec())\n    }\n}\n\n#[derive(Debug, PartialEq, Eq)]\nstruct AlertSnapshot {\n    rule: c_uint,\n    level: c_uint,\n    alertid: Option<Vec<u8>>,\n    date: Option<Vec<u8>>,\n    location: Option<Vec<u8>>,\n    comment: Option<Vec<u8>>,\n    group: Option<Vec<u8>>,\n    srcip: Option<Vec<u8>>,\n    srcport: c_int,\n    dstip: Option<Vec<u8>>,\n    dstport: c_int,\n    user: Option<Vec<u8>>,\n    filename: Option<Vec<u8>>,\n}\n\nunsafe fn snapshot(p: *const AlertData) -> Option<AlertSnapshot> {\n    if p.is_null() {\n        return None;\n    }\n    let d = &*p;\n    Some(AlertSnapshot {\n        rule: d.rule,\n        level: d.level,\n        alertid: cstr_to_opt(d.alertid),\n        date: cstr_to_opt(d.date),\n        location: cstr_to_opt(d.location),\n        comment: cstr_to_opt(d.comment),\n        group: cstr_to_opt(d.group),\n        srcip: cstr_to_opt(d.srcip),\n        srcport: d.srcport,\n        dstip: cstr_to_opt(d.dstip),\n        dstport: d.dstport,\n        user: cstr_to_opt(d.user),\n        filename: cstr_to_opt(d.filename),\n    })\n}\n\n// ---- Library helpers ------------------------------------------------------\n\nfn c_lib_path() -> PathBuf {\n    let mut p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    p.push(\"c_src\");\n    p.push(\"build\");\n    p.push(\"libdriver.so\");\n    p\n}\n\nfn rust_lib_path() -> PathBuf {\n    let mut p = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n    p.push(\"target\");\n    p.push(\"release\");\n    p.push(\"libdriver.so\");\n    p\n}\n\nstruct LibBundle {\n    _lib: Library,\n}\n\nimpl LibBundle {\n    unsafe fn load(path: &PathBuf) -> Self {\n        let lib = Library::new(path).expect(\"failed to open library\");\n        Self { _lib: lib }\n    }\n\n    unsafe fn get<T>(&self, name: &[u8]) -> Symbol<'_, T> {\n        self._lib.get(name).expect(\"symbol not found\")\n    }\n}\n\n// ---- Helpers to call exported functions ----------------------------------\n\ntype DriverFn = unsafe extern \"C\" fn(c_int, c_int, c_int, c_uint, c_int) -> *mut AlertData;\ntype FreeAlertDataFn = unsafe extern \"C\" fn(*mut AlertData);\ntype GetAlertDataFn = unsafe extern \"C\" fn(c_int, *mut libc::FILE) -> *mut AlertData;\ntype OsCallocFn = unsafe extern \"C\" fn(libc::size_t, libc::size_t) -> *mut c_void;\ntype OsReallocFn = unsafe extern \"C\" fn(*mut c_void, libc::size_t) -> *mut c_void;\ntype OsStrdupFn = unsafe extern \"C\" fn(*const c_char) -> *mut c_char;\n\n// ---- Tests ----------------------------------------------------------------\n\n/// Returns (c_lib, rust_lib).\nunsafe fn load_pair() -> (LibBundle, LibBundle) {\n    let c_path = c_lib_path();\n    assert!(c_path.exists(), \"C library not built at {:?}\", c_path);\n    let rust_path = rust_lib_path();\n    assert!(rust_path.exists(), \"Rust library not built at {:?}\", rust_path);\n    (LibBundle::load(&c_path), LibBundle::load(&rust_path))\n}\n\n#[test]\nfn os_calloc_works_in_both() {\n    unsafe {\n        let (cl, rl) = load_pair();\n        let c_calloc: Symbol<OsCallocFn> = cl.get(b\"os_calloc\");\n        let r_calloc: Symbol<OsCallocFn> = rl.get(b\"os_calloc\");\n\n        let pc = c_calloc(4, 8);\n        let pr = r_calloc(4, 8);\n        assert!(!pc.is_null());\n        assert!(!pr.is_null());\n        // Both should be zero-initialized regions of 32 bytes.\n        let cs = std::slice::from_raw_parts(pc as *const u8, 32);\n        let rs = std::slice::from_raw_parts(pr as *const u8, 32);\n        assert_eq!(cs, &[0u8; 32]);\n        assert_eq!(rs, &[0u8; 32]);\n        libc::free(pc);\n        libc::free(pr);\n    }\n}\n\n#[test]\nfn os_strdup_matches() {\n    unsafe {\n        let (cl, rl) = load_pair();\n        let c_dup: Symbol<OsStrdupFn> = cl.get(b\"os_strdup\");\n        let r_dup: Symbol<OsStrdupFn> = rl.get(b\"os_strdup\");\n\n        let s = CString::new(\"hello world\").unwrap();\n        let cdup = c_dup(s.as_ptr());\n        let rdup = r_dup(s.as_ptr());\n\n        let cb = cstr_to_opt(cdup).unwrap();\n        let rb = cstr_to_opt(rdup).unwrap();\n        assert_eq!(cb, rb);\n        assert_eq!(cb, b\"hello world\");\n\n        libc::free(cdup as *mut c_void);\n        libc::free(rdup as *mut c_void);\n    }\n}\n\n#[test]\nfn os_realloc_matches() {\n    unsafe {\n        let (cl, rl) = load_pair();\n        let c_calloc: Symbol<OsCallocFn> = cl.get(b\"os_calloc\");\n        let r_calloc: Symbol<OsCallocFn> = rl.get(b\"os_calloc\");\n        let c_realloc: Symbol<OsReallocFn> = cl.get(b\"os_realloc\");\n        let r_realloc: Symbol<OsReallocFn> = rl.get(b\"os_realloc\");\n\n        let pc = c_calloc(1, 4);\n        let pr = r_calloc(1, 4);\n        let pc2 = c_realloc(pc, 64);\n        let pr2 = r_realloc(pr, 64);\n        assert!(!pc2.is_null());\n        assert!(!pr2.is_null());\n        libc::free(pc2);\n        libc::free(pr2);\n    }\n}\n\n// ---- GetAlertData behavior tests -----------------------------------------\n\n/// Helper: write a string to a temp file and return a FILE* opened\n/// for reading (using libc::fopen).\nunsafe fn open_with_contents(contents: &[u8]) -> (*mut libc::FILE, tempfile::NamedTempFile) {\n    let mut tf = tempfile::NamedTempFile::new().unwrap();\n    tf.write_all(contents).unwrap();\n    tf.flush().unwrap();\n    let p = tf.path();\n    let cp = CString::new(p.to_str().unwrap()).unwrap();\n    let mode = CString::new(\"r\").unwrap();\n    let fp = libc::fopen(cp.as_ptr(), mode.as_ptr());\n    assert!(!fp.is_null());\n    (fp, tf)\n}\n\nfn run_get_alert_data(flag: c_int, contents: &[u8]) -> (Option<AlertSnapshot>, Option<AlertSnapshot>) {\n    unsafe {\n        let (cl, rl) = load_pair();\n        let c_fn: Symbol<GetAlertDataFn> = cl.get(b\"GetAlertData\");\n        let r_fn: Symbol<GetAlertDataFn> = rl.get(b\"GetAlertData\");\n        let c_free: Symbol<FreeAlertDataFn> = cl.get(b\"FreeAlertData\");\n        let r_free: Symbol<FreeAlertDataFn> = rl.get(b\"FreeAlertData\");\n\n        let (cfp, _t1) = open_with_contents(contents);\n        let (rfp, _t2) = open_with_contents(contents);\n\n        let cp = c_fn(flag, cfp);\n        let rp = r_fn(flag, rfp);\n\n        let cs = snapshot(cp);\n        let rs = snapshot(rp);\n\n        if !cp.is_null() {\n            c_free(cp);\n        }\n        if !rp.is_null() {\n            r_free(rp);\n        }\n\n        libc::fclose(cfp);\n        libc::fclose(rfp);\n\n        (cs, rs)\n    }\n}\n\n#[test]\nfn get_alert_data_empty_returns_null() {\n    let (c, r) = run_get_alert_data(0, b\"\");\n    assert!(c.is_none());\n    assert!(r.is_none());\n}\n\n#[test]\nfn get_alert_data_basic_alert() {\n    // Minimal alert that exercises the typical parse path.\n    let contents = b\"\\\n** Alert 1234.5678: - syscheck,\n2024 Jan 02 03:04:05 hostname->location\nRule: 550 (level 7) -> 'File integrity issue'\nSrc IP: 1.2.3.4\nSrc Port: 22\nDst IP: 5.6.7.8\nDst Port: 80\nUser: alice\nIntegrity checksum changed for: '/etc/passwd'\nSome additional log line\n\";\n    let (c, r) = run_get_alert_data(0, contents);\n    assert_eq!(c, r, \"C and Rust GetAlertData differ\");\n    assert!(c.is_some(), \"expected an alert to be returned\");\n    let s = c.unwrap();\n    assert_eq!(s.rule, 550);\n    assert_eq!(s.level, 7);\n    assert_eq!(s.srcport, 22);\n    assert_eq!(s.dstport, 80);\n    assert_eq!(s.alertid.as_deref(), Some(&b\"1234.5678\"[..]));\n    assert_eq!(s.group.as_deref(), Some(&b\"syscheck,\"[..]));\n    assert_eq!(s.comment.as_deref(), Some(&b\"File integrity issue\"[..]));\n    assert_eq!(s.srcip.as_deref(), Some(&b\"1.2.3.4\"[..]));\n    assert_eq!(s.dstip.as_deref(), Some(&b\"5.6.7.8\"[..]));\n    assert_eq!(s.user.as_deref(), Some(&b\"alice\"[..]));\n    assert_eq!(s.filename.as_deref(), Some(&b\"/etc/passwd\"[..]));\n}\n\n#[test]\nfn get_alert_data_two_alerts_returns_first() {\n    let contents = b\"\\\n** Alert 0001.0001: - testing\n2024 Mar 10 12:00:00 host->/var/log/auth.log\nRule: 100 (level 5) -> 'first alert'\nSrc IP: 10.0.0.1\n** Alert 0002.0002: - testing\n2024 Mar 10 12:00:01 host->/var/log/auth.log\nRule: 200 (level 6) -> 'second alert'\n\";\n    let (c, r) = run_get_alert_data(0, contents);\n    assert_eq!(c, r);\n    let s = c.expect(\"first alert\");\n    assert_eq!(s.rule, 100);\n    assert_eq!(s.level, 5);\n    assert_eq!(s.alertid.as_deref(), Some(&b\"0001.0001\"[..]));\n    assert_eq!(s.comment.as_deref(), Some(&b\"first alert\"[..]));\n}\n\n#[test]\nfn get_alert_data_mail_flag_filters() {\n    // Without the mail header, MAIL_SET should reject the alert (the parser\n    // will continue past the alert begin and fail to find date/location).\n    let no_mail = b\"\\\n** Alert 11.22: - foo\n2024 Apr 01 00:00:00 host->loc\nRule: 1 (level 1) -> 'x'\n\";\n    let (c, r) = run_get_alert_data(0x001, no_mail);\n    assert_eq!(c, r);\n}\n\n#[test]\nfn get_alert_data_with_mail_keyword_parses() {\n    let with_mail = b\"\\\n** Alert 11.22: mail - foo\n2024 Apr 01 00:00:00 host->loc\nRule: 1 (level 1) -> 'x'\n\";\n    let (c, r) = run_get_alert_data(0x001, with_mail);\n    assert_eq!(c, r);\n    let s = c.expect(\"alert with mail\");\n    assert_eq!(s.rule, 1);\n    assert_eq!(s.level, 1);\n    assert_eq!(s.comment.as_deref(), Some(&b\"x\"[..]));\n}\n\n#[test]\nfn get_alert_data_no_colon_skips() {\n    // Missing ':' -> continue skipping\n    let contents = b\"** Alert no_colon_here\\nrandom text\\n\";\n    let (c, r) = run_get_alert_data(0, contents);\n    assert_eq!(c, r);\n    assert!(c.is_none());\n}\n\n#[test]\nfn get_alert_data_truncated_after_alert_begin() {\n    // EOF before reaching state 2 -> returns NULL\n    let contents = b\"** Alert 9.9: - g\\n\";\n    let (c, r) = run_get_alert_data(0, contents);\n    assert_eq!(c, r);\n    assert!(c.is_none());\n}\n\n#[test]\nfn get_alert_data_no_group_dash() {\n    // Alert begin with colon but no '-' so group is not set.\n    let contents = b\"\\\n** Alert 9.9 nodash\n2024 Apr 01 00:00:00 host->loc\nRule: 1 (level 1) -> 'x'\n\";\n    let (c, r) = run_get_alert_data(0, contents);\n    assert_eq!(c, r);\n}\n\n// ---- driver() entrypoint test --------------------------------------------\n\n/// driver() opens \"alerts.log\" in the cwd. Set up an alerts.log in a temp\n/// dir, chdir into it, and call driver(). Then chdir back.\n#[test]\nfn driver_reads_alert_from_cwd_alerts_log() {\n    unsafe {\n        let (cl, rl) = load_pair();\n        let c_fn: Symbol<DriverFn> = cl.get(b\"driver\");\n        let r_fn: Symbol<DriverFn> = rl.get(b\"driver\");\n        let c_free: Symbol<FreeAlertDataFn> = cl.get(b\"FreeAlertData\");\n        let r_free: Symbol<FreeAlertDataFn> = rl.get(b\"FreeAlertData\");\n\n        let alert = b\"\\\n** Alert 7777.7777: - syscheck\n2024 May 30 10:11:12 host->/etc\nRule: 555 (level 9) -> 'driver test'\nSrc IP: 9.9.9.9\nSrc Port: 1\nDst IP: 8.8.8.8\nDst Port: 2\nUser: bob\nIntegrity checksum changed for: '/etc/hosts'\ntrailing log line\n\";\n        // Run inside a temp dir with alerts.log.\n        let tmp = tempfile::tempdir().unwrap();\n        std::fs::write(tmp.path().join(\"alerts.log\"), alert).unwrap();\n\n        // Save and switch cwd; we'll restore it manually.\n        let orig_cwd = std::env::current_dir().unwrap();\n        std::env::set_current_dir(tmp.path()).unwrap();\n\n        let cres = c_fn(30, 4, 124, 1, 0x004); // CRALERT_READ_ALL\n        let rres = r_fn(30, 4, 124, 1, 0x004);\n\n        // Restore cwd before doing any potentially failing assertions.\n        std::env::set_current_dir(&orig_cwd).unwrap();\n\n        let cs = snapshot(cres);\n        let rs = snapshot(rres);\n        if !cres.is_null() {\n            c_free(cres);\n        }\n        if !rres.is_null() {\n            r_free(rres);\n        }\n\n        assert_eq!(cs, rs, \"driver() outputs differ\");\n        let s = cs.expect(\"driver should return an alert\");\n        assert_eq!(s.rule, 555);\n        assert_eq!(s.level, 9);\n        assert_eq!(s.alertid.as_deref(), Some(&b\"7777.7777\"[..]));\n        assert_eq!(s.user.as_deref(), Some(&b\"bob\"[..]));\n        assert_eq!(s.filename.as_deref(), Some(&b\"/etc/hosts\"[..]));\n    }\n}\n\n// ---- Symbol parity test --------------------------------------------------\n\n#[test]\nfn rust_exports_match_c_exports() {\n    let c = c_lib_path();\n    let r = rust_lib_path();\n\n    let c_syms = exported_symbols(&c);\n    let r_syms = exported_symbols(&r);\n\n    let expected = [\n        \"driver\",\n        \"FreeAlertData\",\n        \"GetAlertData\",\n        \"Init_FileQueue\",\n        \"Read_FileMon\",\n        \"merror\",\n        \"os_calloc\",\n        \"os_realloc\",\n        \"os_strdup\",\n    ];\n    for s in expected {\n        assert!(c_syms.contains(s), \"C lib missing {}\", s);\n        assert!(r_syms.contains(s), \"Rust lib missing {} (only has {:?})\", s, r_syms);\n    }\n}\n\nfn exported_symbols(p: &std::path::Path) -> std::collections::HashSet<String> {\n    let out = std::process::Command::new(\"nm\")\n        .arg(\"-D\")\n        .arg(p)\n        .output()\n        .expect(\"nm\");\n    let stdout = String::from_utf8_lossy(&out.stdout);\n    let mut set = std::collections::HashSet::new();\n    for line in stdout.lines() {\n        // \" <addr> T name\" or \" <addr> W name\"\n        let parts: Vec<&str> = line.split_whitespace().collect();\n        if parts.len() >= 3 {\n            let kind = parts[parts.len() - 2];\n            if matches!(kind, \"T\" | \"W\" | \"B\" | \"D\" | \"R\") {\n                set.insert(parts[parts.len() - 1].to_string());\n            }\n        }\n    }\n    set\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
