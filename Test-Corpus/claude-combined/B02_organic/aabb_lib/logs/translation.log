e as *const _ as *const c_void,\n            C2_TYPE::C2_TYPE_CIRCLE,\n            &aabb as *const _ as *const c_void,\n            C2_TYPE::C2_TYPE_AABB,\n        );\n        assert_eq!(cv, rv);\n\n        let cv = c(\n            &capsule as *const _ as *const c_void,\n            C2_TYPE::C2_TYPE_CAPSULE,\n            &aabb as *const _ as *const c_void,\n            C2_TYPE::C2_TYPE_AABB,\n        );\n        let rv = r(\n            &capsule as *const _ as *const c_void,\n            C2_TYPE::C2_TYPE_CAPSULE,\n            &aabb as *const _ as *const c_void,\n            C2_TYPE::C2_TYPE_AABB,\n        );\n        assert_eq!(cv, rv);\n    }\n}\n\n#[test]\nfn test_aabb_top_level() {\n    let (cl, rl) = load_libs();\n    unsafe {\n        let c: Symbol<extern \"C\" fn(f32, f32, f32, f32) -> c_int> = cl.get(b\"aabb\").unwrap();\n        let r: Symbol<extern \"C\" fn(f32, f32, f32, f32) -> c_int> = rl.get(b\"aabb\").unwrap();\n        let cases = [\n            (-100.0_f32, -100.0_f32, 100.0_f32, 100.0_f32),\n            (0.0, 0.0, 1.0, 1.0),\n            (-50.0, -50.0, -25.0, -25.0),\n            (-25.0, 50.0, 0.0, 110.0),\n            (-90.0, -10.0, -50.0, 10.0),\n            (10.0, 10.0, 20.0, 20.0),\n        ];\n        for &(a, b, c2, d) in &cases {\n            let cv = c(a, b, c2, d);\n            let rv = r(a, b, c2, d);\n            assert_eq!(cv, rv, \"aabb({}, {}, {}, {}): C={}, Rust={}\", a, b, c2, d, cv, rv);\n        }\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
