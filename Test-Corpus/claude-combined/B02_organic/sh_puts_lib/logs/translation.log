ar, c_int, c_void};\nuse std::ptr;\n\nconst C_LIB_PATH: &str = \"c_src/build/libtranslated_rust.so\";\nconst RUST_LIB_PATH: &str = \"target/release/libtranslated_rust.so\";\n\nunsafe fn load_libs() -> (Library, Library) {\n    let c = Library::new(C_LIB_PATH).expect(\"failed to load C lib\");\n    let r = Library::new(RUST_LIB_PATH).expect(\"failed to load Rust lib\");\n    (c, r)\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":725,"cache_read_input_tokens":74021,"cache_creation":{"ephemeral_5m_input_tokens":725,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"40464834-aa92-47dc-801d-9cab741a9315","uuid":"8ea68e45-f0fc-4e49-8bf8-490fceaf55f7"}
