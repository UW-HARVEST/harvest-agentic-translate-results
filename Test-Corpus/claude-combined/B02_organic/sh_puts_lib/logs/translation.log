{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_3uj5xxpikkinf3z7nihkwwqzuqal4yej5k27oikr7huourkcfqha","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01GNXYtRjft3U1XPvDLaAgg5","name":"Write","input":{"file_path":"/tmp/harvest-translate-PvhLnS/translated_rust/tests/ffi_compare.rs","content":"// FFI integration tests: load both the C and Rust .so and compare.\n\nuse libloading::{Library, Symbol};\nuse std::ffi::{c_char, c_int, c_void};\nuse std::os::unix::io::FromRawFd;\nuse std::ptr;\n\nconst C_LIB_PATH: &str = \"c_src/build/libtranslated_rust.so\";\nconst RUST_LIB_PATH: &str = \"target/release/libtranslated_rust.so\";\n\nunsafe fn load_libs() -> (Library, Library) {\n    let c = Library::new(C_LIB_PATH).expect(\"failed to load C lib\");\n    let r = Library::new(RUST_LIB_PATH).expect(\"failed to load Rust lib\");\n    (c, r)\n}\n\n// Capture stdout from a callback. Replaces fd 1 with a pipe, runs callback, returns bytes.\nfn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {\n    use std::io::Read;\n    unsafe {\n        // Flush before swapping\n        libc::fflush(ptr::null_mut());\n\n        let mut fds: [c_int; 2] = [0; 2];\n        assert_eq!(libc::pipe(fds.as_mut_ptr()), 0);\n        let (r_fd, w_fd) = (fds[0], fds[1]);\n\n        let saved_stdout = libc::dup(1);\n        assert!(saved_stdout >= 0);\n\n        assert!(libc::dup2(w_fd, 1) >= 0);\n        libc::close(w_fd);\n\n        f();\n\n        libc::fflush(ptr::null_mut());\n        libc::dup2(saved_stdout, 1);\n        libc::close(saved_stdout);\n\n        // Read from r_fd\n        let mut file = std::fs::File::from_raw_fd(r_fd);\n        let mut buf = Vec::new();\n        file.read_to_end(&mut buf).unwrap();\n        buf\n    }\n}\n\n#[test]\nfn test_stbds_hash_string_matches() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<unsafe extern \"C\" fn(*mut c_char, usize) -> usize> =\n            c.get(b\"stbds_hash_string\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(*mut c_char, usize) -> usize> =\n            r.get(b\"stbds_hash_string\").unwrap();\n\n        for s in &[\n            \"\",\n            \"a\",\n            \"test_0\",\n            \"test_1\",\n            \"abcdefghijklmnop\",\n            \"the quick brown fox jumps over the lazy dog\",\n        ] {\n            let mut bytes = s.as_bytes().to_vec();\n            bytes.push(0);\n            for seed in &[0usize, 1, 0x31415926, 0xdeadbeef, 0xffffffffffffffff] {\n                let cv = c_fn(bytes.as_mut_ptr() as *mut c_char, *seed);\n                let rv = r_fn(bytes.as_mut_ptr() as *mut c_char, *seed);\n                assert_eq!(cv, rv, \"mismatch for s={:?} seed={:x}\", s, seed);\n            }\n        }\n    }\n}\n\n#[test]\nfn test_stbds_hash_bytes_matches() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<unsafe extern \"C\" fn(*mut c_void, usize, usize) -> usize> =\n            c.get(b\"stbds_hash_bytes\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(*mut c_void, usize, usize) -> usize> =\n            r.get(b\"stbds_hash_bytes\").unwrap();\n\n        let mut data: Vec<u8> = (0u8..=200).collect();\n        for &len in &[0usize, 1, 4, 7, 8, 9, 15, 16, 32, 64, 100, 200] {\n            for seed in &[0usize, 1, 0x31415926, 0xdeadbeefcafebabe] {\n                let cv = c_fn(data.as_mut_ptr() as *mut c_void, len, *seed);\n                let rv = r_fn(data.as_mut_ptr() as *mut c_void, len, *seed);\n                assert_eq!(cv, rv, \"mismatch for len={} seed={:x}\", len, seed);\n            }\n        }\n    }\n}\n\n#[test]\nfn test_strkey_matches() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<unsafe extern \"C\" fn(c_int) -> *mut c_char> =\n            c.get(b\"strkey\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(c_int) -> *mut c_char> =\n            r.get(b\"strkey\").unwrap();\n\n        for n in &[0i32, 1, 7, 100, 12345, -1, -42] {\n            let cp = c_fn(*n);\n            let rp = r_fn(*n);\n            let cs = std::ffi::CStr::from_ptr(cp).to_owned();\n            let rs = std::ffi::CStr::from_ptr(rp).to_owned();\n            assert_eq!(cs, rs, \"strkey mismatch for n={}\", n);\n        }\n    }\n}\n\n#[test]\nfn test_rand_seed_resets_hash_seed() {\n    // After seeding, hashing nothing-related global state shouldn't differ. Just verify both\n    // libs accept and continue to produce identical hashes for a given seed input.\n    unsafe {\n        let (c, r) = load_libs();\n        let c_seed: Symbol<unsafe extern \"C\" fn(usize)> = c.get(b\"stbds_rand_seed\").unwrap();\n        let r_seed: Symbol<unsafe extern \"C\" fn(usize)> = r.get(b\"stbds_rand_seed\").unwrap();\n        c_seed(0xabcd);\n        r_seed(0xabcd);\n\n        let c_fn: Symbol<unsafe extern \"C\" fn(*mut c_char, usize) -> usize> =\n            c.get(b\"stbds_hash_string\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(*mut c_char, usize) -> usize> =\n            r.get(b\"stbds_hash_string\").unwrap();\n        let mut s = b\"hello\\0\".to_vec();\n        let cv = c_fn(s.as_mut_ptr() as *mut c_char, 0xabcd);\n        let rv = r_fn(s.as_mut_ptr() as *mut c_char, 0xabcd);\n        assert_eq!(cv, rv);\n    }\n}\n\n#[test]\nfn test_sh_puts_output_matches() {\n    unsafe {\n        let (c, r) = load_libs();\n        // Reset seeds so initial hash table seed deterministic.\n        let c_seed: Symbol<unsafe extern \"C\" fn(usize)> = c.get(b\"stbds_rand_seed\").unwrap();\n        let r_seed: Symbol<unsafe extern \"C\" fn(usize)> = r.get(b\"stbds_rand_seed\").unwrap();\n\n        for &n in &[0i32, 1, 2, 5, 10, 100] {\n            c_seed(0x31415926);\n            r_seed(0x31415926);\n\n            let c_fn: Symbol<unsafe extern \"C\" fn(c_int)> = c.get(b\"sh_puts\").unwrap();\n            let r_fn: Symbol<unsafe extern \"C\" fn(c_int)> = r.get(b\"sh_puts\").unwrap();\n\n            let c_out = capture_stdout(|| c_fn(n));\n            let r_out = capture_stdout(|| r_fn(n));\n            assert_eq!(\n                c_out, r_out,\n                \"sh_puts mismatch for n={}: C={:?} R={:?}\",\n                n, c_out, r_out\n            );\n        }\n    }\n}\n\n#[test]\nfn test_arrgrowf_basic() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<unsafe extern \"C\" fn(*mut c_void, usize, usize, usize) -> *mut c_void> =\n            c.get(b\"stbds_arrgrowf\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(*mut c_void, usize, usize, usize) -> *mut c_void> =\n            r.get(b\"stbds_arrgrowf\").unwrap();\n\n        // Allocate a fresh array of c_int, request capacity 4\n        let cp = c_fn(ptr::null_mut(), 4, 0, 4);\n        let rp = r_fn(ptr::null_mut(), 4, 0, 4);\n        // Header at offset -16 from returned pointer (length, capacity, hash_table, temp)\n        // capacity should be 4 in both\n        let c_hdr = (cp as *mut u8).sub(32) as *mut [usize; 4];\n        let r_hdr = (rp as *mut u8).sub(32) as *mut [usize; 4];\n        assert_eq!((*c_hdr)[0], 0); // length\n        assert_eq!((*c_hdr)[1], 4); // capacity\n        assert_eq!((*r_hdr)[0], 0);\n        assert_eq!((*r_hdr)[1], 4);\n\n        // Free\n        let c_free: Symbol<unsafe extern \"C\" fn(*mut c_void)> = c.get(b\"stbds_arrfreef\").unwrap();\n        let r_free: Symbol<unsafe extern \"C\" fn(*mut c_void)> = r.get(b\"stbds_arrfreef\").unwrap();\n        c_free(cp);\n        r_free(rp);\n    }\n}\n\n#[test]\nfn test_stralloc_strreset() {\n    // Just verify it doesn't crash and arenas are equivalent.\n    unsafe {\n        let (c, r) = load_libs();\n\n        // String arena layout: ptr (8), remaining (8), block (1), mode (1), padding -> 24 bytes\n        #[repr(C)]\n        #[derive(Default)]\n        struct Arena {\n            storage: *mut c_void,\n            remaining: usize,\n            block: u8,\n            mode: u8,\n            _pad: [u8; 6],\n        }\n\n        let mut c_arena = Arena {\n            storage: ptr::null_mut(),\n            remaining: 0,\n            block: 0,\n            mode: 0,\n            _pad: [0; 6],\n        };\n        let mut r_arena = Arena {\n            storage: ptr::null_mut(),\n            remaining: 0,\n            block: 0,\n            mode: 0,\n            _pad: [0; 6],\n        };\n\n        let c_alloc: Symbol<unsafe extern \"C\" fn(*mut c_void, *mut c_char) -> *mut c_char> =\n            c.get(b\"stbds_stralloc\").unwrap();\n        let r_alloc: Symbol<unsafe extern \"C\" fn(*mut c_void, *mut c_char) -> *mut c_char> =\n            r.get(b\"stbds_stralloc\").unwrap();\n\n        for s in &[\"hello\", \"world\", \"test_42\", \"longer string for arena allocation\"] {\n            let mut bytes = s.as_bytes().to_vec();\n            bytes.push(0);\n            let cp = c_alloc(\n                &mut c_arena as *mut Arena as *mut c_void,\n                bytes.as_mut_ptr() as *mut c_char,\n            );\n            let rp = r_alloc(\n                &mut r_arena as *mut Arena as *mut c_void,\n                bytes.as_mut_ptr() as *mut c_char,\n            );\n            let cs = std::ffi::CStr::from_ptr(cp);\n            let rs = std::ffi::CStr::from_ptr(rp);\n            assert_eq!(cs, rs, \"stralloc content for {}\", s);\n        }\n        // Compare arena tracking fields\n        assert_eq!(c_arena.remaining, r_arena.remaining);\n        assert_eq!(c_arena.block, r_arena.block);\n        assert_eq!(c_arena.mode, r_arena.mode);\n\n        let c_reset: Symbol<unsafe extern \"C\" fn(*mut c_void)> = c.get(b\"stbds_strreset\").unwrap();\n        let r_reset: Symbol<unsafe extern \"C\" fn(*mut c_void)> = r.get(b\"stbds_strreset\").unwrap();\n        c_reset(&mut c_arena as *mut Arena as *mut c_void);\n        r_reset(&mut r_arena as *mut Arena as *mut c_void);\n        assert_eq!(c_arena.remaining, 0);\n        assert_eq!(r_arena.remaining, 0);\n        assert!(c_arena.storage.is_null());\n        assert!(r_arena.storage.is_null());\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":166,"cache_read_input_tokens":56398,"cache_creation":{"ephemeral_5m_input_tokens":166,"ephemeral_1h_input_tokens":0},"output_tokens":22,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"40464834-aa92-47dc-801d-9cab741a9315","uuid":"213018de-6638-40cb-aa65-66b8aabc44e5"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01GNXYtRjft3U1XPvDLaAgg5","type":"tool_result","content":"File created successfully at: /tmp/harvest-translate-PvhLnS/translated_rust/tests/ffi_compare.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"40464834-aa92-47dc-801d-9cab741a9315","uuid":"481efc2c-0efd-4710-82d9-41d4197bc4cb","timestamp":"2026-05-30T00:56:08.046Z","tool_use_result":{"type":"create","filePath":"/tmp/harvest-translate-PvhLnS/translated_rust/tests/ffi_compare.rs","content":"// FFI integration tests: load both the C and Rust .so and compare.\n\nuse libloading::{Library, Symbol};\nuse std::ffi::{c_char, c_int, c_void};\nuse std::os::unix::io::FromRawFd;\nuse std::ptr;\n\nconst C_LIB_PATH: &str = \"c_src/build/libtranslated_rust.so\";\nconst RUST_LIB_PATH: &str = \"target/release/libtranslated_rust.so\";\n\nunsafe fn load_libs() -> (Library, Library) {\n    let c = Library::new(C_LIB_PATH).expect(\"failed to load C lib\");\n    let r = Library::new(RUST_LIB_PATH).expect(\"failed to load Rust lib\");\n    (c, r)\n}\n\n// Capture stdout from a callback. Replaces fd 1 with a pipe, runs callback, returns bytes.\nfn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {\n    use std::io::Read;\n    unsafe {\n        // Flush before swapping\n        libc::fflush(ptr::null_mut());\n\n        let mut fds: [c_int; 2] = [0; 2];\n        assert_eq!(libc::pipe(fds.as_mut_ptr()), 0);\n        let (r_fd, w_fd) = (fds[0], fds[1]);\n\n        let saved_stdout = libc::dup(1);\n        assert!(saved_stdout >= 0);\n\n        assert!(libc::dup2(w_fd, 1) >= 0);\n        libc::close(w_fd);\n\n        f();\n\n        libc::fflush(ptr::null_mut());\n        libc::dup2(saved_stdout, 1);\n        libc::close(saved_stdout);\n\n        // Read from r_fd\n        let mut file = std::fs::File::from_raw_fd(r_fd);\n        let mut buf = Vec::new();\n        file.read_to_end(&mut buf).unwrap();\n        buf\n    }\n}\n\n#[test]\nfn test_stbds_hash_string_matches() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<unsafe extern \"C\" fn(*mut c_char, usize) -> usize> =\n            c.get(b\"stbds_hash_string\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(*mut c_char, usize) -> usize> =\n            r.get(b\"stbds_hash_string\").unwrap();\n\n        for s in &[\n            \"\",\n            \"a\",\n            \"test_0\",\n            \"test_1\",\n            \"abcdefghijklmnop\",\n            \"the quick brown fox jumps over the lazy dog\",\n        ] {\n            let mut bytes = s.as_bytes().to_vec();\n            bytes.push(0);\n            for seed in &[0usize, 1, 0x31415926, 0xdeadbeef, 0xffffffffffffffff] {\n                let cv = c_fn(bytes.as_mut_ptr() as *mut c_char, *seed);\n                let rv = r_fn(bytes.as_mut_ptr() as *mut c_char, *seed);\n                assert_eq!(cv, rv, \"mismatch for s={:?} seed={:x}\", s, seed);\n            }\n        }\n    }\n}\n\n#[test]\nfn test_stbds_hash_bytes_matches() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<unsafe extern \"C\" fn(*mut c_void, usize, usize) -> usize> =\n            c.get(b\"stbds_hash_bytes\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(*mut c_void, usize, usize) -> usize> =\n            r.get(b\"stbds_hash_bytes\").unwrap();\n\n        let mut data: Vec<u8> = (0u8..=200).collect();\n        for &len in &[0usize, 1, 4, 7, 8, 9, 15, 16, 32, 64, 100, 200] {\n            for seed in &[0usize, 1, 0x31415926, 0xdeadbeefcafebabe] {\n                let cv = c_fn(data.as_mut_ptr() as *mut c_void, len, *seed);\n                let rv = r_fn(data.as_mut_ptr() as *mut c_void, len, *seed);\n                assert_eq!(cv, rv, \"mismatch for len={} seed={:x}\", len, seed);\n            }\n        }\n    }\n}\n\n#[test]\nfn test_strkey_matches() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<unsafe extern \"C\" fn(c_int) -> *mut c_char> =\n            c.get(b\"strkey\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(c_int) -> *mut c_char> =\n            r.get(b\"strkey\").unwrap();\n\n        for n in &[0i32, 1, 7, 100, 12345, -1, -42] {\n            let cp = c_fn(*n);\n            let rp = r_fn(*n);\n            let cs = std::ffi::CStr::from_ptr(cp).to_owned();\n            let rs = std::ffi::CStr::from_ptr(rp).to_owned();\n            assert_eq!(cs, rs, \"strkey mismatch for n={}\", n);\n        }\n    }\n}\n\n#[test]\nfn test_rand_seed_resets_hash_seed() {\n    // After seeding, hashing nothing-related global state shouldn't differ. Just verify both\n    // libs accept and continue to produce identical hashes for a given seed input.\n    unsafe {\n        let (c, r) = load_libs();\n        let c_seed: Symbol<unsafe extern \"C\" fn(usize)> = c.get(b\"stbds_rand_seed\").unwrap();\n        let r_seed: Symbol<unsafe extern \"C\" fn(usize)> = r.get(b\"stbds_rand_seed\").unwrap();\n        c_seed(0xabcd);\n        r_seed(0xabcd);\n\n        let c_fn: Symbol<unsafe extern \"C\" fn(*mut c_char, usize) -> usize> =\n            c.get(b\"stbds_hash_string\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(*mut c_char, usize) -> usize> =\n            r.get(b\"stbds_hash_string\").unwrap();\n        let mut s = b\"hello\\0\".to_vec();\n        let cv = c_fn(s.as_mut_ptr() as *mut c_char, 0xabcd);\n        let rv = r_fn(s.as_mut_ptr() as *mut c_char, 0xabcd);\n        assert_eq!(cv, rv);\n    }\n}\n\n#[test]\nfn test_sh_puts_output_matches() {\n    unsafe {\n        let (c, r) = load_libs();\n        // Reset seeds so initial hash table seed deterministic.\n        let c_seed: Symbol<unsafe extern \"C\" fn(usize)> = c.get(b\"stbds_rand_seed\").unwrap();\n        let r_seed: Symbol<unsafe extern \"C\" fn(usize)> = r.get(b\"stbds_rand_seed\").unwrap();\n\n        for &n in &[0i32, 1, 2, 5, 10, 100] {\n            c_seed(0x31415926);\n            r_seed(0x31415926);\n\n            let c_fn: Symbol<unsafe extern \"C\" fn(c_int)> = c.get(b\"sh_puts\").unwrap();\n            let r_fn: Symbol<unsafe extern \"C\" fn(c_int)> = r.get(b\"sh_puts\").unwrap();\n\n            let c_out = capture_stdout(|| c_fn(n));\n            let r_out = capture_stdout(|| r_fn(n));\n            assert_eq!(\n                c_out, r_out,\n                \"sh_puts mismatch for n={}: C={:?} R={:?}\",\n                n, c_out, r_out\n            );\n        }\n    }\n}\n\n#[test]\nfn test_arrgrowf_basic() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<unsafe extern \"C\" fn(*mut c_void, usize, usize, usize) -> *mut c_void> =\n            c.get(b\"stbds_arrgrowf\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(*mut c_void, usize, usize, usize) -> *mut c_void> =\n            r.get(b\"stbds_arrgrowf\").unwrap();\n\n        // Allocate a fresh array of c_int, request capacity 4\n        let cp = c_fn(ptr::null_mut(), 4, 0, 4);\n        let rp = r_fn(ptr::null_mut(), 4, 0, 4);\n        // Header at offset -16 from returned pointer (length, capacity, hash_table, temp)\n        // capacity should be 4 in both\n        let c_hdr = (cp as *mut u8).sub(32) as *mut [usize; 4];\n        let r_hdr = (rp as *mut u8).sub(32) as *mut [usize; 4];\n        assert_eq!((*c_hdr)[0], 0); // length\n        assert_eq!((*c_hdr)[1], 4); // capacity\n        assert_eq!((*r_hdr)[0], 0);\n        assert_eq!((*r_hdr)[1], 4);\n\n        // Free\n        let c_free: Symbol<unsafe extern \"C\" fn(*mut c_void)> = c.get(b\"stbds_arrfreef\").unwrap();\n        let r_free: Symbol<unsafe extern \"C\" fn(*mut c_void)> = r.get(b\"stbds_arrfreef\").unwrap();\n        c_free(cp);\n        r_free(rp);\n    }\n}\n\n#[test]\nfn test_stralloc_strreset() {\n    // Just verify it doesn't crash and arenas are equivalent.\n    unsafe {\n        let (c, r) = load_libs();\n\n        // String arena layout: ptr (8), remaining (8), block (1), mode (1), padding -> 24 bytes\n        #[repr(C)]\n        #[derive(Default)]\n        struct Arena {\n            storage: *mut c_void,\n            remaining: usize,\n            block: u8,\n            mode: u8,\n            _pad: [u8; 6],\n        }\n\n        let mut c_arena = Arena {\n            storage: ptr::null_mut(),\n            remaining: 0,\n            block: 0,\n            mode: 0,\n            _pad: [0; 6],\n        };\n        let mut r_arena = Arena {\n            storage: ptr::null_mut(),\n            remaining: 0,\n            block: 0,\n            mode: 0,\n            _pad: [0; 6],\n        };\n\n        let c_alloc: Symbol<unsafe extern \"C\" fn(*mut c_void, *mut c_char) -> *mut c_char> =\n            c.get(b\"stbds_stralloc\").unwrap();\n        let r_alloc: Symbol<unsafe extern \"C\" fn(*mut c_void, *mut c_char) -> *mut c_char> =\n            r.get(b\"stbds_stralloc\").unwrap();\n\n        for s in &[\"hello\", \"world\", \"test_42\", \"longer string for arena allocation\"] {\n            let mut bytes = s.as_bytes().to_vec();\n            bytes.push(0);\n            let cp = c_alloc(\n                &mut c_arena as *mut Arena as *mut c_void,\n                bytes.as_mut_ptr() as *mut c_char,\n            );\n            let rp = r_alloc(\n                &mut r_arena as *mut Arena as *mut c_void,\n                bytes.as_mut_ptr() as *mut c_char,\n            );\n            let cs = std::ffi::CStr::from_ptr(cp);\n            let rs = std::ffi::CStr::from_ptr(rp);\n            assert_eq!(cs, rs, \"stralloc content for {}\", s);\n        }\n        // Compare arena tracking fields\n        assert_eq!(c_arena.remaining, r_arena.remaining);\n        assert_eq!(c_arena.block, r_arena.block);\n        assert_eq!(c_arena.mode, r_arena.mode);\n\n        let c_reset: Symbol<unsafe extern \"C\" fn(*mut c_void)> = c.get(b\"stbds_strreset\").unwrap();\n        let r_reset: Symbol<unsafe extern \"C\" fn(*mut c_void)> = r.get(b\"stbds_strreset\").unwrap();\n        c_reset(&mut c_arena as *mut Arena as *mut c_void);\n        r_reset(&mut r_arena as *mut Arena as *mut c_void);\n        assert_eq!(c_arena.remaining, 0);\n        assert_eq!(r_arena.remaining, 0);\n        assert!(c_arena.storage.is_null());\n        assert!(r_arena.storage.is_null());\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
