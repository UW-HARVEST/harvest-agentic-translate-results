}\n    format!(\"{:.6}\", value)\n}\n\nfn main() -> ExitCode {\n    let argv: Vec<String> = env::args().collect();\n    let argc = argv.len();\n    let prog = argv.first().map(String::as_str).unwrap_or(\"\");\n\n    if argc != 4 {\n        let _ = writeln!(std::io::stderr(), \"{} requires 4 inputs\", prog);\n        return ExitCode::from(1);\n    }\n\n    // atof returns double in C, then truncates to float when stored in vec3_t.\n    let mut inputs: [f32; 3] = [\n        atof(&argv[1]) as f32,\n        atof(&argv[2]) as f32,\n        atof(&argv[3]) as f32,\n    ];\n\n    vector_normalize_fast(&mut inputs);\n\n    // C's printf(\"%f %f %f\\n\", float, float, float) promotes the floats to\n    // double for the variadic call, so we mirror that here.\n    let stdout = std::io::stdout();\n    let mut out = stdout.lock();\n    let _ = writeln!(\n        out,\n        \"{} {} {}\",\n        format_f(inputs[0] as f64),\n        format_f(inputs[1] as f64),\n        format_f(inputs[2] as f64),\n    );\n\n    ExitCode::from(0)\n}\n","structuredPatch":[{"oldStart":4,"oldLines":13,"newStart":4,"newLines":15,"lines":[" use std::io::Write;"," use std::process::ExitCode;"," ","-/// Mimic C's atof: skip leading whitespace, optional sign, digits, optional","-/// decimal, optional exponent. Return 0.0 on parse failure (no digits).","+/// Mimic C's `atof` (which is implemented in terms of `strtod`):","+/// skip leading whitespace, optional sign, then either an \"inf[inity]\" or","+/// \"nan\" token, or a decimal number with optional exponent. Returns 0.0 on","+/// parse failure."," fn atof(s: &str) -> f64 {","     let bytes = s.as_bytes();","     let mut i = 0usize;"," ","-    // skip leading whitespace (C's isspace covers ' ', '\\t', '\\n', '\\v', '\\f', '\\r')","+    // skip leading whitespace (C's isspace: ' ', '\\t', '\\n', '\\v', '\\f', '\\r')","     while i < bytes.len() {","         match bytes[i] {","             b' ' | b'\\t' | b'\\n' | 0x0b | 0x0c | b'\\r' => i += 1,"]},{"o