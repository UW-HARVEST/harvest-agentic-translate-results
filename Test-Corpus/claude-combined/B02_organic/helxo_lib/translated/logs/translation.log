ull integration test that captures stdout ----------\n#[test]\nfn test_helxo_output_matches() {\n    unsafe {\n        let (c, r) = load_libs();\n\n        type SeedFn = unsafe extern \"C\" fn(usize);\n        type HelxoFn = unsafe extern \"C\" fn(c_char);\n\n        let c_seed: Symbol<SeedFn> = c.get(b\"stbds_rand_seed\").unwrap();\n        let r_seed: Symbol<SeedFn> = r.get(b\"stbds_rand_seed\").unwrap();\n        let c_helxo: Symbol<HelxoFn> = c.get(b\"helxo\").unwrap();\n        let r_helxo: Symbol<HelxoFn> = r.get(b\"helxo\").unwrap();\n\n        for letter in [b'l' as c_char, b'!' as c_char, b'A' as c_char].iter() {\n            c_seed(0x31415926);\n            let c_out = capture_stdout(|| c_helxo(*letter));\n            r_seed(0x31415926);\n            let r_out = capture_stdout(|| r_helxo(*letter));\n\n            assert_eq!(\n                c_out, r_out,\n                \"helxo output mismatch for letter {:?}\\nC:\\n{}\\nRust:\\n{}\",\n                *letter as u8 as char,\n                String::from_utf8_lossy(&c_out),\n                String::from_utf8_lossy(&r_out)\n            );\n        }\n    }\n}\n\n// ---------- strkey ----------\n#[test]\nfn test_strkey_matches() {\n    unsafe {\n        let (c, r) = load_libs();\n        type StrkeyFn = unsafe extern \"C\" fn(c_int) -> *mut c_char;\n        let c_sk: Symbol<StrkeyFn> = c.get(b\"strkey\").unwrap();\n        let r_sk: Symbol<StrkeyFn> = r.get(b\"strkey\").unwrap();\n\n        for n in [-5, 0, 1, 42, 12345].iter() {\n            let cp = c_sk(*n);\n            let rp = r_sk(*n);\n            let cs = std::ffi::CStr::from_ptr(cp).to_bytes().to_vec();\n            let rs = std::ffi::CStr::from_ptr(rp).to_bytes().to_vec();\n            assert_eq!(cs, rs, \"strkey({}) mismatch\", n);\n        }\n    }\n}\n\n// ---------- shmode_func / hmput / hmget / hmdel for string keys ----------\n#[test]\nfn test_string_hmput_get_del() {\n    unsafe {\n        let (c, r) = load_libs();\n        type SeedFn = unsafe extern \"C\" fn(usize);\n        type ShmodeFn = unsafe extern \"C\" fn(usize, c_int) -> *mut c_void;\n        type HmputFn =\n            unsafe extern \"C\" fn(*mut c_void, usize, *mut c_void, usize, c_int) -> *mut c_void;\n        type HmgetFn =\n            unsafe extern \"C\" fn(*mut c_void, usize, *mut c_void, usize, c_int) -> *mut c_void;\n        type HmdelFn = unsafe extern \"C\" fn(\n            *mut c_void,\n            usize,\n            *mut c_void,\n            usize,\n            usize,\n            c_int,\n        ) -> *mut c_void;\n        type HmfreeFn = unsafe extern \"C\" fn(*mut c_void, usize);\n\n        let c_seed: Symbol<SeedFn> = c.get(b\"stbds_rand_seed\").unwrap();\n        let r_seed: Symbol<SeedFn> = r.get(b\"stbds_rand_seed\").unwrap();\n        c_seed(0x31415926);\n        r_seed(0x31415926);\n\n        let c_shmode: Symbol<ShmodeFn> = c.get(b\"stbds_shmode_func\").unwrap();\n        let r_shmode: Symbol<ShmodeFn> = r.get(b\"stbds_shmode_func\").unwrap();\n        let c_put: Symbol<HmputFn> = c.get(b\"stbds_hmput_key\").unwrap();\n        let r_put: Symbol<HmputFn> = r.get(b\"stbds_hmput_key\").unwrap();\n        let c_get: Symbol<HmgetFn> = c.get(b\"stbds_hmget_key\").unwrap();\n        let r_get: Symbol<HmgetFn> = r.get(b\"stbds_hmget_key\").unwrap();\n        let c_del: Symbol<HmdelFn> = c.get(b\"stbds_hmdel_key\").unwrap();\n        let r_del: Symbol<HmdelFn> = r.get(b\"stbds_hmdel_key\").unwrap();\n        let c_free: Symbol<HmfreeFn> = c.get(b\"stbds_hmfree_func\").unwrap();\n        let r_free: Symbol<HmfreeFn> = r.get(b\"stbds_hmfree_func\").unwrap();\n\n        let elemsize: usize = 16;\n\n        let c_t = c_shmode(elemsize, 0);\n        let r_t = r_shmode(elemsize, 0);\n\n        let key1 = CString::new(\"alpha\").unwrap();\n        let key2 = CString::new(\"beta\").unwrap();\n\n        let c_t = c_put(c_t, elemsize, key1.as_ptr() as *mut c_void, 8, 1);\n        let r_t = r_put(r_t, elemsize, key1.as_ptr() as *mut c_void, 8, 1);\n        let c_hdr = (c_t as *mut usize).offset(-4);\n        let r_hdr = (r_t as *mut usize).offset(-4);\n        assert_eq!(*c_hdr, *r_hdr, \"length after put 1\");\n\n        let c_temp = *c_hdr.add(3) as isize;\n        let r_temp = *r_hdr.add(3) as isize;\n        assert_eq!(c_temp, r_temp, \"temp index after put\");\n        *(((c_t as *mut u8).add(elemsize * c_temp as usize + 8)) as *mut c_char) = 1;\n        *(((r_t as *mut u8).add(elemsize * r_temp as usize + 8)) as *mut c_char) = 1;\n\n        let c_t = c_put(c_t, elemsize, key2.as_ptr() as *mut c_void, 8, 1);\n        let r_t = r_put(r_t, elemsize, key2.as_ptr() as *mut c_void, 8, 1);\n        let c_hdr = (c_t as *mut usize).offset(-4);\n        let r_hdr = (r_t as *mut usize).offset(-4);\n        assert_eq!(*c_hdr, *r_hdr, \"length after put 2\");\n        let c_temp = *c_hdr.add(3) as isize;\n        let r_temp = *r_hdr.add(3) as isize;\n        assert_eq!(c_temp, r_temp, \"temp index after put 2\");\n        *(((c_t as *mut u8).add(elemsize * c_temp as usize + 8)) as *mut c_char) = 2;\n        *(((r_t as *mut u8).add(elemsize * r_temp as usize + 8)) as *mut c_char) = 2;\n\n        let c_get_t = c_get(c_t, elemsize, key1.as_ptr() as *mut c_void, 8, 1);\n        let r_get_t = r_get(r_t, elemsize, key1.as_ptr() as *mut c_void, 8, 1);\n        let c_hdr_g = (c_get_t as *mut usize).offset(-4);\n        let r_hdr_g = (r_get_t as *mut usize).offset(-4);\n        let c_idx = *c_hdr_g.add(3) as isize;\n        let r_idx = *r_hdr_g.add(3) as isize;\n        assert_eq!(c_idx, r_idx, \"get returned index\");\n        let c_val = *(((c_get_t as *mut u8).add(elemsize * c_idx as usize + 8)) as *mut c_char);\n        let r_val = *(((r_get_t as *mut u8).add(elemsize * r_idx as usize + 8)) as *mut c_char);\n        assert_eq!(c_val, r_val);\n        assert_eq!(c_val, 1);\n\n        let c_t = c_del(c_get_t, elemsize, key1.as_ptr() as *mut c_void, 8, 0, 1);\n        let r_t = r_del(r_get_t, elemsize, key1.as_ptr() as *mut c_void, 8, 0, 1);\n        let c_hdr = (c_t as *mut usize).offset(-4);\n        let r_hdr = (r_t as *mut usize).offset(-4);\n        assert_eq!(*c_hdr, *r_hdr, \"length after del\");\n\n        c_free(c_t, elemsize);\n        r_free(r_t, elemsize);\n    }\n}\n","structuredPatch":[{"oldStart":14,"oldLines":10,"newStart":14,"newLines":11,"lines":[" }"," "," fn rust_lib_path() -> PathBuf {","-    // cargo places test artifacts under target/debug or target/release; use","-    // CARGO_TARGET_DIR or default to target/release.","     let manifest = PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));","-    let release = manifest.join(\"target\").join(\"release\").join(\"libtranslated_rust.so\");","+    let release = manifest","+        .join(\"target\")","+        .join(\"release\")","+        .join(\"libtranslated_rust.so\");","     if release.exists() {","         return release;","     }"]},{"oldStart":31,"oldLines":6,"newStart":32,"newLines":37,"lines":["     (c, r)"," }"," ","+// Resolve libc's stdout pointer from libc.","+mod libc_ext {","+    extern \"C\" {","+        #[allow(non_upper_case_globals)]","+        pub static mut stdout: *mut libc::FILE;","+    }","+}","+","+unsafe fn capture_stdout<F: FnOnce()>(f: F) -> Vec<u8> {","+    use std::io::{Read, Seek, SeekFrom};","+    use std::os::unix::io::FromRawFd;","+    libc::fflush(libc_ext::stdout);","+    let saved = libc::dup(1);","+    let tmpl = CString::new(\"/tmp/helxo_capture_XXXXXX\").unwrap();","+    let mut path_buf = tmpl.into_bytes_with_nul();","+    let fd = libc::mkstemp(path_buf.as_mut_ptr() as *mut c_char);","+    assert!(fd >= 0);","+    libc::dup2(fd, 1);","+    f();","+    libc::fflush(libc_ext::stdout);","+    libc::dup2(saved, 1);","+    libc::close(saved);","+    let mut file = std::fs::File::from_raw_fd(fd);","+    file.seek(SeekFrom::Start(0)).unwrap();","+    let mut out = Vec::new();","+    file.read_to_end(&mut out).unwrap();","+    let path_cstr = std::ffi::CStr::from_ptr(path_buf.a