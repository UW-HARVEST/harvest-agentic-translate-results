[test]\nfn test_c2v() {\n    let (c, r) = load_libs();\n    unsafe {\n        let c_fn: Symbol<unsafe extern \"C\" fn(f32, f32) -> C2v> = c.get(b\"c2V\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(f32, f32) -> C2v> = r.get(b\"c2V\").unwrap();\n        for (x, y) in [(0.0, 0.0), (1.5, -2.5), (-100.0, 100.0), (f32::NAN, 1.0)] {\n            let cv = c_fn(x, y);\n            let rv = r_fn(x, y);\n            assert_eq!(cv.x.to_bits(), rv.x.to_bits(), \"x mismatch for ({},{})\", x, y);\n            assert_eq!(cv.y.to_bits(), rv.y.to_bits(), \"y mismatch for ({},{})\", x, y);\n        }\n    }\n}\n\n#[test]\nfn test_c2_mulvs() {\n    let (c, r) = load_libs();\n    unsafe {\n        let c_fn: Symbol<unsafe extern \"C\" fn(C2v, f32) -> C2v> = c.get(b\"c2Mulvs\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(C2v, f32) -> C2v> = r.get(b\"c2Mulvs\").unwrap();\n        for (x, y, s) in [\n            (1.0_f32, 2.0_f32, 3.0_f32),\n            (-1.0, -2.0, 0.5),\n            (10.0, -10.0, -1.0),\n            (0.0, 0.0, 1e10),\n        ] {\n            let v = C2v { x, y };\n            assert!(approx_eq_v(c_fn(v, s), r_fn(v, s)));\n        }\n    }\n}\n\n#[test]\nfn test_c2_maxv_minv_clampv() {\n    let (c, r) = load_libs();\n    unsafe {\n        let c_max: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> C2v> = c.get(b\"c2Maxv\").unwrap();\n        let r_max: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> C2v> = r.get(b\"c2Maxv\").unwrap();\n        let c_min: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> C2v> = c.get(b\"c2Minv\").unwrap();\n        let r_min: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> C2v> = r.get(b\"c2Minv\").unwrap();\n        let c_clamp: Symbol<unsafe extern \"C\" fn(C2v, C2v, C2v) -> C2v> =\n            c.get(b\"c2Clampv\").unwrap();\n        let r_clamp: Symbol<unsafe extern \"C\" fn(C2v, C2v, C2v) -> C2v> =\n            r.get(b\"c2Clampv\").unwrap();\n\n        for (a, b) in [\n            (C2v { x: 1.0, y: 2.0 }, C2v { x: 3.0, y: 1.0 }),\n            (C2v { x: -5.0, y: 10.0 }, C2v { x: 5.0, y: -10.0 }),\n            (C2v { x: 0.0, y: 0.0 }, C2v { x: 0.0, y: 0.0 }),\n        ] {\n            assert!(approx_eq_v(c_max(a, b), r_max(a, b)));\n            assert!(approx_eq_v(c_min(a, b), r_min(a, b)));\n        }\n\n        let lo = C2v { x: -1.0, y: -1.0 };\n        let hi = C2v { x: 1.0, y: 1.0 };\n        for a in [\n            C2v { x: 0.0, y: 0.0 },\n            C2v { x: -2.0, y: 2.0 },\n            C2v { x: 5.0, y: -5.0 },\n            C2v { x: 0.5, y: -0.5 },\n        ] {\n            assert!(approx_eq_v(c_clamp(a, lo, hi), r_clamp(a, lo, hi)));\n        }\n    }\n}\n\n#[test]\nfn test_c2_sub_dot() {\n    let (c, r) = load_libs();\n    unsafe {\n        let c_sub: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> C2v> = c.get(b\"c2Sub\").unwrap();\n        let r_sub: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> C2v> = r.get(b\"c2Sub\").unwrap();\n        let c_dot: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> f32> = c.get(b\"c2Dot\").unwrap();\n        let r_dot: Symbol<unsafe extern \"C\" fn(C2v, C2v) -> f32> = r.get(b\"c2Dot\").unwrap();\n\n        for (a, b) in [\n            (C2v { x: 1.0, y: 2.0 }, C2v { x: 3.0, y: 1.0 }),\n            (C2v { x: -5.0, y: 10.0 }, C2v { x: 5.0, y: -10.0 }),\n            (C2v { x: 0.0, y: 0.0 }, C2v { x: 1.0, y: 1.0 }),\n        ] {\n            assert!(approx_eq_v(c_sub(a, b), r_sub(a, b)));\n            assert_eq!(c_dot(a, b).to_bits(), r_dot(a, b).to_bits());\n        }\n    }\n}\n\n#[test]\nfn test_circle_to_circle() {\n    let (c, r) = load_libs();\n    unsafe {\n        let c_fn: Symbol<unsafe extern \"C\" fn(C2Circle, C2Circle) -> c_int> =\n            c.get(b\"c2CircletoCircle\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(C2Circle, C2Circle) -> c_int> =\n            r.get(b\"c2CircletoCircle\").unwrap();\n\n        let cases = [\n            (\n                C2Circle { p: C2v { x: 0.0, y: 0.0 }, r: 1.0 },\n                C2Circle { p: C2v { x: 1.0, y: 0.0 }, r: 1.0 },\n            ),\n            (\n                C2Circle { p: C2v { x: 0.0, y: 0.0 }, r: 1.0 },\n                C2Circle { p: C2v { x: 5.0, y: 0.0 }, r: 1.0 },\n            ),\n            (\n                C2Circle { p: C2v { x: 0.0, y: 0.0 }, r: 1.0 },\n                C2Circle { p: C2v { x: 2.0, y: 0.0 }, r: 1.0 }, // exactly touching\n            ),\n            (\n                C2Circle { p: C2v { x: -10.0, y: -10.0 }, r: 5.0 },\n                C2Circle { p: C2v { x: -8.0, y: -8.0 }, r: 5.0 },\n            ),\n        ];\n        for (a, b) in cases {\n            assert_eq!(c_fn(a, b), r_fn(a, b), \"case {:?} {:?}\", a, b);\n        }\n    }\n}\n\n#[test]\nfn test_circle_to_aabb() {\n    let (c, r) = load_libs();\n    unsafe {\n        let c_fn: Symbol<unsafe extern \"C\" fn(C2Circle, C2AABB) -> c_int> =\n            c.get(b\"c2CircletoAABB\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(C2Circle, C2AABB) -> c_int> =\n            r.get(b\"c2CircletoAABB\").unwrap();\n        let cases = [\n            (\n                C2Circle { p: C2v { x: 0.0, y: 0.0 }, r: 1.0 },\n                C2AABB { min: C2v { x: -1.0, y: -1.0 }, max: C2v { x: 1.0, y: 1.0 } },\n            ),\n            (\n                C2Circle { p: C2v { x: 10.0, y: 10.0 }, r: 1.0 },\n                C2AABB { min: C2v { x: -1.0, y: -1.0 }, max: C2v { x: 1.0, y: 1.0 } },\n            ),\n            (\n                C2Circle { p: C2v { x: 2.0, y: 0.0 }, r: 1.5 },\n                C2AABB { min: C2v { x: -1.0, y: -1.0 }, max: C2v { x: 1.0, y: 1.0 } },\n            ),\n            (\n                C2Circle { p: C2v { x: -22.0, y: -22.0 }, r: 5.0 },\n                C2AABB { min: C2v { x: -40.0, y: -40.0 }, max: C2v { x: -15.0, y: -15.0 } },\n            ),\n        ];\n        for (a, b) in cases {\n            assert_eq!(c_fn(a, b), r_fn(a, b));\n        }\n    }\n}\n\n#[test]\nfn test_circle_to_capsule() {\n    let (c, r) = load_libs();\n    unsafe {\n        let c_fn: Symbol<unsafe extern \"C\" fn(C2Circle, C2Capsule) -> c_int> =\n            c.get(b\"c2CircletoCapsule\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(C2Circle, C2Capsule) -> c_int> =\n            r.get(b\"c2CircletoCapsule\").unwrap();\n        let cases = [\n            (\n                C2Circle { p: C2v { x: 0.0, y: 0.0 }, r: 1.0 },\n                C2Capsule { a: C2v { x: -10.0, y: 0.0 }, b: C2v { x: 10.0, y: 0.0 }, r: 1.0 },\n            ),\n            (\n                C2Circle { p: C2v { x: 100.0, y: 100.0 }, r: 1.0 },\n                C2Capsule { a: C2v { x: -10.0, y: 0.0 }, b: C2v { x: 10.0, y: 0.0 }, r: 1.0 },\n            ),\n            (\n                C2Circle { p: C2v { x: -30.0, y: 70.0 }, r: 5.0 },\n                C2Capsule { a: C2v { x: -40.0, y: 40.0 }, b: C2v { x: -20.0, y: 100.0 }, r: 10.0 },\n            ),\n            (\n                C2Circle { p: C2v { x: -50.0, y: 30.0 }, r: 3.0 },\n                C2Capsule { a: C2v { x: -40.0, y: 40.0 }, b: C2v { x: -20.0, y: 100.0 }, r: 10.0 },\n            ),\n            (\n                C2Circle { p: C2v { x: 0.0, y: 200.0 }, r: 1.0 },\n                C2Capsule { a: C2v { x: -40.0, y: 40.0 }, b: C2v { x: -20.0, y: 100.0 }, r: 10.0 },\n            ),\n        ];\n        for (a, b) in cases {\n            assert_eq!(c_fn(a, b), r_fn(a, b));\n        }\n    }\n}\n\n#[test]\nfn test_c2_collided() {\n    let (c, r) = load_libs();\n    unsafe {\n        let c_fn: Symbol<unsafe extern \"C\" fn(*const c_void, *const c_void, c_int) -> c_int> =\n            c.get(b\"c2Collided\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(*const c_void, *const c_void, c_int) -> c_int> =\n            r.get(b\"c2Collided\").unwrap();\n\n        let circle_a = C2Circle { p: C2v { x: 0.0, y: 0.0 }, r: 5.0 };\n        let circle_b = C2Circle { p: C2v { x: 4.0, y: 0.0 }, r: 5.0 };\n        let aabb_b = C2AABB {\n            min: C2v { x: -10.0, y: -10.0 },\n            max: C2v { x: 10.0, y: 10.0 },\n        };\n        let cap_b = C2Capsule {\n            a: C2v { x: -10.0, y: 0.0 },\n            b: C2v { x: 10.0, y: 0.0 },\n            r: 1.0,\n        };\n\n        let pa = &circle_a as *const _ as *const c_void;\n        let pb = &circle_b as *const _ as *const c_void;\n        assert_eq!(c_fn(pa, pb, 0), r_fn(pa, pb, 0));\n\n        let pb2 = &aabb_b as *const _ as *const c_void;\n        assert_eq!(c_fn(pa, pb2, 1), r_fn(pa, pb2, 1));\n\n        let pb3 = &cap_b as *const _ as *const c_void;\n        assert_eq!(c_fn(pa, pb3, 2), r_fn(pa, pb3, 2));\n\n        // Default branch\n        assert_eq!(c_fn(pa, pb, 999), r_fn(pa, pb, 999));\n    }\n}\n\n#[test]\nfn test_circle_collide() {\n    let (c, r) = load_libs();\n    unsafe {\n        let c_fn: Symbol<unsafe extern \"C\" fn(f32, f32, f32) -> c_int> =\n            c.get(b\"circle_collide\").unwrap();\n        let r_fn: Symbol<unsafe extern \"C\" fn(f32, f32, f32) -> c_int> =\n            r.get(b\"circle_collide\").unwrap();\n\n        let cases: &[(f32, f32, f32)] = &[\n            (0.0, 0.0, 1.0),\n            (-70.0, 0.0, 20.0),\n            (-25.0, -25.0, 5.0),       // inside the AABB\n            (-30.0, 70.0, 5.0),        // near capsule\n            (100.0, 100.0, 1.0),       // none\n            (-50.0, 0.0, 5.0),         // touching circle?\n            (-50.0, 0.0, 10.0),\n            (-15.0, -15.0, 1.0),       // corner of aabb\n            (0.0, 0.0, 0.0),\n            (-30.0, 50.0, 1.0),\n        ];\n        for &(x, y, r_) in cases {\n            assert_eq!(c_fn(x, y, r_), r_fn(x, y, r_), \"case ({}, {}, {})\", x, y, r_);\n        }\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
