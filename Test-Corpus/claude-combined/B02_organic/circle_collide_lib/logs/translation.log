c_void,","+            C2_TYPE_CAPSULE,","         ) << 2;","     }"," "]}],"originalFile":"use std::ffi::c_int;\n\n#[repr(C)]\n#[derive(Copy, Clone)]\n#[allow(non_camel_case_types)]\npub enum C2_TYPE {\n    C2_TYPE_CIRCLE = 0,\n    C2_TYPE_AABB = 1,\n    C2_TYPE_CAPSULE = 2,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\n#[allow(non_camel_case_types)]\npub struct c2v {\n    pub x: f32,\n    pub y: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\n#[allow(non_camel_case_types)]\npub struct c2Circle {\n    pub p: c2v,\n    pub r: f32,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\n#[allow(non_camel_case_types)]\npub struct c2AABB {\n    pub min: c2v,\n    pub max: c2v,\n}\n\n#[repr(C)]\n#[derive(Copy, Clone)]\n#[allow(non_camel_case_types)]\npub struct c2Capsule {\n    pub a: c2v,\n    pub b: c2v,\n    pub r: f32,\n}\n\nfn c2_v(x: f32, y: f32) -> c2v {\n    c2v { x, y }\n}\n\nfn c2_mulvs(mut a: c2v, b: f32) -> c2v {\n    a.x *= b;\n    a.y *= b;\n    a\n}\n\nfn c2_maxv(a: c2v, b: c2v) -> c2v {\n    c2_v(\n        if a.x > b.x { a.x } else { b.x },\n        if a.y > b.y { a.y } else { b.y },\n    )\n}\n\nfn c2_minv(a: c2v, b: c2v) -> c2v {\n    c2_v(\n        if a.x < b.x { a.x } else { b.x },\n        if a.y < b.y { a.y } else { b.y },\n    )\n}\n\nfn c2_clampv(a: c2v, lo: c2v, hi: c2v) -> c2v {\n    c2_maxv(lo, c2_minv(a, hi))\n}\n\nfn c2_sub(mut a: c2v, b: c2v) -> c2v {\n    a.x -= b.x;\n    a.y -= b.y;\n    a\n}\n\nfn c2_dot(a: c2v, b: c2v) -> f32 {\n    a.x * b.x + a.y * b.y\n}\n\nfn c2_circle_to_circle(a: c2Circle, b: c2Circle) -> c_int {\n    let c = c2_sub(b.p, a.p);\n    let d2 = c2_dot(c, c);\n    let mut r2 = a.r + b.r;\n    r2 = r2 * r2;\n    (d2 < r2) as c_int\n}\n\nfn c2_circle_to_aabb(a: c2Circle, b: c2AABB) -> c_int {\n    let l = c2_clampv(a.p, b.min, b.max);\n    let ab = c2_sub(a.p, l);\n    let d2 = c2_dot(ab, ab);\n    let r2 = a.r * a.r;\n    (d2 < r2) as c_int\n}\n\nfn c2_circle_to_capsule(a: c2Circle, b: c2Capsule) -> c_int {\n    let n = c2_sub(b.b, b.a);\n    let ap = c2_sub(a.p, b.a);\n    let da = c2_dot(ap, n);\n    let d2;\n    if da < 0.0 {\n        d2 = c2_dot(ap, ap);\n    } else {\n        let db = c2_dot(c2_sub(a.p, b.b), n);\n        if db < 0.0 {\n            let e = c2_sub(ap, c2_mulvs(n, da / c2_dot(n, n)));\n            d2 = c2_dot(e, e);\n        } else {\n            let bp = c2_sub(a.p, b.b);\n            d2 = c2_dot(bp, bp);\n        }\n    }\n    let r = a.r + b.r;\n    (d2 < r * r) as c_int\n}\n\nunsafe fn c2_collided(a: *const core::ffi::c_void, b: *const core::ffi::c_void, type_b: c_int) -> c_int {\n    match type_b {\n        0 => {\n            // C2_TYPE_CIRCLE\n            c2_circle_to_circle(*(a as *const c2Circle), *(b as *const c2Circle))\n        }\n        1 => {\n            // C2_TYPE_AABB\n            c2_circle_to_aabb(*(a as *const c2Circle), *(b as *const c2AABB))\n        }\n        2 => {\n            // C2_TYPE_CAPSULE\n            c2_circle_to_capsule(*(a as *const c2Circle), *(b as *const c2Capsule))\n        }\n        _ => 0,\n    }\n}\n\n#[unsafe(no_mangle)]\npub extern \"C\" fn circle_collide(x: f32, y: f32, r: f32) -> c_int {\n    let mut result: c_int = 0;\n\n    let circle_in = c2Circle {\n        p: c2_v(x, y),\n        r,\n    };\n\n    let circle = c2Circle {\n        p: c2_v(-70.0_f32, 0.0_f32),\n        r: 20.0_f32,\n    };\n\n    let aabb = c2AABB {\n        min: c2_v(-40.0_f32, -40.0_f32),\n        max: c2_v(-15.0_f32, -15.0_f32),\n    };\n\n    let capsule = c2Capsule {\n        a: c2_v(-40.0_f32, 40.0_f32),\n        b: c2_v(-20.0_f32, 100.0_f32),\n        r: 10.0_f32,\n    };\n\n    unsafe {\n        result += c2_collided(\n            &circle_in as *const _ as *const core::ffi::c_void,\n            &circle as *const _ as *const core::ffi::c_void,\n            0, // C2_TYPE_CIRCLE\n        );\n\n        result += c2_collided(\n            &circle_in as *const _ as *const core::ffi::c_void,\n            &aabb as *const _ as *const core::ffi::c_void,\n            1, // C2_TYPE_AABB\n        ) << 1;\n\n        result += c2_collided(\n            &circle_in as *const _ as *const core::ffi::c_void,\n            &capsule as *const _ as *const core::ffi::c_void,\n            2, // C2_TYPE_CAPSULE\n        ) << 2;\n    }\n\n    result\n}\n","userModified":false}}
