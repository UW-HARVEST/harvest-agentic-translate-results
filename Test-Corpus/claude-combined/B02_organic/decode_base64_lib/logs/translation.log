b\");\n\n    for input in inputs {\n        let cs = input.map(|b| CString::new(b).unwrap());\n        let cs_ref = cs.as_deref();\n        let c_out = unsafe { call_decode(&c_lib, cs_ref) };\n        let r_out = unsafe { call_decode(&rust_lib, cs_ref) };\n        assert_eq!(\n            c_out, r_out,\n            \"Mismatch for input {:?}: C={:?} Rust={:?}\",\n            input, c_out, r_out\n        );\n    }\n}\n\n#[test]\nfn test_null_input() {\n    compare_inputs(&[None]);\n}\n\n#[test]\nfn test_empty_string() {\n    compare_inputs(&[Some(b\"\")]);\n}\n\n#[test]\nfn test_basic_decoding() {\n    compare_inputs(&[\n        Some(b\"SGVsbG8sIFdvcmxkIQ==\"),  // \"Hello, World!\"\n        Some(b\"Zm9vYmFy\"),               // \"foobar\"\n        Some(b\"Zg==\"),                   // \"f\"\n        Some(b\"Zm8=\"),                   // \"fo\"\n        Some(b\"Zm9v\"),                   // \"foo\"\n        Some(b\"Zm9vYg==\"),               // \"foob\"\n        Some(b\"Zm9vYmE=\"),               // \"fooba\"\n    ]);\n}\n\n#[test]\nfn test_with_whitespace_and_invalid() {\n    compare_inputs(&[\n        Some(b\"SGVsbG8s IFdvcmxkIQ==\"),\n        Some(b\"S G V s b G 8 =\"),\n        Some(b\"!!!Zm9v!!!\"),\n        Some(b\"\\nSGVs\\nbG8=\\n\"),\n    ]);\n}\n\n#[test]\nfn test_all_chars() {\n    compare_inputs(&[\n        Some(b\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\"),\n    ]);\n}\n\n#[test]\nfn test_only_invalid_chars() {\n    compare_inputs(&[\n        Some(b\"!!!\"),\n        Some(b\"   \"),\n        Some(b\"\\t\\n\\r\"),\n    ]);\n}\n\n#[test]\nfn test_short_inputs() {\n    compare_inputs(&[\n        Some(b\"A\"),\n        Some(b\"AB\"),\n        Some(b\"ABC\"),\n        Some(b\"ABCD\"),\n        Some(b\"=\"),\n        Some(b\"==\"),\n        Some(b\"===\"),\n    ]);\n}\n\n#[test]\nfn test_padding_variations() {\n    compare_inputs(&[\n        Some(b\"YQ==\"),       // \"a\"\n        Some(b\"YWI=\"),       // \"ab\"\n        Some(b\"YWJj\"),       // \"abc\"\n        Some(b\"YWJjZA==\"),   // \"abcd\"\n    ]);\n}\n\n#[test]\nfn test_long_input() {\n    let long = b\"VGhpcyBpcyBhIGxvbmdlciBzdHJpbmcgdGhhdCB3ZSdyZSB0ZXN0aW5nIHdpdGggdmFyaW91cyBjaGFyYWN0ZXJzLg==\";\n    compare_inputs(&[Some(long)]);\n}\n\n#[test]\nfn test_binary_decoded() {\n    // A base64 encoding of binary bytes 0x00..0xff\n    let mut input = Vec::new();\n    for i in 0u8..=255 {\n        input.push(i);\n    }\n    // Build base64 of this binary buffer (use known table)\n    let table: &[u8] = b\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\";\n    let mut encoded = Vec::new();\n    let mut i = 0;\n    while i + 3 <= input.len() {\n        let b0 = input[i];\n        let b1 = input[i + 1];\n        let b2 = input[i + 2];\n        encoded.push(table[(b0 >> 2) as usize]);\n        encoded.push(table[(((b0 & 0x3) << 4) | (b1 >> 4)) as usize]);\n        encoded.push(table[(((b1 & 0xf) << 2) | (b2 >> 6)) as usize]);\n        encoded.push(table[(b2 & 0x3f) as usize]);\n        i += 3;\n    }\n    compare_inputs(&[Some(&encoded)]);\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":152,"cache_read_input_tokens":20771,"cache_creation":{"ephemeral_5m_input_tokens":152,"ephemeral_1h_input_tokens":0},"output_tokens":22,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"6fb9c782-f74f-4020-99b3-6508a3f19ed0","uuid":"6e94e320-c691-4b42-8e29-3884ad31ce6a"}
