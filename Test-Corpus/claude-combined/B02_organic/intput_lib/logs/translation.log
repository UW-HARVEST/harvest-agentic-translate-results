}};\n    }\n\n    let szt = core::mem::size_of::<usize>();\n    let mut i: usize = 0;\n    while i + szt <= len {\n        // data = d[0] | (d[1] << 8) | (d[2] << 16) | (d[3] << 24)\n        let lo = (*d.add(0) as usize)\n            | ((*d.add(1) as usize) << 8)\n            | ((*d.add(2) as usize) << 16)\n            | ((*d.add(3) as usize) << 24);\n        // data |= (size_t) (d[4] | (d[5] << 8) | (d[6] << 16) | (d[7] << 24)) << 16 << 16\n        // The right-hand side is computed as size_t then shifted (32-bit width promotion)\n        // The C expression is: (size_t)(d[4]|(d[5]<<8)|(d[6]<<16)|(d[7]<<24)) << 16 << 16\n        // i.e. cast to size_t, shift left 32 total\n        // d[7]<<24 is in int territory; cast as unsigned safely.\n        let hi = (*d.add(4) as usize)\n            | ((*d.add(5) as usize) << 8)\n            | ((*d.add(6) as usize) << 16)\n            | (((*d.add(7) as u32) as usize) << 24);\n        data = lo | (hi << 16 << 16);\n\n        v3 ^= data;\n        for _ in 0..STBDS_SIPHASH_C_ROUNDS {\n            sipround!();\n        }\n        v0 ^= data;\n\n        i += szt;\n        d = d.add(szt);\n    }\n    data = len.wrapping_shl(STBDS_SIZE_T_BITS - 8);\n    // C switch fallthrough\n    let rem = len - i;\n    if rem >= 7 {\n        data |= ((*d.add(6) as usize) << 24) << 24;\n    }\n    if rem >= 6 {\n        data |= ((*d.add(5) as usize) << 20) << 20;\n    }\n    if rem >= 5 {\n        data |= ((*d.add(4) as usize) << 16) << 16;\n    }\n    if rem >= 4 {\n        // (d[3] << 24) — int promotion in C. Use u32 to handle exactly.\n        data |= ((*d.add(3) as u32 as usize) << 24) & usize::MAX;\n    }\n    if rem >= 3 {\n        data |= (*d.add(2) as usize) << 16;\n    }\n    if rem >= 2 {\n        data |= (*d.add(1) as usize) << 8;\n    }\n    if rem >= 1 {\n        data |= *d.add(0) as usize;\n    }\n\n    v3 ^= data;\n    for _ in 0..STBDS_SIPHASH_C_ROUNDS {\n        sipround!();\n    }\n    v0 ^= data;\n    v2 ^= 0xff;\n    for _ in 0..STBDS_SIPHASH_D_ROUNDS {\n        sipround!();\n    }\n\n    v0 ^ v1 ^ v2 ^ v3\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn stbds_hash_bytes(p: *mut c_void, len: usize, seed: usize) -> usize {\n    stbds_siphash_bytes(p, len, seed)\n}\n\n// ------------------------------ stbds_is_key_equal ------------------------------\nunsafe fn stbds_is_key_equal(\n    a: *mut c_void,\n    elemsize: usize,\n    key: *mut c_void,\n    keysize: usize,\n    keyoffset: usize,\n    mode: c_int,\n    i: usize,\n) -> bool {\n    if mode >= STBDS_HM_STRING {\n        let p = (a as *mut u8).add(elemsize * i + keyoffset) as *mut *mut c_char;\n        strcmp(key as *const c_char, *p) == 0\n    } else {\n        memcmp(\n            key as *const c_void,\n            (a as *mut u8).add(elemsize * i + keyoffset) as *const c_void,\n            keysize,\n        ) == 0\n    }\n}\n\n// ------------------------------ stbds_hmfree_func ------------------------------\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn stbds_hmfree_func(a: *mut c_void, elemsize: usize) {\n    if a.is_null() {\n        return;\n    }\n    if !hash_table(a).is_null() {\n        if (*hash_table(a)).string.mode == STBDS_SH_STRDUP {\n            let len = (*header(a)).length;\n            for i in 1..len {\n                let p = (a as *mut u8).add(elemsize * i) as *mut *mut c_char;\n                free(*p as *mut c_void);\n            }\n        }\n        stbds_strreset(&mut (*hash_table(a)).string);\n    }\n    free((*header(a)).hash_table);\n    free(header(a) as *mut c_void);\n}\n\n// ------------------------------ stbds_hm_find_slot ------------------------------\nunsafe fn stbds_hm_find_slot(\n    a: *mut c_void,\n    elemsize: usize,\n    key: *mut c_void,\n    keysize: usize,\n    keyoffset: usize,\n    mode: c_int,\n) -> isize {\n    let raw_a = hash_to_arr(a, elemsize);\n    let table = hash_table(raw_a);\n    let mut hash = if mode >= STBDS_HM_STRING {\n        stbds_hash_string(key as *mut c_cha