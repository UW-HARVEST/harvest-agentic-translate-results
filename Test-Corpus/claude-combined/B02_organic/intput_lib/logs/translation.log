{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_2nsxk6wa47et5hhacsfaq7zirgkogebx3bsb5zkb66ary2sgc6ba","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_016DiaLGTddpPFW1DqzzSJUr","name":"Write","input":{"file_path":"/tmp/harvest-translate-rKn6nG/translated_rust/tests/ffi_compare.rs","content":"//! FFI comparison tests: load both the C and Rust shared libraries via\n//! libloading, exercise the public API, and compare results byte-for-byte.\n\nuse libloading::{Library, Symbol};\nuse std::ffi::c_void;\nuse std::os::raw::{c_char, c_int};\nuse std::path::PathBuf;\n\nconst C_LIB_PATH: &str = \"c_src/build/libtranslated_rust.so\";\nconst RUST_LIB_PATH: &str = \"target/release/libtranslated_rust.so\";\n\nfn workspace_root() -> PathBuf {\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n}\n\nfn c_lib_path() -> PathBuf {\n    workspace_root().join(C_LIB_PATH)\n}\n\nfn rust_lib_path() -> PathBuf {\n    workspace_root().join(RUST_LIB_PATH)\n}\n\nunsafe fn load_libs() -> (Library, Library) {\n    let c = Library::new(c_lib_path()).expect(\"load C lib\");\n    let r = Library::new(rust_lib_path()).expect(\"load Rust lib\");\n    (c, r)\n}\n\n// Function signatures we'll bind\ntype FnRandSeed = unsafe extern \"C\" fn(usize);\ntype FnHashString = unsafe extern \"C\" fn(*mut c_char, usize) -> usize;\ntype FnHashBytes = unsafe extern \"C\" fn(*mut c_void, usize, usize) -> usize;\ntype FnArrgrowf = unsafe extern \"C\" fn(*mut c_void, usize, usize, usize) -> *mut c_void;\ntype FnArrfreef = unsafe extern \"C\" fn(*mut c_void);\ntype FnHmputKey = unsafe extern \"C\" fn(*mut c_void, usize, *mut c_void, usize, c_int) -> *mut c_void;\ntype FnHmgetKey = unsafe extern \"C\" fn(*mut c_void, usize, *mut c_void, usize, c_int) -> *mut c_void;\ntype FnHmgetKeyTs =\n    unsafe extern \"C\" fn(*mut c_void, usize, *mut c_void, usize, *mut isize, c_int) -> *mut c_void;\ntype FnHmdelKey =\n    unsafe extern \"C\" fn(*mut c_void, usize, *mut c_void, usize, usize, c_int) -> *mut c_void;\ntype FnHmfreeFunc = unsafe extern \"C\" fn(*mut c_void, usize);\ntype FnHmputDefault = unsafe extern \"C\" fn(*mut c_void, usize) -> *mut c_void;\ntype FnShmodeFunc = unsafe extern \"C\" fn(usize, c_int) -> *mut c_void;\ntype FnStrkey = unsafe extern \"C\" fn(c_int) -> *mut c_char;\ntype FnIntput = unsafe extern \"C\" fn(c_int);\n\n#[repr(C)]\n#[derive(Copy, Clone, Debug)]\nstruct StbdsArrayHeader {\n    length: usize,\n    capacity: usize,\n    hash_table: *mut c_void,\n    temp: isize,\n}\n\n/// header_of(t) — like stbds_header(t) in C: returns the header for an\n/// array-base pointer.\nunsafe fn header_of(t: *mut c_void) -> *mut StbdsArrayHeader {\n    (t as *mut StbdsArrayHeader).sub(1)\n}\n\n/// hash_header_of(t, elemsize) — used for hash-map \"user\" pointers. The\n/// user pointer points one element past the underlying array base; the\n/// header sits before the array base.\nunsafe fn hash_header_of(t: *mut c_void, elemsize: usize) -> *mut StbdsArrayHeader {\n    let arr = (t as *mut u8).sub(elemsize) as *mut c_void;\n    (arr as *mut StbdsArrayHeader).sub(1)\n}\n\n#[test]\nfn rand_seed_doesnt_crash() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<FnRandSeed> = c.get(b\"stbds_rand_seed\").unwrap();\n        let r_fn: Symbol<FnRandSeed> = r.get(b\"stbds_rand_seed\").unwrap();\n        c_fn(0x12345);\n        r_fn(0x12345);\n    }\n}\n\n#[test]\nfn hash_string_matches() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<FnHashString> = c.get(b\"stbds_hash_string\").unwrap();\n        let r_fn: Symbol<FnHashString> = r.get(b\"stbds_hash_string\").unwrap();\n\n        let cases: &[(&[u8], usize)] = &[\n            (b\"\\0\", 0),\n            (b\"hello\\0\", 0),\n            (b\"hello\\0\", 0xdeadbeef),\n            (b\"a longer test string for hashing\\0\", 0x12345678),\n            (b\"\\xff\\xfe\\x01\\x02\\0\", 0xabcdef01),\n            (b\"x\\0\", 0),\n        ];\n        for (s, seed) in cases {\n            let p = s.as_ptr() as *mut c_char;\n            let cv = c_fn(p, *seed);\n            let rv = r_fn(p, *seed);\n            assert_eq!(cv, rv, \"hash_string mismatch on {:?}/{:#x}\", s, seed);\n        }\n    }\n}\n\n#[test]\nfn hash_bytes_matches() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<FnHashBytes> = c.get(b\"stbds_hash_bytes\").unwrap();\n        let r_fn: Symbol<FnHashBytes> = r.get(b\"stbds_hash_bytes\").unwrap();\n\n        let mut buf = [0u8; 64];\n        for i in 0..buf.len() {\n            buf[i] = (i as u8).wrapping_mul(7).wrapping_add(3);\n        }\n        let p = buf.as_mut_ptr() as *mut c_void;\n        for len in 0..=buf.len() {\n            for &seed in &[0usize, 1, 0xdeadbeef, 0xfeedfacecafebeef] {\n                let cv = c_fn(p, len, seed);\n                let rv = r_fn(p, len, seed);\n                assert_eq!(cv, rv, \"hash_bytes len={} seed={:#x}\", len, seed);\n            }\n        }\n    }\n}\n\n#[test]\nfn arrgrowf_grows_correctly() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<FnArrgrowf> = c.get(b\"stbds_arrgrowf\").unwrap();\n        let r_fn: Symbol<FnArrgrowf> = r.get(b\"stbds_arrgrowf\").unwrap();\n        let c_free: Symbol<FnArrfreef> = c.get(b\"stbds_arrfreef\").unwrap();\n        let r_free: Symbol<FnArrfreef> = r.get(b\"stbds_arrfreef\").unwrap();\n\n        let elemsize = std::mem::size_of::<c_int>();\n\n        for &(addlen, min_cap) in &[(1usize, 0usize), (5, 0), (0, 16), (3, 32)] {\n            let ca = c_fn(std::ptr::null_mut(), elemsize, addlen, min_cap);\n            let ra = r_fn(std::ptr::null_mut(), elemsize, addlen, min_cap);\n\n            assert!(!ca.is_null());\n            assert!(!ra.is_null());\n\n            let ch = *header_of(ca);\n            let rh = *header_of(ra);\n            assert_eq!(ch.capacity, rh.capacity, \"cap addlen={} min_cap={}\", addlen, min_cap);\n            assert_eq!(ch.length, rh.length);\n            assert_eq!(ch.temp, rh.temp);\n\n            c_free(ca);\n            r_free(ra);\n        }\n\n        // Confirm both return NULL for (0,0)\n        let ca0 = c_fn(std::ptr::null_mut(), elemsize, 0, 0);\n        let ra0 = r_fn(std::ptr::null_mut(), elemsize, 0, 0);\n        assert!(ca0.is_null());\n        assert!(ra0.is_null());\n    }\n}\n\n#[test]\nfn hmput_hmget_int_key_int_value() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_put: Symbol<FnHmputKey> = c.get(b\"stbds_hmput_key\").unwrap();\n        let r_put: Symbol<FnHmputKey> = r.get(b\"stbds_hmput_key\").unwrap();\n        let c_get: Symbol<FnHmgetKey> = c.get(b\"stbds_hmget_key\").unwrap();\n        let r_get: Symbol<FnHmgetKey> = r.get(b\"stbds_hmget_key\").unwrap();\n        let c_seed: Symbol<FnRandSeed> = c.get(b\"stbds_rand_seed\").unwrap();\n        let r_seed: Symbol<FnRandSeed> = r.get(b\"stbds_rand_seed\").unwrap();\n        let c_freef: Symbol<FnHmfreeFunc> = c.get(b\"stbds_hmfree_func\").unwrap();\n        let r_freef: Symbol<FnHmfreeFunc> = r.get(b\"stbds_hmfree_func\").unwrap();\n\n        // Reset seed deterministically before each side.\n        c_seed(0x31415926);\n        r_seed(0x31415926);\n\n        // Layout matches `struct { int key; int value; }` => 8 bytes\n        #[repr(C)]\n        #[derive(Copy, Clone)]\n        struct Entry {\n            key: c_int,\n            value: c_int,\n        }\n        let elemsize = std::mem::size_of::<Entry>();\n        let keysize = std::mem::size_of::<c_int>();\n\n        let mut c_map: *mut c_void = std::ptr::null_mut();\n        let mut r_map: *mut c_void = std::ptr::null_mut();\n\n        // Insert pairs (key, value)\n        let pairs: &[(c_int, c_int)] = &[\n            (5, 100),\n            (11, 3),\n            (9, 50),\n            (7, 7),\n            (5, 999), // overwrite (we re-use temp index)\n            (42, -1),\n            (-7, 12345),\n            (0, 22),\n            (1, 33),\n        ];\n        for (k, v) in pairs {\n            let mut key_local = *k;\n            c_map = c_put(c_map, elemsize, &mut key_local as *mut c_int as *mut c_void, keysize, 0);\n            r_map = r_put(r_map, elemsize, &mut key_local as *mut c_int as *mut c_void, keysize, 0);\n            // Both should report the same temp index\n            let c_temp = (*hash_header_of(c_map, elemsize)).temp;\n            let r_temp = (*hash_header_of(r_map, elemsize)).temp;\n            assert_eq!(c_temp, r_temp, \"temp mismatch for key {}\", k);\n            let c_entry = (c_map as *mut Entry).offset(c_temp as isize);\n            let r_entry = (r_map as *mut Entry).offset(r_temp as isize);\n            (*c_entry).key = *k;\n            (*c_entry).value = *v;\n            (*r_entry).key = *k;\n            (*r_entry).value = *v;\n        }\n\n        // Verify: get each key from both, compare result location's value\n        for (k, _) in pairs {\n            let mut key_local = *k;\n            c_map = c_get(c_map, elemsize, &mut key_local as *mut c_int as *mut c_void, keysize, 0);\n            r_map = r_get(r_map, elemsize, &mut key_local as *mut c_int as *mut c_void, keysize, 0);\n            let c_temp = (*hash_header_of(c_map, elemsize)).temp;\n            let r_temp = (*hash_header_of(r_map, elemsize)).temp;\n            assert_eq!(c_temp, r_temp, \"get temp mismatch for key {}\", k);\n            if c_temp >= 0 {\n                let c_entry = (c_map as *mut Entry).offset(c_temp as isize);\n                let r_entry = (r_map as *mut Entry).offset(r_temp as isize);\n                assert_eq!((*c_entry).value, (*r_entry).value, \"value mismatch on key {}\", k);\n            }\n        }\n\n        // Lookups for keys not present should both report -1 in temp\n        for missing in &[100i32, -55, 999_999] {\n            let mut key_local = *missing;\n            c_map = c_get(c_map, elemsize, &mut key_local as *mut c_int as *mut c_void, keysize, 0);\n            r_map = r_get(r_map, elemsize, &mut key_local as *mut c_int as *mut c_void, keysize, 0);\n            let c_temp = (*hash_header_of(c_map, elemsize)).temp;\n            let r_temp = (*hash_header_of(r_map, elemsize)).temp;\n            assert_eq!(c_temp, r_temp, \"missing key {} temp mismatch\", missing);\n        }\n\n        // Compare lengths\n        assert_eq!(\n            (*hash_header_of(c_map, elemsize)).length,\n            (*hash_header_of(r_map, elemsize)).length\n        );\n\n        c_freef(c_map, elemsize);\n        r_freef(r_map, elemsize);\n    }\n}\n\n#[test]\nfn hmdel_works() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_put: Symbol<FnHmputKey> = c.get(b\"stbds_hmput_key\").unwrap();\n        let r_put: Symbol<FnHmputKey> = r.get(b\"stbds_hmput_key\").unwrap();\n        let c_del: Symbol<FnHmdelKey> = c.get(b\"stbds_hmdel_key\").unwrap();\n        let r_del: Symbol<FnHmdelKey> = r.get(b\"stbds_hmdel_key\").unwrap();\n        let c_seed: Symbol<FnRandSeed> = c.get(b\"stbds_rand_seed\").unwrap();\n        let r_seed: Symbol<FnRandSeed> = r.get(b\"stbds_rand_seed\").unwrap();\n        let c_freef: Symbol<FnHmfreeFunc> = c.get(b\"stbds_hmfree_func\").unwrap();\n        let r_freef: Symbol<FnHmfreeFunc> = r.get(b\"stbds_hmfree_func\").unwrap();\n\n        c_seed(0x31415926);\n        r_seed(0x31415926);\n\n        #[repr(C)]\n        #[derive(Copy, Clone)]\n        struct Entry {\n            key: c_int,\n            value: c_int,\n        }\n        let elemsize = std::mem::size_of::<Entry>();\n        let keysize = std::mem::size_of::<c_int>();\n\n        let mut c_map: *mut c_void = std::ptr::null_mut();\n        let mut r_map: *mut c_void = std::ptr::null_mut();\n\n        for k in 0..32 {\n            let mut key_local = k as c_int;\n            c_map = c_put(c_map, elemsize, &mut key_local as *mut c_int as *mut c_void, keysize, 0);\n            r_map = r_put(r_map, elemsize, &mut key_local as *mut c_int as *mut c_void, keysize, 0);\n            let c_temp = (*hash_header_of(c_map, elemsize)).temp;\n            let r_temp = (*hash_header_of(r_map, elemsize)).temp;\n            assert_eq!(c_temp, r_temp, \"put temp mismatch for k={}\", k);\n            let c_entry = (c_map as *mut Entry).offset(c_temp as isize);\n            let r_entry = (r_map as *mut Entry).offset(r_temp as isize);\n            (*c_entry).key = k as c_int;\n            (*c_entry).value = (k * 10) as c_int;\n            (*r_entry).key = k as c_int;\n            (*r_entry).value = (k * 10) as c_int;\n        }\n\n        // Delete some keys\n        for k in [3, 7, 10, 25, 0, 31] {\n            let mut key_local = k as c_int;\n            c_map = c_del(\n                c_map,\n                elemsize,\n                &mut key_local as *mut c_int as *mut c_void,\n                keysize,\n                0,\n                0,\n            );\n            r_map = r_del(\n                r_map,\n                elemsize,\n                &mut key_local as *mut c_int as *mut c_void,\n                keysize,\n                0,\n                0,\n            );\n            let c_temp = (*hash_header_of(c_map, elemsize)).temp;\n            let r_temp = (*hash_header_of(r_map, elemsize)).temp;\n            assert_eq!(c_temp, r_temp, \"del temp mismatch for k={}\", k);\n        }\n\n        assert_eq!(\n            (*hash_header_of(c_map, elemsize)).length,\n            (*hash_header_of(r_map, elemsize)).length\n        );\n\n        c_freef(c_map, elemsize);\n        r_freef(r_map, elemsize);\n    }\n}\n\n#[test]\nfn shmode_func_creates_string_map() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<FnShmodeFunc> = c.get(b\"stbds_shmode_func\").unwrap();\n        let r_fn: Symbol<FnShmodeFunc> = r.get(b\"stbds_shmode_func\").unwrap();\n        let c_freef: Symbol<FnHmfreeFunc> = c.get(b\"stbds_hmfree_func\").unwrap();\n        let r_freef: Symbol<FnHmfreeFunc> = r.get(b\"stbds_hmfree_func\").unwrap();\n        let c_seed: Symbol<FnRandSeed> = c.get(b\"stbds_rand_seed\").unwrap();\n        let r_seed: Symbol<FnRandSeed> = r.get(b\"stbds_rand_seed\").unwrap();\n        c_seed(0x31415926);\n        r_seed(0x31415926);\n\n        #[repr(C)]\n        struct StrEntry {\n            key: *mut c_char,\n            value: c_int,\n        }\n        let elemsize = std::mem::size_of::<StrEntry>();\n        let cmap = c_fn(elemsize, 1 /* STBDS_SH_DEFAULT */);\n        let rmap = r_fn(elemsize, 1);\n\n        // Lengths/temps match — note shmode_func returns a hash-map pointer.\n        assert_eq!(\n            (*hash_header_of(cmap, elemsize)).length,\n            (*hash_header_of(rmap, elemsize)).length\n        );\n\n        c_freef(cmap, elemsize);\n        r_freef(rmap, elemsize);\n    }\n}\n\n#[test]\nfn strkey_returns_correct_string() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<FnStrkey> = c.get(b\"strkey\").unwrap();\n        let r_fn: Symbol<FnStrkey> = r.get(b\"strkey\").unwrap();\n\n        for n in &[0i32, 1, 42, -7, 12345] {\n            let cp = c_fn(*n);\n            let rp = r_fn(*n);\n            // Compare the C-strings byte-for-byte\n            let mut i = 0usize;\n            loop {\n                let cb = *cp.add(i) as u8;\n                let rb = *rp.add(i) as u8;\n                assert_eq!(cb, rb, \"strkey({}) mismatch at byte {}\", n, i);\n                if cb == 0 {\n                    break;\n                }\n                i += 1;\n                if i > 256 {\n                    panic!(\"buffer not terminated\");\n                }\n            }\n        }\n    }\n}\n\n#[test]\nfn intput_does_not_crash() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<FnIntput> = c.get(b\"intput\").unwrap();\n        let r_fn: Symbol<FnIntput> = r.get(b\"intput\").unwrap();\n        let c_seed: Symbol<FnRandSeed> = c.get(b\"stbds_rand_seed\").unwrap();\n        let r_seed: Symbol<FnRandSeed> = r.get(b\"stbds_rand_seed\").unwrap();\n        c_seed(0x31415926);\n        r_seed(0x31415926);\n\n        for n in &[0i32, 1, 5, 100, 9, 11, -3] {\n            c_fn(*n);\n            r_fn(*n);\n        }\n    }\n}\n\n#[test]\nfn hmput_default_match() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<FnHmputDefault> = c.get(b\"stbds_hmput_default\").unwrap();\n        let r_fn: Symbol<FnHmputDefault> = r.get(b\"stbds_hmput_default\").unwrap();\n        let c_freef: Symbol<FnHmfreeFunc> = c.get(b\"stbds_hmfree_func\").unwrap();\n        let r_freef: Symbol<FnHmfreeFunc> = r.get(b\"stbds_hmfree_func\").unwrap();\n\n        #[repr(C)]\n        struct Entry {\n            key: c_int,\n            value: c_int,\n        }\n        let elemsize = std::mem::size_of::<Entry>();\n        let cmap = c_fn(std::ptr::null_mut(), elemsize);\n        let rmap = r_fn(std::ptr::null_mut(), elemsize);\n        // hmput_default returns a hash-map pointer.\n        assert_eq!(\n            (*hash_header_of(cmap, elemsize)).length,\n            (*hash_header_of(rmap, elemsize)).length\n        );\n        c_freef(cmap, elemsize);\n        r_freef(rmap, elemsize);\n    }\n}\n\n#[test]\nfn hmget_key_ts_match() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_put: Symbol<FnHmputKey> = c.get(b\"stbds_hmput_key\").unwrap();\n        let r_put: Symbol<FnHmputKey> = r.get(b\"stbds_hmput_key\").unwrap();\n        let c_get_ts: Symbol<FnHmgetKeyTs> = c.get(b\"stbds_hmget_key_ts\").unwrap();\n        let r_get_ts: Symbol<FnHmgetKeyTs> = r.get(b\"stbds_hmget_key_ts\").unwrap();\n        let c_freef: Symbol<FnHmfreeFunc> = c.get(b\"stbds_hmfree_func\").unwrap();\n        let r_freef: Symbol<FnHmfreeFunc> = r.get(b\"stbds_hmfree_func\").unwrap();\n        let c_seed: Symbol<FnRandSeed> = c.get(b\"stbds_rand_seed\").unwrap();\n        let r_seed: Symbol<FnRandSeed> = r.get(b\"stbds_rand_seed\").unwrap();\n        c_seed(0x31415926);\n        r_seed(0x31415926);\n\n        #[repr(C)]\n        struct Entry {\n            key: c_int,\n            value: c_int,\n        }\n        let elemsize = std::mem::size_of::<Entry>();\n        let keysize = std::mem::size_of::<c_int>();\n        let mut c_map: *mut c_void = std::ptr::null_mut();\n        let mut r_map: *mut c_void = std::ptr::null_mut();\n\n        for k in [1i32, 2, 3, 4] {\n            let mut key_local = k;\n            c_map = c_put(\n                c_map,\n                elemsize,\n                &mut key_local as *mut c_int as *mut c_void,\n                keysize,\n                0,\n            );\n            r_map = r_put(\n                r_map,\n                elemsize,\n                &mut key_local as *mut c_int as *mut c_void,\n                keysize,\n                0,\n            );\n            let c_temp = (*hash_header_of(c_map, elemsize)).temp;\n            let r_temp = (*hash_header_of(r_map, elemsize)).temp;\n            let c_entry = (c_map as *mut Entry).offset(c_temp as isize);\n            let r_entry = (r_map as *mut Entry).offset(r_temp as isize);\n            (*c_entry).key = k;\n            (*c_entry).value = k * 100;\n            (*r_entry).key = k;\n            (*r_entry).value = k * 100;\n        }\n\n        for k in [1i32, 99, 3] {\n            let mut key_local = k;\n            let mut ct: isize = 0;\n            let mut rt: isize = 0;\n            c_map = c_get_ts(\n                c_map,\n                elemsize,\n                &mut key_local as *mut c_int as *mut c_void,\n                keysize,\n                &mut ct,\n                0,\n            );\n            r_map = r_get_ts(\n                r_map,\n                elemsize,\n                &mut key_local as *mut c_int as *mut c_void,\n                keysize,\n                &mut rt,\n                0,\n            );\n            assert_eq!(ct, rt, \"hmget_key_ts temp mismatch on k={}\", k);\n        }\n\n        c_freef(c_map, elemsize);\n        r_freef(r_map, elemsize);\n    }\n}\n\n#[test]\nfn exported_symbols_match() {\n    // Ensure every public symbol the C lib exports is also exported by the Rust lib.\n    use std::process::Command;\n\n    fn exported_text_symbols(p: &PathBuf) -> std::collections::BTreeSet<String> {\n        let out = Command::new(\"nm\")\n            .arg(\"-D\")\n            .arg(p)\n            .output()\n            .expect(\"nm -D\");\n        let mut set = std::collections::BTreeSet::new();\n        for line in String::from_utf8_lossy(&out.stdout).lines() {\n            let toks: Vec<&str> = line.split_whitespace().collect();\n            if toks.len() == 3 && toks[1] == \"T\" {\n                let n = toks[2];\n                if n.starts_with(\"_\") {\n                    continue;\n                }\n                set.insert(n.to_string());\n            }\n        }\n        set\n    }\n\n    let c_syms = exported_text_symbols(&c_lib_path());\n    let r_syms = exported_text_symbols(&rust_lib_path());\n    let missing: Vec<_> = c_syms.difference(&r_syms).collect();\n    assert!(missing.is_empty(), \"Rust lib missing symbols: {:?}\", missing);\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":10263,"cache_read_input_tokens":73874,"cache_creation":{"ephemeral_5m_input_tokens":10263,"ephemeral_1h_input_tokens":0},"output_tokens":39,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"e04de84a-34d9-44b7-84d5-d2c3ada16f87","uuid":"5c63522b-e54a-4c63-8d3d-8a572cb28b17"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_016DiaLGTddpPFW1DqzzSJUr","type":"tool_result","content":"The file /tmp/harvest-translate-rKn6nG/translated_rust/tests/ffi_compare.rs has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"e04de84a-34d9-44b7-84d5-d2c3ada16f87","uuid":"02d1d0e1-8781-48fe-9ead-e68ad8aa1da7","timestamp":"2026-05-30T00:57:02.506Z","tool_use_result":{"type":"update","filePath":"/tmp/harvest-translate-rKn6nG/translated_rust/tests/ffi_compare.rs","content":"//! FFI comparison tests: load both the C and Rust shared libraries via\n//! libloading, exercise the public API, and compare results byte-for-byte.\n\nuse libloading::{Library, Symbol};\nuse std::ffi::c_void;\nuse std::os::raw::{c_char, c_int};\nuse std::path::PathBuf;\n\nconst C_LIB_PATH: &str = \"c_src/build/libtranslated_rust.so\";\nconst RUST_LIB_PATH: &str = \"target/release/libtranslated_rust.so\";\n\nfn workspace_root() -> PathBuf {\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n}\n\nfn c_lib_path() -> PathBuf {\n    workspace_root().join(C_LIB_PATH)\n}\n\nfn rust_lib_path() -> PathBuf {\n    workspace_root().join(RUST_LIB_PATH)\n}\n\nunsafe fn load_libs() -> (Library, Library) {\n    let c = Library::new(c_lib_path()).expect(\"load C lib\");\n    let r = Library::new(rust_lib_path()).expect(\"load Rust lib\");\n    (c, r)\n}\n\n// Function signatures we'll bind\ntype FnRandSeed = unsafe extern \"C\" fn(usize);\ntype FnHashString = unsafe extern \"C\" fn(*mut c_char, usize) -> usize;\ntype FnHashBytes = unsafe extern \"C\" fn(*mut c_void, usize, usize) -> usize;\ntype FnArrgrowf = unsafe extern \"C\" fn(*mut c_void, usize, usize, usize) -> *mut c_void;\ntype FnArrfreef = unsafe extern \"C\" fn(*mut c_void);\ntype FnHmputKey = unsafe extern \"C\" fn(*mut c_void, usize, *mut c_void, usize, c_int) -> *mut c_void;\ntype FnHmgetKey = unsafe extern \"C\" fn(*mut c_void, usize, *mut c_void, usize, c_int) -> *mut c_void;\ntype FnHmgetKeyTs =\n    unsafe extern \"C\" fn(*mut c_void, usize, *mut c_void, usize, *mut isize, c_int) -> *mut c_void;\ntype FnHmdelKey =\n    unsafe extern \"C\" fn(*mut c_void, usize, *mut c_void, usize, usize, c_int) -> *mut c_void;\ntype FnHmfreeFunc = unsafe extern \"C\" fn(*mut c_void, usize);\ntype FnHmputDefault = unsafe extern \"C\" fn(*mut c_void, usize) -> *mut c_void;\ntype FnShmodeFunc = unsafe extern \"C\" fn(usize, c_int) -> *mut c_void;\ntype FnStrkey = unsafe extern \"C\" fn(c_int) -> *mut c_char;\ntype FnIntput = unsafe extern \"C\" fn(c_int);\n\n#[repr(C)]\n#[derive(Copy, Clone, Debug)]\nstruct StbdsArrayHeader {\n    length: usize,\n    capacity: usize,\n    hash_table: *mut c_void,\n    temp: isize,\n}\n\n/// header_of(t) — like stbds_header(t) in C: returns the header for an\n/// array-base pointer.\nunsafe fn header_of(t: *mut c_void) -> *mut StbdsArrayHeader {\n    (t as *mut StbdsArrayHeader).sub(1)\n}\n\n/// hash_header_of(t, elemsize) — used for hash-map \"user\" pointers. The\n/// user pointer points one element past the underlying array base; the\n/// header sits before the array base.\nunsafe fn hash_header_of(t: *mut c_void, elemsize: usize) -> *mut StbdsArrayHeader {\n    let arr = (t as *mut u8).sub(elemsize) as *mut c_void;\n    (arr as *mut StbdsArrayHeader).sub(1)\n}\n\n#[test]\nfn rand_seed_doesnt_crash() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<FnRandSeed> = c.get(b\"stbds_rand_seed\").unwrap();\n        let r_fn: Symbol<FnRandSeed> = r.get(b\"stbds_rand_seed\").unwrap();\n        c_fn(0x12345);\n        r_fn(0x12345);\n    }\n}\n\n#[test]\nfn hash_string_matches() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<FnHashString> = c.get(b\"stbds_hash_string\").unwrap();\n        let r_fn: Symbol<FnHashString> = r.get(b\"stbds_hash_string\").unwrap();\n\n        let cases: &[(&[u8], usize)] = &[\n            (b\"\\0\", 0),\n            (b\"hello\\0\", 0),\n            (b\"hello\\0\", 0xdeadbeef),\n            (b\"a longer test string for hashing\\0\", 0x12345678),\n            (b\"\\xff\\xfe\\x01\\x02\\0\", 0xabcdef01),\n            (b\"x\\0\", 0),\n        ];\n        for (s, seed) in cases {\n            let p = s.as_ptr() as *mut c_char;\n            let cv = c_fn(p, *seed);\n            let rv = r_fn(p, *seed);\n            assert_eq!(cv, rv, \"hash_string mismatch on {:?}/{:#x}\", s, seed);\n        }\n    }\n}\n\n#[test]\nfn hash_bytes_matches() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<FnHashBytes> = c.get(b\"stbds_hash_bytes\").unwrap();\n        let r_fn: Symbol<FnHashBytes> = r.get(b\"stbds_hash_bytes\").unwrap();\n\n        let mut buf = [0u8; 64];\n        for i in 0..buf.len() {\n            buf[i] = (i as u8).wrapping_mul(7).wrapping_add(3);\n        }\n        let p = buf.as_mut_ptr() as *mut c_void;\n        for len in 0..=buf.len() {\n            for &seed in &[0usize, 1, 0xdeadbeef, 0xfeedfacecafebeef] {\n                let cv = c_fn(p, len, seed);\n                let rv = r_fn(p, len, seed);\n                assert_eq!(cv, rv, \"hash_bytes len={} seed={:#x}\", len, seed);\n            }\n        }\n    }\n}\n\n#[test]\nfn arrgrowf_grows_correctly() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<FnArrgrowf> = c.get(b\"stbds_arrgrowf\").unwrap();\n        let r_fn: Symbol<FnArrgrowf> = r.get(b\"stbds_arrgrowf\").unwrap();\n        let c_free: Symbol<FnArrfreef> = c.get(b\"stbds_arrfreef\").unwrap();\n        let r_free: Symbol<FnArrfreef> = r.get(b\"stbds_arrfreef\").unwrap();\n\n        let elemsize = std::mem::size_of::<c_int>();\n\n        for &(addlen, min_cap) in &[(1usize, 0usize), (5, 0), (0, 16), (3, 32)] {\n            let ca = c_fn(std::ptr::null_mut(), elemsize, addlen, min_cap);\n            let ra = r_fn(std::ptr::null_mut(), elemsize, addlen, min_cap);\n\n            assert!(!ca.is_null());\n            assert!(!ra.is_null());\n\n            let ch = *header_of(ca);\n            let rh = *header_of(ra);\n            assert_eq!(ch.capacity, rh.capacity, \"cap addlen={} min_cap={}\", addlen, min_cap);\n            assert_eq!(ch.length, rh.length);\n            assert_eq!(ch.temp, rh.temp);\n\n            c_free(ca);\n            r_free(ra);\n        }\n\n        // Confirm both return NULL for (0,0)\n        let ca0 = c_fn(std::ptr::null_mut(), elemsize, 0, 0);\n        let ra0 = r_fn(std::ptr::null_mut(), elemsize, 0, 0);\n        assert!(ca0.is_null());\n        assert!(ra0.is_null());\n    }\n}\n\n#[test]\nfn hmput_hmget_int_key_int_value() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_put: Symbol<FnHmputKey> = c.get(b\"stbds_hmput_key\").unwrap();\n        let r_put: Symbol<FnHmputKey> = r.get(b\"stbds_hmput_key\").unwrap();\n        let c_get: Symbol<FnHmgetKey> = c.get(b\"stbds_hmget_key\").unwrap();\n        let r_get: Symbol<FnHmgetKey> = r.get(b\"stbds_hmget_key\").unwrap();\n        let c_seed: Symbol<FnRandSeed> = c.get(b\"stbds_rand_seed\").unwrap();\n        let r_seed: Symbol<FnRandSeed> = r.get(b\"stbds_rand_seed\").unwrap();\n        let c_freef: Symbol<FnHmfreeFunc> = c.get(b\"stbds_hmfree_func\").unwrap();\n        let r_freef: Symbol<FnHmfreeFunc> = r.get(b\"stbds_hmfree_func\").unwrap();\n\n        // Reset seed deterministically before each side.\n        c_seed(0x31415926);\n        r_seed(0x31415926);\n\n        // Layout matches `struct { int key; int value; }` => 8 bytes\n        #[repr(C)]\n        #[derive(Copy, Clone)]\n        struct Entry {\n            key: c_int,\n            value: c_int,\n        }\n        let elemsize = std::mem::size_of::<Entry>();\n        let keysize = std::mem::size_of::<c_int>();\n\n        let mut c_map: *mut c_void = std::ptr::null_mut();\n        let mut r_map: *mut c_void = std::ptr::null_mut();\n\n        // Insert pairs (key, value)\n        let pairs: &[(c_int, c_int)] = &[\n            (5, 100),\n            (11, 3),\n            (9, 50),\n            (7, 7),\n            (5, 999), // overwrite (we re-use temp index)\n            (42, -1),\n            (-7, 12345),\n            (0, 22),\n            (1, 33),\n        ];\n        for (k, v) in pairs {\n            let mut key_local = *k;\n            c_map = c_put(c_map, elemsize, &mut key_local as *mut c_int as *mut c_void, keysize, 0);\n            r_map = r_put(r_map, elemsize, &mut key_local as *mut c_int as *mut c_void, keysize, 0);\n            // Both should report the same temp index\n            let c_temp = (*hash_header_of(c_map, elemsize)).temp;\n            let r_temp = (*hash_header_of(r_map, elemsize)).temp;\n            assert_eq!(c_temp, r_temp, \"temp mismatch for key {}\", k);\n            let c_entry = (c_map as *mut Entry).offset(c_temp as isize);\n            let r_entry = (r_map as *mut Entry).offset(r_temp as isize);\n            (*c_entry).key = *k;\n            (*c_entry).value = *v;\n            (*r_entry).key = *k;\n            (*r_entry).value = *v;\n        }\n\n        // Verify: get each key from both, compare result location's value\n        for (k, _) in pairs {\n            let mut key_local = *k;\n            c_map = c_get(c_map, elemsize, &mut key_local as *mut c_int as *mut c_void, keysize, 0);\n            r_map = r_get(r_map, elemsize, &mut key_local as *mut c_int as *mut c_void, keysize, 0);\n            let c_temp = (*hash_header_of(c_map, elemsize)).temp;\n            let r_temp = (*hash_header_of(r_map, elemsize)).temp;\n            assert_eq!(c_temp, r_temp, \"get temp mismatch for key {}\", k);\n            if c_temp >= 0 {\n                let c_entry = (c_map as *mut Entry).offset(c_temp as isize);\n                let r_entry = (r_map as *mut Entry).offset(r_temp as isize);\n                assert_eq!((*c_entry).value, (*r_entry).value, \"value mismatch on key {}\", k);\n            }\n        }\n\n        // Lookups for keys not present should both report -1 in temp\n        for missing in &[100i32, -55, 999_999] {\n            let mut key_local = *missing;\n            c_map = c_get(c_map, elemsize, &mut key_local as *mut c_int as *mut c_void, keysize, 0);\n            r_map = r_get(r_map, elemsize, &mut key_local as *mut c_int as *mut c_void, keysize, 0);\n            let c_temp = (*hash_header_of(c_map, elemsize)).temp;\n            let r_temp = (*hash_header_of(r_map, elemsize)).temp;\n            assert_eq!(c_temp, r_temp, \"missing key {} temp mismatch\", missing);\n        }\n\n        // Compare lengths\n        assert_eq!(\n            (*hash_header_of(c_map, elemsize)).length,\n            (*hash_header_of(r_map, elemsize)).length\n        );\n\n        c_freef(c_map, elemsize);\n        r_freef(r_map, elemsize);\n    }\n}\n\n#[test]\nfn hmdel_works() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_put: Symbol<FnHmputKey> = c.get(b\"stbds_hmput_key\").unwrap();\n        let r_put: Symbol<FnHmputKey> = r.get(b\"stbds_hmput_key\").unwrap();\n        let c_del: Symbol<FnHmdelKey> = c.get(b\"stbds_hmdel_key\").unwrap();\n        let r_del: Symbol<FnHmdelKey> = r.get(b\"stbds_hmdel_key\").unwrap();\n        let c_seed: Symbol<FnRandSeed> = c.get(b\"stbds_rand_seed\").unwrap();\n        let r_seed: Symbol<FnRandSeed> = r.get(b\"stbds_rand_seed\").unwrap();\n        let c_freef: Symbol<FnHmfreeFunc> = c.get(b\"stbds_hmfree_func\").unwrap();\n        let r_freef: Symbol<FnHmfreeFunc> = r.get(b\"stbds_hmfree_func\").unwrap();\n\n        c_seed(0x31415926);\n        r_seed(0x31415926);\n\n        #[repr(C)]\n        #[derive(Copy, Clone)]\n        struct Entry {\n            key: c_int,\n            value: c_int,\n        }\n        let elemsize = std::mem::size_of::<Entry>();\n        let keysize = std::mem::size_of::<c_int>();\n\n        let mut c_map: *mut c_void = std::ptr::null_mut();\n        let mut r_map: *mut c_void = std::ptr::null_mut();\n\n        for k in 0..32 {\n            let mut key_local = k as c_int;\n            c_map = c_put(c_map, elemsize, &mut key_local as *mut c_int as *mut c_void, keysize, 0);\n            r_map = r_put(r_map, elemsize, &mut key_local as *mut c_int as *mut c_void, keysize, 0);\n            let c_temp = (*hash_header_of(c_map, elemsize)).temp;\n            let r_temp = (*hash_header_of(r_map, elemsize)).temp;\n            assert_eq!(c_temp, r_temp, \"put temp mismatch for k={}\", k);\n            let c_entry = (c_map as *mut Entry).offset(c_temp as isize);\n            let r_entry = (r_map as *mut Entry).offset(r_temp as isize);\n            (*c_entry).key = k as c_int;\n            (*c_entry).value = (k * 10) as c_int;\n            (*r_entry).key = k as c_int;\n            (*r_entry).value = (k * 10) as c_int;\n        }\n\n        // Delete some keys\n        for k in [3, 7, 10, 25, 0, 31] {\n            let mut key_local = k as c_int;\n            c_map = c_del(\n                c_map,\n                elemsize,\n                &mut key_local as *mut c_int as *mut c_void,\n                keysize,\n                0,\n                0,\n            );\n            r_map = r_del(\n                r_map,\n                elemsize,\n                &mut key_local as *mut c_int as *mut c_void,\n                keysize,\n                0,\n                0,\n            );\n            let c_temp = (*hash_header_of(c_map, elemsize)).temp;\n            let r_temp = (*hash_header_of(r_map, elemsize)).temp;\n            assert_eq!(c_temp, r_temp, \"del temp mismatch for k={}\", k);\n        }\n\n        assert_eq!(\n            (*hash_header_of(c_map, elemsize)).length,\n            (*hash_header_of(r_map, elemsize)).length\n        );\n\n        c_freef(c_map, elemsize);\n        r_freef(r_map, elemsize);\n    }\n}\n\n#[test]\nfn shmode_func_creates_string_map() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<FnShmodeFunc> = c.get(b\"stbds_shmode_func\").unwrap();\n        let r_fn: Symbol<FnShmodeFunc> = r.get(b\"stbds_shmode_func\").unwrap();\n        let c_freef: Symbol<FnHmfreeFunc> = c.get(b\"stbds_hmfree_func\").unwrap();\n        let r_freef: Symbol<FnHmfreeFunc> = r.get(b\"stbds_hmfree_func\").unwrap();\n        let c_seed: Symbol<FnRandSeed> = c.get(b\"stbds_rand_seed\").unwrap();\n        let r_seed: Symbol<FnRandSeed> = r.get(b\"stbds_rand_seed\").unwrap();\n        c_seed(0x31415926);\n        r_seed(0x31415926);\n\n        #[repr(C)]\n        struct StrEntry {\n            key: *mut c_char,\n            value: c_int,\n        }\n        let elemsize = std::mem::size_of::<StrEntry>();\n        let cmap = c_fn(elemsize, 1 /* STBDS_SH_DEFAULT */);\n        let rmap = r_fn(elemsize, 1);\n\n        // Lengths/temps match — note shmode_func returns a hash-map pointer.\n        assert_eq!(\n            (*hash_header_of(cmap, elemsize)).length,\n            (*hash_header_of(rmap, elemsize)).length\n        );\n\n        c_freef(cmap, elemsize);\n        r_freef(rmap, elemsize);\n    }\n}\n\n#[test]\nfn strkey_returns_correct_string() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<FnStrkey> = c.get(b\"strkey\").unwrap();\n        let r_fn: Symbol<FnStrkey> = r.get(b\"strkey\").unwrap();\n\n        for n in &[0i32, 1, 42, -7, 12345] {\n            let cp = c_fn(*n);\n            let rp = r_fn(*n);\n            // Compare the C-strings byte-for-byte\n            let mut i = 0usize;\n            loop {\n                let cb = *cp.add(i) as u8;\n                let rb = *rp.add(i) as u8;\n                assert_eq!(cb, rb, \"strkey({}) mismatch at byte {}\", n, i);\n                if cb == 0 {\n                    break;\n                }\n                i += 1;\n                if i > 256 {\n                    panic!(\"buffer not terminated\");\n                }\n            }\n        }\n    }\n}\n\n#[test]\nfn intput_does_not_crash() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<FnIntput> = c.get(b\"intput\").unwrap();\n        let r_fn: Symbol<FnIntput> = r.get(b\"intput\").unwrap();\n        let c_seed: Symbol<FnRandSeed> = c.get(b\"stbds_rand_seed\").unwrap();\n        let r_seed: Symbol<FnRandSeed> = r.get(b\"stbds_rand_seed\").unwrap();\n        c_seed(0x31415926);\n        r_seed(0x31415926);\n\n        for n in &[0i32, 1, 5, 100, 9, 11, -3] {\n            c_fn(*n);\n            r_fn(*n);\n        }\n    }\n}\n\n#[test]\nfn hmput_default_match() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_fn: Symbol<FnHmputDefault> = c.get(b\"stbds_hmput_default\").unwrap();\n        let r_fn: Symbol<FnHmputDefault> = r.get(b\"stbds_hmput_default\").unwrap();\n        let c_freef: Symbol<FnHmfreeFunc> = c.get(b\"stbds_hmfree_func\").unwrap();\n        let r_freef: Symbol<FnHmfreeFunc> = r.get(b\"stbds_hmfree_func\").unwrap();\n\n        #[repr(C)]\n        struct Entry {\n            key: c_int,\n            value: c_int,\n        }\n        let elemsize = std::mem::size_of::<Entry>();\n        let cmap = c_fn(std::ptr::null_mut(), elemsize);\n        let rmap = r_fn(std::ptr::null_mut(), elemsize);\n        // hmput_default returns a hash-map pointer.\n        assert_eq!(\n            (*hash_header_of(cmap, elemsize)).length,\n            (*hash_header_of(rmap, elemsize)).length\n        );\n        c_freef(cmap, elemsize);\n        r_freef(rmap, elemsize);\n    }\n}\n\n#[test]\nfn hmget_key_ts_match() {\n    unsafe {\n        let (c, r) = load_libs();\n        let c_put: Symbol<FnHmputKey> = c.get(b\"stbds_hmput_key\").unwrap();\n        let r_put: Symbol<FnHmputKey> = r.get(b\"stbds_hmput_key\").unwrap();\n        let c_get_ts: Symbol<FnHmgetKeyTs> = c.get(b\"stbds_hmget_key_ts\").unwrap();\n        let r_get_ts: Symbol<FnHmgetKeyTs> = r.get(b\"stbds_hmget_key_ts\").unwrap();\n        let c_freef: Symbol<FnHmfreeFunc> = c.get(b\"stbds_hmfree_func\").unwrap();\n        let r_freef: Symbol<FnHmfreeFunc> = r.get(b\"stbds_hmfree_func\").unwrap();\n        let c_seed: Symbol<FnRandSeed> = c.get(b\"stbds_rand_seed\").unwrap();\n        let r_seed: Symbol<FnRandSeed> = r.get(b\"stbds_rand_seed\").unwrap();\n        c_seed(0x31415926);\n        r_seed(0x31415926);\n\n        #[repr(C)]\n        struct Entry {\n            key: c_int,\n            value: c_int,\n        }\n        let elemsize = std::mem::size_of::<Entry>();\n        let keysize = std::mem::size_of::<c_int>();\n        let mut c_map: *mut c_void = std::ptr::null_mut();\n        let mut r_map: *mut c_void = std::ptr::null_mut();\n\n        for k in [1i32, 2, 3, 4] {\n            let mut key_local = k;\n            c_map = c_put(\n                c_map,\n                elemsize,\n                &mut key_local as *mut c_int as *mut c_void,\n                keysize,\n                0,\n            );\n            r_map = r_put(\n                r_map,\n                elemsize,\n                &mut key_local as *mut c_int as *mut c_void,\n                keysize,\n                0,\n            );\n            let c_temp = (*hash_header_of(c_map, elemsize)).temp;\n            let r_temp = (*hash_header_of(r_map, elemsize)).temp;\n            let c_entry = (c_map as *mut Entry).offset(c_temp as isize);\n            let r_entry = (r_map as *mut Entry).offset(r_temp as isize);\n            (*c_entry).key = k;\n            (*c_entry).value = k * 100;\n            (*r_entry).key = k;\n            (*r_entry).value = k * 100;\n        }\n\n        for k in [1i32, 99, 3] {\n            let mut key_local = k;\n            let mut ct: isize = 0;\n            let mut rt: isize = 0;\n            c_map = c_get_ts(\n                c_map,\n                elemsize,\n                &mut key_local as *mut c_int as *mut c_void,\n                keysize,\n                &mut ct,\n                0,\n            );\n            r_map = r_get_ts(\n                r_map,\n                elemsize,\n                &mut key_local as *mut c_int as *mut c_void,\n                keysize,\n                &mut rt,\n                0,\n            );\n            assert_eq!(ct, rt, \"hmget_key_ts temp mismatch on k={}\", k);\n        }\n\n        c_freef(c_map, elemsize);\n        r_freef(r_map, elemsize);\n    }\n}\n\n#[test]\nfn exported_symbols_match() {\n    // Ensure every public symbol the C lib exports is also exported by the Rust lib.\n    use std::process::Command;\n\n    fn exported_text_symbols(p: &PathBuf) -> std::collections::BTreeSet<String> {\n        let out = Command::new(\"nm\")\n            .arg(\"-D\")\n            .arg(p)\n            .output()\n            .expect(\"nm -D\");\n        let mut set = std::collections::BTreeSet::new();\n        for line in String::from_utf8_lossy(&out.stdout).lines() {\n            let toks: Vec<&str> = line.split_whitespace().collect();\n            if toks.len() == 3 && toks[1] == \"T\" {\n                let n = toks[2];\n                if n.starts_with(\"_\") {\n                    continue;\n                }\n                set.insert(n.to_string());\n            }\n        }\n        set\n    }\n\n    let c_syms = exported_text_symbols(&c_lib_path());\n    let r_syms = exported_text_symbols(&rust_lib_path());\n    let missing: Vec<_> = c_syms.difference(&r_syms).collect();\n    assert!(missing.is_empty(), \"Rust lib missing symbols: {:?}\", missing);\n}\n","structuredPatch":[{"oldStart":54,"oldLines":15,"newStart":54,"newLines":15,"lines":["     temp: isize,"," }"," ","-/// header_of(t) — like stbds_header(t) in the C macros, returns the header","-/// for an array pointer. Used directly on array bases.","+/// header_of(t) — like stbds_header(t) in C: returns the header for an","+/// array-base pointer."," unsafe fn header_of(t: *mut c_void) -> *mut StbdsArrayHeader {","     (t as *mut StbdsArrayHeader).sub(1)"," }"," ","-/// hash_header_of(t, elemsize) — used on hash-map \"user\" pointers. The user","-/// pointer point