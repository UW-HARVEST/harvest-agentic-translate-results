\n\n        #[repr(C)]\n        struct Entry {\n            key: c_int,\n            value: c_int,\n        }\n        let elemsize = std::mem::size_of::<Entry>();\n        let keysize = std::mem::size_of::<c_int>();\n        let mut c_map: *mut c_void = std::ptr::null_mut();\n        let mut r_map: *mut c_void = std::ptr::null_mut();\n\n        for k in [1i32, 2, 3, 4] {\n            let mut key_local = k;\n            c_map = c_put(\n                c_map,\n                elemsize,\n                &mut key_local as *mut c_int as *mut c_void,\n                keysize,\n                0,\n            );\n            r_map = r_put(\n                r_map,\n                elemsize,\n                &mut key_local as *mut c_int as *mut c_void,\n                keysize,\n                0,\n            );\n            let c_temp = (*hash_header_of(c_map, elemsize)).temp;\n            let r_temp = (*hash_header_of(r_map, elemsize)).temp;\n            let c_entry = (c_map as *mut Entry).offset(c_temp as isize);\n            let r_entry = (r_map as *mut Entry).offset(r_temp as isize);\n            (*c_entry).key = k;\n            (*c_entry).value = k * 100;\n            (*r_entry).key = k;\n            (*r_entry).value = k * 100;\n        }\n\n        for k in [1i32, 99, 3] {\n            let mut key_local = k;\n            let mut ct: isize = 0;\n            let mut rt: isize = 0;\n            c_map = c_get_ts(\n                c_map,\n                elemsize,\n                &mut key_local as *mut c_int as *mut c_void,\n                keysize,\n                &mut ct,\n                0,\n            );\n            r_map = r_get_ts(\n                r_map,\n                elemsize,\n                &mut key_local as *mut c_int as *mut c_void,\n                keysize,\n                &mut rt,\n                0,\n            );\n            assert_eq!(ct, rt, \"hmget_key_ts temp mismatch on k={}\", k);\n        }\n\n        let c_arr = (c_map as *mut u8).sub(elemsize) as *mut c_void;\n        let r_arr = (r_map as *mut u8).sub(elemsize) as *mut c_void;\n        c_freef(c_arr, elemsize);\n        r_freef(r_arr, elemsize);\n    }\n}\n\n#[test]\nfn exported_symbols_match() {\n    // Ensure every public symbol the C lib exports is also exported by the Rust lib.\n    use std::process::Command;\n\n    fn exported_text_symbols(p: &PathBuf) -> std::collections::BTreeSet<String> {\n        let out = Command::new(\"nm\")\n            .arg(\"-D\")\n            .arg(p)\n            .output()\n            .expect(\"nm -D\");\n        let mut set = std::collections::BTreeSet::new();\n        for line in String::from_utf8_lossy(&out.stdout).lines() {\n            let toks: Vec<&str> = line.split_whitespace().collect();\n            if toks.len() == 3 && toks[1] == \"T\" {\n                let n = toks[2];\n                if n.starts_with(\"_\") {\n                    continue;\n                }\n                set.insert(n.to_string());\n            }\n        }\n        set\n    }\n\n    let c_syms = exported_text_symbols(&c_lib_path());\n    let r_syms = exported_text_symbols(&rust_lib_path());\n    let missing: Vec<_> = c_syms.difference(&r_syms).collect();\n    assert!(missing.is_empty(), \"Rust lib missing symbols: {:?}\", missing);\n}\n","structuredPatch":[{"oldStart":289,"oldLines":26,"newStart":289,"newLines":21,"lines":["         for k in 0..32 {","             let mut key_local = k as c_int;","             c_map = c_put(c_map, elemsize, &mut key_local as *mut c_int as *mut c_void, keysize, 0);","+            r_map = r_put(r_map, elemsize, &mut key_local as *mut c_int as *mut c_void, keysize, 0);","             let c_temp = (*hash_header_of(c_map, elemsize)).temp;","+            let r_temp = (*hash_header_of(r_map, elemsize)).temp;","+            assert_eq!(c_temp, r_temp, \"put temp mismatch for k={}\", k);","             let c_entry = (c_map as *mut Entry).offset(c_temp as isize);","+            let r_entry = (r_map as *m